{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${hostSystemName}/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_BUILD_TYPE": "Debug",
        "FORT_BOOTSTRAP0_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "debug",
      "description": "Debug build of the host's target (the base preset)"
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "release",
      "description": "Optimized build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "asan-debug",
      "inherits": "base",
      "displayName": "asan-debug",
      "description": "AddressSanitizer over a Debug build",
      "cacheVariables": {
        "FORT_SANITIZER": "address"
      }
    },
    {
      "name": "asan-release",
      "inherits": "asan-debug",
      "displayName": "asan-release",
      "description": "AddressSanitizer over a Release build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ubsan-debug",
      "inherits": "base",
      "displayName": "ubsan-debug",
      "description": "UndefinedBehaviorSanitizer over a Debug build",
      "cacheVariables": {
        "FORT_SANITIZER": "undefined"
      }
    },
    {
      "name": "ubsan-release",
      "inherits": "ubsan-debug",
      "displayName": "ubsan-release",
      "description": "UndefinedBehaviorSanitizer over a Release build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "msan-debug",
      "inherits": "base",
      "displayName": "msan-debug",
      "description": "MemorySanitizer over a Debug build",
      "cacheVariables": {
        "FORT_SANITIZER": "memory"
      }
    },
    {
      "name": "msan-release",
      "inherits": "msan-debug",
      "displayName": "msan-release",
      "description": "MemorySanitizer over a Release build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "tsan-debug",
      "inherits": "base",
      "displayName": "tsan-debug",
      "description": "ThreadSanitizer over a Debug build",
      "cacheVariables": {
        "FORT_SANITIZER": "thread"
      }
    },
    {
      "name": "tsan-release",
      "inherits": "tsan-debug",
      "displayName": "tsan-release",
      "description": "ThreadSanitizer over a Release build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "gcc",
      "inherits": "base",
      "displayName": "gcc",
      "description": "GCC build of the C sources",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "asan-debug",
