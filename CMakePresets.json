{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${hostSystemName}/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_BUILD_TYPE": "Debug",
        "FORT_BOOTSTRAP0_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "debug",
      "description": "Debug build of the host's target (the base preset)"
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "release",
      "description": "Optimized build with debug info",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "asan",
      "description": "AddressSanitizer",
      "cacheVariables": {
        "FORT_SANITIZER": "address"
      }
    },
    {
      "name": "ubsan",
      "inherits": "base",
      "displayName": "ubsan",
      "description": "UndefinedBehaviorSanitizer",
      "cacheVariables": {
        "FORT_SANITIZER": "undefined"
      }
    },
    {
      "name": "msan",
      "inherits": "base",
      "displayName": "msan",
      "description": "MemorySanitizer",
      "cacheVariables": {
        "FORT_SANITIZER": "memory"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "displayName": "tsan",
      "description": "ThreadSanitizer",
      "cacheVariables": {
        "FORT_SANITIZER": "thread"
      }
    },
    {
      "name": "gcc",
      "inherits": "base",
      "displayName": "gcc",
      "description": "GCC build of the C sources",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "ubsan",
      "configurePreset": "ubsan"
    },
    {
      "name": "msan",
      "configurePreset": "msan"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "gcc",
      "configurePreset": "gcc"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ubsan",
      "configurePreset": "ubsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "msan",
      "configurePreset": "msan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "gcc",
      "configurePreset": "gcc",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "debug",
      "steps": [
        {
          "type": "configure",
          "name": "debug"
        },
        {
          "type": "build",
          "name": "debug"
        },
        {
          "type": "test",
          "name": "debug"
        }
      ]
    },
    {
      "name": "release",
      "steps": [
        {
          "type": "configure",
          "name": "release"
        },
        {
          "type": "build",
          "name": "release"
        },
        {
          "type": "test",
          "name": "release"
        }
      ]
    },
    {
      "name": "asan",
      "steps": [
        {
          "type": "configure",
          "name": "asan"
        },
        {
          "type": "build",
          "name": "asan"
        },
        {
          "type": "test",
          "name": "asan"
        }
      ]
    },
    {
      "name": "ubsan",
      "steps": [
        {
          "type": "configure",
          "name": "ubsan"
        },
        {
          "type": "build",
          "name": "ubsan"
        },
        {
          "type": "test",
          "name": "ubsan"
        }
      ]
    },
    {
      "name": "msan",
      "steps": [
        {
          "type": "configure",
          "name": "msan"
        },
        {
          "type": "build",
          "name": "msan"
        },
        {
          "type": "test",
          "name": "msan"
        }
      ]
    },
    {
      "name": "tsan",
      "steps": [
        {
          "type": "configure",
          "name": "tsan"
        },
        {
          "type": "build",
          "name": "tsan"
        },
        {
          "type": "test",
          "name": "tsan"
        }
      ]
    },
    {
      "name": "gcc",
      "steps": [
        {
          "type": "configure",
          "name": "gcc"
        },
        {
          "type": "build",
          "name": "gcc"
        },
        {
          "type": "test",
          "name": "gcc"
        }
      ]
    }
  ]
}
