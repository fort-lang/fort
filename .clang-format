# clang-format 18 configuration for the C11 sources.
# Only keys that clang-format 18 accepts; check with
# `clang-format --dump-config -style=file`.
Language: Cpp
BasedOnStyle: LLVM
ColumnLimit: 100
IndentWidth: 4
PointerAlignment: Left

# One statement per line: no short ifs, loops, case labels or blocks on one
# line; only empty functions may stay on one line.
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never

# Arguments and parameters are all on one line or one per line.
BinPackArguments: false
BinPackParameters: false
AllowAllParametersOfDeclarationOnNextLine: true
AlwaysBreakAfterReturnType: None
PenaltyReturnTypeOnItsOwnLine: 1000

IndentCaseLabels: false
InsertNewlineAtEOF: true

# Separate and sort include blocks. Put a .c file's main header first.
# For example, foo.c and foo_test.c use foo.h as their main header.
# Put system headers <x.h> next. Then put <sys/x.h> and other subdirectory headers.
# Put project headers "x.h" next. Put "test.h" and "common.h" last.
IncludeBlocks: Regroup
SortIncludes: CaseSensitive
IncludeIsMainRegex: '(_test)?$'
IncludeCategories:
  - Regex: '^<[^/]+>'
    Priority: 1
  - Regex: '^<.*/.*>'
    Priority: 2
  - Regex: '^"(test|common)\.h"'
    Priority: 4
  - Regex: '^".*"'
    Priority: 3
