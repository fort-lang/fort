# clang-format 18 configuration for the C11 sources (AGENTS.md, C sources).
# Only keys that clang-format 18 accepts; check with
# `clang-format --dump-config -style=file`.
Language: Cpp
BasedOnStyle: LLVM
ColumnLimit: 100
IndentWidth: 4
PointerAlignment: Left

# One statement per line: no short ifs, loops, case labels or blocks on one
# line; only empty functions may stay on one line.
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never

# Arguments and parameters are all on one line or one per line.
BinPackArguments: false
BinPackParameters: false
AllowAllParametersOfDeclarationOnNextLine: true
AlwaysBreakAfterReturnType: None
PenaltyReturnTypeOnItsOwnLine: 1000

IndentCaseLabels: false
InsertNewlineAtEOF: true

# Include blocks, blank-line separated and sorted: the main header of a .c
# file (foo.h for foo.c and foo_test.c), then system headers <x.h>, then
# <sys/x.h> and other subdirectory headers, then project headers "x.h", then
# the test framework "test.h" and "common.h" last.
IncludeBlocks: Regroup
SortIncludes: CaseSensitive
IncludeIsMainRegex: '(_test)?$'
IncludeCategories:
  - Regex: '^<[^/]+>'
    Priority: 1
  - Regex: '^<.*/.*>'
    Priority: 2
  - Regex: '^"(test|common)\.h"'
    Priority: 4
  - Regex: '^".*"'
    Priority: 3
