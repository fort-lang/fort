// std.libc: thin extern declarations for the libc calls the library needs
// (stdlib.md 2.2). The runtime entry points are std.rt (stdlib.md 3). C types
// map as follows: int is i32, size_t is u64, ssize_t and off_t are i64, mode_t
// is u32, char* is char*, and every void* buffer is void*. Names are
// unmangled.
// D13.2, D9.8, D9.7

/// open(2) flags, Linux x86-64 values.
i32 O_RDONLY = 0;
i32 O_WRONLY = 1;
i32 O_RDWR = 2;
i32 O_CREAT = 0o100;
i32 O_TRUNC = 0o1000;
i32 O_APPEND = 0o2000;

/// lseek(2) whence values.
i32 SEEK_SET = 0;
i32 SEEK_CUR = 1;
i32 SEEK_END = 2;

/// errno values the library tests for.
i32 ENOENT = 2;
i32 EINTR = 4;
i32 EACCES = 13;

/// <stdlib.h>, <string.h>. malloc and calloc return void* own and free takes
/// void* own. The boundary erases those qualifiers; they state C's convention.
/// calloc answers with zeroed storage. std.rt allocates with it, because new
/// promises zeroed storage (toolchain.md 5.1).
/// D17.13, D10.2
extern fn void* own malloc(u64 size);
extern fn void* own calloc(u64 n, u64 size);
extern fn void free(void* own p);
extern fn void* memcpy(void* dst, void* src, u64 n);
extern fn void* memmove(void* dst, void* src, u64 n);
extern fn i32 memcmp(void* a, void* b, u64 n);
extern fn void* memset(void* dst, i32 v, u64 n);
extern fn u64 strlen(char* s);
extern fn char* getenv(char* name);
extern fn noreturn exit(i32 code);
extern fn noreturn abort();

/// qsort orders n elements of size bytes in place and calls cmp with a pointer
/// to each of two of them. std.sort wraps it and states what a caller may sort
/// (stdlib.md 2.10); no other module calls it. Like every declaration in this
/// module it binds every program, because std.rt imports std.libc and every
/// closure holds std.rt: a program that redeclares qsort must write the same
/// signature (notes/compiler.md 7).
/// D9.10, D9.8
extern fn void qsort(void* base, u64 n, u64 size, fn i32(void*, void*) cmp);

/// <fcntl.h>, <unistd.h>. open is variadic in C; the fixed prototype is safe
/// because every extern is called through a variadic LLVM function type.
/// D9.8
extern fn i32 open(char* path, i32 flags, u32 mode);
extern fn i64 read(i32 fd, void* buf, u64 n);
extern fn i64 write(i32 fd, void* buf, u64 n);
extern fn i32 close(i32 fd);
extern fn i64 lseek(i32 fd, i64 offset, i32 whence);

/// Answers the question the buffering rule asks about a descriptor. std.rt asks
/// it once for each buffer. No other module calls it (toolchain.md 5.3).
/// D11.5
extern fn i32 isatty(i32 fd);

/// <errno.h>: errno is a macro over this accessor in glibc and musl. C returns
/// int*, which is mutable, so the target carries mut: std.rt writes errno back
/// around the isatty call it makes for each buffer (toolchain.md 5.3). A reader
/// that only reads it takes the same result and drops the mut, which
/// sys.errno() does.
/// D11.5, D5.4
extern fn i32 mut* __errno_location();
