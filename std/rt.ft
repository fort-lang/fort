/// Implements process startup, allocation, formatted output, buffering, and runtime failures.
/// The compiler uses runtime entry points. Programs can use the four public float helpers.
// Runtime failure paths must not trigger another checked operation.
// DECIMAL_MAX and HEX_MAX have no spare bytes. Keep their sizes with their formatter widths.
// buffer_append flushes or bypasses a full buffer before copying bytes.
import std.libc;
import std.str;
import std.strbuf;

// ---- descriptors and buffers ------------------------------------------------

// Buffer stdout, but write stderr directly.
i32 STDOUT_FD = 1;
i32 STDERR_FD = 2;

// Maximum pending bytes for one descriptor.
u64 BUFFER_SIZE = 8192;

// Buffer stdout and eight other descriptors. Evict the oldest extra buffer.
u64 BUFFER_POOL_SIZE = 8;

// Slot 0 always holds stdout. The pool follows it.
u64 BUFFER_COUNT = 1 + BUFFER_POOL_SIZE;

// exit keeps one byte of the status.
i32 EXIT_STATUS_MASK = 0xFF;

u64 DECIMAL_BASE = 10;
u64 HEX_BASE = 16;

// The longest decimal text: -9223372036854775808, or 18446744073709551615.
u64 DECIMAL_MAX = 20;

// The longest pointer text: 0x and 16 hex digits.
u64 HEX_MAX = 18;

// The largest u64. alloc divides it to test a product for overflow.
u64 U64_MAX = 18446744073709551615;

// The largest i64. regrow reads the bits of a signed count above it as a negative count.
u64 I64_MAX = 9223372036854775807;

// The bytes of one word of an owner slot, which regrow_move sets to zero.
u64 WORD_BYTES = 8;

// Pointer text uses lowercase digits.
string HEX_DIGITS = "0123456789abcdef";

// fd is -1 for a free slot. len never exceeds BUFFER_SIZE.
struct buffer {
    i32 fd;
    bool is_line_buffered;
    u64 len;
    u8[BUFFER_SIZE] data;
}

// Matches the compiler's %fort.enum_member layout.
struct enum_member {
    i32 value;
    char* name;
}

// Slot 0 holds stdout. Other slots use round-robin eviction.
buffer[BUFFER_COUNT] mut buffers = {};
bool mut buffers_ready = false;

// reset_buffer sets this for slot 0, and buffer_for asks isatty of stdout again at the next
// output, because the file of stdout can change after the reset, at an open after a close.
bool mut stdout_unknown = false;
u64 mut next_eviction = 1;

// Build one failure line before writing it to stderr.
buffer mut message = {};

// args_init builds this span from argv during process startup.
string mut@ own mut args_store = {};

// Check a descriptor once when its buffer is assigned.
// Preserve errno because isatty changes it for non-terminal descriptors.
// C call libc.isatty: no pointer argument.
fn is_interactive(i32 fd) bool {
    i32 mut* slot = libc.errno_slot();
    i32 saved = *slot;
    bool interactive = libc.isatty(fd) == 1;
    *slot = saved;
    return interactive;
}

fn buffers_init() void {
    if (buffers_ready) {
        return;
    }
    buffers[0].fd = STDOUT_FD;
    buffers[0].is_line_buffered = is_interactive(STDOUT_FD);
    for (u64 mut i = 1; i < BUFFER_COUNT; i++) {
        buffers[i].fd = -1;
        buffers[i].is_line_buffered = false;
    }
    // The failure line has one explicit flush and needs no line buffering.
    message.fd = STDERR_FD;
    message.is_line_buffered = false;
    buffers_ready = true;
}

// Retry short writes and EINTR. Drop remaining bytes after another error.
// C call libc.write: rest.ptr keeps the bound of the span rest (D9.8 rule 2), and the length
// rest.len fits it. rest.len > 0, because done < bytes.len.
fn write_all(i32 fd, u8@ bytes) void {
    u64 mut done = 0;
    while (done < bytes.len) {
        u8@ rest = bytes[done..];
        i64 n = libc.write(fd, rest.ptr, rest.len);
        if (n < 0) {
            if (*libc.errno_slot() == libc.EINTR) {
                continue;
            }
            return;
        }
        done += cast(n, u64);
    }
}

fn buffer_flush(buffer mut* b) void {
    if (b->len == 0) {
        return;
    }
    // Clear len before writing so a failure drops the pending bytes.
    u64 len = b->len;
    b->len = 0;
    write_all(b->fd, b->data[..len]);
}

// Report whether bytes contain a newline.
fn has_newline(u8@ bytes) bool {
    for (u64 mut i = 0; i < bytes.len; i++) {
        if (bytes[i] == cast('\n', u8)) {
            return true;
        }
    }
    return false;
}

// Flush before overflow. Bypass the buffer for inputs larger than BUFFER_SIZE.
// Flush line-buffered output after input that contains a newline.
// C call libc.memmove: room.ptr and bytes.ptr keep the bounds of their spans (D9.8 rule 2). The
// length n is bytes.len, and it fits room.len, BUFFER_SIZE - b->len: a larger n flushes b, which
// sets b->len to 0, and an n above BUFFER_SIZE returns before the call. bytes can be a view of
// b->data, because a module can call this function, and memmove takes storage that overlaps.
fn buffer_append(buffer mut* b, u8@ bytes) void {
    u64 n = bytes.len;
    if (n == 0) {
        return;
    }
    if (n > BUFFER_SIZE - b->len) {
        buffer_flush(b);
    }
    if (n > BUFFER_SIZE) {
        write_all(b->fd, bytes);
        return;
    }
    // The flush above leaves room for n bytes. The span and the copy below
    // therefore stay inside data.
    u8 mut@ room = b->data[b->len..];
    libc.memmove(room.ptr, bytes.ptr, n);
    b->len += n;
    if (b->is_line_buffered && has_newline(bytes)) {
        buffer_flush(b);
    }
}

// Assign a buffer to fd. Return null for stderr or a negative descriptor.
fn buffer_for(i32 fd) buffer mut* {
    if (fd == STDERR_FD || fd < 0) {
        return null;
    }
    buffers_init();
    u64 mut free_slot = 0;
    for (u64 mut i = 0; i < BUFFER_COUNT; i++) {
        if (buffers[i].fd == fd) {
            if (i == 0 && stdout_unknown) {
                buffers[0].is_line_buffered = is_interactive(fd);
                stdout_unknown = false;
            }
            return &buffers[i];
        }
        if (buffers[i].fd < 0 && free_slot == 0) {
            free_slot = i;
        }
    }
    // Slot 0 holds stdout, so free_slot 0 means the loop found no free slot.
    // This takes the oldest slot back.
    if (free_slot == 0) {
        free_slot = next_eviction;
        next_eviction = 1 + (next_eviction % BUFFER_POOL_SIZE);
        buffer_flush(&buffers[free_slot]);
    }
    buffers[free_slot].fd = fd;
    buffers[free_slot].is_line_buffered = is_interactive(fd);
    buffers[free_slot].len = 0;
    return &buffers[free_slot];
}

// Sends the bytes to fd through its buffer. For stderr it writes them
// straight to the descriptor.
fn emit(i32 fd, u8@ bytes) void {
    buffer mut* b = buffer_for(fd);
    if (b == null) {
        write_all(fd, bytes);
        return;
    }
    buffer_append(b, bytes);
}

// Write the bytes of a fort string.
fn emit_str(i32 fd, string s) void {
    emit(fd, cast(s, u8@));
}

// Flush fd when it has a buffer.
fn flush(i32 fd) void {
    buffers_init();
    for (u64 mut i = 0; i < BUFFER_COUNT; i++) {
        if (buffers[i].fd == fd) {
            buffer_flush(&buffers[i]);
            return;
        }
    }
}

// Flush the buffer of fd, and make its state fit the file that fd names at the next output:
// io.dup2, or io.close and a new open, can give fd a terminal where it named a regular file, or
// the other way. Slot 0 stays with stdout and asks isatty again at the next output. Another slot
// is free again, so the next output to fd assigns a slot and asks isatty then.
fn reset_buffer(i32 fd) void {
    buffers_init();
    for (u64 mut i = 0; i < BUFFER_COUNT; i++) {
        if (buffers[i].fd == fd) {
            buffer_flush(&buffers[i]);
            if (i == 0) {
                stdout_unknown = true;
            } else {
                buffers[i].fd = -1;
            }
            return;
        }
    }
}

// Flush all assigned buffers.
fn flush_all() void {
    buffers_init();
    for (u64 mut i = 0; i < BUFFER_COUNT; i++) {
        if (buffers[i].fd >= 0) {
            buffer_flush(&buffers[i]);
        }
    }
}

// ---- formatting -------------------------------------------------------------

// Writes the decimal digits of v at the end of out. It answers with the index
// of the first digit. out holds DECIMAL_MAX bytes, which is the longest u64.
// The loop writes one digit before it tests v, so 0 prints as one digit.
fn format_u64(u8 mut@ out, u64 v) u64 {
    u64 mut start = out.len;
    u64 mut rest = v;
    while (true) {
        start -= 1;
        out[start] = cast('0', u8) + cast(rest % DECIMAL_BASE, u8);
        rest /= DECIMAL_BASE;
        if (rest == 0) {
            return start;
        }
    }
}

// Does what format_u64 does, and writes a minus before the digits of a
// negative v. No i64 holds the magnitude of i64's minimum, so the subtraction
// below runs in u64 and wraps. A subtraction that must wrap is spelled -%.
// That magnitude is 19 digits, so out keeps one byte for the minus.
fn format_i64(u8 mut@ out, i64 v) u64 {
    if (v >= 0) {
        return format_u64(out, cast(v, u64));
    }
    u64 magnitude = 0 -% cast(v, u64);
    u64 start = format_u64(out, magnitude) - 1;
    out[start] = cast('-', u8);
    return start;
}

// Writes 0x and the lowercase hex digits of v at the end of out, with no
// leading zero. It writes 0x0 for 0. out holds HEX_MAX bytes. It answers with
// the index of the first byte of the text.
fn format_hex(u8 mut@ out, u64 v) u64 {
    u64 mut start = out.len;
    u64 mut rest = v;
    while (true) {
        start -= 1;
        out[start] = cast(HEX_DIGITS[rest % HEX_BASE], u8);
        rest /= HEX_BASE;
        if (rest == 0) {
            start -= 1;
            out[start] = cast('x', u8);
            start -= 1;
            out[start] = cast('0', u8);
            return start;
        }
    }
}

fn emit_u64(i32 fd, u64 v) void {
    u8[DECIMAL_MAX] mut out = {};
    u64 start = format_u64(out[..], v);
    emit(fd, out[start..]);
}

fn emit_i64(i32 fd, i64 v) void {
    u8[DECIMAL_MAX] mut out = {};
    u64 start = format_i64(out[..], v);
    emit(fd, out[start..]);
}

fn print_i64(i32 fd, i64 v) void {
    emit_i64(fd, v);
}

fn print_u64(i32 fd, u64 v) void {
    emit_u64(fd, v);
}

// Write true or false.
fn print_bool(i32 fd, bool v) void {
    emit_str(fd, v ? "true" : "false");
}

// Writes the byte of c. The print family writes a char as its byte, whatever
// that byte is.
fn print_char(i32 fd, char c) void {
    u8[1] mut one = {};
    one[0] = cast(c, u8);
    emit(fd, one[..]);
}

// Writes 0x and lowercase hex digits. It writes 0x0 for null.
fn print_ptr(i32 fd, void* p) void {
    u8[HEX_MAX] mut out = {};
    u64 start = format_hex(out[..], cast(p, u64));
    emit(fd, out[start..]);
}

// Write the bytes of s without a terminator. An empty string reaches no buffer and no `write`.
fn print_str(i32 fd, string s) void {
    if (s.len == 0) {
        return;
    }
    emit_str(fd, s);
}

// Write the first matching enum name. Write the numeric value when none matches. The compiler
// gives each name as a NUL-terminated C string.
// C call str.from_cstr: table[i].name, a place that the function reaches through the parameter
// table, so the pointer and its NUL are parameter sources (D9.8 rule 1), and print_enum is a
// boundary function. Each caller gives a table whose names end in a NUL: the code that the
// compiler emits (A8), or a trusted module by its row.
fn print_enum(i32 fd, i32 v, enum_member@ table) void {
    for (u64 mut i = 0; i < table.len; i++) {
        if (table[i].value == v) {
            emit_str(fd, str.from_cstr(table[i].name));
            return;
        }
    }
    emit_i64(fd, cast(v, i64));
}

// ---- float formatting -------------------------------------------------------
// Find the shortest decimal that reads back to the input value.
// For equal lengths, use the nearest decimal and resolve ties with an even last digit.
// Try the next higher decimal before adding a digit because float spacing is asymmetric.
// Use exponent form below 1e-4 and from 1e17. Other finite values use fixed form.
// Fixed integer text gets `.0`. Exponents have a sign and at least two digits.
// Buffers use exact maximum widths. Increase a buffer with any wider format.

// These digit counts always read back to the input type.
u64 DIGITS_F64 = 17;
u64 DIGITS_F32 = 9;

// Use exponent form outside this half-open range.
i32 EXP_LOW = -4;
i32 EXP_HIGH = 17;

// Write at least two exponent digits.
u64 EXP_MIN_DIGITS = 2;

// Maximum buffer sizes for float formatting.
u64 TEXT_MAX = 40;
u64 TEXT_MAX_NUL = 41;
u64 SCRATCH_MAX = 32;
u64 EXPONENT_MAX = 8;

// Largest finite values, used to detect infinity after NaN.
f64 F64_MAX = 1.7976931348623157e308;
f32 F32_MAX = 3.4028234663852886e38;

// Sign-bit positions distinguish negative zero.
u64 F64_SIGN_SHIFT = 63;
u32 F32_SIGN_SHIFT = 31;

// The bytes of an f64 and of an f32, which the sign test copies.
u64 F64_BYTES = 8;
u64 F32_BYTES = 4;

// Request exponent form with a variable precision.
string FORMAT = "%.*e";

// Holds significant digits and the decimal exponent of the first digit.
// Keep the sign separate because negative zero has no nonzero digit.
struct decimal {
    u64 digit_count;
    i32 exponent;
    u8[DIGITS_F64] digit;
}

// ---- reading snprintf's text ------------------------------------------------

fn is_digit(char c) bool {
    return c >= '0' && c <= '9';
}

fn digit_of(char c) u64 {
    return cast(c, u64) - cast('0', u64);
}

fn char_of(u64 digit) char {
    return cast(cast('0', u64) + digit, char);
}

// Parse unsigned %e text into digits and an exponent. The text is the bytes of buf before its
// first NUL, or all of buf when it holds no NUL.
// Treat text without digits as zero so a failed snprintf has a defined result.
fn scan(char@ buf, decimal mut* d) void {
    u64 mut end = 0;
    while (end < buf.len && buf[end] != '\0') {
        end += 1;
    }
    char@ text = buf[0..end];
    d->digit_count = 0;
    d->exponent = 0;
    u64 mut i = 0;
    while (i < text.len && text[i] != 'e') {
        if (is_digit(text[i]) && d->digit_count < DIGITS_F64) {
            d->digit[d->digit_count] = cast(digit_of(text[i]), u8);
            d->digit_count += 1;
        }
        i += 1;
    }
    if (d->digit_count == 0) {
        d->digit[0] = 0;
        d->digit_count = 1;
    }
    if (i >= text.len) {
        return;
    }
    // The `e` and what follows it.
    i += 1;
    bool mut negative = false;
    if (i < text.len && (text[i] == '+' || text[i] == '-')) {
        negative = text[i] == '-';
        i += 1;
    }
    i32 mut exponent = 0;
    while (i < text.len && is_digit(text[i])) {
        exponent = exponent * cast(DECIMAL_BASE, i32) + cast(digit_of(text[i]), i32);
        i += 1;
    }
    if (negative) {
        d->exponent = -exponent;
    } else {
        d->exponent = exponent;
    }
}

// Increment a decimal without changing its precision.
// All nines become one digit and increment the exponent.
fn step_up(decimal mut* d) void {
    u64 mut i = d->digit_count;
    while (i > 0) {
        i -= 1;
        if (cast(d->digit[i], u64) < DECIMAL_BASE - 1) {
            d->digit[i] += 1;
            return;
        }
        d->digit[i] = 0;
    }
    d->digit[0] = 1;
    d->digit_count = 1;
    d->exponent += 1;
}

// ---- the float layout -------------------------------------------------------

// Append `e`, a sign, and at least two exponent digits.
fn put_exponent(char mut@ out, u64 at, i32 exponent) u64 {
    u64 mut n = at;
    out[n] = 'e';
    n += 1;
    u64 mut magnitude = cast(exponent, u64);
    if (exponent < 0) {
        out[n] = '-';
        magnitude = cast(-exponent, u64);
    } else {
        out[n] = '+';
    }
    n += 1;
    char[EXPONENT_MAX] mut text = {};
    u64 mut start = EXPONENT_MAX;
    u64 mut rest = magnitude;
    while (true) {
        start -= 1;
        text[start] = char_of(rest % DECIMAL_BASE);
        rest /= DECIMAL_BASE;
        if (rest == 0) {
            break;
        }
    }
    while (EXPONENT_MAX - start < EXP_MIN_DIGITS) {
        start -= 1;
        text[start] = '0';
    }
    while (start < EXPONENT_MAX) {
        out[n] = text[start];
        n += 1;
        start += 1;
    }
    return n;
}

// Lay out digits in fixed or exponent form and return the byte count.
// Fixed integer text gets `.0`.
fn layout(bool negative, decimal* d, char mut@ out) u64 {
    u64 mut n = 0;
    if (negative) {
        out[n] = '-';
        n += 1;
    }
    if (d->exponent < EXP_LOW || d->exponent >= EXP_HIGH) {
        out[n] = char_of(cast(d->digit[0], u64));
        n += 1;
        if (d->digit_count > 1) {
            out[n] = '.';
            n += 1;
            for (u64 mut i = 1; i < d->digit_count; i += 1) {
                out[n] = char_of(cast(d->digit[i], u64));
                n += 1;
            }
        }
        return put_exponent(out, n, d->exponent);
    }
    if (d->exponent < 0) {
        out[n] = '0';
        n += 1;
        out[n] = '.';
        n += 1;
        // The zeros between the point and the first digit.
        for (i32 mut i = -1; i > d->exponent; i -= 1) {
            out[n] = '0';
            n += 1;
        }
        for (u64 mut i = 0; i < d->digit_count; i += 1) {
            out[n] = char_of(cast(d->digit[i], u64));
            n += 1;
        }
        return n;
    }
    u64 integer_digits = cast(d->exponent, u64) + 1;
    for (u64 mut i = 0; i < integer_digits; i += 1) {
        // The integer part is padded with zeros when the digits run out
        // before the point.
        if (i < d->digit_count) {
            out[n] = char_of(cast(d->digit[i], u64));
        } else {
            out[n] = '0';
        }
        n += 1;
    }
    out[n] = '.';
    n += 1;
    if (d->digit_count <= integer_digits) {
        out[n] = '0';
        n += 1;
        return n;
    }
    for (u64 mut i = integer_digits; i < d->digit_count; i += 1) {
        out[n] = char_of(cast(d->digit[i], u64));
        n += 1;
    }
    return n;
}

// ---- the shortest-digit search ----------------------------------------------

// The decimal as a NUL-terminated text, laid out as it would print, which is
// the text the reader is given.
// writes: the n chars of the text into buf and a NUL at buf[n], each by a checked index (D10.6),
// so a NUL stands in buf when the function returns (D9.8 rule 4).
fn decimal_text(decimal* d, char mut@ buf) void {
    u64 n = layout(false, d, buf);
    buf[n] = '\0';
}

// Report whether C parsing reads the decimal back to v.
// Ignore ERANGE because subnormal results can still match.
// C call libc.strtod: &text[0] keeps the bound of text, TEXT_MAX_NUL bytes (D9.8 rule 2). The NUL
// is the one that decimal_text stores at text[n] by a checked index (rule 4), into text, a local
// of this function that lives until the call. end is null.
fn reads_back_f64(decimal* d, f64 v) bool {
    char[TEXT_MAX_NUL] mut text = {};
    decimal_text(d, text[..]);
    return libc.strtod(&text[0], null) == v;
}

// C call libc.strtof: as strtod in reads_back_f64: &text[0] of text (rule 2), the NUL that
// decimal_text stores (rule 4), and end null.
fn reads_back_f32(decimal* d, f32 v) bool {
    char[TEXT_MAX_NUL] mut text = {};
    decimal_text(d, text[..]);
    return libc.strtof(&text[0], null) == v;
}

// Find the shortest f64 decimal that reads back to finite, nonnegative v.
// Try the next higher decimal at each precision.
// C call libc.snprintf_float: &scratch[0] keeps the bound of scratch, SCRATCH_MAX bytes (D9.8
// rule 2), and the size SCRATCH_MAX fits it. fmt is &FORMAT[0], a string literal through a
// global that is no `mut` global, with its NUL (rule 4); `%.*e` reads the int precision and the
// double v.
fn decimal_f64(f64 v, decimal mut* d) void {
    char[SCRATCH_MAX] mut scratch = {};
    for (u64 mut precision = 0; precision < DIGITS_F64; precision += 1) {
        scratch[0] = '\0';
        if (libc.snprintf_float(&scratch[0], SCRATCH_MAX, &FORMAT[0],
                                cast(precision, i32), v) < 0) {
            // A printf that fails leaves the text empty, which scans as zero.
            scratch[0] = '\0';
        }
        scan(scratch[..], d);
        if (precision == DIGITS_F64 - 1 || reads_back_f64(d, v)) {
            return;
        }
        decimal mut up = *d;
        step_up(&up);
        if (reads_back_f64(&up, v)) {
            *d = up;
            return;
        }
    }
}

// Find the shortest f32 decimal. Widening for snprintf preserves its value.
// C call libc.snprintf_float: as in decimal_f64: &scratch[0] with the size SCRATCH_MAX (rule 2),
// fmt &FORMAT[0] with its NUL (rule 4), and an int and a double for `%.*e`.
fn decimal_f32(f32 v, decimal mut* d) void {
    char[SCRATCH_MAX] mut scratch = {};
    for (u64 mut precision = 0; precision < DIGITS_F32; precision += 1) {
        scratch[0] = '\0';
        if (libc.snprintf_float(&scratch[0], SCRATCH_MAX, &FORMAT[0],
                                cast(precision, i32), cast(v, f64)) < 0) {
            scratch[0] = '\0';
        }
        scan(scratch[..], d);
        if (precision == DIGITS_F32 - 1 || reads_back_f32(d, v)) {
            return;
        }
        decimal mut up = *d;
        step_up(&up);
        if (reads_back_f32(&up, v)) {
            *d = up;
            return;
        }
    }
}

// ---- the two float entry points ---------------------------------------------

// Read the sign bit through memcpy so negative zero remains distinct.
// C call libc.memcpy: cast(&bits, u8 mut*) and cast(&source, u8*) keep the bounds of the locals
// bits and source, 8 bytes each (D9.8 rule 2), and the length F64_BYTES is 8. Two locals do
// not overlap.
fn negative_f64(f64 v) bool {
    u64 mut bits = 0;
    f64 mut source = v;
    libc.memcpy(cast(&bits, u8 mut*), cast(&source, u8*), F64_BYTES);
    return (bits >> F64_SIGN_SHIFT) != 0;
}

// C call libc.memcpy: as in negative_f64, with two locals of 4 bytes and F32_BYTES, 4.
fn negative_f32(f32 v) bool {
    u32 mut bits = 0;
    f32 mut source = v;
    libc.memcpy(cast(&bits, u8 mut*), cast(&source, u8*), F32_BYTES);
    return (bits >> F32_SIGN_SHIFT) != 0;
}

// Format one f64 into out and return its byte count.
fn text_f64(f64 v, char mut@ out) u64 {
    if (v != v) {
        // All NaN values use the same text.
        return fixed_text(out, "nan");
    }
    bool negative = negative_f64(v);
    if (v > F64_MAX || v < -F64_MAX) {
        // Every finite f64 is at most F64_MAX in magnitude, so a larger one is
        // an infinity.
        if (negative) {
            return fixed_text(out, "-inf");
        }
        return fixed_text(out, "inf");
    }
    f64 mut magnitude = v;
    if (negative) {
        magnitude = -v;
    }
    decimal mut d = decimal{};
    decimal_f64(magnitude, &d);
    return layout(negative, &d, out);
}

// Format in f32 precision without first widening the value.
fn text_f32(f32 v, char mut@ out) u64 {
    if (v != v) {
        return fixed_text(out, "nan");
    }
    bool negative = negative_f32(v);
    if (v > F32_MAX || v < -F32_MAX) {
        if (negative) {
            return fixed_text(out, "-inf");
        }
        return fixed_text(out, "inf");
    }
    f32 mut magnitude = v;
    if (negative) {
        magnitude = -v;
    }
    decimal mut d = decimal{};
    decimal_f32(magnitude, &d);
    return layout(negative, &d, out);
}

// Copy one fixed float text into out.
fn fixed_text(char mut@ out, string text) u64 {
    u64 mut i = 0;
    while (i < text.len) {
        out[i] = text[i];
        i += 1;
    }
    return text.len;
}

/// Writes the standard f64 text for v to fd through runtime output.
fn print_f64(i32 fd, f64 v) void {
    char[TEXT_MAX] mut out = {};
    u64 n = text_f64(v, out[..]);
    emit(fd, cast(out[0..n], u8@));
}

/// Writes the standard f32 text for v to fd through runtime output.
fn print_f32(i32 fd, f32 v) void {
    char[TEXT_MAX] mut out = {};
    u64 n = text_f32(v, out[..]);
    emit(fd, cast(out[0..n], u8@));
}

/// Appends the same f64 text that print_f64 writes.
fn append_f64(strbuf.str_buf mut* b, f64 v) void {
    char[TEXT_MAX] mut out = {};
    u64 n = text_f64(v, out[..]);
    strbuf.append_bytes(b, cast(out[0..n], u8@));
}

/// Appends the same f32 text that print_f32 writes.
fn append_f32(strbuf.str_buf mut* b, f32 v) void {
    char[TEXT_MAX] mut out = {};
    u64 n = text_f32(v, out[..]);
    strbuf.append_bytes(b, cast(out[0..n], u8@));
}

// ---- failures ---------------------------------------------------------------

fn message_str(string s) void {
    buffer_append(&message, cast(s, u8@));
}

fn message_u64(u64 v) void {
    u8[DECIMAL_MAX] mut out = {};
    u64 start = format_u64(out[..], v);
    buffer_append(&message, out[start..]);
}

fn message_i64(i64 v) void {
    u8[DECIMAL_MAX] mut out = {};
    u64 start = format_i64(out[..], v);
    buffer_append(&message, out[start..]);
}

// Flushes every buffer. It then starts the failure line with the position and
// the kind. The kind is "runtime error", "panic" or "assertion failed". The
// runtime error contract fixes this shape for all three. The compiler gives the
// file as a NUL-terminated C string.
// C call str.from_cstr: file and its NUL are parameter sources (D9.8 rule 1), so fail_begin is
// a boundary function, and each caller gives a file name with its NUL.
fn fail_begin(char* file, u32 line, u32 col, string kind) void {
    flush_all();
    message.len = 0;
    message_str(str.from_cstr(file));
    message_str(":");
    message_u64(cast(line, u64));
    message_str(":");
    message_u64(cast(col, u64));
    message_str(": ");
    message_str(kind);
    message_str(": ");
}

// Ends the line, writes it, and calls abort. The process then ends with
// SIGABRT.
// C call libc.abort: no pointer argument.
fn fail_end() noreturn {
    message_str("\n");
    buffer_flush(&message);
    libc.abort();
}

// C call fail_begin: file and its NUL are parameter sources (D9.8 rule 1), so this is a
// boundary function, and each caller gives a file name with its NUL: a function of std.rt,
// which passes on the one that the code of the compiler gave it (A8), or a trusted module by
// its row.
fn fail_runtime(char* file, u32 line, u32 col, string what) noreturn {
    fail_begin(file, line, col, "runtime error");
    message_str(what);
    fail_end();
}

// C call fail_begin: file and its NUL are parameter sources (D9.8 rule 1), so this is a
// boundary function, and each caller gives a file name with its NUL: the code that the
// compiler emits (A8), or a trusted module by its row.
fn fail_bounds(i64 index, u64 len, char* file, u32 line, u32 col) noreturn {
    fail_begin(file, line, col, "runtime error");
    message_str("index ");
    message_i64(index);
    message_str(" out of range for length ");
    message_u64(len);
    fail_end();
}

// C call fail_begin: file and its NUL are parameter sources (D9.8 rule 1), so this is a
// boundary function, and each caller gives a file name with its NUL: the code that the
// compiler emits (A8), or a trusted module by its row.
fn fail_span(i64 lo, i64 hi, u64 len, char* file, u32 line, u32 col) noreturn {
    fail_begin(file, line, col, "runtime error");
    message_str("span bounds ");
    message_i64(lo);
    message_str("..");
    message_i64(hi);
    message_str(" out of range for length ");
    message_u64(len);
    fail_end();
}

// C call fail_runtime: file and its NUL are parameter sources (D9.8 rule 1), so this is a
// boundary function, and each caller gives a file name with its NUL: the code that the
// compiler emits (A8), or a trusted module by its row.
fn fail_overflow(char* file, u32 line, u32 col) noreturn {
    fail_runtime(file, line, col, "integer overflow");
}

// C call fail_begin: file and its NUL are parameter sources (D9.8 rule 1), so this is a
// boundary function, and each caller gives a file name with its NUL: the code that the
// compiler emits (A8), or a trusted module by its row.
// C call str.from_cstr: type_name and its NUL are parameter sources (rule 1), which each
// caller gives as for file.
fn fail_shift(i64 count, char* type_name, char* file, u32 line, u32 col) noreturn {
    fail_begin(file, line, col, "runtime error");
    message_str("shift count ");
    message_i64(count);
    message_str(" out of range for ");
    message_str(str.from_cstr(type_name));
    fail_end();
}

// C call fail_runtime: file and its NUL are parameter sources (D9.8 rule 1), so this is a
// boundary function, and each caller gives a file name with its NUL: the code that the
// compiler emits (A8), or a trusted module by its row.
fn fail_div_zero(char* file, u32 line, u32 col) noreturn {
    fail_runtime(file, line, col, "division by zero");
}

// C call fail_runtime: file and its NUL are parameter sources (D9.8 rule 1), so this is a
// boundary function, and each caller gives a file name with its NUL: the code that the
// compiler emits (A8), or a trusted module by its row.
fn fail_div_overflow(char* file, u32 line, u32 col) noreturn {
    fail_runtime(file, line, col, "division overflow");
}

// C call fail_begin: file and its NUL are parameter sources (D9.8 rule 1), so this is a
// boundary function, and each caller gives a file name with its NUL: the code that the
// compiler emits (A8), or a trusted module by its row.
fn fail_alloc_count(i64 n, char* file, u32 line, u32 col) noreturn {
    fail_begin(file, line, col, "runtime error");
    message_str("negative allocation count ");
    message_i64(n);
    fail_end();
}

// Reports a store into an own reference that is not zero. This compiler emits no call (D17.11).
// bootstrap-1 of tools/bootstrap.ref emits one for each such store, and it builds no module with
// this std. The tests run/stdlib/082 and run/modes/022 call this entry directly.
// C call fail_runtime: file and its NUL are parameter sources (D9.8 rule 1), so this is a
// boundary function, and each caller, a trusted module, gives a file name with its NUL.
fn fail_overwrite(char* file, u32 line, u32 col) noreturn {
    fail_runtime(file, line, col, "overwriting owned value");
}

// Report an enum value that no switch clause names.
// Zero initialization and integer casts can produce such a value.
// C call fail_begin: file and its NUL are parameter sources (D9.8 rule 1), so this is a
// boundary function, and each caller gives a file name with its NUL: the code that the
// compiler emits (A8), or a trusted module by its row.
// C call str.from_cstr: type_name and its NUL are parameter sources (rule 1), which each
// caller gives as for file.
fn fail_enum(i64 v, char* type_name, char* file, u32 line, u32 col) noreturn {
    fail_begin(file, line, col, "runtime error");
    message_str("enum value ");
    message_i64(v);
    message_str(" is not a member of ");
    message_str(str.from_cstr(type_name));
    fail_end();
}

// Report a panic message, including any embedded NUL byte.
// C call fail_begin: file and its NUL are parameter sources (D9.8 rule 1), so this is a
// boundary function, and each caller gives a file name with its NUL: the code that the
// compiler emits (A8), or a trusted module by its row.
fn panic(string msg, char* file, u32 line, u32 col) noreturn {
    fail_begin(file, line, col, "panic");
    message_str(msg);
    fail_end();
}

// Reports a failed assert. text is the source text of the assert argument,
// byte for byte.
// C call fail_begin: file and its NUL are parameter sources (D9.8 rule 1), so this is a
// boundary function, and each caller gives a file name with its NUL: the code that the
// compiler emits (A8), or a trusted module by its row.
// C call str.from_cstr: text and its NUL are parameter sources (rule 1), which each caller
// gives as for file: the text of the assert with its NUL.
fn assert_fail(char* text, char* file, u32 line, u32 col) noreturn {
    fail_begin(file, line, col, "assertion failed");
    message_str(str.from_cstr(text));
    fail_end();
}

// ---- allocation -------------------------------------------------------------

// Return zeroed storage. Allocate one byte when the requested size is zero.
// Report product overflow or allocation failure at the caller's position.
// gives: a new allocation of calloc of elem_size * count zero bytes, or of 1 zero byte when that
// product is 0, that free frees (A3); never null, because a failure ends the process (D9.8 rule 3).
// C call fail_runtime x2: file and its NUL are parameter sources (D9.8 rule 1), so alloc is a
// boundary function, and each caller gives a file name with its NUL: the code that the compiler
// emits (A8), or a trusted module by its row.
// C call libc.calloc: no pointer argument; C gives a new allocation of size bytes or null.
fn alloc(u64 elem_size, u64 count, char* file, u32 line, u32 col) void mut* own {
    if (elem_size != 0 && count > U64_MAX / elem_size) {
        fail_runtime(file, line, col, "allocation size overflow");
    }
    u64 mut size = elem_size * count;
    if (size == 0) {
        size = 1;
    }
    void mut* own p = libc.calloc(1, size);
    if (p == null) {
        fail_runtime(file, line, col, "out of memory");
    }
    return p;
}

// Release storage from alloc. A null pointer does nothing.
// C call libc.free: p is a parameter source (D9.8 rule 1), so free is a boundary function, and
// each caller gives an owner, an allocation of alloc or null (A3): the code that the compiler
// emits, or a trusted module by its row.
fn free(void* own p) void {
    libc.free(move(p));
}

// Makes the five tests of `regrow` (D12.2) in their order and returns the new storage: a negative
// count, a count below the length of the operand, the size, the operand, and the storage. old and
// old_len are the pointer and the length of the operand. count holds the bits of the count, and
// is_signed says that its type is signed. The test of the operand refuses a null pointer with a
// length that is not 0: such a span is no zero span and starts no allocation. A pointer that is
// not null goes to free, which the code that the compiler emits calls after regrow_move.
// gives: a new allocation of alloc of count elements of elem_size bytes, all zero, that free
// frees (A3); never null, because a failure ends the process (D9.8 rule 3).
// C call fail_alloc_count: file and its NUL are parameter sources (D9.8 rule 1), so regrow is a
// boundary function, and each caller gives a file name with its NUL: the code that the compiler
// emits (A8), or a trusted module by its row.
// C call fail_begin: file, as for fail_alloc_count.
// C call fail_runtime x2: file, as for fail_alloc_count.
// C call alloc: file, as for fail_alloc_count.
fn regrow(void* old, u64 old_len, u64 elem_size, u64 count, bool is_signed, char* file, u32 line,
          u32 col) void mut* own {
    if (is_signed && count > I64_MAX) {
        // count holds the bits of a negative i64 n, and U64_MAX - count is -n - 1.
        fail_alloc_count(-cast(U64_MAX - count, i64) - 1, file, line, col);
    }
    if (count < old_len) {
        fail_begin(file, line, col, "runtime error");
        message_str("regrow count ");
        message_u64(count);
        message_str(" below length ");
        message_u64(old_len);
        fail_end();
    }
    if (elem_size != 0 && count > U64_MAX / elem_size) {
        fail_runtime(file, line, col, "allocation size overflow");
    }
    if (old == null && old_len != 0) {
        fail_runtime(file, line, col, "invalid release");
    }
    return alloc(elem_size, count, file, line, col);
}

// Moves the elements of `regrow` from old to fresh byte for byte: old holds the bytes of the old
// elements, each of elem_size bytes, and fresh the bytes of the new storage. It then stores zero
// into each word of each owner slot of each old element (D12.2, D17.11): slots holds the byte
// offset of each such word in one element. It releases nothing: the caller calls free.
// C call libc.memcpy: room.ptr and old.ptr keep the bounds of their spans (D9.8 rule 2). The
// length is old.len, which is room.len. The two spans are in 2 allocations, because the caller
// gives in fresh storage that regrow returned after the allocation of old.
fn regrow_move(u8 mut@ fresh, u8 mut@ old, u64 elem_size, u64@ slots) void {
    if (old.len == 0) {
        // The empty span has a null pointer, which memcpy may not be given.
        return;
    }
    u8 mut@ room = fresh[0..old.len];
    libc.memcpy(room.ptr, old.ptr, old.len);
    if (slots.len == 0 || elem_size == 0) {
        return;
    }
    for (u64 mut start = 0; start < old.len; start += elem_size) {
        for (u64 mut k = 0; k < slots.len; k++) {
            u64 word = start + slots[k];
            for (u64 mut b = 0; b < WORD_BYTES; b++) {
                old[word + b] = 0;
            }
        }
    }
}

// ---- strings ----------------------------------------------------------------

// Compare string bytes without using ==, which calls this function.
// C call libc.memcmp: a, b and a_len are parameter sources (D9.8 rule 1), so str_eq is a
// boundary function. Each caller gives the `.ptr` and the `.len` of two strings: the code that
// the compiler emits for `==` (A8), or a trusted module by its row. a_len fits both, because
// a_len == b_len, and a_len > 0, so no pointer is the `.ptr` of an empty string.
fn str_eq(char* a, u64 a_len, char* b, u64 b_len) bool {
    if (a_len != b_len) {
        return false;
    }
    if (a_len == 0) {
        // Two empty strings are equal whatever their pointers are, and memcmp
        // may not be given a null pointer even for zero bytes.
        return true;
    }
    return libc.memcmp(cast(a, u8*), cast(b, u8*), a_len) == 0;
}

// ---- process ----------------------------------------------------------------

// Build the argument span from argv before the program's main runs. Only the
// main that the compiler emits calls it (D6.9), with the argc and the argv that
// C gives to main. Delete an earlier span first, so that a second call frees it
// on each path.
// C call str.from_cstr: view[i], an element of argv, so the pointer and its NUL are parameter
// sources (D9.8 rule 1), and args_init is a boundary function: C gives main argc strings, each
// with its NUL (ISO C11 5.1.2.2.1).
fn args_init(i32 argc, char* mut* argv) void {
    del(args_store);
    if (argc <= 0) {
        return;
    }
    u64 n = cast(argc, u64);
    string mut@ own a = new(string, n);
    char* mut@ view = argv[0..n];
    for (u64 mut i = 0; i < n; i++) {
        a[i] = str.from_cstr(view[i]);
    }
    // The calls of str.from_cstr in the loop kill the fact of the first del (D17.11).
    del(args_store);
    args_store = move(a);
}

// Return the process argument span.
// gives: the span that args_init stored, which lives until the process ends; each element is an
// argument that C gave to main, whose .len bytes end in its NUL (ISO C11 5.1.2.2.1, D9.8 rule 4).
fn args() string@ {
    return args_store;
}

// Flushes every buffer and ends the process with status & 0xFF. sys.exit
// calls it.
// C call libc.exit: no pointer argument.
fn exit(i32 status) noreturn {
    flush_all();
    libc.exit(status & EXIT_STATUS_MASK);
}
