/// Provides a hash map from string keys to i64 values.
/// The map uses open addressing, linear probing, and str.hash.
import std.str;

// A tombstone keeps probes valid after a removal.
u8 SLOT_EMPTY = 0;
u8 SLOT_FULL = 1;
u8 SLOT_DEAD = 2;

// Store the hash to reject mismatches and rebuild without rehashing.
struct str_map_entry {
    string key;
    i64 val;
    u64 hash;
    u8 state;
}

/// entries.len is zero or a power of two.
/// live counts entries. used also counts tombstones. str_map{} is a valid empty map.
struct str_map {
    str_map_entry mut@ own entries;
    u64 live;
    u64 used;
}

/// Creates an empty map without allocating.
fn create() str_map {
    return str_map{};
}

/// Frees the table and leaves str_map{}.
/// Repeated calls and calls on an empty map do nothing.
fn free(str_map mut* m) void {
    del(m->entries);
    m->live = 0;
    m->used = 0;
}

// Finds key or returns -1. put always keeps one empty slot, so the probe terminates.
fn find_slot(str_map* m, string key, u64 h) i64 {
    if (m->entries.len == 0) {
        return -1;
    }
    u64 mask = m->entries.len - 1;
    u64 mut i = h & mask;
    while (true) {
        u8 state = m->entries[i].state;
        if (state == SLOT_EMPTY) {
            return -1;
        }
        if (state == SLOT_FULL && m->entries[i].hash == h && m->entries[i].key == key) {
            return cast(i, i64);
        }
        i = (i + 1) & mask;
    }
}

// Rebuilds at a load below one half and removes tombstones.
fn rebuild(str_map mut* m) void {
    u64 mut cap = 16;
    // Address space limits keep this doubling inside u64.
    while ((m->live + 1) * 2 > cap) {
        cap *= 2;
    }
    str_map_entry mut@ own table = new(str_map_entry, cap);
    u64 mask = cap - 1;
    u64 mut k = 0;
    while (k < m->entries.len) {
        if (m->entries[k].state == SLOT_FULL) {
            // The new table has no tombstones and has spare capacity.
            u64 mut i = m->entries[k].hash & mask;
            while (table[i].state == SLOT_FULL) {
                i = (i + 1) & mask;
            }
            table[i] = m->entries[k];
        }
        k += 1;
    }
    del(m->entries);
    m->entries = move(table);
    m->used = m->live;
}

/// Inserts key and val, or replaces the value for an equal key.
/// Returns true for a new key. The map stores the first key without copying it.
fn put(str_map mut* m, string key, i64 val) bool {
    u64 h = str.hash(key);
    i64 found = find_slot(m, key, h);
    if (found >= 0) {
        // Keep the key from the first insertion.
        m->entries[cast(found, u64)].val = val;
        return false;
    }
    // Rebuild before insertion to keep one empty slot.
    if (m->entries.len == 0 || (m->used + 1) * 4 > m->entries.len * 3) {
        rebuild(m);
    }
    u64 mask = m->entries.len - 1;
    u64 mut i = h & mask;
    // Reuse the first tombstone in the probe.
    i64 mut dead = -1;
    while (m->entries[i].state != SLOT_EMPTY) {
        if (m->entries[i].state == SLOT_DEAD && dead < 0) {
            dead = cast(i, i64);
        }
        i = (i + 1) & mask;
    }
    if (dead >= 0) {
        // A tombstone already counts in used.
        i = cast(dead, u64);
    } else {
        m->used += 1;
    }
    m->entries[i] = str_map_entry{key, val, h, SLOT_FULL};
    m->live += 1;
    return true;
}

/// Returns true and writes the value when key exists.
/// Returns false and leaves *out unchanged when key is absent.
fn get(str_map* m, string key, i64 mut* out) bool {
    i64 found = find_slot(m, key, str.hash(key));
    if (found < 0) {
        return false;
    }
    *out = m->entries[cast(found, u64)].val;
    return true;
}

fn has(str_map* m, string key) bool {
    return find_slot(m, key, str.hash(key)) >= 0;
}

/// Removes key and reports whether it existed.
fn remove(str_map mut* m, string key) bool {
    i64 found = find_slot(m, key, str.hash(key));
    if (found < 0) {
        return false;
    }
    m->entries[cast(found, u64)].state = SLOT_DEAD;
    m->live -= 1;
    return true;
}

/// The number of entries, tombstones excluded.
fn count(str_map* m) u64 {
    return m->live;
}
