/// Provides byte-span copy, fill, and equality operations.
import std.heap;
import std.libc;

/// Copies src to the start of dst. The ranges can overlap.
/// Panics when dst is too short. An empty src makes no C call.
// C call libc.memmove: dst.ptr and src.ptr keep the bounds of their spans (D9.8 rule 2), and the
// length src.len fits both, because the panic holds src.len <= dst.len. src.len > 0, so neither
// pointer is the `.ptr` of an empty span.
fn copy(u8 mut@ dst, u8@ src) void {
    if (dst.len < src.len) {
        panic("mem.copy: destination too short");
    }
    if (src.len == 0) {
        return;
    }
    libc.memmove(dst.ptr, src.ptr, src.len);
}

/// Sets each byte of dst to v. An empty dst makes no C call.
// C call libc.memset: dst.ptr keeps the bound of dst (rule 2), and the length is dst.len, which
// is above 0.
fn fill(u8 mut@ dst, u8 v) void {
    if (dst.len == 0) {
        return;
    }
    libc.memset(dst.ptr, cast(v, i32), dst.len);
}

/// Reports whether the spans have equal lengths and bytes.
/// Two empty spans are equal, regardless of their pointers.
// C call libc.memcmp: a.ptr and b.ptr keep the bounds of their spans (rule 2), and the length
// a.len fits both, because a.len == b.len and a.len > 0.
fn equal(u8@ a, u8@ b) bool {
    if (a.len != b.len) {
        return false;
    }
    if (a.len == 0) {
        return true;
    }
    return libc.memcmp(a.ptr, b.ptr, a.len) == 0;
}

/// Reports whether `new` gives `size` bytes now: the allocator of the runtime has the address
/// range, and the system gives the storage. It takes no storage. `new` stops the process with
/// `out of memory` where this function returns false, so a caller that must see a refusal of a
/// large size asks here first.
fn can_allocate(u64 size) bool {
    return heap.can_take(size);
}
