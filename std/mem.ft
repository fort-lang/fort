// std.mem: byte-span primitives over memmove, memset and memcmp
// (stdlib.md 2.3). Only u8 spans are covered: a span cast never changes the
// element size, so other element types are copied with a loop. The three C
// functions take u8* and u8 mut*, so a span's .ptr crosses with no cast and
// the type system holds the destination to what the caller may write.
// D3.11, D3.14, D13.2
import std.libc;

/// Copies src.len bytes to the start of dst; the ranges may overlap (memmove
/// semantics). An empty src is a no-op and makes no C call, which is not only
/// an economy: a zero span from {} has a null .ptr, and C forbids a null
/// pointer argument to memmove even for zero bytes. A destination too short is
/// a violated precondition, so it panics rather than returning a result.
/// Ownership: none; an own span argument lends.
/// D13.3, D17.4
fn copy(u8 mut@ dst, u8@ src) void {
    if (dst.len < src.len) {
        panic("mem.copy: destination too short");
    }
    if (src.len == 0) {
        return;
    }
    libc.memmove(dst.ptr, src.ptr, src.len);
}

/// Sets every byte of dst to v. An empty dst makes no C call, since its .ptr
/// may be null and C forbids that to memset. Ownership: none.
fn fill(u8 mut@ dst, u8 v) void {
    if (dst.len == 0) {
        return;
    }
    libc.memset(dst.ptr, cast(v, i32), dst.len);
}

/// True when the lengths are equal and the bytes match; two empty spans are
/// equal whatever their pointers, including two null ones, which is why the
/// length test comes first and the zero case returns before memcmp. Ownership:
/// none.
fn equal(u8@ a, u8@ b) bool {
    if (a.len != b.len) {
        return false;
    }
    if (a.len == 0) {
        return true;
    }
    return libc.memcmp(a.ptr, b.ptr, a.len) == 0;
}
