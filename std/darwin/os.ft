// os: the target of this standard library and the path of the running binary on Mac arm64.

import std.libc;
import std.str;
import std.strbuf;

/// The target triple of this standard library. A compiler built with it uses this target when
/// --target is absent.
/// D14.1
string TARGET = "arm64-apple-macosx11.0.0";

/// dyld gives the path of the running binary. The function is dyld's (<mach-o/dyld.h>), not the
/// C library's.
/// D9.8
extern fn _NSGetExecutablePath(char mut* buf, u32 mut* size) i32;

/// The buffer sizes the path is read with.
u64 EXE_PATH_FIRST_CAP = 256;
u64 EXE_PATH_MAX_CAP = 65536;

/// Appends the path of the running binary to `out` and returns true. realpath resolves the dyld
/// path when the file still exists at that path. Returns false and leaves `out` unchanged when
/// the system cannot give the path.
/// D14.1
fn exe_path(strbuf.str_buf mut* out) bool {
    u32 mut cap = cast(EXE_PATH_FIRST_CAP, u32);
    while (cast(cap, u64) <= EXE_PATH_MAX_CAP) {
        u32 allocated = cap;
        char mut@ own buf = new(char, cast(cap, u64));
        defer del(buf);
        if (_NSGetExecutablePath(buf.ptr, &cap) == 0) {
            char* own canonical = libc.realpath(buf.ptr, null);
            if (canonical != null) {
                strbuf.append(out, str.from_cstr(canonical));
                libc.free(cast(move(canonical), void* own));
                return true;
            }
            strbuf.append(out, str.from_cstr(buf.ptr));
            return true;
        }
        if (cap <= allocated || cast(cap, u64) > EXE_PATH_MAX_CAP) {
            return false;
        }
    }
    return false;
}
