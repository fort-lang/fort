// std.str: operations on string (D3.7, stdlib.md 2.5, D13.2). None of them
// allocates unless its comment says so; the three that do return own values
// (D13.5).
import std.libc;
import std.mem;

// The same as a == b (D3.7); it exists so that equality can be a function
// value. A string own operand lends (D17.4). Ownership: none.
fn bool equal(string a, string b) {
    return a == b;
}

// Lexicographic order by unsigned byte value, the order < gives char (D3.2),
// with a proper prefix sorting first; returns -1, 0 or 1. Ownership: none.
fn i32 cmp(string a, string b) {
    u64 mut n = a.len;
    if (b.len < n) {
        n = b.len;
    }
    u64 mut i = 0;
    while (i < n) {
        if (a[i] != b[i]) {
            if (a[i] < b[i]) {
                return -1;
            }
            return 1;
        }
        i += 1;
    }
    if (a.len < b.len) {
        return -1;
    }
    if (a.len > b.len) {
        return 1;
    }
    return 0;
}

// 64-bit FNV-1a: start from the offset basis and, for each byte, xor it in and
// multiply by the prime. The wrapping multiply (D11.2) makes the value
// identical in both build modes; the empty string hashes to the offset basis.
// Fixed by stdlib.md 2.5 because strmap and on-disk formats depend on it.
fn u64 hash(string s) {
    u64 mut h = 0xcbf29ce484222325;
    for (char ch : s) {
        h ^= cast(ch, u64);
        h *%= 0x100000001b3;
    }
    return h;
}

// prefix.len <= s.len && s[..prefix.len] == prefix. An empty prefix always
// matches. Ownership: none.
fn bool starts_with(string s, string prefix) {
    if (prefix.len > s.len) {
        return false;
    }
    return s[..prefix.len] == prefix;
}

// The mirror image for suffixes; an empty suffix always matches.
fn bool ends_with(string s, string suffix) {
    if (suffix.len > s.len) {
        return false;
    }
    return s[s.len - suffix.len..] == suffix;
}

// Position of the first ch in s, or -1. Ownership: none.
fn i64 index_of(string s, char ch) {
    u64 mut i = 0;
    while (i < s.len) {
        if (s[i] == ch) {
            return cast(i, i64);
        }
        i += 1;
    }
    return -1;
}

// Position of the last ch in s, or -1. Ownership: none.
fn i64 last_index_of(string s, char ch) {
    u64 mut i = s.len;
    while (i > 0) {
        i -= 1;
        if (s[i] == ch) {
            return cast(i, i64);
        }
    }
    return -1;
}

// Position of the first occurrence of needle in s, or -1; an empty needle is
// found at 0. Simple quadratic search, adequate for source-sized inputs.
fn i64 find(string s, string needle) {
    if (needle.len > s.len) {
        return -1;
    }
    u64 mut i = 0;
    while (i + needle.len <= s.len) {
        if (s[i..i + needle.len] == needle) {
            return cast(i, i64);
        }
        i += 1;
    }
    return -1;
}

// Heap copy of s with result.len == s.len, not NUL-terminated. dup("") is a
// zero-length, non-null allocation (D10.2). The move empties buf, so no second
// owning copy survives (D17.14). Ownership: returns string own; the caller
// binds it, passes it on or dels it (D17.12).
fn string own dup(string s) {
    u8 mut@ own buf = new(u8, s.len);
    mem.copy(buf, cast(s, u8@));
    return cast(move(buf), string own);
}

// Heap copy of a followed by b, not NUL-terminated; result.len is
// a.len + b.len, which is also the allocation size. Ownership: as dup.
fn string own concat(string a, string b) {
    u8 mut@ own buf = new(u8, a.len + b.len);
    mem.copy(buf[..a.len], cast(a, u8@));
    mem.copy(buf[a.len..], cast(b, u8@));
    return cast(move(buf), string own);
}

// The one sanctioned way to hand a string to C (D13.4): a heap copy with a
// trailing '\0', of length s.len + 1, whose .ptr is the C string and whose
// [..s.len] is the text. new(char, n) is already zeroed (D10.2), so the last
// byte is the terminator. If s contains \0, C sees the prefix.
// Ownership: returns char mut@ own; the caller releases it with del.
fn char mut@ own to_cstr(string s) {
    char mut@ own buf = new(char, s.len + 1);
    mem.copy(cast(buf[..s.len], u8 mut@), cast(s, u8@));
    return buf;
}

// Wraps the C string at p without copying, so the result aliases p and stays
// valid as long as p does; from_cstr(null) is the zero string. Ownership: a
// view (D17.3) of whatever owns p; del on it does not compile.
fn string from_cstr(char* p) {
    if (p == null) {
        string zero = {};
        return zero;
    }
    return cast(p[0..libc.strlen(p)], string);
}

// Decimal with an optional leading -, at least one digit and nothing else: no
// +, no whitespace, no _. Returns false on a syntax error or when the value
// does not fit i64; -9223372036854775808 is accepted. Overflow is detected
// arithmetically, before the multiply, so neither build mode's behavior is
// relied on (D11.1). On failure *out is unchanged (D13.3).
fn bool parse_i64(string s, i64 mut* out) {
    u64 mut i = 0;
    bool mut negative = false;
    if (s.len > 0 && s[0] == '-') {
        negative = true;
        i = 1;
    }
    if (i >= s.len) {
        return false;
    }
    // The largest magnitude each sign admits: i64 MAX, and MIN's magnitude.
    // Both bounds are named, as parse_u64 names its own, so that the value
    // the negation below depends on cannot drift away from the one the loop
    // enforces.
    u64 i64_max = 9223372036854775807;
    u64 i64_min_magnitude = 9223372036854775808;
    u64 mut limit = i64_max;
    if (negative) {
        limit = i64_min_magnitude;
    }
    u64 mut magnitude = 0;
    while (i < s.len) {
        if (!is_digit(s[i])) {
            return false;
        }
        u64 value = cast(digit_value(s[i]), u64);
        // magnitude * 10 + value <= limit, without performing the multiply.
        if (magnitude > (limit - value) / 10) {
            return false;
        }
        magnitude = magnitude * 10 + value;
        i += 1;
    }
    if (!negative) {
        *out = cast(magnitude, i64);
        return true;
    }
    if (magnitude == i64_min_magnitude) {
        // MIN's magnitude is 2^63, whose bits are MIN itself, and a same-width
        // sign change reinterprets (D3.14). So the one magnitude with no i64
        // negation is delivered by the cast alone and -MIN is never computed.
        *out = cast(i64_min_magnitude, i64);
        return true;
    }
    *out = -cast(magnitude, i64);
    return true;
}

// Digits of base (2 to 36) using 0-9, a-z and A-Z, no sign, no 0x prefix, no _
// (stripping prefixes and separators is the lexer's job). Returns false when s
// is empty, base is out of range, a character is not a digit below base, or
// the value overflows u64. On failure *out is unchanged (D13.3).
fn bool parse_u64(string s, u64 base, u64 mut* out) {
    if (base < 2 || base > 36) {
        return false;
    }
    if (s.len == 0) {
        return false;
    }
    u64 u64_max = 18446744073709551615;
    u64 mut result = 0;
    for (char ch : s) {
        i64 digit = digit_value(ch);
        if (digit < 0) {
            return false;
        }
        u64 value = cast(digit, u64);
        if (value >= base) {
            return false;
        }
        // result * base + value <= u64_max, without performing the multiply.
        if (result > (u64_max - value) / base) {
            return false;
        }
        result = result * base + value;
    }
    *out = result;
    return true;
}

// The value of ch as a digit in bases up to 36 ('7' is 7, 'b' and 'B' are 11),
// or -1. char has no arithmetic (D3.2), so the byte is cast first.
fn i64 digit_value(char ch) {
    i64 byte = cast(ch, i64);
    if (ch >= '0' && ch <= '9') {
        return byte - cast('0', i64);
    }
    if (ch >= 'a' && ch <= 'z') {
        return byte - cast('a', i64) + 10;
    }
    if (ch >= 'A' && ch <= 'Z') {
        return byte - cast('A', i64) + 10;
    }
    return -1;
}

// ASCII classification: every byte at or above 0x80 classifies as false, which
// the unsigned byte order of char gives for free (D3.2).
fn bool is_digit(char ch) {
    return ch >= '0' && ch <= '9';
}

// A-Z and a-z, not _.
fn bool is_alpha(char ch) {
    return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z');
}

fn bool is_alnum(char ch) {
    return is_digit(ch) || is_alpha(ch);
}

// Space, \t, \n, \x0b, \x0c, \r.
fn bool is_space(char ch) {
    return ch == ' ' || ch == '\t' || ch == '\n' || ch == '\x0b' || ch == '\x0c' || ch == '\r';
}

fn bool is_hex(char ch) {
    return is_digit(ch) || (ch >= 'a' && ch <= 'f') || (ch >= 'A' && ch <= 'F');
}
