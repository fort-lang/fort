/// Provides string comparison, search, conversion, parsing, and ASCII classification.
import std.libc;
import std.mem;

/// Performs string equality as a function value.
fn equal(string a, string b) bool {
    return a == b;
}

/// Compares unsigned bytes lexicographically and sorts a proper prefix first.
/// Returns -1, 0, or 1.
fn cmp(string a, string b) i32 {
    u64 mut n = a.len;
    if (b.len < n) {
        n = b.len;
    }
    u64 mut i = 0;
    while (i < n) {
        if (a[i] != b[i]) {
            if (a[i] < b[i]) {
                return -1;
            }
            return 1;
        }
        i += 1;
    }
    if (a.len < b.len) {
        return -1;
    }
    if (a.len > b.len) {
        return 1;
    }
    return 0;
}

/// Returns the 64-bit FNV-1a hash. The empty string returns the offset basis.
fn hash(string s) u64 {
    u64 mut h = 0xcbf29ce484222325;
    for (char ch : s) {
        h ^= cast(ch, u64);
        h *%= 0x100000001b3;
    }
    return h;
}

/// Reports whether s starts with prefix. An empty prefix matches.
fn starts_with(string s, string prefix) bool {
    if (prefix.len > s.len) {
        return false;
    }
    return s[..prefix.len] == prefix;
}

/// Reports whether s ends with suffix. An empty suffix matches.
fn ends_with(string s, string suffix) bool {
    if (suffix.len > s.len) {
        return false;
    }
    return s[s.len - suffix.len..] == suffix;
}

/// Returns the first position of ch, or -1 when absent.
fn index_of(string s, char ch) i64 {
    u64 mut i = 0;
    while (i < s.len) {
        if (s[i] == ch) {
            return cast(i, i64);
        }
        i += 1;
    }
    return -1;
}

/// Returns the last position of ch, or -1 when absent.
fn last_index_of(string s, char ch) i64 {
    u64 mut i = s.len;
    while (i > 0) {
        i -= 1;
        if (s[i] == ch) {
            return cast(i, i64);
        }
    }
    return -1;
}

/// Returns the first position of needle, or -1 when absent.
/// An empty needle returns 0.
fn find(string s, string needle) i64 {
    if (needle.len > s.len) {
        return -1;
    }
    u64 mut i = 0;
    while (i + needle.len <= s.len) {
        if (s[i..i + needle.len] == needle) {
            return cast(i, i64);
        }
        i += 1;
    }
    return -1;
}

/// Copies s without a NUL terminator.
/// An empty string produces a zero-length, non-null allocation.
fn dup(string s) string own {
    u8 mut@ own buf = new(u8, s.len);
    mem.copy(buf, cast(s, u8@));
    return cast(move(buf), string own);
}

/// Copies a followed by b without a NUL terminator.
fn concat(string a, string b) string own {
    u8 mut@ own buf = new(u8, a.len + b.len);
    mem.copy(buf[..a.len], cast(a, u8@));
    mem.copy(buf[a.len..], cast(b, u8@));
    return cast(move(buf), string own);
}

/// Copies s and adds a trailing NUL for C.
/// If s contains a NUL, C reads only the prefix.
fn to_cstr(string s) char mut@ own {
    char mut@ own buf = new(char, s.len + 1);
    mem.copy(cast(buf[..s.len], u8 mut@), cast(s, u8@));
    return buf;
}

/// Wraps a C string without copying. A null pointer returns an empty string.
fn from_cstr(char* p) string {
    if (p == null) {
        string zero = {};
        return zero;
    }
    return cast(p[0..libc.strlen(p)], string);
}

/// Parses decimal digits with an optional leading minus sign.
/// Returns false for other syntax or overflow and leaves *out unchanged.
fn parse_i64(string s, i64 mut* out) bool {
    u64 mut i = 0;
    bool mut negative = false;
    if (s.len > 0 && s[0] == '-') {
        negative = true;
        i = 1;
    }
    if (i >= s.len) {
        return false;
    }
    // Keep both sign limits beside the arithmetic that enforces them.
    u64 i64_max = 9223372036854775807;
    u64 i64_min_magnitude = 9223372036854775808;
    u64 mut limit = i64_max;
    if (negative) {
        limit = i64_min_magnitude;
    }
    u64 mut magnitude = 0;
    while (i < s.len) {
        if (!is_digit(s[i])) {
            return false;
        }
        u64 value = cast(digit_value(s[i]), u64);
        // Test the next value without overflowing the multiplication.
        if (magnitude > (limit - value) / 10) {
            return false;
        }
        magnitude = magnitude * 10 + value;
        i += 1;
    }
    if (!negative) {
        *out = cast(magnitude, i64);
        return true;
    }
    if (magnitude == i64_min_magnitude) {
        // A cast produces I64_MIN without computing its invalid negation.
        *out = cast(i64_min_magnitude, i64);
        return true;
    }
    *out = -cast(magnitude, i64);
    return true;
}

/// Parses digits for a base from 2 through 36.
/// Returns false for empty input, invalid digits, invalid bases, or overflow.
/// A failure leaves *out unchanged. The function accepts no sign, prefix, or separator.
fn parse_u64(string s, u64 base, u64 mut* out) bool {
    if (base < 2 || base > 36) {
        return false;
    }
    if (s.len == 0) {
        return false;
    }
    u64 u64_max = 18446744073709551615;
    u64 mut result = 0;
    for (char ch : s) {
        i64 digit = digit_value(ch);
        if (digit < 0) {
            return false;
        }
        u64 value = cast(digit, u64);
        if (value >= base) {
            return false;
        }
        // Test the next value without overflowing the multiplication.
        if (result > (u64_max - value) / base) {
            return false;
        }
        result = result * base + value;
    }
    *out = result;
    return true;
}

/// Returns the base-36 digit value of ch, or -1 for a non-digit.
fn digit_value(char ch) i64 {
    i64 byte = cast(ch, i64);
    if (ch >= '0' && ch <= '9') {
        return byte - cast('0', i64);
    }
    if (ch >= 'a' && ch <= 'z') {
        return byte - cast('a', i64) + 10;
    }
    if (ch >= 'A' && ch <= 'Z') {
        return byte - cast('A', i64) + 10;
    }
    return -1;
}

/// Reports whether ch is an ASCII decimal digit.
fn is_digit(char ch) bool {
    return ch >= '0' && ch <= '9';
}

/// Reports whether ch is an ASCII letter.
fn is_alpha(char ch) bool {
    return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z');
}

fn is_alnum(char ch) bool {
    return is_digit(ch) || is_alpha(ch);
}

/// Reports whether ch is an ASCII whitespace byte.
fn is_space(char ch) bool {
    return ch == ' ' || ch == '\t' || ch == '\n' || ch == '\x0b' || ch == '\x0c' || ch == '\r';
}

fn is_hex(char ch) bool {
    return is_digit(ch) || (ch >= 'a' && ch <= 'f') || (ch >= 'A' && ch <= 'F');
}
