/// Provides IPv4 TCP listeners and connections on Linux x86-64.
/// Network failures return false or -1 and set sys.errno().
/// connect accepts a dotted IPv4 address and does not resolve names.
import std.libc;
import std.str;
import std.sys;

// Linux x86-64 socket and IPv4 constants.
i32 AF_INET = 2;
i32 SOCK_STREAM = 1;
i32 SOL_SOCKET = 1;
i32 SO_REUSEADDR = 2;
u32 INADDR_ANY = 0;

/// Stores an IPv4 family, port, and address in the platform socket layout.
// Matches the Linux x86-64 sockaddr_in layout.
// The byte array keeps the C field's 1-byte alignment.
struct sockaddr_in {
    u16 family;
    u16 port;
    u32 addr;
    u8[8] zero;
}

// Reverses two bytes for network byte order.
fn hton16(u16 v) u16 {
    return ((v & 0x00FF) << 8) | ((v >> 8) & 0x00FF);
}

// Reverses four bytes for network byte order.
fn hton32(u32 v) u32 {
    return ((v & 0x000000FF) << 24) | ((v & 0x0000FF00) << 8)
         | ((v >> 8) & 0x0000FF00) | ((v >> 24) & 0x000000FF);
}

/// Parses exactly four decimal IPv4 fields and writes network byte order.
/// Each field has 1 to 3 digits and a value from 0 through 255.
/// Returns false and leaves *out unchanged for other text.
fn parse_ipv4(string text, u32 mut* out) bool {
    u32 mut host = 0;
    u64 mut start = 0;
    i32 mut field = 0;
    while (field < 4) {
        u64 mut stop = start;
        while (stop < text.len && text[stop] != '.') {
            stop += 1;
        }
        u64 width = stop - start;
        if (width == 0 || width > 3) {
            return false;
        }
        u64 mut value = 0;
        if (!str.parse_u64(text[start..stop], 10, &value)) {
            return false;
        }
        if (value > 255) {
            return false;
        }
        // The first field takes the most significant byte.
        host = host | (cast(value, u32) << (24 - field * 8));
        if (field < 3) {
            if (stop >= text.len) {
                return false;
            }
            start = stop + 1;
        } else if (stop != text.len) {
            return false;
        }
        field += 1;
    }
    *out = hton32(host);
    return true;
}

// Closes fd and restores errno from the failed call.
fn close_and_fail(i32 fd) i32 {
    i32 saved = sys.errno();
    libc.close(fd);
    *libc.__errno_location() = saved;
    return -1;
}

/// Opens a TCP listener on every interface and sets SO_REUSEADDR.
/// Port 0 asks the kernel for an available port.
fn listen(u16 port, i32 backlog) i32 {
    i32 fd = libc.socket(AF_INET, SOCK_STREAM, 0);
    if (fd < 0) {
        return -1;
    }
    i32 mut on = 1;
    u32 on_len = cast(sizeof(i32), u32);
    if (libc.setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, cast(&on, void*), on_len) < 0) {
        return close_and_fail(fd);
    }
    sockaddr_in mut addr = {};
    addr.family = cast(AF_INET, u16);
    addr.port = hton16(port);
    addr.addr = hton32(INADDR_ANY);
    if (libc.bind(fd, cast(&addr, void*), cast(sizeof(sockaddr_in), u32)) < 0) {
        return close_and_fail(fd);
    }
    if (libc.listen(fd, backlog) < 0) {
        return close_and_fail(fd);
    }
    return fd;
}

/// Accepts one connection without returning its peer address.
fn accept(i32 fd) i32 {
    i32 client = libc.accept(fd, null, null);
    if (client < 0) {
        return -1;
    }
    return client;
}

/// Connects to a dotted IPv4 address and port.
/// Invalid address text sets EINVAL without a system call.
fn connect(string host_ipv4, u16 port) i32 {
    u32 mut host = 0;
    if (!parse_ipv4(host_ipv4, &host)) {
        *libc.__errno_location() = libc.EINVAL;
        return -1;
    }
    i32 fd = libc.socket(AF_INET, SOCK_STREAM, 0);
    if (fd < 0) {
        return -1;
    }
    sockaddr_in mut addr = {};
    addr.family = cast(AF_INET, u16);
    addr.port = hton16(port);
    addr.addr = host;
    if (libc.connect(fd, cast(&addr, void*), cast(sizeof(sockaddr_in), u32)) < 0) {
        return close_and_fail(fd);
    }
    return fd;
}

/// Reports the bound port in host byte order.
/// A failure returns false and leaves *out unchanged.
fn local_port(i32 fd, u16 mut* out) bool {
    sockaddr_in mut addr = {};
    u32 mut len = cast(sizeof(sockaddr_in), u32);
    if (libc.getsockname(fd, cast(&addr, void mut*), &len) < 0) {
        return false;
    }
    *out = hton16(addr.port);
    return true;
}
