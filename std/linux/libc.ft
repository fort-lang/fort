/// Declares the libc functions that the standard library uses on Linux x86-64.
/// Names use C linkage.
// The `//` lines directly above each declaration are its row (D9.8): the C function, the source
// of its contract, and the five points of A7 of spec/ownership-design.md 5.1.

// open(2) flags, Linux x86-64 values.
i32 O_RDONLY = 0;
i32 O_WRONLY = 1;
i32 O_RDWR = 2;
i32 O_CREAT = 0o100;
i32 O_TRUNC = 0o1000;
i32 O_APPEND = 0o2000;

// lseek(2) whence values.
i32 SEEK_SET = 0;
i32 SEEK_CUR = 1;
i32 SEEK_END = 2;

// errno values the library tests for.
i32 ENOENT = 2;
i32 EINTR = 4;
i32 EACCES = 13;
i32 EINVAL = 22;
i32 ENOTSOCK = 88;
i32 ECONNREFUSED = 111;

// C: malloc, ISO C11 7.22.3.4 and 7.22.3, malloc(3).
// gives: null, or a new allocation of `size` bytes, aligned for each type of a fundamental
// alignment, that only free frees (`own`, A2). writes: no fort storage. keeps: no pointer.
// calls: no fort function. frees: nothing.
extern fn malloc(u64 size) void mut* own;
/// Allocates zeroed storage for n elements of size bytes.
// C: calloc, ISO C11 7.22.3.2 and 7.22.3, calloc(3).
// gives: null, also when n * size does not fit a size_t, or a new allocation of n * size zero
// bytes, aligned for each type of a fundamental alignment, that only free frees (`own`, A2).
// writes: no fort storage. keeps: no pointer. calls: no fort function. frees: nothing.
extern fn calloc(u64 n, u64 size) void mut* own;
// C: free, ISO C11 7.22.3.3, free(3).
// frees: p, an allocation that malloc or calloc gave, which the `own` moves to C; nothing for
// null. gives: no pointer. writes: no storage that fort code still holds. keeps: no pointer.
// calls: no fort function.
extern fn free(void* own p) void;

// mmap(2) and mprotect(2) protections and mmap(2) flags, Linux x86-64 values.
i32 PROT_NONE = 0;
i32 PROT_READ = 1;
i32 PROT_WRITE = 2;
i32 MAP_PRIVATE = 2;
i32 MAP_ANON = 0x20;
// The madvise(2) advice after which the system holds no page for a range: MADV_DONTNEED.
i32 MADV_DISCARD = 4;

// The count of 8-byte words of one map_range: 2^29 words are 2^32 bytes.
u64 MAP_RANGE_WORDS = 536870912;

// The first 2^32 bytes of a mapping that mmap gives, as words. No caller of mmap maps fewer
// bytes, so the whole map_range lies inside each mapping.
struct map_range {
    u64[MAP_RANGE_WORDS] words;
}

// C: mmap, mmap(2) of POSIX.1-2017 and mmap(2) of Linux.
// gives: the address -1 (MAP_FAILED) and no object, or the start of a new mapping of len bytes
// at a multiple of the page size, which holds zero bytes where prot lets a read through; the
// call row says why len is the 2^32 bytes of the result type or more, and that the function
// tests the result against MAP_FAILED before another use. The mapping stays until a munmap of
// it. With MAP_FIXED in flags, C replaces each mapping in the range at addr, so the call row
// says why that range holds no dead storage (D10.9 rule 6). writes: no fort storage.
// keeps: no pointer. calls: no fort function. frees: nothing.
extern fn mmap(void* addr, u64 len, i32 prot, i32 flags, i32 fd, i64 offset) map_range mut*;
// C: munmap, munmap(2) of POSIX.1-2017.
// frees: each mapping in the len bytes at addr, so a later mapping can take that range; the
// call row says why the range holds no dead storage and no live object (D10.9 rule 6).
// gives: 0, or -1 with errno, and no pointer. writes: no storage. keeps: no pointer.
// calls: no fort function.
extern fn munmap(void* addr, u64 len) i32;
// C: mprotect, mprotect(2) of POSIX.1-2017.
// writes: no byte; C sets the access of the pages of the len bytes at addr to prot, so a later
// access there can stop with a memory fault, and the call row says why the range holds no dead
// storage, or that the runtime gives dead storage back (D10.9 rule 6). gives: 0, or -1 with
// errno, and no pointer. keeps: no pointer. calls: no fort function. frees: nothing.
extern fn mprotect(void* addr, u64 len, i32 prot) i32;
// C: madvise, madvise(2) of Linux.
// writes: no byte through a pointer of fort code; with MADV_DISCARD the system drops the pages
// of the len bytes at addr, so the call row says why no later read of the range gives a
// changed byte (D10.9 rule 2). gives: 0, or -1 with errno, and no pointer. keeps: no pointer.
// calls: no fort function. frees: nothing: the mapping stays.
extern fn madvise(void* addr, u64 len, i32 advice) i32;

// C: memcpy, ISO C11 7.24.2.1, memcpy(3).
// writes: n bytes at dst, from the n bytes at src; the two must not overlap, so the call row
// says why they do not. gives: no pointer: C gives back dst, and the `void` result keeps it out
// of fort code, as for the `.ptr` of an empty span it names the byte after the span (D3.5).
// keeps: no pointer. calls: no fort function. frees: nothing.
extern fn memcpy(u8 mut* dst, u8* src, u64 n) void;
// C: memmove, ISO C11 7.24.2.2, memmove(3).
// writes: n bytes at dst, from the n bytes at src, which can overlap them. gives: no pointer:
// the `void` result drops dst, as for memcpy. keeps: no pointer. calls: no fort function.
// frees: nothing.
extern fn memmove(u8 mut* dst, u8* src, u64 n) void;
// C: memcmp, ISO C11 7.24.4.1, memcmp(3).
// writes: nothing; C reads n bytes at a and n bytes at b. gives: an i32 and no pointer.
// keeps: no pointer. calls: no fort function. frees: nothing.
extern fn memcmp(u8* a, u8* b, u64 n) i32;
// C: memset, ISO C11 7.24.6.1, memset(3).
// writes: n bytes at dst, each the low byte of v. gives: no pointer: the `void` result drops
// dst, as for memcpy. keeps: no pointer. calls: no fort function. frees: nothing.
extern fn memset(u8 mut* dst, i32 v, u64 n) void;
// C: strlen, ISO C11 7.24.6.3, strlen(3).
// writes: nothing; C reads s to its NUL, which the call row finds in the storage of s.
// gives: the count of bytes before the NUL. keeps: no pointer. calls: no fort function.
// frees: nothing.
extern fn strlen(char* s) u64;
// C: getenv, ISO C11 7.22.4.6, getenv(3) of POSIX.1-2017.
// gives: null, or a C string with its NUL in the environment, storage of C that a later getenv,
// setenv or unsetenv can change or free; no `mut`, because fort code must not write it.
// writes: nothing; C reads name to its NUL. keeps: no pointer. calls: no fort function.
// frees: nothing.
extern fn getenv(char* name) char*;
// C: exit, ISO C11 7.22.4.4, exit(3).
// calls: each function that atexit(3) registered, which no module of std does, and then C
// flushes its streams and ends the process. gives: no return. writes: no fort storage.
// keeps: no pointer. frees: no fort allocation before the process ends.
extern fn exit(i32 code) noreturn;
// C: abort, ISO C11 7.22.4.1, abort(3).
// calls: a handler of SIGABRT that an earlier call of C keeps, which no module of std sets; then
// C ends the process with SIGABRT. gives: no return. writes: no fort storage. keeps: no
// pointer. frees: nothing.
extern fn abort() noreturn;

// C: open, open(2) of POSIX.1-2017.
// writes: nothing; C reads path to its NUL, and the variable tail is the mode, a promoted int
// that C reads when flags hold O_CREAT or O_TMPFILE. gives: a descriptor or -1. keeps: no pointer.
// calls: no fort function. frees: nothing.
extern fn open(char* path, i32 flags, ...) i32;
// C: read, read(2) of POSIX.1-2017.
// writes: at most n bytes at buf. gives: the count of bytes, 0 at the end of the file, or -1.
// keeps: no pointer. calls: no fort function. frees: nothing.
extern fn read(i32 fd, u8 mut* buf, u64 n) i64;
// C: write, write(2) of POSIX.1-2017.
// writes: nothing in fort storage; C reads at most n bytes at buf. gives: the count of bytes, or
// -1. keeps: no pointer. calls: no fort function. frees: nothing.
extern fn write(i32 fd, u8* buf, u64 n) i64;
// C: close, close(2) of POSIX.1-2017.
// gives: 0 or -1. writes: no fort storage. keeps: no pointer. calls: no fort function.
// frees: no storage; C closes the descriptor.
extern fn close(i32 fd) i32;
// C: lseek, lseek(2) of POSIX.1-2017.
// gives: the new offset or -1. writes: no fort storage. keeps: no pointer.
// calls: no fort function. frees: nothing.
extern fn lseek(i32 fd, i64 offset, i32 whence) i64;
// C: isatty, isatty(3) of POSIX.1-2017.
// gives: 1, or 0 with errno set. writes: no fort storage. keeps: no pointer.
// calls: no fort function. frees: nothing.
extern fn isatty(i32 fd) i32;

// glibc and musl implement errno through this accessor.
// C: __errno_location, glibc, the interface __errno_location of LSB Core 5.0.
// gives: the address of the errno of the calling thread, an int of storage of C for the life of
// the thread, which fort code reads and writes. writes: no fort storage. keeps: no pointer.
// calls: no fort function. frees: nothing.
extern fn __errno_location() i32 mut*;

// Returns the errno slot for internal standard-library calls.
// C call __errno_location: no pointer argument.
fn errno_slot() i32 mut* {
    return __errno_location();
}

// The float formatting arguments pass through a variadic call.
// C: snprintf, ISO C11 7.21.6.5 and 7.21.6.1, snprintf(3).
// writes: at most size bytes at buf, the last of them a NUL, and none for a size of 0; C reads
// fmt to its NUL and reads the variable tail as fmt says, so the call row gives fmt and the
// types of the tail. gives: the length of the whole text, or a value below 0.
// keeps: no pointer. calls: no fort function. frees: nothing.
extern fn snprintf(char mut* buf, u64 size, char* fmt, ...) i32;

// C call snprintf: buf, size and fmt are parameter sources (D9.8 rule 1), so the function is a
// boundary function: each caller gives a size that fits the bound of buf, fmt with its NUL, and
// a fmt such as `%.*e` that reads one int and one double, the precision and v of the tail.
fn snprintf_float(char mut* buf, u64 size, char* fmt, i32 precision, f64 v) i32 {
    return snprintf(buf, size, fmt, precision, v);
}

// Linux uses u32 for socklen_t. Socket addresses cross C as pointers.
// C: socket, socket(2) of POSIX.1-2017.
// gives: a descriptor or -1. writes: no fort storage. keeps: no pointer.
// calls: no fort function. frees: nothing.
extern fn socket(i32 domain, i32 kind, i32 protocol) i32;
// C: setsockopt, setsockopt(2) of POSIX.1-2017.
// writes: nothing in fort storage; C reads len bytes at value. gives: 0 or -1.
// keeps: no pointer. calls: no fort function. frees: nothing.
extern fn setsockopt(i32 fd, i32 level, i32 name, void* value, u32 len) i32;
// C: bind, bind(2) of POSIX.1-2017.
// writes: nothing in fort storage; C reads len bytes at addr. gives: 0 or -1.
// keeps: no pointer. calls: no fort function. frees: nothing.
extern fn bind(i32 fd, void* addr, u32 len) i32;
// C: listen, listen(2) of POSIX.1-2017.
// gives: 0 or -1. writes: no fort storage. keeps: no pointer. calls: no fort function.
// frees: nothing.
extern fn listen(i32 fd, i32 backlog) i32;
// C: accept, accept(2) of POSIX.1-2017.
// writes: nothing when addr and len are null; else C reads *len, writes at most *len bytes at
// addr and then the length of the address at len. gives: a descriptor or -1.
// keeps: no pointer. calls: no fort function. frees: nothing.
extern fn accept(i32 fd, void mut* addr, u32 mut* len) i32;
// C: connect, connect(2) of POSIX.1-2017.
// writes: nothing in fort storage; C reads len bytes at addr. gives: 0 or -1.
// keeps: no pointer. calls: no fort function. frees: nothing.
extern fn connect(i32 fd, void* addr, u32 len) i32;
// C: getsockname, getsockname(2) of POSIX.1-2017.
// writes: C reads *len, writes at most *len bytes at addr and then the length of the address at
// len. gives: 0 or -1. keeps: no pointer. calls: no fort function. frees: nothing.
extern fn getsockname(i32 fd, void mut* addr, u32 mut* len) i32;

// fcntl(2), readlink(2) and realpath(3). fcntl takes a variable tail in C, and this declaration
// keeps it on both targets (D9.8).
// C: fcntl, fcntl(2) of POSIX.1-2017.
// writes: no fort storage for F_SETFD, the one command of std, whose tail is one int; a command
// whose tail is a pointer needs a call row for that storage. gives: an int, or -1.
// keeps: no pointer. calls: no fort function. frees: nothing.
extern fn fcntl(i32 fd, i32 cmd, ...) i32;
// C: readlink, readlink(2) of POSIX.1-2017.
// writes: at most size bytes at buf, with no NUL; C reads path to its NUL. gives: the count of
// bytes, or -1. keeps: no pointer. calls: no fort function. frees: nothing.
extern fn readlink(char* path, char mut* buf, u64 size) i64;
// Pass a buffer of PATH_MAX bytes as `resolved`. The result is that buffer, or null with errno set.
// A null buffer makes C allocate a result that fort cannot free, so use `os.real_path` instead.
// C: realpath, realpath(3) of POSIX.1-2017 and of glibc.
// writes: at most PATH_MAX bytes at resolved, the path and its NUL; C reads path to its NUL.
// gives: resolved, with no `mut` that the argument lacked, or null. keeps: no pointer.
// calls: no fort function. frees: nothing; a null resolved makes C allocate, and std passes none.
extern fn realpath(char* path, char mut* resolved) char*;

// <dirent.h>: a directory stream is an allocation of C that closedir(3) frees, so the stream
// that opendir(3) and fdopendir(3) give says `own`, and closedir takes it with `move`. `dirent`
// is the x86-64 glibc layout of `struct dirent`, and `dirent_head` holds its fields before
// `name`. A record of readdir(3) holds `reclen` bytes, and the name ends in it, so a short record
// does not hold the whole `name` array: readdir gives a `dirent_head*` with no `mut`, a view of
// storage of C that the next readdir of the stream can change, and null at the end of the stream
// and on an error (D9.8, D17.13). `os.list_dir` checks `reclen` against the size of a `dirent`,
// copies `reclen` bytes into a local `dirent`, and reads the name there.
struct dirent {
    u64 ino;
    i64 off;
    u16 reclen;
    u8 kind;
    char[256] name;
}
struct dirent_head {
    u64 ino;
    i64 off;
    u16 reclen;
    u8 kind;
}
// C: opendir, opendir(3) of POSIX.1-2017.
// gives: null, or a new directory stream, storage of C that only closedir frees (`own`).
// writes: nothing; C reads path to its NUL. keeps: no pointer. calls: no fort function.
// frees: nothing.
extern fn opendir(char* path) void mut* own;
// C: readdir, readdir(3) of POSIX.1-2017 and of glibc.
// gives: null at the end of the stream and on an error, or a record of `reclen` bytes in storage
// of C, which the next readdir or closedir of dir can change or free. The kernel rounds a record
// up to 8 bytes after the NUL of its name, so it holds the 24 bytes of `dirent_head`. No `mut`.
// writes: the stream, storage of C, and errno. keeps: no pointer. calls: no fort function.
// frees: nothing.
extern fn readdir(void mut* dir) dirent_head*;
// C: closedir, closedir(3) of POSIX.1-2017.
// frees: the stream dir, which opendir or fdopendir gave (`own`), and C closes its descriptor.
// gives: 0 or -1. writes: no fort storage. keeps: no pointer. calls: no fort function.
extern fn closedir(void mut* own dir) i32;

// The `kind` values of a directory entry. A file system that does not record the kind gives
// DT_UNKNOWN.
u8 DT_UNKNOWN = 0;
u8 DT_DIR = 4;
u8 DT_REG = 8;
u8 DT_LNK = 10;

// The errno value of opendir(3) on a file that is no directory.
i32 ENOTDIR = 20;

// The size of the buffer that realpath(3) writes, the terminating zero included.
u64 PATH_MAX = 4096;

// The errno value a mkdir(2) of a directory that exists reports.
i32 EEXIST = 17;

// The mode bit access(2) is asked about: readable.
i32 R_OK = 4;

// The errno value of a result that does not fit: strtod(3) and strtof(3) out of range, and
// getcwd(2) with a buffer too small for the path. It is 34 on both targets.
i32 ERANGE = 34;

// The command of fcntl(2) that sets the descriptor flags, and the flag that closes the
// descriptor at an exec. The values are the same on both targets.
i32 F_SETFD = 2;
i32 FD_CLOEXEC = 1;

// <string.h>, <stdlib.h>: the error text of an errno value, the C float parsers, a
// temporary directory (mkdtemp replaces the six X of its argument in place), and
// the environment of the process. A float parser stores a `char*` into `*end`, so `end`
// marks that level `mut` and the `char*` it holds marks none (D17.13).

// C: strerror, ISO C11 7.24.6.2, strerror(3).
// gives: a C string with its NUL in storage of C, which a later strerror can change; no `mut`,
// because fort code must not write it. writes: no fort storage. keeps: no pointer.
// calls: no fort function. frees: nothing.
extern fn strerror(i32 code) char*;
// C: strtod, ISO C11 7.22.1.3, strtod(3).
// writes: C reads s to its NUL; with end not null, it writes at end a pointer into s, storage
// that fort code gave in the same call, with no `mut`; it sets errno to ERANGE when the value
// does not fit. gives: the value. keeps: no pointer. calls: no fort function. frees: nothing.
extern fn strtod(char* s, char* mut* end) f64;
// C: strtof, ISO C11 7.22.1.3, strtof(3).
// writes: as strtod: C reads s to its NUL and writes at end, when not null, a pointer into s.
// gives: the value. keeps: no pointer. calls: no fort function. frees: nothing.
extern fn strtof(char* s, char* mut* end) f32;
// C: mkdtemp, mkdtemp(3) of POSIX.1-2017 and of glibc.
// writes: C reads tmpl to its NUL and writes its last six bytes, which must be XXXXXX, else
// glibc gives EINVAL. gives: tmpl, with no `mut` that the argument lacked, or null.
// keeps: no pointer. calls: no fort function. frees: nothing.
extern fn mkdtemp(char mut* tmpl) char*;
// C: setenv, setenv(3) of POSIX.1-2017 and of glibc.
// writes: nothing in fort storage; C reads name and value to their NULs. keeps: no pointer: C
// copies both strings (glibc setenv(3)). gives: 0 or -1. calls: no fort function.
// frees: no fort allocation; C can change or free a string of the environment that getenv gave.
extern fn setenv(char* name, char* value, i32 overwrite) i32;
// C: unsetenv, unsetenv(3) of POSIX.1-2017.
// writes: nothing in fort storage; C reads name to its NUL. gives: 0 or -1. keeps: no pointer.
// calls: no fort function. frees: no fort allocation; C can free the string that it removes.
extern fn unsetenv(char* name) i32;

// <unistd.h>, <sys/stat.h>, <sys/wait.h>: files, directories, descriptors and
// child processes. `mode_t` crosses as u32 on both targets: a Mac's u16 fills the
// same register, and one signature serves both roots (D9.8).

// C: access, access(2) of POSIX.1-2017.
// writes: nothing; C reads path to its NUL. gives: 0 or -1. keeps: no pointer.
// calls: no fort function. frees: nothing.
extern fn access(char* path, i32 mode) i32;
// C: getcwd, getcwd(3) of POSIX.1-2017 and of glibc.
// writes: at most size bytes at buf, the path and its NUL; ERANGE when size is too small.
// gives: buf, with the `mut` that the argument has, or null. keeps: no pointer.
// calls: no fort function. frees: nothing; a null buf makes glibc allocate, and std passes none.
extern fn getcwd(char mut* buf, u64 size) char mut*;
// C: unlink, unlink(2) of POSIX.1-2017.
// writes: nothing; C reads path to its NUL. gives: 0 or -1. keeps: no pointer.
// calls: no fort function. frees: nothing.
extern fn unlink(char* path) i32;
// rename(2) gives the file at old_path the name new_path. It replaces a file at new_path in
// one atomic step, so a reader sees the old file or the new file. Both paths must be on one
// file system.
// C: rename, ISO C11 7.21.4.2, rename(2) of POSIX.1-2017.
// writes: nothing; C reads old_path and new_path to their NULs. gives: 0 or -1.
// keeps: no pointer. calls: no fort function. frees: nothing.
extern fn rename(char* old_path, char* new_path) i32;
// C: rmdir, rmdir(2) of POSIX.1-2017.
// writes: nothing; C reads path to its NUL. gives: 0 or -1. keeps: no pointer.
// calls: no fort function. frees: nothing.
extern fn rmdir(char* path) i32;
// C: symlink, symlink(2) of POSIX.1-2017.
// writes: nothing; C reads target and link_path to their NULs. gives: 0 or -1.
// keeps: no pointer. calls: no fort function. frees: nothing.
extern fn symlink(char* target, char* link_path) i32;
// C: mkdir, mkdir(2) of POSIX.1-2017.
// writes: nothing; C reads path to its NUL. gives: 0 or -1. keeps: no pointer.
// calls: no fort function. frees: nothing.
extern fn mkdir(char* path, u32 mode) i32;
// C: chmod, chmod(2) of POSIX.1-2017.
// writes: nothing; C reads path to its NUL. gives: 0 or -1. keeps: no pointer.
// calls: no fort function. frees: nothing.
extern fn chmod(char* path, u32 mode) i32;
// C: dup, dup(2) of POSIX.1-2017.
// gives: a descriptor or -1. writes: no fort storage. keeps: no pointer.
// calls: no fort function. frees: nothing.
extern fn dup(i32 fd) i32;
// C: dup2, dup2(2) of POSIX.1-2017.
// gives: new_fd or -1. writes: no fort storage. keeps: no pointer. calls: no fort function.
// frees: no storage; C closes the file that new_fd named.
extern fn dup2(i32 old_fd, i32 new_fd) i32;
// C: pipe, pipe(2) of POSIX.1-2017.
// writes: two ints at fds, the read end and then the write end. gives: 0 or -1.
// keeps: no pointer. calls: no fort function. frees: nothing.
extern fn pipe(i32 mut* fds) i32;
// C: fork, fork(2) of POSIX.1-2017.
// gives: the id of the child, 0 in the child, or -1. The child runs on in fort code with a copy
// of the storage of the process. writes: no fort storage. keeps: no pointer.
// calls: no fort function. frees: nothing.
extern fn fork() i32;
// C: execvp, execvp(3) of POSIX.1-2017.
// writes: nothing; C reads file to its NUL, and argv as an array of `char*` that a null pointer
// ends, each item to its NUL. gives: -1 when it fails; a success ends the image of the process
// and does not return. keeps: no pointer. calls: no fort function. frees: nothing.
extern fn execvp(char* file, void* argv) i32;
// C: waitpid, waitpid(2) of POSIX.1-2017.
// writes: one int at status when status is not null. gives: the id of the child, 0, or -1.
// keeps: no pointer. calls: no fort function. frees: nothing.
extern fn waitpid(i32 pid, i32 mut* status, i32 options) i32;
// C: _exit, _exit(2) of POSIX.1-2017.
// calls: no fort function: _exit calls no function that atexit(3) registered and flushes no
// stream. gives: no return. writes: no fort storage. keeps: no pointer. frees: no fort
// allocation before the process ends.
extern fn _exit(i32 status) noreturn;
// raise(3) sends the signal `sig` to the calling thread. It returns 0, or not 0 for a
// signal number that the system does not have.
// C: raise, ISO C11 7.14.2.1, raise(3).
// calls: a handler of sig that an earlier call of C keeps, which no module of std sets.
// gives: 0, or not 0. writes: no fort storage. keeps: no pointer. frees: nothing.
extern fn raise(i32 sig) i32;
// getpid(2): the id of this process, which names the temporary files of a library artifact.
// C: getpid, getpid(2) of POSIX.1-2017.
// gives: the id of the process. writes: no fort storage. keeps: no pointer.
// calls: no fort function. frees: nothing.
extern fn getpid() i32;
// <fcntl.h>: the flags of open(2) that the artifact writer adds, Linux x86-64 values: create a
// new file only, refuse a symbolic link, and open a directory only.
i32 O_EXCL = 0o200;
i32 O_NOFOLLOW = 0o400000;
i32 O_DIRECTORY = 0o200000;
// The errno value (Linux x86-64) of a symbolic link that open(2) with O_NOFOLLOW refuses.
// Linux gives ENOTDIR in its place when O_DIRECTORY is set as well.
i32 ELOOP = 40;
// unlinkat(2) removes an entry of the directory that a descriptor names, and with
// AT_REMOVEDIR (the Linux x86-64 value) an empty directory; fdopendir(3) reads the
// entries of that directory.
i32 AT_REMOVEDIR = 0x200;
// C: unlinkat, unlinkat(2) of POSIX.1-2017.
// writes: nothing; C reads path to its NUL. gives: 0 or -1. keeps: no pointer.
// calls: no fort function. frees: nothing.
extern fn unlinkat(i32 dir_fd, char* path, i32 flags) i32;
// C: fdopendir, fdopendir(3) of POSIX.1-2017.
// gives: null, or a new directory stream on fd, storage of C that only closedir frees (`own`);
// the stream takes fd, and closedir closes it. writes: no fort storage. keeps: no pointer.
// calls: no fort function. frees: nothing.
extern fn fdopendir(i32 fd) void mut* own;
// umask(2) sets the file mode creation mask of the process and gives the mask before it.
// mkfifo(3) makes a FIFO at `path`. `mode_t` is u32 on Linux x86-64.
// C: umask, umask(2) of POSIX.1-2017.
// gives: the mask before the call; umask does not fail. writes: no fort storage.
// keeps: no pointer. calls: no fort function. frees: nothing.
extern fn umask(u32 mask) u32;
// C: mkfifo, mkfifo(3) of POSIX.1-2017.
// writes: nothing; C reads path to its NUL. gives: 0 or -1. keeps: no pointer.
// calls: no fort function. frees: nothing.
extern fn mkfifo(char* path, u32 mode) i32;
