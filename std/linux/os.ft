/// Gives the target of this standard library and the path of the running binary on Linux x86-64.
/// It also gives the canonical form of a path.

import std.libc;
import std.str;
import std.strbuf;

// The target triple of this standard library. A compiler built with it uses this target when
// --target is absent (D14.1).
string TARGET = "x86_64-linux-gnu";

// The symbolic link that names the running binary.
string PROC_SELF_EXE = "/proc/self/exe";

// The buffer sizes the path is read with.
u64 EXE_PATH_FIRST_CAP = 256;
u64 EXE_PATH_MAX_CAP = 65536;

// Appends the path of the running binary to `out` and returns true. Returns false and leaves
// `out` unchanged when the system cannot give the path.
// C call libc.readlink: c_path.ptr keeps the bound of the str.to_cstr buffer c_path (D9.8 rule
// 2), and its last byte is the NUL (rule 4). buf.ptr keeps the bound of buf, cap bytes (rule 2),
// and the length cap fits it.
fn exe_path(strbuf.str_buf mut* out) bool {
    char mut@ own c_path = str.to_cstr(PROC_SELF_EXE);
    defer del(c_path);
    u64 mut cap = EXE_PATH_FIRST_CAP;
    while (cap <= EXE_PATH_MAX_CAP) {
        char mut@ own buf = new(char, cap);
        defer del(buf);
        i64 len = libc.readlink(c_path.ptr, buf.ptr, cap);
        if (len < 0) {
            return false;
        }
        if (cast(len, u64) < cap) {
            strbuf.append(out, cast(buf[0..cast(len, u64)], string));
            return true;
        }
        cap = cap * 2;
    }
    return false;
}

/// Appends the canonical form of path to out. Returns false when realpath(3) fails.
// C call libc.realpath: &c_path[0] keeps the bound of the str.to_cstr buffer c_path (D9.8 rule
// 2), and its last byte is the NUL (rule 4). &buf[0] keeps the bound of buf, libc.PATH_MAX
// bytes (rule 2), which C does not pass.
fn real_path(string path, strbuf.str_buf mut* out) bool {
    char mut@ own c_path = str.to_cstr(path);
    defer del(c_path);
    char mut@ own buf = new(char, libc.PATH_MAX);
    defer del(buf);
    if (libc.realpath(&c_path[0], &buf[0]) == null) {
        return false;
    }
    strbuf.append(out, str.from_cbuf(cast(buf[..], u8@)));
    return true;
}

// O_NONBLOCK of open(2) (Linux x86-64): an open of a FIFO returns at once.
i32 O_NONBLOCK = 0o4000;

// fstat(2) writes `struct stat` into `buf`. std.os declares it and std.libc does not, so only a
// program that imports std.os binds the symbol (D9.8). A buffer of words and not a struct: a
// struct would give the symbol a type that a program cannot write again.
// C: fstat, fstat(2) of POSIX.1-2017.
// writes: one `struct stat` at buf, 144 bytes, STAT_WORDS words of 8 bytes, on Linux x86-64 and
// on macOS arm64. gives: 0 or -1. keeps: no pointer. calls: no fort function. frees: nothing.
extern fn fstat(i32 fd, u64 mut* buf) i32;

// stat(2) writes the `struct stat` of the file that `path` names, after each symbolic link, into
// `buf`. std.os declares it for the reason of fstat.
// C: stat, stat(2) of POSIX.1-2017.
// writes: one `struct stat` at buf, 144 bytes, as fstat; C reads path to its NUL. gives: 0 or
// -1. keeps: no pointer. calls: no fort function. frees: nothing.
extern fn stat(char* path, u64 mut* buf) i32;

// `struct stat` is STAT_WORDS 8-byte words with the alignment of C on both targets. MODE_BITS
// takes the type bits and the permission bits of its `st_mode`.
u64 STAT_WORDS = 18;
u64 MODE_BITS = 0xFFFF;

// `st_mode` (Linux x86-64) is a u32 at byte 24, the low half of word 3.
u64 STAT_MODE_WORD = 3;
u64 STAT_MODE_SHIFT = 0;

/// Opens `path` to read and returns the descriptor, or -1 with the reason in sys.errno(). The
/// open does not wait for the writer of a FIFO.
// C call libc.open: c_path.ptr keeps the bound of the str.to_cstr buffer c_path, path.len + 1
// bytes (D9.8 rule 2), and its last byte is the NUL (rule 4).
fn open_nonblocking(string path) i32 {
    char mut@ own c_path = str.to_cstr(path);
    defer del(c_path);
    return libc.open(c_path.ptr, libc.O_RDONLY | O_NONBLOCK, 0);
}

/// Writes the type bits and the permission bits of the file that `fd` names, the low 16 bits of
/// its `st_mode`, to `*mode`. Returns false with the reason in sys.errno() when fstat(2) fails.
// C call fstat: &st[0] keeps the bound of st, STAT_WORDS words, 144 bytes (D9.8 rule 2), which
// one `struct stat` fills.
fn file_mode(i32 fd, u32 mut* mode) bool {
    u64[STAT_WORDS] mut st = {};
    if (fstat(fd, &st[0]) != 0) {
        return false;
    }
    *mode = cast((st[STAT_MODE_WORD] >> STAT_MODE_SHIFT) & MODE_BITS, u32);
    return true;
}

/// Writes the type bits and the permission bits of the file that `path` names, after each
/// symbolic link, the low 16 bits of its `st_mode`, to `*mode`. It opens nothing, so a FIFO and a
/// file that the process cannot read give their mode too. Returns false with the reason in
/// sys.errno() when stat(2) fails.
// C call stat: c_path.ptr keeps the bound of the str.to_cstr buffer c_path, path.len + 1
// bytes (D9.8 rule 2), and its last byte is the NUL (rule 4).
// &st[0] keeps the bound of st, 144 bytes (rule 2), which one `struct stat` fills.
fn path_mode(string path, u32 mut* mode) bool {
    char mut@ own c_path = str.to_cstr(path);
    defer del(c_path);
    u64[STAT_WORDS] mut st = {};
    if (stat(c_path.ptr, &st[0]) != 0) {
        return false;
    }
    *mode = cast((st[STAT_MODE_WORD] >> STAT_MODE_SHIFT) & MODE_BITS, u32);
    return true;
}

/// Makes a FIFO at `path` with mkfifo(3) and the permission bits `mode`, less the umask. Returns
/// false and sets errno when mkfifo fails: EEXIST when an entry stands at `path`. A `mode` with a
/// bit outside PERMISSION_BITS, or with a bit of SET_ID_BITS, makes nothing and gives EINVAL on
/// both targets: the two C libraries read a type bit in different ways, and the Darwin kernel
/// refuses S_ISGID with EPERM in a directory whose group is no group of the process. A success
/// keeps errno.
// C call libc.mkfifo: c_path.ptr keeps the bound of the str.to_cstr buffer c_path, path.len + 1
// bytes (D9.8 rule 2), and its last byte is the NUL (rule 4).
fn make_fifo(string path, u32 mode) bool {
    if ((mode & ~PERMISSION_BITS) != 0 || (mode & SET_ID_BITS) != 0) {
        libc.set_errno(libc.EINVAL);
        return false;
    }
    char mut@ own c_path = str.to_cstr(path);
    defer del(c_path);
    return libc.mkfifo(c_path.ptr, mode) == 0;
}

/// Sets the file mode creation mask of the process to the bits of `mask` in UMASK_BITS with
/// umask(2), and returns the bits in UMASK_BITS of the mask that was there before. umask does not
/// fail and does not change errno. The other bits do not count, on both targets: Linux keeps only
/// these bits, and Darwin keeps the bits 0o7777, also of a mask that the parent process set.
// C call libc.umask: no pointer argument.
fn set_umask(u32 mask) u32 {
    return libc.umask(mask & UMASK_BITS) & UMASK_BITS;
}

// ---- the file system and the error text, the same on both targets ----

// The first size and the largest size of the buffers that current_dir and read_link read a path
// into. A path of the file system is shorter than the first size most of the time.
u64 PATH_FIRST_CAP = 256;
u64 PATH_LAST_CAP = 65536;

// The type bits of `st_mode` and the type of a directory, the POSIX values of both targets.
u32 S_IFMT = 0o170000;
u32 S_IFDIR = 0o040000;

// The permission bits of a mode, its S_ISUID and S_ISGID bits, which make_fifo and set_mode
// refuse, and the bits of a file mode creation mask that set_umask keeps.
u32 PERMISSION_BITS = 0o7777;
u32 SET_ID_BITS = 0o6000;
u32 UMASK_BITS = 0o777;

/// Appends the text of the errno value `code`, from strerror(3), to `out`: "No such file or
/// directory" for ENOENT. An unknown value gives a text that names it. The C library can change
/// or free the storage of the text at the next call of strerror(3), so the function copies the
/// text into `out` before it returns, and no later call changes the copy. errno stays as it was:
/// the Darwin strerror(3) sets EINVAL for an unknown value, and the function puts the old value
/// back.
// C call libc.strerror: no pointer argument.
// C call str.from_cstr: the result of strerror in this call, storage that C gave (D9.8 rule 3),
// a C string with the NUL that the row of strerror states.
// gives: in *out a copy of the text in storage of `new`, and no view of the storage of strerror.
// That storage is storage of C, which a later call of strerror can change or release. The view
// of it goes to str.from_cstr and to strbuf.append only, and it ends with the call of
// strbuf.append. The calls of C between strerror and that end are strlen, calloc, memmove, free
// of a buffer of `new`, and the calls of a panic, which ends the process: none of them is a
// call of strerror (D9.8, "Storage of C").
fn error_text(i32 code, strbuf.str_buf mut* out) void {
    i32 saved = libc.errno();
    strbuf.append(out, str.from_cstr(libc.strerror(code)));
    libc.set_errno(saved);
}

/// Reports whether the process can reach the file `path` for `mode`, an access(2) mode such as
/// libc.R_OK. Returns false and sets errno when it cannot or when access(2) fails.
// C call libc.access: c_path.ptr keeps the bound of the str.to_cstr buffer c_path, path.len + 1
// bytes (D9.8 rule 2), and its last byte is the NUL (rule 4).
fn can_access(string path, i32 mode) bool {
    char mut@ own c_path = str.to_cstr(path);
    defer del(c_path);
    return libc.access(c_path.ptr, mode) == 0;
}

/// Makes the directory `path` with the permission bits `mode`, less the umask. Returns false and
/// sets errno when mkdir(2) fails: EEXIST when an entry stands at `path`.
// C call libc.mkdir: c_path.ptr keeps the bound of the str.to_cstr buffer c_path, path.len + 1
// bytes (D9.8 rule 2), and its last byte is the NUL (rule 4).
fn make_dir(string path, u32 mode) bool {
    char mut@ own c_path = str.to_cstr(path);
    defer del(c_path);
    return libc.mkdir(c_path.ptr, mode) == 0;
}

/// Gives the file `path`, after each symbolic link, the permission bits `mode` with chmod(2). The
/// bits of `mode` outside PERMISSION_BITS do not count. Returns false and sets errno when chmod
/// fails: ENOENT when no entry stands at `path`. A `mode` with a bit of SET_ID_BITS changes
/// nothing and gives EINVAL on both targets: the Darwin chmod(2) clears S_ISGID for a file whose
/// group is no group of the process and leaves EPERM in errno after a success. Without these
/// bits, a success keeps errno.
// C call libc.chmod: c_path.ptr keeps the bound of the str.to_cstr buffer c_path, path.len + 1
// bytes (D9.8 rule 2), and its last byte is the NUL (rule 4).
fn set_mode(string path, u32 mode) bool {
    if ((mode & SET_ID_BITS) != 0) {
        libc.set_errno(libc.EINVAL);
        return false;
    }
    char mut@ own c_path = str.to_cstr(path);
    defer del(c_path);
    return libc.chmod(c_path.ptr, mode) == 0;
}

/// Makes a symbolic link at `link_path` whose target is the text `target`, with symlink(2). No
/// file need stand at `target`. Returns false and sets errno when symlink fails: EEXIST when an
/// entry stands at `link_path`, and ENOENT when its directory does not exist.
// C call libc.symlink: c_target.ptr and c_link.ptr keep the bounds of the str.to_cstr buffers
// c_target and c_link (D9.8 rule 2), and the last byte of each is its NUL (rule 4).
fn make_symlink(string target, string link_path) bool {
    char mut@ own c_target = str.to_cstr(target);
    defer del(c_target);
    char mut@ own c_link = str.to_cstr(link_path);
    defer del(c_link);
    return libc.symlink(c_target.ptr, c_link.ptr) == 0;
}

/// Removes the entry `path`, which is no directory; a symbolic link goes, not its target. Returns
/// false and sets errno when unlink(2) fails: ENOENT when no entry stands at `path`.
// C call libc.unlink: c_path.ptr keeps the bound of the str.to_cstr buffer c_path, path.len + 1
// bytes (D9.8 rule 2), and its last byte is the NUL (rule 4).
fn remove_file(string path) bool {
    char mut@ own c_path = str.to_cstr(path);
    defer del(c_path);
    return libc.unlink(c_path.ptr) == 0;
}

/// Removes the empty directory `path`. Returns false and sets errno when rmdir(2) fails.
// C call libc.rmdir: c_path.ptr keeps the bound of the str.to_cstr buffer c_path, path.len + 1
// bytes (D9.8 rule 2), and its last byte is the NUL (rule 4).
fn remove_dir(string path) bool {
    char mut@ own c_path = str.to_cstr(path);
    defer del(c_path);
    return libc.rmdir(c_path.ptr) == 0;
}

/// Removes the entry `name` of the directory that `dir_fd` names: an empty directory with
/// `directory`, and else an entry that is no directory. Returns false and sets errno when
/// unlinkat(2) fails.
// C call libc.unlinkat: c_name.ptr keeps the bound of the str.to_cstr buffer c_name, name.len +
// 1 bytes (D9.8 rule 2), and its last byte is the NUL (rule 4).
fn remove_at(i32 dir_fd, string name, bool directory) bool {
    char mut@ own c_name = str.to_cstr(name);
    defer del(c_name);
    i32 mut flags = 0;
    if (directory) {
        flags = libc.AT_REMOVEDIR;
    }
    return libc.unlinkat(dir_fd, c_name.ptr, flags) == 0;
}

/// Gives the file at `old_path` the name `new_path` with rename(2), in one atomic step that
/// replaces a file at `new_path`. Both paths must be on one file system. Returns false and sets
/// errno when rename(2) fails.
// C call libc.rename: c_old.ptr and c_new.ptr keep the bounds of the str.to_cstr buffers c_old
// and c_new (D9.8 rule 2), and the last byte of each is its NUL (rule 4).
fn rename(string old_path, string new_path) bool {
    char mut@ own c_old = str.to_cstr(old_path);
    defer del(c_old);
    char mut@ own c_new = str.to_cstr(new_path);
    defer del(c_new);
    return libc.rename(c_old.ptr, c_new.ptr) == 0;
}

/// Appends the target of the symbolic link `path` to `out` and returns true. Returns false, leaves
/// `out` unchanged, and sets errno when readlink(2) fails: EINVAL when `path` is no symbolic link.
/// A target longer than 65535 bytes gives ERANGE.
// C call libc.readlink: c_path.ptr keeps the bound of the str.to_cstr buffer c_path (D9.8 rule
// 2), and its last byte is the NUL (rule 4). buf.ptr keeps the bound of buf, cap bytes (rule 2),
// and the length cap fits it.
fn read_link(string path, strbuf.str_buf mut* out) bool {
    char mut@ own c_path = str.to_cstr(path);
    defer del(c_path);
    u64 mut cap = PATH_FIRST_CAP;
    while (cap <= PATH_LAST_CAP) {
        char mut@ own buf = new(char, cap);
        defer del(buf);
        i64 len = libc.readlink(c_path.ptr, buf.ptr, cap);
        if (len < 0) {
            return false;
        }
        if (cast(len, u64) < cap) {
            strbuf.append(out, cast(buf[0..cast(len, u64)], string));
            return true;
        }
        cap = cap * 2;
    }
    libc.set_errno(libc.ERANGE);
    return false;
}

/// Appends the absolute path of the working directory to `out` and returns true. Returns false,
/// leaves `out` unchanged, and sets errno when getcwd(3) fails, for example with ENOENT when the
/// directory was removed. A path longer than 65535 bytes gives ERANGE.
// C call libc.getcwd: &buf[0] keeps the bound of buf, cap bytes (D9.8 rule 2), and the length
// cap fits it.
fn current_dir(strbuf.str_buf mut* out) bool {
    u64 mut cap = PATH_FIRST_CAP;
    while (cap <= PATH_LAST_CAP) {
        char mut@ own buf = new(char, cap);
        defer del(buf);
        if (libc.getcwd(&buf[0], cap) != null) {
            strbuf.append(out, str.from_cbuf(cast(buf[..], u8@)));
            return true;
        }
        if (libc.errno() != libc.ERANGE) {
            return false;
        }
        cap = cap * 2;
    }
    return false;
}

/// Makes a new directory with mkdtemp(3) from `template`, whose last six bytes are `XXXXXX`, which
/// mkdtemp replaces to give a name that no entry has. Appends the path of the directory to `out`
/// and returns true. Returns false, leaves `out` unchanged, and sets errno when mkdtemp fails:
/// ENOENT when the directory of `template` does not exist. glibc gives EINVAL for a template that
/// does not end in `XXXXXX`, and the Darwin C library takes it.
// C call libc.mkdtemp: &c_template[0] keeps the bound of the str.to_cstr buffer c_template
// (D9.8 rule 2), and its last byte is the NUL (rule 4); C writes only bytes before that NUL.
fn make_temp_dir(string template, strbuf.str_buf mut* out) bool {
    char mut@ own c_template = str.to_cstr(template);
    defer del(c_template);
    if (libc.mkdtemp(&c_template[0]) == null) {
        return false;
    }
    strbuf.append(out, str.from_cbuf(cast(c_template[..], u8@)));
    return true;
}

/// Appends an entry of the directory `path` to `out` for each entry but `.` and `..`, in the order
/// of readdir(3): one byte of its kind, a `libc.DT_` value, then its name, then a NUL. next_entry
/// reads the entries back. Returns false, leaves `out` unchanged, and sets errno when the
/// directory does not open or when readdir fails.
// C call libc.opendir: c_path.ptr keeps the bound of the str.to_cstr buffer c_path, path.len + 1
// bytes (D9.8 rule 2), and its last byte is the NUL (rule 4).
// C call append_entries: stream, storage that opendir gave in this function and not null (rule 3).
// C call libc.closedir: stream, which opendir gave in this function (rule 3), with `move`.
fn list_dir(string path, strbuf.str_buf mut* out) bool {
    char mut@ own c_path = str.to_cstr(path);
    defer del(c_path);
    void mut* own stream = libc.opendir(c_path.ptr);
    if (stream == null) {
        return false;
    }
    bool listed = append_entries(stream, out);
    i32 failure = libc.errno();
    libc.closedir(move(stream));
    libc.set_errno(failure);
    return listed;
}

/// list_dir for the directory that the open descriptor `dir_fd` names. It reads through a
/// duplicate of `dir_fd` and closes the duplicate, so `dir_fd` stays open. The duplicate shares
/// the position of `dir_fd`, so the function first moves `dir_fd` to the first entry, and each
/// call gives each entry. A descriptor of another type of file gives ENOTDIR before the move, so
/// its position does not change. A descriptor whose position does not move gives the errno of
/// lseek(2) before the dup(2).
// C call libc.lseek: no pointer argument.
// C call libc.dup: no pointer argument.
// C call libc.fdopendir: no pointer argument.
// C call libc.close: no pointer argument.
// C call append_entries: stream, storage that fdopendir gave in this function and not null
// (D9.8 rule 3).
// C call libc.closedir: stream, which fdopendir gave in this function (rule 3), with `move`.
fn list_dir_fd(i32 dir_fd, strbuf.str_buf mut* out) bool {
    u32 mut mode = 0;
    if (!file_mode(dir_fd, &mode)) {
        return false;
    }
    if ((mode & S_IFMT) != S_IFDIR) {
        libc.set_errno(libc.ENOTDIR);
        return false;
    }
    if (libc.lseek(dir_fd, 0, libc.SEEK_SET) < 0) {
        return false;
    }
    i32 copy = libc.dup(dir_fd);
    if (copy < 0) {
        return false;
    }
    // closedir(3) closes `copy` as well
    void mut* own stream = libc.fdopendir(copy);
    if (stream == null) {
        i32 failure = libc.errno();
        libc.close(copy);
        libc.set_errno(failure);
        return false;
    }
    bool listed = append_entries(stream, out);
    i32 failure = libc.errno();
    libc.closedir(move(stream));
    libc.set_errno(failure);
    return listed;
}

// Appends each entry of the directory stream `stream` but `.` and `..` to `out`, as list_dir
// gives them. Returns false with errno set and `out` unchanged when readdir(3) fails or gives a
// record whose size does not fit a `dirent`. errno is 0 before each readdir, so it is 0 after it
// at the end of the stream and the error number after an error. A record holds `reclen` bytes,
// the NUL of the name included, so the copy of `reclen` bytes into a zero `dirent` holds the
// whole name and no byte past the record (D9.8).
// C call libc.readdir: stream is a parameter source (D9.8 rule 1), so append_entries is a
// boundary function, and its callers in this module give a stream that opendir or fdopendir
// gave. The stream is storage of C that only closedir releases. This function does not call
// closedir, and each caller calls it after this function returns (D9.8, "Storage of C").
// C call libc.memcpy: cast(&entry, u8 mut*) keeps the bound of the local entry,
// sizeof(libc.dirent) bytes (rule 2). cast(head, u8*) keeps the bound of the record that readdir
// gave in this function, reclen bytes, as the row of readdir states (rule 3). The length size is
// reclen, which fits both: the test above holds it at most sizeof(libc.dirent). The two do not
// overlap, because entry is a local and the record is storage of C.
// gives: in *out a copy of the kind and of the name of each entry in storage of `new`, and no
// view of a record of readdir. A record is storage of C, which the next readdir or closedir of
// the stream can change or release. The function loads `reclen` through head and gives head to
// memcpy before each other call of C, so no call released a byte that the two read. Each later
// read is a read of the local entry, which holds no pointer (D9.8, "Storage of C").
fn append_entries(void mut* stream, strbuf.str_buf mut* out) bool {
    u64 start = out->len;
    while (true) {
        libc.set_errno(0);
        libc.dirent_head* head = libc.readdir(stream);
        if (head == null) {
            if (libc.errno() != 0) {
                out->len = start;
                return false;
            }
            return true;
        }
        u64 size = cast(head->reclen, u64);
        if (size < sizeof(libc.dirent_head) || size > sizeof(libc.dirent)) {
            out->len = start;
            libc.set_errno(libc.EINVAL);
            return false;
        }
        libc.dirent mut entry = {};
        libc.memcpy(cast(&entry, u8 mut*), cast(head, u8*), size);
        string name = str.from_cbuf(cast(entry.name[..], u8@));
        if (name != "." && name != "..") {
            strbuf.push(out, cast(entry.kind, char));
            strbuf.append(out, name);
            strbuf.push(out, '\0');
        }
    }
}

/// One entry of a directory that next_entry reads: its name, and its kind, a `libc.DT_` value.
/// A file system that does not record the kind gives `libc.DT_UNKNOWN`.
struct dir_entry {
    string name;
    u8 kind;
}

/// Reads the entry at `*at` of `list`, the text that list_dir or list_dir_fd gave, into `*entry`,
/// moves `*at` to the next entry, and returns true. Returns false when `*at` is at the end of
/// `list`, and when no NUL ends the entry at `*at`; `*at` and `*entry` then stay as they were.
/// Start with `*at` at 0. The name is a view of `list`.
fn next_entry(string list, u64 mut* at, dir_entry mut* entry) bool {
    if (*at >= list.len) {
        return false;
    }
    u64 start = *at + 1;
    u64 mut end = start;
    while (end < list.len && list[end] != '\0') {
        end += 1;
    }
    if (end >= list.len) {
        return false;
    }
    entry->kind = cast(list[*at], u8);
    entry->name = list[start..end];
    *at = end + 1;
    return true;
}
