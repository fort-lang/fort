/// Provides descriptor and whole-file input and output.
/// Call flush before direct writes to a descriptor that the print family also uses.
import std.libc;
import std.mem;
import std.rt;
import std.str;
import std.strbuf;
import std.sys;

// Standard process descriptors.
i32 STDIN = 0;
i32 STDOUT = 1;
i32 STDERR = 2;

// read_all reserves this many bytes for each read.
u64 CHUNK = 4096;

/// Opens path for reading. A path containing \0 names its prefix.
/// A failure returns -1 and sets sys.errno().
fn open_read(string path) i32 {
    char mut@ own c_path = str.to_cstr(path);
    defer del(c_path);
    return libc.open(c_path.ptr, libc.O_RDONLY, 0);
}

/// Opens path for writing, creates it with mode 0o644, or truncates it.
/// A failure returns -1 and sets sys.errno().
fn open_write(string path) i32 {
    char mut@ own c_path = str.to_cstr(path);
    defer del(c_path);
    return libc.open(c_path.ptr, libc.O_WRONLY | libc.O_CREAT | libc.O_TRUNC, 0o644);
}

/// Opens path with the open(2) flags `flags`, such as `libc.O_RDONLY | libc.O_DIRECTORY`.
/// `mode` gives the permission bits of a file that O_CREAT makes, less the umask; other flags
/// ignore it. A path containing \0 names its prefix.
/// A failure returns -1 and sets sys.errno().
fn open(string path, i32 flags, i32 mode) i32 {
    char mut@ own c_path = str.to_cstr(path);
    defer del(c_path);
    return libc.open(c_path.ptr, flags, mode);
}

/// Flushes the runtime buffer for fd, then closes fd. The buffer forgets the type of the file, so
/// a file that a later open gives the same number gets the state of its own type.
/// Returns false when close(2) fails. The descriptor is invalid after either result.
fn close(i32 fd) bool {
    // Flush before close removes the descriptor.
    rt.reset_buffer(fd);
    return libc.close(fd) == 0;
}

/// Flushes the runtime buffer for fd. Does nothing when fd has no buffer.
fn flush(i32 fd) void {
    rt.flush(fd);
}

/// Reads once into buf. Returns 0 at end of file or for an empty buffer.
/// Retries EINTR. Other failures return -1 and set sys.errno().
fn read(i32 fd, u8 mut@ buf) i64 {
    if (buf.len == 0) {
        return 0;
    }
    while (true) {
        i64 n = libc.read(fd, buf.ptr, buf.len);
        if (n >= 0 || sys.errno() != libc.EINTR) {
            return n;
        }
    }
}

/// Writes once from buf. Returns the count of bytes written, at most buf.len, or 0 for an empty
/// buffer, which makes no system call. Retries EINTR. Other failures return -1 and set
/// sys.errno().
fn write(i32 fd, u8@ buf) i64 {
    if (buf.len == 0) {
        return 0;
    }
    while (true) {
        i64 n = libc.write(fd, buf.ptr, buf.len);
        if (n >= 0 || sys.errno() != libc.EINTR) {
            return n;
        }
    }
}

/// Writes all bytes, handles partial writes, and retries EINTR.
/// Returns false when write fails or reports zero progress. Some bytes can already be written.
fn write_all(i32 fd, u8@ buf) bool {
    u64 mut done = 0;
    while (done < buf.len) {
        // A sub-span names the bytes that remain.
        u8@ rest = buf[done..];
        i64 n = libc.write(fd, rest.ptr, rest.len);
        if (n < 0) {
            if (sys.errno() == libc.EINTR) {
                continue;
            }
            return false;
        }
        if (n == 0) {
            // Treat no progress as failure to make the loop terminate.
            return false;
        }
        done += cast(n, u64);
    }
    return true;
}

/// Appends bytes from fd through end of file.
/// On failure, returns false and restores out->len. The buffer capacity can increase.
fn read_all(i32 fd, strbuf.str_buf mut* out) bool {
    u64 start = out->len;
    while (true) {
        strbuf.reserve(out, CHUNK);
        // Read directly into the spare capacity.
        u8 mut@ room = out->data[out->len..];
        i64 n = read(fd, room);
        if (n < 0) {
            out->len = start;
            return false;
        }
        if (n == 0) {
            return true;
        }
        out->len += cast(n, u64);
    }
}

/// Appends one file to out.
/// On failure, returns false, restores out->len, and leaves sys.errno() from the failing call.
fn read_file(string path, strbuf.str_buf mut* out) bool {
    u64 start = out->len;
    i32 fd = open_read(path);
    if (fd < 0) {
        return false;
    }
    if (!read_all(fd, out)) {
        // A successful close keeps errno from the failed read.
        close(fd);
        return false;
    }
    if (!close(fd)) {
        out->len = start;
        return false;
    }
    return true;
}

/// Reads one file into an exact-size span.
/// On failure, the function leaves *out unchanged. On success, the function dels *out just
/// before its store, so it frees a live *out and then stores the new span.
/// An empty file returns a zero-length, non-null span.
fn read_file_bytes(string path, u8 mut@ own mut* out) bool {
    strbuf.str_buf mut buf = strbuf.create();
    defer del(buf.data);
    if (!read_file(path, &buf)) {
        return false;
    }
    u8 mut@ own bytes = new(u8, buf.len);
    mem.copy(bytes, strbuf.bytes(&buf));
    del(*out);
    *out = move(bytes);
    return true;
}

/// Writes data to a new or truncated file. Returns true only when writing and closing succeed.
/// A failure can leave a partial file. The function closes every descriptor that it opens.
fn write_file(string path, u8@ data) bool {
    i32 fd = open_write(path);
    if (fd < 0) {
        return false;
    }
    bool written = write_all(fd, data);
    return close(fd) && written;
}

/// Reports whether fd names a terminal. Returns false and sets sys.errno() when fd names no
/// terminal or no open descriptor.
fn is_terminal(i32 fd) bool {
    return libc.isatty(fd) == 1;
}

/// Makes a pipe. Writes the descriptor of its read end to *read_end and the descriptor of its
/// write end to *write_end, and returns true. Returns false, leaves both unchanged, and sets
/// sys.errno() when pipe(2) fails.
fn pipe(i32 mut* read_end, i32 mut* write_end) bool {
    i32[2] mut fds = {};
    if (libc.pipe(&fds[0]) != 0) {
        return false;
    }
    *read_end = fds[0];
    *write_end = fds[1];
    return true;
}

/// Gives a new descriptor of the file that `fd` names with dup(2), the lowest descriptor that is
/// free. The two descriptors share the position and the status flags of the file. Returns the
/// new descriptor, or -1 and sets sys.errno() when dup fails: EBADF when `fd` is not open, and
/// EMFILE when no descriptor is free.
fn dup(i32 fd) i32 {
    return libc.dup(fd);
}

/// Makes `new_fd` name the file that `old_fd` names with dup2(2), and returns `new_fd`. The
/// function first flushes the runtime buffers of `old_fd` and of `new_fd`: the bytes that the
/// print family wrote to `old_fd` before come before the bytes written to `new_fd` after, and the
/// bytes of `new_fd` go to the file that it named before, which dup2 closes. Then the buffer of
/// `new_fd` takes the state of its new file: line buffered for a terminal, else not. When both
/// descriptors name one file, the bytes of `old_fd` come first, whatever order the program wrote
/// them in, so a caller that needs an order calls io.flush between the writes. When
/// `new_fd` is `old_fd` and is open, nothing changes. Returns -1 and sets sys.errno() when dup2
/// fails: EBADF when `old_fd` is not open or `new_fd` is negative.
fn dup2(i32 old_fd, i32 new_fd) i32 {
    rt.flush(old_fd);
    rt.flush(new_fd);
    i32 result = libc.dup2(old_fd, new_fd);
    // The flush above emptied the buffer, so this only makes the buffer read the type of the
    // file again at the next output; it keeps errno.
    rt.reset_buffer(new_fd);
    return result;
}
