/// Provides growable vectors of pointers and i64 values.
// Copy one implementation and change its element type to add another vector type.

// Maximum capacity value used by both reserve functions.
u64 U64_MAX = 18446744073709551615;

/// items.len is the capacity, and len is the slot count in use.
struct ptr_vec {
    void mut* mut@ own items;
    u64 len;
}

/// items.len is the capacity, and len is the element count in use.
struct int_vec {
    i64 mut@ own items;
    u64 len;
}

/// Creates an empty pointer vector without allocating.
fn ptr_create() ptr_vec {
    return ptr_vec{};
}

/// Creates an empty pointer vector with cap slots.
fn ptr_with_cap(u64 cap) ptr_vec {
    return ptr_vec{new(void mut*, cap), 0};
}

/// Frees the slot storage and leaves ptr_vec{}.
/// Repeated calls and calls on an empty vector do nothing.
fn ptr_free(ptr_vec mut* v) void {
    del(v->items);
    v->len = 0;
}

/// Ensures capacity for extra pointers after the current elements.
/// Panics when len + extra cannot fit in u64.
fn ptr_reserve(ptr_vec mut* v, u64 extra) void {
    // Test the sum before computing it.
    if (extra > U64_MAX - v->len) {
        panic("vec.ptr_reserve: capacity overflow");
    }
    u64 need = v->len + extra;
    if (need <= v->items.len) {
        return;
    }
    u64 mut cap = 16;
    if (need > cap) {
        cap = need;
    }
    // Skip doubling when the result cannot fit in u64.
    if (v->items.len <= U64_MAX / 2 && v->items.len * 2 > cap) {
        cap = v->items.len * 2;
    }
    void mut* mut@ own bigger = new(void mut*, cap);
    u64 mut i = 0;
    while (i < v->len) {
        bigger[i] = v->items[i];
        i += 1;
    }
    del(v->items);
    v->items = move(bigger);
}

/// Appends one pointer and grows the vector as needed.
fn ptr_push(ptr_vec mut* v, void mut* p) void {
    ptr_reserve(v, 1);
    v->items[v->len] = p;
    v->len += 1;
}

/// Removes and returns the last pointer. Panics when the vector is empty.
fn ptr_pop(ptr_vec mut* v) void mut* {
    if (v->len == 0) {
        panic("vec.ptr_pop: empty");
    }
    v->len -= 1;
    return v->items[v->len];
}

/// Creates an empty i64 vector without allocating.
fn int_create() int_vec {
    return int_vec{};
}

/// Creates an empty i64 vector with cap elements.
fn int_with_cap(u64 cap) int_vec {
    return int_vec{new(i64, cap), 0};
}

/// Frees the elements and leaves int_vec{}.
/// Repeated calls and calls on an empty vector do nothing.
fn int_free(int_vec mut* v) void {
    del(v->items);
    v->len = 0;
}

/// Ensures capacity for extra values after the current elements.
/// Panics when len + extra cannot fit in u64.
fn int_reserve(int_vec mut* v, u64 extra) void {
    if (extra > U64_MAX - v->len) {
        panic("vec.int_reserve: capacity overflow");
    }
    u64 need = v->len + extra;
    if (need <= v->items.len) {
        return;
    }
    u64 mut cap = 16;
    if (need > cap) {
        cap = need;
    }
    if (v->items.len <= U64_MAX / 2 && v->items.len * 2 > cap) {
        cap = v->items.len * 2;
    }
    i64 mut@ own bigger = new(i64, cap);
    u64 mut i = 0;
    while (i < v->len) {
        bigger[i] = v->items[i];
        i += 1;
    }
    del(v->items);
    v->items = move(bigger);
}

/// Appends one i64 value and grows the vector as needed.
fn int_push(int_vec mut* v, i64 x) void {
    int_reserve(v, 1);
    v->items[v->len] = x;
    v->len += 1;
}

/// Removes and returns the last value. Panics when the vector is empty.
fn int_pop(int_vec mut* v) i64 {
    if (v->len == 0) {
        panic("vec.int_pop: empty");
    }
    v->len -= 1;
    return v->items[v->len];
}
