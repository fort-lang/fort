/// Provides a growable vector of i64 values, the pattern of each other element type.
// Copy the implementation and change its element type to add another vector type. A vector of
// pointers is such a typed copy: no cast gives a type to a `void*` (D3.14), so a vector of `void*`
// could give no typed pointer back (stdlib.md 2.7).

// Maximum capacity value used by int_reserve.
u64 U64_MAX = 18446744073709551615;

/// items.len is the capacity, and len is the element count in use.
struct int_vec {
    i64 mut@ own items;
    u64 len;
}

/// Creates an empty i64 vector without allocating.
fn int_create() int_vec {
    return int_vec{};
}

/// Creates an empty i64 vector with cap elements.
fn int_with_cap(u64 cap) int_vec {
    return int_vec{new(i64, cap), 0};
}

/// Frees the elements and leaves int_vec{}.
/// Repeated calls and calls on an empty vector do nothing.
// int_drop holds the release, and the move leaves the zero value.
fn int_free(int_vec mut* v) void {
    int_drop(move(*v));
}

/// Frees the elements.
fn int_drop(int_vec mut v) void {
    del(v.items);
}

/// Ensures capacity for extra values after the current elements.
/// Panics when len + extra cannot fit in u64.
fn int_reserve(int_vec mut* v, u64 extra) void {
    if (extra > U64_MAX - v->len) {
        panic("vec.int_reserve: capacity overflow");
    }
    u64 need = v->len + extra;
    if (need <= v->items.len) {
        return;
    }
    u64 mut cap = 16;
    if (need > cap) {
        cap = need;
    }
    if (v->items.len <= U64_MAX / 2 && v->items.len * 2 > cap) {
        cap = v->items.len * 2;
    }
    i64 mut@ own bigger = new(i64, cap);
    u64 mut i = 0;
    while (i < v->len) {
        bigger[i] = v->items[i];
        i += 1;
    }
    del(v->items);
    v->items = move(bigger);
}

/// Appends one i64 value and grows the vector as needed.
fn int_push(int_vec mut* v, i64 x) void {
    int_reserve(v, 1);
    v->items[v->len] = x;
    v->len += 1;
}

/// Removes and returns the last value. Panics when the vector is empty.
fn int_pop(int_vec mut* v) i64 {
    if (v->len == 0) {
        panic("vec.int_pop: empty");
    }
    v->len -= 1;
    return v->items[v->len];
}
