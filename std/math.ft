/// Provides integer limits, float bit conversions, absolute values, and extrema.
/// Each function name includes its numeric type because fort has no overloading.

// Limits for the integer types that this module uses.
i32 I32_MIN = -2147483648;
i32 I32_MAX = 2147483647;
i64 I64_MIN = -9223372036854775808;
i64 I64_MAX = 9223372036854775807;
u32 U32_MAX = 0xFFFFFFFF;
u64 U64_MAX = 0xFFFFFFFFFFFFFFFF;

// IEEE 754 encodings for positive infinity and a quiet NaN.
u64 F64_INF_BITS = 0x7FF0000000000000;
u64 F64_NAN_BITS = 0x7FF8000000000000;

fn f64_bits(f64 x) u64 {
    return *cast(&x, u64*);
}

fn f64_from_bits(u64 bits) f64 {
    return *cast(&bits, f64*);
}

fn f32_bits(f32 x) u32 {
    return *cast(&x, u32*);
}

fn f32_from_bits(u32 bits) f32 {
    return *cast(&bits, f32*);
}

fn f64_inf() f64 {
    return f64_from_bits(F64_INF_BITS);
}

fn f64_nan() f64 {
    return f64_from_bits(F64_NAN_BITS);
}

/// Reports whether x is a NaN.
fn is_nan(f64 x) bool {
    return x != x;
}

/// Returns the magnitude of x.
/// I32_MIN traps in checked mode and remains I32_MIN in release mode.
fn abs_i32(i32 x) i32 {
    return x < 0 ? -x : x;
}

/// Returns the magnitude of x.
/// I64_MIN traps in checked mode and remains I64_MIN in release mode.
fn abs_i64(i64 x) i64 {
    return x < 0 ? -x : x;
}

fn min_i32(i32 a, i32 b) i32 {
    return a < b ? a : b;
}

fn max_i32(i32 a, i32 b) i32 {
    return a > b ? a : b;
}

fn min_i64(i64 a, i64 b) i64 {
    return a < b ? a : b;
}

fn max_i64(i64 a, i64 b) i64 {
    return a > b ? a : b;
}

fn min_u64(u64 a, u64 b) u64 {
    return a < b ? a : b;
}

fn max_u64(u64 a, u64 b) u64 {
    return a > b ? a : b;
}

/// Returns b when either operand is a NaN.
fn min_f64(f64 a, f64 b) f64 {
    return a < b ? a : b;
}

/// Returns b when either operand is a NaN.
fn max_f64(f64 a, f64 b) f64 {
    return a > b ? a : b;
}
