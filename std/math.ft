// std.math: the integer limits, the float bit casts and the per-type abs, min
// and max of stdlib.md 2.9.
//
// There is no overloading, so each function names its type and the file holds
// one body for each. The module imports nothing: every function here is
// arithmetic over its arguments, and no line of it calls the runtime or libc.
// D8.3
//
// The module holds f64 and f32 functions, so the C bootstrap refuses it as it
// refuses std.rt_float: stage1 rejects a float type outright, and a program
// that imports std.math is a program stage1 rejects whole, whatever part of the
// module it uses. stage2 accepts it. The tests of this module are therefore in
// test/lang/bootstrap-unsupported.txt with every other float test.
// D18.1
//
// The bit casts reinterpret the bytes through the pointer-cast idiom, which is
// defined because fort has no strict-aliasing rule.
// D10.7

/// The limits of the four integer types this module names. They are module-level
/// constants, so a caller uses one in a case label and in an array length.
/// D7.10
i32 I32_MIN = -2147483648;
i32 I32_MAX = 2147483647;
i64 I64_MIN = -9223372036854775808;
i64 I64_MAX = 9223372036854775807;
u32 U32_MAX = 0xFFFFFFFF;
u64 U64_MAX = 0xFFFFFFFFFFFFFFFF;

/// The encodings f64_inf and f64_nan return: the positive infinity of an f64 and
/// its quiet NaN. They are constants of this module and not of the language,
/// since no float literal denotes either one.
/// D6.12
u64 F64_INF_BITS = 0x7FF0000000000000;
u64 F64_NAN_BITS = 0x7FF8000000000000;

/// The IEEE 754 encoding of x, its bytes unchanged. Ownership: none.
fn u64 f64_bits(f64 x) {
    return *cast(&x, u64*);
}

/// The f64 whose encoding is bits, its bytes unchanged. Every bit pattern is an
/// f64, so this function has no failing case. Ownership: none.
fn f64 f64_from_bits(u64 bits) {
    return *cast(&bits, f64*);
}

/// The IEEE 754 encoding of x, its bytes unchanged. Ownership: none.
fn u32 f32_bits(f32 x) {
    return *cast(&x, u32*);
}

/// The f32 whose encoding is bits, its bytes unchanged. Ownership: none.
fn f32 f32_from_bits(u32 bits) {
    return *cast(&bits, f32*);
}

/// The positive infinity of an f64. Ownership: none.
fn f64 f64_inf() {
    return f64_from_bits(F64_INF_BITS);
}

/// A quiet NaN of an f64. Ownership: none.
fn f64 f64_nan() {
    return f64_from_bits(F64_NAN_BITS);
}

/// True when x is a NaN, which is the one value that is not equal to itself.
/// Ownership: none.
/// D6.12
fn bool is_nan(f64 x) {
    return x != x;
}

/// The magnitude of x. For I32_MIN the negation traps in checked mode and
/// yields I32_MIN again in release mode, so a caller that needs a total
/// function tests for the minimum first. Ownership: none.
/// D11.1
fn i32 abs_i32(i32 x) {
    return x < 0 ? -x : x;
}

/// The magnitude of x, with the I64_MIN case of abs_i32. Ownership: none.
fn i64 abs_i64(i64 x) {
    return x < 0 ? -x : x;
}

/// The smaller of a and b. Ownership: none.
fn i32 min_i32(i32 a, i32 b) {
    return a < b ? a : b;
}

/// The larger of a and b. Ownership: none.
fn i32 max_i32(i32 a, i32 b) {
    return a > b ? a : b;
}

/// The smaller of a and b. Ownership: none.
fn i64 min_i64(i64 a, i64 b) {
    return a < b ? a : b;
}

/// The larger of a and b. Ownership: none.
fn i64 max_i64(i64 a, i64 b) {
    return a > b ? a : b;
}

/// The smaller of a and b. Ownership: none.
fn u64 min_u64(u64 a, u64 b) {
    return a < b ? a : b;
}

/// The larger of a and b. Ownership: none.
fn u64 max_u64(u64 a, u64 b) {
    return a > b ? a : b;
}

/// The smaller of a and b. A comparison against a NaN is false, so a NaN in
/// either operand returns b; do not rely on NaN propagation. Ownership: none.
fn f64 min_f64(f64 a, f64 b) {
    return a < b ? a : b;
}

/// The larger of a and b, with the NaN case of min_f64. Ownership: none.
fn f64 max_f64(f64 a, f64 b) {
    return a > b ? a : b;
}
