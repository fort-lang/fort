// Mac std.net uses the Darwin IPv4 socket layout (stdlib.md 2.13).
// The exported functions match the Linux std.net functions.
// D3.8, D9.8, D13.2, D13.4
import std.libc;
import std.str;
import std.sys;

/// Darwin socket and IPv4 constants. test/mac/net_probe.c measures them.
i32 AF_INET = 2;
i32 SOCK_STREAM = 1;
i32 SOL_SOCKET = 0xFFFF;
i32 SO_REUSEADDR = 0x0004;
u32 INADDR_ANY = 0;

/// Darwin sockaddr_in has a length byte before its family byte.
/// C places len, family, port, and addr at 0, 1, 2, and 4.
/// The struct has 16 bytes. test/mac/net_probe.c measures the layout.
/// D3.8
struct sockaddr_in {
    u8 len;
    u8 family;
    u16 port;
    u32 addr;
    u8[8] zero;
}

/// This function reverses two bytes for network byte order.
/// The masks keep each shift in the u16 range.
/// D6.2, D11.1
fn hton16(u16 v) u16 {
    return ((v & 0x00FF) << 8) | ((v >> 8) & 0x00FF);
}

/// This function reverses four bytes for network byte order.
/// The masks keep each shift in the u32 range.
fn hton32(u32 v) u32 {
    return ((v & 0x000000FF) << 24) | ((v & 0x0000FF00) << 8)
         | ((v >> 8) & 0x0000FF00) | ((v >> 24) & 0x000000FF);
}

/// This function reads four decimal IPv4 fields and writes network byte order.
/// Each field has one to three digits and a value from 0 to 255.
/// An invalid field returns false and leaves *out unchanged.
/// D13.3
fn parse_ipv4(string text, u32 mut* out) bool {
    u32 mut host = 0;
    u64 mut start = 0;
    i32 mut field = 0;
    while (field < 4) {
        u64 mut stop = start;
        while (stop < text.len && text[stop] != '.') {
            stop += 1;
        }
        u64 width = stop - start;
        if (width == 0 || width > 3) {
            return false;
        }
        u64 mut value = 0;
        if (!str.parse_u64(text[start..stop], 10, &value)) {
            return false;
        }
        if (value > 255) {
            return false;
        }
        // The first field takes the most significant byte.
        // The shift is 24, 16, 8, or 0. The value is at most 255.
        // D11.1
        host = host | (cast(value, u32) << (24 - field * 8));
        if (field < 3) {
            if (stop >= text.len) {
                return false;
            }
            start = stop + 1;
        } else if (stop != text.len) {
            return false;
        }
        field += 1;
    }
    *out = hton32(host);
    return true;
}

/// This function closes fd and restores the errno from the failed call.
/// close(2) can change errno. The caller must read the failed call's errno.
/// A signal can interrupt close(2) (notes/testing.md 7).
fn close_and_fail(i32 fd) i32 {
    i32 saved = sys.errno();
    libc.close(fd);
    *libc.errno_slot() = saved;
    return -1;
}

/// This function listens on every interface.
/// Port 0 asks the kernel for a free port. The caller closes the descriptor.
/// The function sets SO_REUSEADDR before bind(2).
/// D13.3, D13.4
fn listen(u16 port, i32 backlog) i32 {
    i32 fd = libc.socket(AF_INET, SOCK_STREAM, 0);
    if (fd < 0) {
        return -1;
    }
    i32 mut on = 1;
    u32 on_len = cast(sizeof(i32), u32);
    if (libc.setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, cast(&on, void*), on_len) < 0) {
        return close_and_fail(fd);
    }
    sockaddr_in mut addr = {};
    addr.len = 16;
    addr.family = cast(AF_INET, u8);
    addr.port = hton16(port);
    addr.addr = hton32(INADDR_ANY);
    if (libc.bind(fd, cast(&addr, void*), cast(sizeof(sockaddr_in), u32)) < 0) {
        return close_and_fail(fd);
    }
    if (libc.listen(fd, backlog) < 0) {
        return close_and_fail(fd);
    }
    return fd;
}

/// This function accepts one connection and returns its descriptor.
/// The caller closes the descriptor. The function does not return the peer address.
/// D13.3
fn accept(i32 fd) i32 {
    i32 client = libc.accept(fd, null, null);
    if (client < 0) {
        return -1;
    }
    return client;
}

/// This function connects to a dotted IPv4 address and port.
/// Invalid address text sets EINVAL without a system call.
/// The caller closes the returned descriptor.
/// D13.3, D13.4
fn connect(string host_ipv4, u16 port) i32 {
    u32 mut host = 0;
    if (!parse_ipv4(host_ipv4, &host)) {
        *libc.errno_slot() = libc.EINVAL;
        return -1;
    }
    i32 fd = libc.socket(AF_INET, SOCK_STREAM, 0);
    if (fd < 0) {
        return -1;
    }
    sockaddr_in mut addr = {};
    addr.len = 16;
    addr.family = cast(AF_INET, u8);
    addr.port = hton16(port);
    addr.addr = host;
    if (libc.connect(fd, cast(&addr, void*), cast(sizeof(sockaddr_in), u32)) < 0) {
        return close_and_fail(fd);
    }
    return fd;
}

/// This function reads the bound port with getsockname(2).
/// A failure returns false and leaves *out unchanged.
/// D13.3
fn local_port(i32 fd, u16 mut* out) bool {
    sockaddr_in mut addr = {};
    u32 mut len = cast(sizeof(sockaddr_in), u32);
    if (libc.getsockname(fd, cast(&addr, void mut*), &len) < 0) {
        return false;
    }
    *out = hton16(addr.port);
    return true;
}
