/// Sorts arrays in place through libc.qsort.
/// The element type must permit bytewise moves because C moves raw bytes.
import std.libc;

/// Orders n elements of elem_size bytes at base. The order is not stable.
/// Panics for zero elem_size, a null comparator, or a null base when n is not zero.
/// The function validates these arguments before it returns early for n below 2.
fn sort(void mut* base, u64 n, u64 elem_size, fn (void*, void*) i32 cmp) void {
    if (elem_size == 0) {
        panic("sort.sort: element size is zero");
    }
    if (cmp == null) {
        panic("sort.sort: null comparator");
    }
    if (n > 0 && base == null) {
        panic("sort.sort: null base");
    }
    if (n < 2) {
        return;
    }
    libc.qsort(base, n, elem_size, cmp);
}

fn sort_i64(i64 mut@ items, fn (void*, void*) i32 cmp) void {
    sort(cast(items.ptr, void mut*), items.len, sizeof(i64), cmp);
}

fn sort_u64(u64 mut@ items, fn (void*, void*) i32 cmp) void {
    sort(cast(items.ptr, void mut*), items.len, sizeof(u64), cmp);
}

/// Sorts pointer slots without writing through the pointers.
fn sort_ptr(void* mut@ items, fn (void*, void*) i32 cmp) void {
    sort(cast(items.ptr, void mut*), items.len, sizeof(void*), cmp);
}

/// Compares two i64 elements in ascending order without subtraction overflow.
fn cmp_i64(void* a, void* b) i32 {
    i64 x = *cast(a, i64*);
    i64 y = *cast(b, i64*);
    if (x < y) {
        return -1;
    }
    if (x > y) {
        return 1;
    }
    return 0;
}

/// Compares two u64 elements in ascending order.
fn cmp_u64(void* a, void* b) i32 {
    u64 x = *cast(a, u64*);
    u64 y = *cast(b, u64*);
    if (x < y) {
        return -1;
    }
    if (x > y) {
        return 1;
    }
    return 0;
}
