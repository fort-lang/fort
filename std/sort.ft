/// Sorts typed spans in place, in fort, with no C call (stdlib.md 2.10).
/// fort has no generics, so this module is a pattern: to sort another element type, copy sort_i64
/// and replace `i64` with that type and the prefix with its own. The comparator then reads two
/// elements through typed pointers, and no cast gives a type to a `void*` (D3.14).

/// Orders the elements of items so that cmp answers zero or less for each adjacent pair.
/// The order is not stable. Panics for a null comparator, also for a span of 0 or 1 elements.
// C call cmp x2: cmp is a function value of the caller, a function of fort code or of C, and
// this row holds for both kinds (D9.8). Each call gives it &items[i] and &items[j], typed
// pointers that keep one i64 each (D9.8 rule 2), with i and j below items.len by a checked
// index, and it gives no boundary function.
fn sort_i64(i64 mut@ items, fn (i64*, i64*) i32 cmp) void {
    // The test comes before the count: a call of a null function pointer is undefined (D3.10).
    if (cmp == null) {
        panic("sort.sort_i64: null comparator");
    }
    // A heap sort. The heap is items[..end]: no element of it sorts after its parent at `2k + 1`
    // and `2k + 2`. First each parent from the last one down goes into place, and the heap grows
    // to the whole span. Then the root, which no element sorts after, goes to the end, and the
    // heap shrinks by one. The sort only exchanges two elements, so each element stays in the span
    // once, whatever the comparator answers.
    u64 mut start = items.len / 2;
    u64 mut end = items.len;
    while (end > 1) {
        if (start > 0) {
            start -= 1;
        } else {
            end -= 1;
            i64 last = items[end];
            items[end] = items[0];
            items[0] = last;
        }
        // Move the element at `start` down until no child sorts after it. A child `2k + 1` exists
        // when `k < end / 2`, and then `2k + 1 < end`, so the sum cannot wrap.
        u64 mut at = start;
        while (at < end / 2) {
            u64 mut child = 2 * at + 1;
            if (child + 1 < end && cmp(&items[child], &items[child + 1]) < 0) {
                child += 1;
            }
            if (cmp(&items[at], &items[child]) >= 0) {
                break;
            }
            i64 parent = items[at];
            items[at] = items[child];
            items[child] = parent;
            at = child;
        }
    }
}

/// Orders the elements of items so that cmp answers zero or less for each adjacent pair.
/// The order is not stable. Panics for a null comparator, also for a span of 0 or 1 elements.
// C call cmp x2: cmp is a function value of the caller, a function of fort code or of C, and
// this row holds for both kinds (D9.8). Each call gives it &items[i] and &items[j], typed
// pointers that keep one u64 each (D9.8 rule 2), with i and j below items.len by a checked
// index, and it gives no boundary function.
fn sort_u64(u64 mut@ items, fn (u64*, u64*) i32 cmp) void {
    // a copy of sort_i64 with the element type u64
    if (cmp == null) {
        panic("sort.sort_u64: null comparator");
    }
    u64 mut start = items.len / 2;
    u64 mut end = items.len;
    while (end > 1) {
        if (start > 0) {
            start -= 1;
        } else {
            end -= 1;
            u64 last = items[end];
            items[end] = items[0];
            items[0] = last;
        }
        u64 mut at = start;
        while (at < end / 2) {
            u64 mut child = 2 * at + 1;
            if (child + 1 < end && cmp(&items[child], &items[child + 1]) < 0) {
                child += 1;
            }
            if (cmp(&items[at], &items[child]) >= 0) {
                break;
            }
            u64 parent = items[at];
            items[at] = items[child];
            items[child] = parent;
            at = child;
        }
    }
}

/// Compares two i64 elements in ascending order without subtraction overflow.
fn cmp_i64(i64* a, i64* b) i32 {
    if (*a < *b) {
        return -1;
    }
    if (*a > *b) {
        return 1;
    }
    return 0;
}

/// Compares two u64 elements in ascending order.
fn cmp_u64(u64* a, u64* b) i32 {
    if (*a < *b) {
        return -1;
    }
    if (*a > *b) {
        return 1;
    }
    return 0;
}
