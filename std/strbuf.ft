/// Provides a growable buffer for text and byte sequences.
import std.mem;

// Maximum capacity value used by reserve.
u64 U64_MAX = 18446744073709551615;

/// data.len is the capacity, and len is the byte count in use.
/// str_buf{} is a valid empty buffer.
struct str_buf {
    u8 mut@ own data;
    u64 len;
}

/// Creates an empty buffer without allocating.
fn create() str_buf {
    return str_buf{};
}

/// Creates an empty buffer with cap bytes of capacity.
fn with_cap(u64 cap) str_buf {
    return str_buf{new(u8, cap), 0};
}

/// Frees the buffer data and leaves str_buf{}.
/// Repeated calls and calls on an empty buffer do nothing.
fn free(str_buf mut* b) void {
    del(b->data);
    b->len = 0;
}

/// Ensures capacity for extra bytes after the current contents.
/// Panics when len + extra cannot fit in u64.
fn reserve(str_buf mut* b, u64 extra) void {
    // Test the sum before computing it.
    if (extra > U64_MAX - b->len) {
        panic("strbuf.reserve: capacity overflow");
    }
    u64 need = b->len + extra;
    if (need <= b->data.len) {
        return;
    }
    u64 mut cap = 16;
    if (need > cap) {
        cap = need;
    }
    // Skip doubling when the result cannot fit in u64.
    if (b->data.len <= U64_MAX / 2 && b->data.len * 2 > cap) {
        cap = b->data.len * 2;
    }
    u8 mut@ own bigger = new(u8, cap);
    mem.copy(bigger, b->data[..b->len]);
    del(b->data);
    b->data = move(bigger);
}

/// Returns the current capacity in bytes.
fn cap(str_buf* b) u64 {
    return b->data.len;
}

/// Appends one character byte.
fn push(str_buf mut* b, char ch) void {
    push_byte(b, cast(ch, u8));
}

/// Appends one byte.
fn push_byte(str_buf mut* b, u8 v) void {
    reserve(b, 1);
    b->data[b->len] = v;
    b->len += 1;
}

/// Appends the bytes of s.
/// s must not alias b->data because growth can replace the data before copying.
fn append(str_buf mut* b, string s) void {
    append_bytes(b, cast(s, u8@));
}

/// Appends src. src must not alias b->data.
fn append_bytes(str_buf mut* b, u8@ src) void {
    reserve(b, src.len);
    // reserve proves that the new length fits in u64.
    mem.copy(b->data[b->len..b->len + src.len], src);
    b->len += src.len;
}

/// Appends the decimal text of v.
fn append_i64(str_buf mut* b, i64 v) void {
    if (v >= 0) {
        append_u64(b, cast(v, u64));
        return;
    }
    push(b, '-');
    // Compute negative magnitudes in u64 to support I64_MIN.
    append_u64(b, 0 -% cast(v, u64));
}

/// Appends the decimal text of v; 0 is the single digit "0".
fn append_u64(str_buf mut* b, u64 v) void {
    if (v == 0) {
        push(b, '0');
        return;
    }
    // A u64 has at most 20 decimal digits.
    u8[20] mut digits = {};
    u64 mut n = 0;
    u64 mut rest = v;
    while (rest > 0) {
        digits[n] = cast(cast('0', u64) + rest % 10, u8);
        rest /= 10;
        n += 1;
    }
    while (n > 0) {
        n -= 1;
        push_byte(b, digits[n]);
    }
}

/// Empties the buffer and keeps the storage.
fn clear(str_buf mut* b) void {
    b->len = 0;
}

/// Shortens the buffer to len bytes. Panics when len exceeds the current length.
fn truncate(str_buf mut* b, u64 len) void {
    if (len > b->len) {
        panic("strbuf.truncate: beyond len");
    }
    b->len = len;
}

/// Returns the contents as text without a NUL terminator.
fn view(str_buf* b) string {
    return cast(b->data[..b->len], string);
}

/// Returns the contents as bytes.
fn bytes(str_buf* b) u8@ {
    return b->data[..b->len];
}

/// Copies the contents without a NUL terminator, then empties the buffer.
/// An empty buffer returns a zero-length, non-null allocation.
fn take(str_buf mut* b) string own {
    u8 mut@ own copy = new(u8, b->len);
    mem.copy(copy, b->data[..b->len]);
    b->len = 0;
    return cast(move(copy), string own);
}
