// std.sys: process-level services (stdlib.md 2.1).
// D13.2
import std.libc;
import std.rt;
import std.str;

/// Flushes every runtime output buffer and terminates the process with status
/// code & 0xFF. Deferred statements of the calling function do not run.
/// Ownership: none.
/// D11.5, D11.6
fn exit(i32 code) noreturn {
    rt.exit(code);
}

/// The same string@ that main received: args()[0] is the program name and
/// every element is NUL-terminated. Ownership: a view of the runtime's
/// storage; string@ carries no own, so del does not compile.
/// D8.6, D11.6, D17.3, D13.5, D17.9
fn args() string@ {
    return rt.args();
}

/// The value of C errno for the calling thread, read through
/// __errno_location(). It is meaningful only after a library call has reported
/// failure. Ownership: none.
fn errno() i32 {
    return *libc.__errno_location();
}

/// Looks up name in the process environment. On success *out aliases the
/// environment string (NUL-terminated, valid for the life of the process) and
/// the result is true; when the variable is absent *out is unchanged and the
/// result is false. name is copied into a NUL-terminated buffer for the call.
/// Ownership: *out is a view of the environment.
/// D13.4, D17.3
fn env(string name, string mut* out) bool {
    char mut@ own key = str.to_cstr(name);
    defer del(key);
    char* value = libc.getenv(key.ptr);
    if (value == null) {
        return false;
    }
    *out = str.from_cstr(value);
    return true;
}
