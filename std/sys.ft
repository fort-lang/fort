// std.sys: process-level services (stdlib.md 2.1, D13.2).
import std.libc;
import std.str;

// Flushes every runtime output buffer (D11.5) and terminates the process with
// status code & 0xFF (D11.6). Deferred statements of the calling function do
// not run. Ownership: none.
fn noreturn exit(i32 code) {
    libc.fort_rt_exit(code);
}

// The same string@ that main received (D8.6, D11.6): args()[0] is the program
// name and every element is NUL-terminated. The runtime hands out the element
// pointer and the length of storage it keeps, so this is an unchecked span
// taken of a pointer (D6.9). Ownership: a view of the runtime's storage
// (D17.3, D13.5); string@ carries no own, so del does not compile (D17.9).
fn string@ args() {
    return cast(libc.fort_rt_args_ptr(), string*)[0..libc.fort_rt_args_len()];
}

// The value of C errno for the calling thread, read through
// __errno_location(). It is meaningful only after a library call has reported
// failure. Ownership: none.
fn i32 errno() {
    return *libc.__errno_location();
}

// Looks up name in the process environment. On success *out aliases the
// environment string (NUL-terminated, valid for the life of the process) and
// the result is true; when the variable is absent *out is unchanged and the
// result is false. name is copied into a NUL-terminated buffer for the call
// (D13.4). Ownership: *out is a view of the environment (D17.3).
fn bool env(string name, string mut* out) {
    char mut@ own key = str.to_cstr(name);
    defer del(key);
    char* value = libc.getenv(key.ptr);
    if (value == null) {
        return false;
    }
    *out = str.from_cstr(value);
    return true;
}
