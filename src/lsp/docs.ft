/// Stores the text and version of each document that the client has open.
import std.str;

u64 DOC_MIN_CAP = 4;

// Keep the capacity guard against one exact maximum.
u64 U64_MAX = 18446744073709551615;

// One open document. `version` is the last value from the client.
struct document {
    string own uri;
    string own text;
    i64 version;
}

struct store {
    document mut@ own items;
    u64 count;
}

fn create() store {
    return store{};
}

// Empties the store. A second call has no effect.
fn free(store mut* s) void {
    u64 mut i = 0;
    while (i < s->count) {
        del(s->items[i].uri);
        del(s->items[i].text);
        i += 1;
    }
    del(s->items);
    s->count = 0;
}

fn count(store* s) u64 {
    return s->count;
}

// Returns document `i`. Panics when `i` is outside the store.
fn at(store* s, u64 i) document* {
    if (i >= s->count) {
        panic("docs.at: index out of range");
    }
    return &s->items[i];
}

// The index of the document `uri` names, or -1 when the client has no such
// document open.
fn find(store* s, string uri) i64 {
    u64 mut i = 0;
    while (i < s->count) {
        if (s->items[i].uri == uri) {
            return cast(i, i64);
        }
        i += 1;
    }
    return -1;
}

fn is_open(store* s, string uri) bool {
    return find(s, uri) >= 0;
}

fn reserve(store mut* s) void {
    if (s->count < s->items.len) {
        return;
    }
    u64 mut cap = DOC_MIN_CAP;
    if (s->items.len >= cap) {
        // Check before multiplication because fort traps on overflow.
        if (s->items.len > U64_MAX / 2) {
            // panic-coverage: unreachable: 2^63 documents do not fit in memory.
            panic("docs.reserve: capacity overflow");
        }
        cap = s->items.len * 2;
    }
    document mut@ own bigger = new(document, cap);
    u64 mut i = 0;
    while (i < s->count) {
        // Move each record because its strings are unique values.
        bigger[i].uri = move(s->items[i].uri);
        bigger[i].text = move(s->items[i].text);
        bigger[i].version = s->items[i].version;
        i += 1;
    }
    del(s->items);
    s->items = move(bigger);
}

// Adds a document or replaces the text of an existing URI.
// `uri` and `text` must not refer to data in `s`.
fn open(store mut* s, string uri, string text, i64 version) void {
    i64 found = find(s, uri);
    if (found >= 0) {
        u64 i = cast(found, u64);
        del(s->items[i].text);
        s->items[i].text = str.dup(text);
        s->items[i].version = version;
        return;
    }
    reserve(s);
    s->items[s->count].uri = str.dup(uri);
    s->items[s->count].text = str.dup(text);
    s->items[s->count].version = version;
    s->count += 1;
}

// Replaces an open document. Returns false and makes no change when the URI is absent.
// `text` must not refer to data in `s`.
fn update(store mut* s, string uri, string text, i64 version) bool {
    i64 found = find(s, uri);
    if (found < 0) {
        return false;
    }
    u64 i = cast(found, u64);
    // Delete before assignment because assignment over a unique value traps.
    del(s->items[i].text);
    s->items[i].text = str.dup(text);
    s->items[i].version = version;
    return true;
}

// Removes a document. Returns false when the URI is absent. Other documents keep their order.
fn close(store mut* s, string uri) bool {
    i64 found = find(s, uri);
    if (found < 0) {
        return false;
    }
    u64 mut i = cast(found, u64);
    del(s->items[i].uri);
    del(s->items[i].text);
    while (i + 1 < s->count) {
        s->items[i].uri = move(s->items[i + 1].uri);
        s->items[i].text = move(s->items[i + 1].text);
        s->items[i].version = s->items[i + 1].version;
        i += 1;
    }
    s->count -= 1;
    return true;
}

// Returns the document text, or empty text when the URI is absent.
// Use `is_open` to distinguish an absent document from an empty document.
fn text_of(store* s, string uri) string {
    i64 found = find(s, uri);
    if (found < 0) {
        return "";
    }
    return s->items[cast(found, u64)].text;
}

// The version of an open document, and -1 when the client has no such
// document open. The protocol allows a negative version, so a caller that
// must tell the two apart asks is_open.
fn version_of(store* s, string uri) i64 {
    i64 found = find(s, uri);
    if (found < 0) {
        return -1;
    }
    return s->items[cast(found, u64)].version;
}
