/// Reads and writes LSP frames and classifies JSON-RPC messages.
import lsp.json;
import lsp.text;
import std.io;
import std.str;
import std.strbuf;

// The default size of one read.
u64 RPC_CHUNK = 4096;

// The header limit prevents an unterminated header from growing without limit.
u64 RPC_MAX_HEADER = 8192;

// The longest body a frame may carry, which is lsp.json's own default: a
// message carries one source file at its largest.
u64 RPC_MAX_CONTENT = 16777216;

// The largest read size accepted by `set_chunk`.
u64 RPC_CHUNK_CEILING = 16777216;

// The largest body limit accepted by `set_max_content`.
u64 RPC_CONTENT_CEILING = 4294967295;

// The header field that gives the length of the body, and the one separator
// of the base protocol.
string CONTENT_LENGTH = "Content-Length";
string HEADER_END = "\r\n\r\n";
u64 HEADER_END_LEN = 4;
u64 LINE_END_LEN = 2;

// The base of the decimal number a header field carries.
u64 DECIMAL = 10;

// JSON-RPC and LSP error codes used by server handlers.
i64 ERROR_PARSE = -32700;
i64 ERROR_INVALID_REQUEST = -32600;
i64 ERROR_METHOD_NOT_FOUND = -32601;
i64 ERROR_INVALID_PARAMS = -32602;
i64 ERROR_INTERNAL = -32603;
i64 ERROR_SERVER_NOT_INITIALIZED = -32002;
i64 ERROR_REQUEST_CANCELLED = -32800;

// A request ID is absent, an integer, or a string.
enum id_kind {
    id_absent,
    id_int,
    id_str,
}

// The id of a request. `num` holds an id_int and `text` an id_str; `text` is
// a view into the document the id was read from.
struct msg_id {
    id_kind kind;
    i64 num;
    string text;
}

// `m_invalid` keeps any readable ID so the error response can name the request.
enum msg_kind {
    m_invalid,
    m_request,
    m_notification,
    m_response,
}

// One classified message. Responses have no method or parameters.
struct message {
    msg_kind kind;
    msg_id id;
    string method;
    u32 params;
    string error_msg;
}

// A framed connection. Call `create` before reading or writing.
struct conn {
    i32 in_fd;
    i32 out_fd;
    strbuf.str_buf in_buf;
    strbuf.str_buf out_buf;
    // Bytes used by the last frame. The next read drops them.
    u64 consumed;
    // Zero selects the default read size or body limit.
    u64 chunk;
    u64 max_content;
    bool eof;
    bool failed;
    string error_msg;
}

// A conn over the two descriptors, with the default chunk and cap.
fn create(i32 in_fd, i32 out_fd) conn {
    conn mut c = conn{};
    c.in_fd = in_fd;
    c.out_fd = out_fd;
    return c;
}

// Clears buffers and error state. The read size and body limit stay unchanged.
fn free(conn mut* c) void {
    strbuf.free(&c->in_buf);
    strbuf.free(&c->out_buf);
    c->consumed = 0;
    c->eof = false;
    c->failed = false;
    c->error_msg = "";
}

// The bytes one read asks for.
fn chunk_of(conn* c) u64 {
    if (c->chunk == 0) {
        return RPC_CHUNK;
    }
    return c->chunk;
}

// The longest body this conn accepts.
fn max_content(conn* c) u64 {
    if (c->max_content == 0) {
        return RPC_MAX_CONTENT;
    }
    return c->max_content;
}

// Sets the read size. Zero restores the default. A value above the ceiling causes a panic.
fn set_chunk(conn mut* c, u64 size) void {
    if (size > RPC_CHUNK_CEILING) {
        panic("rpc.set_chunk: above the ceiling");
    }
    c->chunk = size;
}

// Sets the body limit. Zero restores the default. A value above the ceiling causes a panic.
fn set_max_content(conn mut* c, u64 limit) void {
    if (limit > RPC_CONTENT_CEILING) {
        panic("rpc.set_max_content: above the ceiling");
    }
    c->max_content = limit;
}

// Whether the last read ended because the client closed the stream.
fn at_eof(conn* c) bool {
    return c->eof;
}

// Whether the conn met an error, and which rule it broke; the message is
// empty when it met none.
fn has_failed(conn* c) bool {
    return c->failed;
}

fn error_message(conn* c) string {
    return c->error_msg;
}

// Records the first rule a conn broke. A conn that failed reads no further
// frame, since it no longer knows where one begins.
fn fail(conn mut* c, string message) void {
    if (!c->failed) {
        c->failed = true;
        c->error_msg = message;
    }
}

// The bytes read and not yet consumed.
fn buffered(conn* c) u64 {
    return c->in_buf.len;
}

// Drops the last frame and keeps bytes already read for the next frame.
fn drop_consumed(conn mut* c) void {
    if (c->consumed == 0) {
        return;
    }
    u64 rest = c->in_buf.len - c->consumed;
    u64 mut i = 0;
    while (i < rest) {
        c->in_buf.data[i] = c->in_buf.data[c->consumed + i];
        i += 1;
    }
    strbuf.truncate(&c->in_buf, rest);
    c->consumed = 0;
}

// One read into the spare room of the read buffer. False at the end of the
// stream and on a read error, which has_failed tells apart.
fn fill(conn mut* c) bool {
    u64 size = chunk_of(c);
    strbuf.reserve(&c->in_buf, size);
    // Limit the read to `size`, even when the buffer has more spare capacity.
    u8 mut@ room = c->in_buf.data[c->in_buf.len..c->in_buf.len + size];
    i64 n = io.read(c->in_fd, room);
    if (n < 0) {
        fail(c, "the stream could not be read");
        return false;
    }
    if (n == 0) {
        c->eof = true;
        return false;
    }
    c->in_buf.len += cast(n, u64);
    return true;
}

// The offset just past the `\r\n\r\n` that ends the header block, or 0 when
// the buffer does not hold one yet. `from` is where to start looking, which
// the caller moves forward so that a header is scanned once.
fn header_end(conn* c, u64 mut* from) u64 {
    string buffered_text = strbuf.view(&c->in_buf);
    if (buffered_text.len >= LINE_END_LEN && buffered_text[0..LINE_END_LEN] == "\r\n") {
        // Stop at the first empty line, including an empty two-byte block.
        return LINE_END_LEN;
    }
    if (buffered_text.len < HEADER_END_LEN) {
        return 0;
    }
    u64 mut at = *from;
    u64 last = buffered_text.len - HEADER_END_LEN;
    while (at <= last) {
        if (buffered_text[at..at + HEADER_END_LEN] == HEADER_END) {
            return at + HEADER_END_LEN;
        }
        at += 1;
    }
    // The next scan starts where a terminator could still begin.
    *from = at;
    return 0;
}

// The value of a header field, without the spaces around it. The protocol
// writes one space after the colon; a client that writes none, or several, is
// read the same way.
fn trimmed(string s) string {
    u64 mut from = 0;
    while (from < s.len && (s[from] == ' ' || s[from] == '\t')) {
        from += 1;
    }
    u64 mut to = s.len;
    while (to > from && (s[to - 1] == ' ' || s[to - 1] == '\t')) {
        to -= 1;
    }
    return s[from..to];
}

// Whether `s` holds a byte at or below a space: the C0 controls, NUL and the
// tab among them, and the space itself. A field name may hold none of them.
// char is ordered by unsigned byte value
fn holds_space_or_control(string s) bool {
    u64 mut i = 0;
    while (i < s.len) {
        if (s[i] <= ' ') {
            return true;
        }
        i += 1;
    }
    return false;
}

// Reads the body length from a complete header block.
// Returns false and records an error for malformed or conflicting fields.
fn content_length(conn mut* c, u64 end, u64 mut* out) bool {
    string block = strbuf.view(&c->in_buf)[0..end];
    bool mut found = false;
    u64 mut at = 0;
    while (at + LINE_END_LEN <= block.len) {
        u64 mut stop = at;
        while (stop + LINE_END_LEN <= block.len
               && !(block[stop] == '\r' && block[stop + 1] == '\n')) {
            stop += 1;
        }
        if (stop == at) {
            // The empty line ends the block.
            break;
        }
        string line = block[at..stop];
        if (str.index_of(line, '\r') >= 0 || str.index_of(line, '\n') >= 0) {
            // Refuse bare line breaks. Another reader could split the same bytes differently.
            fail(c, "a header field holds a bare carriage return or line feed");
            return false;
        }
        i64 colon = str.index_of(line, ':');
        if (colon < 0) {
            fail(c, "a header field has no colon");
            return false;
        }
        string name = line[0..cast(colon, u64)];
        if (holds_space_or_control(name)) {
            // Do not trim field names. Trimming could change the frame boundary.
            fail(c, "a header field name holds a space or a control byte");
            return false;
        }
        string value = trimmed(line[cast(colon, u64) + 1..]);
        if (text.equal_no_case(name, CONTENT_LENGTH)) {
            u64 mut declared = 0;
            if (!str.parse_u64(value, DECIMAL, &declared)) {
                fail(c, "the Content-Length is not a number");
                return false;
            }
            if (found && declared != *out) {
                // Conflicting lengths make the next frame boundary unknown.
                fail(c, "the frame declares two lengths");
                return false;
            }
            *out = declared;
            found = true;
        }
        at = stop + LINE_END_LEN;
    }
    if (!found) {
        fail(c, "the frame has no Content-Length");
        return false;
    }
    return true;
}

// Reads the next frame body. Returns false at EOF or after a framing error.
fn read_frame(conn mut* c, string mut* out) bool {
    *out = "";
    drop_consumed(c);
    if (c->failed || c->eof) {
        return false;
    }
    u64 mut from = 0;
    u64 mut end = header_end(c, &from);
    while (end == 0) {
        if (buffered(c) > RPC_MAX_HEADER) {
            fail(c, "the header is too long");
            return false;
        }
        if (!fill(c)) {
            if (c->failed) {
                return false;
            }
            if (buffered(c) == 0) {
                // The client closed the stream between two frames, which is
                // the one end that is not an error.
                return false;
            }
            fail(c, "the stream ended inside a header");
            return false;
        }
        end = header_end(c, &from);
    }
    if (end > RPC_MAX_HEADER) {
        // Check the complete block because its terminator can cross the limit.
        fail(c, "the header is too long");
        return false;
    }
    u64 mut len = 0;
    if (!content_length(c, end, &len)) {
        return false;
    }
    if (len > max_content(c)) {
        fail(c, "the frame is too large");
        return false;
    }
    // The header and body limits keep this sum inside `u64`.
    u64 total = end + len;
    while (buffered(c) < total) {
        if (!fill(c)) {
            if (!c->failed) {
                fail(c, "the stream ended inside the body");
            }
            return false;
        }
    }
    *out = strbuf.view(&c->in_buf)[end..total];
    c->consumed = total;
    return true;
}

// Builds one frame and passes all bytes to `io.write_all`.
// Returns false and records an error when `io.write_all` fails.
fn write_frame(conn mut* c, string body) bool {
    strbuf.clear(&c->out_buf);
    strbuf.append(&c->out_buf, CONTENT_LENGTH);
    strbuf.append(&c->out_buf, ": ");
    strbuf.append_u64(&c->out_buf, body.len);
    strbuf.append(&c->out_buf, HEADER_END);
    strbuf.append(&c->out_buf, body);
    if (!io.write_all(c->out_fd, strbuf.bytes(&c->out_buf))) {
        fail(c, "the stream could not be written");
        return false;
    }
    return true;
}

// ---- the message -----------------------------------------------------------------

// Whether the two ids name one request. Two absent ids name none, so they are
// never the same: a cancel that carries no id cancels nothing.
fn same_id(msg_id a, msg_id b) bool {
    if (a.kind != b.kind) {
        return false;
    }
    if (a.kind == id_kind.id_int) {
        return a.num == b.num;
    }
    if (a.kind == id_kind.id_str) {
        return a.text == b.text;
    }
    return false;
}

// The id a message member carries, absent when the member is missing, null,
// or a value JSON-RPC does not allow there. `ok` is false in that last case,
// which is a message this module refuses.
fn id_of(json.doc* d, u32 v, bool mut* ok) msg_id {
    msg_id mut id = msg_id{};
    *ok = true;
    if (v == 0) {
        return id;
    }
    json.value_kind kind = json.kind_of(d, v);
    if (kind == json.value_kind.k_int) {
        id.kind = id_kind.id_int;
        id.num = json.int_of(d, v);
        return id;
    }
    if (kind == json.value_kind.k_string) {
        id.kind = id_kind.id_str;
        id.text = json.text_of(d, v);
        return id;
    }
    if (kind == json.value_kind.k_null) {
        // JSON-RPC 2.0 answers an unreadable request with a null id, and LSP
        // 3.17 forbids one on a request. A message that carries it names no
        // request, so it is read as a notification.
        return id;
    }
    *ok = false;
    return id;
}

// Reads the parsed document as a JSON-RPC message. The document must be one
// the caller parsed; a document that failed to parse has no root and is
// m_invalid. Every string of the record is a view into that document.
fn classify(json.doc* d, message mut* out) void {
    *out = message{};
    u32 root = json.root(d);
    if (root == 0 || json.kind_of(d, root) != json.value_kind.k_object) {
        // An array here is a JSON-RPC batch, which LSP does not use.
        out->error_msg = "a message is a JSON object";
        return;
    }
    // The id is read before every other rule, so that the answer to a message
    // this module refuses names the request the client asked about. JSON-RPC
    // 2.0 5 asks for a null id only where the id itself could not be read.
    bool mut ok = true;
    out->id = id_of(d, json.member_of(d, root, "id"), &ok);
    if (!ok) {
        out->error_msg = "an id is a number or a string";
        return;
    }
    u32 version = json.member_of(d, root, "jsonrpc");
    if (version == 0 || json.kind_of(d, version) != json.value_kind.k_string
        || json.text_of(d, version) != "2.0") {
        out->error_msg = "a message carries jsonrpc 2.0";
        return;
    }
    u32 method = json.member_of(d, root, "method");
    if (method != 0) {
        if (json.kind_of(d, method) != json.value_kind.k_string) {
            out->error_msg = "a method is a string";
            return;
        }
        out->method = json.text_of(d, method);
        out->params = json.member_of(d, root, "params");
        out->kind = msg_kind.m_notification;
        if (out->id.kind != id_kind.id_absent) {
            out->kind = msg_kind.m_request;
        }
        return;
    }
    if (json.member_of(d, root, "result") != 0 || json.member_of(d, root, "error") != 0) {
        // An answer to a request this server sent. It sends none yet, and a
        // response is never answered in any case (JSON-RPC 2.0 5).
        out->kind = msg_kind.m_response;
        return;
    }
    out->error_msg = "a message has a method, a result or an error";
}

// ---- the answers -----------------------------------------------------------------

// Writes an integer ID, a string ID, or null for an absent ID.
fn write_id(json.writer mut* w, msg_id id) void {
    if (id.kind == id_kind.id_int) {
        json.write_int(w, id.num);
        return;
    }
    if (id.kind == id_kind.id_str) {
        json.write_str(w, id.text);
        return;
    }
    json.write_null(w);
}

// Opens a successful response and leaves the writer where the result value
// goes. The caller writes exactly one value and then calls response_end.
fn response_begin(json.writer mut* w, msg_id id) void {
    json.write_object_begin(w);
    json.write_key(w, "jsonrpc");
    json.write_str(w, "2.0");
    json.write_key(w, "id");
    write_id(w, id);
    json.write_key(w, "result");
}

// Closes the object response_begin opened.
fn response_end(json.writer mut* w) void {
    json.write_object_end(w);
}

// Writes a complete error response. `message` is suitable for the client to display.
fn write_error(json.writer mut* w, msg_id id, i64 code, string message) void {
    json.write_object_begin(w);
    json.write_key(w, "jsonrpc");
    json.write_str(w, "2.0");
    json.write_key(w, "id");
    write_id(w, id);
    json.write_key(w, "error");
    json.write_object_begin(w);
    json.write_key(w, "code");
    json.write_int(w, code);
    json.write_key(w, "message");
    json.write_str(w, message);
    json.write_object_end(w);
    json.write_object_end(w);
}
