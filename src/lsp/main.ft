// fort-lsp: the entry file of the language server.
//
// The whole program is lsp.server over stdin and stdout, which is what the
// base protocol runs on (LSP 3.17). The exit status is the server's: 0 after
// an orderly shutdown and 1 otherwise.
//
// Nothing here or below it writes to stdout except rpc.write_frame. A print
// on that descriptor would stand between two frames and no client could read
// the stream again.
// D11.5
import lsp.server;
import std.io;

fn i32 main() {
    return server.serve(io.STDIN, io.STDOUT);
}
