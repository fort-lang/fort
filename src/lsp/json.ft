/// Reads and writes JSON documents for the language server.
/// The reader reports malformed input without a panic.
import flt;
import std.str;
import std.strbuf;

// The reader and writer refuse deeper nesting. This limit also bounds recursion.
u64 JSON_MAX_DEPTH = 64;

// The default input limit. `set_max_bytes` can replace it.
u64 JSON_MAX_BYTES = 16777216;

// The largest input limit. Node text offsets must fit in `u32`.
u64 JSON_BYTES_CEILING = 4294967295;

// The factor used in large-input arena bounds.
u64 JSON_ARENA_BOUND = 20;

// These values split a handle into a chunk index and a slot.
u64 NODE_CHUNK = 256;
u64 NODE_CHUNK_SHIFT = 8;
u64 NODE_CHUNK_MASK = 255;

u64 CHUNK_MIN_CAP = 4;

// Keep capacity guards against one exact maximum.
u64 U64_MAX = 18446744073709551615;

// The writer uses uppercase digits in `\u00XX` escapes.
string HEX_DIGITS = "0123456789ABCDEF";
u64 HEX_SHIFT = 4;
u64 HEX_MASK = 15;

// The bytes the escape rule names: `"` and `\`, which are escaped, and the
// three control bytes JSON spells out.
u64 QUOTE_BYTE = 34;
u64 BACKSLASH_BYTE = 92;
u64 NEWLINE_BYTE = 10;
u64 TAB_BYTE = 9;
u64 RETURN_BYTE = 13;

// The last control byte: a byte at or below it is escaped.
u64 CONTROL_MAX = 31;

// UTF-8 byte ranges from RFC 3629.
u64 ASCII_MAX = 127;
u64 UTF8_CONT_MIN = 128;
u64 UTF8_CONT_MAX = 191;
u64 UTF8_LEAD2_MIN = 194;
u64 UTF8_LEAD2_MAX = 223;
u64 UTF8_LEAD3_MIN = 224;
u64 UTF8_LEAD3_MAX = 239;
u64 UTF8_LEAD4_MIN = 240;
u64 UTF8_LEAD4_MAX = 244;
u64 UTF8_LEAD3_OVERLONG = 224;
u64 UTF8_LEAD3_SURROGATE = 237;
u64 UTF8_LEAD4_OVERLONG = 240;
u64 UTF8_LEAD4_HIGHEST = 244;
u64 UTF8_E0_MIN = 160;
u64 UTF8_ED_MAX = 159;
u64 UTF8_F0_MIN = 144;
u64 UTF8_F4_MAX = 143;

// The writer replaces invalid UTF-8 bytes with U+FFFD.
string REPLACEMENT = "\xEF\xBF\xBD";

// Values used to encode a decoded code point as UTF-8.
u64 UTF8_ONE_MAX = 127;
u64 UTF8_TWO_MAX = 2047;
u64 UTF8_THREE_MAX = 65535;
u64 UTF8_CONT_LEAD = 128;
u64 UTF8_TWO_LEAD = 192;
u64 UTF8_THREE_LEAD = 224;
u64 UTF8_FOUR_LEAD = 240;
u64 UTF8_CONT_BITS = 6;
u64 UTF8_CONT_VALUE_MASK = 63;

// Values used to join a UTF-16 surrogate pair.
u64 SURROGATE_HIGH_MIN = 55296;
u64 SURROGATE_HIGH_MAX = 56319;
u64 SURROGATE_LOW_MIN = 56320;
u64 SURROGATE_LOW_MAX = 57343;
u64 SURROGATE_SHIFT = 10;
u64 SURROGATE_BASE = 65536;

// The four hex digits of a \uXXXX escape and the base they are read in.
u64 ESCAPE_HEX_DIGITS = 4;
u64 HEX_BASE = 16;

// ---- the tree --------------------------------------------------------------------

// Handle 0 has kind `k_none` and represents no value.
enum value_kind {
    k_none,
    k_null,
    k_bool,
    k_int,
    k_float,
    k_string,
    k_array,
    k_object,
}

// One JSON value. Text fields are offsets into the document byte buffer.
// `first` and `next` link container children. Zero ends each child list.
struct node {
    value_kind kind;
    bool bval;
    u32 at;
    u32 len;
    u32 key_at;
    u32 key_len;
    u32 first;
    u32 next;
    u32 count;
}

// One chunk of `NODE_CHUNK` nodes.
struct node_chunk {
    node mut@ own slots;
}

// A parsed document. The first parsed value uses handle 1.
struct doc {
    node_chunk mut* own mut@ own chunks;
    u64 chunk_count;
    u64 count;
    strbuf.str_buf bytes;
    u32 root_node;
    bool failed;
    u64 error_at;
    string error_msg;
    // Zero selects `JSON_MAX_BYTES`. Clear and free keep this setting.
    u64 limit;
}

fn create() doc {
    return doc{};
}

// The cap on the length of a source this document parses. json.create leaves
// the default, JSON_MAX_BYTES.
fn max_bytes(doc* d) u64 {
    if (d->limit == 0) {
        return JSON_MAX_BYTES;
    }
    return d->limit;
}

// Sets the input limit. Zero restores the default.
// Panics when `limit` exceeds `JSON_BYTES_CEILING`.
fn set_max_bytes(doc mut* d, u64 limit) void {
    if (limit > JSON_BYTES_CEILING) {
        panic("json.set_max_bytes: above the ceiling");
    }
    d->limit = limit;
}

// Empties the document and releases its storage. A second call has no effect.
fn free(doc mut* d) void {
    u64 mut i = 0;
    while (i < d->chunk_count) {
        // `del` is shallow, so delete the slots before the chunk.
        node_chunk mut* own chunk = move(d->chunks[i]);
        del(chunk->slots);
        del(chunk);
        i += 1;
    }
    del(d->chunks);
    d->chunk_count = 0;
    strbuf.free(&d->bytes);
    reset(d);
}

// Empties the document and keeps storage for the next parse.
fn clear(doc mut* d) void {
    strbuf.clear(&d->bytes);
    reset(d);
}

// The state both free and clear leave: no nodes, no root, no error.
fn reset(doc mut* d) void {
    d->count = 0;
    d->root_node = 0;
    d->failed = false;
    d->error_at = 0;
    d->error_msg = "";
}

// Ensures the chunk vector holds one more chunk, doubling from CHUNK_MIN_CAP.
fn chunks_reserve(doc mut* d) void {
    if (d->chunk_count < d->chunks.len) {
        return;
    }
    u64 mut cap = CHUNK_MIN_CAP;
    if (d->chunks.len >= cap) {
        if (d->chunks.len > U64_MAX / 2) {
            panic("json.chunks_reserve: capacity overflow");
        }
        cap = d->chunks.len * 2;
    }
    node_chunk mut* own mut@ own bigger = new(node_chunk mut* own, cap);
    u64 mut i = 0;
    while (i < d->chunk_count) {
        bigger[i] = move(d->chunks[i]);
        i += 1;
    }
    del(d->chunks);
    d->chunks = move(bigger);
}

// Adds one chunk of NODE_CHUNK nodes at the end of the chunk vector.
fn add_chunk(doc mut* d) void {
    chunks_reserve(d);
    node_chunk mut* own chunk = new(node_chunk);
    chunk->slots = new(node, NODE_CHUNK);
    d->chunks[d->chunk_count] = move(chunk);
    d->chunk_count += 1;
}

// A zeroed node of `kind`, and its handle. Handle 0 is built first and is the
// absent node, which is why the reader's first value is handle 1.
fn new_node(doc mut* d, value_kind kind) u32 {
    u64 chunk = d->count >> NODE_CHUNK_SHIFT;
    if (chunk >= d->chunk_count) {
        add_chunk(d);
    }
    node mut* fresh = node_at(d, d->count);
    *fresh = node{};
    fresh->kind = kind;
    u32 handle = cast(d->count, u32);
    d->count += 1;
    return handle;
}

// The node at index `i` of the arena, a view of the chunk that owns
// it. The index must be below the nodes handed out.
fn node_at(doc mut* d, u64 i) node mut* {
    node_chunk mut* chunk = d->chunks[i >> NODE_CHUNK_SHIFT];
    return &chunk->slots[i & NODE_CHUNK_MASK];
}

// The same over a document nothing is writing, which every query uses.
fn node_of(doc* d, u32 v) node* {
    if (v == 0 || cast(v, u64) >= d->count) {
        panic("json.node_of: not a handle of this document");
    }
    node_chunk* chunk = d->chunks[cast(v, u64) >> NODE_CHUNK_SHIFT];
    return &chunk->slots[cast(v, u64) & NODE_CHUNK_MASK];
}

// ---- queries ---------------------------------------------------------------------

// The root value of the last parse, or 0 when no parse succeeded.
fn root(doc* d) u32 {
    return d->root_node;
}

// Whether `v` names a value of this document. Handle 0 names none.
fn has(doc* d, u32 v) bool {
    return v != 0 && cast(v, u64) < d->count;
}

// The kind of `v`; a handle this document did not hand out is a violated
// precondition and panics.
fn kind_of(doc* d, u32 v) value_kind {
    return node_of(d, v)->kind;
}

// The number of children of an array or an object; 0 for every other kind.
fn count_of(doc* d, u32 v) u64 {
    return cast(node_of(d, v)->count, u64);
}

// The first child of an array or an object, 0 when it is empty.
fn first_of(doc* d, u32 v) u32 {
    return node_of(d, v)->first;
}

// Returns the next sibling, or 0 at the end. Use this with `first_of` for one-pass iteration.
fn next_of(doc* d, u32 v) u32 {
    return node_of(d, v)->next;
}

// The child at `i` of an array or an object; an index at or past the child
// count is a violated precondition and panics. It costs one step per index,
// so it is the query of a small container.
fn at_of(doc* d, u32 v, u64 i) u32 {
    node* container = node_of(d, v);
    if (i >= cast(container->count, u64)) {
        panic("json.at_of: index out of range");
    }
    u32 mut child = container->first;
    u64 mut seen = 0;
    while (seen < i) {
        child = node_of(d, child)->next;
        seen += 1;
    }
    return child;
}

// Returns the first matching object member. Returns 0 for other kinds or no match.
fn member_of(doc* d, u32 v, string name) u32 {
    node* object = node_of(d, v);
    if (object->kind != value_kind.k_object) {
        return 0;
    }
    u32 mut child = object->first;
    while (child != 0) {
        node* member = node_of(d, child);
        if (slice(d, member->key_at, member->key_len) == name) {
            return child;
        }
        child = member->next;
    }
    return 0;
}

// Returns the member name, or empty text when `v` is not an object member.
fn key_of(doc* d, u32 v) string {
    node* member = node_of(d, v);
    return slice(d, member->key_at, member->key_len);
}

// The bytes of a string, with every escape decoded, or the source text of a
// number, verbatim. Every other kind is a violated precondition and panics.
fn text_of(doc* d, u32 v) string {
    node* n = node_of(d, v);
    if (n->kind != value_kind.k_string && n->kind != value_kind.k_int
        && n->kind != value_kind.k_float) {
        panic("json.text_of: not a string and not a number");
    }
    return slice(d, n->at, n->len);
}

// The value of a k_bool node; every other kind is a violated precondition and
// panics.
fn bool_of(doc* d, u32 v) bool {
    node* n = node_of(d, v);
    if (n->kind != value_kind.k_bool) {
        panic("json.bool_of: not a boolean");
    }
    return n->bval;
}

// Reads a k_int value from its text. Other kinds violate the precondition and
// cause a panic. Use float_of for k_float nodes.
fn int_of(doc* d, u32 v) i64 {
    node* n = node_of(d, v);
    if (n->kind != value_kind.k_int) {
        panic("json.int_of: not an integer");
    }
    i64 mut out = 0;
    if (!str.parse_i64(slice(d, n->at, n->len), &out)) {
        // The reader made this node k_int by reading its text with the same
        // function, so a failure here is the module contradicting itself.
        panic("json.int_of: the text is not an i64");
    }
    return out;
}

// Returns a number as binary64 bits. Integer and float nodes are valid.
// Overflow returns infinity. Underflow returns zero. Other kinds cause a panic.
fn float_of(doc* d, u32 v) u64 {
    node* n = node_of(d, v);
    if (n->kind != value_kind.k_int && n->kind != value_kind.k_float) {
        panic("json.float_of: not a number");
    }
    string written = slice(d, n->at, n->len);
    u64 mut sign = 0;
    u64 mut from = 0;
    if (written.len > 0 && written[0] == '-') {
        sign = F64_SIGN;
        from = 1;
    }
    u64 mut bits = 0;
    if (!flt.flt_parse(written[from..], &bits)) {
        // JSON permits this magnitude. Binary64 rounds it to infinity.
        return sign | F64_INFINITY;
    }
    return sign | bits;
}

// The sign bit of a binary64 and the bits of a positive infinity, which
// float_of answers for a magnitude no f64 holds.
u64 F64_SIGN = 0x8000000000000000;
u64 F64_INFINITY = 0x7ff0000000000000;

// The bytes at `at` for `len` of the document's buffer.
fn slice(doc* d, u32 at, u32 len) string {
    u64 from = cast(at, u64);
    return cast(strbuf.bytes(&d->bytes)[from..from + cast(len, u64)], string);
}

// The nodes the document has handed out, handle 0 included.
fn node_count(doc* d) u64 {
    return d->count;
}

// Returns requested storage bytes. Allocator headers are not included.
fn arena_bytes(doc* d) u64 {
    return d->chunk_count * (NODE_CHUNK * sizeof(node) + sizeof(node_chunk))
        + d->chunks.len * sizeof(node_chunk*) + strbuf.cap(&d->bytes);
}

// The offset of the byte the last parse failed at, 0-based; 0 when it did not
// fail.
fn error_offset(doc* d) u64 {
    return d->error_at;
}

// The rule the last parse broke, and the empty string when it broke none.
fn error_message(doc* d) string {
    return d->error_msg;
}

// ---- the reader ------------------------------------------------------------------

// State for one parse.
struct reader {
    doc mut* d;
    string src;
    u64 at;
    u64 depth;
}

// Replaces `d` with one JSON value. Returns false and leaves an empty tree on invalid input.
// `error_offset` and `error_message` describe the first error.
// `source` must not refer to storage in `d`.
fn parse(doc mut* d, string source) bool {
    clear(d);
    // Reserve handle 0 to represent an absent node.
    new_node(d, value_kind.k_none);
    if (source.len > max_bytes(d)) {
        // Report the first byte beyond the accepted limit.
        d->failed = true;
        d->error_at = max_bytes(d);
        d->error_msg = "the document is too large";
        return false;
    }
    // Decoded strings cannot exceed the source size. One reservation is sufficient.
    // Release a small buffer first because `strbuf` otherwise doubles its capacity.
    if (strbuf.cap(&d->bytes) < source.len) {
        strbuf.free(&d->bytes);
    }
    strbuf.reserve(&d->bytes, source.len);
    reader mut r = reader{d, source, 0, 0};
    u32 value = parse_value(&r);
    if (value == 0) {
        return false;
    }
    skip_space(&r);
    if (r.at < r.src.len) {
        fail(&r, r.at, "a document is one value");
        return false;
    }
    d->root_node = value;
    return true;
}

// Records the first rule a parse broke and answers the absent handle, so that
// a parse function returns fail(...) and its caller stops at 0.
fn fail(reader mut* r, u64 at, string message) u32 {
    if (!r->d->failed) {
        r->d->failed = true;
        r->d->error_at = at;
        r->d->error_msg = message;
    }
    return 0;
}

// The four bytes of JSON whitespace (RFC 8259 2).
fn skip_space(reader mut* r) void {
    while (r->at < r->src.len) {
        char c = r->src[r->at];
        if (c != ' ' && c != '\t' && c != '\n' && c != '\r') {
            return;
        }
        r->at += 1;
    }
}

// Whether the source holds `word` at the position the reader stands at.
fn at_word(reader* r, string word) bool {
    if (r->src.len - r->at < word.len) {
        return false;
    }
    return r->src[r->at..r->at + word.len] == word;
}

// One value, whatever its kind, with the whitespace before it skipped.
fn parse_value(reader mut* r) u32 {
    skip_space(r);
    if (r->at >= r->src.len) {
        return fail(r, r->at, "a value was expected");
    }
    char c = r->src[r->at];
    if (c == '{') {
        return parse_object(r);
    }
    if (c == '[') {
        return parse_array(r);
    }
    if (c == '"') {
        return parse_string_value(r);
    }
    if (c == '-' || str.is_digit(c)) {
        return parse_number(r);
    }
    if (at_word(r, "true") || at_word(r, "false")) {
        bool yes = r->src[r->at] == 't';
        u32 value = new_node(r->d, value_kind.k_bool);
        node_at(r->d, cast(value, u64))->bval = yes;
        if (yes) {
            r->at += 4;
        } else {
            r->at += 5;
        }
        return value;
    }
    if (at_word(r, "null")) {
        r->at += 4;
        return new_node(r->d, value_kind.k_null);
    }
    return fail(r, r->at, "a value was expected");
}

// A string as a value of its own.
fn parse_string_value(reader mut* r) u32 {
    u32 mut at = 0;
    u32 mut len = 0;
    if (!parse_string(r, &at, &len)) {
        return 0;
    }
    u32 value = new_node(r->d, value_kind.k_string);
    node mut* n = node_at(r->d, cast(value, u64));
    n->at = at;
    n->len = len;
    return value;
}

// An array, its elements threaded through `first` and `next`.
fn parse_array(reader mut* r) u32 {
    if (r->depth >= JSON_MAX_DEPTH) {
        return fail(r, r->at, "the nesting is too deep");
    }
    r->depth += 1;
    // The container is built before its elements, so its handle is below
    // theirs and the tree reads in document order.
    u32 array = new_node(r->d, value_kind.k_array);
    r->at += 1;
    skip_space(r);
    u32 mut last = 0;
    u32 mut count = 0;
    if (r->at < r->src.len && r->src[r->at] == ']') {
        r->at += 1;
        r->depth -= 1;
        return array;
    }
    while (true) {
        u32 element = parse_value(r);
        if (element == 0) {
            return 0;
        }
        if (last == 0) {
            node_at(r->d, cast(array, u64))->first = element;
        } else {
            node_at(r->d, cast(last, u64))->next = element;
        }
        last = element;
        count += 1;
        skip_space(r);
        if (r->at >= r->src.len) {
            return fail(r, r->at, "a ',' or a ']' was expected");
        }
        char c = r->src[r->at];
        if (c == ']') {
            r->at += 1;
            node_at(r->d, cast(array, u64))->count = count;
            r->depth -= 1;
            return array;
        }
        if (c != ',') {
            return fail(r, r->at, "a ',' or a ']' was expected");
        }
        r->at += 1;
    }
    return array;
}

// An object, its members threaded like the elements of an array and each one
// carrying its name.
fn parse_object(reader mut* r) u32 {
    if (r->depth >= JSON_MAX_DEPTH) {
        return fail(r, r->at, "the nesting is too deep");
    }
    r->depth += 1;
    u32 object = new_node(r->d, value_kind.k_object);
    r->at += 1;
    skip_space(r);
    u32 mut last = 0;
    u32 mut count = 0;
    if (r->at < r->src.len && r->src[r->at] == '}') {
        r->at += 1;
        r->depth -= 1;
        return object;
    }
    while (true) {
        skip_space(r);
        if (r->at >= r->src.len || r->src[r->at] != '"') {
            return fail(r, r->at, "a member name was expected");
        }
        u32 mut key_at = 0;
        u32 mut key_len = 0;
        if (!parse_string(r, &key_at, &key_len)) {
            return 0;
        }
        skip_space(r);
        if (r->at >= r->src.len || r->src[r->at] != ':') {
            return fail(r, r->at, "a ':' was expected");
        }
        r->at += 1;
        u32 value = parse_value(r);
        if (value == 0) {
            return 0;
        }
        node mut* member = node_at(r->d, cast(value, u64));
        member->key_at = key_at;
        member->key_len = key_len;
        if (last == 0) {
            node_at(r->d, cast(object, u64))->first = value;
        } else {
            node_at(r->d, cast(last, u64))->next = value;
        }
        last = value;
        count += 1;
        skip_space(r);
        if (r->at >= r->src.len) {
            return fail(r, r->at, "a ',' or a '}' was expected");
        }
        char c = r->src[r->at];
        if (c == '}') {
            r->at += 1;
            node_at(r->d, cast(object, u64))->count = count;
            r->depth -= 1;
            return object;
        }
        if (c != ',') {
            return fail(r, r->at, "a ',' or a '}' was expected");
        }
        r->at += 1;
    }
    return object;
}

// A number: the grammar of RFC 8259 6, no more and no less. No leading plus,
// no leading zero, at least one digit after a point and after an exponent, and
// no hexadecimal, no infinity and no NaN. The text is copied verbatim, and the
// kind says whether it is written as an integer whose value fits i64.
fn parse_number(reader mut* r) u32 {
    u64 start = r->at;
    if (r->src[r->at] == '-') {
        r->at += 1;
    }
    if (r->at >= r->src.len || !str.is_digit(r->src[r->at])) {
        return fail(r, r->at, "a digit was expected");
    }
    if (r->src[r->at] == '0') {
        r->at += 1;
        if (r->at < r->src.len && str.is_digit(r->src[r->at])) {
            return fail(r, r->at, "a number has no leading zero");
        }
    } else {
        skip_digits(r);
    }
    bool mut integral = true;
    if (r->at < r->src.len && r->src[r->at] == '.') {
        integral = false;
        r->at += 1;
        if (r->at >= r->src.len || !str.is_digit(r->src[r->at])) {
            return fail(r, r->at, "a fraction needs a digit");
        }
        skip_digits(r);
    }
    if (r->at < r->src.len && (r->src[r->at] == 'e' || r->src[r->at] == 'E')) {
        integral = false;
        r->at += 1;
        if (r->at < r->src.len && (r->src[r->at] == '+' || r->src[r->at] == '-')) {
            r->at += 1;
        }
        if (r->at >= r->src.len || !str.is_digit(r->src[r->at])) {
            return fail(r, r->at, "an exponent needs a digit");
        }
        skip_digits(r);
    }
    string written = r->src[start..r->at];
    i64 mut ignored = 0;
    value_kind mut kind = value_kind.k_float;
    if (integral && str.parse_i64(written, &ignored)) {
        kind = value_kind.k_int;
    }
    u32 at = keep(r->d, written);
    u32 value = new_node(r->d, kind);
    node mut* n = node_at(r->d, cast(value, u64));
    n->at = at;
    n->len = cast(written.len, u32);
    return value;
}

// Every digit from where the reader stands.
fn skip_digits(reader mut* r) void {
    while (r->at < r->src.len && str.is_digit(r->src[r->at])) {
        r->at += 1;
    }
}

// Appends `s` to the document's buffer and answers where it starts.
fn keep(doc mut* d, string s) u32 {
    u32 at = cast(d->bytes.len, u32);
    strbuf.append(&d->bytes, s);
    return at;
}

// A string from its opening quote, decoded into the document's buffer; *at and
// *len describe the decoded bytes. False on a rule the string breaks, with the
// error recorded and *at and *len unchanged.
fn parse_string(reader mut* r, u32 mut* at, u32 mut* len) bool {
    u64 start = r->d->bytes.len;
    // Every byte of the value is copied, so the quote is stepped over first.
    r->at += 1;
    while (true) {
        if (r->at >= r->src.len) {
            fail(r, r->at, "the string is not terminated");
            return false;
        }
        char c = r->src[r->at];
        u64 byte = cast(c, u64);
        if (c == '"') {
            r->at += 1;
            *at = cast(start, u32);
            *len = cast(r->d->bytes.len - start, u32);
            return true;
        }
        if (byte <= CONTROL_MAX) {
            fail(r, r->at, "a control byte in a string must be escaped");
            return false;
        }
        if (c == '\\') {
            if (!parse_escape(r)) {
                return false;
            }
            continue;
        }
        if (byte <= ASCII_MAX) {
            strbuf.push_byte(&r->d->bytes, cast(byte, u8));
            r->at += 1;
            continue;
        }
        u64 step = utf8_sequence_len(cast(r->src, u8@), r->at);
        if (step == 0) {
            fail(r, r->at, "a string must be valid UTF-8");
            return false;
        }
        strbuf.append(&r->d->bytes, r->src[r->at..r->at + step]);
        r->at += step;
    }
    return false;
}

// One escape, from its backslash: the eight one-byte escapes of RFC 8259 7 and
// \uXXXX, whose surrogate pair is decoded to one code point. The decoded bytes
// go into the document's buffer.
fn parse_escape(reader mut* r) bool {
    u64 mark = r->at;
    r->at += 1;
    if (r->at >= r->src.len) {
        fail(r, mark, "the string is not terminated");
        return false;
    }
    char c = r->src[r->at];
    r->at += 1;
    if (c == '"' || c == '\\' || c == '/') {
        strbuf.push(&r->d->bytes, c);
        return true;
    }
    if (c == 'b') {
        strbuf.push_byte(&r->d->bytes, 8);
        return true;
    }
    if (c == 'f') {
        strbuf.push_byte(&r->d->bytes, 12);
        return true;
    }
    if (c == 'n') {
        strbuf.push(&r->d->bytes, '\n');
        return true;
    }
    if (c == 'r') {
        strbuf.push(&r->d->bytes, '\r');
        return true;
    }
    if (c == 't') {
        strbuf.push(&r->d->bytes, '\t');
        return true;
    }
    if (c != 'u') {
        fail(r, mark, "the escape is not one of JSON's");
        return false;
    }
    u64 mut cp = 0;
    if (!parse_hex4(r, mark, &cp)) {
        return false;
    }
    if (cp >= SURROGATE_LOW_MIN && cp <= SURROGATE_LOW_MAX) {
        fail(r, mark, "a low surrogate must follow a high one");
        return false;
    }
    if (cp >= SURROGATE_HIGH_MIN && cp <= SURROGATE_HIGH_MAX) {
        u64 pair = r->at;
        if (r->at + 1 >= r->src.len || r->src[r->at] != '\\' || r->src[r->at + 1] != 'u') {
            fail(r, mark, "a high surrogate needs a low one");
            return false;
        }
        r->at += 2;
        u64 mut low = 0;
        if (!parse_hex4(r, pair, &low)) {
            return false;
        }
        if (low < SURROGATE_LOW_MIN || low > SURROGATE_LOW_MAX) {
            fail(r, pair, "a high surrogate needs a low one");
            return false;
        }
        cp = SURROGATE_BASE + ((cp - SURROGATE_HIGH_MIN) << SURROGATE_SHIFT)
            + (low - SURROGATE_LOW_MIN);
    }
    push_utf8(&r->d->bytes, cp);
    return true;
}

// The four hex digits of a \uXXXX escape, the reader standing on the first of
// them. `mark` is where the escape began, which is where the error is
// reported.
fn parse_hex4(reader mut* r, u64 mark, u64 mut* out) bool {
    if (r->src.len - r->at < ESCAPE_HEX_DIGITS) {
        fail(r, mark, "a \\u escape needs four hex digits");
        return false;
    }
    u64 mut value = 0;
    u64 mut i = 0;
    while (i < ESCAPE_HEX_DIGITS) {
        char c = r->src[r->at + i];
        if (!str.is_hex(c)) {
            fail(r, mark, "a \\u escape needs four hex digits");
            return false;
        }
        value = value * HEX_BASE + cast(str.digit_value(c), u64);
        i += 1;
    }
    r->at += ESCAPE_HEX_DIGITS;
    *out = value;
    return true;
}

// The UTF-8 bytes of one code point (RFC 3629). A surrogate never reaches
// here: parse_escape refuses a lone one and joins a pair before it calls.
fn push_utf8(strbuf.str_buf mut* b, u64 cp) void {
    if (cp <= UTF8_ONE_MAX) {
        strbuf.push_byte(b, cast(cp, u8));
        return;
    }
    if (cp <= UTF8_TWO_MAX) {
        strbuf.push_byte(b, cast(UTF8_TWO_LEAD | (cp >> UTF8_CONT_BITS), u8));
        push_cont(b, cp, 0);
        return;
    }
    if (cp <= UTF8_THREE_MAX) {
        strbuf.push_byte(b, cast(UTF8_THREE_LEAD | (cp >> (2 * UTF8_CONT_BITS)), u8));
        push_cont(b, cp, 1);
        push_cont(b, cp, 0);
        return;
    }
    strbuf.push_byte(b, cast(UTF8_FOUR_LEAD | (cp >> (3 * UTF8_CONT_BITS)), u8));
    push_cont(b, cp, 2);
    push_cont(b, cp, 1);
    push_cont(b, cp, 0);
}

// The continuation byte holding the `which`-th six bits of `cp`, counting from
// the lowest.
fn push_cont(strbuf.str_buf mut* b, u64 cp, u64 which) void {
    u64 bits = (cp >> (which * UTF8_CONT_BITS)) & UTF8_CONT_VALUE_MASK;
    strbuf.push_byte(b, cast(UTF8_CONT_LEAD | bits, u8));
}

// ---- the writer ------------------------------------------------------------------

// Writer state. `first[d]` records whether container `d` is empty.
// Call `write_init` before other writer functions.
struct writer {
    strbuf.str_buf mut* out;
    u64 depth;
    bool[JSON_MAX_DEPTH] first;
}

// Starts a writer without clearing `out`. Panics when `out` is null.
fn write_init(writer mut* w, strbuf.str_buf mut* out) void {
    if (out == null) {
        panic("json.write_init: no buffer");
    }
    w->out = out;
    w->depth = 0;
    u64 mut i = 0;
    while (i < JSON_MAX_DEPTH) {
        w->first[i] = true;
        i += 1;
    }
}

// Writes the comma that separates two members or elements of the container
// that is open now, and marks that container non-empty. At depth 0 the
// document is one value, so nothing separates it.
fn write_sep(writer mut* w) void {
    if (w->depth == 0) {
        return;
    }
    u64 level = w->depth - 1;
    if (w->first[level]) {
        w->first[level] = false;
    } else {
        strbuf.push(w->out, ',');
    }
}

// Opens a container after its separator: the new level starts empty.
fn write_begin(writer mut* w, char open) void {
    if (w->depth >= JSON_MAX_DEPTH) {
        panic("json: nesting too deep");
    }
    write_sep(w);
    strbuf.push(w->out, open);
    w->first[w->depth] = true;
    w->depth += 1;
}

fn write_end(writer mut* w, char close) void {
    if (w->depth == 0) {
        panic("json: no container is open");
    }
    w->depth -= 1;
    strbuf.push(w->out, close);
}

fn write_object_begin(writer mut* w) void {
    write_begin(w, '{');
}

fn write_object_end(writer mut* w) void {
    write_end(w, '}');
}

fn write_array_begin(writer mut* w) void {
    write_begin(w, '[');
}

fn write_array_end(writer mut* w) void {
    write_end(w, ']');
}

// Returns the RFC 3629 sequence length at `i`, or 0 for invalid UTF-8.
fn utf8_sequence_len(u8@ bytes, u64 i) u64 {
    u64 lead = cast(bytes[i], u64);
    u64 mut len = 0;
    u64 mut second_min = UTF8_CONT_MIN;
    u64 mut second_max = UTF8_CONT_MAX;
    if (lead >= UTF8_LEAD2_MIN && lead <= UTF8_LEAD2_MAX) {
        len = 2;
    } else if (lead >= UTF8_LEAD3_MIN && lead <= UTF8_LEAD3_MAX) {
        len = 3;
        if (lead == UTF8_LEAD3_OVERLONG) {
            second_min = UTF8_E0_MIN;
        }
        if (lead == UTF8_LEAD3_SURROGATE) {
            second_max = UTF8_ED_MAX;
        }
    } else if (lead >= UTF8_LEAD4_MIN && lead <= UTF8_LEAD4_MAX) {
        len = 4;
        if (lead == UTF8_LEAD4_OVERLONG) {
            second_min = UTF8_F0_MIN;
        }
        if (lead == UTF8_LEAD4_HIGHEST) {
            second_max = UTF8_F4_MAX;
        }
    } else {
        return 0;
    }
    if (bytes.len - i < len) {
        return 0;
    }
    u64 second = cast(bytes[i + 1], u64);
    if (second < second_min || second > second_max) {
        return 0;
    }
    u64 mut k = 2;
    while (k < len) {
        u64 cont = cast(bytes[i + k], u64);
        if (cont < UTF8_CONT_MIN || cont > UTF8_CONT_MAX) {
            return 0;
        }
        k += 1;
    }
    return len;
}

// Writes a JSON string. It preserves valid UTF-8 and replaces invalid bytes with U+FFFD.
fn write_quoted(writer mut* w, string s) void {
    u8@ bytes = cast(s, u8@);
    strbuf.push(w->out, '"');
    u64 mut i = 0;
    while (i < s.len) {
        u64 byte = cast(bytes[i], u64);
        u64 mut step = 1;
        if (byte == QUOTE_BYTE || byte == BACKSLASH_BYTE) {
            strbuf.push(w->out, '\\');
            strbuf.push_byte(w->out, cast(byte, u8));
        } else if (byte == NEWLINE_BYTE) {
            strbuf.append(w->out, "\\n");
        } else if (byte == TAB_BYTE) {
            strbuf.append(w->out, "\\t");
        } else if (byte == RETURN_BYTE) {
            strbuf.append(w->out, "\\r");
        } else if (byte <= CONTROL_MAX) {
            strbuf.append(w->out, "\\u00");
            strbuf.push(w->out, HEX_DIGITS[byte >> HEX_SHIFT]);
            strbuf.push(w->out, HEX_DIGITS[byte & HEX_MASK]);
        } else if (byte <= ASCII_MAX) {
            strbuf.push_byte(w->out, cast(byte, u8));
        } else {
            step = utf8_sequence_len(bytes, i);
            if (step == 0) {
                strbuf.append(w->out, REPLACEMENT);
                step = 1;
            } else {
                strbuf.append_bytes(w->out, bytes[i..i + step]);
            }
        }
        i += step;
    }
    strbuf.push(w->out, '"');
}

// Writes an object key. Panics when no container is open.
fn write_key(writer mut* w, string name) void {
    if (w->depth == 0) {
        panic("json.write_key: no object is open");
    }
    write_sep(w);
    write_quoted(w, name);
    strbuf.push(w->out, ':');
    w->first[w->depth - 1] = true;
}

// Writes a quoted string.
fn write_str(writer mut* w, string s) void {
    write_sep(w);
    write_quoted(w, s);
}

// Writes a number in decimal, `-` first for a negative one.
fn write_uint(writer mut* w, u64 v) void {
    write_sep(w);
    strbuf.append_u64(w->out, v);
}

fn write_int(writer mut* w, i64 v) void {
    write_sep(w);
    strbuf.append_i64(w->out, v);
}

// Writes a number from its text. `written` must be a JSON number.
// The function writes it without validation.
fn write_number(writer mut* w, string written) void {
    write_sep(w);
    strbuf.append(w->out, written);
}

// Writes `true` or `false`.
fn write_bool(writer mut* w, bool v) void {
    write_sep(w);
    if (v) {
        strbuf.append(w->out, "true");
    } else {
        strbuf.append(w->out, "false");
    }
}

// Writes `null`.
fn write_null(writer mut* w) void {
    write_sep(w);
    strbuf.append(w->out, "null");
}

// Writes `v` and its descendants. Numbers keep their source text.
fn write_value(writer mut* w, doc* d, u32 v) void {
    node* n = node_of(d, v);
    switch (n->kind) {
    case value_kind.k_null:
        write_null(w);
    case value_kind.k_bool:
        write_bool(w, n->bval);
    case value_kind.k_int, value_kind.k_float:
        write_number(w, slice(d, n->at, n->len));
    case value_kind.k_string:
        write_str(w, slice(d, n->at, n->len));
    case value_kind.k_array:
        write_array_begin(w);
        u32 mut child = n->first;
        while (child != 0) {
            write_value(w, d, child);
            child = node_of(d, child)->next;
        }
        write_array_end(w);
    case value_kind.k_object:
        write_object_begin(w);
        u32 mut member = n->first;
        while (member != 0) {
            node* m = node_of(d, member);
            write_key(w, slice(d, m->key_at, m->key_len));
            write_value(w, d, member);
            member = m->next;
        }
        write_object_end(w);
    case value_kind.k_none:
        panic("json.write_value: the absent value");
    }
}

// Writes the whole document, root and all. A document that did not parse is a
// violated precondition and panics.
fn write_document(writer mut* w, doc* d) void {
    if (d->root_node == 0) {
        panic("json.write_document: no document was parsed");
    }
    write_value(w, d, d->root_node);
}
