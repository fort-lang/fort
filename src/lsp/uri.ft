/// Converts absolute paths and local file URIs.
import lsp.text;
import std.str;
import std.strbuf;

// Use uppercase digits in percent escapes.
string HEX_DIGITS = "0123456789ABCDEF";
u64 HEX_SHIFT = 4;
u64 HEX_MASK = 15;

// The two hex digits an escape carries, and the base they are read in.
u64 ESCAPE_DIGITS = 2;
i64 HEX_BASE = 16;

// The scheme this module reads and writes, and the one authority it accepts
// beside the empty one.
string FILE_SCHEME = "file";
string LOCAL_HOST = "localhost";

// Whether the byte needs no escape: the unreserved set of RFC 3986 2.3.
fn is_unreserved(char c) bool {
    return str.is_alnum(c) || c == '-' || c == '.' || c == '_' || c == '~';
}

// Returns the escape at `%`, or -1 for invalid hex, missing digits, or NUL.
fn escape_value(string s, u64 at) i64 {
    if (s.len - at <= ESCAPE_DIGITS) {
        return -1;
    }
    i64 high = str.digit_value(s[at + 1]);
    i64 low = str.digit_value(s[at + 2]);
    if (high < 0 || high >= HEX_BASE || low < 0 || low >= HEX_BASE) {
        return -1;
    }
    i64 value = high * HEX_BASE + low;
    if (value == 0) {
        return -1;
    }
    return value;
}

// Writes a local file URI path into an emptied `out`.
// Returns false and leaves `out` empty when the URI cannot name a local file.
fn path_of(string uri, strbuf.str_buf mut* out) bool {
    strbuf.clear(out);
    i64 colon = str.index_of(uri, ':');
    if (colon < 0) {
        return false;
    }
    u64 at = cast(colon, u64);
    if (!text.equal_no_case(uri[0..at], FILE_SCHEME)) {
        return false;
    }
    u64 mut from = at + 1;
    if (uri.len - from >= 2 && uri[from] == '/' && uri[from + 1] == '/') {
        // An authority follows, and it runs to the `/` that starts the path.
        u64 mut host_end = from + 2;
        while (host_end < uri.len && uri[host_end] != '/') {
            host_end += 1;
        }
        string host = uri[from + 2..host_end];
        if (host.len != 0 && !text.equal_no_case(host, LOCAL_HOST)) {
            return false;
        }
        from = host_end;
    }
    if (from >= uri.len || uri[from] != '/') {
        // A file URI names an absolute path and nothing else.
        return false;
    }
    u64 mut i = from;
    while (i < uri.len) {
        char c = uri[i];
        if (c == '?' || c == '#') {
            // Refuse the whole URI instead of dropping a query or fragment.
            strbuf.clear(out);
            return false;
        }
        if (c == '%') {
            i64 value = escape_value(uri, i);
            if (value < 0) {
                strbuf.clear(out);
                return false;
            }
            strbuf.push_byte(out, cast(value, u8));
            i += ESCAPE_DIGITS + 1;
        } else {
            strbuf.push(out, c);
            i += 1;
        }
    }
    return true;
}

// Writes an absolute path as a file URI into an emptied `out`.
// Returns false and leaves `out` empty for a relative path.
fn of_path(string path, strbuf.str_buf mut* out) bool {
    strbuf.clear(out);
    if (path.len == 0 || path[0] != '/') {
        return false;
    }
    strbuf.append(out, FILE_SCHEME);
    strbuf.append(out, "://");
    u64 mut i = 0;
    while (i < path.len) {
        char c = path[i];
        if (is_unreserved(c) || c == '/') {
            strbuf.push(out, c);
        } else {
            u64 byte = cast(c, u64);
            strbuf.push(out, '%');
            strbuf.push(out, HEX_DIGITS[byte >> HEX_SHIFT]);
            strbuf.push(out, HEX_DIGITS[byte & HEX_MASK]);
        }
        i += 1;
    }
    return true;
}
