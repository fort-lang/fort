/// Parses one token vector into a syntax tree.
///
/// The parser recovers at statement, case, field, and declaration boundaries.
/// It keeps skipped regions as `k_error` nodes and continues through the file.
/// This parser accepts nested aggregate types, float literals, `$cfg`, and `$if`.
import ast;
import diag;
import lexer;
import prim;
import session;
import types;
import std.strbuf;

// Blocks, initializers, groups, unary operands, branches, and types share this depth limit.
u32 PARSE_MAX_DEPTH = 256;

// One `$if` chain has a bounded number of condition nodes. The bound keeps
// selection and every later tree walk within a fixed stack depth.
u32 COMPILE_IF_MAX_CONDITIONS = 256;

// The `for` forms the grammar distinguishes after `for (`.
i32 FOR_PLAIN = 0;
i32 FOR_RANGE = 1;
i32 FOR_DECL = 2;

// The binary precedence levels, loosest first; PREC_NONE is not a binary
// operator. `?:` sits below PREC_OR and is parsed on its own, since it is the one
// right-associative form.
i32 PREC_NONE = 0;
i32 PREC_OR = 1;       // ||
i32 PREC_AND = 2;      // &&
i32 PREC_BITOR = 3;    // |
i32 PREC_BITXOR = 4;   // ^
i32 PREC_BITAND = 5;   // &
i32 PREC_EQUALITY = 6; // == !=
i32 PREC_RELATION = 7; // < <= > >=
i32 PREC_SHIFT = 8;    // << >>
i32 PREC_ADD = 9;      // + - +% -%
i32 PREC_MUL = 10;     // * / % *%

// Long diagnostics that two sites use.
string MUT_BEFORE_ARRAY_ERROR =
    "the elements share the array's storage: write the mut after the length, as 'i32[4] mut'";
string ARRAY_OWN_ERROR =
    "an own never follows a fixed-array suffix: write it after the '*' or '@' it marks";
string REF_ARRAY_ERROR =
    "no array suffix follows a reference suffix: group the inner type or use a struct";

// The two diagnostics of an allocated type, which two sites each report.
string ALLOC_MUT_ERROR = "new allocates writable storage: remove the outermost 'mut'";
string ALLOC_OWN_ERROR = "inside new an own follows a '*' of the element type";

// Each recovery mode defines what ends a skip.
i32 RECOVER_STMT = 0;
i32 RECOVER_CASE = 1;
i32 RECOVER_FIELD = 2;
i32 RECOVER_DECL = 3;
i32 RECOVER_COMPILE_DECL = 4;

// State for one parser run.
struct parser {
    session.session mut* sess;
    string file;
    lexer.tok_vec* toks;
    u64 ntoks;
    u64 pos;
    ast.arena mut* arena;
    u32 depth; // open nested constructs
    u32 spec;  // running speculative parses; no diagnostic while > 0
    bool failed; // unwinding the construct a syntax error hit
    u64 fail_pos; // the cursor at the first error of the failed construct
    diag.loc last; // where the last reported error started, for the dedupe
    strbuf.str_buf msg; // the message under construction
}

// The state a speculative parse restores when it rewinds.
struct spec_state {
    u64 pos;
    u32 depth;
    bool failed;
}

// The `own` and `mut` written after one type element, with the position of the
// `mut` for the diagnostics that point at it.
struct markers {
    u32 flags;
    diag.loc mut_loc;
}

// ---- the cursor ----------------------------------------------------------------

fn cur(parser* p) lexer.token {
    return lexer.tokvec_at(p->toks, p->pos);
}

fn kind(parser* p) lexer.tok_kind {
    return lexer.tokvec_at(p->toks, p->pos).kind;
}

// The kind `n` tokens ahead; the end of the file repeats, so a lookahead
// never leaves the vector.
fn peek_kind(parser* p, u64 n) lexer.tok_kind {
    u64 i = p->pos + n;
    if (i >= p->ntoks) {
        return lexer.tok_kind.eof;
    }
    return lexer.tokvec_at(p->toks, i).kind;
}

// The range one token covers: no token spans lines, so it ends on its own
// line, one past its last byte.
fn tok_loc(parser* p, lexer.token t) diag.loc {
    return diag.loc_range(p->file, t.line, t.col, t.line, t.col + cast(t.len, u32));
}

fn here(parser* p) diag.loc {
    return tok_loc(p, cur(p));
}

// Consumes the current token; the end of the file is never consumed.
fn bump(parser mut* p) void {
    if (kind(p) != lexer.tok_kind.eof) {
        p->pos += 1;
    }
}

fn at(parser* p, lexer.tok_kind k) bool {
    return kind(p) == k;
}

// The empty range follows the last consumed token. It starts a node with no
// token of its own, such as the implicit block of a case body.
fn here_implicit(parser* p) diag.loc {
    if (p->pos == 0) {
        return diag.loc_make(p->file, cur(p).line, cur(p).col);
    }
    lexer.token t = lexer.tokvec_at(p->toks, p->pos - 1);
    return diag.loc_make(p->file, t.line, t.col + cast(t.len, u32));
}

// Ends `n` at the last consumed token. bump never consumes the end-of-file token.
// Each function ends the nodes that it creates.
// A function that returns a child node leaves that node's range unchanged.
// loc_extend never shrinks a range, so a growing construct keeps its widest end.
// A null node is a failed parse and passes through.
fn finish(parser* p, ast.node mut* n) ast.node mut* {
    if (n != null && p->pos > 0) {
        n->loc = diag.loc_extend(n->loc, tok_loc(p, lexer.tokvec_at(p->toks, p->pos - 1)));
    }
    return n;
}

// ---- diagnostics ---------------------------------------------------------------

// Whether two ranges begin at the same place; one parse reports one file, so
// the file of every range it builds is the same.
fn same_start(diag.loc a, diag.loc b) bool {
    return a.line == b.line && a.col == b.col;
}

// Reports `text` at `at_loc` and starts the failed construct's unwind.
// Later reports stay silent until recovery clears `failed`.
// The parser drops a repeated error at the same start position.
// It also stops after the shared diag.MAX_PER_FILE budget is spent.
// Parsing continues after that limit. A speculative parse reports nothing.
// The first error of a construct records the cursor. A speculation compares
// how far two readings of one statement get.
fn report(parser mut* p, diag.loc at_loc, string text) void {
    diag.sink mut* diags = session.diags(p->sess);
    u64 reported = diag.file_count(diags);
    if (p->spec == 0 && !p->failed && reported < diag.MAX_PER_FILE
        && !(reported > 0 && same_start(at_loc, p->last))) {
        diag.error(diags, at_loc, text);
        p->last = at_loc;
    }
    if (!p->failed) {
        p->fail_pos = p->pos;
    }
    p->failed = true;
}

fn error_at(parser mut* p, diag.loc at_loc, string text) void {
    report(p, at_loc, text);
}

fn error_here(parser mut* p, string text) void {
    diag.loc at_loc = here(p);
    report(p, at_loc, text);
}

// Empties the message buffer; the three below append to it, as the msg_*
// family of bootstrap0/src/diag.h does over an sb_t.
fn msg_begin(parser mut* p) void {
    strbuf.clear(&p->msg);
}

fn msg_str(parser mut* p, string text) void {
    strbuf.append(&p->msg, text);
}

// Appends a name between single quotes: 'name'.
fn msg_quote(parser mut* p, string name) void {
    strbuf.push(&p->msg, '\'');
    strbuf.append(&p->msg, name);
    strbuf.push(&p->msg, '\'');
}

fn msg_end(parser* p) string {
    return strbuf.view(&p->msg);
}

// Appends the current token as a diagnostic names it: a literal or an
// identifier by class and by text, everything else by its spelling.
fn msg_found(parser mut* p) void {
    lexer.token t = cur(p);
    msg_str(p, ", found ");
    if (t.kind == lexer.tok_kind.ident) {
        msg_str(p, "identifier ");
        msg_quote(p, t.text);
    } else if (t.kind == lexer.tok_kind.int_lit || t.kind == lexer.tok_kind.float_lit
               || t.kind == lexer.tok_kind.char_lit || t.kind == lexer.tok_kind.string_lit
               || t.kind == lexer.tok_kind.eof) {
        msg_str(p, lexer.tok_kind_name(t.kind));
    } else {
        msg_quote(p, lexer.tok_kind_name(t.kind));
    }
}

// `expected <what>, found <token>` at the current token.
fn error_expected(parser mut* p, string what) void {
    msg_begin(p);
    msg_str(p, "expected ");
    msg_str(p, what);
    msg_found(p);
    diag.loc at_loc = here(p);
    report(p, at_loc, msg_end(p));
}

// Consumes a token of kind `k`, or reports `expected <what>`.
fn expect(parser mut* p, lexer.tok_kind k, string what) bool {
    if (!at(p, k)) {
        error_expected(p, what);
        return false;
    }
    bump(p);
    return true;
}

// Records the current identifier as `n`'s name, with the range an editor jumps
// to for it, and consumes it.
fn take_name(parser mut* p, ast.node mut* n) void {
    n->name = cur(p).text;
    n->name_loc = here(p);
    bump(p);
}

// Consumes the identifier that names `n`, or reports `expected an
// identifier`.
fn expect_name(parser mut* p, ast.node mut* n) bool {
    if (!at(p, lexer.tok_kind.ident)) {
        error_expected(p, "an identifier");
        return false;
    }
    take_name(p, n);
    return true;
}

// Reports a feature that the C bootstrap does not support.
// A speculative parse skips this report so it can still determine the syntax shape.
fn unsupported(parser mut* p, diag.loc at_loc, string feature) bool {
    if (p->spec > 0) {
        return false;
    }
    msg_begin(p);
    msg_str(p, "not supported by the bootstrap compiler: ");
    msg_str(p, feature);
    report(p, at_loc, msg_end(p));
    return true;
}

// ---- nesting and speculation ---------------------------------------------------

// Enters a nested construct, or reports the nesting limit. It does not count
// on failure, so a caller that returns at once leaves the depth balanced.
fn enter(parser mut* p) bool {
    if (p->depth >= PARSE_MAX_DEPTH) {
        msg_begin(p);
        msg_str(p, "nesting deeper than ");
        strbuf.append_u64(&p->msg, cast(PARSE_MAX_DEPTH, u64));
        diag.loc at_loc = here(p);
        report(p, at_loc, msg_end(p));
        return false;
    }
    p->depth += 1;
    return true;
}

fn leave(parser mut* p) void {
    p->depth -= 1;
}

// Begins a speculative parse. The parser reports nothing until the rewind.
// The parse starts with `failed` clear and reads it to select a branch.
// spec_rewind restores the caller's failure state.
// Recovery points can speculate while `failed` is set.
// The first statement after a missing `{` can also speculate in that state.
fn spec_begin(parser mut* p) spec_state {
    spec_state s = spec_state{p->pos, p->depth, p->failed};
    p->failed = false;
    p->spec += 1;
    return s;
}

// Returns true when a failed speculative type parse reads an unbracketed marker.
// A marker follows its type element, and no expression starts with a marker.
// Thus, the parser treats this prefix as a declaration and reports the marker.
// This test is a heuristic. Expressions can contain types inside brackets.
// A marker in such a bracket can belong to the expression, so the test ignores it.
fn read_marker(parser* p, u64 start) bool {
    u32 mut depth = 0;
    u64 mut i = start;
    while (i <= p->pos && i < p->ntoks) {
        lexer.tok_kind k = lexer.tokvec_at(p->toks, i).kind;
        if (depth == 0 && (k == lexer.tok_kind.kw_mut || k == lexer.tok_kind.kw_own)) {
            return true;
        }
        if (k == lexer.tok_kind.lparen || k == lexer.tok_kind.lbracket
            || k == lexer.tok_kind.lbrace) {
            depth += 1;
        } else if ((k == lexer.tok_kind.rparen || k == lexer.tok_kind.rbracket
                    || k == lexer.tok_kind.rbrace)
                   && depth > 0) {
            depth -= 1;
        }
        i += 1;
    }
    return false;
}

// Restores the cursor, the depth and the failure state the speculation
// started from. Every speculation of this parser rewinds and the chosen
// branch parses the same tokens again, reporting this time.
fn spec_rewind(parser mut* p, spec_state s) void {
    p->pos = s.pos;
    p->depth = s.depth;
    p->failed = s.failed;
    p->spec -= 1;
}

// ---- types ------------------------------------------------------

fn node_at(parser mut* p, ast.ast_kind k, diag.loc at_loc) ast.node mut* {
    return ast.ast_new(p->arena, k, at_loc);
}

// The primitive a keyword names; `void` is a type kind of its own.
fn prim_of_token(lexer.tok_kind k, prim.prim_kind mut* out) bool {
    if (k == lexer.tok_kind.kw_i8) {
        *out = prim.prim_kind.prim_i8;
    } else if (k == lexer.tok_kind.kw_i16) {
        *out = prim.prim_kind.prim_i16;
    } else if (k == lexer.tok_kind.kw_i32) {
        *out = prim.prim_kind.prim_i32;
    } else if (k == lexer.tok_kind.kw_i64) {
        *out = prim.prim_kind.prim_i64;
    } else if (k == lexer.tok_kind.kw_u8) {
        *out = prim.prim_kind.prim_u8;
    } else if (k == lexer.tok_kind.kw_u16) {
        *out = prim.prim_kind.prim_u16;
    } else if (k == lexer.tok_kind.kw_u32) {
        *out = prim.prim_kind.prim_u32;
    } else if (k == lexer.tok_kind.kw_u64) {
        *out = prim.prim_kind.prim_u64;
    } else if (k == lexer.tok_kind.kw_f32) {
        *out = prim.prim_kind.prim_f32;
    } else if (k == lexer.tok_kind.kw_f64) {
        *out = prim.prim_kind.prim_f64;
    } else if (k == lexer.tok_kind.kw_bool) {
        *out = prim.prim_kind.prim_bool;
    } else if (k == lexer.tok_kind.kw_char) {
        *out = prim.prim_kind.prim_char;
    } else {
        return false;
    }
    return true;
}

// Whether `k` can open a base_type: a primitive, `string`, `void`, `fn` or a
// qualified name or grouped type.
fn starts_base_type(lexer.tok_kind k) bool {
    prim.prim_kind mut prim0 = prim.prim_kind.prim_void;
    return prim_of_token(k, &prim0) || k == lexer.tok_kind.kw_string
        || k == lexer.tok_kind.kw_void || k == lexer.tok_kind.kw_fn
        || k == lexer.tok_kind.ident || k == lexer.tok_kind.lparen;
}

// Nothing precedes the base type: every `mut` and `own` follows the type
// element it qualifies, so no type, declaration or statement begins with one.
fn check_no_leading_marker(parser mut* p) bool {
    if (at(p, lexer.tok_kind.kw_mut)) {
        error_here(p, "a mut never precedes the base type: write 'node mut* p' or 'node* mut p'");
        return false;
    }
    if (at(p, lexer.tok_kind.kw_own)) {
        error_here(p, "an own never precedes the base type: write 'node* own p' or 'string own s'");
        return false;
    }
    return true;
}

// Parses the `[own] [mut]` of one type position. Each storage level has exactly
// one position, so a doubled marker does not parse, and an `own` precedes the
// `mut` of its position. `own_error` is the message for a position that takes no
// `own`, or the empty string where one is legal. The C passes NULL there. No
// message is empty.
fn parse_markers(parser mut* p, markers mut* m, string own_error) bool {
    m->flags = 0;
    m->mut_loc = here(p);
    while (true) {
        if (at(p, lexer.tok_kind.kw_own)) {
            diag.loc at_loc = here(p);
            if ((m->flags & ast.FLAG_OWN) != 0) {
                error_at(p, at_loc, "an own appears once in a type position");
                return false;
            }
            if ((m->flags & ast.FLAG_MUT) != 0) {
                error_at(p, at_loc,
                         "an own precedes the mut of its position: write 'node* own mut p'");
                return false;
            }
            if (own_error.len != 0) {
                error_at(p, at_loc, own_error);
                return false;
            }
            m->flags |= ast.FLAG_OWN;
            bump(p);
        } else if (at(p, lexer.tok_kind.kw_mut)) {
            diag.loc at_loc = here(p);
            if ((m->flags & ast.FLAG_MUT) != 0) {
                error_at(p, at_loc, "a mut appears once in a type position");
                return false;
            }
            m->flags |= ast.FLAG_MUT;
            m->mut_loc = at_loc;
            bump(p);
        } else {
            return true;
        }
    }
    return true;
}

// A `mut` marks the storage of the element that it follows.
// Fixed-array elements share the array storage, so no `mut` precedes `[N]`.
fn check_mut_before_array(parser mut* p, markers* m) bool {
    if ((m->flags & ast.FLAG_MUT) != 0 && at(p, lexer.tok_kind.lbracket)) {
        error_at(p, m->mut_loc, MUT_BEFORE_ARRAY_ERROR);
        return false;
    }
    return true;
}

// fn_type = "fn" "(" [ type { "," type } ] ")" return_type, with the `fn`
// already parsed: the result comes last, as it does in a declaration.
fn parse_fn_type_params(parser mut* p, diag.loc at_loc) ast.node mut* {
    ast.node mut* n = node_at(p, ast.ast_kind.k_type_fn, at_loc);
    if (!expect(p, lexer.tok_kind.lparen, "'('")) {
        return null;
    }
    if (!at(p, lexer.tok_kind.rparen)) {
        while (true) {
            ast.node mut* param = parse_type(p, false);
            if (param == null) {
                return null;
            }
            ast.ast_push(n, param);
            if (!at(p, lexer.tok_kind.comma)) {
                break;
            }
            bump(p);
        }
    }
    if (!expect(p, lexer.tok_kind.rparen, "')'")) {
        return null;
    }
    n->a = parse_return_type(p);
    if (n->a == null) {
        return null;
    }
    return finish(p, n);
}

// return_type = type | "void" | "noreturn" | "(" return_type ")"; `void` and
// `noreturn` are base types of their own. A group passes the return position
// to the type inside it, so `(void)` and `(noreturn)` are return types too.
fn parse_return_type(parser mut* p) ast.node mut* {
    return parse_type(p, true);
}

fn parse_base_type(parser mut* p, bool allow_noreturn) ast.node mut* {
    diag.loc at_loc = here(p);
    if (at(p, lexer.tok_kind.lparen)) {
        bump(p);
        ast.node mut* inner = parse_type(p, allow_noreturn);
        if (inner == null || !expect(p, lexer.tok_kind.rparen, "')'")) {
            return null;
        }
        return inner;
    }
    prim.prim_kind mut prim0 = prim.prim_kind.prim_void;
    if (prim_of_token(kind(p), &prim0)) {
        ast.node mut* n = node_at(p, ast.ast_kind.k_type_prim, at_loc);
        n->op = cast(prim0, i32);
        bump(p);
        return finish(p, n);
    }
    if (at(p, lexer.tok_kind.kw_string)) {
        bump(p);
        return finish(p, node_at(p, ast.ast_kind.k_type_string, at_loc));
    }
    if (at(p, lexer.tok_kind.kw_void)) {
        bump(p);
        return finish(p, node_at(p, ast.ast_kind.k_type_void, at_loc));
    }
    if (at(p, lexer.tok_kind.kw_noreturn)) {
        if (!allow_noreturn) {
            error_expected(p, "a type");
            return null;
        }
        bump(p);
        return finish(p, node_at(p, ast.ast_kind.k_type_noreturn, at_loc));
    }
    if (at(p, lexer.tok_kind.kw_fn)) {
        bump(p);
        return parse_fn_type_params(p, at_loc);
    }
    if (at(p, lexer.tok_kind.ident)) {
        // Resolution decides whether the first part is a module.
        ast.node mut* n = node_at(p, ast.ast_kind.k_type_name, at_loc);
        take_name(p, n);
        if (at(p, lexer.tok_kind.dot) && peek_kind(p, 1) == lexer.tok_kind.ident) {
            diag.loc second = here(p);
            bump(p);
            ast.node mut* tail = node_at(p, ast.ast_kind.k_ident, second);
            take_name(p, tail);
            n->a = finish(p, tail);
        }
        return finish(p, n);
    }
    error_expected(p, "a type");
    return null;
}

// Returns the storage position inside a grouped type.
fn type_position(ast.node* base) ast.node* {
    ast.node* mut pos = base;
    while (pos->kind == ast.ast_kind.k_type) {
        if (ast.ast_len(pos) != 0) {
            return ast.ast_child(pos, ast.ast_len(pos) - 1);
        }
        if (pos->a->kind != ast.ast_kind.k_type) {
            return pos;
        }
        pos = pos->a;
    }
    return pos;
}

fn type_position_flags(ast.node* base) u32 {
    u32 mut flags = 0;
    ast.node* mut pos = base;
    while (pos->kind == ast.ast_kind.k_type) {
        if (ast.ast_len(pos) != 0) {
            return flags | ast.ast_child(pos, ast.ast_len(pos) - 1)->flags;
        }
        flags |= pos->flags;
        pos = pos->a;
    }
    return flags;
}

fn base_own_error(ast.node* base) string {
    if (base->kind == ast.ast_kind.k_type_string) {
        return "";
    }
    if (base->kind == ast.ast_kind.k_type) {
        ast.node* pos = type_position(base);
        if ((pos->kind == ast.ast_kind.k_type_suffix
             && cast(pos->op, types.suffix_kind) != types.suffix_kind.s_array)
            || (pos->kind == ast.ast_kind.k_type && pos->a->kind == ast.ast_kind.k_type_string)) {
            return "";
        }
    }
    return "an own marks a reference: write it after a '*' or an '@', or on a string";
}

// Groups do not reset the suffix limit of a complete written type.
fn type_suffix_count(ast.node* t) u64 {
    u64 mut count = 0;
    ast.node* mut cur = t;
    while (cur->kind == ast.ast_kind.k_type) {
        count += ast.ast_len(cur);
        cur = cur->a;
    }
    return count;
}

// Parentheses preserve the outer storage position and its existing markers.
fn check_group_markers(parser mut* p, ast.node* base) bool {
    u32 flags = type_position_flags(base);
    if (at(p, lexer.tok_kind.kw_mut) && (flags & ast.FLAG_MUT) != 0) {
        error_here(p, "a mut appears once in a type position");
        return false;
    }
    if (at(p, lexer.tok_kind.kw_own) && (flags & ast.FLAG_OWN) != 0) {
        error_here(p, "an own appears once in a type position");
        return false;
    }
    if (at(p, lexer.tok_kind.kw_own) && (flags & ast.FLAG_MUT) != 0) {
        error_here(p, "an own precedes the mut of its position: write 'node* own mut p'");
        return false;
    }
    return true;
}

// Adds one suffix to `t` and counts it against the nesting limit, which covers
// type suffixes.
fn push_suffix(parser mut* p, ast.node mut* t, ast.node mut* suffix) bool {
    if (type_suffix_count(t) >= cast(PARSE_MAX_DEPTH, u64)) {
        msg_begin(p);
        msg_str(p, "nesting deeper than ");
        strbuf.append_u64(&p->msg, cast(PARSE_MAX_DEPTH, u64));
        report(p, suffix->loc, msg_end(p));
        return false;
    }
    ast.ast_push(t, suffix);
    return true;
}

// A group of reference suffixes, `("*" | "@") [own] [mut]` each: they apply to
// everything to their left, so a group reads inside-out. `array_may_follow` is
// true for the group before the fixed-array group, where a `mut` on the last
// position would mark the array's elements.
fn parse_ref_suffixes(parser mut* p, ast.node mut* t, bool array_may_follow) bool {
    while (at(p, lexer.tok_kind.star) || at(p, lexer.tok_kind.at)) {
        diag.loc at_loc = here(p);
        ast.node mut* s = node_at(p, ast.ast_kind.k_type_suffix, at_loc);
        if (at(p, lexer.tok_kind.star)) {
            s->op = cast(types.suffix_kind.s_ptr, i32);
        } else {
            s->op = cast(types.suffix_kind.s_span, i32);
        }
        bump(p);
        markers mut m = markers{};
        if (!parse_markers(p, &m, "")) {
            return false;
        }
        s->flags = m.flags;
        finish(p, s);
        if (array_may_follow && !check_mut_before_array(p, &m)) {
            return false;
        }
        if (!push_suffix(p, t, s)) {
            return false;
        }
    }
    return true;
}

// The fixed-array group, `"[" const_expr "]" [mut]` each: the group reads
// outside-in like C declarators. `marked` is false for the dimensions of an array
// literal's type and of an allocated type, which the grammar writes without any
// marker.
fn parse_array_suffixes(parser mut* p, ast.node mut* t, bool marked) bool {
    while (at(p, lexer.tok_kind.lbracket)) {
        diag.loc at_loc = here(p);
        bump(p);
        if (!enter(p)) {
            return false;
        }
        ast.node mut* len = parse_expr(p);
        leave(p);
        if (len == null || !expect(p, lexer.tok_kind.rbracket, "']'")) {
            return false;
        }
        ast.node mut* s = node_at(p, ast.ast_kind.k_type_suffix, at_loc);
        s->op = cast(types.suffix_kind.s_array, i32);
        s->a = len;
        if (marked) {
            markers mut m = markers{};
            if (!parse_markers(p, &m, ARRAY_OWN_ERROR)) {
                return false;
            }
            s->flags = m.flags;
            if (!check_mut_before_array(p, &m)) {
                return false;
            }
        }
        finish(p, s);
        if (!push_suffix(p, t, s)) {
            return false;
        }
    }
    return true;
}

// Parses the suffixes of a type after its base type.
fn parse_type_after_base(parser mut* p, diag.loc at_loc, ast.node mut* base) ast.node mut* {
    ast.node mut* t = node_at(p, ast.ast_kind.k_type, at_loc);
    t->a = base;
    markers mut m = markers{};
    if (!check_group_markers(p, base) || !parse_markers(p, &m, base_own_error(base))) {
        return null;
    }
    t->flags = m.flags;
    if ((type_position_flags(base) & ast.FLAG_MUT) != 0) {
        m.flags |= ast.FLAG_MUT;
        m.mut_loc = type_position(base)->loc;
    }
    if (!check_mut_before_array(p, &m)) {
        return null;
    }
    if (!parse_ref_suffixes(p, t, true)) {
        return null;
    }
    if (!parse_array_suffixes(p, t, true)) {
        return null;
    }
    if (!parse_ref_suffixes(p, t, false)) {
        return null;
    }
    if (at(p, lexer.tok_kind.lbracket)) {
        error_here(p, REF_ARRAY_ERROR);
        return null;
    }
    return finish(p, t);
}

fn parse_type_inner(parser mut* p, bool allow_noreturn) ast.node mut* {
    if (!check_no_leading_marker(p)) {
        return null;
    }
    diag.loc at_loc = here(p);
    ast.node mut* base = parse_base_type(p, allow_noreturn);
    if (base == null) {
        return null;
    }
    return parse_type_after_base(p, at_loc, base);
}

fn parse_type(parser mut* p, bool allow_noreturn) ast.node mut* {
    if (!enter(p)) {
        return null;
    }
    ast.node mut* t = parse_type_inner(p, allow_noreturn);
    leave(p);
    return t;
}

// array_type = base_type { ref_suffix } "[" const_expr "]" { "[" const_expr "]"
// }: the type of an array literal. It has no base marker, dimension marker,
// or trailing reference suffix.
fn parse_array_type(parser mut* p) ast.node mut* {
    if (!enter(p)) {
        return null;
    }
    ast.node mut* mut t = null;
    diag.loc at_loc = here(p);
    ast.node mut* base = parse_base_type(p, false);
    if (base != null) {
        t = node_at(p, ast.ast_kind.k_type, at_loc);
        t->a = base;
        if (!parse_ref_suffixes(p, t, true) || !at(p, lexer.tok_kind.lbracket)) {
            if (!p->failed) {
                error_expected(p, "'[' of an array type");
            }
            t = null;
        } else if ((type_position_flags(base) & ast.FLAG_MUT) != 0) {
            error_at(p, base->loc, "mark the array after its length");
            t = null;
        } else if (!parse_array_suffixes(p, t, false)) {
            t = null;
        }
    }
    leave(p);
    return finish(p, t);
}

// An allocated type omits markers from the outermost position that `new` fills.
// Inside `new(...)`, `own` follows `*`, and a span uses a count instead of `@`.
fn check_alloc_end(parser mut* p) bool {
    if (at(p, lexer.tok_kind.kw_mut)) {
        error_here(p, ALLOC_MUT_ERROR);
        return false;
    }
    if (at(p, lexer.tok_kind.kw_own)) {
        error_here(p, ALLOC_OWN_ERROR);
        return false;
    }
    if (at(p, lexer.tok_kind.at)) {
        error_here(p, "a span suffix does not parse inside new: write new(T, n)");
        return false;
    }
    return true;
}

// A `mut` inside `new(...)` marks storage that `new` does not allocate.
// Thus, a `*` must follow that `mut` and create an outer position.
fn check_alloc_mut(parser mut* p, markers* m) bool {
    if ((m->flags & ast.FLAG_MUT) != 0 && !at(p, lexer.tok_kind.star)) {
        error_at(p, m->mut_loc, ALLOC_MUT_ERROR);
        return false;
    }
    return true;
}

// Groups do not permit spans inside an allocated element type. Inside `new(...)`,
// an own follows only a `*`, at every group depth. Thus, `(string) own`,
// `(string own)` and `(i32*) own` do not parse there, while `(i32* own)` does
// (D10.2).
fn check_alloc_group(parser mut* p, ast.node* base) bool {
    if (base->kind != ast.ast_kind.k_type) {
        return true;
    }
    if (ast.ast_is_own(base)) {
        error_at(p, base->loc, ALLOC_OWN_ERROR);
        return false;
    }
    if (!check_alloc_group(p, base->a)) {
        return false;
    }
    u64 mut i = 0;
    while (i < ast.ast_len(base)) {
        ast.node* s = ast.ast_child(base, i);
        if (cast(s->op, types.suffix_kind) == types.suffix_kind.s_span) {
            error_at(p, s->loc, "a span suffix does not parse inside new: write new(T, n)");
            return false;
        }
        i += 1;
    }
    return true;
}

// alloc_type = base_type [ "mut" ] { "*" [ "own" ] [ "mut" ] }
// { "[" const_expr "]" }, whose last `mut` position is empty.
fn parse_alloc_type(parser mut* p) ast.node mut* {
    if (!check_no_leading_marker(p)) {
        return null;
    }
    if (!enter(p)) {
        return null;
    }
    ast.node mut* mut t = null;
    diag.loc at_loc = here(p);
    ast.node mut* base = parse_base_type(p, false);
    if (base != null && check_alloc_group(p, base)) {
        t = node_at(p, ast.ast_kind.k_type, at_loc);
        t->a = base;
        markers mut m = markers{};
        if (!check_group_markers(p, base) || !parse_markers(p, &m, ALLOC_OWN_ERROR)) {
            t = null;
        } else {
            t->flags = m.flags;
            m.flags |= type_position_flags(base) & ast.FLAG_MUT;
            if (!check_mut_before_array(p, &m) || !check_alloc_mut(p, &m)) {
                t = null;
            }
        }
        while (t != null && at(p, lexer.tok_kind.star)) {
            diag.loc star = here(p);
            ast.node mut* s = node_at(p, ast.ast_kind.k_type_suffix, star);
            s->op = cast(types.suffix_kind.s_ptr, i32);
            bump(p);
            if (!parse_markers(p, &m, "")) {
                t = null;
                break;
            }
            s->flags = m.flags;
            finish(p, s);
            if (!check_mut_before_array(p, &m) || !check_alloc_mut(p, &m)
                || !push_suffix(p, t, s)) {
                t = null;
            }
        }
        if (t != null && (!parse_array_suffixes(p, t, false) || !check_alloc_end(p))) {
            t = null;
        }
    }
    leave(p);
    return finish(p, t);
}

// ---- expressions ------------------------------------------------

// The precedence of a binary operator, PREC_NONE when `k` is not one; higher
// binds tighter. All of them are left-associative.
fn binary_prec(lexer.tok_kind k) i32 {
    if (k == lexer.tok_kind.pipe_pipe) {
        return PREC_OR;
    }
    if (k == lexer.tok_kind.and_and) {
        return PREC_AND;
    }
    if (k == lexer.tok_kind.pipe) {
        return PREC_BITOR;
    }
    if (k == lexer.tok_kind.caret) {
        return PREC_BITXOR;
    }
    if (k == lexer.tok_kind.amp) {
        return PREC_BITAND;
    }
    if (k == lexer.tok_kind.eq || k == lexer.tok_kind.ne) {
        return PREC_EQUALITY;
    }
    if (k == lexer.tok_kind.lt || k == lexer.tok_kind.le || k == lexer.tok_kind.gt
        || k == lexer.tok_kind.ge) {
        return PREC_RELATION;
    }
    if (k == lexer.tok_kind.shl || k == lexer.tok_kind.shr) {
        return PREC_SHIFT;
    }
    if (k == lexer.tok_kind.plus || k == lexer.tok_kind.minus || k == lexer.tok_kind.plus_wrap
        || k == lexer.tok_kind.minus_wrap) {
        return PREC_ADD;
    }
    if (k == lexer.tok_kind.star || k == lexer.tok_kind.slash || k == lexer.tok_kind.percent
        || k == lexer.tok_kind.star_wrap) {
        return PREC_MUL;
    }
    return PREC_NONE;
}

fn is_assign_op(lexer.tok_kind k) bool {
    return k == lexer.tok_kind.assign || k == lexer.tok_kind.plus_assign
        || k == lexer.tok_kind.minus_assign || k == lexer.tok_kind.star_assign
        || k == lexer.tok_kind.slash_assign || k == lexer.tok_kind.percent_assign
        || k == lexer.tok_kind.plus_wrap_assign || k == lexer.tok_kind.minus_wrap_assign
        || k == lexer.tok_kind.star_wrap_assign || k == lexer.tok_kind.amp_assign
        || k == lexer.tok_kind.pipe_assign || k == lexer.tok_kind.caret_assign
        || k == lexer.tok_kind.shl_assign || k == lexer.tok_kind.shr_assign;
}

// A parenthesized expression: `(` expr `)`.
fn parse_paren_expr(parser mut* p) ast.node mut* {
    if (!expect(p, lexer.tok_kind.lparen, "'('")) {
        return null;
    }
    if (!enter(p)) {
        return null;
    }
    ast.node mut* e = parse_expr(p);
    leave(p);
    if (e == null || !expect(p, lexer.tok_kind.rparen, "')'")) {
        return null;
    }
    return e;
}

// cast_expr = "cast" "(" expr "," type ")".
fn parse_cast(parser mut* p) ast.node mut* {
    diag.loc at_loc = here(p);
    bump(p);
    if (!expect(p, lexer.tok_kind.lparen, "'('") || !enter(p)) {
        return null;
    }
    ast.node mut* n = node_at(p, ast.ast_kind.k_cast, at_loc);
    n->a = parse_expr(p);
    if (n->a != null && expect(p, lexer.tok_kind.comma, "','")) {
        n->b = parse_type(p, false);
    }
    leave(p);
    if (n->a == null || n->b == null || !expect(p, lexer.tok_kind.rparen, "')'")) {
        return null;
    }
    return finish(p, n);
}

// sizeof_expr = "sizeof" "(" type ")".
fn parse_sizeof(parser mut* p) ast.node mut* {
    diag.loc at_loc = here(p);
    bump(p);
    if (!expect(p, lexer.tok_kind.lparen, "'('") || !enter(p)) {
        return null;
    }
    ast.node mut* n = node_at(p, ast.ast_kind.k_sizeof, at_loc);
    n->a = parse_type(p, false);
    leave(p);
    if (n->a == null || !expect(p, lexer.tok_kind.rparen, "')'")) {
        return null;
    }
    return finish(p, n);
}

// new_expr = "new" "(" alloc_type [ "," expr ] ")": one `T` without a count, a
// span of `n` elements with one.
fn parse_new(parser mut* p) ast.node mut* {
    diag.loc at_loc = here(p);
    bump(p);
    if (!expect(p, lexer.tok_kind.lparen, "'('") || !enter(p)) {
        return null;
    }
    ast.node mut* n = node_at(p, ast.ast_kind.k_new, at_loc);
    n->a = parse_alloc_type(p);
    bool mut ok = n->a != null;
    if (ok && at(p, lexer.tok_kind.comma)) {
        bump(p);
        n->b = parse_expr(p);
        ok = n->b != null;
    }
    leave(p);
    if (!ok || !expect(p, lexer.tok_kind.rparen, "')'")) {
        return null;
    }
    return finish(p, n);
}

// A struct literal starts with an identifier, an optional `. identifier`, and `{`.
fn starts_struct_literal(parser* p) bool {
    if (peek_kind(p, 1) == lexer.tok_kind.lbrace) {
        return true;
    }
    return peek_kind(p, 1) == lexer.tok_kind.dot && peek_kind(p, 2) == lexer.tok_kind.ident
        && peek_kind(p, 3) == lexer.tok_kind.lbrace;
}

fn parse_struct_literal(parser mut* p) ast.node mut* {
    diag.loc at_loc = here(p);
    ast.node mut* name = parse_base_type(p, false);
    if (name == null) {
        return null;
    }
    ast.node mut* n = node_at(p, ast.ast_kind.k_struct_lit, at_loc);
    n->a = name;
    n->b = parse_brace_init(p);
    if (n->b == null) {
        return null;
    }
    return finish(p, n);
}

// An `array_type` followed by `{` starts an array literal. Speculation only decides; the
// literal is parsed again, loudly, after the rewind.
fn speculate_array_literal(parser mut* p) bool {
    spec_state s = spec_begin(p);
    ast.node mut* t = parse_array_type(p);
    bool literal = t != null && !p->failed && at(p, lexer.tok_kind.lbrace);
    spec_rewind(p, s);
    return literal;
}

fn parse_array_literal(parser mut* p) ast.node mut* {
    diag.loc at_loc = here(p);
    ast.node mut* n = node_at(p, ast.ast_kind.k_array_lit, at_loc);
    n->a = parse_array_type(p);
    if (n->a == null) {
        return null;
    }
    n->b = parse_brace_init(p);
    if (n->b == null) {
        return null;
    }
    return finish(p, n);
}

fn parse_primary(parser mut* p) ast.node mut* {
    diag.loc at_loc = here(p);
    ast.node mut* mut n = null;
    if (at(p, lexer.tok_kind.int_lit)) {
        n = node_at(p, ast.ast_kind.k_int, at_loc);
        n->ival = cur(p).ival;
        bump(p);
        return finish(p, n);
    }
    if (at(p, lexer.tok_kind.float_lit)) {
        n = node_at(p, ast.ast_kind.k_float, at_loc);
        n->name = cur(p).text;
        bump(p);
        return finish(p, n);
    }
    if (at(p, lexer.tok_kind.char_lit)) {
        n = node_at(p, ast.ast_kind.k_char, at_loc);
        n->ival = cur(p).ival;
        bump(p);
        return finish(p, n);
    }
    if (at(p, lexer.tok_kind.string_lit)) {
        n = node_at(p, ast.ast_kind.k_string, at_loc);
        n->name = cur(p).text;
        bump(p);
        return finish(p, n);
    }
    if (at(p, lexer.tok_kind.dollar_cfg)) {
        n = node_at(p, ast.ast_kind.k_cfg, at_loc);
        bump(p);
        if (!expect(p, lexer.tok_kind.lparen, "'('") || !enter(p)) {
            return null;
        }
        if (!at(p, lexer.tok_kind.ident)) {
            error_expected(p, "a configuration key");
            leave(p);
            return null;
        }
        take_name(p, n);
        leave(p);
        if (!expect(p, lexer.tok_kind.rparen, "')'")) {
            return null;
        }
        return finish(p, n);
    }
    if (at(p, lexer.tok_kind.kw_true) || at(p, lexer.tok_kind.kw_false)) {
        n = node_at(p, ast.ast_kind.k_bool, at_loc);
        if (at(p, lexer.tok_kind.kw_true)) {
            n->ival = 1;
        } else {
            n->ival = 0;
        }
        bump(p);
        return finish(p, n);
    }
    if (at(p, lexer.tok_kind.kw_null)) {
        bump(p);
        return finish(p, node_at(p, ast.ast_kind.k_null, at_loc));
    }
    if (at(p, lexer.tok_kind.lparen)) {
        if (speculate_array_literal(p)) {
            return parse_array_literal(p);
        }
        return parse_paren_expr(p);
    }
    if (at(p, lexer.tok_kind.kw_cast)) {
        return parse_cast(p);
    }
    if (at(p, lexer.tok_kind.kw_sizeof)) {
        return parse_sizeof(p);
    }
    if (at(p, lexer.tok_kind.kw_new)) {
        return parse_new(p);
    }
    if (at(p, lexer.tok_kind.ident)) {
        if (starts_struct_literal(p)) {
            return parse_struct_literal(p);
        }
        if (speculate_array_literal(p)) {
            return parse_array_literal(p);
        }
        n = node_at(p, ast.ast_kind.k_ident, at_loc);
        take_name(p, n);
        return finish(p, n);
    }
    if (starts_base_type(kind(p)) && speculate_array_literal(p)) {
        return parse_array_literal(p);
    }
    error_expected(p, "an expression");
    return null;
}

// postfix = call | index | span | "." identifier | "->" identifier.
fn parse_call(parser mut* p, ast.node mut* callee) ast.node mut* {
    diag.loc at_loc = here(p);
    ast.node mut* n = node_at(p, ast.ast_kind.k_call, at_loc);
    n->a = callee;
    bump(p);
    if (!enter(p)) {
        return null;
    }
    bool mut ok = true;
    if (!at(p, lexer.tok_kind.rparen)) {
        while (true) {
            ast.node mut* arg = parse_expr(p);
            if (arg == null) {
                ok = false;
                break;
            }
            ast.ast_push(n, arg);
            if (!at(p, lexer.tok_kind.comma)) {
                break;
            }
            bump(p);
        }
    }
    leave(p);
    if (!ok || !expect(p, lexer.tok_kind.rparen, "')'")) {
        return null;
    }
    return finish(p, n);
}

// index and the four span forms, told apart by the `..`.
fn parse_index_or_span(parser mut* p, ast.node mut* operand) ast.node mut* {
    diag.loc at_loc = here(p);
    bump(p);
    if (!enter(p)) {
        return null;
    }
    ast.node mut* mut n = null;
    ast.node mut* mut low = null;
    bool mut ok = true;
    if (!at(p, lexer.tok_kind.dot_dot)) {
        low = parse_expr(p);
        ok = low != null;
    }
    if (ok && at(p, lexer.tok_kind.dot_dot)) {
        bump(p);
        n = node_at(p, ast.ast_kind.k_span, at_loc);
        n->a = operand;
        n->b = low;
        if (!at(p, lexer.tok_kind.rbracket)) {
            n->c = parse_expr(p);
            ok = n->c != null;
        }
    } else if (ok) {
        n = node_at(p, ast.ast_kind.k_index, at_loc);
        n->a = operand;
        n->b = low;
    }
    leave(p);
    if (!ok || !expect(p, lexer.tok_kind.rbracket, "']'")) {
        return null;
    }
    return finish(p, n);
}

// `.f` and `->f`, the second required through a pointer.
fn parse_member(parser mut* p, ast.node mut* operand) ast.node mut* {
    diag.loc at_loc = here(p);
    bool arrow = at(p, lexer.tok_kind.arrow);
    bump(p);
    ast.node mut* mut n = null;
    if (arrow) {
        n = node_at(p, ast.ast_kind.k_arrow, at_loc);
    } else {
        n = node_at(p, ast.ast_kind.k_field, at_loc);
    }
    n->a = operand;
    if (!expect_name(p, n)) {
        return null;
    }
    return finish(p, n);
}

fn parse_postfix(parser mut* p) ast.node mut* {
    ast.node mut* mut e = parse_primary(p);
    while (e != null) {
        if (at(p, lexer.tok_kind.lparen)) {
            e = parse_call(p, e);
        } else if (at(p, lexer.tok_kind.lbracket)) {
            e = parse_index_or_span(p, e);
        } else if (at(p, lexer.tok_kind.dot) || at(p, lexer.tok_kind.arrow)) {
            e = parse_member(p, e);
        } else {
            return e;
        }
    }
    return null;
}

// unary_expr = ( "!" | "~" | "-" | "*" | "&" ) unary_expr | postfix_expr.
fn parse_unary(parser mut* p) ast.node mut* {
    lexer.tok_kind k = kind(p);
    if (k != lexer.tok_kind.bang && k != lexer.tok_kind.tilde && k != lexer.tok_kind.minus
        && k != lexer.tok_kind.star && k != lexer.tok_kind.amp) {
        return parse_postfix(p);
    }
    diag.loc at_loc = here(p);
    bump(p);
    if (!enter(p)) {
        return null;
    }
    ast.node mut* operand = parse_unary(p);
    leave(p);
    if (operand == null) {
        return null;
    }
    ast.node mut* n = node_at(p, ast.ast_kind.k_unary, at_loc);
    n->op = cast(k, i32);
    n->a = operand;
    return finish(p, n);
}

// The binary levels, climbed by precedence; every level is left-associative,
// so the right operand starts one level up.
fn parse_binary(parser mut* p, i32 min_prec) ast.node mut* {
    ast.node mut* mut left = parse_unary(p);
    while (left != null) {
        lexer.tok_kind k = kind(p);
        i32 prec = binary_prec(k);
        if (prec == PREC_NONE || prec < min_prec) {
            return left;
        }
        diag.loc at_loc = here(p);
        bump(p);
        ast.node mut* right = parse_binary(p, prec + 1);
        if (right == null) {
            return null;
        }
        ast.node mut* n = node_at(p, ast.ast_kind.k_binary, at_loc);
        n->op = cast(k, i32);
        n->a = left;
        n->b = right;
        left = finish(p, n);
    }
    return null;
}

// ternary_expr = or_expr [ "?" expr ":" ternary_expr ], right-associative.
// Bootstrap-0 parses the form and reports that its subset does not support `?:`.
// The self-hosted parser accepts the same tree without that report.
fn parse_ternary(parser mut* p) ast.node mut* {
    ast.node mut* cond = parse_binary(p, PREC_OR);
    if (cond == null || !at(p, lexer.tok_kind.question)) {
        return cond;
    }
    diag.loc at_loc = here(p);
    bump(p);
    if (!enter(p)) {
        return null;
    }
    ast.node mut* n = node_at(p, ast.ast_kind.k_ternary, at_loc);
    n->a = cond;
    n->b = parse_expr(p);
    if (n->b != null && expect(p, lexer.tok_kind.colon, "':'")) {
        n->c = parse_ternary(p);
    }
    leave(p);
    if (n->b == null || n->c == null) {
        return null;
    }
    return finish(p, n);
}

fn parse_expr(parser mut* p) ast.node mut* {
    return parse_ternary(p);
}

// brace_init = "{" [ init_list ] "}", positional or designated and never both,
// with a trailing comma allowed.
fn parse_brace_init(parser mut* p) ast.node mut* {
    diag.loc at_loc = here(p);
    if (!expect(p, lexer.tok_kind.lbrace, "'{'") || !enter(p)) {
        return null;
    }
    ast.node mut* n = node_at(p, ast.ast_kind.k_brace_init, at_loc);
    bool mut ok = true;
    if (!at(p, lexer.tok_kind.rbrace)) {
        bool designated = at(p, lexer.tok_kind.dot);
        if (designated) {
            n->flags = ast.FLAG_DESIGNATED;
        }
        while (ok) {
            if (at(p, lexer.tok_kind.dot) != designated) {
                error_here(p, "positional and designated initializers do not mix");
                ok = false;
                break;
            }
            ast.node mut* mut member = null;
            if (designated) {
                diag.loc at_dot = here(p);
                member = node_at(p, ast.ast_kind.k_designator, at_dot);
                bump(p);
                ok = expect_name(p, member) && expect(p, lexer.tok_kind.assign, "'='");
                if (ok) {
                    member->a = parse_initializer(p);
                    ok = member->a != null;
                }
                if (ok) {
                    finish(p, member);
                }
            } else {
                member = parse_initializer(p);
                ok = member != null;
            }
            if (!ok) {
                break;
            }
            ast.ast_push(n, member);
            if (!at(p, lexer.tok_kind.comma)) {
                break;
            }
            bump(p);
            if (at(p, lexer.tok_kind.rbrace)) {
                break;
            }
        }
    }
    leave(p);
    if (!ok || !expect(p, lexer.tok_kind.rbrace, "'}'")) {
        return null;
    }
    return finish(p, n);
}

// initializer = expr | brace_init.
fn parse_initializer(parser mut* p) ast.node mut* {
    if (at(p, lexer.tok_kind.lbrace)) {
        return parse_brace_init(p);
    }
    return parse_expr(p);
}

// ---- recovery -------------------------------------------------

// A recovery skip stops before a keyword that can start the next statement.
fn starts_statement(lexer.tok_kind k) bool {
    return k == lexer.tok_kind.kw_if || k == lexer.tok_kind.kw_while
        || k == lexer.tok_kind.kw_for || k == lexer.tok_kind.kw_switch
        || k == lexer.tok_kind.kw_defer || k == lexer.tok_kind.kw_return
        || k == lexer.tok_kind.kw_break || k == lexer.tok_kind.kw_continue
        || k == lexer.tok_kind.kw_do || k == lexer.tok_kind.dollar_if;
}

// The keywords that begin a case clause. Neither appears in a statement or an
// expression. So a skip inside a switch stops before one rather than
// swallowing the clause that follows the broken one.
fn starts_case(lexer.tok_kind k) bool {
    return k == lexer.tok_kind.kw_case || k == lexer.tok_kind.kw_default;
}

// Returns true when the current token starts a top-level declaration.
// `struct`, `enum`, `extern`, and `import` always start declarations.
// A `fn` starts one when a name and `(` follow it.
// A function type has `(` directly after `fn` instead.
// Declaration starts also end an open body that has no `}`.
// Thus, one missing `}` produces one diagnostic.
fn at_decl_start(parser mut* p) bool {
    lexer.tok_kind k = kind(p);
    if (k == lexer.tok_kind.kw_struct || k == lexer.tok_kind.kw_enum
        || k == lexer.tok_kind.kw_extern || k == lexer.tok_kind.kw_import) {
        return true;
    }
    if (k != lexer.tok_kind.kw_fn) {
        return false;
    }
    return peek_kind(p, 1) == lexer.tok_kind.ident
        && peek_kind(p, 2) == lexer.tok_kind.lparen;
}

// Counts unmatched `(` and `[` in the failed construct.
// Recovery then finds a boundary at the construct's own group level.
// Thus, a `for` header semicolon or argument comma is not a boundary.
// This function does not count braces because their intended scope is ambiguous.
// Recovery counts only the braces that it opens during its skip.
// It leaves other closing braces for their enclosing bodies.
fn count_open_groups(parser* p, u64 start) u32 {
    u32 mut groups = 0;
    u64 mut i = start;
    while (i < p->pos) {
        lexer.tok_kind k = lexer.tokvec_at(p->toks, i).kind;
        if (k == lexer.tok_kind.lparen || k == lexer.tok_kind.lbracket) {
            groups += 1;
        } else if ((k == lexer.tok_kind.rparen || k == lexer.tok_kind.rbracket) && groups > 0) {
            groups -= 1;
        }
        i += 1;
    }
    return groups;
}

// Whether the `{` at the cursor opens a brace literal. The token before it
// decides. A `brace_init` follows `=` or `,`, and a broken argument or index
// puts one after `(` or `[`. A `struct_literal` puts a name before the
// `{`, and the token before that name is `=` or `,`. A block follows `)`, a
// keyword, a `;`, a `}` or a type. In a condition that lost its `)`, a block
// follows the last token of the condition: `if (n < 3 {` and `if (ok {`.
fn opens_literal(parser* p) bool {
    // The skip has consumed a token, so one stands before the cursor.
    lexer.tok_kind before = lexer.tokvec_at(p->toks, p->pos - 1).kind;
    if (before == lexer.tok_kind.assign || before == lexer.tok_kind.comma
        || before == lexer.tok_kind.lparen || before == lexer.tok_kind.lbracket) {
        return true;
    }
    if (before != lexer.tok_kind.ident || p->pos < 2) {
        return false;
    }
    lexer.tok_kind name_before = lexer.tokvec_at(p->toks, p->pos - 2).kind;
    return name_before == lexer.tok_kind.assign || name_before == lexer.tok_kind.comma;
}

// Whether the `}` just consumed closed a brace literal inside an open group.
// The group is one that the failed construct left open or one that the skip
// opened. A `;`, `,`, `)` or `]` follows such a literal. The `;` of a `for`
// header and the `,` of an argument list stay inside the group, so the skip
// goes on to the end of the group. Thus, `for (i32 mut[2] a = {}; i < 3; i++)`
// reports only its type. A block that a stray `;` follows still ends the skip.
fn closes_group_literal(parser* p, u32 groups, bool literal) bool {
    lexer.tok_kind next = kind(p);
    return literal && groups > 0
        && (next == lexer.tok_kind.semi || next == lexer.tok_kind.comma
            || next == lexer.tok_kind.rparen || next == lexer.tok_kind.rbracket);
}

// Skips a failed construct to the recovery boundary for `level`.
// Outside open groups, recovery consumes a semicolon and braces that it opened.
// It leaves other closing braces and valid construct starts for the next parse.
// The end of the file ends each skip.
// Field and declaration recovery passes statement starts.
// Module declaration recovery also drops an unmatched top-level `}`.
// Compile-time declaration recovery leaves that brace for its branch.
// Case recovery passes statement starts in the failed body.
// Recovery consumes one token when the failed construct consumed none.
fn skip_to_boundary(parser mut* p, u64 start, i32 level) void {
    if (p->pos == start) {
        bump(p);
    }
    // A failed block already consumed its opening brace.
    // Thus, the first closing brace belongs to the skipped block.
    // A nesting-limit failure leaves the same unmatched closing brace.
    u32 mut braces = 0;
    if (lexer.tokvec_at(p->toks, start).kind == lexer.tok_kind.lbrace) {
        braces = 1;
    }
    u32 mut groups = count_open_groups(p, start);
    // Whether the outermost brace pair that the skip opened is a literal.
    bool mut literal = false;
    while (!at(p, lexer.tok_kind.eof)) {
        lexer.tok_kind k = kind(p);
        if (k == lexer.tok_kind.rbrace) {
            if (braces > 0) {
                braces -= 1;
                bump(p);
                if (braces == 0 && !closes_group_literal(p, groups, literal)) {
                    return;
                }
                continue;
            }
            // An unseen `}` before `;` closes an initializer or struct literal.
            // No block ends with `};`.
            if (peek_kind(p, 1) == lexer.tok_kind.semi) {
                bump(p);
                bump(p);
                return;
            }
            // A `}` before `)` or `]` can be a typo inside an open group.
            // In that case, it closes no body and belongs to the skipped region.
            if (groups > 0
                && (peek_kind(p, 1) == lexer.tok_kind.rparen
                    || peek_kind(p, 1) == lexer.tok_kind.rbracket)) {
                bump(p);
                continue;
            }
            // Any other one closes the body the construct sits in and is left
            // to it, except at the top level, where it closes nothing.
            if (level != RECOVER_DECL) {
                return;
            }
            bump(p);
            continue;
        }
        // A declaration keyword outranks a `(` the construct left open, which
        // is a typo of the construct; a `;` inside one is part of it.
        if (braces == 0) {
            bool in_body = level == RECOVER_STMT || level == RECOVER_CASE;
            bool at_compile_decl = level == RECOVER_DECL || level == RECOVER_COMPILE_DECL;
            if (at_decl_start(p) || (at_compile_decl && k == lexer.tok_kind.dollar_if)
                || (in_body && starts_case(k))
                || (level == RECOVER_STMT && starts_statement(k))) {
                return;
            }
            if (groups == 0 && k == lexer.tok_kind.semi) {
                // A run of `;` is one boundary, not a separate error.
                while (at(p, lexer.tok_kind.semi)) {
                    bump(p);
                }
                return;
            }
        }
        if (k == lexer.tok_kind.lbrace) {
            if (braces == 0) {
                literal = opens_literal(p);
            }
            braces += 1;
        } else if (k == lexer.tok_kind.lparen || k == lexer.tok_kind.lbracket) {
            groups += 1;
        } else if ((k == lexer.tok_kind.rparen || k == lexer.tok_kind.rbracket) && groups > 0) {
            groups -= 1;
        }
        bump(p);
    }
}

// Drops boundary tokens that cannot start a construct.
// These tokens are unmatched `)` or `]`, a following `;`, and a top-level `}`.
// Directly after a skip, they belong to the failed construct.
// Dropping them prevents a second diagnostic for the same error.
// The parser reports the same token when it reaches the token without recovery.
fn drop_leftovers(parser mut* p, i32 level) void {
    while (at(p, lexer.tok_kind.rparen) || at(p, lexer.tok_kind.rbracket)
           || at(p, lexer.tok_kind.semi)
           || (level == RECOVER_DECL && at(p, lexer.tok_kind.rbrace))) {
        bump(p);
    }
}

// Ends the unwind of the construct that began at `start`.
// A construct with no node leaves its failed tokens for recovery.
// Recovery keeps the skipped range as an error node.
// A partial node has already read its tokens and stands at the boundary.
fn recover(parser mut* p, ast.node mut* parent, u64 start, bool skipping, i32 level) void {
    if (skipping) {
        skip_to_boundary(p, start, level);
        drop_leftovers(p, level);
        if (p->pos > start) {
            diag.loc at_loc = tok_loc(p, lexer.tokvec_at(p->toks, start));
            ast.node mut* err = node_at(p, ast.ast_kind.k_error, at_loc);
            ast.ast_push(parent, finish(p, err));
        }
    }
    p->failed = false;
}

// Parses one statement into `parent`.
// On failure, adds an error node for the skipped tokens and resumes at a boundary.
fn parse_statement_into(parser mut* p, ast.node mut* parent) void {
    u64 start = p->pos;
    ast.node mut* s = parse_statement(p);
    if (s != null) {
        ast.ast_push(parent, s);
    }
    if (p->failed) {
        recover(p, parent, start, s == null, RECOVER_STMT);
    }
}

// ---- statements -------------------------------------------------

// var_decl = type identifier "=" initializer ";": one declarator, the
// initializer mandatory.
fn parse_var_decl(parser mut* p, bool want_semi) ast.node mut* {
    diag.loc at_loc = here(p);
    ast.node mut* n = node_at(p, ast.ast_kind.k_var_decl, at_loc);
    n->a = parse_type(p, false);
    if (n->a == null || !expect_name(p, n) || !expect(p, lexer.tok_kind.assign, "'='")) {
        return null;
    }
    n->b = parse_initializer(p);
    if (n->b == null) {
        return null;
    }
    if (want_semi && !expect(p, lexer.tok_kind.semi, "';'")) {
        return null;
    }
    return finish(p, n);
}

// assign_head, incdec_head or call_expr: the target is a postfix expression or a
// unary `*`. An assignment and an increment carry their operator's
// position, which is where the runtime reports the overwrite check and an
// overflow. The target's own position is on the target node.
fn parse_simple_head(parser mut* p) ast.node mut* {
    diag.loc at_loc = here(p);
    ast.node mut* mut e = null;
    if (at(p, lexer.tok_kind.star)) {
        e = parse_unary(p);
    } else {
        e = parse_postfix(p);
    }
    if (e == null) {
        return null;
    }
    if (is_assign_op(kind(p))) {
        diag.loc op_loc = here(p);
        ast.node mut* n = node_at(p, ast.ast_kind.k_assign, op_loc);
        n->op = cast(kind(p), i32);
        n->a = e;
        bump(p);
        n->b = parse_expr(p);
        if (n->b == null) {
            return null;
        }
        return finish(p, n);
    }
    if (at(p, lexer.tok_kind.plus_plus) || at(p, lexer.tok_kind.minus_minus)) {
        diag.loc op_loc = here(p);
        ast.node mut* n = node_at(p, ast.ast_kind.k_incdec, op_loc);
        n->op = cast(kind(p), i32);
        n->a = e;
        bump(p);
        return finish(p, n);
    }
    if (e->kind == ast.ast_kind.k_call) {
        ast.node mut* n = node_at(p, ast.ast_kind.k_call_stmt, at_loc);
        n->a = e;
        return finish(p, n);
    }
    error_expected(p, "an assignment, an increment or a call");
    return null;
}

fn parse_simple_statement(parser mut* p) ast.node mut* {
    ast.node mut* n = parse_simple_head(p);
    if (n == null || !expect(p, lexer.tok_kind.semi, "';'")) {
        return null;
    }
    return finish(p, n);
}

// The condition of `if` and `while`, always parenthesized.
fn parse_condition(parser mut* p) ast.node mut* {
    return parse_paren_expr(p);
}

// Ends the range of every `if` of an else-if chain: the chain nests at its
// tail. So each one runs to the end of the whole chain.
fn finish_if_chain(parser mut* p, ast.node mut* first) ast.node mut* {
    ast.node mut* mut n = first;
    while (n != null && n->kind == ast.ast_kind.k_if) {
        n = finish(p, n)->c;
    }
    return first;
}

// if_stmt = "if" "(" expr ")" block { "else" "if" "(" expr ")" block } [ "else"
// block ]: braces on every branch. The chain is built iteratively, so a long one
// does not recurse.
fn parse_if(parser mut* p) ast.node mut* {
    ast.node mut* mut first = null;
    ast.node mut* mut prev = null;
    while (true) {
        diag.loc at_loc = here(p);
        ast.node mut* n = node_at(p, ast.ast_kind.k_if, at_loc);
        bump(p);
        n->a = parse_condition(p);
        if (n->a == null) {
            return null;
        }
        n->b = parse_block(p);
        if (n->b == null) {
            return null;
        }
        if (prev != null) {
            prev->c = n;
        }
        if (first == null) {
            first = n;
        }
        prev = n;
        if (!at(p, lexer.tok_kind.kw_else)) {
            return finish_if_chain(p, first);
        }
        bump(p);
        if (at(p, lexer.tok_kind.kw_if)) {
            continue;
        }
        prev->c = parse_block(p);
        if (prev->c == null) {
            return null;
        }
        return finish_if_chain(p, first);
    }
    return null;
}

// A declaration branch of `$if`. The braces hold declarations instead of
// statements. Each declaration remains in the branch node for `--ast`.
fn parse_compile_decl_branch(parser mut* p) ast.node mut* {
    diag.loc at_loc = here(p);
    if (!expect(p, lexer.tok_kind.lbrace, "'{'") || !enter(p)) {
        return null;
    }
    ast.node mut* branch = node_at(p, ast.ast_kind.k_block, at_loc);
    while (!at(p, lexer.tok_kind.rbrace) && !at(p, lexer.tok_kind.eof)) {
        u64 start = p->pos;
        ast.node mut* mut decl = null;
        if (at(p, lexer.tok_kind.kw_import)) {
            decl = parse_import(p);
        } else {
            decl = parse_top_decl(p);
        }
        if (decl != null) {
            ast.ast_push(branch, decl);
        }
        if (p->failed) {
            recover(p, branch, start, decl == null, RECOVER_COMPILE_DECL);
        }
    }
    leave(p);
    expect(p, lexer.tok_kind.rbrace, "'}'");
    return finish(p, branch);
}

i32 MODULE_IF_EMPTY = 0;
i32 MODULE_IF_IMPORT = 1;
i32 MODULE_IF_DECL = 2;
i32 MODULE_IF_INVALID = 4;

fn classify_module_branch(parser mut* p, ast.node mut* branch) i32 {
    i32 mut result = MODULE_IF_EMPTY;
    u64 mut i = 0;
    while (branch != null && i < ast.ast_len(branch)) {
        ast.node mut* child = ast.ast_child_mut(branch, i);
        if (child->kind == ast.ast_kind.k_import) {
            result |= MODULE_IF_IMPORT;
        } else if (child->kind == ast.ast_kind.k_compile_if) {
            result |= classify_module_compile_if(p, child);
        } else if (child->kind == ast.ast_kind.k_error) {
            result |= MODULE_IF_INVALID;
        } else {
            result |= MODULE_IF_DECL;
        }
        i += 1;
    }
    return result;
}

fn mark_import_selector(ast.node mut* first) void {
    ast.node mut* mut current = first;
    while (current != null && current->kind == ast.ast_kind.k_compile_if) {
        current->flags |= ast.FLAG_IMPORT_SELECTOR;
        if (current->c == null || current->c->kind != ast.ast_kind.k_compile_if) {
            return;
        }
        current = current->c;
    }
}

// Classifies one complete module chain after all branches parse.
// An invalid nested chain reports its diagnostic, so its parent does not report again.
fn classify_module_compile_if(parser mut* p, ast.node mut* first) i32 {
    i32 mut result = MODULE_IF_EMPTY;
    ast.node mut* mut current = first;
    while (current != null && current->kind == ast.ast_kind.k_compile_if) {
        result |= classify_module_branch(p, current->b);
        if (current->c == null) {
            break;
        }
        if (current->c->kind != ast.ast_kind.k_compile_if) {
            result |= classify_module_branch(p, current->c);
            break;
        }
        current = current->c;
    }
    if ((result & MODULE_IF_INVALID) != 0) {
        return MODULE_IF_INVALID;
    }
    if ((result & MODULE_IF_IMPORT) != 0 && (result & MODULE_IF_DECL) != 0) {
        error_at(p, first->loc, "a module $if cannot contain both imports and declarations");
        return MODULE_IF_INVALID;
    }
    if ((result & MODULE_IF_IMPORT) != 0) {
        mark_import_selector(first);
    }
    return result;
}

fn parse_compile_branch(parser mut* p, bool declarations) ast.node mut* {
    if (declarations) {
        return parse_compile_decl_branch(p);
    }
    return parse_block(p);
}

// Ends each node range in an `else $if` chain.
fn finish_compile_if_chain(parser mut* p, ast.node mut* first) ast.node mut* {
    ast.node mut* mut n = first;
    while (n != null && n->kind == ast.ast_kind.k_compile_if) {
        n = finish(p, n)->c;
    }
    return first;
}

// `$if` has one grammar at declaration position and one at statement position.
// Both forms keep all branches. Selection occurs after parsing.
fn parse_compile_if(parser mut* p, bool declarations) ast.node mut* {
    ast.node mut* mut first = null;
    ast.node mut* mut prev = null;
    u32 mut conditions = 0;
    while (true) {
        if (conditions == COMPILE_IF_MAX_CONDITIONS) {
            error_here(p, "a $if chain can have at most 256 conditions");
            return null;
        }
        conditions += 1;
        diag.loc at_loc = here(p);
        ast.node mut* n = node_at(p, ast.ast_kind.k_compile_if, at_loc);
        bump(p);
        n->a = parse_condition(p);
        if (n->a == null) {
            return null;
        }
        n->b = parse_compile_branch(p, declarations);
        if (n->b == null) {
            return null;
        }
        if (prev != null) {
            prev->c = n;
        }
        if (first == null) {
            first = n;
        }
        prev = n;
        if (!at(p, lexer.tok_kind.kw_else)) {
            return finish_compile_if_chain(p, first);
        }
        bump(p);
        if (at(p, lexer.tok_kind.dollar_if)) {
            continue;
        }
        prev->c = parse_compile_branch(p, declarations);
        if (prev->c == null) {
            return null;
        }
        return finish_compile_if_chain(p, first);
    }
    return null;
}

fn parse_while(parser mut* p) ast.node mut* {
    diag.loc at_loc = here(p);
    ast.node mut* n = node_at(p, ast.ast_kind.k_while, at_loc);
    bump(p);
    n->a = parse_condition(p);
    if (n->a == null) {
        return null;
    }
    n->b = parse_block(p);
    if (n->b == null) {
        return null;
    }
    return finish(p, n);
}

// do_stmt = "do" block "while" "(" expr ")" ";".
// Bootstrap-0 parses this form and then reports that its subset does not support it.
// The self-hosted parser accepts the same tree without that report.
fn parse_do(parser mut* p) ast.node mut* {
    diag.loc at_loc = here(p);
    ast.node mut* n = node_at(p, ast.ast_kind.k_do_while, at_loc);
    bump(p);
    n->a = parse_block(p);
    if (n->a == null || !expect(p, lexer.tok_kind.kw_while, "'while'")) {
        return null;
    }
    n->b = parse_condition(p);
    if (n->b == null || !expect(p, lexer.tok_kind.semi, "';'")) {
        return null;
    }
    return finish(p, n);
}

// Whether the expression reading of a statement fails before `type_end`. A
// failed speculative type parse stopped at `type_end`. When it read further
// than the expression reading, the declaration branch reports the type error,
// as a module declaration does: `(i32 mut)[2] a` reports the marker.
fn head_fails_before(parser mut* p, u64 type_end) bool {
    // No reading fails before the first token of the statement. A type reading
    // that failed there leaves nothing to compare, so `*p = x;` is read once.
    if (type_end <= p->pos) {
        return false;
    }
    spec_state s = spec_begin(p);
    parse_simple_head(p);
    bool earlier = p->failed && p->fail_pos < type_end;
    spec_rewind(p, s);
    return earlier;
}

// After `for (`, a speculative `type identifier` distinguishes the three loop forms.
fn speculate_for_form(parser mut* p) i32 {
    if (at(p, lexer.tok_kind.semi)) {
        return FOR_PLAIN;
    }
    spec_state s = spec_begin(p);
    i32 mut form = FOR_PLAIN;
    ast.node* t = parse_type(p, false);
    bool failed = p->failed;
    u64 type_end = p->fail_pos;
    if (t != null && !p->failed && at(p, lexer.tok_kind.ident)) {
        bump(p);
        if (at(p, lexer.tok_kind.colon)) {
            form = FOR_RANGE;
        } else if (at(p, lexer.tok_kind.assign)) {
            form = FOR_DECL;
        }
    } else if (p->failed && read_marker(p, s.pos)) {
        // A misplaced marker makes the init a declaration, as at statement
        // level, so that the marker is what the init reports.
        form = FOR_DECL;
    }
    spec_rewind(p, s);
    if (failed && form == FOR_PLAIN && head_fails_before(p, type_end)) {
        form = FOR_DECL;
    }
    return form;
}

// range_for_stmt = "for" "(" type identifier ":" expr ")" block.
fn parse_range_for(parser mut* p, diag.loc at_loc) ast.node mut* {
    ast.node mut* n = node_at(p, ast.ast_kind.k_range_for, at_loc);
    n->a = parse_type(p, false);
    if (n->a == null || !expect_name(p, n) || !expect(p, lexer.tok_kind.colon, "':'")) {
        return null;
    }
    n->b = parse_expr(p);
    if (n->b == null || !expect(p, lexer.tok_kind.rparen, "')'")) {
        return null;
    }
    n->c = parse_block(p);
    if (n->c == null) {
        return null;
    }
    return finish(p, n);
}

// for_stmt = "for" "(" [ for_init ] ";" [ expr ] ";" [ for_step ] ")" block:
// `for (;;)` is legal and every part may be empty.
fn parse_for_tail(parser mut* p, diag.loc at_loc, i32 form) ast.node mut* {
    ast.node mut* n = node_at(p, ast.ast_kind.k_for, at_loc);
    if (form == FOR_DECL || !at(p, lexer.tok_kind.semi)) {
        if (form == FOR_DECL) {
            n->a = parse_var_decl(p, false);
        } else {
            n->a = parse_simple_head(p);
        }
        if (n->a == null) {
            return null;
        }
    }
    if (!expect(p, lexer.tok_kind.semi, "';'")) {
        return null;
    }
    if (!at(p, lexer.tok_kind.semi)) {
        n->b = parse_expr(p);
        if (n->b == null) {
            return null;
        }
    }
    if (!expect(p, lexer.tok_kind.semi, "';'")) {
        return null;
    }
    if (!at(p, lexer.tok_kind.rparen)) {
        n->c = parse_simple_head(p);
        if (n->c == null) {
            return null;
        }
    }
    if (!expect(p, lexer.tok_kind.rparen, "')'")) {
        return null;
    }
    n->d = parse_block(p);
    if (n->d == null) {
        return null;
    }
    return finish(p, n);
}

fn parse_for(parser mut* p) ast.node mut* {
    diag.loc at_loc = here(p);
    bump(p);
    if (!expect(p, lexer.tok_kind.lparen, "'('") || !enter(p)) {
        return null;
    }
    ast.node mut* mut n = null;
    if (check_no_leading_marker(p)) {
        i32 form = speculate_for_form(p);
        if (form == FOR_RANGE) {
            n = parse_range_for(p, at_loc);
        } else {
            n = parse_for_tail(p, at_loc, form);
        }
    }
    leave(p);
    return n;
}

// A case body stops at the next clause or the end of the switch. A missing `}`
// also stops the body at a top-level declaration.
fn at_case_end(parser mut* p) bool {
    return at(p, lexer.tok_kind.kw_case) || at(p, lexer.tok_kind.kw_default)
        || at(p, lexer.tok_kind.rbrace) || at(p, lexer.tok_kind.eof) || at_decl_start(p);
}

// switch_stmt = "switch" "(" expr ")" "{" { case_clause } "}"; each case body
// is an implicit block scope.
fn parse_case(parser mut* p) ast.node mut* {
    diag.loc at_loc = here(p);
    ast.node mut* n = node_at(p, ast.ast_kind.k_case, at_loc);
    if (at(p, lexer.tok_kind.kw_default)) {
        n->flags = ast.FLAG_DEFAULT;
        bump(p);
    } else {
        bump(p);
        while (true) {
            ast.node mut* label = parse_expr(p);
            if (label == null) {
                return null;
            }
            ast.ast_push(n, label);
            if (!at(p, lexer.tok_kind.comma)) {
                break;
            }
            bump(p);
        }
    }
    if (!expect(p, lexer.tok_kind.colon, "':'")) {
        return null;
    }
    // An empty clause block starts just after the `:`.
    diag.loc mut body_loc = here(p);
    if (at_case_end(p)) {
        body_loc = here_implicit(p);
    }
    ast.node mut* body = node_at(p, ast.ast_kind.k_block, body_loc);
    // The clause statements form a recovery point.
    while (!at_case_end(p)) {
        parse_statement_into(p, body);
    }
    n->a = finish(p, body);
    return finish(p, n);
}

fn parse_switch(parser mut* p) ast.node mut* {
    diag.loc at_loc = here(p);
    ast.node mut* n = node_at(p, ast.ast_kind.k_switch, at_loc);
    bump(p);
    n->a = parse_paren_expr(p);
    if (n->a == null || !expect(p, lexer.tok_kind.lbrace, "'{'") || !enter(p)) {
        return null;
    }
    // Switch clauses have their own recovery point.
    // A broken label, missing `:`, or invalid clause produces one diagnostic.
    // Recovery then reads the later clauses.
    // The parser returns the switch even when its closing brace is missing.
    // It skips non-clause tokens here so the enclosing block cannot read them.
    while (!at(p, lexer.tok_kind.rbrace) && !at(p, lexer.tok_kind.eof) && !at_decl_start(p)) {
        u64 start = p->pos;
        ast.node mut* mut clause = null;
        if (at(p, lexer.tok_kind.kw_case) || at(p, lexer.tok_kind.kw_default)) {
            clause = parse_case(p);
            if (clause != null) {
                ast.ast_push(n, clause);
            }
        } else {
            error_expected(p, "'case' or 'default'");
        }
        if (p->failed) {
            recover(p, n, start, clause == null, RECOVER_CASE);
        }
    }
    leave(p);
    expect(p, lexer.tok_kind.rbrace, "'}'");
    return finish(p, n);
}

// defer_stmt = "defer" ( assign_stmt | incdec_stmt | call_stmt | block ).
fn parse_defer(parser mut* p) ast.node mut* {
    diag.loc at_loc = here(p);
    ast.node mut* n = node_at(p, ast.ast_kind.k_defer, at_loc);
    bump(p);
    if (at(p, lexer.tok_kind.lbrace)) {
        n->a = parse_block(p);
    } else {
        n->a = parse_simple_statement(p);
    }
    if (n->a == null) {
        return null;
    }
    return finish(p, n);
}

// return_stmt = "return" [ expr ] ";".
fn parse_return(parser mut* p) ast.node mut* {
    diag.loc at_loc = here(p);
    ast.node mut* n = node_at(p, ast.ast_kind.k_return, at_loc);
    bump(p);
    if (!at(p, lexer.tok_kind.semi)) {
        n->a = parse_expr(p);
        if (n->a == null) {
            return null;
        }
    }
    if (!expect(p, lexer.tok_kind.semi, "';'")) {
        return null;
    }
    return finish(p, n);
}

fn parse_break_or_continue(parser mut* p) ast.node mut* {
    diag.loc at_loc = here(p);
    ast.node mut* mut n = null;
    if (at(p, lexer.tok_kind.kw_break)) {
        n = node_at(p, ast.ast_kind.k_break, at_loc);
    } else {
        n = node_at(p, ast.ast_kind.k_continue, at_loc);
    }
    bump(p);
    if (!expect(p, lexer.tok_kind.semi, "';'")) {
        return null;
    }
    return finish(p, n);
}

// A primitive type, `string`, `fn`, or `void` starts a declaration.
fn starts_declaration(parser* p) bool {
    prim.prim_kind mut prim0 = prim.prim_kind.prim_void;
    lexer.tok_kind k = kind(p);
    return prim_of_token(k, &prim0) || k == lexer.tok_kind.kw_string
        || k == lexer.tok_kind.kw_void || k == lexer.tok_kind.kw_fn;
}

// Otherwise, an identifier after a speculative type makes the statement a declaration.
fn speculate_declaration(parser mut* p) bool {
    spec_state s = spec_begin(p);
    ast.node* t = parse_type(p, false);
    bool failed = p->failed;
    u64 type_end = p->fail_pos;
    // A type parse that died on a marker leaves no expression reading of the
    // statement, so the declaration branch wins and reports the marker.
    bool mut decl = (t != null && !failed && at(p, lexer.tok_kind.ident))
        || (failed && read_marker(p, s.pos));
    spec_rewind(p, s);
    if (failed && !decl) {
        decl = head_fails_before(p, type_end);
    }
    return decl;
}

fn parse_statement(parser mut* p) ast.node mut* {
    if (at(p, lexer.tok_kind.lbrace)) {
        return parse_block(p);
    }
    if (at(p, lexer.tok_kind.kw_if)) {
        return parse_if(p);
    }
    if (at(p, lexer.tok_kind.dollar_if)) {
        return parse_compile_if(p, false);
    }
    if (at(p, lexer.tok_kind.kw_while)) {
        return parse_while(p);
    }
    if (at(p, lexer.tok_kind.kw_do)) {
        return parse_do(p);
    }
    if (at(p, lexer.tok_kind.kw_for)) {
        return parse_for(p);
    }
    if (at(p, lexer.tok_kind.kw_switch)) {
        return parse_switch(p);
    }
    if (at(p, lexer.tok_kind.kw_defer)) {
        return parse_defer(p);
    }
    if (at(p, lexer.tok_kind.kw_return)) {
        return parse_return(p);
    }
    if (at(p, lexer.tok_kind.kw_break) || at(p, lexer.tok_kind.kw_continue)) {
        return parse_break_or_continue(p);
    }
    if (at(p, lexer.tok_kind.semi)) {
        error_here(p, "an empty statement is not allowed");
        return null;
    }
    if (!check_no_leading_marker(p)) {
        return null;
    }
    if (starts_declaration(p) || speculate_declaration(p)) {
        return parse_var_decl(p, true);
    }
    return parse_simple_statement(p);
}

// Parses a block after the parser reads or reports its opening brace.
// Statements form a recovery point.
// A top-level declaration also ends a block with no closing brace.
// The parser reports that missing brace once.
// It returns the partial node so enclosing constructs can recover.
fn parse_block_tail(parser mut* p, diag.loc at_loc) ast.node mut* {
    if (!enter(p)) {
        return null;
    }
    ast.node mut* n = node_at(p, ast.ast_kind.k_block, at_loc);
    while (!at(p, lexer.tok_kind.rbrace) && !at(p, lexer.tok_kind.eof) && !at_decl_start(p)) {
        parse_statement_into(p, n);
    }
    leave(p);
    expect(p, lexer.tok_kind.rbrace, "'}'");
    return finish(p, n);
}

// block = "{" { statement } "}". A block that stands where a
// statement is expected needs its `{`: the statement forms are braced. So a
// missing one is a different mistake and the construct fails.
fn parse_block(parser mut* p) ast.node mut* {
    diag.loc at_loc = here(p);
    if (!expect(p, lexer.tok_kind.lbrace, "'{'")) {
        return null;
    }
    return parse_block_tail(p, at_loc);
}

// Reads the `{` that opens a declaration body.
// If it is missing, reports one error and reads the body without it.
// The declaration header is complete, and the closing brace usually remains.
// Thus, one missing opening brace produces one diagnostic.
fn open_body(parser mut* p) void {
    if (at(p, lexer.tok_kind.lbrace)) {
        bump(p);
    } else {
        error_expected(p, "'{'");
    }
}

// The body of a function, whose `{` may be missing.
fn parse_body(parser mut* p) ast.node mut* {
    diag.loc at_loc = here(p);
    open_body(p);
    return parse_block_tail(p, at_loc);
}

// ---- declarations --------------------------------------------

// param_list = param { "," param } with param = type identifier; no trailing
// comma in a parameter list.
fn parse_params(parser mut* p, ast.node mut* fn_node) bool {
    if (!expect(p, lexer.tok_kind.lparen, "'('")) {
        return false;
    }
    if (!at(p, lexer.tok_kind.rparen)) {
        while (true) {
            diag.loc at_loc = here(p);
            ast.node mut* param = node_at(p, ast.ast_kind.k_param, at_loc);
            param->a = parse_type(p, false);
            if (param->a == null || !expect_name(p, param)) {
                return false;
            }
            ast.ast_push(fn_node, finish(p, param));
            if (!at(p, lexer.tok_kind.comma)) {
                break;
            }
            bump(p);
        }
    }
    return expect(p, lexer.tok_kind.rparen, "')'");
}

// An extern parameter list has one or more fixed parameters before `...`.
// The tail mark is a flag, not a parameter node.
fn parse_extern_params(parser mut* p, ast.node mut* fn_node) bool {
    if (!expect(p, lexer.tok_kind.lparen, "'('")) {
        return false;
    }
    if (!at(p, lexer.tok_kind.rparen)) {
        while (true) {
            diag.loc at_loc = here(p);
            ast.node mut* param = node_at(p, ast.ast_kind.k_param, at_loc);
            param->a = parse_type(p, false);
            if (param->a == null || !expect_name(p, param)) {
                return false;
            }
            ast.ast_push(fn_node, finish(p, param));
            if (!at(p, lexer.tok_kind.comma)) {
                break;
            }
            bump(p);
            if (at(p, lexer.tok_kind.ellipsis)) {
                fn_node->tail_loc = here(p);
                fn_node->flags |= ast.FLAG_VARIADIC;
                bump(p);
                break;
            }
        }
    }
    return expect(p, lexer.tok_kind.rparen, "')'");
}

// fn_decl = "fn" identifier "(" [ param_list ] ")" return_type block, with the
// `fn` already parsed: the name is the second token and the result comes last.
fn parse_fn_decl(parser mut* p, diag.loc at_loc) ast.node mut* {
    ast.node mut* n = node_at(p, ast.ast_kind.k_fn_decl, at_loc);
    if (!expect_name(p, n) || !parse_params(p, n)) {
        return null;
    }
    n->a = parse_return_type(p);
    if (n->a == null) {
        return null;
    }
    n->b = parse_body(p);
    if (n->b == null) {
        return null;
    }
    return finish(p, n);
}

// At the top level a `fn` opens a function definition. When the
// `fn` is followed by `(` rather than a name, it starts a function type.
// The declaration is a global of that type.
fn parse_fn_top_decl(parser mut* p) ast.node mut* {
    diag.loc at_loc = here(p);
    bump(p);
    if (at(p, lexer.tok_kind.ident)) {
        return parse_fn_decl(p, at_loc);
    }
    ast.node mut* base = parse_fn_type_params(p, at_loc);
    if (base == null) {
        return null;
    }
    ast.node mut* n = node_at(p, ast.ast_kind.k_var_decl, at_loc);
    n->a = parse_type_after_base(p, at_loc, base);
    if (n->a == null || !expect_name(p, n) || !expect(p, lexer.tok_kind.assign, "'='")) {
        return null;
    }
    n->b = parse_initializer(p);
    if (n->b == null || !expect(p, lexer.tok_kind.semi, "';'")) {
        return null;
    }
    return finish(p, n);
}

// extern_decl = "extern" "fn" identifier "(" [ extern_param_list ] ")" return_type
// ";": a declaration with no body.
fn parse_extern_decl(parser mut* p) ast.node mut* {
    diag.loc at_loc = here(p);
    bump(p);
    if (!expect(p, lexer.tok_kind.kw_fn, "'fn'")) {
        return null;
    }
    ast.node mut* n = node_at(p, ast.ast_kind.k_fn_decl, at_loc);
    n->flags = ast.FLAG_EXTERN;
    if (!expect_name(p, n) || !parse_extern_params(p, n)) {
        return null;
    }
    n->a = parse_return_type(p);
    if (n->a == null) {
        return null;
    }
    if (!expect(p, lexer.tok_kind.semi, "';'")) {
        return null;
    }
    return finish(p, n);
}

// struct_decl = "struct" identifier "{" field { field } "}": no trailing
// semicolon and at least one field.
fn parse_struct_decl(parser mut* p) ast.node mut* {
    diag.loc at_loc = here(p);
    ast.node mut* n = node_at(p, ast.ast_kind.k_struct_decl, at_loc);
    bump(p);
    if (!expect_name(p, n)) {
        return null;
    }
    open_body(p);
    if (!enter(p)) {
        return null;
    }
    if (at(p, lexer.tok_kind.rbrace)) {
        error_here(p, "a struct has at least one field");
    }
    // Skip a broken field to its `;` or the body's `}`.
    while (!at(p, lexer.tok_kind.rbrace) && !at(p, lexer.tok_kind.eof) && !at_decl_start(p)) {
        u64 start = p->pos;
        diag.loc at_field = here(p);
        ast.node mut* field = node_at(p, ast.ast_kind.k_field_decl, at_field);
        field->a = parse_type(p, false);
        bool ok = field->a != null && expect_name(p, field)
            && expect(p, lexer.tok_kind.semi, "';'");
        if (ok) {
            ast.ast_push(n, finish(p, field));
        }
        if (p->failed) {
            recover(p, n, start, !ok, RECOVER_FIELD);
        }
    }
    leave(p);
    expect(p, lexer.tok_kind.rbrace, "'}'");
    return finish(p, n);
}

// enum_decl = "enum" identifier "{" enum_member { "," enum_member } [ "," ]
// "}".
fn parse_enum_decl(parser mut* p) ast.node mut* {
    diag.loc at_loc = here(p);
    ast.node mut* n = node_at(p, ast.ast_kind.k_enum_decl, at_loc);
    bump(p);
    if (!expect_name(p, n)) {
        return null;
    }
    open_body(p);
    if (!enter(p)) {
        return null;
    }
    bool mut ok = true;
    if (at(p, lexer.tok_kind.rbrace)) {
        error_here(p, "an enum has at least one member");
        ok = false;
    }
    // The body still ends where a top-level declaration starts.
    while (ok && !at_decl_start(p)) {
        diag.loc at_member = here(p);
        ast.node mut* member = node_at(p, ast.ast_kind.k_enum_member, at_member);
        ok = expect_name(p, member);
        if (ok && at(p, lexer.tok_kind.assign)) {
            bump(p);
            member->a = parse_expr(p);
            ok = member->a != null;
        }
        if (!ok) {
            break;
        }
        ast.ast_push(n, finish(p, member));
        if (!at(p, lexer.tok_kind.comma)) {
            break;
        }
        bump(p);
        if (at(p, lexer.tok_kind.rbrace)) {
            break;
        }
    }
    leave(p);
    // A failed member leaves the body for declaration recovery.
    // A body that reaches a top-level declaration keeps its node.
    // Thus, the tree keeps the enum and the declarations that follow it.
    if (!ok) {
        return null;
    }
    expect(p, lexer.tok_kind.rbrace, "'}'");
    return finish(p, n);
}

// Resolution decides whether the last segment names a module or a symbol.
fn parse_import_items(parser mut* p, ast.node mut* n) bool {
    bump(p);
    while (true) {
        diag.loc at_item = here(p);
        ast.node mut* item = node_at(p, ast.ast_kind.k_import_item, at_item);
        if (!expect_name(p, item)) {
            return false;
        }
        if (at(p, lexer.tok_kind.kw_as)) {
            diag.loc at_loc = here(p);
            bump(p);
            item->a = node_at(p, ast.ast_kind.k_ident, at_loc);
            if (!expect_name(p, item->a)) {
                return false;
            }
            finish(p, item->a);
        }
        ast.ast_push(n, finish(p, item));
        if (!at(p, lexer.tok_kind.comma)) {
            break;
        }
        bump(p);
        if (at(p, lexer.tok_kind.rbrace)) {
            break;
        }
    }
    return expect(p, lexer.tok_kind.rbrace, "'}'");
}

// Reports two invalid path separators at the separator position.
// Longest-match lexing makes `..` one token in `import a..b;`.
// The parser also accepts `::` as a compatibility separator.
// Without this test, either form causes an incorrect missing-`;` diagnostic.
fn check_path_separator(parser mut* p) bool {
    if (at(p, lexer.tok_kind.dot_dot)) {
        error_here(p, "a module path is separated by '.', not '..'");
        return false;
    }
    if (!at(p, lexer.tok_kind.colon)) {
        return true;
    }
    if (peek_kind(p, 1) == lexer.tok_kind.colon) {
        error_here(p, "a module path is separated by '.', not '::'");
    } else {
        error_here(p, "a module path is separated by '.', not ':'");
    }
    return false;
}

fn parse_import(parser mut* p) ast.node mut* {
    diag.loc at_loc = here(p);
    ast.node mut* n = node_at(p, ast.ast_kind.k_import, at_loc);
    bump(p);
    diag.loc path_loc = here(p);
    ast.node mut* path = node_at(p, ast.ast_kind.k_path, path_loc);
    n->a = path;
    while (true) {
        diag.loc at_segment = here(p);
        ast.node mut* segment = node_at(p, ast.ast_kind.k_ident, at_segment);
        if (!expect_name(p, segment)) {
            return null;
        }
        ast.ast_push(path, finish(p, segment));
        // The path ends at its last segment, so it is extended here and not
        // after the loop: the `.{ ... }` of an item list is not part of it.
        finish(p, path);
        if (!check_path_separator(p)) {
            return null;
        }
        if (!at(p, lexer.tok_kind.dot)) {
            break;
        }
        bump(p);
        if (at(p, lexer.tok_kind.lbrace)) {
            if (!parse_import_items(p, n)) {
                return null;
            }
            break;
        }
    }
    if (ast.ast_len(n) == 0 && at(p, lexer.tok_kind.kw_as)) {
        diag.loc alias = here(p);
        bump(p);
        n->b = node_at(p, ast.ast_kind.k_ident, alias);
        if (!expect_name(p, n->b)) {
            return null;
        }
        finish(p, n->b);
    }
    if (!expect(p, lexer.tok_kind.semi, "';'")) {
        return null;
    }
    return finish(p, n);
}

// A top-level declaration is a function, extern, struct, enum, or global variable.
fn parse_top_decl(parser mut* p) ast.node mut* {
    if (at(p, lexer.tok_kind.dollar_if)) {
        return parse_compile_if(p, true);
    }
    if (at(p, lexer.tok_kind.kw_fn)) {
        return parse_fn_top_decl(p);
    }
    if (at(p, lexer.tok_kind.kw_extern)) {
        return parse_extern_decl(p);
    }
    if (at(p, lexer.tok_kind.kw_struct)) {
        return parse_struct_decl(p);
    }
    if (at(p, lexer.tok_kind.kw_enum)) {
        return parse_enum_decl(p);
    }
    if (at(p, lexer.tok_kind.kw_import)) {
        error_here(p, "an import comes before every declaration");
        return null;
    }
    if (!check_no_leading_marker(p)) {
        return null;
    }
    return parse_var_decl(p, true);
}

// Parses one declaration into `mod` and recovers from a syntax error where the
// declaration began, as a block does with a statement. `import` parses the import
// form, which comes first in a file; every declaration of a file is read,
// whatever the ones before it did.
fn parse_decl_into(parser mut* p, ast.node mut* mod, bool import_form) void {
    u64 start = p->pos;
    ast.node mut* mut decl = null;
    if (import_form) {
        decl = parse_import(p);
    } else {
        decl = parse_top_decl(p);
    }
    if (decl != null) {
        ast.ast_push(mod, decl);
    }
    if (p->failed) {
        recover(p, mod, start, decl == null, RECOVER_DECL);
    }
}

// Parses and classifies one top-level `$if`. The import loop accepts an import
// selector. The declaration loop reports the ordinary imports-first error.
fn parse_module_compile_if_into(parser mut* p, ast.node mut* mod,
                                     bool imports_allowed) bool {
    u64 start = p->pos;
    ast.node mut* n = parse_compile_if(p, true);
    bool mut imports = false;
    if (n != null) {
        i32 category = classify_module_compile_if(p, n);
        imports = category == MODULE_IF_IMPORT;
        if (imports && !imports_allowed && !p->failed) {
            error_at(p, n->loc, "an import comes before every declaration");
        }
        ast.ast_push(mod, n);
    }
    if (p->failed) {
        recover(p, mod, start, n == null, RECOVER_DECL);
    }
    return imports;
}

/// Parses one file into a `k_module` node. Imports precede declarations in source order.
/// The token vector must end in EOF. Syntax errors use the budget that the lexer started.
/// The function returns a partial tree with `k_error` nodes when syntax errors occur.
fn parse_module(session.session mut* sess, string file, lexer.tok_vec* toks,
                              ast.arena mut* ar) ast.node mut* {
    u64 ntoks = lexer.tokvec_count(toks);
    if (ntoks == 0 || lexer.tokvec_at(toks, ntoks - 1).kind != lexer.tok_kind.eof) {
        panic("parser.parse_module: the token vector does not end in end of file");
    }
    parser mut p = parser{sess, file, toks, ntoks, 0, ar, 0, 0, false, 0,
                          diag.loc_make(file, 0, 0), strbuf.create()};
    defer strbuf.free(&p.msg);

    ast.node mut* mod = ast.ast_new(ar, ast.ast_kind.k_module, diag.loc_make(file, 1, 1));
    // Both loops are recovery points, so one error removes one subtree.
    while (true) {
        if (at(&p, lexer.tok_kind.kw_import)) {
            parse_decl_into(&p, mod, true);
        } else if (at(&p, lexer.tok_kind.dollar_if)) {
            if (!parse_module_compile_if_into(&p, mod, true)) {
                break;
            }
        } else {
            break;
        }
    }
    while (!at(&p, lexer.tok_kind.eof)) {
        if (at(&p, lexer.tok_kind.dollar_if)) {
            parse_module_compile_if_into(&p, mod, false);
        } else {
            parse_decl_into(&p, mod, false);
        }
    }
    return finish(&p, mod);
}
