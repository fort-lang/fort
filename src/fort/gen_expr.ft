/// Lowers checked expressions to LLVM IR.

import ast;
import check;
import consts;
import diag;
import gen;
import lexer;
import prim;
import runtime_sig;
import std.strbuf;
import types;

// The descriptors the print family writes to.
u64 FD_STDOUT = 1;
u64 FD_STDERR = 2;

// The byte `println` and its relatives end with.
u64 NEWLINE_BYTE = 10;

// The widths an integer type has, for the overflow intrinsic table.
u32 BITS_8 = 8;
u32 BITS_16 = 16;
u32 BITS_32 = 32;
u32 BITS_64 = 64;

// A poisoned or missing type: the checker reported it and nothing is emitted.
fn bad_type(types.node* t) bool {
    return t == null || t->kind == types.type_kind.k_error;
}

fn is_bool(types.node* t) bool {
    return t != null && t->kind == types.type_kind.k_prim && t->prim == prim.prim_kind.prim_bool;
}

// A zero value of the type: the operand an integer negation and an integer division check need.
// Floats do not use either case. `fneg` takes one operand, and float division has no check. A float
// reaches this function only when a caller requests scalar zero.
fn zero_of(gen.emitter mut* g, types.node* t) gen.gen_val {
    if (types.type_is_float(t)) {
        // A float literal in the IR is written with a point; `0.0` is exact in
        // both formats.
        return gen.gen_literal(g, gen.gen_value_type(g, t), "0.0");
    }
    return gen.gen_const_unsigned(g, gen.gen_value_type(g, t), 0);
}

// Returns the token kind stored as `i32` in a node's `op` (ast.ft). Operator switches use the token
// value, not its raw number. Each arm therefore names its token.
fn op_of(ast.node* n) lexer.tok_kind {
    return cast(n->op, lexer.tok_kind);
}

// ---- constants --------------------------------------------------------------------

// Whether the checker folded the node and its value is a scalar the emitter
// can write as a literal. A string constant is an aggregate and has no literal
// form.
fn folded_scalar(gen.emitter* g, ast.node* n) bool {
    if ((n->ann & check.ANN_CONST) == 0 || gen.gen_is_aggregate(n->ty)) {
        return false;
    }
    return check.check_node_value(g->ck, n).kind != consts.cval_kind.cv_none;
}

// ---- the print family ---------------------------------------------------

// Returns a `string` operand's bytes and length. A literal uses `@.str.N` and its constant length.
// Other strings use their two header fields.
fn string_operand(gen.emitter mut* g, ast.node* n, gen.gen_val mut* ptr,
                       gen.gen_val mut* len) void {
    if ((n->ann & check.ANN_CONST) != 0) {
        consts.cval v = check.check_node_value(g->ck, n);
        if (v.kind == consts.cval_kind.cv_str) {
            string name = gen.gen_str_ref(g, v.str);
            *ptr = gen.gen_literal(g, "ptr", name);
            *len = gen.gen_const_unsigned(g, "i64", v.str.len);
            return;
        }
    }
    gen.gen_place p = gen_expr_place(g, n);
    if (g->failed) {
        *ptr = gen.gen_literal(g, "ptr", "null");
        *len = gen.gen_const_unsigned(g, "i64", 0);
        return;
    }
    *ptr = gen.gen_span_ptr(g, p.addr);
    *len = gen.gen_span_len(g, p.addr);
}

// Emits one call for one print argument, based on its type.
fn gen_print_arg(gen.emitter mut* g, ast.node* n, gen.gen_val fd) void {
    types.node* t = n->ty;
    if (bad_type(t)) {
        return;
    }
    gen.gen_args mut args = gen.gen_args_init();
    // the C frees at each of seven returns. One `defer` does it
    defer gen.gen_args_free(&args);
    gen.gen_args_add(&args, fd);
    if (t->kind == types.type_kind.k_string) {
        gen.gen_val mut ptr = gen.gen_val{};
        gen.gen_val mut len = gen.gen_val{};
        string_operand(g, n, &ptr, &len);
        gen.gen_args_add(&args, ptr);
        gen.gen_args_add(&args, len);
        gen.gen_call_rt(g, runtime_sig.rt_entry.rt_print_str, &args);
        return;
    }
    gen.gen_val v = gen_expr_value(g, n);
    if (g->failed) {
        return;
    }
    if (t->kind == types.type_kind.k_enum) {
        // An enum prints as `(i32 %v, ptr @.enum.<path.name>, i64 <count>)`
        ast.sym* e = check.nominal_sym(t);
        gen.gen_args_add(&args, v);
        string table = gen.gen_enum_ref(g, e);
        gen.gen_args_add(&args, gen.gen_literal(g, "ptr", table));
        gen.gen_args_add(&args, gen.gen_const_unsigned(g, "i64", gen.gen_enum_count(e)));
        gen.gen_call_rt(g, runtime_sig.rt_entry.rt_print_enum, &args);
        return;
    }
    if (t->kind == types.type_kind.k_ptr || t->kind == types.type_kind.k_voidptr ||
        t->kind == types.type_kind.k_fn) {
        // A pointer, `void*` or function pointer goes to `_ptr`.
        gen.gen_args_add(&args, v);
        gen.gen_call_rt(g, runtime_sig.rt_entry.rt_print_ptr, &args);
        return;
    }
    if (is_bool(t)) {
        // `std.rt.print_bool` takes a fort `bool`. A call uses `i1 zeroext`; only memory uses `i8`.
        // Pass the value unchanged.
        gen.gen_args_add_ext(&args, v, "zeroext");
        gen.gen_call_rt(g, runtime_sig.rt_entry.rt_print_bool, &args);
        return;
    }
    if (t->kind == types.type_kind.k_prim && t->prim == prim.prim_kind.prim_char) {
        gen.gen_args_add_ext(&args, v, "zeroext");
        gen.gen_call_rt(g, runtime_sig.rt_entry.rt_print_char, &args);
        return;
    }
    if (types.type_is_float(t)) {
        // A float goes to the printer of its own type and is never widened first: the digits
        // printed depend on the type. Both entry points are in std.rt, which each closure includes.
        // The calling module therefore holds their definitions and needs no declarations.
        gen.gen_args_add(&args, v);
        if (t->prim == prim.prim_kind.prim_f32) {
            gen.gen_call_rt(g, runtime_sig.rt_entry.rt_print_f32, &args);
            return;
        }
        gen.gen_call_rt(g, runtime_sig.rt_entry.rt_print_f64, &args);
        return;
    }
    // `i8 i16 i32 i64` are sign-extended to `i64` and `u8 u16 u32 u64`
    // zero-extended to it.
    bool sign = gen.gen_is_signed(t);
    gen.gen_args_add(&args, gen.gen_resize(g, v, gen.gen_int_bits(t), "i64", BITS_64, sign));
    if (sign) {
        gen.gen_call_rt(g, runtime_sig.rt_entry.rt_print_i64, &args);
        return;
    }
    gen.gen_call_rt(g, runtime_sig.rt_entry.rt_print_u64, &args);
}

// The print family: `fd` once, then each argument left to right, one call per
// argument.
fn gen_print(gen.emitter mut* g, ast.node* n, gen.gen_val fd, u64 first, bool newline) void {
    u64 mut i = first;
    while (i < ast.ast_len(n)) {
        gen_print_arg(g, ast.ast_child(n, i), fd);
        if (g->failed) {
            return;
        }
        i += 1;
    }
    if (!newline) {
        return;
    }
    // `println` and its relatives end with a newline byte.
    gen.gen_args mut args = gen.gen_args_init();
    defer gen.gen_args_free(&args);
    gen.gen_args_add(&args, fd);
    gen.gen_args_add_ext(&args, gen.gen_const_unsigned(g, "i8", NEWLINE_BYTE), "zeroext");
    gen.gen_call_rt(g, runtime_sig.rt_entry.rt_print_char, &args);
}

// The byte offset of a position in the module's source, so that `assert` can
// quote its argument verbatim.
fn source_offset(string src, u32 line, u32 col) u64 {
    u64 mut at = 0;
    u32 mut here = 1;
    while (here < line && at < src.len) {
        if (src[at] == '\n') {
            here += 1;
        }
        at += 1;
    }
    // `col` is one-based, but an unfilled parser range can contain zero. check.ft guards one such
    // case. Use wrapping subtraction to match C. Checked subtraction would trap before the clamp
    // handles zero.
    at +%= cast(col, u64) -% 1;
    if (at < src.len) {
        return at;
    }
    return src.len;
}

// Returns the source text of an `assert` argument. The call range starts at `(` and ends after `)`.
// The text between them preserves the user's argument.
fn assert_text(gen.emitter* g, ast.node* call) string {
    if (g->module == null) {
        return "";
    }
    string src = g->module->source;
    u64 open = source_offset(src, call->loc.line, call->loc.col);
    u64 close = source_offset(src, call->loc.end_line, call->loc.end_col);
    if (close < open + 2) {
        return "";
    }
    return src[open + 1..close - 1];
}

// `assert(cond)` is active in both build modes and branches to the
// continuation first because its operand is already the success condition.
fn gen_assert(gen.emitter mut* g, ast.node* n) void {
    ast.node* arg = ast.ast_child(n, 0);
    gen.gen_val cond = gen_expr_value(g, arg);
    if (g->failed) {
        return;
    }
    gen.gen_args mut args = gen.gen_args_init();
    defer gen.gen_args_free(&args);
    string text = gen.gen_str_ref(g, assert_text(g, n));
    gen.gen_args_add(&args, gen.gen_literal(g, "ptr", text));
    gen.gen_check(g, cond, false, runtime_sig.rt_entry.rt_assert_fail, &args, n->a->loc);
}

// `panic(msg)` writes the message and aborts, so the call is followed by
// `unreachable`.
fn gen_panic(gen.emitter mut* g, ast.node* n) void {
    gen.gen_val mut ptr = gen.gen_val{};
    gen.gen_val mut len = gen.gen_val{};
    string_operand(g, ast.ast_child(n, 0), &ptr, &len);
    if (g->failed) {
        return;
    }
    gen.gen_args mut args = gen.gen_args_init();
    defer gen.gen_args_free(&args);
    gen.gen_args_add(&args, ptr);
    gen.gen_args_add(&args, len);
    gen.gen_args_add_loc(g, &args, n->a->loc);
    gen.gen_call_rt(g, runtime_sig.rt_entry.rt_panic, &args);
    gen.gen_ins(g);
    gen.gen_text_append(g, "unreachable");
    gen.gen_ins_end(g);
    g->terminated = true;
}

// ---- new and del ---------------------------------------------------------

// Returns whether `n` designates storage, which controls whether `del` empties it. An `own` rvalue
// has no storage to clear. Examples include `new(...)`, call results, and adopting casts.
fn is_place_expr(ast.node* n) bool {
    switch (n->kind) {
    case ast.ast_kind.k_ident, ast.ast_kind.k_index, ast.ast_kind.k_field,
         ast.ast_kind.k_arrow:
        return true;
    case ast.ast_kind.k_unary:
        return op_of(n) == lexer.tok_kind.star;
    default:
        return false;
    }
}

// Emits `del(x)`. It loads the pointer, using field 0 for a span or string, then calls
// `std.rt.free`. It clears lvalues with a null store or 16-byte `llvm.memset`. A null operand is a
// no-op in the runtime, so `del(null)` and `del` of a zero span need no test of their own. The
// emptying is not an assignment and never carries the overwrite check, which is what makes `del(v);
// v = new(...)` pass it.
fn gen_del(gen.emitter mut* g, ast.node* n) void {
    if (ast.ast_len(n) != 1) {
        // The checker reported the arity and the module is not emitted.
        return;
    }
    ast.node* arg = ast.ast_child(n, 0);
    types.node* t = arg->ty;
    if (bad_type(t)) {
        return;
    }
    bool lvalue = is_place_expr(arg);
    bool header = gen.gen_is_aggregate(t);
    gen.gen_place mut place = gen.gen_place{};
    place.addr = gen.gen_literal(g, "ptr", "null");
    place.ty = t;
    gen.gen_val mut p = gen.gen_val{};
    if (header || lvalue) {
        place = gen_expr_place(g, arg);
        if (g->failed) {
            return;
        }
        if (header) {
            p = gen.gen_span_ptr(g, place.addr);
        } else {
            p = gen.gen_load_place(g, place);
        }
    } else {
        p = gen_expr_value(g, arg);
        if (g->failed) {
            return;
        }
    }
    gen.gen_args mut args = gen.gen_args_init();
    gen.gen_args_add(&args, p);
    gen.gen_call_rt(g, runtime_sig.rt_entry.rt_free, &args);
    gen.gen_args_free(&args);
    if (!lvalue) {
        // On an rvalue nothing is stored.
        return;
    }
    if (header) {
        gen.gen_memset_zero(g, place.addr, types.type_alignof(t), types.type_sizeof(t));
        return;
    }
    gen.gen_store_place(g, place, gen.gen_literal(g, "ptr", "null"));
}

// Returns the `new(T, n)` count as `i64`. A negative count causes a runtime error with its signed
// value at the builtin name. It is not a bounds check, so neither `--release` nor
// `--no-bounds-check` removes it.
fn alloc_count(gen.emitter mut* g, ast.node* n, ast.node* count) gen.gen_val {
    gen.gen_val raw = gen_expr_value(g, count);
    if (g->failed) {
        return raw;
    }
    bool sign = gen.gen_is_signed(count->ty);
    gen.gen_val v = gen.gen_resize(g, raw, gen.gen_int_bits(count->ty), "i64", BITS_64, sign);
    if (!sign) {
        // An unsigned count is never negative, so it takes no branch.
        return v;
    }
    gen.gen_val bad = gen.gen_icmp(g, "slt", v, gen.gen_const_unsigned(g, "i64", 0));
    gen.gen_args mut args = gen.gen_args_init();
    defer gen.gen_args_free(&args);
    gen.gen_args_add(&args, v);
    gen.gen_check(g, bad, true, runtime_sig.rt_entry.rt_fail_alloc_count, &args, n->loc);
    return v;
}

// Calls `std.rt.alloc(sizeof(T), count, loc)`. The runtime returns zeroed, nonnull storage,
// including when `n == 0`. It reports size overflow and allocation failure. The caller needs no
// result check.
fn alloc_call(gen.emitter mut* g, ast.node* n, types.node* elem,
                          gen.gen_val count) gen.gen_val {
    gen.gen_args mut args = gen.gen_args_init();
    defer gen.gen_args_free(&args);
    gen.gen_args_add(&args, gen.gen_const_unsigned(g, "i64", types.type_sizeof(elem)));
    gen.gen_args_add(&args, count);
    gen.gen_args_add_loc(g, &args, n->loc);
    return gen.gen_call_rt_value(g, runtime_sig.rt_entry.rt_alloc, "ptr", &args);
}

// `new(T)`: one zero-initialized `T`, whose address is an ordinary scalar.
fn gen_new_object(gen.emitter mut* g, ast.node* n) gen.gen_val {
    gen.gen_val null_val = gen.gen_literal(g, "ptr", "null");
    if (n->b != null || n->ty == null || n->ty->kind != types.type_kind.k_ptr) {
        // `new(T, n)` is a span and is written into a place; only the checker
        // could produce another shape, and it reports one.
        gen.gen_todo(g, n->loc, "this allocation");
        return null_val;
    }
    return alloc_call(g, n, n->ty->elem, gen.gen_const_unsigned(g, "i64", 1));
}

// `new(T, n)`: `n` zero-initialized elements, whose header is written into the
// destination place field by field.
fn gen_new_span(gen.emitter mut* g, ast.node* n, gen.gen_place dst) void {
    if (n->b == null || n->ty == null || n->ty->kind != types.type_kind.k_span) {
        gen.gen_todo(g, n->loc, "this allocation");
        return;
    }
    gen.gen_val count = alloc_count(g, n, n->b);
    if (g->failed) {
        return;
    }
    gen.gen_val p = alloc_call(g, n, n->ty->elem, count);
    gen.gen_span_init(g, dst.addr, p, count);
}

// Whether `n` is a call of the `move` builtin, the one universe function with
// a value, which every expression path lowers itself.
fn gen_is_move(ast.node* n) bool {
    ast.sym* mut s = null;
    if (n->kind == ast.ast_kind.k_call && n->a != null) {
        s = n->a->sym;
    }
    return s != null && s->kind == ast.sym_kind.s_builtin && s->name == "move";
}

// Emits `move(lv)`. It first reads the operand into an emitter temporary. It then zeros the operand
// and returns the saved value. `dst` is the place an aggregate result is written into and is null
// for a scalar one and on the discard path. The intermediate is not an optimization to drop: `dst`
// may be the operand itself, and nothing here can tell. The source and destination can alias in
// self-moves, pointer moves, and indexed moves. Copying to `dst` first would let source clearing
// destroy the result. The temporary prevents this. A scalar's intermediate is the register the
// `load` names; an aggregate's is a `%tmpK` slot. The emptying is not an assignment, so it carries
// no overwrite check.
fn gen_move(gen.emitter mut* g, ast.node* n, gen.gen_place* dst) gen.gen_val {
    gen.gen_val none = gen.gen_literal(g, "void", "");
    if (ast.ast_len(n) != 1 || bad_type(ast.ast_child(n, 0)->ty)) {
        // The checker reported the arity or the operand, so the module is not
        // emitted.
        return none;
    }
    ast.node* arg = ast.ast_child(n, 0);
    gen.gen_place src = gen_expr_place(g, arg);
    if (g->failed) {
        return none;
    }
    if (gen.gen_is_aggregate(arg->ty)) {
        u64 align = types.type_alignof(arg->ty);
        u64 size = types.type_sizeof(arg->ty);
        gen.gen_place held = gen.gen_temp_place(g, arg->ty);
        gen.gen_memcpy(g, held.addr, align, src.addr, align, size);
        gen.gen_zero_owner(g, src);
        if (dst != null) {
            gen.gen_memcpy(g, dst->addr, align, held.addr, align, size);
        }
        return none;
    }
    gen.gen_val v = gen.gen_load_place(g, src);
    gen.gen_zero_owner(g, src);
    return v;
}

// The call of a builtin: the print family, `assert` and `panic`.
// Returns false when `n` is not a builtin call.
fn gen_builtin_call(gen.emitter mut* g, ast.node* n) bool {
    ast.sym* mut s = null;
    if (n->a != null) {
        s = n->a->sym;
    }
    if (s == null || s->kind != ast.sym_kind.s_builtin) {
        return false;
    }
    string name = s->name;
    bool out = name == "print";
    bool outln = name == "println";
    bool err = name == "eprint";
    bool errln = name == "eprintln";
    if (out || outln || err || errln) {
        // `print` to stdout, `eprint` to stderr
        u64 mut which = FD_STDERR;
        if (out || outln) {
            which = FD_STDOUT;
        }
        gen.gen_val fd = gen.gen_const_unsigned(g, "i32", which);
        gen_print(g, n, fd, 0, outln || errln);
        return true;
    }
    bool fout = name == "fprint";
    bool foutln = name == "fprintln";
    if (fout || foutln) {
        gen.gen_val fd = gen_expr_value(g, ast.ast_child(n, 0));
        if (!g->failed) {
            gen_print(g, n, fd, 1, foutln);
        }
        return true;
    }
    if (name == "assert") {
        gen_assert(g, n);
        return true;
    }
    if (name == "panic") {
        gen_panic(g, n);
        return true;
    }
    if (name == "del") {
        gen_del(g, n);
        return true;
    }
    // the checker refuses a discarded `move`'s value
    gen_move(g, n, null);
    return true;
}

// ---- calls ---------------------------------------------------------------

// A function name used as a value denotes its address. A function pointer is an ordinary `ptr`. The
// forms `&f` and `*f` are errors. A qualified name `m.f` is the same value, since the symbol a
// field node resolved to is the function itself.
fn function_ref(gen.emitter mut* g, ast.node* n, gen.gen_val mut* out) bool {
    ast.sym* s = n->sym;
    // an `extern fn` in value position is a checker error
    if (s == null || s->kind != ast.sym_kind.s_fn) {
        return false;
    }
    out->ty = "ptr";
    out->val = gen.gen_symbol_ref(g, s);
    return true;
}

// Emits one fort or `extern` call argument. A scalar is an ordinary parameter. An aggregate is a
// plain `ptr` to a caller-allocated copy.
fn gen_call_arg(gen.emitter mut* g, gen.gen_args mut* args, ast.node* arg) void {
    types.node* t = arg->ty;
    if (gen.gen_is_aggregate(t)) {
        gen.gen_place copy = gen.gen_temp_place(g, t);
        gen_expr_into(g, arg, copy);
        gen.gen_args_add(args, copy.addr);
        return;
    }
    gen.gen_args_add_ext(args, gen_expr_value(g, arg), gen.gen_ext_attr(t));
}

// Writes call-site parameter types, such as `(i32, ptr)`. Aggregate parameters use plain `ptr`. An
// aggregate result adds the leading result pointer. An extern call ends the list with the variadic
// tail. A call through a function pointer never does, since there is no variadic function type.
fn gen_call_type(gen.emitter mut* g, types.node* sig, bool variadic) void {
    gen.gen_text_append(g, "(");
    u64 mut written = 0;
    if (gen.gen_is_aggregate(sig->elem)) {
        // An aggregate result is a leading `ptr` parameter.
        gen.gen_text_append(g, "ptr");
        written += 1;
    }
    u64 mut i = 0;
    while (i < sig->params.len) {
        if (written > 0) {
            gen.gen_text_append(g, ", ");
        }
        written += 1;
        types.node* pt = sig->params[i];
        // A struct, fixed array, span or `string` parameter is a plain `ptr`
        if (gen.gen_is_aggregate(pt)) {
            gen.gen_text_append(g, "ptr");
        } else {
            gen.gen_text_append(g, gen.gen_value_type(g, pt));
        }
        i += 1;
    }
    if (variadic) {
        if (written > 0) {
            gen.gen_text_append(g, ", ");
        }
        gen.gen_text_append(g, "...");
    }
    gen.gen_text_append(g, ") ");
}

// Emits a call to a fort function, `extern` function, or function pointer. `dst` receives an
// aggregate result. It is null for scalar or void results.
fn gen_call(gen.emitter mut* g, ast.node* n, gen.gen_place* dst) gen.gen_val {
    gen.gen_val none = gen.gen_literal(g, "void", "");
    ast.sym* mut s = null;
    if (n->a != null) {
        s = n->a->sym;
    }
    // only a name or a qualified name denotes a symbol
    bool direct = s != null &&
                  (s->kind == ast.sym_kind.s_fn || s->kind == ast.sym_kind.s_extern_fn);
    types.node* mut sig = null;
    if (direct) {
        sig = s->ty;
    } else if (n->a != null) {
        sig = n->a->ty;
    }
    if (sig == null || sig->kind != types.type_kind.k_fn) {
        // Only the checker can produce a callee that is not a function, and
        // it reports one, so this is unreachable. An unfinished path is a
        // diagnostic and never wrong code.
        gen.gen_todo(g, n->loc, "this callee");
        return none;
    }
    bool is_extern = direct && s->kind == ast.sym_kind.s_extern_fn;
    bool variadic = is_extern && (s->node->flags & ast.FLAG_VARIADIC) != 0;
    if (is_extern) {
        gen.gen_use_extern(g, s);
    }
    if (gen.gen_is_aggregate(sig->elem) && dst == null) {
        // An aggregate result needs the place it is written into;
        // reaching this without one would drop the `sret` argument.
        gen.gen_todo(g, n->loc, "an aggregate result read without a destination");
        return none;
    }
    gen.gen_val mut callee = none;
    if (direct) {
        callee.ty = "ptr";
        callee.val = gen.gen_symbol_ref(g, s);
    } else {
        // the callee is evaluated before the arguments
        callee = gen_expr_value(g, n->a);
        if (g->failed) {
            return none;
        }
    }
    gen.gen_args mut args = gen.gen_args_init();
    defer gen.gen_args_free(&args);
    if (dst != null) {
        // An aggregate result arrives through the leading `sret` pointer
        strbuf.str_buf mut attr = strbuf.create();
        defer strbuf.free(&attr);
        strbuf.append(&attr, "sret(");
        strbuf.append(&attr, gen.gen_mem_type(g, sig->elem));
        strbuf.push(&attr, ')');
        gen.gen_args_add_ext(&args, dst->addr, strbuf.view(&attr));
    }
    u64 mut i = 0;
    while (i < ast.ast_len(n)) {
        gen_call_arg(g, &args, ast.ast_child(n, i));
        if (g->failed) {
            return none;
        }
        i += 1;
    }
    string ret = gen.gen_result_type(g, sig->elem);
    bool has_value = ret != "void";
    gen.gen_val mut r = none;
    if (has_value) {
        r = gen.gen_temp(g, ret);
    } else {
        gen.gen_ins(g);
    }
    gen.gen_text_append(g, "call ");
    string ret_attr = gen.gen_ext_attr(sig->elem);
    if (ret_attr.len > 0) {
        gen.gen_text_append(g, ret_attr);
        gen.gen_text_append(g, " ");
    }
    gen.gen_text_append(g, ret);
    gen.gen_text_append(g, " ");
    if (variadic || !direct) {
        // An extern call uses the matching variadic call type to set the vector-register count. A
        // function-pointer call includes its function type because an opaque pointer carries none.
        gen_call_type(g, sig, variadic);
    }
    gen.gen_text_append(g, callee.val);
    gen.gen_text_append(g, "(");
    gen.gen_text_append(g, gen.gen_args_text(&args));
    gen.gen_text_append(g, ")");
    if (is_extern) {
        // `#3 = { nobuiltin }` on every extern call site. A runtime
        // entry point is not one, and its group carries no attribute.
        gen.gen_use_attr(g, gen.ATTR_NOBUILTIN);
        gen.gen_text_append(g, " #3");
    }
    gen.gen_ins_end(g);
    if (sig->is_noreturn) {
        // Every `noreturn` call site ends with a trap, including `extern` calls. The unadorned
        // declaration prevents optimizer removal. The trap catches an `extern` that returns.
        gen.gen_use_intrinsic(g, gen.IN_TRAP);
        gen.gen_use_attr(g, gen.ATTR_TRAP);
        gen.gen_ins(g);
        gen.gen_text_append(g, "call void @llvm.trap()");
        gen.gen_ins_end(g);
        gen.gen_ins(g);
        gen.gen_text_append(g, "unreachable");
        gen.gen_ins_end(g);
        g->terminated = true;
    }
    return r;
}

// ---- arithmetic and its checks ------------------------------------------

// Returns the overflow intrinsic for an operation and width. Families use `sadd ssub smul uadd usub
// umul` order. Each uses `i8 i16 i32 i64` order.
fn overflow_slot(u64 which, u32 bits) u64 {
    u64 mut width = 0;
    if (bits == BITS_16) {
        width = 1;
    } else if (bits == BITS_32) {
        width = 2;
    } else if (bits == BITS_64) {
        width = 3;
    }
    return gen.IN_OVERFLOW_FIRST + which * gen.OVF_WIDTHS + width;
}

// The slot of one saturating conversion: the family 's order and the
// index of the target width among `i8 i16 i32 i64`.
fn fpconv_slot(bool to_signed, bool from_f64, u32 bits) u64 {
    u64 mut family = gen.FP_SI_F32;
    if (to_signed && from_f64) {
        family = gen.FP_SI_F64;
    } else if (!to_signed && !from_f64) {
        family = gen.FP_UI_F32;
    } else if (!to_signed && from_f64) {
        family = gen.FP_UI_F64;
    }
    u64 mut width = 0;
    if (bits == BITS_16) {
        width = 1;
    } else if (bits == BITS_32) {
        width = 2;
    } else if (bits == BITS_64) {
        width = 3;
    }
    return gen.IN_FPCONV_FIRST + family * gen.FP_WIDTHS + width;
}

// The name of one overflow family. The C code switches over its enum. These fort values are
// constants because slot calculation needs arithmetic. This chain preserves the C switch order.
fn overflow_name(u64 which) string {
    if (which == gen.OVF_SADD) {
        return "sadd";
    } else if (which == gen.OVF_SSUB) {
        return "ssub";
    } else if (which == gen.OVF_SMUL) {
        return "smul";
    } else if (which == gen.OVF_UADD) {
        return "uadd";
    } else if (which == gen.OVF_USUB) {
        return "usub";
    }
    return "umul";
}

// Emits one checked operation. It calls the intrinsic, extracts the `{iN, i1}` values, and branches
// to std.rt.fail_overflow on failure.
fn gen_checked(gen.emitter mut* g, u64 which, gen.gen_val a, gen.gen_val b,
                           diag.loc at) gen.gen_val {
    string pair = pair_type(g, a.ty);
    gen.gen_val call = gen.gen_temp(g, pair);
    gen.gen_text_append(g, "call ");
    gen.gen_text_append(g, pair);
    gen.gen_text_append(g, " @llvm.");
    gen.gen_text_append(g, overflow_name(which));
    gen.gen_text_append(g, ".with.overflow.");
    gen.gen_text_append(g, a.ty);
    gen.gen_text_append(g, "(");
    gen.gen_text_append(g, a.ty);
    gen.gen_text_append(g, " ");
    gen.gen_text_append(g, a.val);
    gen.gen_text_append(g, ", ");
    gen.gen_text_append(g, a.ty);
    gen.gen_text_append(g, " ");
    gen.gen_text_append(g, b.val);
    gen.gen_text_append(g, ")");
    gen.gen_ins_end(g);
    gen.gen_val value = gen.gen_temp(g, a.ty);
    gen.gen_text_append(g, "extractvalue ");
    gen.gen_text_append(g, pair);
    gen.gen_text_append(g, " ");
    gen.gen_text_append(g, call.val);
    gen.gen_text_append(g, ", 0");
    gen.gen_ins_end(g);
    gen.gen_val bad = gen.gen_temp(g, "i1");
    gen.gen_text_append(g, "extractvalue ");
    gen.gen_text_append(g, pair);
    gen.gen_text_append(g, " ");
    gen.gen_text_append(g, call.val);
    gen.gen_text_append(g, ", 1");
    gen.gen_ins_end(g);
    gen.gen_args mut args = gen.gen_args_init();
    defer gen.gen_args_free(&args);
    gen.gen_check(g, bad, true, runtime_sig.rt_entry.rt_fail_overflow, &args, at);
    return value;
}

// `{ iN, i1 }`, the type an overflow intrinsic returns. It is built
// before the instruction that names it is opened, since both write into the
// emitter's one scratch buffer.
fn pair_type(gen.emitter mut* g, string ty) string {
    strbuf.clear(&g->scratch);
    strbuf.append(&g->scratch, "{ ");
    strbuf.append(&g->scratch, ty);
    strbuf.append(&g->scratch, ", i1 }");
    return gen.gen_take(g);
}

// Materializes a shift count at 64 bits to report negative values correctly. It checks the operand
// width, then truncates to the operand type. Thus, shifts do not produce poison.
fn gen_shift_count(gen.emitter mut* g, diag.loc at, types.node* atype,
                               types.node* bt, gen.gen_val b, u32 bits) gen.gen_val {
    gen.gen_val mut wide =
        gen.gen_resize(g, b, gen.gen_int_bits(bt), "i64", BITS_64, gen.gen_is_signed(bt));
    if (g->opts.release) {
        gen.gen_val mask = gen.gen_const_unsigned(g, "i64", cast(bits, u64) - 1);
        wide = gen.gen_binary(g, "and", wide, mask);
    } else {
        gen.gen_val limit = gen.gen_const_unsigned(g, "i64", cast(bits, u64));
        gen.gen_val bad = gen.gen_icmp(g, "uge", wide, limit);
        gen.gen_args mut args = gen.gen_args_init();
        defer gen.gen_args_free(&args);
        gen.gen_args_add(&args, wide);
        // `@.str.T` is the shifted operand's type name.
        string mut type_name = "integer";
        if (atype->kind == types.type_kind.k_prim) {
            type_name = prim.prim_name(atype->prim);
        }
        string text = gen.gen_str_ref(g, type_name);
        gen.gen_args_add(&args, gen.gen_literal(g, "ptr", text));
        gen.gen_check(g, bad, true, runtime_sig.rt_entry.rt_fail_shift, &args, at);
    }
    return gen.gen_resize(g, wide, BITS_64, gen.gen_value_type(g, atype), bits, false);
}

// Division and remainder, checked in both build modes.
fn gen_divide(gen.emitter mut* g, diag.loc at, i32 op, types.node* t, gen.gen_val a,
                          gen.gen_val b) gen.gen_val {
    bool sign = gen.gen_is_signed(t);
    u32 bits = gen.gen_int_bits(t);
    gen.gen_val zero = zero_of(g, t);
    gen.gen_val mut bad = gen.gen_icmp(g, "eq", b, zero);
    gen.gen_args mut args = gen.gen_args_init();
    gen.gen_check(g, bad, true, runtime_sig.rt_entry.rt_fail_div_zero, &args, at);
    gen.gen_args_free(&args);
    if (sign) {
        gen.gen_val minus_one = gen.gen_const_signed(g, a.ty, -1);
        gen.gen_val smallest = gen.gen_const_min(g, a.ty, bits);
        gen.gen_val is_minus_one = gen.gen_icmp(g, "eq", b, minus_one);
        gen.gen_val is_min = gen.gen_icmp(g, "eq", a, smallest);
        bad = gen.gen_binary(g, "and", is_minus_one, is_min);
        gen.gen_args mut over = gen.gen_args_init();
        gen.gen_check(g, bad, true, runtime_sig.rt_entry.rt_fail_div_overflow, &over, at);
        gen.gen_args_free(&over);
    }
    if (op == cast(lexer.tok_kind.percent, i32)) {
        if (sign) {
            return gen.gen_binary(g, "srem", a, b);
        }
        return gen.gen_binary(g, "urem", a, b);
    }
    if (sign) {
        return gen.gen_binary(g, "sdiv", a, b);
    }
    return gen.gen_binary(g, "udiv", a, b);
}

// Emits `a op b` for two scalars. Checked mode uses overflow intrinsics for arithmetic, unary
// minus, increments, and decrements. Release mode and wrapping operators use plain arithmetic. Both
// modes check shift counts and division. `atype` is the left operand and result type. `bt` is the
// right operand type, which differs only for shifts. `at` is the operator token for failures.
fn gen_arith(gen.emitter mut* g, diag.loc at, i32 op, types.node* atype,
                         gen.gen_val a, types.node* bt, gen.gen_val b) gen.gen_val {
    if (types.type_is_float(atype)) {
        return gen_float_arith(g, at, op, a, b);
    }
    bool sign = gen.gen_is_signed(atype);
    u32 bits = gen.gen_int_bits(atype);
    switch (cast(op, lexer.tok_kind)) {
    case lexer.tok_kind.plus, lexer.tok_kind.minus, lexer.tok_kind.star:
        return gen_add_sub_mul(g, at, op, sign, bits, a, b);
    case lexer.tok_kind.plus_wrap:
        return gen.gen_binary(g, "add", a, b);
    case lexer.tok_kind.minus_wrap:
        return gen.gen_binary(g, "sub", a, b);
    case lexer.tok_kind.star_wrap:
        return gen.gen_binary(g, "mul", a, b);
    case lexer.tok_kind.slash, lexer.tok_kind.percent:
        return gen_divide(g, at, op, atype, a, b);
    case lexer.tok_kind.amp:
        return gen.gen_binary(g, "and", a, b);
    case lexer.tok_kind.pipe:
        return gen.gen_binary(g, "or", a, b);
    case lexer.tok_kind.caret:
        return gen.gen_binary(g, "xor", a, b);
    case lexer.tok_kind.shl, lexer.tok_kind.shr:
        return gen_shift(g, at, op, atype, bt, a, b, bits, sign);
    default:
        gen.gen_todo(g, at, "this operator");
        return a;
    }
}

// `a op b` on two floats: `fadd`, `fsub`, `fmul` and `fdiv`, in both build modes and with no check
// of any kind. Float arithmetic does not trap. Division by zero yields infinity or NaN, and
// overflow yields infinity. Therefore, integer overflow intrinsics and division checks have no
// float form. No instruction here carries a fast-math flag, since floats are IEEE 754 and the
// optimizer may not reassociate them. `% & | ^ << >>` and the wrapping operators are checker errors
// on floats, so the operator is one of these four.
fn gen_float_arith(gen.emitter mut* g, diag.loc at, i32 op, gen.gen_val a,
                               gen.gen_val b) gen.gen_val {
    switch (cast(op, lexer.tok_kind)) {
    case lexer.tok_kind.plus:
        return gen.gen_binary(g, "fadd", a, b);
    case lexer.tok_kind.minus:
        return gen.gen_binary(g, "fsub", a, b);
    case lexer.tok_kind.star:
        return gen.gen_binary(g, "fmul", a, b);
    case lexer.tok_kind.slash:
        return gen.gen_binary(g, "fdiv", a, b);
    default:
        gen.gen_todo(g, at, "this operator on a float");
        return a;
    }
}

// Handles `+`, `-`, and `*` in a separate arm. fort case labels provide no block for the required
// local declaration.
fn gen_add_sub_mul(gen.emitter mut* g, diag.loc at, i32 op, bool sign, u32 bits,
                               gen.gen_val a, gen.gen_val b) gen.gen_val {
    bool is_plus = op == cast(lexer.tok_kind.plus, i32);
    bool is_minus = op == cast(lexer.tok_kind.minus, i32);
    if (g->opts.release) {
        // plain `add`; `nsw` and `nuw` are never emitted
        string mut plain = "mul";
        if (is_plus) {
            plain = "add";
        } else if (is_minus) {
            plain = "sub";
        }
        return gen.gen_binary(g, plain, a, b);
    }
    u64 mut which = gen.OVF_UADD;
    if (is_plus) {
        if (sign) {
            which = gen.OVF_SADD;
        } else {
            which = gen.OVF_UADD;
        }
    } else if (is_minus) {
        if (sign) {
            which = gen.OVF_SSUB;
        } else {
            which = gen.OVF_USUB;
        }
    } else {
        if (sign) {
            which = gen.OVF_SMUL;
        } else {
            which = gen.OVF_UMUL;
        }
    }
    gen.gen_use_intrinsic(g, overflow_slot(which, bits));
    gen.gen_use_attr(g, gen.ATTR_OVERFLOW);
    return gen_checked(g, which, a, b, at);
}

// `<<` and `>>`, the other arm with a body of its own.
fn gen_shift(gen.emitter mut* g, diag.loc at, i32 op, types.node* atype, types.node* bt,
             gen.gen_val a, gen.gen_val b, u32 bits, bool sign) gen.gen_val {
    gen.gen_val count = gen_shift_count(g, at, atype, bt, b, bits);
    if (op == cast(lexer.tok_kind.shl, i32)) {
        // `<<` discards the bits shifted out
        return gen.gen_binary(g, "shl", a, count);
    }
    // `>>` is arithmetic for signed, logical for unsigned
    if (sign) {
        return gen.gen_binary(g, "ashr", a, count);
    }
    return gen.gen_binary(g, "lshr", a, count);
}

// ---- comparisons ------------------------------------------------------------------

// The `icmp` predicate of a relational operator on a type: signedness is in
// the instruction and never in the type.
fn compare_pred(i32 op, bool sign) string {
    switch (cast(op, lexer.tok_kind)) {
    case lexer.tok_kind.eq:
        return "eq";
    case lexer.tok_kind.ne:
        return "ne";
    case lexer.tok_kind.lt:
        if (sign) {
            return "slt";
        }
        return "ult";
    case lexer.tok_kind.le:
        if (sign) {
            return "sle";
        }
        return "ule";
    case lexer.tok_kind.gt:
        if (sign) {
            return "sgt";
        }
        return "ugt";
    default:
        break;
    }
    if (sign) {
        return "sge";
    }
    return "uge";
}

// The `fcmp` predicate of a comparison on floats. Each predicate handles NaN. An ordered predicate
// is false when either operand is NaN. An unordered predicate is true in that case.
fn float_compare_pred(i32 op) string {
    switch (cast(op, lexer.tok_kind)) {
    case lexer.tok_kind.eq:
        // `oeq` is false on a NaN and true for `-0.0 == 0.0`
        return "oeq";
    case lexer.tok_kind.ne:
        // `une` is true on a NaN, which `NaN != NaN` demands
        return "une";
    case lexer.tok_kind.lt:
        // the four orderings are false on a NaN either way
        return "olt";
    case lexer.tok_kind.le:
        return "ole";
    case lexer.tok_kind.gt:
        return "ogt";
    default:
        return "oge";
    }
}

// `==` and `!=` on strings: the runtime compares the lengths and then the bytes,
// so the zero string equals `""`. The comparison is a runtime entry point because
// the compiler emits no call to a C library symbol of its own accord, memcmp
// included.
fn gen_string_compare(gen.emitter mut* g, ast.node* n) gen.gen_val {
    gen.gen_val mut aptr = gen.gen_val{};
    gen.gen_val mut alen = gen.gen_val{};
    string_operand(g, n->a, &aptr, &alen);
    gen.gen_val mut bptr = gen.gen_val{};
    gen.gen_val mut blen = gen.gen_val{};
    string_operand(g, n->b, &bptr, &blen);
    if (g->failed) {
        return gen.gen_literal(g, "i1", "false");
    }
    gen.gen_args mut args = gen.gen_args_init();
    gen.gen_args_add(&args, aptr);
    gen.gen_args_add(&args, alen);
    gen.gen_args_add(&args, bptr);
    gen.gen_args_add(&args, blen);
    // The entry point is `fn str_eq(...) bool`, and a fort `bool` result is `zeroext
    // i1`, so the value needs no narrowing. The attribute is not
    // decorative: a call site that states one the definition lacks changes what LLVM
    // may assume of the result.
    gen.gen_val eq = gen.gen_call_rt_value(g, runtime_sig.rt_entry.rt_str_eq, "i1", &args);
    gen.gen_args_free(&args);
    if (op_of(n) == lexer.tok_kind.eq) {
        return eq;
    }
    if (op_of(n) != lexer.tok_kind.ne) {
        // the checker rejects an ordering operator on strings
        gen.gen_todo(g, n->loc, "this comparison of strings");
        return eq;
    }
    return gen.gen_binary(g, "xor", eq, gen.gen_literal(g, "i1", "true"));
}

fn gen_compare(gen.emitter mut* g, ast.node* n) gen.gen_val {
    types.node* t = n->a->ty;
    if (t != null && t->kind == types.type_kind.k_string) {
        return gen_string_compare(g, n);
    }
    gen.gen_val a = gen_expr_value(g, n->a);
    gen.gen_val b = gen_expr_value(g, n->b);
    if (g->failed) {
        return gen.gen_literal(g, "i1", "false");
    }
    if (types.type_is_float(t)) {
        return gen.gen_fcmp(g, float_compare_pred(n->op), a, b);
    }
    return gen.gen_icmp(g, compare_pred(n->op, gen.gen_is_signed(t)), a, b);
}

// `&&` and `||` short-circuit through a stack slot rather than a `phi`, so the
// tree walk never has to know its predecessors.
fn gen_short_circuit(gen.emitter mut* g, ast.node* n) gen.gen_val {
    gen.gen_place slot = gen.gen_temp_place(g, n->ty);
    gen.gen_val lhs = gen_expr_value(g, n->a);
    if (g->failed) {
        return lhs;
    }
    gen.gen_store_place(g, slot, lhs);
    u64 rhs_block = gen.gen_label(g);
    u64 done = gen.gen_label(g);
    if (op_of(n) == lexer.tok_kind.and_and) {
        gen.gen_br_cond(g, lhs, rhs_block, done);
    } else {
        gen.gen_br_cond(g, lhs, done, rhs_block);
    }
    gen.gen_block_begin(g, rhs_block);
    gen.gen_val rhs = gen_expr_value(g, n->b);
    if (g->failed) {
        return rhs;
    }
    gen.gen_store_place(g, slot, rhs);
    gen.gen_br(g, done);
    gen.gen_block_begin(g, done);
    return gen.gen_load_place(g, slot);
}

// ---- the conditional operator ------------------------------------------------------

// `cond ? a: b`. The condition selects one arm, and only that arm runs. Both arm blocks write one
// destination, then meet at the continuation. Each arm ends with an unconditional `br`, without a
// `g->terminated` guard. A ternary arm cannot end a block. Only a no-result call terminates an
// expression, and check.check_ternary refuses it as having no value. gen_short_circuit uses the
// same structure. The destination is a stack slot, unlike the `phi` used by `&&` and `||`. Thus,
// the tree walk need not track predecessor blocks. `dst` is the place the value lands in, and it
// holds an aggregate arm as well.
fn gen_ternary(gen.emitter mut* g, ast.node* n, gen.gen_place dst) void {
    gen.gen_val cond = gen_expr_value(g, n->a);
    if (g->failed) {
        return;
    }
    u64 then_block = gen.gen_label(g);
    u64 else_block = gen.gen_label(g);
    u64 done = gen.gen_label(g);
    gen.gen_br_cond(g, cond, then_block, else_block);
    gen.gen_block_begin(g, then_block);
    gen_expr_into(g, n->b, dst);
    if (g->failed) {
        return;
    }
    gen.gen_br(g, done);
    gen.gen_block_begin(g, else_block);
    gen_expr_into(g, n->c, dst);
    if (g->failed) {
        return;
    }
    gen.gen_br(g, done);
    gen.gen_block_begin(g, done);
}

// The same as a scalar value: the slot the two arms wrote into is read back
// at the continuation.
fn gen_ternary_value(gen.emitter mut* g, ast.node* n) gen.gen_val {
    gen.gen_place slot = gen.gen_temp_place(g, n->ty);
    gen_ternary(g, n, slot);
    return gen.gen_load_place(g, slot);
}

// ---- casts --------------------------------------------------------------

fn gen_cast(gen.emitter mut* g, ast.node* n) gen.gen_val {
    types.node* to = n->ty;
    types.node* from = n->a->ty;
    gen.gen_val v = gen_expr_value(g, n->a);
    if (g->failed || bad_type(to) || bad_type(from)) {
        return v;
    }
    bool to_ptr = to->kind == types.type_kind.k_ptr || to->kind == types.type_kind.k_voidptr ||
                  to->kind == types.type_kind.k_fn;
    bool from_ptr = from->kind == types.type_kind.k_ptr ||
                    from->kind == types.type_kind.k_voidptr ||
                    from->kind == types.type_kind.k_fn;
    if (to_ptr && from_ptr) {
        // nothing for pointer to pointer or a dropped mark
        return v;
    }
    if (to_ptr) {
        return gen.gen_cast_op(g, "inttoptr", v, gen.gen_value_type(g, to));
    }
    if (from_ptr) {
        return gen.gen_cast_op(g, "ptrtoint", v, gen.gen_value_type(g, to));
    }
    if (types.type_is_float(to) || types.type_is_float(from)) {
        return gen_float_cast(g, n, to, from, v);
    }
    u32 from_bits = gen.gen_int_bits(from);
    u32 to_bits = gen.gen_int_bits(to);
    if (from_bits == 0 || to_bits == 0) {
        gen.gen_todo(g, n->loc, "this cast");
        return v;
    }
    if (is_bool(from)) {
        // nothing for `cast(b, bool)`, which is the identity
        return gen.gen_resize(g, v, from_bits, gen.gen_value_type(g, to), to_bits, false);
    }
    // Only `bool` converts to `bool`. The checker rejects integers and all other source types.
    // Thus, a `bool` target uses only the identity case above. Integer to integer widens by the
    // source's signedness.
    return gen.gen_resize(g, v, from_bits, gen.gen_value_type(g, to), to_bits,
                          gen.gen_is_signed(from));
}

// Emits casts with one or two float types. Float widths use `fptrunc` or `fpext`. Integers use
// `sitofp` or `uitofp` by source signedness. Float-to-integer uses a saturating intrinsic by target
// signedness. Plain `fptosi` produces poison out of range. The cast rule requires truncation toward
// zero, range saturation, zero for NaN, and no trap. The intrinsic provides these results. `char`,
// `bool` and an enum reach no float type and no float reaches them, so the checker has refused
// every other pairing.
fn gen_float_cast(gen.emitter mut* g, ast.node* n, types.node* to, types.node* from,
                              gen.gen_val v) gen.gen_val {
    string ty = gen.gen_value_type(g, to);
    if (types.type_is_float(to) && types.type_is_float(from)) {
        if (to->prim == from->prim) {
            // the identity emits nothing at all
            return v;
        }
        if (to->prim == prim.prim_kind.prim_f32) {
            return gen.gen_cast_op(g, "fptrunc", v, ty);
        }
        return gen.gen_cast_op(g, "fpext", v, ty);
    }
    if (types.type_is_float(to)) {
        if (gen.gen_is_signed(from)) {
            return gen.gen_cast_op(g, "sitofp", v, ty);
        }
        return gen.gen_cast_op(g, "uitofp", v, ty);
    }
    u32 bits = gen.gen_int_bits(to);
    if (bits == 0) {
        gen.gen_todo(g, n->loc, "this cast");
        return v;
    }
    bool to_signed = gen.gen_is_signed(to);
    bool from_f64 = from->prim == prim.prim_kind.prim_f64;
    u64 slot = fpconv_slot(to_signed, from_f64, bits);
    gen.gen_use_intrinsic(g, slot);
    gen.gen_use_attr(g, gen.ATTR_OVERFLOW);
    gen.gen_val r = gen.gen_temp(g, ty);
    gen.gen_text_append(g, "call ");
    gen.gen_text_append(g, ty);
    gen.gen_text_append(g, " @");
    gen.gen_fpconv_call_name(g, slot);
    gen.gen_text_append(g, "(");
    gen.gen_text_append(g, v.ty);
    gen.gen_text_append(g, " ");
    gen.gen_text_append(g, v.val);
    gen.gen_text_append(g, ")");
    gen.gen_ins_end(g);
    return r;
}

// ---- places --------------------------------------------------------------

// Returns an `i64` length for a fixed array, span, or `string`. A fixed array uses a literal. A
// span or string uses its header field.
fn gen_length_of(gen.emitter mut* g, types.node* t, gen.gen_val base) gen.gen_val {
    if (t->kind == types.type_kind.k_array) {
        // A fixed array's length is an `i64` literal.
        return gen.gen_const_unsigned(g, "i64", t->len);
    }
    return gen.gen_span_len(g, base);
}

// Returns the element type of a fixed array, span, or `string`. A string uses the stored `char`
// type. gen_mem_type still maps each element to IR, so one function defines that mapping.
fn gen_element_type(gen.emitter* g, types.node* t) types.node* {
    if (t == null) {
        return null;
    }
    if (t->kind == types.type_kind.k_string) {
        // a `string`'s type carries no element, so this node stands
        return &g->char_type;
    }
    return t->elem;
}

// The address of element `index` of such a place, by the array shape or the
// element shape.
fn gen_element_addr(gen.emitter mut* g, types.node* t, gen.gen_val base,
                                gen.gen_val index) gen.gen_val {
    if (t->kind == types.type_kind.k_array) {
        return gen.gen_gep_array(g, t, base, index);
    }
    // A span's elements are reached through its `.ptr`.
    gen.gen_val ptr = gen.gen_span_ptr(g, base);
    return gen.gen_gep_element(g, gen_element_type(g, t), ptr, index);
}

// Emits `e[i]`. It extends the index to `i64` and uses one `icmp uge` bounds check. It then
// addresses the element with the array or element shape.
fn gen_index_place(gen.emitter mut* g, ast.node* n) gen.gen_place {
    gen.gen_place mut out = gen.gen_place{};
    out.addr = gen.gen_literal(g, "ptr", "null");
    out.ty = n->ty;
    types.node* ot = n->a->ty;
    if (bad_type(ot)) {
        return out;
    }
    gen.gen_place operand = gen_expr_place(g, n->a);
    if (g->failed) {
        return out;
    }
    gen.gen_val raw = gen_expr_value(g, n->b);
    if (g->failed) {
        return out;
    }
    // A negative index fails the same compare, since it is extended by its
    // own signedness.
    gen.gen_val index = gen.gen_resize(g, raw, gen.gen_int_bits(n->b->ty), "i64", BITS_64,
                                       gen.gen_is_signed(n->b->ty));
    if (!g->opts.no_bounds_check) {
        gen.gen_val len = gen_length_of(g, ot, operand.addr);
        gen.gen_val bad = gen.gen_icmp(g, "uge", index, len);
        gen.gen_args mut args = gen.gen_args_init();
        gen.gen_args_add(&args, index);
        gen.gen_args_add(&args, len);
        gen.gen_check(g, bad, true, runtime_sig.rt_entry.rt_fail_bounds, &args, n->loc);
        gen.gen_args_free(&args);
    }
    out.addr = gen_element_addr(g, ot, operand.addr, index);
    return out;
}

// ---- span expressions -----------------------------------------------------

// One bound of a span expression as an `i64`, extended by its own signedness
// so that a negative bound fails the unsigned compares below.
fn span_bound(gen.emitter mut* g, ast.node* e) gen.gen_val {
    gen.gen_val raw = gen_expr_value(g, e);
    return gen.gen_resize(g, raw, gen.gen_int_bits(e->ty), "i64", BITS_64,
                          gen.gen_is_signed(e->ty));
}

// Handles `p[lo..hi]` on a raw pointer. This explicit unsafe form performs no check. Pointer
// operands use this arm of gen_span_expr.
fn gen_span_of_pointer(gen.emitter mut* g, ast.node* n, types.node* ot,
                            gen.gen_place dst) void {
    // a pointer has no length, so nothing is checked
    gen.gen_val base = gen_expr_value(g, n->a);
    if (g->failed) {
        return;
    }
    if (n->b == null || n->c == null) {
        // `p[lo..]` and its kin are checker errors, so this is dead
        gen.gen_todo(g, n->loc, "this span expression");
        return;
    }
    gen.gen_val lo = span_bound(g, n->b);
    gen.gen_val hi = span_bound(g, n->c);
    if (g->failed) {
        return;
    }
    // two instructions, so two statements, as below
    gen.gen_val at = gen.gen_gep_element(g, ot->elem, base, lo);
    gen.gen_val length = gen.gen_binary(g, "sub", hi, lo);
    gen.gen_span_init(g, dst.addr, at, length);
}

// Emits each bounded slice form as an operand view. One branch checks both bounds against the
// operand length.
fn gen_span_expr(gen.emitter mut* g, ast.node* n, gen.gen_place dst) void {
    types.node* mut ot = null;
    if (n->a != null) {
        ot = n->a->ty;
    }
    if (ot == null || bad_type(ot)) {
        return;
    }
    if (ot->kind == types.type_kind.k_ptr) {
        gen_span_of_pointer(g, n, ot, dst);
        return;
    }
    gen.gen_place operand = gen_expr_place(g, n->a);
    if (g->failed) {
        return;
    }
    // the operand then the bounds. An absent low bound is 0
    gen.gen_val mut lo = gen.gen_const_unsigned(g, "i64", 0);
    if (n->b != null) {
        lo = span_bound(g, n->b);
    }
    if (g->failed) {
        return;
    }
    gen.gen_val mut hi = gen.gen_val{};
    if (n->c != null) {
        hi = span_bound(g, n->c);
    } else {
        hi = gen_length_of(g, ot, operand.addr);
    }
    if (g->failed) {
        return;
    }
    if (!g->opts.no_bounds_check) {
        // The length is read after the bounds the source writes, so the check holds
        // against the length the operation sees. An absent high bound is that length and
        // was read above. With both bounds written and `--no-bounds-check` nothing reads
        // it, so nothing loads it.
        gen.gen_val mut len = hi;
        if (n->c != null) {
            len = gen_length_of(g, ot, operand.addr);
        }
        // `0 <= lo <= hi <= len` in one branch, unsigned
        gen.gen_val over = gen.gen_icmp(g, "ugt", hi, len);
        gen.gen_val inverted = gen.gen_icmp(g, "ugt", lo, hi);
        gen.gen_val bad = gen.gen_binary(g, "or", over, inverted);
        gen.gen_args mut args = gen.gen_args_init();
        gen.gen_args_add(&args, lo);
        gen.gen_args_add(&args, hi);
        gen.gen_args_add(&args, len);
        gen.gen_check(g, bad, true, runtime_sig.rt_entry.rt_fail_span, &args, n->loc);
        gen.gen_args_free(&args);
    }
    // two statements; C leaves two arguments' order unspecified
    gen.gen_val base = gen_element_addr(g, ot, operand.addr, lo);
    gen.gen_val length = gen.gen_binary(g, "sub", hi, lo);
    gen.gen_span_init(g, dst.addr, base, length);
}

fn gen_field_place(gen.emitter mut* g, ast.node* n, bool arrow) gen.gen_place {
    gen.gen_place mut out = gen.gen_place{};
    out.addr = gen.gen_literal(g, "ptr", "null");
    out.ty = n->ty;
    gen.gen_val mut base = gen.gen_val{};
    if (arrow) {
        base = gen_expr_value(g, n->a);
    } else {
        base = gen_expr_place(g, n->a).addr;
    }
    if (g->failed) {
        return out;
    }
    types.node* mut st = n->a->ty;
    if (arrow) {
        st = n->a->ty->elem;
    }
    u64 mut k = 0;
    if (st == null || st->kind != types.type_kind.k_struct || !gen.gen_field_index(n->sym, &k)) {
        gen.gen_todo(g, n->loc, "this field access");
        return out;
    }
    out.addr = gen.gen_gep_field(g, gen.gen_mem_type(g, st), base, k);
    return out;
}

// Returns the symbol that stores a module-level constant or global. A constant is an immutable
// lvalue in read-only memory. A `mut` global is assignable. Returns false when `n` denotes
// something else.
fn global_place(gen.emitter mut* g, ast.node* n, gen.gen_place mut* out) bool {
    ast.sym* s = n->sym;
    if (s == null || (s->kind != ast.sym_kind.s_const && s->kind != ast.sym_kind.s_global) ||
        bad_type(s->ty)) {
        return false;
    }
    gen.gen_val mut addr = gen.gen_val{};
    addr.ty = "ptr";
    addr.val = gen.gen_symbol_ref(g, s);
    out->addr = addr;
    // The declaration's own type, as a local's slot takes it from its symbol:
    // a place is storage, not the expression that reached it.
    out->ty = s->ty;
    return true;
}

// Returns the place of an rvalue. A field or index on an rvalue aggregate uses a temporary copy.
// String literals and aggregate call results use the same path.
fn rvalue_place(gen.emitter mut* g, ast.node* n) gen.gen_place {
    gen.gen_place tmp = gen.gen_temp_place(g, n->ty);
    gen_expr_into(g, n, tmp);
    return tmp;
}

fn gen_expr_place(gen.emitter mut* g, ast.node* n) gen.gen_place {
    gen.gen_place mut out = gen.gen_place{};
    out.addr = gen.gen_literal(g, "ptr", "null");
    out.ty = n->ty;
    if (g->failed) {
        return out;
    }
    switch (n->kind) {
    case ast.ast_kind.k_ident:
        if (n->sym != null && (n->sym->kind == ast.sym_kind.s_local ||
                               n->sym->kind == ast.sym_kind.s_param)) {
            return gen.gen_slot_place(g, n->sym);
        }
        if (global_place(g, n, &out)) {
            return out;
        }
        gen.gen_todo(g, n->loc, "a module-level name");
        return out;
    case ast.ast_kind.k_index:
        return gen_index_place(g, n);
    case ast.ast_kind.k_field:
        // `m.NAME` designates that module's storage
        if (global_place(g, n, &out)) {
            return out;
        }
        return gen_field_place(g, n, false);
    case ast.ast_kind.k_arrow:
        return gen_field_place(g, n, true);
    case ast.ast_kind.k_unary:
        if (op_of(n) == lexer.tok_kind.star) {
            out.addr = gen_expr_value(g, n->a);
            return out;
        }
    case ast.ast_kind.k_span, ast.ast_kind.k_string, ast.ast_kind.k_cfg,
         ast.ast_kind.k_struct_lit,
         ast.ast_kind.k_array_lit, ast.ast_kind.k_brace_init, ast.ast_kind.k_ternary:
        // a view is a value, so its header is built in a temporary
        // a literal member and a conditional are read out too
        return rvalue_place(g, n);
    case ast.ast_kind.k_cast, ast.ast_kind.k_call, ast.ast_kind.k_new:
        if (gen.gen_is_aggregate(n->ty)) {
            // Call results, aggregate casts, and spans from `new(T, n)` are also rvalues. Aggregate
            // casts only drop marks. Member access uses a copy, and `del(new(T, n))` frees the
            // copied pointer.
            return rvalue_place(g, n);
        }
    default:
        break;
    }
    gen.gen_todo(g, n->loc, "this expression as a place");
    return out;
}

// ---- values -----------------------------------------------------------------------

// A span or string stores `.len` and `.ptr` in header fields. For a fixed array, `.len` is a
// constant that the checker already folded.
fn pseudo_field_value(gen.emitter mut* g, ast.node* n, gen.gen_val mut* out) bool {
    // `->` reaches them too, since `p->f` is `(*p).f`
    bool arrow = n->kind == ast.ast_kind.k_arrow;
    types.node* mut ot = null;
    if (n->a != null) {
        ot = n->a->ty;
    }
    if (arrow) {
        if (ot != null && ot->kind == types.type_kind.k_ptr) {
            ot = ot->elem;
        } else {
            ot = null;
        }
    }
    if (ot == null ||
        (ot->kind != types.type_kind.k_span && ot->kind != types.type_kind.k_string)) {
        return false;
    }
    bool len = n->name == "len";
    bool ptr = n->name == "ptr";
    if (!len && !ptr) {
        return false;
    }
    // the pointer's target for `->`, the operand for `.`
    gen.gen_val mut base = gen.gen_val{};
    if (arrow) {
        base = gen_expr_value(g, n->a);
    } else {
        base = gen_expr_place(g, n->a).addr;
    }
    if (g->failed) {
        *out = gen.gen_literal(g, "i64", "0");
        return true;
    }
    if (len) {
        *out = gen.gen_span_len(g, base);
    } else {
        *out = gen.gen_span_ptr(g, base);
    }
    return true;
}

fn gen_unary_value(gen.emitter mut* g, ast.node* n) gen.gen_val {
    if (op_of(n) == lexer.tok_kind.amp) {
        gen.gen_place mut p = gen_expr_place(g, n->a);
        p.addr.ty = "ptr";
        return p.addr;
    }
    if (op_of(n) == lexer.tok_kind.star) {
        return gen.gen_load_place(g, gen_expr_place(g, n));
    }
    gen.gen_val v = gen_expr_value(g, n->a);
    if (g->failed) {
        return v;
    }
    if (op_of(n) == lexer.tok_kind.bang) {
        return gen.gen_binary(g, "xor", v, gen.gen_literal(g, "i1", "true"));
    }
    if (op_of(n) == lexer.tok_kind.tilde) {
        // `~x` is `x ^ -1` and never overflows
        return gen.gen_binary(g, "xor", v, gen.gen_const_signed(g, v.ty, -1));
    }
    if (types.type_is_float(n->ty)) {
        // Emits float unary `-` as `fneg`, not subtraction from zero. The operations differ for
        // signed zero. They also differ in the NaN sign bit. No fast-math flag.
        return gen.gen_unary_op(g, "fneg", v);
    }
    // Unary `-` is `0 - x` and uses the same intrinsics as `-`.
    return gen_arith(g, n->loc, cast(lexer.tok_kind.minus, i32), n->ty, zero_of(g, n->ty), n->ty,
                     v);
}

fn gen_binary_value(gen.emitter mut* g, ast.node* n) gen.gen_val {
    switch (op_of(n)) {
    case lexer.tok_kind.eq, lexer.tok_kind.ne, lexer.tok_kind.lt, lexer.tok_kind.le,
         lexer.tok_kind.gt, lexer.tok_kind.ge:
        return gen_compare(g, n);
    case lexer.tok_kind.and_and, lexer.tok_kind.pipe_pipe:
        return gen_short_circuit(g, n);
    default:
        break;
    }
    gen.gen_val a = gen_expr_value(g, n->a);
    gen.gen_val b = gen_expr_value(g, n->b);
    if (g->failed) {
        return a;
    }
    return gen_arith(g, n->loc, n->op, n->a->ty, a, n->b->ty, b);
}

fn gen_expr_value(gen.emitter mut* g, ast.node* n) gen.gen_val {
    if (g->failed || n == null || bad_type(n->ty)) {
        return gen.gen_literal(g, "i32", "0");
    }
    if (folded_scalar(g, n)) {
        // a constant expression has no side effects
        return gen.gen_const_value(g, n->ty, check.check_node_value(g->ck, n));
    }
    switch (n->kind) {
    case ast.ast_kind.k_ident:
        gen.gen_val mut fn_val = gen.gen_val{};
        // a function name has no storage to load from
        if (function_ref(g, n, &fn_val)) {
            return fn_val;
        }
        return gen.gen_load_place(g, gen_expr_place(g, n));
    case ast.ast_kind.k_index:
        return gen.gen_load_place(g, gen_expr_place(g, n));
    case ast.ast_kind.k_arrow:
        gen.gen_val mut header = gen.gen_val{};
        if (pseudo_field_value(g, n, &header)) {
            return header;
        }
        return gen.gen_load_place(g, gen_expr_place(g, n));
    case ast.ast_kind.k_field:
        gen.gen_val mut v = gen.gen_val{};
        // `m.f` is the function's address, not a field
        if (function_ref(g, n, &v)) {
            return v;
        }
        if (pseudo_field_value(g, n, &v)) {
            return v;
        }
        return gen.gen_load_place(g, gen_expr_place(g, n));
    case ast.ast_kind.k_unary:
        return gen_unary_value(g, n);
    case ast.ast_kind.k_binary:
        return gen_binary_value(g, n);
    case ast.ast_kind.k_ternary:
        return gen_ternary_value(g, n);
    case ast.ast_kind.k_cast:
        return gen_cast(g, n);
    case ast.ast_kind.k_call:
        // the one universe function with a value
        if (gen_is_move(n)) {
            return gen_move(g, n, null);
        }
        if (gen_builtin_call(g, n)) {
            return gen.gen_literal(g, "void", "");
        }
        return gen_call(g, n, null);
    case ast.ast_kind.k_brace_init:
        // a zeroed enum holds 0 even when 0 is not a member
        if (ast.ast_len(n) == 0) {
            return zero_of(g, n->ty);
        }
    case ast.ast_kind.k_new:
        // `new(T)` is a scalar; `new(T, n)` is written into a place
        return gen_new_object(g, n);
    default:
        break;
    }
    gen.gen_todo(g, n->loc, "this expression");
    return gen.gen_literal(g, "i32", "0");
}

// ---- values written into a place ---------------------------------------------------

// The members of a positional struct literal, in the field order of the
// declaration: the arm of gen_brace_init an undesignated struct takes.
fn positional_struct(gen.emitter mut* g, ast.node* n, gen.gen_place dst) void {
    types.node* t = dst.ty;
    ast.sym* s = check.nominal_sym(t);
    u64 mut at = 0;
    u64 mut i = 0;
    while (s != null && s->node != null && i < ast.ast_len(s->node)) {
        ast.node* f = ast.ast_child(s->node, i);
        if (f->kind == ast.ast_kind.k_field_decl) {
            if (at >= ast.ast_len(n)) {
                return;
            }
            gen.gen_place mut field = gen.gen_place{};
            field.ty = f->ty;
            field.addr = gen.gen_gep_field(g, gen.gen_mem_type(g, t), dst.addr, at);
            gen_expr_into(g, ast.ast_child(n, at), field);
            if (g->failed) {
                return;
            }
            at += 1;
        }
        i += 1;
    }
}

// The `.field = value` members of a designated struct literal.
fn designated_struct(gen.emitter mut* g, ast.node* n, gen.gen_place dst) void {
    types.node* t = dst.ty;
    // the designated form zeroes first, omitted fields being zero
    gen.gen_memset_zero(g, dst.addr, types.type_alignof(t), types.type_sizeof(t));
    u64 mut i = 0;
    while (i < ast.ast_len(n)) {
        ast.node* d = ast.ast_child(n, i);
        u64 mut k = 0;
        if (d->kind != ast.ast_kind.k_designator || !gen.gen_field_index(d->sym, &k)) {
            gen.gen_todo(g, d->loc, "this initializer");
            return;
        }
        gen.gen_place mut field = gen.gen_place{};
        field.ty = d->a->ty;
        field.addr = gen.gen_gep_field(g, gen.gen_mem_type(g, t), dst.addr, k);
        gen_expr_into(g, d->a, field);
        if (g->failed) {
            return;
        }
        i += 1;
    }
}

// A `{... }` initializer: `{}` zeroes the place with `llvm.memset` and every
// other form writes member by member.
fn gen_brace_init(gen.emitter mut* g, ast.node* n, gen.gen_place dst) void {
    types.node* t = dst.ty;
    if (ast.ast_len(n) == 0) {
        gen.gen_memset_zero(g, dst.addr, types.type_alignof(t), types.type_sizeof(t));
        return;
    }
    if (t->kind == types.type_kind.k_array) {
        u64 mut i = 0;
        while (i < ast.ast_len(n)) {
            gen.gen_place mut elem = gen.gen_place{};
            elem.ty = t->elem;
            elem.addr = gen.gen_gep_array(g, t, dst.addr, gen.gen_const_unsigned(g, "i64", i));
            gen_expr_into(g, ast.ast_child(n, i), elem);
            if (g->failed) {
                return;
            }
            i += 1;
        }
        return;
    }
    if (t->kind != types.type_kind.k_struct) {
        gen.gen_todo(g, n->loc, "this initializer");
        return;
    }
    if ((n->flags & ast.FLAG_DESIGNATED) != 0) {
        designated_struct(g, n, dst);
        return;
    }
    positional_struct(g, n, dst);
}

// An expression written into `dst`, which is how every aggregate is produced.
// A scalar expression stores its value.
fn gen_expr_into(gen.emitter mut* g, ast.node* n, gen.gen_place dst) void {
    if (g->failed || n == null || bad_type(n->ty)) {
        return;
    }
    if (!gen.gen_is_aggregate(dst.ty)) {
        gen.gen_store_place(g, dst, gen_expr_value(g, n));
        return;
    }
    switch (n->kind) {
    case ast.ast_kind.k_brace_init:
        gen_brace_init(g, n, dst);
        return;
    case ast.ast_kind.k_struct_lit, ast.ast_kind.k_array_lit:
        gen_brace_init(g, n->b, dst);
        return;
    case ast.ast_kind.k_string, ast.ast_kind.k_cfg:
        // the bytes and the length the trailing NUL excludes
        gen.gen_val mut ptr = gen.gen_val{};
        gen.gen_val mut len = gen.gen_val{};
        string_operand(g, n, &ptr, &len);
        gen.gen_span_init(g, dst.addr, ptr, len);
        return;
    case ast.ast_kind.k_call:
        if (gen_is_move(n)) {
            // A span, a `string` or an owning aggregate is copied into the
            // destination and the operand is then zeroed.
            gen_move(g, n, &dst);
            return;
        }
        if (!gen_builtin_call(g, n)) {
            gen_call(g, n, &dst);
        }
        return;
    case ast.ast_kind.k_cast:
        // a cast between aggregates only drops marks
        gen_expr_into(g, n->a, dst);
        return;
    case ast.ast_kind.k_new:
        gen_new_span(g, n, dst);
        return;
    case ast.ast_kind.k_span:
        gen_span_expr(g, n, dst);
        return;
    case ast.ast_kind.k_ternary:
        // an aggregate arm writes into the destination itself
        gen_ternary(g, n, dst);
        return;
    default:
        break;
    }
    if ((n->ann & check.ANN_CONST) != 0 &&
        check.check_node_value(g->ck, n).kind == consts.cval_kind.cv_str) {
        gen.gen_val mut ptr = gen.gen_val{};
        gen.gen_val mut len = gen.gen_val{};
        string_operand(g, n, &ptr, &len);
        gen.gen_span_init(g, dst.addr, ptr, len);
        return;
    }
    // every other aggregate is an lvalue, so the value is a copy
    gen.gen_place src = gen_expr_place(g, n);
    if (g->failed) {
        return;
    }
    u64 align = types.type_alignof(dst.ty);
    gen.gen_memcpy(g, dst.addr, align, src.addr, align, types.type_sizeof(dst.ty));
}

// An expression evaluated for its effects alone: a call statement.
fn gen_expr_discard(gen.emitter mut* g, ast.node* n) void {
    if (g->failed || n == null) {
        return;
    }
    if (n->kind == ast.ast_kind.k_call) {
        if (gen_builtin_call(g, n)) {
            return;
        }
        if (gen.gen_is_aggregate(n->ty)) {
            // An aggregate result still needs a place, which nothing reads
            gen.gen_place sink = gen.gen_temp_place(g, n->ty);
            gen_call(g, n, &sink);
            return;
        }
        gen_call(g, n, null);
        return;
    }
    gen.gen_todo(g, n->loc, "this statement expression");
}
