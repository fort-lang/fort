/// Loads modules and resolves import closures.
/// Modules appear in dependency order, with each import before its importer.
import ast;
import comptime;
import containers;
import diag;
import lexer;
import parser;
import scope;
import session;
import std.libc;
import std.os;
import std.str;
import std.strbuf;
import std.strmap;

// The buffer size getcwd is given. A working directory above this size makes
// getcwd fail, and a relative path then goes to realpath as it is.
u64 CWD_CAP = 4096;

// The extension of a fort source file; a file with any other extension is
// never a module.
string MODULE_SUFFIX = ".ft";

// The separator of module paths and the one of file paths.
char PATH_SEPARATOR = '.';
char DIRECTORY_SEPARATOR = '/';

// The first segment reserved for the standard library. A path that starts with
// it uses only the standard library directory. No other path uses that directory.
string STD_SEGMENT = "std";

// Each closure holds the runtime. The compiler loads it as a root beside the
// entry file for builds and `--check`. It is parsed, checked, and emitted like
// other modules. Membership does not bind the
// name: a module that wants to call it writes `import std.rt;` like any other
// importer.
string RUNTIME_PATH = "std.rt";
string RUNTIME_FILE = "rt.ft";

// The first non-zero capacity of the module vectors; growth doubles from
// there.
u64 VEC_MIN_CAP = 8;

// Where a module stands in the walk of the import closure.
enum module_state {
    m_loading, // on the current import path: reaching it again is a cycle
    m_ready,   // its imports are resolved and it is in the dependency order
}

/// One module of the closure.
struct module {
    string path; // the module path, `std.io`
    string file; // the file as the compiler opened it, its `<file>`
    string real; // the real path: the module's identity
    string source;     // the file's bytes, which the tree's names point into
    ast.node mut* ast; // the module node, complete only when `parsed`
    scope.scope names; // the module namespace
    bool parsed;       // no diagnostic was reported while lexing and parsing it
    bool selected;     // compile-time selection completed without a diagnostic
    bool entry; // the module named on the command line
    module_state state;
}

// Stores modules at stable addresses for the order and stack vectors.
struct owned_modules {
    module mut* own mut@ own items;
    u64 len;
}

// Stores the dependency order or the import path being walked.
struct module_vec {
    module mut* mut@ own items;
    u64 len;
}

/// Holds an import closure, search roots, and loader state.
/// A zero value is ready for use.
struct module_set {
    owned_modules modules;     // in read order
    module_vec order; // an imported module before its importers
    module_vec stack; // the import path being walked, for cycles
    containers.str_vec roots; // the `-I` roots, interned, in command-line order
    strmap.str_map by_path;    // module path -> position in `modules`
    strmap.str_map by_real; // real path -> position in `modules`, the identity map
    string entry_dir;          // the first root: the directory containing the entry file
    string std_dir;            // the standard library directory, the last root
    string cwd;                // the working directory, read once for the set; "" before
    containers.pool pool;      // interned paths and file names
    ast.arena arena;           // syntax trees for the module set
    strbuf.str_buf msg;        // the message under construction
    bool stopped; // a module has errors: read no further file
}

// ---- the module vectors ------------------------------------------------------------

// Ensures room for one more module, growing to the largest of VEC_MIN_CAP and
// twice the capacity.
fn owned_reserve(owned_modules mut* v) void {
    if (v->len < v->items.len) {
        return;
    }
    u64 mut cap = VEC_MIN_CAP;
    if (v->items.len >= cap) {
        // nothing here may detect an overflow by performing one
        if (v->items.len > containers.U64_MAX / 2) {
            panic("modules.owned_reserve: capacity overflow");
        }
        cap = v->items.len * 2;
    }
    module mut* own mut@ own bigger = new(module mut* own, cap);
    u64 mut i = 0;
    while (i < v->len) {
        bigger[i] = move(v->items[i]);
        i += 1;
    }
    del(v->items);
    v->items = move(bigger);
}

// Ensures room for one more vector element.
fn vec_reserve(module_vec mut* v) void {
    if (v->len < v->items.len) {
        return;
    }
    u64 mut cap = VEC_MIN_CAP;
    if (v->items.len >= cap) {
        if (v->items.len > containers.U64_MAX / 2) {
            panic("modules.vec_reserve: capacity overflow");
        }
        cap = v->items.len * 2;
    }
    module mut* mut@ own bigger = new(module mut*, cap);
    u64 mut i = 0;
    while (i < v->len) {
        bigger[i] = v->items[i];
        i += 1;
    }
    del(v->items);
    v->items = move(bigger);
}

fn vec_push(module_vec mut* v, module mut* m) void {
    vec_reserve(v);
    v->items[v->len] = m;
    v->len += 1;
}

// Drops the last element; an empty vector is a violated precondition, since a
// pop with no push is a walk that lost its balance.
fn vec_pop(module_vec mut* v) void {
    if (v->len == 0) {
        panic("modules.vec_pop: the vector is empty");
    }
    v->len -= 1;
}

// ---- messages ---------------------------------------------------------------------

// Empties the message buffer; the three below append to it, as the msg_*
// family of bootstrap0/src/diag.h does over an sb_t.
fn msg_begin(module_set mut* set) void {
    strbuf.clear(&set->msg);
}

fn msg_str(module_set mut* set, string text) void {
    strbuf.append(&set->msg, text);
}

// Appends a name between single quotes: 'name'.
fn msg_quote(module_set mut* set, string name) void {
    strbuf.push(&set->msg, '\'');
    strbuf.append(&set->msg, name);
    strbuf.push(&set->msg, '\'');
}

fn msg_end(module_set* set) string {
    return strbuf.view(&set->msg);
}

// Interns the message buffer and then clears it.
fn take(module_set mut* set) string {
    string kept = containers.pool_intern(&set->pool, strbuf.view(&set->msg));
    strbuf.clear(&set->msg);
    return kept;
}

// ---- paths ------------------------------------------------------------------------

// Returns the path directory without its trailing separator. The entry file
// directory is the first search root. A path without a directory returns an
// empty string.
fn directory_of(string path) string {
    u64 mut len = 0;
    bool mut separated = false;
    u64 mut i = 0;
    while (i < path.len) {
        if (path[i] == DIRECTORY_SEPARATOR) {
            len = i;
            separated = true;
        }
        i += 1;
    }
    if (separated && len == 0) {
        // an empty root would mean the current directory, never a root
        return path[0..1];
    }
    return path[0..len];
}

// The last path component without its `.ft` suffix.
// For example, `src/app.ft` gives the entry module path `app`.
fn base_name(string path) string {
    u64 mut start = 0;
    u64 mut i = 0;
    while (i < path.len) {
        if (path[i] == DIRECTORY_SEPARATOR) {
            start = i + 1;
        }
        i += 1;
    }
    string base = path[start..path.len];
    if (base.len > MODULE_SUFFIX.len && str.ends_with(base, MODULE_SUFFIX)) {
        return base[0..base.len - MODULE_SUFFIX.len];
    }
    return base;
}

// Whether `base` contains the `.` that spells a module path. Symbol mangling
// reads that character. All other characters enter the symbol unchanged and
// cannot spell a path.
fn holds_path_separator(string base) bool {
    return str.index_of(base, PATH_SEPARATOR) >= 0;
}

// The `i`-th segment of an import path: the path node holds one identifier per
// segment, in source order.
fn segment_at(ast.node* path, u64 i) string {
    return ast.ast_child(path, i)->name;
}

// The first `n` segments joined with `.`, the spelling of a module path in a
// diagnostic.
fn path_text(module_set mut* set, ast.node* path, u64 n) string {
    msg_begin(set);
    u64 mut i = 0;
    while (i < n) {
        if (i > 0) {
            strbuf.push(&set->msg, PATH_SEPARATOR);
        }
        msg_str(set, segment_at(path, i));
        i += 1;
    }
    return take(set);
}

// `<dir>/<segments from..n joined with '/'>.ft` in `out`: the file the segments
// name under one root, `/` standing for the `.` of the module path. A root of
// zero length, which the entry file's directory is when the entry names no
// directory, contributes no separator.
fn file_of(strbuf.str_buf mut* out, string dir, ast.node* path, u64 from, u64 n) string {
    strbuf.clear(out);
    if (dir.len > 0) {
        strbuf.append(out, dir);
        if (dir[dir.len - 1] != DIRECTORY_SEPARATOR) {
            strbuf.push(out, DIRECTORY_SEPARATOR);
        }
    }
    u64 mut i = from;
    while (i < n) {
        if (i > from) {
            strbuf.push(out, DIRECTORY_SEPARATOR);
        }
        strbuf.append(out, segment_at(path, i));
        i += 1;
    }
    strbuf.append(out, MODULE_SUFFIX);
    return strbuf.view(out);
}

// Whether the path begins with the reserved segment `std`.
fn is_std_path(ast.node* path, u64 n) bool {
    return n > 0 && segment_at(path, 0) == STD_SEGMENT;
}

// Count the possible files for the first `n` segments, one per search root.
// A path that starts with `std` has one possible file in the standard library
// directory. `std` names that directory, so `import std;` names no file. Other
// paths use the entry directory and `-I` roots. They never use the standard
// library directory.
fn selection_count(module_set* set, ast.node* path, u64 n) u64 {
    if (n == 0) {
        return 0;
    }
    if (is_std_path(path, n)) {
        if (n >= 2 && set->std_dir.len > 0) {
            return 1;
        }
        return 0;
    }
    return 1 + set->roots.len;
}

// The `i`-th selected file of the first `n` segments, the roots in order,
// built into `out`.
fn selection_at(module_set* set, strbuf.str_buf mut* out, ast.node* path, u64 n, u64 i) string {
    if (is_std_path(path, n)) {
        // `std.io` is `<std>/io.ft`
        return file_of(out, set->std_dir, path, 1, n);
    }
    if (i == 0) {
        return file_of(out, set->entry_dir, path, 0, n);
    }
    return file_of(out, containers.str_at(&set->roots, i - 1), path, 0, n);
}

// ---- the file system ----------------------------------------------------------------

// Whether `path` names a readable file.
fn file_exists(string path) bool {
    char mut@ own c_path = str.to_cstr(path);
    defer del(c_path);
    return libc.access(c_path.ptr, libc.R_OK) == 0;
}

// Finds the first root with a file for the first `n` path segments.
// Returns false with `out` unchanged when no root contains the file.
// Only a found path is interned, so the loader keeps no copy of a
// path it merely looked at.
fn find_file(module_set mut* set, ast.node* path, u64 n, string mut* out) bool {
    u64 count = selection_count(set, path, n);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    u64 mut i = 0;
    while (i < count) {
        string file = selection_at(set, &b, path, n, i);
        if (file_exists(file)) {
            *out = containers.pool_intern(&set->pool, file);
            return true;
        }
        i += 1;
    }
    return false;
}

// The working directory, read once for the set. realpath reads it for each
// relative path, and on macOS getcwd walks the entries of every directory on
// the way up: 93% of a `-S` round of test/fort's closure probe went there.
fn working_dir(module_set mut* set) string {
    if (set->cwd.len == 0) {
        char mut@ own buf = new(char, CWD_CAP);
        defer del(buf);
        if (libc.getcwd(buf.ptr, CWD_CAP) != null) {
            set->cwd = containers.pool_intern(&set->pool, str.from_cstr(buf.ptr));
        }
    }
    return set->cwd;
}

// The real path of a file, symbolic links and `..` resolved: a module's
// identity. A path realpath cannot resolve stands for itself, so a file that
// vanished between the probe and here is still one module. A relative path
// is joined to the working directory first, so realpath does not read it.
fn real_path(module_set mut* set, string path) string {
    strbuf.str_buf mut joined = strbuf.create();
    defer strbuf.free(&joined);
    string cwd = working_dir(set);
    if (path.len > 0 && path[0] != '/' && cwd.len > 0) {
        strbuf.append(&joined, cwd);
        strbuf.push(&joined, '/');
    }
    strbuf.append(&joined, path);
    strbuf.str_buf mut resolved = strbuf.create();
    defer strbuf.free(&resolved);
    if (!os.real_path(strbuf.view(&joined), &resolved)) {
        return containers.pool_intern(&set->pool, path);
    }
    return containers.pool_intern(&set->pool, strbuf.view(&resolved));
}

// ---- diagnostics ------------------------------------------------

// The position of an error without one in the file: 1:1.
fn file_start(string file) diag.loc {
    return diag.loc_make(file, 1, 1);
}

// `note: looked for <path>` once per root and reading, the notes a module
// that was not found carries.
fn note_selections(session.session mut* s, module_set mut* set, diag.loc at, ast.node* path,
                        u64 n) void {
    u64 count = selection_count(set, path, n);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    u64 mut i = 0;
    while (i < count) {
        // Quotes the path from its construction buffer. The message copies
        // the bytes, and the sink copies them again. Thus, the loader does not
        // intern a path that it only probes.
        msg_begin(set);
        msg_str(set, "looked for ");
        msg_str(set, selection_at(set, &b, path, n, i));
        diag.note(session.diags(s), at, msg_end(set));
        i += 1;
    }
}

// `module 'util.strings' not found`: no file exists for either reading.
fn error_not_found(session.session mut* s, module_set mut* set, diag.loc at, ast.node* path,
                        u64 n) void {
    string name = path_text(set, path, n);
    msg_begin(set);
    msg_str(set, "module ");
    msg_quote(set, name);
    msg_str(set, " not found");
    diag.error(session.diags(s), at, msg_end(set));
    note_selections(s, set, at, path, n);
    if (n >= 2) {
        note_selections(s, set, at, path, n - 1);
    }
}

// `module 'util' has no declaration named 'strngs'`: the symbol reading found
// the file of the prefix, which declares no such name.
fn error_no_declaration(session.session mut* s, module_set mut* set, diag.loc at,
                             string from_path, string name) void {
    msg_begin(set);
    msg_str(set, "module ");
    msg_quote(set, from_path);
    msg_str(set, " has no declaration named ");
    msg_quote(set, name);
    diag.error(session.diags(s), at, msg_end(set));
}

// `cannot import 'x': it is an import of module 'a.b'`: the import bindings of
// another module are not importable, there is no re-export.
fn error_not_exported(session.session mut* s, module_set mut* set, diag.loc at,
                           string from_path, string name) void {
    msg_begin(set);
    msg_str(set, "cannot import ");
    msg_quote(set, name);
    msg_str(set, ": it is an import of module ");
    msg_quote(set, from_path);
    diag.error(session.diags(s), at, msg_end(set));
}

// `ambiguous import 'a.b.c': a/b/c.ft and a/b.ft exist`: both readings
// succeed, whichever roots the two files live under.
fn error_ambiguous(session.session mut* s, module_set mut* set, diag.loc at, ast.node* path,
                        u64 n, string module_file, string prefix_file) void {
    string name = path_text(set, path, n);
    msg_begin(set);
    msg_str(set, "ambiguous import ");
    msg_quote(set, name);
    msg_str(set, ": ");
    msg_str(set, module_file);
    msg_str(set, " and ");
    msg_str(set, prefix_file);
    msg_str(set, " exist");
    diag.error(session.diags(s), at, msg_end(set));
}

// Reports a `.` in an entry file base name. That base name is the entry module
// path. A `.` would spell another module symbol prefix and make mangling
// ambiguous.
fn error_entry_name_separator(session.session mut* s, module_set mut* set, diag.loc at,
                                   string base) void {
    msg_begin(set);
    msg_str(set, "entry file name ");
    msg_quote(set, base);
    msg_str(set, " cannot contain '");
    strbuf.push(&set->msg, PATH_SEPARATOR);
    msg_str(set, "'");
    diag.error(session.diags(s), at, msg_end(set));
}

// Reports one file reached through two module paths. The real file path defines
// module identity.
fn error_same_file(session.session mut* s, module_set mut* set, diag.loc at, string path,
                        string other, string real) void {
    msg_begin(set);
    msg_str(set, "module ");
    msg_quote(set, path);
    msg_str(set, " is the same file as module ");
    msg_quote(set, other);
    diag.error(session.diags(s), at, msg_end(set));
    msg_begin(set);
    msg_str(set, "both name ");
    msg_str(set, real);
    diag.note(session.diags(s), at, msg_end(set));
}

// Reports a circular import at the import that closes it. The message lists the
// walk from the repeated module, then lists that module again.
fn error_cycle(session.session mut* s, module_set mut* set, diag.loc at, module* reached) void {
    u64 mut from = 0;
    u64 mut i = 0;
    while (i < set->stack.len) {
        if (cast(set->stack.items[i], module*) == reached) {
            from = i;
            i = set->stack.len;
        } else {
            i += 1;
        }
    }
    msg_begin(set);
    msg_str(set, "circular import: ");
    i = from;
    while (i < set->stack.len) {
        msg_quote(set, set->stack.items[i]->path);
        msg_str(set, " imports ");
        i += 1;
    }
    msg_quote(set, reached->path);
    diag.error(session.diags(s), at, msg_end(set));
}

// Reports a redeclaration at the later position and notes the earlier position.
// This permits collection before import bindings are bound. Both names are declared by
// one module, so the two places have no dependency order between them and the
// rule orders them by position.
fn error_redeclaration(session.session mut* s, module_set mut* set, diag.loc first,
                            diag.loc second, string name) void {
    diag.loc mut earlier = first;
    diag.loc mut later = second;
    if (first.line > second.line || (first.line == second.line && first.col > second.col)) {
        earlier = second;
        later = first;
    }
    msg_begin(set);
    msg_str(set, "redeclaration of ");
    msg_quote(set, name);
    diag.error(session.diags(s), later, msg_end(set));
    msg_begin(set);
    msg_str(set, "previous declaration of ");
    msg_quote(set, name);
    msg_str(set, " here");
    diag.note(session.diags(s), earlier, msg_end(set));
}

// ---- the module namespace ---------------------------------------------------------

// Returns the binding kind of a top-level declaration. Returns b_none for no
// node, including an AST error node from a file with syntax errors.
fn decl_kind(ast.node* decl) scope.bind_kind {
    if (decl->kind == ast.ast_kind.k_fn_decl) {
        // `extern fn` is importable like any other declaration
        if ((decl->flags & ast.FLAG_EXTERN) != 0) {
            return scope.bind_kind.b_extern_fn;
        }
        return scope.bind_kind.b_fn;
    }
    if (decl->kind == ast.ast_kind.k_struct_decl) {
        return scope.bind_kind.b_struct;
    }
    if (decl->kind == ast.ast_kind.k_enum_decl) {
        return scope.bind_kind.b_enum;
    }
    if (decl->kind == ast.ast_kind.k_var_decl) {
        // a constant and a `mut` global both occupy one name
        return scope.bind_kind.b_var;
    }
    return scope.bind_kind.b_none;
}

// Binds a name in the module namespace, reporting a collision when it is
// taken: any two entries collide whatever their kinds, import bindings
// included.
fn bind_name(session.session mut* s, module_set mut* set, module mut* m,
                                string name, scope.bind_kind kind, diag.loc at,
                                ast.node mut* decl) scope.binding mut* {
    scope.binding mut* bound = scope.declare(&m->names, name, kind, at, decl);
    if (bound == null) {
        error_redeclaration(s, set, scope.find(&m->names, name)->loc, at, name);
    }
    return bound;
}

fn collect_declaration(session.session mut* s, module_set mut* set, module mut* m,
                            ast.node mut* decl) bool {
    ast.node mut* mut current = decl;
    while (current->kind == ast.ast_kind.k_compile_if) {
        if ((current->flags & ast.FLAG_IMPORT_SELECTOR) != 0) {
            return true;
        }
        if ((current->flags & ast.FLAG_SELECT_THEN) != 0) {
            return collect_declaration_list(s, set, m, current->b);
        }
        if (current->c == null) {
            return true;
        }
        if (current->c->kind != ast.ast_kind.k_compile_if) {
            return collect_declaration_list(s, set, m, current->c);
        }
        current = current->c;
    }
    scope.bind_kind kind = decl_kind(current);
    if (kind == scope.bind_kind.b_none) {
        return true;
    }
    return bind_name(s, set, m, current->name, kind, current->loc, current) != null;
}

fn collect_declaration_list(session.session mut* s, module_set mut* set, module mut* m,
                                 ast.node mut* list) bool {
    bool mut ok = true;
    u64 mut i = 0;
    while (list != null && i < ast.ast_len(list)) {
        if (!collect_declaration(s, set, m, ast.ast_child_mut(list, i))) {
            ok = false;
        }
        i += 1;
    }
    return ok;
}

// Collects declarations before resolving imports. Another module can then ask
// whether this module declares a name. Enum members are not names, so only the
// top-level declarations enter. Returns false when a collision was reported;
// every collision of the module is reported first, as they are that module's own
// errors.
fn collect_declarations(session.session mut* s, module_set mut* set, module mut* m) bool {
    if (m->ast == null) {
        return true;
    }
    return collect_declaration_list(s, set, m, m->ast);
}

// ---- loading a module ------------------------------------------

// The module at `file` under the module path `path`, read, parsed and walked if
// it is new; null after a diagnostic was reported at `at`. A module already on
// the walk closes a cycle and a file already read under another path is one file
// with two identities.
fn load_module(session.session mut* s, module_set mut* set, string path, string file,
                           diag.loc at, bool entry) module mut* {
    i64 mut known = 0;
    if (strmap.get(&set->by_path, path, &known)) {
        module mut* found = set->modules.items[cast(known, u64)];
        if (found->state == module_state.m_loading) {
            error_cycle(s, set, at, found);
            return null;
        }
        return found;
    }
    if (set->stopped) {
        // the closure already has errors, so no further file is read
        return null;
    }
    string mut source = "";
    if (!session.read_source(s, file, &source)) {
        msg_begin(set);
        msg_str(set, "cannot read ");
        msg_quote(set, file);
        diag.error(session.diags(s), at, msg_end(set));
        return null;
    }
    string real = real_path(set, file);
    i64 mut twin = 0;
    if (strmap.get(&set->by_real, real, &twin)) {
        error_same_file(s, set, at, path, set->modules.items[cast(twin, u64)]->path, real);
        return null;
    }
    module mut* own fresh = new(module);
    fresh->path = path;
    fresh->file = file;
    fresh->real = real;
    fresh->source = source;
    fresh->entry = entry;
    fresh->state = module_state.m_loading;
    scope.init(&fresh->names, scope.scope_kind.s_module, null);
    owned_reserve(&set->modules);
    set->modules.items[set->modules.len] = move(fresh);
    set->modules.len += 1;
    module mut* m = set->modules.items[set->modules.len - 1];
    strmap.put(&set->by_path, m->path, cast(set->modules.len - 1, i64));
    strmap.put(&set->by_real, m->real, cast(set->modules.len - 1, i64));

    // the diagnostic count says whether the file parsed, not null
    u64 before = session.error_count(s);
    lexer.tok_vec mut toks = lexer.tokvec_create();
    // the tokens cover the file, so the parser runs either way
    lexer.lex_file(s, m->file, m->source, &toks);
    m->ast = parser.parse_module(s, m->file, &toks, &set->arena);
    lexer.tokvec_free(&toks);
    m->parsed = session.error_count(s) == before;
    if (!m->parsed) {
        return null;
    }
    m->selected = comptime.select_module(s, m->ast);
    if (!m->selected) {
        return null;
    }
    if (!collect_declarations(s, set, m)) {
        return null;
    }
    vec_push(&set->stack, m);
    bool resolved = resolve_imports(s, set, m);
    vec_pop(&set->stack);
    if (!resolved) {
        return null;
    }
    // post-order, so every import is in the order first
    m->state = module_state.m_ready;
    vec_push(&set->order, m);
    return m;
}

// ---- resolving one import ---------------------------------------

// Binds one declaration of another module under `as` name or its own, the
// symbol reading of an import. The import bindings of that module are not
// importable, there is no re-export.
fn bind_symbol(session.session mut* s, module_set mut* set, module mut* m, module* from,
                    string name, string bound, diag.loc at, ast.node mut* decl) bool {
    scope.binding* target = scope.find(&from->names, name);
    if (target == null) {
        error_no_declaration(s, set, at, from->path, name);
        return false;
    }
    if (!scope.is_declaration(target)) {
        error_not_exported(s, set, at, from->path, name);
        return false;
    }
    scope.binding mut* b = bind_name(s, set, m, bound, scope.bind_kind.b_symbol, at, decl);
    if (b == null) {
        return false;
    }
    b->to = target;
    return true;
}

// Whether the file of the prefix module declares `name`, which is what the
// symbol reading asks. A module already in the closure answers from its
// namespace. Its declarations exist before its import walk. This function reads
// and parses any other file without reports or closure changes. The module
// reading can still win, and an outside module is never loaded. A file that does not parse
// declares nothing: the error belongs to whoever imports it for real.
fn prefix_declares(session.session mut* s, module_set mut* set, string path, string file,
                        string name) bool {
    if (set->stopped) {
        return false;
    }
    module* known = find(set, path);
    if (known != null) {
        scope.binding* found = scope.find(&known->names, name);
        return found != null && scope.is_declaration(found);
    }
    string mut source = "";
    if (!session.read_source(s, file, &source)) {
        return false;
    }
    bool mut declares = false;
    ast.arena mut ar = ast.arena{};
    defer ast.ast_arena_free(&ar);
    lexer.tok_vec mut toks = lexer.tokvec_create();
    defer lexer.tokvec_free(&toks);
    diag.mute(session.diags(s));
    u64 before = session.error_count(s);
    // a file that reported anything declares nothing
    lexer.lex_file(s, file, source, &toks);
    ast.node mut* probed = parser.parse_module(s, file, &toks, &ar);
    if (probed != null && session.error_count(s) == before
        && comptime.select_module(s, probed)) {
        declares = selected_declares(probed, name);
    }
    diag.unmute(session.diags(s));
    return declares;
}

fn selected_declares(ast.node* list, string name) bool {
    u64 mut i = 0;
    while (list != null && i < ast.ast_len(list)) {
        ast.node* decl = ast.ast_child(list, i);
        i += 1;
        if (selected_node_declares(decl, name)) {
            return true;
        }
    }
    return false;
}

fn selected_node_declares(ast.node* decl, string name) bool {
    ast.node* mut current = decl;
    while (current->kind == ast.ast_kind.k_compile_if) {
        if ((current->flags & ast.FLAG_IMPORT_SELECTOR) != 0) {
            return false;
        }
        if ((current->flags & ast.FLAG_SELECT_THEN) != 0) {
            return selected_declares(current->b, name);
        }
        if (current->c == null) {
            return false;
        }
        if (current->c->kind != ast.ast_kind.k_compile_if) {
            return selected_declares(current->c, name);
        }
        current = current->c;
    }
    return decl_kind(current) != scope.bind_kind.b_none && current->name == name;
}

// Resolves each item in `import a.b.{s1, s2 as t};` as an independent symbol
// import from `a.b`. The prefix must name a module file. Each item must name one
// of its declarations.
fn resolve_items(session.session mut* s, module_set mut* set, module mut* m,
                      ast.node mut* imp) bool {
    ast.node* path = imp->a;
    u64 n = ast.ast_len(path);
    string mut file = "";
    if (!find_file(set, path, n, &file)) {
        error_not_found(s, set, imp->loc, path, n);
        return false;
    }
    module mut* from = load_module(s, set, path_text(set, path, n), file, imp->loc, false);
    if (from == null) {
        return false;
    }
    u64 mut i = 0;
    while (i < ast.ast_len(imp)) {
        ast.node mut* item = ast.ast_child_mut(imp, i);
        string mut bound = item->name;
        if (item->a != null) {
            bound = item->a->name;
        }
        if (!bind_symbol(s, set, m, from, item->name, bound, imp->loc, item)) {
            return false;
        }
        i += 1;
    }
    return true;
}

// Resolves the two readings of `import a.b.c;`. A module reading finds
// `a/b/c.ft`. A symbol reading finds declaration `c` in `a/b.ft`.
// Exactly one must succeed; a one-segment path has only the module reading, since
// at most one trailing segment names a declaration.
//
// Only the module the import resolves to is loaded. When both files exist the
// prefix is probed only for the name. It does not enter the closure. Thus, an
// import resolved to `a/b/c.ft` does not inherit errors from unrelated
// `a/b.ft`. It also does not inherit its imports or extern declarations.
fn resolve_path(session.session mut* s, module_set mut* set, module mut* m,
                     ast.node mut* imp) bool {
    ast.node* path = imp->a;
    u64 n = ast.ast_len(path);
    string last = segment_at(path, n - 1);
    string mut bound = last;
    if (imp->b != null) {
        bound = imp->b->name;
    }
    string mut module_file = "";
    bool have_module = find_file(set, path, n, &module_file);
    string mut prefix_file = "";
    bool mut have_prefix = false;
    if (n >= 2) {
        have_prefix = find_file(set, path, n - 1, &prefix_file);
    }
    if (have_module) {
        string mut prefix_path = "";
        if (n >= 2) {
            prefix_path = path_text(set, path, n - 1);
        }
        if (have_prefix && prefix_declares(s, set, prefix_path, prefix_file, last)) {
            error_ambiguous(s, set, imp->loc, path, n, module_file, prefix_file);
            return false;
        }
        module mut* target = load_module(s, set, path_text(set, path, n), module_file, imp->loc,
                                         false);
        if (target == null) {
            return false;
        }
        scope.binding mut* b = bind_name(s, set, m, bound, scope.bind_kind.b_module, imp->loc,
                                         imp);
        if (b == null) {
            return false;
        }
        b->module = cast(target, void*);
        return true;
    }
    if (have_prefix) {
        // The symbol reading is the only one left, so the prefix module is
        // this import's module and is read into the closure.
        module mut* prefix = load_module(s, set, path_text(set, path, n - 1), prefix_file,
                                         imp->loc, false);
        if (prefix == null) {
            return false;
        }
        return bind_symbol(s, set, m, prefix, last, bound, imp->loc, imp);
    }
    error_not_found(s, set, imp->loc, path, n);
    return false;
}

fn resolve_import_list(session.session mut* s, module_set mut* set, module mut* m,
                            ast.node mut* list) bool {
    bool mut ok = true;
    u64 mut i = 0;
    while (list != null && i < ast.ast_len(list)) {
        ast.node mut* imp = ast.ast_child_mut(list, i);
        i += 1;
        if (imp->kind == ast.ast_kind.k_compile_if
            && (imp->flags & ast.FLAG_IMPORT_SELECTOR) != 0) {
            ast.node mut* mut current = imp;
            while (current != null && current->kind == ast.ast_kind.k_compile_if) {
                if ((current->flags & ast.FLAG_SELECT_THEN) != 0) {
                    if (!resolve_import_list(s, set, m, current->b)) {
                        ok = false;
                    }
                    break;
                }
                if (current->c == null) {
                    break;
                }
                if (current->c->kind != ast.ast_kind.k_compile_if) {
                    if (!resolve_import_list(s, set, m, current->c)) {
                        ok = false;
                    }
                    break;
                }
                current = current->c;
            }
        } else if (imp->kind == ast.ast_kind.k_import) {
            bool mut resolved = false;
            if (ast.ast_len(imp) > 0) {
                resolved = resolve_items(s, set, m, imp);
            } else {
                resolved = resolve_path(s, set, m, imp);
            }
            if (!resolved) {
                ok = false;
                set->stopped = true;
            }
        }
    }
    return ok;
}

// Resolves every selected import of the module, in source order. The parser
// has enforced that direct imports and import selectors precede declarations.
//
// Reports each failed import in the module, so its errors stay together. Then
// `stopped` prevents remaining imports from reading more files. Processing stops
// at the module boundary.
fn resolve_imports(session.session mut* s, module_set mut* set, module mut* m) bool {
    if (m->ast == null) {
        return true;
    }
    return resolve_import_list(s, set, m, m->ast);
}

// ---- the set --------------------------------------------------------------------------

// The empty set; allocates nothing. A call result needs no move.
fn create() module_set {
    return module_set{};
}

// Releases every module, its namespace and the shared arena; the set is empty
// and usable afterwards. Every string it handed out dies here, the sources
// excepted: those belong to the session that read them.
fn free(module_set mut* set) void {
    u64 mut i = 0;
    while (i < set->modules.len) {
        module mut* own m = move(set->modules.items[i]);
        scope.free(&m->names);
        del(m);
        i += 1;
    }
    del(set->modules.items);
    set->modules.len = 0;
    del(set->order.items);
    set->order.len = 0;
    del(set->stack.items);
    set->stack.len = 0;
    containers.str_free(&set->roots);
    strmap.free(&set->by_path);
    strmap.free(&set->by_real);
    ast.ast_arena_free(&set->arena);
    strbuf.free(&set->msg);
    set->entry_dir = "";
    set->std_dir = "";
    set->cwd = "";
    set->stopped = false;
    containers.pool_free(&set->pool);
}

/// Appends a `-I` search root.
/// Roots are searched after the entry directory, in insertion order.
fn add_root(module_set mut* set, string dir) void {
    containers.str_push(&set->roots, containers.pool_intern(&set->pool, dir));
}

/// Sets the standard library directory, the only root a path beginning with
/// `std` uses. Without this directory, no `std` path resolves.
fn set_std_dir(module_set mut* set, string dir) void {
    set->std_dir = containers.pool_intern(&set->pool, dir);
}

/// Returns the number of closure modules in dependency order.
fn count(module_set* set) u64 {
    return set->order.len;
}

/// Returns module `i` in dependency order.
/// An index at or past `count` breaks the precondition.
fn at(module_set* set, u64 i) module* {
    if (i >= set->order.len) {
        panic("modules.at: index out of range");
    }
    return set->order.items[i];
}

// Whether the loader put `m` in the dependency order, as opposed to the
// modules the pass order visits after it.
fn is_ordered(module_set* set, module* m) bool {
    u64 mut i = 0;
    while (i < set->order.len) {
        if (cast(set->order.items[i], module*) == m) {
            return true;
        }
        i += 1;
    }
    return false;
}

// Whether the module belongs to the second group of the pass order: it parsed
// and the loader never ordered it.
fn is_unordered_pass_module(module_set* set, module* m) bool {
    return m->parsed && m->selected && m->ast != null && !is_ordered(set, m);
}

/// Returns the number of modules in whole-closure pass order.
/// Closure modules come first. Other parsed modules follow in reverse read order.
/// Both groups put imports before importers.
fn pass_count(module_set* set) u64 {
    u64 mut n = set->order.len;
    u64 mut i = 0;
    while (i < set->modules.len) {
        if (is_unordered_pass_module(set, set->modules.items[i])) {
            n += 1;
        }
        i += 1;
    }
    return n;
}

/// Returns module `i` in whole-closure pass order.
/// An index at or past `pass_count` breaks the precondition.
fn pass_at(module_set* set, u64 i) module* {
    if (i < set->order.len) {
        return set->order.items[i];
    }
    // read depth first, so visited in the reverse of read order
    u64 mut seen = set->order.len;
    u64 mut k = set->modules.len;
    while (k > 0) {
        module* m = set->modules.items[k - 1];
        if (is_unordered_pass_module(set, m)) {
            if (seen == i) {
                return m;
            }
            seen += 1;
        }
        k -= 1;
    }
    panic("modules.pass_at: index out of range");
}

/// Returns the number of readable module files.
/// The files use loader read order and include files outside the completed closure.
/// This includes files that fail to parse.
fn file_count(module_set* set) u64 {
    return set->modules.len;
}

/// Returns file `i` in loader read order.
/// An index at or past `file_count` breaks the precondition.
fn file_at(module_set* set, u64 i) string {
    if (i >= set->modules.len) {
        panic("modules.file_at: index out of range");
    }
    return set->modules.items[i]->file;
}

/// Returns the read module of `path`, or null when no read module has that path.
/// The module can have failed parsing and can be outside the completed closure.
fn find(module_set* set, string path) module* {
    i64 mut at_index = 0;
    if (!strmap.get(&set->by_path, path, &at_index)) {
        return null;
    }
    return set->modules.items[cast(at_index, u64)];
}

/// The entry module, or null before load has read it.
fn entry(module_set* set) module* {
    u64 mut i = 0;
    while (i < set->modules.len) {
        module* m = set->modules.items[i];
        if (m->entry) {
            return m;
        }
        i += 1;
    }
    return null;
}

// `<std-dir>/rt.ft`, the file of the runtime, in `out`. The runtime is
// searched under the standard library directory like any other `std` module.
fn runtime_file(module_set* set, strbuf.str_buf mut* out) string {
    strbuf.clear(out);
    strbuf.append(out, set->std_dir);
    if (set->std_dir.len > 0 && set->std_dir[set->std_dir.len - 1] != DIRECTORY_SEPARATOR) {
        strbuf.push(out, DIRECTORY_SEPARATOR);
    }
    strbuf.append(out, RUNTIME_FILE);
    return strbuf.view(out);
}

// Loads `std.rt` before the entry file when a standard library directory is set.
// The runtime then precedes program modules in dependency order.
fn load_runtime(session.session mut* s, module_set mut* set) bool {
    if (set->std_dir.len == 0) {
        return true;
    }
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    string path = containers.pool_intern(&set->pool, RUNTIME_PATH);
    string file = containers.pool_intern(&set->pool, runtime_file(set, &b));
    return load_module(s, set, path, file, file_start(file), false) != null;
}

// Returns the module that the runtime closure read at `real`, or null. The entry
// file can be `std/rt.ft`, `std/libc.ft`, `std/strbuf.ft`, or `std/mem.ft`.
// Float printers bring in the last two. One file is one
// module. Thus, that module becomes the entry instead of getting a second
// identity. error_same_file
// would otherwise report. It keeps the path the runtime's import gave it, since a
// module path is what its importer wrote.
fn entry_already_read(module_set mut* set, string real) module mut* {
    i64 mut at = 0;
    if (!strmap.get(&set->by_real, real, &at)) {
        return null;
    }
    return set->modules.items[cast(at, u64)];
}

/// Reads `entry_file` and its import closure.
/// Returns false after a read, parse, selection, or import diagnostic.
fn load(session.session mut* s, module_set mut* set, string entry_file) bool {
    string file = containers.pool_intern(&set->pool, entry_file);
    // the entry file's directory is a root, the current one never
    set->entry_dir = containers.pool_intern(&set->pool, directory_of(file));
    // The entry file's module path is its base name: `src/app.ft` is the module
    // `app`. The base name need not be a path segment. The command line names
    // the entry file, not an import. Thus, `007_case.ft` is module `007_case`,
    // which no import can spell.
    string base = containers.pool_intern(&set->pool, base_name(file));
    // A base name cannot contain `.`, which spells a module path. `my.app.ft`
    // would be module `my.app`. Its `main` would collide with the symbol from
    // `my/app.ft`. Every other character
    // reaches the symbol verbatim, `my:app.ft` emitting `my:app.main`, which no
    // module path can spell. The error has no position in the file, so it is reported
    // at 1:1.
    if (holds_path_separator(base)) {
        error_entry_name_separator(s, set, file_start(file), base);
        return false;
    }
    return load_named(s, set, base, file);
}

/// Reads `entry_file` as the entry module `path`, whatever the base name of the file is, and its
/// import closure. `fort --fir-test` reads the prelude of a `.fir` file as the module `main`.
/// Returns false after a read, parse, selection, or import diagnostic.
fn load_named(session.session mut* s, module_set mut* set, string path, string entry_file) bool {
    u64 before = session.error_count(s);
    string file = containers.pool_intern(&set->pool, entry_file);
    set->entry_dir = containers.pool_intern(&set->pool, directory_of(file));
    if (!load_runtime(s, set)) {
        return false;
    }
    module mut* twin = entry_already_read(set, real_path(set, file));
    if (twin != null) {
        twin->entry = true;
        return session.error_count(s) == before;
    }
    string named = containers.pool_intern(&set->pool, path);
    if (load_module(s, set, named, file, file_start(file), true) == null) {
        return false;
    }
    return session.error_count(s) == before;
}
