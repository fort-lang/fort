/// Proves at compile time that each store into an `own` reference finds its destination empty:
/// the forward must-empty analysis of the overwrite check (D17.11, spec/fir.md 11). It reads one
/// verified FIR function before the build-mode pass, and it reads no other function. It holds the
/// emptiness fact of spec/ownership-design.md 4.4, and with it it proves part 1 of the leak rule
/// (D17.20): an owner local holds the zero value at each exit of its scope. It also proves part 2,
/// which only reports for now: each inner owner of `*p` holds the zero value before a `del` or an
/// owning `cast` of `p`.
//
// The analysis proves each store into a place of an `own` reference type that needs a proof
// (find_stores): the fact of its place holds after its right side and before its own kill rules. A
// `check(overwrite: p)` takes the verdict of the stores that it guards (guards_proved). A fact says
// that a tracked place holds the zero value. The analysis keeps one fact for each tracked place
// that a check or a store names. No gen rule and no kill rule of one fact reads another fact, so a
// fact that nothing names changes no verdict. Four forward dataflows of fir_flow run in this order,
// each with gen and kill sets for each block: the stale index temporaries and held addresses, and
// the fresh pointer locals, whose transfer owner.place holds, the scratch locals (run_scratch),
// whose bit holds the fact of a whole temporary or `_0` that is no memory, then the facts, joined
// by intersection. A walk of each block gives its sets, with the stale set and the fresh set before
// each statement. A block that ends in a test against null gives the facts and the scratch bit of
// the tested place to the edge where the test finds null (find_tests, add_test_facts). A second
// walk of each block that holds a store tests its fact. The leak rule adds the fact of each owner
// local whose obligation needs one, and a fifth dataflow (run_ended) that says where the scope of a
// named owner local has ended; a third walk of each block that holds an exit tests its obligation
// (judge_exits). Part 2 adds the fact of each inner owner of each `del` or owning `cast`
// (find_inners), and a fourth walk tests them (judge_inners).
// The module uses switches and no function-pointer dispatch table. It holds no module-level
// mutable state: each vector belongs to one call of prove, or to the proof that it returns.
import fort.fir;
import fort.fir_flow;
import fort.owner.place;
import fort.types;

// The fact of a check or a store whose place is not tracked, and of a block that ends in no check.
u32 NO_FACT = 4294967295;

// The entry of check_of for a block that continues no check (find_stores).
u32 NO_BLOCK = 4294967295;

/// The most work that the proof of one function takes. The work is the sum of three counts: the
/// statements and the terminators times the overwrite checks and the stores that no check stands
/// right before and that write no whole scratch local (count_alone), the blocks times the locals,
/// and the steps of the stale chains (place.stale_steps). A function past it gets no proof: each of
/// its checks and each of its stores stays unproved, but a store into a whole scratch local is no
/// error.
u64 WORK_LIMIT = 1048576;

// ---- the proof ---------------------------------------------------------------------------------

/// A store into a place of an `own` reference type that needs a proof (find_stores): statement
/// `index` of block `block`, and whether the analysis proves it.
struct store {
    u32 block;
    u32 index;
    bool proved;
}

/// An obligation of part 1 of the leak rule (D17.20): the owner local `local` must hold the zero
/// value at an exit of its scope. The exit is statement `index` of block `block`, a `dead` marker,
/// or the `return` that ends the block when `index` is the count of the statements of the block.
/// `proved` says whether the analysis proves the obligation.
struct exit {
    u32 block;
    u32 index;
    u32 local;
    bool proved;
}

/// An obligation of part 2 of the leak rule (D17.20): before the `del` or the owning `cast` that is
/// statement `index` of block `block`, each inner owner of `*p` holds the zero value. `p` is the
/// place of the `del` or of the operand of the `cast` (released_place), of type `T* own`, and `T`
/// holds `owners` inner owners (place.count_owners). `first` is the first inner owner that the
/// analysis does not prove, in the order of place.next_owner_step, and `proved` says that it proves
/// each one.
struct inner {
    u32 block;
    u32 index;
    u64 owners;
    u64 first;
    bool proved;
}

/// The verdict of each `check(overwrite: p)` and of each store that needs a proof in one function,
/// and of each obligation of part 1 of the leak rule. `proved[b]` says whether the check that ends
/// block `b` is proved. It is true for a block that ends in another terminator. `stores` holds the
/// stores that need a proof, in block order and in statement order. `exits` holds the obligations
/// of the leak rule in block order: the `dead` markers of a block in statement order, then its
/// `return`, one for each local in number order (find_exits). `inners` holds the obligations of
/// part 2 in block order and in statement order (find_inners). `checks` counts the checks,
/// `unproved` counts the checks and the stores that the analysis does not prove, and `leaks`
/// counts the exits that it does not prove. Each of them is a compile error (has_error).
/// `inner_leaks` counts the obligations of part 2 that it does not prove, which are no error yet.
/// `work` is the work of the overwrite proof, as WORK_LIMIT counts it, and `over` says that it
/// passed the limit. `leak_work` adds the facts of the exits (count_owner_facts), and `leak_over`
/// says that it passed the limit. `inner_work` adds the steps of the paths of the inner owners to
/// `leak_work` (count_inner_steps), and `inner_over` says that it passed the limit.
struct proof {
    bool mut@ own proved;
    store mut@ own stores;
    exit mut@ own exits;
    inner mut@ own inners;
    u32 checks;
    u32 unproved;
    u32 leaks;
    u32 inner_leaks;
    u64 work;
    u64 leak_work;
    u64 inner_work;
    bool over;
    bool leak_over;
    bool inner_over;
}

fn free(proof mut* p) void {
    del(p->proved);
    del(p->stores);
    del(p->exits);
    del(p->inners);
    p->checks = 0;
    p->unproved = 0;
    p->leaks = 0;
    p->inner_leaks = 0;
}

/// Whether the check that ends block `b` is proved, or true when block `b` ends in another
/// terminator.
fn is_proved(proof* p, u32 b) bool {
    return p->proved[cast(b, u64)];
}

/// Whether `p` leaves a compile error: a check or a store that it does not prove, the error of
/// D17.11, or an exit that it does not prove, the error of part 1 of the leak rule (D17.20). A
/// function with an error reaches no later pass. An obligation of part 2 that it does not prove is
/// no error yet: part 2 only reports (D17.20).
fn has_error(proof* p) bool {
    return p->unproved > 0 || p->leaks > 0;
}

// The state of one call of prove: the survey of the places, and the facts. `facts[..fact_count]`
// holds the facts, whose steps the survey keeps. `block_fact[b]` is the fact of the check that
// ends block `b`, `store_fact[k]` the fact of store `k` of the proof, and `exit_fact[k]` the fact
// of exit `k`. The stores of block `b` are the stores `first_store[b]` to `first_store[b + 1] - 1`
// of the proof. The facts of the inner owners of inner `k` of the proof are the entries
// `first_inner[k]` to `first_inner[k + 1] - 1` of `inner_fact`, in the order of the owners, and
// `site_fact[k]` is the fact of the place that inner `k` releases. `tested[b]` says that block `b`
// ends in a test against null, and then `tests[b]` is that test (find_tests).
struct context {
    place.survey places;
    place.path mut@ own facts;
    u64 fact_count;
    u32 mut@ own block_fact;
    u32 mut@ own store_fact;
    u32 mut@ own exit_fact;
    u64 mut@ own first_store;
    u32 mut@ own inner_fact;
    u64 mut@ own first_inner;
    u32 mut@ own site_fact;
    bool mut@ own tested;
    place.test mut@ own tests;
}

fn free_context(context mut* c) void {
    place.free(&c->places);
    del(c->facts);
    del(c->block_fact);
    del(c->store_fact);
    del(c->exit_fact);
    del(c->first_store);
    del(c->inner_fact);
    del(c->first_inner);
    del(c->site_fact);
    del(c->tested);
    del(c->tests);
}

// Appends `p` to the facts and returns its number.
fn push_fact(context mut* c, place.path p) u32 {
    if (c->fact_count == c->facts.len) {
        u64 cap = fir.grown_capacity(c->facts.len, "owner.prover: too many facts");
        place.path mut@ own bigger = new(place.path, cap);
        u64 mut i = 0;
        while (i < c->fact_count) {
            bigger[i] = c->facts[i];
            i += 1;
        }
        del(c->facts);
        c->facts = move(bigger);
    }
    c->facts[c->fact_count] = p;
    c->fact_count += 1;
    return cast(c->fact_count - 1, u32);
}

// ---- the gen and kill rules --------------------------------------------------------------------

// The two probes of one block, the effect of its statements on the empty set and on the full set,
// and the edge set of the test against null that ends it. For a transfer of gen and kill sets, the
// first is the gen set and the second the complement of the kill set less the gen set. The edge set
// starts empty as the first probe does, and the walk adds to it the facts of the tested place right
// before the test statement (add_test_facts), so at the end it holds the gens of the block and
// each of those facts that the statements after the read leave (spec/fir.md 11, Tests). A walk
// that tests no edge reads no edge set.
struct probes {
    fir_flow.bits none;
    fir_flow.bits all;
    fir_flow.bits edge;
}

fn gen(probes mut* pr, u32 fact) void {
    fir_flow.bits_set(&pr->none, fact);
    fir_flow.bits_set(&pr->all, fact);
    fir_flow.bits_set(&pr->edge, fact);
}

fn kill(probes mut* pr, u32 fact) void {
    fir_flow.bits_clear(&pr->none, fact);
    fir_flow.bits_clear(&pr->all, fact);
    fir_flow.bits_clear(&pr->edge, fact);
}

// Makes `p` and each tracked place below `p` empty.
fn gen_below(context* c, place.path p, probes mut* pr) void {
    u64 mut k = 0;
    while (k < c->fact_count) {
        if (place.is_below(&c->places, c->facts[k], p)) {
            gen(pr, cast(k, u32));
        }
        k += 1;
    }
}

// The gen rule of `del(move p)`: it makes `p` empty.
fn gen_exact(context* c, place.path p, probes mut* pr) void {
    u64 mut k = 0;
    while (k < c->fact_count) {
        if (place.is_same(&c->places, c->facts[k], p)) {
            gen(pr, cast(k, u32));
        }
        k += 1;
    }
}

// The kill rule of a `call`: it keeps the facts about a local that is no memory and about its
// places that are not reached through memory.
fn kill_call(context* c, probes mut* pr) void {
    u64 mut k = 0;
    while (k < c->fact_count) {
        if (place.is_through_memory(&c->places, c->facts[k])) {
            kill(pr, cast(k, u32));
        }
        k += 1;
    }
}

// The kill rules of a store into `d`, with the fresh set after its right side:
// - each fact with the base of `d` that is not separate from `d` dies, and a store into a local
//   kills each fact with that local as a key;
// - a store through a fresh pointer local kills nothing more;
// - any other store through a pointer kills each fact reached through memory, but a fact through
//   a fresh pointer local and a fact with the base of `d` that is separate from `d` survive;
// - a store straight into a memory local or a global kills each fact through a pointer that is
//   not fresh, because the pointer can hold its address, and keeps the facts of other locals and
//   other globals, whose bytes it does not write.
fn kill_store(context* c, place.path d, fir_flow.bits* fresh, probes mut* pr) void {
    bool to_local = d.base == fir.base_kind.bk_local;
    u64 mut k = 0;
    while (k < c->fact_count) {
        place.path q = c->facts[k];
        if (place.is_same_base(q, d) && !place.is_separate(&c->places, q, d)) {
            kill(pr, cast(k, u32));
        } else if (to_local && place.has_key(&c->places, q, d.local)) {
            kill(pr, cast(k, u32));
        }
        k += 1;
    }
    if (place.is_through_fresh(&c->places, d, fresh)) {
        return;
    }
    if (place.is_indirect(&c->places, d)) {
        k = 0;
        while (k < c->fact_count) {
            place.path q = c->facts[k];
            // the loop above killed each fact of the base that is not separate from `d`
            bool kept = place.is_through_fresh(&c->places, q, fresh) || place.is_same_base(q, d);
            if (place.is_through_memory(&c->places, q) && !kept) {
                kill(pr, cast(k, u32));
            }
            k += 1;
        }
        return;
    }
    if (to_local && !c->places.locals[cast(d.local, u64)].memory) {
        return;
    }
    k = 0;
    while (k < c->fact_count) {
        place.path q = c->facts[k];
        if (place.is_indirect(&c->places, q) && !place.is_through_fresh(&c->places, q, fresh)) {
            kill(pr, cast(k, u32));
        }
        k += 1;
    }
}

// Whether the rvalue `r` is a zero value of its own: `const zero T`, `null T`, or an `aggregate`
// whose operands are all such constants.
fn is_zero_rvalue(fir.func* f, fir.rvalue r) bool {
    if (r.kind != fir.rvalue_kind.rv_use && r.kind != fir.rvalue_kind.rv_aggregate) {
        return false;
    }
    u32 mut i = 0;
    while (i < r.ops_len) {
        fir.operand o = fir.rvalue_operand(f, r, i);
        bool zero = o.kind == fir.operand_kind.ok_const
            && (o.value.kind == fir.const_kind.ck_zero || o.value.kind == fir.const_kind.ck_null);
        if (!zero) {
            return false;
        }
        i += 1;
    }
    return true;
}

// Whether the store of the rvalue `r` writes the zero value: a zero rvalue, or the `move` of a
// temporary that one store writes with a zero rvalue and that only this `move` reads.
fn is_zero_value(context* c, fir.rvalue r) bool {
    if (is_zero_rvalue(c->places.f, r)) {
        return true;
    }
    u32 mut t = 0;
    if (!place.find_moved_temp(&c->places, r, &t)) {
        return false;
    }
    return is_zero_rvalue(c->places.f, place.store_of(&c->places, t)->value);
}

// The gen rule of each `move` operand of `s`, in operand order: it makes its place and each
// tracked place below it empty. `del(move p)` makes `p` empty.
fn gen_reads(context mut* c, fir.statement* s, fir_flow.bits* stale, probes mut* pr) void {
    u64 mark = c->places.steps_len;
    if (s->kind == fir.stmt_kind.st_del) {
        place.path p = place.trace(&c->places, s->place, stale);
        gen_exact(c, p, pr);
        c->places.steps_len = mark;
        return;
    }
    fir.operand mut o = fir.operand{};
    u32 mut i = 0;
    while (fir.stmt_reads(c->places.f, s, i, &o)) {
        if (o.kind == fir.operand_kind.ok_move) {
            place.path p = place.trace(&c->places, o.place, stale);
            gen_below(c, p, pr);
            c->places.steps_len = mark;
        }
        i += 1;
    }
}

// The kill rules of the store of the assignment `s` into `d`, the path of its destination.
// `stale` holds the stale set before `s`, and `fresh` the fresh set after its right side.
fn apply_kills(context* c, fir.statement* s, place.path d, fir_flow.bits* stale,
               fir_flow.bits* fresh, probes mut* pr) void {
    // a store through a stale held address can write a place through a fresh pointer local,
    // because the `addr` of a held address ends no freshness, so no fresh fact survives it
    if (place.is_stale_held(&c->places, s->place, stale)) {
        kill_store(c, d, null, pr);
    } else {
        kill_store(c, d, fresh, pr);
    }
}

// The effect of the statement `s` on the facts, in the order of the rules: the reads of its
// operands, the kill of a `call`, the kill rules of its store and then its gen rule. `stale` and
// `fresh` hold the sets before `s`, and the function moves them past `s`. A `fact` that is no
// NO_FACT is the fact of the place of `s`, a store that needs a proof: *held then says whether the
// first probe holds it after the kill of the `call` and before the kill rules of the store, the
// test of D17.11. A walk that tests a store gives both probes one set. A terminator changes no
// fact: rule V6 puts no `move` operand in a terminator.
fn apply_facts(context mut* c, fir.statement* s, fir_flow.bits mut* stale,
              fir_flow.bits mut* fresh, probes mut* pr, u32 fact, bool mut* held) void {
    gen_reads(c, s, stale, pr);
    place.apply_fresh_reads(&c->places, s, fresh);
    if (s->kind == fir.stmt_kind.st_assign) {
        u64 mark = c->places.steps_len;
        place.path d = place.trace(&c->places, s->place, stale);
        if (s->value.kind == fir.rvalue_kind.rv_call) {
            kill_call(c, pr);
        }
        if (fact != NO_FACT) {
            *held = fir_flow.bits_get(&pr->none, fact);
        }
        apply_kills(c, s, d, stale, fresh, pr);
        if (is_zero_value(c, s->value)) {
            gen_below(c, d, pr);
        }
        bool pointer = d.len == 0 && d.base == fir.base_kind.bk_local
            && fir.local_at(c->places.f, d.local)->ty->kind == types.type_kind.k_ptr;
        if (pointer && place.is_fresh_new(&c->places, s->value)) {
            u64 mut k = 0;
            while (k < c->fact_count) {
                if (place.is_through(&c->places, c->facts[k], d.local)) {
                    gen(pr, cast(k, u32));
                }
                k += 1;
            }
        }
        c->places.steps_len = mark;
    }
    place.apply_fresh_store(&c->places, s, fresh);
    place.apply_stale(&c->places, s, stale);
}

// ---- the dataflows -----------------------------------------------------------------------------

// The transfer that fir_flow.dataflow_new takes. prove gives each transfer as sets and never
// calls it.
fn transfer_none(fir.func* f, u32 b, fir_flow.bits mut* set) void {
}

// One set of `count` numbers for each of the `n` blocks.
fn make_sets(u32 n, u32 count) fir_flow.bits mut@ own {
    fir_flow.bits mut@ own sets = new(fir_flow.bits, cast(n, u64));
    u64 mut b = 0;
    while (b < sets.len) {
        sets[b] = fir_flow.bits_new(count);
        b += 1;
    }
    return sets;
}

fn free_sets(fir_flow.bits mut@ sets) void {
    u64 mut b = 0;
    while (b < sets.len) {
        fir_flow.bits_free(&sets[b]);
        b += 1;
    }
}

// Writes the gen and the kill set of the two probes `pr` of block `b` into `gens[b]` and
// `kills[b]`. The caller passes the sets and not the address of an element, so that its own
// locals of the sets take no address and stay no memory.
fn split_probes(probes* pr, fir_flow.bits mut@ gens, fir_flow.bits mut@ kills, u32 b) void {
    u64 at = cast(b, u64);
    fir_flow.bits_copy(&gens[at], &pr->none);
    fir_flow.bits_fill(&kills[at]);
    fir_flow.bits_subtract(&kills[at], &pr->all);
}

fn make_probes(u32 count) probes {
    probes mut pr = probes{};
    pr.none = fir_flow.bits_new(count);
    pr.all = fir_flow.bits_new(count);
    pr.edge = fir_flow.bits_new(count);
    return pr;
}

fn free_probes(probes mut* pr) void {
    fir_flow.bits_free(&pr->none);
    fir_flow.bits_free(&pr->all);
    fir_flow.bits_free(&pr->edge);
}

// Empties the first probe and the edge set, and fills the second probe.
fn reset_probes(probes mut* pr) void {
    u64 mut w = 0;
    while (w < pr->none.words.len) {
        pr->none.words[w] = 0;
        pr->edge.words[w] = 0;
        w += 1;
    }
    fir_flow.bits_fill(&pr->all);
}

// Runs the stale dataflow, a union from an entry where every temporary is stale, or with
// `fresh` the fresh dataflow, an intersection from an entry where no local is fresh.
fn run_locals(context mut* c, fir.pred_table* pt, fir_flow.dataflow mut* d, bool fresh) void {
    fir.func* f = c->places.f;
    u32 n = fir.block_count(f);
    u32 count = fir.local_count(f);
    fir_flow.bits mut@ own gens = make_sets(n, count);
    fir_flow.bits mut@ own kills = make_sets(n, count);
    defer {
        free_sets(gens);
        free_sets(kills);
        del(gens);
        del(kills);
    }
    probes mut pr = make_probes(count);
    defer free_probes(&pr);
    u32 mut b = 0;
    while (b < n) {
        reset_probes(&pr);
        u32 mut i = 0;
        while (i < fir.block_statement_count(f, b)) {
            fir.statement* s = fir.block_statement(f, b, i);
            if (fresh) {
                place.apply_fresh_reads(&c->places, s, &pr.none);
                place.apply_fresh_store(&c->places, s, &pr.none);
                place.apply_fresh_reads(&c->places, s, &pr.all);
                place.apply_fresh_store(&c->places, s, &pr.all);
            } else {
                place.apply_stale(&c->places, s, &pr.none);
                place.apply_stale(&c->places, s, &pr.all);
            }
            i += 1;
        }
        if (fresh) {
            fir.terminator* t = &fir.block_at(f, b)->term;
            place.apply_fresh_term(&c->places, t, &pr.none);
            place.apply_fresh_term(&c->places, t, &pr.all);
        }
        split_probes(&pr, gens, kills, b);
        b += 1;
    }
    if (fresh) {
        fir_flow.bits_fill(&d->init);
    } else {
        fir_flow.bits_fill(&d->entry);
    }
    fir_flow.dataflow_forward_sets(f, pt, d, gens, kills);
}

// The fact of the place `p` at a point whose stale set is `stale`: the fact of an earlier check or
// store of the same path, or a fact of its own. NO_FACT when `p` is not a tracked place.
fn fact_of(context mut* c, fir.place p, fir_flow.bits* stale) u32 {
    u64 mark = c->places.steps_len;
    place.path q = place.trace(&c->places, p, stale);
    return find_fact(c, q, mark);
}

// The fact of the path `q`, whose steps stand from `mark` on: the fact of an earlier path that is
// the same place, or a fact of its own. NO_FACT when `q` is not a tracked place.
fn find_fact(context mut* c, place.path q, u64 mark) u32 {
    if (!q.tracked) {
        c->places.steps_len = mark;
        return NO_FACT;
    }
    u64 mut k = 0;
    while (k < c->fact_count && !place.is_same(&c->places, c->facts[k], q)) {
        k += 1;
    }
    if (k < c->fact_count) {
        c->places.steps_len = mark;
        return cast(k, u32);
    }
    return push_fact(c, q);
}

// Gives each check and each store of `out` its fact (fact_of). A check reads its place at the end
// of its block, and a store reads its place before its statement, each with the stale set there.
// The search for an earlier fact takes at most the checks and the stores times the facts.
fn collect_facts(context mut* c, fir_flow.dataflow* stale, proof* out) void {
    fir.func* f = c->places.f;
    fir_flow.bits mut at_stale = fir_flow.bits_new(fir.local_count(f));
    defer fir_flow.bits_free(&at_stale);
    u32 mut b = 0;
    while (b < fir.block_count(f)) {
        u64 mut k = c->first_store[cast(b, u64)];
        u64 end = c->first_store[cast(b, u64) + 1];
        fir_flow.bits_copy(&at_stale, &stale->ins[cast(b, u64)]);
        u32 mut i = 0;
        while (k < end) {
            while (i < out->stores[k].index) {
                place.apply_stale(&c->places, fir.block_statement(f, b, i), &at_stale);
                i += 1;
            }
            c->store_fact[k] = NO_FACT;
            if (!is_scratch_store(c, &out->stores[k])) {
                c->store_fact[k] = fact_of(c, fir.block_statement(f, b, i)->place, &at_stale);
            }
            k += 1;
        }
        c->block_fact[cast(b, u64)] = NO_FACT;
        fir.terminator* t = &fir.block_at(f, b)->term;
        if (t->kind == fir.term_kind.tk_check_overwrite) {
            c->block_fact[cast(b, u64)] = fact_of(c, t->place, &stale->outs[cast(b, u64)]);
        }
        b += 1;
    }
}

// Runs the facts dataflow: an intersection from the entry, which holds the fact of each place in
// fixed storage of a temporary or of an `_0` that is no aggregate (place.is_empty_at_entry), and no
// other fact.
fn run_facts(context mut* c, fir.pred_table* pt, fir_flow.dataflow* stale,
             fir_flow.dataflow* fresh, fir_flow.dataflow mut* d) void {
    fir.func* f = c->places.f;
    u32 n = fir.block_count(f);
    u32 count = cast(c->fact_count, u32);
    u32 locals = fir.local_count(f);
    fir_flow.bits mut@ own gens = make_sets(n, count);
    fir_flow.bits mut@ own kills = make_sets(n, count);
    defer {
        free_sets(gens);
        free_sets(kills);
        del(gens);
        del(kills);
    }
    probes mut pr = make_probes(count);
    defer free_probes(&pr);
    fir_flow.bits mut at_stale = fir_flow.bits_new(locals);
    defer fir_flow.bits_free(&at_stale);
    fir_flow.bits mut at_fresh = fir_flow.bits_new(locals);
    defer fir_flow.bits_free(&at_fresh);
    fir_flow.bits mut@ own edge_gens = make_sets(n, count);
    u32 mut@ own edge_to = new(u32, cast(n, u64));
    defer {
        free_sets(edge_gens);
        del(edge_gens);
        del(edge_to);
    }
    bool mut unused = false;
    u32 mut b = 0;
    while (b < n) {
        reset_probes(&pr);
        fir_flow.bits_copy(&at_stale, &stale->ins[cast(b, u64)]);
        fir_flow.bits_copy(&at_fresh, &fresh->ins[cast(b, u64)]);
        bool tested = c->tested[cast(b, u64)];
        place.test* t = &c->tests[cast(b, u64)];
        u32 mut i = 0;
        while (i < fir.block_statement_count(f, b)) {
            if (tested && i == t->index) {
                add_test_facts(c, t, &at_stale, &pr);
            }
            apply_facts(c, fir.block_statement(f, b, i), &at_stale, &at_fresh, &pr, NO_FACT,
                        &unused);
            i += 1;
        }
        split_probes(&pr, gens, kills, b);
        edge_to[cast(b, u64)] = fir_flow.NO_EDGE;
        if (tested) {
            edge_to[cast(b, u64)] = t->target;
            fir_flow.bits_copy(&edge_gens[cast(b, u64)], &pr.edge);
        }
        b += 1;
    }
    u64 mut k = 0;
    while (k < c->fact_count) {
        if (place.is_empty_at_entry(&c->places, c->facts[k])) {
            fir_flow.bits_set(&d->entry, cast(k, u32));
        }
        k += 1;
    }
    fir_flow.bits_fill(&d->init);
    fir_flow.dataflow_forward_edges(f, pt, d, gens, kills, edge_to, edge_gens);
}

// Adds to the edge set of `pr` the fact of each tracked place that is the same as the place of the
// test `t`, the gen rule of a test against null (spec/fir.md 11, Tests). The walk calls it right
// before the test statement, so `stale` holds the stale set there, and the place held the zero
// value at that read on the edge of the test. The statements from the test statement on apply
// their rules to the edge set as to the probes, so the kill rules after the read apply to it.
fn add_test_facts(context mut* c, place.test* t, fir_flow.bits* stale, probes mut* pr) void {
    u64 mark = c->places.steps_len;
    place.path q = place.trace(&c->places, t->place, stale);
    u64 mut k = 0;
    while (q.tracked && k < c->fact_count) {
        if (place.is_same(&c->places, c->facts[k], q)) {
            fir_flow.bits_set(&pr->edge, cast(k, u32));
        }
        k += 1;
    }
    c->places.steps_len = mark;
}

// Gives `tested` and `tests` their entries: whether each block ends in a test against null, and
// which one (place.find_test). The facts dataflow and the scratch dataflow read them.
fn find_tests(context mut* c) void {
    u32 n = fir.block_count(c->places.f);
    del(c->tested);
    c->tested = new(bool, cast(n, u64));
    del(c->tests);
    c->tests = new(place.test, cast(n, u64));
    u32 mut b = 0;
    while (b < n) {
        place.test mut t = place.test{};
        c->tested[cast(b, u64)] = place.find_test(&c->places, b, &t);
        c->tests[cast(b, u64)] = t;
        b += 1;
    }
}

// ---- the stores that need a proof --------------------------------------------------------------

// Whether `t` is an `own` reference type, the type of a destination whose store D17.11 checks.
fn is_own_reference(types.node* t) bool {
    return types.type_is_reference(t) && t->is_own;
}

// Whether `s` is an entry zeroing (spec/fir.md 9.2): a store of the zero value into a whole named
// local of an `own` reference type.
fn is_entry_zeroing(fir.func* f, fir.statement* s) bool {
    if (s->kind != fir.stmt_kind.st_assign || s->place.base != fir.base_kind.bk_local
        || s->place.proj_len != 0) {
        return false;
    }
    fir.local* l = fir.local_at(f, s->place.local);
    return l->kind == fir.local_kind.lk_named && is_own_reference(l->ty)
        && is_zero_rvalue(f, s->value);
}

// Marks in `written` the local of the place that the statement `s` writes, and the local of the
// place whose address an `addr` or a `slice` of `s` takes. A statement that writes no place of a
// local and takes no address of one writes no byte of it, so the local holds what it held.
fn mark_written(fir.statement* s, fir_flow.bits mut* written) void {
    if (s->kind != fir.stmt_kind.st_assign && s->kind != fir.stmt_kind.st_del) {
        return;
    }
    if (s->place.base == fir.base_kind.bk_local) {
        fir_flow.bits_set(written, s->place.local);
    }
    fir.rvalue r = s->value;
    bool names = r.kind == fir.rvalue_kind.rv_addr || r.kind == fir.rvalue_kind.rv_slice;
    if (s->kind == fir.stmt_kind.st_assign && names && r.place.base == fir.base_kind.bk_local) {
        fir_flow.bits_set(written, r.place.local);
    }
}

// Whether the local `n` is `_0` of an aggregate type, whose storage is the destination of the
// caller (fir.md 5.3).
fn is_aggregate_result(fir.func* f, u32 n) bool {
    fir.local* l = fir.local_at(f, n);
    return l->kind == fir.local_kind.lk_return && fir.type_aggregate(l->ty);
}

// Whether a check stands right before statement `i` of block `b`: the statement is the first of
// the continuation block of a check of its place (fir.is_same_place).
fn is_checked(fir.func* f, u32@ check_of, u32 b, u32 i) bool {
    u32 check = check_of[cast(b, u64)];
    return i == 0 && check != NO_BLOCK
        && fir.is_same_place(f, fir.block_at(f, check)->term.place,
                             fir.block_statement(f, b, i)->place);
}

// Whether statement `i` of block `b` is a store that needs a proof (find_stores). *checked says
// whether a check stands right before it. `written` holds the locals that a statement of `bb0`
// before it writes or takes an address of (mark_written), and the call adds those of the
// statement in `bb0`. `check_of[x]` is the block of the check whose continuation is block `x`, or
// NO_BLOCK.
fn needs_proof(fir.func* f, u32@ check_of, u32 b, u32 i, fir_flow.bits mut* written,
               bool mut* checked) bool {
    fir.statement* s = fir.block_statement(f, b, i);
    bool zeroing = b == 0 && is_entry_zeroing(f, s) && !fir_flow.bits_get(written, s->place.local);
    if (b == 0) {
        mark_written(s, written);
    }
    *checked = false;
    if (s->kind != fir.stmt_kind.st_assign || zeroing) {
        return false;
    }
    *checked = is_checked(f, check_of, b, i);
    bool hidden = s->place.base == fir.base_kind.bk_local && fir.place_fixed(f, s->place)
        && is_aggregate_result(f, s->place.local);
    if (hidden && !*checked) {
        return false;
    }
    return is_own_reference(fir.place_type(f, s->place));
}

// Lists in out->stores each store that needs a proof, in block order: each store into a place of
// an `own` reference type, a store into a temporary or into `_0` included, but for two kinds that
// no check stands right before. A store into fixed storage of an aggregate `_0` writes the
// destination of the caller, which can hold owners, so the pass gives it no fact at the entry. An
// entry zeroing in `bb0` writes a named local that no statement before it wrote or took an
// address of: no edge enters `bb0` (rule V2), so the local holds no allocation of the call.
fn find_stores(fir.func* f, u32@ check_of, proof mut* out) void {
    u64 mut count = 0;
    fir_flow.bits mut written = fir_flow.bits_new(fir.local_count(f));
    defer fir_flow.bits_free(&written);
    bool mut checked = false;
    u32 mut b = 0;
    while (b < fir.block_count(f)) {
        u32 mut i = 0;
        while (i < fir.block_statement_count(f, b)) {
            if (needs_proof(f, check_of, b, i, &written, &checked)) {
                count += 1;
            }
            i += 1;
        }
        b += 1;
    }
    if (count == 0) {
        return;
    }
    del(out->stores);
    out->stores = new(store, count);
    u64 mut k = 0;
    u64 mut w = 0;
    while (w < written.words.len) {
        written.words[w] = 0;
        w += 1;
    }
    b = 0;
    while (b < fir.block_count(f)) {
        u32 mut i = 0;
        while (i < fir.block_statement_count(f, b)) {
            if (needs_proof(f, check_of, b, i, &written, &checked)) {
                out->stores[k] = store{b, i, false};
                k += 1;
            }
            i += 1;
        }
        b += 1;
    }
}

// Whether the store `st` writes a whole scratch local (place.is_scratch), whose fact the scratch
// dataflow keeps.
fn is_scratch_store(context* c, store* st) bool {
    fir.place p = fir.block_statement(c->places.f, st->block, st->index)->place;
    return place.is_local(p) && place.is_scratch(&c->places, p.local);
}

// The count of the stores of `out` that no check stands right before and that write no whole
// scratch local, which the first count of the work takes.
fn count_alone(context* c, u32@ check_of, proof* out) u64 {
    u64 mut alone = 0;
    u64 mut k = 0;
    while (k < out->stores.len) {
        store* st = &out->stores[k];
        if (!is_checked(c->places.f, check_of, st->block, st->index) && !is_scratch_store(c, st)) {
            alone += 1;
        }
        k += 1;
    }
    return alone;
}

// Gives `first_store` its entries: the first store of each block in the proof `out`, and the
// count of the stores at the end.
fn index_stores(context mut* c, proof* out) void {
    u64 mut k = 0;
    u64 mut b = 0;
    while (b < c->first_store.len) {
        while (k < out->stores.len && cast(out->stores[k].block, u64) < b) {
            k += 1;
        }
        c->first_store[b] = k;
        b += 1;
    }
}

// The store of `out` that is statement `i` of block `b`, or the count of the stores when that
// statement needs no proof.
fn find_store(context* c, proof* out, u32 b, u32 i) u64 {
    u64 mut k = c->first_store[cast(b, u64)];
    u64 end = c->first_store[cast(b, u64) + 1];
    while (k < end) {
        if (out->stores[k].index == i) {
            return k;
        }
        k += 1;
    }
    return out->stores.len;
}

// ---- the verdicts ------------------------------------------------------------------------------

/// Proves each `check(overwrite: p)` and each store that needs a proof of the verified function `f`
/// within WORK_LIMIT. A store is proved when its place is a tracked place whose fact holds after
/// the reads of its operands and the kill of its `call`, before the kill rules of the store. A
/// check is proved when `p` is a tracked place whose fact holds at the end of the block of the
/// check, and each store that the check guards is proved (guards_proved). It also proves each
/// obligation of part 1 of the leak rule (find_exits, judge_exits), and of part 2 (find_inners,
/// judge_inners).
fn prove(fir.func* f) proof {
    return prove_within(f, WORK_LIMIT);
}

/// Proves as prove does, with `limit` as the most work. A function whose work passes `limit` gets
/// no proof: each of its checks and its stores stays unproved. A function whose leak work passes
/// `limit` gets no proof of its exits (pass_exits), and one whose inner work passes it gets no
/// proof of the obligations of part 2 (pass_inners). The test comes before any dataflow.
fn prove_within(fir.func* f, u64 limit) proof {
    u32 n = fir.block_count(f);
    proof mut out = proof{};
    out.proved = new(bool, cast(n, u64));
    u32 mut@ own check_of = new(u32, cast(n, u64));
    defer del(check_of);
    u64 mut units = 0;
    u32 mut b = 0;
    while (b < n) {
        out.proved[cast(b, u64)] = true;
        check_of[cast(b, u64)] = NO_BLOCK;
        b += 1;
    }
    b = 0;
    while (b < n) {
        units += cast(fir.block_statement_count(f, b), u64) + 1;
        fir.terminator* t = &fir.block_at(f, b)->term;
        if (t->kind == fir.term_kind.tk_check_overwrite) {
            out.checks += 1;
            check_of[cast(t->target, u64)] = b;
        }
        b += 1;
    }
    find_stores(f, check_of, &out);
    find_inners(f, &out);
    bool overwrite = out.checks > 0 || out.stores.len > 0;
    if (!overwrite && !has_owner(f, false) && out.inners.len == 0) {
        return out;
    }
    u64 locals = cast(fir.local_count(f), u64);
    // `context{}` is the zero value of the struct, so the pass proves the stores into its fields
    // below. A designated literal such as `context{.fact_count = n}` is no zero value.
    context mut c = context{};
    c.places.f = f;
    c.places.locals = new(place.local_info, locals);
    c.places.first_source = new(u32, locals);
    c.block_fact = new(u32, cast(n, u64));
    c.store_fact = new(u32, out.stores.len);
    c.first_store = new(u64, cast(n, u64) + 1);
    defer free_context(&c);
    index_stores(&c, &out);
    place.count_uses(&c.places);
    place.mark_memory(&c.places);
    place.mark_sources(&c.places);
    u64 checked = cast(out.checks, u64) + count_alone(&c, check_of, &out);
    u64 sets = cast(n, u64) * locals + place.stale_steps(&c.places);
    // a function with no check and no store that needs a proof has no work (D17.11)
    if (overwrite) {
        out.work = units * checked + sets;
    }
    out.leak_work = units * (checked + count_owner_facts(&c)) + sets;
    // a separate count keeps each verdict of part 1 when only the inner owners pass the limit
    out.inner_work = out.leak_work + types.capped_product(units, count_inner_steps(&c, &out));
    out.over = out.work > limit;
    out.leak_over = out.leak_work > limit;
    out.inner_over = out.inner_work > limit;
    if (out.leak_over) {
        find_exits(&c, null, &out);
        pass_exits(&c, &out);
    }
    if (out.inner_over) {
        pass_inners(&out);
    }
    if (out.over) {
        judge(&c, null, null, null, null, &out);
        return out;
    }
    run_dataflows(&c, &out);
    return out;
}

// Runs the dataflows of the proof `c` within the limit and writes the verdict of each check and
// each store into `out`, of each exit unless the leak work passed the limit, and of each obligation
// of part 2 unless the inner work passed it. Its own function keeps the work of prove_within, a
// function of the compiler, within the measure of D17.11.
fn run_dataflows(context mut* c, proof mut* out) void {
    fir.func* f = c->places.f;
    u32 locals = fir.local_count(f);
    fir.pred_table mut pt = fir.func_predecessors(f);
    defer fir.pred_table_free(&pt);
    fir_flow.dataflow mut stale = fir_flow.dataflow_new(locals, fir_flow.join_kind.join_union,
                                                        transfer_none);
    defer fir_flow.dataflow_free(&stale);
    run_locals(c, &pt, &stale, false);
    fir_flow.dataflow mut fresh = fir_flow.dataflow_new(locals, fir_flow.join_kind.join_intersect,
                                                        transfer_none);
    defer fir_flow.dataflow_free(&fresh);
    run_locals(c, &pt, &fresh, true);
    find_tests(c);
    fir_flow.dataflow mut scratch = fir_flow.dataflow_new(locals,
                                                          fir_flow.join_kind.join_intersect,
                                                          transfer_none);
    defer fir_flow.dataflow_free(&scratch);
    run_scratch(c, &pt, &scratch);
    if (!out->leak_over && has_owner(f, true)) {
        // the ended dataflow runs only for a function with a named owner local
        fir_flow.dataflow mut ended = fir_flow.dataflow_new(locals,
                                                            fir_flow.join_kind.join_intersect,
                                                            transfer_none);
        defer fir_flow.dataflow_free(&ended);
        run_ended(c, &pt, &ended);
        find_exits(c, &ended, out);
    } else if (!out->leak_over) {
        find_exits(c, null, out);
    }
    collect_facts(c, &stale, out);
    // the store follows a `del`, because each call above can change the fields of `*c`
    del(c->exit_fact);
    c->exit_fact = new(u32, out->exits.len);
    if (!out->leak_over) {
        collect_exit_facts(c, &stale, out);
    }
    if (!out->inner_over) {
        collect_inner_facts(c, &stale, out);
    }
    if (c->fact_count == 0) {
        judge(c, &stale, &fresh, null, &scratch, out);
        if (!out->leak_over) {
            judge_exits(c, &stale, &fresh, null, &scratch, out);
        }
        if (!out->inner_over) {
            judge_inners(c, &stale, &fresh, null, &scratch, out);
        }
        return;
    }
    fir_flow.dataflow mut facts = fir_flow.dataflow_new(cast(c->fact_count, u32),
                                                        fir_flow.join_kind.join_intersect,
                                                        transfer_none);
    defer fir_flow.dataflow_free(&facts);
    run_facts(c, &pt, &stale, &fresh, &facts);
    judge(c, &stale, &fresh, &facts, &scratch, out);
    if (!out->leak_over) {
        judge_exits(c, &stale, &fresh, &facts, &scratch, out);
    }
    if (!out->inner_over) {
        judge_inners(c, &stale, &fresh, &facts, &scratch, out);
    }
}

// Writes the verdict of each store and of each check into `out`, and counts the ones that are not
// proved. With no fact `d` is null, and a store that the facts dataflow tests is not proved. Past
// the limit each set is null and nothing is proved, but a store into a whole scratch local counts
// as proved: no lvalue names it, and D17.8 keeps the lowering from a store over a live one.
fn judge(context mut* c, fir_flow.dataflow* stale, fir_flow.dataflow* fresh,
         fir_flow.dataflow* d, fir_flow.dataflow* scratch, proof mut* out) void {
    u64 mut k = 0;
    if (scratch != null) {
        judge_stores(c, stale, fresh, d, scratch, out);
    } else {
        while (k < out->stores.len) {
            out->stores[k].proved = is_scratch_store(c, &out->stores[k]);
            k += 1;
        }
    }
    k = 0;
    while (k < out->stores.len) {
        if (!out->stores[k].proved) {
            out->unproved += 1;
        }
        k += 1;
    }
    fir.func* f = c->places.f;
    fir_flow.bits mut seen = fir_flow.bits_new(fir.block_count(f));
    defer fir_flow.bits_free(&seen);
    u32 mut@ own queue = new(u32, cast(fir.block_count(f), u64));
    defer del(queue);
    u32 mut b = 0;
    while (b < fir.block_count(f)) {
        u32 fact = c->block_fact[cast(b, u64)];
        bool check = fir.block_at(f, b)->term.kind == fir.term_kind.tk_check_overwrite;
        bool held = fact != NO_FACT && d != null
            && fir_flow.bits_get(&d->outs[cast(b, u64)], fact)
            && guards_proved(c, b, out, &seen, queue);
        if (check && !held) {
            out->proved[cast(b, u64)] = false;
            out->unproved += 1;
        }
        b += 1;
    }
}

// Writes the verdict of each store of `out`: its fact holds after the reads of its operands and
// the kill of its `call`, before the kill rules of its store (apply_facts). A store into a whole
// scratch local takes the bit of the scratch dataflow at the same point. The walk of each block
// that holds a store starts from the sets that its entry has in the dataflows, and it gives both
// probes one set. With a null `d`, the walk keeps no fact.
fn judge_stores(context mut* c, fir_flow.dataflow* stale, fir_flow.dataflow* fresh,
                fir_flow.dataflow* d, fir_flow.dataflow* scratch, proof mut* out) void {
    fir.func* f = c->places.f;
    u32 locals = fir.local_count(f);
    probes mut pr = make_probes(cast(c->fact_count, u32));
    defer free_probes(&pr);
    fir_flow.bits mut at_stale = fir_flow.bits_new(locals);
    defer fir_flow.bits_free(&at_stale);
    fir_flow.bits mut at_fresh = fir_flow.bits_new(locals);
    defer fir_flow.bits_free(&at_fresh);
    fir_flow.bits mut at_scratch = fir_flow.bits_new(locals);
    defer fir_flow.bits_free(&at_scratch);
    u32 mut b = 0;
    while (b < fir.block_count(f)) {
        u64 mut k = c->first_store[cast(b, u64)];
        u64 end = c->first_store[cast(b, u64) + 1];
        if (k < end) {
            if (d != null) {
                fir_flow.bits_copy(&pr.none, &d->ins[cast(b, u64)]);
                fir_flow.bits_copy(&pr.all, &d->ins[cast(b, u64)]);
            }
            fir_flow.bits_copy(&at_stale, &stale->ins[cast(b, u64)]);
            fir_flow.bits_copy(&at_fresh, &fresh->ins[cast(b, u64)]);
            fir_flow.bits_copy(&at_scratch, &scratch->ins[cast(b, u64)]);
        }
        u32 mut i = 0;
        while (k < end) {
            fir.statement* s = fir.block_statement(f, b, i);
            bool here = out->stores[k].index == i;
            u32 mut fact = NO_FACT;
            if (here) {
                fact = c->store_fact[k];
            }
            bool mut held = false;
            if (d != null) {
                apply_facts(c, s, &at_stale, &at_fresh, &pr, fact, &held);
            }
            apply_scratch_reads(c, s, &at_scratch);
            if (here) {
                if (is_scratch_store(c, &out->stores[k])) {
                    out->stores[k].proved = fir_flow.bits_get(&at_scratch, s->place.local);
                } else {
                    out->stores[k].proved = fact != NO_FACT && held;
                }
                k += 1;
            }
            apply_scratch_store(c, s, &at_scratch);
            i += 1;
        }
        b += 1;
    }
}

// ---- the scratch locals ------------------------------------------------------------------------

// The reads of the statement `s` on the scratch set: a `move` of a whole scratch local, or a `del`
// of one, leaves the zero value in it.
fn apply_scratch_reads(context* c, fir.statement* s, fir_flow.bits mut* set) void {
    if (s->kind == fir.stmt_kind.st_del) {
        if (place.is_local(s->place) && place.is_scratch(&c->places, s->place.local)) {
            fir_flow.bits_set(set, s->place.local);
        }
        return;
    }
    fir.operand mut o = fir.operand{};
    u32 mut i = 0;
    while (fir.stmt_reads(c->places.f, s, i, &o)) {
        if (o.kind == fir.operand_kind.ok_move && place.is_local(o.place)
            && place.is_scratch(&c->places, o.place.local)) {
            fir_flow.bits_set(set, o.place.local);
        }
        i += 1;
    }
}

// The store of the statement `s` on the scratch set: a store of the zero value into a whole
// scratch local leaves it empty, and each other store into fixed storage of one fills it.
fn apply_scratch_store(context* c, fir.statement* s, fir_flow.bits mut* set) void {
    if (s->kind != fir.stmt_kind.st_assign || s->place.base != fir.base_kind.bk_local
        || !fir.place_fixed(c->places.f, s->place)
        || !place.is_scratch(&c->places, s->place.local)) {
        return;
    }
    if (s->place.proj_len == 0 && is_zero_value(c, s->value)) {
        fir_flow.bits_set(set, s->place.local);
    } else {
        fir_flow.bits_clear(set, s->place.local);
    }
}

// Runs the scratch dataflow: an intersection from an entry where each scratch local is empty, the
// state `S = {null}` of spec/ownership-design.md 4.4. A scratch local is no memory, so a call and a
// store through a pointer leave its bit, and only its own statements change it. Its sets are those
// of the fresh dataflow, so the second count of the work bounds them. A block that ends in a test
// of a whole scratch local gives its bit to the edge of the test: the walk sets the bit in the edge
// set right before the test statement, and each statement from there on applies to it, so a store
// into the local after the read clears it (spec/fir.md 11, Tests).
fn run_scratch(context mut* c, fir.pred_table* pt, fir_flow.dataflow mut* d) void {
    fir.func* f = c->places.f;
    u32 n = fir.block_count(f);
    u32 count = fir.local_count(f);
    fir_flow.bits mut@ own gens = make_sets(n, count);
    fir_flow.bits mut@ own kills = make_sets(n, count);
    fir_flow.bits mut@ own edge_gens = make_sets(n, count);
    u32 mut@ own edge_to = new(u32, cast(n, u64));
    defer {
        free_sets(gens);
        free_sets(kills);
        free_sets(edge_gens);
        del(gens);
        del(kills);
        del(edge_gens);
        del(edge_to);
    }
    probes mut pr = make_probes(count);
    defer free_probes(&pr);
    u32 mut b = 0;
    while (b < n) {
        reset_probes(&pr);
        place.test* t = &c->tests[cast(b, u64)];
        bool tested = c->tested[cast(b, u64)] && place.is_local(t->place)
            && place.is_scratch(&c->places, t->place.local);
        u32 mut i = 0;
        while (i < fir.block_statement_count(f, b)) {
            fir.statement* s = fir.block_statement(f, b, i);
            if (tested && i == t->index) {
                fir_flow.bits_set(&pr.edge, t->place.local);
            }
            apply_scratch_reads(c, s, &pr.none);
            apply_scratch_store(c, s, &pr.none);
            apply_scratch_reads(c, s, &pr.all);
            apply_scratch_store(c, s, &pr.all);
            apply_scratch_reads(c, s, &pr.edge);
            apply_scratch_store(c, s, &pr.edge);
            i += 1;
        }
        split_probes(&pr, gens, kills, b);
        edge_to[cast(b, u64)] = fir_flow.NO_EDGE;
        if (tested) {
            edge_to[cast(b, u64)] = t->target;
            fir_flow.bits_copy(&edge_gens[cast(b, u64)], &pr.edge);
        }
        b += 1;
    }
    u32 mut k = 0;
    while (k < count) {
        if (place.is_scratch(&c->places, k)) {
            fir_flow.bits_set(&d->entry, k);
        }
        k += 1;
    }
    fir_flow.bits_fill(&d->init);
    fir_flow.dataflow_forward_edges(f, pt, d, gens, kills, edge_to, edge_gens);
}

// Whether each store that the check that ends block `b` guards needs a proof and is proved. The
// check guards each store into its place (fir.is_same_place) that a path from the start of its
// continuation block reaches before any other store into that place. The walk follows every edge,
// and it enters each block once (`seen`), so it takes at most the statements and the terminators
// of the function. `queue` has room for each block.
fn guards_proved(context* c, u32 b, proof* out, fir_flow.bits mut* seen, u32 mut@ queue) bool {
    fir.func* f = c->places.f;
    fir.terminator* t = &fir.block_at(f, b)->term;
    u64 mut w = 0;
    while (w < seen->words.len) {
        seen->words[w] = 0;
        w += 1;
    }
    queue[0] = t->target;
    fir_flow.bits_set(seen, t->target);
    u64 mut len = 1;
    u64 mut at = 0;
    while (at < len) {
        u32 x = queue[at];
        at += 1;
        bool mut stored = false;
        u32 mut i = 0;
        while (i < fir.block_statement_count(f, x) && !stored) {
            fir.statement* s = fir.block_statement(f, x, i);
            if (s->kind == fir.stmt_kind.st_assign && fir.is_same_place(f, s->place, t->place)) {
                stored = true;
                // a guarded store that needs no proof has no fact to give the check
                u64 k = find_store(c, out, x, i);
                if (k >= out->stores.len || !out->stores[k].proved) {
                    return false;
                }
            }
            i += 1;
        }
        u32 mut e = 0;
        u32 mut next = 0;
        while (!stored && fir.term_targets(f, &fir.block_at(f, x)->term, e, &next)) {
            if (!fir_flow.bits_get(seen, next)) {
                fir_flow.bits_set(seen, next);
                queue[len] = next;
                len += 1;
            }
            e += 1;
        }
    }
    return true;
}

// ---- the leak rule -----------------------------------------------------------------------------

// Whether the local `n` is an owner local of part 1 of the leak rule (D17.20): a named local, a
// parameter or a temporary whose type is an `own` reference. `_0` passes its value to the caller,
// and a local of an owning aggregate waits for refinement R1.
fn is_owner_local(fir.func* f, u32 n) bool {
    fir.local* l = fir.local_at(f, n);
    return l->kind != fir.local_kind.lk_return && is_own_reference(l->ty);
}

// Whether `f` has an owner local, or with `named` a named owner local.
fn has_owner(fir.func* f, bool named) bool {
    u32 mut n = 0;
    while (n < fir.local_count(f)) {
        bool kind = !named || fir.local_at(f, n)->kind == fir.local_kind.lk_named;
        if (kind && is_owner_local(f, n)) {
            return true;
        }
        n += 1;
    }
    return false;
}

// The count of the owner locals that are no scratch local: the most facts that the exits add, which
// the leak work counts as the first count of the work counts the checks. An exit of a scratch local
// takes its bit of the scratch dataflow, whose sets the second count bounds.
fn count_owner_facts(context* c) u64 {
    fir.func* f = c->places.f;
    u64 mut count = 0;
    u32 mut n = 0;
    while (n < fir.local_count(f)) {
        if (is_owner_local(f, n) && !place.is_scratch(&c->places, n)) {
            count += 1;
        }
        n += 1;
    }
    return count;
}

// Whether the owner local `n` has an obligation at the `return` that ends block `b`. A parameter
// and a temporary have one. A named local has one when `ended` does not prove that its scope ended
// on each path to the end of the block. With a null `ended` it has none: the lowering writes the
// `dead` of each named local of each scope that a `return` leaves (spec/fir.md 9.5).
fn has_return_obligation(fir.func* f, fir_flow.dataflow* ended, u32 b, u32 n) bool {
    if (!is_owner_local(f, n)) {
        return false;
    }
    if (fir.local_at(f, n)->kind != fir.local_kind.lk_named) {
        return true;
    }
    return ended != null && !fir_flow.bits_get(&ended->outs[cast(b, u64)], n);
}

// Counts the exits of `f` in the order of find_exits, and with `fill` writes them into out->exits,
// which has room for each.
fn scan_exits(fir.func* f, fir_flow.dataflow* ended, proof mut* out, bool fill) u64 {
    u64 mut k = 0;
    u32 mut b = 0;
    while (b < fir.block_count(f)) {
        fir.terminator* t = &fir.block_at(f, b)->term;
        u32 count = fir.block_statement_count(f, b);
        u32 mut i = 0;
        while (i < count && !fir.term_is_abort(t)) {
            fir.statement* s = fir.block_statement(f, b, i);
            if (s->kind == fir.stmt_kind.st_dead && is_owner_local(f, s->local)) {
                if (fill) {
                    out->exits[k] = exit{b, i, s->local, false};
                }
                k += 1;
            }
            i += 1;
        }
        u32 mut n = 0;
        while (t->kind == fir.term_kind.tk_return && n < fir.local_count(f)) {
            if (has_return_obligation(f, ended, b, n)) {
                if (fill) {
                    out->exits[k] = exit{b, count, n, false};
                }
                k += 1;
            }
            n += 1;
        }
        b += 1;
    }
    return k;
}

// Lists in out->exits each obligation of part 1 of the leak rule, in block order. The `dead`
// marker of an owner local is one, but in an abort block: a runtime error runs no deferred code
// (D7.8, D11.4), so an exit into an abort block has no obligation. Rule V10 lets a `dead` name a
// named local only. A `return` has one for each owner local of has_return_obligation.
fn find_exits(context* c, fir_flow.dataflow* ended, proof mut* out) void {
    u64 count = scan_exits(c->places.f, ended, out, false);
    if (count == 0) {
        return;
    }
    del(out->exits);
    out->exits = new(exit, count);
    scan_exits(c->places.f, ended, out, true);
}

// Writes the verdict of each exit past the work limit. Only an exit of a scratch local holds: no
// lvalue names it, and D17.8 keeps the lowering from a `return` while one holds an allocation.
fn pass_exits(context* c, proof mut* out) void {
    u64 mut k = 0;
    while (k < out->exits.len) {
        out->exits[k].proved = place.is_scratch(&c->places, out->exits[k].local);
        if (!out->exits[k].proved) {
            out->leaks += 1;
        }
        k += 1;
    }
}

// Gives each exit of `out` the fact of its whole local, a tracked place, or NO_FACT for a scratch
// local, whose bit the scratch dataflow keeps.
fn collect_exit_facts(context mut* c, fir_flow.dataflow* stale, proof* out) void {
    u64 mut k = 0;
    while (k < out->exits.len) {
        exit* e = &out->exits[k];
        c->exit_fact[k] = NO_FACT;
        if (!place.is_scratch(&c->places, e->local)) {
            fir_flow.bits* at = &stale->ins[cast(e->block, u64)];
            c->exit_fact[k] = fact_of(c, fir.place_local(e->local), at);
        }
        k += 1;
    }
}

// Writes the verdict of each exit of `out`: the fact of its local, or the bit of a scratch local,
// holds at its `dead` marker, which changes no fact, or at the end of the block of its `return`.
// The walk of each block that holds an exit starts from the sets that its entry has in the
// dataflows, and it gives both probes one set. With a null `d`, no fact holds.
fn judge_exits(context mut* c, fir_flow.dataflow* stale, fir_flow.dataflow* fresh,
               fir_flow.dataflow* d, fir_flow.dataflow* scratch, proof mut* out) void {
    fir.func* f = c->places.f;
    u32 locals = fir.local_count(f);
    probes mut pr = make_probes(cast(c->fact_count, u32));
    defer free_probes(&pr);
    fir_flow.bits mut at_stale = fir_flow.bits_new(locals);
    defer fir_flow.bits_free(&at_stale);
    fir_flow.bits mut at_fresh = fir_flow.bits_new(locals);
    defer fir_flow.bits_free(&at_fresh);
    fir_flow.bits mut at_scratch = fir_flow.bits_new(locals);
    defer fir_flow.bits_free(&at_scratch);
    bool mut unused = false;
    u64 mut k = 0;
    while (k < out->exits.len) {
        u32 b = out->exits[k].block;
        if (d != null) {
            fir_flow.bits_copy(&pr.none, &d->ins[cast(b, u64)]);
            fir_flow.bits_copy(&pr.all, &d->ins[cast(b, u64)]);
        }
        fir_flow.bits_copy(&at_stale, &stale->ins[cast(b, u64)]);
        fir_flow.bits_copy(&at_fresh, &fresh->ins[cast(b, u64)]);
        fir_flow.bits_copy(&at_scratch, &scratch->ins[cast(b, u64)]);
        u32 mut i = 0;
        while (k < out->exits.len && out->exits[k].block == b) {
            exit mut* e = &out->exits[k];
            while (i < e->index) {
                fir.statement* s = fir.block_statement(f, b, i);
                if (d != null) {
                    apply_facts(c, s, &at_stale, &at_fresh, &pr, NO_FACT, &unused);
                }
                apply_scratch_reads(c, s, &at_scratch);
                apply_scratch_store(c, s, &at_scratch);
                i += 1;
            }
            u32 fact = c->exit_fact[k];
            if (fact == NO_FACT) {
                e->proved = fir_flow.bits_get(&at_scratch, e->local);
            } else {
                e->proved = d != null && fir_flow.bits_get(&pr.none, fact);
            }
            if (!e->proved) {
                out->leaks += 1;
            }
            k += 1;
        }
    }
}

// ---- the ended scopes --------------------------------------------------------------------------

// The effect of the statement `s` on the ended set. `dead(_n)` ends the scope of the named local
// `_n`. A store of a value that is not the zero value into fixed storage of a local, and an `addr`
// or a `slice` of that storage, start it again, because only they can give the local an
// allocation. A later store through a pointer goes through such an address of this scope, or
// through an address from before the `dead`, which dangles (D17.11). `live` changes no bit: a
// local whose scope ended holds no allocation, whatever its bytes hold.
fn apply_ended(context* c, fir.statement* s, fir_flow.bits mut* set) void {
    if (s->kind == fir.stmt_kind.st_dead) {
        fir_flow.bits_set(set, s->local);
        return;
    }
    u32 mut taken = 0;
    if (place.find_taken(&c->places, s, &taken)) {
        fir_flow.bits_clear(set, taken);
    }
    bool fixed = s->kind == fir.stmt_kind.st_assign && fir.place_fixed(c->places.f, s->place);
    if (fixed && !is_zero_value(c, s->value)) {
        fir_flow.bits_clear(set, s->place.local);
    }
}

// Runs the ended dataflow: an intersection from an entry where the scope of each named owner local
// has ended, because the frame of a call holds no allocation before its first store. Its bit for a
// named owner local says that the local holds no allocation, on each path: no store and no address
// above started its scope since the entry or since its last `dead`. Its sets are those of the
// fresh dataflow, so the second count of the work bounds them.
fn run_ended(context mut* c, fir.pred_table* pt, fir_flow.dataflow mut* d) void {
    fir.func* f = c->places.f;
    u32 n = fir.block_count(f);
    u32 count = fir.local_count(f);
    fir_flow.bits mut@ own gens = make_sets(n, count);
    fir_flow.bits mut@ own kills = make_sets(n, count);
    defer {
        free_sets(gens);
        free_sets(kills);
        del(gens);
        del(kills);
    }
    probes mut pr = make_probes(count);
    defer free_probes(&pr);
    u32 mut b = 0;
    while (b < n) {
        reset_probes(&pr);
        u32 mut i = 0;
        while (i < fir.block_statement_count(f, b)) {
            fir.statement* s = fir.block_statement(f, b, i);
            apply_ended(c, s, &pr.none);
            apply_ended(c, s, &pr.all);
            i += 1;
        }
        split_probes(&pr, gens, kills, b);
        b += 1;
    }
    u32 mut k = 0;
    while (k < count) {
        if (fir.local_at(f, k)->kind == fir.local_kind.lk_named && is_owner_local(f, k)) {
            fir_flow.bits_set(&d->entry, k);
        }
        k += 1;
    }
    fir_flow.bits_fill(&d->init);
    fir_flow.dataflow_forward_sets(f, pt, d, gens, kills);
}

// ---- the inner owners --------------------------------------------------------------------------

// Whether the statement `s` releases a pointer to an object with inner owners, a site of part 2 of
// the leak rule (D17.20): a `del` of a place of type `T* own`, of each mutability, or a `cast` that
// carries `own` from such a place to a pointer to another type, `void` included, where `T` holds
// inner owners. The place of the `del` or of the operand of the `cast` goes into *out, and the
// count of the inner owners of `T` (place.count_owners) into *owners. A cast to a pointer to `T`
// keeps each owner, so it has no obligation. A span and a `string` hold no inner owner of part 2:
// the `del` or the `cast` of a span whose elements hold owners waits for refinement R8 (D17.20).
fn released_place(fir.func* f, fir.statement* s, fir.place mut* out, u64 mut* owners) bool {
    if (s->kind == fir.stmt_kind.st_del) {
        *out = s->place;
    } else if (s->kind == fir.stmt_kind.st_assign && s->value.kind == fir.rvalue_kind.rv_cast) {
        types.node* to = s->value.ty;
        fir.operand o = fir.rvalue_operand(f, s->value, 0);
        bool pointer = to->kind == types.type_kind.k_ptr || to->kind == types.type_kind.k_voidptr;
        if (!pointer || !to->is_own || o.kind == fir.operand_kind.ok_const) {
            return false;
        }
        types.node* from = fir.place_type(f, o.place);
        bool same = to->kind == types.type_kind.k_ptr && from->kind == types.type_kind.k_ptr
            && types.type_equal(from->elem, to->elem);
        if (same) {
            return false;
        }
        *out = o.place;
    } else {
        return false;
    }
    types.node* t = fir.place_type(f, *out);
    if (t->kind != types.type_kind.k_ptr || !t->is_own) {
        return false;
    }
    *owners = place.count_owners(t->elem);
    return *owners > 0;
}

// Counts the obligations of part 2 of `f` in the order of find_inners, and with `fill` writes them
// into out->inners, which has room for each.
fn scan_inners(fir.func* f, proof mut* out, bool fill) u64 {
    u64 mut k = 0;
    u32 mut b = 0;
    while (b < fir.block_count(f)) {
        u32 mut i = 0;
        while (i < fir.block_statement_count(f, b)) {
            fir.place mut p = fir.place{};
            u64 mut owners = 0;
            if (released_place(f, fir.block_statement(f, b, i), &p, &owners)) {
                if (fill) {
                    out->inners[k] = inner{b, i, owners, 0, false};
                }
                k += 1;
            }
            i += 1;
        }
        b += 1;
    }
    return k;
}

// Lists in out->inners each obligation of part 2 of the leak rule, in block order and in statement
// order: each `del` and each owning `cast` of released_place. D17.20 gives part 2 no exception for
// an abort block, so a `del` there keeps its obligation.
fn find_inners(fir.func* f, proof mut* out) void {
    u64 count = scan_inners(f, out, false);
    if (count == 0) {
        return;
    }
    del(out->inners);
    out->inners = new(inner, count);
    scan_inners(f, out, true);
}

// The count of the steps of the paths of the inner owners of the obligations of `out`: for each
// inner owner its deref and at most place.depth_to_owners of the type of `*p` steps, and for the
// fact of the place `p` 1 more than the steps of its path (place.trace_steps). Each owner takes a
// fact, its path takes that many steps of memory, and each walk of the facts reads them, so the
// inner work counts them as the leak work counts the owner locals. It stops at types.OWNER_CAP.
fn count_inner_steps(context* c, proof* out) u64 {
    fir.func* f = c->places.f;
    u64 mut sum = 0;
    u64 mut k = 0;
    while (k < out->inners.len) {
        inner* e = &out->inners[k];
        fir.place p = inner_place(f, e);
        types.node* t = fir.place_type(f, p)->elem;
        u64 steps = types.capped_product(e->owners, place.depth_to_owners(t) + 1);
        sum = types.capped_sum(sum, steps);
        sum = types.capped_sum(sum, place.trace_steps(&c->places, p) + 1);
        k += 1;
    }
    return sum;
}

// Writes the verdict of each obligation of part 2 past the work limit: none is proved, and the
// first inner owner is the first that the analysis does not prove.
fn pass_inners(proof mut* out) void {
    u64 mut k = 0;
    while (k < out->inners.len) {
        out->inners[k].proved = false;
        out->inners[k].first = 0;
        out->inner_leaks += 1;
        k += 1;
    }
}

// The place of the `del` or of the operand of the `cast` of the obligation `e` of `f`.
fn inner_place(fir.func* f, inner* e) fir.place {
    fir.place mut p = fir.place{};
    u64 mut owners = 0;
    if (!released_place(f, fir.block_statement(f, e->block, e->index), &p, &owners)) {
        panic("owner.prover.inner_place: the statement releases no object with inner owners");
    }
    return p;
}

// Gives each inner owner of each obligation of `out` a fact of its own: the path of the owner
// through the pointer local of the place (place.put_inner_paths), or NO_FACT when the place is no
// whole local and so no place through it is tracked (D17.11). A place through a memory local is no
// tracked place either. No gen rule and no kill rule reads the number of a fact, so a second fact
// of one place holds what the first holds, and no search for an earlier fact takes the square of
// the owners. Each obligation also gives the place `p` that it releases a fact of its own, the
// path of `p` with the stale set before its statement (collect_site_facts), or NO_FACT when `p` is
// a whole scratch local, whose bit the scratch dataflow keeps, or no tracked place. Called within
// the inner work, which bounds the count of the owners and the steps of each `p`.
fn collect_inner_facts(context mut* c, fir_flow.dataflow* stale, proof* out) void {
    fir.func* f = c->places.f;
    del(c->first_inner);
    c->first_inner = new(u64, out->inners.len + 1);
    del(c->site_fact);
    c->site_fact = new(u32, out->inners.len);
    u64 mut total = 0;
    u64 mut k = 0;
    while (k < out->inners.len) {
        c->first_inner[k] = total;
        total += out->inners[k].owners;
        k += 1;
    }
    c->first_inner[out->inners.len] = total;
    collect_site_facts(c, stale, out);
    del(c->inner_fact);
    c->inner_fact = new(u32, total);
    k = 0;
    while (k < out->inners.len) {
        inner* e = &out->inners[k];
        fir.place p = inner_place(f, e);
        u64 first = c->first_inner[k];
        u64 mut m = 0;
        while (m < e->owners) {
            c->inner_fact[first + m] = NO_FACT;
            m += 1;
        }
        if (place.is_local(p)) {
            place.path mut@ own paths = new(place.path, e->owners);
            place.put_inner_paths(&c->places, p.local, fir.place_type(f, p)->elem, paths);
            m = 0;
            while (m < e->owners) {
                if (paths[m].tracked) {
                    c->inner_fact[first + m] = push_fact(c, paths[m]);
                }
                m += 1;
            }
            del(paths);
        }
        k += 1;
    }
}

// Gives the place `p` that each obligation of `out` releases its fact (collect_inner_facts). The
// walk of each block that holds an obligation reads the stale set before each statement.
fn collect_site_facts(context mut* c, fir_flow.dataflow* stale, proof* out) void {
    fir.func* f = c->places.f;
    fir_flow.bits mut at_stale = fir_flow.bits_new(fir.local_count(f));
    defer fir_flow.bits_free(&at_stale);
    u64 mut k = 0;
    while (k < out->inners.len) {
        u32 b = out->inners[k].block;
        fir_flow.bits_copy(&at_stale, &stale->ins[cast(b, u64)]);
        u32 mut i = 0;
        while (k < out->inners.len && out->inners[k].block == b) {
            inner* site = &out->inners[k];
            while (i < site->index) {
                place.apply_stale(&c->places, fir.block_statement(f, b, i), &at_stale);
                i += 1;
            }
            fir.place p = inner_place(f, site);
            c->site_fact[k] = NO_FACT;
            if (!place.is_local(p) || !place.is_scratch(&c->places, p.local)) {
                u64 mark = c->places.steps_len;
                place.path q = place.trace(&c->places, p, &at_stale);
                if (q.tracked) {
                    c->site_fact[k] = push_fact(c, q);
                } else {
                    c->places.steps_len = mark;
                }
            }
            k += 1;
        }
    }
}

// Whether the place that the obligation `k` of part 2 releases holds the zero value, at a point of
// its walk where the first probe of `pr` holds the facts and `scratch` the scratch bits: its fact
// holds, or for a whole scratch local its bit. A `del` of the zero value frees no object (D17.9),
// and a `cast` of it gives the zero value, so the obligation holds (D17.20 part 2). With a null
// `d`, no fact holds.
fn releases_nothing(context* c, proof* out, u64 k, fir_flow.dataflow* d, probes* pr,
                    fir_flow.bits* scratch) bool {
    fir.place p = inner_place(c->places.f, &out->inners[k]);
    if (place.is_local(p) && place.is_scratch(&c->places, p.local)) {
        return fir_flow.bits_get(scratch, p.local);
    }
    u32 fact = c->site_fact[k];
    return fact != NO_FACT && d != null && fir_flow.bits_get(&pr->none, fact);
}

// Writes the verdict of each obligation of part 2 of `out`: the fact of each inner owner holds
// right before its `del` or its `cast`, after the statements before it in its block, or the place
// that it releases holds the zero value there (releases_nothing). The first owner whose fact does
// not hold is `first`. The walk of each block that holds an obligation starts from the sets that
// its entry has in the dataflows, and it gives both probes one set. With a null `d`, no fact holds.
fn judge_inners(context mut* c, fir_flow.dataflow* stale, fir_flow.dataflow* fresh,
                fir_flow.dataflow* d, fir_flow.dataflow* scratch, proof mut* out) void {
    fir.func* f = c->places.f;
    u32 locals = fir.local_count(f);
    probes mut pr = make_probes(cast(c->fact_count, u32));
    defer free_probes(&pr);
    fir_flow.bits mut at_stale = fir_flow.bits_new(locals);
    defer fir_flow.bits_free(&at_stale);
    fir_flow.bits mut at_fresh = fir_flow.bits_new(locals);
    defer fir_flow.bits_free(&at_fresh);
    fir_flow.bits mut at_scratch = fir_flow.bits_new(locals);
    defer fir_flow.bits_free(&at_scratch);
    bool mut unused = false;
    u64 mut k = 0;
    while (k < out->inners.len) {
        u32 b = out->inners[k].block;
        if (d != null) {
            fir_flow.bits_copy(&pr.none, &d->ins[cast(b, u64)]);
            fir_flow.bits_copy(&pr.all, &d->ins[cast(b, u64)]);
        }
        fir_flow.bits_copy(&at_stale, &stale->ins[cast(b, u64)]);
        fir_flow.bits_copy(&at_fresh, &fresh->ins[cast(b, u64)]);
        fir_flow.bits_copy(&at_scratch, &scratch->ins[cast(b, u64)]);
        u32 mut i = 0;
        while (k < out->inners.len && out->inners[k].block == b) {
            inner mut* x = &out->inners[k];
            while (i < x->index) {
                fir.statement* s = fir.block_statement(f, b, i);
                if (d != null) {
                    apply_facts(c, s, &at_stale, &at_fresh, &pr, NO_FACT, &unused);
                }
                apply_scratch_reads(c, s, &at_scratch);
                apply_scratch_store(c, s, &at_scratch);
                i += 1;
            }
            x->first = x->owners;
            u64 mut m = 0;
            if (releases_nothing(c, out, k, d, &pr, &at_scratch)) {
                m = x->owners;
            }
            while (m < x->owners && x->first == x->owners) {
                u32 fact = c->inner_fact[c->first_inner[k] + m];
                if (fact == NO_FACT || d == null || !fir_flow.bits_get(&pr.none, fact)) {
                    x->first = m;
                }
                m += 1;
            }
            x->proved = x->first == x->owners;
            if (!x->proved) {
                out->inner_leaks += 1;
            }
            k += 1;
        }
    }
}
