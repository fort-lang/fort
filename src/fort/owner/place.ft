/// Reads the places of one verified FIR function for the ownership analysis (spec/fir.md 11,
/// spec/ownership-design.md 4.3): the tracked places as paths with keys, the memory locals, the
/// index temporaries and their keys, the held addresses, and the stale and fresh sets of the
/// locals.
//
// A path is a place with the key of each index in place of its index local. owner.prover keeps
// one fact for each path that it proves. Two forward dataflows of fir_flow read the transfer of
// the locals here: the stale index temporaries and held addresses, joined by union, and the fresh
// pointer locals, joined by intersection. A temporary `_t = copy _k` is stale at a point when a
// store into `_k` can stand between the assignment of `_t` and that point. A held address is
// stale when a store into a local that its place reads, a call or a store into memory can stand
// there.
// The module uses switches and no function-pointer dispatch table. It holds no module-level
// mutable state: each vector belongs to one survey, which one call of owner.prover.prove makes.
import fort.ast;
import fort.consts;
import fort.fir;
import fort.fir_flow;
import fort.prim;
import fort.types;

// The end of a chain of index temporaries.
u32 NO_LOCAL = 4294967295;

// ---- paths -------------------------------------------------------------------------------------

// The key of an index projection. `kk_local` names a local whose value at the point is the
// index, and `kk_constant` a constant. `kk_none` is an index with no key, which differs from
// every index.
enum key_kind {
    kk_none,
    kk_local,
    kk_constant,
}

struct key {
    key_kind kind;
    u32 local;
    consts.cval value;
}

enum step_kind {
    sk_deref,
    sk_field,
    sk_index,
}

// One projection of a path. `header` says that an index applies to a span or a `string`, whose
// pointer field it reads first.
struct step {
    step_kind kind;
    u32 field;
    key key;
    bool header;
}

// A place with the key of each index in place of its index local. Entries `first` to
// `first + len - 1` of the steps of the survey hold its projections. `tracked` says that the
// path is a tracked place.
struct path {
    fir.base_kind base;
    u32 local;
    ast.sym* global;
    u32 first;
    u32 len;
    bool tracked;
}

// What the analysis knows of one local before the dataflows. `assigns` counts the stores into the
// storage of the local, whose place is fixed storage with the local as its base (fir.place_fixed),
// and `reads` its reads as a whole local (fir.stmt_read_all, fir.term_read_all). `def_block` and
// `def_index` give the last store. When `assigns` is 1 and the local is read, that store writes
// the whole local: rule V13 needs a whole assignment of a temporary before each read of it.
// `checks` counts the checks of `(*_n)`, and `stores` the stores into `(*_n)`. `based` counts the
// stores whose place has the local as its base, through a deref too. `source` is the key of an
// index temporary before the stale test, `next_source` the next temporary with the same source
// local, and `sourced` the count of the temporaries whose source is the local.
struct local_info {
    u32 assigns;
    u32 reads;
    u32 def_block;
    u32 def_index;
    u32 checks;
    u32 stores;
    u32 based;
    bool memory;
    bool held;
    key source;
    u32 next_source;
    u32 sourced;
}

// A held address whose place reads a local, and the next reader of that local, or NO_LOCAL.
struct reader {
    u32 held;
    u32 next;
}

/// What the analysis knows of the places of one function: each local, the sources of the index
/// temporaries, the held addresses and their readers, and the steps of the paths in use.
/// `first_source[k]` is the first index temporary whose source is the local `k`, and
/// `first_reader[k]` the first entry of `readers` for a held address whose place reads the local
/// `k`. `held` lists the held addresses. `steps[..steps_len]` holds the steps of each path that
/// the caller keeps and of the path in use.
struct survey {
    fir.func* f;
    local_info mut@ own locals;
    u32 mut@ own first_source;
    u32 mut@ own first_reader;
    reader mut@ own readers;
    u32 mut@ own held;
    step mut@ own steps;
    u64 steps_len;
    fir.read_list reads;
}

/// Frees the vectors of `c`.
fn free(survey mut* c) void {
    del(c->locals);
    del(c->first_source);
    del(c->first_reader);
    del(c->readers);
    del(c->held);
    del(c->steps);
    fir.read_list_free(&c->reads);
}

// Appends `s` to the steps, growing them as fir.grown_capacity says.
fn push_step(survey mut* c, step s) void {
    if (c->steps_len == c->steps.len) {
        u64 cap = fir.grown_capacity(c->steps.len, "owner.place: too many steps");
        step mut@ own bigger = new(step, cap);
        u64 mut i = 0;
        while (i < c->steps_len) {
            bigger[i] = c->steps[i];
            i += 1;
        }
        del(c->steps);
        c->steps = move(bigger);
    }
    c->steps[c->steps_len] = s;
    c->steps_len += 1;
}

fn step_at(survey* c, path p, u32 i) step {
    return c->steps[cast(p.first, u64) + cast(i, u64)];
}

// Whether `p` is a whole local, with no projection.
fn is_local(fir.place p) bool {
    return p.base == fir.base_kind.bk_local && p.proj_len == 0;
}

// Whether `p` is `(*_n)` for some local `_n`, with no other projection.
fn is_deref_local(fir.func* f, fir.place p) bool {
    return p.base == fir.base_kind.bk_local && p.proj_len == 1
        && fir.place_projection(f, p, 0).kind == fir.proj_kind.pj_deref;
}

// Whether exactly one store writes the local `n` and it is no memory: then store_of gives that
// store.
fn is_single(survey* c, u32 n) bool {
    local_info* l = &c->locals[cast(n, u64)];
    return l->assigns == 1 && !l->memory;
}

// The one store of the local `n`, when is_single holds.
fn store_of(survey* c, u32 n) fir.statement* {
    local_info* l = &c->locals[cast(n, u64)];
    return fir.block_statement(c->f, l->def_block, l->def_index);
}

// ---- the survey of the locals ------------------------------------------------------------------

// Counts the reads of each whole local that the read list of `c` holds.
fn count_reads(survey mut* c) void {
    u64 mut i = 0;
    while (i < c->reads.len) {
        fir.place p = c->reads.items[i].place;
        if (is_local(p)) {
            c->locals[cast(p.local, u64)].reads += 1;
        }
        i += 1;
    }
}

// Counts the stores, the reads, the checks of `(*_n)` and the stores into `(*_n)` of each local,
// and records the store of each local that has one.
fn count_uses(survey mut* c) void {
    fir.func* f = c->f;
    u32 mut b = 0;
    while (b < fir.block_count(f)) {
        u32 mut i = 0;
        while (i < fir.block_statement_count(f, b)) {
            fir.statement* s = fir.block_statement(f, b, i);
            if (s->kind == fir.stmt_kind.st_assign && fir.place_fixed(f, s->place)) {
                local_info mut* l = &c->locals[cast(s->place.local, u64)];
                l->assigns += 1;
                l->def_block = b;
                l->def_index = i;
            }
            if (s->kind == fir.stmt_kind.st_assign && is_deref_local(f, s->place)) {
                c->locals[cast(s->place.local, u64)].stores += 1;
            }
            if (s->kind == fir.stmt_kind.st_assign && s->place.base == fir.base_kind.bk_local) {
                c->locals[cast(s->place.local, u64)].based += 1;
            }
            fir.stmt_read_all(f, s, &c->reads);
            count_reads(c);
            i += 1;
        }
        fir.terminator* t = &fir.block_at(f, b)->term;
        if (t->kind == fir.term_kind.tk_check_overwrite && is_deref_local(f, t->place)) {
            c->locals[cast(t->place.local, u64)].checks += 1;
        }
        fir.term_read_all(f, t, &c->reads);
        count_reads(c);
        b += 1;
    }
}

// Whether the local `a` can be a held address: a temporary that one store writes with
// `addr mut(p)`, and that one check of `(*_a)` and one store into `(*_a)` read, and nothing else.
// `p` is no fixed storage, as in the lowering: an address of fixed storage makes its local memory.
fn is_held_address(survey* c, u32 a) bool {
    local_info* l = &c->locals[cast(a, u64)];
    if (fir.local_at(c->f, a)->kind != fir.local_kind.lk_temp || l->assigns != 1) {
        return false;
    }
    fir.rvalue r = store_of(c, a)->value;
    return r.kind == fir.rvalue_kind.rv_addr && r.is_mut && !fir.place_fixed(c->f, r.place)
        && l->reads == 2 && l->checks == 1 && l->stores == 1;
}

// Whether the statement `s` takes the address of the storage of a local, and which one in *out:
// an `addr` or a `slice` of a fixed array whose place is fixed storage of a local. A place that
// passes through a deref or an index on a span or a `string` names no byte of the local.
fn find_taken(survey* c, fir.statement* s, u32 mut* out) bool {
    if (s->kind != fir.stmt_kind.st_assign) {
        return false;
    }
    fir.rvalue r = s->value;
    bool slice = r.kind == fir.rvalue_kind.rv_slice
        && fir.place_type(c->f, r.place)->kind == types.type_kind.k_array;
    if (r.kind != fir.rvalue_kind.rv_addr && !slice) {
        return false;
    }
    if (!fir.place_fixed(c->f, r.place)) {
        return false;
    }
    *out = r.place.local;
    return true;
}

// Marks the memory locals, then the held addresses, in time linear in the statements. A held
// address takes the address of no fixed storage, so it makes no local memory, and a held address
// that is memory is no held address.
fn mark_memory(survey mut* c) void {
    fir.func* f = c->f;
    // the storage of an aggregate result is the destination of the caller
    if (fir.type_aggregate(fir.local_at(f, 0)->ty)) {
        c->locals[0].memory = true;
    }
    u32 mut b = 0;
    while (b < fir.block_count(f)) {
        u32 mut i = 0;
        while (i < fir.block_statement_count(f, b)) {
            u32 mut taken = 0;
            if (find_taken(c, fir.block_statement(f, b, i), &taken)) {
                c->locals[cast(taken, u64)].memory = true;
            }
            i += 1;
        }
        b += 1;
    }
    u32 mut k = 0;
    while (k < fir.local_count(f)) {
        local_info mut* l = &c->locals[cast(k, u64)];
        l->held = !l->memory && is_held_address(c, k);
        k += 1;
    }
    mark_readers(c);
}

// Lists the held addresses, and records each one as a reader of the locals that the address of
// its place reads: the base of the place and each index local.
fn mark_readers(survey mut* c) void {
    fir.func* f = c->f;
    u32 n = fir.local_count(f);
    u64 mut count = 0;
    u64 mut held = 0;
    u32 mut k = 0;
    while (k < n) {
        if (c->locals[cast(k, u64)].held) {
            count += 1 + cast(store_of(c, k)->value.place.proj_len, u64);
            held += 1;
        }
        k += 1;
    }
    del(c->first_reader);
    c->first_reader = new(u32, cast(n, u64));
    del(c->readers);
    c->readers = new(reader, count);
    del(c->held);
    c->held = new(u32, held);
    k = 0;
    while (k < n) {
        c->first_reader[cast(k, u64)] = NO_LOCAL;
        k += 1;
    }
    u32 mut at = 0;
    held = 0;
    k = 0;
    while (k < n) {
        if (c->locals[cast(k, u64)].held) {
            c->held[held] = k;
            held += 1;
            fir.place p = store_of(c, k)->value.place;
            add_reader(c, p.local, k, &at);
            u32 mut i = 0;
            while (i < p.proj_len) {
                fir.projection pj = fir.place_projection(f, p, i);
                if (pj.kind == fir.proj_kind.pj_index) {
                    add_reader(c, pj.index, k, &at);
                }
                i += 1;
            }
        }
        k += 1;
    }
}

// Records the held address `held` as reader *at of the local `local`.
fn add_reader(survey mut* c, u32 local, u32 held, u32 mut* at) void {
    c->readers[cast(*at, u64)] = reader{held, c->first_reader[cast(local, u64)]};
    c->first_reader[cast(local, u64)] = *at;
    *at += 1;
}

// Whether `t` is the type `u64`.
fn is_u64(types.node* t) bool {
    return t->kind == types.type_kind.k_prim && t->prim == prim.prim_kind.prim_u64;
}

// Gives each index temporary its source: the local `_k` of `_t = copy _k` or of
// `_t = cast<u64>(copy _k)`, when `_k` is no memory, or the constant `c` of `_t = const u64 c` or
// of a cast of the integer constant `c`. One store must write the temporary, and the temporary
// is no memory.
fn mark_sources(survey mut* c) void {
    fir.func* f = c->f;
    u32 n = fir.local_count(f);
    u32 mut t = 0;
    while (t < n) {
        c->locals[cast(t, u64)].next_source = NO_LOCAL;
        c->first_source[cast(t, u64)] = NO_LOCAL;
        t += 1;
    }
    t = 0;
    while (t < n) {
        local_info mut* l = &c->locals[cast(t, u64)];
        if (fir.local_at(f, t)->kind == fir.local_kind.lk_temp && is_single(c, t)) {
            fir.rvalue r = store_of(c, t)->value;
            bool shape = r.kind == fir.rvalue_kind.rv_use
                || (r.kind == fir.rvalue_kind.rv_cast && is_u64(r.ty));
            if (shape) {
                fir.operand o = fir.rvalue_operand(f, r, 0);
                if (o.kind == fir.operand_kind.ok_const && o.value.kind == fir.const_kind.ck_int) {
                    l->source = key{key_kind.kk_constant, 0, o.value.value};
                } else if (o.kind == fir.operand_kind.ok_copy && is_local(o.place)
                           && !c->locals[cast(o.place.local, u64)].memory) {
                    l->source = key{.kind = key_kind.kk_local, .local = o.place.local};
                    l->next_source = c->first_source[cast(o.place.local, u64)];
                    c->first_source[cast(o.place.local, u64)] = t;
                    c->locals[cast(o.place.local, u64)].sourced += 1;
                }
            }
        }
        t += 1;
    }
}

// ---- the operands of an item -------------------------------------------------------------------

// Operand `i` of the terminator `t` in *out: the operand of a `switch`, the condition and the
// reported operands of a `check`, the reported operands of a `fail`. False past the count.
fn find_operand(fir.func* f, fir.terminator* t, u32 i, fir.operand mut* out) bool {
    u32 mut at = i;
    if (t->kind == fir.term_kind.tk_switch || t->kind == fir.term_kind.tk_check) {
        if (at == 0) {
            *out = t->cond;
            return true;
        }
        at -= 1;
    }
    if (t->kind != fir.term_kind.tk_check && t->kind != fir.term_kind.tk_fail) {
        return false;
    }
    if (at >= t->args_len) {
        return false;
    }
    *out = fir.operand_at(f, t->args_first + at);
    return true;
}

// ---- the stale index temporaries ---------------------------------------------------------------

// The steps of the stale chains: for each local, the stores whose place has it as its base times
// the temporaries whose source it is (mark_sources). apply_stale takes that many steps in one
// walk.
fn stale_steps(survey* c) u64 {
    u64 mut sum = 0;
    u64 mut k = 0;
    while (k < c->locals.len) {
        sum += cast(c->locals[k].based, u64) * cast(c->locals[k].sourced, u64);
        k += 1;
    }
    return sum;
}

// The effect of the statement `s` on the stale set: a store into a local makes each temporary
// with that source stale, and each held address whose place reads the local. A statement that can
// write memory makes each held address stale, because its place can read a span or `string`
// header in memory. The store of such a temporary or held address makes it fresh again. A held
// address has one check, so its steps here stay within a small multiple of the statements times
// the checks of the work.
fn apply_stale(survey* c, fir.statement* s, fir_flow.bits mut* stale) void {
    if (s->kind != fir.stmt_kind.st_assign) {
        return;
    }
    if (writes_memory(c, s)) {
        u64 mut h = 0;
        while (h < c->held.len) {
            fir_flow.bits_set(stale, c->held[h]);
            h += 1;
        }
    }
    if (s->place.base != fir.base_kind.bk_local) {
        return;
    }
    u32 mut t = c->first_source[cast(s->place.local, u64)];
    while (t != NO_LOCAL) {
        fir_flow.bits_set(stale, t);
        t = c->locals[cast(t, u64)].next_source;
    }
    u32 mut r = c->first_reader[cast(s->place.local, u64)];
    while (r != NO_LOCAL) {
        fir_flow.bits_set(stale, c->readers[cast(r, u64)].held);
        r = c->readers[cast(r, u64)].next;
    }
    local_info* l = &c->locals[cast(s->place.local, u64)];
    if (s->place.proj_len == 0 && (l->source.kind == key_kind.kk_local || l->held)) {
        fir_flow.bits_clear(stale, s->place.local);
    }
}

// Whether the assignment `s` can write memory: a `call`, a store through a pointer, or a store
// straight into a memory local or a global. A store into fixed storage of a local that is no
// memory writes no memory, and `alloc` writes only new storage.
fn writes_memory(survey* c, fir.statement* s) bool {
    if (s->value.kind == fir.rvalue_kind.rv_call || !fir.place_fixed(c->f, s->place)) {
        return true;
    }
    return c->locals[cast(s->place.local, u64)].memory;
}

// ---- the fresh pointer locals ------------------------------------------------------------------

// Whether the rvalue `r` writes a fresh `new`: `alloc`, or the `move` of a temporary that one
// store writes with an `alloc` and that only this `move` reads.
fn is_fresh_new(survey* c, fir.rvalue r) bool {
    if (r.kind == fir.rvalue_kind.rv_alloc) {
        return true;
    }
    u32 mut t = 0;
    if (!find_moved_temp(c, r, &t)) {
        return false;
    }
    return store_of(c, t)->value.kind == fir.rvalue_kind.rv_alloc;
}

// Whether the rvalue `r` is `move _t` of a temporary that one store writes, that is no memory and
// that only this `move` reads, and which one in *out.
fn find_moved_temp(survey* c, fir.rvalue r, u32 mut* out) bool {
    if (r.kind != fir.rvalue_kind.rv_use) {
        return false;
    }
    fir.operand o = fir.rvalue_operand(c->f, r, 0);
    if (o.kind != fir.operand_kind.ok_move || !is_local(o.place)) {
        return false;
    }
    local_info* l = &c->locals[cast(o.place.local, u64)];
    if (fir.local_at(c->f, o.place.local)->kind != fir.local_kind.lk_temp
        || !is_single(c, o.place.local) || l->reads != 1) {
        return false;
    }
    *out = o.place.local;
    return true;
}

// Ends the freshness of a local that the operand `o` copies or moves as a whole.
fn end_fresh(fir.operand o, fir_flow.bits mut* fresh) void {
    if (o.kind != fir.operand_kind.ok_const && is_local(o.place)) {
        fir_flow.bits_clear(fresh, o.place.local);
    }
}

// The effect of the right side of the statement `s` on the fresh set: each operand that copies
// or moves a local as a whole, and each `addr` or `slice` that names a place of a local, other
// than the store of a held address, ends the freshness of that local.
fn apply_fresh_reads(survey* c, fir.statement* s, fir_flow.bits mut* fresh) void {
    fir.operand mut o = fir.operand{};
    u32 mut i = 0;
    while (fir.stmt_reads(c->f, s, i, &o)) {
        end_fresh(o, fresh);
        i += 1;
    }
    if (s->kind != fir.stmt_kind.st_assign) {
        return;
    }
    fir.rvalue r = s->value;
    bool names = r.kind == fir.rvalue_kind.rv_addr || r.kind == fir.rvalue_kind.rv_slice;
    bool held = is_local(s->place) && c->locals[cast(s->place.local, u64)].held;
    if (names && !held && r.place.base == fir.base_kind.bk_local) {
        fir_flow.bits_clear(fresh, r.place.local);
    }
}

// The effect of the store of the statement `s` on the fresh set: a store of a fresh `new` into a
// whole local makes it fresh, and any other store into the whole local ends its freshness.
fn apply_fresh_store(survey* c, fir.statement* s, fir_flow.bits mut* fresh) void {
    if (s->kind != fir.stmt_kind.st_assign || !is_local(s->place)) {
        return;
    }
    if (is_fresh_new(c, s->value)) {
        fir_flow.bits_set(fresh, s->place.local);
    } else {
        fir_flow.bits_clear(fresh, s->place.local);
    }
}

// The effect of the terminator `t` on the fresh set.
fn apply_fresh_term(survey* c, fir.terminator* t, fir_flow.bits mut* fresh) void {
    fir.operand mut o = fir.operand{};
    u32 mut i = 0;
    while (find_operand(c->f, t, i, &o)) {
        end_fresh(o, fresh);
        i += 1;
    }
}

// Whether the local `n` is a fresh pointer local in `fresh`: a pointer local that is no memory.
fn is_fresh(survey* c, fir_flow.bits* fresh, u32 n) bool {
    return fir_flow.bits_get(fresh, n) && !c->locals[cast(n, u64)].memory
        && fir.local_at(c->f, n)->ty->kind == types.type_kind.k_ptr;
}

// ---- the path of a place -----------------------------------------------------------------------

// Whether `p` is `(*_a)` for a held address `_a`.
fn is_held_place(survey* c, fir.place p) bool {
    return is_deref_local(c->f, p) && c->locals[cast(p.local, u64)].held;
}

// Whether `p` is `(*_a)` for a held address `_a` that is stale in `stale`.
fn is_stale_held(survey* c, fir.place p, fir_flow.bits* stale) bool {
    return is_held_place(c, p) && fir_flow.bits_get(stale, p.local);
}

// The key of the index local `i` at a point whose stale set is `stale`. A temporary has the key
// of its source, unless the source is a local and the temporary is stale. A named local or a
// parameter that is no memory is its own key. The return place is no key.
fn key_of(survey* c, u32 i, fir_flow.bits* stale) key {
    local_info* l = &c->locals[cast(i, u64)];
    fir.local_kind kind = fir.local_at(c->f, i)->kind;
    if (kind == fir.local_kind.lk_return) {
        return key{};
    }
    if (kind == fir.local_kind.lk_temp) {
        if (l->source.kind == key_kind.kk_constant) {
            return l->source;
        }
        if (l->source.kind == key_kind.kk_local && !fir_flow.bits_get(stale, i)) {
            return l->source;
        }
        return key{};
    }
    if (l->memory) {
        return key{};
    }
    return key{.kind = key_kind.kk_local, .local = i};
}

// The path of the place `p` at a point whose stale set is `stale`, with its steps at the end of
// the steps of `c`. A held address `(*_a)` reads as the place of its `addr mut` while it is not
// stale, and a stale one is no tracked place. The path is tracked when a deref stands first and
// follows a pointer local that is no memory, and each index has a key.
fn trace(survey mut* c, fir.place p, fir_flow.bits* stale) path {
    fir.func* f = c->f;
    fir.place mut src = p;
    bool held = is_held_place(c, p);
    // a stale held address can name a place in a fresh object, whose freshness its `addr` did
    // not end, so it gives no tracked place
    bool stale_held = is_stale_held(c, p, stale);
    if (held && !stale_held) {
        src = store_of(c, p.local)->value.place;
    }
    path mut out = path{
        .base = src.base,
        .local = src.local,
        .global = src.global,
        .first = cast(c->steps_len, u32),
        .tracked = !stale_held,
    };
    types.node* mut t = fir.base_type(f, src);
    u32 mut i = 0;
    while (i < src.proj_len) {
        fir.projection pj = fir.place_projection(f, src, i);
        step mut s = step{};
        switch (pj.kind) {
        case fir.proj_kind.pj_deref:
            s.kind = step_kind.sk_deref;
            bool pointer = src.base == fir.base_kind.bk_local && t->kind == types.type_kind.k_ptr;
            if (i != 0 || !pointer || c->locals[cast(src.local, u64)].memory) {
                out.tracked = false;
            }
        case fir.proj_kind.pj_field:
            s.kind = step_kind.sk_field;
            s.field = pj.field;
        case fir.proj_kind.pj_index:
            s.kind = step_kind.sk_index;
            s.header = t->kind == types.type_kind.k_span || t->kind == types.type_kind.k_string;
            s.key = key_of(c, pj.index, stale);
            if (s.key.kind == key_kind.kk_none) {
                out.tracked = false;
            }
        }
        push_step(c, s);
        out.len += 1;
        t = fir.apply_projection(f, t, pj);
        i += 1;
    }
    return out;
}

// Whether two keys name one element: both are keys, of one kind, of one local or one value.
fn is_same_key(key a, key b) bool {
    if (a.kind == key_kind.kk_none || a.kind != b.kind) {
        return false;
    }
    if (a.kind == key_kind.kk_local) {
        return a.local == b.local;
    }
    return consts.cv_eq(a.value, b.value);
}

// Whether two steps differ: two kinds, two fields, or two indexes whose keys differ.
fn is_different(step a, step b) bool {
    if (a.kind != b.kind) {
        return true;
    }
    switch (a.kind) {
    case step_kind.sk_deref:
        return false;
    case step_kind.sk_field:
        return a.field != b.field;
    case step_kind.sk_index:
        return !is_same_key(a.key, b.key);
    }
}

fn is_same_base(path a, path b) bool {
    if (a.base != b.base) {
        return false;
    }
    if (a.base == fir.base_kind.bk_global) {
        return a.global == b.global;
    }
    return a.local == b.local;
}

// Whether two paths with one base are separate: neither leaves its first object after its first
// step, and at the first step where they differ, both steps are fields. A path that starts the
// other is not separate from it. A path leaves its object at a deref or at an index on a span or
// a `string`, after which it can name any storage: `p->next->g` can be `p->g`.
fn is_separate(survey* c, path a, path b) bool {
    if (is_leaving(c, a) || is_leaving(c, b)) {
        return false;
    }
    u32 mut i = 0;
    while (i < a.len && i < b.len) {
        step x = step_at(c, a, i);
        step y = step_at(c, b, i);
        if (is_different(x, y)) {
            return x.kind == step_kind.sk_field && y.kind == step_kind.sk_field;
        }
        i += 1;
    }
    return false;
}

// Whether `q` has a deref or an index on a span or a `string` after its first step.
fn is_leaving(survey* c, path q) bool {
    u32 mut i = 1;
    while (i < q.len) {
        step s = step_at(c, q, i);
        if (s.kind == step_kind.sk_deref || s.header) {
            return true;
        }
        i += 1;
    }
    return false;
}

// Whether `q` is `p` or a tracked place below `p`: it starts with the base and every step of
// `p`, and continues with fields and indexes on fixed arrays only.
fn is_below(survey* c, path q, path p) bool {
    if (!is_same_base(q, p) || q.len < p.len) {
        return false;
    }
    u32 mut i = 0;
    while (i < q.len) {
        step s = step_at(c, q, i);
        if (i < p.len) {
            if (is_different(s, step_at(c, p, i))) {
                return false;
            }
        } else if (s.kind == step_kind.sk_deref || s.header) {
            return false;
        }
        i += 1;
    }
    return true;
}

// Whether the paths `q` and `p` are one place: each is below the other.
fn is_same(survey* c, path q, path p) bool {
    return q.len == p.len && is_below(c, q, p);
}

// Whether `q` is a place through the pointer local `n`: `(*_n)` followed by fields and indexes on
// fixed arrays only.
fn is_through(survey* c, path q, u32 n) bool {
    if (q.base != fir.base_kind.bk_local || q.local != n || q.len == 0
        || step_at(c, q, 0).kind != step_kind.sk_deref) {
        return false;
    }
    u32 mut i = 1;
    while (i < q.len) {
        step s = step_at(c, q, i);
        if (s.kind == step_kind.sk_deref || s.header) {
            return false;
        }
        i += 1;
    }
    return true;
}

// Whether `q` holds a deref or an index on a span or a `string`: a store into it is a store
// through a pointer.
fn is_indirect(survey* c, path q) bool {
    u32 mut i = 0;
    while (i < q.len) {
        step s = step_at(c, q, i);
        if (s.kind == step_kind.sk_deref || s.header) {
            return true;
        }
        i += 1;
    }
    return false;
}

/// Whether `q` lies in storage that holds no allocation at the entry: fixed storage of a temporary,
/// or of `_0` when its type is no aggregate. The frame of the call gives that storage, and no
/// store wrote it before, so its places start empty: the state `S = {null}` of
/// spec/ownership-design.md 4.4. The storage of an aggregate `_0` is the destination of the
/// caller, which can hold owners, because D17.11 checks no store of an owning aggregate.
fn is_empty_at_entry(survey* c, path q) bool {
    if (q.base != fir.base_kind.bk_local || is_indirect(c, q)) {
        return false;
    }
    fir.local* l = fir.local_at(c->f, q.local);
    if (l->kind == fir.local_kind.lk_return) {
        return !fir.type_aggregate(l->ty);
    }
    return l->kind == fir.local_kind.lk_temp;
}

/// Whether the local `n` is a scratch local: a temporary, or `_0`, of an `own` reference type
/// that is no memory. No pointer names its storage and no call writes it, so one bit for each
/// local holds the fact of the whole local (owner.prover, run_scratch), as the fresh pointer
/// locals take one bit each.
fn is_scratch(survey* c, u32 n) bool {
    fir.local* l = fir.local_at(c->f, n);
    bool kind = l->kind == fir.local_kind.lk_temp || l->kind == fir.local_kind.lk_return;
    return kind && !c->locals[cast(n, u64)].memory && types.type_is_reference(l->ty)
        && l->ty->is_own;
}

// Whether `q` is reached through memory: a place of a memory local or of a global, or a place
// that holds a deref or an index on a span or a `string`.
fn is_through_memory(survey* c, path q) bool {
    if (q.base == fir.base_kind.bk_global || c->locals[cast(q.local, u64)].memory) {
        return true;
    }
    return is_indirect(c, q);
}

// Whether `q` holds an index whose key is the local `k`.
fn has_key(survey* c, path q, u32 k) bool {
    u32 mut i = 0;
    while (i < q.len) {
        step s = step_at(c, q, i);
        if (s.kind == step_kind.sk_index && s.key.kind == key_kind.kk_local && s.key.local == k) {
            return true;
        }
        i += 1;
    }
    return false;
}

// Whether `q` is a place through a fresh pointer local of `fresh`. A null `fresh` has no local.
fn is_through_fresh(survey* c, path q, fir_flow.bits* fresh) bool {
    return fresh != null && q.base == fir.base_kind.bk_local && is_fresh(c, fresh, q.local)
        && is_through(c, q, q.local);
}

// ---- the inner owners --------------------------------------------------------------------------

/// The count of the inner owners of the type `t`, the owners in its fixed storage (fir.md 5.5),
/// at most types.OWNER_CAP (types.type_owner_count). The layout of a struct keeps its count, so
/// no call walks the fields of a struct.
fn count_owners(types.node* t) u64 {
    return types.type_owner_count(t);
}

/// One step from a type toward one of its inner owners: field `field` of a struct, whose name is
/// `name`, or element `index` of a fixed array, with `element`. `ty` is the type that the step
/// reaches.
struct owner_step {
    bool element;
    u32 field;
    string name;
    u64 index;
    types.node* ty;
}

/// The step from the type `t` toward its inner owner `k`, in the order of count_owners: the fields
/// of a struct in the order of their declarations and the elements of a fixed array from the first,
/// each with its own owners before those of the next. *rest takes the number of that owner among
/// the inner owners of the type of the step. False when `t` is itself the owner, an `own`
/// reference, and then nothing is written.
fn next_owner_step(types.node* t, u64 k, owner_step mut* out, u64 mut* rest) bool {
    if (types.type_is_reference(t)) {
        return false;
    }
    if (t->kind == types.type_kind.k_array) {
        u64 each = count_owners(t->elem);
        *out = owner_step{.element = true, .index = k / each, .ty = t->elem};
        *rest = k % each;
        return true;
    }
    ast.node* decl = fir.struct_decl(t);
    u64 mut left = k;
    u32 mut field = 0;
    u64 mut i = 0;
    while (i < ast.ast_len(decl)) {
        ast.node* n = ast.ast_child(decl, i);
        if (n->kind == ast.ast_kind.k_field_decl) {
            u64 count = count_owners(n->ty);
            if (left < count) {
                *out = owner_step{.field = field, .name = n->name, .ty = n->ty};
                *rest = left;
                return true;
            }
            left -= count;
            field += 1;
        }
        i += 1;
    }
    panic("owner.place.next_owner_step: no such inner owner");
}

// The most steps from the type `t` to one of its inner owners (types.type_owner_depth). The
// layout of a struct keeps its depth, so no call walks the fields of a struct.
fn depth_to_owners(types.node* t) u64 {
    return types.type_owner_depth(t);
}

/// Writes into `out` the path of each inner owner of the type `t` through the pointer local `n`,
/// in the order of next_owner_step, with one walk of `t`: `(*_n)`, then a field step for a field
/// and an index step with a constant key for an element. A path is a tracked place when `n` is no
/// memory (D17.11). Its steps stand at the end of the steps of `c`. `out` has room for
/// count_owners(t) paths, and the walk writes no more. The walk enters each field of each struct
/// and each element of each fixed array on the way to an inner owner once, and it searches for no
/// owner, so its time is the inner owners times their steps, and the fields of the structs that it
/// enters.
fn put_inner_paths(survey mut* c, u32 n, types.node* t, path mut@ out) void {
    step mut@ own prefix = new(step, depth_to_owners(t));
    defer del(prefix);
    u64 mut at = 0;
    walk_owners(c, n, t, prefix, 0, out, &at);
}

// Writes into `out[*at..]` the path of each inner owner of `t` after the steps `prefix[..depth]`
// (put_inner_paths). A type with no inner owner writes no step into `prefix`, so `prefix` needs
// room for depth_to_owners of the type of the walk only, and the walk enters no field and no
// element that holds no owner.
fn walk_owners(survey mut* c, u32 n, types.node* t, step mut@ prefix, u64 depth, path mut@ out,
               u64 mut* at) void {
    if (*at >= out.len || count_owners(t) == 0) {
        return;
    }
    if (types.type_is_reference(t)) {
        if (t->is_own) {
            path mut p = path{
                .base = fir.base_kind.bk_local,
                .local = n,
                .first = cast(c->steps_len, u32),
                .tracked = !c->locals[cast(n, u64)].memory,
            };
            push_step(c, step{.kind = step_kind.sk_deref});
            u64 mut i = 0;
            while (i < depth) {
                push_step(c, prefix[i]);
                i += 1;
            }
            p.len = cast(depth, u32) + 1;
            out[*at] = p;
            *at += 1;
        }
        return;
    }
    if (!types.type_is_owning_aggregate(t)) {
        return;
    }
    if (t->kind == types.type_kind.k_array) {
        u64 mut i = 0;
        while (i < t->len && *at < out.len) {
            key index = key{key_kind.kk_constant, 0, consts.cv_from_u64(i)};
            prefix[depth] = step{.kind = step_kind.sk_index, .key = index};
            walk_owners(c, n, t->elem, prefix, depth + 1, out, at);
            i += 1;
        }
        return;
    }
    ast.node* decl = fir.struct_decl(t);
    u32 mut field = 0;
    u64 mut i = 0;
    while (i < ast.ast_len(decl) && *at < out.len) {
        ast.node* member = ast.ast_child(decl, i);
        if (member->kind == ast.ast_kind.k_field_decl) {
            prefix[depth] = step{.kind = step_kind.sk_field, .field = field};
            walk_owners(c, n, member->ty, prefix, depth + 1, out, at);
            field += 1;
        }
        i += 1;
    }
}
