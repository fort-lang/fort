/// Writes the error of D17.11 for each overwrite check that owner.prover does not prove: the text
/// and the position of each error (spec/fir.md 11, spec/ownership-design.md 4.1). It also writes
/// the error of part 1 of the leak rule (D17.20) for each exit that owner.prover does not prove,
/// and the line of `--leak-report` for each site of part 2 that it does not prove.
//
// The module holds no module-level mutable state: each buffer belongs to one call.
import fort.ast;
import fort.diag;
import fort.fir;
import fort.fir_print;
import fort.lexer;
import fort.owner.place;
import fort.owner.prover;
import fort.session;
import fort.types;
import std.strbuf;

/// The second note of the first error of a function past prover.WORK_LIMIT (D17.11).
string LIMIT_NOTE = "the function exceeds the work limit of D17.11; split it";

/// The second note of the first error of the leak rule in a function whose leak work passed
/// prover.WORK_LIMIT (D17.20). The leak work has a limit of its own, which the work of D17.11 does
/// not reach, so the note does not name D17.11.
string LEAK_LIMIT_NOTE =
    "the function exceeds the work limit of the leak rule; split it";

// The offset of `line`:`col` in `src`, or the length of `src` past its end.
fn offset(string src, u32 line, u32 col) u64 {
    u64 mut at = 0;
    u32 mut here = 1;
    while (here < line && at < src.len) {
        if (src[at] == '\n') {
            here += 1;
        }
        at += 1;
    }
    u64 c = cast(col, u64);
    if (c == 0 || at + c - 1 > src.len) {
        return src.len;
    }
    return at + c - 1;
}

// Whether `a` starts before `b`.
fn is_before(diag.loc a, diag.loc b) bool {
    return a.line < b.line || (a.line == b.line && a.col < b.col);
}

// The earliest start of a node of the tree `n`, in *first.
fn find_start(ast.node* n, diag.loc mut* first) void {
    if (n == null) {
        return;
    }
    if (n->loc.line > 0 && (first->line == 0 || is_before(n->loc, *first))) {
        *first = n->loc;
    }
    find_start(n->a, first);
    find_start(n->b, first);
    find_start(n->c, first);
    find_start(n->d, first);
    u64 mut i = 0;
    while (i < ast.ast_len(n)) {
        find_start(ast.ast_child(n, i), first);
        i += 1;
    }
}

// The assignment of the tree `n` whose operator stands at `at`, or null.
fn find_assign(ast.node* n, diag.loc at) ast.node* {
    if (n == null) {
        return null;
    }
    if (n->kind == ast.ast_kind.k_assign && n->loc.line == at.line && n->loc.col == at.col) {
        return n;
    }
    ast.node* mut found = find_assign(n->a, at);
    if (found == null) {
        found = find_assign(n->b, at);
    }
    if (found == null) {
        found = find_assign(n->c, at);
    }
    if (found == null) {
        found = find_assign(n->d, at);
    }
    u64 mut i = 0;
    while (found == null && i < ast.ast_len(n)) {
        found = find_assign(ast.ast_child(n, i), at);
        i += 1;
    }
    return found;
}

// Counts `(` less `)` in `text`.
fn paren_depth(string text) i64 {
    i64 mut depth = 0;
    for (char ch : text) {
        if (ch == '(') {
            depth += 1;
        } else if (ch == ')') {
            depth -= 1;
        }
    }
    return depth;
}

// Appends `text` to `out` with each run of white space as one space.
fn append_flat(strbuf.str_buf mut* out, string text) void {
    bool mut space = false;
    u64 mut i = 0;
    while (i < text.len) {
        char ch = text[i];
        if (ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r') {
            space = true;
        } else {
            if (space) {
                strbuf.push(out, ' ');
            }
            space = false;
            strbuf.push(out, ch);
        }
        i += 1;
    }
}

// Appends the source text of the target of the assignment that stands at `at`: the text from the
// first token of the target to the `=`. The parser gives no node for a parenthesis, so the text
// starts at each `(` before the first node that the text needs. False when the source or the
// assignment is not there.
fn write_target(fir.func* f, diag.loc at, session.session mut* s,
                strbuf.str_buf mut* out) bool {
    if (f->sym == null || f->sym->node == null || at.line == 0) {
        return false;
    }
    ast.node* n = find_assign(f->sym->node, at);
    if (n == null) {
        return false;
    }
    diag.loc mut first = diag.loc{};
    find_start(n->a, &first);
    string mut src = "";
    if (first.line == 0 || !session.read_source(s, at.file, &src)) {
        return false;
    }
    u64 mut start = offset(src, first.line, first.col);
    u64 mut end = offset(src, at.line, at.col);
    if (start >= end) {
        return false;
    }
    while (paren_depth(src[start..end]) < 0 && start > 0) {
        u64 mut back = start;
        while (back > 0 && (src[back - 1] == ' ' || src[back - 1] == '\t')) {
            back -= 1;
        }
        if (back == 0 || src[back - 1] != '(') {
            break;
        }
        start = back - 1;
    }
    while (end > start && (src[end - 1] == ' ' || src[end - 1] == '\t' || src[end - 1] == '\n')) {
        end -= 1;
    }
    append_flat(out, src[start..end]);
    return true;
}

// Whether the check or the store at `at` of the place `p` stands for a declaration: `p` is a named
// local, and the item stands at the name of that local.
fn is_declaration(fir.func* f, fir.place p, diag.loc at) bool {
    if (p.base != fir.base_kind.bk_local || p.proj_len != 0) {
        return false;
    }
    fir.local* l = fir.local_at(f, p.local);
    return l->kind == fir.local_kind.lk_named && l->loc.line == at.line && l->loc.col == at.col
        && l->loc.line > 0;
}

/// Appends the text that the diagnostic of the check or the store at `at` of the place `p` names:
/// the declared name for a declaration, the source text of the target for an assignment, and the
/// FIR place when the source is not there.
fn write_place(fir.func* f, fir.place p, diag.loc at, session.session mut* s,
               strbuf.str_buf mut* out) void {
    if (is_declaration(f, p, at)) {
        strbuf.append(out, fir.local_name(fir.local_at(f, p.local)));
        return;
    }
    if (!write_target(f, at, s, out)) {
        fir_print.print_place(f, p, out);
    }
}

// The location of the diagnostic of the check or the store at `at` of the place `p`: the declared
// name, or the `=` of an assignment.
fn site(fir.func* f, fir.place p, diag.loc at) diag.loc {
    if (is_declaration(f, p, at) || at.line == 0) {
        return at;
    }
    return diag.loc_range(at.file, at.line, at.col, at.line, at.col + 1);
}

// Whether `a` and `b` name one position of one file.
fn is_same_loc(diag.loc a, diag.loc b) bool {
    return a.line == b.line && a.col == b.col && a.file == b.file;
}

// Whether a check of the first `blocks` blocks, or one of the first `stores` stores of `p`, that
// `p` does not prove stands at `at`: a deferred store expands into one check and one store at
// each exit, and the lowering puts a check and its store at one location (spec/fir.md 9.3).
fn is_repeated(fir.func* f, prover.proof* p, u32 blocks, u64 stores, diag.loc at) bool {
    u32 mut e = 0;
    while (e < blocks) {
        if (!p->proved[cast(e, u64)] && is_same_loc(fir.block_at(f, e)->term.loc, at)) {
            return true;
        }
        e += 1;
    }
    u64 mut k = 0;
    while (k < stores) {
        prover.store* st = &p->stores[k];
        if (!st->proved && is_same_loc(fir.block_statement(f, st->block, st->index)->loc, at)) {
            return true;
        }
        k += 1;
    }
    return false;
}

// Reports the error of D17.11 and its note at the check or the store at `at` of the place `p`,
// and the note LIMIT_NOTE after them when `limit` holds. `place` and `text` are buffers of the
// caller.
fn write_error(fir.func* f, fir.place p, diag.loc at, bool limit, session.session mut* s,
               strbuf.str_buf mut* place, strbuf.str_buf mut* text) void {
    strbuf.clear(place);
    write_place(f, p, at, s, place);
    diag.loc where = site(f, p, at);
    strbuf.clear(text);
    strbuf.append(text, "overwriting owned value: cannot prove '");
    strbuf.append(text, strbuf.view(place));
    strbuf.append(text, "' is empty here");
    diag.error(session.diags(s), where, strbuf.view(text));
    strbuf.clear(text);
    strbuf.append(text, "del or move '");
    strbuf.append(text, strbuf.view(place));
    strbuf.append(text, "' before this store");
    diag.note(session.diags(s), where, strbuf.view(text));
    if (limit) {
        diag.note(session.diags(s), where, LIMIT_NOTE);
    }
}

/// Reports each check and each store of `f` that `p` does not prove, once for each location: in
/// block order, the stores of a block in statement order and then its check. Each takes the
/// error `overwriting owned value: cannot prove '<place>' is empty here` and the note
/// `del or move '<place>' before this store`, at the declared name or at the `=`. When the work
/// of `f` passed prover.WORK_LIMIT, the first error takes a second note, LIMIT_NOTE (D17.11).
fn write(fir.func* f, prover.proof* p, session.session mut* s) void {
    strbuf.str_buf mut place = strbuf.create();
    defer strbuf.free(&place);
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    bool mut limit_told = false;
    u64 mut k = 0;
    u32 mut b = 0;
    while (b < fir.block_count(f)) {
        while (k < p->stores.len && p->stores[k].block == b) {
            prover.store* st = &p->stores[k];
            fir.statement* sm = fir.block_statement(f, b, st->index);
            if (!st->proved && !is_repeated(f, p, b, k, sm->loc)) {
                write_error(f, sm->place, sm->loc, p->over && !limit_told, s, &place, &text);
                limit_told = true;
            }
            k += 1;
        }
        fir.terminator* t = &fir.block_at(f, b)->term;
        if (!p->proved[cast(b, u64)] && !is_repeated(f, p, b, k, t->loc)) {
            write_error(f, t->place, t->loc, p->over && !limit_told, s, &place, &text);
            limit_told = true;
        }
        b += 1;
    }
}

// ---- the errors of the leak rule ---------------------------------------------------------------

// The node of the tree `n` that starts at `at`, the outermost one first, or null.
fn find_node(ast.node* n, diag.loc at) ast.node* {
    if (n == null) {
        return null;
    }
    if (n->loc.line == at.line && n->loc.col == at.col) {
        return n;
    }
    ast.node* mut found = find_node(n->a, at);
    if (found == null) {
        found = find_node(n->b, at);
    }
    if (found == null) {
        found = find_node(n->c, at);
    }
    if (found == null) {
        found = find_node(n->d, at);
    }
    u64 mut i = 0;
    while (found == null && i < ast.ast_len(n)) {
        found = find_node(ast.ast_child(n, i), at);
        i += 1;
    }
    return found;
}

// Appends the source text of the expression of the tree of `f` that starts at `at`: the text from
// its first token to its last, with each run of white space as one space. False when the source
// or the expression is not there.
fn write_expression(fir.func* f, diag.loc at, session.session mut* s,
                    strbuf.str_buf mut* out) bool {
    if (f->sym == null || f->sym->node == null || at.line == 0) {
        return false;
    }
    ast.node* n = find_node(f->sym->node, at);
    if (n == null) {
        return false;
    }
    diag.loc mut first = diag.loc{};
    find_start(n, &first);
    string mut src = "";
    if (!session.read_source(s, at.file, &src)) {
        return false;
    }
    u64 start = offset(src, first.line, first.col);
    u64 end = offset(src, n->loc.end_line, n->loc.end_col);
    if (start >= end) {
        return false;
    }
    append_flat(out, src[start..end]);
    return true;
}

/// Appends the text that names the owner local `n` of `f` in the leak rule (D17.20): the declared
/// name of a named local or a parameter, and the source text of the expression whose value a
/// temporary holds. A FIR text with no tree gives the FIR place.
fn write_owner(fir.func* f, u32 n, session.session mut* s, strbuf.str_buf mut* out) void {
    fir.local* l = fir.local_at(f, n);
    if (l->kind == fir.local_kind.lk_temp) {
        if (write_expression(f, l->loc, s, out)) {
            return;
        }
    } else if (fir.local_name(l).len > 0) {
        strbuf.append(out, fir.local_name(l));
        return;
    }
    fir_print.print_place(f, fir.place_local(n), out);
}

/// The location of the exit `e` of `f`: its `dead` marker, or the `return` that ends its block.
fn exit_loc(fir.func* f, prover.exit* e) diag.loc {
    if (e->index < fir.block_statement_count(f, e->block)) {
        return fir.block_statement(f, e->block, e->index)->loc;
    }
    return fir.block_at(f, e->block)->term.loc;
}

// Whether an exit before exit `k` of `p` that `p` does not prove names the local of exit `k` at its
// location: a deferred statement expands at each exit with its own location.
fn is_leak_repeated(fir.func* f, prover.proof* p, u64 k) bool {
    prover.exit* e = &p->exits[k];
    diag.loc at = exit_loc(f, e);
    u64 mut j = 0;
    while (j < k) {
        prover.exit* x = &p->exits[j];
        if (!x->proved && x->local == e->local && is_same_loc(exit_loc(f, x), at)) {
            return true;
        }
        j += 1;
    }
    return false;
}

// Reports the error of the leak rule and its note at the exit `e` of `f`, and the note
// LEAK_LIMIT_NOTE after them when `limit` holds. `place` and `text` are buffers of the caller.
fn write_leak(fir.func* f, prover.exit* e, bool limit, session.session mut* s,
              strbuf.str_buf mut* place, strbuf.str_buf mut* text) void {
    strbuf.clear(place);
    write_owner(f, e->local, s, place);
    diag.loc at = exit_loc(f, e);
    strbuf.clear(text);
    strbuf.append(text, "leak: cannot prove '");
    strbuf.append(text, strbuf.view(place));
    strbuf.append(text, "' is empty at this exit");
    diag.error(session.diags(s), at, strbuf.view(text));
    strbuf.clear(text);
    strbuf.append(text, "del or move '");
    strbuf.append(text, strbuf.view(place));
    strbuf.append(text, "' before this exit");
    diag.note(session.diags(s), at, strbuf.view(text));
    if (limit) {
        diag.note(session.diags(s), at, LEAK_LIMIT_NOTE);
    }
}

/// Reports each exit of `f` that `p` does not prove, once for each location and owner local, in
/// the order of the exits. Each takes the error `leak: cannot prove '<place>' is empty at this
/// exit` and the note `del or move '<place>' before this exit`, at the `dead` marker or at the
/// `return` (D17.20). When the leak work of `f` passed prover.WORK_LIMIT, the first error takes a
/// second note, LEAK_LIMIT_NOTE, also when the work of D17.11 passed it too, because the leak work
/// stopped the proof of the exits.
fn write_leaks(fir.func* f, prover.proof* p, session.session mut* s) void {
    strbuf.str_buf mut place = strbuf.create();
    defer strbuf.free(&place);
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    bool mut limit_told = false;
    u64 mut k = 0;
    while (k < p->exits.len) {
        prover.exit* e = &p->exits[k];
        if (!e->proved && !is_leak_repeated(f, p, k)) {
            write_leak(f, e, p->leak_over && !limit_told, s, &place, &text);
            limit_told = true;
        }
        k += 1;
    }
}

// ---- the report of part 2 of the leak rule -----------------------------------------------------

// The `del` or the `cast` of the tree `n` that stands at `at`, or null: a call of `del` whose name
// starts at `at`, where the lowering puts its FIR `del` (spec/fir.md 9.4), or a `cast` that starts
// at `at`, where the lowering puts the statement of the cast.
fn find_release(ast.node* n, diag.loc at) ast.node* {
    if (n == null) {
        return null;
    }
    ast.node* callee = n->a;
    bool del_call = n->kind == ast.ast_kind.k_call && callee != null
        && callee->kind == ast.ast_kind.k_ident && callee->name == "del" && ast.ast_len(n) == 1
        && callee->loc.line == at.line && callee->loc.col == at.col;
    bool cast_node = n->kind == ast.ast_kind.k_cast && n->loc.line == at.line
        && n->loc.col == at.col;
    if (del_call || cast_node) {
        return n;
    }
    ast.node* mut found = find_release(n->a, at);
    if (found == null) {
        found = find_release(n->b, at);
    }
    if (found == null) {
        found = find_release(n->c, at);
    }
    if (found == null) {
        found = find_release(n->d, at);
    }
    u64 mut i = 0;
    while (found == null && i < ast.ast_len(n)) {
        found = find_release(ast.ast_child(n, i), at);
        i += 1;
    }
    return found;
}

// Whether the expression `n` is `move(e)`.
fn is_move(ast.node* n) bool {
    return n->kind == ast.ast_kind.k_call && n->a != null && n->a->kind == ast.ast_kind.k_ident
        && n->a->name == "move" && ast.ast_len(n) == 1;
}

// Whether the source text of the expression `n` stands as one operand before `->`, `[` and after
// `*` with no parenthesis: a name, a call, a `cast`, an index, a field, `new` or `sizeof`.
fn is_postfix(ast.node* n) bool {
    switch (n->kind) {
    case ast.ast_kind.k_ident, ast.ast_kind.k_call, ast.ast_kind.k_cast, ast.ast_kind.k_index,
         ast.ast_kind.k_field, ast.ast_kind.k_arrow, ast.ast_kind.k_new, ast.ast_kind.k_sizeof:
        return true;
    default:
        return false;
    }
}

// Appends the source text of the expression `n`, from its first token to its last, with each run
// of white space as one space. False when the source is not there.
fn write_text(ast.node* n, session.session mut* s, strbuf.str_buf mut* out) bool {
    diag.loc mut first = diag.loc{};
    find_start(n, &first);
    string mut src = "";
    if (first.line == 0 || !session.read_source(s, n->loc.file, &src)) {
        return false;
    }
    u64 start = offset(src, first.line, first.col);
    u64 end = offset(src, n->loc.end_line, n->loc.end_col);
    if (start >= end) {
        return false;
    }
    append_flat(out, src[start..end]);
    return true;
}

// Appends the source text of `p` of the `del(p)` or of the `cast` that stands at `at` in `f`,
// without the `move( )` of a `cast(move(p), T)`, and says in *postfix whether it needs no
// parenthesis (is_postfix). False when the source or the tree is not there.
fn write_released(fir.func* f, diag.loc at, session.session mut* s, strbuf.str_buf mut* out,
                  bool mut* postfix) bool {
    if (f->sym == null || f->sym->node == null || at.line == 0) {
        return false;
    }
    ast.node* n = find_release(f->sym->node, at);
    if (n == null) {
        return false;
    }
    ast.node* mut e = n->a;
    if (n->kind == ast.ast_kind.k_call) {
        e = ast.ast_child(n, 0);
    }
    if (is_move(e)) {
        e = ast.ast_child(e, 0);
    }
    *postfix = is_postfix(e);
    return write_text(e, s, out);
}

// Appends `text`, in a parenthesis unless `postfix`.
fn append_operand(strbuf.str_buf mut* out, string text, bool postfix) void {
    if (!postfix) {
        strbuf.push(out, '(');
    }
    strbuf.append(out, text);
    if (!postfix) {
        strbuf.push(out, ')');
    }
}

// Appends the steps of next_owner_step from the type `t` to its inner owner `k`: `.<name>` for a
// field and `[<index>]` for an element, or with `numbered` `.<number>` for a field, as the FIR
// place names it.
fn append_steps(types.node* t, u64 k, bool numbered, strbuf.str_buf mut* out) void {
    types.node* mut at = t;
    u64 mut left = k;
    place.owner_step mut step = place.owner_step{};
    while (place.next_owner_step(at, left, &step, &left)) {
        if (step.element) {
            strbuf.push(out, '[');
            strbuf.append_u64(out, step.index);
            strbuf.push(out, ']');
        } else if (numbered) {
            strbuf.push(out, '.');
            strbuf.append_u64(out, cast(step.field, u64));
        } else {
            strbuf.push(out, '.');
            strbuf.append(out, step.name);
        }
        at = step.ty;
    }
}

/// Appends the text that names the first inner owner that the obligation `e` of `f` does not prove
/// (D17.20): the source text of `p` and the names of the fields, `p->items` or `p->a.b`, with
/// `(*p)[0]` for an element of an array that `p` points to, and `*p` when the object of `p` is
/// itself the owner. A FIR text with no tree gives the FIR place, `(*_1).0`.
fn write_inner_owner(fir.func* f, prover.inner* e, session.session mut* s,
                     strbuf.str_buf mut* out) void {
    fir.place p = prover.inner_place(f, e);
    types.node* t = fir.place_type(f, p)->elem;
    strbuf.str_buf mut base = strbuf.create();
    defer strbuf.free(&base);
    bool mut postfix = false;
    if (!write_released(f, fir.block_statement(f, e->block, e->index)->loc, s, &base, &postfix)) {
        strbuf.append(out, "(*");
        fir_print.print_place(f, p, out);
        strbuf.push(out, ')');
        append_steps(t, e->first, true, out);
        return;
    }
    place.owner_step mut step = place.owner_step{};
    u64 mut rest = 0;
    if (!place.next_owner_step(t, e->first, &step, &rest)) {
        strbuf.push(out, '*');
        append_operand(out, strbuf.view(&base), postfix);
    } else if (step.element) {
        strbuf.append(out, "(*");
        append_operand(out, strbuf.view(&base), postfix);
        strbuf.append(out, ")[");
        strbuf.append_u64(out, step.index);
        strbuf.push(out, ']');
        append_steps(step.ty, rest, false, out);
    } else {
        append_operand(out, strbuf.view(&base), postfix);
        strbuf.append(out, "->");
        strbuf.append(out, step.name);
        append_steps(step.ty, rest, false, out);
    }
}

// Whether an obligation of part 2 before obligation `k` of `p` that `p` does not prove stands at
// the location of obligation `k`: a deferred `del` expands at each exit with its own location.
fn is_inner_repeated(fir.func* f, prover.proof* p, u64 k) bool {
    diag.loc at = fir.block_statement(f, p->inners[k].block, p->inners[k].index)->loc;
    u64 mut j = 0;
    while (j < k) {
        prover.inner* x = &p->inners[j];
        if (!x->proved && is_same_loc(fir.block_statement(f, x->block, x->index)->loc, at)) {
            return true;
        }
        j += 1;
    }
    return false;
}

// Appends `<file>:<line>:<col>: ` for the position `at`.
fn write_position(diag.loc at, strbuf.str_buf mut* out) void {
    strbuf.append(out, at.file);
    strbuf.push(out, ':');
    strbuf.append_u64(out, cast(at.line, u64));
    strbuf.push(out, ':');
    strbuf.append_u64(out, cast(at.col, u64));
    strbuf.append(out, ": ");
}

/// Appends the lines of `--leak-report` for each site of part 2 of the leak rule of `f` that `p`
/// does not prove, once for each location, in the order of the obligations (D17.20):
/// `<file>:<line>:<col>: leak: cannot prove '<place>' is empty before this del`, or `before this
/// cast`, at the `del` keyword or at the `cast`, and the line of the note `move '<place>' into a
/// local and del it first` at the same position. `<place>` names the first inner owner that the
/// pass does not prove (write_inner_owner). When the inner work of `f` passed prover.WORK_LIMIT, a
/// line of the note LEAK_LIMIT_NOTE follows the first site. Part 2 is no error yet, so the lines go
/// to `out` and not to the diagnostics.
fn write_inners(fir.func* f, prover.proof* p, session.session mut* s, strbuf.str_buf mut* out)
    void {
    strbuf.str_buf mut owner = strbuf.create();
    defer strbuf.free(&owner);
    bool mut limit_told = false;
    u64 mut k = 0;
    while (k < p->inners.len) {
        prover.inner* e = &p->inners[k];
        if (!e->proved && !is_inner_repeated(f, p, k)) {
            fir.statement* st = fir.block_statement(f, e->block, e->index);
            strbuf.clear(&owner);
            write_inner_owner(f, e, s, &owner);
            write_position(st->loc, out);
            strbuf.append(out, "leak: cannot prove '");
            strbuf.append(out, strbuf.view(&owner));
            if (st->kind == fir.stmt_kind.st_del) {
                strbuf.append(out, "' is empty before this del\n");
            } else {
                strbuf.append(out, "' is empty before this cast\n");
            }
            write_position(st->loc, out);
            strbuf.append(out, "note: move '");
            strbuf.append(out, strbuf.view(&owner));
            strbuf.append(out, "' into a local and del it first\n");
            if (p->inner_over && !limit_told) {
                write_position(st->loc, out);
                strbuf.append(out, "note: ");
                strbuf.append(out, LEAK_LIMIT_NOTE);
                strbuf.push(out, '\n');
            }
            limit_told = true;
        }
        k += 1;
    }
}

// ---- the report of rule (b) --------------------------------------------------------------------

/// The note after the first line of rule (b) of a function whose charge passed prover.USE_LIMIT
/// (D17.21). Past it the analysis proves no use, and no note names an operation.
string USE_LIMIT_NOTE = "the function exceeds the work limit of D17.21; split it";

// The name of field `k` of the type `t`: a field of a struct by its declaration index, or `ptr`
// and `len` of a span or a `string`.
fn field_name(types.node* t, u32 k) string {
    if (t->kind != types.type_kind.k_struct) {
        if (k == 0) {
            return "ptr";
        }
        return "len";
    }
    ast.node* decl = fir.struct_decl(t);
    u32 mut field = 0;
    u64 mut i = 0;
    while (i < ast.ast_len(decl)) {
        ast.node* n = ast.ast_child(decl, i);
        if (n->kind == ast.ast_kind.k_field_decl) {
            if (field == k) {
                return n->name;
            }
            field += 1;
        }
        i += 1;
    }
    return "";
}

// Whether the expression `e` names the base of the place `r` of `f`: an identifier of its local or
// of its global, or for a temporary the expression whose value it holds, which starts at the
// location of the temporary.
fn names_base(fir.func* f, ast.node* e, fir.place r) bool {
    if (r.base == fir.base_kind.bk_global) {
        return e->kind == ast.ast_kind.k_ident && cast(e->sym, ast.sym*) == r.global;
    }
    fir.local* l = fir.local_at(f, r.local);
    if (l->kind == fir.local_kind.lk_temp) {
        return l->loc.line > 0 && e->loc.line == l->loc.line && e->loc.col == l->loc.col;
    }
    return e->kind == ast.ast_kind.k_ident && l->sym != null
        && cast(e->sym, ast.sym*) == l->sym;
}

// Whether the expression `e` names the place `r` of `f` with its first `len` projections: the base
// (names_base), then for each projection a `*`, a `.` or a `->` with the name of its field, or an
// index.
fn names_place(fir.func* f, ast.node* e, fir.place r, u32 len) bool {
    if (e == null) {
        return false;
    }
    if (len == 0) {
        return names_base(f, e, r);
    }
    fir.place mut head = r;
    head.proj_len = len - 1;
    fir.projection pj = fir.place_projection(f, r, len - 1);
    switch (pj.kind) {
    case fir.proj_kind.pj_deref:
        return e->kind == ast.ast_kind.k_unary && cast(e->op, lexer.tok_kind) == lexer.tok_kind.star
            && names_place(f, e->a, r, len - 1);
    case fir.proj_kind.pj_field:
        string name = field_name(fir.place_type(f, head), pj.field);
        if (e->kind == ast.ast_kind.k_field && e->name == name) {
            return names_place(f, e->a, r, len - 1);
        }
        bool deref = len >= 2 && fir.place_projection(f, r, len - 2).kind == fir.proj_kind.pj_deref;
        return e->kind == ast.ast_kind.k_arrow && e->name == name && deref
            && names_place(f, e->a, r, len - 2);
    case fir.proj_kind.pj_index:
        return e->kind == ast.ast_kind.k_index && names_place(f, e->a, r, len - 1);
    }
}

// Whether `e` is a call of the builtin `name` with one argument, such as `move(x)`.
fn is_builtin(ast.node* e, string name) bool {
    return e->kind == ast.ast_kind.k_call && e->a != null && e->a->kind == ast.ast_kind.k_ident
        && e->a->name == name && ast.ast_len(e) == 1;
}

// Whether the operand `side` of the expression `e` is no read of its value by rule (b) (D17.21):
// the operand of `&`, of `move` and of `del`, of a comparison with `null`, the target of an
// assignment with `=`, and the operand of a field or an index that loads no pointer of it.
fn is_unread(ast.node* e, ast.node* side) bool {
    switch (e->kind) {
    case ast.ast_kind.k_unary:
        return cast(e->op, lexer.tok_kind) == lexer.tok_kind.amp;
    case ast.ast_kind.k_call:
        return is_builtin(e, "move") || is_builtin(e, "del");
    case ast.ast_kind.k_binary:
        lexer.tok_kind op = cast(e->op, lexer.tok_kind);
        bool compare = op == lexer.tok_kind.eq || op == lexer.tok_kind.ne;
        bool null_test = (e->a != null && e->a->kind == ast.ast_kind.k_null)
            || (e->b != null && e->b->kind == ast.ast_kind.k_null);
        return compare && null_test;
    case ast.ast_kind.k_assign:
        return cast(e->op, lexer.tok_kind) == lexer.tok_kind.assign
            && side == cast(e->a, ast.node*);
    case ast.ast_kind.k_field:
        return true;
    case ast.ast_kind.k_index:
        return side == cast(e->a, ast.node*) && side->ty != null
            && side->ty->kind == types.type_kind.k_array;
    default:
        return false;
    }
}

// The first expression of the tree `n`, in the order of its children, that names the place `r` of
// `f` and whose value an item reads (is_unread), or null. `unread` says that `n` is such an
// operand of its parent.
fn find_read(fir.func* f, ast.node* n, fir.place r, bool unread) ast.node* {
    if (n == null) {
        return null;
    }
    if (!unread && names_place(f, n, r, r.proj_len)) {
        return n;
    }
    ast.node* mut found = find_read(f, n->a, r, is_unread(n, n->a));
    if (found == null) {
        found = find_read(f, n->b, r, is_unread(n, n->b));
    }
    if (found == null) {
        found = find_read(f, n->c, r, is_unread(n, n->c));
    }
    if (found == null) {
        found = find_read(f, n->d, r, is_unread(n, n->d));
    }
    u64 mut i = 0;
    while (found == null && i < ast.ast_len(n)) {
        ast.node* child = ast.ast_child(n, i);
        found = find_read(f, child, r, is_unread(n, child));
        i += 1;
    }
    return found;
}

// The `move` of the tree `n` whose operand names the place `p` of `f`, or null.
fn find_move(fir.func* f, ast.node* n, fir.place p) ast.node* {
    if (n == null) {
        return null;
    }
    if (is_builtin(n, "move") && names_place(f, ast.ast_child(n, 0), p, p.proj_len)) {
        return n;
    }
    ast.node* mut found = find_move(f, n->a, p);
    if (found == null) {
        found = find_move(f, n->b, p);
    }
    if (found == null) {
        found = find_move(f, n->c, p);
    }
    if (found == null) {
        found = find_move(f, n->d, p);
    }
    u64 mut i = 0;
    while (found == null && i < ast.ast_len(n)) {
        found = find_move(f, ast.ast_child(n, i), p);
        i += 1;
    }
    return found;
}

// The `return` of the tree `n` whose value starts at `at`, or with no value the `return` at
// `at`, or null.
fn find_return(ast.node* n, diag.loc at) ast.node* {
    if (n == null) {
        return null;
    }
    if (n->kind == ast.ast_kind.k_return) {
        bool value = n->a != null && n->a->loc.line == at.line && n->a->loc.col == at.col;
        bool keyword = n->loc.line == at.line && n->loc.col == at.col;
        if (value || keyword) {
            return n;
        }
    }
    ast.node* mut found = find_return(n->a, at);
    if (found == null) {
        found = find_return(n->b, at);
    }
    if (found == null) {
        found = find_return(n->c, at);
    }
    if (found == null) {
        found = find_return(n->d, at);
    }
    u64 mut i = 0;
    while (found == null && i < ast.ast_len(n)) {
        found = find_return(ast.ast_child(n, i), at);
        i += 1;
    }
    return found;
}

// The tree of `f`, or null for FIR text with no source.
fn tree_of(fir.func* f) ast.node* {
    if (f->sym == null) {
        return null;
    }
    return f->sym->node;
}

// The location of item `index` of block `b` of `f`: a statement, or the terminator when `index` is
// the count of the statements.
fn item_loc(fir.func* f, u32 b, u32 index) diag.loc {
    if (index < fir.block_statement_count(f, b)) {
        return fir.block_statement(f, b, index)->loc;
    }
    return fir.block_at(f, b)->term.loc;
}

// The expression of the use `u` of `f`: the expression of the tree of its item that names its
// read and whose value the item reads (find_read), or null.
fn use_node(fir.func* f, prover.use* u) ast.node* {
    ast.node* tree = tree_of(f);
    diag.loc at = item_loc(f, u->block, u->index);
    if (tree == null || at.line == 0) {
        return null;
    }
    return find_read(f, find_node(tree, at), u->read, false);
}

// Appends the text of the whole local `n` of `f` as rule (b) names it at the item at `at`: the
// declared name of a named local or a parameter, the source text of the expression of a temporary,
// and for `_0` the source text of the value of the `return` at `at`, or else the name of the
// function and `()`, the call whose value `_0` holds. *postfix says whether the text needs no
// parenthesis before a field. False for FIR text with no tree.
fn write_local(fir.func* f, u32 n, diag.loc at, session.session mut* s, strbuf.str_buf mut* out,
               bool mut* postfix) bool {
    fir.local* l = fir.local_at(f, n);
    *postfix = true;
    if (l->kind == fir.local_kind.lk_named || l->kind == fir.local_kind.lk_param) {
        if (fir.local_name(l).len > 0) {
            strbuf.append(out, fir.local_name(l));
            return true;
        }
    }
    ast.node* mut e = null;
    if (l->kind == fir.local_kind.lk_temp && tree_of(f) != null && l->loc.line > 0) {
        e = find_node(tree_of(f), l->loc);
    } else if (l->kind == fir.local_kind.lk_return && tree_of(f) != null) {
        ast.node* ret = find_return(tree_of(f), at);
        if (ret == null || ret->a == null) {
            strbuf.append(out, f->sym->name);
            strbuf.append(out, "()");
            return true;
        }
        e = ret->a;
    }
    if (e != null) {
        *postfix = is_postfix(e);
        return write_text(e, s, out);
    }
    return false;
}

/// Appends the text that the use `u` of `f` names (D17.21): the source text of the base of the
/// use, its read or its whole local, then the steps of next_owner_step from the type of the base
/// to the owner of the use: `.<field>` and `[<index>]`. FIR text with no tree gives the FIR place
/// of the base and `.<field number>`.
fn write_use_place(fir.func* f, prover.use* u, session.session mut* s, strbuf.str_buf mut* out)
    void {
    types.node* t = fir.place_type(f, u->base);
    diag.loc at = item_loc(f, u->block, u->index);
    strbuf.str_buf mut base = strbuf.create();
    defer strbuf.free(&base);
    bool mut postfix = true;
    bool mut written = false;
    types.node* mut ty = t;
    u64 mut owner = u->owner;
    if (u->base.proj_len == 0 && u->base.base == fir.base_kind.bk_local) {
        written = write_local(f, u->base.local, at, s, &base, &postfix);
    } else {
        ast.node* e = use_node(f, u);
        if (e != null) {
            postfix = is_postfix(e);
            written = write_text(e, s, &base);
        } else if (u->local_owner != prover.NO_RANK) {
            // a read that the lowering made, such as the element of a `for` over a fixed array,
            // has no source text: the use names the owner in the type of its local
            ty = fir.local_at(f, u->local)->ty;
            owner = u->local_owner;
            written = write_local(f, u->local, at, s, &base, &postfix);
        }
    }
    if (!written) {
        fir_print.print_place(f, u->base, out);
        append_steps(t, u->owner, true, out);
        return;
    }
    place.owner_step mut step = place.owner_step{};
    u64 mut rest = 0;
    if (place.next_owner_step(ty, owner, &step, &rest)) {
        append_operand(out, strbuf.view(&base), postfix);
    } else {
        strbuf.append(out, strbuf.view(&base));
    }
    append_steps(ty, owner, false, out);
}

// The location of the error of the use `u` of `f`: the first token of the expression whose read
// is the use, or the location of its item.
fn use_loc(fir.func* f, prover.use* u) diag.loc {
    ast.node* e = use_node(f, u);
    diag.loc mut first = diag.loc{};
    find_start(e, &first);
    if (first.line == 0) {
        return item_loc(f, u->block, u->index);
    }
    return first;
}

// The location of the note of the use `u` of `f`: the `del`, the `move` or the first token of the
// call of its operation, or the `return` of an implicit `move` of `return x`.
fn op_loc(fir.func* f, prover.use* u) diag.loc {
    fir.statement* st = fir.block_statement(f, u->op_block, u->op_index);
    ast.node* tree = tree_of(f);
    if (u->op_kind == prover.operation_kind.op_del || tree == null || st->loc.line == 0) {
        return st->loc;
    }
    if (u->op_kind == prover.operation_kind.op_call) {
        diag.loc mut first = diag.loc{};
        find_start(find_node(tree, st->loc), &first);
        if (first.line == 0) {
            return st->loc;
        }
        return first;
    }
    ast.node* m = find_move(f, find_node(tree, st->loc), u->op_place);
    if (m != null) {
        return m->a->loc;
    }
    bool result = st->kind == fir.stmt_kind.st_assign && place.is_local(st->place)
        && st->place.local == 0;
    ast.node* ret = find_return(tree, st->loc);
    if (result && ret != null) {
        return ret->loc;
    }
    return st->loc;
}

// Whether a use before use `k` of `p` that `p` does not prove names the local of use `k` at its
// location: a deferred statement expands at each exit with its own location. `locs[j]` is the
// location of the unproved use `j` (use_loc), so no tree is walked again.
fn is_use_repeated(prover.proof* p, diag.loc@ locs, u64 k) bool {
    u64 mut j = 0;
    while (j < k) {
        prover.use* x = &p->uses[j];
        if (!x->proved && x->local == p->uses[k].local && is_same_loc(locs[j], locs[k])) {
            return true;
        }
        j += 1;
    }
    return false;
}

/// Appends the lines of the report of rule (b) for each use of `f` that `p` does not prove, once
/// for each location and local, in the order of the uses (D17.21): `<file>:<line>:<col>: use after
/// move or del: '<place>' can be vacated here` at the expression whose read is the use, and the
/// line of the note `'<place>' is moved here`, `is deleted here` or `can change in this call` at
/// its operation. Past prover.USE_LIMIT no note names an operation, and a line of the note
/// USE_LIMIT_NOTE follows the first use. Rule (b) is no error yet, so the lines go to `out`.
fn write_uses(fir.func* f, prover.proof* p, session.session mut* s, strbuf.str_buf mut* out)
    void {
    strbuf.str_buf mut owner = strbuf.create();
    defer strbuf.free(&owner);
    diag.loc mut@ own locs = new(diag.loc, p->uses.len);
    defer del(locs);
    bool mut limit_told = false;
    u64 mut k = 0;
    while (k < p->uses.len) {
        prover.use* u = &p->uses[k];
        if (!u->proved) {
            locs[k] = use_loc(f, u);
        }
        diag.loc at = locs[k];
        if (!u->proved && !is_use_repeated(p, locs, k)) {
            strbuf.clear(&owner);
            write_use_place(f, u, s, &owner);
            write_position(at, out);
            strbuf.append(out, "use after move or del: '");
            strbuf.append(out, strbuf.view(&owner));
            strbuf.append(out, "' can be vacated here\n");
            if (u->op_kind != prover.operation_kind.op_none) {
                write_position(op_loc(f, u), out);
                strbuf.append(out, "note: '");
                strbuf.append(out, strbuf.view(&owner));
                if (u->op_kind == prover.operation_kind.op_move) {
                    strbuf.append(out, "' is moved here\n");
                } else if (u->op_kind == prover.operation_kind.op_del) {
                    strbuf.append(out, "' is deleted here\n");
                } else {
                    strbuf.append(out, "' can change in this call\n");
                }
            }
            if (p->use_over && !limit_told) {
                write_position(at, out);
                strbuf.append(out, "note: ");
                strbuf.append(out, USE_LIMIT_NOTE);
                strbuf.push(out, '\n');
            }
            limit_told = true;
        }
        k += 1;
    }
}
