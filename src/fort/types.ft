// types: the type representation of the self-hosted compiler
// (type-system.md, D3, D5, D17), the transliteration of src/bootstrap/types.h
// and .c: the type node, interning, identity (D3.12, D17.1), the implicit
// conversions (D5.4, D17.4), the cast matrix (D3.14), sizes and C/System V
// layout (D3.1, D3.15, D9.9), the canonical spelling of a type, and a builder
// that applies the suffix-reading rules of D3.6 to a list of suffix
// descriptors.
//
// Level model (D5.2). A type is a chain of storage levels: level 0 is the
// binding's own storage and lives outside the type (the `mut0` of the
// declaration, which the caller holds); every pointer or span node carries the
// mutability of the storage it reaches (`is_mut`, the next level) and whether
// the reference it represents is owned (`is_own`, D17.2). Fixed arrays add no
// level. `string` and `void*` have no target level, so their `is_mut` is
// always false.
//
// A written type marks each of those storages once, in the position that
// follows the type element occupying it (D5.3): after the base type for the
// values of that type, after a `*` or `@` for the reference that suffix
// introduces, after a fixed-array suffix for the array, whose elements share
// its storage. The last position is the binding, so the pointer node of
// `node mut* p` has `is_mut` set (the node is writable) while `node* mut p`
// has a plain pointer node and `mut0` set.
//
// Nodes are interned per table: two structurally equal types built through one
// table are one node, so pointer equality is type identity for every kind
// except struct and enum, whose identity is their declaration. The table is a
// vector and interning scans it, which is what a compilation of this size
// needs; a map can replace the scan without changing this interface.
//
// Ownership (D17). The table owns every node: `nodes` is an owned span of
// owned node pointers, so freeing the table frees them, and every node handed
// out is a view valid until then (D17.3). A node owns its parameter list and
// its layout block, which table_free releases before the node itself, since
// `del` is shallow (D17.7).
//
// Names: the functions keep the `type_` of their C originals, so that a reader
// holds the two files against each other name by name; `types.type_ptr` reads
// as a stutter and says exactly which C function it is. The enum members are
// the C constants with a short prefix instead (`k_ptr` for `TYPE_PTR`),
// because the C names are the constructors' names and a reader would have to
// tell `type_ptr` from `type_kind.type_ptr` on sight. Three fields and two
// parameters are renamed because the C names are keywords (D2.4): `mut`,
// `own` and `noreturn` become `is_mut`, `is_own` and `is_noreturn`, and the
// `type` of a build result is `built`, `type` being reserved.
//
// Re-entrancy (D20.5): the table is a value the caller owns and frees, not a
// module-level cache, so two analyses in one process are two tables and share
// nothing; every node of an analysis dies with its table. Nothing here ends
// the process: an impossible input -- a `void` element type, a layout asked
// for twice, a size the checker never checked -- is a panic at the call that
// broke the precondition (D13.3) where src/bootstrap/types.c calls
// fatal_internal. A panic aborts like any other failure (D11.4), so what it
// buys is a documented boundary, not in-process recovery.
//
// Dispatch: none. The case analysis is the switches the C wrote, over the kind
// enum, and no table of function pointers (D3.10).
import prim;
import std::strbuf;

// Sizes fixed by D3.1 and D3.15 (D1.4: a module constant is UPPER_CASE).
u64 PTR_SIZE = 8;
u64 PTR_ALIGN = 8;
u64 SPAN_SIZE = 16;
u64 ENUM_SIZE = 4;

// The largest object the compiler admits, 2^63 - 1 bytes: a type whose size
// would exceed it is "type is too large" at the declaration that introduces it
// (D3.4).
u64 TYPE_MAX_SIZE = 9223372036854775807;

// The most nodes one spelled chain walks; a deeper chain continues in
// parentheses.
u64 SPINE_MAX = 64;

// The first non-zero capacity of the node vector; growth doubles from there.
u64 NODE_MIN_CAP = 16;

// The largest u64 there is, which the capacity guard holds its arithmetic
// against.
u64 U64_MAX = 18446744073709551615;

// What a type is. The members are the C's TYPE_* constants under a short
// prefix, since `type_ptr` and the rest name the constructors below.
enum type_kind {
    k_void,    // `void`: a return type or the base of `void*`
    k_prim,    // a primitive (prim.ft)
    k_ptr,     // `T*`, `T* own`, `T mut*`
    k_voidptr, // `void*`, `void* own` (D3.11)
    k_fn,      // `fn R(P1, P2)` (D3.10)
    k_array,   // `T[N]` (D3.4)
    k_span,    // `T@`, `T@ own`, `T mut@` (D3.5)
    k_string,  // `string`, `string own` (D3.7)
    k_struct,  // nominal (D3.8)
    k_enum,    // nominal, underlying i32 (D3.9)
    k_null,    // the type of the literal `null` before it adopts one (D10.5)
    k_error,   // poison: the type of an expression that already failed
}

// The state of a struct's layout (D3.8); the C's LAYOUT_* constants.
enum layout_state {
    l_unresolved,
    l_resolving, // on the resolution path: reaching it again is a cycle
    l_resolved,
    l_error, // infinite size; sizeof yields 0 and alignof 1
}

// What a laid-out struct knows about itself.
struct layout {
    layout_state state;
    u64 size;
    u64 align;
    bool owning; // a field is an `own` reference or an owning aggregate (D17.7)
}

// One type. Every field a kind does not use holds its zero value, as the C's
// fat struct does: no unions and no anonymous members, so a reader sees every
// field in the open.
struct node {
    type_kind kind;
    prim.prim_kind prim; // k_prim
    bool is_mut;         // k_ptr, k_span: the storage reached is mutable
    bool is_own;         // k_ptr, k_voidptr, k_span, k_string
    bool is_noreturn;    // k_fn: `fn noreturn(...)`, with elem void
    node* elem;          // pointee, element or return type
    u64 len;             // k_array
    // k_fn: the parameter types, owned by the node. The C carries a count
    // beside the pointer; a span carries its own length, so `params.len` is
    // the C's `nparams` everywhere.
    node* mut@ own params;
    string name;            // k_struct, k_enum: the spelling in diagnostics
    void* decl;             // k_struct, k_enum: the declaring symbol, opaque
    layout mut* own layout; // k_struct, owned by the node; null otherwise
}

// The interning key: the fields that decide whether a node already exists.
// src/bootstrap/types.c uses a type_t for this and lets its `params` borrow
// the caller's list; a fort node owns its parameter list, so the key is a
// struct of its own whose `params` is a borrowed span (D17.4) and which is
// therefore not an owning aggregate and copies freely.
struct key {
    type_kind kind;
    prim.prim_kind prim;
    bool is_mut;
    bool is_own;
    bool is_noreturn;
    node* elem;
    u64 len;
    node*@ params;
}

// Owns every node it hands out. table{} is a valid empty table, so a struct
// holding one is initialized with {}.
struct table {
    // The nodes, in creation order: an owned span of owned nodes, entries
    // assignable (D17.2). `count` is the slots in use and `nodes.len` the
    // capacity.
    node mut* own mut@ own nodes;
    u64 count;
    node* void_type;
    node* null_type;
    node* error_type;
    // One slot per primitive kind, sized by the constant the kinds are
    // counted by, as the C sizes it with PRIM_COUNT: a kind added to the enum
    // then widens this array from one edit rather than from two.
    node*[prim.PRIM_COUNT] prims;
}

// ---- table and interning -------------------------------------------------------

// Zeroes the table, as src/bootstrap/types.c's init does over raw storage.
// `table{}` is the same value, so a caller that declares its table needs no
// call at all; a call on a table that already holds nodes drops them, which is
// the leak the C has there too (D17.11 does not check an owning aggregate's
// assignment field by field).
fn void type_table_init(table mut* tt) {
    *tt = table{};
}

// Releases every node; the table is empty and usable afterwards. A node owns
// its parameter list and its layout block, and `del` is shallow (D17.7), so
// both go before the node does.
fn void type_table_free(table mut* tt) {
    u64 mut i = 0;
    while (i < tt->count) {
        node mut* own t = move(tt->nodes[i]);
        del(t->params);
        del(t->layout);
        del(t);
        i += 1;
    }
    del(tt->nodes);
    tt->count = 0;
    tt->void_type = null;
    tt->null_type = null;
    tt->error_type = null;
    u64 mut k = 0;
    while (k < prim.PRIM_COUNT) {
        tt->prims[k] = null;
        k += 1;
    }
}

// Ensures room for one more node, growing to the largest of NODE_MIN_CAP and
// twice the capacity.
fn void reserve(table mut* tt) {
    if (tt->count < tt->nodes.len) {
        return;
    }
    u64 mut cap = NODE_MIN_CAP;
    if (tt->nodes.len >= cap) {
        // A node is more than one byte, so a capacity can never reach half the
        // address space; the doubling is guarded all the same, since nothing
        // here may detect an overflow by performing one (D11.1).
        if (tt->nodes.len > U64_MAX / 2) {
            panic("types.reserve: capacity overflow");
        }
        cap = tt->nodes.len * 2;
    }
    node mut* own mut@ own bigger = new(node* own, cap);
    u64 mut i = 0;
    while (i < tt->count) {
        bigger[i] = move(tt->nodes[i]);
        i += 1;
    }
    del(tt->nodes);
    tt->nodes = move(bigger);
}

// A fresh node of `kind`, owned by the table and returned as a view of it.
fn node mut* node_new(table mut* tt, type_kind kind) {
    node mut* own fresh = new(node);
    fresh->kind = kind;
    reserve(tt);
    tt->nodes[tt->count] = move(fresh);
    tt->count += 1;
    return tt->nodes[tt->count - 1];
}

// Structural equality of an interned node and a key by child identity:
// children are interned, so pointer equality of children is enough. Nominal
// nodes are never interned, so they never match.
fn bool node_same(node* t, key* k) {
    if (t->kind != k->kind) {
        return false;
    }
    if (t->kind == type_kind.k_struct || t->kind == type_kind.k_enum) {
        return false;
    }
    if (t->prim != k->prim || t->is_mut != k->is_mut || t->is_own != k->is_own ||
        t->is_noreturn != k->is_noreturn || t->elem != k->elem || t->len != k->len ||
        t->params.len != k->params.len) {
        return false;
    }
    u64 mut i = 0;
    while (i < t->params.len) {
        node* left = t->params[i];
        if (left != k->params[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

// The interned node equal to `k`, or a fresh copy of it.
fn node* intern(table mut* tt, key* k) {
    u64 mut i = 0;
    while (i < tt->count) {
        node* t = tt->nodes[i];
        if (node_same(t, k)) {
            return t;
        }
        i += 1;
    }
    node mut* t = node_new(tt, k->kind);
    t->prim = k->prim;
    t->is_mut = k->is_mut;
    t->is_own = k->is_own;
    t->is_noreturn = k->is_noreturn;
    t->elem = k->elem;
    t->len = k->len;
    if (k->params.len > 0) {
        // `new` gives every level of its result `mut` (D5.8), and the stored
        // list borrows its elements, so the cast drops the mutability of the
        // pointees: no implicit conversion may do that behind a mutable span
        // (D5.4's `T** -> const T**` hole), and a cast is the sanctioned
        // escape (D3.14).
        node* mut@ own params = cast(new(node*, k->params.len), node* mut@ own);
        u64 mut j = 0;
        while (j < k->params.len) {
            params[j] = k->params[j];
            j += 1;
        }
        t->params = move(params);
    }
    return t;
}

// A zeroed key of `kind`: the fields a constructor does not set keep the values
// of a node that never carries them.
fn key key_of(type_kind kind) {
    key mut k = key{};
    k.kind = kind;
    k.prim = prim.prim_kind.prim_i8;
    return k;
}

// ---- constructors --------------------------------------------------------------
// Every constructor interns: equal arguments give the same node. An elem or
// parameter of kind k_error poisons the result, which is the error type.

fn node* type_void(table mut* tt) {
    if (tt->void_type == null) {
        tt->void_type = node_new(tt, type_kind.k_void);
    }
    return tt->void_type;
}

fn node* type_null(table mut* tt) {
    if (tt->null_type == null) {
        tt->null_type = node_new(tt, type_kind.k_null);
    }
    return tt->null_type;
}

fn node* type_error(table mut* tt) {
    if (tt->error_type == null) {
        tt->error_type = node_new(tt, type_kind.k_error);
    }
    return tt->error_type;
}

// `k` must not be prim_void: `void` is a type kind of its own (type_void).
fn node* type_prim(table mut* tt, prim.prim_kind k) {
    if (k == prim.prim_kind.prim_void) {
        panic("types.type_prim: prim_void as a primitive type: use type_void");
    }
    u64 slot = cast(k, u64);
    if (tt->prims[slot] == null) {
        node mut* t = node_new(tt, type_kind.k_prim);
        t->prim = k;
        tt->prims[slot] = t;
    }
    return tt->prims[slot];
}

fn node* type_string(table mut* tt, bool is_own) {
    key mut k = key_of(type_kind.k_string);
    k.is_own = is_own;
    return intern(tt, &k);
}

fn node* type_voidptr(table mut* tt, bool is_own) {
    key mut k = key_of(type_kind.k_voidptr);
    k.elem = type_void(tt);
    k.is_own = is_own;
    return intern(tt, &k);
}

// The element checks shared by pointers, spans and arrays; true when the
// result is the poisoned error type.
fn bool elem_poisons(node* elem) {
    if (elem->kind == type_kind.k_void) {
        panic("types: void as an element type");
    }
    if (elem->kind == type_kind.k_null) {
        panic("types: null as an element type");
    }
    return elem->kind == type_kind.k_error;
}

// `elem` must not be void (use type_voidptr) or the null type.
fn node* type_ptr(table mut* tt, node* elem, bool is_own, bool is_mut) {
    if (elem_poisons(elem)) {
        return elem;
    }
    key mut k = key_of(type_kind.k_ptr);
    k.elem = elem;
    k.is_own = is_own;
    k.is_mut = is_mut;
    return intern(tt, &k);
}

fn node* type_span(table mut* tt, node* elem, bool is_own, bool is_mut) {
    if (elem_poisons(elem)) {
        return elem;
    }
    key mut k = key_of(type_kind.k_span);
    k.elem = elem;
    k.is_own = is_own;
    k.is_mut = is_mut;
    return intern(tt, &k);
}

// `len` must be greater than 0 (D3.4); `elem` must not be void or null.
fn node* type_array(table mut* tt, node* elem, u64 len) {
    if (elem_poisons(elem)) {
        return elem;
    }
    if (len == 0) {
        panic("types.type_array: array length 0");
    }
    key mut k = key_of(type_kind.k_array);
    k.elem = elem;
    k.len = len;
    return intern(tt, &k);
}

// `ret` is void for a `noreturn` function. The parameter list is copied.
fn node* type_fn(table mut* tt, node* ret, node*@ params, bool is_noreturn) {
    if (ret->kind == type_kind.k_null) {
        panic("types.type_fn: null as a return type");
    }
    if (is_noreturn && ret->kind != type_kind.k_void) {
        panic("types.type_fn: noreturn with a return type");
    }
    if (ret->kind == type_kind.k_error) {
        return ret;
    }
    u64 mut i = 0;
    while (i < params.len) {
        if (params[i]->kind == type_kind.k_error) {
            return params[i];
        }
        if (params[i]->kind == type_kind.k_void || params[i]->kind == type_kind.k_null) {
            panic("types.type_fn: void or null as a parameter type");
        }
        i += 1;
    }
    key mut k = key_of(type_kind.k_fn);
    k.elem = ret;
    k.params = params;
    k.is_noreturn = is_noreturn;
    return intern(tt, &k);
}

// A nominal type is one node per declaration, since its identity is its
// declaration (D3.12): a second call with the same `decl` gives the node the
// first one made, so no two nodes of one struct can split the types built from
// it. A null `decl` is anonymous and always makes a node.
fn node* nominal(table mut* tt, type_kind kind, string name, void* decl) {
    if (decl != null) {
        u64 mut i = 0;
        while (i < tt->count) {
            node* t = tt->nodes[i];
            if (t->decl == decl) {
                if (t->kind != kind) {
                    panic("types: one declaration used for a struct and an enum");
                }
                return t;
            }
            i += 1;
        }
    }
    node mut* t = node_new(tt, kind);
    t->name = name;
    t->decl = decl;
    if (kind == type_kind.k_struct) {
        t->layout = new(layout);
        t->layout->state = layout_state.l_unresolved;
        t->layout->align = 1;
    }
    return t;
}

// Nominal types: every call makes a new node with an unresolved layout. `name`
// is borrowed for the life of the table; `decl` is stored and otherwise
// opaque.
fn node* type_struct(table mut* tt, string name, void* decl) {
    return nominal(tt, type_kind.k_struct, name, decl);
}

fn node* type_enum(table mut* tt, string name, void* decl) {
    return nominal(tt, type_kind.k_enum, name, decl);
}

// ---- queries -------------------------------------------------------------------

// A pointer, `void*`, span or string: the kinds that may be `own` (D17.1).
fn bool type_is_reference(node* t) {
    return t->kind == type_kind.k_ptr || t->kind == type_kind.k_voidptr ||
           t->kind == type_kind.k_span || t->kind == type_kind.k_string;
}

fn bool type_is_int(node* t) {
    return t->kind == type_kind.k_prim && prim.prim_is_integer(t->prim);
}

fn bool type_is_float(node* t) {
    return t->kind == type_kind.k_prim && prim.prim_is_float(t->prim);
}

// Integer, float, bool, char, enum.
fn bool type_is_scalar(node* t) {
    return t->kind == type_kind.k_prim || t->kind == type_kind.k_enum;
}

// Skips the fixed arrays around a type: the node whose storage the arrays'
// elements share (D5.2).
fn node* behind_arrays(node* t) {
    node* mut cur = t;
    while (cur->kind == type_kind.k_array) {
        cur = cur->elem;
    }
    return cur;
}

// A reference that reaches a level: a pointer or a span, not `void*` or a
// string, which have no target level (D5.2).
fn bool has_target_level(node* t) {
    return t->kind == type_kind.k_ptr || t->kind == type_kind.k_span;
}

// The storage levels behind level 0 (D5.2): one per pointer or span node on
// the chain, fixed arrays adding none; `string` and `void*` add none. The C
// counts in a uint32_t; every count here is a u64, since a span's `.len` is
// one and fort promotes nothing (D6.2).
fn u64 type_levels(node* t) {
    u64 mut n = 0;
    node* mut cur = behind_arrays(t);
    while (has_target_level(cur)) {
        n += 1;
        cur = behind_arrays(cur->elem);
    }
    return n;
}

// The reference stored at level k - 1 and reaching level k, for k >= 1: the
// outermost pointer, `void*`, span or string of `t` (behind any fixed arrays)
// for k == 1, then inward; null beyond the chain. Its `is_mut` is the
// mutability of level k and its `is_own` the ownership mark of that reference
// (D17.2). A `string` or `void*` node is reported, since it carries an `own`
// mark, although it adds no level.
fn node* type_ref_at(node* t, u64 k) {
    if (k == 0) {
        panic("types.type_ref_at: level 0 is not a reference");
    }
    node* mut cur = behind_arrays(t);
    u64 mut left = k;
    while (type_is_reference(cur)) {
        if (left == 1) {
            return cur;
        }
        if (cur->elem == null) {
            return null;
        }
        cur = behind_arrays(cur->elem);
        left -= 1;
    }
    return null;
}

// The mutability of level k >= 1: false beyond the chain and for the
// characters of a string.
fn bool type_level_mut(node* t, u64 k) {
    node* r = type_ref_at(t, k);
    return r != null && r->is_mut;
}

// Whether a struct or fixed array contains an `own` reference by value,
// directly or through nested aggregates (D17.7). A struct answers from its
// layout, so it must be resolved; a struct in error answers false.
fn bool type_is_owning_aggregate(node* t) {
    if (t->kind == type_kind.k_array) {
        node* e = t->elem;
        return (type_is_reference(e) && e->is_own) || type_is_owning_aggregate(e);
    }
    if (t->kind != type_kind.k_struct) {
        return false;
    }
    if (t->layout->state == layout_state.l_error) {
        return false;
    }
    if (t->layout->state != layout_state.l_resolved) {
        panic("types.type_is_owning_aggregate: owning query on a struct without layout");
    }
    return t->layout->owning;
}

// ---- identity ------------------------------------------------------------------

// The identity of D3.12; with `bits` false the `mut` and `own` marks of the
// reference chain are ignored and only its shape is compared. A function type
// is compared whole either way: the marks of its parameters and result are
// part of its identity, not of the chain that reaches it (D3.10).
fn bool same(node* a, node* b, bool bits) {
    if (a == b) {
        return true;
    }
    if (a->kind != b->kind) {
        return false;
    }
    switch (a->kind) {
    case type_kind.k_void, type_kind.k_null, type_kind.k_error:
        return true;
    case type_kind.k_prim:
        return a->prim == b->prim;
    case type_kind.k_string, type_kind.k_voidptr:
        return !bits || a->is_own == b->is_own;
    case type_kind.k_ptr, type_kind.k_span:
        return (!bits || (a->is_own == b->is_own && a->is_mut == b->is_mut)) &&
               same(a->elem, b->elem, bits);
    case type_kind.k_array:
        return a->len == b->len && same(a->elem, b->elem, bits);
    case type_kind.k_fn:
        // Structural over the parameter types, the result and `noreturn`, with
        // every mark included: `fn void(node mut*)` and `fn void(node*)` are
        // two types (D3.10).
        if (a->is_noreturn != b->is_noreturn || a->params.len != b->params.len ||
            !same(a->elem, b->elem, true)) {
            return false;
        }
        u64 mut i = 0;
        while (i < a->params.len) {
            node* left = a->params[i];
            node* right = b->params[i];
            if (!same(left, right, true)) {
                return false;
            }
            i += 1;
        }
        return true;
    case type_kind.k_struct, type_kind.k_enum:
        return a->decl != null && a->decl == b->decl;
    }
    panic("types.same: unknown type kind");
}

// Identity (D3.12, D17.1): nominal for struct and enum, structural otherwise,
// with the `mut` and `own` bits of every level.
fn bool type_equal(node* a, node* b) {
    return same(a, b, true);
}

// Whether the equality of type_equal holds when the `mut` and `own` bits of
// the reference chain are ignored: the shape of the two types is the same.
fn bool type_same_shape(node* a, node* b) {
    return same(a, b, false);
}

// ---- implicit conversions (D5.4, D17.4) ----------------------------------------

// Whether `src` converts to `dst` at a chain position where every level
// between the binding and this reference is immutable in `dst` when
// `prefix_immutable`, and some reference outside it is `own` in `dst` when
// `outer_own`.
fn bool convertible(node* dst, node* src, bool prefix_immutable, bool outer_own) {
    if (dst == src) {
        return true;
    }
    if (dst->kind != src->kind) {
        return false;
    }
    switch (dst->kind) {
    case type_kind.k_void, type_kind.k_null, type_kind.k_error:
        return true;
    case type_kind.k_prim:
        // No integer widening, no signedness change, no integer to float: the
        // only implicit conversions drop marks (D3.14, D5.4).
        return dst->prim == src->prim;
    case type_kind.k_struct, type_kind.k_enum, type_kind.k_fn:
        // Nominal, and no variance for function types (D3.10): identity.
        return type_equal(dst, src);
    case type_kind.k_array:
        // Arrays add no level (D5.2).
        return dst->len == src->len &&
               convertible(dst->elem, src->elem, prefix_immutable, outer_own);
    case type_kind.k_string, type_kind.k_voidptr, type_kind.k_ptr, type_kind.k_span:
        break;
    }
    if (dst->is_mut && !src->is_mut) {
        // Adding mutability at any level needs a cast (D3.14, D5.4).
        return false;
    }
    if (src->is_mut && !dst->is_mut && !prefix_immutable) {
        // Mutability drops at level k only when levels 1 to k - 1 are
        // immutable in the target: the C `T** -> const T**` hole (D5.4).
        return false;
    }
    if (dst->is_own && !src->is_own) {
        // Adding `own` is adoption and needs a cast (D17.3, D17.4).
        return false;
    }
    if (src->is_own && !dst->is_own && (!prefix_immutable || outer_own)) {
        // `own` drops only behind immutable levels and only when no reference
        // outside it keeps `own`, which would leave the inner objects owned by
        // nobody (D17.4).
        return false;
    }
    if (dst->elem == null) {
        // A `string` has no level behind it: its characters are never mutable
        // and carry no mark (D3.7, D5.2).
        return true;
    }
    return convertible(dst->elem, src->elem, prefix_immutable && !dst->is_mut,
                       outer_own || dst->is_own);
}

// Whether a value of type `src` may be used where `dst` is expected (D5.4,
// D17.4): identity, the null literal for a pointer, `void*` or function type,
// and the two monotone drops. An error type on either side is accepted; a
// `void` or `null` type as the destination, and `void` as the source, are
// refused (no value has those types).
fn bool type_assignable(node* dst, node* src) {
    if (dst->kind == type_kind.k_error || src->kind == type_kind.k_error) {
        // A poisoned type converts either way, so one error is reported once.
        return true;
    }
    if (src->kind == type_kind.k_null) {
        // `null` takes the type of a pointer, `void*` or function pointer,
        // never of a span or a string, whose zero value is `{}` (D10.5, D3.5,
        // D3.7).
        return dst->kind == type_kind.k_ptr || dst->kind == type_kind.k_voidptr ||
               dst->kind == type_kind.k_fn;
    }
    if (dst->kind == type_kind.k_null || dst->kind == type_kind.k_void ||
        src->kind == type_kind.k_void) {
        return false;
    }
    return convertible(dst, src, true, false);
}

// ---- casts (D3.14) -------------------------------------------------------------

// Whether a type belongs to the string family: `string`, `char@` or `u8@` with
// any marks. These spellings, and only these, cast among themselves in every
// direction: the header is reinterpreted and `mut` and `own` may be added or
// dropped (D3.14, D17.12).
fn bool string_family(node* t) {
    if (t->kind == type_kind.k_string) {
        return true;
    }
    return t->kind == type_kind.k_span && t->elem->kind == type_kind.k_prim &&
           (t->elem->prim == prim.prim_kind.prim_char || t->elem->prim == prim.prim_kind.prim_u8);
}

fn bool is_u64(node* t) {
    return t->kind == type_kind.k_prim && t->prim == prim.prim_kind.prim_u64;
}

fn bool is_ptr_like(node* t) {
    return t->kind == type_kind.k_ptr || t->kind == type_kind.k_voidptr;
}

fn bool is_prim(node* t, prim.prim_kind k) {
    return t->kind == type_kind.k_prim && t->prim == k;
}

// The scalar rows of the matrix: integers, floats, bool, char and enums.
fn bool scalar_cast_allowed(node* dst, node* src) {
    bool src_int = type_is_int(src);
    bool dst_int = type_is_int(dst);
    bool src_num = src_int || type_is_float(src);
    bool dst_num = dst_int || type_is_float(dst);
    if (src_num && dst_num) {
        // Integers and floats convert in every direction: widening, narrowing,
        // sign change, rounding and saturation (D3.14).
        return true;
    }
    if (dst_int) {
        // `bool` gives 0 or 1, `char` its byte value, an enum its `i32` (D3.2,
        // D3.3, D3.9, D3.14).
        return is_prim(src, prim.prim_kind.prim_bool) ||
               is_prim(src, prim.prim_kind.prim_char) || src->kind == type_kind.k_enum;
    }
    if (src_int) {
        // An integer reaches `char` and an enum, never `bool` (D3.3, D3.14).
        return is_prim(dst, prim.prim_kind.prim_char) || dst->kind == type_kind.k_enum;
    }
    // `bool`, `char` and enums do not cast among themselves or to a float: go
    // through an integer (D3.14).
    return false;
}

// Whether `src` loses an `own` under a reference `dst` still owns, at any
// depth: the inner objects would then be owned by nobody, which no cast
// licenses either (D17.4).
fn bool own_orphaned(node* dst, node* src, bool outer_own) {
    node* mut d = dst;
    node* mut s = src;
    bool mut outer = outer_own;
    while (d->kind == type_kind.k_array || type_is_reference(d)) {
        if (d->kind == type_kind.k_array) {
            // A fixed array shares its storage with its elements (D5.2).
            d = d->elem;
            s = s->elem;
            continue;
        }
        if (s->is_own && !d->is_own && outer) {
            return true;
        }
        outer = outer || d->is_own;
        if (d->elem == null) {
            return false; // `string`: no reference behind it
        }
        d = d->elem;
        s = s->elem;
    }
    return false;
}

// The span row of the matrix: a span casts to a span of the same element type
// whose marks differ only in mutability, added or dropped at any level, the
// cast-away-const escape a pointer has, and whose `own` marks may be added or
// dropped at any reference (D3.14). The element type must be the same: the
// marks inside a function type are part of its identity, so
// `fn void(node mut*)@` does not cast to `fn void(node*)@` (D3.10).
fn bool span_cast_allowed(node* dst, node* src) {
    return type_same_shape(dst, src) && !own_orphaned(dst, src, false);
}

// The cast matrix of D3.14 (type-system.md 9.2) on types alone: the rvalue,
// lvalue and `move` rules of D17.5 and D17.8 are the checker's, and so is the
// refusal of a binding-level `mut` in a cast target.
fn bool type_cast_allowed(node* dst, node* src) {
    if (dst->kind == type_kind.k_error || src->kind == type_kind.k_error) {
        return true;
    }
    if (src->kind == type_kind.k_null || dst->kind == type_kind.k_null ||
        dst->kind == type_kind.k_void || src->kind == type_kind.k_void) {
        return false;
    }
    if (type_equal(dst, src)) {
        return true;
    }
    // Any conversion that only drops mutability or ownership is a cast too, a
    // no-op the implicit rules already cover (D3.14). This is the only way a
    // fixed array or a struct converts at all: every other row that names them
    // is an error.
    if (type_assignable(dst, src)) {
        return true;
    }
    if (type_is_scalar(src) && type_is_scalar(dst)) {
        return scalar_cast_allowed(dst, src);
    }
    if (is_ptr_like(src)) {
        // Any pointer casts to any pointer or `void*` with any marks, and to
        // `u64`; a function pointer only through `void*` (D3.11, D3.14).
        return is_ptr_like(dst) || is_u64(dst) ||
               (src->kind == type_kind.k_voidptr && dst->kind == type_kind.k_fn);
    }
    if (is_u64(src)) {
        // An address comes back from `u64`, and from no other integer type
        // (D3.14).
        return is_ptr_like(dst);
    }
    if (src->kind == type_kind.k_fn) {
        // A function pointer casts to `void*` and to nothing else, not even
        // another function type (D3.14).
        return dst->kind == type_kind.k_voidptr;
    }
    if (string_family(src) && string_family(dst)) {
        return true;
    }
    if (src->kind == type_kind.k_span && dst->kind == type_kind.k_span) {
        return span_cast_allowed(dst, src);
    }
    return false;
}

// ---- sizes and layout ----------------------------------------------------------

// `v` rounded up to a multiple of `align` in `*out`; false when the result
// would exceed TYPE_MAX_SIZE (D3.4).
fn bool round_up(u64 v, u64 align, u64 mut* out) {
    if (align == 0) {
        panic("types.round_up: alignment 0");
    }
    u64 rem = v % align;
    if (rem != 0 && v > TYPE_MAX_SIZE - (align - rem)) {
        return false;
    }
    if (rem == 0) {
        *out = v;
    } else {
        *out = v + (align - rem);
    }
    return true;
}

fn layout mut* layout_of(node* s) {
    if (s->kind != type_kind.k_struct) {
        panic("types: layout of a non-struct");
    }
    return s->layout;
}

// The layout of a struct for sizeof and alignof: resolved or in error.
fn layout* laid_out(node* s) {
    layout* l = layout_of(s);
    if (l->state != layout_state.l_resolved && l->state != layout_state.l_error) {
        panic("types: sizeof of a struct without layout");
    }
    return l;
}

// `len * sizeof(elem)` in `*out`; false when the product would exceed
// TYPE_MAX_SIZE (D3.4).
fn bool array_size(node* t, u64 mut* out) {
    u64 mut elem = 0;
    if (!size_checked(t->elem, &elem)) {
        return false;
    }
    if (elem != 0 && t->len > TYPE_MAX_SIZE / elem) {
        return false;
    }
    *out = t->len * elem;
    return true;
}

// The size of `t` in `*out`; false when it would exceed TYPE_MAX_SIZE (D3.4).
// Every size the compiler computes goes through here, so no size arithmetic
// can wrap.
fn bool size_checked(node* t, u64 mut* out) {
    switch (t->kind) {
    case type_kind.k_void, type_kind.k_null:
        panic("types: sizeof of void or null");
    case type_kind.k_error:
        *out = 0;
        return true;
    case type_kind.k_prim:
        *out = cast(prim.prim_size(t->prim), u64);
        return true;
    case type_kind.k_ptr, type_kind.k_voidptr, type_kind.k_fn:
        // A pointer and a function pointer are 8 bytes (D3.1, D3.15).
        *out = PTR_SIZE;
        return true;
    case type_kind.k_span, type_kind.k_string:
        // A span and a string are the fat pointer `{ptr, len}` (D3.5, D3.7).
        *out = SPAN_SIZE;
        return true;
    case type_kind.k_array:
        // `N * sizeof(T)`, exactly: elements are contiguous (D3.4, D3.15).
        return array_size(t, out);
    case type_kind.k_enum:
        // An enum is its underlying `i32` (D3.9).
        *out = ENUM_SIZE;
        return true;
    case type_kind.k_struct:
        // The layout enforced the ceiling when it laid the struct out.
        *out = laid_out(t)->size;
        return true;
    }
    panic("types.size_checked: unknown type kind");
}

// Whether the size of `t` fits the largest object the compiler admits, 2^63 - 1
// bytes (D3.4).
fn bool type_size_fits(node* t) {
    u64 mut size = 0;
    return size_checked(t, &size);
}

// Size in bytes (D3.1, D3.15). A struct must be resolved or in error (0 and
// 1); void and the null type are broken preconditions; the error type is 0.
// `type_sizeof` of a type type_size_fits refuses is a broken precondition too,
// so the caller asks first.
fn u64 type_sizeof(node* t) {
    u64 mut size = 0;
    if (!size_checked(t, &size)) {
        panic("types.type_sizeof: sizeof of a type that is too large");
    }
    return size;
}

// Alignment in bytes (D3.1, D3.15); it equals the size for every primitive.
fn u64 type_alignof(node* t) {
    switch (t->kind) {
    case type_kind.k_void, type_kind.k_null:
        panic("types.type_alignof: alignof of void or null");
    case type_kind.k_error:
        return 1;
    case type_kind.k_prim:
        return cast(prim.prim_size(t->prim), u64);
    case type_kind.k_ptr, type_kind.k_voidptr, type_kind.k_fn, type_kind.k_span,
         type_kind.k_string:
        return PTR_ALIGN;
    case type_kind.k_array:
        return type_alignof(t->elem);
    case type_kind.k_enum:
        return ENUM_SIZE;
    case type_kind.k_struct:
        return laid_out(t)->align;
    }
    panic("types.type_alignof: unknown type kind");
}

// Struct layout is driven by the caller, since fields are not stored in the
// type: for a struct S, `type_layout_begin(S)`; for each field, while
// `type_layout_pending(field)` is a struct, lay that struct out first (a
// `type_layout_begin` that returns false is a value-containment cycle, D3.8:
// report it and `type_layout_fail` the structs on the path); then
// `type_layout_struct(S, ...)`.
fn layout_state type_layout_state(node* s) {
    return layout_of(s)->state;
}

// Unresolved to resolving: true. Resolving: false, a cycle. Resolved and in
// error are broken preconditions.
fn bool type_layout_begin(node* s) {
    layout mut* l = layout_of(s);
    if (l->state == layout_state.l_unresolved) {
        l->state = layout_state.l_resolving;
        return true;
    }
    if (l->state == layout_state.l_resolving) {
        return false;
    }
    panic("types.type_layout_begin: layout begun twice");
}

// Marks a struct in error from any state.
fn void type_layout_fail(node* s) {
    layout mut* l = layout_of(s);
    l->state = layout_state.l_error;
    l->size = 0;
    l->align = 1;
    l->owning = false;
}

// The struct whose layout `sizeof(t)` needs and that is not resolved or in
// error yet: `t` itself, the element's for a fixed array, or null.
fn node* type_layout_pending(node* t) {
    node* cur = behind_arrays(t);
    if (cur->kind != type_kind.k_struct) {
        return null;
    }
    layout_state st = cur->layout->state;
    if (st == layout_state.l_resolved || st == layout_state.l_error) {
        return null;
    }
    return cur;
}

// Lays out the fields per C/System V (D3.8, D9.9): fields in order, each at the
// next multiple of its alignment, size rounded up to the largest alignment.
// Writes the offsets, records size, alignment and whether the struct is an
// owning aggregate on `s`, and marks it resolved. `s` must be a struct that is
// unresolved or resolving, `fields` must not be empty, no field may be
// pending, and `offsets` must have room for one offset per field.
//
// Returns false when the struct would pass the ceiling of 2^63 - 1 bytes
// (D3.4), because a field does or because the fields together do: `s` is left
// in error, as after type_layout_fail, the offsets are unspecified, and the
// caller reports "type is too large" the way it reports the infinite-size
// error of a cycle.
fn bool type_layout_struct(node* s, node*@ fields, u64 mut@ offsets) {
    layout mut* l = layout_of(s);
    if (l->state == layout_state.l_resolved || l->state == layout_state.l_error) {
        panic("types.type_layout_struct: layout of a struct twice");
    }
    if (fields.len == 0) {
        panic("types.type_layout_struct: layout of an empty struct");
    }
    // The C writes through a bare pointer and cannot see the caller's room; a
    // span carries its length, so a short one is a broken precondition here
    // rather than a store past the end there (D13.3).
    if (offsets.len < fields.len) {
        panic("types.type_layout_struct: too few offset slots");
    }
    u64 mut off = 0;
    u64 mut align = 1;
    bool mut owning = false;
    u64 mut i = 0;
    while (i < fields.len) {
        node* f = fields[i];
        if (type_layout_pending(f) != null) {
            panic("types.type_layout_struct: layout with a pending field");
        }
        // Fields in order, each at the next multiple of its alignment (D3.8,
        // D9.9); a field or a total past the ceiling makes the whole struct
        // too large (D3.4).
        u64 mut size = 0;
        u64 a = type_alignof(f);
        if (!size_checked(f, &size) || !round_up(off, a, &off) || off > TYPE_MAX_SIZE - size) {
            type_layout_fail(s);
            return false;
        }
        offsets[i] = off;
        off += size;
        if (a > align) {
            align = a;
        }
        // An `own` field, or a field that owns through an aggregate, makes the
        // struct an owning aggregate (D17.7).
        if ((type_is_reference(f) && f->is_own) || type_is_owning_aggregate(f)) {
            owning = true;
        }
        i += 1;
    }
    // The size is rounded up to the alignment, as C lays the same struct out
    // (D3.8).
    if (!round_up(off, align, &l->size)) {
        type_layout_fail(s);
        return false;
    }
    l->align = align;
    l->owning = owning;
    l->state = layout_state.l_resolved;
    return true;
}

// ---- spelling ------------------------------------------------------------------

// The suffixes of one spelled type, from the outermost inward, then the base
// (D3.6): a group of reference suffixes, a group of fixed-array suffixes and a
// second group of reference suffixes, any of them empty. A chain no
// declaration can write, which is one with an array suffix after a trailing
// reference suffix, stops at the node that would need it and spells the rest in
// parentheses.
struct spine {
    node*[SPINE_MAX] nodes;
    u64 n;
    u64 first_array; // the array group is [first_array, end_array)
    u64 end_array;
    node* base;
    bool paren;
}

fn bool is_array_node(node* t) {
    return t->kind == type_kind.k_array;
}

// A `*` or `@` suffix: the two that introduce a reference (D3.6).
fn bool is_ref_node(node* t) {
    return t->kind == type_kind.k_ptr || t->kind == type_kind.k_voidptr ||
           t->kind == type_kind.k_span;
}

fn void spine_collect(spine mut* sp, node* t) {
    bool mut seen_array = false;
    bool mut seen_ref_after_array = false;
    node* mut cur = t;
    sp->n = 0;
    // Read outward-in, the array group is met once: an array behind a
    // reference that is itself behind an array has no spelling, since no array
    // suffix may follow a trailing reference suffix (D3.6).
    while (sp->n < SPINE_MAX) {
        if (is_array_node(cur)) {
            if (seen_ref_after_array) {
                break;
            }
            seen_array = true;
        } else if (is_ref_node(cur)) {
            seen_ref_after_array = seen_ref_after_array || seen_array;
        } else {
            break;
        }
        sp->nodes[sp->n] = cur;
        sp->n += 1;
        cur = cur->elem;
    }
    sp->base = cur;
    sp->paren = is_array_node(cur) || is_ref_node(cur);
    sp->first_array = sp->n;
    sp->end_array = 0;
    u64 mut i = 0;
    while (i < sp->n) {
        if (is_array_node(sp->nodes[i])) {
            if (sp->first_array == sp->n) {
                sp->first_array = i;
            }
            sp->end_array = i + 1;
        }
        i += 1;
    }
    if (sp->first_array == sp->n) {
        sp->first_array = 0;
        sp->end_array = 0;
    }
}

fn void spell_base(node* t, strbuf.str_buf mut* out) {
    switch (t->kind) {
    case type_kind.k_void:
        strbuf.append(out, "void");
        return;
    case type_kind.k_prim:
        strbuf.append(out, prim.prim_name(t->prim));
        return;
    case type_kind.k_string:
        strbuf.append(out, "string");
        return;
    case type_kind.k_struct, type_kind.k_enum:
        strbuf.append(out, t->name);
        return;
    case type_kind.k_null:
        strbuf.append(out, "null");
        return;
    case type_kind.k_error:
        strbuf.append(out, "<error>");
        return;
    case type_kind.k_fn:
        strbuf.append(out, "fn ");
        if (t->is_noreturn) {
            strbuf.append(out, "noreturn");
        } else {
            spell(t->elem, false, out);
        }
        strbuf.push(out, '(');
        u64 mut i = 0;
        while (i < t->params.len) {
            if (i > 0) {
                strbuf.append(out, ", ");
            }
            node* p = t->params[i];
            spell(p, false, out);
            i += 1;
        }
        strbuf.push(out, ')');
        return;
    case type_kind.k_ptr, type_kind.k_voidptr, type_kind.k_array, type_kind.k_span:
        break;
    }
    panic("types.spell_base: spelling a reference as a base");
}

// The mutability of the storage that holds what the node at `i` introduces:
// the target of the first reference outside it, since a fixed array between
// them shares its storage with its elements, or level 0 when no reference is
// outside it (D5.2, D5.3).
fn bool holder_mut(spine* sp, u64 i, bool mut0) {
    u64 mut j = i;
    while (j > 0) {
        if (is_ref_node(sp->nodes[j - 1])) {
            return sp->nodes[j - 1]->is_mut;
        }
        j -= 1;
    }
    return mut0;
}

// One suffix with the markers of its position: `own` for a reference that owns
// its target, `mut` for the storage the suffix's own value occupies. A
// reference held by a fixed array prints no `mut`, and neither does an array
// that is not the last of its group: they share one storage, whose marker is
// written after the last length of the group (D5.3, D17.2).
fn void spell_suffix(spine* sp, u64 i, bool mut0, strbuf.str_buf mut* out) {
    node* t = sp->nodes[i];
    if (is_array_node(t)) {
        strbuf.push(out, '[');
        strbuf.append_u64(out, t->len);
        strbuf.push(out, ']');
        if (i + 1 == sp->end_array && holder_mut(sp, i, mut0)) {
            strbuf.append(out, " mut");
        }
        return;
    }
    if (t->kind == type_kind.k_span) {
        strbuf.append(out, "@");
    } else {
        strbuf.append(out, "*");
    }
    if (t->is_own) {
        strbuf.append(out, " own");
    }
    bool held_by_array = i > 0 && is_array_node(sp->nodes[i - 1]);
    if (!held_by_array && holder_mut(sp, i, mut0)) {
        strbuf.append(out, " mut");
    }
}

// The suffixes in source order: the reference group nearest the base first,
// innermost first, then the array group outermost first, then the trailing
// reference group, innermost first (D3.6).
fn void spell_suffixes(spine* sp, bool mut0, strbuf.str_buf mut* out) {
    u64 mut i = sp->n;
    while (i > sp->end_array) {
        spell_suffix(sp, i - 1, mut0, out);
        i -= 1;
    }
    i = sp->first_array;
    while (i < sp->end_array) {
        spell_suffix(sp, i, mut0, out);
        i += 1;
    }
    i = sp->first_array;
    while (i > 0) {
        spell_suffix(sp, i - 1, mut0, out);
        i -= 1;
    }
}

fn void spell(node* t, bool mut0, strbuf.str_buf mut* out) {
    spine mut sp = spine{};
    spine_collect(&sp, t);
    // The base position: the storage of the values of the base type, which is
    // the target of the innermost reference, or the binding when the type has
    // no suffix. An array between them takes the marker (D5.3).
    bool mut base_mut = mut0;
    if (sp.n != 0) {
        base_mut = is_ref_node(sp.nodes[sp.n - 1]) && sp.nodes[sp.n - 1]->is_mut;
    }
    if (sp.paren) {
        strbuf.push(out, '(');
        spell(sp.base, base_mut, out);
        strbuf.push(out, ')');
    } else {
        spell_base(sp.base, out);
        // `string` is a reference with no suffix, so it takes `own` after the
        // base type; `own` precedes `mut` in a position (D3.7, D17.2).
        if (sp.base->kind == type_kind.k_string && sp.base->is_own) {
            strbuf.append(out, " own");
        }
        if (base_mut) {
            strbuf.append(out, " mut");
        }
    }
    spell_suffixes(&sp, mut0, out);
}

// Appends the canonical spelling without the binding's position:
// `node mut* own mut@ own`, `u8 mut@ own mut*`, `fn i32(i32, i32)`,
// `fn noreturn()`. Every combination of marks has a spelling (D5.3), so the
// only chain that needs parentheses is one with an array suffix after a
// trailing reference suffix, which does not parse (D3.6): `(i32[4])*[2]`. The
// null type is `null`, the error type `<error>`.
fn void type_to_str(node* t, strbuf.str_buf mut* out) {
    spell(t, false, out);
}

// Appends the spelling of a declaration's type with the binding's position,
// the last one: `node* mut`, `u8@* mut`, `i32[4] mut`, `string own mut`. Level
// 0 is a position like any other, so this is type_to_str with the last marker
// written (D5.3).
fn void type_to_str_decl(node* t, bool mut0, strbuf.str_buf mut* out) {
    spell(t, mut0, out);
}

// ---- builder (D3.6) ------------------------------------------------------------

// One suffix of `base [own] [mut] { suffix [own] [mut] }` in source order, with
// the `own` and `mut` written right after it. An array suffix carries no `own`
// (D17.2).
enum suffix_kind {
    s_ptr,   // `*`, a reference suffix (D3.6)
    s_array, // `[N]` (D3.4)
    s_span,  // `@`, a reference suffix (D3.5)
}

struct suffix {
    suffix_kind kind;
    u64 len; // s_array
    bool is_own;
    bool is_mut;
}

// What type_build answers. The C calls the first field `type`, which is a
// reserved word here (D2.4), so it is `built`; it is null when the descriptors
// are invalid, and `error` then holds the reason and is "" otherwise.
struct build_result {
    node* built;
    bool mut0; // level 0 of the declaration (D5.2)
    string error;
}

fn build_result build_error(string msg) {
    return build_result{null, false, msg};
}

// A `*` or `@` suffix, the two that introduce a reference (D3.6).
fn bool suffix_is_ref(suffix* s) {
    return s->kind == suffix_kind.s_ptr || s->kind == suffix_kind.s_span;
}

// The three groups of a suffix list: [0, e) references applying to the base,
// [e, a) fixed arrays, [a, n) references applying to the whole array.
struct groups {
    u64 e;
    u64 a;
    u64 n;
}

fn bool split_groups(suffix@ s, groups mut* g) {
    u64 mut i = 0;
    while (i < s.len && suffix_is_ref(&s[i])) {
        i += 1;
    }
    g->e = i;
    while (i < s.len && s[i].kind == suffix_kind.s_array) {
        i += 1;
    }
    g->a = i;
    while (i < s.len && suffix_is_ref(&s[i])) {
        i += 1;
    }
    g->n = s.len;
    return i == s.len;
}

// The index of the k-th suffix applied, innermost first: reference suffixes
// read inside-out, so each group is applied in source order, and the array
// group reads outside-in, so it is applied in reverse (D3.6).
fn u64 apply_order(groups* g, u64 k) {
    if (k >= g->e && k < g->a) {
        return g->a - 1 - (k - g->e);
    }
    return k;
}

// The markers of every position, before anything is built, as a message or "".
// A position marks the storage of what it follows, and a fixed array shares its
// storage with its elements, so a `mut` on the position an array suffix follows
// belongs after that array's length instead (D5.3).
fn string check_positions(node* base, bool base_own, bool base_mut, suffix@ s) {
    // `void` is a return type or the base of `void*`, and has no target level
    // for a marker of its own (D3.11, D5.3).
    if (base->kind == type_kind.k_void &&
        (base_own || base_mut || (s.len > 0 && s[0].kind != suffix_kind.s_ptr))) {
        return "'void' is only a return type or the base of 'void*'";
    }
    if (base_own && base->kind != type_kind.k_string) {
        return "'own' marks a reference: write it after a '*' or an '@'";
    }
    if (base_own && base->is_own) {
        // No source can write it: a base type is never an owned one.
        panic("types.check_positions: own on a base type that is already owned");
    }
    if (base_mut && s.len > 0 && s[0].kind == suffix_kind.s_array) {
        return "mark the array after its length";
    }
    u64 mut i = 0;
    while (i < s.len) {
        if (s[i].kind == suffix_kind.s_array) {
            if (s[i].len == 0) {
                return "array length must be greater than 0";
            }
            if (s[i].is_own) {
                return "'own' never follows a fixed-array suffix";
            }
        }
        if (s[i].is_mut && i + 1 < s.len && s[i + 1].kind == suffix_kind.s_array) {
            return "mark the array after its length";
        }
        i += 1;
    }
    return "";
}

// Builds the type `base [own] [mut] suffixes...` by the reading rules of D3.6,
// D5.3 and D17.2. Reference suffixes (`*`, `@`) read inside-out, so each of the
// two reference groups applies in source order; the fixed-array group between
// them reads outside-in. Each position marks the storage of what it follows:
// `base_mut` the values of the base type, a `mut` after a reference suffix the
// storage holding that reference, a `mut` after the last length of the array
// group the array; the marker of the last position is the binding, returned as
// `mut0`. `base_own` marks a `string`, the reference with no suffix, and an
// `own` after `*` or `@` the reference that suffix introduces.
//
// Refused, with the message in `error`: an array suffix after a trailing
// reference suffix, `own` after a fixed-array suffix or after any base type but
// `string`, a `mut` on the position a fixed-array suffix follows, an array
// length of 0, and `void` other than as the base of `void*`. A base of `void`
// with no suffix builds `void` itself, for return types, and a base of the
// error type poisons the result without a second diagnostic.
//
// The builder sees one type and knows nothing of where it stands, so two
// placement rules stay with the checker: the outermost position of a struct
// field or of a return type never carries `mut` (D5.5), and neither does the
// outermost position of a cast target (D3.14).
fn build_result type_build(table mut* tt, bool base_own, bool base_mut, node* base,
                           suffix@ suffixes) {
    if (base->kind == type_kind.k_error) {
        // The base already failed: poison the result rather than report a
        // second diagnostic about its markers.
        bool mut poisoned_mut0 = base_mut;
        if (suffixes.len != 0) {
            poisoned_mut0 = suffixes[suffixes.len - 1].is_mut;
        }
        return build_result{base, poisoned_mut0, ""};
    }
    groups mut g = groups{};
    if (!split_groups(suffixes, &g)) {
        return build_error("no array suffix may follow a trailing reference suffix");
    }
    string bad = check_positions(base, base_own, base_mut, suffixes);
    if (bad != "") {
        return build_error(bad);
    }
    // Build innermost first. A position's `mut` marks the storage of what it
    // follows, which the next reference outward reaches, or the binding when no
    // reference is outside it; a fixed array shares that storage with its
    // elements and adds no level (D5.2, D5.3).
    node* mut t = base;
    if (base_own) {
        t = type_string(tt, true);
    }
    bool mut pending_mut = base_mut;
    u64 mut k = 0;
    while (k < suffixes.len) {
        u64 at = apply_order(&g, k);
        if (suffixes[at].kind == suffix_kind.s_array) {
            t = type_array(tt, t, suffixes[at].len);
            pending_mut = pending_mut || suffixes[at].is_mut;
            k += 1;
            continue;
        }
        if (suffixes[at].kind == suffix_kind.s_span) {
            t = type_span(tt, t, suffixes[at].is_own, pending_mut);
        } else if (t->kind == type_kind.k_void) {
            t = type_voidptr(tt, suffixes[at].is_own);
        } else {
            t = type_ptr(tt, t, suffixes[at].is_own, pending_mut);
        }
        pending_mut = suffixes[at].is_mut;
        k += 1;
    }
    return build_result{t, pending_mut, ""};
}
