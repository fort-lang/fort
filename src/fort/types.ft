/// Represents and interns compiler types.
/// It checks conversions, casts, sizes, layouts, and canonical spellings.
import prim;
import std.strbuf;

// The sizes the type rules fix.
u64 PTR_SIZE = 8;
u64 PTR_ALIGN = 8;
u64 SPAN_SIZE = 16;
u64 ENUM_SIZE = 4;

// The largest permitted object is 2^63 - 1 bytes. A declaration reports
// "type is too large" when its type would exceed this limit.
u64 TYPE_MAX_SIZE = 9223372036854775807;

// The most nodes one spelled chain walks; a deeper chain continues in
// parentheses.
u64 SPINE_MAX = 64;

// The first non-zero capacity of the node vector; growth doubles from there.
u64 NODE_MIN_CAP = 16;

// The largest u64 there is, which the capacity guard holds its arithmetic
// against.
u64 U64_MAX = 18446744073709551615;

/// Identifies a represented type.
// Member names use short prefixes to distinguish them from constructor names.
enum type_kind {
    k_void,    // `void`: a return type or the base of `void*`
    k_prim,    // a primitive (prim.ft)
    k_ptr,     // `T*`, `T* own`, `T mut*`
    k_voidptr, // `void*`, `void* own`, `void mut*`
    k_fn, // `fn (P1, P2) R`
    k_array, // `T[N]`
    k_span, // `T@`, `T@ own`, `T mut@`
    k_string, // `string`, `string own`
    k_struct, // nominal
    k_enum, // nominal, underlying i32
    k_null, // the type of the literal `null` before it adopts one
    k_error,   // poison: the type of an expression that already failed
}

/// Identifies the state of a struct layout.
enum layout_state {
    l_unresolved,
    l_resolving, // on the resolution path: reaching it again is a cycle
    l_resolved,
    l_error, // infinite size; sizeof yields 0 and alignof 1
}

// What a laid-out struct knows about itself.
struct layout {
    layout_state state;
    u64 size;
    u64 align;
    bool owning; // a field is an `own` reference or an owning aggregate
}

/// Describes one type. Fields unused by its kind hold zero values.
struct node {
    type_kind kind;
    prim.prim_kind prim; // k_prim
    bool is_mut;         // k_ptr, k_voidptr, k_span: the storage reached is mutable
    bool is_own;         // k_ptr, k_voidptr, k_span, k_string
    bool is_noreturn;    // k_fn: `fn (...) noreturn`, with elem void
    node* elem;          // pointee, element or return type
    u64 len;             // k_array
    // k_fn parameter types
    node* mut@ own params;
    string name;            // k_struct, k_enum: the spelling in diagnostics
    // k_struct, k_enum: the declaring symbol, opaque. The checker resolves the
    // declaration through the type and writes the record. Thus, the pointer is
    // `void mut*`. A cast adds no `mut`.
    void mut* decl;
    layout mut* own layout; // k_struct; null otherwise
}

// The fields that decide whether an interned node already exists.
struct key {
    type_kind kind;
    prim.prim_kind prim;
    bool is_mut;
    bool is_own;
    bool is_noreturn;
    node* elem;
    u64 len;
    node*@ params;
}

/// Stores interned types for one analysis. A zero value is ready for use.
struct table {
    // Nodes in creation order. `count` is the used slot count.
    node mut* own mut@ own nodes;
    u64 count;
    node* void_type;
    node* null_type;
    node* error_type;
    // One slot per primitive kind. PRIM_COUNT sizes this array. Adding an enum
    // kind therefore updates the array without a second size edit.
    node*[prim.PRIM_COUNT] prims;
}

// ---- table and interning -------------------------------------------------------

// Resets an empty table to its zero value.
fn type_table_init(table mut* tt) void {
    *tt = table{};
}

// Clears the table.
fn type_table_free(table mut* tt) void {
    u64 mut i = 0;
    while (i < tt->count) {
        node mut* own t = move(tt->nodes[i]);
        del(t->params);
        del(t->layout);
        del(t);
        i += 1;
    }
    del(tt->nodes);
    tt->count = 0;
    tt->void_type = null;
    tt->null_type = null;
    tt->error_type = null;
    u64 mut k = 0;
    while (k < prim.PRIM_COUNT) {
        tt->prims[k] = null;
        k += 1;
    }
}

// Ensures room for one more node, growing to the largest of NODE_MIN_CAP and
// twice the capacity.
fn reserve(table mut* tt) void {
    if (tt->count < tt->nodes.len) {
        return;
    }
    u64 mut cap = NODE_MIN_CAP;
    if (tt->nodes.len >= cap) {
        // nothing here may detect an overflow by performing one
        if (tt->nodes.len > U64_MAX / 2) {
            panic("types.reserve: capacity overflow");
        }
        cap = tt->nodes.len * 2;
    }
    node mut* own mut@ own bigger = new(node mut* own, cap);
    u64 mut i = 0;
    while (i < tt->count) {
        bigger[i] = move(tt->nodes[i]);
        i += 1;
    }
    del(tt->nodes);
    tt->nodes = move(bigger);
}

// Creates and records a node of `kind`.
fn node_new(table mut* tt, type_kind kind) node mut* {
    node mut* own fresh = new(node);
    fresh->kind = kind;
    reserve(tt);
    tt->nodes[tt->count] = move(fresh);
    tt->count += 1;
    return tt->nodes[tt->count - 1];
}

// Structural equality of an interned node and a key by child identity:
// children are interned, so pointer equality of children is enough. Nominal
// nodes are never interned, so they never match.
fn node_same(node* t, key* k) bool {
    if (t->kind != k->kind) {
        return false;
    }
    if (t->kind == type_kind.k_struct || t->kind == type_kind.k_enum) {
        return false;
    }
    if (t->prim != k->prim || t->is_mut != k->is_mut || t->is_own != k->is_own ||
        t->is_noreturn != k->is_noreturn || t->elem != k->elem || t->len != k->len ||
        t->params.len != k->params.len) {
        return false;
    }
    u64 mut i = 0;
    while (i < t->params.len) {
        node* left = t->params[i];
        if (left != k->params[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

// The interned node equal to `k`, or a fresh copy of it.
fn intern(table mut* tt, key* k) node* {
    u64 mut i = 0;
    while (i < tt->count) {
        node* t = tt->nodes[i];
        if (node_same(t, k)) {
            return t;
        }
        i += 1;
    }
    node mut* t = node_new(tt, k->kind);
    t->prim = k->prim;
    t->is_mut = k->is_mut;
    t->is_own = k->is_own;
    t->is_noreturn = k->is_noreturn;
    t->elem = k->elem;
    t->len = k->len;
    if (k->params.len > 0) {
        node* mut@ own params = new(node*, k->params.len);
        u64 mut j = 0;
        while (j < k->params.len) {
            params[j] = k->params[j];
            j += 1;
        }
        t->params = move(params);
    }
    return t;
}

// A zeroed key of `kind`: the fields a constructor does not set keep the values
// of a node that never carries them.
fn key_of(type_kind kind) key {
    key mut k = key{};
    k.kind = kind;
    k.prim = prim.prim_kind.prim_i8;
    return k;
}

// ---- constructors --------------------------------------------------------------
// Every constructor interns: equal arguments give the same node. An elem or
// parameter of kind k_error poisons the result, which is the error type.

fn type_void(table mut* tt) node* {
    if (tt->void_type == null) {
        tt->void_type = node_new(tt, type_kind.k_void);
    }
    return tt->void_type;
}

fn type_null(table mut* tt) node* {
    if (tt->null_type == null) {
        tt->null_type = node_new(tt, type_kind.k_null);
    }
    return tt->null_type;
}

fn type_error(table mut* tt) node* {
    if (tt->error_type == null) {
        tt->error_type = node_new(tt, type_kind.k_error);
    }
    return tt->error_type;
}

/// `k` must not be prim_void: `void` is a type kind of its own (type_void).
fn type_prim(table mut* tt, prim.prim_kind k) node* {
    if (k == prim.prim_kind.prim_void) {
        panic("types.type_prim: prim_void as a primitive type: use type_void");
    }
    u64 slot = cast(k, u64);
    if (tt->prims[slot] == null) {
        node mut* t = node_new(tt, type_kind.k_prim);
        t->prim = k;
        tt->prims[slot] = t;
    }
    return tt->prims[slot];
}

fn type_string(table mut* tt, bool is_own) node* {
    key mut k = key_of(type_kind.k_string);
    k.is_own = is_own;
    return intern(tt, &k);
}

fn type_voidptr(table mut* tt, bool is_own, bool is_mut) node* {
    key mut k = key_of(type_kind.k_voidptr);
    k.elem = type_void(tt);
    k.is_own = is_own;
    // The storage behind a `void*` has no type, and `void mut*` says a caller
    // may write it.
    k.is_mut = is_mut;
    return intern(tt, &k);
}

// The element checks shared by pointers, spans and arrays; true when the
// result is the poisoned error type.
fn elem_poisons(node* elem) bool {
    if (elem->kind == type_kind.k_void) {
        panic("types: void as an element type");
    }
    if (elem->kind == type_kind.k_null) {
        panic("types: null as an element type");
    }
    return elem->kind == type_kind.k_error;
}

/// `elem` must not be void (use type_voidptr) or the null type.
fn type_ptr(table mut* tt, node* elem, bool is_own, bool is_mut) node* {
    if (elem_poisons(elem)) {
        return elem;
    }
    key mut k = key_of(type_kind.k_ptr);
    k.elem = elem;
    k.is_own = is_own;
    k.is_mut = is_mut;
    return intern(tt, &k);
}

fn type_span(table mut* tt, node* elem, bool is_own, bool is_mut) node* {
    if (elem_poisons(elem)) {
        return elem;
    }
    key mut k = key_of(type_kind.k_span);
    k.elem = elem;
    k.is_own = is_own;
    k.is_mut = is_mut;
    return intern(tt, &k);
}

/// `len` must be greater than 0; `elem` must not be void or null.
fn type_array(table mut* tt, node* elem, u64 len) node* {
    if (elem_poisons(elem)) {
        return elem;
    }
    if (len == 0) {
        panic("types.type_array: array length 0");
    }
    key mut k = key_of(type_kind.k_array);
    k.elem = elem;
    k.len = len;
    return intern(tt, &k);
}

/// `ret` must be void for a `noreturn` function.
fn type_fn(table mut* tt, node* ret, node*@ params, bool is_noreturn) node* {
    if (ret->kind == type_kind.k_null) {
        panic("types.type_fn: null as a return type");
    }
    if (is_noreturn && ret->kind != type_kind.k_void) {
        panic("types.type_fn: noreturn with a return type");
    }
    if (ret->kind == type_kind.k_error) {
        return ret;
    }
    u64 mut i = 0;
    while (i < params.len) {
        if (params[i]->kind == type_kind.k_error) {
            return params[i];
        }
        if (params[i]->kind == type_kind.k_void || params[i]->kind == type_kind.k_null) {
            panic("types.type_fn: void or null as a parameter type");
        }
        i += 1;
    }
    key mut k = key_of(type_kind.k_fn);
    k.elem = ret;
    k.params = params;
    k.is_noreturn = is_noreturn;
    return intern(tt, &k);
}

// A nominal type has one node per declaration because the declaration defines
// identity. Another call with the same `decl` returns the first node. Thus, one
// struct cannot split its derived types across nodes. A null
// `decl` is anonymous and always makes a node.
fn nominal(table mut* tt, type_kind kind, string name, void mut* decl) node* {
    if (decl != null) {
        u64 mut i = 0;
        while (i < tt->count) {
            node* t = tt->nodes[i];
            if (t->decl == decl) {
                if (t->kind != kind) {
                    panic("types: one declaration used for a struct and an enum");
                }
                return t;
            }
            i += 1;
        }
    }
    node mut* t = node_new(tt, kind);
    t->name = name;
    t->decl = decl;
    if (kind == type_kind.k_struct) {
        t->layout = new(layout);
        t->layout->state = layout_state.l_unresolved;
        t->layout->align = 1;
    }
    return t;
}

/// Creates a nominal type with unresolved layout.
/// Non-null `decl` values define nominal identity.
fn type_struct(table mut* tt, string name, void mut* decl) node* {
    return nominal(tt, type_kind.k_struct, name, decl);
}

/// Creates a nominal enum type. Non-null `decl` values define nominal identity.
fn type_enum(table mut* tt, string name, void mut* decl) node* {
    return nominal(tt, type_kind.k_enum, name, decl);
}

// ---- queries -------------------------------------------------------------------

// A pointer, `void*`, span or string: the kinds that may be `own`.
fn type_is_reference(node* t) bool {
    return t->kind == type_kind.k_ptr || t->kind == type_kind.k_voidptr ||
           t->kind == type_kind.k_span || t->kind == type_kind.k_string;
}

fn type_is_int(node* t) bool {
    return t->kind == type_kind.k_prim && prim.prim_is_integer(t->prim);
}

fn type_is_float(node* t) bool {
    return t->kind == type_kind.k_prim && prim.prim_is_float(t->prim);
}

// Integer, float, bool, char, enum.
fn type_is_scalar(node* t) bool {
    return t->kind == type_kind.k_prim || t->kind == type_kind.k_enum;
}

// Skips the fixed arrays around a type: the node whose storage the arrays'
// elements share.
fn behind_arrays(node* t) node* {
    node* mut cur = t;
    while (cur->kind == type_kind.k_array) {
        cur = cur->elem;
    }
    return cur;
}

// Whether a reference reaches a storage level. Pointers, `void*`, and spans do.
// Strings do not because their characters are immutable and have no target level. The
// level a `void*` reaches has no type, and `void mut*` marks it writable.
fn has_target_level(node* t) bool {
    return t->kind == type_kind.k_ptr || t->kind == type_kind.k_voidptr ||
           t->kind == type_kind.k_span;
}

/// Returns the number of storage levels after level 0.
/// Each pointer, `void*`, or span adds one level. Fixed arrays and strings add none.
fn type_levels(node* t) u64 {
    u64 mut n = 0;
    node* mut cur = behind_arrays(t);
    while (has_target_level(cur)) {
        n += 1;
        cur = behind_arrays(cur->elem);
    }
    return n;
}

/// Returns the reference that reaches storage level `k`, where `k` is at least 1.
/// Fixed arrays do not add levels. The function returns null beyond the chain.
/// A string node can report its `own` mark, but it does not add a storage level.
fn type_ref_at(node* t, u64 k) node* {
    if (k == 0) {
        panic("types.type_ref_at: level 0 is not a reference");
    }
    node* mut cur = behind_arrays(t);
    u64 mut left = k;
    while (type_is_reference(cur)) {
        if (left == 1) {
            return cur;
        }
        if (cur->elem == null) {
            return null;
        }
        cur = behind_arrays(cur->elem);
        left -= 1;
    }
    return null;
}

/// The mutability of level k >= 1: false beyond the chain and for the
/// characters of a string. Level 1 of a `void*` is the storage it reaches,
/// which `void mut*` marks writable.
fn type_level_mut(node* t, u64 k) bool {
    node* r = type_ref_at(t, k);
    return r != null && r->is_mut;
}

/// Whether a struct or fixed array contains an `own` reference by value, directly
/// or through nested aggregates. A struct answers from its layout, so it must be
/// resolved; a struct in error answers false.
fn type_is_owning_aggregate(node* t) bool {
    if (t->kind == type_kind.k_array) {
        node* e = t->elem;
        return (type_is_reference(e) && e->is_own) || type_is_owning_aggregate(e);
    }
    if (t->kind != type_kind.k_struct) {
        return false;
    }
    if (t->layout->state == layout_state.l_error) {
        return false;
    }
    if (t->layout->state != layout_state.l_resolved) {
        panic("types.type_is_owning_aggregate: owning query on a struct without layout");
    }
    return t->layout->owning;
}

// ---- identity ------------------------------------------------------------------

// The identity: with `bits` false the `mut` and `own` marks of the reference
// chain are ignored and only its shape is compared. A function type is always
// compared whole. Its parameter and result marks are part of its identity, not
// the chain that reaches it.
fn same(node* a, node* b, bool bits) bool {
    if (a == b) {
        return true;
    }
    if (a->kind != b->kind) {
        return false;
    }
    switch (a->kind) {
    case type_kind.k_void, type_kind.k_null, type_kind.k_error:
        return true;
    case type_kind.k_prim:
        return a->prim == b->prim;
    case type_kind.k_string:
        return !bits || a->is_own == b->is_own;
    case type_kind.k_ptr, type_kind.k_voidptr, type_kind.k_span:
        // The elem of a `void*` is always `void`, so the recursion ends there,
        // and only its marks decide.
        return (!bits || (a->is_own == b->is_own && a->is_mut == b->is_mut)) &&
               same(a->elem, b->elem, bits);
    case type_kind.k_array:
        return a->len == b->len && same(a->elem, b->elem, bits);
    case type_kind.k_fn:
        // `fn (node mut*) void` and `fn (node*) void` are two types
        if (a->is_noreturn != b->is_noreturn || a->params.len != b->params.len ||
            !same(a->elem, b->elem, true)) {
            return false;
        }
        u64 mut i = 0;
        while (i < a->params.len) {
            node* left = a->params[i];
            node* right = b->params[i];
            if (!same(left, right, true)) {
                return false;
            }
            i += 1;
        }
        return true;
    case type_kind.k_struct, type_kind.k_enum:
        return a->decl != null && a->decl == b->decl;
    }
    panic("types.same: unknown type kind");
}

/// Identity: nominal for struct and enum, structural otherwise, with the `mut`
/// and `own` bits of every level.
fn type_equal(node* a, node* b) bool {
    return same(a, b, true);
}

/// Tests type identity while ignoring `mut` and `own` marks in the reference chain.
fn type_same_shape(node* a, node* b) bool {
    return same(a, b, false);
}

// ---- implicit conversions ------------------------------------------------------

// Whether `src` converts to `dst` at one chain position. `prefix_immutable`
// means each earlier destination level is immutable. `outer_own` means an outer
// destination reference owns its value.
fn convertible(node* dst, node* src, bool prefix_immutable, bool outer_own) bool {
    if (dst == src) {
        return true;
    }
    if (dst->kind != src->kind) {
        return false;
    }
    switch (dst->kind) {
    case type_kind.k_void, type_kind.k_null, type_kind.k_error:
        return true;
    case type_kind.k_prim:
        // the only implicit conversions drop marks
        return dst->prim == src->prim;
    case type_kind.k_struct, type_kind.k_enum, type_kind.k_fn:
        // nominal, and no variance for function types
        return type_equal(dst, src);
    case type_kind.k_array:
        return dst->len == src->len &&
               convertible(dst->elem, src->elem, prefix_immutable, outer_own);
    case type_kind.k_string, type_kind.k_voidptr, type_kind.k_ptr, type_kind.k_span:
        break;
    }
    if (dst->is_mut && !src->is_mut) {
        return false;
    }
    if (src->is_mut && !dst->is_mut && !prefix_immutable) {
        // the C `T** -> const T**` hole
        return false;
    }
    if (dst->is_own && !src->is_own) {
        return false;
    }
    if (src->is_own && !dst->is_own && (!prefix_immutable || outer_own)) {
        // else the inner objects would be owned by nobody
        return false;
    }
    if (dst->elem == null) {
        // a `string` has no level behind it
        return true;
    }
    return convertible(dst->elem, src->elem, prefix_immutable && !dst->is_mut,
                       outer_own || dst->is_own);
}

/// Tests whether a value of `src` can initialize `dst`.
/// Accepted cases include identity, valid null targets, and allowed `mut` or `own` drops.
/// Error types convert either way. Void and null destinations reject values.
fn type_assignable(node* dst, node* src) bool {
    if (dst->kind == type_kind.k_error || src->kind == type_kind.k_error) {
        // A poisoned type converts either way, so one error is reported once.
        return true;
    }
    if (src->kind == type_kind.k_null) {
        // The null literal never converts to a span or string. Their zero is `{}`.
        return dst->kind == type_kind.k_ptr || dst->kind == type_kind.k_voidptr ||
               dst->kind == type_kind.k_fn;
    }
    if (dst->kind == type_kind.k_null || dst->kind == type_kind.k_void ||
        src->kind == type_kind.k_void) {
        return false;
    }
    return convertible(dst, src, true, false);
}

// ---- casts ---------------------------------------------------------------------

// Whether a type belongs to the string family: `string`, `char@` or `u8@` with
// any marks. These spellings, and only these, cast among themselves: the header
// is reinterpreted, `own` may be added or dropped, and `mut` may be dropped.
// Adding `mut` is refused here as everywhere, so `cast("abc", u8 mut@)` no
// longer aliases read-only bytes as writable ones.
fn string_family(node* t) bool {
    if (t->kind == type_kind.k_string) {
        return true;
    }
    return t->kind == type_kind.k_span && t->elem->kind == type_kind.k_prim &&
           (t->elem->prim == prim.prim_kind.prim_char || t->elem->prim == prim.prim_kind.prim_u8);
}

fn is_u64(node* t) bool {
    return t->kind == type_kind.k_prim && t->prim == prim.prim_kind.prim_u64;
}

fn is_ptr_like(node* t) bool {
    return t->kind == type_kind.k_ptr || t->kind == type_kind.k_voidptr;
}

fn is_prim(node* t, prim.prim_kind k) bool {
    return t->kind == type_kind.k_prim && t->prim == k;
}

// The scalar rows of the matrix: integers, floats, bool, char and enums.
fn scalar_cast_allowed(node* dst, node* src) bool {
    bool src_int = type_is_int(src);
    bool dst_int = type_is_int(dst);
    bool src_num = src_int || type_is_float(src);
    bool dst_num = dst_int || type_is_float(dst);
    if (src_num && dst_num) {
        // widening, narrowing, sign change, rounding, saturation
        return true;
    }
    if (dst_int) {
        // `bool` gives 0 or 1. `char` gives its byte.
        return is_prim(src, prim.prim_kind.prim_bool) ||
               is_prim(src, prim.prim_kind.prim_char) || src->kind == type_kind.k_enum;
    }
    if (src_int) {
        return is_prim(dst, prim.prim_kind.prim_char) || dst->kind == type_kind.k_enum;
    }
    // go through an integer
    return false;
}

// Whether `src` loses `own` below a reference that `dst` still owns. Such a cast
// would leave inner objects without an owner and is not allowed.
fn own_orphaned(node* dst, node* src, bool outer_own) bool {
    node* mut d = dst;
    node* mut s = src;
    bool mut outer = outer_own;
    while (d->kind == type_kind.k_array || type_is_reference(d)) {
        if (d->kind == type_kind.k_array) {
            d = d->elem;
            s = s->elem;
            continue;
        }
        if (s->is_own && !d->is_own && outer) {
            return true;
        }
        outer = outer || d->is_own;
        if (d->elem == null) {
            return false; // `string`: no reference behind it
        }
        d = d->elem;
        s = s->elem;
    }
    return false;
}

// Applies the span row of the cast matrix. Spans must have the same element
// type. Their marks can differ only by dropped mutability at any level.
// The matrix lets ownership marks change at any reference, and `check_cast`
// refuses an added `own` (D3.14). Function parameter and result marks are part
// of element identity. Thus,
// A span of `fn (node mut*) void` does not cast to a span of `fn (node*) void`.
// The drop alone is this row's work. `type_cast_adds_mut` already refused every
// span whose marks add one.
fn span_cast_allowed(node* dst, node* src) bool {
    return type_same_shape(dst, src) && !own_orphaned(dst, src, false);
}

// Whether `t` marks any level `mut`, at this position or below it. A fixed
// array shares the storage of its elements and adds no level of its own.
fn marks_mut(node* t) bool {
    if (t->kind == type_kind.k_array) {
        return marks_mut(t->elem);
    }
    if (!type_is_reference(t)) {
        return false;
    }
    if (t->is_mut) {
        return true;
    }
    if (t->elem == null) {
        // `string`: no level behind it, and none of its own
        return false;
    }
    return marks_mut(t->elem);
}

/// Tests whether a cast from `src` to `dst` adds `mut` at any storage level.
/// A destination can mark a level mutable only when the source marks that level mutable.
/// A destination cannot add mutable levels where the source has no matching level.
fn type_cast_adds_mut(node* dst, node* src) bool {
    if (dst->kind == type_kind.k_array) {
        // the array adds no level, so the two chains stay in step
        if (src->kind == type_kind.k_array) {
            return type_cast_adds_mut(dst->elem, src->elem);
        }
        return marks_mut(dst);
    }
    if (!type_is_reference(dst)) {
        // No level of the target stands here, so nothing can be added to it.
        return false;
    }
    if (!type_is_reference(src)) {
        // The source has no level at this depth: an integer, a `void`, a
        // struct or a function pointer promises nothing about this storage.
        return marks_mut(dst);
    }
    if (dst->is_mut && !src->is_mut) {
        return true;
    }
    if (dst->elem == null) {
        // The target is a `string`: no level behind it.
        return false;
    }
    if (src->elem == null) {
        // The source is a `string`, whose bytes are immutable and behind which
        // no level stands.
        return marks_mut(dst->elem);
    }
    return type_cast_adds_mut(dst->elem, src->elem);
}

// Whether `t` marks any level `own`, at this position or below it. A fixed
// array adds no level of its own.
fn marks_own(node* t) bool {
    if (t->kind == type_kind.k_array) {
        return marks_own(t->elem);
    }
    if (!type_is_reference(t)) {
        return false;
    }
    if (t->is_own) {
        return true;
    }
    if (t->elem == null) {
        // `string`: no level behind it
        return false;
    }
    return marks_own(t->elem);
}

/// Tests whether a cast from `src` to `dst` adds `own` at any level (D3.14).
/// A destination can mark a level `own` only when the source marks that level `own`.
/// A destination cannot add `own` levels where the source has no matching level.
/// The matrix of `type_cast_allowed` admits such a cast; `check_cast` refuses it.
fn type_cast_adds_own(node* dst, node* src) bool {
    if (dst->kind == type_kind.k_array) {
        // the array adds no level, so the two chains stay in step
        if (src->kind == type_kind.k_array) {
            return type_cast_adds_own(dst->elem, src->elem);
        }
        return marks_own(dst);
    }
    if (!type_is_reference(dst)) {
        // No level of the target stands here, so nothing can be added to it.
        return false;
    }
    if (!type_is_reference(src)) {
        // The source has no level at this depth: an integer, a `void`, a
        // struct or a function pointer owns nothing.
        return marks_own(dst);
    }
    if (dst->is_own && !src->is_own) {
        return true;
    }
    if (dst->elem == null) {
        // The target is a `string`: no level behind it.
        return false;
    }
    if (src->elem == null) {
        // The source is a `string`, behind which no level stands.
        return marks_own(dst->elem);
    }
    return type_cast_adds_own(dst->elem, src->elem);
}

// `t` with every `mut` cleared, at every level a mark stands on. A function
// type comes back as it is, because the marks of its parameters and of its
// result are part of its identity. The checker retries a refused cast with this
// type. This distinguishes a `mut` failure from an element-type failure.
fn type_without_mut(table mut* tt, node* t) node* {
    if (t->kind == type_kind.k_ptr) {
        return type_ptr(tt, type_without_mut(tt, t->elem), t->is_own, false);
    }
    if (t->kind == type_kind.k_voidptr) {
        return type_voidptr(tt, t->is_own, false);
    }
    if (t->kind == type_kind.k_span) {
        return type_span(tt, type_without_mut(tt, t->elem), t->is_own, false);
    }
    if (t->kind == type_kind.k_array) {
        // the array holds no mark of its own
        return type_array(tt, type_without_mut(tt, t->elem), t->len);
    }
    return t;
}

/// Tests the cast matrix for two types.
/// The checker handles value category, `move`, and binding-level `mut` rules.
/// The matrix admits casts that add `own`. `check_cast` refuses them after this check (D3.14),
/// so a caller must not trust the matrix alone.
fn type_cast_allowed(node* dst, node* src) bool {
    if (dst->kind == type_kind.k_error || src->kind == type_kind.k_error) {
        return true;
    }
    if (src->kind == type_kind.k_null || dst->kind == type_kind.k_null ||
        dst->kind == type_kind.k_void || src->kind == type_kind.k_void) {
        return false;
    }
    if (type_equal(dst, src)) {
        return true;
    }
    // Any conversion that only drops mutability or ownership is a cast too, a no-op
    // the implicit rules already cover. This is the only way a fixed array or a
    // struct converts at all: every other row that names them is an error.
    if (type_assignable(dst, src)) {
        return true;
    }
    // One rule over every row below: a cast never adds `mut`, from any source.
    // `void*`, `u64` and `string` are sources like the rest, so
    // `cast(cast(p, void*), u8 mut*)` fails here at the second cast.
    if (type_cast_adds_mut(dst, src)) {
        return false;
    }
    if (type_is_scalar(src) && type_is_scalar(dst)) {
        return scalar_cast_allowed(dst, src);
    }
    if (is_ptr_like(src)) {
        // A pointer converts to another pointer or to `u64`.
        // A function pointer converts only through `void*`.
        return is_ptr_like(dst) || is_u64(dst) ||
               (src->kind == type_kind.k_voidptr && dst->kind == type_kind.k_fn);
    }
    if (is_u64(src)) {
        // an address comes back from `u64` alone
        return is_ptr_like(dst);
    }
    if (src->kind == type_kind.k_fn) {
        // not even another function type
        return dst->kind == type_kind.k_voidptr;
    }
    if (string_family(src) && string_family(dst)) {
        return true;
    }
    if (src->kind == type_kind.k_span && dst->kind == type_kind.k_span) {
        return span_cast_allowed(dst, src);
    }
    return false;
}

// ---- sizes and layout ----------------------------------------------------------

// `v` rounded up to a multiple of `align` in `*out`; false when the result
// would exceed TYPE_MAX_SIZE.
fn round_up(u64 v, u64 align, u64 mut* out) bool {
    if (align == 0) {
        panic("types.round_up: alignment 0");
    }
    u64 rem = v % align;
    if (rem != 0 && v > TYPE_MAX_SIZE - (align - rem)) {
        return false;
    }
    if (rem == 0) {
        *out = v;
    } else {
        *out = v + (align - rem);
    }
    return true;
}

fn layout_of(node* s) layout mut* {
    if (s->kind != type_kind.k_struct) {
        panic("types: layout of a non-struct");
    }
    return s->layout;
}

// The layout of a struct for sizeof and alignof: resolved or in error.
fn laid_out(node* s) layout* {
    layout* l = layout_of(s);
    if (l->state != layout_state.l_resolved && l->state != layout_state.l_error) {
        panic("types: sizeof of a struct without layout");
    }
    return l;
}

// `len * sizeof(elem)` in `*out`; false when the product would exceed
// TYPE_MAX_SIZE.
fn array_size(node* t, u64 mut* out) bool {
    u64 mut elem = 0;
    if (!size_checked(t->elem, &elem)) {
        return false;
    }
    if (elem != 0 && t->len > TYPE_MAX_SIZE / elem) {
        return false;
    }
    *out = t->len * elem;
    return true;
}

// The size of `t` in `*out`; false when it would exceed TYPE_MAX_SIZE. Every
// size the compiler computes goes through here, so no size arithmetic can wrap.
fn size_checked(node* t, u64 mut* out) bool {
    switch (t->kind) {
    case type_kind.k_void, type_kind.k_null:
        panic("types: sizeof of void or null");
    case type_kind.k_error:
        *out = 0;
        return true;
    case type_kind.k_prim:
        *out = cast(prim.prim_size(t->prim), u64);
        return true;
    case type_kind.k_ptr, type_kind.k_voidptr, type_kind.k_fn:
        *out = PTR_SIZE;
        return true;
    case type_kind.k_span, type_kind.k_string:
        // the fat pointer `{ptr, len}`
        *out = SPAN_SIZE;
        return true;
    case type_kind.k_array:
        // elements are contiguous
        return array_size(t, out);
    case type_kind.k_enum:
        *out = ENUM_SIZE;
        return true;
    case type_kind.k_struct:
        // The layout enforced the ceiling when it laid the struct out.
        *out = laid_out(t)->size;
        return true;
    }
    panic("types.size_checked: unknown type kind");
}

// Whether the size of `t` fits the largest object the compiler admits, 2^63 -
// 1 bytes.
fn type_size_fits(node* t) bool {
    u64 mut size = 0;
    return size_checked(t, &size);
}

// Size in bytes. A struct must be resolved or in error (0 and 1); void and the
// null type are broken preconditions; the error type is 0. `type_sizeof` of a
// type type_size_fits refuses is a broken precondition too, so the caller asks
// first.
fn type_sizeof(node* t) u64 {
    u64 mut size = 0;
    if (!size_checked(t, &size)) {
        panic("types.type_sizeof: sizeof of a type that is too large");
    }
    return size;
}

// Alignment in bytes; it equals the size for every primitive.
fn type_alignof(node* t) u64 {
    switch (t->kind) {
    case type_kind.k_void, type_kind.k_null:
        panic("types.type_alignof: alignof of void or null");
    case type_kind.k_error:
        return 1;
    case type_kind.k_prim:
        return cast(prim.prim_size(t->prim), u64);
    case type_kind.k_ptr, type_kind.k_voidptr, type_kind.k_fn, type_kind.k_span,
         type_kind.k_string:
        return PTR_ALIGN;
    case type_kind.k_array:
        return type_alignof(t->elem);
    case type_kind.k_enum:
        return ENUM_SIZE;
    case type_kind.k_struct:
        return laid_out(t)->align;
    }
    panic("types.type_alignof: unknown type kind");
}

/// Returns the current layout state of a struct.
/// Callers begin a layout, resolve pending field layouts, and then complete the layout.
/// A failed begin identifies a value-containment cycle.
fn type_layout_state(node* s) layout_state {
    return layout_of(s)->state;
}

/// Unresolved to resolving: true. Resolving: false, a cycle. Resolved and in
/// error are broken preconditions.
fn type_layout_begin(node* s) bool {
    layout mut* l = layout_of(s);
    if (l->state == layout_state.l_unresolved) {
        l->state = layout_state.l_resolving;
        return true;
    }
    if (l->state == layout_state.l_resolving) {
        return false;
    }
    panic("types.type_layout_begin: layout begun twice");
}

/// Marks a struct in error from any state.
fn type_layout_fail(node* s) void {
    layout mut* l = layout_of(s);
    l->state = layout_state.l_error;
    l->size = 0;
    l->align = 1;
    l->owning = false;
}

/// Returns the unresolved struct needed to compute `sizeof(t)`.
/// It looks through fixed arrays and returns null when no layout is pending.
fn type_layout_pending(node* t) node* {
    node* cur = behind_arrays(t);
    if (cur->kind != type_kind.k_struct) {
        return null;
    }
    layout_state st = cur->layout->state;
    if (st == layout_state.l_resolved || st == layout_state.l_error) {
        return null;
    }
    return cur;
}

/// Lays out fields in C/System V order and writes one offset per field.
/// The struct must be unresolved or resolving. Fields must be nonempty and have no pending layout.
/// `offsets` must have at least one slot per field.
/// Returns false and marks the struct in error when its size exceeds 2^63 - 1 bytes.
fn type_layout_struct(node* s, node*@ fields, u64 mut@ offsets) bool {
    layout mut* l = layout_of(s);
    if (l->state == layout_state.l_resolved || l->state == layout_state.l_error) {
        panic("types.type_layout_struct: layout of a struct twice");
    }
    if (fields.len == 0) {
        panic("types.type_layout_struct: layout of an empty struct");
    }
    // The C implementation cannot see the caller's offset capacity. This span
    // carries its length. A short span therefore breaks the precondition instead
    // of storing past its end.
    if (offsets.len < fields.len) {
        panic("types.type_layout_struct: too few offset slots");
    }
    u64 mut off = 0;
    u64 mut align = 1;
    bool mut owning = false;
    u64 mut i = 0;
    while (i < fields.len) {
        node* f = fields[i];
        if (type_layout_pending(f) != null) {
            panic("types.type_layout_struct: layout with a pending field");
        }
        // each field at the next multiple of its alignment
        // a field or a total past the ceiling is too large
        u64 mut size = 0;
        u64 a = type_alignof(f);
        if (!size_checked(f, &size) || !round_up(off, a, &off) || off > TYPE_MAX_SIZE - size) {
            type_layout_fail(s);
            return false;
        }
        offsets[i] = off;
        off += size;
        if (a > align) {
            align = a;
        }
        // an `own` field makes the struct an owning aggregate
        if ((type_is_reference(f) && f->is_own) || type_is_owning_aggregate(f)) {
            owning = true;
        }
        i += 1;
    }
    // rounded up to the alignment, as C lays the same struct out
    if (!round_up(off, align, &l->size)) {
        type_layout_fail(s);
        return false;
    }
    l->align = align;
    l->owning = owning;
    l->state = layout_state.l_resolved;
    return true;
}

// ---- spelling ------------------------------------------------------------------

// Holds suffixes from the outermost inward, followed by the base. The groups are
// references, fixed arrays, and trailing references. Each group can be empty.
// A chain with an array after a trailing reference cannot be written directly.
// Collection stops there and puts the remaining type in parentheses.
struct spine {
    node*[SPINE_MAX] nodes;
    u64 n;
    u64 first_array; // the array group is [first_array, end_array)
    u64 end_array;
    node* base;
    bool paren;
}

fn is_array_node(node* t) bool {
    return t->kind == type_kind.k_array;
}

// A `*` or `@` suffix: the two that introduce a reference.
fn is_ref_node(node* t) bool {
    return t->kind == type_kind.k_ptr || t->kind == type_kind.k_voidptr ||
           t->kind == type_kind.k_span;
}

fn spine_collect(spine mut* sp, node* t) void {
    bool mut seen_array = false;
    bool mut seen_ref_after_array = false;
    node* mut cur = t;
    sp->n = 0;
    // an array behind a reference behind an array needs a group: `(i32[4])*[2]`
    while (sp->n < SPINE_MAX) {
        if (is_array_node(cur)) {
            if (seen_ref_after_array) {
                break;
            }
            seen_array = true;
        } else if (is_ref_node(cur)) {
            seen_ref_after_array = seen_ref_after_array || seen_array;
        } else {
            break;
        }
        sp->nodes[sp->n] = cur;
        sp->n += 1;
        cur = cur->elem;
    }
    sp->base = cur;
    sp->paren = is_array_node(cur) || is_ref_node(cur);
    sp->first_array = sp->n;
    sp->end_array = 0;
    u64 mut i = 0;
    while (i < sp->n) {
        if (is_array_node(sp->nodes[i])) {
            if (sp->first_array == sp->n) {
                sp->first_array = i;
            }
            sp->end_array = i + 1;
        }
        i += 1;
    }
    if (sp->first_array == sp->n) {
        sp->first_array = 0;
        sp->end_array = 0;
    }
}

fn spell_base(node* t, strbuf.str_buf mut* out) void {
    switch (t->kind) {
    case type_kind.k_void:
        strbuf.append(out, "void");
        return;
    case type_kind.k_prim:
        strbuf.append(out, prim.prim_name(t->prim));
        return;
    case type_kind.k_string:
        strbuf.append(out, "string");
        return;
    case type_kind.k_struct, type_kind.k_enum:
        strbuf.append(out, t->name);
        return;
    case type_kind.k_null:
        strbuf.append(out, "null");
        return;
    case type_kind.k_error:
        strbuf.append(out, "<error>");
        return;
    case type_kind.k_fn:
        // the result comes last, as it does in a declaration
        strbuf.append(out, "fn (");
        u64 mut i = 0;
        while (i < t->params.len) {
            if (i > 0) {
                strbuf.append(out, ", ");
            }
            node* p = t->params[i];
            spell(p, false, out);
            i += 1;
        }
        strbuf.append(out, ") ");
        if (t->is_noreturn) {
            strbuf.append(out, "noreturn");
        } else {
            spell(t->elem, false, out);
        }
        return;
    case type_kind.k_ptr, type_kind.k_voidptr, type_kind.k_array, type_kind.k_span:
        break;
    }
    panic("types.spell_base: spelling a reference as a base");
}

// Returns the mutability of storage for the node at `i`. The first outer
// reference reaches that storage. Fixed arrays between them share storage with
// their elements. Without an outer reference, level 0 holds it.
fn holder_mut(spine* sp, u64 i, bool mut0) bool {
    u64 mut j = i;
    while (j > 0) {
        if (is_ref_node(sp->nodes[j - 1])) {
            return sp->nodes[j - 1]->is_mut;
        }
        j -= 1;
    }
    return mut0;
}

// One suffix with the markers of its position: `own` for a reference that owns
// its target, `mut` for the storage the suffix's own value occupies. A reference
// held by a fixed array prints no `mut`. A non-final array in its group also
// prints no `mut`. They share storage, whose marker follows the final length.
fn spell_suffix(spine* sp, u64 i, bool mut0, strbuf.str_buf mut* out) void {
    node* t = sp->nodes[i];
    if (is_array_node(t)) {
        strbuf.push(out, '[');
        strbuf.append_u64(out, t->len);
        strbuf.push(out, ']');
        if (i + 1 == sp->end_array && holder_mut(sp, i, mut0)) {
            strbuf.append(out, " mut");
        }
        return;
    }
    if (t->kind == type_kind.k_span) {
        strbuf.append(out, "@");
    } else {
        strbuf.append(out, "*");
    }
    if (t->is_own) {
        strbuf.append(out, " own");
    }
    bool held_by_array = i > 0 && is_array_node(sp->nodes[i - 1]);
    if (!held_by_array && holder_mut(sp, i, mut0)) {
        strbuf.append(out, " mut");
    }
}

// Writes suffixes in source order. It writes the base reference group
// innermost first. It writes arrays outermost first. It then writes trailing
// references innermost first.
fn spell_suffixes(spine* sp, bool mut0, strbuf.str_buf mut* out) void {
    u64 mut i = sp->n;
    while (i > sp->end_array) {
        spell_suffix(sp, i - 1, mut0, out);
        i -= 1;
    }
    i = sp->first_array;
    while (i < sp->end_array) {
        spell_suffix(sp, i, mut0, out);
        i += 1;
    }
    i = sp->first_array;
    while (i > 0) {
        spell_suffix(sp, i - 1, mut0, out);
        i -= 1;
    }
}

fn spell(node* t, bool mut0, strbuf.str_buf mut* out) void {
    spine mut sp = spine{};
    spine_collect(&sp, t);
    // The base position stores base-type values. The innermost reference reaches
    // it. The binding stores it when the type has no suffix.
    // An array between them takes the marker.
    bool mut base_mut = mut0;
    if (sp.n != 0) {
        base_mut = is_ref_node(sp.nodes[sp.n - 1]) && sp.nodes[sp.n - 1]->is_mut;
    }
    if (sp.paren) {
        strbuf.push(out, '(');
        spell(sp.base, base_mut, out);
        strbuf.push(out, ')');
    } else {
        bool group_fn = sp.base->kind == type_kind.k_fn && (sp.n != 0 || base_mut);
        if (group_fn) {
            strbuf.push(out, '(');
        }
        spell_base(sp.base, out);
        if (group_fn) {
            strbuf.push(out, ')');
        }
        // `string` takes `own` after the base type
        if (sp.base->kind == type_kind.k_string && sp.base->is_own) {
            strbuf.append(out, " own");
        }
        if (base_mut) {
            strbuf.append(out, " mut");
        }
    }
    spell_suffixes(&sp, mut0, out);
}

/// Appends the canonical type spelling without the binding position.
/// It adds parentheses only when an array suffix follows a trailing reference suffix.
fn type_to_str(node* t, strbuf.str_buf mut* out) void {
    spell(t, false, out);
}

/// Appends the spelling of a declaration's type with the binding's position, the
/// last one: `node* mut`, `u8@* mut`, `i32[4] mut`, `string own mut`. Level 0 is a
/// position like any other, so this is type_to_str with the last marker written.
fn type_to_str_decl(node* t, bool mut0, strbuf.str_buf mut* out) void {
    spell(t, mut0, out);
}

// ---- builder -------------------------------------------------------------------

/// One suffix of `base [own] [mut] { suffix [own] [mut] }` in source order,
/// with the `own` and `mut` written right after it. An array suffix carries no
/// `own`.
enum suffix_kind {
    s_ptr, // `*`, a reference suffix
    s_array, // `[N]`
    s_span, // `@`, a reference suffix
}

/// Describes one type suffix and its markers.
struct suffix {
    suffix_kind kind;
    u64 len; // s_array
    bool is_own;
    bool is_mut;
}

/// Holds the result of `type_build`.
/// `built` is null after invalid input, and `error` then gives the reason.
struct build_result {
    node* built;
    bool mut0; // level 0 of the declaration
    string error;
}

fn build_error(string msg) build_result {
    return build_result{null, false, msg};
}

// A `*` or `@` suffix, the two that introduce a reference.
fn suffix_is_ref(suffix* s) bool {
    return s->kind == suffix_kind.s_ptr || s->kind == suffix_kind.s_span;
}

// Splits a suffix list into three groups. [0, e) holds base references. [e, a)
// holds fixed arrays. [a, n) holds whole-array references.
struct groups {
    u64 e;
    u64 a;
    u64 n;
}

fn split_groups(suffix@ s, groups mut* g) bool {
    u64 mut i = 0;
    while (i < s.len && suffix_is_ref(&s[i])) {
        i += 1;
    }
    g->e = i;
    while (i < s.len && s[i].kind == suffix_kind.s_array) {
        i += 1;
    }
    g->a = i;
    while (i < s.len && suffix_is_ref(&s[i])) {
        i += 1;
    }
    g->n = s.len;
    return i == s.len;
}

// Returns the index of applied suffix k, innermost first. Reference groups apply
// in source order because they read inside-out. The array group applies in
// reverse because it reads outside-in.
fn apply_order(groups* g, u64 k) u64 {
    if (k >= g->e && k < g->a) {
        return g->a - 1 - (k - g->e);
    }
    return k;
}

// The markers of every position, before anything is built, as a message or "".
// A position marks storage for the item it follows. A fixed array shares storage
// with its elements. Thus, `mut` for that storage follows the array length.
fn check_positions(node* base, bool base_own, bool base_mut, suffix@ s) string {
    // `void` is a return type or pointer base. It accepts only the `mut` in
    // `void mut*`, which marks reached storage. `void mut`, `void own`, `void@` and `void[4]` name
    // no storage at all.
    if (base->kind == type_kind.k_void) {
        bool base_of_ptr = s.len > 0 && s[0].kind == suffix_kind.s_ptr;
        if (base_own || ((base_mut || s.len > 0) && !base_of_ptr)) {
            return "'void' is only a return type or the base of 'void*'";
        }
    }
    if (base_own && base->kind != type_kind.k_string) {
        return "'own' marks a reference: write it after a '*' or an '@'";
    }
    if (base_own && base->is_own) {
        // No source can write it: a base type is never an owned one.
        panic("types.check_positions: own on a base type that is already owned");
    }
    if (base_mut && s.len > 0 && s[0].kind == suffix_kind.s_array) {
        return "mark the array after its length";
    }
    u64 mut i = 0;
    while (i < s.len) {
        if (s[i].kind == suffix_kind.s_array) {
            if (s[i].len == 0) {
                return "array length must be greater than 0";
            }
            if (s[i].is_own) {
                return "'own' never follows a fixed-array suffix";
            }
        }
        if (s[i].is_mut && i + 1 < s.len && s[i + 1].kind == suffix_kind.s_array) {
            return "mark the array after its length";
        }
        i += 1;
    }
    return "";
}

/// Builds a type from a base, base markers, and source-order suffixes.
/// Reference groups apply inside-out. The fixed-array group applies outside-in.
/// Each `mut` marks the storage of the preceding type element. The final mark becomes `mut0`.
/// Each `own` marks its preceding reference, or a base string.
///
/// Invalid marker positions, zero array lengths, and suffixes after trailing references fail.
/// Void builds only a return type or the base of `void*`. An error base poisons the result.
/// The checker enforces placement rules that depend on the declaration context.
fn type_build(table mut* tt, bool base_own, bool base_mut, node* base,
                           suffix@ suffixes) build_result {
    if (base->kind == type_kind.k_error) {
        // The base already failed: poison the result rather than report a
        // second diagnostic about its markers.
        bool mut poisoned_mut0 = base_mut;
        if (suffixes.len != 0) {
            poisoned_mut0 = suffixes[suffixes.len - 1].is_mut;
        }
        return build_result{base, poisoned_mut0, ""};
    }
    groups mut g = groups{};
    if (!split_groups(suffixes, &g)) {
        return build_error("no array suffix may follow a trailing reference suffix");
    }
    string bad = check_positions(base, base_own, base_mut, suffixes);
    if (bad != "") {
        return build_error(bad);
    }
    // Build innermost first. A position's `mut` marks storage for the item it
    // follows. The next outer reference reaches that storage. Without an outer
    // reference, the binding holds it. A fixed array shares the storage with its
    // elements and adds no level.
    node* mut t = base;
    if (base_own) {
        t = type_string(tt, true);
    }
    bool mut pending_mut = base_mut;
    u64 mut k = 0;
    while (k < suffixes.len) {
        u64 at = apply_order(&g, k);
        if (suffixes[at].kind == suffix_kind.s_array) {
            t = type_array(tt, t, suffixes[at].len);
            pending_mut = pending_mut || suffixes[at].is_mut;
            k += 1;
            continue;
        }
        if (suffixes[at].kind == suffix_kind.s_span) {
            t = type_span(tt, t, suffixes[at].is_own, pending_mut);
        } else if (t->kind == type_kind.k_void) {
            t = type_voidptr(tt, suffixes[at].is_own, pending_mut);
        } else {
            t = type_ptr(tt, t, suffixes[at].is_own, pending_mut);
        }
        pending_mut = suffixes[at].is_mut;
        k += 1;
    }
    return build_result{t, pending_mut, ""};
}
