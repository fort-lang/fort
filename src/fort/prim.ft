// prim: the primitive types of D3.1 -- `i8 i16 i32 i64 u8 u16 u32 u64 f32 f64
// bool char void` -- as a kind enum shared by the constant folder (consts.ft)
// and the type representation (types.ft). Sizes and alignments are those of
// D3.1 and type-system.md 11.1: alignment equals size for every primitive.
//
// src/bootstrap/prim.h is header-only, an enum and five one-line queries, so
// that every module can name a primitive without depending on the type
// representation. fort has no headers, so the same thing is a module of its
// own rather than a part of types.ft, which keeps that layering: consts.ft
// imports prim and knows nothing of the type table.
//
// Names: the enum members carry the `prim_` prefix of the C constants because
// eleven of the thirteen names they would otherwise take -- `i8`, `bool`,
// `void` -- are keywords and cannot be identifiers (D2.4). The functions keep
// their C names for the same reason the whole port does: the module answers to
// src/bootstrap/prim.h and a reader compares the two by name.
//
// Re-entrancy (D20.5): nothing here is state at all, module-level or
// otherwise. Every function is a query over its argument.
//
// Dispatch: none. prim_size and prim_name are the switches the C wrote, not a
// table of function pointers (D3.10).

// The primitive kinds. prim_is_integer and prim_is_signed are range tests over
// this order, so the signed kinds come first and the unsigned ones close the
// integers; types_test.ft holds that order, which is the C's _Static_assert in
// the one form fort has for it.
enum prim_kind {
    prim_i8,
    prim_i16,
    prim_i32,
    prim_i64,
    prim_u8,
    prim_u16,
    prim_u32,
    prim_u64,
    prim_bool,
    prim_char,
    // f32 and f64 are never produced by the bootstrap compiler (T-041).
    prim_f32,
    prim_f64,
    prim_void,
}

// One past the last kind, for tables indexed by a prim_kind (D1.4: a module
// constant is UPPER_CASE). The C reads it off the enum, which fort cannot do,
// so types_test.ft holds it against prim_void.
u64 PRIM_COUNT = 13;

// The bit width of an integer is prim_size times this.
u64 PRIM_BITS_PER_BYTE = 8;

// The ordinal of a kind: D3.9 gives an enum no ordering operators, so the two
// range tests below compare the `i32` a cast yields instead, which is the same
// comparison the C makes on the enum itself.
fn i32 prim_ord(prim_kind k) {
    return cast(k, i32);
}

// Whether `k` is one of i8..u64. `bool` and `char` are not integers (D3.2,
// D3.3).
fn bool prim_is_integer(prim_kind k) {
    return prim_ord(k) <= prim_ord(prim_kind.prim_u64);
}

// Whether `k` is one of i8..i64.
fn bool prim_is_signed(prim_kind k) {
    return prim_ord(k) <= prim_ord(prim_kind.prim_i64);
}

// Whether `k` is f32 or f64.
fn bool prim_is_float(prim_kind k) {
    return k == prim_kind.prim_f32 || k == prim_kind.prim_f64;
}

// The size in bytes (D3.1); the alignment is the same; 0 for `void`.
fn u32 prim_size(prim_kind k) {
    switch (k) {
    case prim_kind.prim_i8, prim_kind.prim_u8, prim_kind.prim_bool, prim_kind.prim_char:
        return 1;
    case prim_kind.prim_i16, prim_kind.prim_u16:
        return 2;
    case prim_kind.prim_i32, prim_kind.prim_u32, prim_kind.prim_f32:
        return 4;
    case prim_kind.prim_i64, prim_kind.prim_u64, prim_kind.prim_f64:
        return 8;
    case prim_kind.prim_void:
        return 0;
    }
    return 0;
}

// The spelling of the type in source and in diagnostics.
fn string prim_name(prim_kind k) {
    switch (k) {
    case prim_kind.prim_i8:
        return "i8";
    case prim_kind.prim_i16:
        return "i16";
    case prim_kind.prim_i32:
        return "i32";
    case prim_kind.prim_i64:
        return "i64";
    case prim_kind.prim_u8:
        return "u8";
    case prim_kind.prim_u16:
        return "u16";
    case prim_kind.prim_u32:
        return "u32";
    case prim_kind.prim_u64:
        return "u64";
    case prim_kind.prim_f32:
        return "f32";
    case prim_kind.prim_f64:
        return "f64";
    case prim_kind.prim_bool:
        return "bool";
    case prim_kind.prim_char:
        return "char";
    case prim_kind.prim_void:
        return "void";
    }
    return "?";
}
