/// Defines primitive kinds, sizes, and source names.
///
/// Signed integers come before unsigned integers in `prim_kind`.
/// Range tests depend on this order.
///
enum prim_kind {
    prim_i8,
    prim_i16,
    prim_i32,
    prim_i64,
    prim_u8,
    prim_u16,
    prim_u32,
    prim_u64,
    prim_bool,
    prim_char,
    // f32 and f64 are never produced by the bootstrap compiler
    prim_f32,
    prim_f64,
    prim_void,
}

// One past the last kind, for tables indexed by a prim_kind. The C reads it off
// the enum, which fort cannot do, so types_test.ft holds it against prim_void.
u64 PRIM_COUNT = 13;

// The bit width of an integer is prim_size times this.
u64 PRIM_BITS_PER_BYTE = 8;

// Returns the ordinal of a kind. Enums have no ordering operators. The range
// tests below compare the `i32` from this cast. This matches the C enum
// comparison.
fn prim_ord(prim_kind k) i32 {
    return cast(k, i32);
}

// Whether `k` is one of i8..u64. `bool` and `char` are not integers.
fn prim_is_integer(prim_kind k) bool {
    return prim_ord(k) <= prim_ord(prim_kind.prim_u64);
}

fn prim_is_signed(prim_kind k) bool {
    return prim_ord(k) <= prim_ord(prim_kind.prim_i64);
}

fn prim_is_float(prim_kind k) bool {
    return k == prim_kind.prim_f32 || k == prim_kind.prim_f64;
}

/// The size in bytes; the alignment is the same; 0 for `void`.
fn prim_size(prim_kind k) u32 {
    switch (k) {
    case prim_kind.prim_i8, prim_kind.prim_u8, prim_kind.prim_bool, prim_kind.prim_char:
        return 1;
    case prim_kind.prim_i16, prim_kind.prim_u16:
        return 2;
    case prim_kind.prim_i32, prim_kind.prim_u32, prim_kind.prim_f32:
        return 4;
    case prim_kind.prim_i64, prim_kind.prim_u64, prim_kind.prim_f64:
        return 8;
    case prim_kind.prim_void:
        return 0;
    }
    return 0;
}

/// The spelling of the type in source and in diagnostics.
fn prim_name(prim_kind k) string {
    switch (k) {
    case prim_kind.prim_i8:
        return "i8";
    case prim_kind.prim_i16:
        return "i16";
    case prim_kind.prim_i32:
        return "i32";
    case prim_kind.prim_i64:
        return "i64";
    case prim_kind.prim_u8:
        return "u8";
    case prim_kind.prim_u16:
        return "u16";
    case prim_kind.prim_u32:
        return "u32";
    case prim_kind.prim_u64:
        return "u64";
    case prim_kind.prim_f32:
        return "f32";
    case prim_kind.prim_f64:
        return "f64";
    case prim_kind.prim_bool:
        return "bool";
    case prim_kind.prim_char:
        return "char";
    case prim_kind.prim_void:
        return "void";
    }
    return "?";
}
