// The entry point of the self-hosted compiler (toolchain.md 1).
//
// main is the one place an exit belongs: every module below it reports,
// returns a status and ends nothing, so a language server can call the same
// code in its own process. src/bootstrap/main.c is these eight lines around
// driver_main and this is the same file.
// D20.5, D14.1
import driver;
import std.sys;

fn i32 main(string@ args) {
    return driver.run(args);
}
