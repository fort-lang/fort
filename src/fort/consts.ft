// consts: compile-time constant values and exact folding (type-system.md 10),
// the transliteration of src/bootstrap/consts.h and .c.
// D4
//
// An untyped integer constant is an exact integer in [-2^63, 2^64 - 1], held
// as a sign and a 64-bit magnitude: `neg` implies 1 <= mag <= 2^63, and zero
// is never negative. Every operation computes the exact result and reports a
// result outside that range, or a division by zero, by returning false; the
// caller turns that into the compile error. Nothing here wraps unless the
// operation is a `cast` or a wrapping operator.
// D4.4, D3.14, D11.2
//
// A float constant is the binary64 bit pattern of a finite value, held and
// computed on by flt.ft, since the compiler's own source has no float type.
// Every float constant is finite: one that is not is an error, so each
// fold below answers false where the exact result leaves the format and the
// checker reports it. An f32 constant holds the binary64 of its binary32
// value, which that format holds exactly.
//
// The other kinds are the remaining constants: `bool`, a char literal
// (a code point 0..255 whose default type is `char`), `null`, a string literal
// (a view of its decoded bytes) and "none", the value of an expression that is
// not constant.
// D4.3
//
// Bitwise `& | ^` on untyped integers: the operands are taken as
// two's-complement bit patterns with infinite sign extension, that is the
// mathematical bitwise operation on integers as in Go, and the result must lie
// in the constant range. It agrees with `~c` being `-c - 1`: `-1 & x` is `x`,
// `-1 | x` is `-1`, `-1 ^ 0xFFFFFFFFFFFFFFFF` is `-2^64` and hence an error;
// only `^` can leave the range.
// D4.4
//
// Two families of operations:
// - untyped folding (cv_add ... cv_shr, cv_compare): exact.
// D4.4
//
// - typed folding (cv_typed_*, cv_wrap_*): the operands already have the
//   integer type `t`, every operand fits it, and the result must fit it too
//   or the operation is a compile error (`i32 A = 2147483647; A + 1` is an
//   error, not a trap), except that `cast`, the wrapping operators and `<<`
//   wrap exactly as at run time.
// D3.14, D4.6, D6.2, D11.2
//
// Arithmetic. The C computes on unsigned magnitudes and detects an overflow
// with __builtin_add_overflow and __builtin_mul_overflow, which fort does not
// have; each of the three sites tests the operands before it computes, since
// in fort the computation itself would trap rather than report. Where the C
// means to wrap -- the two's-complement pattern of a negative value, and the
// `+% -% *%` family -- the wrapping operators say so, so that both build
// modes agree; every other operator here is the checked one and a trap in it
// would be a bug in this file, not a program error.
// D11.1
//
// Names: the functions keep the `cv_` of their C originals so that a reader
// holds the two files against each other name by name, and the enum members
// keep the `cv_` of the C constants because `bool`, `char` and `null` are
// keywords.
// D2.4
//
// Re-entrancy: nothing here is state. A cval is a value passed and returned by
// value, no function allocates, and a violated precondition -- folding on a
// value of the wrong kind, which the checker cannot produce -- is a panic at
// the call that broke it rather than an exit in a leaf, which is what
// src/bootstrap/consts.c's fatal_internal is. A panic aborts like any other
// failure, so what it buys is a documented boundary and a stated precondition,
// not in-process recovery.
// D20.5, D13.3, D11.4
//
// Dispatch: none. The case analysis is the switches the C wrote.
// D3.10
import flt;
import prim;
import std.strbuf;

/// The magnitude of the most negative constant, 2^63.
/// D1.4: a module constant is UPPER_CASE
u64 NEG_MAX_MAG = 9223372036854775808;

/// The largest u64 there is, which the C spells UINT64_MAX.
u64 U64_MAX = 18446744073709551615;

/// The largest i64 there is, the ceiling cv_to_i64 holds a magnitude against.
u64 I64_MAX_MAG = 9223372036854775807;

/// The number of bits of a u64, the widest integer.
u64 WORD_BITS = 64;

/// The largest shift count of untyped folding (a count in `0..63`; the value
/// range has 64 magnitude bits).
/// D4.4
u64 CV_SHIFT_MAX = 63;

/// The last code point of a char literal.
/// D2.7, D2.8
u64 CV_CHAR_MAX = 255;

/// The hex digits of a `\xHH` escape in cv_to_str, and the shift and mask that
/// split a byte into two of them.
string HEX_DIGITS = "0123456789ABCDEF";
u64 HEX_SHIFT = 4;
u64 HEX_MASK = 15;
u64 ASCII_PRINT_MIN = 32;
u64 ASCII_PRINT_MAX = 126;

/// What a constant is.
/// D4.6
enum cval_kind {
    cv_none, // not a constant expression
    cv_int,  // an integer, exact in [-2^63, 2^64 - 1]
    cv_bool, // true or false
    cv_char, // a char literal: a code point 0..255
    cv_null, // the literal null
    cv_str,  // a string literal: a view of its decoded bytes
    cv_float, // D4.4: a float: the binary64 bits of a finite value
}

/// One constant value. cval{} is the none value, so a struct holding one is
/// initialized with {}.
struct cval {
    cval_kind kind;
    bool neg;    // cv_int: the value is -mag; never set when mag is 0
    u64 mag;     // cv_int: |value|; cv_char: the code point; cv_bool: 0/1
    string str;  // cv_str: the bytes
    u64 fbits;   // cv_float: the binary64 pattern of the value (flt.ft)
}

/// The comparison operators of cv_compare.
enum cv_rel {
    cv_rel_eq,
    cv_rel_ne,
    cv_rel_lt,
    cv_rel_le,
    cv_rel_gt,
    cv_rel_ge,
}

// ---- construction --------------------------------------------------------------

fn cval int_make(bool neg, u64 mag) {
    return cval{cval_kind.cv_int, neg && mag != 0, mag, "", 0};
}

/// Stores `-mag` or `mag` when it lies in the constant range, else none.
fn bool int_check(bool neg, u64 mag, cval mut* out) {
    if (neg && mag > NEG_MAX_MAG) {
        *out = cv_none();
        return false;
    }
    *out = int_make(neg, mag);
    return true;
}

/// The precondition every arithmetic function states: the checker has typed its
/// operands, so a value of another kind is a broken precondition and panics
/// where src/bootstrap/consts.c calls fatal_internal.
/// D13.3
fn void require_int(cval v) {
    if (v.kind != cval_kind.cv_int) {
        panic("consts: constant folding on a non-integer");
    }
}

fn void require_bool(cval v) {
    if (v.kind != cval_kind.cv_bool) {
        panic("consts: logical folding on a non-bool");
    }
}

fn cval cv_none() {
    return cval{cval_kind.cv_none, false, 0, "", 0};
}

fn cval cv_from_i64(i64 v) {
    if (v >= 0) {
        return int_make(false, cast(v, u64));
    }
    // -(v + 1) is representable for every negative v, the i64 minimum
    // included, so the magnitude is taken without ever negating v itself.
    return int_make(true, cast(-(v + 1), u64) + 1);
}

/// Also the constructor for an integer literal: the lexer's magnitude.
fn cval cv_from_u64(u64 v) {
    return int_make(false, v);
}

/// A char literal from the lexer's code point, at most CV_CHAR_MAX (a broken
/// precondition otherwise).
fn cval cv_from_char(u64 code) {
    if (code > CV_CHAR_MAX) {
        panic("consts.cv_from_char: char constant outside 0..255");
    }
    return cval{cval_kind.cv_char, false, code, "", 0};
}

fn cval cv_from_bool(bool b) {
    if (b) {
        return cval{cval_kind.cv_bool, false, 1, "", 0};
    }
    return cval{cval_kind.cv_bool, false, 0, "", 0};
}

fn cval cv_null() {
    return cval{cval_kind.cv_null, false, 0, "", 0};
}

/// A float constant from the text of a literal, evaluated in binary64; false
/// when the value is not finite there, which is a compile error.
/// D2.6, D4.4
fn bool cv_from_float_text(string text, cval mut* out) {
    u64 mut bits = 0;
    if (!flt.flt_parse(text, &bits)) {
        *out = cv_none();
        return false;
    }
    *out = cv_from_float(bits);
    return true;
}

/// A float constant from the binary64 pattern of a finite value; the pattern
/// of an f32 constant is the binary64 its binary32 value equals exactly.
fn cval cv_from_float(u64 bits) {
    return cval{cval_kind.cv_float, false, 0, "", bits};
}

fn cval cv_from_str(string s) {
    return cval{cval_kind.cv_str, false, 0, s, 0};
}

// ---- queries -------------------------------------------------------------------

fn bool cv_is_int(cval v) {
    return v.kind == cval_kind.cv_int;
}

fn bool cv_is_float(cval v) {
    return v.kind == cval_kind.cv_float;
}

/// The binary64 pattern of a float constant; every other kind is a broken
/// precondition, since the checker asks only where it has typed the value.
fn u64 cv_float_bits(cval v) {
    if (v.kind != cval_kind.cv_float) {
        panic("consts.cv_float_bits: the constant is not a float");
    }
    return v.fbits;
}

/// The format a float constant is folded in: binary32 for f32 and binary64 for
/// every other float context, which is also what an untyped float is evaluated
/// in.
/// D4.4
fn bool is_f32(prim.prim_kind t) {
    return t == prim.prim_kind.prim_f32;
}

/// An integer or a char: a char in an integer context is its code point.
/// D4.3
fn bool cv_is_int_like(cval v) {
    return v.kind == cval_kind.cv_int || v.kind == cval_kind.cv_char;
}

/// The exact integer of an integer or char value; every arithmetic function
/// below requires an integer operand, so the checker calls this on a char
/// first.
fn cval cv_as_int(cval v) {
    if (v.kind == cval_kind.cv_char) {
        return int_make(false, v.mag);
    }
    require_int(v);
    return v;
}

/// Whether the value is zero, which is what the division check asks of a divisor.
/// A float has two zeros and both answer true; a char is its code point, since a
/// divisor may be one (`4 / '\0'`), and every other kind is a broken
/// precondition as it is for the arithmetic.
/// D4.4, D6.12
fn bool cv_is_zero(cval v) {
    if (v.kind == cval_kind.cv_float) {
        return flt.flt_is_zero(v.fbits);
    }
    if (v.kind == cval_kind.cv_char) {
        return v.mag == 0;
    }
    require_int(v);
    return v.mag == 0;
}

/// Whether the integer is negative: a negative constant in an index, bound or
/// count position is a compile error.
/// D4.1
fn bool cv_is_neg(cval v) {
    require_int(v);
    return v.neg;
}

/// The value as an i64; false when it lies outside that range.
fn bool cv_to_i64(cval v, i64 mut* out) {
    require_int(v);
    if (v.neg) {
        if (v.mag > NEG_MAX_MAG) {
            return false;
        }
        // D11.1: mag - 1 is at most the i64 maximum, so neither step wraps
        *out = -cast(v.mag - 1, i64) - 1;
        return true;
    }
    if (v.mag > I64_MAX_MAG) {
        return false;
    }
    *out = cast(v.mag, i64);
    return true;
}

/// The value as a u64; false when it is negative.
fn bool cv_to_u64(cval v, u64 mut* out) {
    require_int(v);
    if (v.neg) {
        return false;
    }
    *out = v.mag;
    return true;
}

/// The low 64 bits of the two's-complement pattern: the value modulo 2^64, as a
/// u64 register would hold it. The negation is the wrapping one, since the pattern
/// of a negative value is exactly 2^64 - mag.
/// D11.2
fn u64 cv_bits(cval v) {
    require_int(v);
    if (v.neg) {
        return 0 -% v.mag;
    }
    return v.mag;
}

/// The value whose low 64 bits are `bits` and whose bits above are all `high`
/// (the infinite two's-complement extension; `high` is `neg` for an integer):
/// non-negative when `high` is clear, else bits - 2^64, which lies in the
/// constant range exactly when bits >= 2^63.
fn bool int_from_bits(bool high, u64 bits, cval mut* out) {
    if (!high) {
        *out = int_make(false, bits);
        return true;
    }
    if (bits < NEG_MAX_MAG) {
        *out = cv_none();
        return false;
    }
    // D11.2: the wrapping subtract; the exact difference is the pattern
    return int_check(true, 0 -% bits, out);
}

/// Two integers or two chars in order: -1, 0 or 1.
fn i32 cv_cmp(cval a, cval b) {
    if (a.kind == cval_kind.cv_float || b.kind == cval_kind.cv_float) {
        if (a.kind != b.kind) {
            panic("consts.cv_cmp: a float constant compared with another kind");
        }
        // D6.12: every float constant is finite; the two zeros are equal
        return flt.flt_cmp(a.fbits, b.fbits);
    }
    if (a.kind != cval_kind.cv_char || b.kind != cval_kind.cv_char) {
        require_int(a);
        require_int(b);
        if (a.neg != b.neg) {
            if (a.neg) {
                return -1;
            }
            return 1;
        }
    }
    if (a.mag == b.mag) {
        return 0;
    }
    // Two negatives order by magnitude in reverse.
    bool less = a.mag < b.mag;
    if (less != a.neg) {
        return -1;
    }
    return 1;
}

/// Equality of two values of the same kind: integers and chars by value, bools,
/// null (equal to null), strings by bytes; none never equals. Values of
/// different kinds are not equal.
fn bool cv_eq(cval a, cval b) {
    if (a.kind != b.kind) {
        return false;
    }
    switch (a.kind) {
    case cval_kind.cv_none:
        return false;
    case cval_kind.cv_int:
        return a.neg == b.neg && a.mag == b.mag;
    case cval_kind.cv_bool, cval_kind.cv_char:
        return a.mag == b.mag;
    case cval_kind.cv_null:
        return true;
    case cval_kind.cv_str:
        return a.str == b.str;
    case cval_kind.cv_float:
        // D6.12, D4.4
        return flt.flt_cmp(a.fbits, b.fbits) == 0;
    }
    return false;
}

// ---- untyped arithmetic --------------------------------------------------------
// D4.4

/// The sum of two signed magnitudes, exact; the raw pair is validated by the
/// caller through int_check.
fn bool add_raw(bool an, u64 am, bool bn, u64 bm, bool mut* rn, u64 mut* rm) {
    if (an == bn) {
        *rn = an;
        // The C asks __builtin_add_overflow; the sum is tested before it is computed
        // instead, since performing it is what would trap.
        // D11.1
        if (am > U64_MAX - bm) {
            return false;
        }
        *rm = am + bm;
        return true;
    }
    if (am >= bm) {
        *rn = an;
        *rm = am - bm;
    } else {
        *rn = bn;
        *rm = bm - am;
    }
    return true;
}

fn bool cv_add(cval a, cval b, cval mut* out) {
    require_int(a);
    require_int(b);
    bool mut neg = false;
    u64 mut mag = 0;
    if (!add_raw(a.neg, a.mag, b.neg, b.mag, &neg, &mag)) {
        *out = cv_none();
        return false;
    }
    return int_check(neg, mag, out);
}

fn bool cv_sub(cval a, cval b, cval mut* out) {
    require_int(a);
    require_int(b);
    bool mut neg = false;
    u64 mut mag = 0;
    // a - b is a + (-b); the raw pair (!b.neg, b.mag) needs no validation.
    if (!add_raw(a.neg, a.mag, !b.neg, b.mag, &neg, &mag)) {
        *out = cv_none();
        return false;
    }
    return int_check(neg, mag, out);
}

fn bool cv_mul(cval a, cval b, cval mut* out) {
    require_int(a);
    require_int(b);
    // The C asks __builtin_mul_overflow; the product is tested before it is computed
    // instead. A zero left magnitude has no quotient to compare against and cannot
    // overflow.
    // D11.1
    if (a.mag != 0 && b.mag > U64_MAX / a.mag) {
        *out = cv_none();
        return false;
    }
    return int_check(a.neg != b.neg, a.mag * b.mag, out);
}

fn bool cv_div(cval a, cval b, cval mut* out) {
    require_int(a);
    require_int(b);
    if (b.mag == 0) {
        *out = cv_none();
        return false;
    }
    // D6.13: truncation toward zero
    return int_check(a.neg != b.neg, a.mag / b.mag, out);
}

fn bool cv_rem(cval a, cval b, cval mut* out) {
    require_int(a);
    require_int(b);
    if (b.mag == 0) {
        *out = cv_none();
        return false;
    }
    // D6.13: the remainder takes the dividend's sign, so always in range
    return int_check(a.neg, a.mag % b.mag, out);
}

fn bool cv_neg(cval a, cval mut* out) {
    require_int(a);
    return int_check(!a.neg, a.mag, out);
}

fn bool cv_not(cval a, cval mut* out) {
    require_int(a);
    // ~c is -c - 1: for c >= 0 that is -(c + 1); for c < 0 it is |c| - 1.
    if (a.neg) {
        return int_check(false, a.mag - 1, out);
    }
    // The C asks __builtin_add_overflow on mag + 1; the one magnitude that overflows
    // is the largest u64, tested before the sum is computed.
    // D11.1
    if (a.mag == U64_MAX) {
        *out = cv_none();
        return false;
    }
    return int_check(true, a.mag + 1, out);
}

fn bool cv_and(cval a, cval b, cval mut* out) {
    require_int(a);
    require_int(b);
    return int_from_bits(a.neg && b.neg, cv_bits(a) & cv_bits(b), out);
}

fn bool cv_or(cval a, cval b, cval mut* out) {
    require_int(a);
    require_int(b);
    return int_from_bits(a.neg || b.neg, cv_bits(a) | cv_bits(b), out);
}

fn bool cv_xor(cval a, cval b, cval mut* out) {
    require_int(a);
    require_int(b);
    return int_from_bits(a.neg != b.neg, cv_bits(a) ^ cv_bits(b), out);
}

/// A shift count for untyped folding: 0..CV_SHIFT_MAX, else false.
fn bool shift_count(cval count, u64 mut* n) {
    require_int(count);
    if (count.neg || count.mag > CV_SHIFT_MAX) {
        return false;
    }
    *n = count.mag;
    return true;
}

fn bool cv_shl(cval a, cval count, cval mut* out) {
    require_int(a);
    u64 mut n = 0;
    if (!shift_count(count, &n)) {
        *out = cv_none();
        return false;
    }
    // An exact multiplication by 2^n: the magnitude must keep every bit, that
    // is mag * 2^n must not exceed 2^64 - 1.
    if (a.mag > (U64_MAX >> n)) {
        *out = cv_none();
        return false;
    }
    return int_check(a.neg, a.mag << n, out);
}

fn bool cv_shr(cval a, cval count, cval mut* out) {
    require_int(a);
    u64 mut n = 0;
    if (!shift_count(count, &n)) {
        *out = cv_none();
        return false;
    }
    // A floor division by 2^n: for a negative value the magnitude rounds up
    // (-1 >> 1 is -1); a rounded-up magnitude never exceeds the original.
    u64 mut mag = a.mag >> n;
    u64 one = 1;
    if (a.neg && (a.mag & ((one << n) - 1)) != 0) {
        mag += 1;
    }
    return int_check(a.neg, mag, out);
}

/// The comparison operators, on two integers or two chars, or `==`/`!=` on two
/// bools, nulls or strings: a bool value.
fn cval cv_compare(cv_rel rel, cval a, cval b) {
    if (rel == cv_rel.cv_rel_eq || rel == cv_rel.cv_rel_ne) {
        if (a.kind != b.kind || a.kind == cval_kind.cv_none) {
            panic("consts.cv_compare: constant comparison across kinds");
        }
        bool eq = cv_eq(a, b);
        if (rel == cv_rel.cv_rel_eq) {
            return cv_from_bool(eq);
        }
        return cv_from_bool(!eq);
    }
    i32 c = cv_cmp(a, b);
    switch (rel) {
    case cv_rel.cv_rel_lt:
        return cv_from_bool(c < 0);
    case cv_rel.cv_rel_le:
        return cv_from_bool(c <= 0);
    case cv_rel.cv_rel_gt:
        return cv_from_bool(c > 0);
    case cv_rel.cv_rel_ge:
        return cv_from_bool(c >= 0);
    case cv_rel.cv_rel_eq, cv_rel.cv_rel_ne:
        break;
    }
    panic("consts.cv_compare: unknown constant comparison");
}

fn cval cv_lnot(cval a) {
    require_bool(a);
    return cv_from_bool(a.mag == 0);
}

fn cval cv_land(cval a, cval b) {
    require_bool(a);
    require_bool(b);
    return cv_from_bool(a.mag != 0 && b.mag != 0);
}

fn cval cv_lor(cval a, cval b) {
    require_bool(a);
    require_bool(b);
    return cv_from_bool(a.mag != 0 || b.mag != 0);
}

// ---- types ---------------------------------------------------------------------
// D4.2, D4.3, D4.5, D3.14

fn u64 int_width(prim.prim_kind t) {
    if (!prim.prim_is_integer(t)) {
        panic("consts: integer folding on a non-integer type");
    }
    return cast(prim.prim_size(t), u64) * prim.PRIM_BITS_PER_BYTE;
}

fn bool int_fits(cval v, prim.prim_kind t) {
    u64 width = int_width(t);
    u64 one = 1;
    if (prim.prim_is_signed(t)) {
        // [-2^(w-1), 2^(w-1) - 1]
        u64 half = one << (width - 1);
        if (v.neg) {
            return v.mag <= half;
        }
        return v.mag < half;
    }
    if (v.neg) {
        return false;
    }
    return width == WORD_BITS || v.mag < (one << width);
}

/// Whether `v` may take the type `t` by contextual conversion: an integer fits
/// any integer type whose range holds it and either float type; a char fits
/// `char` and any integer type that holds its code point; an integer never fits
/// `char`; a bool fits `bool`.
/// D4.2, D4.3
fn bool cv_fits(cval v, prim.prim_kind t) {
    switch (v.kind) {
    case cval_kind.cv_int:
        return prim.prim_is_float(t) || (prim.prim_is_integer(t) && int_fits(v, t));
    case cval_kind.cv_char:
        return t == prim.prim_kind.prim_char ||
               (prim.prim_is_integer(t) && int_fits(cv_as_int(v), t));
    case cval_kind.cv_bool:
        return t == prim.prim_kind.prim_bool;
    case cval_kind.cv_float:
        // D4.2, D4.4: a float type and no other, and it must be finite there
        if (!prim.prim_is_float(t)) {
            return false;
        }
        u64 mut bits = 0;
        return cv_to_float_bits(v, t, &bits);
    case cval_kind.cv_none, cval_kind.cv_null, cval_kind.cv_str:
        return false;
    }
    return false;
}

/// The value of an integer, char or float constant in the float type `t`, rounded
/// to nearest; false when it is not finite there, which is a compile error.
/// D3.14, D4.2, D4.4
fn bool cv_to_float_bits(cval v, prim.prim_kind t, u64 mut* out) {
    if (!prim.prim_is_float(t)) {
        panic("consts.cv_to_float_bits: the target is not a float type");
    }
    if (v.kind == cval_kind.cv_float) {
        if (!is_f32(t)) {
            // Every constant is already held in binary64, so widening it is
            // the identity.
            *out = v.fbits;
            return true;
        }
        return flt.flt_to_f32(v.fbits, out);
    }
    cval i = cv_as_int(v);
    return flt.flt_from_int(i.neg, i.mag, is_f32(t), out);
}

/// The same conversion as a constant.
/// D4.2
fn bool cv_to_float(cval v, prim.prim_kind t, cval mut* out) {
    u64 mut bits = 0;
    if (!cv_to_float_bits(v, t, &bits)) {
        *out = cv_none();
        return false;
    }
    *out = cv_from_float(bits);
    return true;
}

/// The default type of a constant with no context: i32 if the integer fits, else
/// i64; `char` for a char; `bool` for a bool. False, and `*out` untouched, for an
/// integer outside i64 and for null, strings and none.
/// D4.5
fn bool cv_default_kind(cval v, prim.prim_kind mut* out) {
    switch (v.kind) {
    case cval_kind.cv_int:
        if (int_fits(v, prim.prim_kind.prim_i32)) {
            *out = prim.prim_kind.prim_i32;
            return true;
        }
        if (int_fits(v, prim.prim_kind.prim_i64)) {
            *out = prim.prim_kind.prim_i64;
            return true;
        }
        return false;
    case cval_kind.cv_char:
        *out = prim.prim_kind.prim_char;
        return true;
    case cval_kind.cv_bool:
        *out = prim.prim_kind.prim_bool;
        return true;
    case cval_kind.cv_float:
        // D4.5
        *out = prim.prim_kind.prim_f64;
        return true;
    case cval_kind.cv_none, cval_kind.cv_null, cval_kind.cv_str:
        return false;
    }
    return false;
}

/// The integer of type `t` whose two's-complement pattern has the low bits of
/// `bits`: truncated to the width, then sign- or zero-extended.
fn cval int_from_truncated(u64 bits, prim.prim_kind t) {
    u64 width = int_width(t);
    u64 one = 1;
    u64 mut mask = U64_MAX;
    if (width != WORD_BITS) {
        mask = (one << width) - 1;
    }
    u64 low = bits & mask;
    if (prim.prim_is_signed(t) && (low & (one << (width - 1))) != 0) {
        // D11.1: (~low & mask) + 1 is at most 2^(width - 1), so no wrap
        return int_make(true, ((~low) & mask) + 1);
    }
    return int_make(false, low);
}

/// `cast(v, t)` with run-time semantics: an integer, char or bool to an integer
/// type keeps the low bits of its two's-complement pattern and sign- or
/// zero-extends by the target (`cast(300, u8)` is 44, `cast(-1, u32)` is
/// 4294967295, `cast(0x80000000, i32)` is -2147483648); to `char` it keeps the low
/// byte; a bool becomes 0 or 1; an integer to a float rounds to nearest and a
/// float to an integer truncates toward zero and saturates. False for a cast to
/// `bool`, which is forbidden, to `void`, from a `char` or a `bool` to a float,
/// from a float to anything but a number, for a float result that is not finite,
/// and for null, strings and none.
/// D3.14, D4.4
fn bool cv_cast(cval v, prim.prim_kind t, cval mut* out) {
    if (v.kind == cval_kind.cv_float) {
        if (prim.prim_is_integer(t)) {
            return float_to_int(v, t, out);
        }
        if (prim.prim_is_float(t)) {
            // D3.14, D4.4: rounds to nearest; a result that is not finite fails
            return cv_to_float(v, t, out);
        }
        // D3.14: a float reaches `char`, `bool` and an enum through no row
        *out = cv_none();
        return false;
    }
    if (!cv_is_int_like(v) && v.kind != cval_kind.cv_bool) {
        *out = cv_none();
        return false;
    }
    if (prim.prim_is_float(t)) {
        if (v.kind != cval_kind.cv_int) {
            // D3.14: no row takes a `char` or a `bool` to a float
            *out = cv_none();
            return false;
        }
        // D3.14
        return cv_to_float(v, t, out);
    }
    u64 mut bits = v.mag;
    if (v.kind != cval_kind.cv_bool) {
        bits = cv_bits(cv_as_int(v));
    }
    if (prim.prim_is_integer(t)) {
        *out = int_from_truncated(bits, t);
        return true;
    }
    if (t == prim.prim_kind.prim_char && v.kind != cval_kind.cv_bool) {
        *out = cv_from_char(bits & CV_CHAR_MAX);
        return true;
    }
    // D3.14: not to bool, not bool to char, not bool to float
    *out = cv_none();
    return false;
}

/// `cast(v, t)` from a float to an integer type: the value truncated toward zero
/// and saturated at the range of `t`, which is what the saturating intrinsic
/// computes at run time. No constant is a NaN, so the NaN row of that rule has no
/// case here.
/// D3.14, D4.4, D19.2
fn bool float_to_int(cval v, prim.prim_kind t, cval mut* out) {
    bool mut neg = false;
    u64 mut mag = 0;
    bool inside = flt.flt_to_int(v.fbits, &neg, &mag);
    u64 width = int_width(t);
    u64 one = 1;
    u64 mut limit = U64_MAX;
    if (prim.prim_is_signed(t)) {
        // The magnitude of the least value of a signed type is one above its
        // largest value.
        limit = one << (width - 1);
        if (!neg) {
            limit -= 1;
        }
    } else if (neg) {
        // A negative value saturates at zero: an unsigned type holds none.
        limit = 0;
    } else if (width != WORD_BITS) {
        limit = (one << width) - 1;
    }
    if (!inside || mag > limit) {
        mag = limit;
    }
    *out = int_make(neg, mag);
    return true;
}

// ---- float folding -------------------------------------------------------------
// D4.4, D6.12

/// The four operations on two constants in the float type `t`, each rounding the
/// exact result once. An integer or char operand takes `t` first, which is the
/// contextual conversion and the rule that an integer with a float folds as a
/// float. False, and cv_none, where an operand or the result is not finite in `t`,
/// or where a division has a zero divisor: no such constant exists.
/// D4.2, D4.4, D6.12
fn bool cv_float_add(cval a, cval b, prim.prim_kind t, cval mut* out) {
    u64 mut x = 0;
    u64 mut y = 0;
    u64 mut r = 0;
    *out = cv_none();
    if (!cv_to_float_bits(a, t, &x) || !cv_to_float_bits(b, t, &y)) {
        return false;
    }
    if (!flt.flt_add(x, y, is_f32(t), &r)) {
        return false;
    }
    *out = cv_from_float(r);
    return true;
}

fn bool cv_float_sub(cval a, cval b, prim.prim_kind t, cval mut* out) {
    u64 mut x = 0;
    u64 mut y = 0;
    u64 mut r = 0;
    *out = cv_none();
    if (!cv_to_float_bits(a, t, &x) || !cv_to_float_bits(b, t, &y)) {
        return false;
    }
    if (!flt.flt_sub(x, y, is_f32(t), &r)) {
        return false;
    }
    *out = cv_from_float(r);
    return true;
}

fn bool cv_float_mul(cval a, cval b, prim.prim_kind t, cval mut* out) {
    u64 mut x = 0;
    u64 mut y = 0;
    u64 mut r = 0;
    *out = cv_none();
    if (!cv_to_float_bits(a, t, &x) || !cv_to_float_bits(b, t, &y)) {
        return false;
    }
    if (!flt.flt_mul(x, y, is_f32(t), &r)) {
        return false;
    }
    *out = cv_from_float(r);
    return true;
}

fn bool cv_float_div(cval a, cval b, prim.prim_kind t, cval mut* out) {
    u64 mut x = 0;
    u64 mut y = 0;
    u64 mut r = 0;
    *out = cv_none();
    if (!cv_to_float_bits(a, t, &x) || !cv_to_float_bits(b, t, &y)) {
        return false;
    }
    if (!flt.flt_div(x, y, is_f32(t), &r)) {
        return false;
    }
    *out = cv_from_float(r);
    return true;
}

/// Unary minus on a float constant flips the sign bit, which is exact in both
/// formats and is not a subtraction from zero: the two differ on a zero and on a
/// NaN.
/// D6.12
fn cval cv_float_neg(cval v) {
    return cv_from_float(flt.flt_neg(cv_float_bits(v)));
}

// ---- typed folding -------------------------------------------------------------
// D4.6, D6.2, D6.13, D11.2

/// Every cv_typed_* and cv_wrap_* function documents that its value operands
/// already have the integer type `t`, so a value outside that type is a bug in the
/// checker, not a program error: it fails loudly rather than folding
/// cv_typed_and(-1, 5, u8) to 5. A shift count is not a value operand, any integer
/// type being admitted there, so the shifts guard their left operand only.
/// D6.2
fn void require_typed(cval v, prim.prim_kind t) {
    require_int(v);
    if (!int_fits(v, t)) {
        panic("consts: typed constant folding on a value outside its type");
    }
}

/// The typed result of an exact operation: `ok` and in the range of `t`.
fn bool typed_check(bool ok, cval r, prim.prim_kind t, cval mut* out) {
    if (!ok || !int_fits(r, t)) {
        *out = cv_none();
        return false;
    }
    *out = r;
    return true;
}

fn bool cv_typed_add(cval a, cval b, prim.prim_kind t, cval mut* out) {
    require_typed(a, t);
    require_typed(b, t);
    cval mut r = cv_none();
    return typed_check(cv_add(a, b, &r), r, t, out);
}

fn bool cv_typed_sub(cval a, cval b, prim.prim_kind t, cval mut* out) {
    require_typed(a, t);
    require_typed(b, t);
    cval mut r = cv_none();
    return typed_check(cv_sub(a, b, &r), r, t, out);
}

fn bool cv_typed_mul(cval a, cval b, prim.prim_kind t, cval mut* out) {
    require_typed(a, t);
    require_typed(b, t);
    cval mut r = cv_none();
    return typed_check(cv_mul(a, b, &r), r, t, out);
}

fn bool cv_typed_div(cval a, cval b, prim.prim_kind t, cval mut* out) {
    require_typed(a, t);
    require_typed(b, t);
    // D6.13: MIN / -1 is 2^(w-1), which the range check rejects
    cval mut r = cv_none();
    return typed_check(cv_div(a, b, &r), r, t, out);
}

fn bool cv_typed_rem(cval a, cval b, prim.prim_kind t, cval mut* out) {
    // D6.13: MIN % -1 is 0 exactly but a run-time error
    cval mut q = cv_none();
    cval mut r = cv_none();
    return typed_check(cv_typed_div(a, b, t, &q) && cv_rem(a, b, &r), r, t, out);
}

fn bool cv_typed_neg(cval a, prim.prim_kind t, cval mut* out) {
    require_typed(a, t);
    if (!prim.prim_is_signed(t)) {
        // D6.2: the checker never asks to negate an unsigned constant
        panic("consts.cv_typed_neg: unary minus on an unsigned type");
    }
    cval mut r = cv_none();
    return typed_check(cv_neg(a, &r), r, t, out);
}

/// `~` complements the bits of the width, so `~0` is 4294967295 in u32.
fn bool cv_typed_not(cval a, prim.prim_kind t, cval mut* out) {
    // The complement within the width: -a - 1 modulo 2^width.
    require_typed(a, t);
    *out = int_from_truncated(~cv_bits(a), t);
    return true;
}

fn bool cv_typed_and(cval a, cval b, prim.prim_kind t, cval mut* out) {
    require_typed(a, t);
    require_typed(b, t);
    cval mut r = cv_none();
    return typed_check(cv_and(a, b, &r), r, t, out);
}

fn bool cv_typed_or(cval a, cval b, prim.prim_kind t, cval mut* out) {
    require_typed(a, t);
    require_typed(b, t);
    cval mut r = cv_none();
    return typed_check(cv_or(a, b, &r), r, t, out);
}

fn bool cv_typed_xor(cval a, cval b, prim.prim_kind t, cval mut* out) {
    require_typed(a, t);
    require_typed(b, t);
    cval mut r = cv_none();
    return typed_check(cv_xor(a, b, &r), r, t, out);
}

/// A shift count for the width of `t`: 0..width-1, else false.
/// D6.2
fn bool typed_shift_count(cval count, prim.prim_kind t, u64 mut* n) {
    require_int(count);
    if (count.neg || count.mag >= int_width(t)) {
        return false;
    }
    *n = count.mag;
    return true;
}

fn bool cv_typed_shl(cval a, cval count, prim.prim_kind t, cval mut* out) {
    require_typed(a, t);
    u64 mut n = 0;
    if (!typed_shift_count(count, t, &n)) {
        *out = cv_none();
        return false;
    }
    // D6.2: the bits shifted out are discarded, so this wraps by design
    *out = int_from_truncated(cv_bits(a) << n, t);
    return true;
}

fn bool cv_typed_shr(cval a, cval count, prim.prim_kind t, cval mut* out) {
    require_typed(a, t);
    u64 mut n = 0;
    if (!typed_shift_count(count, t, &n)) {
        *out = cv_none();
        return false;
    }
    // The operand fits `t`, so the exact floor division is the arithmetic
    // shift of a signed type and the logical shift of an unsigned one.
    cval mut r = cv_none();
    return typed_check(cv_shr(a, count, &r), r, t, out);
}

/// `+% -% *%` on constants of the integer type `t` (both operands fit `t`):
/// two's-complement wrapping at the width of `t`; never false. The three sums are
/// written with the wrapping operators because wrapping is what they compute; a
/// checked `+` here would trap on the input the rule defines.
/// D11.2
fn cval cv_wrap_add(cval a, cval b, prim.prim_kind t) {
    require_typed(a, t);
    require_typed(b, t);
    return int_from_truncated(cv_bits(a) +% cv_bits(b), t);
}

fn cval cv_wrap_sub(cval a, cval b, prim.prim_kind t) {
    require_typed(a, t);
    require_typed(b, t);
    return int_from_truncated(cv_bits(a) -% cv_bits(b), t);
}

fn cval cv_wrap_mul(cval a, cval b, prim.prim_kind t) {
    require_typed(a, t);
    require_typed(b, t);
    return int_from_truncated(cv_bits(a) *% cv_bits(b), t);
}

// ---- diagnostics ---------------------------------------------------------------

/// One byte inside a literal delimited by `quote`, with the escapes of the source
/// form: `\n \t \r \0 \\`, the delimiter itself, and `\xHH` for every other
/// byte outside printable ASCII.
/// D2.8
fn void escape_char(u64 code, char quote, strbuf.str_buf mut* out) {
    if (code == cast(quote, u64)) {
        strbuf.push(out, '\\');
        strbuf.push(out, quote);
        return;
    }
    switch (code) {
    case '\n':
        strbuf.append(out, "\\n");
        return;
    case '\t':
        strbuf.append(out, "\\t");
        return;
    case '\r':
        strbuf.append(out, "\\r");
        return;
    case 0:
        strbuf.append(out, "\\0");
        return;
    case '\\':
        strbuf.append(out, "\\\\");
        return;
    default:
        break;
    }
    if (code >= ASCII_PRINT_MIN && code <= ASCII_PRINT_MAX) {
        strbuf.push(out, cast(code, char));
        return;
    }
    strbuf.append(out, "\\x");
    strbuf.push(out, HEX_DIGITS[(code >> HEX_SHIFT) & HEX_MASK]);
    strbuf.push(out, HEX_DIGITS[code & HEX_MASK]);
}

fn void char_to_str(u64 code, strbuf.str_buf mut* out) {
    strbuf.push(out, '\'');
    escape_char(code, '\'', out);
    strbuf.push(out, '\'');
}

/// The bytes of a string literal between double quotes, escaped as they would be
/// written in source, so a diagnostic stays on one line.
/// D2.8, D2.9
fn void str_to_str(string s, strbuf.str_buf mut* out) {
    strbuf.push(out, '"');
    u64 mut k = 0;
    while (k < s.len) {
        escape_char(cast(s[k], u64), '"', out);
        k += 1;
    }
    strbuf.push(out, '"');
}

/// Appends the value as it reads in a diagnostic: an integer in decimal with a
/// `-` prefix, a char as a char literal (`'a'`, `'\n'`, `'\xFF'`), `true`,
/// `false`, `null`, a string as a string literal between double quotes with the
/// escapes of the source form (so a quote, a newline or a NUL byte cannot break
/// the diagnostic line), and `<none>`. A float constant has no text form here: the
/// shortest decimal that reads back is the runtime's work and no message of the
/// checker prints a float value, since the two that print a constant at all -- the
/// one that does not fit its type and the enum value that does not fit i32 -- name
/// the float rather than print it. Asking for one is therefore a broken
/// precondition.
/// D2.8, D13.3, D18.2
fn void cv_to_str(cval v, strbuf.str_buf mut* out) {
    switch (v.kind) {
    case cval_kind.cv_float:
        panic("consts.cv_to_str: a float constant has no text form");
    case cval_kind.cv_none:
        strbuf.append(out, "<none>");
        return;
    case cval_kind.cv_int:
        if (v.neg) {
            strbuf.push(out, '-');
        }
        strbuf.append_u64(out, v.mag);
        return;
    case cval_kind.cv_bool:
        if (v.mag != 0) {
            strbuf.append(out, "true");
        } else {
            strbuf.append(out, "false");
        }
        return;
    case cval_kind.cv_char:
        char_to_str(v.mag, out);
        return;
    case cval_kind.cv_null:
        strbuf.append(out, "null");
        return;
    case cval_kind.cv_str:
        str_to_str(v.str, out);
        return;
    }
    strbuf.append(out, "<none>");
}
