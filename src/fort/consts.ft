/// Represents compile-time constants and folds them exactly.
/// Untyped integer operations fail on overflow or division by zero.
/// Typed and wrapping operations follow their target integer type.
import flt;
import prim;
import std.strbuf;

// The magnitude of the most negative constant, 2^63.
u64 NEG_MAX_MAG = 9223372036854775808;

// The largest u64 there is, which the C spells UINT64_MAX.
u64 U64_MAX = 18446744073709551615;

// The largest i64 there is, the ceiling cv_to_i64 holds a magnitude against.
u64 I64_MAX_MAG = 9223372036854775807;

// The number of bits of a u64, the widest integer.
u64 WORD_BITS = 64;

// The largest shift count of untyped folding (a count in `0..63`; the value
// range has 64 magnitude bits).
u64 CV_SHIFT_MAX = 63;

// The last code point of a char literal.
u64 CV_CHAR_MAX = 255;

// The hex digits of a `\xHH` escape in cv_to_str, and the shift and mask that
// split a byte into two of them.
string HEX_DIGITS = "0123456789ABCDEF";
u64 HEX_SHIFT = 4;
u64 HEX_MASK = 15;
u64 ASCII_PRINT_MIN = 32;
u64 ASCII_PRINT_MAX = 126;

/// What a constant is.
enum cval_kind {
    cv_none, // not a constant expression
    cv_int,  // an integer, exact in [-2^63, 2^64 - 1]
    cv_bool, // true or false
    cv_char, // a char literal: a code point 0..255
    cv_null, // the literal null
    cv_str,  // a string literal: a view of its decoded bytes
    cv_float, // a float: the binary64 bits of a finite value
}

/// One constant value. cval{} is the none value, so a struct holding one is
/// initialized with {}.
struct cval {
    cval_kind kind;
    bool neg;    // cv_int: the value is -mag; never set when mag is 0
    u64 mag;     // cv_int: |value|; cv_char: the code point; cv_bool: 0/1
    string str;  // cv_str: the bytes
    u64 fbits;   // cv_float: the binary64 pattern of the value (flt.ft)
}

/// The comparison operators of cv_compare.
enum cv_rel {
    cv_rel_eq,
    cv_rel_ne,
    cv_rel_lt,
    cv_rel_le,
    cv_rel_gt,
    cv_rel_ge,
}

// ---- construction --------------------------------------------------------------

fn int_make(bool neg, u64 mag) cval {
    return cval{cval_kind.cv_int, neg && mag != 0, mag, "", 0};
}

// Stores `-mag` or `mag` when it lies in the constant range, else none.
fn int_check(bool neg, u64 mag, cval mut* out) bool {
    if (neg && mag > NEG_MAX_MAG) {
        *out = cv_none();
        return false;
    }
    *out = int_make(neg, mag);
    return true;
}

// Enforces the arithmetic precondition. The checker has typed each operand, so
// another value kind breaks the precondition. This function panics where the C
// implementation calls fatal_internal.
fn require_int(cval v) void {
    if (v.kind != cval_kind.cv_int) {
        panic("consts: constant folding on a non-integer");
    }
}

fn require_bool(cval v) void {
    if (v.kind != cval_kind.cv_bool) {
        panic("consts: logical folding on a non-bool");
    }
}

fn cv_none() cval {
    return cval{cval_kind.cv_none, false, 0, "", 0};
}

fn cv_from_i64(i64 v) cval {
    if (v >= 0) {
        return int_make(false, cast(v, u64));
    }
    // -(v + 1) is representable for every negative v, the i64 minimum
    // included, so the magnitude is taken without ever negating v itself.
    return int_make(true, cast(-(v + 1), u64) + 1);
}

// Also the constructor for an integer literal: the lexer's magnitude.
fn cv_from_u64(u64 v) cval {
    return int_make(false, v);
}

// A char literal from the lexer's code point, at most CV_CHAR_MAX (a broken
// precondition otherwise).
fn cv_from_char(u64 code) cval {
    if (code > CV_CHAR_MAX) {
        panic("consts.cv_from_char: char constant outside 0..255");
    }
    return cval{cval_kind.cv_char, false, code, "", 0};
}

fn cv_from_bool(bool b) cval {
    if (b) {
        return cval{cval_kind.cv_bool, false, 1, "", 0};
    }
    return cval{cval_kind.cv_bool, false, 0, "", 0};
}

fn cv_null() cval {
    return cval{cval_kind.cv_null, false, 0, "", 0};
}

/// A float constant from the text of a literal, evaluated in binary64; false
/// when the value is not finite there, which is a compile error.
fn cv_from_float_text(string text, cval mut* out) bool {
    u64 mut bits = 0;
    if (!flt.flt_parse(text, &bits)) {
        *out = cv_none();
        return false;
    }
    *out = cv_from_float(bits);
    return true;
}

// A float constant from the binary64 pattern of a finite value; the pattern
// of an f32 constant is the binary64 its binary32 value equals exactly.
fn cv_from_float(u64 bits) cval {
    return cval{cval_kind.cv_float, false, 0, "", bits};
}

fn cv_from_str(string s) cval {
    return cval{cval_kind.cv_str, false, 0, s, 0};
}

// ---- queries -------------------------------------------------------------------

fn cv_is_int(cval v) bool {
    return v.kind == cval_kind.cv_int;
}

fn cv_is_float(cval v) bool {
    return v.kind == cval_kind.cv_float;
}

/// The binary64 pattern of a float constant; every other kind is a broken
/// precondition, since the checker asks only where it has typed the value.
fn cv_float_bits(cval v) u64 {
    if (v.kind != cval_kind.cv_float) {
        panic("consts.cv_float_bits: the constant is not a float");
    }
    return v.fbits;
}

// Whether a float constant uses binary32. f32 uses binary32. All other float
// contexts use binary64, including an untyped float.
fn is_f32(prim.prim_kind t) bool {
    return t == prim.prim_kind.prim_f32;
}

/// An integer or a char: a char in an integer context is its code point.
fn cv_is_int_like(cval v) bool {
    return v.kind == cval_kind.cv_int || v.kind == cval_kind.cv_char;
}

/// Returns the exact integer for an integer or char value.
/// Arithmetic functions require this conversion before they receive a char.
fn cv_as_int(cval v) cval {
    if (v.kind == cval_kind.cv_char) {
        return int_make(false, v.mag);
    }
    require_int(v);
    return v;
}

/// Returns true for integer zero, char zero, and either floating-point zero.
/// Other constant kinds break the precondition.
fn cv_is_zero(cval v) bool {
    if (v.kind == cval_kind.cv_float) {
        return flt.flt_is_zero(v.fbits);
    }
    if (v.kind == cval_kind.cv_char) {
        return v.mag == 0;
    }
    require_int(v);
    return v.mag == 0;
}

// Whether the integer is negative: a negative constant in an index, bound or
// count position is a compile error.
fn cv_is_neg(cval v) bool {
    require_int(v);
    return v.neg;
}

/// The value as an i64; false when it lies outside that range.
fn cv_to_i64(cval v, i64 mut* out) bool {
    require_int(v);
    if (v.neg) {
        if (v.mag > NEG_MAX_MAG) {
            return false;
        }
        // mag - 1 is at most the i64 maximum, so neither step wraps
        *out = -cast(v.mag - 1, i64) - 1;
        return true;
    }
    if (v.mag > I64_MAX_MAG) {
        return false;
    }
    *out = cast(v.mag, i64);
    return true;
}

/// The value as a u64; false when it is negative.
fn cv_to_u64(cval v, u64 mut* out) bool {
    require_int(v);
    if (v.neg) {
        return false;
    }
    *out = v.mag;
    return true;
}

/// The low 64 bits of the two's-complement pattern: the value modulo 2^64, as a
/// u64 register would hold it. The negation is the wrapping one, since the pattern
/// of a negative value is exactly 2^64 - mag.
fn cv_bits(cval v) u64 {
    require_int(v);
    if (v.neg) {
        return 0 -% v.mag;
    }
    return v.mag;
}

// Builds the value with low bits `bits` and all higher bits `high`. `high`
// equals `neg` for an integer. A clear `high` gives a nonnegative value.
// Otherwise, the value is bits - 2^64. It fits the constant range when
// bits >= 2^63.
fn int_from_bits(bool high, u64 bits, cval mut* out) bool {
    if (!high) {
        *out = int_make(false, bits);
        return true;
    }
    if (bits < NEG_MAX_MAG) {
        *out = cv_none();
        return false;
    }
    // the wrapping subtract; the exact difference is the pattern
    return int_check(true, 0 -% bits, out);
}

/// Two integers or two chars in order: -1, 0 or 1.
fn cv_cmp(cval a, cval b) i32 {
    if (a.kind == cval_kind.cv_float || b.kind == cval_kind.cv_float) {
        if (a.kind != b.kind) {
            panic("consts.cv_cmp: a float constant compared with another kind");
        }
        // every float constant is finite; the two zeros are equal
        return flt.flt_cmp(a.fbits, b.fbits);
    }
    if (a.kind != cval_kind.cv_char || b.kind != cval_kind.cv_char) {
        require_int(a);
        require_int(b);
        if (a.neg != b.neg) {
            if (a.neg) {
                return -1;
            }
            return 1;
        }
    }
    if (a.mag == b.mag) {
        return 0;
    }
    // Two negatives order by magnitude in reverse.
    bool less = a.mag < b.mag;
    if (less != a.neg) {
        return -1;
    }
    return 1;
}

// Equality compares integers, chars, and bools by value. Null equals null.
// Strings compare by bytes. None never equals. Different kinds are not equal.
fn cv_eq(cval a, cval b) bool {
    if (a.kind != b.kind) {
        return false;
    }
    switch (a.kind) {
    case cval_kind.cv_none:
        return false;
    case cval_kind.cv_int:
        return a.neg == b.neg && a.mag == b.mag;
    case cval_kind.cv_bool, cval_kind.cv_char:
        return a.mag == b.mag;
    case cval_kind.cv_null:
        return true;
    case cval_kind.cv_str:
        return a.str == b.str;
    case cval_kind.cv_float:
        return flt.flt_cmp(a.fbits, b.fbits) == 0;
    }
    return false;
}

// ---- untyped arithmetic --------------------------------------------------------

// The sum of two signed magnitudes, exact; the raw pair is validated by the
// caller through int_check.
fn add_raw(bool an, u64 am, bool bn, u64 bm, bool mut* rn, u64 mut* rm) bool {
    if (an == bn) {
        *rn = an;
        // The C asks __builtin_add_overflow; the sum is tested before it is computed
        // instead, since performing it is what would trap.
        if (am > U64_MAX - bm) {
            return false;
        }
        *rm = am + bm;
        return true;
    }
    if (am >= bm) {
        *rn = an;
        *rm = am - bm;
    } else {
        *rn = bn;
        *rm = bm - am;
    }
    return true;
}

fn cv_add(cval a, cval b, cval mut* out) bool {
    require_int(a);
    require_int(b);
    bool mut neg = false;
    u64 mut mag = 0;
    if (!add_raw(a.neg, a.mag, b.neg, b.mag, &neg, &mag)) {
        *out = cv_none();
        return false;
    }
    return int_check(neg, mag, out);
}

fn cv_sub(cval a, cval b, cval mut* out) bool {
    require_int(a);
    require_int(b);
    bool mut neg = false;
    u64 mut mag = 0;
    // a - b is a + (-b); the raw pair (!b.neg, b.mag) needs no validation.
    if (!add_raw(a.neg, a.mag, !b.neg, b.mag, &neg, &mag)) {
        *out = cv_none();
        return false;
    }
    return int_check(neg, mag, out);
}

fn cv_mul(cval a, cval b, cval mut* out) bool {
    require_int(a);
    require_int(b);
    // The C asks __builtin_mul_overflow; the product is tested before it is computed
    // instead. A zero left magnitude has no quotient to compare against and cannot
    // overflow.
    if (a.mag != 0 && b.mag > U64_MAX / a.mag) {
        *out = cv_none();
        return false;
    }
    return int_check(a.neg != b.neg, a.mag * b.mag, out);
}

fn cv_div(cval a, cval b, cval mut* out) bool {
    require_int(a);
    require_int(b);
    if (b.mag == 0) {
        *out = cv_none();
        return false;
    }
    // truncation toward zero
    return int_check(a.neg != b.neg, a.mag / b.mag, out);
}

fn cv_rem(cval a, cval b, cval mut* out) bool {
    require_int(a);
    require_int(b);
    if (b.mag == 0) {
        *out = cv_none();
        return false;
    }
    // the remainder takes the dividend's sign, so always in range
    return int_check(a.neg, a.mag % b.mag, out);
}

fn cv_neg(cval a, cval mut* out) bool {
    require_int(a);
    return int_check(!a.neg, a.mag, out);
}

fn cv_not(cval a, cval mut* out) bool {
    require_int(a);
    // ~c is -c - 1: for c >= 0 that is -(c + 1); for c < 0 it is |c| - 1.
    if (a.neg) {
        return int_check(false, a.mag - 1, out);
    }
    // The C asks __builtin_add_overflow on mag + 1; the one magnitude that overflows
    // is the largest u64, tested before the sum is computed.
    if (a.mag == U64_MAX) {
        *out = cv_none();
        return false;
    }
    return int_check(true, a.mag + 1, out);
}

fn cv_and(cval a, cval b, cval mut* out) bool {
    require_int(a);
    require_int(b);
    return int_from_bits(a.neg && b.neg, cv_bits(a) & cv_bits(b), out);
}

fn cv_or(cval a, cval b, cval mut* out) bool {
    require_int(a);
    require_int(b);
    return int_from_bits(a.neg || b.neg, cv_bits(a) | cv_bits(b), out);
}

fn cv_xor(cval a, cval b, cval mut* out) bool {
    require_int(a);
    require_int(b);
    return int_from_bits(a.neg != b.neg, cv_bits(a) ^ cv_bits(b), out);
}

// A shift count for untyped folding: 0..CV_SHIFT_MAX, else false.
fn shift_count(cval count, u64 mut* n) bool {
    require_int(count);
    if (count.neg || count.mag > CV_SHIFT_MAX) {
        return false;
    }
    *n = count.mag;
    return true;
}

fn cv_shl(cval a, cval count, cval mut* out) bool {
    require_int(a);
    u64 mut n = 0;
    if (!shift_count(count, &n)) {
        *out = cv_none();
        return false;
    }
    // An exact multiplication by 2^n: the magnitude must keep every bit, that
    // is mag * 2^n must not exceed 2^64 - 1.
    if (a.mag > (U64_MAX >> n)) {
        *out = cv_none();
        return false;
    }
    return int_check(a.neg, a.mag << n, out);
}

fn cv_shr(cval a, cval count, cval mut* out) bool {
    require_int(a);
    u64 mut n = 0;
    if (!shift_count(count, &n)) {
        *out = cv_none();
        return false;
    }
    // A floor division by 2^n: for a negative value the magnitude rounds up
    // (-1 >> 1 is -1); a rounded-up magnitude never exceeds the original.
    u64 mut mag = a.mag >> n;
    u64 one = 1;
    if (a.neg && (a.mag & ((one << n) - 1)) != 0) {
        mag += 1;
    }
    return int_check(a.neg, mag, out);
}

/// The comparison operators, on two integers or two chars, or `==`/`!=` on two
/// bools, nulls or strings: a bool value.
fn cv_compare(cv_rel rel, cval a, cval b) cval {
    if (rel == cv_rel.cv_rel_eq || rel == cv_rel.cv_rel_ne) {
        if (a.kind != b.kind || a.kind == cval_kind.cv_none) {
            panic("consts.cv_compare: constant comparison across kinds");
        }
        bool eq = cv_eq(a, b);
        if (rel == cv_rel.cv_rel_eq) {
            return cv_from_bool(eq);
        }
        return cv_from_bool(!eq);
    }
    i32 c = cv_cmp(a, b);
    switch (rel) {
    case cv_rel.cv_rel_lt:
        return cv_from_bool(c < 0);
    case cv_rel.cv_rel_le:
        return cv_from_bool(c <= 0);
    case cv_rel.cv_rel_gt:
        return cv_from_bool(c > 0);
    case cv_rel.cv_rel_ge:
        return cv_from_bool(c >= 0);
    case cv_rel.cv_rel_eq, cv_rel.cv_rel_ne:
        break;
    }
    panic("consts.cv_compare: unknown constant comparison");
}

fn cv_lnot(cval a) cval {
    require_bool(a);
    return cv_from_bool(a.mag == 0);
}

fn cv_land(cval a, cval b) cval {
    require_bool(a);
    require_bool(b);
    return cv_from_bool(a.mag != 0 && b.mag != 0);
}

fn cv_lor(cval a, cval b) cval {
    require_bool(a);
    require_bool(b);
    return cv_from_bool(a.mag != 0 || b.mag != 0);
}

// ---- types ---------------------------------------------------------------------

fn int_width(prim.prim_kind t) u64 {
    if (!prim.prim_is_integer(t)) {
        panic("consts: integer folding on a non-integer type");
    }
    return cast(prim.prim_size(t), u64) * prim.PRIM_BITS_PER_BYTE;
}

fn int_fits(cval v, prim.prim_kind t) bool {
    u64 width = int_width(t);
    u64 one = 1;
    if (prim.prim_is_signed(t)) {
        // [-2^(w-1), 2^(w-1) - 1]
        u64 half = one << (width - 1);
        if (v.neg) {
            return v.mag <= half;
        }
        return v.mag < half;
    }
    if (v.neg) {
        return false;
    }
    return width == WORD_BITS || v.mag < (one << width);
}

/// Returns true when contextual conversion can give `v` the primitive type `t`.
/// Integers require a target range that holds them, except that either float type accepts them.
/// A char fits `char` or an integer type that holds its code point. A bool fits only `bool`.
fn cv_fits(cval v, prim.prim_kind t) bool {
    switch (v.kind) {
    case cval_kind.cv_int:
        return prim.prim_is_float(t) || (prim.prim_is_integer(t) && int_fits(v, t));
    case cval_kind.cv_char:
        return t == prim.prim_kind.prim_char ||
               (prim.prim_is_integer(t) && int_fits(cv_as_int(v), t));
    case cval_kind.cv_bool:
        return t == prim.prim_kind.prim_bool;
    case cval_kind.cv_float:
        // a float type and no other, and it must be finite there
        if (!prim.prim_is_float(t)) {
            return false;
        }
        u64 mut bits = 0;
        return cv_to_float_bits(v, t, &bits);
    case cval_kind.cv_none, cval_kind.cv_null, cval_kind.cv_str:
        return false;
    }
    return false;
}

// Converts an integer, char, or float constant to float type `t`. It rounds to
// nearest. It returns false for a non-finite result, which is a compile error.
fn cv_to_float_bits(cval v, prim.prim_kind t, u64 mut* out) bool {
    if (!prim.prim_is_float(t)) {
        panic("consts.cv_to_float_bits: the target is not a float type");
    }
    if (v.kind == cval_kind.cv_float) {
        if (!is_f32(t)) {
            // Every constant is already held in binary64, so widening it is
            // the identity.
            *out = v.fbits;
            return true;
        }
        return flt.flt_to_f32(v.fbits, out);
    }
    cval i = cv_as_int(v);
    return flt.flt_from_int(i.neg, i.mag, is_f32(t), out);
}

/// Converts an integer-like or float constant to the float type `t`.
/// Returns false when the rounded result is not finite in `t`.
/// On failure, the function stores none in `*out`.
fn cv_to_float(cval v, prim.prim_kind t, cval mut* out) bool {
    u64 mut bits = 0;
    if (!cv_to_float_bits(v, t, &bits)) {
        *out = cv_none();
        return false;
    }
    *out = cv_from_float(bits);
    return true;
}

/// Returns the default primitive type for a constant without context.
/// Integers use i32 when possible, then i64. Floats use f64.
/// Chars and bools keep their primitive kinds.
/// Returns false for integers outside i64, null, strings, and none.
/// On failure, the function leaves `*out` unchanged.
fn cv_default_kind(cval v, prim.prim_kind mut* out) bool {
    switch (v.kind) {
    case cval_kind.cv_int:
        if (int_fits(v, prim.prim_kind.prim_i32)) {
            *out = prim.prim_kind.prim_i32;
            return true;
        }
        if (int_fits(v, prim.prim_kind.prim_i64)) {
            *out = prim.prim_kind.prim_i64;
            return true;
        }
        return false;
    case cval_kind.cv_char:
        *out = prim.prim_kind.prim_char;
        return true;
    case cval_kind.cv_bool:
        *out = prim.prim_kind.prim_bool;
        return true;
    case cval_kind.cv_float:
        *out = prim.prim_kind.prim_f64;
        return true;
    case cval_kind.cv_none, cval_kind.cv_null, cval_kind.cv_str:
        return false;
    }
    return false;
}

// The integer of type `t` whose two's-complement pattern has the low bits of
// `bits`: truncated to the width, then sign- or zero-extended.
fn int_from_truncated(u64 bits, prim.prim_kind t) cval {
    u64 width = int_width(t);
    u64 one = 1;
    u64 mut mask = U64_MAX;
    if (width != WORD_BITS) {
        mask = (one << width) - 1;
    }
    u64 low = bits & mask;
    if (prim.prim_is_signed(t) && (low & (one << (width - 1))) != 0) {
        // (~low & mask) + 1 is at most 2^(width - 1), so no wrap
        return int_make(true, ((~low) & mask) + 1);
    }
    return int_make(false, low);
}

/// Applies the run-time scalar cast from `v` to `t`.
/// Integer targets keep the low bits and extend them according to the target sign.
/// Char targets keep the low byte. Integer-to-float casts round to nearest.
/// Float-to-integer casts truncate toward zero and saturate.
/// Returns false for bool or void targets, and for null, string, or none values.
/// It rejects bool-to-char, char-to-float, bool-to-float, and float-to-char.
/// It also rejects non-finite float results.
/// On failure, the function stores none in `*out`.
fn cv_cast(cval v, prim.prim_kind t, cval mut* out) bool {
    if (v.kind == cval_kind.cv_float) {
        if (prim.prim_is_integer(t)) {
            return float_to_int(v, t, out);
        }
        if (prim.prim_is_float(t)) {
            // rounds to nearest; a result that is not finite fails
            return cv_to_float(v, t, out);
        }
        // a float reaches `char`, `bool` and an enum through no row
        *out = cv_none();
        return false;
    }
    if (!cv_is_int_like(v) && v.kind != cval_kind.cv_bool) {
        *out = cv_none();
        return false;
    }
    if (prim.prim_is_float(t)) {
        if (v.kind != cval_kind.cv_int) {
            // no row takes a `char` or a `bool` to a float
            *out = cv_none();
            return false;
        }
        return cv_to_float(v, t, out);
    }
    u64 mut bits = v.mag;
    if (v.kind != cval_kind.cv_bool) {
        bits = cv_bits(cv_as_int(v));
    }
    if (prim.prim_is_integer(t)) {
        *out = int_from_truncated(bits, t);
        return true;
    }
    if (t == prim.prim_kind.prim_char && v.kind != cval_kind.cv_bool) {
        *out = cv_from_char(bits & CV_CHAR_MAX);
        return true;
    }
    // not to bool, not bool to char, not bool to float
    *out = cv_none();
    return false;
}

// Casts a float `v` to integer type `t`. It truncates toward zero and saturates
// to the range of `t`, as the run-time intrinsic does. No constant is a NaN.
// Thus, the NaN row of that rule has no case here.
fn float_to_int(cval v, prim.prim_kind t, cval mut* out) bool {
    bool mut neg = false;
    u64 mut mag = 0;
    bool inside = flt.flt_to_int(v.fbits, &neg, &mag);
    u64 width = int_width(t);
    u64 one = 1;
    u64 mut limit = U64_MAX;
    if (prim.prim_is_signed(t)) {
        // The magnitude of the least value of a signed type is one above its
        // largest value.
        limit = one << (width - 1);
        if (!neg) {
            limit -= 1;
        }
    } else if (neg) {
        // A negative value saturates at zero: an unsigned type holds none.
        limit = 0;
    } else if (width != WORD_BITS) {
        limit = (one << width) - 1;
    }
    if (!inside || mag > limit) {
        mag = limit;
    }
    *out = int_make(neg, mag);
    return true;
}

// ---- float folding -------------------------------------------------------------

// The four operations on two constants in the float type `t`, each rounding the
// exact result once. An integer or char operand first converts to `t`. Thus, an
// integer with a float folds as a float. Returns false and cv_none for a
// non-finite operand or result. Division by zero also returns false and cv_none.
// No constant exists for these cases.
fn cv_float_add(cval a, cval b, prim.prim_kind t, cval mut* out) bool {
    u64 mut x = 0;
    u64 mut y = 0;
    u64 mut r = 0;
    *out = cv_none();
    if (!cv_to_float_bits(a, t, &x) || !cv_to_float_bits(b, t, &y)) {
        return false;
    }
    if (!flt.flt_add(x, y, is_f32(t), &r)) {
        return false;
    }
    *out = cv_from_float(r);
    return true;
}

fn cv_float_sub(cval a, cval b, prim.prim_kind t, cval mut* out) bool {
    u64 mut x = 0;
    u64 mut y = 0;
    u64 mut r = 0;
    *out = cv_none();
    if (!cv_to_float_bits(a, t, &x) || !cv_to_float_bits(b, t, &y)) {
        return false;
    }
    if (!flt.flt_sub(x, y, is_f32(t), &r)) {
        return false;
    }
    *out = cv_from_float(r);
    return true;
}

fn cv_float_mul(cval a, cval b, prim.prim_kind t, cval mut* out) bool {
    u64 mut x = 0;
    u64 mut y = 0;
    u64 mut r = 0;
    *out = cv_none();
    if (!cv_to_float_bits(a, t, &x) || !cv_to_float_bits(b, t, &y)) {
        return false;
    }
    if (!flt.flt_mul(x, y, is_f32(t), &r)) {
        return false;
    }
    *out = cv_from_float(r);
    return true;
}

fn cv_float_div(cval a, cval b, prim.prim_kind t, cval mut* out) bool {
    u64 mut x = 0;
    u64 mut y = 0;
    u64 mut r = 0;
    *out = cv_none();
    if (!cv_to_float_bits(a, t, &x) || !cv_to_float_bits(b, t, &y)) {
        return false;
    }
    if (!flt.flt_div(x, y, is_f32(t), &r)) {
        return false;
    }
    *out = cv_from_float(r);
    return true;
}

// Unary minus flips the sign bit of a float constant. This is exact in both
// formats. It is not subtraction from zero because they differ for zero and NaN.
fn cv_float_neg(cval v) cval {
    return cv_from_float(flt.flt_neg(cv_float_bits(v)));
}

// ---- typed folding -------------------------------------------------------------

// Each cv_typed_* and cv_wrap_* function requires value operands of integer type
// `t`. Another value indicates a checker defect, not a program error. This
// function fails instead of folding cv_typed_and(-1, 5, u8) to 5. A shift count
// is not a value operand. Any integer type is accepted there, so shifts guard
// only their left operand.
fn require_typed(cval v, prim.prim_kind t) void {
    require_int(v);
    if (!int_fits(v, t)) {
        panic("consts: typed constant folding on a value outside its type");
    }
}

// The typed result of an exact operation: `ok` and in the range of `t`.
fn typed_check(bool ok, cval r, prim.prim_kind t, cval mut* out) bool {
    if (!ok || !int_fits(r, t)) {
        *out = cv_none();
        return false;
    }
    *out = r;
    return true;
}

fn cv_typed_add(cval a, cval b, prim.prim_kind t, cval mut* out) bool {
    require_typed(a, t);
    require_typed(b, t);
    cval mut r = cv_none();
    return typed_check(cv_add(a, b, &r), r, t, out);
}

fn cv_typed_sub(cval a, cval b, prim.prim_kind t, cval mut* out) bool {
    require_typed(a, t);
    require_typed(b, t);
    cval mut r = cv_none();
    return typed_check(cv_sub(a, b, &r), r, t, out);
}

fn cv_typed_mul(cval a, cval b, prim.prim_kind t, cval mut* out) bool {
    require_typed(a, t);
    require_typed(b, t);
    cval mut r = cv_none();
    return typed_check(cv_mul(a, b, &r), r, t, out);
}

fn cv_typed_div(cval a, cval b, prim.prim_kind t, cval mut* out) bool {
    require_typed(a, t);
    require_typed(b, t);
    // MIN / -1 is 2^(w-1), which the range check rejects
    cval mut r = cv_none();
    return typed_check(cv_div(a, b, &r), r, t, out);
}

fn cv_typed_rem(cval a, cval b, prim.prim_kind t, cval mut* out) bool {
    // MIN % -1 is 0 exactly but a run-time error
    cval mut q = cv_none();
    cval mut r = cv_none();
    return typed_check(cv_typed_div(a, b, t, &q) && cv_rem(a, b, &r), r, t, out);
}

fn cv_typed_neg(cval a, prim.prim_kind t, cval mut* out) bool {
    require_typed(a, t);
    if (!prim.prim_is_signed(t)) {
        // the checker never asks to negate an unsigned constant
        panic("consts.cv_typed_neg: unary minus on an unsigned type");
    }
    cval mut r = cv_none();
    return typed_check(cv_neg(a, &r), r, t, out);
}

// `~` complements the bits of the width, so `~0` is 4294967295 in u32.
fn cv_typed_not(cval a, prim.prim_kind t, cval mut* out) bool {
    // The complement within the width: -a - 1 modulo 2^width.
    require_typed(a, t);
    *out = int_from_truncated(~cv_bits(a), t);
    return true;
}

fn cv_typed_and(cval a, cval b, prim.prim_kind t, cval mut* out) bool {
    require_typed(a, t);
    require_typed(b, t);
    cval mut r = cv_none();
    return typed_check(cv_and(a, b, &r), r, t, out);
}

fn cv_typed_or(cval a, cval b, prim.prim_kind t, cval mut* out) bool {
    require_typed(a, t);
    require_typed(b, t);
    cval mut r = cv_none();
    return typed_check(cv_or(a, b, &r), r, t, out);
}

fn cv_typed_xor(cval a, cval b, prim.prim_kind t, cval mut* out) bool {
    require_typed(a, t);
    require_typed(b, t);
    cval mut r = cv_none();
    return typed_check(cv_xor(a, b, &r), r, t, out);
}

// A shift count for the width of `t`: 0..width-1, else false.
fn typed_shift_count(cval count, prim.prim_kind t, u64 mut* n) bool {
    require_int(count);
    if (count.neg || count.mag >= int_width(t)) {
        return false;
    }
    *n = count.mag;
    return true;
}

fn cv_typed_shl(cval a, cval count, prim.prim_kind t, cval mut* out) bool {
    require_typed(a, t);
    u64 mut n = 0;
    if (!typed_shift_count(count, t, &n)) {
        *out = cv_none();
        return false;
    }
    // the bits shifted out are discarded, so this wraps by design
    *out = int_from_truncated(cv_bits(a) << n, t);
    return true;
}

fn cv_typed_shr(cval a, cval count, prim.prim_kind t, cval mut* out) bool {
    require_typed(a, t);
    u64 mut n = 0;
    if (!typed_shift_count(count, t, &n)) {
        *out = cv_none();
        return false;
    }
    // The operand fits `t`, so the exact floor division is the arithmetic
    // shift of a signed type and the logical shift of an unsigned one.
    cval mut r = cv_none();
    return typed_check(cv_shr(a, count, &r), r, t, out);
}

// `+% -% *%` on constants of the integer type `t` (both operands fit `t`):
// two's-complement wrapping at the width of `t`; never false. The three sums use
// wrapping operators because they compute wrapping. A checked `+` would trap on
// an input that this rule defines.
fn cv_wrap_add(cval a, cval b, prim.prim_kind t) cval {
    require_typed(a, t);
    require_typed(b, t);
    return int_from_truncated(cv_bits(a) +% cv_bits(b), t);
}

fn cv_wrap_sub(cval a, cval b, prim.prim_kind t) cval {
    require_typed(a, t);
    require_typed(b, t);
    return int_from_truncated(cv_bits(a) -% cv_bits(b), t);
}

fn cv_wrap_mul(cval a, cval b, prim.prim_kind t) cval {
    require_typed(a, t);
    require_typed(b, t);
    return int_from_truncated(cv_bits(a) *% cv_bits(b), t);
}

// ---- diagnostics ---------------------------------------------------------------

// Escapes one byte in a literal delimited by `quote`. It uses source escapes for
// `\n \t \r \0 \\` and the delimiter. Other nonprintable bytes use `\xHH`.
fn escape_char(u64 code, char quote, strbuf.str_buf mut* out) void {
    if (code == cast(quote, u64)) {
        strbuf.push(out, '\\');
        strbuf.push(out, quote);
        return;
    }
    switch (code) {
    case '\n':
        strbuf.append(out, "\\n");
        return;
    case '\t':
        strbuf.append(out, "\\t");
        return;
    case '\r':
        strbuf.append(out, "\\r");
        return;
    case 0:
        strbuf.append(out, "\\0");
        return;
    case '\\':
        strbuf.append(out, "\\\\");
        return;
    default:
        break;
    }
    if (code >= ASCII_PRINT_MIN && code <= ASCII_PRINT_MAX) {
        strbuf.push(out, cast(code, char));
        return;
    }
    strbuf.append(out, "\\x");
    strbuf.push(out, HEX_DIGITS[(code >> HEX_SHIFT) & HEX_MASK]);
    strbuf.push(out, HEX_DIGITS[code & HEX_MASK]);
}

fn char_to_str(u64 code, strbuf.str_buf mut* out) void {
    strbuf.push(out, '\'');
    escape_char(code, '\'', out);
    strbuf.push(out, '\'');
}

// The bytes of a string literal between double quotes, escaped as they would be
// written in source, so a diagnostic stays on one line.
fn str_to_str(string s, strbuf.str_buf mut* out) void {
    strbuf.push(out, '"');
    u64 mut k = 0;
    while (k < s.len) {
        escape_char(cast(s[k], u64), '"', out);
        k += 1;
    }
    strbuf.push(out, '"');
}

/// Appends the source-like diagnostic spelling of `v`.
/// It escapes char and string values so that each diagnostic stays on one line.
/// A float value breaks the precondition because this function has no float spelling.
fn cv_to_str(cval v, strbuf.str_buf mut* out) void {
    switch (v.kind) {
    case cval_kind.cv_float:
        panic("consts.cv_to_str: a float constant has no text form");
    case cval_kind.cv_none:
        strbuf.append(out, "<none>");
        return;
    case cval_kind.cv_int:
        if (v.neg) {
            strbuf.push(out, '-');
        }
        strbuf.append_u64(out, v.mag);
        return;
    case cval_kind.cv_bool:
        if (v.mag != 0) {
            strbuf.append(out, "true");
        } else {
            strbuf.append(out, "false");
        }
        return;
    case cval_kind.cv_char:
        char_to_str(v.mag, out);
        return;
    case cval_kind.cv_null:
        strbuf.append(out, "null");
        return;
    case cval_kind.cv_str:
        str_to_str(v.str, out);
        return;
    }
    strbuf.append(out, "<none>");
}
