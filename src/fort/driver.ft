// driver: the compiler driver (toolchain.md 1 and 2, D14.1, D14.3): the
// command line, the front end and the exit statuses.
//
// run parses the options of D14.1, answers `--help` and `--version`, reports
// the usage errors of toolchain.md 1 in the words src/bootstrap/driver.c
// reports them, and dispatches: `--tokens` lexes the entry file alone and
// writes its tokens, `--ast` parses it alone and writes its syntax tree, and
// every other run goes through the front end, which reads the entry file and
// walks the import closure (module-system.md 2, 10). A run that would need
// the checker or the emitter -- the steps 3 and 4 of toolchain.md 2, which
// T-035 and the tickets after it port -- is reported as an internal error
// rather than pretending to build something, and exits 2 like every other
// usage, toolchain or internal error (D14.1). A file whose lexer, parser or
// loader reported anything exits 1 before that point, which is the compile
// error of D14.1.
//
// Every pass takes a session (session.ft): it owns the pool they intern into,
// the sink they report to and the source texts they read, and freeing it frees
// the analysis. The driver creates one per run, which is also what makes a
// second run in one process -- a language server re-analysing a document
// (D20.5) -- independent of the first. Nothing here is module-level mutable
// state and nothing below main.ft ends the process.
//
// Dispatch: none. Option parsing is a chain of comparisons over the argument
// list, in the order src/bootstrap/driver.c walks it, so the two compilers
// answer one command line alike. The tables of function pointers belong to
// the parser and the emitter (D3.10).
import ast;
import check;
import check_stmt;
import consts;
import containers;
import diag;
import lexer;
import modules;
import parser;
import prim;
import session;
import std.io;
import std.libc;
import std.str;
import std.strbuf;
import std.sys;
import types;

// prim, consts and types are the checker's and are reached through it; they
// are imported so that they are inside the import closure of main.ft, which is
// what makes stage1 compile them into stage2 with every build rather than only
// under the fort-modules ctest.

// The usage line of toolchain.md 1, printed by --help and after every usage
// error. A module constant is UPPER_CASE (D1.4).
string USAGE = "usage: fort [options] entry.ft";

// The version printed by --version, as src/bootstrap/driver.h spells it; the
// `stage-usage` ctest holds the two against each other.
string VERSION = "0.1.0";

// The exit statuses of D14.1: usage, toolchain and internal errors share 2.
i32 EXIT_OK = 0;
i32 EXIT_COMPILE_ERROR = 1;
i32 EXIT_USAGE = 2;

// The outcome of parse: the command line is in *opts, --help or --version was
// printed, or a usage error was reported.
i32 PARSE_OK = 0;
i32 PARSE_DONE = 1;
i32 PARSE_ERROR = 2;

// The system's text for the failing call, which is what a `cannot read` line
// carries as its reason (toolchain.md 1), and the reader of the symbolic link
// that names the running binary, which is where the standard library is
// looked for (D14.1). Both are the C library's; the standard library has no
// binding for either and this is their one caller (D9.8).
extern fn char* strerror(i32 code);
extern fn i64 readlink(char* path, char* buf, u64 size);

// The command line after parsing (toolchain.md 1). Every string borrows an
// argument; the three vectors hold them in command-line order and own only
// their slots.
struct options {
    bool have_entry; // whether an entry file was seen; C compares against NULL
    string entry;
    string output;   // -o, empty for the default
    // Whether --std-dir was given, which a fort `string` cannot say on its
    // own: src/bootstrap/driver.c compares the option against NULL, so an
    // explicit `--std-dir ""` is a directory that was named and is empty, and
    // not an option left out. Reading the length instead made stage2 fall
    // back to $FORT_STD_DIR and to `std` beside the binary on a command line
    // stage1 answers with the empty root, so stage2 resolved imports stage1
    // refuses.
    bool have_std_dir;
    string std_dir;  // --std-dir, read only when have_std_dir
    string cc;       // --cc
    string target;   // --target
    bool emit_ir;         // -S
    bool compile_only;    // -c
    bool release;         // --release
    bool no_bounds_check; // --no-bounds-check
    bool check;           // --check: the front end alone (D20.1)
    bool json;            // --json: the document of D20.2 on stdout
    bool index;           // --index: the identifier index of D20.3 in it
    bool tokens;          // --tokens: the entry file's tokens on stdout (D14.1)
    bool ast;             // --ast: the entry file's syntax tree on stdout (D14.1)
    containers.str_vec includes; // -I roots, searched in command-line order (D9.2)
    containers.str_vec libs;     // -l<lib> as given, passed to the linker in order
    containers.str_vec cc_args;  // -Xcc arguments, passed verbatim after the rest
}

// The defaults of toolchain.md 1: `--cc` is a clang because nothing else
// reads LLVM IR (D14.1, D19.1) and the target triple is x86_64-linux-gnu.
string DEFAULT_CC = "clang";
string DEFAULT_TARGET = "x86_64-linux-gnu";

fn options options_create() {
    options mut opts = options{};
    opts.cc = DEFAULT_CC;
    opts.target = DEFAULT_TARGET;
    return opts;
}

// Releases the vectors' slots. The strings are borrowed and are untouched.
fn void options_free(options mut* opts) {
    containers.str_free(&opts->includes);
    containers.str_free(&opts->libs);
    containers.str_free(&opts->cc_args);
}

// What --help prints after the usage line: the option table of toolchain.md 1.
// It is the table src/bootstrap/driver.c prints, line for line, and the ctest
// `stage-usage` diffs the two binaries' --help and --version so that the two
// copies cannot drift while both compilers exist.
fn void help() {
    println(USAGE);
    println("options:");
    println("  -o <file>          write the output to <file> (default a.out)");
    println("  -S                 stop after emitting the LLVM IR module <entry>.ll");
    println("  -c                 stop after compiling that module to <entry>.o");
    println("  -I <dir>           add a module search root; repeatable, in order");
    println("  --std-dir <dir>    the standard library directory");
    println("  --release          release mode");
    println("  --no-bounds-check  remove the index and span checks; unsafe");
    println("  -l<lib>            pass -l<lib> to the linker; repeatable, in order");
    println("  --cc <path>        the clang that compiles and links the IR (default clang)");
    println("  --target <triple>  pass --target=<triple> to --cc (default x86_64-linux-gnu)");
    println("  -Xcc <arg>         pass <arg> to --cc verbatim; repeatable, in order");
    println("  --check            run the front end only and stop; emit nothing");
    println("  --json             write the check document to stdout; needs --check");
    println("  --index            fill the document's identifier index; implies --check --json");
    println("  --tokens           write the entry file's tokens to stdout and stop");
    println("  --ast              write the entry file's syntax tree to stdout and stop");
    println("  --help             print this help and exit");
    println("  --version          print the compiler version and exit");
}

// `fort: error: <message>` on stderr, the form every usage, toolchain and
// internal error takes (toolchain.md 1, D14.1).
fn void error(string message) {
    eprintln("fort: error: ", message);
}

// `fort: error: <what> '<path>': <reason>`, the form of
// `cannot read 'x.ft': No such file or directory` (toolchain.md 1).
fn void error_path(string what, string path, string reason) {
    eprintln("fort: error: ", what, " '", path, "': ", reason);
}

// A usage error, followed by the usage line (toolchain.md 1).
fn void usage_error(string message) {
    error(message);
    eprintln(USAGE);
}

// The same with the offending argument quoted after the message.
fn void usage_error_arg(string message, string detail) {
    eprintln("fort: error: ", message, " '", detail, "'");
    eprintln(USAGE);
}

// Whether `arg` is an option rather than the entry file: the first argument
// that does not start with '-' is the entry file (D14.1).
fn bool is_option(string arg) {
    return arg.len > 0 && arg[0] == '-';
}

// Whether `arg` is `-l<lib>`: the library is part of the option, so it is one
// argument, unlike every other option that carries a value (D14.1).
fn bool is_link_option(string arg) {
    return arg.len > 2 && arg[0] == '-' && arg[1] == 'l';
}

// The argument of an option that takes the following one; false after
// reporting the usage error. *i is left on the argument. -o, -I, --std-dir,
// --cc, --target and -Xcc take the following argument, whatever it looks like
// (D14.1).
fn bool take_argument(string@ args, u64 mut* i, string mut* out) {
    if (*i + 1 >= args.len) {
        usage_error_arg("missing argument for option", args[*i]);
        return false;
    }
    *i += 1;
    *out = args[*i];
    return true;
}

// The options that carry no value: -S, -c, --release, --no-bounds-check,
// --check, --json, --index, --tokens and --ast, each of which sets one flag
// (D14.1, D20.1, D20.2, D20.3).
fn bool parse_flag(options mut* opts, string arg) {
    if (arg == "-S") {
        opts->emit_ir = true;
    } else if (arg == "-c") {
        opts->compile_only = true;
    } else if (arg == "--release") {
        opts->release = true;
    } else if (arg == "--no-bounds-check") {
        opts->no_bounds_check = true;
    } else if (arg == "--check") {
        opts->check = true;
    } else if (arg == "--json") {
        opts->json = true;
    } else if (arg == "--index") {
        // --index implies --check and --json, so it is the whole command line
        // an editor gives the compiler (D20.3).
        opts->index = true;
        opts->check = true;
        opts->json = true;
    } else if (arg == "--tokens") {
        // --tokens lexes the entry file and stops there, so it implies
        // nothing and combines with nothing (D14.1).
        opts->tokens = true;
    } else if (arg == "--ast") {
        // --ast parses the entry file and stops there, so it implies nothing
        // and combines with nothing either (D14.1).
        opts->ast = true;
    } else {
        return false;
    }
    return true;
}

// The options that take the following argument. Returns false when `arg` is
// not one of them; *ok is false when the argument was missing. The last -o,
// --std-dir, --cc and --target win, while -I, -l and -Xcc accumulate in
// command-line order (D14.1, toolchain.md 1).
fn bool parse_valued(options mut* opts, string@ args, u64 mut* i, bool mut* ok) {
    string arg = args[*i];
    bool is_output = arg == "-o";
    bool is_include = arg == "-I";
    bool is_std_dir = arg == "--std-dir";
    bool is_cc = arg == "--cc";
    bool is_target = arg == "--target";
    bool is_cc_arg = arg == "-Xcc";
    if (!is_output && !is_include && !is_std_dir && !is_cc && !is_target && !is_cc_arg) {
        return false;
    }
    string mut value = "";
    if (!take_argument(args, i, &value)) {
        *ok = false;
        return true;
    }
    if (is_output) {
        opts->output = value;
    } else if (is_include) {
        containers.str_push(&opts->includes, value);
    } else if (is_std_dir) {
        opts->have_std_dir = true;
        opts->std_dir = value;
    } else if (is_cc) {
        opts->cc = value;
    } else if (is_target) {
        opts->target = value;
    } else {
        containers.str_push(&opts->cc_args, value);
    }
    return true;
}

// Parses args[1..] into *opts, which options_create has prepared. --help and
// --version print to stdout; a usage error prints `fort: error: <message>`
// and the usage line to stderr (toolchain.md 1).
fn i32 parse(options mut* opts, string@ args) {
    u64 mut i = 1;
    while (i < args.len) {
        string arg = args[i];
        if (!is_option(arg)) {
            // The first argument that does not start with '-' is the entry
            // file (D14.1); a second one is a usage error.
            if (opts->have_entry) {
                usage_error_arg("unexpected argument", arg);
                return PARSE_ERROR;
            }
            opts->have_entry = true;
            opts->entry = arg;
        } else if (arg == "--help") {
            help();
            return PARSE_DONE;
        } else if (arg == "--version") {
            println("fort ", VERSION);
            return PARSE_DONE;
        } else if (is_link_option(arg)) {
            containers.str_push(&opts->libs, arg);
        } else if (!parse_flag(opts, arg)) {
            bool mut ok = true;
            if (!parse_valued(opts, args, &i, &ok)) {
                usage_error_arg("unknown option", arg);
                return PARSE_ERROR;
            }
            if (!ok) {
                return PARSE_ERROR;
            }
        }
        i += 1;
    }
    if (!opts->have_entry) {
        usage_error("no entry file");
        return PARSE_ERROR;
    }
    if (opts->tokens && (opts->check || opts->json || opts->index)) {
        // --tokens stops before the parser, so there is no front end for
        // --check to run and no document for --json to write (D14.1).
        usage_error("--tokens does not combine with --check, --json or --index");
        return PARSE_ERROR;
    }
    if (opts->ast && (opts->tokens || opts->check || opts->json || opts->index)) {
        // --ast stops before the checker and after the lexer, so there is no
        // front end for --check and no dump for --tokens to write (D14.1).
        usage_error("--ast does not combine with --tokens, --check, --json or --index");
        return PARSE_ERROR;
    }
    if (opts->json && !opts->check) {
        // A build spawns a `--cc` that inherits stdout, so only the check mode
        // can promise a complete document or nothing (D20.2).
        usage_error("--json requires --check");
        return PARSE_ERROR;
    }
    return PARSE_OK;
}

// --tokens lexes the entry file alone -- no import is resolved and nothing is
// parsed -- and writes one line per token to stdout in the form of
// toolchain.md 1. A lexical error is reported on stderr as usual and lexing
// goes on (D14.2), so the dump covers the whole file either way; the status is
// then the compile error of D14.1.
fn i32 tokens_entry(options* opts) {
    // The session the lexer takes: it owns the sink the diagnostics go to and
    // the pool the decoded strings are interned in, and freeing it frees them
    // (D20.5).
    session.session mut s = session.create();
    defer session.free(&s);
    string mut source = "";
    if (!session.read_source(&s, opts->entry, &source)) {
        error_path("cannot read", opts->entry, str.from_cstr(strerror(sys.errno())));
        return EXIT_USAGE;
    }
    // A batch driver writes the text form of every diagnostic as it arrives,
    // which the library leaves off (D14.2, D20.2).
    diag.set_text(session.diags(&s), true);
    lexer.tok_vec mut toks = lexer.tokvec_create();
    defer lexer.tokvec_free(&toks);
    bool clean = lexer.lex_file(&s, opts->entry, source, &toks);
    strbuf.str_buf mut dump = strbuf.create();
    defer strbuf.free(&dump);
    lexer.tok_dump(&toks, &dump);
    print(strbuf.view(&dump));
    if (clean) {
        return EXIT_OK;
    }
    return EXIT_COMPILE_ERROR;
}

// --ast lexes and parses the entry file alone -- no import is resolved and
// nothing is checked -- and writes its syntax tree to stdout as one
// S-expression followed by one newline, in the form of toolchain.md 1. A
// lexical error costs the lexer its line and a syntax error costs the parser
// its construct, and both go on (D14.2), so the tree covers the whole file
// either way; the status is then the compile error of D14.1.
fn i32 ast_entry(options* opts) {
    // The session the lexer and the parser take: it owns the sink the
    // diagnostics go to and the pool the decoded strings are interned in, and
    // freeing it frees them (D20.5).
    session.session mut s = session.create();
    defer session.free(&s);
    string mut source = "";
    if (!session.read_source(&s, opts->entry, &source)) {
        error_path("cannot read", opts->entry, str.from_cstr(strerror(sys.errno())));
        return EXIT_USAGE;
    }
    // A batch driver writes the text form of every diagnostic as it arrives,
    // which the library leaves off (D14.2, D20.2).
    diag.set_text(session.diags(&s), true);
    lexer.tok_vec mut toks = lexer.tokvec_create();
    defer lexer.tokvec_free(&toks);
    lexer.lex_file(&s, opts->entry, source, &toks);
    // The tokens cover the whole file whatever the lexer reported, so the
    // parse runs either way (D14.2).
    ast.arena mut ar = ast.arena{};
    defer ast.ast_arena_free(&ar);
    ast.node mut* mod = parser.parse_module(&s, opts->entry, &toks, &ar);
    strbuf.str_buf mut dump = strbuf.create();
    defer strbuf.free(&dump);
    ast.ast_dump(mod, &dump);
    strbuf.push(&dump, '\n');
    print(strbuf.view(&dump));
    if (session.error_count(&s) == 0) {
        return EXIT_OK;
    }
    return EXIT_COMPILE_ERROR;
}

// ---- the standard library directory (toolchain.md 1) ------------------------------

// The symbolic link naming the running binary, and the buffer sizes the
// driver reads it with.
string PROC_SELF_EXE = "/proc/self/exe";
u64 EXE_PATH_FIRST_CAP = 256;
u64 EXE_PATH_MAX_CAP = 65536;

// The standard library sits in `std` beside the binary when --std-dir and
// $FORT_STD_DIR name nothing (D14.1).
string STD_DIR_NAME = "std";

// The path of the running binary, read from /proc/self/exe; false when it
// cannot be read, with *out unchanged. readlink does not terminate the path
// and reports truncation only by filling the buffer, so the buffer doubles
// until the result fits. The result is interned in `p`.
fn bool exe_path(containers.pool mut* p, string mut* out) {
    char mut@ own c_path = str.to_cstr(PROC_SELF_EXE);
    defer del(c_path);
    u64 mut cap = EXE_PATH_FIRST_CAP;
    while (cap <= EXE_PATH_MAX_CAP) {
        char mut@ own buf = new(char, cap);
        defer del(buf);
        i64 len = readlink(c_path.ptr, buf.ptr, cap);
        if (len < 0) {
            return false;
        }
        if (cast(len, u64) < cap) {
            *out = containers.pool_intern(p, cast(buf[0..cast(len, u64)], string));
            return true;
        }
        cap = cap * 2;
    }
    return false;
}

// `std` in the directory containing `program`, or `std` alone when `program`
// has no directory part (D14.1). Interned in `p`.
fn string std_dir_beside(containers.pool mut* p, string program) {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    i64 last = str.last_index_of(program, '/');
    if (last >= 0) {
        strbuf.append(&b, program[0..cast(last, u64) + 1]);
    }
    strbuf.append(&b, STD_DIR_NAME);
    return containers.pool_intern(p, strbuf.view(&b));
}

// The standard library directory (toolchain.md 1): --std-dir, else
// $FORT_STD_DIR, else `std` beside the fort binary, which is /proc/self/exe
// when it can be read and `program` otherwise. An empty environment value
// names no directory, so it counts as unset. Interned in `p`.
fn string std_dir(containers.pool mut* p, options* opts, string program) {
    // The option as it was given, the empty one included: it was named, so
    // nothing below it is consulted (D14.1).
    if (opts->have_std_dir) {
        return containers.pool_intern(p, opts->std_dir);
    }
    string mut from_env = "";
    if (sys.env("FORT_STD_DIR", &from_env) && from_env.len > 0) {
        return containers.pool_intern(p, from_env);
    }
    // Else `std` in the directory containing the fort binary (D14.1), which
    // is /proc/self/exe on the Linux the compiler runs on and targets.
    string mut running = "";
    if (exe_path(p, &running)) {
        return std_dir_beside(p, running);
    }
    // Without /proc, args[0] names the binary; one without a slash was found
    // through PATH, whose directory the driver cannot know, so `std` in the
    // current directory is the last resort.
    return std_dir_beside(p, program);
}

// ---- the front end (toolchain.md 2, steps 1 and 2) ---------------------------------

// What a front-end run leaves behind: the modules it read, which own every
// syntax tree. The checker joins this value when T-035 lands, and the reason
// it is a value of the caller's is the one src/bootstrap/driver.h gives: every
// annotation on a tree points into the checker, so the caller releases the
// analysis only after the last pass that reads a tree. The session that read
// the sources outlives it, since a module's source and every name in its tree
// point into the session's storage.
struct analysis {
    modules.module_set set;
    check.checker ck;
}

// The analysis of one run: the modules it will read and the checker that will
// annotate their trees. src/bootstrap/driver.c's driver_analysis_init does the
// same two calls; the checker takes the session here because it reports
// through it, where the C reports through a file-scope sink (D20.5).
fn analysis analysis_create(session.session mut* s) {
    analysis mut an = analysis{};
    check.check_init(&an.ck, s);
    return an;
}

fn void analysis_free(analysis mut* an) {
    check.check_free(&an->ck);
    modules.free(&an->set);
}

// Steps 1 and 2 of toolchain.md 2: the entry file's module path and root,
// then the import closure, with the search roots of D9.2 in order. Returns
// false after the diagnostics of D14.2 were reported.
fn bool load_closure(session.session mut* s, options* opts, string program, analysis mut* an) {
    u64 mut i = 0;
    while (i < opts->includes.len) {
        // The `-I` roots come after the entry file's directory, in
        // command-line order (D9.2).
        modules.add_root(&an->set, containers.str_at(&opts->includes, i));
        i += 1;
    }
    containers.pool mut p = containers.pool_create();
    defer containers.pool_free(&p);
    // A path beginning with `std` is looked up in the standard library
    // directory alone (D9.2), which --std-dir, $FORT_STD_DIR or the binary's
    // own directory names (D14.1).
    modules.set_std_dir(&an->set, std_dir(&p, opts, program));
    return modules.load(s, &an->set, opts->entry);
}

// Whether the entry file can be opened, which is step 1 of toolchain.md 2:
// src/bootstrap/driver.c opens it with fopen and closes it again, and asks no
// more than that, so an entry file that opens and does not read -- a
// directory, whose read(2) is EISDIR -- passes here and is reported by the
// loader as the compile error of D14.2 rather than as a usage error. Reading
// the whole file here instead made stage2 answer `fort: error: cannot read
// '<dir>': Is a directory` and exit 2 where stage1 answers
// `<dir>:1:1: error: cannot read '<dir>'` and exits 1.
fn bool entry_opens(string path) {
    i32 fd = io.open_read(path);
    if (fd < 0) {
        return false;
    }
    io.close(fd);
    return true;
}

// The front end of toolchain.md 2 as far as this compiler goes: read the
// entry file, then parse the import closure (module-system.md 10). An
// entry file that cannot be opened is exit 2 and a diagnostic of D14.2 is
// exit 1 (D14.1); a closure that loaded cleanly would be the checker's and
// the emitter's turn, which is the internal error of `run` below.
fn i32 front_end(session.session mut* s, options* opts, string program, analysis mut* an) {
    // Step 1 of toolchain.md 2 (D14.1). The bytes are not read here: the
    // loader reads every file through the session, so the closure below opens
    // it once and a server's unsaved buffer is what the whole run sees
    // (D20.5).
    if (!entry_opens(opts->entry)) {
        error_path("cannot read", opts->entry, str.from_cstr(strerror(sys.errno())));
        return EXIT_USAGE;
    }
    // A batch driver writes the text form of every diagnostic as it arrives,
    // which the library leaves off (D14.2, D20.2).
    diag.set_text(session.diags(s), true);
    bool loaded = load_closure(s, opts, program, an);
    // Step 3: every module that parsed is checked, the dependency order
    // first, so one file that did not parse never hides the errors of the
    // others (D9.10, D14.2 as amended).
    //
    // Neither the modules nor the checker is released here: the annotations
    // they own live until the caller frees the analysis, which is what will
    // let the emitter and an index walk read the trees afterwards (D20.3,
    // ast.sym). A compilation builds a program, so the entry module defines
    // main (D8.6); --check inspects one module instead, and the entry rule
    // does not apply to it (D20.1).
    an->ck.require_main = !opts->check;
    bool checked = check_stmt.check_program(&an->ck, &an->set);
    if (!loaded || !checked || session.error_count(s) > 0) {
        // At least one compile error was reported, which is exit 1 (D14.1).
        return EXIT_COMPILE_ERROR;
    }
    return EXIT_OK;
}

// A build, or `--check`: the front end, and then the passes this compiler
// does not carry yet. The session and the analysis die here, in that order of
// declaration and the reverse order of release, since every name of a tree
// points into the session (D20.5).
fn i32 compile_entry(options* opts, string program) {
    session.session mut s = session.create();
    defer session.free(&s);
    analysis mut an = analysis_create(&s);
    defer analysis_free(&an);
    i32 status = front_end(&s, opts, program, &an);
    if (status != EXIT_OK) {
        return status;
    }
    if (opts->check && !opts->json) {
        // --check stops after the front end: no module is emitted, and the
        // file was a module under inspection rather than a program (D20.1).
        return EXIT_OK;
    }
    // An internal error is not a usage error, so no usage line follows it:
    // toolchain.md 1 puts that line after the six errors that report a
    // command line the compiler cannot use, and this command line is fine.
    // What is missing is the document of D20.2, which needs the JSON writer
    // and the index walk, and the emitter of toolchain.md 2 step 4.
    error("internal error: this compiler cannot build a program yet");
    return EXIT_USAGE;
}

// ---- the pipeline (toolchain.md 2) --------------------------------------------------

// Runs the compiler with args[1..]; returns the process exit status (D14.1).
fn i32 run(string@ args) {
    // fort with no arguments prints one usage line and exits with 2
    // (toolchain.md 1).
    if (args.len < 2) {
        eprintln(USAGE);
        return EXIT_USAGE;
    }
    options mut opts = options_create();
    defer options_free(&opts);
    i32 parsed = parse(&opts, args);
    if (parsed == PARSE_ERROR) {
        return EXIT_USAGE;
    }
    if (parsed == PARSE_DONE) {
        return EXIT_OK;
    }
    // --tokens stops after the lexer and --ast after the parser; every other
    // run goes through the front end (D14.1, D20.1).
    if (opts.tokens) {
        return tokens_entry(&opts);
    }
    if (opts.ast) {
        return ast_entry(&opts);
    }
    return compile_entry(&opts, args[0]);
}
