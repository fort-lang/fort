// driver: the compiler driver (toolchain.md 1 and 2): the command line, the
// front end and the exit statuses.
// D14.1, D14.3
//
// run parses the options and answers `--help` and `--version`. It reports the
// common usage errors of toolchain.md 1 in the words src/bootstrap/driver.c
// uses, and reports source-only configuration errors. `--tokens` lexes the
// entry file alone and writes its tokens. `--ast` parses it alone and writes
// its syntax tree. Every other run goes through the front end, which reads the
// entry file and walks the import closure (module-system.md 2, 10). A run that
// would need the checker or the emitter -- steps 3 and 4 of toolchain.md 2 --
// reports an internal error instead of pretending to build something. It
// exits 2 like each usage, toolchain or internal error. A file whose lexer,
// parser or loader reports anything exits 1 before that point.
// D14.1
//
// Every pass takes a session (session.ft): it owns the pool they intern into,
// the sink they report to and the source texts they read, and freeing it frees
// the analysis. The driver creates one per run, which is also what makes a
// second run in one process -- a language server re-analysing a document --
// independent of the first. Nothing here is module-level mutable state and
// nothing below main.ft ends the process.
// D20.5
//
// Dispatch: none. Common options follow the order src/bootstrap/driver.c uses,
// so both compilers answer the common command interface alike. `--cfg` and its
// errors belong to the source compiler. The parser and emitter own the tables
// of function pointers.
// D3.10
import ast;
import check;
import check_stmt;
import consts;
import containers;
import diag;
import gen;
import gen_stmt;
import index;
import json;
import lexer;
import modules;
import parser;
import prim;
import session;
import std.io;
import std.libc;
import std.os;
import std.str;
import std.strbuf;
import std.sys;
import types;

// prim, consts, and types belong to the checker. These imports put them inside
// the main.ft closure for each product compiler build.

/// The usage line of toolchain.md 1, printed by --help and after every usage
/// error.
/// D1.4: a module constant is UPPER_CASE
string USAGE = "usage: fort [options] entry.ft";

/// The version printed by --version.
string VERSION = "0.1.0";

/// The exit statuses: usage, toolchain and internal errors share 2.
/// D14.1
i32 EXIT_OK = 0;
i32 EXIT_COMPILE_ERROR = 1;
i32 EXIT_USAGE = 2;

/// The outcome of parse: the command line is in *opts, --help or --version was
/// printed, or a usage error was reported.
i32 PARSE_OK = 0;
i32 PARSE_DONE = 1;
i32 PARSE_ERROR = 2;

/// The system's text for the failing call, which is what a `cannot read` line
/// carries as its reason (toolchain.md 1). It is the C library's; the standard
/// library has no binding for it and this is its one caller.
/// D9.8, D14.1
extern fn strerror(i32 code) char*;


/// The temporary directory of toolchain.md 2 and the removal of what the driver
/// put in it; the standard library has no binding for any of them and this is
/// their one caller. `mkdtemp` replaces the six `X` at the end of its argument in
/// place, so the buffer it is given is the compiler's own.
/// D9.8, D13.2
extern fn mkdtemp(char mut* tmpl) char*;
extern fn unlink(char* path) i32;
extern fn rmdir(char* path) i32;

/// Running --cc once over the module. src/bootstrap/driver.c calls posix_spawnp
/// with `environ`, which fort cannot name: an `extern` declares a function and
/// never a variable. `fork` and `execvp` say the same thing -- `execvp` searches
/// PATH and hands the child the caller's environment, which is what
/// posix_spawnp(..., environ) does -- and the pipe below carries back the errno of
/// a failed `execvp`, which is the value posix_spawnp would have returned, so the
/// two drivers report one command line alike.
/// D9.8, D14.3
extern fn fork() i32;
extern fn execvp(char* file, void* argv) i32;
extern fn waitpid(i32 pid, i32 mut* status, i32 options) i32;
extern fn pipe(i32 mut* fds) i32;
extern fn _exit(i32 status) noreturn;

/// The command line after parsing (toolchain.md 1). Every string borrows an
/// argument; the five vectors hold them in command-line order and own only
/// their slots.
struct options {
    bool have_entry; // whether an entry file was seen; C compares against NULL
    string entry;
    /// Whether -o was given, which a fort `string` cannot say on its own, and
    /// the third option src/bootstrap/driver.c compares against NULL, beside
    /// --std-dir below and the entry file above. `fort -o "" main.ft` names an
    /// output of no characters. A length test would fall back to `a.out` and
    /// exit 0 instead of passing the empty name to --cc.
    bool have_output;
    string output; // -o, read only when have_output
    /// Whether --std-dir was given, which a fort `string` cannot say on its
    /// own: src/bootstrap/driver.c compares the option against NULL, so an
    /// explicit `--std-dir ""` is a directory that was named and is empty, and
    /// not an option left out. Reading the length instead falls back to
    /// $FORT_STD_DIR or to `std` beside the binary.
    bool have_std_dir;
    string std_dir;  // --std-dir, read only when have_std_dir
    string cc;       // --cc
    string target;   // --target
    bool emit_ir;         // -S
    bool compile_only;    // -c
    bool release;         // --release
    bool no_bounds_check; // --no-bounds-check
    bool check; // D20.1: --check: the front end alone
    bool json; // D20.2: --json, the document on stdout
    bool index; // D20.3: --index, the identifier index in it
    bool tokens; // D14.1: --tokens: the entry file's tokens on stdout
    bool ast; // D14.1: --ast: the entry file's syntax tree on stdout
    containers.str_vec includes; // D9.2: -I roots, searched in command-line order
    containers.str_vec libs;     // -l<lib> as given, passed to the linker in order
    containers.str_vec cc_args;  // -Xcc arguments, passed verbatim after the rest
    containers.str_vec cfg_keys; // --cfg keys, unique and in command-line order
    containers.str_vec cfg_values; // values at the matching positions
}

fn options_create() options {
    options mut opts = options{};
    opts.cc = DEFAULT_CC;
    opts.target = os.TARGET;
    return opts;
}

/// Releases the vectors' slots. The strings are borrowed and are untouched.
fn options_free(options mut* opts) void {
    containers.str_free(&opts->includes);
    containers.str_free(&opts->libs);
    containers.str_free(&opts->cc_args);
    containers.str_free(&opts->cfg_keys);
    containers.str_free(&opts->cfg_values);
}

/// What --help prints after the usage line: the option table of toolchain.md 1.
fn help() void {
    println(USAGE);
    println("options:");
    println("  -o <file>          write the output to <file> (default a.out)");
    println("  -S                 stop after emitting the LLVM IR module <entry>.ll");
    println("  -c                 stop after compiling that module to <entry>.o");
    println("  -I <dir>           add a module search root; repeatable, in order");
    println("  --std-dir <dir>    the standard library directory");
    println("  --release          release mode");
    println("  --no-bounds-check  remove the index and span checks; unsafe");
    println("  -l<lib>            pass -l<lib> to the linker; repeatable, in order");
    println("  --cc <path>        the clang that compiles and links the IR (default ",
            DEFAULT_CC, ")");
    println("  --target <triple>  pass --target=<triple> to --cc (default ",
            os.TARGET, ")");
    println("  --cfg <list>       set key=value pairs; repeatable");
    println("  -Xcc <arg>         pass <arg> to --cc verbatim; repeatable, in order");
    println("  --check            run the front end only and stop; emit nothing");
    println("  --json             write the check document to stdout; needs --check");
    println("  --index            fill the document's identifier index; implies --check --json");
    println("  --tokens           write the entry file's tokens to stdout and stop");
    println("  --ast              write the entry file's syntax tree to stdout and stop");
    println("  --help             print this help and exit");
    println("  --version          print the compiler version and exit");
}

/// `fort: error: <message>` on stderr, the form every usage, toolchain and
/// internal error takes (toolchain.md 1).
/// D14.1
fn error(string message) void {
    eprintln("fort: error: ", message);
}

/// `fort: error: <what> '<path>': <reason>`, the form of
/// `cannot read 'x.ft': No such file or directory` (toolchain.md 1).
fn error_path(string what, string path, string reason) void {
    eprintln("fort: error: ", what, " '", path, "': ", reason);
}

/// A usage error, followed by the usage line (toolchain.md 1).
fn usage_error(string message) void {
    error(message);
    eprintln(USAGE);
}

/// The same with the offending argument quoted after the message.
fn usage_error_arg(string message, string detail) void {
    eprintln("fort: error: ", message, " '", detail, "'");
    eprintln(USAGE);
}

/// Whether `arg` is an option rather than the entry file: the first argument
/// that does not start with '-' is the entry file.
/// D14.1
fn is_option(string arg) bool {
    return arg.len > 0 && arg[0] == '-';
}

/// Whether `arg` is `-l<lib>`: the library is part of the option, so it is one
/// argument, unlike every other option that carries a value.
/// D14.1
fn is_link_option(string arg) bool {
    return arg.len > 2 && arg[0] == '-' && arg[1] == 'l';
}

/// The argument of an option that takes the following one; false after
/// reporting the usage error. *i is left on the argument. -o, -I, --std-dir,
/// --cc, --target, --cfg and -Xcc take the following argument, whatever it
/// looks like (toolchain.md 1).
/// D14.1
fn take_argument(string@ args, u64 mut* i, string mut* out) bool {
    if (*i + 1 >= args.len) {
        usage_error_arg("missing argument for option", args[*i]);
        return false;
    }
    *i += 1;
    *out = args[*i];
    return true;
}

fn reserved_cfg(string key) bool {
    return key == "target_os" || key == "target_arch" || key == "target_abi";
}

fn valid_cfg_key(string key) bool {
    if (key.len == 0 || !(str.is_alpha(key[0]) || key[0] == '_')) {
        return false;
    }
    u64 mut i = 1;
    while (i < key.len) {
        if (!(str.is_alpha(key[i]) || str.is_digit(key[i]) || key[i] == '_')) {
            return false;
        }
        i += 1;
    }
    return lexer.keyword_kind(key) == lexer.tok_kind.ident && !lexer.is_reserved_word(key);
}

fn has_cfg(options* opts, string key) bool {
    u64 mut i = 0;
    while (i < opts->cfg_keys.len) {
        if (containers.str_at(&opts->cfg_keys, i) == key) {
            return true;
        }
        i += 1;
    }
    return false;
}

/// Parses one comma-separated `--cfg` value. A value can hold `=` and can be
/// empty. A comma always starts a new assignment.
fn parse_cfg(options mut* opts, string list) bool {
    u64 mut start = 0;
    while (start <= list.len) {
        u64 mut end = start;
        while (end < list.len && list[end] != ',') {
            end += 1;
        }
        if (end == start) {
            usage_error("empty --cfg list entry");
            return false;
        }
        string item = list[start..end];
        i64 equal = str.index_of(item, '=');
        if (equal < 0) {
            usage_error_arg("invalid --cfg assignment", item);
            return false;
        }
        string key = item[..cast(equal, u64)];
        string value = item[cast(equal, u64) + 1..];
        if (!valid_cfg_key(key)) {
            usage_error_arg("invalid --cfg key", key);
            return false;
        }
        if (reserved_cfg(key)) {
            usage_error_arg("cannot override compiler configuration key", key);
            return false;
        }
        if (has_cfg(opts, key)) {
            usage_error_arg("duplicate --cfg key", key);
            return false;
        }
        containers.str_push(&opts->cfg_keys, key);
        containers.str_push(&opts->cfg_values, value);
        if (end == list.len) {
            return true;
        }
        start = end + 1;
    }
    return true;
}

/// The options that carry no value: -S, -c, --release, --no-bounds-check,
/// --check, --json, --index, --tokens and --ast, each of which sets one flag.
/// D14.1, D20.1, D20.2, D20.3
fn parse_flag(options mut* opts, string arg) bool {
    if (arg == "-S") {
        opts->emit_ir = true;
    } else if (arg == "-c") {
        opts->compile_only = true;
    } else if (arg == "--release") {
        opts->release = true;
    } else if (arg == "--no-bounds-check") {
        opts->no_bounds_check = true;
    } else if (arg == "--check") {
        opts->check = true;
    } else if (arg == "--json") {
        opts->json = true;
    } else if (arg == "--index") {
        // D20.3: --index implies --check and --json
        opts->index = true;
        opts->check = true;
        opts->json = true;
    } else if (arg == "--tokens") {
        // D14.1: --tokens implies nothing and combines with nothing
        opts->tokens = true;
    } else if (arg == "--ast") {
        // D14.1: --ast implies nothing and combines with nothing either
        opts->ast = true;
    } else {
        return false;
    }
    return true;
}

/// The options that take the following argument. Returns false when `arg` is not
/// one of them; *ok is false when the argument was missing. The last -o,
/// --std-dir, --cc and --target win, while -I, --cfg, -l and -Xcc accumulate
/// in command-line order. A duplicate configuration key is an error.
/// D14.1
fn parse_valued(options mut* opts, string@ args, u64 mut* i, bool mut* ok) bool {
    string arg = args[*i];
    bool is_output = arg == "-o";
    bool is_include = arg == "-I";
    bool is_std_dir = arg == "--std-dir";
    bool is_cc = arg == "--cc";
    bool is_target = arg == "--target";
    bool is_cfg = arg == "--cfg";
    bool is_cc_arg = arg == "-Xcc";
    if (!is_output && !is_include && !is_std_dir && !is_cc && !is_target && !is_cfg
        && !is_cc_arg) {
        return false;
    }
    string mut value = "";
    if (!take_argument(args, i, &value)) {
        *ok = false;
        return true;
    }
    if (is_output) {
        opts->have_output = true;
        opts->output = value;
    } else if (is_include) {
        containers.str_push(&opts->includes, value);
    } else if (is_std_dir) {
        opts->have_std_dir = true;
        opts->std_dir = value;
    } else if (is_cc) {
        opts->cc = value;
    } else if (is_target) {
        opts->target = value;
    } else if (is_cfg) {
        if (!parse_cfg(opts, value)) {
            *ok = false;
        }
    } else {
        containers.str_push(&opts->cc_args, value);
    }
    return true;
}

/// Parses args[1..] into *opts, which options_create has prepared. --help and
/// --version print to stdout; a usage error prints `fort: error: <message>`
/// and the usage line to stderr (toolchain.md 1).
fn parse(options mut* opts, string@ args) i32 {
    u64 mut i = 1;
    while (i < args.len) {
        string arg = args[i];
        if (!is_option(arg)) {
            // D14.1: the first argument that does not start with '-'
            if (opts->have_entry) {
                usage_error_arg("unexpected argument", arg);
                return PARSE_ERROR;
            }
            opts->have_entry = true;
            opts->entry = arg;
        } else if (arg == "--help") {
            help();
            return PARSE_DONE;
        } else if (arg == "--version") {
            println("fort ", VERSION);
            return PARSE_DONE;
        } else if (is_link_option(arg)) {
            containers.str_push(&opts->libs, arg);
        } else if (!parse_flag(opts, arg)) {
            bool mut ok = true;
            if (!parse_valued(opts, args, &i, &ok)) {
                usage_error_arg("unknown option", arg);
                return PARSE_ERROR;
            }
            if (!ok) {
                return PARSE_ERROR;
            }
        }
        i += 1;
    }
    if (!opts->have_entry) {
        usage_error("no entry file");
        return PARSE_ERROR;
    }
    if (opts->tokens && (opts->check || opts->json || opts->index)) {
        // D14.1: --tokens stops before the parser
        usage_error("--tokens does not combine with --check, --json or --index");
        return PARSE_ERROR;
    }
    if (opts->ast && (opts->tokens || opts->check || opts->json || opts->index)) {
        // D14.1: --ast stops before the checker
        usage_error("--ast does not combine with --tokens, --check, --json or --index");
        return PARSE_ERROR;
    }
    if (opts->json && !opts->check) {
        // D20.2: a build spawns a `--cc` that inherits stdout
        usage_error("--json requires --check");
        return PARSE_ERROR;
    }
    return PARSE_OK;
}

/// Whether the target has one of the two forms in toolchain.md 1.
/// D14.1
fn target_form(string target) bool {
    if (target == "x86_64-linux-gnu") {
        return true;
    }
    string prefix = "arm64-apple-macosx";
    if (!str.starts_with(target, prefix)) {
        return false;
    }
    u64 mut i = prefix.len;
    u64 mut digits = 0;
    u64 mut dots = 0;
    while (i < target.len) {
        if (str.is_digit(target[i])) {
            digits += 1;
        } else if (target[i] == '.' && digits > 0 && dots < 2) {
            dots += 1;
            digits = 0;
        } else {
            return false;
        }
        i += 1;
    }
    return dots == 2 && digits > 0;
}

/// Adds the compiler keys and the user keys to the one analysis session.
fn configure(session.session mut* s, options* opts) void {
    if (opts->target == "x86_64-linux-gnu") {
        session.config_set(s, "target_os", "linux");
        session.config_set(s, "target_arch", "x86_64");
    } else {
        session.config_set(s, "target_os", "macos");
        session.config_set(s, "target_arch", "aarch64");
    }
    session.config_set(s, "target_abi", "");
    u64 mut i = 0;
    while (i < opts->cfg_keys.len) {
        session.config_set(s, containers.str_at(&opts->cfg_keys, i),
                           containers.str_at(&opts->cfg_values, i));
        i += 1;
    }
}

// The default --cc on both targets: the clang that PATH finds (D14.1, D14.3).
string DEFAULT_CC = "clang";

/// Rejects a target that this IR mode cannot use before it creates output.
/// The front-end modes do not call this function.
/// D14.1
fn target_allowed(options* opts) bool {
    if (!target_form(opts->target)) {
        usage_error_arg("unsupported target", opts->target);
        return false;
    }
    if (opts->target == os.TARGET) {
        return true;
    }
    if (opts->emit_ir) {
        if (opts->have_std_dir) {
            return true;
        }
        usage_error("--std-dir is required for cross-target -S");
    } else if (opts->compile_only) {
        eprintln("fort: error: cannot compile object for target '", opts->target,
                 "' with a '", os.TARGET, "' compiler");
        eprintln(USAGE);
    } else {
        eprintln("fort: error: cannot link target '", opts->target,
                 "' with a '", os.TARGET, "' compiler");
        eprintln(USAGE);
    }
    return false;
}

/// --tokens lexes the entry file alone -- no import is resolved and nothing is
/// parsed -- and writes one line per token to stdout in the form of toolchain.md
/// 1. A lexical error is reported on stderr as usual and lexing goes on, so the
/// dump covers the whole file either way; the status is then a compile error.
/// D14.1, D14.2
fn tokens_entry(options* opts) i32 {
    // D20.5: the session owns the sink and the pool, and frees both
    session.session mut s = session.create();
    defer session.free(&s);
    string mut source = "";
    if (!session.read_source(&s, opts->entry, &source)) {
        error_path("cannot read", opts->entry, str.from_cstr(strerror(sys.errno())));
        return EXIT_USAGE;
    }
    // D14.2, D20.2: a batch driver writes the text form as it arrives
    diag.set_text(session.diags(&s), true);
    lexer.tok_vec mut toks = lexer.tokvec_create();
    defer lexer.tokvec_free(&toks);
    bool clean = lexer.lex_file(&s, opts->entry, source, &toks);
    strbuf.str_buf mut dump = strbuf.create();
    defer strbuf.free(&dump);
    lexer.tok_dump(&toks, &dump);
    print(strbuf.view(&dump));
    if (clean) {
        return EXIT_OK;
    }
    return EXIT_COMPILE_ERROR;
}

/// --ast lexes and parses the entry file alone -- no import is resolved and
/// nothing is checked -- and writes its syntax tree to stdout as one S-expression
/// followed by one newline, in the form of toolchain.md 1. A lexical error costs
/// the lexer its line and a syntax error costs the parser its construct, and both
/// go on, so the tree covers the whole file either way; the status is then a
/// compile error.
/// D14.1, D14.2
fn ast_entry(options* opts) i32 {
    // D20.5: the session owns the sink and the pool, and frees both
    session.session mut s = session.create();
    defer session.free(&s);
    string mut source = "";
    if (!session.read_source(&s, opts->entry, &source)) {
        error_path("cannot read", opts->entry, str.from_cstr(strerror(sys.errno())));
        return EXIT_USAGE;
    }
    // D14.2, D20.2: a batch driver writes the text form as it arrives
    diag.set_text(session.diags(&s), true);
    lexer.tok_vec mut toks = lexer.tokvec_create();
    defer lexer.tokvec_free(&toks);
    lexer.lex_file(&s, opts->entry, source, &toks);
    // D14.2: the tokens cover the whole file, so the parse runs
    ast.arena mut ar = ast.arena{};
    defer ast.ast_arena_free(&ar);
    ast.node mut* mod = parser.parse_module(&s, opts->entry, &toks, &ar);
    strbuf.str_buf mut dump = strbuf.create();
    defer strbuf.free(&dump);
    ast.ast_dump(mod, &dump);
    strbuf.push(&dump, '\n');
    print(strbuf.view(&dump));
    if (session.error_count(&s) == 0) {
        return EXIT_OK;
    }
    return EXIT_COMPILE_ERROR;
}

// ---- the standard library directory (toolchain.md 1) ------------------------------

/// The standard library sits in `std` beside the binary when --std-dir and
/// $FORT_STD_DIR name nothing.
/// D14.1
string STD_DIR_NAME = "std";

/// The path of the running binary; false when the OS cannot give it.
/// Linux reads /proc/self/exe. Mac reads dyld's path and resolves it with
/// realpath when possible. *out stays unchanged on failure. The path is
/// interned in `p`.
fn exe_path(containers.pool mut* p, string mut* out) bool {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    if (!os.exe_path(&b)) {
        return false;
    }
    *out = containers.pool_intern(p, strbuf.view(&b));
    return true;
}

/// `std` in the directory containing `program`, or `std` alone when `program`
/// has no directory part. Interned in `p`.
/// D14.1
fn std_dir_beside(containers.pool mut* p, string program) string {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    i64 last = str.last_index_of(program, '/');
    if (last >= 0) {
        strbuf.append(&b, program[0..cast(last, u64) + 1]);
    }
    strbuf.append(&b, STD_DIR_NAME);
    return containers.pool_intern(p, strbuf.view(&b));
}

/// The standard library directory (toolchain.md 1): --std-dir, else
/// $FORT_STD_DIR, else `std` beside the fort binary. Linux reads /proc/self/exe.
/// Mac reads dyld's executable path. An empty environment value
/// names no directory, so it counts as unset. Interned in `p`.
fn std_dir(containers.pool mut* p, options* opts, string program) string {
    // D14.1: the option as given, the empty one included
    if (opts->have_std_dir) {
        return containers.pool_intern(p, opts->std_dir);
    }
    string mut from_env = "";
    if (sys.env("FORT_STD_DIR", &from_env) && from_env.len > 0) {
        return containers.pool_intern(p, from_env);
    }
    // D14.1: else `std` beside the fort binary, read from /proc/self/exe
    string mut running = "";
    if (exe_path(p, &running)) {
        return std_dir_beside(p, running);
    }
    // Without /proc, args[0] names the binary; one without a slash was found
    // through PATH, whose directory the driver cannot know, so `std` in the
    // current directory is the last resort.
    return std_dir_beside(p, program);
}

// ---- paths (toolchain.md 1, 2) ------------------------------------------------------

/// The default output when -o is absent, and the two names the temporary
/// directory of toolchain.md 2 is built from. src/bootstrap/driver.h spells
/// the first two as macros and driver.c the rest as file-scope arrays.
string DEFAULT_OUTPUT = "a.out";
string TMP_DIR_DEFAULT = "/tmp";
string TMP_DIR_TEMPLATE = "/fort-XXXXXX";
string IR_SUFFIX = ".ll";
string OBJECT_SUFFIX = ".o";
string FT_SUFFIX = ".ft";

/// EINTR, the one errno the driver compares against: a signal caught while
/// --cc runs interrupts the wait and not the child (waitpid(2)).
i32 EINTR = 4;

/// The position after the last '/' of `path`, that is the start of its last
/// component.
fn last_component(string path) u64 {
    u64 mut start = 0;
    u64 mut i = 0;
    while (i < path.len) {
        if (path[i] == '/') {
            start = i + 1;
        }
        i += 1;
    }
    return start;
}

/// The entry file's last component with `.ft` removed, which names the IR
/// module and the default object (toolchain.md 1).
/// D9.1
fn entry_base(string entry) string {
    string mut base = entry[last_component(entry)..];
    if (base.len > FT_SUFFIX.len && str.ends_with(base, FT_SUFFIX)) {
        base = base[0..base.len - FT_SUFFIX.len];
    }
    return base;
}

/// `<dir>/<name><suffix>`, interned in `p`; an empty directory or suffix is
/// left out, where src/bootstrap/driver.c passes NULL.
fn join_path(containers.pool mut* p, string dir, string name, string suffix) string {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    if (dir.len > 0) {
        strbuf.append(&b, dir);
        strbuf.push(&b, '/');
    }
    strbuf.append(&b, name);
    strbuf.append(&b, suffix);
    return containers.pool_intern(p, strbuf.view(&b));
}

fn default_output(containers.pool mut* p, options* opts) string {
    // -S and -c together stop at the IR, so -S decides the suffix
    // (toolchain.md 1).
    if (opts->emit_ir) {
        return join_path(p, "", entry_base(opts->entry), IR_SUFFIX);
    }
    if (opts->compile_only) {
        return join_path(p, "", entry_base(opts->entry), OBJECT_SUFFIX);
    }
    return containers.pool_intern(p, DEFAULT_OUTPUT);
}

// ---- the temporary directory (toolchain.md 2) ------------------------------------

/// Creates the temporary directory with mkdtemp under $TMPDIR, `/tmp` by
/// default; the path is interned in `p` and the directory it was created in is
/// stored in *parent_out. Returns the empty string and the errno of the
/// failure in *error_out, captured before anything else can overwrite it.
fn make_temp_dir(containers.pool mut* p, string mut* parent_out, i32 mut* error_out) string {
    string mut parent = TMP_DIR_DEFAULT;
    string mut value = "";
    // An empty value names no directory, so it counts as unset (toolchain.md 1).
    if (sys.env("TMPDIR", &value) && value.len > 0) {
        parent = value;
    }
    *parent_out = parent;
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, parent);
    strbuf.append(&b, TMP_DIR_TEMPLATE);
    // D13.4: mkdtemp replaces the six X in place, so this is our own
    char mut@ own tmpl = str.to_cstr(strbuf.view(&b));
    defer del(tmpl);
    *error_out = 0;
    if (mkdtemp(&tmpl[0]) == null) {
        *error_out = sys.errno();
        return "";
    }
    return containers.pool_intern(p, str.from_cstr(&tmpl[0]));
}

/// Removes the temporary directory and the module in it, whether or not --cc
/// succeeded (toolchain.md 2). The compiler writes exactly one file there, one
/// `<entry>.ll`, so no directory walk is needed; a file already gone is not an
/// error.
/// D19.1
fn remove_temp_dir(string dir, string ir_path) void {
    if (ir_path.len > 0) {
        char mut@ own path = str.to_cstr(ir_path);
        defer del(path);
        unlink(&path[0]);
    }
    char mut@ own d = str.to_cstr(dir);
    defer del(d);
    rmdir(&d[0]);
}

// ---- the clang invocation --------------------------------------------------------
// D14.3

/// The command line --cc is run with, in the order src/bootstrap/driver.c
/// builds it; every string is interned in `p` or borrowed from the options, so
/// the vector owns only its slots.
fn cc_argv(containers.pool mut* p, options* opts, string ir_path, string out_path,
                containers.str_vec mut* argv) void {
    containers.str_push(argv, opts->cc);
    containers.str_push(argv, join_path(p, "", "--target=", opts->target));
    // -O2 in place of -O1 under --release; the compiler itself optimizes
    // nothing (toolchain.md 3).
    // D14.3: -O2 under --release; the compiler optimizes nothing
    if (opts->release) {
        containers.str_push(argv, "-O2");
    } else {
        containers.str_push(argv, "-O1");
    }
    containers.str_push(argv, "-fPIE");
    // The module carries its own target triple, which clang would warn about
    // (toolchain.md 2).
    containers.str_push(argv, "-Wno-override-module");
    if (opts->compile_only) {
        containers.str_push(argv, "-c");
    }
    containers.str_push(argv, "-o");
    containers.str_push(argv, out_path);
    // The one input is the module, which holds the whole program, the runtime
    // included. No -x ir: clang reads a `.ll` by its suffix and -x is sticky
    // (toolchain.md 2).
    // D9.10, D13.1
    containers.str_push(argv, ir_path);
    if (!opts->compile_only) {
        u64 mut i = 0;
        while (i < opts->libs.len) {
            containers.str_push(argv, containers.str_at(&opts->libs, i));
            i += 1;
        }
    }
    // D14.1: -Xcc arguments come last, verbatim and in order
    u64 mut k = 0;
    while (k < opts->cc_args.len) {
        containers.str_push(argv, containers.str_at(&opts->cc_args, k));
        k += 1;
    }
}

/// The bytes of every argument, each NUL-terminated, and a NULL-terminated array
/// of pointers into them: what execvp takes. src/bootstrap/driver.c pushes the
/// arguments as C strings it already has; a fort `string` is a pointer and a
/// length and is not NUL-terminated, so they are copied here, once, into storage
/// the caller releases.
/// D3.7
struct cc_command {
    char mut@ own bytes;      // every argument, each followed by its NUL
    char mut* mut@ own items; // one pointer per argument, then null
}

fn cc_command_build(containers.str_vec* argv) cc_command {
    u64 mut total = 0;
    u64 mut i = 0;
    while (i < argv->len) {
        total += containers.str_at(argv, i).len + 1;
        i += 1;
    }
    cc_command mut c = cc_command{};
    c.bytes = new(char, total);
    c.items = new(char mut*, argv->len + 1);
    u64 mut at = 0;
    i = 0;
    while (i < argv->len) {
        string arg = containers.str_at(argv, i);
        c.items[i] = &c.bytes[at];
        u64 mut k = 0;
        while (k < arg.len) {
            c.bytes[at] = arg[k];
            at += 1;
            k += 1;
        }
        c.bytes[at] = '\0';
        at += 1;
        i += 1;
    }
    c.items[argv->len] = null;
    return c;
}

fn cc_command_free(cc_command mut* c) void {
    del(c->bytes);
    del(c->items);
}

/// `cc failed with status N`, or `cc failed with signal N` for a --cc that
/// died by a signal, which toolchain.md 1 does not name.
fn error_cc_status(string what, i64 value) void {
    strbuf.str_buf mut m = strbuf.create();
    defer strbuf.free(&m);
    strbuf.append(&m, "cc failed with ");
    strbuf.append(&m, what);
    strbuf.push(&m, ' ');
    strbuf.append_i64(&m, value);
    error(strbuf.view(&m));
}

/// The three wait(2) macros, which have no fort spelling: a status byte of
/// 0x7F means stopped, 0 means exited, anything else is the terminating
/// signal, and an exit status is the second byte (waitpid(2)).
u32 WAIT_SIGNAL_MASK = 127;
u32 WAIT_STATUS_SHIFT = 8;
u32 WAIT_STATUS_MASK = 255;

fn wait_signaled(i32 status) bool {
    u32 low = cast(status, u32) & WAIT_SIGNAL_MASK;
    return low != 0 && low != WAIT_SIGNAL_MASK;
}

fn wait_signal(i32 status) i64 {
    return cast(cast(status, u32) & WAIT_SIGNAL_MASK, i64);
}

fn wait_status(i32 status) i64 {
    return cast((cast(status, u32) >> WAIT_STATUS_SHIFT) & WAIT_STATUS_MASK, i64);
}

/// The errno of a failed execvp, written by the child and read by the parent,
/// four bytes little end first. Nothing else is ever written to that pipe, so
/// a short read means the child reached execvp and a full one means it did
/// not.
u64 ERRNO_BYTES = 4;
u64 BYTE_BITS = 8;
u64 BYTE_MASK = 255;

/// F_SETFD and FD_CLOEXEC of fcntl(2): the write end of the pipe closes at
/// execvp, which is what tells the parent the exec succeeded.
i32 F_SETFD = 2;
i32 FD_CLOEXEC = 1;

/// The status a child that could not exec leaves behind, which no --cc of
/// ours ever reports, since the parent reads the errno off the pipe first.
i32 EXEC_FAILED_STATUS = 127;

/// Runs --cc once over the module: it compiles and links in one invocation.
/// Returns EXIT_OK, or EXIT_USAGE after reporting the failure.
/// D14.1, D14.3
fn run_cc(options* opts, string ir_path, string out_path) i32 {
    containers.pool mut p = containers.pool_create();
    defer containers.pool_free(&p);
    containers.str_vec mut argv = containers.str_create();
    defer containers.str_free(&argv);
    cc_argv(&p, opts, ir_path, out_path, &argv);
    cc_command mut cmd = cc_command_build(&argv);
    defer cc_command_free(&cmd);
    i32[2] mut fds = {};
    if (pipe(&fds[0]) != 0) {
        error_path("cannot run", opts->cc, str.from_cstr(strerror(sys.errno())));
        return EXIT_USAGE;
    }
    if (libc.fcntl(fds[1], F_SETFD, FD_CLOEXEC) != 0) {
        // The write end has to close at execvp: that is what tells the parent
        // the exec succeeded. A write end left open in --cc and in every
        // process it starts would keep the read below blocked until the last
        // one exits, which is a wait and not a wrong answer, so it is reported
        // here rather than left to be read as a missing errno.
        error_path("cannot run", opts->cc, str.from_cstr(strerror(sys.errno())));
        io.close(fds[0]);
        io.close(fds[1]);
        return EXIT_USAGE;
    }
    i32 child = fork();
    if (child < 0) {
        i32 failure = sys.errno();
        io.close(fds[0]);
        io.close(fds[1]);
        error_path("cannot run", opts->cc, str.from_cstr(strerror(failure)));
        return EXIT_USAGE;
    }
    if (child == 0) {
        // The child replaces itself with --cc; reaching the line after
        // execvp means it could not, so the errno goes back up the pipe and
        // the parent reports it exactly as posix_spawnp's result.
        io.close(fds[0]);
        execvp(&cmd.bytes[0], cast(&cmd.items[0], void*));
        u64 e = cast(sys.errno(), u64);
        u8[4] mut buf = {};
        u64 mut i = 0;
        while (i < ERRNO_BYTES) {
            buf[i] = cast((e >> (i * BYTE_BITS)) & BYTE_MASK, u8);
            i += 1;
        }
        io.write_all(fds[1], buf[0..ERRNO_BYTES]);
        _exit(EXEC_FAILED_STATUS);
    }
    io.close(fds[1]);
    u8[4] mut got = {};
    i64 read = io.read(fds[0], got[0..ERRNO_BYTES]);
    io.close(fds[0]);
    i32 mut status = 0;
    // The child is reaped whatever it did, so no zombie outlives the run. A
    // signal caught while clang runs interrupts the wait, not the child.
    i32 mut waited = waitpid(child, &status, 0);
    while (waited < 0 && sys.errno() == EINTR) {
        waited = waitpid(child, &status, 0);
    }
    if (read == cast(ERRNO_BYTES, i64)) {
        u64 mut e = 0;
        u64 mut i = 0;
        while (i < ERRNO_BYTES) {
            e |= cast(got[i], u64) << (i * BYTE_BITS);
            i += 1;
        }
        error_path("cannot run", opts->cc, str.from_cstr(strerror(cast(e, i32))));
        return EXIT_USAGE;
    }
    if (waited < 0) {
        error_path("cannot wait for", opts->cc, str.from_cstr(strerror(sys.errno())));
        return EXIT_USAGE;
    }
    if (wait_signaled(status)) {
        error_cc_status("signal", wait_signal(status));
        return EXIT_USAGE;
    }
    if (wait_status(status) != 0) {
        error_cc_status("status", wait_status(status));
        return EXIT_USAGE;
    }
    return EXIT_OK;
}

// ---- the front end (toolchain.md 2, steps 1 and 2) ---------------------------------

/// What a front-end run leaves behind: the modules it read, which own every
/// syntax tree, and the checker that annotates them. The reason it is a value of
/// the caller's is the one src/bootstrap/driver.h gives: every annotation on a
/// tree points into the checker, so the caller releases the analysis only after
/// the last pass that reads a tree. The session that read the sources outlives it,
/// since a module's source and every name in its tree point into the session's
/// storage.
struct analysis {
    modules.module_set set;
    check.checker ck;
}

/// The analysis of one run: the modules it will read and the checker that will
/// annotate their trees. src/bootstrap/driver.c's driver_analysis_init does the
/// same two calls; the checker takes the session here because it reports through
/// it, where the C reports through a file-scope sink.
/// D20.5
fn analysis_create(session.session mut* s) analysis {
    analysis mut an = analysis{};
    check.check_init(&an.ck, s);
    return an;
}

/// Releases the analysis once, whichever of the two calls below reaches it
/// first: the build path releases it as soon as the emitter returns, and the
/// `defer` answers for the paths that return earlier. The flag is what makes
/// that safe, so that nothing rests on the nine releases of check.check_free
/// and modules.free each tolerating a second call.
fn analysis_release(analysis mut* an, bool mut* live) void {
    if (!*live) {
        return;
    }
    *live = false;
    analysis_free(an);
}

fn analysis_free(analysis mut* an) void {
    check.check_free(&an->ck);
    modules.free(&an->set);
}

/// Steps 1 and 2 of toolchain.md 2: the entry file's module path and root, then
/// the import closure, with the search roots in order. Returns false after the
/// diagnostics were reported.
/// D9.2, D14.2
fn load_closure(session.session mut* s, options* opts, string program, analysis mut* an) bool {
    u64 mut i = 0;
    while (i < opts->includes.len) {
        // D9.2: the `-I` roots follow the entry file's directory
        modules.add_root(&an->set, containers.str_at(&opts->includes, i));
        i += 1;
    }
    containers.pool mut p = containers.pool_create();
    defer containers.pool_free(&p);
    // D9.2, D14.1: `std` is looked up in the standard library directory
    modules.set_std_dir(&an->set, std_dir(&p, opts, program));
    return modules.load(s, &an->set, opts->entry);
}

/// Whether the entry file can be opened, which is step 1 of toolchain.md 2:
/// src/bootstrap/driver.c opens it with fopen and closes it again, and asks no
/// more than that, so an entry file that opens and does not read -- a directory,
/// whose read(2) is EISDIR -- passes here and is reported by the loader as a
/// compile error rather than as a usage error. Reading the whole file here instead
/// made stage2 answer `fort: error: cannot read '<dir>': Is a directory` and exit
/// 2 where stage1 answers `<dir>:1:1: error: cannot read '<dir>'` and exits 1.
/// D14.2
fn entry_opens(string path) bool {
    i32 fd = io.open_read(path);
    if (fd < 0) {
        return false;
    }
    io.close(fd);
    return true;
}

/// The front end of toolchain.md 2 as far as this compiler goes: read the entry
/// file, then parse the import closure (module-system.md 10). An entry file that
/// cannot be opened is exit 2 and a compile diagnostic is exit 1; a closure that
/// loaded cleanly would be the checker's and the emitter's turn, which is the
/// internal error of `run` below.
/// D14.1, D14.2
fn front_end(session.session mut* s, options* opts, string program, analysis mut* an) i32 {
    // Step 1 of toolchain.md 2. The bytes are not read here: the loader reads
    // every file through the session, so the closure below opens it once and a
    // server's unsaved buffer is what the whole run sees.
    // D14.1, D20.5: the loader reads every file through the session
    if (!entry_opens(opts->entry)) {
        error_path("cannot read", opts->entry, str.from_cstr(strerror(sys.errno())));
        return EXIT_USAGE;
    }
    // D14.2, D20.2: --json writes the document and no text line
    diag.set_text(session.diags(s), !opts->json);
    bool loaded = load_closure(s, opts, program, an);
    // Step 3: every module that parsed is checked, the dependency order first, so
    // one file that did not parse never hides the errors of the others.
    //
    // Neither the modules nor the checker is released here: the annotations they own
    // live until the caller frees the analysis, which is what will let the emitter
    // and an index walk read the trees afterwards (ast.sym). A compilation builds a
    // program, so the entry module defines main; --check inspects one module instead,
    // and the entry rule does not apply to it.
    // D8.6, D9.10, D14.2, D20.1, D20.3
    an->ck.require_main = !opts->check;
    bool checked = check_stmt.check_program(&an->ck, &an->set);
    if (!loaded || !checked || session.error_count(s) > 0) {
        // D14.1
        return EXIT_COMPILE_ERROR;
    }
    return EXIT_OK;
}

/// Step 4 of toolchain.md 2: the emitter writes one module for the whole
/// closure (toolchain.md 6). An unwritable path is a toolchain error (exit 2)
/// and a construct the emitter cannot lower yet is a compile error (exit 1), so
/// a half-emitted module never reaches `--cc`. The emitter is initialised at
/// the address it is used at, since it stores the session it reports through
/// (gen.ft).
/// D19.1
fn emit_module(session.session mut* s, options* opts, analysis mut* an, string ir_path) i32 {
    gen.gen_options mut gopts = gen.gen_options{};
    gopts.release = opts->release;
    gopts.no_bounds_check = opts->no_bounds_check;
    gopts.target = opts->target;
    gen.emitter mut g = gen.emitter{};
    gen.gen_init(&g, s, gopts);
    defer gen.gen_free(&g);
    if (!gen_stmt.gen_program(&g, &an->ck, &an->set)) {
        return EXIT_COMPILE_ERROR;
    }
    if (!io.write_file(ir_path, strbuf.bytes(&g.out))) {
        error_path("cannot write", ir_path, str.from_cstr(strerror(sys.errno())));
        return EXIT_USAGE;
    }
    return EXIT_OK;
}

// ---- the document of the check mode (toolchain.md 4.1) -----------------------------
// D20.2

/// "version" is 1 for this form of the document.
/// D20.2
u64 JSON_VERSION = 1;

/// Copies the file of every module the loader read, in that order: the names the
/// module set hands out die with it, so the document is written from copies of its
/// own. src/bootstrap/driver.c keeps the pair as a driver_files_t; a pool and a
/// vector of string say the same thing.
/// D20.2
fn collect_files(containers.pool mut* p, modules.module_set* set,
                      containers.str_vec mut* files) void {
    u64 mut i = 0;
    while (i < modules.file_count(set)) {
        containers.str_push(files, containers.pool_intern(p, modules.file_at(set, i)));
        i += 1;
    }
}

/// Builds the whole document into `out`: the version, the files of the closure,
/// the diagnostics of the run and the identifier index.
/// D20.2
fn build_document(strbuf.str_buf mut* out, session.session mut* s,
                       containers.str_vec* files, index.index* ix) void {
    json.writer mut j = json.writer{};
    json.json_init(&j, out);
    json.json_object_begin(&j);
    json.json_key(&j, "version");
    json.json_uint(&j, JSON_VERSION);
    // D20.2: a client clears the stale diagnostics of a file
    json.json_key(&j, "files");
    json.json_array_begin(&j);
    u64 mut i = 0;
    while (i < files->len) {
        json.json_str(&j, containers.str_at(files, i));
        i += 1;
    }
    json.json_array_end(&j);
    json.json_key(&j, "diagnostics");
    diag.write_json(session.diags(s), &j);
    // D20.3, D20.2: the empty array without --index, always a member
    json.json_key(&j, "symbols");
    index.write_json(ix, &j);
    json.json_object_end(&j);
}

/// Writes the document with one print, so stdout holds a complete document or
/// nothing and a client tells a crash from a verdict. The document is one line
/// ended by a newline (toolchain.md 4.1).
/// D20.2
fn write_document(session.session mut* s, containers.str_vec* files, index.index* ix) void {
    strbuf.str_buf mut doc = strbuf.create();
    defer strbuf.free(&doc);
    build_document(&doc, s, files, ix);
    strbuf.push(&doc, '\n');
    print(strbuf.view(&doc));
}

/// --check --json reports what the front end found as the document on stdout
/// instead of the text diagnostics, and --index fills its identifier index. The
/// document is written only for a verdict: a usage, toolchain or internal error is
/// exit 2 with stdout empty. The analysis is still alive here and is released by
/// the caller, since every record of the index is read out of an annotation
/// (ast.ft).
/// D14.1, D14.2, D20.2, D20.3
fn check_document(session.session mut* s, options* opts, analysis mut* an,
                       containers.pool mut* p) void {
    containers.str_vec mut files = containers.str_create();
    defer containers.str_free(&files);
    collect_files(p, &an->set, &files);
    index.index mut ix = index.create();
    defer index.free(&ix);
    if (opts->index) {
        index.build(&ix, &an->set);
    }
    write_document(s, &files, &ix);
}

/// A build, or `--check`: the front end, and then the passes this compiler does
/// not carry yet. The session and the analysis die here, in that order of
/// declaration and the reverse order of release, since every name of a tree points
/// into the session.
/// D20.5
fn compile_entry(options* opts, string program) i32 {
    if (opts->check && !target_form(opts->target)) {
        usage_error_arg("unsupported target", opts->target);
        return EXIT_USAGE;
    }
    if (!opts->check && !target_allowed(opts)) {
        return EXIT_USAGE;
    }
    containers.pool mut p = containers.pool_create();
    defer containers.pool_free(&p);
    session.session mut s = session.create();
    defer session.free(&s);
    configure(&s, opts);
    // A build reads no tree after the emitter has run, so its analysis is
    // released on every path out of this function (ast.sym). The build path
    // below releases it as soon as the emitter returns and before --cc is
    // spawned; this `defer` answers for the paths that return earlier, and the
    // flag makes exactly one of the two calls do the work.
    analysis mut an = analysis_create(&s);
    bool mut analysis_live = true;
    defer analysis_release(&an, &analysis_live);
    i32 status = front_end(&s, opts, program, &an);
    if (opts->check && opts->json && (status == EXIT_OK || status == EXIT_COMPILE_ERROR)) {
        // D20.2: the document answers for both verdicts, so it goes first
        check_document(&s, opts, &an, &p);
        return status;
    }
    if (status != EXIT_OK) {
        return status;
    }
    if (opts->check) {
        // D20.1: --check stops after the front end, no module emitted
        return EXIT_OK;
    }
    string mut out_path = opts->output;
    if (!opts->have_output) {
        out_path = default_output(&p, opts);
    }
    if (opts->emit_ir) {
        // -S writes the module to the output and stops, so it needs no
        // temporary (toolchain.md 2).
        return emit_module(&s, opts, &an, out_path);
    }
    string mut parent = TMP_DIR_DEFAULT;
    i32 mut failure = 0;
    string dir = make_temp_dir(&p, &parent, &failure);
    if (dir.len == 0) {
        error_path("cannot create a temporary directory in", parent,
                   str.from_cstr(strerror(failure)));
        return EXIT_USAGE;
    }
    string ir_path = join_path(&p, dir, entry_base(opts->entry), IR_SUFFIX);
    i32 mut built = emit_module(&s, opts, &an, ir_path);
    // The analysis dies here and not at the end of the function, as
    // src/bootstrap/driver.c releases it before run_cc: every tree of the
    // closure, every symbol and every type would otherwise stay resident
    // while clang runs, and `fork` gives the child a copy of the page tables,
    // so the peak of a large program doubles for the length of the link.
    analysis_release(&an, &analysis_live);
    if (built == EXIT_OK) {
        built = run_cc(opts, ir_path, out_path);
    }
    remove_temp_dir(dir, ir_path);
    return built;
}

// ---- the pipeline (toolchain.md 2) --------------------------------------------------

/// Runs the compiler with args[1..]; returns the process exit status.
/// D14.1
fn run(string@ args) i32 {
    // fort with no arguments prints one usage line and exits with 2
    // (toolchain.md 1).
    if (args.len < 2) {
        eprintln(USAGE);
        return EXIT_USAGE;
    }
    options mut opts = options_create();
    defer options_free(&opts);
    i32 parsed = parse(&opts, args);
    if (parsed == PARSE_ERROR) {
        return EXIT_USAGE;
    }
    if (parsed == PARSE_DONE) {
        return EXIT_OK;
    }
    // --tokens stops after the lexer and --ast after the parser; every other
    // run goes through the front end of toolchain.md 2.
    // D14.1, D20.1: --tokens stops after the lexer, --ast after the parser
    if (opts.tokens) {
        return tokens_entry(&opts);
    }
    if (opts.ast) {
        return ast_entry(&opts);
    }
    return compile_entry(&opts, args[0]);
}
