/// Runs compiler modes and invokes the selected C compiler.

import ast;
import check;
import check_stmt;
import consts;
import containers;
import diag;
import fir;
import fir_lower;
import fir_parse;
import fir_print;
import fir_verify;
import gen;
import gen_stmt;
import index;
import json;
import lexer;
import modules;
import parser;
import prim;
import session;
import std.io;
import std.libc;
import std.os;
import std.str;
import std.strbuf;
import std.sys;
import types;

// prim, consts, and types belong to the checker. These imports put them inside
// the main.ft closure for each product compiler build.

// The usage line, printed by --help and after every usage
// error.
// Module constants use UPPER_CASE.
string USAGE = "usage: fort [options] entry.ft";

// The version printed by --version.
string VERSION = "0.1.0";

// The option that names the point at which --fir prints, and the names it accepts: the two
// points where FIR changes (spec/fir.md 11, 17.1). Until the passes exist, each name prints the
// same module.
string FIR_AFTER_PREFIX = "--fir-after=";
u64 FIR_PASS_COUNT = 2;
string[FIR_PASS_COUNT] FIR_PASSES = {"lower", "build-mode"};

// The passes that the `//! pass:` directive of a `.fir` test names (spec/fir.md 16.3). `none`
// runs nothing, and `verify` runs the verifier on each function. The build-mode pass does not
// exist yet, so a test that names it is an error of the harness, exit 2, until the pass exists.
string FIR_TEST_NONE = "none";
string FIR_TEST_VERIFY = "verify";
u64 FIR_TEST_LATER_COUNT = 1;
string[FIR_TEST_LATER_COUNT] FIR_TEST_LATER = {"build-mode"};

// The usage error of --fir-test beside another mode. --fir-after sets --fir.
string FIR_TEST_ALONE =
    "--fir-test does not combine with --tokens, --ast, --check, --json, --index or --fir";

// The module path of the prelude of a `.fir` test, which its function names start with.
string FIR_TEST_MODULE = "main";

// The markers of the header lines of a `.fir` test: a directive, and a line of a block.
string DIRECTIVE_MARK = "//!";
string BLOCK_MARK = "//|";

// The exit statuses: usage, toolchain and internal errors share 2.
i32 EXIT_OK = 0;
i32 EXIT_COMPILE_ERROR = 1;
i32 EXIT_USAGE = 2;

// The outcome of parse: the command line is in *opts, --help or --version was
// printed, or a usage error was reported.
i32 PARSE_OK = 0;
i32 PARSE_DONE = 1;
i32 PARSE_ERROR = 2;

// Running --cc once over the module. bootstrap0/src/driver.c calls posix_spawnp with `environ`,
// which fort cannot name: an `extern` declares a function and never a variable. `fork` with
// `execvp` matches posix_spawnp(..., environ). Both search PATH and pass the caller's environment.
// The pipe returns errno when `execvp` fails. Thus, both drivers report the same command failure.

// The parsed command line. Repeated options remain in command-line order.
struct options {
    bool have_entry; // whether an entry file was seen; C compares against NULL
    string entry;
    // States whether -o was given because a fort `string` cannot show this. It matches the third
    // nullable option in bootstrap0/src/driver.c. `fort -o "" main.ft` names an output of no
    // characters. A length test would fall back to `a.out` and exit 0 instead of passing the empty
    // name to --cc.
    bool have_output;
    string output; // -o, read only when have_output
    // States whether --std-dir was given because a fort `string` cannot show this. An explicit
    // `--std-dir ""` names an empty directory. It does not omit the option. Reading the length
    // instead falls back to $FORT_STD_DIR or to `std` beside the binary.
    bool have_std_dir;
    string std_dir;  // --std-dir, read only when have_std_dir
    string cc;       // --cc
    string target;   // --target
    bool emit_ir;         // -S
    bool compile_only;    // -c
    bool release;         // --release
    bool no_bounds_check; // --no-bounds-check
    bool check; // --check: the front end alone
    bool json; // --json, the document on stdout
    bool index; // --index, the identifier index in it
    bool tokens; // --tokens: the entry file's tokens on stdout
    bool ast; // --ast: the entry file's syntax tree on stdout
    bool fir; // --fir, or --fir-after: the program's FIR on stdout
    string fir_after; // the pass of --fir-after, empty without it
    bool fir_test; // --fir-test: the entry is a `.fir` test; run its pass and write the FIR
    containers.str_vec includes; // -I roots, searched in command-line order
    containers.str_vec libs;     // -l<lib> as given, passed to the linker in order
    containers.str_vec cc_args;  // -Xcc arguments, passed verbatim after the rest
    containers.str_vec cfg_keys; // --cfg keys, unique and in command-line order
    containers.str_vec cfg_values; // values at the matching positions
}

fn options_create() options {
    options mut opts = options{};
    opts.cc = DEFAULT_CC;
    opts.target = os.TARGET;
    return opts;
}

fn options_free(options mut* opts) void {
    containers.str_free(&opts->includes);
    containers.str_free(&opts->libs);
    containers.str_free(&opts->cc_args);
    containers.str_free(&opts->cfg_keys);
    containers.str_free(&opts->cfg_values);
}

// What --help prints after the usage line: the option table.
fn help() void {
    println(USAGE);
    println("options:");
    println("  -o <file>          write the output to <file> (default a.out)");
    println("  -S                 stop after emitting the LLVM IR module <entry>.ll");
    println("  -c                 stop after compiling that module to <entry>.o");
    println("  -I <dir>           add a module search root; repeatable, in order");
    println("  --std-dir <dir>    the standard library directory");
    println("  --release          release mode");
    println("  --no-bounds-check  remove the index and span checks; unsafe");
    println("  -l<lib>            pass -l<lib> to the linker; repeatable, in order");
    println("  --cc <path>        the clang that compiles and links the IR (default ",
            DEFAULT_CC, ")");
    println("  --target <triple>  pass --target=<triple> to --cc (default ",
            os.TARGET, ")");
    println("  --cfg <list>       set key=value pairs; repeatable");
    println("  -Xcc <arg>         pass <arg> to --cc verbatim; repeatable, in order");
    println("  --check            run the front end only and stop; emit nothing");
    println("  --json             write the check document to stdout; needs --check");
    println("  --index            fill the document's identifier index; implies --check --json");
    println("  --tokens           write the entry file's tokens to stdout and stop");
    println("  --ast              write the entry file's syntax tree to stdout and stop");
    println("  --fir              write the program's FIR to stdout and stop");
    println("  --fir-after=<pass> write the FIR after <pass>: lower or build-mode");
    println("  --fir-test         read a .fir test, run its pass and write the FIR");
    println("  --help             print this help and exit");
    println("  --version          print the compiler version and exit");
}

// `fort: error: <message>` on stderr, the form every usage, toolchain and
// internal error takes.
fn error(string message) void {
    eprintln("fort: error: ", message);
}

// `fort: error: <what> '<path>': <reason>`, the form of
// `cannot read 'x.ft': No such file or directory`.
fn error_path(string what, string path, string reason) void {
    eprintln("fort: error: ", what, " '", path, "': ", reason);
}

// A usage error, followed by the usage line.
fn usage_error(string message) void {
    error(message);
    eprintln(USAGE);
}

// The same with the offending argument quoted after the message.
fn usage_error_arg(string message, string detail) void {
    eprintln("fort: error: ", message, " '", detail, "'");
    eprintln(USAGE);
}

// Whether `arg` is an option rather than the entry file: the first argument
// that does not start with '-' is the entry file.
fn is_option(string arg) bool {
    return arg.len > 0 && arg[0] == '-';
}

// Returns whether `arg` is `-l<lib>`. The library is part of this single argument. Other options
// take their values in separate arguments.
fn is_link_option(string arg) bool {
    return arg.len > 2 && arg[0] == '-' && arg[1] == 'l';
}

// The argument of an option that takes the following one; false after
// reporting the usage error. *i is left on the argument. -o, -I, --std-dir,
// --cc, --target, --cfg and -Xcc take the following argument, whatever it
// looks like.
fn take_argument(string@ args, u64 mut* i, string mut* out) bool {
    if (*i + 1 >= args.len) {
        usage_error_arg("missing argument for option", args[*i]);
        return false;
    }
    *i += 1;
    *out = args[*i];
    return true;
}

fn reserved_cfg(string key) bool {
    return key == "target_os" || key == "target_arch" || key == "target_abi";
}

fn valid_cfg_key(string key) bool {
    if (key.len == 0 || !(str.is_alpha(key[0]) || key[0] == '_')) {
        return false;
    }
    u64 mut i = 1;
    while (i < key.len) {
        if (!(str.is_alpha(key[i]) || str.is_digit(key[i]) || key[i] == '_')) {
            return false;
        }
        i += 1;
    }
    return lexer.keyword_kind(key) == lexer.tok_kind.ident && !lexer.is_reserved_word(key);
}

fn has_cfg(options* opts, string key) bool {
    u64 mut i = 0;
    while (i < opts->cfg_keys.len) {
        if (containers.str_at(&opts->cfg_keys, i) == key) {
            return true;
        }
        i += 1;
    }
    return false;
}

// Parses one comma-separated `--cfg` value. A value can hold `=` and can be
// empty. A comma always starts a new assignment.
fn parse_cfg(options mut* opts, string list) bool {
    u64 mut start = 0;
    while (start <= list.len) {
        u64 mut end = start;
        while (end < list.len && list[end] != ',') {
            end += 1;
        }
        if (end == start) {
            usage_error("empty --cfg list entry");
            return false;
        }
        string item = list[start..end];
        i64 equal = str.index_of(item, '=');
        if (equal < 0) {
            usage_error_arg("invalid --cfg assignment", item);
            return false;
        }
        string key = item[..cast(equal, u64)];
        string value = item[cast(equal, u64) + 1..];
        if (!valid_cfg_key(key)) {
            usage_error_arg("invalid --cfg key", key);
            return false;
        }
        if (reserved_cfg(key)) {
            usage_error_arg("cannot override compiler configuration key", key);
            return false;
        }
        if (has_cfg(opts, key)) {
            usage_error_arg("duplicate --cfg key", key);
            return false;
        }
        containers.str_push(&opts->cfg_keys, key);
        containers.str_push(&opts->cfg_values, value);
        if (end == list.len) {
            return true;
        }
        start = end + 1;
    }
    return true;
}

// The options that carry no value: -S, -c, --release, --no-bounds-check,
// --check, --json, --index, --tokens, --ast, --fir and --fir-test, each of which sets one flag.
fn parse_flag(options mut* opts, string arg) bool {
    if (arg == "-S") {
        opts->emit_ir = true;
    } else if (arg == "-c") {
        opts->compile_only = true;
    } else if (arg == "--release") {
        opts->release = true;
    } else if (arg == "--no-bounds-check") {
        opts->no_bounds_check = true;
    } else if (arg == "--check") {
        opts->check = true;
    } else if (arg == "--json") {
        opts->json = true;
    } else if (arg == "--index") {
        // --index implies --check and --json
        opts->index = true;
        opts->check = true;
        opts->json = true;
    } else if (arg == "--tokens") {
        // --tokens implies nothing and combines with nothing
        opts->tokens = true;
    } else if (arg == "--ast") {
        // --ast implies nothing and combines with nothing either
        opts->ast = true;
    } else if (arg == "--fir") {
        // --fir runs the front end and stops before the emitter
        opts->fir = true;
    } else if (arg == "--fir-test") {
        // the entry is a `.fir` test, not a program
        opts->fir_test = true;
    } else {
        return false;
    }
    return true;
}

// The options that take the following argument. Returns false when `arg` is not
// one of them; *ok is false when the argument was missing. The last -o,
// --std-dir, --cc and --target win, while -I, --cfg, -l and -Xcc accumulate
// in command-line order. A duplicate configuration key is an error.
fn parse_valued(options mut* opts, string@ args, u64 mut* i, bool mut* ok) bool {
    string arg = args[*i];
    bool is_output = arg == "-o";
    bool is_include = arg == "-I";
    bool is_std_dir = arg == "--std-dir";
    bool is_cc = arg == "--cc";
    bool is_target = arg == "--target";
    bool is_cfg = arg == "--cfg";
    bool is_cc_arg = arg == "-Xcc";
    if (!is_output && !is_include && !is_std_dir && !is_cc && !is_target && !is_cfg
        && !is_cc_arg) {
        return false;
    }
    string mut value = "";
    if (!take_argument(args, i, &value)) {
        *ok = false;
        return true;
    }
    if (is_output) {
        opts->have_output = true;
        opts->output = value;
    } else if (is_include) {
        containers.str_push(&opts->includes, value);
    } else if (is_std_dir) {
        opts->have_std_dir = true;
        opts->std_dir = value;
    } else if (is_cc) {
        opts->cc = value;
    } else if (is_target) {
        opts->target = value;
    } else if (is_cfg) {
        if (!parse_cfg(opts, value)) {
            *ok = false;
        }
    } else {
        containers.str_push(&opts->cc_args, value);
    }
    return true;
}

// Parses `--fir-after=<pass>`, which implies --fir. A name that FIR_PASSES does not hold
// is a usage error. The last --fir-after wins, as the last -o does.
fn parse_fir_after(options mut* opts, string arg) bool {
    string pass = arg[FIR_AFTER_PREFIX.len..];
    for (string known : FIR_PASSES) {
        if (pass == known) {
            opts->fir = true;
            opts->fir_after = pass;
            return true;
        }
    }
    usage_error_arg("unknown --fir-after pass", pass);
    return false;
}

// Parses args[1..] into *opts, which options_create has prepared. --help and
// --version print to stdout. A usage error prints `fort: error: <message>`
// and the usage line to stderr.
fn parse(options mut* opts, string@ args) i32 {
    u64 mut i = 1;
    while (i < args.len) {
        string arg = args[i];
        if (!is_option(arg)) {
            // the first argument that does not start with '-'
            if (opts->have_entry) {
                usage_error_arg("unexpected argument", arg);
                return PARSE_ERROR;
            }
            opts->have_entry = true;
            opts->entry = arg;
        } else if (arg == "--help") {
            help();
            return PARSE_DONE;
        } else if (arg == "--version") {
            println("fort ", VERSION);
            return PARSE_DONE;
        } else if (is_link_option(arg)) {
            containers.str_push(&opts->libs, arg);
        } else if (str.starts_with(arg, FIR_AFTER_PREFIX)) {
            if (!parse_fir_after(opts, arg)) {
                return PARSE_ERROR;
            }
        } else if (!parse_flag(opts, arg)) {
            bool mut ok = true;
            if (!parse_valued(opts, args, &i, &ok)) {
                usage_error_arg("unknown option", arg);
                return PARSE_ERROR;
            }
            if (!ok) {
                return PARSE_ERROR;
            }
        }
        i += 1;
    }
    if (!opts->have_entry) {
        usage_error("no entry file");
        return PARSE_ERROR;
    }
    if (opts->tokens && (opts->check || opts->json || opts->index)) {
        // --tokens stops before the parser
        usage_error("--tokens does not combine with --check, --json or --index");
        return PARSE_ERROR;
    }
    if (opts->ast && (opts->tokens || opts->check || opts->json || opts->index)) {
        // --ast stops before the checker
        usage_error("--ast does not combine with --tokens, --check, --json or --index");
        return PARSE_ERROR;
    }
    if (opts->fir && (opts->tokens || opts->ast || opts->check || opts->json)) {
        // --fir writes its own text to stdout after the checker; --index sets --check
        usage_error("--fir does not combine with --tokens, --ast, --check, --json or --index");
        return PARSE_ERROR;
    }
    if (opts->fir_test && (opts->tokens || opts->ast || opts->check || opts->json || opts->fir)) {
        // --fir-test reads a `.fir` test, which none of the other modes reads
        usage_error(FIR_TEST_ALONE);
        return PARSE_ERROR;
    }
    if (opts->json && !opts->check) {
        // a build spawns a `--cc` that inherits stdout
        usage_error("--json requires --check");
        return PARSE_ERROR;
    }
    return PARSE_OK;
}

// Whether the target has one of the two forms.
fn target_form(string target) bool {
    if (target == "x86_64-linux-gnu") {
        return true;
    }
    string prefix = "arm64-apple-macosx";
    if (!str.starts_with(target, prefix)) {
        return false;
    }
    u64 mut i = prefix.len;
    u64 mut digits = 0;
    u64 mut dots = 0;
    while (i < target.len) {
        if (str.is_digit(target[i])) {
            digits += 1;
        } else if (target[i] == '.' && digits > 0 && dots < 2) {
            dots += 1;
            digits = 0;
        } else {
            return false;
        }
        i += 1;
    }
    return dots == 2 && digits > 0;
}

// Adds the compiler keys and the user keys to the one analysis session.
fn configure(session.session mut* s, options* opts) void {
    if (opts->target == "x86_64-linux-gnu") {
        session.config_set(s, "target_os", "linux");
        session.config_set(s, "target_arch", "x86_64");
    } else {
        session.config_set(s, "target_os", "macos");
        session.config_set(s, "target_arch", "aarch64");
    }
    session.config_set(s, "target_abi", "");
    u64 mut i = 0;
    while (i < opts->cfg_keys.len) {
        session.config_set(s, containers.str_at(&opts->cfg_keys, i),
                           containers.str_at(&opts->cfg_values, i));
        i += 1;
    }
}

// The default --cc on both targets: the clang that PATH finds (D14.1, D14.3).
string DEFAULT_CC = "clang";

// Rejects a target that this IR mode cannot use before it creates output.
// The front-end modes do not call this function.
fn target_allowed(options* opts) bool {
    if (!target_form(opts->target)) {
        usage_error_arg("unsupported target", opts->target);
        return false;
    }
    if (opts->target == os.TARGET) {
        return true;
    }
    if (opts->emit_ir) {
        if (opts->have_std_dir) {
            return true;
        }
        usage_error("--std-dir is required for cross-target -S");
    } else if (opts->compile_only) {
        eprintln("fort: error: cannot compile object for target '", opts->target,
                 "' with a '", os.TARGET, "' compiler");
        eprintln(USAGE);
    } else {
        eprintln("fort: error: cannot link target '", opts->target,
                 "' with a '", os.TARGET, "' compiler");
        eprintln(USAGE);
    }
    return false;
}

// --tokens lexes the entry file alone. It resolves no import and parses nothing.
// It writes one line per token to stdout. A lexical error does not stop lexing, so the
// dump covers the whole file either way. The status is then a compile error.
fn tokens_entry(options* opts) i32 {
    session.session mut s = session.create();
    defer session.free(&s);
    string mut source = "";
    if (!session.read_source(&s, opts->entry, &source)) {
        error_path("cannot read", opts->entry, str.from_cstr(libc.strerror(sys.errno())));
        return EXIT_USAGE;
    }
    // a batch driver writes the text form as it arrives
    diag.set_text(session.diags(&s), true);
    session.show_sources(&s);
    lexer.tok_vec mut toks = lexer.tokvec_create();
    defer lexer.tokvec_free(&toks);
    bool clean = lexer.lex_file(&s, opts->entry, source, &toks);
    strbuf.str_buf mut dump = strbuf.create();
    defer strbuf.free(&dump);
    lexer.tok_dump(&toks, &dump);
    print(strbuf.view(&dump));
    if (clean) {
        return EXIT_OK;
    }
    return EXIT_COMPILE_ERROR;
}

// --ast lexes and parses the entry file alone -- no import is resolved and nothing is checked. It
// writes one S-expression and a final newline to stdout. The lexer continues after a lexical error.
// The parser continues after a syntax error. Thus, the tree covers the complete file. The status is
// then a compile error.
fn ast_entry(options* opts) i32 {
    session.session mut s = session.create();
    defer session.free(&s);
    string mut source = "";
    if (!session.read_source(&s, opts->entry, &source)) {
        error_path("cannot read", opts->entry, str.from_cstr(libc.strerror(sys.errno())));
        return EXIT_USAGE;
    }
    // a batch driver writes the text form as it arrives
    diag.set_text(session.diags(&s), true);
    session.show_sources(&s);
    lexer.tok_vec mut toks = lexer.tokvec_create();
    defer lexer.tokvec_free(&toks);
    lexer.lex_file(&s, opts->entry, source, &toks);
    // the tokens cover the whole file, so the parse runs
    ast.arena mut ar = ast.arena{};
    defer ast.ast_arena_free(&ar);
    ast.node mut* mod = parser.parse_module(&s, opts->entry, &toks, &ar);
    strbuf.str_buf mut dump = strbuf.create();
    defer strbuf.free(&dump);
    ast.ast_dump(mod, &dump);
    strbuf.push(&dump, '\n');
    print(strbuf.view(&dump));
    if (session.error_count(&s) == 0) {
        return EXIT_OK;
    }
    return EXIT_COMPILE_ERROR;
}

// ---- the standard library directory ------------------------------

// The standard library sits in `std` beside the binary when --std-dir and
// $FORT_STD_DIR name nothing.
string STD_DIR_NAME = "std";

// The path of the running binary; false when the OS cannot give it.
// Linux reads /proc/self/exe. Mac reads dyld's path and resolves it with
// realpath when possible. *out stays unchanged on failure. The path is
// interned in `p`.
fn exe_path(containers.pool mut* p, string mut* out) bool {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    if (!os.exe_path(&b)) {
        return false;
    }
    *out = containers.pool_intern(p, strbuf.view(&b));
    return true;
}

// `std` in the directory containing `program`, or `std` alone when `program`
// has no directory part. Interned in `p`.
fn std_dir_beside(containers.pool mut* p, string program) string {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    i64 last = str.last_index_of(program, '/');
    if (last >= 0) {
        strbuf.append(&b, program[0..cast(last, u64) + 1]);
    }
    strbuf.append(&b, STD_DIR_NAME);
    return containers.pool_intern(p, strbuf.view(&b));
}

// The standard library directory: --std-dir, else
// $FORT_STD_DIR, else `std` beside the fort binary. Linux reads /proc/self/exe.
// Mac reads dyld's executable path. An empty environment value
// names no directory, so it counts as unset. Interned in `p`.
fn std_dir(containers.pool mut* p, options* opts, string program) string {
    // the option as given, the empty one included
    if (opts->have_std_dir) {
        return containers.pool_intern(p, opts->std_dir);
    }
    string mut from_env = "";
    if (sys.env("FORT_STD_DIR", &from_env) && from_env.len > 0) {
        return containers.pool_intern(p, from_env);
    }
    // else `std` beside the fort binary, read from /proc/self/exe
    string mut running = "";
    if (exe_path(p, &running)) {
        return std_dir_beside(p, running);
    }
    // Without /proc, args[0] names the binary. One without a slash was found
    // through PATH, whose directory the driver cannot know, so `std` in the
    // current directory is the last resort.
    return std_dir_beside(p, program);
}

// ---- paths ------------------------------------------------------

// The default output when -o is absent, and the two names the temporary
// directory is built from. bootstrap0/src/driver.h spells
// the first two as macros and driver.c the rest as file-scope arrays.
string DEFAULT_OUTPUT = "a.out";
string TMP_DIR_DEFAULT = "/tmp";
string TMP_DIR_TEMPLATE = "/fort-XXXXXX";
string IR_SUFFIX = ".ll";
string OBJECT_SUFFIX = ".o";
string FT_SUFFIX = ".ft";

// EINTR, the one errno the driver compares against: a signal caught while
// --cc runs interrupts the wait and not the child (waitpid(2)).
i32 EINTR = 4;

// The position after the last '/' of `path`, that is the start of its last
// component.
fn last_component(string path) u64 {
    u64 mut start = 0;
    u64 mut i = 0;
    while (i < path.len) {
        if (path[i] == '/') {
            start = i + 1;
        }
        i += 1;
    }
    return start;
}

// The entry file's last component with `.ft` removed, which names the IR
// module and the default object.
fn entry_base(string entry) string {
    string mut base = entry[last_component(entry)..];
    if (base.len > FT_SUFFIX.len && str.ends_with(base, FT_SUFFIX)) {
        base = base[0..base.len - FT_SUFFIX.len];
    }
    return base;
}

// `<dir>/<name><suffix>`, interned in `p`. An empty directory or suffix is
// left out, where bootstrap0/src/driver.c passes NULL.
fn join_path(containers.pool mut* p, string dir, string name, string suffix) string {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    if (dir.len > 0) {
        strbuf.append(&b, dir);
        strbuf.push(&b, '/');
    }
    strbuf.append(&b, name);
    strbuf.append(&b, suffix);
    return containers.pool_intern(p, strbuf.view(&b));
}

fn default_output(containers.pool mut* p, options* opts) string {
    // -S and -c together stop at the IR, so -S decides the suffix
    if (opts->emit_ir) {
        return join_path(p, "", entry_base(opts->entry), IR_SUFFIX);
    }
    if (opts->compile_only) {
        return join_path(p, "", entry_base(opts->entry), OBJECT_SUFFIX);
    }
    return containers.pool_intern(p, DEFAULT_OUTPUT);
}

// ---- the temporary directory ------------------------------------

// Creates the temporary directory with mkdtemp under $TMPDIR, `/tmp` by
// default. The path is interned in `p` and the directory it was created in is
// stored in *parent_out. Returns the empty string and the errno of the
// failure in *error_out, captured before anything else can overwrite it.
fn make_temp_dir(containers.pool mut* p, string mut* parent_out, i32 mut* error_out) string {
    string mut parent = TMP_DIR_DEFAULT;
    string mut value = "";
    // An empty value names no directory, so it counts as unset.
    if (sys.env("TMPDIR", &value) && value.len > 0) {
        parent = value;
    }
    *parent_out = parent;
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, parent);
    strbuf.append(&b, TMP_DIR_TEMPLATE);
    // mkdtemp replaces the six X in place, so this is our own
    char mut@ own tmpl = str.to_cstr(strbuf.view(&b));
    defer del(tmpl);
    *error_out = 0;
    if (libc.mkdtemp(&tmpl[0]) == null) {
        *error_out = sys.errno();
        return "";
    }
    return containers.pool_intern(p, str.from_cstr(&tmpl[0]));
}

// Removes the temporary directory and the module in it, whether or not --cc
// succeeded. The compiler writes exactly one file there, one
// `<entry>.ll`, so no directory walk is needed. A file already gone is not an
// error.
fn remove_temp_dir(string dir, string ir_path) void {
    if (ir_path.len > 0) {
        char mut@ own path = str.to_cstr(ir_path);
        defer del(path);
        libc.unlink(&path[0]);
    }
    char mut@ own d = str.to_cstr(dir);
    defer del(d);
    libc.rmdir(&d[0]);
}

// ---- the clang invocation --------------------------------------------------------

// Builds the --cc command line in the same order as bootstrap0/src/driver.c.
fn cc_argv(containers.pool mut* p, options* opts, string ir_path, string out_path,
                containers.str_vec mut* argv) void {
    containers.str_push(argv, opts->cc);
    containers.str_push(argv, join_path(p, "", "--target=", opts->target));
    // Use -O2 under --release and -O1 otherwise. The compiler does not optimize the IR.
    if (opts->release) {
        containers.str_push(argv, "-O2");
    } else {
        containers.str_push(argv, "-O1");
    }
    containers.str_push(argv, "-fPIE");
    // The module carries its own target triple, which clang would warn about
    containers.str_push(argv, "-Wno-override-module");
    if (opts->compile_only) {
        containers.str_push(argv, "-c");
    }
    containers.str_push(argv, "-o");
    containers.str_push(argv, out_path);
    // The one input is the module, which holds the whole program, the runtime
    // included. No -x ir: clang reads a `.ll` by its suffix and -x is sticky
    containers.str_push(argv, ir_path);
    if (!opts->compile_only) {
        u64 mut i = 0;
        while (i < opts->libs.len) {
            containers.str_push(argv, containers.str_at(&opts->libs, i));
            i += 1;
        }
    }
    // -Xcc arguments come last, verbatim and in order
    u64 mut k = 0;
    while (k < opts->cc_args.len) {
        containers.str_push(argv, containers.str_at(&opts->cc_args, k));
        k += 1;
    }
}

// The bytes of every argument, each NUL-terminated, and a NULL-terminated array
// of pointers into them: what execvp takes. bootstrap0/src/driver.c pushes the
// arguments as C strings it already has. A fort `string` is a pointer and a
// length and is not NUL-terminated, so they are copied here, once, into storage
// the caller releases.
struct cc_command {
    char mut@ own bytes;      // every argument, each followed by its NUL
    char mut* mut@ own items; // one pointer per argument, then null
}

fn cc_command_build(containers.str_vec* argv) cc_command {
    u64 mut total = 0;
    u64 mut i = 0;
    while (i < argv->len) {
        total += containers.str_at(argv, i).len + 1;
        i += 1;
    }
    cc_command mut c = cc_command{};
    c.bytes = new(char, total);
    c.items = new(char mut*, argv->len + 1);
    u64 mut at = 0;
    i = 0;
    while (i < argv->len) {
        string arg = containers.str_at(argv, i);
        c.items[i] = &c.bytes[at];
        u64 mut k = 0;
        while (k < arg.len) {
            c.bytes[at] = arg[k];
            at += 1;
            k += 1;
        }
        c.bytes[at] = '\0';
        at += 1;
        i += 1;
    }
    c.items[argv->len] = null;
    return c;
}

fn cc_command_free(cc_command mut* c) void {
    del(c->bytes);
    del(c->items);
}

// Reports either `cc failed with status N` or `cc failed with signal N`.
fn error_cc_status(string what, i64 value) void {
    strbuf.str_buf mut m = strbuf.create();
    defer strbuf.free(&m);
    strbuf.append(&m, "cc failed with ");
    strbuf.append(&m, what);
    strbuf.push(&m, ' ');
    strbuf.append_i64(&m, value);
    error(strbuf.view(&m));
}

// Implements the three wait(2) macros, which fort does not provide. A low byte of 0x7F means
// stopped. Zero means exited. Other values hold the terminating signal. The second byte holds the
// exit status.
u32 WAIT_SIGNAL_MASK = 127;
u32 WAIT_STATUS_SHIFT = 8;
u32 WAIT_STATUS_MASK = 255;

fn wait_signaled(i32 status) bool {
    u32 low = cast(status, u32) & WAIT_SIGNAL_MASK;
    return low != 0 && low != WAIT_SIGNAL_MASK;
}

fn wait_signal(i32 status) i64 {
    return cast(cast(status, u32) & WAIT_SIGNAL_MASK, i64);
}

fn wait_status(i32 status) i64 {
    return cast((cast(status, u32) >> WAIT_STATUS_SHIFT) & WAIT_STATUS_MASK, i64);
}

// The errno of a failed execvp, written by the child and read by the parent,
// four bytes little end first. Nothing else is ever written to that pipe, so
// a short read means the child reached execvp and a full one means it did
// not.
u64 ERRNO_BYTES = 4;
u64 BYTE_BITS = 8;
u64 BYTE_MASK = 255;

// F_SETFD and FD_CLOEXEC of fcntl(2): the write end of the pipe closes at
// execvp, which is what tells the parent the exec succeeded.
i32 F_SETFD = 2;
i32 FD_CLOEXEC = 1;

// Defines the status for a child that cannot exec. The parent reads errno from the pipe first, so
// --cc cannot report this value.
i32 EXEC_FAILED_STATUS = 127;

// Runs --cc once over the module: it compiles and links in one invocation.
// Returns EXIT_OK, or EXIT_USAGE after reporting the failure.
fn run_cc(options* opts, string ir_path, string out_path) i32 {
    containers.pool mut p = containers.pool_create();
    defer containers.pool_free(&p);
    containers.str_vec mut argv = containers.str_create();
    defer containers.str_free(&argv);
    cc_argv(&p, opts, ir_path, out_path, &argv);
    cc_command mut cmd = cc_command_build(&argv);
    defer cc_command_free(&cmd);
    i32[2] mut fds = {};
    if (libc.pipe(&fds[0]) != 0) {
        error_path("cannot run", opts->cc, str.from_cstr(libc.strerror(sys.errno())));
        return EXIT_USAGE;
    }
    if (libc.fcntl(fds[1], F_SETFD, FD_CLOEXEC) != 0) {
        // The write end has to close at execvp: that is what tells the parent the exec succeeded.
        // An open write end in --cc or its child keeps the read blocked until the last process
        // exits. This is only a delay. Report close failure here instead of treating it as a
        // missing errno.
        error_path("cannot run", opts->cc, str.from_cstr(libc.strerror(sys.errno())));
        io.close(fds[0]);
        io.close(fds[1]);
        return EXIT_USAGE;
    }
    i32 child = libc.fork();
    if (child < 0) {
        i32 failure = sys.errno();
        io.close(fds[0]);
        io.close(fds[1]);
        error_path("cannot run", opts->cc, str.from_cstr(libc.strerror(failure)));
        return EXIT_USAGE;
    }
    if (child == 0) {
        // The child replaces itself with --cc. Reaching the line after execvp means it failed. The
        // child sends errno through the pipe. The parent reports it as a posix_spawnp result.
        io.close(fds[0]);
        libc.execvp(&cmd.bytes[0], cast(&cmd.items[0], void*));
        u64 e = cast(sys.errno(), u64);
        u8[4] mut buf = {};
        u64 mut i = 0;
        while (i < ERRNO_BYTES) {
            buf[i] = cast((e >> (i * BYTE_BITS)) & BYTE_MASK, u8);
            i += 1;
        }
        io.write_all(fds[1], buf[0..ERRNO_BYTES]);
        libc._exit(EXEC_FAILED_STATUS);
    }
    io.close(fds[1]);
    u8[4] mut got = {};
    i64 read = io.read(fds[0], got[0..ERRNO_BYTES]);
    io.close(fds[0]);
    i32 mut status = 0;
    // The child is reaped whatever it did, so no zombie outlives the run. A
    // signal caught while clang runs interrupts the wait, not the child.
    i32 mut waited = libc.waitpid(child, &status, 0);
    while (waited < 0 && sys.errno() == EINTR) {
        waited = libc.waitpid(child, &status, 0);
    }
    if (read == cast(ERRNO_BYTES, i64)) {
        u64 mut e = 0;
        u64 mut i = 0;
        while (i < ERRNO_BYTES) {
            e |= cast(got[i], u64) << (i * BYTE_BITS);
            i += 1;
        }
        error_path("cannot run", opts->cc, str.from_cstr(libc.strerror(cast(e, i32))));
        return EXIT_USAGE;
    }
    if (waited < 0) {
        error_path("cannot wait for", opts->cc, str.from_cstr(libc.strerror(sys.errno())));
        return EXIT_USAGE;
    }
    if (wait_signaled(status)) {
        error_cc_status("signal", wait_signal(status));
        return EXIT_USAGE;
    }
    if (wait_status(status) != 0) {
        error_cc_status("status", wait_status(status));
        return EXIT_USAGE;
    }
    return EXIT_OK;
}

// ---- the front end ---------------------------------

// Keeps parsed modules and checker annotations available to later passes.
struct analysis {
    modules.module_set set;
    check.checker ck;
}

// The analysis of one run: the modules it will read and the checker that will
// annotate their trees. bootstrap0/src/driver.c's driver_analysis_init does the
// same two calls. The checker takes the session here because it reports through
// it, where the C reports through a file-scope sink.
fn analysis_create(session.session mut* s) analysis {
    analysis mut an = analysis{};
    check.check_init(&an.ck, s);
    return an;
}

// Releases a live analysis. Repeated calls have no effect.
fn analysis_release(analysis mut* an, bool mut* live) void {
    if (!*live) {
        return;
    }
    *live = false;
    analysis_free(an);
}

fn analysis_free(analysis mut* an) void {
    check.check_free(&an->ck);
    modules.free(&an->set);
}

// Loads the entry file and import closure with the search roots in order.
// Returns false after diagnostics report a load failure.
fn load_closure(session.session mut* s, options* opts, string program, analysis mut* an) bool {
    u64 mut i = 0;
    while (i < opts->includes.len) {
        // the `-I` roots follow the entry file's directory
        modules.add_root(&an->set, containers.str_at(&opts->includes, i));
        i += 1;
    }
    containers.pool mut p = containers.pool_create();
    defer containers.pool_free(&p);
    // `std` is looked up in the standard library directory
    modules.set_std_dir(&an->set, std_dir(&p, opts, program));
    return modules.load(s, &an->set, opts->entry);
}

// Tests whether the entry path opens without reading it. bootstrap0/src/driver.c only opens and
// closes the entry. A directory can open, but read(2) returns EISDIR. It passes this test, then the
// loader reports a compile error instead of a usage error. Reading the file here would make stage2
// report a usage error and exit 2. Bootstrap-0 reports a located compile error and exits 1.
fn entry_opens(string path) bool {
    i32 fd = io.open_read(path);
    if (fd < 0) {
        return false;
    }
    io.close(fd);
    return true;
}

// The front end as far as this compiler goes: read the entry
// file, then parse the import closure. An entry file that
// cannot be opened is exit 2 and a compile diagnostic is exit 1. A closure that
// loaded cleanly would be the checker's and the emitter's turn, which is the
// internal error of `run` below.
fn front_end(session.session mut* s, options* opts, string program, analysis mut* an) i32 {
    // The loader reads each file through the session.
    // This keeps a server buffer consistent across the closure.
    if (!entry_opens(opts->entry)) {
        error_path("cannot read", opts->entry, str.from_cstr(libc.strerror(sys.errno())));
        return EXIT_USAGE;
    }
    // --json writes the document and no text line
    diag.set_text(session.diags(s), !opts->json);
    session.show_sources(s);
    bool loaded = load_closure(s, opts, program, an);
    // Check each parsed module in dependency order.
    // A parse failure in one file does not hide errors in other files.
    // Keep the analysis available for the emitter and index walk. A compilation builds a
    // program, so the entry module defines main; --check inspects one module instead,
    // and the entry rule does not apply to it.
    an->ck.require_main = !opts->check;
    bool checked = check_stmt.check_program(&an->ck, &an->set);
    if (!loaded || !checked || session.error_count(s) > 0) {
        return EXIT_COMPILE_ERROR;
    }
    return EXIT_OK;
}

// Emits one module for the complete closure. An unwritable path is a toolchain error with exit 2.
// An unsupported construct is a compile error with exit 1. Neither case sends partial IR to `--cc`.
// The emitter is initialized at the address it is used at, since it stores the session it reports
// through (gen.ft).
fn emit_module(session.session mut* s, options* opts, analysis mut* an, string ir_path) i32 {
    gen.gen_options mut gopts = gen.gen_options{};
    gopts.release = opts->release;
    gopts.no_bounds_check = opts->no_bounds_check;
    gopts.target = opts->target;
    gen.emitter mut g = gen.emitter{};
    gen.gen_init(&g, s, gopts);
    defer gen.gen_free(&g);
    if (!gen_stmt.gen_program(&g, &an->ck, &an->set)) {
        return EXIT_COMPILE_ERROR;
    }
    if (!io.write_file(ir_path, strbuf.bytes(&g.out))) {
        error_path("cannot write", ir_path, str.from_cstr(libc.strerror(sys.errno())));
        return EXIT_USAGE;
    }
    return EXIT_OK;
}

// ---- the document of the check mode -----------------------------

// "version" is 1 for this form of the document.
u64 JSON_VERSION = 1;

// Copies module file names in load order.
fn collect_files(containers.pool mut* p, modules.module_set* set,
                      containers.str_vec mut* files) void {
    u64 mut i = 0;
    while (i < modules.file_count(set)) {
        containers.str_push(files, containers.pool_intern(p, modules.file_at(set, i)));
        i += 1;
    }
}

// Builds the whole document into `out`: the version, the files of the closure,
// the diagnostics of the run and the identifier index.
fn build_document(strbuf.str_buf mut* out, session.session mut* s,
                       containers.str_vec* files, index.index* ix) void {
    json.writer mut j = json.writer{};
    json.json_init(&j, out);
    json.json_object_begin(&j);
    json.json_key(&j, "version");
    json.json_uint(&j, JSON_VERSION);
    // a client clears the stale diagnostics of a file
    json.json_key(&j, "files");
    json.json_array_begin(&j);
    u64 mut i = 0;
    while (i < files->len) {
        json.json_str(&j, containers.str_at(files, i));
        i += 1;
    }
    json.json_array_end(&j);
    json.json_key(&j, "diagnostics");
    diag.write_json(session.diags(s), &j);
    // the empty array without --index, always a member
    json.json_key(&j, "symbols");
    index.write_json(ix, &j);
    json.json_object_end(&j);
}

// Writes the document with one print, so stdout holds a complete document or
// nothing and a client tells a crash from a verdict. The document is one line
// ended by a newline.
fn write_document(session.session mut* s, containers.str_vec* files, index.index* ix) void {
    strbuf.str_buf mut doc = strbuf.create();
    defer strbuf.free(&doc);
    build_document(&doc, s, files, ix);
    strbuf.push(&doc, '\n');
    print(strbuf.view(&doc));
}

// --check --json writes the front-end document to stdout.
// --index adds identifier records from checker annotations.
// A usage, toolchain, or internal error causes exit 2 with empty stdout.
fn check_document(session.session mut* s, options* opts, analysis mut* an,
                       containers.pool mut* p) void {
    containers.str_vec mut files = containers.str_create();
    defer containers.str_free(&files);
    collect_files(p, &an->set, &files);
    index.index mut ix = index.create();
    defer index.free(&ix);
    if (opts->index) {
        index.build(&ix, &an->set);
    }
    write_document(s, &files, &ix);
}

// --fir lowers each function of a checked program into a FIR module and writes the module to
// stdout, with one print: the modules in dependency order and the functions of each in source
// order, with a blank line between two functions. The verifier tests each function before the
// print, and a violation ends the compiler with a panic that names the rule. A function that the
// lowering does not lower writes the line of fir_lower.write_report in its place.
// `opts->fir_after` names a pass that does not exist yet, so every name prints this module.
fn fir_entry(analysis mut* an) i32 {
    fir_verify.runtime rt = fir_verify.runtime_of(&an->ck);
    gen.node_ref_vec mut decls = gen.node_ref_vec{};
    defer gen.refs_free(&decls);
    fir_lower.program_functions(&an->set, &decls);
    // The module holds each lowered function for the passes that `--fir-after` will name (T-247);
    // until they exist, the text is written from each function before it moves into the module.
    fir.module mut m = fir.module_new();
    defer fir.module_free(&m);
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    u64 mut i = 0;
    while (i < decls.len) {
        if (i > 0) {
            strbuf.push(&text, '\n');
        }
        fir.func mut f = fir.func{};
        fir_lower.report mut why = fir_lower.report{};
        if (fir_lower.lower_function(&an->ck, gen.refs_at(&decls, i), &f, &why)) {
            fir_verify.verify(&f, &rt);
            fir_print.print_function(&f, &text);
            fir.module_add_function(&m, move(f));
        } else {
            fir_lower.write_report(&why, &text);
        }
        i += 1;
    }
    print(strbuf.view(&text));
    return EXIT_OK;
}

// ---- the FIR tests -----------------------------------------------------------------------

// What the compiler reads of a `.fir` test: the text of its `//! pass:` directive, and its
// prelude as fort source. The prelude keeps the lines and the columns of the file: a line of the
// `//! prelude:` block keeps its text with spaces for its `//|`, and every other line is empty.
struct fir_test {
    bool have_pass;
    string pass;
    strbuf.str_buf prelude;
}

// Whether `c` is a space or the carriage return of a CRLF line end.
fn is_blank(char c) bool {
    return c == ' ' || c == '\r';
}

// The text without the spaces and carriage returns at its ends.
fn trimmed(string text) string {
    u64 mut lo = 0;
    u64 mut hi = text.len;
    while (lo < hi && is_blank(text[lo])) {
        lo += 1;
    }
    while (hi > lo && is_blank(text[hi - 1])) {
        hi -= 1;
    }
    return text[lo..hi];
}

// Reads the header of the `.fir` test `text`: the leading run of `//!` and `//|` lines.
fn read_fir_test(string text, fir_test mut* t) void {
    bool mut header = true;
    bool mut in_prelude = false;
    u64 mut start = 0;
    while (start < text.len) {
        u64 mut end = start;
        while (end < text.len && text[end] != '\n') {
            end += 1;
        }
        string line = text[start..end];
        if (header && str.starts_with(line, BLOCK_MARK)) {
            if (in_prelude) {
                strbuf.append(&t->prelude, "   ");
                strbuf.append(&t->prelude, line[BLOCK_MARK.len..line.len]);
            }
        } else if (header && str.starts_with(line, DIRECTIVE_MARK)) {
            string directive = trimmed(line[DIRECTIVE_MARK.len..line.len]);
            in_prelude = directive == "prelude:";
            if (str.starts_with(directive, "pass:")) {
                t->have_pass = true;
                t->pass = trimmed(directive["pass:".len..directive.len]);
            }
        } else {
            header = false;
        }
        strbuf.push(&t->prelude, '\n');
        start = end + 1;
    }
}

// Checks the pass that the test names and sets *verify for the pass `verify`. EXIT_OK when the
// pass runs, else EXIT_USAGE after an error: no directive, a pass that does not exist yet, an
// unknown pass, or `none` or `verify` with an argument.
fn fir_test_pass(fir_test* t, bool mut* verify) i32 {
    *verify = false;
    if (!t->have_pass) {
        error("the .fir test has no '//! pass:' directive");
        return EXIT_USAGE;
    }
    i64 space = str.index_of(t->pass, ' ');
    string mut name = t->pass;
    if (space >= 0) {
        name = t->pass[0..cast(space, u64)];
    }
    if (name == FIR_TEST_NONE || name == FIR_TEST_VERIFY) {
        if (space >= 0) {
            eprintln("fort: error: the pass '", name, "' takes no argument");
            return EXIT_USAGE;
        }
        *verify = name == FIR_TEST_VERIFY;
        return EXIT_OK;
    }
    for (string later : FIR_TEST_LATER) {
        if (name == later) {
            eprintln("fort: error: the pass '", name, "' does not exist yet");
            return EXIT_USAGE;
        }
    }
    eprintln("fort: error: unknown pass '", name, "'");
    return EXIT_USAGE;
}

// --fir-test reads a `.fir` test (spec/fir.md 16.3): it checks the prelude of the test as the
// module `main` through the front end, parses the FIR text against it, runs the pass that the
// test names and writes the module to stdout in one print. The harness compares the text. A
// diagnostic of the prelude or of the FIR text is exit 1 with no text; an unreadable file and a
// pass that does not run are exit 2. The pass `verify` ends the compiler with a panic at the first
// violation of a rule, and writes no text then.
fn fir_test_entry(options* opts, string program) i32 {
    if (!target_form(opts->target)) {
        usage_error_arg("unsupported target", opts->target);
        return EXIT_USAGE;
    }
    session.session mut s = session.create();
    defer session.free(&s);
    configure(&s, opts);
    string mut text = "";
    if (!session.read_source(&s, opts->entry, &text)) {
        error_path("cannot read", opts->entry, str.from_cstr(libc.strerror(sys.errno())));
        return EXIT_USAGE;
    }
    fir_test mut t = fir_test{};
    defer strbuf.free(&t.prelude);
    read_fir_test(text, &t);
    bool mut verify = false;
    i32 pass = fir_test_pass(&t, &verify);
    if (pass != EXIT_OK) {
        return pass;
    }
    // The loader reads the prelude in place of the file, so a diagnostic of the prelude names
    // the line and the column of the file. No source line is shown under it.
    session.set_source(&s, opts->entry, strbuf.view(&t.prelude));
    diag.set_text(session.diags(&s), true);
    analysis mut an = analysis_create(&s);
    defer analysis_free(&an);
    u64 mut i = 0;
    while (i < opts->includes.len) {
        modules.add_root(&an.set, containers.str_at(&opts->includes, i));
        i += 1;
    }
    containers.pool mut p = containers.pool_create();
    defer containers.pool_free(&p);
    modules.set_std_dir(&an.set, std_dir(&p, opts, program));
    bool loaded = modules.load_named(&s, &an.set, FIR_TEST_MODULE, opts->entry);
    // the prelude is no program, so it need not define main
    an.ck.require_main = false;
    bool checked = check_stmt.check_program(&an.ck, &an.set);
    if (!loaded || !checked || session.error_count(&s) > 0) {
        return EXIT_COMPILE_ERROR;
    }
    fir_parse.prelude pre = fir_parse.prelude{modules.entry(&an.set), &an.ck};
    fir.module mut m = fir_parse.parse_module(&s, opts->entry, text, pre);
    defer fir.module_free(&m);
    if (session.error_count(&s) > 0) {
        return EXIT_COMPILE_ERROR;
    }
    if (verify) {
        // a violation ends the compiler with a panic that names the rule
        fir_verify.runtime rt = fir_verify.runtime_of(&an.ck);
        u64 mut k = 0;
        while (k < fir.module_function_count(&m)) {
            fir_verify.verify(fir.module_function_at(&m, k), &rt);
            k += 1;
        }
    }
    strbuf.str_buf mut out = strbuf.create();
    defer strbuf.free(&out);
    fir_print.print_module(&m, &out);
    print(strbuf.view(&out));
    return EXIT_OK;
}

// Runs the front end, then the available build or check passes. --check and --fir write no
// file, so they take any target form that the compiler accepts, as a check does.
fn compile_entry(options* opts, string program) i32 {
    bool front_only = opts->check || opts->fir;
    if (front_only && !target_form(opts->target)) {
        usage_error_arg("unsupported target", opts->target);
        return EXIT_USAGE;
    }
    if (!front_only && !target_allowed(opts)) {
        return EXIT_USAGE;
    }
    containers.pool mut p = containers.pool_create();
    defer containers.pool_free(&p);
    session.session mut s = session.create();
    defer session.free(&s);
    configure(&s, opts);
    // A build reads no tree after the emitter has run, so its analysis is
    // released on every path out of this function (ast.sym). The build path
    // below releases it as soon as the emitter returns and before --cc is
    // spawned. This `defer` answers for the paths that return earlier, and the
    // flag makes exactly one of the two calls do the work.
    analysis mut an = analysis_create(&s);
    bool mut analysis_live = true;
    defer analysis_release(&an, &analysis_live);
    i32 status = front_end(&s, opts, program, &an);
    if (opts->check && opts->json && (status == EXIT_OK || status == EXIT_COMPILE_ERROR)) {
        // the document answers for both verdicts, so it goes first
        check_document(&s, opts, &an, &p);
        return status;
    }
    if (status != EXIT_OK) {
        return status;
    }
    if (opts->check) {
        // --check stops after the front end, no module emitted
        return EXIT_OK;
    }
    if (opts->fir) {
        // --fir stops before the emitter
        return fir_entry(&an);
    }
    string mut out_path = opts->output;
    if (!opts->have_output) {
        out_path = default_output(&p, opts);
    }
    if (opts->emit_ir) {
        // -S writes the module to the output and stops, so it needs no
        // temporary.
        return emit_module(&s, opts, &an, out_path);
    }
    string mut parent = TMP_DIR_DEFAULT;
    i32 mut failure = 0;
    string dir = make_temp_dir(&p, &parent, &failure);
    if (dir.len == 0) {
        error_path("cannot create a temporary directory in", parent,
                   str.from_cstr(libc.strerror(failure)));
        return EXIT_USAGE;
    }
    string ir_path = join_path(&p, dir, entry_base(opts->entry), IR_SUFFIX);
    i32 mut built = emit_module(&s, opts, &an, ir_path);
    // Release analysis storage before fork duplicates the process page tables.
    analysis_release(&an, &analysis_live);
    if (built == EXIT_OK) {
        built = run_cc(opts, ir_path, out_path);
    }
    remove_temp_dir(dir, ir_path);
    return built;
}

// ---- the pipeline --------------------------------------------------

// Runs the compiler with args[1..]; returns the process exit status.
fn run(string@ args) i32 {
    // fort with no arguments prints one usage line and exits with 2
    if (args.len < 2) {
        eprintln(USAGE);
        return EXIT_USAGE;
    }
    options mut opts = options_create();
    defer options_free(&opts);
    i32 parsed = parse(&opts, args);
    if (parsed == PARSE_ERROR) {
        return EXIT_USAGE;
    }
    if (parsed == PARSE_DONE) {
        return EXIT_OK;
    }
    // --tokens stops after the lexer, and --ast stops after the parser.
    // Every other run goes through the front end.
    if (opts.tokens) {
        return tokens_entry(&opts);
    }
    if (opts.ast) {
        return ast_entry(&opts);
    }
    if (opts.fir_test) {
        return fir_test_entry(&opts, args[0]);
    }
    return compile_entry(&opts, args[0]);
}
