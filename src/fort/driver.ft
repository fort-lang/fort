// prim, consts, and types belong to the checker. These imports put them inside
// the main.ft closure for each product compiler build.

// The usage line, printed by --help and after every usage
// error.
// Module constants use UPPER_CASE.
string USAGE = "usage: fort [options] entry.ft";

// The version printed by --version.
string VERSION = "0.1.0";

// The option that names the point at which --fir prints, and the names it accepts: the two
// points where FIR changes (spec/fir.md 11, 17.1). `build-mode` runs the build-mode pass for the
// mode that --release and --no-bounds-check select.
string FIR_AFTER_PREFIX = "--fir-after=";
u64 FIR_PASS_COUNT = 2;
string FIR_BUILD_MODE = "build-mode";
string[FIR_PASS_COUNT] FIR_PASSES = {"lower", "build-mode"};

// The passes that the `//! pass:` directives of a `.fir` test name (spec/fir.md 16.3). `none`
// runs nothing, `verify` runs the verifier on each function, and `build-mode` runs the build-mode
// pass for the mode that its arguments, `--release` and `--no-bounds-check`, select.
string FIR_TEST_NONE = "none";
string FIR_TEST_VERIFY = "verify";
string FIR_TEST_RELEASE = "--release";
string FIR_TEST_NO_BOUNDS = "--no-bounds-check";

// The usage error of --fir-test beside another mode. --fir-after sets --fir.
string FIR_TEST_ALONE =
    "--fir-test does not combine with --tokens, --ast, --check, --json, --index or --fir";

// The two parts of the usage error of --fir-run beside another mode, a used library or a build
// mode: it runs the FIR of the whole closure from source, with each check of the checked mode.
// The other --fir options are --fir, --fir-after, --fir-verify-report, --fir-test and
// --fir-stats.
string FIR_RUN_ALONE_HEAD =
    "--fir-run does not combine with --tokens, --ast, --check, --json, --index, --use, ";
string FIR_RUN_ALONE_TAIL = "--release, --no-bounds-check or another --fir option";

// The separator after which every argument goes to the program that --fir-run runs.
string RUN_ARGS = "--";

// The pass of a `.fir` test that runs the FIR with fir.interpreter.
string FIR_TEST_RUN = "run";

// The most arguments that the pass `run` passes to its function.
u64 RUN_ARG_MAX = 8;

// The signals that end a run of --fir-run as they end the compiled program (D11.4, D8.5):
// SIGABRT, and the trap signal of the target, SIGILL on x86-64 and SIGTRAP on arm64. Their
// numbers are the same on Linux and on Darwin.
i32 SIGNAL_ABRT = 6;
i32 SIGNAL_ILL = 4;
i32 SIGNAL_TRAP = 5;

// The usage error of --fir-stats beside a mode that emits no module. --index sets --check, and
// --fir-after and --fir-verify-report set --fir.
string FIR_STATS_ALONE =
    "--fir-stats does not combine with --tokens, --ast, --check, --index, --fir or --fir-test";

// The usage error of --lib beside a mode or an option that a library build does not take, in two
// parts that fit the line.
string LIB_ALONE_HEAD = "--lib does not combine with -I, -l, --check, --json, --index, --tokens, ";
string LIB_ALONE_TAIL = "--ast or a --fir option";

// The module path of the prelude of a `.fir` test, which its function names start with.
string FIR_TEST_MODULE = "main";

// The markers of the header lines of a `.fir` test: a directive, and a line of a block.
string DIRECTIVE_MARK = "//!";
string BLOCK_MARK = "//|";

// The exit statuses: usage, toolchain and internal errors share 2.
i32 EXIT_OK = 0;
i32 EXIT_COMPILE_ERROR = 1;
i32 EXIT_USAGE = 2;

// The outcome of parse: the command line is in *opts, --help or --version was
// printed, or a usage error was reported.
i32 PARSE_OK = 0;
i32 PARSE_DONE = 1;
i32 PARSE_ERROR = 2;

// Running --cc once over the module. bootstrap0/src/driver.c calls posix_spawnp with `environ`,
// which fort cannot name: an `extern` declares a function and never a variable. `fork` with
// `execvp` matches posix_spawnp(..., environ). Both search PATH and pass the caller's environment.
// The pipe returns errno when `execvp` fails. Thus, both drivers report the same command failure.

// The parsed command line. Repeated options remain in command-line order.
struct options {
    bool have_entry; // whether an entry file was seen; C compares against NULL
    string entry;
    // States whether -o was given because a fort `string` cannot show this. It matches the third
    // nullable option in bootstrap0/src/driver.c. `fort -o "" main.ft` names an output of no
    // characters. A length test would fall back to `a.out` and exit 0 instead of passing the empty
    // name to --cc.
    bool have_output;
    string output; // -o, read only when have_output
    // States whether --std-dir was given because a fort `string` cannot show this. An explicit
    // `--std-dir ""` names an empty directory. It does not omit the option. Reading the length
    // instead falls back to $FORT_STD_DIR or to `std` beside the binary.
    bool have_std_dir;
    string std_dir;  // --std-dir, read only when have_std_dir
    string cc;       // --cc
    string target;   // --target
    bool emit_ir;         // -S
    bool compile_only;    // -c
    bool release;         // --release
    bool no_bounds_check; // --no-bounds-check
    bool check; // --check: the front end alone
    bool leak_report; // --leak-report: each leak site that is no error yet, on stdout
    bool json; // --json, the document on stdout
    bool index; // --index, the identifier index in it
    bool tokens; // --tokens: the entry file's tokens on stdout
    bool ast; // --ast: the entry file's syntax tree on stdout
    bool fir; // --fir, --fir-after or --fir-verify-report: the program's FIR on stdout
    string fir_after; // the pass of --fir-after, empty without it
    bool fir_test; // --fir-test: the entry is a `.fir` test; run its passes and write the FIR
    bool fir_report; // --fir-verify-report: the first violation of each function, not the FIR
    bool fir_stats; // --fir-stats: after the build, `lowered N of M` on stdout
    bool fir_run; // --fir-run: run the FIR of the program with fir.interpreter
    bool fir_events; // --fir-events: --fir-run reports the ownership events of the run
    bool have_run_args; // `--` was given, which only --fir-run takes
    containers.str_vec run_args; // the arguments after `--`, which go to the program
    bool have_lib; // --lib <name> <root>: a library build (D9.11)
    string lib_name; // the name of --lib, read only when have_lib
    string lib_root; // the root of --lib, read only when have_lib
    bool emit_interface; // --emit-interface: the interface file of --lib on stdout
    bool have_ar; // --ar was given, which only --lib takes
    string ar; // --ar, the archiver that writes `lib.a`
    bool have_cache_dir; // --cache-dir was given, which only a library build takes
    string cache_dir; // --cache-dir, read only when have_cache_dir
    bool cache_stats; // --cache-stats: the line of the cache outcome on stdout after the build
    containers.str_vec use_names; // the name of each --use, in command-line order
    containers.str_vec use_paths; // the artifact of each --use, at the matching position
    containers.str_vec includes; // -I roots, searched in command-line order
    containers.str_vec libs;     // -l<lib> as given, passed to the linker in order
    containers.str_vec cc_args;  // -Xcc arguments, passed verbatim after the rest
    containers.str_vec cfg_keys; // --cfg keys, unique and in command-line order
    containers.str_vec cfg_values; // values at the matching positions
}

fn options_create() options {
    options mut opts = options{};
    opts.cc = DEFAULT_CC;
    opts.target = os.TARGET;
    opts.ar = DEFAULT_AR;
    return opts;
}

fn options_free(options mut* opts) void {
    containers.str_free(&opts->includes);
    containers.str_free(&opts->libs);
    containers.str_free(&opts->cc_args);
    containers.str_free(&opts->cfg_keys);
    containers.str_free(&opts->cfg_values);
    containers.str_free(&opts->use_names);
    containers.str_free(&opts->use_paths);
    containers.str_free(&opts->run_args);
}

// What --help prints after the usage line: the option table.
fn help() void {
    println(USAGE);
    println("options:");
    println("  -o <file>          write the output to <file> (default a.out)");
    println("  -S                 stop after emitting the LLVM IR module <entry>.ll");
    println("  -c                 stop after compiling that module to <entry>.o");
    println("  -I <dir>           add a module search root; repeatable, in order");
    println("  --std-dir <dir>    the standard library directory");
    println("  --release          release mode");
    println("  --no-bounds-check  remove the index and span checks; unsafe");
    println("  -l<lib>            pass -l<lib> to the linker; repeatable, in order");
    println("  --cc <path>        the clang that compiles and links the IR (default ",
            DEFAULT_CC, ")");
    println("  --target <triple>  pass --target=<triple> to --cc (default ",
            os.TARGET, ")");
    println("  --cfg <list>       set key=value pairs; repeatable");
    println("  -Xcc <arg>         pass <arg> to --cc verbatim; repeatable, in order");
    println("  --check            check the program, its overwrites and its leaks; emit nothing");
    println("  --leak-report      as --check, and write each leak site that is no error yet");
    println("  --json             write the check document to stdout; needs --check");
    println("  --index            fill the document's identifier index; implies --check --json");
    println("  --tokens           write the entry file's tokens to stdout and stop");
    println("  --ast              write the entry file's syntax tree to stdout and stop");
    println("  --fir              write the program's FIR to stdout and stop");
    println("  --fir-after=<pass> write the FIR after <pass>: lower or build-mode");
    println("  --fir-test         read a .fir test, run its passes and write the FIR");
    println("  --fir-verify-report");
    println("                     write the first FIR violation of each function and stop");
    println("  --fir-stats        after the build, write `lowered N of M` functions");
    println("  --fir-run          run the program's FIR; the arguments after -- go to it");
    println("  --fir-events       with --fir-run, report the ownership events of the run");
    println("  --lib <name> <root>");
    println("                     build the library <name> from the directory <root>");
    println("  --use <name>=<path>");
    println("                     use the library artifact <path> as <name>; repeatable");
    println("  --emit-interface   write the interface file of --lib to stdout and stop");
    println("  --ar <path>        the archiver that writes the lib.a of --lib (default ",
            DEFAULT_AR, ")");
    println("  --cache-dir <dir>  the cache directory of a library build");
    println("  --cache-stats      write the cache outcome of a library build to stdout");
    println("  --help             print this help and exit");
    println("  --version          print the compiler version and exit");
}

// `fort: error: <message>` on stderr, the form every usage, toolchain and
// internal error takes.
fn error(string message) void {
    eprintln("fort: error: ", message);
}

// `fort: error: <what> '<path>': <reason>`, the form of
// `cannot read 'x.ft': No such file or directory`.
fn error_path(string what, string path, string reason) void {
    eprintln("fort: error: ", what, " '", path, "': ", reason);
}

// A usage error, followed by the usage line.
fn usage_error(string message) void {
    error(message);
    eprintln(USAGE);
}

// The same with the offending argument quoted after the message.
fn usage_error_arg(string message, string detail) void {
    eprintln("fort: error: ", message, " '", detail, "'");
    eprintln(USAGE);
}

// Whether `arg` is an option rather than the entry file: the first argument
// that does not start with '-' is the entry file.
fn is_option(string arg) bool {
    return arg.len > 0 && arg[0] == '-';
}

// Returns whether `arg` is `-l<lib>`. The library is part of this single argument. Other options
// take their values in separate arguments.
fn is_link_option(string arg) bool {
    return arg.len > 2 && arg[0] == '-' && arg[1] == 'l';
}

// The argument of an option that takes the following one; false after
// reporting the usage error. *i is left on the argument. -o, -I, --std-dir,
// --cc, --target, --cfg and -Xcc take the following argument, whatever it
// looks like.
fn take_argument(string@ args, u64 mut* i, string mut* out) bool {
    if (*i + 1 >= args.len) {
        usage_error_arg("missing argument for option", args[*i]);
        return false;
    }
    *i += 1;
    *out = args[*i];
    return true;
}

fn reserved_cfg(string key) bool {
    return key == "target_os" || key == "target_arch" || key == "target_abi";
}

fn valid_cfg_key(string key) bool {
    if (key.len == 0 || !(str.is_alpha(key[0]) || key[0] == '_')) {
        return false;
    }
    u64 mut i = 1;
    while (i < key.len) {
        if (!(str.is_alpha(key[i]) || str.is_digit(key[i]) || key[i] == '_')) {
            return false;
        }
        i += 1;
    }
    return lexer.keyword_kind(key) == lexer.tok_kind.ident && !lexer.is_reserved_word(key);
}

fn has_cfg(options* opts, string key) bool {
    u64 mut i = 0;
    while (i < opts->cfg_keys.len) {
        if (containers.str_at(&opts->cfg_keys, i) == key) {
            return true;
        }
        i += 1;
    }
    return false;
}

// Parses one comma-separated `--cfg` value. A value can hold `=` and can be
// empty. A comma always starts a new assignment.
fn parse_cfg(options mut* opts, string list) bool {
    u64 mut start = 0;
    while (start <= list.len) {
        u64 mut end = start;
        while (end < list.len && list[end] != ',') {
            end += 1;
        }
        if (end == start) {
            usage_error("empty --cfg list entry");
            return false;
        }
        string item = list[start..end];
        i64 equal = str.index_of(item, '=');
        if (equal < 0) {
            usage_error_arg("invalid --cfg assignment", item);
            return false;
        }
        string key = item[..cast(equal, u64)];
        string value = item[cast(equal, u64) + 1..];
        if (!valid_cfg_key(key)) {
            usage_error_arg("invalid --cfg key", key);
            return false;
        }
        if (reserved_cfg(key)) {
            usage_error_arg("cannot override compiler configuration key", key);
            return false;
        }
        if (has_cfg(opts, key)) {
            usage_error_arg("duplicate --cfg key", key);
            return false;
        }
        containers.str_push(&opts->cfg_keys, key);
        containers.str_push(&opts->cfg_values, value);
        if (end == list.len) {
            return true;
        }
        start = end + 1;
    }
    return true;
}

// The options that carry no value: -S, -c, --release, --no-bounds-check, --check,
// --leak-report, --json, --index, --tokens, --ast, --fir, --fir-test, --fir-verify-report,
// --fir-stats, --fir-run, --emit-interface and --cache-stats, each of which sets one flag.
fn parse_flag(options mut* opts, string arg) bool {
    if (arg == "-S") {
        opts->emit_ir = true;
    } else if (arg == "-c") {
        opts->compile_only = true;
    } else if (arg == "--release") {
        opts->release = true;
    } else if (arg == "--no-bounds-check") {
        opts->no_bounds_check = true;
    } else if (arg == "--check") {
        opts->check = true;
    } else if (arg == "--leak-report") {
        // --leak-report implies --check, which runs the emptiness pass
        opts->leak_report = true;
        opts->check = true;
    } else if (arg == "--json") {
        opts->json = true;
    } else if (arg == "--index") {
        // --index implies --check and --json
        opts->index = true;
        opts->check = true;
        opts->json = true;
    } else if (arg == "--tokens") {
        // --tokens implies nothing and combines with nothing
        opts->tokens = true;
    } else if (arg == "--ast") {
        // --ast implies nothing and combines with nothing either
        opts->ast = true;
    } else if (arg == "--fir") {
        // --fir runs the front end and stops before the emitter
        opts->fir = true;
    } else if (arg == "--fir-test") {
        // the entry is a `.fir` test, not a program
        opts->fir_test = true;
    } else if (arg == "--fir-verify-report") {
        // --fir, with the report of the verifier in place of the FIR
        opts->fir = true;
        opts->fir_report = true;
    } else if (arg == "--fir-stats") {
        // counts the two paths of the emitter
        opts->fir_stats = true;
    } else if (arg == "--fir-run") {
        // runs the FIR of the program in place of a build
        opts->fir_run = true;
    } else if (arg == "--fir-events") {
        opts->fir_events = true;
    } else if (arg == "--emit-interface") {
        // writes the interface file of the library and stops (D9.11)
        opts->emit_interface = true;
    } else if (arg == "--cache-stats") {
        // writes the cache outcome of a library build (D9.11)
        opts->cache_stats = true;
    } else {
        return false;
    }
    return true;
}

// The options that take the following argument. Returns false when `arg` is not
// one of them; *ok is false when the argument was missing. The last -o,
// --std-dir, --cc, --target, --ar and --cache-dir win, while -I, --cfg, -l and -Xcc
// accumulate in command-line order. A duplicate configuration key is an error.
fn parse_valued(options mut* opts, string@ args, u64 mut* i, bool mut* ok) bool {
    string arg = args[*i];
    bool is_output = arg == "-o";
    bool is_include = arg == "-I";
    bool is_std_dir = arg == "--std-dir";
    bool is_cc = arg == "--cc";
    bool is_target = arg == "--target";
    bool is_cfg = arg == "--cfg";
    bool is_cc_arg = arg == "-Xcc";
    bool is_ar = arg == "--ar";
    bool is_use = arg == "--use";
    bool is_cache_dir = arg == "--cache-dir";
    if (!is_output && !is_include && !is_std_dir && !is_cc && !is_target && !is_cfg
        && !is_cc_arg && !is_ar && !is_use && !is_cache_dir) {
        return false;
    }
    string mut value = "";
    if (!take_argument(args, i, &value)) {
        *ok = false;
        return true;
    }
    if (is_output) {
        opts->have_output = true;
        opts->output = value;
    } else if (is_include) {
        containers.str_push(&opts->includes, value);
    } else if (is_std_dir) {
        opts->have_std_dir = true;
        opts->std_dir = value;
    } else if (is_cc) {
        opts->cc = value;
    } else if (is_target) {
        opts->target = value;
    } else if (is_cfg) {
        if (!parse_cfg(opts, value)) {
            *ok = false;
        }
    } else if (is_ar) {
        opts->have_ar = true;
        opts->ar = value;
    } else if (is_use) {
        if (!parse_use(opts, value)) {
            *ok = false;
        }
    } else if (is_cache_dir) {
        opts->have_cache_dir = true;
        opts->cache_dir = value;
    } else {
        containers.str_push(&opts->cc_args, value);
    }
    return true;
}

// Whether `v` holds `text`: a --use of a name, or a file of the check document.
fn has_string(containers.str_vec* v, string text) bool {
    u64 mut i = 0;
    while (i < v->len) {
        if (containers.str_at(v, i) == text) {
            return true;
        }
        i += 1;
    }
    return false;
}

// Parses the argument of one `--use`, `<name>=<path>`, which splits at its first `=`: the name
// must be a segment and the path must not be empty (toolchain.md 1). A second --use of one name
// is a usage error.
fn parse_use(options mut* opts, string value) bool {
    i64 equal = str.index_of(value, '=');
    if (equal < 0 || !tree.is_segment(value[..cast(equal, u64)])
        || cast(equal, u64) + 1 == value.len) {
        usage_error_arg("invalid --use argument", value);
        return false;
    }
    string name = value[..cast(equal, u64)];
    if (has_string(&opts->use_names, name)) {
        usage_error_arg("duplicate library", name);
        return false;
    }
    containers.str_push(&opts->use_names, name);
    containers.str_push(&opts->use_paths, value[cast(equal, u64) + 1..]);
    return true;
}

// Parses `--fir-after=<pass>`, which implies --fir. A name that FIR_PASSES does not hold
// is a usage error. The last --fir-after wins, as the last -o does.
fn parse_fir_after(options mut* opts, string arg) bool {
    string pass = arg[FIR_AFTER_PREFIX.len..];
    for (string known : FIR_PASSES) {
        if (pass == known) {
            opts->fir = true;
            opts->fir_after = pass;
            return true;
        }
    }
    usage_error_arg("unknown --fir-after pass", pass);
    return false;
}

// Parses args[1..] into *opts, which options_create has prepared. --help and
// --version print to stdout. A usage error prints `fort: error: <message>`
// and the usage line to stderr.
fn parse(options mut* opts, string@ args) i32 {
    u64 mut i = 1;
    while (i < args.len) {
        string arg = args[i];
        if (!is_option(arg)) {
            // the first argument that does not start with '-'
            if (opts->have_entry) {
                usage_error_arg("unexpected argument", arg);
                return PARSE_ERROR;
            }
            opts->have_entry = true;
            opts->entry = arg;
        } else if (arg == RUN_ARGS) {
            // every later argument, whatever it looks like, goes to the program
            opts->have_run_args = true;
            i += 1;
            while (i < args.len) {
                containers.str_push(&opts->run_args, args[i]);
                i += 1;
            }
        } else if (arg == "--help") {
            help();
            return PARSE_DONE;
        } else if (arg == "--version") {
            println("fort ", VERSION);
            return PARSE_DONE;
        } else if (is_link_option(arg)) {
            containers.str_push(&opts->libs, arg);
        } else if (str.starts_with(arg, FIR_AFTER_PREFIX)) {
            if (!parse_fir_after(opts, arg)) {
                return PARSE_ERROR;
            }
        } else if (arg == "--lib") {
            // the two following arguments, whatever they look like
            if (i + 2 >= args.len) {
                usage_error_arg("missing argument for option", arg);
                return PARSE_ERROR;
            }
            opts->lib_name = args[i + 1];
            opts->lib_root = args[i + 2];
            opts->have_lib = true;
            i += 2;
        } else if (!parse_flag(opts, arg)) {
            bool mut ok = true;
            if (!parse_valued(opts, args, &i, &ok)) {
                usage_error_arg("unknown option", arg);
                return PARSE_ERROR;
            }
            if (!ok) {
                return PARSE_ERROR;
            }
        }
        i += 1;
    }
    if ((opts->have_cache_dir || opts->cache_stats) && !opts->have_lib
        && opts->use_names.len == 0) {
        // only a library build has a cache (D9.11); --cache-dir reports first
        if (opts->have_cache_dir) {
            usage_error("--cache-dir requires --lib or --use");
        } else {
            usage_error("--cache-stats requires --lib or --use");
        }
        return PARSE_ERROR;
    }
    if (opts->have_lib || opts->emit_interface || opts->have_ar) {
        return check_library_options(opts);
    }
    if (!opts->have_entry) {
        usage_error("no entry file");
        return PARSE_ERROR;
    }
    if (opts->tokens && (opts->check || opts->json || opts->index)) {
        // --tokens stops before the parser
        usage_error("--tokens does not combine with --check, --json or --index");
        return PARSE_ERROR;
    }
    if (opts->ast && (opts->tokens || opts->check || opts->json || opts->index)) {
        // --ast stops before the checker
        usage_error("--ast does not combine with --tokens, --check, --json or --index");
        return PARSE_ERROR;
    }
    if (opts->fir && (opts->tokens || opts->ast || opts->check || opts->json)) {
        // --fir writes its own text to stdout after the checker; --index sets --check
        usage_error("--fir does not combine with --tokens, --ast, --check, --json or --index");
        return PARSE_ERROR;
    }
    if (opts->fir_test && (opts->tokens || opts->ast || opts->check || opts->json || opts->fir)) {
        // --fir-test reads a `.fir` test, which none of the other modes reads
        usage_error(FIR_TEST_ALONE);
        return PARSE_ERROR;
    }
    if (opts->fir_stats
        && (opts->tokens || opts->ast || opts->check || opts->fir || opts->fir_test)) {
        // --fir-stats counts what the emitter writes, and none of these modes emits
        usage_error(FIR_STATS_ALONE);
        return PARSE_ERROR;
    }
    if (opts->fir_run
        && (opts->tokens || opts->ast || opts->check || opts->json || opts->fir || opts->fir_test
            || opts->fir_stats || opts->use_names.len > 0 || opts->release
            || opts->no_bounds_check)) {
        // --fir-run runs the closure from source in the checked mode and builds nothing;
        // --index sets --check, and --fir-after and --fir-verify-report set --fir
        eprintln("fort: error: ", FIR_RUN_ALONE_HEAD, FIR_RUN_ALONE_TAIL);
        eprintln(USAGE);
        return PARSE_ERROR;
    }
    if (opts->have_run_args && !opts->fir_run) {
        // only a run takes arguments for its program
        usage_error("-- requires --fir-run");
        return PARSE_ERROR;
    }
    if (opts->have_output && opts->output == STDOUT_OUTPUT && !opts->emit_ir
        && !opts->compile_only && !opts->check && !opts->tokens && !opts->ast && !opts->fir
        && !opts->fir_test && !opts->fir_run) {
        // a link writes an executable, and stdout is no place for one (toolchain.md 1)
        usage_error("-o - requires -S or -c");
        return PARSE_ERROR;
    }
    if (opts->fir_events && !opts->fir_run) {
        usage_error("--fir-events requires --fir-run");
        return PARSE_ERROR;
    }
    if (opts->json && !opts->check) {
        // a build spawns a `--cc` that inherits stdout
        usage_error("--json requires --check");
        return PARSE_ERROR;
    }
    if (opts->leak_report && opts->json) {
        // the report and the document both go to stdout
        usage_error("--leak-report does not combine with --json or --index");
        return PARSE_ERROR;
    }
    if (opts->use_names.len > 0 && !opts->tokens && !opts->ast
        && !has_string(&opts->use_names, modules.STD_SEGMENT)) {
        // every closure holds std.rt, and only the library std holds it (D9.10, D9.11)
        usage_error(NEEDS_STD);
        return PARSE_ERROR;
    }
    return PARSE_OK;
}

// The usage error of a library build that names no library std.
string NEEDS_STD = "a library build needs --use std=<path>";

// The rules of a library build on the command line (toolchain.md 1, D9.11). A `--lib` build takes
// no entry file, and only `--lib std` builds without `--use std=<path>`.
fn check_library_options(options* opts) i32 {
    if (!opts->have_lib && opts->emit_interface) {
        usage_error("--emit-interface requires --lib");
        return PARSE_ERROR;
    }
    if (!opts->have_lib) {
        usage_error("--ar requires --lib");
        return PARSE_ERROR;
    }
    if (opts->have_entry) {
        usage_error_arg("unexpected argument", opts->entry);
        return PARSE_ERROR;
    }
    if (!tree.is_segment(opts->lib_name)) {
        usage_error_arg("invalid library name", opts->lib_name);
        return PARSE_ERROR;
    }
    if (has_string(&opts->use_names, opts->lib_name)) {
        // a library does not use itself
        usage_error_arg("duplicate library", opts->lib_name);
        return PARSE_ERROR;
    }
    if (opts->includes.len > 0 || opts->libs.len > 0 || opts->check || opts->json || opts->index
        || opts->tokens || opts->ast || opts->fir || opts->fir_test || opts->fir_stats
        || opts->fir_run || opts->have_run_args) {
        eprintln("fort: error: ", LIB_ALONE_HEAD, LIB_ALONE_TAIL);
        eprintln(USAGE);
        return PARSE_ERROR;
    }
    if (opts->emit_interface && (opts->emit_ir || opts->compile_only || opts->have_output)) {
        // the interface goes to stdout, so the command line names no file to write
        usage_error("--emit-interface does not combine with -S, -c or -o");
        return PARSE_ERROR;
    }
    if (opts->have_output && opts->output == STDOUT_OUTPUT && !opts->emit_ir
        && !opts->compile_only) {
        // an artifact is a directory, and stdout is no place for one (toolchain.md 1)
        usage_error("-o - requires -S or -c");
        return PARSE_ERROR;
    }
    if (opts->lib_name != modules.STD_SEGMENT
        && !has_string(&opts->use_names, modules.STD_SEGMENT)) {
        usage_error(NEEDS_STD);
        return PARSE_ERROR;
    }
    return PARSE_OK;
}

// Whether the target has one of the two forms.
fn target_form(string target) bool {
    if (target == "x86_64-linux-gnu") {
        return true;
    }
    string prefix = "arm64-apple-macosx";
    if (!str.starts_with(target, prefix)) {
        return false;
    }
    u64 mut i = prefix.len;
    u64 mut digits = 0;
    u64 mut dots = 0;
    while (i < target.len) {
        if (str.is_digit(target[i])) {
            digits += 1;
        } else if (target[i] == '.' && digits > 0 && dots < 2) {
            dots += 1;
            digits = 0;
        } else {
            return false;
        }
        i += 1;
    }
    return dots == 2 && digits > 0;
}

// Appends the configuration map of the build to `keys` and `values`: the three compiler keys of
// the target, and then the user keys in command-line order (D21.1).
fn append_config(options* opts, containers.str_vec mut* keys, containers.str_vec mut* values)
    void {
    containers.str_push(keys, "target_os");
    containers.str_push(keys, "target_arch");
    if (opts->target == "x86_64-linux-gnu") {
        containers.str_push(values, "linux");
        containers.str_push(values, "x86_64");
    } else {
        containers.str_push(values, "macos");
        containers.str_push(values, "aarch64");
    }
    containers.str_push(keys, "target_abi");
    containers.str_push(values, "");
    u64 mut i = 0;
    while (i < opts->cfg_keys.len) {
        containers.str_push(keys, containers.str_at(&opts->cfg_keys, i));
        containers.str_push(values, containers.str_at(&opts->cfg_values, i));
        i += 1;
    }
}

// Adds the compiler keys and the user keys to the one analysis session.
fn configure(session.session mut* s, options* opts) void {
    containers.str_vec mut keys = containers.str_create();
    defer containers.str_free(&keys);
    containers.str_vec mut values = containers.str_create();
    defer containers.str_free(&values);
    append_config(opts, &keys, &values);
    u64 mut i = 0;
    while (i < keys.len) {
        session.config_set(s, containers.str_at(&keys, i), containers.str_at(&values, i));
        i += 1;
    }
}

// The default --cc on both targets: the clang that PATH finds (D14.1, D14.3).
string DEFAULT_CC = "clang";

// The default --ar on both targets: the archiver that PATH finds (D9.11).
string DEFAULT_AR = "ar";

// Rejects a target that this IR mode cannot use before it creates output.
// The front-end modes do not call this function.
fn target_allowed(options* opts) bool {
    if (!target_form(opts->target)) {
        usage_error_arg("unsupported target", opts->target);
        return false;
    }
    if (opts->target == os.TARGET) {
        return true;
    }
    if (opts->emit_ir) {
        // a library build reads its standard modules from the used library std
        if (opts->have_std_dir || opts->use_names.len > 0) {
            return true;
        }
        usage_error("--std-dir is required for cross-target -S");
    } else if (opts->compile_only) {
        eprintln("fort: error: cannot compile object for target '", opts->target,
                 "' with a '", os.TARGET, "' compiler");
        eprintln(USAGE);
    } else {
        eprintln("fort: error: cannot link target '", opts->target,
                 "' with a '", os.TARGET, "' compiler");
        eprintln(USAGE);
    }
    return false;
}

// --tokens lexes the entry file alone. It resolves no import and parses nothing.
// It writes one line per token to stdout. A lexical error does not stop lexing, so the
// dump covers the whole file either way. The status is then a compile error.
fn tokens_entry(options* opts) i32 {
    session.session mut s = session.create();
    defer session.free(&s);
    string mut source = "";
    if (!session.read_source(&s, opts->entry, &source)) {
        error_path("cannot read", opts->entry, str.from_cstr(libc.strerror(sys.errno())));
        return EXIT_USAGE;
    }
    // a batch driver writes the text form as it arrives
    diag.set_text(session.diags(&s), true);
    session.show_sources(&s);
    lexer.tok_vec mut toks = lexer.tokvec_create();
    defer lexer.tokvec_free(&toks);
    bool clean = lexer.lex_file(&s, opts->entry, source, &toks);
    strbuf.str_buf mut dump = strbuf.create();
    defer strbuf.free(&dump);
    lexer.tok_dump(&toks, &dump);
    print(strbuf.view(&dump));
    if (clean) {
        return EXIT_OK;
    }
    return EXIT_COMPILE_ERROR;
}

// --ast lexes and parses the entry file alone -- no import is resolved and nothing is checked. It
// writes one S-expression and a final newline to stdout. The lexer continues after a lexical error.
// The parser continues after a syntax error. Thus, the tree covers the complete file. The status is
// then a compile error.
fn ast_entry(options* opts) i32 {
    session.session mut s = session.create();
    defer session.free(&s);
    string mut source = "";
    if (!session.read_source(&s, opts->entry, &source)) {
        error_path("cannot read", opts->entry, str.from_cstr(libc.strerror(sys.errno())));
        return EXIT_USAGE;
    }
    // a batch driver writes the text form as it arrives
    diag.set_text(session.diags(&s), true);
    session.show_sources(&s);
    lexer.tok_vec mut toks = lexer.tokvec_create();
    defer lexer.tokvec_free(&toks);
    lexer.lex_file(&s, opts->entry, source, &toks);
    // the tokens cover the whole file, so the parse runs
    ast.arena mut ar = ast.arena{};
    defer ast.ast_arena_free(&ar);
    ast.node mut* mod = parser.parse_module(&s, opts->entry, &toks, &ar);
    strbuf.str_buf mut dump = strbuf.create();
    defer strbuf.free(&dump);
    ast.ast_dump(mod, &dump);
    strbuf.push(&dump, '\n');
    print(strbuf.view(&dump));
    if (session.error_count(&s) == 0) {
        return EXIT_OK;
    }
    return EXIT_COMPILE_ERROR;
}

// ---- the standard library directory ------------------------------

// The standard library sits in `std` beside the binary when --std-dir and
// $FORT_STD_DIR name nothing.
string STD_DIR_NAME = "std";

// The path of the running binary; false when the OS cannot give it.
// Linux reads /proc/self/exe. Mac reads dyld's path and resolves it with
// realpath when possible. *out stays unchanged on failure. The path is
// interned in `p`.
fn exe_path(containers.pool mut* p, string mut* out) bool {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    if (!os.exe_path(&b)) {
        return false;
    }
    *out = containers.pool_intern(p, strbuf.view(&b));
    return true;
}

// `std` in the directory containing `program`, or `std` alone when `program`
// has no directory part. Interned in `p`.
fn std_dir_beside(containers.pool mut* p, string program) string {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    i64 last = str.last_index_of(program, '/');
    if (last >= 0) {
        strbuf.append(&b, program[0..cast(last, u64) + 1]);
    }
    strbuf.append(&b, STD_DIR_NAME);
    return containers.pool_intern(p, strbuf.view(&b));
}

// The standard library directory: --std-dir, else
// $FORT_STD_DIR, else `std` beside the fort binary. Linux reads /proc/self/exe.
// Mac reads dyld's executable path. An empty environment value
// names no directory, so it counts as unset. Interned in `p`.
fn std_dir(containers.pool mut* p, options* opts, string program) string {
    // the option as given, the empty one included
    if (opts->have_std_dir) {
        return containers.pool_intern(p, opts->std_dir);
    }
    string mut from_env = "";
    if (sys.env("FORT_STD_DIR", &from_env) && from_env.len > 0) {
        return containers.pool_intern(p, from_env);
    }
    // else `std` beside the fort binary, read from /proc/self/exe
    string mut running = "";
    if (exe_path(p, &running)) {
        return std_dir_beside(p, running);
    }
    // Without /proc, args[0] names the binary. One without a slash was found
    // through PATH, whose directory the driver cannot know, so `std` in the
    // current directory is the last resort.
    return std_dir_beside(p, program);
}

// ---- paths ------------------------------------------------------

// The default output when -o is absent, and the two names the temporary
// directory is built from. bootstrap0/src/driver.h spells
// the first two as macros and driver.c the rest as file-scope arrays.
string DEFAULT_OUTPUT = "a.out";

// The -o value that names stdout under -S and -c (toolchain.md 1). A --cc that writes the
// object takes it as clang does.
string STDOUT_OUTPUT = "-";
string TMP_DIR_DEFAULT = "/tmp";
string TMP_DIR_TEMPLATE = "/fort-XXXXXX";
string IR_SUFFIX = ".ll";
string OBJECT_SUFFIX = ".o";
string FT_SUFFIX = ".ft";

// EINTR, the one errno the driver compares against: a signal caught while
// --cc runs interrupts the wait and not the child (waitpid(2)).
i32 EINTR = 4;

// The position after the last '/' of `path`, that is the start of its last
// component.
fn last_component(string path) u64 {
    u64 mut start = 0;
    u64 mut i = 0;
    while (i < path.len) {
        if (path[i] == '/') {
            start = i + 1;
        }
        i += 1;
    }
    return start;
}

// The entry file's last component with `.ft` removed, which names the IR
// module and the default object.
fn entry_base(string entry) string {
    string mut base = entry[last_component(entry)..];
    if (base.len > FT_SUFFIX.len && str.ends_with(base, FT_SUFFIX)) {
        base = base[0..base.len - FT_SUFFIX.len];
    }
    return base;
}

// `<dir>/<name><suffix>`, interned in `p`. An empty directory or suffix is
// left out, where bootstrap0/src/driver.c passes NULL.
fn join_path(containers.pool mut* p, string dir, string name, string suffix) string {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    if (dir.len > 0) {
        strbuf.append(&b, dir);
        strbuf.push(&b, '/');
    }
    strbuf.append(&b, name);
    strbuf.append(&b, suffix);
    return containers.pool_intern(p, strbuf.view(&b));
}

fn default_output(containers.pool mut* p, options* opts) string {
    // -S and -c together stop at the IR, so -S decides the suffix
    if (opts->emit_ir) {
        return join_path(p, "", entry_base(opts->entry), IR_SUFFIX);
    }
    if (opts->compile_only) {
        return join_path(p, "", entry_base(opts->entry), OBJECT_SUFFIX);
    }
    return containers.pool_intern(p, DEFAULT_OUTPUT);
}

// Writes `data` to stdout after the bytes that the runtime holds for it. Returns false with
// errno set when the write fails.
fn write_stdout(u8@ data) bool {
    io.flush(io.STDOUT);
    return io.write_all(io.STDOUT, data);
}

// ---- the temporary directory ------------------------------------

// Creates the temporary directory with mkdtemp under $TMPDIR, `/tmp` by
// default. The path is interned in `p` and the directory it was created in is
// stored in *parent_out. Returns the empty string and the errno of the
// failure in *error_out, captured before anything else can overwrite it.
fn make_temp_dir(containers.pool mut* p, string mut* parent_out, i32 mut* error_out) string {
    string mut parent = TMP_DIR_DEFAULT;
    string mut value = "";
    // An empty value names no directory, so it counts as unset.
    if (sys.env("TMPDIR", &value) && value.len > 0) {
        parent = value;
    }
    *parent_out = parent;
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, parent);
    strbuf.append(&b, TMP_DIR_TEMPLATE);
    // mkdtemp replaces the six X in place, so this is our own
    char mut@ own tmpl = str.to_cstr(strbuf.view(&b));
    defer del(tmpl);
    *error_out = 0;
    if (libc.mkdtemp(&tmpl[0]) == null) {
        *error_out = sys.errno();
        return "";
    }
    return containers.pool_intern(p, str.from_cstr(&tmpl[0]));
}

// Removes the temporary directory and the module in it, whether or not --cc
// succeeded. The compiler writes exactly one file there, one
// `<entry>.ll`, so no directory walk is needed. A file already gone is not an
// error.
fn remove_temp_dir(string dir, string ir_path) void {
    if (ir_path.len > 0) {
        char mut@ own path = str.to_cstr(ir_path);
        defer del(path);
        libc.unlink(&path[0]);
    }
    char mut@ own d = str.to_cstr(dir);
    defer del(d);
    libc.rmdir(&d[0]);
}

// ---- the clang invocation --------------------------------------------------------

// Builds the --cc command line in the same order as bootstrap0/src/driver.c.
fn cc_argv(containers.pool mut* p, options* opts, string ir_path, string out_path,
                containers.str_vec mut* argv) void {
    push_cc_line(p, opts, ir_path, out_path, opts->compile_only, argv);
}

// Pushes the --cc command line over the module `ir_path` to `argv`: with `compile` set, it
// compiles the module to the object `out_path` (`-c`, no `-l` option); else it compiles and links
// the program.
fn push_cc_line(containers.pool mut* p, options* opts, string ir_path, string out_path,
                bool compile, containers.str_vec mut* argv) void {
    containers.str_push(argv, opts->cc);
    containers.str_push(argv, join_path(p, "", "--target=", opts->target));
    // Use -O2 under --release and -O1 otherwise. The compiler does not optimize the IR.
    if (opts->release) {
        containers.str_push(argv, "-O2");
    } else {
        containers.str_push(argv, "-O1");
    }
    containers.str_push(argv, "-fPIE");
    // The module carries its own target triple, which clang would warn about
    containers.str_push(argv, "-Wno-override-module");
    if (compile) {
        containers.str_push(argv, "-c");
    }
    containers.str_push(argv, "-o");
    containers.str_push(argv, out_path);
    // The one input is the module, which holds the whole program, the runtime
    // included. No -x ir: clang reads a `.ll` by its suffix and -x is sticky
    containers.str_push(argv, ir_path);
    if (!compile) {
        u64 mut i = 0;
        while (i < opts->libs.len) {
            containers.str_push(argv, containers.str_at(&opts->libs, i));
            i += 1;
        }
    }
    // -Xcc arguments come last, verbatim and in order
    u64 mut k = 0;
    while (k < opts->cc_args.len) {
        containers.str_push(argv, containers.str_at(&opts->cc_args, k));
        k += 1;
    }
}

// The bytes of every argument, each NUL-terminated, and a NULL-terminated array
// of pointers into them: what execvp takes. bootstrap0/src/driver.c pushes the
// arguments as C strings it already has. A fort `string` is a pointer and a
// length and is not NUL-terminated, so they are copied here, once, into storage
// the caller releases.
struct cc_command {
    char mut@ own bytes;      // every argument, each followed by its NUL
    char mut* mut@ own items; // one pointer per argument, then null
}

fn cc_command_build(containers.str_vec* argv) cc_command {
    u64 mut total = 0;
    u64 mut i = 0;
    while (i < argv->len) {
        total += containers.str_at(argv, i).len + 1;
        i += 1;
    }
    cc_command mut c = cc_command{};
    c.bytes = new(char, total);
    c.items = new(char mut*, argv->len + 1);
    u64 mut at = 0;
    i = 0;
    while (i < argv->len) {
        string arg = containers.str_at(argv, i);
        c.items[i] = &c.bytes[at];
        u64 mut k = 0;
        while (k < arg.len) {
            c.bytes[at] = arg[k];
            at += 1;
            k += 1;
        }
        c.bytes[at] = '\0';
        at += 1;
        i += 1;
    }
    c.items[argv->len] = null;
    return c;
}

fn cc_command_free(cc_command mut* c) void {
    del(c->bytes);
    del(c->items);
}

// Reports either `<role> failed with status N` or `<role> failed with signal N`, where `role` is
// `cc` or `ar`.
fn error_tool_status(string role, string what, i64 value) void {
    strbuf.str_buf mut m = strbuf.create();
    defer strbuf.free(&m);
    strbuf.append(&m, role);
    strbuf.append(&m, " failed with ");
    strbuf.append(&m, what);
    strbuf.push(&m, ' ');
    strbuf.append_i64(&m, value);
    error(strbuf.view(&m));
}

// Implements the three wait(2) macros, which fort does not provide. A low byte of 0x7F means
// stopped. Zero means exited. Other values hold the terminating signal. The second byte holds the
// exit status.
u32 WAIT_SIGNAL_MASK = 127;
u32 WAIT_STATUS_SHIFT = 8;
u32 WAIT_STATUS_MASK = 255;

fn wait_signaled(i32 status) bool {
    u32 low = cast(status, u32) & WAIT_SIGNAL_MASK;
    return low != 0 && low != WAIT_SIGNAL_MASK;
}

fn wait_signal(i32 status) i64 {
    return cast(cast(status, u32) & WAIT_SIGNAL_MASK, i64);
}

fn wait_status(i32 status) i64 {
    return cast((cast(status, u32) >> WAIT_STATUS_SHIFT) & WAIT_STATUS_MASK, i64);
}

// The errno of a failed execvp, written by the child and read by the parent,
// four bytes little end first. Nothing else is ever written to that pipe, so
// a short read means the child reached execvp and a full one means it did
// not.
u64 ERRNO_BYTES = 4;
u64 BYTE_BITS = 8;
u64 BYTE_MASK = 255;

// F_SETFD and FD_CLOEXEC of fcntl(2): the write end of the pipe closes at
// execvp, which is what tells the parent the exec succeeded.
i32 F_SETFD = 2;
i32 FD_CLOEXEC = 1;

// Defines the status for a child that cannot exec. The parent reads errno from the pipe first, so
// --cc cannot report this value.
i32 EXEC_FAILED_STATUS = 127;

// Runs --cc once over the module: it compiles and links in one invocation.
// Returns EXIT_OK, or EXIT_USAGE after reporting the failure.
fn run_cc(options* opts, string ir_path, string out_path) i32 {
    containers.pool mut p = containers.pool_create();
    defer containers.pool_free(&p);
    containers.str_vec mut argv = containers.str_create();
    defer containers.str_free(&argv);
    cc_argv(&p, opts, ir_path, out_path, &argv);
    return run_tool("cc", &argv);
}

// The variable that makes Apple ar write zero for the time of each member, so that two archives
// of one object are the same bytes (toolchain.md 2.1, step 8). GNU ar and llvm-ar ignore it.
string ZERO_AR_DATE = "ZERO_AR_DATE";
string ZERO_AR_DATE_VALUE = "1";

// Runs the command `argv`, whose first argument names the program, and waits for it. `role` is
// `cc` or `ar`, the word of the status messages. The archiver runs with ZERO_AR_DATE=1 in its
// environment and the other tools with the environment of the compiler. Returns EXIT_OK, or
// EXIT_USAGE after reporting the failure: `cannot run '<program>': <reason>`, or `<role> failed
// with status <n>` or `... with signal <n>`.
fn run_tool(string role, containers.str_vec* argv) i32 {
    string program = containers.str_at(argv, 0);
    cc_command mut cmd = cc_command_build(argv);
    defer cc_command_free(&cmd);
    // made before fork(2), so the child only calls setenv(3) and execvp(3)
    char mut@ own env_name = str.to_cstr(ZERO_AR_DATE);
    defer del(env_name);
    char mut@ own env_value = str.to_cstr(ZERO_AR_DATE_VALUE);
    defer del(env_value);
    i32[2] mut fds = {};
    if (libc.pipe(&fds[0]) != 0) {
        error_path("cannot run", program, str.from_cstr(libc.strerror(sys.errno())));
        return EXIT_USAGE;
    }
    if (libc.fcntl(fds[1], F_SETFD, FD_CLOEXEC) != 0) {
        // The write end has to close at execvp: that is what tells the parent the exec succeeded.
        // An open write end in --cc or its child keeps the read blocked until the last process
        // exits. This is only a delay. Report close failure here instead of treating it as a
        // missing errno.
        error_path("cannot run", program, str.from_cstr(libc.strerror(sys.errno())));
        io.close(fds[0]);
        io.close(fds[1]);
        return EXIT_USAGE;
    }
    i32 child = libc.fork();
    if (child < 0) {
        i32 failure = sys.errno();
        io.close(fds[0]);
        io.close(fds[1]);
        error_path("cannot run", program, str.from_cstr(libc.strerror(failure)));
        return EXIT_USAGE;
    }
    if (child == 0) {
        // The child replaces itself with --cc. Reaching the line after execvp means it failed. The
        // child sends errno through the pipe. The parent reports it as a posix_spawnp result.
        io.close(fds[0]);
        if (role == "ar") {
            // a failure leaves the environment as it was, and the archive can then hold a time
            libc.setenv(env_name.ptr, env_value.ptr, 1);
        }
        libc.execvp(&cmd.bytes[0], cast(&cmd.items[0], void*));
        u64 e = cast(sys.errno(), u64);
        u8[4] mut buf = {};
        u64 mut i = 0;
        while (i < ERRNO_BYTES) {
            buf[i] = cast((e >> (i * BYTE_BITS)) & BYTE_MASK, u8);
            i += 1;
        }
        io.write_all(fds[1], buf[0..ERRNO_BYTES]);
        libc._exit(EXEC_FAILED_STATUS);
    }
    io.close(fds[1]);
    u8[4] mut got = {};
    i64 read = io.read(fds[0], got[0..ERRNO_BYTES]);
    io.close(fds[0]);
    i32 mut status = 0;
    // The child is reaped whatever it did, so no zombie outlives the run. A
    // signal caught while clang runs interrupts the wait, not the child.
    i32 mut waited = libc.waitpid(child, &status, 0);
    while (waited < 0 && sys.errno() == EINTR) {
        waited = libc.waitpid(child, &status, 0);
    }
    if (read == cast(ERRNO_BYTES, i64)) {
        u64 mut e = 0;
        u64 mut i = 0;
        while (i < ERRNO_BYTES) {
            e |= cast(got[i], u64) << (i * BYTE_BITS);
            i += 1;
        }
        error_path("cannot run", program, str.from_cstr(libc.strerror(cast(e, i32))));
        return EXIT_USAGE;
    }
    if (waited < 0) {
        error_path("cannot wait for", program, str.from_cstr(libc.strerror(sys.errno())));
        return EXIT_USAGE;
    }
    if (wait_signaled(status)) {
        error_tool_status(role, "signal", wait_signal(status));
        return EXIT_USAGE;
    }
    if (wait_status(status) != 0) {
        error_tool_status(role, "status", wait_status(status));
        return EXIT_USAGE;
    }
    return EXIT_OK;
}

// ---- the used libraries -----------------------------------------------

/// The used libraries of a build, read once and checked (toolchain.md 2.1, step 1): the contents
/// of each artifact in command-line order, the path of its interface file, and the link order. A
/// zero value holds no library.
struct libraries {
    artifact.contents mut@ own items; // in command-line order
    u64 len;
    containers.str_vec files; // the interface file of each, `<path>/interface.ft`
    containers.pool pool; // the paths of `files`
    vec.int_vec order; // the index of each library in the link order (module-system.md 10.4)
    strbuf.str_buf compiler; // the compiler identity, empty until hash_identity computes it
}

fn free_libraries(libraries mut* libs) void {
    u64 mut i = 0;
    while (i < libs->len) {
        artifact.free(&libs->items[i]);
        i += 1;
    }
    del(libs->items);
    libs->len = 0;
    containers.str_free(&libs->files);
    containers.pool_free(&libs->pool);
    vec.int_free(&libs->order);
    strbuf.free(&libs->compiler);
}

// Reports `library '<path>' is corrupt`.
fn error_corrupt(string path) void {
    eprintln("fort: error: library '", path, "' is corrupt");
}

// Puts the compiler identity of D9.11 in `libs->compiler` when it is not there yet, so a build
// reads the compiler executable once. Returns false after the error of the compiler executable.
fn hash_identity(libraries mut* libs) bool {
    if (strbuf.view(&libs->compiler).len > 0) {
        return true;
    }
    strbuf.str_buf mut exe = strbuf.create();
    defer strbuf.free(&exe);
    if (!artifact.hash_compiler(&libs->compiler, &exe)) {
        strbuf.clear(&libs->compiler);
        if (strbuf.view(&exe).len == 0) {
            error("internal error: the system gives no path of the compiler executable");
        } else {
            error_path("cannot read", strbuf.view(&exe), str.from_cstr(libc.strerror(sys.errno())));
        }
        return false;
    }
    return true;
}

// Fills `*build` with the fields of this build that a used library must have (D9.11): the
// compiler identity, the target, the two modes and the configuration map, whose storage is
// `libs->compiler`, `keys` and `values`. Returns false after the error of the compiler
// executable.
fn build_fields(options* opts, libraries mut* libs, artifact.manifest mut* build,
                containers.str_vec mut* keys, containers.str_vec mut* values) bool {
    if (!hash_identity(libs)) {
        return false;
    }
    append_config(opts, keys, values);
    build->compiler = strbuf.view(&libs->compiler);
    build->target = opts->target;
    build->release = opts->release;
    build->no_bounds_check = opts->no_bounds_check;
    build->cfg_keys = containers.str_items(keys);
    build->cfg_values = containers.str_items(values);
    return true;
}

// Reads the artifact of --use `i` into `libs->items[i]` and holds its own rules: it is valid, it
// has the name that the --use gives, and it has the fields of `build`. Returns EXIT_OK, or
// EXIT_USAGE after the message of the first rule that fails (toolchain.md 1).
fn read_library(options* opts, artifact.manifest* build, libraries mut* libs, u64 i) i32 {
    string name = containers.str_at(&opts->use_names, i);
    string path = containers.str_at(&opts->use_paths, i);
    artifact.contents mut* c = &libs->items[i];
    i32 mut failure = 0;
    artifact.verdict found = artifact.read(path, c, &failure);
    if (found == artifact.verdict.v_unreadable) {
        error_path("cannot read library", path, str.from_cstr(libc.strerror(failure)));
        return EXIT_USAGE;
    }
    if (found == artifact.verdict.v_corrupt) {
        error_corrupt(path);
        return EXIT_USAGE;
    }
    if (c->fields.library != name) {
        eprintln("fort: error: library '", path, "' is named '", c->fields.library, "', not '",
                 name, "'");
        return EXIT_USAGE;
    }
    string field = artifact.difference(&c->fields, build);
    if (field.len > 0) {
        eprintln("fort: error: library '", name, "' was built with another ", field);
        return EXIT_USAGE;
    }
    return EXIT_OK;
}

// Reads and checks each used library (toolchain.md 2.1, step 1; D9.11). Each artifact is read
// once and checked against its own rules, in command-line order. Then each library that a
// manifest uses must be named with the interface that it records, and the uses must form no
// cycle. Returns EXIT_OK with the link order in `libs->order`, or EXIT_USAGE after the message
// of the first failure.
fn read_libraries(options* opts, libraries mut* libs) i32 {
    u64 n = opts->use_names.len;
    if (n == 0) {
        return EXIT_OK;
    }
    del(libs->items);
    libs->items = new(artifact.contents, n);
    libs->len = n;
    containers.str_vec mut keys = containers.str_create();
    defer containers.str_free(&keys);
    containers.str_vec mut values = containers.str_create();
    defer containers.str_free(&values);
    artifact.manifest mut build = artifact.manifest{};
    if (!build_fields(opts, libs, &build, &keys, &values)) {
        return EXIT_USAGE;
    }
    u64 mut i = 0;
    while (i < n) {
        i32 status = read_library(opts, &build, libs, i);
        if (status != EXIT_OK) {
            return status;
        }
        i += 1;
    }
    graph.graph mut g = graph.graph{};
    defer graph.free(&g);
    i = 0;
    while (i < n) {
        artifact.manifest* m = &libs->items[i].fields;
        graph.add(&g, containers.str_at(&opts->use_names, i), m->interface);
        u64 mut k = 0;
        while (k < m->use_names.len) {
            graph.add_use(&g, m->use_names[k], m->use_hashes[k]);
            k += 1;
        }
        i += 1;
    }
    strbuf.str_buf mut message = strbuf.create();
    defer strbuf.free(&message);
    if (!graph.check(&g, &message)) {
        error(strbuf.view(&message));
        return EXIT_USAGE;
    }
    graph.link_order(&g, &libs->order);
    i = 0;
    while (i < n) {
        // `<path>/interface.ft`, with no second separator after a path that ends with one
        string path = containers.str_at(&opts->use_paths, i);
        string mut file = join_path(&libs->pool, path, artifact.INTERFACE_FILE, "");
        if (path[path.len - 1] == '/') {
            file = join_path(&libs->pool, "", path, artifact.INTERFACE_FILE);
        }
        containers.str_push(&libs->files, file);
        i += 1;
    }
    return EXIT_OK;
}

// Adds each used library to the module set, so that a path of it resolves only in its interface
// file (module-system.md 10.2). The interface text is the one that read_libraries checked.
// Returns EXIT_OK, EXIT_COMPILE_ERROR after a lexical diagnostic in an interface file, or
// EXIT_USAGE when a text is no interface file of its library.
fn use_libraries(session.session mut* s, options* opts, libraries* libs, analysis mut* an) i32 {
    u64 mut i = 0;
    while (i < libs->len) {
        u64 before = session.error_count(s);
        string text = strbuf.view(&libs->items[i].interface);
        if (!modules.use_library(s, &an->set, containers.str_at(&opts->use_names, i),
                                 containers.str_at(&libs->files, i), text)) {
            if (session.error_count(s) > before) {
                return EXIT_COMPILE_ERROR;
            }
            error_corrupt(containers.str_at(&opts->use_paths, i));
            return EXIT_USAGE;
        }
        i += 1;
    }
    return EXIT_OK;
}

// Checks the extern declarations of each module of each used library that the closure does not
// hold, against the closure and against each other (module-system.md 10.4): the libraries in the
// reverse of the link order, the modules of each in byte order of the path. Call it after the
// closure checked with no diagnostic. Returns false after a diagnostic.
fn check_outside(session.session mut* s, options* opts, libraries* libs, analysis mut* an) bool {
    if (libs->len == 0) {
        return true;
    }
    containers.str_vec mut names = containers.str_create();
    defer containers.str_free(&names);
    u64 mut k = libs->order.len;
    while (k > 0) {
        k -= 1;
        containers.str_push(&names,
                            containers.str_at(&opts->use_names, cast(libs->order.items[k], u64)));
    }
    if (!modules.load_outside(s, &an->set, containers.str_items(&names))) {
        return false;
    }
    return check_stmt.check_outside(&an->ck, &an->set) && session.error_count(s) == 0;
}

// ---- the front end ---------------------------------

// Keeps parsed modules and checker annotations available to later passes.
struct analysis {
    modules.module_set set;
    check.checker ck;
}

// The analysis of one run: the modules it will read and the checker that will
// annotate their trees. bootstrap0/src/driver.c's driver_analysis_init does the
// same two calls. The checker takes the session here because it reports through
// it, where the C reports through a file-scope sink.
fn analysis_create(session.session mut* s) analysis {
    analysis mut an = analysis{};
    check.check_init(&an.ck, s);
    return an;
}

// Releases a live analysis. Repeated calls have no effect.
fn analysis_release(analysis mut* an, bool mut* live) void {
    if (!*live) {
        return;
    }
    *live = false;
    analysis_free(an);
}

fn analysis_free(analysis mut* an) void {
    check.check_free(&an->ck);
    modules.free(&an->set);
}

// Loads the entry file and import closure with the search roots in order.
// Returns false after diagnostics report a load failure.
fn load_closure(session.session mut* s, options* opts, string program, analysis mut* an) bool {
    u64 mut i = 0;
    while (i < opts->includes.len) {
        // the `-I` roots follow the entry file's directory
        modules.add_root(&an->set, containers.str_at(&opts->includes, i));
        i += 1;
    }
    containers.pool mut p = containers.pool_create();
    defer containers.pool_free(&p);
    // `std` is looked up in the standard library directory. A library build has none: its
    // `std` paths resolve in the interface file of the used library std (module-system.md 10.2).
    if (opts->use_names.len == 0) {
        modules.set_std_dir(&an->set, std_dir(&p, opts, program));
    }
    return modules.load(s, &an->set, opts->entry);
}

// Tests whether the entry path opens without reading it. bootstrap0/src/driver.c only opens and
// closes the entry. A directory can open, but read(2) returns EISDIR. It passes this test, then the
// loader reports a compile error instead of a usage error. Reading the file here would make stage2
// report a usage error and exit 2. Bootstrap-0 reports a located compile error and exits 1.
fn entry_opens(string path) bool {
    i32 fd = io.open_read(path);
    if (fd < 0) {
        return false;
    }
    io.close(fd);
    return true;
}

// The front end as far as this compiler goes: read the entry
// file, then parse the import closure. An entry file that
// cannot be opened is exit 2 and a compile diagnostic is exit 1. A closure that
// loaded cleanly would be the checker's and the emitter's turn, which is the
// internal error of `run` below. A build that uses the cache looks up the key of the entry unit
// after a load with no diagnostic (toolchain.md 2.1, step 3), and a hit checks nothing more:
// the build that stored the entry checked the same sources against the same interfaces.
fn front_end(session.session mut* s, options* opts, string program, libraries* libs,
             analysis mut* an, cached_unit mut* u) i32 {
    // The loader reads each file through the session.
    // This keeps a server buffer consistent across the closure.
    if (!entry_opens(opts->entry)) {
        error_path("cannot read", opts->entry, str.from_cstr(libc.strerror(sys.errno())));
        return EXIT_USAGE;
    }
    // --json writes the document and no text line
    diag.set_text(session.diags(s), !opts->json);
    session.show_sources(s);
    i32 used = use_libraries(s, opts, libs, an);
    if (used != EXIT_OK) {
        return used;
    }
    bool loaded = load_closure(s, opts, program, an);
    if (u->active && loaded && session.error_count(s) == 0) {
        fill_unit(opts, libs, u);
        u->fields.entry_unit = true;
        strbuf.append(&u->entry_path, modules.entry(&an->set)->path);
        u->fields.entry = strbuf.view(&u->entry_path);
        artifact.hash_sources(&an->set, &u->source);
        find_unit(opts, opts->entry[..last_component(opts->entry)], u);
        if (u->found == cache.outcome.o_hit) {
            return EXIT_OK;
        }
    }
    // Check each parsed module in dependency order.
    // A parse failure in one file does not hide errors in other files.
    // Keep the analysis available for the emitter and index walk. A compilation builds a
    // program, so the entry module defines main; --check inspects one module instead,
    // and the entry rule does not apply to it.
    an->ck.require_main = !opts->check;
    bool checked = check_stmt.check_program(&an->ck, &an->set);
    if (!loaded || !checked || session.error_count(s) > 0) {
        return EXIT_COMPILE_ERROR;
    }
    return EXIT_OK;
}

// Emits one module for the complete closure. An unwritable path is a toolchain error with exit 2.
// An unsupported construct is a compile error with exit 1. Neither case sends partial IR to `--cc`.
// The emitter is initialized at the address it is used at, since it stores the session it reports
// through (gen.ft).
// Each function goes through FIR (spec/fir.md 3). A function that the lowering does not support
// is a compile error (spec/fir.md 9.8). With --fir-stats, a module that was written adds the line
// `lowered N of M` to stdout: N functions that the translator wrote, of M definitions of fort
// functions, the C `main` excluded.
fn emit_module(session.session mut* s, options* opts, analysis mut* an, string ir_path) i32 {
    gen.gen_options mut gopts = gen.gen_options{};
    gopts.release = opts->release;
    gopts.no_bounds_check = opts->no_bounds_check;
    gopts.target = opts->target;
    gen.emitter mut g = gen.emitter{};
    gen.gen_init(&g, s, gopts);
    defer gen.gen_free(&g);
    if (!gen_fir.gen_program(&g, &an->ck, &an->set)) {
        return EXIT_COMPILE_ERROR;
    }
    bool mut written = false;
    if (ir_path == STDOUT_OUTPUT) {
        written = write_stdout(strbuf.bytes(&g.out));
    } else {
        written = io.write_file(ir_path, strbuf.bytes(&g.out));
    }
    if (!written) {
        error_path("cannot write", ir_path, str.from_cstr(libc.strerror(sys.errno())));
        return EXIT_USAGE;
    }
    if (opts->fir_stats) {
        println("lowered ", g.lowered, " of ", g.functions);
    }
    return EXIT_OK;
}

// ---- the document of the check mode -----------------------------

// "version" is 1 for this form of the document.
u64 JSON_VERSION = 1;

// Copies the names of the files that the run read, in that order and each once (D20.2): the
// interface file of each used library, which step 1 of toolchain.md 2.1 reads, and then the file
// of each module in load order. A section of an interface file names that file.
fn collect_files(containers.pool mut* p, libraries* libs, modules.module_set* set,
                      containers.str_vec mut* files) void {
    u64 mut i = 0;
    while (i < libs->files.len) {
        containers.str_push(files, containers.pool_intern(p, containers.str_at(&libs->files, i)));
        i += 1;
    }
    i = 0;
    while (i < modules.file_count(set)) {
        string file = modules.file_at(set, i);
        if (!has_string(files, file)) {
            containers.str_push(files, containers.pool_intern(p, file));
        }
        i += 1;
    }
}

// Builds the whole document into `out`: the version, the files of the closure,
// the diagnostics of the run and the identifier index.
fn build_document(strbuf.str_buf mut* out, session.session mut* s,
                       containers.str_vec* files, index.index* ix) void {
    json.writer mut j = json.writer{};
    json.json_init(&j, out);
    json.json_object_begin(&j);
    json.json_key(&j, "version");
    json.json_uint(&j, JSON_VERSION);
    // a client clears the stale diagnostics of a file
    json.json_key(&j, "files");
    json.json_array_begin(&j);
    u64 mut i = 0;
    while (i < files->len) {
        json.json_str(&j, containers.str_at(files, i));
        i += 1;
    }
    json.json_array_end(&j);
    json.json_key(&j, "diagnostics");
    diag.write_json(session.diags(s), &j);
    // the empty array without --index, always a member
    json.json_key(&j, "symbols");
    index.write_json(ix, &j);
    json.json_object_end(&j);
}

// Writes the document with one print, so stdout holds a complete document or
// nothing and a client tells a crash from a verdict. The document is one line
// ended by a newline.
fn write_document(session.session mut* s, containers.str_vec* files, index.index* ix) void {
    strbuf.str_buf mut doc = strbuf.create();
    defer strbuf.free(&doc);
    build_document(&doc, s, files, ix);
    strbuf.push(&doc, '\n');
    print(strbuf.view(&doc));
}

// --check --json writes the front-end document to stdout.
// --index adds identifier records from checker annotations.
// A usage, toolchain, or internal error causes exit 2 with empty stdout.
fn check_document(session.session mut* s, options* opts, libraries* libs, analysis mut* an,
                       containers.pool mut* p) void {
    containers.str_vec mut files = containers.str_create();
    defer containers.str_free(&files);
    collect_files(p, libs, &an->set, &files);
    index.index mut ix = index.create();
    defer index.free(&ix);
    if (opts->index) {
        index.build(&ix, &an->set);
    }
    write_document(s, &files, &ix);
}

// --fir lowers each function of a checked program into a FIR module and writes the module to
// stdout, with one print: the modules in dependency order and the functions of each in source
// order, with a blank line between two functions. The verifier tests each function after the
// lowering, and a violation ends the compiler with a panic that names the rule. The emptiness
// pass then runs on it, as in step 3 of toolchain.md 2. An overwrite check that the pass does not
// prove is the error of D17.11. After such an error the run writes no FIR and returns
// EXIT_COMPILE_ERROR. With `--fir-after=build-mode`, the build-mode pass then rewrites each
// function for the mode that --release and --no-bounds-check select, and the verifier tests it
// again (spec/fir.md 11). A function that the lowering does not lower writes the line of
// fir_lower.write_report in its place.
fn fir_entry(session.session mut* s, analysis mut* an, options* opts) i32 {
    fir_verify.runtime rt = fir_verify.runtime_of(&an->ck);
    bool build = opts->fir_after == FIR_BUILD_MODE;
    gen.node_ref_vec mut decls = gen.node_ref_vec{};
    defer gen.refs_free(&decls);
    fir_lower.program_functions(&an->set, &decls);
    // The module keeps each function for the passes after the build-mode pass. The text is
    // written from each function before it moves into the module.
    fir.module mut m = fir.module_new();
    defer fir.module_free(&m);
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    bool mut proved = true;
    u64 mut i = 0;
    while (i < decls.len) {
        if (i > 0) {
            strbuf.push(&text, '\n');
        }
        fir.func mut f = fir.func{};
        fir_lower.report mut why = fir_lower.report{};
        if (fir_lower.lower_function(&an->ck, gen.refs_at(&decls, i), &f, &why)) {
            fir_verify.verify(&f, &rt);
            prover.proof mut verdicts = run_emptiness(s, &f);
            if (prover.has_error(&verdicts)) {
                proved = false;
            }
            if (build) {
                fir_passes.build_mode(&f, opts->release, opts->no_bounds_check, &verdicts);
                fir_verify.verify(&f, &rt);
            }
            prover.free(&verdicts);
            fir_print.print_function(&f, &text);
            fir.module_add_function(&m, move(f));
        } else {
            fir_lower.write_report(&why, &text);
        }
        i += 1;
    }
    if (!proved) {
        return EXIT_COMPILE_ERROR;
    }
    print(strbuf.view(&text));
    return EXIT_OK;
}

// Appends the line of the first violation of a rule of spec/fir.md 10 in `f` to `out`, when `f`
// has one, and returns false: the location `at`, then the text of fir_verify.verify_report.
// Returns true when `f` keeps every rule.
fn report_violation(fir.func* f, fir_verify.runtime* rt, diag.loc at,
                    strbuf.str_buf mut* out) bool {
    strbuf.str_buf mut line = strbuf.create();
    defer strbuf.free(&line);
    if (fir_verify.verify_report(f, rt, &line)) {
        return true;
    }
    strbuf.append(out, at.file);
    strbuf.push(out, ':');
    strbuf.append_u64(out, cast(at.line, u64));
    strbuf.push(out, ':');
    strbuf.append_u64(out, cast(at.col, u64));
    strbuf.append(out, ": ");
    strbuf.append(out, strbuf.view(&line));
    strbuf.push(out, '\n');
    return false;
}

/// Runs the verifier in report mode on `f` (spec/fir.md 16.5): on `f` as it is, and then, when `f`
/// keeps every rule, on the output of the build-mode pass for `release` and `no_bounds`. Appends
/// the line of the first violation, at `at`, to `out`. So a function adds one line at most.
fn report_function(fir.func mut* f, fir_verify.runtime* rt, diag.loc at, bool release,
                   bool no_bounds, strbuf.str_buf mut* out) void {
    if (report_violation(f, rt, at, out)) {
        // the proof decides which overwrite checks the pass removes, and reports nothing here
        prover.proof mut verdicts = prover.prove(f);
        defer prover.free(&verdicts);
        fir_passes.build_mode(f, release, no_bounds, &verdicts);
        report_violation(f, rt, at, out);
    }
}

// --fir-verify-report lowers each function of a checked program, as --fir does, and runs
// report_function on it at the name of the function. The run writes one line to stdout for each
// function that breaks a rule, its first violation, with one print, and exits 0. A function that
// the lowering does not support writes nothing. --fir-after does not change the report.
fn fir_report_entry(analysis mut* an, options* opts) i32 {
    fir_verify.runtime rt = fir_verify.runtime_of(&an->ck);
    gen.node_ref_vec mut decls = gen.node_ref_vec{};
    defer gen.refs_free(&decls);
    fir_lower.program_functions(&an->set, &decls);
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    u64 mut i = 0;
    while (i < decls.len) {
        ast.node* decl = gen.refs_at(&decls, i);
        fir.func mut f = fir.func{};
        fir_lower.report mut why = fir_lower.report{};
        if (fir_lower.lower_function(&an->ck, decl, &f, &why)) {
            report_function(&f, &rt, decl->name_loc, opts->release, opts->no_bounds_check, &text);
            fir.func_free(&f);
        }
        i += 1;
    }
    print(strbuf.view(&text));
    return EXIT_OK;
}

// Runs the emptiness pass on the verified function `f`. It reports the error of D17.11 and its
// notes at each overwrite check and each store that the pass does not prove, and then the error
// of the leak rule and its notes at each exit that the pass does not prove (D17.20, spec/fir.md
// 11). Returns the proof, which the caller frees.
fn run_emptiness(session.session mut* s, fir.func* f) prover.proof {
    prover.proof verdicts = prover.prove(f);
    report.write(f, &verdicts, s);
    report.write_leaks(f, &verdicts, s);
    return verdicts;
}

// --check lowers each function of a checked program, runs the verifier on it and then the
// emptiness pass, before the build-mode pass, as a build does (spec/fir.md 11). It reports each
// overwrite check, each store and each exit that the pass does not prove, as a build does, and
// returns EXIT_COMPILE_ERROR after an error and EXIT_OK otherwise. A function that the lowering
// does not lower, or whose checks name a runtime entry that `std.rt` lacks, does not take part,
// because a build reports it. --leak-report lists the leak sites that are no error yet. Part 1 of
// the leak rule is an error, so the report lists none until part 2 reports its sites (D17.20).
fn overwrite_entry(session.session mut* s, analysis mut* an, options* opts) i32 {
    fir_verify.runtime mut rt = fir_verify.runtime_of(&an->ck);
    fir_verify.excuse_mode(&rt, opts->release, opts->no_bounds_check);
    gen.node_ref_vec mut decls = gen.node_ref_vec{};
    defer gen.refs_free(&decls);
    fir_lower.program_functions(&an->set, &decls);
    bool mut proved = true;
    u64 mut i = 0;
    while (i < decls.len) {
        fir.func mut f = fir.func{};
        fir_lower.report mut why = fir_lower.report{};
        if (fir_lower.lower_function(&an->ck, gen.refs_at(&decls, i), &f, &why)) {
            fir.check_kind mut missing = fir.check_kind.chk_overflow;
            if (fir_verify.runtime_holds(&f, &rt, &missing)) {
                fir_verify.verify(&f, &rt);
                prover.proof mut verdicts = run_emptiness(s, &f);
                if (prover.has_error(&verdicts)) {
                    proved = false;
                }
                prover.free(&verdicts);
            }
            fir.func_free(&f);
        }
        i += 1;
    }
    if (!proved) {
        return EXIT_COMPILE_ERROR;
    }
    return EXIT_OK;
}

// ---- the FIR tests -----------------------------------------------------------------------

// What the compiler reads of a `.fir` test: the text of each `//! pass:` directive, in order, and
// its prelude as fort source. The prelude keeps the lines and the columns of the file: a line of
// the `//! prelude:` block keeps its text with spaces for its `//|`, and every other line is
// empty.
struct fir_test {
    containers.str_vec passes;
    strbuf.str_buf prelude;
}

// The kinds of a pass of a `.fir` test.
enum test_pass_kind {
    tp_none,
    tp_verify,
    tp_build,
    tp_run,
}

// One pass of a `.fir` test. `release` and `no_bounds` select the mode of the build-mode pass.
// `text` holds the arguments of the pass `run`: the function, then the value of each parameter.
// `function` and `values[..count]` hold them after resolve_run read them.
struct test_pass {
    test_pass_kind kind;
    bool release;
    bool no_bounds;
    string text;
    ast.sym* function;
    u64[RUN_ARG_MAX] values;
    u64 count;
}

// Whether `c` is a space or the carriage return of a CRLF line end.
fn is_blank(char c) bool {
    return c == ' ' || c == '\r';
}

// The text without the spaces and carriage returns at its ends.
fn trimmed(string text) string {
    u64 mut lo = 0;
    u64 mut hi = text.len;
    while (lo < hi && is_blank(text[lo])) {
        lo += 1;
    }
    while (hi > lo && is_blank(text[hi - 1])) {
        hi -= 1;
    }
    return text[lo..hi];
}

// Reads the header of the `.fir` test `text`: the leading run of `//!` and `//|` lines.
fn read_fir_test(string text, fir_test mut* t) void {
    bool mut header = true;
    bool mut in_prelude = false;
    u64 mut start = 0;
    while (start < text.len) {
        u64 mut end = start;
        while (end < text.len && text[end] != '\n') {
            end += 1;
        }
        string line = text[start..end];
        if (header && str.starts_with(line, BLOCK_MARK)) {
            if (in_prelude) {
                strbuf.append(&t->prelude, "   ");
                strbuf.append(&t->prelude, line[BLOCK_MARK.len..line.len]);
            }
        } else if (header && str.starts_with(line, DIRECTIVE_MARK)) {
            string directive = trimmed(line[DIRECTIVE_MARK.len..line.len]);
            in_prelude = directive == "prelude:";
            if (str.starts_with(directive, "pass:")) {
                containers.str_push(&t->passes, trimmed(directive["pass:".len..directive.len]));
            }
        } else {
            header = false;
        }
        strbuf.push(&t->prelude, '\n');
        start = end + 1;
    }
}

// Reads the text of one `//! pass:` directive into *out. EXIT_OK when the pass runs, else
// EXIT_USAGE after an error: an unknown pass, `none` or `verify` with an argument, or an argument
// of `build-mode` that is not --release or --no-bounds-check. Spaces separate the arguments.
fn fir_test_pass(string text, test_pass mut* out) i32 {
    *out = test_pass{};
    i64 space = str.index_of(text, ' ');
    string mut name = text;
    string mut rest = "";
    if (space >= 0) {
        name = text[0..cast(space, u64)];
        rest = text[cast(space, u64) + 1..text.len];
    }
    if (name == FIR_TEST_NONE || name == FIR_TEST_VERIFY) {
        if (space >= 0) {
            eprintln("fort: error: the pass '", name, "' takes no argument");
            return EXIT_USAGE;
        }
        if (name == FIR_TEST_VERIFY) {
            out->kind = test_pass_kind.tp_verify;
        }
        return EXIT_OK;
    }
    if (name == FIR_TEST_RUN) {
        out->kind = test_pass_kind.tp_run;
        out->text = trimmed(rest);
        return EXIT_OK;
    }
    if (name != FIR_BUILD_MODE) {
        eprintln("fort: error: unknown pass '", name, "'");
        return EXIT_USAGE;
    }
    out->kind = test_pass_kind.tp_build;
    while (rest.len > 0) {
        i64 gap = str.index_of(rest, ' ');
        string mut word = rest;
        string mut after = "";
        if (gap >= 0) {
            word = rest[0..cast(gap, u64)];
            after = rest[cast(gap, u64) + 1..rest.len];
        }
        rest = after;
        if (word == FIR_TEST_RELEASE) {
            out->release = true;
        } else if (word == FIR_TEST_NO_BOUNDS) {
            out->no_bounds = true;
        } else if (word.len > 0) {
            eprintln("fort: error: unknown build mode '", word, "'");
            return EXIT_USAGE;
        }
    }
    return EXIT_OK;
}

// The function of `m` or of the closure of `ck` whose dotted name is `name` (D9.7), or null.
fn find_function(fir.module* m, check.checker* ck, string name) ast.sym* {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    for (u64 mut i = 0; i < m->funcs.len; i++) {
        strbuf.clear(&b);
        fir_print.print_symbol(m->funcs.items[i].sym, &b);
        if (strbuf.view(&b) == name) {
            return m->funcs.items[i].sym;
        }
    }
    for (u64 mut i = 0; i < check.check_sym_count(ck); i++) {
        ast.sym* s = check.check_sym_at(ck, i);
        if (s->kind == ast.sym_kind.s_fn) {
            strbuf.clear(&b);
            fir_print.print_symbol(s, &b);
            if (strbuf.view(&b) == name) {
                return s;
            }
        }
    }
    return null;
}

// The bits of `word` as a value of the parameter type `t` in *out: `true` or `false` for a
// `bool`, and a decimal integer that fits an integer type. False for any other word or type.
fn run_value(string word, types.node* t, u64 mut* out) bool {
    if (t->kind != types.type_kind.k_prim) {
        return false;
    }
    if (t->prim == prim.prim_kind.prim_bool) {
        *out = 0;
        if (word == "true") {
            *out = 1;
        }
        return word == "true" || word == "false";
    }
    if (!prim.prim_is_integer(t->prim)) {
        return false;
    }
    u32 w = gen.gen_int_bits(t);
    u64 high = interpreter.wrap(interpreter.ALL_BITS, w);
    if (!prim.prim_is_signed(t->prim)) {
        return str.parse_u64(word, 10, out) && *out <= high;
    }
    i64 mut v = 0;
    i64 top = cast(high >> 1, i64);
    if (!str.parse_i64(word, &v) || v > top || v < -top - 1) {
        return false;
    }
    *out = interpreter.wrap(cast(v, u64), w);
    return true;
}

// Reads the arguments of the pass `run` into *p: the dotted name of a function, then the value
// of each of its parameters. With no argument, the pass runs the program `main.main`.
// EXIT_USAGE after an error: no such function, or a value that does not fit its parameter.
fn resolve_run(fir.module* m, check.checker* ck, test_pass mut* p) i32 {
    string mut rest = p->text;
    string mut name = "main.main";
    i64 space = str.index_of(rest, ' ');
    if (rest.len > 0) {
        name = rest;
        rest = "";
        if (space >= 0) {
            name = p->text[0..cast(space, u64)];
            rest = trimmed(p->text[cast(space, u64) + 1..]);
        }
    }
    p->function = find_function(m, ck, name);
    if (p->function == null || p->function->ty == null) {
        eprintln("fort: error: the pass 'run' names no function '", name, "'");
        return EXIT_USAGE;
    }
    if (p->text.len == 0) {
        return EXIT_OK;
    }
    types.node*@ params = p->function->ty->params;
    p->count = 0;
    while (rest.len > 0 || p->count < params.len) {
        i64 gap = str.index_of(rest, ' ');
        string mut word = rest;
        string mut after = "";
        if (gap >= 0) {
            word = rest[0..cast(gap, u64)];
            after = trimmed(rest[cast(gap, u64) + 1..]);
        }
        if (p->count >= params.len || p->count >= RUN_ARG_MAX
            || !run_value(word, params[p->count], &p->values[p->count])) {
            eprintln("fort: error: invalid argument '", word, "' of the pass 'run'");
            return EXIT_USAGE;
        }
        p->count += 1;
        rest = after;
    }
    return EXIT_OK;
}

// The pass `run` of a `.fir` test: fir.interpreter runs the function of `p` with its values, or
// the program `main.main` with the path of the test as its one argument, and captures what it
// writes. The report of fir.interpreter.write_report, with the events of the run, goes to `out`.
fn run_test(check.checker mut* ck, fir.module* m, test_pass* p, string entry,
            strbuf.str_buf mut* out) void {
    interpreter.machine mut it = interpreter.machine{};
    interpreter.init(&it, ck, m, true);
    defer interpreter.free(&it);
    it.sh.reporting = true;
    if (p->text.len == 0) {
        string[1] argv = {entry};
        interpreter.run_program(&it, p->function, argv[..]);
    } else {
        interpreter.run_function(&it, p->function, p->values[..p->count]);
    }
    interpreter.write_report(&it, out);
}

// Runs the passes of a `.fir` test in order, each over every function of `m` in text order. The
// pass `verify` ends the compiler with a panic at the first violation of a rule. The pass
// `build-mode` runs the emptiness pass first, which reports nothing here, and removes the
// overwrite checks that it proves. The pass `run` runs the module once and writes its report to
// `reports`.
fn run_test_passes(fir.module mut* m, test_pass@ passes, fir_verify.runtime* rt,
                   check.checker mut* ck, string entry, strbuf.str_buf mut* reports) void {
    u64 mut pass_index = 0;
    while (pass_index < passes.len) {
        test_pass p = passes[pass_index];
        if (p.kind == test_pass_kind.tp_run) {
            run_test(ck, m, &passes[pass_index], entry, reports);
        }
        u64 mut k = 0;
        while (k < m->funcs.len) {
            fir.func mut* f = &m->funcs.items[k];
            if (p.kind == test_pass_kind.tp_verify) {
                fir_verify.verify(f, rt);
            } else if (p.kind == test_pass_kind.tp_build) {
                // the pass removes the overwrite checks that the emptiness pass proves
                prover.proof mut verdicts = prover.prove(f);
                fir_passes.build_mode(f, p.release, p.no_bounds, &verdicts);
                prover.free(&verdicts);
            }
            k += 1;
        }
        pass_index += 1;
    }
}

// --fir-test reads a `.fir` test (spec/fir.md 16.3): it checks the prelude of the test as the
// module `main` through the front end, parses the FIR text against it, runs the passes that the
// test names, in order, and writes the module to stdout in one print, or the reports of its runs
// when it names the pass `run`. The harness compares the text. A diagnostic of the prelude or of
// the FIR text is exit 1 with no text; an unreadable file and a pass that does not run are exit
// 2. The pass `verify` ends the compiler with a panic at the first violation of a rule, and
// writes no text then.
fn fir_test_entry(options* opts, string program) i32 {
    if (!target_form(opts->target)) {
        usage_error_arg("unsupported target", opts->target);
        return EXIT_USAGE;
    }
    session.session mut s = session.create();
    defer session.free(&s);
    configure(&s, opts);
    string mut text = "";
    if (!session.read_source(&s, opts->entry, &text)) {
        error_path("cannot read", opts->entry, str.from_cstr(libc.strerror(sys.errno())));
        return EXIT_USAGE;
    }
    fir_test mut t = fir_test{};
    defer strbuf.free(&t.prelude);
    defer containers.str_free(&t.passes);
    read_fir_test(text, &t);
    if (t.passes.len == 0) {
        error("the .fir test has no '//! pass:' directive");
        return EXIT_USAGE;
    }
    test_pass mut@ own passes = new(test_pass, t.passes.len);
    defer del(passes);
    u64 mut k = 0;
    while (k < t.passes.len) {
        i32 pass = fir_test_pass(containers.str_at(&t.passes, k), &passes[k]);
        if (pass != EXIT_OK) {
            return pass;
        }
        k += 1;
    }
    libraries mut libs = libraries{};
    defer free_libraries(&libs);
    i32 read = read_libraries(opts, &libs);
    if (read != EXIT_OK) {
        return read;
    }
    // The loader reads the prelude in place of the file, so a diagnostic of the prelude names
    // the line and the column of the file. No source line is shown under it.
    session.set_source(&s, opts->entry, strbuf.view(&t.prelude));
    diag.set_text(session.diags(&s), true);
    analysis mut an = analysis_create(&s);
    defer analysis_free(&an);
    i32 used = use_libraries(&s, opts, &libs, &an);
    if (used != EXIT_OK) {
        return used;
    }
    u64 mut i = 0;
    while (i < opts->includes.len) {
        modules.add_root(&an.set, containers.str_at(&opts->includes, i));
        i += 1;
    }
    containers.pool mut p = containers.pool_create();
    defer containers.pool_free(&p);
    if (libs.len == 0) {
        modules.set_std_dir(&an.set, std_dir(&p, opts, program));
    }
    bool loaded = modules.load_named(&s, &an.set, FIR_TEST_MODULE, opts->entry);
    // the prelude is no program, so it need not define main
    an.ck.require_main = false;
    bool checked = check_stmt.check_program(&an.ck, &an.set);
    if (!loaded || !checked || session.error_count(&s) > 0) {
        return EXIT_COMPILE_ERROR;
    }
    if (!check_outside(&s, opts, &libs, &an)) {
        return EXIT_COMPILE_ERROR;
    }
    fir_parse.prelude pre = fir_parse.prelude{modules.entry(&an.set), &an.ck};
    fir.module mut m = fir_parse.parse_module(&s, opts->entry, text, pre);
    defer fir.module_free(&m);
    if (session.error_count(&s) > 0) {
        return EXIT_COMPILE_ERROR;
    }
    bool mut runs = false;
    k = 0;
    while (k < t.passes.len) {
        if (passes[k].kind == test_pass_kind.tp_run) {
            runs = true;
            i32 resolved = resolve_run(&m, &an.ck, &passes[k]);
            if (resolved != EXIT_OK) {
                return resolved;
            }
        }
        k += 1;
    }
    fir_verify.runtime rt = fir_verify.runtime_of(&an.ck);
    strbuf.str_buf mut out = strbuf.create();
    defer strbuf.free(&out);
    run_test_passes(&m, passes, &rt, &an.ck, opts->entry, &out);
    if (!runs) {
        fir_print.print_module(&m, &out);
    }
    print(strbuf.view(&out));
    return EXIT_OK;
}

// --fir-run runs the FIR of the checked program with fir.interpreter, as the `main` that a build
// emits starts it (toolchain.md 6 item 22), with the entry file and the arguments after `--` as
// its arguments. The program writes to the descriptors of the compiler, and run_status gives
// the status of its end. With --fir-events the events go to stderr, each as `fort: event ...`.
fn run_entry(analysis mut* an, options* opts) i32 {
    ast.node* decl = gen_fir.find_main(modules.entry(&an->set)->ast);
    fir.module mut none = fir.module_new();
    defer fir.module_free(&none);
    interpreter.machine mut it = interpreter.machine{};
    interpreter.init(&it, &an->ck, &none, false);
    defer interpreter.free(&it);
    containers.str_vec mut argv = containers.str_create();
    defer containers.str_free(&argv);
    containers.str_push(&argv, opts->entry);
    for (u64 mut i = 0; i < opts->run_args.len; i++) {
        containers.str_push(&argv, containers.str_at(&opts->run_args, i));
    }
    it.sh.reporting = opts->fir_events;
    interpreter.outcome o = interpreter.run_program(&it, decl->sym, containers.str_items(&argv));
    strbuf.str_buf mut events = strbuf.create();
    defer strbuf.free(&events);
    shadow.write_events(&it.sh, "fort: ", &events);
    eprint(strbuf.view(&events));
    return run_status(&o, opts->target);
}

// The status of --fir-run for the outcome `o` of a run for `target`: the exit status of the
// program, or a status below zero for the signal that ends it (process_status): SIGABRT after an
// abort, and the trap signal of the target after a trap. A call that the interpreter does not
// run, and an operation with no defined result, are errors of the compiler with exit 2.
fn run_status(interpreter.outcome* o, string target) i32 {
    switch (o->kind) {
    case interpreter.outcome_kind.oc_exit:
        return o->status & interpreter.STATUS_MASK;
    case interpreter.outcome_kind.oc_abort:
        return -SIGNAL_ABRT;
    case interpreter.outcome_kind.oc_trap:
        if (str.starts_with(target, "x86_64")) {
            return -SIGNAL_ILL;
        }
        return -SIGNAL_TRAP;
    case interpreter.outcome_kind.oc_outside:
        eprint("fort: error: the run calls '", o->what, "', ");
        eprintln("which the interpreter does not run");
        return EXIT_USAGE;
    case interpreter.outcome_kind.oc_fault:
        eprint("fort: error: the run stops at ", o->at.file, ":");
        eprintln(o->at.line, ":", o->at.col, ": ", o->what);
        return EXIT_USAGE;
    case interpreter.outcome_kind.oc_none, interpreter.outcome_kind.oc_return:
        panic("driver.run_status: a program run that did not end");
    }
}

// Ends the process for --fir-run (D11.4).
extern fn raise(i32 sig) i32;

/// The exit status of the process for the result `status` of run. A result below zero ends the
/// process by the signal `-status`, as the program of --fir-run ends.
fn process_status(i32 status) i32 {
    if (status >= 0) {
        return status;
    }
    rt.flush_all();
    if (status != -SIGNAL_ABRT) {
        raise(-status);
    }
    libc.abort();
}

// Runs the front end, then the available build or check passes. --check, --fir and --fir-run
// write no file, so they take any target form that the compiler accepts, as a check does.
fn compile_entry(options* opts, string program) i32 {
    bool front_only = opts->check || opts->fir || opts->fir_run;
    if (front_only && !target_form(opts->target)) {
        usage_error_arg("unsupported target", opts->target);
        return EXIT_USAGE;
    }
    if (!front_only && !target_allowed(opts)) {
        return EXIT_USAGE;
    }
    libraries mut libs = libraries{};
    defer free_libraries(&libs);
    i32 read = read_libraries(opts, &libs);
    if (read != EXIT_OK) {
        return read;
    }
    containers.pool mut p = containers.pool_create();
    defer containers.pool_free(&p);
    session.session mut s = session.create();
    defer session.free(&s);
    configure(&s, opts);
    // A build reads no tree after the emitter has run, so its analysis is
    // released on every path out of this function (ast.sym). The build path
    // below releases it as soon as the emitter returns and before --cc is
    // spawned. This `defer` answers for the paths that return earlier, and the
    // flag makes exactly one of the two calls do the work.
    analysis mut an = analysis_create(&s);
    bool mut analysis_live = true;
    defer analysis_release(&an, &analysis_live);
    // Only a build with --use that writes an object or an executable uses the cache (toolchain.md
    // 2.3). --fir-stats counts what the emitter writes, which a hit does not run.
    cached_unit mut u = cached_unit{};
    defer free_unit(&u);
    u.active = libs.len > 0 && !opts->check && !opts->fir && !opts->emit_ir && !opts->fir_stats;
    i32 mut status = front_end(&s, opts, program, &libs, &an, &u);
    bool hit = status == EXIT_OK && u.active && u.found == cache.outcome.o_hit;
    // A build with --use runs the emptiness pass as --check does, and then the extern check of
    // the used libraries (toolchain.md 2.1, step 4). A whole program runs the pass in the emitter
    // or in --fir, and --fir-verify-report reports no error of the pass in either mode.
    if (!hit && status == EXIT_OK && (opts->check || (libs.len > 0 && !opts->fir_report))) {
        status = overwrite_entry(&s, &an, opts);
    }
    if (!hit && status == EXIT_OK && !check_outside(&s, opts, &libs, &an)) {
        status = EXIT_COMPILE_ERROR;
    }
    if (opts->check && opts->json && (status == EXIT_OK || status == EXIT_COMPILE_ERROR)) {
        // the document answers for both verdicts, so it goes first
        check_document(&s, opts, &libs, &an, &p);
        return status;
    }
    if (status != EXIT_OK) {
        return status;
    }
    if (opts->check) {
        // --check stops after the front end, no module emitted
        return EXIT_OK;
    }
    if (opts->fir_report) {
        // --fir-verify-report stops before the emitter, as --fir does
        return fir_report_entry(&an, opts);
    }
    if (opts->fir_run) {
        // --fir-run runs the FIR of the program in place of a build
        return run_entry(&an, opts);
    }
    if (opts->fir) {
        // --fir stops before the emitter
        return fir_entry(&s, &an, opts);
    }
    string mut out_path = opts->output;
    if (!opts->have_output) {
        out_path = default_output(&p, opts);
    }
    if (opts->emit_ir) {
        // -S writes the module to the output and stops, so it needs no
        // temporary.
        return emit_module(&s, opts, &an, out_path);
    }
    string mut parent = TMP_DIR_DEFAULT;
    i32 mut failure = 0;
    string dir = make_temp_dir(&p, &parent, &failure);
    if (dir.len == 0) {
        error_path("cannot create a temporary directory in", parent,
                   str.from_cstr(libc.strerror(failure)));
        return EXIT_USAGE;
    }
    string mut ir_path = join_path(&p, dir, entry_base(opts->entry), IR_SUFFIX);
    i32 mut built = EXIT_OK;
    if (hit) {
        // the object of the entry replaces steps 4 to 6 (toolchain.md 2.1)
        ir_path = "";
    } else {
        built = emit_module(&s, opts, &an, ir_path);
    }
    // Release analysis storage before fork duplicates the process page tables.
    analysis_release(&an, &analysis_live);
    if (libs.len > 0) {
        built = build_entry_unit(opts, &libs, &u, built, dir, ir_path, out_path);
        if (built == EXIT_OK) {
            write_stats(opts, &u);
        }
        return built;
    }
    if (built == EXIT_OK) {
        built = run_cc(opts, ir_path, out_path);
    }
    remove_temp_dir(dir, ir_path);
    return built;
}

// The suffix of the copy of a `lib.a` in the temporary directory, `<name>.a`.
string ARCHIVE_SUFFIX = ".a";

// Writes the checked bytes of the `lib.a` of each used library to `<dir>/<name>.a` and pushes
// each path to `paths` in the link order (toolchain.md 2.2, Reading). Returns false after the
// error of the first file that cannot be written; the paths that it wrote are in `paths`.
fn copy_archives(options* opts, libraries* libs, containers.pool mut* p, string dir,
                 containers.str_vec mut* paths) bool {
    u64 mut k = 0;
    while (k < libs->order.len) {
        u64 i = cast(libs->order.items[k], u64);
        string path = join_path(p, dir, containers.str_at(&opts->use_names, i), ARCHIVE_SUFFIX);
        if (!io.write_file(path, strbuf.bytes(&libs->items[i].archive))) {
            i32 failure = sys.errno();
            // a part of the file can stand, so the caller removes it
            containers.str_push(paths, path);
            error_path("cannot write", path, str.from_cstr(libc.strerror(failure)));
            return false;
        }
        containers.str_push(paths, path);
        k += 1;
    }
    return true;
}

// Runs the link line of toolchain.md 2.1, step 7: `<cc> --target=<triple> -o <out> <object>
// <archives> <-l options> <-Xcc args>`, the archives in the link order.
fn link_entry(options* opts, string object_path, containers.str_vec* archives, string out_path)
    i32 {
    containers.pool mut p = containers.pool_create();
    defer containers.pool_free(&p);
    containers.str_vec mut argv = containers.str_create();
    defer containers.str_free(&argv);
    containers.str_push(&argv, opts->cc);
    containers.str_push(&argv, join_path(&p, "", "--target=", opts->target));
    containers.str_push(&argv, "-o");
    containers.str_push(&argv, out_path);
    containers.str_push(&argv, object_path);
    u64 mut i = 0;
    while (i < archives->len) {
        containers.str_push(&argv, containers.str_at(archives, i));
        i += 1;
    }
    i = 0;
    while (i < opts->libs.len) {
        containers.str_push(&argv, containers.str_at(&opts->libs, i));
        i += 1;
    }
    i = 0;
    while (i < opts->cc_args.len) {
        containers.str_push(&argv, containers.str_at(&opts->cc_args, i));
        i += 1;
    }
    return run_tool("cc", &argv);
}

// Writes `object`, the object of the entry unit, and its manifest to the cache entry of the key
// (toolchain.md 2.1, step 6). A cache entry that cannot be written is no error (toolchain.md
// 2.3).
fn store_entry(u8@ object, cached_unit mut* u) void {
    strbuf.str_buf mut object_hash = strbuf.create();
    defer strbuf.free(&object_hash);
    artifact.append_hash(&object_hash, object);
    u->fields.object = strbuf.view(&object_hash);
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    artifact.write_manifest(&u->fields, &text);
    // the field points into a buffer of this call, so it goes before the buffer does
    u->fields.object = "";
    cache.store_object(strbuf.view(&u->dir), strbuf.view(&u->key), object, strbuf.view(&text));
}

// The object of the entry unit in `*object`: the checked `object.o` of a hit, or else the object
// that the compile line writes to `object_path` in the temporary directory, read once and stored
// in the cache when the build uses it. A link reads the object at `object_path`, so a hit writes
// it there too. Returns EXIT_OK, or EXIT_USAGE after the report of a tool or a file.
fn make_object(options* opts, cached_unit mut* u, string ir_path, string object_path,
               strbuf.str_buf mut* object) i32 {
    if (u->active && u->found == cache.outcome.o_hit) {
        strbuf.append_bytes(object, strbuf.bytes(&u->entry.object));
        if (!opts->compile_only && !io.write_file(object_path, strbuf.bytes(object))) {
            error_path("cannot write", object_path, str.from_cstr(libc.strerror(sys.errno())));
            return EXIT_USAGE;
        }
        return EXIT_OK;
    }
    i32 status = compile_library(opts, ir_path, object_path);
    if (status != EXIT_OK) {
        return status;
    }
    if (!io.read_file(object_path, object)) {
        error_path("cannot read", object_path, str.from_cstr(libc.strerror(sys.errno())));
        return EXIT_USAGE;
    }
    if (u->active) {
        store_entry(strbuf.bytes(object), u);
    }
    return EXIT_OK;
}

// Steps 6 and 7 of a build with --use (toolchain.md 2.1), after the emitter wrote the module of
// the entry unit to `ir_path` with the status `built`: the compile line of a --lib build to
// `<dir>/<entry>.o` and the cache entry of the object, or the object of a hit, with `ir_path`
// empty. Under -c the build writes those bytes to the -c output, so a hit and a miss write one
// file the same way; else it runs the link line over the object and the copy of each `lib.a`.
// Removes each file that it wrote in `dir`, and then `dir`.
fn build_entry_unit(options* opts, libraries* libs, cached_unit mut* u, i32 built, string dir,
                    string ir_path, string out_path) i32 {
    containers.pool mut p = containers.pool_create();
    defer containers.pool_free(&p);
    containers.str_vec mut written = containers.str_create();
    defer containers.str_free(&written);
    containers.str_push(&written, ir_path);
    string object_path = join_path(&p, dir, entry_base(opts->entry), OBJECT_SUFFIX);
    containers.str_push(&written, object_path);
    strbuf.str_buf mut object = strbuf.create();
    defer strbuf.free(&object);
    i32 mut status = built;
    if (status == EXIT_OK) {
        status = make_object(opts, u, ir_path, object_path, &object);
    }
    if (status == EXIT_OK && opts->compile_only) {
        i32 mut failure = 0;
        bool mut sent = false;
        if (out_path == STDOUT_OUTPUT) {
            sent = write_stdout(strbuf.bytes(&object));
            failure = sys.errno();
        } else {
            sent = artifact.write_output(out_path, strbuf.bytes(&object), &failure);
        }
        if (!sent) {
            error_path("cannot write", out_path, str.from_cstr(libc.strerror(failure)));
            status = EXIT_USAGE;
        }
    } else if (status == EXIT_OK) {
        containers.str_vec mut archives = containers.str_create();
        defer containers.str_free(&archives);
        if (!copy_archives(opts, libs, &p, dir, &archives)) {
            status = EXIT_USAGE;
        } else {
            status = link_entry(opts, object_path, &archives, out_path);
        }
        u64 mut i = 0;
        while (i < archives.len) {
            containers.str_push(&written, containers.str_at(&archives, i));
            i += 1;
        }
    }
    remove_library_temp(dir, containers.str_items(&written));
    return status;
}

// ---- the cache -----------------------------------------------------

/// The unit of a build that uses the cache (toolchain.md 2.2 and 2.3): the fields of its manifest
/// and the storage of their strings, its key, the cache directory and what the lookup found, with
/// the checked bytes of a hit. A zero value is a build that uses no cache.
struct cached_unit {
    bool active; // the build reads and writes the cache
    artifact.manifest fields; // the strings point into the members below, `libs` and `opts`
    containers.str_vec cfg_keys;
    containers.str_vec cfg_values;
    containers.str_vec use_hashes;
    strbuf.str_buf source; // the source hash
    strbuf.str_buf key;
    strbuf.str_buf dir; // the cache directory
    strbuf.str_buf entry_path; // the entry module path, which outlives the analysis
    cache.outcome found;
    artifact.contents entry; // the files of the entry after a hit
}

fn free_unit(cached_unit mut* u) void {
    containers.str_free(&u->cfg_keys);
    containers.str_free(&u->cfg_values);
    containers.str_free(&u->use_hashes);
    strbuf.free(&u->source);
    strbuf.free(&u->key);
    strbuf.free(&u->dir);
    strbuf.free(&u->entry_path);
    artifact.free(&u->entry);
}

// Fills the fields of the manifest of the unit that the key covers, except the unit line and the
// source hash: the compiler identity, the target, the two modes, the configuration map, `--cc`,
// each `-Xcc` argument, `--ar`, and the interface hash of each used library (toolchain.md 2.2).
// `libs->compiler` holds the compiler identity.
fn fill_unit(options* opts, libraries* libs, cached_unit mut* u) void {
    append_config(opts, &u->cfg_keys, &u->cfg_values);
    u64 mut i = 0;
    while (i < libs->len) {
        containers.str_push(&u->use_hashes, libs->items[i].fields.interface);
        i += 1;
    }
    artifact.manifest mut* m = &u->fields;
    m->compiler = strbuf.view(&libs->compiler);
    m->target = opts->target;
    m->release = opts->release;
    m->no_bounds_check = opts->no_bounds_check;
    m->cfg_keys = containers.str_items(&u->cfg_keys);
    m->cfg_values = containers.str_items(&u->cfg_values);
    m->cc = opts->cc;
    m->cc_args = containers.str_items(&opts->cc_args);
    m->ar = opts->ar;
    m->use_names = containers.str_items(&opts->use_names);
    m->use_hashes = containers.str_items(&u->use_hashes);
}

// Computes the key of the unit from its fields and the source hash in `u->source`, and the cache
// directory: `--cache-dir`, else `<base>/.fort-cache` (toolchain.md 2.3).
fn compute_key(options* opts, string base, cached_unit mut* u) void {
    u->fields.source = strbuf.view(&u->source);
    strbuf.clear(&u->key);
    artifact.append_key(&u->fields, &u->key);
    strbuf.clear(&u->dir);
    if (opts->have_cache_dir) {
        strbuf.append(&u->dir, opts->cache_dir);
    } else {
        cache.append_default(&u->dir, base);
    }
}

// Computes the key of the unit and looks it up in the cache directory (toolchain.md 2.3). Sets
// `u->found`, and on a hit `u->entry` holds the checked files of the entry.
fn find_unit(options* opts, string base, cached_unit mut* u) void {
    compute_key(opts, base, u);
    u->found = cache.find(strbuf.view(&u->dir), strbuf.view(&u->key), !u->fields.entry_unit,
                          &u->entry);
}

// Writes the `--cache-stats` line of a build that used the cache (toolchain.md 1).
fn write_stats(options* opts, cached_unit* u) void {
    if (!opts->cache_stats || !u->active) {
        return;
    }
    string mut name = u->fields.library;
    if (u->fields.entry_unit) {
        name = u->fields.entry;
    }
    strbuf.str_buf mut line = strbuf.create();
    defer strbuf.free(&line);
    cache.append_stats(&line, !u->fields.entry_unit, name, strbuf.view(&u->key), u->found);
    print(strbuf.view(&line));
}

// ---- the library build ---------------------------------------------

// The suffix of an artifact directory, and the archive that a library build writes in its
// temporary directory (toolchain.md 2.1 and 2.2).
string ARTIFACT_SUFFIX = ".flib";
string ARCHIVE_NAME = "lib.a";

// The output of a library build: -o when given, else `<name>.ll` under -S, `<name>.o` under -c
// and the artifact directory `<name>.flib` otherwise, each in the current directory. Interned in
// `p`.
fn library_output(containers.pool mut* p, options* opts) string {
    if (opts->have_output) {
        return containers.pool_intern(p, opts->output);
    }
    // -S and -c together stop at the IR, so -S decides the suffix
    if (opts->emit_ir) {
        return join_path(p, "", opts->lib_name, IR_SUFFIX);
    }
    if (opts->compile_only) {
        return join_path(p, "", opts->lib_name, OBJECT_SUFFIX);
    }
    return join_path(p, "", opts->lib_name, ARTIFACT_SUFFIX);
}

// Whether a library build can use its target. It reports the usage error when it cannot, before
// the build reads the root (toolchain.md 2.1, step 0). --emit-interface and -S write text, so they
// take any target form; -c and the artifact compile an object, so they take the built target
// alone.
fn has_usable_target(options* opts) bool {
    if (!target_form(opts->target)) {
        usage_error_arg("unsupported target", opts->target);
        return false;
    }
    if (opts->emit_interface || opts->emit_ir || opts->target == os.TARGET) {
        return true;
    }
    eprintln("fort: error: cannot compile object for target '", opts->target, "' with a '",
             os.TARGET, "' compiler");
    eprintln(USAGE);
    return false;
}

// Runs the compile line of a library build over the module `ir_path` (toolchain.md 2.1, step 7):
// the --cc line with `-c` and no `-l` option, to the object `object_path`.
fn compile_library(options* opts, string ir_path, string object_path) i32 {
    containers.pool mut p = containers.pool_create();
    defer containers.pool_free(&p);
    containers.str_vec mut argv = containers.str_create();
    defer containers.str_free(&argv);
    push_cc_line(&p, opts, ir_path, object_path, true, &argv);
    return run_tool("cc", &argv);
}

// Runs the archive line (toolchain.md 2.1, step 8), `<ar> rcs <archive> <object>`, which writes
// an archive with one member, the object.
fn archive_library(options* opts, string archive_path, string object_path) i32 {
    containers.str_vec mut argv = containers.str_create();
    defer containers.str_free(&argv);
    containers.str_push(&argv, opts->ar);
    containers.str_push(&argv, "rcs");
    containers.str_push(&argv, archive_path);
    containers.str_push(&argv, object_path);
    return run_tool("ar", &argv);
}

// Writes the cache entry and then the artifact `dir` (toolchain.md 2.1, step 9, and 2.2). It
// reads the archive once and uses those bytes for its hash and for both copies.
// `interface_text` is the interface file, and `u` holds the fields of the manifest that the key
// covers and the key. A cache entry that cannot be written is no error (toolchain.md 2.3). The
// status is EXIT_USAGE after a report: the archive that cannot be read, or a file of the artifact
// that cannot be written.
fn write_artifact(string dir, string interface_text, string archive_path, cached_unit mut* u)
    i32 {
    strbuf.str_buf mut archive = strbuf.create();
    defer strbuf.free(&archive);
    if (!io.read_file(archive_path, &archive)) {
        error_path("cannot read", archive_path, str.from_cstr(libc.strerror(sys.errno())));
        return EXIT_USAGE;
    }
    strbuf.str_buf mut interface_hash = strbuf.create();
    defer strbuf.free(&interface_hash);
    artifact.append_hash(&interface_hash, cast(interface_text, u8@));
    strbuf.str_buf mut archive_hash = strbuf.create();
    defer strbuf.free(&archive_hash);
    artifact.append_hash(&archive_hash, strbuf.bytes(&archive));
    u->fields.interface = strbuf.view(&interface_hash);
    u->fields.archive = strbuf.view(&archive_hash);
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    artifact.write_manifest(&u->fields, &text);
    // the two fields point into buffers of this call, so they go before the buffers do
    u->fields.interface = "";
    u->fields.archive = "";
    cache.store_library(strbuf.view(&u->dir), strbuf.view(&u->key), interface_text,
                        strbuf.bytes(&archive), strbuf.view(&text));
    strbuf.str_buf mut failed = strbuf.create();
    defer strbuf.free(&failed);
    i32 mut failure = 0;
    if (!artifact.write(dir, interface_text, strbuf.bytes(&archive), strbuf.view(&text), &failed,
                        &failure)) {
        error_path("cannot write", strbuf.view(&failed), str.from_cstr(libc.strerror(failure)));
        return EXIT_USAGE;
    }
    return EXIT_OK;
}

// Writes the files of the cache entry that a lookup found to the artifact `dir` by the write
// protocol (toolchain.md 2.1, step 3): the bytes that the lookup checked. Returns EXIT_USAGE
// after the report of a file of the artifact that cannot be written.
fn copy_entry(string dir, cached_unit* u) i32 {
    artifact.contents* c = &u->entry;
    strbuf.str_buf mut failed = strbuf.create();
    defer strbuf.free(&failed);
    i32 mut failure = 0;
    if (!artifact.write(dir, strbuf.view(&c->interface), strbuf.bytes(&c->archive),
                        strbuf.view(&c->text), &failed, &failure)) {
        error_path("cannot write", strbuf.view(&failed), str.from_cstr(libc.strerror(failure)));
        return EXIT_USAGE;
    }
    return EXIT_OK;
}

// Reads each module file of the walk `t` once, through the session, and pushes its bytes to
// `texts` (toolchain.md 2.1, step 2). The parse reads the same bytes from the session. Returns
// false when a file cannot be read; the load then reports it.
fn read_listed(session.session mut* s, tree.tree* t, containers.str_vec mut* paths,
               containers.str_vec mut* files, containers.str_vec mut* texts) bool {
    u64 mut i = 0;
    while (i < tree.count(t)) {
        string mut text = "";
        if (!session.read_source(s, tree.file_at(t, i), &text)) {
            return false;
        }
        containers.str_push(paths, tree.path_at(t, i));
        containers.str_push(files, tree.file_at(t, i));
        containers.str_push(texts, text);
        i += 1;
    }
    return true;
}

// Removes the files that a library build wrote in the temporary directory, and then the
// directory. An empty path names no file, and a file already gone is not an error.
fn remove_library_temp(string dir, string@ files) void {
    u64 mut i = 0;
    while (i < files.len) {
        if (files[i].len > 0) {
            char mut@ own path = str.to_cstr(files[i]);
            defer del(path);
            libc.unlink(&path[0]);
        }
        i += 1;
    }
    remove_temp_dir(dir, "");
}

// `--lib <name> <root>` (toolchain.md 2.1, D9.11): walks the root and reads each module file once.
// A build that writes the artifact then takes the source hash and the key and looks the key up in
// the cache; on a hit it writes the files of the entry to the artifact and stops. Else it loads
// and checks every module of the library, and lowers and verifies each body as --check does.
// --emit-interface then writes the interface file to stdout. Else the build emits one IR module
// for the library, which -S writes to its output. It compiles the module to an object, which -c
// writes to its output, and else archives the object and writes the cache entry and the artifact
// `<name>.flib`. A root that cannot be read or holds no module is exit 2, and a compile
// diagnostic is exit 1.
fn library_entry(options* opts) i32 {
    if (!has_usable_target(opts)) {
        return EXIT_USAGE;
    }
    libraries mut libs = libraries{};
    defer free_libraries(&libs);
    i32 read = read_libraries(opts, &libs);
    if (read != EXIT_OK) {
        return read;
    }
    tree.tree mut t = tree.tree{};
    defer tree.free(&t);
    i32 mut failure = 0;
    if (!tree.walk(&t, opts->lib_name, opts->lib_root, &failure)) {
        error_path("cannot read library root", opts->lib_root,
                   str.from_cstr(libc.strerror(failure)));
        return EXIT_USAGE;
    }
    if (tree.count(&t) == 0) {
        eprintln("fort: error: library root '", opts->lib_root, "' holds no module");
        return EXIT_USAGE;
    }
    session.session mut s = session.create();
    defer session.free(&s);
    configure(&s, opts);
    diag.set_text(session.diags(&s), true);
    session.show_sources(&s);
    containers.str_vec mut paths = containers.str_create();
    defer containers.str_free(&paths);
    containers.str_vec mut files = containers.str_create();
    defer containers.str_free(&files);
    containers.str_vec mut texts = containers.str_create();
    defer containers.str_free(&texts);
    bool listed = read_listed(&s, &t, &paths, &files, &texts);
    containers.pool mut p = containers.pool_create();
    defer containers.pool_free(&p);
    string out_path = library_output(&p, opts);
    // Only a build that writes the artifact uses the cache (toolchain.md 2.3). A file that cannot
    // be read gives no source hash, and the load reports it.
    cached_unit mut u = cached_unit{};
    defer free_unit(&u);
    u.active = !opts->emit_interface && !opts->emit_ir && !opts->compile_only && listed;
    if (u.active) {
        if (!hash_identity(&libs)) {
            return EXIT_USAGE;
        }
        fill_unit(opts, &libs, &u);
        u.fields.library = opts->lib_name;
        artifact.hash_texts(containers.str_items(&paths), containers.str_items(&files),
                            containers.str_items(&texts), &u.source);
        find_unit(opts, opts->lib_root, &u);
        if (u.found == cache.outcome.o_hit) {
            i32 copied = copy_entry(out_path, &u);
            if (copied == EXIT_OK) {
                write_stats(opts, &u);
            }
            return copied;
        }
    }
    // The build path releases the analysis before it spawns --cc, as compile_entry does, and the
    // flag makes one of the two calls do the work.
    analysis mut an = analysis_create(&s);
    bool mut analysis_live = true;
    defer analysis_release(&an, &analysis_live);
    i32 used = use_libraries(&s, opts, &libs, &an);
    if (used != EXIT_OK) {
        return used;
    }
    bool loaded = modules.load_library(&s, &an.set, opts->lib_name, opts->lib_root, &t);
    // D8.6 does not apply under --lib: a `main` of a library module is an ordinary function
    an.ck.require_main = false;
    bool checked = check_stmt.check_program(&an.ck, &an.set);
    if (!loaded || !checked || session.error_count(&s) > 0) {
        return EXIT_COMPILE_ERROR;
    }
    // lower, verify and run the emptiness pass over each body, as --check does, and then check
    // the extern declarations of the used libraries (toolchain.md 2.1, step 4)
    i32 lowered = overwrite_entry(&s, &an, opts);
    if (lowered != EXIT_OK) {
        return lowered;
    }
    if (!check_outside(&s, opts, &libs, &an)) {
        return EXIT_COMPILE_ERROR;
    }
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    interface.write(&an.ck, &an.set, opts->lib_name, &text);
    if (opts->emit_interface) {
        print(strbuf.view(&text));
        return EXIT_OK;
    }
    if (opts->emit_ir) {
        return emit_module(&s, opts, &an, out_path);
    }
    if (!opts->compile_only && !u.active) {
        // A file of the walk that the first read refused and the parse read: the source hash
        // takes the bytes that the build parsed, and the build looked up no entry.
        if (!hash_identity(&libs)) {
            return EXIT_USAGE;
        }
        u.active = true;
        fill_unit(opts, &libs, &u);
        u.fields.library = opts->lib_name;
        artifact.hash_sources(&an.set, &u.source);
        compute_key(opts, opts->lib_root, &u);
        u.found = cache.outcome.o_absent;
    }
    string mut parent = TMP_DIR_DEFAULT;
    string dir = make_temp_dir(&p, &parent, &failure);
    if (dir.len == 0) {
        error_path("cannot create a temporary directory in", parent,
                   str.from_cstr(libc.strerror(failure)));
        return EXIT_USAGE;
    }
    string ir_path = join_path(&p, dir, opts->lib_name, IR_SUFFIX);
    string mut object_path = out_path;
    string mut archive_path = "";
    if (!opts->compile_only) {
        object_path = join_path(&p, dir, opts->lib_name, OBJECT_SUFFIX);
        archive_path = join_path(&p, dir, ARCHIVE_NAME, "");
    }
    i32 mut built = emit_module(&s, opts, &an, ir_path);
    // Release analysis storage before fork duplicates the process page tables.
    analysis_release(&an, &analysis_live);
    if (built == EXIT_OK) {
        built = compile_library(opts, ir_path, object_path);
    }
    if (built == EXIT_OK && !opts->compile_only) {
        built = archive_library(opts, archive_path, object_path);
    }
    if (built == EXIT_OK && !opts->compile_only) {
        built = write_artifact(out_path, strbuf.view(&text), archive_path, &u);
    }
    string[3] mut written = {ir_path, "", archive_path};
    if (!opts->compile_only) {
        written[1] = object_path;
    }
    remove_library_temp(dir, written[..]);
    if (built == EXIT_OK) {
        write_stats(opts, &u);
    }
    return built;
}

// ---- the pipeline --------------------------------------------------

// Runs the compiler with args[1..]; returns the process exit status.
fn run(string@ args) i32 {
    // fort with no arguments prints one usage line and exits with 2
    if (args.len < 2) {
        eprintln(USAGE);
        return EXIT_USAGE;
    }
    options mut opts = options_create();
    defer options_free(&opts);
    i32 parsed = parse(&opts, args);
    if (parsed == PARSE_ERROR) {
        return EXIT_USAGE;
    }
    if (parsed == PARSE_DONE) {
        return EXIT_OK;
    }
    // --tokens stops after the lexer, and --ast stops after the parser.
    // Every other run goes through the front end.
    if (opts.tokens) {
        return tokens_entry(&opts);
    }
    if (opts.ast) {
        return ast_entry(&opts);
    }
    if (opts.fir_test) {
        return fir_test_entry(&opts, args[0]);
    }
    if (opts.have_lib) {
        return library_entry(&opts);
    }
    return compile_entry(&opts, args[0]);
}
