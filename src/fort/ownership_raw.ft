/// Proves raw access from captured source, layout, window, and alignment facts.
// The caller supplies checked facts. This module changes no emitted program.
import ast;
import ownership_api;
import ownership_combinations;
import ownership_keys;
import ownership_state;
import ownership_transfer;
import ownership_type_work;
import types;

u64 U64_MAX = 18446744073709551615;

// Signed magnitude keeps mathematical endpoint checks separate from wrapped integers.
struct number { u64 magnitude; bool negative; bool valid; }
struct term { ownership_api.entity_id version; number coefficient; }
struct expression { number constant; term@ terms; bool complete; }
struct captured_bound { ownership_api.entity_id version; number lower; number upper; }
struct relation { expression left; expression right; }
struct interval { number lower; number upper; bool proved; }

struct storage_leaf {
    ownership_api.place_path place;
    u64 begin;
    u64 end;
    types.node* ty;
    bool owning;
    bool padding;
}

// Layout describes one inline element. Count retains a repeated allocation's full extent.
struct origin {
    ownership_api.entity_id source;
    ownership_api.entity_id allocation;
    ownership_api.place_path place;
    types.node* layout;
    expression count;
    expression begin;
    expression end;
    u64 alignment;
    bool repeated;
    bool correspondence;
    bool residual;
    u64 first_leaf;
    u64 leaf_count;
}

struct address {
    ownership_api.entity_id source;
    expression offset;
    expression begin;
    expression end;
    types.node* ty;
    u64 alignment;
    bool complete;
}

struct term_block { term mut@ own items; term_block mut* own next; }
struct context {
    ownership_state.state* core;
    origin mut@ own origins;
    storage_leaf mut@ own leaves;
    u64 leaves_len;
    captured_bound mut@ own bounds;
    relation mut@ own relations;
    term_block mut* own terms;
    ownership_state.state paths;
    ownership_api.proof_status proof;
}
struct request {
    ownership_transfer.request base;
    ownership_api.limit_table limits;
    bool alternatives_complete;
    bool captured_values;
}
struct result { context storage; address mut@ own addresses; ownership_api.proof_status proof; }

fn natural(u64 value) number { return number{value, false, true}; }
fn signed(i64 value) number {
    if (value >= 0) { return natural(cast(value, u64)); }
    return number{cast(-(value + 1), u64) + 1, true, true};
}
fn literal(u64 value) expression {
    expression mut out = expression{};
    out.constant = natural(value);
    out.complete = true;
    return out;
}
fn negate(number mut value) number {
    if (value.magnitude > 0) { value.negative = !value.negative; }
    return value;
}
fn plus(number a, number b) number {
    if (!a.valid || !b.valid) { return number{}; }
    if (a.negative == b.negative) {
        if (a.magnitude > U64_MAX - b.magnitude) { return number{}; }
        return number{a.magnitude + b.magnitude, a.negative &&
            a.magnitude + b.magnitude != 0, true};
    }
    if (a.magnitude >= b.magnitude) {
        return number{a.magnitude - b.magnitude, a.negative &&
            a.magnitude != b.magnitude, true};
    }
    return number{b.magnitude - a.magnitude, b.negative, true};
}
fn multiply(number a, number b) number {
    if (!a.valid || !b.valid || (b.magnitude > 0 && a.magnitude > U64_MAX / b.magnitude)) {
        return number{};
    }
    u64 value = a.magnitude * b.magnitude;
    return number{value, value != 0 && a.negative != b.negative, true};
}
fn less_equal(number a, number b) bool {
    if (!a.valid || !b.valid) { return false; }
    if (a.negative != b.negative) { return a.negative; }
    if (a.negative) { return a.magnitude >= b.magnitude; }
    return a.magnitude <= b.magnitude;
}
fn same_number(number a, number b) bool {
    return a.valid && b.valid && a.magnitude == b.magnitude && a.negative == b.negative;
}
fn same_key(ownership_api.entity_id a, ownership_api.entity_id b) bool {
    return ownership_keys.entity(a, b) == 0;
}
fn value_key(ownership_api.entity_id key) bool {
    return key.kind == ownership_api.entity_kind.value && key.ordinal != 0;
}
fn complete() ownership_api.proof_status {
    ownership_api.proof_status mut proof = ownership_api.proof_status{};
    proof.kind = ownership_api.proof_kind.complete;
    return proof;
}
// The stack cursor keeps one route after complete map validation.
struct work_cursor {
    request selected;
    ownership_transfer.event_binding[1] binding;
    ownership_api.proof_status proof;
}
struct raw_event_route { request* selected; ownership_api.services original; }
struct calculation {
    context* storage;
    ownership_api.services* service;
    request* selected;
    ownership_api.proof_status proof;
}
fn cached_key(request* req) ownership_api.entity_id {
    if (req->base.event_map_complete_proved && req->base.event_bindings.len == 1 &&
        ownership_keys.operation(req->base.event_bindings[0].operation,
        req->base.operation) == 0) { return req->base.event_bindings[0].key; }
    return ownership_api.entity_id{};
}
fn fail(ownership_api.services* svc, request* req, ownership_api.entity_id key,
    bool invalid, string text) ownership_api.proof_status {
    ownership_api.entity_id route = cached_key(req);
    if (route.kind != ownership_api.entity_kind.event) {
        return ownership_api.incomplete(ownership_api.incomplete_reason.missing_events,
            req->base.operation, req->base.source_position);
    }
    ownership_api.proof_status mut proof = complete();
    proof.failed = true;
    if (!invalid) {
        proof = ownership_api.incomplete(ownership_api.incomplete_reason.unknown_effect,
            req->base.operation, req->base.source_position);
        proof.terminal.relation = key;
    }
    ownership_api.event_descriptor mut event = ownership_api.event_descriptor{};
    event.key = route;
    event.operation = req->base.operation;
    event.source = req->base.source_position;
    event.kind = invalid ? ownership_api.event_kind.invalid_use :
        ownership_api.event_kind.incomplete_proof;
    event.evidence = invalid ? ownership_api.evidence_kind.unconditional :
        ownership_api.evidence_kind.abstract_possibility;
    event.reason = invalid ? ownership_api.incomplete_reason.none :
        ownership_api.incomplete_reason.unknown_effect;
    event.relation = key;
    event.source_path = req->base.source;
    event.owner_path = req->base.destination;
    event.text = text;
    ownership_api.witness_link[1] mut witness = {};
    witness[0].key = route;
    witness[0].key.kind = ownership_api.entity_kind.witness;
    witness[0].condition = key;
    witness[0].validated = invalid;
    event.witnesses = witness[..];
    ownership_api.event_request report = ownership_api.event_request{event, proof};
    return ownership_api.record_event(svc, &report).proof;
}
fn before_route(ownership_api.services* svc, request* req) ownership_api.proof_status {
    ownership_api.charge_item[1] items = {ownership_api.charge_item{
        ownership_api.limit_category.w, ownership_api.limit_scope.computation, 1}};
    ownership_api.charge_request change = ownership_api.charge_request{
        ownership_api.work_kind.transfer, req->base.operation, req->base.source_position,
        items[..]};
    ownership_api.charge_result charged = ownership_api.charge(svc, &change);
    return charged.allowed ? complete() : charged.proof;
}
fn begin_work(ownership_state.state* core, ownership_api.services* svc, request* req,
    work_cursor mut* cursor) ownership_api.proof_status {
    *cursor = work_cursor{};
    cursor->selected = *req;
    cursor->proof = core->proof;
    if (!ownership_api.successful(cursor->proof)) { return cursor->proof; }
    if (!req->base.event_map_complete_proved || req->base.event_bindings.len == 0) {
        cursor->proof = ownership_api.incomplete(ownership_api.incomplete_reason.missing_events,
            req->base.operation, req->base.source_position);
        return cursor->proof;
    }
    ownership_api.entity_id mut key = ownership_api.entity_id{};
    u64 mut i = 0;
    while (i < req->base.event_bindings.len) {
        cursor->proof = before_route(svc, req);
        if (!ownership_api.successful(cursor->proof)) { return cursor->proof; }
        ownership_transfer.event_binding left = req->base.event_bindings[i];
        if (left.key.kind != ownership_api.entity_kind.event ||
            ownership_keys.function(left.key.function, left.operation.function) != 0) {
            cursor->proof = ownership_api.incomplete(ownership_api.incomplete_reason.missing_events,
                req->base.operation, req->base.source_position);
            return cursor->proof;
        }
        if (ownership_keys.operation(left.operation, req->base.operation) == 0) { key = left.key; }
        u64 mut j = 0;
        while (j < i) {
            cursor->proof = before_route(svc, req);
            if (!ownership_api.successful(cursor->proof)) { return cursor->proof; }
            if (ownership_keys.operation(left.operation,
                req->base.event_bindings[j].operation) == 0) {
                key = ownership_api.entity_id{};
                break;
            }
            cursor->proof = before_route(svc, req);
            if (!ownership_api.successful(cursor->proof)) { return cursor->proof; }
            if (same_key(left.key, req->base.event_bindings[j].key)) {
                key = ownership_api.entity_id{};
                break;
            }
            j += 1;
        }
        if (j < i) { break; }
        i += 1;
    }
    if (i != req->base.event_bindings.len || key.kind != ownership_api.entity_kind.event) {
        cursor->proof = ownership_api.incomplete(ownership_api.incomplete_reason.missing_events,
            req->base.operation, req->base.source_position);
        return cursor->proof;
    }
    cursor->binding[0] = ownership_transfer.event_binding{req->base.operation, key};
    cursor->selected.base.event_bindings = cursor->binding[..];
    if (!req->alternatives_complete || !req->captured_values) {
        cursor->proof = fail(svc, &cursor->selected, ownership_api.entity_id{}, false,
            "raw proof needs exhaustive captured input correspondence");
    } else if (!ownership_api.valid_limits(&req->limits)) {
        cursor->proof = fail(svc, &cursor->selected, ownership_api.entity_id{}, false,
            "raw proof needs valid limits");
    } else { cursor->proof = complete(); }
    return cursor->proof;
}
fn entry(ownership_state.state* core, ownership_api.services* svc, request* req)
    ownership_api.proof_status {
    work_cursor mut cursor = {};
    return begin_work(core, svc, req, &cursor);
}
fn cached_event(void mut* opaque, ownership_api.event_request* report)
    ownership_api.event_result {
    raw_event_route* route = cast(opaque, raw_event_route*);
    ownership_api.exhaustion limit = report->current.terminal.limit;
    ownership_api.entity_id key = cached_key(route->selected);
    if (key.kind != ownership_api.entity_kind.event ||
        ownership_keys.operation(report->event.operation, route->selected->base.operation) != 0 ||
        (report->event.kind == ownership_api.event_kind.work_failure &&
        (report->event.reason != ownership_api.incomplete_reason.work_limit ||
        report->current.terminal.reason != ownership_api.incomplete_reason.work_limit ||
        !limit.present || ownership_keys.operation(limit.operation, report->event.operation) != 0 ||
        ownership_keys.source(limit.source, report->event.source) != 0))) {
        ownership_api.event_result mut refused = ownership_api.event_result{};
        refused.proof = ownership_api.incomplete(ownership_api.incomplete_reason.invalid_input,
            report->event.operation, report->event.source);
        refused.retained = true;
        return refused;
    }
    ownership_api.event_request mut mapped = *report;
    mapped.event.key = key;
    if (mapped.event.kind == ownership_api.event_kind.work_failure) { mapped.event.limit = limit; }
    return route->original.event(route->original.event_context, &mapped);
}
fn charge(ownership_api.services* svc, request* req, ownership_api.limit_category category,
    u64 amount) ownership_api.proof_status {
    ownership_api.charge_item[2] mut items = {};
    u64 mut len = 1;
    items[0] = ownership_api.charge_item{ownership_api.limit_category.w,
        ownership_api.limit_scope.computation, amount};
    if (category != ownership_api.limit_category.w) {
        items[0] = ownership_api.charge_item{category, ownership_api.scope_of(category), amount};
        items[1] = ownership_api.charge_item{ownership_api.limit_category.w,
            ownership_api.limit_scope.computation, 1};
        len = 2;
    }
    if (category == ownership_api.limit_category.w) { items[0].amount = 1; }
    u64 rounds = category == ownership_api.limit_category.w ? amount : 1;
    u64 mut round = 0;
    while (round < rounds) {
        ownership_api.charge_request change = ownership_api.charge_request{
            ownership_api.work_kind.transfer, req->base.operation, req->base.source_position,
            items[..len]};
        ownership_api.charge_result charged = ownership_api.charge(svc, &change);
        if (!charged.allowed) {
            if (svc->event == null || cached_key(req).kind != ownership_api.entity_kind.event) {
                return charged.proof;
            }
            raw_event_route mut route = {};
            route.original = *svc;
            route.selected = req;
            ownership_api.services mut mapped = *svc;
            mapped.event_context = cast(&route, void mut*);
            mapped.event = cached_event;
            return ownership_state.report_failure(&mapped, charged.proof,
                req->base.operation, req->base.source_position);
        }
        round += 1;
    }
    return complete();
}

// Content of one raw context in the R, P, and G categories of its paired core state.
struct units { u64 r; u64 p; u64 g; }

/// Counts each captured bound and each distinct relation as one predicate atom.
fn captured_predicates(captured_bound@ bounds, relation@ relations) u64 {
    u64 mut out = bounds.len;
    u64 mut i = 0;
    while (i < relations.len) {
        bool mut repeated = false;
        u64 mut j = 0;
        while (j < i && !repeated) {
            repeated = same_expression(relations[j].left, relations[i].left) &&
                same_expression(relations[j].right, relations[i].right);
            j += 1;
        }
        if (!repeated) { out = add_work(out, 1); }
        i += 1;
    }
    return out;
}

/// Returns the retained content of a raw context. Each layout leaf is one distinct region.
/// The context holds facts: each origin is one unconditional source and layout, so it adds no
/// guarded alternative. The alternatives of a reference are its addresses, which only its
/// result holds; result_content counts them.
fn content(context* ctx) units {
    return units{ctx->leaves_len, captured_predicates(ctx->bounds[..], ctx->relations[..]), 0};
}

/// Returns the content of a raw result. Its addresses are the exclusive alternatives of one
/// reference, so two or more give one G unit each.
fn result_content(result* value) units {
    units mut out = content(&value->storage);
    out.g = ownership_state.alternative_units(value->addresses.len);
    return out;
}

// The binding family of one raw address alternative.
u32 ADDRESS_FAMILY = 1;

fn key_number(u64 value) ownership_combinations.key_component {
    return ownership_combinations.key_component{
        .kind = ownership_combinations.component_kind.unsigned_number, .unsigned_value = value};
}

fn key_entity(ownership_api.entity_id value) ownership_combinations.key_component {
    return ownership_combinations.key_component{
        .kind = ownership_combinations.component_kind.entity, .entity_value = value};
}

fn address_parts(address value) u64 {
    u64 terms = add_work(value.offset.terms.len,
        add_work(value.begin.terms.len, value.end.terms.len));
    return add_work(11, add_work(terms, add_work(terms, terms)));
}

fn append_number(ownership_combinations.key_component mut@ parts, u64 mut* used, number value)
    void {
    parts[*used] = key_number(value.magnitude);
    parts[*used + 1] = key_number(value.negative ? 1 : 0);
    *used += 2;
}

// Terms enter the key in canonical version order, so equal expressions give equal keys.
fn append_expression(ownership_combinations.key_component mut@ parts, u64 mut* used,
    expression value) void {
    append_number(parts, used, value.constant);
    parts[*used] = key_number(value.terms.len);
    *used += 1;
    u64 first = *used;
    u64 mut i = 0;
    while (i < value.terms.len) {
        term item = value.terms[i];
        u64 mut at = i;
        while (at > 0 && ownership_keys.entity(item.version,
            parts[first + (at - 1) * 3].entity_value) < 0) {
            parts[first + at * 3] = parts[first + (at - 1) * 3];
            parts[first + at * 3 + 1] = parts[first + (at - 1) * 3 + 1];
            parts[first + at * 3 + 2] = parts[first + (at - 1) * 3 + 2];
            at -= 1;
        }
        parts[first + at * 3] = key_entity(item.version);
        parts[first + at * 3 + 1] = key_number(item.coefficient.magnitude);
        parts[first + at * 3 + 2] = key_number(item.coefficient.negative ? 1 : 0);
        i += 1;
    }
    *used += value.terms.len * 3;
}

/// Builds the rows of one raw context: one row for each address under its condition.
/// Equal addresses merge their conditions by disjunction. The caller keeps the result live.
fn alternatives(result* raw, ownership_combinations.condition@ conditions, u64 context,
    ownership_combinations.query* req) ownership_combinations.candidate {
    ownership_combinations.candidate mut out = ownership_combinations.candidate{};
    out.prospective = ownership_combinations.start(req);
    ownership_combinations.map mut* rows = &out.prospective;
    if (!ownership_api.successful(raw->proof) || raw->addresses.len == 0 ||
        conditions.len != raw->addresses.len) {
        ownership_combinations.invalid(rows, req);
    }
    ownership_combinations.key_component[1] subject = {key_number(context)};
    u64 mut i = 0;
    while (i < raw->addresses.len && ownership_combinations.successful(rows)) {
        address value = raw->addresses[i];
        if (value.source.kind == ownership_api.entity_kind.none || !value.offset.complete ||
            !value.begin.complete || !value.end.complete) {
            ownership_combinations.invalid(rows, req);
            break;
        }
        if (!ownership_combinations.include_input(rows, &conditions[i].store, req)) { break; }
        u64 root = ownership_combinations.import_root(rows, &conditions[i].store,
            conditions[i].root, req);
        u64 count = address_parts(value);
        if (!ownership_combinations.allocate(rows, count,
            sizeof(ownership_combinations.key_component), req)) { break; }
        ownership_combinations.key_component mut@ own parts =
            new(ownership_combinations.key_component, count);
        parts[0] = key_entity(value.source);
        parts[1] = key_number(value.alignment);
        u64 mut used = 2;
        append_expression(parts[..], &used, value.offset);
        append_expression(parts[..], &used, value.begin);
        append_expression(parts[..], &used, value.end);
        ownership_combinations.binding[1] item = {ownership_combinations.binding{ADDRESS_FAMILY,
            ownership_combinations.semantic_key{subject[..]},
            ownership_combinations.semantic_key{parts[0..used]}}};
        ownership_combinations.insert_row(rows, item[..], root, req);
        rows->bytes -= count * sizeof(ownership_combinations.key_component);
        del(parts);
        i += 1;
    }
    ownership_combinations.finish(&out, req);
    return out;
}

fn free(context mut* ctx) void {
    while (ctx->terms != null) {
        term_block mut* own block = move(ctx->terms);
        ctx->terms = move(block->next);
        del(block->items);
        del(block);
    }
    del(ctx->origins);
    del(ctx->leaves);
    del(ctx->bounds);
    del(ctx->relations);
    ownership_state.free(&ctx->paths);
    ctx->leaves_len = 0;
    ctx->core = null;
}
fn free_result(result mut* out) void {
    del(out->addresses);
    free(&out->storage);
}
fn copy_expression(context mut* ctx, expression input) expression {
    expression mut out = input;
    if (input.terms.len == 0) { return out; }
    term_block mut* own block = new(term_block);
    block->items = new(term, input.terms.len);
    u64 mut i = 0;
    while (i < input.terms.len) { block->items[i] = input.terms[i]; i += 1; }
    out.terms = block->items[..];
    block->next = move(ctx->terms);
    ctx->terms = move(block);
    return out;
}
fn valid_expression(expression input) bool {
    if (!input.complete || !input.constant.valid ||
        input.terms.len > types.TYPE_MAX_SIZE / sizeof(term)) { return false; }
    u64 mut i = 0;
    while (i < input.terms.len) {
        if (!value_key(input.terms[i].version) || !input.terms[i].coefficient.valid) {
            return false;
        }
        i += 1;
    }
    return true;
}
fn bounded_expression(expression input, request* req) bool {
    return input.terms.len <= req->limits.p && valid_expression(input);
}
fn add_work(u64 a, u64 b) u64 {
    return a > U64_MAX - b ? U64_MAX : a + b;
}
fn square_work(u64 count) u64 {
    return count != 0 && count > U64_MAX / count ? U64_MAX : count * count;
}
fn coefficient(expression input, ownership_api.entity_id key) number {
    number mut out = natural(0);
    u64 mut i = 0;
    while (i < input.terms.len) {
        if (same_key(input.terms[i].version, key)) { out = plus(out, input.terms[i].coefficient); }
        i += 1;
    }
    return out;
}
fn first(expression input, u64 index) bool {
    u64 mut i = 0;
    while (i < index) {
        if (same_key(input.terms[i].version, input.terms[index].version)) { return false; }
        i += 1;
    }
    return true;
}
fn same_expression(expression a, expression b) bool {
    if (!valid_expression(a) || !valid_expression(b) || !same_number(a.constant, b.constant)) {
        return false;
    }
    u64 mut i = 0;
    while (i < a.terms.len) {
        ownership_api.entity_id key = a.terms[i].version;
        if (!same_number(coefficient(a, key), coefficient(b, key))) { return false; }
        i += 1;
    }
    i = 0;
    while (i < b.terms.len) {
        ownership_api.entity_id key = b.terms[i].version;
        if (!same_number(coefficient(a, key), coefficient(b, key))) { return false; }
        i += 1;
    }
    return true;
}
fn bound(context* ctx, ownership_api.entity_id key) interval {
    u64 mut i = 0;
    while (i < ctx->bounds.len) {
        if (same_key(ctx->bounds[i].version, key)) {
            return interval{ctx->bounds[i].lower, ctx->bounds[i].upper, true};
        }
        i += 1;
    }
    return interval{};
}
fn extend(interval mut current, number factor, interval input) interval {
    if (factor.magnitude == 0 && factor.valid) { return current; }
    if (!current.proved || !factor.valid || !input.proved) { return interval{}; }
    number lo = multiply(factor, factor.negative ? input.upper : input.lower);
    number hi = multiply(factor, factor.negative ? input.lower : input.upper);
    current.lower = plus(current.lower, lo);
    current.upper = plus(current.upper, hi);
    current.proved = current.lower.valid && current.upper.valid;
    return current;
}
// Common captured versions cancel before endpoint comparison.
fn difference(context* ctx, expression a, expression b) interval {
    if (!valid_expression(a) || !valid_expression(b)) { return interval{}; }
    number value = plus(a.constant, negate(b.constant));
    interval mut out = interval{value, value, value.valid};
    u64 mut i = 0;
    while (i < a.terms.len) {
        if (first(a, i)) {
            ownership_api.entity_id key = a.terms[i].version;
            number factor = plus(coefficient(a, key), negate(coefficient(b, key)));
            out = extend(out, factor, bound(ctx, key));
        }
        i += 1;
    }
    i = 0;
    while (i < b.terms.len) {
        ownership_api.entity_id key = b.terms[i].version;
        if (first(b, i) && coefficient(a, key).magnitude == 0) {
            // A cancelled coefficient in A still appears in the first pass.
            bool mut present = false;
            u64 mut j = 0;
            while (j < a.terms.len) {
                if (same_key(a.terms[j].version, key)) { present = true; }
                j += 1;
            }
            if (!present) { out = extend(out, negate(coefficient(b, key)), bound(ctx, key)); }
        }
        i += 1;
    }
    return out;
}
fn le(context* ctx, expression a, expression b) bool {
    interval delta = difference(ctx, a, b);
    if (delta.proved && less_equal(delta.upper, natural(0))) { return true; }
    interval left = difference(ctx, a, literal(0));
    interval right = difference(ctx, b, literal(0));
    if (left.proved && right.proved && less_equal(left.upper, right.lower)) { return true; }
    u64 mut i = 0;
    while (i < ctx->relations.len) {
        if (same_expression(a, ctx->relations[i].left) &&
            same_expression(b, ctx->relations[i].right)) { return true; }
        i += 1;
    }
    return false;
}
fn fits(context* ctx, expression value) bool {
    return le(ctx, literal(0), value) && le(ctx, value, literal(U64_MAX));
}
fn spend(calculation mut* work, u64 amount) bool {
    if (!ownership_api.successful(work->proof)) { return false; }
    work->proof = charge(work->service, work->selected, ownership_api.limit_category.w, amount);
    return ownership_api.successful(work->proof);
}
fn validate_expression_work(calculation mut* work, expression input) bool {
    if (!spend(work, 1)) { return false; }
    if (!input.complete || !input.constant.valid ||
        input.terms.len > types.TYPE_MAX_SIZE / sizeof(term)) { return false; }
    u64 mut i = 0;
    while (i < input.terms.len) {
        if (!spend(work, 1)) { return false; }
        if (!value_key(input.terms[i].version) || !input.terms[i].coefficient.valid) {
            return false;
        }
        i += 1;
    }
    return true;
}
fn validate_addresses_work(calculation mut* work, address@ values) bool {
    u64 mut i = 0;
    while (i < values.len) {
        if (!spend(work, 1)) { return false; }
        address item = values[i];
        if (item.offset.terms.len > work->selected->limits.p ||
            item.begin.terms.len > work->selected->limits.p ||
            item.end.terms.len > work->selected->limits.p ||
            !validate_expression_work(work, item.offset) ||
            !validate_expression_work(work, item.begin) ||
            !validate_expression_work(work, item.end)) { return false; }
        i += 1;
    }
    return true;
}
fn coefficient_work(calculation mut* work, expression input, ownership_api.entity_id key) number {
    number mut out = natural(0);
    u64 mut i = 0;
    while (i < input.terms.len) {
        if (!spend(work, 1)) { return number{}; }
        if (same_key(input.terms[i].version, key)) { out = plus(out, input.terms[i].coefficient); }
        i += 1;
    }
    return out;
}
fn first_work(calculation mut* work, expression input, u64 index) bool {
    u64 mut i = 0;
    while (i < index) {
        if (!spend(work, 1)) { return false; }
        if (same_key(input.terms[i].version, input.terms[index].version)) { return false; }
        i += 1;
    }
    return true;
}
fn bound_work(calculation mut* work, ownership_api.entity_id key) interval {
    u64 mut i = 0;
    while (i < work->storage->bounds.len) {
        if (!spend(work, 1)) { return interval{}; }
        captured_bound item = work->storage->bounds[i];
        if (same_key(item.version, key)) { return interval{item.lower, item.upper, true}; }
        i += 1;
    }
    return interval{};
}
fn same_expression_work(calculation mut* work, expression a, expression b) bool {
    if (!validate_expression_work(work, a) || !validate_expression_work(work, b) ||
        !same_number(a.constant, b.constant)) { return false; }
    u64 mut i = 0;
    while (i < a.terms.len) {
        if (!spend(work, 1)) { return false; }
        ownership_api.entity_id key = a.terms[i].version;
        number left = coefficient_work(work, a, key);
        number right = coefficient_work(work, b, key);
        if (!ownership_api.successful(work->proof) || !same_number(left, right)) { return false; }
        i += 1;
    }
    i = 0;
    while (i < b.terms.len) {
        if (!spend(work, 1)) { return false; }
        ownership_api.entity_id key = b.terms[i].version;
        number left = coefficient_work(work, a, key);
        number right = coefficient_work(work, b, key);
        if (!ownership_api.successful(work->proof) || !same_number(left, right)) { return false; }
        i += 1;
    }
    return true;
}
fn difference_work(calculation mut* work, expression a, expression b) interval {
    if (!validate_expression_work(work, a) || !validate_expression_work(work, b)) {
        return interval{};
    }
    number value = plus(a.constant, negate(b.constant));
    interval mut out = interval{value, value, value.valid};
    u64 mut i = 0;
    while (i < a.terms.len) {
        if (!spend(work, 1)) { return interval{}; }
        if (first_work(work, a, i)) {
            ownership_api.entity_id key = a.terms[i].version;
            number left = coefficient_work(work, a, key);
            number right = coefficient_work(work, b, key);
            interval captured = bound_work(work, key);
            out = extend(out, plus(left, negate(right)), captured);
        }
        if (!ownership_api.successful(work->proof)) { return interval{}; }
        i += 1;
    }
    i = 0;
    while (i < b.terms.len) {
        if (!spend(work, 1)) { return interval{}; }
        ownership_api.entity_id key = b.terms[i].version;
        bool leading = first_work(work, b, i);
        if (!ownership_api.successful(work->proof)) { return interval{}; }
        if (leading) {
            number factor = coefficient_work(work, a, key);
            if (!ownership_api.successful(work->proof)) { return interval{}; }
            if (factor.magnitude == 0) {
                bool mut present = false;
                u64 mut j = 0;
                while (j < a.terms.len) {
                    if (!spend(work, 1)) { return interval{}; }
                    if (same_key(a.terms[j].version, key)) { present = true; }
                    j += 1;
                }
                if (!present) {
                    number coefficient = coefficient_work(work, b, key);
                    interval captured = bound_work(work, key);
                    out = extend(out, negate(coefficient), captured);
                }
            }
        }
        if (!ownership_api.successful(work->proof)) { return interval{}; }
        i += 1;
    }
    return out;
}
fn le_work(calculation mut* work, expression a, expression b) bool {
    interval delta = difference_work(work, a, b);
    if (!ownership_api.successful(work->proof)) { return false; }
    if (delta.proved && less_equal(delta.upper, natural(0))) { return true; }
    interval left = difference_work(work, a, literal(0));
    interval right = difference_work(work, b, literal(0));
    if (!ownership_api.successful(work->proof)) { return false; }
    if (left.proved && right.proved && less_equal(left.upper, right.lower)) { return true; }
    u64 mut i = 0;
    while (i < work->storage->relations.len) {
        if (!spend(work, 1)) { return false; }
        relation stored = work->storage->relations[i];
        if (same_expression_work(work, a, stored.left) &&
            same_expression_work(work, b, stored.right)) { return true; }
        if (!ownership_api.successful(work->proof)) { return false; }
        i += 1;
    }
    return false;
}
fn fits_work(calculation mut* work, expression value) bool {
    return le_work(work, literal(0), value) && le_work(work, value, literal(U64_MAX));
}
fn aligned_work(calculation mut* work, expression offset, u64 alignment) bool {
    if (!validate_expression_work(work, offset) || alignment == 0 || offset.constant.negative ||
        offset.constant.magnitude % alignment != 0) { return false; }
    u64 mut i = 0;
    while (i < offset.terms.len) {
        if (!spend(work, 1)) { return false; }
        term item = offset.terms[i];
        number mut factor = coefficient_work(work, offset, item.version);
        if (!ownership_api.successful(work->proof)) { return false; }
        if (factor.magnitude % alignment != 0) {
            interval exact = bound_work(work, item.version);
            if (!ownership_api.successful(work->proof) || !exact.proved ||
                !same_number(exact.lower, exact.upper)) { return false; }
            factor = coefficient_work(work, offset, item.version);
            if (!ownership_api.successful(work->proof) ||
                !multiply(factor, exact.lower).valid) { return false; }
            factor = coefficient_work(work, offset, item.version);
            if (!ownership_api.successful(work->proof) ||
                multiply(factor, exact.lower).magnitude % alignment != 0) { return false; }
        }
        i += 1;
    }
    return true;
}
fn compare_expressions(context* ctx, ownership_api.services* svc, expression left,
    expression right, request* supplied) ownership_api.proof_status {
    work_cursor mut cursor = {};
    ownership_api.proof_status prepared = begin_work(ctx->core, svc, supplied, &cursor);
    request* req = &cursor.selected;
    ownership_api.proof_status mut proof = prepared;
    if (!ownership_api.successful(proof)) { return proof; }
    calculation mut work = calculation{ctx, svc, req, complete()};
    if (left.terms.len > req->limits.p || right.terms.len > req->limits.p ||
        !validate_expression_work(&work, left) || !validate_expression_work(&work, right)) {
        if (!ownership_api.successful(work.proof)) { return work.proof; }
        return fail(svc, req, ownership_api.entity_id{}, false, "raw expressions are incomplete");
    }
    bool proved = le_work(&work, left, right);
    if (!ownership_api.successful(work.proof)) { return work.proof; }
    if (!proved) {
        return fail(svc, req, ownership_api.entity_id{}, false,
            "raw bound relation remains unproved");
    }
    return complete();
}

fn scale(context mut* ctx, expression input, u64 stride) expression {
    expression mut out = copy_expression(ctx, input);
    out.constant = multiply(input.constant, natural(stride));
    if (input.terms.len > 0) {
        term_block mut* block = ctx->terms;
        u64 mut i = 0;
        while (i < block->items.len) {
            block->items[i].coefficient = multiply(block->items[i].coefficient, natural(stride));
            i += 1;
        }
    }
    return out;
}
fn sum(context mut* ctx, expression a, expression b) expression {
    expression mut out = expression{};
    out.constant = plus(a.constant, b.constant);
    out.complete = a.complete && b.complete;
    if (a.terms.len > U64_MAX - b.terms.len) { return out; }
    u64 len = a.terms.len + b.terms.len;
    if (len == 0) { return out; }
    term_block mut* own block = new(term_block);
    block->items = new(term, len);
    u64 mut i = 0;
    while (i < a.terms.len) { block->items[i] = a.terms[i]; i += 1; }
    u64 mut j = 0;
    while (j < b.terms.len) { block->items[i] = b.terms[j]; i += 1; j += 1; }
    out.terms = block->items[..];
    block->next = move(ctx->terms);
    ctx->terms = move(block);
    return out;
}

fn type_failure(ownership_api.services* svc, request* req,
    ownership_api.proof_status proof) ownership_api.proof_status {
    if (ownership_api.successful(proof) || svc->event == null ||
        cached_key(req).kind != ownership_api.entity_kind.event) { return proof; }
    raw_event_route mut route = raw_event_route{.selected = req, .original = *svc};
    ownership_api.services mut mapped = *svc;
    mapped.event_context = cast(&route, void mut*);
    mapped.event = cached_event;
    return ownership_state.report_failure(&mapped, proof, req->base.operation,
        req->base.source_position);
}

fn size(types.node* ty, ownership_api.services* svc, request* req, u64 mut* bytes)
    ownership_api.proof_status {
    ownership_type_work.work mut paid = ownership_type_work.create(svc,
        ownership_api.work_kind.transfer, req->base.operation, req->base.source_position);
    ownership_type_work.result measured = ownership_type_work.measure(&paid, ty, false);
    if (!ownership_api.successful(measured.proof)) {
        if (paid.problem != ownership_type_work.problem_kind.none) {
            return fail(svc, req, ownership_api.entity_id{}, false,
                paid.problem == ownership_type_work.problem_kind.size_overflow ?
                "raw array size exceeds the object limit" : "raw type layout remains unresolved");
        }
        return type_failure(svc, req, measured.proof);
    }
    *bytes = measured.number;
    return complete();
}

fn expression_copy_price(expression input) u64 {
    return input.terms.len == 0 ? 1 : add_work(4, input.terms.len);
}
fn place_copy_price(ownership_api.place_path input) u64 {
    return input.projections.len == 0 ? 1 : add_work(4, input.projections.len);
}
fn copy_expression_work(calculation mut* work, context mut* target, expression input)
    expression {
    expression mut refused = {};
    if (!spend(work, 1)) { return refused; }
    u64 price = input.terms.len == 0 ? 0 : add_work(3, input.terms.len);
    if (!spend(work, price)) { return refused; }
    return copy_expression(target, input);
}
fn copy_place_work(calculation mut* work, context mut* target, ownership_api.place_path input)
    ownership_api.place_path {
    ownership_api.place_path mut refused = {};
    if (!spend(work, 1)) { return refused; }
    u64 price = input.projections.len == 0 ? 0 : add_work(3, input.projections.len);
    if (!spend(work, price)) { return refused; }
    return ownership_state.copy_place(&target->paths, input);
}
fn scale_work(calculation mut* work, context mut* target, expression input, u64 stride)
    expression {
    expression mut refused = {};
    if (!spend(work, 1)) { return refused; }
    u64 price = add_work(expression_copy_price(input), add_work(1, input.terms.len));
    if (!spend(work, price)) { return refused; }
    return scale(target, input, stride);
}
fn sum_work(calculation mut* work, context mut* target, expression a, expression b) expression {
    expression mut refused = {};
    if (!spend(work, 3)) { return refused; }
    if (a.terms.len <= U64_MAX - b.terms.len) {
        u64 count = a.terms.len + b.terms.len;
        if (count > 0 && !spend(work, add_work(3, count))) { return refused; }
    }
    return sum(target, a, b);
}
fn source_index_work(calculation mut* work, ownership_api.entity_id key) u64 {
    u64 mut i = 0;
    while (i < work->storage->core->sources_len) {
        if (!spend(work, 1)) { return U64_MAX; }
        if (same_key(work->storage->core->sources[i].key, key)) { return i; }
        i += 1;
    }
    return U64_MAX;
}
fn allocation_index_work(calculation mut* work, ownership_api.entity_id key) u64 {
    u64 mut i = 0;
    while (i < work->storage->core->allocations_len) {
        if (!spend(work, 1)) { return U64_MAX; }
        if (same_key(work->storage->core->allocations[i].key, key)) { return i; }
        i += 1;
    }
    return U64_MAX;
}
fn origin_index_work(calculation mut* work, ownership_api.entity_id key) u64 {
    u64 mut i = 0;
    while (i < work->storage->origins.len) {
        if (!spend(work, 1)) { return U64_MAX; }
        if (same_key(work->storage->origins[i].source, key)) { return i; }
        i += 1;
    }
    return U64_MAX;
}
fn foreign_work(calculation mut* work, address value) bool {
    u64 index = source_index_work(work, value.source);
    if (index == U64_MAX || !spend(work, 1)) { return false; }
    return work->storage->core->sources[index].kind == ownership_api.source_kind.trusted_foreign;
}
fn residual_work(calculation mut* work, ownership_api.place_path path) bool {
    if (!spend(work, 1)) { return false; }
    if (path.residual) { return true; }
    u64 mut i = 0;
    while (i < path.projections.len) {
        if (!spend(work, 1)) { return false; }
        if (path.projections[i].kind == ownership_api.projection_kind.residual) { return true; }
        i += 1;
    }
    return false;
}
fn alignment_work(calculation mut* work, types.node* ty, u64 mut* alignment) bool {
    ownership_type_work.work mut paid = ownership_type_work.create(work->service,
        ownership_api.work_kind.transfer, work->selected->base.operation,
        work->selected->base.source_position);
    ownership_type_work.result measured = ownership_type_work.measure(&paid, ty, true);
    if (!ownership_api.successful(measured.proof)) {
        work->proof = paid.problem != ownership_type_work.problem_kind.none ?
            fail(work->service, work->selected, ownership_api.entity_id{}, false,
                "raw type alignment needs checked metadata") :
            type_failure(work->service, work->selected, measured.proof);
        return false;
    }
    *alignment = measured.number;
    return true;
}
fn append_leaf(context mut* ctx, ownership_api.services* svc, request* req,
    storage_leaf mut item) ownership_api.proof_status {
    if (ctx->leaves_len >= req->limits.r ||
        ctx->leaves_len >= types.TYPE_MAX_SIZE / sizeof(storage_leaf)) {
        return fail(svc, req, item.place.root, false,
            "raw layout exceeds retained region precision");
    }
    u64 mut core_regions = 0;
    if (ctx->core != null) {
        ownership_state.region_measurement core = ownership_state.measure_regions(ctx->core, svc,
            ownership_state.region_candidate{}, ownership_api.work_kind.transfer,
            req->base.operation, req->base.source_position);
        if (!ownership_api.successful(core.proof)) { return type_failure(svc, req, core.proof); }
        core_regions = core.amount;
    }
    u64 retained = add_work(core_regions, add_work(ctx->leaves_len, 1));
    ownership_api.proof_status mut proof = charge(svc, req,
        ownership_api.limit_category.r, retained);
    if (!ownership_api.successful(proof)) { return proof; }
    u64 len = ctx->leaves_len;
    proof = charge(svc, req, ownership_api.limit_category.w,
        add_work(add_work(len, 2), place_copy_price(item.place)));
    if (!ownership_api.successful(proof)) { return proof; }
    storage_leaf mut@ own next = new(storage_leaf, len + 1);
    u64 mut i = 0;
    while (i < len) { next[i] = ctx->leaves[i]; i += 1; }
    item.place = ownership_state.copy_place(&ctx->paths, item.place);
    next[len] = item;
    del(ctx->leaves);
    ctx->leaves = move(next);
    ctx->leaves_len += 1;
    return complete();
}
struct layout_frame {
    types.node* ty;
    ownership_api.place_path path;
    u64 offset;
    u64 bytes;
    u64 next;
    u64 end;
    u64 stride;
    u32 field;
    bool entered;
}
struct layout_frames { layout_frame mut@ own items; u64 len; }

fn layout_push(ownership_api.services* svc, request* req, layout_frames mut* pending,
    layout_frame item) ownership_api.proof_status {
    ownership_api.proof_status mut proof = charge(svc, req, ownership_api.limit_category.w, 1);
    if (!ownership_api.successful(proof)) { return proof; }
    u64 ceiling = types.TYPE_MAX_SIZE / sizeof(layout_frame);
    if (pending->len >= ceiling) {
        return fail(svc, req, item.path.root, false,
            "raw layout worklist exceeds the object limit");
    }
    if (pending->len == pending->items.len) {
        u64 capacity = pending->items.len == 0 ? 8 :
            (pending->items.len <= ceiling / 2 ? pending->items.len * 2 : ceiling);
        if (capacity <= pending->len || capacity > ceiling) {
            return fail(svc, req, item.path.root, false,
                "raw layout worklist exceeds the object limit");
        }
        layout_frame mut@ own bigger = new(layout_frame, capacity);
        u64 mut i = 0;
        while (i < pending->len) {
            proof = charge(svc, req, ownership_api.limit_category.w, 1);
            if (!ownership_api.successful(proof)) { del(bigger); return proof; }
            bigger[i] = pending->items[i];
            i += 1;
        }
        del(pending->items);
        pending->items = move(bigger);
    }
    pending->items[pending->len] = item;
    pending->len += 1;
    return complete();
}

fn layout_child(context mut* ctx, ownership_api.services* svc, request* req,
    layout_frames mut* pending, layout_frame parent, types.node* child_type,
    ownership_api.projection part, u64 offset) ownership_api.proof_status {
    // Permission precedes child allocation and storage.
    if (parent.path.projections.len >= req->limits.d) {
        return fail(svc, req, parent.path.root, false, "raw storage layout remains unresolved");
    }
    u64 len = parent.path.projections.len + 1;
    ownership_api.proof_status mut proof = charge(svc, req, ownership_api.limit_category.d, len);
    if (!ownership_api.successful(proof)) { return proof; }
    proof = charge(svc, req, ownership_api.limit_category.w,
        add_work(add_work(parent.path.projections.len, 2), add_work(len, 4)));
    if (!ownership_api.successful(proof)) { return proof; }
    ownership_api.projection mut@ own parts = new(ownership_api.projection, len);
    defer del(parts);
    u64 mut i = 0;
    while (i < parent.path.projections.len) { parts[i] = parent.path.projections[i]; i += 1; }
    parts[i] = part;
    ownership_api.place_path mut path = parent.path;
    path.projections = parts[..];
    path = ownership_state.copy_place(&ctx->paths, path);
    return layout_push(svc, req, pending, layout_frame{
        .ty = child_type, .path = path, .offset = offset});
}

fn layout(context mut* ctx, ownership_api.services* svc, request* req, types.node* ty,
    ownership_api.place_path path, u64 offset) ownership_api.proof_status {
    if (path.projections.len > req->limits.d) {
        return fail(svc, req, path.root, false, "raw storage layout remains unresolved");
    }
    layout_frames mut pending = {};
    defer del(pending.items);
    ownership_api.proof_status mut proof = layout_push(svc, req, &pending,
        layout_frame{.ty = ty, .path = path, .offset = offset});
    if (!ownership_api.successful(proof)) { return proof; }
    while (pending.len > 0) {
        proof = charge(svc, req, ownership_api.limit_category.w, 1);
        if (!ownership_api.successful(proof)) { return proof; }
        layout_frame mut* current = &pending.items[pending.len - 1];
        types.node* selected = current->ty;
        if (!current->entered) {
            u64 mut i = 0;
            while (i + 1 < pending.len) {
                proof = charge(svc, req, ownership_api.limit_category.w, 1);
                if (!ownership_api.successful(proof)) { return proof; }
                types.node* ancestor = pending.items[i].ty;
                if (selected == ancestor || (selected != null && ancestor != null &&
                    selected->kind == types.type_kind.k_struct &&
                    ancestor->kind == types.type_kind.k_struct &&
                    selected->decl == ancestor->decl)) {
                    return fail(svc, req, current->path.root, false,
                        "raw inline layout contains a cycle");
                }
                i += 1;
            }
            if (current->path.projections.len > 0) {
                proof = charge(svc, req, ownership_api.limit_category.d,
                    current->path.projections.len);
                if (!ownership_api.successful(proof)) { return proof; }
            }
            proof = size(selected, svc, req, &current->bytes);
            if (!ownership_api.successful(proof)) { return proof; }
            if (current->offset > U64_MAX - current->bytes) {
                return fail(svc, req, current->path.root, false,
                    "raw storage layout remains unresolved");
            }
            current->entered = true;
            current->end = current->offset;
            if (selected->kind == types.type_kind.k_array) {
                proof = size(selected->elem, svc, req, &current->stride);
                if (!ownership_api.successful(proof)) { return proof; }
            }
        }
        if (selected->kind == types.type_kind.k_array) {
            if (current->next == selected->len) { pending.len -= 1; continue; }
            u64 index = current->next;
            if (index > types.TYPE_MAX_SIZE ||
                (current->stride != 0 && index > U64_MAX / current->stride)) {
                return fail(svc, req, current->path.root, false, "raw array layout is invalid");
            }
            current->next += 1;
            ownership_api.projection part = ownership_api.projection{
                .kind = ownership_api.projection_kind.fixed_index,
                .index = ownership_api.scalar_fact{.kind = ownership_api.fact_kind.exact,
                    .value = cast(index, i64)}};
            proof = layout_child(ctx, svc, req, &pending, *current, selected->elem, part,
                current->offset + index * current->stride);
            if (!ownership_api.successful(proof)) { return proof; }
            continue;
        }
        if (selected->kind == types.type_kind.k_struct) {
            ast.sym* record = cast(selected->decl, ast.sym*);
            if (record->node == null) {
                return fail(svc, req, current->path.root, false, "struct fields are missing");
            }
            if (current->next == ast.ast_len(record->node)) {
                if (current->end < current->offset + current->bytes) {
                    proof = append_leaf(ctx, svc, req, storage_leaf{current->path, current->end,
                        current->offset + current->bytes, null, false, true});
                    if (!ownership_api.successful(proof)) { return proof; }
                }
                pending.len -= 1;
                continue;
            }
            ast.node* member = ast.ast_child(record->node, current->next);
            current->next += 1;
            if (member == null) {
                return fail(svc, req, current->path.root, false, "struct fields are missing");
            }
            if (member->kind != ast.ast_kind.k_field_decl) { continue; }
            if (member->aux > current->bytes || current->offset + member->aux < current->end) {
                return fail(svc, req, current->path.root, false, "struct field layout is invalid");
            }
            u64 start = current->offset + member->aux;
            u64 mut field_bytes = 0;
            proof = size(member->ty, svc, req, &field_bytes);
            if (!ownership_api.successful(proof)) { return proof; }
            if (field_bytes > current->offset + current->bytes - start ||
                current->field == 4294967295) {
                return fail(svc, req, current->path.root, false, "struct field extent is invalid");
            }
            if (start > current->end) {
                proof = append_leaf(ctx, svc, req, storage_leaf{current->path, current->end,
                    start, null, false, true});
                if (!ownership_api.successful(proof)) { return proof; }
            }
            current->end = start + field_bytes;
            ownership_api.projection part = ownership_api.projection{
                .kind = ownership_api.projection_kind.field, .field = current->field};
            current->field += 1;
            proof = layout_child(ctx, svc, req, &pending, *current, member->ty, part, start);
            if (!ownership_api.successful(proof)) { return proof; }
            continue;
        }
        proof = append_leaf(ctx, svc, req, storage_leaf{current->path, current->offset,
            current->offset + current->bytes, selected,
            types.type_is_reference(selected) && selected->is_own, false});
        if (!ownership_api.successful(proof)) { return proof; }
        pending.len -= 1;
    }
    return complete();
}

fn clone(context* input, ownership_state.state* core) context {
    context mut out = context{};
    out.core = core;
    out.paths = ownership_state.empty();
    out.proof = input->proof;
    out.origins = new(origin, input->origins.len);
    out.leaves = new(storage_leaf, input->leaves_len);
    out.leaves_len = input->leaves_len;
    out.bounds = new(captured_bound, input->bounds.len);
    out.relations = new(relation, input->relations.len);
    u64 mut i = 0;
    while (i < input->origins.len) {
        origin mut item = input->origins[i];
        item.place = ownership_state.copy_place(&out.paths, item.place);
        item.count = copy_expression(&out, item.count);
        item.begin = copy_expression(&out, item.begin);
        item.end = copy_expression(&out, item.end);
        out.origins[i] = item;
        i += 1;
    }
    i = 0;
    while (i < input->leaves_len) {
        out.leaves[i] = input->leaves[i];
        out.leaves[i].place = ownership_state.copy_place(&out.paths, input->leaves[i].place);
        i += 1;
    }
    i = 0;
    while (i < input->bounds.len) { out.bounds[i] = input->bounds[i]; i += 1; }
    i = 0;
    while (i < input->relations.len) {
        out.relations[i].left = copy_expression(&out, input->relations[i].left);
        out.relations[i].right = copy_expression(&out, input->relations[i].right);
        i += 1;
    }
    return out;
}
fn copy_address(context mut* ctx, address input) address {
    address mut out = input;
    out.offset = copy_expression(ctx, input.offset);
    out.begin = copy_expression(ctx, input.begin);
    out.end = copy_expression(ctx, input.end);
    return out;
}
fn origin_index(context* ctx, ownership_api.entity_id source) u64 {
    u64 mut i = 0;
    while (i < ctx->origins.len) {
        if (same_key(ctx->origins[i].source, source)) { return i; }
        i += 1;
    }
    return U64_MAX;
}

fn live(context* ctx, ownership_api.services* svc, address value, request* req)
    ownership_api.proof_status {
    calculation mut work = calculation{ctx, svc, req, complete()};
    if (!spend(&work, 1)) { return work.proof; }
    u64 index = origin_index_work(&work, value.source);
    u64 source = source_index_work(&work, value.source);
    if (!ownership_api.successful(work.proof)) { return work.proof; }
    if (!value.complete || index == U64_MAX || source == U64_MAX) {
        return fail(svc, req, value.source, false, "raw access needs a proved original source");
    }
    if (!spend(&work, 2)) { return work.proof; }
    ownership_api.source_fact fact = ctx->core->sources[source];
    origin original = ctx->origins[index];
    if (fact.kind == ownership_api.source_kind.unknown_fort) {
        return fail(svc, req, value.source, false, "raw access needs a proved original source");
    }
    if (fact.validity == ownership_api.validity_kind.unknown) {
        return fail(svc, req, value.source, false, "raw source validity remains unproved");
    }
    if (fact.validity != ownership_api.validity_kind.live) {
        return fail(svc, req, value.source, true, "raw source is no longer live");
    }
    bool mut inherited = fact.kind == ownership_api.source_kind.trusted_foreign ||
        (value.alignment != 0 && value.alignment <= original.alignment &&
        original.alignment % value.alignment == 0);
    if (inherited && fact.kind != ownership_api.source_kind.trusted_foreign) {
        inherited = le_work(&work, original.begin, value.begin) &&
            le_work(&work, value.begin, value.end) && le_work(&work, value.end, original.end);
    }
    if (!ownership_api.successful(work.proof)) { return work.proof; }
    if (!inherited) {
        return fail(svc, req, value.source, false, "raw address does not inherit its source facts");
    }
    if (!same_key(fact.allocation, original.allocation)) {
        return fail(svc, req, value.source, false, "raw allocation correspondence is missing");
    }
    if (fact.allocation.kind != ownership_api.entity_kind.none) {
        u64 allocation = allocation_index_work(&work, fact.allocation);
        if (!ownership_api.successful(work.proof)) { return work.proof; }
        if (allocation == U64_MAX) {
            return fail(svc, req, fact.allocation, false,
                "raw allocation validity remains unproved");
        }
        if (!spend(&work, 1)) { return work.proof; }
        ownership_api.validity_kind valid = ctx->core->allocations[allocation].validity;
        if (valid == ownership_api.validity_kind.unknown) {
            return fail(svc, req, fact.allocation, false,
                "raw allocation validity remains unproved");
        }
        if (valid != ownership_api.validity_kind.live) {
            return fail(svc, req, fact.allocation, true, "raw allocation is no longer live");
        }
    }
    return complete();
}
fn foreign(context* ctx, address value) bool {
    u64 source = ownership_state.source_index(ctx->core, value.source);
    return source != U64_MAX &&
        ctx->core->sources[source].kind == ownership_api.source_kind.trusted_foreign;
}

fn measure_context_work(calculation mut* work, address@ values, u64 operands,
    u64 mut* price) bool {
    if (!spend(work, 1)) { return false; }
    context* ctx = work->storage;
    // Two output frames and five array allocations precede the copied records.
    u64 mut total = add_work(7, operands);
    term_block* mut block = ctx->terms;
    while (block != null) {
        if (!spend(work, 1)) { return false; }
        block = block->next;
    }
    u64 mut i = 0;
    while (i < ctx->origins.len) {
        if (!spend(work, 1)) { return false; }
        origin item = ctx->origins[i];
        total = add_work(total, add_work(1, place_copy_price(item.place)));
        total = add_work(total, expression_copy_price(item.count));
        total = add_work(total, expression_copy_price(item.begin));
        total = add_work(total, expression_copy_price(item.end));
        i += 1;
    }
    i = 0;
    while (i < ctx->leaves_len) {
        if (!spend(work, 1)) { return false; }
        total = add_work(total, add_work(1, place_copy_price(ctx->leaves[i].place)));
        i += 1;
    }
    i = 0;
    while (i < ctx->bounds.len) {
        if (!spend(work, 1)) { return false; }
        total = add_work(total, 1);
        i += 1;
    }
    i = 0;
    while (i < ctx->relations.len) {
        if (!spend(work, 1)) { return false; }
        relation item = ctx->relations[i];
        total = add_work(total, add_work(1, expression_copy_price(item.left)));
        total = add_work(total, expression_copy_price(item.right));
        i += 1;
    }
    i = 0;
    while (i < values.len) {
        if (!spend(work, 1)) { return false; }
        address item = values[i];
        total = add_work(total, add_work(1, expression_copy_price(item.offset)));
        total = add_work(total, expression_copy_price(item.begin));
        total = add_work(total, expression_copy_price(item.end));
        i += 1;
    }
    // This price pays for copies only. Each later comparison has its own charge.
    *price = total;
    return true;
}
fn bounded_addresses(address@ values, request* req) bool {
    u64 mut i = 0;
    while (i < values.len) {
        if (!bounded_expression(values[i].offset, req) ||
            !bounded_expression(values[i].begin, req) ||
            !bounded_expression(values[i].end, req)) { return false; }
        i += 1;
    }
    return true;
}
fn start(context* ctx, ownership_api.services* svc, address@ values, request* supplied,
    u64 operands) result {
    work_cursor mut cursor = {};
    ownership_api.proof_status prepared = begin_work(ctx->core, svc, supplied, &cursor);
    request* req = &cursor.selected;
    result mut out = result{};
    out.proof = prepared;
    if (!ownership_api.successful(out.proof)) { return out; }
    calculation mut work = calculation{ctx, svc, req, complete()};
    if (!ownership_api.successful(ctx->proof) || values.len == 0 ||
        ownership_state.alternative_units(values.len) > req->limits.g ||
        !validate_addresses_work(&work, values)) {
        if (!ownership_api.successful(work.proof)) { out.proof = work.proof; return out; }
        out.proof = fail(svc, req, ownership_api.entity_id{}, false,
            "raw alternatives need complete exhaustive correspondence");
        return out;
    }
    u64 mut price = 0;
    if (!measure_context_work(&work, values, operands, &price)) {
        out.proof = work.proof;
        return out;
    }
    out.proof = charge(svc, req, ownership_api.limit_category.w, price);
    if (!ownership_api.successful(out.proof)) { return out; }
    out.storage = clone(ctx, ctx->core);
    out.addresses = new(address, values.len);
    u64 mut i = 0;
    while (i < values.len) { out.addresses[i] = copy_address(&out.storage, values[i]); i += 1; }
    return out;
}
fn start_range(context* ctx, ownership_api.services* svc, address@ values,
    expression lower, expression upper, request* supplied) result {
    work_cursor mut cursor = {};
    ownership_api.proof_status prepared = begin_work(ctx->core, svc, supplied, &cursor);
    request* req = &cursor.selected;
    result mut out = result{};
    out.proof = prepared;
    if (!ownership_api.successful(out.proof)) { return out; }
    calculation mut work = calculation{ctx, svc, req, complete()};
    if (lower.terms.len > req->limits.p || upper.terms.len > req->limits.p ||
        !validate_expression_work(&work, lower) || !validate_expression_work(&work, upper)) {
        if (!ownership_api.successful(work.proof)) { out.proof = work.proof; return out; }
        out.proof = fail(svc, req, ownership_api.entity_id{}, false,
            "raw selected bounds are incomplete");
        return out;
    }
    u64 operands = add_work(add_work(2, lower.terms.len), upper.terms.len);
    return start(ctx, svc, values, req, operands);
}
fn discard(result mut* out, ownership_api.proof_status proof) void {
    free_result(out);
    out->proof = proof;
}
fn capture_origins(ownership_state.state* core, ownership_api.services* svc, origin@ inputs,
    captured_bound@ bounds, relation@ relations, request* supplied) result {
    work_cursor mut cursor = {};
    ownership_api.proof_status prepared = begin_work(core, svc, supplied, &cursor);
    request* req = &cursor.selected;
    result mut out = result{};
    out.proof = prepared;
    if (!ownership_api.successful(out.proof)) { return out; }
    if (inputs.len == 0 || inputs.len > types.TYPE_MAX_SIZE / sizeof(origin) ||
        bounds.len > types.TYPE_MAX_SIZE / sizeof(captured_bound) ||
        relations.len > types.TYPE_MAX_SIZE / sizeof(relation)) {
        out.proof = fail(svc, req, ownership_api.entity_id{}, false,
            "raw capture exceeds its limits");
        return out;
    }
    calculation mut work = calculation{&out.storage, svc, req, complete()};
    // The pair of core and context counts its atoms and guarded alternatives together.
    if (!spend(&work, add_work(1, square_work(relations.len)))) {
        out.proof = work.proof;
        return out;
    }
    u64 predicates = add_work(core->predicates_len, captured_predicates(bounds, relations));
    // Each origin gives one address of the result, so the origins are its alternatives.
    u64 alternatives = ownership_state.alternative_units(inputs.len);
    if (alternatives > req->limits.g || predicates > req->limits.p) {
        out.proof = fail(svc, req, ownership_api.entity_id{}, false,
            "raw capture exceeds its limits");
        return out;
    }
    if (predicates > 0) {
        out.proof = charge(svc, req, ownership_api.limit_category.p, predicates);
        if (!ownership_api.successful(out.proof)) { return out; }
    }
    ownership_state.region_measurement guarded = ownership_state.guard_units(core, svc,
        ownership_state.guard_candidate{}, ownership_api.work_kind.transfer,
        req->base.operation, req->base.source_position);
    if (!ownership_api.successful(guarded.proof)) { out.proof = guarded.proof; return out; }
    u64 pair = add_work(guarded.amount, alternatives);
    if (pair > 0) {
        out.proof = charge(svc, req, ownership_api.limit_category.g, pair);
        if (!ownership_api.successful(out.proof)) { return out; }
    }
    if (!spend(&work, 4)) { out.proof = work.proof; return out; }
    out.storage.core = core;
    out.storage.paths = ownership_state.empty();
    out.storage.bounds = new(captured_bound, bounds.len);
    out.storage.relations = new(relation, relations.len);
    out.storage.origins = new(origin, inputs.len);
    out.addresses = new(address, inputs.len);
    u64 mut i = 0;
    while (i < bounds.len) {
        if (!spend(&work, 1)) { discard(&out, work.proof); return out; }
        captured_bound item = bounds[i];
        if (!value_key(item.version) || !less_equal(item.lower, item.upper)) {
            discard(&out, fail(svc, req, item.version, false, "captured value bounds are invalid"));
            return out;
        }
        u64 mut j = 0;
        while (j < i) {
            if (!spend(&work, 1)) { discard(&out, work.proof); return out; }
            if (same_key(bounds[j].version, item.version)) {
                discard(&out, fail(svc, req, item.version, false, "captured value bounds repeat"));
                return out;
            }
            j += 1;
        }
        if (!spend(&work, 1)) { discard(&out, work.proof); return out; }
        out.storage.bounds[i] = item;
        i += 1;
    }
    i = 0;
    while (i < relations.len) {
        if (!spend(&work, 1)) { discard(&out, work.proof); return out; }
        relation item = relations[i];
        bool valid = item.left.terms.len <= req->limits.p &&
            item.right.terms.len <= req->limits.p &&
            validate_expression_work(&work, item.left) &&
            validate_expression_work(&work, item.right);
        if (!ownership_api.successful(work.proof)) { discard(&out, work.proof); return out; }
        if (!valid) {
            discard(&out, fail(svc, req, ownership_api.entity_id{}, false,
                "captured arithmetic relation is incomplete"));
            return out;
        }
        expression left = copy_expression_work(&work, &out.storage, item.left);
        expression right = copy_expression_work(&work, &out.storage, item.right);
        if (!ownership_api.successful(work.proof)) { discard(&out, work.proof); return out; }
        if (!spend(&work, 1)) { discard(&out, work.proof); return out; }
        out.storage.relations[i] = relation{left, right};
        i += 1;
    }
    i = 0;
    while (i < inputs.len) {
        if (!spend(&work, 1)) { discard(&out, work.proof); return out; }
        origin mut item = inputs[i];
        u64 source = source_index_work(&work, item.source);
        if (!ownership_api.successful(work.proof)) { discard(&out, work.proof); return out; }
        if (source != U64_MAX && !spend(&work, 1)) {
            discard(&out, work.proof); return out;
        }
        if (item.source.kind != ownership_api.entity_kind.source || item.source.ordinal == 0 ||
            source == U64_MAX || !item.correspondence || item.residual ||
            item.count.terms.len > req->limits.p || item.begin.terms.len > req->limits.p ||
            item.end.terms.len > req->limits.p || !validate_expression_work(&work, item.count) ||
            !validate_expression_work(&work, item.begin) ||
            !validate_expression_work(&work, item.end) || residual_work(&work, item.place) ||
            item.place.projections.len > req->limits.d ||
            !same_key(item.allocation,
            core->sources[source].allocation) ||
            (item.alignment == 0 &&
            core->sources[source].kind != ownership_api.source_kind.trusted_foreign) ||
            (item.alignment != 0 && (item.alignment & (item.alignment - 1)) != 0)) {
            if (!ownership_api.successful(work.proof)) { discard(&out, work.proof); return out; }
            discard(&out, fail(svc, req, item.source, false,
                "raw source correspondence is incomplete"));
            return out;
        }
        if (!ownership_api.successful(work.proof)) { discard(&out, work.proof); return out; }
        u64 mut j = 0;
        while (j < i) {
            if (!spend(&work, 1)) { discard(&out, work.proof); return out; }
            if (same_key(item.source, inputs[j].source)) {
                discard(&out, fail(svc, req, item.source, false, "raw source capture repeats"));
                return out;
            }
            j += 1;
        }
        item.count = copy_expression_work(&work, &out.storage, item.count);
        item.begin = copy_expression_work(&work, &out.storage, item.begin);
        item.end = copy_expression_work(&work, &out.storage, item.end);
        item.place = copy_place_work(&work, &out.storage, item.place);
        if (!ownership_api.successful(work.proof)) { discard(&out, work.proof); return out; }
        item.first_leaf = out.storage.leaves_len;
        out.proof = layout(&out.storage, svc, req, item.layout, item.place, 0);
        if (!ownership_api.successful(out.proof)) { discard(&out, out.proof); return out; }
        item.leaf_count = out.storage.leaves_len - item.first_leaf;
        if (core->sources[source].kind != ownership_api.source_kind.trusted_foreign) {
            u64 mut stride = 0;
            out.proof = size(item.layout, svc, req, &stride);
            if (!ownership_api.successful(out.proof)) { discard(&out, out.proof); return out; }
            if (!fits_work(&work, item.count) ||
                !same_expression_work(&work, item.begin, literal(0))) {
                if (!ownership_api.successful(work.proof)) {
                    discard(&out, work.proof); return out;
                }
                discard(&out, fail(svc, req, item.source, false,
                    "raw logical extent is incomplete"));
                return out;
            }
            expression extent = scale_work(&work, &out.storage, item.count, stride);
            if (!ownership_api.successful(work.proof)) { discard(&out, work.proof); return out; }
            if (!fits_work(&work, extent) || !same_expression_work(&work, extent, item.end)) {
                if (!ownership_api.successful(work.proof)) {
                    discard(&out, work.proof); return out;
                }
                discard(&out, fail(svc, req, item.source, false,
                    "raw extent arithmetic does not fit"));
                return out;
            }
            if (item.allocation.kind != ownership_api.entity_kind.none) {
                u64 allocation = allocation_index_work(&work, item.allocation);
                if (!ownership_api.successful(work.proof)) {
                    discard(&out, work.proof); return out;
                }
                if (allocation == U64_MAX) {
                    discard(&out, fail(svc, req, item.allocation, false,
                        "raw allocation is missing"));
                    return out;
                }
                if (!spend(&work, 1)) { discard(&out, work.proof); return out; }
                ownership_api.scalar_fact count = core->allocations[allocation].logical_length;
                expression mut expected = literal(0);
                term[1] mut terms = {};
                if (count.kind == ownership_api.fact_kind.exact) {
                    expected.constant = signed(count.value);
                } else if (count.kind == ownership_api.fact_kind.symbolic &&
                    value_key(count.symbol)) {
                    terms[0] = term{count.symbol, natural(1)};
                    expected.terms = terms[..];
                } else { expected.complete = false; }
                if (!same_expression_work(&work, item.count, expected)) {
                    if (!ownership_api.successful(work.proof)) {
                        discard(&out, work.proof); return out;
                    }
                    discard(&out, fail(svc, req, item.allocation, false,
                        "raw extent does not match its captured allocation count"));
                    return out;
                }
            } else if (!same_expression_work(&work, item.count, literal(1))) {
                if (!ownership_api.successful(work.proof)) {
                    discard(&out, work.proof); return out;
                }
                discard(&out, fail(svc, req, item.source, false, "object layout count is not one"));
                return out;
            }
        }
        if (!spend(&work, 2)) { discard(&out, work.proof); return out; }
        out.storage.origins[i] = item;
        out.addresses[i] = address{item.source, item.begin, item.begin, item.end,
            item.layout, item.alignment, true};
        i += 1;
    }
    out.storage.proof = complete();
    out.proof = complete();
    return out;
}

fn capture_origin(ownership_state.state* core, ownership_api.services* svc, origin* input,
    captured_bound@ bounds, relation@ relations, request* supplied) result {
    work_cursor mut cursor = {};
    ownership_api.proof_status mut proof = begin_work(core, svc, supplied, &cursor);
    if (ownership_api.successful(proof)) {
        proof = charge(svc, &cursor.selected, ownership_api.limit_category.w, 1);
    }
    if (!ownership_api.successful(proof)) {
        result mut out = {};
        out.proof = proof;
        return out;
    }
    origin[1] inputs = {*input};
    return capture_origins(core, svc, inputs[..], bounds, relations, &cursor.selected);
}
fn derive_address(context* ctx, ownership_api.services* svc, address@ values,
    expression lower, expression upper, types.node* selected, request* supplied) result {
    work_cursor mut cursor = {};
    ownership_api.proof_status prepared = begin_work(ctx->core, svc, supplied, &cursor);
    request* req = &cursor.selected;
    if (!ownership_api.successful(prepared)) {
        result mut failed = {};
        failed.proof = prepared;
        return failed;
    }
    result mut out = start_range(ctx, svc, values, lower, upper, req);
    if (!ownership_api.successful(out.proof)) { return out; }
    calculation mut work = calculation{ctx, svc, req, complete()};
    u64 mut i = 0;
    while (i < values.len) {
        if (!spend(&work, 1)) { discard(&out, work.proof); return out; }
        address mut item = out.addresses[i];
        out.proof = live(ctx, svc, item, req);
        if (!ownership_api.successful(out.proof)) { discard(&out, out.proof); return out; }
        if (!fits_work(&work, lower) || !fits_work(&work, upper) ||
            !le_work(&work, item.begin, lower) || !le_work(&work, lower, upper) ||
            !le_work(&work, upper, item.end)) {
            if (!ownership_api.successful(work.proof)) { discard(&out, work.proof); return out; }
            discard(&out, fail(svc, req, item.source, false,
                "selected byte window remains unproved"));
            return out;
        }
        item.offset = copy_expression_work(&work, &out.storage, lower);
        item.begin = item.offset;
        item.end = copy_expression_work(&work, &out.storage, upper);
        item.ty = selected;
        if (!spend(&work, 1)) { discard(&out, work.proof); return out; }
        out.addresses[i] = item;
        i += 1;
    }
    return out;
}
fn cast_reference(context* ctx, ownership_api.services* svc, address@ values,
    types.node* from, types.node* to, request* supplied) result {
    work_cursor mut cursor = {};
    ownership_api.proof_status prepared = begin_work(ctx->core, svc, supplied, &cursor);
    request* req = &cursor.selected;
    if (!ownership_api.successful(prepared)) {
        result mut failed = {};
        failed.proof = prepared;
        return failed;
    }
    result mut out = start(ctx, svc, values, req, 0);
    if (!ownership_api.successful(out.proof)) { return out; }
    calculation mut work = calculation{ctx, svc, req, complete()};
    ownership_type_work.work mut paid = ownership_type_work.create(svc,
        ownership_api.work_kind.transfer, req->base.operation, req->base.source_position);
    ownership_type_work.result compared = ownership_type_work.compare(&paid, to, from,
        ownership_type_work.relation.cast_allowed);
    if (!ownership_api.successful(compared.proof)) {
        discard(&out, paid.problem != ownership_type_work.problem_kind.none ?
            fail(svc, req, ownership_api.entity_id{}, false, "reference cast is not permitted") :
            type_failure(svc, req, compared.proof));
        return out;
    }
    if (!compared.value || !types.type_is_reference(from) || !types.type_is_reference(to)) {
        discard(&out, fail(svc, req, ownership_api.entity_id{}, false,
            "reference cast is not permitted"));
        return out;
    }
    u64 mut i = 0;
    while (i < out.addresses.len) {
        if (!spend(&work, 1)) { discard(&out, work.proof); return out; }
        out.addresses[i].ty = to;
        i += 1;
    }
    return out;
}
fn reconstruct_integer(ownership_state.state* core, ownership_api.services* svc, request* supplied)
    result {
    work_cursor mut cursor = {};
    ownership_api.proof_status prepared = begin_work(core, svc, supplied, &cursor);
    request* req = &cursor.selected;
    result mut out = result{};
    out.proof = prepared;
    if (!ownership_api.successful(out.proof)) { return out; }
    out.proof = charge(svc, req, ownership_api.limit_category.w, 2);
    if (!ownership_api.successful(out.proof)) { return out; }
    out.storage.core = core;
    out.storage.paths = ownership_state.empty();
    out.storage.proof = complete();
    out.addresses = new(address, 1);
    // Numeric fields are placeholders. The address still has no source proof.
    out.addresses[0] = address{ownership_api.entity_id{}, literal(0), literal(0), literal(0),
        null, 0, false};
    return out;
}

fn scalar_expression(context mut* ctx, ownership_api.scalar_fact fact) expression {
    expression mut out = literal(0);
    if (fact.kind == ownership_api.fact_kind.exact) {
        out.constant = signed(fact.value);
    } else if (fact.kind == ownership_api.fact_kind.symbolic && value_key(fact.symbol)) {
        term[1] terms = {term{fact.symbol, natural(1)}};
        out.terms = terms[..];
        out = copy_expression(ctx, out);
    } else { out.complete = false; }
    return out;
}
fn scalar_expression_work(calculation mut* work, context mut* target,
    ownership_api.scalar_fact fact) expression {
    expression mut refused = {};
    if (!spend(work, 1)) { return refused; }
    if (fact.kind == ownership_api.fact_kind.symbolic &&
        !spend(work, 6)) { return refused; }
    return scalar_expression(target, fact);
}
fn extract_pointer(context* ctx, ownership_api.services* svc, address@ backing,
    ownership_api.contents_fact* header, request* supplied) result {
    work_cursor mut cursor = {};
    ownership_api.proof_status prepared = begin_work(ctx->core, svc, supplied, &cursor);
    request* req = &cursor.selected;
    if (!ownership_api.successful(prepared)) {
        result mut failed = {};
        failed.proof = prepared;
        return failed;
    }
    result mut out = start(ctx, svc, backing, req, 0);
    if (!ownership_api.successful(out.proof)) { return out; }
    calculation mut work = calculation{ctx, svc, req, complete()};
    if (!spend(&work, 1)) { discard(&out, work.proof); return out; }
    if (header->kind != ownership_api.contents_kind.reference || header->borrows.len != backing.len)
        {
        discard(&out, fail(svc, req, header->place.root, false,
            "header backing correspondence is missing"));
        return out;
    }
    u64 mut i = 0;
    while (i < backing.len) {
        if (!spend(&work, 2)) { discard(&out, work.proof); return out; }
        ownership_api.borrow_relation borrow = header->borrows[i];
        expression offset = scalar_expression_work(&work, &out.storage, borrow.range.offset);
        expression begin = scalar_expression_work(&work, &out.storage, borrow.range.access.begin);
        expression end = scalar_expression_work(&work, &out.storage, borrow.range.access.end);
        if (!ownership_api.successful(work.proof)) { discard(&out, work.proof); return out; }
        if (!borrow.representation_complete || !borrow.range.access.arithmetic_proved ||
            !same_expression_work(&work, offset, backing[i].offset) ||
            !same_expression_work(&work, begin, backing[i].begin) ||
            !same_expression_work(&work, end, backing[i].end) ||
            !same_key(borrow.source, backing[i].source) ||
            !same_key(borrow.value_version, header->value_version)) {
            if (!ownership_api.successful(work.proof)) { discard(&out, work.proof); return out; }
            discard(&out, fail(svc, req, header->place.root, false,
                "header representation is incomplete"));
            return out;
        }
        i += 1;
    }
    return out;
}
fn slice_ptr(context* ctx, ownership_api.services* svc, address@ values,
    expression lower, expression upper, types.node* element, request* supplied) result {
    work_cursor mut cursor = {};
    ownership_api.proof_status prepared = begin_work(ctx->core, svc, supplied, &cursor);
    request* req = &cursor.selected;
    if (!ownership_api.successful(prepared)) {
        result mut failed = {};
        failed.proof = prepared;
        return failed;
    }
    result mut out = start_range(ctx, svc, values, lower, upper, req);
    if (!ownership_api.successful(out.proof)) { return out; }
    u64 mut stride = 0;
    out.proof = size(element, svc, req, &stride);
    if (!ownership_api.successful(out.proof)) { discard(&out, out.proof); return out; }
    calculation mut work = calculation{ctx, svc, req, complete()};
    if (!le_work(&work, literal(0), lower) || !le_work(&work, lower, upper)) {
        if (!ownership_api.successful(work.proof)) { discard(&out, work.proof); return out; }
        discard(&out, fail(svc, req, ownership_api.entity_id{}, false,
            "raw range bounds remain unproved"));
        return out;
    }
    u64 mut i = 0;
    while (i < values.len) {
        if (!spend(&work, 1)) { discard(&out, work.proof); return out; }
        address mut item = out.addresses[i];
        out.proof = live(ctx, svc, item, req);
        if (!ownership_api.successful(out.proof)) { discard(&out, out.proof); return out; }
        expression lo = sum_work(&work, &out.storage, item.offset,
            scale_work(&work, &out.storage, lower, stride));
        expression hi = sum_work(&work, &out.storage, item.offset,
            scale_work(&work, &out.storage, upper, stride));
        if (!ownership_api.successful(work.proof)) { discard(&out, work.proof); return out; }
        bool mut proved = fits_work(&work, lo) && fits_work(&work, hi);
        bool mut trusted = false;
        if (proved) { trusted = foreign_work(&work, item); }
        if (proved && !trusted) {
            proved = le_work(&work, item.begin, lo) && le_work(&work, lo, hi) &&
                le_work(&work, hi, item.end);
        }
        if (!ownership_api.successful(work.proof)) { discard(&out, work.proof); return out; }
        if (!proved) {
            discard(&out, fail(svc, req, item.source, false, "raw range exceeds proved storage"));
            return out;
        }
        item.offset = lo;
        item.begin = lo;
        item.end = hi;
        item.ty = element;
        if (!spend(&work, 1)) { discard(&out, work.proof); return out; }
        out.addresses[i] = item;
        i += 1;
    }
    return out;
}
fn aligned(context* ctx, expression offset, u64 alignment) bool {
    if (!valid_expression(offset) || alignment == 0 || offset.constant.negative ||
        offset.constant.magnitude % alignment != 0) { return false; }
    u64 mut i = 0;
    while (i < offset.terms.len) {
        term item = offset.terms[i];
        if (coefficient(offset, item.version).magnitude % alignment != 0) {
            interval exact = bound(ctx, item.version);
            if (!exact.proved || !same_number(exact.lower, exact.upper) ||
                !multiply(coefficient(offset, item.version), exact.lower).valid ||
                multiply(coefficient(offset, item.version), exact.lower).magnitude % alignment != 0)
                    {
                return false;
            }
        }
        i += 1;
    }
    return true;
}
fn access(context* ctx, ownership_api.services* svc, address@ values,
    types.node* accessed, request* supplied) ownership_api.proof_status {
    work_cursor mut cursor = {};
    ownership_api.proof_status prepared = begin_work(ctx->core, svc, supplied, &cursor);
    request* req = &cursor.selected;
    ownership_api.proof_status mut proof = prepared;
    if (!ownership_api.successful(proof)) { return proof; }
    calculation mut work = calculation{ctx, svc, req, complete()};
    if (!ownership_api.successful(ctx->proof) || values.len == 0 ||
        ownership_state.alternative_units(values.len) > req->limits.g ||
        !validate_addresses_work(&work, values)) {
        if (!ownership_api.successful(work.proof)) { return work.proof; }
        return fail(svc, req, ownership_api.entity_id{}, false, "raw alternatives are incomplete");
    }
    u64 mut bytes = 0;
    proof = size(accessed, svc, req, &bytes);
    if (!ownership_api.successful(proof)) { return proof; }
    context mut scratch = context{};
    defer free(&scratch);
    u64 mut i = 0;
    while (i < values.len) {
        if (!spend(&work, 1)) { return work.proof; }
        address item = values[i];
        proof = live(ctx, svc, item, req);
        if (!ownership_api.successful(proof)) { return proof; }
        bool trusted = foreign_work(&work, item);
        if (!ownership_api.successful(work.proof)) { return work.proof; }
        expression end = sum_work(&work, &scratch, item.offset, literal(bytes));
        if (!fits_work(&work, item.offset) || !fits_work(&work, end)) {
            if (!ownership_api.successful(work.proof)) { return work.proof; }
            return fail(svc, req, item.source, false,
                "typed access arithmetic does not fit the address representation");
        }
        if (!ownership_api.successful(work.proof)) { return work.proof; }
        if (!trusted) {
            if (!le_work(&work, item.begin, item.offset) || !le_work(&work, end, item.end)) {
                if (!ownership_api.successful(work.proof)) { return work.proof; }
                return fail(svc, req, item.source, false,
                    "typed access exceeds its inherited window");
            }
            if (!ownership_api.successful(work.proof)) { return work.proof; }
            u64 mut alignment = 0;
            if (!alignment_work(&work, accessed, &alignment)) { return work.proof; }
            if (item.alignment < alignment || item.alignment % alignment != 0 ||
                !aligned_work(&work, item.offset, alignment)) {
                if (!ownership_api.successful(work.proof)) { return work.proof; }
                return fail(svc, req, item.source, false,
                    "typed access alignment remains unproved");
            }
        }
        i += 1;
    }
    return complete();
}
fn inspect_empty_header(ownership_state.state* core, ownership_api.services* svc,
    ownership_api.contents_fact* header, bool canonical_null, request* supplied)
    ownership_api.proof_status {
    work_cursor mut cursor = {};
    ownership_api.proof_status prepared = begin_work(core, svc, supplied, &cursor);
    request* req = &cursor.selected;
    ownership_api.proof_status mut proof = prepared;
    if (!ownership_api.successful(proof)) { return proof; }
    proof = charge(svc, req, ownership_api.limit_category.w, 1);
    if (!ownership_api.successful(proof)) { return proof; }
    if (canonical_null && header->span_length.kind == ownership_api.fact_kind.exact &&
        header->span_length.value == 0 && header->borrows.len == 0 &&
        (header->kind == ownership_api.contents_kind.reference ||
        header->kind == ownership_api.contents_kind.empty_owner)) { return complete(); }
    u64 per_borrow = add_work(core->sources_len, 2);
    u64 count = header->borrows.len;
    u64 price = count > 0 && per_borrow > U64_MAX / count ? U64_MAX : count * per_borrow;
    proof = charge(svc, req, ownership_api.limit_category.w, add_work(price, 3));
    if (!ownership_api.successful(proof)) { return proof; }
    return ownership_transfer.check_read(core, svc, &req->base, *header, false);
}
