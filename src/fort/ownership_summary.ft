/// Infers ordered linear summaries from checked and verified fort bodies.
import fir;
import ownership_api;
import ownership_calls;
import ownership_flow;
import ownership_join;
import ownership_keys;
import ownership_state;
import ownership_summary_body;
import ownership_summary_model;
import ownership_transfer;
import types;

// The observer copies each view before flow releases its working path.
struct exit_snapshot {
    ownership_state.state facts;
    ownership_api.outcome_fact outcome;
    ownership_api.operation_position operation;
    ownership_api.source_position source;
    exit_snapshot mut* own next;
}

struct exits {
    exit_snapshot mut* own first;
    u64 count;
    ownership_summary_model.context context;
    ownership_api.proof_status proof;
    // The exits and the call exports continue one E count of the body program.
    u64 mut* relations;
}

fn copy_state(ownership_api.state_view* input, ownership_summary_model.context* ctx,
    ownership_api.proof_status mut* proof) ownership_state.state {
    ownership_state.state mut out = ownership_state.empty();
    out.proof = input->proof;
    u64 mut i = 0;
    while (i < input->contents.len) {
        if (!ownership_summary_model.contents_charge(ctx, proof, input->contents[i])) {
            out.proof = *proof;
            return out;
        }
        ownership_state.append_contents(&out, input->contents[i]);
        i += 1;
    }
    i = 0;
    while (i < input->sources.len) {
        if (!ownership_summary_model.work(ctx, proof, 1)) { out.proof = *proof; return out; }
        ownership_state.append_sources(&out, input->sources[i]);
        i += 1;
    }
    i = 0;
    while (i < input->allocations.len) {
        ownership_api.allocation_fact item = input->allocations[i];
        if (!ownership_summary_model.path_charge(ctx, proof, item.owner.place) ||
            !ownership_summary_model.work(ctx, proof, 2) ||
            !ownership_summary_model.work(ctx, proof, item.history.len)) {
            out.proof = *proof;
            return out;
        }
        u64 mut h = 0;
        while (h < item.history.len) {
            if (!ownership_summary_model.work(ctx, proof, 1) ||
                !ownership_summary_model.path_charge(ctx, proof, item.history[h].before.place) ||
                !ownership_summary_model.path_charge(ctx, proof, item.history[h].after.place)) {
                out.proof = *proof; return out;
            }
            h += 1;
        }
        ownership_state.append_allocations(&out, item);
        i += 1;
    }
    // Value atoms record the guard of a path. The extractor creates no projected, guarded,
    // shape, or heap-graph records.
    i = 0;
    while (i < input->predicates.len) {
        if (!ownership_summary_model.work(ctx, proof, 1)) { out.proof = *proof; return out; }
        ownership_state.append_predicates(&out, input->predicates[i]);
        i += 1;
    }
    if (input->regions.len != 0 || input->nodes.len != 0 || input->edges.len != 0 ||
        input->shapes.len != 0 || input->guards.len != 0 ||
        input->correlations.len != 0 || input->losses.len != 0) {
        *proof = ownership_summary_model.fail(ctx,
            ownership_api.incomplete_reason.unknown_effect, ctx->event);
        out.proof = *proof;
    }
    return out;
}

fn observe(void mut* opaque, ownership_api.state_view* facts,
    ownership_api.outcome_fact outcome, ownership_api.operation_position operation,
    ownership_api.source_position source) ownership_api.proof_status {
    exits mut* out = cast(opaque, exits mut*);
    out->context.operation = operation;
    out->context.source = source;
    if (out->relations == null && ownership_api.successful(out->proof)) {
        out->proof = ownership_summary_model.fail(&out->context,
            ownership_api.incomplete_reason.invalid_input, out->context.event);
    }
    if (!ownership_summary_model.work(&out->context, &out->proof, 1) ||
        !ownership_summary_model.effect_charge(&out->context, &out->proof, out->relations) ||
        out->count == ownership_api.U64_MAX) { return out->proof; }
    exit_snapshot mut* own snapshot = new(exit_snapshot);
    snapshot->facts = copy_state(facts, &out->context, &out->proof);
    snapshot->outcome = outcome;
    snapshot->operation = operation;
    snapshot->source = source;
    snapshot->next = move(out->first);
    out->first = move(snapshot);
    out->count += 1;
    return out->proof;
}

fn free_exits(exits mut* out) void {
    while (out->first != null) {
        exit_snapshot mut* own item = move(out->first);
        out->first = move(item->next);
        ownership_state.free(&item->facts);
        del(item);
    }
    *out = exits{};
}

// The watch sees each charge of one inference. It keeps the first refused charge, so a call
// cannot turn that refusal into another reason (`spec/fir.md` 14.1).
struct budget_watch {
    ownership_api.services* inner;
    bool refused;
    ownership_api.charge_result refusal;
    ownership_api.operation_position operation;
    ownership_api.source_position source;
}

fn watched_charge(void mut* opaque, ownership_api.charge_request* req)
    ownership_api.charge_result {
    budget_watch mut* watch = cast(opaque, budget_watch mut*);
    ownership_api.charge_result result = ownership_api.charge(watch->inner, req);
    if (!result.allowed && !watch->refused) {
        watch->refused = true;
        watch->refusal = result;
        watch->operation = req->operation;
        watch->source = req->source;
    }
    return result;
}

// The call handler borrows the inference input. It owns nothing past one call.
struct call_context {
    ownership_summary_body.body_input* in;
    ownership_summary_body.body_program mut* program;
    exits mut* observations;
    budget_watch* watch;
}

// One call request borrows these arrays. `unknown` names a fact that the state lacks.
struct call_bindings {
    ownership_api.alias_binding mut@ own aliases;
    ownership_calls.source_binding mut@ own sources;
    ownership_calls.allocation_binding mut@ own allocations;
    ownership_calls.capture_binding mut@ own captures;
    u64 aliases_len;
    u64 sources_len;
    u64 allocations_len;
    u64 captures_len;
    ownership_calls.event_binding[1] events;
    bool unknown;
}

fn free_bindings(call_bindings mut* out) void {
    call_bindings mut owned = move(*out);
    del(owned.aliases);
    del(owned.sources);
    del(owned.allocations);
    del(owned.captures);
    *out = call_bindings{};
}

fn call_work(call_context* c, u64 n) bool {
    return ownership_summary_body.work(c->program, n);
}

// A pointer output names the storage that the argument designates, not the argument slot.
// The binding names a whole root only. An argument such as `&t->b` designates a field inside
// that root, and its type differs from the root type, so that binding stays unknown.
fn designated_storage(call_context* c, ownership_api.entity_id source, types.node* pointee)
    ownership_api.place_path {
    u64 mut r = 0;
    while (r < c->program->roots_len) {
        if (!call_work(c, 1)) { break; }
        ownership_summary_model.symbolic_root root = c->program->roots[r];
        if ((root.kind == ownership_summary_model.root_kind.by_value_slot ||
            root.kind == ownership_summary_model.root_kind.caller_source) &&
            ownership_summary_model.same(root.source, source)) {
            types.node* whole = root.kind == ownership_summary_model.root_kind.caller_source ?
                (root.ty == null ? null : root.ty->elem) : root.ty;
            if (whole == null || pointee == null || !types.type_equal(whole, pointee)) {
                return ownership_api.place_path{.residual = true};
            }
            return ownership_api.place_path{.root = root.slot};
        }
        r += 1;
    }
    return ownership_api.place_path{.residual = true};
}

// Binds each callee root to the current facts of this path. Formal identity proves nothing:
// two formals bound to one source keep one source and one allocation (D17.15).
fn bind_call(call_context* c, ownership_summary_body.call_site site,
    ownership_summary_body.call_target target, ownership_summary_model.summary_view* summary,
    fir.statement* call, ownership_state.state* facts, call_bindings mut* out) bool {
    u64 count = summary->roots.len;
    if (count > types.TYPE_MAX_SIZE / sizeof(ownership_calls.source_binding) ||
        !call_work(c, count)) { return false; }
    out->aliases = new(ownership_api.alias_binding, count);
    out->sources = new(ownership_calls.source_binding, count);
    out->allocations = new(ownership_calls.allocation_binding, count);
    out->captures = new(ownership_calls.capture_binding, count);
    fir.func* f = c->in->function.body;
    u32 mut template = 0;
    u64 mut i = 0;
    while (i < count) {
        if (!call_work(c, 4)) { return false; }
        ownership_summary_model.symbolic_root row = summary->roots[i];
        if (row.kind == ownership_summary_model.root_kind.caller_source) {
            if (row.formal == 0 || row.formal > call->value.ops_len) {
                out->unknown = true;
                return true;
            }
            fir.operand argument = fir.rvalue_operand(f, call->value, row.formal - 1);
            if (argument.kind == fir.operand_kind.ok_const ||
                !ownership_summary_body.direct(argument.place)) {
                out->unknown = true;
                return true;
            }
            u64 at = ownership_transfer.contents_index(facts,
                ownership_summary_body.slot(c->in, argument.place.local));
            if (!call_work(c, facts->contents_len) || at == ownership_api.U64_MAX ||
                facts->contents[at].borrows.len != 1) {
                out->unknown = true;
                return true;
            }
            ownership_api.contents_fact input = facts->contents[at];
            u64 source = ownership_state.source_index(facts, input.borrows[0].source);
            if (!call_work(c, facts->sources_len) || source == ownership_api.U64_MAX) {
                out->unknown = true;
                return true;
            }
            // A residual output binding keeps the call unknown: the application refuses it.
            ownership_api.place_path actual = ownership_calls.output_root(summary, row.slot) ?
                designated_storage(c, input.borrows[0].source,
                    row.ty == null ? null : row.ty->elem) : input.place;
            out->aliases[out->aliases_len] = ownership_api.alias_binding{row.slot, actual,
                input.value_version};
            out->aliases_len += 1;
            out->sources[out->sources_len] = ownership_calls.source_binding{row.source,
                facts->sources[source], input.borrows[0].range, input.value_version,
                ownership_api.entity_id{row.source.function, ownership_api.entity_kind.region,
                    row.source.ordinal}};
            out->sources_len += 1;
            out->captures[out->captures_len] = ownership_calls.capture_binding{
                ownership_api.entity_id{row.source.function, ownership_api.entity_kind.value,
                    row.formal + 1}, input.value_version, input.span_length};
            out->captures_len += 1;
            if (row.allocation.kind != ownership_api.entity_kind.none) {
                u64 owner = ownership_transfer.owner_index(facts, input.place);
                if (!call_work(c, facts->allocations_len) || owner == ownership_api.U64_MAX ||
                    argument.kind != fir.operand_kind.ok_move) {
                    out->unknown = true;
                    return true;
                }
                out->allocations[out->allocations_len] = ownership_calls.allocation_binding{
                    row.allocation, facts->allocations[owner], false};
                out->allocations_len += 1;
            }
        } else if (row.kind == ownership_summary_model.root_kind.allocation_template) {
            if (template >= target.fresh_count) {
                out->unknown = true;
                return true;
            }
            ownership_api.entity_id key = ownership_api.entity_id{c->in->function.key,
                ownership_api.entity_kind.allocation, target.fresh_first + template};
            out->allocations[out->allocations_len] = ownership_calls.allocation_binding{
                row.allocation, ownership_api.allocation_fact{.key = key,
                    .validity = ownership_api.validity_kind.live,
                    .count = ownership_api.multiplicity{false, true, false},
                    .obligation = true}, true};
            out->allocations_len += 1;
            template += 1;
        } else if (row.kind == ownership_summary_model.root_kind.global) {
            out->unknown = true;
            return true;
        } else if (ownership_calls.scalar_formal(row, cast(site.args_len, u64))) {
            // A scalar formal is a capture. Its value decides the guards of callee cases.
            ownership_api.scalar_fact value = c->program->call_args[site.args_first +
                cast(row.formal - 1, u64)];
            if (value.kind == ownership_api.fact_kind.exact ||
                value.kind == ownership_api.fact_kind.symbolic) {
                out->captures[out->captures_len] = ownership_calls.capture_binding{
                    ownership_calls.formal_value(row), value.symbol, value};
                out->captures_len += 1;
            }
        }
        i += 1;
    }
    return true;
}

// Extraction appends the call sites in block and gap order, so a binary search finds one in
// O(log n) W units.
fn call_site_at(call_context* c, ownership_flow.step* s) u64 {
    u64 mut low = 0;
    u64 mut high = c->program->calls_len;
    while (low < high) {
        if (!call_work(c, 1)) { return ownership_api.U64_MAX; }
        u64 middle = low + (high - low) / 2;
        ownership_summary_body.call_site site = c->program->calls[middle];
        if (site.block == s->block && site.gap == s->gap) { return middle; }
        if (site.block < s->block || (site.block == s->block && site.gap < s->gap)) {
            low = middle + 1;
        } else { high = middle; }
    }
    return ownership_api.U64_MAX;
}

fn caller_root(call_context* c, ownership_api.entity_id source) u64 {
    u64 mut r = 0;
    while (r < c->program->roots_len) {
        if (!call_work(c, 1)) { return ownership_api.U64_MAX; }
        ownership_summary_model.symbolic_root root = c->program->roots[r];
        if (root.kind == ownership_summary_model.root_kind.caller_source &&
            ownership_summary_model.same(root.source, source)) { return r; }
        r += 1;
    }
    return ownership_api.U64_MAX;
}

// A loaded root names a reference that this body loaded from caller storage. A callee
// requirement on its source has no formal of this body, so no caller can check it here.
fn loaded_root(call_context* c, ownership_api.entity_id source) bool {
    u64 mut r = 0;
    while (r < c->program->roots_len) {
        if (!call_work(c, 1)) { return true; }
        ownership_summary_model.symbolic_root root = c->program->roots[r];
        if (root.kind == ownership_summary_model.root_kind.loaded_source &&
            ownership_summary_model.same(root.source, source)) { return true; }
        r += 1;
    }
    return false;
}

// A caller-visible place is designated caller storage of this body.
fn caller_visible(call_context* c, ownership_api.place_path place,
    ownership_api.entity_id allocation) bool {
    u64 mut r = 0;
    while (r < c->program->roots_len) {
        if (!call_work(c, 1)) { return true; }
        ownership_summary_model.symbolic_root root = c->program->roots[r];
        if ((root.kind == ownership_summary_model.root_kind.caller_source ||
            root.kind == ownership_summary_model.root_kind.loaded_source) &&
            (ownership_summary_model.same(root.slot, place.root) ||
            (allocation.kind != ownership_api.entity_kind.none &&
                ownership_summary_model.same(root.allocation, allocation)))) { return true; }
        r += 1;
    }
    return false;
}

// A callee copy of one of its parameters into caller storage becomes a copy from the argument
// local of this body (D17.14). Callers replay it into their own storage. Any other callee
// store into caller storage stays unexported.
fn export_store(call_context* c, fir.statement* call, ownership_flow.step* s,
    ownership_summary_model.summary* bound, ownership_summary_model.effect_node node) bool {
    if (node.payload != ownership_summary_model.payload_kind.copy ||
        node.operand.projections.len != 0 ||
        caller_visible(c, node.operand, ownership_api.entity_id{}) ||
        !caller_visible(c, node.effect.place, ownership_api.entity_id{})) { return false; }
    u64 mut r = 0;
    while (r < bound->roots.len) {
        if (!call_work(c, 1)) { return false; }
        ownership_summary_model.symbolic_root root = bound->roots[r];
        if (root.kind == ownership_summary_model.root_kind.by_value_slot &&
            ownership_summary_model.same(root.slot, node.operand.root) && root.formal > 0 &&
            root.formal <= call->value.ops_len) {
            fir.operand argument = fir.rvalue_operand(c->in->function.body, call->value,
                root.formal - 1);
            if (argument.kind != fir.operand_kind.ok_copy ||
                !ownership_summary_body.direct(argument.place)) { return false; }
            ownership_api.place_path held = ownership_summary_body.slot(c->in,
                argument.place.local);
            ownership_summary_body.export_effect(c->in, c->program,
                ownership_summary_model.effect_node{
                    .effect = ownership_api.ordered_effect{.kind = ownership_api.effect_kind.write,
                        .operation = s->operation, .place = node.effect.place,
                        .source = node.effect.source},
                    .payload = ownership_summary_model.payload_kind.copy, .operand = held},
                s->source, call->loc.file);
            return ownership_api.successful(c->program->proof);
        }
        r += 1;
    }
    return false;
}

fn listed(ownership_api.entity_id@ keys, ownership_api.entity_id key) bool {
    u64 mut i = 0;
    while (i < keys.len) {
        if (ownership_summary_model.same(keys[i], key)) { return true; }
        i += 1;
    }
    return false;
}

// The normal continuations of one call. The first is kept; each later one widens it.
// A store export attaches to each exit after the call, so it cannot name one case. The
// store list of each applied case must be a prefix of `stores`, and each normal case must
// export all of it. Any other export keeps the summary incomplete (D17.14, D17.18).
struct continuation {
    ownership_state.state facts;
    u64 normals;
    ownership_api.entity_id mut@ own stores;
    u64 stores_len;
    // The store count of each normal case, or U64_MAX before the first normal case.
    u64 normal_stores;
}

// Exports the callee requirements and the call result of this body (D17.14, D17.17).
// Any other caller-visible callee effect keeps the published summary incomplete. So does a
// store that not each applied case of the call does, as `continuation` says.
// A call of several targets exports nothing: an exported requirement or effect would bind
// each caller to one target, and a target of several is not a witness (`spec/fir.md` 14.1).
fn export_call(call_context* c, ownership_summary_body.call_site site, fir.statement* call,
    ownership_flow.step* s, ownership_calls.application* applied, u64 index, bool definite,
    continuation mut* kept) bool {
    ownership_summary_body.body_program mut* program = c->program;
    ownership_summary_model.summary* bound = &applied->bound.model;
    // Only the applied case runs. A requirement or effect after its abort is not exported.
    ownership_summary_model.case_record applied_case = bound->cases[index];
    u64 mut i = 0;
    while (i < bound->requirements.len) {
        if (!call_work(c, 2) || !call_work(c, applied_case.requirements.len)) { return false; }
        ownership_summary_model.requirement row = bound->requirements[i];
        if (!listed(applied_case.requirements, row.key)) {
            i += 1;
            continue;
        }
        u64 root = caller_root(c, row.source);
        if (!ownership_api.successful(program->proof)) { return false; }
        bool readable = row.kind == ownership_summary_model.requirement_kind.live_source ||
            row.kind == ownership_summary_model.requirement_kind.extent;
        if (root != ownership_api.U64_MAX && readable &&
            row.guard.kind == ownership_api.entity_kind.none && !definite) {
            program->call_residual = true;
        } else if (root != ownership_api.U64_MAX && readable &&
            row.guard.kind == ownership_api.entity_kind.none) {
            ownership_summary_model.symbolic_root formal = program->roots[root];
            ownership_summary_body.export_requirement(c->in, program, row,
                ownership_summary_body.slot(c->in, formal.formal), s->operation,
                s->source, call->loc.file);
        } else if (root != ownership_api.U64_MAX || loaded_root(c, row.source) ||
            caller_visible(c, row.path, ownership_api.entity_id{})) {
            program->call_residual = true;
        }
        if (!ownership_api.successful(program->proof)) { return false; }
        i += 1;
    }
    // `n` counts the caller-visible stores of this case. A store that an earlier case of
    // this call exported at the same index is not exported again.
    u64 mut n = 0;
    i = 0;
    while (i < bound->effects.len) {
        if (!call_work(c, 2) || !call_work(c, applied_case.effects.len)) { return false; }
        ownership_summary_model.effect_node node = bound->effects[i];
        if (listed(applied_case.effects, node.effect.key) &&
            node.payload != ownership_summary_model.payload_kind.read &&
            (caller_visible(c, node.effect.place, node.effect.allocation) ||
            caller_visible(c, node.operand, ownership_api.entity_id{}))) {
            if (!definite) {
                program->call_residual = true;
            } else if (n < kept->stores_len) {
                if (!ownership_summary_model.same(kept->stores[n], node.effect.key)) {
                    program->call_residual = true;
                }
            } else {
                kept->stores[n] = node.effect.key;
                kept->stores_len = n + 1;
                if (!export_store(c, call, s, bound, node)) { program->call_residual = true; }
            }
            n += 1;
        }
        if (!ownership_api.successful(program->proof)) { return false; }
        i += 1;
    }
    if (applied_case.outcome.kind == ownership_api.outcome_kind.function_return) {
        if (kept->normal_stores == ownership_api.U64_MAX) { kept->normal_stores = n; }
        else if (kept->normal_stores != n) { program->call_residual = true; }
    }
    u32 mut op = 0;
    while (op < call->value.ops_len) {
        if (!call_work(c, 1)) { return false; }
        fir.operand argument = fir.rvalue_operand(c->in->function.body, call->value, op);
        if (argument.kind == fir.operand_kind.ok_move &&
            fir.local_at(c->in->function.body, argument.place.local)->ty->is_own) {
            program->call_residual = true;
        }
        op += 1;
    }
    return ownership_api.successful(program->proof);
}

// One borrow of two joined result rows names one source, place, and window. Only its key and
// its value version can differ.
fn same_window(ownership_api.borrow_relation a, ownership_api.borrow_relation b) bool {
    return ownership_summary_model.same(a.source, b.source) &&
        ownership_state.same_place(a.containing, b.containing) &&
        a.representation_complete == b.representation_complete &&
        ownership_state.same_region(a.range, b.range);
}

fn same_value(ownership_api.contents_fact a, ownership_api.contents_fact b) bool {
    if (a.kind != b.kind || !ownership_state.same_scalar(a.span_length, b.span_length) ||
        a.owner_empty != b.owner_empty || a.borrows.len != b.borrows.len) { return false; }
    u64 mut i = 0;
    while (i < a.borrows.len) {
        if (!same_window(a.borrows[i], b.borrows[i])) { return false; }
        i += 1;
    }
    return true;
}

// Joined normal cases leave one row of the call result for each case. When the rows write
// one value, the first row stands for each of them, so the result has one value (D17.18).
// Rows of different values stay, and the result keeps no unique value.
fn collapse_result(call_context* c, fir.statement* call, ownership_state.state mut* facts)
    bool {
    ownership_api.place_path destination = ownership_summary_body.slot(c->in,
        call->place.local);
    u64 mut first = ownership_api.U64_MAX;
    u64 mut i = 0;
    while (i < facts->contents_len) {
        if (!call_work(c, 1)) { return false; }
        if (ownership_state.same_place(facts->contents[i].place, destination)) {
            if (first == ownership_api.U64_MAX) { first = i; }
            else if (!same_value(facts->contents[first], facts->contents[i])) { return true; }
        }
        i += 1;
    }
    u64 mut kept = 0;
    i = 0;
    while (i < facts->contents_len) {
        if (i == first || !ownership_state.same_place(facts->contents[i].place, destination)) {
            facts->contents[kept] = facts->contents[i];
            kept += 1;
        }
        i += 1;
    }
    facts->contents_len = kept;
    return true;
}

// The call result becomes one write of its value in the one normal continuation. A result
// without one value at the destination cannot be exported, so the summary stays incomplete.
fn export_call_result(call_context* c, fir.statement* call, ownership_flow.step* s,
    ownership_state.state* continuation) bool {
    ownership_summary_body.body_program mut* program = c->program;
    types.node* result = fir.local_at(c->in->function.body, call->place.local)->ty;
    if (!ownership_summary_body.reference(result)) { return true; }
    ownership_api.place_path destination = ownership_summary_body.slot(c->in,
        call->place.local);
    if (!call_work(c, continuation->contents_len)) { return false; }
    u64 at = ownership_transfer.contents_index(continuation, destination);
    if (at == ownership_api.U64_MAX) {
        program->call_residual = true;
        return true;
    }
    ownership_api.contents_fact value = continuation->contents[at];
    u64 mut b = 0;
    while (b < value.borrows.len) {
        if (!call_work(c, 1)) { return false; }
        if (caller_root(c, value.borrows[b].source) == ownership_api.U64_MAX) {
            program->call_residual = true;
            return ownership_api.successful(program->proof);
        }
        b += 1;
    }
    ownership_summary_body.export_result(c->in, program, destination, value, s->operation,
        s->source, call->loc.file);
    return ownership_api.successful(program->proof);
}

// An unresolved call writes an unknown value to its destination. No stale fact survives.
fn unresolved_call(call_context* c, fir.statement* call, ownership_state.state mut* facts)
    ownership_flow.call_verdict {
    c->program->call_residual = true;
    ownership_flow.call_verdict mut verdict = ownership_flow.call_verdict{
        .proof = ownership_summary_model.complete(), .unknown = true};
    ownership_api.place_path destination = ownership_summary_body.slot(c->in,
        call->place.local);
    if (!call_work(c, facts->contents_len + 1)) {
        verdict.proof = c->program->proof;
        return verdict;
    }
    ownership_api.contents_fact unknown = ownership_api.contents_fact{.place = destination,
        .kind = ownership_api.contents_kind.unknown};
    u64 at = ownership_transfer.contents_index(facts, destination);
    if (at == ownership_api.U64_MAX) { ownership_state.append_contents(facts, unknown); }
    else { facts->contents[at] = unknown; }
    return verdict;
}

// The atoms that a case guard added to the state, which the caller state did not hold.
fn strip_atoms(call_context* c, ownership_state.state mut* facts,
    ownership_api.state_view* before) bool {
    u64 mut kept = 0;
    u64 mut i = 0;
    while (i < facts->predicates_len) {
        bool mut held = false;
        u64 mut j = 0;
        while (!held && j < before->predicates.len) {
            if (!call_work(c, 1)) { return false; }
            held = ownership_state.same_predicate(facts->predicates[i], before->predicates[j]);
            j += 1;
        }
        if (held) {
            facts->predicates[kept] = facts->predicates[i];
            kept += 1;
        }
        i += 1;
    }
    facts->predicates_len = kept;
    return true;
}

// Applies one possible case. An abort records its exit. A normal return joins the
// continuation. `stop` names a verdict that ends the path. A case of one target of several
// is a possibility: a failed application keeps the call unresolved. `strip` removes the case
// atoms from a normal continuation when the normal cases of the target cover each captured
// value: their join then holds for each value, with no atom to lose (D17.18).
fn apply_one(call_context* c, ownership_summary_body.call_site site, fir.statement* call,
    ownership_flow.step* s, ownership_calls.request* req, u64 index, bool definite,
    bool strip, continuation mut* kept, ownership_flow.call_verdict mut* verdict) bool {
    ownership_calls.application mut applied = ownership_calls.apply_case(req, index);
    defer ownership_calls.free(&applied);
    // A refused charge stops this computation, whatever reason the application reports.
    if (c->watch != null && c->watch->refused) {
        verdict->proof = c->watch->refusal.proof;
        return false;
    }
    if (!ownership_api.successful(applied.proof)) {
        bool limit = applied.proof.terminal.reason == ownership_api.incomplete_reason.work_limit ||
            applied.proof.terminal.reason == ownership_api.incomplete_reason.report_limit;
        if ((applied.proof.kind == ownership_api.proof_kind.incomplete && !limit) ||
            (!definite && applied.proof.kind != ownership_api.proof_kind.incomplete)) {
            verdict->unknown = true;
            return false;
        }
        verdict->proof = applied.proof;
        return false;
    }
    if (!export_call(c, site, call, s, &applied, index, definite, kept)) {
        verdict->proof = c->program->proof;
        return false;
    }
    if (!applied.normal_continuation) {
        if (applied.outcome.kind != ownership_api.outcome_kind.abort) {
            verdict->unknown = true;
            return false;
        }
        ownership_api.state_view ended = ownership_state.view(&applied.state);
        verdict->proof = observe(cast(c->observations, void mut*), &ended, applied.outcome,
            s->operation, s->source);
        return ownership_api.successful(verdict->proof);
    }
    if (strip && !strip_atoms(c, &applied.state, &req->before)) {
        verdict->proof = c->program->proof;
        return false;
    }
    if (kept->normals == 0) {
        kept->facts = move(applied.state);
    } else {
        if (!call_work(c, 1)) {
            verdict->proof = c->program->proof;
            return false;
        }
        // A failed join of the cases takes the update key of the call, not a body key.
        ownership_summary_model.update_route mut route = ownership_summary_model.update_route{};
        ownership_api.services keyed = ownership_summary_model.update_services(&route,
            c->in->services, site.event);
        ownership_state.state mut joined = ownership_join.widen(&kept->facts, &applied.state,
            &keyed, &c->in->limits, s->operation, s->source);
        ownership_state.free(&kept->facts);
        kept->facts = move(joined);
        if (!ownership_api.successful(kept->facts.proof)) {
            verdict->proof = kept->facts.proof;
            return false;
        }
    }
    kept->normals += 1;
    return true;
}

// A target of several is a possibility and not a witness (`spec/fir.md` 14.1). The event
// service of its application turns each definite event into incomplete proof with
// abstract-possibility evidence, so no caller error names one possible target.
struct possibility {
    ownership_api.services* inner;
}

fn possible_event(void mut* opaque, ownership_api.event_request* req)
    ownership_api.event_result {
    possibility mut* wrap = cast(opaque, possibility mut*);
    ownership_api.event_request mut changed = *req;
    if (changed.event.kind != ownership_api.event_kind.incomplete_proof &&
        changed.event.kind != ownership_api.event_kind.work_failure) {
        changed.event.kind = ownership_api.event_kind.incomplete_proof;
        changed.event.evidence = ownership_api.evidence_kind.abstract_possibility;
        changed.event.reason = ownership_api.incomplete_reason.missing_path;
    }
    if (changed.current.kind != ownership_api.proof_kind.incomplete && changed.current.failed) {
        changed.current = ownership_api.incomplete(ownership_api.incomplete_reason.missing_path,
            changed.event.operation, changed.event.source);
        changed.current.terminal.relation = changed.event.relation;
    }
    return ownership_api.record_event(wrap->inner, &changed);
}

// The instance of the callee frame of a call of a body to itself.
u32 FRAME_INSTANCE = 4294967295;

// One fort target of a call: its bindings, its request, and its possible cases. A call of the
// body to itself owns a renamed copy of the summary.
struct target_plan {
    ownership_summary_model.summary renamed;
    ownership_summary_model.summary_view frame;
    call_bindings bindings;
    ownership_calls.request req;
    ownership_summary_model.context guard;
    // A provisional target without a possible case. It adds nothing in this round.
    bool vacuous;
    // A possible case of the target returns normally.
    bool returns;
    // The possible normal cases of the target cover each captured value.
    bool strip;
}

fn free_plans(target_plan mut@ plans) void {
    u64 mut i = 0;
    while (i < plans.len) {
        free_bindings(&plans[i].bindings);
        ownership_summary_model.free(&plans[i].renamed);
        i += 1;
    }
}

enum plan_result { ready, unresolved, stop }

// A provisional summary at bottom has no case and no residual effect (D17.18).
fn bottom(ownership_summary_model.summary_view* summary) bool {
    return ownership_api.successful(summary->proof) && !summary->residual_effects &&
        summary->cases.len == 0;
}

// The first provisional call without covering cases names the position of the refusal.
fn mark_uncovered(call_context* c, ownership_flow.step* s) void {
    if (c->program->uncovered) { return; }
    c->program->uncovered = true;
    c->program->uncovered_operation = s->operation;
    c->program->uncovered_source = s->source;
}

// Binds one target and decides each guard of its cases before any case runs. No caller value
// decides an unbound guard, so the call stays unresolved. A provisional target without a
// possible case adds nothing in this round. Its possible cases must cover the captured values
// of the call, or the component cannot publish its summaries (D17.18).
fn plan_target(call_context* c, ownership_summary_body.call_site site,
    ownership_summary_body.call_target target, fir.statement* call, ownership_flow.step* s,
    ownership_state.state* facts, ownership_api.services* svc, target_plan mut* plan)
    plan_result {
    ownership_summary_model.summary_view* mut summary = target.binding.summary;
    if (summary == null) { return plan_result.unresolved; }
    if (target.binding.provisional && bottom(summary)) {
        plan->vacuous = true;
        mark_uncovered(c, s);
        return plan_result.ready;
    }
    // A callee without a proof keeps an unknown call. A callee body that failed reported its
    // own error, so the call does not fail this body for it (D17.18).
    if (summary->residual_effects || !ownership_api.successful(summary->proof) ||
        summary->cases.len == 0) { return plan_result.unresolved; }
    // A call of this body applies its summary under a callee frame: each callee key takes
    // another function instance, so the callee locals stay apart from this frame (D17.15).
    if (ownership_keys.function(summary->operation.function, c->in->function.key) == 0) {
        plan->renamed = ownership_summary_model.rename(summary, c->in->function.key,
            ownership_api.function_id{c->in->function.key.declaration, FRAME_INSTANCE}, svc);
        if (c->watch != null && c->watch->refused) {
            c->program->proof = c->watch->refusal.proof;
            return plan_result.stop;
        }
        if (!ownership_api.successful(plan->renamed.proof)) { return plan_result.unresolved; }
        plan->frame = ownership_summary_model.view(&plan->renamed);
        summary = &plan->frame;
    }
    if (!bind_call(c, site, target, summary, call, facts, &plan->bindings)) {
        return plan_result.stop;
    }
    if (plan->bindings.unknown) { return plan_result.unresolved; }
    plan->bindings.events[0] = ownership_calls.event_binding{s->operation, site.event};
    ownership_api.alias_binding@ no_globals = {};
    plan->req = ownership_calls.request{.summary = summary,
        .before = ownership_state.view(facts), .operation = s->operation, .source = s->source,
        .aliases = plan->bindings.aliases[..plan->bindings.aliases_len],
        .sources = plan->bindings.sources[..plan->bindings.sources_len],
        .allocations = plan->bindings.allocations[..plan->bindings.allocations_len],
        .captures = plan->bindings.captures[..plan->bindings.captures_len],
        .globals = no_globals, .events = plan->bindings.events[..], .services = svc,
        .limits = c->in->limits,
        .coverage = ownership_summary_model.coverage_status{true, true, false},
        .correspondence_complete = true, .event_map_complete = true};
    plan->req.result.actual_slot = ownership_summary_body.slot(c->in, call->place.local);
    plan->guard = ownership_summary_model.context{svc, s->operation, s->source,
        site.event, summary->source};
    u64 mut possible = 0;
    u64 mut normals = 0;
    u64 mut i = 0;
    while (i < summary->cases.len) {
        ownership_calls.guard_answer answer = ownership_calls.case_answer(&plan->req,
            &plan->guard, &c->program->proof, i);
        if (answer == ownership_calls.guard_answer.unbound) { return plan_result.unresolved; }
        if (!ownership_api.successful(c->program->proof)) { return plan_result.stop; }
        if (answer != ownership_calls.guard_answer.fails) {
            possible += 1;
            if (summary->cases[i].outcome.kind == ownership_api.outcome_kind.function_return) {
                normals += 1;
            }
        }
        i += 1;
    }
    plan->returns = normals != 0;
    plan->strip = normals > 1 &&
        ownership_calls.covered(&plan->req, &plan->guard, &c->program->proof, true);
    if (!ownership_api.successful(c->program->proof)) { return plan_result.stop; }
    // Guards that all fail cover no caller value. They prove no absence of return.
    if (possible == 0 && !target.binding.provisional) { return plan_result.unresolved; }
    if (possible == 0) {
        plan->vacuous = true;
        mark_uncovered(c, s);
        return plan_result.ready;
    }
    if (target.binding.provisional &&
        !ownership_calls.covered(&plan->req, &plan->guard, &c->program->proof, false)) {
        mark_uncovered(c, s);
    }
    return ownership_api.successful(c->program->proof) ? plan_result.ready :
        plan_result.stop;
}

// Applies the published summary of each fort target at one call (D17.18). Each case whose
// guard does not fail runs. A proved abort records an abort exit and needs no cleanup. Normal
// cases join into one continuation. When only aborts run, the path ends. An unresolved target
// keeps a possible return with its obligations. With several targets, a continuation needs
// each target that can run to return: otherwise the call stays unresolved. A provisional
// target without a possible case ends its path in this round only.
fn call_step(void mut* opaque, ownership_flow.step* s, ownership_state.state mut* facts)
    ownership_flow.call_verdict {
    call_context* c = cast(opaque, call_context*);
    ownership_flow.call_verdict mut verdict = ownership_flow.call_verdict{
        .proof = ownership_summary_model.complete()};
    u64 index = call_site_at(c, s);
    if (index == ownership_api.U64_MAX) {
        verdict.proof = c->program->proof;
        if (ownership_api.successful(verdict.proof)) {
            verdict.proof = ownership_api.incomplete(
                ownership_api.incomplete_reason.invalid_input, s->operation, s->source);
        }
        return verdict;
    }
    ownership_summary_body.call_site site = c->program->calls[index];
    fir.statement* call = fir.block_statement(c->in->function.body, site.block, site.gap);
    if (site.unresolved || site.targets_len == 0) { return unresolved_call(c, call, facts); }
    bool definite = site.targets_len == 1;
    possibility mut wrap = possibility{c->in->services};
    ownership_api.services mut possible_services = *c->in->services;
    possible_services.event_context = cast(&wrap, void mut*);
    possible_services.event = possible_event;
    ownership_api.services* mut svc = c->in->services;
    if (!definite) { svc = &possible_services; }
    if (site.targets_len > types.TYPE_MAX_SIZE / sizeof(target_plan) ||
        !call_work(c, site.targets_len)) {
        verdict.proof = c->program->proof;
        return verdict;
    }
    target_plan mut@ own plans = new(target_plan, site.targets_len);
    defer del(plans);
    defer free_plans(plans[..]);
    u64 mut running = 0;
    u64 mut returning = 0;
    u64 mut t = 0;
    while (t < site.targets_len) {
        plan_result planned = plan_target(c, site,
            c->program->targets[site.targets_first + t], call, s, facts, svc, &plans[t]);
        if (planned == plan_result.stop) {
            verdict.proof = c->program->proof;
            return verdict;
        }
        if (planned == plan_result.unresolved) { return unresolved_call(c, call, facts); }
        if (!plans[t].vacuous) {
            running += 1;
            if (plans[t].returns) { returning += 1; }
        }
        t += 1;
    }
    if (!definite && returning != 0 && returning != running) {
        return unresolved_call(c, call, facts);
    }
    continuation mut kept = continuation{.facts = ownership_state.empty(),
        .normal_stores = ownership_api.U64_MAX};
    defer ownership_state.free(&kept.facts);
    // Only one target exports stores. Its case lists name the effects of its summary.
    u64 mut capacity = 0;
    if (definite && !plans[0].vacuous) { capacity = plans[0].req.summary->effects.len; }
    kept.stores = new(ownership_api.entity_id, capacity);
    defer del(kept.stores);
    t = 0;
    while (t < site.targets_len) {
        ownership_summary_model.summary_view* summary = plans[t].req.summary;
        u64 mut i = 0;
        while (!plans[t].vacuous && i < summary->cases.len) {
            ownership_calls.guard_answer answer = ownership_calls.case_answer(&plans[t].req,
                &plans[t].guard, &c->program->proof, i);
            if (!ownership_api.successful(c->program->proof)) {
                verdict.proof = c->program->proof;
                return verdict;
            }
            if (answer != ownership_calls.guard_answer.fails) {
                if (!apply_one(c, site, call, s, &plans[t].req, i, definite, plans[t].strip,
                    &kept, &verdict)) {
                    if (verdict.unknown) { return unresolved_call(c, call, facts); }
                    return verdict;
                }
            }
            i += 1;
        }
        t += 1;
    }
    // A store of an abort case that a normal case does not do would reach the normal exits.
    if (kept.normal_stores != ownership_api.U64_MAX && kept.normal_stores != kept.stores_len) {
        c->program->call_residual = true;
    }
    if (kept.normals == 0) {
        // When each target is a provisional target without a possible case, no execution
        // reaches past this call in this round (D17.18).
        if (running == 0) { c->program->vacuous = true; }
        return verdict;
    }
    if (kept.normals > 1 && !collapse_result(c, call, &kept.facts)) {
        verdict.proof = c->program->proof;
        return verdict;
    }
    if (!export_call_result(c, call, s, &kept.facts)) {
        verdict.proof = c->program->proof;
        return verdict;
    }
    ownership_state.free(facts);
    *facts = move(kept.facts);
    verdict.continues = true;
    return verdict;
}

fn sort_roots(ownership_summary_body.body_program mut* program) bool {
    u64 mut i = 1;
    while (i < program->roots_len) {
        u64 mut j = i;
        while (j > 0) {
            if (!ownership_summary_body.work(program, 2)) { return false; }
            if (ownership_keys.entity(program->roots[j - 1].key, program->roots[j].key) <= 0) {
                break;
            }
            ownership_summary_model.symbolic_root previous = program->roots[j - 1];
            program->roots[j - 1] = program->roots[j];
            program->roots[j] = previous;
            j -= 1;
        }
        i += 1;
    }
    return true;
}

fn failed(ownership_summary_body.body_program* program) ownership_summary_model.summary {
    ownership_summary_model.summary mut out = ownership_summary_model.summary{};
    out.operation = program->context.operation;
    out.source = program->context.source;
    out.event = program->context.event;
    out.proof = program->proof;
    out.coverage = program->coverage;
    out.coverage.actual_source_complete = false;
    out.residual_effects = true;
    return out;
}

// A block is on the path to an exit when it is the exit block or one of its parents.
fn on_path(ownership_summary_body.body_program mut* program, u32 block, u32 exit_block) bool {
    u32 mut at = exit_block;
    while (at != ownership_summary_body.U32_MAX && cast(at, u64) < program->parents.len) {
        if (!ownership_summary_body.work(program, 1)) { return false; }
        if (at == block) { return true; }
        at = program->parents[at];
    }
    return false;
}

// A position precedes an exit on its path. A call export shares the position of its call.
fn before_exit(ownership_summary_body.body_program mut* program,
    ownership_api.operation_position at, ownership_api.operation_position exit) bool {
    if (at.block == exit.block) { return at.operation <= exit.operation; }
    return at.block < exit.block && on_path(program, at.block, exit.block);
}

fn position_less(ownership_api.operation_position a, ownership_api.operation_position b) bool {
    return a.block < b.block || (a.block == b.block && a.operation < b.operation);
}

// Returns the effects of one exit in FIR order. Equal positions keep their emission order.
fn exit_sequence(ownership_summary_body.body_program mut* program, exit_snapshot* exit,
    ownership_api.entity_id mut@ out) u64 {
    u64 mut@ own index = new(u64, program->effects_len);
    defer del(index);
    u64 mut count = 0;
    u64 mut i = 0;
    while (i < program->effects_len) {
        if (!ownership_summary_body.work(program, 1)) { return 0; }
        ownership_api.operation_position at = program->effects[i].effect.operation;
        if (before_exit(program, at, exit->operation)) {
            u64 mut j = count;
            while (j > 0 && position_less(at, program->effects[index[j - 1]].effect.operation)) {
                if (!ownership_summary_body.work(program, 1)) { return 0; }
                index[j] = index[j - 1];
                j -= 1;
            }
            index[j] = i;
            count += 1;
        }
        i += 1;
    }
    i = 0;
    while (i < count) {
        out[i] = program->effects[index[i]].effect.key;
        i += 1;
    }
    return count;
}

// The order relation is a canonical set. Its records sort by their before and after keys.
// The case sequence keeps the FIR order that a caller applies.
fn sort_order(ownership_summary_body.body_program mut* program,
    ownership_api.ordering_constraint mut@ order) bool {
    u64 mut i = 1;
    while (i < order.len) {
        u64 mut j = i;
        while (j > 0) {
            if (!ownership_summary_body.work(program, 1)) { return false; }
            i32 first = ownership_keys.entity(order[j - 1].before, order[j].before);
            if (first < 0 || (first == 0 &&
                ownership_keys.entity(order[j - 1].after, order[j].after) < 0)) { break; }
            ownership_api.ordering_constraint prior = order[j - 1];
            order[j - 1] = order[j];
            order[j] = prior;
            j -= 1;
        }
        i += 1;
    }
    return true;
}

// A sequence key names an effect of this program. A missing key is invalid input. The program
// appends each effect with a fresh key from one counter, so the keys increase and a binary
// search finds one in O(log n) W units.
fn effect_at(ownership_summary_body.body_program mut* program, ownership_api.entity_id key)
    u64 {
    u64 mut low = 0;
    u64 mut high = program->effects_len;
    while (low < high) {
        if (!ownership_summary_body.work(program, 1)) { return ownership_api.U64_MAX; }
        u64 middle = low + (high - low) / 2;
        i32 order = ownership_keys.entity(program->effects[middle].effect.key, key);
        if (order == 0) { return middle; }
        if (order < 0) { low = middle + 1; } else { high = middle; }
    }
    ownership_summary_body.reject(program, ownership_api.incomplete_reason.invalid_input);
    return ownership_api.U64_MAX;
}

fn position_source(ownership_summary_body.body_program mut* program,
    ownership_api.operation_position at, ownership_api.source_position fallback)
    ownership_api.source_position {
    u64 mut i = 0;
    while (i < program->provenance_len) {
        if (!ownership_summary_body.work(program, 1)) { return fallback; }
        if (ownership_keys.operation(program->provenance_records[i].operation, at) == 0) {
            return program->provenance_records[i].source;
        }
        i += 1;
    }
    return fallback;
}

// The body itself fails at `at`. The event names the view source as its relation.
fn intrinsic_use(ownership_summary_body.body_program mut* program,
    ownership_api.operation_position at, ownership_api.source_position where,
    ownership_api.entity_id view, string message) void {
    ownership_api.entity_id key = ownership_summary_body.next(program,
        ownership_api.entity_kind.event);
    if (!ownership_api.successful(program->proof)) { return; }
    ownership_api.proof_status mut proof = ownership_summary_model.complete();
    proof.failed = true;
    ownership_api.event_descriptor mut event = ownership_api.event_descriptor{};
    event.key = key;
    event.operation = at;
    event.source = where;
    event.kind = ownership_api.event_kind.invalid_use;
    event.evidence = ownership_api.evidence_kind.unconditional;
    event.relation = view;
    event.text = message;
    ownership_api.event_request request = ownership_api.event_request{event, proof};
    program->proof = ownership_api.record_event(program->context.services, &request).proof;
    program->residual_effects = true;
}

// A view loaded from a caller owner field designates the owned allocation. A release of that
// field in the same body ends the view (D17.14). A later requirement on the view is a use after
// release, and a returned borrow of it outlives its source. The body fails at that operation.
fn released_views(ownership_summary_body.body_program mut* program, exit_snapshot* exit,
    ownership_api.entity_id@ sequence, bool returns, ownership_api.place_path result) bool {
    u64 mut i = 0;
    while (i < sequence.len) {
        u64 released = effect_at(program, sequence[i]);
        if (released == ownership_api.U64_MAX) { return false; }
        ownership_summary_model.effect_node release = program->effects[released];
        u64 mut j = 0;
        while (release.payload == ownership_summary_model.payload_kind.release &&
            release.effect.place.projections.len != 0 && j < i) {
            u64 loaded = effect_at(program, sequence[j]);
            if (loaded == ownership_api.U64_MAX) { return false; }
            ownership_summary_model.effect_node load = program->effects[loaded];
            if (load.payload == ownership_summary_model.payload_kind.reference_load &&
                load.value.borrows.len == 1 &&
                ownership_state.same_place(load.operand, release.effect.place)) {
                ownership_api.entity_id view = load.value.borrows[0].source;
                u64 mut r = 0;
                while (r < program->requirements_len) {
                    if (!ownership_summary_body.work(program, 1)) { return false; }
                    ownership_summary_model.requirement row = program->requirements[r];
                    if (ownership_summary_model.same(row.source, view) &&
                        position_less(release.effect.operation, row.operation) &&
                        before_exit(program, row.operation, exit->operation)) {
                        intrinsic_use(program, row.operation,
                            position_source(program, row.operation, exit->source), view,
                            "view of an owner field is used after its release");
                        return false;
                    }
                    r += 1;
                }
                u64 mut c = 0;
                while (returns && c < exit->facts.contents_len) {
                    if (!ownership_summary_body.work(program, 1)) { return false; }
                    ownership_api.contents_fact value = exit->facts.contents[c];
                    u64 mut b = 0;
                    while (ownership_summary_model.same(value.place.root, result.root) &&
                        b < value.borrows.len) {
                        if (ownership_summary_model.same(value.borrows[b].source, view)) {
                            intrinsic_use(program, exit->operation, exit->source, view,
                                "returned view outlives its released owner field");
                            return false;
                        }
                        b += 1;
                    }
                    c += 1;
                }
            }
            j += 1;
        }
        i += 1;
    }
    return true;
}

// A guard atom tests one exact value of a captured scalar formal of this body.
fn formal_atom(ownership_summary_body.body_input* in, ownership_api.predicate_atom atom) bool {
    u64 locals = cast(fir.local_count(in->function.body), u64);
    return atom.kind == ownership_api.predicate_kind.equality &&
        atom.left.kind == ownership_api.entity_kind.value &&
        ownership_keys.function(atom.left.function, in->function.key) == 0 &&
        atom.right.kind == ownership_api.entity_kind.none &&
        atom.lower.kind == ownership_api.fact_kind.exact && atom.left.ordinal > 0 &&
        cast(atom.left.ordinal - 1, u64) < locals &&
        fir.local_at(in->function.body, atom.left.ordinal - 1)->kind ==
            fir.local_kind.lk_param &&
        !ownership_summary_body.reference(fir.local_at(in->function.body,
            atom.left.ordinal - 1)->ty);
}

fn exit_less(exit_snapshot* a, exit_snapshot* b) bool {
    return position_less(a->operation, b->operation);
}

// The exits of the observer list, sorted by FIR position. Each possible abort case of a call
// gives one abort exit, so several abort exits can share the position of their call. Two
// other exits at one position, or an exit that is neither a return nor an abort, leave the
// summary without a proof.
fn sorted_exits(ownership_summary_body.body_program mut* program, exits* observations,
    exit_snapshot* mut@ out) bool {
    exit_snapshot* mut item = observations->first;
    u64 mut count = 0;
    while (item != null && count < out.len) {
        if (!ownership_summary_body.work(program, 1 + count)) { return false; }
        if (item->outcome.kind != ownership_api.outcome_kind.function_return &&
            item->outcome.kind != ownership_api.outcome_kind.abort) { return false; }
        u64 mut j = count;
        while (j > 0 && exit_less(item, out[j - 1])) {
            out[j] = out[j - 1];
            j -= 1;
        }
        if (j > 0 && ownership_keys.operation(out[j - 1]->operation, item->operation) == 0 &&
            (item->outcome.kind != ownership_api.outcome_kind.abort ||
            out[j - 1]->outcome.kind != ownership_api.outcome_kind.abort)) {
            return false;
        }
        out[j] = item;
        count += 1;
        item = item->next;
    }
    return count == out.len && item == null;
}

// One formal atom of exit `a` is also an atom of exit `b`.
fn guard_within(ownership_summary_body.body_input* in,
    ownership_summary_body.body_program mut* program, exit_snapshot* a, exit_snapshot* b)
    bool {
    u64 mut i = 0;
    while (i < a->facts.predicates_len) {
        ownership_api.predicate_atom atom = a->facts.predicates[i];
        bool mut found = !formal_atom(in, atom);
        u64 mut j = 0;
        while (!found && j < b->facts.predicates_len) {
            if (!ownership_summary_body.work(program, 1)) { return false; }
            ownership_api.predicate_atom other = b->facts.predicates[j];
            found = formal_atom(in, other) && ownership_summary_model.same(other.left, atom.left) &&
                other.lower.value == atom.lower.value;
            j += 1;
        }
        if (!found) { return false; }
        i += 1;
    }
    return true;
}

// Two abort exits at one call position with one guard are one case. A copy would let a
// recursive component add one more copy in each round, so it never reaches a fixed point.
// Returns the number of exits that `ordered` keeps at its front.
fn distinct_exits(ownership_summary_body.body_input* in,
    ownership_summary_body.body_program mut* program, exit_snapshot* mut@ ordered) u64 {
    u64 mut kept = 0;
    u64 mut i = 0;
    while (i < ordered.len) {
        exit_snapshot* exit = ordered[i];
        bool mut copy = false;
        u64 mut j = kept;
        while (!copy && j > 0 && ownership_keys.operation(ordered[j - 1]->operation,
            exit->operation) == 0) {
            if (!ownership_summary_body.work(program, 1)) { return kept; }
            exit_snapshot* prior = ordered[j - 1];
            copy = exit->outcome.kind == ownership_api.outcome_kind.abort &&
                prior->outcome.kind == ownership_api.outcome_kind.abort &&
                guard_within(in, program, exit, prior) && guard_within(in, program, prior, exit);
            j -= 1;
        }
        if (!copy) {
            ordered[kept] = exit;
            kept += 1;
        }
        i += 1;
    }
    return kept;
}

// The owned records of one publication. The summary view borrows these slices.
struct publication {
    ownership_api.entity_id mut@ own case_effects;
    ownership_api.entity_id mut@ own case_requirements;
    ownership_api.entity_id mut@ own case_results;
    ownership_api.entity_id mut@ own guard_keys;
    ownership_api.predicate_atom mut@ own predicates;
    ownership_api.guard_fact mut@ own guards;
    ownership_summary_model.case_record mut@ own cases;
    ownership_summary_model.relation mut@ own relations;
    ownership_summary_model.relation mut@ own retained;
    ownership_api.entity_id mut@ own case_retained;
    ownership_api.ordering_constraint mut@ own order;
    u64 retained_len;
    u64 predicates_len;
    u64 guards_len;
    u64 relations_len;
    u64 order_len;
    u64 results_len;
    u64 guard_keys_len;
}

fn free_publication(publication mut* out) void {
    publication mut owned = move(*out);
    del(owned.case_effects);
    del(owned.case_requirements);
    del(owned.case_results);
    del(owned.guard_keys);
    del(owned.predicates);
    del(owned.guards);
    del(owned.cases);
    del(owned.relations);
    del(owned.retained);
    del(owned.case_retained);
    del(owned.order);
    *out = publication{};
}

// The guard of one exit is the conjunction of its formal value atoms. Equal atoms of two exits
// share one predicate record.
fn exit_guard(ownership_summary_body.body_input* in,
    ownership_summary_body.body_program mut* program, exit_snapshot* exit,
    publication mut* out) ownership_api.entity_id {
    u64 first = out->guard_keys_len;
    u64 mut i = 0;
    while (i < exit->facts.predicates_len) {
        if (!ownership_summary_body.work(program, 1 + out->predicates_len)) {
            return ownership_api.entity_id{};
        }
        ownership_api.predicate_atom atom = exit->facts.predicates[i];
        if (formal_atom(in, atom) && out->guard_keys_len < out->guard_keys.len) {
            u64 mut found = out->predicates_len;
            u64 mut k = 0;
            while (k < out->predicates_len) {
                if (ownership_summary_model.same(out->predicates[k].left, atom.left) &&
                    out->predicates[k].lower.value == atom.lower.value) { found = k; }
                k += 1;
            }
            if (found == out->predicates_len) {
                ownership_api.predicate_atom mut stored = atom;
                stored.key = ownership_summary_body.next(program,
                    ownership_api.entity_kind.predicate);
                out->predicates[out->predicates_len] = stored;
                out->predicates_len += 1;
            }
            out->guard_keys[out->guard_keys_len] = out->predicates[found].key;
            out->guard_keys_len += 1;
        }
        i += 1;
    }
    if (out->guard_keys_len == first) { return ownership_api.entity_id{}; }
    if (!ownership_summary_model.effect_charge(&program->context, &program->proof,
        &program->relations)) { return ownership_api.entity_id{}; }
    ownership_api.entity_id key = ownership_summary_body.next(program,
        ownership_api.entity_kind.guard);
    ownership_api.entity_id@ none = {};
    out->guards[out->guards_len] = ownership_api.guard_fact{key,
        out->guard_keys[first..out->guard_keys_len], none};
    out->guards_len += 1;
    return key;
}

fn caller_storage(ownership_summary_body.body_program mut* program,
    ownership_api.place_path place) bool {
    u64 mut r = 0;
    while (r < program->roots_len) {
        if (!ownership_summary_body.work(program, 1)) { return false; }
        ownership_summary_model.symbolic_root root = program->roots[r];
        if (root.kind == ownership_summary_model.root_kind.caller_source &&
            ownership_summary_model.same(root.slot, place.root)) { return true; }
        r += 1;
    }
    return false;
}

// The last borrow store into each caller storage path of a normal return retains its source
// after the return. The summary keeps it as a retained relation. The source must still be
// live at the return, after deferred effects (D17.14). A later store at that path, such as a
// null store, ends the relation.
fn retained_stores(ownership_summary_body.body_program mut* program, exit_snapshot* exit,
    ownership_api.entity_id@ sequence, publication mut* out) bool {
    u64 mut i = 0;
    while (i < sequence.len) {
        u64 at = effect_at(program, sequence[i]);
        if (at == ownership_api.U64_MAX) { return false; }
        ownership_summary_model.effect_node node = program->effects[at];
        bool store = node.payload == ownership_summary_model.payload_kind.copy ||
            node.payload == ownership_summary_model.payload_kind.replacement;
        if (store && caller_storage(program, node.effect.place)) {
            bool mut later = false;
            u64 mut j = i + 1;
            while (j < sequence.len && !later) {
                u64 next_at = effect_at(program, sequence[j]);
                if (next_at == ownership_api.U64_MAX) { return false; }
                ownership_summary_model.effect_node next = program->effects[next_at];
                later = (next.payload == ownership_summary_model.payload_kind.copy ||
                    next.payload == ownership_summary_model.payload_kind.replacement) &&
                    ownership_state.same_place(next.effect.place, node.effect.place);
                j += 1;
            }
            ownership_api.entity_id source = node.payload ==
                ownership_summary_model.payload_kind.copy ? node.effect.source :
                node.value.borrows.len == 1 ? node.value.borrows[0].source :
                ownership_api.entity_id{};
            if (!later && source.kind == ownership_api.entity_kind.source) {
                u64 known = ownership_state.source_index(&exit->facts, source);
                if (known != ownership_api.U64_MAX &&
                    (exit->facts.sources[known].validity == ownership_api.validity_kind.released ||
                    exit->facts.sources[known].validity == ownership_api.validity_kind.ended)) {
                    intrinsic_use(program, exit->operation, exit->source, source,
                        "retained view outlives its source");
                    return false;
                }
                if (!ownership_summary_model.effect_charge(&program->context, &program->proof,
                    &program->relations) || out->retained_len >= out->retained.len) {
                    return false;
                }
                ownership_api.entity_id key = ownership_summary_body.next(program,
                    ownership_api.entity_kind.relation);
                out->retained[out->retained_len] = ownership_summary_model.relation{.key = key,
                    .borrow = ownership_api.borrow_relation{.key = key,
                        .containing = node.effect.place, .source = source}};
                out->case_retained[out->retained_len] = key;
                out->retained_len += 1;
            }
        }
        i += 1;
    }
    return ownership_api.successful(program->proof);
}

// One borrowed leaf of an aggregate local on one exit path.
struct leaf_source {
    ownership_api.entity_id root;
    u32 field;
    ownership_api.entity_id source;
}

fn local_slot(ownership_summary_body.body_input* in, ownership_api.entity_id root) bool {
    return root.kind == ownership_api.entity_kind.slot &&
        ownership_keys.function(root.function, in->function.key) == 0 &&
        cast(root.ordinal, u64) < cast(fir.local_count(in->function.body), u64);
}

// Removes the leaves of `root` and returns the new length.
fn drop_leaves(leaf_source mut@ leaves, u64 len, ownership_api.entity_id root) u64 {
    u64 mut kept = 0;
    u64 mut i = 0;
    while (i < len) {
        if (!ownership_summary_model.same(leaves[i].root, root)) {
            leaves[kept] = leaves[i];
            kept += 1;
        }
        i += 1;
    }
    return kept;
}

// A borrowed leaf of an aggregate result designates its source after the return. The exit path
// copies leaves into locals and moves locals into the result in FIR order. Each result leaf
// source must still be live at the return, after deferred effects (D17.15).
fn result_leaves(ownership_summary_body.body_input* in,
    ownership_summary_body.body_program mut* program, exit_snapshot* exit,
    ownership_api.entity_id@ sequence) bool {
    if (!ownership_summary_body.work(program, sequence.len * 2)) { return false; }
    leaf_source mut@ own leaves = new(leaf_source, sequence.len);
    defer del(leaves);
    u64 mut len = 0;
    ownership_api.entity_id result = ownership_summary_body.slot(in, 0).root;
    u64 mut i = 0;
    while (i < sequence.len) {
        u64 at = effect_at(program, sequence[i]);
        if (at == ownership_api.U64_MAX) { return false; }
        ownership_summary_model.effect_node node = program->effects[at];
        ownership_api.place_path place = node.effect.place;
        bool whole = node.payload == ownership_summary_model.payload_kind.move ||
            node.payload == ownership_summary_model.payload_kind.copy;
        if (whole && local_slot(in, place.root) && place.projections.len == 1 &&
            place.projections[0].kind == ownership_api.projection_kind.field) {
            len = drop_leaves(leaves[..], len, place.root);
            if (node.payload == ownership_summary_model.payload_kind.copy &&
                node.effect.source.kind == ownership_api.entity_kind.source && len < leaves.len) {
                leaves[len] = leaf_source{place.root, place.projections[0].field,
                    node.effect.source};
                len += 1;
            }
        } else if (whole && local_slot(in, place.root) && place.projections.len == 0) {
            len = drop_leaves(leaves[..], len, place.root);
            u64 mut k = 0;
            u64 copied = len;
            while (k < copied && local_slot(in, node.operand.root) &&
                node.operand.projections.len == 0) {
                if (!ownership_summary_body.work(program, 1)) { return false; }
                if (ownership_summary_model.same(leaves[k].root, node.operand.root) &&
                    len < leaves.len) {
                    leaves[len] = leaf_source{place.root, leaves[k].field, leaves[k].source};
                    len += 1;
                }
                k += 1;
            }
        }
        i += 1;
    }
    i = 0;
    while (i < len) {
        if (ownership_summary_model.same(leaves[i].root, result)) {
            u64 known = ownership_state.source_index(&exit->facts, leaves[i].source);
            if (known != ownership_api.U64_MAX &&
                (exit->facts.sources[known].validity == ownership_api.validity_kind.released ||
                exit->facts.sources[known].validity == ownership_api.validity_kind.ended)) {
                intrinsic_use(program, exit->operation, exit->source, leaves[i].source,
                    "returned aggregate view outlives its source");
                return false;
            }
        }
        i += 1;
    }
    return true;
}

// One case for each exit (D17.18). A case keeps the requirements and the effects on the path
// to its exit, in FIR order, and the result relations of a normal return.
fn exit_case(ownership_summary_body.body_input* in,
    ownership_summary_body.body_program mut* program, exit_snapshot* exit, u64 index,
    publication mut* out) bool {
    bool returns = exit->outcome.kind == ownership_api.outcome_kind.function_return;
    u64 stride = program->effects_len;
    ownership_api.entity_id mut@ effects = out->case_effects[index * stride..(index + 1) * stride];
    u64 sequence = exit_sequence(program, exit, effects);
    if (!ownership_api.successful(program->proof) ||
        !released_views(program, exit, effects[..sequence], returns,
            ownership_summary_body.slot(in, 0))) { return false; }
    u64 mut i = 0;
    while (i + 1 < sequence) {
        if (!ownership_summary_body.work(program, 1) ||
            !ownership_summary_model.effect_charge(&program->context, &program->proof,
            &program->relations) || out->order_len >= out->order.len) { return false; }
        out->order[out->order_len] = ownership_api.ordering_constraint{effects[i],
            effects[i + 1], true};
        out->order_len += 1;
        i += 1;
    }
    u64 rows = program->requirements_len;
    ownership_api.entity_id mut@ needed = out->case_requirements[index * rows..(index + 1) * rows];
    u64 mut kept = 0;
    i = 0;
    while (i < rows) {
        if (!ownership_summary_body.work(program, 1)) { return false; }
        if (before_exit(program, program->requirements[i].operation, exit->operation)) {
            needed[kept] = program->requirements[i].key;
            kept += 1;
        }
        i += 1;
    }
    u64 results_first = out->results_len;
    i = 0;
    while (returns && i < exit->facts.contents_len) {
        if (!ownership_summary_body.work(program, 1)) { return false; }
        ownership_api.contents_fact contents = exit->facts.contents[i];
        u64 mut b = 0;
        while (ownership_summary_model.same(contents.place.root,
            ownership_summary_body.slot(in, 0).root) && b < contents.borrows.len) {
            if (!ownership_summary_body.work(program, 1) ||
                !ownership_summary_model.effect_charge(&program->context, &program->proof,
                &program->relations) || out->relations_len >= out->relations.len) {
                return false;
            }
            ownership_api.entity_id key = ownership_summary_body.next(program,
                ownership_api.entity_kind.relation);
            out->relations[out->relations_len] = ownership_summary_model.relation{.key = key,
                .borrow = contents.borrows[b]};
            out->relations_len += 1;
            out->case_results[out->results_len] = key;
            out->results_len += 1;
            b += 1;
        }
        i += 1;
    }
    u64 retained_first = out->retained_len;
    if (returns && (!retained_stores(program, exit, effects[..sequence], out) ||
        !result_leaves(in, program, exit, effects[..sequence]))) {
        return false;
    }
    ownership_api.entity_id guard = exit_guard(in, program, exit, out);
    // A refused key fails the proof. Each later charge then fails, so this check also covers
    // a refused result relation key.
    ownership_api.entity_id case_key = ownership_summary_body.next(program,
        ownership_api.entity_kind.guard);
    if (!ownership_api.successful(program->proof)) { return false; }
    ownership_api.outcome_fact mut outcome = exit->outcome;
    outcome.guard = guard;
    out->cases[index] = ownership_summary_model.case_record{.key = case_key, .guard = guard,
        .requirements = needed[..kept], .effects = effects[..sequence],
        .results = out->case_results[results_first..out->results_len],
        .retained = out->case_retained[retained_first..out->retained_len], .outcome = outcome,
        .coverage = program->coverage};
    return true;
}

fn result_capacity(ownership_summary_body.body_input* in,
    ownership_summary_body.body_program mut* program, exits* observations) u64 {
    u64 mut total = 0;
    exit_snapshot* mut item = observations->first;
    while (item != null) {
        u64 mut i = 0;
        while (i < item->facts.contents_len) {
            if (!ownership_summary_body.work(program, 1)) { return 0; }
            ownership_api.contents_fact contents = item->facts.contents[i];
            if (ownership_summary_model.same(contents.place.root,
                ownership_summary_body.slot(in, 0).root)) {
                if (contents.borrows.len > types.TYPE_MAX_SIZE /
                    sizeof(ownership_summary_model.relation) - total) {
                    ownership_summary_body.reject(program,
                        ownership_api.incomplete_reason.invalid_input);
                    return 0;
                }
                total += contents.borrows.len;
            }
            i += 1;
        }
        item = item->next;
    }
    return total;
}

fn publish(ownership_summary_body.body_input* in,
    ownership_summary_body.body_program mut* program, exits* observations)
    ownership_summary_model.summary {
    ownership_summary_model.summary mut out = failed(program);
    u64 mut count = observations->count;
    // Each path ended at a provisional call without a possible case. The member is still at
    // bottom: it has no case and no residual effect, and it stays private (D17.18).
    if (count == 0 && !program->call_residual && !program->lost_requirement &&
        program->vacuous) {
        out.proof = program->proof;
        out.residual_effects = false;
        return out;
    }
    // A copy or read of a value with an unknown origin needs a source that no origin names.
    // The incomplete proof names that operation (D17.18).
    if (program->lost_requirement) {
        out.proof = ownership_api.incomplete(ownership_api.incomplete_reason.missing_path,
            program->lost_operation, program->lost_source);
        return out;
    }
    if (count == 0 || program->call_residual) {
        out.proof = ownership_api.incomplete(ownership_api.incomplete_reason.unknown_effect,
            program->context.operation, program->context.source);
        return out;
    }
    if (!sort_roots(program)) { return failed(program); }
    u64 effects_len = program->effects_len;
    u64 rows = program->requirements_len;
    u64 limit = types.TYPE_MAX_SIZE / sizeof(ownership_api.entity_id);
    if (count > limit / 4 || (effects_len != 0 && count > limit / effects_len) ||
        (rows != 0 && count > limit / rows) || effects_len > limit / 2 ||
        count > types.TYPE_MAX_SIZE / sizeof(ownership_summary_model.case_record) ||
        !ownership_summary_body.work(program, count * (effects_len + rows + 4))) {
        ownership_summary_body.reject(program, ownership_api.incomplete_reason.invalid_input);
        return failed(program);
    }
    exit_snapshot* mut@ own ordered = new(exit_snapshot*, count);
    defer del(ordered);
    if (!sorted_exits(program, observations, ordered[..])) {
        if (!ownership_api.successful(program->proof)) { return failed(program); }
        out.proof = ownership_api.incomplete(ownership_api.incomplete_reason.unknown_effect,
            program->context.operation, program->context.source);
        return out;
    }
    count = distinct_exits(in, program, ordered[..]);
    if (!ownership_api.successful(program->proof)) { return failed(program); }
    u64 results = result_capacity(in, program, observations);
    exit_snapshot* mut item = observations->first;
    u64 mut predicate_count = 0;
    while (item != null) {
        predicate_count += item->facts.predicates_len;
        item = item->next;
    }
    if (!ownership_api.successful(program->proof) ||
        predicate_count > types.TYPE_MAX_SIZE / sizeof(ownership_api.predicate_atom)) {
        return failed(program);
    }
    publication mut built = publication{};
    defer free_publication(&built);
    built.case_effects = new(ownership_api.entity_id, count * effects_len);
    built.case_requirements = new(ownership_api.entity_id, count * rows);
    built.case_results = new(ownership_api.entity_id, results);
    built.guard_keys = new(ownership_api.entity_id, predicate_count);
    built.predicates = new(ownership_api.predicate_atom, predicate_count);
    built.guards = new(ownership_api.guard_fact, count);
    built.cases = new(ownership_summary_model.case_record, count);
    built.relations = new(ownership_summary_model.relation, results);
    built.retained = new(ownership_summary_model.relation, count * effects_len);
    built.case_retained = new(ownership_api.entity_id, count * effects_len);
    built.order = new(ownership_api.ordering_constraint, count * effects_len);
    u64 mut i = 0;
    while (i < count) {
        if (!exit_case(in, program, ordered[i], i, &built)) { return failed(program); }
        i += 1;
    }
    if (!sort_order(program, built.order[..built.order_len])) { return failed(program); }
    u64 mut unique = 0;
    i = 0;
    while (i < built.order_len) {
        if (unique == 0 || !ownership_summary_model.same(built.order[unique - 1].before,
            built.order[i].before) || !ownership_summary_model.same(built.order[unique - 1].after,
            built.order[i].after)) {
            built.order[unique] = built.order[i];
            unique += 1;
        }
        i += 1;
    }
    exit_snapshot* first = ordered[0];
    ownership_summary_model.summary_view input = ownership_summary_model.summary_view{
        .roots = program->roots[..program->roots_len],
        .requirements = program->requirements[..program->requirements_len],
        .effects = program->effects[..program->effects_len], .order = built.order[..unique],
        .predicates = built.predicates[..built.predicates_len],
        .guards = built.guards[..built.guards_len],
        .results = built.relations[..built.relations_len],
        .retained = built.retained[..built.retained_len], .cases = built.cases[..],
        .provenance_records = program->provenance_records[..program->provenance_len],
        .coverage = program->coverage, .proof = program->proof,
        .operation = first->operation, .source = first->source,
        .event = program->context.event, .callee_source = first->source};
    return ownership_summary_model.clone(&input, in->services);
}

// The result of one inference. A recursive component publishes its members only when no
// member names an uncovered provisional call (D17.18).
struct inference {
    ownership_summary_model.summary summary;
    bool uncovered;
    ownership_api.operation_position uncovered_operation;
    ownership_api.source_position uncovered_source;
    // The first refused charge of the inference.
    bool refused;
    ownership_api.proof_status refusal;
}

// Whether the first failure of flow stops at an obligation that the facts of the body name:
// a definite failure, or a failure without proof whose reason is a lost path, capture or
// boundary. A failure for an unknown effect or a missing correspondence lacks a fact.
fn obligation_failure(ownership_api.proof_status first) bool {
    if (!first.terminal.present) { return true; }
    ownership_api.incomplete_reason why = first.terminal.reason;
    return why == ownership_api.incomplete_reason.none ||
        why == ownership_api.incomplete_reason.missing_path ||
        why == ownership_api.incomplete_reason.missing_capture ||
        why == ownership_api.incomplete_reason.missing_boundary;
}

fn infer_watched(ownership_summary_body.body_input* in, budget_watch* watch) inference {
    inference mut out = inference{};
    ownership_summary_body.body_program mut program = ownership_summary_body.extract(in);
    defer ownership_summary_body.free(&program);
    if (!ownership_api.successful(program.proof)) {
        out.summary = failed(&program);
        return out;
    }
    ownership_flow.program mut flow = ownership_summary_body.flow(in, &program);
    exits mut observations = exits{.context = program.context,
        .proof = ownership_summary_model.complete(), .relations = &program.relations};
    defer free_exits(&observations);
    flow.exit_context = cast(&observations, void mut*);
    flow.exit_observer = observe;
    call_context mut calls = call_context{in, &program, &observations, watch};
    flow.call_context = cast(&calls, void mut*);
    flow.call_handler = call_step;
    ownership_flow.analysis mut solved = ownership_flow.solve(&flow);
    defer ownership_flow.free(&solved);
    out.uncovered = program.uncovered;
    out.uncovered_operation = program.uncovered_operation;
    out.uncovered_source = program.uncovered_source;
    if (solved.failures != 0) {
        program.proof = solved.first_failure;
        out.summary = failed(&program);
        out.summary.obligation = obligation_failure(solved.first_failure);
        return out;
    }
    if (!ownership_api.successful(observations.proof)) {
        program.proof = observations.proof;
        out.summary = failed(&program);
        return out;
    }
    out.summary = publish(in, &program, &observations);
    return out;
}

/// Infers the summary of one body and reports its uncovered provisional calls.
/// `in->callees` and `in->targets` name the callees. A callee summary cannot override an
/// unsupported operation in this body. The inference sees each charge through a watch. A
/// call stops at its first refused charge.
fn infer_member(ownership_summary_body.body_input* in) inference {
    if (in->services == null) { return infer_watched(in, null); }
    budget_watch mut watch = budget_watch{.inner = in->services};
    ownership_api.services mut watched = *in->services;
    watched.budget_context = cast(&watch, void mut*);
    watched.budget = watched_charge;
    ownership_summary_body.body_input mut input = *in;
    input.services = &watched;
    inference mut out = infer_watched(&input, &watch);
    out.refused = watch.refused;
    out.refusal = watch.refusal.proof;
    return out;
}

/// Infers the summary of one body. `in->callees` and `in->targets` name the callees.
fn infer(ownership_summary_body.body_input* in) ownership_summary_model.summary {
    inference mut out = infer_member(in);
    return move(out.summary);
}
