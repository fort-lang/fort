/// Solves supplied ownership effects over verified FIR edges.
import ast;
import diag;
import fir;
import fir_flow;
import ownership_api;
import ownership_join;
import ownership_places;
import types;
import ownership_keys;
import ownership_limits;
import ownership_state;
import ownership_transfer;

u64 U64_MAX = 18446744073709551615;
// No FIR local has this number.
u32 NO_LOCAL = 4294967295;

enum step_kind {
    local_effect,
    invalidate_value,
    call_outcome,
    direct_call,
    flag,
}

// What one write of a bool local (a flag) tells a path about its value. A path keeps a known
// value as an equality predicate on the slot of the flag until the next write of the flag.
// The producer supplies a flag step for each write of a flag that no address names.
enum flag_kind {
    // The write stores a value that the path does not know.
    clear,
    // The write stores `value`.
    constant,
    // The write copies the flag `from`.
    copy,
    // The write stores the negation of the flag `from`.
    negate,
    // The write compares the reference in the whole slot `from` with null. The flag holds
    // `value` when that reference is null, and the other value when it is not null.
    null_test,
}

// `offset` marks a null test of a slot that an address or a slice through an indirection can
// fill. Such an address is past a null base and is not null, so an empty owner there decides
// nothing. A heap source still decides that the reference is not null.
struct flag_effect {
    flag_kind kind;
    ownership_api.entity_id flag;
    ownership_api.entity_id from;
    bool value;
    bool offset;
}

// The producer establishes that a switch takes this edge only when the flag holds `value`.
// The edge refutes a path that knows the other value. With `keep` the edge adds the value to a
// path that does not know it, for a later read. Without `keep` the edge removes the value,
// because no read of the flag follows before its next write.
struct flag_edge {
    u32 block;
    u32 target_index;
    ownership_api.entity_id flag;
    bool value;
    bool keep;
}

// The identities that the earlier allocation of one site takes when the site runs again while
// that allocation stays in the path facts (D17.16). The keys are finite: one set for each site.
// An allocation step without them keeps one identity for its site.
struct site_identity {
    ownership_api.entity_id allocation;
    ownership_api.entity_id source;
    ownership_api.entity_id value;
    ownership_api.entity_id relation;
}

// A direct-call handler applies one published callee summary to the path facts (D17.18).
// `continues` keeps the replaced facts as the one normal continuation. `unknown` keeps an
// unresolved continuation with its obligations. Neither flag ends the path without proof.
struct call_verdict {
    ownership_api.proof_status proof;
    bool continues;
    bool unknown;
}

// The producer binds each step to the gap before one FIR statement or terminator.
// Expanded deferred effects use their emitted FIR gaps and their emitted order.
struct step {
    u32 block;
    u32 gap;
    u32 order;
    step_kind kind;
    ownership_api.operation_position operation;
    ownership_api.source_position source;
    ownership_transfer.request local;
    ownership_api.entity_id invalidates;
    ownership_api.outcome_fact@ outcomes;
    bool outcomes_complete;
    // The effect of a `flag` step.
    flag_effect flag;
    // The earlier identities of the site of an allocation step.
    site_identity earlier;
}

// The source producer establishes which branch tests one value version.
struct edge_fact {
    u32 block;
    u32 target_index;
    ownership_api.entity_id value_version;
    bool is_null;
}

// The producer establishes that one edge of a switch selects one exact value of a version.
// The edge adds an equality predicate. A path that contradicts it is not reached.
struct value_edge {
    u32 block;
    u32 target_index;
    ownership_api.entity_id value_version;
    i64 value;
}

// A by-value parameter slot ends at normal return. Its caller source does not end.
struct parameter {
    ownership_api.entity_id slot;
    ownership_api.entity_id source;
}

// The checked closure assigns distinct keys before path solving starts.
struct event_binding {
    ownership_api.operation_position operation;
    ownership_api.event_kind kind;
    ownership_api.entity_id relation;
    ownership_api.entity_id key;
}

struct source_file_binding {
    u32 module;
    u32 file;
    string filename;
}

// A binding maps one actual FIR place. It does not describe another program.
struct place_binding {
    ownership_api.function_id function;
    fir.place place;
    ast.sym* global;
    ownership_api.place_path storage;
    bool complete;
}

struct loan_state {
    fir.statement* begin;
    ownership_state.state facts;
    ownership_api.place_path place;
    ownership_api.place_path original;
    bool known;
}

// A producer counts the path states that reach each local step and each return block.
// Each slice is empty or has one entry for each step or block. The caller owns the counts.
struct observer {
    u64 mut@ step_attempts;
    u64 mut@ step_uncertain;
    u64 mut@ return_attempts;
    u64 mut@ return_uncertain;
}

struct program {
    fir.func* function;
    ownership_api.function_id identity;
    ownership_state.state* entry;
    ownership_api.services* services;
    ownership_api.limit_table* limits;
    step@ steps;
    place_binding@ places;
    edge_fact@ edges;
    value_edge@ values;
    flag_edge@ flags;
    parameter@ parameters;
    event_binding@ events;
    source_file_binding@ source_files;
    ownership_api.entity_id result_slot;
    bool supplied_complete;
    bool verified_fir;
    // The optional observer copies the view. Its context outlives solve.
    void mut* exit_context;
    fn (void mut*, ownership_api.state_view*, ownership_api.outcome_fact,
        ownership_api.operation_position, ownership_api.source_position)
        ownership_api.proof_status exit_observer;
    // The direct-call handler owns its context. It replaces the facts only on a continuation.
    void mut* call_context;
    fn (void mut*, step*, ownership_state.state mut*) call_verdict call_handler;
    observer mut* observed;
    // A definite failure of a local step need not stop its path. With this option the path
    // settles the slots that the failure relates to, and continues to check the other owners
    // (toolchain 4.2). `continues_after` names the cases that still stop the path.
    bool continue_separate;
    // exposed[n]: an `addr` or a `slice` of local n stands in the function, so a pointer can
    // name its storage. solve fills it once from the FIR (exposed_locals).
    bool@ exposed;
}

struct path {
    ownership_state.state facts;
    ownership_state.state retired;
    fir_flow.bits loans;
    loan_state mut@ own held;
    ownership_state.state aliases;
    bool uncertain_return;
    bool loan_sources_unknown;
    // The FIR locals that a failure on this path relates to. The path no longer knows their
    // values, so it skips each later local step on them. Without `continue_separate` the set
    // has no members and a count of zero.
    fir_flow.bits settled;
}

struct bucket {
    path mut@ own paths;
    u64 len;
    u64 processed;
    bool widened;
}

// A path stopped at this position. Rank 0 is before the steps of the gap, rank k + 1 is the
// step of order k, and STOP_AFTER is after all steps of the block, at its terminator edges.
struct stop {
    u32 block;
    u32 gap;
    u64 rank;
}

u64 STOP_AFTER = 18446744073709551615;

struct analysis {
    bucket mut@ own blocks;
    u64 failures;
    u64 normal_returns;
    u64 transfers;
    ownership_api.proof_status first_failure;
    // Distinct positions where a failure stopped a path, in the order of the first stop.
    // The capacity counts every position, so a full list means a missing record.
    stop mut@ own stops;
    u64 stops_len;
    bool stops_lost;
    // step_first[b] is the index of the first step of block b or a later block.
    u64 mut@ own step_first;
    // cycles[b] is 0 until `on_cycle` reads block b, then 1 when no path leads from b back to
    // b, and 2 when one does. Only `continue_separate` allocates it.
    u8 mut@ own cycles;
}

fn complete() ownership_api.proof_status {
    ownership_api.proof_status mut out = ownership_api.proof_status{};
    out.kind = ownership_api.proof_kind.complete;
    return out;
}

fn same_entity(ownership_api.entity_id a, ownership_api.entity_id b) bool {
    return ownership_keys.entity(a, b) == 0;
}

fn clone_path(path* program) path {
    path mut out = path{};
    out.facts = ownership_state.clone(&program->facts);
    out.retired = ownership_state.clone(&program->retired);
    out.loans = fir_flow.bits_new(program->loans.count);
    fir_flow.bits_copy(&out.loans, &program->loans);
    out.held = new(loan_state, program->held.len);
    u64 mut i = 0;
    while (i < out.held.len) {
        out.held[i].facts = ownership_state.clone(&program->held[i].facts);
        out.held[i].place = ownership_state.copy_place(&out.held[i].facts,
            program->held[i].place);
        out.held[i].original = ownership_state.copy_place(&out.held[i].facts,
            program->held[i].original);
        out.held[i].begin = program->held[i].begin;
        out.held[i].known = program->held[i].known;
        i += 1;
    }
    out.aliases = ownership_state.clone(&program->aliases);
    out.uncertain_return = program->uncertain_return;
    out.loan_sources_unknown = program->loan_sources_unknown;
    out.settled = fir_flow.bits_new(program->settled.count);
    fir_flow.bits_copy(&out.settled, &program->settled);
    return out;
}

fn free_path(path mut* p) void {
    ownership_state.free(&p->facts);
    ownership_state.free(&p->retired);
    fir_flow.bits_free(&p->loans);
    u64 mut i = 0;
    while (i < p->held.len) { ownership_state.free(&p->held[i].facts); i += 1; }
    del(p->held);
    ownership_state.free(&p->aliases);
    fir_flow.bits_free(&p->settled);
    *p = path{};
}

fn free(analysis mut* r) void {
    u64 mut b = 0;
    while (b < r->blocks.len) {
        u64 mut i = 0;
        while (i < r->blocks[b].len) {
            free_path(&r->blocks[b].paths[i]);
            i += 1;
        }
        del(r->blocks[b].paths);
        b += 1;
    }
    del(r->blocks);
    del(r->stops);
    del(r->step_first);
    del(r->cycles);
    *r = analysis{};
}

fn path_equal(path* a, path* b) bool {
    if (a->held.len != b->held.len || a->loan_sources_unknown != b->loan_sources_unknown ||
        !ownership_state.equal(&a->aliases, &b->aliases)) {
        return false;
    }
    u64 mut i = 0;
    while (i < a->held.len) {
        if (a->held[i].begin != b->held[i].begin ||
            !ownership_state.same_place(a->held[i].original, b->held[i].original) ||
            a->held[i].known != b->held[i].known ||
            !ownership_state.same_place(a->held[i].place, b->held[i].place) ||
            !ownership_state.equal(&a->held[i].facts, &b->held[i].facts)) { return false; }
        i += 1;
    }
    return a->uncertain_return == b->uncertain_return &&
        fir_flow.bits_equal(&a->loans, &b->loans) &&
        fir_flow.bits_equal(&a->settled, &b->settled) &&
        ownership_state.equal(&a->facts, &b->facts) &&
        ownership_state.equal(&a->retired, &b->retired);
}

fn note_failure(analysis mut* out, ownership_api.proof_status proof) void {
    if (ownership_api.successful(proof)) { return; }
    if (out->failures == 0) { out->first_failure = proof; }
    out->failures += 1;
}

// Records a stopped path once for each position.
fn note_stop(analysis mut* out, u32 block, u32 gap, u64 rank) void {
    u64 mut i = 0;
    while (i < out->stops_len) {
        stop at = out->stops[i];
        if (at.block == block && at.gap == gap && at.rank == rank) { return; }
        i += 1;
    }
    if (out->stops_len == out->stops.len) {
        out->stops_lost = true;
        return;
    }
    out->stops[out->stops_len] = stop{block, gap, rank};
    out->stops_len += 1;
}

fn rank_of(step* s) u64 { return cast(s->order, u64) + 1; }

fn event_key(program* in, ownership_api.operation_position op,
    ownership_api.event_kind kind, ownership_api.entity_id relation)
    ownership_api.entity_id {
    u64 mut i = 0;
    while (i < in->events.len) {
        event_binding item = in->events[i];
        if (ownership_keys.operation(item.operation, op) == 0 && item.kind == kind &&
            same_entity(item.relation, relation)) { return item.key; }
        i += 1;
    }
    return ownership_api.entity_id{};
}

struct event_bridge {
    program* input;
}

fn mapped_event(void mut* opaque, ownership_api.event_request* request)
    ownership_api.event_result {
    event_bridge* bridge = cast(opaque, event_bridge*);
    ownership_api.event_request mut mapped = *request;
    mapped.event.key = event_key(bridge->input, mapped.event.operation,
        mapped.event.kind, mapped.event.relation);
    if (request->current.terminal.limit.present) {
        mapped.event.limit = request->current.terminal.limit;
    }
    if (mapped.event.key.kind != ownership_api.entity_kind.event) {
        ownership_api.event_result mut missing = ownership_api.event_result{};
        missing.proof = ownership_api.incomplete(
            ownership_api.incomplete_reason.missing_correspondence,
            mapped.event.operation, mapped.event.source);
        return missing;
    }
    return ownership_api.record_event(bridge->input->services, &mapped);
}

fn mapped_services(program* in, event_bridge mut* bridge) ownership_api.services {
    bridge->input = in;
    ownership_api.services mut mapped = *in->services;
    mapped.event_context = cast(bridge, void mut*);
    mapped.event = mapped_event;
    return mapped;
}

fn failure(program* in, ownership_api.operation_position op,
    ownership_api.source_position at, ownership_api.event_kind kind,
    ownership_api.incomplete_reason reason, ownership_api.entity_id relation,
    string message) ownership_api.proof_status {
    ownership_api.entity_id key = event_key(in, op, kind, relation);
    if (key.kind != ownership_api.entity_kind.event) {
        return ownership_api.incomplete(ownership_api.incomplete_reason.missing_correspondence,
            op, at);
    }
    ownership_api.proof_status mut proof = complete();
    proof.failed = true;
    if (reason != ownership_api.incomplete_reason.none) {
        proof = ownership_api.incomplete(reason, op, at);
        proof.terminal.relation = relation;
    }
    ownership_api.event_descriptor mut event = ownership_api.event_descriptor{};
    event.key = key;
    event.operation = op;
    event.source = at;
    event.kind = kind;
    event.evidence = reason == ownership_api.incomplete_reason.none ?
        ownership_api.evidence_kind.unconditional :
        ownership_api.evidence_kind.abstract_possibility;
    event.reason = reason;
    event.relation = relation;
    event.text = message;
    ownership_api.witness_link[1] witness = {
        ownership_api.witness_link{.key = ownership_api.entity_id{
            key.function, ownership_api.entity_kind.witness, key.ordinal},
            .event = key, .validated = true},
    };
    if (reason == ownership_api.incomplete_reason.none &&
        message == "cannot change collection storage during a range loop") {
        event.witnesses = witness[..];
    }
    ownership_api.event_request request = ownership_api.event_request{event, proof};
    return ownership_api.record_event(in->services, &request).proof;
}

fn charged_failure(program* in, ownership_api.proof_status proof,
    ownership_api.operation_position op, ownership_api.source_position at)
    ownership_api.proof_status {
    ownership_api.event_kind kind = proof.terminal.reason ==
        ownership_api.incomplete_reason.work_limit ? ownership_api.event_kind.work_failure :
        ownership_api.event_kind.incomplete_proof;
    ownership_api.entity_id key = event_key(in, op, kind, proof.terminal.relation);
    if (key.kind != ownership_api.entity_kind.event) {
        return ownership_api.incomplete(ownership_api.incomplete_reason.missing_correspondence,
            op, at);
    }
    ownership_api.event_descriptor mut event = ownership_api.event_descriptor{};
    event.key = key;
    event.operation = op;
    event.source = at;
    event.kind = kind;
    event.evidence = ownership_api.evidence_kind.abstract_possibility;
    event.reason = proof.terminal.reason;
    event.relation = proof.terminal.relation;
    event.limit = proof.terminal.limit;
    event.text = "ownership flow cannot complete the requested work";
    ownership_api.event_request request = ownership_api.event_request{event, proof};
    return ownership_api.record_event(in->services, &request).proof;
}

fn invalid_input(program* in) ownership_api.proof_status {
    ownership_api.operation_position op = ownership_api.operation_position{};
    ownership_api.source_position at = ownership_api.source_position{};
    return ownership_api.incomplete(ownership_api.incomplete_reason.invalid_input, op, at);
}

fn valid(program* in) bool {
    if (in->function == null || in->entry == null || in->services == null ||
        in->limits == null || !ownership_api.valid_limits(in->limits) ||
        !in->verified_fir || !in->supplied_complete ||
        fir.block_count(in->function) == 0) { return false; }
    u64 mut file_i = 0;
    while (file_i < in->source_files.len) {
        source_file_binding item = in->source_files[file_i];
        if (item.filename.len == 0) { return false; }
        u64 mut earlier = 0;
        while (earlier < file_i) {
            source_file_binding prior = in->source_files[earlier];
            if (prior.filename == item.filename ||
                (prior.module == item.module && prior.file == item.file)) { return false; }
            earlier += 1;
        }
        file_i += 1;
    }
    u32 mut block = 0;
    while (block < fir.block_count(in->function)) {
        fir.block* current = fir.block_at(in->function, block);
        if (current->term.loc.file.len > 0) {
            bool mut mapped = false;
            file_i = 0;
            while (file_i < in->source_files.len) {
                if (in->source_files[file_i].filename == current->term.loc.file) {
                    mapped = true;
                    break;
                }
                file_i += 1;
            }
            if (!mapped) { return false; }
        }
        block += 1;
    }
    u64 mut i = 0;
    while (i < in->steps.len) {
        step s = in->steps[i];
        if (s.block >= fir.block_count(in->function) ||
            s.gap > fir.block_statement_count(in->function, s.block) ||
            s.operation.block != s.block ||
            ownership_keys.function(s.operation.function, in->identity) != 0 ||
            (s.kind == step_kind.local_effect &&
            (ownership_keys.operation(s.operation, s.local.operation) != 0 ||
            ownership_keys.source(s.source, s.local.source_position) != 0)) ||
            (i > 0 && (in->steps[i - 1].block > s.block ||
            (in->steps[i - 1].block == s.block &&
            (in->steps[i - 1].gap > s.gap ||
            (in->steps[i - 1].gap == s.gap && in->steps[i - 1].order >= s.order)))))) {
            return false;
        }
        if (s.kind == step_kind.flag && (s.flag.flag.kind != ownership_api.entity_kind.slot ||
            (s.flag.kind != flag_kind.clear && s.flag.kind != flag_kind.constant &&
            s.flag.from.kind != ownership_api.entity_kind.slot))) { return false; }
        i += 1;
    }
    i = 0;
    while (i < in->flags.len) {
        flag_edge edge = in->flags[i];
        if (edge.block >= fir.block_count(in->function) ||
            edge.flag.kind != ownership_api.entity_kind.slot) { return false; }
        fir.block* from = fir.block_at(in->function, edge.block);
        u32 mut target = 0;
        if (!from->terminated || from->term.kind != fir.term_kind.tk_switch ||
            !fir.term_targets(in->function, &from->term, edge.target_index, &target)) {
            return false;
        }
        i += 1;
    }
    i = 0;
    while (i < in->edges.len) {
        edge_fact edge = in->edges[i];
        if (edge.block >= fir.block_count(in->function) ||
            edge.value_version.kind != ownership_api.entity_kind.value) { return false; }
        fir.block* from = fir.block_at(in->function, edge.block);
        u32 mut target = 0;
        if (!from->terminated || !fir.term_targets(in->function, &from->term,
            edge.target_index, &target)) { return false; }
        i += 1;
    }
    i = 0;
    while (i < in->values.len) {
        value_edge edge = in->values[i];
        if (edge.block >= fir.block_count(in->function) ||
            edge.value_version.kind != ownership_api.entity_kind.value) { return false; }
        fir.block* from = fir.block_at(in->function, edge.block);
        u32 mut target = 0;
        if (!from->terminated || !fir.term_targets(in->function, &from->term,
            edge.target_index, &target)) { return false; }
        i += 1;
    }
    i = 0;
    while (i < in->events.len) {
        event_binding item = in->events[i];
        if (item.key.kind != ownership_api.entity_kind.event ||
            ownership_keys.function(item.key.function, item.operation.function) != 0) {
            return false;
        }
        u64 mut j = 0;
        while (j < i) {
            event_binding before = in->events[j];
            if (same_entity(before.key, item.key) ||
                (ownership_keys.operation(before.operation, item.operation) == 0 &&
                before.kind == item.kind && same_entity(before.relation, item.relation))) {
                return false;
            }
            j += 1;
        }
        i += 1;
    }
    return true;
}

fn loan_index(fir.func* f, u32 id) u32 {
    u32 mut i = 0;
    while (i < fir.loan_count(f)) {
        if (fir.loan_begin_at(f, i)->loan == id) { return i; }
        i += 1;
    }
    return 4294967295;
}

fn same_fir_place(fir.func* f, fir.place a, fir.place b) bool {
    if (cast(a.proj_first, u64) + cast(a.proj_len, u64) > f->projs.len ||
        cast(b.proj_first, u64) + cast(b.proj_len, u64) > f->projs.len) { return false; }
    if (!fir.same_base(a, b) || a.proj_len != b.proj_len) { return false; }
    u32 mut i = 0;
    while (i < a.proj_len) {
        fir.projection x = fir.place_projection(f, a, i);
        fir.projection y = fir.place_projection(f, b, i);
        if (x.kind != y.kind || x.field != y.field || x.index != y.index) { return false; }
        i += 1;
    }
    return true;
}

fn binding_valid(program* in, place_binding b, fir.place actual) bool {
    if (!b.complete || ownership_keys.function(b.function, in->identity) != 0 ||
        !same_fir_place(in->function, b.place, actual) ||
        ownership_state.has_residual(b.storage) ||
        b.storage.root.kind != ownership_api.entity_kind.slot ||
        b.storage.projections.len != cast(actual.proj_len, u64)) { return false; }
    if (actual.base == fir.base_kind.bk_local &&
        (b.storage.root.ordinal != actual.local ||
        ownership_keys.function(b.storage.root.function, in->identity) != 0)) { return false; }
    if (actual.base == fir.base_kind.bk_global) {
        if (b.global != actual.global) { return false; }
        bool mut root_found = actual.proj_len == 0;
        u64 mut j = 0;
        while (j < in->places.len) {
            place_binding related = in->places[j];
            if (fir.same_base(related.place, actual)) {
                if (!same_entity(related.storage.root, b.storage.root)) { return false; }
                if (related.place.proj_len == 0 && related.complete &&
                    related.global == actual.global && related.storage.projections.len == 0 &&
                    !related.storage.residual &&
                    ownership_keys.function(related.function, in->identity) == 0) {
                    root_found = true;
                }
            }
            j += 1;
        }
        if (!root_found) { return false; }
    }
    types.node* mut ty = fir.base_type(in->function, actual);
    u32 mut i = 0;
    while (i < actual.proj_len) {
        fir.projection x = fir.place_projection(in->function, actual, i);
        ownership_api.projection y = b.storage.projections[cast(i, u64)];
        if (x.kind == fir.proj_kind.pj_field &&
            (y.kind != ownership_api.projection_kind.field || y.field != x.field)) {
            return false;
        }
        if (x.kind == fir.proj_kind.pj_deref &&
            y.kind != ownership_api.projection_kind.dereference) { return false; }
        if (x.kind == fir.proj_kind.pj_index) {
            ownership_api.projection_kind expected = ty->kind == types.type_kind.k_array ?
                ownership_api.projection_kind.fixed_index :
                ownership_api.projection_kind.captured_index;
            if (y.kind != expected || y.captured_version.kind != ownership_api.entity_kind.value ||
                y.captured_version.ordinal != x.index ||
                ownership_keys.function(y.captured_version.function, in->identity) != 0) {
                return false;
            }
        }
        ty = fir.apply_projection(in->function, ty, x);
        i += 1;
    }
    return true;
}

fn storage_place(program* in, fir.place actual, ownership_api.place_path mut* out) bool {
    u64 mut i = 0;
    while (i < in->places.len) {
        place_binding b = in->places[i];
        if (same_fir_place(in->function, b.place, actual)) {
            if (!binding_valid(in, b, actual)) { return false; }
            u64 mut j = i + 1;
            while (j < in->places.len) {
                if (same_fir_place(in->function, in->places[j].place, actual)) { return false; }
                j += 1;
            }
            *out = b.storage;
            return true;
        }
        i += 1;
    }
    if (actual.base != fir.base_kind.bk_local || actual.proj_len != 0) { return false; }
    *out = ownership_api.place_path{};
    out->root.function = in->identity;
    out->root.kind = ownership_api.entity_kind.slot;
    out->root.ordinal = actual.local;
    return true;
}

// Resolve only addresses that the executed FIR establishes on this path.
fn resolve_alias(path mut* p, ownership_api.place_path value) ownership_api.place_path {
    if (value.projections.len == 0 ||
        value.projections[0].kind != ownership_api.projection_kind.dereference) { return value; }
    ownership_api.place_path root = ownership_api.place_path{.root = value.root};
    u64 index = ownership_transfer.contents_index(&p->aliases, root);
    if (index == U64_MAX || p->aliases.contents[index].borrows.len != 1) { return value; }
    ownership_api.place_path target = p->aliases.contents[index].borrows[0].containing;
    ownership_api.projection mut@ own parts = new(ownership_api.projection,
        target.projections.len + value.projections.len - 1);
    u64 mut i = 0;
    while (i < target.projections.len) { parts[i] = target.projections[i]; i += 1; }
    u64 mut j = 1;
    while (j < value.projections.len) { parts[i] = value.projections[j]; i += 1; j += 1; }
    ownership_api.place_path mapped = ownership_api.place_path{target.root, parts[..], false};
    ownership_api.place_path saved = ownership_state.copy_place(&p->aliases, mapped);
    del(parts);
    return saved;
}

fn unknown_address(path mut* p, ownership_api.place_path place) bool {
    if (place.projections.len == 0 || place.projections[0].kind !=
        ownership_api.projection_kind.dereference) { return false; }
    ownership_api.place_path root = ownership_api.place_path{.root = place.root};
    u64 index = ownership_transfer.contents_index(&p->aliases, root);
    return index != U64_MAX &&
        p->aliases.contents[index].kind == ownership_api.contents_kind.unknown;
}

fn active_loans(path* p) bool {
    u32 mut i = 0;
    while (i < p->loans.count) {
        if (fir_flow.bits_get(&p->loans, i)) { return true; }
        i += 1;
    }
    return false;
}

fn loan_failure(program* in, ownership_api.operation_position op,
    ownership_api.source_position at, bool known) ownership_api.proof_status {
    return failure(in, op, at, known ? ownership_api.event_kind.invalid_use :
        ownership_api.event_kind.incomplete_proof, known ? ownership_api.incomplete_reason.none :
        ownership_api.incomplete_reason.missing_correspondence, ownership_api.entity_id{},
        known ? "cannot change collection storage during a range loop" :
        "effect preserves collection storage");
}

// A prefix changes the storage path. A fixed extension changes storage inside that path.
// An indirect extension after the collection names an element.
fn protected_target(ownership_api.place_path target, ownership_api.place_path collection) bool {
    if (ownership_places.begins(collection, target)) { return true; }
    if (!ownership_places.begins(target, collection)) { return false; }
    u64 mut i = collection.projections.len;
    while (i < target.projections.len) {
        ownership_api.projection_kind k = target.projections[i].kind;
        if (k == ownership_api.projection_kind.dereference ||
            k == ownership_api.projection_kind.captured_index) { return false; }
        i += 1;
    }
    return true;
}

// Whether no pointer can name `storage`: its path stays in the storage of its root local, and
// FIR never exposes the address of that local. So an unknown address change leaves it in
// place. A field and an index of an inline array (fixed_index) stay in the root storage. A
// captured index selects an element through a span or string header, a dereference loads a
// pointer, and a residual tail covers any projection, so each of them leaves it.
fn fixed_storage(program* in, ownership_api.place_path storage) bool {
    if (storage.residual) { return false; }
    u64 mut i = 0;
    while (i < storage.projections.len) {
        ownership_api.projection_kind k = storage.projections[i].kind;
        if (k != ownership_api.projection_kind.field &&
            k != ownership_api.projection_kind.fixed_index) { return false; }
        i += 1;
    }
    return private_local(in, ownership_api.place_path{.root = storage.root});
}

// The locals of `f` that an `addr` or a `slice` names, in one pass over the statements.
fn exposed_locals(fir.func* f) bool mut@ own {
    bool mut@ own out = new(bool, cast(fir.local_count(f), u64));
    u32 mut b = 0;
    while (b < fir.block_count(f)) {
        u32 mut i = 0;
        while (i < fir.block_statement_count(f, b)) {
            fir.statement* operation_value = fir.block_statement(f, b, i);
            if (operation_value->kind == fir.stmt_kind.st_assign &&
                (operation_value->value.kind == fir.rvalue_kind.rv_addr ||
                operation_value->value.kind == fir.rvalue_kind.rv_slice) &&
                operation_value->value.place.base == fir.base_kind.bk_local) {
                out[cast(operation_value->value.place.local, u64)] = true;
            }
            i += 1;
        }
        b += 1;
    }
    return out;
}

// An unknown pointer cannot name a local whose address FIR never exposes. Without the table
// of exposed locals no local counts as private, which each caller reads as the cautious case.
fn private_local(program* in, ownership_api.place_path place) bool {
    if (place.projections.len != 0 || place.root.kind != ownership_api.entity_kind.slot ||
        ownership_keys.function(place.root.function, in->identity) != 0 ||
        place.root.ordinal >= fir.local_count(in->function) ||
        cast(place.root.ordinal, u64) >= in->exposed.len) { return false; }
    types.node* result_type = in->function->ty->elem;
    if (place.root.ordinal == 0 && fir.type_aggregate(result_type)) { return false; }
    return !in->exposed[cast(place.root.ordinal, u64)];
}

fn check_target(program* in, path mut* p, ownership_api.place_path target,
    bool known, bool unconditional, ownership_api.operation_position op,
    ownership_api.source_position at) ownership_api.proof_status {
    ownership_api.place_path resolved = resolve_alias(p, target);
    u32 mut i = 0;
    while (i < p->loans.count) {
        if (fir_flow.bits_get(&p->loans, i)) {
            loan_state* held = &p->held[cast(i, u64)];
            if (!known || !held->known || ownership_state.has_residual(resolved)) {
                return loan_failure(in, op, at, false);
            }
            if (protected_target(target, held->original) ||
                protected_target(resolved, held->place)) {
                return loan_failure(in, op, at, unconditional);
            }
            if (ownership_places.begins(resolved, held->place) || private_local(in, resolved)) {
                i += 1;
                continue;
            }
            if (ownership_places.compare(resolved, held->place, true) ==
                ownership_places.overlap.possible) { return loan_failure(in, op, at, false); }
        }
        i += 1;
    }
    return complete();
}

fn source_allocation(ownership_state.state* facts, ownership_api.place_path place,
    ownership_api.entity_id allocation, bool mut* known) bool {
    u64 contents = ownership_transfer.contents_index(facts, place);
    if (contents == U64_MAX || facts->contents[contents].kind !=
        ownership_api.contents_kind.reference || facts->contents[contents].borrows.len == 0) {
        *known = false;
        return false;
    }
    bool mut found = false;
    u64 mut i = 0;
    while (i < facts->contents[contents].borrows.len) {
        ownership_api.borrow_relation b = facts->contents[contents].borrows[i];
        u64 source = ownership_state.source_index(facts, b.source);
        if (!b.representation_complete || source == U64_MAX ||
            facts->sources[source].validity != ownership_api.validity_kind.live) { *known = false; }
        else {
            ownership_api.entity_id held = facts->sources[source].allocation;
            if (held.kind == ownership_api.entity_kind.allocation &&
                same_entity(held, allocation)) {
                found = true;
            }
            if (held.kind != ownership_api.entity_kind.allocation &&
                facts->sources[source].kind != ownership_api.source_kind.stack &&
                facts->sources[source].kind != ownership_api.source_kind.static_storage) {
                *known = false;
            }
        }
        i += 1;
    }
    return found;
}

fn check_release(program* in, path mut* p, ownership_api.entity_id allocation,
    bool unconditional, ownership_api.operation_position op, ownership_api.source_position at)
    ownership_api.proof_status {
    u32 mut i = 0;
    while (i < p->loans.count) {
        if (fir_flow.bits_get(&p->loans, i)) {
            loan_state mut* held = &p->held[cast(i, u64)];
            fir.statement* begin = held->begin;
            bool mut known = held->known && allocation.kind == ownership_api.entity_kind.allocation;
            bool mut found = false;
            if (begin->local == 0 && fir.place_type(in->function, begin->place)->kind !=
                types.type_kind.k_array) { known = false; }
            if (begin->local != 0) {
                ownership_api.place_path mut header = ownership_api.place_path{};
                if (!storage_place(in, fir.place_local(begin->local), &header)) { known = false; }
                else { found = source_allocation(&held->facts, header, allocation, &known); }
            }
            u32 mut j = 0;
            while (j < begin->place.proj_len) {
                fir.projection part = fir.place_projection(in->function, begin->place, j);
                fir.place mut prefix = begin->place;
                prefix.proj_len = j;
                types.node* prefix_type = fir.place_type(in->function, prefix);
                bool indirect = part.kind == fir.proj_kind.pj_deref ||
                    (part.kind == fir.proj_kind.pj_index &&
                    (prefix_type->kind == types.type_kind.k_span ||
                    prefix_type->kind == types.type_kind.k_string));
                if (indirect) {
                    ownership_api.place_path mut pointer = ownership_api.place_path{};
                    if (!storage_place(in, prefix, &pointer)) { known = false; }
                    else if (source_allocation(&held->facts, pointer, allocation, &known)) {
                        found = true;
                    }
                }
                j += 1;
            }
            if (found) { return loan_failure(in, op, at, unconditional); }
            if (!known) { return loan_failure(in, op, at, false); }
        }
        i += 1;
    }
    return complete();
}

fn check_fir_target(program* in, path mut* p, fir.place target,
    ownership_api.operation_position op, ownership_api.source_position at)
    ownership_api.proof_status {
    if (!active_loans(p)) { return complete(); }
    ownership_api.place_path mut mapped = ownership_api.place_path{};
    bool known = storage_place(in, target, &mapped);
    return check_target(in, p, mapped, known, true, op, at);
}

fn invalidate_aliases(program* in, path mut* p, ownership_api.place_path target,
    bool known) void {
    if (!known) {
        if (p->held.len > 0) { p->loan_sources_unknown = true; }
        ownership_state.free(&p->aliases);
        p->aliases = ownership_state.empty();
        return;
    }
    ownership_api.place_path resolved = resolve_alias(p, target);
    u64 mut i = 0;
    while (i < p->aliases.contents_len) {
        ownership_api.place_path pointer = p->aliases.contents[i].place;
        if (protected_target(target, pointer) || protected_target(resolved, pointer) ||
            (!private_local(in, pointer) && ownership_places.compare(resolved, pointer, true) ==
                ownership_places.overlap.possible)) {
            p->aliases.contents[i].borrows = p->aliases.contents[i].borrows[0..0];
            p->aliases.contents[i].kind = ownership_api.contents_kind.unknown;
        }
        i += 1;
    }
}

fn invalidate_fir_aliases(program* in, path mut* p, fir.place target) void {
    ownership_api.place_path mut mapped = ownership_api.place_path{};
    bool known = storage_place(in, target, &mapped);
    invalidate_aliases(in, p, mapped, known);
}

fn note_alias(program* in, path mut* p, fir.statement* operation_value) void {
    if (operation_value->kind != fir.stmt_kind.st_assign) { return; }
    ownership_api.place_path mut destination = ownership_api.place_path{};
    if (!storage_place(in, operation_value->place, &destination)) {
        invalidate_aliases(in, p, destination, false);
        return;
    }
    ownership_api.place_path resolved = resolve_alias(p, destination);
    ownership_api.place_path mut target = ownership_api.place_path{};
    bool address = operation_value->value.kind == fir.rvalue_kind.rv_addr &&
        storage_place(in, operation_value->value.place, &target);
    if (address) { target = resolve_alias(p, target); }
    invalidate_aliases(in, p, destination, true);
    if (!address) { return; }
    ownership_api.borrow_relation[1] relation = {
        ownership_api.borrow_relation{.containing = target},
    };
    ownership_api.contents_fact fact = ownership_api.contents_fact{
        .place = resolved, .kind = ownership_api.contents_kind.reference,
        .borrows = relation[..]};
    u64 old = ownership_transfer.contents_index(&p->aliases, resolved);
    if (old == U64_MAX) { ownership_state.append_contents(&p->aliases, fact); }
    else { p->aliases.contents[old] = ownership_state.copy_contents(&p->aliases, fact); }
}

fn direct_effect(program* in, path mut* p, u32 block, u32 gap)
    ownership_api.proof_status {
    if (gap >= fir.block_statement_count(in->function, block)) { return complete(); }
    fir.statement* operation_value = fir.block_statement(in->function, block, gap);
    bool address = operation_value->kind == fir.stmt_kind.st_assign &&
        operation_value->value.kind == fir.rvalue_kind.rv_addr;
    bool call = operation_value->kind == fir.stmt_kind.st_assign &&
        operation_value->value.kind == fir.rvalue_kind.rv_call && p->held.len > 0;
    if (!active_loans(p) && p->aliases.contents_len == 0 && !address && !call &&
        operation_value->kind != fir.stmt_kind.st_loan_begin &&
        operation_value->kind != fir.stmt_kind.st_loan_end) { return complete(); }
    ownership_api.operation_position op = ownership_api.operation_position{
        .function = in->identity, .block = block, .operation = gap};
    ownership_api.source_position at = location_source(in, operation_value->loc);
    ownership_api.charge_result charged = ownership_api.charge_work(in->services,
        ownership_api.work_kind.transfer, op, at);
    if (!charged.allowed) { return charged_failure(in, charged.proof, op, at); }

    if (operation_value->kind == fir.stmt_kind.st_loan_begin ||
        operation_value->kind == fir.stmt_kind.st_loan_end) {
        u32 index = loan_index(in->function, operation_value->loan);
        if (index == 4294967295) { return invalid_input(in); }
        if (operation_value->kind == fir.stmt_kind.st_loan_begin) {
            ownership_api.place_path mut storage = ownership_api.place_path{};
            bool known = storage_place(in, operation_value->place, &storage);
            // Unknown address changes cannot move a collection that no pointer can name.
            if (p->loan_sources_unknown && !(known && fixed_storage(in, storage))) {
                return loan_failure(in, op, at, false);
            }
            fir_flow.bits_set(&p->loans, index);
            loan_state mut* held = &p->held[cast(index, u64)];
            ownership_state.free(&held->facts);
            held->facts = ownership_state.clone(&p->facts);
            held->begin = operation_value;
            held->known = known;
            held->original = ownership_state.copy_place(&held->facts, storage);
            held->place = ownership_state.copy_place(&held->facts, resolve_alias(p, storage));
            if (unknown_address(p, storage) || unknown_address(p, held->place)) {
                held->known = false;
            }
            if (!held->known) {
                return loan_failure(in, op, at, false);
            }
        } else {
            fir_flow.bits_clear(&p->loans, index);
            ownership_state.free(&p->held[cast(index, u64)].facts);
            p->held[cast(index, u64)] = loan_state{};
        }
        return complete();
    }
    if (operation_value->kind == fir.stmt_kind.st_dead) {
        fir.place ended = fir.place_local(operation_value->local);
        ownership_api.proof_status proof = check_fir_target(in, p, ended, op, at);
        if (ownership_api.successful(proof)) { invalidate_fir_aliases(in, p, ended); }
        return proof;
    }
    fir.place mut target = fir.place{};
    if (fir.stmt_writes_place(operation_value, &target)) {
        ownership_api.proof_status proof = check_fir_target(in, p, target, op, at);
        if (!ownership_api.successful(proof)) { return proof; }
    }
    u32 mut i = 0;
    fir.read mut read_value = fir.read{};
    while (fir.stmt_read(in->function, operation_value, i, &read_value)) {
        if (read_value.empties) {
            ownership_api.proof_status proof = check_fir_target(in, p, read_value.place, op, at);
            if (!ownership_api.successful(proof)) { return proof; }
            invalidate_fir_aliases(in, p, read_value.place);
        }
        i += 1;
    }
    if (operation_value->kind == fir.stmt_kind.st_del && active_loans(p)) {
        ownership_api.place_path mut storage = ownership_api.place_path{};
        bool known = storage_place(in, operation_value->place, &storage);
        u64 index = known ? ownership_transfer.owner_index(&p->facts, storage) : U64_MAX;
        ownership_api.entity_id allocation = index == U64_MAX ? ownership_api.entity_id{} :
            p->facts.allocations[index].key;
        u64 contents = known ? ownership_transfer.contents_index(&p->facts, storage) : U64_MAX;
        bool empty = contents != U64_MAX &&
            ownership_transfer.empty_owner_proved(p->facts.contents[contents]) &&
            ownership_transfer.owner_count(&p->facts, storage) == 0 &&
            ownership_transfer.owner_overlap(&p->facts, storage) ==
                ownership_transfer.overlap_kind.none;
        if (!empty) {
            ownership_api.proof_status proof = check_release(in, p, allocation, true, op, at);
            if (!ownership_api.successful(proof)) { return proof; }
        }
    }
    note_alias(in, p, operation_value);
    return complete();
}

fn effect_place_known(program* in, ownership_api.place_path target) bool {
    if (ownership_state.has_residual(target)) { return false; }
    u64 mut i = 0;
    while (i < in->places.len) {
        place_binding binding = in->places[i];
        if (ownership_state.same_place(binding.storage, target)) {
            return binding_valid(in, binding, binding.place);
        }
        i += 1;
    }
    return target.root.kind == ownership_api.entity_kind.slot &&
        ownership_keys.function(target.root.function, in->identity) == 0 &&
        target.root.ordinal < fir.local_count(in->function) && target.projections.len == 0;
}

fn ordered_effects(program* in, path mut* p, step* s, ownership_api.outcome_fact outcome)
    ownership_api.proof_status {
    u64 mut i = 0;
    while (i < outcome.effects.len) {
        ownership_api.ordered_effect effect = outcome.effects[i];
        ownership_api.proof_status mut proof = complete();
        bool unconditional = effect.guard.kind == ownership_api.entity_kind.none &&
            outcome.guard.kind == ownership_api.entity_kind.none;
        if (effect.kind == ownership_api.effect_kind.write ||
            effect.kind == ownership_api.effect_kind.invalidate ||
            effect.kind == ownership_api.effect_kind.transfer ||
            effect.kind == ownership_api.effect_kind.storage_end) {
            proof = check_target(in, p, effect.place,
                effect_place_known(in, effect.place), unconditional,
                s->operation, s->source);
        } else if (effect.kind == ownership_api.effect_kind.release) {
            proof = check_release(in, p, effect.allocation, unconditional,
                s->operation, s->source);
        }
        if (!ownership_api.successful(proof)) { return proof; }
        if (effect.kind == ownership_api.effect_kind.write ||
            effect.kind == ownership_api.effect_kind.invalidate ||
            effect.kind == ownership_api.effect_kind.transfer ||
            effect.kind == ownership_api.effect_kind.storage_end) {
            invalidate_aliases(in, p, effect.place, effect_place_known(in, effect.place));
        }
        i += 1;
    }
    return complete();
}

fn invalidate_version(path mut* p, ownership_api.entity_id version) void {
    if (version.kind != ownership_api.entity_kind.value) { return; }
    u64 mut i = 0;
    while (i < p->facts.predicates_len) {
        if (same_entity(p->facts.predicates[i].left, version) &&
            p->facts.predicates[i].kind == ownership_api.predicate_kind.nullness) {
            u64 mut j = i + 1;
            while (j < p->facts.predicates_len) {
                p->facts.predicates[j - 1] = p->facts.predicates[j];
                j += 1;
            }
            p->facts.predicates_len -= 1;
        } else { i += 1; }
    }
}

fn unknown_call(path mut* p) void {
    p->uncertain_return = true;
    p->loan_sources_unknown = true;
    ownership_state.free(&p->aliases);
    p->aliases = ownership_state.empty();
    p->facts.predicates_len = 0;
    u64 mut i = 0;
    while (i < p->facts.sources_len) {
        if (p->facts.sources[i].kind != ownership_api.source_kind.trusted_foreign) {
            p->facts.sources[i].validity = ownership_api.validity_kind.unknown;
        }
        i += 1;
    }
    i = 0;
    while (i < p->facts.allocations_len) {
        if (p->facts.allocations[i].obligation) {
            p->facts.allocations[i].validity = ownership_api.validity_kind.unknown;
        }
        i += 1;
    }
}

fn call_continues(program* in, path mut* p, step* s, analysis mut* out) bool {
    if (!s->outcomes_complete && active_loans(p)) {
        note_failure(out, failure(in, s->operation, s->source,
            ownership_api.event_kind.incomplete_proof,
            ownership_api.incomplete_reason.unknown_effect, ownership_api.entity_id{},
            "call preserves collection storage"));
        return false;
    }
    if (!s->outcomes_complete) { unknown_call(p); return true; }
    bool mut possible = false;
    u64 mut i = 0;
    while (i < s->outcomes.len) {
        ownership_api.outcome_fact outcome = s->outcomes[i];
        if (active_loans(p)) {
            if (outcome.kind == ownership_api.outcome_kind.unknown_fort ||
                outcome.kind == ownership_api.outcome_kind.unresolved_foreign) {
                note_failure(out, failure(in, s->operation, s->source,
                    ownership_api.event_kind.incomplete_proof,
                    ownership_api.incomplete_reason.unknown_effect, ownership_api.entity_id{},
                    "call preserves collection storage"));
                return false;
            }
        }
        ownership_api.proof_status proof = ordered_effects(in, p, s, outcome);
        if (!ownership_api.successful(proof)) { note_failure(out, proof); return false; }
        if (outcome.guard.kind != ownership_api.entity_kind.none &&
            (outcome.kind == ownership_api.outcome_kind.function_return ||
            outcome.kind == ownership_api.outcome_kind.normal_process_exit ||
            outcome.kind == ownership_api.outcome_kind.unknown_fort ||
            outcome.kind == ownership_api.outcome_kind.unresolved_foreign ||
            outcome.possible_caller_return)) {
            note_failure(out, failure(in, s->operation, s->source,
                ownership_api.event_kind.incomplete_proof,
                ownership_api.incomplete_reason.missing_path, outcome.guard,
                "cannot compose guarded call return"));
            i += 1;
            continue;
        }
        if (outcome.kind == ownership_api.outcome_kind.unknown_fort ||
            outcome.kind == ownership_api.outcome_kind.unresolved_foreign) {
            unknown_call(p);
            possible = true;
        } else if (outcome.kind == ownership_api.outcome_kind.normal_process_exit) {
            note_failure(out, failure(in, s->operation, s->source,
                ownership_api.event_kind.incomplete_proof,
                ownership_api.incomplete_reason.missing_globals,
                ownership_api.entity_id{}, "normal process cleanup"));
        } else if (outcome.kind == ownership_api.outcome_kind.function_return ||
            outcome.possible_caller_return) { possible = true; }
        i += 1;
    }
    return possible;
}

// The handler checks no collection loan. A direct call inside an open loan fails before
// this step, as an unknown call does (`apply_steps`).
// A missing handler or a failed application stops this path with its recorded failure.
// A path without a normal continuation ends here. An unresolved call keeps its obligations.
fn direct_call(program* in, analysis mut* out, path mut* p, step* s) bool {
    if (in->call_handler == null) {
        note_failure(out, failure(in, s->operation, s->source,
            ownership_api.event_kind.incomplete_proof,
            ownership_api.incomplete_reason.unknown_effect, ownership_api.entity_id{},
            "direct call has no summary handler"));
        return false;
    }
    call_verdict verdict = in->call_handler(in->call_context, s, &p->facts);
    if (!ownership_api.successful(verdict.proof)) {
        note_failure(out, verdict.proof);
        return false;
    }
    if (verdict.unknown) {
        unknown_call(p);
        return true;
    }
    return verdict.continues;
}

// Whether some contents fact of `s` borrows `source`.
fn borrowed(ownership_state.state* s, ownership_api.entity_id source) bool {
    u64 mut c = 0;
    while (c < s->contents_len) {
        ownership_api.contents_fact value = s->contents[c];
        u64 mut b = 0;
        while (b < value.borrows.len) {
            if (same_entity(value.borrows[b].source, source)) { return true; }
            b += 1;
        }
        c += 1;
    }
    return false;
}

// A detached allocation escaped from local proof: storage outside it owns its obligation.
fn escaped_at(ownership_state.state* s, u64 a) bool {
    return s->allocations[a].obligation && s->allocations[a].owner.detached;
}

fn released_at(ownership_state.state* s, u64 a, u64 source) bool {
    return !s->allocations[a].obligation &&
        s->allocations[a].validity == ownership_api.validity_kind.released &&
        s->sources[source].validity == ownership_api.validity_kind.released;
}

fn site_failure(program* in, step* s, string message) ownership_api.proof_status {
    return failure(in, s->operation, s->source, ownership_api.event_kind.incomplete_proof,
        ownership_api.incomplete_reason.missing_path, s->local.allocation.key, message);
}

// Reuse a site identity only after its released source has no retained relation. With earlier
// identities, a live or borrowed allocation of the site takes them instead (D17.16).
fn retire_released_site(program* in, path mut* p, step* s)
    ownership_api.proof_status {
    ownership_transfer.request* selected = &s->local;
    u64 a = ownership_state.allocation_index(&p->facts, selected->allocation.key);
    u64 source = ownership_state.source_index(&p->facts, selected->fresh_source.key);
    if (a == U64_MAX && source == U64_MAX) { return complete(); }
    if (a == U64_MAX || source == U64_MAX || p->facts.nodes_len > 0 ||
        p->facts.edges_len > 0 || p->facts.regions_len > 0 || p->facts.shapes_len > 0) {
        return site_failure(in, s, "cannot separate repeated allocation site identities");
    }
    bool retirable = escaped_at(&p->facts, a) || released_at(&p->facts, a, source);
    bool views = borrowed(&p->facts, selected->fresh_source.key);
    if (retirable && !views) { return retire(in, p, s, a, source); }
    if (s->earlier.allocation.kind == ownership_api.entity_kind.allocation) {
        return rekey(in, p, s);
    }
    if (!retirable) {
        return site_failure(in, s, "cannot separate repeated allocation site identities");
    }
    return site_failure(in, s, "old borrow keeps a released site identity");
}

// Moves the allocation at `a` and its source out of the path facts into the retired state.
fn retire(program* in, path mut* p, step* s, u64 a, u64 source)
    ownership_api.proof_status {
    ownership_transfer.request* selected = &s->local;
    ownership_api.charge_result charged = ownership_api.charge_work(in->services,
        ownership_api.work_kind.transfer, s->operation, s->source);
    if (!charged.allowed) {
        return charged_failure(in, charged.proof, s->operation, s->source);
    }
    ownership_state.state mut one = ownership_state.empty();
    ownership_state.append_allocations(&one, p->facts.allocations[a]);
    ownership_state.append_sources(&one, p->facts.sources[source]);
    ownership_state.state mut old = ownership_state.empty();
    if (p->retired.allocations_len == 0 && p->retired.sources_len == 0) {
        old = move(one);
    } else {
        event_bridge mut bridge = event_bridge{};
        ownership_api.services mapped = mapped_services(in, &bridge);
        old = ownership_join.widen(&p->retired, &one, &mapped, in->limits,
            s->operation, s->source);
        ownership_state.free(&one);
        if (!ownership_api.successful(old.proof)) {
            ownership_api.proof_status proof = old.proof;
            ownership_state.free(&old);
            return proof;
        }
    }
    ownership_state.free(&p->retired);
    p->retired = move(old);
    u64 mut i = a + 1;
    while (i < p->facts.allocations_len) {
        p->facts.allocations[i - 1] = p->facts.allocations[i];
        i += 1;
    }
    p->facts.allocations_len -= 1;
    i = source + 1;
    while (i < p->facts.sources_len) {
        p->facts.sources[i - 1] = p->facts.sources[i];
        i += 1;
    }
    p->facts.sources_len -= 1;
    ownership_api.lost_fact mut retired = ownership_api.lost_fact{};
    retired.category = ownership_api.limit_category.r;
    retired.bound = in->limits->r;
    retired.first_source = s->source;
    retired.relation = selected->allocation.site;
    u64 mut l = 0;
    while (l < p->facts.losses_len) {
        if (ownership_state.same_loss(p->facts.losses[l], retired)) { return complete(); }
        l += 1;
    }
    ownership_state.append_losses(&p->facts, retired);
    return complete();
}

// Whether some allocation, source, contents or predicate fact of `s` names `key`.
fn names_entity(ownership_state.state* s, ownership_api.entity_id key) bool {
    u64 mut i = 0;
    while (i < s->allocations_len) {
        ownership_api.allocation_fact fact = s->allocations[i];
        if (same_entity(fact.key, key) || same_entity(fact.logical_length.symbol, key)) {
            return true;
        }
        i += 1;
    }
    i = 0;
    while (i < s->sources_len) {
        if (same_entity(s->sources[i].key, key) || same_entity(s->sources[i].allocation, key)) {
            return true;
        }
        i += 1;
    }
    i = 0;
    while (i < s->contents_len) {
        ownership_api.contents_fact value = s->contents[i];
        if (same_entity(value.value_version, key) ||
            same_entity(value.span_length.symbol, key)) { return true; }
        u64 mut b = 0;
        while (b < value.borrows.len) {
            ownership_api.borrow_relation relation = value.borrows[b];
            if (same_entity(relation.key, key) || same_entity(relation.value_version, key) ||
                same_entity(relation.source, key) || same_entity(relation.range.source, key)) {
                return true;
            }
            b += 1;
        }
        i += 1;
    }
    i = 0;
    while (i < s->predicates_len) {
        if (same_entity(s->predicates[i].left, key) ||
            same_entity(s->predicates[i].right, key)) { return true; }
        i += 1;
    }
    return false;
}

// Gives the earlier allocation of a site its earlier identities, so that the new allocation
// takes the site identities (D17.16). An allocation that holds the earlier identities leaves
// first. It leaves only when it is released or escaped and no contents fact borrows it.
// Otherwise two earlier allocations would need one identity, and the proof stays incomplete.
fn rekey(program* in, path mut* p, step* s) ownership_api.proof_status {
    site_identity e = s->earlier;
    if (p->facts.guards_len > 0 || p->facts.correlations_len > 0 || active_loans(p) ||
        p->aliases.contents_len > 0 || p->aliases.sources_len > 0) {
        return site_failure(in, s, "cannot separate repeated allocation site identities");
    }
    u64 ea = ownership_state.allocation_index(&p->facts, e.allocation);
    u64 es = ownership_state.source_index(&p->facts, e.source);
    if (ea != U64_MAX || es != U64_MAX) {
        if (ea == U64_MAX || es == U64_MAX ||
            !(escaped_at(&p->facts, ea) || released_at(&p->facts, ea, es)) ||
            borrowed(&p->facts, e.source)) {
            return site_failure(in, s, "cannot separate repeated allocation site identities");
        }
        ownership_api.proof_status left = retire(in, p, s, ea, es);
        if (!ownership_api.successful(left)) { return left; }
    }
    ownership_transfer.request* selected = &s->local;
    u64 a = ownership_state.allocation_index(&p->facts, selected->allocation.key);
    u64 source = ownership_state.source_index(&p->facts, selected->fresh_source.key);
    if (names_entity(&p->facts, e.allocation) || names_entity(&p->facts, e.source) ||
        names_entity(&p->facts, e.value) || names_entity(&p->facts, e.relation)) {
        return site_failure(in, s, "cannot separate repeated allocation site identities");
    }
    ownership_api.charge_result charged = ownership_api.charge_work(in->services,
        ownership_api.work_kind.transfer, s->operation, s->source);
    if (!charged.allowed) {
        return charged_failure(in, charged.proof, s->operation, s->source);
    }
    rename_site(&p->facts, s, a, source);
    return complete();
}

fn renamed(ownership_api.entity_id key, ownership_api.entity_id from,
    ownership_api.entity_id to) ownership_api.entity_id {
    if (same_entity(key, from)) { return to; }
    return key;
}

fn renamed_length(ownership_api.scalar_fact length, ownership_api.entity_id from,
    ownership_api.entity_id to) ownership_api.scalar_fact {
    ownership_api.scalar_fact mut out = length;
    if (out.kind == ownership_api.fact_kind.symbolic) {
        out.symbol = renamed(out.symbol, from, to);
    }
    return out;
}

// Whether a borrow of `borrows` names the relation, the value version or the source of a site.
fn borrows_name(ownership_api.borrow_relation@ borrows, ownership_api.entity_id relation,
    ownership_api.entity_id version, ownership_api.entity_id fresh) bool {
    u64 mut b = 0;
    while (b < borrows.len) {
        ownership_api.borrow_relation item = borrows[b];
        if (same_entity(item.key, relation) || same_entity(item.value_version, version) ||
            same_entity(item.source, fresh) || same_entity(item.range.source, fresh)) {
            return true;
        }
        b += 1;
    }
    return false;
}

// Renames the site identities of step `s` to its earlier identities in every fact that names
// them: the allocation and its history, the source, the value version, and each borrow. The
// renamed facts describe the same storage, so the path keeps every obligation and relation.
fn rename_site(ownership_state.state mut* facts, step* s, u64 a, u64 source) void {
    site_identity e = s->earlier;
    ownership_transfer.request* selected = &s->local;
    ownership_api.entity_id key = selected->allocation.key;
    ownership_api.entity_id fresh = selected->fresh_source.key;
    ownership_api.entity_id version = selected->value.value_version;
    ownership_api.entity_id mut relation = ownership_api.entity_id{};
    if (selected->value.borrows.len == 1) { relation = selected->value.borrows[0].key; }
    ownership_api.allocation_fact mut allocation = facts->allocations[a];
    allocation.key = e.allocation;
    allocation.logical_length = renamed_length(allocation.logical_length, version, e.value);
    ownership_api.history_fact mut@ own history =
        new(ownership_api.history_fact, allocation.history.len);
    defer del(history);
    u64 mut i = 0;
    while (i < history.len) {
        history[i] = allocation.history[i];
        history[i].allocation = renamed(history[i].allocation, key, e.allocation);
        i += 1;
    }
    allocation.history = ownership_state.copy_histories(facts, history[..]);
    facts->allocations[a] = allocation;
    facts->sources[source].key = e.source;
    facts->sources[source].allocation = e.allocation;
    i = 0;
    while (i < facts->contents_len) {
        ownership_api.contents_fact mut value = facts->contents[i];
        value.value_version = renamed(value.value_version, version, e.value);
        value.span_length = renamed_length(value.span_length, version, e.value);
        // Only a fact whose borrows name the site gets new borrow storage.
        if (!borrows_name(value.borrows, relation, version, fresh)) {
            facts->contents[i] = value;
            i += 1;
            continue;
        }
        ownership_api.borrow_relation mut@ own borrows =
            new(ownership_api.borrow_relation, value.borrows.len);
        u64 mut b = 0;
        while (b < borrows.len) {
            borrows[b] = value.borrows[b];
            borrows[b].key = renamed(borrows[b].key, relation, e.relation);
            borrows[b].value_version = renamed(borrows[b].value_version, version, e.value);
            borrows[b].source = renamed(borrows[b].source, fresh, e.source);
            borrows[b].range.source = renamed(borrows[b].range.source, fresh, e.source);
            b += 1;
        }
        value.borrows = ownership_state.copy_borrows(facts, borrows[..]);
        del(borrows);
        facts->contents[i] = value;
        i += 1;
    }
    i = 0;
    while (i < facts->predicates_len) {
        facts->predicates[i].left = renamed(facts->predicates[i].left, version, e.value);
        facts->predicates[i].right = renamed(facts->predicates[i].right, version, e.value);
        i += 1;
    }
}

fn apply_steps(program* in, analysis mut* out, path mut* p, u32 block) bool {
    u32 count = fir.block_statement_count(in->function, block);
    u64 first = out->step_first[cast(block, u64)];
    u64 last = out->step_first[cast(block, u64) + 1];
    u32 mut gap = 0;
    while (gap <= count) {
        ownership_api.proof_status direct = direct_effect(in, p, block, gap);
        if (!ownership_api.successful(direct)) {
            note_failure(out, direct);
            note_stop(out, block, gap, 0);
            return false;
        }
        if (gap < count) {
            fir.statement* operation_value = fir.block_statement(in->function, block, gap);
            if (operation_value->kind == fir.stmt_kind.st_assign &&
                operation_value->value.kind == fir.rvalue_kind.rv_call) {
                bool mut found = false;
                u64 mut call_i = first;
                while (call_i < last) {
                    step supplied = in->steps[call_i];
                    if (supplied.gap == gap && supplied.kind == step_kind.call_outcome) {
                        found = true;
                    }
                    call_i += 1;
                }
                if (!found && !active_loans(p)) {
                    ownership_state.free(&p->aliases);
                    p->aliases = ownership_state.empty();
                    if (p->held.len > 0) { p->loan_sources_unknown = true; }
                }
                else if (!found) {
                    ownership_api.operation_position op = ownership_api.operation_position{
                        .function = in->identity, .block = block, .operation = gap};
                    note_failure(out, failure(in, op, ownership_api.source_position{},
                        ownership_api.event_kind.incomplete_proof,
                        ownership_api.incomplete_reason.unknown_effect, ownership_api.entity_id{},
                        "call preserves collection storage"));
                    note_stop(out, block, gap, 0);
                    return false;
                }
            }
        }
        u64 mut i = first;
        while (i < last) {
            step mut s = in->steps[i];
            if (s.gap == gap) {
                ownership_api.proof_status mut proof = complete();
                if (stops_settled(p, &s)) {
                    note_stop(out, block, gap, rank_of(&s));
                    return false;
                }
                if (s.kind != step_kind.local_effect) {
                    ownership_api.charge_result charged = ownership_api.charge_work(
                        in->services, ownership_api.work_kind.transfer,
                        s.operation, s.source);
                    if (!charged.allowed) {
                        note_failure(out, charged_failure(in, charged.proof,
                            s.operation, s.source));
                        note_stop(out, block, gap, rank_of(&s));
                        return false;
                    }
                }
                if (s.kind == step_kind.local_effect) {
                    if (in->observed != null && i < in->observed->step_attempts.len) {
                        in->observed->step_attempts[i] += 1;
                        if (p->uncertain_return) { in->observed->step_uncertain[i] += 1; }
                    }
                    // A step on a settled slot counts as an attempt and does not run.
                    settling kept = skip_settled(in, out, p, &s);
                    if (kept == settling.stop) {
                        note_stop(out, block, gap, rank_of(&s));
                        return false;
                    }
                    if (kept == settling.skip) {
                        i += 1;
                        continue;
                    }
                    if (s.local.kind == ownership_transfer.action.allocation) {
                        proof = retire_released_site(in, p, &s);
                    }
                    if (!ownership_api.successful(proof)) {
                        note_failure(out, proof);
                        note_stop(out, block, gap, rank_of(&s));
                        return false;
                    }
                    proof = ownership_transfer.apply(&p->facts, in->services, &s.local);
                    if (ownership_api.successful(proof)) {
                        invalidate_version(p, s.invalidates);
                    }
                } else if (s.kind == step_kind.invalidate_value) {
                    invalidate_version(p, s.invalidates);
                } else if (s.kind == step_kind.flag) {
                    if (stale_null_test(in, p, &s)) { forget_flag(p, s.flag.flag); }
                    else { proof = apply_flag(in, p, &s); }
                } else if (s.kind == step_kind.direct_call) {
                    // A failed application stops the path, so it records the stop too.
                    u64 before = out->failures;
                    if (!direct_call(in, out, p, &s)) {
                        if (out->failures > before) { note_stop(out, block, gap, rank_of(&s)); }
                        return false;
                    }
                } else {
                    invalidate_version(p, s.invalidates);
                    if (!call_continues(in, p, &s, out)) {
                        note_stop(out, block, gap, rank_of(&s));
                        return false;
                    }
                }
                if (!ownership_api.successful(proof)) {
                    note_failure(out, proof);
                    if (!continues_after(in, out, p, &s, proof)) {
                        note_stop(out, block, gap, rank_of(&s));
                        return false;
                    }
                }
            }
            i += 1;
        }
        gap += 1;
    }
    return true;
}

fn return_position(program* in, u32 block) ownership_api.operation_position {
    ownership_api.operation_position mut op = ownership_api.operation_position{};
    op.function = in->identity;
    op.block = block;
    op.operation = fir.block_statement_count(in->function, block);
    op.terminator = true;
    return op;
}

fn location_source(program* in, diag.loc where) ownership_api.source_position {
    ownership_api.source_position mut at = ownership_api.source_position{};
    at.filename_present = where.file.len > 0;
    u64 mut i = 0;
    while (i < in->source_files.len) {
        source_file_binding file_at = in->source_files[i];
        if (file_at.filename == where.file) {
            at.module = file_at.module;
            at.file = file_at.file;
            break;
        }
        i += 1;
    }
    at.line = where.line;
    at.col = where.col;
    at.end_line = where.end_line;
    at.end_col = where.end_col;
    return at;
}

fn return_source(program* in, u32 block) ownership_api.source_position {
    return location_source(in, fir.block_at(in->function, block)->term.loc);
}

fn source_filename(void mut* opaque, ownership_api.source_position at) string {
    if (opaque == null || !at.filename_present) { return ""; }
    program* in = cast(opaque, program*);
    u64 mut i = 0;
    while (i < in->source_files.len) {
        source_file_binding file_at = in->source_files[i];
        if (file_at.module == at.module && file_at.file == at.file) {
            return file_at.filename;
        }
        i += 1;
    }
    return "";
}

fn complete_return_relation(ownership_api.contents_fact value,
    ownership_api.borrow_relation relation) bool {
    return !value.place.residual && value.kind == ownership_api.contents_kind.reference &&
        !value.owner_empty && value.value_version.kind == ownership_api.entity_kind.value &&
        relation.representation_complete &&
        same_entity(relation.value_version, value.value_version);
}

fn check_returned_borrows(program* in, analysis mut* out, path* p,
    ownership_api.operation_position op) void {
    if (in->result_slot.kind == ownership_api.entity_kind.none) { return; }
    ownership_api.source_position at = return_source(in, op.block);
    bool mut found = false;
    bool mut reference_leaf = false;
    u64 mut c = 0;
    while (c < p->facts.contents_len) {
        ownership_api.contents_fact value = p->facts.contents[c];
        if (same_entity(value.place.root, in->result_slot)) {
            found = true;
            if (value.kind == ownership_api.contents_kind.aggregate) {
                c += 1;
                continue;
            }
            if (value.kind == ownership_api.contents_kind.scalar &&
                value.place.projections.len > 0) {
                c += 1;
                continue;
            }
            reference_leaf = true;
            bool empty = (value.kind == ownership_api.contents_kind.reference ||
                value.kind == ownership_api.contents_kind.empty_owner) &&
                value.owner_empty && value.borrows.len == 0 &&
                value.span_length.kind == ownership_api.fact_kind.exact &&
                value.span_length.value == 0;
            if (empty) { c += 1; continue; }
            if (value.place.residual || value.kind != ownership_api.contents_kind.reference ||
                value.owner_empty || value.value_version.kind != ownership_api.entity_kind.value ||
                value.borrows.len == 0) {
                note_failure(out, failure(in, op, at,
                    ownership_api.event_kind.incomplete_proof,
                    ownership_api.incomplete_reason.missing_correspondence,
                    ownership_api.entity_id{}, "returned reference contents"));
                c += 1;
                continue;
            }
            u64 mut b = 0;
            while (b < value.borrows.len) {
                ownership_api.borrow_relation relation = value.borrows[b];
                if (!complete_return_relation(value, relation)) {
                    note_failure(out, failure(in, op, at,
                        ownership_api.event_kind.incomplete_proof,
                        ownership_api.incomplete_reason.missing_correspondence, relation.source,
                        "returned borrow representation"));
                    b += 1;
                    continue;
                }
                u64 source = ownership_state.source_index(&p->facts, relation.source);
                if (source == U64_MAX ||
                    p->facts.sources[source].validity == ownership_api.validity_kind.unknown) {
                    note_failure(out, failure(in, op, at,
                        ownership_api.event_kind.incomplete_proof,
                        ownership_api.incomplete_reason.missing_correspondence, relation.source,
                        "returned view source live"));
                } else if (p->facts.sources[source].validity !=
                    ownership_api.validity_kind.live) {
                    note_failure(out, failure(in, op, at,
                        ownership_api.event_kind.invalid_use,
                        ownership_api.incomplete_reason.none, relation.source,
                        "returned view outlives its source"));
                }
                b += 1;
            }
        }
        c += 1;
    }
    if (!found || !reference_leaf) {
        note_failure(out, failure(in, op, at,
            ownership_api.event_kind.incomplete_proof,
            ownership_api.incomplete_reason.missing_correspondence,
            ownership_api.entity_id{}, "returned reference contents"));
    }
}

fn parameter_return(program* in, analysis mut* out, path mut* p, u32 block) void {
    ownership_api.operation_position op = return_position(in, block);
    ownership_api.source_position at = return_source(in, block);
    // A settled result slot holds a value that the path does not know.
    if (!settled_result(in, p)) { check_returned_borrows(in, out, p, op); }
    u64 mut i = 0;
    while (i < in->parameters.len) {
        parameter param = in->parameters[i];
        u64 mut a = 0;
        while (a < p->facts.allocations_len) {
            ownership_api.allocation_fact alloc = p->facts.allocations[a];
            if (same_entity(alloc.owner.place.root, param.slot) && alloc.obligation &&
                (alloc.count.one || alloc.count.many)) {
                if (alloc.count.zero ||
                    alloc.validity != ownership_api.validity_kind.live ||
                    alloc.owner.place.residual || alloc.owner.detached ||
                    alloc.owner.transfer_pending) {
                    note_failure(out, failure(in, op, at,
                        ownership_api.event_kind.incomplete_proof,
                        ownership_api.incomplete_reason.missing_path, alloc.key,
                        "parameter storage has no live owner"));
                } else {
                    note_failure(out, failure(in, op, at,
                        ownership_api.event_kind.lost_ownership,
                        ownership_api.incomplete_reason.none, alloc.key,
                        "parameter storage ends with a live owner"));
                }
            }
            a += 1;
        }
        u64 mut c = 0;
        while (c < p->facts.contents_len) {
            ownership_api.contents_fact value = p->facts.contents[c];
            if (same_entity(value.place.root, in->result_slot)) {
                u64 mut b = 0;
                while (b < value.borrows.len) {
                    ownership_api.borrow_relation relation = value.borrows[b];
                    if (same_entity(relation.source, param.source)) {
                        u64 source = ownership_state.source_index(&p->facts, param.source);
                        if (!complete_return_relation(value, relation) || source == U64_MAX ||
                            p->facts.sources[source].validity ==
                            ownership_api.validity_kind.unknown) {
                            note_failure(out, failure(in, op, at,
                                ownership_api.event_kind.incomplete_proof,
                                ownership_api.incomplete_reason.missing_correspondence,
                                param.source, "parameter borrow escape has no complete proof"));
                        } else {
                            note_failure(out, failure(in, op, at,
                                ownership_api.event_kind.invalid_use,
                                ownership_api.incomplete_reason.none, param.source,
                                "returned view outlives parameter storage"));
                        }
                    }
                    b += 1;
                }
            }
            c += 1;
        }
        event_bridge mut bridge = event_bridge{};
        ownership_api.services mapped = mapped_services(in, &bridge);
        ownership_api.mutation_result ended = ownership_state.end_source(&p->facts,
            &mapped, param.source, op, at);
        if (!ended.applied) { note_failure(out, ended.proof); }
        i += 1;
    }
    bool mut remaining = false;
    u64 mut a = 0;
    while (a < p->facts.allocations_len) {
        ownership_api.allocation_fact alloc = p->facts.allocations[a];
        if (alloc.obligation && (alloc.count.one || alloc.count.many)) {
            remaining = true;
            if (in->parameters.len > 0 &&
                (alloc.owner.place.residual ||
                alloc.owner.place.root.kind == ownership_api.entity_kind.none)) {
                note_failure(out, failure(in, op, at,
                    ownership_api.event_kind.incomplete_proof,
                    ownership_api.incomplete_reason.missing_path, alloc.key,
                    "widened owner leaves parameter storage"));
            }
        }
        a += 1;
    }
    a = 0;
    while (a < p->facts.contents_len) {
        ownership_api.contents_fact value = p->facts.contents[a];
        if (same_entity(value.place.root, in->result_slot) && value.borrows.len > 0) {
            remaining = true;
        }
        a += 1;
    }
    if (p->uncertain_return && remaining) {
        note_failure(out, failure(in, op, at,
            ownership_api.event_kind.incomplete_proof,
            ownership_api.incomplete_reason.unknown_effect,
            ownership_api.entity_id{}, "normal cleanup after unknown call"));
    }
    out->normal_returns += 1;
}

// An equal exact value on one version keeps the path. A different value refutes it.
fn equal_value(program* in, path mut* p, u32 block, value_edge fact)
    ownership_api.proof_status {
    u64 mut j = 0;
    while (j < p->facts.predicates_len) {
        ownership_api.predicate_atom previous = p->facts.predicates[j];
        if (previous.kind == ownership_api.predicate_kind.equality &&
            same_entity(previous.left, fact.value_version) &&
            previous.right.kind == ownership_api.entity_kind.none &&
            previous.lower.kind == ownership_api.fact_kind.exact) {
            if (previous.lower.value != fact.value) {
                ownership_api.proof_status mut bottom = ownership_api.proof_status{};
                bottom.kind = ownership_api.proof_kind.bottom;
                return bottom;
            }
            return complete();
        }
        j += 1;
    }
    if (p->facts.predicates_len >= in->limits->p) {
        ownership_api.source_position at = return_source(in, block);
        ownership_api.lost_fact record = ownership_api.lost_fact{
            ownership_api.limit_category.p, in->limits->p, at, fact.value_version,
            ownership_api.incomplete_reason.work_limit};
        event_bridge mut bridge = event_bridge{};
        ownership_api.services mapped = mapped_services(in, &bridge);
        ownership_api.mutation_result added = ownership_state.add_loss(&p->facts,
            &mapped, record, return_position(in, block), at);
        return added.proof;
    }
    ownership_api.predicate_atom mut atom = ownership_api.predicate_atom{};
    atom.kind = ownership_api.predicate_kind.equality;
    atom.left = fact.value_version;
    atom.lower = ownership_api.scalar_fact{.kind = ownership_api.fact_kind.exact,
        .value = fact.value};
    atom.upper = atom.lower;
    ownership_state.append_predicates(&p->facts, atom);
    return complete();
}

// The value that path `p` knows for `flag`: an exact equality predicate on the flag slot.
fn flag_known(path* p, ownership_api.entity_id flag, bool mut* value) bool {
    u64 mut i = 0;
    while (i < p->facts.predicates_len) {
        ownership_api.predicate_atom atom = p->facts.predicates[i];
        if (atom.kind == ownership_api.predicate_kind.equality && same_entity(atom.left, flag) &&
            atom.right.kind == ownership_api.entity_kind.none &&
            atom.lower.kind == ownership_api.fact_kind.exact) {
            *value = atom.lower.value != 0;
            return true;
        }
        i += 1;
    }
    return false;
}

// Removes what path `p` knows about `flag`.
fn forget_flag(path mut* p, ownership_api.entity_id flag) void {
    u64 mut i = 0;
    while (i < p->facts.predicates_len) {
        if (p->facts.predicates[i].kind == ownership_api.predicate_kind.equality &&
            same_entity(p->facts.predicates[i].left, flag)) {
            u64 mut j = i + 1;
            while (j < p->facts.predicates_len) {
                p->facts.predicates[j - 1] = p->facts.predicates[j];
                j += 1;
            }
            p->facts.predicates_len -= 1;
        } else { i += 1; }
    }
}

// Adds a known flag value to a path that knows none. At the bound P the path records a lost
// fact and continues without the value, which only loses precision.
fn learn_flag(program* in, path mut* p, ownership_api.entity_id flag, bool value,
    ownership_api.operation_position op, ownership_api.source_position at)
    ownership_api.proof_status {
    if (p->facts.predicates_len >= in->limits->p) {
        u64 mut lost = 0;
        while (lost < p->facts.losses_len) {
            if (p->facts.losses[lost].category == ownership_api.limit_category.p &&
                same_entity(p->facts.losses[lost].relation, flag)) { return complete(); }
            lost += 1;
        }
        ownership_api.lost_fact record = ownership_api.lost_fact{
            ownership_api.limit_category.p, in->limits->p, at, flag,
            ownership_api.incomplete_reason.work_limit};
        event_bridge mut bridge = event_bridge{};
        ownership_api.services mapped = mapped_services(in, &bridge);
        ownership_api.mutation_result added = ownership_state.add_loss(&p->facts,
            &mapped, record, op, at);
        return added.proof;
    }
    ownership_api.predicate_atom mut atom = ownership_api.predicate_atom{};
    atom.key = ownership_api.entity_id{flag.function, ownership_api.entity_kind.predicate,
        flag.ordinal};
    atom.kind = ownership_api.predicate_kind.equality;
    atom.left = flag;
    atom.lower = ownership_api.scalar_fact{.kind = ownership_api.fact_kind.exact,
        .value = value ? 1 : 0};
    atom.upper = atom.lower;
    ownership_state.append_predicates(&p->facts, atom);
    return complete();
}

// Whether the contents of the whole slot `slot` decide a null test, and its result in
// `is_null`. An empty owner is null. A reference whose every borrow names a heap source is not
// null: each allocation has at least one byte (D10.2), and a copy, a cast or an address in
// the referent keeps that. Two alternatives for the slot decide nothing.
fn reference_null(ownership_state.state* s, ownership_api.entity_id slot, bool mut* is_null)
    bool {
    u64 mut found = U64_MAX;
    u64 mut i = 0;
    while (i < s->contents_len) {
        ownership_api.place_path place = s->contents[i].place;
        if (same_entity(place.root, slot)) {
            if (found != U64_MAX || place.projections.len != 0 ||
                ownership_state.has_residual(place)) { return false; }
            found = i;
        }
        i += 1;
    }
    if (found == U64_MAX) { return false; }
    ownership_api.contents_fact value = s->contents[found];
    if (value.kind == ownership_api.contents_kind.empty_owner && value.owner_empty) {
        *is_null = true;
        return true;
    }
    if (value.kind != ownership_api.contents_kind.reference || value.owner_empty ||
        value.borrows.len == 0) { return false; }
    i = 0;
    while (i < value.borrows.len) {
        ownership_api.borrow_relation relation = value.borrows[i];
        u64 source = ownership_state.source_index(s, relation.source);
        if (!relation.representation_complete || source == U64_MAX ||
            s->sources[source].kind != ownership_api.source_kind.heap) { return false; }
        i += 1;
    }
    *is_null = false;
    return true;
}

// Applies one flag step: the flag takes the value that the write stores when the path knows
// it, and no value otherwise. No other fact changes.
fn apply_flag(program* in, path mut* p, step* s) ownership_api.proof_status {
    flag_effect effect = s->flag;
    bool mut known = false;
    bool mut value = false;
    if (effect.kind == flag_kind.constant) {
        known = true;
        value = effect.value;
    } else if (effect.kind == flag_kind.copy || effect.kind == flag_kind.negate) {
        known = flag_known(p, effect.from, &value);
        if (effect.kind == flag_kind.negate) { value = !value; }
    } else if (effect.kind == flag_kind.null_test) {
        bool mut empty = false;
        known = reference_null(&p->facts, effect.from, &empty);
        if (known && empty && effect.offset) { known = false; }
        value = empty ? effect.value : !effect.value;
    }
    forget_flag(p, effect.flag);
    if (!known) { return complete(); }
    return learn_flag(in, p, effect.flag, value, s->operation, s->source);
}

fn refine_edge(program* in, path mut* p, u32 block, u32 index)
    ownership_api.proof_status {
    u64 mut v = 0;
    while (v < in->values.len) {
        value_edge fact = in->values[v];
        if (fact.block == block && fact.target_index == index) {
            ownership_api.proof_status kept = equal_value(in, p, block, fact);
            if (!ownership_api.successful(kept)) { return kept; }
        }
        v += 1;
    }
    u64 mut i = 0;
    while (i < in->edges.len) {
        edge_fact fact = in->edges[i];
        if (fact.block == block && fact.target_index == index) {
            u64 mut j = 0;
            while (j < p->facts.predicates_len) {
                ownership_api.predicate_atom previous = p->facts.predicates[j];
                if (previous.kind == ownership_api.predicate_kind.nullness &&
                    same_entity(previous.left, fact.value_version)) {
                    if ((previous.lower.value == 0) != fact.is_null) {
                        ownership_api.proof_status mut bottom = ownership_api.proof_status{};
                        bottom.kind = ownership_api.proof_kind.bottom;
                        return bottom;
                    }
                    return complete();
                }
                j += 1;
            }
            if (p->facts.predicates_len >= in->limits->p) {
                u64 mut lost = 0;
                while (lost < p->facts.losses_len) {
                    if (p->facts.losses[lost].category == ownership_api.limit_category.p &&
                        same_entity(p->facts.losses[lost].relation, fact.value_version)) {
                        return complete();
                    }
                    lost += 1;
                }
                ownership_api.source_position at = return_source(in, block);
                ownership_api.lost_fact record = ownership_api.lost_fact{
                    ownership_api.limit_category.p, in->limits->p, at, fact.value_version,
                    ownership_api.incomplete_reason.work_limit};
                event_bridge mut bridge = event_bridge{};
                ownership_api.services mapped = mapped_services(in, &bridge);
                ownership_api.mutation_result added = ownership_state.add_loss(&p->facts,
                    &mapped, record, return_position(in, block), at);
                return added.proof;
            }
            ownership_api.predicate_atom mut atom = ownership_api.predicate_atom{};
            atom.kind = ownership_api.predicate_kind.nullness;
            atom.left = fact.value_version;
            atom.lower.kind = ownership_api.fact_kind.exact;
            atom.lower.value = fact.is_null ? 0 : 1;
            ownership_state.append_predicates(&p->facts, atom);
        }
        i += 1;
    }
    u64 mut f = 0;
    while (f < in->flags.len) {
        flag_edge fact = in->flags[f];
        if (fact.block == block && fact.target_index == index) {
            bool mut value = false;
            if (flag_known(p, fact.flag, &value)) {
                if (value != fact.value) {
                    ownership_api.proof_status mut bottom = ownership_api.proof_status{};
                    bottom.kind = ownership_api.proof_kind.bottom;
                    return bottom;
                }
                if (!fact.keep) { forget_flag(p, fact.flag); }
            } else if (fact.keep) {
                ownership_api.proof_status kept = learn_flag(in, p, fact.flag, fact.value,
                    return_position(in, block), return_source(in, block));
                if (!ownership_api.successful(kept)) { return kept; }
            }
        }
        f += 1;
    }
    return complete();
}

fn widen_path(program* in, path* a, path* b,
    ownership_api.operation_position op) path {
    path mut out = path{};
    ownership_api.source_position at = return_source(in, op.block);
    event_bridge mut bridge = event_bridge{};
    ownership_api.services mapped = mapped_services(in, &bridge);
    out.facts = ownership_join.widen(&a->facts, &b->facts, &mapped, in->limits, op, at);
    if (a->retired.allocations_len == 0 && b->retired.allocations_len == 0) {
        out.retired = ownership_state.empty();
    } else {
        out.retired = ownership_join.widen(&a->retired, &b->retired,
            &mapped, in->limits, op, at);
    }
    out.loans = fir_flow.bits_new(a->loans.count);
    fir_flow.bits_copy(&out.loans, &a->loans);
    fir_flow.bits_union(&out.loans, &b->loans);
    out.held = new(loan_state, a->held.len);
    u64 mut i = 0;
    while (i < out.held.len) {
        if (!fir_flow.bits_get(&out.loans, cast(i, u32))) { i += 1; continue; }
        out.held[i].facts = ownership_join.widen(&a->held[i].facts, &b->held[i].facts,
            &mapped, in->limits, op, at);
        out.held[i].begin = a->held[i].begin;
        out.held[i].original = ownership_state.copy_place(&out.held[i].facts, a->held[i].original);
        out.held[i].known = a->held[i].known && b->held[i].known &&
            a->held[i].begin == b->held[i].begin &&
            ownership_state.same_place(a->held[i].original, b->held[i].original) &&
            ownership_state.same_place(a->held[i].place, b->held[i].place);
        out.held[i].place = ownership_state.copy_place(&out.held[i].facts, a->held[i].place);
        i += 1;
    }
    out.aliases = ownership_state.empty();
    if (ownership_state.equal(&a->aliases, &b->aliases)) {
        ownership_state.free(&out.aliases);
        out.aliases = ownership_state.clone(&a->aliases);
    }
    out.uncertain_return = a->uncertain_return || b->uncertain_return;
    out.loan_sources_unknown = a->loan_sources_unknown || b->loan_sources_unknown;
    // A joined path does not know a slot that either side settled.
    out.settled = fir_flow.bits_new(a->settled.count);
    fir_flow.bits_copy(&out.settled, &a->settled);
    fir_flow.bits_union(&out.settled, &b->settled);
    return out;
}

// A bucket grows on demand, so a block with one path holds one path.
fn grow_bucket(bucket mut* b, u64 g) void {
    u64 limit = ownership_state.alternatives_within(g);
    u64 mut cap = b->paths.len * 2;
    if (cap < 2) { cap = 2; }
    if (cap > limit) { cap = limit; }
    path mut@ own bigger = new(path, cap);
    u64 mut i = 0;
    while (i < b->len) { bigger[i] = move(b->paths[i]); i += 1; }
    del(b->paths);
    b->paths = move(bigger);
}

fn add_path(program* in, analysis mut* out, fir_flow.bits mut* pending,
    u32 target, path* selected) void {
    bucket mut* bucket_at = &out->blocks[cast(target, u64)];
    u64 mut i = 0;
    while (i < bucket_at->len) {
        if (path_equal(&bucket_at->paths[i], selected)) { return; }
        i += 1;
    }
    // The paths of one block are its exclusive alternatives, at most G of them.
    if (!bucket_at->widened &&
        bucket_at->len < ownership_state.alternatives_within(in->limits->g)) {
        if (bucket_at->len == bucket_at->paths.len) { grow_bucket(bucket_at, in->limits->g); }
        bucket_at->paths[bucket_at->len] = clone_path(selected);
        bucket_at->len += 1;
        fir_flow.bits_set(pending, target);
        return;
    }
    ownership_api.operation_position op = return_position(in, target);
    if (!bucket_at->widened) {
        path mut merged = clone_path(&bucket_at->paths[0]);
        i = 1;
        while (i < bucket_at->len) {
            path mut next = widen_path(in, &merged, &bucket_at->paths[i], op);
            free_path(&merged);
            merged = move(next);
            i += 1;
        }
        path mut next = widen_path(in, &merged, selected, op);
        free_path(&merged);
        merged = move(next);
        i = 0;
        while (i < bucket_at->len) { free_path(&bucket_at->paths[i]); i += 1; }
        bucket_at->paths[0] = move(merged);
        bucket_at->len = 1;
        bucket_at->processed = 0;
        bucket_at->widened = true;
    } else {
        path mut next = widen_path(in, &bucket_at->paths[0], selected, op);
        if (path_equal(&bucket_at->paths[0], &next)) { free_path(&next); return; }
        free_path(&bucket_at->paths[0]);
        bucket_at->paths[0] = move(next);
        bucket_at->processed = 0;
    }
    fir_flow.bits_set(pending, target);
}

fn process(program* in, analysis mut* out, fir_flow.bits mut* pending,
    u32 block, path mut* p) void {
    out->transfers += 1;
    if (!ownership_api.successful(p->facts.proof)) {
        note_failure(out, p->facts.proof);
        note_stop(out, block, 0, 0);
        return;
    }
    if (!ownership_api.successful(p->retired.proof)) {
        note_failure(out, p->retired.proof);
        note_stop(out, block, 0, 0);
        return;
    }
    u64 mut captured = 0;
    while (captured < p->held.len) {
        if (fir_flow.bits_get(&p->loans, cast(captured, u32)) &&
            !ownership_api.successful(p->held[captured].facts.proof)) {
            note_failure(out, p->held[captured].facts.proof);
            note_stop(out, block, 0, 0);
            return;
        }
        captured += 1;
    }
    if (!apply_steps(in, out, p, block)) { return; }
    fir.block* current = fir.block_at(in->function, block);
    if (!current->terminated) {
        note_failure(out, invalid_input(in));
        note_stop(out, block, fir.block_statement_count(in->function, block), STOP_AFTER);
        return;
    }
    if (current->term.kind == fir.term_kind.tk_return) {
        if (in->observed != null && cast(block, u64) < in->observed->return_attempts.len) {
            in->observed->return_attempts[cast(block, u64)] += 1;
            if (p->uncertain_return) {
                in->observed->return_uncertain[cast(block, u64)] += 1;
            }
        }
        u64 failures = out->failures;
        parameter_return(in, out, p, block);
        if (out->failures == failures) {
            observe_exit(in, out, p, block, ownership_api.outcome_kind.function_return);
        }
        return;
    }
    if (current->term.kind == fir.term_kind.tk_fail ||
        current->term.kind == fir.term_kind.tk_trap) {
        observe_exit(in, out, p, block, ownership_api.outcome_kind.abort);
        return;
    }
    if (current->term.kind == fir.term_kind.tk_unreachable) {
        observe_exit(in, out, p, block, ownership_api.outcome_kind.unknown_fort);
        return;
    }
    u32 mut index = 0;
    u32 mut target = 0;
    while (fir.term_targets(in->function, &current->term, index, &target)) {
        if (!fir_flow.reachable_target(in->function, &current->term, index, &target)) {
            index += 1;
            continue;
        }
        path mut outgoing = clone_path(p);
        ownership_api.proof_status proof = refine_edge(in, &outgoing, block, index);
        if (proof.kind != ownership_api.proof_kind.bottom) {
            if (ownership_api.successful(proof)) {
                add_path(in, out, pending, target, &outgoing);
            } else {
                note_failure(out, proof);
                note_stop(out, block, fir.block_statement_count(in->function, block),
                    STOP_AFTER);
            }
        }
        free_path(&outgoing);
        index += 1;
    }
}

// The callback copies required facts before process releases its working path.
fn observe_exit(program* in, analysis mut* out, path* p, u32 block,
    ownership_api.outcome_kind kind) void {
    if (in->exit_observer == null) { return; }
    ownership_api.state_view facts = ownership_state.view(&p->facts);
    ownership_api.outcome_fact outcome = ownership_api.outcome_fact{.kind = kind,
        .possible_caller_return = kind == ownership_api.outcome_kind.function_return ||
            kind == ownership_api.outcome_kind.unknown_fort,
        .cleanup_required = kind != ownership_api.outcome_kind.abort};
    note_failure(out, in->exit_observer(in->exit_context, &facts, outcome,
        return_position(in, block), return_source(in, block)));
}

/// Runs a canonical worklist. The caller frees the analysis and retains the program facts.
fn solve(program* given) analysis {
    analysis mut out = analysis{};
    if (!valid(given)) { note_failure(&out, invalid_input(given)); return out; }
    // The table of exposed locals: one pass over the FIR for the whole computation, in place
    // of a pass at each question about a private local.
    bool mut@ own exposed = exposed_locals(given->function);
    defer del(exposed);
    program mut run = *given;
    run.exposed = exposed[..];
    program* in = &run;
    u32 count = fir.block_count(in->function);
    out.step_first = new(u64, cast(count, u64) + 1);
    u64 mut step_at = 0;
    u32 mut first_block = 0;
    while (first_block <= count) {
        while (step_at < in->steps.len && in->steps[step_at].block < first_block) {
            step_at += 1;
        }
        out.step_first[cast(first_block, u64)] = step_at;
        first_block += 1;
    }
    out.blocks = new(bucket, cast(count, u64));
    // Rank 0 at each gap, one rank for each step, and STOP_AFTER for each block.
    out.stops = new(stop, ownership_limits.saturating_sum(ownership_limits.saturating_sum(
        ownership_limits.fir_size(in->function), in->steps.len), cast(count, u64)));
    u32 mut block = 0;
    fir_flow.bits mut pending = fir_flow.bits_new(count);
    path mut initial = path{};
    initial.facts = ownership_state.clone(in->entry);
    initial.retired = ownership_state.empty();
    initial.loans = fir_flow.bits_new(fir.loan_count(in->function));
    initial.held = new(loan_state, cast(initial.loans.count, u64));
    initial.aliases = ownership_state.empty();
    initial.settled = fir_flow.bits_new(in->continue_separate ? fir.local_count(in->function) :
        0);
    if (in->continue_separate) { out.cycles = new(u8, cast(count, u64)); }
    add_path(in, &out, &pending, 0, &initial);
    free_path(&initial);
    block = 0;
    while (block < count) {
        if (!fir_flow.bits_get(&pending, block)) { block += 1; continue; }
        fir_flow.bits_clear(&pending, block);
        bucket mut* current = &out.blocks[cast(block, u64)];
        while (current->processed < current->len) {
            path mut next = clone_path(&current->paths[current->processed]);
            current->processed += 1;
            process(in, &out, &pending, block, &next);
            free_path(&next);
        }
        block = 0;
    }
    fir_flow.bits_free(&pending);
    return out;
}

// ---- separate owners after a failure ------------------------------------------------------
//
// Toolchain 4.2 says that a failure must not silence a separate owner. After a definite
// failure of a local step, the path settles the slots that the failure relates to and
// continues. A transfer that fails leaves its facts unchanged, so the facts of each other
// slot still describe that slot. The path skips each later local step that names a settled
// slot, so it never reports a related owner again. One step is an exception: a copy of an
// unsettled slot into a settled view runs (`copies_into_view`). A skipped step still counts
// as an attempt: no other path validates a failure of it.

// What a path does with one local step.
enum settling {
    run,
    skip,
    stop,
}

// The FIR local of `place` when it is a whole slot of this function, or NO_LOCAL.
fn settled_index(program* in, ownership_api.place_path place) u32 {
    if (place.root.kind != ownership_api.entity_kind.slot || place.projections.len != 0 ||
        ownership_state.has_residual(place) ||
        ownership_keys.function(place.root.function, in->identity) != 0 ||
        place.root.ordinal >= fir.local_count(in->function)) { return NO_LOCAL; }
    return place.root.ordinal;
}

fn is_settled(path* p, u32 local) bool {
    return local < p->settled.count && fir_flow.bits_get(&p->settled, local);
}

fn settled_result(program* in, path* p) bool {
    if (in->result_slot.kind != ownership_api.entity_kind.slot) { return false; }
    ownership_api.place_path result = ownership_api.place_path{.root = in->result_slot};
    return is_settled(p, settled_index(in, result));
}

// Static and trusted foreign storage never ends under a local effect (D17.13), so two slots
// that view it are not related through it.
fn relates(ownership_api.source_fact source) bool {
    return source.kind != ownership_api.source_kind.static_storage &&
        source.kind != ownership_api.source_kind.trusted_foreign;
}

// Adds to `grown` each slot that its members relate to through the facts of `p`: an owned
// allocation and each source of it, a borrowed source and its allocation, the owner of that
// allocation, and each other slot that borrows one of those sources. A slot that a settled
// slot can reach in memory is related, so no skipped step changes the facts of an unrelated
// slot. Each round charges one W unit. False when a fact names storage that is not a whole
// slot of this function: then no owner is proved unrelated. A W refusal also sets `charged`.
fn relate(program* in, path* p, fir_flow.bits mut* grown, step* s,
    ownership_api.proof_status mut* charged) bool {
    ownership_state.state* facts = &p->facts;
    if (facts->regions_len > 0 || facts->nodes_len > 0 || facts->edges_len > 0 ||
        facts->shapes_len > 0 || facts->guards_len > 0 || facts->correlations_len > 0) {
        return false;
    }
    bool mut@ own sources = new(bool, facts->sources_len);
    defer del(sources);
    bool mut@ own allocations = new(bool, facts->allocations_len);
    defer del(allocations);
    bool mut changed = true;
    while (changed) {
        changed = false;
        ownership_api.charge_result paid = ownership_api.charge_work(in->services,
            ownership_api.work_kind.transfer, s->operation, s->source);
        if (!paid.allowed) {
            *charged = charged_failure(in, paid.proof, s->operation, s->source);
            return false;
        }
        u64 mut c = 0;
        while (c < facts->contents_len) {
            ownership_api.contents_fact value = facts->contents[c];
            u32 holder = settled_index(in, value.place);
            if (holder == NO_LOCAL) { return false; }
            u64 mut b = 0;
            while (b < value.borrows.len) {
                u64 source = ownership_state.source_index(facts, value.borrows[b].source);
                if (source == U64_MAX) { return false; }
                if (relates(facts->sources[source])) {
                    bool held = fir_flow.bits_get(grown, holder);
                    if (held && !sources[source]) {
                        sources[source] = true;
                        changed = true;
                    } else if (!held && sources[source]) {
                        fir_flow.bits_set(grown, holder);
                        changed = true;
                    }
                }
                b += 1;
            }
            c += 1;
        }
        u64 mut a = 0;
        while (a < facts->allocations_len) {
            ownership_api.allocation_fact alloc = facts->allocations[a];
            if (alloc.obligation && !alloc.owner.detached) {
                u32 owner = settled_index(in, alloc.owner.place);
                if (owner == NO_LOCAL) { return false; }
                if (fir_flow.bits_get(grown, owner) && !allocations[a]) {
                    allocations[a] = true;
                    changed = true;
                } else if (allocations[a] && !fir_flow.bits_get(grown, owner)) {
                    fir_flow.bits_set(grown, owner);
                    changed = true;
                }
            }
            if (allocations[a]) {
                u64 mut source = 0;
                while (source < facts->sources_len) {
                    if (!sources[source] && relates(facts->sources[source]) &&
                        same_entity(facts->sources[source].allocation, alloc.key)) {
                        sources[source] = true;
                        changed = true;
                    }
                    source += 1;
                }
            }
            a += 1;
        }
        u64 mut source = 0;
        while (source < facts->sources_len) {
            if (sources[source]) {
                u64 held = ownership_state.allocation_index(facts,
                    facts->sources[source].allocation);
                if (held != U64_MAX && !allocations[held]) {
                    allocations[held] = true;
                    changed = true;
                }
            }
            source += 1;
        }
    }
    return true;
}

// Adds the slots of `s` and each slot that they relate to. `stop` when the path cannot prove
// that the other slots are unrelated, or when W refuses the work: `charged` then holds the
// refusal.
fn settle(program* in, path mut* p, step* s, ownership_api.proof_status mut* charged)
    settling {
    u32 from = settled_index(in, s->local.source);
    u32 to = settled_index(in, s->local.destination);
    if (p->settled.count == 0 || from == NO_LOCAL || to == NO_LOCAL) { return settling.stop; }
    fir_flow.bits mut grown = fir_flow.bits_new(p->settled.count);
    defer fir_flow.bits_free(&grown);
    fir_flow.bits_copy(&grown, &p->settled);
    fir_flow.bits_set(&grown, from);
    fir_flow.bits_set(&grown, to);
    if (!relate(in, p, &grown, s, charged)) { return settling.stop; }
    fir_flow.bits_copy(&p->settled, &grown);
    return settling.run;
}

// A local step that names a settled slot does not run, except a copy into a settled view
// (`copies_into_view`): the path does not know the value that the step reads or replaces.
// A copy or a move between a settled slot and another slot can give the other slot a
// settled value, or a settled slot the other slot's storage, so the other slot becomes
// settled too, with each slot that it relates to.
fn skip_settled(program* in, analysis mut* out, path mut* p, step* s) settling {
    if (p->settled.count == 0 || s->kind != step_kind.local_effect ||
        s->local.kind == ownership_transfer.action.outside) { return settling.run; }
    u32 from = settled_index(in, s->local.source);
    u32 to = settled_index(in, s->local.destination);
    if (!is_settled(p, from) && !is_settled(p, to)) { return settling.run; }
    if (copies_into_view(p, s, from, to)) {
        fir_flow.bits_clear(&p->settled, to);
        return settling.run;
    }
    invalidate_version(p, s->invalidates);
    if (is_settled(p, from) && is_settled(p, to)) { return settling.skip; }
    if (is_settled(p, from)) {
        if (to == NO_LOCAL) { return settling.stop; }
        settle_overwritten(in, p, to);
        return settling.skip;
    }
    ownership_api.proof_status mut charged = complete();
    if (settle(in, p, s, &charged) == settling.run) { return settling.skip; }
    if (!ownership_api.successful(charged)) { note_failure(out, charged); }
    return settling.stop;
}

// Whether `s` copies the unsettled slot `from` into the settled view `to`. The copy writes a
// value that the path knows over the view, and it changes neither the source nor its
// allocation. A view releases no storage, so no step through it changed other facts. So the
// copy runs, and the view is no longer settled: the path reports a later failure on it. A
// move or an owning destination keeps the relation of the source (`settle`).
fn copies_into_view(path* p, step* s, u32 from, u32 to) bool {
    return s->local.kind == ownership_transfer.action.copy && !s->local.destination_owns &&
        from != NO_LOCAL && !is_settled(p, from) && is_settled(p, to);
}

// A skipped copy or move from a settled slot writes a settled value over `local`. The slot
// loses its old value, so its old relations do not count: it is settled alone, and its
// contents become unknown, so no later relation reads them (toolchain 4.2: a slot that the
// old value related to stays a separate owner). The new value reaches only what the settled
// source reaches, and those slots are settled already.
fn settle_overwritten(program* in, path mut* p, u32 local) void {
    fir_flow.bits_set(&p->settled, local);
    u64 mut c = 0;
    while (c < p->facts.contents_len) {
        ownership_api.place_path place = p->facts.contents[c].place;
        if (place.root.kind == ownership_api.entity_kind.slot && place.root.ordinal == local &&
            ownership_keys.function(place.root.function, in->identity) == 0) {
            p->facts.contents[c] = ownership_api.contents_fact{.place = place,
                .kind = ownership_api.contents_kind.unknown};
        }
        c += 1;
    }
}

// Whether flag step `s` tests a settled slot for null. The path does not know the value of
// that slot, so the flag takes no value: a stale empty owner would refute the branch that
// the program takes. A flag of another kind reads only flags, which no skipped step writes.
fn stale_null_test(program* in, path* p, step* s) bool {
    if (s->flag.kind != flag_kind.null_test) { return false; }
    return is_settled(p, settled_index(in, ownership_api.place_path{.root = s->flag.from}));
}

// A settled path runs local effects, value invalidations, call outcomes and flag steps.
// These read no fact of a settled slot outside `skip_settled` and `stale_null_test`. Another
// step kind can read a settled slot through a fact that the path does not know, so it stops
// the path: a direct call can apply a summary to settled facts.
fn stops_settled(path* p, step* s) bool {
    if (s->kind == step_kind.local_effect || s->kind == step_kind.invalidate_value ||
        s->kind == step_kind.call_outcome || s->kind == step_kind.flag) { return false; }
    u64 mut w = 0;
    while (w < p->settled.words.len) {
        if (p->settled.words[w] != 0) { return true; }
        w += 1;
    }
    return false;
}

// Whether a path leads from block `b` back to `b`. The analysis keeps each answer.
fn on_cycle(program* in, analysis mut* out, u32 b) bool {
    if (out->cycles[cast(b, u64)] != 0) { return out->cycles[cast(b, u64)] == 2; }
    u32 count = fir.block_count(in->function);
    fir_flow.bits mut seen = fir_flow.bits_new(count);
    defer fir_flow.bits_free(&seen);
    u32 mut@ own work = new(u32, cast(count, u64));
    defer del(work);
    u64 mut len = 0;
    work[0] = b;
    len = 1;
    bool mut found = false;
    while (len > 0 && !found) {
        len -= 1;
        fir.block* at = fir.block_at(in->function, work[len]);
        u32 mut index = 0;
        u32 mut target = 0;
        while (at->terminated && fir_flow.next_reachable_target(in->function, &at->term,
            &index, &target)) {
            if (target == b) { found = true; }
            if (!fir_flow.bits_get(&seen, target)) {
                fir_flow.bits_set(&seen, target);
                work[len] = target;
                len += 1;
            }
            index += 1;
        }
    }
    out->cycles[cast(b, u64)] = found ? 2 : 1;
    return found;
}

// Whether path `p` continues after the failure `failed` of local step `s`. Only a definite
// failure continues: an incomplete failure has no effect that the path can apply. The step must
// stand on no cycle, so no settled path comes back to it and hides its failure. A loan, a
// value edge, a parameter check, a call handler or an exit observer reads facts that a
// settled slot can make stale, so each of them keeps the stop.
fn continues_after(program* in, analysis mut* out, path mut* p, step* s,
    ownership_api.proof_status failed) bool {
    if (!in->continue_separate || s->kind != step_kind.local_effect ||
        failed.kind != ownership_api.proof_kind.complete || !failed.failed ||
        failed.terminal.present || in->edges.len > 0 || in->values.len > 0 ||
        in->parameters.len > 0 || in->call_handler != null || in->exit_observer != null ||
        fir.loan_count(in->function) > 0 || on_cycle(in, out, s->block)) { return false; }
    ownership_api.proof_status mut charged = complete();
    if (settle(in, p, s, &charged) == settling.run) {
        // The program can write the value version of the failed step, so the path drops
        // what it knew about that version, as a skipped step does.
        invalidate_version(p, s->invalidates);
        return true;
    }
    if (!ownership_api.successful(charged)) { note_failure(out, charged); }
    return false;
}
