}

fn dedup_exact(ownership_state.state mut* s) void {
    dedup_contents(s);
    dedup_correlations(s);
    dedup_predicates(s);
    dedup_guards(s);
}

fn clone_reaching(ownership_state.state* input) ownership_state.state {
    ownership_state.state mut out = ownership_state.clone(input);
    dedup_exact(&out);
    dedup_collision_facts(&out);
    return out;
}

fn drop_conflicting_predicates(ownership_state.state mut* s,
    ownership_api.source_position at) void {
    u64 mut i = 0;
    while (i < s->predicates_len) {
        bool mut conflict = false;
        u64 mut j = i + 1;
        while (j < s->predicates_len) {
            if (entity(s->predicates[i].key, s->predicates[j].key) &&
                !ownership_state.same_predicate(s->predicates[i], s->predicates[j])) {
                conflict = true;
                break;
            }
            j += 1;
        }
        if (!conflict) { i += 1; continue; }
        ownership_api.entity_id key = s->predicates[i].key;
        remember_conflict(s, ownership_api.limit_category.p, key, at);
        j = 0;
        while (j < s->predicates_len) {
            if (!entity(s->predicates[j].key, key)) { j += 1; continue; }
            u64 mut k = j + 1;
            while (k < s->predicates_len) {
                s->predicates[k - 1] = s->predicates[k];
                k += 1;
            }
            s->predicates_len -= 1;
        }
    }
}

fn drop_conflicting_guards(ownership_state.state mut* s,
    ownership_api.source_position at) void {
    u64 mut i = 0;
    while (i < s->guards_len) {
        bool mut conflict = false;
        u64 mut j = i + 1;
        while (j < s->guards_len) {
            if (entity(s->guards[i].key, s->guards[j].key) &&
                !ownership_state.same_guard(s->guards[i], s->guards[j])) {
                conflict = true;
                break;
            }
            j += 1;
        }
        if (!conflict) { i += 1; continue; }
        ownership_api.entity_id key = s->guards[i].key;
        remember_conflict(s, ownership_api.limit_category.g, key, at);
        j = 0;
        while (j < s->guards_len) {
            if (!entity(s->guards[j].key, key)) { j += 1; continue; }
            u64 mut k = j + 1;
            while (k < s->guards_len) {
                s->guards[k - 1] = s->guards[k];
                k += 1;
            }
            s->guards_len -= 1;
        }
    }
}

fn has_predicate(ownership_state.state* s, ownership_api.predicate_atom fact) bool {
    u64 mut i = 0;
    while (i < s->predicates_len) {
        if (ownership_state.same_predicate(s->predicates[i], fact)) { return true; }
        i += 1;
    }
    return false;
}

fn has_guard(ownership_state.state* s, ownership_api.guard_fact fact) bool {
    u64 mut i = 0;
    while (i < s->guards_len) {
        if (ownership_state.same_guard(s->guards[i], fact)) { return true; }
        i += 1;
    }
    return false;
}

fn has_shape(ownership_state.state* s, ownership_api.entity_id key) bool {
    u64 mut i = 0;
    while (i < s->shapes_len) {
        if (entity(s->shapes[i].key, key)) { return true; }
        i += 1;
    }
    return false;
}

fn weaken_one_sided(ownership_state.state mut* out, ownership_state.state* a,
    ownership_state.state* b, ownership_api.source_position at) void {
    u64 mut i = 0;
    while (i < out->predicates_len) {
        if (has_predicate(a, out->predicates[i]) &&
            has_predicate(b, out->predicates[i])) { i += 1; continue; }
        remember_conflict(out, ownership_api.limit_category.p, out->predicates[i].key, at);
        u64 mut j = i + 1;
        while (j < out->predicates_len) {
            out->predicates[j - 1] = out->predicates[j];
            j += 1;
        }
        out->predicates_len -= 1;
    }
    i = 0;
    while (i < out->guards_len) {
        if (has_guard(a, out->guards[i]) && has_guard(b, out->guards[i])) {
            i += 1;
            continue;
        }
        remember_conflict(out, ownership_api.limit_category.g, out->guards[i].key, at);
        u64 mut j = i + 1;
        while (j < out->guards_len) {
            out->guards[j - 1] = out->guards[j];
            j += 1;
        }
        out->guards_len -= 1;
    }
    i = 0;
    while (i < out->shapes_len) {
        if (!has_shape(a, out->shapes[i].key) || !has_shape(b, out->shapes[i].key)) {
            remember_conflict(out, ownership_api.limit_category.h, out->shapes[i].key, at);
            out->shapes[i].residual = true;
            out->shapes[i].acyclic_proved = false;
            out->shapes[i].separation_proved = false;
        }
        i += 1;
    }
}

fn terminal_order(ownership_api.terminal_failure a,
    ownership_api.terminal_failure b) i32 {
    i32 mut c = ownership_keys.operation(a.operation, b.operation);
    if (c != 0) { return c; }
    c = ownership_keys.source(a.source, b.source);
    if (c != 0) { return c; }
    c = number(cast(a.reason, u64), cast(b.reason, u64));
    if (c != 0) { return c; }
    c = ownership_keys.entity(a.relation, b.relation);
    if (c != 0) { return c; }
    c = number(cast(a.limit.present, u64), cast(b.limit.present, u64));
    if (c != 0) { return c; }
    c = number(cast(a.limit.category, u64), cast(b.limit.category, u64));
    if (c != 0) { return c; }
    c = number(cast(a.limit.scope, u64), cast(b.limit.scope, u64));
    if (c != 0) { return c; }
    c = number(cast(a.limit.work, u64), cast(b.limit.work, u64));
    if (c != 0) { return c; }
    c = number(a.limit.used, b.limit.used);
    if (c != 0) { return c; }
    c = number(a.limit.bound, b.limit.bound);
    if (c != 0) { return c; }
    c = number(a.limit.attempted, b.limit.attempted);
    if (c != 0) { return c; }
    c = ownership_keys.operation(a.limit.operation, b.limit.operation);
    if (c != 0) { return c; }
    c = ownership_keys.source(a.limit.source, b.limit.source);
    if (c != 0) { return c; }
    return number(cast(a.limit.saturated, u64), cast(b.limit.saturated, u64));
}

fn inherited(ownership_state.state* a, ownership_state.state* b,
    ownership_api.operation_position op, ownership_api.source_position at)
    ownership_api.proof_status {
    bool first = a->proof.kind == ownership_api.proof_kind.incomplete &&
        a->proof.terminal.present;
    bool second = b->proof.kind == ownership_api.proof_kind.incomplete &&
        b->proof.terminal.present;
    if (first && second) {
        return terminal_order(a->proof.terminal, b->proof.terminal) <= 0 ?
            a->proof : b->proof;
    }
    if (first) { return a->proof; }
    if (second) { return b->proof; }
    if (!ownership_api.successful(a->proof)) {
        return ownership_api.incomplete(ownership_api.incomplete_reason.unknown_effect, op, at);
    }
    if (!ownership_api.successful(b->proof)) {
        return ownership_api.incomplete(ownership_api.incomplete_reason.unknown_effect, op, at);
    }
    ownership_api.proof_status mut out = ownership_api.proof_status{};
    out.kind = ownership_api.proof_kind.complete;
    return out;
}

fn record_failure(ownership_api.services* svc, ownership_api.proof_status proof,
    ownership_api.operation_position op, ownership_api.source_position at)
    ownership_api.proof_status {
    ownership_api.event_descriptor mut event = ownership_api.event_descriptor{};
    event.key.function = op.function;
    event.key.kind = ownership_api.entity_kind.event;
    event.key.ordinal = op.operation;
    event.operation = op;
    event.source = at;
    event.kind = ownership_api.event_kind.incomplete_proof;
    if (proof.terminal.reason == ownership_api.incomplete_reason.work_limit) {
        event.kind = ownership_api.event_kind.work_failure;
    }
    event.evidence = ownership_api.evidence_kind.abstract_possibility;
    event.reason = proof.terminal.reason;
    event.text = "ownership join cannot complete the requested work";
    ownership_api.event_request request = ownership_api.event_request{event, proof};
    return ownership_api.record_event(svc, &request).proof;
}

fn compose(ownership_state.state* a, ownership_state.state* b,
    ownership_api.services* svc, ownership_api.work_kind work, bool valid,
    ownership_api.operation_position op, ownership_api.source_position at)
    ownership_state.state {
    ownership_api.charge_result mut charged = ownership_api.charge_result{};
    if (valid) { charged = ownership_api.charge_work(svc, work, op, at); }
    else { charged.allowed = true; }
    if (valid && a->proof.kind == ownership_api.proof_kind.bottom && charged.allowed) {
        return clone_reaching(b);
    }
    if (valid && b->proof.kind == ownership_api.proof_kind.bottom && charged.allowed) {
        return clone_reaching(a);
    }
    ownership_state.state mut out = ownership_state.empty();
    merge_sources(&out, a, b);
    merge_allocations(&out, a, b);
    merge_rest(&out, a, b);
    dedup_exact(&out);
    mark_collisions(&out, at);
    dedup_collision_facts(&out);
    drop_conflicting_predicates(&out, at);
    drop_conflicting_guards(&out, at);
    weaken_one_sided(&out, a, b, at);
    out.proof = inherited(a, b, op, at);
    if (!valid) {
        out.proof = ownership_api.incomplete(ownership_api.incomplete_reason.invalid_input,
            op, at);
    } else if (!charged.allowed) {
        out.proof = record_failure(svc, charged.proof, op, at);
    }
    return out;
}

/// Joins two predecessor states. A failed charge retains both sets of facts.
fn join(ownership_state.state* a, ownership_state.state* b,
    ownership_api.services* svc, ownership_api.limit_table* limits,
    ownership_api.operation_position op,
    ownership_api.source_position at) ownership_state.state {
    bool valid = ownership_api.valid_limits(limits);
    ownership_state.state mut out = compose(a, b, svc, ownership_api.work_kind.join,
        valid, op, at);
    if (!valid) { return out; }
    cover_bounds(&out, svc, limits, ownership_api.work_kind.join, op, at);
    dedup_contents(&out);
    dedup_collision_facts(&out);
    return out;
}

fn remember_loss(ownership_state.state mut* s, ownership_api.limit_category category,
    u64 bound, ownership_api.source_position at, ownership_api.entity_id relation) void {
    ownership_api.lost_fact fact = ownership_api.lost_fact{category, bound, at, relation,
        ownership_api.incomplete_reason.work_limit};
    u64 mut i = 0;
    while (i < s->losses_len) {
        if (ownership_state.same_loss(s->losses[i], fact)) { return; }
        i += 1;
    }
    ownership_state.append_losses(s, fact);
}

fn plus_count(u64 a, u64 b) u64 {
    if (b > U64_MAX - a) { return U64_MAX; }
    return a + b;
}

fn has_bound_loss(ownership_state.state* s, ownership_api.limit_category category)
    bool {
    u64 mut i = 0;
    while (i < s->losses_len) {
        if (s->losses[i].category == category &&
            s->losses[i].reason == ownership_api.incomplete_reason.work_limit) {
            return true;
        }
        i += 1;
    }
    return false;
}

fn blur_region(ownership_state.state mut* s, ownership_api.region input)
    ownership_api.region {
    ownership_api.region mut out = input;
    out.residual = true;
    out.offset = ownership_api.scalar_fact{};
    out.access = ownership_api.byte_window{};
    out.extent = ownership_api.scalar_fact{};
    out.alignment = 0;
    if (input.partitions.len > 0) {
        ownership_api.region_partition mut@ own parts =
            new(ownership_api.region_partition, input.partitions.len);
        u64 mut i = 0;
        while (i < parts.len) {
            parts[i] = input.partitions[i];
            parts[i].residual = true;
            i += 1;
        }
        out.partitions = ownership_state.copy_partitions(s, parts[..]);
        del(parts);
    }
    return out;
}

fn cover_regions(ownership_state.state mut* s, ownership_api.limit_table* limits,
    u64 used, ownership_api.source_position at) void {
    if (used <= limits->r && !has_bound_loss(s, ownership_api.limit_category.r)) {
        return;
    }
    u64 mut i = 0;
    while (i < s->allocations_len) {
        ownership_api.allocation_fact mut* fact = &s->allocations[i];
        remember_loss(s, ownership_api.limit_category.r, limits->r, at, fact->key);
        if (fact->obligation) {
            fact->count.zero = true;
            fact->count.one = true;
            fact->count.many = true;
        }
        fact->validity = ownership_api.validity_kind.unknown;
        fact->owner.place.residual = true;
        fact->owner.detached = true;
        i += 1;
    }
    i = 0;
    while (i < s->sources_len) {
        if (s->sources[i].validity == ownership_api.validity_kind.live &&
            allocation_index(s, s->sources[i].allocation) != U64_MAX) {
            s->sources[i].validity = ownership_api.validity_kind.unknown;
        }
        i += 1;
    }
    i = 0;
    while (i < s->regions_len) {
        remember_loss(s, ownership_api.limit_category.r, limits->r, at, s->regions[i].key);
        s->regions[i] = blur_region(s, s->regions[i]);
        i += 1;
    }
    i = 0;
    while (i < s->nodes_len) {
        remember_loss(s, ownership_api.limit_category.r, limits->r, at, s->nodes[i].key);
        s->nodes[i].residual = true;
        i += 1;
    }
    i = 0;
    while (i < s->edges_len) {
        remember_loss(s, ownership_api.limit_category.r, limits->r, at, s->edges[i].key);
        s->edges[i].kind = ownership_api.edge_kind.residual;
        s->edges[i].place.residual = true;
        s->edges[i].range = blur_region(s, s->edges[i].range);
        i += 1;
    }
    i = 0;
    while (i < s->contents_len) {
        ownership_api.borrow_relation@ old = s->contents[i].borrows;
        if (old.len > 0) {
            ownership_api.borrow_relation mut@ own pending =
                new(ownership_api.borrow_relation, old.len);
            u64 mut j = 0;
            while (j < old.len) {
                remember_loss(s, ownership_api.limit_category.r, limits->r, at,
                    old[j].range.key);
                pending[j] = old[j];
                pending[j].range = blur_region(s, old[j].range);
                pending[j].representation_complete = false;
                j += 1;
            }
            s->contents[i].borrows = ownership_state.copy_borrows(s, pending[..]);
            del(pending);
        }
        i += 1;
    }
    i = 0;
    while (i < s->shapes_len) {
        s->shapes[i].residual = true;
        s->shapes[i].acyclic_proved = false;
        s->shapes[i].separation_proved = false;
        i += 1;
    }
}

fn cover_predicates(ownership_state.state mut* s, ownership_api.limit_table* limits,
    ownership_api.source_position at) void {
    if (s->predicates_len <= limits->p &&
        !has_bound_loss(s, ownership_api.limit_category.p)) { return; }
    u64 mut i = 0;
    while (i < s->predicates_len) {
        remember_loss(s, ownership_api.limit_category.p, limits->p, at, s->predicates[i].key);
        i += 1;
    }
    s->predicates_len = 0;
    i = 0;
    while (i < s->guards_len) {
        remember_loss(s, ownership_api.limit_category.g, limits->g, at, s->guards[i].key);
        i += 1;
    }
    s->guards_len = 0;
    i = 0;
    while (i < s->correlations_len) {
        remember_loss(s, ownership_api.limit_category.g, limits->g, at,
            s->correlations[i].guard);
        i += 1;
    }
    s->correlations_len = 0;
}

fn cover_guards(ownership_state.state mut* s, ownership_api.limit_table* limits,
    ownership_api.source_position at) void {
    u64 mut used = plus_count(s->guards_len, s->correlations_len);
    used = plus_count(used, s->contents_len);
    if (used <= limits->g && !has_bound_loss(s, ownership_api.limit_category.g)) {
        return;
    }
    u64 mut i = 0;
    while (i < s->guards_len) {
        remember_loss(s, ownership_api.limit_category.g, limits->g, at, s->guards[i].key);
        i += 1;
    }
    s->guards_len = 0;
    i = 0;
    while (i < s->correlations_len) {
        remember_loss(s, ownership_api.limit_category.g, limits->g, at,
            s->correlations[i].guard);
        i += 1;
    }
    s->correlations_len = 0;
    i = 0;
    while (i < s->contents_len) {
        ownership_api.contents_fact mut* fact = &s->contents[i];
        remember_loss(s, ownership_api.limit_category.g, limits->g, at, fact->place.root);
        fact->place.residual = true;
        fact->kind = ownership_api.contents_kind.unknown;
        fact->value_version = ownership_api.entity_id{};
        fact->span_length = ownership_api.scalar_fact{};
        fact->owner_empty = false;
        if (fact->borrows.len > 0) {
            ownership_api.borrow_relation mut@ own borrows =
                new(ownership_api.borrow_relation, fact->borrows.len);
            u64 mut j = 0;
            while (j < borrows.len) {
                borrows[j] = fact->borrows[j];
                borrows[j].representation_complete = false;
                j += 1;
            }
            fact->borrows = ownership_state.copy_borrows(s, borrows[..]);
            del(borrows);
        }
        i += 1;
    }
    dedup_contents(s);
}

fn cover_shapes(ownership_state.state mut* s, ownership_api.limit_table* limits,
    ownership_api.source_position at) void {
    u64 mut used = 0;
    u64 mut i = 0;
    while (i < s->shapes_len) {
        ownership_api.shape_description shape = s->shapes[i];
        used = plus_count(used, 1);
        used = plus_count(used, shape.parameters.len);
        used = plus_count(used, shape.clauses.len);
        used = plus_count(used, shape.descendants.len);
        i += 1;
    }
    if (used <= limits->h && !has_bound_loss(s, ownership_api.limit_category.h)) {
        return;
    }
    i = 0;
    while (i < s->shapes_len) {
        remember_loss(s, ownership_api.limit_category.h, limits->h, at, s->shapes[i].key);
        s->shapes[i].residual = true;
        s->shapes[i].acyclic_proved = false;
        s->shapes[i].separation_proved = false;
        i += 1;
    }
}

// A join preserves history when its complete retained cardinality exceeds E.
fn cover_histories(ownership_state.state mut* s, ownership_api.services* svc,
    ownership_api.limit_table* limits, ownership_api.work_kind kind,
    ownership_api.operation_position op, ownership_api.source_position at) void {
    if (s->allocations_len == 0) { return; }
    ownership_state.charge_counts mut counts = {};
    ownership_api.charge_result measured = ownership_state.history_permission(s, svc, 0,
        kind, op, at, &counts);
    if (!measured.allowed) {
        if (ownership_api.successful(s->proof)) {
            s->proof = record_failure(svc, measured.proof, op, at);
        }
        return;
    }
    if (counts.e == 0) { return; }
    ownership_api.charge_item[1] item = {ownership_api.charge_item{
        ownership_api.limit_category.e, ownership_api.limit_scope.function, counts.e}};
    ownership_api.charge_request req = ownership_api.charge_request{kind, op, at, item[..]};
    ownership_api.charge_result charged = ownership_api.charge(svc, &req);
    if (!charged.allowed) {
        if (charged.limit.present && charged.limit.category == ownership_api.limit_category.e) {
            remember_loss(s, ownership_api.limit_category.e, charged.limit.bound, at,
                ownership_api.entity_id{});
        }
        if (ownership_api.successful(s->proof)) {
            s->proof = record_failure(svc, charged.proof, op, at);
        }
        return;
    }
    if (counts.e > limits->e) {
        // The explicit domain table can be stricter than the supplied service table.
        remember_loss(s, ownership_api.limit_category.e, limits->e, at, ownership_api.entity_id{});
        if (ownership_api.successful(s->proof)) {
            s->proof = record_failure(svc, ownership_api.incomplete(
                ownership_api.incomplete_reason.work_limit, op, at), op, at);
        }
    }
}

fn cover_bounds(ownership_state.state mut* s, ownership_api.services* svc,
    ownership_api.limit_table* limits, ownership_api.work_kind kind,
    ownership_api.operation_position op, ownership_api.source_position at) void {
    ownership_state.region_measurement measured = ownership_state.measure_regions(s, svc,
        ownership_state.region_candidate{}, kind, op, at);
    if (!ownership_api.successful(measured.proof)) {
        if (ownership_api.successful(s->proof)) {
            s->proof = record_failure(svc, measured.proof, op, at);
        }
        return;
    }
    cover_regions(s, limits, measured.amount, at);
    cover_predicates(s, limits, at);
    cover_guards(s, limits, at);
    cover_shapes(s, limits, at);
    cover_histories(s, svc, limits, kind, op, at);
}

fn trim_place(ownership_state.state mut* s, ownership_api.place_path input,
    u64 bound, ownership_api.source_position at) ownership_api.place_path {
    if (input.projections.len <= bound) { return input; }
    ownership_api.place_path mut out = input;
    out.projections = input.projections[0..bound];
    out.residual = true;
    remember_loss(s, ownership_api.limit_category.d, bound, at, input.root);
    return ownership_state.copy_place(s, out);
}

fn trim_region(ownership_state.state mut* s, ownership_api.region input,
    u64 bound, ownership_api.source_position at) ownership_api.region {
    if (input.partitions.len <= bound) { return input; }
    ownership_api.region mut out = input;
    out.partitions = input.partitions[0..bound];
    out.residual = true;
    remember_loss(s, ownership_api.limit_category.r, bound, at, input.key);
    return ownership_state.copy_region(s, out);
}

fn trim_borrow(ownership_state.state mut* s, ownership_api.borrow_relation input,
    ownership_api.limit_table* limits, ownership_api.source_position at)
    ownership_api.borrow_relation {
    ownership_api.borrow_relation mut out = input;
    out.containing = trim_place(s, input.containing, limits->d, at);
    out.range = trim_region(s, input.range, limits->r, at);
    return out;
}

fn trim_contents(ownership_state.state mut* s, ownership_api.limit_table* limits,
    ownership_api.source_position at) void {
    u64 mut i = 0;
    while (i < s->contents_len) {
        s->contents[i].place = trim_place(s, s->contents[i].place, limits->d, at);
        ownership_api.borrow_relation@ old = s->contents[i].borrows;
        if (old.len > 0) {
            ownership_api.borrow_relation mut@ own pending =
                new(ownership_api.borrow_relation, old.len);
            u64 mut j = 0;
            while (j < old.len) {
                pending[j] = trim_borrow(s, old[j], limits, at);
                j += 1;
            }
            s->contents[i].borrows = ownership_state.copy_borrows(s, pending[..]);
            del(pending);
        }
        i += 1;
    }
}

fn trim_allocations(ownership_state.state mut* s, ownership_api.limit_table* limits,
    ownership_api.source_position at) void {
    u64 mut i = 0;
    while (i < s->allocations_len) {
        s->allocations[i].owner.place = trim_place(s,
            s->allocations[i].owner.place, limits->d, at);
        ownership_api.history_fact@ old = s->allocations[i].history;
        if (old.len > 0) {
            ownership_api.history_fact mut@ own pending =
                new(ownership_api.history_fact, old.len);
            u64 mut j = 0;
            while (j < old.len) {
                pending[j] = old[j];
                pending[j].before.place = trim_place(s, old[j].before.place, limits->d, at);
                pending[j].after.place = trim_place(s, old[j].after.place, limits->d, at);
                j += 1;
            }
            u64 kept = canonical_histories(pending[..]);
            s->allocations[i].history = ownership_state.copy_histories(s, pending[0..kept]);
            del(pending);
        }
        i += 1;
    }
}

fn trim_ranges(ownership_state.state mut* s, ownership_api.limit_table* limits,
    ownership_api.source_position at) void {
    u64 mut i = 0;
    while (i < s->regions_len) {
        s->regions[i] = trim_region(s, s->regions[i], limits->r, at);
        i += 1;
    }
    i = 0;
    while (i < s->edges_len) {
        s->edges[i].place = trim_place(s, s->edges[i].place, limits->d, at);
        s->edges[i].range = trim_region(s, s->edges[i].range, limits->r, at);
        i += 1;
    }
}

/// Widens access paths and partitions while retaining their sources and owned leaves.
fn widen(ownership_state.state* a, ownership_state.state* b,
    ownership_api.services* svc, ownership_api.limit_table* limits,
    ownership_api.operation_position op, ownership_api.source_position at)
    ownership_state.state {
    bool valid = ownership_api.valid_limits(limits);
    ownership_state.state mut out = compose(a, b, svc, ownership_api.work_kind.widening,
        valid, op, at);
    if (!valid) { return out; }
    trim_contents(&out, limits, at);
    trim_allocations(&out, limits, at);
    trim_ranges(&out, limits, at);
    dedup_contents(&out);
    dedup_collision_facts(&out);
    cover_bounds(&out, svc, limits, ownership_api.work_kind.widening, op, at);
    dedup_contents(&out);
    dedup_collision_facts(&out);
    return out;
}
