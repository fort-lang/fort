/// Stores supplied foreign results with counted copies and stable retained views.
import ownership_api;
import ownership_keys;
import ownership_state;
import ownership_summary_model;
import ast;
import prim;
import types;

struct alternative {
    ownership_api.entity_id guard;
    ownership_state.state* before;
}
struct successor {
    ownership_state.state mut@ own states;
    ownership_api.entity_id mut@ own guards;
    u64 len;
}
struct effect_block {
    ownership_api.ordered_effect mut@ own items;
    effect_block mut* own next;
}
struct fact_store {
    ownership_state.state facts;
    effect_block mut* own effects;
}
struct result {
    successor mut* own core;
    ownership_api.source_fact mut@ own trusted_sources;
    ownership_api.ordered_effect mut@ own signature_transfers;
    ownership_api.outcome_fact mut@ own outcomes;
    fact_store store;
    ownership_api.proof_status proof;
    bool hidden_effects_outside_proof;
}
struct storage_context { result mut* own retained; }
struct storage_request {
    ownership_api.operation_position operation;
    ownership_api.source_position source;
    ownership_api.entity_id event;
    alternative@ alternatives;
    ownership_api.contents_fact@ arguments;
    ownership_api.source_fact@ trusted_sources;
    ownership_api.ordered_effect@ signature_transfers;
    ownership_api.outcome_fact@ outcomes;
    ownership_api.proof_status proof;
    bool hidden_effects_outside_proof;
}
struct staging {
    ownership_api.contents_fact mut@ own arguments;
    ownership_api.ordered_effect mut@ own transfers;
    alternative mut@ own alternatives;
    fact_store store;
}
struct copy_context {
    ownership_api.services* services;
    storage_request* request;
    ownership_api.proof_status proof;
}
struct construction {
    result mut* own selected;
    ownership_api.proof_status proof;
}

fn free_successor(successor mut* s) void {
    u64 mut i = 0;
    while (i < s->len) { ownership_state.free(&s->states[i]); i += 1; }
    del(s->states);
    del(s->guards);
    *s = successor{};
}
fn free_store(fact_store mut* s) void {
    effect_block mut* own mut b = move(s->effects);
    while (b != null) {
        effect_block mut* own next = move(b->next);
        del(b->items);
        del(b);
        b = move(next);
    }
    ownership_state.free(&s->facts);
}
fn free_result(result mut* r) void {
    if (r->core != null) { free_successor(r->core); }
    del(r->core);
    del(r->trusted_sources);
    del(r->signature_transfers);
    del(r->outcomes);
    free_store(&r->store);
    *r = result{};
}
fn clear(storage_context mut* c) void {
    if (c->retained != null) { free_result(c->retained); }
    del(c->retained);
}
fn free_staging(staging mut* s) void {
    del(s->arguments);
    del(s->transfers);
    del(s->alternatives);
    free_store(&s->store);
}
fn failed(copy_context mut* c, ownership_api.incomplete_reason reason,
    ownership_api.entity_id relation) void {
    if (!ownership_api.successful(c->proof)) { return; }
    c->proof = ownership_api.incomplete(reason, c->request->operation, c->request->source);
    c->proof.terminal.relation = relation;
}
fn spend(copy_context mut* c, u64 amount) bool {
    if (!ownership_api.successful(c->proof)) { return false; }
    ownership_api.charge_item[1] items = {
        ownership_api.charge_item{ownership_api.limit_category.w,
            ownership_api.limit_scope.computation, 1}};
    ownership_api.charge_request req = {ownership_api.work_kind.substitution,
        c->request->operation, c->request->source, items[..]};
    u64 mut i = 0;
    while (i < amount) {
        ownership_api.charge_result paid = ownership_api.charge(c->services, &req);
        if (!paid.allowed) { c->proof = paid.proof; return false; }
        i += 1;
    }
    return true;
}
fn array_permission(copy_context mut* c, u64 len) bool {
    return spend(c, 1) && (len == 0 || spend(c, len));
}
fn report(copy_context mut* c) void {
    if (ownership_api.successful(c->proof)) { return; }
    ownership_api.terminal_failure first = c->proof.terminal;
    ownership_api.event_descriptor mut event = {};
    event.key = c->request->event;
    event.operation = c->request->operation;
    event.source = c->request->source;
    event.kind = ownership_api.event_kind.incomplete_proof;
    if (first.reason == ownership_api.incomplete_reason.work_limit) {
        event.kind = ownership_api.event_kind.work_failure;
    }
    event.evidence = ownership_api.evidence_kind.abstract_possibility;
    event.reason = first.reason;
    event.relation = first.relation;
    event.limit = first.limit;
    ownership_api.event_request req = {event, c->proof};
    c->proof = ownership_api.record_event(c->services, &req).proof;
    // A report refusal cannot replace the first failed operation or exhaustion.
    if (first.present) {
        c->proof.kind = ownership_api.proof_kind.incomplete;
        c->proof.failed = true;
        c->proof.terminal = first;
    }
}
fn block(copy_context mut* c, ownership_state.state mut* s)
    ownership_state.slice_block mut* {
    if (!spend(c, 1)) { return null; }
    ownership_state.slice_block mut* own b = new(ownership_state.slice_block);
    ownership_state.slice_block mut* view = b;
    ownership_state.keep(s, move(b));
    return view;
}
fn copy_path(copy_context mut* c, ownership_state.state mut* s,
    ownership_api.place_path input) ownership_api.place_path {
    ownership_api.place_path mut out = input;
    if (input.projections.len == 0) { return out; }
    // Storage copies supplied paths. The semantic producer proves their depth.
    ownership_state.slice_block mut* b = block(c, s);
    if (b == null || !array_permission(c, input.projections.len)) {
        return ownership_api.place_path{};
    }
    b->projections = new(ownership_api.projection, input.projections.len);
    u64 mut i = 0;
    while (i < input.projections.len) {
        if (!spend(c, 1)) { return ownership_api.place_path{}; }
        b->projections[i] = input.projections[i];
        i += 1;
    }
    out.projections = b->projections[..];
    return out;
}

fn copy_leaves(copy_context mut* c, ownership_state.state mut* s,
    ownership_api.layout_leaf@ input) ownership_api.layout_leaf@ {
    ownership_api.layout_leaf@ none = {};
    if (input.len == 0) { return none; }
    ownership_state.slice_block mut* b = block(c, s);
    if (b == null || !array_permission(c, input.len)) { return none; }
    b->leaves = new(ownership_api.layout_leaf, input.len);
    u64 mut i = 0;
    while (i < input.len) {
        if (!spend(c, 1)) { return none; }
        b->leaves[i] = input[i];
        i += 1;
    }
    return b->leaves[..];
}

fn copy_partitions(copy_context mut* c, ownership_state.state mut* s,
    ownership_api.region_partition@ input) ownership_api.region_partition@ {
    ownership_api.region_partition@ none = {};
    if (input.len == 0) { return none; }
    ownership_state.slice_block mut* b = block(c, s);
    if (b == null || !array_permission(c, input.len)) { return none; }
    b->partitions = new(ownership_api.region_partition, input.len);
    u64 mut i = 0;
    while (i < input.len) {
        if (!spend(c, 1)) { return none; }
        b->partitions[i] = input[i];
        i += 1;
    }
    return b->partitions[..];
}

fn copy_entities(copy_context mut* c, ownership_state.state mut* s,
    ownership_api.entity_id@ input) ownership_api.entity_id@ {
    ownership_api.entity_id@ none = {};
    if (input.len == 0) { return none; }
    ownership_state.slice_block mut* b = block(c, s);
    if (b == null || !array_permission(c, input.len)) { return none; }
    b->entities = new(ownership_api.entity_id, input.len);
    u64 mut i = 0;
    while (i < input.len) {
        if (!spend(c, 1)) { return none; }
        b->entities[i] = input[i];
        i += 1;
    }
    return b->entities[..];
}

fn copy_region(copy_context mut* c, ownership_state.state mut* s,
    ownership_api.region input) ownership_api.region {
    ownership_api.region mut out = input;
    out.leaves = copy_leaves(c, s, input.leaves);
    out.partitions = copy_partitions(c, s, input.partitions);
    return out;
}
fn copy_contents(copy_context mut* c, ownership_state.state mut* s,
    ownership_api.contents_fact input) ownership_api.contents_fact {
    ownership_api.contents_fact mut out = input;
    out.place = copy_path(c, s, input.place);
    if (input.borrows.len == 0) { return out; }
    ownership_state.slice_block mut* b = block(c, s);
    if (b == null || !array_permission(c, input.borrows.len)) {
        return ownership_api.contents_fact{};
    }
    b->borrows = new(ownership_api.borrow_relation, input.borrows.len);
    u64 mut i = 0;
    while (i < input.borrows.len) {
        if (!spend(c, 1)) { return ownership_api.contents_fact{}; }
        b->borrows[i] = input.borrows[i];
        b->borrows[i].containing = copy_path(c, s, input.borrows[i].containing);
        b->borrows[i].range = copy_region(c, s, input.borrows[i].range);
        i += 1;
    }
    out.borrows = b->borrows[..];
    return out;
}
fn copy_allocation(copy_context mut* c, ownership_state.state mut* s,
    ownership_api.allocation_fact input) ownership_api.allocation_fact {
    ownership_api.allocation_fact mut out = input;
    out.owner.place = copy_path(c, s, input.owner.place);
    if (input.history.len == 0) { return out; }
    ownership_state.slice_block mut* b = block(c, s);
    if (b == null || !array_permission(c, input.history.len)) {
        return ownership_api.allocation_fact{};
    }
    b->history = new(ownership_api.history_fact, input.history.len);
    u64 mut i = 0;
    while (i < input.history.len) {
        if (!spend(c, 1)) { return ownership_api.allocation_fact{}; }
        b->history[i] = input.history[i];
        b->history[i].before.place = copy_path(c, s, input.history[i].before.place);
        b->history[i].after.place = copy_path(c, s, input.history[i].after.place);
        i += 1;
    }
    out.history = b->history[..];
    return out;
}
fn copy_edge(copy_context mut* c, ownership_state.state mut* s,
    ownership_api.graph_edge input) ownership_api.graph_edge {
    ownership_api.graph_edge mut out = input;
    out.place = copy_path(c, s, input.place);
    out.range = copy_region(c, s, input.range);
    return out;
}
fn copy_shape(copy_context mut* c, ownership_state.state mut* s,
    ownership_api.shape_description input) ownership_api.shape_description {
    ownership_api.shape_description mut out = input;
    out.parameters = copy_entities(c, s, input.parameters);
    out.clauses = copy_entities(c, s, input.clauses);
    out.descendants = copy_entities(c, s, input.descendants);
    return out;
}
fn copy_guard(copy_context mut* c, ownership_state.state mut* s,
    ownership_api.guard_fact input) ownership_api.guard_fact {
    ownership_api.guard_fact mut out = input;
    out.positive = copy_entities(c, s, input.positive);
    out.negative = copy_entities(c, s, input.negative);
    return out;
}
fn allocation_known(copy_context mut* c, ownership_state.state* s,
    ownership_api.entity_id key) bool {
    u64 mut i = 0;
    while (i < s->allocations_len) {
        if (!spend(c, 1)) { return false; }
        if (ownership_keys.entity(s->allocations[i].key, key) == 0) { return true; }
        i += 1;
    }
    return false;
}
fn validate_state(copy_context mut* c, ownership_state.state* s) bool {
    if (s == null || !spend(c, 1)) {
        failed(c, ownership_api.incomplete_reason.invalid_input, ownership_api.entity_id{});
        return false;
    }
    if (s->contents_len > s->contents.len ||
        s->sources_len > s->sources.len ||
        s->allocations_len > s->allocations.len ||
        s->regions_len > s->regions.len ||
        s->nodes_len > s->nodes.len ||
        s->edges_len > s->edges.len ||
        s->shapes_len > s->shapes.len ||
        s->predicates_len > s->predicates.len ||
        s->guards_len > s->guards.len ||
        s->correlations_len > s->correlations.len ||
        s->losses_len > s->losses.len) {
        failed(c, ownership_api.incomplete_reason.invalid_input, ownership_api.entity_id{});
        return false;
    }
    u64 mut i = 0;
    while (i < s->sources_len) {
        if (!spend(c, 1)) { return false; }
        ownership_api.source_fact fact = s->sources[i];
        if (fact.key.kind != ownership_api.entity_kind.source ||
            (fact.allocation.kind == ownership_api.entity_kind.allocation &&
            !allocation_known(c, s, fact.allocation))) {
            failed(c, ownership_api.incomplete_reason.missing_correspondence, fact.key);
            return false;
        }
        u64 mut j = 0;
        while (j < i) {
            if (!spend(c, 1)) { return false; }
            if (ownership_keys.entity(s->sources[j].key, fact.key) == 0) {
                failed(c, ownership_api.incomplete_reason.invalid_input, fact.key);
                return false;
            }
            j += 1;
        }
        i += 1;
    }
    i = 0;
    while (i < s->allocations_len) {
        if (!spend(c, 1)) { return false; }
        ownership_api.entity_id key = s->allocations[i].key;
        if (key.kind != ownership_api.entity_kind.allocation) {
            failed(c, ownership_api.incomplete_reason.invalid_input, key);
            return false;
        }
        u64 mut j = 0;
        while (j < i) {
            if (!spend(c, 1)) { return false; }
            if (ownership_keys.entity(s->allocations[j].key, key) == 0) {
                failed(c, ownership_api.incomplete_reason.invalid_input, key);
                return false;
            }
            j += 1;
        }
        i += 1;
    }
    i = 0;
    while (i < s->contents_len) {
        if (!spend(c, 1)) { return false; }
        ownership_api.contents_fact fact = s->contents[i];
        u64 mut b = 0;
        while (b < fact.borrows.len) {
            if (!spend(c, 1)) { return false; }
            ownership_api.borrow_relation relation = fact.borrows[b];
            if (relation.representation_complete) {
                bool mut found = false;
                u64 mut j = 0;
                while (j < s->sources_len) {
                    if (!spend(c, 1)) { return false; }
                    if (ownership_keys.entity(s->sources[j].key, relation.source) == 0) {
                        found = true;
                        break;
                    }
                    j += 1;
                }
                if (!found || ownership_keys.entity(relation.range.source, relation.source) != 0) {
                    failed(c, ownership_api.incomplete_reason.missing_correspondence,
                        relation.source);
                    return false;
                }
            }
            b += 1;
        }
        i += 1;
    }
    return ownership_api.successful(c->proof);
}
fn copy_state(copy_context mut* c, ownership_state.state* input,
    ownership_state.state mut* out) bool {
    if (!validate_state(c, input)) { return false; }
    if (input->contents_len != 0) {
        if (!array_permission(c, input->contents_len)) { return false; }
        out->contents = new(ownership_api.contents_fact, input->contents_len);
        u64 mut i = 0;
        while (i < input->contents_len) {
            if (!spend(c, 1)) { return false; }
            out->contents[i] = copy_contents(c, out, input->contents[i]);
            if (!ownership_api.successful(c->proof)) { return false; }
            out->contents_len += 1;
            i += 1;
        }
    }
    if (input->sources_len != 0) {
        if (!array_permission(c, input->sources_len)) { return false; }
        out->sources = new(ownership_api.source_fact, input->sources_len);
        u64 mut i = 0;
        while (i < input->sources_len) {
            if (!spend(c, 1)) { return false; }
            out->sources[i] = input->sources[i];
            if (!ownership_api.successful(c->proof)) { return false; }
            out->sources_len += 1;
            i += 1;
        }
    }
    if (input->allocations_len != 0) {
        if (!array_permission(c, input->allocations_len)) { return false; }
        out->allocations = new(ownership_api.allocation_fact, input->allocations_len);
        u64 mut i = 0;
        while (i < input->allocations_len) {
            if (!spend(c, 1)) { return false; }
            out->allocations[i] = copy_allocation(c, out, input->allocations[i]);
            if (!ownership_api.successful(c->proof)) { return false; }
            out->allocations_len += 1;
            i += 1;
        }
    }
    if (input->regions_len != 0) {
        if (!array_permission(c, input->regions_len)) { return false; }
        out->regions = new(ownership_api.region, input->regions_len);
        u64 mut i = 0;
        while (i < input->regions_len) {
            if (!spend(c, 1)) { return false; }
            out->regions[i] = copy_region(c, out, input->regions[i]);
            if (!ownership_api.successful(c->proof)) { return false; }
            out->regions_len += 1;
            i += 1;
        }
    }
    if (input->nodes_len != 0) {
        if (!array_permission(c, input->nodes_len)) { return false; }
        out->nodes = new(ownership_api.graph_node, input->nodes_len);
        u64 mut i = 0;
        while (i < input->nodes_len) {
            if (!spend(c, 1)) { return false; }
            out->nodes[i] = input->nodes[i];
            if (!ownership_api.successful(c->proof)) { return false; }
            out->nodes_len += 1;
            i += 1;
        }
    }
    if (input->edges_len != 0) {
        if (!array_permission(c, input->edges_len)) { return false; }
        out->edges = new(ownership_api.graph_edge, input->edges_len);
        u64 mut i = 0;
        while (i < input->edges_len) {
            if (!spend(c, 1)) { return false; }
            out->edges[i] = copy_edge(c, out, input->edges[i]);
            if (!ownership_api.successful(c->proof)) { return false; }
            out->edges_len += 1;
            i += 1;
        }
    }
    if (input->shapes_len != 0) {
        if (!array_permission(c, input->shapes_len)) { return false; }
        out->shapes = new(ownership_api.shape_description, input->shapes_len);
        u64 mut i = 0;
        while (i < input->shapes_len) {
            if (!spend(c, 1)) { return false; }
            out->shapes[i] = copy_shape(c, out, input->shapes[i]);
            if (!ownership_api.successful(c->proof)) { return false; }
            out->shapes_len += 1;
            i += 1;
        }
    }
    if (input->predicates_len != 0) {
        if (!array_permission(c, input->predicates_len)) { return false; }
        out->predicates = new(ownership_api.predicate_atom, input->predicates_len);
        u64 mut i = 0;
        while (i < input->predicates_len) {
            if (!spend(c, 1)) { return false; }
            out->predicates[i] = input->predicates[i];
            if (!ownership_api.successful(c->proof)) { return false; }
            out->predicates_len += 1;
            i += 1;
        }
    }
    if (input->guards_len != 0) {
        if (!array_permission(c, input->guards_len)) { return false; }
        out->guards = new(ownership_api.guard_fact, input->guards_len);
        u64 mut i = 0;
        while (i < input->guards_len) {
            if (!spend(c, 1)) { return false; }
            out->guards[i] = copy_guard(c, out, input->guards[i]);
            if (!ownership_api.successful(c->proof)) { return false; }
            out->guards_len += 1;
            i += 1;
        }
    }
    if (input->correlations_len != 0) {
        if (!array_permission(c, input->correlations_len)) { return false; }
        out->correlations = new(ownership_api.correlation, input->correlations_len);
        u64 mut i = 0;
        while (i < input->correlations_len) {
            if (!spend(c, 1)) { return false; }
            out->correlations[i] = input->correlations[i];
            if (!ownership_api.successful(c->proof)) { return false; }
            out->correlations_len += 1;
            i += 1;
        }
    }
    if (input->losses_len != 0) {
        if (!array_permission(c, input->losses_len)) { return false; }
        out->losses = new(ownership_api.lost_fact, input->losses_len);
        u64 mut i = 0;
        while (i < input->losses_len) {
            if (!spend(c, 1)) { return false; }
            out->losses[i] = input->losses[i];
            if (!ownership_api.successful(c->proof)) { return false; }
            out->losses_len += 1;
            i += 1;
        }
    }
    out->proof = input->proof;
    return true;
}
fn copy_effect(copy_context mut* c, fact_store mut* s,
    ownership_api.ordered_effect input) ownership_api.ordered_effect {
    ownership_api.ordered_effect mut out = input;
    out.place = copy_path(c, &s->facts, input.place);
    return out;
}
fn copy_effects(copy_context mut* c, fact_store mut* s,
    ownership_api.ordered_effect@ input) ownership_api.ordered_effect@ {
    ownership_api.ordered_effect@ none = {};
    if (input.len == 0 || !spend(c, 1)) { return none; }
    effect_block mut* own b = new(effect_block);
    effect_block mut* view = b;
    b->next = move(s->effects);
    s->effects = move(b);
    if (!array_permission(c, input.len)) { return none; }
    view->items = new(ownership_api.ordered_effect, input.len);
    u64 mut i = 0;
    while (i < input.len) {
        if (!spend(c, 1)) { return none; }
        view->items[i] = copy_effect(c, s, input[i]);
        i += 1;
    }
    return view->items[..];
}
fn prepare_staging(copy_context mut* c, staging mut* s) bool {
    storage_request* req = c->request;
    if (!array_permission(c, req->arguments.len)) { return false; }
    s->arguments = new(ownership_api.contents_fact, req->arguments.len);
    u64 mut i = 0;
    while (i < req->arguments.len) {
        if (!spend(c, 1)) { return false; }
        s->arguments[i] = copy_contents(c, &s->store.facts, req->arguments[i]);
        i += 1;
    }
    if (!array_permission(c, req->signature_transfers.len)) { return false; }
    s->transfers = new(ownership_api.ordered_effect, req->signature_transfers.len);
    i = 0;
    while (i < req->signature_transfers.len) {
        if (!spend(c, 1)) { return false; }
        s->transfers[i] = copy_effect(c, &s->store, req->signature_transfers[i]);
        i += 1;
    }
    if (!array_permission(c, req->alternatives.len)) { return false; }
    s->alternatives = new(alternative, req->alternatives.len);
    i = 0;
    while (i < req->alternatives.len) {
        if (!spend(c, 1)) { return false; }
        s->alternatives[i] = req->alternatives[i];
        i += 1;
    }
    return true;
}
fn populate(copy_context mut* c, staging* staged, result mut* out) bool {
    storage_request* req = c->request;
    if (!spend(c, 1)) { return false; }
    out->core = new(successor);
    if (!array_permission(c, staged->alternatives.len)) { return false; }
    out->core->states = new(ownership_state.state, staged->alternatives.len);
    out->core->len = staged->alternatives.len;
    if (!array_permission(c, staged->alternatives.len)) { return false; }
    out->core->guards = new(ownership_api.entity_id, staged->alternatives.len);
    u64 mut i = 0;
    while (i < staged->alternatives.len) {
        if (!spend(c, 1)) { return false; }
        out->core->guards[i] = staged->alternatives[i].guard;
        if (!copy_state(c, staged->alternatives[i].before, &out->core->states[i])) { return false; }
        i += 1;
    }
    if (!array_permission(c, req->trusted_sources.len)) { return false; }
    out->trusted_sources = new(ownership_api.source_fact, req->trusted_sources.len);
    i = 0;
    while (i < req->trusted_sources.len) {
        if (!spend(c, 1)) { return false; }
        out->trusted_sources[i] = req->trusted_sources[i];
        i += 1;
    }
    if (!array_permission(c, staged->transfers.len)) { return false; }
    out->signature_transfers = new(ownership_api.ordered_effect, staged->transfers.len);
    i = 0;
    while (i < staged->transfers.len) {
        if (!spend(c, 1)) { return false; }
        out->signature_transfers[i] = copy_effect(c, &out->store, staged->transfers[i]);
        i += 1;
    }
    if (!array_permission(c, req->outcomes.len)) { return false; }
    out->outcomes = new(ownership_api.outcome_fact, req->outcomes.len);
    i = 0;
    while (i < req->outcomes.len) {
        if (!spend(c, 1)) { return false; }
        out->outcomes[i] = req->outcomes[i];
        out->outcomes[i].effects = copy_effects(c, &out->store, req->outcomes[i].effects);
        i += 1;
    }
    if (!spend(c, 1)) { return false; }
    out->proof = req->proof;
    out->hidden_effects_outside_proof = req->hidden_effects_outside_proof;
    return true;
}
fn construct(ownership_api.services* svc, storage_request* req) construction {
    copy_context mut c = {svc, req, ownership_api.proof_status{
        .kind = ownership_api.proof_kind.complete}};
    construction mut out = {};
    if (req->proof.failed || req->proof.terminal.present) {
        out.proof = req->proof;
        out.proof.kind = ownership_api.proof_kind.incomplete;
        out.proof.failed = true;
        return out;
    }
    if (req->event.kind != ownership_api.entity_kind.event ||
        ownership_keys.function(req->event.function, req->operation.function) != 0) {
        out.proof = ownership_api.incomplete(ownership_api.incomplete_reason.missing_correspondence,
            req->operation, req->source);
        return out;
    }
    staging mut staged = {};
    defer free_staging(&staged);
    result mut* own mut selected = null;
    if (prepare_staging(&c, &staged) && spend(&c, 1)) {
        selected = new(result);
        if (populate(&c, &staged, selected)) {
            out.selected = move(selected);
            out.proof = c.proof;
            return out;
        }
    }
    if (selected != null) { free_result(selected); }
    del(selected);
    report(&c);
    out.proof = c.proof;
    return out;
}
fn public_view(result* r) ownership_api.ffi_result {
    ownership_api.ffi_result mut out = {};
    out.proof = r->proof;
    out.trusted_sources = r->trusted_sources[..];
    out.signature_transfers = r->signature_transfers[..];
    out.outcomes = r->outcomes[..];
    out.hidden_effects_outside_proof = r->hidden_effects_outside_proof;
    return out;
}
fn retain(storage_context mut* c, ownership_api.services* svc,
    storage_request* req) ownership_api.ffi_result {
    construction mut built = construct(svc, req);
    ownership_api.ffi_result mut out = {};
    if (!ownership_api.successful(built.proof)) { out.proof = built.proof; return out; }
    clear(c);
    c->retained = move(built.selected);
    return public_view(c->retained);
}
fn take_successor(storage_context mut* c) successor mut* own {
    if (c->retained == null) { return null; }
    successor mut* own out = move(c->retained->core);
    clear(c);
    return out;
}

// The private boundary validates supplied foreign-call operands.
struct boundary_event {
    ownership_api.operation_position operation;
    ownership_api.source_position source;
    ownership_api.entity_id key;
}
struct boundary_operand {
    types.node* ty;
    ownership_api.entity_id version;
    ownership_api.place_path holding;
}
struct storage_binding {
    ownership_api.entity_id root;
    types.node* ty;
}
struct boundary_request {
    ownership_api.ffi_request call;
    ownership_state.state* before;
    boundary_event@ events;
    ownership_api.checked_binding@ declarations;
    boundary_operand@ operands;
    storage_binding@ storage;
    bool event_map_complete;
    bool source_map_complete;
    bool graph_complete;
    bool inline_owned_layout_complete;
}
struct prepared_operand {
    types.node* ty;
    ownership_api.contents_fact value;
}
struct selected_allocation {
    ownership_api.entity_id allocation;
    ownership_api.entity_id node;
    ownership_api.place_path owner;
    ownership_api.graph_edge incoming;
    u64 argument;
}
struct boundary_plan {
    prepared_operand mut@ own operands;
    selected_allocation mut@ own selected;
    u64 selected_len;
    ownership_state.state paths;
}
struct preparation {
    boundary_plan mut* own selected;
    ownership_api.proof_status proof;
    ownership_api.entity_id event;
}
struct preparation_context {
    copy_context copy;
    storage_request metadata;
    boundary_request* request;
    string message;
    ownership_api.event_kind kind;
    ownership_api.entity_id relation;
    bool possible;
    // The boundary event key is no body key, so the refusal records no event.
    bool unkeyed;
}
struct checked_place {
    types.node* ty;
    u64 offset;
    bool complete;
}

fn free_boundary_plan(boundary_plan mut* plan) void {
    del(plan->operands);
    del(plan->selected);
    ownership_state.free(&plan->paths);
    *plan = boundary_plan{};
}
fn drop_boundary_plan(boundary_plan mut* own plan) void {
    if (plan != null) { free_boundary_plan(plan); }
    del(plan);
}
fn same_key(ownership_api.entity_id a, ownership_api.entity_id b) bool {
    return ownership_keys.entity(a, b) == 0;
}
fn preparation_fail(preparation_context mut* c, string text,
    ownership_api.event_kind kind, ownership_api.entity_id relation) bool {
    if (!ownership_api.successful(c->copy.proof)) { return false; }
    c->message = text;
    c->kind = kind;
    c->relation = relation;
    if (kind == ownership_api.event_kind.invalid_use ||
        kind == ownership_api.event_kind.caller_requirement ||
        kind == ownership_api.event_kind.lost_ownership) {
        c->copy.proof.failed = true;
    } else {
        failed(&c->copy, ownership_api.incomplete_reason.unknown_effect, relation);
    }
    return false;
}
fn preparation_report(preparation_context mut* c) void {
    if (ownership_api.successful(c->copy.proof) || c->unkeyed) { return; }
    ownership_api.terminal_failure first = c->copy.proof.terminal;
    ownership_api.event_descriptor mut event = {};
    event.key = c->metadata.event;
    event.operation = c->metadata.operation;
    event.source = c->metadata.source;
    event.kind = c->kind;
    // A violation on one feasible choice of several has no validated witness.
    event.evidence = c->copy.proof.kind == ownership_api.proof_kind.complete && !c->possible ?
        ownership_api.evidence_kind.unconditional :
        ownership_api.evidence_kind.abstract_possibility;
    event.reason = first.reason;
    event.relation = c->relation;
    event.text = c->message;
    event.limit = first.limit;
    if (first.reason == ownership_api.incomplete_reason.work_limit) {
        event.kind = ownership_api.event_kind.work_failure;
        if (event.text.len == 0) {
            event.text = "The work or representation budget refuses the operation.";
        }
    }
    ownership_api.witness_link[1] mut witness = {};
    if (event.evidence == ownership_api.evidence_kind.unconditional) {
        witness[0].key = event.key;
        witness[0].key.kind = ownership_api.entity_kind.witness;
        witness[0].condition = event.relation;
        witness[0].validated = true;
        event.witnesses = witness[..];
    }
    ownership_api.event_request req = {event, c->copy.proof};
    c->copy.proof = ownership_api.record_event(c->copy.services, &req).proof;
    if (first.present) {
        c->copy.proof.kind = ownership_api.proof_kind.incomplete;
        c->copy.proof.failed = true;
        c->copy.proof.terminal = first;
    }
}
fn checked_preparation_price(u64 count, u64 width, u64 mut* out) bool {
    if (width != 0 && count > ownership_state.U64_MAX / width) { return false; }
    *out = count * width;
    return true;
}
fn preparation_price(preparation_context mut* c, u64 count, u64 width) bool {
    u64 mut price = 0;
    if (!checked_preparation_price(count, width, &price)) {
        c->message = "The work price is not representable.";
        c->kind = ownership_api.event_kind.work_failure;
        failed(&c->copy, ownership_api.incomplete_reason.work_limit, ownership_api.entity_id{});
        return false;
    }
    return spend(&c->copy, price);
}
fn preparation_place(preparation_context mut* c, ownership_api.place_path a,
    ownership_api.place_path b) bool {
    if (!spend(&c->copy, 1) || a.residual || b.residual || !same_key(a.root, b.root) ||
        a.projections.len != b.projections.len) { return false; }
    u64 mut i = 0;
    while (i < a.projections.len) {
        if (!spend(&c->copy, 1)) { return false; }
        ownership_api.projection x = a.projections[i];
        ownership_api.projection y = b.projections[i];
        if (x.kind != y.kind || x.field != y.field || x.index.kind != y.index.kind ||
            x.index.value != y.index.value || !same_key(x.index.symbol, y.index.symbol) ||
            !same_key(x.captured_version, y.captured_version)) { return false; }
        i += 1;
    }
    return true;
}
fn preparation_contents(preparation_context mut* c, ownership_api.place_path place) u64 {
    ownership_state.state* s = c->request->before;
    u64 mut found = ownership_state.U64_MAX;
    u64 mut i = 0;
    while (i < s->contents_len) {
        if (preparation_place(c, place, s->contents[i].place)) {
            if (found != ownership_state.U64_MAX) { return ownership_state.U64_MAX; }
            found = i;
        }
        if (!ownership_api.successful(c->copy.proof)) { return ownership_state.U64_MAX; }
        i += 1;
    }
    return found;
}
fn preparation_source(preparation_context mut* c, ownership_api.entity_id key) u64 {
    ownership_state.state* s = c->request->before;
    u64 mut found = ownership_state.U64_MAX;
    u64 mut i = 0;
    while (i < s->sources_len) {
        if (!spend(&c->copy, 1)) { return ownership_state.U64_MAX; }
        if (same_key(s->sources[i].key, key)) {
            if (found != ownership_state.U64_MAX) { return ownership_state.U64_MAX; }
            found = i;
        }
        i += 1;
    }
    return found;
}
fn preparation_allocation(preparation_context mut* c, ownership_api.entity_id key) u64 {
    ownership_state.state* s = c->request->before;
    u64 mut found = ownership_state.U64_MAX;
    u64 mut i = 0;
    while (i < s->allocations_len) {
        if (!spend(&c->copy, 1)) { return ownership_state.U64_MAX; }
        if (same_key(s->allocations[i].key, key)) {
            if (found != ownership_state.U64_MAX) { return ownership_state.U64_MAX; }
            found = i;
        }
        i += 1;
    }
    return found;
}
fn preparation_size(preparation_context mut* c, types.node* ty, u64 depth,
    u64 mut* bytes) bool {
    if (ty == null || depth >= 64 || !spend(&c->copy, 1)) { return false; }
    if (ty->kind == types.type_kind.k_array) {
        u64 mut stride = 0;
        return preparation_size(c, ty->elem, depth + 1, &stride) &&
            checked_preparation_price(ty->len, stride, bytes);
    }
    if (ty->kind == types.type_kind.k_struct) {
        if (ty->layout == null || ty->layout->state != types.layout_state.l_resolved) {
            return false;
        }
        *bytes = ty->layout->size;
        return true;
    }
    if (ty->kind == types.type_kind.k_ptr || ty->kind == types.type_kind.k_voidptr ||
        ty->kind == types.type_kind.k_fn) { *bytes = 8; return true; }
    if (ty->kind == types.type_kind.k_span || ty->kind == types.type_kind.k_string) {
        *bytes = 16; return true;
    }
    if (ty->kind == types.type_kind.k_prim || ty->kind == types.type_kind.k_enum) {
        *bytes = types.type_sizeof(ty); return true;
    }
    return false;
}
fn preparation_type(preparation_context mut* c, ownership_api.place_path path)
    checked_place {
    checked_place mut out = {};
    if (path.residual) { return out; }
    u64 mut found = 0;
    u64 mut i = 0;
    while (i < c->request->storage.len) {
        if (!spend(&c->copy, 1)) { return out; }
        if (same_key(path.root, c->request->storage[i].root)) {
            found += 1;
            out.ty = c->request->storage[i].ty;
        }
        i += 1;
    }
    if (found != 1 || out.ty == null) { return checked_place{}; }
    i = 0;
    while (i < path.projections.len) {
        if (!spend(&c->copy, 1)) { return checked_place{}; }
        ownership_api.projection part = path.projections[i];
        if (part.kind == ownership_api.projection_kind.field) {
            if (out.ty->kind != types.type_kind.k_struct || out.ty->decl == null ||
                out.ty->layout == null || out.ty->layout->state != types.layout_state.l_resolved) {
                return checked_place{};
            }
            ast.sym* record = cast(out.ty->decl, ast.sym*);
            if (record->node == null) { return checked_place{}; }
            u64 mut n = 0;
            u32 mut field = 0;
            types.node* mut next = null;
            while (n < ast.ast_len(record->node)) {
                if (!spend(&c->copy, 1)) { return checked_place{}; }
                ast.node* member = ast.ast_child(record->node, n);
                if (member->kind == ast.ast_kind.k_field_decl) {
                    if (field == part.field) {
                        if (member->aux > ownership_state.U64_MAX - out.offset) {
                            return checked_place{};
                        }
                        out.offset += member->aux;
                        next = member->ty;
                        break;
                    }
                    field += 1;
                }
                n += 1;
            }
            if (next == null) { return checked_place{}; }
            out.ty = next;
        } else if (part.kind == ownership_api.projection_kind.fixed_index) {
            if (out.ty->kind != types.type_kind.k_array ||
                part.index.kind != ownership_api.fact_kind.exact || part.index.value < 0 ||
                cast(part.index.value, u64) >= out.ty->len) { return checked_place{}; }
            u64 mut stride = 0;
            u64 mut offset = 0;
            if (!preparation_size(c, out.ty->elem, 0, &stride) ||
                !checked_preparation_price(cast(part.index.value, u64), stride, &offset) ||
                offset > ownership_state.U64_MAX - out.offset) { return checked_place{}; }
            out.offset += offset;
            out.ty = out.ty->elem;
        } else { return checked_place{}; }
        i += 1;
    }
    out.complete = true;
    return out;
}
fn preparation_abi(types.node* ty, bool result_type) bool {
    return ty != null && (ty->kind == types.type_kind.k_ptr ||
        ty->kind == types.type_kind.k_voidptr || ty->kind == types.type_kind.k_prim ||
        ty->kind == types.type_kind.k_enum || ty->kind == types.type_kind.k_fn ||
        (result_type && ty->kind == types.type_kind.k_void));
}
fn preparation_view(preparation_context mut* c) bool {
    ownership_state.state* s = c->request->before;
    ownership_api.state_view v = c->request->call.before;
    if (!spend(&c->copy, 12) || !ownership_api.successful(v.proof)) { return false; }
    if (v.contents.len != s->contents_len || v.sources.len != s->sources_len ||
        v.allocations.len != s->allocations_len || v.regions.len != s->regions_len ||
        v.nodes.len != s->nodes_len || v.edges.len != s->edges_len ||
        v.shapes.len != s->shapes_len || v.predicates.len != s->predicates_len ||
        v.guards.len != s->guards_len || v.correlations.len != s->correlations_len ||
        v.losses.len != s->losses_len) { return false; }
    return (v.contents.len == 0 ||
        &v.contents[0] == cast(&s->contents[0], ownership_api.contents_fact*)) &&
        (v.sources.len == 0 || &v.sources[0] == cast(&s->sources[0], ownership_api.source_fact*)) &&
        (v.allocations.len == 0 ||
        &v.allocations[0] == cast(&s->allocations[0], ownership_api.allocation_fact*)) &&
        (v.regions.len == 0 || &v.regions[0] == cast(&s->regions[0], ownership_api.region*)) &&
        (v.nodes.len == 0 || &v.nodes[0] == cast(&s->nodes[0], ownership_api.graph_node*)) &&
        (v.edges.len == 0 || &v.edges[0] == cast(&s->edges[0], ownership_api.graph_edge*)) &&
        (v.shapes.len == 0 ||
        &v.shapes[0] == cast(&s->shapes[0], ownership_api.shape_description*)) &&
        (v.predicates.len == 0 ||
        &v.predicates[0] == cast(&s->predicates[0], ownership_api.predicate_atom*)) &&
        (v.guards.len == 0 || &v.guards[0] == cast(&s->guards[0], ownership_api.guard_fact*)) &&
        (v.correlations.len == 0 ||
        &v.correlations[0] == cast(&s->correlations[0], ownership_api.correlation*)) &&
        (v.losses.len == 0 || &v.losses[0] == cast(&s->losses[0], ownership_api.lost_fact*));
}
fn preparation_metadata(preparation_context mut* c) bool {
    boundary_request* r = c->request;
    if (!r->event_map_complete || r->events.len == 0) {
        return preparation_fail(c, "The event map is missing.",
            ownership_api.event_kind.incomplete_proof, ownership_api.entity_id{});
    }
    u64 mut matches = 0;
    u64 mut i = 0;
    while (i < r->events.len) {
        if (!spend(&c->copy, 1)) { return false; }
        boundary_event event = r->events[i];
        if (event.key.kind != ownership_api.entity_kind.event ||
            ownership_keys.function(event.key.function, event.operation.function) != 0) {
            return preparation_fail(c, "The event function does not match the operation.",
                ownership_api.event_kind.incomplete_proof, event.key);
        }
        u64 mut j = 0;
        while (j < i) {
            if (!spend(&c->copy, 1)) { return false; }
            if (same_key(event.key, r->events[j].key) ||
                ownership_keys.operation(event.operation, r->events[j].operation) == 0) {
                return preparation_fail(c, "The event map has duplicate keys.",
                    ownership_api.event_kind.incomplete_proof, event.key);
            }
            j += 1;
        }
        if (ownership_keys.operation(event.operation, r->call.operation) == 0) {
            matches += 1;
            c->metadata.event = event.key;
            // A failed state update of the boundary takes the update key of this event key.
            // A key that is no body key can equal an update key or the stop key in a shared
            // store, so the refusal records no event, as `ownership_calls.bind` does.
            if (ownership_summary_model.update_key(event.key).kind !=
                ownership_api.entity_kind.event) {
                c->unkeyed = true;
                failed(&c->copy, ownership_api.incomplete_reason.missing_correspondence,
                    event.key);
                return false;
            }
            if (!r->source_map_complete ||
                ownership_keys.source(event.source, r->call.source) != 0) {
                return preparation_fail(c, "The supplied source correspondence is missing.",
                    ownership_api.event_kind.incomplete_proof, event.key);
            }
        }
        i += 1;
    }
    if (matches != 1) { return preparation_fail(c, "The event map is missing.",
        ownership_api.event_kind.incomplete_proof, ownership_api.entity_id{}); }
    ownership_api.checked_binding binding = r->call.declaration;
    if (binding.symbol == null || binding.symbol->kind != ast.sym_kind.s_extern_fn) {
        return preparation_fail(c, "The declaration is not an extern function.",
            ownership_api.event_kind.incomplete_proof, ownership_api.entity_id{});
    }
    if (binding.ty == null || binding.ty->kind != types.type_kind.k_fn ||
        binding.ty != binding.symbol->ty || binding.symbol->error || binding.symbol->node == null ||
        !preparation_abi(binding.ty->elem, true)) {
        return preparation_fail(c, "The binding has no checked function type.",
            ownership_api.event_kind.incomplete_proof, ownership_api.entity_id{});
    }
    matches = 0;
    i = 0;
    while (i < r->declarations.len) {
        if (!spend(&c->copy, 1)) { return false; }
        ownership_api.checked_binding checked = r->declarations[i];
        if (ownership_keys.declaration(binding.declaration, checked.declaration) == 0) {
            matches += 1;
            if (checked.symbol != binding.symbol || checked.ty != binding.ty) {
                return preparation_fail(c, "The binding has no checked function type.",
                    ownership_api.event_kind.incomplete_proof, ownership_api.entity_id{});
            }
        }
        i += 1;
    }
    if (matches != 1) { return preparation_fail(c, "The binding has no checked function type.",
        ownership_api.event_kind.incomplete_proof, ownership_api.entity_id{}); }
    bool variadic = (binding.symbol->node->flags & ast.FLAG_VARIADIC) != 0;
    if (r->operands.len != r->call.arguments.len ||
        r->operands.len < binding.ty->params.len ||
        (!variadic && r->operands.len != binding.ty->params.len)) {
        return preparation_fail(c, "The fixed signature argument count does not match.",
            ownership_api.event_kind.incomplete_proof, ownership_api.entity_id{});
    }
    if (r->before == null || !ownership_api.successful(r->before->proof)) {
        return preparation_fail(c, "The caller state is missing or incomplete.",
            ownership_api.event_kind.incomplete_proof, ownership_api.entity_id{});
    }
    return true;
}
fn preparation_read(preparation_context mut* c, ownership_api.contents_fact value,
    bool variadic) bool {
    if (value.kind == ownership_api.contents_kind.unknown || value.place.residual) {
        return preparation_fail(c, "The captured argument version does not match.",
            ownership_api.event_kind.incomplete_proof, value.value_version);
    }
    if (value.kind == ownership_api.contents_kind.reference && value.borrows.len == 0 &&
        (!value.owner_empty || value.span_length.kind != ownership_api.fact_kind.exact ||
        value.span_length.value != 0)) {
        return preparation_fail(c, "The captured argument version does not match.",
            ownership_api.event_kind.incomplete_proof, value.value_version);
    }
    u64 mut i = 0;
    while (i < value.borrows.len) {
        if (!spend(&c->copy, 1)) { return false; }
        ownership_api.borrow_relation relation = value.borrows[i];
        u64 source = preparation_source(c, relation.source);
        if (!relation.representation_complete || !same_key(relation.value_version,
            value.value_version) || source == ownership_state.U64_MAX ||
            !preparation_place(c, relation.containing, value.place)) {
            return preparation_fail(c, "The captured argument version does not match.",
                ownership_api.event_kind.incomplete_proof, relation.source);
        }
        ownership_api.source_fact src = c->request->before->sources[source];
        if (src.validity == ownership_api.validity_kind.released) {
            return preparation_fail(c, variadic ? "The variadic pointer source is released." :
                "The argument source is released.", ownership_api.event_kind.invalid_use, src.key);
        }
        if (src.validity == ownership_api.validity_kind.ended) {
            return preparation_fail(c, "The argument source has ended.",
                ownership_api.event_kind.invalid_use, src.key);
        }
        if (src.validity != ownership_api.validity_kind.live ||
            src.kind == ownership_api.source_kind.unknown_fort) {
            return preparation_fail(c, "The captured argument version does not match.",
                ownership_api.event_kind.incomplete_proof, src.key);
        }
        if (src.allocation.kind == ownership_api.entity_kind.allocation) {
            u64 allocation = preparation_allocation(c, src.allocation);
            if (allocation == ownership_state.U64_MAX) {
                return preparation_fail(c, "The captured argument version does not match.",
                    ownership_api.event_kind.incomplete_proof, src.key);
            }
            ownership_api.validity_kind validity =
                c->request->before->allocations[allocation].validity;
            if (validity == ownership_api.validity_kind.released) {
                return preparation_fail(c, "The argument source is released.",
                    ownership_api.event_kind.invalid_use, src.key);
            }
            if (validity != ownership_api.validity_kind.live) {
                return preparation_fail(c, "The captured argument version does not match.",
                    ownership_api.event_kind.incomplete_proof, src.key);
            }
        }
        i += 1;
    }
    return true;
}
fn preparation_arguments(preparation_context mut* c, boundary_plan mut* plan) bool {
    boundary_request* r = c->request;
    u64 mut i = 0;
    while (i < r->operands.len) {
        if (!spend(&c->copy, 1)) { return false; }
        boundary_operand operand = r->operands[i];
        bool variadic = i >= r->call.declaration.ty->params.len;
        if (operand.ty == null || !preparation_abi(operand.ty, false) ||
            (!variadic && operand.ty != r->call.declaration.ty->params[i])) {
            return preparation_fail(c,
                "The supplied tail type violates the checked extern ABI precondition.",
                ownership_api.event_kind.incomplete_proof, operand.version);
        }
        // A transfer writes a canonical empty owner with no value version.
        if (operand.version.kind != ownership_api.entity_kind.none &&
            ownership_keys.function(operand.version.function, r->call.operation.function) != 0) {
            return preparation_fail(c, "The captured argument function key does not match.",
                ownership_api.event_kind.incomplete_proof, operand.version);
        }
        u64 at = preparation_contents(c, operand.holding);
        if (at == ownership_state.U64_MAX || !same_key(operand.version,
            r->call.arguments[i].value_version) || !same_key(operand.version,
            r->before->contents[at].value_version) || !preparation_place(c,
            operand.holding, r->call.arguments[i].place)) {
            return preparation_fail(c, "The captured argument version does not match.",
                ownership_api.event_kind.incomplete_proof, operand.version);
        }
        if (!preparation_read(c, r->before->contents[at], variadic)) { return false; }
        plan->operands[i].ty = operand.ty;
        plan->operands[i].value = copy_contents(&c->copy, &plan->paths,
            r->before->contents[at]);
        if (!ownership_api.successful(c->copy.proof)) { return false; }
        i += 1;
    }
    return true;
}
fn preparation_graph_fail(preparation_context mut* c) bool {
    return preparation_fail(c, "Canonical owned descendant coverage is incomplete.",
        ownership_api.event_kind.incomplete_proof, ownership_api.entity_id{});
}
fn preparation_node(preparation_context mut* c, ownership_api.entity_id allocation) u64 {
    ownership_state.state* s = c->request->before;
    u64 mut found = ownership_state.U64_MAX;
    u64 mut i = 0;
    while (i < s->nodes_len) {
        if (!spend(&c->copy, 1)) { return ownership_state.U64_MAX; }
        if (same_key(s->nodes[i].allocation, allocation)) {
            if (found != ownership_state.U64_MAX) {
                preparation_fail(c, "Canonical node and allocation correspondence is ambiguous.",
                    ownership_api.event_kind.incomplete_proof, allocation);
                return ownership_state.U64_MAX;
            }
            found = i;
        }
        i += 1;
    }
    if (found == ownership_state.U64_MAX) { return found; }
    ownership_api.graph_node node = s->nodes[found];
    if (node.residual || node.key.kind != ownership_api.entity_kind.graph_node) {
        preparation_graph_fail(c); return ownership_state.U64_MAX;
    }
    i = 0;
    while (i < s->nodes_len) {
        if (!spend(&c->copy, 1)) { return ownership_state.U64_MAX; }
        if (i != found && same_key(node.key, s->nodes[i].key)) {
            preparation_fail(c, "Canonical node and allocation correspondence is ambiguous.",
                ownership_api.event_kind.incomplete_proof, allocation);
            return ownership_state.U64_MAX;
        }
        i += 1;
    }
    return found;
}
fn preparation_target(preparation_context mut* c, ownership_api.entity_id node) u64 {
    ownership_state.state* s = c->request->before;
    u64 mut found = ownership_state.U64_MAX;
    u64 mut i = 0;
    while (i < s->nodes_len) {
        if (!spend(&c->copy, 1)) { return ownership_state.U64_MAX; }
        if (same_key(node, s->nodes[i].key)) {
            if (found != ownership_state.U64_MAX || s->nodes[i].residual) {
                preparation_graph_fail(c); return ownership_state.U64_MAX;
            }
            found = i;
        }
        i += 1;
    }
    return found;
}
fn preparation_owner(preparation_context mut* c, ownership_api.contents_fact value,
    ownership_api.allocation_fact owner) bool {
    if (value.kind != ownership_api.contents_kind.reference || value.owner_empty ||
        value.borrows.len != 1 || !owner.obligation || owner.owner.detached ||
        owner.owner.transfer_pending || owner.owner.place.residual ||
        !owner.count.one || owner.count.zero || owner.count.many ||
        owner.validity != ownership_api.validity_kind.live ||
        !value.borrows[0].representation_complete ||
        !same_key(value.borrows[0].value_version, value.value_version) ||
        !preparation_place(c, value.place, owner.owner.place)) { return false; }
    u64 source = preparation_source(c, value.borrows[0].source);
    if (source == ownership_state.U64_MAX) { return false; }
    ownership_api.source_fact src = c->request->before->sources[source];
    if (!same_key(src.allocation, owner.key) || src.validity != ownership_api.validity_kind.live) {
        return false;
    }
    return src.kind == ownership_api.source_kind.trusted_foreign ||
        (src.kind == ownership_api.source_kind.heap &&
        value.span_length.kind == ownership_api.fact_kind.exact &&
        owner.logical_length.kind == ownership_api.fact_kind.exact &&
        value.span_length.value == owner.logical_length.value);
}
fn preparation_ambiguous(preparation_context mut* c, ownership_api.allocation_fact owner)
    bool {
    ownership_state.state* s = c->request->before;
    u64 mut i = 0;
    while (i < s->allocations_len) {
        if (!spend(&c->copy, 1)) { return true; }
        ownership_api.allocation_fact other = s->allocations[i];
        if (!same_key(other.key, owner.key) && other.obligation &&
            other.validity != ownership_api.validity_kind.released &&
            preparation_place(c, other.owner.place, owner.owner.place)) { return true; }
        i += 1;
    }
    return false;
}
fn preparation_append(preparation_context mut* c, boundary_plan mut* plan,
    u64 allocation, u64 argument, ownership_api.graph_edge incoming) bool {
    ownership_api.allocation_fact fact = c->request->before->allocations[allocation];
    u64 mut i = 0;
    while (i < plan->selected_len) {
        if (!spend(&c->copy, 1)) { return false; }
        if (same_key(plan->selected[i].allocation, fact.key)) {
            if (plan->selected[i].argument != argument) {
                return preparation_fail(c, "Two own operands select the same allocation.",
                    ownership_api.event_kind.caller_requirement, fact.key);
            }
            return true;
        }
        i += 1;
    }
    u64 node = preparation_node(c, fact.key);
    if (!ownership_api.successful(c->copy.proof) ||
        plan->selected_len >= plan->selected.len || !spend(&c->copy, 1)) { return false; }
    selected_allocation mut item = {};
    item.allocation = fact.key;
    if (node != ownership_state.U64_MAX) { item.node = c->request->before->nodes[node].key; }
    item.argument = argument;
    item.owner = copy_path(&c->copy, &plan->paths, fact.owner.place);
    item.incoming = copy_edge(&c->copy, &plan->paths, incoming);
    if (!ownership_api.successful(c->copy.proof)) { return false; }
    plan->selected[plan->selected_len] = item;
    plan->selected_len += 1;
    return true;
}
fn preparation_edge(preparation_context mut* c, boundary_plan mut* plan,
    u64 parent, ownership_api.graph_edge edge) bool {
    ownership_state.state* s = c->request->before;
    selected_allocation selected = plan->selected[parent];
    if (edge.kind == ownership_api.edge_kind.residual || edge.place.residual ||
        edge.range.residual || !same_key(edge.place.root, selected.allocation) ||
        edge.key.kind != ownership_api.entity_kind.relation ||
        edge.from.kind != ownership_api.entity_kind.graph_node ||
        selected.node.kind != ownership_api.entity_kind.graph_node) {
        return preparation_graph_fail(c);
    }
    u64 target = preparation_target(c, edge.to);
    if (target == ownership_state.U64_MAX) { return preparation_graph_fail(c); }
    u64 allocation = preparation_allocation(c, s->nodes[target].allocation);
    if (allocation == ownership_state.U64_MAX) { return preparation_graph_fail(c); }
    u64 source = preparation_source(c, edge.range.source);
    checked_place leaf = preparation_type(c, edge.place);
    if (!leaf.complete || !types.type_is_reference(leaf.ty) ||
        (edge.kind == ownership_api.edge_kind.owned) != leaf.ty->is_own ||
        source == ownership_state.U64_MAX ||
        !same_key(s->sources[source].allocation, selected.allocation) ||
        edge.range.offset.kind != ownership_api.fact_kind.exact || edge.range.offset.value < 0 ||
        !edge.range.access.arithmetic_proved ||
        edge.range.access.begin.kind != ownership_api.fact_kind.exact ||
        edge.range.access.end.kind != ownership_api.fact_kind.exact ||
        edge.range.access.begin.value < 0 ||
        edge.range.access.end.value < edge.range.access.begin.value) {
        return preparation_graph_fail(c);
    }
    u64 offset = cast(edge.range.offset.value, u64);
    u64 low = cast(edge.range.access.begin.value, u64);
    u64 high = cast(edge.range.access.end.value, u64);
    u64 mut bytes = 0;
    if (!preparation_size(c, leaf.ty, 0, &bytes) || low > ownership_state.U64_MAX - offset ||
        offset + low != leaf.offset || high - low != bytes) { return preparation_graph_fail(c); }
    ownership_api.place_path mut root = {};
    root.root = selected.allocation;
    checked_place payload = preparation_type(c, root);
    u64 mut extent = 0;
    if (!payload.complete || edge.range.layout != payload.ty ||
        !preparation_size(c, payload.ty, 0, &extent) ||
        edge.range.extent.kind != ownership_api.fact_kind.exact || edge.range.extent.value < 0 ||
        cast(edge.range.extent.value, u64) != extent || offset > extent || high > extent - offset ||
        edge.range.alignment < 8 || edge.range.leaves.len != 1 ||
        s->sources[source].validity != ownership_api.validity_kind.live ||
        !spend(&c->copy, 1)) { return preparation_graph_fail(c); }
    ownership_api.layout_leaf supplied = edge.range.leaves[0];
    if (supplied.ty != leaf.ty || supplied.owning != leaf.ty->is_own || supplied.padding ||
        !supplied.bytes.arithmetic_proved ||
        supplied.bytes.begin.kind != ownership_api.fact_kind.exact ||
        supplied.bytes.end.kind != ownership_api.fact_kind.exact ||
        supplied.bytes.begin.value != cast(leaf.offset, i64) ||
        supplied.bytes.end.value < supplied.bytes.begin.value ||
        cast(supplied.bytes.end.value - supplied.bytes.begin.value, u64) != bytes) {
        return preparation_graph_fail(c);
    }
    u64 mut partition = 0;
    while (partition < edge.range.partitions.len) {
        if (!spend(&c->copy, 1)) { return false; }
        ownership_api.region_partition part = edge.range.partitions[partition];
        if (part.residual || !part.bytes.arithmetic_proved ||
            part.bytes.begin.kind != ownership_api.fact_kind.exact ||
            part.bytes.end.kind != ownership_api.fact_kind.exact ||
            part.bytes.begin.value < 0 || part.bytes.end.value < part.bytes.begin.value ||
            cast(part.bytes.end.value, u64) > extent) { return preparation_graph_fail(c); }
        partition += 1;
    }
    u64 holding = preparation_contents(c, edge.place);
    if (holding == ownership_state.U64_MAX) { return preparation_graph_fail(c); }
    ownership_api.contents_fact value = s->contents[holding];
    if (value.kind != ownership_api.contents_kind.reference || value.borrows.len != 1 ||
        !value.borrows[0].representation_complete || !same_key(value.value_version,
        value.borrows[0].value_version)) { return preparation_graph_fail(c); }
    u64 child_source = preparation_source(c, value.borrows[0].source);
    if (child_source == ownership_state.U64_MAX ||
        !same_key(s->sources[child_source].allocation, s->allocations[allocation].key) ||
        s->sources[child_source].validity != ownership_api.validity_kind.live ||
        s->allocations[allocation].validity != ownership_api.validity_kind.live) {
        return preparation_graph_fail(c);
    }
    if (edge.kind == ownership_api.edge_kind.borrowed) { return true; }
    if (preparation_ambiguous(c, s->allocations[allocation]) ||
        !preparation_owner(c, value, s->allocations[allocation])) {
        return preparation_graph_fail(c);
    }
    return preparation_append(c, plan, allocation, selected.argument, edge);
}
fn preparation_child_path(preparation_context mut* c, boundary_plan mut* plan,
    ownership_api.place_path parent, ownership_api.projection part) ownership_api.place_path {
    ownership_api.place_path mut path = parent;
    if (parent.projections.len == ownership_state.U64_MAX) { return ownership_api.place_path{}; }
    ownership_api.charge_item[1] items = {ownership_api.charge_item{
        ownership_api.limit_category.d, ownership_api.limit_scope.path, 1}};
    ownership_api.charge_request charge = {ownership_api.work_kind.substitution,
        c->metadata.operation, c->metadata.source, items[..]};
    ownership_api.charge_result paid = ownership_api.charge(c->copy.services, &charge);
    if (!paid.allowed) {
        c->copy.proof = paid.proof;
        return ownership_api.place_path{};
    }
    ownership_state.slice_block mut* store = block(&c->copy, &plan->paths);
    u64 len = parent.projections.len + 1;
    if (store == null || !array_permission(&c->copy, len)) { return ownership_api.place_path{}; }
    store->projections = new(ownership_api.projection, len);
    u64 mut i = 0;
    while (i < parent.projections.len) {
        if (!spend(&c->copy, 1)) { return ownership_api.place_path{}; }
        store->projections[i] = parent.projections[i]; i += 1;
    }
    store->projections[i] = part;
    path.projections = store->projections[..];
    return path;
}
fn preparation_fields(preparation_context mut* c, boundary_plan mut* plan,
    u64 parent, types.node* ty, ownership_api.place_path path, u64 depth) bool {
    if (ty == null || depth >= 64 || !spend(&c->copy, 1)) { return preparation_graph_fail(c); }
    if (types.type_is_reference(ty)) {
        if (!ty->is_own) { return true; }
        u64 at = preparation_contents(c, path);
        if (at == ownership_state.U64_MAX) { return preparation_graph_fail(c); }
        ownership_api.contents_fact value = c->request->before->contents[at];
        if (value.kind == ownership_api.contents_kind.empty_owner && value.owner_empty &&
            value.borrows.len == 0 && value.span_length.kind == ownership_api.fact_kind.exact &&
            value.span_length.value == 0) { return true; }
        u64 mut matches = 0;
        u64 mut i = 0;
        while (i < c->request->before->edges_len) {
            if (!spend(&c->copy, 1)) { return false; }
            ownership_api.graph_edge edge = c->request->before->edges[i];
            if (same_key(edge.from, plan->selected[parent].node) &&
                edge.kind == ownership_api.edge_kind.owned &&
                preparation_place(c, edge.place, path)) {
                matches += 1;
            }
            i += 1;
        }
        return matches == 1 || preparation_graph_fail(c);
    }
    if (ty->kind == types.type_kind.k_array) {
        u64 mut i = 0;
        while (i < ty->len) {
            if (!spend(&c->copy, 1) || i > 9223372036854775807) { return false; }
            ownership_api.projection mut part = {};
            part.kind = ownership_api.projection_kind.fixed_index;
            part.index.kind = ownership_api.fact_kind.exact;
            part.index.value = cast(i, i64);
            ownership_api.place_path child = preparation_child_path(c, plan, path, part);
            if (!ownership_api.successful(c->copy.proof) ||
                !preparation_fields(c, plan, parent, ty->elem, child, depth + 1)) { return false; }
            i += 1;
        }
    } else if (ty->kind == types.type_kind.k_struct) {
        if (ty->layout == null || ty->layout->state != types.layout_state.l_resolved ||
            ty->decl == null) { return preparation_graph_fail(c); }
        ast.sym* record = cast(ty->decl, ast.sym*);
        if (record->node == null) { return preparation_graph_fail(c); }
        u64 mut i = 0;
        u32 mut ordinal = 0;
        while (i < ast.ast_len(record->node)) {
            if (!spend(&c->copy, 1)) { return false; }
            ast.node* field = ast.ast_child(record->node, i);
            if (field->kind == ast.ast_kind.k_field_decl) {
                ownership_api.projection mut part = {};
                part.kind = ownership_api.projection_kind.field;
                part.field = ordinal;
                ownership_api.place_path child =
                    preparation_child_path(c, plan, path, part);
                if (!ownership_api.successful(c->copy.proof) ||
                    !preparation_fields(c, plan, parent, field->ty, child, depth + 1)) {
                    return false;
                }
                ordinal += 1;
            }
            i += 1;
        }
    }
    return true;
}
fn preparation_closure(preparation_context mut* c, boundary_plan mut* plan, u64 start) bool {
    ownership_state.state* s = c->request->before;
    u64 mut at = start;
    while (at < plan->selected_len) {
        if (!spend(&c->copy, 1)) { return false; }
        selected_allocation parent = plan->selected[at];
        u64 mut i = 0;
        while (i < s->edges_len) {
            if (!spend(&c->copy, 1)) { return false; }
            ownership_api.graph_edge edge = s->edges[i];
            if (same_key(edge.from, parent.node)) {
                u64 mut j = 0;
                while (j < i) {
                    if (!spend(&c->copy, 1)) { return false; }
                    if (same_key(edge.key, s->edges[j].key)) { return preparation_graph_fail(c); }
                    j += 1;
                }
                if (!preparation_edge(c, plan, at, edge)) { return false; }
            }
            i += 1;
        }
        ownership_api.place_path mut root = {};
        root.root = parent.allocation;
        checked_place payload = preparation_type(c, root);
        if (!payload.complete || !preparation_fields(c, plan, at, payload.ty, root, 0)) {
            return preparation_graph_fail(c);
        }
        i = 0;
        while (i < s->allocations_len) {
            if (!spend(&c->copy, 1)) { return false; }
            ownership_api.allocation_fact child = s->allocations[i];
            if (child.obligation && same_key(child.owner.place.root, parent.allocation)) {
                u64 mut matches = 0;
                u64 mut j = 0;
                while (j < plan->selected_len) {
                    if (!spend(&c->copy, 1)) { return false; }
                    if (same_key(child.key, plan->selected[j].allocation)) { matches += 1; }
                    j += 1;
                }
                if (matches != 1) { return preparation_graph_fail(c); }
            }
            i += 1;
        }
        at += 1;
    }
    return true;
}
fn preparation_selection(preparation_context mut* c, boundary_plan mut* plan) bool {
    boundary_request* r = c->request;
    u64 mut i = 0;
    while (i < r->call.declaration.ty->params.len) {
        if (!spend(&c->copy, 1)) { return false; }
        types.node* parameter = r->call.declaration.ty->params[i];
        if (types.type_is_reference(parameter) && parameter->is_own) {
            ownership_api.contents_fact value = plan->operands[i].value;
            checked_place holding = preparation_type(c, value.place);
            if (value.place.root.kind != ownership_api.entity_kind.slot) {
                return preparation_fail(c,
                    "The own argument has no actual external owning holding operand.",
                    ownership_api.event_kind.caller_requirement, value.value_version);
            }
            if (!holding.complete || !types.type_is_reference(holding.ty) || !holding.ty->is_own) {
                return preparation_fail(c, "The own argument has no unique owning operand.",
                    ownership_api.event_kind.caller_requirement, value.value_version);
            }
            if (value.kind == ownership_api.contents_kind.empty_owner && value.owner_empty &&
                value.borrows.len == 0 && value.span_length.kind == ownership_api.fact_kind.exact &&
                value.span_length.value == 0) { i += 1; continue; }
            if (value.borrows.len != 1) { return preparation_graph_fail(c); }
            u64 source = preparation_source(c, value.borrows[0].source);
            if (source == ownership_state.U64_MAX) { return preparation_graph_fail(c); }
            u64 owner = preparation_allocation(c, r->before->sources[source].allocation);
            if (owner == ownership_state.U64_MAX) { return preparation_graph_fail(c); }
            ownership_api.allocation_fact allocation = r->before->allocations[owner];
            if (allocation.count.zero || allocation.count.many || !allocation.count.one ||
                preparation_ambiguous(c, allocation)) {
                return preparation_fail(c, "The owning operand remains ambiguous.",
                    ownership_api.event_kind.incomplete_proof, allocation.key);
            }
            if (!preparation_owner(c, value, allocation)) {
                return preparation_fail(c, "The owning operand remains ambiguous.",
                    ownership_api.event_kind.incomplete_proof, allocation.key);
            }
            if (!r->graph_complete || !r->inline_owned_layout_complete) {
                return preparation_graph_fail(c);
            }
            u64 start = plan->selected_len;
            if (!preparation_append(c, plan, owner, i, ownership_api.graph_edge{}) ||
                !preparation_closure(c, plan, start)) { return false; }
        }
        i += 1;
    }
    return true;
}
fn prepare_boundary(ownership_api.services* svc, boundary_request* req) preparation {
    preparation_context mut c = {};
    c.copy.services = svc;
    c.copy.proof.kind = ownership_api.proof_kind.complete;
    c.metadata.operation = req->call.operation;
    c.metadata.source = req->call.source;
    if (req->events.len != 0) { c.metadata.event = req->events[0].key; }
    c.copy.request = &c.metadata;
    c.request = req;
    c.kind = ownership_api.event_kind.incomplete_proof;
    preparation mut out = {};
    if (preparation_metadata(&c) && validate_state(&c.copy, req->before) &&
        preparation_view(&c) &&
        preparation_price(&c, req->operands.len, 1) &&
        preparation_price(&c, req->before->allocations_len, 1)) {
        out.selected = new(boundary_plan);
        out.selected->operands = new(prepared_operand, req->operands.len);
        out.selected->selected = new(selected_allocation, req->before->allocations_len);
        out.selected->paths = ownership_state.empty();
        if (!preparation_arguments(&c, out.selected) ||
            !preparation_selection(&c, out.selected)) {
            drop_boundary_plan(move(out.selected));
        }
    }
    if (out.selected == null && ownership_api.successful(c.copy.proof)) {
        preparation_fail(&c, "The binding has no checked function type.",
            ownership_api.event_kind.incomplete_proof, ownership_api.entity_id{});
    }
    preparation_report(&c);
    out.proof = c.copy.proof;
    out.event = c.metadata.event;
    return out;
}

// The signature hook applies the trusted extern boundary to a prepared plan (D17.13).
// The producer partitions a foreign result into choices. Each choice names one destination, a
// new guard, and the facts that hold on that choice only. The hook adds them to that choice.
struct result_choice {
    ownership_api.entity_id guard;
    ownership_api.place_path destination;
    bool empty;
    ownership_api.predicate_atom@ facts;
}
// The closure assigns the fresh result keys before the hook runs. The hook checks them.
struct hook_request {
    boundary_request boundary;
    result_choice@ choices;
    bool choices_complete;
    ownership_api.entity_id fresh_source;
    ownership_api.entity_id fresh_allocation;
    ownership_api.entity_id fresh_version;
    ownership_api.entity_id fresh_relation;
}
enum result_shape { none, scalar, borrowed, owning }
enum place_relation { disjoint, overlap, equal }
struct hook_context {
    preparation_context prep;
    hook_request* request;
    boundary_plan* plan;
    result_shape shape;
    bool reported;
    ownership_state.state transferred;
    ownership_state.state mut@ own states;
    u64 states_len;
    ownership_api.ordered_effect mut@ own transfers;
    u64 transfers_len;
    ownership_api.source_fact[1] trusted;
    u64 trusted_len;
}
// The public callback context keeps the private inputs that the frozen request has no field for.
struct adapter {
    storage_context storage;
    hook_request request;
    ownership_api.services* services;
}

fn free_hook(hook_context mut* h) void {
    u64 mut i = 0;
    while (i < h->states_len) { ownership_state.free(&h->states[i]); i += 1; }
    del(h->states);
    del(h->transfers);
    ownership_state.free(&h->transferred);
    h->states_len = 0;
    h->transfers_len = 0;
}
fn hook_fail(hook_context mut* h, string text, ownership_api.event_kind kind,
    ownership_api.entity_id relation) bool {
    return preparation_fail(&h->prep, text, kind, relation);
}
// A state mutator reports its own refusal. A precision refusal has no report yet.
fn hook_mutation(hook_context mut* h, ownership_api.mutation_result result) bool {
    if (result.applied) { return true; }
    h->prep.copy.proof = result.proof;
    if (!result.precision_lost) { h->reported = true; }
    return false;
}
fn result_shape_of(types.node* ty) result_shape {
    if (ty->kind == types.type_kind.k_void) { return result_shape.none; }
    if (ty->kind == types.type_kind.k_ptr || ty->kind == types.type_kind.k_voidptr) {
        return ty->is_own ? result_shape.owning : result_shape.borrowed;
    }
    return result_shape.scalar;
}
fn hook_guard(hook_context mut* h, ownership_api.entity_id guard) bool {
    ownership_state.state* s = h->prep.request->before;
    u64 mut i = 0;
    while (i < s->guards_len) {
        if (!spend(&h->prep.copy, 1)) { return false; }
        if (same_key(s->guards[i].key, guard)) { return true; }
        i += 1;
    }
    return false;
}
// A choice fact has a new predicate key that no earlier fact of any choice uses.
fn hook_fact_key(hook_context mut* h, ownership_api.entity_id key, u64 choice, u64 fact) bool {
    if (!hook_key(h, key, ownership_api.entity_kind.predicate)) { return false; }
    ownership_state.state* s = h->prep.request->before;
    u64 mut i = 0;
    while (i < s->predicates_len) {
        if (!spend(&h->prep.copy, 1)) { return false; }
        if (same_key(s->predicates[i].key, key)) { return false; }
        i += 1;
    }
    u64 mut c = 0;
    while (c <= choice) {
        result_choice earlier = h->request->choices[c];
        u64 limit = c == choice ? fact : earlier.facts.len;
        u64 mut f = 0;
        while (f < limit) {
            if (!spend(&h->prep.copy, 1)) { return false; }
            if (same_key(earlier.facts[f].key, key)) { return false; }
            f += 1;
        }
        c += 1;
    }
    return true;
}
fn hook_on_result(hook_context mut* h, ownership_api.predicate_atom atom) bool {
    return atom.kind == ownership_api.predicate_kind.nullness &&
        same_key(atom.left, h->request->fresh_version);
}
// A nullness fact on the result says null with `lower` exact 0 and not null with exact 1.
fn hook_choice_facts(hook_context mut* h, u64 at) bool {
    result_choice choice = h->request->choices[at];
    u64 mut nulls = 0;
    u64 mut values = 0;
    u64 mut i = 0;
    while (i < choice.facts.len) {
        if (!spend(&h->prep.copy, 1)) { return false; }
        ownership_api.predicate_atom atom = choice.facts[i];
        bool bounded = atom.lower.kind == ownership_api.fact_kind.exact &&
            (atom.lower.value == 0 || atom.lower.value == 1);
        if (!hook_fact_key(h, atom.key, at, i) || (hook_on_result(h, atom) && !bounded)) {
            if (!ownership_api.successful(h->prep.copy.proof)) { return false; }
            return hook_fail(h, "The result choice facts are invalid.",
                ownership_api.event_kind.incomplete_proof, atom.key);
        }
        if (hook_on_result(h, atom) && atom.lower.value == 0) { nulls += 1; }
        if (hook_on_result(h, atom) && atom.lower.value == 1) { values += 1; }
        i += 1;
    }
    // An own result keeps its fresh obligation unless its own choice proves the result null.
    if (choice.empty && (nulls == 0 || values != 0)) {
        return hook_fail(h, "An empty result choice needs a null fact.",
            ownership_api.event_kind.incomplete_proof, choice.guard);
    }
    if (!choice.empty && h->shape == result_shape.owning && nulls != 0) {
        return hook_fail(h, "A nonempty owning result choice cannot be null.",
            ownership_api.event_kind.incomplete_proof, choice.guard);
    }
    return true;
}
// Every alternative copies the caller state, so the state cannot hold a fact on the result.
fn hook_fresh_facts(hook_context mut* h) bool {
    ownership_state.state* s = h->prep.request->before;
    u64 mut i = 0;
    while (i < s->predicates_len) {
        if (!spend(&h->prep.copy, 1)) { return false; }
        if (hook_on_result(h, s->predicates[i])) {
            return hook_fail(h, "The caller state already holds a nullness fact on the result.",
                ownership_api.event_kind.incomplete_proof, s->predicates[i].key);
        }
        i += 1;
    }
    return true;
}
// A destination is an actual local place of the calling function with exact projections.
fn hook_place(hook_context mut* h, ownership_api.place_path p) bool {
    if (p.root.kind != ownership_api.entity_kind.slot || p.residual ||
        ownership_keys.function(p.root.function,
        h->prep.request->call.operation.function) != 0) { return false; }
    u64 mut i = 0;
    while (i < p.projections.len) {
        if (!spend(&h->prep.copy, 1)) { return false; }
        ownership_api.projection part = p.projections[i];
        if (part.kind != ownership_api.projection_kind.field &&
            (part.kind != ownership_api.projection_kind.fixed_index ||
            part.index.kind != ownership_api.fact_kind.exact || part.index.value < 0)) {
            return false;
        }
        i += 1;
    }
    return true;
}
fn hook_choices(hook_context mut* h) bool {
    hook_request* r = h->request;
    u64 count = r->choices.len;
    if ((h->shape == result_shape.none && count != 0) ||
        (h->shape == result_shape.owning && count == 0) ||
        (count != 0 && !r->choices_complete)) {
        return hook_fail(h, "The result choices are incomplete.",
            ownership_api.event_kind.incomplete_proof, ownership_api.entity_id{});
    }
    // At least one choice of an own result carries its fresh obligation.
    bool mut nonempty = false;
    u64 mut i = 0;
    while (i < count) {
        if (!spend(&h->prep.copy, 1)) { return false; }
        if (!r->choices[i].empty) { nonempty = true; }
        i += 1;
    }
    if (h->shape == result_shape.owning && !nonempty) {
        return hook_fail(h, "An owning result needs a nonempty choice.",
            ownership_api.event_kind.incomplete_proof, ownership_api.entity_id{});
    }
    if (count != 0 && !hook_fresh_facts(h)) { return false; }
    i = 0;
    while (i < count) {
        if (!spend(&h->prep.copy, 1)) { return false; }
        result_choice choice = r->choices[i];
        if (!hook_place(h, choice.destination)) {
            if (!ownership_api.successful(h->prep.copy.proof)) { return false; }
            return hook_fail(h, "The result destination is not a complete local place.",
                ownership_api.event_kind.incomplete_proof, choice.destination.root);
        }
        if (choice.empty && h->shape != result_shape.owning) {
            return hook_fail(h, "Only an owning result has an empty choice.",
                ownership_api.event_kind.incomplete_proof, choice.destination.root);
        }
        if (h->shape == result_shape.owning) {
            checked_place held = preparation_type(&h->prep, choice.destination);
            if (!ownership_api.successful(h->prep.copy.proof)) { return false; }
            if (!held.complete || !types.type_is_reference(held.ty) || !held.ty->is_own) {
                return hook_fail(h, "The owning result destination is not an owning place.",
                    ownership_api.event_kind.incomplete_proof, choice.destination.root);
            }
        }
        if (count == 1 && (choice.guard.kind != ownership_api.entity_kind.none ||
            choice.facts.len != 0)) {
            return hook_fail(h, "A single result choice is unconditional.",
                ownership_api.event_kind.incomplete_proof, choice.guard);
        }
        if (count > 1 && (choice.guard.kind != ownership_api.entity_kind.guard ||
            hook_guard(h, choice.guard))) {
            if (!ownership_api.successful(h->prep.copy.proof)) { return false; }
            return hook_fail(h, "A result choice needs a new guard.",
                ownership_api.event_kind.incomplete_proof, choice.guard);
        }
        u64 mut j = 0;
        while (j < i) {
            if (!spend(&h->prep.copy, 1)) { return false; }
            if (same_key(r->choices[j].guard, choice.guard)) {
                return hook_fail(h, "The result choices repeat a guard.",
                    ownership_api.event_kind.incomplete_proof, choice.guard);
            }
            j += 1;
        }
        if (!hook_choice_facts(h, i)) { return false; }
        i += 1;
    }
    return true;
}
fn hook_key(hook_context mut* h, ownership_api.entity_id key, ownership_api.entity_kind kind)
    bool {
    return key.kind == kind && ownership_keys.function(key.function,
        h->prep.request->call.operation.function) == 0;
}
// Fresh keys cannot name an existing source, allocation, value version, or relation.
fn hook_fresh(hook_context mut* h) bool {
    hook_request* r = h->request;
    ownership_state.state* s = h->prep.request->before;
    if (r->choices.len == 0) { return true; }
    // A reference result has a nonempty choice, so it always needs a fresh source.
    bool sourced = h->shape == result_shape.borrowed || h->shape == result_shape.owning;
    bool allocates = h->shape == result_shape.owning;
    if (!hook_key(h, r->fresh_version, ownership_api.entity_kind.value) ||
        (sourced && (!hook_key(h, r->fresh_source, ownership_api.entity_kind.source) ||
        !hook_key(h, r->fresh_relation, ownership_api.entity_kind.relation))) ||
        (allocates && !hook_key(h, r->fresh_allocation, ownership_api.entity_kind.allocation))) {
        return hook_fail(h, "The fresh result keys are invalid.",
            ownership_api.event_kind.incomplete_proof, ownership_api.entity_id{});
    }
    u64 mut i = 0;
    while (i < s->contents_len) {
        if (!spend(&h->prep.copy, 1)) { return false; }
        if (same_key(s->contents[i].value_version, r->fresh_version)) {
            return hook_fail(h, "The fresh value version already exists.",
                ownership_api.event_kind.incomplete_proof, r->fresh_version);
        }
        i += 1;
    }
    i = 0;
    while (sourced && i < s->contents_len) {
        u64 mut b = 0;
        while (b < s->contents[i].borrows.len) {
            if (!spend(&h->prep.copy, 1)) { return false; }
            if (same_key(s->contents[i].borrows[b].key, r->fresh_relation)) {
                return hook_fail(h, "The fresh relation key already exists.",
                    ownership_api.event_kind.incomplete_proof, r->fresh_relation);
            }
            b += 1;
        }
        i += 1;
    }
    i = 0;
    while (sourced && i < s->edges_len) {
        if (!spend(&h->prep.copy, 1)) { return false; }
        if (same_key(s->edges[i].key, r->fresh_relation)) {
            return hook_fail(h, "The fresh relation key already exists.",
                ownership_api.event_kind.incomplete_proof, r->fresh_relation);
        }
        i += 1;
    }
    i = 0;
    while (sourced && i < s->sources_len) {
        if (!spend(&h->prep.copy, 1)) { return false; }
        if (same_key(s->sources[i].key, r->fresh_source)) {
            return hook_fail(h, "The fresh source key already exists.",
                ownership_api.event_kind.incomplete_proof, r->fresh_source);
        }
        i += 1;
    }
    i = 0;
    while (allocates && i < s->allocations_len) {
        if (!spend(&h->prep.copy, 1)) { return false; }
        if (same_key(s->allocations[i].key, r->fresh_allocation)) {
            return hook_fail(h, "The fresh allocation key already exists.",
                ownership_api.event_kind.incomplete_proof, r->fresh_allocation);
        }
        i += 1;
    }
    return true;
}
fn hook_source(hook_context mut* h, ownership_api.entity_id allocation) ownership_api.entity_id {
    ownership_state.state* s = &h->transferred;
    ownership_api.entity_id mut found = {};
    u64 mut matches = 0;
    u64 mut i = 0;
    while (i < s->sources_len) {
        if (!spend(&h->prep.copy, 1)) { return ownership_api.entity_id{}; }
        if (same_key(s->sources[i].allocation, allocation)) {
            found = s->sources[i].key;
            matches += 1;
        }
        i += 1;
    }
    return matches == 1 ? found : ownership_api.entity_id{};
}
// An own input discharges the caller once. The transfer itself releases nothing.
fn hook_transfers(hook_context mut* h) bool {
    boundary_plan* plan = h->plan;
    ownership_state.state mut* t = &h->transferred;
    // A failed state update takes the update key of the boundary event, not a body key.
    ownership_summary_model.update_route mut route = ownership_summary_model.update_route{};
    ownership_api.services keyed = ownership_summary_model.update_services(&route,
        h->prep.copy.services, h->prep.metadata.event);
    ownership_api.services* svc = &keyed;
    ownership_api.operation_position op = h->prep.metadata.operation;
    ownership_api.source_position at = h->prep.metadata.source;
    if (!array_permission(&h->prep.copy, plan->selected_len)) { return false; }
    h->transfers = new(ownership_api.ordered_effect, plan->selected_len);
    u64 mut i = 0;
    while (i < plan->selected_len) {
        if (!spend(&h->prep.copy, 1)) { return false; }
        selected_allocation item = plan->selected[i];
        u64 mut index = ownership_state.U64_MAX;
        u64 mut j = 0;
        while (j < t->allocations_len) {
            if (!spend(&h->prep.copy, 1)) { return false; }
            if (same_key(t->allocations[j].key, item.allocation)) { index = j; }
            j += 1;
        }
        if (index == ownership_state.U64_MAX) { return preparation_graph_fail(&h->prep); }
        ownership_api.entity_id source = hook_source(h, item.allocation);
        if (!ownership_api.successful(h->prep.copy.proof)) { return false; }
        ownership_api.place_path held = t->allocations[index].owner.place;
        ownership_api.owner_location mut after = {};
        after.detached = true;
        if (!hook_mutation(h, ownership_state.transfer_owner(t, svc, item.allocation, after,
            true, op, at))) { return false; }
        t->allocations[index].obligation = false;
        if (item.incoming.key.kind == ownership_api.entity_kind.none) {
            ownership_api.place_path holding = plan->operands[item.argument].value.place;
            ownership_api.place_path[1] aliases = {holding};
            ownership_api.contents_fact mut empty = {};
            empty.place = holding;
            empty.kind = ownership_api.contents_kind.empty_owner;
            empty.owner_empty = true;
            empty.span_length.kind = ownership_api.fact_kind.exact;
            if (!hook_mutation(h, ownership_state.strong_contents(t, svc, empty, aliases[..],
                true, op, at))) { return false; }
        }
        h->transfers[h->transfers_len] = ownership_api.ordered_effect{item.allocation,
            ownership_api.effect_kind.transfer, op, held, source, item.allocation,
            ownership_api.entity_id{}};
        h->transfers_len += 1;
        i += 1;
    }
    return true;
}
fn hook_relation(hook_context mut* h, ownership_api.place_path a, ownership_api.place_path b)
    place_relation {
    if (ownership_state.has_residual(a) || ownership_state.has_residual(b)) {
        return place_relation.overlap;
    }
    if (!same_key(a.root, b.root)) { return place_relation.disjoint; }
    u64 shorter = a.projections.len < b.projections.len ? a.projections.len : b.projections.len;
    u64 mut i = 0;
    while (i < shorter) {
        if (!spend(&h->prep.copy, 1)) { return place_relation.overlap; }
        ownership_api.projection x = a.projections[i];
        ownership_api.projection y = b.projections[i];
        if (x.kind == ownership_api.projection_kind.field &&
            y.kind == ownership_api.projection_kind.field) {
            if (x.field != y.field) { return place_relation.disjoint; }
        } else if (x.kind == ownership_api.projection_kind.fixed_index &&
            y.kind == ownership_api.projection_kind.fixed_index &&
            x.index.kind == ownership_api.fact_kind.exact &&
            y.index.kind == ownership_api.fact_kind.exact) {
            if (x.index.value != y.index.value) { return place_relation.disjoint; }
        } else { return place_relation.overlap; }
        i += 1;
    }
    return a.projections.len == b.projections.len ? place_relation.equal : place_relation.overlap;
}
// Result publication cannot discard a live owner. The check reads the state after transfers.
fn hook_destinations(hook_context mut* h) bool {
    ownership_state.state* t = &h->transferred;
    u64 count = h->request->choices.len;
    u64 mut c = 0;
    while (c < count) {
        ownership_api.place_path destination = h->request->choices[c].destination;
        u64 mut i = 0;
        while (i < t->allocations_len) {
            if (!spend(&h->prep.copy, 1)) { return false; }
            ownership_api.allocation_fact owner = t->allocations[i];
            if (owner.obligation) {
                place_relation related = hook_relation(h, owner.owner.place, destination);
                if (!ownership_api.successful(h->prep.copy.proof)) { return false; }
                bool one = owner.count.one && !owner.count.zero && !owner.count.many;
                if (related == place_relation.equal && one) {
                    h->prep.possible = count > 1;
                    return hook_fail(h, count > 1 ?
                        "A feasible result destination retains a live owner." :
                        "The result destination contains a live owner.",
                        ownership_api.event_kind.lost_ownership, owner.key);
                }
                if (related != place_relation.disjoint) {
                    return hook_fail(h, "The result destination may hold a live owner.",
                        ownership_api.event_kind.incomplete_proof, owner.key);
                }
            }
            i += 1;
        }
        c += 1;
    }
    return true;
}
// Each nonempty reference choice receives one fresh trusted source. An owning one also
// receives one fresh obligation with an unknown length. No nullness fact appears.
fn hook_write(hook_context mut* h, ownership_state.state mut* s, result_choice choice) bool {
    hook_request* r = h->request;
    // A failed state update takes the update key of the boundary event, not a body key.
    ownership_summary_model.update_route mut route = ownership_summary_model.update_route{};
    ownership_api.services keyed = ownership_summary_model.update_services(&route,
        h->prep.copy.services, h->prep.metadata.event);
    ownership_api.services* svc = &keyed;
    ownership_api.operation_position op = h->prep.metadata.operation;
    ownership_api.source_position at = h->prep.metadata.source;
    ownership_api.contents_fact mut value = {};
    value.place = choice.destination;
    value.value_version = r->fresh_version;
    ownership_api.borrow_relation[1] mut borrows = {};
    // The facts and the guard of a choice hold in that choice's state only.
    if (choice.guard.kind != ownership_api.entity_kind.none) {
        // Up to 8 facts use a fixed array. A scratch block in each write would reorder the
        // allocator's free lists, as `ownership_state.index_view` notes.
        ownership_api.entity_id[8] mut local = {};
        ownership_api.entity_id mut@ own mut spilled = {};
        defer del(spilled);
        ownership_api.entity_id mut@ mut positive = local[0..0];
        if (choice.facts.len <= local.len) { positive = local[0..choice.facts.len]; }
        else {
            spilled = new(ownership_api.entity_id, choice.facts.len);
            positive = spilled[..];
        }
        u64 mut i = 0;
        while (i < choice.facts.len) {
            if (!hook_mutation(h, ownership_state.add_predicate(s, svc, choice.facts[i], op, at))) {
                return false;
            }
            positive[i] = choice.facts[i].key;
            i += 1;
        }
        ownership_api.guard_fact mut guard = {};
        guard.key = choice.guard;
        guard.positive = positive;
        if (!hook_mutation(h, ownership_state.add_guard(s, svc, guard, op, at))) { return false; }
    }
    if (h->shape == result_shape.scalar) {
        value.kind = ownership_api.contents_kind.scalar;
    } else if (choice.empty) {
        value.kind = ownership_api.contents_kind.empty_owner;
        value.owner_empty = true;
        value.span_length.kind = ownership_api.fact_kind.exact;
    } else {
        ownership_api.source_fact mut source = {};
        source.key = r->fresh_source;
        source.kind = ownership_api.source_kind.trusted_foreign;
        source.validity = ownership_api.validity_kind.live;
        source.boundary = op;
        if (h->shape == result_shape.owning) { source.allocation = r->fresh_allocation; }
        if (!hook_mutation(h, ownership_state.add_source(s, svc, source, op, at))) {
            return false;
        }
        if (h->shape == result_shape.owning) {
            ownership_api.allocation_fact mut owner = {};
            owner.key = r->fresh_allocation;
            owner.site = r->fresh_allocation;
            owner.validity = ownership_api.validity_kind.live;
            owner.count.one = true;
            owner.obligation = true;
            owner.owner.place = choice.destination;
            if (!hook_mutation(h, ownership_state.add_allocation(s, svc, owner, op, at))) {
                return false;
            }
        }
        borrows[0].key = r->fresh_relation;
        borrows[0].value_version = r->fresh_version;
        borrows[0].containing = choice.destination;
        borrows[0].source = r->fresh_source;
        borrows[0].range.source = r->fresh_source;
        borrows[0].representation_complete = true;
        value.kind = ownership_api.contents_kind.reference;
        value.borrows = borrows[..];
        if (h->trusted_len == 0) { h->trusted[0] = source; h->trusted_len = 1; }
    }
    ownership_api.place_path[1] aliases = {choice.destination};
    return hook_mutation(h, ownership_state.strong_contents(s, svc, value, aliases[..], true,
        op, at));
}
fn hook_results(hook_context mut* h) bool {
    u64 count = h->request->choices.len;
    if (count == 0) { return true; }
    if (count == 1) { return hook_write(h, &h->transferred, h->request->choices[0]); }
    if (!array_permission(&h->prep.copy, count)) { return false; }
    h->states = new(ownership_state.state, count);
    u64 mut i = 0;
    while (i < count) {
        if (!spend(&h->prep.copy, 1)) { return false; }
        h->states_len += 1;
        if (!copy_state(&h->prep.copy, &h->transferred, &h->states[i]) ||
            !hook_write(h, &h->states[i], h->request->choices[i])) { return false; }
        i += 1;
    }
    return true;
}
/// The termination class of a call of the extern `symbol` with checked type `ty` (D17.19).
/// The std.libc declarations `exit(i32) noreturn` and `abort() noreturn` give normal process
/// exit and abort. A compatible declaration of the same C symbol shares that class, and D9.8
/// makes each declaration of one C symbol compatible. Every other foreign call, `_exit` and a
/// fort function named `exit` included, is unresolved foreign termination (D17.13).
fn termination(ast.sym* symbol, types.node* ty) ownership_api.outcome_kind {
    ownership_api.outcome_kind unresolved = ownership_api.outcome_kind.unresolved_foreign;
    if (symbol == null || ty == null || symbol->kind != ast.sym_kind.s_extern_fn ||
        ty->kind != types.type_kind.k_fn || !ty->is_noreturn) { return unresolved; }
    // A variable tail is part of the identity of a C symbol (D9.8).
    if (symbol->node != null && (symbol->node->flags & ast.FLAG_VARIADIC) != 0) {
        return unresolved;
    }
    if (symbol->name == "abort" && ty->params.len == 0) {
        return ownership_api.outcome_kind.abort;
    }
    if (symbol->name == "exit" && ty->params.len == 1) {
        types.node* code = ty->params[0];
        if (code->kind == types.type_kind.k_prim && code->prim == prim.prim_kind.prim_i32) {
            return ownership_api.outcome_kind.normal_process_exit;
        }
    }
    return unresolved;
}
fn hook_publish(storage_context mut* store, hook_context mut* h) ownership_api.ffi_result {
    ownership_api.ffi_result mut out = {};
    hook_request* r = h->request;
    u64 count = h->states_len == 0 ? 1 : h->states_len;
    u64 operands = h->plan->operands.len;
    if (!array_permission(&h->prep.copy, count) || !array_permission(&h->prep.copy, operands)) {
        preparation_report(&h->prep);
        out.proof = h->prep.copy.proof;
        return out;
    }
    alternative mut@ own alternatives = new(alternative, count);
    defer del(alternatives);
    ownership_api.contents_fact mut@ own arguments = new(ownership_api.contents_fact, operands);
    defer del(arguments);
    if (h->states_len == 0) {
        alternatives[0].before = &h->transferred;
        if (r->choices.len == 1) { alternatives[0].guard = r->choices[0].guard; }
    }
    u64 mut i = 0;
    while (i < h->states_len) {
        alternatives[i] = alternative{r->choices[i].guard, &h->states[i]};
        i += 1;
    }
    i = 0;
    while (i < operands) { arguments[i] = h->plan->operands[i].value; i += 1; }
    ownership_api.outcome_fact[1] mut outcomes = {};
    // Normal process exit needs its final cleanup; abort needs none (D17.19).
    outcomes[0].kind = termination(r->boundary.call.declaration.symbol,
        r->boundary.call.declaration.ty);
    outcomes[0].possible_caller_return = !r->boundary.call.declaration.ty->is_noreturn;
    outcomes[0].cleanup_required = outcomes[0].kind != ownership_api.outcome_kind.abort;
    outcomes[0].effects = h->transfers[..h->transfers_len];
    storage_request mut stored = {};
    stored.operation = h->prep.metadata.operation;
    stored.source = h->prep.metadata.source;
    stored.event = h->prep.metadata.event;
    stored.alternatives = alternatives[..];
    stored.arguments = arguments[..];
    stored.trusted_sources = h->trusted[..h->trusted_len];
    stored.signature_transfers = h->transfers[..h->transfers_len];
    stored.outcomes = outcomes[..];
    stored.proof.kind = ownership_api.proof_kind.complete;
    stored.hidden_effects_outside_proof = true;
    return retain(store, h->prep.copy.services, &stored);
}
/// Applies one trusted extern call to supplied caller facts (D17.13).
/// Only a complete call replaces the retained result. A failure keeps the input and that result.
fn apply_boundary(storage_context mut* store, ownership_api.services* svc, hook_request* req)
    ownership_api.ffi_result {
    ownership_api.ffi_result mut out = {};
    preparation mut prepared = prepare_boundary(svc, &req->boundary);
    if (!ownership_api.successful(prepared.proof) || prepared.selected == null) {
        drop_boundary_plan(move(prepared.selected));
        out.proof = prepared.proof;
        return out;
    }
    hook_context mut h = {};
    defer free_hook(&h);
    h.prep.copy.services = svc;
    h.prep.copy.proof.kind = ownership_api.proof_kind.complete;
    h.prep.metadata.operation = req->boundary.call.operation;
    h.prep.metadata.source = req->boundary.call.source;
    h.prep.metadata.event = prepared.event;
    h.prep.copy.request = &h.prep.metadata;
    h.prep.request = &req->boundary;
    h.prep.kind = ownership_api.event_kind.incomplete_proof;
    h.request = req;
    h.plan = prepared.selected;
    h.shape = result_shape_of(req->boundary.call.declaration.ty->elem);
    if (hook_choices(&h) && hook_fresh(&h) &&
        copy_state(&h.prep.copy, req->boundary.before, &h.transferred) &&
        hook_transfers(&h) && hook_destinations(&h) && hook_results(&h)) {
        out = hook_publish(store, &h);
    } else {
        if (!h.reported) { preparation_report(&h.prep); }
        out.proof = h.prep.copy.proof;
    }
    drop_boundary_plan(move(prepared.selected));
    return out;
}
/// Serves `ownership_api.foreign`. The context supplies the private boundary inputs.
fn adapter_call(void mut* opaque, ownership_api.ffi_request* req) ownership_api.ffi_result {
    adapter mut* a = cast(opaque, adapter mut*);
    a->request.boundary.call = *req;
    return apply_boundary(&a->storage, a->services, &a->request);
}
