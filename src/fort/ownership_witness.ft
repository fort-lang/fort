/// Validates one heap candidate on one exact path of one FIR body (D17.18).
// The checker does not prune a path with a heap fact. It stops when this core cannot execute an
// operation exactly. A later checker can cross calls. Limit X counts path steps and conditions.
import ast;
import consts;
import diag;
import fir;
import fir_flow;
import ownership_api;
import ownership_facts;
import ownership_flow;
import ownership_heap;
import prim;
import std.strbuf;
import types;

u32 NONE = 4294967295;
u64 PRODUCTION_X = 1024;
u64 PATH_DEPTH = 6;

/// A row of the diagnostic condition table.
enum condition_kind {
    call_returns,
    check_passes,
    nonnull,
    input_branch,
}

enum branch_selection {
    none,
    boolean_true,
    boolean_false,
    switch_case,
    switch_otherwise,
}

/// One condition of a witness path. `subject` is the FIR name that the note uses.
struct condition {
    condition_kind kind;
    string subject;
    ownership_api.source_position place;
    string required;
    string outcome;
    bool input;
    branch_selection selected;
    consts.cval selected_value;
    types.node* selected_type;
    // An input branch: whether no unselected arm can reach the operation, and the noun of the
    // event there. The note states the second clause only when `excludes` holds.
    bool excludes;
    string reached;
    fir.func* pointer_body;
    fir.place pointer_place;
    u32 pointer_prefix;
}

enum status {
    rejected,
    validated,
    refused,
}

/// The result of one check. The caller releases `conditions` with `free`.
struct result {
    status verdict;
    condition mut@ own conditions;
    u64 conditions_len;
    u64 used;
}

struct request {
    fir.func* body;
    ownership_heap.summary* summary;
    ownership_api.event_descriptor* candidate;
    ownership_flow.source_file_binding@ files;
    u64 bound;
    // The producer has no other candidate of the allocation of `candidate` in this body. Only
    // then can a branch note claim that the other arms do not reach the event.
    bool sole;
}

enum value_kind {
    unknown,
    null_value,
    constant,
    entry_value,
    reference_value,
    relation,
    allocation,
    address,
    zero_aggregate,
}

enum storage_kind {
    local,
    cell,
}

struct storage_key {
    storage_kind kind;
    u32 root;
    u32 depth;
    u32[6] path;
}

// A value on the selected path. `param` names an entry scalar. A relation compares that scalar
// with `constant_value`. An allocation names one exact path allocation. `ty` is the FIR type of
// the value; `typed` holds that each constant matches it. `unknown` names storage contents that
// this core does not know; an operation that it cannot execute exactly stops the path instead.
struct value {
    value_kind kind;
    consts.cval constant_value;
    u32 param;
    consts.cv_rel relation_value;
    u32 allocation_value;
    bool entry_reference;
    ownership_facts.nullness entry_root;
    storage_key address_key;
    types.node* address_ty;
    types.node* ty;
}

struct slot {
    storage_key key;
    types.node* ty;
    value contents;
}

struct allocation {
    bool live;
    bool obligation;
    bool fresh;
    u32 relation;
}

struct exclusion {
    u32 param;
    consts.cval value;
}

struct exact_state {
    request* input;
    slot mut@ own slots;
    u64 slots_len;
    allocation mut@ own allocations;
    u64 allocations_len;
    condition mut@ own conditions;
    u64 conditions_len;
    bool mut@ own chosen;
    consts.cval mut@ own choices;
    exclusion mut@ own exclusions;
    u64 exclusions_len;
    bool mut@ own entry_bound;
    u32 mut@ own entry_allocations;
    bool mut@ own local_live;
    fir_flow.bits passed;
    fir_flow.bits toward;
    u32 mut@ own distance;
    u64 used;
    u32 next_relation;
    u32 invalid_allocation;
    storage_key invalid_key;
    // The stores into input storage: `stored` after the first one, `stored_root` its referent,
    // and `stored_many` after a store through a second referent (`input_read`).
    bool stored;
    u32 stored_root;
    bool stored_many;
    bool refused;
    bool stopped;
}

struct place_result {
    bool resolved;
    bool invalid;
    storage_key key;
    types.node* ty;
    u32 invalid_allocation;
}

fn free(result mut* out) void {
    del(out->conditions);
    *out = result{};
}

fn state_free(exact_state mut* s) void {
    del(s->slots);
    del(s->allocations);
    del(s->conditions);
    del(s->chosen);
    del(s->choices);
    del(s->exclusions);
    del(s->entry_bound);
    del(s->entry_allocations);
    del(s->local_live);
    del(s->distance);
    fir_flow.bits_free(&s->passed);
    fir_flow.bits_free(&s->toward);
    *s = exact_state{};
}

fn source(exact_state* s, diag.loc where) ownership_api.source_position {
    ownership_api.source_position mut at = ownership_api.source_position{};
    at.filename_present = where.file.len > 0;
    u64 mut i = 0;
    while (i < s->input->files.len) {
        if (s->input->files[i].filename == where.file) {
            at.module = s->input->files[i].module;
            at.file = s->input->files[i].file;
            break;
        }
        i += 1;
    }
    at.line = where.line;
    at.col = where.col;
    at.end_line = where.end_line;
    at.end_col = where.end_col;
    return at;
}

// X is a precision bound. A refusal validates no event and creates no work-budget failure.
fn charge(exact_state mut* s) bool {
    u64 bound = s->input->bound == 0 ? PRODUCTION_X : s->input->bound;
    if (s->used >= bound) {
        s->refused = true;
        return false;
    }
    s->used += 1;
    return true;
}

fn same_key(storage_key a, storage_key b) bool {
    if (a.kind != b.kind || a.root != b.root || a.depth != b.depth) { return false; }
    u32 mut i = 0;
    while (i < a.depth) {
        if (a.path[i] != b.path[i]) { return false; }
        i += 1;
    }
    return true;
}

fn grow_slots(exact_state mut* s) void {
    if (s->slots_len < s->slots.len) { return; }
    u64 cap = s->slots.len == 0 ? 16 : s->slots.len * 2;
    slot mut@ own bigger = new(slot, cap);
    u64 mut i = 0;
    while (i < s->slots_len) { bigger[i] = s->slots[i]; i += 1; }
    del(s->slots);
    s->slots = move(bigger);
}

fn grow_allocations(exact_state mut* s) void {
    if (s->allocations_len < s->allocations.len) { return; }
    u64 cap = s->allocations.len == 0 ? 16 : s->allocations.len * 2;
    allocation mut@ own bigger = new(allocation, cap);
    u64 mut i = 0;
    while (i < s->allocations_len) { bigger[i] = s->allocations[i]; i += 1; }
    del(s->allocations);
    s->allocations = move(bigger);
}

fn add_allocation(exact_state mut* s, bool obligation, bool fresh, u32 relation) u32 {
    grow_allocations(s);
    u32 out = cast(s->allocations_len, u32);
    s->allocations[s->allocations_len] = allocation{true, obligation, fresh, relation};
    s->allocations_len += 1;
    return out;
}

// Whether constant `c` is a value of FIR type `ty`. `bool` holds a Boolean constant. An integer
// type holds an integer constant in its range. This core gives no other type a constant.
fn typed_pair(types.node* ty, consts.cval c) bool {
    if (ty == null || ty->kind != types.type_kind.k_prim) { return false; }
    if (ty->prim == prim.prim_kind.prim_bool) { return c.kind == consts.cval_kind.cv_bool; }
    return prim.prim_is_integer(ty->prim) && c.kind == consts.cval_kind.cv_int &&
        consts.cv_fits(c, ty->prim);
}

/// Whether `v` keeps the typed-value invariant: a constant matches its FIR type, and a null or
/// zeroed aggregate value names a type of its kind.
fn typed(value v) bool {
    if (v.kind == value_kind.constant) { return typed_pair(v.ty, v.constant_value); }
    if (v.kind == value_kind.null_value) {
        return v.ty != null && types.type_is_reference(v.ty);
    }
    if (v.kind == value_kind.zero_aggregate) { return aggregate_type(v.ty); }
    return true;
}

// The exact constant `c` of type `ty`, or an unknown value when `c` is no value of `ty`.
fn typed_constant(types.node* ty, consts.cval c) value {
    if (!typed_pair(ty, c)) { return value{}; }
    return value{.kind = value_kind.constant, .constant_value = c, .ty = ty};
}

fn bool_type(exact_state* s) types.node* {
    return types.type_prim(s->input->body->tt, prim.prim_kind.prim_bool);
}

fn aggregate_type(types.node* ty) bool {
    return ty != null && (ty->kind == types.type_kind.k_struct ||
        ty->kind == types.type_kind.k_array);
}

// The value of zeroed storage of type `ty`. A type without an exact zero here gives unknown.
fn typed_zero(types.node* ty) value {
    if (ty == null) { return value{}; }
    if (types.type_is_reference(ty)) { return value{.kind = value_kind.null_value, .ty = ty}; }
    if (ty->kind == types.type_kind.k_prim && ty->prim == prim.prim_kind.prim_bool) {
        return typed_constant(ty, consts.cv_from_bool(false));
    }
    if (ty->kind == types.type_kind.k_prim && prim.prim_is_integer(ty->prim)) {
        return typed_constant(ty, consts.cv_from_u64(0));
    }
    if (aggregate_type(ty)) { return value{.kind = value_kind.zero_aggregate, .ty = ty}; }
    return value{};
}

// The contents of a slot that no operation wrote. The nearest ancestor slot decides: below a
// zeroed aggregate the slot holds its typed zero, and below any other ancestor it is unknown. A
// later whole store of an ancestor thus hides an older zero above it. Without an ancestor slot,
// a cell of a fresh allocation holds its typed zero.
fn default_value(exact_state* s, storage_key key, types.node* ty) value {
    bool mut found = false;
    value mut nearest = value{};
    u32 mut depth = 0;
    u64 mut i = 0;
    while (i < s->slots_len) {
        if (below(s->slots[i].key, key) && (!found || s->slots[i].key.depth > depth)) {
            found = true;
            depth = s->slots[i].key.depth;
            nearest = s->slots[i].contents;
        }
        i += 1;
    }
    if (found) {
        return nearest.kind == value_kind.zero_aggregate ? typed_zero(ty) : value{};
    }
    if (key.kind == storage_kind.cell && cast(key.root, u64) < s->allocations_len &&
        s->allocations[cast(key.root, u64)].fresh) { return typed_zero(ty); }
    return value{};
}

// Whether `key` names storage that an input reaches: a cell of a referent that the path did not
// allocate. An entry pointer and a pointer in storage that the path does not know name such a
// referent.
fn input_storage(exact_state* s, storage_key key) bool {
    return key.kind == storage_kind.cell && cast(key.root, u64) < s->allocations_len &&
        !s->allocations[cast(key.root, u64)].fresh;
}

// Records a store into storage `key`: a write, a copy, a zero store, a move out or a release.
fn input_store(exact_state mut* s, storage_key key) void {
    if (!input_storage(s, key)) { return; }
    if (!s->stored) {
        s->stored = true;
        s->stored_root = key.root;
    } else if (s->stored_root != key.root) {
        s->stored_many = true;
    }
}

// Whether the path can read storage `key`. The checker makes no alias assumption between two
// referents of input storage: two inputs can name one storage. So after a store through one such
// referent, a read of input storage through another referent stops the path. A local or a cell
// that the path allocated keeps its contents: an input can name it only after a pointer to it
// reaches input storage, and a load of that pointer through another referent stops first.
fn input_read(exact_state mut* s, storage_key key) bool {
    if (!input_storage(s, key) || !s->stored) { return true; }
    if (!s->stored_many && s->stored_root == key.root) { return true; }
    s->stopped = true;
    return false;
}

fn slot_at(exact_state mut* s, storage_key key, types.node* ty) slot mut* {
    u64 mut i = 0;
    while (i < s->slots_len) {
        if (same_key(s->slots[i].key, key)) { return &s->slots[i]; }
        i += 1;
    }
    grow_slots(s);
    s->slots[s->slots_len] = slot{key, ty, default_value(s, key, ty)};
    s->slots_len += 1;
    return &s->slots[s->slots_len - 1];
}

fn subject(exact_state* s, fir.place p) string {
    if (p.base != fir.base_kind.bk_local) { return "the pointer"; }
    string name = fir.local_name(fir.local_at(s->input->body, p.local));
    return name.len == 0 ? "the pointer" : name;
}

fn prefix_type(fir.func* f, fir.place p, u32 count) types.node* {
    if (p.base != fir.base_kind.bk_local || count > p.proj_len) { return null; }
    types.node* mut ty = fir.local_at(f, p.local)->ty;
    u32 mut i = 0;
    while (i < count) {
        fir.projection part = fir.place_projection(f, p, i);
        if (part.kind == fir.proj_kind.pj_deref) {
            if (!types.type_is_reference(ty)) { return null; }
            ty = ty->elem;
        } else if (part.kind == fir.proj_kind.pj_field) {
            if (ty == null || ty->kind != types.type_kind.k_struct) { return null; }
            ty = fir.struct_field_type(ty, part.field);
        } else {
            if (ty == null || ty->kind != types.type_kind.k_array) { return null; }
            ty = ty->elem;
        }
        i += 1;
    }
    return ty;
}

// Appends one exact source-like place prefix. Parentheses keep each projection unambiguous.
fn append_place_prefix(fir.func* f, fir.place p, u32 count, strbuf.str_buf mut* out) bool {
    if (p.base != fir.base_kind.bk_local || count > p.proj_len) { return false; }
    if (count == 0) {
        string name = fir.local_name(fir.local_at(f, p.local));
        strbuf.append(out, name.len == 0 ? "the pointer" : name);
        return true;
    }
    fir.projection part = fir.place_projection(f, p, count - 1);
    if (part.kind == fir.proj_kind.pj_deref) {
        strbuf.append(out, "*(");
        if (!append_place_prefix(f, p, count - 1, out)) { return false; }
        strbuf.push(out, ')');
        return true;
    }
    strbuf.push(out, '(');
    if (!append_place_prefix(f, p, count - 1, out)) { return false; }
    strbuf.push(out, ')');
    if (part.kind == fir.proj_kind.pj_field) {
        types.node* ty = prefix_type(f, p, count - 1);
        string name = field_name(ty, part.field);
        if (name.len == 0) { return false; }
        strbuf.push(out, '.');
        strbuf.append(out, name);
        return true;
    }
    strbuf.push(out, '[');
    string index = fir.local_name(fir.local_at(f, part.index));
    strbuf.append(out, index.len == 0 ? "the index" : index);
    strbuf.push(out, ']');
    return true;
}

fn append_subject(condition* item, strbuf.str_buf mut* out) void {
    if (item->kind == condition_kind.nonnull && item->pointer_body != null &&
        append_place_prefix(item->pointer_body, item->pointer_place, item->pointer_prefix, out)) {
        return;
    }
    strbuf.append(out, item->subject);
}

fn grow_conditions(exact_state mut* s) void {
    if (s->conditions_len < s->conditions.len) { return; }
    u64 cap = s->conditions.len == 0 ? 8 : s->conditions.len * 2;
    condition mut@ own bigger = new(condition, cap);
    u64 mut i = 0;
    while (i < s->conditions_len) { bigger[i] = s->conditions[i]; i += 1; }
    del(s->conditions);
    s->conditions = move(bigger);
}

fn grow_exclusions(exact_state mut* s) void {
    if (s->exclusions_len < s->exclusions.len) { return; }
    u64 cap = s->exclusions.len == 0 ? 8 : s->exclusions.len * 2;
    exclusion mut@ own bigger = new(exclusion, cap);
    u64 mut i = 0;
    while (i < s->exclusions_len) { bigger[i] = s->exclusions[i]; i += 1; }
    del(s->exclusions);
    s->exclusions = move(bigger);
}

fn add_condition(exact_state mut* s, condition item) bool {
    if (!charge(s)) { return false; }
    grow_conditions(s);
    s->conditions[s->conditions_len] = item;
    s->conditions_len += 1;
    return true;
}

fn check_name(fir.check_kind kind) string {
    switch (kind) {
    case fir.check_kind.chk_bounds: return "the bounds check";
    case fir.check_kind.chk_span: return "the span check";
    case fir.check_kind.chk_alloc_count: return "the allocation-count check";
    case fir.check_kind.chk_enum: return "the enum check";
    case fir.check_kind.chk_user: return "the user check";
    case fir.check_kind.chk_panic: return "the panic check";
    case fir.check_kind.chk_div_zero: return "the division check";
    case fir.check_kind.chk_overflow, fir.check_kind.chk_div_overflow:
        return "the overflow check";
    case fir.check_kind.chk_shift: return "the shift check";
    case fir.check_kind.chk_overwrite: return "the overwrite check";
    }
}

fn note_nonnull(exact_state mut* s, fir.place p, u32 prefix, diag.loc at, bool input) bool {
    return add_condition(s, condition{.kind = condition_kind.nonnull, .subject = subject(s, p),
        .place = source(s, at), .required = "to be non-null here",
        .outcome = "a null pointer faults at this read first", .input = input,
        .pointer_body = s->input->body, .pointer_place = p, .pointer_prefix = prefix});
}

fn append_selected_value(condition* item, strbuf.str_buf mut* out) void {
    if (item->selected_type != null && item->selected_type->kind == types.type_kind.k_prim) {
        strbuf.append(out, prim.prim_name(item->selected_type->prim));
        strbuf.push(out, ' ');
    }
    if (item->selected_value.neg) { strbuf.push(out, '-'); }
    strbuf.append_u64(out, item->selected_value.mag);
}

// The input-branch row of the note table in the words that the user ruled, for the true arm of a
// Boolean branch: `BRANCH_HOLDS`, then `BRANCH_OTHER` and the event. The other selections state
// their selected outcome in the same form. The second clause is a claim about each unselected
// arm, so it renders only when the checker showed that no such arm can reach the operation.
string BRANCH_HOLDS = "the condition here to hold";
string BRANCH_OTHER = "; the other arm does not reach ";

// The noun of the event that a note names: "the leak" for a lost owner, "the invalid use" for an
// invalid use.
fn event_noun(ownership_api.event_kind kind) string {
    if (kind == ownership_api.event_kind.invalid_use) { return "the invalid use"; }
    if (kind == ownership_api.event_kind.lost_ownership) { return "the leak"; }
    return "";
}

fn append_second_clause(condition* item, string clause, strbuf.str_buf mut* out) void {
    if (!item->excludes || item->reached.len == 0) { return; }
    strbuf.append(out, clause);
    strbuf.append(out, item->reached);
}

fn append_branch_condition(condition* item, strbuf.str_buf mut* out) void {
    if (item->selected == branch_selection.boolean_true) {
        strbuf.append(out, BRANCH_HOLDS);
        append_second_clause(item, BRANCH_OTHER, out);
    } else if (item->selected == branch_selection.boolean_false) {
        strbuf.append(out, "the condition here to be false");
        append_second_clause(item, "; the true arm does not reach ", out);
    } else if (item->selected == branch_selection.switch_case) {
        strbuf.append(out, "the switch here to select case ");
        append_selected_value(item, out);
        append_second_clause(item, "; other switch outcomes do not reach ", out);
    } else if (item->selected == branch_selection.switch_otherwise) {
        strbuf.append(out, "the switch here to select otherwise");
        append_second_clause(item, "; the listed cases do not reach ", out);
    } else {
        strbuf.append(out, item->subject);
        strbuf.push(out, ' ');
        strbuf.append(out, item->required);
        append_second_clause(item, BRANCH_OTHER, out);
    }
}

// Only an established root can decide a path. An assumed or imported root stays unknown.
fn established_root(value v, ownership_facts.root_kind root) bool {
    return v.entry_root.how == ownership_facts.provenance.established &&
        v.entry_root.value == root;
}

fn append_part(storage_key mut* key, u32 part) bool {
    if (cast(key->depth, u64) >= PATH_DEPTH) { return false; }
    key->path[key->depth] = part;
    key->depth += 1;
    return true;
}

fn local_constant(exact_state mut* s, u32 local) value {
    storage_key key = storage_key{.kind = storage_kind.local, .root = local};
    return slot_at(s, key, fir.local_at(s->input->body, local)->ty)->contents;
}

fn entry_relation(exact_state* s, u32 local) u32 {
    if (s->input->summary == null) { return NONE; }
    u64 mut i = 0;
    while (i < s->input->summary->interface.len) {
        ownership_heap.interface_entry item = s->input->summary->interface[i];
        if (item.key.base == ownership_heap.base_kind.local && item.key.id == local &&
            item.key.depth == 0) { return cast(i + 1, u32); }
        i += 1;
    }
    return NONE;
}

// The index of the last dereference of `p`, or NONE.
fn last_deref(fir.func* f, fir.place p) u32 {
    u32 mut last = NONE;
    u32 mut i = 0;
    while (i < p.proj_len) {
        if (fir.place_projection(f, p, i).kind == fir.proj_kind.pj_deref) { last = i; }
        i += 1;
    }
    return last;
}

// Resolves storage on the selected path. A released root makes the access invalid. A free input
// pointer takes the nonnull outcome and records it. Any unsupported projection stops the path.
// The load of a pointer out of input storage is a read (`input_read`). For an address
// computation (`address`), the last dereference reads no storage and establishes no fact about
// its base (D17.18). So that dereference records no condition: the path stops unless the
// pointer is an exact allocation or address.
fn resolve_place(exact_state mut* s, fir.place p, diag.loc at, bool address) place_result {
    fir.func* f = s->input->body;
    if (p.base != fir.base_kind.bk_local) { return place_result{}; }
    storage_key mut key = storage_key{.kind = storage_kind.local, .root = p.local};
    types.node* mut ty = fir.local_at(f, p.local)->ty;
    u32 computed = address ? last_deref(f, p) : NONE;
    u32 mut i = 0;
    while (i < p.proj_len) {
        fir.projection part = fir.place_projection(f, p, i);
        if (part.kind == fir.proj_kind.pj_deref) {
            if (!input_read(s, key)) { return place_result{}; }
            slot mut* owner = slot_at(s, key, ty);
            value mut pointer = owner->contents;
            if (pointer.kind == value_kind.null_value) {
                return place_result{.resolved = true, .invalid = true, .key = key, .ty = ty,
                    .invalid_allocation = NONE};
            }
            if (i == computed && pointer.kind != value_kind.allocation &&
                pointer.kind != value_kind.address) { return place_result{}; }
            if (pointer.kind == value_kind.unknown) {
                if (!types.type_is_reference(ty)) { return place_result{}; }
                u32 root = add_allocation(s, false, false, NONE);
                pointer = value{.kind = value_kind.reference_value, .ty = ty,
                    .allocation_value = root, .entry_reference = true};
                owner->contents = pointer;
            }
            if (pointer.kind == value_kind.entry_value) {
                bool input = true;
                if (established_root(pointer, ownership_facts.root_kind.null_root)) {
                    return place_result{.resolved = true, .invalid = true, .key = key, .ty = ty,
                        .invalid_allocation = NONE};
                }
                if (!established_root(pointer, ownership_facts.root_kind.nonnull) &&
                    !note_nonnull(s, p, i, at, input)) { return place_result{}; }
                if (cast(pointer.param, u64) >= s->entry_bound.len) { return place_result{}; }
                u32 mut root = 0;
                if (s->entry_bound[cast(pointer.param, u64)]) {
                    root = s->entry_allocations[cast(pointer.param, u64)];
                } else {
                    root = add_allocation(s, false, false, entry_relation(s, pointer.param));
                    s->entry_bound[cast(pointer.param, u64)] = true;
                    s->entry_allocations[cast(pointer.param, u64)] = root;
                }
                pointer = value{.kind = value_kind.allocation, .allocation_value = root,
                    .entry_reference = input};
                owner->contents = pointer;
            }
            if (pointer.kind == value_kind.reference_value) {
                if (!note_nonnull(s, p, i, at, pointer.entry_reference)) {
                    return place_result{};
                }
                pointer.kind = value_kind.allocation;
                owner->contents = pointer;
            }
            if (pointer.kind == value_kind.address) {
                if (pointer.address_key.kind == storage_kind.cell) {
                    u64 backing = cast(pointer.address_key.root, u64);
                    if (backing >= s->allocations_len || !s->allocations[backing].live) {
                        return place_result{.resolved = true, .invalid = true, .key = key, .ty = ty,
                            .invalid_allocation = pointer.address_key.root};
                    }
                } else {
                    u64 backing = cast(pointer.address_key.root, u64);
                    if (backing >= s->local_live.len || !s->local_live[backing]) {
                        return place_result{.resolved = true, .invalid = true, .key = key, .ty = ty,
                            .invalid_allocation = NONE};
                    }
                }
                key = pointer.address_key;
                ty = pointer.address_ty;
                i += 1;
                continue;
            }
            if (pointer.kind != value_kind.allocation) { return place_result{}; }
            u64 root = cast(pointer.allocation_value, u64);
            if (root >= s->allocations_len) { return place_result{}; }
            if (!s->allocations[root].live) {
                return place_result{.resolved = true, .invalid = true, .key = key, .ty = ty,
                    .invalid_allocation = pointer.allocation_value};
            }
            key = storage_key{.kind = storage_kind.cell, .root = pointer.allocation_value};
            if (!types.type_is_reference(ty)) { return place_result{}; }
            ty = ty->elem;
        } else if (part.kind == fir.proj_kind.pj_field) {
            if (ty->kind != types.type_kind.k_struct || !append_part(&key, part.field)) {
                return place_result{};
            }
            ty = fir.struct_field_type(ty, part.field);
        } else {
            if (ty->kind != types.type_kind.k_array) { return place_result{}; }
            value index = local_constant(s, part.index);
            if (index.kind != value_kind.constant ||
                index.constant_value.kind != consts.cval_kind.cv_int || index.constant_value.neg ||
                index.constant_value.mag >= ty->len || index.constant_value.mag > 2147483647) {
                return place_result{};
            }
            u32 encoded = cast(index.constant_value.mag, u32) | 2147483648;
            if (!append_part(&key, encoded)) { return place_result{}; }
            ty = ty->elem;
        }
        i += 1;
    }
    return place_result{true, false, key, ty, NONE};
}

fn constant_value(fir.func* f, fir.constant k) value {
    if (k.kind == fir.const_kind.ck_null) {
        return value{.kind = value_kind.null_value, .ty = k.ty};
    }
    if (k.kind == fir.const_kind.ck_int || k.kind == fir.const_kind.ck_bool) {
        return typed_constant(fir.const_type(f, k), k.value);
    }
    if (k.kind == fir.const_kind.ck_zero) { return typed_zero(k.ty); }
    return value{};
}

// The contents of storage `key`. An unknown reference gets one referent identity on its first
// read, so each later read and each copy names the same referent. That identity is a name only.
// It does not mean other storage: `input_read` stops a read that a store through another
// referent can change.
fn stored_value(exact_state mut* s, storage_key key, types.node* ty) value {
    if (!input_read(s, key)) { return value{}; }
    slot mut* item = slot_at(s, key, ty);
    if (item->contents.kind == value_kind.unknown && ty != null && types.type_is_reference(ty)) {
        u32 root = add_allocation(s, false, false, NONE);
        item->contents = value{.kind = value_kind.reference_value, .ty = ty,
            .allocation_value = root, .entry_reference = true};
    }
    return item->contents;
}

fn place_value(exact_state mut* s, fir.place p, diag.loc at, bool mut* invalid) value {
    place_result got = resolve_place(s, p, at, false);
    if (!got.resolved) { s->stopped = true; return value{}; }
    if (got.invalid) {
        *invalid = true;
        s->invalid_allocation = got.invalid_allocation;
        s->invalid_key = got.key;
        return value{};
    }
    return stored_value(s, got.key, got.ty);
}

fn operand_value(exact_state mut* s, fir.operand o, diag.loc at, bool mut* invalid) value {
    if (o.kind == fir.operand_kind.ok_const) { return constant_value(s->input->body, o.value); }
    return place_value(s, o.place, at, invalid);
}

fn relation_of(fir.rvalue_kind kind) consts.cv_rel {
    if (kind == fir.rvalue_kind.rv_eq) { return consts.cv_rel.cv_rel_eq; }
    if (kind == fir.rvalue_kind.rv_ne) { return consts.cv_rel.cv_rel_ne; }
    if (kind == fir.rvalue_kind.rv_lt) { return consts.cv_rel.cv_rel_lt; }
    if (kind == fir.rvalue_kind.rv_le) { return consts.cv_rel.cv_rel_le; }
    if (kind == fir.rvalue_kind.rv_gt) { return consts.cv_rel.cv_rel_gt; }
    return consts.cv_rel.cv_rel_ge;
}

fn relation_kind(fir.rvalue_kind kind) bool {
    return kind == fir.rvalue_kind.rv_eq || kind == fir.rvalue_kind.rv_ne ||
        kind == fir.rvalue_kind.rv_lt || kind == fir.rvalue_kind.rv_le ||
        kind == fir.rvalue_kind.rv_gt || kind == fir.rvalue_kind.rv_ge;
}

fn equality_kind(fir.rvalue_kind kind) bool {
    return kind == fir.rvalue_kind.rv_eq || kind == fir.rvalue_kind.rv_ne;
}

fn exact_binary(fir.rvalue_kind kind, types.node* ty, consts.cval a, consts.cval b,
    consts.cval mut* out) bool {
    if (ty == null || ty->kind != types.type_kind.k_prim || !prim.prim_is_integer(ty->prim)) {
        return false;
    }
    if (kind == fir.rvalue_kind.rv_add) {
        *out = consts.cv_wrap_add(a, b, ty->prim);
        return true;
    }
    if (kind == fir.rvalue_kind.rv_sub) {
        *out = consts.cv_wrap_sub(a, b, ty->prim);
        return true;
    }
    if (kind == fir.rvalue_kind.rv_mul) {
        *out = consts.cv_wrap_mul(a, b, ty->prim);
        return true;
    }
    if (kind == fir.rvalue_kind.rv_div) { return consts.cv_typed_div(a, b, ty->prim, out); }
    if (kind == fir.rvalue_kind.rv_rem) { return consts.cv_typed_rem(a, b, ty->prim, out); }
    return false;
}

fn implemented_binary(fir.rvalue_kind kind) bool {
    return relation_kind(kind) || kind == fir.rvalue_kind.rv_add ||
        kind == fir.rvalue_kind.rv_sub || kind == fir.rvalue_kind.rv_mul ||
        kind == fir.rvalue_kind.rv_div || kind == fir.rvalue_kind.rv_rem;
}

// Whether `rel` holds between a value and itself.
fn reflexive(consts.cv_rel rel) bool {
    return rel == consts.cv_rel.cv_rel_eq || rel == consts.cv_rel.cv_rel_le ||
        rel == consts.cv_rel.cv_rel_ge;
}

fn same_prim(types.node* a, types.node* b) bool {
    return a != null && b != null && a->kind == types.type_kind.k_prim &&
        b->kind == types.type_kind.k_prim && a->prim == b->prim;
}

// Whether `a` and `b` are one exact value: the null pointer, one entry value, one referent or one
// storage address. Two referents with different identities can still be one pointer, so they
// are not one exact value, and `compare` stops on them.
fn same_identity(value a, value b) bool {
    if (a.kind == value_kind.null_value && b.kind == value_kind.null_value) { return true; }
    if (a.kind == value_kind.entry_value && b.kind == value_kind.entry_value) {
        return a.param == b.param;
    }
    bool a_referent = a.kind == value_kind.allocation || a.kind == value_kind.reference_value;
    bool b_referent = b.kind == value_kind.allocation || b.kind == value_kind.reference_value;
    if (a_referent && b_referent) { return a.allocation_value == b.allocation_value; }
    if (a.kind == value_kind.address && b.kind == value_kind.address) {
        return same_key(a.address_key, b.address_key);
    }
    return false;
}

// Compares two operand values. Two typed constants compare by their constants, and one identity
// compares by its value. An allocation pointer is not null. An entry scalar against a constant
// gives an input relation. Any other pair stops the path, so no comparison gives an unknown result.
fn compare(exact_state mut* s, fir.rvalue_kind kind, value a, value b) value {
    consts.cv_rel rel = relation_of(kind);
    types.node* result = bool_type(s);
    bool boolean = (a.kind == value_kind.constant &&
        a.constant_value.kind == consts.cval_kind.cv_bool) ||
        (b.kind == value_kind.constant && b.constant_value.kind == consts.cval_kind.cv_bool);
    if (boolean && !equality_kind(kind)) { s->stopped = true; return value{}; }
    if (a.kind == value_kind.constant && b.kind == value_kind.constant) {
        if (!typed(a) || !typed(b) || !same_prim(a.ty, b.ty)) {
            s->stopped = true;
            return value{};
        }
        return typed_constant(result, consts.cv_compare(rel, a.constant_value,
            b.constant_value));
    }
    if (same_identity(a, b)) { return typed_constant(result, consts.cv_from_bool(reflexive(rel))); }
    bool null_pair = (a.kind == value_kind.allocation && b.kind == value_kind.null_value) ||
        (a.kind == value_kind.null_value && b.kind == value_kind.allocation);
    if (equality_kind(kind) && null_pair) {
        return typed_constant(result, consts.cv_from_bool(rel == consts.cv_rel.cv_rel_ne));
    }
    if (a.kind == value_kind.entry_value && b.kind == value_kind.constant && typed(b) &&
        same_prim(a.ty, b.ty)) {
        return value{.kind = value_kind.relation, .ty = result, .param = a.param,
            .relation_value = rel, .constant_value = b.constant_value};
    }
    s->stopped = true;
    return value{};
}

fn rvalue_value(exact_state mut* s, fir.rvalue r, diag.loc at, bool mut* invalid) value {
    fir.func* f = s->input->body;
    if (r.kind == fir.rvalue_kind.rv_alloc) {
        u32 relation = s->next_relation;
        s->next_relation += 1;
        return value{.kind = value_kind.allocation,
            .allocation_value = add_allocation(s, true, true, relation)};
    }
    if (r.kind == fir.rvalue_kind.rv_addr) {
        place_result got = resolve_place(s, r.place, at, true);
        if (!got.resolved || got.invalid) { s->stopped = true; return value{}; }
        return value{.kind = value_kind.address, .address_key = got.key, .address_ty = got.ty};
    }
    if (r.kind == fir.rvalue_kind.rv_slice || r.kind == fir.rvalue_kind.rv_slice_ptr ||
        r.kind == fir.rvalue_kind.rv_aggregate) {
        s->stopped = true;
        return value{};
    }
    if (r.kind == fir.rvalue_kind.rv_call) { s->stopped = true; return value{}; }
    if (r.ops_len == 0) { s->stopped = true; return value{}; }
    fir.operand first = fir.rvalue_operand(f, r, 0);
    value a = operand_value(s, first, at, invalid);
    if (*invalid || s->stopped) { return value{}; }
    if (r.kind == fir.rvalue_kind.rv_use) {
        if (first.kind != fir.operand_kind.ok_const &&
            types.type_is_owning_aggregate(fir.place_type(f, first.place))) {
            s->stopped = true;
            return value{};
        }
        return a;
    }
    if (r.kind == fir.rvalue_kind.rv_cast) {
        // A cast can change the bytes that a later load observes. This core has no byte state.
        s->stopped = true;
        return value{};
    }
    if (r.kind == fir.rvalue_kind.rv_not) {
        if (a.kind == value_kind.constant && typed(a) &&
            a.constant_value.kind == consts.cval_kind.cv_bool) {
            return typed_constant(a.ty, consts.cv_from_bool(a.constant_value.mag == 0));
        }
        s->stopped = true;
        return value{};
    }
    if (r.ops_len != 2) { s->stopped = true; return value{}; }
    value b = operand_value(s, fir.rvalue_operand(f, r, 1), at, invalid);
    if (*invalid || s->stopped) { return value{}; }
    if (!implemented_binary(r.kind)) { s->stopped = true; return value{}; }
    if (relation_kind(r.kind)) { return compare(s, r.kind, a, b); }
    if (a.kind == value_kind.constant && b.kind == value_kind.constant) {
        types.node* ty = fir.operand_type(f, first);
        consts.cval mut out = consts.cv_none();
        if (typed(a) && typed(b) && same_prim(a.ty, ty) && same_prim(b.ty, ty) &&
            exact_binary(r.kind, ty, a.constant_value, b.constant_value, &out) &&
            typed_pair(ty, out)) {
            return typed_constant(ty, out);
        }
        s->stopped = true;
    }
    // An inexact integer result stays unknown. It can decide no branch or check: a comparison
    // with it stops the path, and it is never a Boolean.
    return value{};
}

fn clear_place(exact_state mut* s, fir.place p, diag.loc at) void {
    place_result got = resolve_place(s, p, at, false);
    if (!got.resolved || got.invalid) { s->stopped = true; return; }
    input_store(s, got.key);
    slot_at(s, got.key, got.ty)->contents = types.type_is_reference(got.ty) ?
        value{.kind = value_kind.null_value, .ty = got.ty} : value{};
}

fn below(storage_key parent, storage_key child) bool {
    if (parent.kind != child.kind || parent.root != child.root ||
        parent.depth >= child.depth) { return false; }
    u32 mut i = 0;
    while (i < parent.depth) {
        if (parent.path[i] != child.path[i]) { return false; }
        i += 1;
    }
    return true;
}

// Zeroes the aggregate at `key`: each slot below it gets its typed zero, and later slots below
// it take their typed zero from it.
fn zero_store(exact_state mut* s, storage_key key, types.node* ty) void {
    input_store(s, key);
    u64 mut i = 0;
    while (i < s->slots_len) {
        if (below(key, s->slots[i].key)) { s->slots[i].contents = typed_zero(s->slots[i].ty); }
        i += 1;
    }
    slot_at(s, key, ty)->contents = value{.kind = value_kind.zero_aggregate, .ty = ty};
}

// Copies each leaf of the aggregate at `from` to the same projection below `to`. A leaf is a
// field or element whose type is no aggregate. The copy reads each leaf of the source, so an
// unknown reference gets its identity before the copy, and it writes each leaf of the
// destination. Each leaf pays one X step. A leaf beyond the key depth stops the path. Each
// aggregate level records its store after its leaves, so the reads of the copy come first.
fn copy_leaves(exact_state mut* s, storage_key from, storage_key to, types.node* ty) bool {
    if (ty == null) { s->stopped = true; return false; }
    if (ty->kind == types.type_kind.k_struct) {
        u32 count = fir.struct_field_count(ty);
        u32 mut field = 0;
        while (field < count) {
            storage_key mut source = from;
            storage_key mut target = to;
            if (!append_part(&source, field) || !append_part(&target, field)) {
                s->stopped = true;
                return false;
            }
            if (!copy_leaves(s, source, target, fir.struct_field_type(ty, field))) {
                return false;
            }
            field += 1;
        }
        input_store(s, to);
        slot_at(s, to, ty)->contents = value{};
        return true;
    }
    if (ty->kind == types.type_kind.k_array) {
        if (ty->len > 2147483647) { s->stopped = true; return false; }
        u64 mut element = 0;
        while (element < ty->len) {
            u32 encoded = cast(element, u32) | 2147483648;
            storage_key mut source = from;
            storage_key mut target = to;
            if (!append_part(&source, encoded) || !append_part(&target, encoded)) {
                s->stopped = true;
                return false;
            }
            if (!copy_leaves(s, source, target, ty->elem)) { return false; }
            element += 1;
        }
        input_store(s, to);
        slot_at(s, to, ty)->contents = value{};
        return true;
    }
    if (!charge(s)) { return false; }
    value leaf = stored_value(s, from, ty);
    if (s->stopped) { return false; }
    slot_at(s, to, ty)->contents = leaf;
    return true;
}

// Executes a whole store of an aggregate. A zero constant zeroes the destination, and a copy
// writes each leaf of the destination from its source leaf. Any other aggregate rvalue, or the
// copy of an owning aggregate, stops the path. A whole store validates no loss.
fn store_aggregate(exact_state mut* s, fir.statement* stmt) void {
    fir.func* f = s->input->body;
    fir.rvalue r = stmt->value;
    if (r.kind != fir.rvalue_kind.rv_use || r.ops_len != 1) { s->stopped = true; return; }
    fir.operand from = fir.rvalue_operand(f, r, 0);
    if (from.kind == fir.operand_kind.ok_const) {
        value zero = constant_value(f, from.value);
        place_result target = resolve_place(s, stmt->place, stmt->loc, false);
        if (zero.kind != value_kind.zero_aggregate || !target.resolved || target.invalid) {
            s->stopped = true;
            return;
        }
        zero_store(s, target.key, target.ty);
        return;
    }
    if (types.type_is_owning_aggregate(fir.place_type(f, from.place))) {
        s->stopped = true;
        return;
    }
    place_result source = resolve_place(s, from.place, stmt->loc, false);
    place_result target = resolve_place(s, stmt->place, stmt->loc, false);
    if (!source.resolved || source.invalid || !target.resolved || target.invalid) {
        s->stopped = true;
        return;
    }
    copy_leaves(s, source.key, target.key, target.ty);
}

fn set_place(exact_state mut* s, fir.place p, diag.loc at, value v) bool {
    place_result got = resolve_place(s, p, at, false);
    if (!got.resolved || got.invalid) { return false; }
    input_store(s, got.key);
    slot_at(s, got.key, got.ty)->contents = v;
    return true;
}

fn owning(types.node* ty) bool {
    return types.type_is_reference(ty) ? ty->is_own : types.type_is_owning_aggregate(ty);
}

fn live_obligation(exact_state* s, value v) bool {
    if (v.kind != value_kind.allocation || cast(v.allocation_value, u64) >= s->allocations_len) {
        return false;
    }
    allocation a = s->allocations[cast(v.allocation_value, u64)];
    return a.live && a.obligation;
}

fn candidate_allocation(exact_state* s, u32 allocation_value) bool {
    ownership_api.entity_id relation = s->input->candidate->relation;
    if (relation.kind != ownership_api.entity_kind.allocation ||
        cast(allocation_value, u64) >= s->allocations_len) { return false; }
    u32 exact = s->allocations[cast(allocation_value, u64)].relation;
    return exact != NONE && relation.ordinal == exact;
}

fn candidate_key(exact_state* s, storage_key key) bool {
    if (key.kind != storage_kind.local || key.root >= fir.local_count(s->input->body) ||
        s->input->candidate->text.len == 0) { return false; }
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    fir.local* base = fir.local_at(s->input->body, key.root);
    strbuf.append(&text, fir.local_name(base));
    types.node* mut ty = base->ty;
    u32 mut i = 0;
    while (i < key.depth) {
        u32 part = key.path[i];
        if ((part & 2147483648) != 0) {
            if (ty == null || ty->kind != types.type_kind.k_array) { return false; }
            strbuf.push(&text, '[');
            strbuf.append_u64(&text, cast(part & 2147483647, u64));
            strbuf.push(&text, ']');
            ty = ty->elem;
        } else {
            string name = field_name(ty, part);
            if (name.len == 0) { return false; }
            strbuf.push(&text, '.');
            strbuf.append(&text, name);
            ty = fir.struct_field_type(ty, part);
        }
        i += 1;
    }
    return strbuf.view(&text) == s->input->candidate->text;
}

fn candidate_invalid_source(exact_state* s, storage_key key, u32 allocation_value) bool {
    if (s->input->candidate->text.len > 0 && key.kind == storage_kind.local) {
        return candidate_key(s, key);
    }
    if (allocation_value == NONE) {
        return s->input->candidate->relation.kind != ownership_api.entity_kind.allocation;
    }
    return candidate_allocation(s, allocation_value);
}

fn field_name(types.node* ty, u32 field) string {
    if (ty == null || ty->kind != types.type_kind.k_struct) { return ""; }
    ast.node* decl = fir.struct_decl(ty);
    u32 mut at = 0;
    u64 mut i = 0;
    while (i < ast.ast_len(decl)) {
        ast.node* member = ast.ast_child(decl, i);
        if (member->kind == ast.ast_kind.k_field_decl) {
            if (at == field) { return member->name; }
            at += 1;
        }
        i += 1;
    }
    return "";
}

// Whether `item` is the field that the candidate names below the released place.
fn candidate_field(exact_state* s, fir.place owner, slot item) bool {
    if (owner.base != fir.base_kind.bk_local || item.key.depth == 0 ||
        s->input->candidate->text.len == 0) { return false; }
    fir.func* f = s->input->body;
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    strbuf.append(&text, fir.local_name(fir.local_at(f, owner.local)));
    types.node* mut ty = fir.local_at(f, owner.local)->ty;
    bool mut indirect = false;
    u32 mut i = 0;
    while (i < owner.proj_len) {
        fir.projection part = fir.place_projection(f, owner, i);
        if (part.kind == fir.proj_kind.pj_deref) {
            if (!types.type_is_reference(ty)) { return false; }
            ty = ty->elem;
            indirect = true;
        } else if (part.kind == fir.proj_kind.pj_field) {
            string name = field_name(ty, part.field);
            if (name.len == 0) { return false; }
            strbuf.append(&text, indirect ? "->" : ".");
            strbuf.append(&text, name);
            ty = fir.struct_field_type(ty, part.field);
            indirect = false;
        } else {
            return false;
        }
        i += 1;
    }
    if (!types.type_is_reference(ty)) { return false; }
    ty = ty->elem;
    i = 0;
    while (i < item.key.depth) {
        u32 field = item.key.path[i];
        if ((field & 2147483648) != 0) { return false; }
        string name = field_name(ty, field);
        if (name.len == 0) { return false; }
        strbuf.append(&text, i == 0 ? "->" : ".");
        strbuf.append(&text, name);
        ty = fir.struct_field_type(ty, field);
        i += 1;
    }
    return strbuf.view(&text) == s->input->candidate->text;
}

fn candidate_slot(exact_state* s, slot item) bool {
    if (item.key.kind != storage_kind.local ||
        s->input->candidate->text.len == 0) { return false; }
    fir.func* f = s->input->body;
    if (item.key.root >= fir.local_count(f)) { return false; }
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    fir.local* base = fir.local_at(f, item.key.root);
    strbuf.append(&text, fir.local_name(base));
    types.node* mut ty = base->ty;
    u32 mut i = 0;
    while (i < item.key.depth) {
        u32 part = item.key.path[i];
        if ((part & 2147483648) != 0) {
            if (ty == null || ty->kind != types.type_kind.k_array) { return false; }
            strbuf.push(&text, '[');
            strbuf.append_u64(&text, cast(part & 2147483647, u64));
            strbuf.push(&text, ']');
            ty = ty->elem;
        } else {
            string name = field_name(ty, part);
            if (name.len == 0) { return false; }
            strbuf.push(&text, '.');
            strbuf.append(&text, name);
            ty = fir.struct_field_type(ty, part);
        }
        i += 1;
    }
    return strbuf.view(&text) == s->input->candidate->text;
}

// Whether releasing allocation `root` loses the live owned field that the candidate names.
fn child_lost(exact_state* s, u32 root, fir.place owner) bool {
    u64 mut i = 0;
    while (i < s->slots_len) {
        slot item = s->slots[i];
        if (item.key.kind == storage_kind.cell && item.key.root == root && owning(item.ty) &&
            live_obligation(s, item.contents) && candidate_field(s, owner, item)) { return true; }
        i += 1;
    }
    return false;
}

fn move_operands(exact_state mut* s, fir.rvalue r, diag.loc at) void {
    fir.func* f = s->input->body;
    u32 mut i = 0;
    while (i < r.ops_len) {
        fir.operand o = fir.rvalue_operand(f, r, i);
        if (o.kind == fir.operand_kind.ok_move) { clear_place(s, o.place, at); }
        i += 1;
    }
}

// Executes one statement. The result says whether the candidate operation holds an invalid fact.
fn statement(exact_state mut* s, fir.statement* stmt, bool candidate) bool {
    if (!charge(s)) { return false; }
    fir.func* f = s->input->body;
    u32 mut read = 0;
    fir.place mut used = fir.place{};
    while (fir.stmt_reads_place(f, stmt, read, &used)) {
        bool mut read_invalid = false;
        s->invalid_allocation = NONE;
        place_value(s, used, stmt->loc, &read_invalid);
        if (s->stopped || s->refused) { return false; }
        if (read_invalid) {
            // The first invalid read faults, so no later read of the statement runs.
            if (candidate && s->input->candidate->kind == ownership_api.event_kind.invalid_use) {
                return candidate_invalid_source(s, s->invalid_key, s->invalid_allocation);
            }
            s->stopped = true;
            return false;
        }
        read += 1;
    }
    if (stmt->kind == fir.stmt_kind.st_live) {
        // Lowering writes the initial value before `live`. The marker does not change it.
        if (cast(stmt->local, u64) < s->local_live.len) {
            s->local_live[cast(stmt->local, u64)] = true;
        }
        return false;
    }
    if (stmt->kind == fir.stmt_kind.st_dead) {
        bool mut lost = false;
        u64 mut i = 0;
        while (i < s->slots_len) {
            if (s->slots[i].key.kind == storage_kind.local &&
                s->slots[i].key.root == stmt->local && owning(s->slots[i].ty) &&
                live_obligation(s, s->slots[i].contents) &&
                candidate_slot(s, s->slots[i])) { lost = true; }
            i += 1;
        }
        if (candidate && s->input->candidate->kind == ownership_api.event_kind.lost_ownership) {
            return lost;
        }
        if (cast(stmt->local, u64) < s->local_live.len) {
            s->local_live[cast(stmt->local, u64)] = false;
        }
        return false;
    }
    if (stmt->kind == fir.stmt_kind.st_del) {
        bool mut bad = false;
        value held = place_value(s, stmt->place, stmt->loc, &bad);
        if (s->stopped) { return false; }
        bool mut lost = false;
        if (held.kind == value_kind.allocation &&
            cast(held.allocation_value, u64) < s->allocations_len) {
            // A release reads the owned fields of its storage and then ends that storage.
            storage_key released = storage_key{.kind = storage_kind.cell,
                .root = held.allocation_value};
            if (!input_read(s, released)) { return false; }
            allocation mut* a = &s->allocations[cast(held.allocation_value, u64)];
            if (!a->live) { bad = true; }
            lost = a->live && child_lost(s, held.allocation_value, stmt->place);
            a->live = false;
            a->obligation = false;
            input_store(s, released);
        }
        clear_place(s, stmt->place, stmt->loc);
        if (!candidate || s->stopped) { return false; }
        if (s->input->candidate->kind == ownership_api.event_kind.invalid_use) {
            return bad && candidate_invalid_source(s, s->invalid_key, s->invalid_allocation);
        }
        if (s->input->candidate->kind == ownership_api.event_kind.lost_ownership) { return lost; }
        return false;
    }
    if (stmt->kind != fir.stmt_kind.st_assign) { return false; }
    if (stmt->value.kind == fir.rvalue_kind.rv_call) {
        s->stopped = true;
        return false;
    }
    if (aggregate_type(fir.place_type(f, stmt->place))) {
        store_aggregate(s, stmt);
        return false;
    }
    bool mut value_invalid = false;
    value v = rvalue_value(s, stmt->value, stmt->loc, &value_invalid);
    if (value_invalid) {
        if (candidate && s->input->candidate->kind == ownership_api.event_kind.invalid_use) {
            return candidate_invalid_source(s, s->invalid_key, s->invalid_allocation);
        }
        s->stopped = true;
        return false;
    }
    if (s->stopped || s->refused) { return false; }
    // Only an owning destination can lose its old value, so only it reads that value.
    bool mut lost = false;
    if (owning(fir.place_type(f, stmt->place))) {
        bool mut old_invalid = false;
        value old = place_value(s, stmt->place, stmt->loc, &old_invalid);
        if (s->stopped) { return false; }
        lost = !old_invalid && live_obligation(s, old) &&
            !(v.kind == value_kind.allocation && v.allocation_value == old.allocation_value);
    }
    move_operands(s, stmt->value, stmt->loc);
    if (s->stopped || !set_place(s, stmt->place, stmt->loc, v)) {
        s->stopped = true;
        return false;
    }
    return candidate && s->input->candidate->kind == ownership_api.event_kind.lost_ownership &&
        lost;
}

// Whether the return loses the candidate allocation. The caller can reach each owner in `_0`
// and each owner in input storage, so they transfer at the return, each with its owned
// descendants. A stale model of input storage only adds owners that transfer, so this rule
// validates no loss from it.
fn return_loses(exact_state mut* s) bool {
    bool mut@ own returned = new(bool, s->allocations_len);
    defer del(returned);
    u64 mut slot_index = 0;
    while (slot_index < s->slots_len) {
        slot item = s->slots[slot_index];
        bool visible = (item.key.kind == storage_kind.local && item.key.root == 0) ||
            input_storage(s, item.key);
        if (visible && owning(item.ty) &&
            item.contents.kind == value_kind.allocation &&
            cast(item.contents.allocation_value, u64) < returned.len) {
            returned[cast(item.contents.allocation_value, u64)] = true;
        }
        slot_index += 1;
    }
    bool mut changed = true;
    while (changed) {
        changed = false;
        slot_index = 0;
        while (slot_index < s->slots_len) {
            slot item = s->slots[slot_index];
            if (item.key.kind == storage_kind.cell && cast(item.key.root, u64) < returned.len &&
                returned[cast(item.key.root, u64)] && owning(item.ty) &&
                item.contents.kind == value_kind.allocation &&
                cast(item.contents.allocation_value, u64) < returned.len &&
                !returned[cast(item.contents.allocation_value, u64)]) {
                returned[cast(item.contents.allocation_value, u64)] = true;
                changed = true;
            }
            slot_index += 1;
        }
    }
    u64 mut i = 0;
    while (i < s->allocations_len) {
        if (s->allocations[i].live && s->allocations[i].obligation &&
            !returned[i] && candidate_allocation(s, cast(i, u32))) { return true; }
        i += 1;
    }
    return false;
}

// Whether a read of `term` is invalid. The first invalid read faults, so no later read runs. For
// the candidate, that first invalid read must also name the candidate's invalid source.
fn term_reads(exact_state mut* s, fir.terminator* term, bool candidate) bool {
    fir.func* f = s->input->body;
    u32 mut i = 0;
    fir.place mut p = fir.place{};
    while (fir.term_reads_place(f, term, i, &p)) {
        bool mut one = false;
        s->invalid_allocation = NONE;
        place_value(s, p, term->loc, &one);
        if (s->stopped || s->refused) { return false; }
        if (one) {
            return !candidate ||
                candidate_invalid_source(s, s->invalid_key, s->invalid_allocation);
        }
        i += 1;
    }
    return false;
}

fn excluded(exact_state* s, u32 param, consts.cval choice) bool {
    u64 mut i = 0;
    while (i < s->exclusions_len) {
        if (s->exclusions[i].param == param &&
            consts.cv_eq(s->exclusions[i].value, choice)) { return true; }
        i += 1;
    }
    return false;
}

fn pick_choice(exact_state mut* s, u32 param, consts.cval choice) bool {
    if (cast(param, u64) >= s->choices.len) { return false; }
    if (excluded(s, param, choice)) { return false; }
    if (s->chosen[cast(param, u64)]) {
        return consts.cv_eq(s->choices[cast(param, u64)], choice);
    }
    s->chosen[cast(param, u64)] = true;
    s->choices[cast(param, u64)] = choice;
    return true;
}

fn exclude_choice(exact_state mut* s, u32 param, consts.cval choice) bool {
    if (cast(param, u64) >= s->choices.len) { return false; }
    if (s->chosen[cast(param, u64)] &&
        consts.cv_eq(s->choices[cast(param, u64)], choice)) { return false; }
    if (excluded(s, param, choice)) { return true; }
    grow_exclusions(s);
    s->exclusions[s->exclusions_len] = exclusion{param, choice};
    s->exclusions_len += 1;
    return true;
}

fn exclusions_cover(exact_state* s, u32 param) bool {
    if (s->input == null || s->input->body == null ||
        param >= fir.local_count(s->input->body)) { return false; }
    types.node* ty = fir.local_at(s->input->body, param)->ty;
    u64 mut domain = 0;
    if (ty->kind == types.type_kind.k_prim && ty->prim == prim.prim_kind.prim_bool) {
        domain = 2;
    } else if (ty->kind == types.type_kind.k_prim && prim.prim_is_integer(ty->prim)) {
        u64 width = cast(prim.prim_size(ty->prim), u64) * prim.PRIM_BITS_PER_BYTE;
        if (width >= 64) { return false; }
        domain = cast(1, u64) << width;
    } else {
        return false;
    }
    u64 mut count = 0;
    u64 mut i = 0;
    while (i < s->exclusions_len) {
        if (s->exclusions[i].param == param) { count += 1; }
        i += 1;
    }
    return count == domain;
}

fn pick_entry(exact_state mut* s, value v, bool wanted) bool {
    if (v.kind != value_kind.entry_value && v.kind != value_kind.relation) { return false; }
    u32 param = v.param;
    consts.cval mut choice = consts.cv_from_bool(wanted);
    if (v.kind == value_kind.relation) {
        if (v.constant_value.kind == consts.cval_kind.cv_bool) {
            bool same = v.relation_value == consts.cv_rel.cv_rel_eq;
            choice = wanted == same ? v.constant_value :
                consts.cv_from_bool(v.constant_value.mag == 0);
        } else {
            return false;
        }
    }
    return pick_choice(s, param, choice);
}

fn condition_value(exact_state mut* s, fir.operand input, diag.loc at) value {
    bool mut invalid = false;
    value out = operand_value(s, input, at, &invalid);
    if (invalid) { s->stopped = true; }
    return out;
}

fn check_passes(exact_state mut* s, fir.terminator* term) bool {
    value cond = condition_value(s, term->cond, term->loc);
    if (s->stopped) { return false; }
    bool success = term->check == fir.check_kind.chk_user;
    if (cond.kind == value_kind.constant) {
        if (!typed(cond) || cond.constant_value.kind != consts.cval_kind.cv_bool) { return false; }
        return (cond.constant_value.mag == 1) == success;
    }
    bool permitted = term->check != fir.check_kind.chk_overflow &&
        term->check != fir.check_kind.chk_div_overflow &&
        term->check != fir.check_kind.chk_shift && term->check != fir.check_kind.chk_overwrite;
    if (!permitted) { return false; }
    bool input = cond.kind == value_kind.entry_value || cond.kind == value_kind.relation;
    // Only an input or unknown storage contents stay undecided. Any other value is no Boolean.
    if (!input && cond.kind != value_kind.unknown) { return false; }
    if (input && !pick_entry(s, cond, success)) { return false; }
    return add_condition(s, condition{.kind = condition_kind.check_passes,
        .subject = check_name(term->check), .place = source(s, term->loc),
        .required = "here to pass", .outcome = "if it fails, the program stops", .input = input});
}

fn choose(exact_state mut* s, fir.terminator* term, u32 mut* out) bool {
    fir.func* f = s->input->body;
    value cond = condition_value(s, term->cond, term->loc);
    if (s->stopped) { return false; }
    if (cond.kind == value_kind.constant) {
        if (!typed(cond)) { return false; }
        u32 mut i = 0;
        while (i < term->arms_len) {
            fir.arm edge = fir.term_arm(f, term, i);
            // A label of another constant kind could never match, so the core cannot decide.
            if (edge.value.kind != cond.constant_value.kind) { return false; }
            if (consts.cv_eq(cond.constant_value, edge.value)) {
                *out = edge.target;
                return true;
            }
            i += 1;
        }
        *out = term->otherwise;
        return true;
    }
    bool mut found = false;
    u32 mut best = 0;
    u32 mut selected = 0;
    u32 mut i = 0;
    while (i <= term->arms_len) {
        bool other = i == term->arms_len;
        u32 target = other ? term->otherwise : fir.term_arm(f, term, i).target;
        bool nearer = !found || s->distance[cast(target, u64)] <
            s->distance[cast(best, u64)];
        bool tied = found && s->distance[cast(target, u64)] ==
            s->distance[cast(best, u64)] && target < best;
        if (fir_flow.bits_get(&s->toward, target) && (nearer || tied)) {
            found = true;
            best = target;
            selected = i;
        }
        i += 1;
    }
    if (!found) { return false; }
    bool other = selected == term->arms_len;
    branch_selection mut selection = branch_selection.none;
    consts.cval mut selected_value = consts.cv_none();
    types.node* mut selected_type = null;
    if (cond.kind == value_kind.entry_value) {
        selected_type = fir.local_at(f, cond.param)->ty;
        if (other) {
            i = 0;
            while (i < term->arms_len) {
                if (!exclude_choice(s, cond.param, fir.term_arm(f, term, i).value)) {
                    return false;
                }
                i += 1;
            }
            if (exclusions_cover(s, cond.param)) { return false; }
            if (selected_type->kind == types.type_kind.k_prim &&
                selected_type->prim == prim.prim_kind.prim_bool) {
                bool mut has_true = false;
                i = 0;
                while (i < term->arms_len) {
                    if (fir.term_arm(f, term, i).value.mag != 0) { has_true = true; }
                    i += 1;
                }
                selection = has_true ? branch_selection.boolean_false :
                    branch_selection.boolean_true;
            } else {
                selection = branch_selection.switch_otherwise;
            }
        } else if (!pick_choice(s, cond.param, fir.term_arm(f, term, selected).value)) {
            return false;
        } else {
            selected_value = fir.term_arm(f, term, selected).value;
            if (selected_type->kind == types.type_kind.k_prim &&
                selected_type->prim == prim.prim_kind.prim_bool) {
                selection = selected_value.mag == 0 ? branch_selection.boolean_false :
                    branch_selection.boolean_true;
            } else {
                selection = branch_selection.switch_case;
            }
        }
    } else if (cond.kind == value_kind.relation) {
        bool mut wanted = false;
        if (other) {
            bool mut has_false = false;
            bool mut has_true = false;
            i = 0;
            while (i < term->arms_len) {
                consts.cval label = fir.term_arm(f, term, i).value;
                if (label.kind != consts.cval_kind.cv_bool) { return false; }
                if (label.mag == 0) { has_false = true; } else { has_true = true; }
                i += 1;
            }
            if (has_false && has_true) { return false; }
            wanted = has_false;
        } else {
            consts.cval label = fir.term_arm(f, term, selected).value;
            if (label.kind != consts.cval_kind.cv_bool) { return false; }
            wanted = label.mag != 0;
        }
        if (!pick_entry(s, cond, wanted)) { return false; }
        selection = wanted ? branch_selection.boolean_true : branch_selection.boolean_false;
    } else {
        return false;
    }
    if (!add_condition(s, condition{.kind = condition_kind.input_branch,
        .subject = "the condition", .place = source(s, term->loc), .required = "here to hold",
        .outcome = "", .input = true, .selected = selection, .selected_value = selected_value,
        .selected_type = selected_type, .excludes = excludes(s, term, selected),
        .reached = event_noun(s->input->candidate->kind)})) {
        return false;
    }
    *out = best;
    return true;
}

// Whether an arm of `term` but arm `selected` (`arms_len` names `otherwise`) starts in a block
// of `toward`. Two arms with one target both do or both do not.
fn arm_reaches(exact_state* s, fir.terminator* term, u32 selected, fir_flow.bits* toward) bool {
    fir.func* f = s->input->body;
    u32 mut i = 0;
    while (i <= term->arms_len) {
        u32 target = i == term->arms_len ? term->otherwise : fir.term_arm(f, term, i).target;
        if (i != selected && fir_flow.bits_get(toward, target)) { return true; }
        i += 1;
    }
    return false;
}

// The blocks from which a path reaches block `target`, by the predecessor edges of `f`.
fn reaching(fir.func* f, u32 target) fir_flow.bits {
    u32 count = fir.block_count(f);
    fir_flow.bits mut out = fir_flow.bits_new(count);
    fir.pred_table mut preds = fir.func_predecessors(f);
    defer fir.pred_table_free(&preds);
    u32 mut@ own queue = new(u32, cast(count, u64));
    defer del(queue);
    u64 mut head = 0;
    u64 mut tail = 0;
    queue[tail] = target;
    tail += 1;
    fir_flow.bits_set(&out, target);
    while (head < tail) {
        u32 block = queue[head];
        head += 1;
        u32 mut i = 0;
        while (i < fir.pred_count(&preds, block)) {
            u32 from = fir.pred_at(&preds, block, i);
            if (!fir_flow.bits_get(&out, from)) {
                fir_flow.bits_set(&out, from);
                queue[tail] = from;
                tail += 1;
            }
            i += 1;
        }
    }
    return out;
}

fn same_loc(diag.loc a, diag.loc b) bool {
    return a.file == b.file && a.line == b.line && a.col == b.col && a.end_line == b.end_line &&
        a.end_col == b.end_col;
}

// Whether block `block` holds an operation at source range `at`: a statement or its terminator.
fn holds_loc(fir.func* f, u32 block, diag.loc at) bool {
    u32 count = fir.block_statement_count(f, block);
    u32 mut i = 0;
    while (i < count) {
        if (same_loc(fir.block_statement(f, block, i)->loc, at)) { return true; }
        i += 1;
    }
    return same_loc(fir.block_at(f, block)->term.loc, at);
}

// Whether a branch note can claim that no arm of `term` but arm `selected` reaches the event.
// Three tests must hold. (a) No such arm reaches the block of the operation. (b) No such arm
// reaches another block with an operation at the same source range: lowering copies a `defer`
// body to each scope exit, so one source statement can have more than one operation. (c) The
// producer has no other candidate of the same allocation in the body (`request.sole`), since
// another arm can lose that allocation at another operation. Else the note states its first
// clause only.
fn excludes(exact_state* s, fir.terminator* term, u32 selected) bool {
    if (!s->input->sole) { return false; }
    if (arm_reaches(s, term, selected, &s->toward)) { return false; }
    fir.func* f = s->input->body;
    ownership_api.operation_position op = s->input->candidate->operation;
    if (op.block >= fir.block_count(f) ||
        (!op.terminator && op.operation >= fir.block_statement_count(f, op.block))) {
        return false;
    }
    diag.loc at = op.terminator ? fir.block_at(f, op.block)->term.loc :
        fir.block_statement(f, op.block, op.operation)->loc;
    u32 mut block = 0;
    while (block < fir.block_count(f)) {
        if (block != op.block && holds_loc(f, block, at)) {
            fir_flow.bits mut other = reaching(f, block);
            bool hit = arm_reaches(s, term, selected, &other);
            fir_flow.bits_free(&other);
            if (hit) { return false; }
        }
        block += 1;
    }
    return true;
}

fn start(exact_state mut* s, u32 target) bool {
    fir.func* f = s->input->body;
    u32 count = fir.block_count(f);
    if (target >= count || count == 0) { return false; }
    s->passed = fir_flow.bits_new(count);
    s->toward = fir_flow.bits_new(count);
    s->distance = new(u32, cast(count, u64));
    fir.pred_table mut preds = fir.func_predecessors(f);
    defer fir.pred_table_free(&preds);
    u32 mut@ own queue = new(u32, cast(count, u64));
    defer del(queue);
    u64 mut head = 0;
    u64 mut tail = 0;
    queue[tail] = target;
    tail += 1;
    fir_flow.bits_set(&s->toward, target);
    while (head < tail) {
        u32 block = queue[head];
        head += 1;
        u32 mut i = 0;
        while (i < fir.pred_count(&preds, block)) {
            u32 from = fir.pred_at(&preds, block, i);
            if (!fir_flow.bits_get(&s->toward, from)) {
                fir_flow.bits_set(&s->toward, from);
                s->distance[cast(from, u64)] = s->distance[cast(block, u64)] + 1;
                queue[tail] = from;
                tail += 1;
            }
            i += 1;
        }
    }
    if (!fir_flow.bits_get(&s->toward, 0)) { return false; }
    u64 locals = cast(fir.local_count(f), u64);
    s->chosen = new(bool, locals);
    s->choices = new(consts.cval, locals);
    s->entry_bound = new(bool, locals);
    s->entry_allocations = new(u32, locals);
    s->local_live = new(bool, locals);
    s->next_relation = s->input->summary == null ? 1 :
        cast(s->input->summary->interface.len + 1, u32);
    u32 mut local = 0;
    while (local < fir.local_count(f)) {
        fir.local* l = fir.local_at(f, local);
        storage_key key = storage_key{.kind = storage_kind.local, .root = local};
        value mut v = value{};
        if (l->kind == fir.local_kind.lk_param) {
            s->local_live[cast(local, u64)] = true;
            if (types.type_is_reference(l->ty)) {
                v = value{.kind = value_kind.entry_value, .param = local, .ty = l->ty,
                    .entry_reference = true, .entry_root = ownership_facts.nullness{
                        ownership_facts.root_kind.free, ownership_facts.provenance.assumed}};
            } else if (l->ty->kind == types.type_kind.k_prim &&
                (prim.prim_is_integer(l->ty->prim) || l->ty->prim == prim.prim_kind.prim_bool)) {
                v = value{.kind = value_kind.entry_value, .param = local, .ty = l->ty};
            }
        }
        slot_at(s, key, l->ty)->contents = v;
        local += 1;
    }
    return true;
}

fn operation_matches(ownership_api.operation_position op, u32 block, u32 operation,
    bool terminator) bool {
    return op.block == block && op.operation == operation && op.terminator == terminator;
}

// A path enters one FIR block once. A second entry needs loop reasoning from a later checker.
fn enter_block(exact_state mut* s, u32 block) bool {
    if (fir_flow.bits_get(&s->passed, block)) { return false; }
    fir_flow.bits_set(&s->passed, block);
    return true;
}

fn check_path(exact_state mut* s) bool {
    ownership_api.operation_position target = s->input->candidate->operation;
    if (!start(s, target.block)) { return false; }
    fir.func* f = s->input->body;
    u32 mut block = 0;
    while (!s->stopped && !s->refused) {
        if (!enter_block(s, block)) { return false; }
        u32 count = fir.block_statement_count(f, block);
        u32 mut i = 0;
        while (i < count) {
            bool target_here = operation_matches(target, block, i, false);
            bool invalid = statement(s, fir.block_statement(f, block, i), target_here);
            if (target_here) { return invalid; }
            if (s->stopped || s->refused) { return false; }
            i += 1;
        }
        fir.terminator* term = &fir.block_at(f, block)->term;
        bool target_here = operation_matches(target, block, count, true);
        if (!charge(s)) { return false; }
        bool candidate_read = target_here &&
            s->input->candidate->kind == ownership_api.event_kind.invalid_use;
        bool invalid_read = term_reads(s, term, candidate_read);
        if (s->stopped || s->refused) { return false; }
        if (target_here) {
            if (s->input->candidate->kind == ownership_api.event_kind.invalid_use) {
                return invalid_read;
            }
            if (s->input->candidate->kind == ownership_api.event_kind.lost_ownership &&
                term->kind == fir.term_kind.tk_return) {
                return !invalid_read && return_loses(s);
            }
            return false;
        }
        if (invalid_read) { return false; }
        u32 mut next = 0;
        if (term->kind == fir.term_kind.tk_goto) {
            next = term->target;
        } else if (term->kind == fir.term_kind.tk_switch) {
            if (!choose(s, term, &next)) { return false; }
        } else if (term->kind == fir.term_kind.tk_check) {
            if (!check_passes(s, term)) { return false; }
            next = term->target;
        } else if (term->kind == fir.term_kind.tk_check_overwrite) {
            bool mut bad = false;
            value owner = place_value(s, term->place, term->loc, &bad);
            if (bad || owner.kind != value_kind.null_value) { return false; }
            next = term->target;
        } else {
            return false;
        }
        if (!fir_flow.bits_get(&s->toward, next)) { return false; }
        block = next;
    }
    return false;
}

/// Validates `candidate` on one exact path. The core rejects caller requirements and paths that
/// cross calls. It reads no heap-summary field outside `returns`, `interface`, `required_some`
/// and `post`.
fn check(request* input) result {
    result mut out = result{};
    if (input == null || input->body == null || input->summary == null ||
        input->candidate == null) { return out; }
    if (input->candidate->kind == ownership_api.event_kind.caller_requirement) { return out; }
    if (input->candidate->operation.terminator &&
        input->candidate->operation.block < fir.block_count(input->body)) {
        fir.terminator* term = &fir.block_at(input->body,
            input->candidate->operation.block)->term;
        if (term->kind == fir.term_kind.tk_return && !input->summary->returns) { return out; }
    }
    exact_state mut state = exact_state{.input = input, .invalid_allocation = NONE};
    defer state_free(&state);
    bool valid = check_path(&state);
    out.used = state.used;
    if (state.refused) {
        out.verdict = status.refused;
        return out;
    }
    if (!valid) { return out; }
    out.verdict = status.validated;
    out.conditions = new(condition, state.conditions_len);
    out.conditions_len = state.conditions_len;
    u64 mut i = 0;
    while (i < state.conditions_len) { out.conditions[i] = state.conditions[i]; i += 1; }
    return out;
}
