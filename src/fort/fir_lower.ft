/// Lowers the checked tree of one function to FIR (spec/fir.md 9). It numbers the named locals in
/// a prescan, zeroes each `own` reference local in the entry block, and lowers every statement:
/// blocks, `$if`, declarations, assignments with the overwrite check of an `own` reference, call
/// statements, `if`, the loops, `switch`, `defer`, `break`, `continue` and `return`. It lowers the
/// scalar expressions and the runtime checks of their operators, the places, the aggregate
/// values, the calls, `new`, `del` and `move`. A construct that it does not lower stops the
/// lowering of its function with a report (spec/fir.md 9.8).
//
// The module uses switches and no function-pointer dispatch table. It holds no module-level
// mutable state: a lowerer lives for the lowering of one function. It reads the tree and the
// annotations of the checker, and it writes neither. A scalar expression gives an operand, and an
// operation stands in a temporary. An aggregate expression writes into the place that waits for
// it, and an expression that designates storage gives a place. A stack of the open scopes gives
// each `break` and `continue` its target, and each exit and each fall-off the deferred statements
// and the named locals that it ends.
import ast;
import check;
import consts;
import diag;
import fir;
import gen;
import lexer;
import modules;
import prim;
import session;
import std.strbuf;
import types;

// The module of the runtime, and its function that compares two strings.
string RUNTIME_MODULE = "std.rt";
string STR_EQ = "str_eq";

// The fields of a span or a `string` header (spec/fir.md 5.5).
u32 PTR_FIELD = 0;
u32 LEN_FIELD = 1;

// The descriptors of the print family without `f`, and the byte that `println` ends with.
u64 FD_STDOUT = 1;
u64 FD_STDERR = 2;
u64 NEWLINE = 10;

/// Why the lowering of a function stopped: the kind of the tree node that it does not lower, and
/// the location of that node. `entry` is the name of the `std.rt` function that the node needs
/// and the closure lacks, or empty when the lowering does not lower the node at all.
struct report {
    ast.ast_kind kind;
    diag.loc at;
    string entry;
}

// The runtime functions of the print family, one for each form of argument (spec/toolchain.md 6
// item 19).
enum print_kind {
    pk_i64,
    pk_u64,
    pk_bool,
    pk_char,
    pk_ptr,
    pk_str,
    pk_enum,
    pk_f32,
    pk_f64,
}

u64 PRINT_KINDS = 9;

// The kinds of exit, which stop at different scopes (spec/fir.md 9.5).
enum exit_kind {
    x_break,
    x_continue,
    x_return,
}

// The kind of an open scope, which says the exits that stop at it (spec/fir.md 9.5): `break` at
// the innermost `loop` or `case` scope, and `continue` at the innermost `loop` scope.
enum scope_kind {
    sc_fn,    // the body of the function
    sc_loop,  // the body of a loop
    sc_case,  // the body of a clause of a `switch`
    sc_block, // any other block, and the selected branch of a statement `$if`
}

// One open scope: its kind, the blocks that its exits go to, and where its deferred statements and
// its named locals begin in the vectors of the lowerer. A `loop` scope has both targets, a `case`
// scope `break_target` alone, and the other kinds neither.
struct scope {
    scope_kind kind;
    u32 break_target;
    u32 continue_target;
    u64 defers_first;
    u64 locals_first;
    u32 range_loan;
}

// `items[..len]` holds the open scopes, the innermost last.
struct scope_vec {
    scope mut@ own items;
    u64 len;
}

// `items[..len]` holds the numbers of the named locals of the open scopes, in the order of their
// `live` markers.
struct local_list {
    u32 mut@ own items;
    u64 len;
}

/// One inactive range binding. The IDs name a selected range node and this lowering occurrence.
/// The binding uses the FIR carrier layout. No candidate asserts complete body coverage.
struct range_capture_candidate {
    u32 declaration;
    u32 expansion;
    fir.range_expansion occurrence;
    fir.range_loan loan;
    fir.range_capture binding;
}

struct range_capture_candidate_vec {
    range_capture_candidate mut@ own items;
    u64 len;
}

struct range_boundary_candidate {
    u32 declaration;
    u32 expansion;
    fir.range_boundary boundary;
}

struct range_boundary_candidate_vec {
    range_boundary_candidate mut@ own items;
    u64 len;
}

struct range_suppression_candidate {
    u32 declaration;
    u32 context;
    u32 exit_occurrence;
    diag.loc source;
    diag.loc exit_source;
}

struct range_suppression_candidate_vec {
    range_suppression_candidate mut@ own items;
    u64 len;
}

// A deferred lowering occurrence identifies its source node and enclosing occurrence.
struct range_defer_context_candidate {
    u32 id;
    u32 parent;
    u32 exit_occurrence;
    ast.node* source_node;
    diag.loc exit_source;
}

struct range_defer_context_candidate_vec {
    range_defer_context_candidate mut@ own items;
    u64 len;
}

/// Inactive source proposals. Only independent source correspondence can publish FIR carriers.
/// A deferred source node borrows the checked tree. Free the set before that tree.
struct range_candidate_set {
    fir.range_declaration_vec declarations;
    range_capture_candidate_vec captures;
    range_boundary_candidate_vec boundaries;
    range_suppression_candidate_vec suppressions;
    range_defer_context_candidate_vec deferred;
}

enum range_audit_fault {
    none,
    declaration,
    operation,
    expansion_key,
    context,
    exit_source,
    capture,
    protected_path,
    boundary,
}

// A key stays in the report after the caller releases candidate storage.
struct range_audit_key {
    ast.sym* function;
    u32 declaration;
    u32 expansion;
    u32 context;
    u32 exit_occurrence;
    diag.loc source;
    diag.loc context_source;
    diag.loc exit_source;
}

struct range_audit_row {
    range_audit_key key;
    fir.range_capture binding;
    u32 boundaries_first;
    u32 boundaries_len;
}

struct range_audit_row_vec {
    range_audit_row mut@ own items;
    u64 len;
}

struct range_audit_boundary_vec {
    fir.range_boundary mut@ own items;
    u64 len;
}

struct range_audit_operation {
    u32 block;
    u32 position;
    u32 statement_index;
    u32 declaration;
    diag.loc exit_source;
}

struct range_audit_operation_vec {
    range_audit_operation mut@ own items;
    u64 len;
}

struct range_audit_failure {
    range_audit_key key;
    range_audit_fault reason;
}

/// An inactive report borrows the checked tree through its keys and locations.
/// Release it before the checked tree. No field grants source or ownership proof.
struct range_source_audit {
    range_audit_row_vec rows;
    range_audit_boundary_vec boundaries;
    u32 selected_declarations;
    u32 produced_expansions;
    u32 matched_captures;
    u32 protected_paths;
    u32 matched_boundaries;
    bool structural_valid;
    bool source_complete;
    bool ownership_proved;
    range_audit_failure failure;
}

fn range_source_audit_free(range_source_audit mut* audit) void {
    del(audit->rows.items);
    del(audit->boundaries.items);
    *audit = range_source_audit{};
}

fn range_audit_row_add(range_audit_row_vec mut* v, range_audit_row row) void {
    if (v->len >= fir.U32_LIMIT) { panic("fir_lower.range_audit_row_add: too many rows"); }
    if (v->len == v->items.len) {
        u64 cap = fir.grown_capacity(v->items.len, "fir_lower.range_audit_row_add: overflow");
        range_audit_row mut@ own bigger = new(range_audit_row, cap);
        u64 mut i = 0;
        while (i < v->len) { bigger[i] = v->items[i]; i += 1; }
        del(v->items);
        v->items = move(bigger);
    }
    v->items[v->len] = row;
    v->len += 1;
}

fn range_audit_boundary_add(range_audit_boundary_vec mut* v, fir.range_boundary value) void {
    if (v->len >= fir.U32_LIMIT) {
        panic("fir_lower.range_audit_boundary_add: too many boundaries");
    }
    if (v->len == v->items.len) {
        u64 cap = fir.grown_capacity(v->items.len,
                                      "fir_lower.range_audit_boundary_add: overflow");
        fir.range_boundary mut@ own bigger = new(fir.range_boundary, cap);
        u64 mut i = 0;
        while (i < v->len) { bigger[i] = v->items[i]; i += 1; }
        del(v->items);
        v->items = move(bigger);
    }
    v->items[v->len] = value;
    v->len += 1;
}

fn range_audit_operation_add(range_audit_operation_vec mut* v,
                             range_audit_operation value) void {
    if (v->len >= fir.U32_LIMIT) {
        panic("fir_lower.range_audit_operation_add: too many operations");
    }
    if (v->len == v->items.len) {
        u64 cap = fir.grown_capacity(v->items.len,
                                      "fir_lower.range_audit_operation_add: overflow");
        range_audit_operation mut@ own bigger = new(range_audit_operation, cap);
        u64 mut i = 0;
        while (i < v->len) { bigger[i] = v->items[i]; i += 1; }
        del(v->items);
        v->items = move(bigger);
    }
    v->items[v->len] = value;
    v->len += 1;
}

fn range_candidate_set_free(range_candidate_set mut* set) void {
    del(set->declarations.items);
    range_capture_candidates_free(&set->captures);
    del(set->boundaries.items);
    del(set->suppressions.items);
    del(set->deferred.items);
    *set = range_candidate_set{};
}

/// Releases the inactive range bindings that the test route receives.
fn range_capture_candidates_free(range_capture_candidate_vec mut* v) void {
    del(v->items);
    v->len = 0;
}

fn range_capture_candidate_add(range_capture_candidate_vec mut* v, range_capture_candidate c)
    void {
    if (v->len >= fir.U32_LIMIT) {
        panic("fir_lower.range_capture_candidate_add: too many records");
    }
    if (v->len == v->items.len) {
        u64 cap = fir.grown_capacity(v->items.len,
                                      "fir_lower.range_capture_candidate_add: capacity overflow");
        range_capture_candidate mut@ own bigger = new(range_capture_candidate, cap);
        u64 mut i = 0;
        while (i < v->len) {
            bigger[i] = v->items[i];
            i += 1;
        }
        del(v->items);
        v->items = move(bigger);
    }
    v->items[v->len] = c;
    v->len += 1;
}

fn range_boundary_candidate_add(range_boundary_candidate_vec mut* v,
                                range_boundary_candidate c) void {
    if (v->len >= fir.U32_LIMIT) {
        panic("fir_lower.range_boundary_candidate_add: too many records");
    }
    if (v->len == v->items.len) {
        u64 cap = fir.grown_capacity(v->items.len,
                                      "fir_lower.range_boundary_candidate_add: capacity overflow");
        range_boundary_candidate mut@ own bigger = new(range_boundary_candidate, cap);
        u64 mut i = 0;
        while (i < v->len) {
            bigger[i] = v->items[i];
            i += 1;
        }
        del(v->items);
        v->items = move(bigger);
    }
    v->items[v->len] = c;
    v->len += 1;
}

fn range_suppression_candidate_add(range_suppression_candidate_vec mut* v,
                                   range_suppression_candidate c) void {
    if (v->len >= fir.U32_LIMIT) {
        panic("fir_lower.range_suppression_candidate_add: too many records");
    }
    if (v->len == v->items.len) {
        u64 cap = fir.grown_capacity(
            v->items.len, "fir_lower.range_suppression_candidate_add: capacity overflow");
        range_suppression_candidate mut@ own bigger = new(range_suppression_candidate, cap);
        u64 mut i = 0;
        while (i < v->len) {
            bigger[i] = v->items[i];
            i += 1;
        }
        del(v->items);
        v->items = move(bigger);
    }
    v->items[v->len] = c;
    v->len += 1;
}

fn range_defer_context_candidate_add(range_defer_context_candidate_vec mut* v,
                                     range_defer_context_candidate c) void {
    if (v->len >= fir.U32_LIMIT) {
        panic("fir_lower.range_defer_context_candidate_add: too many records");
    }
    if (v->len == v->items.len) {
        u64 cap = fir.grown_capacity(v->items.len,
                                      "fir_lower.range_defer_context_candidate_add: overflow");
        range_defer_context_candidate mut@ own bigger = new(range_defer_context_candidate, cap);
        u64 mut i = 0;
        while (i < v->len) {
            bigger[i] = v->items[i];
            i += 1;
        }
        del(v->items);
        v->items = move(bigger);
    }
    v->items[v->len] = c;
    v->len += 1;
}

// The state of the lowering of one function. `block` receives the next statement. `counter` is
// the last statement index that the walk gave, and `stmt` is the index of the statement that the
// walk lowers now: 0 outside every statement (spec/fir.md 9.7). `scopes` is the stack of the open
// scopes, `defers` holds the `defer` nodes of the open scopes in text order, and `named` their
// named locals. `floor` is the depth below which no exit walks while a deferred statement lowers,
// and `exit_at` is the location of the exit that expands it, the empty range outside every
// expansion. `str_eq` is the runtime function that a string equality calls, and `prints` holds
// the print functions of the runtime in the order of print_kind; each is looked up at its first
// use.
struct lowerer {
    check.checker mut* ck;
    fir.func mut* f;
    u32 block;
    u32 counter;
    u32 stmt;
    scope_vec scopes;
    gen.node_ref_vec defers;
    local_list named;
    gen.node_ref_vec range_declarations;
    range_candidate_set range_candidates;
    u32 next_range_expansion;
    u32 next_defer_context;
    u32 defer_context;
    u32 next_exit_occurrence;
    u32 exit_occurrence;
    u64 floor;
    diag.loc exit_at;
    ast.sym* str_eq;
    bool str_eq_known;
    ast.sym*[PRINT_KINDS] prints;
    bool prints_known;
    report why;
}

// ---- the program ------------------------------------------------------------------------------

/// Appends to `out` the declaration of each function of a checked closure that has a body: the
/// modules in dependency order, and the declarations of each module in source order, with the
/// selected branch of each `$if`. That is the order of the functions of a FIR module (spec/fir.md
/// 5.1). The closure must have checked with no error.
fn program_functions(modules.module_set* set, gen.node_ref_vec mut* out) void {
    u64 mut i = 0;
    while (i < modules.count(set)) {
        collect_functions(modules.at(set, i)->ast, out);
        i += 1;
    }
}

// Appends the functions with a body among the declarations of `list`, and among the declarations
// of the selected branch of each `$if` of `list`. An `extern fn` has no body.
fn collect_functions(ast.node* list, gen.node_ref_vec mut* out) void {
    u64 mut i = 0;
    while (list != null && i < ast.ast_len(list)) {
        ast.node* d = ast.ast_child(list, i);
        if (d->kind == ast.ast_kind.k_compile_if) {
            collect_functions(selected_branch(d), out);
        } else if (d->kind == ast.ast_kind.k_fn_decl && d->b != null) {
            gen.refs_push(out, d);
        }
        i += 1;
    }
}

// The branch of the `$if` chain `n` that the checker selected, or null when it selected none.
fn selected_branch(ast.node* n) ast.node* {
    ast.node* mut current = n;
    while (current != null && current->kind == ast.ast_kind.k_compile_if) {
        if ((current->flags & ast.FLAG_SELECT_THEN) != 0) {
            return current->b;
        }
        current = current->c;
    }
    return current;
}

/// Writes the line that `--fir` prints in place of a function that the lowering does not lower:
/// `// not supported: <kind> at <line>:<col>`, where `<kind>` is ast.ast_kind_name.
fn write_report(report* r, strbuf.str_buf mut* out) void {
    strbuf.append(out, "// not supported: ");
    strbuf.append(out, ast.ast_kind_name(r->kind));
    strbuf.append(out, " at ");
    strbuf.append_u64(out, cast(r->at.line, u64));
    strbuf.push(out, ':');
    strbuf.append_u64(out, cast(r->at.col, u64));
    strbuf.push(out, '\n');
}

// ---- the function -----------------------------------------------------------------------------

/// Lowers the function that `decl` defines into *out and returns true. When the body holds a
/// construct that the lowering does not lower, the function writes that construct to *why,
/// releases what it built, leaves *out empty and returns false.
fn lower_function(check.checker mut* ck, ast.node* decl, fir.func mut* out, report mut* why)
    bool {
    return lower_function_with_range_candidates(ck, decl, out, null, why);
}

/// Lowers a function and returns inactive range bindings when `candidates` is non-null.
/// Production leaves it null. No candidate enters the verified FIR function.
fn lower_function_with_capture_candidates(check.checker mut* ck, ast.node* decl,
                                          fir.func mut* out,
                                          range_capture_candidate_vec mut* candidates,
                                          report mut* why) bool {
    range_candidate_set mut proposed = range_candidate_set{};
    defer range_candidate_set_free(&proposed);
    bool ok = lower_function_with_range_candidates(ck, decl, out, &proposed, why);
    if (candidates != null) {
        *candidates = move(proposed.captures);
    }
    return ok;
}

/// Returns incomplete source proposals outside verified FIR. No proposal proves coverage.
fn lower_function_with_range_candidates(check.checker mut* ck, ast.node* decl,
                                        fir.func mut* out, range_candidate_set mut* candidates,
                                        report mut* why) bool {
    if (candidates != null) {
        *candidates = range_candidate_set{};
    }
    *out = fir.func_new(&ck->types, decl->sym, decl->sym->ty);
    lowerer mut lw = lowerer{.ck = ck, .f = out};
    defer scopes_free(&lw.scopes);
    defer gen.refs_free(&lw.defers);
    defer locals_free(&lw.named);
    defer gen.refs_free(&lw.range_declarations);
    defer range_candidate_set_free(&lw.range_candidates);
    prescan(&lw, decl->b);
    zero_owners(&lw);
    // the body is the scope of kind `fn` (spec/fir.md 9.2)
    if (!lower_scope(&lw, decl->b, scope_kind.sc_fn, 0, 0)) {
        *why = lw.why;
        fir.func_free(out);
        return false;
    }
    lower_end(&lw, decl->b);
    range_boundaries_sort(&lw.range_candidates.boundaries);
    if (candidates != null) {
        *candidates = move(lw.range_candidates);
    }
    return true;
}

// The entry block (spec/fir.md 9.2): `_n = const zero T` for each named local of an `own`
// reference type, in local order, at its name and with index 0, so that the first execution of
// its declaration finds null in its overwrite check (D17.11). A parameter needs none, and D17.11
// checks no owning aggregate.
fn zero_owners(lowerer mut* lw) void {
    u32 mut n = 1;
    while (n < fir.local_count(lw->f)) {
        fir.local* l = fir.local_at(lw->f, n);
        if (l->kind == fir.local_kind.lk_named && own_reference(l->ty)) {
            fir.operand zero = fir.operand_const(fir.const_zero(l->ty));
            append(lw, fir.stmt_assign(fir.place_local(n), fir.rvalue_use(lw->f, zero), l->loc, 0));
        }
        n += 1;
    }
}

// Adds a named local for each declaration below `n`, in the order of a walk of the tree: a
// declaration before its children, and the selected branch of a statement `$if` alone
// (spec/fir.md 5.3). A range `for` declares its variable on the loop node.
fn prescan(lowerer mut* lw, ast.node* n) void {
    if (n == null) {
        return;
    }
    if (n->kind == ast.ast_kind.k_compile_if) {
        prescan(lw, selected_branch(n));
        return;
    }
    if ((n->kind == ast.ast_kind.k_var_decl || n->kind == ast.ast_kind.k_range_for)
        && n->sym != null) {
        fir.local_add(lw->f, n->sym->ty, fir.local_kind.lk_named, n->sym, n->name_loc);
    }
    if (n->kind == ast.ast_kind.k_range_for) {
        gen.refs_push(&lw->range_declarations, n);
        fir.range_declaration_vec mut* v = &lw->range_candidates.declarations;
        if (v->len >= fir.U32_LIMIT) {
            panic("fir_lower.prescan: too many range declarations");
        }
        if (v->len == v->items.len) {
            u64 cap = fir.grown_capacity(v->items.len,
                                          "fir_lower.prescan: declaration capacity overflow");
            fir.range_declaration mut@ own bigger = new(fir.range_declaration, cap);
            u64 mut j = 0;
            while (j < v->len) {
                bigger[j] = v->items[j];
                j += 1;
            }
            del(v->items);
            v->items = move(bigger);
        }
        v->items[v->len] = fir.range_declaration{cast(v->len + 1, u32), n->loc};
        v->len += 1;
    }
    prescan(lw, n->a);
    prescan(lw, n->b);
    prescan(lw, n->c);
    prescan(lw, n->d);
    u64 mut i = 0;
    while (i < ast.ast_len(n)) {
        prescan(lw, ast.ast_child(n, i));
        i += 1;
    }
}

// The ID of one selected range node. Prescan gives IDs in selected source order.
fn range_declaration_id(lowerer* lw, ast.node* n) u32 {
    u64 mut i = 0;
    while (i < lw->range_declarations.len) {
        if (gen.refs_at(&lw->range_declarations, i) == n) {
            return cast(i + 1, u32);
        }
        i += 1;
    }
    panic("fir_lower.range_declaration_id: range node absent from prescan");
}

fn range_audit_loc_eq(diag.loc a, diag.loc b) bool {
    return a.file == b.file && a.line == b.line && a.col == b.col
        && a.end_line == b.end_line && a.end_col == b.end_col;
}

// This walk does not read the producer's declaration vector.
fn range_audit_selected(ast.node* n, gen.node_ref_vec mut* selected) void {
    if (n == null) { return; }
    if (n->kind == ast.ast_kind.k_compile_if) {
        range_audit_selected(selected_branch(n), selected);
        return;
    }
    if (n->kind == ast.ast_kind.k_range_for) { gen.refs_push(selected, n); }
    range_audit_selected(n->a, selected);
    range_audit_selected(n->b, selected);
    range_audit_selected(n->c, selected);
    range_audit_selected(n->d, selected);
    u64 mut i = 0;
    while (i < ast.ast_len(n)) {
        range_audit_selected(ast.ast_child(n, i), selected);
        i += 1;
    }
}

fn range_audit_fail(range_source_audit mut* out, range_audit_key key,
                    range_audit_fault reason) bool {
    out->failure = range_audit_failure{key, reason};
    return false;
}

// A fresh report compares selected source nodes with supplied declaration records.
// The full produced-expansion audit uses this inventory before it reads any binding.
fn audit_range_inventory(ast.node* decl, range_candidate_set* proposed,
                         range_source_audit mut* out) bool {
    *out = range_source_audit{};
    gen.node_ref_vec mut selected = gen.node_ref_vec{};
    defer gen.refs_free(&selected);
    range_audit_selected(decl->b, &selected);
    out->selected_declarations = cast(selected.len, u32);
    u64 mut i = 0;
    while (i < selected.len) {
        ast.node* n = gen.refs_at(&selected, i);
        range_audit_key key = range_audit_key{.function = decl->sym,
                                              .declaration = cast(i + 1, u32),
                                              .source = n->loc};
        if (i >= proposed->declarations.len ||
            proposed->declarations.items[i].id != key.declaration ||
            !range_audit_loc_eq(proposed->declarations.items[i].source, n->loc)) {
            return range_audit_fail(out, key, range_audit_fault.declaration);
        }
        i += 1;
    }
    if (proposed->declarations.len != selected.len) {
        fir.range_declaration* extra = &proposed->declarations.items[selected.len];
        range_audit_key key = range_audit_key{.function = decl->sym,
                                              .declaration = extra->id,
                                              .source = extra->source};
        return range_audit_fail(out, key, range_audit_fault.declaration);
    }
    return true;
}

// The range lowering writes its fresh u64 counter at the range node.
// This FIR operation exists even when the loop has zero runtime iterations.
fn range_audit_counter(fir.func* f, fir.statement* s) bool {
    if (s->kind != fir.stmt_kind.st_assign || s->place.base != fir.base_kind.bk_local
        || s->place.proj_len != 0 || s->place.local >= fir.local_count(f)
        || fir.local_at(f, s->place.local)->kind != fir.local_kind.lk_temp
        || s->value.kind != fir.rvalue_kind.rv_use || s->value.ops_len != 1) {
        return false;
    }
    fir.operand value = fir.operand_at(f, s->value.ops_first);
    return value.kind == fir.operand_kind.ok_const
        && value.value.kind == fir.const_kind.ck_int
        && consts.cv_is_zero(value.value.value);
}

fn range_audit_operations(fir.func* f, gen.node_ref_vec* selected,
                          range_audit_operation_vec mut* operations) void {
    u32 mut b = 0;
    while (b < fir.block_count(f)) {
        u32 mut p = 0;
        while (p < fir.block_statement_count(f, b)) {
            fir.statement* s = fir.block_statement(f, b, p);
            if (range_audit_counter(f, s)) {
                u64 mut i = 0;
                while (i < selected->len) {
                    ast.node* n = gen.refs_at(selected, i);
                    if (range_audit_loc_eq(s->loc, n->loc)) {
                        range_audit_operation_add(operations,
                            range_audit_operation{b, p, s->stmt, cast(i + 1, u32), s->exit_loc});
                        break;
                    }
                    i += 1;
                }
            }
            p += 1;
        }
        b += 1;
    }
    u64 mut i = 1;
    while (i < operations->len) {
        range_audit_operation item = operations->items[i];
        u64 mut j = i;
        while (j > 0 && operations->items[j - 1].statement_index > item.statement_index) {
            operations->items[j] = operations->items[j - 1];
            j -= 1;
        }
        operations->items[j] = item;
        i += 1;
    }
}

fn range_audit_place_eq(fir.func* f, fir.place a, fir.place b) bool {
    if (a.base != b.base || a.local != b.local || a.global != b.global
        || a.proj_len != b.proj_len) { return false; }
    u32 mut i = 0;
    while (i < a.proj_len) {
        fir.projection x = fir.place_projection(f, a, i);
        fir.projection y = fir.place_projection(f, b, i);
        if (x.kind != y.kind || x.field != y.field || x.index != y.index) { return false; }
        i += 1;
    }
    return true;
}

fn range_audit_place_valid(fir.func* f, fir.place p) bool {
    if (p.base == fir.base_kind.bk_local && p.local >= fir.local_count(f)) { return false; }
    if (p.base == fir.base_kind.bk_global && p.global == null) { return false; }
    return cast(p.proj_first, u64) + cast(p.proj_len, u64) <= f->projs.len;
}

fn range_audit_indexed_from(fir.func* f, fir.place element, fir.place base) bool {
    if (element.base != base.base || element.local != base.local
        || element.global != base.global || element.proj_len != base.proj_len + 1) {
        return false;
    }
    u32 mut i = 0;
    while (i < base.proj_len) {
        fir.projection x = fir.place_projection(f, element, i);
        fir.projection y = fir.place_projection(f, base, i);
        if (x.kind != y.kind || x.field != y.field || x.index != y.index) { return false; }
        i += 1;
    }
    return fir.place_projection(f, element, i).kind == fir.proj_kind.pj_index;
}

fn range_audit_element(fir.func* f, ast.node* n, u32 statement_index,
                       fir.place captured, u32 mut* body_block) bool {
    u32 mut b = 0;
    while (b < fir.block_count(f)) {
        u32 mut p = 0;
        while (p < fir.block_statement_count(f, b)) {
            fir.statement* s = fir.block_statement(f, b, p);
            if (s->stmt == statement_index && s->kind == fir.stmt_kind.st_assign
                && s->place.base == fir.base_kind.bk_local && s->place.proj_len == 0
                && s->place.local < fir.local_count(f)
                && fir.local_at(f, s->place.local)->sym == cast(n->sym, ast.sym*)
                && range_audit_loc_eq(s->loc, n->b->loc)
                && s->value.kind == fir.rvalue_kind.rv_use && s->value.ops_len == 1) {
                fir.operand value = fir.operand_at(f, s->value.ops_first);
                if (value.kind == fir.operand_kind.ok_copy
                    && range_audit_indexed_from(f, value.place, captured)) {
                    *body_block = b;
                    return true;
                }
            }
            p += 1;
        }
        b += 1;
    }
    return false;
}

fn range_audit_contains(ast.node* root, ast.node* target) bool {
    if (root == null) { return false; }
    if (root == target) { return true; }
    if (root->kind == ast.ast_kind.k_compile_if) {
        return range_audit_contains(selected_branch(root), target);
    }
    if (range_audit_contains(root->a, target) || range_audit_contains(root->b, target)
        || range_audit_contains(root->c, target) || range_audit_contains(root->d, target)) {
        return true;
    }
    u64 mut i = 0;
    while (i < ast.ast_len(root)) {
        if (range_audit_contains(ast.ast_child(root, i), target)) { return true; }
        i += 1;
    }
    return false;
}

// Returns the nearest selected source defer that contains this range.
fn range_audit_defer_at(ast.node* root, ast.node* target) ast.node* {
    if (root == null || root == target) { return null; }
    if (root->kind == ast.ast_kind.k_compile_if) {
        return range_audit_defer_at(selected_branch(root), target);
    }
    ast.node* mut found = range_audit_defer_at(root->a, target);
    if (found == null) { found = range_audit_defer_at(root->b, target); }
    if (found == null) { found = range_audit_defer_at(root->c, target); }
    if (found == null) { found = range_audit_defer_at(root->d, target); }
    u64 mut i = 0;
    while (found == null && i < ast.ast_len(root)) {
        found = range_audit_defer_at(ast.ast_child(root, i), target);
        i += 1;
    }
    if (found != null) { return found; }
    if (root->kind == ast.ast_kind.k_defer && range_audit_contains(root->a, target)) {
        return root;
    }
    return null;
}

// The source replay counts scope exits, including exits with no range operation.
// It derives context records without reading any candidate record.
struct range_audit_source_range {
    ast.node* node;
    u32 first;
    u32 last;
    u32 context;
    u32 occurrence;
    diag.loc exit_source;
}

struct range_audit_replay {
    fir.func* f;
    scope_vec scopes;
    gen.node_ref_vec defers;
    range_defer_context_candidate_vec contexts;
    range_audit_source_range mut@ own ranges;
    u64 ranges_len;
    range_audit_operation_vec gaps;
    u64 floor;
    u32 counter;
    u32 stmt;
    u32 context;
    u32 occurrence;
    u32 next_occurrence;
    diag.loc exit_source;
    bool ended;
    bool incomplete;
}

fn range_audit_replay_free(range_audit_replay mut* walk) void {
    scopes_free(&walk->scopes);
    gen.refs_free(&walk->defers);
    del(walk->contexts.items);
    del(walk->ranges);
    del(walk->gaps.items);
}

fn range_audit_replay_push(range_audit_replay mut* walk, scope_kind kind) void {
    scope_vec mut* v = &walk->scopes;
    if (v->len == v->items.len) {
        u64 cap = fir.grown_capacity(v->items.len, "range audit: scope overflow");
        scope mut@ own bigger = new(scope, cap);
        u64 mut i = 0;
        while (i < v->len) { bigger[i] = v->items[i]; i += 1; }
        del(v->items);
        v->items = move(bigger);
    }
    v->items[v->len] = scope{.kind = kind, .defers_first = walk->defers.len};
    v->len += 1;
}

fn range_audit_replay_expand(range_audit_replay mut* walk, u64 depth, diag.loc at,
                               bool suppressed) void {
    u64 first = walk->scopes.items[depth].defers_first;
    u64 mut i = walk->defers.len;
    if (depth + 1 < walk->scopes.len) { i = walk->scopes.items[depth + 1].defers_first; }
    u64 saved_floor = walk->floor;
    u32 parent = walk->context;
    u32 saved_occurrence = walk->occurrence;
    diag.loc saved_exit = walk->exit_source;
    if (cast(walk->next_occurrence, u64) >= fir.U32_LIMIT) {
        panic("range audit: exit occurrence overflow");
    }
    walk->next_occurrence += 1;
    walk->occurrence = walk->next_occurrence;
    walk->floor = walk->scopes.len;
    walk->exit_source = at;
    while (i > first) {
        i -= 1;
        ast.node* deferred = gen.refs_at(&walk->defers, i);
        walk->context = cast(walk->contexts.len + 1, u32);
        range_defer_context_candidate_add(&walk->contexts,
            range_defer_context_candidate{walk->context, parent, walk->occurrence, deferred, at});
        if (!suppressed && !walk->ended) { range_audit_replay_stmt(walk, deferred->a); }
    }
    walk->floor = saved_floor;
    walk->context = parent;
    walk->occurrence = saved_occurrence;
    walk->exit_source = saved_exit;
}

fn range_audit_replay_gap(range_audit_replay mut* walk, u64 depth, diag.loc at) void {
    u32 range = walk->scopes.items[depth].range_loan;
    if (range != 0 && !walk->ended) {
        range_audit_operation_add(&walk->gaps,
            range_audit_operation{.statement_index = walk->stmt,
                                    .declaration = range, .exit_source = at});
    }
}

fn range_audit_replay_close(range_audit_replay mut* walk, diag.loc at) void {
    u64 depth = walk->scopes.len - 1;
    if (!walk->ended) { range_audit_replay_expand(walk, depth, at, false); }
    range_audit_replay_gap(walk, depth, at);
    walk->defers.len = walk->scopes.items[depth].defers_first;
    walk->scopes.len = depth;
}

fn range_audit_replay_scope(range_audit_replay mut* walk, ast.node* n,
                              scope_kind kind) void {
    range_audit_replay_push(walk, kind);
    u64 mut i = 0;
    while (i < ast.ast_len(n)) {
        // Source statements after a terminator get a disconnected FIR block.
        walk->ended = false;
        range_audit_replay_stmt(walk, ast.ast_child(n, i));
        i += 1;
    }
    range_audit_replay_close(walk, end_of(n));
}

fn range_audit_replay_exit(range_audit_replay mut* walk, ast.node* n, exit_kind kind) void {
    u64 mut depth = walk->scopes.len;
    while (depth > walk->floor) {
        depth -= 1;
        range_audit_replay_expand(walk, depth, n->loc, walk->ended);
        range_audit_replay_gap(walk, depth, n->loc);
        if (exit_stops_at(kind, walk->scopes.items[depth].kind)) { break; }
    }
    walk->ended = true;
}

fn range_audit_replay_range(range_audit_replay mut* walk, ast.node* n) void {
    if (walk->ranges_len >= fir.U32_LIMIT) { panic("range audit: too many ranges"); }
    if (walk->ranges_len == walk->ranges.len) {
        u64 cap = fir.grown_capacity(walk->ranges.len, "range audit: range overflow");
        range_audit_source_range mut@ own bigger = new(range_audit_source_range, cap);
        u64 mut i = 0;
        while (i < walk->ranges_len) {
            bigger[i] = walk->ranges[i];
            i += 1;
        }
        del(walk->ranges);
        walk->ranges = move(bigger);
    }
    u64 index = walk->ranges_len;
    walk->ranges[index] = range_audit_source_range{n, walk->counter, 0, walk->context,
                                                  walk->occurrence, walk->exit_source};
    walk->ranges_len += 1;
    range_audit_replay_push(walk, scope_kind.sc_loop);
    walk->scopes.items[walk->scopes.len - 1].range_loan = cast(index + 1, u32);
    u64 mut child = 0;
    while (child < ast.ast_len(n->c)) {
        walk->ended = false;
        range_audit_replay_stmt(walk, ast.ast_child(n->c, child));
        child += 1;
    }
    range_audit_replay_close(walk, end_of(n->c));
    walk->ranges[index].last = walk->counter;
    walk->ended = false;
}

// Verified abort terminators constrain the replay of simple source statements.
fn range_audit_replay_abort(range_audit_replay mut* walk, ast.node* n) bool {
    if (n->kind != ast.ast_kind.k_call_stmt || n->a == null || n->a->a == null) {
        return false;
    }
    ast.node* call = n->a;
    bool builtin_abort = builtin_call(call) && call->a->sym->name == "panic";
    bool mut aborts = builtin_abort;
    diag.loc mut at = call->loc;
    if (builtin_abort) { at = call->a->loc; }
    if (call->a->ty != null && call->a->ty->is_noreturn) { aborts = true; }
    if (!aborts) { return false; }
    u32 mut b = 0;
    while (b < fir.block_count(walk->f)) {
        fir.terminator* t = &fir.block_at(walk->f, b)->term;
        if (t->stmt == walk->stmt && range_audit_loc_eq(t->loc, at)
            && range_audit_loc_eq(t->exit_loc, walk->exit_source)
            && (t->kind == fir.term_kind.tk_fail || t->kind == fir.term_kind.tk_trap)) {
            return true;
        }
        b += 1;
    }
    walk->incomplete = true;
    return false;
}

fn range_audit_replay_stmt(range_audit_replay mut* walk, ast.node* n) void {
    if (n->kind == ast.ast_kind.k_block) {
        range_audit_replay_scope(walk, n, scope_kind.sc_block);
        return;
    }
    if (n->kind == ast.ast_kind.k_compile_if) {
        ast.node* selected = selected_branch(n);
        if (selected != null) { range_audit_replay_scope(walk, selected, scope_kind.sc_block); }
        return;
    }
    if (cast(walk->counter, u64) >= fir.U32_LIMIT) { panic("range audit: statement overflow"); }
    walk->counter += 1;
    u32 saved = walk->stmt;
    walk->stmt = walk->counter;
    switch (n->kind) {
    case ast.ast_kind.k_defer:
        gen.refs_push(&walk->defers, n);
    case ast.ast_kind.k_range_for:
        range_audit_replay_range(walk, n);
    case ast.ast_kind.k_if:
        walk->ended = false;
        range_audit_replay_stmt(walk, n->b);
        walk->ended = false;
        if (n->c != null) { range_audit_replay_stmt(walk, n->c); }
        walk->ended = false;
    case ast.ast_kind.k_while, ast.ast_kind.k_do_while:
        walk->ended = false;
        ast.node* mut body = n->b;
        if (n->kind == ast.ast_kind.k_do_while) { body = n->a; }
        range_audit_replay_scope(walk, body, scope_kind.sc_loop);
        walk->ended = false;
    case ast.ast_kind.k_for:
        range_audit_replay_push(walk, scope_kind.sc_block);
        if (n->a != null) { range_audit_replay_stmt(walk, n->a); }
        walk->ended = false;
        range_audit_replay_scope(walk, n->d, scope_kind.sc_loop);
        walk->ended = false;
        if (n->c != null) { range_audit_replay_stmt(walk, n->c); }
        walk->ended = false;
        range_audit_replay_close(walk, end_of(n));
    case ast.ast_kind.k_switch:
        u64 mut i = 0;
        while (i < ast.ast_len(n)) {
            walk->ended = false;
            range_audit_replay_scope(walk, ast.ast_child(n, i)->a, scope_kind.sc_case);
            i += 1;
        }
        walk->ended = false;
    case ast.ast_kind.k_break:
        range_audit_replay_exit(walk, n, exit_kind.x_break);
    case ast.ast_kind.k_continue:
        range_audit_replay_exit(walk, n, exit_kind.x_continue);
    case ast.ast_kind.k_return:
        range_audit_replay_exit(walk, n, exit_kind.x_return);
    default:
        walk->ended = range_audit_replay_abort(walk, n);
    }
    walk->stmt = saved;
}

fn range_audit_contexts(range_audit_replay* walk, range_candidate_set* proposed,
                          range_audit_source_range source) bool {
    if (source.context == 0) { return true; }
    if (walk->contexts.len != proposed->deferred.len) { return false; }
    u64 mut i = 0;
    while (i < walk->contexts.len) {
        range_defer_context_candidate a = walk->contexts.items[i];
        range_defer_context_candidate b = proposed->deferred.items[i];
        if (a.id != b.id || a.parent != b.parent || a.exit_occurrence != b.exit_occurrence
            || a.source_node != b.source_node
            || !range_audit_loc_eq(a.exit_source, b.exit_source)) {
            return false;
        }
        i += 1;
    }
    // The source walk gives every link. A candidate cannot shorten the chain.
    u32 mut context = source.context;
    while (context != 0) {
        if (cast(context, u64) > walk->contexts.len) { return false; }
        range_defer_context_candidate c = walk->contexts.items[context - 1];
        if (!range_audit_contains(c.source_node->a, source.node)) { return false; }
        context = c.parent;
    }
    return true;
}

// A call in the storage root needs a separate result-materialization proof.
fn range_audit_call_root(ast.node* n) bool {
    ast.node* mut current = n;
    while (current != null) {
        if (current->kind == ast.ast_kind.k_call) { return true; }
        if (current->kind == ast.ast_kind.k_ternary
            && (range_audit_call_root(current->b) || range_audit_call_root(current->c))) {
            return true;
        }
        current = current->a;
    }
    return false;
}

// Operand calls require proof even when they do not supply the storage root.
fn range_audit_has_call(ast.node* n) bool {
    if (n == null) { return false; }
    if (n->kind == ast.ast_kind.k_call) { return true; }
    if (range_audit_has_call(n->a) || range_audit_has_call(n->b)
        || range_audit_has_call(n->c) || range_audit_has_call(n->d)) { return true; }
    u64 mut i = 0;
    while (i < ast.ast_len(n)) {
        if (range_audit_has_call(ast.ast_child(n, i))) { return true; }
        i += 1;
    }
    return false;
}

struct range_material_point {
    u32 block;
    u32 position;
}

struct range_material_match {
    bool emitted;
    range_material_point first;
    range_material_point last;
}

struct range_material_context {
    fir.func* f;
    range_audit_operation operation;
}

// A linear predecessor must have one normal edge. Conditional joins need a later proof.
fn range_material_parent(range_material_context* proof, u32 block, u32 mut* parent) bool {
    u32 mut count = 0;
    u32 mut b = 0;
    while (b < fir.block_count(proof->f)) {
        fir.terminator* term = &fir.block_at(proof->f, b)->term;
        u32 mut i = 0;
        u32 mut target = 0;
        while (fir.term_targets(proof->f, term, i, &target)) {
            if (target == block) {
                if (term->kind != fir.term_kind.tk_goto && term->kind != fir.term_kind.tk_check) {
                    return false;
                }
                if (term->stmt != proof->operation.statement_index
                    || !range_audit_loc_eq(term->exit_loc, proof->operation.exit_source)) {
                    return false;
                }
                *parent = b;
                count += 1;
            }
            i += 1;
        }
        b += 1;
    }
    return count == 1;
}

// The definition must precede this read on its actual linear path.
fn range_material_before(range_material_context* proof, range_material_point before,
                          range_material_point read) bool {
    u32 mut steps = 0;
    range_material_point mut current = read;
    while (steps < fir.block_count(proof->f)) {
        if (current.block == before.block) { return before.position < current.position; }
        u32 mut parent = 0;
        if (!range_material_parent(proof, current.block, &parent)) { return false; }
        current = range_material_point{.block = parent,
                                        .position = fir.block_statement_count(proof->f, parent)};
        steps += 1;
    }
    return false;
}

// A materialized temporary has one complete write and no competing write or deletion.
fn range_material_definition(range_material_context* proof, fir.place target,
                              range_material_point read, range_material_point mut* at,
                              fir.statement* mut* definition) bool {
    fir.func* f = proof->f;
    if (!range_audit_place_valid(f, target) || target.base != fir.base_kind.bk_local
        || target.proj_len != 0 || fir.local_at(f, target.local)->kind != fir.local_kind.lk_temp) {
        return false;
    }
    u32 mut count = 0;
    u32 mut b = 0;
    while (b < fir.block_count(f)) {
        u32 mut p = 0;
        while (p < fir.block_statement_count(f, b)) {
            fir.statement* s = fir.block_statement(f, b, p);
            // An address or array slice permits writes that name another local.
            if (s->kind == fir.stmt_kind.st_assign
                && (s->value.kind == fir.rvalue_kind.rv_addr
                    || (s->value.kind == fir.rvalue_kind.rv_slice
                        && fir.place_type(f, s->value.place)->kind == types.type_kind.k_array))
                && s->value.place.base == fir.base_kind.bk_local
                && s->value.place.local == target.local && fir.place_fixed(f, s->value.place)) {
                return false;
            }
            fir.place mut written = fir.place{};
            if (fir.stmt_writes_place(s, &written) && written.base == fir.base_kind.bk_local
                && written.local == target.local) {
                if (s->kind != fir.stmt_kind.st_assign || written.proj_len != 0) { return false; }
                *at = range_material_point{.block = b, .position = p};
                *definition = s;
                count += 1;
            }
            p += 1;
        }
        b += 1;
    }
    if (count != 1 || (*definition)->stmt != proof->operation.statement_index
        || !range_audit_loc_eq((*definition)->exit_loc, proof->operation.exit_source)) {
        return false;
    }
    return range_material_before(proof, *at, read);
}

fn range_material_fixed_temp(fir.func* f, fir.place p) bool {
    return p.base == fir.base_kind.bk_local
        && fir.local_at(f, p.local)->kind == fir.local_kind.lk_temp && fir.place_fixed(f, p);
}

// Read literal syntax independently. Other folded constants need their value table.
fn range_material_constant(ast.node* n, fir.constant value) bool {
    if (n->kind == ast.ast_kind.k_ident || n->kind == ast.ast_kind.k_field) {
        return n->sym != null && n->sym->kind == ast.sym_kind.s_fn
            && value.kind == fir.const_kind.ck_fn && value.sym == cast(n->sym, ast.sym*);
    }
    if (n->kind == ast.ast_kind.k_int || n->kind == ast.ast_kind.k_char) {
        return value.kind == fir.const_kind.ck_int && !consts.cv_is_neg(value.value)
            && value.value.mag == n->ival && types.type_equal(value.ty, n->ty);
    }
    if (n->kind == ast.ast_kind.k_bool) {
        return value.kind == fir.const_kind.ck_bool && value.value.mag == n->ival;
    }
    if (n->kind == ast.ast_kind.k_null) {
        return value.kind == fir.const_kind.ck_null && types.type_equal(value.ty, n->ty);
    }
    if (n->kind == ast.ast_kind.k_string) {
        return value.kind == fir.const_kind.ck_string && value.text == n->name;
    }
    return false;
}

// Verify a held read before its later writer. A fixed temporary needs no additional copy.
fn range_material_operand(range_material_context* proof, ast.node* n, fir.operand actual,
                           range_material_point read, bool later, u32 depth,
                           range_material_match mut* matched) bool {
    if (n == null || depth >= 64 || n->kind == ast.ast_kind.k_ternary) { return false; }
    if (actual.kind == fir.operand_kind.ok_const) {
        return range_material_constant(n, actual.value);
    }
    if (!range_audit_place_valid(proof->f, actual.place)) { return false; }
    if (later && !range_material_fixed_temp(proof->f, actual.place)) { return false; }
    if (later && actual.place.proj_len == 0) {
        range_material_point mut at = range_material_point{};
        fir.statement* mut held = null;
        if (range_material_definition(proof, actual.place, read, &at, &held)
            && held->value.kind == fir.rvalue_kind.rv_use && held->value.ops_len == 1
            && range_audit_loc_eq(held->loc, n->loc)) {
            fir.operand original = fir.operand_at(proof->f, held->value.ops_first);
            if (original.kind == fir.operand_kind.ok_const || original.kind != actual.kind
                || range_material_fixed_temp(proof->f, original.place)) { return false; }
            if (!range_material_operand(proof, n, original, at, false, depth + 1, matched)) {
                return false;
            }
            if (!matched->emitted) { matched->first = at; }
            matched->emitted = true;
            matched->last = at;
            return true;
        }
    }
    bool moved = n->kind == ast.ast_kind.k_call && (n->ann & check.ANN_MOVE) != 0;
    if (moved) {
        return actual.kind == fir.operand_kind.ok_move
            && range_material_place(proof, ast.ast_child(n, 0), actual.place, read, false,
                                     depth + 1, matched);
    }
    bool owns_result = !designates(n) && fir.type_owning(n->ty);
    if ((actual.kind == fir.operand_kind.ok_move) != owns_result) { return false; }
    return range_material_place(proof, n, actual.place, read, false, depth + 1, matched);
}

// Reverse argument traversal checks the actual emitted order, not temporary numbers.
fn range_material_call(range_material_context* proof, ast.node* n, fir.statement* s,
                        range_material_point at, u32 depth,
                        range_material_match mut* matched) bool {
    if (s->value.kind != fir.rvalue_kind.rv_call || builtin_call(n)
        || cast(s->value.ops_len, u64) != ast.ast_len(n) || !range_audit_loc_eq(s->loc, n->loc)) {
        return false;
    }
    u32 mut copies = 0;
    u32 mut b = 0;
    while (b < fir.block_count(proof->f)) {
        u32 mut p = 0;
        while (p < fir.block_statement_count(proof->f, b)) {
            fir.statement* other = fir.block_statement(proof->f, b, p);
            if (other->kind == fir.stmt_kind.st_assign
                && other->value.kind == fir.rvalue_kind.rv_call
                && other->stmt == s->stmt && range_audit_loc_eq(other->loc, n->loc)
                && range_audit_loc_eq(other->exit_loc, s->exit_loc)) { copies += 1; }
            p += 1;
        }
        b += 1;
    }
    if (copies != 1) { return false; }
    range_material_point mut first = at;
    bool mut later = false;
    u64 mut i = ast.ast_len(n);
    while (i > 0) {
        i -= 1;
        ast.node* arg = ast.ast_child(n, i);
        fir.operand actual = fir.operand_at(proof->f, s->value.ops_first + cast(i, u32));
        range_material_match mut child = range_material_match{};
        if (!range_material_operand(proof, arg, actual, at, later, depth + 1, &child)) {
            return false;
        }
        if (child.emitted) {
            if (!range_material_before(proof, child.last, first)) { return false; }
            first = child.first;
        }
        later = later || contains_writer(arg);
    }
    ast.sym* callee = n->a->sym;
    if (callee != null && (callee->kind == ast.sym_kind.s_fn
        || callee->kind == ast.sym_kind.s_extern_fn)) {
        fir.callee_kind mut expected = fir.callee_kind.cl_fn;
        if (callee->kind == ast.sym_kind.s_extern_fn) { expected = fir.callee_kind.cl_extern; }
        if (s->value.callee != expected || s->value.callee_sym != callee) { return false; }
    } else {
        range_material_match mut value = range_material_match{};
        if (s->value.callee != fir.callee_kind.cl_value
            || !range_material_operand(proof, n->a, s->value.callee_op, at, later,
                                       depth + 1, &value)) {
            return false;
        }
        if (value.emitted) {
            if (!range_material_before(proof, value.last, first)) { return false; }
            first = value.first;
        }
    }
    *matched = range_material_match{.emitted = true, .first = first, .last = at};
    return true;
}

fn range_material_bound(range_material_context* proof, ast.node* n, fir.operand actual,
                         diag.loc source, range_material_point read, u32 depth,
                         range_material_match mut* matched) bool {
    if (actual.kind != fir.operand_kind.ok_copy) { return false; }
    range_material_point mut at = range_material_point{};
    fir.statement* mut casted = null;
    if (!range_material_definition(proof, actual.place, read, &at, &casted)
        || casted->value.kind != fir.rvalue_kind.rv_cast || casted->value.ops_len != 1
        || casted->value.ty->kind != types.type_kind.k_prim
        || casted->value.ty->prim != prim.prim_kind.prim_u64
        || !range_audit_loc_eq(casted->loc, source)) { return false; }
    if (!range_material_operand(proof, n, fir.operand_at(proof->f, casted->value.ops_first),
                                at, false, depth + 1, matched)) { return false; }
    if (!matched->emitted) { matched->first = at; }
    matched->emitted = true;
    matched->last = at;
    return true;
}

fn range_material_field(ast.node* n, u32 mut* field) bool {
    types.node* mut ty = n->a->ty;
    if (n->kind == ast.ast_kind.k_arrow) { ty = ty->elem; }
    if (ty->kind == types.type_kind.k_span || ty->kind == types.type_kind.k_string) {
        if (n->name != "len" && n->name != "ptr") { return false; }
        *field = PTR_FIELD;
        if (n->name == "len") { *field = LEN_FIELD; }
        return true;
    }
    u64 mut index = 0;
    if (n->sym == null || !gen.gen_field_index(n->sym, &index) || index >= fir.U32_LIMIT) {
        return false;
    }
    *field = cast(index, u32);
    return true;
}

fn range_material_deref(range_material_context* proof, ast.node* n, fir.place p,
                         range_material_point read, u32 depth,
                        range_material_match mut* matched) bool {
    if (p.proj_len == 0
        || fir.place_projection(proof->f, p, p.proj_len - 1).kind != fir.proj_kind.pj_deref) {
        return false;
    }
    fir.place mut pointer = p;
    pointer.proj_len -= 1;
    return range_material_operand(proof, n, fir.operand_copy(pointer), read, false,
                                  depth + 1, matched);
}

// Read each projection from verified FIR. This walk adds no projection or temporary.
fn range_material_place(range_material_context* proof, ast.node* n, fir.place p,
                         range_material_point read, bool held, u32 depth,
                         range_material_match mut* matched) bool {
    if (n == null || depth >= 64 || !range_audit_place_valid(proof->f, p)
        || n->kind == ast.ast_kind.k_ternary) { return false; }
    fir.func* f = proof->f;
    if (held && p.base == fir.base_kind.bk_local && p.proj_len == 1
        && fir.place_projection(f, p, 0).kind == fir.proj_kind.pj_deref) {
        range_material_point mut at = range_material_point{};
        fir.statement* mut address = null;
        if (range_material_definition(proof, fir.place_local(p.local), read, &at, &address)
            && address->value.kind == fir.rvalue_kind.rv_addr
            && range_audit_loc_eq(address->loc, n->loc)) {
            if (!fir.place_indirect(f, address->value.place)
                || !range_material_place(proof, n, address->value.place, at, false,
                                          depth + 1, matched)) { return false; }
            if (!matched->emitted) { matched->first = at; }
            matched->emitted = true;
            matched->last = at;
            return true;
        }
    }
    if (held && fir.place_indirect(f, p)) { return false; }
    if ((n->kind == ast.ast_kind.k_ident || n->kind == ast.ast_kind.k_field) && n->sym != null) {
        ast.sym* source = n->sym;
        if (source->kind == ast.sym_kind.s_global || source->kind == ast.sym_kind.s_const) {
            return p.base == fir.base_kind.bk_global && p.global == source && p.proj_len == 0;
        }
        if (source->kind == ast.sym_kind.s_param || source->kind == ast.sym_kind.s_local) {
            return p.base == fir.base_kind.bk_local && p.proj_len == 0
                && fir.local_at(f, p.local)->sym == source;
        }
    }
    if (n->kind == ast.ast_kind.k_field || n->kind == ast.ast_kind.k_arrow) {
        u32 mut field = 0;
        if (p.proj_len == 0 || !range_material_field(n, &field)) { return false; }
        fir.projection actual = fir.place_projection(f, p, p.proj_len - 1);
        if (actual.kind != fir.proj_kind.pj_field || actual.field != field) { return false; }
        fir.place mut base = p;
        base.proj_len -= 1;
        if (n->kind == ast.ast_kind.k_arrow) {
            return range_material_deref(proof, n->a, base, read, depth + 1, matched);
        }
        return range_material_place(proof, n->a, base, read, false, depth + 1, matched);
    }
    if (n->kind == ast.ast_kind.k_unary && cast(n->op, lexer.tok_kind) == lexer.tok_kind.star) {
        return range_material_deref(proof, n->a, p, read, depth + 1, matched);
    }
    if (n->kind == ast.ast_kind.k_index) {
        if (p.proj_len == 0) { return false; }
        fir.projection index = fir.place_projection(f, p, p.proj_len - 1);
        if (index.kind != fir.proj_kind.pj_index) { return false; }
        range_material_match mut bound = range_material_match{};
        if (!range_material_bound(proof, n->b, fir.operand_copy(fir.place_local(index.index)),
                                  n->loc, read, depth + 1, &bound)) { return false; }
        fir.place mut base = p;
        base.proj_len -= 1;
        range_material_match mut root = range_material_match{};
        bool writer = contains_writer(n->b);
        if (!range_material_place(proof, n->a, base, read, writer, depth + 1, &root)) {
            return false;
        }
        if (root.emitted && !range_material_before(proof, root.last, bound.first)) { return false; }
        *matched = bound;
        if (root.emitted) { matched->first = root.first; }
        return true;
    }
    range_material_point mut at = range_material_point{};
    fir.statement* mut definition = null;
    if (!range_material_definition(proof, p, read, &at, &definition)
        || !range_audit_loc_eq(definition->loc, n->loc)
        || !types.type_same_shape(fir.place_type(f, p), n->ty)) { return false; }
    if (n->kind == ast.ast_kind.k_call) {
        return range_material_call(proof, n, definition, at, depth + 1, matched);
    }
    fir.rvalue value = definition->value;
    if (n->kind == ast.ast_kind.k_unary && cast(n->op, lexer.tok_kind) == lexer.tok_kind.amp) {
        if (value.kind != fir.rvalue_kind.rv_addr || value.is_mut != n->ty->is_mut
            || !range_material_place(proof, n->a, value.place, at, false, depth + 1, matched)) {
            return false;
        }
    } else if (n->kind == ast.ast_kind.k_cast) {
        if (value.kind != fir.rvalue_kind.rv_cast || value.ops_len != 1
            || !types.type_equal(value.ty, n->ty)
            || !range_material_operand(proof, n->a, fir.operand_at(f, value.ops_first),
                                        at, false, depth + 1, matched)) { return false; }
    } else if (n->kind == ast.ast_kind.k_span) {
        if (!range_material_slice(proof, n, value, at, depth + 1, matched)) { return false; }
    } else { return false; }
    if (!matched->emitted) { matched->first = at; }
    matched->emitted = true;
    matched->last = at;
    return true;
}

fn range_material_slice(range_material_context* proof, ast.node* n, fir.rvalue value,
                         range_material_point at, u32 depth,
                        range_material_match mut* matched) bool {
    fir.func* f = proof->f;
    bool pointer = n->a->ty->kind == types.type_kind.k_ptr;
    u32 mut expected = 2;
    if (pointer) { expected = 3; }
    if (value.ops_len != expected
        || (pointer && value.kind != fir.rvalue_kind.rv_slice_ptr)
        || (!pointer && value.kind != fir.rvalue_kind.rv_slice)) { return false; }
    range_material_match mut base = range_material_match{};
    bool writer = contains_writer(n->b) || contains_writer(n->c);
    if (pointer) {
        if (!range_material_operand(proof, n->a, fir.operand_at(f, value.ops_first),
                                    at, writer, depth + 1, &base)) { return false; }
    } else if (!range_material_place(proof, n->a, value.place, at, writer, depth + 1, &base)) {
        return false;
    }
    range_material_point mut first = at;
    if (base.emitted) { first = base.first; }
    range_material_match mut low = range_material_match{};
    range_material_match mut high = range_material_match{};
    u32 mut offset = 0;
    if (pointer) { offset = 1; }
    fir.operand lo = fir.operand_at(f, value.ops_first + offset);
    fir.operand hi = fir.operand_at(f, value.ops_first + offset + 1);
    if (n->b != null) {
        if (pointer) {
            if (!range_material_operand(proof, n->b, lo, at, contains_writer(n->c),
                                        depth + 1, &low)) { return false; }
        } else if (!range_material_bound(proof, n->b, lo, n->loc, at, depth + 1, &low)) {
            return false;
        }
    } else if (lo.kind != fir.operand_kind.ok_const || lo.value.kind != fir.const_kind.ck_int
        || consts.cv_is_neg(lo.value.value) || lo.value.value.mag != 0) { return false; }
    if (n->c != null) {
        if (pointer) {
            if (!range_material_operand(proof, n->c, hi, at, false, depth + 1, &high)) {
                return false;
            }
        } else if (!range_material_bound(proof, n->c, hi, n->loc, at, depth + 1, &high)) {
            return false;
        }
    } else {
        if (n->a->ty->kind == types.type_kind.k_array) {
            if (hi.kind != fir.operand_kind.ok_const || hi.value.kind != fir.const_kind.ck_int
                || consts.cv_is_neg(hi.value.value) || hi.value.value.mag != n->a->ty->len) {
                return false;
            }
        } else {
            if (hi.kind != fir.operand_kind.ok_copy
                || hi.place.proj_len != value.place.proj_len + 1) {
                return false;
            }
            fir.projection len = fir.place_projection(f, hi.place, hi.place.proj_len - 1);
            fir.place mut header = hi.place;
            header.proj_len -= 1;
            if (len.kind != fir.proj_kind.pj_field || len.field != LEN_FIELD
                || !range_audit_place_eq(f, header, value.place)) { return false; }
        }
    }
    if (base.emitted && low.emitted && !range_material_before(proof, base.last, low.first)) {
        return false;
    }
    if (low.emitted && high.emitted && !range_material_before(proof, low.last, high.first)) {
        return false;
    }
    if (base.emitted && !low.emitted && high.emitted
        && !range_material_before(proof, base.last, high.first)) { return false; }
    if (!base.emitted && low.emitted) { first = low.first; }
    if (!base.emitted && !low.emitted && high.emitted) { first = high.first; }
    *matched = range_material_match{.emitted = true, .first = first, .last = at};
    return true;
}

// The body use supplies the capture. Candidates cannot select this place or its source chain.
fn range_material_capture(fir.func* f, ast.node* n, range_audit_operation op,
                           u32 body, fir.range_capture mut* expected) bool {
    u32 mut found = 0;
    u32 mut p = 0;
    fir.place mut captured = fir.place{};
    while (p < fir.block_statement_count(f, body)) {
        fir.statement* s = fir.block_statement(f, body, p);
        if (s->kind == fir.stmt_kind.st_assign && s->stmt == op.statement_index
            && s->place.base == fir.base_kind.bk_local && s->place.proj_len == 0
            && fir.local_at(f, s->place.local)->sym == cast(n->sym, ast.sym*)
            && range_audit_loc_eq(s->loc, n->b->loc)
                && range_audit_loc_eq(s->exit_loc, op.exit_source)
            && s->value.kind == fir.rvalue_kind.rv_use && s->value.ops_len == 1) {
            fir.operand element = fir.operand_at(f, s->value.ops_first);
            if (element.kind != fir.operand_kind.ok_copy || element.place.proj_len == 0
                || fir.place_projection(f, element.place, element.place.proj_len - 1).kind
                    != fir.proj_kind.pj_index) { return false; }
            captured = element.place;
            captured.proj_len -= 1;
            found += 1;
        }
        p += 1;
    }
    if (found != 1) { return false; }
    range_material_context proof = range_material_context{.f = f, .operation = op};
    range_material_point read = range_material_point{.block = op.block, .position = op.position};
    range_material_match mut matched = range_material_match{};
    fir.range_capture mut binding = fir.range_capture{.source = n->b->loc, .captured = captured};
    if (n->b->ty->kind == types.type_kind.k_array && fir.type_owning(n->b->ty)) {
        if (!range_material_place(&proof, n->b, captured, read, true, 0, &matched)) {
            return false;
        }
        binding.kind = fir.range_capture_kind.owning_fixed_array_place;
        binding.original = captured;
        binding.original_present = true;
    } else {
        binding.kind = fir.range_capture_kind.borrowed_header;
        binding.original_present = true;
        if (n->b->ty->kind == types.type_kind.k_array) {
            binding.kind = fir.range_capture_kind.non_owning_array_copy;
            binding.original_present = false;
        }
        if (fir.type_owning(n->b->ty) || designates(n->b)) {
            range_material_point mut at = range_material_point{};
            fir.statement* mut copy = null;
            if (!range_material_definition(&proof, captured, read, &at, &copy)
                || copy->value.kind != fir.rvalue_kind.rv_use || copy->value.ops_len != 1
                || !range_audit_loc_eq(copy->loc, n->b->loc)) { return false; }
            fir.operand source = fir.operand_at(f, copy->value.ops_first);
            if (source.kind != fir.operand_kind.ok_copy
                || !range_material_place(&proof, n->b, source.place, at, true, 0, &matched)) {
                return false;
            }
            binding.original = source.place;
        } else {
            if (!range_material_place(&proof, n->b, captured, read, false, 0, &matched)) {
                return false;
            }
            binding.original = captured;
        }
    }
    *expected = binding;
    return true;
}

// Facts copy source and FIR views. Only the session owns their resizable storage.
// Stored indices remain valid across growth. No item address enters the report.
struct conditional_region_fact {
    ast.node* source;
    range_material_point branch;
    u32 yes;
    u32 no;
    u32 join;
    u32 yes_exit;
    u32 no_exit;
    fir.place destination;
    bool proved;
}

struct conditional_region_fact_vec {
    conditional_region_fact mut@ own items;
    u64 len;
}

struct conditional_arm_fact {
    u32 region;
    bool side;
    ast.node* source;
    range_material_point write;
    fir.place destination;
    fir.operand produced;
}

struct conditional_arm_fact_vec {
    conditional_arm_fact mut@ own items;
    u64 len;
}

struct conditional_proof_session {
    range_material_context proof;
    range_audit_key key;
    ast.node* declaration;
    ast.node* source;
    conditional_region_fact_vec regions;
    conditional_arm_fact_vec arms;
}

// The audit registers cleanup before recognition. Empty and partial sessions use this path too.
fn conditional_proof_free(conditional_proof_session mut* session) void {
    del(session->regions.items);
    del(session->arms.items);
    *session = conditional_proof_session{};
}

// The work bounds refuse normally. Checked capacity growth keeps its existing panic contract.
fn conditional_region_add(conditional_proof_session mut* session,
                           conditional_region_fact fact, u32 mut* index) bool {
    conditional_region_fact_vec mut* v = &session->regions;
    if (v->len >= 4096 || v->len >= fir.U32_LIMIT) { return false; }
    if (v->len == v->items.len) {
        u64 cap = fir.grown_capacity(v->items.len, "conditional region capacity overflow");
        conditional_region_fact mut@ own bigger = new(conditional_region_fact, cap);
        u64 mut i = 0;
        while (i < v->len) { bigger[i] = v->items[i]; i += 1; }
        del(v->items);
        v->items = move(bigger);
    }
    *index = cast(v->len, u32);
    v->items[v->len] = fact;
    v->len += 1;
    return true;
}

fn conditional_arm_add(conditional_proof_session mut* session,
                        conditional_arm_fact fact) bool {
    conditional_arm_fact_vec mut* v = &session->arms;
    if (v->len >= 8192 || v->len >= fir.U32_LIMIT) { return false; }
    if (v->len == v->items.len) {
        u64 cap = fir.grown_capacity(v->items.len, "conditional arm capacity overflow");
        conditional_arm_fact mut@ own bigger = new(conditional_arm_fact, cap);
        u64 mut i = 0;
        while (i < v->len) { bigger[i] = v->items[i]; i += 1; }
        del(v->items);
        v->items = move(bigger);
    }
    v->items[v->len] = fact;
    v->len += 1;
    return true;
}

// A join denotes its entry gap. It can equal the consuming gap without inventing a statement.
fn conditional_gap_before(conditional_proof_session* session, range_material_point before,
                           range_material_point read) bool {
    range_material_point mut current = read;
    u32 mut steps = 0;
    while (steps < fir.block_count(session->proof.f)) {
        if (current.block == before.block) { return before.position <= current.position; }
        bool mut joined = false;
        u64 mut r = 0;
        while (r < session->regions.len) {
            conditional_region_fact region = session->regions.items[r];
            if (region.proved && region.join == current.block) {
                current = region.branch;
                joined = true;
                break;
            }
            r += 1;
        }
        if (!joined) {
            u32 mut parent = 0;
            if (!range_material_parent(&session->proof, current.block, &parent)) { return false; }
            current = range_material_point{parent,
                        fir.block_statement_count(session->proof.f, parent)};
        }
        steps += 1;
    }
    return false;
}

fn conditional_incoming(fir.func* f, u32 target, u32 first, u32 second, u32 expected) bool {
    u32 mut count = 0;
    u32 mut b = 0;
    while (b < fir.block_count(f)) {
        u32 mut i = 0;
        u32 mut edge = 0;
        while (fir.term_targets(f, &fir.block_at(f, b)->term, i, &edge)) {
            if (edge == target) {
                if (b != first && b != second) { return false; }
                count += 1;
            }
            i += 1;
        }
        b += 1;
    }
    return count == expected;
}

// Recognize the exact switch and two source-located exits before checking either result arm.
fn conditional_region_find(conditional_proof_session* session, ast.node* n, fir.place dst,
                            conditional_region_fact mut* fact) bool {
    fir.func* f = session->proof.f;
    range_audit_operation op = session->proof.operation;
    if (range_audit_has_call(n->a) || !range_material_fixed_temp(f, dst) || dst.proj_len != 0
        || !types.type_same_shape(fir.place_type(f, dst), n->ty)) { return false; }
    u32 mut switches = 0;
    u32 mut exits = 0;
    u32 mut b = 0;
    *fact = conditional_region_fact{.source = n, .destination = dst};
    while (b < fir.block_count(f)) {
        fir.terminator* t = &fir.block_at(f, b)->term;
        if (t->stmt == op.statement_index && range_audit_loc_eq(t->exit_loc, op.exit_source)
            && range_audit_loc_eq(t->loc, n->loc)) {
            if (t->kind == fir.term_kind.tk_switch) {
                if (t->arms_len != 1) { return false; }
                fir.arm edge = fir.term_arm(f, t, 0);
                if (edge.value.kind != consts.cval_kind.cv_bool || edge.value.mag != 1
                    || edge.target == t->otherwise) { return false; }
                fact->branch = range_material_point{b, fir.block_statement_count(f, b)};
                fact->yes = edge.target;
                fact->no = t->otherwise;
                switches += 1;
            } else if (t->kind == fir.term_kind.tk_goto) {
                if (exits == 0) {
                    fact->yes_exit = b;
                    fact->join = t->target;
                } else {
                    if (t->target != fact->join) { return false; }
                    fact->no_exit = b;
                }
                exits += 1;
            } else { return false; }
        }
        b += 1;
    }
    if (switches != 1 || exits != 2 || fact->join == fact->yes || fact->join == fact->no
        || !conditional_incoming(f, fact->yes, fact->branch.block, fact->branch.block, 1)
        || !conditional_incoming(f, fact->no, fact->branch.block, fact->branch.block, 1)
        || !conditional_incoming(f, fact->join, fact->yes_exit, fact->no_exit, 2)) {
        return false;
    }
    return true;
}

// Match the arm destination store. Unrelated trailing reads cannot replace that store.
fn conditional_arm_prove(conditional_proof_session mut* session, u32 region, bool side,
                          ast.node* n, u32 entry, u32 exit, u32 depth) bool {
    fir.func* f = session->proof.f;
    conditional_region_fact fact = session->regions.items[region];
    range_material_point read = range_material_point{exit, fir.block_statement_count(f, exit)};
    range_material_point start = range_material_point{entry, 0};
    range_material_match mut matched = range_material_match{};
    if (n->kind == ast.ast_kind.k_ternary && fir.type_aggregate(n->ty)) {
        if (!conditional_region_prove(session, n, fact.destination, read, depth + 1, &matched)
            || !conditional_gap_before(session, start, matched.first)) { return false; }
        return true;
    }
    if (read.position == 0) { return false; }
    range_material_point mut at = range_material_point{};
    u32 mut count = 0;
    u32 mut p = 0;
    while (p < read.position) {
        fir.statement* write = fir.block_statement(f, exit, p);
        if (write->kind == fir.stmt_kind.st_assign
            && range_audit_place_eq(f, write->place, fact.destination)) {
            at = range_material_point{exit, p};
            count += 1;
        }
        p += 1;
    }
    if (count != 1) { return false; }
    fir.statement* s = fir.block_statement(f, at.block, at.position);
    if (s->kind != fir.stmt_kind.st_assign
        || !range_audit_place_eq(f, s->place, fact.destination)
        || !range_audit_loc_eq(s->loc, n->loc)
        || s->stmt != session->proof.operation.statement_index
        || !range_audit_loc_eq(s->exit_loc, session->proof.operation.exit_source)) {
        return false;
    }
    fir.operand mut produced = fir.operand{};
    if (s->value.kind == fir.rvalue_kind.rv_use && s->value.ops_len == 1) {
        produced = fir.operand_at(f, s->value.ops_first);
        if (n->kind == ast.ast_kind.k_ternary) {
            fir.operand_kind mut transfer = fir.operand_kind.ok_copy;
            if (fir.type_owning(n->ty)) { transfer = fir.operand_kind.ok_move; }
            if (produced.kind != transfer
                || !conditional_region_prove(session, n, produced.place, at,
                                              depth + 1, &matched)) { return false; }
        } else if (!conditional_operand(session, n, produced, at, false,
                                            depth + 1, &matched)) { return false; }
    } else if (n->kind == ast.ast_kind.k_call) {
        if (!conditional_call(session, n, s, at, depth + 1, &matched)) { return false; }
    } else { return false; }
    if (matched.emitted && !conditional_gap_before(session, start, matched.first)) { return false; }
    if (!conditional_gap_before(session, start, read)) { return false; }
    return conditional_arm_add(session, conditional_arm_fact{region, side, n, at,
                                                               fact.destination, produced});
}

fn conditional_region_prove(conditional_proof_session mut* session, ast.node* n, fir.place dst,
                             range_material_point read, u32 depth,
                             range_material_match mut* matched) bool {
    if (depth >= 64 || n->kind != ast.ast_kind.k_ternary) { return false; }
    conditional_region_fact mut fact = conditional_region_fact{};
    if (!conditional_region_find(session, n, dst, &fact)
        || !conditional_join_before(session, range_material_point{fact.join, 0}, read)) {
        return false;
    }
    u32 mut index = 0;
    if (!conditional_region_add(session, fact, &index)) { return false; }
    fir.terminator* branch = &fir.block_at(session->proof.f, fact.branch.block)->term;
    range_material_match mut predicate = range_material_match{};
    if (!conditional_operand(session, n->a, branch->cond, fact.branch, false,
                                depth + 1, &predicate)) { return false; }
    // Exit discovery is independent of arm ordering. The entry relation assigns each exit.
    bool first_yes = conditional_arm_path(session, n->b, dst, fact.yes, fact.yes_exit);
    if (!first_yes) {
        u32 swap = fact.yes_exit;
        fact.yes_exit = fact.no_exit;
        fact.no_exit = swap;
        session->regions.items[index] = fact;
    }
    if (!conditional_arm_prove(session, index, true, n->b, fact.yes, fact.yes_exit, depth + 1)
        || !conditional_arm_prove(session, index, false, n->c, fact.no, fact.no_exit, depth + 1)) {
        return false;
    }
    session->regions.items[index].proved = true;
    range_material_point mut first = fact.branch;
    if (predicate.emitted) { first = predicate.first; }
    *matched = range_material_match{true, first, range_material_point{fact.join, 0}};
    return true;
}

fn conditional_arm_path(conditional_proof_session* session, ast.node* n, fir.place dst,
                         u32 entry, u32 exit) bool {
    fir.func* f = session->proof.f;
    range_material_point end = range_material_point{exit, fir.block_statement_count(f, exit)};
    if (n->kind != ast.ast_kind.k_ternary) {
        if (conditional_gap_before(session, range_material_point{entry, 0}, end)) { return true; }
        if (end.position == 0) { return false; }
        fir.statement* s = fir.block_statement(f, exit, end.position - 1);
        return s->kind == fir.stmt_kind.st_assign && range_audit_loc_eq(s->loc, n->loc)
            && range_audit_place_eq(f, s->place, dst);
    }
    fir.place mut target = dst;
    if (!fir.type_aggregate(n->ty)) {
        if (end.position == 0) { return false; }
        fir.statement* s = fir.block_statement(f, exit, end.position - 1);
        if (s->value.kind != fir.rvalue_kind.rv_use || s->value.ops_len != 1) { return false; }
        fir.operand value = fir.operand_at(f, s->value.ops_first);
        fir.operand_kind mut transfer = fir.operand_kind.ok_copy;
        if (fir.type_owning(n->ty)) { transfer = fir.operand_kind.ok_move; }
        if (value.kind != transfer) { return false; }
        target = value.place;
    }
    conditional_region_fact mut nested = conditional_region_fact{};
    return conditional_region_find(session, n, target, &nested)
        && conditional_gap_before(session, range_material_point{entry, 0}, nested.branch)
        && conditional_gap_before(session, range_material_point{nested.join, 0}, end);
}

// Only a direct aggregate result arm can share its parent's joined destination.
fn conditional_family_parent(conditional_proof_session* session, u32 child,
                              u32 mut* parent, bool mut* present) bool {
    if (cast(child, u64) >= session->regions.len) { return false; }
    conditional_region_fact nested = session->regions.items[child];
    if (!nested.proved) { return false; }
    *present = false;
    u64 mut i = 0;
    while (i < session->regions.len) {
        conditional_region_fact outer = session->regions.items[i];
        if (i != cast(child, u64) && outer.proved
            && (cast(outer.source->b, ast.node*) == nested.source
                || cast(outer.source->c, ast.node*) == nested.source)
            && range_audit_place_eq(session->proof.f, outer.destination, nested.destination)) {
            if (*present || !fir.type_aggregate(nested.source->ty)
                || !fir.type_aggregate(outer.source->ty)
                || !types.type_same_shape(outer.source->ty, nested.source->ty)
                || outer.source->b == outer.source->c) { return false; }
            bool side = cast(outer.source->b, ast.node*) == nested.source;
            u32 mut entry = outer.no;
            u32 mut exit = outer.no_exit;
            if (side) { entry = outer.yes; exit = outer.yes_exit; }
            if (nested.join != exit
                || !conditional_gap_before(session, range_material_point{entry, 0},
                                             nested.branch)) { return false; }
            *parent = cast(i, u32);
            *present = true;
        }
        i += 1;
    }
    return true;
}

// Bounded parent traversal also rejects a cycle or an ambiguous direct result family.
fn conditional_family_root(conditional_proof_session* session, u32 region,
                            u32 mut* root) bool {
    u32 mut current = region;
    u32 mut depth = 0;
    while (depth < 64) {
        u32 mut parent = 0;
        bool mut present = false;
        if (!conditional_family_parent(session, current, &parent, &present)) { return false; }
        if (!present) { *root = current; return true; }
        current = parent;
        depth += 1;
    }
    return false;
}

// All joined-slot writes belong to exactly one arm in the destination's proved result family.
fn conditional_writes_proved(conditional_proof_session* session) bool {
    fir.func* f = session->proof.f;
    u64 mut r = 0;
    while (r < session->regions.len) {
        conditional_region_fact region = session->regions.items[r];
        u32 mut root = 0;
        if (!conditional_family_root(session, cast(r, u32), &root)) { return false; }
        u64 mut other = 0;
        while (other < session->regions.len) {
            conditional_region_fact peer = session->regions.items[other];
            if (range_audit_place_eq(f, peer.destination, region.destination)) {
                u32 mut peer_root = 0;
                if (!conditional_family_root(session, cast(other, u32), &peer_root)
                    || peer_root != root) { return false; }
            }
            other += 1;
        }
        u32 mut b = 0;
        while (b < fir.block_count(f)) {
            u32 mut p = 0;
            while (p < fir.block_statement_count(f, b)) {
                fir.statement* s = fir.block_statement(f, b, p);
                if (s->kind == fir.stmt_kind.st_assign
                    && (s->value.kind == fir.rvalue_kind.rv_addr
                        || (s->value.kind == fir.rvalue_kind.rv_slice
                            && fir.place_type(f, s->value.place)->kind == types.type_kind.k_array))
                    && s->value.place.base == fir.base_kind.bk_local
                    && s->value.place.local == region.destination.local
                    && fir.place_fixed(f, s->value.place)) { return false; }
                fir.place mut written = fir.place{};
                if (fir.stmt_writes_place(s, &written) && written.base == fir.base_kind.bk_local
                    && written.local == region.destination.local) {
                    u64 mut a = 0;
                    u32 mut count = 0;
                    while (a < session->arms.len) {
                        conditional_arm_fact arm = session->arms.items[a];
                        if (arm.write.block == b && arm.write.position == p
                            && range_audit_place_eq(f, arm.destination, written)) {
                            if (cast(arm.region, u64) >= session->regions.len) { return false; }
                            conditional_region_fact owner = session->regions.items[arm.region];
                            ast.node* mut source = owner.source->c;
                            if (arm.side) { source = owner.source->b; }
                            if (arm.source != source
                                || !range_audit_place_eq(f, arm.destination, owner.destination)) {
                                return false;
                            }
                            u32 mut arm_root = 0;
                            if (!conditional_family_root(session, arm.region, &arm_root)
                                || arm_root != root) { return false; }
                            count += 1;
                        }
                        a += 1;
                    }
                    if (count != 1) { return false; }
                }
                p += 1;
            }
            b += 1;
        }
        r += 1;
    }
    return true;
}

// The root conditional proves its joined result before the range capture.
fn conditional_capture_prove(conditional_proof_session mut* session, ast.node* n,
                              u32 body, fir.range_capture mut* expected) bool {
    fir.func* f = session->proof.f;
    range_audit_operation op = session->proof.operation;
    u32 mut found = 0;
    fir.place mut captured = fir.place{};
    u32 mut p = 0;
    while (p < fir.block_statement_count(f, body)) {
        fir.statement* s = fir.block_statement(f, body, p);
        if (s->kind == fir.stmt_kind.st_assign && s->stmt == op.statement_index
            && s->place.base == fir.base_kind.bk_local && s->place.proj_len == 0
            && fir.local_at(f, s->place.local)->sym == cast(n->sym, ast.sym*)
            && range_audit_loc_eq(s->loc, n->b->loc)
            && range_audit_loc_eq(s->exit_loc, op.exit_source)
            && s->value.kind == fir.rvalue_kind.rv_use && s->value.ops_len == 1) {
            fir.operand element = fir.operand_at(f, s->value.ops_first);
            if (element.kind != fir.operand_kind.ok_copy || element.place.proj_len == 0
                || fir.place_projection(f, element.place, element.place.proj_len - 1).kind
                    != fir.proj_kind.pj_index) { return false; }
            captured = element.place;
            captured.proj_len -= 1;
            found += 1;
        }
        p += 1;
    }
    if (found != 1) { return false; }
    range_material_point mut read = range_material_point{op.block, op.position};
    range_material_match mut matched = range_material_match{};
    fir.place mut original = captured;
    if (fir.type_owning(n->b->ty) && n->b->ty->kind != types.type_kind.k_array) {
        range_material_point mut at = range_material_point{};
        fir.statement* mut copy = null;
        if (!range_material_definition(&session->proof, captured, read, &at, &copy)
            || copy->value.kind != fir.rvalue_kind.rv_use || copy->value.ops_len != 1
            || !range_audit_loc_eq(copy->loc, n->b->loc)) { return false; }
        fir.operand value = fir.operand_at(f, copy->value.ops_first);
        if (value.kind != fir.operand_kind.ok_copy) { return false; }
        original = value.place;
        read = at;
    }
    bool mut folded = false;
    ast.node* expression = n->b;
    if (expression->ty->kind == types.type_kind.k_string
        && expression->a->kind == ast.ast_kind.k_bool
        && expression->b->kind == ast.ast_kind.k_string
        && expression->c->kind == ast.ast_kind.k_string) {
        range_material_point mut at = range_material_point{};
        fir.statement* mut constant = null;
        if (!range_material_definition(&session->proof, original, read, &at, &constant)
            || !range_audit_loc_eq(constant->loc, expression->loc)
            || constant->value.kind != fir.rvalue_kind.rv_use || constant->value.ops_len != 1) {
            return false;
        }
        fir.operand actual = fir.operand_at(f, constant->value.ops_first);
        ast.node* mut selected = expression->c;
        if (expression->a->ival != 0) { selected = expression->b; }
        folded = actual.kind == fir.operand_kind.ok_const
            && range_material_constant(selected, actual.value);
        if (!folded) { return false; }
    }
    if (!folded && (!conditional_region_prove(session, expression, original, read, 0, &matched)
        || !conditional_writes_proved(session))) { return false; }
    fir.range_capture_kind mut kind = fir.range_capture_kind.borrowed_header;
    bool mut protected = true;
    if (n->b->ty->kind == types.type_kind.k_array) {
        kind = fir.range_capture_kind.non_owning_array_copy;
        protected = false;
        if (fir.type_owning(n->b->ty)) {
            kind = fir.range_capture_kind.owning_fixed_array_place;
            protected = true;
        }
    }
    *expected = fir.range_capture{.source = n->b->loc, .captured = captured,
                                  .kind = kind, .original = original,
                                  .original_present = protected};
    return true;
}

// A proved region supplies both paths before traversal continues at its branch gap.
// Stack matches retain operand intervals. They borrow no growing vector element.
fn conditional_order_before(conditional_proof_session* session, range_material_point before,
                             range_material_point read) bool {
    range_material_point mut current = read;
    u32 mut steps = 0;
    while (steps < fir.block_count(session->proof.f)) {
        if (current.block == before.block) {
            if (before.position < current.position) { return true; }
            u64 mut r = 0;
            while (r < session->regions.len) {
                conditional_region_fact region = session->regions.items[r];
                if (region.proved && region.join == before.block && before.position == 0
                    && current.position == 0) { return true; }
                r += 1;
            }
            return false;
        }
        bool mut joined = false;
        u64 mut r = 0;
        while (r < session->regions.len) {
            conditional_region_fact region = session->regions.items[r];
            if (region.proved && region.join == current.block) {
                current = region.branch;
                joined = true;
                break;
            }
            r += 1;
        }
        if (!joined) {
            u32 mut parent = 0;
            if (!range_material_parent(&session->proof, current.block, &parent)) { return false; }
            current = range_material_point{parent,
                        fir.block_statement_count(session->proof.f, parent)};
        }
        steps += 1;
    }
    return false;
}

fn conditional_join_before(conditional_proof_session* session, range_material_point before,
                            range_material_point read) bool {
    return conditional_gap_before(session, before, read);
}

fn conditional_source_present(ast.node* n) bool {
    if (n == null) { return false; }
    if (n->kind == ast.ast_kind.k_ternary) { return true; }
    if (conditional_source_present(n->a) || conditional_source_present(n->b)
        || conditional_source_present(n->c) || conditional_source_present(n->d)) { return true; }
    u64 mut i = 0;
    while (i < ast.ast_len(n)) {
        if (conditional_source_present(ast.ast_child(n, i))) { return true; }
        i += 1;
    }
    return false;
}

fn conditional_definition(conditional_proof_session mut* session, fir.place target,
                              range_material_point read, range_material_point mut* at,
                              fir.statement* mut* definition) bool {
    range_material_context* proof = &session->proof;
    fir.func* f = proof->f;
    if (!range_audit_place_valid(f, target) || target.base != fir.base_kind.bk_local
        || target.proj_len != 0 || fir.local_at(f, target.local)->kind != fir.local_kind.lk_temp) {
        return false;
    }
    u32 mut count = 0;
    u32 mut b = 0;
    while (b < fir.block_count(f)) {
        u32 mut p = 0;
        while (p < fir.block_statement_count(f, b)) {
            fir.statement* s = fir.block_statement(f, b, p);
            // An address or array slice permits writes that name another local.
            if (s->kind == fir.stmt_kind.st_assign
                && (s->value.kind == fir.rvalue_kind.rv_addr
                    || (s->value.kind == fir.rvalue_kind.rv_slice
                        && fir.place_type(f, s->value.place)->kind == types.type_kind.k_array))
                && s->value.place.base == fir.base_kind.bk_local
                && s->value.place.local == target.local && fir.place_fixed(f, s->value.place)) {
                return false;
            }
            fir.place mut written = fir.place{};
            if (fir.stmt_writes_place(s, &written) && written.base == fir.base_kind.bk_local
                && written.local == target.local) {
                if (s->kind != fir.stmt_kind.st_assign || written.proj_len != 0) { return false; }
                *at = range_material_point{.block = b, .position = p};
                *definition = s;
                count += 1;
            }
            p += 1;
        }
        b += 1;
    }
    if (count != 1 || (*definition)->stmt != proof->operation.statement_index
        || !range_audit_loc_eq((*definition)->exit_loc, proof->operation.exit_source)) {
        return false;
    }
    return conditional_order_before(session, *at, read);
}


fn conditional_operand(conditional_proof_session mut* session, ast.node* n, fir.operand actual,
                           range_material_point read, bool later, u32 depth,
                           range_material_match mut* matched) bool {
    range_material_context* proof = &session->proof;
    if (n == null || depth >= 64) { return false; }
    if (actual.kind == fir.operand_kind.ok_const) {
        return range_material_constant(n, actual.value);
    }
    if (!range_audit_place_valid(proof->f, actual.place)) { return false; }
    if (later && !range_material_fixed_temp(proof->f, actual.place)) { return false; }
    if (later && actual.place.proj_len == 0) {
        range_material_point mut at = range_material_point{};
        fir.statement* mut held = null;
        if (conditional_definition(session, actual.place, read, &at, &held)
            && held->value.kind == fir.rvalue_kind.rv_use && held->value.ops_len == 1
            && range_audit_loc_eq(held->loc, n->loc)) {
            fir.operand original = fir.operand_at(proof->f, held->value.ops_first);
            if (original.kind == fir.operand_kind.ok_const || original.kind != actual.kind
                || range_material_fixed_temp(proof->f, original.place)) { return false; }
            if (!conditional_operand(session, n, original, at, false, depth + 1, matched)) {
                return false;
            }
            if (!matched->emitted) { matched->first = at; }
            matched->emitted = true;
            matched->last = at;
            return true;
        }
    }
    bool moved = n->kind == ast.ast_kind.k_call && (n->ann & check.ANN_MOVE) != 0;
    if (moved) {
        return actual.kind == fir.operand_kind.ok_move
            && conditional_place(session, ast.ast_child(n, 0), actual.place, read, false,
                                     depth + 1, matched);
    }
    bool owns_result = !designates(n) && fir.type_owning(n->ty);
    if ((actual.kind == fir.operand_kind.ok_move) != owns_result) { return false; }
    return conditional_place(session, n, actual.place, read, false, depth + 1, matched);
}


fn conditional_call(conditional_proof_session mut* session, ast.node* n, fir.statement* s,
                        range_material_point at, u32 depth,
                        range_material_match mut* matched) bool {
    range_material_context* proof = &session->proof;
    if (s->value.kind != fir.rvalue_kind.rv_call || builtin_call(n)
        || cast(s->value.ops_len, u64) != ast.ast_len(n) || !range_audit_loc_eq(s->loc, n->loc)) {
        return false;
    }
    u32 mut copies = 0;
    u32 mut b = 0;
    while (b < fir.block_count(proof->f)) {
        u32 mut p = 0;
        while (p < fir.block_statement_count(proof->f, b)) {
            fir.statement* other = fir.block_statement(proof->f, b, p);
            if (other->kind == fir.stmt_kind.st_assign
                && other->value.kind == fir.rvalue_kind.rv_call
                && other->stmt == s->stmt && range_audit_loc_eq(other->loc, n->loc)
                && range_audit_loc_eq(other->exit_loc, s->exit_loc)) { copies += 1; }
            p += 1;
        }
        b += 1;
    }
    if (copies != 1) { return false; }
    range_material_point mut first = at;
    bool mut later = false;
    u64 mut i = ast.ast_len(n);
    while (i > 0) {
        i -= 1;
        ast.node* arg = ast.ast_child(n, i);
        fir.operand actual = fir.operand_at(proof->f, s->value.ops_first + cast(i, u32));
        range_material_match mut child = range_material_match{};
        if (!conditional_operand(session, arg, actual, at, later, depth + 1, &child)) {
            return false;
        }
        if (child.emitted) {
            if (!conditional_order_before(session, child.last, first)) { return false; }
            first = child.first;
        }
        later = later || contains_writer(arg);
    }
    ast.sym* callee = n->a->sym;
    if (callee != null && (callee->kind == ast.sym_kind.s_fn
        || callee->kind == ast.sym_kind.s_extern_fn)) {
        fir.callee_kind mut expected = fir.callee_kind.cl_fn;
        if (callee->kind == ast.sym_kind.s_extern_fn) { expected = fir.callee_kind.cl_extern; }
        if (s->value.callee != expected || s->value.callee_sym != callee) { return false; }
    } else {
        range_material_match mut value = range_material_match{};
        if (s->value.callee != fir.callee_kind.cl_value
            || !conditional_operand(session, n->a, s->value.callee_op, at, later,
                                       depth + 1, &value)) {
            return false;
        }
        if (value.emitted) {
            if (!conditional_order_before(session, value.last, first)) { return false; }
            first = value.first;
        }
    }
    *matched = range_material_match{.emitted = true, .first = first, .last = at};
    return true;
}


fn conditional_bound(conditional_proof_session mut* session, ast.node* n, fir.operand actual,
                         diag.loc source, range_material_point read, u32 depth,
                         range_material_match mut* matched) bool {
    range_material_context* proof = &session->proof;
    if (actual.kind != fir.operand_kind.ok_copy) { return false; }
    range_material_point mut at = range_material_point{};
    fir.statement* mut casted = null;
    if (!conditional_definition(session, actual.place, read, &at, &casted)
        || casted->value.kind != fir.rvalue_kind.rv_cast || casted->value.ops_len != 1
        || casted->value.ty->kind != types.type_kind.k_prim
        || casted->value.ty->prim != prim.prim_kind.prim_u64
        || !range_audit_loc_eq(casted->loc, source)) { return false; }
    if (!conditional_operand(session, n, fir.operand_at(proof->f, casted->value.ops_first),
                                at, false, depth + 1, matched)) { return false; }
    if (!matched->emitted) { matched->first = at; }
    matched->emitted = true;
    matched->last = at;
    return true;
}


fn conditional_deref(conditional_proof_session mut* session, ast.node* n, fir.place p,
                         range_material_point read, u32 depth,
                        range_material_match mut* matched) bool {
    range_material_context* proof = &session->proof;
    if (p.proj_len == 0
        || fir.place_projection(proof->f, p, p.proj_len - 1).kind != fir.proj_kind.pj_deref) {
        return false;
    }
    fir.place mut pointer = p;
    pointer.proj_len -= 1;
    return conditional_operand(session, n, fir.operand_copy(pointer), read, false,
                                  depth + 1, matched);
}


fn conditional_place(conditional_proof_session mut* session, ast.node* n, fir.place p,
                         range_material_point read, bool held, u32 depth,
                         range_material_match mut* matched) bool {
    range_material_context* proof = &session->proof;
    if (n == null || depth >= 64 || !range_audit_place_valid(proof->f, p)) { return false; }
    fir.func* f = proof->f;
    if (n->kind == ast.ast_kind.k_ternary) {
        return conditional_region_prove(session, n, p, read, depth + 1, matched);
    }
    if (held && p.base == fir.base_kind.bk_local && p.proj_len == 1
        && fir.place_projection(f, p, 0).kind == fir.proj_kind.pj_deref) {
        range_material_point mut at = range_material_point{};
        fir.statement* mut address = null;
        if (conditional_definition(session, fir.place_local(p.local), read, &at, &address)
            && address->value.kind == fir.rvalue_kind.rv_addr
            && range_audit_loc_eq(address->loc, n->loc)) {
            if (!fir.place_indirect(f, address->value.place)
                || !conditional_place(session, n, address->value.place, at, false,
                                          depth + 1, matched)) { return false; }
            if (!matched->emitted) { matched->first = at; }
            matched->emitted = true;
            matched->last = at;
            return true;
        }
    }
    if (held && fir.place_indirect(f, p)) { return false; }
    if ((n->kind == ast.ast_kind.k_ident || n->kind == ast.ast_kind.k_field) && n->sym != null) {
        ast.sym* source = n->sym;
        if (source->kind == ast.sym_kind.s_global || source->kind == ast.sym_kind.s_const) {
            return p.base == fir.base_kind.bk_global && p.global == source && p.proj_len == 0;
        }
        if (source->kind == ast.sym_kind.s_param || source->kind == ast.sym_kind.s_local) {
            return p.base == fir.base_kind.bk_local && p.proj_len == 0
                && fir.local_at(f, p.local)->sym == source;
        }
    }
    if (n->kind == ast.ast_kind.k_field || n->kind == ast.ast_kind.k_arrow) {
        u32 mut field = 0;
        if (p.proj_len == 0 || !range_material_field(n, &field)) { return false; }
        fir.projection actual = fir.place_projection(f, p, p.proj_len - 1);
        if (actual.kind != fir.proj_kind.pj_field || actual.field != field) { return false; }
        fir.place mut base = p;
        base.proj_len -= 1;
        if (n->kind == ast.ast_kind.k_arrow) {
            return conditional_deref(session, n->a, base, read, depth + 1, matched);
        }
        return conditional_place(session, n->a, base, read, false, depth + 1, matched);
    }
    if (n->kind == ast.ast_kind.k_unary && cast(n->op, lexer.tok_kind) == lexer.tok_kind.star) {
        return conditional_deref(session, n->a, p, read, depth + 1, matched);
    }
    if (n->kind == ast.ast_kind.k_index) {
        if (p.proj_len == 0) { return false; }
        fir.projection index = fir.place_projection(f, p, p.proj_len - 1);
        if (index.kind != fir.proj_kind.pj_index) { return false; }
        range_material_match mut bound = range_material_match{};
        if (!conditional_bound(session, n->b, fir.operand_copy(fir.place_local(index.index)),
                                  n->loc, read, depth + 1, &bound)) { return false; }
        fir.place mut base = p;
        base.proj_len -= 1;
        range_material_match mut root = range_material_match{};
        bool writer = contains_writer(n->b);
        if (!conditional_place(session, n->a, base, read, writer, depth + 1, &root)) {
            return false;
        }
        if (root.emitted && !conditional_order_before(session, root.last, bound.first)) {
            return false;
        }
        *matched = bound;
        if (root.emitted) { matched->first = root.first; }
        return true;
    }
    range_material_point mut at = range_material_point{};
    fir.statement* mut definition = null;
    if (!conditional_definition(session, p, read, &at, &definition)
        || !range_audit_loc_eq(definition->loc, n->loc)
        || !types.type_same_shape(fir.place_type(f, p), n->ty)) { return false; }
    if (n->kind == ast.ast_kind.k_call) {
        return conditional_call(session, n, definition, at, depth + 1, matched);
    }
    fir.rvalue value = definition->value;
    if (n->kind == ast.ast_kind.k_unary && cast(n->op, lexer.tok_kind) == lexer.tok_kind.amp) {
        if (value.kind != fir.rvalue_kind.rv_addr || value.is_mut != n->ty->is_mut
            || !conditional_place(session, n->a, value.place, at, false, depth + 1, matched)) {
            return false;
        }
    } else if (n->kind == ast.ast_kind.k_cast) {
        if (value.kind != fir.rvalue_kind.rv_cast || value.ops_len != 1
            || !types.type_equal(value.ty, n->ty)
            || !conditional_operand(session, n->a, fir.operand_at(f, value.ops_first),
                                        at, false, depth + 1, matched)) { return false; }
    } else if (n->kind == ast.ast_kind.k_span) {
        if (!conditional_slice(session, n, value, at, depth + 1, matched)) { return false; }
    } else { return false; }
    if (!matched->emitted) { matched->first = at; }
    matched->emitted = true;
    matched->last = at;
    return true;
}


fn conditional_slice(conditional_proof_session mut* session, ast.node* n, fir.rvalue value,
                         range_material_point at, u32 depth,
                        range_material_match mut* matched) bool {
    range_material_context* proof = &session->proof;
    fir.func* f = proof->f;
    bool pointer = n->a->ty->kind == types.type_kind.k_ptr;
    u32 mut expected = 2;
    if (pointer) { expected = 3; }
    if (value.ops_len != expected
        || (pointer && value.kind != fir.rvalue_kind.rv_slice_ptr)
        || (!pointer && value.kind != fir.rvalue_kind.rv_slice)) { return false; }
    range_material_match mut base = range_material_match{};
    bool writer = contains_writer(n->b) || contains_writer(n->c);
    range_material_point mut first = at;
    range_material_match mut low = range_material_match{};
    range_material_match mut high = range_material_match{};
    u32 mut offset = 0;
    if (pointer) { offset = 1; }
    fir.operand lo = fir.operand_at(f, value.ops_first + offset);
    fir.operand hi = fir.operand_at(f, value.ops_first + offset + 1);
    if (n->c != null) {
        if (pointer) {
            if (!conditional_operand(session, n->c, hi, at, false, depth + 1, &high)) {
                return false;
            }
        } else if (!conditional_bound(session, n->c, hi, n->loc, at, depth + 1, &high)) {
            return false;
        }
    } else {
        if (n->a->ty->kind == types.type_kind.k_array) {
            if (hi.kind != fir.operand_kind.ok_const || hi.value.kind != fir.const_kind.ck_int
                || consts.cv_is_neg(hi.value.value) || hi.value.value.mag != n->a->ty->len) {
                return false;
            }
        } else {
            if (hi.kind != fir.operand_kind.ok_copy
                || hi.place.proj_len != value.place.proj_len + 1) {
                return false;
            }
            fir.projection len = fir.place_projection(f, hi.place, hi.place.proj_len - 1);
            fir.place mut header = hi.place;
            header.proj_len -= 1;
            if (len.kind != fir.proj_kind.pj_field || len.field != LEN_FIELD
                || !range_audit_place_eq(f, header, value.place)) { return false; }
        }
    }
    if (n->b != null) {
        if (pointer) {
            if (!conditional_operand(session, n->b, lo, at, contains_writer(n->c),
                                        depth + 1, &low)) { return false; }
        } else if (!conditional_bound(session, n->b, lo, n->loc, at, depth + 1, &low)) {
            return false;
        }
    } else if (lo.kind != fir.operand_kind.ok_const || lo.value.kind != fir.const_kind.ck_int
        || consts.cv_is_neg(lo.value.value) || lo.value.value.mag != 0) { return false; }
    if (pointer) {
        if (!conditional_operand(session, n->a, fir.operand_at(f, value.ops_first),
                                    at, writer, depth + 1, &base)) { return false; }
    } else if (!conditional_place(session, n->a, value.place, at, writer, depth + 1, &base)) {
        return false;
    }
    if (base.emitted) { first = base.first; }
    if (base.emitted && low.emitted && !conditional_order_before(session, base.last, low.first)) {
        return false;
    }
    if (low.emitted && high.emitted && !conditional_order_before(session, low.last, high.first)) {
        return false;
    }
    if (base.emitted && !low.emitted && high.emitted
        && !conditional_order_before(session, base.last, high.first)) { return false; }
    if (!base.emitted && low.emitted) { first = low.first; }
    if (!base.emitted && !low.emitted && high.emitted) { first = high.first; }
    *matched = range_material_match{.emitted = true, .first = first, .last = at};
    return true;
}


fn conditional_wrapped_capture(conditional_proof_session mut* session, ast.node* n,
                                u32 body, fir.range_capture mut* expected) bool {
    fir.func* f = session->proof.f;
    range_audit_operation op = session->proof.operation;
    u32 mut found = 0;
    u32 mut p = 0;
    fir.place mut captured = fir.place{};
    while (p < fir.block_statement_count(f, body)) {
        fir.statement* s = fir.block_statement(f, body, p);
        if (s->kind == fir.stmt_kind.st_assign && s->stmt == op.statement_index
            && s->place.base == fir.base_kind.bk_local && s->place.proj_len == 0
            && fir.local_at(f, s->place.local)->sym == cast(n->sym, ast.sym*)
            && range_audit_loc_eq(s->loc, n->b->loc)
                && range_audit_loc_eq(s->exit_loc, op.exit_source)
            && s->value.kind == fir.rvalue_kind.rv_use && s->value.ops_len == 1) {
            fir.operand element = fir.operand_at(f, s->value.ops_first);
            if (element.kind != fir.operand_kind.ok_copy || element.place.proj_len == 0
                || fir.place_projection(f, element.place, element.place.proj_len - 1).kind
                    != fir.proj_kind.pj_index) { return false; }
            captured = element.place;
            captured.proj_len -= 1;
            found += 1;
        }
        p += 1;
    }
    if (found != 1) { return false; }
    range_material_point read = range_material_point{.block = op.block, .position = op.position};
    range_material_match mut matched = range_material_match{};
    fir.range_capture mut binding = fir.range_capture{.source = n->b->loc, .captured = captured};
    if (n->b->ty->kind == types.type_kind.k_array && fir.type_owning(n->b->ty)) {
        if (!conditional_place(session, n->b, captured, read, true, 0, &matched)) {
            return false;
        }
        binding.kind = fir.range_capture_kind.owning_fixed_array_place;
        binding.original = captured;
        binding.original_present = true;
    } else {
        binding.kind = fir.range_capture_kind.borrowed_header;
        binding.original_present = true;
        if (n->b->ty->kind == types.type_kind.k_array) {
            binding.kind = fir.range_capture_kind.non_owning_array_copy;
            binding.original_present = false;
        }
        if (fir.type_owning(n->b->ty) || designates(n->b)) {
            range_material_point mut at = range_material_point{};
            fir.statement* mut copy = null;
            if (!conditional_definition(session, captured, read, &at, &copy)
                || copy->value.kind != fir.rvalue_kind.rv_use || copy->value.ops_len != 1
                || !range_audit_loc_eq(copy->loc, n->b->loc)) { return false; }
            fir.operand source = fir.operand_at(f, copy->value.ops_first);
            if (source.kind != fir.operand_kind.ok_copy
                || !conditional_place(session, n->b, source.place, at, true, 0, &matched)) {
                return false;
            }
            binding.original = source.place;
        } else {
            if (!conditional_place(session, n->b, captured, read, false, 0, &matched)) {
                return false;
            }
            binding.original = captured;
        }
    }
    if (!conditional_writes_proved(session)) { return false; }
    *expected = binding;
    return true;
}


fn range_audit_source_sym(ast.node* n) ast.sym* {
    if (n == null) { return null; }
    if (n->kind == ast.ast_kind.k_ident) { return n->sym; }
    if (n->sym != null && (n->sym->kind == ast.sym_kind.s_global
        || n->sym->kind == ast.sym_kind.s_const)) { return n->sym; }
    return range_audit_source_sym(n->a);
}

// A held address names the source storage through one temporary address operation.
fn range_audit_place_root(fir.func* f, fir.place p, ast.sym* source, u32 depth) bool {
    if (source == null || depth >= 8) { return false; }
    if (p.base == fir.base_kind.bk_global) { return p.global == source; }
    if (p.local >= fir.local_count(f)) { return false; }
    fir.local* slot = fir.local_at(f, p.local);
    if (slot->sym == source) { return true; }
    if (slot->kind != fir.local_kind.lk_temp || p.proj_len == 0
        || fir.place_projection(f, p, 0).kind != fir.proj_kind.pj_deref) { return false; }
    u32 mut b = 0;
    while (b < fir.block_count(f)) {
        u32 mut at = 0;
        while (at < fir.block_statement_count(f, b)) {
            fir.statement* s = fir.block_statement(f, b, at);
            if (s->kind == fir.stmt_kind.st_assign
                && s->place.base == fir.base_kind.bk_local && s->place.local == p.local
                && s->place.proj_len == 0 && s->value.kind == fir.rvalue_kind.rv_addr) {
                return range_audit_place_root(f, s->value.place, source, depth + 1);
            }
            at += 1;
        }
        b += 1;
    }
    return false;
}

fn range_audit_header_copy(fir.func* f, range_audit_operation op,
                           fir.range_capture binding) bool {
    u32 mut p = 0;
    while (p < op.position) {
        fir.statement* s = fir.block_statement(f, op.block, p);
        if (s->kind == fir.stmt_kind.st_assign
            && range_audit_place_eq(f, s->place, binding.captured)
            && s->value.kind == fir.rvalue_kind.rv_use && s->value.ops_len == 1) {
            fir.operand source = fir.operand_at(f, s->value.ops_first);
            if (source.kind == fir.operand_kind.ok_copy
                && range_audit_place_eq(f, source.place, binding.original)) { return true; }
        }
        p += 1;
    }
    return false;
}

fn range_audit_binding(fir.func* f, ast.node* n, range_audit_operation op,
                       range_capture_candidate* c, u32 mut* body_block,
                       range_audit_fault mut* fault) bool {
    fir.range_capture binding = c->binding;
    fir.range_capture_kind mut expected = fir.range_capture_kind.borrowed_header;
    if (n->b->ty->kind == types.type_kind.k_array) {
        expected = fir.range_capture_kind.non_owning_array_copy;
        if (fir.type_owning(n->b->ty)) {
            expected = fir.range_capture_kind.owning_fixed_array_place;
        }
    }
    if (binding.kind != expected || !range_audit_loc_eq(binding.source, n->b->loc)
        || !range_audit_place_valid(f, binding.captured)
        || !range_audit_element(f, n, op.statement_index, binding.captured, body_block)) {
        *fault = range_audit_fault.capture;
        return false;
    }
    bool protected = expected != fir.range_capture_kind.non_owning_array_copy;
    if (binding.original_present != protected) {
        *fault = range_audit_fault.protected_path;
        return false;
    }
    if (!protected) { return true; }
    if (!range_audit_place_valid(f, binding.original)) {
        *fault = range_audit_fault.protected_path;
        return false;
    }
    if (expected == fir.range_capture_kind.owning_fixed_array_place) {
        if (!range_audit_place_eq(f, binding.original, binding.captured)) {
            *fault = range_audit_fault.protected_path;
            return false;
        }
    } else if (fir.type_owning(n->b->ty) || designates(n->b)) {
        if (!range_audit_header_copy(f, op, binding)) {
            *fault = range_audit_fault.protected_path;
            return false;
        }
    } else if (!range_audit_place_eq(f, binding.original, binding.captured)) {
        *fault = range_audit_fault.protected_path;
        return false;
    }
    ast.sym* source = range_audit_source_sym(n->b);
    if (source != null && designates(n->b) && !range_audit_has_call(n->b)
        && !conditional_source_present(n->b)
        && !range_audit_place_root(f, binding.original, source, 0)) {
        *fault = range_audit_fault.protected_path;
        return false;
    }
    return true;
}

// A dead range variable starts the body-scope dead run after all body defers.
fn range_audit_cleanup_end(fir.func* f, ast.node* n, fir.range_boundary start,
                           u32 mut* end) bool {
    if (start.position >= fir.block_statement_count(f, start.block)) { return false; }
    fir.statement* first = fir.block_statement(f, start.block, start.position);
    if (first->kind != fir.stmt_kind.st_dead || first->local >= fir.local_count(f)
        || fir.local_at(f, first->local)->sym != cast(n->sym, ast.sym*)
        || !range_audit_loc_eq(first->loc, start.source)) { return false; }
    u32 mut p = start.position + 1;
    while (p < fir.block_statement_count(f, start.block)) {
        fir.statement* next = fir.block_statement(f, start.block, p);
        if (next->kind != fir.stmt_kind.st_dead || next->local >= fir.local_count(f)
            || !range_audit_loc_eq(next->loc, first->loc)) { break; }
        ast.sym* source_sym = fir.local_at(f, next->local)->sym;
        if (source_sym == null || source_sym->node == null
            || !range_audit_contains(n->c, source_sym->node)) {
            break;
        }
        p += 1;
    }
    *end = p;
    return true;
}

fn range_audit_body(fir.func* f, ast.node* n, range_audit_operation op,
                       u32 mut* body) bool {
    fir.terminator* enter = &fir.block_at(f, op.block)->term;
    if (enter->kind != fir.term_kind.tk_goto) { return false; }
    fir.terminator* head = &fir.block_at(f, enter->target)->term;
    if (head->kind != fir.term_kind.tk_switch || head->arms_len != 1
        || head->stmt != op.statement_index || !range_audit_loc_eq(head->loc, n->loc)
        || !range_audit_loc_eq(head->exit_loc, op.exit_source)) { return false; }
    fir.arm a = fir.term_arm(f, head, 0);
    if (!consts.cv_eq(a.value, consts.cv_from_bool(true))) { return false; }
    if (fir.block_statement_count(f, a.target) == 0) { return false; }
    fir.statement* live = fir.block_statement(f, a.target, 0);
    if (live->kind != fir.stmt_kind.st_live || live->local >= fir.local_count(f)
        || fir.local_at(f, live->local)->sym != cast(n->sym, ast.sym*)
        || live->stmt != op.statement_index || !range_audit_loc_eq(live->loc, n->name_loc)
        || !range_audit_loc_eq(live->exit_loc, op.exit_source)) { return false; }
    *body = a.target;
    return true;
}

// Control flow and source intervals must identify the same dead gaps.
// Stop each path at its first matching dead marker or a different body entry.
fn range_audit_required_gaps(fir.func* f, range_audit_source_range source,
                               u32 body_block, range_audit_replay* walk, u32 range,
                               range_audit_operation_vec mut* gaps) bool {
    u32 blocks = fir.block_count(f);
    bool mut@ own seen = new(bool, blocks);
    defer del(seen);
    u32 mut@ own pending = new(u32, blocks);
    defer del(pending);
    u32 mut count = 1;
    pending[0] = body_block;
    seen[body_block] = true;
    while (count > 0) {
        count -= 1;
        u32 b = pending[count];
        bool mut stopped = false;
        u32 mut p = 0;
        while (p < fir.block_statement_count(f, b)) {
            fir.statement* s = fir.block_statement(f, b, p);
            bool named = (s->kind == fir.stmt_kind.st_live || s->kind == fir.stmt_kind.st_dead)
                && s->local < fir.local_count(f)
                && fir.local_at(f, s->local)->sym == cast(source.node->sym, ast.sym*);
            if (named && s->kind == fir.stmt_kind.st_live
                && (b != body_block || s->stmt != source.first)) { stopped = true; break; }
            if (named && s->kind == fir.stmt_kind.st_dead) {
                if (s->stmt < source.first || s->stmt > source.last
                    || !range_audit_loc_eq(s->exit_loc, source.exit_source)) { return false; }
                u64 mut matches = 0;
                u64 mut i = 0;
                while (i < walk->gaps.len) {
                    range_audit_operation expected = walk->gaps.items[i];
                    if (expected.declaration == range && expected.statement_index == s->stmt
                        && range_audit_loc_eq(expected.exit_source, s->loc)) { matches += 1; }
                    i += 1;
                }
                if (matches != 1) { return false; }
                range_audit_operation_add(gaps,
                    range_audit_operation{b, p, s->stmt, 0, s->loc});
                stopped = true;
                break;
            }
            p += 1;
        }
        if (!stopped) {
            u32 mut edge = 0;
            u32 mut target = 0;
            while (fir.term_targets(f, &fir.block_at(f, b)->term, edge, &target)) {
                if (!seen[target]) {
                    seen[target] = true;
                    pending[count] = target;
                    count += 1;
                }
                edge += 1;
            }
        }
    }
    // Disconnected source statements also produce cleanup. Count their source interval.
    u32 mut b = 0;
    while (b < blocks) {
        u32 mut p = 0;
        while (p < fir.block_statement_count(f, b)) {
            fir.statement* s = fir.block_statement(f, b, p);
            if (s->kind == fir.stmt_kind.st_dead && s->local < fir.local_count(f)
                && fir.local_at(f, s->local)->sym == cast(source.node->sym, ast.sym*)
                && s->stmt >= source.first && s->stmt <= source.last) {
                u64 mut matches = 0;
                u64 mut i = 0;
                while (i < gaps->len) {
                    if (gaps->items[i].block == b && gaps->items[i].position == p) { matches += 1; }
                    i += 1;
                }
                if (matches != 1) { return false; }
            }
            p += 1;
        }
        b += 1;
    }
    u64 mut expected_count = 0;
    u64 mut i = 0;
    while (i < walk->gaps.len) {
        range_audit_operation expected = walk->gaps.items[i];
        if (expected.declaration == range) {
            expected_count += 1;
            u64 mut matches = 0;
            u64 mut gap = 0;
            while (gap < gaps->len) {
                if (gaps->items[gap].statement_index == expected.statement_index
                    && range_audit_loc_eq(gaps->items[gap].exit_source, expected.exit_source)) {
                    matches += 1;
                }
                gap += 1;
            }
            if (matches != 1) { return false; }
        }
        i += 1;
    }
    return expected_count == gaps->len;
}

fn range_audit_dead_gaps_covered(range_audit_operation_vec* gaps,
                                 range_candidate_set* proposed, u32 expansion) bool {
    u64 mut gap = 0;
    while (gap < gaps->len) {
        u64 mut matches = 0;
        u64 mut i = 0;
        while (i < proposed->boundaries.len) {
            range_boundary_candidate* c = &proposed->boundaries.items[i];
            if (c->expansion == expansion
                && c->boundary.kind == fir.range_boundary_kind.body_cleanup
                && c->boundary.block == gaps->items[gap].block
                && c->boundary.position == gaps->items[gap].position) { matches += 1; }
            i += 1;
        }
        if (matches != 1) { return false; }
        gap += 1;
    }
    return true;
}

// Match boundary gaps to FIR live and dead markers, not to candidate counts alone.
fn range_audit_boundaries(fir.func* f, ast.node* n, range_audit_operation op,
                          range_candidate_set* proposed, u32 expansion,
                          u32 body_block, range_audit_source_range source,
                          range_audit_replay* walk, range_source_audit mut* out,
                          range_audit_row mut* row) bool {
    range_audit_operation_vec mut gaps = range_audit_operation_vec{};
    defer del(gaps.items);
    if (!range_audit_required_gaps(f, source, body_block, walk, expansion, &gaps)) { return false; }
    u32 mut capture_count = 0;
    u32 mut entry_count = 0;
    u32 mut cleanup_count = 0;
    u32 mut exit_count = 0;
    u32 mut outer_count = 0;
    u32 mut cleanup_phase = 0;
    u32 mut cleanup_end = 0;
    fir.range_boundary mut cleanup = fir.range_boundary{};
    fir.range_boundary mut loan_exit = fir.range_boundary{};
    row->boundaries_first = cast(out->boundaries.len, u32);
    u64 mut i = 0;
    while (i < proposed->boundaries.len) {
        range_boundary_candidate* c = &proposed->boundaries.items[i];
        if (c->expansion == expansion) {
            fir.range_boundary bd = c->boundary;
            if (c->declaration != op.declaration || bd.loan != expansion
                || bd.block >= fir.block_count(f)
                || bd.position > fir.block_statement_count(f, bd.block)) { return false; }
            switch (bd.kind) {
            case fir.range_boundary_kind.capture:
                capture_count += 1;
                if (bd.block != op.block || bd.position != op.position
                    || !range_audit_loc_eq(bd.source, n->b->loc)) { return false; }
            case fir.range_boundary_kind.body_entry:
                entry_count += 1;
                if (bd.block != body_block || !range_audit_loc_eq(bd.source, n->loc)) {
                    return false;
                }
                if (bd.position >= fir.block_statement_count(f, bd.block)) { return false; }
                fir.statement* first = fir.block_statement(f, bd.block, bd.position);
                if (first->kind != fir.stmt_kind.st_live || first->local >= fir.local_count(f)
                    || fir.local_at(f, first->local)->sym != cast(n->sym, ast.sym*)) {
                    return false;
                }
            case fir.range_boundary_kind.body_cleanup:
                cleanup_count += 1;
                if (cleanup_phase != 0
                    || !range_audit_cleanup_end(f, n, bd, &cleanup_end)) { return false; }
                cleanup = bd;
                cleanup_phase = 1;
            case fir.range_boundary_kind.loan_exit:
                exit_count += 1;
                if (cleanup_phase != 1 || bd.block != cleanup.block
                    || bd.position != cleanup_end
                    || !range_audit_loc_eq(bd.source, cleanup.source)) { return false; }
                loan_exit = bd;
                cleanup_phase = 2;
            case fir.range_boundary_kind.outer_cleanup:
                outer_count += 1;
                if (cleanup_phase != 2 || bd.block != loan_exit.block
                    || bd.position != loan_exit.position || bd.order <= loan_exit.order
                    || !range_audit_loc_eq(bd.source, loan_exit.source)) { return false; }
                cleanup_phase = 0;
            }
            range_audit_boundary_add(&out->boundaries, bd);
            row->boundaries_len += 1;
            out->matched_boundaries += 1;
        }
        i += 1;
    }
    return cleanup_phase == 0 && capture_count == 1 && entry_count == 1
        && range_audit_dead_gaps_covered(&gaps, proposed, expansion)
        && cast(cleanup_count, u64) == gaps.len
        && cleanup_count == exit_count
        && exit_count == outer_count;
}

/// Audits selected declarations and produced range operations without claiming source coverage.
/// The caller releases the report before the checked tree. The report survives candidate teardown.
fn audit_produced_ranges(ast.node* decl, fir.func* f, range_candidate_set* proposed,
                         range_source_audit mut* out) bool {
    if (!audit_range_inventory(decl, proposed, out)) { return false; }
    gen.node_ref_vec mut selected = gen.node_ref_vec{};
    defer gen.refs_free(&selected);
    range_audit_selected(decl->b, &selected);
    range_audit_operation_vec mut operations = range_audit_operation_vec{};
    defer del(operations.items);
    range_audit_operations(f, &selected, &operations);
    out->produced_expansions = cast(operations.len, u32);
    range_audit_replay mut walk = range_audit_replay{.f = f};
    defer range_audit_replay_free(&walk);
    range_audit_replay_scope(&walk, decl->b, scope_kind.sc_fn);
    u64 mut i = 0;
    while (i < operations.len) {
        range_audit_operation op = operations.items[i];
        ast.node* n = gen.refs_at(&selected, cast(op.declaration - 1, u64));
        range_audit_key mut key = range_audit_key{.function = decl->sym,
                                                  .declaration = op.declaration,
                                                  .expansion = cast(i + 1, u32),
                                                  .source = n->loc,
                                                  .exit_source = op.exit_source};
        if (i > 0 && operations.items[i - 1].statement_index == op.statement_index) {
            return range_audit_fail(out, key, range_audit_fault.operation);
        }
        ast.node* source_defer = range_audit_defer_at(decl->b, n);
        if (source_defer != null) { key.context_source = source_defer->loc; }
        if (i >= walk.ranges_len) { return range_audit_fail(out, key, range_audit_fault.context); }
        range_audit_source_range source = walk.ranges[i];
        key.context = source.context;
        key.exit_occurrence = source.occurrence;
        if (walk.incomplete || source.node != n || source.first != op.statement_index
            || !range_audit_loc_eq(source.exit_source, op.exit_source)
            || !range_audit_contexts(&walk, proposed, source)) {
            return range_audit_fail(out, key, range_audit_fault.context);
        }
        bool materialized = range_audit_has_call(n->b) || conditional_source_present(n->b);
        conditional_proof_session mut conditional = conditional_proof_session{
            .proof = range_material_context{.f = f, .operation = op}, .key = key,
            .declaration = decl, .source = n};
        defer conditional_proof_free(&conditional);
        fir.range_capture mut derived = fir.range_capture{};
        if (materialized) {
            u32 mut body = 0;
            if (!range_audit_body(f, n, op, &body)) {
                return range_audit_fail(out, key, range_audit_fault.protected_path);
            }
            bool mut proved = false;
            if (n->b->kind == ast.ast_kind.k_ternary) {
                proved = conditional_capture_prove(&conditional, n, body, &derived);
            } else if (conditional_source_present(n->b)) {
                proved = conditional_wrapped_capture(&conditional, n, body, &derived);
            } else {
                proved = range_material_capture(f, n, op, body, &derived);
            }
            if (!proved) {
                return range_audit_fail(out, key, range_audit_fault.protected_path);
            }
        }
        if (i >= proposed->captures.len) {
            range_audit_fault mut missing = range_audit_fault.expansion_key;
            if (source.context != 0) { missing = range_audit_fault.context; }
            return range_audit_fail(out, key, missing);
        }
        range_capture_candidate* c = &proposed->captures.items[i];
        if (c->declaration != op.declaration || c->expansion != key.expansion
            || c->occurrence.id != key.expansion
            || c->occurrence.declaration != op.declaration
            || !range_audit_loc_eq(c->occurrence.source, n->loc)
            || c->loan.id != key.expansion || c->loan.expansion != key.expansion
            || c->binding.loan != key.expansion) {
            return range_audit_fail(out, key, range_audit_fault.expansion_key);
        }
        if (!range_audit_loc_eq(c->occurrence.exit_source, op.exit_source)) {
            return range_audit_fail(out, key, range_audit_fault.exit_source);
        }
        if (c->occurrence.context != source.context
            || c->occurrence.exit_occurrence != source.occurrence) {
            return range_audit_fail(out, key, range_audit_fault.context);
        }
        if (materialized) {
            if (c->binding.kind != derived.kind
                || !range_audit_place_eq(f, c->binding.captured, derived.captured)) {
                return range_audit_fail(out, key, range_audit_fault.capture);
            }
            if (c->binding.original_present != derived.original_present
                || (derived.original_present
                    && !range_audit_place_eq(f, c->binding.original, derived.original))) {
                return range_audit_fail(out, key, range_audit_fault.protected_path);
            }
        }
        range_audit_fault mut fault = range_audit_fault.none;
        u32 mut body_block = 0;
        if (!range_audit_body(f, n, op, &body_block)) {
            return range_audit_fail(out, key, range_audit_fault.boundary);
        }
        u32 mut bound_body = 0;
        if (!range_audit_binding(f, n, op, c, &bound_body, &fault)) {
            return range_audit_fail(out, key, fault);
        }
        if (bound_body != body_block) {
            return range_audit_fail(out, key, range_audit_fault.boundary);
        }
        range_audit_row mut row = range_audit_row{.key = key, .binding = c->binding};
        if (!range_audit_boundaries(f, n, op, proposed, key.expansion, body_block,
                                    source, &walk, out, &row)) {
            return range_audit_fail(out, key, range_audit_fault.boundary);
        }
        range_audit_row_add(&out->rows, row);
        out->matched_captures += 1;
        if (c->binding.original_present) { out->protected_paths += 1; }
        i += 1;
    }
    if (proposed->captures.len != operations.len) {
        range_capture_candidate* extra = &proposed->captures.items[operations.len];
        range_audit_key key = range_audit_key{.function = decl->sym,
                                              .declaration = extra->declaration,
                                              .expansion = extra->expansion,
                                              .context = extra->occurrence.context,
                                              .exit_occurrence = extra->occurrence.exit_occurrence,
                                              .source = extra->occurrence.source,
                                              .exit_source = extra->occurrence.exit_source};
        return range_audit_fail(out, key, range_audit_fault.expansion_key);
    }
    if (cast(out->matched_boundaries, u64) != proposed->boundaries.len) {
        u64 mut extra_at = 0;
        while (extra_at < proposed->boundaries.len) {
            range_boundary_candidate* candidate = &proposed->boundaries.items[extra_at];
            bool mut found = false;
            u64 mut row_at = 0;
            while (row_at < out->rows.len) {
                if (out->rows.items[row_at].key.expansion == candidate->expansion) {
                    found = true;
                    break;
                }
                row_at += 1;
            }
            if (!found) { break; }
            extra_at += 1;
        }
        range_boundary_candidate* extra = &proposed->boundaries.items[extra_at];
        range_audit_key mut key = range_audit_key{.function = decl->sym,
                                                  .declaration = extra->declaration,
                                                  .expansion = extra->expansion,
                                                  .source = extra->boundary.source};
        u64 mut capture_at = 0;
        while (capture_at < proposed->captures.len) {
            range_capture_candidate* c = &proposed->captures.items[capture_at];
            if (c->expansion == extra->expansion) {
                key.context = c->occurrence.context;
                key.exit_occurrence = c->occurrence.exit_occurrence;
                key.exit_source = c->occurrence.exit_source;
                break;
            }
            capture_at += 1;
        }
        return range_audit_fail(out, key, range_audit_fault.boundary);
    }
    return true;
}

// Ends the body when its last block has no terminator: `return` for a `void` function, `trap` for
// a `noreturn` one and `unreachable` for any other, at the closing brace with index 0
// (spec/fir.md 9.6, 9.7). The checker proved that any other body does not reach its end, and
// rule V9 tests it.
fn lower_end(lowerer mut* lw, ast.node* body) void {
    if (terminated(lw)) {
        return;
    }
    diag.loc brace = end_of(body);
    types.node* ft = lw->f->ty;
    if (ft->is_noreturn) {
        terminate(lw, fir.term_trap(brace, 0));
    } else if (ft->elem->kind == types.type_kind.k_void) {
        terminate(lw, fir.term_return(brace, 0));
    } else {
        terminate(lw, fir.term_unreachable(brace, 0));
    }
}

// The last character of the source range of `n`: the closing brace of a block, and the last
// character of the last statement of a clause.
fn end_of(ast.node* n) diag.loc {
    return diag.loc_make(n->loc.file, n->loc.end_line, n->loc.end_col - 1);
}

// ---- the lowerer --------------------------------------------------------------------------------

// Records that the lowering does not lower the node `n`, and returns false, so that a caller
// returns what this returns.
fn unsupported(lowerer mut* lw, ast.node* n) bool {
    lw->why = report{n->kind, n->loc, ""};
    return false;
}

// Records that the node `n` needs the `std.rt` function `entry`, which the closure lacks, and
// returns false, as unsupported does.
fn no_runtime(lowerer mut* lw, ast.node* n, string entry) bool {
    lw->why = report{n->kind, n->loc, entry};
    return false;
}

// The number of the local of the parameter or named local `s`. The prescan gave every named local
// a number, so a symbol without one is an internal error.
fn local_of(lowerer* lw, ast.sym* s) u32 {
    u32 mut n = 1;
    while (n < fir.local_count(lw->f)) {
        if (fir.local_at(lw->f, n)->sym == s) {
            return n;
        }
        n += 1;
    }
    panic("fir_lower.local_of: a name without a local");
}

fn prim_ty(lowerer mut* lw, prim.prim_kind k) types.node* {
    return types.type_prim(&lw->ck->types, k);
}

fn bool_ty(lowerer mut* lw) types.node* {
    return prim_ty(lw, prim.prim_kind.prim_bool);
}

fn u64_ty(lowerer mut* lw) types.node* {
    return prim_ty(lw, prim.prim_kind.prim_u64);
}

fn i64_ty(lowerer mut* lw) types.node* {
    return prim_ty(lw, prim.prim_kind.prim_i64);
}

// Whether `t` is an `own` reference: an `own` pointer, `void* own`, `own` span or `string own`.
fn own_reference(types.node* t) bool {
    return types.type_is_reference(t) && t->is_own;
}

// ---- the scope stack ----------------------------------------------------------------------------

// Opens a scope of `kind` with the targets of its exits, as the innermost one. Its deferred
// statements and its named locals begin at the ends of the two vectors.
fn scope_push(lowerer mut* lw, scope_kind kind, u32 break_target, u32 continue_target) void {
    scope_vec mut* v = &lw->scopes;
    if (v->len == v->items.len) {
        u64 cap = fir.grown_capacity(v->items.len, "fir_lower.scope_push: capacity overflow");
        scope mut@ own bigger = new(scope, cap);
        u64 mut i = 0;
        while (i < v->len) {
            bigger[i] = v->items[i];
            i += 1;
        }
        del(v->items);
        v->items = move(bigger);
    }
    v->items[v->len] = scope{kind, break_target, continue_target, lw->defers.len,
                             lw->named.len, 0};
    v->len += 1;
}

// Closes the innermost scope, with its deferred statements and its named locals, so that no later
// exit expands or ends them (D7.8). Every pop follows the push of the same lower_scope.
fn scope_pop(lowerer mut* lw) void {
    if (lw->scopes.len == 0) {
        panic("fir_lower.scope_pop: no open scope");
    }
    lw->scopes.len -= 1;
    scope s = lw->scopes.items[lw->scopes.len];
    lw->defers.len = s.defers_first;
    lw->named.len = s.locals_first;
}

fn scopes_free(scope_vec mut* v) void {
    del(v->items);
    v->len = 0;
}

// Appends the named local `n` to the locals of the innermost scope, when its `live` marker stands.
fn local_push(lowerer mut* lw, u32 n) void {
    local_list mut* v = &lw->named;
    if (v->len == v->items.len) {
        u64 cap = fir.grown_capacity(v->items.len, "fir_lower.local_push: capacity overflow");
        u32 mut@ own bigger = new(u32, cap);
        u64 mut i = 0;
        while (i < v->len) {
            bigger[i] = v->items[i];
            i += 1;
        }
        del(v->items);
        v->items = move(bigger);
    }
    v->items[v->len] = n;
    v->len += 1;
}

fn locals_free(local_list mut* v) void {
    del(v->items);
    v->len = 0;
}

// Appends `s` to the current block. Inside the expansion of a deferred statement, `s` carries the
// location of the exit that expands it (spec/fir.md principle 12).
fn append(lowerer mut* lw, fir.statement s) void {
    fir.statement mut marked = s;
    marked.exit_loc = lw->exit_at;
    fir.block_append(lw->f, lw->block, marked);
}

// The candidate stands at an operation gap. Its order is local to that gap.
fn range_boundary_record(lowerer mut* lw, u32 loan, fir.range_boundary_kind kind,
                         diag.loc at) void {
    u32 mut declaration = 0;
    u64 mut i = 0;
    while (i < lw->range_candidates.captures.len) {
        range_capture_candidate* c = &lw->range_candidates.captures.items[i];
        if (c->expansion == loan) {
            declaration = c->declaration;
            break;
        }
        i += 1;
    }
    if (declaration == 0) {
        panic("fir_lower.range_boundary_record: missing capture candidate");
    }
    u32 position = fir.block_statement_count(lw->f, lw->block);
    u32 mut order = 0;
    i = 0;
    while (i < lw->range_candidates.boundaries.len) {
        fir.range_boundary* bd = &lw->range_candidates.boundaries.items[i].boundary;
        if (bd->block == lw->block && bd->position == position && bd->order >= order) {
            if (cast(bd->order, u64) >= fir.U32_LIMIT) {
                panic("fir_lower.range_boundary_record: too many boundaries at one gap");
            }
            order = bd->order + 1;
        }
        i += 1;
    }
    fir.range_boundary bd = fir.range_boundary{loan, kind, lw->block, position, order, at};
    range_boundary_candidate_add(&lw->range_candidates.boundaries,
                                 range_boundary_candidate{declaration, loan, bd});
}

fn range_boundaries_sort(range_boundary_candidate_vec mut* v) void {
    u64 mut i = 1;
    while (i < v->len) {
        range_boundary_candidate current = v->items[i];
        u64 mut j = i;
        while (j > 0) {
            fir.range_boundary* before = &v->items[j - 1].boundary;
            fir.range_boundary* after = &current.boundary;
            if (before->block < after->block || (before->block == after->block
                && (before->position < after->position || (before->position == after->position
                && before->order <= after->order)))) {
                break;
            }
            v->items[j] = v->items[j - 1];
            j -= 1;
        }
        v->items[j] = current;
        i += 1;
    }
}

// Appends `p = r` to the current block, at `at` and with the index of the current statement.
fn assign(lowerer mut* lw, fir.place p, fir.rvalue r, diag.loc at) void {
    append(lw, fir.stmt_assign(p, r, at, lw->stmt));
}

// Ends the current block with `t`, which carries the location of the exit as a statement does.
fn terminate(lowerer mut* lw, fir.terminator t) void {
    fir.terminator mut marked = t;
    marked.exit_loc = lw->exit_at;
    fir.block_set_terminator(lw->f, lw->block, marked);
}

fn terminated(lowerer* lw) bool {
    return fir.block_at(lw->f, lw->block)->terminated;
}

// Ends the current block with `goto target`.
fn jump(lowerer mut* lw, u32 target, diag.loc at) void {
    terminate(lw, fir.term_goto(target, at, lw->stmt));
}

// Ends the current block with `switch(a) -> [true: yes, otherwise: no]`.
fn branch(lowerer mut* lw, fir.operand a, u32 yes, u32 no, diag.loc at) void {
    u32 first = fir.arm_push(lw->f, consts.cv_from_bool(true), yes);
    terminate(lw, fir.term_switch(a, first, 1, no, at, lw->stmt));
}

// Ends the current block with `check(cond, kind, ...) -> bb` over the `len` reported operands
// from `first`, and continues in `bb`, a new block. `cond` is true on failure, except for the
// kind `user` (spec/fir.md 8).
fn check_then(lowerer mut* lw, fir.operand cond, fir.check_kind kind, u32 first, u32 len,
              diag.loc at) void {
    u32 next = fir.block_new(lw->f);
    terminate(lw, fir.term_check(cond, kind, first, len, next, at, lw->stmt));
    lw->block = next;
}

// The operand that reads the temporary `t` of type `ty`: `move _t` when `ty` owns, because an
// owning value leaves a temporary by `move` (spec/fir.md 9.4), and `copy _t` otherwise.
fn read_temp(u32 t, types.node* ty) fir.operand {
    if (fir.type_owning(ty)) {
        return fir.operand_move(fir.place_local(t));
    }
    return fir.operand_copy(fir.place_local(t));
}

// `_t = r` in a new temporary of type `ty`, which the construct at `at` makes, and the operand
// that reads `_t`.
fn into_temp(lowerer mut* lw, types.node* ty, fir.rvalue r, diag.loc at) fir.operand {
    u32 t = fir.local_add(lw->f, ty, fir.local_kind.lk_temp, null, at);
    assign(lw, fir.place_local(t), r, at);
    return read_temp(t, ty);
}

// ---- the materialization rule -------------------------------------------------------------------

// Whether the expression `n` contains a writer: a call, which covers `move`, `del` and every
// other builtin, or a `new` (spec/fir.md 9.4). A writer can change a place that an operand
// before it names.
fn contains_writer(ast.node* n) bool {
    if (n == null) {
        return false;
    }
    if (n->kind == ast.ast_kind.k_call || n->kind == ast.ast_kind.k_new) {
        return true;
    }
    if (contains_writer(n->a) || contains_writer(n->b) || contains_writer(n->c)
        || contains_writer(n->d)) {
        return true;
    }
    u64 mut i = 0;
    while (i < ast.ast_len(n)) {
        if (contains_writer(ast.ast_child(n, i))) {
            return true;
        }
        i += 1;
    }
    return false;
}

// Writes to out[i], for each child `i` of `n`, whether a child after it contains a writer, and
// returns whether any child does. `out` has one entry for each child.
fn writers_after(ast.node* n, bool mut@ out) bool {
    bool mut later = false;
    u64 mut i = ast.ast_len(n);
    while (i > 0) {
        i -= 1;
        out[i] = later;
        later = later || contains_writer(ast.ast_child(n, i));
    }
    return later;
}

// Whether no writer can change the place `p`: fixed storage whose base is a temporary of the
// lowering. The lowering takes the address of no temporary's own storage: `addr` and `slice`
// name an lvalue, and the one lvalue on a temporary is an element that a span points to, which is
// no fixed storage (spec/fir.md 5.5).
fn out_of_reach(lowerer* lw, fir.place p) bool {
    return p.base == fir.base_kind.bk_local
        && fir.local_at(lw->f, p.local)->kind == fir.local_kind.lk_temp
        && fir.place_fixed(lw->f, p);
}

// The type of a copy of a place of type `t`: `t` without `own` at the top level and at each level
// that the place stores inline, the elements of a fixed array (spec/fir.md 9.4, D17.4). `own`
// behind a pointer or a span stays.
fn lent_type(lowerer mut* lw, types.node* t) types.node* {
    types.table mut* tt = &lw->ck->types;
    switch (t->kind) {
    case types.type_kind.k_ptr:
        return types.type_ptr(tt, t->elem, false, t->is_mut);
    case types.type_kind.k_voidptr:
        return types.type_voidptr(tt, false, t->is_mut);
    case types.type_kind.k_span:
        return types.type_span(tt, t->elem, false, t->is_mut);
    case types.type_kind.k_string:
        return types.type_string(tt, false);
    case types.type_kind.k_array:
        return types.type_array(tt, lent_type(lw, t->elem), t->len);
    default:
        return t;
    }
}

// The materialization rule (spec/fir.md 9.4, principle 4). When `later` says that a later operand
// of the same rvalue or call contains a writer, and `op` reads a place that a writer can reach,
// the place is read now: `_t = copy p` in a temporary of the lent type of `p`, or `_t = move p`,
// at `at`, and the operand reads `_t`. Else `op` stays as it is.
fn materialize(lowerer mut* lw, fir.operand op, bool later, diag.loc at) fir.operand {
    if (!later || op.kind == fir.operand_kind.ok_const || out_of_reach(lw, op.place)) {
        return op;
    }
    types.node* mut t = fir.place_type(lw->f, op.place);
    if (op.kind == fir.operand_kind.ok_copy) {
        t = lent_type(lw, t);
    }
    u32 held = fir.local_add(lw->f, t, fir.local_kind.lk_temp, null, at);
    assign(lw, fir.place_local(held), fir.rvalue_use(lw->f, op), at);
    if (op.kind == fir.operand_kind.ok_move) {
        return fir.operand_move(fir.place_local(held));
    }
    return fir.operand_copy(fir.place_local(held));
}

// ---- statements -------------------------------------------------------------------------------

// Lowers the statements of the block `n` in order, as a scope of `kind` whose exits go to the
// blocks `break_target` and `continue_target`, then its fall-off (spec/fir.md 9.5).
fn lower_scope(lowerer mut* lw, ast.node* n, scope_kind kind, u32 break_target,
               u32 continue_target) bool {
    scope_push(lw, kind, break_target, continue_target);
    return lower_statements(lw, n) && close_scope(lw, end_of(n));
}

// Lowers the statements of the block `n` in order, in the innermost scope. A statement after a
// terminator starts a new block that no terminator names (spec/fir.md 9.3).
fn lower_statements(lowerer mut* lw, ast.node* n) bool {
    u64 mut i = 0;
    while (i < ast.ast_len(n)) {
        if (terminated(lw)) {
            lw->block = fir.block_new(lw->f);
        }
        if (!lower_stmt(lw, ast.ast_child(n, i))) {
            return false;
        }
        i += 1;
    }
    return true;
}

// The fall-off of the innermost scope, then its pop (spec/fir.md 9.5). When its block has no
// terminator, control falls off its end at `at`: the deferred statements of the scope, the last
// one first, then a `dead` for each of its named locals. The markers take the index of the
// enclosing statement, which is 0 in the body (9.7).
fn close_scope(lowerer mut* lw, diag.loc at) bool {
    u64 depth = lw->scopes.len - 1;
    if (!terminated(lw)) {
        u32 loan = lw->scopes.items[depth].range_loan;
        if (!expand(lw, depth, at)) {
            return false;
        }
        if (!terminated(lw)) {
            if (loan != 0) {
                range_boundary_record(lw, loan, fir.range_boundary_kind.body_cleanup, at);
            }
            mark_dead(lw, depth, at);
            if (loan != 0) {
                range_boundary_record(lw, loan, fir.range_boundary_kind.loan_exit, at);
                range_boundary_record(lw, loan, fir.range_boundary_kind.outer_cleanup, at);
            }
        }
    }
    scope_pop(lw);
    return true;
}

// Where the deferred statements of the scope at `depth` end in their vector: where those of the
// next scope begin, or at the end of the vector for the innermost scope. locals_end answers the
// same for the named locals.
fn defers_end(lowerer* lw, u64 depth) u64 {
    if (depth + 1 < lw->scopes.len) {
        return lw->scopes.items[depth + 1].defers_first;
    }
    return lw->defers.len;
}

fn locals_end(lowerer* lw, u64 depth) u64 {
    if (depth + 1 < lw->scopes.len) {
        return lw->scopes.items[depth + 1].locals_first;
    }
    return lw->named.len;
}

// A terminating deferred expansion can prevent earlier defers from lowering.
// These proposals preserve that cause but do not prove source suppression.
fn range_suppressed(lowerer mut* lw, ast.node* n, u32 context, u32 occurrence,
                    diag.loc exit_source) void {
    if (n == null) {
        return;
    }
    if (n->kind == ast.ast_kind.k_compile_if) {
        range_suppressed(lw, selected_branch(n), context, occurrence, exit_source);
        return;
    }
    if (n->kind == ast.ast_kind.k_range_for) {
        u32 declaration = range_declaration_id(lw, n);
        range_suppression_candidate_add(&lw->range_candidates.suppressions,
                                        range_suppression_candidate{declaration, context,
                                                                    occurrence, n->loc,
                                                                    exit_source});
    }
    range_suppressed(lw, n->a, context, occurrence, exit_source);
    range_suppressed(lw, n->b, context, occurrence, exit_source);
    range_suppressed(lw, n->c, context, occurrence, exit_source);
    range_suppressed(lw, n->d, context, occurrence, exit_source);
    u64 mut j = 0;
    while (j < ast.ast_len(n)) {
        range_suppressed(lw, ast.ast_child(n, j), context, occurrence, exit_source);
        j += 1;
    }
}

fn next_defer_context(lowerer mut* lw) u32 {
    if (cast(lw->next_defer_context, u64) >= fir.U32_LIMIT) {
        panic("fir_lower.next_defer_context: too many deferred expansions");
    }
    lw->next_defer_context += 1;
    return lw->next_defer_context;
}

// Lowers the deferred statements of the scope at `depth`, the last one first, for the exit at
// `at` (spec/fir.md 9.5, D7.8). Each is a new lowering whose statements carry `at` as their
// `exit_loc`, and each statement node in it takes a new index (9.7). While one lowers, the floor
// stands at the depth of the stack, so an exit inside it walks only the scopes that it opens. A
// deferred statement that ends the block stops the expansion. False when the lowering refuses a
// deferred statement.
fn expand(lowerer mut* lw, u64 depth, diag.loc at) bool {
    u64 first = lw->scopes.items[depth].defers_first;
    u64 mut i = defers_end(lw, depth);
    u64 saved_floor = lw->floor;
    diag.loc saved_exit = lw->exit_at;
    u32 saved_context = lw->defer_context;
    u32 saved_occurrence = lw->exit_occurrence;
    if (cast(lw->next_exit_occurrence, u64) >= fir.U32_LIMIT) {
        panic("fir_lower.expand: too many exit occurrences");
    }
    lw->next_exit_occurrence += 1;
    lw->exit_occurrence = lw->next_exit_occurrence;
    u32 occurrence = lw->exit_occurrence;
    lw->floor = lw->scopes.len;
    lw->exit_at = at;
    bool mut ok = true;
    while (ok && i > first && !terminated(lw)) {
        i -= 1;
        ast.node* deferred = gen.refs_at(&lw->defers, i);
        lw->defer_context = next_defer_context(lw);
        range_defer_context_candidate_add(&lw->range_candidates.deferred,
            range_defer_context_candidate{lw->defer_context, saved_context, occurrence,
                                          deferred, at});
        ok = lower_stmt(lw, deferred->a);
    }
    while (ok && i > first && terminated(lw)) {
        i -= 1;
        ast.node* deferred = gen.refs_at(&lw->defers, i);
        u32 context = next_defer_context(lw);
        range_defer_context_candidate_add(&lw->range_candidates.deferred,
            range_defer_context_candidate{context, saved_context, occurrence, deferred, at});
        range_suppressed(lw, deferred->a, context, occurrence, at);
    }
    lw->floor = saved_floor;
    lw->exit_at = saved_exit;
    lw->defer_context = saved_context;
    lw->exit_occurrence = saved_occurrence;
    return ok;
}

// `dead(_n)` at `at` for each named local of the scope at `depth`, in the order of their
// declarations, with the index of the current statement (spec/fir.md 7, 9.7).
fn mark_dead(lowerer mut* lw, u64 depth, diag.loc at) void {
    u64 mut i = lw->scopes.items[depth].locals_first;
    u64 end = locals_end(lw, depth);
    while (i < end) {
        append(lw, fir.stmt_dead(lw->named.items[i], at, lw->stmt));
        i += 1;
    }
}

// Whether an exit of the kind `x` leaves the function, a loop or a clause at a scope of `kind`
// and stops there: `return` at the `fn` scope, `continue` at a `loop` scope, and `break` at a
// `loop` or a `case` scope (spec/fir.md 9.5, D7.6).
fn exit_stops_at(exit_kind x, scope_kind kind) bool {
    switch (x) {
    case exit_kind.x_return:
        return kind == scope_kind.sc_fn;
    case exit_kind.x_continue:
        return kind == scope_kind.sc_loop;
    case exit_kind.x_break:
        return kind == scope_kind.sc_loop || kind == scope_kind.sc_case;
    }
}

// A terminating inner defer skips all defers in each crossed outer scope.
// Keep their source and exit identities without lowering normal cleanup.
fn range_suppress_scope(lowerer mut* lw, u64 depth, diag.loc at) void {
    if (cast(lw->next_exit_occurrence, u64) >= fir.U32_LIMIT) {
        panic("fir_lower.range_suppress_scope: too many exit occurrences");
    }
    lw->next_exit_occurrence += 1;
    u32 occurrence = lw->next_exit_occurrence;
    u64 first = lw->scopes.items[depth].defers_first;
    u64 mut i = defers_end(lw, depth);
    while (i > first) {
        i -= 1;
        ast.node* deferred = gen.refs_at(&lw->defers, i);
        u32 context = next_defer_context(lw);
        range_defer_context_candidate_add(&lw->range_candidates.deferred,
            range_defer_context_candidate{context, lw->defer_context, occurrence,
                                          deferred, at});
        range_suppressed(lw, deferred->a, context, occurrence, at);
    }
}

// The unwind of the exit `n` of the kind `x` (spec/fir.md 9.5): from the innermost scope outward,
// the deferred statements of each scope, then its `dead` markers at the exit, until the scope that
// the exit leaves, whose depth goes to *stop. False when the lowering refuses a deferred
// statement. A deferred statement that ends the block stops the unwind, and the caller then
// writes no terminator. The checker refuses an exit that no scope above the floor stops (D7.8).
fn unwind(lowerer mut* lw, ast.node* n, exit_kind x, u64 mut* stop) bool {
    u64 scope_count = lw->scopes.len;
    u32 mut@ own saved_loans = new(u32, scope_count);
    u64 mut save = 0;
    while (save < scope_count) {
        saved_loans[save] = lw->scopes.items[save].range_loan;
        save += 1;
    }
    defer {
        u64 mut restore = 0;
        while (restore < scope_count && restore < lw->scopes.len) {
            lw->scopes.items[restore].range_loan = saved_loans[restore];
            restore += 1;
        }
        del(saved_loans);
    }
    u64 mut depth = lw->scopes.len;
    while (depth > lw->floor) {
        depth -= 1;
        u32 loan = lw->scopes.items[depth].range_loan;
        if (!expand(lw, depth, n->loc)) {
            return false;
        }
        if (terminated(lw)) {
            u64 mut outer = depth;
            while (outer > lw->floor &&
                   !exit_stops_at(x, lw->scopes.items[outer].kind)) {
                outer -= 1;
                range_suppress_scope(lw, outer, n->loc);
            }
            return true;
        }
        if (loan != 0) {
            range_boundary_record(lw, loan, fir.range_boundary_kind.body_cleanup, n->loc);
        }
        mark_dead(lw, depth, n->loc);
        if (loan != 0) {
            range_boundary_record(lw, loan, fir.range_boundary_kind.loan_exit, n->loc);
            range_boundary_record(lw, loan, fir.range_boundary_kind.outer_cleanup, n->loc);
            lw->scopes.items[depth].range_loan = 0;
        }
        if (exit_stops_at(x, lw->scopes.items[depth].kind)) {
            *stop = depth;
            return true;
        }
    }
    panic("fir_lower.unwind: an exit with no scope to leave above the floor");
}

// A block, or the selected branch of a statement `$if`, as a scope of kind `block`, which only
// the end of the block leaves.
fn lower_block(lowerer mut* lw, ast.node* n) bool {
    return lower_scope(lw, n, scope_kind.sc_block, 0, 0);
}

// `defer s`: no statement. The node goes to the deferred statements of the innermost scope, and
// each exit and the fall-off of that scope lower `s` again (spec/fir.md 9.3, 9.5, D7.8).
fn lower_defer(lowerer mut* lw, ast.node* n) bool {
    gen.refs_push(&lw->defers, n);
    return true;
}

// Lowers one statement. A block and a `$if` only group statements, and every other statement
// takes the next index of the counter while the walk lowers it (spec/fir.md 9.7).
fn lower_stmt(lowerer mut* lw, ast.node* n) bool {
    if (n->kind == ast.ast_kind.k_block) {
        return lower_block(lw, n);
    }
    if (n->kind == ast.ast_kind.k_compile_if) {
        ast.node* chosen = selected_branch(n);
        return chosen == null || lower_block(lw, chosen);
    }
    u32 outer = lw->stmt;
    lw->counter += 1;
    lw->stmt = lw->counter;
    bool mut ok = false;
    switch (n->kind) {
    case ast.ast_kind.k_var_decl:
        ok = lower_var_decl(lw, n);
    case ast.ast_kind.k_assign:
        ok = lower_assign(lw, n);
    case ast.ast_kind.k_incdec:
        ok = lower_incdec(lw, n);
    case ast.ast_kind.k_call_stmt:
        ok = lower_call_stmt(lw, n->a);
    case ast.ast_kind.k_if:
        ok = lower_if(lw, n);
    case ast.ast_kind.k_while:
        ok = lower_while(lw, n);
    case ast.ast_kind.k_do_while:
        ok = lower_do(lw, n);
    case ast.ast_kind.k_for:
        ok = lower_for(lw, n);
    case ast.ast_kind.k_range_for:
        ok = lower_range_for(lw, n);
    case ast.ast_kind.k_switch:
        ok = lower_switch(lw, n);
    case ast.ast_kind.k_break:
        ok = lower_exit(lw, n, exit_kind.x_break);
    case ast.ast_kind.k_continue:
        ok = lower_exit(lw, n, exit_kind.x_continue);
    case ast.ast_kind.k_return:
        ok = lower_return(lw, n);
    case ast.ast_kind.k_defer:
        ok = lower_defer(lw, n);
    default:
        ok = unsupported(lw, n);
    }
    lw->stmt = outer;
    return ok;
}

// `T x = e;`: `live(_x)` at the declared name, and `_x` joins the locals of the innermost scope.
// Then `e` into `_x` (spec/fir.md 9.3). An `own` reference takes the overwrite check at the
// declared name, since the tree records no location for the `=` of a declaration (D17.11).
fn lower_var_decl(lowerer mut* lw, ast.node* n) bool {
    u32 x = local_of(lw, n->sym);
    live(lw, x, n->name_loc);
    if (own_reference(n->sym->ty)) {
        return checked_store(lw, fir.place_local(x), n->b, n->name_loc);
    }
    return lower_into(lw, n->b, fir.place_local(x));
}

// `live(_x)` at `at`, and `_x` joins the locals of the innermost scope, whose exits end it.
fn live(lowerer mut* lw, u32 x, diag.loc at) void {
    append(lw, fir.stmt_live(x, at, lw->stmt));
    local_push(lw, x);
}

// A store into the place `p` of an `own` reference (spec/fir.md 9.3, D17.11): `e` into a
// temporary `_t`, `check(overwrite: p) -> bb` at `at`, and `p = move _t` in `bb` at `at`. The
// check runs after the right side and right before the store, so `p = move(p)` passes it.
fn checked_store(lowerer mut* lw, fir.place p, ast.node* e, diag.loc at) bool {
    u32 mut t = 0;
    if (!owning_temp(lw, e, &t)) {
        return false;
    }
    u32 next = fir.block_new(lw->f);
    terminate(lw, fir.term_check_overwrite(p, next, at, lw->stmt));
    lw->block = next;
    assign(lw, p, fir.rvalue_use(lw->f, fir.operand_move(fir.place_local(t))), at);
    return true;
}

// Whether `o` reads a temporary of the lowering, with no projection, by `move`: the value that the
// lowering of an owning rvalue leaves.
fn moves_temp(lowerer* lw, fir.operand o) bool {
    return o.kind == fir.operand_kind.ok_move && o.place.base == fir.base_kind.bk_local
        && o.place.proj_len == 0
        && fir.local_at(lw->f, o.place.local)->kind == fir.local_kind.lk_temp;
}

// The owning value of the expression `e` in a temporary, whose number goes to *out: the
// temporary that the lowering of `e` made for it, or else a new temporary of the type of `e`
// that `_t = e` fills at `e`. An aggregate writes into the new temporary itself. The checker
// gives `e` an owning type: an owning rvalue, `move(lv)`, or `null` or `{}` in an owning context.
fn owning_temp(lowerer mut* lw, ast.node* e, u32 mut* out) bool {
    if (fir.type_aggregate(e->ty)) {
        *out = fir.local_add(lw->f, e->ty, fir.local_kind.lk_temp, null, e->loc);
        return lower_into(lw, e, fir.place_local(*out));
    }
    fir.operand mut v = fir.operand{};
    if (!lower_operand(lw, e, &v)) {
        return false;
    }
    if (moves_temp(lw, v)) {
        *out = v.place.local;
        return true;
    }
    *out = fir.local_add(lw->f, e->ty, fir.local_kind.lk_temp, null, e->loc);
    assign(lw, fir.place_local(*out), fir.rvalue_use(lw->f, v), e->loc);
    return true;
}

// The rvalue operator of the compound assignment token `op`, or `assign` for `=`. `lv op= e`
// follows the rules and overflow behavior of `lv op e`.
fn compound_operator(lexer.tok_kind op) lexer.tok_kind {
    switch (op) {
    case lexer.tok_kind.plus_assign:
        return lexer.tok_kind.plus;
    case lexer.tok_kind.minus_assign:
        return lexer.tok_kind.minus;
    case lexer.tok_kind.star_assign:
        return lexer.tok_kind.star;
    case lexer.tok_kind.slash_assign:
        return lexer.tok_kind.slash;
    case lexer.tok_kind.percent_assign:
        return lexer.tok_kind.percent;
    case lexer.tok_kind.plus_wrap_assign:
        return lexer.tok_kind.plus_wrap;
    case lexer.tok_kind.minus_wrap_assign:
        return lexer.tok_kind.minus_wrap;
    case lexer.tok_kind.star_wrap_assign:
        return lexer.tok_kind.star_wrap;
    case lexer.tok_kind.amp_assign:
        return lexer.tok_kind.amp;
    case lexer.tok_kind.pipe_assign:
        return lexer.tok_kind.pipe;
    case lexer.tok_kind.caret_assign:
        return lexer.tok_kind.caret;
    case lexer.tok_kind.shl_assign:
        return lexer.tok_kind.shl;
    case lexer.tok_kind.shr_assign:
        return lexer.tok_kind.shr;
    default:
        return lexer.tok_kind.assign;
    }
}

// The place of the target `lv` of an assignment, in *out: the place with its index temporaries
// and their checks, first (D6.3). When the right side `e` contains a writer and the place is no
// fixed storage, a writer could move its storage, so the address is held now, `_a = addr mut(p)`,
// and the place is `(*_a)` (spec/fir.md 9.3).
fn target_place(lowerer mut* lw, ast.node* lv, ast.node* e, fir.place mut* out) bool {
    if (!lower_place(lw, lv, out)) {
        return false;
    }
    if (!contains_writer(e) || fir.place_fixed(lw->f, *out)) {
        return true;
    }
    *out = hold_address(lw, *out, true, lv->loc);
    return true;
}

// `_a = addr(p)` in a new temporary at `at`, `addr mut(p)` when `is_mut` is set, and the place
// `(*_a)`, which names the storage of `p` with no second read of the pointers that led to it.
fn hold_address(lowerer mut* lw, fir.place p, bool is_mut, diag.loc at) fir.place {
    types.node* t = types.type_ptr(&lw->ck->types, fir.place_type(lw->f, p), false, is_mut);
    u32 a = fir.local_add(lw->f, t, fir.local_kind.lk_temp, null, at);
    assign(lw, fir.place_local(a), fir.rvalue_addr(lw->f, p, is_mut), at);
    return fir.place_deref(lw->f, fir.place_local(a));
}

// Whether the storage that `p` reaches through its last read of memory is mutable: the `mut` of
// the last pointer that a deref reads, or of the last span that an index reads. An index on a
// `string` gives a `char`, which no projection follows, so it is never that last read. `p` reads
// memory to find its storage (fir.place_indirect).
fn indirect_mut(fir.func* f, fir.place p) bool {
    types.node* mut t = fir.base_type(f, p);
    bool mut is_mut = false;
    u32 mut i = 0;
    while (i < p.proj_len) {
        fir.projection pj = fir.place_projection(f, p, i);
        bool span = t->kind == types.type_kind.k_span;
        if (pj.kind == fir.proj_kind.pj_deref || (pj.kind == fir.proj_kind.pj_index && span)) {
            is_mut = t->is_mut;
        }
        t = fir.apply_projection(f, t, pj);
        i += 1;
    }
    return is_mut;
}

// The base `p` of an index or of a span expression whose index or bounds run after it. When
// `later` says that they contain a writer and `p` reads memory to find its storage, its address
// is held now: the writer could change a pointer that the address reads (D6.3, principle 4). The
// header of a span or `string` at that address, and the element, are read where they are used.
fn hold_base(lowerer mut* lw, fir.place p, bool later, diag.loc at) fir.place {
    if (!later || !fir.place_indirect(lw->f, p)) {
        return p;
    }
    return hold_address(lw, p, indirect_mut(lw->f, p), at);
}

// `lv = e;` and `lv op= e;` (spec/fir.md 9.3). `lv = e` writes `e` into the place of `lv`: an
// aggregate writes into it where it is lowered, and a scalar is stored at the `=`, as
// spec/fir.md 13 stores `*p = 7`. An `own` reference takes the overwrite check and its store at
// the `=` (D17.11). `lv op= e` reads the old value before `e`, `_old = copy p`, then writes `p =
// op(copy _old, e)` at the operator after the checks of `op`, so the target is computed once
// (D6.3).
fn lower_assign(lowerer mut* lw, ast.node* n) bool {
    lexer.tok_kind op = compound_operator(cast(n->op, lexer.tok_kind));
    fir.place mut p = fir.place{};
    if (!target_place(lw, n->a, n->b, &p)) {
        return false;
    }
    if (op == lexer.tok_kind.assign && own_reference(n->a->ty)) {
        return checked_store(lw, p, n->b, n->loc);
    }
    if (op == lexer.tok_kind.assign && fir.type_aggregate(n->b->ty)) {
        return lower_into(lw, n->b, p);
    }
    if (op == lexer.tok_kind.assign) {
        fir.operand mut v = fir.operand{};
        if (!lower_operand(lw, n->b, &v)) {
            return false;
        }
        assign(lw, p, fir.rvalue_use(lw->f, v), n->loc);
        return true;
    }
    fir.operand old = old_value(lw, p, n->a->loc);
    fir.operand mut e = fir.operand{};
    if (!lower_operand(lw, n->b, &e)) {
        return false;
    }
    types.node* t = fir.place_type(lw->f, p);
    assign(lw, p, operation(lw, op, t, old, e, n->loc), n->loc);
    return true;
}

// `lv++;` and `lv--;`: `lv += 1` and `lv -= 1` (spec/fir.md 9.3).
fn lower_incdec(lowerer mut* lw, ast.node* n) bool {
    fir.place mut p = fir.place{};
    if (!lower_place(lw, n->a, &p)) {
        return false;
    }
    fir.operand old = old_value(lw, p, n->a->loc);
    types.node* t = fir.place_type(lw->f, p);
    lexer.tok_kind mut op = lexer.tok_kind.minus;
    if (cast(n->op, lexer.tok_kind) == lexer.tok_kind.plus_plus) {
        op = lexer.tok_kind.plus;
    }
    assign(lw, p, operation(lw, op, t, old, int_const(t, false, 1), n->loc), n->loc);
    return true;
}

// `_old = copy p` in a new temporary at `at`, and the operand that reads it.
fn old_value(lowerer mut* lw, fir.place p, diag.loc at) fir.operand {
    types.node* t = lent_type(lw, fir.place_type(lw->f, p));
    return into_temp(lw, t, fir.rvalue_use(lw->f, fir.operand_copy(p)), at);
}

// `if (c) A else B`: the operand of `c`, `switch -> [true: then, otherwise: else]`, and each arm,
// which ends in `goto done` unless it ends in a terminator. Without `else`, `otherwise` is
// `done`. The blocks are made in the order then, else, done (spec/fir.md 9.3). An `else if` is an
// `if` of its own, with an index of its own (9.7).
fn lower_if(lowerer mut* lw, ast.node* n) bool {
    fir.operand mut c = fir.operand{};
    if (!lower_operand(lw, n->a, &c)) {
        return false;
    }
    u32 then_block = fir.block_new(lw->f);
    u32 mut else_block = 0;
    if (n->c != null) {
        else_block = fir.block_new(lw->f);
    }
    u32 done = fir.block_new(lw->f);
    if (n->c == null) {
        else_block = done;
    }
    branch(lw, c, then_block, else_block, n->loc);
    lw->block = then_block;
    if (!lower_arm(lw, n->b, done, n->loc)) {
        return false;
    }
    if (n->c != null) {
        lw->block = else_block;
        if (!lower_arm(lw, n->c, done, n->loc)) {
            return false;
        }
    }
    lw->block = done;
    return true;
}

// Lowers the arm `n` of an `if`, a block or an `else if`, and ends it with `goto done` at the
// `if` unless it ends in a terminator.
fn lower_arm(lowerer mut* lw, ast.node* n, u32 done, diag.loc at) bool {
    if (!lower_stmt(lw, n)) {
        return false;
    }
    if (!terminated(lw)) {
        jump(lw, done, at);
    }
    return true;
}

// ---- loops and switch -------------------------------------------------------------------------

// The body of a loop in the current block, as a scope of kind `loop` whose `break` goes to `done`
// and whose `continue` goes to `next`. It ends with `goto next` at `at` unless it ends in a
// terminator (spec/fir.md 9.3).
fn lower_loop_body(lowerer mut* lw, ast.node* body, u32 done, u32 next, diag.loc at) bool {
    if (!lower_scope(lw, body, scope_kind.sc_loop, done, next)) {
        return false;
    }
    if (!terminated(lw)) {
        jump(lw, next, at);
    }
    return true;
}

// The operand of the loop condition `c`, then `switch(a) -> [true: body, otherwise: done]` at
// `at`.
fn lower_test(lowerer mut* lw, ast.node* c, u32 body, u32 done, diag.loc at) bool {
    fir.operand mut a = fir.operand{};
    if (!lower_operand(lw, c, &a)) {
        return false;
    }
    branch(lw, a, body, done, at);
    return true;
}

// `while (c) B`: the blocks head, body and done; `goto head`; the condition in head; `B` as a loop
// body whose `break` goes to done and whose `continue` goes to head (spec/fir.md 9.3, D7.5). Each
// terminator of the loop stands at the `while`. The checker folds the condition of `while (true)`,
// so head ends in `switch(const true)`, and rule V9 takes only its edge to body.
fn lower_while(lowerer mut* lw, ast.node* n) bool {
    u32 head = fir.block_new(lw->f);
    u32 body = fir.block_new(lw->f);
    u32 done = fir.block_new(lw->f);
    jump(lw, head, n->loc);
    lw->block = head;
    if (!lower_test(lw, n->a, body, done, n->loc)) {
        return false;
    }
    lw->block = body;
    if (!lower_loop_body(lw, n->b, done, head, n->loc)) {
        return false;
    }
    lw->block = done;
    return true;
}

// `do B while (c);`: the blocks body, test and done; `goto body`; `B` as a loop body whose `break`
// goes to done and whose `continue` goes to test; the condition in test (spec/fir.md 9.3, D7.5).
// Each terminator of the loop stands at the `do`.
fn lower_do(lowerer mut* lw, ast.node* n) bool {
    u32 body = fir.block_new(lw->f);
    u32 test = fir.block_new(lw->f);
    u32 done = fir.block_new(lw->f);
    jump(lw, body, n->loc);
    lw->block = body;
    if (!lower_loop_body(lw, n->a, done, test, n->loc)) {
        return false;
    }
    lw->block = test;
    if (!lower_test(lw, n->b, body, done, n->loc)) {
        return false;
    }
    lw->block = done;
    return true;
}

// `for (i; c; s) B`: `i` in the current block, as a statement of its own; the blocks head, body,
// step and done; the condition in head, or `goto body` for an empty one; `B` as a loop body whose
// `break` goes to done and whose `continue` goes to step; `s` in step, as a statement of its own,
// then `goto head` (spec/fir.md 9.3, D7.5). A call of a `noreturn` function in `i` or in `s` ends
// its block, so no `goto` follows it. The walk meets `s` after `B`, where its block stands, so `s`
// takes its index after the statements of `B` (9.7). A local that `i` declares lives once for the
// whole loop, so it belongs to a scope of kind `block` around the loop, whose fall-off ends it in
// done at the end of the loop.
fn lower_for(lowerer mut* lw, ast.node* n) bool {
    scope_push(lw, scope_kind.sc_block, 0, 0);
    if (n->a != null && !lower_stmt(lw, n->a)) {
        return false;
    }
    u32 head = fir.block_new(lw->f);
    u32 body = fir.block_new(lw->f);
    u32 step = fir.block_new(lw->f);
    u32 done = fir.block_new(lw->f);
    if (!terminated(lw)) {
        jump(lw, head, n->loc);
    }
    lw->block = head;
    if (n->b == null) {
        jump(lw, body, n->loc);
    } else if (!lower_test(lw, n->b, body, done, n->loc)) {
        return false;
    }
    lw->block = body;
    if (!lower_loop_body(lw, n->d, done, step, n->loc)) {
        return false;
    }
    lw->block = step;
    if (n->c != null && !lower_stmt(lw, n->c)) {
        return false;
    }
    if (!terminated(lw)) {
        jump(lw, head, n->loc);
    }
    lw->block = done;
    return close_scope(lw, end_of(n));
}

// Selects the collection once (D7.5, D17.10, spec/fir.md 5.2).
// The returned candidate keeps the selected protected place.
// It does not enter the FIR carriers until the complete body boundaries exist.
fn range_collection(lowerer mut* lw, ast.node* coll, u32 declaration, u32 expansion,
                    fir.place mut* out, range_capture_candidate mut* candidate) bool {
    fir.range_capture mut binding = fir.range_capture{.loan = expansion, .source = coll->loc};
    if (fir.type_owning(coll->ty) && coll->ty->kind == types.type_kind.k_array) {
        fir.place mut p = fir.place{};
        if (!lower_place(lw, coll, &p)) {
            return false;
        }
        *out = hold_base(lw, p, true, coll->loc);
        binding.kind = fir.range_capture_kind.owning_fixed_array_place;
        binding.captured = *out;
        binding.original = *out;
        binding.original_present = true;
        *candidate = range_capture_candidate{.declaration = declaration, .expansion = expansion,
                                              .binding = binding};
        return true;
    }
    types.node* ty = lent_type(lw, coll->ty);
    u32 t = fir.local_add(lw->f, ty, fir.local_kind.lk_temp, null, coll->loc);
    *out = fir.place_local(t);
    binding.captured = *out;
    if (coll->ty->kind == types.type_kind.k_array) {
        binding.kind = fir.range_capture_kind.non_owning_array_copy;
        if (!lower_into(lw, coll, *out)) {
            return false;
        }
    } else if (fir.type_owning(coll->ty) || designates(coll)) {
        fir.place mut p = fir.place{};
        if (!lower_place(lw, coll, &p)) {
            return false;
        }
        p = hold_base(lw, p, true, coll->loc);
        assign(lw, *out, fir.rvalue_use(lw->f, fir.operand_copy(p)), coll->loc);
        binding.kind = fir.range_capture_kind.borrowed_header;
        binding.original = p;
        binding.original_present = true;
    } else {
        if (!lower_into(lw, coll, *out)) {
            return false;
        }
        binding.kind = fir.range_capture_kind.borrowed_header;
        binding.original = *out;
        binding.original_present = true;
    }
    *candidate = range_capture_candidate{.declaration = declaration, .expansion = expansion,
                                          .binding = binding};
    return true;
}

// `for (T x : c) B` (spec/fir.md 9.3): the place of `c`, then the counter `_i: u64 = const u64 0`;
// the blocks head, body, step and done; `_c = lt(copy _i, len)` and `switch(copy _c)` in head;
// `live(_x)` and `_x = copy c[_i]` in body, inside the scope of kind `loop` of `B`, whose `break`
// goes to done, whose `continue` goes to step, and whose every exit ends `x`; `_i = add(copy _i,
// const u64 1)` in step. The counter never passes the length, so neither the index nor the `add`
// needs a check. `x` has the element type without its outermost `own`, so the copy lends
// (D17.10). The statements of the loop stand at the `for`, `live(_x)` at the name, and the copy of
// the element at `c`.
fn lower_range_for(lowerer mut* lw, ast.node* n) bool {
    if (cast(lw->next_range_expansion, u64) >= fir.U32_LIMIT) {
        panic("fir_lower.lower_range_for: too many expansions");
    }
    lw->next_range_expansion += 1;
    u32 declaration = range_declaration_id(lw, n);
    u32 expansion = lw->next_range_expansion;
    fir.place mut c = fir.place{};
    range_capture_candidate mut candidate = range_capture_candidate{};
    if (!range_collection(lw, n->b, declaration, expansion, &c, &candidate)) {
        return false;
    }
    candidate.occurrence = fir.range_expansion{expansion, declaration, lw->defer_context,
                                                lw->exit_occurrence, n->loc, lw->exit_at};
    candidate.loan = fir.range_loan{.id = expansion, .expansion = expansion,
                                     .whole_body = true};
    u64 mut depth = lw->scopes.len;
    while (depth > 0) {
        depth -= 1;
        if (lw->scopes.items[depth].range_loan != 0) {
            candidate.loan.parent = lw->scopes.items[depth].range_loan;
            candidate.loan.parent_present = true;
            break;
        }
    }
    range_capture_candidate_add(&lw->range_candidates.captures, candidate);
    range_boundary_record(lw, expansion, fir.range_boundary_kind.capture, n->b->loc);
    types.node* wide = u64_ty(lw);
    u32 i = fir.local_add(lw->f, wide, fir.local_kind.lk_temp, null, n->loc);
    fir.place counter = fir.place_local(i);
    fir.operand index = fir.operand_copy(counter);
    assign(lw, counter, fir.rvalue_use(lw->f, int_const(wide, false, 0)), n->loc);
    u32 head = fir.block_new(lw->f);
    u32 body = fir.block_new(lw->f);
    u32 step = fir.block_new(lw->f);
    u32 done = fir.block_new(lw->f);
    jump(lw, head, n->loc);
    lw->block = head;
    fir.rvalue below = fir.rvalue_binary(lw->f, fir.rvalue_kind.rv_lt, index, length_of(lw, c));
    branch(lw, into_temp(lw, bool_ty(lw), below, n->loc), body, done, n->loc);
    lw->block = body;
    range_boundary_record(lw, expansion, fir.range_boundary_kind.body_entry, n->loc);
    // `x` belongs to the scope of the body: each iteration starts it, and each exit of the body
    // ends it
    scope_push(lw, scope_kind.sc_loop, done, step);
    lw->scopes.items[lw->scopes.len - 1].range_loan = expansion;
    u32 x = local_of(lw, n->sym);
    live(lw, x, n->name_loc);
    fir.operand element = fir.operand_copy(fir.place_index(lw->f, c, i));
    assign(lw, fir.place_local(x), fir.rvalue_use(lw->f, element), n->b->loc);
    if (!lower_statements(lw, n->c) || !close_scope(lw, end_of(n->c))) {
        return false;
    }
    if (!terminated(lw)) {
        jump(lw, step, n->loc);
    }
    lw->block = step;
    fir.operand one = int_const(wide, false, 1);
    assign(lw, counter, fir.rvalue_binary(lw->f, fir.rvalue_kind.rv_add, index, one), n->loc);
    jump(lw, head, n->loc);
    lw->block = done;
    return true;
}

// The clause of the switch `n` that is its `default`, or the count of its clauses when it has
// none.
fn default_clause(ast.node* n) u64 {
    u64 clauses = ast.ast_len(n);
    u64 mut i = 0;
    while (i < clauses) {
        if ((ast.ast_child(n, i)->flags & ast.FLAG_DEFAULT) != 0) {
            return i;
        }
        i += 1;
    }
    return clauses;
}

// `switch (e) { ... }` (spec/fir.md 9.3, D7.6, D7.7): the operand `a` of `e`, and for an enum
// without `default` `_v = cast<i64>(a)`. Then the blocks: first the block of `fail(enum, copy _v,
// const bytes "<name>")` for such an enum, then one block for each clause in clause order, then
// done. `switch(a)` has one arm for each label, with the value that the checker folded, and names
// as `otherwise` the `default` clause, the fail block or done. Each clause body is a scope of kind
// `case` whose `break` goes to done, and a clause that does not end in a terminator goes to done,
// since no clause falls through. The statements of the `switch` itself stand at the keyword. The
// parser gives a `switch` no child but its clauses.
fn lower_switch(lowerer mut* lw, ast.node* n) bool {
    fir.operand mut a = fir.operand{};
    if (!lower_operand(lw, n->a, &a)) {
        return false;
    }
    u64 clauses = ast.ast_len(n);
    u64 fallback = default_clause(n);
    types.node* ot = n->a->ty;
    bool fails = fallback == clauses && ot->kind == types.type_kind.k_enum;
    fir.operand mut value = fir.operand{};
    u32 mut fail_block = 0;
    if (fails) {
        value = signed_copy(lw, a, n->loc);
        fail_block = fir.block_new(lw->f);
    }
    u32 first = fir.block_count(lw->f);
    u64 mut i = 0;
    while (i < clauses) {
        fir.block_new(lw->f);
        i += 1;
    }
    u32 done = fir.block_new(lw->f);
    u32 mut otherwise = done;
    if (fails) {
        otherwise = fail_block;
    } else if (fallback < clauses) {
        otherwise = first + cast(fallback, u32);
    }
    u32 arms = cast(lw->f->arms.len, u32);
    u32 mut count = 0;
    i = 0;
    while (i < clauses) {
        ast.node* clause = ast.ast_child(n, i);
        u64 mut k = 0;
        while (k < ast.ast_len(clause)) {
            consts.cval label = check.check_node_value(lw->ck, ast.ast_child(clause, k));
            fir.arm_push(lw->f, label, first + cast(i, u32));
            count += 1;
            k += 1;
        }
        i += 1;
    }
    terminate(lw, fir.term_switch(a, arms, count, otherwise, n->loc, lw->stmt));
    if (fails) {
        lw->block = fail_block;
        u32 reported = fir.operand_push(lw->f, value);
        fir.operand_push(lw->f, fir.operand_const(fir.const_bytes(ot->name)));
        terminate(lw, fir.term_fail(fir.check_kind.chk_enum, reported, 2, n->loc, lw->stmt));
    }
    i = 0;
    while (i < clauses) {
        lw->block = first + cast(i, u32);
        if (!lower_scope(lw, ast.ast_child(n, i)->a, scope_kind.sc_case, done, 0)) {
            return false;
        }
        if (!terminated(lw)) {
            jump(lw, done, n->loc);
        }
        i += 1;
    }
    lw->block = done;
    return true;
}

// `break` and `continue` (spec/fir.md 9.3, 9.5): the unwind stops at the first scope of kind
// `loop` or `case` for `break`, and at the first scope of kind `loop` for `continue`, so a
// `continue` in a clause reaches the loop around the `switch` (D7.6). Then `goto` the target of
// that scope, at the keyword, unless a deferred statement ended the block.
fn lower_exit(lowerer mut* lw, ast.node* n, exit_kind x) bool {
    u64 mut stop = 0;
    if (!unwind(lw, n, x, &stop)) {
        return false;
    }
    if (terminated(lw)) {
        return true;
    }
    scope s = lw->scopes.items[stop];
    u32 mut target = s.break_target;
    if (x == exit_kind.x_continue) {
        target = s.continue_target;
    }
    jump(lw, target, n->loc);
    return true;
}

// `return e` (spec/fir.md 9.6): `e` into `_0`, the unwind, and `return` at the keyword. For
// ANN_MOVE the operand is `move _x` of the local that `e` names (D17.5), so a deferred statement
// that reads `x` sees the zero value (D7.8). An aggregate `_0` is the storage of the caller, so
// while a deferred statement is open in any scope, `e` goes into a temporary of the type of `_0`
// first, and `_0 = move _t` or `_0 = copy _t` follows the unwind at the keyword. A deferred
// statement that ends the block ends the lowering of the `return`.
fn lower_return(lowerer mut* lw, ast.node* n) bool {
    types.node* rt = fir.local_at(lw->f, 0)->ty;
    bool through = n->a != null && fir.type_aggregate(rt) && lw->defers.len > 0;
    u32 mut held = 0;
    if (n->a != null) {
        fir.place mut dst = fir.place_local(0);
        if (through) {
            held = fir.local_add(lw->f, rt, fir.local_kind.lk_temp, null, n->a->loc);
            dst = fir.place_local(held);
        }
        if ((n->ann & check.ANN_MOVE) != 0) {
            fir.place mut x = fir.place{};
            if (!name_place(lw, n->a, &x)) {
                panic("fir_lower.lower_return: an implicit move of no local");
            }
            assign(lw, dst, fir.rvalue_use(lw->f, fir.operand_move(x)), n->a->loc);
        } else if (!lower_into(lw, n->a, dst)) {
            return false;
        }
    }
    u64 mut stop = 0;
    if (!unwind(lw, n, exit_kind.x_return, &stop)) {
        return false;
    }
    if (terminated(lw)) {
        return true;
    }
    if (through) {
        fir.rvalue result = fir.rvalue_use(lw->f, read_temp(held, rt));
        assign(lw, fir.place_local(0), result, n->loc);
    }
    terminate(lw, fir.term_return(n->loc, lw->stmt));
    return true;
}

// ---- operands ---------------------------------------------------------------------------------

// Lowers the expression `n` to an operand in *out (spec/fir.md 9.4): a `const` for a folded
// constant, `copy p` for a place, `move p` for `move(lv)`, and a temporary for an operation. An
// operand of an aggregate type is a place, which aggregate_operand gives.
fn lower_operand(lowerer mut* lw, ast.node* n, fir.operand mut* out) bool {
    if (fir.type_aggregate(n->ty)) {
        return aggregate_operand(lw, n, out);
    }
    if ((n->ann & check.ANN_CONST) != 0) {
        *out = fir.operand_const(constant_of(n->ty, check.check_node_value(lw->ck, n)));
        return true;
    }
    switch (n->kind) {
    case ast.ast_kind.k_ident, ast.ast_kind.k_field, ast.ast_kind.k_arrow,
        ast.ast_kind.k_index:
        return lower_name(lw, n, out);
    case ast.ast_kind.k_unary:
        return lower_unary(lw, n, out);
    case ast.ast_kind.k_binary:
        return lower_binary(lw, n, out);
    case ast.ast_kind.k_ternary:
        return lower_ternary(lw, n, out);
    case ast.ast_kind.k_cast:
        return lower_cast(lw, n, out);
    case ast.ast_kind.k_call:
        if ((n->ann & check.ANN_MOVE) != 0) {
            return lower_move(lw, n, out);
        }
        return lower_call_value(lw, n, out);
    case ast.ast_kind.k_brace_init:
        // `{}` of an enum, which the checker allows for no other scalar
        *out = fir.operand_const(fir.const_zero(n->ty));
        return true;
    case ast.ast_kind.k_new:
        // `new(T)`: one zero `T`, whose address is a scalar (D10.2)
        types.node* one = n->ty->elem;
        fir.operand count = int_const(u64_ty(lw), false, 1);
        *out = into_temp(lw, n->ty, fir.rvalue_alloc(lw->f, one, count), n->loc);
        return true;
    default:
        return unsupported(lw, n);
    }
}

// The constant of the folded value `v` of the scalar type `t` (spec/fir.md 5.6): the bits of a
// float, `true` or `false`, `null T`, and `T v` of an integer, a `char` or an enum. The checker
// gives a constant the value of its type when a context fixes that type, so an integer in a float
// type is already a float.
fn constant_of(types.node* t, consts.cval v) fir.constant {
    if (types.type_is_float(t) != consts.cv_is_float(v)) {
        panic("fir_lower.constant_of: a folded value of another kind than its type");
    }
    switch (v.kind) {
    case consts.cval_kind.cv_float:
        return fir.const_float(t, v);
    case consts.cval_kind.cv_bool:
        return fir.const_bool(v.mag != 0);
    case consts.cval_kind.cv_null:
        return fir.const_null(t);
    case consts.cval_kind.cv_int, consts.cval_kind.cv_char:
        return fir.const_int(t, v);
    default:
        panic("fir_lower.constant_of: a folded value with no scalar constant");
    }
}

// An expression of an aggregate type as an operand, which is a place (spec/fir.md 6, D19.3):
// `move p` for `move(lv)`, `copy p` for an expression that designates storage, and else the value
// in a new temporary, read by `move _t` when it owns. A folded string constant goes into a
// temporary, since a constant of an aggregate type fills a place and is no operand of one.
fn aggregate_operand(lowerer mut* lw, ast.node* n, fir.operand mut* out) bool {
    return built_operand(lw, n, false, out);
}

// aggregate_operand, where `zeroing` says that the value is a member of a literal or the operand
// of a cast, which the translator copies whole into its destination. Then a new temporary of a
// type with padding is `const zero` first, so that the copy writes zero padding into a designated
// literal, whose padding is zero (D6.5), and never stale bytes. A designated literal and a cast
// write the whole temporary, so they need no zero first.
fn built_operand(lowerer mut* lw, ast.node* n, bool zeroing, fir.operand mut* out) bool {
    if (n->kind == ast.ast_kind.k_call && (n->ann & check.ANN_MOVE) != 0) {
        return lower_move(lw, n, out);
    }
    if (designates(n) && !string_constant(lw, n)) {
        fir.place mut p = fir.place{};
        if (!lower_place(lw, n, &p)) {
            return false;
        }
        *out = fir.operand_copy(p);
        return true;
    }
    u32 t = fir.local_add(lw->f, n->ty, fir.local_kind.lk_temp, null, n->loc);
    if (zeroing && fir.type_padded(n->ty) && !writes_whole(n)) {
        fir.operand zero = fir.operand_const(fir.const_zero(n->ty));
        assign(lw, fir.place_local(t), fir.rvalue_use(lw->f, zero), n->loc);
    }
    if (!lower_into(lw, n, fir.place_local(t))) {
        return false;
    }
    *out = read_temp(t, n->ty);
    return true;
}

// Whether the value `n` writes every byte of its destination: a designated literal, `{.f = v}` or
// `T{.f = v}`, which `llvm.memset` zeroes first, or a cast, which `llvm.memcpy` copies.
fn writes_whole(ast.node* n) bool {
    if (n->kind == ast.ast_kind.k_cast) {
        return true;
    }
    ast.node* mut list = n;
    if (n->kind == ast.ast_kind.k_struct_lit) {
        list = n->b;
    }
    return list->kind == ast.ast_kind.k_brace_init && (list->flags & ast.FLAG_DESIGNATED) != 0;
}

// Whether the checker folded `n` to a string constant.
fn string_constant(lowerer* lw, ast.node* n) bool {
    return (n->ann & check.ANN_CONST) != 0
        && check.check_node_value(lw->ck, n).kind == consts.cval_kind.cv_str;
}

// A name, a field, `->`, `*p` or an index: `copy p` of its place, or `const fn m.f` of a function.
// The checker gives a name or a field node the symbol of a declaration when the node is a name,
// `m.NAME` or `m.f`.
fn lower_name(lowerer mut* lw, ast.node* n, fir.operand mut* out) bool {
    bool named = n->kind == ast.ast_kind.k_ident || n->kind == ast.ast_kind.k_field;
    if (named && n->sym != null && n->sym->kind == ast.sym_kind.s_fn) {
        *out = fir.operand_const(fir.const_fn(n->sym));
        return true;
    }
    fir.place mut p = fir.place{};
    if (!lower_place(lw, n, &p)) {
        return false;
    }
    *out = fir.operand_copy(p);
    return true;
}

// `move(lv)`: the operand `move p` (spec/fir.md 9.4). The checker lets `move` take an owning
// lvalue that it may empty, and nothing else.
fn lower_move(lowerer mut* lw, ast.node* n, fir.operand mut* out) bool {
    fir.place mut p = fir.place{};
    if (!lower_place(lw, ast.ast_child(n, 0), &p)) {
        return false;
    }
    *out = fir.operand_move(p);
    return true;
}

// `-x`: `sub(const 0, x)` with the overflow check for an integer, and `fneg(x)` for a float. `!x`
// on a `bool` and `~x` on an integer: `not(x)`. `*p`: `copy (*q)`. `&lv`: `addr(p)`, or `addr
// mut(p)` when the checker typed a `mut` pointer (spec/fir.md 9.4).
fn lower_unary(lowerer mut* lw, ast.node* n, fir.operand mut* out) bool {
    lexer.tok_kind op = cast(n->op, lexer.tok_kind);
    if (op == lexer.tok_kind.star) {
        return lower_name(lw, n, out);
    }
    if (op == lexer.tok_kind.amp) {
        fir.place mut p = fir.place{};
        if (!lower_place(lw, n->a, &p)) {
            return false;
        }
        *out = into_temp(lw, n->ty, fir.rvalue_addr(lw->f, p, n->ty->is_mut), n->loc);
        return true;
    }
    fir.operand mut a = fir.operand{};
    if (!lower_operand(lw, n->a, &a)) {
        return false;
    }
    if (op != lexer.tok_kind.minus) {
        *out = into_temp(lw, n->ty, fir.rvalue_unary(lw->f, fir.rvalue_kind.rv_not, a), n->loc);
    } else if (types.type_is_float(n->ty)) {
        *out = into_temp(lw, n->ty, fir.rvalue_unary(lw->f, fir.rvalue_kind.rv_fneg, a), n->loc);
    } else {
        fir.operand zero = fir.operand_const(fir.const_int(n->ty, consts.cv_from_u64(0)));
        fir.rvalue r = checked(lw, fir.rvalue_kind.rv_sub, n->ty, zero, a, n->loc);
        *out = into_temp(lw, n->ty, r, n->loc);
    }
    return true;
}

// ---- places -----------------------------------------------------------------------------------

// Whether the form of `n` designates storage: a name, a field, `->`, `*p` or an index. The
// operand of such a form may still be an rvalue, which lower_place copies into a temporary first.
fn designates(ast.node* n) bool {
    switch (n->kind) {
    case ast.ast_kind.k_ident, ast.ast_kind.k_field, ast.ast_kind.k_arrow,
        ast.ast_kind.k_index:
        return true;
    case ast.ast_kind.k_unary:
        return cast(n->op, lexer.tok_kind) == lexer.tok_kind.star;
    default:
        return false;
    }
}

/// Lowers the expression `n` to the place that it designates, in *out (spec/fir.md 9.4, 5.5): a
/// name, a field by its declaration index, `(*q).k` for `->`, `(*q)` for `*p`, and `a[_i]` after
/// the bounds check. An aggregate expression that designates no storage goes into a new temporary,
/// which is then the place (D6.7).
fn lower_place(lowerer mut* lw, ast.node* n, fir.place mut* out) bool {
    switch (n->kind) {
    case ast.ast_kind.k_ident:
        if (name_place(lw, n, out)) {
            return true;
        }
    case ast.ast_kind.k_field:
        return field_place(lw, n, out);
    case ast.ast_kind.k_arrow:
        fir.place mut target = fir.place{};
        if (!deref_place(lw, n->a, &target)) {
            return false;
        }
        *out = project_field(lw, n, target);
        return true;
    case ast.ast_kind.k_index:
        return index_place(lw, n, out);
    case ast.ast_kind.k_unary:
        if (cast(n->op, lexer.tok_kind) == lexer.tok_kind.star) {
            return deref_place(lw, n->a, out);
        }
    default:
        break;
    }
    if (!fir.type_aggregate(n->ty)) {
        // a place of a scalar is an lvalue, and the checker gives every lvalue one of the forms
        // above (D6.7)
        panic("fir_lower.lower_place: a scalar that designates no storage");
    }
    u32 t = fir.local_add(lw->f, n->ty, fir.local_kind.lk_temp, null, n->loc);
    *out = fir.place_local(t);
    return lower_into(lw, n, *out);
}

// The place of the name `n` in *out: `_n` of a parameter or a named local, or `global m.NAME` of
// a module-level constant or global. False for any other node.
fn name_place(lowerer* lw, ast.node* n, fir.place mut* out) bool {
    if ((n->kind != ast.ast_kind.k_ident && n->kind != ast.ast_kind.k_field) || n->sym == null) {
        return false;
    }
    ast.sym* s = n->sym;
    if (s->kind == ast.sym_kind.s_local || s->kind == ast.sym_kind.s_param) {
        *out = fir.place_local(local_of(lw, s));
        return true;
    }
    if (s->kind == ast.sym_kind.s_const || s->kind == ast.sym_kind.s_global) {
        *out = fir.place_global(s);
        return true;
    }
    return false;
}

// `a.f`: the global of `m.NAME`, or the field of the place of `a`.
fn field_place(lowerer mut* lw, ast.node* n, fir.place mut* out) bool {
    if (name_place(lw, n, out)) {
        return true;
    }
    fir.place mut base = fir.place{};
    if (!lower_place(lw, n->a, &base)) {
        return false;
    }
    *out = project_field(lw, n, base);
    return true;
}

// The field that `n` names of the struct, span or `string` at `base`: `.ptr` and `.len` of a
// header are fields 0 and 1, and a struct field is its declaration index (spec/fir.md 5.5).
fn project_field(lowerer mut* lw, ast.node* n, fir.place base) fir.place {
    types.node* t = fir.place_type(lw->f, base);
    if (t->kind == types.type_kind.k_span || t->kind == types.type_kind.k_string) {
        if (n->name == "len") {
            return fir.place_field(lw->f, base, LEN_FIELD);
        }
        return fir.place_field(lw->f, base, PTR_FIELD);
    }
    u64 mut k = 0;
    if (!gen.gen_field_index(n->sym, &k)) {
        panic("fir_lower.project_field: a field with no declaration index");
    }
    return fir.place_field(lw->f, base, cast(k, u32));
}

// `(*q)`, where `q` holds the value of the pointer expression `p` (spec/fir.md 9.4): the place
// that the operand of `p` reads, which is the place of `p` itself when `p` designates storage and a
// temporary when `p` is an operation. A folded constant, such as a module constant that holds
// `null`, goes into a temporary first.
fn deref_place(lowerer mut* lw, ast.node* p, fir.place mut* out) bool {
    fir.operand mut v = fir.operand{};
    if (!lower_operand(lw, p, &v)) {
        return false;
    }
    if (v.kind == fir.operand_kind.ok_move) {
        // the checker refuses to dereference an owning rvalue, which would leave no owner
        panic("fir_lower.deref_place: a pointer that owns");
    }
    fir.place mut q = v.place;
    if (v.kind == fir.operand_kind.ok_const) {
        u32 t = fir.local_add(lw->f, p->ty, fir.local_kind.lk_temp, null, p->loc);
        assign(lw, fir.place_local(t), fir.rvalue_use(lw->f, v), p->loc);
        q = fir.place_local(t);
    }
    *out = fir.place_deref(lw->f, q);
    return true;
}

// The length of the fixed array, span or `string` at `base`: `const u64 N` for a fixed array, and
// `copy base.1` for a header.
fn length_of(lowerer mut* lw, fir.place base) fir.operand {
    types.node* t = fir.place_type(lw->f, base);
    if (t->kind == types.type_kind.k_array) {
        return int_const(u64_ty(lw), false, t->len);
    }
    return fir.operand_copy(fir.place_field(lw->f, base, LEN_FIELD));
}

// `cast<i64>(a)` in a new temporary at `at`: the form in which a check reports an index or a bound.
fn signed_copy(lowerer mut* lw, fir.operand a, diag.loc at) fir.operand {
    types.node* t = i64_ty(lw);
    return into_temp(lw, t, fir.rvalue_cast(lw->f, t, a), at);
}

// `a[i]` (spec/fir.md 9.4, D6.8): the place of `a`, held when `i` holds a writer, then `_i =
// cast<u64>(i)`, which sign-extends a signed index so that a negative index fails the one unsigned
// compare, `_f = ge(copy _i, len)`, and `check(copy _f, bounds, cast<i64>(copy _i), len)` at the
// `[`. The place is `a[_i]` in the continuation.
fn index_place(lowerer mut* lw, ast.node* n, fir.place mut* out) bool {
    fir.place mut base = fir.place{};
    if (!lower_place(lw, n->a, &base)) {
        return false;
    }
    base = hold_base(lw, base, contains_writer(n->b), n->a->loc);
    fir.operand mut i = fir.operand{};
    if (!lower_operand(lw, n->b, &i)) {
        return false;
    }
    types.node* wide = u64_ty(lw);
    u32 at = fir.local_add(lw->f, wide, fir.local_kind.lk_temp, null, n->loc);
    assign(lw, fir.place_local(at), fir.rvalue_cast(lw->f, wide, i), n->loc);
    fir.operand index = fir.operand_copy(fir.place_local(at));
    fir.operand len = length_of(lw, base);
    fir.rvalue past = fir.rvalue_binary(lw->f, fir.rvalue_kind.rv_ge, index, len);
    fir.operand flag = into_temp(lw, bool_ty(lw), past, n->loc);
    fir.operand reported = signed_copy(lw, index, n->loc);
    u32 first = fir.operand_push(lw->f, reported);
    fir.operand_push(lw->f, len);
    check_then(lw, flag, fir.check_kind.chk_bounds, first, 2, n->loc);
    *out = fir.place_index(lw->f, base, at);
    return true;
}

// A bound of a span expression, `_b = cast<u64>(e)` in a new temporary at `at`, as an index takes
// it.
fn span_bound(lowerer mut* lw, ast.node* e, diag.loc at, fir.operand mut* out) bool {
    fir.operand mut v = fir.operand{};
    if (!lower_operand(lw, e, &v)) {
        return false;
    }
    types.node* t = u64_ty(lw);
    *out = into_temp(lw, t, fir.rvalue_cast(lw->f, t, v), at);
    return true;
}

// `a[lo..hi]` into `dst` (spec/fir.md 9.4, D6.9). On a fixed array, a span or a `string`: the
// place of `a`, held when a bound holds a writer, each bound as a `u64`, `0` and the length for an
// absent bound, `_f = or(gt(lo, hi), gt(hi, len))`, `check(copy _f, span, lo, hi, len)` with the
// bounds as `i64`, then `slice(a, lo, hi)`, which is `slice mut` for a `mut` span of a fixed
// array. On a pointer: `slice_ptr(a, lo, hi)` with no check.
fn lower_span(lowerer mut* lw, ast.node* n, fir.place dst) bool {
    if (n->a->ty->kind == types.type_kind.k_ptr) {
        return lower_span_of_pointer(lw, n, dst);
    }
    fir.place mut base = fir.place{};
    if (!lower_place(lw, n->a, &base)) {
        return false;
    }
    base = hold_base(lw, base, contains_writer(n->b) || contains_writer(n->c), n->a->loc);
    fir.operand len = length_of(lw, base);
    fir.operand mut lo = int_const(u64_ty(lw), false, 0);
    fir.operand mut hi = len;
    if (n->b != null && !span_bound(lw, n->b, n->loc, &lo)) {
        return false;
    }
    if (n->c != null && !span_bound(lw, n->c, n->loc, &hi)) {
        return false;
    }
    types.node* flag = bool_ty(lw);
    fir.rvalue low_high = fir.rvalue_binary(lw->f, fir.rvalue_kind.rv_gt, lo, hi);
    fir.operand inverted = into_temp(lw, flag, low_high, n->loc);
    fir.rvalue high_len = fir.rvalue_binary(lw->f, fir.rvalue_kind.rv_gt, hi, len);
    fir.operand past = into_temp(lw, flag, high_len, n->loc);
    fir.rvalue either = fir.rvalue_binary(lw->f, fir.rvalue_kind.rv_or, inverted, past);
    fir.operand bad = into_temp(lw, flag, either, n->loc);
    fir.operand low = signed_copy(lw, lo, n->loc);
    fir.operand high = signed_copy(lw, hi, n->loc);
    u32 first = fir.operand_push(lw->f, low);
    fir.operand_push(lw->f, high);
    fir.operand_push(lw->f, len);
    check_then(lw, bad, fir.check_kind.chk_span, first, 3, n->loc);
    bool array = fir.place_type(lw->f, base)->kind == types.type_kind.k_array;
    assign(lw, dst, fir.rvalue_slice(lw->f, base, lo, hi, array && n->ty->is_mut), n->loc);
    return true;
}

// `p[lo..hi]` on a pointer: `slice_ptr(p, lo, hi)`, three operands of one rvalue under the
// materialization rule. The checker requires both bounds.
fn lower_span_of_pointer(lowerer mut* lw, ast.node* n, fir.place dst) bool {
    fir.operand mut p = fir.operand{};
    if (!lower_operand(lw, n->a, &p)) {
        return false;
    }
    p = materialize(lw, p, contains_writer(n->b) || contains_writer(n->c), n->a->loc);
    fir.operand mut lo = fir.operand{};
    if (!lower_operand(lw, n->b, &lo)) {
        return false;
    }
    lo = materialize(lw, lo, contains_writer(n->c), n->b->loc);
    fir.operand mut hi = fir.operand{};
    if (!lower_operand(lw, n->c, &hi)) {
        return false;
    }
    assign(lw, dst, fir.rvalue_slice_ptr(lw->f, p, lo, hi), n->loc);
    return true;
}

// ---- values written into a place --------------------------------------------------------------

/// Lowers the expression `n` into the place `dst` (spec/fir.md 9.4). A scalar stores its operand,
/// `dst = a`. An aggregate writes into `dst` itself: a literal as `aggregate` or `const zero`, a
/// string constant, a span expression, a call, `move(lv)`, a cast, a conditional, or `copy p` of
/// the place that it designates.
fn lower_into(lowerer mut* lw, ast.node* n, fir.place dst) bool {
    if (!fir.type_aggregate(n->ty)) {
        fir.operand mut v = fir.operand{};
        if (!lower_operand(lw, n, &v)) {
            return false;
        }
        assign(lw, dst, fir.rvalue_use(lw->f, v), n->loc);
        return true;
    }
    if (string_constant(lw, n)) {
        fir.constant text = fir.const_string(check.check_node_value(lw->ck, n).str);
        assign(lw, dst, fir.rvalue_use(lw->f, fir.operand_const(text)), n->loc);
        return true;
    }
    switch (n->kind) {
    case ast.ast_kind.k_brace_init:
        return lower_literal(lw, n, n->ty, dst, n->loc);
    case ast.ast_kind.k_struct_lit, ast.ast_kind.k_array_lit:
        return lower_literal(lw, n->b, n->ty, dst, n->loc);
    case ast.ast_kind.k_span:
        return lower_span(lw, n, dst);
    case ast.ast_kind.k_call:
        if ((n->ann & check.ANN_MOVE) != 0) {
            fir.operand mut moved = fir.operand{};
            if (!lower_move(lw, n, &moved)) {
                return false;
            }
            assign(lw, dst, fir.rvalue_use(lw->f, moved), n->loc);
            return true;
        }
        fir.rvalue mut r = fir.rvalue{};
        if (!call_rvalue(lw, n, &r)) {
            return false;
        }
        assign(lw, dst, r, n->loc);
        return true;
    case ast.ast_kind.k_cast:
        // a cast between aggregate types carries or drops marks, and never adds `own` (D3.14)
        fir.operand mut a = fir.operand{};
        if (!fir.type_aggregate(n->a->ty)) {
            if (!lower_operand(lw, n->a, &a)) {
                return false;
            }
        } else if (!built_operand(lw, n->a, true, &a)) {
            return false;
        }
        assign(lw, dst, fir.rvalue_cast(lw->f, n->ty, a), n->loc);
        return true;
    case ast.ast_kind.k_ternary:
        return lower_ternary_into(lw, n, dst);
    case ast.ast_kind.k_new:
        return lower_new_span(lw, n, dst);
    default:
        break;
    }
    if (!designates(n)) {
        return unsupported(lw, n);
    }
    fir.place mut p = fir.place{};
    if (!lower_place(lw, n, &p)) {
        return false;
    }
    assign(lw, dst, fir.rvalue_use(lw->f, fir.operand_copy(p)), n->loc);
    return true;
}

// `new(T, n)` into `dst` (spec/fir.md 9.4, D10.2): `_n = cast<i64>(n)`; for a signed count `_f =
// lt(copy _n, const i64 0)` and `check(copy _f, alloc_count, copy _n)`; then `_u = cast<u64>(copy
// _n)`, `_p = alloc<T>(copy _u)` and `dst = aggregate T mut@ own(move _p, copy _u)`. Each stands at
// the `new`, whose location the report of the count carries. An unsigned count is never negative,
// so it takes no check, and a zero count is legal.
fn lower_new_span(lowerer mut* lw, ast.node* n, fir.place dst) bool {
    fir.operand mut raw = fir.operand{};
    if (!lower_operand(lw, n->b, &raw)) {
        return false;
    }
    types.node* wide = i64_ty(lw);
    fir.operand count = into_temp(lw, wide, fir.rvalue_cast(lw->f, wide, raw), n->loc);
    if (prim.prim_is_signed(n->b->ty->prim)) {
        fir.rvalue below = fir.rvalue_binary(lw->f, fir.rvalue_kind.rv_lt, count,
                                             int_const(wide, false, 0));
        fir.operand negative = into_temp(lw, bool_ty(lw), below, n->loc);
        u32 first = fir.operand_push(lw->f, count);
        check_then(lw, negative, fir.check_kind.chk_alloc_count, first, 1, n->loc);
    }
    types.node* bits = u64_ty(lw);
    fir.operand size = into_temp(lw, bits, fir.rvalue_cast(lw->f, bits, count), n->loc);
    types.node* elem = n->ty->elem;
    fir.rvalue storage = fir.rvalue_alloc(lw->f, elem, size);
    fir.operand p = into_temp(lw, fir.rvalue_type(lw->f, storage), storage, n->loc);
    u32 first = fir.operand_push(lw->f, p);
    fir.operand_push(lw->f, size);
    assign(lw, dst, fir.rvalue_aggregate_new(n->ty, first, 2), n->loc);
    return true;
}

// The value of member `i` of the literal `n`: the child, or the value of a designator.
fn member_value(ast.node* n, u64 i) ast.node* {
    ast.node* c = ast.ast_child(n, i);
    if (c->kind == ast.ast_kind.k_designator) {
        return c->a;
    }
    return c;
}

// Whether `n` is an empty literal, `{}` or `T{}`, whose value is `const zero T` (D6.5).
fn empty_literal(ast.node* n) bool {
    if (n->kind == ast.ast_kind.k_brace_init) {
        return ast.ast_len(n) == 0;
    }
    bool typed = n->kind == ast.ast_kind.k_struct_lit || n->kind == ast.ast_kind.k_array_lit;
    return typed && ast.ast_len(n->b) == 0;
}

// Member `v` of a literal as an operand of its `aggregate` (spec/fir.md 9.4). A folded constant
// stands as a constant: a string constant as `const "..."`, and an empty literal as `const zero
// T`, which is also the operand of a field that a designated literal leaves out. Every other
// member is an operand, a place for an aggregate type, which a zeroed temporary holds when the
// lowering builds it (built_operand).
fn member_operand(lowerer mut* lw, ast.node* v, fir.operand mut* out) bool {
    if (string_constant(lw, v)) {
        string text = check.check_node_value(lw->ck, v).str;
        *out = fir.operand_const(fir.const_string(text));
        return true;
    }
    if (fir.type_aggregate(v->ty) && empty_literal(v)) {
        *out = fir.operand_const(fir.const_zero(v->ty));
        return true;
    }
    if (fir.type_aggregate(v->ty)) {
        return built_operand(lw, v, true, out);
    }
    return lower_operand(lw, v, out);
}

// The index among the fields or elements of member `i` of the literal `n`: its field index for a
// designator, and `i` for every other member.
fn member_slot(ast.node* n, u64 i) u64 {
    ast.node* c = ast.ast_child(n, i);
    if (c->kind != ast.ast_kind.k_designator) {
        return i;
    }
    u64 mut k = 0;
    if (!gen.gen_field_index(c->sym, &k)) {
        panic("fir_lower.member_slot: a designator with no field index");
    }
    return k;
}

// The brace initializer `n` of type `t` into `dst` (spec/fir.md 9.4, D6.5): `const zero T` for
// `{}`, and else `aggregate T(...)` with one operand for each field or element, in declaration or
// index order, and `const zero` for a field that a designated literal leaves out. A designated
// literal is `aggregate zeroed T(...)`, whose padding the translator zeroes. The members run in
// source order under the materialization rule (D6.3). The translator reads every operand before
// it writes `dst`, so a member that reads `dst` reads the old value (spec/fir.md 6).
fn lower_literal(lowerer mut* lw, ast.node* n, types.node* t, fir.place dst, diag.loc at)
    bool {
    u64 count = ast.ast_len(n);
    if (count == 0) {
        assign(lw, dst, fir.rvalue_use(lw->f, fir.operand_const(fir.const_zero(t))), at);
        return true;
    }
    u64 mut slots = t->len;
    if (t->kind == types.type_kind.k_struct) {
        slots = cast(fir.struct_field_count(t), u64);
    }
    fir.operand mut@ own members = new(fir.operand, slots);
    defer del(members);
    bool mut@ own given = new(bool, slots);
    defer del(given);
    bool mut@ own later = new(bool, count);
    defer del(later);
    writers_after(n, later);
    u64 mut i = 0;
    while (i < count) {
        ast.node* v = member_value(n, i);
        u64 k = member_slot(n, i);
        fir.operand mut m = fir.operand{};
        if (!member_operand(lw, v, &m)) {
            return false;
        }
        members[k] = materialize(lw, m, later[i], v->loc);
        given[k] = true;
        i += 1;
    }
    u32 first = cast(lw->f->ops.len, u32);
    u64 mut k = 0;
    while (k < slots) {
        if (given[k]) {
            fir.operand_push(lw->f, members[k]);
        } else {
            fir.constant zero = fir.const_zero(fir.struct_field_type(t, cast(k, u32)));
            fir.operand_push(lw->f, fir.operand_const(zero));
        }
        k += 1;
    }
    if ((n->flags & ast.FLAG_DESIGNATED) != 0) {
        // the designated form zeroes the whole value, padding included (D6.5)
        assign(lw, dst, fir.rvalue_aggregate_zeroed(t, first, cast(slots, u32)), at);
        return true;
    }
    assign(lw, dst, fir.rvalue_aggregate_new(t, first, cast(slots, u32)), at);
    return true;
}

// `c ? a : b` of an aggregate type into `dst`: the operand of `c`, `switch -> [true: then,
// otherwise: else]`, each arm into `dst`, then `goto done` at the `?` (spec/fir.md 9.4).
fn lower_ternary_into(lowerer mut* lw, ast.node* n, fir.place dst) bool {
    fir.operand mut c = fir.operand{};
    if (!lower_operand(lw, n->a, &c)) {
        return false;
    }
    u32 then_block = fir.block_new(lw->f);
    u32 else_block = fir.block_new(lw->f);
    u32 done = fir.block_new(lw->f);
    branch(lw, c, then_block, else_block, n->loc);
    lw->block = then_block;
    if (!lower_into(lw, n->b, dst)) {
        return false;
    }
    jump(lw, done, n->loc);
    lw->block = else_block;
    if (!lower_into(lw, n->c, dst)) {
        return false;
    }
    jump(lw, done, n->loc);
    lw->block = done;
    return true;
}

// ---- calls ------------------------------------------------------------------------------------

// Whether `n` calls a builtin of the universe: the print family, `assert`, `panic`, `del` or
// `move`.
fn builtin_call(ast.node* n) bool {
    return n->a != null && n->a->sym != null && n->a->sym->kind == ast.sym_kind.s_builtin;
}

// The call `n` of a fort function, an `extern fn` or a function value, in *out (spec/fir.md 9.4):
// the callee first when it is a value (D6.3), then each argument left to right, each under the
// materialization rule. An argument of an aggregate type is a place, an owning rvalue enters as
// `move _t`, and an owning place enters a parameter that does not own as `copy p` (D17.4, D17.5).
fn call_rvalue(lowerer mut* lw, ast.node* n, fir.rvalue mut* out) bool {
    u64 count = ast.ast_len(n);
    bool mut@ own later = new(bool, count);
    defer del(later);
    bool any = writers_after(n, later);
    ast.sym* s = n->a->sym;
    bool direct = s != null
        && (s->kind == ast.sym_kind.s_fn || s->kind == ast.sym_kind.s_extern_fn);
    fir.operand mut callee = fir.operand{};
    if (!direct) {
        if (!lower_operand(lw, n->a, &callee)) {
            return false;
        }
        callee = materialize(lw, callee, any, n->a->loc);
    }
    fir.operand mut@ own args = new(fir.operand, count);
    defer del(args);
    u64 mut i = 0;
    while (i < count) {
        ast.node* a = ast.ast_child(n, i);
        fir.operand mut v = fir.operand{};
        if (!lower_operand(lw, a, &v)) {
            return false;
        }
        args[i] = materialize(lw, v, later[i], a->loc);
        i += 1;
    }
    u32 first = cast(lw->f->ops.len, u32);
    i = 0;
    while (i < count) {
        fir.operand_push(lw->f, args[i]);
        i += 1;
    }
    u32 len = cast(count, u32);
    if (!direct) {
        *out = fir.rvalue_call_value(callee, first, len);
    } else if (s->kind == ast.sym_kind.s_extern_fn) {
        *out = fir.rvalue_call_extern(s, first, len);
    } else {
        *out = fir.rvalue_call_fn(s, first, len);
    }
    return true;
}

// A call in an operand position: its result in a new temporary of the type that the checker gave
// the call. A builtin has no value there.
fn lower_call_value(lowerer mut* lw, ast.node* n, fir.operand mut* out) bool {
    if (builtin_call(n)) {
        return unsupported(lw, n);
    }
    fir.rvalue mut r = fir.rvalue{};
    if (!call_rvalue(lw, n, &r)) {
        return false;
    }
    *out = into_temp(lw, n->ty, r, n->loc);
    return true;
}

// A call statement (spec/fir.md 9.3): a builtin as lower_builtin writes it, and every other call
// into a new temporary that nothing reads, of type `void` for a `void` result. A `noreturn` callee
// ends the block with `trap` right after the call (D8.5, rule V8).
fn lower_call_stmt(lowerer mut* lw, ast.node* n) bool {
    if (builtin_call(n)) {
        return lower_builtin(lw, n);
    }
    fir.rvalue mut r = fir.rvalue{};
    if (!call_rvalue(lw, n, &r)) {
        return false;
    }
    types.node* t = fir.rvalue_type(lw->f, r);
    u32 sink = fir.local_add(lw->f, t, fir.local_kind.lk_temp, null, n->loc);
    assign(lw, fir.place_local(sink), r, n->loc);
    if (fir.callee_type(lw->f, r)->is_noreturn) {
        terminate(lw, fir.term_trap(n->loc, lw->stmt));
    }
    return true;
}

// ---- builtins ---------------------------------------------------------------------------------

// The builtin call `n` as a statement: the print family, `assert`, `panic` and `del` (spec/fir.md
// 9.4). The checker refuses a `move` whose value no one reads (D17.8).
fn lower_builtin(lowerer mut* lw, ast.node* n) bool {
    string name = n->a->sym->name;
    bool out = name == "print" || name == "println";
    bool err = name == "eprint" || name == "eprintln";
    bool newline = name == "println" || name == "eprintln" || name == "fprintln";
    if (out || err) {
        u64 mut fd = FD_STDERR;
        if (out) {
            fd = FD_STDOUT;
        }
        return lower_print(lw, n, int_const(prim_ty(lw, prim.prim_kind.prim_i32), false, fd), 0,
                           newline);
    }
    if (name == "fprint" || name == "fprintln") {
        bool mut@ own later = new(bool, ast.ast_len(n));
        defer del(later);
        writers_after(n, later);
        ast.node* d = ast.ast_child(n, 0);
        fir.operand mut fd = fir.operand{};
        if (!lower_operand(lw, d, &fd)) {
            return false;
        }
        return lower_print(lw, n, materialize(lw, fd, later[0], d->loc), 1, newline);
    }
    if (name == "assert") {
        return lower_assert(lw, n);
    }
    if (name == "panic") {
        return lower_panic(lw, n);
    }
    if (name == "del") {
        return lower_del(lw, n);
    }
    return unsupported(lw, n);
}

// `del(e)` at the name `del` (spec/fir.md 9.4, D17.9): `del(move p)` of the place of an lvalue,
// with its index checks first, which empties the place; for an rvalue, `_t = e` and then `del(move
// _t)`, which only frees.
fn lower_del(lowerer mut* lw, ast.node* n) bool {
    ast.node* e = ast.ast_child(n, 0);
    fir.place mut p = fir.place{};
    if ((e->ann & check.ANN_LVALUE) != 0) {
        if (!lower_place(lw, e, &p)) {
            return false;
        }
    } else {
        u32 mut t = 0;
        if (!owning_temp(lw, e, &t)) {
            return false;
        }
        p = fir.place_local(t);
    }
    append(lw, fir.stmt_del(p, n->a->loc, lw->stmt));
    return true;
}

// The name of the runtime function of `k`.
fn print_name(print_kind k) string {
    switch (k) {
    case print_kind.pk_i64:
        return "print_i64";
    case print_kind.pk_u64:
        return "print_u64";
    case print_kind.pk_bool:
        return "print_bool";
    case print_kind.pk_char:
        return "print_char";
    case print_kind.pk_ptr:
        return "print_ptr";
    case print_kind.pk_str:
        return "print_str";
    case print_kind.pk_enum:
        return "print_enum";
    case print_kind.pk_f32:
        return "print_f32";
    case print_kind.pk_f64:
        return "print_f64";
    }
}

// The runtime function of `k`, or null when the closure holds none, as a sandbox of a test may.
// The first call finds every print function in one pass over the symbols.
fn print_entry(lowerer mut* lw, print_kind k) ast.sym* {
    if (!lw->prints_known) {
        u64 mut i = 0;
        while (i < check.check_sym_count(lw->ck)) {
            ast.sym* s = check.check_sym_at(lw->ck, i);
            if (runtime_function(s)) {
                u64 mut j = 0;
                while (j < PRINT_KINDS) {
                    if (s->name == print_name(cast(j, print_kind))) {
                        lw->prints[j] = s;
                    }
                    j += 1;
                }
            }
            i += 1;
        }
        lw->prints_known = true;
    }
    return lw->prints[cast(k, u64)];
}

// Whether `s` is a function of the module std.rt.
fn runtime_function(ast.sym* s) bool {
    return s->kind == ast.sym_kind.s_fn && s->owner != null
        && s->owner->kind == ast.sym_kind.s_module && s->owner->name == RUNTIME_MODULE;
}

// The type of parameter `i` of the runtime function `s`.
fn param_type(ast.sym* s, u64 i) types.node* {
    return s->ty->params[i];
}

// `_t = call fn std.rt.<entry>(...)` in a new `void` temporary at `at`, over the `len` operands
// that operand_push placed from `first`.
fn call_runtime(lowerer mut* lw, ast.sym* entry, u32 first, u32 len, diag.loc at) void {
    fir.rvalue r = fir.rvalue_call_fn(entry, first, len);
    u32 sink = fir.local_add(lw->f, fir.rvalue_type(lw->f, r), fir.local_kind.lk_temp, null, at);
    assign(lw, fir.place_local(sink), r, at);
}

// The print family (spec/fir.md 9.4, spec/toolchain.md 6 item 19): for each argument from `first`,
// left to right, one call of the print function of its type, which receives `fd` and the argument
// in the form that it takes. The `ln` forms end with `print_char(fd, const char 10)`. `fd` is an
// operand that the caller evaluated once.
fn lower_print(lowerer mut* lw, ast.node* n, fir.operand fd, u64 first, bool newline) bool {
    u64 mut i = first;
    while (i < ast.ast_len(n)) {
        if (!lower_print_arg(lw, ast.ast_child(n, i), fd)) {
            return false;
        }
        i += 1;
    }
    if (!newline) {
        return true;
    }
    ast.sym* entry = print_entry(lw, print_kind.pk_char);
    if (entry == null) {
        return no_runtime(lw, n, print_name(print_kind.pk_char));
    }
    fir.constant nl = fir.const_int(param_type(entry, 1), consts.cv_from_char(NEWLINE));
    u32 at = fir.operand_push(lw->f, fd);
    fir.operand_push(lw->f, fir.operand_const(nl));
    call_runtime(lw, entry, at, 2, n->loc);
    return true;
}

// The print function of the type `t`.
fn print_kind_of(types.node* t) print_kind {
    switch (t->kind) {
    case types.type_kind.k_string:
        return print_kind.pk_str;
    case types.type_kind.k_enum:
        return print_kind.pk_enum;
    case types.type_kind.k_ptr, types.type_kind.k_voidptr, types.type_kind.k_fn:
        return print_kind.pk_ptr;
    default:
        break;
    }
    switch (t->prim) {
    case prim.prim_kind.prim_bool:
        return print_kind.pk_bool;
    case prim.prim_kind.prim_char:
        return print_kind.pk_char;
    case prim.prim_kind.prim_f32:
        return print_kind.pk_f32;
    case prim.prim_kind.prim_f64:
        return print_kind.pk_f64;
    default:
        break;
    }
    if (prim.prim_is_signed(t->prim)) {
        return print_kind.pk_i64;
    }
    return print_kind.pk_u64;
}

// The operand `v` in the type `t` of a parameter: `v` itself when the two types agree, and else
// `cast<t>(v)` in a new temporary at `at`.
fn converted(lowerer mut* lw, fir.operand v, types.node* t, diag.loc at) fir.operand {
    if (types.type_same_shape(fir.operand_type(lw->f, v), t)) {
        return v;
    }
    return into_temp(lw, t, fir.rvalue_cast(lw->f, t, v), at);
}

// One print argument `a`: a `string` as its pointer and its length, an enum as `cast<i32>(a)`,
// `const enum_table m.E` and its member count, a pointer or a function as `void*`, a signed
// integer as `i64` and an unsigned one as `u64`, and a `bool`, a `char` or a float as it stands.
// Each call stands at the argument.
fn lower_print_arg(lowerer mut* lw, ast.node* a, fir.operand fd) bool {
    print_kind k = print_kind_of(a->ty);
    ast.sym* entry = print_entry(lw, k);
    if (entry == null) {
        return no_runtime(lw, a, print_name(k));
    }
    if (k == print_kind.pk_str) {
        fir.operand mut ptr = fir.operand{};
        fir.operand mut len = fir.operand{};
        if (!string_parts(lw, a, &ptr, &len)) {
            return false;
        }
        u32 first = fir.operand_push(lw->f, fd);
        fir.operand_push(lw->f, ptr);
        fir.operand_push(lw->f, len);
        call_runtime(lw, entry, first, 3, a->loc);
        return true;
    }
    fir.operand mut v = fir.operand{};
    if (!lower_operand(lw, a, &v)) {
        return false;
    }
    fir.operand value = converted(lw, v, param_type(entry, 1), a->loc);
    u32 first = fir.operand_push(lw->f, fd);
    fir.operand_push(lw->f, value);
    if (k != print_kind.pk_enum) {
        call_runtime(lw, entry, first, 2, a->loc);
        return true;
    }
    ast.sym* e = check.nominal_sym(a->ty);
    fir.constant table = fir.const_enum_table(e, param_type(entry, 2));
    fir.operand_push(lw->f, fir.operand_const(table));
    fir.operand_push(lw->f, int_const(param_type(entry, 3), false, gen.gen_enum_count(e)));
    call_runtime(lw, entry, first, 4, a->loc);
    return true;
}

// The pointer and the length of the `string` expression `m`, in *ptr and *len: `const bytes
// "..."` and its length for a folded constant, which the call passes as a literal, and else
// `copy p.0` and `copy p.1` of the place of `m`.
fn string_parts(lowerer mut* lw, ast.node* m, fir.operand mut* ptr, fir.operand mut* len) bool {
    if (string_constant(lw, m)) {
        string text = check.check_node_value(lw->ck, m).str;
        *ptr = fir.operand_const(fir.const_bytes(text));
        *len = int_const(u64_ty(lw), false, text.len);
        return true;
    }
    fir.operand mut v = fir.operand{};
    if (!aggregate_operand(lw, m, &v)) {
        return false;
    }
    if (v.kind != fir.operand_kind.ok_copy) {
        // the checker gives a print argument and `panic` no owning rvalue, which would leak
        panic("fir_lower.string_parts: a string that owns");
    }
    *ptr = fir.operand_copy(fir.place_field(lw->f, v.place, PTR_FIELD));
    *len = fir.operand_copy(fir.place_field(lw->f, v.place, LEN_FIELD));
    return true;
}

// The byte offset of the position `line`:`col` in `src`, or the length of `src` past its end. A
// column of 0 and a position past the end clamp to the length, and the arithmetic wraps, so that
// a range that the parser did not fill never traps.
fn source_offset(string src, u32 line, u32 col) u64 {
    u64 mut at = 0;
    u32 mut here = 1;
    while (here < line && at < src.len) {
        if (src[at] == '\n') {
            here += 1;
        }
        at += 1;
    }
    // A zero column wraps and then reads as past the end.
    at +%= cast(col, u64) -% 1;
    if (at < src.len) {
        return at;
    }
    return src.len;
}

// The source text of the argument of the `assert` call `call`, whose range runs from its `(` to
// after its `)`: the text between the two. The session holds the text of every module that the
// closure loaded.
fn assert_text(lowerer mut* lw, ast.node* call) string {
    string mut src = "";
    session.session mut* s = lw->ck->sess;
    if (!session.has_source(s, call->loc.file) || !session.read_source(s, call->loc.file, &src)) {
        return "";
    }
    u64 open = source_offset(src, call->loc.line, call->loc.col);
    u64 close = source_offset(src, call->loc.end_line, call->loc.end_col);
    if (close < open + 2) {
        return "";
    }
    return src[open + 1..close - 1];
}

// `assert(c)`: the operand of `c`, then `check(a, user, const bytes "<text>") -> bb` at the name
// `assert`, which the runtime reports (spec/fir.md 9.4). The condition of the kind `user` is true
// on success.
fn lower_assert(lowerer mut* lw, ast.node* n) bool {
    fir.operand mut c = fir.operand{};
    if (!lower_operand(lw, ast.ast_child(n, 0), &c)) {
        return false;
    }
    u32 first = fir.operand_push(lw->f, fir.operand_const(fir.const_bytes(assert_text(lw, n))));
    check_then(lw, c, fir.check_kind.chk_user, first, 1, n->a->loc);
    return true;
}

// `panic(m)`: the pointer and the length of `m`, then `fail(panic, ptr, len)` at the name `panic`,
// which the runtime reports (spec/fir.md 9.4). The `fail` ends the block.
fn lower_panic(lowerer mut* lw, ast.node* n) bool {
    fir.operand mut ptr = fir.operand{};
    fir.operand mut len = fir.operand{};
    if (!string_parts(lw, ast.ast_child(n, 0), &ptr, &len)) {
        return false;
    }
    u32 first = fir.operand_push(lw->f, ptr);
    fir.operand_push(lw->f, len);
    terminate(lw, fir.term_fail(fir.check_kind.chk_panic, first, 2, n->a->loc, lw->stmt));
    return true;
}

// ---- binary operators -------------------------------------------------------------------------

// `a op b`: `&&` and `||` by control flow, `==` and `!=` on strings by the runtime, and every
// other operator as one rvalue over the operands of `a` and `b`, in that order, with the checks
// that the operator needs. The operand of `a` is read before `b` runs when `b` contains a writer.
fn lower_binary(lowerer mut* lw, ast.node* n, fir.operand mut* out) bool {
    lexer.tok_kind op = cast(n->op, lexer.tok_kind);
    if (op == lexer.tok_kind.and_and || op == lexer.tok_kind.pipe_pipe) {
        return lower_logical(lw, n, out);
    }
    bool equality = op == lexer.tok_kind.eq || op == lexer.tok_kind.ne;
    if (equality && n->a->ty->kind == types.type_kind.k_string) {
        return lower_string_eq(lw, n, out);
    }
    fir.operand mut a = fir.operand{};
    if (!lower_operand(lw, n->a, &a)) {
        return false;
    }
    a = materialize(lw, a, contains_writer(n->b), n->a->loc);
    fir.operand mut b = fir.operand{};
    if (!lower_operand(lw, n->b, &b)) {
        return false;
    }
    *out = into_temp(lw, n->ty, operation(lw, op, n->a->ty, a, b, n->loc), n->loc);
    return true;
}

// The rvalue of `a op b` over operands of type `t`, after the checks of the operator at `at`:
// `+`, `-` and `*` on integers with the overflow check, `/` and `%` on integers with the division
// checks, the shifts with the shift check, and every other operator with none.
fn operation(lowerer mut* lw, lexer.tok_kind op, types.node* t, fir.operand a, fir.operand b,
             diag.loc at) fir.rvalue {
    bool float = types.type_is_float(t);
    fir.rvalue_kind kind = binary_kind(op, float);
    bool arith = op == lexer.tok_kind.plus || op == lexer.tok_kind.minus
        || op == lexer.tok_kind.star;
    if (arith && !float) {
        return checked(lw, kind, t, a, b, at);
    }
    if (kind == fir.rvalue_kind.rv_div || kind == fir.rvalue_kind.rv_rem) {
        return divided(lw, kind, t, a, b, at);
    }
    if (kind == fir.rvalue_kind.rv_shl || kind == fir.rvalue_kind.rv_shr) {
        return shifted(lw, kind, t, a, b, at);
    }
    return fir.rvalue_binary(lw->f, kind, a, b);
}

// The rvalue of the binary operator `op` (spec/fir.md 6), with the float forms for a float
// operand. `+`, `-` and `*` on integers give `add`, `sub` and `mul`, which operation checks, and
// the wrapping operators give the same forms with no check. The checker refuses `%` on a float.
fn binary_kind(lexer.tok_kind op, bool float) fir.rvalue_kind {
    switch (op) {
    case lexer.tok_kind.plus:
        if (float) {
            return fir.rvalue_kind.rv_fadd;
        }
        return fir.rvalue_kind.rv_add;
    case lexer.tok_kind.minus:
        if (float) {
            return fir.rvalue_kind.rv_fsub;
        }
        return fir.rvalue_kind.rv_sub;
    case lexer.tok_kind.star:
        if (float) {
            return fir.rvalue_kind.rv_fmul;
        }
        return fir.rvalue_kind.rv_mul;
    case lexer.tok_kind.slash:
        if (float) {
            return fir.rvalue_kind.rv_fdiv;
        }
        return fir.rvalue_kind.rv_div;
    case lexer.tok_kind.percent:
        return fir.rvalue_kind.rv_rem;
    case lexer.tok_kind.plus_wrap:
        return fir.rvalue_kind.rv_add;
    case lexer.tok_kind.minus_wrap:
        return fir.rvalue_kind.rv_sub;
    case lexer.tok_kind.star_wrap:
        return fir.rvalue_kind.rv_mul;
    case lexer.tok_kind.amp:
        return fir.rvalue_kind.rv_and;
    case lexer.tok_kind.pipe:
        return fir.rvalue_kind.rv_or;
    case lexer.tok_kind.caret:
        return fir.rvalue_kind.rv_xor;
    case lexer.tok_kind.shl:
        return fir.rvalue_kind.rv_shl;
    case lexer.tok_kind.shr:
        return fir.rvalue_kind.rv_shr;
    case lexer.tok_kind.eq:
        return fir.rvalue_kind.rv_eq;
    case lexer.tok_kind.ne:
        return fir.rvalue_kind.rv_ne;
    case lexer.tok_kind.lt:
        return fir.rvalue_kind.rv_lt;
    case lexer.tok_kind.le:
        return fir.rvalue_kind.rv_le;
    case lexer.tok_kind.gt:
        return fir.rvalue_kind.rv_gt;
    case lexer.tok_kind.ge:
        return fir.rvalue_kind.rv_ge;
    default:
        panic("fir_lower.binary_kind: not a binary operator");
    }
}

// The test that pairs with the checked form `kind`: `add_overflows` for `add`, and so on.
fn overflow_kind(fir.rvalue_kind kind) fir.rvalue_kind {
    switch (kind) {
    case fir.rvalue_kind.rv_add:
        return fir.rvalue_kind.rv_add_overflows;
    case fir.rvalue_kind.rv_sub:
        return fir.rvalue_kind.rv_sub_overflows;
    case fir.rvalue_kind.rv_mul:
        return fir.rvalue_kind.rv_mul_overflows;
    default:
        panic("fir_lower.overflow_kind: not a checked form");
    }
}

// `a + b`, `a - b` or `a * b` on integers of type `t`, and the `sub` of `-x`: `_f =
// add_overflows(a, b)` and `check(copy _f, overflow) -> bb` at `at`, and the rvalue `add(a, b)`
// for `bb` (spec/fir.md 9.4).
fn checked(lowerer mut* lw, fir.rvalue_kind kind, types.node* t, fir.operand a, fir.operand b,
           diag.loc at) fir.rvalue {
    fir.rvalue test = fir.rvalue_binary(lw->f, overflow_kind(kind), a, b);
    fir.operand flag = into_temp(lw, bool_ty(lw), test, at);
    check_then(lw, flag, fir.check_kind.chk_overflow, 0, 0, at);
    return fir.rvalue_binary(lw->f, kind, a, b);
}

// The constant `T v` of the integer type `t`.
fn int_const(types.node* t, bool neg, u64 mag) fir.operand {
    return fir.operand_const(fir.const_int(t, consts.int_make(neg, mag)));
}

// `a / b` and `a % b` on integers of type `t`: `_z = eq(b, const 0)` and `check(copy _z,
// div_zero)`; for a signed type, `_o = and(eq(b, const -1), eq(a, const MIN))` and `check(copy
// _o, div_overflow)`; then the rvalue `div(a, b)` or `rem(a, b)` (spec/fir.md 9.4). Each
// condition is true on failure.
fn divided(lowerer mut* lw, fir.rvalue_kind kind, types.node* t, fir.operand a, fir.operand b,
           diag.loc at) fir.rvalue {
    types.node* flag = bool_ty(lw);
    fir.rvalue zero = fir.rvalue_binary(lw->f, fir.rvalue_kind.rv_eq, b, int_const(t, false, 0));
    check_then(lw, into_temp(lw, flag, zero, at), fir.check_kind.chk_div_zero, 0, 0, at);
    if (prim.prim_is_signed(t->prim)) {
        u64 bits = cast(prim.prim_size(t->prim), u64) * prim.PRIM_BITS_PER_BYTE;
        fir.operand minus_one = int_const(t, true, 1);
        fir.rvalue minus = fir.rvalue_binary(lw->f, fir.rvalue_kind.rv_eq, b, minus_one);
        fir.operand is_minus = into_temp(lw, flag, minus, at);
        fir.operand min = int_const(t, true, cast(1, u64) << (bits - 1));
        fir.rvalue least = fir.rvalue_binary(lw->f, fir.rvalue_kind.rv_eq, a, min);
        fir.operand is_min = into_temp(lw, flag, least, at);
        fir.rvalue both = fir.rvalue_binary(lw->f, fir.rvalue_kind.rv_and, is_minus, is_min);
        fir.operand over = into_temp(lw, flag, both, at);
        check_then(lw, over, fir.check_kind.chk_div_overflow, 0, 0, at);
    }
    return fir.rvalue_binary(lw->f, kind, a, b);
}

// `a << b` and `a >> b` on a value of type `t`: `_n = cast<i64>(b)`, which widens by the
// signedness of `b`, `_u = cast<u64>(copy _n)`, `_f = ge(copy _u, const u64 W)` for the width W of
// `t`, `check(copy _f, shift, copy _n, bytes "<type>")`, then the rvalue `shl(a, cast<T>(copy
// _n))` or `shr` (spec/fir.md 9.4, toolchain.md 6 item 15). The build-mode pass masks `_n` under
// `--release`.
fn shifted(lowerer mut* lw, fir.rvalue_kind kind, types.node* t, fir.operand a, fir.operand b,
           diag.loc at) fir.rvalue {
    types.node* wide = i64_ty(lw);
    types.node* bits = u64_ty(lw);
    fir.operand count = into_temp(lw, wide, fir.rvalue_cast(lw->f, wide, b), at);
    fir.operand unsigned = into_temp(lw, bits, fir.rvalue_cast(lw->f, bits, count), at);
    u64 w = cast(prim.prim_size(t->prim), u64) * prim.PRIM_BITS_PER_BYTE;
    fir.rvalue test = fir.rvalue_binary(lw->f, fir.rvalue_kind.rv_ge, unsigned,
                                        int_const(bits, false, w));
    fir.operand flag = into_temp(lw, bool_ty(lw), test, at);
    u32 first = fir.operand_push(lw->f, count);
    fir.operand_push(lw->f, fir.operand_const(fir.const_bytes(prim.prim_name(t->prim))));
    check_then(lw, flag, fir.check_kind.chk_shift, first, 2, at);
    fir.operand narrow = into_temp(lw, t, fir.rvalue_cast(lw->f, t, count), at);
    return fir.rvalue_binary(lw->f, kind, a, narrow);
}

// `a && b` and `a || b`: a temporary `_t: bool`, `_t = a`, `switch(copy _t) -> [true: rhs,
// otherwise: done]` for `&&` and the reverse for `||`, then `_t = b` and `goto done` in `rhs`
// (spec/fir.md 9.4). The blocks are made in the order rhs, done.
fn lower_logical(lowerer mut* lw, ast.node* n, fir.operand mut* out) bool {
    u32 t = fir.local_add(lw->f, n->ty, fir.local_kind.lk_temp, null, n->loc);
    fir.place slot = fir.place_local(t);
    fir.operand mut a = fir.operand{};
    if (!lower_operand(lw, n->a, &a)) {
        return false;
    }
    assign(lw, slot, fir.rvalue_use(lw->f, a), n->a->loc);
    u32 rhs = fir.block_new(lw->f);
    u32 done = fir.block_new(lw->f);
    if (cast(n->op, lexer.tok_kind) == lexer.tok_kind.and_and) {
        branch(lw, fir.operand_copy(slot), rhs, done, n->loc);
    } else {
        branch(lw, fir.operand_copy(slot), done, rhs, n->loc);
    }
    lw->block = rhs;
    fir.operand mut b = fir.operand{};
    if (!lower_operand(lw, n->b, &b)) {
        return false;
    }
    assign(lw, slot, fir.rvalue_use(lw->f, b), n->b->loc);
    jump(lw, done, n->loc);
    lw->block = done;
    *out = fir.operand_copy(slot);
    return true;
}

// `a == b` and `a != b` on strings: `call fn std.rt.str_eq(copy a.0, copy a.1, copy b.0, copy
// b.1)`, and `not` of it for `!=` (spec/fir.md 9.4). The place of `a` is read before `b` runs when
// `b` contains a writer. In a closure without std.rt.str_eq, such as a sandbox of a test, the
// lowering refuses the comparison.
fn lower_string_eq(lowerer mut* lw, ast.node* n, fir.operand mut* out) bool {
    if (!lw->str_eq_known) {
        lw->str_eq = runtime_fn(lw->ck, STR_EQ);
        lw->str_eq_known = true;
    }
    if (lw->str_eq == null) {
        return no_runtime(lw, n, STR_EQ);
    }
    fir.operand mut a = fir.operand{};
    if (!aggregate_operand(lw, n->a, &a)) {
        return false;
    }
    a = materialize(lw, a, contains_writer(n->b), n->a->loc);
    fir.operand mut b = fir.operand{};
    if (!aggregate_operand(lw, n->b, &b)) {
        return false;
    }
    if (a.kind != fir.operand_kind.ok_copy || b.kind != fir.operand_kind.ok_copy) {
        // the checker refuses to compare an owning rvalue, which would leave no owner
        panic("fir_lower.lower_string_eq: a string that owns");
    }
    u32 first = fir.operand_push(lw->f, fir.operand_copy(fir.place_field(lw->f, a.place, 0)));
    fir.operand_push(lw->f, fir.operand_copy(fir.place_field(lw->f, a.place, 1)));
    fir.operand_push(lw->f, fir.operand_copy(fir.place_field(lw->f, b.place, 0)));
    fir.operand_push(lw->f, fir.operand_copy(fir.place_field(lw->f, b.place, 1)));
    fir.operand mut same = into_temp(lw, bool_ty(lw), fir.rvalue_call_fn(lw->str_eq, first, 4),
                                     n->loc);
    if (cast(n->op, lexer.tok_kind) == lexer.tok_kind.ne) {
        same = into_temp(lw, bool_ty(lw), fir.rvalue_unary(lw->f, fir.rvalue_kind.rv_not, same),
                         n->loc);
    }
    *out = same;
    return true;
}

// The function `name` of the module std.rt among the symbols of `ck`, or null when the closure
// holds none.
fn runtime_fn(check.checker* ck, string name) ast.sym* {
    u64 mut i = 0;
    while (i < check.check_sym_count(ck)) {
        ast.sym* s = check.check_sym_at(ck, i);
        if (runtime_function(s) && s->name == name) {
            return s;
        }
        i += 1;
    }
    return null;
}

// `c ? a : b` of a scalar type: the operand of `c`, `switch -> [true: then, otherwise: else]`,
// and each arm into a temporary of the type of the conditional, then `goto done` (spec/fir.md
// 9.4). The blocks are made in the order then, else, done. The checker gives the conditional the
// lent type of its arms unless both arms own. So the temporary owns only when the arms are owning
// rvalues or `null`, and `move _t` reads it then.
fn lower_ternary(lowerer mut* lw, ast.node* n, fir.operand mut* out) bool {
    fir.operand mut c = fir.operand{};
    if (!lower_operand(lw, n->a, &c)) {
        return false;
    }
    u32 t = fir.local_add(lw->f, n->ty, fir.local_kind.lk_temp, null, n->loc);
    u32 then_block = fir.block_new(lw->f);
    u32 else_block = fir.block_new(lw->f);
    u32 done = fir.block_new(lw->f);
    branch(lw, c, then_block, else_block, n->loc);
    lw->block = then_block;
    if (!lower_arm_value(lw, n->b, t, done, n->loc)) {
        return false;
    }
    lw->block = else_block;
    if (!lower_arm_value(lw, n->c, t, done, n->loc)) {
        return false;
    }
    lw->block = done;
    *out = read_temp(t, n->ty);
    return true;
}

// Lowers the arm `n` of a conditional into the temporary `t`, then `goto done` at the `?`.
fn lower_arm_value(lowerer mut* lw, ast.node* n, u32 t, u32 done, diag.loc at) bool {
    fir.operand mut v = fir.operand{};
    if (!lower_operand(lw, n, &v)) {
        return false;
    }
    assign(lw, fir.place_local(t), fir.rvalue_use(lw->f, v), n->loc);
    jump(lw, done, at);
    return true;
}

// `cast(e, T)` to a type that is no aggregate: `cast<T>(a)` in a temporary of type `T`, where `a`
// is the operand of `e` (spec/fir.md 9.4). That is `move p` for `move(lv)`, `move _t` for an
// owning rvalue in a temporary, and `copy p` or a constant otherwise. A cast never adds `own`, so
// the checker gives a cast to an owning type one of the two `move` forms.
fn lower_cast(lowerer mut* lw, ast.node* n, fir.operand mut* out) bool {
    fir.operand mut a = fir.operand{};
    if (!lower_operand(lw, n->a, &a)) {
        return false;
    }
    *out = into_temp(lw, n->ty, fir.rvalue_cast(lw->f, n->ty, a), n->loc);
    return true;
}
