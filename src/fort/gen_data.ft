// gen_data: the data half of the LLVM IR emitter (toolchain.md 6 items 5, 8
// and 21), the transliteration of the emit half of src/bootstrap/gen_data.c:
// the module-level data, the private data the emitter accumulated,
// the module's declarations, the attribute groups and the assembly of the
// sections into one module. See gen.ft.
//
// How this file is cut, and why it is not src/bootstrap/gen_data.c's cut. The
// C file also holds the accounting halves -- gen_file_ref, gen_str_ref,
// gen_enum_ref, gen_use_extern, gen_append_name and the calls to the runtime
// -- which the checks need while an expression is being lowered, so
// they went into gen.ft with the primitives they stand beside: circular
// imports are a compile error. What is left here is what runs after a function
// has been emitted, and it depends on gen.ft alone. Every function keeps its C
// name, so the two emitters are read side by side whatever file each name
// stands in.
// D9.5, D19.6, T-037: the port moved the accounting halves to gen.ft
//
// Re-entrancy: every function here works on the emitter it is given and
// allocates out of that emitter's pool or out of a buffer it frees. Nothing
// here ends the process.
// D20.5
//
// Dispatch: none. The kind analyses are the plain switches and if-chains the C
// wrote, not a function-pointer table.
// D3.10
import ast;
import check;
import consts;
import gen;
import lexer;
import std.strbuf;
import types;

/// The Linux module header of item 1. Existing emitter tests use this header
/// when their target is empty. A Mac module uses its selected triple.
/// D19.1
string MODULE_HEADER = "target triple = \"x86_64-unknown-linux-gnu\"\n";

/// The program entry point the compiler emits in the entry module: the one C
/// name a fort program's own definitions occupy.
/// D11.6
string ENTRY_NAME = "fort_entry";

string MAC_FN_ATTR =
    "nounwind \"frame-pointer\"=\"all\" \"probe-stack\"=\"__chkstk_darwin\"";
string MAC_NORET_ATTR =
    "noreturn nounwind \"frame-pointer\"=\"all\" \"probe-stack\"=\"__chkstk_darwin\"";
string MAC_RT_NORET_ATTR =
    "cold noreturn nounwind \"frame-pointer\"=\"all\" \"probe-stack\"=\"__chkstk_darwin\"";

/// The text of one attribute group of toolchain.md 6, at the fixed index gen.ft's
/// ATTR_* constants give; only the used ones are emitted. `mustprogress` is
/// deliberately absent everywhere: it would license the optimizer to delete a
/// `while (true) { }`, which fort keeps running. src/bootstrap/gen_data.c indexes
/// an array of these; a chain says the same thing and keeps the order, which is
/// the group numbering itself.
/// D8.4, D19.5
fn attr_text(u64 which, bool mac) string {
    if (which == gen.ATTR_FN) {
        if (mac) {
            return MAC_FN_ATTR;
        }
        return "nounwind \"frame-pointer\"=\"all\" \"probe-stack\"=\"inline-asm\"";
    } else if (which == gen.ATTR_FN_NORET) {
        if (mac) {
            return MAC_NORET_ATTR;
        }
        return "noreturn nounwind \"frame-pointer\"=\"all\" \"probe-stack\"=\"inline-asm\"";
    } else if (which == gen.ATTR_UNUSED_2) {
        // `#2` is never emitted: it held `cold noreturn nounwind` on the C runtime's
        // declarations, which item 8 no longer produces. The index stays so that `#3` to
        // `#7` keep the numbers item 14 fixes for them.
        // D19.5
        return "cold noreturn nounwind";
    } else if (which == gen.ATTR_NOBUILTIN) {
        return "nobuiltin";
    } else if (which == gen.ATTR_OVERFLOW) {
        return "nocallback nofree nosync nounwind speculatable willreturn memory(none)";
    } else if (which == gen.ATTR_MEMCPY) {
        return "nocallback nofree nounwind willreturn memory(argmem: readwrite)";
    } else if (which == gen.ATTR_MEMSET) {
        return "nocallback nofree nounwind willreturn memory(argmem: write)";
    } else if (which == gen.ATTR_TRAP) {
        return "cold noreturn nounwind memory(inaccessiblemem: write)";
    } else if (which == gen.ATTR_RT_NORET && mac) {
        return MAC_RT_NORET_ATTR;
    }
    return "cold noreturn nounwind \"frame-pointer\"=\"all\" \"probe-stack\"=\"inline-asm\"";
}

/// The overflow intrinsics of item 15, in the order `sadd ssub smul uadd usub
/// umul` and, within each, the widths `i8 i16 i32 i64`. The C keeps two arrays
/// here and a switch of the same names in gen_expr.c; the fort emitter keeps
/// the same two spellings, so that this file needs no import of gen_expr.ft.
fn overflow_op(u64 which) string {
    if (which == gen.OVF_SADD) {
        return "sadd";
    } else if (which == gen.OVF_SSUB) {
        return "ssub";
    } else if (which == gen.OVF_SMUL) {
        return "smul";
    } else if (which == gen.OVF_UADD) {
        return "uadd";
    } else if (which == gen.OVF_USUB) {
        return "usub";
    }
    return "umul";
}

fn overflow_width(u64 which) string {
    if (which == 0) {
        return "i8";
    } else if (which == 1) {
        return "i16";
    } else if (which == 2) {
        return "i32";
    }
    return "i64";
}

// ---- private data (item 5) --------------------------------------------------------

/// Appends `c"..."` with the trailing NUL that `len` excludes and every byte
/// outside the printable range written as a `\XX` hex pair (item 5).
/// D3.7
fn append_bytes(strbuf.str_buf mut* out, string s) void {
    strbuf.append(out, "c\"");
    u64 mut i = 0;
    while (i < s.len) {
        u64 byte = cast(s[i], u64);
        if (byte < gen.PRINTABLE_FIRST || byte > gen.PRINTABLE_LAST || s[i] == '"' ||
            s[i] == '\\') {
            gen.append_hex(out, byte);
        } else {
            strbuf.push(out, s[i]);
        }
        i += 1;
    }
    strbuf.append(out, "\\00\"");
}

/// `@.x.N = private unnamed_addr constant [len + 1 x i8] c"...", align 1`:
/// private data marks `unnamed_addr`, a named fort constant never does (item
/// 5).
fn emit_bytes(strbuf.str_buf mut* out, string name, string bytes) void {
    strbuf.append(out, name);
    strbuf.append(out, " = private unnamed_addr constant [");
    strbuf.append_u64(out, bytes.len + 1);
    strbuf.append(out, " x i8] ");
    append_bytes(out, bytes);
    strbuf.append(out, ", align 1\n");
}

/// The private data of item 5: `@.file.N` before `@.str.N` before `@.enum.*`.
/// D19.5
fn emit_data(gen.emitter mut* g, strbuf.str_buf mut* out) void {
    u64 mut i = 0;
    while (i < g->files.len) {
        string text = gen.records_at(&g->files, i).text;
        emit_bytes(out, gen.data_name(g, "file", i), text);
        i += 1;
    }
    i = 0;
    while (i < g->strs.len) {
        string text = gen.records_at(&g->strs, i).text;
        emit_bytes(out, gen.data_name(g, "str", i), text);
        i += 1;
    }
    i = 0;
    while (i < g->enums.len) {
        gen.record r = gen.records_at(&g->enums, i);
        strbuf.append(out, gen.enum_name(g, r.sym));
        strbuf.append(out, " = private unnamed_addr constant [");
        strbuf.append_u64(out, r.count);
        strbuf.append(out, " x %fort.enum_member] [");
        u64 mut at = 0;
        u64 mut k = 0;
        while (r.sym->node != null && k < ast.ast_len(r.sym->node)) {
            ast.node* m = ast.ast_child(r.sym->node, k);
            if (m->kind == ast.ast_kind.k_enum_member) {
                if (at > 0) {
                    strbuf.append(out, ", ");
                }
                // One entry per member in declaration order (item 21).
                strbuf.append(out, "%fort.enum_member { i32 ");
                strbuf.append_i64(out, cast(consts.cv_bits(check.check_node_value(g->ck, m)), i64));
                strbuf.append(out, ", ptr ");
                strbuf.append(out, gen.data_name(g, "str", r.first + at));
                strbuf.append(out, " }");
                at += 1;
            }
            k += 1;
        }
        // `%fort.enum_member` has C's 16-byte layout, so the table matches
        // std.rt's struct enum_member (item 21).
        strbuf.append(out, "], align 8\n");
        i += 1;
    }
}

// ---- module-level data (item 5) ---------------------------------------------------
// D7.10

/// The zero constant of `t` as an initializer spells it: `zeroinitializer` for
/// an aggregate, `null` for a pointer and `0` for every other scalar (item 5).
fn const_zero(strbuf.str_buf mut* out, types.node* t) void {
    if (gen.gen_is_aggregate(t)) {
        strbuf.append(out, "zeroinitializer");
        return;
    }
    if (t != null && (t->kind == types.type_kind.k_ptr || t->kind == types.type_kind.k_voidptr ||
                      t->kind == types.type_kind.k_fn)) {
        strbuf.append(out, "null");
        return;
    }
    strbuf.push(out, '0');
}

/// `<memtype> <value>`: one element or field of a constant aggregate, whose type
/// is written before every member (item 5). A null node is a field the designated
/// form omitted, which is zeroed.
/// D6.5
fn const_member(gen.emitter mut* g, strbuf.str_buf mut* out, types.node* t, ast.node* n,
                     bool mut* zero) void {
    // The member's type is appended before its value is built, since both
    // texts come out of the emitter's one scratch buffer.
    string ty = gen.gen_mem_type(g, t);
    strbuf.append(out, ty);
    strbuf.push(out, ' ');
    if (n == null) {
        const_zero(out, t);
        return;
    }
    if (!const_value(g, out, t, n)) {
        *zero = false;
    }
}

/// The member of a designated struct literal that initializes the field at index
/// `at`, or null when it omits it. It places every designator through
/// gen_field_index, the one map from a field symbol to its index, so a designator
/// the emitter cannot place ends the compilation instead of leaving a zeroed field
/// in read-only memory: an unfinished path is a diagnostic, never wrong data.
/// D6.5
fn designated_value(gen.emitter mut* g, ast.node* lit, u64 at) ast.node* {
    u64 mut i = 0;
    while (i < ast.ast_len(lit)) {
        ast.node* d = ast.ast_child(lit, i);
        u64 mut k = 0;
        if (d->kind != ast.ast_kind.k_designator || !gen.gen_field_index(d->sym, &k)) {
            gen.gen_todo(g, d->loc, "this initializer");
            return null;
        }
        if (k == at) {
            return d->a;
        }
        i += 1;
    }
    return null;
}

/// A constant struct: its fields in declaration order, the order the named type
/// of gen_stmt.ft writes them in, with an omitted field zeroed (item 5). This is
/// the fourth walk over the k_field_decl children of a declaration; gen_stmt.ft's
/// gen_struct_type names the other three and why all four must agree.
/// D6.5
fn const_struct(gen.emitter mut* g, strbuf.str_buf mut* out, types.node* t, ast.node* n) bool {
    ast.sym* s = check.nominal_sym(t);
    if (s == null || s->node == null) {
        gen.gen_todo(g, n->loc, "this initializer");
        return true;
    }
    bool designated = (n->flags & ast.FLAG_DESIGNATED) != 0;
    strbuf.str_buf mut buf = strbuf.create();
    defer strbuf.free(&buf);
    bool mut zero = true;
    u64 mut at = 0;
    strbuf.append(&buf, "{ ");
    u64 mut i = 0;
    while (i < ast.ast_len(s->node)) {
        ast.node* f = ast.ast_child(s->node, i);
        if (f->kind == ast.ast_kind.k_field_decl) {
            if (at > 0) {
                strbuf.append(&buf, ", ");
            }
            ast.node* mut v = null;
            if (designated) {
                v = designated_value(g, n, at);
            } else if (at < ast.ast_len(n)) {
                v = ast.ast_child(n, at);
            }
            const_member(g, &buf, f->ty, v, &zero);
            if (g->failed) {
                // One report per initializer: the walk stops at the first
                // member the emitter cannot lower.
                break;
            }
            at += 1;
        }
        i += 1;
    }
    strbuf.append(&buf, " }");
    // An all-zero aggregate is `zeroinitializer` whatever its shape (item 5).
    if (zero) {
        strbuf.append(out, "zeroinitializer");
    } else {
        strbuf.append(out, strbuf.view(&buf));
    }
    return zero;
}

/// A constant fixed array: exactly `N` elements or `{}` (item 5).
/// D6.5
fn const_array(gen.emitter mut* g, strbuf.str_buf mut* out, types.node* t, ast.node* n) bool {
    strbuf.str_buf mut buf = strbuf.create();
    defer strbuf.free(&buf);
    bool mut zero = true;
    strbuf.push(&buf, '[');
    u64 mut i = 0;
    while (i < ast.ast_len(n)) {
        if (i > 0) {
            strbuf.append(&buf, ", ");
        }
        const_member(g, &buf, t->elem, ast.ast_child(n, i), &zero);
        i += 1;
    }
    strbuf.push(&buf, ']');
    if (zero) {
        strbuf.append(out, "zeroinitializer");
    } else {
        strbuf.append(out, strbuf.view(&buf));
    }
    return zero;
}

/// A constant `string` or span: its two header fields, the bytes and the length
/// the trailing NUL excludes (item 5). The pointer is a relocation, so the value
/// is never all-zero.
/// D3.7
fn const_string(gen.emitter mut* g, strbuf.str_buf mut* out, string bytes) bool {
    string ref = gen.gen_str_ref(g, bytes);
    strbuf.append(out, "{ ptr ");
    strbuf.append(out, ref);
    strbuf.append(out, ", i64 ");
    strbuf.append_u64(out, bytes.len);
    strbuf.append(out, " }");
    return false;
}

/// The address of a module-level declaration, of a function, or the value of
/// another module-level declaration: the three forms a module-level initializer
/// adds to the constant expressions. Returns false when `n` is none of them.
/// D7.10, D4.6
fn const_symbol(gen.emitter mut* g, strbuf.str_buf mut* out, types.node* t, ast.node* n,
                     bool mut* zero) bool {
    ast.sym* s = n->sym;
    if (s == null) {
        return false;
    }
    if (s->kind == ast.sym_kind.s_fn) {
        // D3.10, D7.10: a function's address is a relocation
        strbuf.append(out, gen.gen_symbol_ref(g, s));
        *zero = false;
        return true;
    }
    if (s->kind == ast.sym_kind.s_const && s->node != null && s->node->b != null) {
        // D4.6, D7.10: the checker resolved the chain and refused a cycle
        // D4.6: a read of a `mut` global is not a constant expression
        *zero = const_value(g, out, t, s->node->b);
        return true;
    }
    return false;
}

/// The value of a module-level initializer, appended to `out`, and whether every
/// byte of it is zero, which is what `zeroinitializer` spells (item 5). The C
/// declares this above const_zero, since the two recur through each other; a fort
/// module needs no forward declaration.
/// D7.10
fn const_value(gen.emitter mut* g, strbuf.str_buf mut* out, types.node* t, ast.node* n) bool {
    if (g->failed || t == null || n == null) {
        const_zero(out, t);
        return true;
    }
    if ((n->ann & check.ANN_CONST) != 0) {
        consts.cval v = check.check_node_value(g->ck, n);
        if (v.kind == consts.cval_kind.cv_str) {
            return const_string(g, out, v.str);
        }
        if (v.kind != consts.cval_kind.cv_none) {
            // D4.6: a folded constant is emitted as its literal
            gen.gen_val c = gen.gen_const_mem_value(g, t, v);
            strbuf.append(out, c.val);
            if (consts.cv_is_float(v)) {
                // A float is all-zero bytes for +0.0 alone: -0.0 has its sign bit set and
                // `zeroinitializer` would lose it. Its magnitude field is not the value, so the
                // pattern is what answers here (consts.ft).
                // D6.12
                return consts.cv_float_bits(v) == 0;
            }
            return v.kind == consts.cval_kind.cv_null || v.mag == 0;
        }
    }
    if (n->kind == ast.ast_kind.k_brace_init) {
        if (ast.ast_len(n) == 0) {
            // D6.5
            const_zero(out, t);
            return true;
        }
        if (t->kind == types.type_kind.k_array) {
            return const_array(g, out, t, n);
        }
        if (t->kind == types.type_kind.k_struct) {
            return const_struct(g, out, t, n);
        }
    } else if (n->kind == ast.ast_kind.k_struct_lit || n->kind == ast.ast_kind.k_array_lit) {
        // D6.5
        return const_value(g, out, t, n->b);
    } else if (n->kind == ast.ast_kind.k_ident || n->kind == ast.ast_kind.k_field) {
        bool mut zero = true;
        if (const_symbol(g, out, t, n, &zero)) {
            return zero;
        }
    } else if (n->kind == ast.ast_kind.k_unary) {
        if (cast(n->op, lexer.tok_kind) == lexer.tok_kind.amp && n->a != null &&
            n->a->sym != null && (n->a->sym->kind == ast.sym_kind.s_const ||
                                  n->a->sym->kind == ast.sym_kind.s_global)) {
            // D7.10: `&` of a module-level declaration, and of nothing else
            strbuf.append(out, gen.gen_symbol_ref(g, n->a->sym));
            return false;
        }
    }
    gen.gen_todo(g, n->loc, "this initializer");
    const_zero(out, t);
    return true;
}

/// Appends the module-level declaration `decl` to the globals section: a
/// `dso_local constant` for an immutable declaration, which lives in read-only
/// memory, and a `dso_local global` for a `mut` one. A declaration that failed to
/// check is skipped.
/// D7.10
fn gen_global(gen.emitter mut* g, ast.node* decl) void {
    ast.sym* s = decl->sym;
    if (s == null || s->error || s->ty == null) {
        // D14.2: the checker reported it
        return;
    }
    if (s->kind != ast.sym_kind.s_const && s->kind != ast.sym_kind.s_global) {
        return;
    }
    // Name, type and value each pass through the one scratch buffer, so each
    // is finished before the next begins.
    string name = gen.gen_symbol_ref(g, s);
    string ty = gen.gen_mem_type(g, s->ty);
    strbuf.str_buf mut init = strbuf.create();
    defer strbuf.free(&init);
    const_value(g, &init, s->ty, decl->b);
    strbuf.append(&g->globals, name);
    // An immutable declaration lives in read-only memory and a `mut` one in writable
    // memory; no section is named, since LLVM picks it from the initializer (item 5).
    // A named fort constant is not `unnamed_addr`: its address is significant,
    // because `&CONST` is expressible.
    // D6.7, D7.10
    if (s->kind == ast.sym_kind.s_global) {
        strbuf.append(&g->globals, " = dso_local global ");
    } else {
        strbuf.append(&g->globals, " = dso_local constant ");
    }
    strbuf.append(&g->globals, ty);
    strbuf.push(&g->globals, ' ');
    strbuf.append(&g->globals, strbuf.view(&init));
    // D3.1, D3.8: an explicit `align N` from the compiler's own layout
    strbuf.append(&g->globals, ", align ");
    strbuf.append_u64(&g->globals, types.type_alignof(s->ty));
    strbuf.push(&g->globals, '\n');
}

// ---- declarations (item 8) --------------------------------------------------------

/// Linux keeps the old variadic form. Mac fixes an extern without `...`.
/// Mac also marks each extern declaration `nobuiltin` so the optimizer keeps
/// C call effects that a call-site `nobuiltin` does not protect.
/// D9.8
fn emit_extern(gen.emitter mut* g, strbuf.str_buf mut* out, ast.sym* s) void {
    types.node* sig = s->ty;
    strbuf.append(out, "declare ");
    string ret_attr = gen.gen_ext_attr(sig->elem);
    if (ret_attr.len > 0) {
        strbuf.append(out, ret_attr);
        strbuf.push(out, ' ');
    }
    strbuf.append(out, gen.gen_value_type(g, sig->elem));
    strbuf.append(out, " @");
    // D9.7: one spelling for every `@` name; an extern comes out bare
    gen.gen_append_name(out, "", s->name, false);
    strbuf.push(out, '(');
    u64 mut i = 0;
    while (i < sig->params.len) {
        if (i > 0) {
            strbuf.append(out, ", ");
        }
        strbuf.append(out, gen.gen_value_type(g, sig->params[i]));
        string attr = gen.gen_ext_attr(sig->params[i]);
        if (attr.len > 0) {
            strbuf.push(out, ' ');
            strbuf.append(out, attr);
        }
        i += 1;
    }
    bool variadic = !gen.gen_is_mac(g) || (s->node->flags & ast.FLAG_VARIADIC) != 0;
    if (variadic) {
        if (sig->params.len > 0) {
            strbuf.append(out, ", ");
        }
        strbuf.append(out, "...");
    }
    strbuf.push(out, ')');
    if (gen.gen_is_mac(g)) {
        strbuf.append(out, " nobuiltin");
    }
    strbuf.push(out, '\n');
}

/// The intrinsics, with the spellings LLVM 18 prints, in the fixed order of
/// item 8's table; the parameter attributes shown are part of the spelling.
fn emit_intrinsic(strbuf.str_buf mut* out, u64 which) void {
    if (which == gen.IN_MEMCPY) {
        strbuf.append(out, "declare void @llvm.memcpy.p0.p0.i64(ptr noalias nocapture writeonly, ");
        strbuf.append(out, "ptr noalias nocapture readonly, i64, i1 immarg) #5\n");
        return;
    }
    if (which == gen.IN_MEMSET) {
        strbuf.append(out, "declare void @llvm.memset.p0.i64(ptr nocapture writeonly, i8, i64, ");
        strbuf.append(out, "i1 immarg) #6\n");
        return;
    }
    if (which == gen.IN_TRAP) {
        strbuf.append(out, "declare void @llvm.trap() #7\n");
        return;
    }
    if (which >= gen.IN_FPCONV_FIRST) {
        // A saturating float-to-integer conversion (items 8 and 12).
        strbuf.append(out, "declare ");
        strbuf.append(out, gen.gen_fpconv_int_type(which));
        strbuf.append(out, " @");
        gen.gen_fpconv_name(out, which);
        strbuf.push(out, '(');
        strbuf.append(out, gen.gen_fpconv_float_type(which));
        strbuf.append(out, ") #4\n");
        return;
    }
    u64 at = which - gen.IN_OVERFLOW_FIRST;
    string op = overflow_op(at / gen.OVF_WIDTHS);
    string width = overflow_width(at % gen.OVF_WIDTHS);
    strbuf.append(out, "declare { ");
    strbuf.append(out, width);
    strbuf.append(out, ", i1 } @llvm.");
    strbuf.append(out, op);
    strbuf.append(out, ".with.overflow.");
    strbuf.append(out, width);
    strbuf.push(out, '(');
    strbuf.append(out, width);
    strbuf.append(out, ", ");
    strbuf.append(out, width);
    strbuf.append(out, ") #4\n");
}

// ---- assembly (item 1) ------------------------------------------------------------

/// Appends one section, separated from the one before it by a blank line
/// (item 1); an empty section is skipped, so the sections a module does not
/// need leave no trace.
fn section(strbuf.str_buf mut* out, string text) void {
    if (text.len == 0) {
        return;
    }
    if (strbuf.view(out).len > 0) {
        strbuf.push(out, '\n');
    }
    strbuf.append(out, text);
}

/// Appends the private data, the declarations and the attribute groups, then
/// assembles the module into `g->out` (item 1).
fn gen_finish(gen.emitter mut* g) void {
    strbuf.str_buf mut data = strbuf.create();
    defer strbuf.free(&data);
    emit_data(g, &data);
    strbuf.str_buf mut externs = strbuf.create();
    defer strbuf.free(&externs);
    // `extern` C functions in first-use order, except one naming a symbol the module
    // defines: one ELF symbol is one IR entity, so a `declare` beside a `define` of
    // `fort_entry` would be a redefinition (item 8). The checker refuses such a
    // declaration first, since the name is reserved, so this only keeps the invariant
    // local to the emitter.
    // D9.7, D19.5
    u64 mut i = 0;
    while (i < g->externs.len) {
        ast.sym* s = gen.syms_at(&g->externs, i);
        if (!g->entry_defined || s->name != ENTRY_NAME) {
            emit_extern(g, &externs, s);
        }
        i += 1;
    }
    strbuf.str_buf mut intrinsics = strbuf.create();
    defer strbuf.free(&intrinsics);
    // Then the intrinsics in the fixed table order.
    i = 0;
    while (i < gen.IN_COUNT) {
        if (gen.gen_uses_intrinsic(g, i)) {
            emit_intrinsic(&intrinsics, i);
        }
        i += 1;
    }
    strbuf.str_buf mut attributes = strbuf.create();
    defer strbuf.free(&attributes);
    i = 0;
    while (i < gen.ATTR_COUNT) {
        if (gen.gen_uses_attr(g, i)) {
            strbuf.append(&attributes, "attributes #");
            strbuf.append_u64(&attributes, i);
            strbuf.append(&attributes, " = { ");
            strbuf.append(&attributes, attr_text(i, gen.gen_is_mac(g)));
            strbuf.append(&attributes, " }\n");
        }
        i += 1;
    }
    strbuf.clear(&g->out);
    if (g->opts.target.len == 0 || g->opts.target == "x86_64-linux-gnu") {
        section(&g->out, MODULE_HEADER);
    } else {
        strbuf.str_buf mut header = strbuf.create();
        defer strbuf.free(&header);
        strbuf.append(&header, "target triple = \"");
        strbuf.append(&header, g->opts.target);
        strbuf.append(&header, "\"\n");
        section(&g->out, strbuf.view(&header));
    }
    section(&g->out, strbuf.view(&g->named));
    section(&g->out, strbuf.view(&g->globals));
    section(&g->out, strbuf.view(&g->funcs));
    section(&g->out, strbuf.view(&data));
    section(&g->out, strbuf.view(&externs));
    section(&g->out, strbuf.view(&intrinsics));
    section(&g->out, strbuf.view(&attributes));
}
