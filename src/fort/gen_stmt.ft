/// Lowers statements and function definitions to LLVM IR.

import ast;
import check;
import diag;
import gen;
import gen_data;
import gen_expr;
import lexer;
import modules;
import runtime_sig;
import std.strbuf;
import types;

// The width a failure entry point takes a value at: every value the runtime
// reports arrives sign-extended to 64 bits.
u32 FAIL_VALUE_BITS = 64;

// The bytes an `i64` occupies, which is the alignment and the size of the
// counter a range `for` invents. The C writes `sizeof(uint64_t)`; `sizeof` takes
// a type in fort too, and this is that type's size.
u64 I64_BYTES = 8;

// Classifies exits to select the scopes they unwind. Reaching the end of a block leaves only that
// block and needs no exit kind.
enum exit_kind {
    x_return,
    x_break,
    x_continue,
}

// Returns the operator for a compound assignment, or `assign` for plain assignment. `lv op= e`
// follows the rules and overflow behavior of `lv op e`.
fn compound_operator(lexer.tok_kind op) lexer.tok_kind {
    switch (op) {
    case lexer.tok_kind.plus_assign:
        return lexer.tok_kind.plus;
    case lexer.tok_kind.minus_assign:
        return lexer.tok_kind.minus;
    case lexer.tok_kind.star_assign:
        return lexer.tok_kind.star;
    case lexer.tok_kind.slash_assign:
        return lexer.tok_kind.slash;
    case lexer.tok_kind.percent_assign:
        return lexer.tok_kind.percent;
    case lexer.tok_kind.plus_wrap_assign:
        return lexer.tok_kind.plus_wrap;
    case lexer.tok_kind.minus_wrap_assign:
        return lexer.tok_kind.minus_wrap;
    case lexer.tok_kind.star_wrap_assign:
        return lexer.tok_kind.star_wrap;
    case lexer.tok_kind.amp_assign:
        return lexer.tok_kind.amp;
    case lexer.tok_kind.pipe_assign:
        return lexer.tok_kind.pipe;
    case lexer.tok_kind.caret_assign:
        return lexer.tok_kind.caret;
    case lexer.tok_kind.shl_assign:
        return lexer.tok_kind.shl;
    case lexer.tok_kind.shr_assign:
        return lexer.tok_kind.shr;
    default:
        break;
    }
    return lexer.tok_kind.assign;
}

// Whether an assignment to a place of type `t` carries the overwrite check: only an `own`
// reference, only in the checked mode. The emitter does not check an owning aggregate field by
// field. It does not check a declaration initializer. `--no-bounds-check` removes only index and
// span checks, not this check.
fn overwrite_checked(gen.emitter* g, types.node* t) bool {
    return !g->opts.release && types.type_is_reference(t) && t->is_own;
}

// Loads the current pointer word. A span or string uses field 0; a pointer or `void*` uses its
// value. A nonnull pointer branches to `std.rt.fail_overwrite` because overwriting it would leak.
// `at` is the `=` token.
fn gen_overwrite_check(gen.emitter mut* g, gen.gen_place target, diag.loc at) void {
    gen.gen_val mut held = gen.gen_val{};
    if (gen.gen_is_aggregate(target.ty)) {
        held = gen.gen_span_ptr(g, target.addr);
    } else {
        held = gen.gen_load_place(g, target);
    }
    gen.gen_val live = gen.gen_icmp(g, "ne", held, gen.gen_literal(g, "ptr", "null"));
    gen.gen_args mut args = gen.gen_args_init();
    defer gen.gen_args_free(&args);
    gen.gen_check(g, live, true, runtime_sig.rt_entry.rt_fail_overwrite, &args, at);
}

// A plain assignment into an `own` reference: the right-hand side is fully
// evaluated, the check runs, and only then does the store happen.
fn gen_checked_store(gen.emitter mut* g, gen.gen_place target, ast.node* value,
                          diag.loc at) void {
    if (!gen.gen_is_aggregate(target.ty)) {
        // A pointer's value is in a register, so the check stands between its
        // evaluation and the store.
        gen.gen_val v = gen_expr.gen_expr_value(g, value);
        if (g->failed) {
            return;
        }
        gen_overwrite_check(g, target, at);
        gen.gen_store_place(g, target, v);
        return;
    }
    // a span lands in a temporary, copied over after the check
    gen.gen_place tmp = gen.gen_temp_place(g, target.ty);
    gen_expr.gen_expr_into(g, value, tmp);
    if (g->failed) {
        return;
    }
    gen_overwrite_check(g, target, at);
    u64 align = types.type_alignof(target.ty);
    gen.gen_memcpy(g, target.addr, align, tmp.addr, align, types.type_sizeof(target.ty));
}

// Emits `Type name = init;`. gen_function already made the entry-block alloca. This statement emits
// the initializer and, for an owning local, the overwrite check. A declaration stores like any
// assignment. gen_function zeros the slot once in the entry block. The first execution passes. A
// repeated loop declaration traps if the prior iteration did not use `del`. The check is reported
// at the declared name, the declaration having no operator token of its own.
fn gen_var_decl(gen.emitter mut* g, ast.node* n) void {
    if (n->b == null || n->sym == null) {
        return;
    }
    gen.gen_place slot = gen.gen_slot_place(g, n->sym);
    if (overwrite_checked(g, slot.ty)) {
        gen_checked_store(g, slot, n->b, n->name_loc);
        return;
    }
    gen_expr.gen_expr_into(g, n->b, slot);
}

fn gen_assign(gen.emitter mut* g, ast.node* n) void {
    // the target is evaluated before the value
    gen.gen_place target = gen_expr.gen_expr_place(g, n->a);
    if (g->failed) {
        return;
    }
    lexer.tok_kind op = compound_operator(cast(n->op, lexer.tok_kind));
    if (op == lexer.tok_kind.assign) {
        if (overwrite_checked(g, target.ty)) {
            // storing over a live `own` value is a runtime error
            gen_checked_store(g, target, n->b, n->loc);
            return;
        }
        gen_expr.gen_expr_into(g, n->b, target);
        return;
    }
    gen.gen_val lhs = gen.gen_load_place(g, target);
    gen.gen_val rhs = gen_expr.gen_expr_value(g, n->b);
    // A compound assignment uses the intrinsics of its operator.
    gen.gen_store_place(
        g, target, gen_expr.gen_arith(g, n->loc, cast(op, i32), n->a->ty, lhs, n->b->ty, rhs));
}

// `++` and `--` use the same intrinsics as `+` and `-`.
fn gen_incdec(gen.emitter mut* g, ast.node* n) void {
    gen.gen_place target = gen_expr.gen_expr_place(g, n->a);
    if (g->failed) {
        return;
    }
    gen.gen_val before = gen.gen_load_place(g, target);
    gen.gen_val one = gen.gen_const_unsigned(g, before.ty, 1);
    lexer.tok_kind mut op = lexer.tok_kind.minus;
    if (cast(n->op, lexer.tok_kind) == lexer.tok_kind.plus_plus) {
        op = lexer.tok_kind.plus;
    }
    gen.gen_store_place(
        g, target, gen_expr.gen_arith(g, n->loc, cast(op, i32), n->a->ty, before, n->a->ty, one));
}

// ---- deferred statements -----------------------------------------------------------

fn scope_push(gen.emitter mut* g, gen.scope_kind kind) void {
    gen.scopes_push(&g->scopes, gen.block_scope{kind, g->defers.len});
}

// Closes the innermost scope: its deferred statements go out of scope with it,
// so nothing an exit below it crosses can run them.
fn scope_pop(gen.emitter mut* g) void {
    g->defers.len = gen.scopes_pop(&g->scopes).first;
}

// Emits deferred statements for the scope at `depth` in reverse text order. It selects statements
// registered after this scope opened and before the next scope. Thus, each unwind runs only that
// scope's statements. A deferred `noreturn` call ends the block and stops expansion. The remaining
// exit path is unreachable.
fn run_scope_defers(gen.emitter mut* g, u64 depth) void {
    u64 first = gen.scopes_at(&g->scopes, depth).first;
    u64 mut end = g->defers.len;
    if (depth + 1 < g->scopes.len) {
        end = gen.scopes_at(&g->scopes, depth + 1).first;
    }
    // an exit met below may not unwind past the scopes open now
    u64 saved_floor = g->defer_floor;
    g->defer_floor = g->scopes.len;
    u64 mut i = end;
    while (i > first) {
        if (g->failed || g->terminated) {
            break;
        }
        ast.node* deferred = gen.refs_at(&g->defers, i - 1);
        // nothing is captured at `defer` time. This is ordinary code
        gen_stmt(g, deferred->a);
        i -= 1;
    }
    g->defer_floor = saved_floor;
}

// Returns whether exit `x` stops at scope `kind`. `break` stops after the innermost loop or case.
// `continue` stops after the innermost loop. `return` stops after the function body.
fn exit_stops_at(exit_kind x, gen.scope_kind kind) bool {
    if (x == exit_kind.x_return) {
        return kind == gen.scope_kind.sc_fn;
    }
    if (x == exit_kind.x_continue) {
        return kind == gen.scope_kind.sc_loop;
    }
    return kind == gen.scope_kind.sc_loop || kind == gen.scope_kind.sc_case;
}

// Copies deferred code into an exit. Its defer set is static. This function expands each exited
// scope from inner to outer, in reverse order within each scope. The scope stack records the tree
// shape and shows how many scopes an exit leaves. The emitter needs no separate counter.
fn gen_unwind(gen.emitter mut* g, exit_kind x) void {
    u64 mut depth = g->scopes.len;
    while (depth > g->defer_floor) {
        depth -= 1;
        run_scope_defers(g, depth);
        if (g->failed || g->terminated) {
            return;
        }
        if (exit_stops_at(x, gen.scopes_at(&g->scopes, depth).kind)) {
            return;
        }
    }
    // The checker ensures that an exit target exists. It refuses `return` inside deferred code. It
    // also refuses targetless `break` or `continue` there (check_stmt.ft). Walking past the floor
    // therefore means a checker error. The floor prevents a branch to a loop outside the deferred
    // code. Without it, the walk could re-enter the deferred statement that contains the exit
    // indefinitely.
    panic("gen_stmt.gen_unwind: an exit inside deferred code with none of it to leave");
}

// A return of a bare `own` local or parameter is an implicit checker-marked `move`. The emitter
// reads, then clears the operand. A prior `defer del(x)` then sees zero and frees nothing.
fn gen_return_move(gen.emitter mut* g, ast.node* n) void {
    if ((n->ann & check.ANN_MOVE) == 0 || g->failed) {
        return;
    }
    gen.gen_place src = gen_expr.gen_expr_place(g, n->a);
    if (!g->failed) {
        gen.gen_zero_owner(g, src);
    }
}

// `  ret void`, which both the void and the `sret` forms end with.
fn emit_ret_void(gen.emitter mut* g) void {
    gen.gen_ins(g);
    gen.gen_text_append(g, "ret void");
    gen.gen_ins_end(g);
    g->terminated = true;
}

fn gen_return(gen.emitter mut* g, ast.node* n) void {
    if (n->a == null) {
        gen_unwind(g, exit_kind.x_return);
        if (g->failed || g->terminated) {
            return;
        }
        emit_ret_void(g);
        return;
    }
    if (gen.gen_is_aggregate(n->a->ty)) {
        // An aggregate result is written through the `sret` pointer and the
        // function returns `void`.
        gen.gen_place mut sret = gen.gen_place{};
        sret.addr.ty = "ptr";
        sret.addr.val = "%ret.sret";
        sret.ty = n->a->ty;
        // The `sret` block is in caller storage. The caller can also pass its address as an
        // argument. For example, `s = f(&s)` shares one block. Deferred code can reach it.
        // The callee first stores the result in an internal temporary. It copies the result to
        // `sret` after deferred code runs. Thus, `return e` evaluates before deferred code, which
        // cannot change
        // the saved result. A function with nothing deferred writes the block directly and pays for
        // no temporary.
        bool through_temp = g->defers.len > 0;
        gen.gen_place mut target = sret;
        if (through_temp) {
            target = gen.gen_temp_place(g, n->a->ty);
        }
        gen_expr.gen_expr_into(g, n->a, target);
        // the operand is emptied before the deferred code too
        gen_return_move(g, n);
        gen_unwind(g, exit_kind.x_return);
        if (g->failed || g->terminated) {
            return;
        }
        if (through_temp) {
            u64 align = types.type_alignof(n->a->ty);
            gen.gen_memcpy(g, sret.addr, align, target.addr, align, types.type_sizeof(n->a->ty));
        }
        emit_ret_void(g);
        return;
    }
    gen.gen_val v = gen_expr.gen_expr_value(g, n->a);
    gen_return_move(g, n);
    // the value is in a register before the deferred code runs
    gen_unwind(g, exit_kind.x_return);
    if (g->failed || g->terminated) {
        return;
    }
    gen.gen_ins(g);
    gen.gen_text_append(g, "ret ");
    gen.gen_text_append(g, v.ty);
    gen.gen_text_append(g, " ");
    gen.gen_text_append(g, v.val);
    gen.gen_ins_end(g);
    g->terminated = true;
}

// ---- control flow -------------------------------------------------------

// Emits an `if` chain. Each condition branches to its then block and its else block, or to the
// continuation without `else`. Each unterminated arm branches to the continuation. Every block the
// emitter opens therefore ends in exactly one terminator.
fn gen_if(gen.emitter mut* g, ast.node* n) void {
    gen.gen_val cond = gen_expr.gen_expr_value(g, n->a);
    if (g->failed) {
        return;
    }
    bool has_else = n->c != null;
    // the order labels are allocated in is part of the text
    u64 then_label = gen.gen_label(g);
    u64 mut else_label = 0;
    if (has_else) {
        else_label = gen.gen_label(g);
    }
    u64 done = gen.gen_label(g);
    if (has_else) {
        gen.gen_br_cond(g, cond, then_label, else_label);
    } else {
        gen.gen_br_cond(g, cond, then_label, done);
    }
    gen.gen_block_begin(g, then_label);
    gen_block(g, n->b);
    if (!g->terminated) {
        gen.gen_br(g, done);
    }
    if (has_else) {
        gen.gen_block_begin(g, else_label);
        gen_stmt(g, n->c);
        if (!g->terminated) {
            gen.gen_br(g, done);
        }
    }
    gen.gen_block_begin(g, done);
}

// Emits only the selected statement branch. Selection adds no run-time branch
// and the branch block keeps its source scope.
fn gen_compile_if(gen.emitter mut* g, ast.node* n) void {
    ast.node* mut current = n;
    while (current != null && current->kind == ast.ast_kind.k_compile_if) {
        if ((current->flags & ast.FLAG_SELECT_THEN) != 0) {
            gen_block(g, current->b);
            return;
        }
        if (current->c == null) {
            return;
        }
        if (current->c->kind != ast.ast_kind.k_compile_if) {
            gen_block(g, current->c);
            return;
        }
        current = current->c;
    }
}

// Emits a loop body with its `break` and `continue` targets. These exits use the innermost loop.
// The function saves and restores enclosing targets.
fn gen_loop_body(gen.emitter mut* g, ast.node* body, u64 brk, u64 cont) void {
    u64 saved_break = g->break_label;
    u64 saved_continue = g->continue_label;
    bool had_break = g->has_break;
    bool had_continue = g->has_continue;
    g->break_label = brk;
    g->continue_label = cont;
    g->has_break = true;
    g->has_continue = true;
    // `break` and `continue` both leave the loop body
    gen_block_scoped(g, body, gen.scope_kind.sc_loop);
    g->break_label = saved_break;
    g->continue_label = saved_continue;
    g->has_break = had_break;
    g->has_continue = had_continue;
}

// `while (cond) { }`: a head block that re-evaluates the condition, a body that
// branches back to it, and a continuation. `continue` targets the head, `break`
// the continuation.
fn gen_while(gen.emitter mut* g, ast.node* n) void {
    u64 head = gen.gen_label(g);
    u64 body = gen.gen_label(g);
    u64 done = gen.gen_label(g);
    gen.gen_br(g, head);
    gen.gen_block_begin(g, head);
    gen.gen_val cond = gen_expr.gen_expr_value(g, n->a);
    if (g->failed) {
        return;
    }
    gen.gen_br_cond(g, cond, body, done);
    gen.gen_block_begin(g, body);
    gen_loop_body(g, n->b, done, head);
    if (!g->terminated) {
        gen.gen_br(g, head);
    }
    gen.gen_block_begin(g, done);
}

// Emits `do { } while (cond);`. The body runs before the first test, so the entry edge goes
// directly to it. The test block re-evaluates the condition and branches back to the body.
// `continue` targets the test block, because the test runs after every iteration of a `do`, and
// `break` targets the continuation.
fn gen_do_while(gen.emitter mut* g, ast.node* n) void {
    u64 body = gen.gen_label(g);
    u64 test = gen.gen_label(g);
    u64 done = gen.gen_label(g);
    gen.gen_br(g, body);
    gen.gen_block_begin(g, body);
    gen_loop_body(g, n->a, done, test);
    if (!g->terminated) {
        // The body may have ended in a `break` or a `return`, which already
        // wrote the block's one terminator.
        gen.gen_br(g, test);
    }
    gen.gen_block_begin(g, test);
    gen.gen_val cond = gen_expr.gen_expr_value(g, n->b);
    if (g->failed) {
        return;
    }
    gen.gen_br_cond(g, cond, body, done);
    gen.gen_block_begin(g, done);
}

// Emits a three-part `for` loop. `init` runs in the containing block. The head tests `cond`. The
// body branches to `step`, which branches back to the head. `continue` targets the step block,
// because `continue` in a `for` runs `step`. An empty `cond` means `true`, which is what `for (;;)`
// is.
fn gen_for(gen.emitter mut* g, ast.node* n) void {
    if (n->a != null) {
        gen_stmt(g, n->a);
    }
    if (g->failed) {
        return;
    }
    u64 head = gen.gen_label(g);
    u64 body = gen.gen_label(g);
    u64 step = gen.gen_label(g);
    u64 done = gen.gen_label(g);
    if (!g->terminated) {
        // `init` may end the block, so the entry edge is guarded
        gen.gen_br(g, head);
    }
    gen.gen_block_begin(g, head);
    if (n->b == null) {
        // an empty condition is `true`
        gen.gen_br(g, body);
    } else {
        gen.gen_val cond = gen_expr.gen_expr_value(g, n->b);
        if (g->failed) {
            return;
        }
        gen.gen_br_cond(g, cond, body, done);
    }
    gen.gen_block_begin(g, body);
    gen_loop_body(g, n->d, done, step);
    if (!g->terminated) {
        gen.gen_br(g, step);
    }
    gen.gen_block_begin(g, step);
    if (n->c != null) {
        gen_stmt(g, n->c);
    }
    if (g->failed) {
        return;
    }
    if (!g->terminated) {
        // `step` may be a call too, with the same consequence as `init`.
        gen.gen_br(g, head);
    }
    gen.gen_block_begin(g, done);
}

// The copy of one element into the loop variable's slot: a scalar is loaded
// and stored, an aggregate is copied with `llvm.memcpy`.
fn copy_into(gen.emitter mut* g, gen.gen_place dst, gen.gen_place src) void {
    if (gen.gen_is_aggregate(dst.ty)) {
        u64 align = types.type_alignof(dst.ty);
        gen.gen_memcpy(g, dst.addr, align, src.addr, align, types.type_sizeof(dst.ty));
        return;
    }
    gen.gen_store_place(g, dst, gen.gen_load_place(g, src));
}

// The place the collection of a range `for` is iterated over. The loop lends and iterates an owning
// collection in place. It evaluates a nonowning collection once into a temporary, then iterates
// that copy.
fn range_collection(gen.emitter mut* g, ast.node* coll) gen.gen_place {
    if (coll->ty != null && (types.type_is_owning_aggregate(coll->ty) ||
                             (types.type_is_reference(coll->ty) && coll->ty->is_own))) {
        return gen_expr.gen_expr_place(g, coll);
    }
    gen.gen_place tmp = gen.gen_temp_place(g, coll->ty);
    gen_expr.gen_expr_into(g, coll, tmp);
    return tmp;
}

// Emits `for (T x: coll) { }`. A compiler-generated `i64` counter walks the collection. Each
// iteration copies its current element into the loop variable. The counter is bounded by the
// collection's length, so its increment is a plain `add` and not a checked one.
fn gen_range_for(gen.emitter mut* g, ast.node* n) void {
    gen.gen_place coll = range_collection(g, n->b);
    if (g->failed || n->sym == null || n->b->ty == null) {
        return;
    }
    gen.gen_place index = gen.gen_temp_place_raw(g, "i64", I64_BYTES);
    gen.gen_store(g, gen.gen_const_unsigned(g, "i64", 0), index.addr, I64_BYTES);
    u64 head = gen.gen_label(g);
    u64 body = gen.gen_label(g);
    u64 step = gen.gen_label(g);
    u64 done = gen.gen_label(g);
    gen.gen_br(g, head);
    gen.gen_block_begin(g, head);
    gen.gen_val at = gen.gen_load(g, "i64", index.addr, I64_BYTES);
    gen.gen_val len = gen_expr.gen_length_of(g, n->b->ty, coll.addr);
    // The counter never passes the length, so the compare is unsigned and no
    // bounds check is needed on the element address.
    gen.gen_br_cond(g, gen.gen_icmp(g, "ult", at, len), body, done);
    gen.gen_block_begin(g, body);
    gen.gen_place mut element = gen.gen_place{};
    element.addr = gen_expr.gen_element_addr(g, n->b->ty, coll.addr, at);
    element.ty = n->sym->ty;
    copy_into(g, gen.gen_slot_place(g, n->sym), element);
    gen_loop_body(g, n->c, done, step);
    if (!g->terminated) {
        gen.gen_br(g, step);
    }
    gen.gen_block_begin(g, step);
    gen.gen_val before = gen.gen_load(g, "i64", index.addr, I64_BYTES);
    gen.gen_store(g, gen.gen_binary(g, "add", before, gen.gen_const_unsigned(g, "i64", 1)),
                  index.addr, I64_BYTES);
    gen.gen_br(g, head);
    gen.gen_block_begin(g, done);
}

// `break` targets the innermost enclosing loop or `switch` and `continue` the
// innermost enclosing loop alone. The checker refused a `break` with neither
// construct around it and a `continue` outside every loop, so a target is always
// set here (check_stmt.ft).
fn gen_break(gen.emitter mut* g, bool cont) void {
    bool mut has_target = g->has_break;
    if (cont) {
        has_target = g->has_continue;
    }
    if (!has_target) {
        panic("gen_stmt.gen_break: break or continue outside a loop or switch");
    }
    // in a `for`, `continue` runs them before `step`
    if (cont) {
        gen_unwind(g, exit_kind.x_continue);
    } else {
        gen_unwind(g, exit_kind.x_break);
    }
    if (g->failed || g->terminated) {
        return;
    }
    if (cont) {
        gen.gen_br(g, g->continue_label);
    } else {
        gen.gen_br(g, g->break_label);
    }
}

// ---- switch ------------------------------------------------------------------------

// Emits one case body with `break` targeting the switch. Thus, `break` exits the switch inside a
// loop. `continue` still targets the enclosing loop.
fn gen_case_body(gen.emitter mut* g, ast.node* body, u64 brk) void {
    u64 saved_break = g->break_label;
    bool had_break = g->has_break;
    g->break_label = brk;
    g->has_break = true;
    gen_block_scoped(g, body, gen.scope_kind.sc_case);
    g->break_label = saved_break;
    g->has_break = had_break;
}

// The clause that is the `default`, or `clauses` when the switch has none: at
// most one, in any position.
fn default_clause(ast.node* n, u64 clauses) u64 {
    u64 mut i = 0;
    while (i < clauses) {
        ast.node* clause = ast.ast_child(n, i);
        if (clause->kind == ast.ast_kind.k_case && (clause->flags & ast.FLAG_DEFAULT) != 0) {
            return i;
        }
        i += 1;
    }
    return clauses;
}

// `switch (e) { case a, b:... default:... }`. It emits one LLVM `switch` with one case per label
// and one block per clause. The default target is the source `default`, an enum failure block, or
// the continuation. Each case body is an implicit block with an implicit final `break`. An
// unterminated body branches to the continuation. No clause falls through.
fn gen_switch(gen.emitter mut* g, ast.node* n) void {
    gen.gen_val operand = gen_expr.gen_expr_value(g, n->a);
    if (g->failed) {
        return;
    }
    u64 clauses = ast.ast_len(n);
    types.node* ot = n->a->ty;
    u64 fallback_clause = default_clause(n, clauses);
    // An enum `switch` without `default` lists each member but can receive other values. A zeroed
    // enum holds 0 even without a zero member. Integer-to-enum casts are unchecked. This case is
    // defined and cannot always be diagnosed. The compiler adds a default block that reports a
    // runtime error with the enum and value.
    bool generated_default =
        fallback_clause == clauses && ot != null && ot->kind == types.type_kind.k_enum;
    gen.gen_val mut reported = operand;
    if (generated_default) {
        // widened in the block that dominates the failure
        reported = gen.gen_resize(g, operand, gen.gen_int_bits(ot), "i64", FAIL_VALUE_BITS, true);
    }
    // one block per clause in clause order, the continuation last
    u64 first = g->labels;
    u64 mut i = 0;
    while (i < clauses) {
        gen.gen_label(g);
        i += 1;
    }
    u64 done = gen.gen_label(g);
    // The default target: the `default` clause wherever it stands, the failure block
    // whose label follows the continuation's, or the continuation itself.
    u64 mut fallback = done;
    if (generated_default) {
        fallback = gen.gen_label(g);
    } else if (fallback_clause != clauses) {
        fallback = first + fallback_clause;
    }
    gen.gen_switch_begin(g, operand, fallback);
    i = 0;
    while (i < clauses) {
        ast.node* clause = ast.ast_child(n, i);
        if (clause->kind == ast.ast_kind.k_case) {
            u64 mut k = 0;
            while (k < ast.ast_len(clause)) {
                // a folded label prints with the operand type's sign
                ast.node* label = ast.ast_child(clause, k);
                gen.gen_switch_case(
                    g, gen.gen_const_value(g, n->a->ty, check.check_node_value(g->ck, label)),
                    i + first);
                k += 1;
            }
        }
        i += 1;
    }
    gen.gen_switch_end(g);
    if (generated_default) {
        // Emitted here, while its label is the smallest one outstanding, so that the
        // failure blocks of the case bodies follow it in ascending order. It is not a
        // bounds check, so neither `--release` nor `--no-bounds-check` removes it.
        gen.gen_args mut args = gen.gen_args_init();
        defer gen.gen_args_free(&args);
        gen.gen_args_add(&args, reported);
        gen.gen_args_add(&args, gen.gen_literal(g, "ptr", gen.gen_str_ref(g, ot->name)));
        gen.gen_fail_block(g, fallback, runtime_sig.rt_entry.rt_fail_enum, &args, n->loc);
    }
    i = 0;
    while (i < clauses) {
        ast.node* clause = ast.ast_child(n, i);
        gen.gen_block_begin(g, first + i);
        if (clause->kind == ast.ast_kind.k_case) {
            gen_case_body(g, clause->a, done);
        }
        if (g->failed) {
            return;
        }
        if (!g->terminated) {
            gen.gen_br(g, done);
        }
        i += 1;
    }
    gen.gen_block_begin(g, done);
}

fn gen_stmt(gen.emitter mut* g, ast.node* n) void {
    if (n == null || g->failed) {
        return;
    }
    switch (n->kind) {
    case ast.ast_kind.k_block:
        gen_block(g, n);
        return;
    case ast.ast_kind.k_var_decl:
        gen_var_decl(g, n);
        return;
    case ast.ast_kind.k_assign:
        gen_assign(g, n);
        return;
    case ast.ast_kind.k_incdec:
        gen_incdec(g, n);
        return;
    case ast.ast_kind.k_call_stmt:
        gen_expr.gen_expr_discard(g, n->a);
        return;
    case ast.ast_kind.k_return:
        gen_return(g, n);
        return;
    case ast.ast_kind.k_error:
        // the module is not emitted when a syntax error was reported
        return;
    case ast.ast_kind.k_if:
        gen_if(g, n);
        return;
    case ast.ast_kind.k_compile_if:
        gen_compile_if(g, n);
        return;
    case ast.ast_kind.k_while:
        gen_while(g, n);
        return;
    case ast.ast_kind.k_do_while:
        gen_do_while(g, n);
        return;
    case ast.ast_kind.k_for:
        gen_for(g, n);
        return;
    case ast.ast_kind.k_range_for:
        gen_range_for(g, n);
        return;
    case ast.ast_kind.k_switch:
        gen_switch(g, n);
        return;
    case ast.ast_kind.k_break:
        gen_break(g, false);
        return;
    case ast.ast_kind.k_continue:
        gen_break(g, true);
        return;
    case ast.ast_kind.k_defer:
        // a `defer` emits nothing where it stands; exits copy it out
        gen.refs_push(&g->defers, n);
        return;
    default:
        break;
    }
    gen.gen_todo(g, n->loc, "this statement");
}

// A block as an ordinary block scope, which only falling off its end exits.
fn gen_block(gen.emitter mut* g, ast.node* n) void {
    gen_block_scoped(g, n, gen.scope_kind.sc_block);
}

// Emits a block as a scope of `kind`. The kind controls which exits run its deferred statements.
// Functions use sc_fn, loops use sc_loop, and cases use sc_case.
fn gen_block_scoped(gen.emitter mut* g, ast.node* n, gen.scope_kind kind) void {
    if (n == null) {
        return;
    }
    scope_push(g, kind);
    u64 mut i = 0;
    while (i < ast.ast_len(n)) {
        if (g->failed) {
            break;
        }
        if (g->terminated) {
            // a fresh block for the unreachable statements after an exit
            gen.gen_block_begin(g, gen.gen_label(g));
        }
        gen_stmt(g, ast.ast_child(n, i));
        i += 1;
    }
    if (!g->failed && !g->terminated) {
        // falling off the end runs them in reverse order
        run_scope_defers(g, g->scopes.len - 1);
    }
    scope_pop(g);
}

// ---- function definitions ------------------------------------------------

// Every local of the body, in declaration order, which is the order their
// allocas are emitted in.
fn collect_locals(ast.node* n, gen.node_ref_vec mut* out) void {
    if (n == null) {
        return;
    }
    if (n->kind == ast.ast_kind.k_compile_if) {
        ast.node* mut current = n;
        while (current != null && current->kind == ast.ast_kind.k_compile_if) {
            if ((current->flags & ast.FLAG_SELECT_THEN) != 0) {
                collect_locals(current->b, out);
                return;
            }
            if (current->c == null) {
                return;
            }
            if (current->c->kind != ast.ast_kind.k_compile_if) {
                collect_locals(current->c, out);
                return;
            }
            current = current->c;
        }
        return;
    }
    if ((n->kind == ast.ast_kind.k_var_decl || n->kind == ast.ast_kind.k_range_for) &&
        n->sym != null) {
        // a range `for` declares its variable on the loop node
        gen.refs_push(out, n);
    }
    collect_locals(n->a, out);
    collect_locals(n->b, out);
    collect_locals(n->c, out);
    collect_locals(n->d, out);
    u64 mut i = 0;
    while (i < ast.ast_len(n)) {
        collect_locals(ast.ast_child(n, i), out);
        i += 1;
    }
}

// `  %x.0 = alloca <ty>, align <n>`, the storage of one local or parameter.
fn emit_alloca(gen.emitter mut* g, string name, types.node* t) void {
    strbuf.append(&g->allocas, "  ");
    strbuf.append(&g->allocas, name);
    strbuf.append(&g->allocas, " = alloca ");
    strbuf.append(&g->allocas, gen.gen_mem_type(g, t));
    strbuf.append(&g->allocas, ", align ");
    strbuf.append_u64(&g->allocas, types.type_alignof(t));
    strbuf.push(&g->allocas, '\n');
}

// One blank line stands between two definitions.
fn definition_begin(gen.emitter mut* g) void {
    if (strbuf.view(&g->funcs).len > 0) {
        strbuf.push(&g->funcs, '\n');
    }
}

// Writes a fort definition signature. Scalars are ordinary parameters. An aggregate is a plain
// `ptr`. An aggregate result adds leading `ptr sret(%T) %ret.sret` to a `void` function.
fn emit_signature(gen.emitter mut* g, ast.node* fn_node, ast.sym* s, types.node* sig) void {
    // Read runtime `noreturn` state from the mangled name.
    // Only the defining module carries the attribute group.
    runtime_sig.rt_entry rt = runtime_sig.rt_entry_of(gen.gen_symbol(g, s));
    bool rt_noreturn = rt != runtime_sig.rt_entry.rt_none && runtime_sig.rt_entry_noreturn(rt);
    definition_begin(g);
    strbuf.append(&g->funcs, "define dso_local ");
    string ret_attr = gen.gen_ext_attr(sig->elem);
    if (ret_attr.len > 0) {
        // A narrow result carries the same attribute as a narrow parameter,
        // so that LLVM normalizes on both sides of a call.
        strbuf.append(&g->funcs, ret_attr);
        strbuf.push(&g->funcs, ' ');
    }
    strbuf.append(&g->funcs, gen.gen_result_type(g, sig->elem));
    strbuf.push(&g->funcs, ' ');
    strbuf.append(&g->funcs, gen.gen_symbol_ref(g, s));
    strbuf.push(&g->funcs, '(');
    u64 mut written = 0;
    if (gen.gen_is_aggregate(sig->elem)) {
        strbuf.append(&g->funcs, "ptr sret(");
        strbuf.append(&g->funcs, gen.gen_mem_type(g, sig->elem));
        strbuf.append(&g->funcs, ") %ret.sret");
        written += 1;
    }
    u64 mut i = 0;
    while (i < ast.ast_len(fn_node)) {
        ast.node* p = ast.ast_child(fn_node, i);
        if (p->kind == ast.ast_kind.k_param && p->sym != null) {
            if (written > 0) {
                strbuf.append(&g->funcs, ", ");
            }
            written += 1;
            types.node* t = p->sym->ty;
            if (gen.gen_is_aggregate(t)) {
                // A struct, fixed array, span or `string` argument is a plain
                // `ptr` parameter and `byval` is never used.
                strbuf.append(&g->funcs, "ptr ");
            } else {
                strbuf.append(&g->funcs, gen.gen_value_type(g, t));
                string attr = gen.gen_ext_attr(t);
                if (attr.len > 0) {
                    strbuf.push(&g->funcs, ' ');
                    strbuf.append(&g->funcs, attr);
                }
                strbuf.push(&g->funcs, ' ');
            }
            strbuf.append(&g->funcs, gen.slot_name(g, p->sym, 0, true));
        }
        i += 1;
    }
    strbuf.push(&g->funcs, ')');
    // Every fort definition uses `#0`. A `noreturn` definition uses `#1`.
    // A `noreturn` runtime entry point uses the cold `#8` group.
    if (sig->is_noreturn && rt_noreturn) {
        gen.gen_use_attr(g, gen.ATTR_RT_NORET);
        strbuf.append(&g->funcs, " #8 {\n");
    } else if (sig->is_noreturn) {
        gen.gen_use_attr(g, gen.ATTR_FN_NORET);
        strbuf.append(&g->funcs, " #1 {\n");
    } else {
        gen.gen_use_attr(g, gen.ATTR_FN);
        strbuf.append(&g->funcs, " #0 {\n");
    }
}

// Resets the per-function counters and buffers: every name is fixed per
// function and reset at each definition.
fn function_begin(gen.emitter mut* g) void {
    g->temps = 0;
    g->labels = 0;
    g->tmps = 0;
    g->break_label = 0;
    g->continue_label = 0;
    g->has_break = false;
    g->has_continue = false;
    gen.slots_free(&g->slots);
    // a defer expands inside the function that wrote it
    g->defers.len = 0;
    g->scopes.len = 0;
    g->defer_floor = 0;
    strbuf.clear(&g->allocas);
    strbuf.clear(&g->body);
    strbuf.clear(&g->fail);
    g->terminated = false;
}

// Appends the entry block, the normal blocks and then the failure blocks, and
// closes the definition.
fn function_end(gen.emitter mut* g) void {
    strbuf.append(&g->funcs, "entry:\n");
    strbuf.append(&g->funcs, strbuf.view(&g->allocas));
    strbuf.append(&g->funcs, strbuf.view(&g->body));
    strbuf.append(&g->funcs, strbuf.view(&g->fail));
    strbuf.append(&g->funcs, "}\n");
}

// Creates slots and entry-block allocas in emission order. Parameters come first. Locals follow in
// declaration order, which is also their final order in `locals`. src/bootstrap/gen.c writes this
// inline in gen_function. This function is separate because test/fort/support/gen_env.ft emits one
// expression at a time and needs these slots. Keeping slot naming here prevents a duplicate test
// implementation.
fn gen_slots(gen.emitter mut* g, ast.node* fn_node, gen.node_ref_vec mut* locals) void {
    u64 mut at = 0;
    u64 mut i = 0;
    while (i < ast.ast_len(fn_node)) {
        ast.node* p = ast.ast_child(fn_node, i);
        if (p->kind == ast.ast_kind.k_param && p->sym != null) {
            types.node* t = p->sym->ty;
            if (gen.gen_is_aggregate(t)) {
                // An aggregate parameter is not copied again: its place is
                // the caller-made copy the incoming pointer designates
                gen.slot_add(g, p->sym, gen.slot_name(g, p->sym, at, true));
            } else {
                string name = gen.slot_name(g, p->sym, at, false);
                gen.slot_add(g, p->sym, name);
                emit_alloca(g, name, t);
            }
            at += 1;
        }
        i += 1;
    }
    collect_locals(fn_node->b, locals);
    i = 0;
    while (i < locals->len) {
        ast.node* d = gen.refs_at(locals, i);
        string name = gen.slot_name(g, d->sym, at, false);
        gen.slot_add(g, d->sym, name);
        emit_alloca(g, name, d->sym->ty);
        at += 1;
        i += 1;
    }
}

fn gen_function(gen.emitter mut* g, ast.node* fn_node) void {
    ast.sym* s = fn_node->sym;
    if (s == null || s->error || s->ty == null || s->ty->kind != types.type_kind.k_fn) {
        return;
    }
    types.node* sig = s->ty;
    function_begin(g);
    emit_signature(g, fn_node, s, sig);
    gen.node_ref_vec mut locals = gen.node_ref_vec{};
    defer gen.refs_free(&locals);
    gen_slots(g, fn_node, &locals);
    // A scalar parameter is stored into its slot immediately.
    u64 mut i = 0;
    while (i < ast.ast_len(fn_node)) {
        ast.node* p = ast.ast_child(fn_node, i);
        if (p->kind == ast.ast_kind.k_param && p->sym != null &&
            !gen.gen_is_aggregate(p->sym->ty)) {
            gen.gen_val mut incoming = gen.gen_val{};
            incoming.ty = gen.gen_value_type(g, p->sym->ty);
            incoming.val = gen.slot_name(g, p->sym, 0, true);
            gen.gen_store_place(g, gen.gen_slot_place(g, p->sym), incoming);
        }
        i += 1;
    }
    // Zeros each owning local slot once. The first declaration execution reads zero during its
    // overwrite check. A repeated loop declaration reads the prior value unless its body used
    // `del`. Without it the check would read an uninitialized `alloca`.
    i = 0;
    while (i < locals.len) {
        ast.node* d = gen.refs_at(&locals, i);
        types.node* t = d->sym->ty;
        if (types.type_is_reference(t) && t->is_own) {
            gen.gen_zero_owner(g, gen.gen_slot_place(g, d->sym));
        }
        i += 1;
    }
    // the body is the scope a `return` unwinds out to
    gen_block_scoped(g, fn_node->b, gen.scope_kind.sc_fn);
    if (!g->terminated) {
        if (sig->is_noreturn) {
            // a `noreturn` body ends with a trap
            gen.gen_use_intrinsic(g, gen.IN_TRAP);
            gen.gen_use_attr(g, gen.ATTR_TRAP);
            strbuf.append(&g->body, "  call void @llvm.trap()\n  unreachable\n");
        } else if (sig->elem != null && sig->elem->kind == types.type_kind.k_void) {
            strbuf.append(&g->body, "  ret void\n");
        } else {
            // the checker proved the body terminates, so this is dead
            strbuf.append(&g->body, "  unreachable\n");
        }
    }
    function_end(g);
}

// ---- fort_entry ---------------------------------------------------------

fn gen_fort_entry(gen.emitter mut* g, ast.sym* main_sym) void {
    function_begin(g);
    gen.gen_use_attr(g, gen.ATTR_FN);
    definition_begin(g);
    // a C name, unquoted. The span arrives by pointer
    strbuf.append(&g->funcs, "define dso_local i32 @fort_entry(ptr %args.in) #0 {\n");
    // The module defines the name from this point. It does not also declare `extern fn fort_entry`.
    // Two C declarations share one ELF symbol, but an IR `declare` beside `define` is a
    // redefinition.
    g->entry_defined = true;
    gen.gen_args mut args = gen.gen_args_init();
    defer gen.gen_args_free(&args);
    if (main_sym->ty->params.len == 1) {
        // It copies the span into its own frame when `main` declares the
        // parameter, because its caller is the `main`.
        gen.gen_val mut slot = gen.gen_val{};
        slot.ty = "ptr";
        slot.val = "%args.0";
        strbuf.append(&g->allocas, "  %args.0 = alloca ");
        strbuf.append(&g->allocas, gen.SPAN_TYPE);
        strbuf.append(&g->allocas, ", align ");
        strbuf.append_u64(&g->allocas, gen.SPAN_ALIGN);
        strbuf.push(&g->allocas, '\n');
        gen.gen_val mut incoming = gen.gen_val{};
        incoming.ty = "ptr";
        incoming.val = "%args.in";
        gen.gen_memcpy(g, slot, gen.SPAN_ALIGN, incoming, gen.SPAN_ALIGN, gen.SPAN_SIZE);
        gen.gen_args_add(&args, slot);
    }
    gen.gen_val r = gen.gen_temp(g, "i32");
    strbuf.append(&g->body, "call i32 ");
    strbuf.append(&g->body, gen.gen_symbol_ref(g, main_sym));
    strbuf.push(&g->body, '(');
    strbuf.append(&g->body, gen.gen_args_text(&args));
    strbuf.append(&g->body, ")\n");
    strbuf.append(&g->body, "  ret i32 ");
    strbuf.append(&g->body, r.val);
    strbuf.push(&g->body, '\n');
    function_end(g);
}

// ---- main ---------------------------------------------------------------

// The byte the process status keeps, which is `status & 0xFF`.
u64 STATUS_MASK = 255;

// `@main` is the C entry point the start-up code calls, so it takes C's `argc` and `argv` and
// returns C's `int`. It is a definition of this module like any other and carries `dso_local` and
// `#0`. Calls `std.rt.args_init`, then `std.rt.args`. The second call builds the span for
// `fort_entry`. It then calls `std.rt.flush_all` and returns the low status byte. `args_init` runs
// first, since `args` hands out what it built.
fn gen_main(gen.emitter mut* g) void {
    function_begin(g);
    gen.gen_use_attr(g, gen.ATTR_FN);
    definition_begin(g);
    strbuf.append(&g->funcs, "define dso_local i32 @main(i32 %argc, ptr %argv) #0 {\n");
    // no fort identifier in the name, `main` being the compiler's
    gen.gen_val mut span = gen.gen_val{};
    span.ty = "ptr";
    span.val = "%args";
    strbuf.append(&g->allocas, "  %args = alloca ");
    strbuf.append(&g->allocas, gen.SPAN_TYPE);
    strbuf.append(&g->allocas, ", align ");
    strbuf.append_u64(&g->allocas, gen.SPAN_ALIGN);
    strbuf.push(&g->allocas, '\n');
    gen.gen_args mut init_args = gen.gen_args_init();
    gen.gen_args_add(&init_args, gen.gen_literal(g, "i32", "%argc"));
    gen.gen_args_add(&init_args, gen.gen_literal(g, "ptr", "%argv"));
    gen.gen_call_rt(g, runtime_sig.rt_entry.rt_args_init, &init_args);
    gen.gen_args_free(&init_args);
    // The hidden result pointer carries `sret`, as it does at every aggregate call.
    gen.gen_args mut args_args = gen.gen_args_init();
    gen.gen_args_add_ext(&args_args, span, "sret(%fort.span)");
    gen.gen_call_rt(g, runtime_sig.rt_entry.rt_args, &args_args);
    gen.gen_args_free(&args_args);
    gen.gen_val status = gen.gen_temp(g, "i32");
    strbuf.append(&g->body, "call i32 @fort_entry(ptr %args)\n");
    gen.gen_args mut flush_args = gen.gen_args_init();
    gen.gen_call_rt(g, runtime_sig.rt_entry.rt_flush_all, &flush_args);
    gen.gen_args_free(&flush_args);
    gen.gen_val masked =
        gen.gen_binary(g, "and", status, gen.gen_const_unsigned(g, "i32", STATUS_MASK));
    strbuf.append(&g->body, "  ret i32 ");
    strbuf.append(&g->body, masked.val);
    strbuf.push(&g->body, '\n');
    function_end(g);
}

// ---- the module ----------------------------------------------------------

// The named type of every struct the module declares, in source order, so that a field access names
// a type the module defines. Four walks must count the same k_field_decl children. Otherwise, a
// field index selects the wrong bytes. The walks are here, gen_field_index, the positional literal
// in gen_expr.ft, and the constant initializer in gen_data.ft. All four take those children in
// order and skip on the kind alone. A field with no type would leave them disagreeing, so it ends
// the compilation here rather than shifting an index silently.
fn gen_struct_type(gen.emitter mut* g, ast.node* decl) void {
    ast.sym* s = decl->sym;
    if (s == null || s->error || s->ty == null || s->ty->kind != types.type_kind.k_struct) {
        return;
    }
    string named = gen.gen_mem_type(g, s->ty);
    if (named == gen.ENUM_MEMBER_TYPE) {
        // `std.rt`'s `struct enum_member` is the existing `%fort.enum_member`. The emitter writes
        // its declaration once in the header.
        return;
    }
    strbuf.append(&g->named, named);
    strbuf.append(&g->named, " = type { ");
    u64 mut written = 0;
    u64 mut i = 0;
    while (i < ast.ast_len(decl)) {
        ast.node* f = ast.ast_child(decl, i);
        if (f->kind == ast.ast_kind.k_field_decl) {
            if (f->ty == null) {
                // The checker types every field of a struct it lets through,
                // so this is a broken tree and not a program the emitter
                // refuses.
                panic("gen_stmt.gen_struct_type: a struct field with no type");
            }
            if (written > 0) {
                strbuf.append(&g->named, ", ");
            }
            written += 1;
            strbuf.append(&g->named, gen.gen_mem_type(g, f->ty));
        }
        i += 1;
    }
    strbuf.append(&g->named, " }\n");
}

fn gen_module(gen.emitter mut* g, modules.module* m) void {
    g->module = m;
    gen_declarations(g, m->ast, 1);
    // Module-level data precedes functions. Forward references are legal in
    // LLVM IR, and this order fixes private-data numbering.
    gen_declarations(g, m->ast, 2);
    gen_declarations(g, m->ast, 3);
    g->module = null;
}

fn gen_declaration(gen.emitter mut* g, ast.node* decl, i32 section) void {
    ast.node* mut current = decl;
    while (current->kind == ast.ast_kind.k_compile_if) {
        if ((current->flags & ast.FLAG_SELECT_THEN) != 0) {
            gen_declarations(g, current->b, section);
            return;
        }
        if (current->c == null) {
            return;
        }
        if (current->c->kind != ast.ast_kind.k_compile_if) {
            gen_declarations(g, current->c, section);
            return;
        }
        current = current->c;
    }
    if (section == 1 && current->kind == ast.ast_kind.k_struct_decl) {
        gen_struct_type(g, current);
    } else if (section == 2 && current->kind == ast.ast_kind.k_var_decl) {
        gen_data.gen_global(g, current);
    } else if (section == 3 && current->kind == ast.ast_kind.k_fn_decl && current->b != null) {
        gen_function(g, current);
    }
}

fn gen_declarations(gen.emitter mut* g, ast.node* list, i32 section) void {
    u64 mut i = 0;
    while (list != null && i < ast.ast_len(list)) {
        gen_declaration(g, ast.ast_child(list, i), section);
        i += 1;
    }
}

fn find_main(ast.node* list) ast.node* {
    u64 mut i = 0;
    while (list != null && i < ast.ast_len(list)) {
        ast.node* decl = ast.ast_child(list, i);
        i += 1;
        if (decl->kind == ast.ast_kind.k_compile_if) {
            ast.node* found = find_main_node(decl);
            if (found != null) {
                return found;
            }
        } else if (decl->kind == ast.ast_kind.k_fn_decl && decl->sym != null
                   && !decl->sym->error && decl->sym->ty != null
                   && decl->sym->ty->kind == types.type_kind.k_fn
                   && decl->sym->name == "main") {
            return decl;
        }
    }
    return null;
}

fn find_main_node(ast.node* decl) ast.node* {
    ast.node* mut current = decl;
    while (current != null && current->kind == ast.ast_kind.k_compile_if) {
        if ((current->flags & ast.FLAG_SELECT_THEN) != 0) {
            return find_main(current->b);
        }
        if (current->c == null) {
            return null;
        }
        if (current->c->kind != ast.ast_kind.k_compile_if) {
            return find_main(current->c);
        }
        current = current->c;
    }
    return null;
}

// Emits closure modules in dependency order, then emits `fort_entry`.
// Uses annotations from `ck`. Returns false after an unsupported construct.
// src/bootstrap/gen.c stores the module set in the emitter beside the checker;
// nothing ever reads it back, so it stays a parameter here.
fn gen_program(gen.emitter mut* g, check.checker* ck, modules.module_set* set) bool {
    g->ck = ck;
    // The named types every module carries, used or not.
    strbuf.append(&g->named, gen.SPAN_TYPE);
    strbuf.append(&g->named, " = type { ptr, i64 }\n");
    strbuf.append(&g->named, gen.ENUM_MEMBER_TYPE);
    strbuf.append(&g->named, " = type { i32, ptr }\n");
    // every module after the ones it imports
    u64 mut i = 0;
    while (i < modules.count(set)) {
        gen_module(g, modules.at(set, i));
        i += 1;
    }
    modules.module* entry = modules.entry(set);
    if (entry != null && entry->ast != null) {
        ast.node* main_decl = find_main(entry->ast);
        if (main_decl != null) {
            // the only unmangled definitions, in the entry module
            gen_fort_entry(g, main_decl->sym);
            gen_main(g);
        }
    }
    gen_data.gen_finish(g);
    return !g->failed;
}
