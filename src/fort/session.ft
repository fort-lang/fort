/// Holds source text, configuration, diagnostics, and shared storage for one analysis.

import fort.containers;
import fort.diag;
import std.io;
import std.strbuf;
import std.strmap;

struct session {
    diag.sink diags;
    // The text of each source file by its path, and the pool of every text of the session: the
    // context that show_sources gives the sink.
    diag.sources files;
    // Maps each configuration key to its index in `config_values`.
    strmap.str_map config;
    containers.str_vec config_values;
}

fn create() session {
    return session{};
}

// Releases the sink, the source store and then the configuration. The order of the releases
// decides how the heap of glibc 2.43 settles: with the store released last,
// driver_lifetime_emitter_test.ft saw its break step by 184320 bytes after the early sample,
// with no byte kept.
fn free(session mut* s) void {
    diag.free(&s->diags);
    diag.free_sources(&s->files);
    strmap.free(&s->config);
    containers.str_free(&s->config_values);
}

// Adds one configuration pair. Panics when the key already exists.
fn config_set(session mut* s, string key, string value) void {
    if (strmap.has(&s->config, key)) {
        panic("session.config_set: duplicate key");
    }
    string kept_key = containers.pool_intern(&s->files.pool, key);
    string kept_value = containers.pool_intern(&s->files.pool, value);
    containers.str_push(&s->config_values, kept_value);
    strmap.put(&s->config, kept_key, cast(s->config_values.len - 1, i64));
}

// Returns one configured value. False distinguishes an absent key from an
// empty configured value and leaves *out unchanged.
fn config_get(session* s, string key, string mut* out) bool {
    i64 mut at = 0;
    if (!strmap.get(&s->config, key, &at)) {
        return false;
    }
    *out = containers.str_at(&s->config_values, cast(at, u64));
    return true;
}

fn pool(session mut* s) containers.pool mut* {
    return &s->files.pool;
}

fn diags(session mut* s) diag.sink mut* {
    return &s->diags;
}

// The errors reported through this session so far, which is what a driver asks
// to learn whether a file is usable.
fn error_count(session* s) u64 {
    return diag.count(&s->diags);
}

// Sets the text for `path` without reading the file. A later call replaces that text.
fn set_source(session mut* s, string path, string text) void {
    diag.sources mut* files = &s->files;
    string kept = containers.pool_intern(&files->pool, text);
    i64 mut idx = 0;
    // Intern the path only for a new entry. Repeated updates then allocate no path copy.
    if (strmap.get(&files->index, path, &idx)) {
        containers.str_set(&files->texts, cast(idx, u64), kept);
        return;
    }
    containers.str_push(&files->texts, kept);
    strmap.put(&files->index, containers.pool_intern(&files->pool, path),
               cast(files->texts.len - 1, i64));
}

// Returns cached text or reads and caches `path`. On failure, `out` is unchanged.
// sys.errno() identifies the failed file operation. This function reports no diagnostic.
fn read_source(session mut* s, string path, string mut* out) bool {
    return lookup_source(&s->files, path, out);
}

// The source lookup of the diagnostic text form, and the reader of read_source: the text of
// `path` in `files`, or the file read into `files` first. On failure, `out` is unchanged.
fn lookup_source(diag.sources mut* files, string path, string mut* out) bool {
    i64 mut idx = 0;
    // re-reading one file allocates nothing after the first read
    if (strmap.get(&files->index, path, &idx)) {
        *out = containers.str_at(&files->texts, cast(idx, u64));
        return true;
    }
    strbuf.str_buf mut buf = strbuf.create();
    defer strbuf.free(&buf);
    if (!io.read_file(path, &buf)) {
        return false;
    }
    string kept = containers.pool_intern(&files->pool, strbuf.view(&buf));
    containers.str_push(&files->texts, kept);
    strmap.put(&files->index, containers.pool_intern(&files->pool, path),
               cast(files->texts.len - 1, i64));
    *out = kept;
    return true;
}

// Makes the text form of the diagnostics show the source line of each
// diagnostic, read through read_source. The session must not move while its
// sink writes text.
fn show_sources(session mut* s) void {
    diag.set_lookup(&s->diags, lookup_source, &s->files);
}

// Whether the session already holds the contents of `path`, from set_source or
// from an earlier read_source; it opens nothing.
fn has_source(session* s, string path) bool {
    return strmap.has(&s->files.index, path);
}

// The number of files the session holds the contents of.
fn source_count(session* s) u64 {
    return strmap.count(&s->files.index);
}
