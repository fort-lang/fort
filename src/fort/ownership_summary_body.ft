/// Extracts linear ownership effects from available verified FIR bodies.
import ast;
import consts;
import diag;
import fir;
import fir_flow;
import ownership_api;
import ownership_flow;
import ownership_graph;
import ownership_keys;
import ownership_places;
import ownership_state;
import ownership_summary_model;
import ownership_transfer;
import prim;
import types;

u32 U32_MAX = 4294967295;
u64 U64_MAX = 18446744073709551615;

// A published callee. The checked symbol names its declaration.
// The summary stays immutable and live through each inference that reads it.
// A provisional summary belongs to the recursive component that the solver infers now. It
// proves neither absent effects nor absent return (D17.18).
struct callee_binding {
    ast.sym* symbol;
    ownership_summary_model.summary_view* summary;
    bool provisional;
}

// The targets of one call statement from the call graph (D17.18). A residual fort target
// keeps the call unresolved. A foreign target or a residual foreign target keeps the body
// unsupported, because this extractor applies no foreign boundary (D17.13).
struct call_targets {
    u32 block;
    u32 gap;
    callee_binding@ fort;
    bool residual_fort;
    bool foreign;
}

// Stable identities use the checked function key and its finite FIR local numbers.
// The verified body, checked types, and filenames outlive this input and its results.
// `targets` is sorted by block and gap. Without a record, a direct call finds its callee in
// `callees`, and an indirect call stays unsupported.
struct body_input {
    ownership_graph.body_input function;
    ownership_flow.source_file_binding@ source_files;
    ownership_api.services* services;
    ownership_api.limit_table limits;
    ownership_summary_model.coverage_status coverage;
    bool correspondence_complete;
    callee_binding@ callees;
    call_targets@ targets;
}

// One possible fort target of a call. Extraction fixes the fresh allocation keys of its
// callee templates, so no call depth creates a key (D17.18). A null summary is unresolved.
struct call_target {
    callee_binding binding;
    u32 fresh_first;
    u32 fresh_count;
}

// One call of fort targets. Extraction fixes its event key. An unresolved call has a residual
// fort target, so no summary decides it.
struct call_site {
    u32 block;
    u32 gap;
    ownership_api.entity_id event;
    u64 targets_first;
    u64 targets_len;
    bool unresolved;
    // The scalar value of each operand on the path of the call: exact, a captured formal
    // value of this body, or unknown.
    u64 args_first;
    u32 args_len;
}

// Flow borrows these arrays. The program owns its entry and all nested request metadata.
struct body_program {
    ownership_state.state entry;
    ownership_state.state metadata;
    ownership_flow.step mut@ own steps;
    ownership_transfer.event_binding mut@ own transfer_events;
    ownership_flow.event_binding mut@ own events;
    ownership_flow.parameter mut@ own parameters;
    ownership_summary_model.symbolic_root mut@ own roots;
    ownership_summary_model.requirement mut@ own requirements;
    ownership_summary_model.effect_node mut@ own effects;
    ownership_summary_model.provenance mut@ own provenance_records;
    ownership_api.entity_id mut@ own origins;
    ownership_api.scalar_fact mut@ own scalars;
    // A local whose storage this body addresses. A store through that address can change
    // it, so it keeps no scalar fact, no value edge and no capture in the whole body.
    bool mut@ own addressed;
    call_site mut@ own calls;
    u64 calls_len;
    call_target mut@ own targets;
    u64 targets_len;
    ownership_api.scalar_fact mut@ own call_args;
    u64 call_args_len;
    // The body is a forward tree. Each reached block keeps its one parent and the origins and
    // scalars at its entry. A switch on a formal value adds one value edge per target.
    u32 mut@ own parents;
    bool mut@ own reached;
    ownership_api.entity_id mut@ own entry_origins;
    ownership_api.scalar_fact mut@ own entry_scalars;
    ownership_flow.value_edge mut@ own values;
    u64 values_len;
    // A holding aggregate local: 1 after a write, 2 after its move or copy into the result.
    // Each reached block keeps the marks at its entry.
    u8 mut@ own holding;
    u8 mut@ own entry_holding;
    u64 steps_len;
    u64 events_len;
    u64 parameters_len;
    u64 roots_len;
    u64 requirements_len;
    u64 effects_len;
    u64 provenance_len;
    ownership_api.proof_status proof;
    ownership_summary_model.coverage_status coverage;
    ownership_summary_model.context context;
    // The roots, requirements, effects, exits, and published relations of this function,
    // as charged to E.
    u64 relations;
    u32 next_key;
    bool residual_effects;
    bool held_inline_address;
    bool definite_prefix;
    // A call changed caller-visible state that this summary does not export.
    // Flow still checks the body. The published summary stays incomplete.
    bool call_residual;
    // A call of a provisional target that has no possible case, or whose possible cases do
    // not cover the captured values. The first such call names its position.
    bool uncovered;
    ownership_api.operation_position uncovered_operation;
    ownership_api.source_position uncovered_source;
    // A provisional call ended a path without an exit.
    bool vacuous;
}

fn free(body_program mut* out) void {
    body_program mut owned = move(*out);
    ownership_state.free(&owned.entry);
    ownership_state.free(&owned.metadata);
    del(owned.steps);
    del(owned.transfer_events);
    del(owned.events);
    del(owned.parameters);
    del(owned.roots);
    del(owned.requirements);
    del(owned.effects);
    del(owned.provenance_records);
    del(owned.origins);
    del(owned.scalars);
    del(owned.addressed);
    del(owned.calls);
    del(owned.targets);
    del(owned.call_args);
    del(owned.parents);
    del(owned.reached);
    del(owned.entry_origins);
    del(owned.entry_scalars);
    del(owned.values);
    del(owned.holding);
    del(owned.entry_holding);
    *out = body_program{};
}

fn id(ownership_api.function_id function, ownership_api.entity_kind kind, u32 number)
    ownership_api.entity_id {
    return ownership_api.entity_id{function, kind, number};
}

fn slot(body_input* in, u32 local_at_point) ownership_api.place_path {
    return ownership_api.place_path{.root = id(in->function.key,
        ownership_api.entity_kind.slot, local_at_point)};
}

fn source(body_input* in, u32 local_at_point) ownership_api.entity_id {
    return id(in->function.key, ownership_api.entity_kind.source, local_at_point + 1);
}

fn designated(body_input* in, u32 local_at_point) ownership_api.entity_id {
    return id(in->function.key, ownership_api.entity_kind.source,
        fir.local_count(in->function.body) + local_at_point + 1);
}

fn caller_slot(body_input* in, u32 local_at_point) ownership_api.place_path {
    return slot(in, fir.local_count(in->function.body) + local_at_point + 1);
}

fn integer(i64 n) ownership_api.scalar_fact {
    return ownership_api.scalar_fact{.kind = ownership_api.fact_kind.exact, .value = n};
}

fn position(body_input* in, u32 block, u32 gap, bool terminator)
    ownership_api.operation_position {
    return ownership_api.operation_position{in->function.key, block, gap, terminator};
}

fn location(body_input* in, body_program mut* out, diag.loc where) ownership_api.source_position {
    ownership_api.source_position mut at = ownership_api.source_position{
        .line = where.line, .col = where.col, .end_line = where.end_line, .end_col = where.end_col,
        .filename_present = where.file.len > 0};
    u64 mut i = 0;
    while (i < in->source_files.len) {
        if (!work(out, 1)) { return at; }
        ownership_flow.source_file_binding row = in->source_files[i];
        if (row.filename == where.file) { at.module = row.module; at.file = row.file; return at; }
        i += 1;
    }
    at.filename_present = false;
    return at;
}

fn work(body_program mut* out, u64 n) bool {
    return ownership_summary_model.work(&out->context, &out->proof, n);
}

fn reject(body_program mut* out, ownership_api.incomplete_reason reason) void {
    if (!ownership_api.successful(out->proof)) { return; }
    out->proof = ownership_summary_model.fail(&out->context, reason, out->context.event);
    out->residual_effects = true;
}

// A body key never takes the ordinal U32_MAX: the recursive solver keeps it for the event of
// a stopped computation (`ownership_recursive.stop`).
fn next(body_program mut* out, ownership_api.entity_kind kind) ownership_api.entity_id {
    if (!work(out, 1) || out->next_key >= U32_MAX - 1) {
        reject(out, ownership_api.incomplete_reason.invalid_input);
        return ownership_api.entity_id{};
    }
    out->next_key += 1;
    return id(out->context.operation.function, kind, out->next_key);
}

fn reference(types.node* ty) bool {
    return ty != null && (ty->kind == types.type_kind.k_ptr ||
        ty->kind == types.type_kind.k_span || ty->kind == types.type_kind.k_string);
}

fn direct(fir.place place_at) bool {
    return place_at.base == fir.base_kind.bk_local && place_at.proj_len == 0;
}

fn empty(ownership_api.place_path place_at, bool owning) ownership_api.contents_fact {
    return ownership_api.contents_fact{.place = place_at,
        .kind = owning ? ownership_api.contents_kind.empty_owner :
            ownership_api.contents_kind.scalar,
        .span_length = integer(0), .owner_empty = owning};
}

fn extent(types.node* ty) u64 {
    if (ty->kind == types.type_kind.k_string) { return 1; }
    if (ty->elem == null || !types.type_size_fits(ty->elem) ||
        ty->elem->kind == types.type_kind.k_void) { return 0; }
    return types.type_sizeof(ty->elem);
}

fn pointee_alignment(types.node* ty) u64 {
    if (ty->kind == types.type_kind.k_string) { return 1; }
    if (ty->elem == null || ty->elem->kind == types.type_kind.k_void) { return 0; }
    return types.type_alignof(ty->elem);
}

fn range(body_input* in, body_program mut* out, ownership_api.entity_id key, i64 length,
    u64 size)
    ownership_api.region {
    if (length < 0 || size == 0 || cast(length, u64) > 9223372036854775807 / size) {
        reject(out, ownership_api.incomplete_reason.invalid_input);
        return ownership_api.region{};
    }
    i64 bytes = cast(cast(length, u64) * size, i64);
    return ownership_api.region{.key = id(in->function.key,
        ownership_api.entity_kind.region, key.ordinal), .source = key, .offset = integer(0),
        .access = ownership_api.byte_window{integer(0), integer(bytes), true},
        .extent = integer(bytes), .alignment = size == 0 ? 1 : size};
}

fn value(body_input* in, body_program mut* out, ownership_api.place_path place_at,
    ownership_api.entity_id key, u32 version, i64 length, u64 size, u64 align)
    ownership_api.contents_fact {
    ownership_api.borrow_relation[1] mut relations = {ownership_api.borrow_relation{
        .key = id(in->function.key, ownership_api.entity_kind.relation, version),
        .value_version = id(in->function.key, ownership_api.entity_kind.value, version),
        .containing = place_at, .source = key, .range = range(in, out, key, length, size),
        .representation_complete = true}};
    relations[0].range.alignment = align;
    ownership_api.contents_fact data = ownership_api.contents_fact{.place = place_at,
        .kind = ownership_api.contents_kind.reference,
        .value_version = relations[0].value_version, .borrows = relations[..],
        .span_length = integer(length)};
    if (!ownership_summary_model.contents_charge(&out->context, &out->proof, data)) {
        return ownership_api.contents_fact{};
    }
    return ownership_state.copy_contents(&out->metadata, data);
}

fn root(body_program mut* out, ownership_summary_model.symbolic_root row) void {
    if (!work(out, 1) || out->roots_len >= out->roots.len ||
        !ownership_summary_model.effect_charge(&out->context, &out->proof, &out->relations)) {
        reject(out, ownership_api.incomplete_reason.invalid_input);
        return;
    }
    out->roots[out->roots_len] = row;
    out->roots_len += 1;
}

fn seed(body_input* in, body_program mut* out) bool {
    fir.func* f = in->function.body;
    u32 count = fir.local_count(f);
    u32 mut i = 0;
    while (i < count) {
        if (!work(out, 8)) { return false; }
        fir.local* local_at_point = fir.local_at(f, i);
        ownership_api.place_path place_at = slot(in, i);
        ownership_api.entity_id storage = source(in, i);
        root(out, ownership_summary_model.symbolic_root{
            .key = id(in->function.key, ownership_api.entity_kind.template, i + 1),
            .kind = i == 0 ? ownership_summary_model.root_kind.result :
                ownership_summary_model.root_kind.by_value_slot,
            .formal = local_at_point->kind == fir.local_kind.lk_param ? i : 0,
                .slot = place_at.root,
            .source = i == 0 ? ownership_api.entity_id{} : storage, .ty = local_at_point->ty,
            .ownership = local_at_point->ty->is_own ? ownership_summary_model.owner_class.owning :
                ownership_summary_model.owner_class.borrowed});
        ownership_state.append_sources(&out->entry, ownership_api.source_fact{
            .key = storage, .kind = ownership_api.source_kind.stack,
            .validity = ownership_api.validity_kind.live});
        ownership_api.contents_fact mut contents = empty(place_at, local_at_point->ty->is_own);
        if (local_at_point->kind == fir.local_kind.lk_param) {
            if (fir.type_aggregate(local_at_point->ty) && fir.type_owning(local_at_point->ty)) {
                reject(out, ownership_api.incomplete_reason.unknown_effect);
                return false;
            }
            out->parameters[out->parameters_len] = ownership_flow.parameter{place_at.root, storage};
            out->parameters_len += 1;
            if (reference(local_at_point->ty)) {
                ownership_api.entity_id pointed = designated(in, i);
                out->origins[i] = pointed;
                ownership_api.entity_id allocation = local_at_point->ty->is_own ?
                    id(in->function.key, ownership_api.entity_kind.allocation, pointed.ordinal) :
                    ownership_api.entity_id{};
                root(out, ownership_summary_model.symbolic_root{
                    .key = id(in->function.key, ownership_api.entity_kind.template, count + i + 1),
                    .kind = ownership_summary_model.root_kind.caller_source, .formal = i,
                    .slot = caller_slot(in, i).root, .source = pointed, .allocation = allocation,
                    .ty = local_at_point->ty, .ownership = local_at_point->ty->is_own ?
                        ownership_summary_model.owner_class.owning :
                        ownership_summary_model.owner_class.borrowed});
                ownership_state.append_sources(&out->entry, ownership_api.source_fact{
                    .key = pointed, .kind = local_at_point->ty->is_own
                        ? ownership_api.source_kind.heap :
                        ownership_api.source_kind.symbolic_caller,
                    .validity = ownership_api.validity_kind.live, .allocation = allocation});
                u64 size = extent(local_at_point->ty);
                if (size == 0 || size > 9223372036854775807) {
                    reject(out, ownership_api.incomplete_reason.missing_correspondence);
                    return false;
                }
                contents = value(in, out, place_at, pointed, i + 1, 1, size,
                    pointee_alignment(local_at_point->ty));
                if (local_at_point->ty->kind != types.type_kind.k_ptr) {
                    contents.span_length = ownership_api.scalar_fact{
                        .kind = ownership_api.fact_kind.symbolic,
                        .symbol = id(in->function.key, ownership_api.entity_kind.value, i + 1)};
                    if (local_at_point->ty->is_own) {
                        reject(out, ownership_api.incomplete_reason.unknown_effect);
                        return false;
                    }
                }
                if (local_at_point->ty->is_own) {
                    ownership_state.append_allocations(&out->entry, ownership_api.allocation_fact{
                        .key = allocation, .site = allocation,
                        .validity = ownership_api.validity_kind.live,
                        .count = ownership_api.multiplicity{false, true, false}, .obligation = true,
                        .owner = ownership_api.owner_location{.place = place_at},
                        .logical_length = integer(1)});
                }
            } else if (fir.type_aggregate(local_at_point->ty)) {
                contents.kind = ownership_api.contents_kind.aggregate;
            } else {
                // A scalar formal is a captured caller value. A call binds it as a capture.
                // An addressed formal can change through its address, so it has no symbol.
                contents.value_version = id(in->function.key, ownership_api.entity_kind.value,
                    i + 1);
                if (!out->addressed[i]) {
                    out->scalars[i] = ownership_api.scalar_fact{
                        .kind = ownership_api.fact_kind.symbolic,
                        .symbol = contents.value_version};
                }
            }
        }
        ownership_state.append_contents(&out->entry, contents);
        i += 1;
    }
    return ownership_api.successful(out->proof);
}

fn caller_source(body_program mut* out, ownership_api.entity_id pointed) bool {
    bool mut caller = false;
    u64 mut origin = 0;
    while (origin < out->roots_len) {
        if (!work(out, 1)) { return false; }
        ownership_summary_model.symbolic_root candidate = out->roots[origin];
        if ((candidate.kind == ownership_summary_model.root_kind.caller_source ||
            candidate.kind == ownership_summary_model.root_kind.loaded_source) &&
            ownership_summary_model.same(candidate.source, pointed)) { caller = true; }
        origin += 1;
    }
    return caller;
}

fn requirement(body_input* in, body_program mut* out, ownership_api.entity_id pointed,
    ownership_api.place_path mut place_at, i64 bytes, ownership_summary_model.requirement_kind kind,
    u64 align) void {
    if (pointed.kind == ownership_api.entity_kind.none || !caller_source(out, pointed)) { return; }
    if (!work(out, 1) || out->requirements_len >= out->requirements.len ||
        !ownership_summary_model.effect_charge(&out->context, &out->proof, &out->relations)) {
        reject(out, ownership_api.incomplete_reason.invalid_input);
        return;
    }
    ownership_api.entity_id key = next(out, ownership_api.entity_kind.relation);
    ownership_api.region mut needed = range(in, out, pointed, bytes, 1);
    needed.alignment = align;
    needed.key = id(in->function.key, ownership_api.entity_kind.region, key.ordinal);
    if (!ownership_summary_model.path_charge(&out->context, &out->proof, place_at)) { return; }
    place_at = ownership_state.copy_place(&out->metadata, place_at);
    out->requirements[out->requirements_len] = ownership_summary_model.requirement{
        .key = key, .kind = kind, .path = place_at, .source = pointed, .range = needed,
        .operation = out->context.operation};
    out->requirements_len += 1;
}

fn emit(body_input* in, body_program mut* out, ownership_transfer.request mut req,
    u32 block, u32 gap, u32 order, ownership_summary_model.payload_kind payload,
    diag.loc at, diag.loc exit_at, u32 statement,
    ownership_api.place_path flow_destination) void {
    if (!work(out, 3) ||
        !ownership_summary_model.effect_charge(&out->context, &out->proof, &out->relations) ||
        out->steps_len >= out->steps.len || out->effects_len >= out->effects.len ||
        out->provenance_len >= out->provenance_records.len) {
        reject(out, ownership_api.incomplete_reason.invalid_input);
        return;
    }
    u64 index = out->steps_len;
    req.operation = position(in, block, gap, false);
    req.source_position = location(in, out, at);
    req.direct_source_proved = true;
    req.direct_destination_proved = true;
    req.event_map_complete_proved = true;
    out->transfer_events[index] = ownership_transfer.event_binding{req.operation,
        next(out, ownership_api.entity_kind.event)};
    req.event_bindings = out->transfer_events[index..index + 1];
    if (!ownership_summary_model.path_charge(&out->context, &out->proof, req.source) ||
        !ownership_summary_model.path_charge(&out->context, &out->proof, req.destination)) {
        return;
    }
    req.source = ownership_state.copy_place(&out->metadata, req.source);
    req.destination = ownership_state.copy_place(&out->metadata, req.destination);
    req.value = ownership_state.copy_contents(&out->metadata, req.value);
    ownership_transfer.request mut flow_request = req;
    flow_request.destination = flow_destination;
    if (payload == ownership_summary_model.payload_kind.release) {
        flow_request.source = flow_destination;
    } else if (payload == ownership_summary_model.payload_kind.move &&
        req.source.projections.len != 0) {
        // Move uses its source contents. This value field names private flow storage.
        flow_request.source = req.value.place;
    } else if (flow_request.kind == ownership_transfer.action.assignment) {
        ownership_api.projection@ none = {};
        flow_request.source.projections = none;
    }
    out->steps[index] = ownership_flow.step{.block = block, .gap = gap, .order = cast(index, u32),
        .kind = ownership_flow.step_kind.local_effect, .operation = req.operation,
        .source = req.source_position, .local = flow_request};
    ownership_api.entity_id effect_key = next(out, ownership_api.entity_kind.relation);
    ownership_api.entity_id provenance_key = next(out, ownership_api.entity_kind.event);
    ownership_api.effect_kind kind = payload == ownership_summary_model.payload_kind.release ?
        ownership_api.effect_kind.release : payload == ownership_summary_model.payload_kind.move ?
        ownership_api.effect_kind.transfer : payload ==
            ownership_summary_model.payload_kind.storage_end
                ? ownership_api.effect_kind.storage_end :
        payload == ownership_summary_model.payload_kind.read ? ownership_api.effect_kind.read :
            ownership_api.effect_kind.write;
    ownership_api.deferred_occurrence mut deferred = ownership_api.deferred_occurrence{};
    if (exit_at.file.len > 0) {
        deferred.registration = ownership_api.declaration_id{in->function.key.declaration.module,
            statement};
        deferred.context = block;
        deferred.exit_occurrence = gap;
        deferred.exit_source = location(in, out, exit_at);
    }
    out->effects[out->effects_len] = ownership_summary_model.effect_node{
        .effect = ownership_api.ordered_effect{effect_key, kind, req.operation,
            req.destination, req.source_key, req.allocation.key,
            ownership_api.entity_id{}}, .payload = payload, .operand = req.source,
        .value = req.value, .range = req.value.borrows.len == 1 ?
            req.value.borrows[0].range : ownership_api.region{},
        .provenance = provenance_key, .deferred = deferred};
    out->effects_len += 1;
    out->provenance_records[out->provenance_len] = ownership_summary_model.provenance{
        .key = provenance_key, .operation = req.operation, .source = req.source_position,
        .deferred = deferred, .callee = in->function.key, .filename = at.file};
    out->provenance_len += 1;
    out->steps_len += 1;
}

// Appends a summary effect without a flow step. Flow already applied the call it records.
fn export_effect(body_input* in, body_program mut* out,
    ownership_summary_model.effect_node mut node, ownership_api.source_position where,
    string filename) void {
    if (!work(out, 3) ||
        !ownership_summary_model.effect_charge(&out->context, &out->proof, &out->relations) ||
        out->effects_len >= out->effects.len ||
        out->provenance_len >= out->provenance_records.len) {
        reject(out, ownership_api.incomplete_reason.invalid_input);
        return;
    }
    if (!ownership_summary_model.path_charge(&out->context, &out->proof, node.effect.place) ||
        !ownership_summary_model.path_charge(&out->context, &out->proof, node.operand) ||
        !ownership_summary_model.contents_charge(&out->context, &out->proof, node.value) ||
        !ownership_summary_model.region_charge(&out->context, &out->proof, node.range)) {
        return;
    }
    node.effect.key = next(out, ownership_api.entity_kind.relation);
    node.provenance = next(out, ownership_api.entity_kind.event);
    if (!ownership_api.successful(out->proof)) { return; }
    node.effect.place = ownership_state.copy_place(&out->metadata, node.effect.place);
    node.operand = ownership_state.copy_place(&out->metadata, node.operand);
    node.value = ownership_state.copy_contents(&out->metadata, node.value);
    node.range = ownership_state.copy_region(&out->metadata, node.range);
    out->effects[out->effects_len] = node;
    out->effects_len += 1;
    out->provenance_records[out->provenance_len] = ownership_summary_model.provenance{
        .key = node.provenance, .operation = node.effect.operation, .source = where,
        .callee = in->function.key, .filename = filename};
    out->provenance_len += 1;
}

// A callee requirement on a caller source becomes a requirement of this body at the call.
// One read at that operation makes each later caller check it before application.
fn export_requirement(body_input* in, body_program mut* out,
    ownership_summary_model.requirement row, ownership_api.place_path holder,
    ownership_api.operation_position at, ownership_api.source_position where, string filename)
    void {
    u64 mut i = 0;
    while (i < out->requirements_len) {
        if (!work(out, 1)) { return; }
        ownership_summary_model.requirement prior = out->requirements[i];
        if (prior.kind == row.kind && ownership_summary_model.same(prior.source, row.source) &&
            ownership_keys.operation(prior.operation, at) == 0 &&
            prior.range.access.end.kind == row.range.access.end.kind &&
            prior.range.access.end.value == row.range.access.end.value &&
            prior.range.alignment == row.range.alignment) { return; }
        i += 1;
    }
    if (!work(out, 1) || out->requirements_len >= out->requirements.len ||
        !ownership_summary_model.effect_charge(&out->context, &out->proof, &out->relations) ||
        !ownership_summary_model.path_charge(&out->context, &out->proof, holder) ||
        !ownership_summary_model.region_charge(&out->context, &out->proof, row.range)) {
        reject(out, ownership_api.incomplete_reason.invalid_input);
        return;
    }
    ownership_api.entity_id key = next(out, ownership_api.entity_kind.relation);
    ownership_api.region mut needed = ownership_state.copy_region(&out->metadata, row.range);
    needed.key = id(in->function.key, ownership_api.entity_kind.region, key.ordinal);
    out->requirements[out->requirements_len] = ownership_summary_model.requirement{
        .key = key, .kind = row.kind, .path = ownership_state.copy_place(&out->metadata, holder),
        .source = row.source, .range = needed, .operation = at};
    out->requirements_len += 1;
    i = 0;
    while (i < out->effects_len) {
        if (!work(out, 1)) { return; }
        ownership_summary_model.effect_node prior = out->effects[i];
        if (prior.payload == ownership_summary_model.payload_kind.read &&
            ownership_keys.operation(prior.effect.operation, at) == 0 &&
            ownership_summary_model.same(prior.effect.source, row.source)) { return; }
        i += 1;
    }
    export_effect(in, out, ownership_summary_model.effect_node{
        .effect = ownership_api.ordered_effect{.kind = ownership_api.effect_kind.read,
            .operation = at, .place = holder, .source = row.source},
        .payload = ownership_summary_model.payload_kind.read, .operand = holder}, where,
        filename);
}

// The call result becomes one write of its current contents at the call.
fn export_result(body_input* in, body_program mut* out, ownership_api.place_path destination,
    ownership_api.contents_fact value, ownership_api.operation_position at,
    ownership_api.source_position where, string filename) void {
    ownership_api.contents_fact mut written = value;
    written.place = destination;
    export_effect(in, out, ownership_summary_model.effect_node{
        .effect = ownership_api.ordered_effect{.kind = ownership_api.effect_kind.write,
            .operation = at, .place = destination,
            .source = value.borrows.len == 1 ? value.borrows[0].source :
                ownership_api.entity_id{}},
        .payload = ownership_summary_model.payload_kind.replacement, .operand = destination,
        .value = written, .range = value.borrows.len == 1 ? value.borrows[0].range :
            ownership_api.region{}}, where, filename);
}

fn basic(body_input* in, u32 src, u32 dst, ownership_transfer.action effect_action)
    ownership_transfer.request {
    return ownership_transfer.request{.kind = effect_action, .source = slot(in, src),
        .destination = slot(in, dst), .source_key = source(in, src),
        .destination_owns = fir.local_at(in->function.body, dst)->ty->is_own};
}

// A bool constant is the exact value 1 or 0. `cv_to_i64` takes only an integer.
fn constant(body_input* in, body_program* out, fir.operand input_operand)
    ownership_api.scalar_fact {
    if (input_operand.kind == fir.operand_kind.ok_const &&
        input_operand.value.kind == fir.const_kind.ck_bool) {
        return integer(consts.cv_eq(input_operand.value.value, consts.cv_from_bool(true)) ?
            1 : 0);
    } else if (input_operand.kind == fir.operand_kind.ok_const &&
        input_operand.value.kind == fir.const_kind.ck_int) {
        i64 mut n = 0;
        if (consts.cv_to_i64(input_operand.value.value, &n)) { return integer(n); }
    } else if (direct(input_operand.place) && cast(input_operand.place.local,
        u64) < out->scalars.len) {
        return out->scalars[input_operand.place.local];
    }
    return ownership_api.scalar_fact{};
}

// A cast keeps a scalar fact only when the destination type holds the value. A narrowing or
// a sign change wraps, and a wrapped value proves no index or extent (D17.17). A cast to
// another type keeps no symbolic value. The range test is the one that constant folding uses.
fn cast_value(types.node* dst, types.node* src, ownership_api.scalar_fact value)
    ownership_api.scalar_fact {
    if (dst != null && src != null && types.type_equal(dst, src)) { return value; }
    return value.kind == ownership_api.fact_kind.exact && dst != null && types.type_is_int(dst) &&
        consts.int_fits(consts.cv_from_i64(value.value), dst->prim) ? value :
        ownership_api.scalar_fact{};
}

fn add_read(body_input* in, body_program mut* out, fir.place place_at, u32 block, u32 gap,
    u32 order, diag.loc at, diag.loc exit_at, u32 statement) bool {
    if (place_at.base != fir.base_kind.bk_local || cast(place_at.local, u64) >= out->origins.len) {
        reject(out, ownership_api.incomplete_reason.unknown_effect);
        return false;
    }
    selected_storage mut selected = selected_storage{};
    if (place_at.proj_len > 1) { selected = select_storage(in, out, place_at); }
    if (place_at.proj_len > 1 && !selected.proved) { return false; }
    // A nested read through a reference to storage of this body has no modeled place, so it
    // stays unsupported. A nested read of a by-value local reads that local, as one step does.
    if (place_at.proj_len > 1 && selected.indirect && !selected.caller) {
        reject(out, ownership_api.incomplete_reason.unknown_effect);
        return false;
    }
    if (place_at.proj_len > 1 && selected.indirect) {
        requirement(in, out, selected.source, selected.path, selected.offset + selected.bytes,
            ownership_summary_model.requirement_kind.extent, types.type_alignof(selected.ty));
        ownership_transfer.request req = ownership_transfer.request{
            .kind = ownership_transfer.action.inspect, .source = selected.path,
            .destination = selected.path, .source_key = selected.source};
        emit(in, out, req, block, gap, order, ownership_summary_model.payload_kind.read,
            at, exit_at, statement, req.destination);
        if (!ownership_api.successful(out->proof)) { return false; }
        ownership_api.region typed = range(in, out, selected.source,
            selected.offset + selected.bytes, 1);
        out->effects[out->effects_len - 1].range = typed;
        return true;
    }
    ownership_transfer.request mut req = basic(in, place_at.local, place_at.local,
        ownership_transfer.action.inspect);
    ownership_api.region mut typed = ownership_api.region{};
    if (reference(fir.local_at(in->function.body, place_at.local)->ty)) {
        req.source_key = out->origins[place_at.local];
        requirement(in, out, req.source_key, req.source, 0,
            ownership_summary_model.requirement_kind.live_source, 1);
        types.node* base = fir.local_at(in->function.body, place_at.local)->ty;
        bool header = place_at.proj_len == 1 &&
            (base->kind == types.type_kind.k_span || base->kind == types.type_kind.k_string) &&
            fir.place_projection(in->function.body, place_at, 0).kind == fir.proj_kind.pj_field;
        if (place_at.proj_len > 0 && !header) {
            u64 size = extent(base);
            i64 mut elements = 1;
            u32 mut p = 0;
            while (p < place_at.proj_len) {
                if (!work(out, 1)) { return false; }
                fir.projection part = fir.place_projection(in->function.body, place_at, p);
                if (part.kind == fir.proj_kind.pj_index) {
                    if (cast(part.index, u64) >= out->scalars.len ||
                        out->scalars[part.index].kind != ownership_api.fact_kind.exact ||
                        out->scalars[part.index].value < 0 ||
                        out->scalars[part.index].value == 9223372036854775807) {
                        reject(out, ownership_api.incomplete_reason.missing_path);
                        return false;
                    }
                    elements = out->scalars[part.index].value + 1;
                } else if (part.kind != fir.proj_kind.pj_deref) {
                    reject(out, ownership_api.incomplete_reason.unknown_effect);
                    return false;
                }
                p += 1;
            }
            if (size == 0 || cast(elements, u64) > 9223372036854775807 / size) {
                reject(out, ownership_api.incomplete_reason.missing_path);
                return false;
            }
            i64 bytes = cast(cast(elements, u64) * size, i64);
            u64 align = pointee_alignment(base);
            bool caller = caller_source(out, req.source_key);
            if (caller) {
                requirement(in, out, req.source_key, req.source, bytes,
                    ownership_summary_model.requirement_kind.extent, align);
            } else if (!local_read(in, out, req.source_key, bytes, align, at)) { return false; }
            // Caller extent requirements guard this symbolic body read.
            // Application still uses the actual caller representation.
            req.kind = caller ? ownership_transfer.action.inspect : ownership_transfer.action.use;
            typed = range(in, out, req.source_key, bytes, 1);
            typed.key = next(out, ownership_api.entity_kind.region);
            typed.alignment = align;
        }
    }
    emit(in, out, req, block, gap, order, ownership_summary_model.payload_kind.read,
        at, exit_at, statement, req.destination);
    if (typed.key.kind != ownership_api.entity_kind.none &&
        ownership_api.successful(out->proof)) {
        out->effects[out->effects_len - 1].range = typed;
    }
    return ownership_api.successful(out->proof);
}

fn local_range(body_input* in, body_program mut* out, ownership_api.entity_id pointed)
    ownership_api.region {
    u64 mut i = 0;
    while (i < out->roots_len) {
        if (!work(out, 1)) { return ownership_api.region{}; }
        ownership_summary_model.symbolic_root selected = out->roots[i];
        if (selected.kind == ownership_summary_model.root_kind.by_value_slot &&
            ownership_summary_model.same(selected.source, pointed)) {
            if (selected.ty == null || !types.type_size_fits(selected.ty)) {
                return ownership_api.region{};
            }
            ownership_api.region mut known = range(in, out, pointed, 1,
                types.type_sizeof(selected.ty));
            known.alignment = types.type_alignof(selected.ty);
            return known;
        }
        if (selected.kind == ownership_summary_model.root_kind.allocation_template) {
            u64 mut k = 0;
            while (k < out->effects_len) {
                if (!work(out, 1)) { return ownership_api.region{}; }
                ownership_summary_model.effect_node node = out->effects[k];
                if (node.payload == ownership_summary_model.payload_kind.allocation &&
                    ownership_summary_model.same(node.effect.allocation, selected.allocation) &&
                    node.value.borrows.len == 1 &&
                    ownership_summary_model.same(node.value.borrows[0].source, pointed)) {
                    return node.value.borrows[0].range;
                }
                k += 1;
            }
        }
        i += 1;
    }
    return ownership_api.region{};
}

fn local_read(body_input* in, body_program mut* out, ownership_api.entity_id pointed,
    i64 bytes, u64 align, diag.loc at) bool {
    ownership_api.region known = local_range(in, out, pointed);
    if (!ownership_api.successful(out->proof)) { return false; }
    if (known.key.kind == ownership_api.entity_kind.none ||
        known.extent.kind != ownership_api.fact_kind.exact ||
        known.offset.kind != ownership_api.fact_kind.exact || known.offset.value != 0 ||
        !known.access.arithmetic_proved || known.access.end.kind != ownership_api.fact_kind.exact ||
        known.extent.value < 0 || known.access.end.value < 0 || bytes < 0 || align == 0) {
        reject(out, ownership_api.incomplete_reason.missing_path);
        return false;
    }
    if (known.extent.value < bytes || known.access.end.value < bytes) {
        if (!out->definite_prefix) {
            reject(out, ownership_api.incomplete_reason.missing_path);
            return false;
        }
        ownership_api.proof_status mut proof = ownership_summary_model.complete();
        proof.failed = true;
        ownership_api.event_descriptor event = ownership_api.event_descriptor{
            .key = out->context.event, .operation = out->context.operation,
            .source = location(in, out, at), .kind = ownership_api.event_kind.invalid_use,
            .evidence = ownership_api.evidence_kind.unconditional, .relation = pointed,
            .text = "typed read exceeds its original storage window"};
        ownership_api.event_request report = ownership_api.event_request{event, proof};
        out->proof = ownership_api.record_event(in->services, &report).proof;
        out->residual_effects = true;
        return false;
    }
    if (known.alignment == 0 || known.alignment % align != 0) {
        reject(out, ownership_api.incomplete_reason.missing_path);
        return false;
    }
    return true;
}

fn escape_survives(body_input* in, body_program mut* out, fir.place to) bool {
    if (!out->definite_prefix) {
        reject(out, ownership_api.incomplete_reason.unknown_effect);
        return false;
    }
    fir.func* f = in->function.body;
    u32 mut block = out->context.operation.block;
    u32 mut gap = out->context.operation.operation + 1;
    while (block < fir.block_count(f)) {
        if (!work(out, 1)) { return false; }
        while (gap < fir.block_statement_count(f, block)) {
            if (!work(out, 1)) { return false; }
            fir.statement* later = fir.block_statement(f, block, gap);
            if ((later->kind == fir.stmt_kind.st_assign || later->kind == fir.stmt_kind.st_del) &&
                (!direct(later->place) || (direct(to) && later->place.local == to.local))) {
                reject(out, ownership_api.incomplete_reason.unknown_effect);
                return false;
            }
            if (later->kind == fir.stmt_kind.st_assign &&
                later->value.kind == fir.rvalue_kind.rv_call) {
                reject(out, ownership_api.incomplete_reason.unknown_effect);
                return false;
            }
            if (later->kind != fir.stmt_kind.st_assign && later->kind != fir.stmt_kind.st_del &&
                later->kind != fir.stmt_kind.st_live && later->kind != fir.stmt_kind.st_dead) {
                reject(out, ownership_api.incomplete_reason.unknown_effect);
                return false;
            }
            gap += 1;
        }
        fir.terminator term = fir.block_at(f, block)->term;
        if (term.kind == fir.term_kind.tk_return) { return true; }
        if (term.kind != fir.term_kind.tk_goto || term.target <= block) {
            reject(out, ownership_api.incomplete_reason.unknown_effect);
            return false;
        }
        block = term.target;
        gap = 0;
    }
    reject(out, ownership_api.incomplete_reason.unknown_effect);
    return false;
}

fn intrinsic(body_input* in, body_program mut* out, fir.place from, fir.place to,
    diag.loc at) bool {
    if (from.base != fir.base_kind.bk_local || from.local >= fir.local_count(in->function.body)) {
        return false;
    }
    if (!work(out, cast(from.proj_len, u64)) || !work(out, cast(to.proj_len, u64))) {
        return true;
    }
    if (fir.place_indirect(in->function.body, from)) { return false; }
    fir.local* local_at_point = fir.local_at(in->function.body, from.local);
    bool escapes = (direct(to) && to.local == 0) || to.base != fir.base_kind.bk_local ||
        (to.proj_len > 0 && fir.place_indirect(in->function.body, to));
    if (!escapes || local_at_point->kind != fir.local_kind.lk_param) { return false; }
    if (!escape_survives(in, out, to)) { return true; }
    ownership_api.proof_status mut proof = ownership_summary_model.complete();
    proof.failed = true;
    ownership_api.event_descriptor event = ownership_api.event_descriptor{
        .key = out->context.event, .operation = out->context.operation,
        .source = location(in, out, at), .kind = ownership_api.event_kind.invalid_use,
        .evidence = ownership_api.evidence_kind.unconditional, .relation = source(in, from.local),
        .text = "borrowed address outlives by-value parameter storage"};
    ownership_api.event_request report = ownership_api.event_request{event, proof};
    out->proof = ownership_api.record_event(in->services, &report).proof;
    out->residual_effects = true;
    return true;
}

// A selected path names storage. Its source names the storage lifetime.
// One definition names the current reference at this verified operation.
fn load_reference(body_input* in, body_program mut* out, ownership_api.place_path place,
    ownership_api.entity_id containing, types.node* ty, i64 offset) ownership_api.place_path {
    ownership_api.place_path destination = ownership_api.place_path{
        .root = next(out, ownership_api.entity_kind.slot)};
    ownership_api.entity_id pointed = next(out, ownership_api.entity_kind.source);
    ownership_api.entity_id mut allocation = pointed;
    allocation.kind = ownership_api.entity_kind.allocation;
    ownership_api.entity_id mut version = pointed;
    version.kind = ownership_api.entity_kind.value;
    u64 bytes = types.type_sizeof(ty);
    if (!reference(ty) || ty->elem == null || bytes > 9223372036854775807 ||
        offset < 0 || offset > 9223372036854775807 - cast(bytes, i64)) {
        reject(out, ownership_api.incomplete_reason.missing_path);
        return destination;
    }
    requirement(in, out, containing, place, offset + cast(bytes, i64),
        ownership_summary_model.requirement_kind.extent, types.type_alignof(ty));
    root(out, ownership_summary_model.symbolic_root{
        .key = next(out, ownership_api.entity_kind.template),
        .kind = ownership_summary_model.root_kind.loaded_source, .slot = destination.root,
        .source = pointed, .allocation = allocation, .value_version = version,
        .ownership = ownership_summary_model.owner_class.borrowed, .ty = ty});
    // The root keeps its allocation for binding. The source fact has none, as a borrowed
    // formal has none: the body proves no fact about the caller allocation.
    ownership_state.append_sources(&out->entry, ownership_api.source_fact{
        .key = pointed, .kind = ownership_api.source_kind.symbolic_caller,
        .validity = ownership_api.validity_kind.live});
    ownership_api.contents_fact contents = value(in, out, destination, pointed,
        version.ordinal, 1, extent(ty), pointee_alignment(ty));
    ownership_state.append_contents(&out->entry, empty(destination, false));
    ownership_api.operation_position op = out->context.operation;
    fir.statement* stmt = fir.block_statement(in->function.body, op.block, op.operation);
    ownership_transfer.request read = ownership_transfer.request{
        .kind = ownership_transfer.action.inspect, .source = destination,
        .destination = destination, .source_key = containing};
    emit(in, out, read, op.block, op.operation, 0, ownership_summary_model.payload_kind.read,
        stmt->loc, stmt->exit_loc, stmt->stmt, destination);
    ownership_transfer.request req = ownership_transfer.request{
        .kind = ownership_transfer.action.assignment, .source = place,
        .destination = destination, .source_key = containing, .value = contents};
    emit(in, out, req, op.block, op.operation, cast(out->effects_len, u32),
        ownership_summary_model.payload_kind.reference_load, stmt->loc, stmt->exit_loc,
        stmt->stmt, destination);
    return destination;
}

struct selected_storage {
    ownership_api.place_path path;
    ownership_api.place_path flow_path;
    ownership_api.entity_id source;
    types.node* ty;
    i64 offset;
    i64 bytes;
    bool indirect;
    bool caller;
    bool proved;
}

fn select_storage(body_input* in, body_program mut* out, fir.place input_place)
    selected_storage {
    selected_storage mut selected = selected_storage{};
    if (input_place.base != fir.base_kind.bk_local ||
        cast(input_place.local, u64) >= out->origins.len || input_place.proj_len > 16) {
        reject(out, ownership_api.incomplete_reason.missing_path);
        return selected;
    }
    selected.path = slot(in, input_place.local);
    selected.source = source(in, input_place.local);
    types.node* mut ty = fir.local_at(in->function.body, input_place.local)->ty;
    ownership_api.projection[16] mut parts = {};
    u64 mut count = 0;
    u32 mut i = 0;
    while (i < input_place.proj_len) {
        if (!work(out, 1)) { return selected; }
        fir.projection part = fir.place_projection(in->function.body, input_place, i);
        if (part.kind == fir.proj_kind.pj_deref && i == 0 && reference(ty) &&
            ty->kind == types.type_kind.k_ptr && ty->elem != null) {
            selected.indirect = true;
            selected.source = out->origins[input_place.local];
            u64 mut r = 0;
            while (r < out->roots_len) {
                if (!work(out, 1)) { return selected; }
                ownership_summary_model.symbolic_root root_at = out->roots[r];
                if (root_at.kind == ownership_summary_model.root_kind.caller_source &&
                    ownership_summary_model.same(root_at.source, selected.source)) {
                    selected.path.root = root_at.slot;
                    selected.caller = true;
                    bool mut captured = false;
                    u64 mut e = out->effects_len;
                    while (e > 0) {
                        if (!work(out, 1)) { return selected; }
                        e -= 1;
                        ownership_summary_model.effect_node node = out->effects[e];
                        if (ownership_summary_model.same(node.effect.place.root,
                            slot(in, input_place.local).root)) {
                            if (node.payload == ownership_summary_model.payload_kind.replacement &&
                                node.value.borrows.len == 1 && ownership_summary_model.same(
                                    node.operand.root, root_at.slot)) {
                                u64 n = node.operand.projections.len;
                                if (n > 16 || node.value.borrows[0].range.offset.kind !=
                                    ownership_api.fact_kind.exact ||
                                    node.value.borrows[0].range.offset.value < 0) {
                                    reject(out, ownership_api.incomplete_reason.missing_path);
                                    return selected;
                                }
                                if (!work(out, n)) { return selected; }
                                u64 mut p = 0;
                                while (p < n) { parts[p] = node.operand.projections[p]; p += 1; }
                                count = n;
                                selected.offset = node.value.borrows[0].range.offset.value;
                                captured = true;
                            }
                            break;
                        }
                    }
                    if (!captured && root_at.ty->elem != ty->elem) {
                        reject(out, ownership_api.incomplete_reason.unknown_effect);
                        return selected;
                    }
                }
                r += 1;
            }
            ty = ty->elem;
        } else if (part.kind == fir.proj_kind.pj_deref && i > 0 && ty != null &&
            ty->kind == types.type_kind.k_ptr && ty->elem != null && selected.caller) {
            selected.path.projections = parts[..count];
            selected.path = load_reference(in, out, selected.path, selected.source, ty,
                selected.offset);
            if (!ownership_api.successful(out->proof)) { return selected; }
            selected.source = out->roots[out->roots_len - 1].source;
            selected.offset = 0;
            count = 0;
            ty = ty->elem;
        } else if (part.kind == fir.proj_kind.pj_field && ty != null &&
            ty->kind == types.type_kind.k_struct && ty->decl != null && ty->layout != null &&
            ty->layout->state == types.layout_state.l_resolved) {
            ast.sym* declaration = cast(ty->decl, ast.sym*);
            if (declaration->node == null) { break; }
            ast.node* mut field = null;
            u64 mut j = 0;
            u32 mut number = 0;
            while (j < ast.ast_len(declaration->node)) {
                if (!work(out, 1)) { return selected; }
                ast.node* member = ast.ast_child(declaration->node, j);
                if (member->kind == ast.ast_kind.k_field_decl) {
                    if (number == part.field) { field = member; break; }
                    number += 1;
                }
                j += 1;
            }
            if (field == null || field->aux > 9223372036854775807 ||
                selected.offset > 9223372036854775807 - cast(field->aux, i64)) { break; }
            selected.offset += cast(field->aux, i64);
            if (count >= 16) { break; }
            parts[count] = ownership_api.projection{.kind = ownership_api.projection_kind.field,
                .field = part.field};
            count += 1;
            ty = field->ty;
        } else if (part.kind == fir.proj_kind.pj_index && ty != null &&
            ty->kind == types.type_kind.k_array && ty->elem != null &&
            cast(part.index, u64) < out->scalars.len && types.type_size_fits(ty->elem)) {
            ownership_api.scalar_fact index = out->scalars[part.index];
            u64 stride = types.type_sizeof(ty->elem);
            if (index.kind != ownership_api.fact_kind.exact || index.value < 0 || stride == 0 ||
                cast(index.value, u64) >= ty->len ||
                cast(index.value, u64) > 9223372036854775807 / stride) { break; }
            i64 bytes = cast(cast(index.value, u64) * stride, i64);
            if (selected.offset > 9223372036854775807 - bytes) { break; }
            selected.offset += bytes;
            if (count >= 16) { break; }
            parts[count] = ownership_api.projection{
                .kind = ownership_api.projection_kind.fixed_index, .index = index};
            count += 1;
            ty = ty->elem;
        } else { break; }
        i += 1;
    }
    if (i != input_place.proj_len || ty == null || !types.type_size_fits(ty) ||
        types.type_sizeof(ty) > 9223372036854775807 ||
        selected.offset > 9223372036854775807 - cast(types.type_sizeof(ty), i64)) {
        reject(out, ownership_api.incomplete_reason.missing_path);
        return selected;
    }
    selected.path.projections = parts[..count];
    if (!ownership_summary_model.path_charge(&out->context, &out->proof, selected.path)) {
        return selected;
    }
    selected.path = ownership_state.copy_place(&out->metadata, selected.path);
    selected.ty = ty;
    selected.bytes = cast(types.type_sizeof(ty), i64);
    selected.proved = true;
    return selected;
}

fn output_ready(body_input* in, body_program mut* out, selected_storage mut* selected,
    bool release_old) bool {
    if (!selected->proved || !selected->caller || !selected->indirect ||
        !reference(selected->ty) || !selected->ty->is_own || selected->ty->elem == null ||
        (!release_old && (fir.type_owning(selected->ty->elem) ||
            fir.type_aggregate(selected->ty->elem)))) {
        reject(out, ownership_api.incomplete_reason.unknown_effect);
        return false;
    }
    requirement(in, out, selected->source, selected->path, selected->offset + selected->bytes,
        ownership_summary_model.requirement_kind.extent, types.type_alignof(selected->ty));
    selected->flow_path = selected->path;
    if (selected->path.projections.len != 0) {
        bool mut found = false;
        u64 mut e = 0;
        while (e < out->effects_len) {
            if (!work(out, 1) || !work(out, selected->path.projections.len) ||
                !work(out, out->effects[e].effect.place.projections.len)) { return false; }
            if (ownership_state.same_place(selected->path, out->effects[e].effect.place) &&
                (out->effects[e].payload == ownership_summary_model.payload_kind.move ||
                    out->effects[e].payload == ownership_summary_model.payload_kind.release ||
                    out->effects[e].value.owner_empty)) {
                selected->flow_path = out->steps[e].local.destination;
                found = true;
                break;
            }
            e += 1;
        }
        if (!found) { selected->flow_path = ownership_api.place_path{
            .root = next(out, ownership_api.entity_kind.slot)}; }
    }
    if (!work(out, out->entry.contents_len)) { return false; }
    u64 old = ownership_transfer.contents_index(&out->entry, selected->flow_path);
    if (old == ownership_api.U64_MAX) {
        requirement(in, out, selected->source, selected->path, 0,
            release_old ? ownership_summary_model.requirement_kind.valid_owner :
                ownership_summary_model.requirement_kind.empty_output, 1);
        ownership_state.append_contents(&out->entry, empty(selected->flow_path, true));
    }
    return ownership_api.successful(out->proof);
}

// A borrowed reference store into caller storage retains its source (D17.14). The caller
// storage keeps the source after this body returns, so the summary exports the store as one
// copy from the stored local. Flow copies into a private slot, which checks the stored value.
// A null store clears the field. Any other stored value stays unsupported.
fn retain(body_input* in, body_program mut* out, fir.statement* stmt, u32 block, u32 gap,
    selected_storage* selected) void {
    fir.func* f = in->function.body;
    if (stmt->value.kind != fir.rvalue_kind.rv_use || stmt->value.ops_len != 1) {
        reject(out, ownership_api.incomplete_reason.unknown_effect);
        return;
    }
    requirement(in, out, selected->source, selected->path, selected->offset + selected->bytes,
        ownership_summary_model.requirement_kind.extent, types.type_alignof(selected->ty));
    fir.operand input_operand = fir.rvalue_operand(f, stmt->value, 0);
    ownership_api.place_path private = ownership_api.place_path{
        .root = next(out, ownership_api.entity_kind.slot)};
    ownership_transfer.request mut req = ownership_transfer.request{
        .kind = ownership_transfer.action.assignment, .source = selected->path,
        .destination = selected->path, .source_key = selected->source,
        .value = empty(selected->path, false)};
    ownership_summary_model.payload_kind mut payload =
        ownership_summary_model.payload_kind.replacement;
    if (input_operand.kind == fir.operand_kind.ok_copy && direct(input_operand.place) &&
        reference(fir.local_at(f, input_operand.place.local)->ty)) {
        u32 src = input_operand.place.local;
        requirement(in, out, out->origins[src], slot(in, src), 0,
            ownership_summary_model.requirement_kind.live_source, 1);
        req.kind = ownership_transfer.action.copy;
        req.source = slot(in, src);
        req.source_key = out->origins[src];
        payload = ownership_summary_model.payload_kind.copy;
    } else if (input_operand.kind != fir.operand_kind.ok_const ||
        (input_operand.value.kind != fir.const_kind.ck_zero &&
            input_operand.value.kind != fir.const_kind.ck_null)) {
        reject(out, ownership_api.incomplete_reason.unknown_effect);
        return;
    }
    if (!ownership_api.successful(out->proof)) { return; }
    emit(in, out, req, block, gap, 1, payload, stmt->loc, stmt->exit_loc, stmt->stmt, private);
}

fn assign_output(body_input* in, body_program mut* out, fir.statement* stmt,
    u32 block, u32 gap) void {
    selected_storage mut selected = select_storage(in, out, stmt->place);
    if (selected.proved && selected.indirect && !reference(selected.ty) &&
        !fir.type_aggregate(selected.ty)) {
        if (selected.caller) {
            requirement(in, out, selected.source, selected.path, selected.offset + selected.bytes,
                ownership_summary_model.requirement_kind.extent, types.type_alignof(selected.ty));
        } else if (!local_read(in, out, selected.source, selected.offset + selected.bytes,
            types.type_alignof(selected.ty), stmt->loc)) { return; }
        ownership_transfer.request req = ownership_transfer.request{
            .kind = ownership_transfer.action.inspect, .source = slot(in, stmt->place.local),
            .destination = slot(in, stmt->place.local), .source_key = selected.source};
        emit(in, out, req, block, gap, 0, ownership_summary_model.payload_kind.read,
            stmt->loc, stmt->exit_loc, stmt->stmt, req.destination);
        return;
    }
    if (selected.proved && selected.indirect && selected.caller && reference(selected.ty) &&
        !selected.ty->is_own) {
        retain(in, out, stmt, block, gap, &selected);
        return;
    }
    if (!output_ready(in, out, &selected, false)) { return; }
    if (stmt->value.kind != fir.rvalue_kind.rv_use || stmt->value.ops_len != 1) {
        reject(out, ownership_api.incomplete_reason.unknown_effect);
        return;
    }
    fir.operand input_operand = fir.rvalue_operand(in->function.body, stmt->value, 0);
    ownership_transfer.request mut req = ownership_transfer.request{
        .kind = ownership_transfer.action.assignment, .source = selected.path,
        .destination = selected.path, .source_key = selected.source,
        .destination_owns = true, .value = empty(selected.path, true)};
    ownership_summary_model.payload_kind mut payload =
        ownership_summary_model.payload_kind.replacement;
    if (input_operand.kind == fir.operand_kind.ok_move && direct(input_operand.place)) {
        req.kind = ownership_transfer.action.move_owner;
        req.source = slot(in, input_operand.place.local);
        req.source_key = out->origins[input_operand.place.local];
        payload = ownership_summary_model.payload_kind.move;
    } else if (input_operand.kind == fir.operand_kind.ok_move) {
        selected_storage mut from = select_storage(in, out, input_operand.place);
        if (!output_ready(in, out, &from, true)) { return; }
        req.kind = ownership_transfer.action.move_owner;
        req.source = from.path;
        req.source_key = from.source;
        req.value.place = from.flow_path;
        payload = ownership_summary_model.payload_kind.move;
    } else if (input_operand.kind != fir.operand_kind.ok_const ||
        (input_operand.value.kind != fir.const_kind.ck_zero &&
            input_operand.value.kind != fir.const_kind.ck_null)) {
        reject(out, ownership_api.incomplete_reason.unknown_effect);
        return;
    }
    emit(in, out, req, block, gap, 1, payload, stmt->loc, stmt->exit_loc, stmt->stmt,
        selected.flow_path);
}

// The supplied binding of a direct callee. A missing binding has no summary.
fn binding(body_input* in, body_program mut* out, ast.sym* symbol) callee_binding {
    callee_binding mut found = callee_binding{.symbol = symbol};
    if (symbol == null) { return found; }
    u64 mut i = 0;
    while (i < in->callees.len) {
        if (!work(out, 1)) { return found; }
        if (in->callees[i].symbol == symbol) { return in->callees[i]; }
        i += 1;
    }
    return found;
}

// The target record of the call at `block` and `gap`, or null. The records increase by block
// and gap, so a binary search finds one in O(log n) W units.
fn record_at(body_input* in, body_program mut* out, u32 block, u32 gap) call_targets* {
    u64 mut low = 0;
    u64 mut high = in->targets.len;
    while (low < high) {
        if (!work(out, 1)) { return null; }
        u64 middle = low + (high - low) / 2;
        call_targets* row = &in->targets[middle];
        if (row->block == block && row->gap == gap) { return row; }
        if (row->block < block || (row->block == block && row->gap < gap)) {
            low = middle + 1;
        } else { high = middle; }
    }
    return null;
}

// The number of fort targets that extraction keeps for one call statement.
fn target_count(body_input* in, body_program mut* out, fir.statement* stmt, u32 block,
    u32 gap) u64 {
    if (stmt->kind != fir.stmt_kind.st_assign || stmt->value.kind != fir.rvalue_kind.rv_call) {
        return 0;
    }
    call_targets* record = record_at(in, out, block, gap);
    if (record != null) { return record->fort.len; }
    return stmt->value.callee == fir.callee_kind.cl_fn ? 1 : 0;
}

fn requirement_capacity(ownership_summary_model.summary_view* summary) u64 {
    if (summary == null) { return 0; }
    if (summary->requirements.len > (U64_MAX - 2) / 2) { return U64_MAX; }
    return summary->requirements.len * 2 + 2;
}

// Each callee requirement can add one requirement and one read. The result adds one write.
// Each fort target of the call can add its own.
fn call_capacity(body_input* in, body_program mut* out, fir.statement* stmt, u32 block,
    u32 gap) u64 {
    if (stmt->kind != fir.stmt_kind.st_assign || stmt->value.kind != fir.rvalue_kind.rv_call) {
        return 0;
    }
    call_targets* record = record_at(in, out, block, gap);
    if (record == null) {
        if (stmt->value.callee != fir.callee_kind.cl_fn) { return 0; }
        return requirement_capacity(binding(in, out, stmt->value.callee_sym).summary);
    }
    u64 mut total = 0;
    u64 mut i = 0;
    while (i < record->fort.len) {
        u64 one = requirement_capacity(record->fort[i].summary);
        if (one > U64_MAX - total) { return U64_MAX; }
        total += one;
        i += 1;
    }
    return total;
}

// The callee result designates the source of one argument in each normal case of each
// target. Any other result keeps an unknown origin, so a later read cannot export a
// requirement.
fn call_origin(body_input* in, body_program mut* out, fir.rvalue rv, call_target@ targets)
    ownership_api.entity_id {
    ownership_api.entity_id mut found = ownership_api.entity_id{};
    u64 mut t = 0;
    while (t < targets.len) {
        ownership_summary_model.summary_view* summary = targets[t].binding.summary;
        if (summary == null) { return ownership_api.entity_id{}; }
        u64 mut c = 0;
        while (c < summary->cases.len) {
            ownership_summary_model.case_record row = summary->cases[c];
            u64 mut k = 0;
            while (row.outcome.kind == ownership_api.outcome_kind.function_return &&
                k < row.results.len) {
                u64 mut r = 0;
                while (r < summary->results.len) {
                    if (!work(out, 1)) { return ownership_api.entity_id{}; }
                    ownership_summary_model.relation result = summary->results[r];
                    if (ownership_summary_model.same(result.key, row.results[k])) {
                        ownership_api.entity_id origin = argument_origin(in, out, rv, summary,
                            result.borrow.source);
                        if (origin.kind == ownership_api.entity_kind.none ||
                            (found.kind != ownership_api.entity_kind.none &&
                                !ownership_summary_model.same(found, origin))) {
                            return ownership_api.entity_id{};
                        }
                        found = origin;
                    }
                    r += 1;
                }
                k += 1;
            }
            c += 1;
        }
        t += 1;
    }
    return found;
}

fn argument_origin(body_input* in, body_program mut* out, fir.rvalue rv,
    ownership_summary_model.summary_view* summary, ownership_api.entity_id formal_source)
    ownership_api.entity_id {
    u64 mut i = 0;
    while (i < summary->roots.len) {
        if (!work(out, 1)) { return ownership_api.entity_id{}; }
        ownership_summary_model.symbolic_root root = summary->roots[i];
        if (root.kind == ownership_summary_model.root_kind.caller_source && root.formal > 0 &&
            root.formal <= rv.ops_len &&
            ownership_summary_model.same(root.source, formal_source)) {
            fir.operand argument = fir.rvalue_operand(in->function.body, rv, root.formal - 1);
            if (argument.kind == fir.operand_kind.ok_const || !direct(argument.place)) {
                return ownership_api.entity_id{};
            }
            return out->origins[argument.place.local];
        }
        i += 1;
    }
    return ownership_api.entity_id{};
}

// The type of field `number` of a resolved struct, or null.
fn field_type(types.node* ty, u32 number) types.node* {
    if (ty == null || ty->kind != types.type_kind.k_struct || ty->decl == null ||
        ty->layout == null || ty->layout->state != types.layout_state.l_resolved) {
        return null;
    }
    ast.sym* declaration = cast(ty->decl, ast.sym*);
    if (declaration->node == null) { return null; }
    u64 mut j = 0;
    u32 mut seen = 0;
    while (j < ast.ast_len(declaration->node)) {
        ast.node* member = ast.ast_child(declaration->node, j);
        if (member->kind == ast.ast_kind.k_field_decl) {
            if (seen == number) { return member->ty; }
            seen += 1;
        }
        j += 1;
    }
    return null;
}

// A struct whose fields are scalars or references. Nested aggregates stay unsupported.
fn flat_struct(types.node* ty, u32 fields) bool {
    u32 mut i = 0;
    while (i < fields) {
        types.node* field = field_type(ty, i);
        if (field == null || (fir.type_aggregate(field) && !reference(field))) { return false; }
        i += 1;
    }
    return field_type(ty, fields) == null;
}

fn field_count(types.node* ty) u32 {
    u32 mut n = 0;
    while (n < 64 && field_type(ty, n) != null) { n += 1; }
    return n;
}

fn leaf(body_input* in, body_program mut* out, u32 local, u32 number)
    ownership_api.place_path {
    ownership_api.projection[1] part = {ownership_api.projection{
        .kind = ownership_api.projection_kind.field, .field = number}};
    ownership_api.place_path path = ownership_api.place_path{.root = slot(in, local).root,
        .projections = part[..]};
    if (!ownership_summary_model.path_charge(&out->context, &out->proof, path)) {
        return ownership_api.place_path{.residual = true};
    }
    return ownership_state.copy_place(&out->metadata, path);
}

// The result slot leaf must hold no live owner when a literal writes it (D17.15). Each caller
// checks it after the operand effects of that write.
fn result_requirement(body_input* in, body_program mut* out, ownership_api.place_path path)
    void {
    if (!work(out, 1) || out->requirements_len >= out->requirements.len ||
        !ownership_summary_model.effect_charge(&out->context, &out->proof, &out->relations)) {
        reject(out, ownership_api.incomplete_reason.invalid_input);
        return;
    }
    ownership_api.entity_id key = next(out, ownership_api.entity_kind.relation);
    if (!ownership_api.successful(out->proof)) { return; }
    out->requirements[out->requirements_len] = ownership_summary_model.requirement{
        .key = key, .kind = ownership_summary_model.requirement_kind.empty_output,
        .path = path, .operation = out->context.operation};
    out->requirements_len += 1;
}

// An aggregate value of a flat struct (D17.15). A literal writes each leaf: an owner moves, a
// borrow copies, and a scalar or a constant adds no effect. A whole move from caller storage
// or from a holding local moves every leaf. Flow models the owner and borrow leaves of a
// literal in private slots. The summary keeps each leaf effect, and each caller replays it
// with the aggregate place service, so the caller checks the real destination leaves.
// A holding local must reach the result; any other aggregate use stays unsupported.
fn aggregate_value(body_input* in, body_program mut* out, fir.statement* stmt, u32 block,
    u32 gap) void {
    fir.func* f = in->function.body;
    fir.rvalue rv = stmt->value;
    u32 dst = stmt->place.local;
    types.node* ty = fir.local_at(f, dst)->ty;
    u32 fields = field_count(ty);
    if (fields == 0 || !flat_struct(ty, fields) ||
        (dst != 0 && fir.local_at(f, dst)->kind == fir.local_kind.lk_param)) {
        reject(out, ownership_api.incomplete_reason.unknown_effect);
        return;
    }
    ownership_api.source_position where = location(in, out, stmt->loc);
    if (rv.kind == fir.rvalue_kind.rv_aggregate && rv.ops_len == fields) {
        u32 mut i = 0;
        while (i < fields) {
            if (!work(out, 2)) { return; }
            types.node* field = field_type(ty, i);
            fir.operand input_operand = fir.rvalue_operand(f, rv, i);
            ownership_api.place_path destination = leaf(in, out, dst, i);
            if (dst == 0 && fir.type_owning(field)) { result_requirement(in, out, destination); }
            if (input_operand.kind == fir.operand_kind.ok_const ||
                (!reference(field) && direct(input_operand.place))) {
                i += 1;
                continue;
            }
            if (!direct(input_operand.place) ||
                !reference(fir.local_at(f, input_operand.place.local)->ty)) {
                reject(out, ownership_api.incomplete_reason.unknown_effect);
                return;
            }
            u32 src = input_operand.place.local;
            ownership_transfer.request mut req = ownership_transfer.request{
                .kind = ownership_transfer.action.copy, .source = slot(in, src),
                .destination = destination, .source_key = out->origins[src]};
            ownership_summary_model.payload_kind mut payload =
                ownership_summary_model.payload_kind.copy;
            if (input_operand.kind == fir.operand_kind.ok_move && field->is_own) {
                req.kind = ownership_transfer.action.move_owner;
                req.destination_owns = true;
                payload = ownership_summary_model.payload_kind.move;
            } else if (input_operand.kind != fir.operand_kind.ok_copy || field->is_own) {
                reject(out, ownership_api.incomplete_reason.unknown_effect);
                return;
            } else {
                requirement(in, out, out->origins[src], slot(in, src), 0,
                    ownership_summary_model.requirement_kind.live_source, 1);
            }
            emit(in, out, req, block, gap, i + 1, payload, stmt->loc, stmt->exit_loc,
                stmt->stmt, ownership_api.place_path{.root = next(out,
                    ownership_api.entity_kind.slot)});
            if (!ownership_api.successful(out->proof)) { return; }
            i += 1;
        }
    } else if (rv.kind == fir.rvalue_kind.rv_use) {
        fir.operand input_operand = fir.rvalue_operand(f, rv, 0);
        ownership_summary_model.effect_node mut node = ownership_summary_model.effect_node{
            .effect = ownership_api.ordered_effect{.kind = ownership_api.effect_kind.transfer,
                .operation = position(in, block, gap, false), .place = slot(in, dst)},
            .payload = ownership_summary_model.payload_kind.move};
        if (input_operand.kind == fir.operand_kind.ok_move && !direct(input_operand.place)) {
            selected_storage selected = select_storage(in, out, input_operand.place);
            if (!selected.proved || !selected.indirect || !selected.caller ||
                selected.ty != ty || selected.path.projections.len != 0) {
                reject(out, ownership_api.incomplete_reason.unknown_effect);
                return;
            }
            requirement(in, out, selected.source, selected.path, selected.offset + selected.bytes,
                ownership_summary_model.requirement_kind.extent, types.type_alignof(ty));
            node.operand = selected.path;
            node.effect.source = selected.source;
        } else if (input_operand.kind != fir.operand_kind.ok_const &&
            direct(input_operand.place) &&
            fir.local_at(f, input_operand.place.local)->ty == ty &&
            out->holding[input_operand.place.local] == 1 && dst == 0) {
            node.operand = slot(in, input_operand.place.local);
            if (input_operand.kind == fir.operand_kind.ok_copy) {
                node.payload = ownership_summary_model.payload_kind.copy;
                node.effect.kind = ownership_api.effect_kind.write;
            }
            out->holding[input_operand.place.local] = 2;
        } else {
            reject(out, ownership_api.incomplete_reason.unknown_effect);
            return;
        }
        export_effect(in, out, node, where, stmt->loc.file);
    } else {
        reject(out, ownership_api.incomplete_reason.unknown_effect);
        return;
    }
    if (dst != 0 && ownership_api.successful(out->proof)) { out->holding[dst] = 1; }
}

// A call of fort targets becomes one flow step at its exact gap (D17.18). Flow applies the
// summaries of the targets to the current facts. A direct fort call without a published
// summary, such as a recursive call or a missing body, and a call with a residual fort target
// stay unresolved steps: flow keeps their continuation and obligations. A foreign alternative
// keeps the body unsupported with the reason `missing_ffi`, because extraction applies no
// foreign boundary (D17.13). Foreign trust never covers a residual fort target.
fn call(body_input* in, body_program mut* out, fir.statement* stmt, u32 block, u32 gap) void {
    fir.func* f = in->function.body;
    fir.rvalue rv = stmt->value;
    call_targets* record = record_at(in, out, block, gap);
    if (!ownership_api.successful(out->proof)) { return; }
    bool residual = record != null && record->residual_fort;
    if (!residual && (rv.callee == fir.callee_kind.cl_extern ||
        (record != null && record->foreign))) {
        reject(out, ownership_api.incomplete_reason.missing_ffi);
        return;
    }
    if ((rv.callee == fir.callee_kind.cl_value && record == null) || !direct(stmt->place)) {
        reject(out, ownership_api.incomplete_reason.unknown_effect);
        return;
    }
    u32 mut op = 0;
    while (op < rv.ops_len) {
        if (!work(out, 1)) { return; }
        fir.operand argument = fir.rvalue_operand(f, rv, op);
        if (argument.kind != fir.operand_kind.ok_const && !direct(argument.place)) {
            reject(out, ownership_api.incomplete_reason.unknown_effect);
            return;
        }
        op += 1;
    }
    u32 dst = stmt->place.local;
    types.node* dst_ty = fir.local_at(f, dst)->ty;
    if (fir.type_aggregate(dst_ty) && !reference(dst_ty)) {
        reject(out, ownership_api.incomplete_reason.unknown_effect);
        return;
    }
    u64 count = residual ? 0 : record != null ? record->fort.len : 1;
    if (out->calls_len >= out->calls.len || out->steps_len >= out->steps.len ||
        count > out->targets.len - out->targets_len) {
        reject(out, ownership_api.incomplete_reason.invalid_input);
        return;
    }
    ownership_api.entity_id event = next(out, ownership_api.entity_kind.event);
    u64 first_target = out->targets_len;
    u64 mut t = 0;
    while (t < count) {
        callee_binding target = record != null ? record->fort[t] :
            binding(in, out, rv.callee_sym);
        u32 mut templates = 0;
        u64 mut i = 0;
        while (target.summary != null && i < target.summary->roots.len) {
            if (!work(out, 1)) { return; }
            if (target.summary->roots[i].kind ==
                ownership_summary_model.root_kind.allocation_template) {
                if (templates == U32_MAX) {
                    reject(out, ownership_api.incomplete_reason.invalid_input);
                    return;
                }
                templates += 1;
            }
            i += 1;
        }
        u32 first = out->next_key + 1;
        u32 mut k = 0;
        while (k < templates) {
            next(out, ownership_api.entity_kind.allocation);
            k += 1;
        }
        if (!ownership_api.successful(out->proof)) { return; }
        out->targets[out->targets_len] = call_target{target, first, templates};
        out->targets_len += 1;
        t += 1;
    }
    if (cast(rv.ops_len, u64) > out->call_args.len - out->call_args_len) {
        reject(out, ownership_api.incomplete_reason.invalid_input);
        return;
    }
    u64 args_first = out->call_args_len;
    op = 0;
    while (op < rv.ops_len) {
        // An exact argument gets a fresh value key of this call, so a capture can name it.
        ownership_api.scalar_fact mut argument = constant(in, out, fir.rvalue_operand(f, rv, op));
        if (argument.kind == ownership_api.fact_kind.exact) {
            argument.symbol = next(out, ownership_api.entity_kind.value);
        }
        out->call_args[out->call_args_len] = argument;
        out->call_args_len += 1;
        op += 1;
    }
    out->calls[out->calls_len] = call_site{block, gap, event, first_target, count, residual,
        args_first, rv.ops_len};
    out->calls_len += 1;
    ownership_api.operation_position at = position(in, block, gap, false);
    // Flow reports a refused charge or a missing handler at the call with these keys.
    u32 mut kind = 0;
    while (kind < 5) {
        if (!work(out, 1) || out->events_len >= out->events.len) {
            reject(out, ownership_api.incomplete_reason.invalid_input);
            return;
        }
        out->events[out->events_len] = ownership_flow.event_binding{at,
            cast(kind, ownership_api.event_kind), ownership_api.entity_id{},
            next(out, ownership_api.entity_kind.event)};
        out->events_len += 1;
        kind += 1;
    }
    out->steps[out->steps_len] = ownership_flow.step{.block = block, .gap = gap,
        .order = cast(out->steps_len, u32), .kind = ownership_flow.step_kind.direct_call,
        .operation = at, .source = location(in, out, stmt->loc)};
    out->steps_len += 1;
    out->scalars[dst] = ownership_api.scalar_fact{};
    out->origins[dst] = reference(dst_ty) && count > 0 ?
        call_origin(in, out, rv, out->targets[first_target..first_target + count]) :
        ownership_api.entity_id{};
}

fn assign(body_input* in, body_program mut* out, fir.statement* stmt, u32 block, u32 gap)
    void {
    fir.func* f = in->function.body;
    fir.rvalue rv = stmt->value;
    if (rv.kind == fir.rvalue_kind.rv_call) {
        call(in, out, stmt, block, gap);
        return;
    }
    if (direct(stmt->place) && fir.type_aggregate(fir.local_at(f, stmt->place.local)->ty) &&
        !reference(fir.local_at(f, stmt->place.local)->ty)) {
        aggregate_value(in, out, stmt, block, gap);
        return;
    }
    if (rv.kind == fir.rvalue_kind.rv_addr && intrinsic(in, out, rv.place, stmt->place,
        stmt->loc)) { return; }
    if (rv.kind == fir.rvalue_kind.rv_use) {
        fir.operand input_operand = fir.rvalue_operand(f, rv, 0);
        if (input_operand.kind != fir.operand_kind.ok_const && direct(input_operand.place)) {
            u32 mut parameter = 1;
            while (parameter < fir.local_count(f)) {
                if (!work(out, 1)) { return; }
                if (fir.local_at(f, parameter)->kind == fir.local_kind.lk_param &&
                    ownership_summary_model.same(out->origins[input_operand.place.local],
                        source(in, parameter)) && intrinsic(in, out,
                    fir.place_local(parameter), stmt->place, stmt->loc)) { return; }
                parameter += 1;
            }
        }
    }
    if (!direct(stmt->place)) {
        assign_output(in, out, stmt, block, gap);
        return;
    }
    u32 dst = stmt->place.local;
    types.node* dst_ty = fir.local_at(f, dst)->ty;
    ownership_transfer.request mut req = basic(in, dst, dst, ownership_transfer.action.assignment);
    req.value = empty(slot(in, dst), dst_ty->is_own);
    ownership_summary_model.payload_kind mut payload =
        ownership_summary_model.payload_kind.replacement;
    if (rv.kind == fir.rvalue_kind.rv_use || rv.kind == fir.rvalue_kind.rv_cast) {
        fir.operand input_operand = fir.rvalue_operand(f, rv, 0);
        out->scalars[dst] = out->addressed[dst] ? ownership_api.scalar_fact{} :
            constant(in, out, input_operand);
        if (rv.kind == fir.rvalue_kind.rv_cast) {
            out->scalars[dst] = cast_value(dst_ty, fir.operand_type(f, input_operand),
                out->scalars[dst]);
        }
        if (input_operand.kind != fir.operand_kind.ok_const && direct(input_operand.place)) {
            u32 src = input_operand.place.local;
            req = basic(in, src, dst, input_operand.kind == fir.operand_kind.ok_move ?
                ownership_transfer.action.move_owner : ownership_transfer.action.copy);
            payload = input_operand.kind == fir.operand_kind.ok_move ?
                ownership_summary_model.payload_kind.move
                    : ownership_summary_model.payload_kind.copy;
            out->origins[dst] = out->origins[src];
            if (reference(dst_ty)) {
                requirement(in, out, out->origins[src], slot(in, src), 0,
                    ownership_summary_model.requirement_kind.live_source, 1);
            }
            if (rv.kind == fir.rvalue_kind.rv_cast &&
                (!types.type_cast_allowed(dst_ty, fir.operand_type(f, input_operand)) ||
                types.type_cast_adds_own(dst_ty, fir.operand_type(f, input_operand)) ||
                reference(dst_ty) != reference(fir.operand_type(f, input_operand)))) {
                reject(out, ownership_api.incomplete_reason.unknown_effect);
                return;
            }
        } else if (input_operand.kind != fir.operand_kind.ok_const) {
            out->origins[dst] = ownership_api.entity_id{};
            types.node* base = input_operand.place.base == fir.base_kind.bk_local ?
                fir.local_at(f, input_operand.place.local)->ty : null;
            bool header = base != null && (base->kind == types.type_kind.k_span ||
                base->kind == types.type_kind.k_string) && input_operand.place.proj_len == 1 &&
                fir.place_projection(f, input_operand.place, 0).kind == fir.proj_kind.pj_field;
            if (header && fir.place_projection(f, input_operand.place, 0).field == 0) {
                req = basic(in, input_operand.place.local, dst, ownership_transfer.action.copy);
                payload = ownership_summary_model.payload_kind.copy;
                out->origins[dst] = out->origins[input_operand.place.local];
            } else if (!header) {
                if (reference(dst_ty) && dst_ty->is_own &&
                    input_operand.kind == fir.operand_kind.ok_move) {
                    selected_storage mut from = select_storage(in, out, input_operand.place);
                    if (!output_ready(in, out, &from, true)) { return; }
                    load_reference(in, out, from.path, from.source, from.ty, from.offset);
                    if (!ownership_api.successful(out->proof)) { return; }
                    req.kind = ownership_transfer.action.move_owner;
                    req.source = from.path;
                    req.source_key = out->roots[out->roots_len - 1].source;
                    req.value.place = from.flow_path;
                    out->origins[dst] = req.source_key;
                    payload = ownership_summary_model.payload_kind.move;
                } else if (reference(dst_ty)) {
                    selected_storage selected = select_storage(in, out, input_operand.place);
                    // A load from storage of this body, such as a by-value aggregate, has no
                    // modeled source, so it stays unsupported.
                    if (!selected.proved || !selected.caller) {
                        reject(out, ownership_api.incomplete_reason.unknown_effect);
                        return;
                    }
                    ownership_api.place_path loaded = load_reference(in, out, selected.path,
                        selected.source, selected.ty, selected.offset);
                    if (!ownership_api.successful(out->proof)) { return; }
                    req.kind = ownership_transfer.action.copy;
                    req.source = loaded;
                    req.source_key = out->roots[out->roots_len - 1].source;
                    out->origins[dst] = req.source_key;
                    payload = ownership_summary_model.payload_kind.copy;
                } else if (!add_read(in, out, input_operand.place, block, gap, 0, stmt->loc,
                    stmt->exit_loc, stmt->stmt)) { return; }
                if (fir.type_aggregate(dst_ty) && !reference(dst_ty)) {
                    reject(out, ownership_api.incomplete_reason.unknown_effect);
                    return;
                }
            }
        } else if (reference(dst_ty)) {
            out->origins[dst] = ownership_api.entity_id{};
            if (input_operand.value.kind != fir.const_kind.ck_null &&
                input_operand.value.kind != fir.const_kind.ck_zero) {
                reject(out, ownership_api.incomplete_reason.unknown_effect);
                return;
            }
            req.value.kind = ownership_api.contents_kind.empty_owner;
            req.value.owner_empty = true;
        } else {
            out->origins[dst] = ownership_api.entity_id{};
        }
    } else if (rv.kind == fir.rvalue_kind.rv_alloc) {
        ownership_api.scalar_fact length = constant(in, out, fir.rvalue_operand(f, rv, 0));
        if (rv.ty == null || !types.type_size_fits(rv.ty) || fir.type_owning(rv.ty)) {
            reject(out, ownership_api.incomplete_reason.unknown_effect);
            return;
        }
        u64 size = types.type_sizeof(rv.ty);
        if (length.kind != ownership_api.fact_kind.exact || length.value < 0 || size == 0 ||
            cast(length.value, u64) > 9223372036854775807 / size) {
            reject(out, ownership_api.incomplete_reason.missing_correspondence);
            return;
        }
        req.kind = ownership_transfer.action.allocation;
        req.allocation = ownership_api.allocation_fact{
            .key = next(out, ownership_api.entity_kind.allocation),
            .validity = ownership_api.validity_kind.live,
            .count = ownership_api.multiplicity{false, true, false}, .obligation = true,
            .owner = ownership_api.owner_location{.place = slot(in, dst)},
                .logical_length = length};
        req.allocation.site = req.allocation.key;
        req.fresh_source = ownership_api.source_fact{
            .key = id(in->function.key, ownership_api.entity_kind.source,
                req.allocation.key.ordinal),
            .kind = ownership_api.source_kind.heap, .validity = ownership_api.validity_kind.live,
            .allocation = req.allocation.key};
        req.source_key = req.fresh_source.key;
        req.value = value(in, out, slot(in, dst), req.fresh_source.key,
            req.allocation.key.ordinal, length.value, size, types.type_alignof(rv.ty));
        out->origins[dst] = req.source_key;
        root(out, ownership_summary_model.symbolic_root{
            .key = next(out, ownership_api.entity_kind.template),
            .kind = ownership_summary_model.root_kind.allocation_template,
            .allocation = req.allocation.key, .ty = dst_ty});
        payload = ownership_summary_model.payload_kind.allocation;
    } else if (rv.kind == fir.rvalue_kind.rv_aggregate &&
        dst_ty->kind == types.type_kind.k_span && rv.ops_len == 2) {
        fir.operand pointer = fir.rvalue_operand(f, rv, 0);
        ownership_api.scalar_fact length = constant(in, out, fir.rvalue_operand(f, rv, 1));
        if (pointer.kind != fir.operand_kind.ok_move || !direct(pointer.place) ||
            length.kind != ownership_api.fact_kind.exact || length.value < 0) {
            reject(out, ownership_api.incomplete_reason.unknown_effect);
            return;
        }
        bool mut matched = false;
        u64 mut effect = 0;
        while (effect < out->effects_len) {
            if (!work(out, 1)) { return; }
            ownership_summary_model.effect_node allocation = out->effects[effect];
            if (allocation.payload == ownership_summary_model.payload_kind.allocation &&
                ownership_summary_model.same(allocation.effect.place.root, slot(in,
                    pointer.place.local).root) &&
                allocation.value.span_length.kind == ownership_api.fact_kind.exact &&
                allocation.value.span_length.value == length.value) { matched = true; }
            effect += 1;
        }
        if (!matched) { reject(out, ownership_api.incomplete_reason.unknown_effect); return; }
        req = basic(in, pointer.place.local, dst, ownership_transfer.action.move_owner);
        payload = ownership_summary_model.payload_kind.move;
        out->origins[dst] = out->origins[pointer.place.local];
    } else if (rv.kind == fir.rvalue_kind.rv_addr) {
        if (!direct(rv.place)) {
            if (rv.place.base == fir.base_kind.bk_local &&
                fir.local_at(f, rv.place.local)->kind == fir.local_kind.lk_param &&
                !fir.place_indirect(f, rv.place)) {
                // Keep the escape origin private. This path supplies no range or address effect.
                out->origins[dst] = source(in, rv.place.local);
                out->held_inline_address = true;
                return;
            }
            selected_storage selected = select_storage(in, out, rv.place);
            if (!selected.proved || !selected.indirect) {
                reject(out, ownership_api.incomplete_reason.unknown_effect);
                return;
            }
            if (selected.caller) {
                requirement(in, out, selected.source, selected.path,
                    selected.offset + selected.bytes,
                    ownership_summary_model.requirement_kind.extent,
                    types.type_alignof(selected.ty));
            } else if (!local_read(in, out, selected.source, selected.offset + selected.bytes,
                types.type_alignof(selected.ty), stmt->loc)) { return; }
            req.source = selected.path;
            req.source_key = selected.source;
            req.value = value(in, out, slot(in, dst), selected.source,
                next(out, ownership_api.entity_kind.value).ordinal, 1,
                cast(selected.bytes, u64), types.type_alignof(selected.ty));
            if (!ownership_api.successful(out->proof) || req.value.borrows.len != 1) { return; }
            ownership_api.borrow_relation[1] mut relations = {req.value.borrows[0]};
            relations[0].range.key = next(out, ownership_api.entity_kind.region);
            relations[0].range.offset = integer(selected.offset);
            relations[0].range.access.begin = integer(selected.offset);
            relations[0].range.access.end = integer(selected.offset + selected.bytes);
            relations[0].range.extent = integer(selected.offset + selected.bytes);
            req.value.borrows = relations[..];
            // Copy the local view before the borrowed relation leaves this scope.
            if (!ownership_summary_model.contents_charge(&out->context, &out->proof,
                req.value)) { return; }
            req.value = ownership_state.copy_contents(&out->metadata, req.value);
            out->origins[dst] = selected.source;
        } else {
            req.kind = ownership_transfer.action.address;
            req.source = slot(in, rv.place.local);
            req.source_key = source(in, rv.place.local);
            req.source_correspondence_proved = true;
            types.node* ty = fir.place_type(f, rv.place);
            req.value = value(in, out, slot(in, dst), req.source_key,
                next(out, ownership_api.entity_kind.value).ordinal, 1, types.type_sizeof(ty),
                types.type_alignof(ty));
            out->origins[dst] = req.source_key;
        }
    } else if (fir.rvalue_is_binary(rv.kind) || rv.kind == fir.rvalue_kind.rv_not ||
        rv.kind == fir.rvalue_kind.rv_fneg) {
        if (reference(dst_ty) || fir.type_aggregate(dst_ty)) {
            reject(out, ownership_api.incomplete_reason.unknown_effect);
            return;
        }
        u32 mut i = 0;
        while (i < rv.ops_len) {
            fir.operand input_operand = fir.rvalue_operand(f, rv, i);
            if (input_operand.kind != fir.operand_kind.ok_const &&
                !add_read(in, out, input_operand.place, block, gap, i, stmt->loc, stmt->exit_loc,
                    stmt->stmt)) { return; }
            i += 1;
        }
        out->scalars[dst] = ownership_api.scalar_fact{};
        out->origins[dst] = ownership_api.entity_id{};
    } else {
        reject(out, ownership_api.incomplete_reason.unknown_effect);
        return;
    }
    if (fir.type_aggregate(dst_ty) && !reference(dst_ty)) {
        reject(out, ownership_api.incomplete_reason.unknown_effect);
        return;
    }
    emit(in, out, req, block, gap, rv.ops_len + 1, payload, stmt->loc, stmt->exit_loc,
        stmt->stmt, req.destination);
}

fn add_terminal_events(body_input* in, body_program mut* out, u32 block) bool {
    u32 locals = fir.local_count(in->function.body);
    u32 mut i = 0;
    while (i <= locals * 2 + 1) {
        u32 mut k = 0;
        while (k < 5) {
            if (!work(out, 2) || out->events_len >= out->events.len) {
                reject(out, ownership_api.incomplete_reason.invalid_input);
                return false;
            }
            ownership_api.entity_id mut relation = i == 0 ? ownership_api.entity_id{} :
                id(in->function.key, ownership_api.entity_kind.source, i);
            out->events[out->events_len] = ownership_flow.event_binding{
                position(in, block, fir.block_statement_count(in->function.body, block), true),
                cast(k, ownership_api.event_kind), relation, next(out,
                    ownership_api.entity_kind.event)};
            out->events_len += 1;
            if (i > 0) {
                if (out->events_len >= out->events.len) { return false; }
                relation.kind = ownership_api.entity_kind.allocation;
                out->events[out->events_len] = ownership_flow.event_binding{
                    position(in, block, fir.block_statement_count(in->function.body, block), true),
                    cast(k, ownership_api.event_kind), relation,
                    next(out, ownership_api.entity_kind.event)};
                out->events_len += 1;
            }
            k += 1;
        }
        i += 1;
    }
    return true;
}

// A switch of two edges on a bool value. Any other switch stays unsupported.
fn boolean_switch(body_program mut* out, fir.func* f, fir.terminator* term) bool {
    if (term->kind != fir.term_kind.tk_switch || term->arms_len != 1 || !work(out, 1)) {
        return false;
    }
    types.node* ty = fir.operand_type(f, term->cond);
    return ty != null && ty->kind == types.type_kind.k_prim &&
        ty->prim == prim.prim_kind.prim_bool;
}

// A holding aggregate that never reaches the result on a returning path would hide its
// owners from flow, so that body stays unsupported.
fn results_reached(body_program mut* out) bool {
    u64 mut i = 0;
    while (i < out->holding.len) {
        if (!work(out, 1)) { return false; }
        if (out->holding[i] == 1) {
            reject(out, ownership_api.incomplete_reason.unknown_effect);
            return false;
        }
        i += 1;
    }
    return true;
}

fn restore_entry(body_program mut* out, u32 block, u64 locals) bool {
    if (!work(out, locals * 2)) { return false; }
    u64 base = cast(block, u64) * locals;
    u64 mut i = 0;
    while (i < locals) {
        out->origins[i] = out->entry_origins[base + i];
        out->scalars[i] = out->entry_scalars[base + i];
        out->holding[i] = out->entry_holding[base + i];
        i += 1;
    }
    return true;
}

// Each target that flow can reach gets this block as its one parent. A back edge or a second
// parent makes a path that this extractor does not split, so the body stays unsupported.
// A switch on a captured formal value gives each edge the value that it selects.
fn follow_targets(body_input* in, body_program mut* out, u32 block, fir.terminator* term,
    u64 locals) bool {
    fir.func* f = in->function.body;
    ownership_api.scalar_fact tested = term->kind == fir.term_kind.tk_switch ?
        constant(in, out, term->cond) : ownership_api.scalar_fact{};
    i64 arm_value = term->kind == fir.term_kind.tk_switch &&
        consts.cv_eq(fir.term_arm(f, term, 0).value, consts.cv_from_bool(true)) ? 1 : 0;
    u32 mut index = 0;
    u32 mut target = 0;
    while (fir.term_targets(f, term, index, &target)) {
        if (!work(out, locals * 2 + 2)) { return false; }
        if (!fir_flow.reachable_target(f, term, index, &target)) {
            index += 1;
            continue;
        }
        if (target <= block || cast(target, u64) >= out->reached.len || out->reached[target]) {
            reject(out, ownership_api.incomplete_reason.unknown_effect);
            return false;
        }
        out->reached[target] = true;
        out->parents[target] = block;
        u64 base = cast(target, u64) * locals;
        u64 mut i = 0;
        while (i < locals) {
            out->entry_origins[base + i] = out->origins[i];
            out->entry_scalars[base + i] = out->scalars[i];
            out->entry_holding[base + i] = out->holding[i];
            i += 1;
        }
        if (tested.kind == ownership_api.fact_kind.symbolic &&
            tested.symbol.kind == ownership_api.entity_kind.value &&
            out->values_len < out->values.len) {
            out->values[out->values_len] = ownership_flow.value_edge{block, index,
                tested.symbol, index == 0 ? arm_value : 1 - arm_value};
            out->values_len += 1;
        }
        index += 1;
    }
    return true;
}

fn extract(body_input* in) body_program {
    body_program mut out = body_program{};
    out.proof = ownership_summary_model.complete();
    out.definite_prefix = true;
    out.residual_effects = true;
    out.context = ownership_summary_model.context{in->services,
        ownership_api.operation_position{.function = in->function.key},
        ownership_api.source_position{}, id(in->function.key, ownership_api.entity_kind.event, 1),
        ownership_api.source_position{}};
    if (in->services == null || in->function.body == null || !in->function.verified ||
        !in->correspondence_complete || !in->coverage.structural_valid ||
        !in->coverage.supplied_complete || !ownership_api.valid_limits(&in->limits)) {
        reject(&out, ownership_api.incomplete_reason.missing_correspondence);
        return out;
    }
    fir.func* f = in->function.body;
    types.node* result = fir.local_at(f, 0)->ty;
    if (reference(result) && result->elem != null && fir.type_owning(result->elem)) {
        reject(&out, ownership_api.incomplete_reason.unknown_effect);
        return out;
    }
    u64 locals = cast(fir.local_count(f), u64);
    u64 blocks = cast(fir.block_count(f), u64);
    if (locals > (cast(U32_MAX, u64) - 2) / 2 || blocks == 0 ||
        locals > types.TYPE_MAX_SIZE / sizeof(ownership_api.entity_id)) {
        reject(&out, ownership_api.incomplete_reason.invalid_input);
        return out;
    }
    out.addressed = new(bool, locals);
    u64 mut count = 0;
    u64 mut extra = 0;
    u64 mut operands = 0;
    u64 mut targets = 0;
    u32 mut b = 0;
    while (b < fir.block_count(f)) {
        if (!work(&out, 1)) { return out; }
        u64 n = cast(fir.block_statement_count(f, b), u64);
        if (n > U64_MAX - count) {
            reject(&out, ownership_api.incomplete_reason.invalid_input);
            return out;
        }
        count += n;
        u32 mut gap = 0;
        while (gap < fir.block_statement_count(f, b)) {
            if (!work(&out, 1)) { return out; }
            fir.statement* stmt = fir.block_statement(f, b, gap);
            u64 mut projections = cast(stmt->place.proj_len, u64);
            // An address of local storage marks its local. An address through a reference
            // marks that reference, which has no scalar fact. A slice addresses an array,
            // which has no scalar fact either.
            if (stmt->kind == fir.stmt_kind.st_assign &&
                stmt->value.kind == fir.rvalue_kind.rv_addr &&
                stmt->value.place.base == fir.base_kind.bk_local &&
                cast(stmt->value.place.local, u64) < locals) {
                out.addressed[stmt->value.place.local] = true;
            }
            if (stmt->kind == fir.stmt_kind.st_assign) {
                projections += cast(stmt->value.place.proj_len, u64);
                u32 mut op = 0;
                while (op < stmt->value.ops_len) {
                    if (!work(&out, 1)) { return out; }
                    fir.operand input_operand = fir.rvalue_operand(f, stmt->value, op);
                    if (projections > U64_MAX - cast(input_operand.place.proj_len, u64)) {
                        reject(&out, ownership_api.incomplete_reason.invalid_input);
                        return out;
                    }
                    projections += cast(input_operand.place.proj_len, u64);
                    op += 1;
                }
            }
            u64 calls = call_capacity(in, &out, stmt, b, gap);
            if (stmt->kind == fir.stmt_kind.st_assign &&
                stmt->value.kind == fir.rvalue_kind.rv_call) {
                operands += cast(stmt->value.ops_len, u64);
                u64 called = target_count(in, &out, stmt, b, gap);
                if (called > U64_MAX - targets) {
                    reject(&out, ownership_api.incomplete_reason.invalid_input);
                    return out;
                }
                targets += called;
            }
            if (projections > (U64_MAX - extra) / 2 || calls > U64_MAX - extra - projections * 2) {
                reject(&out, ownership_api.incomplete_reason.invalid_input);
                return out;
            }
            extra += projections * 2 + calls;
            gap += 1;
        }
        b += 1;
    }
    u64 event_limit = types.TYPE_MAX_SIZE / sizeof(ownership_flow.event_binding);
    if (count > (U64_MAX - locals - blocks - 1) / 4 ||
        blocks > event_limit / (locals * 20 + 25) ||
        count > (event_limit - blocks * (locals * 20 + 25)) / 5) {
        reject(&out, ownership_api.incomplete_reason.invalid_input);
        return out;
    }
    u64 base = count * 4 + locals + blocks + 1;
    if (extra > U64_MAX - base) {
        reject(&out, ownership_api.incomplete_reason.invalid_input);
        return out;
    }
    u64 cap = base + extra;
    if (cap > types.TYPE_MAX_SIZE / sizeof(ownership_summary_model.effect_node) ||
        cap + locals * 2 > types.TYPE_MAX_SIZE / sizeof(ownership_summary_model.symbolic_root) ||
        cap > types.TYPE_MAX_SIZE / sizeof(ownership_summary_model.requirement) ||
        cap > types.TYPE_MAX_SIZE / sizeof(ownership_summary_model.provenance) ||
        locals > types.TYPE_MAX_SIZE / sizeof(ownership_api.scalar_fact) ||
        locals > types.TYPE_MAX_SIZE / sizeof(ownership_flow.parameter) ||
        cap > types.TYPE_MAX_SIZE / sizeof(ownership_flow.step) ||
        cap > cast(U32_MAX, u64) / 8 || !work(&out, cap * 12 + locals * 4)) {
        reject(&out, ownership_api.incomplete_reason.invalid_input);
        return out;
    }
    out.steps = new(ownership_flow.step, cap);
    out.transfer_events = new(ownership_transfer.event_binding, cap);
    out.events = new(ownership_flow.event_binding, blocks * (locals * 20 + 25) + count * 5);
    out.parameters = new(ownership_flow.parameter, locals);
    out.roots = new(ownership_summary_model.symbolic_root, cap + locals * 2);
    out.requirements = new(ownership_summary_model.requirement, cap);
    out.effects = new(ownership_summary_model.effect_node, cap);
    out.provenance_records = new(ownership_summary_model.provenance, cap);
    out.origins = new(ownership_api.entity_id, locals);
    out.scalars = new(ownership_api.scalar_fact, locals);
    out.holding = new(u8, locals);
    out.calls = new(call_site, count);
    if (operands > types.TYPE_MAX_SIZE / sizeof(ownership_api.scalar_fact)) {
        reject(&out, ownership_api.incomplete_reason.invalid_input);
        return out;
    }
    out.call_args = new(ownership_api.scalar_fact, operands);
    if (targets > types.TYPE_MAX_SIZE / sizeof(call_target)) {
        reject(&out, ownership_api.incomplete_reason.invalid_input);
        return out;
    }
    out.targets = new(call_target, targets);
    if (locals != 0 && blocks > types.TYPE_MAX_SIZE / sizeof(ownership_api.scalar_fact) / locals ||
        blocks > types.TYPE_MAX_SIZE / sizeof(ownership_flow.value_edge) / 2 ||
        !work(&out, blocks * (locals * 2 + 4))) {
        reject(&out, ownership_api.incomplete_reason.invalid_input);
        return out;
    }
    out.parents = new(u32, blocks);
    out.reached = new(bool, blocks);
    out.entry_origins = new(ownership_api.entity_id, blocks * locals);
    out.entry_scalars = new(ownership_api.scalar_fact, blocks * locals);
    out.entry_holding = new(u8, blocks * locals);
    out.values = new(ownership_flow.value_edge, blocks * 2);
    u64 mut parent = 0;
    while (parent < blocks) {
        out.parents[parent] = U32_MAX;
        parent += 1;
    }
    out.reached[0] = true;
    out.entry = ownership_state.empty();
    out.metadata = ownership_state.empty();
    out.next_key = cast(locals * 2 + 2, u32);
    out.coverage = in->coverage;
    out.coverage.actual_source_complete = false;
    if (!seed(in, &out)) { return out; }
    b = 0;
    while (b < fir.block_count(f)) {
        fir.block* current = fir.block_at(f, b);
        if (!work(&out, 1) || !current->terminated) {
            reject(&out, ownership_api.incomplete_reason.invalid_input);
            return out;
        }
        if (!out.reached[b]) {
            b += 1;
            continue;
        }
        if (b > 0 && !restore_entry(&out, b, locals)) { return out; }
        u32 mut gap = 0;
        while (gap < fir.block_statement_count(f, b)) {
            fir.statement* stmt = fir.block_statement(f, b, gap);
            out.context.operation = position(in, b, gap, false);
            out.context.source = location(in, &out, stmt->loc);
            out.context.event = next(&out, ownership_api.entity_kind.event);
            if (stmt->loc.file.len > 0 && !out.context.source.filename_present) {
                reject(&out, ownership_api.incomplete_reason.missing_correspondence);
                return out;
            }
            if (stmt->kind == fir.stmt_kind.st_assign) { assign(in, &out, stmt, b, gap); }
            else if (stmt->kind == fir.stmt_kind.st_del && direct(stmt->place)) {
                ownership_transfer.request mut req = basic(in, stmt->place.local,
                    stmt->place.local, ownership_transfer.action.release);
                types.node* ty = fir.place_type(f, stmt->place);
                req.source_key = out.origins[stmt->place.local];
                req.leaves_empty_proved = reference(ty) && ty->elem != null;
                if (req.leaves_empty_proved && fir.type_owning(ty->elem)) {
                    requirement(in, &out, req.source_key, caller_slot(in, stmt->place.local), 0,
                        ownership_summary_model.requirement_kind.empty_children, 1);
                }
                emit(in, &out, req, b, gap, 0, ownership_summary_model.payload_kind.release,
                    stmt->loc, stmt->exit_loc, stmt->stmt, req.destination);
            } else if (stmt->kind == fir.stmt_kind.st_del) {
                selected_storage mut selected = select_storage(in, &out, stmt->place);
                if (!output_ready(in, &out, &selected, true)) { return out; }
                ownership_transfer.request req = ownership_transfer.request{
                    .kind = ownership_transfer.action.release, .source = selected.path,
                    .destination = selected.path, .source_key = selected.source,
                    .destination_owns = true, .leaves_empty_proved = true};
                emit(in, &out, req, b, gap, 0, ownership_summary_model.payload_kind.release,
                    stmt->loc, stmt->exit_loc, stmt->stmt, selected.flow_path);
            } else if (stmt->kind == fir.stmt_kind.st_dead) {
                ownership_transfer.request mut req = basic(in, stmt->local, stmt->local,
                    ownership_transfer.action.dead);
                req.liveness_proved = true;
                req.source_correspondence_proved = true;
                emit(in, &out, req, b, gap, 0, ownership_summary_model.payload_kind.storage_end,
                    stmt->loc, stmt->exit_loc, stmt->stmt, req.destination);
            } else if (stmt->kind != fir.stmt_kind.st_live) {
                reject(&out, ownership_api.incomplete_reason.unknown_effect);
            }
            if (!ownership_api.successful(out.proof)) { return out; }
            gap += 1;
        }
        out.context.operation = position(in, b, gap, true);
        out.context.source = location(in, &out, current->term.loc);
        if (current->term.kind != fir.term_kind.tk_return &&
            current->term.kind != fir.term_kind.tk_goto &&
            current->term.kind != fir.term_kind.tk_check &&
            current->term.kind != fir.term_kind.tk_check_overwrite &&
            current->term.kind != fir.term_kind.tk_fail &&
            current->term.kind != fir.term_kind.tk_trap &&
            !boolean_switch(&out, f, &current->term)) {
            reject(&out, ownership_api.incomplete_reason.unknown_effect);
            return out;
        }
        if (current->term.kind == fir.term_kind.tk_return && !results_reached(&out)) {
            return out;
        }
        if (!follow_targets(in, &out, b, &current->term, locals)) { return out; }
        if (current->term.kind == fir.term_kind.tk_switch) {
            out.definite_prefix = false;
        } else if (current->term.kind == fir.term_kind.tk_check) {
            ownership_api.scalar_fact condition = constant(in, &out, current->term.cond);
            if (condition.kind != ownership_api.fact_kind.exact || condition.value == 0) {
                out.definite_prefix = false;
            }
        } else if (current->term.kind == fir.term_kind.tk_check_overwrite &&
            (!direct(current->term.place) ||
                out.origins[current->term.place.local].kind != ownership_api.entity_kind.none)) {
            out.definite_prefix = false;
        }
        if (!add_terminal_events(in, &out, b)) { return out; }
        b += 1;
    }
    if (out.held_inline_address) {
        reject(&out, ownership_api.incomplete_reason.unknown_effect);
        return out;
    }
    out.residual_effects = false;
    return out;
}

fn flow(body_input* in, body_program* out) ownership_flow.program {
    types.node* result = fir.local_at(in->function.body, 0)->ty;
    return ownership_flow.program{.function = in->function.body, .identity = in->function.key,
        .entry = &out->entry, .services = in->services, .limits = &in->limits,
        .steps = out->steps[..out->steps_len], .parameters = out->parameters[..out->parameters_len],
        .values = out->values[..out->values_len],
        .events = out->events[..out->events_len], .source_files = in->source_files,
        .result_slot = reference(result) ? slot(in, 0).root : ownership_api.entity_id{},
        .supplied_complete = !out->residual_effects, .verified_fir = in->function.verified};
}
