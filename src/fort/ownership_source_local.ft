/// Produces local ownership effects from verified source FIR and validates local violations.
// The caller keeps this context, its FIR and the checker's types at stable addresses through
// free. A tracked local slot (TL) is a reference local whose storage no FIR address names.
// The stored run (`stored_borrows`) also tracks the reference leaves of private aggregates
// (TA) and the stack sources of the locals whose storage an address names.
import consts;
import diag;
import fir;
import fir_flow;
import ownership_api;
import ownership_flow;
import ownership_keys;
import ownership_limits;
import ownership_source_leaves;
import ownership_state;
import ownership_transfer;
import prim;
import types;

u64 U64_MAX = 18446744073709551615;
u32 U32_MAX = 4294967295;
// Parameter entities use this base so that they never meet a step ordinal.
u32 PARAMETER_BASE = 2147483648;
// The earlier identities of the allocation site of step i use EARLIER_BASE + i. The base leaves
// 2^30 parameter ordinals below it and 2^30 - 2 site ordinals below STATIC_ORDINAL.
u32 EARLIER_BASE = 3221225472;
u32 STATIC_ORDINAL = 4294967294;

enum status {
    unexecuted,
    complete,
    incomplete,
    failed,
}

/// Why the producer supplies no complete local correspondence for a body.
enum missing {
    none,
    fort_call,
    own_parameter,
    escape,
    owner_load,
    foreign_owner,
    unknown_source,
    owning_storage,
    aggregate_result,
    range_loan,
    owned_leaves,
    call_dependent,
    // A variable index selects an element that the stored run cannot read or release.
    dynamic_element,
}

// One event of the flow run. Texts are literals of the transfer and flow modules.
struct record {
    u64 key;
    ownership_api.operation_position operation;
    ownership_api.source_position source;
    ownership_api.event_kind kind;
    ownership_api.incomplete_reason reason;
    ownership_api.entity_id relation;
    string text;
    bool violation;
    bool validated;
}

/// A validated violation: every path state that reached the operation failed it, and a
/// witness path reaches the operation. `quoted` says that `name` is a source name.
struct violation {
    ownership_api.operation_position operation;
    ownership_api.source_position source;
    ownership_api.event_kind kind;
    string text;
    string name;
    bool quoted;
    ownership_api.entity_id relation;
    // The leaf that the message names, or WHOLE: the name is then `name`.
    u64 leaf;
}

// What a place of one statement means for the TLs.
struct access {
    bool tracked;
    u32 local;
    bool whole;
    bool indirect;
    bool length;
    bool pointer;
}

u64 WHOLE = 18446744073709551615;

/// A tracked place: a whole TL when `leaf` is WHOLE, else leaf `leaf` of a TA.
struct spot {
    u32 local;
    u64 leaf;
}

// The leaves that a step reads and writes, and the elements of a weak store, for messages
// and for link. WHOLE means a whole slot.
struct step_extra {
    u64 from;
    u64 to;
    u64 weak_first;
    u64 weak_count;
}

// A flow binding outside the steps: one return, call or allocation event.
struct binding_info {
    u32 block;
    bool at_return;
}

struct context {
    fir.func* function;
    ownership_api.function_id identity;
    u32 file;
    string filename;
    ownership_api.source_position declaration;
    bool mut@ own tracked;
    bool mut@ own owning;
    // A local whose storage some FIR address names. Pointers can write it at any time.
    bool mut@ own taken;
    // A borrowed temporary that one statement writes and a later statement of its block reads
    // once. Its value has no use after that read.
    bool mut@ own transient;
    // A bool local that no address names and that a switch tests, directly or through copies
    // and negations. Each write of a flag gives a flag step (spec/fir.md 14.1).
    bool mut@ own flag;
    u32 mut@ own flag_index;
    // flag_live[k] holds the blocks at whose entry flag k is live: a read of it can follow
    // before its next write.
    fir_flow.bits mut@ own flag_live;
    ownership_flow.flag_edge mut@ own flag_edges;
    u64 flag_edges_len;
    // A TL that an address or a slice through an indirection can fill, directly or through
    // copies and moves. Its empty contents prove no null pointer: `&r->f` of a null `r` is not
    // null. So a null test of it decides only "not null".
    bool mut@ own offset;
    ownership_flow.step mut@ own steps;
    u64 steps_len;
    // The step of each unknown fort call. A violation after one has no validated path.
    bool mut@ own barrier;
    u32 mut@ own step_slot;
    ownership_transfer.event_binding mut@ own step_events;
    ownership_api.borrow_relation mut@ own relations;
    ownership_flow.event_binding mut@ own events;
    binding_info mut@ own event_info;
    u64 events_len;
    ownership_api.outcome_fact[1] trusted_return;
    ownership_flow.source_file_binding[1] files;
    ownership_state.state entry;
    ownership_api.entity_id result_slot;
    // The stored run (spec/toolchain.md 1.1).
    bool stored;
    ownership_source_leaves.table leaves;
    // `stack_units[u]`: TL or TA leaf `u` can hold a borrow of local storage (stack_borrows).
    bool mut@ own stack_units;
    step_extra mut@ own extras;
    // The places of weak stores, which link gives to their requests.
    ownership_api.place_path mut@ own weak_places;
    u64 weak_places_len;
    // The FIR places of loan collections that are TA leaves (fir.md 14).
    ownership_flow.place_binding mut@ own bindings;
    u64 bindings_len;
    ownership_api.limit_table limits;
    ownership_limits.meter meter;
    // The ledger of the classification run, a computation of its own over the same FIR. It
    // exists once `classified` is set.
    ownership_limits.meter classify_meter;
    ownership_api.proof_status classify_refusal;
    bool classified;
    ownership_api.services services;
    ownership_api.proof_status first_refusal;
    u64 fir_size;
    missing gap;
    ownership_api.source_position gap_source;
    ownership_flow.analysis result;
    record mut@ own records;
    u64 records_len;
    bool records_lost;
    u64 mut@ own step_attempts;
    u64 mut@ own step_uncertain;
    u64 mut@ own return_attempts;
    u64 mut@ own return_uncertain;
    violation mut@ own violations;
    u64 violations_len;
    u64 unvalidated;
    status correspondence;
    status solver;
    ownership_api.proof_status proof;
    ownership_api.proof_status first_incomplete;
    bool initialized;
    bool solved;
}

fn complete() ownership_api.proof_status {
    return ownership_api.proof_status{.kind = ownership_api.proof_kind.complete};
}

fn entity(context* c, ownership_api.entity_kind kind, u32 ordinal) ownership_api.entity_id {
    return ownership_api.entity_id{c->identity, kind, ordinal};
}

fn slot(context* c, u32 local) ownership_api.place_path {
    return ownership_api.place_path{.root = entity(c, ownership_api.entity_kind.slot, local)};
}

fn reference_type(types.node* t) bool { return types.type_is_reference(t); }

// Whether a value of type `t` holds an owning leaf: an own reference or an owning aggregate.
fn owning_type(types.node* t) bool {
    if (reference_type(t)) { return t->is_own; }
    return types.type_is_owning_aggregate(t);
}

// Whether a value of type `t` holds a reference leaf. A reference stops the walk.
fn reference_leaf(types.node* t) bool {
    if (reference_type(t)) { return true; }
    if (t->kind == types.type_kind.k_array) { return reference_leaf(t->elem); }
    if (t->kind != types.type_kind.k_struct) { return false; }
    u32 count = fir.struct_field_count(t);
    u32 mut k = 0;
    while (k < count) {
        if (reference_leaf(fir.struct_field_type(t, k))) { return true; }
        k += 1;
    }
    return false;
}

fn local_type(context* c, u32 local) types.node* {
    return fir.local_at(c->function, local)->ty;
}

/// Marks each local whose storage some FIR address names, in one pass over the statements.
fn mark_taken(fir.func* f, bool mut@ taken) void {
    u32 mut b = 0;
    while (b < fir.block_count(f)) {
        u32 mut i = 0;
        while (i < fir.block_statement_count(f, b)) {
            fir.statement* s = fir.block_statement(f, b, i);
            if (s->kind == fir.stmt_kind.st_assign &&
                (s->value.kind == fir.rvalue_kind.rv_addr ||
                s->value.kind == fir.rvalue_kind.rv_slice) &&
                s->value.place.base == fir.base_kind.bk_local &&
                names_storage(f, s->value.place, s->value.kind)) {
                taken[cast(s->value.place.local, u64)] = true;
            }
            i += 1;
        }
        b += 1;
    }
}

// An address names the local's storage unless an indirection comes before it. A slice of a
// span or a string reads the header and names the referent.
fn names_storage(fir.func* f, fir.place p, fir.rvalue_kind kind) bool {
    types.node* mut t = fir.base_type(f, p);
    if (kind == fir.rvalue_kind.rv_slice && p.proj_len == 0 &&
        (t->kind == types.type_kind.k_span || t->kind == types.type_kind.k_string)) {
        return false;
    }
    u32 mut i = 0;
    while (i < p.proj_len) {
        fir.projection pj = fir.place_projection(f, p, i);
        if (pj.kind == fir.proj_kind.pj_deref) { return false; }
        if (pj.kind == fir.proj_kind.pj_index &&
            (t->kind == types.type_kind.k_span || t->kind == types.type_kind.k_string)) {
            return false;
        }
        t = fir.apply_projection(f, t, pj);
        i += 1;
    }
    if (kind == fir.rvalue_kind.rv_slice &&
        (t->kind == types.type_kind.k_span || t->kind == types.type_kind.k_string)) {
        return false;
    }
    return true;
}

// Counts the statements and terminators that read each local, and the whole writes of each.
fn transients(context mut* c) void {
    fir.func* f = c->function;
    u64 count = cast(fir.local_count(f), u64);
    c->transient = new(bool, count);
    u64 mut@ own reads = new(u64, count);
    defer del(reads);
    u64 mut@ own writes = new(u64, count);
    defer del(writes);
    u32 mut@ own written_block = new(u32, count);
    defer del(written_block);
    u32 mut@ own written_gap = new(u32, count);
    defer del(written_gap);
    u32 mut@ own read_block = new(u32, count);
    defer del(read_block);
    u32 mut@ own read_gap = new(u32, count);
    defer del(read_gap);
    u32 mut b = 0;
    while (b < fir.block_count(f)) {
        u32 len = fir.block_statement_count(f, b);
        u32 mut g = 0;
        while (g <= len) {
            fir.read mut value = fir.read{};
            u32 mut i = 0;
            u64 mut last = U64_MAX;
            while (g < len ? fir.stmt_read(f, fir.block_statement(f, b, g), i, &value) :
                fir.term_read(f, &fir.block_at(f, b)->term, i, &value)) {
                if (value.place.base == fir.base_kind.bk_local &&
                    cast(value.place.local, u64) != last) {
                    u64 n = cast(value.place.local, u64);
                    reads[n] += 1;
                    read_block[n] = b;
                    read_gap[n] = g;
                    last = n;
                }
                i += 1;
            }
            fir.place mut written = fir.place{};
            if (g < len && fir.stmt_writes_place(fir.block_statement(f, b, g), &written) &&
                written.base == fir.base_kind.bk_local && written.proj_len == 0) {
                u64 n = cast(written.local, u64);
                writes[n] += 1;
                written_block[n] = b;
                written_gap[n] = g;
            }
            g += 1;
        }
        b += 1;
    }
    u64 mut n = 0;
    while (n < count) {
        fir.local* l = fir.local_at(f, cast(n, u32));
        c->transient[n] = l->kind == fir.local_kind.lk_temp && c->tracked[n] &&
            !c->owning[n] && reads[n] == 1 && writes[n] == 1 &&
            read_block[n] == written_block[n] && read_gap[n] > written_gap[n];
        n += 1;
    }
}

// Ends the borrowed temporaries that this position reads for the last time.
fn end_transients(context mut* c, u32 block, u32 gap) void {
    fir.func* f = c->function;
    u32 len = fir.block_statement_count(f, block);
    fir.read mut value = fir.read{};
    u32 mut i = 0;
    while (gap < len ? fir.stmt_read(f, fir.block_statement(f, block, gap), i, &value) :
        fir.term_read(f, &fir.block_at(f, block)->term, i, &value)) {
        if (value.place.base == fir.base_kind.bk_local &&
            c->transient[cast(value.place.local, u64)]) {
            c->transient[cast(value.place.local, u64)] = false;
            assign_empty(c, block, gap, value.place.local);
        }
        i += 1;
    }
}

fn classify(context mut* c) void {
    u32 count = fir.local_count(c->function);
    c->tracked = new(bool, cast(count, u64));
    c->owning = new(bool, cast(count, u64));
    c->taken = new(bool, cast(count, u64));
    mark_taken(c->function, c->taken);
    if (c->stored) { c->leaves = ownership_source_leaves.build(c->function, c->taken[..]); }
    u32 mut n = 0;
    while (n < count) {
        fir.local* l = fir.local_at(c->function, n);
        bool reference = reference_type(l->ty);
        c->tracked[cast(n, u64)] = reference && !c->taken[cast(n, u64)];
        c->owning[cast(n, u64)] = owning_type(l->ty);
        n += 1;
    }
}

// ---- flags ------------------------------------------------------------------------------------

fn flag_type(types.node* t) bool {
    return t->kind == types.type_kind.k_prim && t->prim == prim.prim_kind.prim_bool;
}

// The bool local that operand `o` copies whole, or U32_MAX.
fn flag_operand(context* c, fir.operand o) u32 {
    if (o.kind != fir.operand_kind.ok_copy || o.place.base != fir.base_kind.bk_local ||
        o.place.proj_len != 0 || c->taken[cast(o.place.local, u64)] ||
        !flag_type(local_type(c, o.place.local))) { return U32_MAX; }
    return o.place.local;
}

// The flag that the whole-local write `s` stores into, or U32_MAX.
fn flag_written(context* c, fir.statement* s) u32 {
    if (s->kind != fir.stmt_kind.st_assign || s->place.base != fir.base_kind.bk_local ||
        s->place.proj_len != 0 || !c->flag[cast(s->place.local, u64)]) { return U32_MAX; }
    return s->place.local;
}

// Marks the flags: the bool locals that a switch tests, then the bool locals that a copy or a
// negation stores into a flag, until no new flag appears.
fn classify_flags(context mut* c) void {
    fir.func* f = c->function;
    u64 count = cast(fir.local_count(f), u64);
    c->flag = new(bool, count);
    u32 mut b = 0;
    while (b < fir.block_count(f)) {
        fir.block* at = fir.block_at(f, b);
        if (at->terminated && at->term.kind == fir.term_kind.tk_switch) {
            u32 tested = flag_operand(c, at->term.cond);
            if (tested != U32_MAX) { c->flag[cast(tested, u64)] = true; }
        }
        b += 1;
    }
    bool mut changed = true;
    while (changed) {
        changed = false;
        b = 0;
        while (b < fir.block_count(f)) {
            u32 mut g = 0;
            while (g < fir.block_statement_count(f, b)) {
                fir.statement* s = fir.block_statement(f, b, g);
                if (flag_written(c, s) != U32_MAX && s->value.ops_len == 1 &&
                    (s->value.kind == fir.rvalue_kind.rv_use ||
                    s->value.kind == fir.rvalue_kind.rv_not)) {
                    u32 from = flag_operand(c, fir.rvalue_operand(f, s->value, 0));
                    if (from != U32_MAX && !c->flag[cast(from, u64)]) {
                        c->flag[cast(from, u64)] = true;
                        changed = true;
                    }
                }
                g += 1;
            }
            b += 1;
        }
    }
    flag_liveness(c);
}

// Finds the blocks where each flag is live at entry. A block that reads a flag before it writes
// it starts the search, which then goes back through each predecessor that does not write it.
fn flag_liveness(context mut* c) void {
    fir.func* f = c->function;
    u64 locals = cast(fir.local_count(f), u64);
    u32 blocks = fir.block_count(f);
    c->flag_index = new(u32, locals);
    u32 mut flags = 0;
    u64 mut n = 0;
    while (n < locals) {
        c->flag_index[n] = U32_MAX;
        if (c->flag[n]) {
            c->flag_index[n] = flags;
            flags += 1;
        }
        n += 1;
    }
    c->flag_live = new(fir_flow.bits, cast(flags, u64));
    fir_flow.bits mut@ own writes = new(fir_flow.bits, cast(flags, u64));
    defer del(writes);
    u64 mut k = 0;
    while (k < cast(flags, u64)) {
        c->flag_live[k] = fir_flow.bits_new(blocks);
        writes[k] = fir_flow.bits_new(blocks);
        k += 1;
    }
    u32 mut b = 0;
    while (b < blocks) {
        u32 len = fir.block_statement_count(f, b);
        u32 mut g = 0;
        while (g <= len) {
            fir.read mut value = fir.read{};
            u32 mut i = 0;
            while (g < len ? fir.stmt_read(f, fir.block_statement(f, b, g), i, &value) :
                fir.term_read(f, &fir.block_at(f, b)->term, i, &value)) {
                if (value.place.base == fir.base_kind.bk_local) {
                    u32 index = c->flag_index[cast(value.place.local, u64)];
                    if (index != U32_MAX && !fir_flow.bits_get(&writes[cast(index, u64)], b)) {
                        fir_flow.bits_set(&c->flag_live[cast(index, u64)], b);
                    }
                }
                i += 1;
            }
            if (g < len) {
                u32 written = flag_written(c, fir.block_statement(f, b, g));
                if (written != U32_MAX) {
                    fir_flow.bits_set(&writes[cast(c->flag_index[cast(written, u64)], u64)], b);
                }
            }
            g += 1;
        }
        b += 1;
    }
    fir.pred_table mut preds = fir.func_predecessors(f);
    defer fir.pred_table_free(&preds);
    u32 mut@ own work = new(u32, cast(blocks, u64));
    defer del(work);
    k = 0;
    while (k < cast(flags, u64)) {
        u64 mut len = 0;
        b = 0;
        while (b < blocks) {
            if (fir_flow.bits_get(&c->flag_live[k], b)) { work[len] = b; len += 1; }
            b += 1;
        }
        while (len > 0) {
            len -= 1;
            u32 at = work[len];
            u32 mut i = 0;
            while (i < fir.pred_count(&preds, at)) {
                u32 from = fir.pred_at(&preds, at, i);
                if (!fir_flow.bits_get(&c->flag_live[k], from) &&
                    !fir_flow.bits_get(&writes[k], from)) {
                    fir_flow.bits_set(&c->flag_live[k], from);
                    work[len] = from;
                    len += 1;
                }
                i += 1;
            }
        }
        fir_flow.bits_free(&writes[k]);
        k += 1;
    }
}

// The TL whose contents a write copies from operand `o`, or U32_MAX: a whole TL, and for a
// use or a cast also the pointer of a span TL, as `write_operand` copies them.
fn copied_local(context* c, fir.operand o, bool pointer) u32 {
    if (o.kind == fir.operand_kind.ok_const) { return U32_MAX; }
    access a = place_access(c, o.place);
    if (!a.tracked || !(a.whole || (pointer && a.pointer))) { return U32_MAX; }
    return a.local;
}

// Marks the TLs that an address or a slice through a TL fills, then each TL that a copy, a
// move, a cast or a view of a marked TL fills, until no new mark appears. The marks cover every
// path, so they can only remove a null decision.
fn mark_offsets(context mut* c) void {
    fir.func* f = c->function;
    c->offset = new(bool, cast(fir.local_count(f), u64));
    bool mut changed = true;
    while (changed) {
        changed = false;
        u32 mut b = 0;
        while (b < fir.block_count(f)) {
            u32 mut g = 0;
            while (g < fir.block_statement_count(f, b)) {
                fir.statement* s = fir.block_statement(f, b, g);
                access to = s->kind == fir.stmt_kind.st_assign ? place_access(c, s->place) :
                    access{};
                bool mut marked = false;
                if (to.tracked && to.whole && !c->offset[cast(to.local, u64)]) {
                    fir.rvalue r = s->value;
                    if (r.kind == fir.rvalue_kind.rv_addr || r.kind == fir.rvalue_kind.rv_slice) {
                        access a = place_access(c, r.place);
                        marked = a.tracked && (a.indirect || (a.whole &&
                            r.kind == fir.rvalue_kind.rv_slice));
                    } else if ((r.kind == fir.rvalue_kind.rv_use ||
                        r.kind == fir.rvalue_kind.rv_cast ||
                        r.kind == fir.rvalue_kind.rv_slice_ptr ||
                        r.kind == fir.rvalue_kind.rv_aggregate) && r.ops_len > 0) {
                        bool use = r.kind == fir.rvalue_kind.rv_use ||
                            r.kind == fir.rvalue_kind.rv_cast;
                        u32 from = copied_local(c, fir.rvalue_operand(f, r, 0), use);
                        marked = from != U32_MAX && c->offset[cast(from, u64)];
                    }
                }
                if (marked) {
                    c->offset[cast(to.local, u64)] = true;
                    changed = true;
                }
                g += 1;
            }
            b += 1;
        }
    }
}

fn flag_live_at(context* c, u32 local, u32 block) bool {
    return fir_flow.bits_get(&c->flag_live[cast(c->flag_index[cast(local, u64)], u64)], block);
}

fn note_gap(context mut* c, missing why, ownership_api.source_position at) void {
    if (c->gap == missing.none) {
        c->gap = why;
        c->gap_source = at;
    }
}

fn source(context* c, diag.loc at) ownership_api.source_position {
    if (at.line == 0 || at.col == 0 || at.file != c->filename) { return c->declaration; }
    return ownership_api.source_position{c->identity.declaration.module, c->file,
        at.line, at.col, at.end_line, at.end_col, true};
}

fn position(context* c, u32 block, u32 gap) ownership_api.operation_position {
    return ownership_api.operation_position{c->identity, block, gap,
        gap == fir.block_statement_count(c->function, block)};
}

fn location(context* c, u32 block, u32 gap) diag.loc {
    if (gap < fir.block_statement_count(c->function, block)) {
        return fir.block_statement(c->function, block, gap)->loc;
    }
    return fir.block_at(c->function, block)->term.loc;
}

fn place_access(context* c, fir.place p) access {
    access mut out = access{};
    if (p.base != fir.base_kind.bk_local || !c->tracked[cast(p.local, u64)]) { return out; }
    out.tracked = true;
    out.local = p.local;
    out.whole = p.proj_len == 0;
    types.node* mut t = local_type(c, p.local);
    u32 mut i = 0;
    while (i < p.proj_len) {
        fir.projection pj = fir.place_projection(c->function, p, i);
        bool header = t->kind == types.type_kind.k_span || t->kind == types.type_kind.k_string;
        if (pj.kind == fir.proj_kind.pj_deref || (pj.kind == fir.proj_kind.pj_index && header)) {
            out.indirect = true;
            return out;
        }
        if (pj.kind == fir.proj_kind.pj_field && header && i == 0) {
            out.length = pj.field == 1 && p.proj_len == 1;
            out.pointer = pj.field == 0 && p.proj_len == 1;
        }
        t = fir.apply_projection(c->function, t, pj);
        i += 1;
    }
    return out;
}

// Whether an address or a slice of `p` designates storage in the referent of its TL. It does
// when no dereference and no index of a span or a string follows the first one, and a slice
// after that first one cuts a fixed array and not a span or string header. Otherwise the place
// loads another reference, and the result designates the storage of that reference (D17.17).
fn same_referent(context* c, fir.place p, fir.rvalue_kind kind) bool {
    types.node* mut t = local_type(c, p.local);
    bool mut through = false;
    u32 mut i = 0;
    while (i < p.proj_len) {
        fir.projection pj = fir.place_projection(c->function, p, i);
        if (pj.kind == fir.proj_kind.pj_deref ||
            (pj.kind == fir.proj_kind.pj_index && header_type(t))) {
            if (through) { return false; }
            through = true;
        }
        t = fir.apply_projection(c->function, t, pj);
        i += 1;
    }
    return !(kind == fir.rvalue_kind.rv_slice && through && header_type(t));
}

// ---- steps ----------------------------------------------------------------------------------

fn grow_steps(context mut* c) void {
    if (c->steps_len < c->steps.len) { return; }
    u64 cap = c->steps.len * 2 + 8;
    ownership_flow.step mut@ own steps = new(ownership_flow.step, cap);
    u32 mut@ own slots = new(u32, cap);
    bool mut@ own barriers = new(bool, cap);
    ownership_transfer.event_binding mut@ own events = new(ownership_transfer.event_binding, cap);
    ownership_api.borrow_relation mut@ own relations = new(ownership_api.borrow_relation, cap);
    step_extra mut@ own extras = new(step_extra, cap);
    u64 mut i = 0;
    while (i < c->steps_len) {
        steps[i] = c->steps[i];
        slots[i] = c->step_slot[i];
        barriers[i] = c->barrier[i];
        events[i] = c->step_events[i];
        relations[i] = c->relations[i];
        extras[i] = c->extras[i];
        i += 1;
    }
    del(c->steps);
    del(c->step_slot);
    del(c->barrier);
    del(c->step_events);
    del(c->relations);
    del(c->extras);
    c->steps = move(steps);
    c->step_slot = move(slots);
    c->barrier = move(barriers);
    c->step_events = move(events);
    c->relations = move(relations);
    c->extras = move(extras);
}

// Steps and flow bindings take ordinals below PARAMETER_BASE, so no two keys meet.
fn key_ordinal(u64 index) u32 {
    if (index >= cast(PARAMETER_BASE, u64)) {
        // A key needs a step or a binding of 64 bytes or more: 2^31 keys need 128 GiB.
        // panic-coverage: unreachable: read: one body cannot hold 2^31 steps and bindings.
        panic("ownership_source_local: key ordinal overflow");
    }
    return cast(index, u32);
}

// The ordinal of the earlier identities of the allocation site of step `index`.
fn earlier_ordinal(u64 index) u32 {
    if (index >= cast(STATIC_ORDINAL - EARLIER_BASE, u64)) {
        // panic-coverage: unreachable: read: one body cannot hold 2^30 steps and bindings.
        panic("ownership_source_local: earlier ordinal overflow");
    }
    return EARLIER_BASE + cast(index, u32);
}

// Slices into the step arrays move when they grow. link fixes them after the last step.
fn add_step(context mut* c, u32 block, u32 gap, ownership_flow.step_kind kind,
    ownership_transfer.action effect, u32 from, u32 to) u64 {
    grow_steps(c);
    u64 index = c->steps_len;
    u32 key = key_ordinal(index);
    u32 mut order = 0;
    if (index > 0 && c->steps[index - 1].block == block && c->steps[index - 1].gap == gap) {
        order = c->steps[index - 1].order + 1;
    }
    ownership_api.operation_position op = position(c, block, gap);
    ownership_api.source_position at = source(c, location(c, block, gap));
    ownership_flow.step mut s = ownership_flow.step{};
    s.block = block;
    s.gap = gap;
    s.order = order;
    s.kind = kind;
    s.operation = op;
    s.source = at;
    ownership_transfer.request mut r = ownership_transfer.request{};
    r.kind = effect;
    r.operation = op;
    r.source_position = at;
    r.source = slot(c, from);
    r.destination = slot(c, to);
    r.direct_source_proved = true;
    r.direct_destination_proved = true;
    r.event_map_complete_proved = true;
    s.local = r;
    c->steps[index] = s;
    c->step_slot[index] = from;
    c->barrier[index] = false;
    c->step_events[index] = ownership_transfer.event_binding{op,
        entity(c, ownership_api.entity_kind.event, key)};
    c->relations[index] = ownership_api.borrow_relation{};
    c->extras[index] = step_extra{WHOLE, WHOLE, 0, 0};
    c->steps_len += 1;
    return index;
}

fn local_step(context mut* c, u32 block, u32 gap, ownership_transfer.action effect, u32 from,
    u32 to) u64 {
    return add_step(c, block, gap, ownership_flow.step_kind.local_effect, effect, from, to);
}

fn value_of(context* c, u64 index) ownership_api.entity_id {
    return entity(c, ownership_api.entity_kind.value, cast(index, u32));
}

// A step that stops its path with incomplete proof: the producer has no effect for it.
fn unsupported(context mut* c, u32 block, u32 gap, u32 local, missing why) void {
    u64 i = local_step(c, block, gap, ownership_transfer.action.inspect, local, local);
    c->steps[i].local.direct_source_proved = false;
    note_gap(c, why, c->steps[i].source);
}

fn inspect(context mut* c, u32 block, u32 gap, u32 local) void {
    local_step(c, block, gap, ownership_transfer.action.inspect, local, local);
}

fn dereference(context mut* c, u32 block, u32 gap, u32 local) void {
    u64 i = local_step(c, block, gap, ownership_transfer.action.use, local, local);
    c->steps[i].local.temporal_use = true;
}

fn empty_value(context* c, u64 index) ownership_api.contents_fact {
    ownership_api.contents_fact mut value = ownership_api.contents_fact{};
    value.kind = ownership_api.contents_kind.empty_owner;
    value.owner_empty = true;
    value.value_version = value_of(c, index);
    value.span_length.kind = ownership_api.fact_kind.exact;
    return value;
}

fn assign_empty(context mut* c, u32 block, u32 gap, u32 local) void {
    u64 i = local_step(c, block, gap, ownership_transfer.action.assignment, local, local);
    c->steps[i].local.value = empty_value(c, i);
}

fn opaque(context mut* c, u32 block, u32 gap, u32 local, missing why) void {
    u64 i = local_step(c, block, gap, ownership_transfer.action.assignment, local, local);
    c->steps[i].local.opaque_value = true;
    note_gap(c, why, c->steps[i].source);
}

// A reference to a source that local effects never end: static storage or foreign storage.
fn assign_reference(context mut* c, u32 block, u32 gap, u32 local,
    ownership_api.entity_id source_key, ownership_api.scalar_fact length) void {
    u64 i = local_step(c, block, gap, ownership_transfer.action.assignment, local, local);
    ownership_api.entity_id version = value_of(c, i);
    c->relations[i] = ownership_api.borrow_relation{.key = entity(c,
        ownership_api.entity_kind.relation, cast(i, u32)), .value_version = version,
        .containing = slot(c, local), .source = source_key, .representation_complete = true};
    ownership_api.contents_fact mut value = ownership_api.contents_fact{};
    value.kind = ownership_api.contents_kind.reference;
    value.value_version = version;
    value.span_length = length;
    c->steps[i].local.value = value;
}

fn copy_step(context mut* c, u32 block, u32 gap, u32 from, u32 to) void {
    u64 i = local_step(c, block, gap, ownership_transfer.action.copy, from, to);
    c->steps[i].local.destination_owns = c->owning[cast(to, u64)];
}

fn move_step(context mut* c, u32 block, u32 gap, u32 from, u32 to) void {
    local_step(c, block, gap, ownership_transfer.action.move_owner, from, to);
}

fn allocation_step(context mut* c, u32 block, u32 gap, u32 local, fir.operand count) void {
    u64 i = local_step(c, block, gap, ownership_transfer.action.allocation, local, local);
    u32 ordinal = cast(i, u32);
    ownership_api.entity_id key = entity(c, ownership_api.entity_kind.allocation, ordinal);
    ownership_api.entity_id fresh = entity(c, ownership_api.entity_kind.source, ordinal);
    ownership_api.entity_id version = value_of(c, i);
    ownership_api.scalar_fact mut length = ownership_api.scalar_fact{
        .kind = ownership_api.fact_kind.symbolic, .symbol = version};
    if (count.kind == fir.operand_kind.ok_const &&
        count.value.kind == fir.const_kind.ck_int && !count.value.value.neg &&
        count.value.value.mag <= 9223372036854775807) {
        length = ownership_api.scalar_fact{.kind = ownership_api.fact_kind.exact,
            .value = cast(count.value.value.mag, i64)};
    }
    ownership_transfer.request mut* r = &c->steps[i].local;
    r->allocation = ownership_api.allocation_fact{.key = key, .site = key,
        .validity = ownership_api.validity_kind.live, .obligation = true,
        .logical_length = length};
    r->allocation.count.one = true;
    r->allocation.owner.place = slot(c, local);
    r->fresh_source = ownership_api.source_fact{.key = fresh,
        .kind = ownership_api.source_kind.heap, .validity = ownership_api.validity_kind.live,
        .allocation = key};
    r->source_key = fresh;
    // A loop can run the site again while this allocation stays in the facts. This allocation
    // then takes the earlier identities of its site (D17.16).
    u32 earlier = earlier_ordinal(i);
    c->steps[i].earlier = ownership_flow.site_identity{
        entity(c, ownership_api.entity_kind.allocation, earlier),
        entity(c, ownership_api.entity_kind.source, earlier),
        entity(c, ownership_api.entity_kind.value, earlier),
        entity(c, ownership_api.entity_kind.relation, earlier)};
    c->relations[i] = ownership_api.borrow_relation{.key = entity(c,
        ownership_api.entity_kind.relation, ordinal), .value_version = version,
        .containing = slot(c, local), .source = fresh, .representation_complete = true};
    ownership_api.contents_fact mut value = ownership_api.contents_fact{};
    value.kind = ownership_api.contents_kind.reference;
    value.value_version = version;
    value.span_length = length;
    r->value = value;
}

// Del stays shallow (D17.16). Owned leaves of the element type need the heap analysis.
fn release_step(context mut* c, u32 block, u32 gap, u32 local) void {
    u64 i = local_step(c, block, gap, ownership_transfer.action.release, local, local);
    shallow_release(c, i, local_type(c, local));
}

// The release step `i` of a reference of type `t` leaves no owned leaf behind when the
// referent holds none; otherwise the heap analysis owns it.
fn shallow_release(context mut* c, u64 i, types.node* t) void {
    bool leaves = t->kind == types.type_kind.k_string ||
        (t->kind != types.type_kind.k_voidptr && t->elem != null && !owning_type(t->elem));
    c->steps[i].local.leaves_empty_proved = leaves;
    if (!leaves) { note_gap(c, missing.owned_leaves, c->steps[i].source); }
}

fn end_step(context mut* c, u32 block, u32 gap, u32 local) void {
    u64 i = local_step(c, block, gap, ownership_transfer.action.dead, local, local);
    c->steps[i].local.private_slot_proved = true;
    c->steps[i].local.liveness_proved = true;
}

// A trusted extern call returns with its signature effects (D17.13).
fn call_step(context mut* c, u32 block, u32 gap) void {
    u64 i = add_step(c, block, gap, ownership_flow.step_kind.call_outcome,
        ownership_transfer.action.inspect, 0, 0);
    c->steps[i].outcomes_complete = true;
}

// Only slot owners keep their facts. An unknown call can also fail to return (D17.18).
fn outside_step(context mut* c, u32 block, u32 gap, bool unknown_call) void {
    u64 i = local_step(c, block, gap, ownership_transfer.action.outside, 0, 0);
    c->barrier[i] = unknown_call;
}

fn flag_step(context mut* c, u32 block, u32 gap, u32 written, ownership_flow.flag_kind kind,
    u32 from, bool value) void {
    u64 i = add_step(c, block, gap, ownership_flow.step_kind.flag,
        ownership_transfer.action.inspect, written, written);
    bool offset = kind == ownership_flow.flag_kind.null_test && c->offset[cast(from, u64)];
    c->steps[i].flag = ownership_flow.flag_effect{kind,
        entity(c, ownership_api.entity_kind.slot, written),
        entity(c, ownership_api.entity_kind.slot, from), value, offset};
}

// Whether operand `o` is a null constant of a reference type.
fn null_constant(fir.operand o) bool {
    if (o.kind != fir.operand_kind.ok_const) { return false; }
    return o.value.kind == fir.const_kind.ck_null || (o.value.kind == fir.const_kind.ck_zero &&
        o.value.ty != null && types.type_is_reference(o.value.ty));
}

// The pointer TL that a comparison with null reads whole, or U32_MAX.
fn null_tested(context* c, fir.rvalue r) u32 {
    if ((r.kind != fir.rvalue_kind.rv_eq && r.kind != fir.rvalue_kind.rv_ne) || r.ops_len != 2) {
        return U32_MAX;
    }
    fir.operand a = fir.rvalue_operand(c->function, r, 0);
    fir.operand b = fir.rvalue_operand(c->function, r, 1);
    fir.operand tested = null_constant(b) ? a : b;
    if (!null_constant(a) && !null_constant(b)) { return U32_MAX; }
    if (tested.kind != fir.operand_kind.ok_copy || !whole_tracked(c, tested)) { return U32_MAX; }
    types.node* t = local_type(c, tested.place.local);
    if (t->kind != types.type_kind.k_ptr && t->kind != types.type_kind.k_voidptr) {
        return U32_MAX;
    }
    return tested.place.local;
}

// The flag step of a write into a flag. The step comes after the steps of the statement, so a
// null test reads the contents after the read of its operand.
fn flag_write(context mut* c, u32 block, u32 gap, fir.statement* s) void {
    u32 written = flag_written(c, s);
    if (written == U32_MAX) { return; }
    fir.rvalue r = s->value;
    ownership_flow.flag_kind mut kind = ownership_flow.flag_kind.clear;
    u32 mut from = written;
    bool mut value = false;
    if ((r.kind == fir.rvalue_kind.rv_use || r.kind == fir.rvalue_kind.rv_not) &&
        r.ops_len == 1) {
        fir.operand o = fir.rvalue_operand(c->function, r, 0);
        bool constant = o.kind == fir.operand_kind.ok_const &&
            o.value.kind == fir.const_kind.ck_bool && r.kind == fir.rvalue_kind.rv_use;
        u32 copied = flag_operand(c, o);
        if (constant) {
            kind = ownership_flow.flag_kind.constant;
            value = o.value.value.mag == 1;
        } else if (copied != U32_MAX && c->flag[cast(copied, u64)]) {
            kind = r.kind == fir.rvalue_kind.rv_use ? ownership_flow.flag_kind.copy :
                ownership_flow.flag_kind.negate;
            from = copied;
        }
    } else {
        u32 tested = null_tested(c, r);
        if (tested != U32_MAX) {
            kind = ownership_flow.flag_kind.null_test;
            from = tested;
            value = r.kind == fir.rvalue_kind.rv_eq;
        }
    }
    flag_step(c, block, gap, written, kind, from, value);
}

fn add_flag_edge(context mut* c, ownership_flow.flag_edge edge) void {
    if (c->flag_edges_len == c->flag_edges.len) {
        u64 cap = c->flag_edges.len * 2 + 4;
        ownership_flow.flag_edge mut@ own bigger = new(ownership_flow.flag_edge, cap);
        u64 mut i = 0;
        while (i < c->flag_edges_len) { bigger[i] = c->flag_edges[i]; i += 1; }
        del(c->flag_edges);
        c->flag_edges = move(bigger);
    }
    c->flag_edges[c->flag_edges_len] = edge;
    c->flag_edges_len += 1;
}

// The edges of a switch on a flag. An arm takes the edge when the flag holds its value. The
// otherwise target takes it when the flag holds the one bool value that no arm names. Each edge
// keeps the value only where the flag is live at the target.
fn switch_flag_edges(context mut* c, u32 block) void {
    fir.func* f = c->function;
    fir.terminator* t = &fir.block_at(f, block)->term;
    u32 tested = flag_operand(c, t->cond);
    if (tested == U32_MAX || !c->flag[cast(tested, u64)]) { return; }
    ownership_api.entity_id flag = entity(c, ownership_api.entity_kind.slot, tested);
    bool mut named_true = false;
    bool mut named_false = false;
    u32 mut i = 0;
    while (i <= t->arms_len) {
        bool otherwise = i == t->arms_len;
        bool mut value = false;
        bool mut known = true;
        u32 target = otherwise ? t->otherwise : fir.term_arm(f, t, i).target;
        if (!otherwise) {
            consts.cval v = fir.term_arm(f, t, i).value;
            known = v.kind == consts.cval_kind.cv_bool;
            value = v.mag == 1;
            if (known && value) { named_true = true; }
            if (known && !value) { named_false = true; }
        } else {
            known = named_true != named_false;
            value = named_false;
        }
        if (known) {
            add_flag_edge(c, ownership_flow.flag_edge{block, i, flag, value,
                flag_live_at(c, tested, target)});
        }
        i += 1;
    }
}

// ---- stored steps -------------------------------------------------------------------------------

fn whole(u32 local) spot { return spot{local, WHOLE}; }

fn leaf_spot(context* c, u64 k) spot { return spot{c->leaves.leaves[k].local, k}; }

fn spot_place(context* c, spot at) ownership_api.place_path {
    if (at.leaf == WHOLE) { return slot(c, at.local); }
    return ownership_source_leaves.place(&c->leaves, c->identity, at.leaf);
}

fn spot_type(context* c, spot at) types.node* {
    if (at.leaf == WHOLE) { return local_type(c, at.local); }
    return c->leaves.leaves[at.leaf].ty;
}

fn spot_owning(context* c, spot at) bool { return owning_type(spot_type(c, at)); }

// The keys of parameter leaves and stack sources follow the parameter keys of whole locals.
fn leaf_parameter_ordinal(context* c, u64 k) u32 {
    return PARAMETER_BASE + fir.local_count(c->function) + key_ordinal(k);
}

fn stack_key(context* c, u32 local) ownership_api.entity_id {
    return entity(c, ownership_api.entity_kind.source, leaf_parameter_ordinal(c,
        c->leaves.leaves_len) + local);
}

// The source of the ended instances of a taken local: a `live` marker moves the old borrows
// there, so they stay ended while the local's storage begins again.
fn retired_stack_key(context* c, u32 local) ownership_api.entity_id {
    return entity(c, ownership_api.entity_kind.source, leaf_parameter_ordinal(c,
        c->leaves.leaves_len) + fir.local_count(c->function) + local);
}

// Points step `i` at the places of two spots. A leaf place uses the leaf rule of transfer:
// distinct fields and constant indices of one root are separate (D17.15).
fn retarget(context mut* c, u64 i, spot from, spot to) void {
    if (from.leaf == WHOLE && to.leaf == WHOLE) { return; }
    ownership_transfer.request mut* r = &c->steps[i].local;
    r->source = spot_place(c, from);
    r->destination = spot_place(c, to);
    r->leaf_places_proved = true;
    c->extras[i].from = from.leaf;
    c->extras[i].to = to.leaf;
    if (c->relations[i].key.kind == ownership_api.entity_kind.relation) {
        c->relations[i].containing = r->destination;
    }
}

fn spot_step(context mut* c, u32 block, u32 gap, ownership_transfer.action effect, spot from,
    spot to) u64 {
    u64 i = local_step(c, block, gap, effect, from.local, to.local);
    retarget(c, i, from, to);
    return i;
}

fn copy_at(context mut* c, u32 block, u32 gap, spot from, spot to) void {
    u64 i = spot_step(c, block, gap, ownership_transfer.action.copy, from, to);
    c->steps[i].local.destination_owns = spot_owning(c, to);
}

fn move_at(context mut* c, u32 block, u32 gap, spot from, spot to) void {
    spot_step(c, block, gap, ownership_transfer.action.move_owner, from, to);
}

fn empty_at(context mut* c, u32 block, u32 gap, spot at) void {
    u64 i = spot_step(c, block, gap, ownership_transfer.action.assignment, at, at);
    c->steps[i].local.value = empty_value(c, i);
}

fn opaque_at(context mut* c, u32 block, u32 gap, spot at, missing why) void {
    u64 i = spot_step(c, block, gap, ownership_transfer.action.assignment, at, at);
    c->steps[i].local.opaque_value = true;
    note_gap(c, why, c->steps[i].source);
}

fn reference_at(context mut* c, u32 block, u32 gap, spot at,
    ownership_api.entity_id source_key, ownership_api.scalar_fact length) void {
    assign_reference(c, block, gap, at.local, source_key, length);
    retarget(c, c->steps_len - 1, at, at);
}

fn inspect_at(context mut* c, u32 block, u32 gap, spot at) void {
    spot_step(c, block, gap, ownership_transfer.action.inspect, at, at);
}

// A use through the reference at `at`: a dereference or an element of its referent.
fn use_at(context mut* c, u32 block, u32 gap, spot at) void {
    u64 i = spot_step(c, block, gap, ownership_transfer.action.use, at, at);
    c->steps[i].local.temporal_use = true;
}

fn escape_at(context mut* c, u32 block, u32 gap, spot at) void {
    spot_step(c, block, gap, ownership_transfer.action.escape, at, at);
}

// Del stays shallow (D17.16), as shallow_release says.
fn release_at(context mut* c, u32 block, u32 gap, spot at) void {
    u64 i = spot_step(c, block, gap, ownership_transfer.action.release, at, at);
    shallow_release(c, i, spot_type(c, at));
}

fn end_at(context mut* c, u32 block, u32 gap, spot at) void {
    u64 i = spot_step(c, block, gap, ownership_transfer.action.dead, at, at);
    c->steps[i].local.private_slot_proved = true;
    c->steps[i].local.liveness_proved = true;
}

// A step that the stored run cannot model: it stops its path with incomplete proof.
fn unsupported_at(context mut* c, u32 block, u32 gap, spot at, missing why) void {
    u64 i = spot_step(c, block, gap, ownership_transfer.action.inspect, at, at);
    c->steps[i].local.direct_source_proved = false;
    note_gap(c, why, c->steps[i].source);
}

// Begins or ends the stack source of a taken local (D17.14).
fn stack_step(context mut* c, u32 block, u32 gap, ownership_transfer.action effect,
    u32 local) void {
    u64 i = local_step(c, block, gap, effect, local, local);
    c->steps[i].local.source_key = stack_key(c, local);
    c->steps[i].local.fresh_source.key = retired_stack_key(c, local);
}

fn leaf_access(context* c, fir.place p) ownership_source_leaves.access {
    if (!c->stored) { return ownership_source_leaves.access{}; }
    return ownership_source_leaves.resolve(&c->leaves, c->function, p);
}

// Whether the place names the storage of a taken local, so its address is a stack borrow.
fn stack_address(context* c, fir.place p, fir.rvalue_kind kind) bool {
    return c->stored && p.base == fir.base_kind.bk_local && c->taken[cast(p.local, u64)] &&
        names_storage(c->function, p, kind);
}

// ---- statements -------------------------------------------------------------------------------

// The operand a write consumes as its value, or none.
struct consumed {
    bool present;
    fir.place place;
}

// Effects of one operand read that no write consumed.
fn read_operand(context mut* c, u32 block, u32 gap, fir.operand o, consumed taken) void {
    if (o.kind == fir.operand_kind.ok_const) { return; }
    if (taken.present && fir.same_base(taken.place, o.place) &&
        taken.place.proj_len == o.place.proj_len && o.place.proj_len == 0) { return; }
    access a = place_access(c, o.place);
    if (!a.tracked) {
        read_leaves(c, block, gap, o);
        return;
    }
    if (a.indirect) { dereference(c, block, gap, a.local); return; }
    if (a.length) { return; }
    if (o.kind == fir.operand_kind.ok_move) {
        local_step(c, block, gap, ownership_transfer.action.escape, a.local, a.local);
        return;
    }
    inspect(c, block, gap, a.local);
}

// The stored effects of one operand read of a TA place. A copy of a reference leaf is a
// semantic read; a move of an owning leaf leaves local proof (escape). A whole TA reads each
// reference leaf. A read through a variable index has no element to check.
fn read_leaves(context mut* c, u32 block, u32 gap, fir.operand o) void {
    ownership_source_leaves.access l = leaf_access(c, o.place);
    bool moved = o.kind == fir.operand_kind.ok_move;
    switch (l.kind) {
    case ownership_source_leaves.access_kind.none, ownership_source_leaves.access_kind.scalar,
        ownership_source_leaves.access_kind.length:
        return;
    case ownership_source_leaves.access_kind.leaf, ownership_source_leaves.access_kind.pointer:
        if (moved) { escape_at(c, block, gap, leaf_spot(c, l.first)); }
        else { inspect_at(c, block, gap, leaf_spot(c, l.first)); }
    case ownership_source_leaves.access_kind.prefix:
        u64 mut k = l.first;
        while (k < l.first + l.count) {
            spot at = leaf_spot(c, k);
            if (moved && spot_owning(c, at)) { escape_at(c, block, gap, at); }
            else { inspect_at(c, block, gap, at); }
            k += 1;
        }
    case ownership_source_leaves.access_kind.indirect:
        use_at(c, block, gap, leaf_spot(c, l.first));
    case ownership_source_leaves.access_kind.dynamic:
        // A move empties an element that the run cannot select, so the path stops there.
        if (moved) {
            unsupported_at(c, block, gap, whole(l.local), missing.dynamic_element);
        } else {
            note_gap(c, missing.dynamic_element, source(c, location(c, block, gap)));
        }
    }
}

fn whole_tracked(context* c, fir.operand o) bool {
    if (o.kind == fir.operand_kind.ok_const) { return false; }
    access a = place_access(c, o.place);
    return a.tracked && a.whole;
}

// The pattern of new(T, n): `_p = alloc<T>(n)` just before `_d = aggregate T@ own(move _p, n)`.
fn owned_span(context* c, u32 block, u32 gap, fir.rvalue r) bool {
    if (r.ops_len != 2 || gap == 0) { return false; }
    fir.operand pointer = fir.rvalue_operand(c->function, r, 0);
    fir.operand length = fir.rvalue_operand(c->function, r, 1);
    if (pointer.kind != fir.operand_kind.ok_move || !whole_tracked(c, pointer)) { return false; }
    fir.statement* before = fir.block_statement(c->function, block, gap - 1);
    if (before->kind != fir.stmt_kind.st_assign ||
        before->value.kind != fir.rvalue_kind.rv_alloc ||
        before->place.base != fir.base_kind.bk_local || before->place.proj_len != 0 ||
        before->place.local != pointer.place.local) { return false; }
    fir.operand count = fir.rvalue_operand(c->function, before->value, 0);
    if (count.kind != length.kind) { return false; }
    if (count.kind == fir.operand_kind.ok_const) {
        return count.value.kind == fir.const_kind.ck_int && length.value.kind ==
            fir.const_kind.ck_int && count.value.value.neg == length.value.value.neg &&
            count.value.value.mag == length.value.value.mag;
    }
    return count.place.base == fir.base_kind.bk_local && count.place.proj_len == 0 &&
        length.place.base == fir.base_kind.bk_local && length.place.proj_len == 0 &&
        count.place.local == length.place.local;
}

fn static_length(fir.constant k) ownership_api.scalar_fact {
    return ownership_api.scalar_fact{.kind = ownership_api.fact_kind.exact,
        .value = cast(k.text.len, i64)};
}

fn unknown_length() ownership_api.scalar_fact {
    return ownership_api.scalar_fact{.kind = ownership_api.fact_kind.unknown};
}

// The value of `rv_use` or `rv_cast` into a whole TL destination.
fn write_operand(context mut* c, u32 block, u32 gap, u32 to, fir.operand o) consumed {
    return write_operand_at(c, block, gap, whole(to), o);
}

// The value of `rv_use` or `rv_cast` into a TL or a TA leaf.
fn write_operand_at(context mut* c, u32 block, u32 gap, spot to, fir.operand o) consumed {
    fir.func* f = c->function;
    if (o.kind == fir.operand_kind.ok_const) {
        fir.const_kind k = o.value.kind;
        ownership_api.entity_id static_key = entity(c, ownership_api.entity_kind.source,
            STATIC_ORDINAL);
        if (k == fir.const_kind.ck_string || k == fir.const_kind.ck_bytes) {
            reference_at(c, block, gap, to, static_key, static_length(o.value));
        } else if (k == fir.const_kind.ck_enum_table) {
            reference_at(c, block, gap, to, static_key, unknown_length());
        } else if (k == fir.const_kind.ck_null || k == fir.const_kind.ck_zero) {
            empty_at(c, block, gap, to);
        } else {
            // An integer cast to a reference names no proved source (D17.17).
            opaque_at(c, block, gap, to, missing.unknown_source);
        }
        return consumed{};
    }
    access a = place_access(c, o.place);
    if (a.tracked && a.whole && o.kind == fir.operand_kind.ok_move) {
        move_at(c, block, gap, whole(a.local), to);
        return consumed{true, o.place};
    }
    if (a.tracked && (a.whole || a.pointer) && o.kind == fir.operand_kind.ok_copy &&
        reference_type(fir.operand_type(f, o))) {
        copy_at(c, block, gap, whole(a.local), to);
        return consumed{true, o.place};
    }
    ownership_source_leaves.access l = leaf_access(c, o.place);
    if (l.kind == ownership_source_leaves.access_kind.leaf &&
        o.kind == fir.operand_kind.ok_move) {
        move_at(c, block, gap, leaf_spot(c, l.first), to);
        return consumed{true, o.place};
    }
    if ((l.kind == ownership_source_leaves.access_kind.leaf ||
        l.kind == ownership_source_leaves.access_kind.pointer) &&
        o.kind == fir.operand_kind.ok_copy && reference_type(fir.operand_type(f, o))) {
        copy_at(c, block, gap, leaf_spot(c, l.first), to);
        return consumed{true, o.place};
    }
    // A load from storage that no TL holds, or an integer cast to a reference.
    read_operand(c, block, gap, o, consumed{});
    missing mut why = missing.unknown_source;
    if (o.kind == fir.operand_kind.ok_move || spot_owning(c, to)) {
        why = missing.owner_load;
    }
    opaque_at(c, block, gap, to, why);
    return consumed{true, o.place};
}

// The write into a whole TL destination. It returns the operand that the write consumes.
fn write_tracked(context mut* c, u32 block, u32 gap, u32 to, fir.rvalue r) consumed {
    return write_tracked_at(c, block, gap, whole(to), r);
}

// The write into a TL or a TA leaf. It returns the operand that the write consumes.
fn write_tracked_at(context mut* c, u32 block, u32 gap, spot to, fir.rvalue r) consumed {
    fir.func* f = c->function;
    if (r.kind == fir.rvalue_kind.rv_use || r.kind == fir.rvalue_kind.rv_cast) {
        return write_operand_at(c, block, gap, to, fir.rvalue_operand(f, r, 0));
    }
    if (r.kind == fir.rvalue_kind.rv_addr || r.kind == fir.rvalue_kind.rv_slice) {
        access a = place_access(c, r.place);
        if (a.tracked && (a.indirect || (a.whole && r.kind == fir.rvalue_kind.rv_slice))) {
            if (!same_referent(c, r.place, r.kind)) {
                // The place loads through the TL. Its result has no source that local proof
                // knows, so a null test of it decides nothing.
                dereference(c, block, gap, a.local);
                opaque_at(c, block, gap, to, missing.unknown_source);
                return consumed{};
            }
            copy_at(c, block, gap, whole(a.local), to);
            return consumed{true, r.place};
        }
        ownership_source_leaves.access l = leaf_access(c, r.place);
        if (l.kind == ownership_source_leaves.access_kind.indirect ||
            (l.kind == ownership_source_leaves.access_kind.leaf &&
            r.kind == fir.rvalue_kind.rv_slice)) {
            copy_at(c, block, gap, leaf_spot(c, l.first), to);
            return consumed{true, r.place};
        }
        if (stack_address(c, r.place, r.kind)) {
            // The address of local storage borrows its stack source (inline escape, D17.14).
            reference_at(c, block, gap, to, stack_key(c, r.place.local), unknown_length());
            return consumed{};
        }
        // The address of global storage is static. So is a slice of a constant global's own
        // span or string. A slice of a mutable global's span reads a reference that the run
        // does not follow, so it falls to the opaque case.
        if (r.place.base == fir.base_kind.bk_global && (names_storage(f, r.place, r.kind) ||
            tracked_reference(c, r.place, r.place.proj_len))) {
            ownership_api.entity_id static_key = entity(c, ownership_api.entity_kind.source,
                STATIC_ORDINAL);
            reference_at(c, block, gap, to, static_key, unknown_length());
            return consumed{};
        }
        opaque_at(c, block, gap, to, missing.unknown_source);
        return consumed{};
    }
    if (r.kind == fir.rvalue_kind.rv_alloc) {
        if (to.leaf != WHOLE) {
            opaque_at(c, block, gap, to, missing.unknown_source);
            return consumed{};
        }
        allocation_step(c, block, gap, to.local, fir.rvalue_operand(f, r, 0));
        return consumed{};
    }
    if (r.kind == fir.rvalue_kind.rv_slice_ptr || r.kind == fir.rvalue_kind.rv_aggregate) {
        fir.operand o = fir.rvalue_operand(f, r, 0);
        bool owned = spot_owning(c, to);
        if (r.kind == fir.rvalue_kind.rv_aggregate && owned && owned_span(c, block, gap, r)) {
            move_at(c, block, gap, whole(o.place.local), to);
            return consumed{true, o.place};
        }
        bool view = r.kind == fir.rvalue_kind.rv_slice_ptr || (!owned && r.ops_len == 2);
        if (view && o.kind == fir.operand_kind.ok_copy && whole_tracked(c, o)) {
            copy_at(c, block, gap, whole(o.place.local), to);
            return consumed{true, o.place};
        }
        ownership_source_leaves.access l = o.kind == fir.operand_kind.ok_copy ?
            leaf_access(c, o.place) : ownership_source_leaves.access{};
        if (view && (l.kind == ownership_source_leaves.access_kind.leaf ||
            l.kind == ownership_source_leaves.access_kind.pointer)) {
            copy_at(c, block, gap, leaf_spot(c, l.first), to);
            return consumed{true, o.place};
        }
        opaque_at(c, block, gap, to, missing.unknown_source);
        return consumed{};
    }
    if (r.kind == fir.rvalue_kind.rv_call && r.callee == fir.callee_kind.cl_extern) {
        if (spot_owning(c, to)) {
            opaque_at(c, block, gap, to, missing.foreign_owner);
            return consumed{};
        }
        ownership_api.entity_id foreign = entity(c, ownership_api.entity_kind.source,
            cast(c->steps_len, u32));
        reference_at(c, block, gap, to, foreign, unknown_length());
        c->steps[c->steps_len - 1].local.source_key = foreign;
        return consumed{};
    }
    opaque_at(c, block, gap, to, r.kind == fir.rvalue_kind.rv_call ? missing.fort_call :
        missing.unknown_source);
    return consumed{};
}

fn statement_effects(context mut* c, u32 block, u32 gap) void {
    fir.func* f = c->function;
    fir.statement* s = fir.block_statement(f, block, gap);
    switch (s->kind) {
    case fir.stmt_kind.st_live:
        if (c->stored && c->taken[cast(s->local, u64)]) {
            stack_step(c, block, gap, ownership_transfer.action.stack_begin, s->local);
        }
        return;
    case fir.stmt_kind.st_dead:
        // prepare already notes an owning local that is no TL and no TA.
        if (c->tracked[cast(s->local, u64)]) {
            if (c->owning[cast(s->local, u64)]) { end_step(c, block, gap, s->local); }
            else { assign_empty(c, block, gap, s->local); }
        }
        if (c->flag[cast(s->local, u64)]) {
            flag_step(c, block, gap, s->local, ownership_flow.flag_kind.clear, s->local, false);
        }
        if (c->stored) { end_storage(c, block, gap, s->local); }
        return;
    case fir.stmt_kind.st_loan_begin, fir.stmt_kind.st_loan_end:
        // The stored run binds each loan that it can prove and notes the others (prepare).
        if (!c->stored) { note_gap(c, missing.range_loan, source(c, s->loc)); }
        return;
    case fir.stmt_kind.st_del:
        access a = place_access(c, s->place);
        if (a.tracked && a.whole) {
            release_step(c, block, gap, a.local);
            return;
        }
        if (a.tracked && a.indirect) { dereference(c, block, gap, a.local); }
        ownership_source_leaves.access l = leaf_access(c, s->place);
        if (l.kind == ownership_source_leaves.access_kind.leaf) {
            release_at(c, block, gap, leaf_spot(c, l.first));
            return;
        }
        if (l.kind == ownership_source_leaves.access_kind.indirect) {
            use_at(c, block, gap, leaf_spot(c, l.first));
        }
        if (l.kind == ownership_source_leaves.access_kind.dynamic) {
            // The release of an element that the run cannot select stops the path.
            unsupported_at(c, block, gap, whole(l.local), missing.dynamic_element);
            return;
        }
        // The release ends an allocation that no slot owns. Slot owners keep their facts.
        outside_step(c, block, gap, false);
        return;
    case fir.stmt_kind.st_assign:
        assignment_effects(c, block, gap, s);
        flag_write(c, block, gap, s);
        return;
    }
}

fn assignment_effects(context mut* c, u32 block, u32 gap, fir.statement* s) void {
    fir.func* f = c->function;
    fir.rvalue r = s->value;
    access destination = place_access(c, s->place);
    bool into_tracked = destination.tracked && destination.whole;
    consumed mut taken = consumed{};
    // The write comes first when it consumes its operand; flow applies the steps in order.
    // A consumed operand is read by the copy or the move itself, before its store.
    if (r.kind == fir.rvalue_kind.rv_call) {
        if (r.callee == fir.callee_kind.cl_value) {
            read_operand(c, block, gap, r.callee_op, taken);
        }
        u64 before = c->steps_len;
        u32 mut k = 0;
        while (k < r.ops_len) {
            read_operand(c, block, gap, fir.rvalue_operand(f, r, k), taken);
            k += 1;
        }
        bool mut escaped = false;
        u64 mut at = before;
        while (at < c->steps_len) {
            if (c->steps[at].local.kind == ownership_transfer.action.escape) { escaped = true; }
            at += 1;
        }
        if (r.callee == fir.callee_kind.cl_extern) {
            call_step(c, block, gap);
            // Foreign code can release an own argument at any time after the call.
            if (escaped) { outside_step(c, block, gap, false); }
        } else {
            outside_step(c, block, gap, true);
        }
        if (into_tracked) { write_tracked(c, block, gap, destination.local, r); }
        else if (destination.tracked && destination.indirect) {
            dereference(c, block, gap, destination.local);
        } else if (c->stored) { call_into_leaves(c, block, gap, s); }
        if (!into_tracked && stored_untracked(c, s->place) && stores_stack_borrow(c, r)) {
            // A callee can return its argument, so the result can hold a stack borrow.
            note_gap(c, missing.escape, source(c, s->loc));
        }
        if (!into_tracked && r.callee == fir.callee_kind.cl_extern &&
            owning_type(fir.place_type(f, s->place))) {
            note_gap(c, missing.foreign_owner, source(c, s->loc));
        }
        return;
    }
    if (into_tracked) {
        write_tracked_after_reads(c, block, gap, destination.local, r);
        return;
    }
    if (c->stored && store_into_leaves(c, block, gap, s)) { return; }
    if (r.kind == fir.rvalue_kind.rv_addr || r.kind == fir.rvalue_kind.rv_slice) {
        access a = place_access(c, r.place);
        if (a.tracked && (a.indirect || (a.whole && r.kind == fir.rvalue_kind.rv_slice))) {
            if (same_referent(c, r.place, r.kind)) { inspect(c, block, gap, a.local); }
            else { dereference(c, block, gap, a.local); }
        }
        ownership_source_leaves.access l = leaf_access(c, r.place);
        if (l.kind == ownership_source_leaves.access_kind.indirect ||
            (l.kind == ownership_source_leaves.access_kind.leaf &&
            r.kind == fir.rvalue_kind.rv_slice)) {
            inspect_at(c, block, gap, leaf_spot(c, l.first));
        }
    }
    if (r.kind == fir.rvalue_kind.rv_alloc) {
        note_gap(c, missing.escape, source(c, s->loc));
    }
    u32 mut k = 0;
    while (k < r.ops_len) {
        read_operand(c, block, gap, fir.rvalue_operand(f, r, k), taken);
        k += 1;
    }
    if (destination.tracked && destination.indirect) {
        dereference(c, block, gap, destination.local);
    }
    if (destination.tracked && !destination.whole && !destination.indirect) {
        unsupported(c, block, gap, destination.local, missing.unknown_source);
    }
    ownership_source_leaves.access into = leaf_access(c, s->place);
    if (into.kind == ownership_source_leaves.access_kind.indirect) {
        use_at(c, block, gap, leaf_spot(c, into.first));
    }
    if (stored_untracked(c, s->place) && stores_stack_borrow(c, r)) {
        // A stack borrow in storage that the run does not track can outlive its local.
        note_gap(c, missing.escape, source(c, s->loc));
    }
}

// ---- stored writes ----------------------------------------------------------------------------

// Ends the storage of local `n` in the stored run: each owning leaf of a TA needs an empty
// owner, each borrowed leaf is cleared, and the stack source of a taken local ends (D17.14).
fn end_storage(context mut* c, u32 block, u32 gap, u32 n) void {
    u64 at = cast(n, u64);
    if (c->leaves.aggregate[at]) {
        u64 mut k = c->leaves.first[at];
        while (k < c->leaves.first[at] + c->leaves.count[at]) {
            spot leaf = leaf_spot(c, k);
            if (spot_owning(c, leaf)) { end_at(c, block, gap, leaf); }
            else { empty_at(c, block, gap, leaf); }
            k += 1;
        }
    }
    if (c->taken[at]) {
        stack_step(c, block, gap, ownership_transfer.action.stack_end, n);
    }
}

// The result of a call into a TA place. A fort call result is unknown to the stored run, and
// a foreign aggregate result has no leaf facts here (D17.13 applies to reference results).
fn call_into_leaves(context mut* c, u32 block, u32 gap, fir.statement* s) void {
    fir.rvalue r = s->value;
    ownership_source_leaves.access l = leaf_access(c, s->place);
    switch (l.kind) {
    case ownership_source_leaves.access_kind.none, ownership_source_leaves.access_kind.scalar,
        ownership_source_leaves.access_kind.length:
        return;
    case ownership_source_leaves.access_kind.leaf:
        write_tracked_at(c, block, gap, leaf_spot(c, l.first), r);
    case ownership_source_leaves.access_kind.prefix:
        missing why = r.callee == fir.callee_kind.cl_extern ? missing.foreign_owner :
            missing.fort_call;
        u64 mut k = l.first;
        while (k < l.first + l.count) {
            opaque_at(c, block, gap, leaf_spot(c, k), why);
            k += 1;
        }
    case ownership_source_leaves.access_kind.indirect:
        use_at(c, block, gap, leaf_spot(c, l.first));
    case ownership_source_leaves.access_kind.pointer:
        unsupported_at(c, block, gap, whole(l.local), missing.unknown_source);
    case ownership_source_leaves.access_kind.dynamic:
        unsupported_at(c, block, gap, whole(l.local), missing.dynamic_element);
    }
}

// Whether the rvalue reads a place of local `n`. An aggregate write that reads its own
// destination reads the old value first (fir.md 6), which leaf-by-leaf steps cannot keep.
fn reads_local(context* c, fir.rvalue r, u32 n) bool {
    u32 mut k = 0;
    while (k < r.ops_len) {
        fir.operand o = fir.rvalue_operand(c->function, r, k);
        if (o.kind != fir.operand_kind.ok_const && o.place.base == fir.base_kind.bk_local &&
            o.place.local == n) { return true; }
        k += 1;
    }
    return false;
}

// A store into a TA place: one leaf, a part with leaves, or an element that a variable index
// selects. False when the place holds no leaf, so the caller reads the operands.
fn store_into_leaves(context mut* c, u32 block, u32 gap, fir.statement* s) bool {
    fir.func* f = c->function;
    fir.rvalue r = s->value;
    ownership_source_leaves.access l = leaf_access(c, s->place);
    switch (l.kind) {
    case ownership_source_leaves.access_kind.none, ownership_source_leaves.access_kind.scalar,
        ownership_source_leaves.access_kind.length, ownership_source_leaves.access_kind.indirect:
        return false;
    case ownership_source_leaves.access_kind.leaf:
        write_after_reads_at(c, block, gap, leaf_spot(c, l.first), r);
    case ownership_source_leaves.access_kind.prefix:
        write_prefix(c, block, gap, l, s);
    case ownership_source_leaves.access_kind.pointer:
        read_all(c, block, gap, r);
        unsupported_at(c, block, gap, whole(l.local), missing.unknown_source);
    case ownership_source_leaves.access_kind.dynamic:
        if (l.elements && (r.kind == fir.rvalue_kind.rv_use ||
            r.kind == fir.rvalue_kind.rv_cast) && r.ops_len == 1) {
            weak_store_step(c, block, gap, l, fir.rvalue_operand(f, r, 0));
        } else {
            read_all(c, block, gap, r);
            unsupported_at(c, block, gap, whole(l.local), missing.dynamic_element);
        }
    }
    return true;
}

fn read_all(context mut* c, u32 block, u32 gap, fir.rvalue r) void {
    u32 mut k = 0;
    while (k < r.ops_len) {
        read_operand(c, block, gap, fir.rvalue_operand(c->function, r, k), consumed{});
        k += 1;
    }
}

// A whole aggregate value into the leaves [first, first + count) of a TA: the leaves of a
// TA place, `zero`, or unknown contents. V4 makes the operand agree with the destination type,
// so the leaves of the two places correspond in order.
fn write_value(context mut* c, u32 block, u32 gap, u64 first, u64 count, fir.operand o)
    void {
    if (o.kind == fir.operand_kind.ok_const && o.value.kind == fir.const_kind.ck_zero) {
        u64 mut k = first;
        while (k < first + count) { empty_at(c, block, gap, leaf_spot(c, k)); k += 1; }
        return;
    }
    ownership_source_leaves.access l = o.kind == fir.operand_kind.ok_const ?
        ownership_source_leaves.access{} : leaf_access(c, o.place);
    if (l.kind == ownership_source_leaves.access_kind.prefix && l.count == count) {
        u64 mut j = 0;
        while (j < count) {
            spot from = leaf_spot(c, l.first + j);
            spot to = leaf_spot(c, first + j);
            if (o.kind == fir.operand_kind.ok_move) { move_at(c, block, gap, from, to); }
            else { copy_at(c, block, gap, from, to); }
            j += 1;
        }
        return;
    }
    read_operand(c, block, gap, o, consumed{});
    missing why = o.kind == fir.operand_kind.ok_move ? missing.owner_load : missing.unknown_source;
    u64 mut k = first;
    while (k < first + count) { opaque_at(c, block, gap, leaf_spot(c, k), why); k += 1; }
}

// A store into a TA part that holds the leaves of `into`. An aggregate literal gives each
// member to its own leaves; a whole value copies or moves leaf by leaf. A write that reads its
// own destination, a cast between aggregate types and any other rvalue give unknown leaves.
fn write_prefix(context mut* c, u32 block, u32 gap, ownership_source_leaves.access into,
    fir.statement* s) void {
    fir.func* f = c->function;
    fir.rvalue r = s->value;
    if (reads_local(c, r, into.local) || (r.kind != fir.rvalue_kind.rv_aggregate &&
        r.kind != fir.rvalue_kind.rv_use)) {
        read_all(c, block, gap, r);
        u64 mut k = into.first;
        while (k < into.first + into.count) {
            opaque_at(c, block, gap, leaf_spot(c, k), missing.unknown_source);
            k += 1;
        }
        return;
    }
    if (r.kind == fir.rvalue_kind.rv_use) {
        write_value(c, block, gap, into.first, into.count, fir.rvalue_operand(f, r, 0));
        return;
    }
    types.node* t = fir.place_type(f, s->place);
    u64 mut at = into.first;
    u32 mut k = 0;
    while (k < r.ops_len) {
        types.node* member = t->kind == types.type_kind.k_struct ?
            fir.struct_field_type(t, k) : t->elem;
        u64 count = ownership_source_leaves.count_leaves(member, 0);
        fir.operand o = fir.rvalue_operand(f, r, k);
        if (count == 0) {
            read_operand(c, block, gap, o, consumed{});
        } else if (reference_type(member)) {
            write_operand_at(c, block, gap, leaf_spot(c, at), o);
        } else {
            write_value(c, block, gap, at, count, o);
        }
        at += count;
        k += 1;
    }
}

// A store of one reference element that a variable index selects: a weak store over each
// element of the actual array (D17.15). The value is a constant, a TL or a TA leaf; any
// other value is unknown.
fn weak_store_step(context mut* c, u32 block, u32 gap, ownership_source_leaves.access into,
    fir.operand o) void {
    fir.func* f = c->function;
    spot mut from = whole(into.local);
    bool mut moves = false;
    ownership_api.contents_fact mut value = ownership_api.contents_fact{};
    bool mut opaque_value = false;
    ownership_api.borrow_relation mut relation = ownership_api.borrow_relation{};
    if (o.kind == fir.operand_kind.ok_const) {
        fir.const_kind k = o.value.kind;
        if (k == fir.const_kind.ck_null || k == fir.const_kind.ck_zero) {
            value.kind = ownership_api.contents_kind.empty_owner;
            value.owner_empty = true;
            value.span_length.kind = ownership_api.fact_kind.exact;
        } else if (k == fir.const_kind.ck_string || k == fir.const_kind.ck_bytes) {
            value.kind = ownership_api.contents_kind.reference;
            value.span_length = static_length(o.value);
            relation.source = entity(c, ownership_api.entity_kind.source, STATIC_ORDINAL);
        } else {
            opaque_value = true;
        }
    } else {
        access a = place_access(c, o.place);
        ownership_source_leaves.access l = leaf_access(c, o.place);
        if (a.tracked && a.whole) {
            from = whole(a.local);
        } else if (l.kind == ownership_source_leaves.access_kind.leaf) {
            from = leaf_spot(c, l.first);
        } else {
            read_operand(c, block, gap, o, consumed{});
            opaque_value = true;
        }
        moves = !opaque_value && o.kind == fir.operand_kind.ok_move;
    }
    u64 i = local_step(c, block, gap, ownership_transfer.action.weak_store, from.local,
        into.local);
    retarget(c, i, from, whole(into.local));
    ownership_transfer.request mut* req = &c->steps[i].local;
    req->leaf_places_proved = true;
    req->weak_guard = entity(c, ownership_api.entity_kind.guard, key_ordinal(i));
    req->weak_moves = moves;
    req->opaque_value = opaque_value;
    req->destination_owns = owning_type(c->leaves.leaves[into.first].ty);
    if (opaque_value) { note_gap(c, missing.unknown_source, c->steps[i].source); }
    if (relation.source.kind == ownership_api.entity_kind.source) {
        ownership_api.entity_id version = value_of(c, i);
        c->relations[i] = ownership_api.borrow_relation{.key = entity(c,
            ownership_api.entity_kind.relation, key_ordinal(i)), .value_version = version,
            .containing = slot(c, into.local), .source = relation.source,
            .representation_complete = true};
        value.value_version = version;
    } else if (value.kind == ownership_api.contents_kind.empty_owner) {
        value.value_version = value_of(c, i);
    }
    req->value = value;
    // The places of the elements. Link gives the request a view of them.
    u64 needed = c->weak_places_len + into.count;
    if (needed > c->weak_places.len) {
        ownership_api.place_path mut@ own bigger = new(ownership_api.place_path, needed * 2);
        u64 mut j = 0;
        while (j < c->weak_places_len) { bigger[j] = c->weak_places[j]; j += 1; }
        del(c->weak_places);
        c->weak_places = move(bigger);
    }
    c->extras[i].weak_first = c->weak_places_len;
    c->extras[i].weak_count = into.count;
    u64 mut k = 0;
    while (k < into.count) {
        c->weak_places[c->weak_places_len] = spot_place(c, leaf_spot(c, into.first + k));
        c->weak_places_len += 1;
        k += 1;
    }
}

// ---- stack borrows ---------------------------------------------------------------------------

// Whether a stored-run write into `p` goes to storage that the run does not track, and the
// place can hold a reference: heap through a pointer, a global, or a taken local.
fn stored_untracked(context* c, fir.place p) bool {
    if (!c->stored) { return false; }
    access a = place_access(c, p);
    if (a.tracked && a.whole) { return false; }
    ownership_source_leaves.access l = leaf_access(c, p);
    return (l.kind == ownership_source_leaves.access_kind.none ||
        l.kind == ownership_source_leaves.access_kind.indirect) &&
        reference_leaf(fir.place_type(c->function, p));
}

// A unit is a TL (its local number) or a TA leaf (the local count plus the leaf index).
fn leaf_unit(context* c, u64 k) u64 { return cast(fir.local_count(c->function), u64) + k; }

// Appends the units whose value an operand place carries: a whole TL or its pointer field, a
// leaf or its pointer field, or each leaf of a TA part. A value loaded through a reference
// carries none of them.
fn value_units(context* c, fir.place p, u64 mut@ out, u64 mut* len) void {
    access a = place_access(c, p);
    if (a.tracked && (a.whole || a.pointer)) {
        out[*len] = cast(a.local, u64);
        *len += 1;
        return;
    }
    ownership_source_leaves.access l = leaf_access(c, p);
    if (l.kind == ownership_source_leaves.access_kind.leaf ||
        l.kind == ownership_source_leaves.access_kind.pointer ||
        l.kind == ownership_source_leaves.access_kind.prefix) {
        u64 mut k = l.first;
        while (k < l.first + l.count) {
            out[*len] = leaf_unit(c, k);
            *len += 1;
            k += 1;
        }
    }
}

// Appends the units of a view that `addr` or `slice` takes through a reference: the TL or the
// leaf that it loads.
fn view_units(context* c, fir.rvalue r, u64 mut@ out, u64 mut* len) void {
    if (r.kind != fir.rvalue_kind.rv_addr && r.kind != fir.rvalue_kind.rv_slice) { return; }
    access a = place_access(c, r.place);
    if (a.tracked && (a.indirect || (a.whole && r.kind == fir.rvalue_kind.rv_slice))) {
        out[*len] = cast(a.local, u64);
        *len += 1;
        return;
    }
    ownership_source_leaves.access l = leaf_access(c, r.place);
    if (l.kind == ownership_source_leaves.access_kind.indirect ||
        (l.kind == ownership_source_leaves.access_kind.leaf &&
        r.kind == fir.rvalue_kind.rv_slice)) {
        out[*len] = leaf_unit(c, l.first);
        *len += 1;
    }
}

// The units that a write fills: a whole TL, a leaf, the leaves of a TA part, or the elements
// that a variable index can select.
fn write_units(context* c, fir.place p, u64 mut@ out, u64 mut* len) void {
    access a = place_access(c, p);
    if (a.tracked && a.whole) {
        out[*len] = cast(a.local, u64);
        *len += 1;
        return;
    }
    ownership_source_leaves.access l = leaf_access(c, p);
    if (l.kind == ownership_source_leaves.access_kind.leaf ||
        l.kind == ownership_source_leaves.access_kind.prefix ||
        (l.kind == ownership_source_leaves.access_kind.dynamic && l.elements)) {
        u64 mut k = l.first;
        while (k < l.first + l.count) {
            out[*len] = leaf_unit(c, k);
            *len += 1;
            k += 1;
        }
    }
}

// Collects the units that one assignment reads into `from` and fills into `to`. It returns
// true when the rvalue takes the address of local storage itself.
fn assignment_units(context* c, fir.statement* s, u64 mut@ from, u64 mut* from_len,
    u64 mut@ to, u64 mut* to_len) bool {
    fir.rvalue r = s->value;
    *from_len = 0;
    *to_len = 0;
    write_units(c, s->place, to, to_len);
    view_units(c, r, from, from_len);
    u32 mut k = 0;
    while (k < r.ops_len) {
        fir.operand o = fir.rvalue_operand(c->function, r, k);
        if (o.kind != fir.operand_kind.ok_const) { value_units(c, o.place, from, from_len); }
        k += 1;
    }
    return (r.kind == fir.rvalue_kind.rv_addr || r.kind == fir.rvalue_kind.rv_slice) &&
        stack_address(c, r.place, r.kind);
}

// The largest unit list of one assignment: the leaves of its operands and of its destination.
fn units_bound(context* c, fir.statement* s) u64 {
    u64 each = ownership_source_leaves.MAX_LEAVES + 1;
    return each * (cast(s->value.ops_len, u64) + 2);
}

// A growing list of directed edges between search nodes.
struct edge_list {
    u64 mut@ own from;
    u64 mut@ own to;
    u64 len;
}

fn add_edge(edge_list mut* edges, u64 from, u64 to) void {
    if (edges->len == edges->from.len) {
        u64 cap = edges->from.len * 2 + 16;
        u64 mut@ own wider_from = new(u64, cap);
        u64 mut@ own wider_to = new(u64, cap);
        u64 mut e = 0;
        while (e < edges->len) {
            wider_from[e] = edges->from[e];
            wider_to[e] = edges->to[e];
            e += 1;
        }
        del(edges->from);
        del(edges->to);
        edges->from = move(wider_from);
        edges->to = move(wider_to);
    }
    edges->from[edges->len] = from;
    edges->to[edges->len] = to;
    edges->len += 1;
}

// Marks each TL and TA leaf that can hold a borrow of local storage: the address of a taken
// local, and every value that a copy, a move, a view or a call result derives from such a
// unit. A call result counts because a callee can return its argument. Each assignment is a
// hub node: its read units lead to the hub and the hub leads to its written units, so an
// assignment adds as many edges as it has units. One pass over the statements builds the
// edges, and one search over them marks the units: the work is linear in the FIR size and the
// leaf count, with no fixed point over the statements.
fn stack_borrows(context mut* c) void {
    fir.func* f = c->function;
    u64 units = leaf_unit(c, c->leaves.leaves_len);
    u64 mut assigns = 0;
    u32 mut b = 0;
    while (b < fir.block_count(f)) {
        u32 mut i = 0;
        while (i < fir.block_statement_count(f, b)) {
            if (fir.block_statement(f, b, i)->kind == fir.stmt_kind.st_assign) { assigns += 1; }
            i += 1;
        }
        b += 1;
    }
    u64 nodes = units + assigns;
    c->stack_units = new(bool, units);
    bool mut@ own marked = new(bool, nodes);
    defer del(marked);
    edge_list mut edges = edge_list{.from = new(u64, 0), .to = new(u64, 0)};
    defer del(edges.from);
    defer del(edges.to);
    u64 mut@ own seeds = new(u64, nodes + 1);
    defer del(seeds);
    u64 mut seeds_len = 0;
    u64 mut@ own mut from = new(u64, 0);
    u64 mut@ own mut to = new(u64, 0);
    defer del(from);
    defer del(to);
    u64 mut hub = units;
    b = 0;
    while (b < fir.block_count(f)) {
        u32 mut i = 0;
        while (i < fir.block_statement_count(f, b)) {
            fir.statement* s = fir.block_statement(f, b, i);
            if (s->kind == fir.stmt_kind.st_assign) {
                u64 bound = units_bound(c, s);
                if (bound > from.len) {
                    del(from);
                    del(to);
                    from = new(u64, bound);
                    to = new(u64, bound);
                }
                u64 mut from_len = 0;
                u64 mut to_len = 0;
                bool seeded = assignment_units(c, s, from, &from_len, to, &to_len);
                if (to_len > 0) {
                    if (seeded) {
                        marked[hub] = true;
                        seeds[seeds_len] = hub;
                        seeds_len += 1;
                    }
                    u64 mut x = 0;
                    while (x < from_len) { add_edge(&edges, from[x], hub); x += 1; }
                    u64 mut t = 0;
                    while (t < to_len) { add_edge(&edges, hub, to[t]); t += 1; }
                }
                hub += 1;
            }
            i += 1;
        }
        b += 1;
    }
    // The edges in order of their source node (a counting sort), then a search from the seeds.
    u64 mut@ own start = new(u64, nodes + 1);
    defer del(start);
    u64 mut e = 0;
    while (e < edges.len) { start[edges.from[e] + 1] += 1; e += 1; }
    u64 mut n = 0;
    while (n < nodes) { start[n + 1] += start[n]; n += 1; }
    u64 mut@ own fill = new(u64, nodes + 1);
    defer del(fill);
    u64 mut@ own targets = new(u64, edges.len + 1);
    defer del(targets);
    e = 0;
    while (e < edges.len) {
        u64 origin = edges.from[e];
        targets[start[origin] + fill[origin]] = edges.to[e];
        fill[origin] += 1;
        e += 1;
    }
    u64 mut next = 0;
    while (next < seeds_len) {
        u64 at = seeds[next];
        next += 1;
        u64 mut j = start[at];
        while (j < start[at + 1]) {
            u64 reached = targets[j];
            if (!marked[reached]) {
                marked[reached] = true;
                seeds[seeds_len] = reached;
                seeds_len += 1;
            }
            j += 1;
        }
    }
    n = 0;
    while (n < units) { c->stack_units[n] = marked[n]; n += 1; }
}

// Whether an operand place carries a unit that can hold a stack borrow.
fn holds_stack_borrow(context* c, fir.place p) bool {
    if (c->stack_units.len == 0) { return false; }
    access a = place_access(c, p);
    if (a.tracked && (a.whole || a.pointer)) { return c->stack_units[cast(a.local, u64)]; }
    ownership_source_leaves.access l = leaf_access(c, p);
    if (l.kind != ownership_source_leaves.access_kind.leaf &&
        l.kind != ownership_source_leaves.access_kind.pointer &&
        l.kind != ownership_source_leaves.access_kind.prefix) { return false; }
    u64 mut k = l.first;
    while (k < l.first + l.count) {
        if (c->stack_units[leaf_unit(c, k)]) { return true; }
        k += 1;
    }
    return false;
}

// Whether the rvalue stores a stack borrow: the address of local storage, a view through a
// unit that can hold one, or an operand that carries one.
fn stores_stack_borrow(context* c, fir.rvalue r) bool {
    if (c->stack_units.len == 0) { return false; }
    if ((r.kind == fir.rvalue_kind.rv_addr || r.kind == fir.rvalue_kind.rv_slice) &&
        stack_address(c, r.place, r.kind)) { return true; }
    u64[2] mut views = {0, 0};
    u64 mut views_len = 0;
    view_units(c, r, views[..], &views_len);
    u64 mut v = 0;
    while (v < views_len) {
        if (c->stack_units[views[v]]) { return true; }
        v += 1;
    }
    u32 mut k = 0;
    while (k < r.ops_len) {
        fir.operand o = fir.rvalue_operand(c->function, r, k);
        if (o.kind != fir.operand_kind.ok_const && holds_stack_borrow(c, o.place)) {
            return true;
        }
        k += 1;
    }
    return false;
}


// The operands that the write does not consume are read before it, in FIR order. The write
// reads the consumed operand itself, so the operand keeps its place before the store.
fn write_tracked_after_reads(context mut* c, u32 block, u32 gap, u32 to, fir.rvalue r) void {
    write_after_reads_at(c, block, gap, whole(to), r);
}

fn write_after_reads_at(context mut* c, u32 block, u32 gap, spot to, fir.rvalue r) void {
    fir.func* f = c->function;
    bool first_value = r.kind == fir.rvalue_kind.rv_use || r.kind == fir.rvalue_kind.rv_cast ||
        r.kind == fir.rvalue_kind.rv_slice_ptr || r.kind == fir.rvalue_kind.rv_aggregate;
    u32 mut k = 0;
    while (k < r.ops_len) {
        if (k > 0 || !first_value) {
            read_operand(c, block, gap, fir.rvalue_operand(f, r, k), consumed{});
        }
        k += 1;
    }
    consumed taken = write_tracked_at(c, block, gap, to, r);
    if (first_value && r.ops_len > 0 && !taken.present) {
        read_operand(c, block, gap, fir.rvalue_operand(f, r, 0), consumed{});
    }
}

fn terminator_effects(context mut* c, u32 block) void {
    fir.func* f = c->function;
    fir.block* b = fir.block_at(f, block);
    u32 gap = fir.block_statement_count(f, block);
    if (b->term.kind == fir.term_kind.tk_return) {
        u32 mut n = 1;
        while (n < fir.local_count(f)) {
            fir.local* l = fir.local_at(f, n);
            if (c->tracked[cast(n, u64)] && c->owning[cast(n, u64)] &&
                l->kind != fir.local_kind.lk_param) { end_step(c, block, gap, n); }
            n += 1;
        }
        if (c->stored) { return_storage(c, block, gap); }
        return;
    }
    if (b->term.kind == fir.term_kind.tk_check_overwrite) { return; }
    consumed none = consumed{};
    if (b->term.kind == fir.term_kind.tk_switch || b->term.kind == fir.term_kind.tk_check) {
        read_operand(c, block, gap, b->term.cond, none);
    }
    if (b->term.kind == fir.term_kind.tk_switch) { switch_flag_edges(c, block); }
    if (b->term.kind == fir.term_kind.tk_check || b->term.kind == fir.term_kind.tk_fail) {
        u32 mut k = 0;
        while (k < b->term.args_len) {
            read_operand(c, block, gap, fir.operand_at(f, b->term.args_first + k), none);
            k += 1;
        }
    }
}

// Each return ends the owning leaves of each TA that is no parameter, and the stack source of
// each taken local, parameters included (D17.14, D17.15). The flow then checks the returned
// borrows against those ends.
fn return_storage(context mut* c, u32 block, u32 gap) void {
    fir.func* f = c->function;
    u32 mut n = 1;
    while (n < fir.local_count(f)) {
        u64 at = cast(n, u64);
        if (c->leaves.aggregate[at] && fir.local_at(f, n)->kind != fir.local_kind.lk_param) {
            u64 mut k = c->leaves.first[at];
            while (k < c->leaves.first[at] + c->leaves.count[at]) {
                spot leaf = leaf_spot(c, k);
                if (spot_owning(c, leaf)) { end_at(c, block, gap, leaf); }
                k += 1;
            }
        }
        if (c->taken[at]) { stack_step(c, block, gap, ownership_transfer.action.stack_end, n); }
        n += 1;
    }
}

// ---- entry facts ------------------------------------------------------------------------------

fn add_source(context mut* c, ownership_api.entity_id key, ownership_api.source_kind kind) void {
    ownership_state.append_sources(&c->entry, ownership_api.source_fact{.key = key,
        .kind = kind, .validity = ownership_api.validity_kind.live});
}

fn entry_facts(context mut* c) void {
    c->entry = ownership_state.empty();
    add_source(c, entity(c, ownership_api.entity_kind.source, STATIC_ORDINAL),
        ownership_api.source_kind.static_storage);
    u64 mut i = 0;
    while (i < c->steps_len) {
        ownership_flow.step s = c->steps[i];
        if (s.kind == ownership_flow.step_kind.local_effect &&
            s.local.kind == ownership_transfer.action.assignment &&
            s.local.source_key.kind == ownership_api.entity_kind.source) {
            add_source(c, s.local.source_key, ownership_api.source_kind.trusted_foreign);
        }
        i += 1;
    }
    u32 mut n = 1;
    while (n < fir.local_count(c->function)) {
        fir.local* l = fir.local_at(c->function, n);
        if (l->kind == fir.local_kind.lk_param) { parameter_facts(c, n, l); }
        // The storage of a taken local is live at entry. A `live` marker begins it again, and
        // the retired source holds the borrows of its ended instances.
        if (c->stored && c->taken[cast(n, u64)]) {
            add_source(c, stack_key(c, n), ownership_api.source_kind.stack);
            ownership_state.append_sources(&c->entry, ownership_api.source_fact{
                .key = retired_stack_key(c, n), .kind = ownership_api.source_kind.stack,
                .validity = ownership_api.validity_kind.ended});
        }
        n += 1;
    }
}

fn parameter_facts(context mut* c, u32 n, fir.local* l) void {
    ownership_api.source_position at = source(c, l->loc);
    if (owning_type(l->ty)) {
        note_gap(c, missing.own_parameter, at);
        return;
    }
    if (c->stored && c->leaves.aggregate[cast(n, u64)]) {
        parameter_leaves(c, n);
        return;
    }
    if (!c->tracked[cast(n, u64)]) { return; }
    u32 ordinal = PARAMETER_BASE + n;
    ownership_api.entity_id caller = entity(c, ownership_api.entity_kind.source, ordinal);
    add_source(c, caller, ownership_api.source_kind.symbolic_caller);
    ownership_api.entity_id version = entity(c, ownership_api.entity_kind.value, ordinal);
    ownership_api.borrow_relation[1] relation = {ownership_api.borrow_relation{
        .key = entity(c, ownership_api.entity_kind.relation, ordinal), .value_version = version,
        .containing = slot(c, n), .source = caller, .representation_complete = true}};
    ownership_api.contents_fact mut value = ownership_api.contents_fact{};
    value.place = slot(c, n);
    value.kind = ownership_api.contents_kind.reference;
    value.value_version = version;
    value.borrows = relation[..];
    value.span_length = ownership_api.scalar_fact{.kind = ownership_api.fact_kind.symbolic,
        .symbol = version};
    ownership_state.append_contents(&c->entry, value);
}

// Each borrowed leaf of a TA parameter borrows a symbolic caller source of its own: the
// referents of two leaves are separate caller facts (D17.15). An owning leaf made the whole
// parameter the gap `own_parameter`, so no leaf here owns.
fn parameter_leaves(context mut* c, u32 n) void {
    u64 at = cast(n, u64);
    u64 mut k = c->leaves.first[at];
    while (k < c->leaves.first[at] + c->leaves.count[at]) {
        u32 ordinal = leaf_parameter_ordinal(c, k);
        ownership_api.entity_id caller = entity(c, ownership_api.entity_kind.source, ordinal);
        add_source(c, caller, ownership_api.source_kind.symbolic_caller);
        ownership_api.entity_id version = entity(c, ownership_api.entity_kind.value, ordinal);
        ownership_api.place_path place = spot_place(c, leaf_spot(c, k));
        ownership_api.borrow_relation[1] relation = {ownership_api.borrow_relation{
            .key = entity(c, ownership_api.entity_kind.relation, ordinal),
            .value_version = version, .containing = place, .source = caller,
            .representation_complete = true}};
        ownership_api.contents_fact mut value = ownership_api.contents_fact{};
        value.place = place;
        value.kind = ownership_api.contents_kind.reference;
        value.value_version = version;
        value.borrows = relation[..];
        value.span_length = ownership_api.scalar_fact{.kind = ownership_api.fact_kind.symbolic,
            .symbol = version};
        ownership_state.append_contents(&c->entry, value);
        k += 1;
    }
}

// ---- flow bindings ----------------------------------------------------------------------------

fn grow_events(context mut* c, u64 need) void {
    if (need <= c->events.len) { return; }
    u64 cap = need + c->events.len;
    ownership_flow.event_binding mut@ own events = new(ownership_flow.event_binding, cap);
    binding_info mut@ own info = new(binding_info, cap);
    u64 mut i = 0;
    while (i < c->events_len) {
        events[i] = c->events[i];
        info[i] = c->event_info[i];
        i += 1;
    }
    del(c->events);
    del(c->event_info);
    c->events = move(events);
    c->event_info = move(info);
}

fn bind(context mut* c, ownership_api.operation_position op, ownership_api.event_kind kind,
    ownership_api.entity_id relation, u32 block, bool at_return) void {
    grow_events(c, c->events_len + 1);
    u32 ordinal = key_ordinal(c->steps_len + c->events_len);
    c->events[c->events_len] = ownership_flow.event_binding{op, kind, relation,
        entity(c, ownership_api.entity_kind.event, ordinal)};
    c->event_info[c->events_len] = binding_info{block, at_return};
    c->events_len += 1;
}

fn flow_bindings(context mut* c) void {
    fir.func* f = c->function;
    u32 mut block = 0;
    while (block < fir.block_count(f)) {
        if (fir.block_at(f, block)->term.kind == fir.term_kind.tk_return) {
            u32 gap = fir.block_statement_count(f, block);
            ownership_api.operation_position op = position(c, block, gap);
            bind(c, op, ownership_api.event_kind.incomplete_proof, ownership_api.entity_id{},
                block, true);
            if (c->result_slot.kind == ownership_api.entity_kind.slot) {
                u64 mut i = 0;
                while (i < c->entry.sources_len) {
                    ownership_api.entity_id key = c->entry.sources[i].key;
                    bind(c, op, ownership_api.event_kind.invalid_use, key, block, true);
                    bind(c, op, ownership_api.event_kind.incomplete_proof, key, block, true);
                    i += 1;
                }
                i = 0;
                while (i < c->steps_len) {
                    ownership_flow.step s = c->steps[i];
                    if (s.kind == ownership_flow.step_kind.local_effect &&
                        s.local.kind == ownership_transfer.action.allocation) {
                        ownership_api.entity_id key = s.local.fresh_source.key;
                        bind(c, op, ownership_api.event_kind.invalid_use, key, block, true);
                        bind(c, op, ownership_api.event_kind.incomplete_proof, key, block, true);
                        ownership_api.entity_id earlier = s.earlier.source;
                        bind(c, op, ownership_api.event_kind.invalid_use, earlier, block, true);
                        bind(c, op, ownership_api.event_kind.incomplete_proof, earlier, block,
                            true);
                    }
                    i += 1;
                }
            }
        }
        block += 1;
    }
    u64 mut i = 0;
    while (i < c->steps_len) {
        ownership_flow.step s = c->steps[i];
        if (s.kind == ownership_flow.step_kind.local_effect &&
            s.local.kind == ownership_transfer.action.allocation) {
            bind(c, s.operation, ownership_api.event_kind.incomplete_proof,
                s.local.allocation.key, s.block, false);
        }
        if (s.kind == ownership_flow.step_kind.call_outcome) {
            bind(c, s.operation, ownership_api.event_kind.incomplete_proof,
                ownership_api.entity_id{}, s.block, false);
        }
        i += 1;
    }
}

// The step arrays reached their final addresses. Each request names its own entries.
fn link(context mut* c) void {
    u64 mut i = 0;
    while (i < c->steps_len) {
        ownership_transfer.request mut* r = &c->steps[i].local;
        r->event_bindings = c->step_events[i..i + 1];
        if (c->relations[i].key.kind == ownership_api.entity_kind.relation) {
            r->value.borrows = c->relations[i..i + 1];
        }
        if (c->steps[i].kind == ownership_flow.step_kind.call_outcome) {
            c->steps[i].outcomes = c->trusted_return[..];
        }
        if (r->kind == ownership_transfer.action.weak_store) {
            u64 first = c->extras[i].weak_first;
            r->weak_places = c->weak_places[first..first + c->extras[i].weak_count];
        }
        i += 1;
    }
}

// ---- untracked loads ----------------------------------------------------------------------------

// Whether the reference at the first `depth` projections of `p` is one that the run tracks: a
// whole TL or its pointer field, a TA leaf or its pointer field (stored run), or the constant
// initializer of a global that no code can write, reached with no dereference before it. A
// variable index on the way to a TA leaf is the gap dynamic_element of the steps instead.
fn tracked_reference(context* c, fir.place p, u32 depth) bool {
    fir.place mut prefix = p;
    prefix.proj_len = depth;
    if (p.base == fir.base_kind.bk_global) {
        // A constant global holds its constant initializer: null, static storage, or the
        // address of other global storage (D7.10). Only that reference is constant: one that
        // the prefix reaches through it can sit in mutable storage (`**GP` for `GP = &GM`).
        return !p.global->mut0 && !fir.place_indirect(c->function, prefix);
    }
    u64 n = cast(p.local, u64);
    if (depth == 0) { return c->tracked[n]; }
    // The pointer field of a span or string TL is the TL's own reference, as place_access
    // reads it: `*t.ptr` dereferences t.
    if (c->tracked[n]) { return place_access(c, prefix).pointer; }
    if (!c->stored || !c->leaves.aggregate[n]) { return false; }
    ownership_source_leaves.access a = leaf_access(c, prefix);
    return a.kind == ownership_source_leaves.access_kind.leaf ||
        a.kind == ownership_source_leaves.access_kind.pointer ||
        a.kind == ownership_source_leaves.access_kind.dynamic;
}

// Whether place `p` goes through a reference that the run does not track (tracked_reference).
// Its value comes from storage whose contents the run does not follow: the heap, a mutable
// global, caller storage, a taken local, an aggregate past the leaf bounds, or the storage
// that a constant global's address names.
fn untracked_load(context* c, fir.place p) bool {
    fir.func* f = c->function;
    types.node* mut t = fir.base_type(f, p);
    u32 mut i = 0;
    while (i < p.proj_len) {
        fir.projection pj = fir.place_projection(f, p, i);
        bool through = pj.kind == fir.proj_kind.pj_deref || (pj.kind == fir.proj_kind.pj_index &&
            (t->kind == types.type_kind.k_span || t->kind == types.type_kind.k_string));
        if (through && !tracked_reference(c, p, i)) { return true; }
        t = fir.apply_projection(f, t, pj);
        i += 1;
    }
    return false;
}

// Whether place `p` holds a value in storage whose contents the run does not follow, so a
// reference read from it has no known source.
fn untracked_storage(context* c, fir.place p) bool {
    if (fir.place_indirect(c->function, p)) { return true; }
    if (p.base == fir.base_kind.bk_global) { return p.global->mut0; }
    u64 n = cast(p.local, u64);
    return !c->tracked[n] && !(c->stored && c->leaves.aggregate[n]);
}

fn note_untracked(context mut* c, fir.place p, diag.loc at) void {
    if (untracked_load(c, p)) { note_gap(c, missing.unknown_source, source(c, at)); }
}

// A read of a value with a reference leaf out of such storage is a semantic read of a
// reference that the run cannot check (D17.14): a copy, a comparison, a cast, a call
// argument or a release. Whatever the operation, it is the gap unknown_source.
fn note_untracked_value(context mut* c, fir.place p, diag.loc at) void {
    if (reference_leaf(fir.place_type(c->function, p)) && untracked_storage(c, p)) {
        note_gap(c, missing.unknown_source, source(c, at));
    }
}

// Both checks for one place that an operation reads: a use through an untracked reference,
// and a read of a reference value out of untracked storage.
fn note_untracked_read(context mut* c, fir.place p, diag.loc at) void {
    note_untracked(c, p, at);
    note_untracked_value(c, p, at);
}

// A use through a reference whose value the run does not follow is the gap unknown_source in
// both runs, so no row proves it: `*saved.ptr` after `remember(&saved, p)` (approved example
// 09), `**h` after `*h = p` and `del(p)`, `*G` for a mutable global G, `**GP` for `GP = &GM`.
// Each read of that value is the same gap (note_untracked_value). The pass visits each read
// that fir.stmt_read and fir.term_read report: an operand, a callee, a released place, the
// place of a slice of a span or a `string`, and the pointers that an address or a destination
// loads. So the verdict on such a reference does not depend on how lowering writes the load,
// and no body uses or reads a reference that such storage keeps, in a read that FIR reports,
// without this gap; a borrow that a body writes there needs no gap of its own.
fn untracked_loads(context mut* c) void {
    fir.func* f = c->function;
    u32 mut b = 0;
    while (b < fir.block_count(f)) {
        u32 mut i = 0;
        while (i < fir.block_statement_count(f, b)) {
            fir.statement* s = fir.block_statement(f, b, i);
            // Every read of the statement, in the walk of fir.stmt_read: the operands, the
            // callee, the place of a slice of a span or a `string`, a released place, and the
            // pointers that an address or the destination loads. Each read is a use.
            fir.read mut got = fir.read{};
            u32 mut k = 0;
            while (fir.stmt_read(f, s, k, &got)) {
                note_untracked_read(c, got.place, s->loc);
                k += 1;
            }
            i += 1;
        }
        fir.terminator* t = &fir.block_at(f, b)->term;
        fir.read mut value = fir.read{};
        u32 mut k = 0;
        while (fir.term_read(f, t, k, &value)) {
            // The test of an overwrite check reads its place and is no use (fir.md 14).
            if (value.is_use) { note_untracked_read(c, value.place, t->loc); }
            else { note_untracked(c, value.place, t->loc); }
            k += 1;
        }
        b += 1;
    }
}

// ---- loans --------------------------------------------------------------------------------------

// Binds the collection of a loan for the flow: a whole local needs no binding, and a TA leaf
// reached by fields gets one. Another place has no binding the flow can check (fir.md 14).
fn bind_collection(context mut* c, fir.statement* s) bool {
    fir.place p = s->place;
    if (p.base == fir.base_kind.bk_local && p.proj_len == 0) { return true; }
    ownership_source_leaves.access l = leaf_access(c, p);
    if (l.kind != ownership_source_leaves.access_kind.leaf) { return false; }
    u32 mut i = 0;
    while (i < p.proj_len) {
        if (fir.place_projection(c->function, p, i).kind != fir.proj_kind.pj_field) {
            return false;
        }
        i += 1;
    }
    if (c->bindings_len == c->bindings.len) {
        ownership_flow.place_binding mut@ own bigger = new(ownership_flow.place_binding,
            c->bindings.len * 2 + 2);
        u64 mut j = 0;
        while (j < c->bindings_len) { bigger[j] = c->bindings[j]; j += 1; }
        del(c->bindings);
        c->bindings = move(bigger);
    }
    c->bindings[c->bindings_len] = ownership_flow.place_binding{c->identity, p, null,
        spot_place(c, leaf_spot(c, l.first)), true};
    c->bindings_len += 1;
    return true;
}

// Whether a statement of a loan region keeps the flow able to check the loan: no fort call,
// and no write or release of a place other than a whole local. Only call summaries and alias
// facts prove that such a statement preserves the collection.
fn loan_checkable(context* c, fir.statement* s) bool {
    if (s->kind == fir.stmt_kind.st_assign && s->value.kind == fir.rvalue_kind.rv_call &&
        s->value.callee != fir.callee_kind.cl_extern) { return false; }
    fir.place mut written = fir.place{};
    if (fir.stmt_writes_place(s, &written)) {
        return written.base == fir.base_kind.bk_local && written.proj_len == 0;
    }
    return true;
}

// Walks the region of loan `id` from the statement after its begin at (block, gap) until
// each path reaches its end. Each block is searched once.
fn loan_region_checkable(context* c, u32 block, u32 gap, u32 id) bool {
    fir.func* f = c->function;
    fir_flow.bits mut seen = fir_flow.bits_new(fir.block_count(f));
    defer fir_flow.bits_free(&seen);
    u32 mut@ own work = new(u32, cast(fir.block_count(f), u64) + 1);
    defer del(work);
    u64 mut len = 1;
    work[0] = block;
    u32 mut first = gap + 1;
    while (len > 0) {
        len -= 1;
        u32 b = work[len];
        u32 count = fir.block_statement_count(f, b);
        u32 mut i = first;
        first = 0;
        bool mut ended = false;
        while (i < count && !ended) {
            fir.statement* s = fir.block_statement(f, b, i);
            if (s->kind == fir.stmt_kind.st_loan_end && s->loan == id) { ended = true; }
            else if (!loan_checkable(c, s)) { return false; }
            i += 1;
        }
        fir.block* at = fir.block_at(f, b);
        u32 mut index = 0;
        u32 mut target = 0;
        while (!ended && at->terminated &&
            fir_flow.reachable_target(f, &at->term, index, &target)) {
            if (!fir_flow.bits_get(&seen, target)) {
                fir_flow.bits_set(&seen, target);
                work[len] = target;
                len += 1;
            }
            index += 1;
        }
    }
    return true;
}

// The stored run proves a range loan with the flow (D17.10). A collection that it cannot bind
// and a region that it cannot check are the gap `range_loan`.
fn loans(context mut* c) void {
    fir.func* f = c->function;
    u32 mut b = 0;
    while (b < fir.block_count(f)) {
        u32 mut i = 0;
        while (i < fir.block_statement_count(f, b)) {
            fir.statement* s = fir.block_statement(f, b, i);
            if (s->kind == fir.stmt_kind.st_loan_begin &&
                (!bind_collection(c, s) || !loan_region_checkable(c, b, i, s->loan))) {
                note_gap(c, missing.range_loan, source(c, s->loc));
            }
            i += 1;
        }
        b += 1;
    }
}

// ---- services -----------------------------------------------------------------------------------

fn budget(void mut* opaque_context, ownership_api.charge_request* request)
    ownership_api.charge_result {
    context mut* c = cast(opaque_context, context mut*);
    if (c->first_refusal.terminal.present) {
        return ownership_api.charge_result{.proof = c->first_refusal,
            .limit = c->first_refusal.terminal.limit};
    }
    ownership_api.charge_result out = ownership_limits.try_charge(&c->meter, request);
    if (!out.allowed) {
        c->first_refusal = ownership_api.incomplete(ownership_api.incomplete_reason.work_limit,
            request->operation, request->source);
        c->first_refusal.terminal.limit = out.limit;
        c->first_refusal.terminal.limit.source = request->source;
    }
    return out;
}

// Keeps a bounded copy of each event. The validation decides what each event establishes.
fn event(void mut* opaque_context, ownership_api.event_request* request)
    ownership_api.event_result {
    context mut* c = cast(opaque_context, context mut*);
    ownership_api.event_result mut out = ownership_api.event_result{};
    out.proof = request->current;
    out.retained = true;
    out.stored_key = request->event.key;
    ownership_api.event_descriptor* e = &request->event;
    if (!charge_report(c, e->operation, e->source, 1)) {
        c->records_lost = true;
        return out;
    }
    if (c->records_len == c->records.len) {
        u64 mut cap = c->records.len * 2 + 4;
        if (cap > c->limits.v) { cap = c->limits.v; }
        if (cap <= c->records_len) {
            c->records_lost = true;
            return out;
        }
        record mut@ own bigger = new(record, cap);
        u64 mut i = 0;
        while (i < c->records_len) { bigger[i] = c->records[i]; i += 1; }
        del(c->records);
        c->records = move(bigger);
    }
    bool invalid = e->reason == ownership_api.incomplete_reason.none &&
        (e->kind == ownership_api.event_kind.invalid_use ||
        e->kind == ownership_api.event_kind.lost_ownership);
    c->records[c->records_len] = record{cast(e->key.ordinal, u64), e->operation, e->source,
        e->kind, e->reason, e->relation, e->text, invalid, false};
    c->records_len += 1;
    return out;
}

// Charges retained events and rendered records against the V bound of this ledger.
fn charge_report(context mut* c, ownership_api.operation_position op,
    ownership_api.source_position at, u64 amount) bool {
    ownership_api.charge_item[1] item = {ownership_api.charge_item{
        ownership_api.limit_category.v, ownership_api.limit_scope.report, amount}};
    ownership_api.charge_request request = ownership_api.charge_request{
        ownership_api.work_kind.transfer, op, at, item[..]};
    ownership_api.charge_result out = ownership_limits.try_charge(&c->meter, &request);
    if (!out.allowed && !c->first_refusal.terminal.present) {
        c->first_refusal = ownership_api.incomplete(ownership_api.incomplete_reason.report_limit,
            op, at);
        c->first_refusal.terminal.limit = out.limit;
        c->first_refusal.terminal.limit.source = at;
    }
    return out.allowed;
}

/// Charges one rendered violation: its error and its note.
fn charge_rendered(context mut* c, violation* v) bool {
    return charge_report(c, v->operation, v->source, 2);
}

fn configure(ownership_limits.meter mut* m, ownership_api.limit_table* limits) void {
    if (!ownership_limits.configure(m, limits)) {
        // panic-coverage: unreachable: read: computation() returns the valid version 1 table.
        panic("ownership_source_local: production limits are invalid");
    }
}

/// Produces the steps and the entry facts of the stored run of one verified body: the local
/// steps, and the steps of TA leaves, stack sources and range loans.
fn prepare_stored(context mut* c, fir.func* function, ownership_api.function_id identity,
    u32 file, string filename, ownership_api.source_position declaration) void {
    // prepare refuses a prepared context before it reads the mode.
    c->stored = true;
    prepare(c, function, identity, file, filename, declaration);
}

/// Produces the steps and the entry facts of one verified body.
fn prepare(context mut* c, fir.func* function, ownership_api.function_id identity, u32 file,
    string filename, ownership_api.source_position declaration) void {
    if (c->initialized) { panic("ownership_source_local: context is already prepared"); }
    c->function = function;
    c->identity = identity;
    c->file = file;
    c->filename = filename;
    c->declaration = declaration;
    c->initialized = true;
    c->trusted_return[0] = ownership_api.outcome_fact{
        .kind = ownership_api.outcome_kind.function_return, .possible_caller_return = true};
    c->files[0] = ownership_flow.source_file_binding{identity.declaration.module, file,
        filename};
    classify(c);
    types.node* result = local_type(c, 0);
    if (c->tracked[0]) {
        c->result_slot = entity(c, ownership_api.entity_kind.slot, 0);
    } else if (result->kind != types.type_kind.k_void && reference_leaf(result)) {
        note_gap(c, missing.aggregate_result, declaration);
    }
    u32 mut n = 1;
    while (n < fir.local_count(function)) {
        fir.local* l = fir.local_at(function, n);
        bool aggregate = c->stored && c->leaves.aggregate[cast(n, u64)];
        if (!c->tracked[cast(n, u64)] && !aggregate && owning_type(l->ty) &&
            l->kind != fir.local_kind.lk_param) {
            note_gap(c, missing.owning_storage, source(c, l->loc));
        }
        n += 1;
    }
    if (c->stored) {
        stack_borrows(c);
        loans(c);
    }
    untracked_loads(c);
    transients(c);
    classify_flags(c);
    mark_offsets(c);
    u32 mut block = 0;
    while (block < fir.block_count(function)) {
        u32 count = fir.block_statement_count(function, block);
        u32 mut gap = 0;
        while (gap < count) {
            statement_effects(c, block, gap);
            end_transients(c, block, gap);
            gap += 1;
        }
        terminator_effects(c, block);
        end_transients(c, block, count);
        block += 1;
    }
    entry_facts(c);
    flow_bindings(c);
    link(c);
    c->fir_size = ownership_limits.fir_size(function);
    c->limits = ownership_limits.computation(c->fir_size);
    configure(&c->meter, &c->limits);
    c->services.budget_context = cast(c, void mut*);
    c->services.budget = budget;
    c->services.event_context = cast(c, void mut*);
    c->services.event = event;
    c->step_attempts = new(u64, c->steps_len);
    c->step_uncertain = new(u64, c->steps_len);
    c->return_attempts = new(u64, cast(fir.block_count(function), u64));
    c->return_uncertain = new(u64, cast(fir.block_count(function), u64));
    c->correspondence = c->gap == missing.none ? status.complete : status.incomplete;
}

// ---- stops -------------------------------------------------------------------------------------

// Whether block `to` follows block `from` on a path of at least one edge.
fn reaches(fir.func* f, u32 from, u32 to) bool {
    fir_flow.bits mut seen = fir_flow.bits_new(fir.block_count(f));
    defer fir_flow.bits_free(&seen);
    u32 mut@ own work = new(u32, cast(fir.block_count(f), u64));
    defer del(work);
    u64 mut len = 0;
    u32 mut index = 0;
    u32 mut target = 0;
    fir.block* start = fir.block_at(f, from);
    while (start->terminated && fir_flow.next_reachable_target(f, &start->term, &index,
        &target)) {
        if (!fir_flow.bits_get(&seen, target)) {
            fir_flow.bits_set(&seen, target);
            work[len] = target;
            len += 1;
        }
        index += 1;
    }
    while (len > 0) {
        len -= 1;
        u32 b = work[len];
        if (b == to) { return true; }
        fir.block* at = fir.block_at(f, b);
        index = 0;
        while (at->terminated && fir_flow.next_reachable_target(f, &at->term, &index,
            &target)) {
            if (!fir_flow.bits_get(&seen, target)) {
                fir_flow.bits_set(&seen, target);
                work[len] = target;
                len += 1;
            }
            index += 1;
        }
    }
    return false;
}

// Whether a path from position (from_block, from_gap, from_rank) can reach position
// (block, gap, rank) after it. A loop can bring a later position of one block back.
fn follows(context* c, u32 from_block, u32 from_gap, u64 from_rank, u32 block, u32 gap,
    u64 rank) bool {
    if (from_block == block && from_gap == gap && from_rank == rank) { return false; }
    bool earlier = from_block == block &&
        (from_gap < gap || (from_gap == gap && from_rank < rank));
    return earlier || reaches(c->function, from_block, block);
}

// Whether a path stopped, or passed an unknown fort call, before (block, gap, rank).
fn stopped_before(context* c, u32 block, u32 gap, u64 rank) bool {
    if (c->result.stops_lost) { return true; }
    u64 mut i = 0;
    while (i < c->result.stops_len) {
        ownership_flow.stop at = c->result.stops[i];
        if (follows(c, at.block, at.gap, at.rank, block, gap, rank)) { return true; }
        i += 1;
    }
    i = 0;
    while (i < c->steps_len) {
        ownership_flow.step* b = &c->steps[i];
        if (c->barrier[i] && follows(c, b->block, b->gap, cast(b->order, u64) + 1, block, gap,
            rank)) { return true; }
        i += 1;
    }
    return false;
}

// ---- classification ---------------------------------------------------------------------------

// A second run classifies the failures of a body. It drops the outside steps, so calls and
// non-local releases keep every fact. A failure that it does not repeat depends on such an
// effect. The second run never proves a step: it only decides the scope of the first run. It
// is a computation of its own, so it charges a ledger of its own (fir.md 14.1).
fn classify_budget(void mut* opaque_context, ownership_api.charge_request* request)
    ownership_api.charge_result {
    context mut* c = cast(opaque_context, context mut*);
    if (c->classify_refusal.terminal.present) {
        return ownership_api.charge_result{.proof = c->classify_refusal,
            .limit = c->classify_refusal.terminal.limit};
    }
    ownership_api.charge_result out = ownership_limits.try_charge(&c->classify_meter, request);
    if (!out.allowed) {
        c->classify_refusal = ownership_api.incomplete(
            ownership_api.incomplete_reason.work_limit, request->operation, request->source);
        c->classify_refusal.terminal.limit = out.limit;
        c->classify_refusal.terminal.limit.source = request->source;
    }
    return out;
}

fn classify_event(void mut* opaque_context, ownership_api.event_request* request)
    ownership_api.event_result {
    ownership_api.event_result mut out = ownership_api.event_result{};
    out.proof = request->current;
    out.retained = true;
    out.stored_key = request->event.key;
    return out;
}

/// Whether each failure of the first run depends on a call or on a non-local release. That is
/// true only when the second run ends within its own budget and fails nothing: call summaries
/// own those failures (calls_heap). Any failure of the second run is local, and so is a
/// second run that stops at a limit.
fn call_dependent(context mut* c) bool {
    u64 mut outside = 0;
    u64 mut i = 0;
    while (i < c->steps_len) {
        if (c->steps[i].kind == ownership_flow.step_kind.local_effect &&
            c->steps[i].local.kind == ownership_transfer.action.outside) { outside += 1; }
        i += 1;
    }
    if (outside == 0) { return false; }
    ownership_flow.step mut@ own kept = new(ownership_flow.step, c->steps_len - outside);
    defer del(kept);
    u64 mut n = 0;
    i = 0;
    while (i < c->steps_len) {
        if (c->steps[i].kind != ownership_flow.step_kind.local_effect ||
            c->steps[i].local.kind != ownership_transfer.action.outside) {
            kept[n] = c->steps[i];
            n += 1;
        }
        i += 1;
    }
    configure(&c->classify_meter, &c->limits);
    c->classified = true;
    // The second run is one computation in two passes on one ledger. The first pass keeps one
    // path state for each block: G = 1 joins every alternative. A joined state covers each
    // path, so it fails a step whenever a path does. So a first pass with no failure means
    // that no path fails. Only a failed first pass needs the exact pass with the production G.
    ownership_api.limit_table mut joined = c->limits;
    joined.g = 1;
    if (passes_without_failure(c, kept[..], &joined)) { return true; }
    return !c->classify_refusal.terminal.present &&
        passes_without_failure(c, kept[..], &c->limits);
}

// Whether one pass of the second run over `kept` ends within its budget and fails nothing.
fn passes_without_failure(context mut* c, ownership_flow.step@ kept,
    ownership_api.limit_table* limits) bool {
    ownership_api.services mut classifying = ownership_api.services{};
    classifying.budget_context = cast(c, void mut*);
    classifying.budget = classify_budget;
    classifying.event_context = cast(c, void mut*);
    classifying.event = classify_event;
    ownership_flow.program input = ownership_flow.program{.function = c->function,
        .identity = c->identity, .entry = &c->entry, .services = &classifying,
        .limits = limits, .steps = kept, .flags = c->flag_edges[..c->flag_edges_len],
        .events = c->events[..c->events_len], .places = c->bindings[..c->bindings_len],
        .source_files = c->files[..], .result_slot = c->result_slot,
        .supplied_complete = true, .verified_fir = true};
    ownership_flow.analysis mut pass = ownership_flow.solve(&input);
    defer ownership_flow.free(&pass);
    return !c->classify_refusal.terminal.present && !pass.stops_lost &&
        pass.blocks.len > 0 && pass.failures == 0;
}

// ---- witnesses --------------------------------------------------------------------------------

// What the witness walk knows about the value of one local.
enum witness_kind {
    unknown,
    // `value`: an integer, a bool, a char or null.
    constant,
    // The entry value of parameter `param`. No condition chose it yet.
    entry_value,
    // Whether the entry value of `param` stands in `rel` to the integer or bool `value`.
    relation,
    // A pointer to an allocation of at least one element.
    allocated,
    // A span or a string. `value` is its length when `has_length` is set. `live` says that its
    // pointer designates an allocation of at least one element.
    header,
}

struct witness_value {
    witness_kind kind;
    consts.cval value;
    u32 param;
    consts.cv_rel rel;
    bool has_length;
    bool live;
}

// One concrete path from the entry toward one block. `toward` holds the blocks that can reach
// that block, and `distance[b]` the fewest edges from block `b` to it. `chosen[p]` says that a
// condition fixed the entry value of parameter `p` to `choice[p]`.
struct walk {
    context mut* owner;
    witness_value mut@ own values;
    // The value of each TA leaf in the stored run.
    witness_value mut@ own leaf_values;
    bool mut@ own chosen;
    consts.cval mut@ own choice;
    fir_flow.bits toward;
    u32 mut@ own distance;
}

fn constant_value(consts.cval v) witness_value {
    return witness_value{.kind = witness_kind.constant, .value = v};
}

fn null_value() witness_value { return constant_value(consts.cv_null()); }

// Whether a condition can choose a value of type `t`: a bool or an integer.
fn choosable(types.node* t) bool {
    return t->kind == types.type_kind.k_prim &&
        (prim.prim_is_integer(t->prim) || t->prim == prim.prim_kind.prim_bool);
}

fn integer_type(types.node* t) bool {
    return t->kind == types.type_kind.k_prim && prim.prim_is_integer(t->prim);
}

fn header_type(types.node* t) bool {
    return t->kind == types.type_kind.k_span || t->kind == types.type_kind.k_string;
}

// Whether integer type `to` holds each value of integer type `from`.
fn holds(types.node* to, types.node* from) bool {
    if (!integer_type(from)) { return false; }
    u32 a = prim.prim_size(from->prim);
    u32 b = prim.prim_size(to->prim);
    bool signed_from = prim.prim_is_signed(from->prim);
    bool signed_to = prim.prim_is_signed(to->prim);
    if (signed_from == signed_to) { return a <= b; }
    return !signed_from && signed_to && a < b;
}

// Charges one W unit of validation to the local ledger: a block or a statement of a walk.
fn charge_work(context mut* c, u32 block) bool {
    ownership_api.charge_item[1] item = {ownership_api.charge_item{
        ownership_api.limit_category.w, ownership_api.limit_scope.computation, 1}};
    ownership_api.charge_request request = ownership_api.charge_request{
        ownership_api.work_kind.transfer, position(c, block, 0), c->declaration, item[..]};
    return budget(cast(c, void mut*), &request).allowed;
}

// Starts a walk toward `block`: the blocks that reach it, and the entry value of each local.
// Each bool or integer parameter that no address names is free for a condition to choose.
fn walk_start(context mut* c, fir.pred_table* preds, u32 block, walk mut* w) bool {
    fir.func* f = c->function;
    u32 count = fir.block_count(f);
    u64 locals = cast(fir.local_count(f), u64);
    w->owner = c;
    w->values = new(witness_value, locals);
    w->leaf_values = new(witness_value, c->leaves.leaves_len);
    w->chosen = new(bool, locals);
    w->choice = new(consts.cval, locals);
    w->toward = fir_flow.bits_new(count);
    u64 mut n = 0;
    while (n < locals) {
        fir.local* l = fir.local_at(f, cast(n, u32));
        if (l->kind == fir.local_kind.lk_param && !c->taken[n] && choosable(l->ty)) {
            w->values[n] = witness_value{.kind = witness_kind.entry_value, .param = cast(n, u32)};
        }
        n += 1;
    }
    // A search in breadth order over the predecessors finds the distances.
    w->distance = new(u32, cast(count, u64));
    u32 mut@ own queue = new(u32, cast(count, u64));
    defer del(queue);
    fir_flow.bits_set(&w->toward, block);
    queue[0] = block;
    u64 mut head = 0;
    u64 mut tail = 1;
    while (head < tail) {
        u32 b = queue[head];
        head += 1;
        if (!charge_work(c, b)) { return false; }
        u32 mut i = 0;
        while (i < fir.pred_count(preds, b)) {
            u32 from = fir.pred_at(preds, b, i);
            if (!fir_flow.bits_get(&w->toward, from)) {
                fir_flow.bits_set(&w->toward, from);
                w->distance[cast(from, u64)] = w->distance[cast(b, u64)] + 1;
                queue[tail] = from;
                tail += 1;
            }
            i += 1;
        }
    }
    return true;
}

fn walk_free(walk mut* w) void {
    del(w->values);
    del(w->leaf_values);
    del(w->chosen);
    del(w->choice);
    del(w->distance);
    fir_flow.bits_free(&w->toward);
}

// The value of `v` after the conditions that chose its parameter.
fn resolve(walk* w, witness_value v) witness_value {
    if (v.kind != witness_kind.entry_value && v.kind != witness_kind.relation) { return v; }
    u64 p = cast(v.param, u64);
    if (!w->chosen[p]) { return v; }
    if (v.kind == witness_kind.entry_value) { return constant_value(w->choice[p]); }
    return constant_value(consts.cv_compare(v.rel, w->choice[p], v.value));
}

fn constant_of(fir.constant k) witness_value {
    if (k.kind == fir.const_kind.ck_int || k.kind == fir.const_kind.ck_bool) {
        return constant_value(k.value);
    }
    if (k.kind == fir.const_kind.ck_null) { return null_value(); }
    if (k.kind == fir.const_kind.ck_zero && k.ty != null) {
        if (types.type_is_reference(k.ty)) { return null_value(); }
        if (integer_type(k.ty)) { return constant_value(consts.cv_from_u64(0)); }
        if (choosable(k.ty)) { return constant_value(consts.cv_from_bool(false)); }
    }
    return witness_value{};
}

// The value at `p`. The walk knows whole locals that no address names, and the length of a
// span or a string local.
fn place_value(walk* w, fir.place p) witness_value {
    context* c = w->owner;
    if (p.base != fir.base_kind.bk_local || c->taken[cast(p.local, u64)]) {
        return witness_value{};
    }
    ownership_source_leaves.access l = leaf_access(c, p);
    if (l.kind == ownership_source_leaves.access_kind.leaf) { return w->leaf_values[l.first]; }
    if (l.kind == ownership_source_leaves.access_kind.length) {
        witness_value v = w->leaf_values[l.first];
        if (v.kind == witness_kind.constant && v.value.kind == consts.cval_kind.cv_null) {
            return constant_value(consts.cv_from_u64(0));
        }
        if (v.kind == witness_kind.header && v.has_length) { return constant_value(v.value); }
        return witness_value{};
    }
    if (l.kind != ownership_source_leaves.access_kind.none) { return witness_value{}; }
    witness_value v = resolve(w, w->values[cast(p.local, u64)]);
    if (p.proj_len == 0) { return v; }
    if (p.proj_len != 1 || !header_type(local_type(c, p.local))) { return witness_value{}; }
    fir.projection pj = fir.place_projection(c->function, p, 0);
    if (pj.kind != fir.proj_kind.pj_field || pj.field != 1) { return witness_value{}; }
    if (v.kind == witness_kind.constant && v.value.kind == consts.cval_kind.cv_null) {
        return constant_value(consts.cv_from_u64(0));
    }
    if (v.kind == witness_kind.header && v.has_length) { return constant_value(v.value); }
    return witness_value{};
}

fn operand_value(walk* w, fir.operand o) witness_value {
    if (o.kind == fir.operand_kind.ok_const) { return constant_of(o.value); }
    return place_value(w, o.place);
}

// A write changes the local that the place names unless an indirection comes first. A write
// into part of a local makes its value unknown.
fn set_place(walk mut* w, fir.place p, witness_value v) void {
    context* c = w->owner;
    if (p.base != fir.base_kind.bk_local || !names_storage(c->function, p,
        fir.rvalue_kind.rv_addr)) { return; }
    ownership_source_leaves.access l = leaf_access(c, p);
    if (l.kind == ownership_source_leaves.access_kind.leaf) {
        w->leaf_values[l.first] = v;
        return;
    }
    if (l.kind == ownership_source_leaves.access_kind.prefix ||
        l.kind == ownership_source_leaves.access_kind.dynamic) {
        // A part of a TA, or an element that a variable index selects: its leaves are unknown.
        u64 count = l.kind == ownership_source_leaves.access_kind.dynamic && !l.elements ?
            c->leaves.count[cast(l.local, u64)] : l.count;
        u64 first = l.kind == ownership_source_leaves.access_kind.dynamic && !l.elements ?
            c->leaves.first[cast(l.local, u64)] : l.first;
        u64 mut k = first;
        while (k < first + count) { w->leaf_values[k] = witness_value{}; k += 1; }
        return;
    }
    w->values[cast(p.local, u64)] = p.proj_len == 0 ? v : witness_value{};
}

// A move and a del leave the zero value of the type at the place: null for a reference.
fn empty_place(walk mut* w, fir.place p) void {
    bool reference = types.type_is_reference(fir.place_type(w->owner->function, p));
    set_place(w, p, reference ? null_value() : witness_value{});
}

fn both_integers(witness_value a, witness_value b) bool {
    return a.kind == witness_kind.constant && b.kind == witness_kind.constant &&
        a.value.kind == consts.cval_kind.cv_int && b.value.kind == consts.cval_kind.cv_int;
}

// The exact result of an integer rvalue. False when the operation has no exact result.
fn exact(fir.rvalue_kind kind, consts.cval a, consts.cval b, consts.cval mut* out) bool {
    if (kind == fir.rvalue_kind.rv_add || kind == fir.rvalue_kind.rv_add_overflows) {
        return consts.cv_add(a, b, out);
    }
    if (kind == fir.rvalue_kind.rv_sub || kind == fir.rvalue_kind.rv_sub_overflows) {
        return consts.cv_sub(a, b, out);
    }
    if (kind == fir.rvalue_kind.rv_mul || kind == fir.rvalue_kind.rv_mul_overflows) {
        return consts.cv_mul(a, b, out);
    }
    if (kind == fir.rvalue_kind.rv_div) { return consts.cv_div(a, b, out); }
    if (kind == fir.rvalue_kind.rv_rem) { return consts.cv_rem(a, b, out); }
    return false;
}

fn relation_of(fir.rvalue_kind kind) consts.cv_rel {
    if (kind == fir.rvalue_kind.rv_eq) { return consts.cv_rel.cv_rel_eq; }
    if (kind == fir.rvalue_kind.rv_ne) { return consts.cv_rel.cv_rel_ne; }
    if (kind == fir.rvalue_kind.rv_lt) { return consts.cv_rel.cv_rel_lt; }
    if (kind == fir.rvalue_kind.rv_le) { return consts.cv_rel.cv_rel_le; }
    if (kind == fir.rvalue_kind.rv_gt) { return consts.cv_rel.cv_rel_gt; }
    return consts.cv_rel.cv_rel_ge;
}

// The relation with its operands exchanged: `k < x` is `x > k`.
fn mirror(consts.cv_rel rel) consts.cv_rel {
    if (rel == consts.cv_rel.cv_rel_lt) { return consts.cv_rel.cv_rel_gt; }
    if (rel == consts.cv_rel.cv_rel_le) { return consts.cv_rel.cv_rel_ge; }
    if (rel == consts.cv_rel.cv_rel_gt) { return consts.cv_rel.cv_rel_lt; }
    if (rel == consts.cv_rel.cv_rel_ge) { return consts.cv_rel.cv_rel_le; }
    return rel;
}

fn ordering(consts.cv_rel rel) bool {
    return rel != consts.cv_rel.cv_rel_eq && rel != consts.cv_rel.cv_rel_ne;
}

fn compare_constants(consts.cv_rel rel, consts.cval a, consts.cval b) witness_value {
    if (a.kind != b.kind) { return witness_value{}; }
    bool integer = a.kind == consts.cval_kind.cv_int || a.kind == consts.cval_kind.cv_char;
    bool equality = a.kind == consts.cval_kind.cv_bool || a.kind == consts.cval_kind.cv_null;
    if (integer || (equality && !ordering(rel))) {
        return constant_value(consts.cv_compare(rel, a, b));
    }
    return witness_value{};
}

// `x rel k` for the entry value `x` of a parameter and a constant `k` of its kind.
fn parameter_relation(walk* w, consts.cv_rel rel, witness_value x, witness_value k)
    witness_value {
    types.node* t = local_type(w->owner, x.param);
    bool integer = integer_type(t) && k.value.kind == consts.cval_kind.cv_int;
    bool flag = !integer_type(t) && k.value.kind == consts.cval_kind.cv_bool && !ordering(rel);
    if (!integer && !flag) { return witness_value{}; }
    return witness_value{.kind = witness_kind.relation, .param = x.param, .rel = rel,
        .value = k.value};
}

fn comparison(walk* w, fir.rvalue r) witness_value {
    fir.func* f = w->owner->function;
    consts.cv_rel rel = relation_of(r.kind);
    witness_value a = operand_value(w, fir.rvalue_operand(f, r, 0));
    witness_value b = operand_value(w, fir.rvalue_operand(f, r, 1));
    if (a.kind == witness_kind.constant && b.kind == witness_kind.constant) {
        return compare_constants(rel, a.value, b.value);
    }
    // An allocation is never null.
    bool a_null = a.kind == witness_kind.constant && a.value.kind == consts.cval_kind.cv_null;
    bool b_null = b.kind == witness_kind.constant && b.value.kind == consts.cval_kind.cv_null;
    if (!ordering(rel) && ((a.kind == witness_kind.allocated && b_null) ||
        (b.kind == witness_kind.allocated && a_null))) {
        return constant_value(consts.cv_from_bool(rel == consts.cv_rel.cv_rel_ne));
    }
    if (a.kind == witness_kind.entry_value && b.kind == witness_kind.constant) {
        return parameter_relation(w, rel, a, b);
    }
    if (b.kind == witness_kind.entry_value && a.kind == witness_kind.constant) {
        return parameter_relation(w, mirror(rel), b, a);
    }
    return witness_value{};
}

// The value that `s` writes. The walk evaluates exact integer arithmetic, comparisons,
// integer casts that keep the value, allocations and span headers.
fn rvalue_value(walk* w, fir.statement* s) witness_value {
    fir.func* f = w->owner->function;
    fir.rvalue r = s->value;
    types.node* t = fir.place_type(f, s->place);
    fir.rvalue_kind k = r.kind;
    if (k == fir.rvalue_kind.rv_use) { return operand_value(w, fir.rvalue_operand(f, r, 0)); }
    if (k == fir.rvalue_kind.rv_eq || k == fir.rvalue_kind.rv_ne ||
        k == fir.rvalue_kind.rv_lt || k == fir.rvalue_kind.rv_le ||
        k == fir.rvalue_kind.rv_gt || k == fir.rvalue_kind.rv_ge) { return comparison(w, r); }
    if (k == fir.rvalue_kind.rv_not) {
        witness_value v = operand_value(w, fir.rvalue_operand(f, r, 0));
        if (v.kind == witness_kind.constant && v.value.kind == consts.cval_kind.cv_bool) {
            return constant_value(consts.cv_lnot(v.value));
        }
        return witness_value{};
    }
    if (k == fir.rvalue_kind.rv_slice || k == fir.rvalue_kind.rv_slice_ptr) {
        // `slice(p, lo, hi)` and `slice_ptr(a, lo, hi)` have the length hi - lo. Checks before a
        // slice hold lo <= hi. A negative length stays unknown.
        u32 first = k == fir.rvalue_kind.rv_slice ? 0 : 1;
        if (!header_type(t) || r.ops_len != first + 2) { return witness_value{}; }
        witness_value low = operand_value(w, fir.rvalue_operand(f, r, first));
        witness_value high = operand_value(w, fir.rvalue_operand(f, r, first + 1));
        consts.cval mut length = consts.cv_none();
        if (!both_integers(low, high) || !consts.cv_sub(high.value, low.value, &length) ||
            length.neg) { return witness_value{}; }
        return witness_value{.kind = witness_kind.header, .value = length, .has_length = true};
    }
    if (k == fir.rvalue_kind.rv_and || k == fir.rvalue_kind.rv_or ||
        k == fir.rvalue_kind.rv_xor) {
        witness_value x = operand_value(w, fir.rvalue_operand(f, r, 0));
        witness_value y = operand_value(w, fir.rvalue_operand(f, r, 1));
        if (x.kind != witness_kind.constant || y.kind != witness_kind.constant ||
            x.value.kind != consts.cval_kind.cv_bool || y.value.kind != consts.cval_kind.cv_bool) {
            return witness_value{};
        }
        if (k == fir.rvalue_kind.rv_and) {
            return constant_value(consts.cv_land(x.value, y.value));
        }
        if (k == fir.rvalue_kind.rv_or) {
            return constant_value(consts.cv_lor(x.value, y.value));
        }
        return constant_value(consts.cv_from_bool(x.value.mag != y.value.mag));
    }
    if (k == fir.rvalue_kind.rv_alloc) {
        witness_value count = operand_value(w, fir.rvalue_operand(f, r, 0));
        if (count.kind == witness_kind.constant && count.value.kind == consts.cval_kind.cv_int &&
            !count.value.neg && count.value.mag > 0) {
            return witness_value{.kind = witness_kind.allocated};
        }
        return witness_value{};
    }
    if (k == fir.rvalue_kind.rv_aggregate) {
        if (!header_type(t) || r.ops_len != 2) { return witness_value{}; }
        witness_value pointer = operand_value(w, fir.rvalue_operand(f, r, 0));
        witness_value length = operand_value(w, fir.rvalue_operand(f, r, 1));
        bool known = length.kind == witness_kind.constant &&
            length.value.kind == consts.cval_kind.cv_int;
        return witness_value{.kind = witness_kind.header, .value = length.value,
            .has_length = known, .live = pointer.kind == witness_kind.allocated};
    }
    if (r.ops_len != 1 && r.ops_len != 2) { return witness_value{}; }
    witness_value a = operand_value(w, fir.rvalue_operand(f, r, 0));
    if (k == fir.rvalue_kind.rv_cast) {
        // A cast that keeps the value: any other cast leaves the walk without it.
        if (a.kind == witness_kind.constant && a.value.kind == consts.cval_kind.cv_int &&
            integer_type(t) && consts.int_fits(a.value, t->prim)) { return a; }
        // The entry value of a parameter stays itself in a type that holds each of its values.
        if (a.kind == witness_kind.entry_value && integer_type(t) &&
            holds(t, local_type(w->owner, a.param))) { return a; }
        return witness_value{};
    }
    if (r.ops_len != 2) { return witness_value{}; }
    witness_value b = operand_value(w, fir.rvalue_operand(f, r, 1));
    consts.cval mut out = consts.cv_none();
    if (!both_integers(a, b) || !exact(k, a.value, b.value, &out)) { return witness_value{}; }
    if (k == fir.rvalue_kind.rv_add_overflows || k == fir.rvalue_kind.rv_sub_overflows ||
        k == fir.rvalue_kind.rv_mul_overflows) {
        types.node* operand = fir.operand_type(f, fir.rvalue_operand(f, r, 0));
        if (!integer_type(operand)) { return witness_value{}; }
        return constant_value(consts.cv_from_bool(!consts.int_fits(out, operand->prim)));
    }
    if (!integer_type(t) || !consts.int_fits(out, t->prim)) { return witness_value{}; }
    return constant_value(out);
}

// Whether the walk can cross a call. An extern declaration is trusted to return as its
// signature says (D17.13). A fort callee can fail to return, and local proof has no summary.
fn returns(fir.func* f, fir.rvalue r) bool {
    if (r.callee != fir.callee_kind.cl_extern) { return false; }
    types.node* t = fir.callee_type(f, r);
    return t != null && !t->is_noreturn;
}

// Applies one statement to the walk. False when the walk cannot cross it.
// The values of the leaves [first, first + count) that a whole aggregate operand gives: the
// leaves of a TA part, null for `zero`, else unknown.
fn operand_leaves(walk* w, fir.operand o, witness_value mut@ out) void {
    if (o.kind == fir.operand_kind.ok_const) {
        if (o.value.kind == fir.const_kind.ck_zero) {
            u64 mut k = 0;
            while (k < out.len) { out[k] = null_value(); k += 1; }
        }
        return;
    }
    ownership_source_leaves.access l = leaf_access(w->owner, o.place);
    if (l.kind != ownership_source_leaves.access_kind.prefix || l.count != out.len) { return; }
    u64 mut k = 0;
    while (k < out.len) { out[k] = w->leaf_values[l.first + k]; k += 1; }
}

// A write of a whole value into a TA part: each leaf takes the value of its member, read
// before the moves of the operands empty them (fir.md 6). False for another destination.
fn walk_aggregate(walk mut* w, fir.statement* s) bool {
    context* c = w->owner;
    fir.func* f = c->function;
    ownership_source_leaves.access l = leaf_access(c, s->place);
    fir.rvalue r = s->value;
    if (l.kind != ownership_source_leaves.access_kind.prefix ||
        r.kind == fir.rvalue_kind.rv_call) { return false; }
    witness_value mut@ own values = new(witness_value, l.count);
    defer del(values);
    if (r.kind == fir.rvalue_kind.rv_aggregate) {
        types.node* t = fir.place_type(f, s->place);
        u64 mut at = 0;
        u32 mut k = 0;
        while (k < r.ops_len) {
            types.node* member = t->kind == types.type_kind.k_struct ?
                fir.struct_field_type(t, k) : t->elem;
            u64 count = ownership_source_leaves.count_leaves(member, 0);
            fir.operand o = fir.rvalue_operand(f, r, k);
            if (count > 0 && reference_type(member)) { values[at] = operand_value(w, o); }
            else if (count > 0) { operand_leaves(w, o, values[at..at + count]); }
            at += count;
            k += 1;
        }
    } else if (r.kind == fir.rvalue_kind.rv_use) {
        operand_leaves(w, fir.rvalue_operand(f, r, 0), values[..]);
    }
    u32 mut k = 0;
    while (k < r.ops_len) {
        fir.operand o = fir.rvalue_operand(f, r, k);
        if (o.kind == fir.operand_kind.ok_move) { empty_place(w, o.place); }
        k += 1;
    }
    u64 mut i = 0;
    while (i < l.count) { w->leaf_values[l.first + i] = values[i]; i += 1; }
    return true;
}

fn walk_statement(walk mut* w, fir.statement* s) bool {
    fir.func* f = w->owner->function;
    if (s->kind == fir.stmt_kind.st_del) {
        empty_place(w, s->place);
        return true;
    }
    if (s->kind != fir.stmt_kind.st_assign) { return true; }
    if (s->value.kind == fir.rvalue_kind.rv_call && !returns(f, s->value)) { return false; }
    if (walk_aggregate(w, s)) { return true; }
    witness_value v = s->value.kind == fir.rvalue_kind.rv_call ? witness_value{} :
        rvalue_value(w, s);
    u32 mut k = 0;
    while (k < s->value.ops_len) {
        fir.operand o = fir.rvalue_operand(f, s->value, k);
        if (o.kind == fir.operand_kind.ok_move) { empty_place(w, o.place); }
        k += 1;
    }
    set_place(w, s->place, v);
    return true;
}

fn fix(walk mut* w, u32 param, consts.cval v) void {
    w->chosen[cast(param, u64)] = true;
    w->choice[cast(param, u64)] = v;
}

// An entry value of the parameter of `cond` that makes `cond` equal `wanted`, in `out`. A
// relation tries its constant and the integers next to it, which satisfy any satisfiable
// relation of one integer to a constant. The walk changes nothing.
fn pick(walk* w, witness_value cond, consts.cval wanted, consts.cval mut* out) bool {
    types.node* t = local_type(w->owner, cond.param);
    if (cond.kind == witness_kind.entry_value) {
        bool fits = integer_type(t) ? wanted.kind == consts.cval_kind.cv_int &&
            consts.int_fits(wanted, t->prim) : wanted.kind == consts.cval_kind.cv_bool;
        if (fits) { *out = wanted; }
        return fits;
    }
    if (cond.kind != witness_kind.relation || wanted.kind != consts.cval_kind.cv_bool) {
        return false;
    }
    consts.cval[3] mut candidates = {cond.value, consts.cv_none(), consts.cv_none()};
    if (!integer_type(t)) {
        candidates[1] = consts.cv_from_bool(false);
        candidates[2] = consts.cv_from_bool(true);
    } else {
        consts.cval one = consts.cv_from_u64(1);
        consts.cval mut near = consts.cv_none();
        if (consts.cv_add(cond.value, one, &near)) { candidates[1] = near; }
        if (consts.cv_sub(cond.value, one, &near)) { candidates[2] = near; }
    }
    u64 mut i = 0;
    while (i < candidates.len) {
        consts.cval x = candidates[i];
        bool fits = integer_type(t) ? x.kind == consts.cval_kind.cv_int &&
            consts.int_fits(x, t->prim) : x.kind == consts.cval_kind.cv_bool;
        if (fits && consts.cv_eq(consts.cv_compare(cond.rel, x, cond.value), wanted)) {
            *out = x;
            return true;
        }
        i += 1;
    }
    return false;
}

fn matches_arm(fir.func* f, fir.terminator* t, consts.cval v) bool {
    u32 mut i = 0;
    while (i < t->arms_len) {
        if (consts.cv_eq(fir.term_arm(f, t, i).value, v)) { return true; }
        i += 1;
    }
    return false;
}

// An entry value that sends `cond` to the `otherwise` target of `t`: a value of `cond` that no
// arm names.
fn pick_otherwise(walk* w, fir.terminator* t, witness_value cond, consts.cval mut* out) bool {
    fir.func* f = w->owner->function;
    bool flag = cond.kind == witness_kind.relation ||
        !integer_type(local_type(w->owner, cond.param));
    u32 limit = flag ? 1 : t->arms_len;
    u32 mut i = 0;
    while (i <= limit) {
        consts.cval v = flag ? consts.cv_from_bool(i == 1) : consts.cv_from_u64(cast(i, u64));
        if (!matches_arm(f, t, v) && pick(w, cond, v, out)) { return true; }
        i += 1;
    }
    return false;
}

// The target of a switch on the walk. An unknown condition gives no witness. On a condition
// that a parameter value decides, the walk takes the target nearest to the operation that some
// value reaches, and fixes that value.
fn choose_arm(walk mut* w, fir.terminator* t, u32 mut* out) bool {
    fir.func* f = w->owner->function;
    witness_value cond = operand_value(w, t->cond);
    if (cond.kind == witness_kind.constant) {
        u32 mut i = 0;
        while (i < t->arms_len) {
            fir.arm choice = fir.term_arm(f, t, i);
            if (choice.value.kind == cond.value.kind && consts.cv_eq(choice.value, cond.value)) {
                *out = choice.target;
                return true;
            }
            i += 1;
        }
        *out = t->otherwise;
        return true;
    }
    if (cond.kind != witness_kind.entry_value && cond.kind != witness_kind.relation) {
        return false;
    }
    bool mut found = false;
    u32 mut best = 0;
    consts.cval mut value = consts.cv_none();
    u32 mut i = 0;
    while (i <= t->arms_len) {
        bool otherwise = i == t->arms_len;
        u32 target = otherwise ? t->otherwise : fir.term_arm(f, t, i).target;
        consts.cval mut entry = consts.cv_none();
        bool nearer = !found || w->distance[cast(target, u64)] < w->distance[cast(best, u64)];
        if (fir_flow.bits_get(&w->toward, target) && nearer && (otherwise ?
            pick_otherwise(w, t, cond, &entry) : pick(w, cond, fir.term_arm(f, t, i).value,
            &entry))) {
            found = true;
            best = target;
            value = entry;
        }
        i += 1;
    }
    if (!found) { return false; }
    fix(w, cond.param, value);
    *out = best;
    return true;
}

enum outcome {
    passes,
    fails,
    unknown_outcome,
}

// The outcome of a check on the walk. A free parameter takes a value that passes it. The
// condition is true on failure, except for `chk_user`, where it is true on success.
fn check_outcome(walk mut* w, fir.terminator* t) outcome {
    bool success = t->check == fir.check_kind.chk_user;
    witness_value cond = operand_value(w, t->cond);
    if (cond.kind == witness_kind.constant && cond.value.kind == consts.cval_kind.cv_bool) {
        return (cond.value.mag == 1) == success ? outcome.passes : outcome.fails;
    }
    consts.cval mut entry = consts.cv_none();
    if ((cond.kind == witness_kind.entry_value || cond.kind == witness_kind.relation) &&
        pick(w, cond, consts.cv_from_bool(success), &entry)) {
        fix(w, cond.param, entry);
        return outcome.passes;
    }
    return outcome.unknown_outcome;
}

// The outcome of `check(overwrite: p)`: it passes on an empty owner and traps on a live one.
fn overwrite_outcome(walk* w, fir.terminator* t) outcome {
    witness_value owner = place_value(w, t->place);
    if (owner.kind == witness_kind.constant && owner.value.kind == consts.cval_kind.cv_null) {
        return outcome.passes;
    }
    if (owner.kind == witness_kind.allocated || (owner.kind == witness_kind.header && owner.live)) {
        return outcome.fails;
    }
    return outcome.unknown_outcome;
}

/// Which runtime trap is the operation of an event. The check that traps guards the first
/// statement of its continuation: the store of an overwrite, or the access of an element.
enum trap {
    no_trap,
    overwrite_trap,
    element_trap,
}

// The text of the transfer event for an access through an empty reference. The trap of a
// bounds or span check is that access (D17.9).
string EMPTY_ELEMENT = "empty reference has no element";

/// Whether a concrete path reaches position `gap` of `block` from the entry (toolchain 4.2).
/// The path crosses no back edge and no fort call, and each condition on it evaluates or
/// takes a parameter value that no earlier condition fixed. An unknown condition gives no
/// witness. A check that traps ends the path. It reaches the operation only when the trap is
/// the event `kind` names and the operation is the statement that the check guards.
fn witness(context mut* c, fir.pred_table* preds, u32 block, u32 gap, trap kind) bool {
    walk mut w = walk{};
    defer walk_free(&w);
    return walk_to(c, preds, block, gap, kind, &w);
}

/// The walk of witness, which leaves its values in `w` for the caller to free.
// One choice at each condition: a feasible path that needs another choice stays unwitnessed.
fn walk_to(context mut* c, fir.pred_table* preds, u32 block, u32 gap, trap kind,
    walk mut* w) bool {
    fir.func* f = c->function;
    if (!walk_start(c, preds, block, w)) { return false; }
    fir_flow.bits mut visited = fir_flow.bits_new(fir.block_count(f));
    defer fir_flow.bits_free(&visited);
    u32 mut at = 0;
    while (true) {
        if (fir_flow.bits_get(&visited, at)) { return false; }
        fir_flow.bits_set(&visited, at);
        u32 last = at == block ? gap : fir.block_statement_count(f, at);
        u32 mut i = 0;
        while (i < last) {
            if (!charge_work(c, at) || !walk_statement(w, fir.block_statement(f, at, i))) {
                return false;
            }
            i += 1;
        }
        if (at == block) { return true; }
        if (!charge_work(c, at)) { return false; }
        fir.terminator* t = &fir.block_at(f, at)->term;
        u32 mut next = 0;
        if (t->kind == fir.term_kind.tk_goto) {
            next = t->target;
        } else if (t->kind == fir.term_kind.tk_switch) {
            if (!choose_arm(w, t, &next)) { return false; }
        } else if (t->kind == fir.term_kind.tk_check ||
            t->kind == fir.term_kind.tk_check_overwrite) {
            bool overwrite = t->kind == fir.term_kind.tk_check_overwrite;
            outcome result = overwrite ? overwrite_outcome(w, t) : check_outcome(w, t);
            if (result == outcome.fails) {
                trap expected = overwrite ? trap.overwrite_trap : trap.element_trap;
                return kind == expected && t->target == block && gap == 0;
            }
            if (result != outcome.passes) { return false; }
            next = t->target;
        } else {
            return false;
        }
        if (!fir_flow.bits_get(&w->toward, next)) { return false; }
        at = next;
    }
    return false;
}

// ---- validation -------------------------------------------------------------------------------

fn same_record(record* a, record* b) bool {
    return a->kind == b->kind && a->text == b->text &&
        ownership_keys.entity(a->relation, b->relation) == 0;
}

// The name of a local in a message. Only a source name takes quotes.
fn name_of(context* c, u32 local, bool mut* quoted) string {
    string name = fir.local_name(fir.local_at(c->function, local));
    *quoted = name.len > 0;
    if (name.len == 0) { return "a temporary value"; }
    return name;
}

fn add_violation(context mut* c, record* r, string name, bool quoted, u64 leaf) void {
    if (c->violations_len == c->violations.len) {
        u64 cap = c->violations.len * 2 + 4;
        violation mut@ own bigger = new(violation, cap);
        u64 mut i = 0;
        while (i < c->violations_len) { bigger[i] = c->violations[i]; i += 1; }
        del(c->violations);
        c->violations = move(bigger);
    }
    c->violations[c->violations_len] = violation{r->operation, r->source, r->kind, r->text,
        name, quoted, r->relation, leaf};
    c->violations_len += 1;
}

// Toolchain 4.2 orders events by source range, operation key, event class and relation key.
// The local, stored-borrow and raw records and the report merge of their lists use this order.
fn before(violation* a, violation* b) bool {
    i32 by_source = ownership_keys.source(a->source, b->source);
    if (by_source != 0) { return by_source < 0; }
    i32 by_operation = ownership_keys.operation(a->operation, b->operation);
    if (by_operation != 0) { return by_operation < 0; }
    if (a->kind != b->kind) { return cast(a->kind, i32) < cast(b->kind, i32); }
    return ownership_keys.entity(a->relation, b->relation) < 0;
}

fn sort_violations(context mut* c) void {
    u64 mut i = 1;
    while (i < c->violations_len) {
        violation item = c->violations[i];
        u64 mut j = i;
        while (j > 0 && before(&item, &c->violations[j - 1])) {
            c->violations[j] = c->violations[j - 1];
            j -= 1;
        }
        c->violations[j] = item;
        i += 1;
    }
}

// A violation counts when each path state that reached it reported the same event, no stop
// or unknown call comes before it, and a witness path reaches it (toolchain 4.2).
fn validate(context mut* c) void {
    fir.pred_table mut preds = fir.pred_table{};
    bool mut built = false;
    u64 mut i = 0;
    while (i < c->records_len) {
        record* r = &c->records[i];
        if (!r->violation) { i += 1; continue; }
        // Count each step or return event once, at its first record.
        bool mut first = true;
        u64 mut j = 0;
        while (j < i) {
            if (c->records[j].key == r->key && c->records[j].violation &&
                same_record(&c->records[j], r)) { first = false; }
            j += 1;
        }
        if (!first) { i += 1; continue; }
        u64 mut same = 0;
        bool mut mixed = false;
        j = 0;
        while (j < c->records_len) {
            if (c->records[j].key == r->key) {
                if (same_record(&c->records[j], r)) { same += 1; }
                else { mixed = true; }
            }
            j += 1;
        }
        bool mut valid = !mixed && !c->records_lost;
        string mut name = "";
        bool mut quoted = false;
        u64 mut leaf = WHOLE;
        u32 mut block = 0;
        u32 mut gap = 0;
        if (r->key < c->steps_len) {
            ownership_flow.step* s = &c->steps[r->key];
            valid = valid && !c->barrier[r->key] && same == c->step_attempts[r->key] &&
                c->step_uncertain[r->key] == 0 &&
                !stopped_before(c, s->block, s->gap, cast(s->order, u64) + 1);
            u32 mut named = r->relation.kind == ownership_api.entity_kind.slot ?
                r->relation.ordinal : c->step_slot[r->key];
            // A leaf names the place: the destination of a lost owner, else the source.
            leaf = r->kind == ownership_api.event_kind.lost_ownership ? c->extras[r->key].to :
                c->extras[r->key].from;
            if (leaf != WHOLE) { named = c->leaves.leaves[leaf].local; }
            name = name_of(c, named, &quoted);
            block = s->block;
            gap = s->gap;
        } else {
            binding_info info = c->event_info[r->key - c->steps_len];
            block = info.block;
            gap = fir.block_statement_count(c->function, block);
            valid = valid && info.at_return && same == c->return_attempts[cast(block, u64)] &&
                c->return_uncertain[cast(block, u64)] == 0 &&
                !stopped_before(c, block, gap, ownership_flow.STOP_AFTER - 1);
            name = c->result_slot.kind == ownership_api.entity_kind.slot ? "the result" : "";
        }
        if (valid && !built) {
            preds = fir.func_predecessors(c->function);
            built = true;
        }
        trap mut kind = trap.no_trap;
        if (r->key < c->steps_len && r->kind == ownership_api.event_kind.lost_ownership) {
            kind = trap.overwrite_trap;
        } else if (r->kind == ownership_api.event_kind.invalid_use && r->text == EMPTY_ELEMENT) {
            kind = trap.element_trap;
        }
        if (valid && witness(c, &preds, block, gap, kind)) {
            add_violation(c, r, name, quoted, leaf);
            j = 0;
            while (j < c->records_len) {
                if (c->records[j].key == r->key) { c->records[j].validated = true; }
                j += 1;
            }
        } else { c->unvalidated += 1; }
        i += 1;
    }
    if (built) { fir.pred_table_free(&preds); }
    sort_violations(c);
}

fn first_reason(context mut* c) void {
    if (c->first_refusal.terminal.present) {
        c->first_incomplete = c->first_refusal;
        return;
    }
    u64 mut i = 0;
    while (i < c->records_len) {
        record* r = &c->records[i];
        if (!r->validated) {
            ownership_api.incomplete_reason why = r->reason == ownership_api.incomplete_reason.none
                ? ownership_api.incomplete_reason.missing_path : r->reason;
            ownership_api.proof_status candidate = ownership_api.incomplete(why, r->operation,
                r->source);
            if (!c->first_incomplete.terminal.present || ownership_keys.source(r->source,
                c->first_incomplete.terminal.source) < 0) { c->first_incomplete = candidate; }
        }
        i += 1;
    }
    if (!c->first_incomplete.terminal.present && c->result.failures > 0) {
        c->first_incomplete = c->result.first_failure;
    }
    if (!c->first_incomplete.terminal.present && c->gap != missing.none) {
        c->first_incomplete = ownership_api.incomplete(
            ownership_api.incomplete_reason.missing_correspondence,
            ownership_api.operation_position{.function = c->identity}, c->gap_source);
    }
}

/// Runs the flow solver over the produced steps and validates its violations.
fn solve(context mut* c) void {
    if (!c->initialized || c->solved) { panic("ownership_source_local: invalid solve order"); }
    c->solved = true;
    ownership_flow.observer mut seen = ownership_flow.observer{c->step_attempts[..],
        c->step_uncertain[..], c->return_attempts[..], c->return_uncertain[..]};
    ownership_flow.program input = ownership_flow.program{.function = c->function,
        .identity = c->identity, .entry = &c->entry, .services = &c->services,
        .limits = &c->limits, .steps = c->steps[..c->steps_len],
        .flags = c->flag_edges[..c->flag_edges_len],
        .events = c->events[..c->events_len], .places = c->bindings[..c->bindings_len],
        .source_files = c->files[..],
        .result_slot = c->result_slot, .supplied_complete = true, .verified_fir = true,
        .observed = &seen, .continue_separate = true};
    c->result = ownership_flow.solve(&input);
    validate(c);
    first_reason(c);
    bool clean = c->result.failures == 0 && c->unvalidated == 0 && c->records_len == 0;
    // A validated violation is local. Otherwise the second run decides the scope. A refusal
    // explains no failure, so the body stays in the declared scope: after a refusal of the
    // first run no second run starts, and a refusal of the second run moves nothing.
    if (!clean && c->gap == missing.none && c->violations_len == 0 &&
        !c->first_refusal.terminal.present && call_dependent(c)) {
        note_gap(c, missing.call_dependent, c->first_incomplete.terminal.source);
        c->correspondence = status.incomplete;
    }
    // A refused classification run leaves the solver of the body incomplete.
    bool ran = c->result.blocks.len > 0;
    c->solver = ran && !c->first_refusal.terminal.present &&
        !c->classify_refusal.terminal.present && !c->result.stops_lost && !c->records_lost ?
        status.complete : status.incomplete;
    release_work(c);
    if (c->violations_len > 0) {
        c->proof = complete();
        c->proof.failed = true;
    } else if (c->correspondence == status.complete && c->solver == status.complete && clean) {
        c->proof = complete();
    } else {
        c->proof = c->first_incomplete;
        if (!c->proof.terminal.present) {
            c->proof = ownership_api.incomplete(ownership_api.incomplete_reason.missing_path,
                ownership_api.operation_position{.function = c->identity}, c->declaration);
        }
    }
}

fn same_violation(violation* a, violation* b) bool {
    return ownership_keys.operation(a->operation, b->operation) == 0 && a->kind == b->kind &&
        a->text == b->text && a->leaf == WHOLE && b->leaf == WHOLE && a->name == b->name;
}

/// Removes from a stored run each violation that the local run validated: the same
/// operation, event, text and whole local. The local row reports it, and toolchain 1.1 counts
/// a diagnostic once. A stored run left with no violation but stopped by a local one has
/// incomplete proof at the first removed operation.
fn exclude(context mut* stored, context* local) void {
    if (!stored->solved || !local->solved || !stored->stored) {
        panic("ownership_source_local: invalid exclusion order");
    }
    u64 before = stored->violations_len;
    u64 mut kept = 0;
    u64 mut removed = 0;
    violation mut first = violation{};
    u64 mut i = 0;
    while (i < stored->violations_len) {
        bool mut repeated = false;
        u64 mut j = 0;
        while (j < local->violations_len && !repeated) {
            repeated = same_violation(&stored->violations[i], &local->violations[j]);
            j += 1;
        }
        if (repeated) {
            if (removed == 0) { first = stored->violations[i]; }
            removed += 1;
        } else {
            stored->violations[kept] = stored->violations[i];
            kept += 1;
        }
        i += 1;
    }
    if (kept == before) { return; }
    stored->violations_len = kept;
    if (kept == 0) {
        stored->proof = ownership_api.incomplete(ownership_api.incomplete_reason.missing_path,
            first.operation, first.source);
    }
}

// Releases the flow input, the path states and the records. Results stay for the report.
fn release_work(context mut* c) void {
    ownership_flow.free(&c->result);
    ownership_state.free(&c->entry);
    del(c->steps);
    del(c->step_slot);
    del(c->barrier);
    del(c->step_events);
    del(c->relations);
    del(c->extras);
    del(c->weak_places);
    del(c->bindings);
    del(c->events);
    del(c->event_info);
    del(c->records);
    del(c->step_attempts);
    del(c->step_uncertain);
    del(c->return_attempts);
    del(c->return_uncertain);
    del(c->flag_edges);
    c->steps_len = 0;
    c->events_len = 0;
    c->records_len = 0;
    c->flag_edges_len = 0;
    c->weak_places_len = 0;
    c->bindings_len = 0;
}

fn free(context mut* c) void {
    release_work(c);
    del(c->tracked);
    del(c->owning);
    del(c->taken);
    del(c->transient);
    del(c->flag);
    del(c->flag_index);
    del(c->offset);
    u64 mut k = 0;
    while (k < c->flag_live.len) { fir_flow.bits_free(&c->flag_live[k]); k += 1; }
    del(c->flag_live);
    del(c->violations);
    del(c->stack_units);
    ownership_source_leaves.free(&c->leaves);
    *c = context{};
}

/// Whether a witness path reaches position `gap` of `block` in `f`, as witness decides it. Each
/// searched block and each evaluated statement charges `ledger`. A refusal sets `*refusal`.
/// `*taken` is the table of mark_taken for `f`: the walk uses it and gives it back, so a caller
/// that validates many failures marks the body once.
// Another analysis of the same body uses this walk with a ledger of its own.
fn witness_in(fir.func* f, ownership_api.function_id identity,
    ownership_api.source_position declaration, bool mut@ own mut* taken,
    ownership_limits.meter mut* ledger, ownership_api.proof_status mut* refusal,
    fir.pred_table* preds, u32 block, u32 gap) bool {
    context mut c = context{};
    c.function = f;
    c.identity = identity;
    c.declaration = declaration;
    c.taken = move(*taken);
    c.meter = *ledger;
    c.first_refusal = *refusal;
    bool found = witness(&c, preds, block, gap, trap.no_trap);
    *ledger = c.meter;
    *refusal = c.first_refusal;
    *taken = move(c.taken);
    return found;
}
