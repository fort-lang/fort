/// Substitutes caller storage into ordered symbolic call records.
import ast;
import fir;
import ownership_api;
import ownership_keys;
import ownership_places;
import ownership_state;
import ownership_summary_model;
import ownership_transfer;
import types;

struct source_binding {
    ownership_api.entity_id formal;
    ownership_api.source_fact actual;
    ownership_api.region range;
    ownership_api.entity_id value_version;
    ownership_api.entity_id formal_range;
}

struct allocation_binding {
    ownership_api.entity_id formal;
    ownership_api.allocation_fact actual;
    bool fresh_proved;
}

struct capture_binding {
    ownership_api.entity_id formal;
    ownership_api.entity_id actual;
    ownership_api.scalar_fact value;
}

struct event_binding {
    ownership_api.operation_position operation;
    ownership_api.entity_id key;
}

struct request {
    ownership_summary_model.summary_view* summary;
    ownership_api.state_view before;
    ownership_api.operation_position operation;
    ownership_api.source_position source;
    ownership_api.alias_binding@ aliases;
    source_binding@ sources;
    allocation_binding@ allocations;
    capture_binding@ captures;
    ownership_api.alias_binding@ globals;
    ownership_api.result_binding result;
    event_binding@ events;
    ownership_api.services* services;
    ownership_api.limit_table limits;
    ownership_summary_model.coverage_status coverage;
    bool correspondence_complete;
    bool event_map_complete;
}

// Nested paths and ranges use metadata. The model owns its substituted records.
struct frame {
    ownership_summary_model.summary model;
    ownership_state.state metadata;
    ownership_api.alias_binding mut@ own aliases;
    source_binding mut@ own sources;
    allocation_binding mut@ own allocations;
    capture_binding mut@ own captures;
    ownership_api.place_path mut@ own destinations;
    ownership_api.ordered_effect mut@ own result_writes;
    ownership_api.ordering_constraint mut@ own result_order;
    u64 destinations_len;
    ownership_api.result_binding result;
    ownership_api.outcome_fact outcome;
    ownership_api.proof_status proof;
    // The relations of this call, as charged to E. The count starts at the model count.
    u64 relations;
    ownership_summary_model.coverage_status coverage;
    bool residual_overlap;
}

fn free_frame(frame mut* out) void {
    frame mut owned = move(*out);
    ownership_summary_model.free(&owned.model);
    ownership_state.free(&owned.metadata);
    del(owned.aliases);
    del(owned.sources);
    del(owned.allocations);
    del(owned.captures);
    del(owned.destinations);
    del(owned.result_writes);
    del(owned.result_order);
    *out = frame{};
}

fn work(frame mut* out, ownership_summary_model.context* ctx, u64 amount) bool {
    return ownership_summary_model.work(ctx, &out->proof, amount);
}

fn key(frame mut* out, ownership_summary_model.context* ctx,
    ownership_api.entity_id input) ownership_api.entity_id {
    {
        source_binding@ rows_0 = out->sources[..];
        u64 mut row_index_0 = 0;
        while (row_index_0 < rows_0.len) {
            source_binding mut row = rows_0[row_index_0];
            row_index_0 += 1;
            if (!work(out, ctx, 1)) { return input; }
            if (ownership_summary_model.same(row.formal, input)) { return row.actual.key; }

        }
    }
    {
        allocation_binding@ rows_1 = out->allocations[..];
        u64 mut row_index_1 = 0;
        while (row_index_1 < rows_1.len) {
            allocation_binding mut row = rows_1[row_index_1];
            row_index_1 += 1;
            if (!work(out, ctx, 1)) { return input; }
            if (ownership_summary_model.same(row.formal, input)) { return row.actual.key; }

        }
    }
    {
        capture_binding@ rows_2 = out->captures[..];
        u64 mut row_index_2 = 0;
        while (row_index_2 < rows_2.len) {
            capture_binding mut row = rows_2[row_index_2];
            row_index_2 += 1;
            if (!work(out, ctx, 1)) { return input; }
            if (ownership_summary_model.same(row.formal, input)) { return row.actual; }

        }
    }
    return input;
}

fn scalar(frame mut* out, ownership_summary_model.context* ctx,
    ownership_api.scalar_fact input) ownership_api.scalar_fact {
    ownership_api.scalar_fact mut result = input;
    result.symbol = key(out, ctx, input.symbol);
    if (input.kind == ownership_api.fact_kind.symbolic) {
        {
            capture_binding@ rows_3 = out->captures[..];
            u64 mut row_index_3 = 0;
            while (row_index_3 < rows_3.len) {
                capture_binding mut row = rows_3[row_index_3];
                row_index_3 += 1;
                if (!work(out, ctx, 1)) { return result; }
                if (ownership_summary_model.same(row.formal, input.symbol)) { return row.value; }

            }
        }
    }
    return result;
}

fn path(frame mut* out, ownership_summary_model.context* ctx,
    ownership_api.place_path input) ownership_api.place_path {
    ownership_api.place_path mut base = input;
    bool mut bound = false;
    {
        ownership_api.alias_binding@ rows_4 = out->aliases[..];
        u64 mut row_index_4 = 0;
        while (row_index_4 < rows_4.len) {
            ownership_api.alias_binding mut row = rows_4[row_index_4];
            row_index_4 += 1;
            if (!work(out, ctx, 1)) { return input; }
            if (ownership_summary_model.same(row.formal, input.root)) {
                base = row.actual;
                bound = true;
                break;
            }

        }
    }
    if (!bound) {
        ownership_api.projection@ none = {};
        base.projections = none;
    }
    if (base.projections.len > types.TYPE_MAX_SIZE / sizeof(ownership_api.projection) ||
        input.projections.len > types.TYPE_MAX_SIZE / sizeof(ownership_api.projection) -
        base.projections.len) {
        out->proof = ownership_summary_model.fail(ctx, ownership_api.incomplete_reason.work_limit,
            input.root);
        return input;
    }
    if (!work(out, ctx, 2) || !work(out, ctx, base.projections.len) ||
        !work(out, ctx, input.projections.len)) { return input; }
    ownership_state.slice_block mut* own block = new(ownership_state.slice_block);
    block->projections = new(ownership_api.projection,
        base.projections.len + input.projections.len);
    ownership_api.projection mut@ parts = block->projections[..];
    ownership_state.keep(&out->metadata, move(block));
    u64 mut i = 0;
    while (i < base.projections.len) { parts[i] = base.projections[i]; i += 1; }
    u64 mut j = 0;
    while (j < input.projections.len) {
        if (!work(out, ctx, 1)) { return input; }
        ownership_api.projection mut part = input.projections[j];
        part.captured_version = key(out, ctx, part.captured_version);
        part.index = scalar(out, ctx, part.index);
        parts[i] = part;
        i += 1;
        j += 1;
    }
    base.residual = base.residual || input.residual;
    base.projections = parts[..];
    return base;
}

fn range(frame mut* out, ownership_summary_model.context* ctx,
    ownership_api.region input) ownership_api.region {
    ownership_api.region mut result = input;
    u64 mut binding_index = 0;
    while (binding_index < out->sources.len) {
        if (!work(out, ctx, 1)) { return input; }
        source_binding row = out->sources[binding_index];
        if (ownership_summary_model.same(input.key, row.formal_range)) {
            if (!ownership_summary_model.same(input.source, row.formal)) {
                out->proof = ownership_summary_model.fail(ctx,
                    ownership_api.incomplete_reason.invalid_input, input.key);
                return input;
            }
            result = row.range;
            break;
        }
        binding_index += 1;
    }
    result.source = key(out, ctx, input.source);
    result.offset = scalar(out, ctx, result.offset);
    result.extent = scalar(out, ctx, result.extent);
    result.access.begin = scalar(out, ctx, result.access.begin);
    result.access.end = scalar(out, ctx, result.access.end);
    if (!ownership_summary_model.region_charge(ctx, &out->proof, result)) { return input; }
    ownership_state.slice_block mut* own block = new(ownership_state.slice_block);
    block->leaves = new(ownership_api.layout_leaf, result.leaves.len);
    block->partitions = new(ownership_api.region_partition, result.partitions.len);
    ownership_api.layout_leaf mut@ leaves = block->leaves[..];
    ownership_api.region_partition mut@ partitions = block->partitions[..];
    ownership_state.keep(&out->metadata, move(block));
    u64 mut i = 0;
    while (i < result.leaves.len) {
        if (!work(out, ctx, 1)) { return input; }
        leaves[i] = result.leaves[i];
        leaves[i].bytes.begin = scalar(out, ctx, leaves[i].bytes.begin);
        leaves[i].bytes.end = scalar(out, ctx, leaves[i].bytes.end);
        i += 1;
    }
    i = 0;
    while (i < result.partitions.len) {
        if (!work(out, ctx, 1)) { return input; }
        partitions[i] = result.partitions[i];
        partitions[i].membership = key(out, ctx, partitions[i].membership);
        partitions[i].bytes.begin = scalar(out, ctx, partitions[i].bytes.begin);
        partitions[i].bytes.end = scalar(out, ctx, partitions[i].bytes.end);
        i += 1;
    }
    result.leaves = leaves[..];
    result.partitions = partitions[..];
    return result;
}

fn bound_key(frame mut* out, ownership_summary_model.context* ctx,
    ownership_api.entity_id input) bool {
    if (input.kind == ownership_api.entity_kind.none) { return true; }
    u64 mut i = 0;
    while (i < out->sources.len) {
        if (!work(out, ctx, 1)) { return false; }
        if (ownership_summary_model.same(out->sources[i].formal, input)) { return true; }
        i += 1;
    }
    i = 0;
    while (i < out->allocations.len) {
        if (!work(out, ctx, 1)) { return false; }
        if (ownership_summary_model.same(out->allocations[i].formal, input)) { return true; }
        i += 1;
    }
    i = 0;
    while (i < out->captures.len) {
        if (!work(out, ctx, 1)) { return false; }
        if (ownership_summary_model.same(out->captures[i].formal, input)) { return true; }
        i += 1;
    }
    return false;
}

fn required_bindings(frame mut* out, ownership_summary_model.context* ctx) bool {
    u64 mut i = 0;
    while (i < out->model.roots.len) {
        if (!work(out, ctx, 1)) { return false; }
        ownership_summary_model.symbolic_root root = out->model.roots[i];
        if (root.kind != ownership_summary_model.root_kind.by_value_slot) {
            bool mut slot_found = root.kind
                == ownership_summary_model.root_kind.allocation_template;
            u64 mut j = 0;
            while (j < out->aliases.len) {
                if (!work(out, ctx, 1)) { return false; }
                if (ownership_summary_model.same(root.slot, out->aliases[j].formal)) {
                    slot_found = true;
                }
                j += 1;
            }
            if (!slot_found || !bound_key(out, ctx, root.source) ||
                !bound_key(out, ctx, root.allocation) || !bound_key(out, ctx, root.value_version)) {
                if (!ownership_api.successful(out->proof)) { return false; }
                out->proof = ownership_summary_model.fail(ctx,
                    ownership_api.incomplete_reason.missing_correspondence, root.key);
                return false;
            }
        }
        i += 1;
    }
    return ownership_api.successful(out->proof);
}

fn borrow_list(frame mut* out, ownership_summary_model.context* ctx,
    ownership_api.borrow_relation@ input) ownership_api.borrow_relation@ {
    if (input.len > types.TYPE_MAX_SIZE / sizeof(ownership_api.borrow_relation) ||
        !work(out, ctx, 2) || !work(out, ctx, input.len)) { return input; }
    ownership_state.slice_block mut* own block = new(ownership_state.slice_block);
    block->borrows = new(ownership_api.borrow_relation, input.len);
    ownership_api.borrow_relation mut@ rows = block->borrows[..];
    ownership_state.keep(&out->metadata, move(block));
    u64 mut i = 0;
    while (i < input.len) {
        if (!work(out, ctx, 1)) { return rows[..]; }
        rows[i] = borrow(out, ctx, input[i]);
        i += 1;
    }
    return rows[..];
}

fn borrow(frame mut* out, ownership_summary_model.context* ctx,
    ownership_api.borrow_relation input) ownership_api.borrow_relation {
    ownership_api.borrow_relation mut result = input;
    result.containing = path(out, ctx, input.containing);
    result.source = key(out, ctx, input.source);
    result.value_version = key(out, ctx, input.value_version);
    result.range = range(out, ctx, input.range);
    return result;
}

fn valid_source(request* req, frame mut* out, ownership_summary_model.context* ctx,
    source_binding row) bool {
    if (row.formal.kind != ownership_api.entity_kind.source ||
        row.actual.key.kind != ownership_api.entity_kind.source ||
        !ownership_summary_model.same(row.range.source, row.actual.key)) { return false; }
    u64 mut root_index = 0;
    while (root_index < out->model.roots.len) {
        if (!work(out, ctx, 1)) { return false; }
        ownership_summary_model.symbolic_root root = out->model.roots[root_index];
        if (root.kind == ownership_summary_model.root_kind.by_value_slot &&
            ownership_summary_model.same(row.formal, root.source)) { return false; }
        root_index += 1;
    }
    {
        ownership_api.source_fact@ rows_5 = req->before.sources[..];
        u64 mut row_index_5 = 0;
        while (row_index_5 < rows_5.len) {
            ownership_api.source_fact mut known = rows_5[row_index_5];
            row_index_5 += 1;
            if (!work(out, ctx, 1)) { return false; }
            if (ownership_summary_model.same(known.key, row.actual.key)) {
                return ownership_state.same_source(known, row.actual);
            }

        }
    }
    return false;
}

fn add_alias(frame mut* out, ownership_summary_model.context* ctx,
    ownership_api.alias_binding row, u64 index) bool {
    if (!work(out, ctx, 1) || row.formal.kind != ownership_api.entity_kind.slot ||
        row.actual.root.kind != ownership_api.entity_kind.slot) { return false; }
    {
        ownership_summary_model.symbolic_root@ rows_6 = out->model.roots[..];
        u64 mut row_index_6 = 0;
        while (row_index_6 < rows_6.len) {
            ownership_summary_model.symbolic_root mut root = rows_6[row_index_6];
            row_index_6 += 1;
            if (!work(out, ctx, 1)) { return false; }
            if (root.kind == ownership_summary_model.root_kind.by_value_slot &&
                ownership_summary_model.same(root.slot, row.formal)) { return false; }

        }
    }
    u64 mut i = 0;
    while (i < index) {
        if (!work(out, ctx, 1)) { return false; }
        if (ownership_summary_model.same(out->aliases[i].formal, row.formal)) { return false; }
        i += 1;
    }
    if (!ownership_summary_model.path_charge(ctx, &out->proof, row.actual)) { return false; }
    ownership_api.alias_binding mut stored = row;
    stored.actual = ownership_state.copy_place(&out->metadata, row.actual);
    out->aliases[index] = stored;
    if (ownership_state.has_residual(row.actual)) { out->residual_overlap = true; }
    bool mut found = false;
    i = 0;
    while (i < out->destinations_len) {
        if (!work(out, ctx, 1) || !work(out, ctx, row.actual.projections.len) ||
            !work(out, ctx, out->destinations[i].projections.len)) { return false; }
        if (ownership_state.same_place(row.actual, out->destinations[i])) { found = true; }
        i += 1;
    }
    if (!found) {
        out->destinations[out->destinations_len] = stored.actual;
        out->destinations_len += 1;
    }
    return true;
}

fn copy_bindings(request* req, frame mut* out, ownership_summary_model.context* ctx) bool {
    u64 maximum = types.TYPE_MAX_SIZE / sizeof(ownership_api.alias_binding);
    if (req->aliases.len > maximum || req->globals.len > maximum - req->aliases.len ||
        req->result.aliases.len > maximum - req->aliases.len - req->globals.len ||
        req->sources.len > types.TYPE_MAX_SIZE / sizeof(source_binding) ||
        req->allocations.len > types.TYPE_MAX_SIZE / sizeof(allocation_binding) ||
        req->captures.len > types.TYPE_MAX_SIZE / sizeof(capture_binding)) { return false; }
    u64 mut count = req->aliases.len + req->globals.len + req->result.aliases.len;
    u64 mut result_count = 0;
    {
        ownership_summary_model.symbolic_root@ rows_7 = out->model.roots[..];
        u64 mut row_index_7 = 0;
        while (row_index_7 < rows_7.len) {
            ownership_summary_model.symbolic_root mut root = rows_7[row_index_7];
            row_index_7 += 1;
            if (!work(out, ctx, 1)) { return false; }
            if (root.kind == ownership_summary_model.root_kind.result) { result_count += 1; }

        }
    }
    if (result_count > maximum - count) { return false; }
    count += result_count;
    if (!work(out, ctx, 2) || !work(out, ctx, count) || !work(out, ctx, count)) { return false; }
    out->aliases = new(ownership_api.alias_binding, count);
    out->destinations = new(ownership_api.place_path, count);
    u64 mut index = 0;
    {
        ownership_api.alias_binding@ rows_8 = req->aliases[..];
        u64 mut row_index_8 = 0;
        while (row_index_8 < rows_8.len) {
            ownership_api.alias_binding mut row = rows_8[row_index_8];
            row_index_8 += 1;
            if (!add_alias(out, ctx, row, index)) { return false; }
            index += 1;

        }
    }
    {
        ownership_api.alias_binding@ rows_9 = req->globals[..];
        u64 mut row_index_9 = 0;
        while (row_index_9 < rows_9.len) {
            ownership_api.alias_binding mut row = rows_9[row_index_9];
            row_index_9 += 1;
            if (!add_alias(out, ctx, row, index)) { return false; }
            index += 1;

        }
    }
    {
        ownership_api.alias_binding@ rows_10 = req->result.aliases[..];
        u64 mut row_index_10 = 0;
        while (row_index_10 < rows_10.len) {
            ownership_api.alias_binding mut row = rows_10[row_index_10];
            row_index_10 += 1;
            if (!add_alias(out, ctx, row, index)) { return false; }
            index += 1;

        }
    }
    {
        ownership_summary_model.symbolic_root@ rows_11 = out->model.roots[..];
        u64 mut row_index_11 = 0;
        while (row_index_11 < rows_11.len) {
            ownership_summary_model.symbolic_root mut root = rows_11[row_index_11];
            row_index_11 += 1;
            if (!work(out, ctx, 1)) { return false; }
            if (root.kind == ownership_summary_model.root_kind.result) {
                ownership_api.alias_binding row = ownership_api.alias_binding{
                    root.slot, req->result.actual_slot, req->result.holding_value};
                if (!add_alias(out, ctx, row, index)) { return false; }
                index += 1;
            }

        }
    }
    if (!work(out, ctx, 1) || !work(out, ctx, req->sources.len)) { return false; }
    out->sources = new(source_binding, req->sources.len);
    index = 0;
    {
        source_binding@ rows_12 = req->sources[..];
        u64 mut row_index_12 = 0;
        while (row_index_12 < rows_12.len) {
            source_binding mut row = rows_12[row_index_12];
            row_index_12 += 1;
            if (!work(out, ctx, 1) || !valid_source(req, out, ctx, row)) { return false; }
            u64 mut j = 0;
            while (j < index) {
                if (!work(out, ctx, 1) ||
                    ownership_summary_model.same(out->sources[j].formal,
                        row.formal)) { return false; }
                j += 1;
            }
            if (!ownership_summary_model.region_charge(ctx, &out->proof,
                row.range)) { return false; }
            row.range = ownership_state.copy_region(&out->metadata, row.range);
            out->sources[index] = row;
            index += 1;

        }
    }
    if (!work(out, ctx, 1) || !work(out, ctx, req->allocations.len)) { return false; }
    out->allocations = new(allocation_binding, req->allocations.len);
    index = 0;
    {
        allocation_binding@ rows_13 = req->allocations[..];
        u64 mut row_index_13 = 0;
        while (row_index_13 < rows_13.len) {
            allocation_binding mut row = rows_13[row_index_13];
            row_index_13 += 1;
            if (!work(out, ctx, 1) || row.formal.kind != ownership_api.entity_kind.allocation ||
                row.actual.key.kind != ownership_api.entity_kind.allocation) { return false; }
            u64 mut j = 0;
            while (j < index) {
                if (!work(out, ctx, 1) ||
                    ownership_summary_model.same(out->allocations[j].formal, row.formal)) {
                    return false;
                }
                j += 1;
            }
            if (!ownership_summary_model.path_charge(ctx, &out->proof, row.actual.owner.place) ||
                !work(out, ctx, row.actual.history.len)) { return false; }
            {
                ownership_api.history_fact@ rows_14 = row.actual.history[..];
                u64 mut row_index_14 = 0;
                while (row_index_14 < rows_14.len) {
                    ownership_api.history_fact mut history = rows_14[row_index_14];
                    row_index_14 += 1;
                    if (!work(out, ctx, 1) ||
                        !ownership_summary_model.path_charge(ctx, &out->proof,
                            history.before.place) ||
                        !ownership_summary_model.path_charge(ctx, &out->proof,
                            history.after.place)) {
                        return false;
                    }

                }
            }
            bool mut found = false;
            {
                ownership_api.allocation_fact@ rows_15 = req->before.allocations[..];
                u64 mut row_index_15 = 0;
                while (row_index_15 < rows_15.len) {
                    ownership_api.allocation_fact mut known = rows_15[row_index_15];
                    row_index_15 += 1;
                    if (!work(out, ctx, 1)) { return false; }
                    if (ownership_summary_model.same(known.key, row.actual.key)) {
                        if (row.fresh_proved || !ownership_state.same_allocation(known,
                            row.actual)) {
                            return false;
                        }
                        found = true;
                    }

                }
            }
            if (!found && !row.fresh_proved) { return false; }
            if (!ownership_summary_model.path_charge(ctx, &out->proof, row.actual.owner.place) ||
                !work(out, ctx, 2) || !work(out, ctx, row.actual.history.len)) { return false; }
            {
                ownership_api.history_fact@ rows_16 = row.actual.history[..];
                u64 mut row_index_16 = 0;
                while (row_index_16 < rows_16.len) {
                    ownership_api.history_fact mut history = rows_16[row_index_16];
                    row_index_16 += 1;
                    if (!work(out, ctx, 1) ||
                        !ownership_summary_model.path_charge(ctx, &out->proof,
                            history.before.place) ||
                        !ownership_summary_model.path_charge(ctx, &out->proof,
                            history.after.place)) {
                        return false;
                    }

                }
            }
            row.actual = ownership_state.copy_allocation(&out->metadata, row.actual);
            out->allocations[index] = row;
            index += 1;

        }
    }
    if (!work(out, ctx, 1) || !work(out, ctx, req->captures.len)) { return false; }
    out->captures = new(capture_binding, req->captures.len);
    index = 0;
    {
        capture_binding@ rows_17 = req->captures[..];
        u64 mut row_index_17 = 0;
        while (row_index_17 < rows_17.len) {
            capture_binding mut row = rows_17[row_index_17];
            row_index_17 += 1;
            if (!work(out, ctx, 1) || row.formal.kind != ownership_api.entity_kind.value ||
                row.actual.kind != ownership_api.entity_kind.value) { return false; }
            u64 mut j = 0;
            while (j < index) {
                if (!work(out, ctx, 1) ||
                    ownership_summary_model.same(out->captures[j].formal, row.formal)) {
                    return false;
                }
                j += 1;
            }
            out->captures[index] = row;
            index += 1;

        }
    }
    return true;
}

fn substitute(request* req, frame mut* out, ownership_summary_model.context* ctx) bool {
    u64 mut i = 0;
    while (i < out->model.roots.len) {
        if (!work(out, ctx, 1)) { return false; }
        ownership_summary_model.symbolic_root mut* root = &out->model.roots[i];
        ownership_api.place_path mut original = ownership_api.place_path{.root = root->slot};
        if (root->kind == ownership_summary_model.root_kind.result) {
            original = req->result.actual_slot;
            if (original.root.kind != ownership_api.entity_kind.slot) { return false; }
            if (!ownership_summary_model.path_charge(ctx, &out->proof, original)) { return false; }
            out->result.actual_slot = ownership_state.copy_place(&out->metadata, original);
            root->slot = original.root;
        } else if (root->kind != ownership_summary_model.root_kind.by_value_slot) {
            root->slot = path(out, ctx, original).root;
        }
        root->source = key(out, ctx, root->source);
        root->allocation = key(out, ctx, root->allocation);
        root->value_version = key(out, ctx, root->value_version);
        i += 1;
    }
    i = 0;
    while (i < out->model.requirements.len) {
        if (!work(out, ctx, 1)) { return false; }
        ownership_summary_model.requirement mut* row = &out->model.requirements[i];
        row->path = path(out, ctx, row->path);
        row->source = key(out, ctx, row->source);
        row->range = range(out, ctx, row->range);
        i += 1;
    }
    i = 0;
    while (i < out->model.effects.len) {
        if (!work(out, ctx, 1)) { return false; }
        ownership_summary_model.effect_node mut* row = &out->model.effects[i];
        row->effect.place = path(out, ctx, row->effect.place);
        row->effect.source = key(out, ctx, row->effect.source);
        row->effect.allocation = key(out, ctx, row->effect.allocation);
        row->operand = path(out, ctx, row->operand);
        row->value.place = path(out, ctx, row->value.place);
        row->value.value_version = key(out, ctx, row->value.value_version);
        row->value.span_length = scalar(out, ctx, row->value.span_length);
        row->range = range(out, ctx, row->range);
        row->value.borrows = borrow_list(out, ctx, row->value.borrows);
        i += 1;
    }
    i = 0;
    while (i < out->model.results.len) {
        if (!work(out, ctx, 1)) { return false; }
        out->model.results[i].borrow = borrow(out, ctx, out->model.results[i].borrow);
        i += 1;
    }
    i = 0;
    while (i < out->model.retained.len) {
        if (!work(out, ctx, 1)) { return false; }
        out->model.retained[i].borrow = borrow(out, ctx, out->model.retained[i].borrow);
        i += 1;
    }
    i = 0;
    while (i < out->model.predicates.len) {
        if (!work(out, ctx, 1)) { return false; }
        ownership_api.predicate_atom mut* row = &out->model.predicates[i];
        row->left = key(out, ctx, row->left);
        row->right = key(out, ctx, row->right);
        row->lower = scalar(out, ctx, row->lower);
        row->upper = scalar(out, ctx, row->upper);
        i += 1;
    }
    i = 0;
    while (i < out->model.correlations.len) {
        if (!work(out, ctx, 1)) { return false; }
        out->model.correlations[i].value_version = key(out, ctx,
            out->model.correlations[i].value_version);
        i += 1;
    }
    effect_blocks(out, ctx);
    if (req->result.writes.len > types.TYPE_MAX_SIZE / sizeof(ownership_api.ordered_effect) ||
        req->result.order.len > types.TYPE_MAX_SIZE / sizeof(ownership_api.ordering_constraint) ||
        !work(out, ctx, 2) || !work(out, ctx, req->result.writes.len) ||
        !work(out, ctx, req->result.order.len)) { return false; }
    out->result_writes = new(ownership_api.ordered_effect, req->result.writes.len);
    out->result_order = new(ownership_api.ordering_constraint, req->result.order.len);
    i = 0;
    while (i < req->result.writes.len) {
        if (!work(out, ctx, 1)) { return false; }
        out->result_writes[i] = substitute_effect(out, ctx, req->result.writes[i]);
        i += 1;
    }
    i = 0;
    while (i < req->result.order.len) {
        if (!work(out, ctx, 1)) { return false; }
        out->result_order[i] = req->result.order[i];
        i += 1;
    }
    out->result.aliases = out->aliases[..];
    out->result.holding_value = key(out, ctx, req->result.holding_value);
    out->result.writes = out->result_writes[..];
    out->result.order = out->result_order[..];
    return ownership_api.successful(out->proof);
}

fn substitute_effect(frame mut* out, ownership_summary_model.context* ctx,
    ownership_api.ordered_effect input) ownership_api.ordered_effect {
    ownership_api.ordered_effect mut result = input;
    result.place = path(out, ctx, input.place);
    result.source = key(out, ctx, input.source);
    result.allocation = key(out, ctx, input.allocation);
    return result;
}

fn effect_blocks(frame mut* out, ownership_summary_model.context* ctx) void {
    ownership_summary_model.effect_block mut* mut block = out->model.outcome_blocks;
    while (block != null) {
        if (!work(out, ctx, 1)) { return; }
        u64 mut i = 0;
        while (i < block->items.len) {
            if (!work(out, ctx, 1)) { return; }
            block->items[i] = substitute_effect(out, ctx, block->items[i]);
            i += 1;
        }
        block = block->next;
    }
}

fn bind(request* req) frame {
    frame mut out = frame{};
    out.proof = ownership_summary_model.complete();
    out.outcome.kind = ownership_api.outcome_kind.unknown_fort;
    out.outcome.possible_caller_return = true;
    out.outcome.cleanup_required = true;
    ownership_summary_model.context mut ctx = ownership_summary_model.context{
        req->services, req->operation, req->source, ownership_api.entity_id{},
        req->summary == null ? ownership_api.source_position{} : req->summary->source};
    if (req->services == null || req->summary == null) {
        out.proof = ownership_summary_model.fail(&ctx,
            ownership_api.incomplete_reason.invalid_input, ctx.event);
        return out;
    }
    u64 mut matches = 0;
    {
        event_binding@ rows_18 = req->events[..];
        u64 mut row_index_18 = 0;
        while (row_index_18 < rows_18.len) {
            event_binding mut row = rows_18[row_index_18];
            row_index_18 += 1;
            if (!work(&out, &ctx, 1)) { return out; }
            if (ownership_keys.operation(row.operation, req->operation) == 0) {
                ctx.event = row.key;
                matches += 1;
            }

        }
    }
    if (!req->event_map_complete || matches != 1 ||
        ctx.event.kind != ownership_api.entity_kind.event ||
        ownership_keys.function(ctx.event.function, ctx.operation.function) != 0 ||
        !ownership_api.valid_limits(&req->limits) || !req->correspondence_complete) {
        out.proof = ownership_summary_model.fail(&ctx,
            ownership_api.incomplete_reason.missing_correspondence, ctx.event);
        return out;
    }
    ownership_summary_model.summary_view mut input = *req->summary;
    input.operation = req->operation;
    input.source = req->source;
    input.event = ctx.event;
    input.callee_source = req->summary->source;
    out.model = ownership_summary_model.clone(&input, req->services);
    out.proof = out.model.proof;
    out.relations = out.model.relations;
    out.coverage = req->coverage;
    out.coverage.actual_source_complete = false;
    if (!ownership_api.successful(out.proof)) { return out; }
    if (!copy_bindings(req, &out, &ctx) || !required_bindings(&out, &ctx) ||
        !substitute(req, &out, &ctx) || out.residual_overlap) {
        if (ownership_api.successful(out.proof)) {
            out.proof = ownership_summary_model.fail(&ctx,
                out.residual_overlap ? ownership_api.incomplete_reason.missing_path :
            ownership_api.incomplete_reason.invalid_input, ctx.event);
        }
        out.model.residual_effects = true;
        out.proof = ownership_summary_model.report(&ctx, out.proof);
        out.model.proof = out.proof;
    }
    return out;
}

// A linear application owns its frame and final continuation facts.
// Its views end when this owner changes or ends. Failure preserves the caller input.
struct application {
    frame bound;
    ownership_state.state state;
    ownership_api.outcome_fact outcome;
    ownership_api.proof_status proof;
    bool normal_continuation;
}

fn free(application mut* out) void {
    application mut owned = move(*out);
    free_frame(&owned.bound);
    ownership_state.free(&owned.state);
    *out = application{};
}

fn caller_failure(request* req, application mut* out, ownership_api.entity_id relation,
    ownership_api.operation_position callee, ownership_api.incomplete_reason reason,
    string message) ownership_api.proof_status {
    ownership_api.proof_status mut proof = ownership_summary_model.complete();
    proof.failed = true;
    if (reason != ownership_api.incomplete_reason.none) {
        proof = ownership_api.incomplete(reason, req->operation, req->source);
        proof.terminal.relation = relation;
    }
    ownership_summary_model.context ctx = ownership_summary_model.context{req->services,
        req->operation, req->source, out->bound.model.event, req->summary->source};
    ownership_api.source_position mut callee_source = req->summary->source;
    ownership_api.proof_status mut scan_proof = ownership_summary_model.complete();
    u64 mut p = 0;
    while (p < req->summary->provenance_records.len) {
        if (!ownership_summary_model.work(&ctx, &scan_proof, 1)) { return scan_proof; }
        ownership_summary_model.provenance item = req->summary->provenance_records[p];
        if (ownership_keys.operation(item.operation, callee) == 0) { callee_source = item.source; }
        p += 1;
    }
    ownership_api.event_note[2] notes = {
        ownership_api.event_note{.role = ownership_api.note_role.callee,
            .source = callee_source, .relation = relation},
        ownership_api.event_note{.role = ownership_api.note_role.substitution,
            .source = req->source, .relation = relation},
    };
    u64 mut note_count = 1;
    p = 0;
    while (p < out->bound.model.requirements.len) {
        if (!ownership_summary_model.work(&ctx, &scan_proof, 1)) { return scan_proof; }
        ownership_summary_model.requirement item = out->bound.model.requirements[p];
        if (item.kind == ownership_summary_model.requirement_kind.empty_output &&
            ownership_summary_model.same(item.path.root, relation)) { note_count = 2; }
        p += 1;
    }
    ownership_api.event_descriptor event = ownership_api.event_descriptor{
        .key = out->bound.model.event, .operation = req->operation, .source = req->source,
        .kind = reason == ownership_api.incomplete_reason.none ?
            ownership_api.event_kind.caller_requirement : ownership_api.event_kind.incomplete_proof,
        .evidence = reason == ownership_api.incomplete_reason.none ?
            ownership_api.evidence_kind.unconditional
                : ownership_api.evidence_kind.abstract_possibility,
        .relation = relation, .text = message, .notes = notes[..note_count]};
    ownership_api.event_request report = ownership_api.event_request{event, proof};
    return ownership_api.record_event(req->services, &report).proof;
}

fn copy_caller(request* req, application mut* out, ownership_summary_model.context* ctx) bool {
    out->state = ownership_state.empty();
    out->state.proof = req->before.proof;
    if (!ownership_api.successful(out->state.proof)) {
        out->proof = out->state.proof;
        return false;
    }
    u64 mut i = 0;
    while (i < req->before.contents.len) {
        if (!ownership_summary_model.contents_charge(ctx, &out->proof, req->before.contents[i])) {
            return false;
        }
        ownership_state.append_contents(&out->state, req->before.contents[i]);
        i += 1;
    }
    i = 0;
    while (i < req->before.sources.len) {
        if (!ownership_summary_model.work(ctx, &out->proof, 1)) { return false; }
        ownership_state.append_sources(&out->state, req->before.sources[i]);
        i += 1;
    }
    i = 0;
    while (i < req->before.allocations.len) {
        ownership_api.allocation_fact item = req->before.allocations[i];
        if (!ownership_summary_model.path_charge(ctx, &out->proof, item.owner.place) ||
            !ownership_summary_model.work(ctx, &out->proof, 2) ||
            !ownership_summary_model.work(ctx, &out->proof, item.history.len)) { return false; }
        u64 mut h = 0;
        while (h < item.history.len) {
            if (!ownership_summary_model.work(ctx, &out->proof, 1) ||
                !ownership_summary_model.path_charge(ctx, &out->proof,
                    item.history[h].before.place) ||
                !ownership_summary_model.path_charge(ctx, &out->proof,
                    item.history[h].after.place)) {
                return false;
            }
            h += 1;
        }
        ownership_state.append_allocations(&out->state, item);
        i += 1;
    }
    if (req->before.regions.len != 0 || req->before.nodes.len != 0 || req->before.edges.len != 0 ||
        req->before.shapes.len != 0 || req->before.predicates.len != 0
            || req->before.guards.len != 0 ||
        req->before.correlations.len != 0 || req->before.losses.len != 0) {
        out->proof = caller_failure(req, out, ownership_api.entity_id{}, req->operation,
            ownership_api.incomplete_reason.unknown_effect,
                "linear call needs complete local facts");
        return false;
    }
    return true;
}

fn linear_request(request* req, ownership_api.place_path src, ownership_api.place_path dst,
    ownership_transfer.action effect_action, ownership_transfer.event_binding@ events)
    ownership_transfer.request {
    return ownership_transfer.request{.kind = effect_action, .operation = req->operation,
        .source_position = req->source, .source = src, .destination = dst,
        .direct_source_proved = true, .direct_destination_proved = true,
        .event_map_complete_proved = true, .event_bindings = events};
}

// Output roots name designated storage. Other caller roots name argument values.
fn output_root(ownership_summary_model.summary_view* summary,
    ownership_api.entity_id root) bool {
    u64 mut i = 0;
    while (i < summary->requirements.len) {
        ownership_summary_model.requirement row = summary->requirements[i];
        if (ownership_summary_model.same(row.path.root, root) &&
            (row.kind == ownership_summary_model.requirement_kind.empty_output ||
                row.kind == ownership_summary_model.requirement_kind.valid_owner)) { return true; }
        i += 1;
    }
    return false;
}

fn argument_place(request* req, application mut* out, ownership_summary_model.context* ctx,
    u64 root) ownership_api.place_path {
    ownership_summary_model.symbolic_root formal = req->summary->roots[root];
    if (!ownership_summary_model.work(ctx, &out->proof, req->summary->requirements.len)) {
        return ownership_api.place_path{.residual = true};
    }
    if (!output_root(req->summary, formal.slot)) {
        return ownership_api.place_path{.root = out->bound.model.roots[root].slot};
    }
    u64 mut b = 0;
    while (b < out->bound.sources.len) {
        if (!ownership_summary_model.work(ctx, &out->proof, 1)) { break; }
        source_binding binding = out->bound.sources[b];
        if (ownership_summary_model.same(binding.formal, formal.source)) {
            ownership_api.place_path mut selected = ownership_api.place_path{.residual = true};
            u64 mut i = 0;
            while (i < out->state.contents_len) {
                if (!ownership_summary_model.work(ctx, &out->proof, 1)) { break; }
                ownership_api.contents_fact value = out->state.contents[i];
                if (value.borrows.len == 1 &&
                    ownership_summary_model.same(value.value_version, binding.value_version) &&
                    ownership_summary_model.same(value.borrows[0].source, binding.actual.key)) {
                    ownership_api.region supplied = value.borrows[0].range;
                    if (!ownership_summary_model.work(ctx, &out->proof,
                        supplied.leaves.len + supplied.partitions.len + binding.range.leaves.len +
                            binding.range.partitions.len)) { break; }
                    if (!ownership_state.same_region(supplied, binding.range)) {
                        return ownership_api.place_path{.residual = true};
                    }
                    selected = value.place;
                }
                i += 1;
            }
            if (!ownership_api.successful(out->proof)) {
                return ownership_api.place_path{.residual = true};
            }
            return selected;
        }
        b += 1;
    }
    return ownership_api.place_path{.residual = true};
}

fn selected_storage(request* req, application mut* out,
    ownership_summary_model.context* ctx, ownership_summary_model.requirement row) bool {
    if (!ownership_summary_model.work(ctx, &out->proof, out->state.contents_len) ||
        !ownership_summary_model.work(ctx, &out->proof, out->state.allocations_len * 4)) {
        return false;
    }
    u64 mut p = 0;
    while (p < out->state.contents_len) {
        if (!ownership_summary_model.work(ctx, &out->proof,
            out->state.contents[p].place.projections.len + row.path.projections.len)) {
            return false;
        }
        p += 1;
    }
    bool mut separated = true;
    p = 0;
    while (p < out->state.allocations_len) {
        ownership_api.allocation_fact item = out->state.allocations[p];
        if (!ownership_summary_model.work(ctx, &out->proof,
            (item.owner.place.projections.len + row.path.projections.len) * 4)) { return false; }
        if (item.obligation && !ownership_state.same_place(item.owner.place, row.path) &&
            ownership_places.compare(item.owner.place, row.path, true) !=
                ownership_places.overlap.disjoint) { separated = false; }
        p += 1;
    }
    u64 at = ownership_transfer.contents_index(&out->state, row.path);
    if (row.path.residual || at == ownership_api.U64_MAX) {
        out->proof = caller_failure(req, out, row.key, row.operation,
            ownership_api.incomplete_reason.missing_path,
            "call needs one complete selected output leaf");
        return false;
    }
    ownership_api.contents_fact value = out->state.contents[at];
    u64 count = ownership_transfer.owner_count(&out->state, row.path);
    bool vacant = ownership_transfer.empty_owner_proved(value) && count == 0 && separated;
    u64 owner = count == 1 ? ownership_transfer.owner_index(&out->state, row.path) :
        ownership_api.U64_MAX;
    bool live = owner != ownership_api.U64_MAX && !value.owner_empty && separated &&
        !out->state.allocations[owner].owner.detached &&
        !out->state.allocations[owner].owner.transfer_pending &&
        ownership_transfer.owner_reference_proved(&out->state, value,
            out->state.allocations[owner]);
    if (row.kind == ownership_summary_model.requirement_kind.empty_output) {
        if (vacant) { return true; }
        if (live) {
            out->proof = caller_failure(req, out, row.path.root, row.operation,
                ownership_api.incomplete_reason.none,
                "call requires an empty old output leaf");
            return false;
        }
    } else if (vacant) { return true; }
    else if (live) { return true; }
    out->proof = caller_failure(req, out, row.key, row.operation,
        ownership_api.incomplete_reason.missing_path,
        "cannot prove the selected old output owner");
    return false;
}

// Select the caller value through its original formal source.
fn caller_reference(request* req, application mut* out, ownership_summary_model.context* ctx,
    ownership_summary_model.requirement required, ownership_api.entity_id formal_source,
    u64 source, ownership_api.region mut* supplied) bool {
    u64 mut root = 0;
    bool mut found = false;
    while (root < out->bound.model.roots.len) {
        if (!ownership_summary_model.work(ctx, &out->proof, 1)) { return false; }
        ownership_summary_model.symbolic_root row = out->bound.model.roots[root];
        if (row.kind == ownership_summary_model.root_kind.caller_source &&
            ownership_summary_model.same(req->summary->roots[root].source, formal_source)) {
            ownership_api.place_path place = argument_place(req, out, ctx, root);
            if (place.residual || !ownership_api.successful(out->proof)) { break; }
            if (!ownership_summary_model.work(ctx, &out->proof, out->state.contents_len)) {
                return false;
            }
            u64 at = ownership_transfer.contents_index(&out->state, place);
            if (at == ownership_api.U64_MAX || found) { break; }
            ownership_api.contents_fact value = out->state.contents[at];
            if (value.kind != ownership_api.contents_kind.reference || value.owner_empty ||
                value.borrows.len != 1 || !value.borrows[0].representation_complete ||
                !ownership_summary_model.same(value.borrows[0].value_version,
                    value.value_version) ||
                !ownership_summary_model.same(value.borrows[0].source, required.source)) {
                break;
            }
            if (required.kind == ownership_summary_model.requirement_kind.extent &&
                value.span_length.kind == ownership_api.fact_kind.exact &&
                value.span_length.value == 0) {
                out->proof = caller_failure(req, out, required.key, required.operation,
                    ownership_api.incomplete_reason.none, "empty reference has no element");
                return false;
            }
            *supplied = value.borrows[0].range;
            found = true;
        }
        root += 1;
    }
    if (!found || root < out->bound.model.roots.len) {
        out->proof = caller_failure(req, out, required.key, required.operation,
            ownership_api.incomplete_reason.missing_correspondence,
            "call needs its current complete argument representation");
        return false;
    }
    ownership_api.entity_id allocation = out->state.sources[source].allocation;
    if (allocation.kind != ownership_api.entity_kind.none) {
        u64 mut at = 0;
        bool mut present = false;
        while (at < out->state.allocations_len) {
            if (!ownership_summary_model.work(ctx, &out->proof, 1)) { return false; }
            ownership_api.allocation_fact item = out->state.allocations[at];
            if (ownership_summary_model.same(item.key, allocation)) {
                present = true;
                if (item.validity != ownership_api.validity_kind.live) {
                    out->proof = caller_failure(req, out, required.key, required.operation,
                        item.validity == ownership_api.validity_kind.unknown ?
                            ownership_api.incomplete_reason.missing_path :
                            ownership_api.incomplete_reason.none,
                        "call requires its known allocation to remain live");
                    return false;
                }
            }
            at += 1;
        }
        if (!present) {
            out->proof = caller_failure(req, out, required.key, required.operation,
                ownership_api.incomplete_reason.missing_correspondence,
                "call needs its known allocation fact");
            return false;
        }
    }
    return true;
}

fn extent_proved(request* req, application mut* out, ownership_summary_model.context* ctx,
    ownership_summary_model.requirement required, ownership_api.region supplied, bool trusted)
    bool {
    if (!ownership_summary_model.work(ctx, &out->proof, 1)) { return false; }
    i64 needed = required.range.access.end.value;
    if (!required.range.access.arithmetic_proved ||
        required.range.access.end.kind != ownership_api.fact_kind.exact || needed < 0 ||
        supplied.residual) {
        out->proof = caller_failure(req, out, required.key, required.operation,
            ownership_api.incomplete_reason.missing_path, "cannot prove caller access window");
        return false;
    }
    if (needed == 0) { return true; }
    if ((supplied.extent.kind == ownership_api.fact_kind.exact && supplied.extent.value < 0) ||
        (supplied.offset.kind == ownership_api.fact_kind.exact && supplied.offset.value < 0) ||
        (supplied.extent.kind == ownership_api.fact_kind.exact &&
            supplied.offset.kind == ownership_api.fact_kind.exact &&
            supplied.offset.value > supplied.extent.value)) {
        out->proof = caller_failure(req, out, required.key, required.operation,
            ownership_api.incomplete_reason.missing_path, "cannot prove ordered caller range");
        return false;
    }
    i64 mut available = -1;
    bool exact_window = supplied.offset.kind == ownership_api.fact_kind.exact &&
        supplied.access.begin.kind == ownership_api.fact_kind.exact &&
        supplied.access.end.kind == ownership_api.fact_kind.exact;
    if (exact_window) {
        if (!supplied.access.arithmetic_proved || supplied.access.begin.value < 0 ||
            supplied.offset.value < supplied.access.begin.value ||
            supplied.access.end.value < supplied.offset.value ||
            (supplied.extent.kind == ownership_api.fact_kind.exact &&
                supplied.access.end.value > supplied.extent.value)) {
            out->proof = caller_failure(req, out, required.key, required.operation,
                ownership_api.incomplete_reason.missing_path,
                "cannot prove the argument access window");
            return false;
        }
        available = supplied.access.end.value - supplied.offset.value;
    } else if (supplied.extent.kind == ownership_api.fact_kind.exact) {
        available = supplied.extent.value;
        if (supplied.offset.kind == ownership_api.fact_kind.exact &&
            supplied.offset.value >= 0 && supplied.offset.value <= available) {
            available -= supplied.offset.value;
        }
    }
    if (available >= 0 && available < needed) {
        out->proof = caller_failure(req, out, required.key, required.operation,
            ownership_api.incomplete_reason.none,
            "call requires a larger argument access window");
        return false;
    }
    if ((!exact_window || available < 0) && !trusted) {
        out->proof = caller_failure(req, out, required.key, required.operation,
            ownership_api.incomplete_reason.missing_path, "cannot prove caller extent");
        return false;
    }
    u64 align = required.range.alignment;
    if (align == 0 || align > 9223372036854775807 || (align & (align - 1)) != 0) {
        out->proof = caller_failure(req, out, required.key, required.operation,
            ownership_api.incomplete_reason.missing_path, "cannot prove required alignment");
        return false;
    }
    if (supplied.alignment != 0 && supplied.alignment % align == 0 &&
        supplied.offset.kind == ownership_api.fact_kind.exact &&
        supplied.offset.value % cast(align, i64) != 0) {
        out->proof = caller_failure(req, out, required.key, required.operation,
            ownership_api.incomplete_reason.none, "call requires aligned storage");
        return false;
    }
    if (!trusted && (supplied.alignment == 0 || supplied.alignment % align != 0 ||
        supplied.offset.kind != ownership_api.fact_kind.exact)) {
        out->proof = caller_failure(req, out, required.key, required.operation,
            ownership_api.incomplete_reason.missing_path, "cannot prove caller alignment");
        return false;
    }
    return true;
}

fn requirements_proved(request* req, application mut* out,
    ownership_summary_model.context* ctx) bool {
    u64 mut i = 0;
    while (i < out->bound.model.requirements.len) {
        if (!ownership_summary_model.work(ctx, &out->proof, 1)) { return false; }
        ownership_summary_model.requirement row = out->bound.model.requirements[i];
        ownership_api.entity_id formal_source = req->summary->requirements[i].source;
        if (row.guard.kind != ownership_api.entity_kind.none) {
            out->proof = caller_failure(req, out, row.key, row.operation,
                ownership_api.incomplete_reason.unknown_effect,
                    "linear call has an unresolved guard");
            return false;
        }
        if (row.kind == ownership_summary_model.requirement_kind.live_source ||
            row.kind == ownership_summary_model.requirement_kind.extent) {
            if (!ownership_summary_model.work(ctx, &out->proof, out->state.sources_len)) {
                return false;
            }
            u64 source = ownership_state.source_index(&out->state, row.source);
            if (source == ownership_api.U64_MAX ||
                out->state.sources[source].validity == ownership_api.validity_kind.unknown) {
                out->proof = caller_failure(req, out, row.key, row.operation,
                    ownership_api.incomplete_reason.missing_path,
                        "cannot prove caller source live");
                return false;
            }
            if (out->state.sources[source].validity != ownership_api.validity_kind.live) {
                out->proof = caller_failure(req, out, row.key, row.operation,
                    ownership_api.incomplete_reason.none, "call requires a live source");
                return false;
            }
            ownership_api.region mut supplied = ownership_api.region{};
            if (!caller_reference(req, out, ctx, row, formal_source, source, &supplied) ||
                !extent_proved(req, out, ctx, row, supplied,
                    out->state.sources[source].kind ==
                        ownership_api.source_kind.trusted_foreign)) { return false; }
        } else if (row.kind == ownership_summary_model.requirement_kind.empty_output ||
            row.kind == ownership_summary_model.requirement_kind.valid_owner) {
            if (!selected_storage(req, out, ctx, row)) { return false; }
        } else {
            out->proof = caller_failure(req, out, row.key, row.operation,
                ownership_api.incomplete_reason.unknown_effect,
                    "linear call requirement is incomplete");
            return false;
        }
        i += 1;
    }
    return true;
}

fn seed_locals(request* req, application mut* out, ownership_summary_model.context* ctx,
    ownership_transfer.event_binding@ events) bool {
    u64 mut i = 0;
    while (i < out->bound.model.roots.len) {
        if (!ownership_summary_model.work(ctx, &out->proof, 4)) { return false; }
        ownership_summary_model.symbolic_root row = out->bound.model.roots[i];
        if (row.kind == ownership_summary_model.root_kind.by_value_slot) {
            if (!ownership_summary_model.work(ctx, &out->proof, out->state.sources_len)) {
                return false;
            }
            u64 previous = ownership_state.source_index(&out->state, row.source);
            if (row.ty == null || (previous != ownership_api.U64_MAX &&
                (out->state.sources[previous].kind != ownership_api.source_kind.stack ||
                out->state.sources[previous].validity != ownership_api.validity_kind.ended))) {
                out->proof = caller_failure(req, out, row.source, req->operation,
                    ownership_api.incomplete_reason.missing_correspondence,
                    "callee local storage must be separate from caller storage");
                return false;
            }
            ownership_api.source_fact storage = ownership_api.source_fact{
                .key = row.source, .kind = ownership_api.source_kind.stack,
                .validity = ownership_api.validity_kind.live};
            if (previous == ownership_api.U64_MAX) {
                ownership_state.append_sources(&out->state, storage);
            }
            else { out->state.sources[previous] = storage; }
            ownership_api.contents_fact contents = ownership_api.contents_fact{
                .place = ownership_api.place_path{.root = row.slot},
                .kind = row.ty->is_own ? ownership_api.contents_kind.empty_owner :
                    ownership_api.contents_kind.scalar, .owner_empty = row.ty->is_own,
                .span_length = ownership_api.scalar_fact{.kind = ownership_api.fact_kind.exact}};
            if (!ownership_summary_model.work(ctx, &out->proof, out->state.contents_len) ||
                !ownership_summary_model.work(ctx, &out->proof, out->state.allocations_len)) {
                return false;
            }
            u64 old_contents = ownership_transfer.contents_index(&out->state, contents.place);
            if (old_contents == ownership_api.U64_MAX) {
                ownership_state.append_contents(&out->state, contents);
            } else {
                if (ownership_transfer.owner_count(&out->state, contents.place) != 0) {
                    out->proof = caller_failure(req, out, row.slot, req->operation,
                        ownership_api.incomplete_reason.missing_path,
                        "callee local reuse must preserve earlier owning obligations");
                    return false;
                }
                out->state.contents[old_contents] = contents;
            }
            if (row.formal != 0) {
                u64 mut j = 0;
                bool mut found = false;
                while (j < out->bound.model.roots.len) {
                    if (!ownership_summary_model.work(ctx, &out->proof, 1)) { return false; }
                    ownership_summary_model.symbolic_root input = out->bound.model.roots[j];
                    if (input.kind == ownership_summary_model.root_kind.caller_source &&
                        input.formal == row.formal) {
                        ownership_api.place_path actual = argument_place(req, out, ctx, j);
                        if (actual.residual || !ownership_api.successful(out->proof)) {
                            out->proof = caller_failure(req, out, input.slot, req->operation,
                                ownership_api.incomplete_reason.missing_correspondence,
                                "output parameter needs its current argument value");
                            return false;
                        }
                        ownership_transfer.request mut transfer = linear_request(req,
                            actual, contents.place,
                            row.ty->is_own ? ownership_transfer.action.move_owner :
                                ownership_transfer.action.copy, events);
                        transfer.destination_owns = row.ty->is_own;
                        out->proof = ownership_transfer.apply(&out->state, req->services,
                            &transfer);
                        if (!ownership_api.successful(out->proof)) { return false; }
                        found = true;
                    }
                    j += 1;
                }
                if (!found && (row.ty->kind == types.type_kind.k_ptr ||
                    row.ty->kind == types.type_kind.k_span
                        || row.ty->kind == types.type_kind.k_string)) {
                    out->proof = caller_failure(req, out, row.slot, req->operation,
                        ownership_api.incomplete_reason.missing_correspondence,
                        "reference parameter needs an actual caller value");
                    return false;
                }
            }
        }
        i += 1;
    }
    return true;
}

fn selected_type(application mut* out, ownership_summary_model.context* ctx,
    types.node* input, ownership_api.place_path path, ownership_api.place_path base) types.node* {
    if (!ownership_summary_model.work(ctx, &out->proof,
        path.projections.len + base.projections.len) || !ownership_places.begins(path, base)) {
        return null;
    }
    types.node* mut ty = input;
    u64 mut i = base.projections.len;
    while (i < path.projections.len && ty != null) {
        if (!ownership_summary_model.work(ctx, &out->proof, 1)) { return null; }
        ownership_api.projection part = path.projections[i];
        if (ty->kind == types.type_kind.k_array &&
            part.kind == ownership_api.projection_kind.fixed_index &&
            part.index.kind == ownership_api.fact_kind.exact && part.index.value >= 0 &&
            cast(part.index.value, u64) < ty->len) { ty = ty->elem; }
        else if (ty->kind == types.type_kind.k_struct &&
            part.kind == ownership_api.projection_kind.field && ty->decl != null &&
            ty->layout != null && ty->layout->state == types.layout_state.l_resolved) {
            ast.sym* declaration = cast(ty->decl, ast.sym*);
            if (declaration->node == null) { return null; }
            types.node* mut field = null;
            u64 mut j = 0;
            u32 mut number = 0;
            while (j < ast.ast_len(declaration->node)) {
                if (!ownership_summary_model.work(ctx, &out->proof, 1)) { return null; }
                ast.node* member = ast.ast_child(declaration->node, j);
                if (member->kind == ast.ast_kind.k_field_decl) {
                    if (number == part.field) { field = member->ty; break; }
                    number += 1;
                }
                j += 1;
            }
            ty = field;
        } else { return null; }
        i += 1;
    }
    return ty;
}

fn destination_type(request* req, application mut* out, ownership_summary_model.context* ctx,
    ownership_api.place_path path) types.node* {
    u64 mut i = 0;
    while (i < out->bound.model.roots.len) {
        if (!ownership_summary_model.work(ctx, &out->proof, 1)) { return null; }
        ownership_summary_model.symbolic_root row = out->bound.model.roots[i];
        if (ownership_summary_model.same(row.slot, path.root)) {
            if (!ownership_summary_model.work(ctx, &out->proof,
                req->summary->requirements.len)) { return null; }
            if (row.kind == ownership_summary_model.root_kind.caller_source &&
                output_root(req->summary, req->summary->roots[i].slot)) {
                u64 mut a = 0;
                while (a < out->bound.aliases.len) {
                    if (!ownership_summary_model.work(ctx, &out->proof, 1)) { return null; }
                    ownership_api.alias_binding alias = out->bound.aliases[a];
                    if (ownership_summary_model.same(alias.formal,
                        req->summary->roots[i].slot) &&
                        ownership_places.begins(path, alias.actual)) {
                        return selected_type(out, ctx, row.ty->elem, path, alias.actual);
                    }
                    a += 1;
                }
                return null;
            }
            if (path.projections.len != 0) { return null; }
            return row.ty;
        }
        i += 1;
    }
    return null;
}

fn bind_fresh_source(application mut* out, ownership_summary_model.context* ctx,
    ownership_api.entity_id formal, ownership_api.entity_id actual_source,
    ownership_api.entity_id version) bool {
    u64 mut i = 0;
    while (i < out->bound.model.results.len) {
        if (!ownership_summary_model.work(ctx, &out->proof, 1)) { return false; }
        ownership_summary_model.relation mut* row = &out->bound.model.results[i];
        if (ownership_summary_model.same(row->borrow.source, formal)) {
            row->borrow.source = actual_source;
            row->borrow.range.source = actual_source;
            row->borrow.value_version = version;
        }
        i += 1;
    }
    i = 0;
    while (i < out->bound.model.effects.len) {
        if (!ownership_summary_model.work(ctx, &out->proof, 1)) { return false; }
        ownership_summary_model.effect_node mut* row = &out->bound.model.effects[i];
        if (ownership_summary_model.same(row->effect.source, formal)) {
            row->effect.source = actual_source;
        }
        if (ownership_summary_model.same(row->range.source, formal)) {
            row->range.source = actual_source;
        }
        u64 count = row->value.borrows.len;
        u64 mut b = 0;
        bool mut copied = false;
        while (b < count) {
            if (!ownership_summary_model.work(ctx, &out->proof, 1)) { return false; }
            if (ownership_summary_model.same(row->value.borrows[b].source, formal)) {
                copied = true;
            }
            b += 1;
        }
        if (copied) {
            if (!ownership_summary_model.work(ctx, &out->proof, count) ||
                !ownership_summary_model.work(ctx, &out->proof, 2) ||
                !ownership_summary_model.effect_charge(ctx, &out->proof, &out->bound.relations)) {
        return false;
    }
            ownership_state.slice_block mut* own storage = new(ownership_state.slice_block);
            storage->borrows = new(ownership_api.borrow_relation, count);
            ownership_api.borrow_relation mut@ borrows = storage->borrows[..];
            ownership_state.keep(&out->bound.model.metadata, move(storage));
            b = 0;
            while (b < count) {
                if (!ownership_summary_model.work(ctx, &out->proof, 1)) { return false; }
                borrows[b] = row->value.borrows[b];
                if (ownership_summary_model.same(borrows[b].source, formal)) {
                    borrows[b].source = actual_source;
                    borrows[b].range.source = actual_source;
                    borrows[b].value_version = version;
                }
                b += 1;
            }
            row->value.borrows = borrows[..];
            row->value.value_version = version;
        }
        i += 1;
    }
    return true;
}

// A selected address keeps its required window inside the original argument window.
fn selected_value(request* req, application mut* out, ownership_summary_model.context* ctx,
    ownership_transfer.request mut* transfer) bool {
    if (transfer->kind != ownership_transfer.action.assignment ||
        transfer->value.borrows.len != 1) { return true; }
    ownership_api.borrow_relation[1] mut relations = {transfer->value.borrows[0]};
    u64 mut i = 0;
    while (i < out->bound.sources.len) {
        if (!ownership_summary_model.work(ctx, &out->proof, 1)) { return false; }
        source_binding binding = out->bound.sources[i];
        ownership_api.region local = relations[0].range;
        if (ownership_summary_model.same(relations[0].source, binding.actual.key) &&
            !ownership_summary_model.same(local.key, binding.range.key)) {
            ownership_api.region supplied = binding.range;
            bool trusted = binding.actual.kind == ownership_api.source_kind.trusted_foreign;
            if (local.offset.kind != ownership_api.fact_kind.exact ||
                local.access.end.kind != ownership_api.fact_kind.exact ||
                !local.access.arithmetic_proved || local.offset.value < 0 ||
                local.access.end.value < local.offset.value ||
                (!trusted && supplied.offset.kind != ownership_api.fact_kind.exact)) {
                out->proof = caller_failure(req, out, binding.actual.key, req->operation,
                    ownership_api.incomplete_reason.missing_path,
                    "selected address needs its original argument window");
                return false;
            }
            i64 base = supplied.offset.kind == ownership_api.fact_kind.exact ?
                supplied.offset.value : 0;
            if (base < 0 || base > 9223372036854775807 - local.access.end.value ||
                (supplied.access.end.kind == ownership_api.fact_kind.exact &&
                    base + local.access.end.value > supplied.access.end.value)) {
                out->proof = caller_failure(req, out, binding.actual.key, req->operation,
                    ownership_api.incomplete_reason.missing_path,
                    "selected address exceeds its original argument window");
                return false;
            }
            relations[0].range.offset.value = base + local.offset.value;
            relations[0].range.access.begin = relations[0].range.offset;
            relations[0].range.access.end.value = base + local.access.end.value;
            relations[0].range.extent = supplied.extent;
            transfer->value.borrows = relations[..];
            if (!ownership_summary_model.contents_charge(ctx, &out->proof, transfer->value)) {
                return false;
            }
            transfer->value = ownership_state.copy_contents(&out->bound.metadata, transfer->value);
            u64 mut r = 0;
            while (r < out->bound.model.results.len) {
                if (!ownership_summary_model.work(ctx, &out->proof, 1)) { return false; }
                ownership_summary_model.relation mut* row = &out->bound.model.results[r];
                if (ownership_summary_model.same(row->borrow.value_version,
                    relations[0].value_version)) { row->borrow.range = relations[0].range; }
                r += 1;
            }
            return true;
        }
        i += 1;
    }
    return true;
}

fn selected_transfer(request* req, application mut* out,
    ownership_summary_model.context* ctx, ownership_transfer.request mut* transfer,
    types.node* destination) ownership_api.proof_status {
    bool projected = transfer->source.projections.len != 0 ||
        transfer->destination.projections.len != 0;
    if (!projected) { return ownership_transfer.apply(&out->state, req->services, transfer); }
    if (transfer->kind == ownership_transfer.action.assignment &&
        transfer->destination.projections.len == 0) {
        ownership_api.projection@ none = {};
        transfer->source.projections = none;
        return ownership_transfer.apply(&out->state, req->services, transfer);
    }
    ownership_places.action mut kind = ownership_places.action.copy_value;
    if (transfer->kind == ownership_transfer.action.move_owner) {
        kind = ownership_places.action.move_value;
    } else if (transfer->kind == ownership_transfer.action.release ||
        (transfer->kind == ownership_transfer.action.assignment && transfer->value.owner_empty)) {
        kind = ownership_places.action.release_value;
        transfer->source = transfer->destination;
    } else if (transfer->kind != ownership_transfer.action.copy) {
        return caller_failure(req, out, transfer->destination.root, req->operation,
            ownership_api.incomplete_reason.unknown_effect,
            "selected output has no complete transfer");
    }
    if (!ownership_summary_model.work(ctx, &out->proof, transfer->source.projections.len) ||
        !ownership_summary_model.work(ctx, &out->proof, transfer->destination.projections.len)) {
        return out->proof;
    }
    ownership_places.request projected_request = ownership_places.request{
        .base = *transfer, .kind = kind, .ty = destination,
        .source_region_proved = true, .destination_region_proved = true,
        .alias_substituted_proved = true, .liveness_proved = true};
    return ownership_places.apply(&out->state, req->services, &projected_request);
}

fn apply_node(request* req, application mut* out, ownership_summary_model.context* ctx,
    ownership_summary_model.effect_node node, ownership_transfer.event_binding@ events) bool {
    if (!ownership_summary_model.work(ctx, &out->proof, 2) ||
        !ownership_summary_model.effect_charge(ctx, &out->proof, &out->bound.relations)) {
        return false;
    }
    if (node.residual || node.effect.guard.kind != ownership_api.entity_kind.none ||
        node.effect.place.residual || node.operand.residual) {
        out->proof = caller_failure(req, out, node.effect.key, node.effect.operation,
            ownership_api.incomplete_reason.unknown_effect, "linear call effect is incomplete");
        return false;
    }
    ownership_transfer.action mut effect_action = ownership_transfer.action.assignment;
    if (node.payload == ownership_summary_model.payload_kind.read) {
        effect_action = node.range.key.kind == ownership_api.entity_kind.none ?
            ownership_transfer.action.inspect : ownership_transfer.action.use;
    }
    else if (node.payload == ownership_summary_model.payload_kind.copy) {
        effect_action = ownership_transfer.action.copy;
    }
    else if (node.payload == ownership_summary_model.payload_kind.move) {
        effect_action = ownership_transfer.action.move_owner;
    }
    else if (node.payload == ownership_summary_model.payload_kind.release) {
        effect_action = ownership_transfer.action.release;
    }
    else if (node.payload == ownership_summary_model.payload_kind.storage_end) {
        effect_action = ownership_transfer.action.dead;
    }
    else if (node.payload == ownership_summary_model.payload_kind.allocation) {
        effect_action = ownership_transfer.action.allocation;
    }
    else if (node.payload == ownership_summary_model.payload_kind.unknown) {
        out->proof = caller_failure(req, out, node.effect.key, node.effect.operation,
            ownership_api.incomplete_reason.unknown_effect,
                "unknown fort effect preserves caller obligations");
        return false;
    }
    ownership_transfer.request mut transfer = linear_request(req, node.operand, node.effect.place,
        effect_action, events);
    transfer.value = node.value;
    if (!selected_value(req, out, ctx, &transfer)) { return false; }
    types.node* destination = destination_type(req, out, ctx, node.effect.place);
    if (!ownership_api.successful(out->proof)) { return false; }
    if (destination == null && node.effect.place.projections.len != 0) {
        out->proof = caller_failure(req, out, node.effect.place.root, node.effect.operation,
            ownership_api.incomplete_reason.missing_path,
            "selected output needs its checked leaf type");
        return false;
    }
    transfer.destination_owns = destination != null && destination->is_own;
    transfer.source_key = node.effect.source;
    transfer.liveness_proved = true;
    transfer.source_correspondence_proved = true;
    transfer.leaves_empty_proved = destination != null &&
        (destination->kind == types.type_kind.k_ptr ||
            destination->kind == types.type_kind.k_span) && destination->elem != null &&
        !fir.type_owning(destination->elem) && !fir.type_aggregate(destination->elem);
    if (effect_action == ownership_transfer.action.allocation) {
        u64 mut i = 0;
        bool mut found = false;
        while (i < out->bound.allocations.len) {
            if (!ownership_summary_model.work(ctx, &out->proof, 1)) { return false; }
            allocation_binding binding = out->bound.allocations[i];
            if (ownership_summary_model.same(binding.actual.key, node.effect.allocation) &&
                binding.fresh_proved && node.value.borrows.len == 1 &&
                node.value.span_length.kind == ownership_api.fact_kind.exact) {
                transfer.allocation = binding.actual;
                transfer.allocation.owner.place = node.effect.place;
                transfer.allocation.logical_length = node.value.span_length;
                transfer.allocation.site = binding.formal;
                transfer.fresh_source = ownership_api.source_fact{
                    .key = binding.actual.key, .kind = ownership_api.source_kind.heap,
                    .validity = ownership_api.validity_kind.live, .allocation = binding.actual.key};
                transfer.fresh_source.key.kind = ownership_api.entity_kind.source;
                if (!ownership_summary_model.work(ctx, &out->proof, out->state.sources_len)) {
                    return false;
                }
                if (ownership_state.source_index(&out->state, transfer.fresh_source.key) !=
                    ownership_api.U64_MAX) {
                    out->proof = caller_failure(req, out, transfer.fresh_source.key,
                        node.effect.operation, ownership_api.incomplete_reason.missing_path,
                        "fresh call allocation must not identify an existing source");
                    return false;
                }
                ownership_api.borrow_relation[1] mut relations = {node.value.borrows[0]};
                relations[0].source = transfer.fresh_source.key;
                relations[0].range.source = transfer.fresh_source.key;
                transfer.value.value_version = binding.actual.key;
                transfer.value.value_version.kind = ownership_api.entity_kind.value;
                relations[0].value_version = transfer.value.value_version;
                transfer.value.borrows = relations[..];
                // The transfer copies this temporary relation before the callback returns.
                out->proof = ownership_transfer.apply(&out->state, req->services, &transfer);
                if (!ownership_api.successful(out->proof)) { return false; }
                return bind_fresh_source(out, ctx, node.effect.source,
                    transfer.fresh_source.key, transfer.value.value_version);
            }
            i += 1;
        }
        if (!found) {
            out->proof = caller_failure(req, out, node.effect.allocation, node.effect.operation,
                ownership_api.incomplete_reason.missing_correspondence,
                "allocation effect needs a fresh bounded call identity");
            return false;
        }
    }
    out->proof = selected_transfer(req, out, ctx, &transfer, destination);
    return ownership_api.successful(out->proof);
}

fn end_locals(request* req, application mut* out, ownership_summary_model.context* ctx) bool {
    u64 mut i = 0;
    while (i < out->bound.model.roots.len) {
        if (!ownership_summary_model.work(ctx, &out->proof, 1)) { return false; }
        ownership_summary_model.symbolic_root row = out->bound.model.roots[i];
        if (row.kind == ownership_summary_model.root_kind.by_value_slot) {
            u64 mut a = 0;
            while (a < out->state.allocations_len) {
                if (!ownership_summary_model.work(ctx, &out->proof, 1)) { return false; }
                ownership_api.allocation_fact allocation = out->state.allocations[a];
                if (allocation.obligation &&
                    ownership_summary_model.same(allocation.owner.place.root, row.slot)) {
                    out->proof = caller_failure(req, out, allocation.key, req->operation,
                        ownership_api.incomplete_reason.unknown_effect,
                        "callee summary leaves an unproved local obligation");
                    return false;
                }
                a += 1;
            }
            if (!ownership_summary_model.work(ctx, &out->proof, out->state.sources_len)) {
                return false;
            }
            u64 source = ownership_state.source_index(&out->state, row.source);
            if (source != ownership_api.U64_MAX &&
                out->state.sources[source].validity == ownership_api.validity_kind.live) {
                ownership_api.mutation_result ended = ownership_state.end_source(&out->state,
                    req->services, row.source, req->operation, req->source);
                out->proof = ended.proof;
                if (!ended.applied) { return false; }
            }
        }
        i += 1;
    }
    return true;
}

fn apply(request* req) application {
    application mut out = application{};
    out.outcome = ownership_api.outcome_fact{.kind = ownership_api.outcome_kind.unknown_fort,
        .possible_caller_return = true, .cleanup_required = true};
    out.bound = bind(req);
    out.proof = out.bound.proof;
    if (!ownership_api.successful(out.proof)) { return out; }
    ownership_summary_model.context ctx = ownership_summary_model.context{req->services,
        req->operation, req->source, out.bound.model.event, req->summary->source};
    if (out.bound.model.residual_effects || out.bound.model.cases.len != 1 ||
        out.bound.model.cases[0].guard.kind != ownership_api.entity_kind.none ||
        out.bound.model.cases[0].outcome.kind != ownership_api.outcome_kind.function_return ||
        out.bound.model.retained.len != 0) {
        out.proof = caller_failure(req, &out, ownership_api.entity_id{}, req->operation,
            ownership_api.incomplete_reason.unknown_effect,
                "linear call has incomplete effects or outcomes");
        return out;
    }
    if (!copy_caller(req, &out, &ctx)) { return out; }
    u64 mut alias = 0;
    while (alias < out.bound.aliases.len) {
        if (!ownership_summary_model.work(&ctx, &out.proof, 1)) { return out; }
        if (!ownership_summary_model.work(&ctx, &out.proof,
            req->summary->requirements.len)) { return out; }
        if (out.bound.aliases[alias].actual.residual ||
            (out.bound.aliases[alias].actual.projections.len != 0 &&
                !output_root(req->summary, out.bound.aliases[alias].formal))) {
            out.proof = caller_failure(req, &out, out.bound.aliases[alias].formal,
                req->operation, out.bound.aliases[alias].actual.residual &&
                    output_root(req->summary, out.bound.aliases[alias].formal) ?
                    ownership_api.incomplete_reason.missing_path :
                    ownership_api.incomplete_reason.unknown_effect,
                "projected call storage needs complete projected application");
            return out;
        }
        alias += 1;
    }
    if (!requirements_proved(req, &out, &ctx)) { return out; }
    ownership_transfer.event_binding[1] events = {ownership_transfer.event_binding{
        req->operation, out.bound.model.event}};
    if (!seed_locals(req, &out, &ctx, events[..])) { return out; }
    ownership_api.entity_id@ sequence = out.bound.model.cases[0].effects;
    u64 mut i = 0;
    while (i < sequence.len) {
        u64 mut j = 0;
        bool mut found = false;
        while (j < out.bound.model.effects.len) {
            if (!ownership_summary_model.work(&ctx, &out.proof, 1)) { return out; }
            if (ownership_summary_model.same(sequence[i], out.bound.model.effects[j].effect.key)) {
                if (!apply_node(req, &out, &ctx, out.bound.model.effects[j], events[..])) {
                    return out;
                }
                found = true;
                break;
            }
            j += 1;
        }
        if (!found) {
            out.proof = caller_failure(req, &out, sequence[i], req->operation,
                ownership_api.incomplete_reason.missing_correspondence,
                "linear call has no matching ordered effect");
            return out;
        }
        i += 1;
    }
    if (!end_locals(req, &out, &ctx)) { return out; }
    out.outcome = out.bound.model.cases[0].outcome;
    out.normal_continuation = true;
    return out;
}
