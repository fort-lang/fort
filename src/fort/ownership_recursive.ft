/// Solves the ownership summaries of call-graph components, each callee component first.
import ownership_api;
import ownership_graph;
import ownership_keys;
import ownership_limits;
import ownership_summary;
import ownership_summary_body;
import ownership_summary_model;

/// Starts the computation of one component (D17.18). The client configures the meter that its
/// services charge for a computation of FIR size `size`, and stores the limit table of that
/// computation in `limits`. A false result refuses the computation.
struct computation_hook {
    void mut* context;
    fn (void mut*, u64, ownership_api.limit_table mut*) bool begin;
}

/// One solved closure. Entry i of each array of bodies names body i of the graph. The inputs
/// borrow the records, and the records borrow the views and the summaries. Keep the solution
/// at one address, and alive while an input or a view is in use.
struct solution {
    ownership_summary_model.summary mut@ own summaries;
    ownership_summary_model.summary_view mut@ own views;
    ownership_summary_body.call_targets mut@ own records;
    ownership_summary_body.callee_binding mut@ own bindings;
    // Body i owns records `records_first[i]` up to `records_first[i + 1]`.
    u64 mut@ own records_first;
    // The rounds before the fixed point of the component of each body. A component without
    // recursion has none.
    u64 mut@ own rounds;
    ownership_api.proof_status proof;
}

fn free(solution mut* out) void {
    u64 mut i = 0;
    while (i < out->summaries.len) {
        ownership_summary_model.free(&out->summaries[i]);
        i += 1;
    }
    solution mut owned = move(*out);
    del(owned.summaries);
    del(owned.views);
    del(owned.records);
    del(owned.bindings);
    del(owned.records_first);
    del(owned.rounds);
    *out = solution{};
}

// The working storage of one solve. The members of component c are the bodies
// `members[members_first[c]]` up to `members[members_first[c + 1]]`, in key order.
struct solver {
    ownership_graph.graph mut* graph;
    ownership_summary_body.body_input mut@ inputs;
    ownership_api.services* services;
    computation_hook hook;
    solution mut* out;
    u32 mut@ own members;
    u64 mut@ own members_first;
    bool mut@ own solved;
    // The graph call of each record, and the first binding of its fort targets.
    u64 mut@ own record_calls;
    u64 mut@ own record_bindings;
}

fn free_solver(solver mut* s) void {
    del(s->members);
    del(s->members_first);
    del(s->solved);
    del(s->record_calls);
    del(s->record_bindings);
}

// Rounds before the fixed point record no event: their results are provisional (D17.18).
fn quiet_event(void mut* opaque, ownership_api.event_request* req)
    ownership_api.event_result {
    return ownership_api.event_result{.proof = req->current, .retained = true,
        .stored_key = req->event.key};
}

// The event service of the rounds that record events. It notes a recorded event of a W
// exhaustion, so a stopped computation records one budget event and no second one.
struct budget_note {
    ownership_api.services* inner;
    bool recorded;
}

fn noted_event(void mut* opaque, ownership_api.event_request* req)
    ownership_api.event_result {
    budget_note mut* note = cast(opaque, budget_note mut*);
    ownership_api.exhaustion limit = req->event.limit.present ? req->event.limit :
        req->current.terminal.limit;
    if (limit.present && limit.category == ownership_api.limit_category.w) {
        note->recorded = true;
    }
    return ownership_api.record_event(note->inner, req);
}

// A summary that publishes `proof` with no case and residual effects.
fn refused_summary(ownership_api.proof_status proof) ownership_summary_model.summary {
    ownership_summary_model.summary mut out = ownership_summary_model.summary{};
    out.proof = proof;
    out.residual_effects = true;
    out.operation = proof.terminal.operation;
    out.source = proof.terminal.source;
    return out;
}

fn publish(solver mut* s, u64 body, ownership_summary_model.summary mut published) void {
    ownership_summary_model.free(&s->out->summaries[body]);
    s->out->summaries[body] = move(published);
    s->out->views[body] = ownership_summary_model.view(&s->out->summaries[body]);
}

fn refuse_members(solver mut* s, u64 component, ownership_api.proof_status proof) void {
    u64 mut i = s->members_first[component];
    while (i < s->members_first[component + 1]) {
        publish(s, cast(s->members[i], u64), refused_summary(proof));
        i += 1;
    }
}

// A member that published a proof loses it. A member that failed or stayed incomplete keeps
// its own status, so its own error stays its verdict.
fn withdraw_members(solver mut* s, u64 component, ownership_api.proof_status proof) void {
    u64 mut i = s->members_first[component];
    while (i < s->members_first[component + 1]) {
        u64 body = cast(s->members[i], u64);
        if (ownership_api.successful(s->out->summaries[body].proof)) {
            publish(s, body, refused_summary(proof));
        }
        i += 1;
    }
}

fn refuse_all(solver mut* s, ownership_api.proof_status proof) void {
    u64 mut i = 0;
    while (i < s->out->summaries.len) {
        publish(s, i, refused_summary(proof));
        i += 1;
    }
}

// The body of `key`, or U64_MAX. The graph keeps its bodies in increasing key order.
fn body_of(ownership_graph.graph* g, ownership_api.function_id key, u64 mut* steps) u64 {
    u64 mut low = 0;
    u64 mut high = g->bodies.len;
    while (low < high) {
        *steps += 1;
        u64 middle = low + (high - low) / 2;
        i32 order = ownership_keys.function(g->bodies[middle].key, key);
        if (order == 0) { return middle; }
        if (order < 0) { low = middle + 1; } else { high = middle; }
    }
    return ownership_api.U64_MAX;
}

// The inputs name the graph bodies in graph order, and the graph has a component order.
fn valid_inputs(solver* s) bool {
    ownership_graph.graph* g = s->graph;
    if (s->services == null || s->hook.begin == null || s->inputs.len != g->bodies.len ||
        g->components.len != g->bodies.len ||
        ownership_graph.callee_first(g).len != cast(g->component_count, u64)) { return false; }
    u64 mut i = 0;
    while (i < s->inputs.len) {
        if (ownership_keys.function(s->inputs[i].function.key, g->bodies[i].key) != 0 ||
            s->inputs[i].function.body != g->bodies[i].body) { return false; }
        i += 1;
    }
    i = 0;
    while (i < g->calls_len) {
        if (cast(g->calls[i].body, u64) >= g->bodies.len) { return false; }
        i += 1;
    }
    return true;
}

// Lays out one record for each graph call and the members of each component. The graph
// build collected these calls, so the layout charges the graph ledger.
fn lay_out(solver mut* s) bool {
    ownership_graph.graph mut* g = s->graph;
    u64 n = g->bodies.len;
    u64 components = cast(g->component_count, u64);
    u64 mut targets = 0;
    u64 mut i = 0;
    while (i < g->calls_len) {
        if (g->calls[i].fort_len > ownership_api.U64_MAX - targets) { return false; }
        targets += g->calls[i].fort_len;
        i += 1;
    }
    if (n > ownership_api.U64_MAX - 1 - g->calls_len ||
        components > ownership_api.U64_MAX - 1 - n - g->calls_len ||
        !ownership_graph.charge_work(g, n + g->calls_len + components + 1)) { return false; }
    s->out->records_first = new(u64, n + 1);
    s->out->records = new(ownership_summary_body.call_targets, g->calls_len);
    s->record_calls = new(u64, g->calls_len);
    s->record_bindings = new(u64, g->calls_len);
    s->out->bindings = new(ownership_summary_body.callee_binding, targets);
    s->out->rounds = new(u64, n);
    i = 0;
    while (i < g->calls_len) {
        s->out->records_first[cast(g->calls[i].body, u64) + 1] += 1;
        i += 1;
    }
    i = 0;
    while (i < n) {
        s->out->records_first[i + 1] += s->out->records_first[i];
        i += 1;
    }
    // Each body keeps the graph order of its calls: increasing block, then statement.
    u64 mut@ own next = new(u64, n);
    defer del(next);
    i = 0;
    while (i < n) { next[i] = s->out->records_first[i]; i += 1; }
    u64 mut first = 0;
    i = 0;
    while (i < g->calls_len) {
        ownership_graph.call_site* call = &g->calls[i];
        u64 at = next[cast(call->body, u64)];
        next[cast(call->body, u64)] += 1;
        s->out->records[at] = ownership_summary_body.call_targets{call->position.block,
            call->position.operation, s->out->bindings[first..first + call->fort_len],
            call->residual_fort, call->foreign_len > 0 || call->residual_foreign};
        s->record_calls[at] = i;
        s->record_bindings[at] = first;
        first += call->fort_len;
        i += 1;
    }
    s->members_first = new(u64, components + 1);
    s->members = new(u32, n);
    s->solved = new(bool, components);
    i = 0;
    while (i < n) {
        s->members_first[cast(g->components[i], u64) + 1] += 1;
        i += 1;
    }
    i = 0;
    while (i < components) {
        s->members_first[i + 1] += s->members_first[i];
        i += 1;
    }
    u64 mut@ own place = new(u64, components);
    defer del(place);
    i = 0;
    while (i < components) { place[i] = s->members_first[i]; i += 1; }
    i = 0;
    while (i < n) {
        u64 component = cast(g->components[i], u64);
        s->members[place[component]] = cast(i, u32);
        place[component] += 1;
        i += 1;
    }
    return true;
}

// One computation: its services and limits, and the position that its own charges name.
struct computation {
    u64 component;
    bool recursive;
    ownership_api.limit_table limits;
    ownership_api.services quiet;
    ownership_api.services loud;
    budget_note note;
    ownership_api.operation_position operation;
    ownership_api.proof_status proof;
}

fn charge(solver* s, computation mut* c, u64 amount) bool {
    u64 mut left = amount;
    while (left > 0) {
        ownership_api.charge_result charged = ownership_api.charge_work(s->services,
            ownership_api.work_kind.summary_solver, c->operation, ownership_api.source_position{});
        if (!charged.allowed) {
            c->proof = charged.proof;
            return false;
        }
        left -= 1;
    }
    return true;
}

// Binds each fort target of each call of the members. A target in this recursive component
// is provisional. A target outside a solved component has no summary to read yet, so the
// call stays unresolved: no caller reads an unpublished summary (D17.18).
fn bind_records(solver mut* s, computation mut* c) bool {
    ownership_graph.graph* g = s->graph;
    u64 mut m = s->members_first[c->component];
    while (m < s->members_first[c->component + 1]) {
        u64 body = cast(s->members[m], u64);
        u64 mut k = s->out->records_first[body];
        while (k < s->out->records_first[body + 1]) {
            ownership_graph.call_site* site = &g->calls[s->record_calls[k]];
            u64 mut t = 0;
            while (t < site->fort_len) {
                u64 mut steps = 0;
                u64 target = body_of(g, site->fort_targets[t].function, &steps);
                if (!charge(s, c, steps + 1)) { return false; }
                u64 group = target == ownership_api.U64_MAX ? ownership_api.U64_MAX :
                    cast(g->components[target], u64);
                if (target == ownership_api.U64_MAX ||
                    (group != c->component && !s->solved[group])) {
                    s->out->records[k].residual_fort = true;
                    t += 1;
                    continue;
                }
                s->out->bindings[s->record_bindings[k] + t] =
                    ownership_summary_body.callee_binding{g->bodies[target].body->sym,
                        &s->out->views[target], group == c->component && c->recursive};
                t += 1;
            }
            k += 1;
        }
        s->inputs[body].targets =
            s->out->records[s->out->records_first[body]..s->out->records_first[body + 1]];
        s->inputs[body].limits = c->limits;
        m += 1;
    }
    return true;
}

// A refused W charge stops the computation (D17.18). Another refused bound only makes the
// summary of one member incomplete.
fn work_refused(ownership_summary.inference* r) bool {
    return r->refused && r->refusal.terminal.limit.present &&
        r->refusal.terminal.limit.category == ownership_api.limit_category.w;
}

// Infers one member with the event service of this round. The services of the computation
// end with it, so only a copy of the input names them. A recursive member compares the
// result with its last summary. False stops the computation.
fn infer_member(solver mut* s, computation mut* c, u64 body, bool quiet, bool mut* changed,
    ownership_summary.inference mut* result) bool {
    ownership_summary_body.body_input mut input = s->inputs[body];
    input.services = &c->loud;
    if (quiet) { input.services = &c->quiet; }
    *result = ownership_summary.infer_member(&input);
    if (work_refused(result)) {
        c->proof = result->refusal;
        return false;
    }
    if (!c->recursive) { return true; }
    ownership_summary_model.summary_view next = ownership_summary_model.view(&result->summary);
    ownership_summary_model.context ctx = ownership_summary_model.context{s->services,
        c->operation, ownership_api.source_position{}, ownership_api.entity_id{},
        ownership_api.source_position{}};
    ownership_api.proof_status mut proof = ownership_summary_model.complete();
    bool same = ownership_summary_model.equal(&next, &s->out->views[body], &ctx, &proof);
    if (!ownership_api.successful(proof)) {
        c->proof = proof;
        return false;
    }
    *changed = *changed || !same;
    return true;
}

// A computation stops at a refused W charge, and only a W charge carries a limit here. When
// no event of this computation names a W exhaustion, as in a round that records no event, it
// records one budget event: the error stands even when no caller reads a refused summary
// (`spec/fir.md` 14.1). An event store keeps one event for each key. The key names the first
// member and the ordinal U32_MAX, which no body key and no update key takes
// (`ownership_summary_body.next`, `ownership_summary_model.update_key`), so the stop events of
// two computations stay apart.
fn stop(solver mut* s, computation mut* c) void {
    ownership_api.exhaustion limit = c->proof.terminal.limit;
    if (!c->note.recorded && limit.present) {
        ownership_api.event_request mut req = ownership_api.event_request{};
        req.current = c->proof;
        req.event.key = ownership_api.entity_id{c->operation.function,
            ownership_api.entity_kind.event, ownership_summary_body.U32_MAX};
        req.event.operation = c->proof.terminal.operation;
        req.event.source = c->proof.terminal.source;
        req.event.kind = ownership_api.event_kind.work_failure;
        req.event.evidence = ownership_api.evidence_kind.abstract_possibility;
        req.event.reason = c->proof.terminal.reason;
        req.event.limit = limit;
        req.event.text = "ownership summary solver stopped at the work bound";
        ownership_api.record_event(s->services, &req);
    }
    refuse_members(s, c->component, c->proof);
}

// Solves a recursive component (D17.18). Each member starts at bottom. Rounds infer the
// members in key order with the latest provisional summaries and record no event. After a
// round that changes no member, one publication round infers each member with the real
// event service. A member that names an uncovered provisional call, or a publication that
// differs from the fixed point, withdraws the proof of every member.
fn iterate(solver mut* s, computation mut* c) void {
    u64 first = s->members_first[c->component];
    u64 last = s->members_first[c->component + 1];
    u64 mut m = first;
    while (m < last) {
        ownership_summary_model.summary mut bottom = ownership_summary_model.summary{};
        bottom.proof = ownership_summary_model.complete();
        publish(s, cast(s->members[m], u64), move(bottom));
        m += 1;
    }
    u64 mut rounds = 0;
    bool mut changed = true;
    while (changed) {
        changed = false;
        rounds += 1;
        m = first;
        while (m < last) {
            u64 body = cast(s->members[m], u64);
            ownership_summary.inference mut result = ownership_summary.inference{};
            if (!infer_member(s, c, body, true, &changed, &result)) {
                ownership_summary_model.free(&result.summary);
                stop(s, c);
                return;
            }
            publish(s, body, move(result.summary));
            m += 1;
        }
    }
    bool mut differs = false;
    bool mut uncovered = false;
    ownership_api.proof_status mut refusal = ownership_summary_model.complete();
    m = first;
    while (m < last) {
        u64 body = cast(s->members[m], u64);
        s->out->rounds[body] = rounds;
        ownership_summary.inference mut result = ownership_summary.inference{};
        bool mut moved = false;
        if (!infer_member(s, c, body, false, &moved, &result)) {
            ownership_summary_model.free(&result.summary);
            stop(s, c);
            return;
        }
        if (moved && !differs) {
            differs = true;
            refusal = ownership_api.successful(result.summary.proof) ?
                ownership_api.incomplete(ownership_api.incomplete_reason.invalid_input,
                    c->operation, ownership_api.source_position{}) : result.summary.proof;
        }
        if (result.uncovered && !uncovered && !differs) {
            uncovered = true;
            refusal = ownership_api.incomplete(ownership_api.incomplete_reason.unknown_effect,
                result.uncovered_operation, result.uncovered_source);
        }
        publish(s, body, move(result.summary));
        m += 1;
    }
    if (differs || uncovered) { withdraw_members(s, c->component, refusal); }
}

fn solve_component(solver mut* s, u64 component) void {
    ownership_graph.graph* g = s->graph;
    u64 first = s->members_first[component];
    u64 last = s->members_first[component + 1];
    computation mut c = computation{.component = component,
        .recursive = ownership_graph.recursive_component(g, cast(component, u32)),
        .quiet = *s->services, .proof = ownership_summary_model.complete()};
    c.quiet.event = quiet_event;
    c.note = budget_note{s->services, false};
    c.loud = *s->services;
    c.loud.event_context = cast(&c.note, void mut*);
    c.loud.event = noted_event;
    c.operation = ownership_api.operation_position{
        .function = g->bodies[cast(s->members[first], u64)].key};
    u64 mut size = 0;
    u64 mut m = first;
    while (m < last) {
        size = ownership_limits.saturating_sum(size,
            ownership_limits.fir_size(g->bodies[cast(s->members[m], u64)].body));
        m += 1;
    }
    if (!s->hook.begin(s->hook.context, size, &c.limits) ||
        !ownership_api.valid_limits(&c.limits)) {
        refuse_members(s, component, ownership_api.incomplete(
            ownership_api.incomplete_reason.missing_budget, c.operation,
            ownership_api.source_position{}));
        return;
    }
    if (!bind_records(s, &c)) {
        stop(s, &c);
        return;
    }
    if (c.recursive) {
        iterate(s, &c);
        return;
    }
    m = first;
    while (m < last) {
        u64 body = cast(s->members[m], u64);
        ownership_summary.inference mut result = ownership_summary.inference{};
        bool mut ignored = false;
        if (!infer_member(s, &c, body, false, &ignored, &result)) {
            ownership_summary_model.free(&result.summary);
            stop(s, &c);
            return;
        }
        publish(s, body, move(result.summary));
        m += 1;
    }
}

/// Solves the summary of each body of `g`, each callee component before its callers
/// (D17.18, `spec/fir.md` 14.1). `inputs[i]` is the inference input of body i of `g`. The
/// solver sets its call targets and limits; the client keeps the rest. Each inference gets
/// the services of its computation through a copy of its input. One
/// computation solves each component, and `hook` starts it. A recursive component publishes
/// its summaries only after a fixed point that covers each recursive call.
fn solve(ownership_graph.graph mut* g, ownership_summary_body.body_input mut@ inputs,
    ownership_api.services* svc, computation_hook hook) solution {
    solution mut out = solution{};
    out.proof = ownership_summary_model.complete();
    out.summaries = new(ownership_summary_model.summary, inputs.len);
    out.views = new(ownership_summary_model.summary_view, inputs.len);
    solver mut s = solver{.graph = g, .inputs = inputs, .services = svc, .hook = hook,
        .out = &out};
    defer free_solver(&s);
    if (!ownership_api.successful(g->proof)) {
        out.proof = g->proof.kind == ownership_api.proof_kind.incomplete ? g->proof :
            ownership_api.incomplete(ownership_api.incomplete_reason.missing_graph,
                ownership_api.operation_position{}, ownership_api.source_position{});
        refuse_all(&s, out.proof);
        return out;
    }
    if (!valid_inputs(&s) || !lay_out(&s)) {
        out.proof = ownership_api.successful(g->proof) ?
            ownership_api.incomplete(ownership_api.incomplete_reason.invalid_input,
                ownership_api.operation_position{}, ownership_api.source_position{}) : g->proof;
        refuse_all(&s, out.proof);
        return out;
    }
    u32@ order = ownership_graph.callee_first(g);
    u64 mut i = 0;
    while (i < order.len) {
        solve_component(&s, cast(order[i], u64));
        s.solved[cast(order[i], u64)] = true;
        i += 1;
    }
    return out;
}
