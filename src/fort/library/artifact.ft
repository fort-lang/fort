/// Writes the artifact of a library build and reads the artifact of a used library: the hashes
/// that its manifest records, the manifest text and the files of the directory `<name>.flib/`
/// (D9.11, toolchain.md 2.2). A cache entry of the entry unit is a directory of the same form
/// with `object.o` in place of the library files (toolchain.md 2.3).
///
/// Every hash is SHA-256 (FIPS 180-4), written as 64 lowercase hex digits. The manifest has one
/// field on each line, and its key is the hash of the lines from the format version to the last
/// used library. The interface hash covers `interface.ft` and `summaries/ownership`, the
/// ownership summaries of spec/ownership-design.md 8.2. The writer writes each file to a temporary
/// name and renames it, and it writes the manifest last, so a reader that finds a manifest finds
/// the files of the same build. The reader reads each file once and keeps the bytes that it
/// checked.
import fort.containers;
import fort.modules;
import fort.owner.summary;
import std.digest.sha256;
import std.io;
import std.libc;
import std.os;
import std.str;
import std.strbuf;
import std.strmap;
import std.sys;

// The version of the manifest format and the version of the directory `summaries/`, which holds
// the file `ownership` since version 2.
string FORMAT_VERSION = "1";
string SUMMARIES_VERSION = "2";

// The bytes that a manifest value keeps as they are: 0x21 to 0x7E, except `\`.
u64 VALUE_FIRST = 33;
u64 VALUE_LAST = 126;

// The digits of an escaped byte of a value, and of a hash.
string UPPER_HEX = "0123456789ABCDEF";
string LOWER_HEX = "0123456789abcdef";
u64 HEX_SHIFT = 4;
u64 HEX_MASK = 15;

/// The entries of an artifact.
string INTERFACE_FILE = "interface.ft";
string ARCHIVE_FILE = "lib.a";
string MANIFEST_FILE = "manifest";
string SUMMARIES_DIR = "summaries";

/// The file of the ownership summaries in `summaries/`, and its path in the artifact, which the
/// interface hash names.
string OWNERSHIP_FILE = "ownership";
string OWNERSHIP_PATH = "summaries/ownership";

/// The object of a cache entry of the entry unit (toolchain.md 2.3).
string OBJECT_FILE = "object.o";

// The part between the name of a file and the process id in its temporary name.
string TEMP_INFIX = ".tmp.";

// The mode of a directory that the writer makes. The umask of the process applies to it.
u32 DIR_MODE = 0o777;

// The mode of a file that the writer makes, as io.open_write gives it. The umask applies too.
i32 FILE_MODE = 0o644;

// The buffer that readlink(2) writes when the writer asks whether an entry is a symbolic link.
u64 LINK_PROBE_CAP = 1;

// ---- hashes ------------------------------------------------------------------------

/// Appends `value` as a manifest value. The bytes 0x21 to 0x7E stay as they are, except `\`.
/// Every other byte, a space and `\` included, is `\xHH` with uppercase hex digits.
fn append_value(strbuf.str_buf mut* out, string value) void {
    u64 mut i = 0;
    while (i < value.len) {
        u64 byte = cast(value[i], u64);
        if (byte < VALUE_FIRST || byte > VALUE_LAST || value[i] == '\\') {
            strbuf.append(out, "\\x");
            strbuf.push(out, UPPER_HEX[byte >> HEX_SHIFT]);
            strbuf.push(out, UPPER_HEX[byte & HEX_MASK]);
        } else {
            strbuf.push(out, value[i]);
        }
        i += 1;
    }
}

/// Appends each byte of `digest` as two lowercase hex digits, the high digit first.
fn append_digest(strbuf.str_buf mut* out, u8@ digest) void {
    u64 mut i = 0;
    while (i < digest.len) {
        u64 byte = cast(digest[i], u64);
        strbuf.push(out, LOWER_HEX[byte >> HEX_SHIFT]);
        strbuf.push(out, LOWER_HEX[byte & HEX_MASK]);
        i += 1;
    }
}

/// Appends the SHA-256 of `data` as 64 lowercase hex digits.
fn append_hash(strbuf.str_buf mut* out, u8@ data) void {
    u8[32] digest = sha256.hash(data);
    append_digest(out, digest[..]);
}

// Adds one file to the interface hash in `*st`: its name, a newline, its byte count in decimal, a
// newline and its bytes.
fn add_file(sha256.state mut* st, string name, string text) void {
    strbuf.str_buf mut head = strbuf.create();
    defer strbuf.free(&head);
    strbuf.append(&head, name);
    strbuf.push(&head, '\n');
    strbuf.append_u64(&head, text.len);
    strbuf.push(&head, '\n');
    sha256.update(st, strbuf.bytes(&head));
    sha256.update(st, cast(text, u8@));
}

/// Appends the interface hash of a library (toolchain.md 2.2): the SHA-256 of one byte string.
/// For `interface.ft` and then `summaries/ownership`, the string holds the file name, a newline,
/// the byte count in decimal, a newline and the bytes. So the bytes of one file cannot move to the
/// other file and keep the hash.
fn append_interface_hash(strbuf.str_buf mut* out, string interface_text, string summaries_text)
    void {
    sha256.state mut st = sha256.state{};
    sha256.init(&st);
    add_file(&st, INTERFACE_FILE, interface_text);
    add_file(&st, OWNERSHIP_PATH, summaries_text);
    u8[32] digest = sha256.finish(&st);
    append_digest(out, digest[..]);
}

// The module of the unit of `set` whose path comes first in byte order after the path of
// `after`, or the first module of the unit when `after` is null. Null when no module follows.
// The unit is each module of the closure that no interface file declares, so under `--lib` it is
// every module of the library.
fn next_module(modules.module_set* set, modules.module* after) modules.module* {
    modules.module* mut best = null;
    u64 mut i = 0;
    while (i < modules.count(set)) {
        modules.module* m = modules.at(set, i);
        i += 1;
        if (m->interface || (after != null && str.cmp(m->path, after->path) <= 0)) {
            continue;
        }
        if (best == null || str.cmp(m->path, best->path) < 0) {
            best = m;
        }
    }
    return best;
}

// Adds one module to the source hash in `*st`: the module path, a newline, the path that the
// compiler opened, a newline, the byte count of the file in decimal, a newline and the bytes of
// the file. The two paths are written as manifest values.
fn add_source(sha256.state mut* st, string path, string file, string text) void {
    strbuf.str_buf mut head = strbuf.create();
    defer strbuf.free(&head);
    append_value(&head, path);
    strbuf.push(&head, '\n');
    append_value(&head, file);
    strbuf.push(&head, '\n');
    strbuf.append_u64(&head, text.len);
    strbuf.push(&head, '\n');
    sha256.update(st, strbuf.bytes(&head));
    sha256.update(st, cast(text, u8@));
}

/// Appends the source hash of the unit of `set` (toolchain.md 2.2): the modules of the closure
/// that no interface file declares, in byte order of the module path, each with the bytes that
/// the build parsed. The entry unit of a build with `--use` takes its hash here, after the parse.
fn hash_sources(modules.module_set* set, strbuf.str_buf mut* out) void {
    sha256.state mut st = sha256.state{};
    sha256.init(&st);
    modules.module* mut m = next_module(set, null);
    while (m != null) {
        add_source(&st, m->path, m->file, m->source);
        m = next_module(set, m);
    }
    u8[32] digest = sha256.finish(&st);
    append_digest(out, digest[..]);
}

/// Appends the source hash of the modules whose module paths are `paths`, whose opened files are
/// `files` and whose bytes are `texts` (toolchain.md 2.2). The three lists have one length and
/// are in byte order of the module path, as the walk of a library root gives them. A `--lib`
/// build takes its hash here, before the parse (toolchain.md 2.1, step 3).
fn hash_texts(string@ paths, string@ files, string@ texts, strbuf.str_buf mut* out) void {
    sha256.state mut st = sha256.state{};
    sha256.init(&st);
    u64 mut i = 0;
    while (i < paths.len) {
        add_source(&st, paths[i], files[i], texts[i]);
        i += 1;
    }
    u8[32] digest = sha256.finish(&st);
    append_digest(out, digest[..]);
}

/// Appends the compiler identity: the SHA-256 of the bytes of the running compiler executable.
/// Returns false when the system gives no path for the executable, with `*path` empty, or when
/// the file cannot be read, with its path in `*path` and the reason in sys.errno().
fn hash_compiler(strbuf.str_buf mut* out, strbuf.str_buf mut* path) bool {
    strbuf.clear(path);
    if (!os.exe_path(path)) {
        strbuf.clear(path);
        return false;
    }
    strbuf.str_buf mut bytes = strbuf.create();
    defer strbuf.free(&bytes);
    if (!io.read_file(strbuf.view(path), &bytes)) {
        return false;
    }
    append_hash(out, strbuf.bytes(&bytes));
    return true;
}

// ---- the manifest ------------------------------------------------------------------

/// The fields of the manifest of a library or of an entry unit (toolchain.md 2.2). The strings
/// and the spans are borrowed. A hash holds 64 lowercase hex digits. `cfg_values[i]` is the value
/// of `cfg_keys[i]`, and `use_hashes[i]` is the interface hash of the used library
/// `use_names[i]`. The pairs may come in any order: the manifest writes each list in byte order
/// of the key or the name. `cc_args` keeps the command-line order. The manifest of an entry unit
/// has `entry` in place of `library`, no `ar`, and `object` as its one output.
struct manifest {
    bool entry_unit; // the manifest of an entry unit
    string library;
    string entry; // the entry module path of an entry unit
    string compiler;
    string target;
    bool release;
    bool no_bounds_check;
    string@ cfg_keys;
    string@ cfg_values;
    string cc;
    string@ cc_args;
    string ar;
    string source;
    string@ use_names;
    string@ use_hashes;
    string interface;
    string archive;
    string object; // the hash of `object.o` of an entry unit
}

// Appends the line `<field> <value>` with the value escaped.
fn append_line(strbuf.str_buf mut* out, string field, string value) void {
    strbuf.append(out, field);
    strbuf.push(out, ' ');
    append_value(out, value);
    strbuf.push(out, '\n');
}

// Appends the line `<field> <first> <second>` with both values escaped. An empty value keeps
// its separating space, so the line has two values in every case.
fn append_pair(strbuf.str_buf mut* out, string field, string first, string second) void {
    strbuf.append(out, field);
    strbuf.push(out, ' ');
    append_value(out, first);
    strbuf.push(out, ' ');
    append_value(out, second);
    strbuf.push(out, '\n');
}

// The index in `keys` of the key that comes first in byte order after `after`, or the first key
// when `first` is set. -1 when no key follows. The keys are distinct.
fn next_key(string@ keys, string after, bool first) i64 {
    i64 mut best = -1;
    u64 mut i = 0;
    while (i < keys.len) {
        if ((first || str.cmp(keys[i], after) > 0)
            && (best < 0 || str.cmp(keys[i], keys[cast(best, u64)]) < 0)) {
            best = cast(i, i64);
        }
        i += 1;
    }
    return best;
}

// Appends one line `<field> <key> <value>` for each pair, in byte order of the key.
fn append_pairs(strbuf.str_buf mut* out, string field, string@ keys, string@ values) void {
    i64 mut k = next_key(keys, "", true);
    while (k >= 0) {
        u64 at = cast(k, u64);
        append_pair(out, field, keys[at], values[at]);
        k = next_key(keys, keys[at], false);
    }
}

// Appends the lines of `m` that the key covers, from `fort-manifest 1` to the last `use` line, in
// the order of toolchain.md 2.2.
fn append_head(manifest* m, strbuf.str_buf mut* out) void {
    append_line(out, "fort-manifest", FORMAT_VERSION);
    if (m->entry_unit) {
        append_line(out, "entry", m->entry);
    } else {
        append_line(out, "library", m->library);
    }
    append_line(out, "compiler", m->compiler);
    append_line(out, "target", m->target);
    if (m->release) {
        append_line(out, "mode", "release");
    } else {
        append_line(out, "mode", "checked");
    }
    if (m->no_bounds_check) {
        append_line(out, "bounds", "off");
    } else {
        append_line(out, "bounds", "on");
    }
    append_pairs(out, "cfg", m->cfg_keys, m->cfg_values);
    append_line(out, "cc", m->cc);
    u64 mut i = 0;
    while (i < m->cc_args.len) {
        append_line(out, "xcc", m->cc_args[i]);
        i += 1;
    }
    if (!m->entry_unit) {
        append_line(out, "ar", m->ar);
    }
    append_line(out, "source", m->source);
    append_pairs(out, "use", m->use_names, m->use_hashes);
}

/// Appends the key of `m` (toolchain.md 2.2): the SHA-256 of the manifest lines from
/// `fort-manifest 1` to the last `use` line, each with its newline. The output fields of `m` are
/// not read.
fn append_key(manifest* m, strbuf.str_buf mut* out) void {
    strbuf.str_buf mut head = strbuf.create();
    defer strbuf.free(&head);
    append_head(m, &head);
    append_hash(out, strbuf.bytes(&head));
}

/// Appends the manifest of `m` to `out`, one line for each field in the order of toolchain.md
/// 2.2. The key line holds the SHA-256 of the lines before it. The lines after the key give the
/// outputs, which the key does not cover: `interface`, `archive` and `summaries` for a library,
/// `object` for an entry unit.
fn write_manifest(manifest* m, strbuf.str_buf mut* out) void {
    u64 start = strbuf.view(out).len;
    append_head(m, out);
    strbuf.str_buf mut key = strbuf.create();
    defer strbuf.free(&key);
    append_hash(&key, strbuf.bytes(out)[start..]);
    append_line(out, "key", strbuf.view(&key));
    if (m->entry_unit) {
        append_line(out, "object", m->object);
        return;
    }
    append_line(out, "interface", m->interface);
    append_line(out, "archive", m->archive);
    append_line(out, "summaries", SUMMARIES_VERSION);
}

// ---- the artifact directory --------------------------------------------------------

/// `<dir>/<name>` in `out`. A directory that ends in `/` takes no second one.
fn join(strbuf.str_buf mut* out, string dir, string name) string {
    strbuf.clear(out);
    strbuf.append(out, dir);
    if (dir.len > 0 && dir[dir.len - 1] != '/') {
        strbuf.push(out, '/');
    }
    strbuf.append(out, name);
    return strbuf.view(out);
}

/// Makes the directory `path` when it does not exist. Returns false with the errno value in
/// `*error` when mkdir(2) fails for another reason, or when `path` names no directory. A symbolic
/// link to a directory names a directory.
fn make_dir(string path, i32 mut* error) bool {
    char mut@ own c_path = str.to_cstr(path);
    defer del(c_path);
    if (libc.mkdir(c_path.ptr, DIR_MODE) == 0) {
        return true;
    }
    i32 failure = sys.errno();
    if (failure != libc.EEXIST) {
        *error = failure;
        return false;
    }
    // Something stands at the path: it must be a directory.
    void mut* d = libc.opendir(c_path.ptr);
    if (d == null) {
        *error = sys.errno();
        return false;
    }
    libc.closedir(d);
    return true;
}

// Removes `path`. Returns false with the errno value in `*error` when unlink(2) fails for a
// reason other than a missing file.
fn remove_file(string path, i32 mut* error) bool {
    char mut@ own c_path = str.to_cstr(path);
    defer del(c_path);
    if (libc.unlink(c_path.ptr) == 0 || sys.errno() == libc.ENOENT) {
        return true;
    }
    *error = sys.errno();
    return false;
}

// Whether `path` is a symbolic link: readlink(2) succeeds on a link alone.
fn is_link(string path) bool {
    char mut@ own c_path = str.to_cstr(path);
    defer del(c_path);
    char[LINK_PROBE_CAP] mut buf = {};
    return libc.readlink(c_path.ptr, &buf[0], LINK_PROBE_CAP) >= 0;
}

// Makes the directory `path` when it does not exist and removes each entry in it, so a file of an
// older build does not stay. A `path` that is a symbolic link is refused (ELOOP), so the writer
// removes nothing outside the artifact. An entry that is a directory must be empty. The writer
// opens `path` with O_NOFOLLOW and removes each entry relative to that descriptor, so a link that
// replaces the directory during the removals does not redirect them. Returns false with the path
// that failed in `*failed` and the errno value in `*error`.
fn make_empty_dir(string path, strbuf.str_buf mut* failed, i32 mut* error) bool {
    char mut@ own c_path = str.to_cstr(path);
    defer del(c_path);
    if (libc.mkdir(c_path.ptr, DIR_MODE) != 0 && sys.errno() != libc.EEXIST) {
        *error = sys.errno();
        strbuf.append(failed, path);
        return false;
    }
    i32 fd = libc.open(c_path.ptr, libc.O_RDONLY | libc.O_DIRECTORY | libc.O_NOFOLLOW, 0);
    if (fd < 0) {
        *error = sys.errno();
        // Linux gives ENOTDIR for a link when O_DIRECTORY is set, darwin ELOOP; a link is ELOOP
        if (is_link(path)) {
            *error = libc.ELOOP;
        }
        strbuf.append(failed, path);
        return false;
    }
    // closedir(3) closes `fd` as well
    void mut* stream = libc.fdopendir(fd);
    if (stream == null) {
        *error = sys.errno();
        libc.close(fd);
        strbuf.append(failed, path);
        return false;
    }
    // The names are copied out before any removal, each ended by a NUL, because a removal while
    // readdir(3) walks the directory can make it skip an entry. errno is 0 before each readdir(3),
    // so it is 0 after the last one at the end and the error number after an error.
    strbuf.str_buf mut names = strbuf.create();
    defer strbuf.free(&names);
    *libc.errno_slot() = 0;
    libc.dirent* mut e = cast(libc.readdir(stream), libc.dirent*);
    while (e != null) {
        string name = str.from_cstr(&e->name[0]);
        if (name != "." && name != "..") {
            strbuf.append(&names, name);
            strbuf.push(&names, '\0');
        }
        *libc.errno_slot() = 0;
        e = cast(libc.readdir(stream), libc.dirent*);
    }
    i32 failure = sys.errno();
    if (failure != 0) {
        libc.closedir(stream);
        *error = failure;
        strbuf.append(failed, path);
        return false;
    }
    bool removed = remove_names(fd, strbuf.view(&names), path, failed, error);
    libc.closedir(stream);
    return removed;
}

// Removes each entry of the directory `path`, open as `fd`, whose name `all` holds with a NUL after
// each name, for make_empty_dir. Returns false with the path that failed in `*failed` and the errno
// value in `*error`. The caller keeps the buffer of `all`, so it is no local owner here.
fn remove_names(i32 fd, string all, string path, strbuf.str_buf mut* failed, i32 mut* error)
    bool {
    u64 mut at = 0;
    while (at < all.len) {
        u64 mut end = at;
        while (all[end] != '\0') {
            end += 1;
        }
        char mut@ own c_name = str.to_cstr(all[at..end]);
        defer del(c_name);
        // unlinkat(2) removes a file or a link itself; it refuses a directory, which
        // AT_REMOVEDIR removes when it is empty
        if (libc.unlinkat(fd, c_name.ptr, 0) != 0) {
            i32 unlinked = sys.errno();
            if (libc.unlinkat(fd, c_name.ptr, libc.AT_REMOVEDIR) != 0) {
                *error = sys.errno();
                if (*error == libc.ENOTDIR) {
                    *error = unlinked;
                }
                strbuf.append(failed, path);
                strbuf.push(failed, '/');
                strbuf.append(failed, all[at..end]);
                return false;
            }
        }
        at = end + 1;
    }
    return true;
}

// Writes `data` to `<dir>/<name>.tmp.<pid>` and renames that file to `<dir>/<name>`, as
// replace_with_mode does, with the mode of a file of an artifact.
fn replace(string dir, string name, u8@ data, i32 mut* error) bool {
    bool mut made = false;
    return replace_with_mode(dir, name, data, FILE_MODE, &made, error);
}

// Writes `data` to `<dir>/<name>.tmp.<pid>` and renames that file to `<dir>/<name>`, so the
// name holds the old bytes or the new bytes and never a part. A file or a link at the temporary
// name is removed first, and the temporary file must then be new (O_EXCL), so the write goes
// through no link and an entry that stays there, such as a directory, fails it. The new file
// gets `mode` less the umask of the process, and `*made` says that it was made. Returns false
// with the errno value in `*error`, and a temporary file that this call made removed, when a step
// fails.
fn replace_with_mode(string dir, string name, u8@ data, i32 mode, bool mut* made, i32 mut* error)
    bool {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, name);
    strbuf.append(&b, TEMP_INFIX);
    strbuf.append_i64(&b, cast(libc.getpid(), i64));
    strbuf.str_buf mut temp_buf = strbuf.create();
    defer strbuf.free(&temp_buf);
    string temp = join(&temp_buf, dir, strbuf.view(&b));
    strbuf.str_buf mut final_buf = strbuf.create();
    defer strbuf.free(&final_buf);
    string final_path = join(&final_buf, dir, name);
    char mut@ own c_temp = str.to_cstr(temp);
    defer del(c_temp);
    // A file or a link that an earlier run with this pid left goes first; unlink(2) does not
    // follow a link. O_EXCL then refuses an entry that stays or that a race puts there.
    libc.unlink(c_temp.ptr);
    i32 fd = libc.open(c_temp.ptr, libc.O_WRONLY | libc.O_CREAT | libc.O_EXCL, mode);
    if (fd < 0) {
        *error = sys.errno();
        return false;
    }
    *made = true;
    bool mut ok = io.write_all(fd, data);
    i32 mut failure = 0;
    if (!ok) {
        failure = sys.errno();
    }
    if (!io.close(fd) && ok) {
        failure = sys.errno();
        ok = false;
    }
    if (!ok) {
        *error = failure;
        libc.unlink(c_temp.ptr);
        return false;
    }
    char mut@ own c_final = str.to_cstr(final_path);
    defer del(c_final);
    if (libc.rename(c_temp.ptr, c_final.ptr) != 0) {
        *error = sys.errno();
        libc.unlink(c_temp.ptr);
        return false;
    }
    return true;
}

/// Writes the artifact `dir` by the write protocol of toolchain.md 2.2: it makes `dir` when it
/// does not exist and removes `dir/manifest`. It makes `dir/summaries` when it does not exist and
/// removes each entry in it, and it refuses a `summaries` that is a symbolic link. It writes
/// `interface.ft`, `summaries/ownership` and then `lib.a`, each to a new temporary name that it
/// renames, and it writes the manifest last in the same way. Returns false at the first step that
/// fails, with the path of that step in `*failed` and the errno value in `*error`.
fn write(string dir, string interface_text, string summaries_text, u8@ archive,
         string manifest_text, strbuf.str_buf mut* failed, i32 mut* error) bool {
    if (!clear_manifest(dir, failed, error)) {
        return false;
    }
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    // summaries/ goes first, so a refused one leaves the files of the older build as they were
    if (!make_empty_dir(join(&b, dir, SUMMARIES_DIR), failed, error)) {
        return false;
    }
    if (!replace(dir, INTERFACE_FILE, cast(interface_text, u8@), error)) {
        strbuf.append(failed, join(&b, dir, INTERFACE_FILE));
        return false;
    }
    strbuf.str_buf mut sums = strbuf.create();
    defer strbuf.free(&sums);
    string sums_dir = join(&sums, dir, SUMMARIES_DIR);
    if (!replace(sums_dir, OWNERSHIP_FILE, cast(summaries_text, u8@), error)) {
        strbuf.append(failed, join(&b, sums_dir, OWNERSHIP_FILE));
        return false;
    }
    if (!replace(dir, ARCHIVE_FILE, archive, error)) {
        strbuf.append(failed, join(&b, dir, ARCHIVE_FILE));
        return false;
    }
    if (!replace(dir, MANIFEST_FILE, cast(manifest_text, u8@), error)) {
        strbuf.append(failed, join(&b, dir, MANIFEST_FILE));
        return false;
    }
    return true;
}

// The first two steps of the write protocol (toolchain.md 2.2): makes `dir` when it does not
// exist and removes `dir/manifest`, so a reader finds no manifest until the last step. Returns
// false with the path that failed in `*failed` and the errno value in `*error`.
fn clear_manifest(string dir, strbuf.str_buf mut* failed, i32 mut* error) bool {
    strbuf.clear(failed);
    if (!make_dir(dir, error)) {
        strbuf.append(failed, dir);
        return false;
    }
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    if (!remove_file(join(&b, dir, MANIFEST_FILE), error)) {
        strbuf.append(failed, strbuf.view(&b));
        return false;
    }
    return true;
}

/// Writes the cache entry `dir` of an entry unit by the write protocol of toolchain.md 2.2: it
/// makes `dir` when it does not exist, removes `dir/manifest`, writes `object.o` to a new
/// temporary name that it renames, and writes the manifest last in the same way. Returns false
/// at the first step that fails, with the path of that step in `*failed` and the errno value in
/// `*error`.
fn write_object(string dir, u8@ object, string manifest_text, strbuf.str_buf mut* failed,
                i32 mut* error) bool {
    if (!clear_manifest(dir, failed, error)) {
        return false;
    }
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    if (!replace(dir, OBJECT_FILE, object, error)) {
        strbuf.append(failed, join(&b, dir, OBJECT_FILE));
        return false;
    }
    if (!replace(dir, MANIFEST_FILE, cast(manifest_text, u8@), error)) {
        strbuf.append(failed, join(&b, dir, MANIFEST_FILE));
        return false;
    }
    return true;
}

// The mode of an output that write_output makes, as a compiler gives it: the umask applies.
i32 OUTPUT_MODE = 0o666;

// Whether the output `path` takes a temporary file and a rename: stat(2), which follows each
// symbolic link, finds a regular file or no file there. A link to a regular file is then
// replaced, and its target keeps its bytes.
fn is_replaceable(string path) bool {
    u32 mut mode = 0;
    if (!os.path_mode(path, &mode)) {
        return sys.errno() == libc.ENOENT;
    }
    return (mode & S_IFMT) == S_IFREG;
}

/// Writes `data` to the output `path`, the `-c` output of a build with `--use` (toolchain.md 2.1,
/// step 7), as a compiler writes its output. When stat(2) finds a regular file or no file at
/// `path`, the bytes go to a temporary file in the same directory by the rules of replace, which
/// is renamed over `path`: so a failed write leaves the old file, a link at `path` is replaced,
/// and the new file has the mode 0666 less the umask. A device, a FIFO or another type, such as
/// /dev/null or /dev/stdout, is written in place, and so is a path whose temporary file cannot be
/// made. Returns false with the errno value in `*error`.
fn write_output(string path, u8@ data, i32 mut* error) bool {
    if (is_replaceable(path)) {
        u64 mut start = 0;
        u64 mut i = 0;
        while (i < path.len) {
            if (path[i] == '/') {
                start = i + 1;
            }
            i += 1;
        }
        bool mut made = false;
        bool ok = replace_with_mode(path[..start], path[start..], data, OUTPUT_MODE, &made, error);
        if (ok || made) {
            return ok;
        }
        // no temporary file could be made, as in a directory that the process cannot write
    }
    if (!io.write_file(path, data)) {
        *error = sys.errno();
        return false;
    }
    return true;
}

// ---- reading a used artifact -------------------------------------------------------

// The number of hex digits of a hash.
u64 HASH_DIGITS = 64;

// The value of an escaped byte: its two uppercase hex digits.
u64 HEX_DIGIT_TEN = 10;

/// What reading an artifact found (toolchain.md 2.2, Validation).
enum verdict {
    v_valid, // every rule holds
    v_unreadable, // the system refused a read; the errno value says why
    v_corrupt, // a rule does not hold
}

/// A used artifact or a cache entry, read once: the fields of its manifest and the bytes of its
/// interface file, its summary file and its archive, with the summaries that the summary file
/// gives, or the bytes of the object of an entry unit (toolchain.md 2.2, Reading). The strings and
/// the spans of `fields` and `key` point into the other members, so a value is used and freed at
/// one address. A zero value is empty.
struct contents {
    manifest fields;
    string key; // the value of the key line
    strbuf.str_buf text; // the bytes of `manifest`
    strbuf.str_buf interface; // the bytes of `interface.ft`
    strbuf.str_buf summaries; // the bytes of `summaries/ownership`
    summary.table ownership; // the summaries that `summaries/ownership` gives
    strbuf.str_buf archive; // the bytes of `lib.a`
    strbuf.str_buf object; // the bytes of `object.o`
    containers.pool values; // the decoded values
    containers.str_vec cfg_keys;
    containers.str_vec cfg_values;
    containers.str_vec cc_args;
    containers.str_vec use_names;
    containers.str_vec use_hashes;
}

/// Releases the contents. The value is empty and usable afterwards.
fn free(contents mut* c) void {
    c->fields = manifest{};
    c->key = "";
    strbuf.free(&c->text);
    strbuf.free(&c->interface);
    strbuf.free(&c->summaries);
    summary.free_table(&c->ownership);
    strbuf.free(&c->archive);
    strbuf.free(&c->object);
    containers.pool_free(&c->values);
    containers.str_free(&c->cfg_keys);
    containers.str_free(&c->cfg_values);
    containers.str_free(&c->cc_args);
    containers.str_free(&c->use_names);
    containers.str_free(&c->use_hashes);
}

// The value of the hex digit `ch` in the form of a value, 0 to 15, or -1 for another byte: the
// digits 0 to 9 and the uppercase letters A to F.
fn upper_digit(char ch) i64 {
    if (ch >= '0' && ch <= '9') {
        return cast(ch, i64) - cast('0', i64);
    }
    if (ch >= 'A' && ch <= 'F') {
        return cast(ch, i64) - cast('A', i64) + cast(HEX_DIGIT_TEN, i64);
    }
    return -1;
}

// Decodes the manifest value `text`, interned in `p`: each `\xHH` with two uppercase hex digits is
// its byte, and each other byte stays as it is. parse_manifest then compares the text that the
// writer writes from the decoded values with `text`, which refuses every other spelling: a byte
// outside 0x21 to 0x7E, a `\` that starts no escape, and an escape of a byte that stays.
fn decode(string text, containers.pool mut* p) string {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    u64 mut i = 0;
    while (i < text.len) {
        if (text[i] == '\\' && i + 3 < text.len && text[i + 1] == 'x') {
            i64 high = upper_digit(text[i + 2]);
            i64 low = upper_digit(text[i + 3]);
            if (high >= 0 && low >= 0) {
                strbuf.push_byte(&b, cast((cast(high, u64) << HEX_SHIFT) | cast(low, u64), u8));
                i += 4;
                continue;
            }
        }
        strbuf.push(&b, text[i]);
        i += 1;
    }
    return containers.pool_intern(p, strbuf.view(&b));
}

/// Whether `text` is a hash: 64 lowercase hex digits.
fn is_hash(string text) bool {
    if (text.len != HASH_DIGITS) {
        return false;
    }
    u64 mut i = 0;
    while (i < text.len) {
        char ch = text[i];
        if (!((ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'f'))) {
            return false;
        }
        i += 1;
    }
    return true;
}

// Splits `text` at its first space into `*first` and `*second`. Returns false when it holds
// no space.
fn split_pair(string text, string mut* first, string mut* second) bool {
    i64 space = str.index_of(text, ' ');
    if (space < 0) {
        return false;
    }
    *first = text[..cast(space, u64)];
    *second = text[cast(space, u64) + 1..];
    return true;
}

// Decodes the value pair `text` of a `cfg` or a `use` line and pushes its two values. Returns
// false when the text holds no space.
fn parse_pair(string text, containers.pool mut* p, containers.str_vec mut* firsts,
              containers.str_vec mut* seconds) bool {
    string mut first = "";
    string mut second = "";
    if (!split_pair(text, &first, &second)) {
        return false;
    }
    containers.str_push(firsts, decode(first, p));
    containers.str_push(seconds, decode(second, p));
    return true;
}

// Reads one manifest line `<field> <value>` into `*c`. Returns false for a line with no value, a
// field that no manifest holds, and a hash that is not one: the writer writes any
// value of a hash field as it is, so the comparison of parse_manifest cannot refuse it. The order
// of the lines, the value form and the words of the versions and the modes are not read here.
fn parse_line(string line, contents mut* c) bool {
    string mut field = "";
    string mut rest = "";
    if (!split_pair(line, &field, &rest)) {
        return false;
    }
    if (field == "cfg") {
        return parse_pair(rest, &c->values, &c->cfg_keys, &c->cfg_values);
    }
    if (field == "use") {
        if (!parse_pair(rest, &c->values, &c->use_names, &c->use_hashes)) {
            return false;
        }
        return is_hash(containers.str_at(&c->use_hashes, c->use_hashes.len - 1));
    }
    string value = decode(rest, &c->values);
    if (field == "compiler" || field == "source" || field == "key" || field == "interface"
        || field == "archive" || field == "object") {
        if (!is_hash(value)) {
            return false;
        }
    }
    if (field == "fort-manifest" || field == "summaries") {
        // the writer writes the versions that this reader knows, so the comparison refuses others
        return true;
    } else if (field == "library") {
        c->fields.library = value;
    } else if (field == "entry") {
        // the comparison of parse_manifest refuses a text with both `library` and `entry`
        c->fields.entry_unit = true;
        c->fields.entry = value;
    } else if (field == "compiler") {
        c->fields.compiler = value;
    } else if (field == "target") {
        c->fields.target = value;
    } else if (field == "mode") {
        // another word reads as `checked`, which the comparison of parse_manifest refuses
        c->fields.release = value == "release";
    } else if (field == "bounds") {
        c->fields.no_bounds_check = value == "off";
    } else if (field == "cc") {
        c->fields.cc = value;
    } else if (field == "xcc") {
        containers.str_push(&c->cc_args, value);
    } else if (field == "ar") {
        c->fields.ar = value;
    } else if (field == "source") {
        c->fields.source = value;
    } else if (field == "key") {
        c->key = value;
    } else if (field == "interface") {
        c->fields.interface = value;
    } else if (field == "archive") {
        c->fields.archive = value;
    } else if (field == "object") {
        c->fields.object = value;
    } else {
        return false;
    }
    return true;
}

/// Reads the manifest `text` of a library or of an entry unit into `*c` and holds rules 1 to 3 of
/// toolchain.md 2.2, Validation: each line has the form and the order of the table, the first
/// line is `fort-manifest 1`, the last of a library is `summaries 2`, and the key line holds the
/// SHA-256 of the lines before it. Returns false when one does not hold. `c->fields.entry_unit`
/// says which form the text has. The values are decoded into `c->values`, and the fields of an
/// earlier parse are replaced.
fn parse_manifest(string text, contents mut* c) bool {
    c->fields = manifest{};
    c->key = "";
    c->cfg_keys.len = 0;
    c->cfg_values.len = 0;
    c->cc_args.len = 0;
    c->use_names.len = 0;
    c->use_hashes.len = 0;
    u64 mut at = 0;
    while (at < text.len) {
        u64 mut end = at;
        while (end < text.len && text[end] != '\n') {
            end += 1;
        }
        if (end == text.len) {
            // each line ends with one newline byte
            return false;
        }
        if (!parse_line(text[at..end], c)) {
            return false;
        }
        at = end + 1;
    }
    c->fields.cfg_keys = containers.str_items(&c->cfg_keys);
    c->fields.cfg_values = containers.str_items(&c->cfg_values);
    c->fields.cc_args = containers.str_items(&c->cc_args);
    c->fields.use_names = containers.str_items(&c->use_names);
    c->fields.use_hashes = containers.str_items(&c->use_hashes);
    // The writer writes each field once, in the order of the table, the lists sorted and the key
    // computed, so a text that it does not write again byte for byte breaks a rule.
    strbuf.str_buf mut again = strbuf.create();
    defer strbuf.free(&again);
    write_manifest(&c->fields, &again);
    return strbuf.view(&again) == text;
}

// The type bits of `st_mode` and the type of a regular file, the POSIX values of both targets.
u32 S_IFMT = 0o170000;
u32 S_IFREG = 0o100000;

// Reads the file `<dir>/<name>` into `out`. Returns v_valid; v_corrupt when no entry stands at
// the name or when the entry, after the link that it can be, is no regular file; or v_unreadable
// with the errno value in `*error` for each other failure. The open does not wait for the writer
// of a FIFO, and fstat(2) refuses the FIFO before a read.
fn read_entry(string dir, string name, strbuf.str_buf mut* out, i32 mut* error) verdict {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.clear(out);
    i32 fd = os.open_nonblocking(join(&b, dir, name));
    if (fd < 0) {
        if (sys.errno() == libc.ENOENT) {
            return verdict.v_corrupt;
        }
        *error = sys.errno();
        return verdict.v_unreadable;
    }
    defer libc.close(fd);
    u32 mut mode = 0;
    if (!os.file_mode(fd, &mode)) {
        *error = sys.errno();
        return verdict.v_unreadable;
    }
    if ((mode & S_IFMT) != S_IFREG) {
        return verdict.v_corrupt;
    }
    if (!io.read_all(fd, out)) {
        *error = sys.errno();
        return verdict.v_unreadable;
    }
    return verdict.v_valid;
}

// Whether `data` hashes to `hash`.
fn has_hash(u8@ data, string hash) bool {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    append_hash(&b, data);
    return strbuf.view(&b) == hash;
}

// The start of a bodiless function declaration in an interface file, before its name.
string FUNCTION_DECL = "fn ";

// Puts into `out` the symbol of each bodiless function that the interface text `text` declares, a
// line `fn <decl>(` in the section `//! module <path>`, as `<path>.<decl>` (module-system.md 10.3).
// Each declaration of an interface file stands on one line, so one scan reads each. The symbols
// go into `p`, which `out` borrows them from.
fn put_declared(string text, containers.pool mut* p, strmap.str_map mut* out) void {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    string mut section = "";
    u64 mut at = 0;
    while (at < text.len) {
        u64 mut end = at;
        while (end < text.len && text[end] != '\n') {
            end += 1;
        }
        string l = text[at..end];
        at = end + 1;
        if (str.starts_with(l, modules.INTERFACE_SECTION)) {
            section = l[modules.INTERFACE_SECTION.len..];
            continue;
        }
        i64 paren = str.index_of(l, '(');
        // a constant of a function type, `fn (T) R NAME`, has its `(` right after `fn `
        if (section.len == 0 || !str.starts_with(l, FUNCTION_DECL)
            || paren <= cast(FUNCTION_DECL.len, i64)) {
            continue;
        }
        strbuf.clear(&b);
        strbuf.append(&b, section);
        strbuf.push(&b, '.');
        strbuf.append(&b, l[FUNCTION_DECL.len..cast(paren, u64)]);
        strmap.put(out, containers.pool_intern(p, strbuf.view(&b)), 1);
    }
}

// Whether each function of the summaries `t` is a bodiless function that the interface text
// `text` declares (spec/ownership-design.md 8.2). The declarations are read once, and a table
// with no entry reads none.
fn declares_each(string text, summary.table* t) bool {
    if (summary.entry_count(t) == 0) {
        return true;
    }
    containers.pool mut names = containers.pool_create();
    defer containers.pool_free(&names);
    strmap.str_map mut declared = strmap.create();
    defer strmap.free(&declared);
    put_declared(text, &names, &declared);
    u64 mut i = 0;
    while (i < summary.entry_count(t)) {
        if (!strmap.has(&declared, summary.symbol(t, i))) {
            return false;
        }
        i += 1;
    }
    return true;
}

/// Reads the artifact `dir` of a used library once and checks it (toolchain.md 2.2, Reading and
/// Validation). It reads `manifest`, `interface.ft`, `summaries/ownership` and `lib.a` once each
/// into `*c`, and the caller uses only those bytes and the summaries in `c->ownership`. Returns
/// v_valid when each rule holds, v_corrupt when one does not, and v_unreadable with the errno
/// value in `*error` when the system refuses to open `dir` or to read a file of it. A file that is
/// absent breaks a rule, and so does a `summaries` that is no directory or that is a symbolic
/// link, a summary file that is no text form of the library, and a summary of a function that
/// `interface.ft` declares with no bodiless `fn` declaration.
fn read(string dir, contents mut* c, i32 mut* error) verdict {
    char mut@ own c_dir = str.to_cstr(dir);
    defer del(c_dir);
    i32 fd = libc.open(c_dir.ptr, libc.O_RDONLY | libc.O_DIRECTORY, 0);
    if (fd < 0) {
        *error = sys.errno();
        return verdict.v_unreadable;
    }
    libc.close(fd);
    verdict mut found = read_entry(dir, MANIFEST_FILE, &c->text, error);
    if (found != verdict.v_valid) {
        return found;
    }
    // The manifest of an entry unit is no manifest of a library: its `interface` field is empty,
    // and no interface hash is the empty string, so the check of the interface hash refuses it.
    if (!parse_manifest(strbuf.view(&c->text), c)) {
        return verdict.v_corrupt;
    }
    found = read_entry(dir, INTERFACE_FILE, &c->interface, error);
    if (found != verdict.v_valid) {
        return found;
    }
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    char mut@ own c_summaries = str.to_cstr(join(&b, dir, SUMMARIES_DIR));
    defer del(c_summaries);
    i32 sd = libc.open(c_summaries.ptr, libc.O_RDONLY | libc.O_DIRECTORY | libc.O_NOFOLLOW, 0);
    if (sd < 0) {
        i32 failure = sys.errno();
        // no entry, an entry that is no directory, and a link (ELOOP on darwin, ENOTDIR on Linux)
        if (failure == libc.ENOENT || failure == libc.ENOTDIR || failure == libc.ELOOP) {
            return verdict.v_corrupt;
        }
        *error = failure;
        return verdict.v_unreadable;
    }
    libc.close(sd);
    found = read_entry(join(&b, dir, SUMMARIES_DIR), OWNERSHIP_FILE, &c->summaries, error);
    if (found != verdict.v_valid) {
        return found;
    }
    strbuf.clear(&b);
    append_interface_hash(&b, strbuf.view(&c->interface), strbuf.view(&c->summaries));
    if (strbuf.view(&b) != c->fields.interface) {
        return verdict.v_corrupt;
    }
    found = read_entry(dir, ARCHIVE_FILE, &c->archive, error);
    if (found != verdict.v_valid) {
        return found;
    }
    if (!has_hash(strbuf.bytes(&c->archive), c->fields.archive)) {
        return verdict.v_corrupt;
    }
    summary.free_table(&c->ownership);
    if (!summary.parse(strbuf.view(&c->summaries), c->fields.library, &c->ownership)
        || !declares_each(strbuf.view(&c->interface), &c->ownership)) {
        return verdict.v_corrupt;
    }
    return verdict.v_valid;
}

/// Reads the cache entry `dir` of an entry unit once and checks it (toolchain.md 2.2 and 2.3). It
/// reads `manifest` and `object.o` once each into `*c`, and the caller uses only those bytes.
/// Returns v_valid when the manifest is the manifest of an entry unit and the hash of the object
/// equals its `object` line, v_corrupt when a rule does not hold, and v_unreadable with the
/// errno value in `*error` when the system refuses to open `dir` or to read a file of it.
fn read_object(string dir, contents mut* c, i32 mut* error) verdict {
    char mut@ own c_dir = str.to_cstr(dir);
    defer del(c_dir);
    i32 fd = libc.open(c_dir.ptr, libc.O_RDONLY | libc.O_DIRECTORY, 0);
    if (fd < 0) {
        *error = sys.errno();
        return verdict.v_unreadable;
    }
    libc.close(fd);
    verdict mut found = read_entry(dir, MANIFEST_FILE, &c->text, error);
    if (found != verdict.v_valid) {
        return found;
    }
    // The manifest of a library is no manifest of an entry unit: its `object` field is empty,
    // and no file hashes to the empty string, so the check of object.o refuses it.
    if (!parse_manifest(strbuf.view(&c->text), c)) {
        return verdict.v_corrupt;
    }
    found = read_entry(dir, OBJECT_FILE, &c->object, error);
    if (found != verdict.v_valid) {
        return found;
    }
    if (!has_hash(strbuf.bytes(&c->object), c->fields.object)) {
        return verdict.v_corrupt;
    }
    return verdict.v_valid;
}

// Whether the pair `key` and `value` is one of `keys` and `values`.
fn holds_pair(string@ keys, string@ values, string key, string value) bool {
    u64 mut i = 0;
    while (i < keys.len) {
        if (keys[i] == key && values[i] == value) {
            return true;
        }
        i += 1;
    }
    return false;
}

/// The first field that differs between the manifest of a used library `used` and the fields of
/// the build `build`, in the order of the manifest: `compiler`, `target`, `build mode`, `bounds
/// mode` or `configuration`, the word of the message `library '<name>' was built with another
/// <field>` (toolchain.md 1). Empty when the five agree. The configuration maps agree when they
/// hold the same pairs in any order. Each map holds each key once.
fn difference(manifest* used, manifest* build) string {
    if (used->compiler != build->compiler) {
        return "compiler";
    }
    if (used->target != build->target) {
        return "target";
    }
    if (used->release != build->release) {
        return "build mode";
    }
    if (used->no_bounds_check != build->no_bounds_check) {
        return "bounds mode";
    }
    if (used->cfg_keys.len != build->cfg_keys.len) {
        return "configuration";
    }
    u64 mut i = 0;
    while (i < build->cfg_keys.len) {
        if (!holds_pair(used->cfg_keys, used->cfg_values, build->cfg_keys[i],
                        build->cfg_values[i])) {
            return "configuration";
        }
        i += 1;
    }
    return "";
}
