/// Defines canonical LLVM IR signatures for `std.rt` entry points.

import prim;
import types;

// The runtime entry points, in the order the table
// lists them. `rt_none` is the C's RT_COUNT: no entry point, which is what a
// name that is not one denotes.
enum rt_entry {
    rt_alloc,
    rt_free,
    rt_str_eq,
    rt_fail_bounds,
    rt_fail_span,
    rt_fail_overflow,
    rt_fail_shift,
    rt_fail_div_zero,
    rt_fail_div_overflow,
    rt_fail_alloc_count,
    rt_fail_overwrite,
    rt_fail_enum,
    rt_panic,
    rt_assert_fail,
    rt_print_i64,
    rt_print_u64,
    rt_print_f32,
    rt_print_f64,
    rt_print_bool,
    rt_print_char,
    rt_print_ptr,
    rt_print_str,
    rt_print_enum,
    rt_flush,
    rt_flush_all,
    rt_args_init,
    rt_args,
    rt_shutdown,
    rt_exit,
    rt_none,
}

// An IR parameter or result form: the type text together with the extension attribute a narrow
// value carries on both sides of the boundary. `bool` has its own form. It is `i1` as a value and
// `i8` in memory. Thus, a `bool` argument differs from `u8`.
enum ir_form {
    ir_void, // `void`, a result only
    ir_ptr, // `ptr`: every pointer, `void*` and function pointer
    ir_bool, // `i1 zeroext`
    ir_i8,   // `i8 signext`
    ir_u8, // `i8 zeroext`: `u8` and `char`, C's `unsigned char`
    ir_i16,  // `i16 signext`
    ir_u16,  // `i16 zeroext`
    ir_i32, // `i32`, `u32` and every enum, which is passed as `i32`
    ir_i64,  // `i64`: `i64` and `u64`
    ir_f32,  // `float`
    ir_f64,  // `double`
    ir_none, // no IR form: a type an extern signature may not use
}

// The entry points, which is what rt_entry_of walks.
u64 RT_ENTRY_COUNT = 29;

// The widest parameter list, which is
// `fail_span(i64, i64, i64, ptr, i32, i32)`.
u64 RT_MAX_PARAMS = 6;

// One entry point: its mangled fort name, its result form, its `noreturn` state,
// and its parameter forms in order, padded
// with ir_none. The
// list ends at the first ir_none, so the arity is read off the row rather
// than counted by hand beside it.
struct rt_sig {
    string name;
    ir_form result;
    bool is_noreturn;
    ir_form p0;
    ir_form p1;
    ir_form p2;
    ir_form p3;
    ir_form p4;
    ir_form p5;
}

// Creates a row with no parameters. Each row below starts from it. Unused parameter slots contain
// ir_none, as in the C table.
fn row(string name, ir_form result, bool is_noreturn) rt_sig {
    return rt_sig{name, result, is_noreturn, ir_form.ir_none, ir_form.ir_none, ir_form.ir_none,
                  ir_form.ir_none, ir_form.ir_none, ir_form.ir_none};
}

fn row1(string name, ir_form result, bool is_noreturn, ir_form p0) rt_sig {
    rt_sig mut r = row(name, result, is_noreturn);
    r.p0 = p0;
    return r;
}

fn row2(string name, ir_form result, bool is_noreturn, ir_form p0, ir_form p1) rt_sig {
    rt_sig mut r = row1(name, result, is_noreturn, p0);
    r.p1 = p1;
    return r;
}

fn row3(string name, ir_form result, bool is_noreturn, ir_form p0, ir_form p1, ir_form p2) rt_sig {
    rt_sig mut r = row2(name, result, is_noreturn, p0, p1);
    r.p2 = p2;
    return r;
}

fn row4(string name, ir_form result, bool is_noreturn, ir_form p0, ir_form p1, ir_form p2,
               ir_form p3) rt_sig {
    rt_sig mut r = row3(name, result, is_noreturn, p0, p1, p2);
    r.p3 = p3;
    return r;
}

fn row5(string name, ir_form result, bool is_noreturn, ir_form p0, ir_form p1, ir_form p2,
               ir_form p3, ir_form p4) rt_sig {
    rt_sig mut r = row4(name, result, is_noreturn, p0, p1, p2, p3);
    r.p4 = p4;
    return r;
}

fn row6(string name, ir_form result, bool is_noreturn, ir_form p0, ir_form p1, ir_form p2,
               ir_form p3, ir_form p4, ir_form p5) rt_sig {
    rt_sig mut r = row5(name, result, is_noreturn, p0, p1, p2, p3, p4);
    r.p5 = p5;
    return r;
}

// Maps fort signatures to IR forms in table order. Both `u64` and `i64` use `i64`. `u32` uses
// `i32`. `char` uses `i8 zeroext`, and `bool` uses `i1 zeroext`. Each pointer uses `ptr`. A `loc`
// expands to `ptr, i32, i32`. `args` returns a `string@`, an aggregate, so it is a `void` function
// with a leading `ptr`. Each `fail_*` function, `panic`, `assert_fail`, and `exit` is `fn
// noreturn`. Each row states this attribute. Thus, insertion order cannot add the attribute to
// another entry point. The two float printers are rows of `std.rt` like every other one: the
// separate float module is folded into the runtime.
fn rt_sig_of(rt_entry rt) rt_sig {
    switch (rt) {
    case rt_entry.rt_alloc:
        return row5("std.rt.alloc", ir_form.ir_ptr, false, ir_form.ir_i64, ir_form.ir_i64,
                    ir_form.ir_ptr, ir_form.ir_i32, ir_form.ir_i32);
    case rt_entry.rt_free:
        return row1("std.rt.free", ir_form.ir_void, false, ir_form.ir_ptr);
    case rt_entry.rt_str_eq:
        return row4("std.rt.str_eq", ir_form.ir_bool, false, ir_form.ir_ptr, ir_form.ir_i64,
                    ir_form.ir_ptr, ir_form.ir_i64);
    case rt_entry.rt_fail_bounds:
        return row5("std.rt.fail_bounds", ir_form.ir_void, true, ir_form.ir_i64, ir_form.ir_i64,
                    ir_form.ir_ptr, ir_form.ir_i32, ir_form.ir_i32);
    case rt_entry.rt_fail_span:
        return row6("std.rt.fail_span", ir_form.ir_void, true, ir_form.ir_i64, ir_form.ir_i64,
                    ir_form.ir_i64, ir_form.ir_ptr, ir_form.ir_i32, ir_form.ir_i32);
    case rt_entry.rt_fail_overflow:
        return row3("std.rt.fail_overflow", ir_form.ir_void, true, ir_form.ir_ptr,
                    ir_form.ir_i32, ir_form.ir_i32);
    case rt_entry.rt_fail_shift:
        return row5("std.rt.fail_shift", ir_form.ir_void, true, ir_form.ir_i64, ir_form.ir_ptr,
                    ir_form.ir_ptr, ir_form.ir_i32, ir_form.ir_i32);
    case rt_entry.rt_fail_div_zero:
        return row3("std.rt.fail_div_zero", ir_form.ir_void, true, ir_form.ir_ptr,
                    ir_form.ir_i32, ir_form.ir_i32);
    case rt_entry.rt_fail_div_overflow:
        return row3("std.rt.fail_div_overflow", ir_form.ir_void, true, ir_form.ir_ptr,
                    ir_form.ir_i32, ir_form.ir_i32);
    case rt_entry.rt_fail_alloc_count:
        return row4("std.rt.fail_alloc_count", ir_form.ir_void, true, ir_form.ir_i64,
                    ir_form.ir_ptr, ir_form.ir_i32, ir_form.ir_i32);
    case rt_entry.rt_fail_overwrite:
        return row3("std.rt.fail_overwrite", ir_form.ir_void, true, ir_form.ir_ptr,
                    ir_form.ir_i32, ir_form.ir_i32);
    case rt_entry.rt_fail_enum:
        return row5("std.rt.fail_enum", ir_form.ir_void, true, ir_form.ir_i64, ir_form.ir_ptr,
                    ir_form.ir_ptr, ir_form.ir_i32, ir_form.ir_i32);
    case rt_entry.rt_panic:
        return row5("std.rt.panic", ir_form.ir_void, true, ir_form.ir_ptr, ir_form.ir_i64,
                    ir_form.ir_ptr, ir_form.ir_i32, ir_form.ir_i32);
    case rt_entry.rt_assert_fail:
        return row4("std.rt.assert_fail", ir_form.ir_void, true, ir_form.ir_ptr, ir_form.ir_ptr,
                    ir_form.ir_i32, ir_form.ir_i32);
    case rt_entry.rt_print_i64:
        return row2("std.rt.print_i64", ir_form.ir_void, false, ir_form.ir_i32, ir_form.ir_i64);
    case rt_entry.rt_print_u64:
        return row2("std.rt.print_u64", ir_form.ir_void, false, ir_form.ir_i32, ir_form.ir_i64);
    case rt_entry.rt_print_f32:
        return row2("std.rt.print_f32", ir_form.ir_void, false, ir_form.ir_i32,
                    ir_form.ir_f32);
    case rt_entry.rt_print_f64:
        return row2("std.rt.print_f64", ir_form.ir_void, false, ir_form.ir_i32,
                    ir_form.ir_f64);
    case rt_entry.rt_print_bool:
        return row2("std.rt.print_bool", ir_form.ir_void, false, ir_form.ir_i32, ir_form.ir_bool);
    case rt_entry.rt_print_char:
        return row2("std.rt.print_char", ir_form.ir_void, false, ir_form.ir_i32, ir_form.ir_u8);
    case rt_entry.rt_print_ptr:
        return row2("std.rt.print_ptr", ir_form.ir_void, false, ir_form.ir_i32, ir_form.ir_ptr);
    case rt_entry.rt_print_str:
        return row3("std.rt.print_str", ir_form.ir_void, false, ir_form.ir_i32, ir_form.ir_ptr,
                    ir_form.ir_i64);
    case rt_entry.rt_print_enum:
        return row4("std.rt.print_enum", ir_form.ir_void, false, ir_form.ir_i32, ir_form.ir_i32,
                    ir_form.ir_ptr, ir_form.ir_i64);
    case rt_entry.rt_flush:
        return row1("std.rt.flush", ir_form.ir_void, false, ir_form.ir_i32);
    case rt_entry.rt_flush_all:
        return row("std.rt.flush_all", ir_form.ir_void, false);
    case rt_entry.rt_args_init:
        return row2("std.rt.args_init", ir_form.ir_void, false, ir_form.ir_i32, ir_form.ir_ptr);
    case rt_entry.rt_args:
        return row1("std.rt.args", ir_form.ir_void, false, ir_form.ir_ptr);
    case rt_entry.rt_shutdown:
        return row("std.rt.shutdown", ir_form.ir_void, false);
    case rt_entry.rt_exit:
        return row1("std.rt.exit", ir_form.ir_void, true, ir_form.ir_i32);
    case rt_entry.rt_none:
        panic("runtime_sig.rt_sig_of: not an entry point");
    }
}

// The `i`-th entry point in the order, which is what rt_entry_of
// walks. An index at or past RT_ENTRY_COUNT is a violated precondition and
// panics. The C indexes its table instead.
fn rt_at(u64 i) rt_entry {
    if (i >= RT_ENTRY_COUNT) {
        panic("runtime_sig.rt_at: index out of range");
    }
    return cast(cast(i, i32), rt_entry);
}

// The entry point a mangled symbol name denotes, or rt_none. The name is the
// mangled one, `std.rt.print_i64`, since that is what the emitter writes and what
// the definitions in `std/rt.ft` carry.
fn rt_entry_of(string name) rt_entry {
    u64 mut i = 0;
    while (i < RT_ENTRY_COUNT) {
        rt_entry rt = rt_at(i);
        if (rt_sig_of(rt).name == name) {
            return rt;
        }
        i += 1;
    }
    return rt_entry.rt_none;
}

// The mangled fort name of an entry point. It is written `@"..."`, quoted like
// every other dotted name.
fn rt_entry_name(rt_entry rt) string {
    return rt_sig_of(rt).name;
}

// Whether the entry point is `noreturn`. Its definition uses attribute group `#8`.
fn rt_entry_noreturn(rt_entry rt) bool {
    return rt_sig_of(rt).is_noreturn;
}

// Its result form.
fn rt_entry_result(rt_entry rt) ir_form {
    return rt_sig_of(rt).result;
}

// The form of the `i`-th parameter, ir_none at or past the arity. An index
// past the widest row is a violated precondition and panics.
fn rt_entry_param(rt_entry rt, u64 i) ir_form {
    rt_sig sig = rt_sig_of(rt);
    if (i == 0) {
        return sig.p0;
    } else if (i == 1) {
        return sig.p1;
    } else if (i == 2) {
        return sig.p2;
    } else if (i == 3) {
        return sig.p3;
    } else if (i == 4) {
        return sig.p4;
    } else if (i == 5) {
        return sig.p5;
    }
    panic("runtime_sig.rt_entry_param: index out of range");
}

// The number of parameters it takes: the row ends at its first ir_none.
fn rt_entry_param_count(rt_entry rt) u64 {
    u64 mut n = 0;
    while (n < RT_MAX_PARAMS && rt_entry_param(rt, n) != ir_form.ir_none) {
        n += 1;
    }
    return n;
}

// The text of a form in a parameter list (`i8 zeroext`), as LLVM IR spells it.
fn ir_param_text(ir_form t) string {
    switch (t) {
    case ir_form.ir_ptr:
        return "ptr";
    case ir_form.ir_bool:
        return "i1 zeroext";
    case ir_form.ir_i8:
        return "i8 signext";
    case ir_form.ir_u8:
        return "i8 zeroext";
    case ir_form.ir_i16:
        return "i16 signext";
    case ir_form.ir_u16:
        return "i16 zeroext";
    case ir_form.ir_i32:
        return "i32";
    case ir_form.ir_i64:
        return "i64";
    case ir_form.ir_f32:
        return "float";
    case ir_form.ir_f64:
        return "double";
    case ir_form.ir_void:
        return "void";
    case ir_form.ir_none:
        // A type with no IR form also has no text. Its invalid spelling makes an escaped form fail
        // instead of emitting a plausible declaration.
        return "<none>";
    }
}

// Returns a form's result text for `declare` or `call`. The attribute precedes the type, as in
// `zeroext i8`.
fn ir_result_text(ir_form t) string {
    // A narrow result carries its extension attribute before the type
    // (`call zeroext i1 @"std.rt.str_eq"(...)`, LLVM IR).
    if (t == ir_form.ir_bool) {
        return "zeroext i1";
    } else if (t == ir_form.ir_i8) {
        return "signext i8";
    } else if (t == ir_form.ir_u8) {
        return "zeroext i8";
    } else if (t == ir_form.ir_i16) {
        return "signext i16";
    } else if (t == ir_form.ir_u16) {
        return "zeroext i16";
    }
    return ir_param_text(t);
}

// The IR form of a primitive: the value type and the extension
// attribute, which `bool`, `char`, `u8`, `u16`, `i8` and `i16` carry.
fn ir_of_prim(prim.prim_kind k) ir_form {
    switch (k) {
    case prim.prim_kind.prim_bool:
        return ir_form.ir_bool;
    case prim.prim_kind.prim_char, prim.prim_kind.prim_u8:
        return ir_form.ir_u8;
    case prim.prim_kind.prim_i8:
        return ir_form.ir_i8;
    case prim.prim_kind.prim_u16:
        return ir_form.ir_u16;
    case prim.prim_kind.prim_i16:
        return ir_form.ir_i16;
    case prim.prim_kind.prim_i32, prim.prim_kind.prim_u32:
        return ir_form.ir_i32;
    case prim.prim_kind.prim_i64, prim.prim_kind.prim_u64:
        return ir_form.ir_i64;
    case prim.prim_kind.prim_f32:
        return ir_form.ir_f32;
    case prim.prim_kind.prim_f64:
        return ir_form.ir_f64;
    case prim.prim_kind.prim_void:
        return ir_form.ir_void;
    }
}

// The IR form a fort type takes as a scalar value, or ir_none for an
// aggregate: the value type with its extension attribute.
fn ir_form_of_type(types.node* t) ir_form {
    if (t == null) {
        return ir_form.ir_none;
    }
    switch (t->kind) {
    case types.type_kind.k_void:
        return ir_form.ir_void;
    case types.type_kind.k_prim:
        return ir_of_prim(t->prim);
    case types.type_kind.k_ptr, types.type_kind.k_voidptr, types.type_kind.k_fn:
        return ir_form.ir_ptr;
    case types.type_kind.k_enum:
        return ir_form.ir_i32;
    case types.type_kind.k_array, types.type_kind.k_span, types.type_kind.k_string,
         types.type_kind.k_struct, types.type_kind.k_null, types.type_kind.k_error:
        return ir_form.ir_none;
    }
}

// Whether a fort type is one of the aggregates, which travel as a
// plain `ptr`.
fn form_is_aggregate(types.node* t) bool {
    if (t == null) {
        return false;
    }
    return t->kind == types.type_kind.k_struct || t->kind == types.type_kind.k_array ||
           t->kind == types.type_kind.k_span || t->kind == types.type_kind.k_string;
}

// The form of one parameter of a fort signature: an aggregate argument is a
// plain `ptr` parameter, and every other type takes its value form.
fn param_form(types.node* t) ir_form {
    if (form_is_aggregate(t)) {
        return ir_form.ir_ptr;
    }
    return ir_form_of_type(t);
}

// Builds the IR call shape of a fort function type. An aggregate result adds a leading `ptr`
// parameter and uses a `void` result. The row copies `name` for later comparison with `rt_sig_of`.
// A signature with too many parameters violates the precondition and causes a panic.
fn rt_signature_of_type(string name, types.node* sig) rt_sig {
    if (sig == null || sig->kind != types.type_kind.k_fn) {
        panic("runtime_sig.rt_signature_of_type: not a function type");
    }
    ir_form mut result = ir_form.ir_void;
    u64 mut lead = 0;
    if (form_is_aggregate(sig->elem)) {
        lead = 1;
    } else {
        result = ir_form_of_type(sig->elem);
    }
    if (lead + sig->params.len > RT_MAX_PARAMS) {
        panic("runtime_sig.rt_signature_of_type: too many parameters");
    }
    rt_sig mut r = row(name, result, sig->is_noreturn);
    if (lead == 1) {
        // The hidden result pointer, a plain `ptr` at the call site.
        r.p0 = ir_form.ir_ptr;
    }
    u64 mut i = 0;
    while (i < sig->params.len) {
        ir_form form = param_form(sig->params[i]);
        u64 at = lead + i;
        if (at == 0) {
            r.p0 = form;
        } else if (at == 1) {
            r.p1 = form;
        } else if (at == 2) {
            r.p2 = form;
        } else if (at == 3) {
            r.p3 = form;
        } else if (at == 4) {
            r.p4 = form;
        } else {
            r.p5 = form;
        }
        i += 1;
    }
    return r;
}
