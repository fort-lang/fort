// runtime_sig: the runtime entry points of toolchain.md 5.1, the one table of
// their canonical signatures, which both the emitter and the checker read.
//
// This is src/bootstrap/runtime_sig.c transliterated. The IR types of one
// entry point are written once, and the declaration text of item 8, the
// result type of a call site, the `_Noreturn` attribute group and the
// signature the checker holds an `extern fn` against are all derived from
// that one row (D9.8).
//
// The alphabet is the IR parameter forms of toolchain.md 6 item 7, attribute
// included, and not the fort types: what the check of D9.8 asks is whether
// the call the emitter would write matches the declaration it emits, which is
// a question about IR types.
//
// Two things differ from the C and neither is behaviour. The C's table is a
// static array of rows whose `params` is an array of RT_MAX_PARAMS forms; a
// row here is the return value of one function, one `return` per entry point
// in the order of section 5.1, and its parameter forms are six fields rather
// than an array, so that reading the `i`-th one is a switch and no index.
// And the C's RT_COUNT, one past the last entry point, is `rt_none` here: a
// fort switch over an enum names every member (D7.6), so the sentinel is a
// member like any other and answers "this name is not an entry point".
//
// Re-entrancy (D20.5): nothing here is state at all. Every function is a pure
// map from an entry point to a fact about it, so a thousand analyses in one
// process share nothing. An index past the end of a row is a violated
// precondition and panics (D13.3).
//
// Dispatch: none. The rows are switches over the entry enum, not a table of
// function pointers (D3.10).
import prim;
import types;
import std.strbuf;

// The runtime entry points of toolchain.md 5.1, in the order that section
// lists them, which is the order their declarations are emitted in (D19.5).
// `rt_none` is the C's RT_COUNT: no entry point, which is what a name that is
// not one denotes.
enum rt_entry {
    rt_new,
    rt_del,
    rt_str_eq,
    rt_fail_bounds,
    rt_fail_span,
    rt_fail_overflow,
    rt_fail_shift,
    rt_fail_div_zero,
    rt_fail_div_overflow,
    rt_fail_alloc_count,
    rt_fail_overwrite,
    rt_fail_enum,
    rt_panic,
    rt_assert_fail,
    rt_print_i64,
    rt_print_u64,
    rt_print_f32,
    rt_print_f64,
    rt_print_bool,
    rt_print_char,
    rt_print_ptr,
    rt_print_str,
    rt_print_enum,
    rt_flush,
    rt_flush_all,
    rt_args_init,
    rt_args_ptr,
    rt_args_len,
    rt_exit,
    rt_none,
}

// An IR parameter or result form of item 7: the type text together with the
// extension attribute a narrow value carries on both sides of the boundary
// (D9.9). `bool` is a form of its own because it is `i1` as a value and `i8`
// in memory (D19.2), so a `bool` argument is not a `u8` argument.
enum ir_form {
    ir_void, // `void`, a result only
    ir_ptr,  // `ptr`: every pointer, `void*` and function pointer (D3.10, D3.11)
    ir_bool, // `i1 zeroext`
    ir_i8,   // `i8 signext`
    ir_u8,   // `i8 zeroext`: `u8` and `char`, C's `unsigned char` (D3.2)
    ir_i16,  // `i16 signext`
    ir_u16,  // `i16 zeroext`
    ir_i32,  // `i32`: `i32`, `u32` and every enum, which is passed as `i32` (D9.8)
    ir_i64,  // `i64`: `i64` and `u64`
    ir_f32,  // `float`
    ir_f64,  // `double`
    ir_none, // no IR form: a type an extern signature may not use (D9.8)
}

// The entry points of section 5.1, which is what rt_entry_of walks.
u64 RT_ENTRY_COUNT = 29;

// The widest parameter list of toolchain.md 5.1, which is
// `fort_rt_fail_span(i64, i64, i64, ptr, i32, i32)`.
u64 RT_MAX_PARAMS = 6;

// One entry point: its C name, its result form, whether section 5.1 declares
// it `_Noreturn`, and its parameter forms in order, padded with ir_none. The
// list ends at the first ir_none, so the arity is read off the row rather
// than counted by hand beside it.
struct rt_sig {
    string name;
    ir_form result;
    bool is_noreturn;
    ir_form p0;
    ir_form p1;
    ir_form p2;
    ir_form p3;
    ir_form p4;
    ir_form p5;
}

// A row with no parameter, which every row below starts from: the six slots
// an entry point does not use are ir_none, as the C pads its array.
fn rt_sig row(string name, ir_form result, bool is_noreturn) {
    return rt_sig{name, result, is_noreturn, ir_form.ir_none, ir_form.ir_none, ir_form.ir_none,
                  ir_form.ir_none, ir_form.ir_none, ir_form.ir_none};
}

fn rt_sig row1(string name, ir_form result, bool is_noreturn, ir_form p0) {
    rt_sig mut r = row(name, result, is_noreturn);
    r.p0 = p0;
    return r;
}

fn rt_sig row2(string name, ir_form result, bool is_noreturn, ir_form p0, ir_form p1) {
    rt_sig mut r = row1(name, result, is_noreturn, p0);
    r.p1 = p1;
    return r;
}

fn rt_sig row3(string name, ir_form result, bool is_noreturn, ir_form p0, ir_form p1, ir_form p2) {
    rt_sig mut r = row2(name, result, is_noreturn, p0, p1);
    r.p2 = p2;
    return r;
}

fn rt_sig row4(string name, ir_form result, bool is_noreturn, ir_form p0, ir_form p1, ir_form p2,
               ir_form p3) {
    rt_sig mut r = row3(name, result, is_noreturn, p0, p1, p2);
    r.p3 = p3;
    return r;
}

fn rt_sig row5(string name, ir_form result, bool is_noreturn, ir_form p0, ir_form p1, ir_form p2,
               ir_form p3, ir_form p4) {
    rt_sig mut r = row4(name, result, is_noreturn, p0, p1, p2, p3);
    r.p4 = p4;
    return r;
}

fn rt_sig row6(string name, ir_form result, bool is_noreturn, ir_form p0, ir_form p1, ir_form p2,
               ir_form p3, ir_form p4, ir_form p5) {
    rt_sig mut r = row5(name, result, is_noreturn, p0, p1, p2, p3, p4);
    r.p5 = p5;
    return r;
}

// The C prototypes of toolchain.md 5.1, in that section's order (D19.5),
// mapped to IR forms by item 8: `u64` and `i64` are `i64`, `i32` is `i32`,
// `u8` is `i8 zeroext`, every pointer is `ptr` and `loc` is the three
// parameters `ptr, i32, i32`. Every `fort_rt_fail_*` function,
// `fort_rt_panic`, `fort_rt_assert_fail` and `fort_rt_exit` is `_Noreturn`
// (section 5.1), which is stated per row rather than as a range over the
// enum, so an entry point added in the middle of the order cannot inherit the
// attribute by position.
fn rt_sig rt_sig_of(rt_entry rt) {
    switch (rt) {
    case rt_entry.rt_new:
        return row5("fort_rt_new", ir_form.ir_ptr, false, ir_form.ir_i64, ir_form.ir_i64,
                    ir_form.ir_ptr, ir_form.ir_i32, ir_form.ir_i32);
    case rt_entry.rt_del:
        return row1("fort_rt_del", ir_form.ir_void, false, ir_form.ir_ptr);
    case rt_entry.rt_str_eq:
        return row4("fort_rt_str_eq", ir_form.ir_u8, false, ir_form.ir_ptr, ir_form.ir_i64,
                    ir_form.ir_ptr, ir_form.ir_i64);
    case rt_entry.rt_fail_bounds:
        return row5("fort_rt_fail_bounds", ir_form.ir_void, true, ir_form.ir_i64, ir_form.ir_i64,
                    ir_form.ir_ptr, ir_form.ir_i32, ir_form.ir_i32);
    case rt_entry.rt_fail_span:
        return row6("fort_rt_fail_span", ir_form.ir_void, true, ir_form.ir_i64, ir_form.ir_i64,
                    ir_form.ir_i64, ir_form.ir_ptr, ir_form.ir_i32, ir_form.ir_i32);
    case rt_entry.rt_fail_overflow:
        return row3("fort_rt_fail_overflow", ir_form.ir_void, true, ir_form.ir_ptr,
                    ir_form.ir_i32, ir_form.ir_i32);
    case rt_entry.rt_fail_shift:
        return row5("fort_rt_fail_shift", ir_form.ir_void, true, ir_form.ir_i64, ir_form.ir_ptr,
                    ir_form.ir_ptr, ir_form.ir_i32, ir_form.ir_i32);
    case rt_entry.rt_fail_div_zero:
        return row3("fort_rt_fail_div_zero", ir_form.ir_void, true, ir_form.ir_ptr,
                    ir_form.ir_i32, ir_form.ir_i32);
    case rt_entry.rt_fail_div_overflow:
        return row3("fort_rt_fail_div_overflow", ir_form.ir_void, true, ir_form.ir_ptr,
                    ir_form.ir_i32, ir_form.ir_i32);
    case rt_entry.rt_fail_alloc_count:
        return row4("fort_rt_fail_alloc_count", ir_form.ir_void, true, ir_form.ir_i64,
                    ir_form.ir_ptr, ir_form.ir_i32, ir_form.ir_i32);
    case rt_entry.rt_fail_overwrite:
        return row3("fort_rt_fail_overwrite", ir_form.ir_void, true, ir_form.ir_ptr,
                    ir_form.ir_i32, ir_form.ir_i32);
    case rt_entry.rt_fail_enum:
        return row5("fort_rt_fail_enum", ir_form.ir_void, true, ir_form.ir_i64, ir_form.ir_ptr,
                    ir_form.ir_ptr, ir_form.ir_i32, ir_form.ir_i32);
    case rt_entry.rt_panic:
        return row5("fort_rt_panic", ir_form.ir_void, true, ir_form.ir_ptr, ir_form.ir_i64,
                    ir_form.ir_ptr, ir_form.ir_i32, ir_form.ir_i32);
    case rt_entry.rt_assert_fail:
        return row4("fort_rt_assert_fail", ir_form.ir_void, true, ir_form.ir_ptr, ir_form.ir_ptr,
                    ir_form.ir_i32, ir_form.ir_i32);
    case rt_entry.rt_print_i64:
        return row2("fort_rt_print_i64", ir_form.ir_void, false, ir_form.ir_i32, ir_form.ir_i64);
    case rt_entry.rt_print_u64:
        return row2("fort_rt_print_u64", ir_form.ir_void, false, ir_form.ir_i32, ir_form.ir_i64);
    case rt_entry.rt_print_f32:
        return row2("fort_rt_print_f32", ir_form.ir_void, false, ir_form.ir_i32, ir_form.ir_f32);
    case rt_entry.rt_print_f64:
        return row2("fort_rt_print_f64", ir_form.ir_void, false, ir_form.ir_i32, ir_form.ir_f64);
    case rt_entry.rt_print_bool:
        return row2("fort_rt_print_bool", ir_form.ir_void, false, ir_form.ir_i32, ir_form.ir_u8);
    case rt_entry.rt_print_char:
        return row2("fort_rt_print_char", ir_form.ir_void, false, ir_form.ir_i32, ir_form.ir_u8);
    case rt_entry.rt_print_ptr:
        return row2("fort_rt_print_ptr", ir_form.ir_void, false, ir_form.ir_i32, ir_form.ir_ptr);
    case rt_entry.rt_print_str:
        return row3("fort_rt_print_str", ir_form.ir_void, false, ir_form.ir_i32, ir_form.ir_ptr,
                    ir_form.ir_i64);
    case rt_entry.rt_print_enum:
        return row4("fort_rt_print_enum", ir_form.ir_void, false, ir_form.ir_i32, ir_form.ir_i32,
                    ir_form.ir_ptr, ir_form.ir_i64);
    case rt_entry.rt_flush:
        return row1("fort_rt_flush", ir_form.ir_void, false, ir_form.ir_i32);
    case rt_entry.rt_flush_all:
        return row("fort_rt_flush_all", ir_form.ir_void, false);
    case rt_entry.rt_args_init:
        return row2("fort_rt_args_init", ir_form.ir_void, false, ir_form.ir_i32, ir_form.ir_ptr);
    case rt_entry.rt_args_ptr:
        return row("fort_rt_args_ptr", ir_form.ir_ptr, false);
    case rt_entry.rt_args_len:
        return row("fort_rt_args_len", ir_form.ir_i64, false);
    case rt_entry.rt_exit:
        return row1("fort_rt_exit", ir_form.ir_void, true, ir_form.ir_i32);
    case rt_entry.rt_none:
        panic("runtime_sig.rt_sig_of: not an entry point");
    }
}

// The `i`-th entry point in the order of section 5.1, which is what
// rt_entry_of walks; an index at or past RT_ENTRY_COUNT is a violated
// precondition and panics (D13.3). The C indexes its table instead.
fn rt_entry rt_at(u64 i) {
    if (i >= RT_ENTRY_COUNT) {
        panic("runtime_sig.rt_at: index out of range");
    }
    return cast(cast(i, i32), rt_entry);
}

// The entry point a C name denotes, or rt_none.
fn rt_entry rt_entry_of(string name) {
    u64 mut i = 0;
    while (i < RT_ENTRY_COUNT) {
        rt_entry rt = rt_at(i);
        if (rt_sig_of(rt).name == name) {
            return rt;
        }
        i += 1;
    }
    return rt_entry.rt_none;
}

// The C name of an entry point, unmangled as every extern name is (D9.7).
fn string rt_entry_name(rt_entry rt) {
    return rt_sig_of(rt).name;
}

// Whether toolchain.md 5.1 declares the entry point `_Noreturn`, which is
// what puts `cold noreturn nounwind` on its declaration (section 5, item 14).
fn bool rt_entry_noreturn(rt_entry rt) {
    return rt_sig_of(rt).is_noreturn;
}

// Its result form.
fn ir_form rt_entry_result(rt_entry rt) {
    return rt_sig_of(rt).result;
}

// The form of the `i`-th parameter, ir_none at or past the arity; an index
// past the widest row is a violated precondition and panics (D13.3).
fn ir_form rt_entry_param(rt_entry rt, u64 i) {
    rt_sig sig = rt_sig_of(rt);
    if (i == 0) {
        return sig.p0;
    } else if (i == 1) {
        return sig.p1;
    } else if (i == 2) {
        return sig.p2;
    } else if (i == 3) {
        return sig.p3;
    } else if (i == 4) {
        return sig.p4;
    } else if (i == 5) {
        return sig.p5;
    }
    panic("runtime_sig.rt_entry_param: index out of range");
}

// The number of parameters it takes: the row ends at its first ir_none.
fn u64 rt_entry_param_count(rt_entry rt) {
    u64 mut n = 0;
    while (n < RT_MAX_PARAMS && rt_entry_param(rt, n) != ir_form.ir_none) {
        n += 1;
    }
    return n;
}

// The text of a form in a parameter list (`i8 zeroext`), as item 7 spells it.
fn string ir_param_text(ir_form t) {
    switch (t) {
    case ir_form.ir_ptr:
        return "ptr";
    case ir_form.ir_bool:
        return "i1 zeroext";
    case ir_form.ir_i8:
        return "i8 signext";
    case ir_form.ir_u8:
        return "i8 zeroext";
    case ir_form.ir_i16:
        return "i16 signext";
    case ir_form.ir_u16:
        return "i16 zeroext";
    case ir_form.ir_i32:
        return "i32";
    case ir_form.ir_i64:
        return "i64";
    case ir_form.ir_f32:
        return "float";
    case ir_form.ir_f64:
        return "double";
    case ir_form.ir_void:
        return "void";
    case ir_form.ir_none:
        // A type with no IR form has no text either: the spelling is
        // deliberately not IR so that a form that escaped a check fails a tool
        // rather than emitting a plausible declaration.
        return "<none>";
    }
}

// The text of a form in the result position of a `declare` or a `call`, where
// the attribute precedes the type (`zeroext i8`), as item 7 spells it.
fn string ir_result_text(ir_form t) {
    // A narrow result carries its extension attribute before the type
    // (`declare zeroext i8 @fort_rt_str_eq(...)`, item 7).
    if (t == ir_form.ir_bool) {
        return "zeroext i1";
    } else if (t == ir_form.ir_i8) {
        return "signext i8";
    } else if (t == ir_form.ir_u8) {
        return "zeroext i8";
    } else if (t == ir_form.ir_i16) {
        return "signext i16";
    } else if (t == ir_form.ir_u16) {
        return "zeroext i16";
    }
    return ir_param_text(t);
}

// The IR form of a primitive: the value type of item 7 and the extension
// attribute of D9.9, which `bool`, `char`, `u8`, `u16`, `i8` and `i16` carry.
fn ir_form ir_of_prim(prim.prim_kind k) {
    switch (k) {
    case prim.prim_kind.prim_bool:
        return ir_form.ir_bool;
    case prim.prim_kind.prim_char, prim.prim_kind.prim_u8:
        return ir_form.ir_u8;
    case prim.prim_kind.prim_i8:
        return ir_form.ir_i8;
    case prim.prim_kind.prim_u16:
        return ir_form.ir_u16;
    case prim.prim_kind.prim_i16:
        return ir_form.ir_i16;
    case prim.prim_kind.prim_i32, prim.prim_kind.prim_u32:
        return ir_form.ir_i32;
    case prim.prim_kind.prim_i64, prim.prim_kind.prim_u64:
        return ir_form.ir_i64;
    case prim.prim_kind.prim_f32:
        return ir_form.ir_f32;
    case prim.prim_kind.prim_f64:
        return ir_form.ir_f64;
    case prim.prim_kind.prim_void:
        return ir_form.ir_void;
    }
}

// The IR form a fort type takes at the C boundary, or ir_none: the value type
// of item 7 with its extension attribute, which is what an extern call site
// passes and what an extern declaration states (D9.8, D9.9).
fn ir_form ir_form_of_type(types.node* t) {
    if (t == null) {
        return ir_form.ir_none;
    }
    switch (t->kind) {
    case types.type_kind.k_void:
        return ir_form.ir_void;
    case types.type_kind.k_prim:
        return ir_of_prim(t->prim);
    case types.type_kind.k_ptr, types.type_kind.k_voidptr, types.type_kind.k_fn:
        // Every pointer, `void*` and function pointer is the opaque `ptr`
        // (D3.10, D3.11).
        return ir_form.ir_ptr;
    case types.type_kind.k_enum:
        // An enum crosses the C boundary as `i32` (D9.8, D3.9).
        return ir_form.ir_i32;
    case types.type_kind.k_array, types.type_kind.k_span, types.type_kind.k_string,
         types.type_kind.k_struct, types.type_kind.k_null, types.type_kind.k_error:
        return ir_form.ir_none;
    }
}

// `declare <result> @fort_rt_x(<params>) [#2]`: a runtime entry point is
// declared with the C prototype of section 5.1, mapped to IR types by item 8,
// and never variadic, whether the compiler emits the call itself or the
// standard library reached the entry point with an `extern fn` (D13.1). A
// `_Noreturn` one carries the `cold noreturn nounwind` group of item 14.
fn void rt_declaration(strbuf.str_buf mut* out, rt_entry rt) {
    strbuf.append(out, "declare ");
    strbuf.append(out, ir_result_text(rt_entry_result(rt)));
    strbuf.append(out, " @");
    strbuf.append(out, rt_entry_name(rt));
    strbuf.push(out, '(');
    u64 mut i = 0;
    while (i < rt_entry_param_count(rt)) {
        if (i > 0) {
            strbuf.append(out, ", ");
        }
        strbuf.append(out, ir_param_text(rt_entry_param(rt, i)));
        i += 1;
    }
    strbuf.push(out, ')');
    if (rt_entry_noreturn(rt)) {
        strbuf.append(out, " #2");
    }
    strbuf.push(out, '\n');
}
