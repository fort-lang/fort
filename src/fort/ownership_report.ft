/// Writes version 1 ownership coverage from retained source analyses.
import containers;
import diag;
import fir;
import json;
import modules;
import ownership_api;
import ownership_events;
import ownership_keys;
import ownership_limits;
import ownership_source;
import ownership_source_calls;
import ownership_source_exit;
import ownership_source_leaves;
import ownership_source_local;
import ownership_source_raw;
import session;
import std.io;
import std.libc;
import std.os;
import std.str;
import std.strbuf;
import std.strmap;
import std.sys;

// These POSIX functions have the same ABI on both supported targets.
extern fn mkstemp(char mut* path) i32;
extern fn rename(char* from, char* to) i32;

u64 ANALYSIS_COUNT = 7;
u64 LOCAL = 2;
u64 STORED_BORROWS = 3;
u64 RAW = 4;
u64 CALLS_HEAP = 5;
u64 PROCESS_EXIT = 6;
string[ANALYSIS_COUNT] ANALYSES = {
    "graph", "liveness", "local", "stored_borrows", "raw", "calls_heap", "process_exit"};
string[3] STAGES = {"checking", "lowering", "verification"};
string[3] STAGE_STATUSES = {"complete", "failed", "unexecuted"};
string[4] WORK_STATUSES = {"complete", "incomplete", "failed", "unexecuted"};
string[5] PROOF_STATUSES = {"complete", "violated", "incomplete", "failed", "unexecuted"};
string[ownership_api.LIMIT_COUNT] CATEGORIES = {"D", "R", "P", "G", "H", "T", "E", "W", "V"};
// The names follow the order of ownership_api.limit_scope.
string[6] SCOPES = {"path", "state", "function", "call", "computation", "report"};

struct invocation {
    string entry;
    string cwd;
    string@ arguments;
    string target;
    string compiler_version;
    string@ config_keys;
    string@ config_values;
    bool check;
    bool release;
    bool no_bounds_check;
}

struct reason {
    bool present;
    string stage;
    string code;
    ownership_api.source_position source;
    ownership_api.exhaustion limit;
}

fn work_status(ownership_source.status value) string {
    switch (value) {
    case ownership_source.status.unexecuted: return "unexecuted";
    case ownership_source.status.complete: return "complete";
    case ownership_source.status.incomplete: return "incomplete";
    case ownership_source.status.failed: return "failed";
    }
}

fn local_status(ownership_source_local.status value) string {
    switch (value) {
    case ownership_source_local.status.unexecuted: return "unexecuted";
    case ownership_source_local.status.complete: return "complete";
    case ownership_source_local.status.incomplete: return "incomplete";
    case ownership_source_local.status.failed: return "failed";
    }
}

// Each of the seven analyses has a source producer: graph, liveness, local, stored borrows, raw,
// calls_heap and process exit.
fn integrated(u64 stage) bool { return stage <= PROCESS_EXIT; }

// The local and the stored-borrow analyses are flow runs of one producer.
fn flow_stage(u64 stage) bool { return stage == LOCAL || stage == STORED_BORROWS; }

fn flow_run(ownership_source.body* row, u64 stage) ownership_source_local.context* {
    if (stage == STORED_BORROWS) { return &row->stored; }
    return &row->local;
}

// Whether a source producer runs the analysis of a stage per body: local, stored borrows, raw,
// calls_heap or process exit.
fn producer_stage(u64 stage) bool {
    return flow_stage(stage) || stage == RAW || stage == CALLS_HEAP || stage == PROCESS_EXIT;
}

// The calls_heap proof of a body for its reason: the missing fact when the body has
// incomplete correspondence, its proof otherwise. A closure without a graph has no row.
fn calls_proof(ownership_source.body* row) ownership_api.proof_status {
    if (row->calls == null) {
        return ownership_api.incomplete(ownership_api.incomplete_reason.missing_graph,
            ownership_api.operation_position{.function = row->key}, row->source);
    }
    if (row->calls->correspondence != ownership_source_local.status.complete) {
        return row->calls->gap;
    }
    return row->calls->proof;
}

// Whether the producer of a stage ran for one body.
fn producer_solved(ownership_source.body* row, u64 stage) bool {
    if (stage == CALLS_HEAP) { return row->calls != null; }
    if (stage == PROCESS_EXIT) { return row->exit.solved; }
    if (flow_stage(stage)) { return flow_run(row, stage)->solved; }
    return row->raw.solved;
}

// The proof of a producer stage of one body for its first reason. A producer that did not run
// gives no proof, except calls_heap, whose missing graph is its reason.
fn producer_proof(ownership_source.body* row, u64 stage) ownership_api.proof_status {
    if (stage == CALLS_HEAP) { return calls_proof(row); }
    if (!producer_solved(row, stage)) { return ownership_api.proof_status{}; }
    if (stage == PROCESS_EXIT) { return row->exit.proof; }
    if (flow_stage(stage)) { return flow_run(row, stage)->proof; }
    return row->raw.proof;
}

// The analysis of a stage that a source producer runs per body: local, stored borrows, raw,
// calls_heap or process exit. A closure without a graph does not run calls_heap.
fn producer_row(ownership_source.body* row, u64 stage, bool mut* solved,
    ownership_source_local.status mut* correspondence, ownership_source_local.status mut* solver,
    ownership_api.proof_status mut* proof, u64 mut* violations) void {
    if (stage == CALLS_HEAP) {
        *solved = row->calls != null;
        if (row->calls == null) { return; }
        *correspondence = row->calls->correspondence;
        *solver = row->calls->solver;
        *proof = row->calls->proof;
        *violations = row->calls->violations;
        return;
    }
    if (flow_stage(stage)) {
        ownership_source_local.context* run = flow_run(row, stage);
        *solved = run->solved;
        *correspondence = run->correspondence;
        *solver = run->solver;
        *proof = run->proof;
        *violations = run->violations_len;
        return;
    }
    if (stage == PROCESS_EXIT) {
        *solved = row->exit.solved;
        *correspondence = row->exit.correspondence;
        *solver = row->exit.solver;
        *proof = row->exit.proof;
        *violations = row->exit.violations_len;
        return;
    }
    *solved = row->raw.solved;
    *correspondence = row->raw.correspondence;
    *solver = row->raw.solver;
    *proof = row->raw.proof;
    *violations = row->raw.violations_len;
}

fn proof_status(ownership_api.proof_status value) string {
    if (ownership_api.successful(value)) { return "complete"; }
    if (value.terminal.present &&
        value.terminal.reason == ownership_api.incomplete_reason.invalid_input) { return "failed"; }
    if (value.terminal.present || value.kind == ownership_api.proof_kind.incomplete) {
        return "incomplete";
    }
    if (value.failed) { return "failed"; }
    return "unexecuted";
}

fn incomplete_code(ownership_api.incomplete_reason value) string {
    switch (value) {
    case ownership_api.incomplete_reason.none: return "source_coverage";
    case ownership_api.incomplete_reason.missing_transfer: return "missing_transfer";
    case ownership_api.incomplete_reason.missing_graph: return "missing_graph";
    case ownership_api.incomplete_reason.missing_ffi: return "missing_ffi";
    case ownership_api.incomplete_reason.missing_globals: return "missing_globals";
    case ownership_api.incomplete_reason.missing_renderer: return "missing_renderer";
    case ownership_api.incomplete_reason.missing_budget: return "missing_budget";
    case ownership_api.incomplete_reason.missing_events: return "missing_events";
    case ownership_api.incomplete_reason.work_limit: return "work_limit";
    case ownership_api.incomplete_reason.report_limit: return "report_limit";
    case ownership_api.incomplete_reason.missing_capture: return "missing_capture";
    case ownership_api.incomplete_reason.missing_path: return "missing_path";
    case ownership_api.incomplete_reason.missing_boundary: return "missing_boundary";
    case ownership_api.incomplete_reason.missing_correspondence: return "missing_correspondence";
    case ownership_api.incomplete_reason.source_coverage: return "source_coverage";
    case ownership_api.incomplete_reason.unknown_effect: return "unknown_effect";
    case ownership_api.incomplete_reason.invalid_input: return "invalid_input";
    }
}

fn proof_reason(string stage, ownership_api.proof_status proof) reason {
    if (!proof.terminal.present) { return reason{}; }
    return reason{true, stage, incomplete_code(proof.terminal.reason),
        proof.terminal.source, proof.terminal.limit};
}

fn fallback_reason(string stage, string code, ownership_api.source_position source) reason {
    return reason{.present = true, .stage = stage, .code = code, .source = source};
}

fn prerequisites(ownership_source.body* row) bool {
    return row->verification == ownership_source.status.complete;
}

fn stage_status(ownership_source.body* row, u64 stage) string {
    if (stage == 0) { return work_status(row->checking); }
    if (stage == 1) { return work_status(row->lowering); }
    return work_status(row->verification);
}

// A producer does not change solver outcomes when later report rendering refuses V.
fn analysis_status(ownership_source.body* row, u64 stage, u64 field) string {
    if (!prerequisites(row)) { return "unexecuted"; }
    if (producer_stage(stage)) {
        bool mut solved = false;
        ownership_source_local.status mut correspondence = ownership_source_local.status.unexecuted;
        ownership_source_local.status mut solver = ownership_source_local.status.unexecuted;
        ownership_api.proof_status mut proof = ownership_api.proof_status{};
        u64 mut violations = 0;
        producer_row(row, stage, &solved, &correspondence, &solver, &proof, &violations);
        if (!solved) { return field == 2 ? "incomplete" : "unexecuted"; }
        if (field == 0) { return local_status(correspondence); }
        if (field == 1) { return local_status(solver); }
        if (violations > 0) { return "violated"; }
        return proof_status(proof);
    }
    if (!integrated(stage)) { return field == 2 ? "incomplete" : "unexecuted"; }
    if (stage == 0) {
        if (field == 0) { return work_status(row->graph_correspondence); }
        if (field == 1) { return work_status(row->graph_solver); }
        return proof_status(row->graph_proof);
    }
    if (field == 0) { return work_status(row->liveness_correspondence); }
    if (field == 1) { return work_status(row->liveness_solver); }
    return proof_status(row->liveness_proof);
}

fn body_ownership(ownership_source.body* row) string {
    if (!prerequisites(row)) { return "failed"; }
    u64 mut status = 0;
    while (status < PROOF_STATUSES.len) {
        // Precedence is failed, violated, incomplete, unexecuted, complete.
        string wanted = status == 0 ? "failed" : status == 1 ? "violated" :
            status == 2 ? "incomplete" : status == 3 ? "unexecuted" : "complete";
        u64 mut stage = 0;
        while (stage < ANALYSIS_COUNT) {
            if (analysis_status(row, stage, 2) == wanted) { return wanted; }
            stage += 1;
        }
        status += 1;
    }
    return "unexecuted";
}

// The first reason in analysis order.
fn body_reason(ownership_source.body* row) reason {
    if (!prerequisites(row)) { return reason{}; }
    reason first = proof_reason(row->first_incomplete_stage ==
        ownership_source.analysis_stage.graph ? "graph" : "liveness", row->first_incomplete);
    if (first.present) { return first; }
    u64 mut stage = LOCAL;
    u64 mut open = ANALYSIS_COUNT;
    while (stage < ANALYSIS_COUNT && integrated(stage)) {
        if (analysis_status(row, stage, 2) == "incomplete") {
            reason got = proof_reason(ANALYSES[stage], producer_proof(row, stage));
            if (got.present) { return got; }
            if (open == ANALYSIS_COUNT) { open = stage; }
        }
        stage += 1;
    }
    // Each analysis has a producer: an incomplete row without a reason of its own names its
    // coverage, and a body with no incomplete row has no reason.
    if (open < ANALYSIS_COUNT) {
        return fallback_reason(ANALYSES[open], "source_coverage", row->source);
    }
    return reason{};
}

// The local, stored-borrow and raw analyses have no closure facts outside their bodies.
fn producer_closure(ownership_source.context* c, u64 stage) string {
    bool mut complete = c->enumeration_complete;
    bool mut executed = false;
    u64 mut i = 0;
    while (i < c->bodies.len) {
        string proof = analysis_status(&c->bodies[i], stage, 2);
        if (proof == "failed") { return "failed"; }
        if (analysis_status(&c->bodies[i], stage, 1) != "unexecuted") { executed = true; }
        if (proof != "complete") { complete = false; }
        i += 1;
    }
    if (complete) { return "complete"; }
    return executed ? "incomplete" : "unexecuted";
}

fn analysis_violations(ownership_source.body* row, u64 stage) u64 {
    if (!producer_stage(stage) || !prerequisites(row)) { return 0; }
    bool mut solved = false;
    ownership_source_local.status mut correspondence = ownership_source_local.status.unexecuted;
    ownership_source_local.status mut solver = ownership_source_local.status.unexecuted;
    ownership_api.proof_status mut proof = ownership_api.proof_status{};
    u64 mut violations = 0;
    producer_row(row, stage, &solved, &correspondence, &solver, &proof, &violations);
    return solved ? violations : 0;
}

// The local, stored-borrow, raw, calls_heap and process-exit analyses report violations. The
// stored run and the calls_heap row drop each violation that an earlier row validated, so the
// sum counts each diagnostic once. The process-exit analysis checks global owners and exits,
// which no other analysis checks.
fn body_violations(ownership_source.body* row) u64 {
    return analysis_violations(row, LOCAL) + analysis_violations(row, STORED_BORROWS) +
        analysis_violations(row, RAW) + analysis_violations(row, CALLS_HEAP) +
        analysis_violations(row, PROCESS_EXIT);
}

fn status_word(ownership_source_local.status value) string { return local_status(value); }

// The process-exit closure holds its bodies and the boundary, a fact outside each body.
fn exit_closure(ownership_source.context* c) string {
    string bodies = producer_closure(c, PROCESS_EXIT);
    if (bodies == "failed") { return "failed"; }
    string boundary = status_word(c->exit.boundary_proof);
    if (bodies == "complete" && boundary == "complete") { return "complete"; }
    if (bodies == "unexecuted" && boundary == "unexecuted") { return "unexecuted"; }
    return "incomplete";
}

fn closure_status(ownership_source.context* c, u64 stage) string {
    if (stage == PROCESS_EXIT) { return exit_closure(c); }
    if (producer_stage(stage)) { return producer_closure(c, stage); }
    if (!integrated(stage)) { return "incomplete"; }
    bool mut executed = stage == 0 && c->graph_built;
    u64 mut i = 0;
    while (i < c->bodies.len) {
        string solver = analysis_status(&c->bodies[i], stage, 1);
        if (solver == "failed") { return "failed"; }
        if (solver != "unexecuted") { executed = true; }
        i += 1;
    }
    // The source producers retain an explicit accounting gap.
    return executed ? "incomplete" : "unexecuted";
}

fn first_incomplete(ownership_source.context* c) reason {
    reason graph = proof_reason("graph", c->graph_first_refusal);
    if (graph.present) { return graph; }
    u64 mut stage = 0;
    while (stage < ANALYSIS_COUNT && integrated(stage)) {
        u64 mut i = 0;
        while (i < c->bodies.len) {
            ownership_source.body* row = &c->bodies[i];
            ownership_api.proof_status mut value = stage == 0 ? row->graph_proof :
                row->liveness_proof;
            if (producer_stage(stage)) {
                value = producer_solved(row, stage) &&
                    analysis_status(row, stage, 2) == "incomplete" ? producer_proof(row, stage) :
                    ownership_api.proof_status{};
            }
            reason got = proof_reason(ANALYSES[stage], value);
            if (got.present) { return got; }
            i += 1;
        }
        if (stage == PROCESS_EXIT) {
            reason got = proof_reason(ANALYSES[stage], c->exit.boundary_first);
            if (got.present) { return got; }
        }
        if (closure_status(c, stage) == "incomplete") {
            return fallback_reason(ANALYSES[stage], "source_coverage",
                ownership_api.source_position{});
        }
        stage += 1;
    }
    return reason{};
}

fn failure(ownership_source.context* c, i32 exit_status) reason {
    // An internal failure determines exit 2 even when another body fails lowering.
    u64 mut i = 0;
    while (i < c->bodies.len) {
        if (c->bodies[i].verification == ownership_source.status.failed) {
            return fallback_reason("verification", "verification_failure", c->bodies[i].source);
        }
        if (prerequisites(&c->bodies[i])) {
            u64 mut stage = 0;
            while (stage < ANALYSIS_COUNT) {
                if (integrated(stage) && analysis_status(&c->bodies[i], stage, 2) == "failed") {
                    return fallback_reason(ANALYSES[stage], "analysis_failure",
                        c->bodies[i].source);
                }
                stage += 1;
            }
        }
        i += 1;
    }
    if (!c->enumeration_complete) {
        return fallback_reason("checking", "source_error", ownership_api.source_position{});
    }
    i = 0;
    while (i < c->bodies.len) {
        if (c->bodies[i].lowering == ownership_source.status.failed) {
            ownership_source.body* row = &c->bodies[i];
            diag.loc at = row->lowering_failure.at;
            ownership_api.source_position source = at.file.len > 0 ?
                ownership_source.source(c, row->source.module, at) : row->source;
            return fallback_reason("lowering", "unsupported_lowering", source);
        }
        i += 1;
    }
    if (exit_status == 2) {
        return fallback_reason("tool", "tool_failure", ownership_api.source_position{});
    }
    return reason{};
}

fn verdict(ownership_source.context* c) i32 {
    reason failed = failure(c, 1);
    if (failed.code == "verification_failure" || failed.code == "analysis_failure") { return 2; }
    if (!c->enumeration_complete || failed.present) { return 1; }
    u64 mut stage = 0;
    while (stage < ANALYSIS_COUNT) {
        if (closure_status(c, stage) != "complete") { return 1; }
        stage += 1;
    }
    u64 mut i = 0;
    while (i < c->bodies.len) {
        if (body_ownership(&c->bodies[i]) != "complete") { return 1; }
        i += 1;
    }
    return 0;
}

fn location(ownership_source.context* c, ownership_api.source_position source,
    string entry) diag.loc {
    if (!source.filename_present) { return diag.loc_make(entry, 1, 1); }
    return position_in(modules.file_at(c->modules, cast(source.file, u64)), source, entry);
}

// The range of `source` in `file`. A source with no position stands at 1:1 of `entry` (D14.2).
fn position_in(string file, ownership_api.source_position source, string entry) diag.loc {
    if (!source.filename_present || source.line == 0 || source.col == 0) {
        return diag.loc_make(entry, 1, 1);
    }
    return diag.loc_range(file, source.line, source.col, source.end_line, source.end_col);
}

fn diagnostic(ownership_source.context mut* c, diag.sink mut* diagnostics, string entry,
    reason why, ownership_source.body mut* charged) bool {
    reason mut rendered = why;
    bool mut normal = true;
    if (charged != null) {
        if (charged->live.events.terminal.present &&
            charged->live.events.terminal.limit.present &&
            charged->live.events.terminal.limit.category == ownership_api.limit_category.v) {
            rendered = proof_reason("liveness",
                ownership_events.terminal_status(&charged->live.events));
            normal = false;
        } else {
            ownership_api.operation_position op = ownership_api.operation_position{
                .function = charged->key};
            ownership_api.charge_result permission = ownership_events.charge_rendered(
                &charged->live.events, op,
                why.source.filename_present ? why.source : charged->source);
            if (!permission.allowed) {
                if (!charged->live.first_refusal.terminal.present) {
                    charged->live.first_refusal = permission.proof;
                }
                rendered = proof_reason("liveness", charged->live.events.terminal.present ?
                    ownership_events.terminal_status(&charged->live.events) : permission.proof);
                normal = false;
            }
        }
    }
    strbuf.str_buf mut message = strbuf.create();
    defer strbuf.free(&message);
    incomplete_message(rendered, &message);
    diag.error(diagnostics, location(c, rendered.source, entry), strbuf.view(&message));
    return normal;
}

// The text of an incomplete-proof error (toolchain.md 4.2).
fn incomplete_message(reason rendered, strbuf.str_buf mut* message) void {
    strbuf.append(message, "ownership proof is incomplete (");
    strbuf.append(message, rendered.stage);
    strbuf.append(message, ": ");
    strbuf.append(message, rendered.code);
    if (rendered.limit.present) {
        strbuf.append(message, "; category ");
        strbuf.append(message, CATEGORIES[cast(rendered.limit.category, u64)]);
        strbuf.append(message, "; used ");
        strbuf.append_u64(message, rendered.limit.used);
        strbuf.append(message, "; bound ");
        strbuf.append_u64(message, rendered.limit.bound);
    }
    strbuf.push(message, ')');
}

// The text of a refused V charge for rendered violations.
fn report_limit_message(u64 bound, strbuf.str_buf mut* message) void {
    strbuf.append(message, "cannot prove complete ownership reporting within the report bound ");
    strbuf.append_u64(message, bound);
}

// What a failure without a witness cannot prove: raw access, or an empty owner (process exit).
string UNPROVED_ACCESS = " designates the accessed storage";
string UNPROVED_EMPTY = " is empty";

// The text of the error of a validated violation, or of a failure without a witness. Its
// note is the violation text. A leaf of a named aggregate reads `b.p` or `a[1]`: flow run
// `run` names it. A raw or a process-exit record names a whole local or a global, so its `run`
// is null (`record_run`). `unproved` ends the text of a failure without a witness.
fn violation_message(ownership_source_local.context* run, ownership_source_local.violation* v,
    string unproved, strbuf.str_buf mut* message) void {
    if (v->kind == ownership_api.event_kind.incomplete_proof) {
        strbuf.append(message, "cannot prove that ");
    } else {
        strbuf.append(message, v->kind == ownership_api.event_kind.invalid_use ?
            "invalid use of " : "lost ownership of ");
    }
    if (v->quoted) { strbuf.push(message, '\''); }
    if (v->quoted && v->leaf != ownership_source_local.WHOLE) {
        ownership_source_leaves.append_name(&run->leaves, run->function, v->leaf, message);
    } else {
        strbuf.append(message, v->name);
    }
    if (v->quoted) { strbuf.push(message, '\''); }
    if (v->kind == ownership_api.event_kind.incomplete_proof) {
        strbuf.append(message, unproved);
    }
}

// The flow run whose leaves name the records of list `from`: 0 local, 1 stored borrows. A raw
// record (lists 2 and 3) names a whole local and no leaf, and a process-exit record (lists 5
// and 6) a whole local or a global, so neither has a run. List 4 renders in `calls_record`.
fn record_run(ownership_source.body* row, u64 from, ownership_source_local.violation* v)
    ownership_source_local.context* {
    if (from == 0) { return &row->local; }
    if (from == 1) { return &row->stored; }
    if (v->leaf != ownership_source_local.WHOLE) {
        panic("ownership_report.record_run: a raw record names a leaf");
    }
    return null;
}

// Charges one rendered record to the ledger of its list: 0 local, 1 stored borrows, 2 and 3
// raw, 5 and 6 process exit. List 4 charges in `calls_record`.
fn charge_record(ownership_source.body mut* row, u64 from, ownership_source_local.violation* v)
    bool {
    if (from == 0) { return ownership_source_local.charge_rendered(&row->local, v); }
    if (from == 1) { return ownership_source_local.charge_rendered(&row->stored, v); }
    if (from >= 5) { return ownership_source_exit.charge_rendered(&row->exit, v); }
    return ownership_source_raw.charge_rendered(&row->raw, v);
}

// The V bound of the ledger that list `from` charges.
fn record_bound(ownership_source.body* row, u64 from) u64 {
    if (from == 0) { return row->local.meter.bounds.v; }
    if (from == 1) { return row->stored.meter.bounds.v; }
    if (from >= 5) { return row->exit.meter.bounds.v; }
    return row->raw.meter.bounds.v;
}

// The next record of a body in toolchain 4.2 order: local violations, stored-borrow
// violations, raw violations, raw failures without a witness, calls_heap records,
// process-exit violations and process-exit failures without a witness, each list already in
// that order. `from` names its list. On equal keys the earlier list comes first.
fn next_record(ownership_source.body* row, u64 mut@ cursor, u64 mut* from)
    ownership_source_local.violation* {
    ownership_source_local.violation* mut best = null;
    u64 mut list = 0;
    while (list < 7) {
        u64 at = cursor[list];
        ownership_source_local.violation* mut item = null;
        if (list == 0 && row->local.solved && at < row->local.violations_len) {
            item = &row->local.violations[at];
        } else if (list == 1 && row->stored.solved && at < row->stored.violations_len) {
            item = &row->stored.violations[at];
        } else if (list == 2 && row->raw.solved && at < row->raw.violations_len) {
            item = &row->raw.violations[at];
        } else if (list == 3 && row->raw.solved && at < row->raw.unproved_len) {
            item = &row->raw.unproved[at];
        } else if (list == 4 && row->calls != null && at < row->calls->shown_len) {
            item = &row->calls->shown_records[at].order;
        } else if (list == 5 && row->exit.solved && at < row->exit.violations_len) {
            item = &row->exit.violations[at];
        } else if (list == 6 && row->exit.solved && at < row->exit.unproved_len) {
            item = &row->exit.unproved[at];
        }
        if (item != null && (best == null || ownership_source_local.before(item, best))) {
            best = item;
            *from = list;
        }
        list += 1;
    }
    return best;
}

// Renders validated violations and raw failures in canonical body order and, inside a body,
// in toolchain 4.2 order across the local, stored-borrow and raw analyses.
// A V refusal keeps one terminal error and stops the later records.
fn violations(ownership_source.context mut* c, diag.sink mut* diagnostics, string entry) bool {
    u64 mut i = 0;
    while (i < c->bodies.len) {
        ownership_source.body mut* row = &c->bodies[i];
        u64[7] mut cursor = {0, 0, 0, 0, 0, 0, 0};
        while (true) {
            u64 mut from = 0;
            ownership_source_local.violation* v = next_record(row, cursor[..], &from);
            if (v == null) { break; }
            cursor[from] += 1;
            if (from == 4) {
                if (!calls_record(c, diagnostics, entry, i,
                    &row->calls->shown_records[cursor[4] - 1])) {
                    return false;
                }
                continue;
            }
            if (!charge_record(row, from, v)) {
                strbuf.str_buf mut limit = strbuf.create();
                defer strbuf.free(&limit);
                report_limit_message(record_bound(row, from), &limit);
                diag.error(diagnostics, location(c, v->source, entry), strbuf.view(&limit));
                return false;
            }
            strbuf.str_buf mut message = strbuf.create();
            defer strbuf.free(&message);
            violation_message(record_run(row, from, v), v,
                from >= 5 ? UNPROVED_EMPTY : UNPROVED_ACCESS, &message);
            diag.loc at = location(c, v->source, entry);
            diag.error(diagnostics, at, strbuf.view(&message));
            diag.note(diagnostics, at, v->text);
        }
        i += 1;
    }
    return boundary_records(c, diagnostics, entry);
}

// Renders each boundary failure at the declaration of its global, after the records of the
// bodies. The first process-exit ledger in body order pays its V units.
fn boundary_records(ownership_source.context mut* c, diag.sink mut* diagnostics, string entry)
    bool {
    ownership_source_exit.context mut* mut ledger = null;
    u64 mut i = 0;
    while (i < c->bodies.len && ledger == null) {
        if (c->bodies[i].exit.solved) { ledger = &c->bodies[i].exit; }
        i += 1;
    }
    i = 0;
    while (i < c->exit.boundary_unproved_len) {
        ownership_source_local.violation* v = &c->exit.boundary_unproved[i];
        diag.loc at = location(c, v->source, entry);
        if (ledger != null && !ownership_source_exit.charge_rendered(ledger, v)) {
            strbuf.str_buf mut limit = strbuf.create();
            defer strbuf.free(&limit);
            report_limit_message(ledger->meter.bounds.v, &limit);
            diag.error(diagnostics, at, strbuf.view(&limit));
            return false;
        }
        strbuf.str_buf mut message = strbuf.create();
        defer strbuf.free(&message);
        violation_message(null, v, UNPROVED_EMPTY, &message);
        diag.error(diagnostics, at, strbuf.view(&message));
        diag.note(diagnostics, at, v->text);
        i += 1;
    }
    return true;
}

// The phrase of one calls_heap record (toolchain 4.2). `order.kind` is the rendered class of
// the record: a validated event names its class, and any other record says "cannot prove".
fn calls_message(ownership_source_calls.shown* item, strbuf.str_buf mut* message) void {
    ownership_api.event_kind kind = item->order.kind;
    if (kind == ownership_api.event_kind.invalid_use) {
        strbuf.append(message, "invalid use of storage");
    } else if (kind == ownership_api.event_kind.lost_ownership) {
        strbuf.append(message, "lost ownership of an allocation");
    } else if (kind == ownership_api.event_kind.caller_requirement) {
        strbuf.append(message, "caller requirement fails at this call");
    } else {
        strbuf.append(message, "cannot prove the call and heap obligations here");
        return;
    }
    if (item->evidence == ownership_api.evidence_kind.validated_path) {
        strbuf.append(message, " on this path");
    }
}

// The text of a note of a calls_heap event: its own text, or its causal role.
fn note_text(ownership_api.event_note* note) string {
    if (note->text.len > 0) { return note->text; }
    switch (note->role) {
    case ownership_api.note_role.allocation: return "the allocation";
    case ownership_api.note_role.lending: return "the borrow";
    case ownership_api.note_role.release: return "the release";
    case ownership_api.note_role.transfer: return "the transfer";
    case ownership_api.note_role.storage_end: return "the end of storage";
    case ownership_api.note_role.callee: return "the callee operation";
    case ownership_api.note_role.substitution: return "the substituted caller source";
    case ownership_api.note_role.defer_registration: return "the deferred statement";
    case ownership_api.note_role.defer_exit: return "the exit that runs the deferred statement";
    case ownership_api.note_role.precision_loss: return "the analysis loses a fact here";
    case ownership_api.note_role.assumption: return "an assumption of the witness";
    }
}

// Renders one calls_heap record: the error, a note with its event text or its reason, and a
// note for each note of its event. Each line charges one V unit of the summary ledger of the
// body. A refused charge renders one terminal error and stops the later records.
fn calls_record(ownership_source.context mut* c, diag.sink mut* diagnostics, string entry,
    u64 body, ownership_source_calls.shown* item) bool {
    u64 mut lines = 2;
    if (item->event != null) { lines += item->event->value.notes.len; }
    diag.loc at = location(c, item->order.source, entry);
    if (!ownership_source_calls.charge_rendered(&c->calls, body, item->order.operation,
        item->order.source, lines)) {
        strbuf.str_buf mut limit = strbuf.create();
        defer strbuf.free(&limit);
        report_limit_message(
            c->calls.ledgers[c->calls.rows[body].summary_ledger].meter.bounds.v, &limit);
        diag.error(diagnostics, at, strbuf.view(&limit));
        return false;
    }
    strbuf.str_buf mut message = strbuf.create();
    defer strbuf.free(&message);
    calls_message(item, &message);
    diag.error(diagnostics, at, strbuf.view(&message));
    strbuf.clear(&message);
    if (item->event != null && item->event->value.text.len > 0) {
        strbuf.append(&message, item->event->value.text);
    } else if (item->event != null) {
        // An event names its place in its text. An event without a text names its operation.
        strbuf.append(&message, "the storage that this operation uses");
    } else {
        ownership_api.proof_status proof = c->calls.rows[body].proof;
        strbuf.append(&message, "calls_heap: ");
        strbuf.append(&message, incomplete_code(proof.terminal.reason));
    }
    diag.note(diagnostics, at, strbuf.view(&message));
    if (item->event == null) { return true; }
    u64 mut k = 0;
    while (k < item->event->value.notes.len) {
        ownership_api.event_note* note = &item->event->value.notes[k];
        diag.loc where = note->source.filename_present ? location(c, note->source, entry) : at;
        diag.note(diagnostics, where, note_text(note));
        k += 1;
    }
    return true;
}

// The budget errors of the calls_heap ledgers: the first W, E or V refusal of each component
// computation, its W refusal when another came first, because that one stopped the
// computation, and its V refusal, because that one lost an event (fir.md 14.1). A refusal
// that is already the shown reason is no second error.
fn calls_budgets(ownership_source.context mut* c, diag.sink mut* diagnostics, string entry,
    reason shown) bool {
    u64 mut i = 0;
    while (i < c->calls.ledgers_len) {
        ownership_source_calls.ledger* l = &c->calls.ledgers[i];
        string label = l->solver == ownership_source_calls.solver_kind.summary ?
            "calls summary" : "calls heap";
        if (!calls_budget(c, diagnostics, entry, l->first_refusal, label, shown)) {
            return false;
        }
        bool later = l->work_refusal.terminal.present && !same_refusal(l->work_refusal.terminal,
            l->first_refusal.terminal);
        if (later && !calls_budget(c, diagnostics, entry, l->work_refusal, label, shown)) {
            return false;
        }
        bool lost = l->report_refusal.terminal.present &&
            !same_refusal(l->report_refusal.terminal, l->first_refusal.terminal);
        if (lost && !calls_budget(c, diagnostics, entry, l->report_refusal, label, shown)) {
            return false;
        }
        i += 1;
    }
    return true;
}

fn calls_budget(ownership_source.context mut* c, diag.sink mut* diagnostics, string entry,
    ownership_api.proof_status refusal, string label, reason shown) bool {
    reason mut why = proof_reason("calls_heap", refusal);
    if (!why.present || !why.limit.present || same_reason(why, shown)) { return true; }
    ownership_api.limit_category kind = why.limit.category;
    if (kind != ownership_api.limit_category.w && kind != ownership_api.limit_category.e &&
        kind != ownership_api.limit_category.v) { return true; }
    why.stage = label;
    return diagnostic(c, diagnostics, entry, why, null);
}

/// Emits closure and service errors. V refusal stops normal errors and keeps one terminal error.
fn diagnose(ownership_source.context mut* c, diag.sink mut* diagnostics, string entry) void {
    if (!violations(c, diagnostics, entry)) { return; }
    ownership_source.body mut* mut charged = null;
    u64 mut i = 0;
    while (i < c->bodies.len) {
        if (c->bodies[i].live.initialized) { charged = &c->bodies[i]; break; }
        i += 1;
    }
    // A closure without an incomplete reason renders no incomplete-proof error: a program that
    // fails checking has its own errors (toolchain 4.2).
    reason first = first_incomplete(c);
    if (first.present && !diagnostic(c, diagnostics, entry, first, charged)) { return; }
    i = 0;
    while (i < c->bodies.len) {
        ownership_source.body mut* row = &c->bodies[i];
        reason why = proof_reason("liveness", row->live.first_refusal);
        if (why.present && why.limit.present &&
            (why.limit.category == ownership_api.limit_category.w ||
             why.limit.category == ownership_api.limit_category.v)) {
            if (!diagnostic(c, diagnostics, entry, why, row)) { return; }
        }
        if (!ledger_budget(c, diagnostics, entry, row, LOCAL, row->local.first_refusal,
            "local", first)) {
            return;
        }
        // Two ledgers that refuse one operation for one category give one error (4.2).
        ownership_api.terminal_failure primary = row->local.first_refusal.terminal;
        ownership_api.terminal_failure second = row->local.classify_refusal.terminal;
        bool repeated = primary.present && second.present && primary.limit.present &&
            second.limit.present && primary.limit.category == second.limit.category &&
            ownership_keys.operation(primary.operation, second.operation) == 0;
        if (!repeated && !ledger_budget(c, diagnostics, entry, row, LOCAL,
            row->local.classify_refusal, "local classification", first)) {
            return;
        }
        if (!stored_budgets(c, diagnostics, entry, row, first)) { return; }
        if (!ledger_budget(c, diagnostics, entry, row, RAW, row->raw.first_refusal, "raw",
            first)) {
            return;
        }
        if (!ledger_budget(c, diagnostics, entry, row, PROCESS_EXIT, row->exit.first_refusal,
            "process exit", first)) {
            return;
        }
        i += 1;
    }
    calls_budgets(c, diagnostics, entry, first);
}

/// Renders the local verdict of function `index` of a `.fir` test whose locations name `file`:
/// each validated violation as an error and a note, then one incomplete-proof error when the
/// local proof has no violation and is not complete. Returns the number of errors.
fn fir_test_local(fir.func* f, u32 index, diag.sink mut* diagnostics, string file) u64 {
    ownership_source_local.context mut local = ownership_source_local.context{};
    defer ownership_source_local.free(&local);
    ownership_api.function_id key = ownership_api.function_id{
        ownership_api.declaration_id{0, index}, 0};
    diag.loc name = f->sym->decl;
    ownership_api.source_position declaration = ownership_api.source_position{0, 0, name.line,
        name.col, name.end_line, name.end_col, true};
    ownership_source_local.prepare(&local, f, key, 0, file, declaration);
    ownership_source_local.solve(&local);
    u64 mut errors = 0;
    u64 mut k = 0;
    while (k < local.violations_len) {
        ownership_source_local.violation* v = &local.violations[k];
        diag.loc at = position_in(file, v->source, file);
        strbuf.str_buf mut message = strbuf.create();
        defer strbuf.free(&message);
        if (!ownership_source_local.charge_rendered(&local, v)) {
            report_limit_message(local.meter.bounds.v, &message);
            diag.error(diagnostics, at, strbuf.view(&message));
            return errors + 1;
        }
        violation_message(&local, v, UNPROVED_ACCESS, &message);
        diag.error(diagnostics, at, strbuf.view(&message));
        diag.note(diagnostics, at, v->text);
        errors += 1;
        k += 1;
    }
    reason why = proof_reason("local", local.proof);
    if (errors == 0 && why.present) {
        strbuf.str_buf mut message = strbuf.create();
        defer strbuf.free(&message);
        incomplete_message(why, &message);
        diag.error(diagnostics, position_in(file, why.source, file), strbuf.view(&message));
        errors += 1;
    }
    return errors;
}

fn same_refusal(ownership_api.terminal_failure a, ownership_api.terminal_failure b) bool {
    return a.present && b.present && a.limit.present && b.limit.present &&
        a.limit.category == b.limit.category &&
        ownership_keys.operation(a.operation, b.operation) == 0;
}

// The budget errors of the stored ledgers. A stored refusal of one operation and category
// that a local ledger already reported gives no second error (4.2).
fn stored_budgets(ownership_source.context mut* c, diag.sink mut* diagnostics, string entry,
    ownership_source.body mut* row, reason first) bool {
    ownership_api.terminal_failure local = row->local.first_refusal.terminal;
    ownership_api.terminal_failure local_second = row->local.classify_refusal.terminal;
    ownership_api.terminal_failure stored = row->stored.first_refusal.terminal;
    ownership_api.terminal_failure second = row->stored.classify_refusal.terminal;
    if (!same_refusal(stored, local) && !same_refusal(stored, local_second) &&
        !ledger_budget(c, diagnostics, entry, row, STORED_BORROWS, row->stored.first_refusal,
        "stored borrows", first)) {
        return false;
    }
    return same_refusal(second, stored) || same_refusal(second, local) ||
        same_refusal(second, local_second) || ledger_budget(c, diagnostics, entry, row,
        STORED_BORROWS, row->stored.classify_refusal, "stored borrows classification", first);
}

fn same_reason(reason a, reason b) bool {
    return a.present == b.present && a.stage == b.stage && a.code == b.code &&
        ownership_keys.source(a.source, b.source) == 0 &&
        a.limit.present == b.limit.present && a.limit.category == b.limit.category &&
        a.limit.used == b.limit.used && a.limit.bound == b.limit.bound;
}

// The budget error of one ledger of the analysis of `stage`, which charges the V bound of that
// analysis. `stage` names the analysis row, so a refusal that is already the shown reason is
// no second error. `label` names the ledger in the error, for example "local classification".
// A W, E or V refusal is a budget error even when no later use needs its result (fir.md 14.1).
// A V refusal renders as it is.
fn ledger_budget(ownership_source.context mut* c, diag.sink mut* diagnostics, string entry,
    ownership_source.body mut* row, u64 stage, ownership_api.proof_status refusal, string label,
    reason shown) bool {
    reason mut why = proof_reason(ANALYSES[stage], refusal);
    if (!why.present || !why.limit.present || same_reason(why, shown)) { return true; }
    why.stage = label;
    ownership_api.limit_category kind = why.limit.category;
    if (kind != ownership_api.limit_category.w && kind != ownership_api.limit_category.e &&
        kind != ownership_api.limit_category.v) { return true; }
    // A refused charge keeps this error as the terminal record and stops the later errors.
    bool allowed = kind == ownership_api.limit_category.v ||
        charge_ledger(row, stage, refusal.terminal.operation, why.source);
    return diagnostic(c, diagnostics, entry, why, null) && allowed;
}

// Charges one budget error to the V bound of the ledger of the analysis of `stage`.
fn charge_ledger(ownership_source.body mut* row, u64 stage, ownership_api.operation_position op,
    ownership_api.source_position at) bool {
    if (stage == RAW) { return ownership_source_raw.charge_report(&row->raw, op, at, 1); }
    if (stage == PROCESS_EXIT) {
        return ownership_source_exit.charge_report(&row->exit, op, at, 1);
    }
    if (stage == STORED_BORROWS) {
        return ownership_source_local.charge_report(&row->stored, op, at, 1);
    }
    return ownership_source_local.charge_report(&row->local, op, at, 1);
}

fn key_string(json.writer mut* j, string key, string value) void {
    json.json_key(j, key);
    json.json_str(j, value);
}

fn key_uint(json.writer mut* j, string key, u64 value) void {
    json.json_key(j, key);
    json.json_uint(j, value);
}

fn key_bool(json.writer mut* j, string key, bool value) void {
    json.json_key(j, key);
    json.json_bool(j, value);
}

fn write_key(json.writer mut* j, ownership_api.function_id key) void {
    json.json_object_begin(j);
    key_uint(j, "module", cast(key.declaration.module, u64));
    key_uint(j, "declaration", cast(key.declaration.declaration, u64));
    key_uint(j, "instance", cast(key.instance, u64));
    json.json_object_end(j);
}

fn write_range(json.writer mut* j, ownership_api.source_position source) void {
    key_uint(j, "file", cast(source.file, u64));
    key_uint(j, "line", cast(source.line, u64));
    key_uint(j, "col", cast(source.col, u64));
    key_uint(j, "end_line", cast(source.end_line, u64));
    key_uint(j, "end_col", cast(source.end_col, u64));
}

fn write_reason(json.writer mut* j, reason why) void {
    if (!why.present) { json.json_null(j); return; }
    json.json_object_begin(j);
    key_string(j, "stage", why.stage);
    key_string(j, "code", why.code);
    json.json_key(j, "source");
    if (why.source.filename_present) {
        json.json_object_begin(j);
        write_range(j, why.source);
        json.json_object_end(j);
    } else { json.json_null(j); }
    json.json_key(j, "limit");
    if (why.limit.present) {
        json.json_object_begin(j);
        key_string(j, "category", CATEGORIES[cast(why.limit.category, u64)]);
        key_uint(j, "used", why.limit.used);
        key_uint(j, "bound", why.limit.bound);
        json.json_object_end(j);
    } else { json.json_null(j); }
    json.json_object_end(j);
}

fn write_invocation(json.writer mut* j, invocation* call) void {
    json.json_object_begin(j);
    key_string(j, "entry", call->entry);
    key_string(j, "cwd", call->cwd);
    json.json_key(j, "argv");
    json.json_array_begin(j);
    u64 mut argument = 0;
    while (argument < call->arguments.len) {
        json.json_str(j, call->arguments[argument]);
        argument += 1;
    }
    json.json_array_end(j);
    key_string(j, "target", call->target);
    json.json_key(j, "configuration");
    json.json_array_begin(j);
    u64 mut index = 0;
    while (index < call->config_keys.len) {
        string key = call->config_keys[index];
        json.json_object_begin(j);
        key_string(j, "key", key);
        key_string(j, "value", call->config_values[index]);
        json.json_object_end(j);
        index += 1;
    }
    json.json_array_end(j);
    json.json_key(j, "mode");
    json.json_object_begin(j);
    key_bool(j, "check", call->check);
    key_bool(j, "release", call->release);
    key_bool(j, "no_bounds_check", call->no_bounds_check);
    json.json_object_end(j);
    json.json_object_end(j);
}

fn write_files(json.writer mut* j, ownership_source.context* c) void {
    json.json_array_begin(j);
    u64 mut i = 0;
    while (i < modules.file_count(c->modules)) {
        json.json_object_begin(j);
        key_uint(j, "id", i);
        key_string(j, "path", modules.file_at(c->modules, i));
        key_string(j, "module", c->modules->modules.items[i]->path);
        json.json_object_end(j);
        i += 1;
    }
    json.json_array_end(j);
}

fn write_limits(json.writer mut* j, ownership_api.limit_table* limits) void {
    string[ownership_api.LIMIT_COUNT] names = {"d", "r", "p", "g", "h", "t", "e", "w", "v"};
    json.json_object_begin(j);
    key_uint(j, "version", cast(limits->version, u64));
    u64 mut i = 0;
    while (i < names.len) {
        ownership_api.limit_category kind = cast(i, ownership_api.limit_category);
        key_uint(j, names[i], ownership_limits.bound(limits, kind));
        if (kind == ownership_api.limit_category.w) {
            key_uint(j, "w_scale", ownership_limits.PRODUCTION_W_SCALE);
        }
        i += 1;
    }
    json.json_object_end(j);
}

fn write_count(json.writer mut* j, u64 category, u64 used, u64 bound) void {
    json.json_object_begin(j);
    key_string(j, "category", CATEGORIES[category]);
    key_string(j, "scope",
        SCOPES[cast(ownership_api.scope_of(cast(category, ownership_api.limit_category)), u64)]);
    key_uint(j, "used", used);
    key_uint(j, "bound", bound);
    json.json_object_end(j);
}

fn write_meters(json.writer mut* j, ownership_source.context* c) void {
    json.json_array_begin(j);
    u64 mut id = 0;
    if (c->graph_built) {
        json.json_object_begin(j);
        key_uint(j, "id", id);
        key_string(j, "name", "graph_private");
        json.json_key(j, "owner");
        json.json_null(j);
        key_uint(j, "fir_size", c->graph.fir_size);
        json.json_key(j, "counts");
        json.json_array_begin(j);
        write_count(j, cast(ownership_api.limit_category.w, u64), c->graph.work, c->graph.limits.w);
        json.json_array_end(j);
        json.json_key(j, "first_refusal");
        write_reason(j, proof_reason("graph", c->graph_first_refusal));
        json.json_object_end(j);
        id += 1;
    }
    // The call-graph step of the process-exit boundary: one closure ledger that counts W only.
    if (c->exit.fills_decided) {
        json.json_object_begin(j);
        key_uint(j, "id", id);
        key_string(j, "name", "process_exit_fills");
        json.json_key(j, "owner");
        json.json_null(j);
        key_uint(j, "fir_size", c->exit.fills_fir_size);
        json.json_key(j, "counts");
        json.json_array_begin(j);
        write_count(j, cast(ownership_api.limit_category.w, u64),
            ownership_limits.used(&c->exit.fills_meter.used, ownership_api.limit_category.w),
            ownership_limits.bound(&c->exit.fills_meter.bounds, ownership_api.limit_category.w));
        json.json_array_end(j);
        json.json_key(j, "first_refusal");
        write_reason(j, proof_reason("process_exit", c->exit.fills_refusal));
        json.json_object_end(j);
        id += 1;
    }
    u64 mut i = 0;
    while (i < c->bodies.len) {
        ownership_source.body* row = &c->bodies[i];
        if (!row->live.initialized) { i += 1; continue; }
        json.json_object_begin(j);
        key_uint(j, "id", id);
        key_string(j, "name", "services");
        json.json_key(j, "owner");
        write_key(j, row->key);
        key_uint(j, "fir_size", row->live.fir_size);
        json.json_key(j, "counts");
        json.json_array_begin(j);
        u64 mut category = 0;
        while (category < ownership_api.LIMIT_COUNT) {
            ownership_api.limit_category kind = cast(category, ownership_api.limit_category);
            write_count(j, category, ownership_limits.used(&row->live.events.budget.used, kind),
                ownership_limits.bound(&row->live.events.budget.bounds, kind));
            category += 1;
        }
        json.json_array_end(j);
        json.json_key(j, "first_refusal");
        write_reason(j, proof_reason("liveness", row->live.first_refusal));
        json.json_object_end(j);
        id = write_producer_meters(j, row, id + 1);
        i += 1;
    }
    // One ledger for each component computation of each calls_heap solver, in solve order.
    i = 0;
    while (i < c->calls.ledgers_len) {
        ownership_source_calls.ledger* l = &c->calls.ledgers[i];
        write_ledger(j, id, l->solver == ownership_source_calls.solver_kind.summary ?
            "calls_summary" : "calls_heap", l->owner, &l->meter, l->first_refusal, l->fir_size,
            "calls_heap");
        id += 1;
        i += 1;
    }
    json.json_array_end(j);
}

// The ledgers of the producer computations of one body, from meter ID `id`. Returns the next ID.
fn write_producer_meters(json.writer mut* j, ownership_source.body* row, u64 id) u64 {
    u64 mut next = write_flow_meters(j, row, &row->local, id, "local", "local_classification");
    next = write_flow_meters(j, row, &row->stored, next, "stored_borrows",
        "stored_borrows_classification");
    if (row->raw.initialized) {
        write_ledger(j, next, "raw", row->key, &row->raw.meter, row->raw.first_refusal,
            row->raw.fir_size, "raw");
        next += 1;
    }
    if (row->exit.initialized) {
        write_ledger(j, next, "process_exit", row->key, &row->exit.meter,
            row->exit.first_refusal, row->exit.fir_size, "process_exit");
        next += 1;
    }
    return next;
}

// The ledgers of one flow run from meter ID `id`: its own computation and, when the body
// needs one, its classification run. It returns the next free ID.
fn write_flow_meters(json.writer mut* j, ownership_source.body* row,
    ownership_source_local.context* run, u64 id, string name, string classification) u64 {
    if (!run->initialized) { return id; }
    string stage = run->stored ? "stored_borrows" : "local";
    write_ledger(j, id, name, row->key, &run->meter, run->first_refusal, run->fir_size, stage);
    if (!run->classified) { return id + 1; }
    write_ledger(j, id + 1, classification, row->key, &run->classify_meter,
        run->classify_refusal, run->fir_size, stage);
    return id + 2;
}

// Each computation keeps its own ledger (D17.18): the local run, the stored run, the
// classification run of either when the body needed one, and the raw analysis of one body, and
// each component computation of a calls_heap solver. `owner` keys the body or the first member
// of the component.
fn write_ledger(json.writer mut* j, u64 id, string name, ownership_api.function_id owner,
    ownership_limits.meter* ledger, ownership_api.proof_status refusal, u64 fir_size,
    string stage) void {
    json.json_object_begin(j);
    key_uint(j, "id", id);
    key_string(j, "name", name);
    json.json_key(j, "owner");
    write_key(j, owner);
    key_uint(j, "fir_size", fir_size);
    json.json_key(j, "counts");
    json.json_array_begin(j);
    u64 mut category = 0;
    while (category < ownership_api.LIMIT_COUNT) {
        ownership_api.limit_category kind = cast(category, ownership_api.limit_category);
        write_count(j, category, ownership_limits.used(&ledger->used, kind),
            ownership_limits.bound(&ledger->bounds, kind));
        category += 1;
    }
    json.json_array_end(j);
    json.json_key(j, "first_refusal");
    write_reason(j, proof_reason(stage, refusal));
    json.json_object_end(j);
}

fn write_analysis(json.writer mut* j, ownership_source.body* row, u64 stage) void {
    json.json_object_begin(j);
    key_string(j, "name", ANALYSES[stage]);
    key_string(j, "correspondence", analysis_status(row, stage, 0));
    key_string(j, "solver", analysis_status(row, stage, 1));
    key_string(j, "proof", analysis_status(row, stage, 2));
    key_uint(j, "violations", analysis_violations(row, stage));
    json.json_object_end(j);
}

fn write_body(json.writer mut* j, ownership_source.body* row) void {
    json.json_object_begin(j);
    json.json_key(j, "source");
    json.json_object_begin(j);
    write_range(j, row->source);
    key_uint(j, "instance", 0);
    key_string(j, "module", row->module->path);
    key_string(j, "name", row->declaration->name);
    json.json_object_end(j);
    json.json_key(j, "key");
    if (row->keyed) { write_key(j, row->key); } else { json.json_null(j); }
    u64 mut stage = 0;
    while (stage < STAGES.len) {
        key_string(j, STAGES[stage], stage_status(row, stage));
        stage += 1;
    }
    json.json_key(j, "analyses");
    json.json_array_begin(j);
    stage = 0;
    while (stage < ANALYSIS_COUNT) { write_analysis(j, row, stage); stage += 1; }
    json.json_array_end(j);
    key_string(j, "ownership", body_ownership(row));
    key_uint(j, "violations", body_violations(row));
    json.json_key(j, "first_incomplete");
    write_reason(j, body_reason(row));
    json.json_object_end(j);
}

fn counter(json.writer mut* j, ownership_source.context* c, string@ statuses,
    u64 group, u64 stage, u64 field) void {
    json.json_object_begin(j);
    u64 mut status_index = 0;
    while (status_index < statuses.len) {
        string wanted = statuses[status_index];
        u64 mut count = 0;
        u64 mut i = 0;
        while (i < c->bodies.len) {
            ownership_source.body* row = &c->bodies[i];
            string got = group == 0 ? stage_status(row, stage) : group == 1 ?
                body_ownership(row) : analysis_status(row, stage, field);
            if (got == wanted) {
                // count counts rows before row i, and i < c->bodies.len <= U64_MAX.
                // panic-coverage: unreachable: read: count <= i < U64_MAX here.
                if (count == ownership_api.U64_MAX) { panic("ownership report: count overflow"); }
                count += 1;
            }
            i += 1;
        }
        key_uint(j, wanted, count);
        status_index += 1;
    }
    json.json_object_end(j);
}

// A body has at most one violation for each produced step, return and obligation, so the sum
// fits.
fn total_violations(ownership_source.context* c) u64 {
    u64 mut total = 0;
    u64 mut i = 0;
    while (i < c->bodies.len) {
        total += body_violations(&c->bodies[i]);
        i += 1;
    }
    return total;
}

fn stage_violations(ownership_source.context* c, u64 stage) u64 {
    u64 mut total = 0;
    u64 mut i = 0;
    while (i < c->bodies.len) {
        total += analysis_violations(&c->bodies[i], stage);
        i += 1;
    }
    return total;
}

// The process-exit boundary: the generated executable sequence or the library cleanup.
fn write_boundary(json.writer mut* j, ownership_source.context* c) void {
    json.json_object_begin(j);
    key_string(j, "kind", c->exit.executable ? "executable" : "library");
    key_uint(j, "leaves", c->exit.leaves_len);
    key_string(j, "correspondence", status_word(c->exit.boundary_correspondence));
    key_string(j, "proof", status_word(c->exit.boundary_proof));
    json.json_key(j, "first_incomplete");
    write_reason(j, proof_reason("process_exit", c->exit.boundary_first));
    json.json_object_end(j);
}

fn write_totals(json.writer mut* j, ownership_source.context* c) void {
    json.json_object_begin(j);
    key_uint(j, "bodies", c->bodies.len);
    key_uint(j, "violations", total_violations(c));
    u64 mut stage = 0;
    while (stage < STAGES.len) {
        json.json_key(j, STAGES[stage]);
        counter(j, c, STAGE_STATUSES[..], 0, stage, 0);
        stage += 1;
    }
    json.json_key(j, "ownership");
    counter(j, c, PROOF_STATUSES[..], 1, 0, 0);
    json.json_key(j, "analyses");
    json.json_array_begin(j);
    stage = 0;
    while (stage < ANALYSIS_COUNT) {
        json.json_object_begin(j);
        key_string(j, "name", ANALYSES[stage]);
        json.json_key(j, "correspondence");
        counter(j, c, WORK_STATUSES[..], 2, stage, 0);
        json.json_key(j, "solver");
        counter(j, c, WORK_STATUSES[..], 2, stage, 1);
        json.json_key(j, "proof");
        counter(j, c, PROOF_STATUSES[..], 2, stage, 2);
        key_uint(j, "violations", stage_violations(c, stage));
        json.json_object_end(j);
        stage += 1;
    }
    json.json_array_end(j);
    json.json_object_end(j);
}

/// Builds a complete coverage document. It retains no expanded event history.
fn build(strbuf.str_buf mut* out, ownership_source.context* c, invocation* call,
    i32 exit_status) void {
    json.writer mut j = json.writer{};
    json.json_init(&j, out);
    json.json_object_begin(&j);
    key_string(&j, "kind", "fort-ownership-report");
    // Version 2 adds the W scale of the limit table and the FIR size of each meter.
    // Version 3 adds the integrated local analysis and its `local` ledgers.
    // Version 4 adds the integrated raw analysis and its `raw` ledgers.
    // Version 5 adds the integrated stored-borrow analysis and its `stored_borrows` ledgers.
    // Version 6 adds the integrated process-exit analysis, its `process_exit` ledgers and the
    // boundary member.
    // Version 7 adds the integrated calls_heap analysis and its `calls_summary` and
    // `calls_heap` ledgers.
    key_uint(&j, "version", 7);
    key_bool(&j, "complete", true);
    key_string(&j, "compiler_version", call->compiler_version);
    json.json_key(&j, "invocation");
    write_invocation(&j, call);
    json.json_key(&j, "files");
    write_files(&j, c);
    json.json_key(&j, "enumeration");
    json.json_object_begin(&j);
    key_bool(&j, "complete", c->enumeration_complete);
    key_uint(&j, "selected_bodies", c->bodies.len);
    key_uint(&j, "inactive_declarations", c->inactive_declarations);
    json.json_object_end(&j);
    json.json_key(&j, "analyses");
    json.json_array_begin(&j);
    u64 mut stage = 0;
    while (stage < ANALYSIS_COUNT) {
        json.json_object_begin(&j);
        key_string(&j, "name", ANALYSES[stage]);
        key_string(&j, "producer", integrated(stage) ? "integrated" : "unavailable");
        key_string(&j, "status", closure_status(c, stage));
        json.json_object_end(&j);
        stage += 1;
    }
    json.json_array_end(&j);
    ownership_api.limit_table limits = ownership_limits.production();
    json.json_key(&j, "limits");
    write_limits(&j, &limits);
    json.json_key(&j, "meters");
    write_meters(&j, c);
    json.json_key(&j, "bodies");
    json.json_array_begin(&j);
    u64 mut i = 0;
    while (i < c->bodies.len) { write_body(&j, &c->bodies[i]); i += 1; }
    json.json_array_end(&j);
    json.json_key(&j, "totals");
    write_totals(&j, c);
    json.json_key(&j, "boundary");
    write_boundary(&j, c);
    json.json_key(&j, "first_incomplete");
    write_reason(&j, first_incomplete(c));
    json.json_key(&j, "failure");
    write_reason(&j, failure(c, exit_status));
    key_string(&j, "verdict", exit_status == 0 ? "accepted" : exit_status == 1 ?
        "rejected" : "failed");
    key_uint(&j, "exit_status", cast(exit_status, u64));
    json.json_object_end(&j);
    strbuf.push(out, '\n');
}

// Canonicalize the parent too. This detects aliases for destinations that do not exist.
fn destination(string path, strbuf.str_buf mut* out) bool {
    if (path.len == 0 || str.index_of(path, '\0') >= 0) { return false; }
    i64 slash = str.last_index_of(path, '/');
    string parent = slash < 0 ? "." : slash == 0 ? "/" : path[..cast(slash, u64)];
    string name = slash < 0 ? path : path[cast(slash, u64) + 1..];
    if (name.len == 0) { return false; }
    if (os.real_path(path, out)) { return true; }
    i32 real_error = sys.errno();
    if (real_error != libc.ENOENT) { return false; }
    char mut@ own c_path = str.to_cstr(path);
    defer del(c_path);
    char[1] mut link_prefix = {};
    // Any link rejects the absent-name fallback. A dangling output can later expose the report.
    i64 linked = libc.readlink(c_path.ptr, &link_prefix[0], link_prefix.len);
    if (linked >= 0 || sys.errno() != libc.ENOENT) { return false; }
    if (!os.real_path(parent, out)) { return false; }
    if (strbuf.view(out) != "/") { strbuf.push(out, '/'); }
    strbuf.append(out, name);
    return true;
}

// Probe absent names in their actual directory. Its case and Unicode rules apply to both names.
// An uncertain lookup rejects the destination. The probe never opens either final destination.
fn absent_alias(string selected, string other) bool {
    i64 first_slash = str.last_index_of(selected, '/');
    i64 other_slash = str.last_index_of(other, '/');
    if (first_slash < 0 || other_slash < 0) { return true; }
    if (selected[..cast(first_slash, u64)] != other[..cast(other_slash, u64)]) { return false; }
    strbuf.str_buf mut resolved = strbuf.create();
    defer strbuf.free(&resolved);
    if (os.real_path(selected, &resolved)) { return false; }
    if (sys.errno() != libc.ENOENT) { return true; }
    if (os.real_path(other, &resolved)) { return false; }
    if (sys.errno() != libc.ENOENT) { return true; }
    // A suffix can change trailing-dot or trailing-space comparison on some filesystems.
    if (selected[selected.len - 1] == '.' || selected[selected.len - 1] == ' ' ||
        other[other.len - 1] == '.' || other[other.len - 1] == ' ') { return true; }
    strbuf.str_buf mut temporary = strbuf.create();
    defer strbuf.free(&temporary);
    strbuf.append(&temporary, selected);
    strbuf.append(&temporary, ".tmp.XXXXXX");
    char mut@ own temp_path = str.to_cstr(strbuf.view(&temporary));
    defer del(temp_path);
    i32 fd = mkstemp(temp_path.ptr);
    if (fd < 0) { return true; }
    bool closed = io.close(fd);
    bool mut uncertain = !closed || !os.real_path(str.from_cstr(temp_path.ptr), &resolved);
    strbuf.str_buf mut candidate = strbuf.create();
    defer strbuf.free(&candidate);
    strbuf.append(&candidate, other);
    strbuf.append(&candidate, str.from_cstr(temp_path.ptr)[selected.len..]);
    strbuf.str_buf mut alias = strbuf.create();
    defer strbuf.free(&alias);
    bool found = os.real_path(strbuf.view(&candidate), &alias);
    uncertain = uncertain || (!found && sys.errno() != libc.ENOENT);
    bool removed = libc.unlink(temp_path.ptr) == 0;
    return uncertain || !removed || (found && strbuf.view(&resolved) == strbuf.view(&alias));
}

/// Rejects aliases for every source read and the selected compiler output.
fn path_allowed(string path, string entry, string output, modules.module_set* set,
    session.session* s) bool {
    strbuf.str_buf mut selected = strbuf.create();
    defer strbuf.free(&selected);
    if (!destination(path, &selected)) { return false; }
    strbuf.str_buf mut other = strbuf.create();
    defer strbuf.free(&other);
    if (destination(entry, &other) && strbuf.view(&selected) == strbuf.view(&other)) {
        return false;
    }
    strbuf.clear(&other);
    if (destination(output, &other)) {
        if (strbuf.view(&selected) == strbuf.view(&other) ||
            absent_alias(strbuf.view(&selected), strbuf.view(&other))) { return false; }
    } else {
        return false;
    }
    u64 mut i = 0;
    while (i < modules.file_count(set)) {
        strbuf.clear(&other);
        if (destination(modules.file_at(set, i), &other) &&
            strbuf.view(&selected) == strbuf.view(&other)) { return false; }
        i += 1;
    }
    i = 0;
    while (i < s->sources.entries.len) {
        if (s->sources.entries[i].state == strmap.SLOT_FULL) {
            strbuf.clear(&other);
            if (!destination(s->sources.entries[i].key, &other) ||
                strbuf.view(&selected) == strbuf.view(&other)) { return false; }
        }
        i += 1;
    }
    return true;
}

/// Publishes only after writing and closing a new adjacent temporary file.
fn publish(string path, u8@ bytes) bool {
    strbuf.str_buf mut temporary = strbuf.create();
    defer strbuf.free(&temporary);
    strbuf.append(&temporary, path);
    strbuf.append(&temporary, ".tmp.XXXXXX");
    char mut@ own temp_path = str.to_cstr(strbuf.view(&temporary));
    defer del(temp_path);
    char mut@ own output_path = str.to_cstr(path);
    defer del(output_path);
    i32 fd = mkstemp(temp_path.ptr);
    if (fd < 0) { return false; }
    bool written = io.write_all(fd, bytes);
    bool closed = io.close(fd);
    if (written && closed && rename(temp_path.ptr, output_path.ptr) == 0) { return true; }
    libc.unlink(temp_path.ptr);
    return false;
}
