/// Parses and evaluates finite floating-point constants with integer arithmetic.
/// Operations round once to nearest, with ties to even.
import std.strbuf;

// ---- the two formats ---------------------------------------------------------------

// Defines each format by its mantissa width and exponent limits. The width
// includes the implicit bit. Values have the form m * 2^e. binary64
// holds m * 2^e for m < 2^53, e in [-1074, 971]; binary32 for m < 2^24, e in
// [-149, 104].
u64 F64_MANT = 53;
i64 F64_EXP_MIN = -1074;
i64 F64_EXP_MAX = 971;
u64 F32_MANT = 24;
i64 F32_EXP_MIN = -149;
i64 F32_EXP_MAX = 104;

// Defines the binary64 sign, mantissa, implicit bit, and exponent field. It also
// defines the field for infinity or NaN. The bias is 1023 + 52. It is added to
// the exponent of a value written with the implicit bit in place.
u64 F64_SIGN = 0x8000000000000000;
u64 F64_FRAC_MASK = 0x000FFFFFFFFFFFFF;
u64 F64_MAG_MASK = 0x7FFFFFFFFFFFFFFF;
u64 F64_HIDDEN = 0x0010000000000000;
u64 F64_FRAC_BITS = 52;
u64 F64_FIELD_MASK = 0x7FF;
u64 F64_FIELD_INF = 0x7FF;
i64 F64_BIAS = 1075;

// The hex digits a constant prints with, most significant first, and the four
// bits each one carries.
string HEX_DIGITS = "0123456789ABCDEF";
u64 HEX_BITS = 4;
u64 HEX_MASK = 15;
u64 HEX_COUNT = 16;

// ---- bignums -----------------------------------------------------------------------

// Defines bignum capacity and limb width. 160 limbs hold 5120 bits. The largest
// caller value uses 3733 bits. It contains at most 800 decimal digits, or 2658
// bits, shifted left by the 1075 places
// round_ratio needs for the least subnormal. The decimal denominator is
// 10^1150 at most, 3821 bits, and the four operations reach 3173 bits. So the
// array keeps one quarter of its bits spare. Any overflow indicates a compiler
// defect, not a program that the compiler must accept.
u64 BN_LIMBS = 160;
u64 LIMB_BITS = 32;
u64 LIMB_MASK = 0xFFFFFFFF;
u64 LIMB_BASE = 0x100000000;

// The number of significant decimal digits to read. An exact binary64 midpoint
// has at most 767 digits, so 800 digits decide each rounding. A later nonzero
// digit only breaks a tie upward. The round_ratio `tail` flag records it.
u64 FLT_MAX_DIGITS = 800;

// The decimal exponent of the leading digit above which a literal is not
// finite in binary64, and below which it rounds to zero. 10^311 exceeds the
// largest binary64, about 1.8e308. 10^-351 is below half the least subnormal,
// about 2.5e-324. Both results are known before building a bignum. This bounds
// BN_LIMBS.
i64 FLT_POINT_MAX = 310;
i64 FLT_POINT_MIN = -350;

// Defines decimal chunk width and its power of ten. Reading nine digits at once
// needs one bignum pass instead of nine.
u64 DEC_CHUNK = 9;
u64 DEC_CHUNK_BASE = 1000000000;
u64 DEC_BASE = 10;

// An arbitrary-precision unsigned integer: `len` limbs of 32 bits, least
// significant first, with no zero limb on top. A length of 0 is the value 0.
struct bignum {
    u32[BN_LIMBS] limb;
    u64 len;
}

// The number of bits of `v`, 0 for 0.
fn bits_of_u64(u64 v) u64 {
    u64 mut n = 0;
    u64 mut x = v;
    while (x != 0) {
        x = x >> 1;
        n += 1;
    }
    return n;
}

// Appends one limb above the others. The array is sized so that no caller
// reaches its end (BN_LIMBS), so a full array is a bug in this module.
fn bn_push(bignum mut* n, u32 v) void {
    if (n->len >= BN_LIMBS) {
        panic("flt.bn_push: a constant needed more limbs than the bignum has");
    }
    n->limb[n->len] = v;
    n->len += 1;
}

// Drops the zero limbs on top, so that `len` and bn_bits answer about the
// value and not about the history of the buffer.
fn bn_trim(bignum mut* n) void {
    while (n->len > 0 && n->limb[n->len - 1] == 0) {
        n->len -= 1;
    }
}

fn bn_set_u64(bignum mut* n, u64 v) void {
    n->len = 0;
    u64 mut x = v;
    while (x != 0) {
        bn_push(n, cast(x & LIMB_MASK, u32));
        x = x >> LIMB_BITS;
    }
}

// The 128-bit value `hi * 2^64 + lo`, which is how a product of two mantissas
// arrives.
fn bn_set_u128(bignum mut* n, u64 hi, u64 lo) void {
    bn_set_u64(n, lo);
    while (n->len < 2) {
        bn_push(n, 0);
    }
    bn_push(n, cast(hi & LIMB_MASK, u32));
    bn_push(n, cast(hi >> LIMB_BITS, u32));
    bn_trim(n);
}

fn bn_is_zero(bignum* n) bool {
    return n->len == 0;
}

// The number of bits of the value, 0 for 0.
fn bn_bits(bignum* n) u64 {
    if (n->len == 0) {
        return 0;
    }
    return (n->len - 1) * LIMB_BITS + bits_of_u64(cast(n->limb[n->len - 1], u64));
}

// Whether bit `i` is set, counting from the least significant.
fn bn_bit(bignum* n, u64 i) bool {
    u64 at = i / LIMB_BITS;
    if (at >= n->len) {
        return false;
    }
    return ((cast(n->limb[at], u64) >> (i % LIMB_BITS)) & 1) != 0;
}

// Sets the least significant bit: the next bit of the dividend in bn_div.
fn bn_set_bit0(bignum mut* n) void {
    if (n->len == 0) {
        bn_push(n, 1);
        return;
    }
    n->limb[0] = n->limb[0] | 1;
}

// n = n * mul + add, with both below 2^32. The product of two limbs plus a carry
// stays below 2^64, so the checked build does not trap here.
fn bn_mul_add(bignum mut* n, u64 mul, u64 add) void {
    u64 mut carry = add;
    u64 mut i = 0;
    while (i < n->len) {
        u64 cur = cast(n->limb[i], u64) * mul + carry;
        n->limb[i] = cast(cur & LIMB_MASK, u32);
        carry = cur >> LIMB_BITS;
        i += 1;
    }
    while (carry != 0) {
        bn_push(n, cast(carry & LIMB_MASK, u32));
        carry = carry >> LIMB_BITS;
    }
    bn_trim(n);
}

// a = a + b.
fn bn_add(bignum mut* a, bignum* b) void {
    while (a->len < b->len) {
        bn_push(a, 0);
    }
    u64 mut carry = 0;
    u64 mut i = 0;
    while (i < a->len) {
        u64 mut sum = cast(a->limb[i], u64) + carry;
        if (i < b->len) {
            sum += cast(b->limb[i], u64);
        }
        a->limb[i] = cast(sum & LIMB_MASK, u32);
        carry = sum >> LIMB_BITS;
        i += 1;
    }
    if (carry != 0) {
        bn_push(a, cast(carry, u32));
    }
    bn_trim(a);
}

// a = a - b, where a is at least b. A limb that borrows takes 2^32 from the
// limb above it, which is why the difference is formed in a u64.
fn bn_sub(bignum mut* a, bignum* b) void {
    if (bn_cmp(a, b) < 0) {
        panic("flt.bn_sub: the difference would be negative");
    }
    u64 mut borrow = 0;
    u64 mut i = 0;
    while (i < a->len) {
        u64 mut take = borrow;
        if (i < b->len) {
            take += cast(b->limb[i], u64);
        }
        u64 cur = cast(a->limb[i], u64);
        if (cur >= take) {
            a->limb[i] = cast(cur - take, u32);
            borrow = 0;
        } else {
            a->limb[i] = cast(cur + LIMB_BASE - take, u32);
            borrow = 1;
        }
        i += 1;
    }
    bn_trim(a);
}

// -1, 0 or 1 as a is below, equal to or above b.
fn bn_cmp(bignum* a, bignum* b) i32 {
    if (a->len != b->len) {
        if (a->len < b->len) {
            return -1;
        }
        return 1;
    }
    u64 mut i = a->len;
    while (i > 0) {
        i -= 1;
        if (a->limb[i] != b->limb[i]) {
            if (a->limb[i] < b->limb[i]) {
                return -1;
            }
            return 1;
        }
    }
    return 0;
}

// n = n << bits.
fn bn_shl(bignum mut* n, u64 bits) void {
    if (n->len == 0 || bits == 0) {
        return;
    }
    u64 whole = bits / LIMB_BITS;
    u64 part = bits % LIMB_BITS;
    u64 mut top = n->len + whole + 1;
    if (top > BN_LIMBS) {
        panic("flt.bn_shl: a constant needed more limbs than the bignum has");
    }
    u64 mut i = top;
    while (i > 0) {
        i -= 1;
        u64 mut v = 0;
        if (i >= whole) {
            u64 from = i - whole;
            if (from < n->len) {
                v = cast(n->limb[from], u64) << part;
            }
            if (part != 0 && from > 0 && from - 1 < n->len) {
                v = v | (cast(n->limb[from - 1], u64) >> (LIMB_BITS - part));
            }
        }
        n->limb[i] = cast(v & LIMB_MASK, u32);
    }
    n->len = top;
    bn_trim(n);
}

// n = n >> bits, discarding what leaves the bottom.
fn bn_shr(bignum mut* n, u64 bits) void {
    if (n->len == 0 || bits == 0) {
        return;
    }
    u64 whole = bits / LIMB_BITS;
    u64 part = bits % LIMB_BITS;
    if (whole >= n->len) {
        n->len = 0;
        return;
    }
    u64 keep = n->len - whole;
    u64 mut i = 0;
    while (i < keep) {
        u64 mut v = cast(n->limb[i + whole], u64) >> part;
        if (part != 0 && i + whole + 1 < n->len) {
            v = v | (cast(n->limb[i + whole + 1], u64) << (LIMB_BITS - part));
        }
        n->limb[i] = cast(v & LIMB_MASK, u32);
        i += 1;
    }
    n->len = keep;
    bn_trim(n);
}

// floor(num / den), which every caller has arranged to fit 64 bits, with
// `*sticky` true when the division leaves a remainder.
//
// The loop uses school division for `count` quotient bits. The remainder starts
// with dividend bits above them and takes one bit per step. It does not walk
// bits below the first quotient bit. The function limits division to 55 steps,
// even for a 3800-bit dividend.
fn bn_div(bignum* num, bignum* den, bool mut* sticky) u64 {
    if (bn_is_zero(den)) {
        panic("flt.bn_div: division by zero");
    }
    u64 nb = bn_bits(num);
    u64 db = bn_bits(den);
    if (nb < db) {
        *sticky = !bn_is_zero(num);
        return 0;
    }
    u64 count = nb - db + 1;
    if (count > 64) {
        panic("flt.bn_div: the quotient does not fit 64 bits");
    }
    bignum mut rem = bignum{};
    rem = *num;
    bn_shr(&rem, count);
    u64 mut q = 0;
    u64 mut i = count;
    while (i > 0) {
        i -= 1;
        bn_shl(&rem, 1);
        if (bn_bit(num, i)) {
            bn_set_bit0(&rem);
        }
        q = q << 1;
        if (bn_cmp(&rem, den) >= 0) {
            bn_sub(&rem, den);
            q += 1;
        }
    }
    *sticky = !bn_is_zero(&rem);
    return q;
}

// ---- rounding ----------------------------------------------------------------------

// The binary64 bits of m * 2^e, with m below 2^53 and the value inside the
// range of binary64. A binary64 subnormal keeps its exponent field at 0; every
// other value is normalized so that the top bit of m stands at bit 52.
fn f64_bits(u64 m, i64 e) u64 {
    if (m == 0) {
        return 0;
    }
    if (m < F64_HIDDEN && e == F64_EXP_MIN) {
        return m;
    }
    u64 shift = F64_MANT - bits_of_u64(m);
    u64 top = m << shift;
    i64 field = e - cast(shift, i64) + F64_BIAS;
    if (field <= 0 || field >= cast(F64_FIELD_INF, i64)) {
        panic("flt.f64_bits: the value is outside binary64");
    }
    return (cast(field, u64) << F64_FRAC_BITS) | (top & F64_FRAC_MASK);
}

// The value of finite binary64 bits as (-1)^neg * m * 2^e, with m == 0 for a
// zero of either sign.
fn flt_parts(u64 bits, bool mut* neg, u64 mut* m, i64 mut* e) void {
    *neg = (bits & F64_SIGN) != 0;
    u64 field = (bits >> F64_FRAC_BITS) & F64_FIELD_MASK;
    u64 frac = bits & F64_FRAC_MASK;
    if (field == F64_FIELD_INF) {
        panic("flt.flt_parts: an infinity or a NaN is not a constant");
    }
    if (field == 0) {
        *m = frac;
        *e = F64_EXP_MIN;
        return;
    }
    *m = frac | F64_HIDDEN;
    *e = cast(field, i64) - F64_BIAS;
}

// Rounds the exact rational (-1)^neg * num / den once to the selected format.
// Returns it as binary64 bits. Returns false for a non-finite result, which is a
// compile error.
//
// `tail` marks a nonzero amount below the last digit of `num`. The decimal reader
// sets it for discarded digits. It can only round a tie away from zero. `num`
// and `den` have an unspecified state because scaling writes into them.
//
// `est` brackets the value between 2^(est-1) and 2^(est+1). `k` scales it so the
// quotient holds the mantissa and one guard bit. For a subnormal value, that
// guard bit is one place below the least exponent. Division produces the
// quotient and sticky bit. Rounding uses nearest with ties to even.
fn round_ratio(bignum mut* num, bignum mut* den, bool neg, bool tail, bool is_f32,
                    u64 mut* out) bool {
    u64 mut mant = F64_MANT;
    i64 mut emin = F64_EXP_MIN;
    i64 mut emax = F64_EXP_MAX;
    if (is_f32) {
        mant = F32_MANT;
        emin = F32_EXP_MIN;
        emax = F32_EXP_MAX;
    }
    u64 mut sign = 0;
    if (neg) {
        sign = F64_SIGN;
    }
    if (bn_is_zero(num)) {
        *out = sign;
        return true;
    }
    i64 est = cast(bn_bits(num), i64) - cast(bn_bits(den), i64);
    i64 mut k = cast(mant, i64) + 1 - est;
    if (k > 1 - emin) {
        k = 1 - emin;
    }
    if (k > 0) {
        bn_shl(num, cast(k, u64));
    } else if (k < 0) {
        bn_shl(den, cast(0 - k, u64));
    }
    bool mut sticky = tail;
    bool mut rest = false;
    u64 q = bn_div(num, den, &rest);
    if (rest) {
        sticky = true;
    }
    u64 qbits = bits_of_u64(q);
    u64 mut extra = 1;
    if (qbits > mant + 1) {
        extra = qbits - mant;
    }
    if (extra > 2) {
        panic("flt.round_ratio: the quotient has more bits than the scaling allows");
    }
    u64 round = (q >> (extra - 1)) & 1;
    if (extra == 2 && (q & 1) != 0) {
        sticky = true;
    }
    u64 mut m = q >> extra;
    i64 mut e = cast(extra, i64) - k;
    if (round != 0 && (sticky || (m & 1) != 0)) {
        // Round to nearest, with ties to even.
        m += 1;
        if (m == (cast(1, u64) << mant)) {
            m = m >> 1;
            e += 1;
        }
    }
    if (m == 0) {
        // The value is below half the least subnormal and rounds to a zero of
        // its own sign.
        *out = sign;
        return true;
    }
    if (e > emax) {
        return false;
    }
    *out = sign | f64_bits(m, e);
    return true;
}

// ---- reading a literal -------------------------------------------------------------

// The digits of a literal and where its decimal point stands: the value is
// 0.<digit[0..len]> * 10^point. `tail` records a nonzero digit below the
// last one kept.
struct decimal {
    u8[FLT_MAX_DIGITS] digit;
    u64 len;
    i64 point;
    bool tail;
}

// The exponent a literal is read to before it saturates. Any value past it puts
// the decimal point far outside FLT_POINT_MIN and FLT_POINT_MAX, so the answer is
// the same and the accumulation cannot overflow.
i64 FLT_EXP_LIMIT = 100000;

fn byte_of(char c) i64 {
    return cast(c, i64);
}

fn is_digit(i64 c) bool {
    return c >= byte_of('0') && c <= byte_of('9');
}

// Reads the digits, point, and exponent of a float literal. The lexer already
// checked its shape. Any other byte breaks the precondition and is not a program
// error.
fn read_decimal(string text, decimal mut* d) void {
    d->len = 0;
    d->point = 0;
    d->tail = false;
    bool mut seen_point = false;
    u64 mut i = 0;
    while (i < text.len) {
        i64 c = byte_of(text[i]);
        if (c == byte_of('e') || c == byte_of('E')) {
            break;
        }
        i += 1;
        if (c == byte_of('_')) {
            continue;
        }
        if (c == byte_of('.')) {
            seen_point = true;
            continue;
        }
        if (!is_digit(c)) {
            panic("flt.read_decimal: the text is not a float literal");
        }
        u64 v = cast(c - byte_of('0'), u64);
        if (d->len == 0 && v == 0) {
            // A zero above the first significant digit adds no digit; below
            // the point it moves the point instead.
            if (seen_point) {
                d->point -= 1;
            }
            continue;
        }
        if (d->len < FLT_MAX_DIGITS) {
            d->digit[d->len] = cast(v, u8);
            d->len += 1;
        } else if (v != 0) {
            d->tail = true;
        }
        if (!seen_point) {
            d->point += 1;
        }
    }
    if (i >= text.len) {
        return;
    }
    read_exponent(text, i + 1, d);
}

// The `e` part of a literal, starting at `from`: an optional sign and the
// digits, added to the decimal point.
fn read_exponent(string text, u64 from, decimal mut* d) void {
    u64 mut i = from;
    bool mut neg = false;
    if (i < text.len && (text[i] == '+' || text[i] == '-')) {
        neg = text[i] == '-';
        i += 1;
    }
    i64 mut value = 0;
    while (i < text.len) {
        i64 c = byte_of(text[i]);
        i += 1;
        if (c == byte_of('_')) {
            continue;
        }
        if (!is_digit(c)) {
            panic("flt.read_exponent: the text is not a float literal");
        }
        if (value < FLT_EXP_LIMIT) {
            value = value * 10 + (c - byte_of('0'));
        }
    }
    if (neg) {
        d->point -= value;
    } else {
        d->point += value;
    }
}

// The digits as an integer, nine at a time.
fn decimal_digits(decimal* d, bignum mut* n) void {
    bn_set_u64(n, 0);
    u64 mut i = 0;
    while (i < d->len) {
        u64 mut chunk = 0;
        u64 mut base = 1;
        u64 mut taken = 0;
        while (taken < DEC_CHUNK && i < d->len) {
            chunk = chunk * DEC_BASE + cast(d->digit[i], u64);
            base = base * DEC_BASE;
            taken += 1;
            i += 1;
        }
        bn_mul_add(n, base, chunk);
    }
}

// n = n * 10^e.
fn bn_mul_pow10(bignum mut* n, u64 e) void {
    u64 mut left = e;
    while (left >= DEC_CHUNK) {
        bn_mul_add(n, DEC_CHUNK_BASE, 0);
        left -= DEC_CHUNK;
    }
    while (left > 0) {
        bn_mul_add(n, DEC_BASE, 0);
        left -= 1;
    }
}

/// Parses an unsigned literal as binary64 bits.
/// Returns false when the result is not finite. Unary minus supplies the sign.
fn flt_parse(string text, u64 mut* out) bool {
    decimal mut d = decimal{};
    read_decimal(text, &d);
    *out = 0;
    if (d.len == 0) {
        // Every digit was a zero.
        return true;
    }
    if (d.point > FLT_POINT_MAX) {
        return false;
    }
    if (d.point < FLT_POINT_MIN) {
        // Below half the least subnormal, so the value rounds to zero.
        return true;
    }
    bignum mut num = bignum{};
    bignum mut den = bignum{};
    decimal_digits(&d, &num);
    bn_set_u64(&den, 1);
    i64 e10 = d.point - cast(d.len, i64);
    if (e10 > 0) {
        bn_mul_pow10(&num, cast(e10, u64));
    } else if (e10 < 0) {
        bn_mul_pow10(&den, cast(0 - e10, u64));
    }
    return round_ratio(&num, &den, false, d.tail, false, out);
}

// ---- the operations a constant folder needs ----------------------------------------

// (-1)^neg * value * 2^e, rounded to the format `is_f32` names.
fn round_scaled(bignum mut* value, i64 e, bool neg, bool is_f32, u64 mut* out) bool {
    bignum mut den = bignum{};
    bn_set_u64(&den, 1);
    if (e > 0) {
        bn_shl(value, cast(e, u64));
    } else if (e < 0) {
        bn_shl(&den, cast(0 - e, u64));
    }
    return round_ratio(value, &den, neg, false, is_f32, out);
}

// The 128-bit product of two u64 values, in halves: the mantissas a
// multiplication folds are 53 bits each and their product is 106. The two
// helpers keep each body below the effect bound of the ownership summary
// (`spec/fir.md` 14.1); no sum or product here can overflow.
fn mul_u64(u64 a, u64 b, u64 mut* hi, u64 mut* lo) void {
    u64 a0 = a & LIMB_MASK;
    u64 a1 = a >> LIMB_BITS;
    u64 b0 = b & LIMB_MASK;
    u64 b1 = b >> LIMB_BITS;
    u64 low = a0 * b0;
    u64 cross1 = a0 * b1;
    u64 cross2 = a1 * b0;
    u64 mid = mid_sum(low, cross1, cross2);
    *lo = (low & LIMB_MASK) | ((mid & LIMB_MASK) << LIMB_BITS);
    *hi = high_half(a1 * b1, cross1, cross2, mid);
}

// The middle limb of the product, with its carry above LIMB_BITS.
fn mid_sum(u64 low, u64 cross1, u64 cross2) u64 {
    return (low >> LIMB_BITS) + (cross1 & LIMB_MASK) + (cross2 & LIMB_MASK);
}

// The high half of the product from its high limb, cross terms and middle limb.
fn high_half(u64 high, u64 cross1, u64 cross2, u64 mid) u64 {
    return high + (cross1 >> LIMB_BITS) + (cross2 >> LIMB_BITS) + (mid >> LIMB_BITS);
}

/// Returns true for positive or negative zero.
fn flt_is_zero(u64 bits) bool {
    return (bits & F64_MAG_MASK) == 0;
}

/// Flips the sign bit. This preserves the difference between positive and negative zero.
fn flt_neg(u64 bits) u64 {
    return bits ^ F64_SIGN;
}

/// Adds `a` and `b` and rounds once to the selected format.
/// Returns false when the result is not finite.
fn flt_add(u64 a, u64 b, bool is_f32, u64 mut* out) bool {
    bool mut a_neg = false;
    u64 mut a_mant = 0;
    i64 mut a_exp = 0;
    flt_parts(a, &a_neg, &a_mant, &a_exp);
    bool mut b_neg = false;
    u64 mut b_mant = 0;
    i64 mut b_exp = 0;
    flt_parts(b, &b_neg, &b_mant, &b_exp);
    if (a_mant == 0 && b_mant == 0) {
        // the sum is -0.0 only when both are, +0.0 otherwise
        *out = 0;
        if (a_neg && b_neg) {
            *out = F64_SIGN;
        }
        return true;
    }
    i64 mut e = a_exp;
    if (b_exp < e) {
        e = b_exp;
    }
    bignum mut x = bignum{};
    bignum mut y = bignum{};
    bn_set_u64(&x, a_mant);
    bn_shl(&x, cast(a_exp - e, u64));
    bn_set_u64(&y, b_mant);
    bn_shl(&y, cast(b_exp - e, u64));
    bool mut neg = a_neg;
    if (a_neg == b_neg) {
        bn_add(&x, &y);
    } else {
        i32 order = bn_cmp(&x, &y);
        if (order == 0) {
            *out = 0;
            return true;
        }
        if (order > 0) {
            bn_sub(&x, &y);
        } else {
            bn_sub(&y, &x);
            x = y;
            neg = b_neg;
        }
    }
    return round_scaled(&x, e, neg, is_f32, out);
}

/// Subtracts `b` from `a` and rounds once to the selected format.
/// Returns false when the result is not finite.
fn flt_sub(u64 a, u64 b, bool is_f32, u64 mut* out) bool {
    return flt_add(a, flt_neg(b), is_f32, out);
}

/// Multiplies two values and rounds once to the selected format.
/// Returns false when the result is not finite.
fn flt_mul(u64 a, u64 b, bool is_f32, u64 mut* out) bool {
    bool mut a_neg = false;
    u64 mut a_mant = 0;
    i64 mut a_exp = 0;
    flt_parts(a, &a_neg, &a_mant, &a_exp);
    bool mut b_neg = false;
    u64 mut b_mant = 0;
    i64 mut b_exp = 0;
    flt_parts(b, &b_neg, &b_mant, &b_exp);
    bool neg = a_neg != b_neg;
    u64 mut sign = 0;
    if (neg) {
        sign = F64_SIGN;
    }
    if (a_mant == 0 || b_mant == 0) {
        // a product with a zero takes the two signs combined
        *out = sign;
        return true;
    }
    u64 mut high = 0;
    u64 mut low = 0;
    mul_u64(a_mant, b_mant, &high, &low);
    bignum mut x = bignum{};
    bn_set_u128(&x, high, low);
    return round_scaled(&x, a_exp + b_exp, neg, is_f32, out);
}

/// Divides `a` by `b` and rounds once to the selected format.
/// Returns false when the result is not finite.
fn flt_div(u64 a, u64 b, bool is_f32, u64 mut* out) bool {
    bool mut a_neg = false;
    u64 mut a_mant = 0;
    i64 mut a_exp = 0;
    flt_parts(a, &a_neg, &a_mant, &a_exp);
    bool mut b_neg = false;
    u64 mut b_mant = 0;
    i64 mut b_exp = 0;
    flt_parts(b, &b_neg, &b_mant, &b_exp);
    bool neg = a_neg != b_neg;
    if (b_mant == 0) {
        return false;
    }
    if (a_mant == 0) {
        *out = 0;
        if (neg) {
            *out = F64_SIGN;
        }
        return true;
    }
    bignum mut num = bignum{};
    bignum mut den = bignum{};
    bn_set_u64(&num, a_mant);
    bn_set_u64(&den, b_mant);
    i64 e = a_exp - b_exp;
    if (e > 0) {
        bn_shl(&num, cast(e, u64));
    } else if (e < 0) {
        bn_shl(&den, cast(0 - e, u64));
    }
    return round_ratio(&num, &den, neg, false, is_f32, out);
}

/// Returns -1, 0, or 1 when `a` is below, equal to, or above `b`.
/// Positive and negative zero compare equal.
fn flt_cmp(u64 a, u64 b) i32 {
    if (flt_is_zero(a) && flt_is_zero(b)) {
        return 0;
    }
    bool a_neg = (a & F64_SIGN) != 0;
    bool b_neg = (b & F64_SIGN) != 0;
    if (a_neg != b_neg) {
        if (a_neg) {
            return -1;
        }
        return 1;
    }
    u64 a_mag = a & F64_MAG_MASK;
    u64 b_mag = b & F64_MAG_MASK;
    if (a_mag == b_mag) {
        return 0;
    }
    bool mut below = a_mag < b_mag;
    if (a_neg) {
        // Below zero the larger pattern is the smaller value.
        below = !below;
    }
    if (below) {
        return -1;
    }
    return 1;
}

/// Converts a signed magnitude to the selected format and rounds to nearest.
/// Returns false when the result is not finite.
fn flt_from_int(bool neg, u64 mag, bool is_f32, u64 mut* out) bool {
    bignum mut num = bignum{};
    bignum mut den = bignum{};
    bn_set_u64(&num, mag);
    bn_set_u64(&den, 1);
    return round_ratio(&num, &den, neg, false, is_f32, out);
}

/// The binary64 value rounded to binary32, held as the binary64 of that binary32;
/// false when it is not finite in binary32. The conversion the other way is the
/// identity, since the value is kept in binary64 already.
fn flt_to_f32(u64 bits, u64 mut* out) bool {
    bool mut neg = false;
    u64 mut mant = 0;
    i64 mut exp = 0;
    flt_parts(bits, &neg, &mant, &exp);
    if (mant == 0) {
        *out = bits & F64_SIGN;
        return true;
    }
    bignum mut num = bignum{};
    bn_set_u64(&num, mant);
    return round_scaled(&num, exp, neg, true, out);
}

/// The value truncated toward zero as a sign and a magnitude; false when the
/// magnitude is past 2^64 - 1, which the caller saturates.
fn flt_to_int(u64 bits, bool mut* neg, u64 mut* mag) bool {
    u64 mut mant = 0;
    i64 mut exp = 0;
    flt_parts(bits, neg, &mant, &exp);
    *mag = 0;
    if (mant == 0) {
        return true;
    }
    if (exp >= 0) {
        if (bits_of_u64(mant) + cast(exp, u64) > 64) {
            return false;
        }
        *mag = mant << cast(exp, u64);
        return true;
    }
    u64 down = cast(0 - exp, u64);
    if (down >= 64) {
        // the integer part is zero; a cast truncates toward zero
        return true;
    }
    *mag = mant >> down;
    return true;
}

/// Appends `0x` and the 16 hexadecimal digits of the binary64 pattern.
/// LLVM uses this form for `double` and exact `float` constants.
fn flt_hex(u64 bits, strbuf.str_buf mut* out) void {
    strbuf.append(out, "0x");
    u64 mut i = HEX_COUNT;
    while (i > 0) {
        i -= 1;
        strbuf.push(out, HEX_DIGITS[(bits >> (i * HEX_BITS)) & HEX_MASK]);
    }
}
