/// Builds identifier records for editor features.

import ast;
import containers;
import diag;
import json;
import modules;
import scope;
import std.strbuf;
import types;

// The first non-zero capacity of the record vector; growth doubles from there.
u64 ENTRY_MIN_CAP = 64;

// One identifier occurrence. `loc` identifies the name token.
// `ty` is empty for names without a value type. `has_type` is false after a type error.
// `is_decl` marks a declaration. `has_decl` is false only for builtins.
struct entry {
    diag.loc loc;
    string name;
    ast.sym_kind kind;
    string ty;
    bool has_type;
    bool is_decl;
    bool has_decl;
    diag.loc decl;
}

struct index {
    entry mut@ own entries; // items[..count] are the records, in that order
    u64 count;
    containers.pool pool;
    strbuf.str_buf msg;      // the buffer a spelling is built in
}

fn create() index {
    return index{};
}

fn free(index mut* ix) void {
    del(ix->entries);
    ix->count = 0;
    containers.pool_free(&ix->pool);
    strbuf.free(&ix->msg);
}

fn count(index* ix) u64 {
    return ix->count;
}

// Returns record `i`. Panics when `i` is not less than `count`.
fn at(index* ix, u64 i) entry {
    if (i >= ix->count) {
        panic("index.at: index out of range");
    }
    return ix->entries[i];
}

// Ensures room for one more record, growing to the largest of ENTRY_MIN_CAP
// and twice the capacity.
fn reserve(index mut* ix) void {
    if (ix->count < ix->entries.len) {
        return;
    }
    u64 mut cap = ENTRY_MIN_CAP;
    if (ix->entries.len >= cap) {
        // nothing here may detect an overflow by performing one
        if (ix->entries.len > containers.U64_MAX / 2) {
            panic("index.reserve: capacity overflow");
        }
        cap = ix->entries.len * 2;
    }
    entry mut@ own bigger = new(entry, cap);
    u64 mut i = 0;
    while (i < ix->count) {
        bigger[i] = ix->entries[i];
        i += 1;
    }
    del(ix->entries);
    ix->entries = move(bigger);
}

// ---- one record ----------------------------------------------------------------

// Whether the name denotes something with a type to show. A module, a struct
// name, an enum name and a builtin denote no value type, so their records
// carry the empty spelling.
fn has_value_type(ast.sym* s) bool {
    return s->ty != null && s->kind != ast.sym_kind.s_module &&
           s->kind != ast.sym_kind.s_struct && s->kind != ast.sym_kind.s_enum;
}

// The type of the name as a declaration of it would spell it, level-0 mutability included. A
// declaration that failed to check has a poisoned type. Its record has no type. The client
// distinguishes this from a name with an empty type spelling.
fn type_spelling(index mut* ix, ast.sym* s) string {
    if (!has_value_type(s)) {
        return "";
    }
    strbuf.clear(&ix->msg);
    types.type_to_str_decl(s->ty, s->mut0, &ix->msg);
    return containers.pool_intern(&ix->pool, strbuf.view(&ix->msg));
}

// Where the declaration of the name is. A file declares a module, which has no name token. Its
// range is empty at 1:1. Go-to-definition on a module qualifier opens the module.
fn declaration_range(ast.sym* s) diag.loc {
    if (s->decl.file.len > 0) {
        return s->decl;
    }
    return diag.loc_make(s->node->loc.file, 1, 1);
}

// Whether `a` begins before `b`: line, then byte column.
fn starts_before(diag.loc a, diag.loc b) bool {
    if (a.line != b.line) {
        return a.line < b.line;
    }
    return a.col < b.col;
}

// Returns whether the occurrence is an import `as` alias. The alias declares its name in this
// module, but binds a declaration elsewhere. A whole-module alias uses the import node. An item
// alias uses the item. An import without an alias introduces the name its declaration already has,
// so it is a use.
fn is_import_alias(ast.node* parent, ast.node* n) bool {
    if (parent == null) {
        return false;
    }
    // Reads both children into immutable bindings. The `==` operator lends `own` only. Thus, it
    // cannot compare `node mut*` with `node*`.
    if (parent->kind == ast.ast_kind.k_import) {
        ast.node* alias = parent->b;
        return n == alias;
    }
    if (parent->kind == ast.ast_kind.k_import_item) {
        ast.node* alias = parent->a;
        return n == alias;
    }
    return false;
}

fn record(index mut* ix, ast.node* n, ast.node* parent, ast.sym* s) void {
    reserve(ix);
    entry mut e = entry{};
    // the name token, never the construct's first one
    e.loc = n->name_loc;
    e.name = n->name;
    e.kind = s->kind;
    e.ty = type_spelling(ix, s);
    e.has_type = !s->error;
    // `sym->node` is the declaring node. The occurrence on it is the declaration (ast.ft). An alias
    // declares its own name here.
    e.is_decl = cast(s->node, ast.node*) == n || is_import_alias(parent, n);
    // a builtin is declared by no source
    e.has_decl = s->node != null;
    e.decl = diag.loc_make("", 1, 1);
    if (e.has_decl) {
        e.decl = declaration_range(s);
    }
    ix->entries[ix->count] = e;
    ix->count += 1;
}

// ---- the walk ------------------------------------------------------------------

// `parent` is the containing node. It distinguishes an `as` alias from an ordinary occurrence. It
// is null at the module node.
fn walk(index mut* ix, ast.node* n, ast.node* parent, modules.module* m) void {
    if (n == null) {
        return;
    }
    if (n->kind == ast.ast_kind.k_compile_if) {
        // The selector resolved the reached condition names.
        // An inactive branch contributes no occurrence.
        ast.node* mut current = n;
        while (current != null && current->kind == ast.ast_kind.k_compile_if) {
            walk(ix, current->a, current, m);
            if ((current->flags & ast.FLAG_SELECT_THEN) != 0) {
                walk(ix, current->b, current, m);
                return;
            }
            if (current->c == null) {
                return;
            }
            if (current->c->kind != ast.ast_kind.k_compile_if) {
                walk(ix, current->c, current, m);
                return;
            }
            current = current->c;
        }
        return;
    }
    // A node with a symbol but no name token is not an occurrence. The module node carries the
    // module record. The import node carries the binding record. The visible name is on its path
    // segment or alias (ast.ft).
    ast.sym* mut resolved = n->sym;
    if (resolved == null && n->kind == ast.ast_kind.k_ident
        && (n->flags & ast.FLAG_SELECT_REF) != 0) {
        scope.binding* b = scope.find(&m->names, n->name);
        if (b != null && b->node != null) {
            resolved = b->node->sym;
        }
    }
    if (resolved != null && n->name_loc.file.len > 0) {
        record(ix, n, parent, resolved);
    }
    walk(ix, n->a, n, m);
    walk(ix, n->b, n, m);
    walk(ix, n->c, n, m);
    walk(ix, n->d, n, m);
    u64 mut i = 0;
    while (i < ast.ast_len(n)) {
        walk(ix, ast.ast_child(n, i), n, m);
        i += 1;
    }
}

// Orders the records added since `start` by the start of the occurrence. The walk visits a parent
// before its children. Most records are already in place. Only a `.` or import path moves one back.
// Insertion sort preserves walk order for records at one position.
fn sort_from(index mut* ix, u64 start) void {
    if (ix->count == 0) {
        return;
    }
    u64 mut i = start + 1;
    while (i < ix->count) {
        entry e = ix->entries[i];
        u64 mut j = i;
        while (j > start && starts_before(e.loc, ix->entries[j - 1].loc)) {
            ix->entries[j] = ix->entries[j - 1];
            j -= 1;
        }
        ix->entries[j] = e;
        i += 1;
    }
}

// One file's records, grouped and ordered. A module that did not parse was not
// checked either, so it has no annotation to read.
fn index_module(index mut* ix, modules.module* m) void {
    if (!m->parsed || m->ast == null) {
        return;
    }
    u64 start = ix->count;
    walk(ix, m->ast, null, m);
    sort_from(ix, start);
}

// Appends resolved identifiers from each checked module in `set`.
fn build(index mut* ix, modules.module_set* set) void {
    // Uses the pass order from modules.ft. An imported module precedes its importers. Unordered
    // loaded modules follow, so import failures do not prevent indexing. The index's file order is
    // that order, so it is read from one place and not rebuilt here.
    u64 mut i = 0;
    while (i < modules.pass_count(set)) {
        index_module(ix, modules.pass_at(set, i));
        i += 1;
    }
}

// ---- the document --------------------------------------------------------------

// A range as a diagnostic's is written: the file and the 1-based byte columns
// of both ends, the end exclusive.
fn write_range(json.writer mut* j, diag.loc l) void {
    json.json_key(j, "file");
    json.json_str(j, l.file);
    json.json_key(j, "line");
    json.json_uint(j, cast(l.line, u64));
    json.json_key(j, "col");
    json.json_uint(j, cast(l.col, u64));
    json.json_key(j, "end_line");
    json.json_uint(j, cast(l.end_line, u64));
    json.json_key(j, "end_col");
    json.json_uint(j, cast(l.end_col, u64));
}

// Writes the records as the "symbols" array of the document, the key already
// written by the caller.
fn write_json(index* ix, json.writer mut* j) void {
    json.json_array_begin(j);
    u64 mut i = 0;
    while (i < ix->count) {
        entry e = at(ix, i);
        json.json_object_begin(j);
        write_range(j, e.loc);
        json.json_key(j, "name");
        json.json_str(j, e.name);
        // the kind as a diagnostic spells it, "enum member"
        json.json_key(j, "kind");
        json.json_str(j, ast.sym_kind_name(e.kind));
        json.json_key(j, "type");
        if (e.has_type) {
            json.json_str(j, e.ty);
        } else {
            // no type to show, so the client renders it unknown
            json.json_null(j);
        }
        json.json_key(j, "is_decl");
        json.json_bool(j, e.is_decl);
        json.json_key(j, "decl");
        if (e.has_decl) {
            json.json_object_begin(j);
            write_range(j, e.decl);
            json.json_object_end(j);
        } else {
            json.json_null(j);
        }
        json.json_object_end(j);
        i += 1;
    }
    json.json_array_end(j);
}
