// index: the identifier index of the check mode (toolchain.md 9.1).
// D20.3
//
// One record per identifier occurrence the checker resolved, which is what an
// editor answers hover and go-to-definition from. The walk reads the `sym`
// annotation of every node of every module that was checked, so it runs after
// the front end and before the analysis is freed: a record lives as long as
// the checker that made it (ast.ft). What it produces borrows from the trees
// too -- a name is a view into a module's source and every file name is the
// module set's -- and owns only the type spellings it builds, so the whole
// index dies with the run that made it.
//
// Records come out ordered by file, an imported module before its importers,
// and within a file by the start of the occurrence.
// D9.10, D20.3
//
// Two differences from src/bootstrap/index.c, both of them storage.
// src/bootstrap/index.c allocates one record per occurrence and keeps a vector
// of pointers to them; here the records are values in one grown span and `at`
// hands one out by value, as diag.record_at does, so an index owns two
// allocations and not one per record. And a violated precondition panics where
// the C ends the process.
// D13.3, D20.5
//
// Re-entrancy: an index is a value the caller owns, every allocation of it
// dies with it, and nothing here is module-level state.
// D20.5
//
// Dispatch: none. The walk is the plain recursion src/bootstrap/index.c
// writes, not a table of function pointers.
// D3.10
import ast;
import containers;
import diag;
import json;
import modules;
import scope;
import std.strbuf;
import types;

/// The first non-zero capacity of the record vector; growth doubles from there.
u64 ENTRY_MIN_CAP = 64;

/// One occurrence of one name. `loc` is that name token's own range and never the
/// construct's first token; `name` is the identifier as it is spelled here, so an
/// `as` alias reads as the alias; `ty` is what a declaration of it would spell,
/// empty for a name that denotes no value type and absent, which `has_type` says,
/// when the declaration failed to check; `is_decl` marks an occurrence that
/// declares the name in this module, the `as` alias of an import included; `decl`
/// is the declaring name's range, which `has_decl` denies to a builtin alone,
/// since no source declares one. `type` is a keyword, so the slot the C calls
/// `type` is `ty`, as ast.ft spells it.
/// D2.4, D5.2, D9.3, D12.2, D20.3, D20.4
struct entry {
    diag.loc loc;
    string name;
    ast.sym_kind kind;
    string ty;
    bool has_type;
    bool is_decl;
    bool has_decl;
    diag.loc decl;
}

/// The records of one run. index{} is a valid empty index, so a struct holding
/// one is initialized with {}.
struct index {
    entry mut@ own entries; // D20.3: items[..count] are the records, in that order
    u64 count;
    containers.pool pool;    // owns every type spelling
    strbuf.str_buf msg;      // the buffer a spelling is built in
}

/// The empty index; allocates nothing.
fn create() index {
    return index{};
}

/// Releases every record and every spelling; the index is empty and usable
/// afterwards.
fn free(index mut* ix) void {
    del(ix->entries);
    ix->count = 0;
    containers.pool_free(&ix->pool);
    strbuf.free(&ix->msg);
}

/// The records, in the index's own order.
/// D20.3
fn count(index* ix) u64 {
    return ix->count;
}

/// The record at `i`, by value: appending a record moves the array, so a pointer
/// into it would dangle at the next walk. An index at or past count is a violated
/// precondition and panics.
/// D13.3
fn at(index* ix, u64 i) entry {
    if (i >= ix->count) {
        panic("index.at: index out of range");
    }
    return ix->entries[i];
}

/// Ensures room for one more record, growing to the largest of ENTRY_MIN_CAP
/// and twice the capacity.
fn reserve(index mut* ix) void {
    if (ix->count < ix->entries.len) {
        return;
    }
    u64 mut cap = ENTRY_MIN_CAP;
    if (ix->entries.len >= cap) {
        // D11.1: nothing here may detect an overflow by performing one
        if (ix->entries.len > containers.U64_MAX / 2) {
            panic("index.reserve: capacity overflow");
        }
        cap = ix->entries.len * 2;
    }
    entry mut@ own bigger = new(entry, cap);
    u64 mut i = 0;
    while (i < ix->count) {
        bigger[i] = ix->entries[i];
        i += 1;
    }
    del(ix->entries);
    ix->entries = move(bigger);
}

// ---- one record ----------------------------------------------------------------
// D20.3

/// Whether the name denotes something with a type to show. A module, a struct
/// name, an enum name and a builtin denote no value type, so their records
/// carry the empty spelling.
/// D20.3
fn has_value_type(ast.sym* s) bool {
    return s->ty != null && s->kind != ast.sym_kind.s_module &&
           s->kind != ast.sym_kind.s_struct && s->kind != ast.sym_kind.s_enum;
}

/// The type of the name as a declaration of it would spell it, level-0 mutability
/// included. A declaration that failed to check has a poisoned type, which says
/// nothing a reader wants, so its record carries no type at all rather than the
/// empty spelling of a name that has none: the two cases are told apart by the
/// client.
/// D5.2, D5.3, D14.2, D20.3
fn type_spelling(index mut* ix, ast.sym* s) string {
    if (!has_value_type(s)) {
        return "";
    }
    strbuf.clear(&ix->msg);
    types.type_to_str_decl(s->ty, s->mut0, &ix->msg);
    return containers.pool_intern(&ix->pool, strbuf.view(&ix->msg));
}

/// Where the declaration of the name is. A module is declared by a file and has
/// no name token, so it is the empty range at 1:1 of that file, which is the
/// position for what has none, and go-to-definition on a module qualifier opens
/// the module.
/// D9.1, D14.2, D20.3
fn declaration_range(ast.sym* s) diag.loc {
    if (s->decl.file.len > 0) {
        return s->decl;
    }
    return diag.loc_make(s->node->loc.file, 1, 1);
}

/// Whether `a` begins before `b`: line, then byte column.
/// D20.4
fn starts_before(diag.loc a, diag.loc b) bool {
    if (a.line != b.line) {
        return a.line < b.line;
    }
    return a.col < b.col;
}

/// Whether the occurrence is the `as` alias of an import, which declares that
/// name in this module while the declaration it binds stands elsewhere: the alias
/// of a whole-module import hangs on the import node and the alias of an item on
/// the item. An import without an alias introduces the name its declaration
/// already has, so it is a use.
/// D9.3, D20.3
fn is_import_alias(ast.node* parent, ast.node* n) bool {
    if (parent == null) {
        return false;
    }
    // The two children are read into immutable bindings: `==` lends `own` and
    // nothing else, so a `node mut*` and a `node*` are not comparable.
    // D17.4
    if (parent->kind == ast.ast_kind.k_import) {
        ast.node* alias = parent->b;
        return n == alias;
    }
    if (parent->kind == ast.ast_kind.k_import_item) {
        ast.node* alias = parent->a;
        return n == alias;
    }
    return false;
}

fn record(index mut* ix, ast.node* n, ast.node* parent, ast.sym* s) void {
    reserve(ix);
    entry mut e = entry{};
    // D20.4: the name token, never the construct's first one
    e.loc = n->name_loc;
    e.name = n->name;
    e.kind = s->kind;
    e.ty = type_spelling(ix, s);
    // D20.3
    e.has_type = !s->error;
    // `sym->node` is the declaring node, so the declaration is the occurrence
    // that stands on it (ast.ft), and an alias declares its own name here.
    e.is_decl = cast(s->node, ast.node*) == n || is_import_alias(parent, n);
    // D12.2, D20.3: a builtin is declared by no source
    e.has_decl = s->node != null;
    e.decl = diag.loc_make("", 1, 1);
    if (e.has_decl) {
        e.decl = declaration_range(s);
    }
    ix->entries[ix->count] = e;
    ix->count += 1;
}

// ---- the walk ------------------------------------------------------------------

/// `parent` is the node this one hangs on, which is what tells an `as` alias
/// from an ordinary occurrence; it is null at the module node.
/// D9.3
fn walk(index mut* ix, ast.node* n, ast.node* parent, modules.module* m) void {
    if (n == null) {
        return;
    }
    if (n->kind == ast.ast_kind.k_compile_if) {
        // The selector resolved the reached condition names.
        // An inactive branch contributes no occurrence.
        // D20.3, D21.2
        ast.node* mut current = n;
        while (current != null && current->kind == ast.ast_kind.k_compile_if) {
            walk(ix, current->a, current, m);
            if ((current->flags & ast.FLAG_SELECT_THEN) != 0) {
                walk(ix, current->b, current, m);
                return;
            }
            if (current->c == null) {
                return;
            }
            if (current->c->kind != ast.ast_kind.k_compile_if) {
                walk(ix, current->c, current, m);
                return;
            }
            current = current->c;
        }
        return;
    }
    // A node with a symbol but no name token of its own is not an occurrence of
    // anything: the module node carries the module's record, and the import node the
    // binding's, while the name a reader sees is on the path segment or on the alias
    // beside them (ast.ft).
    // D20.3
    ast.sym* mut resolved = n->sym;
    if (resolved == null && n->kind == ast.ast_kind.k_ident
        && (n->flags & ast.FLAG_SELECT_REF) != 0) {
        scope.binding* b = scope.find(&m->names, n->name);
        if (b != null && b->node != null) {
            resolved = b->node->sym;
        }
    }
    if (resolved != null && n->name_loc.file.len > 0) {
        record(ix, n, parent, resolved);
    }
    walk(ix, n->a, n, m);
    walk(ix, n->b, n, m);
    walk(ix, n->c, n, m);
    walk(ix, n->d, n, m);
    u64 mut i = 0;
    while (i < ast.ast_len(n)) {
        walk(ix, ast.ast_child(n, i), n, m);
        i += 1;
    }
}

/// Orders the records added since `start` by the start of the occurrence. The
/// walk visits a parent before its children, so a record is almost always in place
/// already and only a `.` or an import path moves one back; insertion sort pays
/// for the moves it makes and nothing more, and keeps the walk's order between two
/// records at one position.
/// D20.3
fn sort_from(index mut* ix, u64 start) void {
    if (ix->count == 0) {
        return;
    }
    u64 mut i = start + 1;
    while (i < ix->count) {
        entry e = ix->entries[i];
        u64 mut j = i;
        while (j > start && starts_before(e.loc, ix->entries[j - 1].loc)) {
            ix->entries[j] = ix->entries[j - 1];
            j -= 1;
        }
        ix->entries[j] = e;
        i += 1;
    }
}

/// One file's records, grouped and ordered. A module that did not parse was not
/// checked either, so it has no annotation to read.
/// D20.3, D14.2
fn index_module(index mut* ix, modules.module* m) void {
    if (!m->parsed || m->ast == null) {
        return;
    }
    u64 start = ix->count;
    walk(ix, m->ast, null, m);
    sort_from(ix, start);
}

/// Walks every module of `set` the checker checked and records what it resolved.
/// The set and the checker that annotated it must both still be alive, since every
/// record is read out of an annotation (ast.ft); the records are appended to
/// whatever the index already holds.
/// D20.3
fn build(index mut* ix, modules.module_set* set) void {
    // The pass order of modules.ft, which is the order the checker used: an imported
    // module before its importers, then the modules the loader read but never
    // ordered, so a file being edited is indexed whatever its imports do. The index's
    // file order is that order, so it is read from one place and not rebuilt here.
    // D9.10, D14.2, D20.1, D20.3
    u64 mut i = 0;
    while (i < modules.pass_count(set)) {
        index_module(ix, modules.pass_at(set, i));
        i += 1;
    }
}

// ---- the document --------------------------------------------------------------
// D20.2, D20.3

/// A range as a diagnostic's is written: the file and the 1-based byte columns
/// of both ends, the end exclusive.
/// D20.2, D20.4
fn write_range(json.writer mut* j, diag.loc l) void {
    json.json_key(j, "file");
    json.json_str(j, l.file);
    json.json_key(j, "line");
    json.json_uint(j, cast(l.line, u64));
    json.json_key(j, "col");
    json.json_uint(j, cast(l.col, u64));
    json.json_key(j, "end_line");
    json.json_uint(j, cast(l.end_line, u64));
    json.json_key(j, "end_col");
    json.json_uint(j, cast(l.end_col, u64));
}

/// Writes the records as the "symbols" array of the document, the key already
/// written by the caller.
/// D20.2, D20.3
fn write_json(index* ix, json.writer mut* j) void {
    json.json_array_begin(j);
    u64 mut i = 0;
    while (i < ix->count) {
        entry e = at(ix, i);
        json.json_object_begin(j);
        write_range(j, e.loc);
        json.json_key(j, "name");
        json.json_str(j, e.name);
        // D20.3: the kind as a diagnostic spells it, "enum member"
        json.json_key(j, "kind");
        json.json_str(j, ast.sym_kind_name(e.kind));
        json.json_key(j, "type");
        if (e.has_type) {
            json.json_str(j, e.ty);
        } else {
            // D14.2, D20.3: no type to show, so the client renders it unknown
            json.json_null(j);
        }
        json.json_key(j, "is_decl");
        json.json_bool(j, e.is_decl);
        json.json_key(j, "decl");
        if (e.has_decl) {
            json.json_object_begin(j);
            write_range(j, e.decl);
            json.json_object_end(j);
        } else {
            // D12.2, D20.3
            json.json_null(j);
        }
        json.json_object_end(j);
        i += 1;
    }
    json.json_array_end(j);
}
