/// The facts of the heap proof and the join of each fact type (D17.16, D17.18). A path fact has a
/// value and a provenance. A join keeps each path of both inputs: it joins the two values and
/// keeps the weaker provenance.
// The heap solver imports this module. A witness checker can import it too; this module imports
// no ownership module, so it adds no import cycle. A new fact type adds a join function here and
// one row in the table of `tools/fact_joins.py`.

/// The source of a fact. `established`: an operation of this body observed the fact on each
/// execution that the state represents. `imported`: a callee summary gives the fact, and the
/// callee established or imported it; a graft writes it (`import_nullness`). `assumed`: the proof
/// assumes the fact: an input of the caller, a lost precision, or a fact that an operation copies
/// without a proof of its own. An earlier member is weaker. The zero is `assumed`, so a fact that
/// no constructor sets claims no observation. Only an established fact removes a path
/// (`may_prune`, D17.18).
enum provenance {
    assumed,
    imported,
    established,
}

/// The nullness of a root pointer (spec/memory-model.md 2.7). `free` is an input choice of the
/// caller, so each value is feasible. `joined` is an abstraction that lost the path of each value.
enum root_kind {
    null_root,
    nonnull,
    free,
    joined,
}

/// What the proof knows about the allocations of an atom. `released` holds when the root is
/// nonnull, because a null root has no allocation. `leaked` names an obligation that an event
/// reported lost: its storage stays allocated, so its views stay valid. `escaped` names an
/// obligation that left the proof after an incomplete-proof event: an unknown effect took it,
/// or its owner ended while its status was unknown. The proof does not know if its storage
/// stays allocated. `unknown` names an obligation that an unknown effect can change.
enum atom_status {
    live,
    released,
    maybe_released,
    leaked,
    escaped,
    unknown,
}

/// A root nullness that holds on each path that the state represents.
struct nullness {
    root_kind value;
    provenance how;
}

/// An allocation status that holds on each path that the state represents.
struct status_fact {
    atom_status value;
    provenance how;
}

/// A set whose member holds on at least one path. A join takes the union.
struct may_set {
    u64 bits;
}

/// A set whose member holds on each path. A join takes the intersection.
struct must_set {
    u64 bits;
}

/// A requirement that a caller meets at a call (D10.7, D17.18). The owner at the owned-field path
/// `path[..depth]` below the entry value of interface atom `entry` of the callee has the root
/// `needs` when the callee starts: `nonnull` for an owner that the callee dereferences, and
/// `null_root` for an output owner that the callee stores over. A path holds at most 6 fields.
struct requirement {
    u32 entry;
    u32 depth;
    u32[6] path;
    root_kind needs;
}

/// The requirements of each path that a state represents, in `requirement_order`. A join keeps
/// each requirement of both sides. A full list drops a new requirement: the list can omit a
/// requirement of each path, but it never names a requirement of some path only.
struct requirement_list {
    requirement[8] items;
    u32 len;
}

/// The weaker of two provenances: the earlier member of `provenance`.
fn weaker(provenance a, provenance b) provenance {
    return cast(a, u32) <= cast(b, u32) ? a : b;
}

/// The join of two root values: the value when both sides have it, otherwise `joined`.
fn join_root(root_kind a, root_kind b) root_kind {
    if (a == b) { return a; }
    return root_kind.joined;
}

/// The join of two allocation statuses. A release on one side and a live allocation on the other
/// is a possible release; an unknown or escaped side makes the join unknown; a reported loss on
/// one side gives the other side.
fn join_status(atom_status a, atom_status b) atom_status {
    if (a == b) { return a; }
    if (a == atom_status.unknown || b == atom_status.unknown ||
        a == atom_status.escaped || b == atom_status.escaped) { return atom_status.unknown; }
    if (a == atom_status.leaked) { return b; }
    if (b == atom_status.leaked) { return a; }
    return atom_status.maybe_released;
}

/// The join of two root facts: `join_root` of the values and the weaker provenance.
fn join_nullness(nullness a, nullness b) nullness {
    return nullness{join_root(a.value, b.value), weaker(a.how, b.how)};
}

/// The join of two status facts: `join_status` of the values and the weaker provenance.
fn join_status_fact(status_fact a, status_fact b) status_fact {
    return status_fact{join_status(a.value, b.value), weaker(a.how, b.how)};
}

/// The join of two may-sets: a member of either side.
fn join_may_set(may_set a, may_set b) may_set {
    return may_set{a.bits | b.bits};
}

/// The join of two must-sets: a member of both sides.
fn join_must_set(must_set a, must_set b) must_set {
    return must_set{a.bits & b.bits};
}

/// Orders two owned-field paths by their first `depth` fields. A field past the depth is no part
/// of a path.
fn path_order(u32[6] a, u32[6] b, u32 depth) i32 {
    u32 mut i = 0;
    while (i < depth && i < 6) {
        if (a[i] != b[i]) { return a[i] < b[i] ? -1 : 1; }
        i += 1;
    }
    return 0;
}

/// Orders two requirements by entry, depth, path, and need.
fn requirement_order(requirement a, requirement b) i32 {
    if (a.entry != b.entry) { return a.entry < b.entry ? -1 : 1; }
    if (a.depth != b.depth) { return a.depth < b.depth ? -1 : 1; }
    i32 c = path_order(a.path, b.path, a.depth);
    if (c != 0) { return c; }
    if (a.needs != b.needs) { return cast(a.needs, u32) < cast(b.needs, u32) ? -1 : 1; }
    return 0;
}

/// Whether `r` is one of the first `len` members of `items`.
fn has_requirement(requirement@ items, u32 len, requirement r) bool {
    u32 mut i = 0;
    while (i < len && cast(i, u64) < items.len) {
        if (requirement_order(items[i], r) == 0) { return true; }
        i += 1;
    }
    return false;
}

/// Inserts `r` into the first `*len` members of `items`, which keep `requirement_order`. The
/// result is 1 when `r` is new, 0 when it is a member already, and -1 when `items` is full.
fn insert_requirement(requirement mut@ items, u32 mut* len, requirement r) i32 {
    u32 mut at = 0;
    while (at < *len && requirement_order(items[at], r) < 0) { at += 1; }
    if (at < *len && requirement_order(items[at], r) == 0) { return 0; }
    if (cast(*len, u64) >= items.len) { return -1; }
    u32 mut k = *len;
    while (k > at) {
        items[k] = items[k - 1];
        k -= 1;
    }
    items[at] = r;
    *len += 1;
    return 1;
}

/// The join of two requirement lists: each requirement of both sides.
fn join_requirement_list(requirement_list a, requirement_list b) requirement_list {
    requirement_list mut out = requirement_list{};
    u32 mut i = 0;
    while (i < a.len) {
        if (has_requirement(b.items[..], b.len, a.items[i])) {
            insert_requirement(out.items[..], &out.len, a.items[i]);
        }
        i += 1;
    }
    return out;
}

/// The same root fact with the provenance `assumed`.
fn assume(nullness f) nullness {
    return nullness{f.value, provenance.assumed};
}

/// The same status fact with the provenance `assumed`.
fn assume_status(status_fact f) status_fact {
    return status_fact{f.value, provenance.assumed};
}

/// The fact of a callee summary in its caller: the same value, `imported` when the callee
/// established or imported it, and `assumed` when the callee assumed it.
fn import_nullness(nullness f) nullness {
    if (f.how == provenance.assumed) { return f; }
    return nullness{f.value, provenance.imported};
}

/// Whether a root fact is a nonnull root that an operation of this body observed. A dereference of
/// such a root needs no caller requirement (D10.7); any other root at a dereference does.
fn established_nonnull(nullness f) bool {
    return f.how == provenance.established && f.value == root_kind.nonnull;
}

/// Whether a root fact can remove a path: an established null or nonnull root (D17.18). An
/// imported or assumed fact, a free choice, and a joined root remove no path. A test, a null
/// constant, a move, an allocation and a release establish a root; an address computation, a
/// dereference, an unfold, a fold and a graft do not. Each pruning site of the heap proof that
/// reads a root reads this predicate: the truth of a null test, both root edges of `refine`, and
/// the exit contradiction of a call. The known-truth edge of `refine` reads `may_prune_truth` of
/// the heap module instead. A callee without a return ends a caller path only because its own
/// paths ended at these sites, at an abort, or in a loop.
fn may_prune(nullness f) bool {
    return f.how == provenance.established &&
        (f.value == root_kind.null_root || f.value == root_kind.nonnull);
}
