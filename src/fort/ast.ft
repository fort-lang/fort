/// Defines syntax-tree nodes, semantic annotations, arena operations, and S-expression output.
///
/// A node location covers its construct. Operator nodes start at the operator token.
/// The parser leaves annotation fields clear. Later passes fill them.
import containers;
import diag;
import lexer;
import prim;
import types;
import std.strbuf;

/// Syntax-tree node kinds in declaration, type, statement, and expression groups.
enum ast_kind {
    k_none, // never produced by the parser; the zero of a fresh node

    // ---- module and declarations ----
    k_module,      // list: imports then declarations, in source order
    k_import,      // a: path; b: `as` alias or null; list: brace items
    k_path, // list: the identifiers of an import path
    k_import_item, // name: the symbol; a: `as` alias or null
    k_fn_decl,     // a: return type; list: params; b: body, null when extern
    k_param,       // a: type; name: the parameter
    k_struct_decl, // name; list: fields
    k_field_decl,  // a: type; name: the field
    k_enum_decl,   // name; list: members
    k_enum_member, // name; a: the explicit value or null
    k_var_decl,    // a: type; name; b: initializer (a global or a local)
    k_compile_if,  // a: condition; b: then block; c: else block or k_compile_if

    // ---- types ----
    k_type,          // a: base type; flags: the base position's own and mut;
                     // list: the suffixes in source order
    k_type_prim,     // op: the prim_kind of prim.ft
    k_type_string,   // `string`
    k_type_void,     // `void`
    k_type_noreturn, // `noreturn`, a return type only
    k_type_name, // name: the first identifier; a: the second or null
    k_type_fn, // a: return type; list: parameter types
    k_type_suffix,   // op: a suffix_kind of types.ft; flags: own and mut;
                     // a: the length of an array suffix

    // ---- statements ----
    k_block,      // list: the statements
    k_assign,     // op: the assignment token; a: target; b: value
    k_incdec,     // op: plus_plus or minus_minus; a: target
    k_call_stmt, // a: the call expression
    k_if,         // a: condition; b: then block; c: else block or k_if
    k_while,      // a: condition; b: body
    k_do_while,   // a: body; b: condition
    k_for,        // a: init; b: condition; c: step; d: body; a, b, c may be null
    k_range_for,  // a: element type; name: the element; b: collection; c: body
    k_switch,     // a: the operand; list: the case clauses
    k_case,       // list: the labels, empty with FLAG_DEFAULT; a: body block
    k_defer, // a: the deferred statement
    k_return,     // a: the value or null
    k_break,      //
    k_continue,   //
    k_brace_init, // list: the initializers; FLAG_DESIGNATED for `.f = v`
    k_designator, // name: the field; a: its initializer

    // ---- expressions ----
    k_int, // ival: the magnitude
    k_float, // name: the literal
    k_char, // ival: the byte value
    k_string, // name: the decoded bytes
    k_cfg, // name: the configuration key
    k_bool,       // ival: 1 for `true`, 0 for `false`
    k_null, // `null`
    k_ident,      // name: the identifier
    k_unary,      // op: the operator token; a: the operand
    k_binary,     // op: the operator token; a, b: the operands
    k_ternary, // a: condition; b: then; c: else
    k_call,       // a: the callee; list: the arguments
    k_index, // a: the operand; b: the index
    k_span, // a: the operand; b: low or null; c: high or null
    k_field,      // a: the operand; name: the field (`.`)
    k_arrow, // a: the operand; name: the field (`->`)
    k_cast, // a: the expression; b: the target type
    k_sizeof, // a: the type
    k_new, // a: the allocated type; b: the count or null
    k_struct_lit, // a: the qualified name; b: the brace initializer
    k_array_lit, // a: the array type; b: the brace initializer

    /// The tokens a syntax error made the parser skip; never has children. It stands
    /// wherever a list holds children of that level, so every pass that walks such a
    /// list skips a node of this kind.
    k_error,
}

/// The bits of `flags`.
u32 FLAG_OWN = 1; // k_type, k_type_suffix: an `own` in the position
u32 FLAG_MUT = 2; // k_type, k_type_suffix: a `mut` in the position
u32 FLAG_EXTERN = 4; // k_fn_decl: an `extern fn` declaration
u32 FLAG_DEFAULT = 8; // k_case: the `default` clause
u32 FLAG_DESIGNATED = 16; // k_brace_init: `.field = value` members
u32 FLAG_VARIADIC = 32; // k_fn_decl: an extern C variable tail
u32 FLAG_SELECT_DONE = 64; // k_compile_if: the selector evaluated the condition
u32 FLAG_SELECT_THEN = 128; // k_compile_if: the selector chose the then branch
u32 FLAG_SELECT_REF = 256; // k_ident: the selector resolved this condition reference
u32 FLAG_IMPORT_SELECTOR = 512; // k_compile_if: branches select imports

// The first non-zero capacity of a child list and of the arena's node vector;
// growth doubles from there.
u64 LIST_MIN_CAP = 4;
u64 ARENA_MIN_CAP = 64;

// ---- the node and its child list -----------------------------------------------

/// One syntax-tree node. Fields that do not apply to its kind have zero values.
struct node {
    ast_kind kind;
    diag.loc loc;
    /// The range of a name that this node declares or mentions. Other nodes use an empty range.
    /// The range repeats `loc.file`, so callers can pass it directly to `diag.error`.
    diag.loc name_loc;
    diag.loc tail_loc; // location of `...` on an extern declaration
    i32 op;      // a tok_kind, a suffix_kind or a prim_kind; 0 otherwise
    node mut* a; // the fixed children, in the order the comments above give
    node mut* b;
    node mut* c;
    node mut* d;
    node_vec list; // variable-arity children
    string name;   // an identifier or the bytes of a literal
    u64 ival;      // an integer or char literal, 0 or 1 for a bool
    u32 flags;

    // ---- the checker's annotations (check.ft) ----
    // The type of an expression or of a written type, null until the checker writes
    // it. `type` is reserved, so the slot the C calls `type` is `ty`.
    types.node* ty;
    /// The resolved symbol for this name, or null when the node has no name.
    sym mut* sym;
    /// Pass annotations. A bit in `ann` defines the meaning of `aux`.
    u32 ann;
    u64 aux;
}

// The variable-length children of one node. `items.len` is the capacity.
// `len` is the number of used slots.
struct node_vec {
    node mut* mut@ own items;
    u64 len;
}

// Clears one child list.
fn list_free(node_vec mut* v) void {
    del(v->items);
    v->len = 0;
}

// Ensures room for one more child, growing to the largest of LIST_MIN_CAP and
// twice the capacity.
fn list_reserve(node_vec mut* v) void {
    if (v->len < v->items.len) {
        return;
    }
    u64 mut cap = LIST_MIN_CAP;
    if (v->items.len >= cap) {
        // Check the limit before multiplication because fort traps on overflow.
        if (v->items.len > containers.U64_MAX / 2) {
            panic("ast.list_reserve: capacity overflow");
        }
        cap = v->items.len * 2;
    }
    node mut* mut@ own bigger = new(node mut*, cap);
    u64 mut i = 0;
    while (i < v->len) {
        bigger[i] = v->items[i];
        i += 1;
    }
    del(v->items);
    v->items = move(bigger);
}

// ---- symbols --------------------------------------------------------------------

/// The declaration category that a name denotes.
/// Fields and enum members resolve through a type. Builtins resolve from the universe scope.
enum sym_kind {
    s_module,
    s_fn,
    s_extern_fn,
    s_struct,
    s_enum,
    s_enum_member,
    s_field,
    s_const, // a module-level immutable declaration
    s_global, // a module-level `mut` declaration
    s_local,
    s_param,
    s_builtin,
}

/// One declaration, enum member, field, or builtin.
/// `node` identifies its declaration. Modules and builtins have no fort type.
/// A failed declaration uses the error type to prevent later duplicate diagnostics.
struct sym {
    sym_kind kind;
    string name;
    diag.loc decl; // the declaring node's name_loc
    types.node* ty; // the error type when `error` is set
    bool mut0; // level-0 mutability, as types.type_to_str_decl spells it
    /// The declaration node, or null for a builtin.
    node mut* node;
    sym mut* owner; // the struct of a field, the enum of a member, the module
    bool error; // the declaration failed to check
}

/// The kind as a reader spells it: "module", "extern fn", "enum member",
/// "constant", "global", "local", "parameter", "builtin".
fn sym_kind_name(sym_kind kind) string {
    switch (kind) {
    case sym_kind.s_module:
        return "module";
    case sym_kind.s_fn:
        return "fn";
    case sym_kind.s_extern_fn:
        return "extern fn";
    case sym_kind.s_struct:
        return "struct";
    case sym_kind.s_enum:
        return "enum";
    case sym_kind.s_enum_member:
        return "enum member";
    case sym_kind.s_field:
        return "field";
    case sym_kind.s_const:
        return "constant";
    case sym_kind.s_global:
        return "global";
    case sym_kind.s_local:
        return "local";
    case sym_kind.s_param:
        return "parameter";
    case sym_kind.s_builtin:
        return "builtin";
    }
}

// ---- the arena -----------------------------------------------------------------

/// Stores the nodes of one syntax tree. `arena{}` is an empty arena.
struct arena {
    node mut* own mut@ own nodes;
    u64 count;
}

/// Resets the arena to `arena{}`.
fn ast_arena_init(arena mut* ar) void {
    *ar = arena{};
}

/// Removes all nodes and makes the arena empty.
fn ast_arena_free(arena mut* ar) void {
    u64 mut i = 0;
    while (i < ar->count) {
        node mut* own n = move(ar->nodes[i]);
        list_free(&n->list);
        del(n);
        i += 1;
    }
    del(ar->nodes);
    ar->count = 0;
}

fn ast_arena_count(arena* ar) u64 {
    return ar->count;
}

// Ensures room for one more node, growing to the largest of ARENA_MIN_CAP and
// twice the capacity.
fn arena_reserve(arena mut* ar) void {
    if (ar->count < ar->nodes.len) {
        return;
    }
    u64 mut cap = ARENA_MIN_CAP;
    if (ar->nodes.len >= cap) {
        if (ar->nodes.len > containers.U64_MAX / 2) {
            panic("ast.arena_reserve: capacity overflow");
        }
        cap = ar->nodes.len * 2;
    }
    node mut* own mut@ own bigger = new(node mut* own, cap);
    u64 mut i = 0;
    while (i < ar->count) {
        bigger[i] = move(ar->nodes[i]);
        i += 1;
    }
    del(ar->nodes);
    ar->nodes = move(bigger);
}

/// Adds a zeroed node of `kind` at `at_loc`.
fn ast_new(arena mut* ar, ast_kind kind, diag.loc at_loc) node mut* {
    node mut* own fresh = new(node);
    fresh->kind = kind;
    fresh->loc = at_loc;
    arena_reserve(ar);
    ar->nodes[ar->count] = move(fresh);
    ar->count += 1;
    return ar->nodes[ar->count - 1];
}

// ---- children ------------------------------------------------------------------

/// Appends `child`, which may not be null, to `parent`'s list.
fn ast_push(node mut* parent, node mut* child) void {
    if (child == null) {
        panic("ast.ast_push of a null child");
    }
    list_reserve(&parent->list);
    parent->list.items[parent->list.len] = child;
    parent->list.len += 1;
}

fn ast_len(node* n) u64 {
    return n->list.len;
}

/// Returns child `i`. The function panics when `i` is outside the child list.
fn ast_child_mut(node* n, u64 i) node mut* {
    if (i >= n->list.len) {
        panic("ast.ast_child: index out of range");
    }
    return n->list.items[i];
}

/// Returns child `i`. The function panics when `i` is outside the child list.
fn ast_child(node* n, u64 i) node* {
    return ast_child_mut(n, i);
}

/// The marks of a type position, each written once and after what it qualifies.
fn ast_is_own(node* n) bool {
    return (n->flags & FLAG_OWN) != 0;
}

fn ast_is_mut(node* n) bool {
    return (n->flags & FLAG_MUT) != 0;
}

/// The name of a kind as the S-expression dumper and diagnostics spell it:
/// "module", "var-decl", "type-suffix", "binary".
fn ast_kind_name(ast_kind kind) string {
    switch (kind) {
    case ast_kind.k_none:
        return "none";
    case ast_kind.k_module:
        return "module";
    case ast_kind.k_import:
        return "import";
    case ast_kind.k_path:
        return "path";
    case ast_kind.k_import_item:
        return "item";
    case ast_kind.k_fn_decl:
        return "fn";
    case ast_kind.k_param:
        return "param";
    case ast_kind.k_struct_decl:
        return "struct";
    case ast_kind.k_field_decl:
        return "field-decl";
    case ast_kind.k_enum_decl:
        return "enum";
    case ast_kind.k_enum_member:
        return "member";
    case ast_kind.k_var_decl:
        return "var";
    case ast_kind.k_compile_if:
        return "compile-if";
    case ast_kind.k_type:
        return "type";
    case ast_kind.k_type_prim:
        return "prim";
    case ast_kind.k_type_string:
        return "string";
    case ast_kind.k_type_void:
        return "void";
    case ast_kind.k_type_noreturn:
        return "noreturn";
    case ast_kind.k_type_name:
        return "name";
    case ast_kind.k_type_fn:
        return "fn-type";
    case ast_kind.k_type_suffix:
        return "suffix";
    case ast_kind.k_block:
        return "block";
    case ast_kind.k_assign:
        return "assign";
    case ast_kind.k_incdec:
        return "incdec";
    case ast_kind.k_call_stmt:
        return "call-stmt";
    case ast_kind.k_if:
        return "if";
    case ast_kind.k_while:
        return "while";
    case ast_kind.k_do_while:
        return "do";
    case ast_kind.k_for:
        return "for";
    case ast_kind.k_range_for:
        return "range-for";
    case ast_kind.k_switch:
        return "switch";
    case ast_kind.k_case:
        return "case";
    case ast_kind.k_defer:
        return "defer";
    case ast_kind.k_return:
        return "return";
    case ast_kind.k_break:
        return "break";
    case ast_kind.k_continue:
        return "continue";
    case ast_kind.k_brace_init:
        return "init";
    case ast_kind.k_designator:
        return "designator";
    case ast_kind.k_int:
        return "int";
    case ast_kind.k_float:
        return "float";
    case ast_kind.k_char:
        return "char";
    case ast_kind.k_string:
        return "str";
    case ast_kind.k_cfg:
        return "cfg";
    case ast_kind.k_bool:
        return "bool";
    case ast_kind.k_null:
        return "null";
    case ast_kind.k_ident:
        return "ident";
    case ast_kind.k_unary:
        return "unary";
    case ast_kind.k_binary:
        return "binary";
    case ast_kind.k_ternary:
        return "ternary";
    case ast_kind.k_call:
        return "call";
    case ast_kind.k_index:
        return "index";
    case ast_kind.k_span:
        return "span";
    case ast_kind.k_field:
        return "field";
    case ast_kind.k_arrow:
        return "arrow";
    case ast_kind.k_cast:
        return "cast";
    case ast_kind.k_sizeof:
        return "sizeof";
    case ast_kind.k_new:
        return "new";
    case ast_kind.k_struct_lit:
        return "struct-lit";
    case ast_kind.k_array_lit:
        return "array-lit";
    case ast_kind.k_error:
        return "error";
    }
    return "?";
}

// ---- the tree dump (--ast) ----------------------------------------

// Bytes outside this range print as \xHH inside a string literal.
i64 PRINTABLE_LOW = 32;
i64 PRINTABLE_HIGH = 126;
u64 HEX_RADIX = 16;
string HEX_DIGITS = "0123456789ABCDEF";

fn sexp_open(strbuf.str_buf mut* out, string head) void {
    strbuf.push(out, '(');
    strbuf.append(out, head);
}

fn sexp_close(strbuf.str_buf mut* out) void {
    strbuf.push(out, ')');
}

fn sexp_word(strbuf.str_buf mut* out, string w) void {
    strbuf.push(out, ' ');
    strbuf.append(out, w);
}

fn sexp_name(strbuf.str_buf mut* out, string s) void {
    strbuf.push(out, ' ');
    strbuf.append(out, s);
}

fn sexp_uint(strbuf.str_buf mut* out, u64 v) void {
    strbuf.push(out, ' ');
    strbuf.append_u64(out, v);
}

fn sexp_quoted(strbuf.str_buf mut* out, string s) void {
    strbuf.append(out, " \"");
    u64 mut i = 0;
    while (i < s.len) {
        char c = s[i];
        i64 byte = cast(c, i64);
        if (byte == cast('"', i64) || byte == cast('\\', i64)) {
            strbuf.push(out, '\\');
            strbuf.push(out, c);
        } else if (byte < PRINTABLE_LOW || byte > PRINTABLE_HIGH) {
            strbuf.append(out, "\\x");
            strbuf.push(out, HEX_DIGITS[cast(byte, u64) / HEX_RADIX]);
            strbuf.push(out, HEX_DIGITS[cast(byte, u64) % HEX_RADIX]);
        } else {
            strbuf.push(out, c);
        }
        i += 1;
    }
    strbuf.push(out, '"');
}

fn sexp_child(node* n, strbuf.str_buf mut* out) void {
    strbuf.push(out, ' ');
    ast_dump(n, out);
}

fn sexp_list(node* n, strbuf.str_buf mut* out) void {
    u64 mut i = 0;
    while (i < ast_len(n)) {
        sexp_child(ast_child(n, i), out);
        i += 1;
    }
}

// The `own` and `mut` of a type position, in the order the source writes them:
// an `own` precedes the `mut` in a position.
fn sexp_marks(node* n, strbuf.str_buf mut* out) void {
    if (ast_is_own(n)) {
        sexp_word(out, "own");
    }
    if (ast_is_mut(n)) {
        sexp_word(out, "mut");
    }
}

fn dump_suffix(node* n, strbuf.str_buf mut* out) void {
    types.suffix_kind kind = cast(n->op, types.suffix_kind);
    switch (kind) {
    case types.suffix_kind.s_ptr:
        sexp_open(out, "ptr");
    case types.suffix_kind.s_span:
        sexp_open(out, "span");
    case types.suffix_kind.s_array:
        sexp_open(out, "array");
        sexp_child(n->a, out);
    }
    sexp_marks(n, out);
    sexp_close(out);
}

fn dump_type(node* n, strbuf.str_buf mut* out) void {
    if (n->kind == ast_kind.k_type) {
        sexp_open(out, "type");
        sexp_child(n->a, out);
        sexp_marks(n, out);
        sexp_list(n, out);
    } else if (n->kind == ast_kind.k_type_prim) {
        sexp_open(out, "prim");
        sexp_word(out, prim.prim_name(cast(n->op, prim.prim_kind)));
    } else if (n->kind == ast_kind.k_type_name) {
        sexp_open(out, "name");
        sexp_name(out, n->name);
        if (n->a != null) {
            sexp_name(out, n->a->name);
        }
    } else if (n->kind == ast_kind.k_type_fn) {
        sexp_open(out, "fn-type");
        sexp_child(n->a, out);
        sexp_list(n, out);
    } else {
        sexp_open(out, ast_kind_name(n->kind));
    }
    sexp_close(out);
}

// Prints one compile-time chain without recursive calls along its `else $if`
// links. Branch contents still use the ordinary source-order tree walk.
fn dump_compile_if(node* n, strbuf.str_buf mut* out) void {
    node* mut current = n;
    u64 mut opened = 0;
    while (current != null && current->kind == ast_kind.k_compile_if) {
        sexp_open(out, "compile-if");
        opened += 1;
        sexp_child(current->a, out);
        sexp_child(current->b, out);
        if (current->c == null || current->c->kind != ast_kind.k_compile_if) {
            sexp_child(current->c, out);
            break;
        }
        strbuf.push(out, ' ');
        current = current->c;
    }
    while (opened > 0) {
        sexp_close(out);
        opened -= 1;
    }
}

fn dump_decl(node* n, strbuf.str_buf mut* out) void {
    if (n->kind == ast_kind.k_import) {
        sexp_open(out, "import");
        sexp_child(n->a, out);
        sexp_child(n->b, out);
        sexp_list(n, out);
    } else if (n->kind == ast_kind.k_import_item) {
        sexp_open(out, "item");
        sexp_name(out, n->name);
        sexp_child(n->a, out);
    } else if (n->kind == ast_kind.k_path) {
        // The segments are identifiers, printed as words: (path std io).
        sexp_open(out, "path");
        u64 mut i = 0;
        while (i < ast_len(n)) {
            sexp_name(out, ast_child(n, i)->name);
            i += 1;
        }
    } else if (n->kind == ast_kind.k_fn_decl) {
        if ((n->flags & FLAG_EXTERN) != 0) {
            sexp_open(out, "extern-fn");
        } else {
            sexp_open(out, "fn");
        }
        sexp_child(n->a, out);
        sexp_name(out, n->name);
        strbuf.append(out, " (params");
        sexp_list(n, out);
        if ((n->flags & FLAG_VARIADIC) != 0) {
            strbuf.append(out, " ...");
        }
        sexp_close(out);
        sexp_child(n->b, out);
    } else if (n->kind == ast_kind.k_param || n->kind == ast_kind.k_field_decl) {
        sexp_open(out, ast_kind_name(n->kind));
        sexp_child(n->a, out);
        sexp_name(out, n->name);
    } else if (n->kind == ast_kind.k_enum_member) {
        sexp_open(out, "member");
        sexp_name(out, n->name);
        sexp_child(n->a, out);
    } else if (n->kind == ast_kind.k_var_decl) {
        sexp_open(out, "var");
        sexp_name(out, n->name);
        sexp_child(n->a, out);
        sexp_child(n->b, out);
    } else if (n->kind == ast_kind.k_struct_decl || n->kind == ast_kind.k_enum_decl) {
        sexp_open(out, ast_kind_name(n->kind));
        sexp_name(out, n->name);
        sexp_list(n, out);
    } else if (n->kind == ast_kind.k_compile_if) {
        dump_compile_if(n, out);
        return;
    } else {
        sexp_open(out, ast_kind_name(n->kind));
        sexp_list(n, out);
    }
    sexp_close(out);
}

fn dump_stmt(node* n, strbuf.str_buf mut* out) void {
    if (n->kind == ast_kind.k_assign) {
        sexp_open(out, "assign");
        sexp_word(out, lexer.tok_kind_name(cast(n->op, lexer.tok_kind)));
        sexp_child(n->a, out);
        sexp_child(n->b, out);
    } else if (n->kind == ast_kind.k_incdec) {
        sexp_open(out, "incdec");
        sexp_word(out, lexer.tok_kind_name(cast(n->op, lexer.tok_kind)));
        sexp_child(n->a, out);
    } else if (n->kind == ast_kind.k_if) {
        sexp_open(out, "if");
        sexp_child(n->a, out);
        sexp_child(n->b, out);
        sexp_child(n->c, out);
    } else if (n->kind == ast_kind.k_for) {
        sexp_open(out, "for");
        sexp_child(n->a, out);
        sexp_child(n->b, out);
        sexp_child(n->c, out);
        sexp_child(n->d, out);
    } else if (n->kind == ast_kind.k_range_for) {
        sexp_open(out, "range-for");
        sexp_child(n->a, out);
        sexp_name(out, n->name);
        sexp_child(n->b, out);
        sexp_child(n->c, out);
    } else if (n->kind == ast_kind.k_switch) {
        sexp_open(out, "switch");
        sexp_child(n->a, out);
        sexp_list(n, out);
    } else if (n->kind == ast_kind.k_case) {
        sexp_open(out, "case");
        if ((n->flags & FLAG_DEFAULT) != 0) {
            sexp_word(out, "default");
        } else {
            strbuf.append(out, " (labels");
            sexp_list(n, out);
            sexp_close(out);
        }
        sexp_child(n->a, out);
    } else if (n->kind == ast_kind.k_brace_init) {
        sexp_open(out, "init");
        sexp_list(n, out);
    } else if (n->kind == ast_kind.k_designator) {
        sexp_open(out, "designator");
        sexp_name(out, n->name);
        sexp_child(n->a, out);
    } else if (n->kind == ast_kind.k_block) {
        sexp_open(out, "block");
        sexp_list(n, out);
    } else if (n->kind == ast_kind.k_while || n->kind == ast_kind.k_do_while) {
        sexp_open(out, ast_kind_name(n->kind));
        sexp_child(n->a, out);
        sexp_child(n->b, out);
    } else {
        sexp_open(out, ast_kind_name(n->kind));
        if (n->kind != ast_kind.k_break && n->kind != ast_kind.k_continue) {
            sexp_child(n->a, out);
        }
    }
    sexp_close(out);
}

fn dump_expr(node* n, strbuf.str_buf mut* out) void {
    if (n->kind == ast_kind.k_int || n->kind == ast_kind.k_char) {
        sexp_open(out, ast_kind_name(n->kind));
        sexp_uint(out, n->ival);
    } else if (n->kind == ast_kind.k_float || n->kind == ast_kind.k_string) {
        sexp_open(out, ast_kind_name(n->kind));
        sexp_quoted(out, n->name);
    } else if (n->kind == ast_kind.k_bool) {
        sexp_open(out, "bool");
        if (n->ival != 0) {
            sexp_word(out, "true");
        } else {
            sexp_word(out, "false");
        }
    } else if (n->kind == ast_kind.k_ident) {
        sexp_open(out, "ident");
        sexp_name(out, n->name);
    } else if (n->kind == ast_kind.k_cfg) {
        sexp_open(out, "cfg");
        sexp_name(out, n->name);
    } else if (n->kind == ast_kind.k_unary || n->kind == ast_kind.k_binary) {
        sexp_open(out, ast_kind_name(n->kind));
        sexp_word(out, lexer.tok_kind_name(cast(n->op, lexer.tok_kind)));
        sexp_child(n->a, out);
        if (n->kind == ast_kind.k_binary) {
            sexp_child(n->b, out);
        }
    } else if (n->kind == ast_kind.k_ternary || n->kind == ast_kind.k_span) {
        sexp_open(out, ast_kind_name(n->kind));
        sexp_child(n->a, out);
        sexp_child(n->b, out);
        sexp_child(n->c, out);
    } else if (n->kind == ast_kind.k_call) {
        sexp_open(out, "call");
        sexp_child(n->a, out);
        sexp_list(n, out);
    } else if (n->kind == ast_kind.k_field || n->kind == ast_kind.k_arrow) {
        sexp_open(out, ast_kind_name(n->kind));
        sexp_child(n->a, out);
        sexp_name(out, n->name);
    } else if (n->kind == ast_kind.k_sizeof) {
        sexp_open(out, "sizeof");
        sexp_child(n->a, out);
    } else {
        sexp_open(out, ast_kind_name(n->kind));
        if (n->kind != ast_kind.k_null) {
            sexp_child(n->a, out);
            sexp_child(n->b, out);
        }
    }
    sexp_close(out);
}

// Whether the kind is one of the type productions, which dump_type prints.
fn is_type_kind(ast_kind kind) bool {
    return kind == ast_kind.k_type || kind == ast_kind.k_type_prim
        || kind == ast_kind.k_type_string || kind == ast_kind.k_type_void
        || kind == ast_kind.k_type_noreturn || kind == ast_kind.k_type_name
        || kind == ast_kind.k_type_fn;
}

// Whether the kind is a declaration or the module, which dump_decl prints.
fn is_decl_kind(ast_kind kind) bool {
    return kind == ast_kind.k_module || kind == ast_kind.k_import || kind == ast_kind.k_path
        || kind == ast_kind.k_import_item || kind == ast_kind.k_fn_decl
        || kind == ast_kind.k_param || kind == ast_kind.k_struct_decl
        || kind == ast_kind.k_field_decl || kind == ast_kind.k_enum_decl
        || kind == ast_kind.k_enum_member || kind == ast_kind.k_var_decl
        || kind == ast_kind.k_compile_if;
}

// Whether the kind is a statement, which dump_stmt prints.
fn is_stmt_kind(ast_kind kind) bool {
    return kind == ast_kind.k_block || kind == ast_kind.k_assign || kind == ast_kind.k_incdec
        || kind == ast_kind.k_call_stmt || kind == ast_kind.k_if || kind == ast_kind.k_while
        || kind == ast_kind.k_do_while || kind == ast_kind.k_for
        || kind == ast_kind.k_range_for || kind == ast_kind.k_switch
        || kind == ast_kind.k_case || kind == ast_kind.k_defer || kind == ast_kind.k_return
        || kind == ast_kind.k_break || kind == ast_kind.k_continue
        || kind == ast_kind.k_brace_init || kind == ast_kind.k_designator;
}

/// Appends the S-expression of `n` to `out`. A null node prints as `nil`.
/// This format is the output of `fort --ast`.
fn ast_dump(node* n, strbuf.str_buf mut* out) void {
    if (n == null) {
        strbuf.append(out, "nil");
        return;
    }
    if (n->kind == ast_kind.k_error) {
        strbuf.append(out, "(error)");
        return;
    }
    if (is_type_kind(n->kind)) {
        dump_type(n, out);
        return;
    }
    if (n->kind == ast_kind.k_type_suffix) {
        dump_suffix(n, out);
        return;
    }
    if (is_decl_kind(n->kind)) {
        dump_decl(n, out);
        return;
    }
    if (is_stmt_kind(n->kind)) {
        dump_stmt(n, out);
        return;
    }
    dump_expr(n, out);
}
