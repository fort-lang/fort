/// Builds deterministic LLVM IR from checked syntax trees.

import ast;
import check;
import consts;
import containers;
import diag;
import flt;
import modules;
import prim;
import runtime_sig;
import session;
import std.strbuf;
import types;

// The two named types every module carries, used or not, so that the emitter
// tracks nothing. `%fort.span` serves every span and `string`, since
// with opaque pointers they have identical IR.
string SPAN_TYPE = "%fort.span";
string ENUM_MEMBER_TYPE = "%fort.enum_member";

// Represents `std.rt`'s `struct enum_member` as `%fort.enum_member`. One named type defines this
// layout. The emitter also uses this layout for enum metadata.
string ENUM_MEMBER_STRUCT = "std.rt.enum_member";

// The bytes a span or `string` header occupies: a pointer and a 64-bit length.
u64 SPAN_SIZE = 16;
u64 SPAN_ALIGN = 8;

// The alignment of one span header field. It is the size of a pointer or 64-bit length.
u64 PTR_BYTES = 8;
u64 LEN_BYTES = 8;

// The width of the widest integer the emitter prints a constant of.
u32 BITS_PER_U64 = 64;

// The header fields of a span, in the order LLVM IR gives them.
u64 SPAN_FIELD_PTR = 0;
u64 SPAN_FIELD_LEN = 1;

// Lists intrinsics in a fixed order. memcpy and memset come first. Overflow intrinsics follow by
// operation and width. Saturating conversions and llvm.trap come last. These values are module
// constants, not an enum. Slot calculation uses family and width arithmetic, which an enum does not
// support.
u64 IN_MEMCPY = 0;
u64 IN_MEMSET = 1;
u64 IN_OVERFLOW_FIRST = 2;
u64 IN_FPCONV_FIRST = 26;
u64 IN_TRAP = 42;
u64 IN_COUNT = 43;

// The overflow intrinsics, in the order `sadd ssub smul uadd usub umul` and,
// within each, the widths `i8 i16 i32 i64`.
u64 OVF_SADD = 0;
u64 OVF_SSUB = 1;
u64 OVF_SMUL = 2;
u64 OVF_UADD = 3;
u64 OVF_USUB = 4;
u64 OVF_UMUL = 5;
u64 OVF_COUNT = 6;

// The widths an overflow intrinsic exists at, `i8 i16 i32 i64`.
u64 OVF_WIDTHS = 4;

// Lists saturating float-to-integer intrinsics in LLVM declaration order. Signed conversions
// precede unsigned conversions. Each group uses f32, then f64, with target widths `i8 i16 i32 i64`.
// They implement the cast rule. The result truncates toward zero, saturates to the target range,
// and becomes 0 for NaN. Plain `fptosi` produces poison out of range.
u64 FP_SI_F32 = 0;
u64 FP_SI_F64 = 1;
u64 FP_UI_F32 = 2;
u64 FP_UI_F64 = 3;
u64 FP_WIDTHS = 4;

// The attribute groups, at their fixed indices; only the
// used ones are emitted, so gaps in the numbering are normal.
u64 ATTR_FN = 0;        // #0, every fort definition
u64 ATTR_FN_NORET = 1;  // #1, a `noreturn` definition
u64 ATTR_UNUSED_2 = 2;  // #2, never emitted: it held the C runtime's declarations
u64 ATTR_NOBUILTIN = 3; // #3, every extern call site
u64 ATTR_OVERFLOW = 4;  // #4, the overflow and conversion intrinsics
u64 ATTR_MEMCPY = 5;    // #5
u64 ATTR_MEMSET = 6;    // #6
u64 ATTR_TRAP = 7;      // #7, llvm.trap
u64 ATTR_RT_NORET = 8;  // #8, a cold `noreturn` runtime entry point
u64 ATTR_COUNT = 9;

// The first byte that needs no `\XX` escape and the last: a string constant
// writes every other byte as a hex pair.
u64 PRINTABLE_FIRST = 32;
u64 PRINTABLE_LAST = 126;
u64 HEX_DIGITS = 16;

// The hex digits of a `\XX` escape, which a string constant and a quoted name
// both write.
string HEX = "0123456789ABCDEF";

// The first non-zero capacity of a vector of this module; growth doubles from
// there, as containers.str_vec grows.
u64 VEC_MIN_CAP = 16;

// ---- the values the emitter passes around -----------------------------------------

// An IR operand holds type text and value text. `ty` can include a call attribute (`i8
// zeroext`), which is why it is text and not a type. It is spelled `ty` because
// `type` is reserved.
struct gen_val {
    string ty;
    string val;
}

// A place: the address of storage and the fort type it holds. Every aggregate
// and every local lives in one.
struct gen_place {
    gen_val addr;
    types.node* ty;
}

// The argument text of one call, built left to right so that a call of any
// arity needs no fixed bound.
struct gen_args {
    strbuf.str_buf text;
    u64 count;
}

// The build mode and selected target the module is emitted in, and the path of each function.
struct gen_options {
    bool release;         // --release: wrapping arithmetic, no overwrite check
    bool no_bounds_check; // --no-bounds-check: no index or span branch
    string target;        // empty in emitter tests means the Linux target
    // Whether gen_stmt tries the FIR path first for each function (spec/fir.md 16.1). The
    // driver sets it. An emitter test that leaves it false tests the direct path alone.
    bool fir;
}

// One local or parameter place: the symbol it belongs to and the name of its
// storage. An aggregate parameter's place is the caller-made copy the incoming
// pointer designates, so its name is `%<ident>.in`.
struct slot {
    ast.sym* sym;
    string name;
}

// The slots of the function being emitted, in the order their allocas are.
// bootstrap0/src/gen.c boxes each record into a ptrvec_t of `void*`. A slot is
// a plain value, so the vector holds them by value, as check.ft's folded
// values are held.
struct slot_vec {
    slot mut@ own items;
    u64 len;
}

// One record of the private data: a file name, a string literal or an enum
// table, each numbered on first use.
struct record {
    string text;   // the bytes of a file name or a string literal
    ast.sym* sym;  // an enum table's declaration
    u64 first;     // its first member-name string
    u64 count;     // its member count
}

// A vector of those records, by value for the same reason.
struct record_vec {
    record mut@ own items;
    u64 len;
}

// The `extern` functions that the module refers to, in first-use order.
struct sym_vec {
    ast.sym* mut@ own items;
    u64 len;
}

// The kind of a block scope: which exits leave it, and therefore run the deferred statements it
// holds. `break` leaves the innermost loop or case body. `continue` leaves the innermost loop body.
// `return` leaves through the function body. A block end leaves only that block.
enum scope_kind {
    sc_block, // an ordinary block, left by falling off its end
    sc_loop,  // a loop body, left by `break` and by `continue` too
    sc_case, // a case body, left by `break`
    sc_fn,    // the function body, left by `return`
}

// One open block scope: its kind and the index into the emitter's `defers`
// where its own deferred statements begin. bootstrap0/src/gen.h keeps two
// parallel intvec_t, `scope_kinds` and `scope_first`, indexed by the same
// depth. One vector of pairs keeps both values at the same index.
struct block_scope {
    scope_kind kind;
    u64 first;
}

// Tracks open block scopes, with the innermost last. Each exit has a static defer set. The emitter
// reads that set from this stack and copies its code into the exit. The tree shape determines how
// many scopes an exit leaves. This stack records that shape, so the emitter needs no separate
// counter.
struct scope_vec {
    block_scope mut@ own items;
    u64 len;
}

// AST nodes for open defers and local declarations, in source order.
struct node_ref_vec {
    ast.node* mut@ own items;
    u64 len;
}

// The emitter. bootstrap0/src/gen.h calls this type `gen_t`. Here it is `emitter`, beside
// check.ft's `checker`. A `gen` type would produce the unclear name `gen.gen`. The fields this
// module does not write are output sections and caller results. They are here because gen_init and
// gen_free answer for the whole value. The defer scope stack and the `break` and `continue` targets
// of the C's struct are the statement emitter's alone.
struct emitter {
    gen_options opts;
    session.session mut* sess; // diagnostic state for this analysis
    check.checker* ck;         // checked annotations used by the emitter

    // ---- the sections, assembled in order at the end ----
    strbuf.str_buf named;   // the named types
    strbuf.str_buf globals; // the module-level data
    strbuf.str_buf funcs;   // the function definitions
    strbuf.str_buf out;     // the whole module, written by gen_finish

    // ---- the function being emitted ----
    strbuf.str_buf allocas; // its entry-block allocas, in declaration order
    strbuf.str_buf body;    // its normal blocks
    strbuf.str_buf fail; // its failure blocks, emitted after them
    u64 temps;
    u64 labels;
    u64 tmps;
    slot_vec slots;  // the locals and parameters in order
    bool terminated; // the block being written already ended in a terminator
    // `break` targets the innermost loop or `switch`. `continue` targets the innermost loop, across
    // an intervening `switch`. Therefore, a loop sets both saved targets. A `switch` sets only the
    // break target. Each flag states whether its target is set. The emitter saves and restores each
    // flag with its label.
    u64 break_label;
    u64 continue_label;
    bool has_break;
    bool has_continue;
    node_ref_vec defers; // the k_defer nodes of every open scope
    scope_vec scopes;    // the open block scopes, innermost last
    // The scope an exit inside deferred code may not unwind past: the scopes below it are the ones
    // the exit being expanded is already leaving. The checker refuses `return` there. It also
    // refuses `break` or `continue` without a target inside the deferred code. Reaching the floor
    // is therefore an internal error, not recursive defer expansion.
    u64 defer_floor;

    // ---- what the module refers to, in first-use order ------------
    record_vec files; // @.file.N, one per file
    record_vec strs;  // @.str.N, never deduplicated by content
    record_vec enums; // @.enum.<path.name>, one per enum some print reaches
    sym_vec externs;  // the extern C functions, in first-use order
    bool[IN_COUNT] intrinsics;
    bool[ATTR_COUNT] attrs;

    // Stores the `char` element type that `string` does not carry. gen_element_type returns it, so
    // the emitter has one spelling for the IR type.
    types.node char_type;

    containers.pool pool;   // owns every operand and type text the emitter builds
    strbuf.str_buf scratch; // the buffer those texts are built in
    modules.module* module; // the module being emitted
    bool failed;            // a construct the emitter cannot lower yet was reported

    // ---- the paths of the functions (spec/fir.md 16.1), which --fir-stats prints ----
    u64 functions; // the definitions of fort functions, the C `main` excluded
    u64 lowered;   // those of them that the FIR path wrote
}

// ---- the three vectors ------------------------------------------------------------

// Ensures room for one more slot, growing to the largest of VEC_MIN_CAP and
// twice the capacity, as every vector of the compiler grows.
fn slots_reserve(slot_vec mut* v) void {
    if (v->len < v->items.len) {
        return;
    }
    u64 mut cap = VEC_MIN_CAP;
    if (v->items.len >= cap) {
        if (v->items.len > containers.U64_MAX / 2) {
            panic("gen.slots_reserve: capacity overflow");
        }
        cap = v->items.len * 2;
    }
    slot mut@ own bigger = new(slot, cap);
    u64 mut i = 0;
    while (i < v->len) {
        bigger[i] = v->items[i];
        i += 1;
    }
    del(v->items);
    v->items = move(bigger);
}

fn slots_push(slot_vec mut* v, slot s) void {
    slots_reserve(v);
    v->items[v->len] = s;
    v->len += 1;
}

fn slots_free(slot_vec mut* v) void {
    del(v->items);
    v->len = 0;
}

fn records_reserve(record_vec mut* v) void {
    if (v->len < v->items.len) {
        return;
    }
    u64 mut cap = VEC_MIN_CAP;
    if (v->items.len >= cap) {
        if (v->items.len > containers.U64_MAX / 2) {
            panic("gen.records_reserve: capacity overflow");
        }
        cap = v->items.len * 2;
    }
    record mut@ own bigger = new(record, cap);
    u64 mut i = 0;
    while (i < v->len) {
        bigger[i] = v->items[i];
        i += 1;
    }
    del(v->items);
    v->items = move(bigger);
}

fn records_push(record_vec mut* v, record r) void {
    records_reserve(v);
    v->items[v->len] = r;
    v->len += 1;
}

// The record at `i`. An index at or past len is a violated precondition and
// panics, since the slots beyond len hold stale records.
fn records_at(record_vec* v, u64 i) record {
    if (i >= v->len) {
        panic("gen.records_at: index out of range");
    }
    return v->items[i];
}

fn records_free(record_vec mut* v) void {
    del(v->items);
    v->len = 0;
}

fn syms_reserve(sym_vec mut* v) void {
    if (v->len < v->items.len) {
        return;
    }
    u64 mut cap = VEC_MIN_CAP;
    if (v->items.len >= cap) {
        if (v->items.len > containers.U64_MAX / 2) {
            panic("gen.syms_reserve: capacity overflow");
        }
        cap = v->items.len * 2;
    }
    ast.sym* mut@ own bigger = new(ast.sym*, cap);
    u64 mut i = 0;
    while (i < v->len) {
        bigger[i] = v->items[i];
        i += 1;
    }
    del(v->items);
    v->items = move(bigger);
}

fn syms_push(sym_vec mut* v, ast.sym* s) void {
    syms_reserve(v);
    v->items[v->len] = s;
    v->len += 1;
}

// The symbol at `i`, with the precondition records_at has.
fn syms_at(sym_vec* v, u64 i) ast.sym* {
    if (i >= v->len) {
        panic("gen.syms_at: index out of range");
    }
    return v->items[i];
}

fn syms_free(sym_vec mut* v) void {
    del(v->items);
    v->len = 0;
}

// The scope stack and the deferred-statement list grow like every other
// vector of this module.
fn scopes_reserve(scope_vec mut* v) void {
    if (v->len < v->items.len) {
        return;
    }
    u64 mut cap = VEC_MIN_CAP;
    if (v->items.len >= cap) {
        if (v->items.len > containers.U64_MAX / 2) {
            panic("gen.scopes_reserve: capacity overflow");
        }
        cap = v->items.len * 2;
    }
    block_scope mut@ own bigger = new(block_scope, cap);
    u64 mut i = 0;
    while (i < v->len) {
        bigger[i] = v->items[i];
        i += 1;
    }
    del(v->items);
    v->items = move(bigger);
}

fn scopes_push(scope_vec mut* v, block_scope s) void {
    scopes_reserve(v);
    v->items[v->len] = s;
    v->len += 1;
}

// The scope at `i`, with the precondition records_at has.
fn scopes_at(scope_vec* v, u64 i) block_scope {
    if (i >= v->len) {
        panic("gen.scopes_at: index out of range");
    }
    return v->items[i];
}

// Drops the innermost scope and answers it. An empty stack is a violated
// precondition and panics.
fn scopes_pop(scope_vec mut* v) block_scope {
    if (v->len == 0) {
        panic("gen.scopes_pop: no open scope");
    }
    v->len -= 1;
    return v->items[v->len];
}

fn scopes_free(scope_vec mut* v) void {
    del(v->items);
    v->len = 0;
}

fn refs_reserve(node_ref_vec mut* v) void {
    if (v->len < v->items.len) {
        return;
    }
    u64 mut cap = VEC_MIN_CAP;
    if (v->items.len >= cap) {
        if (v->items.len > containers.U64_MAX / 2) {
            panic("gen.refs_reserve: capacity overflow");
        }
        cap = v->items.len * 2;
    }
    ast.node* mut@ own bigger = new(ast.node*, cap);
    u64 mut i = 0;
    while (i < v->len) {
        bigger[i] = v->items[i];
        i += 1;
    }
    del(v->items);
    v->items = move(bigger);
}

fn refs_push(node_ref_vec mut* v, ast.node* n) void {
    refs_reserve(v);
    v->items[v->len] = n;
    v->len += 1;
}

// The node at `i`, with the precondition records_at has.
fn refs_at(node_ref_vec* v, u64 i) ast.node* {
    if (i >= v->len) {
        panic("gen.refs_at: index out of range");
    }
    return v->items[i];
}

fn refs_free(node_ref_vec mut* v) void {
    del(v->items);
    v->len = 0;
}

// ---- the argument list of one call ------------------------------------------------

fn gen_args_init() gen_args {
    return gen_args{};
}

fn gen_args_free(gen_args mut* a) void {
    strbuf.free(&a->text);
    a->count = 0;
}

// Appends `<ty> <val>`. The _ext form inserts the parameter attribute, as in `i8 zeroext 10`. An
// empty `attr` means no attribute. bootstrap0/src/gen.h uses NULL for this case.
fn gen_args_add_ext(gen_args mut* a, gen_val v, string attr) void {
    if (a->count > 0) {
        strbuf.append(&a->text, ", ");
    }
    strbuf.append(&a->text, v.ty);
    if (attr.len > 0) {
        strbuf.push(&a->text, ' ');
        strbuf.append(&a->text, attr);
    }
    strbuf.push(&a->text, ' ');
    strbuf.append(&a->text, v.val);
    a->count += 1;
}

fn gen_args_add(gen_args mut* a, gen_val v) void {
    gen_args_add_ext(a, v, "");
}

// Returns the argument text built so far.
fn gen_args_text(gen_args* a) string {
    return strbuf.view(&a->text);
}

// ---- the emitter ------------------------------------------------------------------

// Prepares an emitter that reports through `s`. Leaves fields that already have the correct zero
// value unchanged. types.type_table_init does the same. This function sets only the fields that
// gen_init sets to nonzero values. The one type node the emitter builds itself is the `char` a
// `string`'s elements are, which `string` does not carry.
fn gen_init(emitter mut* g, session.session mut* s, gen_options opts) void {
    g->opts = opts;
    g->sess = s;
    reset_state(g);
    g->char_type.kind = types.type_kind.k_prim;
    g->char_type.prim = prim.prim_kind.prim_char;
}

// The scalar state of an emitter, set to what a fresh one holds. bootstrap0/src/gen.c initializes
// every field over raw storage. Here, `emitter{}` creates empty buffers and vectors. gen_free
// empties them again. This function resets the remaining fields. This reset makes an emitter
// reusable. An `init` after `free` must match the first `init`. A stale `failed` value would
// suppress all later output.
fn reset_state(emitter mut* g) void {
    g->temps = 0;
    g->labels = 0;
    g->tmps = 0;
    g->terminated = false;
    g->break_label = 0;
    g->continue_label = 0;
    g->has_break = false;
    g->has_continue = false;
    g->defer_floor = 0;
    g->module = null;
    g->ck = null;
    g->failed = false;
    g->functions = 0;
    g->lowered = 0;
    u64 mut i = 0;
    while (i < IN_COUNT) {
        g->intrinsics[i] = false;
        i += 1;
    }
    i = 0;
    while (i < ATTR_COUNT) {
        g->attrs[i] = false;
        i += 1;
    }
}

fn gen_free(emitter mut* g) void {
    strbuf.free(&g->named);
    strbuf.free(&g->globals);
    strbuf.free(&g->funcs);
    strbuf.free(&g->out);
    strbuf.free(&g->allocas);
    strbuf.free(&g->body);
    strbuf.free(&g->fail);
    slots_free(&g->slots);
    scopes_free(&g->scopes);
    refs_free(&g->defers);
    records_free(&g->files);
    records_free(&g->strs);
    records_free(&g->enums);
    syms_free(&g->externs);
    containers.pool_free(&g->pool);
    strbuf.free(&g->scratch);
    // Each buffer and list is now empty. Reset the remaining state so a caller can initialize the
    // emitter again. bootstrap0/src/gen.c omits this because it never reuses an emitter.
    reset_state(g);
}

// Copies the scratch text and clears the scratch buffer.
fn gen_take(emitter mut* g) string {
    string s = containers.pool_intern(&g->pool, strbuf.view(&g->scratch));
    strbuf.clear(&g->scratch);
    return s;
}

// Returns the emitted module text.
fn gen_text(emitter* g) string {
    return strbuf.view(&g->out);
}

// Reports an unsupported construct and marks the module as failed.
fn gen_todo(emitter mut* g, diag.loc at, string what) void {
    strbuf.clear(&g->scratch);
    strbuf.append(&g->scratch, "the bootstrap compiler cannot generate code yet for ");
    strbuf.append(&g->scratch, what);
    diag.error(session.diags(g->sess), at, strbuf.view(&g->scratch));
    strbuf.clear(&g->scratch);
    g->failed = true;
}

// ---- types ---------------------------------------------------------------

// Whether `t` lives in a place rather than in a register: a struct, fixed
// array, span or `string`.
fn gen_is_aggregate(types.node* t) bool {
    // only scalars are SSA values
    return t != null && (t->kind == types.type_kind.k_array ||
                         t->kind == types.type_kind.k_span ||
                         t->kind == types.type_kind.k_string ||
                         t->kind == types.type_kind.k_struct);
}

// The bit width of an integer, `char`, `bool` or enum type: what a `trunc`
// or an extension compares.
fn gen_int_bits(types.node* t) u32 {
    if (t == null) {
        return 0;
    }
    if (t->kind == types.type_kind.k_enum) {
        return cast(4 * prim.PRIM_BITS_PER_BYTE, u32);
    }
    if (t->kind != types.type_kind.k_prim) {
        return 0;
    }
    if (t->prim == prim.prim_kind.prim_bool) {
        return 1;
    }
    return prim.prim_size(t->prim) * cast(prim.PRIM_BITS_PER_BYTE, u32);
}

// Returns whether values of `t` use signed comparisons, extension, and printing. This includes four
// signed integers and every enum. `char` is unsigned. `bool` is 0 or 1. An enum uses signed `i32`.
// Uses one predicate for both operations. Separate predicates could make a folded member constant
// disagree with its widening cast.
fn gen_is_signed(types.node* t) bool {
    if (t == null) {
        return false;
    }
    if (t->kind == types.type_kind.k_enum) {
        // a member may be negative, so constants print signed
        return true;
    }
    return t->kind == types.type_kind.k_prim && prim.prim_is_signed(t->prim);
}

// The dotted name of a nominal type declaration, such as `%struct.main.point`.
fn nominal_type_name(emitter mut* g, types.node* t) string {
    ast.sym* s = check.nominal_sym(t);
    // The dotted name is built first: gen_symbol builds its own text in the
    // same scratch buffer.
    string mut dotted = "";
    if (s != null) {
        dotted = gen_symbol(g, s);
    }
    if (dotted == ENUM_MEMBER_STRUCT) {
        return ENUM_MEMBER_TYPE;
    }
    strbuf.clear(&g->scratch);
    strbuf.push(&g->scratch, '%');
    gen_append_name(&g->scratch, "struct.", dotted, false);
    return gen_take(g);
}

// Returns the memory type of `t` for an alloca, global, or field. `bool` uses `i8`. Spans and
// strings use `%fort.span`. A fixed array uses `[N x T]`.
fn gen_mem_type(emitter mut* g, types.node* t) string {
    if (t == null) {
        return "void";
    }
    switch (t->kind) {
    case types.type_kind.k_void:
        return "void";
    case types.type_kind.k_prim:
        return prim_mem_type(t->prim);
    case types.type_kind.k_ptr, types.type_kind.k_voidptr, types.type_kind.k_fn:
        return "ptr";
    case types.type_kind.k_array:
        // `i32[3][4]` is `[3 x [4 x i32]]`, nesting outside in
        return array_mem_type(g, t);
    case types.type_kind.k_span, types.type_kind.k_string:
        return SPAN_TYPE;
    case types.type_kind.k_struct:
        return nominal_type_name(g, t);
    case types.type_kind.k_enum:
        return "i32";
    case types.type_kind.k_null:
        return "ptr";
    case types.type_kind.k_error:
        return "void";
    }
}

// Returns the memory type of a primitive. This separate switch arm replaces the nested C switch
// because fort cases do not fall through.
fn prim_mem_type(prim.prim_kind k) string {
    switch (k) {
    case prim.prim_kind.prim_i8, prim.prim_kind.prim_u8, prim.prim_kind.prim_char,
         prim.prim_kind.prim_bool:
        return "i8";
    case prim.prim_kind.prim_i16, prim.prim_kind.prim_u16:
        return "i16";
    case prim.prim_kind.prim_i32, prim.prim_kind.prim_u32:
        return "i32";
    case prim.prim_kind.prim_i64, prim.prim_kind.prim_u64:
        return "i64";
    case prim.prim_kind.prim_f32:
        return "float";
    case prim.prim_kind.prim_f64:
        return "double";
    case prim.prim_kind.prim_void:
        return "void";
    }
}

// `[N x T]` for a fixed array, the element type built before the brackets
// since it is built in the same scratch buffer.
fn array_mem_type(emitter mut* g, types.node* t) string {
    string elem = gen_mem_type(g, t->elem);
    strbuf.clear(&g->scratch);
    strbuf.push(&g->scratch, '[');
    strbuf.append_u64(&g->scratch, t->len);
    strbuf.append(&g->scratch, " x ");
    strbuf.append(&g->scratch, elem);
    strbuf.push(&g->scratch, ']');
    return gen_take(g);
}

// The value type of `t`, what a temporary holds: `i1` for `bool`.
fn gen_value_type(emitter mut* g, types.node* t) string {
    if (t != null && t->kind == types.type_kind.k_prim && t->prim == prim.prim_kind.prim_bool) {
        return "i1";
    }
    return gen_mem_type(g, t);
}

// The IR type of a function's result: `void` for an aggregate result, which
// is returned through the `sret` pointer.
fn gen_result_type(emitter mut* g, types.node* t) string {
    if (gen_is_aggregate(t)) {
        // An aggregate result is a leading `sret` pointer on a function whose
        // result type is `void`.
        return "void";
    }
    return gen_value_type(g, t);
}

// The parameter attribute, or the empty string: `zeroext` for
// `bool`, `char`, `u8` and `u16`, `signext` for `i8` and `i16`.
fn gen_ext_attr(types.node* t) string {
    if (t == null || t->kind != types.type_kind.k_prim) {
        return "";
    }
    switch (t->prim) {
    case prim.prim_kind.prim_bool, prim.prim_kind.prim_char, prim.prim_kind.prim_u8,
         prim.prim_kind.prim_u16:
        // `bool`, `char`, `u8` and `u16` carry `zeroext`.
        return "zeroext";
    case prim.prim_kind.prim_i8, prim.prim_kind.prim_i16:
        return "signext";
    case prim.prim_kind.prim_i32, prim.prim_kind.prim_i64, prim.prim_kind.prim_u32,
         prim.prim_kind.prim_u64, prim.prim_kind.prim_f32, prim.prim_kind.prim_f64,
         prim.prim_kind.prim_void:
        return "";
    }
}

// ---- names ---------------------------------------------------------------

// Returns a field's position among k_field_decl children. The named type uses this order. Constant
// initializers use the same field index. The one map from a field symbol to its index: a second one
// would let the initializer's order drift from the named type's.
fn gen_field_index(ast.sym* field, u64 mut* out) bool {
    ast.sym* mut owner = null;
    if (field != null) {
        owner = field->owner;
    }
    if (owner == null || owner->node == null) {
        return false;
    }
    u64 mut at = 0;
    u64 mut i = 0;
    while (i < ast.ast_len(owner->node)) {
        ast.node* f = ast.ast_child(owner->node, i);
        if (f->kind == ast.ast_kind.k_field_decl) {
            if (cast(f->sym, ast.sym*) == field) {
                *out = at;
                return true;
            }
            at += 1;
        }
        i += 1;
    }
    return false;
}

// Returns the declaration's ELF symbol. A fort symbol joins its dotted module path and name, such
// as `main.add`. An `extern` function uses its unmangled C name.
fn gen_symbol(emitter mut* g, ast.sym* s) string {
    if (s == null) {
        return "";
    }
    if (s->kind == ast.sym_kind.s_extern_fn) {
        return s->name;
    }
    strbuf.clear(&g->scratch);
    if (s->owner != null && s->owner->kind == ast.sym_kind.s_module) {
        // the module path, a dot and the declaration name
        strbuf.append(&g->scratch, s->owner->name);
        strbuf.push(&g->scratch, '.');
    }
    strbuf.append(&g->scratch, s->name);
    return gen_take(g);
}

// Returns the operand that names a declaration. A fort symbol uses `@"main.add"`. A C symbol uses
// `@name`. Quotes affect spelling only.
fn gen_symbol_ref(emitter mut* g, ast.sym* s) string {
    string name = gen_symbol(g, s);
    strbuf.clear(&g->scratch);
    strbuf.push(&g->scratch, '@');
    if (s != null && s->kind == ast.sym_kind.s_extern_fn) {
        gen_append_name(&g->scratch, "", name, false);
        return gen_take(g);
    }
    // quoting is spelling only. The ELF symbol is unchanged
    gen_append_name(&g->scratch, "", name, true);
    return gen_take(g);
}

fn append_hex(strbuf.str_buf mut* out, u64 byte) void {
    strbuf.push(out, '\\');
    strbuf.push(out, HEX[byte / HEX_DIGITS]);
    strbuf.push(out, HEX[byte % HEX_DIGITS]);
}

// Returns whether `byte` is valid in an unquoted IR name. LLVM accepts
// `[-a-zA-Z$._][-a-zA-Z$._0-9]*`. Every dotted module path matches the pattern.
fn name_byte_is_plain(char byte, bool first) bool {
    if (byte == '-' || byte == '$' || byte == '.' || byte == '_') {
        return true;
    }
    if ((byte >= 'a' && byte <= 'z') || (byte >= 'A' && byte <= 'Z')) {
        return true;
    }
    return !first && byte >= '0' && byte <= '9';
}

fn name_needs_quotes(string prefix, string name) bool {
    u64 mut at = 0;
    u64 mut i = 0;
    while (i < prefix.len) {
        if (!name_byte_is_plain(prefix[i], at == 0)) {
            return true;
        }
        at += 1;
        i += 1;
    }
    i = 0;
    while (i < name.len) {
        if (!name_byte_is_plain(name[i], at == 0)) {
            return true;
        }
        at += 1;
        i += 1;
    }
    return at == 0;
}

// Appends `<prefix><name>` after an IR name's `@` or `%`. `always` quotes every fort symbol.
// Otherwise, the function quotes only names that LLVM cannot write unquoted. Module paths never
// need this, but entry base names can. Inside quotes, `"`, `\`, and nonprinting bytes use `\XX` hex
// pairs. LLVM decodes each pair to its byte. Therefore, quoting does not change the ELF symbol.
fn gen_append_name(strbuf.str_buf mut* out, string prefix, string name, bool always) void {
    if (!always && !name_needs_quotes(prefix, name)) {
        strbuf.append(out, prefix);
        strbuf.append(out, name);
        return;
    }
    strbuf.push(out, '"');
    strbuf.append(out, prefix);
    u64 mut i = 0;
    while (i < name.len) {
        u64 byte = cast(name[i], u64);
        // LLVM reads `\XX` back, so the ELF symbol is the name
        if (byte < PRINTABLE_FIRST || byte > PRINTABLE_LAST || name[i] == '"' ||
            name[i] == '\\') {
            append_hex(out, byte);
        } else {
            strbuf.push(out, name[i]);
        }
        i += 1;
    }
    strbuf.push(out, '"');
}

// ---- emission primitives ----------------------------------------------------------

fn gen_text_append(emitter mut* g, string s) void {
    strbuf.append(&g->body, s);
}

fn gen_text_append_u64(emitter mut* g, u64 v) void {
    strbuf.append_u64(&g->body, v);
}

fn gen_text_append_i64(emitter mut* g, i64 v) void {
    strbuf.append_i64(&g->body, v);
}

// Begins an instruction that produces none: two spaces of indent.
fn gen_ins(emitter mut* g) void {
    strbuf.append(&g->body, "  ");
}

// Ends the instruction being written.
fn gen_ins_end(emitter mut* g) void {
    strbuf.push(&g->body, '\n');
}

// Begins an instruction that produces a value: `  %tN = `, and names it.
fn gen_temp(emitter mut* g, string ty) gen_val {
    // `%t<N>` in emission order, per function
    strbuf.clear(&g->scratch);
    strbuf.append(&g->scratch, "%t");
    strbuf.append_u64(&g->scratch, g->temps);
    g->temps += 1;
    gen_val mut v = gen_val{};
    v.ty = ty;
    v.val = gen_take(g);
    strbuf.append(&g->body, "  ");
    strbuf.append(&g->body, v.val);
    strbuf.append(&g->body, " = ");
    return v;
}

// ---- values -----------------------------------------------------------------------

// A value with the given type and literal text (`null`, `true`, `0`).
fn gen_literal(emitter mut* g, string ty, string text) gen_val {
    gen_val mut v = gen_val{};
    v.ty = ty;
    v.val = containers.pool_intern(&g->pool, text);
    return v;
}

// An integer literal printed with the signedness of its fort type: `i8 -1` for
// an `i8` and `i8 255` for a `u8`.
fn gen_const_signed(emitter mut* g, string ty, i64 v) gen_val {
    strbuf.clear(&g->scratch);
    strbuf.append_i64(&g->scratch, v);
    gen_val mut out = gen_val{};
    out.ty = ty;
    out.val = gen_take(g);
    return out;
}

fn gen_const_unsigned(emitter mut* g, string ty, u64 v) gen_val {
    strbuf.clear(&g->scratch);
    strbuf.append_u64(&g->scratch, v);
    gen_val mut out = gen_val{};
    out.ty = ty;
    out.val = gen_take(g);
    return out;
}

// Builds a negative constant from its magnitude. Thus, the code never negates the 2^63 magnitude of
// `i64` MIN in a signed type.
fn const_negative(emitter mut* g, string ty, u64 magnitude) gen_val {
    strbuf.clear(&g->scratch);
    strbuf.push(&g->scratch, '-');
    strbuf.append_u64(&g->scratch, magnitude);
    gen_val mut out = gen_val{};
    out.ty = ty;
    out.val = gen_take(g);
    return out;
}

// The low `bits` of `x` as the fort type reads them: sign-extended for a signed
// type, zero-extended otherwise. The magnitude of a negative value is the two's
// complement of the pattern, computed in unsigned arithmetic so that every width
// behaves alike.
fn const_bits(emitter mut* g, string ty, u64 x, u32 bits, bool sign) gen_val {
    u32 mut width = bits;
    if (bits == 0 || bits > BITS_PER_U64) {
        width = BITS_PER_U64;
    }
    u64 mut mask = containers.U64_MAX;
    if (width != BITS_PER_U64) {
        mask = (cast(1, u64) << width) - 1;
    }
    u64 low = x & mask;
    if (sign && (low & (cast(1, u64) << (width - 1))) != 0) {
        return const_negative(g, ty, (~low & mask) + 1);
    }
    return gen_const_unsigned(g, ty, low);
}

// The smallest value of a signed type of `bits` bits, printed as a signed
// decimal: the operand that the division check compares against. It is
// built from the bit pattern, since negating the magnitude of `i64` MIN
// overflows the type that would hold it.
fn gen_const_min(emitter mut* g, string ty, u32 bits) gen_val {
    // `i8` MIN is -128 and `i64` MIN -9223372036854775808
    return const_bits(g, ty, cast(1, u64) << (bits - 1), bits, true);
}

// The value of a folded constant of type `t` (check.ANN_CONST): an integer,
// `bool`, `char`, `null` or an enum member. A string constant is not a scalar
// and has no value form.
fn gen_const_value(emitter mut* g, types.node* t, consts.cval v) gen_val {
    string ty = gen_value_type(g, t);
    if (t != null && types.type_is_float(t)) {
        return gen_const_float(g, ty, t, v);
    }
    if (v.kind == consts.cval_kind.cv_bool) {
        if (v.mag != 0) {
            return gen_literal(g, ty, "true");
        }
        return gen_literal(g, ty, "false");
    }
    if (v.kind == consts.cval_kind.cv_null) {
        return gen_literal(g, ty, "null");
    }
    if (t != null && (t->kind == types.type_kind.k_ptr || t->kind == types.type_kind.k_voidptr ||
                      t->kind == types.type_kind.k_fn)) {
        return gen_literal(g, ty, "null");
    }
    // a char in an integer context is its code point
    return const_bits(g, ty, consts.cv_bits(consts.cv_as_int(v)), gen_int_bits(t),
                      gen_is_signed(t));
}

// Writes a float constant as `0x` plus 16 binary64 hex digits. LLVM uses this form for both `float`
// and `double` literals. A `float` carries the pattern of the binary64 its value equals exactly,
// which an f32 constant always is. An integer reaches here when the checker gives an untyped
// constant a float type. Convert it to that type first, as the checker does.
fn gen_const_float(emitter mut* g, string ty, types.node* t, consts.cval v) gen_val {
    consts.cval mut f = v;
    if (!consts.cv_is_float(v)) {
        if (!consts.cv_to_float(v, t->prim, &f)) {
            // the checker already reported it, so this is unreachable
            gen_todo(g, diag.loc{}, "a float constant that is not finite");
            return gen_literal(g, ty, "0.0");
        }
    }
    strbuf.clear(&g->scratch);
    flt.flt_hex(consts.cv_float_bits(f), &g->scratch);
    return gen_literal(g, ty, gen_take(g));
}

// Writes a constant in memory form for a global initializer or field. A `bool` uses `i8 0` or `i8
// 1`, not value-form `i1 true`.
fn gen_const_mem_value(emitter mut* g, types.node* t, consts.cval v) gen_val {
    // The memory type is asked for first, since gen_const_value builds its own
    // text in the same scratch buffer.
    string ty = gen_mem_type(g, t);
    if (v.kind == consts.cval_kind.cv_bool) {
        // a `bool` in memory is 0 or 1 in an `i8`
        u64 mut bit = 0;
        if (v.mag != 0) {
            bit = 1;
        }
        return gen_const_unsigned(g, ty, bit);
    }
    gen_val mut out = gen_const_value(g, t, v);
    out.ty = ty;
    return out;
}

// `  %tN = <op> <ty> <a>, <b>`, the shape every arithmetic and bitwise
// instruction has.
fn gen_binary(emitter mut* g, string op, gen_val a, gen_val b) gen_val {
    gen_val r = gen_temp(g, a.ty);
    strbuf.append(&g->body, op);
    strbuf.push(&g->body, ' ');
    strbuf.append(&g->body, a.ty);
    strbuf.push(&g->body, ' ');
    strbuf.append(&g->body, a.val);
    strbuf.append(&g->body, ", ");
    strbuf.append(&g->body, b.val);
    strbuf.push(&g->body, '\n');
    return r;
}

// `  %tN = icmp <pred> <ty> <a>, <b>`, whose result is `i1`.
fn gen_icmp(emitter mut* g, string pred, gen_val a, gen_val b) gen_val {
    gen_val r = gen_temp(g, "i1");
    strbuf.append(&g->body, "icmp ");
    strbuf.append(&g->body, pred);
    strbuf.push(&g->body, ' ');
    strbuf.append(&g->body, a.ty);
    strbuf.push(&g->body, ' ');
    strbuf.append(&g->body, a.val);
    strbuf.append(&g->body, ", ");
    strbuf.append(&g->body, b.val);
    strbuf.push(&g->body, '\n');
    return r;
}

// `  %tN = fcmp <pred> <ty> <a>, <b>`, whose result is `i1`. The predicate
// carries the NaN rule and no fast-math flag is ever written beside it.
fn gen_fcmp(emitter mut* g, string pred, gen_val a, gen_val b) gen_val {
    gen_val r = gen_temp(g, "i1");
    strbuf.append(&g->body, "fcmp ");
    strbuf.append(&g->body, pred);
    strbuf.push(&g->body, ' ');
    strbuf.append(&g->body, a.ty);
    strbuf.push(&g->body, ' ');
    strbuf.append(&g->body, a.val);
    strbuf.append(&g->body, ", ");
    strbuf.append(&g->body, b.val);
    strbuf.push(&g->body, '\n');
    return r;
}

// `  %tN = <op> <ty> <a>`, an instruction with one operand and the operand's
// type: `fneg` is the only one. No fast-math flag.
fn gen_unary_op(emitter mut* g, string op, gen_val a) gen_val {
    gen_val r = gen_temp(g, a.ty);
    strbuf.append(&g->body, op);
    strbuf.push(&g->body, ' ');
    strbuf.append(&g->body, a.ty);
    strbuf.push(&g->body, ' ');
    strbuf.append(&g->body, a.val);
    strbuf.push(&g->body, '\n');
    return r;
}

// `  %tN = <op> <ty> <a> to <to>`: trunc, zext, sext, ptrtoint, inttoptr
fn gen_cast_op(emitter mut* g, string op, gen_val a, string to) gen_val {
    gen_val r = gen_temp(g, to);
    strbuf.append(&g->body, op);
    strbuf.push(&g->body, ' ');
    strbuf.append(&g->body, a.ty);
    strbuf.push(&g->body, ' ');
    strbuf.append(&g->body, a.val);
    strbuf.append(&g->body, " to ");
    strbuf.append(&g->body, to);
    strbuf.push(&g->body, '\n');
    return r;
}

// Narrows or widens `v` from `from` bits to the `to`-bit type `ty`, by
// `sign`, and emits nothing when the widths already agree.
fn gen_resize(emitter mut* g, gen_val v, u32 from, string ty, u32 to, bool sign) gen_val {
    if (from == to) {
        // A narrow value is not widened to 32 bits: its width is in its type
        return v;
    }
    if (from > to) {
        return gen_cast_op(g, "trunc", v, ty);
    }
    // Widening reads the source's signedness.
    if (sign) {
        return gen_cast_op(g, "sext", v, ty);
    }
    return gen_cast_op(g, "zext", v, ty);
}

// `  %tN = load <ty>, ptr <addr>, align <n>`.
fn gen_load(emitter mut* g, string ty, gen_val addr, u64 align) gen_val {
    gen_val r = gen_temp(g, ty);
    strbuf.append(&g->body, "load ");
    strbuf.append(&g->body, ty);
    strbuf.append(&g->body, ", ptr ");
    strbuf.append(&g->body, addr.val);
    // Every load and store carries an explicit alignment.
    strbuf.append(&g->body, ", align ");
    strbuf.append_u64(&g->body, align);
    strbuf.push(&g->body, '\n');
    return r;
}

fn gen_store(emitter mut* g, gen_val v, gen_val addr, u64 align) void {
    strbuf.append(&g->body, "  store ");
    strbuf.append(&g->body, v.ty);
    strbuf.push(&g->body, ' ');
    strbuf.append(&g->body, v.val);
    strbuf.append(&g->body, ", ptr ");
    strbuf.append(&g->body, addr.val);
    strbuf.append(&g->body, ", align ");
    strbuf.append_u64(&g->body, align);
    strbuf.push(&g->body, '\n');
}

// Whether a place holds a `bool`, which is `i8` in memory and `i1` as a value:
// the one question both gen_load_place and gen_store_place ask.
fn place_is_bool(types.node* t) bool {
    return t != null && t->kind == types.type_kind.k_prim && t->prim == prim.prim_kind.prim_bool;
}

// The scalar value held in a place: a `bool` place is loaded as `i8` and
// truncated.
fn gen_load_place(emitter mut* g, gen_place p) gen_val {
    u64 align = types.type_alignof(p.ty);
    gen_val raw = gen_load(g, gen_mem_type(g, p.ty), p.addr, align);
    if (place_is_bool(p.ty)) {
        return gen_cast_op(g, "trunc", raw, "i1");
    }
    return raw;
}

// Stores a scalar into a place: a `bool` is zero-extended to `i8`.
fn gen_store_place(emitter mut* g, gen_place p, gen_val v) void {
    u64 align = types.type_alignof(p.ty);
    gen_val mut out = v;
    if (place_is_bool(p.ty)) {
        out = gen_cast_op(g, "zext", v, "i8");
    }
    gen_store(g, out, p.addr, align);
}

// ---- the three getelementptr shapes ---------------------------------------

// Opens `  %tN = getelementptr inbounds <ty>, ptr <base>`. A bounds check precedes element access.
// Field access is in bounds by construction.
fn gep_begin(emitter mut* g, string ty, gen_val base) gen_val {
    gen_val r = gen_temp(g, "ptr");
    strbuf.append(&g->body, "getelementptr inbounds ");
    strbuf.append(&g->body, ty);
    strbuf.append(&g->body, ", ptr ");
    strbuf.append(&g->body, base.val);
    return r;
}

// `getelementptr inbounds <arrty>, ptr <base>, i64 0, i64 <index>`: an
// element of a fixed array.
fn gen_gep_array(emitter mut* g, types.node* array, gen_val base, gen_val index) gen_val {
    // The type text is built before the instruction is opened: gen_mem_type
    // writes into the same scratch buffer gen_temp does.
    string ty = gen_mem_type(g, array);
    gen_val r = gep_begin(g, ty, base);
    strbuf.append(&g->body, ", i64 0, i64 ");
    strbuf.append(&g->body, index.val);
    strbuf.push(&g->body, '\n');
    return r;
}

// `getelementptr inbounds <elemty>, ptr <base>, i64 <index>`: an element
// reached through a pointer or a span's `.ptr`.
fn gen_gep_element(emitter mut* g, types.node* elem, gen_val base, gen_val index) gen_val {
    string ty = gen_mem_type(g, elem);
    gen_val r = gep_begin(g, ty, base);
    strbuf.append(&g->body, ", i64 ");
    strbuf.append(&g->body, index.val);
    strbuf.push(&g->body, '\n');
    return r;
}

// `getelementptr inbounds <ty>, ptr <base>, i32 0, i32 <k>`: a field of a
// struct or a header field of a span.
fn gen_gep_field(emitter mut* g, string ty, gen_val base, u64 k) gen_val {
    gen_val r = gep_begin(g, ty, base);
    strbuf.append(&g->body, ", i32 0, i32 ");
    strbuf.append_u64(&g->body, k);
    strbuf.push(&g->body, '\n');
    return r;
}

// ---- the span header -----------------------------------------------------

// Returns a span or `string` header field. Field 0 is the pointer, and field 1 is the length. All
// readers and writers use this layout helper.
fn gen_span_ptr(emitter mut* g, gen_val base) gen_val {
    // field 0 is the pointer
    gen_val field = gen_gep_field(g, SPAN_TYPE, base, SPAN_FIELD_PTR);
    return gen_load(g, "ptr", field, PTR_BYTES);
}

fn gen_span_len(emitter mut* g, gen_val base) gen_val {
    // field 1 is the length, a `u64`
    gen_val field = gen_gep_field(g, SPAN_TYPE, base, SPAN_FIELD_LEN);
    return gen_load(g, "i64", field, LEN_BYTES);
}

fn gen_span_init(emitter mut* g, gen_val base, gen_val ptr, gen_val len) void {
    // The header is written field by field, pointer first.
    gen_val pf = gen_gep_field(g, SPAN_TYPE, base, SPAN_FIELD_PTR);
    gen_store(g, ptr, pf, PTR_BYTES);
    gen_val lf = gen_gep_field(g, SPAN_TYPE, base, SPAN_FIELD_LEN);
    gen_store(g, len, lf, LEN_BYTES);
}

// ---- aggregates ----------------------------------------------------------

// `llvm.memcpy` of `size` bytes from `src` to `dst`, the copy of every
// aggregate.
fn gen_memcpy(emitter mut* g, gen_val dst, u64 dst_align, gen_val src, u64 src_align,
                   u64 size) void {
    gen_use_intrinsic(g, IN_MEMCPY);
    gen_use_attr(g, ATTR_MEMCPY);
    strbuf.append(&g->body, "  call void @llvm.memcpy.p0.p0.i64(ptr align ");
    strbuf.append_u64(&g->body, dst_align);
    strbuf.push(&g->body, ' ');
    strbuf.append(&g->body, dst.val);
    strbuf.append(&g->body, ", ptr align ");
    strbuf.append_u64(&g->body, src_align);
    strbuf.push(&g->body, ' ');
    strbuf.append(&g->body, src.val);
    strbuf.append(&g->body, ", i64 ");
    strbuf.append_u64(&g->body, size);
    strbuf.append(&g->body, ", i1 false)\n");
}

// `llvm.memset` of `size` zero bytes: `{}`, `del` and `move` zero a place.
fn gen_memset_zero(emitter mut* g, gen_val dst, u64 align, u64 size) void {
    gen_use_intrinsic(g, IN_MEMSET);
    gen_use_attr(g, ATTR_MEMSET);
    strbuf.append(&g->body, "  call void @llvm.memset.p0.i64(ptr align ");
    strbuf.append_u64(&g->body, align);
    strbuf.push(&g->body, ' ');
    strbuf.append(&g->body, dst.val);
    strbuf.append(&g->body, ", i8 0, i64 ");
    strbuf.append_u64(&g->body, size);
    strbuf.append(&g->body, ", i1 false)\n");
}

// ---- blocks -------------------------------------------------------------

// A fresh block label, `%L<N>` in creation order. The number is returned;
// gen_block_begin opens it.
fn gen_label(emitter mut* g) u64 {
    // `%L<N>` in creation order, the entry block excepted
    u64 n = g->labels;
    g->labels += 1;
    return n;
}

// Opens the block `L<n>`: a blank line, the label, and a fresh terminator
// state.
fn gen_block_begin(emitter mut* g, u64 n) void {
    strbuf.push(&g->body, '\n');
    strbuf.push(&g->body, 'L');
    strbuf.append_u64(&g->body, n);
    strbuf.append(&g->body, ":\n");
    g->terminated = false;
}

fn gen_br(emitter mut* g, u64 n) void {
    strbuf.append(&g->body, "  br label %L");
    strbuf.append_u64(&g->body, n);
    strbuf.push(&g->body, '\n');
    g->terminated = true;
}

fn gen_br_cond(emitter mut* g, gen_val cond, u64 t, u64 f) void {
    strbuf.append(&g->body, "  br i1 ");
    strbuf.append(&g->body, cond.val);
    strbuf.append(&g->body, ", label %L");
    strbuf.append_u64(&g->body, t);
    strbuf.append(&g->body, ", label %L");
    strbuf.append_u64(&g->body, f);
    strbuf.push(&g->body, '\n');
    g->terminated = true;
}

// A fort `switch` is one LLVM `switch` on the operand, with one case per label and a default block.
// Indents the case list one level beyond an instruction. The closing `]` aligns with an
// instruction, as in LLVM output.
fn gen_switch_begin(emitter mut* g, gen_val operand, u64 default_label) void {
    strbuf.append(&g->body, "  switch ");
    strbuf.append(&g->body, operand.ty);
    strbuf.push(&g->body, ' ');
    strbuf.append(&g->body, operand.val);
    strbuf.append(&g->body, ", label %L");
    strbuf.append_u64(&g->body, default_label);
    strbuf.append(&g->body, " [\n");
}

fn gen_switch_case(emitter mut* g, gen_val value, u64 label) void {
    strbuf.append(&g->body, "    ");
    strbuf.append(&g->body, value.ty);
    strbuf.push(&g->body, ' ');
    strbuf.append(&g->body, value.val);
    strbuf.append(&g->body, ", label %L");
    strbuf.append_u64(&g->body, label);
    strbuf.push(&g->body, '\n');
}

fn gen_switch_end(emitter mut* g) void {
    strbuf.append(&g->body, "  ]\n");
    g->terminated = true;
}

// ---- private data --------------------------------------------------------

// One record holding `text`, the shape a file name and a string literal take.
fn record_new(string text) record {
    return record{text, null, 0, 0};
}

// `@.<kind>.<n>`, the name of a private datum.
fn data_name(emitter mut* g, string kind, u64 n) string {
    strbuf.clear(&g->scratch);
    strbuf.append(&g->scratch, "@.");
    strbuf.append(&g->scratch, kind);
    strbuf.push(&g->scratch, '.');
    strbuf.append_u64(&g->scratch, n);
    return gen_take(g);
}

// `@.file.N` for the file of `at`, assigned on first use, one per file.
fn gen_file_ref(emitter mut* g, diag.loc at) string {
    string file = at.file;
    u64 mut i = 0;
    while (i < g->files.len) {
        if (records_at(&g->files, i).text == file) {
            return data_name(g, "file", i);
        }
        i += 1;
    }
    // the path exactly as the compiler opened it
    records_push(&g->files, record_new(containers.pool_intern(&g->pool, file)));
    return data_name(g, "file", g->files.len - 1);
}

// `@.str.N` holding `s` with its trailing NUL, assigned on first use and never
// deduplicated by content.
fn gen_str_ref(emitter mut* g, string s) string {
    // assigned on first use, never deduplicated by content
    records_push(&g->strs, record_new(containers.pool_intern(&g->pool, s)));
    return data_name(g, "str", g->strs.len - 1);
}

// The number of members in an enum's table.
fn gen_enum_count(ast.sym* e) u64 {
    if (e == null || e->node == null) {
        return 0;
    }
    u64 mut n = 0;
    u64 mut i = 0;
    while (i < ast.ast_len(e->node)) {
        if (ast.ast_child(e->node, i)->kind == ast.ast_kind.k_enum_member) {
            n += 1;
        }
        i += 1;
    }
    return n;
}

// `@.enum.<path.name>`, the table's name.
fn enum_name(emitter mut* g, ast.sym* e) string {
    // The dotted name is built first: gen_symbol builds its own text in the
    // same scratch buffer.
    string dotted = gen_symbol(g, e);
    strbuf.clear(&g->scratch);
    strbuf.push(&g->scratch, '@');
    gen_append_name(&g->scratch, ".enum.", dotted, false);
    return gen_take(g);
}

// `@.enum.<path.name>` for an enum table emitted once, on first use.
fn gen_enum_ref(emitter mut* g, ast.sym* e) string {
    u64 mut i = 0;
    while (i < g->enums.len) {
        if (records_at(&g->enums, i).sym == e) {
            return enum_name(g, e);
        }
        i += 1;
    }
    // Emit a table only for an enum that a `print` call reaches.
    // Each member name is a separate string constant.
    record mut r = record_new("");
    r.sym = e;
    r.first = g->strs.len;
    r.count = 0;
    i = 0;
    while (e->node != null && i < ast.ast_len(e->node)) {
        ast.node* m = ast.ast_child(e->node, i);
        if (m->kind == ast.ast_kind.k_enum_member) {
            gen_str_ref(g, m->name);
            r.count += 1;
        }
        i += 1;
    }
    records_push(&g->enums, r);
    return enum_name(g, e);
}

// Records an `extern` function in first-use order, once per C name. Two modules can declare it as
// separate symbols that share one ELF symbol. The emitter does not declare runtime functions.
// `std.rt` is in the closure, so the calling module also holds each entry-point definition.
fn gen_use_extern(emitter mut* g, ast.sym* s) void {
    string name = s->name;
    u64 mut i = 0;
    while (i < g->externs.len) {
        // Declares each symbol once. The linker sees the C name. Two modules can hold separate
        // records for one shared ELF symbol.
        if (syms_at(&g->externs, i)->name == name) {
            return;
        }
        i += 1;
    }
    syms_push(&g->externs, s);
}

// ---- signatures ----------------------------------------------------------

/// One parameter of an LLVM signature: its IR type and its extension attribute, which is empty
/// for no attribute. An aggregate parameter is a plain `ptr` with no attribute.
struct sig_param {
    string ty;
    string attr;
}

/// The LLVM signature of a fort function type. Every `define`, every extern `declare` and every
/// `call` is written from it, so that a definition and each call of it have one source.
// `ret` is `void` for a `void` or `noreturn` result and for an aggregate result, which arrives
// through the leading `sret` pointer whose memory type `sret` holds; `sret` is empty otherwise.
// `variadic` is set for an extern whose declaration writes `...`, and `is_extern` for any extern.
struct signature {
    string ret;
    string ret_attr;
    string sret;
    sig_param mut@ own params;
    bool variadic;
    bool is_extern;
    bool no_return;
}

/// The signature of the function type `sig`. `ext` is the `extern fn` whose C form applies, or
/// null for a fort function and for a call through a function pointer.
// A narrow result or parameter carries `zeroext` or `signext`. An aggregate result is a leading
// `ptr sret(%T)`, and an aggregate parameter is a plain `ptr`. The target's C form of an extern
// is the same on both targets: a fixed declaration, and the variadic form only for a declaration
// that writes `...`.
fn signature_of(emitter mut* g, types.node* sig, ast.sym* ext) signature {
    signature mut s = signature{.no_return = sig->is_noreturn};
    s.ret = gen_result_type(g, sig->elem);
    s.ret_attr = gen_ext_attr(sig->elem);
    if (gen_is_aggregate(sig->elem)) {
        s.sret = gen_mem_type(g, sig->elem);
    }
    s.params = new(sig_param, sig->params.len);
    u64 mut i = 0;
    while (i < sig->params.len) {
        types.node* pt = sig->params[i];
        if (gen_is_aggregate(pt)) {
            s.params[i] = sig_param{"ptr", ""};
        } else {
            s.params[i] = sig_param{gen_value_type(g, pt), gen_ext_attr(pt)};
        }
        i += 1;
    }
    if (ext != null) {
        s.is_extern = true;
        s.variadic = ext->node != null && (ext->node->flags & ast.FLAG_VARIADIC) != 0;
    }
    return s;
}

fn signature_free(signature mut* s) void {
    del(s->params);
}

/// The `sret(%T)` attribute of the result pointer of `s`.
fn sret_attr(emitter mut* g, signature* s) string {
    strbuf.clear(&g->scratch);
    strbuf.append(&g->scratch, "sret(");
    strbuf.append(&g->scratch, s->sret);
    strbuf.push(&g->scratch, ')');
    return gen_take(g);
}

// Appends the call type of `s`, such as `(ptr, i32, ...) `: the result pointer and each aggregate
// parameter as `ptr`, and `...` for a variadic extern. A call through a function pointer and a
// variadic extern call write it before the callee.
fn gen_call_type(emitter mut* g, signature* s) void {
    gen_text_append(g, "(");
    u64 mut written = 0;
    if (s->sret.len > 0) {
        gen_text_append(g, "ptr");
        written += 1;
    }
    u64 mut i = 0;
    while (i < s->params.len) {
        if (written > 0) {
            gen_text_append(g, ", ");
        }
        written += 1;
        gen_text_append(g, s->params[i].ty);
        i += 1;
    }
    if (s->variadic) {
        if (written > 0) {
            gen_text_append(g, ", ");
        }
        gen_text_append(g, "...");
    }
    gen_text_append(g, ") ");
}

/// Writes a call of `callee` with the arguments `args` and gives its result, or a `void` value
/// with no name. `pointer` is set for a call through a function pointer. The caller writes the
/// `sret` argument first when `s` has one.
// The call type stands before the callee of a call through a pointer, because an opaque pointer
// carries none, and before a variadic extern, whose call type sets the vector-register count. An
// extern call site carries `#3`. A `noreturn` callee needs the trap after the call, which the
// caller writes.
fn gen_call_sig(emitter mut* g, signature* s, gen_val callee, bool pointer, gen_args* args)
    gen_val {
    gen_val mut r = gen_literal(g, "void", "");
    if (s->ret != "void") {
        r = gen_temp(g, s->ret);
    } else {
        gen_ins(g);
    }
    gen_text_append(g, "call ");
    if (s->ret_attr.len > 0) {
        gen_text_append(g, s->ret_attr);
        gen_text_append(g, " ");
    }
    gen_text_append(g, s->ret);
    gen_text_append(g, " ");
    if (pointer || s->variadic) {
        gen_call_type(g, s);
    }
    gen_text_append(g, callee.val);
    gen_text_append(g, "(");
    gen_text_append(g, gen_args_text(args));
    gen_text_append(g, ")");
    if (s->is_extern) {
        // `#3 = { nobuiltin }` on every extern call site, and on no call of a fort function
        gen_use_attr(g, ATTR_NOBUILTIN);
        gen_text_append(g, " #3");
    }
    gen_ins_end(g);
    return r;
}

/// Writes the first line of the definition of `fn_sym`, whose signature is `s`, into `g->funcs`:
/// `define dso_local <ret> @"m.f"(<params>) #N {`. `names` holds the incoming name of each
/// parameter, `%<ident>.in`.
// A `noreturn` runtime entry takes the cold `#8`, every other `noreturn` function `#1`, and every
// other definition `#0`. The runtime entry is known by its mangled name.
fn gen_define(emitter mut* g, ast.sym* fn_sym, signature* s, string@ names) void {
    if (names.len != s->params.len) {
        panic("gen.gen_define: one name for each parameter");
    }
    runtime_sig.rt_entry rt = runtime_sig.rt_entry_of(gen_symbol(g, fn_sym));
    bool rt_noreturn = rt != runtime_sig.rt_entry.rt_none && runtime_sig.rt_entry_noreturn(rt);
    string callee = gen_symbol_ref(g, fn_sym);
    definition_begin(g);
    strbuf.append(&g->funcs, "define dso_local ");
    if (s->ret_attr.len > 0) {
        strbuf.append(&g->funcs, s->ret_attr);
        strbuf.push(&g->funcs, ' ');
    }
    strbuf.append(&g->funcs, s->ret);
    strbuf.push(&g->funcs, ' ');
    strbuf.append(&g->funcs, callee);
    strbuf.push(&g->funcs, '(');
    u64 mut written = 0;
    if (s->sret.len > 0) {
        strbuf.append(&g->funcs, "ptr sret(");
        strbuf.append(&g->funcs, s->sret);
        strbuf.append(&g->funcs, ") %ret.sret");
        written += 1;
    }
    u64 mut i = 0;
    while (i < s->params.len) {
        if (written > 0) {
            strbuf.append(&g->funcs, ", ");
        }
        written += 1;
        strbuf.append(&g->funcs, s->params[i].ty);
        if (s->params[i].attr.len > 0) {
            strbuf.push(&g->funcs, ' ');
            strbuf.append(&g->funcs, s->params[i].attr);
        }
        strbuf.push(&g->funcs, ' ');
        strbuf.append(&g->funcs, names[i]);
        i += 1;
    }
    strbuf.push(&g->funcs, ')');
    if (s->no_return && rt_noreturn) {
        gen_use_attr(g, ATTR_RT_NORET);
        strbuf.append(&g->funcs, " #8 {\n");
    } else if (s->no_return) {
        gen_use_attr(g, ATTR_FN_NORET);
        strbuf.append(&g->funcs, " #1 {\n");
    } else {
        gen_use_attr(g, ATTR_FN);
        strbuf.append(&g->funcs, " #0 {\n");
    }
}

// ---- definitions ---------------------------------------------------------

// One blank line stands between two definitions.
fn definition_begin(emitter mut* g) void {
    if (strbuf.view(&g->funcs).len > 0) {
        strbuf.push(&g->funcs, '\n');
    }
}

/// Resets the per-function counters and buffers: every name is fixed per function and reset at
/// each definition.
fn function_begin(emitter mut* g) void {
    g->temps = 0;
    g->labels = 0;
    g->tmps = 0;
    g->break_label = 0;
    g->continue_label = 0;
    g->has_break = false;
    g->has_continue = false;
    slots_free(&g->slots);
    // a defer expands inside the function that wrote it
    g->defers.len = 0;
    g->scopes.len = 0;
    g->defer_floor = 0;
    strbuf.clear(&g->allocas);
    strbuf.clear(&g->body);
    strbuf.clear(&g->fail);
    g->terminated = false;
}

/// Appends the entry block, the normal blocks and then the failure blocks, and closes the
/// definition.
fn function_end(emitter mut* g) void {
    strbuf.append(&g->funcs, "entry:\n");
    strbuf.append(&g->funcs, strbuf.view(&g->allocas));
    strbuf.append(&g->funcs, strbuf.view(&g->body));
    strbuf.append(&g->funcs, strbuf.view(&g->fail));
    strbuf.append(&g->funcs, "}\n");
}

// The byte the process status keeps, which is `status & 0xFF`.
u64 STATUS_MASK = 255;

/// Writes `@main`, the C entry point that the start-up code calls, for the entry module's `main`
/// `main_sym`. It takes C's `argc` and `argv` and returns C's `int`.
// It is a definition of this module like any other and carries `dso_local` and `#0`. It calls
// `std.rt.args_init`, then `std.rt.args`, which builds the span in this frame, then the program's
// `main`, then `std.rt.flush_all`, and returns the low status byte. `args_init` runs first, since
// `args` hands out what it built.
fn gen_main(emitter mut* g, ast.sym* main_sym) void {
    function_begin(g);
    gen_use_attr(g, ATTR_FN);
    definition_begin(g);
    strbuf.append(&g->funcs, "define dso_local i32 @main(i32 %argc, ptr %argv) #0 {\n");
    // no fort identifier in the name, `main` being the compiler's
    gen_val mut span = gen_val{};
    span.ty = "ptr";
    span.val = "%args";
    strbuf.append(&g->allocas, "  %args = alloca ");
    strbuf.append(&g->allocas, SPAN_TYPE);
    strbuf.append(&g->allocas, ", align ");
    strbuf.append_u64(&g->allocas, SPAN_ALIGN);
    strbuf.push(&g->allocas, '\n');
    gen_args mut init_args = gen_args_init();
    gen_args_add(&init_args, gen_literal(g, "i32", "%argc"));
    gen_args_add(&init_args, gen_literal(g, "ptr", "%argv"));
    gen_call_rt(g, runtime_sig.rt_entry.rt_args_init, &init_args);
    gen_args_free(&init_args);
    // The hidden result pointer carries `sret`, as it does at every aggregate call.
    gen_args mut args_args = gen_args_init();
    gen_args_add_ext(&args_args, span, "sret(%fort.span)");
    gen_call_rt(g, runtime_sig.rt_entry.rt_args, &args_args);
    gen_args_free(&args_args);
    // The program's `main` takes the span at `%args` when it declares the parameter. The span is
    // the caller-made copy of an aggregate argument, so the callee uses it in place.
    signature mut s = signature_of(g, main_sym->ty, null);
    defer signature_free(&s);
    gen_args mut main_args = gen_args_init();
    if (s.params.len == 1) {
        gen_args_add_ext(&main_args, span, s.params[0].attr);
    }
    gen_val callee = gen_literal(g, "ptr", gen_symbol_ref(g, main_sym));
    gen_val status = gen_call_sig(g, &s, callee, false, &main_args);
    gen_args_free(&main_args);
    gen_args mut flush_args = gen_args_init();
    gen_call_rt(g, runtime_sig.rt_entry.rt_flush_all, &flush_args);
    gen_args_free(&flush_args);
    gen_val masked = gen_binary(g, "and", status, gen_const_unsigned(g, "i32", STATUS_MASK));
    strbuf.append(&g->body, "  ret i32 ");
    strbuf.append(&g->body, masked.val);
    strbuf.push(&g->body, '\n');
    function_end(g);
}

// ---- calls to the runtime ------------------------------------------------

// Appends `@"std.rt.x"(<args>)`. Writes a runtime call as an ordinary fort call by mangled name. It
// quotes the dotted name and adds no call attribute.
fn call_rt_tail(emitter mut* g, runtime_sig.rt_entry rt, gen_args* args) void {
    gen_text_append(g, "@");
    gen_append_name(&g->body, "", runtime_sig.rt_entry_name(rt), true);
    gen_text_append(g, "(");
    gen_text_append(g, gen_args_text(args));
    gen_text_append(g, ")");
    gen_ins_end(g);
}

// A call to a runtime entry point, which the module defines; this
// form emits no result.
fn gen_call_rt(emitter mut* g, runtime_sig.rt_entry rt, gen_args* args) void {
    gen_ins(g);
    gen_text_append(g, "call ");
    gen_text_append(g, runtime_sig.ir_result_text(runtime_sig.rt_entry_result(rt)));
    gen_text_append(g, " ");
    call_rt_tail(g, rt, args);
}

// The same, naming the result.
fn gen_call_rt_value(emitter mut* g, runtime_sig.rt_entry rt, string ret,
                             gen_args* args) gen_val {
    gen_val r = gen_temp(g, ret);
    gen_text_append(g, "call ");
    gen_text_append(g, runtime_sig.ir_result_text(runtime_sig.rt_entry_result(rt)));
    gen_text_append(g, " ");
    call_rt_tail(g, rt, args);
    return r;
}

// ---- checks and failure blocks ------------------------------------------

// The `ptr @.file.N, i32 <line>, i32 <col>` every runtime failure takes: the
// position of the failure, which is the operator's token.
fn gen_args_add_loc(emitter mut* g, gen_args mut* args, diag.loc at) void {
    // the file constant, the line and the column
    string file = gen_file_ref(g, at);
    gen_args_add(args, gen_literal(g, "ptr", file));
    gen_args_add(args, gen_const_unsigned(g, "i32", cast(at.line, u64)));
    gen_args_add(args, gen_const_unsigned(g, "i32", cast(at.col, u64)));
}

// One failure block: the call to the entry point and `unreachable`, and
// nothing else, because the callee aborts. It is written to the
// function's failure buffer, which is appended after every normal block.
fn fail_block(emitter mut* g, u64 label, runtime_sig.rt_entry rt, gen_args* args) void {
    // A failure block is built in the same shape as a normal one, so it is
    // written through the body buffer and moved afterwards.
    u64 mark = strbuf.view(&g->body).len;
    gen_block_begin(g, label);
    gen_call_rt(g, rt, args);
    strbuf.append(&g->body, "  unreachable\n");
    strbuf.append(&g->fail, strbuf.view(&g->body)[mark..]);
    strbuf.truncate(&g->body, mark);
}

// Writes the zero value of an owning place. A pointer or `void*` stores null. A span, string, or
// owning aggregate uses `llvm.memset`. This is the value left by `move`, an implicit return move,
// and `del`. It is not an assignment, so it has no overwrite check.
fn gen_zero_owner(emitter mut* g, gen_place p) void {
    if (gen_is_aggregate(p.ty)) {
        gen_memset_zero(g, p.addr, types.type_alignof(p.ty), types.type_sizeof(p.ty));
        return;
    }
    gen_store_place(g, p, gen_literal(g, "ptr", "null"));
}

// Writes a runtime check. It allocates the continuation label before the failure label. The failure
// block calls `rt`, writes `unreachable`, and follows all normal blocks. `fail_when` is true for
// checks whose `i1` means failure. Their branches name the failure block first. It is false only
// for `assert`, whose operand means success. The caller adds the check's own values to `args`. The
// location is appended here.
fn gen_check(emitter mut* g, gen_val cond, bool fail_when, runtime_sig.rt_entry rt,
                  gen_args mut* args, diag.loc at) void {
    // the continuation label comes before the failure label
    u64 cont = gen_label(g);
    u64 bad = gen_label(g);
    // Each check computes an `i1` that is true on failure, then names the failure label first.
    // `assert` instead provides the success condition.
    if (fail_when) {
        gen_br_cond(g, cond, bad, cont);
    } else {
        gen_br_cond(g, cond, cont, bad);
    }
    gen_args_add_loc(g, args, at);
    fail_block(g, bad, rt, args);
    gen_block_begin(g, cont);
}

// Writes a failure block that no check branch reaches. An enum `switch` without `default` reaches
// it through the switch's default edge. The caller allocated `label`. The block calls `rt` and
// writes `unreachable`. This function adds the location to `args` and writes the failure buffer.
// The caller emits it before later labels.
fn gen_fail_block(emitter mut* g, u64 label, runtime_sig.rt_entry rt, gen_args mut* args,
                       diag.loc at) void {
    gen_args_add_loc(g, args, at);
    fail_block(g, label, rt, args);
}

// Marks an intrinsic or an attribute group used, so that only referenced
// declarations are emitted.
fn gen_use_intrinsic(emitter mut* g, u64 which) void {
    g->intrinsics[which] = true;
}

// The target integer type of a conversion slot.
fn gen_fpconv_int_type(u64 slot) string {
    u64 width = (slot - IN_FPCONV_FIRST) % FP_WIDTHS;
    if (width == 0) {
        return "i8";
    }
    if (width == 1) {
        return "i16";
    }
    if (width == 2) {
        return "i32";
    }
    return "i64";
}

// The source float type of a conversion slot, as a value type.
fn gen_fpconv_float_type(u64 slot) string {
    u64 family = (slot - IN_FPCONV_FIRST) / FP_WIDTHS;
    if (family == FP_SI_F32 || family == FP_UI_F32) {
        return "float";
    }
    return "double";
}

// Returns a conversion name such as `llvm.fptosi.sat.i32.f64`. LLVM 18 uses `f32` or `f64` suffixes
// where type text uses `float` or `double`.
fn gen_fpconv_name(strbuf.str_buf mut* out, u64 slot) void {
    u64 family = (slot - IN_FPCONV_FIRST) / FP_WIDTHS;
    strbuf.append(out, "llvm.");
    if (family == FP_SI_F32 || family == FP_SI_F64) {
        strbuf.append(out, "fptosi.sat.");
    } else {
        strbuf.append(out, "fptoui.sat.");
    }
    strbuf.append(out, gen_fpconv_int_type(slot));
    if (family == FP_SI_F32 || family == FP_UI_F32) {
        strbuf.append(out, ".f32");
    } else {
        strbuf.append(out, ".f64");
    }
}

// The same name written into the instruction being built, which is what a
// call site needs.
fn gen_fpconv_call_name(emitter mut* g, u64 slot) void {
    gen_fpconv_name(&g->body, slot);
}

fn gen_use_attr(emitter mut* g, u64 which) void {
    g->attrs[which] = true;
}

// Whether an intrinsic or an attribute group is one the module refers to.
fn gen_uses_intrinsic(emitter* g, u64 which) bool {
    return g->intrinsics[which];
}

fn gen_uses_attr(emitter* g, u64 which) bool {
    return g->attrs[which];
}

// ---- slots --------------------------------------------------------------

// The name of a local's or a parameter's storage, under the spelling the IR
// names take.
fn slot_name(emitter mut* g, ast.sym* s, u64 at, bool incoming) string {
    strbuf.clear(&g->scratch);
    strbuf.push(&g->scratch, '%');
    strbuf.append(&g->scratch, s->name);
    strbuf.push(&g->scratch, '.');
    if (incoming) {
        // a parameter arrives as `%<ident>.in`
        strbuf.append(&g->scratch, "in");
    } else {
        strbuf.append_u64(&g->scratch, at);
    }
    return gen_take(g);
}

// Records the place of a local or parameter.
fn slot_add(emitter mut* g, ast.sym* s, string name) void {
    slots_push(&g->slots, slot{s, name});
}

// The place of a local or parameter, whose storage gen_function made. A symbol
// with no slot is a broken precondition and panics, where bootstrap0/src/gen.c
// calls fatal_internal.
fn gen_slot_place(emitter mut* g, ast.sym* s) gen_place {
    gen_place mut p = gen_place{};
    p.addr.ty = "ptr";
    p.addr.val = "";
    if (s != null) {
        p.ty = s->ty;
    }
    u64 mut i = 0;
    while (i < g->slots.len) {
        if (g->slots.items[i].sym == s) {
            p.addr.val = g->slots.items[i].name;
            return p;
        }
        i += 1;
    }
    panic("gen.gen_slot_place: a local with no slot");
}

// The same, for a place with no fort type: the `i64` counter of a range `for`,
// whose memory type and alignment are given directly.
fn gen_temp_place_raw(emitter mut* g, string mem_type, u64 align) gen_place {
    // `%tmp<K>` has no dot, so it cannot collide with a local
    strbuf.clear(&g->scratch);
    strbuf.append(&g->scratch, "%tmp");
    strbuf.append_u64(&g->scratch, g->tmps);
    g->tmps += 1;
    gen_place mut p = gen_place{};
    p.addr.ty = "ptr";
    p.addr.val = gen_take(g);
    p.ty = null;
    strbuf.append(&g->allocas, "  ");
    strbuf.append(&g->allocas, p.addr.val);
    strbuf.append(&g->allocas, " = alloca ");
    strbuf.append(&g->allocas, mem_type);
    strbuf.append(&g->allocas, ", align ");
    strbuf.append_u64(&g->allocas, align);
    strbuf.push(&g->allocas, '\n');
    return p;
}

// A place the compiler invents, `%tmp<K>` from its own counter, for an
// aggregate argument copy or a short-circuit slot.
fn gen_temp_place(emitter mut* g, types.node* t) gen_place {
    gen_place mut p = gen_temp_place_raw(g, gen_mem_type(g, t), types.type_alignof(t));
    p.ty = t;
    return p;
}
