/// Checks names, types, constants, and semantic rules.
/// It annotates the syntax tree and reports diagnostics.
///
/// `check_stmt` completes statement, module, and program checks.
import ast;
import consts;
import containers;
import diag;
import lexer;
import modules;
import prim;
import scope;
import session;
import types;
import std.strbuf;
import std.strmap;

// ---- the annotation bits the checker sets ----------------------------------------

/// The node is a constant expression and `aux` indexes its value:
/// check_node_value reads it.
u32 ANN_CONST = 1;
// An untyped constant that has not met its context yet: its `ty` is the
// default type until a context finalizes it.
u32 ANN_UNTYPED = 2;
// k_call: the callee never returns, so the call statement terminates.
u32 ANN_NORETURN = 4;
// A top-level declaration on the resolution path, and one whose symbol is
// complete: the two states of the lazy resolution.
u32 ANN_RESOLVING = 8;
u32 ANN_RESOLVED = 16;
// k_switch: the switch has a `default` clause or lists every member of its
// enum, which is what a terminating switch needs.
u32 ANN_EXHAUSTIVE = 32;
/// k_return: `return x` of an `own` local or parameter is an implicit `move`,
/// so the emitter empties the operand after reading it. k_call: the call is a
/// call of the builtin `move`, so the emitter reads and then empties its operand.
u32 ANN_MOVE = 64;
/// The expression is an lvalue (D6.7): it designates storage. The emitter reads
/// this bit to decide whether `del` empties its operand (D17.9).
u32 ANN_LVALUE = 128;
/// With ANN_LVALUE: `move` and `del` may not empty the lvalue, because it is a
/// module-level constant or a member of one, in read-only memory (D7.10, D17.9).
u32 ANN_EMPTY_READONLY = 256;
/// With ANN_LVALUE: `move` and `del` may not empty the lvalue, because an
/// indirection on its path has an immutable level (D17.9). An lvalue without
/// either bit is emptiable. empty_of reads the two bits.
u32 ANN_EMPTY_IMMUTABLE = 512;
// One past the highest annotation bit. A new highest bit doubles this
// sentinel. ANN_ALL then includes each bit that check_module clears.
// No other code clears `ann`. A missed bit would survive the next check.
// check_own_test.ft compares this sentinel with the highest declared bit.
// It also verifies that a second check clears the bits.
u32 ANN_END = 1024;
u32 ANN_ALL = ANN_END - 1;

// ---- the limits of one declaration -------------------------------------------------

// A type has at most 256 suffixes, which is the nesting limit of D2.11. The
// checker refuses a function, function type or struct with more than 128
// parameters or fields. It does not size the member lists dynamically.
u64 MAX_SUFFIXES = 256;
u64 MAX_MEMBERS = 128;

// The width of the `struct` keyword, which is where an infinite-size struct is
// reported.
u32 STRUCT_KEYWORD_LEN = 6;

// The first non-zero capacity of the symbol and value vectors; growth doubles
// from there.
u64 VEC_MIN_CAP = 16;

// The one unmangled definition the compiler emits in the entry module, whose
// name an `extern` may not declare.
string MAIN_SYMBOL = "main";

fn is_reserved_c_name(string name) bool {
    return name == MAIN_SYMBOL;
}

// The underlying type of an enum is i32.
fn enum_underlying() prim.prim_kind {
    return prim.prim_kind.prim_i32;
}

// ---- the values a checked construct carries ----------------------------------------

// Where a written type stands, which decides the markers its outermost
// position may carry. The type table builds the type and leaves these
// refusals to the checker, which alone knows the position (types.ft).
enum type_pos {
    pos_binding, // a variable, parameter or field of a literal: any marker
    pos_field, // a struct field: no outermost `mut`
    pos_return, // a return type: no outermost `mut`
    pos_cast, // a cast target: a result has no binding
    pos_alloc, // inside `new`: the outermost position is allocated
}

// Whether `move` and `del` may empty an lvalue, and why not when they may not.
// Emptying is not an assignment, so a binding's own `mut` does not decide it.
// `del` on an immutable `own` binding is legal. `move` through an immutable
// level is not legal.
enum empty_kind {
    empty_ok,        // a binding's own storage, or a mutable indirection
    empty_readonly, // a module-level constant, or a member of one
    empty_immutable, // an indirection whose level is immutable
}

// A written type after resolution: the type and the mutability of level 0, which
// lives outside the type. The error type marks a failure. The C calls it
// check_type_t, which would collide with the function check_type, so it is named
// for what it holds.
struct written_type {
    types.node* ty;
    bool mut0;
}

// A checked expression. `ty` is never null. It is the error type after a
// failure. `value` is cv_none unless the expression is constant. `untyped`
// marks a constant that still takes its type from context. `lvalue` and
// `is_mut` are level-0 answers. `sym` identifies the declaration for an
// identifier or field access. It is null otherwise.
struct expr {
    types.node* ty;
    consts.cval value;
    bool untyped;
    bool lvalue;
    // `mut` is a keyword, so the field is `is_mut`
    bool is_mut;
    // meaningless unless `lvalue`; check_expr writes it on the node as
    // ANN_EMPTY_READONLY or ANN_EMPTY_IMMUTABLE
    empty_kind empty;
    // also `null`, a function name and `&` of a declaration
    bool init_const;
    ast.sym* sym;
}

// ---- the context -------------------------------------------------------------------

/// Holds the state for one closure analysis.
struct checker {
    session.session mut* sess;
    types.table types;
    ast.sym mut* own mut@ own syms;
    u64 syms_len;
    consts.cval mut@ own values; // folded values indexed by `aux`
    u64 values_len;
    strbuf.str_buf msg; // the message builder, as modules.ft has one
    // the loader reported each one, so a use of one is silent
    strmap.str_map bad_imports;
    // The first `extern fn` declaration for each C symbol in the closure.
    // `extern_first` maps the C name to a position in `externs`. That vector
    // holds the declaration symbol. Later declarations are compared with it.
    strmap.str_map extern_first;
    ast.sym mut* mut@ own externs;
    u64 externs_len;
    ast.sym mut*[scope.UNIVERSE_COUNT] builtins; // the universe functions
    bool mute; // annotate without reporting, for an editor mode
    bool require_main; // the entry module defines main; off for a check-only run
    u64 errors;        // checker diagnostics, muted ones included

    // ---- the module and the function being checked ----
    modules.module* module;
    ast.sym mut* module_sym;
    ast.sym mut* fn_sym; // the function whose body is being checked
    // an `extern fn` name is a callee and nowhere a value
    ast.node* callee;
    // Whether the checker needs an operand address instead of its value.
    // `node N = node{&N};` is a legal self-reference. An address of a module
    // declaration is available from all modules, including its own module.
    // The value of `N` does not depend on itself. Without this flag, lazy
    // resolution would report a cycle because its guard cannot distinguish
    // value access from address access.
    bool addr_only;
    scope.scope mut* scope; // the innermost block scope, null at module level
    types.node* ret;        // the return type of the function being checked
    bool ret_void; // its return type is `void`
    bool ret_noreturn; // the function does not return
    bool in_function;       // a body is being checked
    u64 loops; // enclosing loops: `continue` needs one
    u64 switches; // enclosing switches: `break` takes either
    u64 defers; // enclosing deferred statements
    u64 block_errs; // k_error nodes seen in the body

    // ---- the suffixes of the written types being built ----
    // A stack of frames, one for each check_type_at call that is active. A
    // frame starts at the `suffix_top` that its call found. The call restores
    // that value before it returns. So the stack frame of check_type_at stays
    // small through the 256 suffixes of D2.11 and nested groups.
    types.suffix mut@ own suffixes;
    u64 suffix_top;
}

/// Prepares a checker that reports through `s` and defines the universe symbols.
fn check_init(checker mut* ck, session.session mut* s) void {
    ck->sess = s;
    types.type_table_init(&ck->types);
    ck->require_main = true;
    ck->ret_void = true;
    u64 mut i = 0;
    while (i < scope.UNIVERSE_COUNT) {
        ck->builtins[i] = check_sym_new(ck, ast.sym_kind.s_builtin, scope.universe_at(i), null,
                                        null);
        i += 1;
    }
}

/// Clears all checker state.
fn check_free(checker mut* ck) void {
    u64 mut i = 0;
    while (i < ck->syms_len) {
        ast.sym mut* own s = move(ck->syms[i]);
        del(s);
        i += 1;
    }
    del(ck->syms);
    ck->syms_len = 0;
    del(ck->values);
    ck->values_len = 0;
    strmap.free(&ck->bad_imports);
    strmap.free(&ck->extern_first);
    del(ck->externs);
    ck->externs_len = 0;
    strbuf.free(&ck->msg);
    types.type_table_free(&ck->types);
    del(ck->suffixes);
    ck->suffix_top = 0;
}

// ---- the three vectors -------------------------------------------------------------

// Ensures room for one more symbol. Existing symbol addresses remain stable.
fn syms_reserve(checker mut* ck) void {
    if (ck->syms_len < ck->syms.len) {
        return;
    }
    u64 mut cap = VEC_MIN_CAP;
    if (ck->syms.len >= cap) {
        if (ck->syms.len > containers.U64_MAX / 2) {
            panic("check.syms_reserve: capacity overflow");
        }
        cap = ck->syms.len * 2;
    }
    ast.sym mut* own mut@ own bigger = new(ast.sym mut* own, cap);
    u64 mut i = 0;
    while (i < ck->syms_len) {
        bigger[i] = move(ck->syms[i]);
        i += 1;
    }
    del(ck->syms);
    ck->syms = move(bigger);
}

// The same for the folded values, which are plain values and need no boxing:
// `aux` indexes this vector and nothing holds a pointer into it.
fn values_reserve(checker mut* ck) void {
    if (ck->values_len < ck->values.len) {
        return;
    }
    u64 mut cap = VEC_MIN_CAP;
    if (ck->values.len >= cap) {
        if (ck->values.len > containers.U64_MAX / 2) {
            panic("check.values_reserve: capacity overflow");
        }
        cap = ck->values.len * 2;
    }
    consts.cval mut@ own bigger = new(consts.cval, cap);
    u64 mut i = 0;
    while (i < ck->values_len) {
        bigger[i] = ck->values[i];
        i += 1;
    }
    del(ck->values);
    ck->values = move(bigger);
}

fn externs_reserve(checker mut* ck) void {
    if (ck->externs_len < ck->externs.len) {
        return;
    }
    u64 mut cap = VEC_MIN_CAP;
    if (ck->externs.len >= cap) {
        if (ck->externs.len > containers.U64_MAX / 2) {
            panic("check.externs_reserve: capacity overflow");
        }
        cap = ck->externs.len * 2;
    }
    ast.sym mut* mut@ own bigger = new(ast.sym mut*, cap);
    u64 mut i = 0;
    while (i < ck->externs_len) {
        bigger[i] = ck->externs[i];
        i += 1;
    }
    del(ck->externs);
    ck->externs = move(bigger);
}

// Reserves a frame of `count` suffixes on the checker's suffix stack and
// returns its first index. The caller sets `suffix_top` back to that index
// before it returns. A growth moves the stack, so the caller indexes
// `ck->suffixes` again after each call that can check a type.
fn suffix_frame(checker mut* ck, u64 count) u64 {
    u64 first = ck->suffix_top;
    // The parser bounds each frame by 256 suffixes, so the sum does not trap.
    u64 need = first + count;
    if (need > ck->suffixes.len) {
        u64 mut cap = VEC_MIN_CAP;
        if (need > cap) {
            cap = need;
        }
        if (ck->suffixes.len <= containers.U64_MAX / 2 && ck->suffixes.len * 2 > cap) {
            cap = ck->suffixes.len * 2;
        }
        types.suffix mut@ own bigger = new(types.suffix, cap);
        u64 mut i = 0;
        while (i < first) {
            bigger[i] = ck->suffixes[i];
            i += 1;
        }
        del(ck->suffixes);
        ck->suffixes = move(bigger);
    }
    ck->suffix_top = need;
    return first;
}

// The symbols in the order they were made, for the index walk.
fn check_sym_count(checker* ck) u64 {
    return ck->syms_len;
}

// The symbol at `i`; an index at or past check_sym_count is a violated
// precondition and panics, since the slots beyond it hold nothing.
fn check_sym_at(checker* ck, u64 i) ast.sym* {
    if (i >= ck->syms_len) {
        panic("check.check_sym_at: index out of range");
    }
    return ck->syms[i];
}

/// The folded value of a node the checker marked ANN_CONST, and cv_none for
/// every other node.
fn check_node_value(checker* ck, ast.node* n) consts.cval {
    if ((n->ann & ANN_CONST) == 0) {
        return consts.cv_none();
    }
    if (n->aux >= ck->values_len) {
        panic("check.check_node_value: value index out of range");
    }
    return ck->values[n->aux];
}

// Records the folded value of a node: `aux` indexes it and ANN_CONST says so.
fn set_value(checker mut* ck, ast.node mut* n, consts.cval v) void {
    if (v.kind == consts.cval_kind.cv_none) {
        n->ann &= ~ANN_CONST;
        return;
    }
    values_reserve(ck);
    ck->values[ck->values_len] = v;
    n->aux = ck->values_len;
    ck->values_len += 1;
    n->ann |= ANN_CONST;
}

// ---- diagnostics -------------------------------------------------------------------

// The one funnel every checker diagnostic goes through: it counts the error
// and reports it unless the checker is muted.
fn check_error(checker mut* ck, diag.loc at, string msg) void {
    ck->errors += 1;
    // a muted checker annotates but does not report
    if (!ck->mute) {
        diag.error(session.diags(ck->sess), at, msg);
    }
}

// Begins a message in `ck->msg`; check_msg_end finishes it and reports it at
// `at`. Between them the caller appends with the msg_* functions below and with
// check_msg_type, which writes a type in the canonical spelling.
fn check_msg_begin(checker mut* ck) void {
    strbuf.clear(&ck->msg);
}

fn msg_str(checker mut* ck, string text) void {
    strbuf.append(&ck->msg, text);
}

// Appends a name between single quotes: 'name'.
fn msg_quote(checker mut* ck, string name) void {
    strbuf.push(&ck->msg, '\'');
    strbuf.append(&ck->msg, name);
    strbuf.push(&ck->msg, '\'');
}

fn msg_uint(checker mut* ck, u64 v) void {
    strbuf.append_u64(&ck->msg, v);
}

fn check_msg_type(checker mut* ck, types.node* t) void {
    types.type_to_str(t, &ck->msg);
}

fn msg_value(checker mut* ck, consts.cval v) void {
    consts.cv_to_str(v, &ck->msg);
}

fn check_msg_end(checker mut* ck, diag.loc at) void {
    check_error(ck, at, strbuf.view(&ck->msg));
}

// A note at `at`, which belongs to the error before it and is dropped with it
// when the checker is muted.
fn check_note_end(checker mut* ck, diag.loc at) void {
    diag.note(session.diags(ck->sess), at, strbuf.view(&ck->msg));
}

// Whether `t` already failed: no diagnostic mentions a poisoned type, which is
// how one error stays one error.
fn check_poisoned(types.node* t) bool {
    return t == null || t->kind == types.type_kind.k_error;
}

// The range of the closing brace of a construct whose range ends at it, where
// "missing return" and a non-exhaustive `switch` are reported.
fn check_close_brace(diag.loc at) diag.loc {
    // a range ends one past its last byte; the `}` is one before
    if (at.end_col <= 1) {
        return at;
    }
    return diag.loc_range(at.file, at.end_line, at.end_col - 1, at.end_line, at.end_col);
}

// The range of the keyword a declaration starts at, where an infinite-size
// struct is reported.
fn keyword_range(diag.loc at, u32 len) diag.loc {
    return diag.loc_range(at.file, at.line, at.col, at.line, at.col + len);
}

// The position an error with no position in the file takes, which is 1:1.
fn file_start(string file) diag.loc {
    return diag.loc_make(file, 1, 1);
}

// ---- symbols -----------------------------------------------------------------------

// Creates and records a symbol for the index walk.
fn check_sym_new(checker mut* ck, ast.sym_kind kind, string name, ast.node mut* n,
                              ast.sym mut* owner) ast.sym mut* {
    ast.sym mut* own s = new(ast.sym);
    s->kind = kind;
    s->name = name;
    // at the name, never at the construct's first token
    if (n != null) {
        s->decl = n->name_loc;
    } else {
        s->decl = diag.loc_make("", 1, 1);
    }
    s->node = n;
    s->owner = owner;
    syms_reserve(ck);
    ck->syms[ck->syms_len] = move(s);
    ck->syms_len += 1;
    ast.sym mut* kept = ck->syms[ck->syms_len - 1];
    // only a top-level declaration resolves lazily
    if (n != null
        && (kind == ast.sym_kind.s_field || kind == ast.sym_kind.s_enum_member
            || kind == ast.sym_kind.s_local || kind == ast.sym_kind.s_param)) {
        n->ann |= ANN_RESOLVED;
    }
    return kept;
}

// Marks a symbol as failed: the error type silences every later diagnostic
// that involves the declaration.
fn sym_fail(checker mut* ck, ast.sym mut* s) void {
    s->error = true;
    s->ty = types.type_error(&ck->types);
}

// The declaration a binding denotes: an import binding stands for the module
// or for the declaration it names, which is what its own name denotes. The
// record is mutable, because the resolution writes the type and the flags of
// the declaration it looked up. A binding holds an immutable view of the node,
// and `ast.node.sym` carries the `mut` through it, so no cast adds one.
fn sym_of_binding(scope.binding* b) ast.sym mut* {
    if (b == null) {
        return null;
    }
    if (b->kind == scope.bind_kind.b_module) {
        modules.module* m = cast(b->module, modules.module*);
        if (m != null && m->ast != null) {
            return m->ast->sym;
        }
        return null;
    }
    if (b->kind == scope.bind_kind.b_symbol) {
        if (b->to != null && b->to->node != null) {
            return b->to->node->sym;
        }
        return null;
    }
    if (b->node != null) {
        return b->node->sym;
    }
    return null;
}

// ---- names -------------------------------------------------------------------------

// The lookup reads the innermost block outward, then the module namespace.
// check_builtin reads names from the universe.
fn lookup(checker* ck, string name) scope.binding* {
    if (ck->scope != null) {
        scope.binding* b = scope.lookup(ck->scope, name);
        if (b != null) {
            return b;
        }
    }
    if (ck->module != null) {
        return scope.find(&ck->module->names, name);
    }
    return null;
}

// The builtin of `name`, or null: the universe is searched after every scope,
// so a declaration of the same name shadows it.
fn check_builtin(checker* ck, string name) ast.sym mut* {
    u64 mut i = 0;
    while (i < scope.UNIVERSE_COUNT) {
        if (ck->builtins[i]->name == name) {
            return ck->builtins[i];
        }
        i += 1;
    }
    return null;
}

// Whether an import failed to bind the name in this module. The loader reported
// the import, so later uses do not report more errors.
fn from_a_failed_import(checker* ck, string name) bool {
    return strmap.has(&ck->bad_imports, name);
}

fn selected_enum_with_member(ast.node* list, string name) ast.node* {
    u64 mut i = 0;
    while (list != null && i < ast.ast_len(list)) {
        ast.node* decl = ast.ast_child(list, i);
        i += 1;
        ast.node* mut current = decl;
        while (current->kind == ast.ast_kind.k_compile_if) {
            if ((current->flags & ast.FLAG_SELECT_THEN) != 0) {
                ast.node* found = selected_enum_with_member(current->b, name);
                if (found != null) {
                    return found;
                }
                current = null;
                break;
            }
            if (current->c == null) {
                current = null;
                break;
            }
            if (current->c->kind != ast.ast_kind.k_compile_if) {
                ast.node* found = selected_enum_with_member(current->c, name);
                if (found != null) {
                    return found;
                }
                current = null;
                break;
            }
            current = current->c;
        }
        if (current == null || current->kind != ast.ast_kind.k_enum_decl) {
            continue;
        }
        u64 mut k = 0;
        while (k < ast.ast_len(current)) {
            if (ast.ast_child(current, k)->name == name) {
                return current;
            }
            k += 1;
        }
    }
    return null;
}

// "unknown name 'x'", with the hint for a name that is an enum member, which
// is written `color.red` and lives in no namespace.
fn error_unknown_name(checker mut* ck, string name, diag.loc at) void {
    if (from_a_failed_import(ck, name)) {
        return;
    }
    check_msg_begin(ck);
    msg_str(ck, "unknown name ");
    msg_quote(ck, name);
    modules.module* m = ck->module;
    if (m != null && m->ast != null) {
        ast.node* decl = selected_enum_with_member(m->ast, name);
        if (decl != null) {
            msg_str(ck, ": an enum member is written ");
            msg_str(ck, decl->name);
            msg_str(ck, ".");
            msg_str(ck, name);
            check_msg_end(ck, at);
            return;
        }
    }
    check_msg_end(ck, at);
}

// ---- types -------------------------------------------------------------------------

/// The declaring symbol of a struct or enum type, which the checker stored in
/// the node when it made it (types.ft keeps it opaque).
fn nominal_sym(types.node* t) ast.sym mut* {
    return cast(t->decl, ast.sym mut*);
}

// Reports "type is too large" at `at` when the size of `t` passes the ceiling
// and returns whether the type may be used.
fn check_size_fits(checker mut* ck, diag.loc at, types.node* t) bool {
    if (check_poisoned(t) || t->kind == types.type_kind.k_void || types.type_size_fits(t)) {
        return true;
    }
    check_msg_begin(ck);
    msg_str(ck, "type is too large: ");
    check_msg_type(ck, t);
    check_msg_end(ck, at);
    return false;
}

// The struct whose layout a type needs, behind any fixed arrays.
fn struct_of(types.node* t) types.node* {
    if (t->kind == types.type_kind.k_struct) {
        return t;
    }
    if (t->kind == types.type_kind.k_array) {
        return struct_of(t->elem);
    }
    return null;
}

// Lays out the struct behind `t` when needed. This makes its size and
// declarations exact. Returns false when layout fails.
fn check_layout(checker mut* ck, types.node* t) bool {
    if (check_poisoned(t)) {
        return false;
    }
    if (t->kind == types.type_kind.k_void) {
        return true;
    }
    types.node* mut pending = types.type_layout_pending(t);
    if (pending != null) {
        // a struct is laid out when a declaration first needs it
        resolve_sym(ck, nominal_sym(pending));
        pending = types.type_layout_pending(t);
    }
    if (pending != null) {
        // still resolving means it contains itself by value
        ast.sym mut* s = nominal_sym(pending);
        check_msg_begin(ck);
        msg_str(ck, "struct ");
        msg_str(ck, pending->name);
        msg_str(ck, " has infinite size");
        if (s != null && s->node != null) {
            check_msg_end(ck, keyword_range(s->node->loc, STRUCT_KEYWORD_LEN));
        } else {
            check_msg_end(ck, file_start(""));
        }
        types.type_layout_fail(pending);
        if (s != null) {
            sym_fail(ck, s);
        }
        return false;
    }
    types.node* nominal = struct_of(t);
    return nominal == null || types.type_layout_state(nominal) != types.layout_state.l_error;
}

// The declaration `name` denotes in `m`, or null. Import bindings are not
// declarations because modules do not re-export them. Qualified access and
// imports both see declarations of `m`, not its imports.
fn module_declaration(modules.module* m, string name) scope.binding* {
    if (m == null) {
        return null;
    }
    scope.binding* b = scope.find(&m->names, name);
    if (b != null && scope.is_declaration(b)) {
        return b;
    }
    return null;
}

// The type a name in type position denotes: a struct or an enum, of this module
// or, qualified, of an imported one. `stores_base` says whether the written type
// puts a value of that name in its own storage, which decides whether the name
// is a layout dependency.
fn named_type(checker mut* ck, ast.node mut* n, bool stores_base) types.node* {
    scope.binding* b = lookup(ck, n->name);
    if (b == null) {
        if (!from_a_failed_import(ck, n->name)) {
            check_msg_begin(ck);
            msg_str(ck, "unknown type ");
            msg_quote(ck, n->name);
            check_msg_end(ck, n->name_loc);
        }
        return types.type_error(&ck->types);
    }
    ast.sym mut* mut s = sym_of_binding(b);
    n->sym = s;
    ast.node mut* tail = n->a;
    if (tail != null) {
        if (b->kind != scope.bind_kind.b_module) {
            check_msg_begin(ck);
            msg_quote(ck, n->name);
            msg_str(ck, " is not a module");
            check_msg_end(ck, n->name_loc);
            return types.type_error(&ck->types);
        }
        modules.module* m = cast(b->module, modules.module*);
        scope.binding* inner = module_declaration(m, tail->name);
        if (inner == null) {
            check_msg_begin(ck);
            msg_str(ck, "module ");
            if (m != null) {
                msg_quote(ck, m->path);
            } else {
                msg_quote(ck, n->name);
            }
            msg_str(ck, " has no declaration named ");
            msg_quote(ck, tail->name);
            check_msg_end(ck, tail->name_loc);
            return types.type_error(&ck->types);
        }
        s = sym_of_binding(inner);
        tail->sym = s;
    }
    if (s == null || (s->kind != ast.sym_kind.s_struct && s->kind != ast.sym_kind.s_enum)) {
        check_msg_begin(ck);
        if (tail != null) {
            msg_quote(ck, tail->name);
        } else {
            msg_quote(ck, n->name);
        }
        msg_str(ck, " is a ");
        if (s != null) {
            msg_str(ck, ast.sym_kind_name(s->kind));
        } else {
            msg_str(ck, "value");
        }
        msg_str(ck, ", not a type");
        if (tail != null) {
            check_msg_end(ck, tail->name_loc);
        } else {
            check_msg_end(ck, n->name_loc);
        }
        return types.type_error(&ck->types);
    }
    // The declaration can still be unresolved. A type name is one place where
    // lazy resolution reaches another declaration. It does not resolve a struct
    // that the written type does not store by value. That struct does not affect
    // this type's size. Forced resolution would put it on a path for a struct
    // that does not contain it. check_layout would then read an unfinished
    // layout as an infinite size. Resolution edges are exactly the
    // value-containment edges. This makes both declaration orders of a pair one
    // program. collect_module
    // gave every struct its type before any field was read, so the name already
    // denotes the right type.
    bool identity_only = s->kind == ast.sym_kind.s_struct && !stores_base && s->ty != null;
    if (!identity_only) {
        resolve_sym(ck, s);
    }
    return s->ty;
}

fn type_result(types.node* t, bool mut0) written_type {
    return written_type{t, mut0};
}

// The constant length of a fixed-array suffix.
fn array_length(checker mut* ck, ast.node mut* e, u64 mut* out) bool {
    expr mut v = expr{};
    check_expr_default(ck, e, &v);
    if (check_poisoned(v.ty)) {
        return false;
    }
    if (consts.cv_is_float(v.value)) {
        // a length is an integer, so that is the rule it broke
        check_msg_begin(ck);
        msg_str(ck, "an array length must be an integer, not ");
        check_msg_type(ck, v.ty);
        check_msg_end(ck, e->loc);
        return false;
    }
    if (!consts.cv_is_int_like(v.value)) {
        check_error(ck, e->loc, "an array length must be a constant expression");
        return false;
    }
    consts.cval n = consts.cv_as_int(v.value);
    if (consts.cv_is_neg(n) || consts.cv_is_zero(n) || !consts.cv_to_u64(n, out)) {
        check_error(ck, e->loc, "an array length must be greater than 0");
        return false;
    }
    return true;
}

// Whether a written return type is `noreturn`. Each return type passes through
// `type`, so the keyword is under a k_type wrapper. A speculative parse can
// provide a base type node, which is also accepted.
fn is_noreturn(ast.node* t) bool {
    if (t == null) {
        return false;
    }
    ast.node* mut base = t;
    while (base->kind == ast.ast_kind.k_type && ast.ast_len(base) == 0 && base->a != null) {
        base = base->a;
    }
    return base->kind == ast.ast_kind.k_type_noreturn;
}

// Whether a group holds a bare `void`, through any parentheses with no suffix.
fn is_void_group(ast.node* t) bool {
    ast.node* mut base = t;
    while (base->kind == ast.ast_kind.k_type && ast.ast_len(base) == 0 && base->a != null) {
        base = base->a;
    }
    return base->kind == ast.ast_kind.k_type_void;
}

// Reports a parameter whose checked type is `void` at `at`, and returns whether it did. Only a
// bare `void` reaches this type: `void mut` and `(void)` fail before it (D3.1).
fn void_parameter_refused(checker mut* ck, diag.loc at, types.node* t) bool {
    if (t->kind != types.type_kind.k_void) {
        return false;
    }
    check_error(ck, at, "'void' is only a return type or the base of 'void*'");
    return true;
}

// Gives each node of a group of a bare `void` or `noreturn` the `void` that it builds. Returns
// the innermost node of the group that carries a `mut`, or null. The parser refuses an `own`
// there.
fn return_group_marked(checker mut* ck, ast.node mut* t) ast.node* {
    types.node* v = types.type_void(&ck->types);
    ast.node* mut marked = null;
    ast.node mut* mut cur = t;
    while (cur->kind == ast.ast_kind.k_type) {
        if (ast.ast_is_mut(cur)) {
            marked = cur;
        }
        cur->ty = v;
        cur = cur->a;
    }
    cur->ty = v;
    return marked;
}

// The base type of a written type: a primitive, `string`, `void`,
// `noreturn`, a qualified name or a function type.
fn base_type(checker mut* ck, ast.node mut* n, bool allow_noreturn, bool stores_base) types.node* {
    types.node* mut t = types.type_error(&ck->types);
    switch (n->kind) {
    case ast.ast_kind.k_type_prim:
        prim.prim_kind k = cast(n->op, prim.prim_kind);
        if (k == prim.prim_kind.prim_void) {
            t = types.type_void(&ck->types);
        } else {
            t = types.type_prim(&ck->types, k);
        }
    case ast.ast_kind.k_type_string:
        t = types.type_string(&ck->types, false);
    case ast.ast_kind.k_type_void:
        t = types.type_void(&ck->types);
    case ast.ast_kind.k_type_noreturn:
        // `noreturn` is a return type only
        if (!allow_noreturn) {
            check_error(ck, n->loc, "'noreturn' is a return type");
        } else {
            t = types.type_void(&ck->types);
        }
    case ast.ast_kind.k_type_name:
        t = named_type(ck, n, stores_base);
    case ast.ast_kind.k_type_fn:
        types.node*[MAX_MEMBERS] mut params = {};
        u64 count = ast.ast_len(n);
        if (count > MAX_MEMBERS) {
            check_error(ck, n->loc, "too many parameters");
        } else {
            // a function pointer is one word, so no layout dependency
            written_type ret = check_type_at(ck, n->a, type_pos.pos_return, false);
            bool mut ok = !check_poisoned(ret.ty);
            u64 mut i = 0;
            while (i < count) {
                // a binding-level `mut` is not part of the type
                ast.node mut* written = ast_child_mut(n, i);
                written_type p = check_type_at(ck, written, type_pos.pos_binding, false);
                params[i] = p.ty;
                ok = ok && !check_poisoned(p.ty);
                if (void_parameter_refused(ck, written->loc, p.ty)) {
                    ok = false;
                }
                i += 1;
            }
            if (ok) {
                t = types.type_fn(&ck->types, ret.ty, params[0..count], is_noreturn(n->a));
            }
        }
    default:
        panic("check.base_type: not a base type");
    }
    n->ty = t;
    return t;
}

// Returns mutable child `i` from a node list. The checker writes annotations on
// each child. ast.ast_child gives only an immutable view.
// The vector holds the slot mutable, so this adds nothing a cast would have to.
fn ast_child_mut(ast.node* n, u64 i) ast.node mut* {
    return ast.ast_child_mut(n, i);
}

// Whether the base of a written type ends up in the storage the type describes.
// A reference suffix anywhere breaks the chain. `node*` is one word, and
// `node* @` contains two. A fixed array contains N elements and carries the
// base through. This is the written form of the rule type_layout_pending
// applies to the built type, which looks behind fixed arrays and stops at every
// reference.
fn suffixes_store_base(ast.node* n) bool {
    if (n->kind != ast.ast_kind.k_type) {
        // A bare base type n, which a speculative parse hands over: it
        // carries no suffix at all.
        return true;
    }
    u64 mut i = 0;
    while (i < ast.ast_len(n)) {
        if (cast(ast.ast_child(n, i)->op, types.suffix_kind) != types.suffix_kind.s_array) {
            return false;
        }
        i += 1;
    }
    return true;
}

fn written_suffix_count(ast.node* n) u64 {
    u64 mut count = 0;
    ast.node* mut cur = n;
    while (cur->kind == ast.ast_kind.k_type) {
        count += ast.ast_len(cur);
        cur = cur->a;
    }
    return count;
}

// Calls `check_type` with whether this type stores a base value. A function
// type does not store its result or parameters. Their suffixes do not change
// this answer.
fn check_type_at(checker mut* ck, ast.node mut* n, type_pos pos, bool in_storage) written_type {
    bool wrapped = n->kind == ast.ast_kind.k_type;
    ast.node mut* mut base = n;
    if (wrapped) {
        base = n->a;
    }
    bool allow_noreturn = pos == type_pos.pos_return;
    bool stores_base = in_storage && suffixes_store_base(n);
    written_type mut grouped = type_result(types.type_error(&ck->types), false);
    bool has_group = base->kind == ast.ast_kind.k_type;
    // `noreturn`, bare or in groups with no suffix, as the return type itself. This node is the
    // outermost one of that return type, so it checks the groups and reports for all of them.
    bool return_noreturn = allow_noreturn && is_noreturn(base);
    // A bare `void` in a return type, in groups or with no suffix on this node: this node checks
    // the groups too. `void*` and `void mut*` are not in this set.
    bool return_void = allow_noreturn && wrapped && is_void_group(base)
                       && (has_group || ast.ast_len(n) == 0);
    ast.node* mut marked = null;
    types.node* mut b = null;
    if ((has_group && return_noreturn) || return_void) {
        marked = return_group_marked(ck, base);
        b = base->ty;
    } else if (has_group) {
        grouped = check_type_at(ck, base, type_pos.pos_binding, stores_base);
        b = grouped.ty;
        // A group of a bare `void` is a complete return type and nothing else, as
        // `void` needs its `*` inside the same group: `(void)*` is an error and
        // `(void*)` the opaque pointer (D3.11).
        if (!check_poisoned(b) && is_void_group(base)) {
            check_error(ck, base->loc, "'void' is only a return type or the base of 'void*'");
            b = types.type_error(&ck->types);
        }
    } else {
        b = base_type(ck, base, allow_noreturn, stores_base);
    }
    // A `noreturn` return type takes no suffix (D8.5): `noreturn*` would be `void*`. A group of a
    // bare `void` takes none either (D3.11), and the innermost `mut` in the group, or else the
    // group, reports it. A `mut` on a bare `noreturn` or `void` gets the message of `i32 mut`
    // there. In any other position base_type reported `noreturn`, so `return_noreturn` keeps this
    // from a second report.
    if ((return_noreturn || return_void) && wrapped) {
        string mut what = "";
        diag.loc mut report_at = n->loc;
        if (return_noreturn && ast.ast_len(n) > 0) {
            what = "'noreturn' is a return type";
        } else if (ast.ast_len(n) > 0) {
            what = "'void' is only a return type or the base of 'void*'";
            report_at = base->loc;
            if (marked != null) {
                report_at = marked->loc;
            }
        } else if (ast.ast_is_mut(n) || marked != null) {
            what = "a return type has no binding: remove the outermost 'mut'";
        }
        if (what.len > 0) {
            check_error(ck, report_at, what);
            b = types.type_error(&ck->types);
        }
    }
    u64 mut count = 0;
    if (wrapped) {
        count = ast.ast_len(n);
    }
    bool mut ok = !check_poisoned(b);
    if (ok && written_suffix_count(n) > MAX_SUFFIXES) {
        check_error(ck, n->loc, "too many type suffixes");
        ok = false;
    }
    u64 first = suffix_frame(ck, count);
    u64 mut i = 0;
    while (ok && i < count) {
        ast.node mut* s = ast_child_mut(n, i);
        types.suffix mut level = types.suffix{};
        level.kind = cast(s->op, types.suffix_kind);
        level.is_own = ast.ast_is_own(s);
        level.is_mut = ast.ast_is_mut(s);
        // array_length can check a type in the length, which can move the stack.
        if (level.kind == types.suffix_kind.s_array && !array_length(ck, s->a, &level.len)) {
            ok = false;
        }
        ck->suffixes[first + i] = level;
        i += 1;
    }
    if (!ok) {
        ck->suffix_top = first;
        n->ty = types.type_error(&ck->types);
        return type_result(n->ty, false);
    }
    bool mut base_own = wrapped && ast.ast_is_own(n);
    bool mut base_mut = (wrapped && ast.ast_is_mut(n)) || grouped.mut0;
    if (has_group && base_own && types.type_is_reference(b)) {
        // The marker owns the grouped reference, rather than a new storage level.
        switch (b->kind) {
        case types.type_kind.k_ptr:
            b = types.type_ptr(&ck->types, b->elem, true, b->is_mut);
        case types.type_kind.k_voidptr:
            b = types.type_voidptr(&ck->types, true, b->is_mut);
        case types.type_kind.k_span:
            b = types.type_span(&ck->types, b->elem, true, b->is_mut);
        case types.type_kind.k_string:
            b = types.type_string(&ck->types, true);
        default:
            // panic-coverage: unreachable: read: type_is_reference admits these four kinds only.
            panic("check: not a grouped reference");
        }
        base_own = false;
    }
    if (pos == type_pos.pos_alloc) {
        // `new` fills only the outermost position because it allocates that
        // storage. Each inner position describes storage that `new` did not
        // allocate. Thus, the result has the written element type. A bare
        // `void` has no
        // position and keeps no mark, so check_new reports it rather than the
        // type builder.
        if (count == 0) {
            base_mut = b->kind != types.type_kind.k_void;
        } else {
            ck->suffixes[first + count - 1].is_mut = true;
        }
    }
    types.build_result built =
        types.type_build(&ck->types, base_own, base_mut, b, ck->suffixes[first..first + count]);
    ck->suffix_top = first;
    if (built.built == null) {
        check_error(ck, n->loc, built.error);
        n->ty = types.type_error(&ck->types);
        return type_result(n->ty, false);
    }
    if (built.mut0 && pos != type_pos.pos_binding && pos != type_pos.pos_alloc) {
        // no `mut` on a field, a return type or a cast target
        string mut what = "a field's own storage follows its struct";
        if (pos == type_pos.pos_return) {
            what = "a return type has no binding";
        } else if (pos == type_pos.pos_cast) {
            what = "a cast result has no binding";
        }
        check_msg_begin(ck);
        msg_str(ck, what);
        msg_str(ck, ": remove the outermost 'mut'");
        check_msg_end(ck, n->loc);
        n->ty = types.type_error(&ck->types);
        return type_result(n->ty, false);
    }
    n->ty = built.built;
    return type_result(built.built, built.mut0);
}

// The type a written type n denotes at `pos`, with the marker refusals the
// type table delegates; the error type after a diagnostic.
fn check_type(checker mut* ck, ast.node mut* n, type_pos pos) written_type {
    // Every written type outside a function type's own signature describes
    // storage: a field, a binding, a parameter, a result or a cast target.
    return check_type_at(ck, n, pos, true);
}

// ---- ownership -------------------------------------------------------------------

// Whether a value of `t` owns an allocation: an `own` reference or an owning
// aggregate, which are the two things `move` transfers and `del` refuses. A
// struct still without a layout answers false, the declaration that needs it
// having reported its own error.
fn check_owning(types.node* t) bool {
    if (types.type_is_reference(t)) {
        return t->is_own;
    }
    // an unresolved layout has no answer yet
    return types.type_layout_pending(t) == null && types.type_is_owning_aggregate(t);
}

// An `own` rvalue: `new(...)`, a call result, `move(...)` or a `cast` to an
// `own` type, none of which any binding could later `del`. `null` is not one
// of them: it owns nothing, whatever `own` type it adopts from its context,
// and `del(null)` is a no-op.
fn is_owning_rvalue(expr* e) bool {
    return !e->lvalue && e->value.kind != consts.cval_kind.cv_null && check_owning(e->ty);
}

// Reports "owning temporary would leak" at `at` when `e` is an owning rvalue;
// `what` says what the expression would do with it. Returns whether it reported.
fn check_owning_temporary(checker mut* ck, diag.loc at, expr* e, string what) bool {
    if (check_poisoned(e->ty) || !is_owning_rvalue(e)) {
        return false;
    }
    check_msg_begin(ck);
    msg_str(ck, "owning temporary would leak: ");
    msg_str(ck, what);
    check_msg_end(ck, at);
    return true;
}

// Returns `t` without the `own` mark of its stored reference. Equality, range
// loops, and borrowed uses of owning values see this type.
fn check_lend(checker mut* ck, types.node* t) types.node* {
    switch (t->kind) {
    case types.type_kind.k_ptr:
        return types.type_ptr(&ck->types, t->elem, false, t->is_mut);
    case types.type_kind.k_span:
        return types.type_span(&ck->types, t->elem, false, t->is_mut);
    case types.type_kind.k_string:
        return types.type_string(&ck->types, false);
    case types.type_kind.k_voidptr:
        // Lending clears `own` and never the `mut` of `void mut*`.
        return types.type_voidptr(&ck->types, false, t->is_mut);
    default:
        return t;
    }
}

// ---- untyped constants in context --------------------------------------------------

fn type_is_integer_prim(types.node* t) bool {
    return t->kind == types.type_kind.k_prim && prim.prim_is_integer(t->prim);
}

// Whether the untyped constant `v` may take the type `t`, with the diagnostic
// that names the reason. `what` names the context. An empty string matches the
// C null value. No real context takes the branch with an empty name. A poisoned
// `t` reports nothing. The diagnostic that
// poisoned it has already reported, and the error type silences every later
// one. That also keeps the internal name `<error>` out of the message, which
// is what the reader saw after `println(2^63)`. `operand_kind_ok` returns
// true on a poisoned type for the same reason.
//
// Both branches of `default_type` that report reach here poisoned: the
// out-of-range constant and `'null' needs a pointer-typed context`. The second
// also said nothing before the guard. `type_assignable` accepts a poisoned type
// on either side. Thus, the `null` arm below already returned true.
fn constant_fits(checker mut* ck, diag.loc at, consts.cval v, types.node* t, string what) bool {
    if (check_poisoned(t)) {
        return true;
    }
    if (v.kind == consts.cval_kind.cv_null) {
        if (types.type_assignable(t, types.type_null(&ck->types))) {
            return true;
        }
        check_msg_begin(ck);
        msg_str(ck, "'null' needs a pointer type, not ");
        check_msg_type(ck, t);
        check_msg_end(ck, at);
        return false;
    }
    if (t->kind == types.type_kind.k_prim && consts.cv_fits(v, t->prim)) {
        return true;
    }
    check_msg_begin(ck);
    if (consts.cv_is_float(v) && t->kind == types.type_kind.k_prim
        && prim.prim_is_float(t->prim)) {
        // the constant is not finite in that format
        // the shortest decimal that reads back is the runtime's work
        msg_str(ck, "a float constant out of range for ");
        check_msg_type(ck, t);
    } else if (consts.cv_is_float(v)) {
        // `i32 x = 2.0;` is an error, integral or not
        msg_str(ck, "a float constant does not become ");
        check_msg_type(ck, t);
        msg_str(ck, ": use cast");
    } else if (t->kind == types.type_kind.k_enum) {
        msg_str(ck, "an integer constant does not become an enum: use cast");
    } else if (t->kind == types.type_kind.k_prim && t->prim == prim.prim_kind.prim_char) {
        msg_str(ck, "an integer constant does not become char: use cast");
    } else if (t->kind == types.type_kind.k_prim && t->prim == prim.prim_kind.prim_bool) {
        msg_str(ck, "an integer constant does not become bool: write '!= 0'");
    } else if (t->kind == types.type_kind.k_prim) {
        msg_str(ck, "constant ");
        msg_value(ck, v);
        msg_str(ck, " does not fit ");
        check_msg_type(ck, t);
    } else {
        // No constant has that type at all, so the context names itself.
        if (what.len > 0) {
            msg_str(ck, what);
        } else {
            msg_str(ck, "the expression");
        }
        msg_str(ck, " expects ");
        check_msg_type(ck, t);
        msg_str(ck, ", not a constant");
    }
    check_msg_end(ck, at);
    return false;
}

// A `void` expression in a value position: the call of a function or of a
// universe builtin that yields nothing.
fn check_no_value(checker mut* ck, ast.node* n, expr mut* e) bool {
    if (e->ty->kind != types.type_kind.k_void) {
        return false;
    }
    check_msg_begin(ck);
    if (e->sym != null) {
        msg_quote(ck, e->sym->name);
        msg_str(ck, " has no value");
    } else {
        msg_str(ck, "the expression has no value");
    }
    check_msg_end(ck, n->loc);
    e->ty = types.type_error(&ck->types);
    return true;
}

// Gives every node of an untyped constant expression the type its context fixed.
// A folded node represents its full subtree, so only its value meets the
// context. An unfolded node passes the context to operands that have values.
// `1 << n` with a variable count is one example.
fn retype_untyped(checker mut* ck, ast.node mut* n, types.node* t, bool fit, string what) bool {
    if ((n->ann & ANN_UNTYPED) == 0) {
        return true;
    }
    n->ann &= ~ANN_UNTYPED;
    n->ty = t;
    consts.cval v = check_node_value(ck, n);
    bool mut ok = true;
    bool mut deeper = fit;
    if (v.kind != consts.cval_kind.cv_none) {
        ok = !fit || constant_fits(ck, n->loc, v, t, what);
        if (ok && v.kind == consts.cval_kind.cv_char && type_is_integer_prim(t)) {
            set_value(ck, n, consts.cv_as_int(v));
        }
        if (ok && types.type_is_float(t) && v.kind != consts.cval_kind.cv_none) {
            // The constant takes the float type here and rounds to nearest. An
            // integer becomes that float. An f64 constant in an f32 context
            // becomes the held f32. constant_fits already reported a value
            // that the format cannot hold.
            consts.cval mut f = consts.cv_none();
            if (consts.cv_to_float(v, t->prim, &f)) {
                set_value(ck, n, f);
            }
        }
        deeper = false;
    }
    if (n->a != null && !retype_untyped(ck, n->a, t, deeper, what)) {
        ok = false;
    }
    if (n->b != null && !retype_untyped(ck, n->b, t, deeper, what)) {
        ok = false;
    }
    if (n->c != null && !retype_untyped(ck, n->c, t, deeper, what)) {
        ok = false;
    }
    if (n->d != null && !retype_untyped(ck, n->d, t, deeper, what)) {
        ok = false;
    }
    u64 mut i = 0;
    while (i < ast.ast_len(n)) {
        if (!retype_untyped(ck, ast_child_mut(n, i), t, deeper, what)) {
            ok = false;
        }
        i += 1;
    }
    if (ok && v.kind == consts.cval_kind.cv_none && !untyped_operand_ok(ck, n, t)) {
        // An operator that folded to no value reaches its operand rule here because
        // check_binary could not read a value from its operands. The children go
        // first. A constant that does not fit `t` is reported at its location,
        // so `untyped_operand_ok` stays quiet. In `char c = 1 << n;`, the left operand is
        // integer `1`. The useful message names that constant.
        ok = false;
    }
    return ok;
}

// The order in which the clauses of the rule win, and not an order of width.
// One type covers a whole untyped expression, because there is no promotion
// inside one, so the constants of one expression settle on one clause.
// `prim_void` ranks 0 and means "no constant here asks for a type"; so does any
// kind the rule does not name. A fourth default type is one more case.
//
// `f64` ranks below `char`, so the float clause wins only where nothing else
// asks for a type. An untyped integer can take a float type, but no context
// requires that choice. Thus, one untyped expression keeps the answer its
// integer clause gave: `c ? 1 : 2.5` takes `i32` and refuses the float
// constant. Unary `-` and `~` answer differently, because `check_unary` gives
// an operand with no value its default type alone: `-(c ? 1.5 : 2.5)` is a
// typed `f64`, and `+ 1` beside it then takes `f64` from a typed operand like
// any other constant. `char` ranks below integer types for the opposite reason.
// A char literal takes an integer type in an integer context. An integer
// constant never becomes `char`. Thus, only the integer clause can hold both.
fn default_rank(prim.prim_kind k) i32 {
    switch (k) {
    case prim.prim_kind.prim_f64:
        return 1;
    case prim.prim_kind.prim_char:
        return 2;
    case prim.prim_kind.prim_i32:
        return 3;
    case prim.prim_kind.prim_i64:
        return 4;
    default:
        return 0;
    }
}

// The one of two default types whose clause wins, in `default_rank`'s order.
fn stronger_default(prim.prim_kind a, prim.prim_kind b) prim.prim_kind {
    if (default_rank(b) > default_rank(a)) {
        return b;
    }
    return a;
}

// The default type an untyped expression needs when it folded to no value:
// `4294967296 << n` with a variable count. Such an expression has no value of
// its own. It needs the strongest `default_rank` that one of its constants
// requests. The walk matches `retype_untyped`. A folded node represents its
// full subtree, so its value decides. The walk does not read that subtree.
// `prim_void` is the answer when no constant asks
// for a type; `default_type` then keeps `i32`.
//
// The type this chooses is not a type every constant of the expression can
// take. `retype_untyped` decides this for each constant. A float constant cannot
// become an integer or char. An integer constant cannot become char. Thus,
// `c ? 1 : 2.5` takes `i32` here and fails there.
fn untyped_default_kind(checker* ck, ast.node* n) prim.prim_kind {
    if ((n->ann & ANN_UNTYPED) == 0) {
        return prim.prim_kind.prim_void;
    }
    consts.cval v = check_node_value(ck, n);
    if (v.kind != consts.cval_kind.cv_none) {
        // The three clauses of the rule, on the value this node folded to. An
        // integer that fits neither type asks for i64, the widest the integer
        // clause offers, so `retype_untyped` reports it against that.
        switch (v.kind) {
        case consts.cval_kind.cv_int:
            if (consts.cv_fits(v, prim.prim_kind.prim_i32)) {
                return prim.prim_kind.prim_i32;
            }
            return prim.prim_kind.prim_i64;
        case consts.cval_kind.cv_char:
            return prim.prim_kind.prim_char;
        case consts.cval_kind.cv_float:
            return prim.prim_kind.prim_f64;
        default:
            // The rule names no default type for a bool, a string or `null`.
            // `true` and a string literal are typed already, so only `null`
            // arrives here, and the rule of the null literal reports it where
            // it stands.
            return prim.prim_kind.prim_void;
        }
    }
    prim.prim_kind mut k = prim.prim_kind.prim_void;
    if (n->a != null) {
        k = stronger_default(k, untyped_default_kind(ck, n->a));
    }
    if (n->b != null) {
        k = stronger_default(k, untyped_default_kind(ck, n->b));
    }
    if (n->c != null) {
        k = stronger_default(k, untyped_default_kind(ck, n->c));
    }
    if (n->d != null) {
        k = stronger_default(k, untyped_default_kind(ck, n->d));
    }
    u64 mut i = 0;
    while (i < ast.ast_len(n)) {
        k = stronger_default(k, untyped_default_kind(ck, ast.ast_child(n, i)));
        i += 1;
    }
    return k;
}

// The default type of an untyped constant with no context.
fn default_type(checker mut* ck, ast.node mut* n, expr mut* e) void {
    if (!e->untyped) {
        return;
    }
    e->untyped = false;
    prim.prim_kind mut k = prim.prim_kind.prim_i32;
    if (e->value.kind == consts.cval_kind.cv_null) {
        check_error(ck, n->loc, "'null' needs a pointer-typed context");
        e->ty = types.type_error(&ck->types);
    } else if (e->value.kind != consts.cval_kind.cv_none
               && !consts.cv_default_kind(e->value, &k)) {
        check_error(ck, n->loc, "constant expression out of range");
        e->ty = types.type_error(&ck->types);
    } else if (e->value.kind == consts.cval_kind.cv_none) {
        // `1 << n` with no context: the constants inside the expression take
        // their default type, and one type covers them all. A constant that
        // fits no type of the rule is reported by the retype below.
        k = untyped_default_kind(ck, n);
        if (k == prim.prim_kind.prim_void) {
            // No constant in it asks for a type, so the expression keeps the
            // i32 that `retype_untyped` used for its earlier diagnostic.
            k = prim.prim_kind.prim_i32;
        }
        e->ty = types.type_prim(&ck->types, k);
    } else {
        e->ty = types.type_prim(&ck->types, k);
    }
    if (!retype_untyped(ck, n, e->ty, true, "")) {
        e->ty = types.type_error(&ck->types);
    }
    n->ty = e->ty;
    e->value = check_node_value(ck, n);
}

// An expression used for its value with no context of its own, which also
// refuses a call that yields nothing.
fn value_of(checker mut* ck, ast.node mut* n, expr mut* e) void {
    default_type(ck, n, e);
    if (!check_poisoned(e->ty)) {
        check_no_value(ck, n, e);
    }
}

// `check_operand` handles an operator operand that gets no context. The thirteen
// positions include `*e`, `e.f`, `e->f`, `e.len`, `e[i]`, and `e[a..b]`. They
// also include `e()`, `&e`, `del(e)`, `move(e)`, an assignment or `++` target,
// and a range `for` collection. Each position
// drops a poisoned operand and says nothing more about it, which is right for
// an operand that was reported where it arose.
//
// An untyped constant without a default type is poisoned and unreported.
// Examples include written `2^63` and that value inside an expression that
// folded to no value. `untyped` gives it the error type. The default-type rule leaves
// the report to the context. The positions above are not contexts. Thus, the
// constant takes its default type here, as it does without an operator.
//
// The rule has two outcomes here, and the second is not an error path. It
// usually reports the constant and leaves the error type. The caller then
// returns. A constant that folds back into range leaves a typed operand without
// a diagnostic. `2^63 >> 1` is the i64 value 2^62. The shift leaves it
// poisoned, and this call restores it. The caller continues, so the operator
// can report `cannot dereference i64`.
//
// `default_type` returns at once for an operand that is no untyped constant, so
// operators handle each typed operand normally.
fn check_operand(checker mut* ck, ast.node mut* n, expr mut* out) void {
    check_expr(ck, n, out);
    if (check_poisoned(out->ty)) {
        default_type(ck, n, out);
    }
}

// The ownership rules a value meets when it reaches an expected type. An owning
// target is an `own` place. An owning lvalue enters it only as `move(lv)`.
// An owning rvalue enters it directly. A target that does not own borrows an
// owning lvalue. It would leak an owning rvalue. `implicit_move` is the one
// exception, the `return` of a bare `own` local or parameter.
fn convert_ownership(checker mut* ck, ast.node* n, expr mut* e, types.node* target,
                          string what, bool implicit_move) void {
    if (check_owning(target)) {
        if (!e->lvalue || implicit_move || !check_owning(e->ty)) {
            return;
        }
        check_msg_begin(ck);
        msg_str(ck, "copying an owning value requires 'move'");
        if (e->sym != null && n->kind == ast.ast_kind.k_ident) {
            // The hint spells a whole expression, so it is offered only for a
            // name: `move(data)` for `b->data` would name nothing in scope.
            msg_str(ck, ": write move(");
            msg_str(ck, e->sym->name);
            msg_str(ck, ")");
        }
        check_msg_end(ck, n->loc);
        e->ty = types.type_error(&ck->types);
        return;
    }
    if (!is_owning_rvalue(e)) {
        return;
    }
    check_msg_begin(ck);
    msg_str(ck, "owning temporary would leak: ");
    msg_str(ck, what);
    msg_str(ck, " expects ");
    check_msg_type(ck, target);
    check_msg_end(ck, n->loc);
    e->ty = types.type_error(&ck->types);
}

// Converts a checked expression to the type its context expects.
fn convert_at(checker mut* ck, ast.node mut* n, expr mut* e, types.node* target, string what,
                   bool implicit_move) void {
    if (e->untyped) {
        e->untyped = false;
        if (check_poisoned(target)) {
            e->ty = target;
        } else if (retype_untyped(ck, n, target, true, what)) {
            e->ty = target;
            e->value = check_node_value(ck, n);
        } else {
            e->ty = types.type_error(&ck->types);
        }
        n->ty = e->ty;
        return;
    }
    if (check_poisoned(e->ty) || check_poisoned(target)) {
        return;
    }
    if (check_no_value(ck, n, e)) {
        return;
    }
    if (!types.type_assignable(target, e->ty)) {
        check_msg_begin(ck);
        msg_str(ck, what);
        msg_str(ck, " expects ");
        check_msg_type(ck, target);
        msg_str(ck, ", not ");
        check_msg_type(ck, e->ty);
        check_msg_end(ck, n->loc);
        e->ty = types.type_error(&ck->types);
        return;
    }
    convert_ownership(ck, n, e, target, what, implicit_move);
}

fn convert(checker mut* ck, ast.node mut* n, expr mut* e, types.node* target, string what) void {
    convert_at(ck, n, e, target, what, false);
}

// Checks an expression that must produce a value of `target`: it finalizes an
// untyped constant against it and reports a type that does not convert. `what`
// names the context in the diagnostic. An owning target is an own place, so an
// owning lvalue reaches it only through `move`.
fn check_expr_as(checker mut* ck, ast.node mut* n, types.node* target, string what,
                      expr mut* out) void {
    check_expr(ck, n, out);
    convert(ck, n, out, target, what);
}

// Whether a `return` operand directly names a local or parameter. Such an
// operand is an implicit move. Fields, elements, and other lvalues require
// written `move`.
fn names_a_local(ast.node* n) bool {
    return n->kind == ast.ast_kind.k_ident && n->sym != null
        && (n->sym->kind == ast.sym_kind.s_local || n->sym->kind == ast.sym_kind.s_param);
}

// Checks the operand of `ret`, a k_return with a value, against `target`. It is
// the one own place that an owning lvalue reaches without `move`. The lvalue
// must directly name a local or parameter. The checker records this implicit
// move on `ret` for the emitter.
fn check_return_value(checker mut* ck, ast.node mut* ret, types.node* target, expr mut* out) void {
    ast.node mut* n = ret->a;
    check_expr(ck, n, out);
    bool implicit = check_owning(target) && out->lvalue && names_a_local(n);
    convert_at(ck, n, out, target, "the return value", implicit);
    if (implicit && !check_poisoned(out->ty)) {
        // emptied after the read, so a `defer del(x)` sees zero
        ret->ann |= ANN_MOVE;
    }
}

// Checks an expression used as a value with no context, so an untyped constant
// takes its default type.
fn check_expr_default(checker mut* ck, ast.node mut* n, expr mut* out) void {
    check_expr(ck, n, out);
    value_of(ck, n, out);
    // no context means no `own` place, so this would leak
    if (check_owning_temporary(ck, n->loc, out, "nothing here could free it")) {
        out->ty = types.type_error(&ck->types);
    }
}

// Checks a `bool` condition.
fn check_condition(checker mut* ck, ast.node mut* n, string what) void {
    expr mut e = expr{};
    check_expr(ck, n, &e);
    value_of(ck, n, &e);
    if (check_poisoned(e.ty)) {
        return;
    }
    if (e.ty->kind != types.type_kind.k_prim || e.ty->prim != prim.prim_kind.prim_bool) {
        check_msg_begin(ck);
        msg_str(ck, what);
        msg_str(ck, " must be bool, not ");
        check_msg_type(ck, e.ty);
        check_msg_end(ck, n->loc);
    }
}

// ---- operators ---------------------------------------------------------------------

// Returns the token kind stored as an i32 in `n.op`. The C compiler compares
// its plain integer directly with TOK_ constants.
fn op_of(i32 op) lexer.tok_kind {
    return cast(op, lexer.tok_kind);
}

// The name of an operator in a diagnostic, which is the token's spelling.
fn msg_op(checker mut* ck, i32 op) void {
    msg_str(ck, lexer.tok_kind_name(op_of(op)));
}

fn op_is_shift(i32 op) bool {
    return op_of(op) == lexer.tok_kind.shl || op_of(op) == lexer.tok_kind.shr;
}

fn op_is_logical(i32 op) bool {
    return op_of(op) == lexer.tok_kind.and_and || op_of(op) == lexer.tok_kind.pipe_pipe;
}

fn op_is_equality(i32 op) bool {
    return op_of(op) == lexer.tok_kind.eq || op_of(op) == lexer.tok_kind.ne;
}

fn op_is_ordering(i32 op) bool {
    return op_of(op) == lexer.tok_kind.lt || op_of(op) == lexer.tok_kind.le
        || op_of(op) == lexer.tok_kind.gt || op_of(op) == lexer.tok_kind.ge;
}

fn op_is_comparison(i32 op) bool {
    return op_is_equality(op) || op_is_ordering(op);
}

// `+ - * /` take integers or floats; every other arithmetic, wrapping and
// bitwise operator is integer-only.
fn op_takes_floats(i32 op) bool {
    return op_of(op) == lexer.tok_kind.plus || op_of(op) == lexer.tok_kind.minus
        || op_of(op) == lexer.tok_kind.star || op_of(op) == lexer.tok_kind.slash;
}

// Equality is defined on integers, floats, bool, char, enums, pointers,
// function pointers, and string. It is an error on structs, fixed arrays, and
// spans.
fn type_has_equality(types.node* t) bool {
    switch (t->kind) {
    case types.type_kind.k_prim, types.type_kind.k_enum, types.type_kind.k_ptr,
         types.type_kind.k_voidptr, types.type_kind.k_fn, types.type_kind.k_string:
        return true;
    default:
        return false;
    }
}

// Ordering exists on integers, floats and `char` only.
fn type_has_ordering(types.node* t) bool {
    return t->kind == types.type_kind.k_prim && t->prim != prim.prim_kind.prim_bool;
}

// Reports "there is no pointer arithmetic" for a pointer operation. Examples
// include `p + 1`, `p++`, and `p[i]`. Pointers come only from null, address
// operations, `new`, `.ptr`, casts, function names, and calls.
fn check_pointer_arithmetic(checker mut* ck, diag.loc at, i32 op, types.node* t) bool {
    if (t->kind != types.type_kind.k_ptr && t->kind != types.type_kind.k_voidptr) {
        return false;
    }
    check_msg_begin(ck);
    msg_str(ck, "there is no pointer arithmetic: '");
    msg_op(ck, op);
    msg_str(ck, "' does not apply to ");
    check_msg_type(ck, t);
    check_msg_end(ck, at);
    return true;
}

// "'+' takes integer operands, not char": one shape for every operand rule,
// naming the operator and the type that broke it.
fn error_operand(checker mut* ck, diag.loc at, i32 op, string takes, types.node* t) void {
    check_msg_begin(ck);
    msg_str(ck, "'");
    msg_op(ck, op);
    msg_str(ck, "' takes ");
    msg_str(ck, takes);
    msg_str(ck, ", not ");
    check_msg_type(ck, t);
    check_msg_end(ck, at);
}

// The exact folding on two untyped constants.
fn fold_untyped(checker mut* ck, diag.loc at, i32 op, consts.cval a, consts.cval b,
                     consts.cval mut* out) bool {
    if ((op_of(op) == lexer.tok_kind.slash || op_of(op) == lexer.tok_kind.percent)
        && consts.cv_is_zero(b)) {
        check_error(ck, at, "constant division by zero");
        return false;
    }
    bool mut ok = true;
    switch (op_of(op)) {
    case lexer.tok_kind.plus:
        ok = consts.cv_add(a, b, out);
    case lexer.tok_kind.minus:
        ok = consts.cv_sub(a, b, out);
    case lexer.tok_kind.star:
        ok = consts.cv_mul(a, b, out);
    case lexer.tok_kind.slash:
        ok = consts.cv_div(a, b, out);
    case lexer.tok_kind.percent:
        ok = consts.cv_rem(a, b, out);
    case lexer.tok_kind.amp:
        ok = consts.cv_and(a, b, out);
    case lexer.tok_kind.pipe:
        ok = consts.cv_or(a, b, out);
    case lexer.tok_kind.caret:
        ok = consts.cv_xor(a, b, out);
    case lexer.tok_kind.plus_wrap:
        ok = consts.cv_add(a, b, out);
    case lexer.tok_kind.minus_wrap:
        ok = consts.cv_sub(a, b, out);
    case lexer.tok_kind.star_wrap:
        // An untyped integer has no width, so it folds exactly.
        ok = consts.cv_mul(a, b, out);
    default:
        panic("check.fold_untyped: folding an operator that is not arithmetic");
    }
    if (!ok) {
        check_error(ck, at, "constant expression out of range");
    }
    return ok;
}

// Applies each checked-mode rule during compile-time folding. Thus, overflow or
// division by zero is a compile error, not a run-time trap.
fn fold_typed(checker mut* ck, diag.loc at, i32 op, consts.cval a, consts.cval b,
                   prim.prim_kind t, consts.cval mut* out) bool {
    if ((op_of(op) == lexer.tok_kind.slash || op_of(op) == lexer.tok_kind.percent)
        && consts.cv_is_zero(b)) {
        check_error(ck, at, "constant division by zero");
        return false;
    }
    bool mut ok = true;
    switch (op_of(op)) {
    case lexer.tok_kind.plus:
        ok = consts.cv_typed_add(a, b, t, out);
    case lexer.tok_kind.minus:
        ok = consts.cv_typed_sub(a, b, t, out);
    case lexer.tok_kind.star:
        ok = consts.cv_typed_mul(a, b, t, out);
    case lexer.tok_kind.slash:
        ok = consts.cv_typed_div(a, b, t, out);
    case lexer.tok_kind.percent:
        ok = consts.cv_typed_rem(a, b, t, out);
    case lexer.tok_kind.amp:
        ok = consts.cv_typed_and(a, b, t, out);
    case lexer.tok_kind.pipe:
        ok = consts.cv_typed_or(a, b, t, out);
    case lexer.tok_kind.caret:
        ok = consts.cv_typed_xor(a, b, t, out);
    case lexer.tok_kind.plus_wrap:
        *out = consts.cv_wrap_add(a, b, t);
    case lexer.tok_kind.minus_wrap:
        *out = consts.cv_wrap_sub(a, b, t);
    case lexer.tok_kind.star_wrap:
        *out = consts.cv_wrap_mul(a, b, t);
    default:
        panic("check.fold_typed: folding an operator that is not arithmetic");
    }
    if (!ok) {
        check_msg_begin(ck);
        msg_str(ck, "constant expression overflows ");
        msg_str(ck, prim.prim_name(t));
        check_msg_end(ck, at);
    }
    return ok;
}

// `a op b` on two float constants of the type `t`, or on a float and an integer,
// which takes `t` first. The exact result rounds to `t` once. Division by zero
// is a compile error. A non-finite result is also a compile error because no
// such constant exists. It serves the untyped fold, where `t` is f64, and the typed
// one.
fn fold_float(checker mut* ck, diag.loc at, i32 op, consts.cval a, consts.cval b,
                   prim.prim_kind t, consts.cval mut* out) bool {
    if (op_of(op) == lexer.tok_kind.slash && consts.cv_is_zero(b)) {
        // an infinity or a NaN is not a constant
        check_error(ck, at, "constant division by zero");
        return false;
    }
    bool mut ok = true;
    switch (op_of(op)) {
    case lexer.tok_kind.plus:
        ok = consts.cv_float_add(a, b, t, out);
    case lexer.tok_kind.minus:
        ok = consts.cv_float_sub(a, b, t, out);
    case lexer.tok_kind.star:
        ok = consts.cv_float_mul(a, b, t, out);
    case lexer.tok_kind.slash:
        ok = consts.cv_float_div(a, b, t, out);
    default:
        panic("check.fold_float: folding an operator that takes no floats");
    }
    if (!ok) {
        check_msg_begin(ck);
        msg_str(ck, "constant expression overflows ");
        msg_str(ck, prim.prim_name(t));
        check_msg_end(ck, at);
    }
    return ok;
}

fn relation_of(i32 op) consts.cv_rel {
    switch (op_of(op)) {
    case lexer.tok_kind.eq:
        return consts.cv_rel.cv_rel_eq;
    case lexer.tok_kind.ne:
        return consts.cv_rel.cv_rel_ne;
    case lexer.tok_kind.lt:
        return consts.cv_rel.cv_rel_lt;
    case lexer.tok_kind.le:
        return consts.cv_rel.cv_rel_le;
    case lexer.tok_kind.gt:
        return consts.cv_rel.cv_rel_gt;
    default:
        return consts.cv_rel.cv_rel_ge;
    }
}

// Applies shift rules. The left operand keeps its type. The count does not give
// it a context. A constant count outside the width is a compile error.
fn check_shift(checker mut* ck, diag.loc at, i32 op, expr mut* a, ast.node mut* rhs,
                    expr mut* b, expr mut* out) void {
    default_type(ck, rhs, b);
    // An untyped left operand whose value has no default type, `2^63` written
    // out, stays poisoned but keeps its constant. It continues to the context.
    // The context reports it against the type that the default rule chose.
    // `untyped` gives such a constant the error type and reports nothing, so
    // an early return on a poisoned operand would lose the diagnostic
    // altogether. Every other early return that can see one calls
    // `check_operand`. That function assigns the default type and reports the
    // constant. A shift keeps this shape because it can fold back into range.
    // For example, `9223372036854775808 >> 1` is a legal 2^62. This return
    // keeps that wide half for the context.
    if ((check_poisoned(a->ty) && !a->untyped) || check_poisoned(b->ty)) {
        return;
    }
    if (!type_is_integer_prim(b->ty)) {
        error_operand(ck, at, op, "an integer count", b->ty);
        return;
    }
    if (consts.cv_is_float(a->value) || (!a->untyped && !type_is_integer_prim(a->ty))) {
        // an untyped float's provisional type is f64
        error_operand(ck, at, op, "an integer left operand", a->ty);
        return;
    }
    out->ty = a->ty;
    out->untyped = a->untyped;
    bool counted = consts.cv_is_int(b->value);
    if (a->untyped) {
        // with no width yet, the count is checked against 0..63
        i64 mut count = 0;
        if (counted
            && (!consts.cv_to_i64(b->value, &count) || count < 0
                || count > cast(consts.CV_SHIFT_MAX, i64))) {
            check_error(ck, at, "constant shift count must be in 0..63");
            out->ty = types.type_error(&ck->types);
            out->untyped = false;
            return;
        }
        if (counted && consts.cv_is_int_like(a->value)) {
            consts.cval mut v = consts.cv_none();
            consts.cval left = consts.cv_as_int(a->value);
            bool mut ok = false;
            if (op_of(op) == lexer.tok_kind.shl) {
                ok = consts.cv_shl(left, b->value, &v);
            } else {
                ok = consts.cv_shr(left, b->value, &v);
            }
            if (!ok) {
                // the count is in range, so the exact result left it
                check_error(ck, at, "constant expression out of range");
                out->ty = types.type_error(&ck->types);
                out->untyped = false;
                return;
            }
            out->value = v;
        }
        return;
    }
    u64 width = cast(prim.prim_size(a->ty->prim), u64) * prim.PRIM_BITS_PER_BYTE;
    if (counted) {
        i64 mut n = 0;
        if (!consts.cv_to_i64(b->value, &n) || n < 0 || cast(n, u64) >= width) {
            check_msg_begin(ck);
            msg_str(ck, "shift count must be in 0..");
            msg_uint(ck, width - 1);
            msg_str(ck, " for ");
            check_msg_type(ck, a->ty);
            check_msg_end(ck, at);
            out->ty = types.type_error(&ck->types);
            return;
        }
        if (consts.cv_is_int(a->value)) {
            consts.cval mut v = consts.cv_none();
            bool mut ok = false;
            if (op_of(op) == lexer.tok_kind.shl) {
                ok = consts.cv_typed_shl(a->value, b->value, a->ty->prim, &v);
            } else {
                ok = consts.cv_typed_shr(a->value, b->value, a->ty->prim, &v);
            }
            if (ok) {
                out->value = v;
            }
        }
    }
}

// Reports a char constant beside a float constant. This pair is invalid. An
// untyped float becomes only a float type. No cast converts char to float.
// The integer-with-float rule does not cover char. This conservative rule
// matches typed operands. `c + 0.5` reports the char operand rule. `c < 0.5`
// reports that the float cannot become char.
// True when it reported.
fn chars_beside_a_float(checker mut* ck, diag.loc at, i32 op, expr mut* a, expr mut* b) bool {
    consts.cval mut ch = a->value;
    types.node* mut ch_ty = a->ty;
    consts.cval mut other = b->value;
    if (ch.kind != consts.cval_kind.cv_char) {
        ch = b->value;
        ch_ty = b->ty;
        other = a->value;
    }
    if (ch.kind != consts.cval_kind.cv_char) {
        return false;
    }
    if (op_is_comparison(op)) {
        // a char is ordered, so the float is what fails
        constant_fits(ck, at, other, ch_ty, "the operand");
        return true;
    }
    error_operand(ck, at, op, "numeric operands", ch_ty);
    return true;
}

// The default type of two untyped operands taken together, when one of them
// folded to no value. Neither operand gives the other a context. The default
// type rule therefore answers for the pair. One type covers the complete
// untyped expression. The strongest clause requested by either side wins.
fn untyped_pair_type(checker mut* ck, ast.node* lhs, ast.node* rhs) types.node* {
    prim.prim_kind mut k = stronger_default(untyped_default_kind(ck, lhs),
                                            untyped_default_kind(ck, rhs));
    if (k == prim.prim_kind.prim_void) {
        // No constant on either side asks for a type, so the pair keeps the i32
        // `default_type` keeps in the same case. A `null` arm asks for no type
        // of its own, so `(c ? null : null) == (c ? null : null)` reaches this
        // line, and the i32 it supplies is named in the four diagnostics that
        // follow: "'null' needs a pointer type, not i32".
        k = prim.prim_kind.prim_i32;
    }
    return types.type_prim(&ck->types, k);
}

// Two untyped constants: the arithmetic folds exactly and a comparison yields
// a bool.
fn check_untyped_pair(checker mut* ck, diag.loc at, i32 op, ast.node mut* lhs, expr mut* a,
                           ast.node mut* rhs, expr mut* b, expr mut* out) void {
    bool chars = a->value.kind == consts.cval_kind.cv_char
        && b->value.kind == consts.cval_kind.cv_char;
    if (a->value.kind == consts.cval_kind.cv_null
        || b->value.kind == consts.cval_kind.cv_null) {
        check_error(ck, at, "'null' has no type of its own");
        return;
    }
    if (op_is_logical(op)) {
        error_operand(ck, at, op, "bool operands", a->ty);
        return;
    }
    bool floats = consts.cv_is_float(a->value) || consts.cv_is_float(b->value);
    if (floats && chars_beside_a_float(ck, at, op, a, b)) {
        return;
    }
    if (floats && !op_is_comparison(op) && !op_takes_floats(op)) {
        // an error on floats; the untyped operand is f64
        types.node* mut named = a->ty;
        if (!consts.cv_is_float(a->value)) {
            named = b->ty;
        }
        error_operand(ck, at, op, "integer operands", named);
        return;
    }
    if (a->value.kind == consts.cval_kind.cv_none
        || b->value.kind == consts.cval_kind.cv_none) {
        // One operand folded to no value, so nothing folds and both operands
        // need a type from outside the pair. Neither gives one to the other.
        if (!op_is_comparison(op)) {
            // The pair stays untyped, so the context that fixes its type walks
            // both operands and reports every constant against it.
            out->ty = a->ty;
            out->untyped = true;
            return;
        }
        // A comparison yields `bool`, so no context reaches its operands. Their
        // default type must be fixed here. The rule sets one type for both
        // sides. Using only the left type dropped the right poison and constant.
        // Then `2^63 > (1 << m)` printed `false`. It also emitted two widths for
        // `2147483648 > (1 << m)`.
        out->ty = types.type_prim(&ck->types, prim.prim_kind.prim_bool);
        types.node* t = untyped_pair_type(ck, lhs, rhs);
        bool left_ok = retype_untyped(ck, lhs, t, true, "");
        bool right_ok = retype_untyped(ck, rhs, t, true, "");
        if (!left_ok || !right_ok) {
            // the constant is reported, so the comparison says no more
            out->ty = types.type_error(&ck->types);
        }
        return;
    }
    if (op_is_comparison(op)) {
        out->ty = types.type_prim(&ck->types, prim.prim_kind.prim_bool);
        consts.cval mut lv = a->value;
        consts.cval mut rv = b->value;
        if (floats) {
            // An integer beside a float compares as a float. Both values use
            // binary64. Conversion to binary64 cannot fail. A float constant is already
            // binary64, and each 64-bit integer fits the format. Thus, the failure
            // branch is defensive. No program can reach its message.
            if (!consts.cv_to_float(a->value, prim.prim_kind.prim_f64, &lv)
                || !consts.cv_to_float(b->value, prim.prim_kind.prim_f64, &rv)) {
                check_error(ck, at, "constant expression overflows f64");
                out->ty = types.type_error(&ck->types);
                return;
            }
        } else if (!chars) {
            lv = consts.cv_as_int(a->value);
            rv = consts.cv_as_int(b->value);
        }
        out->value = consts.cv_compare(relation_of(op), lv, rv);
        return;
    }
    consts.cval mut v = consts.cv_none();
    if (floats) {
        // an untyped float is evaluated in binary64
        if (!fold_float(ck, at, op, a->value, b->value, prim.prim_kind.prim_f64, &v)) {
            return;
        }
        untyped_result(ck, v, out);
        return;
    }
    if (!fold_untyped(ck, at, op, consts.cv_as_int(a->value), consts.cv_as_int(b->value), &v)) {
        return;
    }
    untyped_result(ck, v, out);
}

// The folded value of two untyped constants, with its provisional type; a
// context replaces that type.
fn untyped_result(checker mut* ck, consts.cval v, expr mut* out) void {
    out->value = v;
    out->untyped = true;
    prim.prim_kind mut k = prim.prim_kind.prim_i32;
    if (consts.cv_default_kind(v, &k)) {
        out->ty = types.type_prim(&ck->types, k);
    } else {
        out->ty = types.type_error(&ck->types);
    }
}

// The operand rules on the type the operator is applied to.
fn operand_kind_ok(checker mut* ck, diag.loc at, i32 op, types.node* t) bool {
    if (check_poisoned(t)) {
        return true;
    }
    if (op_is_logical(op)) {
        if (t->kind != types.type_kind.k_prim || t->prim != prim.prim_kind.prim_bool) {
            error_operand(ck, at, op, "bool operands", t);
            return false;
        }
        return true;
    }
    if (op_is_comparison(op)) {
        bool mut ok = true;
        if (op_is_ordering(op)) {
            ok = type_has_ordering(t);
        } else {
            ok = type_has_equality(t);
        }
        if (!ok) {
            string mut takes = "comparable operands";
            if (op_is_ordering(op)) {
                takes = "ordered operands";
            }
            error_operand(ck, at, op, takes, t);
            return false;
        }
        return true;
    }
    if (!type_is_integer_prim(t) && !(op_takes_floats(op) && types.type_is_float(t))) {
        if (check_pointer_arithmetic(ck, at, op, t)) {
            return false;
        }
        string mut takes = "integer operands";
        if (op_takes_floats(op)) {
            takes = "numeric operands";
        }
        error_operand(ck, at, op, takes, t);
        return false;
    }
    return true;
}

// The operand rules on the type a context fixed for an operator that folded to
// no value, `1 << n` with a variable count or `(c ? 1.5 : 2.5) & m` with a
// run-time condition. The operands have no value there, so `check_operands`
// cannot read their kind. It defers the rule until the type is known.
// `retype_untyped` is that point. No context can change the rule. A shift names
// its left operand because that operand owns the type. The count has its own
// type, which `check_shift` already checked.
fn untyped_operand_ok(checker mut* ck, ast.node* n, types.node* t) bool {
    if (n->kind != ast.ast_kind.k_binary) {
        return true;
    }
    if (op_is_shift(n->op)) {
        if (check_poisoned(t) || type_is_integer_prim(t)) {
            return true;
        }
        error_operand(ck, n->loc, n->op, "an integer left operand", t);
        return false;
    }
    return operand_kind_ok(ck, n->loc, n->op, t);
}

// Checks `a op b` on two checked operands. It finalizes an untyped operand
// against the other operand. It applies the operator rules, folds two
// constants, and reports each violation at `at`. Compound assignments use the
// same rules.
fn check_operands(checker mut* ck, diag.loc at, i32 op, ast.node mut* lhs, expr mut* a,
                       ast.node mut* rhs, expr mut* b, expr mut* out) void {
    out->ty = types.type_error(&ck->types);
    out->value = consts.cv_none();
    out->untyped = false;
    out->lvalue = false;
    out->is_mut = false;
    out->empty = empty_kind.empty_immutable;
    out->sym = null;
    if (op_is_shift(op)) {
        check_shift(ck, at, op, a, rhs, b, out);
        return;
    }
    if (a->untyped && b->untyped) {
        check_untyped_pair(ck, at, op, lhs, a, rhs, b, out);
        return;
    }
    // the typed operand decides before the untyped one adopts
    types.node* mut decides = a->ty;
    if (a->untyped) {
        decides = b->ty;
    }
    if (!operand_kind_ok(ck, at, op, decides)) {
        return;
    }
    if (a->untyped) {
        convert(ck, lhs, a, b->ty, "the operand");
    } else if (b->untyped) {
        convert(ck, rhs, b, a->ty, "the operand");
    }
    if (check_poisoned(a->ty) || check_poisoned(b->ty)) {
        return;
    }
    if (op_is_equality(op)) {
        // Lending leaves no owning rvalue to free.
        if (check_owning_temporary(ck, lhs->loc, a, "comparing it leaves no owner")
            || check_owning_temporary(ck, rhs->loc, b, "comparing it leaves no owner")) {
            return;
        }
    }
    types.node* mut lt = a->ty;
    types.node* mut rt = b->ty;
    if (op_is_equality(op)) {
        lt = check_lend(ck, a->ty);
        rt = check_lend(ck, b->ty);
    }
    if (!types.type_equal(lt, rt)) {
        // there is no promotion, mutability levels included
        check_msg_begin(ck);
        msg_str(ck, "'");
        msg_op(ck, op);
        msg_str(ck, "' takes two operands of the same type, not ");
        check_msg_type(ck, a->ty);
        msg_str(ck, " and ");
        check_msg_type(ck, b->ty);
        check_msg_end(ck, at);
        return;
    }
    types.node* t = lt;
    if (op_is_logical(op)) {
        out->ty = t;
        if (a->value.kind == consts.cval_kind.cv_bool
            && b->value.kind == consts.cval_kind.cv_bool) {
            if (op_of(op) == lexer.tok_kind.and_and) {
                out->value = consts.cv_land(a->value, b->value);
            } else {
                out->value = consts.cv_lor(a->value, b->value);
            }
        }
        return;
    }
    if (op_is_comparison(op)) {
        out->ty = types.type_prim(&ck->types, prim.prim_kind.prim_bool);
        if (a->value.kind != consts.cval_kind.cv_none
            && b->value.kind != consts.cval_kind.cv_none) {
            out->value = consts.cv_compare(relation_of(op), a->value, b->value);
        }
        return;
    }
    out->ty = t;
    if (types.type_is_float(t) && consts.cv_is_float(a->value)
        && consts.cv_is_float(b->value)) {
        // two float constants fold in their own type, once
        consts.cval mut v = consts.cv_none();
        if (!fold_float(ck, at, op, a->value, b->value, t->prim, &v)) {
            out->ty = types.type_error(&ck->types);
            return;
        }
        out->value = v;
        return;
    }
    if (consts.cv_is_int(a->value) && consts.cv_is_int(b->value)) {
        consts.cval mut v = consts.cv_none();
        if (!fold_typed(ck, at, op, a->value, b->value, t->prim, &v)) {
            out->ty = types.type_error(&ck->types);
            return;
        }
        out->value = v;
    }
}

// ---- expressions ----------------------------------------------

fn expr_clear(checker mut* ck, expr mut* out) void {
    out->ty = types.type_error(&ck->types);
    out->value = consts.cv_none();
    out->untyped = false;
    out->lvalue = false;
    out->is_mut = false;
    out->empty = empty_kind.empty_immutable;
    out->init_const = false;
    out->sym = null;
}

// An untyped constant: its type is provisional until a context fixes it, so
// the node is marked and the value recorded.
fn untyped(checker mut* ck, ast.node mut* n, expr mut* out, consts.cval v) void {
    out->value = v;
    out->untyped = true;
    out->init_const = true;
    prim.prim_kind mut k = prim.prim_kind.prim_i32;
    if (consts.cv_default_kind(v, &k)) {
        out->ty = types.type_prim(&ck->types, k);
    } else {
        out->ty = types.type_error(&ck->types);
    }
    if (v.kind == consts.cval_kind.cv_null) {
        out->ty = types.type_null(&ck->types);
    }
    n->ann |= ANN_UNTYPED;
    set_value(ck, n, v);
}

// The member of an enum, or null: members are scoped to their enum and live in
// no namespace.
fn enum_member(ast.sym* e, string name) ast.node* {
    ast.node* decl = e->node;
    u64 mut i = 0;
    while (decl != null && i < ast.ast_len(decl)) {
        ast.node* m = ast.ast_child(decl, i);
        if (m->kind == ast.ast_kind.k_enum_member && m->name == name) {
            return m;
        }
        i += 1;
    }
    return null;
}

fn struct_field(ast.sym* s, string name) ast.node* {
    ast.node* decl = s->node;
    u64 mut i = 0;
    while (decl != null && i < ast.ast_len(decl)) {
        ast.node* f = ast.ast_child(decl, i);
        if (f->kind == ast.ast_kind.k_field_decl && f->name == name) {
            return f;
        }
        i += 1;
    }
    return null;
}

// Sets the value that an identifier or qualified name denotes. A constant
// carries its folded value. A variable is an lvalue with level-0 mutability.
fn value_of_sym(checker mut* ck, ast.node* n, ast.sym mut* s, expr mut* out) void {
    resolve_sym(ck, s);
    out->sym = s;
    if (s->ty != null) {
        out->ty = s->ty;
    } else {
        out->ty = types.type_error(&ck->types);
    }
    switch (s->kind) {
    case ast.sym_kind.s_const:
        // `move` and `del` cannot empty read-only memory.
        out->lvalue = true;
        out->empty = empty_kind.empty_readonly;
        if (s->node != null && s->node->b != null) {
            out->value = check_node_value(ck, s->node->b);
        } else {
            out->value = consts.cv_none();
        }
        out->init_const = true;
    case ast.sym_kind.s_global, ast.sym_kind.s_local, ast.sym_kind.s_param:
        // a read of a `mut` global is not constant
        // own storage is emptiable whether or not the binding is `mut`
        out->lvalue = true;
        out->is_mut = s->mut0;
        out->empty = empty_kind.empty_ok;
    case ast.sym_kind.s_extern_fn:
        if (n != ck->callee) {
            // An `extern fn` in value position is an error. Calls use the
            // variadic LLVM type from its declaration. An indirect call has no
            // callee declaration for that form. Its vector-register count would
            // therefore stay unset.
            check_msg_begin(ck);
            msg_quote(ck, s->name);
            msg_str(ck, " is an extern function, which is not a value: wrap it in a fort ");
            msg_str(ck, "function to take a function pointer");
            check_msg_end(ck, n->name_loc);
            out->ty = types.type_error(&ck->types);
        } else {
            out->init_const = true;
        }
    case ast.sym_kind.s_fn:
        // `&f` is an error; a function name initializes
        out->init_const = true;
    case ast.sym_kind.s_enum_member:
        if (s->node != null) {
            out->value = check_node_value(ck, s->node);
        } else {
            out->value = consts.cv_none();
        }
        out->init_const = true;
    default:
        check_msg_begin(ck);
        msg_quote(ck, s->name);
        msg_str(ck, " is a ");
        msg_str(ck, ast.sym_kind_name(s->kind));
        msg_str(ck, ", not a value");
        check_msg_end(ck, n->name_loc);
        out->ty = types.type_error(&ck->types);
    }
}

fn check_ident(checker mut* ck, ast.node mut* n, expr mut* out) void {
    scope.binding* b = lookup(ck, n->name);
    if (b == null) {
        ast.sym mut* builtin = check_builtin(ck, n->name);
        if (builtin != null) {
            n->sym = builtin;
            check_msg_begin(ck);
            msg_quote(ck, n->name);
            msg_str(ck, " cannot be used as a value");
            check_msg_end(ck, n->name_loc);
            return;
        }
        error_unknown_name(ck, n->name, n->name_loc);
        return;
    }
    ast.sym mut* s = sym_of_binding(b);
    n->sym = s;
    if (s == null) {
        return;
    }
    value_of_sym(ck, n, s, out);
}

// The module a binding denotes, or null: only the module reading of an import
// binds one.
fn module_of(scope.binding* b) modules.module* {
    if (b != null && b->kind == scope.bind_kind.b_module) {
        return cast(b->module, modules.module*);
    }
    return null;
}

// What an expression names when it is not a value: a module or a type, which
// only a `.` may follow. Null for every ordinary expression. The binding is
// returned rather than the symbol because a module is reached through it.
fn names_module_or_type(checker mut* ck, ast.node mut* n) scope.binding* {
    scope.binding* mut b = null;
    if (n->kind == ast.ast_kind.k_ident) {
        b = lookup(ck, n->name);
    } else if (n->kind == ast.ast_kind.k_field && n->a != null) {
        // Qualified access sees the declarations of a module, not its imports
        // Imports are not re-exported. Thus, `m.other.f` is an
        // error even when `m` imports `other`.
        // `m.other.f` is an error even when `m` imports `other`
        b = module_declaration(module_of(names_module_or_type(ck, n->a)), n->name);
    }
    ast.sym mut* s = sym_of_binding(b);
    if (s == null
        || (s->kind != ast.sym_kind.s_module && s->kind != ast.sym_kind.s_struct
            && s->kind != ast.sym_kind.s_enum)) {
        return null;
    }
    n->sym = s;
    return b;
}

// `.len` and `.ptr`, the read-only pseudo-fields of arrays, spans and strings.
fn pseudo_field(checker mut* ck, ast.node mut* n, types.node* t, expr mut* out) bool {
    bool len = n->name == "len";
    bool ptr = n->name == "ptr";
    if (!len && !ptr) {
        return false;
    }
    if (t->kind == types.type_kind.k_array && len) {
        // the operand of `.len` is not evaluated
        untyped(ck, n, out, consts.cv_from_u64(t->len));
        return true;
    }
    if (t->kind == types.type_kind.k_span || t->kind == types.type_kind.k_string) {
        if (len) {
            out->ty = types.type_prim(&ck->types, prim.prim_kind.prim_u64);
            return true;
        }
        types.node* mut elem = t->elem;
        if (t->kind == types.type_kind.k_string) {
            elem = types.type_prim(&ck->types, prim.prim_kind.prim_char);
        }
        out->ty = types.type_ptr(&ck->types, elem, false,
                                 t->kind == types.type_kind.k_span && t->is_mut);
        return true;
    }
    if (t->kind == types.type_kind.k_array && ptr) {
        check_error(ck, n->name_loc, "a fixed array has no '.ptr'");
        return true;
    }
    return false;
}

// `e.f`, `p->f` and the qualified forms.
fn check_field(checker mut* ck, ast.node mut* n, expr mut* out, bool arrow) void {
    if (!arrow) {
        scope.binding* qb = names_module_or_type(ck, n->a);
        ast.sym mut* q = sym_of_binding(qb);
        modules.module* qm = module_of(qb);
        if (qm != null) {
            scope.binding* b = module_declaration(qm, n->name);
            if (b == null) {
                check_msg_begin(ck);
                msg_str(ck, "module ");
                msg_quote(ck, qm->path);
                msg_str(ck, " has no declaration named ");
                msg_quote(ck, n->name);
                check_msg_end(ck, n->name_loc);
                return;
            }
            ast.sym mut* s = sym_of_binding(b);
            n->sym = s;
            if (s != null) {
                value_of_sym(ck, n, s, out);
            }
            return;
        }
        if (q != null && q->kind == ast.sym_kind.s_enum) {
            resolve_sym(ck, q);
            ast.node* m = enum_member(q, n->name);
            if (m == null) {
                check_msg_begin(ck);
                msg_str(ck, "enum ");
                msg_str(ck, q->name);
                msg_str(ck, " has no member ");
                msg_quote(ck, n->name);
                check_msg_end(ck, n->name_loc);
                return;
            }
            n->sym = m->sym;
            out->sym = m->sym;
            out->ty = q->ty;
            out->value = check_node_value(ck, m);
            out->init_const = true;
            return;
        }
        if (q != null) {
            check_msg_begin(ck);
            msg_quote(ck, q->name);
            msg_str(ck, " is a type, not a value");
            check_msg_end(ck, n->a->loc);
            return;
        }
    }
    expr mut op = expr{};
    check_operand(ck, n->a, &op);
    if (check_poisoned(op.ty)) {
        return;
    }
    if (check_owning_temporary(ck, n->loc, &op, "a field of it leaves no owner")) {
        return;
    }
    types.node* mut t = op.ty;
    bool mut is_mut = op.is_mut;
    bool mut lvalue = op.lvalue;
    // a field of a local counts as the local
    empty_kind mut empty = op.empty;
    if (arrow) {
        if (t->kind != types.type_kind.k_ptr) {
            check_msg_begin(ck);
            msg_str(ck, "'->' needs a pointer, not ");
            check_msg_type(ck, t);
            msg_str(ck, ": use '.'");
            check_msg_end(ck, n->loc);
            return;
        }
        is_mut = types.type_level_mut(t, 1);
        // The read-only memory of a constant stops at the first indirection.
        if (is_mut) {
            empty = empty_kind.empty_ok;
        } else {
            empty = empty_kind.empty_immutable;
        }
        lvalue = true;
        t = t->elem;
    } else if (t->kind == types.type_kind.k_ptr || t->kind == types.type_kind.k_voidptr) {
        check_msg_begin(ck);
        msg_str(ck, "'.' on a pointer of type ");
        check_msg_type(ck, t);
        msg_str(ck, ": use '->'");
        check_msg_end(ck, n->loc);
        return;
    }
    if (pseudo_field(ck, n, t, out)) {
        return;
    }
    if (t->kind != types.type_kind.k_struct) {
        check_msg_begin(ck);
        check_msg_type(ck, t);
        msg_str(ck, " has no field ");
        msg_quote(ck, n->name);
        check_msg_end(ck, n->name_loc);
        return;
    }
    ast.sym* s = nominal_sym(t);
    ast.node* mut f = null;
    if (s != null) {
        f = struct_field(s, n->name);
    }
    if (f == null) {
        check_msg_begin(ck);
        msg_str(ck, "struct ");
        msg_str(ck, t->name);
        msg_str(ck, " has no field ");
        msg_quote(ck, n->name);
        check_msg_end(ck, n->name_loc);
        return;
    }
    n->sym = f->sym;
    out->sym = f->sym;
    if (f->sym != null) {
        out->ty = f->sym->ty;
    } else {
        out->ty = types.type_error(&ck->types);
    }
    out->lvalue = lvalue;
    out->is_mut = is_mut;
    out->empty = empty;
}

// ---- unary, indexing and span expressions ------------------------------------------

fn check_unary(checker mut* ck, ast.node mut* n, expr mut* out) void {
    expr mut a = expr{};
    if (op_of(n->op) == lexer.tok_kind.amp) {
        // `&e` requires an lvalue. It yields a borrowed pointer whose level 1
        // matches the mutability of `e`. The checker asks for the operand address,
        // not its value. This lets a module declaration hold its own address. The
        // flag is saved and restored because `&` can occur anywhere.
        bool outer_addr_only = ck->addr_only;
        ck->addr_only = true;
        check_operand(ck, n->a, &a);
        ck->addr_only = outer_addr_only;
        if (check_poisoned(a.ty)) {
            return;
        }
        if (a.sym != null
            && (a.sym->kind == ast.sym_kind.s_fn || a.sym->kind == ast.sym_kind.s_extern_fn)) {
            check_error(ck, n->loc, "'&' on a function: a function name is already a value");
            return;
        }
        if (!a.lvalue) {
            check_error(ck, n->loc, "'&' requires an lvalue");
            return;
        }
        out->ty = types.type_ptr(&ck->types, a.ty, false, a.is_mut);
        out->init_const = a.sym != null
            && (a.sym->kind == ast.sym_kind.s_const || a.sym->kind == ast.sym_kind.s_global);
        return;
    }
    if (op_of(n->op) == lexer.tok_kind.star) {
        check_operand(ck, n->a, &a);
        if (check_poisoned(a.ty)) {
            return;
        }
        if (a.ty->kind != types.type_kind.k_ptr) {
            check_msg_begin(ck);
            msg_str(ck, "cannot dereference ");
            check_msg_type(ck, a.ty);
            check_msg_end(ck, n->loc);
            return;
        }
        if (check_owning_temporary(ck, n->loc, &a, "dereferencing it leaves no owner")) {
            return;
        }
        out->ty = a.ty->elem;
        out->lvalue = true;
        out->is_mut = types.type_level_mut(a.ty, 1);
        // read-only memory stops at the indirection
        if (out->is_mut) {
            out->empty = empty_kind.empty_ok;
        } else {
            out->empty = empty_kind.empty_immutable;
        }
        return;
    }
    check_expr(ck, n->a, &a);
    if (op_of(n->op) == lexer.tok_kind.bang) {
        convert(ck, n->a, &a, types.type_prim(&ck->types, prim.prim_kind.prim_bool), "'!'");
        if (check_poisoned(a.ty)) {
            return;
        }
        out->ty = a.ty;
        if (a.value.kind == consts.cval_kind.cv_bool) {
            out->value = consts.cv_lnot(a.value);
            out->init_const = true;
        }
        return;
    }
    if (a.untyped) {
        // `~c` is `-c - 1`
        if (consts.cv_is_float(a.value) && op_of(n->op) == lexer.tok_kind.minus) {
            // flipping the sign bit never leaves the format
            untyped(ck, n, out, consts.cv_float_neg(a.value));
            return;
        }
        if (consts.cv_is_int_like(a.value)) {
            consts.cval mut v = consts.cv_none();
            consts.cval x = consts.cv_as_int(a.value);
            bool mut ok = false;
            if (op_of(n->op) == lexer.tok_kind.minus) {
                ok = consts.cv_neg(x, &v);
            } else {
                ok = consts.cv_not(x, &v);
            }
            if (!ok) {
                check_error(ck, n->loc, "constant expression out of range");
                return;
            }
            untyped(ck, n, out, v);
            return;
        }
        value_of(ck, n->a, &a);
    }
    if (check_poisoned(a.ty)) {
        return;
    }
    if (!type_is_integer_prim(a.ty)
        && !(op_of(n->op) == lexer.tok_kind.minus && types.type_is_float(a.ty))) {
        error_operand(ck, n->loc, n->op, "an integer operand", a.ty);
        return;
    }
    if (op_of(n->op) == lexer.tok_kind.minus && !prim.prim_is_signed(a.ty->prim)
        && !types.type_is_float(a.ty)) {
        error_operand(ck, n->loc, n->op, "a signed operand", a.ty);
        return;
    }
    out->ty = a.ty;
    if (consts.cv_is_float(a.value)) {
        out->value = consts.cv_float_neg(a.value);
        out->init_const = true;
        return;
    }
    if (consts.cv_is_int(a.value)) {
        consts.cval mut v = consts.cv_none();
        bool mut ok = false;
        if (op_of(n->op) == lexer.tok_kind.minus) {
            ok = consts.cv_typed_neg(a.value, a.ty->prim, &v);
        } else {
            ok = consts.cv_typed_not(a.value, a.ty->prim, &v);
        }
        if (!ok) {
            check_msg_begin(ck);
            msg_str(ck, "constant expression overflows ");
            msg_str(ck, prim.prim_name(a.ty->prim));
            check_msg_end(ck, n->loc);
            out->ty = types.type_error(&ck->types);
            return;
        }
        out->value = v;
        out->init_const = true;
    }
}

// An index, a span bound or a `new` count: any integer type is fine there and
// a negative constant is a compile error.
fn check_count(checker mut* ck, ast.node mut* n, string what, consts.cval mut* value) bool {
    expr mut e = expr{};
    check_expr(ck, n, &e);
    *value = e.value;
    if (consts.cv_is_int(e.value) && consts.cv_is_neg(e.value)) {
        check_msg_begin(ck);
        msg_str(ck, "a negative ");
        msg_str(ck, what);
        msg_str(ck, ": ");
        msg_value(ck, e.value);
        check_msg_end(ck, n->loc);
        return false;
    }
    value_of(ck, n, &e);
    if (check_poisoned(e.ty)) {
        return false;
    }
    if (!type_is_integer_prim(e.ty)) {
        check_msg_begin(ck);
        msg_str(ck, "a ");
        msg_str(ck, what);
        msg_str(ck, " must be an integer, not ");
        check_msg_type(ck, e.ty);
        check_msg_end(ck, n->loc);
        return false;
    }
    return true;
}

// The element type of an operand that may be indexed or spanned.
fn element_of(checker mut* ck, types.node* t) types.node* {
    if (t->kind == types.type_kind.k_array || t->kind == types.type_kind.k_span) {
        return t->elem;
    }
    if (t->kind == types.type_kind.k_string) {
        return types.type_prim(&ck->types, prim.prim_kind.prim_char);
    }
    return null;
}

fn check_index(checker mut* ck, ast.node mut* n, expr mut* out) void {
    expr mut a = expr{};
    check_operand(ck, n->a, &a);
    consts.cval mut index = consts.cv_none();
    bool ok = check_count(ck, n->b, "index", &index);
    if (check_poisoned(a.ty)) {
        return;
    }
    if (check_owning_temporary(ck, n->loc, &a, "indexing it leaves no owner")) {
        return;
    }
    types.node* elem = element_of(ck, a.ty);
    if (elem == null) {
        check_msg_begin(ck);
        check_msg_type(ck, a.ty);
        if (a.ty->kind == types.type_kind.k_ptr) {
            msg_str(ck, " cannot be indexed: write '(*p)[i]'");
        } else {
            msg_str(ck, " cannot be indexed");
        }
        check_msg_end(ck, n->loc);
        return;
    }
    if (!ok) {
        return;
    }
    if (a.ty->kind == types.type_kind.k_array && consts.cv_is_int(index)) {
        u64 mut i = 0;
        if (!consts.cv_to_u64(index, &i) || i >= a.ty->len) {
            check_msg_begin(ck);
            msg_str(ck, "index ");
            msg_value(ck, index);
            msg_str(ck, " out of range for ");
            check_msg_type(ck, a.ty);
            check_msg_end(ck, n->loc);
            return;
        }
    }
    out->ty = elem;
    // indexing an rvalue array yields a copy
    out->lvalue = a.ty->kind != types.type_kind.k_array || a.lvalue;
    if (a.ty->kind == types.type_kind.k_array) {
        out->is_mut = a.is_mut;
    } else {
        out->is_mut = a.ty->kind == types.type_kind.k_span && a.ty->is_mut;
    }
    if (a.ty->kind == types.type_kind.k_array) {
        out->empty = a.empty;
    } else if (out->is_mut) {
        out->empty = empty_kind.empty_ok;
    } else {
        out->empty = empty_kind.empty_immutable;
    }
}

fn check_span_expr(checker mut* ck, ast.node mut* n, expr mut* out) void {
    expr mut a = expr{};
    check_operand(ck, n->a, &a);
    bool mut ok = true;
    consts.cval mut bound = consts.cv_none();
    if (n->b != null && !check_count(ck, n->b, "span bound", &bound)) {
        ok = false;
    }
    if (n->c != null && !check_count(ck, n->c, "span bound", &bound)) {
        ok = false;
    }
    if (check_poisoned(a.ty) || !ok) {
        return;
    }
    if (check_owning_temporary(ck, n->loc, &a, "a span of it leaves no owner")) {
        return;
    }
    if (a.ty->kind == types.type_kind.k_ptr) {
        // a pointer has no length, so only the two-bound form
        if (n->b == null || n->c == null) {
            check_error(ck, n->loc, "a pointer has no length: write 'p[lo..hi]'");
            return;
        }
        out->ty = types.type_span(&ck->types, a.ty->elem, false, a.ty->is_mut);
        return;
    }
    if (a.ty->kind == types.type_kind.k_string) {
        out->ty = types.type_string(&ck->types, false);
        return;
    }
    types.node* elem = element_of(ck, a.ty);
    if (elem == null) {
        check_msg_begin(ck);
        msg_str(ck, "cannot take a span of ");
        check_msg_type(ck, a.ty);
        check_msg_end(ck, n->loc);
        return;
    }
    if (a.ty->kind == types.type_kind.k_array && !a.lvalue) {
        check_error(ck, n->loc, "a span of a fixed array needs an lvalue");
        return;
    }
    bool mut is_mut = a.ty->is_mut;
    if (a.ty->kind == types.type_kind.k_array) {
        is_mut = a.is_mut;
    }
    out->ty = types.type_span(&ck->types, elem, false, is_mut);
}

// ---- cast, sizeof and new ----------------------------------------------------------

fn check_cast(checker mut* ck, ast.node mut* n, expr mut* out) void {
    expr mut a = expr{};
    check_expr(ck, n->a, &a);
    if (a.value.kind == consts.cval_kind.cv_null) {
        check_error(ck, n->a->loc, "'null' is not a cast operand");
        check_type(ck, n->b, type_pos.pos_cast);
        return;
    }
    // a `cast` is not a context
    value_of(ck, n->a, &a);
    written_type target = check_type(ck, n->b, type_pos.pos_cast);
    if (check_poisoned(a.ty) || check_poisoned(target.ty)) {
        return;
    }
    if (!check_layout(ck, target.ty) || !check_size_fits(ck, n->loc, target.ty)) {
        return;
    }
    if (!types.type_cast_allowed(target.ty, a.ty)) {
        check_msg_begin(ck);
        msg_str(ck, "cannot cast ");
        check_msg_type(ck, a.ty);
        msg_str(ck, " to ");
        check_msg_type(ck, target.ty);
        if (types.type_cast_adds_mut(target.ty, a.ty)
            && types.type_cast_allowed(types.type_without_mut(&ck->types, target.ty), a.ty)) {
            // The mark is named when the mark is the reason: the same cast to
            // the same target without its marks is allowed. A pair that another
            // row refuses as well says nothing about the mark, since a reader
            // who drops it meets the second refusal.
            msg_str(ck, ": a cast never adds 'mut'");
        }
        check_msg_end(ck, n->loc);
        return;
    }
    if (types.type_cast_adds_own(target.ty, a.ty)) {
        // D3.14: a cast carries `own` or drops it and never adds it, at any
        // level. The matrix admits the shape, so the test stands here, after
        // the matrix: a target that adds `mut` as well reports the `mut`.
        check_msg_begin(ck);
        msg_str(ck, "cannot cast ");
        check_msg_type(ck, a.ty);
        msg_str(ck, " to ");
        check_msg_type(ck, target.ty);
        msg_str(ck, ": a cast never adds 'own'");
        check_msg_end(ck, n->loc);
        return;
    }
    if (check_owning(target.ty)) {
        if (a.lvalue && check_owning(a.ty)) {
            check_msg_begin(ck);
            msg_str(ck, "casting an owning value to an owning type requires 'move'");
            if (a.sym != null && n->a->kind == ast.ast_kind.k_ident) {
                // As above: a hint that spells an expression is offered only
                // for a name.
                msg_str(ck, ": write move(");
                msg_str(ck, a.sym->name);
                msg_str(ck, ")");
            }
            check_msg_end(ck, n->loc);
            return;
        }
    } else if (check_owning_temporary(ck, n->loc, &a, "the cast target does not own it")) {
        return;
    }
    out->ty = target.ty;
    // the value the run time would produce
    bool numeric = target.ty->kind == types.type_kind.k_prim
        || target.ty->kind == types.type_kind.k_enum;
    if (numeric && (consts.cv_is_int_like(a.value) || consts.cv_is_float(a.value))
        && (a.ty->kind == types.type_kind.k_prim || a.ty->kind == types.type_kind.k_enum)) {
        prim.prim_kind mut k = target.ty->prim;
        if (target.ty->kind == types.type_kind.k_enum) {
            k = enum_underlying();
        }
        consts.cval mut v = consts.cv_none();
        if (consts.cv_cast(a.value, k, &v)) {
            out->value = v;
            out->init_const = true;
        } else if (types.type_is_float(target.ty)) {
            // what is left is a float constant the format cannot hold
            check_msg_begin(ck);
            msg_str(ck, "a float constant out of range for ");
            check_msg_type(ck, target.ty);
            check_msg_end(ck, n->loc);
            out->ty = types.type_error(&ck->types);
        }
    }
}

fn check_sizeof(checker mut* ck, ast.node mut* n, expr mut* out) void {
    written_type t = check_type(ck, n->a, type_pos.pos_binding);
    if (check_poisoned(t.ty)) {
        return;
    }
    if (t.ty->kind == types.type_kind.k_void) {
        check_error(ck, n->loc, "'sizeof' needs a sized type, not void");
        return;
    }
    if (!check_layout(ck, t.ty) || !check_size_fits(ck, n->loc, t.ty)) {
        return;
    }
    untyped(ck, n, out, consts.cv_from_u64(types.type_sizeof(t.ty)));
}

fn check_new(checker mut* ck, ast.node mut* n, expr mut* out) void {
    written_type t = check_type(ck, n->a, type_pos.pos_alloc);
    consts.cval mut count = consts.cv_none();
    bool counted = n->b != null;
    bool ok = !counted || check_count(ck, n->b, "count", &count);
    if (check_poisoned(t.ty) || !ok) {
        return;
    }
    if (t.ty->kind == types.type_kind.k_void) {
        // `new(void*)` is one pointer slot and is legal
        check_error(ck, n->loc, "'new' needs a sized type, not void");
        return;
    }
    if (!check_layout(ck, t.ty) || !check_size_fits(ck, n->loc, t.ty)) {
        return;
    }
    if (counted) {
        out->ty = types.type_span(&ck->types, t.ty, true, t.mut0);
    } else {
        out->ty = types.type_ptr(&ck->types, t.ty, true, t.mut0);
    }
}

// ---- calls -------------------------------------------------------------------------

fn is_builtin(ast.sym* s, string name) bool {
    return s != null && s->kind == ast.sym_kind.s_builtin && s->name == name;
}

// Printable types exclude structs, arrays, and spans.
fn type_is_printable(types.node* t) bool {
    switch (t->kind) {
    case types.type_kind.k_prim, types.type_kind.k_enum, types.type_kind.k_ptr,
         types.type_kind.k_voidptr, types.type_kind.k_fn, types.type_kind.k_string:
        return true;
    default:
        return false;
    }
}

// "'assert' takes 1 argument, 2 given" and "'add' takes 2 arguments, 1 given".
fn check_arity(checker mut* ck, ast.node* n, string name, u64 want) bool {
    u64 got = ast.ast_len(n);
    if (got == want) {
        return true;
    }
    check_msg_begin(ck);
    msg_quote(ck, name);
    msg_str(ck, " takes ");
    msg_uint(ck, want);
    if (want == 1) {
        msg_str(ck, " argument, ");
    } else {
        msg_str(ck, " arguments, ");
    }
    msg_uint(ck, got);
    msg_str(ck, " given");
    check_msg_end(ck, n->loc);
    return false;
}

// A C variable tail accepts zero or more arguments after its fixed prefix.
fn check_arity_at_least(checker mut* ck, ast.node* n, string name, u64 want) bool {
    u64 got = ast.ast_len(n);
    if (got >= want) {
        return true;
    }
    check_msg_begin(ck);
    msg_quote(ck, name);
    msg_str(ck, " takes at least ");
    msg_uint(ck, want);
    if (want == 1) {
        msg_str(ck, " argument, ");
    } else {
        msg_str(ck, " arguments, ");
    }
    msg_uint(ck, got);
    msg_str(ck, " given");
    check_msg_end(ck, n->loc);
    return false;
}

// C default promotions require explicit casts before a variable tail.
fn c_tail_legal(types.node* t) bool {
    switch (t->kind) {
    case types.type_kind.k_ptr, types.type_kind.k_voidptr:
        return true;
    case types.type_kind.k_fn:
        return extern_legal(t);
    case types.type_kind.k_prim:
        switch (t->prim) {
        case prim.prim_kind.prim_i32, prim.prim_kind.prim_u32, prim.prim_kind.prim_i64,
             prim.prim_kind.prim_u64, prim.prim_kind.prim_f64:
            return true;
        default:
            return false;
        }
    default:
        return false;
    }
}

// The print family (8.3): zero or more printable arguments, each taking its
// default type, after the descriptor of the `fprint` forms.
fn check_print(checker mut* ck, ast.node mut* n, u64 first) void {
    u64 mut i = first;
    while (i < ast.ast_len(n)) {
        ast.node mut* arg = ast_child_mut(n, i);
        expr mut e = expr{};
        check_expr_default(ck, arg, &e);
        if (!check_poisoned(e.ty) && !type_is_printable(e.ty)) {
            check_msg_begin(ck);
            msg_str(ck, "cannot print a value of type ");
            check_msg_type(ck, e.ty);
            check_msg_end(ck, arg->loc);
        }
        i += 1;
    }
}

/// Whether `move` and `del` may empty the checked lvalue `n`, from the two
/// bits check_expr wrote on it (D17.9). It panics on a node without
/// ANN_LVALUE, where the answer has no meaning, and on a node with both bits.
fn empty_of(ast.node* n) empty_kind {
    if ((n->ann & ANN_LVALUE) == 0) {
        panic("check.empty_of: not a checked lvalue");
    }
    u32 bits = n->ann & (ANN_EMPTY_READONLY | ANN_EMPTY_IMMUTABLE);
    if (bits == 0) {
        return empty_kind.empty_ok;
    }
    if (bits == ANN_EMPTY_READONLY) {
        return empty_kind.empty_readonly;
    }
    if (bits == ANN_EMPTY_IMMUTABLE) {
        return empty_kind.empty_immutable;
    }
    panic("check.empty_of: both emptiability bits");
}

// Whether the checked lvalue `arg` may be emptied by `move` or `del`. An
// operand reached through an indirection needs that level mutable, because the
// store is visible to everyone else who holds the pointer or span. `verb` is
// the builtin's name, which the diagnostic quotes. The answer comes from the
// node, as the linear check reads it.
fn check_emptiable(checker mut* ck, ast.node* arg, string verb) bool {
    empty_kind empty = empty_of(arg);
    if (empty == empty_kind.empty_ok) {
        return true;
    }
    check_msg_begin(ck);
    msg_quote(ck, verb);
    // The reason is the lvalue's own, not its outermost symbol's: `C.data` of
    // a module-level constant is read-only memory although `data` is a field.
    if (empty == empty_kind.empty_readonly) {
        msg_str(ck, " cannot empty a module-level constant: it lives in read-only memory");
    } else {
        msg_str(ck, " cannot empty an immutable indirection: nothing may be taken out of what ");
        msg_str(ck, "was only lent");
    }
    check_msg_end(ck, arg->loc);
    return false;
}

fn check_builtin_call(checker mut* ck, ast.node mut* n, ast.sym* s, expr mut* out) void {
    out->sym = s;
    out->ty = types.type_void(&ck->types);
    if (is_builtin(s, "print") || is_builtin(s, "println") || is_builtin(s, "eprint")
        || is_builtin(s, "eprintln")) {
        check_print(ck, n, 0);
        return;
    }
    if (is_builtin(s, "fprint") || is_builtin(s, "fprintln")) {
        if (ast.ast_len(n) == 0) {
            check_msg_begin(ck);
            msg_quote(ck, s->name);
            msg_str(ck, " takes a descriptor and then its arguments");
            check_msg_end(ck, n->loc);
            return;
        }
        expr mut fd = expr{};
        check_expr_as(ck, ast_child_mut(n, 0), types.type_prim(&ck->types,
                      prim.prim_kind.prim_i32), "a descriptor", &fd);
        check_print(ck, n, 1);
        return;
    }
    if (is_builtin(s, "assert")) {
        if (check_arity(ck, n, s->name, 1)) {
            // `assert` is active in both build modes
            check_condition(ck, ast_child_mut(n, 0), "'assert'");
        }
        return;
    }
    if (is_builtin(s, "panic")) {
        if (check_arity(ck, n, s->name, 1)) {
            expr mut m = expr{};
            check_expr_as(ck, ast_child_mut(n, 0), types.type_string(&ck->types, false),
                          "'panic'", &m);
        }
        n->ann |= ANN_NORETURN;
        return;
    }
    if (is_builtin(s, "del")) {
        if (!check_arity(ck, n, s->name, 1)) {
            return;
        }
        ast.node mut* arg = ast_child_mut(n, 0);
        expr mut e = expr{};
        check_operand(ck, arg, &e);
        if (e.untyped && e.value.kind == consts.cval_kind.cv_null) {
            // `del(null)` is a no-op
            convert(ck, arg, &e, types.type_voidptr(&ck->types, true, false), "'del'");
            return;
        }
        if (check_poisoned(e.ty)) {
            return;
        }
        if (!types.type_is_reference(e.ty) || !e.ty->is_own) {
            check_msg_begin(ck);
            msg_quote(ck, s->name);
            if (types.type_is_reference(e.ty)) {
                msg_str(ck, " needs an owning operand, not ");
            } else {
                msg_str(ck, " takes a reference, not ");
            }
            check_msg_type(ck, e.ty);
            check_msg_end(ck, arg->loc);
            return;
        }
        if (e.lvalue) {
            // on an rvalue `del` only frees
            check_emptiable(ck, arg, s->name);
        }
        return;
    }
    if (is_builtin(s, "move")) {
        // The emitter reads this bit, not the name of the callee.
        n->ann |= ANN_MOVE;
        if (!check_arity(ck, n, s->name, 1)) {
            return;
        }
        ast.node mut* arg = ast_child_mut(n, 0);
        expr mut e = expr{};
        check_operand(ck, arg, &e);
        if (check_poisoned(e.ty)) {
            return;
        }
        // a `void` result would add "'move' has no value"
        out->ty = types.type_error(&ck->types);
        if (!e.lvalue) {
            check_error(ck, arg->loc, "'move' takes an lvalue");
            return;
        }
        if (!check_owning(e.ty)) {
            check_msg_begin(ck);
            msg_str(ck, "'move' needs an owning operand, not ");
            check_msg_type(ck, e.ty);
            check_msg_end(ck, arg->loc);
            return;
        }
        if (!check_emptiable(ck, arg, s->name)) {
            return;
        }
        // the one universe function with a value
        out->ty = e.ty;
        return;
    }
    panic("check.check_builtin_call: unknown builtin");
}

fn check_call(checker mut* ck, ast.node mut* n, expr mut* out) void {
    ast.node mut* callee = n->a;
    if (callee->kind == ast.ast_kind.k_ident && lookup(ck, callee->name) == null) {
        ast.sym mut* b = check_builtin(ck, callee->name);
        if (b != null) {
            callee->sym = b;
            callee->ty = types.type_void(&ck->types);
            check_builtin_call(ck, n, b, out);
            return;
        }
    }
    expr mut f = expr{};
    // the callee is the one position an `extern fn` may stand in
    ast.node* outer_callee = ck->callee;
    ck->callee = callee;
    check_operand(ck, callee, &f);
    ck->callee = outer_callee;
    out->sym = f.sym;
    if (!check_poisoned(f.ty) && f.ty->kind != types.type_kind.k_fn) {
        check_msg_begin(ck);
        msg_str(ck, "cannot call a value of type ");
        check_msg_type(ck, f.ty);
        check_msg_end(ck, n->loc);
        f.ty = types.type_error(&ck->types);
    }
    bool known = !check_poisoned(f.ty);
    if (known) {
        string mut name = "the callee";
        if (f.sym != null) {
            name = f.sym->name;
        }
        bool variadic = f.sym != null && f.sym->kind == ast.sym_kind.s_extern_fn
            && (f.sym->node->flags & ast.FLAG_VARIADIC) != 0;
        bool mut arity_ok = false;
        if (variadic) {
            arity_ok = check_arity_at_least(ck, n, name, f.ty->params.len);
        } else {
            arity_ok = check_arity(ck, n, name, f.ty->params.len);
        }
        if (!arity_ok) {
            return;
        }
    }
    u64 mut i = 0;
    while (i < ast.ast_len(n)) {
        expr mut arg = expr{};
        if (known && i < f.ty->params.len) {
            check_expr_as(ck, ast_child_mut(n, i), f.ty->params[i], "the argument", &arg);
        } else {
            check_expr_default(ck, ast_child_mut(n, i), &arg);
            if (known && !check_poisoned(arg.ty) && !c_tail_legal(arg.ty)) {
                check_msg_begin(ck);
                msg_str(ck, "C variable tail cannot use type '");
                check_msg_type(ck, arg.ty);
                msg_str(ck, "'");
                check_msg_end(ck, ast.ast_child(n, i)->loc);
            }
        }
        i += 1;
    }
    if (!known) {
        return;
    }
    out->ty = f.ty->elem;
    if (f.ty->is_noreturn) {
        n->ann |= ANN_NORETURN;
    }
}

// ---- struct and array literals -----------------------------------------------------

// The designated form: any order, omitted fields zeroed, no duplicates, and
// designators only on structs.
fn check_designated(checker mut* ck, ast.node mut* n, types.node* t, expr mut* out) void {
    ast.sym* s = nominal_sym(t);
    u64 mut i = 0;
    while (i < ast.ast_len(n)) {
        ast.node mut* d = ast_child_mut(n, i);
        if (d->kind != ast.ast_kind.k_designator) {
            i += 1;
            continue;
        }
        ast.node* mut f = null;
        if (s != null) {
            f = struct_field(s, d->name);
        }
        if (f == null) {
            check_msg_begin(ck);
            msg_str(ck, "struct ");
            msg_str(ck, t->name);
            msg_str(ck, " has no field ");
            msg_quote(ck, d->name);
            check_msg_end(ck, d->name_loc);
            out->ty = types.type_error(&ck->types);
            i += 1;
            continue;
        }
        u64 mut k = 0;
        while (k < i) {
            if (ast.ast_child(n, k)->name == d->name) {
                check_msg_begin(ck);
                msg_str(ck, "duplicate field ");
                msg_quote(ck, d->name);
                check_msg_end(ck, d->name_loc);
                out->ty = types.type_error(&ck->types);
            }
            k += 1;
        }
        d->sym = f->sym;
        if (f->sym != null) {
            d->ty = f->sym->ty;
        } else {
            d->ty = types.type_error(&ck->types);
        }
        expr mut v = expr{};
        check_initializer(ck, d->a, d->ty, "the field", &v);
        out->init_const = out->init_const && v.init_const;
        i += 1;
    }
}

// A bare `{... }` against the type it initializes.
fn check_brace(checker mut* ck, ast.node mut* n, types.node* t, expr mut* out) void {
    n->ty = t;
    out->ty = t;
    out->init_const = true;
    if (check_poisoned(t)) {
        out->ty = types.type_error(&ck->types);
        return;
    }
    u64 count = ast.ast_len(n);
    if ((n->flags & ast.FLAG_DESIGNATED) != 0) {
        if (t->kind != types.type_kind.k_struct) {
            check_msg_begin(ck);
            msg_str(ck, "designated initializers need a struct, not ");
            check_msg_type(ck, t);
            check_msg_end(ck, n->loc);
            out->ty = types.type_error(&ck->types);
            return;
        }
        check_designated(ck, n, t, out);
        return;
    }
    if (count == 0) {
        if (t->kind == types.type_kind.k_struct || t->kind == types.type_kind.k_array
            || t->kind == types.type_kind.k_span || t->kind == types.type_kind.k_string
            || t->kind == types.type_kind.k_enum) {
            return;
        }
        check_msg_begin(ck);
        msg_str(ck, "'{}' initializes an aggregate, span, string or enum, not ");
        check_msg_type(ck, t);
        check_msg_end(ck, n->loc);
        out->ty = types.type_error(&ck->types);
        return;
    }
    if (t->kind == types.type_kind.k_struct) {
        ast.sym* s = nominal_sym(t);
        u64 mut fields = 0;
        u64 mut i = 0;
        while (s != null && s->node != null && i < ast.ast_len(s->node)) {
            if (ast.ast_child(s->node, i)->kind == ast.ast_kind.k_field_decl) {
                fields += 1;
            }
            i += 1;
        }
        if (count != fields) {
            check_msg_begin(ck);
            msg_str(ck, "a positional literal of struct ");
            msg_str(ck, t->name);
            msg_str(ck, " needs its ");
            msg_uint(ck, fields);
            if (fields == 1) {
                msg_str(ck, " field, ");
            } else {
                msg_str(ck, " fields, ");
            }
            msg_uint(ck, count);
            msg_str(ck, " given");
            check_msg_end(ck, n->loc);
            out->ty = types.type_error(&ck->types);
            return;
        }
        u64 mut at = 0;
        u64 mut k = 0;
        while (k < ast.ast_len(s->node)) {
            ast.node* f = ast.ast_child(s->node, k);
            if (f->kind == ast.ast_kind.k_field_decl) {
                expr mut v = expr{};
                types.node* mut ft = types.type_error(&ck->types);
                if (f->sym != null) {
                    ft = f->sym->ty;
                }
                check_initializer(ck, ast_child_mut(n, at), ft, "the field", &v);
                out->init_const = out->init_const && v.init_const;
                at += 1;
            }
            k += 1;
        }
        return;
    }
    if (t->kind == types.type_kind.k_array) {
        if (count != t->len) {
            check_msg_begin(ck);
            msg_str(ck, "an array literal for ");
            check_msg_type(ck, t);
            msg_str(ck, " needs ");
            msg_uint(ck, t->len);
            if (t->len == 1) {
                msg_str(ck, " element, ");
            } else {
                msg_str(ck, " elements, ");
            }
            msg_uint(ck, count);
            msg_str(ck, " given");
            check_msg_end(ck, n->loc);
            out->ty = types.type_error(&ck->types);
            return;
        }
        u64 mut i = 0;
        while (i < count) {
            expr mut v = expr{};
            check_initializer(ck, ast_child_mut(n, i), t->elem, "the element", &v);
            out->init_const = out->init_const && v.init_const;
            i += 1;
        }
        return;
    }
    check_msg_begin(ck);
    if (t->kind == types.type_kind.k_span) {
        msg_str(ck, "a span literal does not exist: write '{}' for the zero span");
    } else {
        msg_str(ck, "a brace initializer needs a struct or array type, not ");
        check_msg_type(ck, t);
    }
    check_msg_end(ck, n->loc);
    out->ty = types.type_error(&ck->types);
}

// Checks the initializer of a declaration of type `target`, which may be a bare
// `{... }`.
fn check_initializer(checker mut* ck, ast.node mut* n, types.node* target, string what,
                          expr mut* out) void {
    expr_clear(ck, out);
    if (n->kind == ast.ast_kind.k_brace_init) {
        check_brace(ck, n, target, out);
        return;
    }
    check_expr_as(ck, n, target, what, out);
}

// `point{1, 2}` and `i32[3]{1, 2, 3}`: a literal is an rvalue whose type its
// own name gives.
fn check_literal(checker mut* ck, ast.node mut* n, expr mut* out, bool array) void {
    written_type mut t = written_type{};
    if (array) {
        t = check_type(ck, n->a, type_pos.pos_binding);
    } else {
        t = type_result(base_type(ck, n->a, false, true), false);
    }
    if (check_poisoned(t.ty)) {
        expr mut ignored = expr{};
        check_brace(ck, n->b, t.ty, &ignored);
        return;
    }
    bool mut wrong = t.ty->kind != types.type_kind.k_struct;
    if (array) {
        wrong = t.ty->kind != types.type_kind.k_array;
    }
    if (wrong) {
        check_msg_begin(ck);
        check_msg_type(ck, t.ty);
        if (array) {
            msg_str(ck, " is not an array type");
        } else {
            msg_str(ck, " is not a struct type");
        }
        check_msg_end(ck, n->a->loc);
        return;
    }
    if (!check_layout(ck, t.ty) || !check_size_fits(ck, n->loc, t.ty)) {
        return;
    }
    check_brace(ck, n->b, t.ty, out);
}

// ---- the conditional operator ------------------------------------------------------

// Whether an arm keeps its `own` in the result: an `own` rvalue, which has no
// other owner, or `null`, which owns nothing. Two such arms are the one case
// where the conditional yields an `own` value.
fn arm_keeps_own(expr* e) bool {
    return e->value.kind == consts.cval_kind.cv_null || is_owning_rvalue(e);
}

// The value of a conditional whose three parts are constants: the arm the
// condition selects, since the other arm is not evaluated. That is what makes
// `?:` a constant expression.
fn fold_ternary(checker mut* ck, ast.node* n, expr* a, expr* b, expr mut* out) void {
    consts.cval c = check_node_value(ck, n->a);
    if (c.kind != consts.cval_kind.cv_bool || a->value.kind == consts.cval_kind.cv_none
        || b->value.kind == consts.cval_kind.cv_none) {
        return;
    }
    out->init_const = a->init_const && b->init_const;
    if (c.mag != 0) {
        out->value = a->value;
    } else {
        out->value = b->value;
    }
}

// Two untyped arms: the conditional is untyped too and takes its type from the
// context, as every untyped constant does. A folded condition also gives it the
// selected arm's value and provisional type.
fn ternary_untyped(checker mut* ck, ast.node* n, expr* a, expr* b, expr mut* out) void {
    out->untyped = true;
    out->ty = a->ty;
    consts.cval c = check_node_value(ck, n->a);
    if (c.kind != consts.cval_kind.cv_bool) {
        return;
    }
    fold_ternary(ck, n, a, b, out);
    if (c.mag != 0) {
        out->ty = a->ty;
    } else {
        out->ty = b->ty;
    }
}

// Checks `cond ? a : b`. The condition must be bool. An untyped arm adopts the
// other arm's type. Both arms must then have one type, including mutability.
//
// The arms lend, so an `own` lvalue arm yields a view. The result is `own` only
// when both arms are `own` rvalues or `null`: lending an `own` rvalue would leave
// nothing able to free it.
fn check_ternary(checker mut* ck, ast.node mut* n, expr mut* out) void {
    check_condition(ck, n->a, "a condition");
    expr mut a = expr{};
    expr mut b = expr{};
    check_expr(ck, n->b, &a);
    check_expr(ck, n->c, &b);
    expr_clear(ck, out);
    if (check_no_value(ck, n->b, &a) || check_no_value(ck, n->c, &b)) {
        return;
    }
    if (a.untyped && b.untyped) {
        ternary_untyped(ck, n, &a, &b, out);
        return;
    }
    if (a.untyped) {
        convert(ck, n->b, &a, b.ty, "the arm of '?:'");
    } else if (b.untyped) {
        convert(ck, n->c, &b, a.ty, "the arm of '?:'");
    }
    if (check_poisoned(a.ty) || check_poisoned(b.ty)) {
        return;
    }
    types.node* mut lt = a.ty;
    types.node* mut rt = b.ty;
    if (!arm_keeps_own(&a) || !arm_keeps_own(&b)) {
        if (check_owning_temporary(ck, n->b->loc, &a, "the other arm does not own")
            || check_owning_temporary(ck, n->c->loc, &b, "the other arm does not own")) {
            return;
        }
        lt = check_lend(ck, a.ty);
        rt = check_lend(ck, b.ty);
    }
    if (!types.type_equal(lt, rt)) {
        // mutability levels included
        check_msg_begin(ck);
        msg_str(ck, "'?:' takes two operands of the same type, not ");
        check_msg_type(ck, a.ty);
        msg_str(ck, " and ");
        check_msg_type(ck, b.ty);
        check_msg_end(ck, n->loc);
        return;
    }
    out->ty = lt;
    // Both arms then meet the result type, which is where the transfer rule lives.
    // Lending strips reference ownership, but not aggregate ownership by value.
    // Thus, an owning aggregate arm still owns after check_lend. Otherwise, two
    // owning lvalue arms could copy into an owning rvalue without emptying either
    // source. Deleting both sources would then free one allocation twice. Written
    // `move` in each arm empties both sources and yields two owning
    // rvalues, which is the case above. The first arm alone is converted when it
    // fails, so one copy reports one diagnostic.
    convert(ck, n->b, &a, lt, "the arm of '?:'");
    if (!check_poisoned(a.ty)) {
        convert(ck, n->c, &b, lt, "the arm of '?:'");
    }
    if (check_poisoned(a.ty) || check_poisoned(b.ty)) {
        out->ty = types.type_error(&ck->types);
        return;
    }
    fold_ternary(ck, n, &a, &b, out);
}

// A float literal is an untyped binary64 constant. The lexer already checked
// its shape. This function reports a value that binary64 cannot hold. Such a
// value is an error, not infinity.
fn check_float_literal(checker mut* ck, ast.node mut* n, expr mut* out) void {
    consts.cval mut v = consts.cv_none();
    if (!consts.cv_from_float_text(n->name, &v)) {
        check_error(ck, n->loc, "float literal out of range for f64");
        out->ty = types.type_error(&ck->types);
        return;
    }
    untyped(ck, n, out, v);
}

// ---- the dispatch ------------------------------------------------------------------

// Checks one expression and annotates its node.
fn check_expr(checker mut* ck, ast.node mut* n, expr mut* out) void {
    expr_clear(ck, out);
    switch (n->kind) {
    case ast.ast_kind.k_int:
        untyped(ck, n, out, consts.cv_from_u64(n->ival));
    case ast.ast_kind.k_float:
        check_float_literal(ck, n, out);
    case ast.ast_kind.k_char:
        untyped(ck, n, out, consts.cv_from_char(n->ival));
    case ast.ast_kind.k_null:
        untyped(ck, n, out, consts.cv_null());
    case ast.ast_kind.k_bool:
        out->ty = types.type_prim(&ck->types, prim.prim_kind.prim_bool);
        out->value = consts.cv_from_bool(n->ival != 0);
        out->init_const = true;
    case ast.ast_kind.k_string:
        out->ty = types.type_string(&ck->types, false);
        out->value = consts.cv_from_str(n->name);
        out->init_const = true;
    case ast.ast_kind.k_cfg:
        // one configuration map serves the complete closure
        string mut value = "";
        if (!session.config_get(ck->sess, n->name, &value)) {
            check_msg_begin(ck);
            msg_str(ck, "configuration key ");
            msg_quote(ck, n->name);
            msg_str(ck, " is not set");
            check_msg_end(ck, n->loc);
        } else {
            out->ty = types.type_string(&ck->types, false);
            out->value = consts.cv_from_str(value);
            out->init_const = true;
        }
    case ast.ast_kind.k_ident:
        check_ident(ck, n, out);
    case ast.ast_kind.k_unary:
        check_unary(ck, n, out);
    case ast.ast_kind.k_binary:
        expr mut a = expr{};
        expr mut b = expr{};
        check_expr(ck, n->a, &a);
        check_expr(ck, n->b, &b);
        check_operands(ck, n->loc, n->op, n->a, &a, n->b, &b, out);
        out->init_const = out->value.kind != consts.cval_kind.cv_none;
    case ast.ast_kind.k_call:
        check_call(ck, n, out);
    case ast.ast_kind.k_index:
        check_index(ck, n, out);
    case ast.ast_kind.k_span:
        check_span_expr(ck, n, out);
    case ast.ast_kind.k_field:
        check_field(ck, n, out, false);
    case ast.ast_kind.k_arrow:
        check_field(ck, n, out, true);
    case ast.ast_kind.k_cast:
        check_cast(ck, n, out);
    case ast.ast_kind.k_sizeof:
        check_sizeof(ck, n, out);
    case ast.ast_kind.k_new:
        check_new(ck, n, out);
    case ast.ast_kind.k_struct_lit:
        check_literal(ck, n, out, false);
    case ast.ast_kind.k_array_lit:
        check_literal(ck, n, out, true);
    case ast.ast_kind.k_brace_init:
        check_error(ck, n->loc, "a brace initializer is not an expression");
    case ast.ast_kind.k_ternary:
        check_ternary(ck, n, out);
    case ast.ast_kind.k_error:
        // already reported
    default:
        panic("check.check_expr: not an expression");
    }
    n->ty = out->ty;
    if (out->untyped) {
        n->ann |= ANN_UNTYPED;
    }
    if (out->lvalue) {
        n->ann |= ANN_LVALUE;
        // `empty` has a meaning only on an lvalue, so no other node gets a bit.
        switch (out->empty) {
        case empty_kind.empty_ok:
            // no bit
        case empty_kind.empty_readonly:
            n->ann |= ANN_EMPTY_READONLY;
        case empty_kind.empty_immutable:
            n->ann |= ANN_EMPTY_IMMUTABLE;
        }
    }
    if (out->value.kind != consts.cval_kind.cv_none && (n->ann & ANN_CONST) == 0) {
        set_value(ck, n, out->value);
    }
}

// ---- declarations ------------------------------------------------------------------

// The two states of the lazy resolution, kept on the declaring node.
fn resolving(ast.node* n) bool {
    return n != null && (n->ann & ANN_RESOLVING) != 0;
}

fn resolved(ast.node* n) bool {
    return n != null && (n->ann & ANN_RESOLVED) != 0;
}

fn resolve_sym(checker mut* ck, ast.sym mut* s) void {
    if (s == null || s->node == null || resolved(s->node)) {
        return;
    }
    if (resolving(s->node)) {
        // only value containment is a cycle
        if (s->kind == ast.sym_kind.s_struct) {
            return;
        }
        if (ck->addr_only
            && (s->kind == ast.sym_kind.s_const || s->kind == ast.sym_kind.s_global)
            && s->ty != null) {
            // `&N` inside N's initializer does not close a cycle. It asks only
            // for an address. Any module, including this one, can take the
            // address of a module declaration. resolve_var writes the type before
            // checking the initializer, so all required data is available. The
            // value stays cv_none because an address is not a constant value.
            return;
        }
        // An enum member value cannot depend on itself either.
        check_msg_begin(ck);
        msg_quote(ck, s->name);
        msg_str(ck, " is defined in terms of itself");
        check_msg_end(ck, s->decl);
        ast.node mut* cyclic = s->node;
        cyclic->ann |= ANN_RESOLVED;
        sym_fail(ck, s);
        return;
    }
    ast.node mut* n = s->node;
    n->ann |= ANN_RESOLVING;
    switch (s->kind) {
    case ast.sym_kind.s_struct:
        resolve_struct(ck, s);
    case ast.sym_kind.s_enum:
        resolve_enum(ck, s);
    case ast.sym_kind.s_fn, ast.sym_kind.s_extern_fn:
        resolve_fn(ck, s);
    case ast.sym_kind.s_const, ast.sym_kind.s_global:
        resolve_var(ck, s);
    default:
        // a field, a local, a parameter and a builtin are complete
    }
    n->ann &= ~ANN_RESOLVING;
    n->ann |= ANN_RESOLVED;
    n->ty = s->ty;
    n->sym = s;
}

fn resolve_struct(checker mut* ck, ast.sym mut* s) void {
    ast.node mut* decl = s->node;
    // a field that fails poisons the type; still close the layout
    types.node* record = s->ty;
    if (!types.type_layout_begin(record)) {
        panic("check.resolve_struct: a struct laid out twice");
    }
    types.node*[MAX_MEMBERS] mut fields = {};
    u64[MAX_MEMBERS] mut offsets = {};
    u64 mut n = 0;
    bool mut ok = true;
    u64 mut i = 0;
    while (i < ast.ast_len(decl)) {
        ast.node mut* f = ast_child_mut(decl, i);
        i += 1;
        if (f->kind != ast.ast_kind.k_field_decl) {
            continue;
        }
        if (n >= MAX_MEMBERS) {
            check_error(ck, f->loc, "too many fields");
            ok = false;
            break;
        }
        written_type ft = check_type(ck, f->a, type_pos.pos_field);
        ast.sym mut* fs = check_sym_new(ck, ast.sym_kind.s_field, f->name, f, s);
        fs->ty = ft.ty;
        f->sym = fs;
        f->ty = ft.ty;
        if (check_poisoned(ft.ty) || !check_layout(ck, ft.ty)
            || !check_size_fits(ck, f->loc, ft.ty)) {
            sym_fail(ck, fs);
            ok = false;
            continue;
        }
        fields[n] = ft.ty;
        n += 1;
    }
    if (!ok || n == 0) {
        // the parser reports a body with no field, so these failed
        if (types.type_layout_state(record) != types.layout_state.l_error) {
            types.type_layout_fail(record);
        }
        sym_fail(ck, s);
        return;
    }
    if (!types.type_layout_struct(record, fields[0..n], offsets[0..n])) {
        // Report the error at the `struct` keyword.
        check_msg_begin(ck);
        msg_str(ck, "type is too large: struct ");
        msg_str(ck, s->name);
        check_msg_end(ck, keyword_range(decl->loc, STRUCT_KEYWORD_LEN));
        sym_fail(ck, s);
        return;
    }
    u64 mut at = 0;
    u64 mut k = 0;
    while (k < ast.ast_len(decl)) {
        ast.node mut* f = ast_child_mut(decl, k);
        if (f->kind == ast.ast_kind.k_field_decl) {
            // Records the field byte offset on its declaration. The emitter names
            // fields by index and lets LLVM use the same layout. Only checker
            // suites read these offsets. They record the compiler answer for a
            // complete declaration. The loop visits exactly the fields in the IR
            // struct type. Each failed field already left `ok` false.
            f->aux = offsets[at];
            at += 1;
        }
        k += 1;
    }
}

fn resolve_enum(checker mut* ck, ast.sym mut* s) void {
    ast.node mut* decl = s->node;
    prim.prim_kind underlying = enum_underlying();
    consts.cval mut next = consts.cv_from_i64(0);
    bool mut ok = true;
    u64 mut i = 0;
    while (i < ast.ast_len(decl)) {
        ast.node mut* m = ast_child_mut(decl, i);
        u64 index = i;
        i += 1;
        if (m->kind != ast.ast_kind.k_enum_member) {
            continue;
        }
        ast.sym mut* ms = check_sym_new(ck, ast.sym_kind.s_enum_member, m->name, m, s);
        ms->ty = s->ty;
        m->sym = ms;
        m->ty = s->ty;
        consts.cval mut v = next;
        if (m->a != null) {
            // a value may not refer to the enum itself
            expr mut e = expr{};
            check_expr_default(ck, m->a, &e);
            if (consts.cv_is_float(e.value)) {
                // an enum is an i32, which is the rule it broke
                check_error(ck, m->a->loc, "an enum value is an integer constant, not a float");
                sym_fail(ck, ms);
                ok = false;
                continue;
            }
            if (!consts.cv_is_int(e.value)) {
                if (!check_poisoned(e.ty)) {
                    check_error(ck, m->a->loc, "an enum value must be a constant expression");
                }
                sym_fail(ck, ms);
                ok = false;
                continue;
            }
            v = e.value;
        }
        if (!consts.cv_fits(v, underlying)) {
            check_msg_begin(ck);
            msg_str(ck, "enum value ");
            msg_value(ck, v);
            msg_str(ck, " does not fit i32");
            check_msg_end(ck, m->loc);
            sym_fail(ck, ms);
            ok = false;
            continue;
        }
        u64 mut k = 0;
        while (k < index) {
            ast.node* other = ast.ast_child(decl, k);
            if (other->kind == ast.ast_kind.k_enum_member
                && consts.cv_eq(check_node_value(ck, other), v)) {
                check_msg_begin(ck);
                msg_str(ck, "duplicate enum value ");
                msg_value(ck, v);
                msg_str(ck, " for ");
                msg_quote(ck, m->name);
                check_msg_end(ck, m->name_loc);
                ok = false;
                break;
            }
            k += 1;
        }
        set_value(ck, m, v);
        if (!consts.cv_add(v, consts.cv_from_i64(1), &next)) {
            next = consts.cv_from_i64(0);
        }
    }
    if (!ok) {
        sym_fail(ck, s);
    }
}

// The types an extern signature may use: no spans, strings, structs or arrays.
// A function-pointer parameter is legal when its full signature is extern-legal.
// This includes its result because C calls it with the same convention.
// Recursion terminates because a function type uses earlier written types and
// cannot reach itself.
fn extern_legal(types.node* t) bool {
    switch (t->kind) {
    case types.type_kind.k_prim, types.type_kind.k_enum, types.type_kind.k_ptr,
         types.type_kind.k_voidptr, types.type_kind.k_void, types.type_kind.k_error:
        return true;
    case types.type_kind.k_fn:
        if (!extern_legal(t->elem)) {
            return false;
        }
        u64 mut i = 0;
        while (i < t->params.len) {
            if (!extern_legal(t->params[i])) {
                return false;
            }
            i += 1;
        }
        return true;
    default:
        return false;
    }
}

// The `i`-th parameter declaration of a function, for the position a
// signature difference is reported at.
fn param_at(ast.node* decl, u64 k) ast.node* {
    u64 mut n = 0;
    u64 mut i = 0;
    while (i < ast.ast_len(decl)) {
        ast.node* p = ast.ast_child(decl, i);
        i += 1;
        if (p->kind != ast.ast_kind.k_param) {
            continue;
        }
        if (n == k) {
            return p;
        }
        n += 1;
    }
    return decl;
}

// ---- two extern declarations of one C symbol ---------------------------------------

// Whether a primitive is the C `unsigned char` type. fort `char` uses that type
// at the boundary. Thus, `char` and `u8` name one C type. `char*` can also be
// written `u8*`.
fn is_c_byte(prim.prim_kind k) bool {
    return k == prim.prim_kind.prim_u8 || k == prim.prim_kind.prim_char;
}

// Whether two extern signature types name one C type.
// The types must match, except that `char` and `u8` name the same C byte type.
// Type-level marks must match. Binding-level `mut` does not enter a function type.
fn extern_type_agrees(types.node* a, types.node* b) bool {
    if (a == null || b == null) {
        return a == b;
    }
    if (a == b) {
        return true;
    }
    if (a->kind != b->kind) {
        return false;
    }
    switch (a->kind) {
    case types.type_kind.k_void:
        return true;
    case types.type_kind.k_prim:
        return a->prim == b->prim || (is_c_byte(a->prim) && is_c_byte(b->prim));
    case types.type_kind.k_ptr:
        return a->is_mut == b->is_mut && a->is_own == b->is_own
            && extern_type_agrees(a->elem, b->elem);
    case types.type_kind.k_voidptr:
        // `void mut*` and `void*` are two signatures, as `node mut*` and
        // `node*` are.
        return a->is_own == b->is_own && a->is_mut == b->is_mut;
    case types.type_kind.k_fn:
        if (a->is_noreturn != b->is_noreturn || a->params.len != b->params.len
            || !extern_type_agrees(a->elem, b->elem)) {
            return false;
        }
        u64 mut i = 0;
        while (i < a->params.len) {
            if (!extern_type_agrees(a->params[i], b->params[i])) {
                return false;
            }
            i += 1;
        }
        return true;
    default:
        // This includes a struct or enum reached through a pointer. It also
        // includes each kind that extern signatures cannot use. Interning did
        // not equate the nodes, so they are different types.
        return false;
    }
}

// Whether a struct or an enum, whose identity is the declaration it comes from
// and not its spelling.
fn is_nominal(types.node* t) bool {
    return t->kind == types.type_kind.k_struct || t->kind == types.type_kind.k_enum;
}

// Whether either side of the first difference between two disagreeing extern
// types names a struct or enum. Its identity is its declaration, not its
// spelling. Equal words in both modules cannot make two declarations agree.
// The note must therefore offer an imported type or a wrapper. Either side can
// name the nominal type. One module can use `i32` while another uses an enum.
// The enum remains importable. Two spellings of one type never reach here, since `color` and
// `shade.color` denote one declaration and the comparison above already agreed.
//
// It runs only after extern_type_agrees returns false. Thus, it walks a pair
// already known to differ and does not decide agreement. It stops at `void*`
// because that type erases its pointee. It also accepts unequal function arity
// and walks the shorter list. It identifies the difference kind, not whether a
// difference exists.
fn differs_by_nominal(types.node* a, types.node* b) bool {
    if (a == null || b == null || a == b) {
        return false;
    }
    if (is_nominal(a) || is_nominal(b)) {
        return true;
    }
    if (a->kind != b->kind) {
        return false;
    }
    if (a->kind == types.type_kind.k_ptr) {
        return differs_by_nominal(a->elem, b->elem);
    }
    if (a->kind == types.type_kind.k_fn) {
        if (differs_by_nominal(a->elem, b->elem)) {
            return true;
        }
        u64 mut i = 0;
        while (i < a->params.len && i < b->params.len) {
            if (differs_by_nominal(a->params[i], b->params[i])) {
                return true;
            }
            i += 1;
        }
    }
    return false;
}

// Reports `conflicting declarations of extern 'write': parameter 1 differs`.
// The error points to the differing part of the later declaration. A note
// points to the earlier declaration. `param` is the 1-based parameter, or 0
// when the difference names no parameter. `wrapper` requests guidance when no
// shared spelling exists.
//
// The later declaration must carry the error. `at` is in the module being
// checked. `first` is in an earlier module that the reader might not own. A
// client can drop diagnostics for files that it cannot open. A nested note
// stays with its error. Reversing them could hide all diagnostics from a reader
// who redeclares a libc symbol.
fn error_extern_conflict(checker mut* ck, diag.loc at, diag.loc first, string name,
                              string what, u64 param, bool wrapper) void {
    check_msg_begin(ck);
    msg_str(ck, "conflicting declarations of extern ");
    msg_quote(ck, name);
    msg_str(ck, what);
    if (param > 0) {
        msg_uint(ck, param);
        msg_str(ck, " differs");
    }
    check_msg_end(ck, at);
    // the notes follow the error rather than standing alone
    if (ck->mute) {
        return;
    }
    check_msg_begin(ck);
    msg_str(ck, "previous declaration of ");
    msg_quote(ck, name);
    msg_str(ck, " here");
    check_note_end(ck, first);
    if (!wrapper) {
        return;
    }
    check_msg_begin(ck);
    // Rewording cannot make a nominal type agree with a different type. The
    // module must import the shared type. Alternatively, one module declares
    // the symbol and exports a fort wrapper that other modules call.
    msg_str(ck, "a struct or an enum stands here, and its identity is its declaration and not ");
    msg_str(ck, "its spelling: give both declarations that one type, importing it where it is ");
    msg_str(ck, "missing, or declare the symbol in one module and call it through a fort ");
    msg_str(ck, "function the others import");
    check_note_end(ck, at);
}

// Several modules can declare one C symbol when their signatures match,
// including `own`. The checker uses loader dependency order. It compares each
// later declaration with the first and reports differences at the later one.
// It compares types, not written text. Thus, two spellings of one imported type
// agree. Two local types with one spelling do not agree.
fn check_extern_agreement(checker mut* ck, ast.node* decl, ast.sym mut* s) bool {
    i64 mut at = 0;
    if (!strmap.get(&ck->extern_first, s->name, &at)) {
        strmap.put(&ck->extern_first, s->name, cast(ck->externs_len, i64));
        externs_reserve(ck);
        ck->externs[ck->externs_len] = s;
        ck->externs_len += 1;
        return true;
    }
    u64 slot = cast(at, u64);
    ast.sym* first = ck->externs[slot];
    if (cast(first->node, ast.node*) == decl) {
        // The same declaration can pass twice through one checker. Its symbol
        // and nominal types are new records for the input tree. Replace the entry
        // instead of comparing it with itself. This path requires the second
        // pass to check successfully. A failed pass leaves the first symbol in
        // the map. Its nominal types belong to a replaced resolution. A later
        // module could compare against types that no module can name. Each prior
        // failure path reports first, so that run already has a diagnostic. The
        // stale comparison could only add noise to a failing file.
        ck->externs[slot] = s;
        return true;
    }
    types.node* a = first->ty;
    types.node* b = s->ty;
    if (a == null || b == null || a->kind != types.type_kind.k_fn
        || b->kind != types.type_kind.k_fn) {
        return true;
    }
    diag.loc note = first->node->name_loc;
    if (a->is_noreturn != b->is_noreturn || !extern_type_agrees(a->elem, b->elem)) {
        error_extern_conflict(ck, decl->a->loc, note, s->name, ": the result type differs", 0,
                              differs_by_nominal(a->elem, b->elem));
        return false;
    }
    if (a->params.len != b->params.len) {
        error_extern_conflict(ck, decl->name_loc, note, s->name,
                              ": the number of parameters differs", 0, false);
        return false;
    }
    if ((first->node->flags & ast.FLAG_VARIADIC) != (decl->flags & ast.FLAG_VARIADIC)) {
        diag.loc mut diff_loc = decl->name_loc;
        if ((decl->flags & ast.FLAG_VARIADIC) != 0) {
            diff_loc = decl->tail_loc;
        }
        error_extern_conflict(ck, diff_loc, note, s->name, ": the variable-tail mark differs", 0,
                              false);
        return false;
    }
    u64 mut i = 0;
    while (i < a->params.len) {
        if (!extern_type_agrees(a->params[i], b->params[i])) {
            error_extern_conflict(ck, param_at(decl, i)->loc, note, s->name, ": parameter ",
                                  i + 1, differs_by_nominal(a->params[i], b->params[i]));
            return false;
        }
        i += 1;
    }
    return true;
}

fn resolve_fn(checker mut* ck, ast.sym mut* s) void {
    ast.node mut* decl = s->node;
    bool is_extern = s->kind == ast.sym_kind.s_extern_fn;
    if (is_extern && is_reserved_c_name(s->name)) {
        // the compiler emits this definition
        check_msg_begin(ck);
        msg_quote(ck, s->name);
        msg_str(ck, " is reserved: the compiler emits it");
        check_msg_end(ck, decl->name_loc);
        sym_fail(ck, s);
        return;
    }
    written_type ret = check_type(ck, decl->a, type_pos.pos_return);
    bool mut ok = !check_poisoned(ret.ty) && check_layout(ck, ret.ty)
        && check_size_fits(ck, decl->a->loc, ret.ty);
    types.node*[MAX_MEMBERS] mut params = {};
    u64 mut n = 0;
    u64 mut i = 0;
    while (i < ast.ast_len(decl)) {
        ast.node mut* p = ast_child_mut(decl, i);
        i += 1;
        if (p->kind != ast.ast_kind.k_param) {
            continue;
        }
        if (n >= MAX_MEMBERS) {
            check_error(ck, p->loc, "too many parameters");
            ok = false;
            break;
        }
        written_type pt = check_type(ck, p->a, type_pos.pos_binding);
        ast.sym mut* ps = check_sym_new(ck, ast.sym_kind.s_param, p->name, p, s);
        ps->ty = pt.ty;
        ps->mut0 = pt.mut0;
        p->sym = ps;
        p->ty = pt.ty;
        if (check_poisoned(pt.ty) || !check_layout(ck, pt.ty)
            || !check_size_fits(ck, p->loc, pt.ty)) {
            sym_fail(ck, ps);
            ok = false;
            continue;
        }
        if (void_parameter_refused(ck, p->loc, pt.ty)) {
            sym_fail(ck, ps);
            ok = false;
            continue;
        }
        if (is_extern && !extern_legal(pt.ty)) {
            check_msg_begin(ck);
            msg_str(ck, "extern signature cannot use type '");
            check_msg_type(ck, pt.ty);
            msg_str(ck, "'");
            check_msg_end(ck, p->loc);
            sym_fail(ck, ps);
            ok = false;
            continue;
        }
        params[n] = pt.ty;
        n += 1;
    }
    if (ok && is_extern && !extern_legal(ret.ty)) {
        check_msg_begin(ck);
        msg_str(ck, "extern signature cannot use type '");
        check_msg_type(ck, ret.ty);
        msg_str(ck, "'");
        check_msg_end(ck, decl->a->loc);
        ok = false;
    }
    if (!ok) {
        sym_fail(ck, s);
        return;
    }
    s->ty = types.type_fn(&ck->types, ret.ty, params[0..n], is_noreturn(decl->a));
    if (is_extern && !check_extern_agreement(ck, decl, s)) {
        // no one signature, so the symbol is poisoned
        sym_fail(ck, s);
    }
}

fn resolve_var(checker mut* ck, ast.sym mut* s) void {
    ast.node mut* decl = s->node;
    written_type t = check_type(ck, decl->a, type_pos.pos_binding);
    s->ty = t.ty;
    s->mut0 = t.mut0;
    if (t.mut0) {
        s->kind = ast.sym_kind.s_global;
    } else {
        s->kind = ast.sym_kind.s_const;
    }
    if (check_poisoned(t.ty) || !check_layout(ck, t.ty)
        || !check_size_fits(ck, decl->loc, t.ty)) {
        sym_fail(ck, s);
        return;
    }
    if (t.ty->kind == types.type_kind.k_void) {
        check_error(ck, decl->loc, "'void' is only a return type or the base of 'void*'");
        sym_fail(ck, s);
        return;
    }
    if (decl->b == null) {
        // the parser enforces it
        sym_fail(ck, s);
        return;
    }
    expr mut e = expr{};
    check_initializer(ck, decl->b, t.ty, "the initializer", &e);
    if (check_poisoned(e.ty)) {
        sym_fail(ck, s);
        return;
    }
    if (!e.init_const) {
        // no calls and no reads of `mut` globals
        check_error(ck, decl->b->loc, "a module-level initializer must be a constant expression");
        sym_fail(ck, s);
    }
}

// ---- modules -----------------------------------------------------------------------

// The symbol kind a top-level declaration introduces; a module-level variable
// is a constant or a global once its type is resolved.
fn decl_sym_kind(ast.node* decl, ast.sym_kind mut* out) bool {
    switch (decl->kind) {
    case ast.ast_kind.k_fn_decl:
        if ((decl->flags & ast.FLAG_EXTERN) != 0) {
            *out = ast.sym_kind.s_extern_fn;
        } else {
            *out = ast.sym_kind.s_fn;
        }
        return true;
    case ast.ast_kind.k_struct_decl:
        *out = ast.sym_kind.s_struct;
        return true;
    case ast.ast_kind.k_enum_decl:
        *out = ast.sym_kind.s_enum;
        return true;
    case ast.ast_kind.k_var_decl:
        *out = ast.sym_kind.s_const;
        return true;
    default:
        return false;
    }
}

// Each import node whose name denotes the imported item carries its symbol.
// This includes the item, its `as` alias, and the last path segment. Earlier
// segments name search directories rather than
// modules, so they carry nothing.
fn annotate_path(ast.node* imp, ast.sym mut* last, ast.sym mut* module) void {
    ast.node mut* path = imp->a;
    if (path == null || ast.ast_len(path) == 0) {
        return;
    }
    u64 n = ast.ast_len(path);
    ast_child_mut(path, n - 1)->sym = last;
    if (n >= 2 && module != null && module != last) {
        ast_child_mut(path, n - 2)->sym = module;
    }
}

// The module a symbol was declared in, which is its owner (ast.sym).
fn owning_module(ast.sym* s) ast.sym mut* {
    if (s != null && s->owner != null && s->owner->kind == ast.sym_kind.s_module) {
        return s->owner;
    }
    return null;
}

fn annotate_import(scope.binding* b) void {
    ast.node mut* n = b->node;
    ast.sym mut* s = sym_of_binding(b);
    if (n == null) {
        return;
    }
    n->sym = s;
    if (n->kind == ast.ast_kind.k_import_item) {
        if (n->a != null) {
            n->a->sym = s;
        }
        return;
    }
    if (n->b != null) {
        n->b->sym = s;
    }
    if (b->kind == scope.bind_kind.b_symbol) {
        annotate_path(n, s, owning_module(s));
    } else {
        annotate_path(n, s, s);
    }
}

// The path of an item list names the module every item comes from, which is
// the owner of the first item that resolved.
fn annotate_item_path(ast.node* imp) void {
    u64 mut i = 0;
    while (i < ast.ast_len(imp)) {
        ast.node* item = ast.ast_child(imp, i);
        ast.sym mut* module = owning_module(item->sym);
        if (module != null) {
            annotate_path(imp, module, module);
            return;
        }
        i += 1;
    }
}

// Clears checker annotations before a second check of the same tree.
fn clear_annotations(ast.node mut* n) void {
    if (n == null) {
        return;
    }
    n->ty = null;
    n->sym = null;
    n->aux = 0;
    // ANN_ALL keeps this reset complete when a new annotation bit is added.
    n->ann &= ~ANN_ALL;
    clear_annotations(n->a);
    clear_annotations(n->b);
    clear_annotations(n->c);
    clear_annotations(n->d);
    u64 mut i = 0;
    while (i < ast.ast_len(n)) {
        clear_annotations(ast_child_mut(n, i));
        i += 1;
    }
}

// The name an import binds: the `as` alias, the item's own name, or the last
// segment of the path.
fn bound_name(ast.node* imp, ast.node* item) string {
    if (item != null) {
        if (item->a != null) {
            return item->a->name;
        }
        return item->name;
    }
    if (imp->b != null) {
        return imp->b->name;
    }
    ast.node* path = imp->a;
    if (path != null && ast.ast_len(path) > 0) {
        return ast.ast_child(path, ast.ast_len(path) - 1)->name;
    }
    return "";
}

// The names the module's imports did not bind, which is what an import the
// loader reported leaves behind: a use of one says nothing further.
fn collect_failed_import_list(checker mut* ck, modules.module* m, ast.node* list) void {
    u64 mut i = 0;
    while (list != null && i < ast.ast_len(list)) {
        ast.node* imp = ast.ast_child(list, i);
        i += 1;
        if (imp->kind == ast.ast_kind.k_compile_if
            && (imp->flags & ast.FLAG_IMPORT_SELECTOR) != 0) {
            ast.node* mut current = imp;
            while (current != null && current->kind == ast.ast_kind.k_compile_if) {
                if ((current->flags & ast.FLAG_SELECT_THEN) != 0) {
                    collect_failed_import_list(ck, m, current->b);
                    break;
                }
                if (current->c == null) {
                    break;
                }
                if (current->c->kind != ast.ast_kind.k_compile_if) {
                    collect_failed_import_list(ck, m, current->c);
                    break;
                }
                current = current->c;
            }
            continue;
        }
        if (imp->kind != ast.ast_kind.k_import) {
            continue;
        }
        u64 items = ast.ast_len(imp);
        u64 mut k = 0;
        while (k == 0 || k < items) {
            ast.node* mut item = null;
            if (items > 0) {
                item = ast.ast_child(imp, k);
            }
            string name = bound_name(imp, item);
            if (name.len > 0 && scope.find(&m->names, name) == null) {
                strmap.put(&ck->bad_imports, name, 1);
            }
            k += 1;
        }
    }
}

fn collect_failed_imports(checker mut* ck, modules.module* m) void {
    collect_failed_import_list(ck, m, m->ast);
}

fn annotate_import_paths(ast.node* list) void {
    u64 mut i = 0;
    while (list != null && i < ast.ast_len(list)) {
        ast.node* imp = ast.ast_child(list, i);
        i += 1;
        if (imp->kind == ast.ast_kind.k_compile_if
            && (imp->flags & ast.FLAG_IMPORT_SELECTOR) != 0) {
            ast.node* mut current = imp;
            while (current != null && current->kind == ast.ast_kind.k_compile_if) {
                if ((current->flags & ast.FLAG_SELECT_THEN) != 0) {
                    annotate_import_paths(current->b);
                    break;
                }
                if (current->c == null) {
                    break;
                }
                if (current->c->kind != ast.ast_kind.k_compile_if) {
                    annotate_import_paths(current->c);
                    break;
                }
                current = current->c;
            }
        } else if (imp->kind == ast.ast_kind.k_import && ast.ast_len(imp) > 0) {
            annotate_item_path(imp);
        }
    }
}

// Phase one: one symbol per top-level declaration, so that the declarations of
// a module are order-independent.
fn collect_module(checker mut* ck, modules.module* m) void {
    ast.sym mut* ms = check_sym_new(ck, ast.sym_kind.s_module, m->path, m->ast, null);
    // A module's own record hangs on its k_module node, which is how a
    // binding reaches it (ast.sym).
    m->ast->sym = ms;
    ck->module_sym = ms;
    collect_declarations(ck, m->ast, ms);
    u64 mut k = 0;
    while (k < scope.count(&m->names)) {
        scope.binding* b = scope.at(&m->names, k);
        if (b->kind == scope.bind_kind.b_module || b->kind == scope.bind_kind.b_symbol) {
            annotate_import(b);
        }
        k += 1;
    }
    annotate_import_paths(m->ast);
}

fn collect_declaration(checker mut* ck, ast.node mut* decl, ast.sym mut* owner) void {
    ast.node mut* mut current = decl;
    while (current->kind == ast.ast_kind.k_compile_if) {
        if ((current->flags & ast.FLAG_IMPORT_SELECTOR) != 0) {
            return;
        }
        if ((current->flags & ast.FLAG_SELECT_THEN) != 0) {
            collect_declarations(ck, current->b, owner);
            return;
        }
        if (current->c == null) {
            return;
        }
        if (current->c->kind != ast.ast_kind.k_compile_if) {
            collect_declarations(ck, current->c, owner);
            return;
        }
        current = current->c;
    }
    ast.sym_kind mut kind = ast.sym_kind.s_const;
    if (!decl_sym_kind(current, &kind)) {
        return;
    }
    ast.sym mut* s = check_sym_new(ck, kind, current->name, current, owner);
    current->sym = s;
    if (kind == ast.sym_kind.s_struct) {
        // the type exists before the fields are read
        s->ty = types.type_struct(&ck->types, current->name, cast(s, void mut*));
    } else if (kind == ast.sym_kind.s_enum) {
        s->ty = types.type_enum(&ck->types, current->name, cast(s, void mut*));
    }
}

fn collect_declarations(checker mut* ck, ast.node mut* list, ast.sym mut* owner) void {
    u64 mut i = 0;
    while (list != null && i < ast.ast_len(list)) {
        collect_declaration(ck, ast_child_mut(list, i), owner);
        i += 1;
    }
}

fn resolve_declaration(checker mut* ck, ast.node* decl) void {
    ast.node* mut current = decl;
    while (current->kind == ast.ast_kind.k_compile_if) {
        if ((current->flags & ast.FLAG_IMPORT_SELECTOR) != 0) {
            return;
        }
        if ((current->flags & ast.FLAG_SELECT_THEN) != 0) {
            resolve_declarations(ck, current->b);
            return;
        }
        if (current->c == null) {
            return;
        }
        if (current->c->kind != ast.ast_kind.k_compile_if) {
            resolve_declarations(ck, current->c);
            return;
        }
        current = current->c;
    }
    ast.sym_kind mut kind = ast.sym_kind.s_const;
    if (decl_sym_kind(current, &kind)) {
        resolve_sym(ck, current->sym);
    }
}

fn resolve_declarations(checker mut* ck, ast.node* list) void {
    u64 mut i = 0;
    while (list != null && i < ast.ast_len(list)) {
        resolve_declaration(ck, ast.ast_child(list, i));
        i += 1;
    }
}

// The entry module defines `fn main() i32` or `fn main(string@ args) i32`.
fn check_main(checker mut* ck, modules.module* m) void {
    scope.binding* b = scope.find(&m->names, "main");
    ast.sym mut* s = sym_of_binding(b);
    bool mut ok = s != null && s->kind == ast.sym_kind.s_fn && !check_poisoned(s->ty)
        && s->ty->kind == types.type_kind.k_fn && !s->ty->is_noreturn
        && types.type_equal(s->ty->elem, types.type_prim(&ck->types, prim.prim_kind.prim_i32));
    if (ok && s->ty->params.len > 1) {
        ok = false;
    }
    if (ok && s->ty->params.len == 1) {
        types.node* args = types.type_span(&ck->types, types.type_string(&ck->types, false),
                                           false, false);
        ok = types.type_equal(s->ty->params[0], args);
    }
    if (ok || (s != null && s->error)) {
        return;
    }
    check_msg_begin(ck);
    msg_str(ck, "entry module ");
    msg_quote(ck, m->path);
    msg_str(ck, " must define 'fn main() i32' or 'fn main(string@ args) i32'");
    if (s != null) {
        check_msg_end(ck, s->decl);
    } else {
        check_msg_end(ck, file_start(m->file));
    }
}

// Runs the first two phases for one module. It creates top-level symbols and
// then resolves them on demand. A referenced type or constant is complete when
// read. Bodies follow after each declaration has a type.
// check_stmt.check_module_bodies handles them. check_stmt.check_module runs the
// complete module pass; this function runs its first half.
fn check_module_decls(checker mut* ck, modules.module* m) void {
    ck->module = m;
    ck->scope = null;
    ck->in_function = false;
    clear_annotations(m->ast);
    strmap.free(&ck->bad_imports);
    collect_failed_imports(ck, m);
    collect_module(ck, m);
    resolve_declarations(ck, m->ast);
}

// The rule the whole module has to be checked for, and the end of the pass
// over it.
fn check_module_finish(checker mut* ck, modules.module* m) void {
    if (m->entry && ck->require_main) {
        // a module checked on its own is not a program
        check_main(ck, m);
    }
    ck->module = null;
    ck->module_sym = null;
}
