/// Proves heap cleanup with finite inductive shapes over verified FIR (D17.16, D17.18).
// A state maps slots to values. A slot is a reference leaf of a local, of caller storage that a
// borrowed pointer parameter designates, or of a heap cell. An atom is one allocation
// representative. A cell is one struct allocation. A region is the inductive predicate of a
// template type: an empty root, or a node whose recursive fields hold disjoint regions and whose
// payload fields hold flat allocations (spec/memory-model.md 2.7). A flat atom has no owned
// leaves. An opaque atom has owned leaves that the module does not model. The module adds no
// runtime data, no annotation, and no recursive del.
import ast;
import consts;
import diag;
import fir;
import fir_flow;
import ownership_api;
import ownership_flow;
import ownership_graph;
import ownership_keys;
import ownership_limits;
import prim;
import std.strbuf;
import types;

u32 NONE = 4294967295;
// A view of storage that some parameter designates, after a join of two parameters.
u32 ANY_PARAM = 4294967294;
u64 U64_MAX = 18446744073709551615;
// A slot path holds at most this many field projections below its base (u32[6]).
u64 PATH_DEPTH = 6;
// A view keeps at most this many possible source atoms (u32[8]).
u64 VIEW_SOURCES = 8;
// An origin set has one bit for each interface atom.
u64 INTERFACE_LIMIT = 64;
// A template reads at most this many fields (field_role[32]).
u64 FIELD_LIMIT = 32;
// A block joins this many incoming states before each later join widens.
u32 WIDEN_AFTER = 4;
// A recursive component runs at most this many rounds before it publishes. W bounds them too.
u64 ROUND_LIMIT = 16;
// A heap witness names at most this many crossed calls (crossed_call[8]).
u32 CROSS_LIMIT = 8;

/// The nullness of a root pointer (spec/memory-model.md 2.7). `free` is an input choice of the
/// caller, so each value is feasible. `joined` is an abstraction that lost the path of each value.
enum root_kind {
    null_root,
    nonnull,
    free,
    joined,
}

enum atom_kind {
    cell,
    region,
    flat,
    opaque,
}

/// What the proof knows about the allocations of an atom. `released` holds when the root is
/// nonnull, because a null root has no allocation. `leaked` names an obligation that an event
/// reported lost: its storage stays allocated, so its views stay valid. `escaped` names an
/// obligation that left the proof after an incomplete-proof event: an unknown effect took it,
/// or its owner ended while its status was unknown. The proof does not know if its storage
/// stays allocated. `unknown` names an obligation that an unknown effect can change.
enum atom_status {
    live,
    released,
    maybe_released,
    leaked,
    escaped,
    unknown,
}

enum base_kind {
    local,
    caller,
    cell,
}

enum value_kind {
    empty,
    scalar,
    owned,
    view,
    address,
    unknown,
}

enum field_role {
    scalar,
    recursive,
    payload,
    borrowed,
    nested,
    other,
}

enum location_kind {
    slots,
    length,
    element,
    unknown,
}

struct atom {
    atom_kind kind;
    atom_status status;
    // A cell or region: the struct type. A flat or opaque atom: its element type.
    types.node* ty;
    // The index of the template + 1, or 0.
    u32 shape;
    root_kind root;
    // The interface atoms whose members this atom holds, one bit each.
    u64 origin;
    // The atom holds an allocation of this computation.
    bool fresh;
    // Each member belongs to an interface atom, and the root of none is a member.
    bool strict;
    // The members are a free input choice of the caller.
    bool choice;
    // A view or an address of the atom reached an unknown effect, so a later unknown effect can
    // change it too.
    bool exposed;
    // The atom is the entry value of interface atom `handle`, or of its owned field
    // `handle_field` when that field is not NONE (`spec/fir.md` 14 Calls). NONE otherwise.
    u32 handle;
    u32 handle_field;
    // A region whose root node, when nonnull, has each owned field empty: a fold of a node with
    // no owned child keeps that fact, and an unfold gives empty children.
    bool empty_leaves;
    // A member can keep, in a borrowed field that has no slot, a reference that this body made.
    // A new atom has the fact; only an operation that proves the stored references clears it:
    // an allocation (its storage is zero), a fold or a cover that reads each slot that it drops,
    // an unfold that gives each child the fact of its parent, and the graft of a summary.
    bool borrows;
    // A member can keep, in a borrowed field that has no slot, a reference to storage that a
    // parameter designates. That storage outlives this body, but in a caller it is storage that
    // an argument reaches. A new atom has this fact too.
    bool params;
    // An absorbed atom names the atom that holds it now, so a value copied before a fold can
    // find its current source. NONE otherwise.
    u32 into;
    bool used;
    // The witness assumed at a dereference that the root is not null (`null_check`).
    bool assumed_nonnull;
    // The root is nonnull only because an unfold assumed it: a dereference or a release of a
    // root whose nullness the state did not know. Such a root removes no path (D17.18).
    bool unfold_nonnull;
}

struct slot_key {
    base_kind base;
    u32 id;
    u32 depth;
    u32[6] path;
}

// A view keeps the possible source atoms of a borrowed reference. `exact` says that it
// designates the root of its one source. `external` adds storage that stays live in this
// computation: static data or storage that the caller supplies. An unknown value with
// `external` needs no check at a return: an input of the caller, or a borrowed field of a
// region whose fold proved each such field external. Its `target`, when its base is
// `caller`, names the caller slot whose entry value it is. An unknown value with `exact` is
// the work of an unknown effect. Any other unknown reference lost its facts in this body.
struct value {
    value_kind kind;
    u32 atom;
    u32 count;
    u32[8] sources;
    bool exact;
    bool external;
    root_kind nullness;
    slot_key target;
    // A scalar that tests the root of `test`, or NONE. True means a nonnull root when
    // `test_nonnull` is true. A known scalar has the truth value `truth`.
    u32 test;
    bool test_nonnull;
    bool known;
    bool truth;
    // A scalar with the known integer value `number`.
    bool numbered;
    i64 number;
    // The parameter whose designated storage a view or an address reaches, NONE, or ANY_PARAM.
    u32 param;
}

struct slot {
    slot_key key;
    types.node* ty;
    bool owning;
    // A fixed array of references: the slot stands for each element together.
    bool array;
    value v;
}

// An assumption of a witness. A fort call that the witness crossed is one: the witness assumes
// that it returns. A kept check on a value that the state does not know is one: the witness
// assumes that it passes. A dereference of a pointer of unknown nullness is one: the witness
// assumes that the pointer is not null. The event that it validates names each one (D17.18,
// `spec/toolchain.md` 4.2).
struct crossed_call {
    ownership_api.source_position source;
    string callee;
    // A kept check of kind `kind`, in place of a call.
    bool check;
    fir.check_kind kind;
    // A dereference of a pointer whose nullness the state does not know, in place of a call.
    // `named` says that the pointer is in slot `pointer`, whose name the note gives.
    bool nonnull;
    bool named;
    slot_key pointer;
    // The dereference writes storage; otherwise it reads it.
    bool write;
}

// The kind of an assumption: the row of its note in `note_row` (`spec/toolchain.md` 4.2).
enum assumption_kind {
    call_returns,
    check_passes,
    nonnull,
}

fn assumption_of(crossed_call item) assumption_kind {
    if (item.check) { return assumption_kind.check_passes; }
    return item.nonnull ? assumption_kind.nonnull : assumption_kind.call_returns;
}

// One row of the note table: the fact that the path needs, and the head of the outcome when
// the fact does not hold. A new kind of assumption adds one row.
struct note_phrase {
    string fact;
    string outcome;
}

fn note_row(assumption_kind k) note_phrase {
    switch (k) {
    case assumption_kind.call_returns:
        return note_phrase{.fact = "to return", .outcome = "if it does not return, "};
    case assumption_kind.check_passes:
        return note_phrase{.fact = "to pass", .outcome = "if it fails, the program stops"};
    case assumption_kind.nonnull:
        return note_phrase{.fact = "to be non-null", .outcome = "a null "};
    }
}

// An event text as a note names it: a place name in quotes, or a phrase as it is.
fn append_subject(strbuf.str_buf mut* out, string text) void {
    if (text.len == 0) {
        strbuf.append(out, "the storage that this operation uses");
        return;
    }
    bool mut phrase = false;
    u64 mut i = 0;
    while (i < text.len) {
        if (text[i] == ' ') { phrase = true; }
        i += 1;
    }
    if (!phrase) { strbuf.push(out, '\''); }
    strbuf.append(out, text);
    if (!phrase) { strbuf.push(out, '\''); }
}

// What does not happen when a crossed call does not return: the event itself.
fn append_event_outcome(strbuf.str_buf mut* out, ownership_api.event_kind kind, string text)
    void {
    switch (kind) {
    case ownership_api.event_kind.lost_ownership:
        append_subject(out, text);
        strbuf.append(out, " does not leak");
    case ownership_api.event_kind.invalid_use:
        strbuf.append(out, "this use of ");
        append_subject(out, text);
        strbuf.append(out, " does not happen");
    case ownership_api.event_kind.caller_requirement:
        strbuf.append(out, "this call does not fail its requirement");
    default:
        strbuf.append(out, "this error does not happen");
    }
}

// Each block keeps one joined state. A state that no path reaches is bottom.
struct state {
    bool reached;
    bool witness;
    slot mut@ own slots;
    u64 slots_len;
    atom mut@ own atoms;
    u64 atoms_len;
    // For each local: 0 live, 1 ended, 2 possibly ended.
    u8 mut@ own ended;
    // The interface atoms with a possibly released member.
    u64 released;
    bool lossy;
    ownership_api.lost_fact loss;
    // The empty owners that each path into this state requires of its caller (`spec/fir.md` 14
    // Calls): bit i of `required_null` for interface atom i, and bit f of `required_fields[i]`
    // for its owned field f. A join keeps a requirement only when both paths have it, so the
    // exit state names the requirements of each returning path.
    u64 required_null;
    u64[64] required_fields;
    // The assumptions that the paths into this state crossed, in source order, each once. A
    // kept check counts on a path without a witness too, because a rejoin can give the witness
    // back after it; `assumptions_full` says that one did not fit, so no witness comes back.
    crossed_call[8] crossed;
    u32 crossed_len;
    bool assumptions_full;
    // The caller storage entries whose pointer the witness assumed to be not null at a
    // dereference, one bit each (`null_check`).
    u64 nonnull_callers;
    // The interface atoms that this path dereferenced with a nullness that the state did not
    // know, one bit each. A join keeps the bits of both paths, so the exit state names the
    // inputs that each returning path dereferences (D10.7).
    u64 deref_handles;
}

struct shape {
    types.node* ty;
    bool supported;
    u32 fields;
    field_role[32] roles;
    u32 recursive;
    u32 payload;
}

/// One interface atom of a summary: an owned leaf of a by-value parameter (a local base) or of
/// caller storage (a caller base).
struct interface_entry {
    slot_key key;
    atom_kind kind;
    types.node* ty;
    u32 shape;
    bool needs_shape;
    // The caller supplies an empty owner here, or an empty owned field of its root (`spec/fir.md`
    // 14 Calls).
    bool require_null;
    u64 require_fields;
}

/// The caller storage that a borrowed pointer parameter designates.
struct caller_entry {
    u32 param;
    types.node* pointee;
}

/// The heap summary of one body. `post` keeps the exit state: the slots of caller storage and of
/// the result, and the atoms that they reach. Interface atom i keeps index i.
struct summary {
    ownership_api.proof_status proof;
    bool known;
    bool returns;
    bool witness;
    // An unknown effect changed caller-visible facts, so no caller can apply this summary.
    bool residual;
    // The body, or a callee of it, writes through a pointer that the proof does not follow, or
    // makes an unknown call. Such a write can reach storage of a caller that the summary does
    // not name.
    bool writes_untracked;
    // The interface atoms that some path of the body dereferences with a nullness that it does
    // not know, one bit each (D10.7).
    u64 deref_inputs;
    interface_entry mut@ own interface;
    caller_entry mut@ own callers;
    // The parameters whose designated storage the body reads, one bit each. `reads_high`
    // stands for each parameter from 64 on, which no bit can name.
    u64 view_reads;
    bool reads_high;
    // The events that the computation of this summary recorded.
    u32 events;
    state post;
}

/// A published summary that a call can apply. A member of the component under solution is
/// provisional until its component reaches a fixed point.
struct callee {
    ast.sym* symbol;
    summary* published;
    bool member;
}

struct location {
    location_kind kind;
    slot_key key;
    u32 count;
    u32[8] sources;
    bool external;
    // An unknown location that a pointer of another type than its target designates (a cast):
    // `key` names that target, whose storage a store changes in a way that the proof does not
    // follow.
    bool retyped;
    // The place reads a pointer to find its storage (`fir.place_indirect`). An unknown location
    // without it is storage of a global, or a field of tracked storage that has no slot.
    bool indirect;
}

// One leaf of an aggregate value, relative to the aggregate.
struct leaf {
    u32 depth;
    u32[6] path;
    types.node* ty;
    bool owning;
    bool array;
    value v;
}

struct leaf_list {
    leaf mut@ own items;
    u64 len;
}

struct reported {
    ownership_api.operation_position operation;
    ownership_api.event_kind kind;
    u32 relation;
}

/// The analysis of one body.
struct context {
    fir.func* f;
    ownership_api.function_id key;
    ownership_flow.source_file_binding@ files;
    ownership_api.services* svc;
    callee@ callees;
    shape mut@ own shapes;
    u64 shapes_len;
    // The slots of each local, then of each caller storage base, in a fixed order.
    slot mut@ own fixed;
    u64 fixed_len;
    u32 mut@ own local_first;
    u32 mut@ own local_count;
    u32 mut@ own caller_first;
    u32 mut@ own caller_count;
    caller_entry mut@ own callers;
    u64 callers_len;
    interface_entry mut@ own interface;
    u64 interface_len;
    u64 needs_shape;
    u64 view_reads;
    bool reads_high;
    // The top-level locals whose storage a FIR address names: a call can write them.
    bool mut@ own addressed;
    // The empty owners that the caller supplies (`spec/fir.md` 14 Calls), one entry for each
    // interface atom.
    bool mut@ own require_null;
    u64 mut@ own require_fields;
    state mut@ own entry;
    u32 mut@ own joins;
    bool mut@ own pending;
    // For each block with a branch, the block where each of its paths returns, or NONE.
    u32 mut@ own rejoin;
    // The witness of each block at its terminator, after the calls of the block.
    bool mut@ own left;
    state exit;
    // The last pass over the stable block states: returns build the exit state.
    bool final_pass;
    bool reporting;
    // An `addr` or a `slice` resolves its place: it computes an address and reads no storage
    // there, so its dereferences are no null checks.
    bool addressing;
    // The place that `resolve` resolves is the destination of a store.
    bool writing;
    bool residual;
    // See `summary.writes_untracked`. No pass clears it, as no pass clears `residual`.
    bool writes_untracked;
    // See `summary.deref_inputs`.
    u64 deref_inputs;
    bool stopped;
    bool failed_any;
    bool incomplete_any;
    ownership_api.proof_status first_failure;
    ownership_api.proof_status first_incomplete;
    reported mut@ own seen;
    u64 seen_len;
    u32 events;
    // Each noted proof failure, in each round.
    u64 notes;
    ownership_api.operation_position op;
    diag.loc at;
    // The exit that expanded the current deferred statement, or the empty range.
    diag.loc exit_at;
    strbuf.str_buf text;
    // The loss of a precision stop, for its event.
    bool stop_lossy;
    ownership_api.lost_fact stop_loss;
}

// ---- small helpers ---------------------------------------------------------------------------

fn complete() ownership_api.proof_status {
    ownership_api.proof_status mut out = ownership_api.proof_status{};
    out.kind = ownership_api.proof_kind.complete;
    return out;
}

fn grow(u64 cap, u64 need) u64 {
    if (need <= cap) { return cap; }
    u64 mut next = cap < 8 ? 8 : cap;
    while (next < need) {
        if (next > U64_MAX / 2) { return need; }
        next *= 2;
    }
    return next;
}

fn join_root(root_kind a, root_kind b) root_kind {
    if (a == b) { return a; }
    return root_kind.joined;
}

fn bit(u64 i) u64 { return i < 64 ? cast(1, u64) << i : 0; }

fn empty_value() value {
    value mut v = value{};
    v.kind = value_kind.empty;
    v.test = NONE;
    v.atom = NONE;
    v.param = NONE;
    return v;
}

fn scalar_value() value {
    value mut v = empty_value();
    v.kind = value_kind.scalar;
    return v;
}

fn unknown_value() value {
    value mut v = empty_value();
    v.kind = value_kind.unknown;
    return v;
}

// A reference that needs no check at a return and that the proof does not follow. Its target
// names no slot.
fn input_value() value {
    value mut v = unknown_value();
    v.external = true;
    v.target = key_of(base_kind.local, NONE);
    return v;
}

// The entry value of caller slot `k`: a caller of this body reads it from its own slot.
fn entry_value(slot_key k) value {
    value mut v = input_value();
    v.target = k;
    v.param = ANY_PARAM;
    return v;
}

// An unknown reference that an unknown effect wrote.
fn effect_value() value {
    value mut v = unknown_value();
    v.exact = true;
    return v;
}

fn own_value(u32 a) value {
    value mut v = empty_value();
    v.kind = value_kind.owned;
    v.atom = a;
    return v;
}

fn external_view() value {
    value mut v = empty_value();
    v.kind = value_kind.view;
    v.external = true;
    v.nullness = root_kind.joined;
    return v;
}

fn address_value(slot_key target) value {
    value mut v = empty_value();
    v.kind = value_kind.address;
    v.target = target;
    return v;
}

fn key_of(base_kind base, u32 id) slot_key {
    slot_key mut k = slot_key{};
    k.base = base;
    k.id = id;
    return k;
}

fn same_key(slot_key a, slot_key b) bool {
    if (a.base != b.base || a.id != b.id || a.depth != b.depth) { return false; }
    u32 mut i = 0;
    while (i < a.depth) {
        if (a.path[i] != b.path[i]) { return false; }
        i += 1;
    }
    return true;
}

// Whether `a` is `b` or a prefix of `b`.
fn prefix_of(slot_key a, slot_key b) bool {
    if (a.base != b.base || a.id != b.id || a.depth > b.depth) { return false; }
    u32 mut i = 0;
    while (i < a.depth) {
        if (a.path[i] != b.path[i]) { return false; }
        i += 1;
    }
    return true;
}

fn key_order(slot_key a, slot_key b) i32 {
    if (cast(a.base, u32) != cast(b.base, u32)) {
        return cast(a.base, u32) < cast(b.base, u32) ? -1 : 1;
    }
    if (a.id != b.id) { return a.id < b.id ? -1 : 1; }
    u32 mut i = 0;
    while (i < a.depth && i < b.depth) {
        if (a.path[i] != b.path[i]) { return a.path[i] < b.path[i] ? -1 : 1; }
        i += 1;
    }
    if (a.depth != b.depth) { return a.depth < b.depth ? -1 : 1; }
    return 0;
}

// Appends field `k` to a key. False when the path is full.
fn extend(slot_key mut* k, u32 field) bool {
    if (cast(k->depth, u64) >= PATH_DEPTH) { return false; }
    k->path[k->depth] = field;
    k->depth += 1;
    return true;
}

// Appends the path of `tail` below `head`. False when the path is full.
fn rebase(slot_key head, u32 depth, u32[6] path, slot_key mut* out) bool {
    *out = head;
    u32 mut i = 0;
    while (i < depth) {
        if (!extend(out, path[i])) { return false; }
        i += 1;
    }
    return true;
}

fn same_value(value a, value b) bool {
    if (a.kind != b.kind) { return false; }
    switch (a.kind) {
    case value_kind.empty:
        return true;
    case value_kind.unknown:
        return a.external == b.external && a.exact == b.exact &&
            (!a.external || (same_key(a.target, b.target) && a.param == b.param));
    case value_kind.scalar:
        return a.test == b.test && (a.test == NONE || a.test_nonnull == b.test_nonnull) &&
            a.known == b.known && (!a.known || a.truth == b.truth) &&
            a.numbered == b.numbered && (!a.numbered || a.number == b.number);
    case value_kind.owned:
        return a.atom == b.atom;
    case value_kind.view:
        if (a.count != b.count || a.exact != b.exact || a.external != b.external ||
            a.nullness != b.nullness || a.param != b.param) { return false; }
        u32 mut i = 0;
        while (i < a.count) {
            if (a.sources[i] != b.sources[i]) { return false; }
            i += 1;
        }
        return true;
    case value_kind.address:
        return same_key(a.target, b.target) && a.param == b.param;
    }
}

// Adds a source to a view. False when the view is full.
fn add_source(value mut* v, u32 a) bool {
    u32 mut i = 0;
    while (i < v->count) {
        if (v->sources[i] == a) { return true; }
        i += 1;
    }
    if (cast(v->count, u64) >= VIEW_SOURCES) { return false; }
    v->sources[v->count] = a;
    v->count += 1;
    return true;
}

fn remove_source(value mut* v, u32 a) void {
    u32 mut i = 0;
    u32 mut kept = 0;
    while (i < v->count) {
        if (v->sources[i] != a) {
            v->sources[kept] = v->sources[i];
            kept += 1;
        }
        i += 1;
    }
    v->count = kept;
}

fn sort_sources(value mut* v) void {
    u32 mut i = 1;
    while (i < v->count) {
        u32 item = v->sources[i];
        u32 mut j = i;
        while (j > 0 && v->sources[j - 1] > item) {
            v->sources[j] = v->sources[j - 1];
            j -= 1;
        }
        v->sources[j] = item;
        i += 1;
    }
}

// ---- states ----------------------------------------------------------------------------------

fn free_state(state mut* s) void {
    del(s->slots);
    del(s->atoms);
    del(s->ended);
    *s = state{};
}

fn bottom(u64 locals) state {
    state mut s = state{};
    s.ended = new(u8, locals);
    return s;
}

fn clone(state* s) state {
    state mut out = state{};
    out.reached = s->reached;
    out.witness = s->witness;
    out.released = s->released;
    out.lossy = s->lossy;
    out.loss = s->loss;
    out.required_null = s->required_null;
    out.required_fields = s->required_fields;
    out.crossed = s->crossed;
    out.crossed_len = s->crossed_len;
    out.nonnull_callers = s->nonnull_callers;
    out.deref_handles = s->deref_handles;
    out.assumptions_full = s->assumptions_full;
    out.slots = new(slot, s->slots_len);
    u64 mut i = 0;
    while (i < s->slots_len) { out.slots[i] = s->slots[i]; i += 1; }
    out.slots_len = s->slots_len;
    out.atoms = new(atom, s->atoms_len);
    i = 0;
    while (i < s->atoms_len) { out.atoms[i] = s->atoms[i]; i += 1; }
    out.atoms_len = s->atoms_len;
    out.ended = new(u8, s->ended.len);
    i = 0;
    while (i < s->ended.len) { out.ended[i] = s->ended[i]; i += 1; }
    return out;
}

// The rank of an assumption at one source: a call, then a dereference, then a check.
fn crossed_rank(crossed_call a) u32 {
    if (a.check) { return 2; }
    return a.nonnull ? 1 : 0;
}

// The order of two assumptions: by source, then by rank; two dereferences at one source by
// their pointer.
fn crossed_order(crossed_call a, crossed_call b) i32 {
    i32 mut c = ownership_keys.source(a.source, b.source);
    if (c == 0) { c = ownership_keys.number(crossed_rank(a), crossed_rank(b)); }
    if (c == 0 && a.nonnull) {
        c = ownership_keys.number(a.named ? 1 : 0, b.named ? 1 : 0);
        if (c == 0 && a.named) { c = key_order(a.pointer, b.pointer); }
    }
    return c;
}

// The name of a check kind in `spec/fir.md` 8.
fn check_name(fir.check_kind k) string {
    switch (k) {
    case fir.check_kind.chk_overflow: return "overflow";
    case fir.check_kind.chk_shift: return "shift";
    case fir.check_kind.chk_div_zero: return "div_zero";
    case fir.check_kind.chk_div_overflow: return "div_overflow";
    case fir.check_kind.chk_bounds: return "bounds";
    case fir.check_kind.chk_span: return "span";
    case fir.check_kind.chk_alloc_count: return "alloc_count";
    case fir.check_kind.chk_overwrite: return "overwrite";
    case fir.check_kind.chk_enum: return "enum";
    case fir.check_kind.chk_user: return "user";
    case fir.check_kind.chk_panic: return "panic";
    }
}

// Adds an assumption to state `s` in source order, once. False when the state names as many
// assumptions as it can.
fn add_crossed(state mut* s, crossed_call item) bool {
    u32 mut at = 0;
    while (at < s->crossed_len && crossed_order(s->crossed[at], item) < 0) { at += 1; }
    if (at < s->crossed_len && crossed_order(s->crossed[at], item) == 0) { return true; }
    if (s->crossed_len >= CROSS_LIMIT) { return false; }
    u32 mut k = s->crossed_len;
    while (k > at) {
        s->crossed[k] = s->crossed[k - 1];
        k -= 1;
    }
    s->crossed[at] = item;
    s->crossed_len += 1;
    return true;
}

fn replace(state mut* dst, state mut* src) void {
    free_state(dst);
    *dst = move(*src);
}

fn push_slot(state mut* s, slot item) u64 {
    if (s->slots_len == s->slots.len) {
        u64 cap = grow(s->slots.len, s->slots_len + 1);
        slot mut@ own bigger = new(slot, cap);
        u64 mut i = 0;
        while (i < s->slots_len) { bigger[i] = s->slots[i]; i += 1; }
        del(s->slots);
        s->slots = move(bigger);
    }
    s->slots[s->slots_len] = item;
    s->slots_len += 1;
    return s->slots_len - 1;
}

fn push_atom(state mut* s, atom item) u32 {
    if (s->atoms_len == s->atoms.len) {
        u64 cap = grow(s->atoms.len, s->atoms_len + 1);
        atom mut@ own bigger = new(atom, cap);
        u64 mut i = 0;
        while (i < s->atoms_len) { bigger[i] = s->atoms[i]; i += 1; }
        del(s->atoms);
        s->atoms = move(bigger);
    }
    atom mut stored = item;
    stored.used = true;
    s->atoms[s->atoms_len] = stored;
    s->atoms_len += 1;
    return cast(s->atoms_len - 1, u32);
}

fn find_slot(state* s, slot_key k) u64 {
    u64 mut i = 0;
    while (i < s->slots_len) {
        if (same_key(s->slots[i].key, k)) { return i; }
        i += 1;
    }
    return U64_MAX;
}

// Removes each slot of cell atom `a`.
fn drop_cell_slots(state mut* s, u32 a) void {
    u64 mut i = 0;
    u64 mut kept = 0;
    while (i < s->slots_len) {
        slot item = s->slots[i];
        if (!(item.key.base == base_kind.cell && item.key.id == a)) {
            s->slots[kept] = item;
            kept += 1;
        }
        i += 1;
    }
    s->slots_len = kept;
}

// Replaces source `from` by `to` in each view. `to` NONE removes it. Each changed view becomes a
// member view, because `to` holds more than the root of `from`.
fn redirect(state mut* s, u32 from, u32 to, bool keep_exact) void {
    u64 mut i = 0;
    while (i < s->slots_len) {
        value mut* v = &s->slots[i].v;
        if (v->kind == value_kind.view) {
            u32 mut j = 0;
            bool mut found = false;
            while (j < v->count) {
                if (v->sources[j] == from) { found = true; }
                j += 1;
            }
            if (found) {
                remove_source(v, from);
                if (to != NONE && !add_source(v, to)) {
                    *v = unknown_value();
                } else {
                    if (!keep_exact) { v->exact = false; }
                    sort_sources(v);
                    if (v->count == 0 && !v->external) { *v = unknown_value(); }
                }
            }
        }
        i += 1;
    }
}

// ---- types and templates ---------------------------------------------------------------------

fn is_reference(types.node* t) bool { return t != null && types.type_is_reference(t); }

// Whether a value of type `t` holds an owned reference, directly or through inline storage.
fn owned_leaf(types.node* t) bool {
    if (t == null) { return false; }
    if (types.type_is_reference(t)) { return t->is_own; }
    if (t->kind == types.type_kind.k_struct || t->kind == types.type_kind.k_array) {
        return types.type_is_owning_aggregate(t);
    }
    return false;
}

// Whether a value of type `t` holds a reference, directly or through inline storage.
fn has_reference(types.node* t) bool {
    if (t == null) { return false; }
    if (types.type_is_reference(t)) { return true; }
    if (t->kind == types.type_kind.k_array) { return has_reference(t->elem); }
    if (t->kind != types.type_kind.k_struct || t->decl == null) { return false; }
    u32 count = fir.struct_field_count(t);
    u32 mut k = 0;
    while (k < count) {
        if (has_reference(fir.struct_field_type(t, k))) { return true; }
        k += 1;
    }
    return false;
}

fn resolved_struct(types.node* t) bool {
    return t != null && t->kind == types.type_kind.k_struct && t->decl != null &&
        t->layout != null && t->layout->state == types.layout_state.l_resolved;
}

// Whether an owning reference of type `t` designates one allocation without owned leaves.
fn flat_reference(types.node* t) bool {
    if (!is_reference(t) || !t->is_own) { return false; }
    if (t->kind == types.type_kind.k_string) { return true; }
    if (t->kind == types.type_kind.k_voidptr || t->elem == null) { return false; }
    return !owned_leaf(t->elem) && t->elem->kind != types.type_kind.k_void;
}

// The template of struct `t`: its index + 1, or 0 when `t` has no owned field or an owned
// field that the template rules do not cover (spec/memory-model.md 2.7).
fn shape_of(context mut* c, types.node* t) u32 {
    if (!resolved_struct(t)) { return 0; }
    u64 mut i = 0;
    while (i < c->shapes_len) {
        if (c->shapes[i].ty == t) {
            return c->shapes[i].supported ? cast(i + 1, u32) : 0;
        }
        i += 1;
    }
    shape mut out = shape{};
    out.ty = t;
    out.supported = true;
    u32 count = fir.struct_field_count(t);
    if (cast(count, u64) > FIELD_LIMIT) { out.supported = false; }
    out.fields = count;
    u32 mut k = 0;
    while (out.supported && k < count) {
        types.node* ft = fir.struct_field_type(t, k);
        field_role mut role = field_role.scalar;
        if (ft == null) {
            role = field_role.other;
        } else if (is_reference(ft) && ft->is_own) {
            if (ft->kind == types.type_kind.k_ptr && ft->elem == t) {
                role = field_role.recursive;
            } else if (flat_reference(ft)) {
                role = field_role.payload;
            } else {
                role = field_role.other;
            }
        } else if (is_reference(ft)) {
            role = field_role.borrowed;
        } else if (ft->kind == types.type_kind.k_struct || ft->kind == types.type_kind.k_array) {
            role = owned_leaf(ft) ? field_role.other : field_role.nested;
        }
        if (role == field_role.other) { out.supported = false; }
        if (role == field_role.recursive) { out.recursive += 1; }
        if (role == field_role.payload) { out.payload += 1; }
        out.roles[k] = role;
        k += 1;
    }
    if (out.recursive + out.payload == 0) { out.supported = false; }
    if (c->shapes_len == c->shapes.len) {
        u64 cap = grow(c->shapes.len, c->shapes_len + 1);
        shape mut@ own bigger = new(shape, cap);
        u64 mut j = 0;
        while (j < c->shapes_len) { bigger[j] = c->shapes[j]; j += 1; }
        del(c->shapes);
        c->shapes = move(bigger);
    }
    c->shapes[c->shapes_len] = out;
    c->shapes_len += 1;
    return out.supported ? cast(c->shapes_len, u32) : 0;
}

fn role_of(context* c, u32 shape_index, u32 field) field_role {
    if (shape_index == 0 || cast(field, u64) >= FIELD_LIMIT) { return field_role.other; }
    return c->shapes[cast(shape_index - 1, u64)].roles[field];
}

// The atom kind of an owned leaf of type `t`, with its template in *template_index.
fn owned_kind(context mut* c, types.node* t, bool array, u32 mut* template_index) atom_kind {
    *template_index = 0;
    if (array || !is_reference(t)) { return atom_kind.opaque; }
    if (flat_reference(t)) { return atom_kind.flat; }
    if (t->kind == types.type_kind.k_ptr && resolved_struct(t->elem)) {
        u32 found = shape_of(c, t->elem);
        if (found != 0) {
            *template_index = found;
            return atom_kind.region;
        }
    }
    return atom_kind.opaque;
}

fn reset(leaf_list mut* list) void { list->len = 0; }

fn push_leaf(leaf_list mut* list, leaf item) void {
    if (list->len == list->items.len) {
        u64 cap = grow(list->items.len, list->len + 1);
        leaf mut@ own bigger = new(leaf, cap);
        u64 mut i = 0;
        while (i < list->len) { bigger[i] = list->items[i]; i += 1; }
        del(list->items);
        list->items = move(bigger);
    }
    list->items[list->len] = item;
    list->len += 1;
}

fn free_leaves(leaf_list mut* list) void {
    del(list->items);
    *list = leaf_list{};
}

// Appends the reference leaves of type `t` below path `base`. A scalar gets a leaf only at the
// top. A fixed array of references, or a struct below the path bound, gets one array leaf.
fn add_leaves(leaf_list mut* out, types.node* t, leaf base, bool top) void {
    if (t == null) { return; }
    if (is_reference(t)) {
        leaf mut item = base;
        item.ty = t;
        item.owning = t->is_own;
        item.array = false;
        item.v = empty_value();
        push_leaf(out, item);
        return;
    }
    if (t->kind == types.type_kind.k_struct && resolved_struct(t)) {
        if (cast(base.depth, u64) >= PATH_DEPTH) {
            leaf mut item = base;
            item.ty = t;
            item.owning = owned_leaf(t);
            item.array = true;
            item.v = item.owning ? empty_value() : unknown_value();
            push_leaf(out, item);
            return;
        }
        u32 count = fir.struct_field_count(t);
        u32 mut k = 0;
        while (k < count) {
            leaf mut next = base;
            next.path[next.depth] = k;
            next.depth += 1;
            add_leaves(out, fir.struct_field_type(t, k), next, false);
            k += 1;
        }
        return;
    }
    if (t->kind == types.type_kind.k_array) {
        types.node* e = types.behind_arrays(t);
        if (has_reference(e)) {
            leaf mut item = base;
            item.ty = t;
            item.owning = owned_leaf(t);
            item.array = true;
            item.v = item.owning ? empty_value() : unknown_value();
            push_leaf(out, item);
        }
        return;
    }
    if (top) {
        leaf mut item = base;
        item.ty = t;
        item.v = scalar_value();
        push_leaf(out, item);
    }
}

fn leaves_of(types.node* t, leaf_list mut* out) void {
    reset(out);
    add_leaves(out, t, leaf{}, true);
}

// ---- work, content, and events ---------------------------------------------------------------

fn position(context* c, u32 block, u32 operation, bool terminator)
    ownership_api.operation_position {
    ownership_api.operation_position mut op = ownership_api.operation_position{};
    op.function = c->key;
    op.block = block;
    op.operation = operation;
    op.terminator = terminator;
    return op;
}

fn source(context* c, diag.loc where) ownership_api.source_position {
    ownership_api.source_position mut at = ownership_api.source_position{};
    at.filename_present = where.file.len > 0;
    u64 mut i = 0;
    while (i < c->files.len) {
        if (c->files[i].filename == where.file) {
            at.module = c->files[i].module;
            at.file = c->files[i].file;
            break;
        }
        i += 1;
    }
    at.line = where.line;
    at.col = where.col;
    at.end_line = where.end_line;
    at.end_col = where.end_col;
    return at;
}

// A refused W charge stops the computation (D17.18). Its proof keeps the exhaustion.
fn stop(context mut* c, ownership_api.proof_status proof) void {
    if (c->stopped) { return; }
    c->stopped = true;
    c->incomplete_any = true;
    c->first_incomplete = proof;
}

/// Pays `n` W units, one request each, before the work (fir.md 14.1).
fn pay(context mut* c, u64 n) bool {
    if (c->stopped) { return false; }
    u64 mut left = n;
    while (left > 0) {
        ownership_api.charge_result charged = ownership_api.charge_work(c->svc,
            ownership_api.work_kind.transfer, c->op, source(c, c->at));
        if (!charged.allowed) {
            stop(c, charged.proof);
            return false;
        }
        left -= 1;
    }
    return true;
}

enum certainty {
    definite,
    choice,
    possible,
}

fn note_proof(context mut* c, ownership_api.proof_status proof) void {
    c->notes += 1;
    if (proof.kind == ownership_api.proof_kind.incomplete) {
        if (!c->incomplete_any) { c->first_incomplete = proof; }
        c->incomplete_any = true;
    } else {
        if (!c->failed_any) { c->first_failure = proof; }
        c->failed_any = true;
    }
}

// Records one event. Each round notes the proof. Only a reporting pass records the event, once
// for each operation, kind, and relation.
fn record(context mut* c, state* s, ownership_api.event_kind kind,
    ownership_api.evidence_kind evidence, ownership_api.incomplete_reason reason, u32 relation,
    string text) void {
    ownership_api.source_position at = source(c, c->at);
    ownership_api.proof_status mut proof = complete();
    proof.failed = true;
    if (reason != ownership_api.incomplete_reason.none) {
        proof = ownership_api.incomplete(reason, c->op, at);
    }
    ownership_api.entity_id related = relation == NONE ? ownership_api.entity_id{} :
        ownership_api.entity_id{c->key, ownership_api.entity_kind.allocation, relation + 1};
    proof.terminal.relation = related;
    note_proof(c, proof);
    if (!c->reporting) { return; }
    u64 mut i = 0;
    while (i < c->seen_len) {
        reported item = c->seen[i];
        if (ownership_keys.operation(item.operation, c->op) == 0 && item.kind == kind &&
            item.relation == relation) { return; }
        i += 1;
    }
    if (c->seen_len == c->seen.len) {
        u64 cap = grow(c->seen.len, c->seen_len + 1);
        reported mut@ own bigger = new(reported, cap);
        u64 mut j = 0;
        while (j < c->seen_len) { bigger[j] = c->seen[j]; j += 1; }
        del(c->seen);
        c->seen = move(bigger);
    }
    c->seen[c->seen_len] = reported{c->op, kind, relation};
    c->seen_len += 1;
    c->events += 1;
    ownership_api.event_descriptor mut event = ownership_api.event_descriptor{};
    event.key = ownership_api.entity_id{c->key, ownership_api.entity_kind.event, c->events};
    event.operation = c->op;
    event.source = at;
    event.kind = kind;
    event.evidence = evidence;
    event.reason = reason;
    event.relation = related;
    event.text = text;
    if (reason != ownership_api.incomplete_reason.none && s != null && s->lossy) {
        event.precision = s->loss;
    }
    ownership_api.witness_link[1] link = {ownership_api.witness_link{
        .key = ownership_api.entity_id{c->key, ownership_api.entity_kind.witness, c->events},
        .event = event.key, .validated = true}};
    if (evidence == ownership_api.evidence_kind.validated_path) { event.witnesses = link[..]; }
    // A deferred statement runs at each exit, so its event notes the registration range and
    // the exit range (`spec/toolchain.md` 4.2).
    ownership_api.event_note[10] mut notes = {};
    u64 mut count = 0;
    if (c->exit_at.file.len > 0) {
        notes[0] = ownership_api.event_note{.role = ownership_api.note_role.defer_registration,
            .source = at};
        notes[1] = ownership_api.event_note{.role = ownership_api.note_role.defer_exit,
            .source = source(c, c->exit_at)};
        count = 2;
    }
    // A validated event names each assumption of its witness, at its source: the event holds
    // when each crossed call returns, each crossed kept check passes and each dereferenced
    // pointer is not null (D17.18). Each note reads "this path needs <subject> <fact> here;
    // <outcome>", from the row of its kind (`note_row`, `spec/toolchain.md` 4.2).
    strbuf.str_buf mut assumed = strbuf.create();
    defer strbuf.free(&assumed);
    u64[8] mut ends = {};
    u32 crossed = s == null || evidence == ownership_api.evidence_kind.abstract_possibility ? 0 :
        s->crossed_len;
    u32 mut k = 0;
    while (k < crossed) {
        crossed_call item = s->crossed[k];
        note_phrase row = note_row(assumption_of(item));
        // A local without a source name, or a pointer outside a slot, has no spelling.
        bool spelled = item.named && (item.pointer.base != base_kind.local ||
            item.pointer.depth > 0 || (item.pointer.id < fir.local_count(c->f) &&
            fir.local_name(fir.local_at(c->f, item.pointer.id)).len > 0));
        strbuf.append(&assumed, "this path needs ");
        if (item.check) {
            strbuf.append(&assumed, "the ");
            strbuf.append(&assumed, check_name(item.kind));
            strbuf.append(&assumed, " check");
        } else if (item.nonnull && spelled) {
            strbuf.push(&assumed, '\'');
            append_name(c, s, item.pointer, 4, &assumed);
            strbuf.push(&assumed, '\'');
        } else if (item.nonnull) {
            strbuf.append(&assumed, "the pointer");
        } else {
            strbuf.push(&assumed, '\'');
            strbuf.append(&assumed, item.callee);
            strbuf.push(&assumed, '\'');
        }
        strbuf.push(&assumed, ' ');
        strbuf.append(&assumed, row.fact);
        strbuf.append(&assumed, " here; ");
        strbuf.append(&assumed, row.outcome);
        if (item.nonnull && spelled) {
            strbuf.push(&assumed, '\'');
            append_name(c, s, item.pointer, 4, &assumed);
            strbuf.push(&assumed, '\'');
        } else if (item.nonnull) {
            strbuf.append(&assumed, "pointer");
        }
        if (item.nonnull) {
            strbuf.append(&assumed, item.write ? " faults at this write first" :
                " faults at this read first");
        } else if (!item.check) {
            append_event_outcome(&assumed, kind, text);
        }
        ends[k] = strbuf.view(&assumed).len;
        k += 1;
    }
    string all = strbuf.view(&assumed);
    k = 0;
    while (k < crossed) {
        u64 from = k == 0 ? 0 : ends[k - 1];
        notes[count] = ownership_api.event_note{.role = ownership_api.note_role.assumption,
            .source = s->crossed[k].source, .text = all[from..ends[k]]};
        count += 1;
        k += 1;
    }
    event.notes = notes[0..count];
    ownership_api.event_request request = ownership_api.event_request{event, proof};
    ownership_api.record_event(c->svc, &request);
}

// A violation needs a witnessed path. A definite violation on that path is unconditional. A
// violation that a free input choice gives is a validated path. Anything else is incomplete
// proof with abstract possibility evidence (`spec/toolchain.md` 4.2).
fn violation(context mut* c, state* s, ownership_api.event_kind kind, certainty how,
    u32 relation, string text) void {
    if (!s->witness || how == certainty.possible) {
        record(c, s, ownership_api.event_kind.incomplete_proof,
            ownership_api.evidence_kind.abstract_possibility,
            ownership_api.incomplete_reason.missing_path, relation, text);
        return;
    }
    ownership_api.evidence_kind evidence = how == certainty.definite ?
        ownership_api.evidence_kind.unconditional : ownership_api.evidence_kind.validated_path;
    record(c, s, kind, evidence, ownership_api.incomplete_reason.none, relation, text);
}

fn unproved(context mut* c, state* s, ownership_api.incomplete_reason reason, u32 relation,
    string text) void {
    record(c, s, ownership_api.event_kind.incomplete_proof,
        ownership_api.evidence_kind.abstract_possibility, reason, relation, text);
}

fn certainty_of(root_kind r) certainty {
    if (r == root_kind.nonnull) { return certainty.definite; }
    if (r == root_kind.free) { return certainty.choice; }
    return certainty.possible;
}

// ---- names -----------------------------------------------------------------------------------

fn field_name(types.node* t, u32 k) string {
    if (!resolved_struct(t)) { return ""; }
    ast.node* decl = fir.struct_decl(t);
    u32 mut at = 0;
    u64 mut i = 0;
    while (i < ast.ast_len(decl)) {
        ast.node* field = ast.ast_child(decl, i);
        if (field->kind == ast.ast_kind.k_field_decl) {
            if (at == k) { return field->name; }
            at += 1;
        }
        i += 1;
    }
    return "";
}

// The owner slot of atom `a`, or U64_MAX.
fn owner_of(state* s, u32 a) u64 {
    u64 mut i = 0;
    while (i < s->slots_len) {
        if (s->slots[i].v.kind == value_kind.owned && s->slots[i].v.atom == a) { return i; }
        i += 1;
    }
    return U64_MAX;
}

// Writes the source spelling of slot `k` into `out`: `p.f`, `p->f`, or `*p` forms.
fn append_name(context* c, state* s, slot_key k, u32 depth_left, strbuf.str_buf mut* out) void {
    types.node* mut t = null;
    if (k.base == base_kind.local) {
        if (k.id < fir.local_count(c->f)) {
            fir.local* l = fir.local_at(c->f, k.id);
            string mut name = fir.local_name(l);
            // A local without a source name is the result or a temporary: the event names it
            // as the local analysis does (toolchain 4.2).
            if (name.len == 0) { name = k.id == 0 ? "the result" : "a temporary value"; }
            strbuf.append(out, name);
            t = l->ty;
        }
    } else if (k.base == base_kind.caller) {
        if (cast(k.id, u64) < c->callers_len) {
            fir.local* l = fir.local_at(c->f, c->callers[cast(k.id, u64)].param);
            if (k.depth == 0) { strbuf.push(out, '*'); }
            strbuf.append(out, fir.local_name(l));
            t = c->callers[cast(k.id, u64)].pointee;
        }
    } else {
        u64 owner = depth_left == 0 ? U64_MAX : owner_of(s, k.id);
        if (owner == U64_MAX) {
            strbuf.append(out, "(heap)");
        } else {
            append_name(c, s, s->slots[owner].key, depth_left - 1, out);
        }
        if (cast(k.id, u64) < s->atoms_len) { t = s->atoms[cast(k.id, u64)].ty; }
    }
    u32 mut i = 0;
    while (i < k.depth) {
        bool arrow = i == 0 && k.base != base_kind.local;
        strbuf.append(out, arrow ? "->" : ".");
        strbuf.append(out, field_name(t, k.path[i]));
        t = t != null && t->kind == types.type_kind.k_struct ?
            fir.struct_field_type(t, k.path[i]) : null;
        i += 1;
    }
}

fn name(context mut* c, state* s, slot_key k) string {
    strbuf.clear(&c->text);
    append_name(c, s, k, 4, &c->text);
    return strbuf.view(&c->text);
}

// The spelling of field slot `field` of the cell that slot `owner` held: `p->f`.
fn name_below(context mut* c, state* s, slot_key owner, slot_key field, types.node* t) string {
    strbuf.clear(&c->text);
    append_name(c, s, owner, 4, &c->text);
    types.node* mut at = t;
    u32 mut i = 0;
    while (i < field.depth) {
        strbuf.append(&c->text, i == 0 ? "->" : ".");
        strbuf.append(&c->text, field_name(at, field.path[i]));
        at = at != null && at->kind == types.type_kind.k_struct ?
            fir.struct_field_type(at, field.path[i]) : null;
        i += 1;
    }
    return strbuf.view(&c->text);
}

// ---- atoms -----------------------------------------------------------------------------------

fn new_atom(atom_kind kind, types.node* ty, u32 shape_index, root_kind root) atom {
    atom mut a = atom{};
    a.kind = kind;
    a.status = atom_status.live;
    a.ty = ty;
    a.shape = shape_index;
    a.root = root;
    a.handle = NONE;
    a.handle_field = NONE;
    a.into = NONE;
    a.borrows = true;
    a.params = true;
    return a;
}

// Adds the slots of cell `a` of struct type `t`, each with value `initial`.
fn add_cell_slots(context mut* c, state mut* s, u32 a, types.node* t) void {
    leaf_list mut list = leaf_list{};
    defer free_leaves(&list);
    leaves_of(t, &list);
    u64 mut i = 0;
    while (i < list.len) {
        leaf item = list.items[i];
        if (item.depth > 0) {
            slot mut fresh_slot = slot{};
            fresh_slot.key = key_of(base_kind.cell, a);
            fresh_slot.key.depth = item.depth;
            fresh_slot.key.path = item.path;
            fresh_slot.ty = item.ty;
            fresh_slot.owning = item.owning;
            fresh_slot.array = item.array;
            fresh_slot.v = item.v;
            push_slot(s, fresh_slot);
        }
        i += 1;
    }
}

// Unfolds region `a` into its root cell and fresh child atoms (spec/memory-model.md 2.7). The
// caller proved or assumed a nonnull root. A child of a free input choice is a free choice too.
fn unfold(context mut* c, state mut* s, u32 a) bool {
    atom parent = s->atoms[cast(a, u64)];
    if (parent.kind != atom_kind.region || parent.shape == 0) { return false; }
    shape sh = c->shapes[cast(parent.shape - 1, u64)];
    if (!pay(c, cast(sh.fields, u64) + 1)) { return false; }
    root_kind child_root = parent.empty_leaves ? root_kind.null_root :
        (parent.choice ? root_kind.free : root_kind.joined);
    // A child is a strict part when its parent is one, or when the parent is the entry value of
    // an interface atom. A fold of other members clears both facts, so a child never holds the
    // root of an interface atom.
    bool child_strict = !parent.fresh && (parent.strict ||
        (parent.handle != NONE && parent.handle_field == NONE));
    atom mut* root = &s->atoms[cast(a, u64)];
    root->kind = atom_kind.cell;
    // A root whose nullness the state does not know is nonnull here by assumption only.
    root->unfold_nonnull = parent.root != root_kind.nonnull || parent.unfold_nonnull;
    root->root = root_kind.nonnull;
    root->empty_leaves = false;
    // The borrowed fields of the root become slots again, and they hold no reference that the
    // proof follows; the children keep the fact.
    root->borrows = false;
    root->params = false;
    add_cell_slots(c, s, a, parent.ty);
    u64 mut i = 0;
    while (i < s->slots_len) {
        slot item = s->slots[i];
        if (item.key.base == base_kind.cell && item.key.id == a && item.key.depth > 0) {
            field_role role = role_of(c, parent.shape, item.key.path[0]);
            if ((role == field_role.recursive || role == field_role.payload) &&
                item.key.depth == 1) {
                atom mut child = new_atom(role == field_role.recursive ? atom_kind.region :
                    atom_kind.flat, role == field_role.recursive ? parent.ty : item.ty->elem,
                    role == field_role.recursive ? parent.shape : 0, child_root);
                child.origin = parent.origin;
                child.fresh = parent.fresh;
                child.strict = child_strict;
                child.choice = parent.choice;
                child.borrows = parent.borrows;
                child.params = parent.params;
                if (parent.handle != NONE && parent.handle_field == NONE) {
                    child.handle = parent.handle;
                    child.handle_field = item.key.path[0];
                }
                u32 made = push_atom(s, child);
                s->slots[i].v = own_value(made);
                u64 mut j = 0;
                while (j < s->slots_len) {
                    value mut* v = &s->slots[j].v;
                    if (v->kind == value_kind.view && !v->exact) {
                        u32 mut k = 0;
                        bool mut member = false;
                        while (k < v->count) {
                            if (v->sources[k] == a) { member = true; }
                            k += 1;
                        }
                        if (member && !add_source(v, made)) { *v = unknown_value(); }
                        if (member) { sort_sources(v); }
                    }
                    j += 1;
                }
            } else if (item.v.kind == value_kind.empty && !item.owning &&
                (is_reference(item.ty) || item.array)) {
                // A borrowed field of an entry value is an input of the caller. A region whose
                // fold found only external references in its borrowed fields keeps that fact.
                s->slots[i].v = parent.choice || !parent.borrows ? input_value() :
                    unknown_value();
                // A field that can hold a view of a parameter keeps that fact for a refold.
                if (parent.params) { s->slots[i].v.param = ANY_PARAM; }
            }
        }
        i += 1;
    }
    return true;
}

// Whether cell `a` folds into a region of its template: each recursive field holds a region of
// the template, a foldable cell, or nothing, and each payload field holds a flat atom or nothing.
fn foldable(context mut* c, state* s, u32 a, u32 depth) bool {
    atom item = s->atoms[cast(a, u64)];
    if (item.kind != atom_kind.cell || item.status != atom_status.live || item.shape == 0 ||
        depth > 64) { return false; }
    u64 mut i = 0;
    while (i < s->slots_len) {
        slot field = s->slots[i];
        if (field.key.base == base_kind.cell && field.key.id == a && field.owning) {
            field_role role = role_of(c, item.shape, field.key.path[0]);
            if (field.key.depth != 1 || field.array ||
                (role != field_role.recursive && role != field_role.payload)) { return false; }
            if (field.v.kind == value_kind.owned) {
                atom child = s->atoms[cast(field.v.atom, u64)];
                if (child.status != atom_status.live || field.v.atom == a) { return false; }
                if (role == field_role.recursive) {
                    if (child.kind == atom_kind.cell) {
                        if (child.ty != item.ty || !foldable(c, s, field.v.atom, depth + 1)) {
                            return false;
                        }
                    } else if (child.kind != atom_kind.region || child.shape != item.shape) {
                        return false;
                    }
                } else if (child.kind != atom_kind.flat) {
                    return false;
                }
            } else if (field.v.kind != value_kind.empty) {
                return false;
            }
        }
        i += 1;
    }
    return true;
}

// Moves the facts of `child` into `parent` and removes `child`: its views become member views.
fn absorb(state mut* s, u32 parent, u32 child) void {
    atom mut* p = &s->atoms[cast(parent, u64)];
    atom from = s->atoms[cast(child, u64)];
    p->origin = p->origin | from.origin;
    p->fresh = p->fresh || from.fresh;
    p->strict = p->strict && from.strict;
    p->exposed = p->exposed || from.exposed;
    p->borrows = p->borrows || from.borrows;
    p->params = p->params || from.params;
    p->choice = false;
    redirect(s, child, parent, false);
    s->atoms[cast(child, u64)].used = false;
    s->atoms[cast(child, u64)].into = parent;
    // An address of a field of the child still names it. The parent holds its obligation now,
    // and the proof does not follow that storage through the address (`spec/toolchain.md` 4.2).
    unowned(s, child);
    drop_cell_slots(s, child);
}

// Atom `a` no longer holds an obligation: its storage now belongs to another atom, or it left
// the proof. An address of one of its fields can still name it, so `canonical` can keep its
// record. A use through that address finds no live record and gives incomplete proof.
fn unowned(state mut* s, u32 a) void {
    atom_status was = s->atoms[cast(a, u64)].status;
    if (was == atom_status.live || was == atom_status.unknown) {
        s->atoms[cast(a, u64)].status = atom_status.escaped;
    }
}

// Folds a foldable cell bottom-up. The root keeps its identity, so an exact view of it stays.
fn fold_now(context mut* c, state mut* s, u32 a) void {
    u64 mut i = 0;
    while (i < s->slots_len) {
        slot field = s->slots[i];
        if (field.key.base == base_kind.cell && field.key.id == a && field.owning &&
            field.v.kind == value_kind.owned &&
            s->atoms[cast(field.v.atom, u64)].kind == atom_kind.cell) {
            fold_now(c, s, field.v.atom);
            i = 0;
            continue;
        }
        i += 1;
    }
    atom mut* root = &s->atoms[cast(a, u64)];
    root->kind = atom_kind.region;
    root->root = root_kind.nonnull;
    root->choice = false;
    // A later unfold names the current fields, not the entry fields.
    root->handle = NONE;
    u32 mut@ own children = new(u32, s->slots_len + 1);
    defer del(children);
    u64 mut n = 0;
    i = 0;
    while (i < s->slots_len) {
        slot field = s->slots[i];
        if (field.key.base == base_kind.cell && field.key.id == a && field.owning &&
            field.v.kind == value_kind.owned) {
            children[n] = field.v.atom;
            n += 1;
        }
        i += 1;
    }
    drop_cell_slots(s, a);
    s->atoms[cast(a, u64)].empty_leaves = n == 0;
    u64 mut k = 0;
    while (k < n) {
        absorb(s, a, children[k]);
        k += 1;
    }
}

/// Folds cell `a` when its fields allow it. Each scanned slot pays one W unit.
fn fold(context mut* c, state mut* s, u32 a) bool {
    if (!pay(c, s->slots_len + 1)) { return false; }
    if (!foldable(c, s, a, 0)) { return false; }
    bool borrows = member_refs(s, a, false);
    bool params = member_refs(s, a, true);
    fold_now(c, s, a);
    s->atoms[cast(a, u64)].borrows = borrows;
    s->atoms[cast(a, u64)].params = params;
    return true;
}

// Whether value `v` of a borrowed field is a reference that this body made (D17.14). An
// input reference of the caller, a view of caller storage or static data, and an address of
// caller storage stay live past the return. A view of a heap atom counts even when the atom
// joins the same region: a later unfold or move can take the view out of that region.
fn body_reference(value v) bool {
    if (v.kind == value_kind.unknown) { return !v.external; }
    if (v.kind == value_kind.view) { return v.count > 0; }
    if (v.kind == value_kind.address) { return v.target.base != base_kind.caller; }
    return false;
}

// Whether a reference that the arguments of a call reach can be a reference of this body: an
// argument that is one, an owned argument whose members keep one, or storage of this body or of
// its caller that an argument designates and that keeps one.
fn arguments_reach_body(state* s, argument@ args, leaf_list* arg_leaves) bool {
    bool mut storage = false;
    u64 mut i = 0;
    while (i < args.len) {
        u64 mut l = 0;
        u64 count = args[i].aggregate ? args[i].count : 1;
        while (l < count) {
            value v = args[i].aggregate ?
                current_value(s, arg_leaves->items[args[i].first + l].v) : args[i].v;
            if (v.kind == value_kind.owned) {
                if (member_refs(s, v.atom, false)) { return true; }
                storage = true;
            } else if (body_reference(v)) {
                return true;
            } else if (v.param != NONE) {
                storage = true;
            }
            l += 1;
        }
        i += 1;
    }
    if (!storage) { return false; }
    // Caller storage of this body can keep a reference of this body that it stored before.
    i = 0;
    while (i < s->slots_len) {
        slot item = s->slots[i];
        if (item.key.base == base_kind.caller) {
            if (!item.owning && body_reference(item.v)) { return true; }
            if (item.owning && item.v.kind == value_kind.owned &&
                member_refs(s, item.v.atom, false)) { return true; }
        }
        i += 1;
    }
    return false;
}

// Whether `v` stays valid in each caller: no reference, or one to static data.
fn static_reference(value v) bool {
    return !body_reference(v) && v.param == NONE;
}

// The value of a slot that stands for several references after a store of `v` into one of them.
fn weak_reference(value old, value v) value {
    if (static_reference(v) && static_reference(old)) {
        return old.kind == value_kind.empty ? v : old;
    }
    if (!body_reference(v) && !body_reference(old)) {
        value mut both = input_value();
        both.param = ANY_PARAM;
        return both;
    }
    return unknown_value();
}

// Whether atom `a`, or an atom that it owns, keeps in a borrowed field a reference that this
// body made (`params` false) or a reference to storage that a parameter designates (`params`
// true).
fn member_refs(state* s, u32 a, bool params) bool {
    bool mut@ own member = new(bool, s->atoms_len);
    defer del(member);
    owned_from(s, a, member);
    bool mut found = false;
    u64 mut i = 0;
    while (i < s->atoms_len && !found) {
        atom item = s->atoms[i];
        if (member[i] && (params ? item.params : item.borrows)) { found = true; }
        i += 1;
    }
    i = 0;
    while (i < s->slots_len && !found) {
        slot field = s->slots[i];
        if (field.key.base == base_kind.cell && member[cast(field.key.id, u64)] &&
            !field.owning && (params ? field.v.param != NONE : body_reference(field.v))) {
            found = true;
        }
        i += 1;
    }
    return found;
}

// Marks in `seen` each atom that owned edges reach from `a`, `a` included, through any owned
// cycle. An atom that `seen` already marks stops the walk.
fn owned_from(state* s, u32 a, bool mut@ seen) void {
    if (seen[cast(a, u64)]) { return; }
    u32 mut@ own stack = new(u32, s->atoms_len + 1);
    defer del(stack);
    u64 mut top = 1;
    stack[0] = a;
    seen[cast(a, u64)] = true;
    while (top > 0) {
        top -= 1;
        u32 x = stack[top];
        u64 mut i = 0;
        while (i < s->slots_len) {
            slot field = s->slots[i];
            if (field.key.base == base_kind.cell && field.key.id == x &&
                field.v.kind == value_kind.owned && !seen[cast(field.v.atom, u64)]) {
                seen[cast(field.v.atom, u64)] = true;
                stack[top] = field.v.atom;
                top += 1;
            }
            i += 1;
        }
    }
}

// Makes atom `a` opaque and absorbs each atom that it owns, through any owned cycle. Its
// obligations stay with `a`.
fn make_opaque(state mut* s, u32 a) void {
    bool borrows = member_refs(s, a, false);
    bool params = member_refs(s, a, true);
    bool mut@ own seen = new(bool, s->atoms_len);
    defer del(seen);
    owned_from(s, a, seen);
    u64 mut k = 0;
    while (k < seen.len) {
        if (seen[k] && k != cast(a, u64)) { absorb(s, a, cast(k, u32)); }
        k += 1;
    }
    drop_cell_slots(s, a);
    atom mut* item = &s->atoms[cast(a, u64)];
    item->kind = atom_kind.opaque;
    item->shape = 0;
    item->choice = false;
    item->handle = NONE;
    item->empty_leaves = false;
    item->borrows = borrows;
    item->params = params;
}

// The content of one state (fir.md 14.1): D, the deepest slot path; R, the atoms; P, the
// refined root nullness facts of regions and flat or opaque atoms; H, the graph edges and the
// entries of each template that a region uses.
struct content {
    u64 d;
    u64 r;
    u64 p;
    u64 h;
}

fn measure(context* c, state* s) content {
    content mut out = content{};
    u64 mut i = 0;
    while (i < s->atoms_len) {
        atom item = s->atoms[i];
        if (item.used) {
            out.r += 1;
            if (item.kind != atom_kind.cell && (item.root == root_kind.null_root ||
                item.root == root_kind.nonnull)) { out.p += 1; }
        }
        i += 1;
    }
    u64 mut edges = 0;
    i = 0;
    while (i < s->slots_len) {
        slot item = s->slots[i];
        if (cast(item.key.depth, u64) > out.d) { out.d = cast(item.key.depth, u64); }
        if (item.key.base == base_kind.cell) {
            if (item.v.kind == value_kind.owned) { edges += 1; }
            if (item.v.kind == value_kind.view) { edges += cast(item.v.count, u64); }
        }
        i += 1;
    }
    u64 mut templates = 0;
    u64 mut t = 0;
    while (t < c->shapes_len) {
        bool mut present = false;
        i = 0;
        while (i < s->atoms_len && !present) {
            atom item = s->atoms[i];
            if (item.used && item.kind == atom_kind.region && item.shape == cast(t + 1, u32)) {
                present = true;
            }
            i += 1;
        }
        if (present) {
            shape sh = c->shapes[t];
            templates += 4 + cast(sh.recursive, u64) + cast(sh.payload, u64);
        }
        t += 1;
    }
    out.h = edges + templates;
    return out;
}

// Covers a state that a precision bound refused: each shape becomes opaque, and each view keeps
// no source. Each obligation stays (fir.md 14.1).
fn cover(state mut* s) void {
    u64 mut i = 0;
    while (i < s->atoms_len) {
        atom item = s->atoms[i];
        if (item.used && (item.kind == atom_kind.cell || item.kind == atom_kind.region)) {
            make_opaque(s, cast(i, u32));
        }
        i += 1;
    }
    i = 0;
    while (i < s->slots_len) {
        if (s->slots[i].v.kind == value_kind.view && s->slots[i].v.count > 0) {
            s->slots[i].v = unknown_value();
        }
        i += 1;
    }
    i = 0;
    while (i < s->atoms_len) {
        atom item = s->atoms[i];
        if (item.used && (item.status == atom_status.released ||
            item.status == atom_status.maybe_released) && owner_of(s, cast(i, u32)) == U64_MAX) {
            s->atoms[i].used = false;
        }
        i += 1;
    }
}

// Covers a state that the P bound refused: each refined root becomes joined. An obligation
// stays, and only its nullness proof goes.
fn cover_roots(state mut* s) void {
    u64 mut i = 0;
    while (i < s->atoms_len) {
        atom item = s->atoms[i];
        if (item.used && item.kind != atom_kind.cell && (item.root == root_kind.null_root ||
            item.root == root_kind.nonnull)) {
            s->atoms[i].root = root_kind.joined;
        }
        i += 1;
    }
}

fn content_item(ownership_api.charge_item mut@ items, u64 mut* n, ownership_api.limit_category kind,
    u64 amount) void {
    if (amount == 0) { return; }
    items[*n] = ownership_api.charge_item{kind, ownership_api.scope_of(kind), amount};
    *n += 1;
}

/// Requests the D, R, P, and H content of a state after a change. A refused R, P, or H request
/// covers the state and records the loss. A refused D request, or a covered state that still
/// exceeds a bound, stops the computation with incomplete proof.
fn charge_content(context mut* c, state mut* s) bool {
    if (c->stopped) { return false; }
    u64 mut tries = 0;
    while (tries < 3) {
        content amount = measure(c, s);
        ownership_api.charge_item[4] mut items = {};
        u64 mut n = 0;
        content_item(items[..], &n, ownership_api.limit_category.d, amount.d);
        content_item(items[..], &n, ownership_api.limit_category.r, amount.r);
        content_item(items[..], &n, ownership_api.limit_category.p, amount.p);
        content_item(items[..], &n, ownership_api.limit_category.h, amount.h);
        if (n == 0) { return true; }
        ownership_api.charge_request req = ownership_api.charge_request{
            ownership_api.work_kind.transfer, c->op, source(c, c->at), items[0..n]};
        ownership_api.charge_result result = ownership_api.charge(c->svc, &req);
        if (result.allowed) { return true; }
        ownership_api.limit_category kind = result.limit.category;
        bool coverable = result.limit.present && (kind == ownership_api.limit_category.r ||
            kind == ownership_api.limit_category.p || kind == ownership_api.limit_category.h);
        bool precision = coverable || (result.limit.present &&
            kind == ownership_api.limit_category.d);
        if (precision && !s->lossy) {
            s->lossy = true;
            s->loss = ownership_limits.lost(&result.limit, ownership_api.entity_id{});
            s->loss.reason = ownership_api.incomplete_reason.missing_graph;
        }
        if (!precision) {
            stop(c, result.proof);
            return false;
        }
        if (!coverable || tries == 2) {
            unproved(c, s, ownership_api.incomplete_reason.missing_graph, NONE,
                "the state within its precision bounds");
            c->stopped = true;
            c->stop_lossy = s->lossy;
            c->stop_loss = s->loss;
            return false;
        }
        if (kind == ownership_api.limit_category.p) { cover_roots(s); } else { cover(s); }
        tries += 1;
    }
    return true;
}

// ---- canonical states and joins --------------------------------------------------------------

fn sort_cell_slots(state mut* s, u64 first) void {
    u64 mut i = first + 1;
    while (i < s->slots_len) {
        slot item = s->slots[i];
        u64 mut j = i;
        while (j > first && key_order(s->slots[j - 1].key, item.key) > 0) {
            s->slots[j] = s->slots[j - 1];
            j -= 1;
        }
        s->slots[j] = item;
        i += 1;
    }
}

fn map_value(value v, u32@ map) value {
    value mut out = v;
    if (v.kind == value_kind.owned) {
        u32 to = map[cast(v.atom, u64)];
        if (to == NONE) { return empty_value(); }
        out.atom = to;
    } else if (v.kind == value_kind.view) {
        out.count = 0;
        u32 mut i = 0;
        while (i < v.count) {
            u32 to = map[cast(v.sources[i], u64)];
            if (to != NONE && !add_source(&out, to)) { return unknown_value(); }
            i += 1;
        }
        sort_sources(&out);
        if (out.count == 0 && !out.external) { return v.count == 0 ? out : unknown_value(); }
        if (out.count != 1) { out.exact = false; }
    } else if (v.kind == value_kind.address && v.target.base == base_kind.cell) {
        u32 to = map[cast(v.target.id, u64)];
        if (to == NONE) { return unknown_value(); }
        out.target.id = to;
    } else if (v.kind == value_kind.scalar && v.test != NONE) {
        out.test = map[cast(v.test, u64)];
    }
    return out;
}

// The order of discovery: an owned atom, then the atoms that its cell slots own.
fn discover(state* s, u32 a, u32 mut@ map, u32 mut* next) void {
    if (map[cast(a, u64)] != NONE) { return; }
    map[cast(a, u64)] = *next;
    *next += 1;
    if (s->atoms[cast(a, u64)].kind != atom_kind.cell) { return; }
    // Cell slots follow in key order, so a scan in slot order is a path order.
    u64 mut i = 0;
    while (i < s->slots_len) {
        slot item = s->slots[i];
        if (item.key.base == base_kind.cell && item.key.id == a &&
            item.v.kind == value_kind.owned) {
            discover(s, item.v.atom, map, next);
        }
        i += 1;
    }
}

/// Puts a state in canonical form: null roots leave their slots, unreachable records without an
/// obligation go, interface atoms keep their indices, other atoms take their order of discovery,
/// and cell slots follow in key order. Each slot and atom pays one W unit.
fn canonical(context mut* c, state mut* s) bool {
    if (!s->reached) { return true; }
    if (!pay(c, s->slots_len + s->atoms_len + 1)) { return false; }
    u64 mut i = 0;
    while (i < s->slots_len) {
        value mut* v = &s->slots[i].v;
        if (v->kind == value_kind.owned &&
            s->atoms[cast(v->atom, u64)].root == root_kind.null_root &&
            s->atoms[cast(v->atom, u64)].kind != atom_kind.cell) {
            *v = empty_value();
        } else if (v->kind == value_kind.view) {
            u32 mut j = 0;
            while (j < v->count) {
                if (s->atoms[cast(v->sources[j], u64)].root == root_kind.null_root) {
                    remove_source(v, v->sources[j]);
                    continue;
                }
                j += 1;
            }
            if (v->count == 0 && !v->external) { *v = empty_value(); }
        }
        i += 1;
    }
    sort_cell_slots(s, c->fixed_len);
    bool mut@ own keep = new(bool, s->atoms_len);
    defer del(keep);
    i = 0;
    while (i < s->atoms_len) {
        atom item = s->atoms[i];
        // A null root has no allocation, so only a view or an interface index keeps it.
        keep[i] = item.used && (i < c->interface_len ||
            ((item.status == atom_status.live || item.status == atom_status.unknown) &&
            item.root != root_kind.null_root));
        i += 1;
    }
    bool mut changed = true;
    while (changed) {
        changed = false;
        i = 0;
        while (i < s->slots_len) {
            slot item = s->slots[i];
            bool live_base = item.key.base != base_kind.cell || keep[cast(item.key.id, u64)];
            if (live_base) {
                value v = item.v;
                if (v.kind == value_kind.owned && !keep[cast(v.atom, u64)]) {
                    keep[cast(v.atom, u64)] = true;
                    changed = true;
                }
                if (v.kind == value_kind.view) {
                    u32 mut j = 0;
                    while (j < v.count) {
                        if (!keep[cast(v.sources[j], u64)]) {
                            keep[cast(v.sources[j], u64)] = true;
                            changed = true;
                        }
                        j += 1;
                    }
                }
                if (v.kind == value_kind.address && v.target.base == base_kind.cell &&
                    !keep[cast(v.target.id, u64)]) {
                    keep[cast(v.target.id, u64)] = true;
                    changed = true;
                }
            }
            i += 1;
        }
    }
    u32 mut@ own map = new(u32, s->atoms_len);
    defer del(map);
    i = 0;
    while (i < s->atoms_len) { map[i] = NONE; i += 1; }
    u32 mut next = cast(c->interface_len, u32);
    i = 0;
    while (i < c->interface_len && i < s->atoms_len) { map[i] = cast(i, u32); i += 1; }
    i = 0;
    while (i < c->interface_len && i < s->atoms_len) {
        if (s->atoms[i].kind == atom_kind.cell && keep[i]) {
            u64 mut j = 0;
            while (j < s->slots_len) {
                slot item = s->slots[j];
                if (item.key.base == base_kind.cell && item.key.id == cast(i, u32) &&
                    item.v.kind == value_kind.owned && keep[cast(item.v.atom, u64)]) {
                    discover(s, item.v.atom, map, &next);
                }
                j += 1;
            }
        }
        i += 1;
    }
    i = 0;
    while (i < c->fixed_len) {
        value v = s->slots[i].v;
        if (v.kind == value_kind.owned) { discover(s, v.atom, map, &next); }
        i += 1;
    }
    i = 0;
    while (i < s->slots_len) {
        value v = s->slots[i].v;
        if (v.kind == value_kind.view) {
            u32 mut j = 0;
            while (j < v.count) {
                discover(s, v.sources[j], map, &next);
                j += 1;
            }
        }
        i += 1;
    }
    i = 0;
    while (i < s->atoms_len) {
        if (keep[i]) { discover(s, cast(i, u32), map, &next); }
        i += 1;
    }
    atom mut@ own atoms = new(atom, cast(next, u64));
    i = 0;
    while (i < s->atoms_len) {
        if (map[i] != NONE && (keep[i] || i < c->interface_len)) {
            atom mut item = s->atoms[i];
            // A record without its storage can come back only through an address of one of
            // its fields (a fold, a graft or a join gave the storage to another record). It
            // holds no obligation (`spec/toolchain.md` 4.2).
            if (!item.used && keep[i] && (item.status == atom_status.live ||
                item.status == atom_status.unknown)) { item.status = atom_status.escaped; }
            item.used = keep[i];
            atoms[cast(map[i], u64)] = item;
        }
        i += 1;
    }
    u64 mut kept = 0;
    i = 0;
    while (i < s->slots_len) {
        slot mut item = s->slots[i];
        bool cell_slot = item.key.base == base_kind.cell;
        if (!cell_slot || (keep[cast(item.key.id, u64)] && map[cast(item.key.id, u64)] != NONE)) {
            if (cell_slot) { item.key.id = map[cast(item.key.id, u64)]; }
            item.v = map_value(item.v, map[..]);
            s->slots[kept] = item;
            kept += 1;
        }
        i += 1;
    }
    s->slots_len = kept;
    del(s->atoms);
    s->atoms = move(atoms);
    s->atoms_len = cast(next, u64);
    sort_cell_slots(s, c->fixed_len);
    return true;
}

fn same_atom(atom a, atom b) bool {
    return a.kind == b.kind && a.status == b.status && a.ty == b.ty && a.shape == b.shape &&
        a.root == b.root && a.origin == b.origin && a.fresh == b.fresh && a.strict == b.strict &&
        a.choice == b.choice && a.exposed == b.exposed && a.handle == b.handle &&
        a.handle_field == b.handle_field && a.empty_leaves == b.empty_leaves &&
        a.borrows == b.borrows && a.params == b.params && a.used == b.used &&
        a.assumed_nonnull == b.assumed_nonnull && a.unfold_nonnull == b.unfold_nonnull;
}

/// Compares two canonical states. Each compared row pays one W unit.
fn equal(context mut* c, state* a, state* b, bool mut* same) bool {
    *same = false;
    if (!pay(c, a->slots_len + a->atoms_len + 1)) { return false; }
    if (a->reached != b->reached) { return true; }
    if (!a->reached) {
        *same = true;
        return true;
    }
    if (a->witness != b->witness || a->released != b->released || a->lossy != b->lossy ||
        a->required_null != b->required_null || a->slots_len != b->slots_len ||
        a->atoms_len != b->atoms_len || a->ended.len != b->ended.len ||
        a->crossed_len != b->crossed_len || a->assumptions_full != b->assumptions_full ||
        a->nonnull_callers != b->nonnull_callers || a->deref_handles != b->deref_handles) {
        return true;
    }
    u64 mut i = 0;
    while (i < cast(a->crossed_len, u64)) {
        if (crossed_order(a->crossed[i], b->crossed[i]) != 0) {
            return true;
        }
        i += 1;
    }
    i = 0;
    while (i < a->required_fields.len) {
        if (a->required_fields[i] != b->required_fields[i]) { return true; }
        i += 1;
    }
    i = 0;
    while (i < a->ended.len) {
        if (a->ended[i] != b->ended[i]) { return true; }
        i += 1;
    }
    i = 0;
    while (i < a->atoms_len) {
        if (!same_atom(a->atoms[i], b->atoms[i])) { return true; }
        i += 1;
    }
    i = 0;
    while (i < a->slots_len) {
        if (!same_key(a->slots[i].key, b->slots[i].key) ||
            !same_value(a->slots[i].v, b->slots[i].v)) { return true; }
        i += 1;
    }
    *same = true;
    return true;
}

fn join_status(atom_status a, atom_status b) atom_status {
    if (a == b) { return a; }
    if (a == atom_status.unknown || b == atom_status.unknown ||
        a == atom_status.escaped || b == atom_status.escaped) { return atom_status.unknown; }
    if (a == atom_status.leaked) { return b; }
    if (b == atom_status.leaked) { return a; }
    return atom_status.maybe_released;
}

// Joins two records of one atom. A root that each witnessed side refined from one free input choice
// stays a free choice: each of its values is feasible on a witnessed path (`spec/toolchain.md`
// 4.2). `join` keeps that rule only when one atom of the two states takes it (`choice_split`).
fn join_atom(atom a, atom b, bool witness_a, bool witness_b) atom {
    atom mut out = a;
    if (a.kind != b.kind) {
        out.kind = atom_kind.opaque;
        out.shape = 0;
    }
    if (a.shape != b.shape) { out.shape = 0; }
    // A null root holds no allocation, so its status says nothing about the other side.
    out.status = join_status(a.status, b.status);
    if (a.root == root_kind.null_root) { out.status = b.status; }
    if (b.root == root_kind.null_root) { out.status = a.status; }
    out.root = join_root(a.root, b.root);
    if (a.choice && b.choice && witness_a && witness_b && a.root != root_kind.joined &&
        b.root != root_kind.joined) { out.root = a.root == b.root ? a.root : root_kind.free; }
    out.origin = a.origin | b.origin;
    out.fresh = a.fresh || b.fresh;
    out.strict = a.strict && b.strict;
    out.choice = a.choice && b.choice;
    out.exposed = a.exposed || b.exposed;
    out.assumed_nonnull = a.assumed_nonnull && b.assumed_nonnull;
    out.unfold_nonnull = a.unfold_nonnull || b.unfold_nonnull;
    // A null root has no leaves, so only the other side says whether they are empty.
    bool leaves_a = a.empty_leaves || a.root == root_kind.null_root;
    bool leaves_b = b.empty_leaves || b.root == root_kind.null_root;
    out.empty_leaves = leaves_a && leaves_b && out.kind == atom_kind.region &&
        (a.empty_leaves || b.empty_leaves);
    out.borrows = a.borrows || b.borrows;
    out.params = a.params || b.params;
    if (a.handle != b.handle || a.handle_field != b.handle_field) {
        out.handle = NONE;
        out.handle_field = NONE;
    }
    out.used = true;
    return out;
}

// Whether `join_atom` keeps a free root for two records whose roots differ: each value comes
// from a free input choice on a witnessed path.
fn choice_split(atom a, atom b, bool witness_a, bool witness_b) bool {
    return a.choice && b.choice && witness_a && witness_b && a.root != root_kind.joined &&
        b.root != root_kind.joined && a.root != b.root;
}

fn cell_slot(state* s, u32 a, slot_key k) u64 {
    slot_key mut want = k;
    want.base = base_kind.cell;
    want.id = a;
    return find_slot(s, want);
}

// Gives both sides of a join one atom kind at each owned slot: a cell meets a region by a fold,
// and any other difference makes both sides opaque.
fn harmonize(context mut* c, state mut* x, state mut* y, value vx, value vy, u32 depth) bool {
    if (depth > 64) { return true; }
    if (vx.kind == value_kind.owned && vy.kind == value_kind.owned) {
        atom ax = x->atoms[cast(vx.atom, u64)];
        atom ay = y->atoms[cast(vy.atom, u64)];
        if (ax.kind == atom_kind.cell && ay.kind == atom_kind.cell && ax.ty == ay.ty) {
            u64 mut i = 0;
            while (i < x->slots_len) {
                slot item = x->slots[i];
                if (item.key.base == base_kind.cell && item.key.id == vx.atom) {
                    u64 j = cell_slot(y, vy.atom, item.key);
                    if (j != U64_MAX &&
                        !harmonize(c, x, y, item.v, y->slots[j].v, depth + 1)) { return false; }
                }
                i += 1;
            }
            return true;
        }
        if (ax.kind == atom_kind.cell && ay.kind == atom_kind.region && ax.shape == ay.shape) {
            if (!fold(c, x, vx.atom)) {
                if (c->stopped) { return false; }
                make_opaque(x, vx.atom);
                make_opaque(y, vy.atom);
            }
            return true;
        }
        if (ay.kind == atom_kind.cell && ax.kind == atom_kind.region && ax.shape == ay.shape) {
            if (!fold(c, y, vy.atom)) {
                if (c->stopped) { return false; }
                make_opaque(x, vx.atom);
                make_opaque(y, vy.atom);
            }
            return true;
        }
        if (ax.kind != ay.kind || ax.shape != ay.shape) {
            make_opaque(x, vx.atom);
            make_opaque(y, vy.atom);
        }
        return true;
    }
    if (vx.kind == value_kind.owned && vy.kind == value_kind.empty &&
        x->atoms[cast(vx.atom, u64)].kind == atom_kind.cell) {
        if (!fold(c, x, vx.atom)) {
            if (c->stopped) { return false; }
            make_opaque(x, vx.atom);
        }
    }
    if (vy.kind == value_kind.owned && vx.kind == value_kind.empty &&
        y->atoms[cast(vy.atom, u64)].kind == atom_kind.cell) {
        if (!fold(c, y, vy.atom)) {
            if (c->stopped) { return false; }
            make_opaque(y, vy.atom);
        }
    }
    return true;
}

// The pairing of a join: each atom of either side takes one atom of the result.
struct pairing {
    u32 mut@ own px;
    u32 mut@ own py;
    bool mut@ own nullside;
    u32 next;
    u64 interface_len;
}

fn fresh_id(pairing mut* p) u32 {
    u32 out = p->next;
    p->next += 1;
    return out;
}

// Pairs the atoms of two owned values. Phase 1 pairs two owned atoms. Phase 2 pairs an owned
// atom with an empty slot. An interface atom keeps its index only when both sides hold it, or
// when the empty side proved its root null; otherwise its identity splits (`spec/fir.md` 14 Calls).
fn pair_values(state* x, state* y, pairing mut* p, value vx, value vy, u32 depth, u32 phase)
    void {
    if (depth > 64) { return; }
    if (vx.kind == value_kind.owned && vy.kind == value_kind.owned) {
        u64 a = cast(vx.atom, u64);
        u64 b = cast(vy.atom, u64);
        if (p->px[a] == NONE && p->py[b] == NONE) {
            if (phase != 1) { return; }
            u32 o = a == b && a < p->interface_len ? cast(a, u32) : fresh_id(p);
            p->px[a] = o;
            p->py[b] = o;
        } else if (p->px[a] == NONE || p->px[a] != p->py[b]) {
            return;
        }
        if (x->atoms[a].kind == atom_kind.cell && y->atoms[b].kind == atom_kind.cell) {
            u64 mut i = 0;
            while (i < x->slots_len) {
                slot item = x->slots[i];
                if (item.key.base == base_kind.cell && item.key.id == vx.atom) {
                    u64 j = cell_slot(y, vy.atom, item.key);
                    if (j != U64_MAX) {
                        pair_values(x, y, p, item.v, y->slots[j].v, depth + 1, phase);
                    }
                }
                i += 1;
            }
        }
        return;
    }
    if (phase != 2) { return; }
    if (vx.kind == value_kind.owned && vy.kind == value_kind.empty) {
        u64 a = cast(vx.atom, u64);
        if (p->px[a] != NONE) { return; }
        bool keep = a < p->interface_len && p->py[a] == NONE && a < y->atoms_len &&
            y->atoms[a].root == root_kind.null_root;
        u32 o = keep ? cast(a, u32) : fresh_id(p);
        p->px[a] = o;
        if (keep) { p->py[a] = o; }
        p->nullside[cast(o, u64)] = true;
    }
    if (vy.kind == value_kind.owned && vx.kind == value_kind.empty) {
        u64 b = cast(vy.atom, u64);
        if (p->py[b] != NONE) { return; }
        bool keep = b < p->interface_len && p->px[b] == NONE && b < x->atoms_len &&
            x->atoms[b].root == root_kind.null_root;
        u32 o = keep ? cast(b, u32) : fresh_id(p);
        p->py[b] = o;
        if (keep) { p->px[b] = o; }
        p->nullside[cast(o, u64)] = true;
    }
}

fn join_values(state mut* out, pairing* p, value vx, value vy) value {
    if (vx.kind == value_kind.empty && vy.kind == value_kind.empty) { return empty_value(); }
    if (vx.kind == value_kind.unknown && vy.kind == value_kind.unknown) {
        if (vx.external && vy.external) {
            if (same_key(vx.target, vy.target) && vx.param == vy.param) { return vx; }
            value mut either = input_value();
            if (vx.param != NONE || vy.param != NONE) { either.param = ANY_PARAM; }
            return either;
        }
        return vx.exact && vy.exact ? effect_value() : unknown_value();
    }
    if (vx.kind == value_kind.owned || vy.kind == value_kind.owned) {
        u32 ox = vx.kind == value_kind.owned ? p->px[cast(vx.atom, u64)] : NONE;
        u32 oy = vy.kind == value_kind.owned ? p->py[cast(vy.atom, u64)] : NONE;
        if (vx.kind == value_kind.owned && vy.kind == value_kind.owned && ox == oy && ox != NONE) {
            return own_value(ox);
        }
        if (vx.kind == value_kind.owned && vy.kind == value_kind.empty && ox != NONE) {
            return own_value(ox);
        }
        if (vy.kind == value_kind.owned && vx.kind == value_kind.empty && oy != NONE) {
            return own_value(oy);
        }
        // Different identities at one owner: keep one obligation of unknown shape.
        atom mut lost = new_atom(atom_kind.opaque, null, 0, root_kind.joined);
        lost.status = atom_status.unknown;
        return own_value(push_atom(out, lost));
    }
    if (vx.kind == value_kind.scalar && vy.kind == value_kind.scalar) { return scalar_value(); }
    bool vx_view = vx.kind == value_kind.view || vx.kind == value_kind.empty;
    bool vy_view = vy.kind == value_kind.view || vy.kind == value_kind.empty;
    if (vx_view && vy_view) {
        value mut v = empty_value();
        v.kind = value_kind.view;
        v.external = vx.external || vy.external;
        v.nullness = join_root(vx.kind == value_kind.empty ? root_kind.null_root : vx.nullness,
            vy.kind == value_kind.empty ? root_kind.null_root : vy.nullness);
        u32 mut i = 0;
        while (i < vx.count) {
            if (!add_source(&v, p->px[cast(vx.sources[i], u64)])) { return unknown_value(); }
            i += 1;
        }
        i = 0;
        while (i < vy.count) {
            if (!add_source(&v, p->py[cast(vy.sources[i], u64)])) { return unknown_value(); }
            i += 1;
        }
        sort_sources(&v);
        v.exact = vx.kind == value_kind.view && vy.kind == value_kind.view && vx.exact &&
            vy.exact && v.count == 1;
        v.param = vx.kind == value_kind.empty ? vy.param : vx.param;
        if (vx.kind == value_kind.view && vy.kind == value_kind.view && vx.param != vy.param) {
            v.param = ANY_PARAM;
        }
        return v;
    }
    if ((vx.kind == value_kind.address && vy.kind == value_kind.view) ||
        (vx.kind == value_kind.view && vy.kind == value_kind.address)) {
        // An address of caller storage stays live for the call; an address of a cell is a
        // member of that cell. An address of local storage keeps no fact.
        value a = vx.kind == value_kind.address ? vx : vy;
        value w = vx.kind == value_kind.view ? vx : vy;
        u32@ wmap = vx.kind == value_kind.view ? p->px[..] : p->py[..];
        u32@ amap = vx.kind == value_kind.address ? p->px[..] : p->py[..];
        if (a.target.base == base_kind.local) { return unknown_value(); }
        value mut v = empty_value();
        v.kind = value_kind.view;
        v.external = w.external || a.target.base == base_kind.caller;
        v.nullness = join_root(w.nullness, root_kind.nonnull);
        v.param = a.param == w.param ? a.param : ANY_PARAM;
        if (a.target.base == base_kind.cell && !add_source(&v, amap[cast(a.target.id, u64)])) {
            return unknown_value();
        }
        u32 mut i = 0;
        while (i < w.count) {
            if (!add_source(&v, wmap[cast(w.sources[i], u64)])) { return unknown_value(); }
            i += 1;
        }
        sort_sources(&v);
        return v;
    }
    if (vx.kind == value_kind.address && vy.kind == value_kind.address) {
        slot_key mut tx = vx.target;
        slot_key mut ty = vy.target;
        if (tx.base == base_kind.cell) { tx.id = p->px[cast(tx.id, u64)]; }
        if (ty.base == base_kind.cell) { ty.id = p->py[cast(ty.id, u64)]; }
        if (same_key(tx, ty)) {
            value mut joined_address = address_value(tx);
            joined_address.param = vx.param == vy.param ? vx.param : ANY_PARAM;
            return joined_address;
        }
    }
    return unknown_value();
}

// Folds each foldable cell and makes each other cell opaque, so a widened state has no cell.
fn widen_cells(context mut* c, state mut* s) bool {
    u64 mut i = 0;
    while (i < s->atoms_len) {
        if (s->atoms[i].used && s->atoms[i].kind == atom_kind.cell &&
            !fold(c, s, cast(i, u32))) {
            if (c->stopped) { return false; }
            make_opaque(s, cast(i, u32));
        }
        i += 1;
    }
    return true;
}

/// Joins two canonical states (fir.md 14.1). The result represents each path of both inputs and
/// keeps each possible obligation. `widen` first removes each cell, so the domain stays finite.
fn join(context mut* c, state* a, state* b, bool widen, state mut* out) bool {
    if (!a->reached || !b->reached) {
        state mut copy = clone(a->reached ? a : b);
        if (widen && !widen_cells(c, &copy)) {
            free_state(&copy);
            return false;
        }
        replace(out, &copy);
        return canonical(c, out);
    }
    state mut x = clone(a);
    defer free_state(&x);
    state mut y = clone(b);
    defer free_state(&y);
    if (widen && (!widen_cells(c, &x) || !widen_cells(c, &y))) { return false; }
    if (!pay(c, x.slots_len + y.slots_len + x.atoms_len + y.atoms_len + 1)) { return false; }
    u64 mut i = 0;
    while (i < c->fixed_len) {
        if (!harmonize(c, &x, &y, x.slots[i].v, y.slots[i].v, 0)) { return false; }
        i += 1;
    }
    pairing mut p = pairing{};
    p.interface_len = c->interface_len;
    p.next = cast(c->interface_len, u32);
    p.px = new(u32, x.atoms_len);
    p.py = new(u32, y.atoms_len);
    p.nullside = new(bool, x.atoms_len + y.atoms_len + c->interface_len + 1);
    defer del(p.px);
    defer del(p.py);
    defer del(p.nullside);
    i = 0;
    while (i < x.atoms_len) { p.px[i] = NONE; i += 1; }
    i = 0;
    while (i < y.atoms_len) { p.py[i] = NONE; i += 1; }
    u32 mut phase = 1;
    while (phase <= 2) {
        i = 0;
        while (i < c->fixed_len) {
            pair_values(&x, &y, &p, x.slots[i].v, y.slots[i].v, 0, phase);
            i += 1;
        }
        phase += 1;
    }
    // A record that neither side owns keeps its index. A record that one side owns elsewhere
    // splits: the other side's record takes a fresh index, and record i stays unused. A record
    // that one side split already stays split: record i describes the entry value on each path
    // or on none, so a null root on one path never says that each returning path had one.
    i = 0;
    while (i < c->interface_len) {
        if (p.px[i] == NONE && p.py[i] == NONE && x.atoms[i].used == y.atoms[i].used) {
            p.px[i] = cast(i, u32);
            p.py[i] = cast(i, u32);
        }
        i += 1;
    }
    i = 0;
    while (i < x.atoms_len) {
        if (x.atoms[i].used && p.px[i] == NONE) { p.px[i] = fresh_id(&p); }
        i += 1;
    }
    i = 0;
    while (i < y.atoms_len) {
        if (y.atoms[i].used && p.py[i] == NONE) { p.py[i] = fresh_id(&p); }
        i += 1;
    }
    state mut joined = state{};
    joined.reached = true;
    joined.witness = x.witness || y.witness;
    joined.released = x.released | y.released;
    joined.lossy = x.lossy || y.lossy;
    joined.loss = x.lossy ? x.loss : y.loss;
    // A requirement of one path only is a requirement of some paths: no caller can validate a
    // failure of it.
    joined.required_null = x.required_null & y.required_null;
    // The witness of the join takes the path of one side, so it can cross the calls of either.
    joined.crossed = x.crossed;
    joined.crossed_len = x.crossed_len;
    joined.assumptions_full = x.assumptions_full || y.assumptions_full;
    joined.nonnull_callers = x.nonnull_callers & y.nonnull_callers;
    joined.deref_handles = x.deref_handles & y.deref_handles;
    i = 0;
    while (i < cast(y.crossed_len, u64)) {
        if (!add_crossed(&joined, y.crossed[i])) {
            joined.witness = false;
            joined.assumptions_full = true;
        }
        i += 1;
    }
    i = 0;
    while (i < joined.required_fields.len) {
        joined.required_fields[i] = x.required_fields[i] & y.required_fields[i];
        i += 1;
    }
    joined.ended = new(u8, x.ended.len);
    i = 0;
    while (i < x.ended.len) {
        joined.ended[i] = x.ended[i] == y.ended[i] ? x.ended[i] : 2;
        i += 1;
    }
    u64 total = cast(p.next, u64);
    joined.atoms = new(atom, total);
    joined.atoms_len = total;
    bool mut@ own from_x = new(bool, total);
    defer del(from_x);
    bool mut@ own from_y = new(bool, total);
    defer del(from_y);
    bool mut@ own fork = new(bool, total);
    defer del(fork);
    i = 0;
    while (i < x.atoms_len) {
        u32 o = p.px[i];
        if (o != NONE && x.atoms[i].used) {
            joined.atoms[cast(o, u64)] = x.atoms[i];
            from_x[cast(o, u64)] = true;
        }
        i += 1;
    }
    i = 0;
    while (i < y.atoms_len) {
        u32 o = p.py[i];
        if (o != NONE && y.atoms[i].used) {
            u64 at = cast(o, u64);
            fork[at] = from_x[at] &&
                choice_split(joined.atoms[at], y.atoms[i], x.witness, y.witness);
            joined.atoms[at] = from_x[at] ?
                join_atom(joined.atoms[at], y.atoms[i], x.witness, y.witness) : y.atoms[i];
            from_y[at] = true;
        }
        i += 1;
    }
    // A free root of a join holds each value of one input on a witnessed path, but not each
    // combination of values of two inputs: two inputs that differ between the paths can be
    // correlated, so neither stays a free choice (`spec/toolchain.md` 4.2, "A collection of
    // independent may-facts does not supply that validation").
    u64 mut forks = 0;
    i = 0;
    while (i < total) {
        if (fork[i]) { forks += 1; }
        i += 1;
    }
    i = 0;
    while (i < total && forks > 1) {
        if (fork[i]) { joined.atoms[i].root = root_kind.joined; }
        i += 1;
    }
    i = 0;
    while (i < total) {
        if ((from_x[i] != from_y[i]) && p.nullside[i]) {
            joined.atoms[i].root = join_root(joined.atoms[i].root, root_kind.null_root);
        }
        if (i < c->interface_len && !(from_x[i] || from_y[i])) {
            // Each side keeps the identity of this interface atom elsewhere.
            atom mut split = x.atoms[i];
            split.status = join_status(x.atoms[i].status, y.atoms[i].status);
            split.used = false;
            joined.atoms[i] = split;
        }
        i += 1;
    }
    i = 0;
    while (i < c->fixed_len) {
        slot mut item = x.slots[i];
        item.v = join_values(&joined, &p, x.slots[i].v, y.slots[i].v);
        push_slot(&joined, item);
        i += 1;
    }
    i = c->fixed_len;
    while (i < x.slots_len) {
        slot mut item = x.slots[i];
        u32 o = p.px[cast(item.key.id, u64)];
        if (o != NONE) {
            item.key.id = o;
            value mut yv = empty_value();
            bool mut paired = false;
            u64 mut j = c->fixed_len;
            while (j < y.slots_len) {
                slot other = y.slots[j];
                if (p.py[cast(other.key.id, u64)] == o && other.key.depth == item.key.depth) {
                    slot_key mut k = other.key;
                    k.id = o;
                    if (same_key(k, item.key)) {
                        yv = other.v;
                        paired = true;
                    }
                }
                j += 1;
            }
            if (paired) {
                item.v = join_values(&joined, &p, x.slots[i].v, yv);
            } else {
                item.v = map_value(x.slots[i].v, p.px[..]);
            }
            push_slot(&joined, item);
        }
        i += 1;
    }
    i = c->fixed_len;
    while (i < y.slots_len) {
        slot mut item = y.slots[i];
        u32 o = p.py[cast(item.key.id, u64)];
        if (o != NONE) {
            item.key.id = o;
            if (find_slot(&joined, item.key) == U64_MAX) {
                item.v = map_value(y.slots[i].v, p.py[..]);
                push_slot(&joined, item);
            }
        }
        i += 1;
    }
    replace(out, &joined);
    return canonical(c, out);
}

// ---- the body and its interface --------------------------------------------------------------

fn push_fixed(context mut* c, slot item) void {
    if (c->fixed_len == c->fixed.len) {
        u64 cap = grow(c->fixed.len, c->fixed_len + 1);
        slot mut@ own bigger = new(slot, cap);
        u64 mut i = 0;
        while (i < c->fixed_len) { bigger[i] = c->fixed[i]; i += 1; }
        del(c->fixed);
        c->fixed = move(bigger);
    }
    c->fixed[c->fixed_len] = item;
    c->fixed_len += 1;
}

fn add_fixed_leaves(context mut* c, base_kind base, u32 id, types.node* t, leaf_list mut* list)
    void {
    leaves_of(t, list);
    u64 mut i = 0;
    while (i < list->len) {
        leaf item = list->items[i];
        if (base == base_kind.local || item.ty == null || !types.type_is_scalar(item.ty)) {
            slot mut fixed_slot = slot{};
            fixed_slot.key = key_of(base, id);
            fixed_slot.key.depth = item.depth;
            fixed_slot.key.path = item.path;
            fixed_slot.ty = item.ty;
            fixed_slot.owning = item.owning;
            fixed_slot.array = item.array;
            fixed_slot.v = item.v;
            push_fixed(c, fixed_slot);
        }
        i += 1;
    }
}

fn borrowed_pointer(types.node* t) bool {
    return t != null && t->kind == types.type_kind.k_ptr && !t->is_own && t->elem != null &&
        (resolved_struct(t->elem) || is_reference(t->elem));
}

fn param_count(fir.func* f) u32 {
    u32 mut n = 0;
    u32 mut i = 1;
    while (i < fir.local_count(f)) {
        if (fir.local_at(f, i)->kind == fir.local_kind.lk_param) { n = i; }
        i += 1;
    }
    return n;
}

// Lays out the fixed slots: the leaves of each local, then the leaves of the caller storage of
// each borrowed pointer parameter. Each owned leaf of a parameter or of caller storage is an
// interface atom (`spec/fir.md` 14 Calls). False when the interface exceeds its bit set.
fn lay_out(context mut* c) bool {
    u32 n = fir.local_count(c->f);
    c->local_first = new(u32, cast(n, u64));
    c->local_count = new(u32, cast(n, u64));
    c->addressed = new(bool, cast(n, u64));
    // An `addr` or a `slice` of a fixed place on a local names the storage of that local. A
    // place that reads a pointer names the storage of its target (`fir.place_fixed`).
    u32 mut b = 0;
    while (b < fir.block_count(c->f)) {
        u32 mut k = 0;
        while (k < fir.block_statement_count(c->f, b)) {
            fir.statement* stmt = fir.block_statement(c->f, b, k);
            if (stmt->kind == fir.stmt_kind.st_assign &&
                (stmt->value.kind == fir.rvalue_kind.rv_addr ||
                stmt->value.kind == fir.rvalue_kind.rv_slice) &&
                fir.place_fixed(c->f, stmt->value.place) && stmt->value.place.local < n) {
                c->addressed[cast(stmt->value.place.local, u64)] = true;
            }
            k += 1;
        }
        b += 1;
    }
    leaf_list mut list = leaf_list{};
    defer free_leaves(&list);
    u32 mut i = 0;
    while (i < n) {
        c->local_first[cast(i, u64)] = cast(c->fixed_len, u32);
        add_fixed_leaves(c, base_kind.local, i, fir.local_at(c->f, i)->ty, &list);
        c->local_count[cast(i, u64)] = cast(c->fixed_len, u32) - c->local_first[cast(i, u64)];
        i += 1;
    }
    u32 params = param_count(c->f);
    c->callers = new(caller_entry, cast(params, u64) + 1);
    c->caller_first = new(u32, cast(params, u64) + 1);
    c->caller_count = new(u32, cast(params, u64) + 1);
    i = 1;
    while (i <= params) {
        types.node* t = fir.local_at(c->f, i)->ty;
        if (borrowed_pointer(t)) {
            u64 at = c->callers_len;
            c->callers[at] = caller_entry{i, t->elem};
            c->caller_first[at] = cast(c->fixed_len, u32);
            add_fixed_leaves(c, base_kind.caller, cast(at, u32), t->elem, &list);
            c->caller_count[at] = cast(c->fixed_len, u32) - c->caller_first[at];
            c->callers_len += 1;
        }
        i += 1;
    }
    u64 mut count = 0;
    u64 mut k = 0;
    while (k < c->fixed_len) {
        slot item = c->fixed[k];
        bool param = item.key.base == base_kind.local && item.key.id >= 1 && item.key.id <= params;
        if (item.owning && (param || item.key.base == base_kind.caller)) { count += 1; }
        k += 1;
    }
    if (count > INTERFACE_LIMIT) { return false; }
    c->interface = new(interface_entry, count);
    c->require_null = new(bool, count);
    c->require_fields = new(u64, count);
    k = 0;
    while (k < c->fixed_len) {
        slot item = c->fixed[k];
        bool param = item.key.base == base_kind.local && item.key.id >= 1 && item.key.id <= params;
        if (item.owning && (param || item.key.base == base_kind.caller)) {
            u32 mut template_index = 0;
            atom_kind kind = owned_kind(c, item.ty, item.array, &template_index);
            types.node* ty = kind == atom_kind.region ? item.ty->elem :
                (is_reference(item.ty) ? item.ty->elem : item.ty);
            interface_entry mut e = interface_entry{};
            e.key = item.key;
            e.kind = kind;
            e.ty = ty;
            e.shape = template_index;
            c->interface[c->interface_len] = e;
            c->interface_len += 1;
        }
        k += 1;
    }
    return true;
}

fn caller_of(context* c, u32 param) u32 {
    u64 mut i = 0;
    while (i < c->callers_len) {
        if (c->callers[i].param == param) { return cast(i, u32); }
        i += 1;
    }
    return NONE;
}

// The entry state: each interface atom is a free input choice (`spec/toolchain.md` 4.2) whose shape
// the caller supplies, each borrowed pointer parameter designates its caller storage, and each
// other borrowed reference stays live for the whole call.
fn initial(context mut* c) state {
    state mut s = bottom(cast(fir.local_count(c->f), u64));
    s.reached = true;
    s.witness = true;
    u64 mut i = 0;
    while (i < c->fixed_len) {
        push_slot(&s, c->fixed[i]);
        i += 1;
    }
    i = 0;
    while (i < c->interface_len) {
        interface_entry e = c->interface[i];
        atom mut a = new_atom(e.kind, e.ty, e.shape, root_kind.free);
        a.origin = bit(i);
        a.choice = e.kind == atom_kind.region || e.kind == atom_kind.flat;
        a.handle = cast(i, u32);
        // The fields of an entry value are inputs of the caller: no reference of this body.
        a.borrows = false;
        u32 made = push_atom(&s, a);
        u64 at = find_slot(&s, e.key);
        if (at != U64_MAX) { s.slots[at].v = own_value(made); }
        i += 1;
    }
    u32 params = param_count(c->f);
    i = 0;
    while (i < s.slots_len) {
        slot item = s.slots[i];
        if (item.key.base == base_kind.local && item.key.id >= 1 && item.key.id <= params &&
            !item.owning) {
            u32 caller = item.key.depth == 0 ? caller_of(c, item.key.id) : NONE;
            if (caller != NONE) {
                value mut designated = address_value(key_of(base_kind.caller, caller));
                designated.param = item.key.id;
                s.slots[i].v = designated;
            } else if (is_reference(item.ty) || item.array) {
                value mut v = external_view();
                v.nullness = root_kind.free;
                v.param = item.key.id;
                s.slots[i].v = v;
            }
        } else if (item.key.base == base_kind.caller && !item.owning &&
            (is_reference(item.ty) || item.array)) {
            s.slots[i].v = entry_value(item.key);
        }
        i += 1;
    }
    return s;
}

// ---- places and values -----------------------------------------------------------------------

fn unknown_location() location {
    location mut loc = location{};
    loc.kind = location_kind.unknown;
    return loc;
}

// Checks that a read or a write through storage of `count` sources finds each source live
// (D17.14). A released source of each alternative is an invalid use. Another doubt gives
// incomplete proof. False when the access is not proved.
fn use_sources(context mut* c, state mut* s, u32 count, u32[8] sources, string what) bool {
    u32 mut released = 0;
    u32 mut unknown = 0;
    u32 mut doubtful = 0;
    u32 mut first = NONE;
    u32 mut i = 0;
    while (i < count) {
        atom item = s->atoms[cast(sources[i], u64)];
        if (item.status == atom_status.released) {
            released += 1;
            if (first == NONE) { first = sources[i]; }
        } else if (item.status == atom_status.unknown || item.status == atom_status.escaped) {
            unknown += 1;
            if (first == NONE) { first = sources[i]; }
        } else if (item.status == atom_status.maybe_released) {
            doubtful += 1;
            if (first == NONE) { first = sources[i]; }
        }
        i += 1;
    }
    if (count > 0 && released == count) {
        violation(c, s, ownership_api.event_kind.invalid_use, certainty.definite, first, what);
        return false;
    }
    if (unknown > 0) {
        unproved(c, s, ownership_api.incomplete_reason.unknown_effect, first, what);
        return false;
    }
    if (released > 0 || doubtful > 0) {
        unproved(c, s, ownership_api.incomplete_reason.missing_path, first, what);
        return false;
    }
    return true;
}

// The reason for an owned effect at a location that the proof does not follow: a lost shape
// (an opaque atom) or a lost source (fir.md 14.1, toolchain 4.2).
fn untracked(state* s, location loc) ownership_api.incomplete_reason {
    if (loc.kind == location_kind.element) {
        u32 mut i = 0;
        while (i < loc.count) {
            if (s->atoms[cast(loc.sources[i], u64)].kind == atom_kind.opaque) {
                return ownership_api.incomplete_reason.missing_graph;
            }
            i += 1;
        }
    }
    return ownership_api.incomplete_reason.unknown_effect;
}

fn element_of(u32 count, u32[8] sources, bool external) location {
    location mut loc = location{};
    loc.kind = location_kind.element;
    loc.count = count;
    loc.sources = sources;
    loc.external = external;
    return loc;
}

// The storage that atom `a` designates (`spec/memory-model.md` 2.7). A region root unfolds; a null
// dereference is undefined behavior outside the proof (memory model 8), so the unfold assumes a
// nonnull root.
fn deref_atom(context mut* c, state mut* s, u32 a, string what) location {
    atom item = s->atoms[cast(a, u64)];
    u32[8] mut one = {};
    one[0] = a;
    if (item.status == atom_status.released) {
        violation(c, s, ownership_api.event_kind.invalid_use, certainty.definite, a, what);
        return unknown_location();
    }
    if (item.status == atom_status.unknown || item.status == atom_status.escaped) {
        unproved(c, s, ownership_api.incomplete_reason.unknown_effect, a, what);
        return unknown_location();
    }
    if (item.status == atom_status.maybe_released) {
        unproved(c, s, ownership_api.incomplete_reason.missing_path, a, what);
        return unknown_location();
    }
    if (item.root == root_kind.null_root) {
        violation(c, s, ownership_api.event_kind.invalid_use, certainty.definite, a, what);
        return unknown_location();
    }
    if (item.kind == atom_kind.cell) {
        location mut loc = location{};
        loc.kind = location_kind.slots;
        loc.key = key_of(base_kind.cell, a);
        return loc;
    }
    if (item.kind == atom_kind.region) {
        c->needs_shape = c->needs_shape | item.origin;
        if (!unfold(c, s, a)) { return unknown_location(); }
        location mut loc = location{};
        loc.kind = location_kind.slots;
        loc.key = key_of(base_kind.cell, a);
        return loc;
    }
    return element_of(1, one, false);
}

// Notes that the body reads storage that a parameter designates, so each caller checks that
// storage at the call.
fn note_param_read(context mut* c, u32 param) void {
    if (param == ANY_PARAM) {
        c->view_reads = U64_MAX;
        c->reads_high = true;
    } else if (param != NONE && param >= 64) {
        c->reads_high = true;
    } else if (param != NONE) {
        c->view_reads = c->view_reads | bit(cast(param, u64));
    }
}

// Whether the callee reads the storage that parameter `param` (from 1) designates.
fn reads_param(summary* sum, u64 param) bool {
    if (param >= 64) { return sum->reads_high; }
    return (sum->view_reads & bit(param)) != 0;
}

fn deref_value(context mut* c, state mut* s, value v, bool owning, string what) location {
    note_param_read(c, v.param);
    switch (v.kind) {
    case value_kind.address:
        if (v.target.base == base_kind.local) {
            u8 ended = s->ended[cast(v.target.id, u64)];
            if (ended == 1) {
                violation(c, s, ownership_api.event_kind.invalid_use, certainty.definite, NONE,
                    what);
                return unknown_location();
            }
            if (ended == 2) {
                unproved(c, s, ownership_api.incomplete_reason.missing_path, NONE, what);
                return unknown_location();
            }
        } else if (v.target.base == base_kind.cell) {
            atom item = s->atoms[cast(v.target.id, u64)];
            if (item.status != atom_status.live && item.status != atom_status.leaked) {
                u32[8] mut one = {};
                one[0] = v.target.id;
                use_sources(c, s, 1, one, what);
                return unknown_location();
            }
        }
        location mut loc = location{};
        loc.kind = location_kind.slots;
        loc.key = v.target;
        return loc;
    case value_kind.owned:
        return deref_atom(c, s, v.atom, what);
    case value_kind.view:
        if (v.exact && v.count == 1 && !v.external) {
            return deref_atom(c, s, v.sources[0], what);
        }
        if (!use_sources(c, s, v.count, v.sources, what)) { return unknown_location(); }
        return element_of(v.count, v.sources, v.external);
    case value_kind.empty:
        if (owning) {
            violation(c, s, ownership_api.event_kind.invalid_use, certainty.definite, NONE, what);
        }
        return unknown_location();
    default:
        // A reference whose source the proof lost: each access needs that source live.
        unproved(c, s, ownership_api.incomplete_reason.unknown_effect, NONE, what);
        return unknown_location();
    }
}

// The type of the storage that slot key `k` names: a local, caller storage or a cell, and the
// fields of its path. Null when a step is no field of a struct.
fn key_type(context* c, state* s, slot_key k) types.node* {
    types.node* mut t = null;
    u64 id = cast(k.id, u64);
    if (k.base == base_kind.local && k.id < fir.local_count(c->f)) {
        t = fir.local_at(c->f, k.id)->ty;
    } else if (k.base == base_kind.caller && id < c->callers_len) {
        t = c->callers[id].pointee;
    } else if (k.base == base_kind.cell && id < s->atoms_len) {
        t = s->atoms[id].ty;
    }
    u32 mut d = 0;
    while (d < k.depth && t != null) {
        if (t->kind != types.type_kind.k_struct || !resolved_struct(t)) { return null; }
        t = fir.struct_field_type(t, k.path[d]);
        d += 1;
    }
    return t;
}

// The atom whose root decides the nullness of pointer value `v`, or NONE.
fn root_atom(value v) u32 {
    if (v.kind == value_kind.owned) { return v.atom; }
    if (v.kind == value_kind.view && v.exact && v.count == 1 && !v.external) {
        return v.sources[0];
    }
    return NONE;
}

// What the state knows of the nullness of pointer value `v`: `null_root`, `nonnull`, or `free`
// when it does not know it. A pointer to caller storage is the pointer that a parameter got,
// so it can be null. A pointer that the witness assumed not null at a dereference is not null.
fn pointer_root(state* s, value v) root_kind {
    root_kind mut r = root_kind.free;
    u32 a = root_atom(v);
    if (v.kind == value_kind.empty) {
        r = root_kind.null_root;
    } else if (v.kind == value_kind.address) {
        r = root_kind.nonnull;
        if (v.target.base == base_kind.caller && (v.target.id >= 64 ||
            (s->nonnull_callers & bit(cast(v.target.id, u64))) == 0)) { r = root_kind.free; }
    } else if (a != NONE) {
        r = s->atoms[cast(a, u64)].root;
        // A root that an unfold assumed is no known nullness until the witness assumes it at a
        // dereference.
        if (r == root_kind.nonnull && s->atoms[cast(a, u64)].unfold_nonnull) {
            r = root_kind.free;
        }
        if (r != root_kind.null_root && s->atoms[cast(a, u64)].assumed_nonnull) {
            r = root_kind.nonnull;
        }
    } else if (v.kind == value_kind.view || v.kind == value_kind.unknown) {
        r = v.nullness;
    }
    if (r == root_kind.null_root && v.kind == value_kind.unknown) { return root_kind.free; }
    if (r == root_kind.null_root || r == root_kind.nonnull) { return r; }
    return root_kind.free;
}

// A dereference that reads or writes storage is a null check (D17.18). A pointer that the state
// knows is null ends the path, as the fault ends the program. At one whose nullness the state
// does not know, the witness assumes that it is not null, and an event that it validates names
// it. The assumption counts on a path without a witness too, as a kept check does. The state
// keeps the assumed fact, so a later dereference of that pointer is no new assumption. `at` is
// the slot of the pointer, or U64_MAX.
fn null_check(context mut* c, state mut* s, value pointer, u64 at, slot_key k) void {
    root_kind known = pointer_root(s, pointer);
    if (known == root_kind.nonnull) { return; }
    if (known == root_kind.null_root) {
        s->reached = false;
        return;
    }
    if (!add_crossed(s, crossed_call{.source = source(c, c->at), .nonnull = true,
        .named = at != U64_MAX, .pointer = k, .write = c->writing})) {
        s->witness = false;
        s->assumptions_full = true;
    }
    u32 a = root_atom(pointer);
    // A dereference of an input owner whose nullness this body does not know: a caller that
    // passes a proved empty owner fails a requirement (D10.7).
    if (a != NONE && s->atoms[cast(a, u64)].handle != NONE &&
        s->atoms[cast(a, u64)].handle_field == NONE && s->atoms[cast(a, u64)].handle < 64) {
        u64 input = bit(cast(s->atoms[cast(a, u64)].handle, u64));
        s->deref_handles = s->deref_handles | input;
        c->deref_inputs = c->deref_inputs | input;
    }
    if (pointer.kind == value_kind.address && pointer.target.base == base_kind.caller &&
        pointer.target.id < 64) {
        s->nonnull_callers = s->nonnull_callers | bit(cast(pointer.target.id, u64));
    } else if (a != NONE) {
        s->atoms[cast(a, u64)].assumed_nonnull = true;
    } else if (at != U64_MAX) {
        s->slots[at].v.nullness = root_kind.nonnull;
    }
}

/// Resolves a FIR place to a location (`spec/fir.md` 5.5). A dereference reads its pointer first.
fn resolve(context mut* c, state mut* s, fir.place p, location mut* out, types.node* mut* ty)
    void {
    *out = unknown_location();
    *ty = fir.place_type(c->f, p);
    out->indirect = fir.place_indirect(c->f, p);
    if (p.base == fir.base_kind.bk_global) { return; }
    location mut loc = location{};
    loc.kind = location_kind.slots;
    loc.key = key_of(base_kind.local, p.local);
    types.node* mut t = fir.local_at(c->f, p.local)->ty;
    u32 mut i = 0;
    while (i < p.proj_len) {
        fir.projection pj = fir.place_projection(c->f, p, i);
        switch (pj.kind) {
        case fir.proj_kind.pj_field:
            if (t->kind == types.type_kind.k_struct) {
                if (loc.kind == location_kind.slots && find_slot(s, loc.key) != U64_MAX &&
                    s->slots[find_slot(s, loc.key)].array) {
                    // A field of a struct below the path bound stays in its array leaf.
                } else if (loc.kind == location_kind.slots && !extend(&loc.key, pj.field)) {
                    loc = unknown_location();
                }
            } else if (pj.field == 1 && loc.kind == location_kind.slots) {
                loc.kind = location_kind.length;
            }
        case fir.proj_kind.pj_deref:
            value mut pointer = unknown_value();
            bool mut pointer_owns = false;
            if (loc.kind == location_kind.slots) {
                u64 pointer_at = find_slot(s, loc.key);
                if (pointer_at != U64_MAX && !s->slots[pointer_at].array) {
                    pointer = s->slots[pointer_at].v;
                    pointer_owns = s->slots[pointer_at].owning;
                }
            } else if (loc.kind == location_kind.element) {
                use_sources(c, s, loc.count, loc.sources, "read through a released source");
            }
            slot_key pointer_key = loc.key;
            u64 mut pointer_slot = loc.kind == location_kind.slots ? find_slot(s, loc.key) :
                U64_MAX;
            if (pointer_slot != U64_MAX && s->slots[pointer_slot].array) { pointer_slot = U64_MAX; }
            // The check reads the nullness before the dereference unfolds the target. Only the
            // last dereference of a destination writes; each one before it reads a pointer.
            bool storing = c->writing;
            u32 mut later = i + 1;
            while (later < p.proj_len) {
                if (fir.place_projection(c->f, p, later).kind == fir.proj_kind.pj_deref) {
                    c->writing = false;
                }
                later += 1;
            }
            if (!c->addressing) { null_check(c, s, pointer, pointer_slot, pointer_key); }
            c->writing = storing;
            // An address computation reads no storage, so it gives no fact about its base. A
            // null base is no error (`spec/fir.md` 14.1). The unfold of a base whose nullness
            // the state does not know marks its root as assumed (`unfold_nonnull`). Such a root
            // removes no path (D17.18).
            u32 base = root_atom(pointer);
            if (c->addressing && (pointer.kind == value_kind.empty || (base != NONE &&
                s->atoms[cast(base, u64)].root == root_kind.null_root))) {
                loc = unknown_location();
            } else {
                loc = deref_value(c, s, pointer, pointer_owns, name(c, s, pointer_key));
            }
            // A pointer of another type than its target (a cast) designates storage whose facts
            // are no facts of the place: reads through it give unknown values, and a store
            // changes the target (`write_at`). A target below a field of another type than a
            // struct has no type here, so it is of another type too (review round 7).
            if (loc.kind == location_kind.slots &&
                key_type(c, s, loc.key) != fir.apply_projection(c->f, t, pj)) {
                slot_key retyped = loc.key;
                loc = unknown_location();
                loc.key = retyped;
                loc.retyped = true;
            }
        case fir.proj_kind.pj_index:
            if (t->kind == types.type_kind.k_array) {
                if (loc.kind == location_kind.slots) {
                    u64 at = find_slot(s, loc.key);
                    if (at == U64_MAX) { loc.kind = location_kind.length; }
                }
            } else {
                value mut header = unknown_value();
                bool mut header_owns = false;
                if (loc.kind == location_kind.slots) {
                    u64 header_at = find_slot(s, loc.key);
                    if (header_at != U64_MAX && !s->slots[header_at].array) {
                        header = s->slots[header_at].v;
                        header_owns = s->slots[header_at].owning;
                    }
                }
                if (header.kind == value_kind.address) {
                    note_param_read(c, header.param);
                    location mut target = location{};
                    target.kind = location_kind.slots;
                    target.key = header.target;
                    u64 at = find_slot(s, header.target);
                    if (at == U64_MAX) { target.kind = location_kind.length; }
                    loc = target;
                } else if (header.kind == value_kind.owned) {
                    location found = deref_atom(c, s, header.atom, name(c, s, loc.key));
                    if (found.kind == location_kind.slots) {
                        loc = unknown_location();
                    } else {
                        loc = found;
                    }
                } else {
                    loc = deref_value(c, s, header, header_owns, name(c, s, loc.key));
                    if (loc.kind == location_kind.slots) { loc = unknown_location(); }
                }
            }
        }
        t = fir.apply_projection(c->f, t, pj);
        i += 1;
    }
    loc.indirect = out->indirect;
    *out = loc;
}

// The value that a location holds. A read through heap storage needs live sources.
fn read_at(context mut* c, state mut* s, location loc, types.node* t) value {
    if (loc.kind == location_kind.slots) {
        u64 at = find_slot(s, loc.key);
        if (at != U64_MAX && !s->slots[at].array) { return s->slots[at].v; }
        return is_reference(t) ? unknown_value() : scalar_value();
    }
    if (loc.kind == location_kind.element) {
        use_sources(c, s, loc.count, loc.sources, "read through a released source");
        // An owned edge from a member of an atom leads to another member of that atom or to
        // nothing, because an atom holds each owned descendant of its members (D17.16,
        // `spec/memory-model.md` 2.7).
        if (is_reference(t) && t->is_own && loc.count > 0) {
            value mut member = empty_value();
            member.kind = value_kind.view;
            member.count = loc.count;
            member.sources = loc.sources;
            member.nullness = root_kind.joined;
            return member;
        }
    }
    return is_reference(t) ? unknown_value() : scalar_value();
}

fn as_view(state* s, value v) value {
    if (v.kind != value_kind.owned) { return v; }
    value mut out = empty_value();
    out.kind = value_kind.view;
    out.count = 1;
    out.sources[0] = v.atom;
    out.exact = true;
    out.nullness = s->atoms[cast(v.atom, u64)].root;
    return out;
}

fn fresh_unknown_owner(state mut* s) value {
    atom mut lost = new_atom(atom_kind.opaque, null, 0, root_kind.joined);
    lost.status = atom_status.unknown;
    return own_value(push_atom(s, lost));
}

/// Evaluates an operand. A copy of an owner lends a view of its atom (D17.4). A move empties its
/// slot and keeps the atom (D17.16).
fn operand(context mut* c, state mut* s, fir.operand op) value {
    if (op.kind == fir.operand_kind.ok_const) {
        switch (op.value.kind) {
        case fir.const_kind.ck_null, fir.const_kind.ck_zero:
            return empty_value();
        case fir.const_kind.ck_string, fir.const_kind.ck_bytes, fir.const_kind.ck_enum_table:
            value mut text = external_view();
            text.nullness = root_kind.nonnull;
            return text;
        case fir.const_kind.ck_bool:
            value mut flag = scalar_value();
            flag.known = true;
            flag.truth = op.value.value.mag != 0;
            return flag;
        case fir.const_kind.ck_int:
            value mut whole = scalar_value();
            if (op.value.value.kind == consts.cval_kind.cv_int) {
                whole.numbered = consts.cv_to_i64(op.value.value, &whole.number);
            }
            return whole;
        default:
            return scalar_value();
        }
    }
    location mut loc = location{};
    types.node* mut t = null;
    resolve(c, s, op.place, &loc, &t);
    value v = read_at(c, s, loc, t);
    if (op.kind == fir.operand_kind.ok_copy) { return as_view(s, v); }
    if (loc.kind == location_kind.slots) {
        u64 at = find_slot(s, loc.key);
        if (at != U64_MAX && !s->slots[at].array) {
            s->slots[at].v = empty_value();
            return v;
        }
    }
    // A move through a pointer of another type changes its target in a way that the proof does
    // not follow.
    if (loc.retyped) { havoc_prefix(s, key_of(loc.key.base, loc.key.id)); }
    if (owned_leaf(t)) {
        unproved(c, s, untracked(s, loc), NONE,
            "the ownership that a move takes from untracked storage");
        return fresh_unknown_owner(s);
    }
    return v;
}

// An owner whose entry value the caller chose freely loses nothing when the caller supplies it
// empty: the summary records that requirement, and the state takes the empty entry value
// (`spec/fir.md` 14 Calls, "empty output owners"). False when the atom has no such handle.
// `settled` says that this path stores over the owner: a store of this body does, and a call
// does when each returning path of its callee does. The path then keeps the requirement.
fn require_empty(context mut* c, state mut* s, u32 a, bool settled) bool {
    atom item = s->atoms[cast(a, u64)];
    if (item.handle == NONE || !item.choice || item.root != root_kind.free ||
        item.status != atom_status.live || cast(item.handle, u64) >= c->interface_len) {
        return false;
    }
    u64 at = cast(item.handle, u64);
    if (item.handle_field == NONE) {
        c->require_null[at] = true;
        if (settled) { s->required_null = s->required_null | bit(at); }
    } else if (cast(item.handle_field, u64) < 64) {
        u64 field = bit(cast(item.handle_field, u64));
        c->require_fields[at] = c->require_fields[at] | field;
        if (settled) { s->required_fields[at] = s->required_fields[at] | field; }
    } else {
        return false;
    }
    s->atoms[cast(a, u64)].root = root_kind.null_root;
    return true;
}

// Checks the old value of an owning destination before a write (D17.11, D17.14). A possibly
// nonnull old owner loses its obligation.
fn check_overwrite(context mut* c, state mut* s, value old, slot_key k) void {
    if (old.kind == value_kind.empty) { return; }
    if (old.kind != value_kind.owned) {
        unproved(c, s, ownership_api.incomplete_reason.unknown_effect, NONE, name(c, s, k));
        return;
    }
    atom item = s->atoms[cast(old.atom, u64)];
    if (item.root == root_kind.null_root || item.status == atom_status.leaked ||
        item.status == atom_status.escaped) { return; }
    if (item.status == atom_status.unknown) {
        unproved(c, s, ownership_api.incomplete_reason.unknown_effect, old.atom, name(c, s, k));
    } else if (require_empty(c, s, old.atom, true)) {
        return;
    } else {
        violation(c, s, ownership_api.event_kind.lost_ownership, certainty_of(item.root),
            old.atom, name(c, s, k));
    }
    mark_leaked(s, old.atom);
}

// A store through a location that the proof does not follow. A pointer of another type than
// its target (a cast) writes bytes that the proof does not follow, perhaps beyond one slot. So
// the storage of the target loses its facts, its owners too. A pointer that the proof does not
// follow can write each storage that a pointer can designate (`havoc_reachable`,
// `spec/toolchain.md` 4.2). A store into a global, or into a field without a slot, writes no
// slot. `owners` says that the store can write over an owner.
fn untracked_store(context mut* c, state mut* s, location loc, bool owners) void {
    if (loc.retyped) { havoc_prefix(s, key_of(loc.key.base, loc.key.id)); }
    if (!loc.indirect) { return; }
    c->writes_untracked = true;
    havoc_reachable(c, s, owners);
}

// Writes a value into a location. An owned value written into storage that the proof does not
// track leaves the proof with incomplete proof (D17.13, D17.18).
fn write_at(context mut* c, state mut* s, location place, types.node* t, value v) void {
    value stored = !is_reference(t) || v.kind != value_kind.owned ? v : as_view(s, v);
    location loc = place;
    bool owners = v.kind == value_kind.owned || owned_leaf(t);
    if (loc.kind == location_kind.unknown) { untracked_store(c, s, loc, owners); }
    if (loc.kind == location_kind.slots) {
        u64 at = find_slot(s, loc.key);
        if (at != U64_MAX && !s->slots[at].array) {
            if (s->slots[at].owning) { check_overwrite(c, s, s->slots[at].v, loc.key); }
            s->slots[at].v = v;
            if (!s->slots[at].owning && v.kind == value_kind.owned) {
                s->slots[at].v = as_view(s, v);
            }
            return;
        }
        // One slot stands for each element of a fixed array of references, so a store joins
        // the stored reference into it.
        if (at != U64_MAX && !s->slots[at].owning && is_reference(t)) {
            s->slots[at].v = weak_reference(s->slots[at].v, stored);
            return;
        }
        if (at == U64_MAX && !is_reference(t) && v.kind != value_kind.owned) { return; }
    }
    if (loc.kind == location_kind.length) { return; }
    if (loc.kind == location_kind.element) {
        use_sources(c, s, loc.count, loc.sources, "write through a released source");
        // A view that does not designate one cell exactly can write any field of each cell that
        // it can designate: the store does not name the field. Storage of the caller that no
        // slot follows is storage that the proof does not follow.
        if (loc.external) { untracked_store(c, s, loc, owners); }
        u32 mut j = 0;
        while (j < loc.count) {
            havoc_cell(s, loc.sources[j], owners);
            j += 1;
        }
        // A field without a slot keeps the stored reference in the facts of its atoms.
        if (is_reference(t) && v.kind != value_kind.owned) {
            u32 mut i = 0;
            while (i < loc.count) {
                atom mut* a = &s->atoms[cast(loc.sources[i], u64)];
                a->borrows = a->borrows || body_reference(stored);
                a->params = a->params || stored.param != NONE;
                i += 1;
            }
        }
    }
    // Storage that the proof does not track cannot keep a reference that this body made or that
    // a caller passed in: no fact would carry it to a return or to a caller.
    if (is_reference(t) && v.kind != value_kind.owned && !static_reference(stored) &&
        (loc.kind == location_kind.unknown || loc.kind == location_kind.slots ||
        (loc.kind == location_kind.element && loc.external))) {
        unproved(c, s, ownership_api.incomplete_reason.unknown_effect, NONE,
            "the reference that this store puts into storage that the proof does not track");
    }
    if (v.kind == value_kind.owned || owned_leaf(t)) {
        unproved(c, s, untracked(s, loc), v.kind == value_kind.owned ? v.atom : NONE,
            "the ownership that this store puts into storage that the proof does not track");
        if (v.kind == value_kind.owned) {
            s->atoms[cast(v.atom, u64)].status = atom_status.escaped;
        }
    }
}

// The leaves of a place, read or moved. A copy of an owned leaf lends a view.
fn place_leaves(context mut* c, state mut* s, fir.place p, bool moving, leaf_list mut* out)
    void {
    location mut loc = location{};
    types.node* mut t = null;
    resolve(c, s, p, &loc, &t);
    leaves_of(t, out);
    u64 mut i = 0;
    while (i < out->len) {
        leaf mut* item = &out->items[i];
        if (loc.kind == location_kind.slots) {
            slot_key mut k = slot_key{};
            u64 at = rebase(loc.key, item->depth, item->path, &k) ? find_slot(s, k) : U64_MAX;
            if (at != U64_MAX && !s->slots[at].array) {
                item->v = s->slots[at].v;
                if (moving) { s->slots[at].v = empty_value(); }
                if (!moving) { item->v = as_view(s, item->v); }
            } else if (item->owning && moving) {
                unproved(c, s, ownership_api.incomplete_reason.unknown_effect, NONE,
                    "the ownership that a move takes from untracked storage");
                item->v = fresh_unknown_owner(s);
            } else {
                item->v = is_reference(item->ty) || item->array ? unknown_value() :
                    scalar_value();
            }
        } else {
            if (loc.kind == location_kind.element && i == 0) {
                use_sources(c, s, loc.count, loc.sources, "read through a released source");
            }
            if (item->owning && moving) {
                unproved(c, s, ownership_api.incomplete_reason.unknown_effect, NONE,
                    "the ownership that a move takes from untracked storage");
                item->v = fresh_unknown_owner(s);
            } else {
                item->v = is_reference(item->ty) || item->array ? unknown_value() :
                    scalar_value();
            }
        }
        i += 1;
    }
}

fn write_leaves(context mut* c, state mut* s, location loc, leaf_list* list) void {
    // A value without a leaf still writes its bytes.
    if (list->len == 0 && loc.kind == location_kind.unknown) { untracked_store(c, s, loc, false); }
    u64 mut i = 0;
    while (i < list->len) {
        leaf item = list->items[i];
        if (loc.kind == location_kind.slots) {
            slot_key mut k = slot_key{};
            location mut at = loc;
            if (!rebase(loc.key, item.depth, item.path, &k)) {
                at = unknown_location();
            } else {
                at.key = k;
            }
            write_at(c, s, at, item.ty, item.v);
        } else {
            write_at(c, s, loc, item.ty, item.v);
        }
        i += 1;
    }
}

// ---- rvalues and statements ------------------------------------------------------------------

fn const_one(fir.operand op) bool {
    return op.kind == fir.operand_kind.ok_const && op.value.kind == fir.const_kind.ck_int &&
        op.value.value.kind == consts.cval_kind.cv_int && !op.value.value.neg &&
        op.value.value.mag == 1;
}

/// Allocates one fresh atom with a nonnull root (D17.16): a cell for one struct with each reference
/// leaf empty, a flat atom without owned leaves, or an opaque atom.
fn allocate(context mut* c, state mut* s, types.node* t, fir.operand count) value {
    operand(c, s, count);
    if (resolved_struct(t) && const_one(count)) {
        atom mut a = new_atom(atom_kind.cell, t, shape_of(c, t), root_kind.nonnull);
        a.fresh = true;
        a.borrows = false;
        a.params = false;
        u32 made = push_atom(s, a);
        add_cell_slots(c, s, made, t);
        u64 mut i = 0;
        while (i < s->slots_len) {
            if (s->slots[i].key.base == base_kind.cell && s->slots[i].key.id == made) {
                s->slots[i].v = empty_value();
            }
            i += 1;
        }
        return own_value(made);
    }
    atom mut a = new_atom(owned_leaf(t) ? atom_kind.opaque : atom_kind.flat, t, 0,
        root_kind.nonnull);
    a.fresh = true;
    // The runtime zeroes a new allocation, so it keeps no reference.
    a.borrows = false;
    a.params = false;
    return own_value(push_atom(s, a));
}

fn is_null_constant(fir.operand op) bool {
    return op.kind == fir.operand_kind.ok_const && (op.value.kind == fir.const_kind.ck_null ||
        op.value.kind == fir.const_kind.ck_zero);
}

// A comparison of a reference with null tests the root of its atom (`spec/toolchain.md` 4.2).
fn null_test(context mut* c, state mut* s, fir.operand a, fir.operand b, bool equal_test)
    value {
    fir.operand subject = is_null_constant(a) ? b : a;
    fir.operand other = is_null_constant(a) ? a : b;
    value seen = operand(c, s, subject);
    operand(c, s, other);
    value mut out = scalar_value();
    if (!is_null_constant(other)) { return out; }
    if (seen.kind == value_kind.empty) {
        out.known = true;
        out.truth = equal_test;
    } else if (seen.kind == value_kind.address) {
        // A pointer to caller storage is the pointer that a parameter got, so it can be null:
        // the test decides nothing, and no assumed fact removes either edge (D17.18).
        if (seen.target.base != base_kind.caller) {
            out.known = true;
            out.truth = !equal_test;
        }
    } else if (seen.kind == value_kind.view && seen.exact && seen.count == 1 && !seen.external) {
        atom item = s->atoms[cast(seen.sources[0], u64)];
        if (item.root == root_kind.null_root ||
            (item.root == root_kind.nonnull && !item.unfold_nonnull)) {
            out.known = true;
            out.truth = (item.root == root_kind.nonnull) != equal_test;
        } else {
            out.test = seen.sources[0];
            out.test_nonnull = !equal_test;
        }
    }
    return out;
}

// A known integer keeps its value only in an integer type that holds it.
fn numbered_in(i64 number, types.node* t) value {
    value mut out = scalar_value();
    if (t == null || !types.type_is_int(t)) { return out; }
    u64 magnitude = number < 0 ? cast(-(number + 1), u64) + 1 : cast(number, u64);
    if (consts.int_fits(consts.int_make(number < 0, magnitude), t->prim)) {
        out.numbered = true;
        out.number = number;
    }
    return out;
}

// The truth value of `a` and `b`, or of `a` or `b` when `either` is true. A known side that
// decides alone gives the result, and a known side that does not decide gives the other side.
fn combined(value a, value b, bool either) value {
    value mut out = scalar_value();
    if ((a.known && a.truth == either) || (b.known && b.truth == either)) {
        out.known = true;
        out.truth = either;
        return out;
    }
    if (a.known && b.known) {
        out.known = true;
        out.truth = !either;
        return out;
    }
    if (a.known) { return b; }
    if (b.known) { return a; }
    return out;
}

// A comparison of two known integers is a known truth value; FIR compares in one type.
fn compare(context mut* c, state mut* s, fir.rvalue rv) value {
    value left = operand(c, s, fir.rvalue_operand(c->f, rv, 0));
    value right = operand(c, s, fir.rvalue_operand(c->f, rv, 1));
    value mut out = scalar_value();
    if (!left.numbered || !right.numbered) { return out; }
    types.node* ty = fir.operand_type(c->f, fir.rvalue_operand(c->f, rv, 0));
    if (ty == null || !types.type_is_int(ty)) { return out; }
    if (!prim.prim_is_signed(ty->prim) && (left.number < 0 || right.number < 0)) { return out; }
    out.known = true;
    switch (rv.kind) {
    case fir.rvalue_kind.rv_eq: out.truth = left.number == right.number;
    case fir.rvalue_kind.rv_ne: out.truth = left.number != right.number;
    case fir.rvalue_kind.rv_lt: out.truth = left.number < right.number;
    case fir.rvalue_kind.rv_le: out.truth = left.number <= right.number;
    case fir.rvalue_kind.rv_gt: out.truth = left.number > right.number;
    case fir.rvalue_kind.rv_ge: out.truth = left.number >= right.number;
    default: out.known = false;
    }
    return out;
}

fn boolean_type(types.node* t) bool {
    return t != null && t->kind == types.type_kind.k_prim && t->prim == prim.prim_kind.prim_bool;
}

/// Evaluates a scalar or reference rvalue.
fn rvalue_value(context mut* c, state mut* s, fir.rvalue rv, types.node* t) value {
    switch (rv.kind) {
    case fir.rvalue_kind.rv_use:
        return operand(c, s, fir.rvalue_operand(c->f, rv, 0));
    case fir.rvalue_kind.rv_eq, fir.rvalue_kind.rv_ne:
        if (is_null_constant(fir.rvalue_operand(c->f, rv, 0)) ||
            is_null_constant(fir.rvalue_operand(c->f, rv, 1)) ||
            is_reference(fir.operand_type(c->f, fir.rvalue_operand(c->f, rv, 0)))) {
            return null_test(c, s, fir.rvalue_operand(c->f, rv, 0),
                fir.rvalue_operand(c->f, rv, 1), rv.kind == fir.rvalue_kind.rv_eq);
        }
        return compare(c, s, rv);
    case fir.rvalue_kind.rv_lt, fir.rvalue_kind.rv_le, fir.rvalue_kind.rv_gt,
        fir.rvalue_kind.rv_ge:
        return compare(c, s, rv);
    case fir.rvalue_kind.rv_add, fir.rvalue_kind.rv_sub:
        value left = operand(c, s, fir.rvalue_operand(c->f, rv, 0));
        value right = operand(c, s, fir.rvalue_operand(c->f, rv, 1));
        value mut sum = scalar_value();
        i64 limit = 1099511627776;
        if (left.numbered && right.numbered && left.number < limit && left.number > -limit &&
            right.number < limit && right.number > -limit) {
            i64 exact = rv.kind == fir.rvalue_kind.rv_add ? left.number + right.number :
                left.number - right.number;
            sum = numbered_in(exact, t);
        }
        return sum;
    case fir.rvalue_kind.rv_and, fir.rvalue_kind.rv_or:
        value first_side = operand(c, s, fir.rvalue_operand(c->f, rv, 0));
        value second_side = operand(c, s, fir.rvalue_operand(c->f, rv, 1));
        // On an integer type the operation works on each bit, and the result is not known here.
        if (!boolean_type(t)) { return scalar_value(); }
        return combined(first_side, second_side, rv.kind == fir.rvalue_kind.rv_or);
    case fir.rvalue_kind.rv_not:
        value mut flipped = operand(c, s, fir.rvalue_operand(c->f, rv, 0));
        // On an integer type `not` complements each bit, so no known number stays.
        if (flipped.kind != value_kind.scalar || !boolean_type(t)) { return scalar_value(); }
        flipped.test_nonnull = !flipped.test_nonnull;
        flipped.truth = !flipped.truth;
        return flipped;
    case fir.rvalue_kind.rv_cast:
        value converted = operand(c, s, fir.rvalue_operand(c->f, rv, 0));
        types.node* from = fir.operand_type(c->f, fir.rvalue_operand(c->f, rv, 0));
        if (!is_reference(t)) {
            if (converted.numbered) { return numbered_in(converted.number, t); }
            return scalar_value();
        }
        if (!is_reference(from)) { return unknown_value(); }
        return converted;
    case fir.rvalue_kind.rv_addr:
        location mut loc = location{};
        types.node* mut place_ty = null;
        c->addressing = true;
        resolve(c, s, rv.place, &loc, &place_ty);
        c->addressing = false;
        if (loc.kind == location_kind.slots) { return address_value(loc.key); }
        if (loc.kind == location_kind.element) {
            value mut inner = empty_value();
            inner.kind = value_kind.view;
            inner.count = loc.count;
            inner.sources = loc.sources;
            inner.external = loc.external;
            inner.nullness = root_kind.nonnull;
            return inner;
        }
        return unknown_value();
    case fir.rvalue_kind.rv_slice:
        operand(c, s, fir.rvalue_operand(c->f, rv, 0));
        operand(c, s, fir.rvalue_operand(c->f, rv, 1));
        location mut sliced = location{};
        types.node* mut sliced_ty = null;
        c->addressing = true;
        resolve(c, s, rv.place, &sliced, &sliced_ty);
        c->addressing = false;
        if (sliced_ty->kind == types.type_kind.k_array) {
            if (sliced.kind == location_kind.slots || sliced.kind == location_kind.length) {
                return address_value(sliced.key);
            }
            return unknown_value();
        }
        return as_view(s, read_at(c, s, sliced, sliced_ty));
    case fir.rvalue_kind.rv_slice_ptr:
        u32 mut k = 0;
        while (k < rv.ops_len) {
            operand(c, s, fir.rvalue_operand(c->f, rv, k));
            k += 1;
        }
        return unknown_value();
    case fir.rvalue_kind.rv_alloc:
        return allocate(c, s, rv.ty, fir.rvalue_operand(c->f, rv, 0));
    case fir.rvalue_kind.rv_aggregate:
        value first = rv.ops_len > 0 ? operand(c, s, fir.rvalue_operand(c->f, rv, 0)) :
            empty_value();
        u32 mut j = 1;
        while (j < rv.ops_len) {
            operand(c, s, fir.rvalue_operand(c->f, rv, j));
            j += 1;
        }
        if (is_reference(t) && !t->is_own) { return as_view(s, first); }
        return first;
    case fir.rvalue_kind.rv_call:
        leaf_list mut results = leaf_list{};
        defer free_leaves(&results);
        call(c, s, rv, t, &results);
        if (results.len > 0) { return results.items[0].v; }
        return is_reference(t) ? unknown_value() : scalar_value();
    default:
        u32 mut n = 0;
        while (n < rv.ops_len) {
            operand(c, s, fir.rvalue_operand(c->f, rv, n));
            n += 1;
        }
        return scalar_value();
    }
}

// The leaves of an aggregate rvalue, read before the destination (`spec/fir.md` 6).
fn rvalue_leaves(context mut* c, state mut* s, fir.rvalue rv, types.node* t, leaf_list mut* out)
    void {
    if (rv.kind == fir.rvalue_kind.rv_use) {
        fir.operand op = fir.rvalue_operand(c->f, rv, 0);
        if (op.kind == fir.operand_kind.ok_const) {
            leaves_of(t, out);
            return;
        }
        place_leaves(c, s, op.place, op.kind == fir.operand_kind.ok_move, out);
        return;
    }
    if (rv.kind == fir.rvalue_kind.rv_call) {
        call(c, s, rv, t, out);
        return;
    }
    leaves_of(t, out);
    if (rv.kind == fir.rvalue_kind.rv_aggregate && resolved_struct(t)) {
        leaf_list mut part = leaf_list{};
        defer free_leaves(&part);
        u32 mut field = 0;
        while (field < rv.ops_len) {
            fir.operand op = fir.rvalue_operand(c->f, rv, field);
            types.node* ft = fir.struct_field_type(t, field);
            if (ft != null && (ft->kind == types.type_kind.k_struct ||
                ft->kind == types.type_kind.k_array) && op.kind != fir.operand_kind.ok_const) {
                place_leaves(c, s, op.place, op.kind == fir.operand_kind.ok_move, &part);
                u64 mut i = 0;
                while (i < part.len) {
                    u64 mut j = 0;
                    while (j < out->len) {
                        leaf item = out->items[j];
                        if (item.depth == part.items[i].depth + 1 && item.path[0] == field) {
                            bool mut same = true;
                            u32 mut d = 0;
                            while (d < part.items[i].depth) {
                                if (item.path[d + 1] != part.items[i].path[d]) { same = false; }
                                d += 1;
                            }
                            if (same) { out->items[j].v = part.items[i].v; }
                        }
                        j += 1;
                    }
                    i += 1;
                }
            } else {
                value v = operand(c, s, op);
                u64 mut j = 0;
                while (j < out->len) {
                    if (out->items[j].depth == 1 && out->items[j].path[0] == field) {
                        out->items[j].v = out->items[j].owning ? v : as_view(s, v);
                        if (!is_reference(out->items[j].ty) && !out->items[j].array) {
                            out->items[j].v = scalar_value();
                        }
                    }
                    j += 1;
                }
            }
            field += 1;
        }
        return;
    }
    u32 mut n = 0;
    while (n < rv.ops_len) {
        operand(c, s, fir.rvalue_operand(c->f, rv, n));
        n += 1;
    }
    u64 mut i = 0;
    while (i < out->len) {
        if (out->items[i].owning) {
            unproved(c, s, ownership_api.incomplete_reason.unknown_effect, NONE,
                "the owned leaves of this aggregate value");
            out->items[i].v = fresh_unknown_owner(s);
        } else if (is_reference(out->items[i].ty) || out->items[i].array) {
            out->items[i].v = unknown_value();
        }
        i += 1;
    }
}

fn aggregate_type(types.node* t) bool {
    return t != null && (t->kind == types.type_kind.k_struct || t->kind == types.type_kind.k_array);
}

fn assign(context mut* c, state mut* s, fir.statement* stmt) void {
    types.node* t = fir.place_type(c->f, stmt->place);
    if (aggregate_type(t)) {
        leaf_list mut list = leaf_list{};
        defer free_leaves(&list);
        rvalue_leaves(c, s, stmt->value, t, &list);
        location mut loc = location{};
        types.node* mut dst_ty = null;
        c->writing = true;
        resolve(c, s, stmt->place, &loc, &dst_ty);
        c->writing = false;
        write_leaves(c, s, loc, &list);
        return;
    }
    value v = rvalue_value(c, s, stmt->value, t);
    location mut loc = location{};
    types.node* mut dst_ty = null;
    c->writing = true;
    resolve(c, s, stmt->place, &loc, &dst_ty);
    c->writing = false;
    write_at(c, s, loc, t, v);
}

/// Releases an owned value (D17.9, D17.16). Del stays shallow: each owned leaf of a released cell
/// must be empty, and a nonempty leaf loses its obligation at this release (D17.16).
fn release(context mut* c, state mut* s, value v, slot_key k) void {
    if (v.kind == value_kind.empty) { return; }
    if (v.kind != value_kind.owned) {
        unproved(c, s, ownership_api.incomplete_reason.unknown_effect, NONE, name(c, s, k));
        return;
    }
    u32 a = v.atom;
    atom item = s->atoms[cast(a, u64)];
    if (item.root == root_kind.null_root) { return; }
    if (item.status != atom_status.live) {
        unproved(c, s, ownership_api.incomplete_reason.unknown_effect, a, name(c, s, k));
        s->atoms[cast(a, u64)].status = atom_status.escaped;
        return;
    }
    c->needs_shape = c->needs_shape | item.origin;
    if (item.kind == atom_kind.region && !unfold(c, s, a)) { return; }
    if (item.kind == atom_kind.opaque) {
        unproved(c, s, ownership_api.incomplete_reason.missing_graph, a,
            "the owned leaves of this allocation empty before its release");
    }
    if (s->atoms[cast(a, u64)].kind == atom_kind.cell) {
        if (!pay(c, s->slots_len)) { return; }
        u64 mut i = 0;
        while (i < s->slots_len) {
            slot field = s->slots[i];
            if (field.key.base == base_kind.cell && field.key.id == a && field.owning) {
                if (field.v.kind == value_kind.owned) {
                    atom child = s->atoms[cast(field.v.atom, u64)];
                    if (field.v.atom == a) {
                        // An owned self-cycle: the leaf still holds the released allocation.
                        violation(c, s, ownership_api.event_kind.lost_ownership,
                            certainty.definite, a, name_below(c, s, k, field.key, item.ty));
                    } else if (child.root != root_kind.null_root &&
                        child.status != atom_status.leaked &&
                        child.status != atom_status.escaped) {
                        string text = name_below(c, s, k, field.key, item.ty);
                        if (child.status == atom_status.unknown) {
                            unproved(c, s, ownership_api.incomplete_reason.unknown_effect,
                                field.v.atom, text);
                            mark_leaked(s, field.v.atom);
                        } else {
                            // A caller requirement cannot repair this intrinsic error of the
                            // body (`spec/fir.md` 14.1): the release itself loses the leaf.
                            violation(c, s, ownership_api.event_kind.lost_ownership,
                                certainty_of(child.root), field.v.atom, text);
                            mark_leaked(s, field.v.atom);
                        }
                    }
                } else if (field.v.kind != value_kind.empty) {
                    unproved(c, s, ownership_api.incomplete_reason.missing_graph, a,
                        name_below(c, s, k, field.key, item.ty));
                }
            }
            i += 1;
        }
        drop_cell_slots(s, a);
    }
    s->atoms[cast(a, u64)].status = atom_status.released;
    s->released = s->released | item.origin;
}

fn release_place(context mut* c, state mut* s, fir.place p) void {
    location mut loc = location{};
    types.node* mut t = null;
    resolve(c, s, p, &loc, &t);
    if (loc.kind == location_kind.slots) {
        u64 at = find_slot(s, loc.key);
        if (at != U64_MAX && !s->slots[at].array) {
            // The translator frees first and then zeroes the place (`spec/toolchain.md` 6
            // item 17), so the release sees the place still full, and the zeroing needs the
            // storage of the place live after the release.
            value v = s->slots[at].v;
            release(c, s, v, loc.key);
            u64 after = find_slot(s, loc.key);
            if (after == U64_MAX) {
                violation(c, s, ownership_api.event_kind.invalid_use, certainty.definite,
                    v.kind == value_kind.owned ? v.atom : NONE, name(c, s, loc.key));
                return;
            }
            s->slots[after].v = empty_value();
            return;
        }
    }
    unproved(c, s, untracked(s, loc), NONE,
        "the release of storage that the proof does not track");
}

// An obligation that an event reported lost: the atom and each atom that it owns. This is the
// transfer of the operation, not a rendering choice (`spec/toolchain.md` 4.2): after the loss no
// owner holds the obligation, so no later operation loses it again. A live atom stays allocated,
// so it becomes leaked and its views stay valid. An unknown atom can be released, so it becomes
// escaped and a read through its views stays unproved.
fn mark_leaked(state mut* s, u32 a) void {
    bool mut@ own seen = new(bool, s->atoms_len);
    defer del(seen);
    owned_from(s, a, seen);
    u64 mut k = 0;
    while (k < seen.len) {
        if (seen[k] && s->atoms[k].status == atom_status.live) {
            s->atoms[k].status = atom_status.leaked;
        } else if (seen[k] && s->atoms[k].status == atom_status.unknown) {
            s->atoms[k].status = atom_status.escaped;
        }
        k += 1;
    }
}

// Ends the storage of one owned slot (D17.14). Its obligation must be empty.
fn end_slot(context mut* c, state mut* s, u64 at) void {
    slot item = s->slots[at];
    if (!item.owning) { return; }
    if (item.v.kind == value_kind.owned) {
        atom a = s->atoms[cast(item.v.atom, u64)];
        if (a.root != root_kind.null_root && (a.status == atom_status.live ||
            a.status == atom_status.unknown)) {
            if (a.status == atom_status.unknown) {
                unproved(c, s, ownership_api.incomplete_reason.unknown_effect, item.v.atom,
                    name(c, s, item.key));
            } else {
                violation(c, s, ownership_api.event_kind.lost_ownership,
                    a.kind == atom_kind.cell ? certainty.definite : certainty_of(a.root),
                    item.v.atom, name(c, s, item.key));
            }
            mark_leaked(s, item.v.atom);
        }
    } else if (item.v.kind != value_kind.empty) {
        unproved(c, s, ownership_api.incomplete_reason.unknown_effect, NONE, name(c, s, item.key));
    }
    s->slots[at].v = empty_value();
}

fn end_local(context mut* c, state mut* s, u32 n) void {
    u64 first = cast(c->local_first[cast(n, u64)], u64);
    u64 mut i = 0;
    while (i < cast(c->local_count[cast(n, u64)], u64)) {
        end_slot(c, s, first + i);
        i += 1;
    }
    s->ended[cast(n, u64)] = 1;
}

fn statement(context mut* c, state mut* s, fir.statement* stmt) void {
    switch (stmt->kind) {
    case fir.stmt_kind.st_assign:
        assign(c, s, stmt);
    case fir.stmt_kind.st_del:
        release_place(c, s, stmt->place);
    case fir.stmt_kind.st_live:
        s->ended[cast(stmt->local, u64)] = 0;
    case fir.stmt_kind.st_dead:
        end_local(c, s, stmt->local);
    default:
        return;
    }
}

// ---- calls -----------------------------------------------------------------------------------

struct argument {
    value v;
    bool aggregate;
    types.node* ty;
    u64 first;
    u64 count;
}

fn find_callee(context* c, ast.sym* symbol) u64 {
    u64 mut i = 0;
    while (i < c->callees.len) {
        if (c->callees[i].symbol == symbol) { return i; }
        i += 1;
    }
    return U64_MAX;
}

// Marks atom `a` and each atom that it owns as taken by an unknown effect.
fn escape(state mut* s, u32 a, atom_status status) void {
    bool mut@ own seen = new(bool, s->atoms_len);
    defer del(seen);
    owned_from(s, a, seen);
    u64 mut k = 0;
    while (k < seen.len) {
        if (seen[k]) {
            if (s->atoms[k].status == atom_status.live) { s->atoms[k].status = status; }
            s->atoms[k].exposed = true;
        }
        k += 1;
    }
}

// Gives each slot below `prefix` an unknown value. An owned leaf keeps an obligation of unknown
// shape, and its old atom escapes. A scalar loses its known value. Returns true when a tracked
// fact changed.
fn havoc_prefix(state mut* s, slot_key prefix) bool {
    bool mut changed = false;
    u64 mut i = 0;
    while (i < s->slots_len) {
        slot item = s->slots[i];
        if (prefix_of(prefix, item.key)) {
            if (item.v.kind == value_kind.owned) {
                atom a = s->atoms[cast(item.v.atom, u64)];
                if (a.status == atom_status.live && a.root != root_kind.null_root) {
                    changed = true;
                }
                escape(s, item.v.atom, atom_status.escaped);
            }
            if (item.owning) {
                s->slots[i].v = fresh_unknown_owner(s);
                changed = true;
            } else if (is_reference(item.ty) || item.array) {
                s->slots[i].v = effect_value();
            } else if (item.v.kind == value_kind.scalar) {
                s->slots[i].v = scalar_value();
            }
        }
        i += 1;
    }
    return changed;
}

// The storage that a value designates: its atoms take the unknown effect.
fn havoc_value(state mut* s, value v) bool {
    bool mut changed = false;
    if (v.kind == value_kind.owned) {
        escape(s, v.atom, atom_status.escaped);
        changed = true;
    } else if (v.kind == value_kind.view) {
        u32 mut i = 0;
        while (i < v.count) {
            u32 a = v.sources[i];
            if (s->atoms[cast(a, u64)].status == atom_status.live) { changed = true; }
            s->atoms[cast(a, u64)].exposed = true;
            // An unknown effect can store any reference in the fields of the atom.
            s->atoms[cast(a, u64)].borrows = true;
            s->atoms[cast(a, u64)].params = true;
            if (s->atoms[cast(a, u64)].kind == atom_kind.cell) {
                if (havoc_prefix(s, key_of(base_kind.cell, a))) { changed = true; }
            }
            if (s->atoms[cast(a, u64)].status == atom_status.live) {
                s->atoms[cast(a, u64)].status = atom_status.unknown;
            }
            i += 1;
        }
    } else if (v.kind == value_kind.address) {
        if (havoc_prefix(s, v.target)) { changed = true; }
        if (v.target.base == base_kind.cell) {
            s->atoms[cast(v.target.id, u64)].exposed = true;
        }
    }
    return changed;
}

// Gives slot `i` the value that a write which the proof does not follow can leave there: a
// reference or an array leaf takes an unknown effect value, and a scalar loses its known value.
// An owner keeps its value unless `owners` is true. A store over an owner that the proof does
// not follow gives incomplete proof where it happens (`write_at`). So a callee with a usable
// summary made no such store.
fn havoc_slot(state mut* s, u64 i, bool owners) void {
    slot item = s->slots[i];
    if (item.owning) {
        if (!owners) { return; }
        if (item.v.kind == value_kind.owned) { escape(s, item.v.atom, atom_status.escaped); }
        s->slots[i].v = fresh_unknown_owner(s);
    } else if (is_reference(item.ty) || item.array) {
        s->slots[i].v = effect_value();
    } else if (item.v.kind == value_kind.scalar) {
        s->slots[i].v = scalar_value();
    }
}

// A write that the proof does not follow into a field of cell `a`. An atom that is no cell has
// no slot.
fn havoc_cell(state mut* s, u32 a, bool owners) void {
    if (s->atoms[cast(a, u64)].kind != atom_kind.cell) { return; }
    u64 mut i = 0;
    while (i < s->slots_len) {
        if (s->slots[i].key.base == base_kind.cell && s->slots[i].key.id == a) {
            havoc_slot(s, i, owners);
        }
        i += 1;
    }
}

// A write that the proof does not follow, in this body, in a callee or in an unknown call. A
// pointer designates a local only when a FIR address names the storage of that local
// (`addressed`). So the write can reach each such local, each caller storage and each cell.
// Each other slot is of a local that no pointer designates (`spec/toolchain.md` 4.2).
fn havoc_reachable(context* c, state mut* s, bool owners) void {
    u64 mut i = 0;
    while (i < s->slots_len) {
        slot_key k = s->slots[i].key;
        if (k.base != base_kind.local ||
            (cast(k.id, u64) < c->addressed.len && c->addressed[cast(k.id, u64)])) {
            havoc_slot(s, i, owners);
        }
        i += 1;
    }
}

/// A call without a complete summary (D17.13, D17.18). It takes each owned argument, and it can
/// change the storage that each reference argument designates, each caller storage, and each
/// exposed atom. Each other storage that a pointer can designate loses its references and its
/// scalars. The result is an obligation of unknown shape. `report` records incomplete proof at
/// the call when a tracked fact changes; a fort callee without a proof reported its own error.
fn unknown_call(context mut* c, state mut* s, argument@ args, leaf_list* arg_leaves,
    types.node* t, leaf_list mut* out, bool report) void {
    c->writes_untracked = true;
    bool mut changed = false;
    u64 mut i = 0;
    while (i < args.len) {
        if (args[i].aggregate) {
            u64 mut j = 0;
            while (j < args[i].count) {
                if (havoc_value(s, arg_leaves->items[args[i].first + j].v)) { changed = true; }
                j += 1;
            }
        } else if (havoc_value(s, args[i].v)) {
            changed = true;
        }
        i += 1;
    }
    i = 0;
    while (i < c->callers_len) {
        if (havoc_prefix(s, key_of(base_kind.caller, cast(i, u32)))) { changed = true; }
        i += 1;
    }
    i = 0;
    while (i < s->atoms_len) {
        atom a = s->atoms[i];
        // An escaped atom left the proof with its storage: its slots change nothing here.
        if (a.used && a.exposed && a.kind == atom_kind.cell && a.status != atom_status.escaped &&
            havoc_prefix(s, key_of(base_kind.cell, cast(i, u32)))) { changed = true; }
        if (a.used && a.exposed && a.status == atom_status.live) {
            s->atoms[i].status = atom_status.unknown;
            s->atoms[i].borrows = true;
            s->atoms[i].params = true;
            changed = true;
        }
        i += 1;
    }
    // The effect can also write each other storage that a pointer can designate. The owners
    // there keep their facts: D17.13 keeps known ownership facts across an extern call, and a
    // fort callee without a usable summary clears the witness.
    havoc_reachable(c, s, false);
    if (changed) {
        c->residual = true;
        s->witness = false;
        if (report) {
            unproved(c, s, ownership_api.incomplete_reason.unknown_effect, NONE,
                "the effects of this call on tracked heap obligations");
        }
    }
    // A call that records no event and has no error of its own covers nothing that it wrote:
    // each reference that an effect wrote is lost again (`spec/fir.md` 14.1).
    if (report && !changed) {
        u64 mut k = 0;
        while (k < s->slots_len) {
            if (s->slots[k].v.kind == value_kind.unknown && s->slots[k].v.exact) {
                s->slots[k].v = unknown_value();
            }
            k += 1;
        }
    }
    leaves_of(t, out);
    i = 0;
    while (i < out->len) {
        if (out->items[i].owning) {
            atom mut result = new_atom(atom_kind.opaque, out->items[i].ty, 0, root_kind.joined);
            result.fresh = true;
            out->items[i].v = own_value(push_atom(s, result));
        } else if (is_reference(out->items[i].ty) || out->items[i].array) {
            out->items[i].v = unknown_value();
        }
        i += 1;
    }
}

// A callee view that reaches storage of its parameter `param` reaches, in the caller, what the
// argument designates: its sources, its caller storage, or its address. Static data keeps no
// parameter and stays external.
fn argument_view(value v, value mut* out, argument@ args) bool {
    if (!v.external || v.param == NONE) { return true; }
    out->external = false;
    if (v.param == ANY_PARAM || v.param == 0 || cast(v.param, u64) > args.len ||
        args[cast(v.param - 1, u64)].aggregate) { return false; }
    value a = args[cast(v.param - 1, u64)].v;
    if (a.kind == value_kind.owned) {
        if (!add_source(out, a.atom)) { return false; }
        out->exact = out->exact && out->count == 1 && v.count == 0;
        return true;
    }
    if (a.kind == value_kind.view) {
        u32 mut i = 0;
        while (i < a.count) {
            if (!add_source(out, a.sources[i])) { return false; }
            i += 1;
        }
        out->external = a.external;
        out->param = a.param;
        out->exact = out->exact && a.exact && v.count == 0 && out->count == 1;
        return true;
    }
    return a.kind == value_kind.empty;
}

fn graft_value(context* c, state* s, value v, u32@ map, slot_key@ prefixes, argument@ args)
    value {
    value mut out = v;
    out.param = NONE;
    // A view of exactly one parameter that held an address is that address in the caller.
    if (v.kind == value_kind.view && v.external && v.count == 0 && v.param != NONE &&
        v.param != ANY_PARAM && v.param > 0 && cast(v.param, u64) <= args.len &&
        !args[cast(v.param - 1, u64)].aggregate &&
        args[cast(v.param - 1, u64)].v.kind == value_kind.address) {
        return args[cast(v.param - 1, u64)].v;
    }
    switch (v.kind) {
    case value_kind.owned:
        u32 owner = map[cast(v.atom, u64)];
        if (owner == NONE) { return empty_value(); }
        out.atom = owner;
        return out;
    case value_kind.view:
        out.count = 0;
        u32 mut i = 0;
        while (i < v.count) {
            u32 source_at = map[cast(v.sources[i], u64)];
            if (source_at != NONE && !add_source(&out, source_at)) { return unknown_value(); }
            i += 1;
        }
        if (!argument_view(v, &out, args)) { return unknown_value(); }
        sort_sources(&out);
        if (out.count != 1) { out.exact = false; }
        if (out.count == 0 && !out.external) {
            return v.count == 0 ? out : empty_value();
        }
        return out;
    case value_kind.address:
        if (v.target.base == base_kind.caller && cast(v.target.id, u64) < prefixes.len) {
            slot_key mut k = slot_key{};
            if (!rebase(prefixes[cast(v.target.id, u64)], v.target.depth, v.target.path, &k)) {
                return unknown_value();
            }
            return address_value(k);
        }
        if (v.target.base == base_kind.cell) {
            u32 cell_at = map[cast(v.target.id, u64)];
            if (cell_at == NONE) { return unknown_value(); }
            out.target.id = cell_at;
            return out;
        }
        return unknown_value();
    case value_kind.scalar:
        return scalar_value();
    case value_kind.unknown:
        // The entry value of a caller slot of the callee is the value of the slot that it
        // designates here, before the call writes caller storage. Any other input of the
        // callee names nothing that this body follows, so it is a lost reference here.
        if (v.external && v.target.base == base_kind.caller &&
            cast(v.target.id, u64) < prefixes.len) {
            slot_key mut k = slot_key{};
            if (rebase(prefixes[cast(v.target.id, u64)], v.target.depth, v.target.path, &k)) {
                u64 at = find_slot(s, k);
                if (at != U64_MAX) { return s->slots[at].v; }
            }
        }
        return v.exact ? effect_value() : unknown_value();
    default:
        return v;
    }
}

// The prefix of the caller storage that an argument designates, or false.
fn designated(state* s, value v, slot_key mut* out) bool {
    if (v.kind == value_kind.address) {
        *out = v.target;
        return true;
    }
    if ((v.kind == value_kind.view && v.exact && v.count == 1 && !v.external) ||
        v.kind == value_kind.owned) {
        u32 a = v.kind == value_kind.owned ? v.atom : v.sources[0];
        if (s->atoms[cast(a, u64)].kind == atom_kind.cell &&
            s->atoms[cast(a, u64)].status == atom_status.live) {
            *out = key_of(base_kind.cell, a);
            return true;
        }
    }
    return false;
}

fn reaches(state* s, u32 from, u32 to) bool {
    bool mut@ own seen = new(bool, s->atoms_len);
    defer del(seen);
    owned_from(s, from, seen);
    return seen[cast(to, u64)];
}

fn uncertain_source(state mut* s) u32 {
    atom mut doubt = new_atom(atom_kind.flat, null, 0, root_kind.nonnull);
    doubt.status = atom_status.maybe_released;
    return push_atom(s, doubt);
}

// Adds a possibly released source to each member view of an atom of `part`: the callee released
// a member that the summary does not name.
fn doubt_members(state mut* s, bool@ part) void {
    u32 mut doubt = NONE;
    u64 mut i = 0;
    while (i < s->slots_len) {
        value mut* v = &s->slots[i].v;
        if (v->kind == value_kind.view && !v->exact) {
            u32 mut j = 0;
            bool mut member = false;
            while (j < v->count) {
                u64 source_at = cast(v->sources[j], u64);
                if (source_at < part.len && part[source_at]) { member = true; }
                j += 1;
            }
            if (member) {
                if (doubt == NONE) { doubt = uncertain_source(s); }
                value mut* after = &s->slots[i].v;
                if (!add_source(after, doubt)) { *after = unknown_value(); }
                sort_sources(after);
            }
        }
        i += 1;
    }
}

// A read through one value needs each of its sources live (D17.14).
fn read_live(context mut* c, state mut* s, value v) bool {
    note_param_read(c, v.param);
    if (v.kind == value_kind.view) {
        return use_sources(c, s, v.count, v.sources, "storage that this call reads");
    }
    if (v.kind == value_kind.address) {
        location loc = deref_value(c, s, v, false, "storage that this call reads");
        return loc.kind != location_kind.unknown;
    }
    // A reference that the proof does not follow can designate released storage, as a read of
    // it in this body would (D17.14).
    if (v.kind == value_kind.unknown) {
        unproved(c, s, ownership_api.incomplete_reason.unknown_effect, NONE,
            "storage that this call reads");
        return false;
    }
    return true;
}

// The atom that holds atom `a` now: a fold absorbs atoms into their parent.
fn current_atom(state* s, u32 a) u32 {
    u32 mut at = a;
    u64 mut steps = 0;
    while (at != NONE && cast(at, u64) < s->atoms_len && !s->atoms[cast(at, u64)].used &&
        s->atoms[cast(at, u64)].into != NONE && steps < s->atoms_len) {
        at = s->atoms[cast(at, u64)].into;
        steps += 1;
    }
    return at;
}

fn current_value(state* s, value v) value {
    value mut out = v;
    if (v.kind == value_kind.owned) {
        out.atom = current_atom(s, v.atom);
    } else if (v.kind == value_kind.view) {
        out.count = 0;
        u32 mut i = 0;
        while (i < v.count) {
            u32 at = current_atom(s, v.sources[i]);
            if (at != v.sources[i]) { out.exact = false; }
            if (!add_source(&out, at)) { return unknown_value(); }
            i += 1;
        }
        sort_sources(&out);
    } else if (v.kind == value_kind.address && v.target.base == base_kind.cell) {
        out.target.id = current_atom(s, v.target.id);
    }
    return out;
}

// The atoms whose storage a value can designate: the sources of a view, or the cell of an
// address.
fn designated_atoms(value v, u32 mut@ out, u64 mut* n) bool {
    if (v.kind == value_kind.view) {
        u32 mut i = 0;
        while (i < v.count) {
            if (*n >= out.len) { return false; }
            out[*n] = v.sources[i];
            *n += 1;
            i += 1;
        }
    } else if (v.kind == value_kind.address && v.target.base == base_kind.cell) {
        if (*n >= out.len) { return false; }
        out[*n] = v.target.id;
        *n += 1;
    }
    return true;
}

// Argument storage stays apart from the atoms that the callee owns or changes (D17.15,
// `spec/fir.md` 14 Calls): caller storage of a heap cell lies outside every bound interface
// atom, and storage that the callee reads lies outside each bound interface atom that it
// releases. An owned edge from the interface atom to the storage gives incomplete proof.
fn separate(context mut* c, state mut* s, summary* sum, argument@ args, leaf_list* arg_leaves,
    slot_key@ prefixes, u32@ bound) bool {
    u32[64] mut found = {};
    u64 mut p = 1;
    while (p <= args.len) {
        // The first `cells` atoms hold caller storage of the callee; the rest are read.
        u64 mut n = 0;
        bool mut complete = true;
        u64 mut k = 0;
        while (k < sum->callers.len) {
            if (cast(sum->callers[k].param, u64) == p && prefixes[k].base == base_kind.cell) {
                if (n < found.len) {
                    found[n] = prefixes[k].id;
                    n += 1;
                } else {
                    complete = false;
                }
            }
            k += 1;
        }
        u64 cells = n;
        bool storage = cells > 0;
        argument arg = args[p - 1];
        if (reads_param(sum, p)) {
            if (arg.aggregate) {
                u64 mut j = 0;
                while (j < arg.count) {
                    if (!designated_atoms(arg_leaves->items[arg.first + j].v, found[..], &n)) {
                        complete = false;
                    }
                    j += 1;
                }
            } else if (!designated_atoms(arg.v, found[..], &n)) {
                complete = false;
            }
        }
        u64 mut i = 0;
        while (i < bound.len) {
            bool releases = i < 64 && (sum->post.released & bit(i)) != 0;
            if (bound[i] != NONE && (storage || releases)) {
                if (!complete) {
                    unproved(c, s, ownership_api.incomplete_reason.unknown_effect, bound[i],
                        "that the arguments of this call are separate");
                    return false;
                }
                u64 mut j = 0;
                while (j < n) {
                    if ((j < cells || releases) && reaches(s, bound[i], found[j])) {
                        unproved(c, s, ownership_api.incomplete_reason.unknown_effect, bound[i],
                            "that the arguments of this call are separate");
                        return false;
                    }
                    j += 1;
                }
            }
            i += 1;
        }
        p += 1;
    }
    return true;
}

/// Applies a summary at a call (D17.16, `spec/fir.md` 14 Calls). The caller binds each interface
/// atom to its actual atom, checks the shape that the callee needs, and grafts the exit facts of
/// caller storage and of the result. False keeps the call unknown.
fn apply(context mut* c, state mut* s, callee* target, argument@ args, leaf_list* arg_leaves,
    types.node* t, leaf_list mut* out, bool check_only) bool {
    summary* sum = target->published;
    u64 interfaces = sum->interface.len;
    if (!pay(c, sum->post.slots_len + sum->post.atoms_len + interfaces + 1)) { return true; }
    // Each argument whose storage the callee reads must be live at the call (D17.14), and so
    // must each reference leaf of a by-value aggregate argument.
    u64 mut r = 0;
    while (r < args.len) {
        if (reads_param(sum, r + 1)) {
            if (args[r].aggregate) {
                u64 mut j = 0;
                while (j < args[r].count) {
                    if (!read_live(c, s, arg_leaves->items[args[r].first + j].v)) {
                        return false;
                    }
                    j += 1;
                }
            } else if (!read_live(c, s, args[r].v)) {
                return false;
            }
        }
        r += 1;
    }
    slot_key mut@ own prefixes = new(slot_key, sum->callers.len);
    defer del(prefixes);
    u64 mut k = 0;
    while (k < sum->callers.len) {
        u64 param = cast(sum->callers[k].param, u64);
        if (param == 0 || param > args.len || args[param - 1].aggregate ||
            !designated(s, args[param - 1].v, &prefixes[k])) { return false; }
        k += 1;
    }
    // The caller storage must have the type that the callee reads. A cast pointer argument of
    // another type designates storage whose layout the summary does not describe, though no
    // slot of the summary names it: a struct of scalars has none (review round 7). Each exit
    // slot of the callee must also name a caller slot of the same type.
    k = 0;
    while (k < prefixes.len) {
        if (key_type(c, s, prefixes[k]) != sum->callers[k].pointee) { return false; }
        k += 1;
    }
    u64 mut q = 0;
    while (q < sum->post.slots_len) {
        slot item = sum->post.slots[q];
        if (item.key.base == base_kind.caller) {
            slot_key mut where = slot_key{};
            if (cast(item.key.id, u64) >= prefixes.len ||
                !rebase(prefixes[cast(item.key.id, u64)], item.key.depth, item.key.path, &where)) {
                return false;
            }
            u64 at = find_slot(s, where);
            if (at == U64_MAX || s->slots[at].ty != item.ty || s->slots[at].array != item.array) {
                return false;
            }
        }
        q += 1;
    }
    u32 mut@ own bound = new(u32, interfaces);
    defer del(bound);
    u64 mut i = 0;
    while (i < interfaces) {
        interface_entry e = sum->interface[i];
        value mut v = unknown_value();
        if (e.key.base == base_kind.local) {
            u64 param = cast(e.key.id, u64);
            if (param == 0 || param > args.len) { return false; }
            argument arg = args[param - 1];
            if (!arg.aggregate && e.key.depth == 0) {
                v = arg.v;
            } else if (arg.aggregate) {
                u64 mut j = 0;
                while (j < arg.count) {
                    leaf item = arg_leaves->items[arg.first + j];
                    slot_key mut lk = slot_key{};
                    lk.depth = item.depth;
                    lk.path = item.path;
                    slot_key mut ek = e.key;
                    ek.base = base_kind.local;
                    ek.id = 0;
                    lk.base = base_kind.local;
                    if (same_key(lk, ek)) { v = item.v; }
                    j += 1;
                }
            }
        } else {
            slot_key mut where = slot_key{};
            if (!rebase(prefixes[cast(e.key.id, u64)], e.key.depth, e.key.path, &where)) {
                return false;
            }
            u64 at = find_slot(s, where);
            if (at == U64_MAX || s->slots[at].array) { return false; }
            v = s->slots[at].v;
        }
        if (v.kind == value_kind.owned) {
            bound[i] = v.atom;
        } else if (v.kind == value_kind.empty) {
            bound[i] = NONE;
        } else {
            return false;
        }
        i += 1;
    }
    // Two caller storage arguments with owned leaves must not overlap, and a cell argument must
    // stay apart from each owned argument (fir.md 14 Calls).
    k = 0;
    while (k < prefixes.len) {
        u64 mut m = k + 1;
        while (m < prefixes.len) {
            if (prefix_of(prefixes[k], prefixes[m]) || prefix_of(prefixes[m], prefixes[k])) {
                unproved(c, s, ownership_api.incomplete_reason.unknown_effect, NONE,
                    "that the caller storage arguments of this call are separate");
                return false;
            }
            m += 1;
        }
        k += 1;
    }
    if (!separate(c, s, sum, args, arg_leaves, prefixes[..], bound[..])) { return false; }
    // The witness crosses the call: it assumes that the callee returns, and nothing proves it.
    // Each event that it validates from here on names the call, a failed requirement of this
    // call too (D17.18, `spec/toolchain.md` 4.2). A witness that crosses more calls than it
    // can name validates nothing.
    if (s->witness && !add_crossed(s, crossed_call{.source = source(c, c->at),
        .callee = target->symbol == null ? "" : target->symbol->name})) {
        s->witness = false;
        s->assumptions_full = true;
    }
    // The empty owners that the callee requires (`spec/fir.md` 14 Calls, "empty output
    // owners"). A caller owner that is its own entry value passes the requirement on to its own
    // caller. A failed requirement reports the owner that the callee overwrites and marks it
    // lost. The call then applies: the callee stores over the owner and returns in the same way,
    // so a later independent error keeps its own event (`spec/toolchain.md` 4.2). A failure is
    // validated only when each returning path of the callee stores over the owner; otherwise it
    // is incomplete proof.
    i = 0;
    while (i < interfaces) {
        interface_entry e = sum->interface[i];
        if (bound[i] != NONE && (e.require_null || e.require_fields != 0)) {
            bool settled_null = (sum->post.required_null & bit(i)) != 0;
            u64 settled_fields = sum->post.required_fields[i];
            check_required(c, s, bound[i], e, settled_null, settled_fields);
        }
        i += 1;
    }
    // A proved empty owner that reaches a dereference in the callee is a failed caller
    // requirement (D10.7). It ends no path: the call goes on as for another failed requirement.
    // The failure is validated only when each returning path of the callee dereferences the
    // input; otherwise it is incomplete proof. An owner that is empty on some path into this
    // state (a joined root) gives incomplete proof. An input of this body whose nullness it does
    // not know passes the requirement on to its own callers.
    i = 0;
    while (i < interfaces && i < 64) {
        if ((sum->deref_inputs & bit(i)) != 0) {
            bool must = (sum->post.deref_handles & bit(i)) != 0;
            atom held = bound[i] == NONE ? atom{} : s->atoms[cast(bound[i], u64)];
            if (bound[i] == NONE || held.root == root_kind.null_root) {
                violation(c, s, ownership_api.event_kind.caller_requirement,
                    must ? certainty.definite : certainty.possible, NONE,
                    "the empty owner that the callee dereferences");
            } else if (held.root == root_kind.joined) {
                violation(c, s, ownership_api.event_kind.caller_requirement, certainty.possible,
                    bound[i], "the owner that the callee dereferences");
            } else if (held.root == root_kind.free && held.handle != NONE &&
                held.handle_field == NONE && held.handle < 64) {
                u64 input = bit(cast(held.handle, u64));
                if (must) { s->deref_handles = s->deref_handles | input; }
                c->deref_inputs = c->deref_inputs | input;
            }
        }
        i += 1;
    }
    // The shape that the callee needs (`spec/memory-model.md` 2.7).
    i = 0;
    while (i < interfaces) {
        interface_entry e = sum->interface[i];
        if (bound[i] != NONE && e.needs_shape) {
            u32 a = bound[i];
            if (s->atoms[cast(a, u64)].status != atom_status.live) {
                unproved(c, s, ownership_api.incomplete_reason.unknown_effect, a,
                    "the allocation that this call needs");
                return false;
            }
            // A cell of a struct that owns nothing is one flat allocation: its fields hold no
            // obligation, so only the facts of its fields go (`spec/memory-model.md` 2.7).
            if (e.kind == atom_kind.flat && s->atoms[cast(a, u64)].kind == atom_kind.cell &&
                !owned_leaf(s->atoms[cast(a, u64)].ty)) {
                s->atoms[cast(a, u64)].borrows = member_refs(s, a, false);
                s->atoms[cast(a, u64)].params = member_refs(s, a, true);
                drop_cell_slots(s, a);
                s->atoms[cast(a, u64)].kind = atom_kind.flat;
                s->atoms[cast(a, u64)].shape = 0;
            }
            if (e.kind == atom_kind.region && s->atoms[cast(a, u64)].kind == atom_kind.cell &&
                !fold(c, s, a)) {
                if (!c->stopped) {
                    unproved(c, s, ownership_api.incomplete_reason.missing_graph, a,
                        "the shape that this call needs");
                }
                return false;
            }
            atom x = s->atoms[cast(a, u64)];
            bool fits = (e.kind == atom_kind.region && x.kind == atom_kind.region &&
                x.ty == e.ty) || (e.kind == atom_kind.flat && x.kind == atom_kind.flat) ||
                e.kind == atom_kind.opaque;
            if (!fits) {
                unproved(c, s, ownership_api.incomplete_reason.missing_graph, a,
                    "the shape that this call needs");
                return false;
            }
            if (target->member && e.kind != atom_kind.opaque && !x.strict) {
                unproved(c, s, ownership_api.incomplete_reason.missing_graph, a,
                    "that this recursive call takes a strict part of the input");
                return false;
            }
            c->needs_shape = c->needs_shape | x.origin;
        }
        i += 1;
    }
    // The folds above absorb atoms: the arguments name their current atoms from here on.
    argument mut@ own now = new(argument, args.len);
    defer del(now);
    i = 0;
    while (i < args.len) {
        now[i] = args[i];
        now[i].v = current_value(s, args[i].v);
        i += 1;
    }
    // A residual provisional summary of a member names its reasons above and applies nothing.
    if (check_only) { return false; }
    // A recursive call needs a covered return (`spec/fir.md` 14.1): without one, no complete
    // summary covers its prefix, as the ratified reading of the recursive solver requires.
    if (!sum->returns) {
        if (target->member && c->reporting) {
            unproved(c, s, ownership_api.incomplete_reason.unknown_effect, NONE,
                "a return of this recursive call");
            return false;
        }
        s->reached = false;
        return true;
    }
    // A reference of the callee's inputs that it keeps in a field without a slot is, here, a
    // reference that the arguments reach: an argument itself, a reference in storage that it
    // designates, or one in an owned argument. `arg_body` says that one of those can be a
    // reference of this body.
    bool arg_body = arguments_reach_body(s, now[..], arg_leaves);
    // Graft the exit facts (`spec/fir.md` 14 Calls). An interface atom keeps its identity only when
    // an exit slot owns it.
    u64 origins = sum->post.atoms_len;
    bool mut@ own owned_in_post = new(bool, origins + 1);
    defer del(owned_in_post);
    i = 0;
    while (i < sum->post.slots_len) {
        value v = sum->post.slots[i].v;
        if (v.kind == value_kind.owned) { owned_in_post[cast(v.atom, u64)] = true; }
        i += 1;
    }
    u32 mut@ own map = new(u32, origins + 1);
    defer del(map);
    i = 0;
    while (i < origins) { map[i] = NONE; i += 1; }
    u64 mut released_here = 0;
    i = 0;
    while (i < interfaces) {
        if (bound[i] != NONE && (sum->post.released & bit(i)) != 0) {
            released_here = released_here | s->atoms[cast(bound[i], u64)].origin;
        }
        i += 1;
    }
    // A contradiction first: the exit record of an input is its entry value on each returning path.
    // Each returning path can have that input null while this body passes a root that it
    // established nonnull. The callee then does not return for these arguments, and the path ends
    // (`spec/fir.md` 14.1, A06: a complete no-return proof removes the return continuation). A
    // nonnull exit root can come from an unfold that the callee assumed, so a null argument ends no
    // path (D17.18: no assumed fact removes a path). A required empty owner has a null exit root
    // because the callee stores over it, not because a return needs it: a caller that breaks the
    // requirement still returns. A free input choice of this body needs no refinement here: no exit
    // slot owns a null root, so the graft below gives the argument a null root.
    i = 0;
    while (i < interfaces) {
        atom p = sum->post.atoms[i];
        if (p.used && !sum->interface[i].require_null) {
            u32 b = bound[i];
            bool nonnull_here = b != NONE && !s->atoms[cast(b, u64)].unfold_nonnull &&
                (s->atoms[cast(b, u64)].root == root_kind.nonnull ||
                s->atoms[cast(b, u64)].kind == atom_kind.cell);
            if (p.root == root_kind.null_root && nonnull_here) {
                if (target->member && c->reporting) {
                    unproved(c, s, ownership_api.incomplete_reason.unknown_effect, NONE,
                        "a return of this recursive call");
                    return false;
                }
                s->reached = false;
                return true;
            }
        }
        i += 1;
    }
    i = 0;
    while (i < origins) {
        atom p = sum->post.atoms[i];
        if (i < interfaces) {
            if (bound[i] != NONE && p.used && owned_in_post[i]) {
                u32 b = bound[i];
                map[i] = b;
                // A drop of the slots of a cell bound to an opaque entry reads them first.
                bool slot_borrows = member_refs(s, b, false);
                bool slot_params = member_refs(s, b, true);
                // A cell bound to a region entry is folded above, and one bound to a flat entry
                // owns nothing. A cell bound to an opaque entry can still own members when the
                // callee released the entry: a member of the component under solution applies
                // without a proof. Those members belong to `b` in the exit facts (`retire`).
                if (sum->interface[i].needs_shape) {
                    bool mut@ own part = new(bool, s->atoms_len);
                    owned_from(s, b, part);
                    part[cast(b, u64)] = false;
                    k = 0;
                    while (k < part.len) {
                        if (part[k]) { redirect_add(s, cast(k, u32), b); }
                        k += 1;
                    }
                    retire(s, part[..], NONE, true, (sum->post.released & bit(i)) != 0, false);
                    del(part);
                    drop_cell_slots(s, b);
                }
                atom mut* x = &s->atoms[cast(b, u64)];
                if (sum->interface[i].needs_shape) {
                    x->kind = p.kind;
                    x->ty = p.ty;
                    // Template indices belong to one context, so the caller finds its own.
                    x->shape = p.shape == 0 ? 0 : shape_of(c, p.ty);
                    x->status = p.status;
                    x->fresh = x->fresh || p.fresh;
                    x->strict = x->strict && p.strict;
                    x->choice = false;
                    x->empty_leaves = p.empty_leaves;
                    // A reference of the callee's inputs is one that the arguments reach here.
                    x->borrows = x->borrows || slot_borrows || p.borrows || (p.params && arg_body);
                    x->params = x->params || slot_params || p.params;
                    // The callee changed the fields, so a later unfold names no entry field.
                    x->handle = NONE;
                }
                // A `joined` exit root says that the returning paths of the callee do not take
                // each value of this input apart from the values of another, so a free input
                // choice of this body is no free choice after the call (`choice_split`,
                // `spec/toolchain.md` 4.2).
                if (p.root == root_kind.nonnull) {
                    // A root that the callee assumed at an unfold stays an assumed root here.
                    bool known_here = x->root == root_kind.nonnull && !x->unfold_nonnull;
                    x->root = root_kind.nonnull;
                    x->unfold_nonnull = !known_here && p.unfold_nonnull;
                } else if (sum->interface[i].needs_shape) {
                    x->root = join_root(x->root, root_kind.joined);
                } else if (p.root == root_kind.joined && x->root == root_kind.free) {
                    x->root = root_kind.joined;
                }
            }
        } else if (p.used) {
            atom mut made = p;
            made.origin = 0;
            made.strict = p.strict;
            made.fresh = p.fresh;
            made.borrows = p.borrows || (p.params && arg_body);
            made.params = p.params;
            u64 mut b = 0;
            bool mut any = false;
            while (b < interfaces) {
                if ((p.origin & bit(b)) != 0 && bound[b] != NONE) {
                    atom from = s->atoms[cast(bound[b], u64)];
                    made.origin = made.origin | from.origin;
                    made.fresh = made.fresh || from.fresh;
                    made.strict = made.strict && from.strict;
                    any = true;
                }
                b += 1;
            }
            if (!any) { made.strict = false; }
            if (made.root == root_kind.free) { made.root = root_kind.joined; }
            made.shape = p.shape == 0 ? 0 : shape_of(c, p.ty);
            made.choice = false;
            made.exposed = false;
            // A handle of the callee names the callee's interface, never the caller's.
            made.handle = NONE;
            made.handle_field = NONE;
            made.into = NONE;
            map[i] = push_atom(s, made);
        }
        i += 1;
    }
    // An interface atom that no exit slot owns: its members stay in the exit atoms that name
    // it in their origin, or the callee released them, or each returning path had a null root.
    // The exit state joins each returning path, so `released` there is a fact of each path and
    // `maybe_released` or a bit of `released` is a fact of some path (`spec/toolchain.md` 4.2).
    i = 0;
    while (i < interfaces) {
        u32 b = bound[i];
        if (b != NONE) {
            atom rec = sum->post.atoms[i];
            bool rel_root = rec.used && rec.status == atom_status.released;
            bool rel = (sum->post.released & bit(i)) != 0 || (rec.used &&
                (rec.status == atom_status.released || rec.status == atom_status.maybe_released));
            if (!owned_in_post[i]) {
                // The interface atom holds `b` and each atom that `b` owns here.
                bool mut@ own part = new(bool, s->atoms_len);
                owned_from(s, b, part);
                u64 mut kept = 0;
                u64 mut j = 0;
                while (j < origins) {
                    atom other = sum->post.atoms[j];
                    if (j != i && other.used && other.root != root_kind.null_root &&
                        (other.origin & bit(i)) != 0 && map[j] != NONE) {
                        k = 0;
                        while (k < part.len) {
                            if (part[k]) { redirect_add(s, cast(k, u32), map[j]); }
                            k += 1;
                        }
                        kept += 1;
                    }
                    j += 1;
                }
                if (kept > 0 || rel) {
                    retire(s, part[..], b, kept > 0, rel, rel_root);
                } else if (rec.used && rec.status == atom_status.leaked) {
                    mark_leaked(s, b);
                } else if (s->atoms[cast(b, u64)].status != atom_status.leaked &&
                    s->atoms[cast(b, u64)].status != atom_status.escaped) {
                    // A lost owner that the callee stored over keeps its allocation.
                    s->atoms[cast(b, u64)].root = root_kind.null_root;
                }
                del(part);
            } else if (rel) {
                bool mut@ own one = new(bool, s->atoms_len);
                one[cast(b, u64)] = true;
                doubt_members(s, one[..]);
                del(one);
            }
        }
        i += 1;
    }
    s->released = s->released | released_here;
    // Cell slots of grafted cells.
    i = c->fixed_len;
    u64 post_fixed = sum->post.slots_len;
    u64 mut j = 0;
    while (j < post_fixed) {
        slot item = sum->post.slots[j];
        if (item.key.base == base_kind.cell && map[cast(item.key.id, u64)] != NONE) {
            u32 owner = map[cast(item.key.id, u64)];
            bool fresh_cell = cast(item.key.id, u64) >= interfaces ||
                sum->interface[cast(item.key.id, u64)].needs_shape;
            if (fresh_cell) {
                slot mut copy = item;
                copy.key.id = owner;
                copy.v = graft_value(c, s, item.v, map[..], prefixes[..], now[..]);
                u64 at = find_slot(s, copy.key);
                if (at == U64_MAX) {
                    push_slot(s, copy);
                } else {
                    s->slots[at].v = copy.v;
                }
            }
        }
        j += 1;
    }
    // The result, and then caller storage, take the exit values of the callee. Each value is
    // read before the first write, so an entry value of the callee names the caller value from
    // before the call.
    leaves_of(t, out);
    i = 0;
    while (i < out->len) {
        slot_key mut want = key_of(base_kind.local, 0);
        want.depth = out->items[i].depth;
        want.path = out->items[i].path;
        u64 at = find_slot(&sum->post, want);
        if (at != U64_MAX) {
            out->items[i].v = graft_value(c, s, sum->post.slots[at].v, map[..], prefixes[..],
                now[..]);
        } else if (out->items[i].owning) {
            out->items[i].v = empty_value();
        } else if (is_reference(out->items[i].ty)) {
            out->items[i].v = unknown_value();
        }
        i += 1;
    }
    u64 mut@ own slot_of_write = new(u64, post_fixed + 1);
    defer del(slot_of_write);
    value mut@ own written = new(value, post_fixed + 1);
    defer del(written);
    j = 0;
    while (j < post_fixed) {
        slot item = sum->post.slots[j];
        slot_of_write[j] = U64_MAX;
        if (item.key.base == base_kind.caller) {
            slot_key mut where = slot_key{};
            if (rebase(prefixes[cast(item.key.id, u64)], item.key.depth, item.key.path, &where)) {
                u64 at = find_slot(s, where);
                // A borrowed array slot takes the exit value that stands for each element.
                if (at != U64_MAX && (!s->slots[at].array || !s->slots[at].owning)) {
                    slot_of_write[j] = at;
                    written[j] = graft_value(c, s, item.v, map[..], prefixes[..], now[..]);
                }
            }
        }
        j += 1;
    }
    j = 0;
    while (j < post_fixed) {
        if (slot_of_write[j] != U64_MAX) { s->slots[slot_of_write[j]].v = written[j]; }
        j += 1;
    }
    return true;
}

// Retires `b` and each atom of `part`, which holds `b` and the atoms that `b` owns. The callee
// moved some of their storage into the exit atoms that name `b` in their origin (`moved`), or
// released some of it (`released`). No record of them holds an obligation from here on:
// `canonical` keeps a record only for an address of one of its fields.
// When no exit atom holds any of their storage, each returning path released it or had a null
// root: a move keeps the origin, and a callee that loses an owner has no usable summary. So
// each record is released. Otherwise the root is released when each returning path released it
// (`root_released`); a record is possibly released when some path released a member, and it
// left the proof with its storage when no path did (`spec/toolchain.md` 4.2).
fn retire(state mut* s, bool@ part, u32 b, bool moved, bool released, bool root_released) void {
    if (moved) {
        if (released) { doubt_members(s, part); }
        u64 mut k = 0;
        while (k < part.len) {
            if (part[k]) { redirect(s, cast(k, u32), NONE, false); }
            k += 1;
        }
    }
    u64 mut k = 0;
    while (k < part.len) {
        if (part[k]) {
            u32 r = cast(k, u32);
            drop_cell_slots(s, r);
            atom_status was = s->atoms[k].status;
            if (was == atom_status.live || was == atom_status.unknown) {
                if (!moved || (r == b && root_released)) {
                    s->atoms[k].status = atom_status.released;
                } else if (released) {
                    s->atoms[k].status = atom_status.maybe_released;
                } else {
                    s->atoms[k].status = atom_status.escaped;
                }
            }
            if (moved || r != b) { s->atoms[k].used = false; }
        }
        k += 1;
    }
}

// One empty owner that a callee requires: the bound atom, or one owned field of its root. False
// when the requirement fails: the event names the owner, and the owner is lost because the
// callee stores over it. `settled` says that each returning path of the callee stores over it.
// Without it, no path of this body validates the failure.
fn require_one(context mut* c, state mut* s, u32 a, bool settled, string text) bool {
    atom item = s->atoms[cast(a, u64)];
    if (item.root == root_kind.null_root || item.status == atom_status.leaked ||
        item.status == atom_status.escaped) { return true; }
    if (item.status == atom_status.unknown) {
        unproved(c, s, ownership_api.incomplete_reason.unknown_effect, a, text);
        mark_leaked(s, a);
        return false;
    }
    if (require_empty(c, s, a, settled)) { return true; }
    certainty how = !settled ? certainty.possible :
        (item.kind == atom_kind.cell ? certainty.definite : certainty_of(item.root));
    violation(c, s, ownership_api.event_kind.caller_requirement, how, a, text);
    mark_leaked(s, a);
    return false;
}

fn check_required(context mut* c, state mut* s, u32 b, interface_entry e, bool settled_null,
    u64 settled_fields) void {
    if (e.require_null) {
        require_one(c, s, b, settled_null, "an empty owner that this call requires");
        return;
    }
    // A lost field leaves the field: the callee stores over it, so the shape that the callee
    // needs no longer holds it.
    atom item = s->atoms[cast(b, u64)];
    if (item.root == root_kind.null_root) { return; }
    if (item.kind != atom_kind.cell) {
        // The fields of an unchanged entry value of the caller are its own entry fields.
        if (item.handle != NONE && item.handle_field == NONE && item.choice &&
            item.status == atom_status.live && cast(item.handle, u64) < c->interface_len) {
            u64 at = cast(item.handle, u64);
            c->require_fields[at] = c->require_fields[at] | e.require_fields;
            s->required_fields[at] = s->required_fields[at] | (e.require_fields & settled_fields);
            return;
        }
        unproved(c, s, ownership_api.incomplete_reason.missing_graph, b,
            "the empty owned fields that this call requires");
        return;
    }
    u64 mut i = 0;
    while (i < s->slots_len) {
        slot field = s->slots[i];
        if (field.key.base == base_kind.cell && field.key.id == b && field.key.depth == 1 &&
            field.key.path[0] < 64 && (e.require_fields & bit(cast(field.key.path[0], u64))) != 0) {
            if (field.v.kind == value_kind.owned) {
                bool settled = (settled_fields & bit(cast(field.key.path[0], u64))) != 0;
                if (!require_one(c, s, field.v.atom, settled,
                    "an empty owned field that this call requires")) {
                    s->slots[i].v = empty_value();
                }
            } else if (field.v.kind != value_kind.empty) {
                unproved(c, s, ownership_api.incomplete_reason.unknown_effect, b,
                    "the empty owned fields that this call requires");
            }
        }
        i += 1;
    }
}

// Adds source `to` to each view that has source `from`.
fn redirect_add(state mut* s, u32 from, u32 to) void {
    u64 mut i = 0;
    while (i < s->slots_len) {
        value mut* v = &s->slots[i].v;
        if (v->kind == value_kind.view) {
            u32 mut j = 0;
            bool mut found = false;
            while (j < v->count) {
                if (v->sources[j] == from) { found = true; }
                j += 1;
            }
            if (found) {
                if (!add_source(v, to)) {
                    *v = unknown_value();
                } else {
                    v->exact = false;
                    sort_sources(v);
                }
            }
        }
        i += 1;
    }
}

/// Evaluates a call (`spec/fir.md` 6). The arguments are read in order, then a complete
/// summary applies, or the call is unknown (D17.13, D17.18).
fn call(context mut* c, state mut* s, fir.rvalue rv, types.node* t, leaf_list mut* out) void {
    argument mut@ own args = new(argument, cast(rv.ops_len, u64));
    defer del(args);
    leaf_list mut arg_leaves = leaf_list{};
    defer free_leaves(&arg_leaves);
    leaf_list mut part = leaf_list{};
    defer free_leaves(&part);
    if (rv.callee == fir.callee_kind.cl_value) { operand(c, s, rv.callee_op); }
    u32 mut i = 0;
    while (i < rv.ops_len) {
        fir.operand op = fir.rvalue_operand(c->f, rv, i);
        types.node* ty = fir.operand_type(c->f, op);
        argument mut arg = argument{};
        arg.ty = ty;
        if (aggregate_type(ty) && op.kind != fir.operand_kind.ok_const) {
            place_leaves(c, s, op.place, op.kind == fir.operand_kind.ok_move, &part);
            arg.aggregate = true;
            arg.first = arg_leaves.len;
            arg.count = part.len;
            u64 mut j = 0;
            while (j < part.len) {
                push_leaf(&arg_leaves, part.items[j]);
                j += 1;
            }
        } else {
            arg.v = operand(c, s, op);
        }
        args[cast(i, u64)] = arg;
        i += 1;
    }
    reset(out);
    if (c->stopped || !s->reached) { return; }
    u64 found = rv.callee == fir.callee_kind.cl_fn ? find_callee(c, rv.callee_sym) : U64_MAX;
    if (found != U64_MAX) {
        callee* target = &c->callees[found];
        summary* sum = target->published;
        bool usable = sum != null && sum->known && !sum->residual &&
            (target->member || ownership_api.successful(sum->proof));
        // A published fort body without a proof reported its own error (`spec/fir.md` 14.1).
        bool own_error = sum != null && sum->known && !usable && !target->member;
        u64 before = c->notes;
        if (usable && apply(c, s, target, args[..], &arg_leaves, t, out, false)) {
            // A callee that writes untracked can write each storage that a pointer can
            // designate, and its summary does not name that write.
            if (sum->writes_untracked) {
                c->writes_untracked = true;
                havoc_reachable(c, s, false);
            }
            return;
        }
        // A member call still checks its binding, so its own reason names the call.
        if (!usable && target->member && sum != null && sum->known) {
            apply(c, s, target, args[..], &arg_leaves, t, out, true);
        }
        reset(out);
        // A fort callee without a usable summary can fail to return, so no later operation of
        // this path has a validated witness (`spec/fir.md` 14.1, A06).
        s->witness = false;
        unknown_call(c, s, args[..], &arg_leaves, t, out, !own_error && c->notes == before);
        return;
    }
    // A call of a function value is a call of unknown fort targets here. An extern call
    // returns (D17.13), so it keeps the witness.
    if (rv.callee != fir.callee_kind.cl_extern) { s->witness = false; }
    unknown_call(c, s, args[..], &arg_leaves, t, out, true);
}

// ---- blocks, returns, and the body -----------------------------------------------------------

// Refines one edge of a null test (`spec/toolchain.md` 4.2). False when the edge contradicts the
// state. A test of a joined root, or of an untracked condition, clears the witness of the edge.
fn refine(state mut* s, value cond, bool truth) bool {
    if (cond.kind == value_kind.scalar && cond.known) { return cond.truth == truth; }
    if (cond.kind != value_kind.scalar || cond.test == NONE) {
        s->witness = false;
        return true;
    }
    atom mut* a = &s->atoms[cast(cond.test, u64)];
    bool nonnull = truth == cond.test_nonnull;
    if (nonnull) {
        if (a->root == root_kind.null_root) { return false; }
        if (a->root == root_kind.joined) { s->witness = false; }
        a->root = root_kind.nonnull;
        // The test establishes what an unfold assumed.
        a->unfold_nonnull = false;
        return true;
    }
    // A root that an unfold assumed nonnull removes no path: the null edge stays, without a
    // witness, because the state still holds the unfolded cell (D17.18).
    if (a->unfold_nonnull) {
        s->witness = false;
        return true;
    }
    if (a->root == root_kind.nonnull || a->kind == atom_kind.cell) { return false; }
    if (a->root == root_kind.joined) { s->witness = false; }
    a->root = root_kind.null_root;
    return true;
}

// The checks that `--release` removes: overflow, shift and overwrite (`spec/fir.md` 8). Their
// continuation stays feasible in that build, so a failure keeps the witness. `--no-bounds-check`
// removes bounds and span checks too, but that flag is unsafe (D10.6), so those stay kept
// checks. A kept check ends the path only when it fails for the values that the state knows
// (`spec/toolchain.md` 4.2).
fn removable(fir.check_kind k) bool {
    return k == fir.check_kind.chk_overflow || k == fir.check_kind.chk_shift ||
        k == fir.check_kind.chk_overwrite;
}

// Joins a state into the entry of block `to`. A block that changes waits for another visit.
fn propagate(context mut* c, u32 to, state* s) void {
    if (c->final_pass || !s->reached || c->stopped) { return; }
    state mut copy = clone(s);
    defer free_state(&copy);
    // An edge can refine a root, and a join can add alternatives: each pays its content.
    if (!canonical(c, &copy) || !charge_content(c, &copy)) { return; }
    u64 at = cast(to, u64);
    if (!c->entry[at].reached) {
        replace(&c->entry[at], &copy);
        c->pending[at] = true;
        c->joins[at] += 1;
        return;
    }
    state mut joined = state{};
    defer free_state(&joined);
    if (!join(c, &c->entry[at], &copy, c->joins[at] >= WIDEN_AFTER, &joined) ||
        !charge_content(c, &joined)) { return; }
    bool mut same = false;
    if (!equal(c, &joined, &c->entry[at], &same)) { return; }
    if (!same) {
        replace(&c->entry[at], &joined);
        c->pending[at] = true;
    }
    c->joins[at] += 1;
}

// Marks each atom that an owned edge reaches from a caller-visible slot: the result or caller
// storage (D17.14).
fn reach_exit(context* c, state* s, bool mut@ reached) void {
    u64 mut i = 0;
    while (i < s->slots_len) {
        slot item = s->slots[i];
        bool visible = (item.key.base == base_kind.local && item.key.id == 0) ||
            item.key.base == base_kind.caller;
        if (visible && item.v.kind == value_kind.owned) { owned_from(s, item.v.atom, reached); }
        i += 1;
    }
}

// Checks a returned or retained borrow after deferred effects (D17.14).
fn check_retained(context mut* c, state mut* s, slot item) void {
    if (item.v.kind == value_kind.view && item.v.count > 0) {
        use_sources(c, s, item.v.count, item.v.sources, name(c, s, item.key));
    }
    if (item.v.kind == value_kind.address && item.v.target.base == base_kind.local) {
        violation(c, s, ownership_api.event_kind.invalid_use, certainty.definite, NONE,
            name(c, s, item.key));
    }
    // An address into a heap cell needs that cell live, as a view does.
    if (item.v.kind == value_kind.address && item.v.target.base == base_kind.cell) {
        u32[8] mut one = {};
        one[0] = item.v.target.id;
        use_sources(c, s, 1, one, name(c, s, item.key));
    }
    // A reference whose facts this body lost can designate released or local storage, so it
    // records an event here (D17.14). An input of the caller needs nothing. A reference that an
    // unknown effect wrote is that effect's own: the effect recorded its event, or the callee
    // recorded its own error, when it made this body residual.
    if (item.v.kind == value_kind.unknown && !item.v.external && !item.owning &&
        !(item.v.exact && c->residual) && (is_reference(item.ty) || item.array)) {
        unproved(c, s, ownership_api.incomplete_reason.unknown_effect, NONE,
            name(c, s, item.key));
    }
}

/// A normal return (D17.14). By-value parameter and temporary storage ends after deferred effects.
/// Returned and retained borrows need live sources. Each live obligation must be reachable from
/// the result or caller storage. The final pass joins the state into the exit state.
fn finish_return(context mut* c, state mut* s) void {
    if (!c->final_pass) { return; }
    u32 n = fir.local_count(c->f);
    u32 mut l = 1;
    while (l < n) {
        u64 first = cast(c->local_first[cast(l, u64)], u64);
        u64 mut i = 0;
        while (i < cast(c->local_count[cast(l, u64)], u64)) {
            end_slot(c, s, first + i);
            i += 1;
        }
        l += 1;
    }
    bool mut@ own reached = new(bool, s->atoms_len);
    defer del(reached);
    reach_exit(c, s, reached);
    u64 mut i = 0;
    while (i < s->slots_len) {
        slot item = s->slots[i];
        bool visible = (item.key.base == base_kind.local && item.key.id == 0) ||
            item.key.base == base_kind.caller ||
            (item.key.base == base_kind.cell && reached[cast(item.key.id, u64)]);
        if (visible) { check_retained(c, s, item); }
        i += 1;
    }
    // A caller-visible atom whose folded members keep a reference that this body made can
    // retain a reference to storage that ends (D17.14). This fact is the body's own, so an
    // unknown effect elsewhere in the body does not cover it.
    i = 0;
    while (i < s->atoms_len) {
        atom a = s->atoms[i];
        if (reached[i] && a.used && a.borrows &&
            a.root != root_kind.null_root &&
            (a.status == atom_status.live || a.status == atom_status.unknown)) {
            unproved(c, s, ownership_api.incomplete_reason.unknown_effect, cast(i, u32),
                "the borrowed fields that this allocation keeps");
        }
        i += 1;
    }
    i = 0;
    while (i < s->atoms_len) {
        atom a = s->atoms[i];
        bool obligation = a.used && !reached[i] && a.root != root_kind.null_root &&
            (a.status == atom_status.live || a.status == atom_status.unknown);
        if (obligation) {
            if (a.status == atom_status.unknown) {
                unproved(c, s, ownership_api.incomplete_reason.unknown_effect, cast(i, u32),
                    "completed cleanup at this return");
            } else {
                violation(c, s, ownership_api.event_kind.lost_ownership,
                    a.kind == atom_kind.cell ? certainty.definite : certainty_of(a.root),
                    cast(i, u32), "an allocation that no caller-visible owner holds");
            }
            mark_leaked(s, cast(i, u32));
        }
        i += 1;
    }
    state mut copy = clone(s);
    defer free_state(&copy);
    i = 0;
    while (i < copy.slots_len) {
        slot item = copy.slots[i];
        if (item.key.base == base_kind.local && item.key.id != 0) {
            copy.slots[i].v = item.v.kind == value_kind.scalar ? scalar_value() : empty_value();
        }
        i += 1;
    }
    // The assumptions that this body crossed are no fact of its exit state.
    copy.crossed_len = 0;
    copy.assumptions_full = false;
    if (!canonical(c, &copy) || !charge_content(c, &copy)) { return; }
    state mut joined = state{};
    defer free_state(&joined);
    if (!join(c, &c->exit, &copy, false, &joined) || !charge_content(c, &joined)) { return; }
    replace(&c->exit, &joined);
}

// ---- witnesses across branches ---------------------------------------------------------------

// The successors of block `b` in the post-dominator graph. A return and an abort reach the
// virtual exit `n`. A check does not: one that fails for known values ends its path in
// `run_block`, so no state of that path reaches a later block.
fn successors(fir.func* f, u32 b, u32 n, u32 mut@ out) u32 {
    fir.terminator* t = &fir.block_at(f, b)->term;
    u32 mut count = 0;
    u32 mut i = 0;
    u32 mut target = 0;
    while (fir_flow.reachable_target(f, t, i, &target) || fir.term_targets(f, t, i, &target)) {
        if (fir_flow.reachable_target(f, t, i, &target) && cast(count, u64) < out.len) {
            out[cast(count, u64)] = target;
            count += 1;
        }
        i += 1;
    }
    bool exits = t->kind == fir.term_kind.tk_return || t->kind == fir.term_kind.tk_fail ||
        t->kind == fir.term_kind.tk_trap || t->kind == fir.term_kind.tk_unreachable;
    if (exits && cast(count, u64) < out.len) {
        out[cast(count, u64)] = n;
        count += 1;
    }
    return count;
}

fn has_call(fir.func* f, u32 b) bool {
    u32 count = fir.block_statement_count(f, b);
    u32 mut i = 0;
    while (i < count) {
        fir.statement* stmt = fir.block_statement(f, b, i);
        if (stmt->kind == fir.stmt_kind.st_assign &&
            stmt->value.kind == fir.rvalue_kind.rv_call) { return true; }
        i += 1;
    }
    return false;
}

// Whether each path from the successors of `b` reaches `m` in finite steps: no block of the
// region between them calls a function, and no path returns to a block that it left.
fn region_clean(fir.func* f, u32 b, u32 m, u32 n) bool {
    bool mut@ own seen = new(bool, cast(n, u64) + 1);
    defer del(seen);
    bool mut@ own active = new(bool, cast(n, u64) + 1);
    defer del(active);
    u32 mut@ own stack = new(u32, cast(n, u64) * 2 + 2);
    defer del(stack);
    u32 mut@ own next = new(u32, cast(n, u64) * 2 + 2);
    defer del(next);
    u32 mut@ own succ = new(u32, cast(n, u64) + 2);
    defer del(succ);
    u64 mut top = 1;
    stack[0] = b;
    next[0] = 0;
    active[cast(b, u64)] = true;
    while (top > 0) {
        u32 x = stack[top - 1];
        u32 count = successors(f, x, n, succ);
        if (next[top - 1] >= count) {
            active[cast(x, u64)] = false;
            top -= 1;
            continue;
        }
        u32 y = succ[cast(next[top - 1], u64)];
        next[top - 1] += 1;
        if (y == m) { continue; }
        if (y == n || active[cast(y, u64)]) { return false; }
        if (seen[cast(y, u64)]) { continue; }
        seen[cast(y, u64)] = true;
        if (has_call(f, y)) { return false; }
        active[cast(y, u64)] = true;
        stack[top] = y;
        next[top] = 0;
        top += 1;
    }
    return true;
}

/// Finds, for each branch, the block where all of its paths return (`spec/toolchain.md` 4.2). The
/// post-dominators use a virtual exit after each return and abort (`successors`). Each block
/// pays one W unit in each round.
fn lay_out_rejoins(context mut* c) bool {
    u32 n = fir.block_count(c->f);
    c->rejoin = new(u32, cast(n, u64));
    u32 mut@ own succ = new(u32, cast(n, u64) + 2);
    defer del(succ);
    fir_flow.bits mut@ own pdom = new(fir_flow.bits, cast(n, u64) + 1);
    defer {
        u64 mut f = 0;
        while (f < pdom.len) { fir_flow.bits_free(&pdom[f]); f += 1; }
        del(pdom);
    }
    u32 mut b = 0;
    while (b <= n) {
        pdom[cast(b, u64)] = fir_flow.bits_new(n + 1);
        if (b == n) {
            fir_flow.bits_set(&pdom[cast(b, u64)], n);
        } else {
            fir_flow.bits_fill(&pdom[cast(b, u64)]);
        }
        b += 1;
    }
    fir_flow.bits mut work = fir_flow.bits_new(n + 1);
    defer fir_flow.bits_free(&work);
    bool mut changed = true;
    while (changed) {
        changed = false;
        b = n;
        while (b > 0) {
            b -= 1;
            if (!pay(c, 1)) { return false; }
            u32 count = successors(c->f, b, n, succ);
            fir_flow.bits_fill(&work);
            u32 mut k = 0;
            while (k < count) {
                fir_flow.bits_intersect(&work, &pdom[cast(succ[cast(k, u64)], u64)]);
                k += 1;
            }
            if (count == 0) { fir_flow.bits_fill(&work); }
            fir_flow.bits_set(&work, b);
            if (!fir_flow.bits_equal(&work, &pdom[cast(b, u64)])) {
                fir_flow.bits_copy(&pdom[cast(b, u64)], &work);
                changed = true;
            }
        }
    }
    b = 0;
    while (b < n) {
        c->rejoin[cast(b, u64)] = NONE;
        u32 count = successors(c->f, b, n, succ);
        if (count > 1) {
            // The nearest strict post-dominator has every other strict one as its own.
            u32 mut m = 0;
            while (m < n) {
                if (m != b && fir_flow.bits_get(&pdom[cast(b, u64)], m)) {
                    bool mut nearest = true;
                    u32 mut o = 0;
                    while (o < n && nearest) {
                        if (o != b && o != m && fir_flow.bits_get(&pdom[cast(b, u64)], o) &&
                            !fir_flow.bits_get(&pdom[cast(m, u64)], o)) { nearest = false; }
                        o += 1;
                    }
                    if (nearest) {
                        if (region_clean(c->f, b, m, n)) { c->rejoin[cast(b, u64)] = m; }
                        break;
                    }
                }
                m += 1;
            }
        }
        b += 1;
    }
    return true;
}

// A block where each path of a witnessed branch returns gets a witness again: one of those
// paths is feasible (`spec/toolchain.md` 4.2). The branch gives its witness at its terminator,
// so a call in the branch block that can fail to return clears it.
fn restore_witness(context* c, u32 b, state mut* s) void {
    if (s->witness || s->assumptions_full) { return; }
    u64 mut x = 0;
    while (x < c->rejoin.len && x < c->left.len) {
        if (c->rejoin[x] == b && c->left[x]) {
            s->witness = true;
            return;
        }
        x += 1;
    }
}

fn run_block(context mut* c, u32 b) void {
    c->left[cast(b, u64)] = false;
    state mut s = clone(&c->entry[cast(b, u64)]);
    defer free_state(&s);
    restore_witness(c, b, &s);
    fir.block* blk = fir.block_at(c->f, b);
    u32 count = fir.block_statement_count(c->f, b);
    u32 mut i = 0;
    while (i < count && s.reached && !c->stopped) {
        fir.statement* stmt = fir.block_statement(c->f, b, i);
        c->op = position(c, b, i, false);
        c->at = stmt->loc;
        c->exit_at = stmt->exit_loc;
        if (!pay(c, 1)) { return; }
        statement(c, &s, stmt);
        if (!charge_content(c, &s)) { return; }
        i += 1;
    }
    if (!s.reached || c->stopped) { return; }
    fir.terminator* term = &blk->term;
    c->op = position(c, b, count, true);
    c->at = term->loc;
    c->exit_at = diag.loc{};
    if (!pay(c, 1)) { return; }
    c->left[cast(b, u64)] = s.witness;
    switch (term->kind) {
    case fir.term_kind.tk_goto:
        propagate(c, term->target, &s);
    case fir.term_kind.tk_switch:
        value cond = operand(c, &s, term->cond);
        types.node* cond_ty = fir.operand_type(c->f, term->cond);
        bool boolean = cond_ty != null && cond_ty->kind == types.type_kind.k_prim &&
            cond_ty->prim == prim.prim_kind.prim_bool;
        if (boolean && term->arms_len == 1) {
            fir.arm only = fir.term_arm(c->f, term, 0);
            bool truth = only.value.mag != 0;
            state mut taken = clone(&s);
            defer free_state(&taken);
            if (refine(&taken, cond, truth)) { propagate(c, only.target, &taken); }
            state mut other = clone(&s);
            defer free_state(&other);
            if (refine(&other, cond, !truth)) { propagate(c, term->otherwise, &other); }
        } else {
            if (term->arms_len > 0) { s.witness = false; }
            u32 mut a = 0;
            while (a < term->arms_len) {
                propagate(c, fir.term_arm(c->f, term, a).target, &s);
                a += 1;
            }
            propagate(c, term->otherwise, &s);
        }
    case fir.term_kind.tk_return:
        finish_return(c, &s);
    case fir.term_kind.tk_check:
        value checked = operand(c, &s, term->cond);
        u32 mut arg = 0;
        while (arg < term->args_len) {
            operand(c, &s, fir.operand_at(c->f, term->args_first + arg));
            arg += 1;
        }
        // A kept check fails for the values that this state knows only when its condition is
        // known. It then fails on each path into this state, so the path ends as an abort ends
        // it. On a value that this state does not know, the witness goes on and assumes that
        // the check passes. An event that it validates names the check (D17.18,
        // `spec/toolchain.md` 4.2). The condition of `user` holds on success, and each other
        // condition holds on failure (`spec/fir.md` 8).
        if (!removable(term->check) && checked.known &&
            checked.truth != (term->check == fir.check_kind.chk_user)) { return; }
        if (!removable(term->check) && !checked.known &&
            !add_crossed(&s, crossed_call{.source = source(c, c->at), .check = true,
            .kind = term->check})) {
            s.witness = false;
            s.assumptions_full = true;
        }
        propagate(c, term->target, &s);
    case fir.term_kind.tk_check_overwrite:
        location mut loc = location{};
        types.node* mut checked_ty = null;
        resolve(c, &s, term->place, &loc, &checked_ty);
        propagate(c, term->target, &s);
    default:
        // An abort, a trap, or an unreachable terminator that the path reaches: no return.
        return;
    }
}

fn body_proof(context* c) ownership_api.proof_status {
    if (c->incomplete_any) {
        ownership_api.proof_status mut out = c->first_incomplete;
        out.kind = ownership_api.proof_kind.incomplete;
        out.failed = true;
        return out;
    }
    if (c->failed_any) { return c->first_failure; }
    return complete();
}

fn free_context(context mut* c) void {
    u64 mut i = 0;
    while (i < c->entry.len) {
        free_state(&c->entry[i]);
        i += 1;
    }
    del(c->entry);
    del(c->joins);
    del(c->pending);
    del(c->rejoin);
    del(c->left);
    free_state(&c->exit);
    del(c->shapes);
    del(c->fixed);
    del(c->local_first);
    del(c->local_count);
    del(c->caller_first);
    del(c->caller_count);
    del(c->callers);
    del(c->interface);
    del(c->require_null);
    del(c->require_fields);
    del(c->addressed);
    del(c->seen);
    strbuf.free(&c->text);
}

/// Analyzes one body to a stable state at each block, then runs one final pass that records the
/// events when `reporting` is true and builds the exit state (fir.md 14.1).
// A stop before the final pass leaves only a noted proof: that pass recorded no event. The
// report records it now at the stop position, so no incomplete result goes unrecorded
// (`spec/fir.md` 14.1). The solver records the event of a W stop.
fn record_stop(context mut* c, bool reporting) void {
    ownership_api.proof_status why = c->first_incomplete;
    if (!reporting || (why.terminal.limit.present &&
        why.terminal.limit.category == ownership_api.limit_category.w)) { return; }
    c->reporting = true;
    state mut held = state{};
    held.lossy = c->stop_lossy;
    held.loss = c->stop_loss;
    ownership_api.incomplete_reason reason = why.terminal.present ? why.terminal.reason :
        ownership_api.incomplete_reason.missing_graph;
    record(c, &held, ownership_api.event_kind.incomplete_proof,
        ownership_api.evidence_kind.abstract_possibility, reason, NONE,
        "the state within its precision bounds");
    free_state(&held);
}

fn analyze(context mut* c, bool reporting) void {
    u32 blocks = fir.block_count(c->f);
    c->entry = new(state, cast(blocks, u64));
    c->joins = new(u32, cast(blocks, u64));
    c->left = new(bool, cast(blocks, u64));
    c->pending = new(bool, cast(blocks, u64));
    u64 locals = cast(fir.local_count(c->f), u64);
    u64 mut b = 0;
    while (b < cast(blocks, u64)) {
        c->entry[b] = bottom(locals);
        b += 1;
    }
    c->exit = bottom(locals);
    c->op = position(c, 0, 0, false);
    // Work before the first block names the entry of the body.
    if (blocks > 0) { c->at = fir.block_at(c->f, 0)->term.loc; }
    if (blocks > 0 && fir.block_statement_count(c->f, 0) > 0) {
        c->at = fir.block_statement(c->f, 0, 0)->loc;
    }
    if (!lay_out(c)) {
        c->reporting = reporting;
        unproved(c, null, ownership_api.incomplete_reason.missing_graph, NONE,
            "the interface of this body within its bit set");
        c->residual = true;
        return;
    }
    if (blocks == 0) { return; }
    if (!lay_out_rejoins(c)) {
        record_stop(c, reporting);
        return;
    }
    state mut start = initial(c);
    defer free_state(&start);
    if (!canonical(c, &start)) {
        record_stop(c, reporting);
        return;
    }
    replace(&c->entry[0], &start);
    c->pending[0] = true;
    bool mut more = true;
    while (more && !c->stopped) {
        more = false;
        b = 0;
        while (b < cast(blocks, u64)) {
            if (c->pending[b]) {
                c->pending[b] = false;
                run_block(c, cast(b, u32));
                more = true;
                break;
            }
            b += 1;
        }
    }
    if (c->stopped) {
        record_stop(c, reporting);
        return;
    }
    c->failed_any = false;
    c->incomplete_any = false;
    c->final_pass = true;
    c->reporting = reporting;
    b = 0;
    while (b < cast(blocks, u64) && !c->stopped) {
        if (c->entry[b].reached) { run_block(c, cast(b, u32)); }
        b += 1;
    }
}

fn free_summary(summary mut* s) void {
    del(s->interface);
    del(s->callers);
    free_state(&s->post);
    *s = summary{};
}

fn take_summary(context mut* c) summary {
    summary mut out = summary{};
    out.proof = body_proof(c);
    out.known = true;
    out.returns = c->exit.reached && !c->stopped;
    out.witness = c->exit.witness;
    out.residual = c->residual || c->stopped;
    out.writes_untracked = c->writes_untracked;
    out.deref_inputs = c->deref_inputs;
    out.interface = new(interface_entry, c->interface_len);
    u64 mut i = 0;
    while (i < c->interface_len) {
        interface_entry mut e = c->interface[i];
        e.needs_shape = (c->needs_shape & bit(i)) != 0;
        e.require_null = c->require_null[i];
        e.require_fields = c->require_fields[i];
        out.interface[i] = e;
        i += 1;
    }
    out.callers = new(caller_entry, c->callers_len);
    i = 0;
    while (i < c->callers_len) {
        out.callers[i] = c->callers[i];
        i += 1;
    }
    out.view_reads = c->view_reads;
    out.reads_high = c->reads_high;
    out.events = c->events;
    out.post = move(c->exit);
    c->exit = bottom(cast(fir.local_count(c->f), u64));
    return out;
}

fn same_summary(context mut* c, summary* a, summary* b, bool mut* same) bool {
    *same = false;
    if (a->known != b->known || a->returns != b->returns || a->witness != b->witness ||
        a->residual != b->residual || a->writes_untracked != b->writes_untracked ||
        a->deref_inputs != b->deref_inputs ||
        a->view_reads != b->view_reads ||
        a->reads_high != b->reads_high ||
        a->proof.kind != b->proof.kind || a->proof.failed != b->proof.failed ||
        a->interface.len != b->interface.len) { return true; }
    u64 mut i = 0;
    while (i < a->interface.len) {
        if (a->interface[i].needs_shape != b->interface[i].needs_shape ||
            a->interface[i].require_null != b->interface[i].require_null ||
            a->interface[i].require_fields != b->interface[i].require_fields) { return true; }
        i += 1;
    }
    return equal(c, &a->post, &b->post, same);
}

/// The input of one body: its key, its verified FIR, and the files of its source positions.
struct body_input {
    ownership_api.function_id key;
    fir.func* body;
    ownership_flow.source_file_binding@ files;
}

// `c` is a fresh `context{}`: open sets its inputs and writes no owner of it, so it loses no
// state of a context in use.
fn open(context mut* c, body_input* input, ownership_api.services* svc, callee@ callees) void {
    c->f = input->body;
    c->key = input->key;
    c->files = input->files;
    c->svc = svc;
    c->callees = callees;
    c->first_failure = complete();
    c->first_incomplete = complete();
}

/// Analyzes one body with the published summaries of its callees and returns its summary.
/// `reporting` records the events. The caller frees the summary.
fn analyze_body(body_input* input, ownership_api.services* svc, callee@ callees, bool reporting)
    summary {
    context mut c = context{};
    open(&c, input, svc, callees);
    defer free_context(&c);
    analyze(&c, reporting);
    return take_summary(&c);
}

// ---- the closure ----------------------------------------------------------------------------

/// Starts the computation of one component (D17.18). The client configures the meter that its
/// services charge for a computation of FIR size `size`. False refuses the computation.
struct computation_hook {
    void mut* context;
    fn (void mut*, u64, ownership_api.limit_table mut*) bool begin;
}

/// One solved closure. Summary i belongs to body i of the graph. A recursive component keeps
/// its rounds before the fixed point.
struct solution {
    summary mut@ own summaries;
    u64 mut@ own rounds;
    ownership_api.proof_status proof;
}

fn free(solution mut* out) void {
    u64 mut i = 0;
    while (i < out->summaries.len) {
        free_summary(&out->summaries[i]);
        i += 1;
    }
    del(out->summaries);
    del(out->rounds);
    *out = solution{};
}

// Rounds before the fixed point record no event: their results are provisional (D17.18).
fn quiet_event(void mut* opaque, ownership_api.event_request* req)
    ownership_api.event_result {
    return ownership_api.event_result{.proof = req->current, .retained = true,
        .stored_key = req->event.key};
}

struct budget_note {
    ownership_api.services* inner;
    bool recorded;
}

fn noted_event(void mut* opaque, ownership_api.event_request* req)
    ownership_api.event_result {
    budget_note mut* note = cast(opaque, budget_note mut*);
    ownership_api.exhaustion limit = req->event.limit.present ? req->event.limit :
        req->current.terminal.limit;
    if (limit.present && limit.category == ownership_api.limit_category.w) {
        note->recorded = true;
    }
    return ownership_api.record_event(note->inner, req);
}

fn publish(solution mut* out, u64 body, summary mut* published) void {
    free_summary(&out->summaries[body]);
    out->summaries[body] = move(*published);
}

fn refused(ownership_api.proof_status proof) summary {
    summary mut out = summary{};
    out.proof = proof;
    out.known = true;
    out.residual = true;
    return out;
}

// A W refusal stops the computation. One budget event names it when no event of the
// computation did, as in a quiet round (`spec/fir.md` 14.1).
fn stop_component(solution mut* out, ownership_api.services* svc, budget_note* note,
    u32@ members, ownership_graph.graph* g, ownership_api.proof_status proof) void {
    ownership_api.exhaustion limit = proof.terminal.limit;
    if (!note->recorded && limit.present && members.len > 0) {
        ownership_api.event_request mut req = ownership_api.event_request{};
        req.current = proof;
        req.event.key = ownership_api.entity_id{g->bodies[cast(members[0], u64)].key,
            ownership_api.entity_kind.event, NONE};
        req.event.operation = proof.terminal.operation;
        req.event.source = proof.terminal.source;
        req.event.kind = ownership_api.event_kind.work_failure;
        req.event.evidence = ownership_api.evidence_kind.abstract_possibility;
        req.event.reason = proof.terminal.reason;
        req.event.limit = limit;
        req.event.text = "ownership heap analysis stopped at the work bound";
        ownership_api.record_event(svc, &req);
    }
    u64 mut i = 0;
    while (i < members.len) {
        summary mut stopped_summary = refused(proof);
        publish(out, cast(members[i], u64), &stopped_summary);
        i += 1;
    }
}

// Records one incomplete-proof event for body `key`: a published incomplete result needs an
// event, or its callers would treat the callee as one that reported its own error
// (`spec/fir.md` 14.1). Its key takes the ordinal NONE - 1, which no operation event takes.
fn record_body(ownership_api.services* svc, ownership_api.function_id key,
    ownership_api.proof_status proof, string text) void {
    ownership_api.event_request mut req = ownership_api.event_request{};
    req.current = proof;
    req.event.key = ownership_api.entity_id{key, ownership_api.entity_kind.event, NONE - 1};
    req.event.operation = ownership_api.operation_position{key, 0, 0, false};
    if (proof.terminal.present &&
        ownership_keys.function(proof.terminal.operation.function, key) == 0) {
        req.event.operation = proof.terminal.operation;
        req.event.source = proof.terminal.source;
    }
    req.event.kind = ownership_api.event_kind.incomplete_proof;
    req.event.evidence = ownership_api.evidence_kind.abstract_possibility;
    req.event.reason = proof.terminal.present ? proof.terminal.reason :
        ownership_api.incomplete_reason.unknown_effect;
    req.event.text = text;
    ownership_api.record_event(svc, &req);
}

// Publishes a loud result. A result without a proof and without an event of its own gets one.
fn publish_reported(solution mut* out, ownership_api.services* svc, ownership_api.function_id key,
    u64 body, summary mut* result) void {
    if (!ownership_api.successful(result->proof) && result->events == 0) {
        record_body(svc, key, result->proof, "the heap proof of this body");
    }
    publish(out, body, result);
}

fn work_stopped(summary* s) bool {
    return s->proof.terminal.present && s->proof.terminal.limit.present &&
        s->proof.terminal.limit.category == ownership_api.limit_category.w;
}

/// Solves the heap summary of each body of `g`, each callee component first (D17.18). Input i
/// is body i of the graph. One computation solves each component, and `hook` starts it. A
/// recursive component publishes only after a fixed point that a publication round repeats.
fn solve(ownership_graph.graph mut* g, body_input@ inputs, ownership_api.services* svc,
    computation_hook hook) solution {
    solution mut out = solution{};
    out.proof = complete();
    u64 n = inputs.len;
    out.summaries = new(summary, n);
    out.rounds = new(u64, n);
    if (!ownership_api.successful(g->proof) || g->bodies.len != n || hook.begin == null ||
        svc == null) {
        out.proof = ownership_api.incomplete(ownership_api.incomplete_reason.invalid_input,
            ownership_api.operation_position{}, ownership_api.source_position{});
        u64 mut r = 0;
        while (r < n) {
            summary mut bad = refused(out.proof);
            publish(&out, r, &bad);
            r += 1;
        }
        return out;
    }
    u32@ order = ownership_graph.callee_first(g);
    bool mut@ own solved = new(bool, cast(g->component_count, u64) + 1);
    defer del(solved);
    callee mut@ own callees = new(callee, n);
    defer del(callees);
    u32 mut@ own members = new(u32, n);
    defer del(members);
    u64 mut step = 0;
    while (step < order.len) {
        u32 component = order[step];
        bool recursive = ownership_graph.recursive_component(g, component);
        u64 mut count = 0;
        u64 mut size = 0;
        u64 mut i = 0;
        while (i < n) {
            if (g->components[i] == component) {
                members[count] = cast(i, u32);
                count += 1;
                size = ownership_limits.saturating_sum(size,
                    ownership_limits.fir_size(inputs[i].body));
            }
            i += 1;
        }
        u64 mut used = 0;
        i = 0;
        while (i < n) {
            bool member = g->components[i] == component;
            if (member || solved[cast(g->components[i], u64)]) {
                callees[used] = callee{inputs[i].body->sym, &out.summaries[i],
                    member && recursive};
                used += 1;
            }
            i += 1;
        }
        ownership_api.limit_table mut limits = ownership_api.limit_table{};
        budget_note mut note = budget_note{svc, false};
        ownership_api.services mut loud = *svc;
        loud.event_context = cast(&note, void mut*);
        loud.event = noted_event;
        ownership_api.services mut quiet = *svc;
        quiet.event = quiet_event;
        if (!hook.begin(hook.context, size, &limits) || !ownership_api.valid_limits(&limits)) {
            ownership_api.proof_status refusal = ownership_api.incomplete(
                ownership_api.incomplete_reason.missing_budget, ownership_api.operation_position{},
                ownership_api.source_position{});
            i = 0;
            while (i < count) {
                summary mut bad = refused(refusal);
                ownership_api.function_id key = g->bodies[cast(members[i], u64)].key;
                record_body(svc, key, refusal, "a computation that the client refused");
                publish(&out, cast(members[i], u64), &bad);
                i += 1;
            }
            solved[cast(component, u64)] = true;
            step += 1;
            continue;
        }
        if (!recursive) {
            i = 0;
            while (i < count) {
                u64 body = cast(members[i], u64);
                summary mut result = analyze_body(&inputs[body], &loud, callees[0..used], true);
                if (work_stopped(&result)) {
                    ownership_api.proof_status why = result.proof;
                    free_summary(&result);
                    stop_component(&out, svc, &note, members[0..count], g, why);
                    break;
                }
                publish_reported(&out, svc, inputs[body].key, body, &result);
                i += 1;
            }
            solved[cast(component, u64)] = true;
            step += 1;
            continue;
        }
        i = 0;
        while (i < count) {
            summary mut start = summary{};
            start.proof = complete();
            start.known = true;
            start.post = bottom(0);
            publish(&out, cast(members[i], u64), &start);
            i += 1;
        }
        u64 mut rounds = 0;
        bool mut changed = true;
        bool mut stopped = false;
        while (changed && !stopped) {
            changed = false;
            rounds += 1;
            i = 0;
            while (i < count) {
                u64 body = cast(members[i], u64);
                summary mut result = analyze_body(&inputs[body], &quiet, callees[0..used], false);
                if (work_stopped(&result)) {
                    ownership_api.proof_status why = result.proof;
                    free_summary(&result);
                    stop_component(&out, svc, &note, members[0..count], g, why);
                    stopped = true;
                    break;
                }
                context mut cmp = context{};
                open(&cmp, &inputs[body], &quiet, callees[0..used]);
                bool mut same = false;
                bool compared = same_summary(&cmp, &result, &out.summaries[body], &same);
                free_context(&cmp);
                if (!compared) { same = false; }
                if (!same) { changed = true; }
                publish(&out, body, &result);
                i += 1;
            }
            if (rounds >= ROUND_LIMIT && changed && !stopped) {
                ownership_api.proof_status limit = ownership_api.incomplete(
                    ownership_api.incomplete_reason.missing_graph,
                    ownership_api.operation_position{g->bodies[cast(members[0], u64)].key, 0, 0,
                        false}, ownership_api.source_position{});
                i = 0;
                while (i < count) {
                    summary mut bad = refused(limit);
                    ownership_api.function_id key = g->bodies[cast(members[i], u64)].key;
                    record_body(svc, key, limit, "a fixed point within the round bound");
                    publish(&out, cast(members[i], u64), &bad);
                    i += 1;
                }
                stopped = true;
            }
        }
        if (!stopped) {
            i = 0;
            bool mut differs = false;
            bool mut unproved_member = false;
            while (i < count) {
                u64 body = cast(members[i], u64);
                out.rounds[body] = rounds;
                summary mut result = analyze_body(&inputs[body], &loud, callees[0..used], true);
                if (work_stopped(&result)) {
                    ownership_api.proof_status why = result.proof;
                    free_summary(&result);
                    stop_component(&out, svc, &note, members[0..count], g, why);
                    differs = false;
                    break;
                }
                context mut cmp = context{};
                open(&cmp, &inputs[body], &quiet, callees[0..used]);
                bool mut same = false;
                bool compared = same_summary(&cmp, &result, &out.summaries[body], &same);
                free_context(&cmp);
                if (!compared || !same) { differs = true; }
                if (!ownership_api.successful(result.proof)) { unproved_member = true; }
                publish_reported(&out, svc, inputs[body].key, body, &result);
                i += 1;
            }
            // A member without a proof, or a publication that moved, withdraws the proof of
            // each member: their summaries rest on each other (the recursive call solver does
            // the same). Each withdrawn member records its own event.
            if ((differs || unproved_member) && i == count) {
                i = 0;
                while (i < count) {
                    u64 body = cast(members[i], u64);
                    ownership_api.function_id key = g->bodies[body].key;
                    if (ownership_api.successful(out.summaries[body].proof)) {
                        ownership_api.proof_status moved = ownership_api.incomplete(
                            ownership_api.incomplete_reason.missing_graph,
                            ownership_api.operation_position{key, 0, 0, false},
                            ownership_api.source_position{});
                        record_body(svc, key, moved,
                            "a recursive component in which a member has no proof");
                        summary mut bad = refused(moved);
                        publish(&out, body, &bad);
                    }
                    i += 1;
                }
            }
        }
        solved[cast(component, u64)] = true;
        step += 1;
    }
    return out;
}
