/// Stores finite ownership facts without changing emitted program data.
import ownership_api;
import ownership_keys;

u64 U64_MAX = 18446744073709551615;

// Each block owns one copied nested slice. Fact records borrow these slices.
struct slice_block {
    ownership_api.projection mut@ own projections;
    ownership_api.layout_leaf mut@ own leaves;
    ownership_api.region_partition mut@ own partitions;
    ownership_api.borrow_relation mut@ own borrows;
    ownership_api.history_fact mut@ own history;
    ownership_api.entity_id mut@ own entities;
    slice_block mut* own next;
}

struct state {
    ownership_api.contents_fact mut@ own contents;
    u64 contents_len;
    ownership_api.source_fact mut@ own sources;
    u64 sources_len;
    ownership_api.allocation_fact mut@ own allocations;
    u64 allocations_len;
    ownership_api.region mut@ own regions;
    u64 regions_len;
    ownership_api.graph_node mut@ own nodes;
    u64 nodes_len;
    ownership_api.graph_edge mut@ own edges;
    u64 edges_len;
    ownership_api.shape_description mut@ own shapes;
    u64 shapes_len;
    ownership_api.predicate_atom mut@ own predicates;
    u64 predicates_len;
    ownership_api.guard_fact mut@ own guards;
    u64 guards_len;
    ownership_api.correlation mut@ own correlations;
    u64 correlations_len;
    ownership_api.lost_fact mut@ own losses;
    u64 losses_len;
    slice_block mut* own blocks;
    ownership_api.proof_status proof;
}

fn empty() state {
    state mut s = state{};
    s.proof.kind = ownership_api.proof_kind.complete;
    return s;
}

fn unknown() state {
    return state{};
}

fn bottom() state {
    state mut s = state{};
    s.proof.kind = ownership_api.proof_kind.bottom;
    return s;
}

fn view(state* s) ownership_api.state_view {
    ownership_api.state_view mut out = ownership_api.state_view{};
    out.contents = s->contents[0..s->contents_len];
    out.sources = s->sources[0..s->sources_len];
    out.allocations = s->allocations[0..s->allocations_len];
    out.regions = s->regions[0..s->regions_len];
    out.nodes = s->nodes[0..s->nodes_len];
    out.edges = s->edges[0..s->edges_len];
    out.shapes = s->shapes[0..s->shapes_len];
    out.predicates = s->predicates[0..s->predicates_len];
    out.guards = s->guards[0..s->guards_len];
    out.correlations = s->correlations[0..s->correlations_len];
    out.losses = s->losses[0..s->losses_len];
    out.proof = s->proof;
    return out;
}

fn free(state mut* s) void {
    slice_block mut* own mut b = move(s->blocks);
    while (b != null) {
        slice_block mut* own next = move(b->next);
        del(b->projections);
        del(b->leaves);
        del(b->partitions);
        del(b->borrows);
        del(b->history);
        del(b->entities);
        del(b);
        b = move(next);
    }
    del(s->contents);
    del(s->sources);
    del(s->allocations);
    del(s->regions);
    del(s->nodes);
    del(s->edges);
    del(s->shapes);
    del(s->predicates);
    del(s->guards);
    del(s->correlations);
    del(s->losses);
    *s = state{};
}

fn destroy(void mut* opaque) void {
    state mut* s = cast(opaque, state mut*);
    free(s);
}

fn handle(state mut* s) ownership_api.state_handle {
    return ownership_api.state_handle{cast(s, void mut*), destroy};
}

fn grown(u64 cap, u64 need) u64 {
    if (need <= cap) { return cap; }
    u64 mut next = cap < 8 ? 8 : cap;
    while (next < need) {
        if (next > U64_MAX / 2) { return need; }
        next *= 2;
    }
    return next;
}

fn keep(state mut* s, slice_block mut* own b) void {
    b->next = move(s->blocks);
    s->blocks = move(b);
}

fn copy_projections(state mut* s, ownership_api.projection@ input)
    ownership_api.projection@ {
    if (input.len == 0) { ownership_api.projection@ none = {}; return none; }
    slice_block mut* own b = new(slice_block);
    b->projections = new(ownership_api.projection, input.len);
    u64 mut i = 0;
    while (i < input.len) { b->projections[i] = input[i]; i += 1; }
    ownership_api.projection@ out = b->projections[..];
    keep(s, move(b));
    return out;
}

fn copy_leaves(state mut* s, ownership_api.layout_leaf@ input)
    ownership_api.layout_leaf@ {
    if (input.len == 0) { ownership_api.layout_leaf@ none = {}; return none; }
    slice_block mut* own b = new(slice_block);
    b->leaves = new(ownership_api.layout_leaf, input.len);
    u64 mut i = 0;
    while (i < input.len) { b->leaves[i] = input[i]; i += 1; }
    ownership_api.layout_leaf@ out = b->leaves[..];
    keep(s, move(b));
    return out;
}

fn copy_partitions(state mut* s, ownership_api.region_partition@ input)
    ownership_api.region_partition@ {
    if (input.len == 0) { ownership_api.region_partition@ none = {}; return none; }
    slice_block mut* own b = new(slice_block);
    b->partitions = new(ownership_api.region_partition, input.len);
    u64 mut i = 0;
    while (i < input.len) { b->partitions[i] = input[i]; i += 1; }
    ownership_api.region_partition@ out = b->partitions[..];
    keep(s, move(b));
    return out;
}

fn copy_entities(state mut* s, ownership_api.entity_id@ input)
    ownership_api.entity_id@ {
    if (input.len == 0) { ownership_api.entity_id@ none = {}; return none; }
    slice_block mut* own b = new(slice_block);
    b->entities = new(ownership_api.entity_id, input.len);
    u64 mut i = 0;
    while (i < input.len) { b->entities[i] = input[i]; i += 1; }
    ownership_api.entity_id@ out = b->entities[..];
    keep(s, move(b));
    return out;
}

fn copy_place(state mut* s, ownership_api.place_path input) ownership_api.place_path {
    ownership_api.place_path mut out = input;
    out.projections = copy_projections(s, input.projections);
    return out;
}

fn copy_region(state mut* s, ownership_api.region input) ownership_api.region {
    ownership_api.region mut out = input;
    out.leaves = copy_leaves(s, input.leaves);
    out.partitions = copy_partitions(s, input.partitions);
    return out;
}

fn copy_borrow(state mut* s, ownership_api.borrow_relation input)
    ownership_api.borrow_relation {
    ownership_api.borrow_relation mut out = input;
    out.containing = copy_place(s, input.containing);
    out.range = copy_region(s, input.range);
    return out;
}

fn copy_borrows(state mut* s, ownership_api.borrow_relation@ input)
    ownership_api.borrow_relation@ {
    if (input.len == 0) { ownership_api.borrow_relation@ none = {}; return none; }
    slice_block mut* own b = new(slice_block);
    b->borrows = new(ownership_api.borrow_relation, input.len);
    u64 mut i = 0;
    while (i < input.len) { b->borrows[i] = copy_borrow(s, input[i]); i += 1; }
    ownership_api.borrow_relation@ out = b->borrows[..];
    keep(s, move(b));
    return out;
}

fn copy_contents(state mut* s, ownership_api.contents_fact input)
    ownership_api.contents_fact {
    ownership_api.contents_fact mut out = input;
    out.place = copy_place(s, input.place);
    out.borrows = copy_borrows(s, input.borrows);
    return out;
}

fn copy_owner(state mut* s, ownership_api.owner_location input)
    ownership_api.owner_location {
    ownership_api.owner_location mut out = input;
    out.place = copy_place(s, input.place);
    return out;
}

fn copy_history(state mut* s, ownership_api.history_fact input)
    ownership_api.history_fact {
    ownership_api.history_fact mut out = input;
    out.before = copy_owner(s, input.before);
    out.after = copy_owner(s, input.after);
    return out;
}

fn copy_histories(state mut* s, ownership_api.history_fact@ input)
    ownership_api.history_fact@ {
    if (input.len == 0) { ownership_api.history_fact@ none = {}; return none; }
    slice_block mut* own b = new(slice_block);
    b->history = new(ownership_api.history_fact, input.len);
    u64 mut i = 0;
    while (i < input.len) { b->history[i] = copy_history(s, input[i]); i += 1; }
    ownership_api.history_fact@ out = b->history[..];
    keep(s, move(b));
    return out;
}

fn copy_allocation(state mut* s, ownership_api.allocation_fact input)
    ownership_api.allocation_fact {
    ownership_api.allocation_fact mut out = input;
    out.owner = copy_owner(s, input.owner);
    out.history = copy_histories(s, input.history);
    return out;
}

fn copy_edge(state mut* s, ownership_api.graph_edge input) ownership_api.graph_edge {
    ownership_api.graph_edge mut out = input;
    out.place = copy_place(s, input.place);
    out.range = copy_region(s, input.range);
    return out;
}

fn copy_shape(state mut* s, ownership_api.shape_description input)
    ownership_api.shape_description {
    ownership_api.shape_description mut out = input;
    out.parameters = copy_entities(s, input.parameters);
    out.clauses = copy_entities(s, input.clauses);
    out.descendants = copy_entities(s, input.descendants);
    return out;
}

fn copy_guard(state mut* s, ownership_api.guard_fact input) ownership_api.guard_fact {
    ownership_api.guard_fact mut out = input;
    out.positive = copy_entities(s, input.positive);
    out.negative = copy_entities(s, input.negative);
    return out;
}

fn append_contents(state mut* s, ownership_api.contents_fact input) void {
    if (s->contents_len == U64_MAX) { panic("ownership_state.contents: capacity overflow"); }
    u64 need = s->contents_len + 1;
    if (need > s->contents.len) {
        u64 cap = grown(s->contents.len, need);
        ownership_api.contents_fact mut@ own bigger = new(ownership_api.contents_fact, cap);
        u64 mut i = 0;
        while (i < s->contents_len) { bigger[i] = s->contents[i]; i += 1; }
        del(s->contents);
        s->contents = move(bigger);
    }
    s->contents[s->contents_len] = copy_contents(s, input);
    s->contents_len += 1;
}

