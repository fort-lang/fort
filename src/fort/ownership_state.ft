struct charge_counts {
    u64 d;
    u64 r;
    u64 p;
    u64 g;
    u64 h;
    u64 e;
    u64 w;
}

fn plus_count(u64 a, u64 b) u64 {
    if (b > U64_MAX - a) { return U64_MAX; }
    return a + b;
}

fn max_count(u64 a, u64 b) u64 { return a > b ? a : b; }

fn place_depth(ownership_api.place_path path) u64 {
    return path.projections.len;
}

fn region_count(ownership_api.region range) u64 {
    if (range.key.kind == ownership_api.entity_kind.none) { return 0; }
    return plus_count(1, range.partitions.len);
}

// A candidate describes additions and removals without copying the represented state.
struct region_candidate {
    ownership_api.contents_fact@ contents;
    u64 copies;
    ownership_api.allocation_fact@ allocations;
    ownership_api.region@ regions;
    ownership_api.graph_node@ nodes;
    ownership_api.graph_edge@ edges;
    ownership_api.place_path@ removed;
}
struct region_measurement { ownership_api.proof_status proof; u64 amount; }
struct region_identity {
    ownership_api.entity_id region;
    ownership_api.entity_id partition;
    bool partitioned;
}
struct region_counter {
    ownership_api.services* service;
    ownership_api.work_kind kind;
    ownership_api.operation_position operation;
    ownership_api.source_position source;
    ownership_api.proof_status proof;
    region_identity[8] local;
    region_identity mut@ own identities;
    u64 len;
    u64 unknown;
    // A batch counter appends each identity and merges equal identities in region_settle.
    bool batch;
}

fn region_spend(region_counter mut* paid) bool {
    if (!ownership_api.successful(paid->proof)) { return false; }
    ownership_api.charge_result charged = ownership_api.charge_work(paid->service,
        paid->kind, paid->operation, paid->source);
    if (!charged.allowed) { paid->proof = charged.proof; }
    return charged.allowed;
}

fn region_refuse(region_counter mut* paid) bool {
    paid->proof = ownership_api.incomplete(ownership_api.incomplete_reason.invalid_input,
        paid->operation, paid->source);
    return false;
}

fn region_entries(region_counter mut* paid) region_identity mut@ {
    return paid->identities.len == 0 ? paid->local[..] : paid->identities[..];
}

fn region_order(region_identity a, region_identity b) i32 {
    i32 result = ownership_keys.entity(a.region, b.region);
    if (result != 0) { return result; }
    if (a.partitioned != b.partitioned) { return a.partitioned ? 1 : -1; }
    return ownership_keys.entity(a.partition, b.partition);
}

// Missing keys prove no equality. Keyed entries use canonical order, never addresses.
// A batch counter appends without a search, so each identity costs a fixed amount of work.
fn region_insert(region_counter mut* paid, region_identity item) bool {
    if (!region_spend(paid)) { return false; }
    if (item.region.kind == ownership_api.entity_kind.none ||
        (item.partitioned && item.partition.kind == ownership_api.entity_kind.none)) {
        if (paid->unknown == U64_MAX) { return region_refuse(paid); }
        paid->unknown += 1;
        return true;
    }
    u64 mut index = paid->len;
    if (!paid->batch) {
        index = 0;
        while (index < paid->len) {
            if (!region_spend(paid)) { return false; }
            i32 order = region_order(item, region_entries(paid)[index]);
            if (order == 0) { return true; }
            if (order < 0) { break; }
            index += 1;
        }
    }
    u64 ceiling = (U64_MAX / 2) / sizeof(region_identity);
    if (paid->len >= ceiling) { return region_refuse(paid); }
    u64 current = paid->identities.len == 0 ? paid->local.len : paid->identities.len;
    if (paid->len == current) {
        if (!region_spend(paid)) { return false; }
        u64 capacity = current <= ceiling / 2 ? current * 2 : ceiling;
        if (capacity <= paid->len || capacity > ceiling) { return region_refuse(paid); }
        region_identity mut@ own bigger = new(region_identity, capacity);
        u64 mut i = 0;
        while (i < paid->len) {
            if (!region_spend(paid)) { del(bigger); return false; }
            bigger[i] = region_entries(paid)[i];
            i += 1;
        }
        del(paid->identities);
        paid->identities = move(bigger);
    }
    u64 mut i = paid->len;
    while (i > index) {
        if (!region_spend(paid)) { return false; }
        region_entries(paid)[i] = region_entries(paid)[i - 1];
        i -= 1;
    }
    if (!region_spend(paid)) { return false; }
    region_entries(paid)[index] = item;
    paid->len += 1;
    return true;
}

fn region_range(region_counter mut* paid, ownership_api.region range, bool represented) bool {
    if (!region_spend(paid)) { return false; }
    if (!represented && range.key.kind == ownership_api.entity_kind.none &&
        range.source.kind == ownership_api.entity_kind.none && range.layout == null &&
        range.partitions.len == 0) {
        return true;
    }
    if (!region_insert(paid, region_identity{.region = range.key})) { return false; }
    u64 mut i = 0;
    while (i < range.partitions.len) {
        if (!region_spend(paid)) { return false; }
        if (!region_insert(paid, region_identity{range.key, range.partitions[i].key, true})) {
            return false;
        }
        i += 1;
    }
    return true;
}

fn region_removed(region_counter mut* paid, ownership_api.place_path place,
    ownership_api.place_path@ removed, bool mut* found) bool {
    *found = false;
    u64 mut i = 0;
    while (i < removed.len) {
        if (!region_spend(paid)) { return false; }
        ownership_api.place_path other = removed[i];
        if (same_entity(place.root, other.root) && place.residual == other.residual &&
            place.projections.len == other.projections.len) {
            u64 mut j = 0;
            while (j < place.projections.len) {
                if (!region_spend(paid)) { return false; }
                if (!same_projection(place.projections[j], other.projections[j])) { break; }
                j += 1;
            }
            if (j == place.projections.len) { *found = true; return true; }
        }
        i += 1;
    }
    return true;
}

fn region_contents(region_counter mut* paid, ownership_api.contents_fact fact) bool {
    u64 mut i = 0;
    while (i < fact.borrows.len) {
        if (!region_spend(paid)) { return false; }
        if (!region_range(paid, fact.borrows[i].range, true)) { return false; }
        i += 1;
    }
    return true;
}

// Sorts identities in place: by insertion up to 64 items, by a bottom-up merge sort above.
fn sort_identities(region_identity mut@ items) void {
    if (items.len < 2) { return; }
    if (items.len <= LOCAL_INDICES) {
        u64 mut k = 1;
        while (k < items.len) {
            region_identity item = items[k];
            u64 mut at = k;
            while (at > 0 && region_order(item, items[at - 1]) < 0) {
                items[at] = items[at - 1];
                at -= 1;
            }
            items[at] = item;
            k += 1;
        }
        return;
    }
    region_identity mut@ own scratch = new(region_identity, items.len);
    u64 mut width = 1;
    while (width < items.len) {
        u64 mut low = 0;
        while (low < items.len) {
            u64 middle = items.len - low < width ? items.len : low + width;
            u64 high = items.len - middle < width ? items.len : middle + width;
            u64 mut left = low;
            u64 mut right = middle;
            u64 mut out = low;
            while (out < high) {
                bool take_left = right >= high ||
                    (left < middle && region_order(items[left], items[right]) <= 0);
                if (take_left) { scratch[out] = items[left]; left += 1; }
                else { scratch[out] = items[right]; right += 1; }
                out += 1;
            }
            low = high;
        }
        u64 mut i = 0;
        while (i < items.len) { items[i] = scratch[i]; i += 1; }
        width = width > items.len / 2 ? items.len : width * 2;
    }
    del(scratch);
}

/// Ends the batch of a counter: it sorts the identities and keeps one of each equal run, so
/// len counts distinct identities as region_insert counts them. It pays one W unit for each
/// 64 identities it sorts. A counter without a batch is already settled.
fn region_settle(region_counter mut* paid) bool {
    if (!paid->batch) { return true; }
    paid->batch = false;
    u64 units = paid->len / ROWS_PER_UNIT + (paid->len % ROWS_PER_UNIT == 0 ? 0 : 1);
    u64 mut k = 0;
    while (k < units) {
        if (!region_spend(paid)) { return false; }
        k += 1;
    }
    region_identity mut@ items = region_entries(paid)[0..paid->len];
    sort_identities(items);
    u64 mut kept = 0;
    k = 0;
    while (k < items.len) {
        if (kept == 0 || region_order(items[kept - 1], items[k]) != 0) {
            items[kept] = items[k];
            kept += 1;
        }
        k += 1;
    }
    paid->len = kept;
    return true;
}

// Insertion and join covering share this retained-cardinality mapping.
fn measure_regions(state* s, ownership_api.services* svc, region_candidate candidate,
    ownership_api.work_kind kind, ownership_api.operation_position op,
    ownership_api.source_position at)
    region_measurement {
    region_counter mut paid = region_counter{.service = svc, .kind = kind, .operation = op,
        .source = at, .proof = s->proof};
    defer del(paid.identities);
    if (!ownership_api.successful(paid.proof)) { return region_measurement{paid.proof, 0}; }
    u64 mut i = 0;
    bool mut ok = true;
    while (ok && i < s->contents_len) {
        bool mut removed = false;
        ok = region_spend(&paid) &&
            region_removed(&paid, s->contents[i].place, candidate.removed, &removed);
        if (ok && !removed) { ok = region_contents(&paid, s->contents[i]); }
        i += 1;
    }
    u64 mut copy = 0;
    while (ok && copy < candidate.copies) {
        if (!region_spend(&paid)) { ok = false; break; }
        i = 0;
        while (ok && i < candidate.contents.len) {
            ok = region_spend(&paid) && region_contents(&paid, candidate.contents[i]);
            i += 1;
        }
        copy += 1;
    }
    i = 0;
    while (ok && i < s->allocations_len) {
        ok = region_spend(&paid) && region_insert(&paid,
            region_identity{.region = s->allocations[i].key});
        i += 1;
    }
    i = 0;
    while (ok && i < candidate.allocations.len) {
        ok = region_spend(&paid) && region_insert(&paid,
            region_identity{.region = candidate.allocations[i].key});
        i += 1;
    }
    i = 0;
    while (ok && i < s->regions_len) {
        ok = region_spend(&paid) && region_range(&paid, s->regions[i], true);
        i += 1;
    }
    i = 0;
    while (ok && i < candidate.regions.len) {
        ok = region_spend(&paid) && region_range(&paid, candidate.regions[i], true);
        i += 1;
    }
    i = 0;
    while (ok && i < s->nodes_len) {
        if (!region_spend(&paid)) { ok = false; break; }
        ownership_api.graph_node node = s->nodes[i];
        ownership_api.entity_id key = node.allocation.kind != ownership_api.entity_kind.none ?
            node.allocation : node.key;
        ok = region_insert(&paid, region_identity{.region = key});
        i += 1;
    }
    i = 0;
    while (ok && i < candidate.nodes.len) {
        if (!region_spend(&paid)) { ok = false; break; }
        ownership_api.graph_node node = candidate.nodes[i];
        ownership_api.entity_id key = node.allocation.kind != ownership_api.entity_kind.none ?
            node.allocation : node.key;
        ok = region_insert(&paid, region_identity{.region = key});
        i += 1;
    }
    i = 0;
    while (ok && i < s->edges_len) {
        ok = region_spend(&paid) && region_range(&paid, s->edges[i].range, false);
        i += 1;
    }
    i = 0;
    while (ok && i < candidate.edges.len) {
        ok = region_spend(&paid) && region_range(&paid, candidate.edges[i].range, false);
        i += 1;
    }
    return region_measurement{paid.proof, ok ? plus_count(paid.len, paid.unknown) : 0};
}

fn require_regions(state mut* s, ownership_api.services* svc, region_candidate candidate,
    charge_counts counts, ownership_api.operation_position op,
    ownership_api.source_position at) ownership_api.mutation_result {
    content_candidate mut content = content_candidate{};
    content.regions = candidate;
    content.count_regions = true;
    return require_content(s, svc, content, counts, op, at);
}

// The prospective contents keep the state facts outside `removed` and add the candidate facts.
// With places, the candidate adds one copy of contents[0] at each place.
struct guard_candidate {
    ownership_api.contents_fact@ contents;
    ownership_api.place_path@ places;
    ownership_api.place_path@ removed;
    ownership_api.correlation@ correlations;
}
struct shape_candidate {
    ownership_api.graph_edge@ edges;
    ownership_api.shape_description@ shapes;
}
// One mutator measures the content it changes, then checks it in one request.
struct content_candidate {
    region_candidate regions;
    guard_candidate guards;
    shape_candidate shapes;
    bool count_regions;
    bool count_guards;
    bool count_shapes;
}
struct unit_counter {
    ownership_api.services* service;
    ownership_api.work_kind kind;
    ownership_api.operation_position operation;
    ownership_api.source_position source;
    ownership_api.proof_status proof;
}

// A sorted count of n rows compares O(n log n) pairs. It pays one W unit for each 64 rows it
// reads, so its W grows with its work, and at least one unit when it reads any row.
u64 ROWS_PER_UNIT = 64;

fn rows_spend(unit_counter mut* paid, u64 rows) bool {
    u64 units = rows / ROWS_PER_UNIT + (rows % ROWS_PER_UNIT == 0 ? 0 : 1);
    u64 mut i = 0;
    while (i < units) {
        if (!unit_spend(paid)) { return false; }
        i += 1;
    }
    return true;
}

// Each counting step pays one W unit before it runs.
fn unit_spend(unit_counter mut* paid) bool {
    if (!ownership_api.successful(paid->proof)) { return false; }
    ownership_api.charge_result charged = ownership_api.charge_work(paid->service,
        paid->kind, paid->operation, paid->source);
    if (!charged.allowed) { paid->proof = charged.proof; }
    return charged.allowed;
}

fn guard_added(guard_candidate* c) u64 {
    if (c->contents.len == 0) { return 0; }
    return c->places.len > 0 ? c->places.len : c->contents.len;
}

// Returns false for a state fact that the candidate removes.
fn guard_fact_at(state* s, guard_candidate* c, u64 index,
    ownership_api.contents_fact mut* out) bool {
    if (index < s->contents_len) {
        *out = s->contents[index];
        return !selected(out->place, c->removed);
    }
    u64 added = index - s->contents_len;
    if (c->places.len == 0) { *out = c->contents[added]; return true; }
    *out = c->contents[0];
    out->place = c->places[added];
    return true;
}

/// Returns the G units of `count` exclusive alternatives of one place, value, or path.
/// One alternative is unconditional and gives none. Two or more give one unit each.
fn alternative_units(u64 count) u64 { return count >= 2 ? count : 0; }

/// Returns the largest number of exclusive alternatives whose G units fit `bound`.
fn alternatives_within(u64 bound) u64 { return bound >= 2 ? bound : 1; }

// The kinds of index that one merge sort orders.
enum sort_kind { contents_place, correlation_key, edge_key, shape_key }

fn edge_at(state* s, shape_candidate* c, u64 index) ownership_api.graph_edge {
    return index < s->edges_len ? s->edges[index] : c->edges[index - s->edges_len];
}

fn shape_at(state* s, shape_candidate* c, u64 index) ownership_api.shape_description {
    return index < s->shapes_len ? s->shapes[index] : c->shapes[index - s->shapes_len];
}

fn correlation_at(state* s, guard_candidate* c, u64 index) ownership_api.correlation {
    return index < s->correlations_len ? s->correlations[index] :
        c->correlations[index - s->correlations_len];
}

fn correlation_order(ownership_api.correlation a, ownership_api.correlation b) i32 {
    i32 c = ownership_keys.entity(a.value_version, b.value_version);
    if (c != 0) { return c; }
    return ownership_keys.entity(a.relation, b.relation);
}

// Equal keys keep their index order, so each count is deterministic.
fn index_order(state* s, guard_candidate* g, shape_candidate* h, sort_kind kind, u64 a, u64 b)
    i32 {
    i32 mut c = 0;
    if (kind == sort_kind.contents_place) {
        ownership_api.contents_fact mut x = ownership_api.contents_fact{};
        ownership_api.contents_fact mut y = ownership_api.contents_fact{};
        guard_fact_at(s, g, a, &x);
        guard_fact_at(s, g, b, &y);
        c = place_order(x.place, y.place);
    } else if (kind == sort_kind.correlation_key) {
        c = correlation_order(correlation_at(s, g, a), correlation_at(s, g, b));
    } else if (kind == sort_kind.edge_key) {
        c = ownership_keys.entity(edge_at(s, h, a).key, edge_at(s, h, b).key);
    } else {
        c = ownership_keys.entity(shape_at(s, h, a).key, shape_at(s, h, b).key);
    }
    if (c != 0) { return c; }
    return order_number(a, b);
}

// Index storage of one count. A count of up to 64 rows uses the fixed array and allocates
// nothing: a scratch block for each mutation reorders the allocator's free lists, so a program
// that repeats one round sees its blocks at changing addresses.
u64 LOCAL_INDICES = 64;

struct index_store {
    u64[LOCAL_INDICES] local;
    u64 mut@ own heap;
}

fn index_view(index_store mut* store, u64 count) u64 mut@ {
    if (count <= store->local.len) { return store->local[0..count]; }
    store->heap = new(u64, count);
    return store->heap[..];
}

// Sorts in place by insertion up to 64 items, and by a bottom-up merge sort above that.
// Both are stable and compare O(n log n) pairs for large n.
fn sort_indices(state* s, guard_candidate* g, shape_candidate* h, sort_kind kind,
    u64 mut@ items) void {
    if (items.len < 2) { return; }
    if (items.len <= LOCAL_INDICES) {
        u64 mut k = 1;
        while (k < items.len) {
            u64 item = items[k];
            u64 mut at = k;
            while (at > 0 && index_order(s, g, h, kind, item, items[at - 1]) < 0) {
                items[at] = items[at - 1];
                at -= 1;
            }
            items[at] = item;
            k += 1;
        }
        return;
    }
    u64 mut@ own scratch = new(u64, items.len);
    u64 mut width = 1;
    while (width < items.len) {
        u64 mut low = 0;
        while (low < items.len) {
            u64 middle = items.len - low < width ? items.len : low + width;
            u64 high = items.len - middle < width ? items.len : middle + width;
            u64 mut left = low;
            u64 mut right = middle;
            u64 mut out = low;
            while (out < high) {
                bool take_left = right >= high || (left < middle &&
                    index_order(s, g, h, kind, items[left], items[right]) <= 0);
                if (take_left) { scratch[out] = items[left]; left += 1; }
                else { scratch[out] = items[right]; right += 1; }
                out += 1;
            }
            low = high;
        }
        u64 mut i = 0;
        while (i < items.len) { items[i] = scratch[i]; i += 1; }
        width = width > items.len / 2 ? items.len : width * 2;
    }
    del(scratch);
}

// Finds a correlation that names this version at this root in the sorted correlations.
fn correlated(state* s, guard_candidate* c, u64@ sorted, ownership_api.contents_fact fact)
    bool {
    ownership_api.correlation wanted = ownership_api.correlation{.value_version =
        fact.value_version, .relation = fact.place.root};
    u64 mut low = 0;
    u64 mut high = sorted.len;
    while (low < high) {
        u64 middle = low + (high - low) / 2;
        ownership_api.correlation probe = correlation_at(s, c, sorted[middle]);
        i32 mut order = ownership_keys.entity(probe.value_version, wanted.value_version);
        if (order == 0) { order = ownership_keys.entity(probe.relation, wanted.relation); }
        if (order == 0) { return true; }
        if (order < 0) { low = middle + 1; } else { high = middle; }
    }
    return false;
}

/// Counts guarded alternatives of one prospective state. Insertion, join, and widening use it.
/// A place with k >= 2 distinct contents facts gives k units. A place with one fact gives one
/// unit when a correlation names its value version and root, and none otherwise.
/// Guard and correlation rows give no unit of their own.
/// A count pays one W unit for each 64 rows it reads, before it reads them; without rows it pays
/// none. It sorts the facts by place, so it compares O(n log n) pairs, plus the pairs inside one
/// place.
fn guard_units(state* s, ownership_api.services* svc, guard_candidate c,
    ownership_api.work_kind kind, ownership_api.operation_position op,
    ownership_api.source_position at) region_measurement {
    unit_counter mut paid = unit_counter{svc, kind, op, at, s->proof};
    if (!ownership_api.successful(paid.proof)) { return region_measurement{paid.proof, 0}; }
    u64 total = plus_count(s->contents_len, guard_added(&c));
    u64 links = plus_count(s->correlations_len, c.correlations.len);
    if (total == 0 && links == 0) { return region_measurement{paid.proof, 0}; }
    if (!rows_spend(&paid, plus_count(total, links))) { return region_measurement{paid.proof, 0}; }
    u64 mut live = 0;
    index_store mut fact_store = index_store{};
    defer del(fact_store.heap);
    u64 mut@ facts = index_view(&fact_store, total);
    u64 mut k = 0;
    while (k < total) {
        ownership_api.contents_fact mut fact = ownership_api.contents_fact{};
        if (guard_fact_at(s, &c, k, &fact)) { facts[live] = k; live += 1; }
        k += 1;
    }
    sort_indices(s, &c, null, sort_kind.contents_place, facts[0..live]);
    index_store mut link_store = index_store{};
    defer del(link_store.heap);
    u64 mut@ sorted = index_view(&link_store, links);
    k = 0;
    while (k < links) { sorted[k] = k; k += 1; }
    sort_indices(s, &c, null, sort_kind.correlation_key, sorted[0..links]);
    u64 mut units = 0;
    u64 mut first = 0;
    while (first < live) {
        ownership_api.contents_fact mut head = ownership_api.contents_fact{};
        guard_fact_at(s, &c, facts[first], &head);
        u64 mut end = first + 1;
        u64 mut distinct = 1;
        while (end < live) {
            ownership_api.contents_fact mut fact = ownership_api.contents_fact{};
            guard_fact_at(s, &c, facts[end], &fact);
            if (!same_place(fact.place, head.place)) { break; }
            bool mut repeated = false;
            u64 mut t = first;
            while (t < end && !repeated) {
                ownership_api.contents_fact mut other = ownership_api.contents_fact{};
                guard_fact_at(s, &c, facts[t], &other);
                repeated = same_contents(other, fact);
                t += 1;
            }
            if (!repeated) { distinct += 1; }
            end += 1;
        }
        u64 mut group = alternative_units(distinct);
        if (group == 0 && correlated(s, &c, sorted[0..links], head)) { group = 1; }
        units = plus_count(units, group);
        first = end;
    }
    return region_measurement{paid.proof, units};
}

fn shape_entries(ownership_api.shape_description shape) u64 {
    return plus_count(1, plus_count(shape.parameters.len,
        plus_count(shape.clauses.len, shape.descendants.len)));
}

/// Counts structural units of one prospective state. Insertion, join, and widening use it.
/// A distinct edge gives one unit. A distinct template gives one unit and one for each
/// parameter, clause, and descendant. Graph nodes give no unit.
/// A count pays for its rows as guard_units does. It sorts edges and templates by key and
/// compares equal keys.
fn shape_units(state* s, ownership_api.services* svc, shape_candidate c,
    ownership_api.work_kind kind, ownership_api.operation_position op,
    ownership_api.source_position at) region_measurement {
    unit_counter mut paid = unit_counter{svc, kind, op, at, s->proof};
    if (!ownership_api.successful(paid.proof)) { return region_measurement{paid.proof, 0}; }
    u64 mut units = 0;
    u64 edges = plus_count(s->edges_len, c.edges.len);
    u64 shapes = plus_count(s->shapes_len, c.shapes.len);
    if (edges == 0 && shapes == 0) { return region_measurement{paid.proof, 0}; }
    if (!rows_spend(&paid, plus_count(edges, shapes))) { return region_measurement{paid.proof, 0}; }
    index_store mut edge_store = index_store{};
    defer del(edge_store.heap);
    u64 mut@ order = index_view(&edge_store, edges);
    u64 mut k = 0;
    while (k < edges) { order[k] = k; k += 1; }
    sort_indices(s, null, &c, sort_kind.edge_key, order[0..edges]);
    k = 0;
    while (k < edges) {
        ownership_api.graph_edge edge = edge_at(s, &c, order[k]);
        bool mut repeated = false;
        u64 mut t = k;
        while (t > 0 && !repeated) {
            ownership_api.graph_edge other = edge_at(s, &c, order[t - 1]);
            if (!same_entity(other.key, edge.key)) { break; }
            repeated = same_edge(other, edge);
            t -= 1;
        }
        if (!repeated) { units = plus_count(units, 1); }
        k += 1;
    }
    index_store mut shape_store = index_store{};
    defer del(shape_store.heap);
    u64 mut@ templates = index_view(&shape_store, shapes);
    k = 0;
    while (k < shapes) { templates[k] = k; k += 1; }
    sort_indices(s, null, &c, sort_kind.shape_key, templates[0..shapes]);
    k = 0;
    while (k < shapes) {
        ownership_api.shape_description shape = shape_at(s, &c, templates[k]);
        bool mut repeated = false;
        u64 mut t = k;
        while (t > 0 && !repeated) {
            ownership_api.shape_description other = shape_at(s, &c, templates[t - 1]);
            if (!same_entity(other.key, shape.key)) { break; }
            repeated = same_shape(other, shape);
            t -= 1;
        }
        if (!repeated) { units = plus_count(units, shape_entries(shape)); }
        k += 1;
    }
    return region_measurement{paid.proof, units};
}

fn contents_counts(ownership_api.contents_fact fact) charge_counts {
    charge_counts mut c = charge_counts{};
    c.d = place_depth(fact.place);
    c.w = 1;
    u64 mut i = 0;
    while (i < fact.borrows.len) {
        c.d = max_count(c.d, place_depth(fact.borrows[i].containing));
        c.r = plus_count(c.r, region_count(fact.borrows[i].range));
        i += 1;
    }
    return c;
}

fn allocation_counts(ownership_api.allocation_fact fact) charge_counts {
    charge_counts mut c = charge_counts{};
    c.d = place_depth(fact.owner.place);
    c.r = 1;
    c.e = fact.history.len;
    c.w = 1;
    u64 mut i = 0;
    while (i < fact.history.len) {
        c.d = max_count(c.d, place_depth(fact.history[i].before.place));
        c.d = max_count(c.d, place_depth(fact.history[i].after.place));
        i += 1;
    }
    return c;
}

// Count retained history occurrences before E permission.
fn history_permission(state* s, ownership_api.services* svc, u64 incoming,
    ownership_api.work_kind kind, ownership_api.operation_position op,
    ownership_api.source_position at,
    charge_counts mut* counts) ownership_api.charge_result {
    ownership_api.charge_result mut permission = ownership_api.charge_work(svc,
        kind, op, at);
    if (!permission.allowed) { return permission; }
    u64 mut amount = incoming;
    u64 mut i = 0;
    while (i < s->allocations_len) {
        permission = ownership_api.charge_work(svc, kind, op, at);
        if (!permission.allowed) { return permission; }
        amount = plus_count(amount, s->allocations[i].history.len);
        i += 1;
    }
    counts->e = amount;
    return permission;
}

fn require_counts(state mut* s, ownership_api.services* svc,
    charge_counts counts, ownership_api.operation_position op,
    ownership_api.source_position at) ownership_api.mutation_result {
    return require_content(s, svc, content_candidate{}, counts, op, at);
}

fn measurement_failure(state* s, ownership_api.services* svc, ownership_api.proof_status proof,
    ownership_api.operation_position op, ownership_api.source_position at)
    ownership_api.mutation_result {
    ownership_api.mutation_result mut out = ownership_api.mutation_result{};
    out.proof = ownership_api.successful(s->proof) ? report_failure(svc, proof, op, at) :
        s->proof;
    return out;
}

/// Pays the work of a mutation, measures the content it changes, and checks the result.
/// The caller commits at once after an applied result. No callback or write runs between.
fn require_content(state mut* s, ownership_api.services* svc,
    content_candidate content, charge_counts counts, ownership_api.operation_position op,
    ownership_api.source_position at) ownership_api.mutation_result {
    ownership_api.mutation_result mut out = ownership_api.mutation_result{};
    out.proof = s->proof;
    if (!ownership_api.successful(s->proof)) { return out; }
    charge_counts mut prospective = counts;
    ownership_api.charge_result mut charged = ownership_api.charge_result{.allowed = true};
    u64 mut remaining = counts.w;
    while (remaining > 1) {
        charged = ownership_api.charge_work(svc, ownership_api.work_kind.transfer, op, at);
        if (!charged.allowed) {
            out.proof = report_failure(svc, charged.proof, op, at);
            return out;
        }
        remaining -= 1;
    }
    if (counts.e > 0) {
        ownership_api.charge_result measured = history_permission(s, svc, counts.e,
            ownership_api.work_kind.transfer,
            op, at, &prospective);
        if (!measured.allowed) {
            out.proof = report_failure(svc, measured.proof, op, at);
            return out;
        }
    }
    if (content.count_regions) {
        region_measurement measured = measure_regions(s, svc, content.regions,
            ownership_api.work_kind.transfer, op, at);
        if (!ownership_api.successful(measured.proof)) {
            return measurement_failure(s, svc, measured.proof, op, at);
        }
        prospective.r = measured.amount;
    }
    if (content.count_guards) {
        region_measurement measured = guard_units(s, svc, content.guards,
            ownership_api.work_kind.transfer, op, at);
        if (!ownership_api.successful(measured.proof)) {
            return measurement_failure(s, svc, measured.proof, op, at);
        }
        prospective.g = measured.amount;
    }
    if (content.count_shapes) {
        region_measurement measured = shape_units(s, svc, content.shapes,
            ownership_api.work_kind.transfer, op, at);
        if (!ownership_api.successful(measured.proof)) {
            return measurement_failure(s, svc, measured.proof, op, at);
        }
        prospective.h = measured.amount;
    }
    if (prospective.d == 0 && prospective.r == 0 && prospective.p == 0 && prospective.g == 0 &&
        prospective.h == 0 && prospective.e == 0 && prospective.w == 0) {
        out.proof = ownership_api.incomplete(ownership_api.incomplete_reason.invalid_input, op, at);
        return out;
    }
    ownership_api.charge_item[7] mut items = {};
    u64 mut count = 0;
    if (prospective.d > 0) {
        items[count] = ownership_api.charge_item{ownership_api.limit_category.d,
            ownership_api.limit_scope.path, prospective.d};
        count += 1;
    }
    if (prospective.r > 0) {
        items[count] = ownership_api.charge_item{ownership_api.limit_category.r,
            ownership_api.limit_scope.state, prospective.r};
        count += 1;
    }
    if (prospective.p > 0) {
        items[count] = ownership_api.charge_item{ownership_api.limit_category.p,
            ownership_api.limit_scope.state, prospective.p};
        count += 1;
    }
    if (prospective.g > 0) {
        items[count] = ownership_api.charge_item{ownership_api.limit_category.g,
            ownership_api.limit_scope.state, prospective.g};
        count += 1;
    }
    if (prospective.h > 0) {
        items[count] = ownership_api.charge_item{ownership_api.limit_category.h,
            ownership_api.limit_scope.state, prospective.h};
        count += 1;
    }
    if (prospective.e > 0) {
        items[count] = ownership_api.charge_item{ownership_api.limit_category.e,
            ownership_api.limit_scope.function, prospective.e};
        count += 1;
    }
    if (prospective.w > 0) {
        items[count] = ownership_api.charge_item{ownership_api.limit_category.w,
            ownership_api.limit_scope.computation, 1};
        count += 1;
    }
    ownership_api.charge_request req = ownership_api.charge_request{
        ownership_api.work_kind.transfer, op, at, items[0..count]};
    charged = ownership_api.charge(svc, &req);
    if (!charged.allowed) {
        out.proof = charged.proof;
        if (charged.limit.present &&
            charged.proof.terminal.reason == ownership_api.incomplete_reason.work_limit &&
            charged.limit.category != ownership_api.limit_category.w &&
            charged.limit.category != ownership_api.limit_category.v) {
            out.precision_lost = true;
            out.loss.category = charged.limit.category;
            out.loss.bound = charged.limit.bound;
            out.loss.first_source = at;
            out.loss.relation.function = op.function;
            out.loss.relation.kind = ownership_api.entity_kind.relation;
            out.loss.relation.ordinal = op.operation;
            out.loss.reason = ownership_api.incomplete_reason.work_limit;
            return out;
        }
        out.proof = report_failure(svc, out.proof, op, at);
        return out;
    }
    out.applied = true;
    return out;
}

fn require_charge(state mut* s, ownership_api.services* svc,
    ownership_api.limit_category category, u64 amount,
    ownership_api.operation_position op, ownership_api.source_position at)
    ownership_api.mutation_result {
    // Guarded alternatives and shapes have their own count functions. Other categories are invalid.
    charge_counts mut counts = charge_counts{};
    bool known = category == ownership_api.limit_category.d ||
        category == ownership_api.limit_category.r || category == ownership_api.limit_category.p ||
        category == ownership_api.limit_category.e || category == ownership_api.limit_category.w;
    if (amount == 0 || !known) { return require_counts(s, svc, counts, op, at); }
    if (category == ownership_api.limit_category.d) { counts.d = amount; }
    if (category == ownership_api.limit_category.r) { counts.r = amount; }
    if (category == ownership_api.limit_category.p) { counts.p = amount; }
    if (category == ownership_api.limit_category.e) { counts.e = amount; }
    counts.w = category == ownership_api.limit_category.w ? amount : 1;
    return require_counts(s, svc, counts, op, at);
}

fn report_failure(ownership_api.services* svc, ownership_api.proof_status proof,
    ownership_api.operation_position op, ownership_api.source_position at)
    ownership_api.proof_status {
    ownership_api.event_descriptor mut event = ownership_api.event_descriptor{};
    event.key.function = op.function;
    event.key.kind = ownership_api.entity_kind.event;
    event.key.ordinal = op.operation;
    event.operation = op;
    event.source = at;
    event.kind = ownership_api.event_kind.incomplete_proof;
    if (proof.terminal.reason == ownership_api.incomplete_reason.work_limit) {
        event.kind = ownership_api.event_kind.work_failure;
    }
    event.evidence = ownership_api.evidence_kind.abstract_possibility;
    event.reason = proof.terminal.reason;
    event.relation = proof.terminal.relation;
    event.text = "ownership state cannot prove the requested update";
    ownership_api.event_request request = ownership_api.event_request{event, proof};
    ownership_api.event_result result = ownership_api.record_event(svc, &request);
    return result.proof;
}

fn bad_selection(state mut* s, ownership_api.services* svc,
    ownership_api.operation_position op,
    ownership_api.source_position at) ownership_api.mutation_result {
    ownership_api.mutation_result mut out = ownership_api.mutation_result{};
    if (!ownership_api.successful(s->proof)) { out.proof = s->proof; return out; }
    out.proof = ownership_api.incomplete(
        ownership_api.incomplete_reason.missing_correspondence, op, at);
    out.proof = report_failure(svc, out.proof, op, at);
    return out;
}

fn add_contents(state mut* s, ownership_api.services* svc,
    ownership_api.contents_fact fact, ownership_api.operation_position op,
    ownership_api.source_position at) ownership_api.mutation_result {
    ownership_api.contents_fact[1] added = {fact};
    content_candidate mut content = content_candidate{.count_regions = true,
        .count_guards = true};
    content.regions = region_candidate{.contents = added[..], .copies = 1};
    content.guards = guard_candidate{.contents = added[..]};
    ownership_api.mutation_result result = require_content(s, svc, content,
        contents_counts(fact), op, at);
    if (!result.applied) { return result; }
    append_contents(s, fact);
    return result;
}

fn add_source(state mut* s, ownership_api.services* svc,
    ownership_api.source_fact fact, ownership_api.operation_position op,
    ownership_api.source_position at) ownership_api.mutation_result {
    if (source_index(s, fact.key) != U64_MAX) { return bad_selection(s, svc, op, at); }
    ownership_api.mutation_result result = require_charge(
        s, svc, ownership_api.limit_category.w, 1, op, at);
    if (!result.applied) { return result; }
    append_sources(s, fact);
    return result;
}

fn add_allocation(state mut* s, ownership_api.services* svc,
    ownership_api.allocation_fact fact, ownership_api.operation_position op,
    ownership_api.source_position at) ownership_api.mutation_result {
    if (allocation_index(s, fact.key) != U64_MAX) { return bad_selection(s, svc, op, at); }
    ownership_api.allocation_fact[1] added = {fact};
    region_candidate candidate = region_candidate{.allocations = added[..]};
    ownership_api.mutation_result result = require_regions(s, svc, candidate,
        allocation_counts(fact), op, at);
    if (!result.applied) { return result; }
    append_allocations(s, fact);
    return result;
}

fn add_region(state mut* s, ownership_api.services* svc,
    ownership_api.region fact, ownership_api.operation_position op,
    ownership_api.source_position at) ownership_api.mutation_result {
    u64 mut i = 0;
    while (i < s->regions_len) {
        if (same_entity(s->regions[i].key, fact.key)) { return bad_selection(s, svc, op, at); }
        i += 1;
    }
    charge_counts mut counts = charge_counts{};
    counts.r = region_count(fact);
    counts.w = 1;
    ownership_api.region[1] added = {fact};
    region_candidate candidate = region_candidate{.regions = added[..]};
    ownership_api.mutation_result result = require_regions(s, svc, candidate, counts, op, at);
    if (!result.applied) { return result; }
    append_regions(s, fact);
    return result;
}

fn add_node(state mut* s, ownership_api.services* svc,
    ownership_api.graph_node fact, ownership_api.operation_position op,
    ownership_api.source_position at) ownership_api.mutation_result {
    u64 mut i = 0;
    while (i < s->nodes_len) {
        if (same_entity(s->nodes[i].key, fact.key)) { return bad_selection(s, svc, op, at); }
        i += 1;
    }
    ownership_api.graph_node[1] added = {fact};
    region_candidate candidate = region_candidate{.nodes = added[..]};
    charge_counts counts = charge_counts{.w = 1};
    ownership_api.mutation_result result = require_regions(s, svc, candidate, counts, op, at);
    if (!result.applied) { return result; }
    append_nodes(s, fact);
    return result;
}

fn add_edge(state mut* s, ownership_api.services* svc,
    ownership_api.graph_edge fact, ownership_api.operation_position op,
    ownership_api.source_position at) ownership_api.mutation_result {
    u64 mut i = 0;
    while (i < s->edges_len) {
        if (same_entity(s->edges[i].key, fact.key)) { return bad_selection(s, svc, op, at); }
        i += 1;
    }
    charge_counts mut counts = charge_counts{};
    counts.d = place_depth(fact.place);
    counts.r = region_count(fact.range);
    counts.w = 1;
    ownership_api.graph_edge[1] added = {fact};
    content_candidate mut content = content_candidate{.count_regions = true,
        .count_shapes = true};
    content.regions = region_candidate{.edges = added[..]};
    content.shapes = shape_candidate{.edges = added[..]};
    ownership_api.mutation_result result = require_content(s, svc, content, counts, op, at);
    if (!result.applied) { return result; }
    append_edges(s, fact);
    return result;
}

fn add_shape(state mut* s, ownership_api.services* svc,
    ownership_api.shape_description fact, ownership_api.operation_position op,
    ownership_api.source_position at) ownership_api.mutation_result {
    u64 mut i = 0;
    while (i < s->shapes_len) {
        if (same_entity(s->shapes[i].key, fact.key)) { return bad_selection(s, svc, op, at); }
        i += 1;
    }
    charge_counts counts = charge_counts{.w = 1};
    ownership_api.shape_description[1] added = {fact};
    content_candidate mut content = content_candidate{.count_shapes = true};
    content.shapes = shape_candidate{.shapes = added[..]};
    ownership_api.mutation_result result = require_content(s, svc, content, counts, op, at);
    if (!result.applied) { return result; }
    append_shapes(s, fact);
    return result;
}

fn add_predicate(state mut* s, ownership_api.services* svc,
    ownership_api.predicate_atom fact, ownership_api.operation_position op,
    ownership_api.source_position at) ownership_api.mutation_result {
    u64 mut i = 0;
    while (i < s->predicates_len) {
        if (same_entity(s->predicates[i].key, fact.key)) { return bad_selection(s, svc, op, at); }
        i += 1;
    }
    ownership_api.mutation_result result = require_charge(
        s, svc, ownership_api.limit_category.p, plus_count(s->predicates_len, 1), op, at);
    if (!result.applied) { return result; }
    append_predicates(s, fact);
    return result;
}

fn add_guard(state mut* s, ownership_api.services* svc,
    ownership_api.guard_fact fact, ownership_api.operation_position op,
    ownership_api.source_position at) ownership_api.mutation_result {
    u64 mut i = 0;
    while (i < s->guards_len) {
        if (same_entity(s->guards[i].key, fact.key)) { return bad_selection(s, svc, op, at); }
        i += 1;
    }
    // A guard row adds no guarded alternative. It still pays its work and the current count.
    content_candidate content = content_candidate{.count_guards = true};
    ownership_api.mutation_result result = require_content(s, svc, content,
        charge_counts{.w = 1}, op, at);
    if (!result.applied) { return result; }
    append_guards(s, fact);
    return result;
}

fn add_correlation(state mut* s, ownership_api.services* svc,
    ownership_api.correlation fact, ownership_api.operation_position op,
    ownership_api.source_position at) ownership_api.mutation_result {
    ownership_api.correlation[1] added = {fact};
    content_candidate mut content = content_candidate{.count_guards = true};
    content.guards = guard_candidate{.correlations = added[..]};
    ownership_api.mutation_result result = require_content(s, svc, content,
        charge_counts{.w = 1}, op, at);
    if (!result.applied) { return result; }
    append_correlations(s, fact);
    return result;
}

fn add_loss(state mut* s, ownership_api.services* svc,
    ownership_api.lost_fact fact, ownership_api.operation_position op,
    ownership_api.source_position at) ownership_api.mutation_result {
    ownership_api.mutation_result result = require_charge(
        s, svc, ownership_api.limit_category.w, 1, op, at);
    if (!result.applied) { return result; }
    append_losses(s, fact);
    return result;
}

fn same_entity(ownership_api.entity_id a, ownership_api.entity_id b) bool {
    return ownership_keys.entity(a, b) == 0;
}

fn order_number(u64 a, u64 b) i32 {
    if (a < b) { return -1; }
    if (a > b) { return 1; }
    return 0;
}

fn scalar_order(ownership_api.scalar_fact a, ownership_api.scalar_fact b) i32 {
    i32 c = order_number(cast(a.kind, u64), cast(b.kind, u64));
    if (c != 0) { return c; }
    if (a.value < b.value) { return -1; }
    if (a.value > b.value) { return 1; }
    return ownership_keys.entity(a.symbol, b.symbol);
}

fn projection_order(ownership_api.projection a, ownership_api.projection b) i32 {
    i32 mut c = order_number(cast(a.kind, u64), cast(b.kind, u64));
    if (c != 0) { return c; }
    c = order_number(cast(a.field, u64), cast(b.field, u64));
    if (c != 0) { return c; }
    c = scalar_order(a.index, b.index);
    if (c != 0) { return c; }
    return ownership_keys.entity(a.captured_version, b.captured_version);
}

/// Orders places canonically. Equal order means `same_place`.
fn place_order(ownership_api.place_path a, ownership_api.place_path b) i32 {
    i32 mut c = ownership_keys.entity(a.root, b.root);
    if (c != 0) { return c; }
    u64 mut i = 0;
    while (i < a.projections.len && i < b.projections.len) {
        c = projection_order(a.projections[i], b.projections[i]);
        if (c != 0) { return c; }
        i += 1;
    }
    c = order_number(a.projections.len, b.projections.len);
    if (c != 0) { return c; }
    return order_number(cast(a.residual, u64), cast(b.residual, u64));
}

fn same_scalar(ownership_api.scalar_fact a, ownership_api.scalar_fact b) bool {
    return a.kind == b.kind && a.value == b.value && same_entity(a.symbol, b.symbol);
}

fn same_projection(ownership_api.projection a, ownership_api.projection b) bool {
    return a.kind == b.kind && a.field == b.field && same_scalar(a.index, b.index) &&
        same_entity(a.captured_version, b.captured_version);
}

fn same_place(ownership_api.place_path a, ownership_api.place_path b) bool {
    if (!same_entity(a.root, b.root) || a.residual != b.residual ||
        a.projections.len != b.projections.len) { return false; }
    u64 mut i = 0;
    while (i < a.projections.len) {
        if (!same_projection(a.projections[i], b.projections[i])) { return false; }
        i += 1;
    }
    return true;
}

fn same_window(ownership_api.byte_window a, ownership_api.byte_window b) bool {
    return same_scalar(a.begin, b.begin) && same_scalar(a.end, b.end) &&
        a.arithmetic_proved == b.arithmetic_proved;
}

fn same_leaf(ownership_api.layout_leaf a, ownership_api.layout_leaf b) bool {
    return same_window(a.bytes, b.bytes) && a.ty == b.ty && a.owning == b.owning &&
        a.padding == b.padding;
}

fn same_partition(ownership_api.region_partition a, ownership_api.region_partition b) bool {
    return same_entity(a.key, b.key) && same_entity(a.membership, b.membership) &&
        same_window(a.bytes, b.bytes) && a.residual == b.residual;
}

fn same_region(ownership_api.region a, ownership_api.region b) bool {
    if (!same_entity(a.key, b.key) || !same_entity(a.source, b.source) ||
        !same_scalar(a.offset, b.offset) || !same_window(a.access, b.access) ||
        !same_scalar(a.extent, b.extent) || a.alignment != b.alignment ||
        a.layout != b.layout || a.residual != b.residual ||
        a.leaves.len != b.leaves.len || a.partitions.len != b.partitions.len) { return false; }
    u64 mut i = 0;
    while (i < a.leaves.len) {
        if (!same_leaf(a.leaves[i], b.leaves[i])) { return false; }
        i += 1;
    }
    i = 0;
    while (i < a.partitions.len) {
        if (!same_partition(a.partitions[i], b.partitions[i])) { return false; }
        i += 1;
    }
    return true;
}

fn same_source(ownership_api.source_fact a, ownership_api.source_fact b) bool {
    return same_entity(a.key, b.key) && a.kind == b.kind && a.validity == b.validity &&
        same_entity(a.allocation, b.allocation) &&
        ownership_keys.operation(a.boundary, b.boundary) == 0;
}

fn same_borrow(ownership_api.borrow_relation a, ownership_api.borrow_relation b) bool {
    return same_entity(a.key, b.key) && same_entity(a.value_version, b.value_version) &&
        same_place(a.containing, b.containing) && same_entity(a.source, b.source) &&
        same_region(a.range, b.range) &&
        a.representation_complete == b.representation_complete;
}

fn same_contents(ownership_api.contents_fact a, ownership_api.contents_fact b) bool {
    if (!same_place(a.place, b.place) || a.kind != b.kind ||
        !same_entity(a.value_version, b.value_version) ||
        !same_scalar(a.span_length, b.span_length) || a.owner_empty != b.owner_empty ||
        a.borrows.len != b.borrows.len) { return false; }
    u64 mut i = 0;
    while (i < a.borrows.len) {
        if (!same_borrow(a.borrows[i], b.borrows[i])) { return false; }
        i += 1;
    }
    return true;
}

fn same_count(ownership_api.multiplicity a, ownership_api.multiplicity b) bool {
    return a.zero == b.zero && a.one == b.one && a.many == b.many;
}

fn same_owner(ownership_api.owner_location a, ownership_api.owner_location b) bool {
    return same_place(a.place, b.place) && a.detached == b.detached &&
        a.transfer_pending == b.transfer_pending;
}

fn same_history(ownership_api.history_fact a, ownership_api.history_fact b) bool {
    return same_entity(a.allocation, b.allocation) &&
        ownership_keys.operation(a.operation, b.operation) == 0 &&
        ownership_keys.source(a.source, b.source) == 0 && a.kind == b.kind &&
        same_owner(a.before, b.before) && same_owner(a.after, b.after);
}

fn same_allocation(ownership_api.allocation_fact a, ownership_api.allocation_fact b) bool {
    if (!same_entity(a.key, b.key) || !same_entity(a.site, b.site) ||
        a.validity != b.validity || !same_count(a.count, b.count) ||
        a.obligation != b.obligation || !same_owner(a.owner, b.owner) ||
        !same_scalar(a.logical_length, b.logical_length) ||
        a.history.len != b.history.len) { return false; }
    u64 mut i = 0;
    while (i < a.history.len) {
        if (!same_history(a.history[i], b.history[i])) { return false; }
        i += 1;
    }
    return true;
}

fn same_node(ownership_api.graph_node a, ownership_api.graph_node b) bool {
    return same_entity(a.key, b.key) && same_entity(a.allocation, b.allocation) &&
        same_entity(a.structural_template, b.structural_template) && a.residual == b.residual;
}

fn same_edge(ownership_api.graph_edge a, ownership_api.graph_edge b) bool {
    return same_entity(a.key, b.key) && same_entity(a.from, b.from) &&
        same_entity(a.to, b.to) && a.kind == b.kind && same_place(a.place, b.place) &&
        same_region(a.range, b.range);
}

fn same_entities(ownership_api.entity_id@ a, ownership_api.entity_id@ b) bool {
    if (a.len != b.len) { return false; }
    u64 mut i = 0;
    while (i < a.len) { if (!same_entity(a[i], b[i])) { return false; } i += 1; }
    return true;
}

fn same_shape(ownership_api.shape_description a, ownership_api.shape_description b) bool {
    return same_entity(a.key, b.key) && same_entities(a.parameters, b.parameters) &&
        same_entities(a.clauses, b.clauses) && same_entities(a.descendants, b.descendants) &&
        a.acyclic_proved == b.acyclic_proved &&
        a.separation_proved == b.separation_proved && a.residual == b.residual;
}

fn same_predicate(ownership_api.predicate_atom a, ownership_api.predicate_atom b) bool {
    return same_entity(a.key, b.key) && a.kind == b.kind &&
        same_entity(a.left, b.left) && same_entity(a.right, b.right) &&
        same_scalar(a.lower, b.lower) && same_scalar(a.upper, b.upper);
}

fn same_guard(ownership_api.guard_fact a, ownership_api.guard_fact b) bool {
    return same_entity(a.key, b.key) && same_entities(a.positive, b.positive) &&
        same_entities(a.negative, b.negative);
}

fn same_correlation(ownership_api.correlation a, ownership_api.correlation b) bool {
    return same_entity(a.guard, b.guard) && same_entity(a.value_version, b.value_version) &&
        same_entity(a.relation, b.relation);
}

fn same_loss(ownership_api.lost_fact a, ownership_api.lost_fact b) bool {
    return a.category == b.category && a.bound == b.bound &&
        ownership_keys.source(a.first_source, b.first_source) == 0 &&
        same_entity(a.relation, b.relation) && a.reason == b.reason;
}

fn same_exhaustion(ownership_api.exhaustion a, ownership_api.exhaustion b) bool {
    return a.present == b.present && a.category == b.category && a.scope == b.scope &&
        a.work == b.work && a.used == b.used && a.bound == b.bound &&
        a.attempted == b.attempted &&
        ownership_keys.operation(a.operation, b.operation) == 0 &&
        ownership_keys.source(a.source, b.source) == 0 && a.saturated == b.saturated;
}

fn same_proof(ownership_api.proof_status a, ownership_api.proof_status b) bool {
    return a.kind == b.kind && a.failed == b.failed &&
        a.terminal.present == b.terminal.present &&
        a.terminal.reason == b.terminal.reason &&
        ownership_keys.operation(a.terminal.operation, b.terminal.operation) == 0 &&
        ownership_keys.source(a.terminal.source, b.terminal.source) == 0 &&
        same_entity(a.terminal.relation, b.terminal.relation) &&
        same_exhaustion(a.terminal.limit, b.terminal.limit);
}

// Clone copies active records and nested slices. It does not follow graph edges.
fn clone(state* input) state {
    state mut out = empty();
    out.proof = input->proof;
    u64 mut contents_i = 0;
    while (contents_i < input->contents_len) {
        append_contents(&out, input->contents[contents_i]);
        contents_i += 1;
    }
    u64 mut sources_i = 0;
    while (sources_i < input->sources_len) {
        append_sources(&out, input->sources[sources_i]);
        sources_i += 1;
    }
    u64 mut allocations_i = 0;
    while (allocations_i < input->allocations_len) {
        append_allocations(&out, input->allocations[allocations_i]);
        allocations_i += 1;
    }
    u64 mut regions_i = 0;
    while (regions_i < input->regions_len) {
        append_regions(&out, input->regions[regions_i]);
        regions_i += 1;
    }
    u64 mut nodes_i = 0;
    while (nodes_i < input->nodes_len) {
        append_nodes(&out, input->nodes[nodes_i]);
        nodes_i += 1;
    }
    u64 mut edges_i = 0;
    while (edges_i < input->edges_len) {
        append_edges(&out, input->edges[edges_i]);
        edges_i += 1;
    }
    u64 mut shapes_i = 0;
    while (shapes_i < input->shapes_len) {
        append_shapes(&out, input->shapes[shapes_i]);
        shapes_i += 1;
    }
    u64 mut predicates_i = 0;
    while (predicates_i < input->predicates_len) {
        append_predicates(&out, input->predicates[predicates_i]);
        predicates_i += 1;
    }
    u64 mut guards_i = 0;
    while (guards_i < input->guards_len) {
        append_guards(&out, input->guards[guards_i]);
        guards_i += 1;
    }
    u64 mut correlations_i = 0;
    while (correlations_i < input->correlations_len) {
        append_correlations(&out, input->correlations[correlations_i]);
        correlations_i += 1;
    }
    u64 mut losses_i = 0;
    while (losses_i < input->losses_len) {
        append_losses(&out, input->losses[losses_i]);
        losses_i += 1;
    }
    return out;
}

// Equality compares facts, not allocation addresses or insertion order.
fn equal(state* a, state* b) bool {
    if (!same_proof(a->proof, b->proof)) { return false; }
    if (a->contents_len != b->contents_len) { return false; }
    u64 mut contents_i = 0;
    while (contents_i < a->contents_len) {
        u64 mut left = 0;
        u64 mut right = 0;
        u64 mut j = 0;
        while (j < a->contents_len) {
            if (same_contents(a->contents[contents_i], a->contents[j])) { left += 1; }
            if (same_contents(a->contents[contents_i], b->contents[j])) { right += 1; }
            j += 1;
        }
        if (left != right) { return false; }
        contents_i += 1;
    }
    if (a->sources_len != b->sources_len) { return false; }
    u64 mut sources_i = 0;
    while (sources_i < a->sources_len) {
        u64 mut left = 0;
        u64 mut right = 0;
        u64 mut j = 0;
        while (j < a->sources_len) {
            if (same_source(a->sources[sources_i], a->sources[j])) { left += 1; }
            if (same_source(a->sources[sources_i], b->sources[j])) { right += 1; }
            j += 1;
        }
        if (left != right) { return false; }
        sources_i += 1;
    }
    if (a->allocations_len != b->allocations_len) { return false; }
    u64 mut allocations_i = 0;
    while (allocations_i < a->allocations_len) {
        u64 mut left = 0;
        u64 mut right = 0;
        u64 mut j = 0;
        while (j < a->allocations_len) {
            if (same_allocation(a->allocations[allocations_i], a->allocations[j])) { left += 1; }
            if (same_allocation(a->allocations[allocations_i], b->allocations[j])) { right += 1; }
            j += 1;
        }
        if (left != right) { return false; }
        allocations_i += 1;
    }
    if (a->regions_len != b->regions_len) { return false; }
    u64 mut regions_i = 0;
    while (regions_i < a->regions_len) {
        u64 mut left = 0;
        u64 mut right = 0;
        u64 mut j = 0;
        while (j < a->regions_len) {
            if (same_region(a->regions[regions_i], a->regions[j])) { left += 1; }
            if (same_region(a->regions[regions_i], b->regions[j])) { right += 1; }
            j += 1;
        }
        if (left != right) { return false; }
        regions_i += 1;
    }
    if (a->nodes_len != b->nodes_len) { return false; }
    u64 mut nodes_i = 0;
    while (nodes_i < a->nodes_len) {
        u64 mut left = 0;
        u64 mut right = 0;
        u64 mut j = 0;
        while (j < a->nodes_len) {
            if (same_node(a->nodes[nodes_i], a->nodes[j])) { left += 1; }
            if (same_node(a->nodes[nodes_i], b->nodes[j])) { right += 1; }
            j += 1;
        }
        if (left != right) { return false; }
        nodes_i += 1;
    }
    if (a->edges_len != b->edges_len) { return false; }
    u64 mut edges_i = 0;
    while (edges_i < a->edges_len) {
        u64 mut left = 0;
        u64 mut right = 0;
        u64 mut j = 0;
        while (j < a->edges_len) {
            if (same_edge(a->edges[edges_i], a->edges[j])) { left += 1; }
            if (same_edge(a->edges[edges_i], b->edges[j])) { right += 1; }
            j += 1;
        }
        if (left != right) { return false; }
        edges_i += 1;
    }
    if (a->shapes_len != b->shapes_len) { return false; }
    u64 mut shapes_i = 0;
    while (shapes_i < a->shapes_len) {
        u64 mut left = 0;
        u64 mut right = 0;
        u64 mut j = 0;
        while (j < a->shapes_len) {
            if (same_shape(a->shapes[shapes_i], a->shapes[j])) { left += 1; }
            if (same_shape(a->shapes[shapes_i], b->shapes[j])) { right += 1; }
            j += 1;
        }
        if (left != right) { return false; }
        shapes_i += 1;
    }
    if (a->predicates_len != b->predicates_len) { return false; }
    u64 mut predicates_i = 0;
    while (predicates_i < a->predicates_len) {
        u64 mut left = 0;
        u64 mut right = 0;
        u64 mut j = 0;
        while (j < a->predicates_len) {
            if (same_predicate(a->predicates[predicates_i], a->predicates[j])) { left += 1; }
            if (same_predicate(a->predicates[predicates_i], b->predicates[j])) { right += 1; }
            j += 1;
        }
        if (left != right) { return false; }
        predicates_i += 1;
    }
    if (a->guards_len != b->guards_len) { return false; }
    u64 mut guards_i = 0;
    while (guards_i < a->guards_len) {
        u64 mut left = 0;
        u64 mut right = 0;
        u64 mut j = 0;
        while (j < a->guards_len) {
            if (same_guard(a->guards[guards_i], a->guards[j])) { left += 1; }
            if (same_guard(a->guards[guards_i], b->guards[j])) { right += 1; }
            j += 1;
        }
        if (left != right) { return false; }
        guards_i += 1;
    }
    if (a->correlations_len != b->correlations_len) { return false; }
    u64 mut correlations_i = 0;
    while (correlations_i < a->correlations_len) {
        u64 mut left = 0;
        u64 mut right = 0;
        u64 mut j = 0;
        while (j < a->correlations_len) {
            if (same_correlation(a->correlations[correlations_i], a->correlations[j])) {
                left += 1;
            }
            if (same_correlation(a->correlations[correlations_i], b->correlations[j])) {
                right += 1;
            }
            j += 1;
        }
        if (left != right) { return false; }
        correlations_i += 1;
    }
    if (a->losses_len != b->losses_len) { return false; }
    u64 mut losses_i = 0;
    while (losses_i < a->losses_len) {
        u64 mut left = 0;
        u64 mut right = 0;
        u64 mut j = 0;
        while (j < a->losses_len) {
            if (same_loss(a->losses[losses_i], a->losses[j])) { left += 1; }
            if (same_loss(a->losses[losses_i], b->losses[j])) { right += 1; }
            j += 1;
        }
        if (left != right) { return false; }
        losses_i += 1;
    }
    return true;
}

fn has_residual(ownership_api.place_path p) bool {
    if (p.residual) { return true; }
    u64 mut i = 0;
    while (i < p.projections.len) {
        if (p.projections[i].kind == ownership_api.projection_kind.residual) { return true; }
        i += 1;
    }
    return false;
}

fn selected(ownership_api.place_path p, ownership_api.place_path@ aliases) bool {
    u64 mut i = 0;
    while (i < aliases.len) {
        if (same_place(p, aliases[i])) { return true; }
        i += 1;
    }
    return false;
}

// The caller proves that all aliases name one concrete destination.
fn strong_contents(state mut* s, ownership_api.services* svc,
    ownership_api.contents_fact fact, ownership_api.place_path@ aliases, bool unique,
    ownership_api.operation_position op, ownership_api.source_position at)
    ownership_api.mutation_result {
    if (!unique || aliases.len == 0) { return bad_selection(s, svc, op, at); }
    u64 mut i = 0;
    while (i < aliases.len) {
        if (has_residual(aliases[i])) { return bad_selection(s, svc, op, at); }
        u64 mut j = i + 1;
        while (j < aliases.len) {
            if (same_place(aliases[i], aliases[j])) { return bad_selection(s, svc, op, at); }
            j += 1;
        }
        i += 1;
    }
    charge_counts mut counts = contents_counts(fact);
    counts.d = 0;
    counts.r = 0;
    i = 0;
    while (i < aliases.len) {
        ownership_api.contents_fact mut next = fact;
        next.place = aliases[i];
        charge_counts part = contents_counts(next);
        counts.d = max_count(counts.d, part.d);
        counts.r = plus_count(counts.r, part.r);
        i += 1;
    }
    ownership_api.contents_fact[1] added = {fact};
    content_candidate mut content = content_candidate{.count_regions = true,
        .count_guards = true};
    content.regions = region_candidate{.contents = added[..], .copies = aliases.len,
        .removed = aliases};
    content.guards = guard_candidate{.contents = added[..], .places = aliases,
        .removed = aliases};
    ownership_api.mutation_result result = require_content(s, svc, content, counts, op, at);
    if (!result.applied) { return result; }
    i = 0;
    while (i < s->contents_len) {
        if (selected(s->contents[i].place, aliases)) {
            u64 mut j = i + 1;
            while (j < s->contents_len) { s->contents[j - 1] = s->contents[j]; j += 1; }
            s->contents_len -= 1;
        } else { i += 1; }
    }
    i = 0;
    while (i < aliases.len) {
        ownership_api.contents_fact mut next = fact;
        next.place = aliases[i];
        append_contents(s, next);
        i += 1;
    }
    return result;
}

// Each selected retains its old contents and a guarded new alternative.
fn weak_contents(state mut* s, ownership_api.services* svc,
    ownership_api.contents_fact fact, ownership_api.place_path@ selections,
    ownership_api.entity_id guard, ownership_api.operation_position op,
    ownership_api.source_position at) ownership_api.mutation_result {
    if (selections.len == 0 || guard.kind != ownership_api.entity_kind.guard) {
        return bad_selection(s, svc, op, at);
    }
    charge_counts mut counts = charge_counts{};
    counts.w = 1;
    ownership_api.correlation mut@ own links = new(ownership_api.correlation, selections.len);
    defer del(links);
    u64 mut j = 0;
    while (j < selections.len) {
        ownership_api.contents_fact mut selected = fact;
        selected.place = selections[j];
        charge_counts part = contents_counts(selected);
        counts.d = max_count(counts.d, part.d);
        counts.r = plus_count(counts.r, part.r);
        links[j] = ownership_api.correlation{guard, fact.value_version, selections[j].root};
        j += 1;
    }
    ownership_api.contents_fact[1] added = {fact};
    content_candidate mut content = content_candidate{.count_regions = true,
        .count_guards = true};
    content.regions = region_candidate{.contents = added[..], .copies = selections.len};
    content.guards = guard_candidate{.contents = added[..], .places = selections,
        .correlations = links[..]};
    ownership_api.mutation_result result = require_content(s, svc, content, counts, op, at);
    if (!result.applied) { return result; }
    u64 mut i = 0;
    while (i < selections.len) {
        ownership_api.contents_fact mut next = fact;
        next.place = selections[i];
        append_contents(s, next);
        append_correlations(s, ownership_api.correlation{guard, fact.value_version,
            selections[i].root});
        i += 1;
    }
    return result;
}

fn source_index(state* s, ownership_api.entity_id key) u64 {
    u64 mut i = 0;
    while (i < s->sources_len) {
        if (same_entity(s->sources[i].key, key)) { return i; }
        i += 1;
    }
    return U64_MAX;
}

fn allocation_index(state* s, ownership_api.entity_id key) u64 {
    u64 mut i = 0;
    while (i < s->allocations_len) {
        if (same_entity(s->allocations[i].key, key)) { return i; }
        i += 1;
    }
    return U64_MAX;
}

// Ending slot storage changes only its source validity.
fn end_source(state mut* s, ownership_api.services* svc,
    ownership_api.entity_id key, ownership_api.operation_position op,
    ownership_api.source_position at) ownership_api.mutation_result {
    u64 i = source_index(s, key);
    if (i == U64_MAX) { return bad_selection(s, svc, op, at); }
    charge_counts mut counts = charge_counts{};
    counts.w = 1;
    ownership_api.mutation_result result = require_counts(s, svc, counts, op, at);
    if (!result.applied) { return result; }
    s->sources[i].validity = ownership_api.validity_kind.ended;
    return result;
}

fn append_history(state mut* s, ownership_api.allocation_fact mut* a,
    ownership_api.history_fact entry) void {
    if (a->history.len == U64_MAX) { panic("ownership_state.history: capacity overflow"); }
    u64 len = a->history.len;
    ownership_api.history_fact mut@ own pending = new(ownership_api.history_fact, len + 1);
    u64 mut i = 0;
    while (i < len) { pending[i] = a->history[i]; i += 1; }
    pending[len] = entry;
    a->history = copy_histories(s, pending[..]);
    del(pending);
}

// This mutator records a selected transfer. It does not move slot storage.
fn transfer_owner(state mut* s, ownership_api.services* svc,
    ownership_api.entity_id key, ownership_api.owner_location after, bool selected_one,
    ownership_api.operation_position op, ownership_api.source_position at)
    ownership_api.mutation_result {
    u64 i = allocation_index(s, key);
    if (!selected_one || i == U64_MAX || !s->allocations[i].obligation ||
        s->allocations[i].validity != ownership_api.validity_kind.live ||
        has_residual(s->allocations[i].owner.place) ||
        !s->allocations[i].count.one || s->allocations[i].count.zero ||
        s->allocations[i].count.many) {
        return bad_selection(s, svc, op, at);
    }
    charge_counts mut counts = charge_counts{};
    counts.d = max_count(place_depth(s->allocations[i].owner.place),
        place_depth(after.place));
    counts.e = 1;
    counts.w = 1;
    ownership_api.mutation_result result = require_counts(s, svc, counts, op, at);
    if (!result.applied) { return result; }
    ownership_api.owner_location before = s->allocations[i].owner;
    append_history(s, &s->allocations[i], ownership_api.history_fact{
        key, op, at, ownership_api.effect_kind.transfer, before, after});
    s->allocations[i].owner = copy_owner(s, after);
    return result;
}

// The caller proves the selected member's owned leaves empty.
fn release_member(state mut* s, ownership_api.services* svc,
    ownership_api.entity_id key, bool leaves_empty_proved,
    ownership_api.operation_position op, ownership_api.source_position at)
    ownership_api.mutation_result {
    u64 i = allocation_index(s, key);
    if (!leaves_empty_proved || i == U64_MAX || !s->allocations[i].obligation ||
        s->allocations[i].validity != ownership_api.validity_kind.live ||
        has_residual(s->allocations[i].owner.place) ||
        s->allocations[i].count.zero ||
        (!s->allocations[i].count.one && !s->allocations[i].count.many)) {
        return bad_selection(s, svc, op, at);
    }
    charge_counts mut counts = charge_counts{};
    counts.d = place_depth(s->allocations[i].owner.place);
    counts.e = 1;
    counts.w = 1;
    ownership_api.mutation_result result = require_counts(s, svc, counts, op, at);
    if (!result.applied) { return result; }
    bool had_one = s->allocations[i].count.one;
    bool had_many = s->allocations[i].count.many;
    ownership_api.owner_location before = s->allocations[i].owner;
    ownership_api.owner_location after = ownership_api.owner_location{};
    append_history(s, &s->allocations[i], ownership_api.history_fact{
        key, op, at, ownership_api.effect_kind.release, before, after});
    s->allocations[i].count.zero = had_one;
    s->allocations[i].count.one = had_many;
    s->allocations[i].count.many = had_many;
    if (!had_many) {
        s->allocations[i].obligation = false;
        s->allocations[i].validity = ownership_api.validity_kind.released;
        s->allocations[i].owner = after;
    }
    u64 mut j = 0;
    while (j < s->sources_len) {
        if (same_entity(s->sources[j].allocation, key)) {
            if (!had_many) {
                s->sources[j].validity = ownership_api.validity_kind.released;
            } else if (s->sources[j].validity == ownership_api.validity_kind.live) {
                s->sources[j].validity = ownership_api.validity_kind.unknown;
            }
        }
        j += 1;
    }
    return result;
}
