/// Stores module namespaces, block scopes, and built-in names.
/// Lookup searches blocks, the module, and then the universe.
import ast;
import containers;
import diag;
import std.strmap;

/// Identifies what a bound name denotes.
/// Import bindings do not become exports of the importing module.
enum bind_kind {
    b_none,      // never stored; the kind of a binding that was not found
    b_fn, // `fn`
    b_extern_fn, // `extern fn`
    b_struct, // `struct`
    b_enum, // `enum`
    b_var, // a module-level constant or `mut` global
    b_module, // `import a.b;`: the name denotes a module
    b_symbol,    // `import a.b.c;`: the name denotes a declaration of a.b
    b_local, // a local of a block
    b_param, // a parameter
}

/// A namespace or a block: the module namespace has no parent, every block
/// scope has one.
enum scope_kind {
    s_module,
    s_block,
}

// The first non-zero capacity of the binding vector; growth doubles from
// there.
u64 ITEMS_MIN_CAP = 8;

/// Describes one bound name.
/// `module` identifies a module binding. `to` identifies an imported declaration.
struct binding {
    string name;
    bind_kind kind;
    diag.loc loc;   // where the name is declared or bound
    // The declaring or importing node. It is `node mut*` because the checker
    // annotates the node it reached through the binding, and a cast adds no
    // `mut`.
    ast.node mut* node;
    void* module;
    binding* to;
}

/// Stores a module namespace or block scope.
/// A zero value is an empty module namespace.
struct scope {
    scope_kind kind;
    scope mut* parent; // null for a module namespace
    strmap.str_map index; // name -> position in `items`
    binding mut* own mut@ own items;
    u64 len;
}

// Sets the kind and parent of an empty scope.
fn init(scope mut* s, scope_kind kind, scope mut* parent) void {
    s->kind = kind;
    s->parent = parent;
}

// Clears the bindings and index.
fn free(scope mut* s) void {
    u64 mut i = 0;
    while (i < s->len) {
        binding mut* own b = move(s->items[i]);
        del(b);
        i += 1;
    }
    del(s->items);
    s->len = 0;
    strmap.free(&s->index);
}

// Ensures room for one more binding, growing to the largest of ITEMS_MIN_CAP
// and twice the capacity.
fn reserve(scope mut* s) void {
    if (s->len < s->items.len) {
        return;
    }
    u64 mut cap = ITEMS_MIN_CAP;
    if (s->items.len >= cap) {
        // nothing here may detect an overflow by performing one
        if (s->items.len > containers.U64_MAX / 2) {
            panic("scope.reserve: capacity overflow");
        }
        cap = s->items.len * 2;
    }
    binding mut* own mut@ own bigger = new(binding mut* own, cap);
    u64 mut i = 0;
    while (i < s->len) {
        bigger[i] = move(s->items[i]);
        i += 1;
    }
    del(s->items);
    s->items = move(bigger);
}

/// Binds `name` in `s` and returns the new binding.
/// Returns null when the scope already binds that name, regardless of either binding kind.
fn declare(scope mut* s, string name, bind_kind kind, diag.loc at,
                        ast.node mut* decl) binding mut* {
    // a struct `node` and a function `node` cannot coexist
    if (strmap.has(&s->index, name)) {
        return null;
    }
    binding mut* own fresh = new(binding);
    fresh->name = name;
    fresh->kind = kind;
    fresh->loc = at;
    fresh->node = decl;
    reserve(s);
    s->items[s->len] = move(fresh);
    s->len += 1;
    strmap.put(&s->index, s->items[s->len - 1]->name, cast(s->len - 1, i64));
    return s->items[s->len - 1];
}

/// Returns the binding of `name` in `s` alone, or null.
fn find(scope* s, string name) binding* {
    i64 mut at = 0;
    if (!strmap.get(&s->index, name, &at)) {
        return null;
    }
    return s->items[cast(at, u64)];
}

/// The binding of `name` in `s`, then in every enclosing scope, or null.
// is_universe identifies the universe.
fn lookup(scope* s, string name) binding* {
    scope* mut cur = s;
    while (cur != null) {
        binding* found = find(cur, name);
        if (found != null) {
            return found;
        }
        cur = cur->parent;
    }
    return null;
}

/// Finds `name` in block scopes and stops before the module namespace.
/// Callers use this result to prevent a local from shadowing an outer local or parameter.
fn find_in_blocks(scope* s, string name) binding* {
    scope* mut cur = s;
    while (cur != null && cur->kind == scope_kind.s_block) {
        binding* found = find(cur, name);
        if (found != null) {
            return found;
        }
        cur = cur->parent;
    }
    return null;
}

// The number of bindings of `s`, in declaration order.
fn count(scope* s) u64 {
    return s->len;
}

/// The binding at `i`; an index at or past count is a violated precondition and
/// panics, since the slots beyond it hold stale pointers.
fn at(scope* s, u64 i) binding* {
    if (i >= s->len) {
        panic("scope.at: index out of range");
    }
    return s->items[i];
}

/// Returns true when the binding denotes a declaration instead of an import binding.
fn is_declaration(binding* b) bool {
    switch (b->kind) {
    case bind_kind.b_fn, bind_kind.b_extern_fn, bind_kind.b_struct, bind_kind.b_enum,
         bind_kind.b_var:
        return true;
    case bind_kind.b_none, bind_kind.b_module, bind_kind.b_symbol, bind_kind.b_local,
         bind_kind.b_param:
        return false;
    }
}

// ---- the universe ----------------------------------------------------------------

// The builtins, looked up after every scope: `del`, `move`, `assert`, `panic`,
// `print`, `println`, `eprint`, `eprintln`, `fprint`, and `fprintln`.
u64 UNIVERSE_COUNT = 10;

/// Returns the `i`-th universe name in lookup order.
/// An index at or past UNIVERSE_COUNT is a broken precondition.
fn universe_at(u64 i) string {
    if (i == 0) {
        return "del";
    } else if (i == 1) {
        return "move";
    } else if (i == 2) {
        return "assert";
    } else if (i == 3) {
        return "panic";
    } else if (i == 4) {
        return "print";
    } else if (i == 5) {
        return "println";
    } else if (i == 6) {
        return "eprint";
    } else if (i == 7) {
        return "eprintln";
    } else if (i == 8) {
        return "fprint";
    } else if (i == 9) {
        return "fprintln";
    }
    panic("scope.universe_at: index out of range");
}

// Whether `name` is a universe name. A module declaration or local can shadow
// one. The universe name is then inaccessible in that scope. This query does
// not report an error.
fn is_universe(string name) bool {
    u64 mut i = 0;
    while (i < UNIVERSE_COUNT) {
        if (name == universe_at(i)) {
            return true;
        }
        i += 1;
    }
    return false;
}
