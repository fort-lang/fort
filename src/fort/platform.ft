// platform: the Linux build target of the self-hosted compiler.
//
// The compiler stores these values in its module. A Mac build uses a generated
// platform module beside its generated entry file.
// D14.1, D14.3

/// The target that builds this compiler binary.
/// D14.1
string BUILT_TARGET = "x86_64-linux-gnu";

/// The clang program this compiler uses by default.
/// D14.3
string DEFAULT_CC = "clang";

/// Whether this compiler uses the Mac link line.
/// D14.3
bool IS_MAC = false;
