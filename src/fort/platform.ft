// platform: the Linux build target of the self-hosted compiler.
//
// The compiler stores its build target and C fcntl call form in this module.
// A Mac build uses a generated platform module beside its entry file.
// D14.1, D14.3

/// The target that builds this compiler binary.
/// D14.1
string BUILT_TARGET = "x86_64-linux-gnu";

/// The clang program this compiler uses by default.
/// D14.3
string DEFAULT_CC = "clang";

/// Whether this compiler uses the Mac link line.
/// D14.3
bool IS_MAC = false;

/// Sets a file-descriptor flag. The Linux fixed C extern keeps the pinned call form.
/// D9.8, D14.3
extern fn fcntl(i32 fd, i32 cmd, i32 arg) i32;

fn fcntl_setfd(i32 fd, i32 cmd, i32 arg) i32 {
    return fcntl(fd, cmd, arg);
}
