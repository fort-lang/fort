#!/bin/bash
# tools/vm: drive the fort development VM.
# Each worktree shares the VM from the main checkout.
# Commands run in the guest directory that matches the host working directory.
set -eu

usage() {
    cat <<'EOF'
usage: tools/vm <subcommand> [args]

VM lifecycle (vagrant runs in the VM directory, see below):
  up                      create, provision and start the VM; cache its ssh config
  halt                    stop the VM
  destroy [-f]            remove the VM (the box stays installed)
  status                  show the VM state
  provision               re-run tools/provision.sh in the VM
  ssh                     open a login shell in the guest directory of the host cwd

Commands in the guest (sourcing /etc/profile.d/fort.sh, ulimit -c 0):
  run <cmd...>            run a shell command in the guest directory of the host cwd
  configure [preset]      cmake --preset <preset>
  build [preset] [target] cmake --build --preset <preset> [--target <target>]
  test [preset]           ctest --preset <preset>
  workflow [preset]       cmake --workflow --preset <preset>
  check | check-lang | check-all | format | format-check | tidy | lines [preset]
                          cmake --build --preset <preset> --target <name>
  gate                    the merge gate: the `gate` target of the debug preset

The cmake subcommands run at the top of the host git worktree; the preset
defaults to debug. The VM directory is $FORT_VM_DIR, or else the main checkout
of the current git repository; the host cwd must be inside it for ssh, run and
the cmake subcommands. It appears as /vagrant in the guest. FORT_VM_CPUS and
FORT_VM_MEMORY size the VM at `up`; FORT_VM_SLOT=2 selects a second VM brought
up from the same directory (default cpus 4), see notes/environment.md 1. Every
subcommand that drives build/<preset> holds the worktree in build/vm-hold.pid
and refuses to run beside another; stop a build with kill -TERM, never INT. A
guest command that exits 255 is
indistinguishable from a failed ssh connection and is re-run via vagrant ssh.
EOF
}

die() {
    echo "tools/vm: $*" >&2
    exit 1
}

# Usage errors exit 2, like the bare `tools/vm`.
usage_error() {
    echo "tools/vm: $*" >&2
    exit 2
}

# ---- VM directory and path mapping ---------------------------------------------
physical_path() {
    (CDPATH='' cd -- "$1" 2>/dev/null && pwd -P) || die "not a directory: $1"
}

find_vm_dir() {
    if [ -n "${FORT_VM_DIR:-}" ]; then
        physical_path "$FORT_VM_DIR"
        return
    fi
    local common
    common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) ||
        die "not inside a git repository and FORT_VM_DIR is not set"
    physical_path "$(dirname "$common")"
}

# Print the guest path of host directory $1 (must lie inside the VM directory).
guest_path() {
    local host
    host=$(physical_path "$1") || return 1
    if [ "$host" = "$VM_DIR" ]; then
        echo /vagrant
    elif [ "${host#"$VM_DIR"/}" != "$host" ]; then
        echo "/vagrant/${host#"$VM_DIR"/}"
    else
        die "$host is not inside the VM directory $VM_DIR"
    fi
}

# The directory the cmake subcommands run in: the top of the current worktree.
worktree_top() {
    git rev-parse --show-toplevel 2>/dev/null || pwd -P
}

# Help needs no VM directory; everything else does.
[ $# -ge 1 ] || { usage >&2; exit 2; }
case "$1" in
-h | --help | help)
    usage
    exit 0
    ;;
esac

VM_DIR=$(find_vm_dir) || exit 1
[ -f "$VM_DIR/Vagrantfile" ] || die "no Vagrantfile in $VM_DIR"

# FORT_VM_SLOT selects a VM from the same checkout.
# Each VM mounts the checkout at /vagrant and has separate Vagrant state.
# Slot 1 is the default. The build hold prevents two slots from building one worktree.
VM_SLOT=${FORT_VM_SLOT:-1}
case "$VM_SLOT" in
[1-9]) ;;
*) die "FORT_VM_SLOT must be a single digit 1-9, not '$VM_SLOT'" ;;
esac
if [ "$VM_SLOT" = 1 ]; then
    VM_STATE="$VM_DIR/.vagrant"
    unset VAGRANT_DOTFILE_PATH FORT_VM_SLOT
else
    VM_STATE="$VM_DIR/.vagrant-$VM_SLOT"
    export VAGRANT_DOTFILE_PATH="$VM_STATE"
    export FORT_VM_SLOT="$VM_SLOT"
    # Slots 1 and 2 default to 6 and 4 CPUs, for a total of 10.
    # FORT_VM_CPUS can override the default for this slot.
    export FORT_VM_CPUS="${FORT_VM_CPUS:-4}"
fi
SSH_CONFIG="$VM_STATE/ssh-config"

vagrant_cmd() {
    VAGRANT_CWD="$VM_DIR" vagrant "$@"
}

cache_ssh_config() {
    local tmp
    mkdir -p "$VM_STATE"
    tmp=$(mktemp "$SSH_CONFIG.XXXXXX") || return 1
    if vagrant_cmd ssh-config > "$tmp"; then
        mv "$tmp" "$SSH_CONFIG"
    else
        rm -f "$tmp"
        return 1
    fi
}

# ---- running commands in the guest ----------------------------------------------
# guest_script <guest-dir> <command>: the shell text every guest command runs.
guest_script() {
    printf '. /etc/profile.d/fort.sh; ulimit -c 0; cd %q || exit 1; %s' \
        "$1" "$2"
}

ssh_tty_flag() {
    if [ -t 0 ] && [ -t 1 ]; then echo -t; else echo -T; fi
}

# guest_run <tty-flag> <guest-dir> <command>: run through the cached ssh config;
# fall back to `vagrant ssh` (and refresh the cache) when the connection fails.
# ssh exits 255 on a connection failure, so a guest command that itself exits
# 255 is re-run through the fallback. The connect timeout keeps a paused or
# stopped VM from hanging the wrapper before the fallback runs.
GUEST_CHILD=""
guest_run() {
    local script status
    script=$(guest_script "$2" "$3")
    if [ -f "$SSH_CONFIG" ]; then
        status=0
        if [ "$1" = -T ]; then
            # Bash defers a trap while a foreground child runs.
            # Run ssh as a waited job so that a trap can stop it.
            ssh -T -o ConnectTimeout=10 -F "$SSH_CONFIG" default -- "$script" 0<&0 &
            GUEST_CHILD=$!
            wait "$GUEST_CHILD" || status=$?
            GUEST_CHILD=""
        else
            ssh "$1" -o ConnectTimeout=10 -F "$SSH_CONFIG" default -- "$script" || status=$?
        fi
        [ "$status" -ne 255 ] && return "$status"
        echo "tools/vm: cached ssh config failed; falling back to vagrant ssh" >&2
    fi
    cache_ssh_config || true
    # vagrant ssh allocates a pty unless -T is passed through to ssh. The -T
    # form is a waited job for the same reason as above. A trap must be able
    # to end the step on this path too.
    if [ "$1" = -T ]; then
        status=0
        vagrant_cmd ssh -c "$script" -- -T 0<&0 &
        GUEST_CHILD=$!
        wait "$GUEST_CHILD" || status=$?
        GUEST_CHILD=""
        return "$status"
    fi
    vagrant_cmd ssh -c "$script" -- "$1"
}

# run_here <command>: run in the guest directory of the host cwd.
# guest_path dies when the directory is outside the VM directory. The
# assignment is a separate statement so that exit is not swallowed by the
# command substitution.
run_here() {
    local dir
    dir=$(guest_path "$PWD") || exit 1
    guest_run "$(ssh_tty_flag)" "$dir" "$1"
}

# run_top <command>: run at the top of the current worktree.
run_top() {
    local dir
    gate_acquire
    dir=$(guest_path "$(worktree_top)") || exit 1
    guest_run "$(ssh_tty_flag)" "$dir" "$1"
}

cmake_target() {
    local target=$1 preset=${2:-debug}
    run_top "$(printf 'cmake --build --preset %q --target %q' "$preset" "$target")"
}

# The build hold: stop a second build driving a worktree one already holds.
# Every subcommand that drives build/<preset> takes it (run_top, cmake_target);
# `tools/vm run` does not, since it runs whatever it is given.
#
# One worktree has one build/<preset>. Two builds can replace the same objects
# and report a false test failure.
#
# An orphan appears because a gate is usually started in the background of a
# wrapper shell. When that wrapper dies the gate is reparented to init and a
# kill aimed at the wrapper never reaches it. This hold does not stop the
# leftover -- it makes it harmless, by refusing the second gate rather than
# letting the two share a directory.
#
# The file build/vm-hold.pid holds the pid and belongs to tools/vm; nothing
# else writes it. A hold whose process is gone is stale and is taken, which is
# what makes a killed build leave no wedged worktree behind. `tools/vm run` and
# `tools/vm ssh` take no hold: the first runs whatever it is given. And the
# second is an interactive shell that may sit open for hours.
GATE_HOLD=""
gate_release() {
    # Only remove a hold this process still owns. After the stale-hold race in
    # `gate_acquire`, the file can name another live build. A user can also
    # remove the hold in response to the refusal message.
    if [ -n "$GATE_HOLD" ]; then
        if [ "$(cat "$GATE_HOLD" 2>/dev/null)" = "$$" ]; then
            rm -f "$GATE_HOLD"
        fi
        GATE_HOLD=""
    fi
    return 0
}

# gate_interrupt <signal>: end the guest step, release the hold, and die by the
# signal so the caller sees the status it expects (130 or 143).
gate_interrupt() {
    if [ -n "$GUEST_CHILD" ]; then
        kill -TERM "$GUEST_CHILD" 2>/dev/null || true
        wait "$GUEST_CHILD" 2>/dev/null || true
        GUEST_CHILD=""
    fi
    gate_release
    trap - "$1"
    kill -s "$1" $$
}

# hold_alive <pid>: the pid is digits and a process with it is alive. `kill -0`
# signals nothing; it only asks. macOS can
# recycle a pid after 99999. The message checks
# the process before it advises the user to stop it.
hold_alive() {
    case "$1" in '' | *[!0-9]*) return 1 ;; esac
    kill -0 "$1" 2>/dev/null
}

gate_acquire() {
    [ -n "$GATE_HOLD" ] && return 0
    local top holder hold
    top=$(worktree_top)
    mkdir -p "$top/build"
    hold="$top/build/vm-hold.pid"
    # noclobber makes the test and write one step for live holds.
    # Replacing a stale hold is not atomic. Two commands can race after its removal.
    while ! (set -o noclobber; echo $$ > "$hold") 2>/dev/null; do
        holder=$(cat "$hold" 2>/dev/null || true)
        if hold_alive "$holder"; then
            echo "tools/vm: a build already holds this worktree (pid $holder)." >&2
            echo "tools/vm: two builds in one worktree collide in build/<preset> and the" >&2
            echo "tools/vm: failure reads as a test failure." >&2
            if [ "$(lsof -a -p "$holder" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p')" = "$top" ]; then
                echo "tools/vm: wait for it; or if it is an orphan (ppid 1), stop it" >&2
                echo "tools/vm: with: kill -TERM $holder" >&2
            else
                echo "tools/vm: that pid is not a build in this worktree, so the hold" >&2
                echo "tools/vm: is stale (a recycled pid): rm $hold" >&2
            fi
            exit 1
        fi
        echo "tools/vm: taking a stale hold from pid ${holder:-unknown}" >&2
        rm -f "$hold"
    done
    [ "$(cat "$hold" 2>/dev/null)" = "$$" ] || die "lost the race for $hold"
    GATE_HOLD="$hold"
    trap 'gate_release' EXIT
    # TERM and HUP stop the guest step, release the hold, and raise the signal again.
    # INT supports commands from a terminal. Use TERM for background commands.
    trap 'gate_interrupt INT' INT
    trap 'gate_interrupt TERM' TERM
    trap 'gate_interrupt HUP' HUP
}

# ---- subcommands ---------------------------------------------------------------
cmd=$1
shift

case "$cmd" in
up)
    vagrant_cmd up "$@"
    cache_ssh_config
    ;;
halt | status | provision)
    vagrant_cmd "$cmd" "$@"
    ;;
destroy)
    vagrant_cmd destroy "$@"
    rm -f "$SSH_CONFIG"
    ;;
ssh)
    [ $# -eq 0 ] || usage_error "ssh takes no arguments (use run)"
    dir=$(guest_path "$PWD") || exit 1
    guest_run -t "$dir" 'exec bash -l'
    ;;
run)
    [ $# -ge 1 ] || usage_error "run needs a command"
    run_here "$*"
    ;;
configure)
    [ $# -le 1 ] || usage_error "configure takes at most a preset"
    run_top "$(printf 'cmake --preset %q' "${1:-debug}")"
    ;;
build)
    [ $# -le 2 ] || usage_error "build takes at most a preset and a target"
    if [ $# -eq 2 ]; then
        cmake_target "$2" "$1"
    else
        run_top "$(printf 'cmake --build --preset %q' "${1:-debug}")"
    fi
    ;;
test)
    [ $# -le 1 ] || usage_error "test takes at most a preset"
    run_top "$(printf 'ctest --preset %q' "${1:-debug}")"
    ;;
workflow)
    [ $# -le 1 ] || usage_error "workflow takes at most a preset"
    run_top "$(printf 'cmake --workflow --preset %q' "${1:-debug}")"
    ;;
check | check-lang | check-all | format | format-check | tidy | lines)
    [ $# -le 1 ] || usage_error "$cmd takes at most a preset"
    cmake_target "$cmd" "${1:-debug}"
    ;;
gate)
    [ $# -eq 0 ] || usage_error "gate takes no arguments"
    run_top 'tools/target linux gate'
    echo "tools/vm gate: green"
    ;;
*)
    usage >&2
    usage_error "unknown subcommand: $cmd"
    ;;
esac
