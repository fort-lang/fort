{
  "comment": [
    "The table of the gate of the oracle test (test/fort/owner/oracle_test.ft) and of its",
    "disposition table (test/fort/support/disposition.ft): an item that the compiler accepts with",
    "no error and no report line gives no event that is an error (D17.11, D17.20, D17.21). A row",
    "mutes one error kind, changes when a `leak` or a `leak at exit` is an error, breaks the",
    "order of the table, changes a count, a family or a kind of KNOWN, or lets the gate accept",
    "an item that the compiler refuses. The sources are test sources and no part of the compiler",
    "binary, so the build writes both into one file and the md5 guard reads that file. The stage",
    "runs the oracle test, which compiles the two sources itself. The table runs in the Linux VM",
    "with the debug preset and the default runner after `tools/vm build`."
  ],
  "sources": [
    "test/fort/support/disposition.ft",
    "test/fort/owner/oracle_test.ft"
  ],
  "binary": "build/Linux/debug/disposition_gate.txt",
  "build": "cat test/fort/support/disposition.ft test/fort/owner/oracle_test.ft > build/Linux/debug/disposition_gate.txt",
  "stages": [
    {
      "name": "the oracle test",
      "command": "python3 test/lang/run_tests.py --root test/fort --fort build/Linux/debug/fort --std-dir build/Linux/debug/std --timeout 1500 -j 2 owner/oracle_test"
    }
  ],
  "mutations": [
    {
      "decision": "D17.21-error",
      "file": "test/fort/support/disposition.ft",
      "old": "    row{shadow.event_kind.ev_use_after_move, disposition_kind.dk_error, \"D17.21\"},",
      "new": "    row{shadow.event_kind.ev_use_after_move, disposition_kind.dk_trusted, \"D17.21\"},",
      "what": "the gate does not judge a `use after move`, so the item that KNOWN lists passes"
    },
    {
      "decision": "D17.11-error",
      "file": "test/fort/support/disposition.ft",
      "old": "    row{shadow.event_kind.ev_overwrite, disposition_kind.dk_error, \"D17.11\"},",
      "new": "    row{shadow.event_kind.ev_overwrite, disposition_kind.dk_trusted, \"D17.11\"},",
      "what": "the gate does not judge an `overwrite`"
    },
    {
      "decision": "D17.20-error",
      "file": "test/fort/support/disposition.ft",
      "old": "    row{shadow.event_kind.ev_leak, disposition_kind.dk_error, \"D17.20\"},",
      "new": "    row{shadow.event_kind.ev_leak, disposition_kind.dk_trusted, \"D17.20\"},",
      "what": "the gate does not judge a `leak`"
    },
    {
      "decision": "D17.20-exit",
      "file": "test/fort/support/disposition.ft",
      "old": "        return !ev->cycle;",
      "new": "        return false;",
      "what": "each `leak at exit` is no error, as that of a cycle of owners"
    },
    {
      "decision": "D17.20-cycle",
      "file": "test/fort/support/disposition.ft",
      "old": "        return !ev->cycle;",
      "new": "        return true;",
      "what": "a `leak at exit` of a cycle of owners is an error"
    },
    {
      "decision": "D17.20-each-end",
      "file": "test/fort/support/disposition.ft",
      "old": "    return end == interpreter.outcome_kind.oc_abort || end == interpreter.outcome_kind.oc_trap;",
      "new": "    return end != interpreter.outcome_kind.oc_none;",
      "what": "a `leak` is no error, however its run ends"
    },
    {
      "decision": "D17.20-exit-end",
      "file": "test/fort/support/disposition.ft",
      "old": "    return end == interpreter.outcome_kind.oc_abort || end == interpreter.outcome_kind.oc_trap;",
      "new": "    return end != interpreter.outcome_kind.oc_return;",
      "what": "a `leak` is an error only in a run that ends with the return of its function"
    },
    {
      "decision": "D17.20-no-end",
      "file": "test/fort/support/disposition.ft",
      "old": "    return end == interpreter.outcome_kind.oc_abort || end == interpreter.outcome_kind.oc_trap;",
      "new": "    return end == interpreter.outcome_kind.oc_none;",
      "what": "a `leak` in a run that ends in a runtime error is an error"
    },
    {
      "decision": "table-order",
      "file": "test/fort/support/disposition.ft",
      "old": "    row{shadow.event_kind.ev_double_release, disposition_kind.dk_trusted, \"A1\"},\n    row{shadow.event_kind.ev_invalid_release, disposition_kind.dk_trusted, \"A2\"},",
      "new": "    row{shadow.event_kind.ev_invalid_release, disposition_kind.dk_trusted, \"A2\"},\n    row{shadow.event_kind.ev_double_release, disposition_kind.dk_trusted, \"A1\"},",
      "what": "two rows of the table stand out of the order of the kinds"
    },
    {
      "decision": "gate-refused",
      "file": "test/fort/owner/oracle_test.ft",
      "old": "    } else if (of->refused) {\n        n->refused_errors[kind] += 1;",
      "new": "    } else if (true) {\n        n->refused_errors[kind] += 1;",
      "what": "each error event counts as one of a refused item"
    },
    {
      "decision": "gate-failing",
      "file": "test/fort/owner/oracle_test.ft",
      "old": "        if (it->errors == 0) {\n            continue;\n        }\n        u64 kind = disposition.index_of(it->failure.kind);",
      "new": "        if (it->errors < 9) {\n            continue;\n        }\n        u64 kind = disposition.index_of(it->failure.kind);",
      "what": "an accepted item with fewer than 9 error events passes the gate"
    },
    {
      "decision": "known-low",
      "file": "test/fort/owner/oracle_test.ft",
      "old": "    known{family.fm_exhaustive, shadow.event_kind.ev_use_after_move, 1,",
      "new": "    known{family.fm_exhaustive, shadow.event_kind.ev_use_after_move, 0,",
      "what": "KNOWN does not count the item that fails, so an unlisted item fails"
    },
    {
      "decision": "known-high",
      "file": "test/fort/owner/oracle_test.ft",
      "old": "    known{family.fm_exhaustive, shadow.event_kind.ev_use_after_move, 1,",
      "new": "    known{family.fm_exhaustive, shadow.event_kind.ev_use_after_move, 2,",
      "what": "KNOWN counts one item more than fail, as after an item starts to pass"
    },
    {
      "decision": "known-family",
      "file": "test/fort/owner/oracle_test.ft",
      "old": "    known{family.fm_exhaustive, shadow.event_kind.ev_use_after_move, 1,",
      "new": "    known{family.fm_seeded, shadow.event_kind.ev_use_after_move, 1,",
      "what": "KNOWN lists the failing item in another family"
    },
    {
      "decision": "known-kind",
      "file": "test/fort/owner/oracle_test.ft",
      "old": "    known{family.fm_exhaustive, shadow.event_kind.ev_use_after_move, 1,",
      "new": "    known{family.fm_exhaustive, shadow.event_kind.ev_overwrite, 1,",
      "what": "KNOWN lists the failing item under another event kind"
    },
    {
      "decision": "accept-error",
      "file": "test/fort/owner/oracle_test.ft",
      "old": "    bool mut line = prover.has_error(p);",
      "new": "    bool mut line = false;",
      "what": "an item with a compile error of an owner rule counts as accepted"
    },
    {
      "decision": "accept-leak-report",
      "file": "test/fort/owner/oracle_test.ft",
      "old": "        line = line || !p->inners[k].proved;",
      "new": "        line = line || p->inners[k].proved != p->inners[k].proved;",
      "what": "an item with a line of --leak-report counts as accepted"
    },
    {
      "decision": "accept-whole-store-report",
      "file": "test/fort/owner/oracle_test.ft",
      "old": "        line = line || !p->wholes[k].proved;",
      "new": "        line = line || p->wholes[k].proved != p->wholes[k].proved;",
      "what": "an item with a line of --whole-store-report counts as accepted"
    },
    {
      "decision": "accept-span-del-report",
      "file": "test/fort/owner/oracle_test.ft",
      "old": "                it->refused = true;\n                found = true;",
      "new": "                found = true;",
      "what": "an item with a line of --span-del-report counts as accepted"
    },
    {
      "decision": "accept-caller",
      "file": "test/fort/owner/oracle_test.ft",
      "old": "                    if (names_refused(bt, f, &bl->statements.items[k], a)) {",
      "new": "                    if (names_refused(bt, f, &bl->statements.items[k], a) && k > 99999) {",
      "what": "an item that calls a function of a refused item counts as accepted"
    }
  ]
}
