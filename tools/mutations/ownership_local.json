    {
      "name": "local module tests",
      "command": "python3 test/lang/run_tests.py --root test/fort --fort build/Linux/debug/fort --std-dir build/Linux/debug/std --timeout 900 -j 6 ownership_transfer_local ownership_flow_observer ownership_source_local ownership_report_local ownership_report_test"
    },
    {
      "name": "ownership driver",
      "command": "python3 test/ownership_driver_test.py --fort build/Linux/debug/fort --std-dir build/Linux/debug/std --cc /usr/bin/clang --opt /usr/bin/opt-18"
    }
  ],
