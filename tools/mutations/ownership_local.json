{
  "comment": [
    "One row for each check that the local ownership increment adds or depends on.",
    "A row names the line that holds the check and the text that breaks it.",
    "The build compiles working-tree HEAD with the mutant. The module tests compile",
    "src/fort with the mutant too. The stages run from the narrowest tests to the",
    "driver test. The table runs in the Linux VM with the debug preset.",
    "The md5 guard reads the product compiler that the build links. Use the",
    "default runner."
  ],
  "sources": [
    "src/fort/ownership_transfer.ft",
    "src/fort/ownership_flow.ft",
    "src/fort/ownership_source_local.ft",
    "src/fort/ownership_report.ft"
  ],
  "binary": "build/Linux/debug/fort",
  "build": "ninja -C build/Linux/debug fort",
  "stages": [
    {
      "name": "local module tests",
      "command": "python3 test/lang/run_tests.py --root test/fort --fort build/Linux/debug/fort --std-dir build/Linux/debug/std --timeout 900 -j 6 ownership_transfer_local ownership_flow_observer ownership_flow_flags ownership_source_local ownership_report_local ownership_report_test"
    },
    {
      "name": "ownership driver",
      "command": "python3 test/ownership_driver_test.py --fort build/Linux/debug/fort --std-dir build/Linux/debug/std --cc /usr/bin/clang --opt /usr/bin/opt-18"
    }
  ],
