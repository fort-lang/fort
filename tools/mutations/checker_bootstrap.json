    },
    {
      "name": "every bootstrap0 suite",
      "command": "cd build/Darwin/debug && ctest -L '^bootstrap0$' -j 10 --output-on-failure"
    },
    {
      "name": "the chain",
      "command": "ZERO_AR_DATE=1 ninja -C build/Darwin/debug fort"
    }
  ],
