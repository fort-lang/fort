#!/bin/bash
# tools/mac: run native Mac host commands for the fort target.
# T-143: the pipeline proves Apple IR, Mach-O PIE, and SIGTRAP on arm64.
set -eu

usage() {
    echo "usage: tools/mac pipeline|core|fixpoint|net" >&2
}

if [ "$#" -ne 1 ]; then
    usage
    exit 2
fi

case "$1" in
pipeline)
    root=$(cd "$(dirname "$0")/.." && pwd -P)
    exec "$root/test/mac_pipeline_test.sh"
    ;;
core)
    root=$(cd "$(dirname "$0")/.." && pwd -P)
    exec bash "$root/test/mac_core_test.sh"
    ;;
fixpoint)
    root=$(cd "$(dirname "$0")/.." && pwd -P)
    cd "$root"
    exec cmake --workflow --preset mac-native
    ;;
net)
    root=$(cd "$(dirname "$0")/.." && pwd -P)
    exec bash "$root/test/mac_net_test.sh"
    ;;
*)
    usage
    exit 2
    ;;
esac
