#!/bin/bash
# Run one build workflow or the merge gate for the selected production target.
#
# `workflow` configures, builds and tests the target's base preset (`debug` on
# linux, `darwin` on darwin). `gate` configures that preset and builds its
# `gate` target: format-check, tidy, every test, the workflow of each sanitizer
# preset of the target, and on darwin the host identity record, which requires
# a clean source tree. Either action requires the native host of the target.
set -eu

usage() {
    echo "usage: tools/target linux|darwin workflow|gate" >&2
}

if [ "$#" -ne 2 ]; then
    usage
    exit 2
fi

target=$1
action=$2
root=$(cd "$(dirname "$0")/.." && pwd -P)
cd "$root"

case "$target" in
linux)
    host=Linux
    preset=debug
    ;;
darwin)
    host=Darwin
    preset=darwin
    ;;
*)
    usage
    exit 2
    ;;
esac
[ "$(uname -s)" = "$host" ] || {
    echo "tools/target: $target requires a $host host" >&2
    exit 2
}

case "$action" in
workflow)
    cmake --workflow --preset "$preset"
    ;;
gate)
    echo "selected target: $target"
    cmake --preset "$preset"
    cmake --build --preset "$preset" --target gate
    echo "tools/target $target gate: green"
    ;;
*)
    usage
    exit 2
    ;;
esac
