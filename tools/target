#!/bin/bash
# Run one build workflow or gate for the selected production target.
set -eu

usage() {
    echo "usage: tools/target linux|darwin workflow|gate" >&2
}

if [ "$#" -ne 2 ]; then
    usage
    exit 2
fi

target=$1
action=$2
root=$(cd "$(dirname "$0")/.." && pwd -P)
cd "$root"

run_workflow() {
    local selected_target=$1
    local opt_arg=""
    if [ "$selected_target" = darwin ] && [ -n "${FORT_DARWIN_OPT:-}" ]; then
        opt_arg="-DFORT_OPT:FILEPATH=$FORT_DARWIN_OPT"
    fi
    if [ -n "$opt_arg" ]; then
        cmake --preset "$selected_target" "$opt_arg"
    else
        cmake --preset "$selected_target"
    fi
    cmake --build --preset "$selected_target"
    ctest --preset "$selected_target"
}

case "$target:$action" in
linux:workflow)
    [ "$(uname -s)" = "Linux" ] || {
        echo "tools/target: linux requires a Linux host" >&2
        exit 2
    }
    run_workflow linux
    ;;
darwin:workflow)
    [ "$(uname -s)" = "Darwin" ] || {
        echo "tools/target: darwin requires a Darwin host" >&2
        exit 2
    }
    run_workflow darwin
    ;;
linux:gate)
    exec bash test/linux_gate_test.sh
    ;;
darwin:gate)
    exec tools/darwin gate
    ;;
*)
    usage
    exit 2
    ;;
esac
