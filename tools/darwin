#!/bin/bash
# tools/darwin: run darwin host commands for the fort target.
# T-143: the pipeline proves Apple IR, Mach-O PIE, and SIGTRAP on arm64.
set -eu

usage() {
    echo "usage: tools/darwin pipeline|core|fixpoint|net|identity|gate" >&2
}

if [ "$#" -ne 1 ]; then
    usage
    exit 2
fi

case "$1" in
pipeline)
    root=$(cd "$(dirname "$0")/.." && pwd -P)
    exec "$root/test/darwin_pipeline_test.sh"
    ;;
core)
    root=$(cd "$(dirname "$0")/.." && pwd -P)
    exec bash "$root/test/darwin_core_test.sh"
    ;;
fixpoint)
    root=$(cd "$(dirname "$0")/.." && pwd -P)
    exec "$root/tools/target" darwin workflow
    ;;
net)
    root=$(cd "$(dirname "$0")/.." && pwd -P)
    exec bash "$root/test/darwin_net_test.sh"
    ;;
identity)
    root=$(cd "$(dirname "$0")/.." && pwd -P)
    exec bash "$root/tools/darwin_host_identity.sh"
    ;;
gate)
    root=$(cd "$(dirname "$0")/.." && pwd -P)
    exec bash "$root/test/darwin_gate_test.sh"
    ;;
*)
    usage
    exit 2
    ;;
esac
