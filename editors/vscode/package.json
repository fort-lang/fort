{
  "name": "fort-syntax",
  "displayName": "fort",
  "description": "Syntax highlighting, diagnostics, hover and definition for fort (.ft).",
  "version": "0.2.0",
  "publisher": "fort",
  "categories": ["Programming Languages"],
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./extension.js",
  "activationEvents": ["onLanguage:fort"],
  "contributes": {
    "languages": [
      {
        "id": "fort",
        "aliases": ["fort"],
        "extensions": [".ft"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fort",
        "scopeName": "source.fort",
        "path": "./syntaxes/fort.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "fort",
      "properties": {
        "fort.vm.sshConfig": {
          "type": "string",
          "default": "${fortVmDir}/.vagrant/ssh-config",
          "description": "The VM's ssh configuration, written by `tools/vm up`."
        },
        "fort.vm.host": {
          "type": "string",
          "default": "default",
          "description": "The host inside that file, which is named `default`."
        },
        "fort.compiler": {
          "type": "string",
          "default": "/vagrant/build/debug/fort",
          "description": "The path of the fort compiler inside the VM."
        },
        "fort.stdDir": {
          "type": "string",
          "default": "/vagrant/build/debug/std",
          "description": "The standard library directory inside the VM, passed as --std-dir."
        },
        "fort.includeDirs": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Module search directories inside the VM, each passed as -I."
        }
      }
    }
  }
}
