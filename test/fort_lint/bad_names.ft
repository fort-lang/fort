// One violation of every D1.4 rule the index can see, in a module that checks
// cleanly: the lint's verdict must come from the names and not from a
// compiler error. test/fort_lint_test.py holds the exact list against this
// file, so a rule that stopped firing fails there rather than going quiet.
import std::mem as Mem;

// A module-level constant is UPPER_CASE, this one is not.
u64 max_nodes = 16;

// A global is a variable and lower_case.
i32 mut Counter = 0;

struct Point {
    i32 X;
}

enum Color { Red, green }

fn i32 addTwo(i32 aValue) {
    i32 Sum = aValue + 2;
    return Sum;
}

// A variable never takes its type's name, though the field above it may.
fn i32 use_them() {
    Point Point = Point{cast(max_nodes, i32)};
    Color c = Color.Red;
    u8 mut@ own room = new(u8, 8);
    Mem.fill(room, 0);
    del(room);
    return Point.X + Counter + addTwo(cast(c, i32));
}

struct pair {
    i32 a;
    i32 b;
}

// A lower_case name can still take its type's name, which is the other half
// of the rule: this parameter breaks that one alone.
fn i32 pair_sum(pair pair) {
    return pair.a + pair.b;
}

// A line wider than the hundred columns of the house style, which is the one rule here that no record of the index can see.
fn i32 wide() {
    return 0;
}
