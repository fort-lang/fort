// A module the checker rejects, holding names it still resolves: the index
// holds everything that resolved, so the lint judges those and reports the
// error beside them. One broken module must not blind the lint for itself,
// nor for every module that imports it.
// D20.3
fn i32 use_unknown() {
    i32 badName = 2;
    return badName + nowhere;
}

fn i32 alsoBad() {
    return 0;
}
