// A module holding one declaration of every kind the index of D20.3 names,
// each spelled the way D1.4 asks. tools/fort_lint.py must stay silent over
// it, so the fixture is the other half of bad_names.ft: a lint that reported
// nothing anywhere would pass that one and fail this one.
import std.strbuf as sb;

// A module-level constant is the one UPPER_CASE name there is (D1.4, D7.10).
u64 MAX_NODES = 16;

// A global is a variable, so it is lower_case like any other (D1.4).
i32 mut counter = 0;

struct node {
    // A field may take its type's name, since fields live in no namespace a
    // type could occupy (D1.4, D7.9).
    node mut* node;
    i32 value;
}

enum color { red, green, blue }

// An extern binds a C symbol whose spelling the foreign library chose, so
// D1.4 does not reach it and the lint exempts the kind. A camel-case name
// here is the proof: nothing else in this file may hold one.
extern fn i32 SDL_Init(u32 flags);

fn i32 node_value(node* n, i32 fallback) {
    i32 mut total = fallback;
    total = total + n->value;
    return total;
}

fn i32 use_everything() {
    node mut n = node{null, 3};
    color c = color.green;
    sb.str_buf mut buffer = sb.create();
    i32 result = node_value(&n, cast(MAX_NODES, i32) + counter + cast(c, i32));
    sb.free(&buffer);
    return result + SDL_Init(0);
}
