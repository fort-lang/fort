//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: fir.place_projection: the place is not in this function
//! stdout:
//| ready
/// Checks that fir.place_projection refuses a place whose projections another function holds.
import diag;
import fir;
import prim;
import types;

fn main() i32 {
    types.table mut tt = types.table{};
    defer types.type_table_free(&tt);
    types.node* i32t = types.type_prim(&tt, prim.prim_kind.prim_i32);
    types.node*[2] params = {i32t, i32t};
    types.node* fnty = types.type_fn(&tt, i32t, params[..], false);
    fir.func mut f = fir.func_new(&tt, null, fnty);
    defer fir.func_free(&f);
    fir.func mut g = fir.func_new(&tt, null, fnty);
    defer fir.func_free(&g);
    types.node* ptr = types.type_ptr(&tt, i32t, false, false);
    u32 p = fir.local_add(&g, ptr, fir.local_kind.lk_temp, null, diag.loc{});
    fir.place d = fir.place_deref(&g, fir.place_local(p));
    println("ready");
    fir.place_projection(&f, d, 0);
    return 0;
}
