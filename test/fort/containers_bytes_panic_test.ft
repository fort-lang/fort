//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: containers.pool_bytes: request too large
//! stdout:
//| 0
import containers;

// A request no block could hold is a violated precondition rather than an
// allocation that traps: the block size is added to the request when a block
// is chosen, so a request within a block size of the largest u64 is refused
// before that sum is computed.
// D3.1, D11.1, D13.3
fn i32 main() {
    containers.pool mut p = containers.pool_create();
    defer containers.pool_free(&p);
    println(containers.pool_block_count(&p));
    u8 mut@ never = containers.pool_bytes(&p, 18446744073709551615);
    println(never.len);
    return 0;
}
