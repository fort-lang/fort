//! run
//! flags: -I ../../src
//! abort
//! stderr: panic: containers.pool_bytes: request too large
//! stdout:
//| 0
/// Checks that a pool rejects a request that no block can hold. The guard runs before
/// block-size arithmetic can overflow.
import fort.containers;

fn main() i32 {
    containers.pool mut* own p = containers.pool_make();
    defer containers.pool_drop_made(move(p));
    println(containers.pool_block_count(p));
    u8 mut@ never = containers.pool_bytes(p, 18446744073709551615);
    println(never.len);
    return 0;
}
