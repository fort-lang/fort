//! run
//! flags: -I ../../src
//! abort
//! stderr: panic: consts: logical folding on a non-bool
//! stdout:
//| false
/// `! && ||` take bools, so a logical fold on an integer is a broken
/// precondition.
import fort.consts;

fn main() i32 {
    println(consts.cv_lnot(consts.cv_from_bool(true)).mag == 1);
    println(consts.cv_lnot(consts.cv_from_i64(1)).mag);
    return 0;
}
