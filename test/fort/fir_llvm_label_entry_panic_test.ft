//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: fir_llvm.label_of: a branch to the entry block
//! stdout:
//| 1
/// No terminator branches to bb0, because LLVM forbids a branch to the entry block. label_of
/// on bb0 breaks that precondition, so the call panics.
import fir;
import fir_llvm;
import llvm_env;

string[6] PRELUDE = {
    "struct pair {",
    "    i32 a;",
    "    i32 b;",
    "}",
    "fn take(pair p) i32 {",
    "    return p.a;\n}",
};

string[8] TEXT = {
    "fn main.f() -> i32 {",
    "    let _1: pair;",
    "",
    "    bb0: {",
    "        _0 = call fn main.take(const zero pair) #1:1 s1;",
    "        return #1:1 s1;",
    "    }",
    "}",
};

// A panic ends the program, so the case stands in a file of its own.
fn main() i32 {
    llvm_env.env mut e = llvm_env.env{};
    llvm_env.open(&e);
    defer llvm_env.close(&e);
    fir.module mut m = llvm_env.parse(&e, PRELUDE[..], TEXT[..]);
    defer fir.module_free(&m);
    fir.func* f = fir.module_function_at(&m, 0);
    llvm_env.begin(&e.g);
    fir_llvm.translator mut t = fir_llvm.open(&e.g, f);
    defer fir_llvm.close(&t);
    println(fir.block_count(f));
    fir_llvm.label_of(&t, 0);
    return 0;
}
