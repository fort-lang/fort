//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: check.check_builtin_call: unknown builtin
//! stdout:
//| true
/// check_call passes the symbol of a universe function. A symbol that names no builtin breaks
/// that precondition, so the call panics.
import ast;
import check;
import check_env;

fn main() i32 {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    string src = "fn f() void {}\nfn main() i32 {\n    f();\n    return 0;\n}\n";
    println(check_env.open_module(&e, src));
    ast.node mut* call = check_env.node_in_main(&e, ast.ast_kind.k_call, "");
    ast.sym mut* f = check_env.sym_main(&e, "f");
    check.expr mut out = check.expr{};
    check.check_builtin_call(&e.ck, call, f, &out);
    return 0;
}
