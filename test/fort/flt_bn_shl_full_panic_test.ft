//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: flt.bn_shl: a constant needed more limbs than the bignum has
//! stdout:
//| 2
/// BN_LIMBS holds every value the float reader makes. A shift by all the bits of the array
/// passes that bound, so the call panics before it writes past the array.
import flt;

fn main() i32 {
    flt.bignum mut n = flt.bignum{};
    flt.bn_set_u64(&n, 1);
    flt.bn_shl(&n, 32);
    println(n.len);
    flt.bn_shl(&n, flt.BN_LIMBS * flt.LIMB_BITS);
    return 0;
}
