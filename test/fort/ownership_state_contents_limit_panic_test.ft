//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: ownership_state.contents: capacity overflow
//! stdout:
//| 0
/// append_contents refuses to add an entry after U64_MAX entries, because the count would
/// pass u64. The test sets contents_len to U64_MAX, and the call panics.
import ownership_api;
import ownership_state;

fn main() i32 {
    ownership_state.state mut s = ownership_state.empty();
    defer ownership_state.free(&s);
    println(s.contents_len);
    s.contents_len = ownership_state.U64_MAX;
    ownership_state.append_contents(&s, ownership_api.contents_fact{});
    return 0;
}
