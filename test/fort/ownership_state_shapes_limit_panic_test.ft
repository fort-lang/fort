//! flags: -I ../../src/fort
//! abort
//! stderr: panic: ownership_state.shapes: capacity overflow
//! stdout:
//| 0
/// append_shapes refuses to add an entry after U64_MAX entries, because the count would
/// pass u64. The test sets shapes_len to U64_MAX, and the call panics.
import ownership_api;
import ownership_state;

fn main() i32 {
    ownership_state.state mut s = ownership_state.empty();
    defer ownership_state.free(&s);
    println(s.shapes_len);
    s.shapes_len = ownership_state.U64_MAX;
    ownership_state.append_shapes(&s, ownership_api.shape_description{});
    return 0;
}
