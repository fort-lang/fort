//! run
//! flags: -I ../../src/fort -I support -I ../../src
//! stdout:
//| floor ok
//| growth ok
//| bound ok
//| cap ok
//| reuse ok
//| release ok
//| ok
/// The arena of src/lsp/json.ft: what a document costs, what bounds it, and
/// that json.free gives all of it back.
import heap;
import lsp.json;
import lsp_json_env;
import std.strbuf;

//
// The bound this file asserts is 20 times the size of the source, and the number is derived and
// then measured. Every value of a document costs at least two bytes of source, since the
// shortest element of an array is a digit and a comma. A node is 36 bytes and a chunk of 256 of
// them costs 16 bytes more. The chunks hold at most 255 nodes more than the document needs. The
// chunk vector holds one pointer per 256 nodes. The byte buffer equals the source length.
// A document that fills a chunk stays below 36/2 + 1 = 19 times its source size.
// The bound of 20 adds a margin. The densest valid document is an array of
// one-digit numbers. The measurement parses this form. One mebibyte of source
// uses 19997711 bytes for 524289 nodes, which is a ratio of 19.07. The two
// lengths are asserted below.
// The assertion does not use 19997711 because it holds bound 20 alone. A change to NODE_BYTES,
// to the chunk record, to the chunk vector or to how std.strbuf grows moves the reading and
// turns nothing red.
//
// **The bound uses the largest source parsed by the document.** A document
// keeps its chunks and buffer through json.clear. Thus, parsing one mebibyte
// and then ten bytes keeps an arena sized for one mebibyte. Two tests check
// this form of the invariant.
//
// Reuse stays within the bound because parse replaces a buffer that is too
// small. std.strbuf would otherwise double a 1000000-byte buffer to 2000000
// for a 1000001-byte source. The total ratio would then be 20.02.
//
// The floor is 9280 bytes, and it is three terms.
// a_document_of_one_value_takes_one_chunk asserts their sum. One chunk is
// 9232: 256 nodes of 36 bytes and the 16-byte record that owns them. The first
// chunk vector is four pointers, 32 bytes. The byte buffer is 16, the smallest
// capacity std.strbuf reserves. Every one-value document pays this fixed cost.
// Therefore, a server reuses one document through json.clear instead of
// creating one document for each keystroke.
//
// The normal test corpus is not a leak oracle. This test checks arena release
// through two heap views over many rounds and through json.arena_bytes.

// One mebibyte, the document size the server is sized for.
u64 ONE_MEBIBYTE = 1048576;

// The bound the arena must stay under, as a multiple of the source. The module
// names the same number, since the cap on a source is chosen against it. And
// the first assertion of the bound section holds the two together.
u64 ARENA_BOUND = 20;

// What a node costs, how many stand in one chunk, and what the chunk record
// beside the slots costs. The derivation above rests on these and the
// assertions below hold the module to them. A chunk record is a span, which
// is a pointer and a length.
u64 NODE_BYTES = 36;
u64 CHUNK_NODES = 256;
u64 CHUNK_RECORD = 16;
u64 CHUNK_BYTES = 256 * 36 + 16;

// The smallest capacity that std.strbuf reserves. It is the byte buffer size
// of a document below sixteen bytes.
u64 STRBUF_MIN_CAP = 16;

// The rounds of the release probe and the distance in bytes that fails it.
// Each round parses a document of 3999 bytes into 2001 nodes. So it allocates
// 8 chunks, a chunk vector and the byte buffer -- 77919 bytes, measured with
// json.arena_bytes -- and gives all of it back. One
// retained chunk moves the system view by 9232 bytes. Four
// hundred retained chunks exceed the process's initial heap.
u64 ROUNDS = 400;
u64 BOUND = 4096;

// How many of the last rounds the probe holds against the early round. The allocator does not
// hand a round the same small block every time. The probe takes the smallest distance over a
// window that covers the cycle.
u64 LATE_SAMPLES = 16;

// An array of one-digit numbers of `size` bytes: `[1,1,...,1]`, the densest
// document JSON admits, since every element is one digit and one comma.
fn dense_into(strbuf.str_buf mut* b, u64 size) void {
    strbuf.clear(b);
    strbuf.push(b, '[');
    // The brackets are two of the bytes, and every element but the last
    // carries a comma.
    u64 elements = (size - 1) / 2;
    u64 mut i = 0;
    while (i < elements) {
        if (i > 0) {
            strbuf.push(b, ',');
        }
        strbuf.push(b, '1');
        i += 1;
    }
    strbuf.push(b, ']');
}

// The document has a common server-message shape. Its
// object holds numbers and one long source-file string.
fn message_into(strbuf.str_buf mut* b, u64 size) void {
    strbuf.clear(b);
    strbuf.append(b, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"text\":\"");
    while (b->len < size - 4) {
        strbuf.append(b, "fn main() i32 { return 0; }\\n");
    }
    strbuf.append(b, "\"}");
}

// The arena a document takes after parsing `source`.
fn arena_of(string source) u64 {
    json.doc mut d = json.create();
    defer json.free(&d);
    assert(json.parse(&d, source));
    return json.arena_bytes(&d);
}

// ---- the floor -------------------------------------------------------------------

fn a_document_of_one_value_takes_one_chunk() void {
    json.doc mut d = json.create();
    defer json.free(&d);
    assert(json.parse(&d, "1"));
    // One chunk with its record, the four pointers of the first chunk vector,
    // and the byte buffer, which std.strbuf never reserves below sixteen
    // bytes.
    assert(json.arena_bytes(&d) == CHUNK_BYTES + 4 * 8 + STRBUF_MIN_CAP);
    assert(CHUNK_BYTES == CHUNK_NODES * NODE_BYTES + CHUNK_RECORD);
    assert(json.node_count(&d) == 2);
}

fn a_node_costs_the_bytes_the_derivation_names() void {
    // 254 values and the absent node stay inside one chunk. The 256th value
    // starts a second. The step is what NODE_BYTES and CHUNK_NODES say it is.
    strbuf.str_buf mut source = strbuf.create();
    defer strbuf.free(&source);
    dense_into(&source, 2 * 254);
    u64 one_chunk = arena_of(strbuf.view(&source));
    dense_into(&source, 2 * 300);
    u64 two_chunks = arena_of(strbuf.view(&source));
    assert(two_chunks - one_chunk > CHUNK_BYTES);
    assert(two_chunks - one_chunk < 2 * CHUNK_BYTES);
}

fn an_empty_document_costs_nothing_until_it_is_parsed() void {
    json.doc mut d = json.create();
    defer json.free(&d);
    assert(json.arena_bytes(&d) == 0);
}

// ---- growth ----------------------------------------------------------------------

fn the_byte_buffer_is_reserved_once_at_the_size_of_the_source() void {
    // Every string and every number of a document is copied into the buffer
    // and decoding never lengthens one. So the buffer the parse reserves is
    // the buffer it ends with, whatever the document holds.
    strbuf.str_buf mut source = strbuf.create();
    defer strbuf.free(&source);
    strbuf.append(&source, "[\"\\u00e9\\u00e9\",\"abcdefgh\",12345,\"\\ud83d\\ude00\"]");
    json.doc mut d = json.create();
    defer json.free(&d);
    string document = strbuf.view(&source);
    assert(json.parse(&d, document));
    u64 chunks = CHUNK_BYTES + 4 * 8;
    lsp_json_env.check_u64(json.arena_bytes(&d) - chunks, document.len, "the byte buffer");
}

fn the_chunks_grow_one_at_a_time() void {
    // A document of a thousand values takes four chunks and no more. The
    // arena never holds a copy of itself, which is what a doubling vector of
    // nodes would do while it copies.
    strbuf.str_buf mut source = strbuf.create();
    defer strbuf.free(&source);
    dense_into(&source, 2 * 1000);
    json.doc mut d = json.create();
    defer json.free(&d);
    string document = strbuf.view(&source);
    assert(json.parse(&d, document));
    u64 nodes = json.node_count(&d);
    u64 chunks = (nodes + CHUNK_NODES - 1) / CHUNK_NODES;
    // Four chunks fill the first chunk vector, which grows only when a fifth
    // one asks for room.
    assert(chunks == 4);
    lsp_json_env.check_u64(json.arena_bytes(&d), chunks * CHUNK_BYTES + 4 * 8 + document.len,
        "four chunks");
}

// ---- the bound -------------------------------------------------------------------

fn a_mebibyte_of_the_densest_document_stays_under_the_bound() void {
    assert(ARENA_BOUND == json.JSON_ARENA_BOUND);
    strbuf.str_buf mut source = strbuf.create();
    defer strbuf.free(&source);
    dense_into(&source, ONE_MEBIBYTE);
    string document = strbuf.view(&source);
    // The shape holds an odd number of bytes: two brackets, one digit for
    // each element and one comma between two of them.
    assert(document.len == ONE_MEBIBYTE - 1);
    json.doc mut d = json.create();
    defer json.free(&d);
    assert(json.parse(&d, document));
    u64 allocated = json.arena_bytes(&d);
    // Half a million values, one node for each, the array and the absent
    // node.
    assert(json.node_count(&d) == (document.len - 1) / 2 + 2);
    if (allocated > ARENA_BOUND * ONE_MEBIBYTE) {
        println("the arena took ", allocated, " bytes for ", document.len);
    }
    assert(allocated <= ARENA_BOUND * ONE_MEBIBYTE);
}

fn a_mebibyte_of_a_message_costs_little_more_than_its_text() void {
    // The shape a server actually receives: the bound of the densest document
    // is the worst case and not the common one.
    strbuf.str_buf mut source = strbuf.create();
    defer strbuf.free(&source);
    message_into(&source, ONE_MEBIBYTE);
    string document = strbuf.view(&source);
    assert(document.len >= ONE_MEBIBYTE);
    json.doc mut d = json.create();
    defer json.free(&d);
    assert(json.parse(&d, document));
    // The text of the document and one chunk of nodes: twice the source is
    // already generous.
    assert(json.arena_bytes(&d) < 2 * document.len);
    assert(json.node_count(&d) == 5);
}

fn a_document_of_strings_stays_under_the_bound() void {
    // The densest document of strings is an array of empty ones, three bytes
    // for each value.
    strbuf.str_buf mut source = strbuf.create();
    defer strbuf.free(&source);
    strbuf.push(&source, '[');
    u64 mut i = 0;
    while (i < 20000) {
        if (i > 0) {
            strbuf.push(&source, ',');
        }
        strbuf.append(&source, "\"\"");
        i += 1;
    }
    strbuf.push(&source, ']');
    string document = strbuf.view(&source);
    json.doc mut d = json.create();
    defer json.free(&d);
    assert(json.parse(&d, document));
    assert(json.arena_bytes(&d) <= ARENA_BOUND * document.len);
}

fn a_document_of_members_stays_under_the_bound() void {
    // The densest object: a one-byte name, a one-digit value and a comma.
    strbuf.str_buf mut source = strbuf.create();
    defer strbuf.free(&source);
    strbuf.push(&source, '{');
    u64 mut i = 0;
    while (i < 20000) {
        if (i > 0) {
            strbuf.push(&source, ',');
        }
        strbuf.append(&source, "\"a\":1");
        i += 1;
    }
    strbuf.push(&source, '}');
    string document = strbuf.view(&source);
    json.doc mut d = json.create();
    defer json.free(&d);
    assert(json.parse(&d, document));
    assert(json.arena_bytes(&d) <= ARENA_BOUND * document.len);
}

// ---- the cap ---------------------------------------------------------------------

fn a_document_exactly_at_the_cap_parses() void {
    // The cap is a length a document may have and not one it must stay below.
    strbuf.str_buf mut source = strbuf.create();
    defer strbuf.free(&source);
    dense_into(&source, 1001);
    string document = strbuf.view(&source);
    json.doc mut d = json.create();
    defer json.free(&d);
    json.set_max_bytes(&d, document.len);
    assert(json.parse(&d, document));
    assert(json.count_of(&d, json.root(&d)) == 500);
    assert(json.error_message(&d) == "");
}

fn a_document_one_byte_above_the_cap_is_refused() void {
    strbuf.str_buf mut source = strbuf.create();
    defer strbuf.free(&source);
    dense_into(&source, 1001);
    string document = strbuf.view(&source);
    json.doc mut d = json.create();
    defer json.free(&d);
    json.set_max_bytes(&d, document.len - 1);
    assert(!json.parse(&d, document));
    lsp_json_env.check(json.error_message(&d), "the document is too large", "one byte above");
    // The offset is the first byte the reader refuses to read, which is the
    // cap: no byte of the source was read at all.
    lsp_json_env.check_u64(json.error_offset(&d), document.len - 1, "the offset of a large one");
    assert(json.root(&d) == 0);
    assert(json.node_count(&d) == 1);
}

fn a_refusal_for_size_allocates_nothing_but_the_first_chunk() void {
    // The document is refused before a byte of it is read, so the arena holds
    // the chunk the absent node lives in and nothing else. That is what makes
    // the cap a defence: a source above it costs nothing at all.
    strbuf.str_buf mut source = strbuf.create();
    defer strbuf.free(&source);
    dense_into(&source, 200001);
    json.doc mut d = json.create();
    defer json.free(&d);
    json.set_max_bytes(&d, 1000);
    assert(!json.parse(&d, strbuf.view(&source)));
    assert(json.arena_bytes(&d) == CHUNK_BYTES + 4 * 8);
}

fn the_cap_bounds_what_a_document_asks_for() void {
    // The whole point of the cap: a source of `limit` bytes asks the
    // allocator for at most ARENA_BOUND times that, whatever it holds.
    u64 limit = 100001;
    strbuf.str_buf mut source = strbuf.create();
    defer strbuf.free(&source);
    dense_into(&source, limit);
    json.doc mut d = json.create();
    defer json.free(&d);
    json.set_max_bytes(&d, limit);
    string document = strbuf.view(&source);
    assert(document.len == limit);
    assert(json.parse(&d, document));
    assert(json.arena_bytes(&d) <= ARENA_BOUND * limit);
}

fn the_default_cap_bounds_a_document_at_the_memory_the_module_names() void {
    // Sixteen mebibytes of source and twenty times that of arena is the 320
    // MB the header of src/lsp/json.ft names. A change to either number must
    // also change this product.
    assert(json.JSON_MAX_BYTES == 16 * 1024 * 1024);
    assert(json.JSON_MAX_BYTES * json.JSON_ARENA_BOUND == 335544320);
    // The ceiling is the largest offset a u32 field holds, which is what
    // bounds a cap a caller sets.
    assert(json.JSON_BYTES_CEILING == 4294967295);
}

fn the_cap_of_a_document_outlives_its_storage() void {
    // free releases the arena and keeps the cap, because the cap belongs to
    // the caller and the arena does not.
    strbuf.str_buf mut source = strbuf.create();
    defer strbuf.free(&source);
    dense_into(&source, 10001);
    json.doc mut d = json.create();
    defer json.free(&d);
    json.set_max_bytes(&d, 5000);
    assert(!json.parse(&d, strbuf.view(&source)));
    json.free(&d);
    assert(json.arena_bytes(&d) == 0);
    assert(json.max_bytes(&d) == 5000);
    assert(!json.parse(&d, strbuf.view(&source)));
    json.clear(&d);
    assert(json.max_bytes(&d) == 5000);
}

fn a_document_value_carries_the_default_cap() void {
    // doc{} is a valid empty document, so a struct holding one is initialized
    // with {}. A zero in the field therefore has to mean the default rather
    // than a cap of nothing.
    json.doc mut d = json.doc{};
    defer json.free(&d);
    assert(json.max_bytes(&d) == json.JSON_MAX_BYTES);
    assert(json.parse(&d, "[1,2,3]"));
}

// ---- reuse -----------------------------------------------------------------------

fn a_thousand_parses_through_one_document_do_not_grow_the_arena() void {
    // What a server owes: one document analysed again and again must not grow
    // the heap.
    strbuf.str_buf mut source = strbuf.create();
    defer strbuf.free(&source);
    message_into(&source, 4096);
    json.doc mut d = json.create();
    defer json.free(&d);
    assert(json.parse(&d, strbuf.view(&source)));
    u64 first = json.arena_bytes(&d);
    u64 mut i = 0;
    while (i < 1000) {
        assert(json.parse(&d, strbuf.view(&source)));
        i += 1;
    }
    lsp_json_env.check_u64(json.arena_bytes(&d), first, "a thousand parses");
}

fn a_larger_document_grows_the_arena_and_a_smaller_one_does_not_shrink_it() void {
    strbuf.str_buf mut small = strbuf.create();
    defer strbuf.free(&small);
    strbuf.str_buf mut large = strbuf.create();
    defer strbuf.free(&large);
    dense_into(&small, 100);
    dense_into(&large, 10000);
    json.doc mut d = json.create();
    defer json.free(&d);
    assert(json.parse(&d, strbuf.view(&small)));
    u64 after_small = json.arena_bytes(&d);
    assert(json.parse(&d, strbuf.view(&large)));
    u64 after_large = json.arena_bytes(&d);
    assert(after_large > after_small);
    assert(json.parse(&d, strbuf.view(&small)));
    // The storage of the larger document is kept for the next one.
    assert(json.arena_bytes(&d) == after_large);
}

fn the_bound_holds_after_a_document_grows_by_one_byte() void {
    // The case that breaks a buffer which doubles: a source one byte above
    // the one before it. The buffer is released and taken again at the new
    // length. So the arena stays inside the bound and the buffer is never
    // twice the source.
    strbuf.str_buf mut small = strbuf.create();
    defer strbuf.free(&small);
    strbuf.str_buf mut large = strbuf.create();
    defer strbuf.free(&large);
    dense_into(&small, 100001);
    // The same document and one byte of whitespace, which the reader skips
    // and the buffer must hold room for.
    strbuf.append(&large, strbuf.view(&small));
    strbuf.push(&large, ' ');
    json.doc mut d = json.create();
    defer json.free(&d);
    assert(json.parse(&d, strbuf.view(&small)));
    string grown = strbuf.view(&large);
    assert(grown.len == strbuf.view(&small).len + 1);
    assert(json.parse(&d, grown));
    lsp_json_env.check_u64(strbuf.cap(&d.bytes), grown.len, "the buffer after it grew");
    assert(json.arena_bytes(&d) <= ARENA_BOUND * grown.len);
}

fn the_bound_is_over_the_largest_source_the_document_parsed() void {
    // A doc keeps its storage through a parse of a smaller document. So the
    // bound answers for the largest source it has seen and not for the one it
    // holds.
    strbuf.str_buf mut large = strbuf.create();
    defer strbuf.free(&large);
    dense_into(&large, 100001);
    json.doc mut d = json.create();
    defer json.free(&d);
    string document = strbuf.view(&large);
    assert(json.parse(&d, document));
    u64 allocated = json.arena_bytes(&d);
    assert(json.parse(&d, "[1]"));
    assert(json.arena_bytes(&d) == allocated);
    assert(allocated <= ARENA_BOUND * document.len);
    // Against the three bytes it holds now, the same arena is far above the
    // bound, which is why the invariant names the largest source.
    assert(allocated > ARENA_BOUND * 3);
}

fn a_thousand_parses_of_a_failing_document_do_not_grow_the_arena() void {
    json.doc mut d = json.create();
    defer json.free(&d);
    assert(!json.parse(&d, "{\"a\":[1,2,"));
    u64 first = json.arena_bytes(&d);
    u64 mut i = 0;
    while (i < 1000) {
        assert(!json.parse(&d, "{\"a\":[1,2,"));
        i += 1;
    }
    lsp_json_env.check_u64(json.arena_bytes(&d), first, "a thousand refusals");
}

// ---- the release -----------------------------------------------------------------

fn free_gives_every_block_back() void {
    // The in-band view: what the module says it holds after a free.
    json.doc mut d = json.create();
    strbuf.str_buf mut source = strbuf.create();
    defer strbuf.free(&source);
    dense_into(&source, 10000);
    assert(json.parse(&d, strbuf.view(&source)));
    assert(json.arena_bytes(&d) > 0);
    json.free(&d);
    assert(json.arena_bytes(&d) == 0);
    assert(json.node_count(&d) == 0);
}

fn many_rounds_of_parse_and_free_leave_the_heap_where_it_was() void {
    // The heap view, which is the one that would see a chunk the free forgot. Two views,
    // because each is blind to what the other sees. The system view moves for a leak the
    // allocator cannot serve out of a free chunk. The address of a fresh block moves for a leak
    // it can.
    strbuf.str_buf mut source = strbuf.create();
    defer strbuf.free(&source);
    dense_into(&source, 4000);
    string document = strbuf.view(&source);
    // The same document with its last bracket taken off, which every parse
    // refuses after it has read every element.
    strbuf.str_buf mut broken = strbuf.create();
    defer strbuf.free(&broken);
    strbuf.append(&broken, document[..document.len - 1]);
    string half = strbuf.view(&broken);
    u64 mut early = 0;
    u64 mut early_block = 0;
    u64 mut broke = 0;
    u64 mut block = 0;
    bool mut sampled = false;
    u64 mut i = 0;
    while (i < ROUNDS) {
        json.doc mut d = json.create();
        assert(json.parse(&d, document));
        assert(json.node_count(&d) > 1000);
        // Failure allocates each node before
        // the bad byte. Each round frees
        // successful and failed documents, so a
        // missed failure release moves the system view.
        json.doc mut refused = json.create();
        assert(!json.parse(&refused, half));
        assert(json.node_count(&refused) > 1000);
        json.free(&refused);
        json.free(&d);
        if (i == ROUNDS / 2) {
            early = heap.system_view();
            early_block = heap.block_view();
        }
        if (i + LATE_SAMPLES >= ROUNDS) {
            u64 broke_now = heap.distance(heap.system_view(), early);
            u64 block_now = heap.distance(heap.block_view(), early_block);
            if (!sampled || broke_now < broke) {
                broke = broke_now;
            }
            if (!sampled || block_now < block) {
                block = block_now;
            }
            sampled = true;
        }
        i += 1;
    }
    assert(early != 0 && early_block != 0 && sampled);
    if (broke >= BOUND || block >= BOUND) {
        println("the system view moved ", broke, " and a block moved ", block);
    }
    assert(broke < BOUND);
    assert(block < BOUND);
}

fn many_rounds_of_clear_leave_the_heap_where_it_was() void {
    // The other lifetime a server has: one document, cleared between
    // messages, freed once at the end.
    //
    // The system view is the only view here, and the measurement says why. The probe above gives a
    // hundred kilobytes back over its rounds. It leaves free chunks of every size and the
    // 32-byte block view lands wherever one starts. Two block_view calls in a row differ by
    // 54000 bytes with nothing allocated between them. The system view answers the question this
    // round asks. A clear that allocated anew would ask the allocator for
    // another chunk of the same shape for each of four hundred rounds.
    strbuf.str_buf mut source = strbuf.create();
    defer strbuf.free(&source);
    dense_into(&source, 4000);
    string document = strbuf.view(&source);
    json.doc mut d = json.create();
    defer json.free(&d);
    assert(json.parse(&d, document));
    u64 allocated = json.arena_bytes(&d);
    u64 early = heap.system_view();
    u64 mut i = 0;
    while (i < ROUNDS) {
        json.clear(&d);
        assert(json.parse(&d, document));
        i += 1;
    }
    assert(heap.distance(heap.system_view(), early) < BOUND);
    // What the arena itself says, which no view of the heap can see: the
    // storage of the first parse served every round after it.
    lsp_json_env.check_u64(json.arena_bytes(&d), allocated, "four hundred clears");
}

fn main() i32 {
    a_document_of_one_value_takes_one_chunk();
    a_node_costs_the_bytes_the_derivation_names();
    an_empty_document_costs_nothing_until_it_is_parsed();
    println("floor ok");
    the_byte_buffer_is_reserved_once_at_the_size_of_the_source();
    the_chunks_grow_one_at_a_time();
    println("growth ok");
    a_mebibyte_of_the_densest_document_stays_under_the_bound();
    a_mebibyte_of_a_message_costs_little_more_than_its_text();
    a_document_of_strings_stays_under_the_bound();
    a_document_of_members_stays_under_the_bound();
    println("bound ok");
    a_document_exactly_at_the_cap_parses();
    a_document_one_byte_above_the_cap_is_refused();
