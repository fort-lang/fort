//! run
//! flags: -I ../../src
//! abort
//! stderr: panic: fir.owner_word_at: a word past the owner slots of the type
//! stdout:
//| 1 0
/// Checks that fir.owner_word_at refuses a word at the count of the owner words of the type. An
/// `own` pointer has 1 word, so word 1 is past it.
import fort.fir;
import fort.prim;
import fort.types;

fn main() i32 {
    // `tt` lives in an allocation, so that the leak rule proves its end: no call changes the
    // pointer, and drop_made holds each release once.
    types.table mut* own tt = types.table_make();
    defer types.table_drop_made(move(tt));
    types.node* i32t = types.type_prim(tt, prim.prim_kind.prim_i32);
    types.node* owner = types.type_ptr(tt, i32t, true, true);
    println(fir.owner_word_count(owner), " ", fir.owner_word_at(owner, 0));
    fir.owner_word_at(owner, 1);
    return 0;
}
