//! run
//! flags: -I ../../src/fort
//! stdout:
//| G04.4 G05.3 G05.4
//| G07.4 G09.3
/// Tests residual widening with retained sources and obligations.
import ownership_api;
import ownership_events;
import ownership_join;
import ownership_limits;
import ownership_state;

fn id(ownership_api.entity_kind kind, u32 ordinal) ownership_api.entity_id {
    ownership_api.entity_id mut out = ownership_api.entity_id{};
    out.kind = kind;
    out.ordinal = ordinal;
    return out;
}

fn place(u32 ordinal) ownership_api.place_path {
    ownership_api.place_path mut out = ownership_api.place_path{};
    out.root = id(ownership_api.entity_kind.slot, ordinal);
    return out;
}

fn allocation(u32 ordinal, u32 owner, i64 length)
    ownership_api.allocation_fact {
    ownership_api.allocation_fact mut out = ownership_api.allocation_fact{};
    out.key = id(ownership_api.entity_kind.allocation, ordinal);
    out.site = id(ownership_api.entity_kind.allocation, 1);
    out.validity = ownership_api.validity_kind.live;
    out.count.one = true;
    out.obligation = true;
    out.owner.place = place(owner);
    out.logical_length.kind = ownership_api.fact_kind.exact;
    out.logical_length.value = length;
    return out;
}

fn limits(u64 depth, u64 regions) ownership_api.limit_table {
    ownership_api.limit_table mut out = ownership_limits.production();
    out.d = depth;
    out.r = regions;
    return out;
}

fn setup(ownership_events.store mut* events, ownership_api.services mut* svc) void {
    ownership_api.limit_table bound = ownership_limits.production();
    assert(ownership_events.bind(events, &bound, svc));
}

fn op(u32 ordinal) ownership_api.operation_position {
    ownership_api.operation_position mut out = ownership_api.operation_position{};
    out.operation = ordinal;
    return out;
}

fn alias_uncertainty(ownership_api.services* svc) void {
    ownership_state.state mut left = ownership_state.empty();
    ownership_state.state mut right = ownership_state.empty();
    ownership_api.projection[3] mut parts = {};
    u64 mut i = 0;
    while (i < parts.len) {
        parts[i].kind = ownership_api.projection_kind.field;
        parts[i].field = cast(i, u32);
        i += 1;
    }
    ownership_api.contents_fact mut fact = ownership_api.contents_fact{};
    fact.place = place(1);
    fact.place.projections = parts[..];
    fact.kind = ownership_api.contents_kind.reference;
    fact.value_version = id(ownership_api.entity_kind.value, 1);
    ownership_state.append_contents(&left, fact);
    ownership_api.limit_table bound = limits(2, 4);
    ownership_api.operation_position at = op(1);
    ownership_api.source_position source = ownership_api.source_position{};
    ownership_state.state mut ab = ownership_join.widen(&left, &right, svc, &bound, at, source);
    ownership_state.state mut ba = ownership_join.widen(&right, &left, svc, &bound, at, source);
    assert(ownership_state.equal(&ab, &ba));
    assert(ab.contents_len == 1 && ab.contents[0].place.residual);
    assert(ab.contents[0].place.projections.len == 2);
    assert(ab.losses_len == 1 && ab.losses[0].category == ownership_api.limit_category.d);
    ownership_state.state mut repeat = ownership_join.widen(&ab, &left, svc,
        &bound, at, source);
    ownership_state.state mut fixed = ownership_join.widen(&repeat, &left, svc,
        &bound, at, source);
    assert(ownership_state.equal(&repeat, &fixed));
    assert(repeat.contents_len == 1 && repeat.losses_len == 1);
    ownership_api.place_path[1] aliases = {ab.contents[0].place};
    ownership_state.state mut before = ownership_state.clone(&ab);
    ownership_api.mutation_result update = ownership_state.strong_contents(&ab, svc,
        fact, aliases[..], true, at, source);
    assert(!update.applied && ownership_state.equal(&ab, &before));
    ownership_state.free(&before);
    ownership_state.free(&fixed);
    ownership_state.free(&repeat);
    ownership_state.free(&ba);
    ownership_state.free(&ab);
    ownership_state.free(&right);
    ownership_state.free(&left);
}

fn multiplicity_and_descendant(ownership_api.services* svc) void {
    ownership_state.state mut left = ownership_state.empty();
    ownership_state.state mut right = ownership_state.empty();
    ownership_api.allocation_fact mut a = allocation(1, 1, 3);
    a.count.zero = true;
    ownership_api.allocation_fact mut b = allocation(1, 2, 3);
    b.count.one = false;
    b.count.many = true;
    b.owner.detached = true;
    ownership_api.history_fact[1] mut history = {};
    history[0].allocation = b.key;
    history[0].kind = ownership_api.effect_kind.transfer;
    history[0].before.place = place(1);
    history[0].after.place = place(2);
    b.history = history[..];
    ownership_state.append_allocations(&left, a);
    ownership_state.append_allocations(&right, b);
    ownership_api.limit_table bound = limits(3, 4);
    ownership_api.operation_position at = op(2);
    ownership_api.source_position source = ownership_api.source_position{};
    ownership_state.state mut ab = ownership_join.widen(&left, &right, svc, &bound, at, source);
    ownership_state.state mut ba = ownership_join.widen(&right, &left, svc, &bound, at, source);
    assert(ownership_state.equal(&ab, &ba));
    assert(ab.allocations_len == 1 && ab.allocations[0].obligation);
    assert(ab.allocations[0].count.zero && ab.allocations[0].count.one &&
        ab.allocations[0].count.many);
    assert(ab.allocations[0].owner.place.residual && ab.allocations[0].owner.detached);
    assert(ab.allocations[0].history.len == 1);
    ownership_api.mutation_result release = ownership_state.release_member(&ab, svc,
        a.key, true, at, source);
    assert(!release.applied && ab.allocations[0].obligation);
    ownership_state.free(&ba);
    ownership_state.free(&ab);
    ownership_state.free(&right);
    ownership_state.free(&left);
}

fn retained_range(ownership_api.services* svc) void {
    ownership_state.state mut left = ownership_state.empty();
    ownership_state.state mut right = ownership_state.empty();
    ownership_api.region_partition[3] mut partitions = {};
    u64 mut i = 0;
    while (i < partitions.len) {
        partitions[i].key = id(ownership_api.entity_kind.region, cast(i + 1, u32));
        i += 1;
    }
    ownership_api.region mut range = ownership_api.region{};
    range.key = id(ownership_api.entity_kind.region, 7);
    range.source = id(ownership_api.entity_kind.source, 7);
    range.partitions = partitions[..];
    range.extent.kind = ownership_api.fact_kind.exact;
    range.extent.value = 9;
    ownership_state.append_regions(&left, range);
    ownership_api.limit_table bound = limits(4, 2);
    ownership_api.operation_position at = op(3);
    ownership_api.source_position source = ownership_api.source_position{};
    ownership_state.state mut ab = ownership_join.widen(&left, &right, svc, &bound, at, source);
    ownership_state.state mut ba = ownership_join.widen(&right, &left, svc, &bound, at, source);
    assert(ownership_state.equal(&ab, &ba));
    assert(ab.regions_len == 1 && ab.regions[0].residual);
    assert(ab.regions[0].partitions.len == 2);
    assert(ab.regions[0].source.ordinal == 7 && ab.regions[0].extent.value == 9);
    assert(ab.losses_len == 1 && ab.losses[0].category == ownership_api.limit_category.r);
    assert(ab.losses[0].relation.ordinal == 7);
    ownership_state.state mut repeat = ownership_join.widen(&ab, &left, svc,
        &bound, at, source);
    ownership_state.state mut fixed = ownership_join.widen(&repeat, &left, svc,
        &bound, at, source);
    assert(ownership_state.equal(&repeat, &fixed));
    assert(repeat.regions_len == 1 && repeat.losses_len == 1);
    ownership_state.free(&fixed);
    ownership_state.free(&repeat);
    ownership_state.free(&ba);
    ownership_state.free(&ab);
    ownership_state.free(&right);
    ownership_state.free(&left);
}

fn zero_length(ownership_api.services* svc) void {
    ownership_state.state mut allocated = ownership_state.empty();
    ownership_state.state mut empty = ownership_state.empty();
    ownership_api.allocation_fact fact = allocation(9, 9, 0);
    ownership_state.append_allocations(&allocated, fact);
    ownership_api.limit_table bound = limits(4, 4);
    ownership_api.operation_position at = op(4);
    ownership_api.source_position source = ownership_api.source_position{};
    ownership_state.state mut ab = ownership_join.widen(&allocated, &empty, svc, &bound,
        at, source);
    ownership_state.state mut ba = ownership_join.widen(&empty, &allocated, svc, &bound,
        at, source);
    assert(ownership_state.equal(&ab, &ba));
    assert(ab.allocations_len == 1 && ab.allocations[0].obligation);
    assert(ab.allocations[0].logical_length.value == 0);
    assert(ab.allocations[0].count.zero && ab.allocations[0].count.one);
    ownership_state.free(&ba);
    ownership_state.free(&ab);
    ownership_state.free(&empty);
    ownership_state.free(&allocated);
}

fn main() i32 {
    ownership_events.store mut events = ownership_events.store{};
    ownership_api.services mut svc = ownership_api.services{};
    setup(&events, &svc);
    alias_uncertainty(&svc);
    multiplicity_and_descendant(&svc);
    println("G04.4 G05.3 G05.4");
    retained_range(&svc);
    zero_length(&svc);
    println("G07.4 G09.3");
    ownership_events.free(&events);
    return 0;
}
