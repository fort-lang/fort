//! run
//! flags: -I ../../src/fort
//! stdout:
//| G04.4 G05.3 G05.4
//| G07.4 G09.3
//| R P G H residuals
//| trimmed history fixed point
//| nested region residuals
/// Tests residual widening with retained sources and obligations.
import ownership_api;
import ownership_events;
import ownership_join;
import ownership_limits;
import ownership_state;

fn id(ownership_api.entity_kind kind, u32 ordinal) ownership_api.entity_id {
    ownership_api.entity_id mut out = ownership_api.entity_id{};
    out.kind = kind;
    out.ordinal = ordinal;
    return out;
}

fn place(u32 ordinal) ownership_api.place_path {
    ownership_api.place_path mut out = ownership_api.place_path{};
    out.root = id(ownership_api.entity_kind.slot, ordinal);
    return out;
}

fn allocation(u32 ordinal, u32 owner, i64 length)
    ownership_api.allocation_fact {
    ownership_api.allocation_fact mut out = ownership_api.allocation_fact{};
    out.key = id(ownership_api.entity_kind.allocation, ordinal);
    out.site = id(ownership_api.entity_kind.allocation, 1);
    out.validity = ownership_api.validity_kind.live;
    out.count.one = true;
    out.obligation = true;
    out.owner.place = place(owner);
    out.logical_length.kind = ownership_api.fact_kind.exact;
    out.logical_length.value = length;
    return out;
}

fn limits(u64 depth, u64 regions) ownership_api.limit_table {
    ownership_api.limit_table mut out = ownership_limits.production();
    out.d = depth;
    out.r = regions;
    return out;
}

fn setup(ownership_events.store mut* events, ownership_api.services mut* svc) void {
    ownership_api.limit_table bound = ownership_limits.production();
    assert(ownership_events.bind(events, &bound, svc));
}

fn op(u32 ordinal) ownership_api.operation_position {
    ownership_api.operation_position mut out = ownership_api.operation_position{};
    out.operation = ordinal;
    return out;
}

fn alias_uncertainty(ownership_api.services* svc) void {
    ownership_state.state mut left = ownership_state.empty();
    ownership_state.state mut right = ownership_state.empty();
    ownership_api.projection[3] mut parts = {};
    u64 mut i = 0;
    while (i < parts.len) {
        parts[i].kind = ownership_api.projection_kind.field;
        parts[i].field = cast(i, u32);
        i += 1;
    }
    ownership_api.contents_fact mut fact = ownership_api.contents_fact{};
    fact.place = place(1);
    fact.place.projections = parts[..];
    fact.kind = ownership_api.contents_kind.reference;
    fact.value_version = id(ownership_api.entity_kind.value, 1);
    ownership_state.append_contents(&left, fact);
    ownership_api.limit_table bound = limits(2, 4);
    ownership_api.operation_position at = op(1);
    ownership_api.source_position source = ownership_api.source_position{};
    ownership_state.state mut ab = ownership_join.widen(&left, &right, svc, &bound, at, source);
    ownership_state.state mut ba = ownership_join.widen(&right, &left, svc, &bound, at, source);
    assert(ownership_state.equal(&ab, &ba));
    assert(ab.contents_len == 1 && ab.contents[0].place.residual);
    assert(ab.contents[0].place.projections.len == 2);
    assert(ab.losses_len == 1 && ab.losses[0].category == ownership_api.limit_category.d);
    ownership_state.state mut repeat = ownership_join.widen(&ab, &left, svc,
        &bound, at, source);
    ownership_state.state mut fixed = ownership_join.widen(&repeat, &left, svc,
        &bound, at, source);
    assert(ownership_state.equal(&repeat, &fixed));
    assert(repeat.contents_len == 1 && repeat.losses_len == 1);
    ownership_api.place_path[1] aliases = {ab.contents[0].place};
    ownership_state.state mut before = ownership_state.clone(&ab);
    ownership_api.mutation_result update = ownership_state.strong_contents(&ab, svc,
        fact, aliases[..], true, at, source);
    assert(!update.applied && ownership_state.equal(&ab, &before));
    ownership_state.free(&before);
    ownership_state.free(&fixed);
    ownership_state.free(&repeat);
    ownership_state.free(&ba);
    ownership_state.free(&ab);
    ownership_state.free(&right);
    ownership_state.free(&left);
}

fn multiplicity_and_descendant(ownership_api.services* svc) void {
    ownership_state.state mut left = ownership_state.empty();
    ownership_state.state mut right = ownership_state.empty();
    ownership_api.allocation_fact mut a = allocation(1, 1, 3);
    a.count.zero = true;
    ownership_api.allocation_fact mut b = allocation(1, 2, 3);
    b.count.one = false;
    b.count.many = true;
    b.owner.detached = true;
    ownership_api.history_fact[1] mut history = {};
    history[0].allocation = b.key;
    history[0].kind = ownership_api.effect_kind.transfer;
    history[0].before.place = place(1);
    history[0].after.place = place(2);
    b.history = history[..];
    ownership_state.append_allocations(&left, a);
    ownership_state.append_allocations(&right, b);
    ownership_api.limit_table bound = limits(3, 4);
    ownership_api.operation_position at = op(2);
    ownership_api.source_position source = ownership_api.source_position{};
    ownership_state.state mut ab = ownership_join.widen(&left, &right, svc, &bound, at, source);
    ownership_state.state mut ba = ownership_join.widen(&right, &left, svc, &bound, at, source);
    assert(ownership_state.equal(&ab, &ba));
    assert(ab.allocations_len == 1 && ab.allocations[0].obligation);
    assert(ab.allocations[0].count.zero && ab.allocations[0].count.one &&
        ab.allocations[0].count.many);
    assert(ab.allocations[0].owner.place.residual && ab.allocations[0].owner.detached);
    assert(ab.allocations[0].history.len == 1);
    ownership_api.mutation_result release = ownership_state.release_member(&ab, svc,
        a.key, true, at, source);
    assert(!release.applied && ab.allocations[0].obligation);
    ownership_state.free(&ba);
    ownership_state.free(&ab);
    ownership_state.free(&right);
    ownership_state.free(&left);
}

fn retained_range(ownership_api.services* svc) void {
    ownership_state.state mut left = ownership_state.empty();
    ownership_state.state mut right = ownership_state.empty();
    ownership_api.region_partition[3] mut partitions = {};
    u64 mut i = 0;
    while (i < partitions.len) {
        partitions[i].key = id(ownership_api.entity_kind.region, cast(i + 1, u32));
        i += 1;
    }
    ownership_api.region mut range = ownership_api.region{};
    range.key = id(ownership_api.entity_kind.region, 7);
    range.source = id(ownership_api.entity_kind.source, 7);
    range.partitions = partitions[..];
    range.extent.kind = ownership_api.fact_kind.exact;
    range.extent.value = 9;
    ownership_state.append_regions(&left, range);
    ownership_api.limit_table bound = limits(4, 2);
    ownership_api.operation_position at = op(3);
    ownership_api.source_position source = ownership_api.source_position{};
    ownership_state.state mut ab = ownership_join.widen(&left, &right, svc, &bound, at, source);
    ownership_state.state mut ba = ownership_join.widen(&right, &left, svc, &bound, at, source);
    assert(ownership_state.equal(&ab, &ba));
    assert(ab.regions_len == 1 && ab.regions[0].residual);
    assert(ab.regions[0].partitions.len == 2);
    assert(ab.regions[0].source.ordinal == 7);
    assert(ab.regions[0].extent.kind != ownership_api.fact_kind.exact);
    assert(ab.regions[0].partitions[0].residual && ab.regions[0].partitions[1].residual);
    assert(ab.losses_len == 1 && ab.losses[0].category == ownership_api.limit_category.r);
    assert(ab.losses[0].relation.ordinal == 7);
    ownership_state.state mut repeat = ownership_join.widen(&ab, &left, svc,
        &bound, at, source);
    ownership_state.state mut fixed = ownership_join.widen(&repeat, &left, svc,
        &bound, at, source);
    assert(ownership_state.equal(&repeat, &fixed));
    assert(repeat.regions_len == 1 && repeat.losses_len == 1);
    ownership_state.free(&fixed);
    ownership_state.free(&repeat);
    ownership_state.free(&ba);
    ownership_state.free(&ab);
    ownership_state.free(&right);
    ownership_state.free(&left);
}

fn zero_length(ownership_api.services* svc) void {
    ownership_state.state mut allocated = ownership_state.empty();
    ownership_state.state mut empty = ownership_state.empty();
    ownership_api.allocation_fact fact = allocation(9, 9, 0);
    ownership_state.append_allocations(&allocated, fact);
    ownership_api.limit_table bound = limits(4, 4);
    ownership_api.operation_position at = op(4);
    ownership_api.source_position source = ownership_api.source_position{};
    ownership_state.state mut ab = ownership_join.widen(&allocated, &empty, svc, &bound,
        at, source);
    ownership_state.state mut ba = ownership_join.widen(&empty, &allocated, svc, &bound,
        at, source);
    assert(ownership_state.equal(&ab, &ba));
    assert(ab.allocations_len == 1 && ab.allocations[0].obligation);
    assert(ab.allocations[0].logical_length.value == 0);
    assert(ab.allocations[0].count.zero && ab.allocations[0].count.one);
    ownership_state.free(&ba);
    ownership_state.free(&ab);
    ownership_state.free(&empty);
    ownership_state.free(&allocated);
}

fn has_loss(ownership_state.state* s, ownership_api.limit_category category) bool {
    u64 mut i = 0;
    while (i < s->losses_len) {
        if (s->losses[i].category == category &&
            s->losses[i].reason == ownership_api.incomplete_reason.work_limit) {
            return true;
        }
        i += 1;
    }
    return false;
}

fn region_bound(ownership_api.services* svc) void {
    ownership_state.state mut exact = ownership_state.empty();
    ownership_api.allocation_fact a = allocation(30, 30, 4);
    ownership_api.region mut selected = ownership_api.region{};
    selected.key = id(ownership_api.entity_kind.region, 30);
    selected.source = id(ownership_api.entity_kind.source, 30);
    selected.extent.kind = ownership_api.fact_kind.exact;
    selected.extent.value = 4;
    ownership_api.source_fact mut storage = ownership_api.source_fact{};
    storage.key = selected.source;
    storage.kind = ownership_api.source_kind.heap;
    storage.validity = ownership_api.validity_kind.live;
    storage.allocation = a.key;
    ownership_state.append_allocations(&exact, a);
    ownership_state.append_regions(&exact, selected);
    ownership_state.append_sources(&exact, storage);
    ownership_api.limit_table mut bound = limits(4, 1);
    ownership_api.operation_position at = op(30);
    ownership_api.source_position source = ownership_api.source_position{};
    ownership_state.state mut residual = ownership_join.widen(&exact, &exact, svc,
        &bound, at, source);
    assert(has_loss(&residual, ownership_api.limit_category.r));
    assert(residual.allocations[0].obligation && residual.allocations[0].owner.place.residual);
    assert(residual.sources[0].validity == ownership_api.validity_kind.unknown);
    assert(residual.regions[0].residual && residual.regions[0].source.ordinal == 30);
    assert(residual.regions[0].extent.kind != ownership_api.fact_kind.exact);
    ownership_state.state mut before = ownership_state.clone(&residual);
    ownership_api.mutation_result release = ownership_state.release_member(&residual, svc,
        a.key, true, at, source);
    ownership_api.owner_location mut after = ownership_api.owner_location{};
    after.place = place(31);
    ownership_api.mutation_result transfer = ownership_state.transfer_owner(&residual, svc,
        a.key, after, true, at, source);
    assert(!release.applied && !transfer.applied);
    assert(ownership_state.equal(&residual, &before));
    ownership_state.state mut released = ownership_state.clone(&exact);
    assert(ownership_state.release_member(&released, svc, a.key, true, at, source).applied);
    ownership_state.state mut next = ownership_join.widen(&residual, &released, svc,
        &bound, at, source);
    assert(next.allocations[0].obligation && next.allocations[0].owner.place.residual);
    assert(next.allocations[0].history.len == 1);
    assert(next.regions[0].residual && has_loss(&next, ownership_api.limit_category.r));
    ownership_state.state mut fixed = ownership_join.widen(&next, &released, svc,
        &bound, at, source);
    assert(ownership_state.equal(&next, &fixed));
    ownership_state.free(&fixed);
    ownership_state.free(&next);
    ownership_state.free(&released);
    ownership_state.free(&before);
    ownership_state.free(&residual);
    ownership_state.free(&exact);
}

fn predicate_bound(ownership_api.services* svc) void {
    ownership_state.state mut exact = ownership_state.empty();
    ownership_api.allocation_fact a = allocation(40, 40, 4);
    ownership_state.append_allocations(&exact, a);
    ownership_api.predicate_atom mut predicate = ownership_api.predicate_atom{};
    predicate.kind = ownership_api.predicate_kind.equality;
    predicate.key = id(ownership_api.entity_kind.predicate, 40);
    ownership_state.append_predicates(&exact, predicate);
    predicate.key = id(ownership_api.entity_kind.predicate, 41);
    ownership_state.append_predicates(&exact, predicate);
    ownership_api.limit_table mut bound = limits(4, 4);
    bound.p = 1;
    ownership_api.operation_position at = op(40);
    ownership_api.source_position source = ownership_api.source_position{};
    ownership_state.state mut residual = ownership_join.widen(&exact, &exact, svc,
        &bound, at, source);
    assert(residual.predicates_len == 0 && has_loss(&residual, ownership_api.limit_category.p));
    assert(residual.allocations[0].obligation);
    ownership_state.state mut moved = ownership_state.clone(&exact);
    ownership_api.owner_location mut after = ownership_api.owner_location{};
    after.place = place(41);
    assert(ownership_state.transfer_owner(&moved, svc, a.key, after, true, at, source).applied);
    ownership_state.state mut next = ownership_join.widen(&residual, &moved, svc,
        &bound, at, source);
    assert(next.predicates_len == 0 && next.allocations[0].obligation);
    assert(next.allocations[0].history.len == 1);
    assert(has_loss(&next, ownership_api.limit_category.p));
    ownership_state.state mut fixed = ownership_join.widen(&next, &moved, svc,
        &bound, at, source);
    assert(ownership_state.equal(&next, &fixed));
    ownership_state.free(&fixed);
    ownership_state.free(&next);
    ownership_state.free(&moved);
    ownership_state.free(&residual);
    ownership_state.free(&exact);
}

fn guard_bound(ownership_api.services* svc) void {
    ownership_state.state mut exact = ownership_state.empty();
    ownership_api.allocation_fact a = allocation(50, 50, 4);
    ownership_state.append_allocations(&exact, a);
    ownership_api.contents_fact mut contents = ownership_api.contents_fact{};
    contents.place = place(50);
    contents.kind = ownership_api.contents_kind.reference;
    contents.value_version = id(ownership_api.entity_kind.value, 50);
    ownership_api.borrow_relation[1] mut borrows = {};
    borrows[0].key = id(ownership_api.entity_kind.relation, 50);
    borrows[0].source = id(ownership_api.entity_kind.source, 50);
    borrows[0].representation_complete = true;
    contents.borrows = borrows[..];
    ownership_state.append_contents(&exact, contents);
    ownership_api.guard_fact mut guard = ownership_api.guard_fact{};
    guard.key = id(ownership_api.entity_kind.guard, 50);
    ownership_state.append_guards(&exact, guard);
    ownership_api.limit_table mut bound = limits(4, 4);
    bound.g = 1;
    ownership_api.operation_position at = op(50);
    ownership_api.source_position source = ownership_api.source_position{};
    ownership_state.state mut residual = ownership_join.widen(&exact, &exact, svc,
        &bound, at, source);
    assert(has_loss(&residual, ownership_api.limit_category.g));
    assert(residual.allocations[0].obligation && residual.guards_len == 0);
    assert(residual.contents_len == 1 && residual.contents[0].place.residual);
    assert(residual.contents[0].kind == ownership_api.contents_kind.unknown);
    assert(residual.contents[0].borrows.len == 1);
    assert(residual.contents[0].borrows[0].source.ordinal == 50);
    assert(!residual.contents[0].borrows[0].representation_complete);
    ownership_state.state mut before = ownership_state.clone(&residual);
    ownership_api.place_path[1] aliases = {residual.contents[0].place};
    ownership_api.mutation_result update = ownership_state.strong_contents(&residual,
        svc, contents, aliases[..], true, at, source);
    assert(!update.applied && ownership_state.equal(&before, &residual));
    ownership_state.state mut moved = ownership_state.clone(&exact);
    ownership_api.owner_location mut after = ownership_api.owner_location{};
    after.place = place(51);
    assert(ownership_state.transfer_owner(&moved, svc, a.key, after, true, at, source).applied);
    ownership_state.state mut next = ownership_join.widen(&residual, &moved, svc,
        &bound, at, source);
    assert(next.allocations[0].obligation && next.allocations[0].history.len == 1);
    assert(next.contents[0].place.residual && next.contents[0].borrows.len == 1);
    assert(next.guards_len == 0 && has_loss(&next, ownership_api.limit_category.g));
    ownership_state.state mut fixed = ownership_join.widen(&next, &moved, svc,
        &bound, at, source);
    assert(ownership_state.equal(&next, &fixed));
    ownership_state.free(&fixed);
    ownership_state.free(&next);
    ownership_state.free(&moved);
    ownership_state.free(&before);
    ownership_state.free(&residual);
    ownership_state.free(&exact);
}

fn shape_bound(ownership_api.services* svc) void {
    ownership_state.state mut exact = ownership_state.empty();
    ownership_api.allocation_fact a = allocation(60, 60, 4);
    ownership_state.append_allocations(&exact, a);
    ownership_api.entity_id[1] parameters = {a.key};
    ownership_api.shape_description mut shape = ownership_api.shape_description{};
    shape.key = id(ownership_api.entity_kind.template, 60);
    shape.parameters = parameters[..];
    shape.acyclic_proved = true;
    shape.separation_proved = true;
    ownership_state.append_shapes(&exact, shape);
    ownership_api.limit_table mut bound = limits(4, 4);
    bound.h = 1;
    ownership_api.operation_position at = op(60);
    ownership_api.source_position source = ownership_api.source_position{};
    ownership_state.state mut residual = ownership_join.widen(&exact, &exact, svc,
        &bound, at, source);
    assert(has_loss(&residual, ownership_api.limit_category.h));
    assert(residual.allocations[0].obligation && residual.shapes[0].residual);
    assert(!residual.shapes[0].acyclic_proved && !residual.shapes[0].separation_proved);
    ownership_state.state mut released = ownership_state.clone(&exact);
    assert(ownership_state.release_member(&released, svc, a.key, true, at, source).applied);
    ownership_state.state mut next = ownership_join.widen(&residual, &released, svc,
        &bound, at, source);
    assert(next.allocations[0].obligation && next.allocations[0].history.len == 1);
    assert(next.shapes[0].residual && !next.shapes[0].acyclic_proved);
    assert(has_loss(&next, ownership_api.limit_category.h));
    ownership_state.state mut fixed = ownership_join.widen(&next, &released, svc,
        &bound, at, source);
    assert(ownership_state.equal(&next, &fixed));
    ownership_state.free(&fixed);
    ownership_state.free(&next);
    ownership_state.free(&released);
    ownership_state.free(&residual);
    ownership_state.free(&exact);
}

fn history_fixed_point(ownership_api.services* svc) void {
    ownership_state.state mut exact = ownership_state.empty();
    ownership_api.allocation_fact mut a = allocation(80, 80, 4);
    ownership_api.projection[3] mut fields = {};
    u64 mut i = 0;
    while (i < fields.len) {
        fields[i].kind = ownership_api.projection_kind.field;
        fields[i].field = cast(i, u32);
        i += 1;
    }
    ownership_api.history_fact[1] mut events = {};
    events[0].allocation = a.key;
    events[0].kind = ownership_api.effect_kind.transfer;
    events[0].operation = op(80);
    events[0].before.place = place(80);
    events[0].before.place.projections = fields[..];
    events[0].after.place = place(81);
    a.history = events[..];
    ownership_state.append_allocations(&exact, a);
    ownership_api.limit_table bound = limits(2, 4);
    ownership_api.operation_position at = op(81);
    ownership_api.source_position source = ownership_api.source_position{};
    ownership_state.state mut current = ownership_join.widen(&exact, &exact, svc,
        &bound, at, source);
    assert(current.allocations[0].history.len == 1);
    assert(current.allocations[0].history[0].before.place.residual);
    u64 mut round = 0;
    while (round < 6) {
        ownership_state.state mut next = ownership_join.widen(&current, &exact, svc,
            &bound, at, source);
        assert(next.allocations[0].history.len == 1);
        assert(next.allocations[0].obligation);
        assert(ownership_state.equal(&current, &next));
        ownership_state.free(&current);
        current = move(next);
        round += 1;
    }
    ownership_state.state mut reverse = ownership_join.widen(&exact, &current, svc,
        &bound, at, source);
    assert(ownership_state.equal(&current, &reverse));
    ownership_state.free(&reverse);
    ownership_state.free(&current);
    ownership_state.free(&exact);
}

fn nested_region_bound(ownership_api.services* svc) void {
    ownership_state.state mut left = ownership_state.empty();
    ownership_state.state mut right = ownership_state.empty();
    ownership_api.allocation_fact a = allocation(100, 100, 4);
    ownership_state.append_allocations(&left, a);
    ownership_state.append_allocations(&right, a);
    ownership_api.source_fact mut storage = ownership_api.source_fact{};
    storage.key = id(ownership_api.entity_kind.source, 100);
    storage.kind = ownership_api.source_kind.heap;
    storage.validity = ownership_api.validity_kind.live;
    storage.allocation = a.key;
    ownership_state.append_sources(&left, storage);
    ownership_state.append_sources(&right, storage);
    ownership_api.borrow_relation[1] mut left_loan = {};
    left_loan[0].key = id(ownership_api.entity_kind.relation, 100);
    left_loan[0].source = storage.key;
    left_loan[0].range.key = id(ownership_api.entity_kind.region, 100);
    left_loan[0].range.source = storage.key;
    left_loan[0].representation_complete = true;
    ownership_api.borrow_relation[1] mut right_loan = {};
    right_loan[0].key = id(ownership_api.entity_kind.relation, 101);
    right_loan[0].source = storage.key;
    right_loan[0].range.key = id(ownership_api.entity_kind.region, 101);
    right_loan[0].range.source = storage.key;
    right_loan[0].representation_complete = true;
    ownership_api.contents_fact mut left_value = ownership_api.contents_fact{};
    left_value.place = place(100);
    left_value.kind = ownership_api.contents_kind.reference;
    left_value.borrows = left_loan[..];
    ownership_api.contents_fact mut right_value = ownership_api.contents_fact{};
    right_value.place = place(101);
    right_value.kind = ownership_api.contents_kind.reference;
    right_value.borrows = right_loan[..];
    ownership_state.append_contents(&left, left_value);
    ownership_state.append_contents(&right, right_value);
    ownership_api.limit_table bound = limits(4, 2);
    ownership_api.operation_position at = op(100);
    ownership_api.source_position source = ownership_api.source_position{};
    ownership_state.state mut ab = ownership_join.join(&left, &right, svc,
        &bound, at, source);
    ownership_state.state mut ba = ownership_join.join(&right, &left, svc,
        &bound, at, source);
    assert(ownership_state.equal(&ab, &ba));
    assert(has_loss(&ab, ownership_api.limit_category.r));
    assert(ab.allocations_len == 1 && ab.allocations[0].obligation);
    assert(ab.allocations[0].owner.place.residual);
    assert(ab.sources_len == 1 && ab.sources[0].validity ==
        ownership_api.validity_kind.unknown);
    assert(ab.contents_len == 2 && ab.contents[0].borrows.len == 1 &&
        ab.contents[1].borrows.len == 1);
    assert(ab.contents[0].borrows[0].range.residual &&
        ab.contents[1].borrows[0].range.residual);
    assert(ab.contents[0].borrows[0].source.ordinal == 100 &&
        ab.contents[1].borrows[0].source.ordinal == 100);
    assert(!ab.contents[0].borrows[0].representation_complete &&
        !ab.contents[1].borrows[0].representation_complete);
    ownership_state.state mut widened = ownership_join.widen(&left, &right, svc,
        &bound, at, source);
    ownership_state.state mut widened_reverse = ownership_join.widen(&right, &left, svc,
        &bound, at, source);
    assert(ownership_state.equal(&ab, &widened));
    assert(ownership_state.equal(&widened, &widened_reverse));
    ownership_state.state mut next = ownership_join.widen(&ab, &left, svc,
        &bound, at, source);
    assert(next.allocations[0].obligation && next.contents_len == 2);
    assert(next.contents[0].borrows[0].range.residual);
    assert(has_loss(&next, ownership_api.limit_category.r));
    ownership_state.state mut partitioned = ownership_state.empty();
    ownership_state.append_allocations(&partitioned, a);
    ownership_state.append_sources(&partitioned, storage);
    ownership_api.region_partition[1] mut partition = {};
    partition[0].key = id(ownership_api.entity_kind.region, 102);
    left_loan[0].range.partitions = partition[..];
    left_value.borrows = left_loan[..];
    ownership_state.append_contents(&partitioned, left_value);
    ownership_state.state mut with_partition = ownership_join.join(&partitioned,
        &partitioned, svc, &bound, at, source);
    assert(has_loss(&with_partition, ownership_api.limit_category.r));
    assert(with_partition.contents[0].borrows[0].range.residual);
    assert(with_partition.contents[0].borrows[0].range.partitions[0].residual);
    ownership_state.free(&with_partition);
    ownership_state.free(&partitioned);
    ownership_state.free(&next);
    ownership_state.free(&widened);
    ownership_state.free(&widened_reverse);
    ownership_state.free(&ba);
    ownership_state.free(&ab);
    ownership_state.free(&right);
    ownership_state.free(&left);
}

fn main() i32 {
    ownership_events.store mut events = ownership_events.store{};
    ownership_api.services mut svc = ownership_api.services{};
    setup(&events, &svc);
    alias_uncertainty(&svc);
    multiplicity_and_descendant(&svc);
    println("G04.4 G05.3 G05.4");
    retained_range(&svc);
    zero_length(&svc);
    println("G07.4 G09.3");
    region_bound(&svc);
    predicate_bound(&svc);
    guard_bound(&svc);
    shape_bound(&svc);
    println("R P G H residuals");
    history_fixed_point(&svc);
    println("trimmed history fixed point");
    nested_region_bound(&svc);
    println("nested region residuals");
    ownership_events.free(&events);
    return 0;
}
