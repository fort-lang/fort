//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| implicit ok
//| casts ok
//| further ok
//| matrix ok
//| ok
import prim;
import types;
import types_env;

// The conversions of a type: the implicit drops of mutability and of
// ownership, and the cast matrix. Every example those rules give is one
// assertion, with the further rows the rules imply, and the last four tests
// re-derive the matrix and the invariants that tie the two together. The port
// of test/types_convert_test.c.
// D5.4, D17.4, D3.14

// The class of a scalar type in the cast matrix.
// D3.14
enum scalar_class {
    class_int,
    class_float,
    class_bool,
    class_char,
    class_enum,
}

// The scalar types of the matrix, and the sample types the invariants walk.
u64 SCALARS_MAX = 14;
u64 SAMPLES_MAX = 35;

// The ordered pairs of that table whose cast would add a mark, read off the
// failure of no_conversion_and_no_cast_adds_mut below. A ticket that adds a
// spelling to the table reads the new number there and writes it here, as
// test/types_convert_test.c's MUT_ADDING_PAIRS does.
//
// `u8 mut@`, `node mut*@` and `node mut*[2]` are in the table for the two arms
// of the rule that the other 32 spellings never reached: a `string` source,
// whose bytes carry no level behind them, and a `mut` inside a fixed array. The
// review that asked for them measured both arms at 0 of the pairs the table
// held before them, so a mutation in either left the count and the gate
// untouched. The array arm holds 34 of the 336 today and the `string` arm 2.
// `node mut*@` is the one that reaches the `string` arm, because a target whose
// own level is mutable is answered by the level before it.
// D3.14
u64 MUT_ADDING_PAIRS = 336;

// Whether a value of the type spelled `src` may be used where the type spelled
// `dst` is expected.
// D5.4, D17.4
fn bool assignable(types_env.env mut* e, string dst, string src) {
    types.node* d = types_env.type_of(e, dst);
    types.node* s = types_env.type_of(e, src);
    return types.type_assignable(d, s);
}

// Whether `cast(expr, dst)` is allowed on an expression of type `src`.
// D3.14
fn bool castable(types_env.env mut* e, string dst, string src) {
    types.node* d = types_env.type_of(e, dst);
    types.node* s = types_env.type_of(e, src);
    return types.type_cast_allowed(d, s);
}

// The matrix rows for scalars, re-derived from the table rather than from the
// implementation: identity always; integers and floats convert both ways; an
// integer also becomes a `char` or an enum; `bool`, `char` and an enum become
// an integer and nothing else.
fn bool matrix_allows(scalar_class dst, scalar_class src, bool identical) {
    if (identical) {
        return true;
    }
    if (src == scalar_class.class_int || src == scalar_class.class_float) {
        if (dst == scalar_class.class_int || dst == scalar_class.class_float) {
            return true;
        }
        return src == scalar_class.class_int &&
               (dst == scalar_class.class_char || dst == scalar_class.class_enum);
    }
    return dst == scalar_class.class_int;
}

fn u64 scalar_types(types_env.env mut* e, types.node* mut@ list, scalar_class mut@ classes) {
    u64 mut n = 0;
    u64 mut i = 0;
    while (i < prim.PRIM_COUNT) {
        prim.prim_kind k = cast(i, prim.prim_kind);
        if (k != prim.prim_kind.prim_void) {
            list[n] = types.type_prim(&e->tt, k);
            if (prim.prim_is_integer(k)) {
                classes[n] = scalar_class.class_int;
            } else if (prim.prim_is_float(k)) {
                classes[n] = scalar_class.class_float;
            } else if (k == prim.prim_kind.prim_bool) {
                classes[n] = scalar_class.class_bool;
            } else {
                classes[n] = scalar_class.class_char;
            }
            n += 1;
        }
        i += 1;
    }
    list[n] = e->color;
    classes[n] = scalar_class.class_enum;
    n += 1;
    list[n] = e->shape;
    classes[n] = scalar_class.class_enum;
    n += 1;
    return n;
}

// The reference and value types the invariant tests walk, function types and
// references to them included: the marks inside a function type are part of
// its identity, so a property that never sees one cannot tell whether a
// conversion respects them.
// D3.10
fn u64 sample_types(types_env.env mut* e, types.node* mut@ list) {
    string[29] spellings = {"i32", "u8", "bool", "char", "f64", "node*", "node mut*",
                            "node mut* own", "node**", "node* mut*", "node*@", "node mut* mut@",
                            "node mut* own mut@ own", "node* own@", "node* own[4]", "i32@",
                            "i32 mut@", "u8 mut@", "node mut*@", "node mut*[2]", "i32[4]",
                            "point", "string",
                            "string own", "void*", "void* own", "void mut*", "void mut* own",
                            "u8 mut@ own mut*"};
    u64 mut n = 0;
    while (n < spellings.len) {
        list[n] = types_env.type_of(e, spellings[n]);
        n += 1;
    }
    types.node* v = types.type_void(&e->tt);
    types.node* takes_node = types_env.fn1(e, v, types_env.type_of(e, "node*"));
    types.node* takes_mut = types_env.fn1(e, v, types_env.type_of(e, "node mut*"));
    list[n] = takes_node;
    n += 1;
    list[n] = takes_mut;
    n += 1;
    list[n] = types_env.fn1(e, types_env.type_of(e, "i32"), types_env.type_of(e, "i32"));
    n += 1;
    list[n] = types.type_span(&e->tt, takes_node, false, false);
    n += 1;
    list[n] = types.type_span(&e->tt, takes_mut, false, false);
    n += 1;
    list[n] = types.type_ptr(&e->tt, takes_node, false, false);
    n += 1;
    return n;
}

// Reports a failing pair of a property test the way the C's TEST_LOG_ does,
// then fails: a loop assertion is otherwise opaque about which pair broke it.
fn void fail_pair(types_env.env mut* e, types.node* a, string between, types.node* b) {
    print(types_env.str_of(e, a));
    print(between);
    println(types_env.str_of(e, b));
    assert(false);
}

// ---- dropping mutability -------------------------------------------------------
// D5.4

fn void the_d5_4_conversions_and_their_shape() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    assert(assignable(&e, "node*", "node mut*"));
    assert(assignable(&e, "node* mut", "node mut*"));
    assert(!assignable(&e, "node mut*", "node*"));
    assert(assignable(&e, "node**", "node mut* mut*"));
    assert(!assignable(&e, "node* mut*", "node mut* mut*"));
    assert(assignable(&e, "node*@", "node mut* mut@"));
    assert(assignable(&e, "node mut*@", "node mut* mut@"));
    assert(!assignable(&e, "node* mut@", "node mut* mut@"));
    assert(assignable(&e, "i32@@ mut", "i32 mut@ mut@"));
    assert(!assignable(&e, "i32@ mut@", "i32 mut@ mut@"));
    assert(assignable(&e, "i32@", "i32 mut@"));
    assert(!assignable(&e, "i32 mut@", "i32@"));
    // The storage a `void*` reaches is a level like any other: dropping its
    // `mut` is the one implicit conversion, and adding it needs a cast.
    // D3.11, D5.4
    assert(assignable(&e, "void*", "void mut*"));
    assert(!assignable(&e, "void mut*", "void*"));
    assert(assignable(&e, "void* mut", "void mut*"));
    assert(assignable(&e, "void mut* mut", "void mut*"));
    // The C `T** -> const T**` hole is closed here too: level 1 of the target
    // must be immutable before level 2 may be dropped.
    // D5.4
    assert(assignable(&e, "void**", "void mut* mut*"));
    assert(!assignable(&e, "void* mut*", "void mut* mut*"));
    assert(assignable(&e, "void*@", "void mut* mut@"));
    assert(assignable(&e, "void mut*@", "void mut* mut@"));
    assert(!assignable(&e, "void* mut@", "void mut* mut@"));
}

fn void mutability_drops_through_further_shapes() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    // Level 0 of the receiving binding is unconstrained in both directions.
    assert(assignable(&e, "node*", "node* mut"));
    assert(assignable(&e, "node* mut", "node*"));
    // A fixed array adds no level, so its elements follow the same rule.
    assert(assignable(&e, "node*[4]", "node mut*[4]"));
    assert(!assignable(&e, "node mut*[4]", "node*[4]"));
    assert(!assignable(&e, "node*[4]", "node*[8]"));
    assert(assignable(&e, "i32[4]*", "i32[4] mut*"));
    // Identity always converts.
    assert(assignable(&e, "u8 mut@ own mut*", "u8 mut@ own mut*"));
    assert(assignable(&e, "string", "string"));
    assert(assignable(&e, "point", "point"));
    assert(assignable(&e, "color", "color"));
    assert(!assignable(&e, "point", "node"));
    assert(!assignable(&e, "color", "shape"));
    assert(!assignable(&e, "i64", "i32"));
    assert(!assignable(&e, "f64", "i32"));
    assert(!assignable(&e, "i32@", "i32[4]"));
}

// ---- lending -------------------------------------------------------------------
// D17.4

fn void the_d17_4_conversions_and_their_shape() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    assert(assignable(&e, "u8 mut@", "u8 mut@ own"));
    assert(assignable(&e, "u8@", "u8 mut@ own"));
    assert(assignable(&e, "node*", "node* own"));
    assert(!assignable(&e, "node* own", "node*"));
    assert(assignable(&e, "node mut* own mut@", "node mut* own mut@ own"));
    assert(assignable(&e, "node*@", "node mut* own mut@ own"));
    assert(assignable(&e, "node* own@ own", "node mut* own mut@ own"));
    assert(!assignable(&e, "node mut* mut@ own", "node mut* own mut@ own"));
    assert(!assignable(&e, "node mut* mut@", "node mut* own mut@ own"));
    assert(assignable(&e, "u8@*", "u8 mut@ own mut*"));
    assert(!assignable(&e, "u8 mut@ mut*", "u8 mut@ own mut*"));
    assert(assignable(&e, "string", "string own"));
}

fn void ownership_is_never_added_implicitly() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    assert(!assignable(&e, "string own", "string"));
    assert(!assignable(&e, "void* own", "void*"));
    assert(!assignable(&e, "void mut* own", "void mut*"));
    assert(!assignable(&e, "u8@ own", "u8@"));
    assert(!assignable(&e, "node* own@ own", "node mut* mut@ own"));
    assert(!assignable(&e, "node* own@", "node*@"));
    // Dropping `own` and mutability together is one conversion.
    assert(assignable(&e, "void*", "void* own"));
    // An owned writable allocation lends as a plain view; the reverse adds a
    // mark in each direction.
    assert(assignable(&e, "void*", "void mut* own"));
    assert(!assignable(&e, "void mut*", "void* own"));
    assert(assignable(&e, "node* own@", "node* own@ own"));
    assert(assignable(&e, "u8@", "u8@ own"));
}

fn void assignability_of_null_void_and_the_error_type() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node* null_t = types.type_null(&e.tt);
    types.node* err = types.type_error(&e.tt);
    types.node* i32t = types.type_prim(&e.tt, prim.prim_kind.prim_i32);
    // `null` adopts a pointer, `void*` or function type.
    // D10.5
    assert(types.type_assignable(types_env.type_of(&e, "node*"), null_t));
    assert(types.type_assignable(types_env.type_of(&e, "node mut* own"), null_t));
    assert(types.type_assignable(types_env.type_of(&e, "void*"), null_t));
    assert(types.type_assignable(types_env.fn1(&e, i32t, i32t), null_t));
    // Not a span, a string or a value type: the zero value is `{}`.
    // D3.5
    assert(!types.type_assignable(types_env.type_of(&e, "i32@"), null_t));
    assert(!types.type_assignable(types_env.type_of(&e, "string"), null_t));
    assert(!types.type_assignable(types_env.type_of(&e, "i32"), null_t));
    assert(!types.type_assignable(null_t, types_env.type_of(&e, "node*")));
    // A poisoned type converts both ways, so one error is reported once.
    assert(types.type_assignable(err, types_env.type_of(&e, "i32")));
    assert(types.type_assignable(types_env.type_of(&e, "i32"), err));
    // No value has type `void`.
    assert(!types.type_assignable(types.type_void(&e.tt), types.type_void(&e.tt)));
    assert(!types.type_assignable(types_env.type_of(&e, "i32"), types.type_void(&e.tt)));
}

fn void function_types_convert_only_to_themselves() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node* i32t = types.type_prim(&e.tt, prim.prim_kind.prim_i32);
    types.node* v = types.type_void(&e.tt);
    assert(types.type_assignable(types_env.fn1(&e, i32t, i32t), types_env.fn1(&e, i32t, i32t)));
    assert(!types.type_assignable(types_env.fn1(&e, i32t, i32t), types_env.fn1(&e, v, i32t)));
    // No variance on a parameter's pointee mutability or `own`.
    // D3.10
    types.node* takes_node = types_env.fn1(&e, v, types_env.type_of(&e, "node*"));
    types.node* takes_mut = types_env.fn1(&e, v, types_env.type_of(&e, "node mut*"));
    types.node* takes_own = types_env.fn1(&e, v, types_env.type_of(&e, "node* own"));
    assert(!types.type_assignable(takes_node, takes_mut));
    assert(!types.type_assignable(takes_mut, takes_node));
    assert(!types.type_assignable(takes_node, takes_own));
    assert(!types.type_assignable(takes_own, takes_node));
}

// ---- casts ---------------------------------------------------------------------
// D3.14

fn void casts_among_numbers_bool_char_and_enums() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    assert(castable(&e, "i64", "i32")); // widening
    assert(castable(&e, "i32", "i64")); // narrowing
    assert(castable(&e, "u32", "i32")); // same width, other sign
    assert(castable(&e, "f64", "i32")); // integer to float
    assert(castable(&e, "i32", "f64")); // float to integer
    assert(castable(&e, "f64", "f32")); // float to float
    assert(castable(&e, "f32", "f64"));
    assert(castable(&e, "i32", "bool")); // bool to integer
    assert(castable(&e, "i32", "char")); // char to and from integer
    assert(castable(&e, "char", "i32"));
    assert(castable(&e, "u8", "char"));
    assert(types.type_cast_allowed(types.type_prim(&e.tt, prim.prim_kind.prim_i32), e.color));
    assert(types.type_cast_allowed(e.color, types.type_prim(&e.tt, prim.prim_kind.prim_u8)));
    assert(types.type_cast_allowed(e.color, e.color));
}

fn void casts_refused_among_scalars() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    assert(!castable(&e, "bool", "i32"));  // integer to bool
    assert(!castable(&e, "bool", "char")); // char to bool
    assert(!castable(&e, "f64", "char"));  // char to float
    assert(!castable(&e, "char", "f64"));  // float to char
    assert(!castable(&e, "bool", "f64"));  // float to bool
    assert(!castable(&e, "f64", "bool"));  // bool to float
    assert(!castable(&e, "char", "bool")); // bool to char
    assert(!types.type_cast_allowed(e.color, e.shape)); // enum to enum
    assert(!types.type_cast_allowed(e.color, types.type_prim(&e.tt, prim.prim_kind.prim_bool)));
    assert(!types.type_cast_allowed(e.color, types.type_prim(&e.tt, prim.prim_kind.prim_f64)));
    assert(!types.type_cast_allowed(e.color, types.type_prim(&e.tt, prim.prim_kind.prim_char)));
    assert(!types.type_cast_allowed(types.type_prim(&e.tt, prim.prim_kind.prim_bool), e.color));
    assert(!types.type_cast_allowed(types.type_prim(&e.tt, prim.prim_kind.prim_f64), e.color));
}

fn void casts_among_pointers_and_u64() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    assert(castable(&e, "point*", "node*")); // any pointer to any pointer
    // D17.3: the source already carries the `mut` the target keeps
    assert(castable(&e, "node mut* own", "node mut*")); // adopts
    assert(castable(&e, "node*", "node mut* own"));     // lends
    assert(castable(&e, "void*", "node*"));
    assert(castable(&e, "node*", "void*"));
    assert(castable(&e, "void* own", "void*"));
    // A `mut` the source carries reaches the level a `void*` names, in both
    // directions, and a cast that only drops it is allowed as well.
    // D3.14
    assert(castable(&e, "void mut*", "node mut*"));
    assert(castable(&e, "node mut*", "void mut*"));
    assert(castable(&e, "void*", "void mut*"));
    assert(castable(&e, "node*", "node mut*"));
    assert(castable(&e, "u64", "node*"));
    assert(castable(&e, "node*", "u64"));
    assert(castable(&e, "u64", "void*"));
    assert(castable(&e, "void*", "u64"));
    assert(castable(&e, "void* own", "u64"));
    assert(castable(&e, "node**", "node* mut*"));
    // Pointers cast to no other integer type, and never to a span.
    assert(!castable(&e, "i64", "node*"));
    assert(!castable(&e, "i32", "node*"));
    assert(!castable(&e, "u32", "void*"));
    assert(!castable(&e, "i32@", "i32*"));
    assert(!castable(&e, "i32*", "i32@"));
    assert(!castable(&e, "i64", "i32@"));
    // No pointer cast adds the `mut`, from a typed pointer, from a `void*` or
    // from the address in a `u64`.
    // D3.14
    assert(!castable(&e, "node mut*", "node*"));
    assert(!castable(&e, "node mut* own", "node*"));
    assert(!castable(&e, "void mut*", "void*"));
    assert(!castable(&e, "void mut*", "node*"));
    assert(!castable(&e, "node mut*", "void*"));
    assert(!castable(&e, "void mut* own", "u64"));
    assert(!castable(&e, "node mut*", "u64"));
}

fn void casts_of_function_pointers_go_through_voidptr() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node* i32t = types.type_prim(&e.tt, prim.prim_kind.prim_i32);
    types.node* i64t = types.type_prim(&e.tt, prim.prim_kind.prim_i64);
    types.node* f = types_env.fn1(&e, i32t, i32t);
    types.node* g = types_env.fn1(&e, i64t, i32t);
    types.node* vp = types_env.type_of(&e, "void*");
    assert(types.type_cast_allowed(vp, f));
    assert(types.type_cast_allowed(f, vp));
    assert(types.type_cast_allowed(f, f));
    assert(!types.type_cast_allowed(g, f));
    assert(!types.type_cast_allowed(types.type_prim(&e.tt, prim.prim_kind.prim_u64), f));
    assert(!types.type_cast_allowed(f, types.type_prim(&e.tt, prim.prim_kind.prim_u64)));
    assert(!types.type_cast_allowed(f, types_env.type_of(&e, "node*")));
    assert(!types.type_cast_allowed(types_env.type_of(&e, "node*"), f));
}

fn void casts_within_the_string_family() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    assert(castable(&e, "char@", "string"));
    assert(castable(&e, "u8@", "string"));
    assert(castable(&e, "string", "char@"));
    assert(castable(&e, "string", "u8@"));
    assert(castable(&e, "u8@", "char@"));
    assert(castable(&e, "char@", "u8@"));
    assert(castable(&e, "string", "u8 mut@"));
    assert(castable(&e, "u8@", "u8 mut@"));
    assert(castable(&e, "char mut@", "u8 mut@"));
    // Adoption and lending are both casts.
    // D17.3, D17.12
    assert(castable(&e, "string own", "u8 mut@ own"));
    assert(castable(&e, "string", "u8 mut@ own"));
    assert(castable(&e, "string own", "string"));
    assert(castable(&e, "string", "string own"));
    // The element type of any other span never changes.
    assert(!castable(&e, "i8@", "u8@"));
    assert(!castable(&e, "string", "i8@"));
    assert(!castable(&e, "i32@", "u32@"));
    // The bytes of a `string` are immutable, and no member of the family adds
    // the `mut` back, so the two casts of `cast(cast(b, string), u8 mut@)`
    // launder nothing.
    // D3.7, D3.14
    assert(!castable(&e, "char mut@", "string"));
    assert(!castable(&e, "u8 mut@", "string"));
    assert(!castable(&e, "u8 mut@", "u8@"));
    assert(!castable(&e, "char mut@", "u8@"));
    assert(!castable(&e, "u8 mut@ own", "string"));
}

fn void a_span_cast_never_launders_a_signature_or_an_owner() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node* v = types.type_void(&e.tt);
    types.node* takes_node = types_env.fn1(&e, v, types_env.type_of(&e, "node*"));
    types.node* takes_mut = types_env.fn1(&e, v, types_env.type_of(&e, "node mut*"));
    types.node* of_node = types.type_span(&e.tt, takes_node, false, false);
    types.node* of_mut = types.type_span(&e.tt, takes_mut, false, false);
    // The marks of a parameter are part of the function type's identity, so
    // those spans have different element types and the row for marks does not
    // reach them, exactly as the cast on one element does not.
    // D3.10, D3.14
    assert(!types.type_cast_allowed(of_node, of_mut));
    assert(!types.type_cast_allowed(of_mut, of_node));
    assert(!types.type_cast_allowed(takes_node, takes_mut));
    assert(!types.type_same_shape(of_node, of_mut));
    assert(types.type_cast_allowed(of_node, of_node));
    // A span of function pointers still casts where its own marks differ, so
    // long as the marks are not added: `own` may be, `mut` may not.
    // D3.14
    assert(types.type_cast_allowed(types.type_span(&e.tt, takes_node, true, false), of_node));
    assert(!types.type_cast_allowed(types.type_span(&e.tt, takes_node, true, true), of_node));
    assert(types.type_cast_allowed(of_node, types.type_span(&e.tt, takes_node, false, true)));
    // Dropping an `own` under a reference the target still owns would leave
    // its objects owned by nobody, which no cast licenses.
    // D17.4
    assert(!castable(&e, "node mut* mut@ own", "node mut* own mut@ own"));
    assert(!castable(&e, "node* mut@ own", "node* own@ own"));
    assert(!castable(&e, "u8@ mut@ own", "u8@ own@ own"));
    // Dropping it with no owner outside is lending, which a cast may do even
    // where the implicit rule refuses.
    // D3.14
    assert(castable(&e, "node mut* mut@", "node mut* own mut@ own"));
    assert(castable(&e, "node*@", "node mut* own mut@ own"));
    assert(castable(&e, "node mut* own mut@", "node mut* own mut@ own"));
}

fn void casts_of_spans_change_only_the_marks() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    // The element type never changes; mutability is dropped at any level, and
    // `own` is added or dropped at any reference.
    // D3.14
    assert(castable(&e, "node*@", "node* mut@"));
    assert(castable(&e, "i32@@ mut", "i32 mut@ mut@"));
    assert(castable(&e, "u8@", "u8@ own"));
    assert(castable(&e, "i32@", "i32 mut@"));
    assert(castable(&e, "node mut* mut@", "node mut* own mut@ own"));
    // The route a caller of `std.sort_ptr` takes: the drop at level 2 behind a
    // mutable level 1, which the implicit conversion refuses and the cast makes.
    // D5.4, D3.14
    assert(castable(&e, "node* mut@", "node mut* mut@"));
    assert(!assignable(&e, "node* mut@", "node mut* mut@"));
    assert(!castable(&e, "node*@", "point*@"));
    assert(!castable(&e, "i32@@", "i32@"));
    // A span adds no `mut`, at the slots or at any level below them.
    // D3.14
    assert(!castable(&e, "node* mut@", "node*@"));
    assert(!castable(&e, "node mut* mut@", "node* mut@"));
    assert(!castable(&e, "i32 mut@ mut@", "i32@ mut@"));
    assert(!castable(&e, "i32 mut@", "i32@"));
    assert(!castable(&e, "i32 mut@ own", "i32@"));
    assert(!castable(&e, "node mut* own mut@", "node*@"));
}

fn void a_cast_never_adds_mut() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    // One rule over every row of the matrix: the target marks a level `mut`
    // only where the source marks the level at the same depth `mut` too.
    // D3.14
    assert(types.type_cast_adds_mut(types_env.type_of(&e, "node mut*"),
                                    types_env.type_of(&e, "node*")));
    assert(!types.type_cast_adds_mut(types_env.type_of(&e, "node*"),
                                     types_env.type_of(&e, "node mut*")));
    assert(!types.type_cast_adds_mut(types_env.type_of(&e, "node mut*"),
                                     types_env.type_of(&e, "node mut*")));
    // A level below the outermost is a level like any other, and the drop at
    // that level stays legal.
    assert(!castable(&e, "node mut* mut*", "node* mut*"));
    assert(castable(&e, "node* mut*", "node mut* mut*"));
    assert(!castable(&e, "node mut* mut@", "node* mut@"));
    assert(castable(&e, "node* mut@", "node mut* mut@"));
    // `void*` is a source like any other, so the two casts of
    // `cast(cast(p, void*), u8 mut*)` refuse the second one. A `void mut*`
    // carries the mark and the same cast compiles.
    // D3.11, D3.14
    assert(!castable(&e, "u8 mut*", "void*"));
    assert(castable(&e, "u8 mut*", "void mut*"));
    assert(castable(&e, "u8*", "void*"));
    // An integer, a `string` and a function pointer name no level at all, so a
    // target that marks one adds it.
    assert(!castable(&e, "u8 mut*", "u64"));
    assert(castable(&e, "u8*", "u64"));
    assert(!castable(&e, "u8 mut@", "string"));
    assert(castable(&e, "u8@", "string"));
    assert(types.type_cast_adds_mut(types_env.type_of(&e, "void mut*"),
                                    types_env.fn1(&e, types.type_void(&e.tt),
                                                  types_env.type_of(&e, "node*"))));
    // Where the pointee type diverges, the source says nothing about the levels
    // below the divergence, so the target marks none of them.
    assert(!castable(&e, "node mut* mut*", "u8 mut*"));
    assert(castable(&e, "node* mut*", "u8 mut*"));
    assert(castable(&e, "u8 mut*", "node mut* mut*"));
    // A fixed array adds no level of its own: the elements are compared.
    // D5.2
    assert(!castable(&e, "node mut*[2]", "node*[2]"));
    assert(castable(&e, "node*[2]", "node mut*[2]"));
}

fn void casts_refused_for_structs_and_fixed_arrays() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    assert(types.type_cast_allowed(e.point, e.point)); // identity
    assert(!types.type_cast_allowed(e.point, e.node));
    assert(!types.type_cast_allowed(types.type_prim(&e.tt, prim.prim_kind.prim_u64), e.point));
    assert(!types.type_cast_allowed(e.point, types.type_prim(&e.tt, prim.prim_kind.prim_u64)));
    assert(castable(&e, "i32[4]", "i32[4]"));
    assert(!castable(&e, "i32@", "i32[4]"));
    assert(!castable(&e, "i32[4]", "i32@"));
    assert(!castable(&e, "i32[4]", "i32[8]"));
    assert(!castable(&e, "u64", "i32[4]"));
}

// A span is `{ptr, len}` and a pointer is an address: neither reaches the
// other, and a span expression or `.ptr` is the way across.
// D3.5, D3.14
fn void casts_between_a_reference_and_a_fat_pointer_are_refused() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    assert(!castable(&e, "u8@", "u8*"));
    assert(!castable(&e, "u8*", "u8@"));
    assert(!castable(&e, "u8 mut@", "u8 mut*"));
    assert(!castable(&e, "string", "char*"));
    assert(!castable(&e, "char*", "string"));
    assert(!castable(&e, "string", "void*"));
    assert(!castable(&e, "void*", "string"));
    assert(!castable(&e, "u8@", "void*"));
    assert(!castable(&e, "void*", "u8@"));
    assert(!castable(&e, "string", "u64"));
    assert(!castable(&e, "u64", "string"));
    assert(!castable(&e, "u64", "u8@"));
    assert(!castable(&e, "u8@", "u64"));
    // A pointer to a span is a pointer, and casts like one.
    assert(castable(&e, "u64", "u8@*"));
    assert(castable(&e, "void*", "u8@*"));
}

fn void casts_of_null_void_and_the_error_type() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node* err = types.type_error(&e.tt);
    types.node* null_t = types.type_null(&e.tt);
    types.node* v = types.type_void(&e.tt);
    types.node* p = types_env.type_of(&e, "node*");
    // `null` has no type of its own, so it is not a cast operand.
    // D10.5
    assert(!types.type_cast_allowed(p, null_t));
    assert(!types.type_cast_allowed(null_t, p));
    // `void` is not a value type.
    assert(!types.type_cast_allowed(v, p));
    assert(!types.type_cast_allowed(p, v));
    // A poisoned operand casts anywhere: the error was reported already.
    assert(types.type_cast_allowed(err, p));
    assert(types.type_cast_allowed(p, err));
}

// ---- further conversions -------------------------------------------------------

fn void assignability_is_reflexive_for_every_kind() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    assert(assignable(&e, "i32", "i32"));
    assert(assignable(&e, "bool", "bool"));
    assert(assignable(&e, "char", "char"));
    assert(assignable(&e, "f64", "f64"));
    assert(assignable(&e, "node*", "node*"));
    assert(assignable(&e, "node mut* own", "node mut* own"));
    assert(assignable(&e, "void*", "void*"));
    assert(assignable(&e, "void* own", "void* own"));
    assert(assignable(&e, "void mut*", "void mut*"));
    assert(assignable(&e, "void mut* own", "void mut* own"));
    assert(assignable(&e, "i32[4]", "i32[4]"));
    assert(assignable(&e, "i32[3][4]", "i32[3][4]"));
    assert(assignable(&e, "string own", "string own"));
    assert(assignable(&e, "node* own[4]", "node* own[4]"));
    assert(assignable(&e, "u8 mut@ own mut*", "u8 mut@ own mut*"));
    assert(types.type_assignable(e.vec, e.vec));
    assert(types.type_assignable(e.color, e.color));
}

fn void mutability_drops_along_a_three_level_chain() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    // `node mut* mut* mut*` has every level mutable; a target may drop a
    // suffix of them, starting at the outermost.
    // D5.4
    assert(assignable(&e, "node***", "node mut* mut* mut*"));
    assert(!assignable(&e, "node* mut**", "node mut* mut* mut*"));
    assert(!assignable(&e, "node** mut*", "node mut* mut* mut*"));
    // Dropping nothing is always fine.
    assert(assignable(&e, "node mut* mut* mut*", "node mut* mut* mut*"));
    // A span of spans behaves like a chain of pointers.
    assert(assignable(&e, "i32@@", "i32 mut@ mut@"));
    assert(!assignable(&e, "i32 mut@ mut@", "i32@@"));
    assert(assignable(&e, "u8@*", "u8 mut@ mut*"));
    assert(!assignable(&e, "u8@ mut*", "u8 mut@ mut*"));
}

// A fixed array adds no level, so its elements convert under the rule that
// applies to the array itself.
// D5.2, D5.4
fn void conversions_through_a_fixed_array_follow_the_element() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    assert(assignable(&e, "node*[4]", "node mut*[4]"));
    assert(assignable(&e, "node*[4]", "node* own[4]"));
    assert(!assignable(&e, "node* own[4]", "node*[4]"));
    assert(assignable(&e, "node*[3][4]", "node mut*[3][4]"));
    assert(!assignable(&e, "node mut*[3][4]", "node*[3][4]"));
    // A pointer to an array keeps the array transparent.
    assert(assignable(&e, "node*[4]*", "node mut*[4] mut*"));
    // The `mut` of level 1 sits on the trailing `*`, which the inner `*`
    // carries: `node* mut[4]*` is mutable at level 1 only.
    assert(!assignable(&e, "node*[4] mut*", "node mut*[4] mut*"));
}

fn void lending_combines_with_dropping_mutability() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    // The two drops are one conversion, in every order of marks.
    // D17.4
    assert(assignable(&e, "u8@", "u8 mut@ own"));
    assert(assignable(&e, "u8 mut@", "u8 mut@ own"));
    assert(assignable(&e, "u8@ own", "u8 mut@ own"));
    assert(!assignable(&e, "u8 mut@ own", "u8@ own"));
    assert(assignable(&e, "node*", "node mut* own"));
    assert(assignable(&e, "node mut*", "node mut* own"));
    assert(assignable(&e, "node* own", "node mut* own"));
    assert(assignable(&e, "void*", "void* own"));
    assert(assignable(&e, "void mut*", "void mut* own"));
    assert(assignable(&e, "string", "string own"));
    // A span of owned strings lends its own mark under the same rule.
    assert(assignable(&e, "string@", "string@ own"));
    assert(!assignable(&e, "string@ own", "string@"));
}

// Adoption is a cast, at any level, where the implicit drop refuses.
// D3.14, D17.3
fn void casts_may_add_own_at_any_reference() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    // Adoption adds the `own` alone: every `mut` of the target stands in the
    // source. `cast(libc.malloc(n), u8 mut* own)` compiles because `malloc`
    // answers `void mut* own`.
    // D3.14, D17.3, D17.13
    assert(castable(&e, "u8 mut@ own", "u8 mut@"));
    assert(castable(&e, "u8 mut@ own mut*", "u8 mut@ mut*"));
    assert(castable(&e, "node mut* own mut@ own", "node mut* mut@"));
    assert(castable(&e, "node mut* mut@", "node mut* own mut@ own"));
    assert(castable(&e, "void* own", "u64"));
    assert(castable(&e, "u8 mut* own", "void mut*"));
    assert(castable(&e, "u8* own", "void*"));
    assert(!castable(&e, "u8 mut@ own", "u8@"));
    assert(!castable(&e, "u8 mut* own", "void*"));
}

// ---- the matrix and the invariants ---------------------------------------------

fn void every_scalar_pair_follows_the_d3_14_matrix() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node*[14] mut list = {};
    scalar_class[14] mut classes = {};
    u64 n = scalar_types(&e, list[..], classes[..]);
    assert(n == SCALARS_MAX);
    u64 mut d = 0;
    while (d < n) {
        u64 mut s = 0;
        while (s < n) {
            bool identical = types.type_equal(list[d], list[s]);
            bool want = matrix_allows(classes[d], classes[s], identical);
            bool got = types.type_cast_allowed(list[d], list[s]);
            if (got != want) {
                fail_pair(&e, list[s], " does not cast as the matrix says to ", list[d]);
            }
            s += 1;
        }
        d += 1;
    }
}

// A cast that only drops mutability or ownership is a no-op the implicit
// conversions already cover, so `cast` is never the stricter of the two.
// D3.14
fn void every_implicit_conversion_is_also_a_cast() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node*[35] mut list = {};
    u64 n = sample_types(&e, list[..]);
    assert(n == SAMPLES_MAX);
    u64 mut d = 0;
    while (d < n) {
        u64 mut s = 0;
        while (s < n) {
            if (types.type_assignable(list[d], list[s]) &&
                !types.type_cast_allowed(list[d], list[s])) {
                fail_pair(&e, list[s], " converts but does not cast to ", list[d]);
            }
            s += 1;
        }
        d += 1;
    }
}

// The spelling of `text` with every `mut` cleared, for the test below.
fn string stripped(types_env.env mut* e, string text) {
    return types_env.str_of(e, types.type_without_mut(&e->tt, types_env.type_of(e, text)));
}

// type_without_mut answers the target a refused cast would have had without its
// marks, which is how the checker tells a cast refused for the mark from one
// refused for the element type as well. It is a query of the type table, so the
// test spells the answer rather than asking the rule again.
// D3.10, D3.14
fn void clearing_every_mark_of_a_type() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    assert(stripped(&e, "i32 mut*") == "i32*");
    assert(stripped(&e, "i32*") == "i32*");
    assert(stripped(&e, "node mut* mut*") == "node**");
    assert(stripped(&e, "node mut* mut@") == "node*@");
    assert(stripped(&e, "void mut*") == "void*");
    assert(stripped(&e, "u8 mut@") == "u8@");
    // `own` is another mark and this clears none of it, at any level.
    // D17.2
    assert(stripped(&e, "node mut* own mut@ own") == "node* own@ own");
    assert(stripped(&e, "void mut* own") == "void* own");
    // A fixed array holds no mark of its own and passes the clearing down.
    // D5.2
    assert(stripped(&e, "node mut*[2]") == "node*[2]");
    // A `string`, a scalar and a struct carry no level, so each is itself.
    assert(stripped(&e, "string") == "string");
    assert(stripped(&e, "i32") == "i32");
    assert(stripped(&e, "point") == "point");
    // A function type is its own identity, marks of parameters included, so
    // clearing them would answer another type and it answers itself.
    // D3.10
    types.node* takes_mut = types_env.fn1(&e, types.type_void(&e.tt),
                                          types_env.type_of(&e, "node mut*"));
    assert(types.type_without_mut(&e.tt, takes_mut) == takes_mut);
    // The result is interned like any other type, so clearing a type that
    // carries no mark answers the very node it was given.
    types.node* plain = types_env.type_of(&e, "node*");
    assert(types.type_without_mut(&e.tt, plain) == plain);
    assert(types.type_without_mut(&e.tt, types_env.type_of(&e, "node mut*")) == plain);
}

// The rule is a universal one, so the test is a loop over the sample table and
// not a list of cases: 35 spellings, 1225 ordered pairs, every one of them asked
// whether it adds a mark and then whether the two answers that matter agree with
// that. MUT_ADDING_PAIRS holds the table to the rule, because two implications
// over a table that had stopped naming a mutable type would both hold and prove
// nothing.
//
// What this proves and what it does not. The two implications are one
// direction: `adds mut` implies neither casts nor converts. An over-refusing
// rule satisfies them and bakes its own number into the count, so neither says
// the rule refuses no more than it should. The converse over the same table is
// every_implicit_conversion_is_also_a_cast, which goes red the moment a pair
// that converts stops casting, and the pairs that cast without converting are
// named one by one in a_cast_never_adds_mut and in
// casts_of_spans_change_only_the_marks.
// D3.14, D5.4
fn void no_conversion_and_no_cast_adds_mut() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node*[35] mut list = {};
    u64 n = sample_types(&e, list[..]);
    assert(n == SAMPLES_MAX);
    u64 mut adding = 0;
    u64 mut d = 0;
    while (d < n) {
        u64 mut s = 0;
        while (s < n) {
            if (types.type_cast_adds_mut(list[d], list[s])) {
                adding += 1;
                if (types.type_cast_allowed(list[d], list[s])) {
                    fail_pair(&e, list[s], " adds mutability and casts to ", list[d]);
                }
                if (types.type_assignable(list[d], list[s])) {
                    fail_pair(&e, list[s], " adds mutability and converts to ", list[d]);
                }
            }
            s += 1;
        }
        d += 1;
    }
    assert(adding == MUT_ADDING_PAIRS);
}

// Identity converts and casts; two types that convert both ways are identical,
// since every drop is strict.
fn void conversion_and_identity_agree_with_themselves() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node*[35] mut list = {};
    u64 n = sample_types(&e, list[..]);
    u64 mut i = 0;
    while (i < n) {
        assert(types.type_equal(list[i], list[i]));
        assert(types.type_assignable(list[i], list[i]));
        assert(types.type_cast_allowed(list[i], list[i]));
        assert(types.type_same_shape(list[i], list[i]));
        u64 mut j = 0;
        while (j < n) {
            if (i != j) {
                if (types.type_assignable(list[i], list[j]) &&
                    types.type_assignable(list[j], list[i])) {
                    fail_pair(&e, list[i], " and this convert both ways but are not one type: ",
                              list[j]);
                }
                // Distinct spellings are distinct nodes (interning).
                assert(!types.type_equal(list[i], list[j]));
            }
            j += 1;
        }
        i += 1;
    }
}

fn void dropping_marks_never_changes_the_shape_or_the_size() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node*[35] mut list = {};
    u64 n = sample_types(&e, list[..]);
    u64 mut d = 0;
    while (d < n) {
        u64 mut s = 0;
        while (s < n) {
            if (d != s && types.type_assignable(list[d], list[s])) {
                // An implicit conversion is a no-op at run time.
                // D5.4, D17.1
                assert(types.type_same_shape(list[d], list[s]));
                assert(types.type_sizeof(list[d]) == types.type_sizeof(list[s]));
                assert(types.type_alignof(list[d]) == types.type_alignof(list[s]));
                assert(types.type_levels(list[d]) == types.type_levels(list[s]));
            }
            s += 1;
        }
        d += 1;
    }
}

fn i32 main() {
    the_d5_4_conversions_and_their_shape();
    mutability_drops_through_further_shapes();
    the_d17_4_conversions_and_their_shape();
    ownership_is_never_added_implicitly();
    assignability_of_null_void_and_the_error_type();
    function_types_convert_only_to_themselves();
    println("implicit ok");
    casts_among_numbers_bool_char_and_enums();
    casts_refused_among_scalars();
    casts_among_pointers_and_u64();
    casts_of_function_pointers_go_through_voidptr();
    casts_within_the_string_family();
    a_span_cast_never_launders_a_signature_or_an_owner();
    casts_of_spans_change_only_the_marks();
    a_cast_never_adds_mut();
    casts_refused_for_structs_and_fixed_arrays();
    casts_between_a_reference_and_a_fat_pointer_are_refused();
    casts_of_null_void_and_the_error_type();
    println("casts ok");
    assignability_is_reflexive_for_every_kind();
    mutability_drops_along_a_three_level_chain();
    conversions_through_a_fixed_array_follow_the_element();
    lending_combines_with_dropping_mutability();
    casts_may_add_own_at_any_reference();
    println("further ok");
    every_scalar_pair_follows_the_d3_14_matrix();
    every_implicit_conversion_is_also_a_cast();
    clearing_every_mark_of_a_type();
    no_conversion_and_no_cast_adds_mut();
    conversion_and_identity_agree_with_themselves();
    dropping_marks_never_changes_the_shape_or_the_size();
    println("matrix ok");
    println("ok");
    return 0;
}
