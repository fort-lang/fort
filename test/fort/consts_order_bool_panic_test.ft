//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: consts: constant folding on a non-integer
//! stdout:
//| 1
import consts;

/// `< <= > >=` order integers and chars only. `bool`, `null` and `string`
/// have no ordering, so the checker has rejected the program and an ordering
/// fold on two bools is a broken precondition.
fn main() i32 {
    consts.cval f = consts.cv_from_bool(false);
    consts.cval t = consts.cv_from_bool(true);
    println(t.mag);
    println(consts.cv_compare(consts.cv_rel.cv_rel_lt, f, t).mag);
    return 0;
}
