//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| ok
/// Checks external signatures, repeated C symbol declarations, runtime
/// entries, and the reserved entry point.
import ast;
import check;
import check_env;
import std.str;
import std.strbuf;

//
// These are the checker's diagnostics that the language corpus reaches only
// through fail/ffi and fail/modules. These tests check each diagnostic's text
// and position. They also check two facts that the diagnostics omit. `char`
// and `u8` name one C type. A conflict note changes when the difference
// contains a struct or an enum.

// A closure of two modules, `main` importing `other`, whose declarations are
// given. fort does not join adjacent string literals, so the source is built
// in a buffer. The text reaches a file before the check runs.
fn two_modules(check_env.env mut* e, string in_main, string in_other) bool {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "fn one() i32 {\n    return 1;\n}\n");
    strbuf.append(&b, in_other);
    check_env.add(e, "other.ft", strbuf.view(&b));
    strbuf.clear(&b);
    strbuf.append(&b, "import other;\n");
    strbuf.append(&b, in_main);
    strbuf.append(&b, "fn main() i32 {\n    return other.one();\n}\n");
    check_env.add(e, "main.ft", strbuf.view(&b));
    return check_env.check_entry(e, "main.ft");
}

// One module, `decls` and the `main` an entry module needs.
fn one_module(check_env.env mut* e, string decls) bool {
    return check_env.check_decls(e, decls);
}

// ---- the types an extern signature may use -----------------------------------------

fn an_extern_signature_uses_scalars_and_pointers_only() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!one_module(&e, "extern fn take(string s) void;\n"));
    assert(check_env.said(&e, "extern signature cannot use type 'string'"));
}

fn an_extern_result_is_held_to_the_same_rule() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!one_module(&e, "extern fn give() string;\n"));
    assert(check_env.said(&e, "extern signature cannot use type 'string'"));
}

fn a_function_pointer_parameter_is_legal_when_its_own_signature_is() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // The C side calls through it with the same convention, so the rule
    // applies to the signature behind the pointer as well.
    assert(one_module(&e, "extern fn run(fn (i32) i32 cb) void;\n"));
    assert(check_env.errors(&e) == 0);
    check_env.env mut f = check_env.env{};
    check_env.open(&f);
    defer check_env.close(&f);
    assert(!one_module(&f, "extern fn run(fn (string) i32 cb) void;\n"));
    assert(check_env.said(&f, "extern signature cannot use type"));
}

fn the_entry_point_symbol_is_reserved() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // The compiler emits `fort_entry` itself, so an extern declaring it is a
    // signature nothing can be held against.
    assert(!one_module(&e, "extern fn fort_entry() i32;\n"));
    assert(check_env.said(&e, "'fort_entry' is reserved: the compiler emits it"));
}

fn an_extern_function_is_not_a_value() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!one_module(&e, "extern fn puts(char* s) i32;\nfn (char*) i32 p = puts;\n"));
    assert(check_env.said(&e, "'puts' is an extern function, which is not a value"));
}

// ---- two declarations of one C symbol ----------------------------------------------

fn two_identical_declarations_agree() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(two_modules(&e, "extern fn write(i32 fd) i32;\n", "extern fn write(i32 fd) i32;\n"));
    assert(check_env.errors(&e) == 0);
}

fn variable_tail_marks_and_fixed_types_agree_across_modules() void {
    check_env.env mut same = check_env.env{};
    check_env.open(&same);
    defer check_env.close(&same);
    assert(two_modules(&same, "extern fn tail(i32 n, ...) i32;\n",
                       "extern fn tail(i32 n, ...) i32;\n"));
    assert(check_env.errors(&same) == 0);

    check_env.env mut fixed = check_env.env{};
    check_env.open(&fixed);
    defer check_env.close(&fixed);
    assert(!two_modules(&fixed, "extern fn tail(i64 n, ...) i32;\n",
                        "extern fn tail(i32 n, ...) i32;\n"));
    assert(check_env.said(&fixed, "parameter 1 differs"));

    check_env.env mut mark = check_env.env{};
    check_env.open(&mark);
    defer check_env.close(&mark);
    assert(!two_modules(&mark, "extern fn tail(i32 n, ...) i32;\n",
                        "extern fn tail(i32 n) i32;\n"));
    assert(check_env.said(&mark, "the variable-tail mark differs"));
}

fn a_parameter_that_differs_is_reported_at_the_later_declaration() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!two_modules(&e, "extern fn write(i64 fd) i32;\n", "extern fn write(i32 fd) i32;\n"));
    assert(check_env.said(&e, "conflicting declarations of extern 'write': parameter 1 differs"));
    // The note points at the first declaration in the imported module. The
    // loader checks `other` first because dependencies precede importers.
    assert(check_env.said(&e, "previous declaration of 'write' here"));
    // The error stands in the module being checked and the note in the module
    // checked before it, which is the whole of the rule. A reader who cannot
    // open the other file keeps the error, and a swap would leave them nothing.
    // The message assertions above pass either way round, so the two files and
    // the two positions are asserted here. `main.ft` line 1 is the import and
    // line 2 the declaration. `other.ft` lines 1 to 3 are a function and line 4
    // the declaration.
    assert(check_env.reports(&e) == 2);
    assert(str.find(check_env.report_file(&e, 0), "main.ft") >= 0);
    assert(check_env.report_severity(&e, 0) == "error");
    assert(check_env.report_text(&e, 0) ==
           "2:17: conflicting declarations of extern 'write': parameter 1 differs");
    assert(str.find(check_env.report_file(&e, 1), "other.ft") >= 0);
    assert(check_env.report_severity(&e, 1) == "note");
    assert(check_env.report_text(&e, 1) == "4:11: previous declaration of 'write' here");
}

fn a_result_that_differs_and_an_arity_that_differs_are_their_own_rows() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!two_modules(&e, "extern fn write(i32 fd) i64;\n", "extern fn write(i32 fd) i32;\n"));
    assert(check_env.said(&e, "conflicting declarations of extern 'write': the result type "));
    check_env.env mut f = check_env.env{};
    check_env.open(&f);
    defer check_env.close(&f);
    assert(!two_modules(&f, "extern fn write(i32 fd, i32 n) i32;\n",
                        "extern fn write(i32 fd) i32;\n"));
    assert(check_env.said(&f, "the number of parameters differs"));
}

fn char_and_u8_name_one_c_type() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // fort `char` is C's `unsigned char` at the boundary, so `char*` may be
    // written `u8*` in the other module.
    assert(two_modules(&e, "extern fn put(char* s) i32;\n", "extern fn put(u8* s) i32;\n"));
    assert(check_env.errors(&e) == 0);
}

fn a_mark_below_the_binding_is_part_of_the_type() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // A level mark below the binding is part of a type, so two declarations
    // that differ in one do not agree. `own` is part of a type too, and the
    // case beside this one asserts that. This one asserts the `mut` mark and
    // nothing else.
    assert(!two_modules(&e, "extern fn put(char mut* s) i32;\n",
                        "extern fn put(char* s) i32;\n"));
    assert(check_env.said(&e, "parameter 1 differs"));
}

fn an_own_mark_on_a_typed_pointer_is_part_of_the_type() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // `own` is part of a pointer's type on a typed pointer exactly as it is on
    // a `void*`. check.extern_type_agrees writes the two as separate branches,
    // k_ptr and k_voidptr, so a case of one holds nothing of the other. The
    // corpus reaches the `void*` branch through
    // fail/modules/004_extern_own_mismatch and this branch through
    // fail/modules/018_extern_own_pointer. bootstrap0/src holds the same branch
    // through bootstrap0/test/check_extern_test.c:408.
    assert(!two_modules(&e, "extern fn take(i32 mut* own p) void;\n",
                        "extern fn take(i32 mut* p) void;\n"));
    assert(check_env.said(&e, "parameter 1 differs"));
}

fn a_mut_mark_on_a_void_pointer_is_part_of_the_type() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // The level a `void*` reaches is part of its type, so it is part of
    // signature identity as a typed pointer's `mut` is. check.extern_type_agrees
    // answers about a `void*` in a branch of its own, k_voidptr, so the case
    // above holds nothing about this one. `std.libc` made the shape real:
    // without this branch a program could declare `malloc` as storage it may
    // not write and call the library's.
    assert(!two_modules(&e, "extern fn take(void mut* p) void;\n",
                        "extern fn take(void* p) void;\n"));
    assert(check_env.said(&e, "parameter 1 differs"));
    assert(check_env.errors(&e) == 1);
}

fn a_difference_that_names_a_struct_carries_the_wrapper_note() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "struct local {\n    i32 v;\n}\n");
    strbuf.append(&b, "extern fn take(local mut* p) void;\n");
    assert(!two_modules(&e, strbuf.view(&b), "extern fn take(i32 mut* p) void;\n"));
    assert(check_env.said(&e, "parameter 1 differs"));
    // A struct is identified by its declaration, not its spelling. The note
    // offers the import or wrapper because text cannot make them agree.
    assert(check_env.said(&e, "a struct or an enum stands here"));
}

fn a_difference_between_two_scalars_carries_no_wrapper_note() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!two_modules(&e, "extern fn write(i64 fd) i32;\n", "extern fn write(i32 fd) i32;\n"));
    assert(!check_env.said(&e, "a struct or an enum stands here"));
}

// ---- the names the compiler emits --------------------------------------------------

fn a_fort_rt_name_is_an_ordinary_extern_declaration() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // std.rt has no C symbol prefix. A `fort_rt_` declaration is therefore an
    // ordinary external declaration.
    assert(one_module(&e, "extern fn fort_rt_del(i32 wrong) void;\n"));
    assert(check_env.errors(&e) == 0);
}

fn the_main_symbol_is_reserved() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // The compiler emits `main(argc, argv)` in the entry module, so an
    // `extern` declaring the name is a signature nothing can check against
    // that definition.
    assert(!one_module(&e, "extern fn main(i32 argc, char* mut* argv) i32;\n"));
    assert(check_env.said(&e, "'main' is reserved: the compiler emits it"));
}

fn main() i32 {
    an_extern_signature_uses_scalars_and_pointers_only();
    an_extern_result_is_held_to_the_same_rule();
    a_function_pointer_parameter_is_legal_when_its_own_signature_is();
    the_entry_point_symbol_is_reserved();
    an_extern_function_is_not_a_value();
    two_identical_declarations_agree();
    variable_tail_marks_and_fixed_types_agree_across_modules();
    a_parameter_that_differs_is_reported_at_the_later_declaration();
    a_result_that_differs_and_an_arity_that_differs_are_their_own_rows();
    char_and_u8_name_one_c_type();
    a_mark_below_the_binding_is_part_of_the_type();
    an_own_mark_on_a_typed_pointer_is_part_of_the_type();
    a_mut_mark_on_a_void_pointer_is_part_of_the_type();
    a_difference_that_names_a_struct_carries_the_wrapper_note();
    a_difference_between_two_scalars_carries_no_wrapper_note();
    a_fort_rt_name_is_an_ordinary_extern_declaration();
    the_main_symbol_is_reserved();
    println("ok");
    return 0;
}
