//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| ok
import ast;
import check;
import check_env;
import std.strbuf;

// The rules an `extern fn` declaration meets (D9.7, D9.8, D9.9): the types an
// extern signature may use, the agreement between two declarations of one C
// symbol across the closure, the agreement with the runtime's own table
// (toolchain.md 5.1) and the reserved entry point of D9.7.
//
// These are the checker's diagnostics that the language corpus reaches only
// through fail/ffi and fail/modules; what stands here is the wording and the
// position of each, and the two facts no diagnostic prints: that `char` and
// `u8` name one C type, and that the note a conflict carries depends on
// whether a struct or an enum stands at the difference.

// A closure of two modules, `main` importing `other`, whose declarations are
// given. fort does not join adjacent string literals (D2.9), so the source is
// built in a buffer; the text reaches a file before the check runs.
fn bool two_modules(check_env.env mut* e, string in_main, string in_other) {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "fn i32 one() {\n    return 1;\n}\n");
    strbuf.append(&b, in_other);
    check_env.add(e, "other.ft", strbuf.view(&b));
    strbuf.clear(&b);
    strbuf.append(&b, "import other;\n");
    strbuf.append(&b, in_main);
    strbuf.append(&b, "fn i32 main() {\n    return other.one();\n}\n");
    check_env.add(e, "main.ft", strbuf.view(&b));
    return check_env.check_entry(e, "main.ft");
}

// One module, `decls` and the `main` D8.6 asks for.
fn bool one_module(check_env.env mut* e, string decls) {
    return check_env.check_decls(e, decls);
}

// ---- the types an extern signature may use (D9.8) ----------------------------------

fn void an_extern_signature_uses_scalars_and_pointers_only() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!one_module(&e, "extern fn void take(string s);\n"));
    assert(check_env.said(&e, "extern signature cannot use type 'string'"));
}

fn void an_extern_result_is_held_to_the_same_rule() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!one_module(&e, "extern fn string give();\n"));
    assert(check_env.said(&e, "extern signature cannot use type 'string'"));
}

fn void a_function_pointer_parameter_is_legal_when_its_own_signature_is() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // The C side calls through it with the same convention, so the rule
    // applies to the signature behind the pointer as well (D9.9).
    assert(one_module(&e, "extern fn void run(fn i32(i32) cb);\n"));
    assert(check_env.errors(&e) == 0);
    check_env.env mut f = check_env.env{};
    check_env.open(&f);
    defer check_env.close(&f);
    assert(!one_module(&f, "extern fn void run(fn i32(string) cb);\n"));
    assert(check_env.said(&f, "extern signature cannot use type"));
}

fn void the_entry_point_symbol_is_reserved() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // The compiler emits `fort_entry` itself, so an extern declaring it is a
    // signature nothing can be held against (D9.7).
    assert(!one_module(&e, "extern fn i32 fort_entry();\n"));
    assert(check_env.said(&e, "'fort_entry' is reserved: the compiler emits it"));
}

fn void an_extern_function_is_not_a_value() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!one_module(&e, "extern fn i32 puts(char* s);\nfn i32(char*) p = puts;\n"));
    assert(check_env.said(&e, "'puts' is an extern function, which is not a value"));
}

// ---- two declarations of one C symbol (D9.8) ---------------------------------------

fn void two_identical_declarations_agree() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(two_modules(&e, "extern fn i32 write(i32 fd);\n", "extern fn i32 write(i32 fd);\n"));
    assert(check_env.errors(&e) == 0);
}

fn void a_parameter_that_differs_is_reported_at_the_later_declaration() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!two_modules(&e, "extern fn i32 write(i64 fd);\n", "extern fn i32 write(i32 fd);\n"));
    assert(check_env.said(&e, "conflicting declarations of extern 'write': parameter 1 differs"));
    // The note points at the first declaration, which is the imported
    // module's: every module is checked in the dependency order the loader
    // left, so `other` came first (D9.10, module-system.md 13).
    assert(check_env.said(&e, "previous declaration of 'write' here"));
}

fn void a_result_that_differs_and_an_arity_that_differs_are_their_own_rows() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!two_modules(&e, "extern fn i64 write(i32 fd);\n", "extern fn i32 write(i32 fd);\n"));
    assert(check_env.said(&e, "conflicting declarations of extern 'write': the result type "));
    check_env.env mut f = check_env.env{};
    check_env.open(&f);
    defer check_env.close(&f);
    assert(!two_modules(&f, "extern fn i32 write(i32 fd, i32 n);\n",
                        "extern fn i32 write(i32 fd);\n"));
    assert(check_env.said(&f, "the number of parameters differs"));
}

fn void char_and_u8_name_one_c_type() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // fort `char` is C's `unsigned char` at the boundary, so `char*` may be
    // written `u8*` in the other module (D3.2, D9.8).
    assert(two_modules(&e, "extern fn i32 put(char* s);\n", "extern fn i32 put(u8* s);\n"));
    assert(check_env.errors(&e) == 0);
}

fn void a_mark_below_the_binding_is_part_of_the_type() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // Level marks below the binding are part of a type (D3.12) and `own` is
    // too (D17.1), so two declarations that differ in either do not agree.
    assert(!two_modules(&e, "extern fn i32 put(char mut* s);\n",
                        "extern fn i32 put(char* s);\n"));
    assert(check_env.said(&e, "parameter 1 differs"));
}

fn void a_difference_that_names_a_struct_carries_the_wrapper_note() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "struct local {\n    i32 v;\n}\n");
    strbuf.append(&b, "extern fn void take(local mut* p);\n");
    assert(!two_modules(&e, strbuf.view(&b), "extern fn void take(i32 mut* p);\n"));
    assert(check_env.said(&e, "parameter 1 differs"));
    // A struct is identified by its declaration and not its spelling, so no
    // rewording can make the two agree: the note offers the import or the
    // wrapper (D3.8, module-system.md 8.1).
    assert(check_env.said(&e, "a struct or an enum stands here"));
}

fn void a_difference_between_two_scalars_carries_no_wrapper_note() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!two_modules(&e, "extern fn i32 write(i64 fd);\n", "extern fn i32 write(i32 fd);\n"));
    assert(!check_env.said(&e, "a struct or an enum stands here"));
}

// ---- the names the compiler emits (D9.7, D11.6) ------------------------------------

fn void a_fort_rt_name_is_an_ordinary_extern_declaration() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // The runtime is fort and occupies no C name (D13.1, D9.7), so the
    // `fort_rt_` space is reserved for nothing and such a declaration answers
    // to the rows above like any other (D9.8 as amended).
    assert(one_module(&e, "extern fn void fort_rt_del(i32 wrong);\n"));
    assert(check_env.errors(&e) == 0);
}

fn void the_main_symbol_is_reserved() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // The compiler emits `main(argc, argv)` in the entry module (D11.6), so
    // an `extern` declaring the name is a signature nothing can check against
    // that definition (D9.7 as amended).
    assert(!one_module(&e, "extern fn i32 main(i32 argc, char* mut* argv);\n"));
    assert(check_env.said(&e, "'main' is reserved: the compiler emits it"));
}

fn i32 main() {
    an_extern_signature_uses_scalars_and_pointers_only();
    an_extern_result_is_held_to_the_same_rule();
    a_function_pointer_parameter_is_legal_when_its_own_signature_is();
    the_entry_point_symbol_is_reserved();
    an_extern_function_is_not_a_value();
    two_identical_declarations_agree();
    a_parameter_that_differs_is_reported_at_the_later_declaration();
    a_result_that_differs_and_an_arity_that_differs_are_their_own_rows();
    char_and_u8_name_one_c_type();
    a_mark_below_the_binding_is_part_of_the_type();
    a_difference_that_names_a_struct_carries_the_wrapper_note();
    a_difference_between_two_scalars_carries_no_wrapper_note();
    a_fort_rt_name_is_an_ordinary_extern_declaration();
    the_main_symbol_is_reserved();
    println("ok");
    return 0;
}
