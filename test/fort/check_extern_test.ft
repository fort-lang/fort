//! run
//! flags: -I ../../src -I support
//! stdout:
//| ok
/// Checks external signatures, repeated C symbol declarations, runtime
/// entries, and the reserved C name `main`.
import fort.ast;
import fort.check;
import check_env;
import std.str;
import std.strbuf;

//
// These are the checker's diagnostics that the language corpus reaches only
// through fail/ffi and fail/modules. These tests check each diagnostic's text
// and position. They also check two facts that the diagnostics omit. `char`
// and `u8` name one C type. A conflict note changes when the difference
// contains a struct or an enum.

// A closure of two modules, `main` importing `other`, whose declarations are
// given. fort does not join adjacent string literals, so the source is built
// in a buffer. The text reaches a file before the check runs.
fn two_modules(check_env.env mut* e, string in_main, string in_other) bool {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "fn one() i32 {\n    return 1;\n}\n");
    strbuf.append(&b, in_other);
    check_env.add(e, "other.ft", strbuf.view(&b));
    strbuf.clear(&b);
    strbuf.append(&b, "import other;\n");
    strbuf.append(&b, in_main);
    strbuf.append(&b, "fn main() i32 {\n    return other.one();\n}\n");
    check_env.add(e, "main.ft", strbuf.view(&b));
    return check_env.check_entry(e, "main.ft");
}

// One module, `decls` and the `main` an entry module needs.
fn one_module(check_env.env mut* e, string decls) bool {
    return check_env.check_decls(e, decls);
}

// ---- the types an extern signature may use -----------------------------------------

fn an_extern_signature_uses_scalars_and_pointers_only() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!one_module(&e, "extern fn take(string s) void;\n"));
    assert(check_env.said(&e, "extern signature cannot use type 'string'"));
}

fn an_extern_result_is_held_to_the_same_rule() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!one_module(&e, "extern fn give() string;\n"));
    assert(check_env.said(&e, "extern signature cannot use type 'string'"));
}

fn a_function_pointer_parameter_is_legal_when_its_own_signature_is() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // The C side calls through it with the same convention, so the rule
    // applies to the signature behind the pointer as well.
    assert(one_module(&e, "extern fn run(fn (i32) i32 cb) void;\n"));
    assert(check_env.errors(&e) == 0);
    check_env.env mut f = check_env.env{};
    check_env.open(&f);
    defer check_env.close(&f);
    assert(!one_module(&f, "extern fn run(fn (string) i32 cb) void;\n"));
    assert(check_env.said(&f, "extern signature cannot use type"));
}

fn an_extern_function_is_not_a_value() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!one_module(&e, "extern fn puts(char* s) i32;\nfn (char*) i32 p = puts;\n"));
    assert(check_env.said(&e, "'puts' is an extern function, which is not a value"));
}

// ---- two declarations of one C symbol ----------------------------------------------

fn two_identical_declarations_agree() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(two_modules(&e, "extern fn write(i32 fd) i32;\n", "extern fn write(i32 fd) i32;\n"));
    assert(check_env.errors(&e) == 0);
}

fn variable_tail_marks_and_fixed_types_agree_across_modules() void {
    check_env.env mut same = check_env.env{};
    check_env.open(&same);
    defer check_env.close(&same);
    assert(two_modules(&same, "extern fn tail(i32 n, ...) i32;\n",
                       "extern fn tail(i32 n, ...) i32;\n"));
    assert(check_env.errors(&same) == 0);

    check_env.env mut fixed = check_env.env{};
    check_env.open(&fixed);
    defer check_env.close(&fixed);
    assert(!two_modules(&fixed, "extern fn tail(i64 n, ...) i32;\n",
                        "extern fn tail(i32 n, ...) i32;\n"));
    assert(check_env.said(&fixed, "parameter 1 differs"));

    check_env.env mut mark = check_env.env{};
    check_env.open(&mark);
    defer check_env.close(&mark);
    assert(!two_modules(&mark, "extern fn tail(i32 n, ...) i32;\n",
                        "extern fn tail(i32 n) i32;\n"));
    assert(check_env.said(&mark, "the variable-tail mark differs"));
}

fn a_parameter_that_differs_is_reported_at_the_later_declaration() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!two_modules(&e, "extern fn write(i64 fd) i32;\n", "extern fn write(i32 fd) i32;\n"));
    assert(check_env.said(&e, "conflicting declarations of extern 'write': parameter 1 differs"));
    // The note points at the first declaration in the imported module. The
    // loader checks `other` first because dependencies precede importers.
    assert(check_env.said(&e, "previous declaration of 'write' here"));
    // The error stands in the module being checked and the note in the module
    // checked before it, which is the whole of the rule. A reader who cannot
    // open the other file keeps the error, and a swap would leave them nothing.
    // The message assertions above pass either way round, so the two files and
    // the two positions are asserted here. `main.ft` line 1 is the import and
    // line 2 the declaration. `other.ft` lines 1 to 3 are a function and line 4
    // the declaration.
    assert(check_env.reports(&e) == 2);
    assert(str.find(check_env.report_file(&e, 0), "main.ft") >= 0);
    assert(check_env.report_severity(&e, 0) == "error");
    assert(check_env.report_text(&e, 0) ==
           "2:17: conflicting declarations of extern 'write': parameter 1 differs");
    assert(str.find(check_env.report_file(&e, 1), "other.ft") >= 0);
    assert(check_env.report_severity(&e, 1) == "note");
    assert(check_env.report_text(&e, 1) == "4:11: previous declaration of 'write' here");
}

fn a_result_that_differs_and_an_arity_that_differs_are_their_own_rows() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!two_modules(&e, "extern fn write(i32 fd) i64;\n", "extern fn write(i32 fd) i32;\n"));
    assert(check_env.said(&e, "conflicting declarations of extern 'write': the result type "));
    check_env.env mut f = check_env.env{};
    check_env.open(&f);
    defer check_env.close(&f);
    assert(!two_modules(&f, "extern fn write(i32 fd, i32 n) i32;\n",
                        "extern fn write(i32 fd) i32;\n"));
    assert(check_env.said(&f, "the number of parameters differs"));
}

fn char_and_u8_name_one_c_type() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // fort `char` is C's `unsigned char` at the boundary, so `char*` may be
    // written `u8*` in the other module.
    assert(two_modules(&e, "extern fn put(char* s) i32;\n", "extern fn put(u8* s) i32;\n"));
    assert(check_env.errors(&e) == 0);
}

fn a_mark_below_the_binding_is_part_of_the_type() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // A level mark below the binding is part of a type, so two declarations
    // that differ in one do not agree. `own` is part of a type too, and the
    // case beside this one asserts that. This one asserts the `mut` mark and
    // nothing else.
    assert(!two_modules(&e, "extern fn put(char mut* s) i32;\n",
                        "extern fn put(char* s) i32;\n"));
    assert(check_env.said(&e, "parameter 1 differs"));
}

fn an_own_mark_on_a_typed_pointer_is_part_of_the_type() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // `own` is part of a pointer's type on a typed pointer exactly as it is on
    // a `void*`. check.extern_type_agrees writes the two as separate branches,
    // k_ptr and k_voidptr, so a case of one holds nothing of the other. The
    // corpus reaches the `void*` branch through
    // fail/modules/004_extern_own_mismatch and this branch through
    // fail/modules/018_extern_own_pointer. bootstrap0/src holds the same branch
    // through bootstrap0/test/check_extern_test.c:408.
    assert(!two_modules(&e, "extern fn take(i32 mut* own p) void;\n",
                        "extern fn take(i32 mut* p) void;\n"));
    assert(check_env.said(&e, "parameter 1 differs"));
}

fn a_mut_mark_on_a_void_pointer_is_part_of_the_type() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // The level a `void*` reaches is part of its type, so it is part of
    // signature identity as a typed pointer's `mut` is. check.extern_type_agrees
    // answers about a `void*` in a branch of its own, k_voidptr, so the case
    // above holds nothing about this one. `std.libc` made the shape real:
    // without this branch a program could declare `malloc` as storage it may
    // not write and call the library's.
    assert(!two_modules(&e, "extern fn take(void mut* p) void;\n",
                        "extern fn take(void* p) void;\n"));
    assert(check_env.said(&e, "parameter 1 differs"));
    assert(check_env.errors(&e) == 1);
}

fn a_difference_that_names_a_struct_carries_the_wrapper_note() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "struct local {\n    i32 v;\n}\n");
    strbuf.append(&b, "extern fn take(local mut* p) void;\n");
    assert(!two_modules(&e, strbuf.view(&b), "extern fn take(i32 mut* p) void;\n"));
    assert(check_env.said(&e, "parameter 1 differs"));
    // A struct is identified by its declaration, not its spelling. The note
    // offers the import or wrapper because text cannot make them agree.
    assert(check_env.said(&e, "a struct or an enum stands here"));
}

fn a_difference_between_two_scalars_carries_no_wrapper_note() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!two_modules(&e, "extern fn write(i64 fd) i32;\n", "extern fn write(i32 fd) i32;\n"));
    assert(!check_env.said(&e, "a struct or an enum stands here"));
}

// ---- the names the compiler emits --------------------------------------------------

fn a_fort_rt_name_is_an_ordinary_extern_declaration() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // std.rt has no C symbol prefix. A `fort_rt_` declaration is therefore an
    // ordinary external declaration.
    assert(one_module(&e, "extern fn fort_rt_del(i32 wrong) void;\n"));
    assert(check_env.errors(&e) == 0);
}

// The compiler emits one C name, `main`, and reserves no other. The name
// below is an ordinary C function that the program links against.
fn a_c_name_other_than_main_is_an_ordinary_extern_declaration() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(one_module(&e, "extern fn fort_entry(i32 a, i32 b) i64;\n"));
    assert(check_env.errors(&e) == 0);
}

fn the_main_symbol_is_reserved() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // The compiler emits `main(argc, argv)` in the entry module, so an
    // `extern` declaring the name is a signature nothing can check against
    // that definition.
    // The source defines no fort `main`, so the reservation is the one error.
    assert(!check_env.check_src(&e, "extern fn main(i32 argc, char* mut* argv) i32;\n"));
    assert(check_env.said(&e, "'main' is reserved: the compiler emits it"));
    assert(check_env.errors(&e) == 1);
}

// ---- the pointers that C gives (D17.13) ----------------------------------------------------

// The declarations that the rule of the pointers that C gives refuses, four strings each: the
// declaration, the position of its error, and the extern and the type that the error names. The
// rule reads the result, each parameter type of a function pointer parameter, each pointer type
// that a level of a parameter holds where the parameter marks that level `mut` (through fixed
// arrays, D5.2), and the same three of a function pointer type that C gives. The first type that
// marks a level `mut` with no `own`, and has no fixed parameter of the same type while a parameter
// can carry a pointer, is the error: the result first, then the parameters in order.
u64 REFUSED_LEN = 76;

string[REFUSED_LEN] REFUSED = {
    "extern fn strchr(char* s, i32 c) char mut*;",
    "1:34", "strchr", "char mut*",
    "extern fn pick(i32 n, ...) u64 mut*;",
    "1:28", "pick", "u64 mut*",
    "extern fn call(fn () u64* g) u64 mut*;",
    "1:30", "call", "u64 mut*",
    "extern fn take(void* p) u64 mut*;",
    "1:25", "take", "u64 mut*",
    "extern fn apply(u64* p, fn (u64 mut*) void cb) void;",
    "1:25", "apply", "u64 mut*",
    "extern fn strtol(char* nptr, char mut* mut* endptr, i32 base) i64;",
    "1:30", "strtol", "char mut*",
    "extern fn deep(char* s, char mut* mut** out) void;",
    "1:25", "deep", "char mut*",
    "extern fn two(char* s, char mut* mut* mut* out) void;",
    "1:24", "two", "char mut* mut*",
    "extern fn fill(char* s, char mut*[2] mut* out) void;",
    "1:25", "fill", "char mut*",
    "extern fn hold(void* p, void mut* mut* out) void;",
    "1:25", "hold", "void mut*",
    "extern fn get_strchr() fn (char*, i32) char mut*;",
    "1:24", "get_strchr", "char mut*",
    "extern fn hand_back(char* s, (fn (char*) char mut*) mut* out) void;",
    "1:30", "hand_back", "char mut*",
    "extern fn enroll(char* s, fn (fn (char*) char mut*) void cb) void;",
    "1:27", "enroll", "char mut*",
    "extern fn lend(char mut* own p) char mut*;",
    "1:33", "lend", "char mut*",
    "extern fn bytes(u8 mut* s, u64 n) char mut*;",
    "1:35", "bytes", "char mut*",
    "extern fn chain(char** s) char mut**;",
    "1:27", "chain", "char mut**",
    "extern fn both(char* s, u64 mut* mut* out) char mut*;",
    "1:44", "both", "char mut*",
    "extern fn two_out(char* s, char mut* mut* a, u64 mut* mut* b) void;",
    "1:28", "two_out", "char mut*",
    "extern fn rows(char*[2]* s) char mut*[2]*;",
    "1:29", "rows", "char mut*[2]*",
};

// Declarations that the rule takes: a result with no `mut`, a parameter of the type of the result,
// a result that says `own`, no parameter that can carry a pointer, an out-parameter that holds a
// pointer with no `mut` or an `own` one or a type that a parameter has, a callback whose parameter
// types a parameter has or that mark nothing, a level that the parameter does not mark `mut`, a
// struct that C writes, and a function pointer type that C gives whose own result follows the rule.
u64 TAKEN_LEN = 22;

string[TAKEN_LEN] TAKEN = {
    "extern fn strchr(char* s, i32 c) char*;",
    "extern fn getcwd(char mut* buf, u64 size) char mut*;",
    "extern fn opendir(char* path) void mut* own;\nextern fn closedir(void mut* own dir) i32;",
    "extern fn fopen(char* path, char* mode) void mut* own;",
    "extern fn errno_slot() i32 mut*;",
    "extern fn give(i32 n, u64 m) u64 mut*;",
    "extern fn fdopendir(i32 fd) void mut* own;",
    "extern fn strtol(char* nptr, char* mut* endptr, i32 base) i64;",
    "extern fn posix_memalign(void mut* own mut* out, u64 align, u64 size) i32;",
    "extern fn keep(char mut* mut* slot, char mut* s) void;",
    "extern fn walk(u64 mut* p, fn (u64 mut*) void cb) void;",
    "extern fn sort_ints(i32 mut* base, u64 n, u64 size, fn (i32*, i32*) i32 cmp) void;",
    "extern fn gmtime_r(i64* t, u64 mut* out) u64 mut*;",
    "extern fn level_two(char* s, char* mut** out) void;",
    "extern fn peek(char mut** p) void;",
    "struct hdr {\n    void mut* name;\n}\nextern fn recv(i32 fd, hdr mut* h) i64;",
    "extern fn get_cmp() fn (i32*, i32*) i32;",
    "extern fn get_dup() fn (char mut*) char mut*;",
    "extern fn get_fn() fn () u64 mut*;",
    "extern fn swap_chain(char mut** s) char mut**;",
    "extern fn printf(char* fmt, ...) i32;",
    "extern fn readdir(void mut* dir) u64*;",
};

fn each_declaration_that_gives_a_mut_no_argument_had_is_one_error() void {
    u64 mut k = 0;
    while (k < REFUSED.len) {
        refused_at(REFUSED[k], REFUSED[k + 1], REFUSED[k + 2], REFUSED[k + 3]);
        k += 4;
    }
}

// Checks the one declaration `decl` and holds that the rule refuses it with one error at `at`, and
// that the error names the extern `name` and the type `given`.
fn refused_at(string decl, string at, string name, string given) void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    strbuf.append(&text, decl);
    strbuf.push(&text, '\n');
    assert(!one_module(&e, strbuf.view(&text)));
    strbuf.clear(&text);
    strbuf.append(&text, at);
    strbuf.append(&text, ": extern '");
    strbuf.append(&text, name);
    strbuf.append(&text, "': C gives '");
    strbuf.append(&text, given);
    strbuf.append(&text, "' with a 'mut' that no parameter of that type has");
    if (check_env.errors(&e) != 1 || check_env.report_text(&e, 0) != strbuf.view(&text)) {
        eprintln(decl, " gives ", check_env.report_text(&e, 0));
        panic("check_extern_test: the rule of D17.13 gives another report");
    }
}

fn each_declaration_that_gives_no_new_mut_is_taken() void {
    for (string decl : TAKEN) {
        check_env.env mut e = check_env.env{};
        check_env.open(&e);
        defer check_env.close(&e);
        strbuf.str_buf mut text = strbuf.create();
        defer strbuf.free(&text);
        strbuf.append(&text, decl);
        strbuf.push(&text, '\n');
        if (!one_module(&e, strbuf.view(&text)) || check_env.errors(&e) != 0) {
            eprintln(decl, " gives ", check_env.report_text(&e, 0));
            panic("check_extern_test: the rule of D17.13 refuses a declaration that it takes");
        }
    }
}

// A refused extern and a function that writes through its result.
string CALLS_REFUSED = "extern fn f(char* s) char mut*;\nfn g(char* s) void {\n    *f(s) = 0;\n}\n";

fn a_refused_declaration_fails_its_symbol_and_its_calls_report_nothing(check_env.env mut* e) void {
    assert(!check_env.check_decls(e, CALLS_REFUSED));
    assert(check_env.errors(e) == 1);
    assert(check_env.said(e, "extern 'f': C gives 'char mut*'"));
    assert(check_env.sym_of(e, "main", "f")->error);
}

fn a_held_back_extern_meets_the_rule_at_its_declaration(check_env.env mut* e) void {
    // the comparison of D9.8 waits for check_externs, and the rule of D17.13 does not
    e->ck.defer_externs = true;
    assert(!two_modules(e, "extern fn strchr(char* s, i32 c) char mut*;\n", ""));
    e->ck.defer_externs = false;
    assert(check_env.errors(e) == 1);
    assert(check_env.said(e, "extern 'strchr': C gives 'char mut*' with a 'mut'"));
    assert(check_env.sym_of(e, "main", "strchr")->error);
}

// ---- the extern declarations that the checker holds back ------------------------------

fn a_held_back_extern_is_compared_by_check_externs(check_env.env mut* e) void {
    // with defer_externs set, the check compares no extern declaration
    e->ck.defer_externs = true;
    assert(two_modules(e, "extern fn write(i32 fd) i64;\n", "extern fn write(i64 fd) i64;\n"));
    assert(check_env.errors(e) == 0);
    e->ck.defer_externs = false;
    // `other` registers the first declaration and `main` is the later one
    assert(check.check_externs(&e->ck, check_env.module_at(e, "other")));
    assert(!check.check_externs(&e->ck, check_env.module_at(e, "main")));
    assert(check_env.errors(e) == 1);
    assert(check_env.said(e, "conflicting declarations of extern 'write': parameter 1 differs"));
    // the symbol of the later declaration fails, as in the closure
    assert(check_env.sym_of(e, "main", "write")->error);
}

fn check_externs_reads_the_order_of_its_calls(check_env.env mut* e) void {
    e->ck.defer_externs = true;
    assert(two_modules(e, "extern fn write(i32 fd) i64;\n", "extern fn write(i64 fd) i64;\n"));
    e->ck.defer_externs = false;
    // `main` first this time: the error stands at `other`
    assert(check.check_externs(&e->ck, check_env.module_at(e, "main")));
    assert(!check.check_externs(&e->ck, check_env.module_at(e, "other")));
    assert(check_env.sym_of(e, "other", "write")->error);
    assert(!check_env.sym_of(e, "main", "write")->error);
}

fn check_externs_skips_a_declaration_that_failed() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    e.ck.defer_externs = true;
    // a string parameter fails the signature of the declaration in `main`
    assert(!two_modules(&e, "extern fn write(string s) i64;\n", "extern fn write(i64 fd) i64;\n"));
    u64 before = check_env.errors(&e);
    e.ck.defer_externs = false;
    assert(check.check_externs(&e.ck, check_env.module_at(&e, "main")));
    assert(check.check_externs(&e.ck, check_env.module_at(&e, "other")));
    assert(check_env.errors(&e) == before);
}

fn agreeing_held_back_externs_pass() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    e.ck.defer_externs = true;
    assert(two_modules(&e, "extern fn write(i32 fd) i64;\n", "extern fn write(i32 fd) i64;\n"));
    e.ck.defer_externs = false;
    assert(check.check_externs(&e.ck, check_env.module_at(&e, "other")));
    assert(check.check_externs(&e.ck, check_env.module_at(&e, "main")));
    assert(check_env.errors(&e) == 0);
}

fn main() i32 {
    an_extern_signature_uses_scalars_and_pointers_only();
    an_extern_result_is_held_to_the_same_rule();
    a_function_pointer_parameter_is_legal_when_its_own_signature_is();
    an_extern_function_is_not_a_value();
    two_identical_declarations_agree();
    variable_tail_marks_and_fixed_types_agree_across_modules();
    a_parameter_that_differs_is_reported_at_the_later_declaration();
    a_result_that_differs_and_an_arity_that_differs_are_their_own_rows();
    char_and_u8_name_one_c_type();
    a_mark_below_the_binding_is_part_of_the_type();
    an_own_mark_on_a_typed_pointer_is_part_of_the_type();
    a_mut_mark_on_a_void_pointer_is_part_of_the_type();
    a_difference_that_names_a_struct_carries_the_wrapper_note();
    a_difference_between_two_scalars_carries_no_wrapper_note();
    a_fort_rt_name_is_an_ordinary_extern_declaration();
    a_c_name_other_than_main_is_an_ordinary_extern_declaration();
    the_main_symbol_is_reserved();
    each_declaration_that_gives_a_mut_no_argument_had_is_one_error();
    each_declaration_that_gives_no_new_mut_is_taken();
    check_env.run(a_refused_declaration_fails_its_symbol_and_its_calls_report_nothing);
    check_env.run(a_held_back_extern_meets_the_rule_at_its_declaration);
    check_env.run(a_held_back_extern_is_compared_by_check_externs);
    check_env.run(check_externs_reads_the_order_of_its_calls);
    check_externs_skips_a_declaration_that_failed();
    agreeing_held_back_externs_pass();
    println("ok");
    return 0;
}
