//! run
//! flags: -I ../../src
//! abort
//! stderr: panic: fir.require_layout: a struct with no layout
//! stdout:
//| ready
/// Checks that fir.require_layout refuses a struct type that has no layout, here for
/// fir.place_type: the field types come from the layout.
import fort.diag;
import fort.fir;
import fort.prim;
import fort.types;

fn main() i32 {
    // `tt` lives in an allocation, so that the leak rule proves its end: no call changes the
    // pointer, and drop_made holds each release once.
    types.table mut* own tt = types.table_make();
    defer types.table_drop_made(move(tt));
    types.node* i32t = types.type_prim(tt, prim.prim_kind.prim_i32);
    types.node*[2] params = {i32t, i32t};
    types.node* fnty = types.type_fn(tt, i32t, params[..], false);
    fir.func mut* own f = fir.func_make();
    *f = fir.func_new(tt, null, fnty);
    defer fir.func_drop_made(move(f));
    types.node* anon = types.type_struct(tt, "anon", 0);
    u32 n = fir.local_add(f, anon, fir.local_kind.lk_temp, null, diag.loc{});
    fir.place p = fir.place_field(f, fir.place_local(n), 0);
    println("ready");
    fir.place_type(f, p);
    return 0;
}
