//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| nested_sibling_views
//| intermediate_storage
//| cyclic_storage_relations
//| aggregate_copy
//| aggregate_move
//| clear_one_nested_field
//| ending_container
//| global_stack_escape
//| global_caller_source
//| unknown_source
//| incomplete_representation
//| unknown_projected_contents
//| unproved_destination_end
//| retained_map_key
//| copied_key_in_two_destinations
//| owning_heap_storage_reachability
/// Tests stored, returned, global, and transitive source requirements.
import fir_env;
import ownership_api;
import ownership_borrows;
import ownership_borrows_env;
import ownership_local_env;
import ownership_places;
import ownership_regions;
import ownership_state;
import types;

fn nested_sibling_views() void {
    ownership_borrows_env.env mut e = ownership_borrows_env.env{};
    ownership_borrows_env.open(&e);
    defer ownership_borrows_env.close(&e);
    ownership_borrows_env.local_use(&e, 2, false);
    ownership_borrows_env.source(&e, 100, ownership_api.source_kind.stack);
    ownership_borrows_env.source(&e, 200, ownership_api.source_kind.symbolic_caller);
    ownership_borrows_env.storage(&e, 2, 102, ownership_borrows.destination_kind.local_value);
    ownership_api.projection[1] mut a = {};
    ownership_api.projection[1] mut b = {};
    ownership_api.place_path first = ownership_borrows_env.field(2, 0, a[..]);
    ownership_api.place_path second = ownership_borrows_env.field(2, 1, b[..]);
    ownership_borrows_env.seed(&e, first, 100, 10);
    ownership_borrows_env.seed(&e, second, 200, 20);
    ownership_borrows.graph mut kept = ownership_borrows_env.solve(&e);
    defer ownership_borrows.free(&kept);
    ownership_borrows.answer stack = ownership_borrows_env.inspect(&e, &kept, 100);
    assert(ownership_api.successful(stack.proof));
    ownership_borrows_env.expect(stack, false, true, false, false);
    assert(stack.destinations.len == 1 &&
        stack.destinations[0].relation.value_version.ordinal == 10);
    ownership_borrows.answer caller = ownership_borrows_env.inspect(&e, &kept, 200);
    assert(ownership_api.successful(caller.proof));
    ownership_borrows_env.expect(caller, false, true, true, false);
    assert(caller.destinations.len == 1 && caller.destinations[0].relation.source.ordinal == 200);
}

fn intermediate_storage() void {
    ownership_borrows_env.env mut e = ownership_borrows_env.env{};
    ownership_borrows_env.open(&e);
    defer ownership_borrows_env.close(&e);
    ownership_borrows_env.local_use(&e, 2, false);
    ownership_borrows_env.source(&e, 100, ownership_api.source_kind.stack);
    ownership_borrows_env.source(&e, 200, ownership_api.source_kind.symbolic_caller);
    ownership_borrows_env.storage(&e, 2, 102, ownership_borrows.destination_kind.local_value);
    ownership_api.projection[1] mut a = {};
    ownership_api.projection[1] mut b = {};
    ownership_api.place_path first = ownership_borrows_env.field(2, 0, a[..]);
    ownership_api.place_path second = ownership_borrows_env.field(2, 1, b[..]);
    ownership_borrows_env.seed(&e, first, 100, 10);
    ownership_borrows_env.seed(&e, second, 200, 20);
    ownership_borrows_env.storage(&e, 3, 103, ownership_borrows.destination_kind.result);
    assert(ownership_api.successful(ownership_local_env.address(&e.local, 2, 3, 102, true)));
    ownership_borrows.graph mut kept = ownership_borrows_env.solve(&e);
    defer ownership_borrows.free(&kept);
    ownership_borrows.answer got = ownership_borrows_env.query(&e, &kept, 100,
        ownership_borrows.boundary_kind.storage_end, ownership_borrows_env.no_boundary(), false);
    assert(got.proof.failed && got.intrinsic_escape && got.retained && !got.local_used);
    assert(got.destinations.len == 2);
    assert(got.destinations[1].root.root.ordinal == 3);
    assert(got.destinations[1].relation.source.ordinal == 100);
}

fn cyclic_storage_relations() void {
    ownership_borrows_env.env mut e = ownership_borrows_env.env{};
    ownership_borrows_env.open(&e);
    defer ownership_borrows_env.close(&e);
    ownership_borrows_env.local_use(&e, 2, false);
    ownership_borrows_env.source(&e, 100, ownership_api.source_kind.stack);
    ownership_borrows_env.storage(&e, 2, 102, ownership_borrows.destination_kind.local_value);
    ownership_borrows_env.storage(&e, 3, 103, ownership_borrows.destination_kind.local_value);
    ownership_borrows_env.storage(&e, 4, 104, ownership_borrows.destination_kind.result);
    ownership_api.projection[1] mut a = {};
    ownership_api.projection[1] mut b = {};
    ownership_api.projection[1] mut c = {};
    ownership_borrows_env.seed(&e, ownership_borrows_env.field(2, 0, a[..]), 103, 10);
    ownership_borrows_env.seed(&e, ownership_borrows_env.field(3, 0, b[..]), 102, 20);
    ownership_borrows_env.seed(&e, ownership_borrows_env.field(3, 1, c[..]), 100, 30);
    assert(ownership_api.successful(ownership_local_env.address(&e.local, 2, 4, 102, true)));
    ownership_borrows.graph mut kept = ownership_borrows_env.solve(&e);
    defer ownership_borrows.free(&kept);
    ownership_borrows.answer got = ownership_borrows_env.inspect(&e, &kept, 100);
    assert(ownership_api.successful(got.proof) && got.retained && !got.local_used);
    assert(got.destinations.len == 4);
    assert(e.counts.work < 1000);
}

fn aggregate_copy() void {
    ownership_borrows_env.env mut e = ownership_borrows_env.env{};
    ownership_borrows_env.open(&e);
    defer ownership_borrows_env.close(&e);
    ownership_borrows_env.local_use(&e, 2, false);
    ownership_borrows_env.source(&e, 100, ownership_api.source_kind.stack);
    ownership_borrows_env.source(&e, 200, ownership_api.source_kind.symbolic_caller);
    ownership_borrows_env.storage(&e, 2, 102, ownership_borrows.destination_kind.local_value);
    ownership_api.projection[1] mut a = {};
    ownership_api.projection[1] mut b = {};
    ownership_api.place_path first = ownership_borrows_env.field(2, 0, a[..]);
    ownership_api.place_path second = ownership_borrows_env.field(2, 1, b[..]);
    ownership_borrows_env.seed(&e, first, 100, 10);
    ownership_borrows_env.seed(&e, second, 200, 20);
    ownership_borrows_env.storage(&e, 3, 103, ownership_borrows.destination_kind.result);
    ownership_borrows_env.aggregate(&e, 2);
    ownership_borrows_env.aggregate(&e, 3);
    ownership_api.projection[1] mut c = {};
    ownership_api.projection[1] mut d = {};
    ownership_borrows_env.seed_empty(&e, ownership_borrows_env.field(3, 0, c[..]));
    ownership_borrows_env.seed_empty(&e, ownership_borrows_env.field(3, 1, d[..]));
    types.node* ty = fir_env.ty(&e.fixture, "viewer");
    ownership_places.request mut req = ownership_borrows_env.place_request(&e,
        ownership_places.action.copy_value, ty, ownership_borrows_env.path(2),
        ownership_borrows_env.path(3));
    assert(ownership_api.successful(ownership_places.apply(&e.local.state,
        &e.local.service, &req)));
    ownership_borrows.graph mut kept = ownership_borrows_env.solve(&e);
    defer ownership_borrows.free(&kept);
    ownership_borrows.answer one = ownership_borrows_env.inspect(&e, &kept, 100);
    assert(ownership_api.successful(one.proof) && one.retained && !one.local_used);
    assert(one.destinations.len == 2);
    ownership_borrows.answer two = ownership_borrows_env.inspect(&e, &kept, 200);
    assert(ownership_api.successful(two.proof) && two.caller_requirement && two.retained);
    assert(two.destinations.len == 2);
    assert(two.destinations[two.destinations.len - 1].relation.range.extent.value == 8);
}

