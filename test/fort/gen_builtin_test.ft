//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| prints ok
//| checks ok
//| calls ok
//| ok
import gen;
import gen_env;
import runtime_sig;
import std.strbuf;

// The builtins and the calls of src/fort/gen_expr.ft: the print family, the
// `assert` and `panic` of item 19, and the call shapes of item 7 -- a direct
// call, a call through a function pointer, an `extern` call with the variadic
// tail of item 8, an aggregate argument and an aggregate result.
// D12.2
//
// Every expected block was read off `fort -S` run by stage1 over a program
// whose body is the one the test writes, with the temporaries renumbered from
// zero, which is what the emitter produces when the expression is a
// function's first.

// One local per print family type, and the call statements that print them.
fn bool open_prints(gen_env.env mut* e) {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "enum color {\n    red,\n    green,\n}\n");
    strbuf.append(&b, "fn i32 main() {\n");
    strbuf.append(&b, "    bool mut b = true;\n");
    strbuf.append(&b, "    char mut c = 'x';\n");
    strbuf.append(&b, "    color mut k = color.green;\n");
    strbuf.append(&b, "    i32 mut* mut p = null;\n");
    strbuf.append(&b, "    u64 mut u = 7;\n");
    strbuf.append(&b, "    i32 mut n = 3;\n");
    strbuf.append(&b, "    print(b);\n");
    strbuf.append(&b, "    print(c);\n");
    strbuf.append(&b, "    print(k);\n");
    strbuf.append(&b, "    print(p);\n");
    strbuf.append(&b, "    print(u);\n");
    strbuf.append(&b, "    eprint(u);\n");
    strbuf.append(&b, "    println(n);\n");
    strbuf.append(&b, "    print(\"hi\");\n");
    strbuf.append(&b, "    fprint(2, u);\n");
    strbuf.append(&b, "    return 0;\n}\n");
    return gen_env.open_src(e, strbuf.view(&b));
}

// ---- item 19: the print family --------------------------------------------------------

fn void a_bool_is_widened_to_a_byte_before_it_is_printed() {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    assert(open_prints(&e));
    gen_env.discard_at(&e, 6);
    // Item 2: a `bool` place holds `i8` and a `bool` value is `i1`, so the
    // load is a `trunc` and the entry point, whose parameter is a fort `bool`,
    // takes that `i1` as it stands; `print` writes to stdout.
    // D11.5
    gen_env.expect_text(gen_env.body(&e),
                        gen_env.join4(&e, "  %t0 = load i8, ptr %b.0, align 1\n",
                                      "  %t1 = trunc i8 %t0 to i1\n",
                                      "  call void @\"std.rt.print_bool\"(i32 1, ",
                                      "i1 zeroext %t1)\n"));
}

fn void a_char_goes_to_its_own_entry_point_unwidened() {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    assert(open_prints(&e));
    gen_env.discard_at(&e, 7);
    // `char` is an unsigned byte, so it is `i8 zeroext` and is never widened
    // to an integer.
    // D3.2
    gen_env.expect_text(gen_env.body(&e),
                        gen_env.join3(&e, "  %t0 = load i8, ptr %c.1, align 1\n",
                                      "  call void @\"std.rt.print_char\"(i32 1, ",
                                      "i8 zeroext %t0)\n"));
}

fn void an_enum_prints_through_its_table_and_its_member_count() {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    assert(open_prints(&e));
    gen_env.discard_at(&e, 8);
    // Item 21: the table is emitted for an enum some `print` of that type
    // reaches, and the count stands beside it.
    gen_env.expect_text(
        gen_env.body(&e),
        gen_env.join3(&e, "  %t0 = load i32, ptr %k.2, align 4\n",
                      "  call void @\"std.rt.print_enum\"(i32 1, i32 %t0, ",
                      "ptr @.enum.main.color, i64 2)\n"));
    assert(e.g.enums.len == 1);
}

fn void a_pointer_prints_through_the_pointer_entry_point() {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    assert(open_prints(&e));
    gen_env.discard_at(&e, 9);
    gen_env.expect_text(gen_env.body(&e),
                        gen_env.join2(&e, "  %t0 = load ptr, ptr %p.3, align 8\n",
                                      "  call void @\"std.rt.print_ptr\"(i32 1, ptr %t0)\n"));
}

fn void an_integer_is_extended_to_64_bits_by_its_own_signedness() {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    assert(open_prints(&e));
    gen_env.discard_at(&e, 10);
    // Item 19: `u8 u16 u32 u64` go to `_u64` zero-extended, and the width
    // already agrees here, so nothing widens it (item 9).
    gen_env.expect_text(gen_env.body(&e),
                        gen_env.join2(&e, "  %t0 = load i64, ptr %u.4, align 8\n",
                                      "  call void @\"std.rt.print_u64\"(i32 1, i64 %t0)\n"));
    // `eprint` is the same call to descriptor 2.
    // D11.5
    gen_env.discard_at(&e, 11);
    gen_env.expect_text(gen_env.body(&e),
                        gen_env.join2(&e, "  %t0 = load i64, ptr %u.4, align 8\n",
                                      "  call void @\"std.rt.print_u64\"(i32 2, i64 %t0)\n"));
}

fn void println_ends_with_a_newline_byte_of_its_own() {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    assert(open_prints(&e));
    gen_env.discard_at(&e, 12);
    // Item 19: one call per argument, then the newline; a signed integer is
    // sign-extended and goes to `_i64`.
    gen_env.expect_text(
        gen_env.body(&e),
        gen_env.join4(&e, "  %t0 = load i32, ptr %n.5, align 4\n",
                      "  %t1 = sext i32 %t0 to i64\n",
                      "  call void @\"std.rt.print_i64\"(i32 1, i64 %t1)\n",
                      "  call void @\"std.rt.print_char\"(i32 1, i8 zeroext 10)\n"));
}

fn void a_string_literal_prints_as_its_constant_and_its_length() {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    assert(open_prints(&e));
    gen_env.discard_at(&e, 13);
    // Item 19: a literal is `@.str.N` and its length, with no header built for
    // it at all.
    // D3.7
    gen_env.expect_text(gen_env.body(&e),
                        "  call void @\"std.rt.print_str\"(i32 1, ptr @.str.0, i64 2)\n");
}

fn void fprint_evaluates_its_descriptor_once_and_before_the_arguments() {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    assert(open_prints(&e));
    gen_env.discard_at(&e, 14);
    // `fd` is an expression like any other and is evaluated before the
    // arguments, left to right.
    // D6.3, D12.2
    gen_env.expect_text(gen_env.body(&e),
                        gen_env.join2(&e, "  %t0 = load i64, ptr %u.4, align 8\n",
                                      "  call void @\"std.rt.print_u64\"(i32 2, i64 %t0)\n"));
}

// ---- assert and panic --------------------------------------------------------------
// D12.2

fn void assert_quotes_its_argument_as_the_user_wrote_it() {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    string[2] mut lines = {"    bool mut b = true;", "    assert(b == true);"};
    assert(gen_env.open_lines(&e, lines[..]));
    gen_env.discard_at(&e, 1);
    // The message is the source text between the call's parentheses, and the
    // position is the builtin's own name.
    // D11.4
    gen_env.expect_text(
        gen_env.body(&e),
        gen_env.join4(&e, "  %t0 = load i8, ptr %b.0, align 1\n",
                      "  %t1 = trunc i8 %t0 to i1\n", "  %t2 = icmp eq i1 %t1, true\n",
                      "  br i1 %t2, label %L0, label %L1\n\nL0:\n"));
    gen_env.expect_text(
        gen_env.fail(&e),
        gen_env.join4(&e, "\nL1:\n",
                      "  call void @\"std.rt.assert_fail\"(ptr @.str.0, ptr @.file.0, ",
                      "i32 3, i32 5)\n", "  unreachable\n"));
    // The quoted text is the one string constant this call made.
    assert(e.g.strs.len == 1);
    gen_env.expect_text(gen_env.record_text(&e, 0), "b == true");
}

fn void panic_writes_its_message_and_ends_the_block() {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    string[2] mut lines = {"    i32 mut n = 3;", "    panic(\"bad\");"};
    assert(gen_env.open_lines(&e, lines[..]));
    gen_env.discard_at(&e, 1);
    // The callee aborts, so the call is followed by `unreachable` and the
    // block is terminated.
    // D11.4
    gen_env.expect_text(
        gen_env.body(&e),
        gen_env.join2(&e,
                      "  call void @\"std.rt.panic\"(ptr @.str.0, i64 3, ptr @.file.0, ",
                      "i32 3, i32 5)\n  unreachable\n"));
    assert(e.g.terminated);
}

// ---- item 7 and item 8: the calls ----------------------------------------------------

// Two functions to call, one of them through a pointer, and one `extern`
// with the variadic tail of item 8.
fn bool open_calls(gen_env.env mut* e) {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "struct point {\n    i32 x;\n    i32 y;\n}\n");
    strbuf.append(&b, "fn i32 add(i32 a, i32 b) {\n    return a +% b;\n}\n");
    strbuf.append(&b, "fn point make() {\n    return point{1, 2};\n}\n");
    strbuf.append(&b, "fn i32 take(point p) {\n    return p.x;\n}\n");
    strbuf.append(&b, "fn noreturn stop() {\n    panic(\"stop\");\n}\n");
    strbuf.append(&b, "extern fn i32 printf(char* fmt, i32 v);\n");
    strbuf.append(&b, "fn i32 main() {\n");
    strbuf.append(&b, "    i32 mut n = 3;\n");
    strbuf.append(&b, "    fn i32(i32, i32) mut f = add;\n");
    strbuf.append(&b, "    i32 mut r = f(n, n);\n");
    strbuf.append(&b, "    i32 mut q = add(n, n);\n");
    strbuf.append(&b, "    point mut z = make();\n");
    strbuf.append(&b, "    i32 mut k = take(z);\n");
    strbuf.append(&b, "    i32 mut c = printf(\"%d\\n\".ptr, n);\n");
    strbuf.append(&b, "    make();\n");
    strbuf.append(&b, "    stop();\n");
    strbuf.append(&b, "}\n");
    return gen_env.open_src(e, strbuf.view(&b));
}

fn void a_direct_call_names_the_symbol_and_carries_no_function_type() {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    assert(open_calls(&e));
    gen_env.emit_value(&e, "q");
    // Item 7: a direct call site needs no function type, an opaque pointer
    // carrying none only where the callee is a value.
    // D3.10, D19.2
    gen_env.expect_text(gen_env.body(&e),
                        gen_env.join3(&e, "  %t0 = load i32, ptr %n.0, align 4\n",
                                      "  %t1 = load i32, ptr %n.0, align 4\n",
                                      "  %t2 = call i32 @\"main.add\"(i32 %t0, i32 %t1)\n"));
}

fn void a_call_through_a_pointer_carries_the_function_type() {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    assert(open_calls(&e));
    gen_env.emit_value(&e, "r");
    // An opaque pointer carries no signature, so the call site states it; the
    // callee is evaluated before the arguments.
    // D3.10, D19.2, D6.3
    gen_env.expect_text(gen_env.body(&e),
                        gen_env.join4(&e, "  %t0 = load ptr, ptr %f.1, align 8\n",
                                      "  %t1 = load i32, ptr %n.0, align 4\n",
                                      "  %t2 = load i32, ptr %n.0, align 4\n",
                                      "  %t3 = call i32 (i32, i32) %t0(i32 %t1, i32 %t2)\n"));
}

fn void an_extern_call_goes_through_the_variadic_call_type() {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    assert(open_calls(&e));
    gen_env.emit_value(&e, "c");
    // The variadic tail is what makes the vector-register count right at a
    // fixed-prototype declaration of a C function, and `#3` is `nobuiltin` on
    // every extern call site (item 8).
    // D9.8
    string text = gen_env.body(&e);
    gen_env.expect_text(text[text.len - 62..],
                        "  %t5 = call i32 (ptr, i32, ...) @printf(ptr %t3, i32 %t4) #3\n");
    assert(gen.gen_uses_attr(&e.g, gen.ATTR_NOBUILTIN));
    // It is declared in the extern group, with its own C name (item 8).
    assert(e.g.externs.len == 1);
}

fn void an_aggregate_result_arrives_through_the_sret_pointer() {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    assert(open_calls(&e));
    gen_env.into_text(&e, "z");
    // Item 7: the result place leads the argument list and the call itself is
    // `void`.
    gen_env.expect_text(gen_env.body(&e), "  call void @\"main.make\"(ptr %z.4)\n");
}

fn void an_aggregate_argument_is_a_pointer_to_a_copy_the_caller_made() {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    assert(open_calls(&e));
    gen_env.emit_value(&e, "k");
    // Item 7: a struct, fixed array, span or `string` argument is a plain
    // `ptr` to a copy the caller allocates in its entry block, and `byval` is
    // never used.
    gen_env.expect_text(gen_env.allocas(&e), "  %tmp0 = alloca %struct.main.point, align 4\n");
    gen_env.expect_text(
        gen_env.body(&e),
        gen_env.join3(&e,
                      "  call void @llvm.memcpy.p0.p0.i64(ptr align 4 %tmp0, ",
                      "ptr align 4 %z.4, i64 8, i1 false)\n",
                      "  %t0 = call i32 @\"main.take\"(ptr %tmp0)\n"));
}

fn void a_call_of_a_noreturn_function_ends_in_a_trap() {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    assert(open_calls(&e));
    gen_env.discard_at(&e, 8);
    // The trap is what catches a `noreturn` function that returns anyway,
    // which is why the declaration is unadorned and the optimizer cannot
    // delete it.
    // D8.5, D19.7
    gen_env.expect_text(gen_env.body(&e),
                        gen_env.join3(&e, "  call void @\"main.stop\"()\n",
                                      "  call void @llvm.trap()\n", "  unreachable\n"));
    assert(gen.gen_uses_intrinsic(&e.g, gen.IN_TRAP));
    assert(gen.gen_uses_attr(&e.g, gen.ATTR_TRAP));
    assert(e.g.terminated);
}

fn void an_aggregate_result_with_nowhere_to_go_is_a_diagnostic() {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    assert(open_calls(&e));
    // Item 7: an aggregate result arrives through the `sret` pointer, so
    // reading one as a value would drop that argument. The emitter reports
    // rather than emitting a call it cannot justify, which is the rule for
    // every path it does not lower.
    gen_env.emit_value(&e, "z");
    assert(e.g.failed);
    assert(gen_env.said(&e, "an aggregate result read without a destination"));
}

fn void an_expression_that_designates_no_storage_is_a_diagnostic() {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    string[1] mut lines = {"    i32 mut a = 3;"};
    assert(gen_env.open_lines(&e, lines[..]));
    // A literal is a value and has no place; the emitter says so rather than
    // inventing one.
    // D6.7
    gen_env.emit_place(&e, "a");
    assert(e.g.failed);
    assert(gen_env.said(&e, "cannot generate code yet for this expression as a place"));
}

// A fort function and an `extern` one whose parameters and results are narrow,
// which is the only shape that can see the attribute rule of item 7.
fn bool open_narrow(gen_env.env mut* e) {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "fn u8 narrow(u8 a, i8 b, bool c) {\n    return a;\n}\n");
    strbuf.append(&b, "extern fn u8 cnarrow(u8 a, i16 b);\n");
    strbuf.append(&b, "fn i32 main() {\n");
    strbuf.append(&b, "    u8 mut x = 1;\n");
    strbuf.append(&b, "    i8 mut y = 2;\n");
    strbuf.append(&b, "    bool mut z = true;\n");
    strbuf.append(&b, "    u8 mut r = narrow(x, y, z);\n");
    strbuf.append(&b, "    u8 mut s = cnarrow(x, 3);\n");
    strbuf.append(&b, "    return 0;\n}\n");
    return gen_env.open_src(e, strbuf.view(&b));
}

fn void a_narrow_argument_and_a_narrow_result_carry_their_attributes() {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    assert(open_narrow(&e));
    gen_env.emit_value(&e, "r");
    // Item 7: `zeroext` for `u8` and `bool`, `signext` for `i8`, on the
    // arguments and on the result, so that LLVM normalizes on both sides of
    // the call. Nothing else in the repository can see this: a fort program
    // is one module whose caller and callee agree with each other about a
    // convention both get wrong, and the whole language corpus stays green
    // when an extension is dropped (AGENTS.md).
    gen_env.join5(&e, "  %t0 = load i8, ptr %x.0, align 1\n",
                  "  %t1 = load i8, ptr %y.1, align 1\n",
                  "  %t2 = load i8, ptr %z.2, align 1\n", "  %t3 = trunc i8 %t2 to i1\n",
                  "  %t4 = call zeroext i8 @\"main.narrow\"(i8 zeroext %t0, ");
    gen_env.expect_text(gen_env.body(&e),
                        gen_env.join_more(&e, "i8 signext %t1, i1 zeroext %t3)\n"));
}

fn void an_extern_call_carries_them_too_a_literal_argument_included() {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    assert(open_narrow(&e));
    gen_env.emit_value(&e, "s");
    // The attribute comes from the parameter's fort type and not from the
    // operand, so a literal argument carries it as a loaded one does; the call
    // type of item 8 states the types alone.
    // D9.8
    gen_env.join2(&e, "  %t0 = load i8, ptr %x.0, align 1\n",
                  "  %t1 = call zeroext i8 (i8, i16, ...) @cnarrow(i8 zeroext %t0, ");
    gen_env.expect_text(gen_env.body(&e), gen_env.join_more(&e, "i16 signext 3) #3\n"));
}

fn void a_discarded_aggregate_result_still_gets_a_place() {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    assert(open_calls(&e));
    // Item 7: the `sret` pointer is part of the call, so a statement that
    // throws the result away still allocates the place nothing reads.
    gen_env.discard_at(&e, 7);
    gen_env.expect_text(gen_env.allocas(&e), "  %tmp0 = alloca %struct.main.point, align 4\n");
    gen_env.expect_text(gen_env.body(&e), "  call void @\"main.make\"(ptr %tmp0)\n");
}

fn i32 main() {
    a_bool_is_widened_to_a_byte_before_it_is_printed();
    a_char_goes_to_its_own_entry_point_unwidened();
    an_enum_prints_through_its_table_and_its_member_count();
    a_pointer_prints_through_the_pointer_entry_point();
    an_integer_is_extended_to_64_bits_by_its_own_signedness();
    println_ends_with_a_newline_byte_of_its_own();
    a_string_literal_prints_as_its_constant_and_its_length();
    fprint_evaluates_its_descriptor_once_and_before_the_arguments();
    println("prints ok");
    assert_quotes_its_argument_as_the_user_wrote_it();
    panic_writes_its_message_and_ends_the_block();
    println("checks ok");
    a_direct_call_names_the_symbol_and_carries_no_function_type();
    a_call_through_a_pointer_carries_the_function_type();
    an_extern_call_goes_through_the_variadic_call_type();
    an_aggregate_result_arrives_through_the_sret_pointer();
    an_aggregate_argument_is_a_pointer_to_a_copy_the_caller_made();
    a_call_of_a_noreturn_function_ends_in_a_trap();
    a_narrow_argument_and_a_narrow_result_carry_their_attributes();
    an_extern_call_carries_them_too_a_literal_argument_included();
    a_discarded_aggregate_result_still_gets_a_place();
    an_aggregate_result_with_nowhere_to_go_is_a_diagnostic();
    an_expression_that_designates_no_storage_is_a_diagnostic();
    println("calls ok");
    println("ok");
    return 0;
}
