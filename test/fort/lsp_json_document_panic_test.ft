//! run
//! flags: -I ../../src/fort -I support -I ../../src
//! abort
//! stderr: panic: json.write_document: no document was parsed
//! stdout:
//| the document that parsed ok
import lsp.json;
import std.strbuf;

// write_document writes the tree of the last parse. A document that never
// parsed has no tree, so writing it is a violated precondition and
// panics.
// D13.3
fn i32 main() {
    strbuf.str_buf mut out = strbuf.create();
    defer strbuf.free(&out);
    json.doc mut d = json.create();
    defer json.free(&d);
    assert(json.parse(&d, "[1]"));
    json.writer mut w = json.writer{};
    json.write_init(&w, &out);
    json.write_document(&w, &d);
    assert(strbuf.view(&out) == "[1]");
    println("the document that parsed ok");
    assert(!json.parse(&d, "[1"));
    json.write_document(&w, &d);
    println(strbuf.view(&out));
    return 0;
}
