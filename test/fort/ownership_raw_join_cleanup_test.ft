//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| join allocator mode 2 released
//| required B26.join_allocator_teardown accept
/// Measures the teardown of a join refused at its last charge, apart from input equality.
// The refusal frees the merged core, raw context, ledger, and result vector. Five more programs
// measure the published merge, the alternatives, and the widen, core, and ledger refusals.
import ownership_raw_join_cleanup_env;
fn main() i32 {
    ownership_raw_join_cleanup_env.teardown_probe(2);
    println("required B26.join_allocator_teardown accept");
    return 0;
}
