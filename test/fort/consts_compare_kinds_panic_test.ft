//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: consts.cv_compare: constant comparison across kinds
//! stdout:
//| true
/// Checks that equality folding rejects an integer and a bool. The checker rejects this pair
/// before folding.
import consts;

fn main() i32 {
    consts.cval one = consts.cv_from_i64(1);
    println(consts.cv_compare(consts.cv_rel.cv_rel_eq, one, one).mag == 1);
    println(consts.cv_compare(consts.cv_rel.cv_rel_eq, one, consts.cv_from_bool(true)).mag);
    return 0;
}
