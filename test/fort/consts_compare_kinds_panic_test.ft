//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: consts.cv_compare: constant comparison across kinds
//! stdout:
//| true
import consts;

// `==` compares two constants of one kind: there is no comparison between an
// integer and a bool, so the checker has refused the program before folding and
// a call here is a broken precondition.
// D6.2, D13.3
fn i32 main() {
    consts.cval one = consts.cv_from_i64(1);
    println(consts.cv_compare(consts.cv_rel.cv_rel_eq, one, one).mag == 1);
    println(consts.cv_compare(consts.cv_rel.cv_rel_eq, one, consts.cv_from_bool(true)).mag);
    return 0;
}
