//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: fir_lower.unwind: an exit with no scope to leave above the floor
//! stdout:
//| the break finds its loop above the floor
/// Checks that the unwind of an exit ends the program when no scope above the floor stops it
/// (spec/fir.md 9.5). The checker refuses a `break` inside deferred code that no loop inside that
/// code takes (D7.8), so the test raises the floor of a lowerer by hand over the `break` of a
/// checked loop: first to the loop, where the walk still finds it, then above it.
import ast;
import fir;
import fir_lower;
import lower_env;

fn main() i32 {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[5] source = {
        "fn f(bool c) void {",
        "    while (c) {",
        "        break;",
        "    }",
        "}",
    };
    lower_env.check_lines(&e, source[..], true);
    ast.node* decl = lower_env.decl(&e, "f");
    ast.node* loop = ast.ast_child(decl->b, 0);
    ast.node* brk = ast.ast_child(loop->b, 0);
    fir.func mut f = fir.func_new(&e.c.ck.types, decl->sym, decl->sym->ty);
    defer fir.func_free(&f);
    fir_lower.lowerer mut lw = fir_lower.lowerer{.ck = &e.c.ck, .f = &f};
    defer fir_lower.scopes_free(&lw.scopes);
    // the body, the loop and a block of deferred code inside the loop
    fir_lower.scope_push(&lw, fir_lower.scope_kind.sc_fn, 0, 0);
    fir_lower.scope_push(&lw, fir_lower.scope_kind.sc_loop, 0, 0);
    fir_lower.scope_push(&lw, fir_lower.scope_kind.sc_block, 0, 0);
    lw.floor = 1;
    u64 mut stop = 0;
    assert(fir_lower.unwind(&lw, brk, fir_lower.exit_kind.x_break, &stop));
    assert(stop == 1);
    println("the break finds its loop above the floor");
    lw.floor = 2;
    fir_lower.unwind(&lw, brk, fir_lower.exit_kind.x_break, &stop);
    println("the break left the deferred code");
    return 0;
}
