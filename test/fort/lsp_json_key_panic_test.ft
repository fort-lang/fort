//! run
//! flags: -I ../../src/fort -I support -I ../../src
//! abort
//! stderr: panic: json.write_key: no object is open
//! stdout:
//| a key in an object ok
import lsp.json;
import std.strbuf;

// A key belongs to an object; one written at depth 0 is a violated
// precondition and panics.
// D13.3
fn main() i32 {
    strbuf.str_buf mut out = strbuf.create();
    defer strbuf.free(&out);
    json.writer mut w = json.writer{};
    json.write_init(&w, &out);
    json.write_object_begin(&w);
    json.write_key(&w, "k");
    json.write_uint(&w, 1);
    json.write_object_end(&w);
    assert(strbuf.view(&out) == "{\"k\":1}");
    println("a key in an object ok");
    json.write_key(&w, "loose");
    println(strbuf.view(&out));
    return 0;
}
