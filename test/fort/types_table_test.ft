//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| growth ok
//| params ok
//| ok
import prim;
import types;
import types_env;

/// Checks two Fort-specific structures that the C suites cannot observe. The
/// node vector moves owned pointers when it grows. A node copies its parameter
/// list from the caller into an owned span.
//
// Other tests do not expose these errors. A vector can lose an older node but
// still return the last interned node. A borrowed parameter list can remain
// correct until the caller changes its array.

// A distinct declaration pointer per nominal type built here.
i64[4] mut decls = {};

fn decl_at(u64 i) void mut* {
    return cast(&decls[i], void mut*);
}

// ---- the node vector ------------------------------------------------------------

// Interning far past the first capacity keeps every node alive and unique: the
// vector grows by moving its owned pointers, so a node interned before a
// growth must still be the node its spelling interns to after it.
fn a_node_survives_every_growth_of_the_table() void {
    types.table mut tt = types.table{};
    defer types.type_table_free(&tt);
    types.node* i32t = types.type_prim(&tt, prim.prim_kind.prim_i32);
    types.node* first = types.type_ptr(&tt, i32t, false, false);
    // 300 distinct array types, which is 19 doublings past the first capacity
    // of 16 (types.ft's NODE_MIN_CAP).
    types.node*[300] mut made = {};
    u64 mut n = 0;
    while (n < 300) {
        made[n] = types.type_array(&tt, i32t, n + 1);
        assert(made[n]->len == n + 1);
        n += 1;
    }
    // Every node made before the growths is still itself, and still what its
    // arguments intern to.
    assert(first == types.type_ptr(&tt, i32t, false, false));
    assert(i32t == types.type_prim(&tt, prim.prim_kind.prim_i32));
    assert(types.type_sizeof(first) == 8);
    n = 0;
    while (n < 300) {
        assert(made[n] == types.type_array(&tt, i32t, n + 1));
        assert(made[n]->len == n + 1);
        assert(types.type_sizeof(made[n]) == (n + 1) * 4);
        // No two of them are one node.
        if (n > 0) {
            assert(made[n] != made[n - 1]);
        }
        n += 1;
    }
    assert(tt.count == 302);
}

// A nominal type is found by its declaration however many nodes stand before
// it, which is the scan the table does over its whole vector.
fn a_nominal_type_is_found_after_a_growth() void {
    types.table mut tt = types.table{};
    defer types.type_table_free(&tt);
    types.node* s = types.type_struct(&tt, "early", decl_at(0));
    types.node* i32t = types.type_prim(&tt, prim.prim_kind.prim_i32);
    u64 mut n = 0;
    while (n < 100) {
        assert(types.type_array(&tt, i32t, n + 1) != null);
        n += 1;
    }
    assert(types.type_struct(&tt, "early", decl_at(0)) == s);
    // It still lays out, so the layout block travelled with the node.
    types.node*[1] mut fields = {i32t};
    u64[1] mut offsets = {};
    assert(types.type_layout_begin(s));
    assert(types.type_layout_struct(s, fields[..], offsets[..]));
    assert(types.type_sizeof(s) == 4);
}

// The table frees every node it made, however many growths it took: a node the
// growth dropped is a leak this loop only makes slow, but a node it moved
// twice is a double free that aborts in libc, which is what twenty rounds of
// fifty growths ask about.
fn a_grown_table_frees_everything_it_made() void {
    u64 mut round = 0;
    while (round < 20) {
        types.table mut tt = types.table{};
        types.node* i32t = types.type_prim(&tt, prim.prim_kind.prim_i32);
        types.node*[3] mut params = {i32t, i32t, i32t};
        u64 mut n = 0;
        while (n < 50) {
            assert(types.type_array(&tt, i32t, n + 1) != null);
            // A function type on every round, so the parameter lists are
            // freed with the nodes as well.
            assert(types.type_fn(&tt, types.type_array(&tt, i32t, n + 1), params[..],
                                 false) != null);
            n += 1;
        }
        types.type_table_free(&tt);
        round += 1;
    }
}

// The three blocks a node owns beside itself -- its parameter list, its layout
// and the vector the table keeps them in -- are released with it (`del` is
// shallow), and nothing else in this directory can see it if they are not: the
// gate's sanitizers instrument the C compiler and not the x86-64 program the
// harness runs, so a leak here is invisible to every other test and to ctest.
//
// What can see one is the allocator, in two views, because each is blind to
// what the other sees (modules_closure_test.ft says which and why). Two
// hundred identical rounds build the same table and free it: the program
// break sees a leak the allocator had to ask the kernel for, and the address
// a round is handed sees one it served out of its own free chunks. The early
// round is held against the last two and the smaller distance taken, since
// the allocator alternates between two positions from one round to the next
// once the program's path is long enough to change a bin.
//
// type_table_free makes four releases. `del(t->params)`, `del(t->layout)` and
// `del(tt->nodes)` are each watched here by an address and by the break, and
// each was verified by deleting that one release and watching this test fail.
// The fourth, `del(t)` on the node itself, is held by the language rather than
// by a probe: an owning local dropped without it makes the checked build abort
// at the next write into that slot with `overwriting owned value`, which is
// what deleting it produces here.
u64 LEAK_ROUNDS = 200;
u64 LEAK_EARLY = 100;
u64 LEAK_TYPES = 200;
u64 LEAK_BOUND = 8192;

// The current program break, which is where the heap ends: sbrk(0) moves
// nothing and reports it. There is no std binding for it and this is its one
// caller.
extern fn sbrk(i64 increment) void*;

fn heap_end() u64 {
    return cast(sbrk(0), u64);
}

// How far apart two positions are, whichever way the heap moved: a subtraction
// the wrong way round would trap before the assertion.
fn distance(u64 a, u64 b) u64 {
    if (a > b) {
        return a - b;
    }
    return b - a;
}

// The smaller of the distances from the early round to the last two.
fn moved(u64 early, u64 late, u64 last) u64 {
    assert(early != 0 && late != 0 && last != 0);
    u64 one = distance(late, early);
    u64 other = distance(last, early);
    if (one < other) {
        return one;
    }
    return other;
}

fn the_blocks_a_node_owns_are_released_with_it() void {
    u64[3] mut break_at = {};
    u64[3] mut param_at = {};
    u64[3] mut layout_at = {};
    u64[3] mut nodes_at = {};
    u64 mut round = 0;
    while (round < LEAK_ROUNDS) {
        types.table mut tt = types.table{};
        types.node* i32t = types.type_prim(&tt, prim.prim_kind.prim_i32);
        types.node*[8] mut params = {i32t, i32t, i32t, i32t, i32t, i32t, i32t, i32t};
        types.node* f = types.type_fn(&tt, types.type_void(&tt), params[..], false);
        types.node* s = types.type_struct(&tt, "probe", decl_at(2));
        // Past the first capacity of the node vector, so the block
        // `del(tt->nodes)` gives back is one the allocator had to grow for,
        // and one parameter list per function type, since a single
        // sixty-four-byte list a round keeps moves neither view.
        u64 mut n = 0;
        while (n < LEAK_TYPES) {
            types.node* elem = types.type_array(&tt, i32t, n + 1);
            assert(elem != null);
            assert(types.type_fn(&tt, elem, params[..], false) != null);
            n += 1;
        }
        u64 mut slot = 3;
        if (round == LEAK_EARLY) {
            slot = 0;
        }
        if (round == LEAK_ROUNDS - 2) {
            slot = 1;
        }
        if (round == LEAK_ROUNDS - 1) {
            slot = 2;
        }
        // The addresses are read while the table still holds them, the break
        // after it is freed, which is where a round's keeping shows.
        if (slot < 3) {
            param_at[slot] = cast(f->params.ptr, u64);
            layout_at[slot] = cast(s->layout, u64);
            nodes_at[slot] = cast(tt.nodes.ptr, u64);
        }
        types.type_table_free(&tt);
        if (slot < 3) {
            break_at[slot] = heap_end();
        }
        round += 1;
    }
    assert(moved(break_at[0], break_at[1], break_at[2]) < LEAK_BOUND);
    assert(moved(param_at[0], param_at[1], param_at[2]) < LEAK_BOUND);
    assert(moved(layout_at[0], layout_at[1], layout_at[2]) < LEAK_BOUND);
    assert(moved(nodes_at[0], nodes_at[1], nodes_at[2]) < LEAK_BOUND);
}

// ---- the parameter list ---------------------------------------------------------

// The node owns a copy of the list: writing to the caller's array afterwards
// changes nothing, which is what "the parameter list is copied" means.
fn the_parameter_list_is_copied_out_of_the_caller_s_array() void {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node* i32t = types.type_prim(&e.tt, prim.prim_kind.prim_i32);
    types.node* i64t = types.type_prim(&e.tt, prim.prim_kind.prim_i64);
    types.node* v = types.type_void(&e.tt);
    types.node*[2] mut params = {i32t, i32t};
    types.node* f = types.type_fn(&e.tt, v, params[..], false);
    assert(types_env.str_of(&e, f) == "fn (i32, i32) void");
    // The caller's array is its own storage: overwriting it leaves the type.
    params[0] = i64t;
    params[1] = i64t;
    assert(types_env.str_of(&e, f) == "fn (i32, i32) void");
    assert(f->params.len == 2);
    assert(f->params[0] == i32t);
    assert(f->params[1] == i32t);
    // The new list is a different type and interns on its own.
    types.node* g = types.type_fn(&e.tt, v, params[..], false);
    assert(g != f);
    assert(types_env.str_of(&e, g) == "fn (i64, i64) void");
    assert(!types.type_equal(f, g));
    // Interning still answers by value, from a third array with the first
    // contents.
    types.node*[2] mut again = {i32t, i32t};
    assert(types.type_fn(&e.tt, v, again[..], false) == f);
}

// A span carries its own length, so the C's `nparams` is `params.len` here and
// the arity is part of identity at every width.
fn the_arity_is_the_length_of_the_span() void {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node* i32t = types.type_prim(&e.tt, prim.prim_kind.prim_i32);
    types.node* v = types.type_void(&e.tt);
    types.node*[8] mut params = {i32t, i32t, i32t, i32t, i32t, i32t, i32t, i32t};
    types.node*[9] mut made = {};
    u64 mut n = 0;
    while (n <= 8) {
        made[n] = types.type_fn(&e.tt, v, params[..n], false);
        assert(made[n]->params.len == n);
        // The same prefix interns to the same node.
        assert(made[n] == types.type_fn(&e.tt, v, params[..n], false));
        if (n > 0) {
            assert(made[n] != made[n - 1]);
            assert(!types.type_equal(made[n], made[n - 1]));
        }
        n += 1;
    }
    assert(types_env.str_of(&e, made[0]) == "fn () void");
    assert(types_env.str_of(&e, made[1]) == "fn (i32) void");
    assert(types_env.str_of(&e, made[3]) == "fn (i32, i32, i32) void");
    // A function type with no parameters allocates no list at all.
    assert(made[0]->params.len == 0);
}

// The copied list holds the caller's nodes, not copies of them, so identity
// inside the list is still pointer equality.
fn the_copied_list_holds_the_same_nodes() void {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node* v = types.type_void(&e.tt);
    types.node* owned = types_env.type_of(&e, "node mut* own mut@ own");
    types.node* plain = types_env.type_of(&e, "node*");
    types.node*[2] mut params = {owned, plain};
    types.node* f = types.type_fn(&e.tt, v, params[..], false);
    assert(f->params[0] == owned);
    assert(f->params[1] == plain);
    assert(types_env.str_of(&e, f) == "fn (node mut* own mut@ own, node*) void");
    // The marks of a parameter are part of the type's identity, which is what
    // the copy has to keep.
    types.node*[2] mut lent = {types_env.type_of(&e, "node mut* mut@"), plain};
    assert(types.type_fn(&e.tt, v, lent[..], false) != f);
}

fn main() i32 {
    a_node_survives_every_growth_of_the_table();
    a_nominal_type_is_found_after_a_growth();
    a_grown_table_frees_everything_it_made();
    the_blocks_a_node_owns_are_released_with_it();
    println("growth ok");
    the_parameter_list_is_copied_out_of_the_caller_s_array();
    the_arity_is_the_length_of_the_span();
    the_copied_list_holds_the_same_nodes();
    println("params ok");
    println("ok");
    return 0;
}
