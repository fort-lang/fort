//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: fir_llvm.call_of: an aggregate argument that is no place
//! stdout:
//| true
/// The lowering passes an aggregate argument as a place, never as a constant. The text passes
/// `const zero pair` to main.take, so the translation of the call panics.
import fir;
import fir_llvm;
import llvm_env;

string[6] PRELUDE = {
    "struct pair {",
    "    i32 a;",
    "    i32 b;",
    "}",
    "fn take(pair p) i32 {",
    "    return p.a;\n}",
};

string[8] TEXT = {
    "fn main.f() -> i32 {",
    "    let _1: pair;",
    "",
    "    bb0: {",
    "        _0 = call fn main.take(const zero pair) #1:1 s1;",
    "        return #1:1 s1;",
    "    }",
    "}",
};

// A panic ends the program, so the case stands in a file of its own.
fn main() i32 {
    llvm_env.env mut e = llvm_env.env{};
    llvm_env.open(&e);
    defer llvm_env.close(&e);
    fir.module mut m = llvm_env.parse(&e, PRELUDE[..], TEXT[..]);
    defer fir.module_free(&m);
    fir.func* f = fir.module_function_at(&m, 0);
    println(fir.block_statement_count(f, 0) == 1);
    llvm_env.statement_text(&e, f, 0, 0);
    return 0;
}
