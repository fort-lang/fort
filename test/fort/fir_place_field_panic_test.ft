//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: fir.place_type: a field of a type with no fields
//! stdout:
//| ready
/// Checks that fir.place_type refuses a field of a place that has no fields.
import fir;
import prim;
import types;

fn main() i32 {
    types.table mut tt = types.table{};
    defer types.type_table_free(&tt);
    types.node* i32t = types.type_prim(&tt, prim.prim_kind.prim_i32);
    types.node*[2] params = {i32t, i32t};
    types.node* fnty = types.type_fn(&tt, i32t, params[..], false);
    fir.func mut f = fir.func_new(&tt, null, fnty);
    defer fir.func_free(&f);
    fir.place p = fir.place_field(&f, fir.place_local(1), 0);
    println("ready");
    fir.place_type(&f, p);
    return 0;
}
