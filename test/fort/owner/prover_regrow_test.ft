    "        _1 = move _5 #3:3;",
    "        _6 = alloc<u8>(const u64 1) #4:2;",
    "        _7 = aggregate u8 mut@ own(move _6, const u64 1) #4:2;",
    "        check(overwrite: _1) -> bb3 #4:3;",
    "    }",
    "    bb3: {",
