//! run
//! flags: -I ../../src -I support
//! stdout:
//| legal ok
//| results ok
//| uses ok
//| calls ok
//| cases 14 proved 6 refused 8 events 7
/// Checks how owner.prover reads the rvalue `regrow` (D12.2): as a `move` of its operand and as a
/// new allocation, and not as a call. Each case is one function of FIR text. The test holds the
/// lines that the prover reports for it, and then the report of the interpreter with the events of
/// the shadow, so that each line of the prover stands beside the event that the run gives.
///
/// The last line of the output counts the cases, those with 0 lines of the prover, those with an
/// error, and those with an event. The one refused case with no event is `main.call`: the prover
/// does not read the body of `touch`.
import check_env;
import fort.fir;
import fort.owner.prover;
import fort.owner.report;
import run_env;
import std.strbuf;

// The struct, the globals and the function that the FIR text names. Each function allocates a span
// of 2 elements at line 2, has its `regrow` to 4 elements at line 3 or 4, reads at line 5,
// releases at line 6 and returns at line 7.
string[8] PRELUDE = {
    "struct vec {",
    "    u8 mut@ own items;",
    "    u64 len;",
    "}",
    "u8 mut@ own mut G = {};",
    "u8 mut* own mut P = null;",
    "fn touch() void {",
    "}",
};

// The forms that the prover proves: 0 lines of the prover and 0 events of the run.
string[136] LEGAL = {
    // The catalogue form of a local, as the lowering writes it: the `move` empties `s`, so the
    // store of the result over `s` is proved.
    "fn main.local() -> u64 {",
    "    let _1 (s): u8 mut@ own;",
    "    let _2: u8 mut* own;",
    "    let _3: u8 mut@ own;",
    "    let _4: u8 mut@ own;",
    "    let _5: u8 mut* own;",
    "    let _6: u8 mut@ own;",
    "    bb0: {",
    "        _1 = const zero u8 mut@ own #1:1;",
    "        live(_1) #1:1;",
    "        _2 = alloc<u8>(const u64 2) #2:1;",
    "        _3 = aggregate u8 mut@ own(move _2, const u64 2) #2:1;",
    "        check(overwrite: _1) -> bb1 #2:2;",
    "    }",
    "    bb1: {",
    "        _1 = move _3 #2:2;",
    "        _4 = move _1 #3:1;",
    "        _5 = regrow<u8>(move _4, const u64 4) #3:2;",
    "        _6 = aggregate u8 mut@ own(move _5, const u64 4) #3:2;",
    "        check(overwrite: _1) -> bb2 #3:3;",
    "    }",
    "    bb2: {",
    "        _1 = move _6 #3:3;",
    "        _0 = copy _1.1 #5:1;",
    "        del(move _1) #6:1;",
    "        dead(_1) #7:1;",
    "        return #7:1;",
    "    }",
    "}",
    // A `regrow` that reads `s` with no temporary is a `move` of `s` also: the store over `s` is
    // proved.
    "fn main.direct() -> u64 {",
    "    let _1 (s): u8 mut@ own;",
    "    let _2: u8 mut* own;",
    "    let _3: u8 mut@ own;",
    "    let _4: u8 mut* own;",
    "    let _5: u8 mut@ own;",
    "    bb0: {",
    "        _1 = const zero u8 mut@ own #1:1;",
    "        live(_1) #1:1;",
    "        _2 = alloc<u8>(const u64 2) #2:1;",
    "        _3 = aggregate u8 mut@ own(move _2, const u64 2) #2:1;",
    "        check(overwrite: _1) -> bb1 #2:2;",
    "    }",
    "    bb1: {",
    "        _1 = move _3 #2:2;",
    "        _4 = regrow<u8>(move _1, const u64 4) #3:2;",
    "        _5 = aggregate u8 mut@ own(move _4, const u64 4) #3:2;",
    "        check(overwrite: _1) -> bb2 #3:3;",
    "    }",
    "    bb2: {",
    "        _1 = move _5 #3:3;",
    "        _0 = copy _1.1 #5:1;",
    "        del(move _1) #6:1;",
    "        dead(_1) #7:1;",
    "        return #7:1;",
    "    }",
    "}",
    // The catalogue form of a field through a pointer.
    "fn main.field() -> u64 {",
    "    let _1 (v): vec mut* own;",
    "    let _2: u8 mut* own;",
    "    let _3: u8 mut@ own;",
    "    let _4: u8 mut@ own mut*;",
    "    let _5: u8 mut@ own;",
    "    let _6: u8 mut* own;",
    "    let _7: u8 mut@ own;",
    "    bb0: {",
    "        _1 = const null vec mut* own #1:1;",
    "        live(_1) #1:1;",
    "        _1 = alloc<vec>(const u64 1) #1:3;",
    "        _2 = alloc<u8>(const u64 2) #2:1;",
    "        _3 = aggregate u8 mut@ own(move _2, const u64 2) #2:1;",
    "        check(overwrite: (*_1).0) -> bb1 #2:2;",
    "    }",
    "    bb1: {",
    "        (*_1).0 = move _3 #2:2;",
    "        _4 = addr mut((*_1).0) #3:1;",
    "        _5 = move (*_1).0 #3:1;",
    "        _6 = regrow<u8>(move _5, const u64 4) #3:2;",
    "        _7 = aggregate u8 mut@ own(move _6, const u64 4) #3:2;",
    "        check(overwrite: (*_4)) -> bb2 #3:3;",
    "    }",
    "    bb2: {",
    "        (*_4) = move _7 #3:3;",
    "        _0 = copy (*_1).0.1 #5:1;",
    "        del(move (*_1).0) #6:1;",
    "        del(move _1) #6:2;",
    "        dead(_1) #7:1;",
    "        return #7:1;",
    "    }",
    "}",
    // The catalogue form of a global.
    "fn main.global() -> u64 {",
    "    let _1: u8 mut@ own mut*;",
    "    let _2: u8 mut@ own;",
    "    let _3: u8 mut* own;",
    "    let _4: u8 mut@ own;",
    "    bb0: {",
    "        _1 = addr mut(global main.G) #3:1;",
    "        _2 = move global main.G #3:1;",
    "        _3 = regrow<u8>(move _2, const u64 4) #3:2;",
    "        _4 = aggregate u8 mut@ own(move _3, const u64 4) #3:2;",
    "        check(overwrite: (*_1)) -> bb1 #3:3;",
    "    }",
    "    bb1: {",
    "        (*_1) = move _4 #3:3;",
    "        _0 = copy global main.G.1 #5:1;",
    "        del(move global main.G) #6:1;",
    "        return #7:1;",
    "    }",
    "}",
    // A second `regrow` of the place that the first emptied takes the empty span, as a second
    // `move` does.
    "fn main.twice() -> u64 {",
    "    let _1 (s): u8 mut@ own;",
    "    let _2: u8 mut* own;",
    "    let _3: u8 mut@ own;",
    "    let _4: u8 mut* own;",
    "    let _5: u8 mut@ own;",
    "    let _6: u8 mut* own;",
    "    let _7: u8 mut@ own;",
    "    bb0: {",
    "        _1 = const zero u8 mut@ own #1:1;",
    "        live(_1) #1:1;",
    "        _2 = alloc<u8>(const u64 2) #2:1;",
    "        _3 = aggregate u8 mut@ own(move _2, const u64 2) #2:1;",
    "        check(overwrite: _1) -> bb1 #2:2;",
    "    }",
    "    bb1: {",
    "        _1 = move _3 #2:2;",
    "        _4 = regrow<u8>(move _1, const u64 4) #3:2;",
    "        _5 = aggregate u8 mut@ own(move _4, const u64 4) #3:2;",
    "        _6 = regrow<u8>(move _1, const u64 3) #4:2;",
    "        _7 = aggregate u8 mut@ own(move _6, const u64 3) #4:2;",
    "        _0 = add(copy _5.1, copy _7.1) #5:1;",
    "        del(move _5) #6:1;",
    "        del(move _7) #6:2;",
    "        dead(_1) #7:1;",
    "        return #7:1;",
    "    }",
    "}",
};

// The result is the owner of a new allocation: a leak or an overwrite of it gives one error of the
// prover and the same event in the run.
string[149] RESULTS = {
    // The result is a new allocation: the local `t` that holds it at its exit leaks.
    "fn main.leak() -> u64 {",
    "    let _1 (s): u8 mut@ own;",
    "    let _2: u8 mut* own;",
    "    let _3: u8 mut@ own;",
    "    let _4 (t): u8 mut@ own;",
    "    let _5: u8 mut* own;",
    "    let _6: u8 mut@ own;",
    "    bb0: {",
    "        _4 = const zero u8 mut@ own #1:2;",
    "        _1 = const zero u8 mut@ own #1:1;",
    "        live(_1) #1:1;",
    "        _2 = alloc<u8>(const u64 2) #2:1;",
    "        _3 = aggregate u8 mut@ own(move _2, const u64 2) #2:1;",
    "        check(overwrite: _1) -> bb1 #2:2;",
    "    }",
    "    bb1: {",
    "        _1 = move _3 #2:2;",
    "        live(_4) #3:1;",
    "        _5 = regrow<u8>(move _1, const u64 4) #3:2;",
    "        _6 = aggregate u8 mut@ own(move _5, const u64 4) #3:2;",
    "        check(overwrite: _4) -> bb2 #3:3;",
    "    }",
    "    bb2: {",
    "        _4 = move _6 #3:3;",
    "        _0 = copy _4.1 #5:1;",
    "        dead(_4) #7:1;",
    "        dead(_1) #7:1;",
    "        return #7:1;",
    "    }",
    "}",
    // A result that no place takes: the temporary leaks at the `return`.
    "fn main.dropped() -> u64 {",
    "    let _1 (s): u8 mut@ own;",
    "    let _2: u8 mut* own;",
    "    let _3: u8 mut@ own;",
    "    let _4: u8 mut* own;",
    "    let _5: u8 mut@ own;",
    "    bb0: {",
    "        _1 = const zero u8 mut@ own #1:1;",
    "        live(_1) #1:1;",
    "        _2 = alloc<u8>(const u64 2) #2:1;",
    "        _3 = aggregate u8 mut@ own(move _2, const u64 2) #2:1;",
    "        check(overwrite: _1) -> bb1 #2:2;",
    "    }",
    "    bb1: {",
    "        _1 = move _3 #2:2;",
    "        _4 = regrow<u8>(move _1, const u64 4) #3:2;",
    "        _5 = aggregate u8 mut@ own(move _4, const u64 4) #3:2;",
    "        _0 = copy _5.1 #5:1;",
    "        dead(_1) #7:1;",
    "        return #7:1;",
    "    }",
    "}",
    // The storage that the `regrow` gives is an owner with no `aggregate`: the pointer local `p`
    // that takes it leaks at its exit.
    "fn main.bare() -> u64 {",
    "    let _1 (s): u8 mut@ own;",
    "    let _2: u8 mut* own;",
    "    let _3: u8 mut@ own;",
    "    let _4 (p): u8 mut* own;",
    "    bb0: {",
    "        _4 = const zero u8 mut* own #1:2;",
    "        _1 = const zero u8 mut@ own #1:1;",
    "        live(_1) #1:1;",
    "        _2 = alloc<u8>(const u64 2) #2:1;",
    "        _3 = aggregate u8 mut@ own(move _2, const u64 2) #2:1;",
    "        check(overwrite: _1) -> bb1 #2:2;",
    "    }",
    "    bb1: {",
    "        _1 = move _3 #2:2;",
    "        live(_4) #3:1;",
    "        _4 = regrow<u8>(move _1, const u64 4) #3:2;",
    "        _0 = const u64 4 #5:1;",
    "        dead(_4) #7:1;",
    "        dead(_1) #7:1;",
    "        return #7:1;",
    "    }",
    "}",
    // The result is an owner: a store of it over the local `t`, which holds an allocation, is an
    // overwrite.
    "fn main.over_full() -> u64 {",
    "    let _1 (s): u8 mut@ own;",
    "    let _2: u8 mut* own;",
    "    let _3: u8 mut@ own;",
    "    let _4 (t): u8 mut@ own;",
    "    let _5: u8 mut* own;",
    "    let _6: u8 mut@ own;",
    "    let _7: u8 mut* own;",
    "    let _8: u8 mut@ own;",
    "    bb0: {",
    "        _4 = const zero u8 mut@ own #1:2;",
    "        _1 = const zero u8 mut@ own #1:1;",
    "        live(_1) #1:1;",
    "        _2 = alloc<u8>(const u64 2) #2:1;",
    "        _3 = aggregate u8 mut@ own(move _2, const u64 2) #2:1;",
    "        check(overwrite: _1) -> bb1 #2:2;",
    "    }",
    "    bb1: {",
