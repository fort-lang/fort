// The operand is moved: a read of an element of the source after the `regrow` gives the error of
// rule (b) and the event `use after move`.
string[56] USES = {
    // The operand is moved: an element of `s` that the function reads after the `regrow` is a use
    // after a move.
    "fn main.use_direct() -> u64 {",
    "    let _1 (s): u8 mut@ own;",
    "    let _2: u8 mut* own;",
    "    let _3: u8 mut@ own;",
    "    let _4: u8 mut* own;",
    "    let _5: u8 mut@ own;",
    "    let _6: u64;",
    "    let _7: u8;",
    "    bb0: {",
    "        _1 = const zero u8 mut@ own #1:1;",
    "        live(_1) #1:1;",
    "        _2 = alloc<u8>(const u64 2) #2:1;",
    "        _3 = aggregate u8 mut@ own(move _2, const u64 2) #2:1;",
    "        check(overwrite: _1) -> bb1 #2:2;",
    "    }",
    "    bb1: {",
    "        _1 = move _3 #2:2;",
    "        _6 = const u64 0 #2:3;",
    "        _4 = regrow<u8>(move _1, const u64 4) #3:2;",
    "        _5 = aggregate u8 mut@ own(move _4, const u64 4) #3:2;",
    "        _7 = copy _1[_6] #4:1;",
    "        _0 = cast<u64>(copy _7) #5:1;",
    "        del(move _5) #6:1;",
    "        dead(_1) #7:1;",
    "        return #7:1;",
    "    }",
    "}",
    // The same read after the form of the lowering, which moves `s` into a temporary first.
    "fn main.use_lowered() -> u64 {",
    "    let _1 (s): u8 mut@ own;",
    "    let _2: u8 mut* own;",
    "    let _3: u8 mut@ own;",
    "    let _4: u8 mut* own;",
    "    let _5: u8 mut@ own;",
    "    let _6: u64;",
    "    let _7: u8;",
    "    let _8: u8 mut@ own;",
    "    bb0: {",
    "        _1 = const zero u8 mut@ own #1:1;",
    "        live(_1) #1:1;",
    "        _2 = alloc<u8>(const u64 2) #2:1;",
    "        _3 = aggregate u8 mut@ own(move _2, const u64 2) #2:1;",
    "        check(overwrite: _1) -> bb1 #2:2;",
    "    }",
    "    bb1: {",
    "        _1 = move _3 #2:2;",
    "        _6 = const u64 0 #2:3;",
    "        _8 = move _1 #3:1;",
    "        _4 = regrow<u8>(move _8, const u64 4) #3:2;",
    "        _5 = aggregate u8 mut@ own(move _4, const u64 4) #3:2;",
    "        _7 = copy _1[_6] #4:1;",
    "        _0 = cast<u64>(copy _7) #5:1;",
    "        del(move _5) #6:1;",
    "        dead(_1) #7:1;",
    "        return #7:1;",
    "    }",
    "}",
};

// A `regrow` ends no fact about a global, and a call ends it. The two functions differ in the one
// statement `call fn main.touch()`.
string[64] CALLS = {
    // A `regrow` is no call: the fact that the global `P` is empty holds after it, and the store
    // into `P` is proved.
    "fn main.no_call() -> u64 {",
    "    let _1 (s): u8 mut@ own;",
    "    let _2: u8 mut* own;",
    "    let _3: u8 mut@ own;",
    "    let _4: u8 mut* own;",
    "    let _5: u8 mut@ own;",
    "    let _6: u8 mut* own;",
    "    bb0: {",
    "        _1 = const zero u8 mut@ own #1:1;",
    "        live(_1) #1:1;",
    "        _2 = alloc<u8>(const u64 2) #2:1;",
    "        _3 = aggregate u8 mut@ own(move _2, const u64 2) #2:1;",
    "        check(overwrite: _1) -> bb1 #2:2;",
    "    }",
    "    bb1: {",
    "        _1 = move _3 #2:2;",
    "        del(move global main.P) #3:1;",
    "        _4 = regrow<u8>(move _1, const u64 4) #3:2;",
    "        _5 = aggregate u8 mut@ own(move _4, const u64 4) #3:2;",
    "        _6 = alloc<u8>(const u64 1) #4:1;",
    "        check(overwrite: global main.P) -> bb2 #4:2;",
    "    }",
    "    bb2: {",
    "        global main.P = move _6 #4:2;",
    "        del(move global main.P) #4:3;",
    "        _0 = copy _5.1 #5:1;",
    "        del(move _5) #6:1;",
    "        dead(_1) #7:1;",
    "        return #7:1;",
    "    }",
    "}",
    // The same function with a call after the `regrow`: the call ends the fact, and the store is
    // not proved.
    "fn main.call() -> u64 {",
    "    let _1 (s): u8 mut@ own;",
    "    let _2: u8 mut* own;",
    "    let _3: u8 mut@ own;",
    "    let _4: u8 mut* own;",
    "    let _5: u8 mut@ own;",
    "    let _6: u8 mut* own;",
    "    let _7: void;",
    "    bb0: {",
    "        _1 = const zero u8 mut@ own #1:1;",
    "        live(_1) #1:1;",
    "        _2 = alloc<u8>(const u64 2) #2:1;",
    "        _3 = aggregate u8 mut@ own(move _2, const u64 2) #2:1;",
    "        check(overwrite: _1) -> bb1 #2:2;",
    "    }",
    "    bb1: {",
    "        _1 = move _3 #2:2;",
    "        del(move global main.P) #3:1;",
    "        _4 = regrow<u8>(move _1, const u64 4) #3:2;",
    "        _5 = aggregate u8 mut@ own(move _4, const u64 4) #3:2;",
    "        _7 = call fn main.touch() #3:4;",
    "        _6 = alloc<u8>(const u64 1) #4:1;",
    "        check(overwrite: global main.P) -> bb2 #4:2;",
    "    }",
    "    bb2: {",
    "        global main.P = move _6 #4:2;",
    "        del(move global main.P) #4:3;",
    "        _0 = copy _5.1 #5:1;",
    "        del(move _5) #6:1;",
    "        dead(_1) #7:1;",
    "        return #7:1;",
    "    }",
    "}",
};

// The counts of the last line of the output.
struct tally {
    u64 cases;
    u64 proved;
    u64 refused;
    u64 events;
}

// The function `name` of `m`. run_env.function panics for a name that `m` lacks.
fn function(run_env.env* e, fir.module* m, string name) fir.func* {
    u64 mut k = 0;
    while (k + 1 < fir.module_function_count(m)) {
        if (fir.module_function_at(m, k)->sym == run_env.function(e, m, name)) {
            return fir.module_function_at(m, k);
        }
        k += 1;
    }
    return fir.module_function_at(m, k);
}

// Proves the function `name` of `m`, writes each line of the three reports as `<severity>
// <line>:<col>: <text>`, runs the function with the events of the shadow, and holds the lines of
// the prover and then the report of the run against `want`.
fn holds(run_env.env mut* e, fir.module* m, tally mut* t, string name, string@ want) void {
    strbuf.str_buf mut got = strbuf.create();
    defer del(got.data);
    u64[1] none = {0};
    fir.func* f = function(e, m, name);
    prover.proof mut* own p = prover.prove_made(f);
    defer prover.drop_made(move(p));
    u64 before = check_env.reports(&e->c);
    report.write(f, p, &e->c.m.s);
    report.write_leaks(f, p, &e->c.m.s);
    report.write_uses(f, p, &e->c.m.s);
    u64 after = check_env.reports(&e->c);
    u64 mut r = before;
    while (r < after) {
        strbuf.append(&got, check_env.report_severity(&e->c, r));
        strbuf.push(&got, ' ');
        strbuf.append(&got, check_env.report_text(&e->c, r));
        strbuf.push(&got, '\n');
        r += 1;
    }
    string run = run_env.run_in(e, m, name, none[..0]);
    t->cases += 1;
    if (after == before) {
        t->proved += 1;
    } else {
        t->refused += 1;
    }
    if (run.len >= 6 && run[0..6] == "event ") {
        t->events += 1;
    }
    strbuf.append(&got, run);
    run_env.expect(strbuf.view(&got), want);
}

fn legal(run_env.env mut* e, tally mut* t) void {
    // A new check drops the reports of the group before: a text parses against a check with no
    // report only.
    run_env.check(e, PRELUDE[..]);
    e->events = true;
    fir.module mut* own m = run_env.parse_made(e, LEGAL[..]);
    defer fir.module_drop_made(move(m));
    string[1] local = {
        "return u64 4",
    };
    holds(e, m, t, "main.local", local[..]);
    string[1] direct = {
        "return u64 4",
    };
    holds(e, m, t, "main.direct", direct[..]);
    string[1] field = {
        "return u64 4",
    };
    holds(e, m, t, "main.field", field[..]);
    string[1] global = {
        "return u64 4",
    };
    holds(e, m, t, "main.global", global[..]);
    string[1] twice = {
        "return u64 7",
    };
    holds(e, m, t, "main.twice", twice[..]);
}

fn results(run_env.env mut* e, tally mut* t) void {
    // A new check drops the reports of the group before: a text parses against a check with no
    // report only.
    run_env.check(e, PRELUDE[..]);
    e->events = true;
    fir.module mut* own m = run_env.parse_made(e, RESULTS[..]);
    defer fir.module_drop_made(move(m));
    string[4] leak = {
        "error 7:1: leak: cannot prove 't' is empty at this exit",
        "note 7:1: del or move 't' before this exit",
        "event leak in main.leak at 7:1",
        "return u64 4",
    };
    holds(e, m, t, "main.leak", leak[..]);
    string[4] dropped = {
        "error 7:1: leak: cannot prove '_5' is empty at this exit",
        "note 7:1: del or move '_5' before this exit",
        "event leak in main.dropped at 7:1",
        "return u64 4",
    };
    holds(e, m, t, "main.dropped", dropped[..]);
    string[4] bare = {
        "error 7:1: leak: cannot prove 'p' is empty at this exit",
        "note 7:1: del or move 'p' before this exit",
        "event leak in main.bare at 7:1",
        "return u64 4",
    };
    holds(e, m, t, "main.bare", bare[..]);
    string[4] over_full = {
        "error 4:3: overwriting owned value: cannot prove '_4' is empty here",
        "note 4:3: del or move '_4' before this store",
        "event overwrite in main.over_full at 4:3",
        "return u64 4",
    };
    holds(e, m, t, "main.over_full", over_full[..]);
    string[4] result_full = {
        "error 4:3: overwriting owned value: cannot prove '_1' is empty here",
        "note 4:3: del or move '_1' before this store",
        "event overwrite in main.result_full at 4:3",
        "return u64 1",
    };
    holds(e, m, t, "main.result_full", result_full[..]);
}

fn uses(run_env.env mut* e, tally mut* t) void {
    // A new check drops the reports of the group before: a text parses against a check with no
    // report only.
    run_env.check(e, PRELUDE[..]);
    e->events = true;
    fir.module mut* own m = run_env.parse_made(e, USES[..]);
    defer fir.module_drop_made(move(m));
    string[4] use_direct = {
        "error 4:1: use after move or del: 's' can be vacated here",
        "note 3:2: 's' is moved here",
        "event use after move in main.use_direct at 4:1 through moved main.use_direct _1",
        "fault null dereference at 4:1",
    };
    holds(e, m, t, "main.use_direct", use_direct[..]);
    string[4] use_lowered = {
        "error 4:1: use after move or del: 's' can be vacated here",
        "note 3:1: 's' is moved here",
        "event use after move in main.use_lowered at 4:1 through moved main.use_lowered _1",
        "fault null dereference at 4:1",
    };
    holds(e, m, t, "main.use_lowered", use_lowered[..]);
}

fn calls(run_env.env mut* e, tally mut* t) void {
    // A new check drops the reports of the group before: a text parses against a check with no
    // report only.
    run_env.check(e, PRELUDE[..]);
    e->events = true;
    fir.module mut* own m = run_env.parse_made(e, CALLS[..]);
    defer fir.module_drop_made(move(m));
    string[1] no_call = {
        "return u64 4",
    };
    holds(e, m, t, "main.no_call", no_call[..]);
    string[3] call = {
        "error 4:2: overwriting owned value: cannot prove 'global main.P' is empty here",
        "note 4:2: del or move 'global main.P' before this store",
        "return u64 4",
    };
    holds(e, m, t, "main.call", call[..]);
}

fn main() i32 {
    run_env.env mut* own e = run_env.make();
    defer run_env.drop_made(move(e));
    tally mut t = {};
    legal(e, &t);
    println("legal ok");
    results(e, &t);
    println("results ok");
    uses(e, &t);
    println("uses ok");
    calls(e, &t);
    println("calls ok");
    println("cases ", t.cases, " proved ", t.proved, " refused ", t.refused, " events ", t.events);
    return 0;
}
