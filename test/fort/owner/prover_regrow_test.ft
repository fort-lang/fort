    "        live(_4) #3:1;",
    "        _7 = alloc<u8>(const u64 1) #3:2;",
    "        _8 = aggregate u8 mut@ own(move _7, const u64 1) #3:2;",
    "        check(overwrite: _4) -> bb2 #3:3;",
    "    }",
    "    bb2: {",
    "        _4 = move _8 #3:3;",
