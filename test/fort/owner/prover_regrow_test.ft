    "        dead(_4) #7:1;",
    "        dead(_1) #7:1;",
    "        return #7:1;",
    "    }",
    "}",
    // The local that holds the result is full: a store of a `new` over it is an overwrite.
    "fn main.result_full() -> u64 {",
    "    let _1 (s): u8 mut@ own;",
    "    let _2: u8 mut* own;",
    "    let _3: u8 mut@ own;",
    "    let _4: u8 mut* own;",
    "    let _5: u8 mut@ own;",
    "    let _6: u8 mut* own;",
    "    let _7: u8 mut@ own;",
    "    bb0: {",
    "        _1 = const zero u8 mut@ own #1:1;",
    "        live(_1) #1:1;",
    "        _2 = alloc<u8>(const u64 2) #2:1;",
    "        _3 = aggregate u8 mut@ own(move _2, const u64 2) #2:1;",
    "        check(overwrite: _1) -> bb1 #2:2;",
    "    }",
    "    bb1: {",
    "        _1 = move _3 #2:2;",
    "        _4 = regrow<u8>(move _1, const u64 4) #3:2;",
    "        _5 = aggregate u8 mut@ own(move _4, const u64 4) #3:2;",
