//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: summary.add: a second function with the symbol of a node
//! stdout:
//| 1
/// Each function of a unit has its own symbol (D9.7), so owner.summary.add takes a function once.
/// The test adds one function and then the same function again, which breaks the precondition.
import fort.fir;
import lower_env;
import fort.owner.summary;
import pass_env;

string[1] PRELUDE = {
    "i32 UNUSED = 0;",
};

string[5] ONE = {
    "fn main.one() -> void {",
    "    bb0: {",
    "        return;",
    "    }",
    "}",
};

fn main() i32 {
    lower_env.env mut* own e = lower_env.make();
    defer lower_env.drop_made(move(e));
    fir.module mut* own m = fir.module_make();
    *m = pass_env.parse(e, PRELUDE[..], ONE[..]);
    defer fir.module_drop_made(move(m));
    summary.graph mut* own g = summary.make();
    defer summary.drop_made(move(g));
    summary.add(g, fir.module_function_at(m, 0), 1);
    println(summary.node_count(g));
    summary.add(g, fir.module_function_at(m, 0), 1);
    return 0;
}
