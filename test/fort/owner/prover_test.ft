string[7] STRAIGHT_VERDICTS = {"PP/U", "PP/U", "U/P", "U/U", "P/PPU", "U/U", "P/U"};

// A check takes the verdict of each store that it guards: each store into its place that a path
// from the check reaches before another store into that place (spec/fir.md 11, Proof). A check
// also keeps the test of its own place at its end.
string[333] GUARDS = {
    // a statement between a check and its store, which a call fills, so the check takes the verdict
    // of the store: U/U
    "fn main.gu1(_1 (b): node mut*) -> void {",
    "    let _2: u64;",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        _2 = const u64 0;",
    "        (*_1).0 = call fn main.fill(copy _1);",
    "        return;",
    "    }",
    "}",
    // a `goto` between a check and its store, which a call fills: U/U
    "fn main.gu2(_1 (b): node mut*) -> void {",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        goto bb2;",
    "    }",
    "    bb2: {",
    "        (*_1).0 = call fn main.fill(copy _1);",
    "        return;",
    "    }",
    "}",
    // a `goto` between a check and its store, which the pass proves: P/PP
    "fn main.gu3(_1 (b): node mut*) -> void {",
    "    let _2: node mut* own;",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        _2 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        goto bb2;",
    "    }",
    "    bb2: {",
    "        (*_1).0 = move _2;",
    "        return;",
    "    }",
    "}",
    // two paths from the check to two stores, and a call fills the place on one of them: U/PPU
    "fn main.gu4(_1 (b): node mut*, _2 (c): bool) -> void {",
    "    let _3: node mut* own;",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        switch(copy _2) -> [true: bb2, otherwise: bb3];",
    "    }",
    "    bb2: {",
    "        (*_1).0 = move _3;",
    "        return;",
    "    }",
    "    bb3: {",
    "        (*_1).0 = call fn main.fill(copy _1);",
    "        del(move _3);",
    "        return;",
    "    }",
    "}",
    // the walk stops at the first store into the place, so the check does not guard the second
    // store, which finds the allocation of the first: P/PPU
    "fn main.gu5(_1 (b): node mut*) -> void {",
    "    let _2: node mut* own;",
    "    let _3: node mut* own;",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        _2 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_1).0 = move _2;",
    "        _3 = alloc<node>(const u64 1);",
    "        (*_1).0 = move _3;",
    "        return;",
    "    }",
    "}",
    // a loop after the check with no store: the walk enters each block once, and the check keeps
    // the test of its own place: P
    "fn main.gu6(_1 (b): node mut*, _2 (c): bool) -> void {",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        goto bb2;",
    "    }",
    "    bb2: {",
    "        switch(copy _2) -> [true: bb2, otherwise: bb3];",
    "    }",
    "    bb3: {",
    "        return;",
    "    }",
    "}",
    // a `del` between the check and its store: the pass proves the store, and the check keeps the
    // test of its own place, which a parameter fails: U/PP
    "fn main.gu7(_1 (b): node mut*) -> void {",
    "    let _2: node mut* own;",
    "    bb0: {",
    "        _2 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        del(move (*_1).0);",
    "        (*_1).0 = move _2;",
    "        return;",
    "    }",
    "}",
    // a store into a temporary that is memory right after a check of it needs a proof, and the call
    // kills the fact of a memory local: U/P
    "fn main.gu8() -> void {",
    "    let _1: node mut* own;",
    "    let _2: node mut* own*;",
    "    bb0: {",
    "        _1 = const zero node mut* own;",
    "        _2 = addr(_1);",
    "        check(overwrite: _1) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1 = call fn main.make();",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // two checks guard one store, which a call fills: UU/U
    "fn main.gu9(_1 (b): node mut*, _2 (c): bool) -> void {",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        switch(copy _2) -> [true: bb1, otherwise: bb2];",
    "    }",
    "    bb1: {",
    "        check(overwrite: (*_1).0) -> bb3;",
    "    }",
    "    bb2: {",
    "        check(overwrite: (*_1).0) -> bb4;",
    "    }",
    "    bb3: {",
    "        goto bb5;",
    "    }",
    "    bb4: {",
    "        goto bb5;",
    "    }",
    "    bb5: {",
    "        (*_1).0 = call fn main.fill(copy _1);",
    "        return;",
    "    }",
    "}",
    // the walk follows the edge that a constant `switch` prunes (rule V9), so the check guards the
    // store there, which a call fills: U/U
    "fn main.gu10(_1 (b): node mut*) -> void {",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        switch(const true) -> [true: bb2, otherwise: bb3];",
    "    }",
    "    bb2: {",
    "        return;",
    "    }",
    "    bb3: {",
    "        (*_1).0 = call fn main.fill(copy _1);",
    "        return;",
    "    }",
    "}",
    // a loop leads from the continuation back to the check: the walk enters each block once and
    // ends at the store on the other edge, which the pass proves: P/PP
    "fn main.gu11(_1 (b): node mut*, _2 (c): bool) -> void {",
    "    let _3: node mut* own;",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        goto bb1;",
    "    }",
    "    bb1: {",
    "        check(overwrite: (*_1).0) -> bb2;",
    "    }",
    "    bb2: {",
    "        switch(copy _2) -> [true: bb3, otherwise: bb4];",
    "    }",
    "    bb3: {",
    "        goto bb1;",
    "    }",
    "    bb4: {",
    "        _3 = alloc<node>(const u64 1);",
    "        (*_1).0 = move _3;",
    "        return;",
    "    }",
    "}",
    // a store through another index temporary with the same key writes the element of the check,
    // but a check guards only a store into its own FIR place, so the store needs a proof of its
    // own: P/PP
    "fn main.gu12() -> void {",
    "    let _1 (a): node mut* own[2];",
    "    let _2 (k): u64;",
    "    let _3: u64;",
    "    let _4: u64;",
    "    let _5: node mut* own;",
    "    bb0: {",
    "        _2 = const u64 0;",
    "        _1 = const zero node mut* own[2];",
    "        _3 = copy _2;",
    "        _4 = copy _2;",
    "        _5 = alloc<node>(const u64 1);",
    "        check(overwrite: _1[_3]) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1[_4] = move _5;",
    "        return;",
    "    }",
    "}",
    // a store through an address of the place of the check is no store into its FIR place, and an
    // address with no check of its own is no held address, so the store has no fact: P/PU
    "fn main.gu13(_1 (b): node mut*) -> void {",
    "    let _2: node mut* own mut*;",
    "    let _3: node mut* own;",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        _2 = addr mut((*_1).0);",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_2) = move _3;",
    "        return;",
    "    }",
    "}",
    // a held address and a call between its check and its store: the call makes the address stale,
    // and the store reads its place with the stale set before it: U/PU
    "fn main.gu14(_1 (b): node mut*) -> void {",
    "    let _2: node mut* own mut*;",
    "    let _3: void;",
    "    let _4: node mut* own;",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        _2 = addr mut((*_1).0);",
    "        _4 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_2)) -> bb1;",
    "    }",
    "    bb1: {",
    "        _3 = call fn main.g();",
    "        (*_2) = move _4;",
    "        return;",
    "    }",
    "}",
    // a held address and a statement that writes no memory between its check and its store: the
    // address stays held, and the store reads `(*_2)` as `(*_1).0`: P/PP
    "fn main.gu15(_1 (b): node mut*) -> void {",
    "    let _2: node mut* own mut*;",
    "    let _3: u64;",
    "    let _4: node mut* own;",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        _2 = addr mut((*_1).0);",
    "        _4 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_2)) -> bb1;",
    "    }",
    "    bb1: {",
    "        _3 = const u64 0;",
    "        (*_2) = move _4;",
    "        return;",
    "    }",
    "}",
    // p1 of the review: a check of a temporary that is memory, then a call that fills the temporary
    // through its address, then its store: the store needs a proof, which the call kills: U/PPU
    "fn main.gu16() -> void {",
    "    let _1: node mut* own;",
    "    let _2: node mut* own mut*;",
    "    let _3: void;",
    "    let _4: node mut* own;",
    "    bb0: {",
    "        _1 = const zero node mut* own;",
    "        _2 = addr mut(_1);",
    "        _4 = alloc<node>(const u64 1);",
    "        check(overwrite: _1) -> bb1;",
    "    }",
    "    bb1: {",
    "        _3 = call fn main.put(copy _2);",
    "        _1 = move _4;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // p2 of the review: the same through `_0`, which is no aggregate, so its stores need a proof:
    // its empty start proves the first, and the call kills the fact of the second: U/PPU
    "fn main.gu17() -> node mut* own {",
    "    let _1: node mut* own mut*;",
    "    let _2: void;",
    "    let _3: node mut* own;",
    "    bb0: {",
    "        _0 = const zero node mut* own;",
    "        _1 = addr mut(_0);",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: _0) -> bb1;",
    "    }",
    "    bb1: {",
    "        _2 = call fn main.put(copy _1);",
    "        _0 = move _3;",
    "        return;",
    "    }",
    "}",
    // p3 of the review: p1 with a `goto` between the check and the call: U/PPU
    "fn main.gu18() -> void {",
    "    let _1: node mut* own;",
    "    let _2: node mut* own mut*;",
    "    let _3: void;",
    "    let _4: node mut* own;",
    "    bb0: {",
    "        _1 = const zero node mut* own;",
    "        _2 = addr mut(_1);",
    "        _4 = alloc<node>(const u64 1);",
    "        check(overwrite: _1) -> bb1;",
    "    }",
    "    bb1: {",
    "        goto bb2;",
    "    }",
    "    bb2: {",
    "        _3 = call fn main.put(copy _2);",
    "        _1 = move _4;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // g1 of the review: a check of a field of an aggregate `_0`, whose store needs no proof, and a
    // call that fills that field through its address: the check guards a store with no proof: U/P
    "fn main.gu19() -> pair {",
    "    let _1: node mut* own mut*;",
    "    let _2: void;",
    "    let _3: node mut* own;",
    "    bb0: {",
    "        _0 = const zero pair;",
    "        _1 = addr mut(_0.0);",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: _0.0) -> bb1;",
    "    }",
    "    bb1: {",
    "        _2 = call fn main.put(copy _1);",
    "        _0.0 = move _3;",
    "        return;",
    "    }",
    "}",
    // g2 of the review: an `_0` that is no aggregate and is memory, and a call on one of two paths
    // to its store, which kills its fact there: U/PPU
    "fn main.gu20(_1 (c): bool) -> node mut* own {",
    "    let _2: node mut* own mut*;",
    "    let _3: void;",
    "    let _4: node mut* own;",
    "    bb0: {",
    "        _0 = const zero node mut* own;",
    "        _2 = addr mut(_0);",
    "        _4 = alloc<node>(const u64 1);",
    "        check(overwrite: _0) -> bb1;",
    "    }",
    "    bb1: {",
    "        switch(copy _1) -> [true: bb2, otherwise: bb3];",
    "    }",
    "    bb2: {",
    "        _3 = call fn main.put(copy _2);",
    "        goto bb3;",
    "    }",
    "    bb3: {",
    "        _0 = move _4;",
    "        return;",
    "    }",
    "}",
};

