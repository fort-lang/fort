// The first statement of the continuation block of a check runs after the check and before the
// store writes. The store takes each kill rule of each statement before it, and the kill of its
// own call, before its test, and the check takes the verdict of the store (spec/fir.md 11,
// Proof). A store into another place than the place of the check has a verdict of its own.
string[266] AFTER_CHECK = {
    // a call into the place of the check through a fresh pointer: U
    "fn main.cs1() -> void {",
    "    let _1 (n): node mut* own;",
    "    let _2: node mut* own;",
    "    bb0: {",
    "        _1 = const zero node mut* own;",
    "        _2 = alloc<node>(const u64 1);",
    "        _1 = move _2;",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_1).0 = call fn main.fill(copy _1);",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // a call into a local that is no memory, which no call can fill: P
    "fn main.cs2() -> void {",
    "    let _1 (p): node mut* own;",
    "    bb0: {",
    "        _1 = const zero node mut* own;",
    "        check(overwrite: _1) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1 = call fn main.make();",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // a call into a held address: U
    "fn main.cs3(_1 (b): node mut*) -> void {",
    "    let _2: node mut* own mut*;",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        _2 = addr mut((*_1).0);",
    "        check(overwrite: (*_2)) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_2) = call fn main.fill(copy _1);",
    "        return;",
    "    }",
    "}",
    // a call into a temporary, and then the store of the check: U
    "fn main.cs4(_1 (b): node mut*) -> void {",
    "    let _2: node mut* own;",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        _2 = call fn main.fill(copy _1);",
    "        (*_1).0 = move _2;",
    "        return;",
    "    }",
    "}",
    // a call into a global: U
    "fn main.cs5() -> void {",
    "    bb0: {",
    "        del(move global main.G);",
    "        check(overwrite: global main.G) -> bb1;",
    "    }",
    "    bb1: {",
    "        global main.G = call fn main.make();",
    "        return;",
    "    }",
    "}",
    // a call into a memory local: U
    "fn main.cs6() -> void {",
    "    let _1 (p): node mut* own;",
    "    let _2: node mut* own*;",
    "    bb0: {",
    "        _1 = const zero node mut* own;",
    "        _2 = addr(_1);",
    "        check(overwrite: _1) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1 = call fn main.make();",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // a continuation block with no statement: P
    "fn main.cs7(_1 (b): node mut*) -> void {",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        return;",
    "    }",
    "}",
    // the store of the check comes first, and a call follows it: P
    "fn main.cs8(_1 (b): node mut*) -> void {",
    "    let _2: node mut* own;",
    "    let _3: void;",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        _2 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_1).0 = move _2;",
    "        _3 = call fn main.g();",
    "        return;",
    "    }",
    "}",
    // two checks, and the call follows only the second: PU
    "fn main.cs9(_1 (b): node mut*) -> void {",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        del(move (*_1).1);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        check(overwrite: (*_1).1) -> bb2;",
    "    }",
    "    bb2: {",
    "        (*_1).1 = call fn main.fill(copy _1);",
    "        return;",
    "    }",
    "}",
    // a call into the whole local, and then the store into its field: U
    "fn main.cs10() -> void {",
    "    let _1 (s): pair;",
    "    let _2: node mut* own;",
    "    bb0: {",
    "        _1 = const zero pair;",
    "        _2 = alloc<node>(const u64 1);",
    "        check(overwrite: _1.0) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1 = call fn main.make_pair();",
    "        _1.0 = move _2;",
    "        return;",
    "    }",
    "}",
    // a call into the key of the place, and then the store: U
    "fn main.cs11() -> void {",
    "    let _1 (a): node mut* own[2];",
    "    let _2 (k): u64;",
    "    let _3: node mut* own;",
    "    bb0: {",
    "        _2 = const u64 0;",
    "        _1 = const zero node mut* own[2];",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: _1[_2]) -> bb1;",
    "    }",
    "    bb1: {",
    "        _2 = call fn main.pick();",
    "        _1[_2] = move _3;",
    "        return;",
    "    }",
    "}",
    // a store of a constant into the key, with no call: U
    "fn main.cs12() -> void {",
    "    let _1 (a): node mut* own[2];",
    "    let _2 (k): u64;",
    "    let _3: node mut* own;",
    "    bb0: {",
    "        _2 = const u64 0;",
    "        _1 = const zero node mut* own[2];",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: _1[_2]) -> bb1;",
    "    }",
    "    bb1: {",
    "        _2 = const u64 1;",
    "        _1[_2] = move _3;",
    "        return;",
    "    }",
    "}",
    // a store into a separate field through the same pointer: P
    "fn main.cs13(_1 (b): node mut*, _2 (x): node mut* own) -> void {",
    "    let _3: node mut* own;",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_1).1 = move _2;",
    "        (*_1).0 = move _3;",
    "        return;",
    "    }",
    "}",
    // a store through another pointer, which can hold the value of `_1`: U
    "fn main.cs14(_1 (b): node mut*, _2 (c): node mut*, _3 (x): node mut* own) -> void {",
    "    let _4: node mut* own;",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        _4 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_2).1 = move _3;",
    "        (*_1).0 = move _4;",
    "        return;",
    "    }",
    "}",
    // a del, which has no kill rule: P
    "fn main.cs15(_1 (b): node mut*) -> void {",
    "    let _2: node mut* own;",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        _2 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        del(move (*_1).1);",
    "        (*_1).0 = move _2;",
    "        return;",
    "    }",
    "}",
    // an extern call into a temporary: U
    "fn main.cs16(_1 (b): node mut*) -> void {",
    "    let _2: i32;",
    "    let _3: node mut* own;",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        _2 = call extern ext_touch(copy _1);",
    "        (*_1).0 = move _3;",
    "        return;",
    "    }",
    "}",
    // a call through a function value into the place of the check: U
    "fn main.cs17(_1 (b): node mut*) -> void {",
    "    let _2: fn (node mut*) node mut* own;",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        _2 = const fn main.fill;",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_1).0 = call copy _2(copy _1);",
    "        return;",
    "    }",
    "}",
    // a call with a `void` result: U
    "fn main.cs18(_1 (b): node mut*) -> void {",
    "    let _2: void;",
    "    let _3: node mut* own;",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        _2 = call fn main.poke(copy _1);",
    "        (*_1).0 = move _3;",
    "        return;",
    "    }",
    "}",
    // the store into the place of the check through another temporary with the same key, so the
    // store keeps its kill rules for after the test: P
    "fn main.cs19() -> void {",
    "    let _1 (a): node mut* own[2];",
    "    let _2 (k): u64;",
    "    let _3: u64;",
    "    let _4: u64;",
    "    bb0: {",
    "        _2 = const u64 0;",
    "        _1 = const zero node mut* own[2];",
    "        _3 = copy _2;",
    "        _4 = copy _2;",
    "        check(overwrite: _1[_3]) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1[_4] = call fn main.make();",
    "        return;",
    "    }",
    "}",
    // a store into an element through the same pointer whose index can equal the index of the
    // check: the check guards no store and its place keeps its fact, so the check is proved, and
    // the store needs a fact of its own place, which no rule gives: P/U
    "fn main.cs20(_1 (v): node mut* own[2] mut*, _2 (i): u64, _3 (j): u64) -> void {",
    "    let _4: node mut* own;",
    "    bb0: {",
    "        del(move (*_1)[_2]);",
    "        _4 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1)[_2]) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_1)[_3] = move _4;",
    "        return;",
    "    }",
    "}",
};

string[20] AFTER_CHECK_VERDICTS = {
    "U/PP", "P", "U", "U/PU", "U", "U", "P", "P/P", "PU", "U/PU", "U/PU", "U/PU", "P/PUP", "U/PUU",
    "P/PP", "U/PU", "U", "U/PU", "P/P", "P/PU",
};

// A global is a tracked place with no fact at the entry.
string[30] GLOBALS = {
    // del of the global: P
    "fn main.g1(_1 (x): node mut* own) -> void {",
    "    bb0: {",
    "        del(move global main.G);",
    "        check(overwrite: global main.G) -> bb1;",
    "    }",
    "    bb1: {",
    "        global main.G = move _1;",
    "        return;",
    "    }",
    "}",
    // no del: a global has no fact at the entry: U
    "fn main.g2(_1 (x): node mut* own) -> void {",
    "    bb0: {",
    "        check(overwrite: global main.G) -> bb1;",
    "    }",
    "    bb1: {",
    "        global main.G = move _1;",
    "        return;",
    "    }",
    "}",
    // a store into another global keeps the fact: P
    "fn main.g3(_1 (x): node mut* own, _2 (y): node mut* own) -> void {",
    "    bb0: {",
    "        del(move global main.G);",
    "        global main.H = move _2;",
    "        check(overwrite: global main.G) -> bb1;",
    "    }",
    "    bb1: {",
    "        global main.G = move _1;",
    "        return;",
    "    }",
    "}",
};

string[3] GLOBALS_VERDICTS = {"P", "U", "P/U"};

// A held address `(*_a)` reads as the place of its `addr mut`.
string[128] HELD = {
    // del(b->items); b->items = new(...): P
    "fn main.h1(_1 (b): node mut*) -> void {",
    "    let _2: node mut* own mut*;",
    "    let _3: node mut* own;",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        _2 = addr mut((*_1).0);",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_2)) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_2) = move _3;",
    "        return;",
    "    }",
    "}",
    // no del: U
    "fn main.h2(_1 (b): node mut*) -> void {",
    "    let _2: node mut* own mut*;",
    "    let _3: node mut* own;",
    "    bb0: {",
    "        _2 = addr mut((*_1).0);",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_2)) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_2) = move _3;",
    "        return;",
    "    }",
    "}",
    // a third read of the address: U
    "fn main.h3(_1 (b): node mut*) -> void {",
    "    let _2: node mut* own mut*;",
    "    let _3: node mut* own;",
    "    let _4: node mut* own mut*;",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        _2 = addr mut((*_1).0);",
    "        _4 = copy _2;",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_2)) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_2) = move _3;",
    "        return;",
    "    }",
    "}",
    // the held store kills as a store into its place: PU
    "fn main.h4(_1 (b): node mut*) -> void {",
    "    let _2: node mut* own mut*;",
    "    let _3: node mut* own;",
    "    let _4: node mut* own;",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        _2 = addr mut((*_1).0);",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_2)) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_2) = move _3;",
    "        _4 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).0) -> bb2;",
    "    }",
    "    bb2: {",
    "        (*_1).0 = move _4;",
    "        return;",
    "    }",
    "}",
    // n->next = move(l->head); l->head = move(n): the held address ends no freshness: PPP
    "fn main.h5(_1 (l): node mut*) -> void {",
    "    let _2 (n): node mut* own;",
    "    let _3: node mut* own;",
    "    let _4: node mut* own mut*;",
    "    let _5: node mut* own;",
    "    let _6: node mut* own mut*;",
    "    let _7: node mut* own;",
    "    bb0: {",
    "        _2 = const zero node mut* own;",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: _2) -> bb1;",
    "    }",
    "    bb1: {",
    "        _2 = move _3;",
    "        _4 = addr mut((*_2).1);",
    "        _5 = move (*_1).0;",
    "        check(overwrite: (*_4)) -> bb2;",
    "    }",
    "    bb2: {",
    "        (*_4) = move _5;",
    "        _6 = addr mut((*_1).0);",
    "        _7 = move _2;",
    "        check(overwrite: (*_6)) -> bb3;",
    "    }",
    "    bb3: {",
    "        (*_6) = move _7;",
    "        return;",
    "    }",
    "}",
    // an address of a field of a local is no held address, so the check reads `(*_2)`, which no
