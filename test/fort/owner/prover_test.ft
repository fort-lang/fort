// A store straight into a memory local or a global keeps the facts of other locals and globals,
// and kills each fact through a pointer that can hold its address.
string[106] STRAIGHT = {
    // into a memory local: the facts of another memory local and of a global stay: PP
    "fn main.k1(_1 (v): node mut* own) -> void {",
    "    let _2 (x): node;",
    "    let _3 (y): node;",
    "    let _4: node*;",
    "    let _5: node*;",
    "    bb0: {",
    "        _4 = addr(_2);",
    "        _5 = addr(_3);",
    "        _3 = const zero node;",
    "        del(move global main.G);",
    "        _2.1 = move _1;",
    "        check(overwrite: _3.0) -> bb1;",
    "    }",
    "    bb1: {",
    "        check(overwrite: global main.G) -> bb2;",
    "    }",
    "    bb2: {",
    "        return;",
    "    }",
    "}",
    // into a global: the facts of another global and of a memory local stay: PP
    "fn main.k2(_1 (v): node mut* own) -> void {",
    "    let _2 (y): node;",
    "    let _3: node*;",
    "    bb0: {",
    "        _3 = addr(_2);",
    "        _2 = const zero node;",
    "        del(move global main.G);",
    "        global main.H = move _1;",
    "        check(overwrite: _2.0) -> bb1;",
    "    }",
    "    bb1: {",
    "        check(overwrite: global main.G) -> bb2;",
    "    }",
    "    bb2: {",
    "        return;",
    "    }",
    "}",
    // into a memory local: a fact through a pointer that holds its address dies: U
    "fn main.k3(_1 (v): node mut* own) -> void {",
    "    let _2 (x): node;",
    "    let _3: node mut*;",
    "    bb0: {",
    "        _2 = const zero node;",
    "        _3 = addr mut(_2);",
    "        del(move (*_3).0);",
    "        _2.0 = move _1;",
    "        check(overwrite: (*_3).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        return;",
    "    }",
    "}",
    // into a global: a fact through a pointer that holds its address dies: U
    "fn main.k4(_1 (v): node mut* own) -> void {",
    "    let _2: node mut* own mut*;",
    "    bb0: {",
    "        _2 = addr mut(global main.G);",
    "        del(move (*_2));",
    "        global main.G = move _1;",
    "        check(overwrite: (*_2)) -> bb1;",
    "    }",
    "    bb1: {",
    "        return;",
    "    }",
    "}",
    // into a memory local: a fact through a fresh pointer stays: P
    "fn main.k5(_1 (v): node mut* own) -> void {",
    "    let _2 (x): node;",
    "    let _3: node*;",
    "    let _4 (n): node mut* own;",
    "    let _5: node mut* own;",
    "    bb0: {",
    "        _3 = addr(_2);",
    "        _4 = const zero node mut* own;",
    "        _5 = alloc<node>(const u64 1);",
    "        _4 = move _5;",
    "        _2.1 = move _1;",
    "        check(overwrite: (*_4).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        del(move _4);",
    "        return;",
    "    }",
    "}",
    // into a memory local: an element of the `own` span of another local stays, because the
    // element lies in an allocation and in no frame: P
    "fn main.k6(_1 (v): node mut* own, _2 (k): u64) -> void {",
    "    let _3 (x): node;",
    "    let _4: node*;",
    "    let _5 (y): node;",
    "    bb0: {",
    "        _4 = addr(_3);",
    "        del(move _5.3[_2]);",
    "        _3.1 = move _1;",
    "        check(overwrite: _5.3[_2]) -> bb1;",
    "    }",
    "    bb1: {",
    "        return;",
    "    }",
    "}",
    // into a local that is no memory: a fact through a pointer stays: P
    "fn main.k7(_1 (v): node mut* own, _2 (b): node mut*) -> void {",
    "    let _3 (x): node;",
    "    bb0: {",
    "        del(move (*_2).0);",
    "        _3.1 = move _1;",
    "        check(overwrite: (*_2).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        return;",
    "    }",
    "}",
};

string[7] STRAIGHT_VERDICTS = {"PP/U", "PP/U", "U/P", "U/U", "P/PPU", "P/U", "P/U"};

// A check takes the verdict of each store that it guards: each store into its place that a path
// from the check reaches before another store into that place (spec/fir.md 11, Proof). A check
// also keeps the test of its own place at its end.
string[333] GUARDS = {
    // a statement between a check and its store, which a call fills, so the check takes the verdict
    // of the store: U/U
    "fn main.gu1(_1 (b): node mut*) -> void {",
    "    let _2: u64;",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        _2 = const u64 0;",
    "        (*_1).0 = call fn main.fill(copy _1);",
    "        return;",
    "    }",
    "}",
    // a `goto` between a check and its store, which a call fills: U/U
    "fn main.gu2(_1 (b): node mut*) -> void {",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        goto bb2;",
    "    }",
    "    bb2: {",
    "        (*_1).0 = call fn main.fill(copy _1);",
    "        return;",
    "    }",
    "}",
    // a `goto` between a check and its store, which the pass proves: P/PP
    "fn main.gu3(_1 (b): node mut*) -> void {",
    "    let _2: node mut* own;",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        _2 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        goto bb2;",
    "    }",
    "    bb2: {",
    "        (*_1).0 = move _2;",
    "        return;",
    "    }",
    "}",
    // two paths from the check to two stores, and a call fills the place on one of them: U/PPU
    "fn main.gu4(_1 (b): node mut*, _2 (c): bool) -> void {",
    "    let _3: node mut* own;",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        switch(copy _2) -> [true: bb2, otherwise: bb3];",
    "    }",
    "    bb2: {",
    "        (*_1).0 = move _3;",
    "        return;",
    "    }",
    "    bb3: {",
    "        (*_1).0 = call fn main.fill(copy _1);",
    "        del(move _3);",
    "        return;",
    "    }",
    "}",
    // the walk stops at the first store into the place, so the check does not guard the second
    // store, which finds the allocation of the first: P/PPU
    "fn main.gu5(_1 (b): node mut*) -> void {",
    "    let _2: node mut* own;",
    "    let _3: node mut* own;",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        _2 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_1).0 = move _2;",
    "        _3 = alloc<node>(const u64 1);",
    "        (*_1).0 = move _3;",
    "        return;",
    "    }",
    "}",
    // a loop after the check with no store: the walk enters each block once, and the check keeps
    // the test of its own place: P
    "fn main.gu6(_1 (b): node mut*, _2 (c): bool) -> void {",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        goto bb2;",
    "    }",
    "    bb2: {",
    "        switch(copy _2) -> [true: bb2, otherwise: bb3];",
    "    }",
    "    bb3: {",
    "        return;",
    "    }",
    "}",
    // a `del` between the check and its store: the pass proves the store, and the check keeps the
    // test of its own place, which a parameter fails: U/PP
    "fn main.gu7(_1 (b): node mut*) -> void {",
    "    let _2: node mut* own;",
    "    bb0: {",
    "        _2 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
