    "        del(move (*_1).0);",
    "        goto bb4;",
    "    }",
    "    bb4: {",
    "        check(overwrite: (*_1).0) -> bb5;",
    "    }",
    "    bb5: {",
    "        return;",
    "    }",
    "}",
    // a switch of three arms, one with no del: U
    "fn main.l7(_1 (b): node mut*, _2 (k): i32) -> void {",
