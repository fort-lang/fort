string[27] NEEDS_VERDICTS = {
    "/PPP", "/UU", "/U", "/U", "/U", "/PP", "/PP", "/U", "/PP", "/P", "/P", "/PP", "P/P", "", "/U",
    "/PP", "/U", "/PU", "/U", "P/PP", "/PU", "/PPPP", "/PPU", "P/P", "/PPU", "/PPPPU",
    "/PPPU",
};

// No block.
u32 NO_BLOCK = 4294967295;

// The block of the check that stands right before the store `st` of `f`: a check whose
// continuation block starts with `st` and whose place is the place of `st`. NO_BLOCK for none.
fn check_before(fir.func* f, prover.store* st) u32 {
    if (st->index != 0) {
        return NO_BLOCK;
    }
    fir.place written = fir.block_statement(f, st->block, 0)->place;
    u32 mut b = 0;
    while (b < fir.block_count(f)) {
        fir.terminator* t = &fir.block_at(f, b)->term;
        if (t->kind == fir.term_kind.tk_check_overwrite && t->target == st->block
            && fir.is_same_place(f, t->place, written)) {
            return b;
        }
        b += 1;
    }
    return NO_BLOCK;
}

// Writes the verdict of each check of `f` into `out`, in block order: `P` for a check that `p`
// proves, and `U` for one that it does not prove. Then, after a `/`, the verdict of each store of
// `p` that no check stands right before, in block order. A check guards the store that stands
// right after it, so the test holds that such a store is proved when its check is. Holds the two
// counts of `p` against the verdicts.
fn write_verdicts(fir.func* f, prover.proof* p, strbuf.str_buf mut* out) void {
    strbuf.clear(out);
    u32 mut unproved = 0;
    u32 mut b = 0;
    while (b < fir.block_count(f)) {
        if (fir.block_at(f, b)->term.kind == fir.term_kind.tk_check_overwrite) {
            if (prover.is_proved(p, b)) {
                strbuf.push(out, 'P');
            } else {
                strbuf.push(out, 'U');
                unproved += 1;
            }
        } else {
            assert(prover.is_proved(p, b));
        }
        b += 1;
    }
    assert(cast(p->checks, u64) == strbuf.view(out).len);
    bool mut alone = false;
    u64 mut k = 0;
    while (k < p->stores.len) {
        prover.store* st = &p->stores[k];
        if (!st->proved) {
            unproved += 1;
        }
        u32 check = check_before(f, st);
        if (check != NO_BLOCK) {
            assert(!prover.is_proved(p, check) || st->proved);
        } else {
            if (!alone) {
                strbuf.push(out, '/');
                alone = true;
            }
            if (st->proved) {
                strbuf.push(out, 'P');
            } else {
                strbuf.push(out, 'U');
            }
        }
        k += 1;
    }
    assert(p->unproved == unproved);
}

// Parses `text` against PRELUDE, holds that the verifier accepts each function, proves each one,
// and holds that function `k` of the module gives the verdicts `want[k]`.
fn expect(string@ text, string@ want) void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    fir.module mut m = pass_env.parse(&e, PRELUDE[..], text);
    defer fir.module_free(&m);
    assert(m.funcs.len == want.len);
    strbuf.str_buf mut got = strbuf.create();
    defer strbuf.free(&got);
    u64 mut k = 0;
    while (k < m.funcs.len) {
        fir.func* f = &m.funcs.items[k];
        pass_env.verified(&e, f, "prover_test: the verifier refuses the input");
        prover.proof mut p = prover.prove(f);
        write_verdicts(f, &p, &got);
        prover.free(&p);
        if (strbuf.view(&got) != want[k]) {
            eprintln("function ", k, " gives ", strbuf.view(&got), " and not ", want[k]);
            panic("prover_test: a verdict differs");
        }
        k += 1;
    }
}

// ---- one test for each group --------------------------------------------------------------

// The store of the zero value in the entry block makes a named local empty.
fn the_entry_store_makes_a_named_local_empty() void {
    expect(ENTRY[..], ENTRY_VERDICTS[..]);
}

// `del(move p)` makes `p` empty, and only `p`.
fn del_makes_its_place_empty() void {
    expect(DEL[..], DEL_VERDICTS[..]);
}

// A `move` operand makes its place and each tracked place below it empty.
fn a_move_makes_its_place_and_each_place_below_it_empty() void {
    expect(MOVE[..], MOVE_VERDICTS[..]);
}

// A store of the zero value makes its place and each tracked place below it empty.
fn a_zero_store_makes_its_place_and_each_place_below_it_empty() void {
    expect(ZERO[..], ZERO_VERDICTS[..]);
}

// A store of a fresh `new` makes each tracked place through the pointer empty.
fn a_fresh_new_makes_each_place_through_its_pointer_empty() void {
    expect(FRESH[..], FRESH_VERDICTS[..]);
}

// A store kills the fact of each place with its base that is not separate from it.
fn a_store_kills_each_fact_with_its_base_that_is_not_separate() void {
    expect(SAME_BASE[..], SAME_BASE_VERDICTS[..]);
}

// Two elements with one key are one place, and an element with no key is not tracked.
fn two_elements_with_one_key_are_one_place() void {
    expect(KEYS[..], KEYS_VERDICTS[..]);
}

// A store through a fresh pointer local kills only the facts with its base.
fn a_store_through_a_fresh_pointer_kills_only_its_base() void {
    expect(FRESH_STORE[..], FRESH_STORE_VERDICTS[..]);
}

// A store through a pointer or into memory kills each fact reached through memory.
fn a_store_through_a_pointer_kills_each_fact_reached_through_memory() void {
    expect(MEMORY[..], MEMORY_VERDICTS[..]);
}

// A call kills each fact but the facts of a local that is no memory.
fn a_call_kills_each_fact_but_those_of_a_local_that_is_no_memory() void {
    expect(CALLS[..], CALLS_VERDICTS[..]);
}

// The store of a check takes each kill before it, and the check takes its verdict.
fn the_store_of_a_check_takes_each_kill_before_it() void {
    expect(AFTER_CHECK[..], AFTER_CHECK_VERDICTS[..]);
}

// A global is a tracked place with no fact at the entry.
fn a_global_has_no_fact_at_the_entry() void {
    expect(GLOBALS[..], GLOBALS_VERDICTS[..]);
}

// A held address `(*_a)` reads as the place of its `addr mut`.
fn a_held_address_reads_as_its_place() void {
    expect(HELD[..], HELD_VERDICTS[..]);
    expect(HELD_STORE[..], HELD_STORE_VERDICTS[..]);
    expect(HELD_STALE[..], HELD_STALE_VERDICTS[..]);
    expect(HELD_MEMORY[..], HELD_MEMORY_VERDICTS[..]);
}

// A fact holds at the start of a block when it holds at the end of each predecessor.
fn a_fact_holds_after_a_join_when_it_holds_on_each_edge() void {
    expect(JOIN[..], JOIN_VERDICTS[..]);
}

// The sets of more than one word, a function with no check, and a check that no fact can prove.
fn the_sets_reach_past_one_word_and_a_function_needs_no_check() void {
    expect(BOUNDS[..], BOUNDS_VERDICTS[..]);
}

// Two constant keys name one element when their values are equal.
fn two_constant_keys_with_one_value_name_one_element() void {
    expect(CONSTANTS[..], CONSTANTS_VERDICTS[..]);
}

// A loop carries a kill, a store into a key local and an end of freshness around its back edge.
fn a_loop_carries_each_kill_around_its_back_edge() void {
    expect(LOOPS[..], LOOPS_VERDICTS[..]);
}

// Structs as places: a pointee moved whole, an aggregate result and a global struct.
fn a_struct_is_a_place_with_fields_below_it() void {
    expect(AGGREGATES[..], AGGREGATES_VERDICTS[..]);
}

// Each kind of store against each kind of fact, in the order F1 to F7.
fn each_kind_of_store_kills_the_facts_that_the_rules_name() void {
    expect(KILL_MATRIX[..], KILL_MATRIX_VERDICTS[..]);
}

// A store of null into each kind of place in order: each store makes its place empty and kills by
// the kill rules.
fn each_store_of_null_makes_its_place_empty_and_kills() void {
    expect(ZERO_SEQUENCE[..], ZERO_SEQUENCE_VERDICTS[..]);
}

// What ends the freshness of a pointer local, and what does not.
fn each_read_of_the_pointer_ends_its_freshness() void {
    expect(FRESHNESS[..], FRESHNESS_VERDICTS[..]);
}

// Which right sides store the zero value.
fn only_a_zero_constant_or_its_temporary_is_the_zero_value() void {
    expect(ZERO_VALUES[..], ZERO_VALUES_VERDICTS[..]);
}

// The shapes of an index temporary that give it the key of a local.
fn an_index_temporary_has_the_key_of_the_local_it_copies() void {
    expect(KEY_SHAPES[..], KEY_SHAPES_VERDICTS[..]);
}

// The return place is no key, whatever its value.
fn the_return_place_is_no_key() void {
    expect(RETURN_KEY[..], RETURN_KEY_VERDICTS[..]);
}

// An address is a held address only with one store, one check and one store through it.
fn an_address_is_held_with_one_store_one_check_and_one_store() void {
    expect(HELD_SHAPES[..], HELD_SHAPES_VERDICTS[..]);
}

// Only an address of the fixed storage of a local makes it memory.
fn only_an_address_of_fixed_storage_makes_a_local_memory() void {
    expect(ADDRESSES[..], ADDRESSES_VERDICTS[..]);
}

// A store straight into a memory local or a global keeps the facts of other locals and globals,
// and kills each fact through a pointer that can hold its address.
fn a_store_straight_into_a_local_keeps_other_locals() void {
    expect(STRAIGHT[..], STRAIGHT_VERDICTS[..]);
}

// A check takes the verdict of each store that it guards, and a store has a verdict of its own.
fn a_check_takes_the_verdict_of_each_store_that_it_guards() void {
    expect(GUARDS[..], GUARDS_VERDICTS[..]);
}

// Each store into an `own` reference needs a proof, but for the entry zeroing, a temporary and
// `_0`.
fn each_store_but_an_entry_zeroing_or_a_temporary_needs_a_proof() void {
    expect(NEEDS[..], NEEDS_VERDICTS[..]);
}

// A function with stores that need a proof in two blocks and no check. The entry zeroing of `_4`
// needs none. The store into `(*_1).0` follows its `del`, the store into `(*_1).1` writes a place
// through a parameter, which has no fact, and the store into `_4` finds its entry zeroing.
string[15] ORDER = {
    "fn main.o1(_1 (b): node mut*, _2 (x): node mut* own, _3 (y): node mut* own) -> void {",
    "    let _4 (p): node mut* own;",
    "    bb0: {",
    "        _4 = const zero node mut* own;",
    "        del(move (*_1).0);",
    "        (*_1).0 = move _2;",
    "        goto bb1;",
    "    }",
    "    bb1: {",
    "        (*_1).1 = move _3;",
    "        _4 = alloc<node>(const u64 1);",
    "        del(move _4);",
    "        return;",
    "    }",
    "}",
};

// A check with the store right after it, and a store that no check stands right before.
string[13] ORDER_CHECKED = {
    "fn main.o2(_1 (b): node mut*, _2 (x): node mut* own) -> void {",
    "    let _3: node mut* own;",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_1).0 = move _3;",
    "        (*_1).1 = move _2;",
    "        return;",
    "    }",
    "}",
};

// The proof lists each store that needs a proof by its block and its statement, in block order,
// with its verdict, and counts the unproved ones. The work of ORDER is 8 statements and terminators
// times the 3 stores that no check stands right before, plus 2 blocks times 5 locals. The work of
// ORDER_CHECKED is 6 statements and terminators times its check and its one store that no check
// stands right before and that writes no scratch local, plus 2 blocks times 4 locals: the store
// into the temporary `_3` adds nothing to the first count. prover.free ends the list.
fn the_proof_lists_each_store_in_block_order() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    fir.module mut m = pass_env.parse(&e, PRELUDE[..], ORDER[..]);
    defer fir.module_free(&m);
    fir.func* f = &m.funcs.items[0];
    pass_env.verified(&e, f, "prover_test: the verifier refuses the input");
    prover.proof mut p = prover.prove(f);
    assert(p.checks == 0 && p.stores.len == 3 && p.unproved == 1 && !p.over);
    assert(p.work == 34);
    assert(p.stores[0].block == 0 && p.stores[0].index == 2 && p.stores[0].proved);
    assert(p.stores[1].block == 1 && p.stores[1].index == 0 && !p.stores[1].proved);
    assert(p.stores[2].block == 1 && p.stores[2].index == 1 && p.stores[2].proved);
    assert(prover.is_proved(&p, 0) && prover.is_proved(&p, 1));
    prover.free(&p);
    assert(p.stores.len == 0 && p.proved.len == 0 && p.checks == 0 && p.unproved == 0);
    fir.module mut c = pass_env.parse(&e, PRELUDE[..], ORDER_CHECKED[..]);
    defer fir.module_free(&c);
    fir.func* g = &c.funcs.items[0];
    prover.proof mut q = prover.prove(g);
    defer prover.free(&q);
    assert(q.checks == 1 && q.stores.len == 3 && q.unproved == 1 && q.work == 20);
    assert(q.stores[0].block == 0 && q.stores[0].index == 1 && q.stores[0].proved);
    assert(prover.is_proved(&q, 0) && q.stores[1].proved && !q.stores[2].proved);
}

// ---- the examples over fort source -------------------------------------------------------------

// The examples of the rule. A comment gives the verdicts of the checks of each function in block
// order.
string[246] EXAMPLES = {
    "struct int_buf {",
    "    i32 mut@ own items;",
    "    u64 len;",
    "}",
    "struct node {",
    "    node mut* own left;",
    "    node mut* own right;",
    "    node mut* own next;",
    "}",
    "struct node_vec {",
    "    node mut* own mut@ own items;",
    "    u64 len;",
    "}",
    "struct list {",
    "    node mut* own head;",
    "}",
    "node mut* own mut G = null;",
    // P
    "fn fill(int_buf mut* b) void {",
    "    del(b->items);",
    "    b->items = new(i32, 8);",
    "}",
    // U: the entry value of b->items is not known
    "fn refill(int_buf mut* b) void {",
    "    b->items = new(i32, 8);",
    "}",
    // P
    "fn store_out(node mut* own mut* out, node mut* own buf) void {",
    "    del(*out);",
    "    *out = move(buf);",
    "}",
    // PPP: the store into n->left keeps the fact of the separate field n->right
    "fn pair(node mut* own l, node mut* own r) node mut* own {",
    "    node mut* own n = new(node);",
    "    n->left = move(l);",
    "    n->right = move(r);",
    "    return move(n);",
    "}",
    // UU: q can hold the value of p
    "fn alias(node mut* p, node mut* q, node mut* own x) void {",
    "    del(p->left);",
    "    q->right = null;",
    "    p->left = move(x);",
    "}",
    // P: both elements have the key k
    "fn put(node_vec mut* v, node mut* own n) void {",
    "    u64 k = v->len;",
    "    del(v->items[k]);",
    "    v->items[k] = move(n);",
    "}",
    // U: v->items[v->len] has no key
    "fn put_len(node_vec mut* v, node mut* own n) void {",
    "    del(v->items[v->len]);",
    "    v->items[v->len] = move(n);",
    "}",
    // PPP: n is fresh, so the store into n->next keeps the fact of l->head
    "fn push(list mut* l) void {",
    "    node mut* own n = new(node);",
    "    n->next = move(l->head);",
    "    l->head = move(n);",
    "}",
    // P
    "fn set_global(node mut* own x) void {",
    "    del(G);",
    "    G = move(x);",
    "}",
    // U: a global has no fact at the entry
    "fn set_global_alone(node mut* own x) void {",
    "    G = move(x);",
    "}",
    // PP: a = move(b) after move(a)
    "fn swap(node mut* own mut a, node mut* own b) void {",
    "    node mut* own t = move(a);",
    "    a = move(b);",
    "    del(t);",
    "    del(a);",
    "}",
    // P: the body deletes the local
    "fn loop_del() void {",
    "    for (i32 mut i = 0; i < 3; i++) {",
    "        i32 mut* own p = new(i32);",
    "        del(p);",
    "    }",
    "}",
    // U: the back edge joins a live p with the entry store
    "fn loop_leak() void {",
    "    for (i32 mut i = 0; i < 3; i++) {",
    "        i32 mut* own p = new(i32);",
    "    }",
    "}",
    // P: a store of null into a local that holds null
    "fn twice() void {",
    "    node mut* own mut p = null;",
    "    p = null;",
    "}",
    // PPU: the elements of a span from `new` have no fact, so the store in the loop is not
    // proved. The block of the check after the loop comes before the blocks of the body.
    "fn grow(node_vec mut* v) void {",
    "    node mut* own mut@ own bigger = new(node mut* own, v->items.len * 2);",
    "    u64 mut i = 0;",
    "    while (i < v->items.len) {",
    "        bigger[i] = move(v->items[i]);",
    "        i += 1;",
    "    }",
    "    del(v->items);",
    "    v->items = move(bigger);",
    "}",
    // PP: the move of l->head makes it empty for the store of n->next
    "fn pop(list mut* l) node mut* own {",
    "    node mut* own n = move(l->head);",
    "    l->head = move(n->next);",
    "    return move(n);",
    "}",
    // PPP: the store into p->left keeps the fact of the separate field p->right
    "fn swap_fields(node mut* p) void {",
    "    node mut* own tmp = move(p->left);",
    "    p->left = move(p->right);",
    "    p->right = move(tmp);",
    "    del(tmp);",
    "}",
    // no check
    "fn make() node mut* own {",
    "    return new(node);",
    "}",
    // U: the call on the right side can store into l->head after the del
    "fn refresh(list mut* l) void {",
    "    del(l->head);",
    "    l->head = make();",
    "}",
    // PP: the call before the del
    "fn refresh_first(list mut* l) void {",
    "    node mut* own n = make();",
    "    del(l->head);",
    "    l->head = move(n);",
    "}",
    // P: an owning string field after its del
    "struct named {",
    "    string own name;",
    "}",
    "fn rename(named mut* x, string own s) void {",
    "    del(x->name);",
    "    x->name = move(s);",
    "}",
    // U: a store of null needs the proof too
    "fn init_head(list mut* l) void {",
    "    l->head = null;",
    "}",
    // P
    "fn clear_head(list mut* l) void {",
    "    del(l->head);",
    "    l->head = null;",
    "}",
    // U: the push of a vector, whose element index reads memory
    "fn push_back(node_vec mut* v, node mut* own n) void {",
    "    v->items[v->len] = move(n);",
    "    v->len += 1;",
    "}",
    // U: an out parameter with no del
    "fn take_out(node mut* own mut* out) void {",
    "    *out = new(node);",
    "}",
    // P: a parameter after its del
    "fn reset(node mut* own mut p) void {",
    "    del(p);",
    "    p = new(node);",
    "    del(p);",
    "}",
    // U: the call in the loop body stands after the del
    "fn refresh_loop(list mut* l, bool c) void {",
    "    while (c) {",
    "        del(l->head);",
    "        l->head = make();",
    "    }",
    "}",
    // PP: a local in a loop that the body moves out
    "fn loop_move(list mut* l, bool c) void {",
    "    while (c) {",
    "        node mut* own n = new(node);",
    "        del(l->head);",
    "        l->head = move(n);",
    "    }",
    "}",
    // the seven shapes of the review: a store behind a second deref names any storage
    "struct outer {",
    "    node mut* own g;",
    "    outer mut* next;",
    "    node mut* own h;",
    "    node mut* own[2] gs;",
    "}",
    "struct holder {",
    "    node mut* own g;",
    "    holder mut* self;",
    "    node mut* own[2] a;",
    "    node mut* own mut* pa;",
    "}",
    "struct inner {",
    "    node mut* own f;",
    "}",
    "struct nest {",
    "    inner a;",
    "    inner mut* pa;",
    "}",
    "holder mut HG = {};",
    // UU: p->next can be p, so the store through it kills the fact of p->g
    "fn second(outer mut* p) void {",
    "    p->next = p;",
    "    del(p->g);",
    "    p->next->g = new(node);",
    "    p->g = new(node);",
    "}",
    // UU: the same through a field of a local
    "fn self_local() void {",
    "    holder mut x = {};",
    "    x.self = &x;",
    "    x.self->g = new(node);",
    "    x.g = new(node);",
    "    del(x.g);",
    "}",
    // UU: the same through a field of a global
    "fn self_global() void {",
    "    HG.self = &HG;",
    "    del(HG.g);",
    "    HG.self->g = new(node);",
    "    HG.g = new(node);",
    "}",
    // UU: an element behind the second deref
    "fn second_element(outer mut* p) void {",
    "    p->next = p;",
    "    del(p->gs[0]);",
    "    p->next->gs[0] = new(node);",
    "    p->gs[0] = new(node);",
    "}",
    // UUU: a move into the place behind the second deref
    "fn second_move(outer mut* p) void {",
    "    p->next = p;",
    "    del(p->g);",
    "    p->h = new(node);",
    "    p->next->g = move(p->h);",
    "    p->g = new(node);",
    "}",
    // UU: a pointer to a field of the local
    "fn nested_field() void {",
    "    nest mut x = {};",
    "    x.pa = &x.a;",
    "    del(x.a.f);",
    "    x.pa->f = new(node);",
    "    x.a.f = new(node);",
    "    del(x.a.f);",
    "}",
    // UU: a pointer to an element of the local
    "fn slot_index() void {",
    "    holder mut x = {};",
    "    x.pa = &x.a[0];",
    "    del(x.a[0]);",
    "    *x.pa = new(node);",
    "    x.a[0] = new(node);",
    "    del(x.a[0]);",
    "}",
    "struct two {",
    "    node mut* own mut@ cur;",
    "    node mut* own mut@ other;",
    "}",
    "fn flip(two mut* t) bool {",
    "    node mut* own mut@ x = t->cur;",
    "    t->cur = t->other;",
    "    t->other = x;",
    "    return true;",
    "}",
    // U: the call makes t->cur another span after the store holds the address of t->cur[i]
    "fn store_flip(two mut* t, u64 i) void {",
    "    t->cur[i] = flip(t) ? move(t->cur[i]) : move(t->cur[i]);",
    "}",
    "fn flip_local(node mut* own mut@ mut* s, node mut* own mut@ other) bool {",
    "    *s = other;",
    "    return true;",
    "}",
    // U: the call makes s another span through &s
    "fn store_local(node mut* own mut@ a, node mut* own mut@ b, u64 i) void {",
    "    node mut* own mut@ mut s = a;",
    "    s[i] = flip_local(&s, b) ? move(s[i]) : move(s[i]);",
    "}",
    // P: the move of v->items[j] makes no held address stale
    "fn remove(node_vec mut* v, u64 i, u64 j) void {",
    "    del(v->items[i]);",
    "    v->items[i] = move(v->items[j]);",
    "}",
};

// The functions of EXAMPLES and the verdicts of each.
string[38] EXAMPLE_NAMES = {
    "fill", "refill", "store_out", "pair", "alias", "put", "put_len", "push", "set_global",
    "set_global_alone", "swap", "loop_del", "loop_leak", "twice", "grow", "pop", "swap_fields",
    "make", "refresh", "refresh_first", "rename", "init_head", "clear_head", "push_back",
    "take_out", "reset", "refresh_loop", "loop_move", "second", "self_local", "self_global",
    "second_element", "second_move", "nested_field", "slot_index", "store_flip", "store_local",
    "remove",
};

string[38] EXAMPLE_VERDICTS = {
    "P/PP", "U/PP", "P/P", "PPP/PPPP", "UU/PP", "P/P", "U/P", "PPP/PPP", "P/P", "U/P", "PP/PP",
    "P/P", "U/P", "PP/PP", "PPU/PPPP", "PP/PPP", "PPP/PPP", "/PP", "U/P", "PP/PP", "P/P", "U/P",
    "P/P", "U/P", "U/P", "P/P", "U/P", "PP/PP", "UU/PP", "UU/PP", "UU/PP", "UU/PP", "UUU/PPP",
    "UU/PP", "UU/PP", "U/PP", "U/PP", "P/P",
};

// Lowers the function `name` of the checked source of `e` into *out, and holds that the
// verifier accepts it.
fn lower(lower_env.env mut* e, string name, fir.func mut* out) void {
    fir_lower.report mut why = fir_lower.report{};
    if (!fir_lower.lower_function(&e->c.ck, lower_env.decl(e, name), out, &why)) {
        panic("prover_test: the lowering refuses the function");
    }
    pass_env.verified(e, out, "prover_test: the verifier refuses the lowering");
}

// The examples of the rule give their verdicts when the pass reads their lowering.
fn the_examples_of_the_rule_hold_over_lowered_source() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    lower_env.check_lines(&e, EXAMPLES[..], true);
    strbuf.str_buf mut got = strbuf.create();
    defer strbuf.free(&got);
    u64 mut k = 0;
    while (k < EXAMPLE_NAMES.len) {
        fir.func mut f = fir.func{};
        lower(&e, EXAMPLE_NAMES[k], &f);
        prover.proof mut p = prover.prove(&f);
        write_verdicts(&f, &p, &got);
        prover.free(&p);
        fir.func_free(&f);
        if (strbuf.view(&got) != EXAMPLE_VERDICTS[k]) {
            eprintln(EXAMPLE_NAMES[k], " gives ", strbuf.view(&got), " and not ",
                     EXAMPLE_VERDICTS[k]);
            panic("prover_test: an example gives another verdict");
        }
        k += 1;
    }
}

// ---- the exits of the leak rule ----------------------------------------------------------------

// Each case is a FIR function and the verdicts of its exits (write_exits). The comment of a case
// gives them. A named owner local has an obligation at each `dead` marker outside an abort block,
// and at a `return` where its scope may not have ended. A parameter and a temporary have one at
// each `return` (D17.20 part 1).
string[274] EXITS = {
    // a named local that holds an allocation at its `dead`: dnU, and the moved temporary: rtP
    "fn main.x1() -> void {",
    "    let _1 (n): node mut* own;",
    "    let _2: node mut* own;",
    "    bb0: {",
    "        _1 = const zero node mut* own;",
    "        live(_1);",
    "        _2 = alloc<node>(const u64 1);",
    "        check(overwrite: _1) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1 = move _2;",
    "        dead(_1);",
    "        return;",
    "    }",
    "}",
    // the `del` right before the `dead` empties it: dnP rtP
    "fn main.x2() -> void {",
    "    let _1 (n): node mut* own;",
    "    let _2: node mut* own;",
    "    bb0: {",
    "        _1 = const zero node mut* own;",
    "        live(_1);",
    "        _2 = alloc<node>(const u64 1);",
    "        check(overwrite: _1) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1 = move _2;",
    "        del(move _1);",
    "        dead(_1);",
    "        return;",
    "    }",
    "}",
    // a parameter has no fact at the entry: rpU
    "fn main.x3(_1 (p): node mut* own) -> void {",
    "    bb0: {",
    "        return;",
    "    }",
    "}",
    // a `del` of the parameter: rpP
    "fn main.x4(_1 (p): node mut* own) -> void {",
    "    bb0: {",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // a `move` into a call: rpP
    "fn main.x5(_1 (p): node mut* own) -> void {",
    "    let _2: void;",
    "    bb0: {",
    "        _2 = call fn main.take(move _1);",
    "        return;",
    "    }",
    "}",
    // a temporary that holds an allocation at the `return`: rtU
    "fn main.x6() -> void {",
    "    let _1: node mut* own;",
    "    bb0: {",
    "        _1 = alloc<node>(const u64 1);",
    "        return;",
    "    }",
    "}",
    // a temporary that a call takes: rtP
    "fn main.x7() -> void {",
    "    let _1: node mut* own;",
    "    let _2: void;",
    "    bb0: {",
    "        _1 = alloc<node>(const u64 1);",
    "        _2 = call fn main.take(move _1);",
    "        return;",
    "    }",
    "}",
    // a temporary that is memory takes the fact, and the call kills it: rtU
    "fn main.x8() -> void {",
    "    let _1: node mut* own;",
    "    let _2: node mut* own mut*;",
    "    let _3: void;",
    "    bb0: {",
    "        _1 = alloc<node>(const u64 1);",
    "        _2 = addr mut(_1);",
    "        del(move _1);",
    "        _3 = call fn main.g();",
    "        return;",
    "    }",
    "}",
    // the same with no call: rtP
    "fn main.x9() -> void {",
    "    let _1: node mut* own;",
    "    let _2: node mut* own mut*;",
    "    bb0: {",
    "        _1 = alloc<node>(const u64 1);",
    "        _2 = addr mut(_1);",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // a `dead` in a block that ends in `trap` or `fail`, an abort block, has no obligation, and
    // neither block has a `return`: no exit
    "fn main.x10(_1 (c): bool) -> void {",
    "    let _2 (n): node mut* own;",
    "    let _3: node mut* own;",
    "    bb0: {",
    "        _2 = const zero node mut* own;",
    "        live(_2);",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: _2) -> bb1;",
    "    }",
    "    bb1: {",
    "        _2 = move _3;",
    "        switch(copy _1) -> [true: bb2, otherwise: bb3];",
    "    }",
    "    bb2: {",
    "        dead(_2);",
    "        trap;",
    "    }",
    "    bb3: {",
    "        dead(_2);",
    "        fail(panic, const bytes \"stop\", const u64 4);",
    "    }",
    "}",
    // the same `dead` before a `goto` to the abort block has its obligation: dnU
    "fn main.x11() -> void {",
    "    let _1 (n): node mut* own;",
    "    let _2: node mut* own;",
    "    bb0: {",
    "        _1 = const zero node mut* own;",
    "        live(_1);",
    "        _2 = alloc<node>(const u64 1);",
    "        check(overwrite: _1) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1 = move _2;",
    "        dead(_1);",
    "        goto bb2;",
    "    }",
    "    bb2: {",
    "        trap;",
    "    }",
    "}",
    // a named local with no `dead` that holds an allocation at the `return`: its scope did not end,
    // so it has an obligation there: rnU rtP
    "fn main.x12() -> void {",
    "    let _1 (n): node mut* own;",
    "    let _2: node mut* own;",
    "    bb0: {",
    "        _1 = const zero node mut* own;",
    "        _2 = alloc<node>(const u64 1);",
    "        check(overwrite: _1) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1 = move _2;",
    "        return;",
    "    }",
    "}",
    // the same after a `del`: rnP rtP
    "fn main.x13() -> void {",
    "    let _1 (n): node mut* own;",
    "    let _2: node mut* own;",
    "    bb0: {",
    "        _1 = const zero node mut* own;",
    "        _2 = alloc<node>(const u64 1);",
    "        check(overwrite: _1) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1 = move _2;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // the address of a named local starts its scope, and the store through it kills its fact:
    // rnU rtP
    "fn main.x14() -> void {",
    "    let _1 (n): node mut* own;",
    "    let _2: node mut* own mut*;",
    "    let _3: node mut* own;",
    "    bb0: {",
    "        _1 = const zero node mut* own;",
    "        _2 = addr mut(_1);",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_2)) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_2) = move _3;",
    "        return;",
    "    }",
    "}",
    // a store of the zero value starts no scope: rtP
    "fn main.x15() -> void {",
    "    let _1 (n): node mut* own;",
    "    let _2: node mut* own;",
    "    bb0: {",
    "        _1 = const zero node mut* own;",
    "        _2 = alloc<node>(const u64 1);",
    "        del(move _2);",
    "        _1 = const null node mut* own;",
    "        return;",
    "    }",
    "}",
    // the scope that a `dead` ends stays ended over `live` with no store: dnU rtP
    "fn main.x16() -> void {",
    "    let _1 (n): node mut* own;",
    "    let _2: node mut* own;",
    "    bb0: {",
    "        _1 = const zero node mut* own;",
    "        live(_1);",
    "        _2 = alloc<node>(const u64 1);",
    "        check(overwrite: _1) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1 = move _2;",
    "        dead(_1);",
    "        live(_1);",
    "        return;",
    "    }",
    "}",
    // a named local that is memory and is not declared on the path of the first `return`: a call
    // there kills its fact, but its scope has not started, so the first `return` has no obligation
    // for it: rtP dnP rtP
    "fn main.x17(_1 (c): bool) -> void {",
    "    let _2 (n): node mut* own;",
    "    let _3: node mut* own;",
    "    let _4: node mut* own mut*;",
    "    let _5: void;",
    "    bb0: {",
    "        _2 = const zero node mut* own;",
    "        _5 = call fn main.g();",
    "        switch(copy _1) -> [true: bb1, otherwise: bb2];",
    "    }",
    "    bb1: {",
    "        return;",
    "    }",
    "    bb2: {",
    "        live(_2);",
    "        _3 = alloc<node>(const u64 1);",
    "        _2 = move _3;",
    "        _4 = addr mut(_2);",
    "        del(move _2);",
    "        dead(_2);",
    "        return;",
    "    }",
    "}",
    // a temporary moved on one path only: rtP rtU
    "fn main.x18(_1 (c): bool) -> void {",
    "    let _2: node mut* own;",
    "    let _3: void;",
    "    bb0: {",
    "        _2 = alloc<node>(const u64 1);",
    "        switch(copy _1) -> [true: bb1, otherwise: bb2];",
    "    }",
    "    bb1: {",
    "        _3 = call fn main.take(move _2);",
    "        return;",
    "    }",
    "    bb2: {",
    "        return;",
    "    }",
    "}",
    // a parameter that is memory: the call after its `del` kills its fact: rpU
    "fn main.x19(_1 (p): node mut* own) -> void {",
    "    let _2: node mut* own mut*;",
    "    let _3: void;",
    "    bb0: {",
    "        _2 = addr mut(_1);",
    "        del(move _1);",
    "        _3 = call fn main.g();",
    "        return;",
    "    }",
    "}",
    // `_0` passes its value to the caller, and an owning aggregate waits for R1: no exit
    "fn main.x20() -> node mut* own {",
    "    let _1 (s): pair;",
    "    bb0: {",
    "        _1 = aggregate pair(const null node mut* own, const null node mut* own);",
    "        live(_1);",
    "        _1.0 = alloc<node>(const u64 1);",
    "        dead(_1);",
    "        _0 = alloc<node>(const u64 1);",
    "        return;",
    "    }",
    "}",
    // outside the guarantee: a store through the address of `n` after its `dead` gives it an
    // allocation that the `return` leaks. It writes through a dangling pointer, which D17.11
    // assumes no store does, so the `dead` keeps the fact of the entry zeroing and the `return`
    // has no obligation for `n`: dnP rtP (probe `fb` of the review)
    "fn main.x21() -> i32 {",
    "    let _1 (n): node mut* own;",
    "    let _2: node mut* own mut*;",
    "    let _3: node mut* own;",
    "    bb0: {",
    "        _1 = const zero node mut* own;",
    "        live(_1);",
    "        _2 = addr mut(_1);",
    "        dead(_1);",
    "        _3 = alloc<node>(const u64 1);",
    "        del(move (*_2));",
    "        check(overwrite: (*_2)) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_2) = move _3;",
    "        _0 = const i32 0;",
    "        return;",
    "    }",
    "}",
};

string[21] EXITS_VERDICTS = {
    "dnU rtP", "dnP rtP", "rpU", "rpP", "rpP", "rtU", "rtP", "rtU", "rtP", "", "dnU", "rnU rtP",
    "rnP rtP", "rnU rtP", "rtP", "dnU rtP", "rtP dnP rtP", "rtP rtU", "rpU", "", "dnP rtP",
};

// The exit kinds of D17.20 over lowered fort source: the closing brace, `return`, `break`,
// `continue`, and an exit into an abort block, each with a function whose exit holds an allocation
// and one whose exit does not. The `dead` of an exit stands at the closing brace or at the keyword
// (spec/fir.md 9.5). A comment gives the verdicts of each function (write_exits).
string[104] EXIT_KINDS = {
    "struct node {",
    "    node mut* own next;",
    "}",
    "fn take(node mut* own n) void {",
    "    del(n);",
    "}",
    // dnU rtP
    "fn brace_leak() void {",
    "    {",
    "        node mut* own n = new(node);",
    "    }",
    "}",
    // dnP rtP
    "fn brace_del() void {",
    "    {",
    "        node mut* own n = new(node);",
    "        del(n);",
    "    }",
    "}",
    // the `return` ends `n`, then the parameter and the temporary: dnU rpU rtP dnP rpP rtP
    "fn return_leak(bool c, node mut* own p) void {",
    "    node mut* own n = new(node);",
    "    if (c) {",
    "        return;",
    "    }",
    "    del(n);",
    "    del(p);",
    "}",
    // dnP rpP rtP dnP rpP rtP
    "fn return_del(bool c, node mut* own p) void {",
    "    node mut* own n = new(node);",
    "    if (c) {",
    "        del(n);",
    "        take(move(p));",
    "        return;",
    "    }",
    "    del(n);",
    "    del(p);",
    "}",
    // the block of the `return` comes first: rtP dnU dnP
    "fn break_leak(bool c) void {",
    "    while (c) {",
    "        node mut* own n = new(node);",
    "        if (c) {",
    "            break;",
    "        }",
    "        del(n);",
    "    }",
    "}",
    // rtP dnP dnP
    "fn break_del(bool c) void {",
    "    while (c) {",
    "        node mut* own n = new(node);",
    "        if (c) {",
    "            del(n);",
    "            break;",
    "        }",
    "        del(n);",
    "    }",
    "}",
    // the back edge also carries `n` to its declaration, an error of D17.11: rtP dnU dnP
    "fn continue_leak(bool c) void {",
    "    while (c) {",
    "        node mut* own n = new(node);",
    "        if (c) {",
    "            continue;",
    "        }",
    "        del(n);",
    "    }",
    "}",
    // rtP dnP dnP
    "fn continue_del(bool c) void {",
    "    while (c) {",
    "        node mut* own n = new(node);",
    "        if (c) {",
    "            del(n);",
    "            continue;",
    "        }",
    "        del(n);",
    "    }",
    "}",
    // the `dead` of the block stands in the block of the `panic`, an abort block: no exit
    "fn abort_end() void {",
    "    {",
    "        node mut* own n = new(node);",
    "    }",
    "    panic(\"stop\");",
    "}",
    // the same `dead` before an `if`: dnU rtP
    "fn abort_twin(bool c) void {",
    "    {",
    "        node mut* own n = new(node);",
    "    }",
    "    if (c) {",
    "        panic(\"stop\");",
    "    }",
    "}",
    // the end of a `noreturn` body is a `trap`, an abort block: no exit
    "fn die() noreturn {",
    "    node mut* own n = new(node);",
    "    while (true) {",
    "    }",
    "}",
    // the pass follows the edge that no run takes, so the `dead` before the `return` is unproved:
    // dnU rtP
    "fn spin() void {",
    "    node mut* own n = new(node);",
    "    while (true) {",
    "    }",
    "}",
    // the deferred `del` runs before the `dead` of each exit: dnP rtP dnP rtP
    "fn deferred(bool c) void {",
    "    node mut* own n = new(node);",
    "    defer del(n);",
    "    if (c) {",
    "        return;",
    "    }",
    "}",
};

string[13] EXIT_KIND_NAMES = {
    "brace_leak", "brace_del", "return_leak", "return_del", "break_leak", "break_del",
    "continue_leak", "continue_del", "abort_end", "abort_twin", "die", "spin", "deferred",
};

string[13] EXIT_KIND_VERDICTS = {
    "dnU rtP", "dnP rtP", "dnU rpU rtP dnP rpP rtP", "dnP rpP rtP dnP rpP rtP", "rtP dnU dnP",
    "rtP dnP dnP", "rtP dnU dnP", "rtP dnP dnP", "", "dnU rtP", "", "dnU rtP", "dnP rtP dnP rtP",
};

// Writes the verdict of each exit of `p` into `out`, in the order of the exits, with a space
// between two: `d` for a `dead` marker or `r` for a `return`, then the name of a named local or a
// parameter or `t` for a temporary, then `P` for an exit that `p` proves and `U` for one that it
// does not prove. Holds the count of `p` against the verdicts.
fn write_exits(fir.func* f, prover.proof* p, strbuf.str_buf mut* out) void {
    strbuf.clear(out);
    u32 mut leaks = 0;
    u64 mut k = 0;
    while (k < p->exits.len) {
        prover.exit* x = &p->exits[k];
        if (k > 0) {
            strbuf.push(out, ' ');
        }
        if (x->index < fir.block_statement_count(f, x->block)) {
            assert(fir.block_statement(f, x->block, x->index)->kind == fir.stmt_kind.st_dead);
            strbuf.push(out, 'd');
        } else {
            assert(fir.block_at(f, x->block)->term.kind == fir.term_kind.tk_return);
            strbuf.push(out, 'r');
        }
        fir.local* l = fir.local_at(f, x->local);
        if (l->kind == fir.local_kind.lk_temp) {
            strbuf.push(out, 't');
        } else {
            strbuf.append(out, fir.local_name(l));
        }
        if (x->proved) {
            strbuf.push(out, 'P');
        } else {
            strbuf.push(out, 'U');
            leaks += 1;
        }
        k += 1;
    }
    assert(p->leaks == leaks);
}

// Parses `text` against PRELUDE, holds that the verifier accepts each function, proves each one,
// and holds that function `k` of the module gives the exit verdicts `want[k]`.
fn expect_exits(string@ text, string@ want) void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    fir.module mut m = pass_env.parse(&e, PRELUDE[..], text);
    defer fir.module_free(&m);
    assert(m.funcs.len == want.len);
    strbuf.str_buf mut got = strbuf.create();
    defer strbuf.free(&got);
    u64 mut k = 0;
    while (k < m.funcs.len) {
        fir.func* f = &m.funcs.items[k];
        pass_env.verified(&e, f, "prover_test: the verifier refuses the input");
        prover.proof mut p = prover.prove(f);
        write_exits(f, &p, &got);
        prover.free(&p);
        if (strbuf.view(&got) != want[k]) {
            eprintln("function ", k, " gives ", strbuf.view(&got), " and not ", want[k]);
            panic("prover_test: an exit verdict differs");
        }
        k += 1;
    }
}

// Each owner local has its obligation at each exit of its scope, and no other local has one.
fn each_exit_holds_the_obligation_of_its_owner_local() void {
    expect_exits(EXITS[..], EXITS_VERDICTS[..]);
}

// Each exit kind of D17.20 has its obligation in the lowering of fort source.
fn each_exit_kind_of_lowered_source_has_its_obligation() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    lower_env.check_lines(&e, EXIT_KINDS[..], true);
    strbuf.str_buf mut got = strbuf.create();
    defer strbuf.free(&got);
    u64 mut k = 0;
    while (k < EXIT_KIND_NAMES.len) {
        fir.func mut f = fir.func{};
        lower(&e, EXIT_KIND_NAMES[k], &f);
        prover.proof mut p = prover.prove(&f);
        write_exits(&f, &p, &got);
        prover.free(&p);
        fir.func_free(&f);
        if (strbuf.view(&got) != EXIT_KIND_VERDICTS[k]) {
            eprintln(EXIT_KIND_NAMES[k], " gives ", strbuf.view(&got), " and not ",
                     EXIT_KIND_VERDICTS[k]);
            panic("prover_test: an exit kind gives another verdict");
        }
        k += 1;
    }
}

// ---- the release of each allocation ------------------------------------------------------------

// The count of the rounds of proofs between two samples of the release probe.
u64 PROOFS = 20;

// Appends the place that the report names for each check of `f` that `p` does not prove, as
// report.write writes it, and the owner that the error names for each exit that `p` does not
// prove, as report.write_leaks writes it. Writes no diagnostic.
fn write_unproved(fir.func* f, prover.proof* p, session.session mut* s,
                  strbuf.str_buf mut* out) void {
    u32 mut b = 0;
    while (b < fir.block_count(f)) {
        if (!prover.is_proved(p, b)) {
            fir.terminator* t = &fir.block_at(f, b)->term;
            report.write_place(f, t->place, t->loc, s, out);
            strbuf.push(out, '\n');
        }
        b += 1;
    }
    u64 mut k = 0;
    while (k < p->exits.len) {
        if (!p->exits[k].proved) {
            report.write_owner(f, p->exits[k].local, s, out);
            strbuf.push(out, '\n');
        }
        k += 1;
    }
}

// Each round proves each function of HELD and of EXITS PROOFS times, writes its places and the
// owners of its exits that it does not prove, and frees its proof. A proof that keeps a vector of
// its context, a set of a dataflow or the probes of a walk keeps 32 bytes or more in each proof,
// so 4480 bytes or more in each round, and the program break moves. The probe runs first in main,
// as the probe of fir_flow_test does: after the other tests, the allocator can serve a leak out of
// the free chunks that they left.
fn the_proofs_leave_the_heap_where_it_was() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    // one module holds both texts: a second parse in one environment checks the prelude again
    string mut@ own text = new(string, HELD.len + EXITS.len);
    defer del(text);
    for (u64 mut i = 0; i < text.len; i++) {
        if (i < HELD.len) {
            text[i] = HELD[i];
        } else {
            text[i] = EXITS[i - HELD.len];
        }
    }
    fir.module mut m = pass_env.parse(&e, PRELUDE[..], text);
    defer fir.module_free(&m);
    strbuf.str_buf mut out = strbuf.create();
    defer strbuf.free(&out);
    u64[3] mut break_at = {};
    u64 mut round = 0;
    while (round < fir_env.LEAK_ROUNDS) {
        u64 mut k = 0;
        while (k < PROOFS) {
            u64 mut i = 0;
            while (i < m.funcs.len) {
                prover.proof mut p = prover.prove(&m.funcs.items[i]);
                strbuf.clear(&out);
                write_unproved(&m.funcs.items[i], &p, &e.c.m.s, &out);
                prover.free(&p);
                i += 1;
            }
            k += 1;
        }
        u64 slot = fir_env.leak_slot(round);
        if (slot < 3) {
            break_at[slot] = heap.system_view();
        }
        round += 1;
    }
    assert(fir_env.moved(break_at) < fir_env.LEAK_BOUND);
}

// ---- the work limit ----------------------------------------------------------------------------

// Writes into `out` the FIR text of a function with `n` checks, one for each element of a fixed
// array with the constant keys 0 to n - 1, each after a `del` of its element. Its work is
// 4n^2 + 4n + 2: n stores of a key, n `del`s and n + 1 terminators, times n checks, plus n + 1
// blocks times n + 2 locals.
fn write_elements(u64 n, strbuf.str_buf mut* out) void {
    strbuf.clear(out);
    strbuf.append(out, "fn main.big(_1 (v): node mut* own[2] mut*) -> void {\n");
    u64 mut k = 0;
    while (k < n) {
        strbuf.append(out, "    let _");
        strbuf.append_u64(out, k + 2);
        strbuf.append(out, ": u64;\n");
        k += 1;
    }
    strbuf.append(out, "    bb0: {\n");
    k = 0;
    while (k < n) {
        strbuf.append(out, "        _");
        strbuf.append_u64(out, k + 2);
        strbuf.append(out, " = const u64 ");
        strbuf.append_u64(out, k);
        strbuf.append(out, ";\n        del(move (*_1)[_");
        strbuf.append_u64(out, k + 2);
        strbuf.append(out, "]);\n");
        k += 1;
    }
    k = 0;
    while (k < n) {
        if (k > 0) {
            strbuf.append(out, "    bb");
            strbuf.append_u64(out, k);
            strbuf.append(out, ": {\n");
        }
        strbuf.append(out, "        check(overwrite: (*_1)[_");
        strbuf.append_u64(out, k + 2);
        strbuf.append(out, "]) -> bb");
        strbuf.append_u64(out, k + 1);
        strbuf.append(out, ";\n    }\n");
        k += 1;
    }
    strbuf.append(out, "    bb");
    strbuf.append_u64(out, n);
    strbuf.append(out, ": {\n        return;\n    }\n}\n");
}

// Writes into `out` the FIR text of a function of `t` blocks and 1025 locals with one check: a
// `del`, a chain of `goto`s, the check and `return`. Its work is 1026t + 1: one statement and t
// terminators times one check, plus t blocks times 1025 locals. `t` is 3 or more.
fn write_wide(u64 t, strbuf.str_buf mut* out) void {
    strbuf.clear(out);
    strbuf.append(out, "fn main.wide(_1 (b): node mut*) -> void {\n");
    u64 mut k = 2;
    while (k < 1025) {
        strbuf.append(out, "    let _");
        strbuf.append_u64(out, k);
        strbuf.append(out, ": u64;\n");
        k += 1;
    }
    strbuf.append(out, "    bb0: {\n        del(move (*_1).0);\n        goto bb1;\n    }\n");
    k = 1;
    while (k + 2 < t) {
        strbuf.append(out, "    bb");
        strbuf.append_u64(out, k);
        strbuf.append(out, ": {\n        goto bb");
        strbuf.append_u64(out, k + 1);
        strbuf.append(out, ";\n    }\n");
        k += 1;
    }
    strbuf.append(out, "    bb");
    strbuf.append_u64(out, t - 2);
    strbuf.append(out, ": {\n        check(overwrite: (*_1).0) -> bb");
    strbuf.append_u64(out, t - 1);
    strbuf.append(out, ";\n    }\n    bb");
    strbuf.append_u64(out, t - 1);
    strbuf.append(out, ": {\n        return;\n    }\n}\n");
}

// Writes into `out` the FIR text of a function of two blocks with one check, `n` index
// temporaries that copy the parameter `_2` and `n` stores into `_2`. Its work is n^2 + 4n + 9:
// 2n + 1 statements and 2 terminators times one check, 2 blocks times n + 3 locals, and n stores
// into `_2` times its n temporaries.
fn write_chain(u64 n, strbuf.str_buf mut* out) void {
    strbuf.clear(out);
    strbuf.append(out, "fn main.chain(_1 (b): node mut*, _2 (k): u64) -> void {\n");
    u64 mut k = 0;
    while (k < n) {
        strbuf.append(out, "    let _");
        strbuf.append_u64(out, k + 3);
        strbuf.append(out, ": u64;\n");
        k += 1;
    }
    strbuf.append(out, "    bb0: {\n        del(move (*_1).0);\n");
    k = 0;
    while (k < n) {
        strbuf.append(out, "        _");
        strbuf.append_u64(out, k + 3);
        strbuf.append(out, " = copy _2;\n");
        k += 1;
    }
    k = 0;
    while (k < n) {
        strbuf.append(out, "        _2 = const u64 0;\n");
        k += 1;
    }
    strbuf.append(out, "        check(overwrite: (*_1).0) -> bb1;\n    }\n");
    strbuf.append(out, "    bb1: {\n        return;\n    }\n}\n");
}

// Writes into `out` the FIR text of a function with no check and 2n stores that need a proof:
// `_k = alloc`, `del(move (*_1).0)` and `(*_1).0 = move _k` for each temporary `_k`. Its work is
// 3n^2 + 2n + 2: 3n statements and one terminator times the n stores into `(*_1).0`, plus one
// block times n + 2 locals. A store into a scratch local `_k` adds nothing to the first count.
fn write_lone(u64 n, strbuf.str_buf mut* out) void {
    strbuf.clear(out);
    strbuf.append(out, "fn main.lone(_1 (b): node mut*) -> void {\n");
    u64 mut k = 0;
    while (k < n) {
        strbuf.append(out, "    let _");
        strbuf.append_u64(out, k + 2);
        strbuf.append(out, ": node mut* own;\n");
        k += 1;
    }
    strbuf.append(out, "    bb0: {\n");
    k = 0;
    while (k < n) {
        strbuf.append(out, "        _");
        strbuf.append_u64(out, k + 2);
        strbuf.append(out, " = alloc<node>(const u64 1);\n        del(move (*_1).0);\n");
        strbuf.append(out, "        (*_1).0 = move _");
        strbuf.append_u64(out, k + 2);
        strbuf.append(out, ";\n");
        k += 1;
    }
    strbuf.append(out, "        return;\n    }\n}\n");
}

// Writes into `out` the FIR text of a function with `n` owning temporaries and no check, each
// stored with `alloc` and moved into a call of `take`, as `take(new(node))` lowers: `_k = alloc`
// and `_v = call fn main.take(move _k)` for each `k`. Its work is 2n + 1: no store adds to the
// first count, because each writes a scratch local, and one block times 2n + 1 locals.
fn write_scratch(u64 n, strbuf.str_buf mut* out) void {
    strbuf.clear(out);
    strbuf.append(out, "fn main.scratch() -> void {\n");
    u64 mut k = 0;
    while (k < n) {
        strbuf.append(out, "    let _");
        strbuf.append_u64(out, 2 * k + 1);
        strbuf.append(out, ": node mut* own;\n    let _");
        strbuf.append_u64(out, 2 * k + 2);
        strbuf.append(out, ": void;\n");
        k += 1;
    }
    strbuf.append(out, "    bb0: {\n");
    k = 0;
    while (k < n) {
        strbuf.append(out, "        _");
        strbuf.append_u64(out, 2 * k + 1);
        strbuf.append(out, " = alloc<node>(const u64 1);\n        _");
        strbuf.append_u64(out, 2 * k + 2);
        strbuf.append(out, " = call fn main.take(move _");
        strbuf.append_u64(out, 2 * k + 1);
        strbuf.append(out, ");\n");
        k += 1;
    }
    strbuf.append(out, "        return;\n    }\n}\n");
}

// Parses the one function of `text`, which has no check and `n` stores that need a proof, `lvalue`
// of them into no scratch local, holds that the verifier accepts it, proves it, and holds its work
// and its verdicts: with `proved`, each store is proved; else `over` is set, and each store into
// no scratch local is unproved, but a store into a scratch local is no error (D17.11).
fn expect_store_work(lower_env.env mut* e, fir_parse.prelude pre, string text, u64 n, u64 lvalue,
                     u64 work, bool proved) void {
    fir.module mut m = fir_parse.parse_module(&e->c.m.s, "t.fir", text, pre);
    defer fir.module_free(&m);
    assert(check_env.errors(&e->c) == 0 && m.funcs.len == 1);
    fir.func* f = &m.funcs.items[0];
    pass_env.verified(e, f, "prover_test: the verifier refuses the generated function");
    prover.proof mut p = prover.prove(f);
    defer prover.free(&p);
    if (p.work != work) {
        eprintln("work ", p.work, " and not ", work);
        panic("prover_test: the work differs");
    }
    assert(p.checks == 0 && p.stores.len == n);
    if (proved) {
        assert(!p.over && p.unproved == 0);
    } else {
        assert(p.over && cast(p.unproved, u64) == lvalue);
    }
}

// Parses the one function of `text`, holds that the verifier accepts it, proves it, and holds
// its work and its verdicts: with `proved`, each check is proved; else no check is, and `over`
// is set.
fn expect_work(lower_env.env mut* e, fir_parse.prelude pre, string text, u64 work, bool proved)
    void {
    fir.module mut m = fir_parse.parse_module(&e->c.m.s, "t.fir", text, pre);
    defer fir.module_free(&m);
    assert(check_env.errors(&e->c) == 0 && m.funcs.len == 1);
    fir.func* f = &m.funcs.items[0];
    pass_env.verified(e, f, "prover_test: the verifier refuses the generated function");
    prover.proof mut p = prover.prove(f);
    defer prover.free(&p);
    if (p.work != work) {
        eprintln("work ", p.work, " and not ", work);
        panic("prover_test: the work differs");
    }
    assert(p.checks > 0);
    if (proved) {
        assert(!p.over && p.unproved == 0);
    } else {
        assert(p.over && p.unproved == p.checks);
    }
}

// The work limit, at its value, for each of its three counts: 511 elements take 1046530 work and
// are proved, 512 take 1050626 and are not; 1022 blocks take 1048573 and 1023 take 1049599; 1021
// stores into a source of 1021 temporaries take 1046534 and 1022 take 1048581; 590 temporaries,
// each with two stores and no check, take 1045482 and 591 take 1049027, and 5000 temporaries
// that a call takes take 10001. A limit equal to
// the work of a small function proves it, and a limit one less proves none of its checks.
fn the_work_limit_stops_the_proof_of_a_function() void {
    assert(prover.WORK_LIMIT == 1048576);
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    lower_env.check_lines(&e, PRELUDE[..], true);
    fir_parse.prelude pre = fir_parse.prelude{check_env.module_at(&e.c, "main"), &e.c.ck};
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    write_elements(511, &text);
    expect_work(&e, pre, strbuf.view(&text), 1046530, true);
    write_elements(512, &text);
    expect_work(&e, pre, strbuf.view(&text), 1050626, false);
    write_wide(1022, &text);
    expect_work(&e, pre, strbuf.view(&text), 1048573, true);
    write_wide(1023, &text);
    expect_work(&e, pre, strbuf.view(&text), 1049599, false);
    write_chain(1021, &text);
    expect_work(&e, pre, strbuf.view(&text), 1046534, true);
    write_chain(1022, &text);
    expect_work(&e, pre, strbuf.view(&text), 1048581, false);
    // the stores that no check stands right before count in the first count as checks do
    write_lone(590, &text);
    expect_store_work(&e, pre, strbuf.view(&text), 1180, 590, 1045482, true);
    write_lone(591, &text);
    expect_store_work(&e, pre, strbuf.view(&text), 1182, 591, 1049027, false);
    // 5000 owning temporaries, each passed on, as `take(new(node))` lowers: a work of 10001
    write_scratch(5000, &text);
    expect_store_work(&e, pre, strbuf.view(&text), 5000, 0, 10001, true);
    fir.module mut held = pass_env.parse(&e, PRELUDE[..], HELD[..]);
    defer fir.module_free(&held);
    fir.func* f = &held.funcs.items[4];
    prover.proof mut whole = prover.prove(f);
    defer prover.free(&whole);
    assert(whole.checks == 3 && whole.unproved == 0 && !whole.over && whole.work > 0);
    prover.proof mut at = prover.prove_within(f, whole.work);
    defer prover.free(&at);
    assert(at.unproved == 0 && !at.over && at.work == whole.work);
    prover.proof mut under = prover.prove_within(f, whole.work - 1);
    defer prover.free(&under);
    // past the limit, each of the three checks and each of the three stores of `h5` into no
    // scratch local is unproved; its three stores into temporaries are no error (D17.11)
    assert(under.over && under.stores.len == 6 && under.unproved == 6);
}

// The leak work adds the statements and the terminators times the owner locals that are no scratch
// local to the work of D17.11. Past the limit no exit is proved but an exit of a scratch local,
// and a named local has no obligation at a `return`. The work of D17.11 and the verdicts of the
// overwrite proof do not change below their own limit.
fn the_leak_work_stops_the_proof_of_the_exits() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    fir.module mut m = pass_env.parse(&e, PRELUDE[..], EXITS[..]);
    defer fir.module_free(&m);
    strbuf.str_buf mut got = strbuf.create();
    defer strbuf.free(&got);
    // x2: 8 statements and terminators, 1 check, 2 blocks and 3 locals: a work of 8 * 1 + 6, and
    // the fact of `n` adds 8
    fir.func* x2 = &m.funcs.items[1];
    prover.proof mut whole = prover.prove(x2);
    assert(whole.work == 14 && whole.leak_work == 22 && !whole.over && !whole.leak_over);
    prover.free(&whole);
    prover.proof mut at = prover.prove_within(x2, 22);
    write_exits(x2, &at, &got);
    assert(!at.leak_over && at.unproved == 0 && strbuf.view(&got) == "dnP rtP");
    prover.free(&at);
    prover.proof mut leak_under = prover.prove_within(x2, 21);
    write_exits(x2, &leak_under, &got);
    assert(leak_under.leak_over && !leak_under.over && leak_under.unproved == 0);
    assert(strbuf.view(&got) == "dnU rtP");
    prover.free(&leak_under);
    // past the limit of D17.11 the check and its store are unproved too
    prover.proof mut under = prover.prove_within(x2, 13);
    write_exits(x2, &under, &got);
    assert(under.over && under.leak_over && under.unproved == 2 && strbuf.view(&got) == "dnU rtP");
    prover.free(&under);
    // x4: no check and no store, so no work of D17.11; 2 * 1 + 2 with its parameter
    fir.func* x4 = &m.funcs.items[3];
    prover.proof mut param = prover.prove_within(x4, 4);
    write_exits(x4, &param, &got);
    assert(param.work == 0 && param.leak_work == 4 && !param.leak_over);
    assert(strbuf.view(&got) == "rpP");
    prover.free(&param);
    prover.proof mut param_under = prover.prove_within(x4, 3);
    write_exits(x4, &param_under, &got);
    assert(param_under.leak_over && !param_under.over && strbuf.view(&got) == "rpU");
    prover.free(&param_under);
    // x6: past the limit, the exit of a scratch local holds even when it holds an allocation
    fir.func* x6 = &m.funcs.items[5];
    prover.proof mut temp = prover.prove_within(x6, 1);
    write_exits(x6, &temp, &got);
    assert(temp.leak_work == 2 && temp.leak_over && strbuf.view(&got) == "rtP");
    prover.free(&temp);
    // x12: past the limit, a named local has no obligation at a `return`
    fir.func* x12 = &m.funcs.items[11];
    prover.proof mut named = prover.prove_within(x12, 0);
    write_exits(x12, &named, &got);
    assert(named.leak_over && strbuf.view(&got) == "rtP");
    prover.free(&named);
}

fn main() i32 {
    the_proofs_leave_the_heap_where_it_was();
    println("release ok");
    the_entry_store_makes_a_named_local_empty();
    println("entry ok");
    del_makes_its_place_empty();
    println("del ok");
    a_move_makes_its_place_and_each_place_below_it_empty();
    println("move ok");
    a_zero_store_makes_its_place_and_each_place_below_it_empty();
    println("zero ok");
    a_fresh_new_makes_each_place_through_its_pointer_empty();
    println("fresh ok");
    a_store_kills_each_fact_with_its_base_that_is_not_separate();
    println("same base ok");
    two_elements_with_one_key_are_one_place();
    println("keys ok");
    a_store_through_a_fresh_pointer_kills_only_its_base();
    println("fresh store ok");
    a_store_through_a_pointer_kills_each_fact_reached_through_memory();
    println("memory ok");
    a_call_kills_each_fact_but_those_of_a_local_that_is_no_memory();
    println("calls ok");
    the_store_of_a_check_takes_each_kill_before_it();
    println("after check ok");
    a_global_has_no_fact_at_the_entry();
    println("globals ok");
    a_held_address_reads_as_its_place();
    println("held ok");
    a_fact_holds_after_a_join_when_it_holds_on_each_edge();
    println("join ok");
    the_sets_reach_past_one_word_and_a_function_needs_no_check();
    println("bounds ok");
    two_constant_keys_with_one_value_name_one_element();
    println("constants ok");
    a_loop_carries_each_kill_around_its_back_edge();
    println("loops ok");
    a_struct_is_a_place_with_fields_below_it();
    println("aggregates ok");
    each_kind_of_store_kills_the_facts_that_the_rules_name();
    println("kill matrix ok");
    each_store_of_null_makes_its_place_empty_and_kills();
    println("zero sequence ok");
    each_read_of_the_pointer_ends_its_freshness();
    println("freshness ok");
    only_a_zero_constant_or_its_temporary_is_the_zero_value();
    println("zero values ok");
    an_index_temporary_has_the_key_of_the_local_it_copies();
    println("key shapes ok");
    the_return_place_is_no_key();
    println("return key ok");
    an_address_is_held_with_one_store_one_check_and_one_store();
    println("held shapes ok");
    only_an_address_of_fixed_storage_makes_a_local_memory();
    println("addresses ok");
    a_store_straight_into_a_local_keeps_other_locals();
    println("straight stores ok");
    a_check_takes_the_verdict_of_each_store_that_it_guards();
    println("guards ok");
    each_store_but_an_entry_zeroing_or_a_temporary_needs_a_proof();
    the_proof_lists_each_store_in_block_order();
    println("stores ok");
    the_examples_of_the_rule_hold_over_lowered_source();
    println("examples ok");
    each_exit_holds_the_obligation_of_its_owner_local();
    println("exits ok");
    each_exit_kind_of_lowered_source_has_its_obligation();
    println("exit kinds ok");
    the_work_limit_stops_the_proof_of_a_function();
    println("work ok");
    the_leak_work_stops_the_proof_of_the_exits();
    println("leak work ok");
    return 0;
}
