    "    let _2: node mut* own mut*;",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        _2 = addr mut((*_1).0);",
    "        check(overwrite: (*_2)) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_2) = call fn main.fill(copy _1);",
    "        return;",
    "    }",
    "}",
    // a call into a temporary, and then the store of the check: U
    "fn main.cs4(_1 (b): node mut*) -> void {",
    "    let _2: node mut* own;",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
