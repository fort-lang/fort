    "fn main.h6() -> void {",
    "    let _1 (s): node;",
    "    let _2: node mut* own mut*;",
    "    let _3: node mut* own;",
    "    let _4: void;",
    "    bb0: {",
    "        _1 = const zero node;",
    "        _2 = addr mut(_1.0);",
    "        _4 = call fn main.g();",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_2)) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_2) = move _3;",
    "        return;",
    "    }",
    "}",
    // an address with a third read makes the local memory: U
    "fn main.h7() -> void {",
    "    let _1 (s): node;",
    "    let _2: node mut* own mut*;",
    "    let _3: node mut* own;",
    "    let _4: void;",
    "    let _5: node mut* own mut*;",
    "    bb0: {",
    "        _1 = const zero node;",
    "        _2 = addr mut(_1.0);",
    "        _5 = copy _2;",
    "        _4 = call fn main.g();",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: _1.0) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1.0 = move _3;",
    "        return;",
    "    }",
    "}",
};

string[7] HELD_VERDICTS = {"P/P", "U/P", "U/P", "PU/PP", "PPP/PPP", "U/P", "U/P"};

// An address of fixed storage is no held address, so a store through it writes a memory local, and
// the pass takes no value of that local from its one store. A held address that is memory is no
// held address either.
string[72] HELD_STORE = {
    // the store through the address gives the temporary another value, and the move of it is no
    // fresh new: PPPU
    "fn main.h8() -> void {",
    "    let _1 (n): node mut* own;",
    "    let _2: node mut* own;",
    "    let _3: node mut* own mut*;",
    "    let _4: node mut* own;",
    "    let _5: node mut* own;",
    "    let _6: node mut* own;",
    "    bb0: {",
    "        _1 = const zero node mut* own;",
    "        _2 = alloc<node>(const u64 1);",
    "        _3 = addr mut(_2);",
    "        _4 = alloc<node>(const u64 1);",
    "        _5 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_4).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_4).0 = move _5;",
    "        del(move (*_3));",
    "        check(overwrite: (*_3)) -> bb2;",
    "    }",
    "    bb2: {",
    "        (*_3) = move _4;",
    "        check(overwrite: _1) -> bb3;",
    "    }",
    "    bb3: {",
    "        _1 = move _2;",
    "        _6 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).0) -> bb4;",
    "    }",
    "    bb4: {",
    "        (*_1).0 = move _6;",
    "        return;",
    "    }",
    "}",
    // an address of the held address makes it memory, so the check reads its own place: U
    "fn main.h9(_1 (b): node mut*) -> void {",
    "    let _2: node mut* own mut*;",
    "    let _3: node mut* own;",
    "    let _4: node mut* own mut**;",
    "    bb0: {",
    "        _2 = addr mut((*_1).0);",
    "        _4 = addr(_2);",
    "        del(move (*_1).0);",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_2)) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_2) = move _3;",
    "        return;",
    "    }",
    "}",
    // an address of fixed storage is no held address, so the `del` through it gives no fact to
    // the local: UU
    "fn main.h10() -> void {",
    "    let _1: node mut* own;",
    "    let _2: node mut* own mut*;",
    "    let _3: node mut* own;",
    "    let _4: node mut* own;",
    "    bb0: {",
    "        _1 = alloc<node>(const u64 1);",
    "        _2 = addr mut(_1);",
    "        del(move (*_2));",
    "        _4 = alloc<node>(const u64 1);",
    "        check(overwrite: _1) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1 = move _4;",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_2)) -> bb2;",
    "    }",
    "    bb2: {",
    "        (*_2) = move _3;",
    "        return;",
    "    }",
    "}",
};

string[3] HELD_STORE_VERDICTS = {"PPPU/PPPP", "U/P", "UU/PPP"};

// A store into a local that the place of a held address reads makes the address stale. A stale
// held address gives no tracked place, so the pass proves no check of it, and a `move` through it
// gives no fact. A store through it keeps no fact through a fresh pointer, because the `addr` of
// the held address ended no freshness. One edge that makes the address stale makes it stale
// after the join.
string[154] HELD_STALE = {
    // a store into the base of the place: PU
    "fn main.s1() -> void {",
    "    let _1: node mut* own;",
    "    let _2: node mut* own mut*;",
    "    let _3: node mut* own;",
    "    let _4: node mut* own;",
    "    let _5: node mut* own;",
    "    bb0: {",
    "        _1 = alloc<node>(const u64 1);",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_1).0 = move _3;",
    "        _2 = addr mut((*_1).0);",
    "        _5 = move _1;",
    "        _1 = alloc<node>(const u64 1);",
    "        _4 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_2)) -> bb2;",
    "    }",
    "    bb2: {",
    "        (*_2) = move _4;",
    "        return;",
    "    }",
    "}",
    // a store into the index of the place: PU
    "fn main.s2() -> void {",
    "    let _1: node mut* own;",
    "    let _2 (i): u64;",
    "    let _3: node mut* own;",
    "    let _4: node mut* own mut*;",
    "    let _5: node mut* own;",
    "    bb0: {",
    "        _2 = const u64 0;",
    "        _1 = alloc<node>(const u64 1);",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).2[_2]) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_1).2[_2] = move _3;",
    "        _4 = addr mut((*_1).2[_2]);",
    "        _2 = const u64 1;",
    "        del(move (*_1).2[_2]);",
    "        _5 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_4)) -> bb2;",
    "    }",
    "    bb2: {",
    "        (*_4) = move _5;",
    "        return;",
    "    }",
    "}",
    // the store through the stale address kills the fact through the fresh pointer: UU
    "fn main.s3() -> void {",
    "    let _1: node mut* own;",
    "    let _2 (i): u64;",
    "    let _3 (j): u64;",
    "    let _4: node mut* own mut*;",
    "    let _5: node mut* own;",
    "    let _6: node mut* own;",
    "    bb0: {",
    "        _2 = const u64 0;",
    "        _3 = const u64 0;",
    "        _1 = alloc<node>(const u64 1);",
    "        _4 = addr mut((*_1).2[_2]);",
    "        _2 = const u64 1;",
    "        _5 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_4)) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_4) = move _5;",
    "        _6 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).2[_3]) -> bb2;",
    "    }",
    "    bb2: {",
    "        (*_1).2[_3] = move _6;",
    "        return;",
    "    }",
    "}",
    // a stale held address gives no tracked place, so the move through it gives no fact that a
    // store through the fresh pointer keeps: PU
    "fn main.s4() -> void {",
    "    let _1: node mut* own;",
    "    let _2 (i): u64;",
    "    let _3 (j): u64;",
    "    let _4: node mut* own mut*;",
    "    let _5: node mut* own;",
    "    let _6: node mut* own;",
    "    let _7: node mut* own;",
    "    bb0: {",
    "        _2 = const u64 0;",
    "        _3 = const u64 0;",
    "        _1 = alloc<node>(const u64 1);",
    "        _4 = addr mut((*_1).2[_2]);",
    "        _2 = const u64 1;",
    "        _7 = move (*_4);",
    "        _6 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).2[_3]) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_1).2[_3] = move _6;",
    "        _5 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_4)) -> bb2;",
    "    }",
    "    bb2: {",
