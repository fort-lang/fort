//! run
//! flags: -I ../../src -I support
//! stdout:
//| release ok
//| entry ok
//| del ok
//| move ok
//| zero ok
//| fresh ok
//| same base ok
//| keys ok
//| fresh store ok
//| memory ok
//| calls ok
//| after check ok
//| globals ok
//| held ok
//| join ok
//| bounds ok
//| constants ok
//| loops ok
//| aggregates ok
//| kill matrix ok
//| zero sequence ok
//| freshness ok
//| zero values ok
//| key shapes ok
//| return key ok
//| held shapes ok
//| addresses ok
//| straight stores ok
//| guards ok
//| stores ok
//| examples ok
//| exits ok
//| exit kinds ok
//| work ok
//| leak work ok
//| inners ok
//| inner kinds ok
//| inner work ok
//| inner order ok
//| inner scale ok
//| inner doubling ok
//| null edges ok
//| null kinds ok
/// Checks owner.prover, the proof of each overwrite check (spec/fir.md 11). Each gen rule, each
/// kill rule and each definition of the rule has a group of cases over FIR text, and each group
/// holds a case that the pass proves and a case that it does not prove. The examples of the rule
/// then run over lowered fort source. report_test checks the report of each check that the pass
/// does not prove.
import check_env;
import fort.fir;
import fir_env;
import fort.fir_lower;
import fort.fir_parse;
import fort.owner.place;
import fort.owner.prover;
import fort.owner.report;
import heap;
import lower_env;
import pass_env;
import fort.session;
import fort.types;
import std.str;
import std.strbuf;

// The types, the globals and the functions that the FIR text of each case names. A `node` has
// two owning fields, a fixed array of two owning pointers and an owning span of them. A `pair`
// has two owning fields. A `bin` has an owning field and a fixed array of two owning pointers, its
// three inner owners, and a `holder` has an owning pointer to a `bin`. A `shelf` has nine inner
// owners: the three of each of its two `bin`s, an owning `string`, an owning `void*` and an owning
// span, and a pointer that does not own. A `big` has 2^32 + 1 inner owners, past
// types.OWNER_CAP. A `plain` has no inner owner, and a `label` has one, an owning `string`. A
// `wide` has 170000 inner owners in a fixed array and a `wide2` 100000, and a `deep` 101000 in
// 1000 `block`s of 101, each under the limit of the inner work. The chain `c0` to `c9` holds 50000
// inner owners at the end of 11 steps, past the limit.
string[108] PRELUDE = {
    "struct node {",
    "    node mut* own left;",
    "    node mut* own right;",
    "    node mut* own[2] kids;",
    "    node mut* own mut@ own list;",
    "}",
    "node mut* own mut G = null;",
    "node mut* own mut H = null;",
    "struct pair {",
    "    node mut* own a;",
    "    node mut* own b;",
    "}",
    "pair mut S = pair{};",
    "fn g() void {",
    "}",
    "fn take(node mut* own n) void {",
    "    del(n);",
    "}",
    "fn make() node mut* own {",
    "    return new(node);",
    "}",
    "fn fill(node mut* n) node mut* own {",
    "    del(n->left);",
    "    n->left = new(node);",
    "    return new(node);",
    "}",
    "fn poke(node mut* n) void {",
    "    del(n->left);",
    "    n->left = new(node);",
    "}",
    "extern fn ext_touch(node mut* n) i32;",
    "fn make_pair() pair {",
    "    return pair{};",
    "}",
    "fn pick() u64 {",
    "    return 1;",
    "}",
    "fn put(node mut* own mut* p) void {",
    "    del(*p);",
    "    *p = new(node);",
    "}",
    "struct bin {",
    "    i32 mut* own a;",
    "    i32 mut* own[2] e;",
    "}",
    "struct holder {",
    "    bin mut* own b;",
    "}",
    "struct shelf {",
    "    bin[2] bins;",
    "    string own name;",
    "    void* own any;",
    "    i32* view;",
    "    bin mut@ own list;",
    "}",
    "struct big {",
    "    i32 mut* own[4294967297] e;",
    "}",
    "struct plain {",
    "    i32 v;",
    "    i32* w;",
    "}",
    "struct label {",
    "    string own text;",
    "}",
    "struct wide {",
    "    i32 mut* own[170000] e;",
    "}",
    "struct wide2 {",
    "    i32 mut* own[100000] e;",
    "}",
    "struct block {",
    "    i32 mut* own[100] e;",
    "    i32 mut* own f;",
    "}",
    "struct deep {",
    "    block[1000] blocks;",
    "}",
    "struct c0 {",
    "    c1 n;",
    "}",
    "struct c1 {",
    "    c2 n;",
    "}",
    "struct c2 {",
    "    c3 n;",
    "}",
    "struct c3 {",
    "    c4 n;",
    "}",
    "struct c4 {",
    "    c5 n;",
    "}",
    "struct c5 {",
    "    c6 n;",
    "}",
    "struct c6 {",
    "    c7 n;",
    "}",
    "struct c7 {",
    "    c8 n;",
    "}",
    "struct c8 {",
    "    c9 n;",
    "}",
    "struct c9 {",
    "    i32 mut* own[50000] e;",
    "}",
};

// ---- the cases over FIR text ----------------------------------------------------------------

// Each group is a FIR module and the verdicts of its functions: the verdict of each check of a
// function, in block order, `P` for a check that the pass proves and `U` for one that it does
// not prove. After a `/` come the verdicts of the stores that need a proof and that no check
// stands right before (write_verdicts). The comment of a case gives the verdicts of its checks,
// and of its stores when the case is about them.

// The store of the zero value in the entry block makes a named local empty.
string[39] ENTRY = {
    // the entry block zeroes the named local: P
    "fn main.e1() -> void {",
    "    let _1 (p): node mut* own;",
    "    let _2: node mut* own;",
    "    bb0: {",
    "        _1 = const zero node mut* own;",
    "        _2 = alloc<node>(const u64 1);",
    "        check(overwrite: _1) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1 = move _2;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // a parameter has no store in the entry block: U
    "fn main.e2(_1 (p): node mut* own) -> void {",
    "    let _2: node mut* own;",
    "    bb0: {",
    "        _2 = alloc<node>(const u64 1);",
    "        check(overwrite: _1) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1 = move _2;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // a named local with no store in the entry block: U
    "fn main.e3() -> void {",
    "    let _1 (p): node mut* own;",
    "    let _2: node mut* own;",
    "    bb0: {",
    "        _2 = alloc<node>(const u64 1);",
    "        check(overwrite: _1) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1 = move _2;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
};

string[3] ENTRY_VERDICTS = {"P/P", "U/P", "U/P"};

// `del(move p)` makes `p` empty, and only `p`.
string[47] DEL = {
    // del of the field before the store: P
    "fn main.d1(_1 (b): node mut*) -> void {",
    "    let _2: node mut* own;",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        _2 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_1).0 = move _2;",
    "        return;",
    "    }",
    "}",
    // no del: the entry value of the field is not known: U
    "fn main.d2(_1 (b): node mut*) -> void {",
    "    let _2: node mut* own;",
    "    bb0: {",
    "        _2 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_1).0 = move _2;",
    "        return;",
    "    }",
    "}",
    // del of the other field: U
    "fn main.d3(_1 (b): node mut*) -> void {",
    "    let _2: node mut* own;",
    "    bb0: {",
    "        del(move (*_1).1);",
    "        _2 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_1).0 = move _2;",
    "        return;",
    "    }",
    "}",
    // del(*out) before *out = move(buf): P
    "fn main.d4(_1 (out): node mut* own mut*) -> void {",
    "    let _2: node mut* own;",
    "    bb0: {",
    "        del(move (*_1));",
    "        _2 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1)) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_1) = move _2;",
    "        return;",
    "    }",
    "}",
};

string[4] DEL_VERDICTS = {"P/P", "U/P", "U/P", "P/P"};

// A `move` operand makes its place and each tracked place below it empty.
string[82] MOVE = {
    // a move of the local after a store into it: PP
    "fn main.m1(_1 (x): node mut* own) -> void {",
    "    let _2 (p): node mut* own;",
    "    let _3: node mut* own;",
    "    bb0: {",
    "        _2 = const zero node mut* own;",
    "        check(overwrite: _2) -> bb1;",
    "    }",
    "    bb1: {",
    "        _2 = move _1;",
    "        _3 = move _2;",
    "        check(overwrite: _2) -> bb2;",
    "    }",
    "    bb2: {",
    "        _2 = move _3;",
    "        del(move _2);",
    "        return;",
    "    }",
    "}",
    // no move after the store: PU
    "fn main.m2(_1 (x): node mut* own) -> void {",
    "    let _2 (p): node mut* own;",
    "    let _3: node mut* own;",
    "    bb0: {",
    "        _2 = const zero node mut* own;",
    "        check(overwrite: _2) -> bb1;",
    "    }",
    "    bb1: {",
    "        _2 = move _1;",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: _2) -> bb2;",
    "    }",
    "    bb2: {",
    "        _2 = move _3;",
    "        del(move _2);",
    "        return;",
    "    }",
    "}",
    // a move of a struct: its field and an element of its fixed array, not a span element: PPU
    "fn main.m3(_1 (s): node, _2 (k): u64) -> void {",
    "    let _3: node;",
    "    let _4: node mut* own;",
    "    let _5: node mut* own;",
    "    let _6: node mut* own;",
    "    bb0: {",
    "        _3 = move _1;",
    "        _4 = alloc<node>(const u64 1);",
    "        check(overwrite: _1.0) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1.0 = move _4;",
    "        _5 = alloc<node>(const u64 1);",
    "        check(overwrite: _1.2[_2]) -> bb2;",
    "    }",
    "    bb2: {",
    "        _1.2[_2] = move _5;",
    "        _6 = alloc<node>(const u64 1);",
    "        check(overwrite: _1.3[_2]) -> bb3;",
    "    }",
    "    bb3: {",
    "        _1.3[_2] = move _6;",
    "        return;",
    "    }",
    "}",
    // the read of the move comes before the kill of the store: PU
    "fn main.m4() -> void {",
    "    let _1 (p): node mut* own;",
    "    let _2: node mut* own;",
    "    let _3: node mut* own;",
    "    bb0: {",
    "        _1 = const zero node mut* own;",
    "        _2 = alloc<node>(const u64 1);",
    "        check(overwrite: _1) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1 = move _2;",
    "        _1 = move _1;",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: _1) -> bb2;",
    "    }",
    "    bb2: {",
    "        _1 = move _3;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
};

string[4] MOVE_VERDICTS = {"PP/P", "PU/P", "PPU/PPP", "PU/PPP"};

// A store of the zero value makes its place and each tracked place below it empty.
string[112] ZERO = {
    // the move of a temporary that holds the zero value: UP
    "fn main.z1(_1 (b): node mut*) -> void {",
    "    let _2: node mut* own;",
    "    let _3: node mut* own;",
    "    bb0: {",
    "        _2 = const zero node mut* own;",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_1).0 = move _2;",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).0) -> bb2;",
    "    }",
    "    bb2: {",
    "        (*_1).0 = move _3;",
    "        return;",
    "    }",
    "}",
    // a store of null: P
    "fn main.z2(_1 (b): node mut*) -> void {",
    "    let _2: node mut* own;",
    "    bb0: {",
    "        (*_1).0 = const null node mut* own;",
    "        _2 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_1).0 = move _2;",
    "        return;",
    "    }",
    "}",
    // an aggregate of zero constants: a field and an element of a fixed array below it: PP
    "fn main.z3() -> void {",
    "    let _1 (s): node;",
