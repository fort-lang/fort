    "        return;",
    "    }",
    "}",
    // a store into the index on one edge makes the held address stale after the join: U
    "fn main.s6(_1 (b): node mut*, _2 (c): bool) -> void {",
    "    let _3 (i): u64;",
    "    let _4: node mut* own mut*;",
    "    let _5: node mut* own;",
    "    bb0: {",
    "        _3 = const u64 0;",
    "        _4 = addr mut((*_1).2[_3]);",
    "        switch(copy _2) -> [true: bb1, otherwise: bb2];",
    "    }",
    "    bb1: {",
