};

string[3] HELD_STORE_VERDICTS = {"PPPU/PPPP", "U/P", "UU/PPP"};

// A store into a local that the place of a held address reads makes the address stale. A stale
// held address gives no tracked place, so the pass proves no check of it, and a `move` through it
// gives no fact. A store through it keeps no fact through a fresh pointer, because the `addr` of
// the held address ended no freshness. One edge that makes the address stale makes it stale
// after the join.
