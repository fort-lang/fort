string[6] HELD_STALE_VERDICTS = {"PU/PPPPP", "PU/PPP", "UU/PPP", "PU/PPPP", "UU/PPP", "U/P"};

// A call, a store through a pointer and a store straight into a memory local or a global make
// each held address stale: they can change a span header that the place of the address reads,
// with no store into a local. A `move` operand and a `del` make no held address stale, and a call
// before the `addr` makes none stale either. In m8 and m9 the run is outside the guarantee of
// D17.11, so the pass proves the check: the `del` of the header frees the storage that the held
// address names, and the `move` of field 0 of the header leaves `null` with the length (D10.7).
string[176] HELD_MEMORY = {
    // a call: U
    "fn main.m1(_1 (b): node mut*, _2 (i): u64) -> void {",
    "    let _3: node mut* own mut*;",
    "    let _4: void;",
    "    let _5: node mut* own;",
    "    let _6: node mut* own;",
    "    bb0: {",
    "        _3 = addr mut((*_1).3[_2]);",
    "        _4 = call fn main.g();",
    "        _5 = move (*_1).3[_2];",
    "        _6 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_3)) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_3) = move _6;",
    "        del(move _5);",
    "        return;",
    "    }",
    "}",
    // a store through a pointer that names no span header: U
    "fn main.m2(_1 (b): node mut*, _2 (i): u64, _3 (k): u64 mut*) -> void {",
    "    let _4: node mut* own mut*;",
    "    let _5: node mut* own;",
    "    let _6: node mut* own;",
    "    bb0: {",
    "        _4 = addr mut((*_1).3[_2]);",
    "        (*_3) = const u64 1;",
    "        _5 = move (*_1).3[_2];",
    "        _6 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_4)) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_4) = move _6;",
    "        del(move _5);",
    "        return;",
    "    }",
    "}",
    // a store straight into a memory local: U
    "fn main.m3(_1 (b): node mut*, _2 (i): u64) -> void {",
    "    let _3 (k): u64;",
    "    let _4: u64 mut*;",
    "    let _5: node mut* own mut*;",
    "    let _6: node mut* own;",
    "    let _7: node mut* own;",
    "    bb0: {",
    "        _3 = const u64 0;",
    "        _4 = addr mut(_3);",
    "        _5 = addr mut((*_1).3[_2]);",
    "        _3 = const u64 1;",
    "        _6 = move (*_1).3[_2];",
    "        _7 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_5)) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_5) = move _7;",
    "        del(move _6);",
    "        return;",
    "    }",
    "}",
    // a store straight into a global: U
    "fn main.m4(_1 (b): node mut*, _2 (i): u64) -> void {",
    "    let _3: node mut* own mut*;",
    "    let _4: node mut* own;",
    "    let _5: node mut* own;",
    "    bb0: {",
    "        _3 = addr mut((*_1).3[_2]);",
    "        global main.S.0 = const null node mut* own;",
    "        _4 = move (*_1).3[_2];",
    "        _5 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_3)) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_3) = move _5;",
    "        del(move _4);",
    "        return;",
    "    }",
    "}",
    // a `move` and a `del` through memory make no held address stale: P
    "fn main.m5(_1 (b): node mut*, _2 (i): u64, _3 (j): u64) -> void {",
