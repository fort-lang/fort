// A loop carries a kill, a store into a key local and an end of freshness around its back edge.
string[198] LOOPS = {
    // a copy of the key before the loop and a store into the key in its body: U
    "fn main.l1(_1 (v): node mut*, _2 (k): u64, _3 (c): bool) -> void {",
    "    let _4: u64;",
    "    let _5: u64;",
    "    bb0: {",
    "        _4 = copy _2;",
    "        goto bb1;",
    "    }",
    "    bb1: {",
    "        switch(copy _3) -> [true: bb2, otherwise: bb3];",
    "    }",
    "    bb2: {",
    "        _2 = const u64 1;",
    "        goto bb1;",
    "    }",
    "    bb3: {",
    "        _5 = copy _2;",
    "        del(move (*_1).3[_5]);",
    "        check(overwrite: (*_1).3[_4]) -> bb4;",
    "    }",
    "    bb4: {",
    "        return;",
    "    }",
    "}",
    // the same loop with no store into the key: P
    "fn main.l2(_1 (v): node mut*, _2 (k): u64, _3 (c): bool) -> void {",
    "    let _4: u64;",
    "    let _5: u64;",
    "    let _6: u64;",
    "    bb0: {",
    "        _4 = copy _2;",
    "        goto bb1;",
    "    }",
    "    bb1: {",
    "        switch(copy _3) -> [true: bb2, otherwise: bb3];",
    "    }",
    "    bb2: {",
    "        _6 = const u64 1;",
    "        goto bb1;",
    "    }",
    "    bb3: {",
    "        _5 = copy _2;",
    "        del(move (*_1).3[_5]);",
    "        check(overwrite: (*_1).3[_4]) -> bb4;",
    "    }",
    "    bb4: {",
    "        return;",
    "    }",
    "}",
    // a fresh pointer in the loop: a store through a parameter keeps its fact: P
    "fn main.l3(_1 (c): bool, _2 (q): node mut*) -> void {",
    "    let _3 (n): node mut* own;",
    "    let _4: node mut* own;",
    "    let _5: node mut* own;",
    "    bb0: {",
    "        _3 = const zero node mut* own;",
    "        _4 = alloc<node>(const u64 1);",
    "        _3 = move _4;",
    "        goto bb1;",
    "    }",
    "    bb1: {",
    "        switch(copy _1) -> [true: bb2, otherwise: bb4];",
    "    }",
    "    bb2: {",
    "        del(move (*_3).1);",
    "        _5 = alloc<node>(const u64 1);",
    "        (*_2).0 = move _5;",
    "        check(overwrite: (*_3).1) -> bb3;",
    "    }",
    "    bb3: {",
    "        goto bb1;",
    "    }",
    "    bb4: {",
    "        del(move _3);",
    "        return;",
    "    }",
    "}",
    // the same loop with a copy of the pointer on the back edge: U
    "fn main.l4(_1 (c): bool, _2 (q): node mut*) -> void {",
    "    let _3 (n): node mut* own;",
    "    let _4: node mut* own;",
    "    let _5: node mut* own;",
    "    let _6: node mut*;",
    "    bb0: {",
    "        _3 = const zero node mut* own;",
    "        _4 = alloc<node>(const u64 1);",
    "        _3 = move _4;",
    "        goto bb1;",
    "    }",
    "    bb1: {",
    "        switch(copy _1) -> [true: bb2, otherwise: bb4];",
    "    }",
    "    bb2: {",
    "        del(move (*_3).1);",
    "        _5 = alloc<node>(const u64 1);",
    "        (*_2).0 = move _5;",
    "        check(overwrite: (*_3).1) -> bb3;",
    "    }",
    "    bb3: {",
    "        _6 = copy _3;",
    "        goto bb1;",
    "    }",
    "    bb4: {",
    "        del(move _3);",
    "        return;",
    "    }",
    "}",
    // a loop whose body deletes the local on one path only: U
    "fn main.l5(_1 (c): bool, _2 (d): bool) -> void {",
    "    let _3 (p): node mut* own;",
    "    let _4: node mut* own;",
    "    bb0: {",
    "        _3 = const zero node mut* own;",
    "        goto bb1;",
    "    }",
    "    bb1: {",
    "        switch(copy _1) -> [true: bb2, otherwise: bb6];",
    "    }",
    "    bb2: {",
    "        _4 = alloc<node>(const u64 1);",
    "        check(overwrite: _3) -> bb3;",
    "    }",
    "    bb3: {",
    "        _3 = move _4;",
    "        switch(copy _2) -> [true: bb4, otherwise: bb5];",
    "    }",
    "    bb4: {",
