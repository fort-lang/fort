    "        check(overwrite: (*_4).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_4).0 = move _5;",
    "        del(move (*_3));",
    "        check(overwrite: (*_3)) -> bb2;",
    "    }",
    "    bb2: {",
    "        (*_3) = move _4;",
    "        check(overwrite: _1) -> bb3;",
    "    }",
    "    bb3: {",
