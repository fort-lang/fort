    "        check(overwrite: (*_1).2[_2]) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_1).2[_2] = move _5;",
    "        _6 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_3)) -> bb2;",
    "    }",
    "    bb2: {",
