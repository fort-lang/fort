    "        global main.G = move _3;",
    "        _4 = call fn main.take(move _1);",
    "        _5 = alloc<node>(const u64 1);",
    "        check(overwrite: _1) -> bb2;",
    "    }",
    "    bb2: {",
    "        _1 = move _5;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
};

string[5] CALLS_VERDICTS = {"P/P", "UU/PP", "U/P", "U/PPP", "UP/PP"};

// The first statement of the continuation block of a check runs after the check and before the
// store writes. The store takes each kill rule of each statement before it, and the kill of its
// own call, before its test, and the check takes the verdict of the store (spec/fir.md 11,
// Proof). A store into another place than the place of the check has a verdict of its own.
string[266] AFTER_CHECK = {
    // a call into the place of the check through a fresh pointer: U
    "fn main.cs1() -> void {",
    "    let _1 (n): node mut* own;",
    "    let _2: node mut* own;",
    "    bb0: {",
    "        _1 = const zero node mut* own;",
    "        _2 = alloc<node>(const u64 1);",
    "        _1 = move _2;",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_1).0 = call fn main.fill(copy _1);",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // a call into a local that is no memory, which no call can fill: P
    "fn main.cs2() -> void {",
    "    let _1 (p): node mut* own;",
    "    bb0: {",
    "        _1 = const zero node mut* own;",
    "        check(overwrite: _1) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1 = call fn main.make();",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // a call into a held address: U
