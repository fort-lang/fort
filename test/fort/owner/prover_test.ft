    "        return;",
    "    }",
    "}",
    // a `move` of field 0 of the header: the next `index` dereferences `null`: P
    "fn main.m9(_1 (b): node mut*, _2 (i): u64) -> void {",
    "    let _3: node mut* own mut*;",
    "    let _4: node mut* own mut* own;",
    "    let _5: node mut* own;",
    "    let _6: node mut* own;",
    "    bb0: {",
