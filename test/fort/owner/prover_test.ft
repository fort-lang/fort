string[20] GUARDS_VERDICTS = {
    "U/U", "U/U", "P/PP", "U/PPU", "P/PPU", "P", "U/PP", "U/P", "UU/U", "U/U", "P/PP", "P/PP",
    "P/PU", "U/PU", "P/PP", "U/PPU", "U/PPU", "U/PPU", "U/P", "U/PPU",
};

