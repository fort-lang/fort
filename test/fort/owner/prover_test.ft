// A store straight into a memory local or a global keeps the facts of other locals and globals,
// and kills each fact through a pointer that can hold its address.
string[106] STRAIGHT = {
    // into a memory local: the facts of another memory local and of a global stay: PP
    "fn main.k1(_1 (v): node mut* own) -> void {",
    "    let _2 (x): node;",
