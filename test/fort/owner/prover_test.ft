// Two constant keys name one element when their values are equal.
string[81] CONSTANTS = {
    // the largest u64 in both keys: P
    "fn main.n1(_1 (v): node mut* own[2] mut*) -> void {",
    "    let _2: u64;",
    "    let _3: u64;",
    "    bb0: {",
    "        _2 = const u64 0xFFFFFFFFFFFFFFFF;",
    "        del(move (*_1)[_2]);",
    "        _3 = const u64 0xFFFFFFFFFFFFFFFF;",
    "        check(overwrite: (*_1)[_3]) -> bb1;",
    "    }",
    "    bb1: {",
    "        return;",
    "    }",
    "}",
    // the largest u64 and a cast of -1: two values, so no proof: U
    "fn main.n2(_1 (v): node mut* own[2] mut*) -> void {",
    "    let _2: u64;",
    "    let _3: u64;",
    "    bb0: {",
    "        _2 = cast<u64>(const i64 -1);",
    "        del(move (*_1)[_2]);",
    "        _3 = const u64 0xFFFFFFFFFFFFFFFF;",
    "        check(overwrite: (*_1)[_3]) -> bb1;",
    "    }",
    "    bb1: {",
    "        return;",
    "    }",
    "}",
    // a cast of u8 255 and u64 255: P
    "fn main.n3(_1 (v): node mut* own[2] mut*) -> void {",
    "    let _2: u64;",
    "    let _3: u64;",
    "    bb0: {",
    "        _2 = cast<u64>(const u8 255);",
    "        del(move (*_1)[_2]);",
    "        _3 = const u64 255;",
    "        check(overwrite: (*_1)[_3]) -> bb1;",
    "    }",
    "    bb1: {",
    "        return;",
    "    }",
    "}",
    // zero in both keys: P
    "fn main.n4(_1 (v): node mut* own[2] mut*) -> void {",
    "    let _2: u64;",
    "    let _3: u64;",
    "    bb0: {",
    "        _2 = const u64 0;",
    "        del(move (*_1)[_2]);",
    "        _3 = cast<u64>(const i32 0);",
    "        check(overwrite: (*_1)[_3]) -> bb1;",
    "    }",
    "    bb1: {",
    "        return;",
    "    }",
    "}",
    // two negative constants of two types: P
    "fn main.n6(_1 (v): node mut* own[2] mut*) -> void {",
    "    let _2: u64;",
    "    let _3: u64;",
    "    bb0: {",
    "        _2 = cast<u64>(const i8 -1);",
    "        del(move (*_1)[_2]);",
    "        _3 = cast<u64>(const i64 -1);",
    "        check(overwrite: (*_1)[_3]) -> bb1;",
    "    }",
    "    bb1: {",
    "        return;",
    "    }",
    "}",
    // a store into an element with another constant key kills the fact: the indexes are not
    // separate: U
    "fn main.n5(_1 (v): node mut* own[2] mut*) -> void {",
    "    let _2: u64;",
    "    let _3: u64;",
    "    let _4: node mut* own;",
    "    bb0: {",
    "        _2 = const u64 0;",
    "        del(move (*_1)[_2]);",
    "        _3 = const u64 1;",
    "        _4 = alloc<node>(const u64 1);",
    "        (*_1)[_3] = move _4;",
    "        check(overwrite: (*_1)[_2]) -> bb1;",
    "    }",
    "    bb1: {",
    "        return;",
    "    }",
    "}",
};

