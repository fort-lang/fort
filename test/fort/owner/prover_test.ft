// Structs as places: a pointee moved whole, an aggregate result and a global struct.
string[88] AGGREGATES = {
    // a move of a pointee makes its fields empty, but no element of its span: PPU
    "fn main.a1(_1 (b): node mut*, _2 (k): u64) -> void {",
    "    let _3: node;",
    "    bb0: {",
    "        _3 = move (*_1);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        check(overwrite: (*_1).2[_2]) -> bb2;",
    "    }",
    "    bb2: {",
    "        check(overwrite: (*_1).3[_2]) -> bb3;",
    "    }",
    "    bb3: {",
    "        return;",
    "    }",
    "}",
    // an aggregate result is memory: a call kills its fact: U
    "fn main.a2() -> node {",
    "    let _1: void;",
    "    bb0: {",
    "        _0 = const zero node;",
    "        _1 = call fn main.g();",
    "        check(overwrite: _0.0) -> bb1;",
    "    }",
    "    bb1: {",
    "        return;",
    "    }",
    "}",
    // the same result with no call: P
    "fn main.a3() -> node {",
    "    bb0: {",
    "        _0 = const zero node;",
    "        check(overwrite: _0.0) -> bb1;",
    "    }",
    "    bb1: {",
    "        return;",
    "    }",
    "}",
    // a store into a separate field of a global struct keeps the fact: P
    "fn main.a4(_1 (x): node mut* own) -> void {",
    "    bb0: {",
    "        del(move global main.S.0);",
    "        global main.S.1 = move _1;",
    "        check(overwrite: global main.S.0) -> bb1;",
    "    }",
    "    bb1: {",
    "        return;",
    "    }",
    "}",
    // a store into another global keeps it: P
    "fn main.a5(_1 (x): node mut* own) -> void {",
    "    bb0: {",
    "        del(move global main.S.0);",
    "        global main.G = move _1;",
    "        check(overwrite: global main.S.0) -> bb1;",
    "    }",
    "    bb1: {",
    "        return;",
    "    }",
    "}",
    // a store through a pointer kills the fact of a global: U
    "fn main.a6(_1 (b): node mut*, _2 (x): node mut* own) -> void {",
    "    bb0: {",
