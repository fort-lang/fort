    "        _6 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).0) -> bb4;",
    "    }",
    "    bb4: {",
    "        (*_1).0 = move _6;",
    "        return;",
    "    }",
    "}",
    // an address of the held address makes it memory, so the check reads its own place: U
    "fn main.h9(_1 (b): node mut*) -> void {",
