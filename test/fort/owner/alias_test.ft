    "        del(move (*_1).0);",
    "        _4 = addr mut((*_1).0);",
    "        _5 = alloc<i32>(const u64 1);",
    "        check(overwrite: (*_4)) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_4) = move _5;",
    "        _6 = alloc<i32>(const u64 1);",
    "        check(overwrite: _2) -> bb2;",
    "    }",
    "    bb2: {",
    "        _2 = move _6;",
    "        del(move _2);",
    "        return;",
    "    }",
    "}",
    // a call through a value exposes the frames that its callee operand borrows: the copy of the
    // field `f` of the borrow local `h` borrows the origins of `h`, which hold the frame of `x`: U
    "fn main.b16(_1 (q): i32 mut* own mut*) -> void {",
    "    let _2 (x): i32 mut* own;",
    "    let _3: i32 mut* own mut*;",
    "    let _4: i32 mut* own;",
    "    let _5: i32 mut* own;",
    "    let _6: i32 mut* own mut*;",
    "    let _7 (h): hook;",
    "    let _8: fn (i32 mut* own mut*) void;",
    "    let _9: void;",
    "    bb0: {",
    "        _2 = const zero i32 mut* own;",
    "        _3 = addr mut(_2);",
    "        _7 = aggregate hook(const fn main.keep, copy _3);",
    "        _8 = copy _7.0;",
    "        _9 = call copy _8(copy _1);",
    "        del(move _2);",
    "        _6 = copy global main.P;",
    "        del(move (*_6));",
    "        _4 = alloc<i32>(const u64 1);",
    "        (*_6) = move _4;",
    "        _5 = alloc<i32>(const u64 1);",
    "        check(overwrite: _2) -> bb1;",
    "    }",
    "    bb1: {",
    "        _2 = move _5;",
    "        del(move _2);",
    "        return;",
    "    }",
    "}",
    // a slice of a span borrows the origins of the index locals of its place too: the index of
    // `a[k]` derives from the address of `x`: U
    "fn main.b17() -> void {",
    "    let _1 (x): i32 mut* own;",
    "    let _2: i32 mut* own mut*;",
    "    let _3 (a): i32 mut* own mut@[2];",
    "    let _4: u64;",
    "    let _5: i32 mut* own mut@;",
    "    let _6: u64;",
    "    let _7: i32 mut* own;",
    "    let _8: i32 mut* own;",
    "    bb0: {",
    "        _1 = const zero i32 mut* own;",
    "        _3 = const zero i32 mut* own mut@[2];",
    "        _2 = addr mut(_1);",
    "        _4 = cast<u64>(copy _2);",
    "        _5 = slice(_3[_4], const u64 0, const u64 1);",
    "        _6 = const u64 0;",
    "        del(move _5[_6]);",
    "        _7 = alloc<i32>(const u64 1);",
    "        _5[_6] = move _7;",
    "        _8 = alloc<i32>(const u64 1);",
    "        check(overwrite: _1) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1 = move _8;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // the address of an element of an `own` span borrows nothing, though a copy of the span
    // borrows `exposed`: the store through the address keeps the fact of `x` while `x` is
    // exposed: P
    "fn main.b18() -> void {",
    "    let _1 (x): i32 mut* own;",
    "    let _2: i32 mut* own mut*;",
    "    let _3: u64 mut@ own;",
    "    let _4 (s): u64 mut@ own;",
    "    let _5: u64;",
    "    let _6: u64 mut*;",
    "    let _7: i32 mut* own;",
    "    bb0: {",
    "        _1 = const zero i32 mut* own;",
    "        _4 = const zero u64 mut@ own;",
    "        _2 = addr mut(_1);",
    "        global main.P = copy _2;",
    "        _3 = call fn main.nums();",
    "        _4 = move _3;",
    "        del(move _1);",
    "        _5 = const u64 0;",
    "        _6 = addr mut(_4[_5]);",
    "        (*_6) = const u64 1;",
    "        _7 = alloc<i32>(const u64 1);",
    "        check(overwrite: _1) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1 = move _7;",
    "        del(move _1);",
    "        del(move _4);",
    "        return;",
    "    }",
    "}",
};

string[18] BORROWS_VERDICTS = {
    "U/PPP | rxP rtP rtP |",
    "U/PPP | rxP rtP rtP |",
    "P/PPP | rxP rtP rtP |",
    "P/PPP | rxP rtP rtP |",
    "U/PPP | rxP rtP rtP |",
    "U/PPP | rxP rtP rtP |",
    "U/PPP | rxP rtP rtP |",
    "U/PPP | rxP rtP rtP |",
    "U/PPP | rtP rtP |",
    "U/PPP | rxP rtP rtP |",
    "P/PPP | rxP rtP rtP |",
    "U/PPP | rxP rtP rtP |",
    "U/P | rxP rtP |",
    "U/PPP | rxP rtP rtP |",
    "PP/PP | rxP rtP rtP |",
    "U/PPP | rxP rtP rtP |",
    "U/PPP | rxP rtP rtP |",
    "P/PPP | rxP rtP rsP rtP |",
};

fn each_value_borrows_the_origins_of_its_operands() void {
    expect(BORROWS[..], BORROWS_VERDICTS[..]);
}

// ---- the exposure of a frame -------------------------------------------------------------------

// A store into storage that a pointer can reach exposes each frame that the value borrows, and a
// copy of such storage borrows `exposed`. Each case stores through such a copy after the store
// that exposes `x`, or with no such store.
string[282] EXPOSURE = {
    // a store into a global exposes `x`, and a copy of the global borrows `exposed`: U
    "fn main.e1() -> void {",
    "    let _1 (x): i32 mut* own;",
    "    let _2: i32 mut* own mut*;",
    "    let _3: i32 mut* own;",
    "    let _4: i32 mut* own;",
    "    let _5: i32 mut* own mut*;",
    "    bb0: {",
    "        _1 = const zero i32 mut* own;",
    "        _2 = addr mut(_1);",
    "        global main.P = copy _2;",
    "        _5 = copy global main.P;",
    "        del(move (*_5));",
    "        _3 = alloc<i32>(const u64 1);",
    "        (*_5) = move _3;",
    "        _4 = alloc<i32>(const u64 1);",
    "        check(overwrite: _1) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1 = move _4;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // with no store that exposes `x`, the copy of the global cannot hold its address: P
    "fn main.e2() -> void {",
    "    let _1 (x): i32 mut* own;",
    "    let _2: i32 mut* own mut*;",
    "    let _3: i32 mut* own;",
    "    let _4: i32 mut* own;",
    "    let _5: i32 mut* own mut*;",
    "    bb0: {",
    "        _1 = const zero i32 mut* own;",
    "        _2 = addr mut(_1);",
    "        _5 = copy global main.P;",
    "        del(move (*_5));",
    "        _3 = alloc<i32>(const u64 1);",
    "        (*_5) = move _3;",
    "        _4 = alloc<i32>(const u64 1);",
    "        check(overwrite: _1) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1 = move _4;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // a store through a pointer exposes `x`, and a copy of a place through a pointer borrows
    // `exposed`: U
    "fn main.e3(_1 (s): slot mut*) -> void {",
    "    let _2 (x): i32 mut* own;",
    "    let _3: i32 mut* own mut*;",
    "    let _4: i32 mut* own;",
    "    let _5: i32 mut* own;",
    "    let _6: i32 mut* own mut*;",
    "    bb0: {",
    "        _2 = const zero i32 mut* own;",
    "        _3 = addr mut(_2);",
    "        (*_1).0 = copy _3;",
    "        _6 = copy (*_1).0;",
    "        del(move (*_6));",
    "        _4 = alloc<i32>(const u64 1);",
    "        (*_6) = move _4;",
    "        _5 = alloc<i32>(const u64 1);",
    "        check(overwrite: _2) -> bb1;",
    "    }",
    "    bb1: {",
    "        _2 = move _5;",
    "        del(move _2);",
    "        return;",
    "    }",
    "}",
    // a store into a memory local exposes `x`, and a copy of a memory local borrows `exposed`: U
    "fn main.e4() -> void {",
    "    let _1 (x): i32 mut* own;",
    "    let _2: i32 mut* own mut*;",
    "    let _3: i32 mut* own;",
    "    let _4: i32 mut* own;",
    "    let _5: i32 mut* own mut*;",
    "    let _6 (o): i32 mut* own mut*;",
    "    let _7: i32 mut* own mut* mut*;",
    "    bb0: {",
    "        _1 = const zero i32 mut* own;",
    "        _2 = addr mut(_1);",
    "        _7 = addr mut(_6);",
    "        (*_7) = copy _2;",
    "        _5 = copy _6;",
    "        del(move (*_5));",
    "        _3 = alloc<i32>(const u64 1);",
    "        (*_5) = move _3;",
    "        _4 = alloc<i32>(const u64 1);",
    "        check(overwrite: _1) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1 = move _4;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // a store into a part of a borrow local exposes nothing: no pointer names the storage of the
    // local, so the copy of the global cannot hold the address of `x`: P
    "fn main.e5() -> void {",
