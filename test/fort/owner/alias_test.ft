    "    bb1: {",
    "        _1 = move _4;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // a slice of a fixed array borrows the frame of its local, and a slice of a span borrows what
    // the span borrows, so a store into an element of the second slice kills an element of `a`: U
    "fn main.b9() -> void {",
    "    let _1 (a): i32 mut* own[2];",
    "    let _2: i32 mut* own mut@;",
    "    let _3: i32 mut* own mut@;",
    "    let _4: i32 mut* own;",
    "    let _5: i32 mut* own;",
    "    let _6: u64;",
    "    let _7: u64;",
    "    bb0: {",
