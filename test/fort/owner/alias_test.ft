//! run
//! flags: -I ../../src -I support
//! stdout:
//| borrows ok
//| exposure ok
//| calls ok
//| straight ok
//| source ok
//| charge ok
//| limit ok
/// Checks owner.alias, refinement R6 of the kill rules of the emptiness pass: a place through a
/// pointer can be a place of a memory local `x` only when the pointer that its last load reads
/// borrows the frame of `x`, or borrows `exposed` while `x` is exposed. Each group is a FIR module
/// and the verdicts of its functions. A person derived each verdict from the rule before the first
/// run; the comment of a case names the step that it holds. Each case that the refinement proves
/// stands beside a case that it does not prove. The lowered cases run the same steps over fort
/// source, the hand cases k2 and n4 of the design among them.
import check_env;
import fort.fir;
import fort.fir_lower;
import fort.fir_parse;
import fort.owner.alias;
import fort.owner.prover;
import lower_env;
import pass_env;
import std.strbuf;

// The types, the globals and the functions that the FIR text of each case names. A `slot` holds a
// pointer to an owner, and a `cell` an owner and a number. `P` is a global pointer to an owner,
// `keep` stores its argument into `P`, `pass` returns its argument, `give` stores its first
// argument through its second, and `drop` frees a `cell` with its owner. A `hook` holds a function
// value and a pointer to an owner, and `nums` returns an owning span.
string[35] PRELUDE = {
    "struct slot {",
    "    i32 mut* own mut* at;",
    "}",
    "struct cell {",
    "    i32 mut* own o;",
    "    u64 v;",
    "}",
    "struct pair {",
    "    i32 mut* own a;",
    "    i32 mut* own b;",
    "}",
    "i32 mut* own mut G = null;",
    "i32 mut* own mut* mut P = null;",
    "fn g() void {",
    "}",
    "fn keep(i32 mut* own mut* p) void {",
    "    P = p;",
    "}",
    "fn pass(i32 mut* own mut* p) i32 mut* own mut* {",
    "    return p;",
    "}",
    "fn give(i32 mut* own mut* p, i32 mut* own mut* mut* out) void {",
    "    *out = p;",
    "}",
    "fn drop(cell mut* own c) void {",
    "    del(c->o);",
    "    del(c);",
    "}",
    "struct hook {",
    "    fn (i32 mut* own mut*) void f;",
    "    i32 mut* own mut* p;",
    "}",
    "fn nums() u64 mut@ own {",
    "    return new(u64, 2);",
    "}",
};

// ---- the verdicts ------------------------------------------------------------------------------

// No block.
u32 NO_BLOCK = 4294967295;

// The block of the check that stands right before the store `st` of `f`, or NO_BLOCK.
fn check_before(fir.func* f, prover.store* st) u32 {
    if (st->index != 0) {
        return NO_BLOCK;
    }
    fir.place written = fir.block_statement(f, st->block, 0)->place;
    u32 mut b = 0;
    while (b < fir.block_count(f)) {
        fir.terminator* t = &fir.block_at(f, b)->term;
        if (t->kind == fir.term_kind.tk_check_overwrite && t->target == st->block
            && fir.is_same_place(f, t->place, written)) {
            return b;
        }
        b += 1;
    }
    return NO_BLOCK;
}

// Writes the verdicts of `p` into `out`: `P` or `U` for each check in block order, then `/` and
// one for each store that no check stands right before; then ` | ` and each exit, `d` or `r`,
// the name of its local or `t` for a temporary, and `P` or `U`; then ` | ` and each obligation
// of part 2, `d` or `c`, and `P`, or `U` with the first inner owner that is not proved. A
// store with a check right before it takes the verdict of the check.
fn write_all(fir.func* f, prover.proof* p, strbuf.str_buf mut* out) void {
    strbuf.clear(out);
    u32 mut b = 0;
    while (b < fir.block_count(f)) {
        if (fir.block_at(f, b)->term.kind == fir.term_kind.tk_check_overwrite) {
            strbuf.push(out, verdict(prover.is_proved(p, b)));
        }
        b += 1;
    }
    bool mut alone = false;
    u64 mut k = 0;
    while (k < p->stores.len) {
        prover.store* st = &p->stores[k];
        u32 check = check_before(f, st);
        if (check != NO_BLOCK) {
            assert(!prover.is_proved(p, check) || st->proved);
        } else {
            if (!alone) {
                strbuf.push(out, '/');
                alone = true;
            }
            strbuf.push(out, verdict(st->proved));
        }
        k += 1;
    }
    strbuf.append(out, " |");
    k = 0;
    while (k < p->exits.len) {
        prover.exit* x = &p->exits[k];
        strbuf.push(out, ' ');
        if (x->index < fir.block_statement_count(f, x->block)) {
            strbuf.push(out, 'd');
        } else {
            strbuf.push(out, 'r');
        }
        fir.local* l = fir.local_at(f, x->local);
        if (l->kind == fir.local_kind.lk_temp) {
            strbuf.push(out, 't');
        } else {
            strbuf.append(out, fir.local_name(l));
        }
        strbuf.push(out, verdict(x->proved));
        k += 1;
    }
    strbuf.append(out, " |");
    k = 0;
    while (k < p->inners.len) {
        prover.inner* x = &p->inners[k];
        strbuf.push(out, ' ');
        if (fir.block_statement(f, x->block, x->index)->kind == fir.stmt_kind.st_del) {
            strbuf.push(out, 'd');
        } else {
            strbuf.push(out, 'c');
        }
        strbuf.push(out, verdict(x->proved));
        if (!x->proved) {
            strbuf.append_u64(out, x->first);
        }
        k += 1;
    }
}

fn verdict(bool proved) char {
    if (proved) {
        return 'P';
    }
    return 'U';
}

// Parses `text` against PRELUDE, holds that the verifier accepts each function, proves each one,
// and holds that function `k` of the module gives the verdicts `want[k]` (write_all), and that
// the kill rules read the map of owner.alias in each function that has one.
fn expect(string@ text, string@ want) void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    fir.module mut m = pass_env.parse(&e, PRELUDE[..], text);
    defer fir.module_free(&m);
    assert(m.funcs.len == want.len);
    strbuf.str_buf mut got = strbuf.create();
    defer strbuf.free(&got);
    u64 mut k = 0;
    while (k < m.funcs.len) {
        fir.func* f = &m.funcs.items[k];
        pass_env.verified(&e, f, "alias_test: the verifier refuses the input");
        prover.proof mut p = prover.prove(f);
        write_all(f, &p, &got);
        assert(p.alias_on == (p.alias_work > 0));
        prover.free(&p);
        if (strbuf.view(&got) != want[k]) {
            eprintln("function ", k, " gives ", strbuf.view(&got), " and not ", want[k]);
            panic("alias_test: a verdict differs");
        }
        k += 1;
    }
}

// ---- the borrows of a value --------------------------------------------------------------------

// The origins that a value borrows, and where a store puts them. In each case `x` is a memory local
// and the check of `x` stands after a store through a pointer, so its verdict says whether that
// pointer can hold the address of `x`.
string[466] BORROWS = {
    // an address of fixed storage borrows the frame of its local, so a store through it kills the
    // fact of the local: U
    "fn main.b1() -> void {",
    "    let _1 (x): i32 mut* own;",
    "    let _2: i32 mut* own mut*;",
    "    let _3: i32 mut* own;",
    "    let _4: i32 mut* own;",
    "    bb0: {",
    "        _1 = const zero i32 mut* own;",
    "        _2 = addr mut(_1);",
    "        del(move (*_2));",
    "        _3 = alloc<i32>(const u64 1);",
    "        (*_2) = move _3;",
    "        _4 = alloc<i32>(const u64 1);",
    "        check(overwrite: _1) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1 = move _4;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // a copy of a borrow local borrows what the local borrows: U
    "fn main.b2() -> void {",
    "    let _1 (x): i32 mut* own;",
    "    let _2: i32 mut* own mut*;",
    "    let _3: i32 mut* own;",
    "    let _4: i32 mut* own;",
    "    let _5: i32 mut* own mut*;",
    "    bb0: {",
    "        _1 = const zero i32 mut* own;",
    "        _2 = addr mut(_1);",
    "        _5 = copy _2;",
    "        del(move (*_5));",
    "        _3 = alloc<i32>(const u64 1);",
    "        (*_5) = move _3;",
    "        _4 = alloc<i32>(const u64 1);",
    "        check(overwrite: _1) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1 = move _4;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // a parameter borrows no frame of the call, so a store through it keeps the fact: P
    "fn main.b3(_1 (b): cell mut*) -> void {",
    "    let _2 (x): i32 mut* own;",
    "    let _3: i32 mut* own mut*;",
    "    let _4: i32 mut* own;",
    "    let _5: i32 mut* own;",
    "    bb0: {",
    "        _2 = const zero i32 mut* own;",
    "        _3 = addr mut(_2);",
    "        del(move (*_1).0);",
    "        _4 = alloc<i32>(const u64 1);",
    "        (*_1).0 = move _4;",
    "        _5 = alloc<i32>(const u64 1);",
    "        check(overwrite: _2) -> bb1;",
    "    }",
    "    bb1: {",
    "        _2 = move _5;",
    "        del(move _2);",
    "        return;",
    "    }",
    "}",
    // a store into a whole borrow local replaces its origins: P
    "fn main.b4(_1 (q): i32 mut* own mut*) -> void {",
    "    let _2 (x): i32 mut* own;",
    "    let _3: i32 mut* own mut*;",
    "    let _4: i32 mut* own;",
    "    let _5: i32 mut* own;",
    "    let _6: i32 mut* own mut*;",
    "    bb0: {",
    "        _2 = const zero i32 mut* own;",
    "        _3 = addr mut(_2);",
    "        _6 = copy _3;",
    "        _6 = copy _1;",
    "        del(move (*_6));",
    "        _4 = alloc<i32>(const u64 1);",
    "        (*_6) = move _4;",
    "        _5 = alloc<i32>(const u64 1);",
    "        check(overwrite: _2) -> bb1;",
    "    }",
    "    bb1: {",
    "        _2 = move _5;",
    "        del(move _2);",
    "        return;",
    "    }",
    "}",
    // a store into a part of a borrow local adds to its origins, and a copy of a part borrows them:
    // U
    "fn main.b5() -> void {",
    "    let _1 (x): i32 mut* own;",
    "    let _2: i32 mut* own mut*;",
    "    let _3: i32 mut* own;",
    "    let _4: i32 mut* own;",
    "    let _5 (s): slot;",
    "    let _6: i32 mut* own mut*;",
    "    bb0: {",
    "        _1 = const zero i32 mut* own;",
    "        _5 = const zero slot;",
    "        _2 = addr mut(_1);",
    "        _5.0 = copy _2;",
    "        _6 = copy _5.0;",
    "        del(move (*_6));",
    "        _3 = alloc<i32>(const u64 1);",
    "        (*_6) = move _3;",
    "        _4 = alloc<i32>(const u64 1);",
    "        check(overwrite: _1) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1 = move _4;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // the origins join by union: the address of `x` reaches the store on one edge: U
    "fn main.b6(_1 (c): bool, _2 (q): i32 mut* own mut*) -> void {",
    "    let _3 (x): i32 mut* own;",
    "    let _4: i32 mut* own mut*;",
    "    let _5: i32 mut* own;",
    "    let _6: i32 mut* own;",
    "    let _7: i32 mut* own mut*;",
    "    bb0: {",
    "        _3 = const zero i32 mut* own;",
    "        _4 = addr mut(_3);",
    "        switch(copy _1) -> [true: bb1, otherwise: bb2];",
    "    }",
    "    bb1: {",
    "        _7 = copy _4;",
    "        goto bb3;",
    "    }",
    "    bb2: {",
    "        _7 = copy _2;",
    "        goto bb3;",
    "    }",
    "    bb3: {",
    "        del(move (*_7));",
    "        _5 = alloc<i32>(const u64 1);",
    "        (*_7) = move _5;",
    "        _6 = alloc<i32>(const u64 1);",
    "        check(overwrite: _3) -> bb4;",
    "    }",
    "    bb4: {",
    "        _3 = move _6;",
    "        del(move _3);",
    "        return;",
    "    }",
    "}",
    // a loop carries the origins around its back edge: the second round stores through the
    // address of `x`: U
    "fn main.b7(_1 (c): bool, _2 (q): i32 mut* own mut*) -> void {",
    "    let _3 (x): i32 mut* own;",
    "    let _4: i32 mut* own mut*;",
    "    let _5: i32 mut* own;",
    "    let _6: i32 mut* own;",
    "    let _7: i32 mut* own mut*;",
    "    bb0: {",
    "        _3 = const zero i32 mut* own;",
    "        _4 = addr mut(_3);",
    "        _7 = copy _2;",
    "        goto bb1;",
    "    }",
    "    bb1: {",
    "        switch(copy _1) -> [true: bb2, otherwise: bb3];",
    "    }",
    "    bb2: {",
    "        del(move (*_7));",
    "        _5 = alloc<i32>(const u64 1);",
    "        (*_7) = move _5;",
    "        _7 = copy _4;",
    "        goto bb1;",
    "    }",
    "    bb3: {",
    "        _6 = alloc<i32>(const u64 1);",
    "        check(overwrite: _3) -> bb4;",
    "    }",
    "    bb4: {",
    "        _3 = move _6;",
    "        del(move _3);",
    "        return;",
    "    }",
    "}",
    // an address through a pointer borrows what the pointer of its last load borrows: U
    "fn main.b8() -> void {",
    "    let _1 (x): i32 mut* own;",
    "    let _2: i32 mut* own mut*;",
    "    let _3: i32 mut* own;",
    "    let _4: i32 mut* own;",
    "    let _5: i32 mut* own mut*;",
    "    bb0: {",
    "        _1 = const zero i32 mut* own;",
    "        _2 = addr mut(_1);",
    "        _5 = addr mut((*_2));",
    "        del(move (*_5));",
    "        _3 = alloc<i32>(const u64 1);",
