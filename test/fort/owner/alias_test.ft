    "    }",
    "    bb1: {",
    "        _1 = move _4;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // the exposure joins by union: `x` is exposed on one edge into the store: U
    "fn main.e6(_1 (c): bool) -> void {",
