    "    bb2: {",
    "        _6 = copy global main.P;",
    "        del(move (*_6));",
    "        _4 = alloc<i32>(const u64 1);",
    "        (*_6) = move _4;",
    "        _5 = alloc<i32>(const u64 1);",
    "        check(overwrite: _2) -> bb3;",
    "    }",
    "    bb3: {",
    "        _2 = move _5;",
    "        del(move _2);",
    "        return;",
    "    }",
    "}",
    // a copy of a place of an `own` pointer type borrows no frame, so a store through the copy
    // keeps the fact of `x` while `x` is exposed: P
    "fn main.e7(_1 (q): cell mut*, _2 (n): cell mut* own) -> void {",
    "    let _3 (x): i32 mut* own;",
    "    let _4: i32 mut* own mut*;",
    "    let _5: i32 mut* own;",
    "    let _6: i32 mut*;",
    "    let _7: void;",
    "    bb0: {",
    "        _3 = const zero i32 mut* own;",
    "        _4 = addr mut(_3);",
    "        global main.P = copy _4;",
    "        _6 = copy (*_1).0;",
    "        (*_6) = const i32 0;",
    "        _5 = alloc<i32>(const u64 1);",
    "        check(overwrite: _3) -> bb1;",
    "    }",
    "    bb1: {",
    "        _3 = move _5;",
    "        del(move _3);",
    "        dead(_3);",
    "        _7 = call fn main.drop(move _2);",
    "        return;",
    "    }",
    "}",
    // a store through an `own` pointer keeps the fact of `x` while `x` is exposed: P
    "fn main.e8(_1 (n): cell mut* own) -> void {",
    "    let _2 (x): i32 mut* own;",
    "    let _3: i32 mut* own mut*;",
    "    let _4: i32 mut* own;",
    "    let _5: void;",
    "    bb0: {",
    "        _2 = const zero i32 mut* own;",
    "        _3 = addr mut(_2);",
    "        global main.P = copy _3;",
    "        (*_1).1 = const u64 0;",
    "        _4 = alloc<i32>(const u64 1);",
    "        check(overwrite: _2) -> bb1;",
    "    }",
    "    bb1: {",
    "        _2 = move _4;",
    "        del(move _2);",
    "        dead(_2);",
    "        _5 = call fn main.drop(move _1);",
    "        return;",
    "    }",
    "}",
    // a result that is no aggregate is a borrow local, which no pointer names, so a store of the
    // address of `x` into it exposes nothing: P
    "fn main.e9() -> i32 mut* own mut* {",
    "    let _1 (x): i32 mut* own;",
    "    let _2: i32 mut* own mut*;",
    "    let _3: i32 mut* own;",
    "    let _4: i32 mut* own;",
    "    let _5: i32 mut* own mut*;",
    "    bb0: {",
    "        _1 = const zero i32 mut* own;",
    "        _2 = addr mut(_1);",
    "        _0 = copy _2;",
    "        _5 = copy global main.P;",
    "        del(move (*_5));",
    "        _3 = alloc<i32>(const u64 1);",
    "        (*_5) = move _3;",
    "        _4 = alloc<i32>(const u64 1);",
    "        check(overwrite: _1) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1 = move _4;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // the store that exposes `x` stands after the store through the copy of the global in the
    // body of a loop, so the second round of the store can write `x`: U
    "fn main.e10(_1 (c): bool) -> void {",
    "    let _2 (x): i32 mut* own;",
    "    let _3: i32 mut* own mut*;",
    "    let _4: i32 mut* own;",
    "    let _5: i32 mut* own;",
    "    let _6: i32 mut* own mut*;",
    "    bb0: {",
    "        _2 = const zero i32 mut* own;",
    "        _3 = addr mut(_2);",
    "        goto bb1;",
    "    }",
    "    bb1: {",
    "        switch(copy _1) -> [true: bb2, otherwise: bb3];",
    "    }",
    "    bb2: {",
    "        _6 = copy global main.P;",
    "        del(move (*_6));",
    "        _4 = alloc<i32>(const u64 1);",
    "        (*_6) = move _4;",
    "        global main.P = copy _3;",
    "        goto bb1;",
    "    }",
    "    bb3: {",
    "        _5 = alloc<i32>(const u64 1);",
    "        check(overwrite: _2) -> bb4;",
    "    }",
    "    bb4: {",
    "        _2 = move _5;",
    "        del(move _2);",
    "        return;",
    "    }",
    "}",
    // a store whose last load reads a pointer in memory, with no copy into a local: it can write
    // `x` once `x` is exposed: U
    "fn main.e11(_1 (s): slot mut*) -> void {",
    "    let _2 (x): i32 mut* own;",
    "    let _3: i32 mut* own mut*;",
    "    let _4: i32 mut* own;",
    "    bb0: {",
    "        _2 = const zero i32 mut* own;",
    "        _3 = addr mut(_2);",
    "        (*_1).0 = copy _3;",
    "        (*(*_1).0) = const zero i32 mut* own;",
    "        _4 = alloc<i32>(const u64 1);",
    "        check(overwrite: _2) -> bb1;",
    "    }",
    "    bb1: {",
    "        _2 = move _4;",
    "        del(move _2);",
    "        return;",
    "    }",
    "}",
    // the same store with no exposure of `x`: P
    "fn main.e12(_1 (s): slot mut*) -> void {",
    "    let _2 (x): i32 mut* own;",
    "    let _3: i32 mut* own mut*;",
    "    let _4: i32 mut* own;",
    "    bb0: {",
    "        _2 = const zero i32 mut* own;",
    "        _3 = addr mut(_2);",
    "        (*(*_1).0) = const zero i32 mut* own;",
    "        _4 = alloc<i32>(const u64 1);",
    "        check(overwrite: _2) -> bb1;",
    "    }",
    "    bb1: {",
    "        _2 = move _4;",
    "        del(move _2);",
    "        return;",
    "    }",
    "}",
};

string[12] EXPOSURE_VERDICTS = {
    "U/PPP | rxP rtP rtP |",
    "P/PPP | rxP rtP rtP |",
    "U/PPP | rxP rtP rtP |",
    "U/PPP | rxP rtP rtP |",
    "P/PPP | rxP rtP rtP |",
    "U/PPP | rxP rtP rtP |",
    "P/P | dxP rnP rtP |",
    "P/P | dxP rnP rtP |",
    "P/PPP | rxP rtP rtP |",
    "U/PPP | rxP rtP rtP |",
    "U/UP | rxP rtP |",
    "P/UP | rxP rtP |",
};

fn a_store_into_memory_exposes_each_frame_of_its_value() void {
    expect(EXPOSURE[..], EXPOSURE_VERDICTS[..]);
}

// ---- calls -------------------------------------------------------------------------------------

// A call exposes each frame of its operands, and its result borrows `exposed`. A call kills each
// fact of a memory local (D17.11 kill rule 5), so each case empties `x` again after the call, and
// a store through a pointer after it decides the check.
string[124] CALLS = {
    // an argument exposes `x`, and the callee keeps it in `P`: the hand case k2 of the design: U
    "fn main.c1() -> void {",
    "    let _1 (x): i32 mut* own;",
    "    let _2: i32 mut* own mut*;",
    "    let _3: i32 mut* own;",
    "    let _4: i32 mut* own;",
    "    let _5: i32 mut* own mut*;",
    "    let _6: void;",
    "    bb0: {",
    "        _1 = const zero i32 mut* own;",
    "        _2 = addr mut(_1);",
    "        _6 = call fn main.keep(copy _2);",
    "        del(move _1);",
    "        _5 = copy global main.P;",
    "        del(move (*_5));",
    "        _3 = alloc<i32>(const u64 1);",
    "        (*_5) = move _3;",
    "        _4 = alloc<i32>(const u64 1);",
    "        check(overwrite: _1) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1 = move _4;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // a call with no operand that borrows `x` exposes nothing: P
    "fn main.c2() -> void {",
    "    let _1 (x): i32 mut* own;",
    "    let _2: i32 mut* own mut*;",
    "    let _3: i32 mut* own;",
    "    let _4: i32 mut* own;",
    "    let _5: i32 mut* own mut*;",
    "    let _6: void;",
    "    bb0: {",
    "        _1 = const zero i32 mut* own;",
    "        _2 = addr mut(_1);",
    "        _6 = call fn main.g();",
    "        del(move _1);",
    "        _5 = copy global main.P;",
    "        del(move (*_5));",
    "        _3 = alloc<i32>(const u64 1);",
    "        (*_5) = move _3;",
    "        _4 = alloc<i32>(const u64 1);",
    "        check(overwrite: _1) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1 = move _4;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // the result of a call borrows `exposed`, and the argument exposed `x`: U
    "fn main.c3() -> void {",
    "    let _1 (x): i32 mut* own;",
    "    let _2: i32 mut* own mut*;",
    "    let _3: i32 mut* own;",
    "    let _4: i32 mut* own;",
    "    let _5: i32 mut* own mut*;",
    "    bb0: {",
    "        _1 = const zero i32 mut* own;",
    "        _2 = addr mut(_1);",
    "        _5 = call fn main.pass(copy _2);",
    "        del(move _1);",
    "        del(move (*_5));",
    "        _3 = alloc<i32>(const u64 1);",
    "        (*_5) = move _3;",
    "        _4 = alloc<i32>(const u64 1);",
    "        check(overwrite: _1) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1 = move _4;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // the result borrows `exposed`, but no store and no call exposed `x`: P
    "fn main.c4(_1 (q): i32 mut* own mut*) -> void {",
    "    let _2 (x): i32 mut* own;",
    "    let _3: i32 mut* own mut*;",
    "    let _4: i32 mut* own;",
    "    let _5: i32 mut* own;",
    "    let _6: i32 mut* own mut*;",
    "    bb0: {",
    "        _2 = const zero i32 mut* own;",
    "        _3 = addr mut(_2);",
    "        _6 = call fn main.pass(copy _1);",
    "        del(move _2);",
    "        del(move (*_6));",
    "        _4 = alloc<i32>(const u64 1);",
    "        (*_6) = move _4;",
    "        _5 = alloc<i32>(const u64 1);",
    "        check(overwrite: _2) -> bb1;",
    "    }",
    "    bb1: {",
    "        _2 = move _5;",
    "        del(move _2);",
    "        return;",
    "    }",
    "}",
    // the callee writes the address of `x` into the memory local `o` through its out-parameter, and
