    "fn main.c5() -> void {",
    "    let _1 (x): i32 mut* own;",
    "    let _2: i32 mut* own mut*;",
    "    let _3: i32 mut* own;",
    "    let _4: i32 mut* own;",
    "    let _5: i32 mut* own mut*;",
    "    let _6 (o): i32 mut* own mut*;",
    "    let _7: i32 mut* own mut* mut*;",
    "    let _8: void;",
    "    bb0: {",
    "        _1 = const zero i32 mut* own;",
    "        _2 = addr mut(_1);",
    "        _7 = addr mut(_6);",
    "        _8 = call fn main.give(copy _2, copy _7);",
    "        del(move _1);",
    "        _5 = copy _6;",
    "        del(move (*_5));",
    "        _3 = alloc<i32>(const u64 1);",
    "        (*_5) = move _3;",
    "        _4 = alloc<i32>(const u64 1);",
    "        check(overwrite: _1) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1 = move _4;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
};

string[5] CALLS_VERDICTS = {
    "U/PPP | rxP rtP rtP |",
    "P/PPP | rxP rtP rtP |",
    "U/PPP | rxP rtP rtP |",
    "P/PPP | rxP rtP rtP |",
    "U/PPP | rxP rtP rtP |",
};

fn a_call_exposes_its_operands_and_its_result_borrows_exposed() void {
    expect(CALLS[..], CALLS_VERDICTS[..]);
}

// ---- a store straight into a memory local ------------------------------------------------------

// A store straight into a memory local kills a fact through a pointer only when the pointer can
// hold the address of the local (D17.11 kill rule 4).
string[212] STRAIGHT = {
    // the pointer holds the address of `x`: U
    "fn main.s1() -> void {",
    "    let _1 (x): i32 mut* own;",
    "    let _2: i32 mut* own mut*;",
    "    let _3: i32 mut* own;",
    "    let _4: i32 mut* own;",
    "    bb0: {",
    "        _1 = const zero i32 mut* own;",
    "        _2 = addr mut(_1);",
    "        del(move (*_2));",
    "        _3 = alloc<i32>(const u64 1);",
    "        _1 = move _3;",
    "        _4 = alloc<i32>(const u64 1);",
    "        check(overwrite: (*_2)) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_2) = move _4;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // the pointer is a parameter: P
    "fn main.s2(_1 (q): i32 mut* own mut*) -> void {",
    "    let _2 (x): i32 mut* own;",
    "    let _3: i32 mut* own mut*;",
    "    let _4: i32 mut* own;",
    "    let _5: i32 mut* own;",
    "    bb0: {",
    "        _2 = const zero i32 mut* own;",
    "        _3 = addr mut(_2);",
    "        del(move (*_1));",
    "        _4 = alloc<i32>(const u64 1);",
    "        _2 = move _4;",
    "        _5 = alloc<i32>(const u64 1);",
    "        check(overwrite: (*_1)) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_1) = move _5;",
    "        del(move _2);",
    "        return;",
    "    }",
    "}",
    // the pointer borrows `exposed` and a store exposed `x`: U
    "fn main.s3() -> void {",
    "    let _1 (x): i32 mut* own;",
    "    let _2: i32 mut* own mut*;",
    "    let _3: i32 mut* own;",
    "    let _4: i32 mut* own;",
    "    let _5: i32 mut* own mut*;",
    "    bb0: {",
    "        _1 = const zero i32 mut* own;",
    "        _2 = addr mut(_1);",
    "        global main.P = copy _2;",
    "        _5 = copy global main.P;",
    "        del(move (*_5));",
    "        _3 = alloc<i32>(const u64 1);",
    "        _1 = move _3;",
    "        _4 = alloc<i32>(const u64 1);",
    "        check(overwrite: (*_5)) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_5) = move _4;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // the pointer borrows `exposed`, but nothing exposed `x`: P
    "fn main.s4() -> void {",
    "    let _1 (x): i32 mut* own;",
    "    let _2: i32 mut* own mut*;",
    "    let _3: i32 mut* own;",
    "    let _4: i32 mut* own;",
    "    let _5: i32 mut* own mut*;",
    "    bb0: {",
    "        _1 = const zero i32 mut* own;",
    "        _2 = addr mut(_1);",
    "        _5 = copy global main.P;",
    "        del(move (*_5));",
    "        _3 = alloc<i32>(const u64 1);",
    "        _1 = move _3;",
    "        _4 = alloc<i32>(const u64 1);",
    "        check(overwrite: (*_5)) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_5) = move _4;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // the last load reads an `own` pointer: P
    "fn main.s5(_1 (n): cell mut* own) -> void {",
    "    let _2 (x): i32 mut* own;",
    "    let _3: i32 mut* own mut*;",
    "    let _4: i32 mut* own;",
    "    let _5: i32 mut* own;",
    "    let _6: void;",
    "    bb0: {",
    "        _2 = const zero i32 mut* own;",
    "        _3 = addr mut(_2);",
    "        global main.P = copy _3;",
    "        del(move (*_1).0);",
    "        _4 = alloc<i32>(const u64 1);",
    "        _2 = move _4;",
    "        _5 = alloc<i32>(const u64 1);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_1).0 = move _5;",
    "        del(move _2);",
    "        dead(_2);",
    "        _6 = call fn main.drop(move _1);",
    "        return;",
    "    }",
    "}",
    // an element through a slice of the memory array `a` dies at a store into an element of `a`: U
    "fn main.s6() -> void {",
    "    let _1 (a): i32 mut* own[2];",
    "    let _2: i32 mut* own mut@;",
    "    let _3: i32 mut* own;",
    "    let _4: i32 mut* own;",
    "    let _5: u64;",
    "    let _6: u64;",
    "    bb0: {",
    "        _1 = const zero i32 mut* own[2];",
    "        _2 = slice mut(_1, const u64 0, const u64 2);",
    "        _5 = const u64 0;",
    "        _6 = const u64 1;",
    "        del(move _2[_5]);",
    "        _3 = alloc<i32>(const u64 1);",
    "        _1[_6] = move _3;",
    "        _4 = alloc<i32>(const u64 1);",
    "        check(overwrite: _2[_5]) -> bb1;",
    "    }",
    "    bb1: {",
    "        _2[_5] = move _4;",
    "        return;",
    "    }",
    "}",
    // a global has no frame: a store through a parameter kills its fact, as before the refinement:
    // U
    "fn main.s7(_1 (b): cell mut*) -> void {",
    "    let _2: i32 mut* own;",
    "    let _3: i32 mut* own;",
    "    bb0: {",
    "        del(move global main.G);",
    "        del(move (*_1).0);",
    "        _2 = alloc<i32>(const u64 1);",
    "        (*_1).0 = move _2;",
    "        _3 = alloc<i32>(const u64 1);",
    "        check(overwrite: global main.G) -> bb1;",
    "    }",
    "    bb1: {",
    "        global main.G = move _3;",
    "        return;",
    "    }",
    "}",
    // an aggregate result is the storage of the caller and has no frame either: a store through a
    // parameter kills the fact of its field, beside the memory local `y`, which has a frame: U
    "fn main.s8(_1 (b): cell mut*) -> pair {",
    "    let _2: i32 mut* own;",
    "    let _3: i32 mut* own;",
    "    let _4 (y): u64;",
    "    let _5: u64*;",
    "    bb0: {",
    "        _5 = addr(_4);",
    "        _0 = const zero pair;",
    "        del(move (*_1).0);",
    "        _2 = alloc<i32>(const u64 1);",
    "        (*_1).0 = move _2;",
    "        _3 = alloc<i32>(const u64 1);",
    "        check(overwrite: _0.0) -> bb1;",
    "    }",
    "    bb1: {",
    "        _0.0 = move _3;",
    "        return;",
    "    }",
    "}",
    // the span local `s` is memory, so the pointer of the fact `s[k]` is in memory: a store into
    // `x` kills the fact once `x` is exposed: U. The store into `s[k]` can write `x` in turn, so
    // the exit of `x` is unproved
    "fn main.s9() -> void {",
    "    let _1 (x): i32 mut* own;",
    "    let _2: i32 mut* own mut*;",
    "    let _3 (s): i32 mut* own mut@;",
    "    let _4: i32 mut* own mut@ mut*;",
    "    let _5: u64;",
    "    let _6: i32 mut* own;",
    "    bb0: {",
    "        _1 = const zero i32 mut* own;",
    "        _2 = addr mut(_1);",
    "        _4 = addr mut(_3);",
    "        global main.P = copy _2;",
    "        _5 = const u64 0;",
    "        del(move _3[_5]);",
    "        _1 = const null i32 mut* own;",
    "        _6 = alloc<i32>(const u64 1);",
    "        check(overwrite: _3[_5]) -> bb1;",
    "    }",
    "    bb1: {",
    "        _3[_5] = move _6;",
    "        return;",
    "    }",
    "}",
    // the same with no exposure of `x`: P
    "fn main.s10() -> void {",
    "    let _1 (x): i32 mut* own;",
    "    let _2: i32 mut* own mut*;",
    "    let _3 (s): i32 mut* own mut@;",
    "    let _4: i32 mut* own mut@ mut*;",
    "    let _5: u64;",
    "    let _6: i32 mut* own;",
    "    bb0: {",
    "        _1 = const zero i32 mut* own;",
    "        _2 = addr mut(_1);",
    "        _4 = addr mut(_3);",
    "        _5 = const u64 0;",
    "        del(move _3[_5]);",
    "        _1 = const null i32 mut* own;",
    "        _6 = alloc<i32>(const u64 1);",
    "        check(overwrite: _3[_5]) -> bb1;",
    "    }",
    "    bb1: {",
    "        _3[_5] = move _6;",
    "        return;",
    "    }",
    "}",
};

string[10] STRAIGHT_VERDICTS = {
    "U/PPP | rxP rtP rtP |",
    "P/PPP | rxP rtP rtP |",
    "U/PPP | rxP rtP rtP |",
    "P/PPP | rxP rtP rtP |",
    "P/PPP | dxP rnP rtP rtP |",
    "U/PPP | rtP rtP |",
    "U/PPP | rtP rtP |",
    "U/PPP | rtP rtP |",
    "U/PP | rxU rtP |",
    "P/PP | rxP rtP |",
};

fn a_straight_store_kills_a_fact_only_through_a_pointer_that_can_reach_it() void {
    expect(STRAIGHT[..], STRAIGHT_VERDICTS[..]);
}

// ---- lowered source ----------------------------------------------------------------------------

// The steps over fort source. The verdict of a function is each obligation of part 2 of the leak
// rule (write_all), then `ok` when the function has no error of D17.11 and of part 1, and else
// `error` with the count of the checks and the stores that the pass does not prove and the count
// of the exits. The lowering puts a store right after its check, so one store of the source that
// the pass does not prove counts twice. Each case has one obligation that the refinement decides.
string[110] SOURCE = {
    "struct cell {",
    "    i32 mut* own o;",
    "    u64 v;",
    "}",
    "struct slot {",
    "    i32 mut* own mut* at;",
    "}",
    "i32 mut* own mut* mut P = null;",
    "fn keep(i32 mut* own mut* p) void {",
    "    P = p;",
    "}",
    "fn pass(i32 mut* own mut* p) i32 mut* own mut* {",
    "    return p;",
    "}",
    "fn give(i32 mut* own mut* p, i32 mut* own mut* mut* out) void {",
    "    *out = p;",
    "}",
    "fn drop(cell mut* own c) void {",
    "    del(c->o);",
    "    del(c);",
    "}",
    // ok: the store through the parameter `q` keeps the fact of `x`
    "fn through_param(cell mut* q) void {",
    "    i32 mut* own mut x = null;",
    "    i32 mut* own mut* px = &x;",
    "    del(q->o);",
    "    q->o = new(i32);",
    "    x = new(i32);",
    "    del(x);",
    "}",
    // error: `keep(&x)` exposes `x`, `p = P` borrows `exposed`, and the store through `p` kills
    // the fact of `x`: the hand case k2 of the design
    "fn k2() void {",
    "    i32 mut* own mut x = new(i32);",
    "    keep(&x);",
    "    del(x);",
    "    i32 mut* own mut* p = P;",
    "    del(*p);",
    "    *p = new(i32);",
    "    x = new(i32);",
    "    del(x);",
    "}",
    // error: the callee writes the address of `x` into the memory local `o`, and a copy of `o`
    // borrows `exposed`: the hand case n4 of the design for rule (a)
    "fn n4() void {",
    "    i32 mut* own mut x = null;",
    "    i32 mut* own mut* mut o = null;",
    "    give(&x, &o);",
    "    del(x);",
    "    i32 mut* own mut* p = o;",
    "    del(*p);",
    "    *p = new(i32);",
    "    x = new(i32);",
    "    del(x);",
    "}",
    // error: the result of a call borrows `exposed`
    "fn result() void {",
    "    i32 mut* own mut x = null;",
    "    i32 mut* own mut* p = pass(&x);",
    "    del(x);",
    "    del(*p);",
    "    *p = new(i32);",
    "    x = new(i32);",
    "    del(x);",
    "}",
    // error: a store into a global exposes `x` with no call
    "fn global_store() void {",
    "    i32 mut* own mut x = null;",
    "    P = &x;",
    "    i32 mut* own mut* p = P;",
    "    del(*p);",
    "    *p = new(i32);",
    "    x = new(i32);",
    "    del(x);",
    "}",
    // ok: a struct local that is no memory holds the address, so nothing exposes `x`
    "fn field_local() void {",
    "    i32 mut* own mut x = null;",
    "    slot s = slot{&x};",
    "    i32 mut* own mut* p = P;",
    "    del(*p);",
    "    *p = new(i32);",
    "    x = new(i32);",
    "    del(x);",
    "}",
    // ok: a store through an `own` pointer cannot write `x`, though `x` is exposed
    "fn own_store(cell mut* own n) void {",
    "    {",
    "        i32 mut* own mut x = null;",
    "        P = &x;",
    "        n->v = 1;",
    "        x = new(i32);",
    "        del(x);",
    "    }",
    "    drop(move(n));",
    "}",
    // ok: the exit of the memory owner `x` keeps its fact past the store through `q` (part 1)
    "fn exit_kept(cell mut* q) void {",
    "    i32 mut* own mut x = new(i32);",
    "    i32 mut* own mut* px = &x;",
    "    del(x);",
    "    q->v = 1;",
    "}",
    // error: the store through a copy of `P` can write `x`, which `P = &x` exposed (part 1).
    // D3.14 refuses the cast of `P` to `u64 mut*`, so the copy passes `memmove`, an extern whose
    // argument may hide an owner. The call comes before `del(x)`, so the store alone kills the
    // fact of `x` at the exit.
    "extern fn memmove(u8 mut* dst, u8* src, u64 n) u8 mut*;",
    "fn exit_exposed() void {",
    "    i32 mut* own mut x = new(i32);",
    "    P = &x;",
    "    u64 mut* w = cast(memmove(cast(P, u8 mut*), cast(P, u8*), 0), u64 mut*);",
    "    del(x);",
    "    *w = 0;",
    "}",
    // dP ok: the store into the memory local `k` keeps the fact of `c->o`, which `c` reaches
    // through an `own` pointer (part 2)
    "fn inner_kept(cell mut* own c) void {",
    "    i32 mut* own o = move(c->o);",
    "    u64 mut k = 0;",
    "    u64 mut* pk = &k;",
    "    k = 1;",
    "    del(c);",
    "    del(o);",
    "    *pk = 2;",
    "}",
};

string[10] SOURCE_NAMES = {
    "through_param", "k2", "n4", "result", "global_store", "field_local", "own_store",
    "exit_kept", "exit_exposed", "inner_kept",
};

string[10] SOURCE_VERDICTS = {
    "ok", "error 2 0", "error 2 0", "error 2 0", "error 2 0", "ok", "ok", "ok", "error 0 1",
    "dP ok",
};

// Lowers the function `name` of the checked source of `e` into *out, and holds that the verifier
// accepts it.
fn lower(lower_env.env mut* e, string name, fir.func mut* out) void {
    fir_lower.report mut why = fir_lower.report{};
    if (!fir_lower.lower_function(&e->c.ck, lower_env.decl(e, name), out, &why)) {
        panic("alias_test: the lowering refuses the function");
    }
    pass_env.verified(e, out, "alias_test: the verifier refuses the lowering");
}

fn each_step_holds_over_lowered_source() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    lower_env.check_lines(&e, SOURCE[..], true);
    strbuf.str_buf mut got = strbuf.create();
    defer strbuf.free(&got);
    strbuf.str_buf mut all = strbuf.create();
    defer strbuf.free(&all);
    u64 mut k = 0;
    while (k < SOURCE_NAMES.len) {
        fir.func mut f = fir.func{};
        lower(&e, SOURCE_NAMES[k], &f);
        prover.proof mut p = prover.prove(&f);
        write_all(&f, &p, &all);
        strbuf.clear(&got);
        string inners = strbuf.view(&all)[str_after_last(strbuf.view(&all), '|')..];
        if (inners.len > 0) {
            strbuf.append(&got, inners[1..]);
            strbuf.push(&got, ' ');
        }
        if (prover.has_error(&p)) {
            strbuf.append(&got, "error ");
            strbuf.append_u64(&got, cast(p.unproved, u64));
            strbuf.push(&got, ' ');
            strbuf.append_u64(&got, cast(p.leaks, u64));
        } else {
            strbuf.append(&got, "ok");
        }
        prover.free(&p);
        fir.func_free(&f);
        if (strbuf.view(&got) != SOURCE_VERDICTS[k]) {
            eprintln(SOURCE_NAMES[k], " gives ", strbuf.view(&got), " and not ",
                     SOURCE_VERDICTS[k]);
            panic("alias_test: a lowered case gives another verdict");
        }
        k += 1;
    }
}

// The position after the last `c` of `s`.
fn str_after_last(string s, char c) u64 {
    u64 mut at = s.len;
    while (at > 0 && s[at - 1] != c) {
        at -= 1;
    }
    return at;
}

// ---- the charge --------------------------------------------------------------------------------

// A loop whose back edge brings the address of `x` into `_4`. The state holds 9 bits: four borrow
// locals (`_0`, `c`, `_3`, `_4`) times two origins, the frame of `x` and `exposed`, and the
// exposure of `x`. The fixpoint takes bb0 to bb4, then bb1 again, whose state grew on the back
// edge, then bb2, bb3 and bb4: 15 statements and terminators, which charge 15 times 9.
string[24] CHARGE = {
    "fn main.ch(_1 (c): bool) -> void {",
    "    let _2 (x): i32 mut* own;",
    "    let _3: i32 mut* own mut*;",
    "    let _4: i32 mut* own mut*;",
    "    bb0: {",
    "        _2 = const zero i32 mut* own;",
    "        _3 = addr mut(_2);",
    "        goto bb1;",
    "    }",
    "    bb1: {",
    "        switch(copy _1) -> [true: bb2, otherwise: bb3];",
    "    }",
    "    bb2: {",
    "        _4 = copy _3;",
    "        goto bb1;",
    "    }",
    "    bb3: {",
    "        check(overwrite: _2) -> bb4;",
    "    }",
    "    bb4: {",
    "        del(move _2);",
    "        return;",
    "    }",
    "}",
};

// Each transfer of a block charges its statements and its terminator times the bits of the state:
// a function with no memory local gets no map and no charge.
fn each_transfer_of_a_block_charges_its_units() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    fir.module mut m = pass_env.parse(&e, PRELUDE[..], CHARGE[..]);
    defer fir.module_free(&m);
    fir.func* f = &m.funcs.items[0];
    pass_env.verified(&e, f, "alias_test: the verifier refuses the input");
    prover.proof mut p = prover.prove(f);
    defer prover.free(&p);
    if (p.alias_work != 135 || !p.alias_on) {
        eprintln("charge ", p.alias_work, " and not 135");
        panic("alias_test: the charge differs");
    }
    // s7 of STRAIGHT has no memory local
    fir.module mut none = pass_env.parse(&e, PRELUDE[..], STRAIGHT[..]);
    defer fir.module_free(&none);
    prover.proof mut q = prover.prove(&none.funcs.items[6]);
    defer prover.free(&q);
    assert(q.alias_work == 0 && !q.alias_on);
}

// ---- the limit ---------------------------------------------------------------------------------

// The filler temporaries of write_limit.
u64 LIMIT_TEMPS = 676;

// Writes a function of two blocks with `fillers` stores of a constant into 676 temporaries. Its
// state holds 2048 bits: 682 borrow locals times three origins, the frames of `x` and `y` and
// `exposed`, and the exposures of `x` and `y`. Its statements and terminators are 11 more than
// `fillers`, and each block takes one transfer, so 8181 fillers charge 8192 times 2048, which is
// 2^24, and 8182 charge 2048 more. The store through the parameter `b` keeps the fact of `x` only
// within the limit.
fn write_limit(u64 fillers, strbuf.str_buf mut* out) void {
    strbuf.clear(out);
    strbuf.append(out, "fn main.limit(_1 (b): cell mut*) -> void {\n");
    strbuf.append(out, "    let _2 (x): i32 mut* own;\n    let _3 (y): u64;\n");
    strbuf.append(out, "    let _4: i32 mut* own mut*;\n    let _5: u64*;\n");
    strbuf.append(out, "    let _6: i32 mut* own;\n    let _7: i32 mut* own;\n");
    u64 mut k = 0;
    while (k < LIMIT_TEMPS) {
        strbuf.append(out, "    let _");
        strbuf.append_u64(out, 8 + k);
        strbuf.append(out, ": u64;\n");
        k += 1;
    }
    strbuf.append(out, "    bb0: {\n        _2 = const zero i32 mut* own;\n");
    strbuf.append(out, "        _4 = addr mut(_2);\n        _5 = addr(_3);\n");
    strbuf.append(out, "        del(move (*_1).0);\n        _7 = alloc<i32>(const u64 1);\n");
    strbuf.append(out, "        (*_1).0 = move _7;\n        _6 = alloc<i32>(const u64 1);\n");
    k = 0;
    while (k < fillers) {
        strbuf.append(out, "        _");
        strbuf.append_u64(out, 8 + k % LIMIT_TEMPS);
        strbuf.append(out, " = const u64 0;\n");
        k += 1;
    }
    strbuf.append(out, "        check(overwrite: _2) -> bb1;\n    }\n");
    strbuf.append(out, "    bb1: {\n        _2 = move _6;\n        del(move _2);\n");
    strbuf.append(out, "        return;\n    }\n}\n");
}

// Parses the one function of `text`, proves it, and holds its charge and its verdicts.
fn expect_limit(lower_env.env mut* e, fir_parse.prelude pre, string text, u64 work, string want)
    void {
    fir.module mut m = fir_parse.parse_module(&e->c.m.s, "t.fir", text, pre);
    defer fir.module_free(&m);
    assert(check_env.errors(&e->c) == 0 && m.funcs.len == 1);
    fir.func* f = &m.funcs.items[0];
    pass_env.verified(e, f, "alias_test: the verifier refuses the generated function");
    prover.proof mut p = prover.prove(f);
    defer prover.free(&p);
    strbuf.str_buf mut got = strbuf.create();
    defer strbuf.free(&got);
    write_all(f, &p, &got);
    if (p.alias_work != work || strbuf.view(&got) != want) {
        eprintln("charge ", p.alias_work, " and not ", work, "; ", strbuf.view(&got), " and not ",
                 want);
        panic("alias_test: the limit gives another verdict");
    }
    assert(p.alias_on == (work <= alias.WORK_LIMIT));
}

// The filler temporaries of write_loop.
u64 LOOP_TEMPS = 676;

// Writes a function whose loop moves the frame of `y` one step along a chain of `chain` named
// pointer locals on each turn, with `fillers` stores of a constant into 676 temporaries in the
// body of the loop. The fixpoint transfers the blocks of the loop once for each turn, so a later
// pass can pass the limit while the first pass fits. The store through the parameter `b` keeps the
// fact of `x` only within the limit. A person derived the charges apart from the compiler, with a
// model of the worklist: each block in order, then each successor of a block whose state changed,
// first in first out; the bits are 3 times the 7 + `chain` + 676 borrow locals, plus 2; the blocks
// take 4, 1, `chain` + `fillers` + 2, 4 and 3 units; and each turn moves the frame of `y` one link,
// so the body changes `chain` + 1 times. 3 links and 676 stores charge 7104940, with a first pass
// of 1427580; 8 links and 900 stores have a first pass of 1913150 and stop at 17137425, past 2^24.
fn write_loop(u64 chain, u64 fillers, strbuf.str_buf mut* out) void {
    strbuf.clear(out);
    strbuf.append(out, "fn main.loop(_1 (b): cell mut*, _2 (c): bool) -> void {\n");
    strbuf.append(out, "    let _3 (x): i32 mut* own;\n    let _4 (y): u64;\n");
    strbuf.append(out, "    let _5: i32 mut* own mut*;\n    let _6 (c0): u64 mut*;\n");
    strbuf.append(out, "    let _7: i32 mut* own;\n    let _8: i32 mut* own;\n");
    u64 mut k = 1;
    while (k <= chain) {
        strbuf.append(out, "    let _");
        strbuf.append_u64(out, 8 + k);
        strbuf.append(out, " (c");
        strbuf.append_u64(out, k);
        strbuf.append(out, "): u64 mut*;\n");
        k += 1;
    }
    k = 0;
    while (k < LOOP_TEMPS) {
        strbuf.append(out, "    let _");
        strbuf.append_u64(out, 9 + chain + k);
        strbuf.append(out, ": u64;\n");
        k += 1;
    }
    strbuf.append(out, "    bb0: {\n        _3 = const zero i32 mut* own;\n");
    strbuf.append(out, "        _5 = addr mut(_3);\n        del(move (*_1).0);\n");
    strbuf.append(out, "        goto bb1;\n    }\n");
    strbuf.append(out, "    bb1: {\n");
    strbuf.append(out, "        switch(copy _2) -> [true: bb2, otherwise: bb3];\n    }\n");
    strbuf.append(out, "    bb2: {\n");
    k = chain;
    while (k > 0) {
        strbuf.append(out, "        _");
        strbuf.append_u64(out, 8 + k);
        strbuf.append(out, " = copy _");
        if (k == 1) {
            strbuf.append_u64(out, 6);
        } else {
            strbuf.append_u64(out, 7 + k);
        }
        strbuf.append(out, ";\n");
        k -= 1;
    }
    strbuf.append(out, "        _6 = addr mut(_4);\n");
    k = 0;
    while (k < fillers) {
        strbuf.append(out, "        _");
        strbuf.append_u64(out, 9 + chain + k % LOOP_TEMPS);
        strbuf.append(out, " = const u64 0;\n");
        k += 1;
    }
    strbuf.append(out, "        goto bb1;\n    }\n");
    strbuf.append(out, "    bb3: {\n        _7 = alloc<i32>(const u64 1);\n");
    strbuf.append(out, "        (*_1).0 = move _7;\n        _8 = alloc<i32>(const u64 1);\n");
    strbuf.append(out, "        check(overwrite: _3) -> bb4;\n    }\n");
    strbuf.append(out, "    bb4: {\n        _3 = move _8;\n        del(move _3);\n");
    strbuf.append(out, "        return;\n    }\n}\n");
}

// The charge 2^24 keeps the map, and one more transfer of 2048 bits passes the limit: the kill
// rules then read each place through a pointer as a possible place of `x`, as before the
// refinement, and no verdict of D17.11 turns into an error that the refinement did not give. When
// the first transfer alone passes the limit, the map takes no rank and no state, and its work is
// the statements and terminators times the bits, 8211 times 2048, and not the charge of that
// transfer, 8208 times 2048: the bound of the memory of the state. A loop whose first pass fits
// passes the limit on a later turn and turns the map off there.
fn the_limit_falls_back_to_the_kill_rules_before_the_refinement() void {
    assert(alias.WORK_LIMIT == 16777216);
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    lower_env.check_lines(&e, PRELUDE[..], true);
    fir_parse.prelude pre = fir_parse.prelude{check_env.module_at(&e.c, "main"), &e.c.ck};
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    write_limit(8181, &text);
    expect_limit(&e, pre, strbuf.view(&text), 16777216, "P/PPP | rxP rtP rtP |");
    write_limit(8182, &text);
    expect_limit(&e, pre, strbuf.view(&text), 16779264, "U/PPP | rxP rtP rtP |");
    write_limit(8200, &text);
    expect_limit(&e, pre, strbuf.view(&text), 16816128, "U/PPP | rxP rtP rtP |");
    write_loop(3, 676, &text);
    expect_limit(&e, pre, strbuf.view(&text), 7104940, "P/PPP | rxP rtP rtP |");
    write_loop(8, 900, &text);
    expect_limit(&e, pre, strbuf.view(&text), 17137425, "U/PPP | rxP rtP rtP |");
}

fn main() i32 {
    each_value_borrows_the_origins_of_its_operands();
    println("borrows ok");
    a_store_into_memory_exposes_each_frame_of_its_value();
    println("exposure ok");
    a_call_exposes_its_operands_and_its_result_borrows_exposed();
    println("calls ok");
    a_straight_store_kills_a_fact_only_through_a_pointer_that_can_reach_it();
    println("straight ok");
    each_step_holds_over_lowered_source();
    println("source ok");
    each_transfer_of_a_block_charges_its_units();
    println("charge ok");
    the_limit_falls_back_to_the_kill_rules_before_the_refinement();
    println("limit ok");
    return 0;
}
