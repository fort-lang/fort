    "    u8 x = a[0][0]; // U:a:d:a",
    "    u64 n = a[0].len;",
    "    del(a[0]);",
    "}",
    "fn span_of_owners() void {",
    "    i32 mut* own mut@ own v = new(i32 mut* own, 2);",
    "    v[0] = new(i32);",
    "    del(v[0]);",
    "    i32 w = *v[0];",
    "    del(v);",
    "}",
    "fn deep_struct() void {",
    "    outer mut o = outer{};",
    "    o.in.a = new(i32);",
    "    o.e[0] = new(i32);",
    "    o.e[1] = new(i32);",
    "    del(o.e[1]); // @a",
    "    i32 v = *o.in.a;",
    "    i32 w = *o.e[0]; // U:o:d:a",
    "    del(o.in.a);",
    "    del(o.e[0]);",
    "}",
    "fn struct_pointer_field() void {",
    "    cell mut* own mut c = new(cell);",
    "    c->o = new(i32);",
    "    del(c->o);",
    "    i32 v = *c->o;",
    "    del(c);",
    "}",
    "fn if_else_store(bool c) void {",
    "    i32 mut* own mut p = new(i32);",
    "    del(p);",
    "    if (c) {",
    "        p = new(i32);",
    "    } else {",
    "        p = new(i32);",
    "    }",
    "    *p = 1;",
    "    del(p);",
    "}",
    "fn if_else_one(bool c) void {",
    "    i32 mut* own mut p = new(i32);",
    "    del(p); // @a",
    "    if (c) {",
    "        p = new(i32);",
    "    }",
    "    *p = 1; // U:p:d:a",
    "    del(p);",
    "}",
    "fn early_exit_del(bool c) void {",
    "    i32 mut* own mut p = new(i32);",
    "    if (c) {",
    "        del(p);",
    "        return;",
    "    }",
    "    *p = 1;",
    "    del(p);",
    "}",
    "fn swap_owners() void {",
    "    i32 mut* own mut p = new(i32);",
    "    i32 mut* own mut q = new(i32);",
    "    i32 mut* own t = move(p);",
    "    p = move(q);",
    "    q = move(t);",
    "    *p = 1;",
    "    *q = 2;",
    "    del(p);",
    "    del(q);",
    "}",
    "fn swap_wrong() void {",
    "    i32 mut* own mut p = new(i32);",
    "    i32 mut* own mut q = new(i32);",
    "    i32 mut* own t = move(p);",
    "    p = move(q); // @a",
    "    *q = 2; // U:q:m:a",
    "    del(p);",
    "    del(t);",
    "}",
    "fn switch_arms(i32 n) void {",
    "    i32 mut* own mut p = new(i32);",
    "    switch (n) {",
    "    case 0:",
    "        del(p); // @a",
    "    default:",
    "        *p = 1;",
    "    }",
    "    *p = 2; // U:p:d:a",
    "    del(p);",
    "}",
    "fn null_store() void {",
    "    i32 mut* own mut p = new(i32);",
    "    i32 mut* own mut q = new(i32);",
    "    del(q);",
    "    del(p);",
    "    p = move(q);",
    "    *p = 1;",
    "    del(p);",
    "}",
    "fn null_literal() void {",
    "    i32 mut* own mut p = new(i32);",
    "    del(p);",
    "    p = null;",
    "    *p = 1;",
    "}",
    "fn address_after_del() void {",
    "    i32 mut* own mut x = new(i32);",
    "    del(x); // @a",
    "    i32 mut* own mut* px = &x;",
    "    i32 v = **px; // U:x:d:a",
    "}",
    "fn struct_literal_store() void {",
    "    pair mut s = pair{};",
    "    s.a = new(i32);",
    "    del(s.a);",
    "    s = pair{};",
    "    i32 v = *s.a;",
    "}",
    "fn field_after_whole_move() void {",
    "    pair mut s = pair{};",
    "    s.a = new(i32);",
    "    s.b = new(i32);",
    "    pair t = move(s); // @a",
    "    s.a = new(i32);",
    "    i32 v = *s.a;",
    "    i32 w = *s.b; // U:s:m:a",
    "    del(s.a);",
    "    del(t.a);",
    "    del(t.b);",
    "}",
    "fn global_load() void {",
    "    i32 mut* own mut x = new(i32);",
    "    KEPT = &x;",
    "    del(x); // @a",
    "    i32 v = **KEPT; // U:x:d:a",
    "}",
    "fn global_del_through() void {",
    "    i32 mut* own mut x = new(i32);",
    "    KEPT = &x;",
    "    del(*KEPT); // @a",
    "    *x = 1; // U:x:d:a",
    "}",
    "fn global_move_through() void {",
    "    i32 mut* own mut x = new(i32);",
    "    KEPT = &x;",
    "    i32 mut* own y = move(*KEPT); // @a",
    "    *x = 1; // U:x:m:a",
    "    del(y);",
    "}",
    "fn first(bag* b) i32* {",
    "    return null;",
    "}",
    "fn look_bag(bag mut* b) void {",
    "}",
    "fn split_before() void {",
    "    bag mut b = bag{};",
    "    i32* p = first(&b); // @a",
    "    i32 w = *p; // U:b:c:a",
    "    del(b.data);",
    "}",
    "fn split_read(bag* b) void {",
    "    i32* p = first(b);",
    "    i32 w = *p;",
    "}",
    "fn split_after() void {",
    "    bag mut b = bag{};",
    "    split_read(&b);",
    "    del(b.data);",
    "}",
    "fn fill_before(i32* v) bag {",
    "    g(); // @a",
    "    i32 w = *v; // U::c:a",
    "    return bag{};",
    "}",
    "fn fill_parts(u8 mut@ data, i32* v) void {",
    "    g();",
    "    data[0] = cast(*v, u8);",
    "}",
    "fn fill_after(i32* v) bag {",
    "    u64 n = 1;",
    "    bag b = bag{new(u8, n), n};",
    "    fill_parts(b.data, v);",
    "    return b;",
    "}",
    "fn narrow_before(bag* src) void {",
    "    bag mut b = bag{};",
    "    look_bag(&b); // @a",
    "    i32 w = *first(src); // U:b:c:a",
    "    del(b.data);",
    "}",
    "fn named() i32 {",
    "    bag mut b = bag{};",
    "    look_bag(&b);",
    "    del(b.data);",
    "    return 0;",
    "}",
    "fn narrow_after(bag* src) void {",
    "    i32 n = named();",
    "    i32 w = *first(src);",
    "}",
    "fn early_before(bag* src) void {",
    "    i32* p = first(src);",
    "    bag mut b = bag{};",
    "    look_bag(&b); // @a",
    "    i32 w = *p; // U:b:c:a",
    "    del(b.data);",
    "}",
    "fn early_after(bag* src) void {",
    "    i32 w = *first(src);",
    "    bag mut b = bag{};",
    "    look_bag(&b);",
    "    del(b.data);",
    "}",
    "fn method_before() void {",
    "    bag mut b = bag{};",
    "    b.data = new(u8, 1);",
    "    look_bag(&b); // @a",
    "    u8 x = b.data[0]; // U:b:c:a",
    "    del(b.data);",
    "}",
    "fn first_byte(bag* b) u8 {",
    "    return b->data[0];",
    "}",
    "fn method_after() void {",
    "    bag mut b = bag{};",
    "    b.data = new(u8, 1);",
    "    look_bag(&b);",
    "    u8 x = first_byte(&b);",
    "    del(b.data);",
    "}",
    "fn make_bag() bag {",
    "    return bag{new(u8, 1), 1};",
    "}",
    "fn stored_before() void {",
    "    bag mut b = make_bag();",
    "    look_bag(&b); // @a",
    "    u8* p = &b.data[0]; // U:b:c:a",
    "    del(b.data);",
    "}",
    "fn stored_after() void {",
    "    bag mut b = make_bag();",
    "    u8* p = &b.data[0];",
    "    look_bag(&b);",
    "    del(b.data);",
    "}",
    "fn main() i32 {",
    "    return 0;",
    "}",
};

