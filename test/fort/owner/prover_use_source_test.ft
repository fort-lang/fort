// Lowers the function `name` of the checked source of `e` into *out, and holds that the verifier
// accepts it.
fn lower(lower_env.env mut* e, string name, fir.func mut* out) void {
    fir_lower.report mut why = fir_lower.report{};
    if (!fir_lower.lower_function(&e->c.ck, lower_env.decl(e, name), out, &why)) {
        panic("prover_use_source_test: the lowering refuses the function");
    }
    pass_env.verified(e, out, "prover_use_source_test: the verifier refuses the lowering");
}

// Whether the words of `list`, which spaces part, hold `word`.
fn has_word(string list, string word) bool {
    u64 mut start = 0;
    u64 mut i = 0;
    while (i <= list.len) {
        if (i == list.len || list[i] == ' ') {
            if (list[start..i] == word) {
                return true;
            }
            start = i + 1;
        }
        i += 1;
    }
    return false;
}

// The line of item `index` of block `b` of `f`: a statement, or the terminator when `index` is the
// count of the statements.
fn item_line(fir.func* f, u32 b, u32 index) u32 {
    if (index < fir.block_statement_count(f, b)) {
        return fir.block_statement(f, b, index)->loc.line;
    }
    return fir.block_at(f, b)->term.loc.line;
}

// Writes the word of each use of `p` that `p` does not prove into `out`, once each, with a space
// between two words, and gives their count. Holds the count of the unproved uses of `p`.
fn write_words(fir.func* f, prover.proof* p, strbuf.str_buf mut* out) u64 {
    strbuf.clear(out);
    strbuf.str_buf mut word = strbuf.create();
    defer strbuf.free(&word);
    u32 mut unproved = 0;
    u64 mut words = 0;
    u64 mut k = 0;
    while (k < p->uses.len) {
        prover.use* u = &p->uses[k];
        k += 1;
        if (u->proved) {
            continue;
        }
        unproved += 1;
        strbuf.clear(&word);
        strbuf.append_u64(&word, cast(item_line(f, u->block, u->index), u64));
        strbuf.push(&word, ':');
        strbuf.append(&word, fir.local_name(fir.local_at(f, u->local)));
        strbuf.push(&word, ':');
        if (u->op_kind == prover.operation_kind.op_move) {
            strbuf.push(&word, 'm');
        } else if (u->op_kind == prover.operation_kind.op_del) {
            strbuf.push(&word, 'd');
        } else {
            strbuf.push(&word, 'c');
        }
        strbuf.append_u64(&word, cast(item_line(f, u->op_block, u->op_index), u64));
        if (!has_word(strbuf.view(out), strbuf.view(&word))) {
            if (words > 0) {
                strbuf.push(out, ' ');
            }
            strbuf.append(out, strbuf.view(&word));
            words += 1;
        }
    }
    assert(p->use_unproved == unproved && !p->use_over);
    return words;
}

// Counts the words of `list`, which spaces part.
fn count_words(string list) u64 {
    if (list.len == 0) {
        return 0;
    }
    u64 mut count = 1;
    for (char ch : list) {
        if (ch == ' ') {
            count += 1;
        }
    }
    return count;
}

// Whether `got` holds each word of `want`, which a space separates.
fn has_each_word(string got, string want) bool {
    u64 mut start = 0;
    u64 mut i = 0;
    while (i <= want.len) {
        if (i == want.len || want[i] == ' ') {
            if (i != start && !has_word(got, want[start..i])) {
                return false;
            }
            start = i + 1;
        }
        i += 1;
    }
    return true;
}

// Each function of SOURCE gives the set of unproved uses of SOURCE_USES: each word that it gives
// stands there, and it gives as many words.
fn the_unproved_uses_of_lowered_source_follow_the_rule() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    lower_env.check_lines(&e, SOURCE[..], true);
    strbuf.str_buf mut got = strbuf.create();
    defer strbuf.free(&got);
    u64 mut k = 0;
    while (k < SOURCE_NAMES.len) {
        fir.func mut f = fir.func{};
        lower(&e, SOURCE_NAMES[k], &f);
        prover.proof mut p = prover.prove(&f);
        u64 words = write_words(&f, &p, &got);
        prover.free(&p);
        fir.func_free(&f);
        string want = SOURCE_USES[k];
        bool same = words == count_words(want) && has_each_word(strbuf.view(&got), want);
        if (!same) {
            eprintln(SOURCE_NAMES[k], " gives '", strbuf.view(&got), "' and not '", want, "'");
            panic("prover_use_source_test: the uses differ");
        }
        k += 1;
    }
    println("source uses ok");
}

fn main() i32 {
    the_unproved_uses_of_lowered_source_follow_the_rule();
    return 0;
}
