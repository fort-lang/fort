// The diagnostics of `loop_exits` past the limit of the aggregate work: each exit is an error, and
// the first takes the note of the aggregate limit.
string[5] LIMIT_REPORTED = {
    "70:13: leak: cannot prove 'p.a' is empty at this exit",
    "70:13: del or move 'p.a' before this exit",
    "70:13: the function exceeds the aggregate work limit; split it",
    "74:5: leak: cannot prove 'p.a' is empty at this exit",
    "74:5: del or move 'p.a' before this exit",
};

// Holds that the diagnostics from `before` on are those of `want`, in order and each in the file
// `file`: an error for each text of the leak rule and a note for each other text.
fn expect_errors(lower_env.env mut* e, u64 before, string file, string@ want) void {
    if (check_env.reports(&e->c) != before + want.len) {
        eprintln(check_env.reports(&e->c) - before, " diagnostics and not ", want.len);
        panic("prover_aggregate_test: the count of the errors differs");
    }
    u64 mut k = 0;
    while (k < want.len) {
        if (check_env.report_text(&e->c, before + k) != want[k]) {
            eprintln(check_env.report_text(&e->c, before + k), " and not ", want[k]);
            panic("prover_aggregate_test: an error of the leak rule differs");
        }
        string severity = check_env.report_severity(&e->c, before + k);
        if (str.find(want[k], ": leak: cannot prove '") >= 0) {
            assert(severity == "error");
        } else {
            assert(severity == "note");
        }
        assert(check_env.report_file(&e->c, before + k) == file);
        k += 1;
    }
}

// Removes the last statement of the block of the first `return` of `f`: the call that takes the
// temporary of `temp_arg` and of `temp_cond`.
fn drop_call(fir.func mut* f) void {
    u32 mut b = 0;
    while (fir.block_at(f, b)->term.kind != fir.term_kind.tk_return) {
        b += 1;
    }
    fir.block_mut(f, b)->statements.len -= 1;
}

// Reports the errors of the leak rule of the function `name` of the checked source of `e`
// (report.write_leaks), with the proof of prover.prove, or past the limit with prover.prove_within
// and the limit 0, after the last statement of its first `return` is gone when `dropped`. Holds
// that each exit that the proof does not prove is an error of the function (has_error).
fn report_function(lower_env.env mut* e, string name, bool limit, bool dropped) void {
    fir.func mut* own f = fir.func_make();
    defer fir.func_drop_made(move(f));
    lower(e, name, f);
    if (dropped) {
        drop_call(f);
    }
    prover.proof mut* own p = prover.make();
    defer prover.drop_made(move(p));
    if (limit) {
        *p = prover.prove_within(f, 0);
    } else {
        *p = prover.prove(f);
    }
    assert(prover.has_error(p) == (p->aggregate_leaks > 0 || p->leaks > 0));
    report.write_leaks(f, p, &e->c.m.s);
}

// The error of D17.20 names the first owner of each exit that the pass does not prove, at its
// `dead` marker or its `return`, once for each location and local, in the file of the function.
// Past the work limit the first error takes the note of the aggregate limit.
fn the_errors_name_the_first_owner_of_each_exit() void {
    lower_env.env mut* own e = lower_env.make();
    defer lower_env.drop_made(move(e));
    lower_env.check_lines(e, SOURCE[..], true);
    string file = lower_env.decl_file(e, "keep");
    assert(str.ends_with(file, "main.ft"));
    u64 mut before = check_env.reports(&e->c);
    u64 mut k = 0;
    while (k < SOURCE_NAMES.len) {
        report_function(e, SOURCE_NAMES[k], false, false);
        k += 1;
    }
    expect_errors(e, before, file, REPORTED[..]);
    before = check_env.reports(&e->c);
    report_function(e, "temp_arg", false, true);
    report_function(e, "temp_cond", false, true);
    expect_errors(e, before, file, TEMP_REPORTED[..]);
    before = check_env.reports(&e->c);
    report_function(e, "loop_exits", true, false);
    expect_errors(e, before, file, LIMIT_REPORTED[..]);
}

// A FIR text with locations and no tree: a parameter gives its declared name and the names of
// the fields, and a temporary its FIR place and the numbers of the fields.
string[17] TEXT = {
    "fn main.t1(_1 (q): wrap) -> void {",
    "    let _2 (v): node mut* own[2] #2:5;",
    "    let _3: wrap #3:9;",
    "    let _4: node mut* own;",
    "    bb0: {",
    "        live(_2) #2:5;",
    "        _2 = const zero node mut* own[2] #2:5;",
    "        _3 = const zero wrap #3:9;",
    "        _4 = alloc<node>(const u64 1) #3:9;",
    "        check(overwrite: _3.1.1) -> bb1 #3:9;",
    "    }",
    "    bb1: {",
    "        _3.1.1 = move _4 #3:9;",
    "        dead(_2) #4:1;",
    "        return #4:1;",
    "    }",
    "}",
};

string[4] TEXT_REPORTED = {
    "4:1: leak: cannot prove 'q.p.a' is empty at this exit",
    "4:1: del or move 'q.p.a' before this exit",
    "4:1: leak: cannot prove '_3.1.1' is empty at this exit",
    "4:1: del or move '_3.1.1' before this exit",
};

// With no tree, the error names a temporary by its FIR place.
fn the_error_of_a_fir_text_names_the_fir_place() void {
    lower_env.env mut* own e = lower_env.make();
    defer lower_env.drop_made(move(e));
    fir.module mut* own m = fir.module_make();
    *m = pass_env.parse(e, PRELUDE[..], TEXT[..]);
    defer fir.module_drop_made(move(m));
    fir.func* f = fir.module_function_at(m, 0);
    pass_env.verified(e, f, "prover_aggregate_test: the verifier refuses the input");
    prover.proof mut* own p = prover.make();
    *p = prover.prove(f);
    defer prover.drop_made(move(p));
    assert(p->aggregate_leaks == 2 && p->leaks == 0 && prover.has_error(p));
    u64 before = check_env.reports(&e->c);
    report.write_leaks(f, p, &e->c.m.s);
    expect_errors(e, before, "t.fir", TEXT_REPORTED[..]);
}

fn main() i32 {
    each_exit_holds_the_owners_below_its_local();
    println("aggregate exits ok");
    each_exit_of_lowered_source_has_its_verdict();
    println("aggregate source ok");
    each_form_ends_its_local();
    println("aggregate forms ok");
    the_aggregate_work_has_a_limit_of_its_own();
    println("aggregate work ok");
    the_errors_name_the_first_owner_of_each_exit();
    println("aggregate errors ok");
    the_error_of_a_fir_text_names_the_fir_place();
    println("aggregate text ok");
    return 0;
}
