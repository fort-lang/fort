//! run
//! flags: -I ../../src -I support
//! stdout:
//| text: sites 38, proved 23, rejected with an event 12, false rejects 3
//| source: sites 82, proved 51, rejected with an event 22, false rejects 9
/// Holds the verdicts of the stores of a whole value of an owning aggregate in owner.prover
/// (D17.11, spec/fir.md 11, Whole stores) against the runs of fir.interpreter and the events of
/// fir.shadow (spec/ownership-design.md 3). A store over an owner slot of a live allocation is an
/// `overwrite` event at the store. A whole store that the pass proves writes over no such slot on
/// any run, so its run has no `overwrite` event there; a run that has one is a false accept, and
/// the test panics. An `overwrite` event names the exit location of its statement, so each
/// expansion of a deferred store at its own exit is a site of its own. Each case gives the verdict
/// of each of its whole stores, in the order of the proof: `P` for a store that the pass proves,
/// `R+` for a store that it does not prove and whose run has an `overwrite` event there, and `R-`
/// for a store that it does not prove and whose run has none, a false reject. Each set prints its
/// counts.
import check_env;
import fort.fir;
import fort.fir_lower;
import fort.fir_print;
import fort.fir_verify;
import fort.owner.prover;
import run_env;
import std.str;
import std.strbuf;

// The declarations that the cases name. `fill` gives a box whose owner holds an allocation.
// `make` gives a box in an allocation whose owner holds an allocation, and `make_empty` one whose
// owner is null. `G` is a global box, and a `holder` holds a box in an allocation of its own.
string[43] PRELUDE = {
    "struct box {",
    "    u8 mut* own data;",
    "}",
    "box mut G = box{};",
    "fn fill() box {",
    "    return box{new(u8)};",
    "}",
    "fn take(box b) void {",
    "    del(b.data);",
    "}",
    "fn make() box mut* own {",
    "    box mut* own p = new(box);",
    "    p->data = new(u8);",
    "    return p;",
    "}",
    "fn make_empty() box mut* own {",
    "    return new(box);",
    "}",
    "fn free_made(box mut* own p) void {",
    "    box kept = move(*p);",
    "    del(p);",
    "    take(move(kept));",
    "}",
    "struct holder {",
    "    box mut* own inner;",
    "}",
    "fn free_holder(holder mut* own h) void {",
    "    free_made(move(h->inner));",
    "    del(h);",
    "}",
    "fn fill_at(box mut* own mut* pp) void {",
    "    box mut* q = *pp;",
    "    del(q->data);",
    "    q->data = new(u8);",
    "}",
    "struct twin {",
    "    box a;",
    "    box b;",
    "}",
    "fn one() u64 {",
    "    return 1;",
    "}",
    "",
};

// The FIR cases. Each store of a case stands at a location of its own, the line of the statement
// in the comment of the case.
string[294] TEXT = {
