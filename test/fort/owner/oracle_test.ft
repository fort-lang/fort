/// The sets of programs (design 3.6), in the order of their reports.
enum family {
    fm_hand,
    fm_seeded,
    fm_shapes,
    fm_fir,
}

// No item.
u64 NONE = 18446744073709551615;

// The most rounds of writing and checking that one batch takes.
u64 ROUNDS = 8;

// One function or program of a batch that the test runs: its index in its family, its lines in
// the batch and whether it left the batch. Four fields name the rules of the compiler that refuse
// the item. `error` says that the pass gives a function of the item an error of D17.11, D17.20 or
// D17.21, or the error of D17.9 for a drop that is not release-only. `leak_line`, `whole_line`
// and `span_line` say that the item gets a line of `--leak-report`, of `--whole-store-report` or
// of `--span-del-report` (prove_batch, refuse_dels). An item also has each rule of each item
// whose function it names (refuse_callers). `errors` counts the error events of its runs that no
// report line takes (judge_event), and `failure` is the first of them.
struct item {
    u64 index;
    u32 first;
    u32 last;
    bool dropped;
    bool error;
    bool leak_line;
    bool whole_line;
    bool span_line;
    u64 errors;
    shadow.event failure;
    bool silent;
    u64 fault;
    diag.loc fault_at;
}

// Whether a rule of the compiler refuses the item `it`: it has an error or a report line.
fn is_refused(item* it) bool {
    return it->error || it->leak_line || it->whole_line || it->span_line;
}

// Gives the item `to` each rule that refuses `from`, and says whether `to` changed.
fn take_rules(item mut* to, item* from) bool {
    bool changed = (from->error && !to->error) || (from->leak_line && !to->leak_line)
        || (from->whole_line && !to->whole_line) || (from->span_line && !to->span_line);
    to->error = to->error || from->error;
    to->leak_line = to->leak_line || from->leak_line;
    to->whole_line = to->whole_line || from->whole_line;
    to->span_line = to->span_line || from->span_line;
    return changed;
}

// A site of a batch. `item` is the item of its function, or NONE for a function of the
// declarations of the batch or of std.rt. `rejected` says that the pass does not prove a check
// at the site, and `event` that a run gave an `overwrite` event that marks the site.
struct site {
    ast.sym* sym;
    u32 line;
    u32 col;
    u64 item;
    bool rejected;
    bool event;
}

struct site_vec {
    site mut@ own items;
    u64 len;
}

// An exit site of rule (c) part 1: a `dead` marker of an owner local outside an abort block, or a
// `return`. `line` and `col` are the location of its item, which is a line from DEAD_LINE for a
// `dead` (relocate), and `at` the location that the test prints. `rejected` says that the pass
// does not prove an obligation of the site, and `event` that a run gave a `leak` event there.
// `unsure` marks a `return` of a function with a parameter or a temporary of an owning aggregate
// type, whose `leak` events do not mark it. For a site of the owning aggregate
// locals, `unsure` says that only an exit of an owner local at its `return` rejects it: the event
// does not tell the two apart, so the site is masked (add_aggregates).
struct exit_site {
    ast.sym* sym;
    u32 line;
    u32 col;
    diag.loc at;
    u64 item;
    bool rejected;
    bool event;
    bool unsure;
}

struct exit_vec {
    exit_site mut@ own items;
    u64 len;
}

// A site of rule (b): the function `sym`, the location of an item and the local `local` whose owner
// the item reads. `rejected` says that the pass does not prove the use, and `event` that a run gave
// a `use after move` event that marks the sites of that function and local.
struct use_site {
    ast.sym* sym;
    u32 line;
    u32 col;
    u32 local;
    u64 item;
    bool rejected;
    bool event;
}

struct use_vec {
    use_site mut@ own items;
    u64 len;
}

// A `dead` marker of a batch before relocate moved it to line DEAD_LINE and its position in the
// vector: its location, and whether its block is an abort block.
struct dead_mark {
    diag.loc at;
    bool abort;
}

struct dead_vec {
    dead_mark mut@ own items;
    u64 len;
}

// The first line of the `dead` markers of a batch after relocate, as the judgement reads it.
u32 DEAD_LINE = judgement.DEAD_LINE;

// The counts of one set or one batch. `ends` counts the runs by interpreter.outcome_kind, the
// way that each run ended. `accepted` counts the items that the compiler accepts with no error and
// no report line. `failing` counts the items with an error event that no report line takes,
// `failing_by` by the kind of their first one, and `failing_refused` those of them that have a
// report line. The five vectors after it count the events by shadow.event_kind: the errors that
// a report line takes, the errors that no line takes, those of them of a trusted kind in an item
// that the compiler accepts, the events that are no error, and the events of an item with an
// error, which get no ruling. The fields from `sites` to `false_rejects` count the sites of rule
// (a).
// `leak` counts the exit sites of rule (c) part 1 in the same way, `inner` the sites of rule (c)
// part 2, `uses` the sites of rule (b), with its false accepts by event, and `aggregate` the
// sites of part 1 on the owning aggregate locals. `after_forged` counts the rejected sites of
// each rule with no event at or after a `forged` event of their function (is_after_forged).
// `masked` counts the sites of the owning aggregate locals that only an exit of an owner local
// rejects, and `masked_events` those of them with an event.
struct counts {
    u64 items;
    u64 dropped;
    u64 runs;
    u64[7] ends;
    u64 accepted;
    u64 failing;
    u64 failing_refused;
    u64[disposition.KINDS] failing_by;
    u64[judgement.CLASS_COUNT + 1] failing_class;
    u64[disposition.KINDS] excused;
    u64[disposition.KINDS] unexcused;
    u64[disposition.KINDS] trusted;
    u64[disposition.KINDS] no_error;
    u64[disposition.KINDS] rejected_events;
    u64 sites;
    u64 rejected;
    u64 events;
    u64 false_accepts;
    u64 false_rejects;
    u64[5] leak;
    u64[5] inner;
    u64 after_forged;
    u64[5] uses;
    u64[5] aggregate;
    u64 masked;
    u64 masked_events;
}

// The fields of `counts.leak` and of `counts.inner`.
u64 LEAK_SITES = 0;
u64 LEAK_REJECTED = 1;
u64 LEAK_EVENTS = 2;
u64 LEAK_FALSE_ACCEPTS = 3;
u64 LEAK_FALSE_REJECTS = 4;

// One batch: the text of an entry module, its items, its functions as the lowering makes them,
// and its sites. `lines` is the hand case of a batch of the hand set or of the seeded family, and
// the FIR text of a batch of FIR cases, whose item `k` is function `k` of the text.
// `inners` holds the sites of rule (c) part 2 at a `del`, and `casts` those at a `cast`.
// `forged` holds the location of each `forged` event of its runs, `aborts` says for each `dead`
// marker whether its block ends in an abort, and `named` holds each line that a report line of
// the batch names (judgement.name_reports, refuse_dels).
// `uses` holds the sites of rule (b), and `aggregates` the exit sites of part 1 on the owning
// aggregate locals.
struct batch {
    family kind;
    string@ lines;
    item mut@ own items;
    strbuf.str_buf text;
    fir.module m;
    site_vec sites;
    exit_vec exits;
    dead_vec deads;
    bool mut@ own aborts;
    judgement.named_vec named;
    site_vec inners;
    site_vec casts;
    site_vec forged;
    use_vec uses;
    exit_vec aggregates;
}

// A batch of `kind` over the hand case `lines`, with `count` items, in an allocation of its own:
// each step of a run takes the batch by pointer.
fn batch_make(family kind, string@ lines, u64 count) batch mut* own {
    batch mut* own bt = new(batch);
    bt->kind = kind;
    bt->lines = lines;
    bt->items = new(item, count);
    return bt;
}

// Frees a batch that the caller moves in: the items, the text, the module, then each vector of
// sites.
fn batch_drop(batch mut bt) void {
    del(bt.items);
    strbuf.drop(move(bt.text));
    fir.module_drop(move(bt.m));
    del(bt.sites.items);
    del(bt.exits.items);
    del(bt.deads.items);
    del(bt.aborts);
    del(bt.named.items);
    del(bt.inners.items);
    del(bt.casts.items);
    del(bt.forged.items);
    del(bt.uses.items);
    del(bt.aggregates.items);
}

// Ends a batch of batch_make that the caller moves in: the value moves out before the `del` of the
// allocation, and batch_drop frees it.
fn batch_drop_made(batch mut* own p) void {
    batch kept = move(*p);
    del(p);
    batch_drop(move(kept));
}

// Whether `s` is a function of the entry module of the batch.
fn is_in_main(ast.sym* s) bool {
    return s->owner != null && s->owner->name == "main";
}

// Advances *line over the newlines of `b` after *seen.
fn count_lines(strbuf.str_buf* b, u64 mut* seen, u32 mut* line) void {
    string text = strbuf.view(b);
    for (u64 mut i = *seen; i < text.len; i++) {
        if (text[i] == '\n') {
            *line += 1;
        }
    }
    *seen = text.len;
}

// Writes the text of `bt` with each item that stays, and the lines of each item.
fn write_batch(batch mut* bt) void {
    strbuf.str_buf mut* b = &bt->text;
    strbuf.clear(b);
    // the cases declare and call C, `oracle_keep` and its kin, so each text is trusted (D9.8); the
    // form shares the first line, so each item keeps its lines
    strbuf.append(b, check_env.TRUST);
    if (bt->kind == family.fm_hand) {
        generator.write_case(b, bt->lines);
        bt->items[0].first = 1;
        bt->items[0].last = cast(bt->lines.len, u32);
        return;
    }
    if (bt->kind == family.fm_fir) {
        generator.write_lines(b, FIR_PRELUDE[..]);
        return;
    }
    if (bt->kind == family.fm_seeded) {
        generator.write_declarations(b, bt->lines);
    } else {
        generator.write_shape_decls(b);
    }
    u64 mut seen = 0;
    u32 mut line = 1;
    count_lines(b, &seen, &line);
    for (u64 mut k = 0; k < bt->items.len; k++) {
        item mut* it = &bt->items[k];
        if (it->dropped) {
            continue;
        }
        it->first = line;
        if (bt->kind == family.fm_seeded) {
            generator.write_seeded(b, bt->lines, it->index);
        } else {
            generator.write_shape(b, it->index);
        }
        count_lines(b, &seen, &line);
        it->last = line - 1;
    }
}

// Drops the item whose lines hold `line`, and gives whether one did. A hand case never leaves.
fn drop_at(batch mut* bt, u32 line) bool {
    for (u64 mut k = 0; bt->kind != family.fm_hand && k < bt->items.len; k++) {
        item mut* it = &bt->items[k];
        if (!it->dropped && it->first <= line && line <= it->last) {
            it->dropped = true;
            return true;
        }
    }
    return false;
}

// The position in `bt->items` of the item of the function `s`, or NONE.
fn item_of(batch* bt, ast.sym* s) u64 {
    for (u64 mut k = 0; bt->kind == family.fm_fir && k < bt->m.funcs.len; k++) {
        if (bt->m.funcs.items[k].sym == s) {
            return k;
        }
    }
    if (bt->kind == family.fm_fir || !is_in_main(s)) {
        return NONE;
    }
    for (u64 mut k = 0; k < bt->items.len; k++) {
        item* it = &bt->items[k];
        if (!it->dropped && it->first <= s->decl.line && s->decl.line <= it->last) {
            return k;
        }
    }
    return NONE;
}

// Checks the text of `bt` in a fresh sandbox, and gives whether it checks with no diagnostic. Each
// item whose lines hold an error leaves the batch.
fn check_batch(check_env.env mut* c, batch mut* bt) bool {
    check_env.reopen(c);
    strbuf.str_buf mut b = strbuf.create();
    defer del(b.data);
    run_env.add_std(c, run_env.RUNTIME[..]);
    run_env.join(&b, STRBUF[..]);
    check_env.add(c, "std/strbuf.ft", strbuf.view(&b));
    modules_env.std_dir_without_runtime(&c->m, "std");
    c->want_main = false;
    if (check_env.check_src(c, strbuf.view(&bt->text))) {
        return true;
    }
    bool mut left = false;
    for (u64 mut i = 0; i < modules_env.reports(&c->m); i++) {
        diag.record r = modules_env.report_at(&c->m, i);
        if (r.severity == diag.severity.error && str.ends_with(r.loc.file, "main.ft")) {
            left = drop_at(bt, r.loc.line) || left;
        }
    }
    if (!left) {
        eprintln(check_env.report_text(c, 0));
        panic("oracle_test.check_batch: a declaration or a hand case does not check");
    }
    return false;
}

// Lowers each function with a body of the closure into `bt->m`, and gives whether the lowering
// and the verifier accept each. An item with a refused function leaves the batch.
fn lower_batch(check_env.env mut* c, batch mut* bt) bool {
    fir_verify.runtime rt = fir_verify.runtime_of(&c->ck);
    bool mut accepted = true;
    for (u64 mut i = 0; i < check.check_sym_count(&c->ck); i++) {
        ast.sym* s = check.check_sym_at(&c->ck, i);
        if (s->kind == ast.sym_kind.s_fn && s->node != null && s->node->b != null
            && !lower_one(c, bt, s, &rt)) {
            accepted = false;
        }
    }
    return accepted;
}

// Lowers the function `s` into `bt->m`, and gives whether the lowering and the verifier accept
// it. A refused function leaves the batch with its item. The function reads `s` before it lends
// its own FIR function, so the use rule of `move` and `del` holds each read.
fn lower_one(check_env.env mut* c, batch mut* bt, ast.sym* s, fir_verify.runtime* rt) bool {
    ast.node* body = s->node;
    u32 line = s->decl.line;
    bool in_main = is_in_main(s);
    fir.func mut* own f = fir.func_make();
    // an accepted function moves out into the module, and the drop ends the empty value
    defer fir.func_drop_made(move(f));
    fir_lower.report mut why = fir_lower.report{};
    bool lowered = fir_lower.lower_function(&c->ck, body, f, &why);
    fir_verify.violation mut v = fir_verify.violation{};
    if (lowered && !fir_verify.find_violation(f, rt, &v)) {
        fir.module_add_function(&bt->m, move(*f));
        return true;
    }
    if (!in_main || !drop_at(bt, line)) {
        panic("oracle_test.lower_batch: the lowering or the verifier refuses a declaration");
    }
    return false;
}

// Parses the FIR text of `bt` against its checked declarations into `bt->m`, and holds that each
// function keeps every rule of the verifier.
fn parse_batch(check_env.env mut* c, batch mut* bt) void {
    strbuf.str_buf mut b = strbuf.create();
    defer del(b.data);
    generator.write_lines(&b, bt->lines);
    fir_parse.prelude pre = fir_parse.prelude{check_env.module_at(c, "main"), &c->ck};
    fir.module_free(&bt->m);
    bt->m = fir_parse.parse_module(&c->m.s, FIR_FILE, strbuf.view(&b), pre);
    if (check_env.errors(c) != 0) {
        eprintln(check_env.report_text(c, 0));
        panic("oracle_test.parse_batch: the FIR text does not parse");
    }
    fir_verify.runtime rt = fir_verify.runtime_of(&c->ck);
    for (u64 mut k = 0; k < bt->m.funcs.len; k++) {
        fir_verify.violation mut v = fir_verify.violation{};
        if (fir_verify.find_violation(&bt->m.funcs.items[k], &rt, &v)) {
            strbuf.clear(&b);
            fir_verify.violation_text(&bt->m.funcs.items[k], &v, &b);
            eprintln(strbuf.view(&b));
            panic("oracle_test.parse_batch: the verifier refuses a FIR case");
        }
    }
    if (bt->m.funcs.len != bt->items.len) {
        panic("oracle_test.parse_batch: the FIR text holds another count of functions");
    }
}

// Writes, checks and lowers `bt` until each item that stays checks, lowers and verifies. A batch
// of FIR cases is parsed in place of the lowering.
fn prepare(check_env.env mut* c, batch mut* bt) void {
    if (bt->kind == family.fm_fir) {
        write_batch(bt);
        check_batch(c, bt);
        parse_batch(c, bt);
        return;
    }
    for (u64 mut round = 0; round < ROUNDS; round++) {
        fir.module_free(&bt->m);
        bt->m = fir.module_new();
        write_batch(bt);
        if (check_batch(c, bt) && lower_batch(c, bt)) {
            return;
        }
    }
    panic("oracle_test.prepare: the batch does not settle");
}

// ---- sites -------------------------------------------------------------------------------------

// The kind of a site that add_site records.
enum site_kind {
    sk_check, // a check, of which one location holds one
    sk_store, // a store that needs a proof, which joins the verdict of a site at its location
    sk_event, // an `overwrite` event, which marks the site at its location
}

// Records the site `add`, or joins it to the site at its location. A second check at one location
// is an error of the test. A store joins its verdict to the site of the check at its location,
// where the lowering puts the store of the check (spec/fir.md 9.3): the site is rejected when the
// pass proves either of them not.
fn add_site(site_vec mut* v, site add, site_kind kind) void {
    for (u64 mut i = 0; i < v->len; i++) {
        site mut* t = &v->items[i];
        if (t->sym == add.sym && t->line == add.line && t->col == add.col) {
            if (kind == site_kind.sk_check) {
                panic("oracle_test.add_site: two checks stand at one location");
            }
            t->rejected = t->rejected || add.rejected;
            t->event = t->event || add.event;
            return;
        }
    }
    if (v->len == v->items.len) {
        site mut@ own bigger = new(site, fir.grown_capacity(v->len, "oracle_test: capacity"));
        for (u64 mut i = 0; i < v->len; i++) {
            bigger[i] = v->items[i];
        }
        del(v->items);
        v->items = move(bigger);
    }
    v->items[v->len] = add;
    v->len += 1;
}

// Records a site for each `check(overwrite: p)` and for each store that needs a proof of each
// function of `bt`, rejected when the pass does not prove it. The checks come first, so that two
// checks at one location stop the test whatever the order of their stores. Then the exit sites
// of rule (c) part 1 (add_exits), the sites of part 2 (add_inners), those of rule (b)
// (add_uses) and those of the owning aggregate locals (add_aggregates).
fn prove_batch(check_env.env mut* c, batch mut* bt) void {
    bt->named.len = 0;
    bt->sites.len = 0;
    bt->exits.len = 0;
    bt->inners.len = 0;
    bt->casts.len = 0;
    bt->uses.len = 0;
    bt->aggregates.len = 0;
    release.table mut* own drops = release.make();
    defer release.drop_made(move(drops));
    for (u64 mut i = 0; i < bt->m.funcs.len; i++) {
        fir.func* f = &bt->m.funcs.items[i];
        release.scan(drops, f);
        u64 owner = item_of(bt, f->sym);
        prover.proof mut* own p = prover.make();
        *p = prover.prove(f);
        add_proof(bt, f, owner, p);
        item mut lines = item{};
        take_lines(&lines, p, judgement.name_reports(c, &bt->named, f, p));
        if (is_refused(&lines) && owner == NONE) {
            panic("oracle_test.prove_batch: the compiler refuses a declaration of a batch");
        }
        if (owner != NONE) {
            take_rules(&bt->items[owner], &lines);
        }
        prover.drop_made(move(p));
    }
    release.solve(drops);
    refuse_dels(c, bt, drops);
}

// ---- the items that the compiler refuses -------------------------------------------------------

// Gives the item `it` each rule that refuses the function of the proof `p`, as
// driver.overwrite_entry does: an error of D17.11, D17.20 or D17.21 (prover.has_error), a line of
// `--leak-report` for a site of part 2 of the leak rule that the pass does not prove
// (report.write_inners), and a line of `--whole-store-report` for a store of a whole value of an
// owning aggregate that it does not prove (report.write_wholes).
fn take_lines(item mut* it, prover.proof* p, u32 reports) void {
    it->error = it->error || prover.has_error(p);
    it->leak_line = it->leak_line || (reports & judgement.REPORT_LEAK) != 0;
    it->whole_line = it->whole_line || (reports & judgement.REPORT_WHOLE) != 0;
}

// The item of `bt` whose text holds the line `line` of the entry module. A line outside each
// item, in a declaration of the batch, stops the test: each item runs with that declaration.
fn item_on(batch mut* bt, u32 line) item mut* {
    for (u64 mut k = 0; k < bt->items.len; k++) {
        item mut* it = &bt->items[k];
        if (!it->dropped && it->first <= line && line <= it->last) {
            return it;
        }
    }
    panic("oracle_test.item_on: a declaration of a batch holds a del of a span of owners");
}

// Gives each item of `bt` the rules of the checker for a `del` of a span of owners, as
// driver.overwrite_entry does after the last function (D17.9). The item of a `del(s, d)` whose
// drop `d` is not release-only by `drops` gets an error (judgement.refused_drain,
// release.report). The item of a `del` with one operand gets the line of `--span-del-report`
// (driver.write_span_dels), and `bt->named` gets the line of that `del`. A FIR case has no
// checked source, so the checker holds no `del` of it.
fn refuse_dels(check_env.env mut* c, batch mut* bt, release.table* drops) void {
    if (bt->kind == family.fm_fir) {
        return;
    }
    for (u64 mut i = 0; i < check.drain_count(&c->ck); i++) {
        u32 line = judgement.refused_drain(c, drops, i);
        if (line != 0) {
            item_on(bt, line)->error = true;
        }
    }
    for (u64 mut i = 0; i < check.span_del_count(&c->ck); i++) {
        diag.loc at = check.span_del_at(&c->ck, i)->a->loc;
        if (!judgement.is_entry(at.file)) {
            panic("oracle_test.refuse_dels: a module of the sandbox holds a del of a span");
        }
        item_on(bt, at.line)->span_line = true;
        judgement.push_named(&bt->named,
                             judgement.named_line{judgement.REPORT_SPAN, at.line, null});
    }
}

// Gives the item `self` each rule of each other item of `bt` whose function the statement `st`
// of `f` names: as the callee of a direct call, or as a constant of a function that it reads. It
// says whether the item `self` changed.
fn take_named(batch mut* bt, fir.func* f, fir.statement* st, u64 self) bool {
    bool mut changed = false;
    if (st->kind == fir.stmt_kind.st_assign && st->value.kind == fir.rvalue_kind.rv_call
        && st->value.callee == fir.callee_kind.cl_fn) {
        u64 g = item_of(bt, st->value.callee_sym);
        if (g != NONE && g != self) {
            item from = bt->items[g];
            changed = take_rules(&bt->items[self], &from) || changed;
        }
    }
    fir.operand mut o = fir.operand{};
    for (u32 mut r = 0; fir.stmt_reads(f, st, r, &o); r++) {
        if (o.kind != fir.operand_kind.ok_const || o.value.kind != fir.const_kind.ck_fn) {
            continue;
        }
        u64 g = item_of(bt, o.value.sym);
        if (g != NONE && g != self) {
            item from = bt->items[g];
            changed = take_rules(&bt->items[self], &from) || changed;
        }
    }
    return changed;
}

// Gives each item of `bt` the rules of each item whose function it names (take_named), until no
// item changes: a run of such an item can run the code that the compiler refuses, so the item
// has that rule too. The report lines of the callee name their own lines only.
fn refuse_callers(batch mut* bt) void {
    bool mut changed = true;
    while (changed) {
        changed = false;
        for (u64 mut i = 0; i < bt->m.funcs.len; i++) {
            fir.func* f = &bt->m.funcs.items[i];
            u64 a = item_of(bt, f->sym);
            for (u32 mut b = 0; a != NONE && b < fir.block_count(f); b++) {
                fir.block* bl = fir.block_at(f, b);
                for (u64 mut k = 0; k < bl->statements.len; k++) {
                    if (take_named(bt, f, &bl->statements.items[k], a)) {
                        changed = true;
                    }
                }
            }
        }
    }
}

// Records the sites of the proof `p` of the function `f` of the item `owner`, as prove_batch
// gives them.
fn add_proof(batch mut* bt, fir.func* f, u64 owner, prover.proof* p) void {
    for (u32 mut b = 0; b < fir.block_count(f); b++) {
        fir.terminator* t = &fir.block_at(f, b)->term;
        if (t->kind == fir.term_kind.tk_check_overwrite) {
            add_site(&bt->sites, site{f->sym, t->loc.line, t->loc.col, owner,
                                      !prover.is_proved(p, b), false},
                     site_kind.sk_check);
        }
    }
    for (u64 mut k = 0; k < p->stores.len; k++) {
        prover.store* st = &p->stores[k];
        diag.loc at = fir.block_statement(f, st->block, st->index)->loc;
        add_site(&bt->sites, site{f->sym, at.line, at.col, owner, !st->proved, false},
                 site_kind.sk_store);
    }
    add_exits(bt, f, p);
    add_inners(bt, f, p);
    add_uses(bt, f, p);
    add_aggregates(bt, f, p);
}

// Moves each `dead` marker of each function of `bt` to its own line, DEAD_LINE and its position
// in bt->deads, and records where it stood. The run gives the `leak` event of a `dead` at its
// location, and the markers of one scope share one location, so the line names the local whose
// slots the `dead` ends. A `dead` changes no fact and no run, so the move changes no verdict and no
// other event.
fn relocate(batch mut* bt) void {
    bt->deads.len = 0;
    for (u64 mut i = 0; i < bt->m.funcs.len; i++) {
        fir.func mut* f = &bt->m.funcs.items[i];
        for (u32 mut b = 0; b < fir.block_count(f); b++) {
            fir.block mut* bl = fir.block_mut(f, b);
            for (u64 mut k = 0; k < bl->statements.len; k++) {
                fir.statement mut* st = &bl->statements.items[k];
                if (st->kind != fir.stmt_kind.st_dead) {
                    continue;
                }
                push_dead(&bt->deads, dead_mark{st->loc, fir.term_is_abort(&bl->term)});
                push_abort(bt, fir.term_is_abort(&bl->term));
                st->loc.line = DEAD_LINE + cast(bt->deads.len - 1, u32);
                st->loc.end_line = st->loc.line;
            }
        }
    }
}

// Records at position `bt->deads.len - 1` of `bt->aborts` whether the block of the last `dead`
// marker of `bt->deads` ends in an abort: the vector that judgement.at_abort reads.
fn push_abort(batch mut* bt, bool abort) void {
    if (bt->deads.len > bt->aborts.len) {
        bool mut@ own bigger = new(bool, fir.grown_capacity(bt->aborts.len, "oracle_test"));
        for (u64 mut i = 0; i < bt->aborts.len; i++) {
            bigger[i] = bt->aborts[i];
        }
        del(bt->aborts);
        bt->aborts = move(bigger);
    }
    bt->aborts[bt->deads.len - 1] = abort;
}

fn push_dead(dead_vec mut* v, dead_mark d) void {
    if (v->len == v->items.len) {
        dead_mark mut@ own bigger = new(dead_mark, fir.grown_capacity(v->len, "oracle_test"));
        for (u64 mut i = 0; i < v->len; i++) {
            bigger[i] = v->items[i];
        }
        del(v->items);
        v->items = move(bigger);
    }
    v->items[v->len] = d;
    v->len += 1;
}

// Records the exit site `add`, or joins it to the site at its location: the obligations of the
// owner locals of one `return` share its site.
fn add_exit(exit_vec mut* v, exit_site add) void {
    for (u64 mut i = 0; i < v->len; i++) {
        exit_site mut* t = &v->items[i];
        if (t->sym == add.sym && t->line == add.line && t->col == add.col) {
            t->rejected = t->rejected || add.rejected;
            return;
        }
    }
    if (v->len == v->items.len) {
        exit_site mut@ own bigger = new(exit_site, fir.grown_capacity(v->len, "oracle_test"));
        for (u64 mut i = 0; i < v->len; i++) {
            bigger[i] = v->items[i];
        }
        del(v->items);
        v->items = move(bigger);
    }
    v->items[v->len] = add;
    v->len += 1;
}

// Whether `f` has a parameter or a temporary of an owning aggregate type, whose slots end at each
// `return` with those of the owner locals.
fn has_owning_aggregate(fir.func* f) bool {
    for (u32 mut n = 0; n < fir.local_count(f); n++) {
        fir.local* l = fir.local_at(f, n);
        bool kind = l->kind == fir.local_kind.lk_param || l->kind == fir.local_kind.lk_temp;
        if (kind && types.type_is_owning_aggregate(l->ty)) {
            return true;
        }
    }
    return false;
}

// Records an exit site of rule (c) part 1 for each `return` of `f`, for each `dead` of a local of
// an `own` reference type outside an abort block, and for each exit of `p` (design 4.7): rejected
// when the pass does not prove an obligation of the exit. The sites come from the FIR and not only
// from `p`, so that each `leak` event in the scope of the rule has a site, also one where the pass
// lists no obligation.
fn add_exits(batch mut* bt, fir.func* f, prover.proof* p) void {
    u64 owner = item_of(bt, f->sym);
    bool unsure = has_owning_aggregate(f);
    for (u32 mut b = 0; b < fir.block_count(f); b++) {
        fir.block* bl = fir.block_at(f, b);
        fir.terminator* t = &bl->term;
        for (u64 mut k = 0; k < bl->statements.len && !fir.term_is_abort(t); k++) {
            fir.statement* st = &bl->statements.items[k];
            if (st->kind != fir.stmt_kind.st_dead) {
                continue;
            }
            types.node* ty = fir.local_at(f, st->local)->ty;
            if (types.type_is_reference(ty) && ty->is_own) {
                diag.loc shown = bt->deads.items[cast(st->loc.line - DEAD_LINE, u64)].at;
                add_exit(&bt->exits, exit_site{f->sym, st->loc.line, st->loc.col, shown, owner,
                                               false, false, false});
            }
        }
        if (t->kind == fir.term_kind.tk_return) {
            add_exit(&bt->exits, exit_site{f->sym, t->loc.line, t->loc.col, t->loc, owner, false,
                                           false, unsure});
        }
    }
    for (u64 mut k = 0; k < p->exits.len; k++) {
        prover.exit* e = &p->exits[k];
        diag.loc at = report.exit_loc(f, e);
        diag.loc mut shown = at;
        bool dead = e->index < fir.block_statement_count(f, e->block);
        if (dead) {
            shown = bt->deads.items[cast(at.line - DEAD_LINE, u64)].at;
        }
        add_exit(&bt->exits, exit_site{f->sym, at.line, at.col, shown, owner, !e->proved, false,
                                       unsure && !dead});
    }
}

// Records an exit site of part 1 of the leak rule on the owning aggregate locals (D17.20) for each
// `dead` of a local of an owning aggregate type outside an abort block, for each `return` of a
// function with a parameter or a temporary of such a type, and for each exit of p->aggregates:
// rejected when the pass does not prove an exit of such a local there, which gives the error of
// D17.20 (has_error). The `leak` event at a `return` does not tell an owning aggregate from an
// owner local, so an exit of an owner local that the pass does not prove at the `return` of such
// a site rejects it too.
fn add_aggregates(batch mut* bt, fir.func* f, prover.proof* p) void {
    u64 owner = item_of(bt, f->sym);
    bool returns = has_owning_aggregate(f);
    bool error = prover.has_error(p);
    for (u32 mut b = 0; b < fir.block_count(f); b++) {
        fir.block* bl = fir.block_at(f, b);
        fir.terminator* t = &bl->term;
        for (u64 mut k = 0; k < bl->statements.len && !fir.term_is_abort(t); k++) {
            fir.statement* st = &bl->statements.items[k];
            if (st->kind != fir.stmt_kind.st_dead) {
                continue;
            }
            if (types.type_is_owning_aggregate(fir.local_at(f, st->local)->ty)) {
                diag.loc shown = bt->deads.items[cast(st->loc.line - DEAD_LINE, u64)].at;
                add_exit(&bt->aggregates, exit_site{f->sym, st->loc.line, st->loc.col, shown,
                                                    owner, false, false, false});
            }
        }
        if (t->kind == fir.term_kind.tk_return && returns) {
            add_exit(&bt->aggregates, exit_site{f->sym, t->loc.line, t->loc.col, t->loc, owner,
                                                false, false, false});
        }
    }
    for (u64 mut k = 0; k < p->aggregates.len; k++) {
        prover.exit* e = &p->aggregates[k].at;
        diag.loc at = report.exit_loc(f, e);
        diag.loc mut shown = at;
        if (e->index < fir.block_statement_count(f, e->block)) {
            shown = bt->deads.items[cast(at.line - DEAD_LINE, u64)].at;
        }
        add_exit(&bt->aggregates, exit_site{f->sym, at.line, at.col, shown, owner,
                                            !e->proved && error, false, false});
    }
    for (u64 mut k = 0; k < p->exits.len; k++) {
        prover.exit* e = &p->exits[k];
        diag.loc at = report.exit_loc(f, e);
        bool at_return = e->index == fir.block_statement_count(f, e->block);
        for (u64 mut i = 0; i < bt->aggregates.len && at_return && !e->proved; i++) {
            exit_site mut* t = &bt->aggregates.items[i];
            if (t->sym == f->sym && t->line == at.line && t->col == at.col) {
                t->unsure = t->unsure || !t->rejected;
                t->rejected = true;
            }
        }
    }
}

// Marks the exit site of part 1 on the owning aggregate locals at the location of the `leak` event
// `ev`, when one stands there.
fn mark_aggregate(batch mut* bt, shadow.event* ev) void {
    for (u64 mut i = 0; i < bt->aggregates.len; i++) {
        exit_site mut* t = &bt->aggregates.items[i];
        if (t->sym == ev->sym && t->line == ev->at.line && t->col == ev->at.col) {
            t->event = true;
        }
    }
}

// Records the site `add` of rule (c) part 2 in `v`, or joins it to the site at its location: a
// deferred `del` expands at each exit with one location.
fn add_inner(site_vec mut* v, site add) void {
    for (u64 mut i = 0; i < v->len; i++) {
        site mut* t = &v->items[i];
        if (t->sym == add.sym && t->line == add.line && t->col == add.col) {
            t->rejected = t->rejected || add.rejected;
            return;
        }
    }
    if (v->len == v->items.len) {
        site mut@ own bigger = new(site, fir.grown_capacity(v->len, "oracle_test"));
        for (u64 mut i = 0; i < v->len; i++) {
            bigger[i] = v->items[i];
        }
        del(v->items);
        v->items = move(bigger);
    }
    v->items[v->len] = add;
    v->len += 1;
}

// Whether the statement `s` of `f` is a site of rule (c) part 2 (D17.20): with `cast_site` false,
// a `del` of a place of type `T* own` where `T` holds owners; with `cast_site`, a `cast` whose
// operand moves such a place out. The test reads the operand and not the target type that the
// pass reads: the owner leaves the place at each `cast` that moves it, and the checker gives a
// `cast` to a type that does not own a `copy` operand. So a `cast` to a pointer to `T` is a site
// too, which the pass does not reject; a leak of its object stands at the `del` of the new
// pointer, a site of its own.
fn is_inner_site(fir.func* f, fir.statement* s, bool cast_site) bool {
    types.node* mut from = null;
    if (!cast_site && s->kind == fir.stmt_kind.st_del) {
        from = fir.place_type(f, s->place);
    } else if (cast_site && s->kind == fir.stmt_kind.st_assign
               && s->value.kind == fir.rvalue_kind.rv_cast) {
        fir.operand o = fir.rvalue_operand(f, s->value, 0);
        if (o.kind != fir.operand_kind.ok_move) {
            return false;
        }
        from = fir.place_type(f, o.place);
    } else {
        return false;
    }
    return from->kind == types.type_kind.k_ptr && from->is_own
        && judgement.holds_owners(from->elem);
}

// Records a site of rule (c) part 2 for each `del` and each `cast` of `f` that is_inner_site
// names, and for each obligation of part 2 of `p`: rejected when the pass does not prove it. The
// sites come from the FIR and not only from `p`, as the exit sites do.
fn add_inners(batch mut* bt, fir.func* f, prover.proof* p) void {
    u64 owner = item_of(bt, f->sym);
    for (u32 mut b = 0; b < fir.block_count(f); b++) {
        fir.block* bl = fir.block_at(f, b);
        for (u64 mut k = 0; k < bl->statements.len; k++) {
            fir.statement* st = &bl->statements.items[k];
            site add = site{f->sym, st->loc.line, st->loc.col, owner, false, false};
            if (is_inner_site(f, st, false)) {
                add_inner(&bt->inners, add);
            } else if (is_inner_site(f, st, true)) {
                add_inner(&bt->casts, add);
            }
        }
    }
    for (u64 mut k = 0; k < p->inners.len; k++) {
        prover.inner* e = &p->inners[k];
        fir.statement* st = fir.block_statement(f, e->block, e->index);
        site add = site{f->sym, st->loc.line, st->loc.col, owner, !e->proved, false};
        if (st->kind == fir.stmt_kind.st_del) {
            add_inner(&bt->inners, add);
        } else {
            add_inner(&bt->casts, add);
        }
    }
}

// Records a site of rule (b) for each use of `p`, rejected when the pass does not prove it and so
// gives the error of D17.21 (has_error), or joins it to the site of its function, location and
// local: a deferred statement expands at each exit with one location.
fn add_uses(batch mut* bt, fir.func* f, prover.proof* p) void {
    u64 owner = item_of(bt, f->sym);
    bool error = prover.has_error(p);
    for (u64 mut k = 0; k < p->uses.len; k++) {
        prover.use* u = &p->uses[k];
        diag.loc at = report.item_loc(f, u->block, u->index);
        bool rejected = !u->proved && error;
        add_use(&bt->uses, use_site{f->sym, at.line, at.col, u->local, owner, rejected, false});
    }
}

fn add_use(use_vec mut* v, use_site add) void {
    for (u64 mut i = 0; i < v->len; i++) {
        use_site mut* t = &v->items[i];
        if (t->sym == add.sym && t->line == add.line && t->col == add.col
            && t->local == add.local) {
            t->rejected = t->rejected || add.rejected;
            return;
        }
    }
    if (v->len == v->items.len) {
        use_site mut@ own bigger = new(use_site, fir.grown_capacity(v->len, "oracle_test"));
        for (u64 mut i = 0; i < v->len; i++) {
            bigger[i] = v->items[i];
        }
        del(v->items);
        v->items = move(bigger);
    }
    v->items[v->len] = add;
    v->len += 1;
}

// Marks each site of rule (b) of the function and the local of the `use after move` event `ev`,
// when rule (b) answers for it: its moved tag names a local of a function, and no other frame read
// the slot. An event of a slot of no local, or that a callee read, marks no site, and the gate
// judges it as it judges each event (judge_event). An event with no rejected site of its function
// and local is a false accept.
fn collect_use(batch mut* bt, shadow.event* ev, counts mut* n) void {
    shadow.origin* g = &ev->t.f;
    if (g->kind != shadow.tag_kind.tg_moved || g->sym == null || g->flag) {
        return;
    }
    bool mut rejected = false;
    for (u64 mut i = 0; i < bt->uses.len; i++) {
        use_site mut* t = &bt->uses.items[i];
        if (t->sym == g->sym && t->local == g->local) {
            t->event = true;
            rejected = rejected || t->rejected;
        }
    }
    if (!rejected) {
        n->uses[LEAK_FALSE_ACCEPTS] += 1;
        println("use false accept in ", g->sym->name, " of _", g->local, " at ", ev->at.line,
                ":", ev->at.col);
    }
}

// The `del` of `f` at `at`, or null.
fn find_del(fir.func* f, diag.loc at) fir.statement* {
    for (u32 mut b = 0; f != null && b < fir.block_count(f); b++) {
        fir.block* bl = fir.block_at(f, b);
        for (u64 mut k = 0; k < bl->statements.len; k++) {
            fir.statement* s = &bl->statements.items[k];
            if (s->kind == fir.stmt_kind.st_del && s->loc.line == at.line
                && s->loc.col == at.col) {
                return s;
            }
        }
    }
    return null;
}

// Marks the `cast` sites of the function `of` with an event, or each `cast` site of `bt` when
// that function has none, and gives whether it marked one.
fn mark_casts(batch mut* bt, ast.sym* of) bool {
    bool mut marked = false;
    for (u64 mut i = 0; i < bt->casts.len; i++) {
        if (bt->casts.items[i].sym == of) {
            bt->casts.items[i].event = true;
            marked = true;
        }
    }
    if (marked) {
        return true;
    }
    for (u64 mut i = 0; i < bt->casts.len; i++) {
        bt->casts.items[i].event = true;
    }
    return bt->casts.len > 0;
}

// Marks the site of rule (c) part 2 of the `leak` event `ev` when it stands at a `del`. The run
// reports a `leak` at a `del` when the object that it frees holds an owner slot of a live
// allocation (fir.shadow), so the event marks the site of that `del`. A `del` of a span is no site
// of part 2: the compiler gives its item a line of `--span-del-report` (D17.9), and the gate holds
// that. A `del` of a pointer whose object holds no owner by its type can leak only after a `cast`
// that carried `own` from a pointer to an object with owners, so the event marks the `cast` sites
// of its function, or of the batch when its function has none. With no `cast` site the event is a
// false accept.
fn mark_inner(batch mut* bt, shadow.event* ev, counts mut* n) void {
    fir.func* f = find_func(&bt->m, ev->sym);
    fir.statement* d = find_del(f, ev->at);
    if (d == null) {
        return;
    }
    for (u64 mut i = 0; i < bt->inners.len; i++) {
        site mut* t = &bt->inners.items[i];
        if (t->sym == ev->sym && t->line == ev->at.line && t->col == ev->at.col) {
            t->event = true;
            return;
        }
    }
    types.node* t = fir.place_type(f, d->place);
    if (t->kind != types.type_kind.k_span && !mark_casts(bt, ev->sym)) {
        n->inner[LEAK_FALSE_ACCEPTS] += 1;
        println("part 2: leak at a del that no site explains in ", ev->sym->name, " at ",
                ev->at.line, ":", ev->at.col);
    }
}

// The function of `m` whose symbol is `s`, or null.
fn find_func(fir.module* m, ast.sym* s) fir.func* {
    for (u64 mut i = 0; i < m->funcs.len; i++) {
        if (m->funcs.items[i].sym == s) {
            return &m->funcs.items[i];
        }
    }
    return null;
}

// Whether `f` stores into a place of an `own` reference type at `at`: the scope of rule (a).
fn is_own_store(fir.func* f, diag.loc at) bool {
    for (u32 mut b = 0; b < fir.block_count(f); b++) {
        fir.block* bl = fir.block_at(f, b);
        for (u64 mut k = 0; k < bl->statements.len; k++) {
            fir.statement* s = &bl->statements.items[k];
            if (s->kind == fir.stmt_kind.st_assign && s->loc.line == at.line
                && s->loc.col == at.col) {
                types.node* t = fir.place_type(f, s->place);
                if (types.type_is_reference(t) && t->is_own) {
                    return true;
                }
            }
        }
    }
    return false;
}

// ---- runs --------------------------------------------------------------------------------------

// Marks the exit site of the `leak` event `ev`, or the site of rule (c) part 2 of an event at a
// `del` (mark_inner). The event also marks the exit site of the owning aggregate locals at its
// location (mark_aggregate). An event at a `return` of a function with a parameter or a temporary
// of an owning aggregate type marks only that site: it does not say which owner leaked. An event
// at an item with no site marks none, and the gate judges it as it judges each event.
fn collect_leak(batch mut* bt, shadow.event* ev, counts mut* n) void {
    mark_aggregate(bt, ev);
    for (u64 mut i = 0; i < bt->exits.len; i++) {
        exit_site mut* t = &bt->exits.items[i];
        if (t->sym == ev->sym && t->line == ev->at.line && t->col == ev->at.col) {
            t->event = t->event || !t->unsure;
            return;
        }
    }
    mark_inner(bt, ev, n);
}

// Judges the event `ev` of a run of the item `of` of `bt`, and counts it by its kind. An error of
// the pass refuses the program, so an event of an item with such an error gets no ruling
// (`rejected`). Each other event gets the ruling of the one judgement (judgement.ruling_of), which
// reads the disposition table, the cycle mark of the event, the `dead` marker of an abort block
// and the report lines that name the line of the event. The event is no error, an error that a
// report line of its own rule takes, or an error, which fails the item. The item keeps its first
// error. It gives whether the event is an error.
fn judge_event(batch* bt, item mut* of, shadow.event* ev, counts mut* n) bool {
    u64 kind = disposition.index_of(ev->kind);
    if (of->error) {
        n->rejected_events[kind] += 1;
        return false;
    }
    judgement.ruling said = judgement.ruling_of(ev, bt->aborts[..bt->deads.len],
                                                bt->named.items[..bt->named.len]);
    if (said == judgement.ruling.ru_excused || said == judgement.ruling.ru_cycle) {
        n->no_error[kind] += 1;
    } else if (said != judgement.ruling.ru_error) {
        n->excused[kind] += 1;
    } else {
        n->unexcused[kind] += 1;
        if (judgement.is_trusted(ev->kind) && !is_refused(of)) {
            n->trusted[kind] += 1;
        }
        if (of->errors == 0) {
            of->failure = *ev;
        }
        of->errors += 1;
    }
    return said == judgement.ruling.ru_error;
}

// Judges the end `end` of a run of the item `of` with `errors` error events, when the item has no
// error of the pass. A fault that judgement.is_silent reads fails the item, as in the typed family:
// a fault other than `null dereference` with no error event. The item keeps the first such end.
fn judge_end(item mut* of, interpreter.outcome* end, u64 errors) void {
    u64 row = judgement.end_of(end->kind, end->what);
    if (of->error || !judgement.is_silent(row, errors) || of->silent) {
        return;
    }
    of->silent = true;
    of->fault = row;
    of->fault_at = end->at;
}

// Counts the run of `it`, a run of the item `k` of `bt`, and its events. The gate judges each
// event (judge_event). Then the event marks the site of the rule that answers for it, when one
// stands there: an `overwrite` event at a store into a place of an `own` reference type marks its
// site of rule (a), a `leak` event its exit site (collect_leak), and a `use after move` event the
// sites of rule (b) (collect_use). A `forged` event keeps its location in `bt->forged`, because
// the run reports no event after it. Then the gate judges the end of the run (judge_end).
fn collect(batch mut* bt, interpreter.machine* it, u64 k, counts mut* n) void {
    n->runs += 1;
    if (it->end.kind == interpreter.outcome_kind.oc_none) {
        panic("oracle_test.collect: a run did not end");
    }
    n->ends[cast(cast(it->end.kind, i32), u64)] += 1;
    u64 mut errors = 0;
    for (u64 mut e = 0; e < it->sh.events.len; e++) {
        shadow.event* ev = &it->sh.events.items[e];
        if (judge_event(bt, &bt->items[k], ev, n)) {
            errors += 1;
        }
        fir.func* f = find_func(&bt->m, ev->sym);
        if (ev->kind == shadow.event_kind.ev_leak) {
            collect_leak(bt, ev, n);
        }
        if (ev->kind == shadow.event_kind.ev_forged) {
            add_site(&bt->forged, site{ev->sym, ev->at.line, ev->at.col, NONE, false, true},
                     site_kind.sk_event);
        }
        if (ev->kind == shadow.event_kind.ev_use_after_move) {
            collect_use(bt, ev, n);
        }
        if (ev->kind == shadow.event_kind.ev_overwrite && f != null && is_own_store(f, ev->at)) {
            add_site(&bt->sites, site{ev->sym, ev->at.line, ev->at.col, item_of(bt, ev->sym),
                                      false, true}, site_kind.sk_event);
        }
    }
    judge_end(&bt->items[k], &it->end, errors);
}

// Whether the site at `line`:`col` of the function `fn_sym` stands after a `forged` event of
// `fn_sym`, at its location or later in the text. The run reports no event after `forged`, so a
// reject with no event there is no false reject. A site of another function, or before the
// event, keeps its count.
fn is_after_forged(batch* bt, ast.sym* fn_sym, u32 line, u32 col) bool {
    for (u64 mut i = 0; i < bt->forged.len; i++) {
        site* f = &bt->forged.items[i];
        if (f->sym == fn_sym && (line > f->line || (line == f->line && col >= f->col))) {
            return true;
        }
    }
    return false;
}

// The symbol of the function `prefix` and `index` of the entry module.
fn symbol(check_env.env* c, string prefix, u64 index) ast.sym* {
    strbuf.str_buf mut b = strbuf.create();
    defer del(b.data);
    strbuf.append(&b, prefix);
    strbuf.append_u64(&b, index);
    ast.sym* s = check_env.sym_main(c, strbuf.view(&b));
    if (s == null) {
        panic("oracle_test.symbol: no such function");
    }
    return s;
}

// Runs the program of the item `k` of `bt`, whose `main` is `s`.
fn run_program(check_env.env mut* c, batch mut* bt, ast.sym* s, u64 k, counts mut* n) void {
    interpreter.machine mut* own it = interpreter.make(&c->ck, &bt->m, true);
    defer interpreter.drop_made(move(it));
    string[1] argv = {"oracle"};
    interpreter.run_program(it, s, argv[..]);
    collect(bt, it, k, n);
}

// Runs the shape or the FIR case `s` of the item `k` of `bt`, which takes no argument.
fn run_shape(check_env.env mut* c, batch mut* bt, ast.sym* s, u64 k, counts mut* n) void {
    interpreter.machine mut* own it = interpreter.make(&c->ck, &bt->m, true);
    defer interpreter.drop_made(move(it));
    u64[1] none = {0};
    interpreter.run_function(it, s, none[..0]);
    collect(bt, it, k, n);
}

// Runs each item of `bt` that stays.
fn run_batch(check_env.env mut* c, batch mut* bt, counts mut* n) void {
    for (u64 mut k = 0; k < bt->items.len; k++) {
        item* it = &bt->items[k];
        if (it->dropped) {
            n->dropped += 1;
            continue;
        }
        n->items += 1;
        if (bt->kind == family.fm_fir) {
            run_shape(c, bt, bt->m.funcs.items[k].sym, k, n);
        } else if (bt->kind == family.fm_hand) {
            run_program(c, bt, symbol(c, "main_", 0), k, n);
        } else if (bt->kind == family.fm_seeded) {
            run_program(c, bt, symbol(c, "main_", it->index), k, n);
        } else {
            run_shape(c, bt, symbol(c, generator.SHAPE_PREFIX, it->index), k, n);
        }
    }
}

// ---- reports -----------------------------------------------------------------------------------

// Prints lines `first` to `last` of `text`.
fn print_lines(string text, u32 first, u32 last) void {
    u32 mut line = 1;
    u64 mut start = 0;
    for (u64 mut i = 0; i < text.len; i++) {
        if (text[i] != '\n') {
            continue;
        }
        if (line >= first && line <= last) {
            println("    ", text[start..i]);
        }
        line += 1;
        start = i + 1;
    }
}

// Prints `what` of the site `s` after the name of the set, or after `fir` and the name of the
// function of a FIR case.
fn print_site(batch* bt, string name, site* s, string what) void {
    if (bt->kind == family.fm_fir) {
        println("fir ", s->sym->name, ": ", what, " at ", s->line, ":", s->col);
    } else {
        println(name, ": ", what, " at ", s->line, ":", s->col);
    }
}

// Counts into `n` the items of `bt` that the compiler accepts, and the items that fail the gate,
// by the kind of their first error event that no report line takes. An item with a report line
// fails too when a run gives an error event of another rule or on another line. It prints two
// lines for each item that fails: that event at the location that the source gives it, then the
// count of such events and whether the compiler accepts the item.
fn judge_items(batch* bt, string name, counts mut* n) void {
    for (u64 mut k = 0; k < bt->items.len; k++) {
        item* it = &bt->items[k];
        if (it->dropped) {
            continue;
        }
        string mut state = "refused by a report line";
        if (!is_refused(it)) {
            n->accepted += 1;
            state = "accepted";
        }
        if (it->errors == 0 && !it->silent) {
            continue;
        }
        n->failing += 1;
        if (is_refused(it)) {
            n->failing_refused += 1;
        }
        if (it->errors == 0) {
            n->failing_class[judgement.NO_CLASS] += 1;
            println(name, ": item ", it->index, " fails the gate: ",
                    judgement.END_TEXT[it->fault], " with no error event at ", it->fault_at.line,
                    ":", it->fault_at.col);
            println(name, ": item ", it->index, ": error events 0, ", state);
            continue;
        }
        u64 kind = disposition.index_of(it->failure.kind);
        n->failing_by[kind] += 1;
        judgement.count_failure(n->failing_class[..], &it->failure);
        diag.loc mut at = it->failure.at;
        if (at.line >= DEAD_LINE) {
            at = bt->deads.items[cast(at.line - DEAD_LINE, u64)].at;
        }
        println(name, ": item ", it->index, " fails the gate: ", shadow.EVENT_TEXT[kind], " in ",
                it->failure.sym->name, " at ", at.line, ":", at.col);
        println(name, ": item ", it->index, ": error events ", it->errors, ", ", state);
    }
}

// Counts the sites of `bt` into `n`, and prints each false accept with its item. With `listed`, it
// also prints each rejected site of an item, with an event or as a false reject.
fn judge(batch* bt, string name, bool listed, counts mut* n) void {
    for (u64 mut i = 0; i < bt->sites.len; i++) {
        site* s = &bt->sites.items[i];
        if (s->event && !s->rejected) {
            n->false_accepts += 1;
            println(name, ": false accept in ", s->sym->name, " at ", s->line, ":", s->col);
            if (s->item != NONE) {
                print_lines(strbuf.view(&bt->text), bt->items[s->item].first,
                            bt->items[s->item].last);
            }
        }
        if (s->item == NONE) {
            continue;
        }
        n->sites += 1;
        if (s->rejected) {
            n->rejected += 1;
        }
        if (s->event) {
            n->events += 1;
        }
        if (s->rejected && !s->event && is_after_forged(bt, s->sym, s->line, s->col)) {
            n->after_forged += 1;
        } else if (s->rejected && !s->event) {
            n->false_rejects += 1;
        }
        if (listed && s->rejected && s->event) {
            print_site(bt, name, s, "reject with an event");
        } else if (listed && s->rejected && is_after_forged(bt, s->sym, s->line, s->col)) {
            print_site(bt, name, s, "reject after forged");
        } else if (listed && s->rejected) {
            print_site(bt, name, s, "false reject");
        }
    }
}

// Counts the exit sites of `bt` into `n` as judge counts the sites of rule (a), and prints each
// false accept of rule (c) part 1 with its item. With `listed`, it also prints each rejected exit
// site of an item, with an event or as a false reject.
fn judge_exits(batch* bt, string name, bool listed, counts mut* n) void {
    for (u64 mut i = 0; i < bt->exits.len; i++) {
        exit_site* s = &bt->exits.items[i];
        if (s->event && !s->rejected) {
            n->leak[LEAK_FALSE_ACCEPTS] += 1;
            println(name, ": leak false accept in ", s->sym->name, " at ", s->at.line, ":",
                    s->at.col);
            if (s->item != NONE) {
                print_lines(strbuf.view(&bt->text), bt->items[s->item].first,
                            bt->items[s->item].last);
            }
        }
        if (s->item == NONE) {
            continue;
        }
        n->leak[LEAK_SITES] += 1;
        if (s->rejected) {
            n->leak[LEAK_REJECTED] += 1;
        }
        if (s->event) {
            n->leak[LEAK_EVENTS] += 1;
        }
        if (s->rejected && !s->event && is_after_forged(bt, s->sym, s->at.line, s->at.col)) {
            n->after_forged += 1;
        } else if (s->rejected && !s->event) {
            n->leak[LEAK_FALSE_REJECTS] += 1;
        }
        diag.loc at = s->at;
        site shown = site{s->sym, at.line, at.col, s->item, s->rejected, s->event};
        if (listed && s->rejected && s->event) {
            print_site(bt, name, &shown, "leak reject with an event");
        } else if (listed && s->rejected && is_after_forged(bt, s->sym, at.line, at.col)) {
            print_site(bt, name, &shown, "leak reject after forged");
        } else if (listed && s->rejected) {
            print_site(bt, name, &shown, "leak false reject");
        }
    }
}

// Counts the exit sites of the owning aggregate locals of `bt` into `n` as judge_exits counts the
// exit sites of part 1, and prints each false accept with its item. With `listed`, it also prints
// each rejected site of an item, with an event or as a false reject.
fn judge_aggregates(batch* bt, string name, bool listed, counts mut* n) void {
    for (u64 mut i = 0; i < bt->aggregates.len; i++) {
        exit_site* s = &bt->aggregates.items[i];
        if (s->event && !s->rejected) {
            n->aggregate[LEAK_FALSE_ACCEPTS] += 1;
            println(name, ": aggregate false accept in ", s->sym->name, " at ", s->at.line, ":",
                    s->at.col);
            if (s->item != NONE) {
                print_lines(strbuf.view(&bt->text), bt->items[s->item].first,
                            bt->items[s->item].last);
            }
        }
        if (s->item == NONE) {
            continue;
        }
        n->aggregate[LEAK_SITES] += 1;
        if (s->rejected) {
            n->aggregate[LEAK_REJECTED] += 1;
        }
        if (s->unsure) {
            n->masked += 1;
        }
        if (s->unsure && s->event) {
            n->masked_events += 1;
        }
        if (s->event) {
            n->aggregate[LEAK_EVENTS] += 1;
        }
        bool after = is_after_forged(bt, s->sym, s->at.line, s->at.col);
        if (s->rejected && !s->event && after) {
            n->after_forged += 1;
        } else if (s->rejected && !s->event) {
            n->aggregate[LEAK_FALSE_REJECTS] += 1;
        }
        site shown = site{s->sym, s->at.line, s->at.col, s->item, s->rejected, s->event};
        if (listed && s->rejected && s->event) {
            print_site(bt, name, &shown, "aggregate reject with an event");
        } else if (listed && s->rejected && after) {
            print_site(bt, name, &shown, "aggregate reject after forged");
        } else if (listed && s->rejected) {
            print_site(bt, name, &shown, "aggregate false reject");
        }
    }
}

// Counts the sites of rule (c) part 2 of `v` into `n` as judge_exits counts the exit sites, and
// prints each false accept with its item. With `listed`, it also prints each rejected site of an
// item, with an event or as a false reject.
fn judge_inner_sites(batch* bt, site_vec* v, string name, bool listed, counts mut* n) void {
    for (u64 mut i = 0; i < v->len; i++) {
        site* s = &v->items[i];
        if (s->event && !s->rejected) {
            n->inner[LEAK_FALSE_ACCEPTS] += 1;
            println(name, ": part 2 false accept in ", s->sym->name, " at ", s->line, ":", s->col);
            if (s->item != NONE) {
                print_lines(strbuf.view(&bt->text), bt->items[s->item].first,
                            bt->items[s->item].last);
            }
        }
        if (s->item == NONE) {
            continue;
        }
        n->inner[LEAK_SITES] += 1;
        if (s->rejected) {
            n->inner[LEAK_REJECTED] += 1;
        }
        if (s->event) {
            n->inner[LEAK_EVENTS] += 1;
        }
        if (s->rejected && !s->event && is_after_forged(bt, s->sym, s->line, s->col)) {
            n->after_forged += 1;
        } else if (s->rejected && !s->event) {
            n->inner[LEAK_FALSE_REJECTS] += 1;
        }
        if (listed && s->rejected && s->event) {
            print_site(bt, name, s, "part 2 reject with an event");
        } else if (listed && s->rejected && is_after_forged(bt, s->sym, s->line, s->col)) {
            print_site(bt, name, s, "part 2 reject after forged");
        } else if (listed && s->rejected) {
            print_site(bt, name, s, "part 2 false reject");
        }
    }
}

// Counts the sites of rule (c) part 2 of `bt` into `n`: the sites at a `del`, then at a `cast`.
fn judge_inners(batch* bt, string name, bool listed, counts mut* n) void {
    judge_inner_sites(bt, &bt->inners, name, listed, n);
    judge_inner_sites(bt, &bt->casts, name, listed, n);
}

// Counts the sites of rule (b) of `bt` into `n` as judge_exits counts the exit sites, a rejected
// site after a `forged` event apart (is_after_forged). With `listed`, it also prints each rejected
// site of an item: with an event, after a `forged` event, or as a false reject. The false accepts
// of rule (b) are events, which collect_use counts.
fn judge_uses(batch* bt, string name, bool listed, counts mut* n) void {
    for (u64 mut i = 0; i < bt->uses.len; i++) {
        use_site* s = &bt->uses.items[i];
        if (s->item == NONE) {
            continue;
        }
        n->uses[LEAK_SITES] += 1;
        if (s->rejected) {
            n->uses[LEAK_REJECTED] += 1;
        }
        if (s->event) {
            n->uses[LEAK_EVENTS] += 1;
        }
        bool forged = is_after_forged(bt, s->sym, s->line, s->col);
        if (s->rejected && !s->event && forged) {
            n->after_forged += 1;
        } else if (s->rejected && !s->event) {
            n->uses[LEAK_FALSE_REJECTS] += 1;
        }
        site shown = site{s->sym, s->line, s->col, s->item, s->rejected, s->event};
        if (listed && s->rejected && s->event) {
            print_site(bt, name, &shown, "use reject with an event");
        } else if (listed && s->rejected && forged) {
            print_site(bt, name, &shown, "use reject after forged");
        } else if (listed && s->rejected) {
            print_site(bt, name, &shown, "use false reject");
        }
    }
}

// Adds the counts of `from` to `to`.
fn add_counts(counts mut* to, counts* from) void {
    to->items += from->items;
    to->dropped += from->dropped;
    to->runs += from->runs;
    for (u64 mut k = 0; k < 7; k++) {
        to->ends[k] += from->ends[k];
    }
    to->accepted += from->accepted;
    to->failing += from->failing;
    to->failing_refused += from->failing_refused;
    for (u64 mut k = 0; k <= judgement.CLASS_COUNT; k++) {
        to->failing_class[k] += from->failing_class[k];
    }
    for (u64 mut k = 0; k < disposition.KINDS; k++) {
        to->failing_by[k] += from->failing_by[k];
        to->excused[k] += from->excused[k];
        to->unexcused[k] += from->unexcused[k];
        to->trusted[k] += from->trusted[k];
        to->no_error[k] += from->no_error[k];
        to->rejected_events[k] += from->rejected_events[k];
    }
    to->sites += from->sites;
    to->rejected += from->rejected;
    to->events += from->events;
    to->false_accepts += from->false_accepts;
    to->false_rejects += from->false_rejects;
    for (u64 mut k = 0; k < 5; k++) {
        to->leak[k] += from->leak[k];
    }
    for (u64 mut k = 0; k < 5; k++) {
        to->inner[k] += from->inner[k];
    }
    to->after_forged += from->after_forged;
    for (u64 mut k = 0; k < 5; k++) {
        to->uses[k] += from->uses[k];
    }
    for (u64 mut k = 0; k < 5; k++) {
        to->aggregate[k] += from->aggregate[k];
    }
    to->masked += from->masked;
    to->masked_events += from->masked_events;
}

// Prints the counts of the set `name`: its items, the items that left it, its runs and the way
// that they end. Then the gate: the items that the compiler accepts, those that it refuses, those
// that fail and those of them with a report line. For each event kind it prints its disposition
// and its events: those of an item with an error (`rejected`), the errors that a report line
// takes (`excused`), the errors that no line takes (`failing`) and those that are no error.
// Then the sites of rule (a), those that it rejects and those with an event, its false accepts
// and false rejects, and the rejected sites of each rule after a `forged` event. Then the same
// counts of the exit sites of rule (c) part 1, of the sites of part 2, of the sites of rule (b)
// and of the exit sites of the owning aggregate locals.
fn print_counts(string name, counts* n) void {
    println(name, ": items ", n->items, ", dropped ", n->dropped, ", runs ", n->runs);
    println(name, " ends: return ", n->ends[1], ", exit ", n->ends[2], ", abort ", n->ends[3],
            ", trap ", n->ends[4], ", outside ", n->ends[5], ", fault ", n->ends[6]);
    println(name, " gate: accepted ", n->accepted, ", refused ", n->items - n->accepted,
            ", failing ", n->failing, ", of them refused ", n->failing_refused);
    for (u64 mut k = 0; k < disposition.KINDS; k++) {
        u64 d = cast(cast(disposition.TABLE[k].disposition, i32), u64);
        println(name, " gate ", shadow.EVENT_TEXT[k], ": ", disposition.DISPOSITION_TEXT[d],
                ", rejected ", n->rejected_events[k], ", excused ", n->excused[k], ", failing ",
                n->unexcused[k], ", no error ", n->no_error[k]);
    }
    println(name, ": sites ", n->sites, ", rejected ", n->rejected, ", with an event ",
            n->events, ", false accepts ", n->false_accepts, ", false rejects ",
            n->false_rejects);
    println(name, ": rejected sites after a forged event ", n->after_forged);
    println(name, " leak: sites ", n->leak[LEAK_SITES], ", rejected ", n->leak[LEAK_REJECTED],
            ", with an event ", n->leak[LEAK_EVENTS]);
    println(name, " leak: false accepts ", n->leak[LEAK_FALSE_ACCEPTS], ", false rejects ",
            n->leak[LEAK_FALSE_REJECTS]);
    println(name, " part 2: sites ", n->inner[LEAK_SITES], ", rejected ", n->inner[LEAK_REJECTED],
            ", with an event ", n->inner[LEAK_EVENTS]);
    println(name, " part 2: false accepts ", n->inner[LEAK_FALSE_ACCEPTS], ", false rejects ",
            n->inner[LEAK_FALSE_REJECTS]);
    println(name, " use: sites ", n->uses[LEAK_SITES], ", rejected ", n->uses[LEAK_REJECTED],
            ", with an event ", n->uses[LEAK_EVENTS]);
    println(name, " use: false accepts ", n->uses[LEAK_FALSE_ACCEPTS], ", false rejects ",
            n->uses[LEAK_FALSE_REJECTS]);
    println(name, " aggregate: sites ", n->aggregate[LEAK_SITES], ", rejected ",
            n->aggregate[LEAK_REJECTED], ", with an event ", n->aggregate[LEAK_EVENTS]);
    println(name, " aggregate: false accepts ", n->aggregate[LEAK_FALSE_ACCEPTS],
            ", false rejects ", n->aggregate[LEAK_FALSE_REJECTS], ", masked ", n->masked,
            ", masked with an event ", n->masked_events);
}

// One row of FLOORS: the sets of the family `of` hold `accepted` items at least that the compiler
// accepts with no error and no report line.
struct floor {
    family of;
    u64 accepted;
}

// The count of the rows of FLOORS.
u64 FLOOR_ROWS = 3;

// The least count of accepted items of each family, which is its measured count. The gate judges
// an accepted item by each event of its runs, so a family with fewer accepted items judges less.
// The test stops when a family accepts fewer items than its row says (hold_floor). A change
// that makes the compiler refuse an item lowers the row in the same change.
floor[FLOOR_ROWS] FLOORS = {
    floor{family.fm_hand, 46},
    floor{family.fm_seeded, 462},
    floor{family.fm_shapes, 140},
};

// Holds the accepted items of the set `name` of the family `of` against FLOORS. A family with no
// row, or with fewer accepted items than its row says, stops the test.
fn hold_floor(family of, string name, counts* n) void {
    u64 mut least = NONE;
    for (u64 mut r = 0; r < FLOORS.len; r++) {
        if (FLOORS[r].of == of) {
            least = FLOORS[r].accepted;
        }
    }
    if (least == NONE) {
        panic("oracle_test: a family has no row in FLOORS");
    }
    println(name, " gate: accepted items ", n->accepted, ", floor ", least);
    if (n->accepted < least) {
        panic("oracle_test: a family accepts fewer items than its floor");
    }
}

// Holds the failing items of the set `name` against the rows of the unit `unit` of judgement.KNOWN,
// the one list of the known failures of each family. An item has the class of its first error
// event (judgement.class_of_event), and an item that fails with no error event has no class
// (judge_end). A count that differs from its row stops the test (judgement.hold_known): an item
// with no row is a new failure, and an item that passes leaves the list in the same change.
fn hold_known(u64 unit, string name, counts* n) void {
    strbuf.str_buf mut b = strbuf.create();
    defer del(b.data);
    strbuf.append(&b, name);
    strbuf.append(&b, " gate");
    judgement.hold_known(strbuf.view(&b), unit, n->failing_class[..]);
}

// ---- the sets ----------------------------------------------------------------------------------

// Runs one batch of `kind` over the items `first` to `first + count - 1` of the family, or over the
// hand case `lines`, and adds its counts to `total`.
fn run_set(check_env.env mut* c, family kind, string@ lines, u64 first, u64 count, string name,
           counts mut* total) void {
    batch mut* own bt = batch_make(kind, lines, count);
    defer batch_drop_made(move(bt));
    for (u64 mut k = 0; k < count; k++) {
        bt->items[k].index = first + k;
    }
    prepare(c, bt);
    relocate(bt);
    prove_batch(c, bt);
    refuse_callers(bt);
    counts mut n = counts{};
    run_batch(c, bt, &n);
    bool listed = kind == family.fm_hand || kind == family.fm_fir;
    judge_items(bt, name, &n);
    if (listed) {
        println(name, ": gate: accepted ", n.accepted, " of ", n.items, ", failing ", n.failing);
    }
    judge(bt, name, listed, &n);
    if (listed) {
        println(name, ": sites ", n.sites, ", rejected ", n.rejected, ", with an event ",
                n.events, ", false rejects ", n.false_rejects);
    }
    judge_exits(bt, name, listed, &n);
    if (listed) {
        println(name, ": leak sites ", n.leak[LEAK_SITES], ", rejected ", n.leak[LEAK_REJECTED],
                ", with an event ", n.leak[LEAK_EVENTS], ", false rejects ",
                n.leak[LEAK_FALSE_REJECTS]);
    }
    judge_inners(bt, name, listed, &n);
    // a set prints the line of part 2 only when it holds a site of part 2
    if (listed && n.inner[LEAK_SITES] > 0) {
        println(name, ": part 2 sites ", n.inner[LEAK_SITES], ", rejected ",
                n.inner[LEAK_REJECTED], ", with an event ", n.inner[LEAK_EVENTS],
                ", false rejects ", n.inner[LEAK_FALSE_REJECTS]);
    }
    judge_aggregates(bt, name, listed, &n);
    // a set prints the line of the owning aggregate locals only when it holds such a site
    if (listed && n.aggregate[LEAK_SITES] > 0) {
        println(name, ": aggregate sites ", n.aggregate[LEAK_SITES], ", rejected ",
                n.aggregate[LEAK_REJECTED], ", with an event ", n.aggregate[LEAK_EVENTS],
                ", false rejects ", n.aggregate[LEAK_FALSE_REJECTS]);
    }
    judge_uses(bt, name, listed, &n);
    // a set prints the line of rule (b) only when it holds a site of rule (b)
    if (listed && n.uses[LEAK_SITES] > 0) {
        println(name, ": use sites ", n.uses[LEAK_SITES], ", rejected ", n.uses[LEAK_REJECTED],
                ", with an event ", n.uses[LEAK_EVENTS], ", false rejects ",
                n.uses[LEAK_FALSE_REJECTS]);
    }
    add_counts(total, &n);
}

// The lines of case `k` of `all`: from its line of places to the line before the next one.
fn case_lines(string@ all, u64 k) string@ {
    u64 mut first = 0;
    u64 mut seen = 0;
    for (u64 mut i = 0; i < all.len; i++) {
        if (!str.starts_with(all[i], "// places:")) {
            continue;
        }
        if (seen == k + 1) {
            return all[first..i];
        }
        if (seen == k) {
            first = i;
        }
        seen += 1;
    }
    if (seen != k + 1) {
        panic("oracle_test.case_lines: no such case");
    }
    return all[first..];
}

// Runs each case of `all`, whose names are `names`, as a batch of the hand set.
fn run_cases(check_env.env mut* c, string@ all, string@ names, string prefix, counts mut* total)
    void {
    for (u64 mut k = 0; k < names.len; k++) {
        strbuf.str_buf mut name = strbuf.create();
        defer del(name.data);
        strbuf.append(&name, prefix);
        strbuf.append(&name, names[k]);
        run_set(c, family.fm_hand, case_lines(all, k), 0, 1, strbuf.view(&name), total);
    }
}

// The case of GATE_NAMES with the name `name`.
fn gate_case(string name) u64 {
    for (u64 mut k = 0; k < GATE_NAMES.len; k++) {
        if (GATE_NAMES[k] == name) {
            return k;
        }
    }
    panic("oracle_test.gate_case: no such case of the gate");
}

// Gives `bt` a report line of the option `bit` that names the line `line` of its text for each
// function, when `line` is not 0.
fn force_line(batch mut* bt, u32 bit, u32 line) void {
    if (line != 0) {
        judgement.push_named(&bt->named, judgement.named_line{bit, line, null});
    }
}

// Runs the row `row` of FORCED: the case of the gate with the report lines of the row and no
// error, in place of the rules that the compiler gives its item. It prints the kind of the first
// event that then fails the item, the end of a run that fails it with no error event, or `none`.
// Then it judges the item as judge_items judges each item of a set, which prints the lines of a
// failing item. A verdict other than that of the row stops the test, and so does a judge_items
// that does not agree with the verdict.
fn run_forced(check_env.env mut* c, forced* row) void {
    strbuf.str_buf mut name = strbuf.create();
    defer del(name.data);
    strbuf.append(&name, "forced ");
    strbuf.append(&name, row->name);
    batch mut* own bt = batch_make(family.fm_hand, case_lines(GATE_CASES[..], gate_case(row->name)),
                                   1);
    defer batch_drop_made(move(bt));
    prepare(c, bt);
    relocate(bt);
    prove_batch(c, bt);
    item mut* it = &bt->items[0];
    if (it->dropped) {
        panic("oracle_test.run_forced: the item of a case of the gate left its batch");
    }
    it->error = false;
    it->leak_line = row->leak_line != 0;
    it->whole_line = row->whole_line != 0;
    it->span_line = row->span_line != 0;
    bt->named.len = 0;
    force_line(bt, judgement.REPORT_LEAK, row->leak_line);
    force_line(bt, judgement.REPORT_WHOLE, row->whole_line);
    force_line(bt, judgement.REPORT_SPAN, row->span_line);
    counts mut n = counts{};
    run_batch(c, bt, &n);
    string mut fails = "none";
    if (it->errors != 0) {
        fails = shadow.EVENT_TEXT[disposition.index_of(it->failure.kind)];
    } else if (it->silent) {
        fails = judgement.END_TEXT[it->fault];
    }
    println("forced ", row->name, ": leak line ", row->leak_line, ", whole line ",
            row->whole_line, ", span line ", row->span_line, ": fails with ", fails);
    judge_items(bt, strbuf.view(&name), &n);
    if (fails != row->fails || (n.failing != 0) != (fails != "none")) {
        panic("oracle_test: a forced run of a case of the gate has another verdict");
    }
}

// Prints one line with the error events of a kind that the disposition table trusts in the items
// that the compiler accepts with no error and no report line, over the three sets: their count,
// then the count of each kind that has one. The compiler has no rule for such a kind, so each of
// these events is a failure of an accepted item that judgement.KNOWN lists.
fn print_trusted(counts* hand, counts* seeded, counts* shapes) void {
    strbuf.str_buf mut b = strbuf.create();
    defer del(b.data);
    u64 mut total = 0;
    for (u64 mut k = 0; k < disposition.KINDS; k++) {
        u64 count = hand->trusted[k] + seeded->trusted[k] + shapes->trusted[k];
        if (count == 0) {
            continue;
        }
        strbuf.append(&b, total == 0 ? ": " : ", ");
        strbuf.append(&b, shadow.EVENT_TEXT[k]);
        strbuf.push(&b, ' ');
        strbuf.append_u64(&b, count);
        total += count;
    }
    println("gate: events of a trusted kind in accepted items ", total, strbuf.view(&b));
}

// The count of the rows of FORCED that name the case `name`.
fn forced_rows(string name) u64 {
    u64 mut rows = 0;
    for (u64 mut r = 0; r < FORCED.len; r++) {
        if (FORCED[r].name == name) {
            rows += 1;
        }
    }
    return rows;
}

fn main() i32 {
    if (!disposition.is_complete()) {
        panic("oracle_test: the disposition table does not name each event kind of fir.shadow");
    }
    check_env.env mut* own c = check_env.make();
    defer check_env.drop_made(move(c));
    counts mut hand = counts{};
    run_cases(c, HAND[..], HAND_NAMES[..], "hand ", &hand);
    run_cases(c, ITEMS[..], ITEM_NAMES[..], "item ", &hand);
    run_cases(c, EXIT_CASES[..], EXIT_NAMES[..], "exit ", &hand);
    run_cases(c, DEL_CASES[..], DEL_NAMES[..], "del ", &hand);
    run_cases(c, USE_CASES[..], USE_NAMES[..], "use ", &hand);
    run_cases(c, AGG_CASES[..], AGG_NAMES[..], "aggregate ", &hand);
    run_cases(c, GATE_CASES[..], GATE_NAMES[..GATE_ITEMS], "gate ", &hand);
    for (u64 mut k = GATE_ITEMS; k < GATE_COUNT; k++) {
        if (forced_rows(GATE_NAMES[k]) == 0) {
            panic("oracle_test: no row of FORCED runs a case of the gate that is no hand item");
        }
    }
    for (u64 mut r = 0; r < FORCED.len; r++) {
        run_forced(c, &FORCED[r]);
    }
    u64 mut functions = 0;
    for (string line : FIR_CASES) {
        if (str.starts_with(line, "fn ")) {
            functions += 1;
        }
    }
    run_set(c, family.fm_fir, FIR_CASES[..], 0, functions, "fir", &hand);
    print_counts("hand", &hand);
    hold_floor(family.fm_hand, "hand", &hand);
    hold_known(judgement.UNIT_HAND, "hand", &hand);
    counts mut seeded = counts{};
    u64 dels = HAND_CASES + EXIT_COUNT + DEL_COUNT;
    u64 uses = dels + USE_COUNT;
    for (u64 mut k = 0; k < uses + AGG_COUNT; k++) {
        string@ mut lines = EXIT_CASES[..0];
        if (k < HAND_CASES) {
            lines = case_lines(HAND[..], k);
        } else if (k < HAND_CASES + EXIT_COUNT) {
            lines = case_lines(EXIT_CASES[..], k - HAND_CASES);
        } else if (k < dels) {
            lines = case_lines(DEL_CASES[..], k - HAND_CASES - EXIT_COUNT);
        } else if (k < uses) {
            lines = case_lines(USE_CASES[..], k - dels);
        } else {
            lines = case_lines(AGG_CASES[..], k - uses);
        }
        u64 variants = generator.seeded_count(lines);
        for (u64 mut first = 1; first <= variants; first += BATCH) {
            u64 mut count = BATCH;
            if (first + count > variants + 1) {
                count = variants + 1 - first;
            }
            run_set(c, family.fm_seeded, lines, first, count, "seeded", &seeded);
        }
    }
    print_counts("seeded", &seeded);
    hold_floor(family.fm_seeded, "seeded", &seeded);
    hold_known(judgement.UNIT_SEEDED, "seeded", &seeded);
    counts mut shapes = counts{};
    u64 count_shapes = generator.shapes_count();
    for (u64 mut first = 0; first < count_shapes; first += BATCH) {
        u64 mut count = BATCH;
        if (first + count > count_shapes) {
            count = count_shapes - first;
        }
        run_set(c, family.fm_shapes, HAND[..0], first, count, "shapes", &shapes);
    }
    print_counts("shapes", &shapes);
    hold_floor(family.fm_shapes, "shapes", &shapes);
    hold_known(judgement.UNIT_SHAPES, "shapes", &shapes);
    print_trusted(&hand, &seeded, &shapes);
    if (hand.false_accepts + seeded.false_accepts + shapes.false_accepts != 0) {
        panic("oracle_test: rule (a) has a false accept");
    }
    if (hand.leak[LEAK_FALSE_ACCEPTS] + seeded.leak[LEAK_FALSE_ACCEPTS]
        + shapes.leak[LEAK_FALSE_ACCEPTS] != 0) {
        panic("oracle_test: rule (c) part 1 has a false accept");
    }
    if (hand.inner[LEAK_FALSE_ACCEPTS] + seeded.inner[LEAK_FALSE_ACCEPTS]
        + shapes.inner[LEAK_FALSE_ACCEPTS] != 0) {
        panic("oracle_test: rule (c) part 2 has a false accept");
    }
    if (hand.uses[LEAK_FALSE_ACCEPTS] + seeded.uses[LEAK_FALSE_ACCEPTS]
        + shapes.uses[LEAK_FALSE_ACCEPTS] != 0) {
        panic("oracle_test: rule (b) has a false accept");
    }
    if (hand.aggregate[LEAK_FALSE_ACCEPTS] + seeded.aggregate[LEAK_FALSE_ACCEPTS]
        + shapes.aggregate[LEAK_FALSE_ACCEPTS] != 0) {
        panic("oracle_test: part 1 on the owning aggregate locals has a false accept");
    }
    return 0;
}
