/// Tests rule (a), the overwrite check of D17.11 that fir.emptiness proves, against the oracle:
/// the runs of fir.interpreter and the events of fir.shadow (spec/ownership-design.md 3.6). The
/// hand cases of the design reviews run as programs, and the three families of generator.ft run
/// with each input that they read. For each set the test prints its counts, its false accepts,
/// its false rejects and the events outside the scope of rule (a).
//
// The hand set holds the cases of the reviews, the item cases and the FIR cases. Each line of a
// reject in it comes from the rule, not from a run. fa5 has the one false reject of the cases of
// the reviews: its run calls `bsearch`, which the oracle does not run, so no run reaches the store
// after the call. fa5c calls `oracle_call` in its place, and its store has its event.
//
// A site is a function and the location of a `check(overwrite: p)`, where rule (a) reports its
// error; the lowering puts the store into `p` at the same location (spec/fir.md 9.3). The site is
// rejected when the pass does not prove a check there. An `overwrite` event is in the scope of
// rule (a) when it happens at a store into a place of an `own` reference type (design 3.4). A
// false accept is a site that is not rejected where a run gives such an event, and a false reject
// is a rejected site where no run gives one. Each function of a batch counts, the declarations of
// the batch and std.rt included, for the false accepts. Only the functions of the cases and of
// the families count for the other numbers.
//
// The test keeps only the functions that check, lower and verify (design 3.7): a function whose
// lines hold a diagnostic, or that the lowering or the verifier refuses, leaves its batch, and
// the batch is written and checked again.
import check_env;
import fort.ast;
import fort.check;
import fort.diag;
import fort.fir;
import fort.fir.emptiness;
import fort.fir.interpreter;
import fort.fir.shadow;
import fort.fir_lower;
import fort.fir_parse;
import fort.fir_verify;
import fort.types;
import generator;
import modules_env;
import run_env;
import std.str;
import std.strbuf;

/// The most statements of a function of the exhaustive family.
u64 N = 2;

// The count of the functions of a batch of the exhaustive family, of the seeded family and of
// the shapes. It is even, so a batch holds the sibling of each of its functions.
u64 BATCH = 200;

// The sandbox std/strbuf.ft of the hand cases: the declarations of std.strbuf that they call. An
// `append` grows the buffer before it copies, as std.strbuf does.
u64 STRBUF_LINES = 33;

string[STRBUF_LINES] STRBUF = {
    "struct str_buf {",
    "    u8 mut@ own data;",
    "    u64 len;",
    "}",
    "fn create() str_buf {",
    "    return str_buf{};",
    "}",
    "fn free(str_buf mut* b) void {",
    "    del(b->data);",
    "    b->len = 0;",
    "}",
    "fn reserve(str_buf mut* b, u64 extra) void {",
    "    if (b->len + extra <= b->data.len) {",
    "        return;",
    "    }",
    "    u8 mut@ own bigger = new(u8, 2 * (b->len + extra));",
    "    for (u64 mut i = 0; i < b->len; i++) {",
    "        bigger[i] = b->data[i];",
    "    }",
    "    del(b->data);",
    "    b->data = move(bigger);",
    "}",
    "fn append(str_buf mut* b, string s) void {",
    "    reserve(b, s.len);",
    "    for (u64 mut i = 0; i < s.len; i++) {",
    "        b->data[b->len + i] = cast(s[i], u8);",
    "    }",
    "    b->len += s.len;",
    "}",
    "fn view(str_buf* b) string {",
    "    return cast(b->data[..b->len], string);",
    "}",
    "",
};

// The hand cases of the design reviews (spec/ownership-design.md 5.6), with the k cases of the
// review of R6 and the span cases of the review of this test. Each starts with the line of its
// places (generator.ft), and `$` marks each name of a function. fa5 calls `bsearch`, which the
// oracle does not run, so fa5c calls `oracle_call`. In span_flip and span_local, the store holds
// the address of an element of a span, and the call in its right side changes the span, so the
// store writes the old element, which is live.
// The count of the lines of HAND.
u64 HAND_LINES = 550;

string[HAND_LINES] HAND = {
    "// places: arr[i]:i32 arr[j]:i32",
    "fn f$(u64 i, u64 j) i32 {",
    "    i32 mut* own[2] mut arr = {};",
    "    del(arr[i]);",
    "    arr[i] = new(i32);",
    "    *arr[i] = 7;",
    "    i32* v = arr[i];",
    "    del(arr[j]);",
    "    i32 s = *v;",
    "    i32 r = *arr[i];",
    "    del(arr[i]);",
    "    return r + s;",
    "}",
    "fn main$() i32 { return f$(0, 0); }",
    "// places: x:i32 *pp:i32 *slot:i32",
    "fn put$(i32 mut* own mut* slot) void {",
    "    del(*slot);",
    "    *slot = new(i32);",
    "}",
    "fn main$() i32 {",
    "    i32 mut* own mut x = new(i32);",
    "    del(x);",
    "    i32 mut* own mut* pp = &x;",
    "    put$(pp);",
    "    x = new(i32);",
    "    del(x);",
    "    return 0;",
    "}",
    "// places: n:i32",
    "struct holder { i32* v; }",
    "fn main$() i32 {",
    "    i32 mut* own n = new(i32);",
    "    *n = 5;",
    "    holder h = holder{n};",
    "    del(n);",
    "    return *h.v;",
    "}",
    "// places: n:i32",
    "fn id$(i32* p) i32* { return p; }",
    "fn main$() i32 {",
    "    i32 mut* own n = new(i32);",
    "    *n = 5;",
    "    i32* v = id$(n);",
    "    del(n);",
    "    return *v;",
    "}",
    "// places: G:i32",
    "extern fn bsearch(void* key, void* base, u64 n, u64 size, fn (void*, void*) i32 cmp) void*;",
    "i32 mut* own mut G = null;",
    "fn cmp$(void* a, void* b) i32 {",
    "    del(G);",
    "    G = new(i32);",
    "    return 0;",
    "}",
    "fn main$() i32 {",
    "    i32 k = 0;",
    "    del(G);",
    "    void* r = bsearch(cast(&k, void*), cast(&k, void*), 1, 4, cmp$);",
    "    G = new(i32);",
    "    del(G);",
    "    return 0;",
    "}",
    "// places: G:i32",
    "import std.libc;",
    "i32 mut* own mut G = null;",
    "fn cmp$(i32 n) i32 {",
    "    del(G);",
    "    G = new(i32);",
    "    return n;",
    "}",
    "fn main$() i32 {",
    "    del(G);",
    "    i32 r = libc.oracle_call(cmp$, 0);",
    "    G = new(i32);",
    "    del(G);",
    "    return r;",
    "}",
    "// places:",
    "struct holder { i32* p; }",
    "fn f$() holder {",
    "    i32 x = 1;",
    "    holder h = holder{&x};",
    "    return h;",
    "}",
    "fn g$() i32@ {",
    "    i32[4] a = {};",
    "    return a[..];",
    "}",
    "fn main$() i32 { holder h = f$(); i32@ s = g$(); return *h.p + s[0]; }",
    "// places: items[k]:i32 s[0]:i32",
    "fn refill$(i32 mut* own mut@ s) void {",
    "    del(s[0]);",
    "    s[0] = new(i32);",
    "}",
    "fn main$() i32 {",
    "    i32 mut* own mut@ own items = new(i32 mut* own, 1);",
    "    u64 k = 0;",
    "    del(items[k]);",
    "    refill$(items);",
    "    items[k] = new(i32);",
    "    del(items[k]);",
    "    del(items);",
    "    return 0;",
    "}",
    "// places: n:i32",
    "struct holder { i32* v; }",
    "fn fill$(holder mut* h) void {",
    "    i32 mut* own n = new(i32);",
    "    *n = 5;",
    "    h->v = n;",
    "    del(n);",
    "}",
    "fn main$() i32 { holder mut h = {}; fill$(&h); return *h.v; }",
    "// places: x:node y:node x->next:node yv->next:node",
    "struct node { node mut* own next; }",
    "fn main$() i32 {",
    "    node mut* own x = new(node);",
    "    node mut* own y = new(node);",
    "    x->next = move(y);",
    "    node mut* yv = x->next;",
    "    del(yv->next);",
    "    yv->next = move(x);",
    "    return 0;",
    "}",
    "// places: *p:i32 n->field:i32 a->field:i32 *slot:cell a:cell",
    "struct cell { i32 mut* own field; }",
    "fn f$(cell mut* own mut* slot, i32 mut* own mut* p) void {",
    "    del(*p);",
    "    cell mut* own n = move(*slot);",
    "    del(n->field);",
    "    n->field = new(i32);",
    "    *p = new(i32);",
    "    del(*slot);",
    "    *slot = move(n);",
    "}",
    "fn main$() i32 {",
    "    cell mut* own mut a = new(cell);",
    "    f$(&a, &a->field);",
    "    del(a->field);",
    "    del(a);",
    "    return 0;",
    "}",
    "// places: sb.data:u8,4",
    "import std.strbuf;",
    "fn main$() i32 {",
    "    strbuf.str_buf mut sb = strbuf.create();",
    "    strbuf.append(&sb, \"abc\");",
    "    string s = strbuf.view(&sb);",
    "    strbuf.free(&sb);",
    "    print(s);",
    "    return 0;",
    "}",
    "// places: b.data:u8,4 t->data:u8,4",
    "struct buf { u8 mut@ own data; }",
    "fn main$() i32 {",
    "    buf mut b = buf{};",
    "    del(b.data);",
    "    b.data = new(u8, 4);",
    "    buf mut* t = &b;",
    "    u8 mut@ v = t->data[..];",
    "    del(b.data);",
    "    return cast(v[0], i32);",
    "}",
    "// places: b.data:u8,4",
    "import std.strbuf;",
    "fn main$() i32 {",
    "    strbuf.str_buf mut b = strbuf.create();",
    "    strbuf.append(&b, \"abc\");",
    "    strbuf.append(&b, strbuf.view(&b));",
    "    strbuf.free(&b);",
    "    return 0;",
    "}",
    "// places: x:i32 *q:i32 *k:i32",
    "struct box { i32 mut* own mut* p; }",
    "struct outer { box mut* b; }",
    "fn poke$(i32 mut* own mut* k, outer* j) void {",
    "    i32 mut* own mut* q = j->b->p;",
    "    del(*q);",
    "    *q = new(i32);",
    "}",
    "fn main$() i32 {",
    "    i32 mut* own mut x = new(i32);",
    "    box mut bx = box{&x};",
    "    outer o = outer{&bx};",
    "    del(x);",
    "    poke$(&x, &o);",
    "    x = new(i32);",
    "    del(x);",
    "    return 0;",
    "}",
    "// places: x:i32 *q:i32 *k:i32",
    "struct box { i32 mut* own mut* p; }",
    "struct outer { box mut* b; }",
    "fn poke$(i32 mut* own mut* k, outer* j) void {",
    "    i32 mut* own mut* q = j->b->p;",
    "    del(*q);",
    "    *q = new(i32);",
    "}",
    "fn main$() i32 {",
    "    i32 mut* own mut x = new(i32);",
    "    box mut bx = box{&x};",
    "    outer o = outer{&bx};",
    "    del(x);",
    "    poke$(&x, &o);",
    "    del(x);",
    "    return 0;",
    "}",
    "// places: arr[0]:i32 arr[k]:i32 *s:i32",
    "fn put$(i32 mut* own mut* s) void {",
    "    del(*s);",
    "    *s = new(i32);",
    "}",
    "fn main$() i32 {",
    "    i32 mut* own[2] mut arr = {};",
    "    u64 k = 0;",
    "    put$(&arr[k]);",
    "    arr[0] = new(i32);",
    "    del(arr[0]);",
    "    del(arr[k]);",
    "    return 0;",
    "}",
    "// places: x:i32 *pp:i32",
    "fn main$() i32 {",
    "    i32 mut* own mut x = new(i32);",
    "    i32 mut* own mut* pp = &x;",
    "    del(x);",
    "    return **pp;",
    "}",
    "// places: n:i32",
    "fn main$() i32 {",
    "    i32 mut* own n = new(i32);",
    "    *n = 5;",
    "    u64 a = cast(n, u64);",
    "    del(n);",
    "    i32* v = cast(a, i32*);",
    "    return *v;",
    "}",
    "// places: s.buf:i32 ps->buf:i32",
    "struct box { i32 mut* own buf; }",
    "fn main$() i32 {",
    "    box mut s = box{};",
    "    s.buf = new(i32);",
    "    box mut* ps = &s;",
    "    del(s.buf);",
    "    return *ps->buf;",
    "}",
    "// places: n:i32 *k:i32",
    "struct holder { i32* v; }",
    "fn g$(i32 mut* own mut* k, holder* j) i32 {",
    "    del(*k);",
    "    *k = new(i32);",
    "    return *j->v;",
    "}",
    "fn main$() i32 {",
    "    i32 mut* own mut n = new(i32);",
    "    *n = 5;",
    "    holder h = holder{n};",
    "    i32 r = g$(&n, &h);",
    "    del(n);",
    "    return r;",
    "}",
    "// places: x:i32 *pp:i32",
    "fn main$() i32 {",
    "    i32 mut* own mut x = new(i32);",
    "    *x = 5;",
    "    i32 mut* own mut* pp = &x;",
    "    i32* v = x;",
    "    del(*pp);",
    "    return *v;",
    "}",
    "// places: x:i32 *pp:i32",
    "fn main$() i32 {",
