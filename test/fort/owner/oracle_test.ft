// The count of the hand cases.
u64 HAND_CASES = 53;

string[HAND_CASES] HAND_NAMES = {
    "fa1", "fa2", "fa3", "fa4", "fa5", "fa5c", "fa6", "fa7", "fa8", "fa9", "fa10", "fa11", "fa12",
    "fa13", "g1", "g1b", "g2", "g3", "g4", "g5", "g6", "g7", "g8", "h1", "h2", "h3", "h4", "h5",
    "h6", "h7", "h8", "h9", "h10", "n1", "n1b", "n2a", "n2b", "n3", "n4", "k2", "k2b", "k2d",
    "span_flip", "span_local", "k2r", "n4a", "k2g", "k2s", "k2j", "k2l", "k2o", "k2p", "k2v",
