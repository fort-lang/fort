    "}",
};

// The count of the cases of the gate.
u64 GATE_COUNT = 18;

string[GATE_COUNT] GATE_NAMES = {
    "whole", "before_abort", "cycle", "use", "span", "span_chain", "before_check", "abort_block",
    "inner", "nested_array", "unreachable", "string_owner", "whole_pointer", "span_aggregate",
    "drop_store", "vacated_view", "whole_chain", "silent",
};

// The count of the cases of the gate that run as items of the hand set. Only FORCED runs the
// last two cases, `whole_chain` and `silent`, and the test stops when no row of FORCED names such
// a case.
u64 GATE_ITEMS = 16;

// One forced run of a case of the gate: the test gives the item of the case `name` the report
// lines that the three fields name and no error, whatever the compiler says of it. `fails` is the
// text of the kind of the first event of the run that then fails the item, or "none".
struct forced {
    string name;
    u32 leak_line;
    u32 whole_line;
    u32 span_line;
    string fails;
}

// The count of the rows of FORCED.
u64 FORCED_ROWS = 54;

// The forced runs of the cases of the gate. A row names the line of the text of its case that
// each report line names, or 0 for no line of that option. A person derived each verdict from the
// rules: an item with no line fails for each error event, and a report line takes only an event
// of its own rule on the line that it names. `--leak-report` takes a `leak`.
// `--whole-store-report` takes an `overwrite`. `--span-del-report` takes a `leak` at its `del`.
// No line takes a `leak at exit`: in `span_chain` and in `whole_chain` the allocation below the
// first one stays an error with each set of lines. The event of `span_chain` stands on line 19,
// and three rows give that line to one option each. No line takes a `use after move` (`use`,
// `vacated_view`). A line on another line than the event takes nothing: line 5 of `whole`, lines
// 10 of `span`, line 8 of `inner`. A `leak` at a `dead` marker has no line that a report can
// name, because part 1 of D17.20 is an error of the pass: `before_abort`, `before_check`,
// `nested_array` and `string_owner` fail with a leak line too. The `leak at exit` of a cycle is
// no error with each set of lines. `before_check` and `abort_block` hold the two sides of
// fir.term_is_abort, which the pass reads too. The `leak` at the `dead` of a block that ends in
// a `check` is an error. The `leak` at the `dead` of an abort block is no error with no line.
// `unreachable` gives no event. In `whole_chain` the row with the whole line alone is the set of
// rules that the compiler gives that item. `silent` gives no event, and its run ends in a fault
// that is no `null dereference` (judge_end): the item fails with no line and with a line of
// `--leak-report` on the line of the fault, which takes no end of a run.
forced[FORCED_ROWS] FORCED = {
    forced{"whole", 0, 0, 0, "overwrite"},
    forced{"whole", 6, 0, 0, "overwrite"},
    forced{"whole", 0, 0, 6, "overwrite"},
    forced{"whole", 0, 6, 0, "none"},
    forced{"whole", 0, 5, 0, "overwrite"},
    forced{"before_abort", 0, 0, 0, "leak"},
    forced{"before_abort", 0, 5, 0, "leak"},
    forced{"before_abort", 0, 0, 5, "leak"},
    forced{"before_abort", 5, 0, 0, "leak"},
    forced{"cycle", 0, 0, 0, "none"},
    forced{"use", 0, 0, 0, "use after move"},
    forced{"use", 6, 6, 6, "use after move"},
    forced{"span", 0, 0, 0, "leak"},
