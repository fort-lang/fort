    forced{"nested_array", 0, 0, 0, "leak"},
    forced{"nested_array", 5, 0, 0, "leak"},
    forced{"unreachable", 0, 0, 0, "none"},
    forced{"string_owner", 0, 0, 0, "leak"},
    forced{"string_owner", 4, 0, 0, "leak"},
