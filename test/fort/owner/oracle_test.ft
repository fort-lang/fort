    "    pair mut s = pair{};",
    "    s.a = new(i32);",
    "    del(s.a);",
    "    s = pair{};",
    "    s.a = new(i32);",
    "    del(s.a);",
    "}",
    "fn reject$() void {",
    "    pair mut s = pair{};",
    "    s = make$();",
    "    s.a = new(i32);",
    "    del(s.a);",
    "    del(s.b);",
    "}",
    "fn main$() i32 {",
    "    accept$();",
    "    reject$();",
    "    return 0;",
    "}",
    "// places: x:i32 y:i32",
    "fn take$(i32 mut* own v, i32 mut* own mut* s) void {",
    "    del(v);",
    "    del(*s);",
    "    *s = new(i32);",
    "}",
    "fn accept$() void {",
    "    i32 mut* own mut x = new(i32);",
    "    i32 mut* own mut y = null;",
    "    y = move(x);",
    "    x = new(i32);",
    "    del(x);",
    "    del(y);",
    "}",
    "fn reject$() void {",
    "    i32 mut* own mut x = new(i32);",
    "    take$(move(x), &x);",
    "    x = new(i32);",
    "    del(x);",
    "}",
    "fn main$() i32 {",
    "    accept$();",
    "    reject$();",
    "    return 0;",
    "}",
    "// places: n->a:i32",
    "struct pair { i32 mut* own a; i32 mut* own b; }",
    "fn accept$(i32 mut* r) void {",
    "    pair mut* own n = new(pair);",
    "    *r = 5;",
    "    n->a = new(i32);",
    "    del(n->a);",
    "    del(n);",
    "}",
    "fn reject$() void {",
    "    pair mut* own n = new(pair);",
    "    pair mut* m = n;",
    "    m->a = new(i32);",
    "    n->a = new(i32);",
    "    del(n->a);",
    "    del(n);",
    "}",
    "fn main$() i32 {",
    "    i32 mut* own k = new(i32);",
    "    accept$(k);",
    "    reject$();",
    "    del(k);",
    "    return 0;",
    "}",
    "// places: G:i32 *p:i32",
    "i32 mut* own mut G = null;",
    "fn accept$(i32 mut* own mut* p) void {",
    "    i32 mut* own mut y = null;",
    "    del(*p);",
    "    y = new(i32);",
    "    *p = new(i32);",
    "    del(y);",
    "}",
    "fn reject$(i32 mut* own mut* p) void {",
    "    del(G);",
    "    del(*p);",
    "    G = new(i32);",
    "    *p = new(i32);",
    "}",
    "fn main$() i32 {",
    "    i32 mut* own mut x = null;",
    "    accept$(&x);",
    "    reject$(&G);",
    "    del(x);",
    "    del(G);",
    "    return 0;",
    "}",
    "// places: p->g:i32",
    "struct node { node mut* next; i32 mut* own g; }",
    "fn accept$(node mut* p) void {",
    "    del(p->g);",
    "    p->g = new(i32);",
    "}",
    "fn reject$(node mut* p) void {",
    "    del(p->g);",
    "    p->next->g = new(i32);",
    "    p->g = new(i32);",
    "}",
    "fn main$() i32 {",
    "    node mut n = node{};",
    "    n.next = &n;",
    "    accept$(&n);",
    "    reject$(&n);",
    "    del(n.g);",
    "    return 0;",
    "}",
    "// places: n->a:i32",
    "struct pair { i32 mut* own a; i32 mut* own b; }",
    "pair mut* mut ALIAS = null;",
    "fn make$() pair mut* own {",
    "    pair mut* own p = new(pair);",
    "    ALIAS = p;",
    "    return p;",
    "}",
    "fn accept$(bool b, i32 mut* r) void {",
    "    pair mut* own mut n = null;",
    "    if (b) {",
    "        n = new(pair);",
    "    } else {",
    "        n = new(pair);",
    "    }",
    "    *r = 5;",
    "    n->a = new(i32);",
    "    del(n->a);",
    "    del(n);",
    "}",
    "fn reject$(bool b) void {",
    "    pair mut* own mut n = make$();",
    "    del(n->a);",
    "    if (b) {",
    "        del(n);",
    "        n = new(pair);",
    "    }",
    "    ALIAS->a = new(i32);",
    "    n->a = new(i32);",
    "    del(n->a);",
    "    del(n);",
    "}",
    "fn main$() i32 {",
    "    i32 mut* own k = new(i32);",
    "    accept$(false, k);",
    "    reject$(false);",
    "    del(k);",
    "    return 0;",
    "}",
};

// The count of the item cases.
u64 ITEM_CASES = 22;

string[ITEM_CASES] ITEM_NAMES = {
    "local", "field", "index", "global", "deref", "span", "move", "null", "fresh", "call",
    "pointer", "straight", "key", "join", "loop", "held", "zero", "order", "copy", "global_store",
    "leaving", "fresh_join",
};

// The FIR text cases of design 3.6, for the shapes that the lowering of fort makes nowhere: an
// index temporary that a store into its source makes stale, the `alloc` of a temporary that a
// second item reads, the one store of a temporary that is memory, an `addr mut` of fixed storage,
// which is no held address, an address of a held address, a held address after a store into a local
// that its place reads, a held address after a store that changes the span header that its place
// reads, and a check whose first statement after it changes its place. `key_fresh`, `fresh_once`,
// `held_address`, the helpers `call_fill`, `make_pair`, `index_one` and `call_poke`, and
// `call_local` keep the rule; the held address of `held_address` names a place through a fresh
// pointer, and in `call_local` a call stores into a local that is no memory. The other 24 cases
// break it at a store that the run reaches with a live allocation. `held_memory` changes its held
// address through the address of it. In `stale_base` and `stale_key` a store into the base or the
// index of the place of a held address comes before its check, in `stale_fresh` the place is
// through a fresh pointer, and in `stale_alias` a `move` through the stale address comes before a
// store through that fresh pointer. In `span_alias`, `span_straight` and `span_global` the span
// header changes through a copy of the base pointer, by a store straight into a memory local and by
// a store straight into a global. In `stale_gen` a `move` through the stale address comes before a
// check of the place that its index names now, and in `stale_join` one edge makes the address
// stale. In `call_store` and `call_value` the store of the check calls `call_fill`, directly and
// through a function value, and `call_fill` fills the place of the check. In `call_void` a call of
// `call_poke` with a `void` result comes before the store, in `store_whole` a call stores into the
// local of the field of the check, and in `call_key` a call stores into the key of the place of the
// check. With no call, a store through a second pointer to the object of the check comes first in
// `alias_store`, and a store straight into the global that the pointer of the check names in
// `global_alias`. These were false accepts of fir.emptiness: `held_value`, `held_fresh` and
// `held_copy` while an `addr mut` of fixed storage could be a held address, `stale_base` and
// `stale_key` while a held address read as its place after such a store, `stale_alias` while a
// stale held address gave a tracked place, the three span cases while only a store into a local
// made a held address stale (spec/fir.md 11, Held address), and the seven cases of the first
// statement after a check while the pass applied no kill rule of that statement at the check, or
// only the kill of its call (spec/fir.md 11, Proof). In `fresh_twice`, `held_fresh`, `held_copy`,
// `stale_fresh`, `held_chain` and `stale_gen`, the other rejected sites are false rejects: no fact
// names their places, and the run finds them empty. FIR_PRELUDE holds the declarations that they
// name.
u64 FIR_PRELUDE_LINES = 12;

string[FIR_PRELUDE_LINES] FIR_PRELUDE = {
    "struct pair {",
    "    i32 mut* own a;",
    "    i32 mut* own b;",
    "}",
    "struct box {",
    "    i32 mut* own[2] e;",
    "}",
    "struct sbox {",
    "    i32 mut* own mut@ s;",
    "}",
    "sbox mut GS = {};",
    "pair mut GP = {};",
};

