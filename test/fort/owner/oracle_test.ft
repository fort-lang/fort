    "    *arr[i] = 7;",
    "    i32* v = arr[i];",
    "    del(arr[j]);",
    "    i32 s = *v;",
    "    i32 r = *arr[i];",
    "    del(arr[i]);",
    "    return r + s;",
    "}",
    "fn main$() i32 { return f$(0, 0); }",
    "// places: x:i32 *pp:i32 *slot:i32",
    "fn put$(i32 mut* own mut* slot) void {",
    "    del(*slot);",
    "    *slot = new(i32);",
    "}",
    "fn main$() i32 {",
