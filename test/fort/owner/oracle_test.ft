    "fn leak$() void {",
    "    box mut* own q = new(box);",
    "    q->a = new(i32);",
    "    void* own v = cast(move(q), void* own);",
    "    del(v);",
    "}",
    "fn free$() void {",
    "    box mut* own q = new(box);",
    "    q->a = new(i32);",
    "    del(q->a);",
    "    void* own v = cast(move(q), void* own);",
    "    del(v);",
    "}",
    "fn main$() i32 {",
    "    leak$();",
    "    free$();",
    "    return 0;",
    "}",
    "// places: s[0]:i32",
    "fn put$(i32 mut* own mut* p) void {",
    "    del(*p);",
    "    *p = new(i32);",
    "}",
    "fn leak$() void {",
    "    i32 mut* own mut@ own s = new(i32 mut* own, 2);",
    "    put$(&s[0]);",
    "    del(s);",
    "}",
    "fn free$() void {",
    "    i32 mut* own mut@ own s = new(i32 mut* own, 2);",
    "    put$(&s[0]);",
    "    del(s[0]);",
    "    del(s);",
    "}",
    "fn main$() i32 {",
    "    leak$();",
    "    free$();",
    "    return 0;",
    "}",
    "// places: q->a:i32 q->kids[0]:i32 q->kids[1]:i32",
    "struct inner {",
    "    i32 mut* own c;",
    "}",
    "struct outer {",
    "    i32 mut* own a;",
    "    inner in;",
    "    i32 mut* own[2] kids;",
    "}",
    "fn leak$() void {",
    "    outer mut* own q = new(outer);",
    "    q->kids[1] = new(i32);",
    "    del(q->kids[0]);",
    "    del(q);",
    "}",
    "fn free$() void {",
    "    outer mut* own q = new(outer);",
    "    q->kids[1] = new(i32);",
    "    del(q->kids[1]);",
    "    del(q->kids[0]);",
    "    del(q);",
    "}",
    "fn main$() i32 {",
    "    leak$();",
    "    free$();",
    "    return 0;",
    "}",
    "// places: q->a:i32",
    "struct box {",
    "    i32 mut* own a;",
    "}",
    "fn leak$(bool c) void {",
    "    box mut* own q = new(box);",
    "    defer del(q);",
    "    if (c) {",
    "        q->a = new(i32);",
    "        return;",
    "    }",
    "}",
    "fn free$(bool c) void {",
    "    box mut* own q = new(box);",
    "    defer del(q);",
    "    if (c) {",
    "        q->a = new(i32);",
    "        del(q->a);",
    "        return;",
    "    }",
    "}",
    "fn main$() i32 {",
    "    leak$(true);",
    "    leak$(false);",
    "    free$(true);",
    "    return 0;",
    "}",
    "// places: q->a:i32",
    "struct box {",
    "    i32 mut* own a;",
    "}",
    "fn free$() void {",
    "    box mut* own q = new(box);",
    "    del(q);",
    "}",
    "fn leak$() void {",
    "    box mut* own q = new(box);",
    "    q->a = new(i32);",
    "    del(q);",
    "    panic(\"stop\");",
    "}",
    "fn main$() i32 {",
    "    free$();",
    "    leak$();",
    "    return 0;",
    "}",
    "// places: b->a:i32",
    "struct box {",
    "    i32 mut* own a;",
    "}",
    "struct holder {",
    "    box mut* own b;",
    "}",
    "fn fill$(box mut* b) void {",
    "    del(b->a);",
    "    b->a = new(i32);",
    "}",
    "fn leak$(holder mut* h) void {",
    "    del(h->b);",
    "}",
    "fn free$(holder mut* h) void {",
    "    box mut* own b = move(h->b);",
    "    del(b->a);",
    "    del(b);",
    "}",
    "fn main$() i32 {",
    "    holder mut h1 = holder{};",
    "    h1.b = new(box);",
    "    fill$(h1.b);",
    "    leak$(&h1);",
    "    holder mut h2 = holder{};",
    "    h2.b = new(box);",
    "    fill$(h2.b);",
    "    free$(&h2);",
    "    return 0;",
    "}",
    "// places: *pp:i32",
    "fn leak$() void {",
    "    i32 mut* own mut* own pp = new(i32 mut* own);",
    "    *pp = new(i32);",
    "    del(pp);",
    "}",
    "fn free$() void {",
    "    i32 mut* own mut* own pp = new(i32 mut* own);",
    "    *pp = new(i32);",
    "    del(*pp);",
    "    del(pp);",
    "}",
    "fn main$() i32 {",
    "    leak$();",
    "    free$();",
    "    return 0;",
    "}",
    "// places: q->a:i32 q->b:i32",
    "struct box {",
    "    i32 mut* own a;",
    "    i32 mut* own b;",
    "}",
    "fn leak$(box mut* own q) void {",
    "    if (q != null) {",
    "        del(q);",
    "        return;",
    "    }",
    "    del(q);",
    "}",
    "fn free$(box mut* own q) void {",
    "    if (q == null) {",
    "        del(q);",
    "        return;",
    "    }",
    "    del(q->a);",
    "    del(q->b);",
    "    del(q);",
    "}",
    "fn main$() i32 {",
    "    box mut* own a = new(box);",
    "    a->a = new(i32);",
    "    leak$(move(a));",
    "    leak$(null);",
    "    box mut* own b = new(box);",
    "    b->a = new(i32);",
    "    free$(move(b));",
    "    free$(null);",
    "    return 0;",
    "}",
    "// places: c->v:i32",
    "struct cell {",
    "    i32 mut* own v;",
    "    cell mut* own next;",
    "}",
    "struct list {",
    "    cell mut* own head;",
    "}",
    "fn leak$(list mut* l) void {",
    "    if (l->head != null) {",
    "        del(l->head);",
    "    }",
    "}",
    "fn free$(list mut* l) void {",
    "    while (l->head != null) {",
    "        cell mut* own c = move(l->head);",
    "        cell mut* own rest = move(c->next);",
    "        del(c->v);",
    "        del(c);",
    "        l->head = move(rest);",
    "    }",
    "    del(l->head);",
    "}",
    "fn main$() i32 {",
    "    cell mut* own c = new(cell);",
    "    c->v = new(i32);",
    "    list mut l = list{};",
    "    l.head = move(c);",
    "    leak$(&l);",
    "    cell mut* own d = new(cell);",
    "    d->v = new(i32);",
    "    list mut k = list{};",
    "    k.head = move(d);",
    "    free$(&k);",
    "    return 0;",
    "}",
};

u64 DEL_COUNT = 13;

string[DEL_COUNT] DEL_NAMES = {
    "local", "param", "memory", "call", "cast", "span", "nested", "twin", "abort", "field", "owner",
    "tested", "tested_field",
};

// The FIR text cases of design 3.6, for the shapes that the lowering of fort makes nowhere: an
// index temporary that a store into its source makes stale, the `alloc` of a temporary that a
// second item reads, the one store of a temporary that is memory, an `addr mut` of fixed storage,
// which is no held address, an address of a held address, a held address after a store into a local
// that its place reads, a held address after a store that changes the span header that its place
// reads, a check whose first statement after it changes its place, a check that a statement or a
// `goto` parts from its store, a store with no check, a store of the zero value that is no entry
// zeroing, a check that guards a store into a temporary or into `_0`, a store into a temporary in a
// loop, two stores into `_0`, and a store into a field of a temporary, or a `move` or a `del`
// through a pointer temporary, before a store into the whole temporary. `key_fresh`, `fresh_once`,
// `held_address`, the helpers `call_fill`, `make_pair`, `index_one` and `call_poke`, `call_local`,
// `goto_kept`, `lone_local`, `lone_kept`, the helper `poke_ref` and `guard_call`, `result_call`,
// `pair_call` and `branch_call`, which call the case of their name, keep the rule; the held address
// of `held_address` names a place through a fresh pointer, in `call_local` and `lone_local` a call
// stores into a local that is no memory, with a check and with none, in `goto_kept` a `goto` leads
// from the check to a store that follows a `del`, and in `lone_kept` a store with no check follows
// a `del` of its place. The other 41 cases break it at a store that the run reaches with a live
// allocation. `held_memory` changes its held address through the address of it. In `stale_base` and
// `stale_key` a store into the base or the index of the place of a held address comes before its
// check, in `stale_fresh` the place is through a fresh pointer, and in `stale_alias` a `move`
// through the stale address comes before a store through that fresh pointer. In `span_alias`,
// `span_straight` and `span_global` the span header changes through a copy of the base pointer, by
// a store straight into a memory local and by a store straight into a global. In `stale_gen` a
// `move` through the stale address comes before a check of the place that its index names now, and
// in `stale_join` one edge makes the address stale. In `call_store` and `call_value` the store of
// the check calls `call_fill`, directly and through a function value, and `call_fill` fills the
// place of the check. In `call_void` a call of `call_poke` with a `void` result comes before the
// store, in `store_whole` a call stores into the local of the field of the check, and in `call_key`
// a call stores into the key of the place of the check. With no call, a store through a second
// pointer to the object of the check comes first in `alias_store`, and a store straight into the
// global that the pointer of the check names in `global_alias`. In `mid_store` a statement stands
// between the check and its store, which calls `call_fill`, in `goto_store` a `goto` stands there,
// and in `lone_store` that store has no check. In `mid_kill` a statement stands between the check
// and the first statement after it, a call that stores into the local of the field of the check. In
// `guard_temp` and `guard_goto` a call fills a temporary through its address between its check and
// its store, the second through a `goto`, and in `guard_result` it fills `_0` there; in `loop_temp`
// one store into a temporary runs twice. In `result_twice` two stores write an `_0` that is no
// aggregate; in `guard_pair` a call fills a field of an aggregate `_0`, whose store needs no proof,
// and in `guard_branch` it fills an `_0` that is no aggregate on one of two paths. In `span_field`
// a store into field 0 of a span temporary comes before a store into the whole temporary, and in
// `zero_field` a store of the zero value into field 1 of it does. In `move_through` and
// `del_through` a `move` and a `del` of the pointee of a pointer temporary come before a store into
// the temporary. In `late_zero` a store of the zero value into a named local follows a store into
// it in `bb0`, and in `block_zero` it stands in a block after `bb0`, so neither is an entry
// zeroing. These were false accepts of the emptiness pass: `held_value`, `held_fresh` and
// `held_copy` while an `addr mut` of fixed storage could be a held address, `stale_base` and
// `stale_key` while a held address read as its place after such a store, `stale_alias` while a
// stale held address gave a tracked place, the three span cases while only a store into a local
// made a held address stale (spec/fir.md 11, Held address), and the seven cases of the first
// statement after a check while the pass applied no kill rule of that statement at the check, or
// only the kill of its call, and `mid_store`, `goto_store`, `lone_store` and `mid_kill` while the
// pass proved each check and no store, and the guard cases, `loop_temp` and `result_twice` while a
// store into a temporary or into `_0` needed no proof and gave its check no verdict (spec/fir.md
// 11, Proof). In `fresh_twice`, `held_fresh`, `held_copy`, `stale_fresh`, `held_chain` and
// `stale_gen`, the other rejected sites are false rejects: no fact names their places, and the run
// finds them empty. So is the store with no check at 6:2 in `alias_store`, through the second
// pointer, and in `global_alias`, into the global, and the first store into the local of
// `late_zero` and of `block_zero`, which holds no allocation at the entry.
// The cases of rule (c) part 1 follow, for the shapes that only FIR text makes: `leak_temp` returns
// with a live temporary, `leak_param` with a live parameter, which `param_call` gives it,
// `leak_named` with a named local that no `dead` ends, and `leak_address` with a named local whose
// address takes a store; `leak_again` stores into a named local after its `dead`, and the
// `return` finds it live. Each breaks the rule at its `return`. `keep_named` frees its named local
// before the `return`. In `memory_call` the temporary is memory, so the call after its `del` kills
// its fact, a false reject. In `leak_abort` the `dead` stands in the block of a `trap`, an abort
// block, so it has no obligation and its event is outside part 1 (X3). In `dead_twice` the first
// `dead` ends the slots of the local, so the second one is a false reject. In `dangle_mix` and
// `late_dangle` a load through an address of a named local after its `dead` comes beside a leak
// that the pass rejects: a temporary at the `return`, and a named local at its `dead`. A run that
// dangles counts no `leak` apart, so a wrong proof of such a leak is a false accept.
// The sites of part 2 of the FIR cases free a `pair` or a `box` after a `del` of one inner owner,
// or through a place that is no pointer local. Each rejected one is a false reject: an alias, a
// held address, a memory local, a store into the key of an element or a call killed the fact of
// an inner owner, or no `new` gave it, and the run finds the owner empty.
// The cases of a test against null follow (D17.11 gen rule 6), each with a statement between the
// read of the test and its `switch` that only FIR text puts there. In `null_call` a call fills the
// global after the test, in `null_alias` a store straight into the global changes the place that
// a pointer names, which also has no fact for its own store, a false reject, in `null_place` a
// store fills the tested local, and in `null_temp` a store fills the tested temporary. In
// `null_stale` a store into the global makes the held address stale before the test reads it, so
// the test reads the old element and gives no fact; its store through the stale address is a
// false reject that no run reaches. `null_leak` and `null_del` hold the edge of the other value:
// the true edge of `ne` and the `otherwise` edge of `eq` hold no fact. `null_fill` is the callee
// of `null_call`.
// FIR_PRELUDE holds the declarations that they name.
u64 FIR_PRELUDE_LINES = 12;

string[FIR_PRELUDE_LINES] FIR_PRELUDE = {
    "struct pair {",
    "    i32 mut* own a;",
    "    i32 mut* own b;",
    "}",
    "struct box {",
    "    i32 mut* own[2] e;",
    "}",
    "struct sbox {",
    "    i32 mut* own mut@ s;",
    "}",
    "sbox mut GS = {};",
    "pair mut GP = {};",
};

