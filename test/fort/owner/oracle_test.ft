string[HAND_CASES] HAND_NAMES = {
    "fa1", "fa2", "fa3", "fa4", "fa5", "fa5c", "fa6", "fa7", "fa8", "fa9", "fa10", "fa11", "fa12",
    "fa13", "g1", "g1b", "g2", "g3", "g4", "g5", "g6", "g7", "g8", "h1", "h2", "h3", "h4", "h5",
