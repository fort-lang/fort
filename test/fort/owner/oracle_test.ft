// The count of the item cases.
u64 ITEM_CASES = 25;

string[ITEM_CASES] ITEM_NAMES = {
    "local", "field", "index", "global", "deref", "span", "move", "null", "fresh", "call",
    "pointer", "straight", "key", "join", "loop", "held", "zero", "order", "copy", "global_store",
    "leaving", "fresh_join",
    "test_null", "test_loop", "test_alias",
};

// The exit cases of rule (c) part 1 (D17.20): for each exit kind of design 6.3, a function whose
// exit a run reaches with a live allocation and one whose exit frees it, in the format of HAND.
// `brace` leaves a block, `return` returns before its `del`, with the parameter `p` live too,
// `break` and `continue` leave a loop, and `defer` frees at each exit. In `abort` the block of the
// local falls off into the block of a `panic`, an abort block, so its `dead` has no obligation and
// its `leak` is no error, because the run ends in a runtime error; in `twin` an `if` follows the
// same block. In `memory` a call that can change the local comes after its `del`, and in `main`
// the `return` of the entry leaves a live local. In `tested` the arm of `p != null` and the arm of
// `!(p == null)` return with `p` live, and the arm of `&&` gets no fact of its two tests, a false
// reject (spec/fir.md 11, Tests).
// The seeded family inserts into these cases too. The `continue` case also leaves its local live
// at the declaration of the next round, an error of rule (a) that no run reaches with a live
// allocation.
// The count of the lines of EXIT_CASES.
u64 EXIT_LINES = 192;

string[EXIT_LINES] EXIT_CASES = {
    "// places: n:i32",
    "fn leak$() void {",
    "    {",
    "        i32 mut* own n = new(i32);",
    "    }",
    "}",
    "fn free$() void {",
    "    {",
