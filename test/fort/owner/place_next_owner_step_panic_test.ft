//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: owner.place.next_owner_step: no such inner owner
//! stdout:
//| 1 p 0 0
/// next_owner_step gives the step toward inner owner `k` of a type, and the fixture `holder` has
/// one inner owner, its field `p`. The test asks for owner 0, then for owner 1, which the type does
/// not hold. owner.prover asks only for an owner below place.count_owners.
import fir_env;
import fort.owner.place;
import fort.types;

fn main() i32 {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    types.node* t = fir_env.ty(&e, "holder");
    place.owner_step mut step = place.owner_step{};
    u64 mut rest = 9;
    bool found = place.next_owner_step(t, 0, &step, &rest);
    println(place.count_owners(t), " ", step.name, " ", step.field, " ", rest);
    assert(found);
    place.next_owner_step(t, 1, &step, &rest);
    return 0;
}
