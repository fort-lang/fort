// Holds that `got` holds the lines of `want`, each after `file` and with a line feed.
fn expect_lines(string got, string file, string@ want) void {
    strbuf.str_buf mut text = strbuf.create();
    defer del(text.data);
    u64 mut k = 0;
    while (k < want.len) {
        strbuf.append(&text, file);
        strbuf.append(&text, want[k]);
        strbuf.push(&text, '\n');
        k += 1;
    }
    if (got != strbuf.view(&text)) {
        eprintln(got, "and not\n", strbuf.view(&text));
        panic("prover_whole_test: the lines of the report differ");
    }
}

// Appends the lines of the report of the function `name` of the checked source of `e` to `out`.
fn report_function(lower_env.env mut* e, string name, strbuf.str_buf mut* out) void {
    fir.func mut* own f = fir.func_make();
    defer fir.func_drop_made(move(f));
    lower(e, name, f);
    prover.proof mut* own p = prover.prove_made(f);
    defer prover.drop_made(move(p));
    report.write_wholes(f, p, &e->c.m.s, out);
}

// The report names the first owner below the destination of each whole store that the pass does
// not prove, at the `=` of its assignment, with its cause, in the file of the function. It writes
// no diagnostic: such a store is no error until the migration of the whole stores ends (D17.11).
fn the_report_names_the_first_owner_of_each_store() void {
    strbuf.str_buf mut got = strbuf.create();
    defer del(got.data);
    lower_env.env mut* own e = lower_env.make();
    defer lower_env.drop_made(move(e));
    lower_env.check_lines(e, SOURCE[..], true);
    string file = lower_env.decl_file(e, "probe");
    assert(str.ends_with(file, "main.ft"));
    u64 before = check_env.reports(&e->c);
    u64 mut k = 0;
    while (k < SOURCE_NAMES.len) {
        report_function(e, SOURCE_NAMES[k], &got);
        k += 1;
    }
    expect_lines(strbuf.view(&got), file, REPORTED[..]);
    assert(check_env.reports(&e->c) == before);
}

