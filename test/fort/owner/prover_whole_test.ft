// With no tree, the report names a parameter by its declared name and any other destination by its
// FIR place, and it gives one store of one location once.
fn the_report_of_a_fir_text_names_the_fir_place() void {
    strbuf.str_buf mut got = strbuf.create();
    defer del(got.data);
    lower_env.env mut* own e = lower_env.make();
    defer lower_env.drop_made(move(e));
    fir.module mut* own m = pass_env.parse_made(e, PRELUDE[..], TEXT[..]);
    defer fir.module_drop_made(move(m));
    report_text(e, m, &got);
    expect_lines(strbuf.view(&got), "t.fir", TEXT_REPORTED[..]);
}

// Appends the lines of the report of the function of `m` to `out`.
fn report_text(lower_env.env mut* e, fir.module* m, strbuf.str_buf mut* out) void {
    fir.func* f = fir.module_function_at(m, 0);
    pass_env.verified(e, f, "prover_whole_test: the verifier refuses the input");
    prover.proof mut* own p = prover.prove_made(f);
    defer prover.drop_made(move(p));
    assert(p->wholes.len == 4 && p->whole_leaks == 4);
    report.write_wholes(f, p, &e->c.m.s, out);
}

fn main() i32 {
    each_whole_store_holds_the_owners_below_it();
    println("whole stores ok");
    each_whole_store_of_lowered_source_has_its_verdict();
    println("whole source ok");
    the_whole_store_work_has_a_limit_of_its_own();
    println("whole work ok");
    the_report_names_the_first_owner_of_each_store();
    println("whole report ok");
    the_report_of_a_fir_text_names_the_fir_place();
    println("whole text ok");
    return 0;
}
