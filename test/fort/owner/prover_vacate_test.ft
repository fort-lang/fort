    "        del(move _1) #6:3;",
    "        del(move _2) #6:4;",
    "        dead(_2) #7:1;",
    "        dead(_1) #7:1;",
    "        return #7:1;",
    "    }",
    "}",
    // A `move` of the field `t.extra` keeps the fact of an element of `t.rows`: the two fields are
    // separate.
    "fn main.separate_kept() -> u64 {",
    "    let _1 (t): tab;",
    "    let _2: row mut* own;",
    "    let _3: row mut@ own;",
    "    let _4: u64;",
    "    let _5 (first): row mut@ own;",
    "    let _6: row mut* own;",
    "    let _7: row mut@ own;",
    "    let _8: u8 mut* own;",
    "    bb0: {",
    "        _1 = const zero tab #1:1;",
    "        _5 = const zero row mut@ own #1:2;",
    "        live(_1) #1:1;",
    "        _2 = alloc<row>(const u64 2) #2:1;",
