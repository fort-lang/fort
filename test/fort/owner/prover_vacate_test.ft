    "    }",
    "    bb1: {",
    "        _1.0 = move _3 #2:2;",
    "        live(_2) #3:1;",
    "        _2 = move _1 #3:1;",
    "        _4 = alloc<u8>(const u64 1) #4:1;",
    "        check(overwrite: _1.0) -> bb2 #4:2;",
    "    }",
    "    bb2: {",
    "        _1.0 = move _4 #4:2;",
    "        _0 = const u64 0 #5:1;",
    "        del(move _1.0) #6:1;",
    "        del(move _2.0) #6:2;",
    "        del(move _2.1) #6:3;",
    "        dead(_2) #7:1;",
    "        dead(_1) #7:1;",
    "        return #7:1;",
    "    }",
    "}",
    // A `move` of a field through the pointer `w` keeps the fact of a field through the fresh
    // pointer `v`: the `field` step after the deref leaves no storage, and `v` is no memory.
    "fn main.other_base_kept() -> u64 {",
    "    let _1 (v): pair mut* own;",
    "    let _2 (w): pair mut* own;",
    "    let _3: u8 mut* own;",
    "    let _4: u8 mut* own;",
    "    bb0: {",
    "        _1 = const null pair mut* own #1:1;",
    "        _2 = const null pair mut* own #1:2;",
    "        live(_1) #1:1;",
    "        live(_2) #1:2;",
    "        _1 = alloc<pair>(const u64 1) #2:1;",
    "        _2 = alloc<pair>(const u64 1) #2:2;",
    "        _3 = move (*_2).1 #3:1;",
