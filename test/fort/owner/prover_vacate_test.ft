    "        _5 = move (*_1).0[_4].0 #3:1;",
    "        _6 = alloc<u8>(const u64 1) #4:1;",
    "        check(overwrite: (*_1).1) -> bb2 #4:2;",
    "    }",
    "    bb2: {",
    "        (*_1).1 = move _6 #4:2;",
    "        _0 = copy (*_1).0.1 #5:1;",
    "        del(move _5) #6:1;",
    "        del(move (*_1).1) #6:2;",
    "        del(move (*_1).0[_4].0) #6:3;",
    "        del(move (*_1).0) #6:4;",
    "        del(move _1) #6:5;",
    "        dead(_5) #7:1;",
    "        dead(_1) #7:1;",
    "        return #7:1;",
    "    }",
    "}",
    // `top[0].sub[0].sub[0].sub = new(row, 1)` after a `move` of the same place. The place has a
    // second index on a span after `top[0].sub`, so the `move` can write `top[0].sub` and ends the
