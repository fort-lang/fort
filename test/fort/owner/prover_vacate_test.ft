    "        check(overwrite: _1[_4].0[_4].0[_4].0) -> bb4 #4:2;",
    "    }",
    "    bb4: {",
    "        _1[_4].0[_4].0[_4].0 = move _10 #4:2;",
    "        _0 = copy _1[_4].0[_4].0[_4].0.1 #5:1;",
    "        del(move _11) #6:1;",
    "        del(move _12) #6:1;",
    "        del(move _1[_4].0[_4].0[_4].0) #6:2;",
    "        del(move _1[_4].0[_4].0) #6:3;",
    "        del(move _1[_4].0) #6:4;",
    "        del(move _1) #6:5;",
    "        dead(_1) #7:1;",
    "        return #7:1;",
    "    }",
    "}",
};

// The prover proves each store, and the run of `view_grown` reads released storage. `grow` takes
// a view `v` and its text holds no owner of the object that `v` names. Its caller makes the span
// own itself through `v`: `v->sub` is a slot of the storage of `top` and takes `top`. Then
// `v->sub[0].sub` is that slot, the `regrow` releases the storage, and the destination
// `v->sub[0].other` lies in it. No rule of the kill reads the text of a caller. The store through
// the view has a result of dead storage (D10.9): the interpreter changes only dead storage, and
// the run goes on.
string[68] VIEWS = {
    "fn main.grow(_1 (v): duo mut*) -> void {",
    "    let _2 (second): duo mut@ own;",
    "    let _3: u64;",
    "    let _4: duo mut@ own mut*;",
    "    let _5: duo mut@ own;",
    "    let _6: duo mut* own;",
    "    let _7: duo mut@ own;",
    "    bb0: {",
    "        _2 = const zero duo mut@ own #1:1;",
    "        live(_2) #1:1;",
    "        _3 = const u64 0 #2:1;",
    "        _2 = move (*_1).0[_3].1 #2:2;",
    "        _4 = addr mut((*_1).0[_3].1) #3:1;",
    "        _5 = move (*_1).0[_3].0 #3:2;",
    "        _6 = regrow<duo>(move _5, const u64 2) #3:2;",
    "        _7 = aggregate duo mut@ own(move _6, const u64 2) #3:2;",
    "        check(overwrite: (*_4)) -> bb1 #3:3;",
    "    }",
    "    bb1: {",
    "        (*_4) = move _7 #3:3;",
    "        del(move _2) #4:1;",
    "        dead(_2) #5:1;",
    "        return #5:1;",
    "    }",
    "}",
    "fn main.view_grown() -> u64 {",
    "    let _1 (top): duo mut@ own;",
    "    let _2 (v): duo mut*;",
    "    let _3 (first): duo mut@ own;",
    "    let _4: duo mut* own;",
    "    let _5: duo mut@ own;",
    "    let _6: u64;",
    "    let _7: duo mut@ own mut*;",
    "    let _8: duo mut@ own;",
    "    let _9: void;",
    "    let _10: duo mut*;",
    "    bb0: {",
    "        _1 = const zero duo mut@ own #6:1;",
    "        _3 = const zero duo mut@ own #6:2;",
    "        live(_1) #6:1;",
    "        _4 = alloc<duo>(const u64 1) #7:1;",
    "        _5 = aggregate duo mut@ own(move _4, const u64 1) #7:1;",
    "        check(overwrite: _1) -> bb1 #7:2;",
    "    }",
    "    bb1: {",
    "        _1 = move _5 #7:2;",
    "        _6 = const u64 0 #7:3;",
    "        _10 = addr mut(_1[_6]) #8:1;",
    "        live(_2) #8:1;",
    "        _2 = copy _10 #8:1;",
    "        live(_3) #8:2;",
    "        _3 = move (*_2).0 #8:2;",
    "        _7 = addr mut((*_2).0) #9:1;",
    "        _8 = move _1 #9:2;",
    "        check(overwrite: (*_7)) -> bb2 #9:3;",
    "    }",
    "    bb2: {",
    "        (*_7) = move _8 #9:3;",
    "        _9 = call fn main.grow(copy _2) #10:1;",
    "        _0 = const u64 0 #11:1;",
    "        del(move _3) #12:1;",
    "        del(move _1) #12:2;",
    "        dead(_3) #13:1;",
    "        dead(_2) #13:1;",
    "        dead(_1) #13:1;",
    "        return #13:1;",
    "    }",
    "}",
};

// The counts of the last line of the output.
struct tally {
    u64 cases;
    u64 proved;
    u64 refused;
    u64 events;
}

// The function `name` of `m`. run_env.function panics for a name that `m` lacks.
fn function(run_env.env* e, fir.module* m, string name) fir.func* {
    u64 mut k = 0;
    while (k + 1 < fir.module_function_count(m)) {
        if (fir.module_function_at(m, k)->sym == run_env.function(e, m, name)) {
            return fir.module_function_at(m, k);
        }
        k += 1;
    }
    return fir.module_function_at(m, k);
}

// Proves the function `name` of `m`, writes each line of the three reports as `<severity>
// <line>:<col>: <text>` and then the lines of the whole-store report, runs the function `entry`
// with the events of the shadow, and holds these lines and then the report of the run against
// `want`.
fn holds_from(run_env.env mut* e, fir.module* m, tally mut* t, string name, string entry,
              string@ want) void {
    strbuf.str_buf mut got = strbuf.create();
    defer del(got.data);
    u64[1] none = {0};
    fir.func* f = function(e, m, name);
    prover.proof mut* own p = prover.prove_made(f);
    defer prover.drop_made(move(p));
    u64 before = check_env.reports(&e->c);
    report.write(f, p, &e->c.m.s);
    report.write_leaks(f, p, &e->c.m.s);
    report.write_uses(f, p, &e->c.m.s);
    u64 after = check_env.reports(&e->c);
    u64 mut r = before;
    while (r < after) {
        strbuf.append(&got, check_env.report_severity(&e->c, r));
        strbuf.push(&got, ' ');
        strbuf.append(&got, check_env.report_text(&e->c, r));
        strbuf.push(&got, '\n');
        r += 1;
    }
    u64 lines = got.len;
    report.write_wholes(f, p, &e->c.m.s, &got);
    string run = run_env.run_in(e, m, entry, none[..0]);
    t->cases += 1;
    if (after == before && got.len == lines) {
        t->proved += 1;
    } else {
        t->refused += 1;
    }
    if (run.len >= 6 && run[0..6] == "event ") {
        t->events += 1;
    }
    strbuf.append(&got, run);
    run_env.expect(strbuf.view(&got), want);
}

// holds_from for a function that the run starts at.
fn holds(run_env.env mut* e, fir.module* m, tally mut* t, string name, string@ want) void {
    holds_from(e, m, t, name, name, want);
}

fn ended(run_env.env mut* e, tally mut* t) void {
    // A new check drops the reports of the group before: a text parses against a check with no
    // report only.
    run_env.check(e, PRELUDE[..]);
    e->events = true;
    fir.module mut* own m = run_env.parse_made(e, ENDED[..]);
    defer fir.module_drop_made(move(m));
    string[3] index_moved = {
        "error 3:3: overwriting owned value: cannot prove '(*_6)' is empty here",
        "note 3:3: del or move '(*_6)' before this store",
        "return u64 0",
    };
    holds(e, m, t, "main.index_moved", index_moved[..]);
    string[4] index_regrown = {
        "error 3:3: overwriting owned value: cannot prove '(*_6)' is empty here",
        "note 3:3: del or move '(*_6)' before this store",
        "event use after release in main.index_regrown at 3:3 through owner main.index_regrown _1",
        "return u64 0",
    };
    holds(e, m, t, "main.index_regrown", index_regrown[..]);
    string[5] whole_regrown = {
        "t.fir:3:3: overwriting owned value: cannot prove '(*_6).0' is empty here",
        "t.fir:3:3: note: del or move '(*_6).0' before this store",
        "t.fir:3:3: note: cause 4: no fact proves that the owner is empty",
        "event use after release in main.whole_regrown at 3:3 through owner main.whole_regrown _1",
        "return u64 0",
    };
    holds(e, m, t, "main.whole_regrown", whole_regrown[..]);
    string[5] deref_moved = {
        "error 3:3: overwriting owned value: cannot prove '(*_2)' is empty here",
        "note 3:3: del or move '(*_2)' before this store",
        "error 7:1: leak: cannot prove 'p' is empty at this exit",
        "note 7:1: del or move 'p' before this exit",
        "return u64 0",
    };
    holds(e, m, t, "main.deref_moved", deref_moved[..]);
    string[6] deref_deleted = {
        "error 3:3: overwriting owned value: cannot prove '(*_2)' is empty here",
        "note 3:3: del or move '(*_2)' before this store",
        "error 7:1: leak: cannot prove 'p' is empty at this exit",
        "note 7:1: del or move 'p' before this exit",
        "event use after release in main.deref_deleted at 3:3 through owner main.deref_deleted _1",
        "return u64 0",
    };
    holds(e, m, t, "main.deref_deleted", deref_deleted[..]);
    string[4] view_moved = {
        "error 3:3: overwriting owned value: cannot prove '(*_6)' is empty here",
        "note 3:3: del or move '(*_6)' before this store",
        "event use after release in main.view_moved at 3:3",
        "return u64 0",
    };
    holds(e, m, t, "main.view_moved", view_moved[..]);
    string[4] self_moved = {
        "error 3:3: overwriting owned value: cannot prove '(*_6)' is empty here",
        "note 3:3: del or move '(*_6)' before this store",
        "event use after release in main.self_moved at 3:3 through owner main.self_moved _1",
        "return u64 0",
    };
    holds(e, m, t, "main.self_moved", self_moved[..]);
    string[4] bare_regrown = {
        "error 3:3: overwriting owned value: cannot prove '(*_6)' is empty here",
        "note 3:3: del or move '(*_6)' before this store",
        "event use after release in main.bare_regrown at 3:3 through owner main.bare_regrown _1",
        "return u64 0",
    };
    holds(e, m, t, "main.bare_regrown", bare_regrown[..]);
    string[4] key_regrown = {
        "error 3:3: overwriting owned value: cannot prove '(*_6)' is empty here",
        "note 3:3: del or move '(*_6)' before this store",
        "event use after release in main.key_regrown at 3:3 through owner main.key_regrown _1",
        "return u64 0",
    };
    holds(e, m, t, "main.key_regrown", key_regrown[..]);
    string[4] header_moved = {
        "error 3:3: overwriting owned value: cannot prove '(*_6)' is empty here",
        "note 3:3: del or move '(*_6)' before this store",
        "event use after release in main.header_moved at 3:3 through owner main.header_moved _1",
        "return u64 1",
    };
    holds(e, m, t, "main.header_moved", header_moved[..]);
    string[4] struct_moved = {
        "error 3:3: overwriting owned value: cannot prove '(*_6)' is empty here",
        "note 3:3: del or move '(*_6)' before this store",
        "event use after release in main.struct_moved at 3:3 through owner main.struct_moved _1",
        "return u64 0",
    };
    holds(e, m, t, "main.struct_moved", struct_moved[..]);
    string[4] span_moved = {
        "error 3:3: overwriting owned value: cannot prove '(*_6)' is empty here",
        "note 3:3: del or move '(*_6)' before this store",
        "event use after release in main.span_moved at 3:3",
        "return u64 0",
    };
    holds(e, m, t, "main.span_moved", span_moved[..]);
    string[5] next_moved = {
        "error 3:3: overwriting owned value: cannot prove '(*_1).0[_8]' is empty here",
        "note 3:3: del or move '(*_1).0[_8]' before this store",
        "event leak in main.next_moved at 3:1",
        "event use after release in main.next_moved at 3:3 through owner main.next_moved _5",
        "return u64 0",
    };
    holds(e, m, t, "main.next_moved", next_moved[..]);
    string[4] other_moved = {
        "error 3:3: overwriting owned value: cannot prove '(*_6)' is empty here",
        "note 3:3: del or move '(*_6)' before this store",
        "event use after release in main.other_moved at 3:3 through owner main.other_moved _1",
        "return u64 0",
    };
    holds(e, m, t, "main.other_moved", other_moved[..]);
}

fn kept(run_env.env mut* e, tally mut* t) void {
    // A new check drops the reports of the group before: a text parses against a check with no
    // report only.
    run_env.check(e, PRELUDE[..]);
    e->events = true;
    fir.module mut* own m = run_env.parse_made(e, KEPT[..]);
    defer fir.module_drop_made(move(m));
    string[1] field_kept = {
        "return u64 0",
    };
    holds(e, m, t, "main.field_kept", field_kept[..]);
    string[1] other_base_kept = {
        "return u64 0",
    };
    holds(e, m, t, "main.other_base_kept", other_base_kept[..]);
    string[1] separate_kept = {
        "return u64 2",
    };
    holds(e, m, t, "main.separate_kept", separate_kept[..]);
    string[1] element_kept = {
        "return u64 2",
    };
    holds(e, m, t, "main.element_kept", element_kept[..]);
    string[1] local_kept = {
        "return u64 2",
    };
    holds(e, m, t, "main.local_kept", local_kept[..]);
    string[1] swap_kept = {
        "return u64 1",
    };
    holds(e, m, t, "main.swap_kept", swap_kept[..]);
    string[1] del_kept = {
        "return u64 1",
    };
    holds(e, m, t, "main.del_kept", del_kept[..]);
}

fn views(run_env.env mut* e, tally mut* t) void {
    // A new check drops the reports of the group before: a text parses against a check with no
    // report only.
    run_env.check(e, PRELUDE[..]);
    e->events = true;
    fir.module mut* own m = run_env.parse_made(e, VIEWS[..]);
    defer fir.module_drop_made(move(m));
    // The run starts at the caller for both functions: `grow` takes a pointer.
    string[2] view_grown = {
        "event use after release in main.grow at 3:3",
        "return u64 0",
    };
    holds_from(e, m, t, "main.grow", "main.view_grown", view_grown[..]);
    holds(e, m, t, "main.view_grown", view_grown[..]);
}

fn main() i32 {
    run_env.env mut* own e = run_env.make();
    defer run_env.drop_made(move(e));
    tally mut t = {};
    ended(e, &t);
    println("ended ok");
    kept(e, &t);
    println("kept ok");
    views(e, &t);
    println("views ok");
    println("cases ", t.cases, " proved ", t.proved, " refused ", t.refused, " events ", t.events);
    return 0;
}
