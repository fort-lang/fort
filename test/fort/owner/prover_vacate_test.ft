    "    }",
    "    bb1: {",
    "        _1.0 = move _3 #2:2;",
    "        _4 = const u64 0 #2:3;",
    "        live(_5) #2:4;",
    "        _5 = move _1.0[_4].0 #2:4;",
    "        _8 = move _1.1 #3:1;",
