    "fn main.local_kept() -> u64 {",
    "    let _1 (t): tab mut* own;",
    "    let _2: row mut* own;",
    "    let _3: row mut@ own;",
    "    let _4: u64;",
    "    let _5 (first): row mut@ own;",
    "    let _6: u8 mut* own;",
    "    bb0: {",
    "        _1 = const null tab mut* own #1:1;",
    "        _5 = const zero row mut@ own #1:2;",
    "        live(_1) #1:1;",
    "        _1 = alloc<tab>(const u64 1) #2:1;",
    "        _2 = alloc<row>(const u64 2) #2:2;",
    "        _3 = aggregate row mut@ own(move _2, const u64 2) #2:2;",
