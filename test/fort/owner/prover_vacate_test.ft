//! run
//! flags: -I ../../src -I support
//! stdout:
//| ended ok
//| kept ok
//| views ok
//| cases 23 proved 9 refused 14 events 14
/// Checks the kill at a vacate of owner.prover (spec/fir.md 11): a statement that vacates an owner,
/// a `move` of it or a `del` of it, ends each fact of a place whose path can read that owner. Each
/// case is one function of FIR text. The test holds the lines that the prover reports for it, then
/// the lines of the whole-store report, then the report of the interpreter with its events.
///
/// The last line of the output counts the cases, those with 0 lines of the prover, those with a
/// line, and those with an event. A case that the prover refuses with no event has a store into
/// storage that is not released: its harm is an owner that holds its own storage, which no exit
/// releases. The 2 cases that the prover proves with an event are the group `VIEWS`: their store
/// goes through a view of storage that the vacate releases, and D10.9 gives the result of that
/// access.
import check_env;
import fort.fir;
import fort.owner.prover;
import fort.owner.report;
import run_env;
import std.strbuf;

// The structs that the FIR text names. `row` holds an `own` span of its own type, so a span of
// rows can go into an element of its own storage.
string[36] PRELUDE = {
    "struct row {",
    "    row mut@ own sub;",
    "    u64 tag;",
    "}",
    "struct node {",
    "    node mut* own next;",
    "    u64 tag;",
    "}",
    "struct pair {",
    "    u8 mut* own left;",
    "    u8 mut* own right;",
    "}",
    "struct tab {",
    "    row mut@ own rows;",
    "    u8 mut* own extra;",
    "}",
    "struct knot {",
    "    knot mut* back;",
    "    knot mut@ own kids;",
    "}",
    "struct ring {",
    "    ring mut@ own mut* self;",
    "    ring mut@ own kids;",
    "}",
    "struct hub {",
    "    hub mut@ up;",
    "    hub mut@ own kids;",
    "}",
    "struct duo {",
    "    duo mut@ own sub;",
    "    duo mut@ own other;",
    "}",
    "struct cell {",
    "    cell mut* own mut@ own slots;",
    "    cell mut* own next;",
    "}",
};

// A statement vacates an owner between the `addr` of the destination and the store, and the path
// of the destination reads that owner. The fact of the destination ends, so the prover does not
// prove the store.
string[558] ENDED = {
    // `top[0].sub = move(top)`: the lowering holds the address of the element before the `move`,
    // and the `move` of `top` ends the fact of the element, which lies in the storage that `top`
    // owned.
    "fn main.index_moved() -> u64 {",
    "    let _1 (top): row mut@ own;",
    "    let _2: row mut* own;",
    "    let _3: row mut@ own;",
    "    let _4: u64;",
    "    let _5 (first): row mut@ own;",
    "    let _6: row mut@ own mut*;",
    "    let _7: row mut@ own;",
    "    bb0: {",
    "        _1 = const zero row mut@ own #1:1;",
    "        _5 = const zero row mut@ own #1:2;",
    "        live(_1) #1:1;",
    "        _2 = alloc<row>(const u64 1) #2:1;",
    "        _3 = aggregate row mut@ own(move _2, const u64 1) #2:1;",
    "        check(overwrite: _1) -> bb1 #2:2;",
    "    }",
    "    bb1: {",
    "        _1 = move _3 #2:2;",
    "        _4 = const u64 0 #2:3;",
    "        live(_5) #2:4;",
    "        _5 = move _1[_4].0 #2:4;",
    "        _6 = addr mut(_1[_4].0) #3:1;",
    "        _7 = move _1 #3:2;",
    "        check(overwrite: (*_6)) -> bb2 #3:3;",
    "    }",
    "    bb2: {",
    "        (*_6) = move _7 #3:3;",
    "        _0 = copy _1.1 #5:1;",
    "        del(move _5) #6:1;",
    "        del(move _1) #6:2;",
    "        dead(_5) #7:1;",
    "        dead(_1) #7:1;",
    "        return #7:1;",
    "    }",
    "}",
    // `top[0].sub = regrow(move(top), 2)`: the same store with a `regrow`, which releases the
    // storage of the element.
    "fn main.index_regrown() -> u64 {",
    "    let _1 (top): row mut@ own;",
    "    let _2: row mut* own;",
    "    let _3: row mut@ own;",
    "    let _4: u64;",
    "    let _5 (first): row mut@ own;",
    "    let _6: row mut@ own mut*;",
    "    let _7: row mut@ own;",
    "    let _8: row mut* own;",
    "    let _9: row mut@ own;",
    "    bb0: {",
    "        _1 = const zero row mut@ own #1:1;",
    "        _5 = const zero row mut@ own #1:2;",
    "        live(_1) #1:1;",
    "        _2 = alloc<row>(const u64 1) #2:1;",
    "        _3 = aggregate row mut@ own(move _2, const u64 1) #2:1;",
    "        check(overwrite: _1) -> bb1 #2:2;",
    "    }",
    "    bb1: {",
    "        _1 = move _3 #2:2;",
    "        _4 = const u64 0 #2:3;",
    "        live(_5) #2:4;",
    "        _5 = move _1[_4].0 #2:4;",
    "        _6 = addr mut(_1[_4].0) #3:1;",
    "        _7 = move _1 #3:2;",
    "        _8 = regrow<row>(move _7, const u64 2) #3:2;",
    "        _9 = aggregate row mut@ own(move _8, const u64 2) #3:2;",
    "        check(overwrite: (*_6)) -> bb2 #3:3;",
    "    }",
    "    bb2: {",
    "        (*_6) = move _9 #3:3;",
    "        _0 = copy _1.1 #5:1;",
    "        del(move _5) #6:1;",
    "        del(move _1) #6:2;",
    "        dead(_5) #7:1;",
    "        dead(_1) #7:1;",
    "        return #7:1;",
    "    }",
    "}",
    // `top[0] = row{regrow(move(top), 2), 9}`: the whole store of the element. A whole store that
    // the prover does not prove is a line of the whole-store report and no error (D17.11).
    "fn main.whole_regrown() -> u64 {",
    "    let _1 (top): row mut@ own;",
    "    let _2: row mut* own;",
    "    let _3: row mut@ own;",
    "    let _4: u64;",
    "    let _5 (first): row mut@ own;",
    "    let _6: row mut*;",
    "    let _7: row mut@ own;",
    "    let _8: row mut* own;",
    "    let _9: row mut@ own;",
    "    bb0: {",
    "        _1 = const zero row mut@ own #1:1;",
    "        _5 = const zero row mut@ own #1:2;",
    "        live(_1) #1:1;",
    "        _2 = alloc<row>(const u64 1) #2:1;",
    "        _3 = aggregate row mut@ own(move _2, const u64 1) #2:1;",
    "        check(overwrite: _1) -> bb1 #2:2;",
    "    }",
    "    bb1: {",
    "        _1 = move _3 #2:2;",
    "        _4 = const u64 0 #2:3;",
    "        live(_5) #2:4;",
    "        _5 = move _1[_4].0 #2:4;",
    "        _6 = addr mut(_1[_4]) #3:1;",
    "        _7 = move _1 #3:2;",
    "        _8 = regrow<row>(move _7, const u64 2) #3:2;",
    "        _9 = aggregate row mut@ own(move _8, const u64 2) #3:2;",
    "        (*_6) = aggregate row(move _9, const u64 9) #3:3;",
    "        _0 = copy _1.1 #5:1;",
    "        del(move _5) #6:1;",
    "        del(move _1) #6:2;",
    "        dead(_5) #7:1;",
    "        dead(_1) #7:1;",
    "        return #7:1;",
    "    }",
    "}",
    // `p->next = move(p)`: a deref step. The `move` of `p` ends the fact of `p->next`, which the
    // fresh `new` gave.
    "fn main.deref_moved() -> u64 {",
    "    let _1 (p): node mut* own;",
    "    let _2: node mut* own mut*;",
    "    let _3: node mut* own;",
    "    bb0: {",
    "        _1 = const null node mut* own #1:1;",
    "        live(_1) #1:1;",
    "        _1 = alloc<node>(const u64 1) #2:1;",
    "        _2 = addr mut((*_1).0) #3:1;",
    "        _3 = move _1 #3:2;",
    "        check(overwrite: (*_2)) -> bb1 #3:3;",
    "    }",
    "    bb1: {",
    "        (*_2) = move _3 #3:3;",
    "        _0 = const u64 0 #5:1;",
    "        dead(_1) #7:1;",
    "        return #7:1;",
    "    }",
    "}",
    // A `del` of `p` between the `addr` and the store: only FIR text holds it. The `del` vacates
    // `p` as a `move` does, and the store through the address writes released storage.
    "fn main.deref_deleted() -> u64 {",
    "    let _1 (p): node mut* own;",
    "    let _2: node mut* own mut*;",
    "    let _3: node mut* own;",
    "    bb0: {",
    "        _1 = const null node mut* own #1:1;",
    "        live(_1) #1:1;",
    "        _1 = alloc<node>(const u64 1) #2:1;",
    "        _3 = alloc<node>(const u64 1) #2:2;",
    "        _2 = addr mut((*_1).0) #3:1;",
    "        del(move _1) #3:2;",
    "        check(overwrite: (*_2)) -> bb1 #3:3;",
    "    }",
    "    bb1: {",
    "        (*_2) = move _3 #3:3;",
    "        _0 = const u64 0 #5:1;",
    "        dead(_1) #7:1;",
    "        return #7:1;",
    "    }",
    "}",
    // The element holds a view `back` of the object that owns its span, and the `move` goes
    // through that view. After a second deref a place can name any storage, so the `move` ends the
    // fact of the element.
    "fn main.view_moved() -> u64 {",
    "    let _1 (n): knot mut* own;",
    "    let _2: knot mut* own;",
    "    let _3: knot mut@ own;",
    "    let _4: u64;",
    "    let _5 (old): knot mut@ own;",
    "    let _6: knot mut@ own mut*;",
    "    let _7: knot mut@ own;",
    "    let _8: knot mut* own;",
    "    let _9: knot mut@ own;",
    "    bb0: {",
    "        _1 = const null knot mut* own #1:1;",
    "        _5 = const zero knot mut@ own #1:2;",
    "        live(_1) #1:1;",
    "        _1 = alloc<knot>(const u64 1) #2:1;",
    "        _2 = alloc<knot>(const u64 1) #2:2;",
    "        _3 = aggregate knot mut@ own(move _2, const u64 1) #2:2;",
    "        check(overwrite: (*_1).1) -> bb1 #2:3;",
    "    }",
    "    bb1: {",
    "        (*_1).1 = move _3 #2:3;",
    "        _4 = const u64 0 #2:4;",
    "        (*_1).1[_4].0 = copy _1 #2:5;",
    "        live(_5) #2:6;",
    "        _5 = move (*_1).1[_4].1 #2:6;",
    "        _6 = addr mut((*_1).1[_4].1) #3:1;",
    "        _7 = move (*(*_1).1[_4].0).1 #3:2;",
    "        _8 = regrow<knot>(move _7, const u64 2) #3:2;",
    "        _9 = aggregate knot mut@ own(move _8, const u64 2) #3:2;",
    "        check(overwrite: (*_6)) -> bb2 #3:3;",
    "    }",
    "    bb2: {",
    "        (*_6) = move _9 #3:3;",
    "        _0 = const u64 0 #5:1;",
    "        del(move _5) #6:1;",
    "        del(move (*_1).1) #6:2;",
    "        del(move _1) #6:3;",
    "        dead(_5) #7:1;",
    "        dead(_1) #7:1;",
    "        return #7:1;",
    "    }",
    "}",
    // The element holds the address of the local `n` that owns its span, and the `move` goes
    // through that address. `n` is memory, so a place through a second deref can be `n`.
    "fn main.self_moved() -> u64 {",
    "    let _1 (n): ring mut@ own;",
    "    let _2: ring mut* own;",
    "    let _3: ring mut@ own;",
    "    let _4: u64;",
    "    let _5 (old): ring mut@ own;",
    "    let _6: ring mut@ own mut*;",
    "    let _7: ring mut@ own;",
    "    let _8: ring mut* own;",
    "    let _9: ring mut@ own;",
    "    let _10: ring mut@ own mut*;",
    "    bb0: {",
    "        _1 = const zero ring mut@ own #1:1;",
    "        _5 = const zero ring mut@ own #1:2;",
    "        live(_1) #1:1;",
    "        _2 = alloc<ring>(const u64 1) #2:1;",
    "        _3 = aggregate ring mut@ own(move _2, const u64 1) #2:1;",
    "        check(overwrite: _1) -> bb1 #2:2;",
    "    }",
    "    bb1: {",
    "        _1 = move _3 #2:2;",
    "        _4 = const u64 0 #2:3;",
    "        _10 = addr mut(_1) #2:4;",
    "        _1[_4].0 = copy _10 #2:4;",
    "        live(_5) #2:5;",
    "        _5 = move _1[_4].1 #2:5;",
    "        _6 = addr mut(_1[_4].1) #3:1;",
    "        _7 = move (*_1[_4].0) #3:2;",
    "        _8 = regrow<ring>(move _7, const u64 2) #3:2;",
    "        _9 = aggregate ring mut@ own(move _8, const u64 2) #3:2;",
    "        check(overwrite: (*_6)) -> bb2 #3:3;",
    "    }",
    "    bb2: {",
    "        (*_6) = move _9 #3:3;",
    "        _0 = const u64 0 #5:1;",
    "        del(move _5) #6:1;",
    "        del(move _1) #6:2;",
    "        dead(_5) #7:1;",
    "        dead(_1) #7:1;",
    "        return #7:1;",
    "    }",
    "}",
    // The operand of the `regrow` is the place `top` itself and no temporary: only FIR text holds
    // it. The `regrow` vacates `top` as a `move` does.
    "fn main.bare_regrown() -> u64 {",
    "    let _1 (top): row mut@ own;",
    "    let _2: row mut* own;",
    "    let _3: row mut@ own;",
    "    let _4: u64;",
    "    let _5 (first): row mut@ own;",
    "    let _6: row mut@ own mut*;",
    "    let _7: row mut* own;",
    "    let _8: row mut@ own;",
    "    bb0: {",
    "        _1 = const zero row mut@ own #1:1;",
    "        _5 = const zero row mut@ own #1:2;",
    "        live(_1) #1:1;",
    "        _2 = alloc<row>(const u64 1) #2:1;",
    "        _3 = aggregate row mut@ own(move _2, const u64 1) #2:1;",
    "        check(overwrite: _1) -> bb1 #2:2;",
    "    }",
    "    bb1: {",
    "        _1 = move _3 #2:2;",
    "        _4 = const u64 0 #2:3;",
    "        live(_5) #2:4;",
    "        _5 = move _1[_4].0 #2:4;",
    "        _6 = addr mut(_1[_4].0) #3:1;",
    "        _7 = regrow<row>(move _1, const u64 2) #3:2;",
    "        _8 = aggregate row mut@ own(move _7, const u64 2) #3:2;",
    "        check(overwrite: (*_6)) -> bb2 #3:3;",
    "    }",
    "    bb2: {",
    "        (*_6) = move _8 #3:3;",
    "        _0 = copy _1.1 #5:1;",
    "        del(move _5) #6:1;",
    "        del(move _1) #6:2;",
    "        dead(_5) #7:1;",
    "        dead(_1) #7:1;",
    "        return #7:1;",
    "    }",
    "}",
    // `a[i].rows[0].sub = regrow(move(a[j].rows), 2)` with `i` and `j` equal at the run: two keys
    // can name one element of a fixed array, so the `move` of `a[j].rows` ends the fact of a place
    // below `a[i].rows`.
    "fn main.key_regrown() -> u64 {",
    "    let _1 (a): tab[2];",
    "    let _2: row mut* own;",
    "    let _3: row mut@ own;",
    "    let _4 (i): u64;",
    "    let _5 (first): row mut@ own;",
    "    let _6: row mut@ own mut*;",
    "    let _7: row mut@ own;",
    "    let _8: row mut* own;",
    "    let _9: row mut@ own;",
    "    let _10 (j): u64;",
    "    let _11: u64;",
    "    let _12: u64;",
    "    let _13: u64;",
    "    bb0: {",
    "        _1 = const zero tab[2] #1:1;",
    "        _5 = const zero row mut@ own #1:2;",
    "        live(_1) #1:1;",
    "        live(_4) #1:3;",
    "        _4 = const u64 0 #1:3;",
    "        live(_10) #1:4;",
    "        _10 = const u64 0 #1:4;",
    "        _2 = alloc<row>(const u64 1) #2:1;",
    "        _3 = aggregate row mut@ own(move _2, const u64 1) #2:1;",
    "        _12 = const u64 0 #2:2;",
    "        check(overwrite: _1[_12].0) -> bb1 #2:2;",
    "    }",
    "    bb1: {",
    "        _1[_12].0 = move _3 #2:2;",
    "        _11 = const u64 0 #2:3;",
    "        live(_5) #2:4;",
    "        _5 = move _1[_4].0[_11].0 #2:4;",
    "        _6 = addr mut(_1[_4].0[_11].0) #3:1;",
    "        _7 = move _1[_10].0 #3:2;",
    "        _8 = regrow<row>(move _7, const u64 2) #3:2;",
    "        _9 = aggregate row mut@ own(move _8, const u64 2) #3:2;",
    "        check(overwrite: (*_6)) -> bb2 #3:3;",
    "    }",
    "    bb2: {",
    "        (*_6) = move _9 #3:3;",
    "        _0 = copy _1[_12].0.1 #5:1;",
    "        del(move _5) #6:1;",
    "        del(move _1[_12].0) #6:2;",
    "        _13 = const u64 1 #6:3;",
    "        del(move _1[_13].0) #6:3;",
    "        del(move _1[_12].1) #6:4;",
    "        del(move _1[_13].1) #6:5;",
    "        dead(_5) #7:1;",
    "        dead(_10) #7:1;",
    "        dead(_4) #7:1;",
    "        dead(_1) #7:1;",
    "        return #7:1;",
    "    }",
    "}",
    // A `move` of field 0 of the header of `top`, then a `del` of the pointer: only FIR text holds
    // it. The header owns the storage of the element no more, so the fact of the element ends.
    "fn main.header_moved() -> u64 {",
    "    let _1 (top): row mut@ own;",
    "    let _2: row mut* own;",
    "    let _3: row mut@ own;",
    "    let _4: u64;",
    "    let _5 (first): row mut@ own;",
    "    let _6: row mut@ own mut*;",
    "    let _7: row mut* own;",
    "    let _8: row mut* own;",
    "    let _9: row mut@ own;",
    "    bb0: {",
    "        _1 = const zero row mut@ own #1:1;",
    "        _5 = const zero row mut@ own #1:2;",
    "        live(_1) #1:1;",
    "        _2 = alloc<row>(const u64 1) #2:1;",
    "        _3 = aggregate row mut@ own(move _2, const u64 1) #2:1;",
    "        check(overwrite: _1) -> bb1 #2:2;",
    "    }",
    "    bb1: {",
    "        _1 = move _3 #2:2;",
    "        _4 = const u64 0 #2:3;",
    "        live(_5) #2:4;",
    "        _5 = move _1[_4].0 #2:4;",
    "        _6 = addr mut(_1[_4].0) #3:1;",
    "        _7 = move _1.0 #3:2;",
    "        del(move _7) #3:2;",
    "        _8 = alloc<row>(const u64 1) #3:2;",
    "        _9 = aggregate row mut@ own(move _8, const u64 1) #3:2;",
    "        check(overwrite: (*_6)) -> bb2 #3:3;",
    "    }",
    "    bb2: {",
    "        (*_6) = move _9 #3:3;",
    "        _0 = copy _1.1 #5:1;",
    "        del(move _5) #6:1;",
    "        del(move _1) #6:2;",
    "        dead(_5) #7:1;",
    "        dead(_1) #7:1;",
    "        return #7:1;",
    "    }",
    "}",
    // A `move` of the struct value `t`, then a `regrow` of the span that the value took: only FIR
    // text holds it. The `move` vacates each owner of `t`, and `t.rows` is one of them, so the fact
    // of an element of `t.rows` ends.
    "fn main.struct_moved() -> u64 {",
    "    let _1 (t): tab;",
    "    let _2: row mut* own;",
    "    let _3: row mut@ own;",
    "    let _4: u64;",
    "    let _5 (first): row mut@ own;",
    "    let _6: row mut@ own mut*;",
    "    let _7 (kept): tab;",
    "    let _8: row mut* own;",
    "    let _9: row mut@ own;",
    "    bb0: {",
    "        _1 = const zero tab #1:1;",
    "        _5 = const zero row mut@ own #1:2;",
    "        _7 = const zero tab #1:3;",
    "        live(_1) #1:1;",
    "        _2 = alloc<row>(const u64 1) #2:1;",
    "        _3 = aggregate row mut@ own(move _2, const u64 1) #2:1;",
    "        check(overwrite: _1.0) -> bb1 #2:2;",
    "    }",
    "    bb1: {",
    "        _1.0 = move _3 #2:2;",
    "        _4 = const u64 0 #2:3;",
    "        live(_5) #2:4;",
    "        _5 = move _1.0[_4].0 #2:4;",
    "        _6 = addr mut(_1.0[_4].0) #3:1;",
    "        live(_7) #3:2;",
    "        _7 = move _1 #3:2;",
    "        _8 = regrow<row>(move _7.0, const u64 2) #3:2;",
    "        _9 = aggregate row mut@ own(move _8, const u64 2) #3:2;",
    "        check(overwrite: (*_6)) -> bb2 #3:3;",
    "    }",
    "    bb2: {",
    "        (*_6) = move _9 #3:3;",
    "        _0 = const u64 0 #5:1;",
    "        del(move _5) #6:1;",
    "        del(move _7.1) #6:2;",
    "        del(move _1.0) #6:3;",
    "        del(move _1.1) #6:4;",
    "        dead(_7) #7:1;",
    "        dead(_5) #7:1;",
    "        dead(_1) #7:1;",
    "        return #7:1;",
    "    }",
    "}",
    // The element holds a view span `up` of the object that owns its span, and the `move` goes
    // through an index on that view. The index is a second reference as a deref is, so the `move`
    // ends the fact of the element.
    "fn main.span_moved() -> u64 {",
    "    let _1 (n): hub mut* own;",
    "    let _2: hub mut* own;",
    "    let _3: hub mut@ own;",
    "    let _4: u64;",
    "    let _5 (old): hub mut@ own;",
    "    let _6: hub mut@ own mut*;",
    "    let _7: hub mut@ own;",
    "    let _8: hub mut* own;",
    "    let _9: hub mut@ own;",
    "    let _10: hub mut@;",
    "    bb0: {",
    "        _1 = const null hub mut* own #1:1;",
    "        _5 = const zero hub mut@ own #1:2;",
    "        live(_1) #1:1;",
    "        _1 = alloc<hub>(const u64 1) #2:1;",
    "        _2 = alloc<hub>(const u64 1) #2:2;",
    "        _3 = aggregate hub mut@ own(move _2, const u64 1) #2:2;",
    "        check(overwrite: (*_1).1) -> bb1 #2:3;",
    "    }",
    "    bb1: {",
    "        (*_1).1 = move _3 #2:3;",
    "        _4 = const u64 0 #2:4;",
    "        _10 = aggregate hub mut@(copy _1, const u64 1) #2:5;",
    "        (*_1).1[_4].0 = copy _10 #2:5;",
    "        live(_5) #2:6;",
    "        _5 = move (*_1).1[_4].1 #2:6;",
    "        _6 = addr mut((*_1).1[_4].1) #3:1;",
    "        _7 = move (*_1).1[_4].0[_4].1 #3:2;",
    "        _8 = regrow<hub>(move _7, const u64 2) #3:2;",
    "        _9 = aggregate hub mut@ own(move _8, const u64 2) #3:2;",
    "        check(overwrite: (*_6)) -> bb2 #3:3;",
    "    }",
    "    bb2: {",
    "        (*_6) = move _9 #3:3;",
    "        _0 = const u64 0 #5:1;",
    "        del(move _5) #6:1;",
    "        del(move (*_1).1) #6:2;",
    "        del(move _1) #6:3;",
    "        dead(_5) #7:1;",
    "        dead(_1) #7:1;",
    "        return #7:1;",
    "    }",
    "}",
    // `del(move(v->slots[0]->next))` and then `v->slots[1] = make()`: `v` is a view of the cell
    // that `v->slots[0]->next` owns. The vacated place has two references in a row after
    // `v->slots`, the index and the deref. The second one stands right after the first, and after
    // it the place can name any storage: here it names the owner of the cell that holds
    // `v->slots`. The `del` releases that cell while it owns its span, which the interpreter
    // reports as a leak.
    "fn main.next_moved() -> u64 {",
    "    let _1 (v): cell mut*;",
    "    let _2: cell mut* own mut* own;",
    "    let _3: cell mut* own mut@ own;",
    "    let _4: u64;",
    "    let _5 (n): cell mut* own;",
    "    let _6 (first): cell mut* own;",
    "    let _7 (old): cell mut* own;",
    "    let _8: u64;",
    "    let _9: cell mut* own;",
    "    let _10: cell mut* own;",
    "    let _11: cell mut* own;",
    "    bb0: {",
    "        _5 = const null cell mut* own #1:1;",
    "        _6 = const null cell mut* own #1:2;",
    "        _7 = const null cell mut* own #1:3;",
    "        live(_5) #1:1;",
    "        _5 = alloc<cell>(const u64 1) #2:1;",
    "        _2 = alloc<cell mut* own>(const u64 2) #2:2;",
    "        _3 = aggregate cell mut* own mut@ own(move _2, const u64 2) #2:2;",
    "        check(overwrite: (*_5).0) -> bb1 #2:3;",
    "    }",
    "    bb1: {",
    "        (*_5).0 = move _3 #2:3;",
    "        live(_1) #2:4;",
    "        _1 = addr mut((*_5)) #2:4;",
    "        live(_6) #2:5;",
    "        _6 = alloc<cell>(const u64 1) #2:5;",
    "        check(overwrite: (*_6).1) -> bb2 #2:6;",
    "    }",
    "    bb2: {",
    "        (*_6).1 = move _5 #2:6;",
    "        _4 = const u64 0 #2:7;",
    "        _11 = move (*_1).0[_4] #2:8;",
    "        check(overwrite: (*_1).0[_4]) -> bb3 #2:9;",
    "    }",
    "    bb3: {",
    "        (*_1).0[_4] = move _6 #2:9;",
    "        _8 = const u64 1 #2:10;",
    "        live(_7) #2:11;",
    "        _7 = move (*_1).0[_8] #2:11;",
    "        _9 = move (*(*_1).0[_4]).1 #3:1;",
    "        del(move _9) #3:1;",
    "        _10 = alloc<cell>(const u64 1) #3:2;",
    "        check(overwrite: (*_1).0[_8]) -> bb4 #3:3;",
    "    }",
    "    bb4: {",
    "        (*_1).0[_8] = move _10 #3:3;",
    "        _0 = const u64 0 #5:1;",
    "        del(move _7) #6:1;",
    "        del(move _11) #6:2;",
    "        dead(_7) #7:1;",
    "        dead(_6) #7:1;",
    "        dead(_1) #7:1;",
    "        dead(_5) #7:1;",
    "        return #7:1;",
    "    }",
    "}",
    // `n[0].kids = regrow(move(*m->self), 2)`, where `m->self` holds the address of the local `n`.
    // The vacated place has another base, the pointer `m`, and is reached through memory. `n` is
    // memory, so the place through `m` can be `n`, and the `move` ends the fact of the element.
    "fn main.other_moved() -> u64 {",
    "    let _1 (n): ring mut@ own;",
    "    let _2: ring mut* own;",
    "    let _3: ring mut@ own;",
    "    let _4: u64;",
    "    let _5 (old): ring mut@ own;",
    "    let _6: ring mut@ own mut*;",
    "    let _7: ring mut@ own;",
    "    let _8: ring mut* own;",
    "    let _9: ring mut@ own;",
    "    let _10: ring mut@ own mut*;",
    "    let _11 (m): ring mut* own;",
    "    bb0: {",
    "        _1 = const zero ring mut@ own #1:1;",
    "        _5 = const zero ring mut@ own #1:2;",
    "        _11 = const null ring mut* own #1:3;",
    "        live(_1) #1:1;",
    "        _2 = alloc<ring>(const u64 1) #2:1;",
    "        _3 = aggregate ring mut@ own(move _2, const u64 1) #2:1;",
    "        check(overwrite: _1) -> bb1 #2:2;",
    "    }",
    "    bb1: {",
    "        _1 = move _3 #2:2;",
    "        _4 = const u64 0 #2:3;",
    "        live(_11) #2:4;",
    "        _11 = alloc<ring>(const u64 1) #2:4;",
    "        _10 = addr mut(_1) #2:5;",
    "        (*_11).0 = copy _10 #2:5;",
    "        live(_5) #2:6;",
    "        _5 = move _1[_4].1 #2:6;",
    "        _6 = addr mut(_1[_4].1) #3:1;",
    "        _7 = move (*(*_11).0) #3:2;",
    "        _8 = regrow<ring>(move _7, const u64 2) #3:2;",
    "        _9 = aggregate ring mut@ own(move _8, const u64 2) #3:2;",
    "        check(overwrite: (*_6)) -> bb2 #3:3;",
    "    }",
    "    bb2: {",
    "        (*_6) = move _9 #3:3;",
    "        _0 = const u64 0 #5:1;",
    "        del(move _5) #6:1;",
    "        del(move _1) #6:2;",
    "        del(move _11) #6:3;",
    "        dead(_11) #7:1;",
    "        dead(_5) #7:1;",
    "        dead(_1) #7:1;",
    "        return #7:1;",
    "    }",
    "}",
};

// A statement vacates an owner that the path of the destination does not read. The fact of the
// destination holds, and the prover proves the store.
string[289] KEPT = {
    // A `field` step stays in the storage of the moved struct value: the `move` of `a` makes
    // `a.left` empty, and the store into it is proved.
    "fn main.field_kept() -> u64 {",
    "    let _1 (a): pair;",
    "    let _2 (b): pair;",
    "    let _3: u8 mut* own;",
    "    let _4: u8 mut* own;",
    "    bb0: {",
    "        _1 = const zero pair #1:1;",
    "        _2 = const zero pair #1:2;",
    "        live(_1) #1:1;",
    "        _3 = alloc<u8>(const u64 1) #2:1;",
