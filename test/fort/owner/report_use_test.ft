    ":345:5: note: 'p' is deleted here",
    ":352:21: use after move or del: 'p' can be vacated here",
    ":351:5: note: 'p' is deleted here",
    ":364:14: use after move or del: 'x' can be vacated here",
    ":362:5: note: 'x' is deleted here",
    ":374:6: use after move or del: 'p' can be vacated here",
    ":370:9: note: 'p' is deleted here",
    ":387:15: use after move or del: 'b[0]' can be vacated here",
    ":386:5: note: 'b[0]' is deleted here",
    ":395:10: use after move or del: 'x' can be vacated here",
    ":399:12: note: 'x' can change in this call",
    ":403:20: use after move or del: 's.b' can be vacated here",
    ":404:5: note: 's' is moved here",
    ":410:15: use after move or del: '(s).a' can be vacated here",
    ":409:5: note: '(s).a' is deleted here",
};

// Lowers the function `name` of the checked source of `e` into *out, and holds that the
// verifier accepts it.
fn lower(lower_env.env mut* e, string name, fir.func mut* out) void {
    fir_lower.report mut why = fir_lower.report{};
    if (!fir_lower.lower_function(&e->c.ck, lower_env.decl(e, name), out, &why)) {
        panic("report_use_test: the lowering refuses the function");
    }
    pass_env.verified(e, out, "report_use_test: the verifier refuses the lowering");
}

// Appends each diagnostic of `e` from `before` on to `got` in the form of a header line of the
// compiler without the word `error:`: `<file>:<line>:<col>: <message>`, with `note: ` before the
// message of a note, and a newline. So an error and a note with one text give two lines.
fn diagnostics(lower_env.env mut* e, u64 before, strbuf.str_buf mut* got) void {
    u64 mut k = before;
    while (k < check_env.reports(&e->c)) {
        strbuf.append(got, check_env.report_file(&e->c, k));
        strbuf.push(got, ':');
        bool note = check_env.report_severity(&e->c, k) == "note";
        string text = check_env.report_text(&e->c, k);
        u64 at = cast(str.find(text, ": "), u64) + 2;
        strbuf.append(got, text[..at]);
        if (note) {
            strbuf.append(got, "note: ");
        }
        strbuf.append(got, text[at..]);
        strbuf.push(got, '\n');
        k += 1;
    }
}

// The count of the lines of `want` that are no note: the errors.
fn error_lines(string@ want) u64 {
    u64 mut n = 0;
    u64 mut k = 0;
    while (k < want.len) {
        if (str.find(want[k], ": note: ") < 0) {
            n += 1;
        }
        k += 1;
    }
    return n;
}

// Holds that the diagnostics of `e` from `before` on are the lines of `want`, each after `file`,
// in order, and that the errors among them are those of `want` (diagnostics).
fn expect_diagnostics(lower_env.env mut* e, u64 before, u64 errors, string file, string@ want)
    void {
    strbuf.str_buf mut got = strbuf.create();
    defer strbuf.free(&got);
    diagnostics(e, before, &got);
    expect_lines(strbuf.view(&got), file, want);
    assert(check_env.errors(&e->c) == errors + error_lines(want));
}

// Holds that `got` holds the lines of `want`, each after `file` and with a newline, and nothing
// else.
fn expect_lines(string got, string file, string@ want) void {
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    u64 mut k = 0;
    while (k < want.len) {
        strbuf.append(&text, file);
        strbuf.append(&text, want[k]);
        strbuf.push(&text, '\n');
        k += 1;
    }
    if (got != strbuf.view(&text)) {
        eprintln(got, "and not\n", strbuf.view(&text));
        panic("report_use_test: the lines differ");
    }
}

// The errors name each use of USES that the pass does not prove, in the file of the function,
// each with its note, and each such use is an error of the proof (has_error).
fn the_errors_name_each_unproved_use() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    lower_env.check_lines(&e, USES[..], true);
    string file = lower_env.decl_file(&e, "deleted");
    assert(str.ends_with(file, "main.ft"));
    u64 before = check_env.reports(&e.c);
    u64 errors = check_env.errors(&e.c);
    u64 mut k = 0;
    while (k < USE_NAMES.len) {
        fir.func mut f = fir.func{};
        lower(&e, USE_NAMES[k], &f);
        prover.proof mut p = prover.prove(&f);
        u64 mark = check_env.errors(&e.c);
        report.write_uses(&f, &p, &e.c.m.s);
        // an error of rule (b) is an error of the proof, and a proof with no use writes none
        assert(prover.has_error(&p) == (p.use_unproved > 0 || p.unproved > 0 || p.leaks > 0));
        assert((check_env.errors(&e.c) > mark) == (p.use_unproved > 0));
        prover.free(&p);
        fir.func_free(&f);
        k += 1;
    }
    expect_diagnostics(&e, before, errors, file, USE_LINES[..]);
    println("uses ok");
}

// The types of the FIR texts of TEXT_USES.
string[8] TEXT_PRELUDE = {
    "struct node {",
    "    node mut* own left;",
    "    i32 v;",
    "}",
    "struct pair {",
    "    node mut* own a;",
    "    node mut* own b;",
    "}",
};

// FIR texts with locations and no tree: a named local or a parameter takes its name, the fields
// their names, and a temporary with no location the FIR place. The read of `t2` through a pointer
// names the first owner of `s` that can be vacated, `s.b`.
string[33] TEXT_USES = {
    "fn main.t1(_1 (p): node mut* own) -> void {",
    "    let _2: i32;",
    "    bb0: {",
    "        del(move _1) #2:1;",
    "        _2 = copy (*_1).1 #3:1;",
    "        return #4:1;",
    "    }",
    "}",
    "fn main.t2(_1 (s): pair) -> void {",
    "    let _2: pair*;",
    "    let _3: bool;",
    "    bb0: {",
    "        _2 = addr(_1) #6:1;",
    "        del(move _1.1) #7:1;",
    "        _3 = eq(copy (*_2).0, copy (*_2).1) #8:1;",
    "        return #9:1;",
    "    }",
    "}",
    "fn main.t3() -> void {",
    "    let _1: node mut* own;",
    "    let _2: i32;",
    "    bb0: {",
    "        _1 = alloc<node>(const u64 1) #11:1;",
    "        del(move _1) #12:1;",
    "        _2 = copy (*_1).1 #13:1;",
    "        return #14:1;",
    "    }",
    "}",
    "fn main.t4() -> void {",
    "    bb0: {",
    "        return #16:1;",
    "    }",
    "}",
};

// The note of t1 names the parameter that the `del` vacates, `p`, and that of t2 the FIR place of
// the operand of its `del`, `_1.1`, because a FIR text has no source text of the operand. The error
// of t2 names the owner that the read reads, `s.b`.
string[6] TEXT_USE_LINES = {
    ":3:1: use after move or del: 'p' can be vacated here",
    ":2:1: note: 'p' is deleted here",
    ":8:1: use after move or del: 's.b' can be vacated here",
    ":7:1: note: '_1.1' is deleted here",
    ":13:1: use after move or del: '_1' can be vacated here",
    ":12:1: note: '_1' is deleted here",
};

// With no tree, the errors of rule (b) name the FIR place where no name stands.
fn the_errors_of_a_fir_text_name_the_fir_place() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    fir.module mut m = pass_env.parse(&e, TEXT_PRELUDE[..], TEXT_USES[..]);
    defer fir.module_free(&m);
    u64 before = check_env.reports(&e.c);
    u64 errors = check_env.errors(&e.c);
    u64 mut f = 0;
    while (f < m.funcs.len) {
        prover.proof mut p = prover.prove(fir.module_function_at(&m, f));
        report.write_uses(fir.module_function_at(&m, f), &p, &e.c.m.s);
        prover.free(&p);
        f += 1;
    }
    expect_diagnostics(&e, before, errors, "t.fir", TEXT_USE_LINES[..]);
    println("fir text ok");
}

// The diagnostics of `pointer` past the limit: each use is unproved, no note names an operation,
// and only the first error takes the note of the limit.
string[3] POINTER_LIMIT_LINES = {
    ":79:6: use after move or del: 'x' can be vacated here",
    ":79:6: note: the function exceeds the work limit of D17.21; split it",
    ":82:14: use after move or del: 'x' can be vacated here",
};

// Past the limit no use is proved: `refilled`, which the pass proves, has its one use, the read of
// `p`, past a limit of 0.
string[2] REFILLED_LIMIT_LINES = {
    ":19:14: use after move or del: 'p' can be vacated here",
    ":19:14: note: the function exceeds the work limit of D17.21; split it",
};

// The diagnostics of `array_through` past the limit: its read through `pb` names the first owner of
// the memory local `b`, `b[0]`, and no operation.
string[2] THROUGH_LIMIT_LINES = {
    ":387:15: use after move or del: 'b[0]' can be vacated here",
    ":387:15: note: the function exceeds the work limit of D17.21; split it",
};

// Lowers the function `name` of USES, which `e` checked, proves it within a limit of rule (b) of
// 0, and holds that its diagnostics are those of `want` and that `unproved` uses are not proved.
fn expect_past_limit(lower_env.env mut* e, string name, u32 unproved, string@ want) void {
    fir.func mut f = fir.func{};
    defer fir.func_free(&f);
    lower(e, name, &f);
    prover.proof mut over = prover.prove_limits(&f, prover.WORK_LIMIT, 0);
    defer prover.free(&over);
    assert(over.use_over && over.use_unproved == unproved && prover.has_error(&over));
    u64 before = check_env.reports(&e->c);
    u64 errors = check_env.errors(&e->c);
    report.write_uses(&f, &over, &e->c.m.s);
    expect_diagnostics(e, before, errors, lower_env.decl_file(e, name), want);
}

fn the_first_error_past_the_limit_names_the_limit() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    lower_env.check_lines(&e, USES[..], true);
    expect_past_limit(&e, "pointer", 2, POINTER_LIMIT_LINES[..]);
    fir.func mut g = fir.func{};
    defer fir.func_free(&g);
    lower(&e, "refilled", &g);
    prover.proof mut proved = prover.prove(&g);
    defer prover.free(&proved);
    assert(!proved.use_over && proved.use_unproved == 0 && !prover.has_error(&proved));
    expect_past_limit(&e, "refilled", 1, REFILLED_LIMIT_LINES[..]);
    expect_past_limit(&e, "array_through", 1, THROUGH_LIMIT_LINES[..]);
    println("limit ok");
}

// The notes of `unkeyed` and of `fields` once their `del` and their `move` stand where the tree
// holds no such operation: each note names the place of the error, as for an operation that the
// lowering made, and so names no FIR local (D17.21). The note stands at the moved statement, the
// location of the item of the use: the `*` of the load, column 13. The error stands at the first
// token of the read, column 14.
string[4] FALLBACK_LINES = {
    ":72:14: use after move or del: 'b[i % 2]' can be vacated here",
    ":72:13: note: 'b[i % 2]' is deleted here",
    ":53:14: use after move or del: 's.b' can be vacated here",
    ":53:13: note: 's.b' is moved here",
};

// Moves the operation of the note of the first unproved use of `p` to the location of the item of
// that use in `f`, where no `del` and no `move` stands. `f` and `p` are parameters here, so they
// are no local owners.
fn move_operation(fir.func mut* f, prover.proof* p) void {
    u64 mut k = 0;
    while (p->uses[k].proved) {
        k += 1;
    }
    prover.use* u = &p->uses[k];
    diag.loc at = report.item_loc(f, u->block, u->index);
    fir.block_mut(f, u->op_block)->statements.items[cast(u->op_index, u64)].loc = at;
}

// Lowers the function `name` of USES, which `e` checked, moves the operation of the note of its
// first unproved use (move_operation), and writes the errors of the function.
fn write_moved_operation(lower_env.env mut* e, string name) void {
    fir.func mut f = fir.func{};
    defer fir.func_free(&f);
    lower(e, name, &f);
    prover.proof mut p = prover.prove(&f);
    defer prover.free(&p);
    move_operation(&f, &p);
    report.write_uses(&f, &p, &e->c.m.s);
}

fn a_note_with_no_operation_in_the_tree_names_the_place_of_the_error() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    lower_env.check_lines(&e, USES[..], true);
    u64 before = check_env.reports(&e.c);
    u64 errors = check_env.errors(&e.c);
    write_moved_operation(&e, "unkeyed");
    write_moved_operation(&e, "fields");
    expect_diagnostics(&e, before, errors, lower_env.decl_file(&e, "fields"), FALLBACK_LINES[..]);
    println("fallback ok");
}

fn main() i32 {
    the_errors_name_each_unproved_use();
    the_errors_of_a_fir_text_name_the_fir_place();
    the_first_error_past_the_limit_names_the_limit();
    a_note_with_no_operation_in_the_tree_names_the_place_of_the_error();
    return 0;
}
