// Lowers the function `name` of the checked source of `e` into *out, and holds that the
// verifier accepts it.
fn lower(lower_env.env mut* e, string name, fir.func mut* out) void {
    fir_lower.report mut why = fir_lower.report{};
    if (!fir_lower.lower_function(&e->c.ck, lower_env.decl(e, name), out, &why)) {
        panic("report_use_test: the lowering refuses the function");
    }
    pass_env.verified(e, out, "report_use_test: the verifier refuses the lowering");
}

// Holds that `got` holds the lines of `want`, each after `file` and with a newline, and nothing
// else.
fn expect_lines(string got, string file, string@ want) void {
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    u64 mut k = 0;
    while (k < want.len) {
        strbuf.append(&text, file);
        strbuf.append(&text, want[k]);
        strbuf.push(&text, '\n');
        k += 1;
    }
    if (got != strbuf.view(&text)) {
        eprintln(got, "and not\n", strbuf.view(&text));
        panic("report_use_test: the lines differ");
    }
}

// The report names each use of USES that the pass does not prove, in the file of the function,
// and writes no diagnostic: rule (b) is no error yet.
fn the_report_names_each_unproved_use() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    lower_env.check_lines(&e, USES[..], true);
    string file = lower_env.decl(&e, "deleted")->loc.file;
    assert(str.ends_with(file, "main.ft"));
    strbuf.str_buf mut got = strbuf.create();
    defer strbuf.free(&got);
    u64 before = check_env.reports(&e.c);
    u64 mut k = 0;
    while (k < USE_NAMES.len) {
        fir.func mut f = fir.func{};
        lower(&e, USE_NAMES[k], &f);
        prover.proof mut p = prover.prove(&f);
        report.write_uses(&f, &p, &e.c.m.s, &got);
        prover.free(&p);
        fir.func_free(&f);
        k += 1;
    }
    assert(check_env.reports(&e.c) == before);
    expect_lines(strbuf.view(&got), file, USE_LINES[..]);
    println("uses ok");
}

// The types of the FIR texts of TEXT_USES.
string[8] TEXT_PRELUDE = {
    "struct node {",
    "    node mut* own left;",
    "    i32 v;",
    "}",
    "struct pair {",
    "    node mut* own a;",
    "    node mut* own b;",
    "}",
};

// FIR texts with locations and no tree: a named local or a parameter takes its name, the fields
// their names, and a temporary with no location the FIR place. The read of `t2` through a pointer
// names the first owner of `s` that can be vacated, `s.b`.
string[33] TEXT_USES = {
    "fn main.t1(_1 (p): node mut* own) -> void {",
    "    let _2: i32;",
    "    bb0: {",
    "        del(move _1) #2:1;",
    "        _2 = copy (*_1).1 #3:1;",
    "        return #4:1;",
    "    }",
    "}",
    "fn main.t2(_1 (s): pair) -> void {",
    "    let _2: pair*;",
    "    let _3: bool;",
    "    bb0: {",
    "        _2 = addr(_1) #6:1;",
    "        del(move _1.1) #7:1;",
    "        _3 = eq(copy (*_2).0, copy (*_2).1) #8:1;",
    "        return #9:1;",
    "    }",
    "}",
    "fn main.t3() -> void {",
    "    let _1: node mut* own;",
    "    let _2: i32;",
    "    bb0: {",
    "        _1 = alloc<node>(const u64 1) #11:1;",
    "        del(move _1) #12:1;",
    "        _2 = copy (*_1).1 #13:1;",
    "        return #14:1;",
    "    }",
    "}",
    "fn main.t4() -> void {",
    "    bb0: {",
    "        return #16:1;",
    "    }",
    "}",
};

string[6] TEXT_USE_LINES = {
    "t.fir:3:1: use after move or del: 'p' can be vacated here\n",
    "t.fir:2:1: note: 'p' is deleted here\n",
    "t.fir:8:1: use after move or del: 's.b' can be vacated here\n",
    "t.fir:7:1: note: 's.b' is deleted here\n",
    "t.fir:13:1: use after move or del: '_1' can be vacated here\n",
    "t.fir:12:1: note: '_1' is deleted here\n",
};

// With no tree, the report of rule (b) names the FIR place where no name stands.
fn the_report_of_a_fir_text_names_the_fir_place() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    fir.module mut m = pass_env.parse(&e, TEXT_PRELUDE[..], TEXT_USES[..]);
    defer fir.module_free(&m);
    strbuf.str_buf mut got = strbuf.create();
    defer strbuf.free(&got);
    u64 mut f = 0;
    while (f < m.funcs.len) {
        prover.proof mut p = prover.prove(&m.funcs.items[f]);
        report.write_uses(&m.funcs.items[f], &p, &e.c.m.s, &got);
        prover.free(&p);
        f += 1;
    }
    strbuf.str_buf mut want = strbuf.create();
    defer strbuf.free(&want);
    u64 mut k = 0;
    while (k < TEXT_USE_LINES.len) {
        strbuf.append(&want, TEXT_USE_LINES[k]);
        k += 1;
    }
    if (strbuf.view(&got) != strbuf.view(&want)) {
        eprintln(strbuf.view(&got));
        panic("report_use_test: the lines of a FIR text differ");
    }
    println("fir text ok");
}

// The lines of `pointer` past the limit: each use is unproved, no line names an operation, and only
// the first line takes the note of the limit.
string[3] POINTER_LIMIT_LINES = {
    ":79:6: use after move or del: 'x' can be vacated here",
    ":79:6: note: the function exceeds the work limit of D17.21; split it",
    ":82:14: use after move or del: 'x' can be vacated here",
};

// Past the limit no use is proved: `refilled`, which the pass proves, has its one use, the read of
// `p`, past a limit of 0.
string[2] REFILLED_LIMIT_LINES = {
    ":19:14: use after move or del: 'p' can be vacated here",
    ":19:14: note: the function exceeds the work limit of D17.21; split it",
};

// The lines of `array_through` past the limit: its read through `pb` names the first owner of the
// memory local `b`, `b[0]`, and no operation.
string[2] THROUGH_LIMIT_LINES = {
    ":387:15: use after move or del: 'b[0]' can be vacated here",
    ":387:15: note: the function exceeds the work limit of D17.21; split it",
};

fn the_first_line_past_the_limit_names_the_limit() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    lower_env.check_lines(&e, USES[..], true);
    string file = lower_env.decl(&e, "pointer")->loc.file;
    strbuf.str_buf mut got = strbuf.create();
    defer strbuf.free(&got);
    fir.func mut f = fir.func{};
    defer fir.func_free(&f);
    lower(&e, "pointer", &f);
    prover.proof mut over = prover.prove_limits(&f, prover.WORK_LIMIT, 0);
    defer prover.free(&over);
    assert(over.use_over && over.use_unproved == 2);
    report.write_uses(&f, &over, &e.c.m.s, &got);
    expect_lines(strbuf.view(&got), file, POINTER_LIMIT_LINES[..]);
    fir.func mut g = fir.func{};
    defer fir.func_free(&g);
    lower(&e, "refilled", &g);
    prover.proof mut proved = prover.prove(&g);
    defer prover.free(&proved);
    assert(!proved.use_over && proved.use_unproved == 0);
    prover.proof mut past = prover.prove_limits(&g, prover.WORK_LIMIT, 0);
    defer prover.free(&past);
    strbuf.clear(&got);
    report.write_uses(&g, &past, &e.c.m.s, &got);
    expect_lines(strbuf.view(&got), file, REFILLED_LIMIT_LINES[..]);
    fir.func mut h = fir.func{};
    defer fir.func_free(&h);
    lower(&e, "array_through", &h);
    prover.proof mut through = prover.prove_limits(&h, prover.WORK_LIMIT, 0);
    defer prover.free(&through);
    assert(through.use_over && through.use_unproved == 1);
    strbuf.clear(&got);
    report.write_uses(&h, &through, &e.c.m.s, &got);
    expect_lines(strbuf.view(&got), file, THROUGH_LIMIT_LINES[..]);
    println("limit ok");
}

fn main() i32 {
    the_report_names_each_unproved_use();
    the_report_of_a_fir_text_names_the_fir_place();
    the_first_line_past_the_limit_names_the_limit();
    return 0;
}
