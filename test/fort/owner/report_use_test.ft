//! run
//! flags: -I ../../src -I support
//! stdout:
//| uses ok
//| fir text ok
//| limit ok
/// Checks the report of rule (b) in owner.report (D17.21): for each use that owner.prover does
/// not prove, the line `use after move or del: '<place>' can be vacated here` at the first token of
/// the expression whose read is the use, and the line of its note at the operation: `is moved
/// here` at a `move` or at the `return` of an implicit `move`, `is deleted here` at a `del`, and
/// `can change in this call` at the first token of a call. `<place>` is the source text of the
/// read of an `own` reference, or the first owner of the local that can be vacated, with the names
/// of its fields. A deferred use gives one line for each location and local. FIR text with no
/// tree names the FIR place. Past the limit the first line takes the note of the limit, and no
/// line names an operation.
import fort.fir;
import fort.fir_lower;
import fort.owner.prover;
import fort.owner.report;
import check_env;
import lower_env;
import pass_env;
import std.str;
import std.strbuf;

// The cases of the report over lowered source: the examples of D17.21 and the forms of the tests
// against null of D17.11 gen rule 6. `refilled`, `tested` and the tests of `forms` before the
// whole value of `&&` are proved. `result` evaluates its value into a temporary before its deferred
// call, so the call vacates no owner of `_0`. `built` reads through a pointer after a call, and the
// place can be a place of `_0`, which no `return` names there: the use names `_0` as the call of
// the function. The `for` of `ranged` reads each element of `kids` through an index that no
// source expression names, so the use names the first owner that can be vacated, `kids[0]`.
// After `ranged` each function holds one form of `<place>` or of the location: a nested field, a
// read through a pointer, a key, a `string`, an operand of a literal or of a cast, two locals in
// one item, a deferred use of two locals, and a comparison with null before the use in one item,
// which is no read of the use. `returned_moved` returns a deleted owner: the operand of the
// implicit `move` is no use. `argument_text` moves a vacated owner, which is no use either. The
// later functions hold a nested array, a span field, the call of a note, a loop condition, a
// compound assignment, a `.len` through a pointer, an arm of `?:`, an index expression, a read
// through an address that the function takes after the `del`, and an arm of a `switch`.
// `null_store_text` stores `null` after the `del`: the store ends the state, and its load
// through `null` stays undefined (D10.5). `array_through` reads a fixed array of owners through
// a pointer to it.
string[388] USES = {
    "struct pair {",
    "    i32* own a;",
    "    i32* own b;",
    "}",
    "fn take(i32 mut* own a, i32 v) void {",
    "    del(a);",
    "}",
    "fn g() void {",
    "}",
    "fn deleted() void {",
    "    i32 mut* own mut p = new(i32);",
    "    del(p);",
    "    i32 v = *p;",
    "}",
    "fn refilled() void {",
    "    i32 mut* own mut p = new(i32);",
    "    del(p);",
    "    p = new(i32);",
    "    i32 v = *p;",
    "    del(p);",
    "}",
    "fn tested(bool c) void {",
    "    i32 mut* own mut p = new(i32);",
    "    if (c) {",
    "        del(p);",
    "    }",
    "    if (p != null) {",
    "        i32 v = *p;",
    "    }",
    "    del(p);",
    "}",
    "fn argument() void {",
    "    i32 mut* own mut q = new(i32);",
    "    take(move(q), *q);",
    "}",
    "fn span() void {",
    "    u8 mut@ own buf = new(u8, 4);",
    "    u8 mut@ own c = move(buf);",
    "    u64 n = buf.len;",
    "    if (buf.ptr == null) {",
    "        del(buf);",
    "    }",
    "    u8 x = buf[0];",
    "    del(c);",
    "}",
    "fn fields() void {",
    "    pair mut s = pair{};",
    "    s.a = new(i32);",
    "    s.b = new(i32);",
    "    del(s.a);",
    "    i32 v = *s.b;",
    "    pair t = move(s);",
    "    i32 w = *s.b;",
    "    del(t.a);",
    "    del(t.b);",
    "}",
    "fn keyed() void {",
    "    i32 mut* own[2] mut b = {};",
    "    u64 mut k = 0;",
    "    del(b[k]);",
    "    k = 1;",
    "    del(b[k]);",
    "    b[k] = new(i32);",
    "    k = 0;",
    "    i32 v = *b[k];",
    "    del(b[0]);",
    "    del(b[1]);",
    "}",
    "fn unkeyed(u64 i) void {",
    "    i32 mut* own[2] mut b = {};",
    "    del(b[1]);",
    "    i32 v = *b[i % 2];",
    "    del(b[0]);",
    "}",
    "fn pointer() void {",
    "    i32 mut* own mut x = new(i32);",
    "    i32 mut* own mut* px = &x;",
    "    del(*px);",
    "    *x = 1;",
    "    x = new(i32);",
    "    del(x);",
    "    i32 v = **px;",
    "    del(*px);",
    "}",
    "fn called() void {",
    "    i32 mut* own mut x = new(i32);",
    "    i32 mut* own mut* px = &x;",
    "    g();",
    "    *x = 1;",
    "    del(x);",
    "}",
    "fn returned() i32 mut* own {",
    "    i32 mut* own p = new(i32);",
    "    defer *p = 0;",
    "    return p;",
    "}",
    "fn deferred(bool c) void {",
    "    i32 mut* own mut p = new(i32);",
    "    i32 mut* own q = move(p);",
    "    defer {",
    "        i32 v = *p;",
    "    }",
    "    if (c) {",
    "        del(q);",
    "        return;",
    "    }",
    "    del(q);",
    "}",
    "fn forms(bool mut c) void {",
    "    i32 mut* own mut p = new(i32);",
    "    if (c) {",
    "        del(p);",
    "    }",
    "    if (p != null && *p == 1) {",
    "        c = false;",
    "    }",
    "    if (p == null || *p == 1) {",
    "        c = true;",
    "    }",
    "    i32 v = p != null ? *p : 0;",
    "    if (!(p == null)) {",
    "        *p = 2;",
    "    }",
    "    while (p != null) {",
    "        *p = 3;",
    "        del(p);",
    "    }",
    "    bool ok = p != null && c;",
    "    if (ok) {",
    "        *p = 4;",
    "    }",
    "    del(p);",
    "}",
    "fn result() pair {",
    "    defer g();",
    "    return pair{new(i32), new(i32)};",
    "}",
    "fn built(i32* v) pair {",
    "    g();",
    "    i32 w = *v;",
    "    return pair{};",
    "}",
    "fn ranged() i32 {",
    "    i32 mut* own[2] mut kids = {};",
    "    kids[0] = new(i32);",
    "    del(kids[1]);",
    "    i32 mut sum = 0;",
    "    for (i32 mut* c : kids) {",
    "        sum += *c;",
    "    }",
    "    del(kids[0]);",
    "    return sum;",
    "}",
    "struct cell {",
    "    i32 mut* own o;",
    "    i32 v;",
    "}",
    "struct inner {",
    "    i32 mut* own a;",
    "}",
    "struct outer {",
    "    inner in;",
    "    i32 mut* own[2] e;",
    "}",
    "fn take2(i32 mut* own a, i32 mut* own b) void {",
    "    del(a);",
    "    del(b);",
    "}",
    "fn nested_text() void {",
    "    outer mut t = outer{};",
    "    t.e[0] = new(i32);",
    "    del(t.e[1]); //@op",
    "    i32 v = *t.e[0]; //@use",
    "    del(t.e[0]);",
    "}",
    "fn through_text() void {",
    "    pair mut s = pair{};",
    "    pair* ps = &s;",
    "    del(s.b); //@op",
    "    i32* own mut x = new(i32);",
    "    bool same = ps->a == x; //@use",
    "    del(x);",
    "}",
    "fn keyed_text(u64 k) void {",
    "    pair[2] mut arr = {};",
    "    del(arr[k].a); //@op",
    "    i32 v = *arr[k].a; //@use",
    "}",
    "fn string_text() void {",
    "    u8 mut@ own buf = new(u8, 2);",
    "    string own s = cast(move(buf), string own);",
    "    string own t = move(s); //@op",
    "    u64 n = s.len;",
    "    char c = s[0]; //@use",
    "    del(t);",
    "}",
    "fn literal_note() void {",
    "    i32 mut* own mut p = new(i32);",
    "    pair t = pair{null, move(p)}; //@op",
    "    i32 v = *p; //@use",
    "    del(t.b);",
    "}",
    "fn cast_note() void {",
    "    u8 mut@ own buf = new(u8, 2);",
    "    string own s = cast(move(buf), string own); //@op",
    "    u8 x = buf[1]; //@use",
    "    del(s);",
    "}",
    "fn two_moves() void {",
    "    i32 mut* own mut p = new(i32);",
    "    i32 mut* own mut q = new(i32);",
    "    take2(move(q), move(p)); //@op",
    "    i32 v = *p; //@use",
    "}",
    "fn chain_text() void {",
    "    i32 mut* own mut x = new(i32);",
    "    i32 mut* own mut* mut p = &x;",
    "    i32 mut* own mut** pp = &p;",
    "    del(x); //@op",
    "    i32 v = ***pp; //@use",
    "}",
    "fn compared_text(i32 mut* q) bool {",
    "    i32 mut* own mut p = new(i32);",
    "    del(p); //@op",
    "    return cast(p, i32 mut*) == q; //@use",
    "}",
    "fn returned_moved() i32 mut* own {",
    "    i32 mut* own mut p = new(i32);",
    "    del(p);",
    "    return p;",
    "}",
    "fn address_text() void {",
    "    cell mut* own mut p = new(cell);",
    "    del(p); //@op",
    "    i32* v = &p->v; //@use",
    "}",
    "fn two_locals() void {",
    "    i32 mut* own mut p = new(i32);",
    "    i32 mut* own mut q = new(i32);",
    "    del(q); //@op",
    "    del(p); //@op2",
    "    i32 v = *p + *q; //@use",
    "}",
    "fn deferred_two(bool c) void {",
    "    i32 mut* own mut p = new(i32);",
    "    i32 mut* own mut q = new(i32);",
    "    i32 mut* own r = move(p); //@op",
    "    i32 mut* own s = move(q); //@op2",
    "    defer {",
    "        i32 v = *p + *q; //@use",
    "    }",
    "    if (c) {",
    "        del(r);",
    "        del(s);",
    "        return;",
    "    }",
    "    del(r);",
    "    del(s);",
    "}",
    "fn field_call() void {",
    "    pair mut s = pair{};",
    "    s.a = new(i32);",
    "    pair mut* ps = &s;",
    "    g(); //@op",
    "    i32 v = *s.a; //@use",
    "    del(s.a);",
    "}",
    "fn element_field(u64 i) void {",
    "    outer mut t = outer{};",
    "    del(t.e[0]); //@op",
    "    i32 v = *t.e[i]; //@use",
    "}",
    "fn null_operand() void {",
    "    i32 mut* own mut p = new(i32);",
    "    del(p); //@op",
    "    bool b = p == null;",
    "    i32 v = *p; //@use",
    "}",
    "fn both(bool a, i32 b) void {",
    "}",
    "fn null_first() void {",
    "    i32 mut* own mut p = new(i32);",
    "    del(p); //@op",
    "    both(p == null, *p); //@use",
    "}",
    "fn null_left() void {",
    "    i32 mut* own mut p = new(i32);",
    "    i32 mut* own q = move(p); //@op",
    "    both(null != p, *p); //@use",
    "    del(q);",
    "}",
    "struct bag {",
    "    u8 mut@ own data;",
    "    u64 n;",
    "}",
    "fn keep(i32 mut* own mut* p) void {",
    "}",
    "fn matrix_text() void {",
    "    i32 mut* own[2][2] mut m = {};",
    "    m[1][0] = new(i32);",
    "    del(m[0][1]); //@op",
    "    i32 v = *m[1][0]; //@use",
    "    del(m[1][0]);",
    "}",
    "fn bag_text() void {",
    "    bag mut b = bag{};",
    "    b.data = new(u8, 2);",
    "    del(b.data); //@op",
    "    u8 x = b.data[1]; //@use",
    "}",
    "fn keep_note() void {",
    "    i32 mut* own mut x = new(i32);",
    "    keep(&x); //@op",
    "    *x = 1; //@use",
    "    del(x);",
    "}",
    "fn while_text() void {",
    "    i32 mut* own mut p = new(i32);",
    "    del(p); //@op",
    "    while (*p > 0) { //@use",
    "        break;",
    "    }",
    "}",
    "fn compound_text() void {",
    "    i32 mut* own mut p = new(i32);",
    "    del(p); //@op",
    "    *p += 1; //@use",
    "}",
    "fn pointer_len_text() void {",
    "    u8 mut@ own mut buf = new(u8, 2);",
    "    u8 mut@ own mut* pb = &buf;",
    "    u8 mut@ own c = move(buf); //@op",
    "    u64 n = (*pb).len; //@use",
    "    del(c);",
    "}",
    "fn outer_element_text() void {",
    "    outer mut o = outer{};",
    "    o.e[1] = new(i32);",
    "    i32 mut* own a = move(o.e[1]); //@op",
    "    i32 v = *o.e[1]; //@use",
    "    del(a);",
    "}",
    "fn ternary_text(bool c) void {",
    "    i32 mut* own mut p = new(i32);",
    "    del(p); //@op",
    "    i32 v = c ? *p : 0; //@use",
    "}",
    "fn index_text() void {",
    "    i32 mut* own mut p = new(i32);",
    "    i32[2] a = {};",
    "    del(p); //@op",
    "    i32 v = a[cast(*p, u64)]; //@use",
    "}",
    "fn argument_text() void {",
    "    i32 mut* own mut p = new(i32);",
    "    i32 mut* own mut q = new(i32);",
    "    take2(move(q), move(p)); //@op",
    "    take2(new(i32), move(q)); //@use",
    "}",
    "fn address_after_text() void {",
    "    i32 mut* own mut x = new(i32);",
    "    del(x); //@op",
    "    i32 mut* own mut* px = &x;",
    "    i32 v = **px; //@use",
    "}",
    "fn switch_text(i32 n) void {",
    "    i32 mut* own mut p = new(i32);",
    "    switch (n) {",
    "    case 0:",
    "        del(p); //@op",
    "    default:",
    "        g();",
    "    }",
    "    *p = 2; //@use",
    "}",
    "fn null_store_text() void {",
    "    i32 mut* own mut p = new(i32);",
    "    del(p);",
    "    p = null;",
    "    *p = 1;",
    "}",
    "fn array_through() void {",
    "    i32 mut* own[2] mut b = {};",
    "    i32 mut* own[2] mut* pb = &b;",
    "    b[0] = new(i32);",
    "    del(b[0]); //@op",
    "    i32 w = *(*pb)[0]; //@use",
    "}",
};
