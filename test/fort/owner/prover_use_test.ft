// ---- the limit of the work ---------------------------------------------------------------------

// Proves function `k` of `m` within `limit`, holds its uses against `want` and its charge against
// `work`, and gives whether it passed the limit.
fn expect_limit(fir.module* m, u64 k, u64 limit, string want, u64 work) bool {
    strbuf.str_buf mut got = strbuf.create();
    defer strbuf.free(&got);
    prover.proof mut p = prover.prove_limits(&m->funcs.items[k], prover.WORK_LIMIT, limit);
    defer prover.free(&p);
    write_uses(&p, &got);
    if (strbuf.view(&got) != want || p.use_work != work) {
        eprintln("gives '", strbuf.view(&got), "' with the work ", p.use_work);
        panic("prover_use_test: the limit gives another proof");
    }
    return p.use_over;
}

// The charge of v1 is one walk of its one block: its 2 statements, its terminator and its 3 acts
// (the `del`, the read of `_1`, and the key of the store into `_2`, an `i32`, which holds no owner
// and so takes no end) times 1 value, the state of `_1`: 6. p2 charges 1 for bb0, 4 for bb1 (the
// read and the key of its store), 6 for bb2 (the end and the key of the `alloc` into `_4`, and the
// `del`) and 1 for bb3, 12 in its first pass. The fixpoint walks bb0, bb1, bb2 and bb3, then bb1
// again after the `del` of bb2, then bb2 and bb3 again: 23. At the limit the proof holds; past it
// no use is proved and no note names an operation, and the charge is the charge at the walk that
// passed the limit: 23 past 22, and 16, the second walk of bb1, past 12. A function whose first
// pass passes the limit takes no state. The first pass charges the weight of the blocks (their
// statements, terminators and acts, twice for a block with a test) times the values, and the count
// of the values stops at the first local or read whose owners pass the limit: the charge is the
// weight times the values counted up to there, also when the limit is below the charge of the
// first blocks.
fn the_limit_of_the_work_stops_the_proof() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    fir.module mut vacate = pass_env.parse(&e, PRELUDE[..], VACATE[..]);
    defer fir.module_free(&vacate);
    assert(!expect_limit(&vacate, 0, 6, "U1d0.0", 6));
    assert(expect_limit(&vacate, 0, 5, "U1n", 6));
    assert(!expect_limit(&vacate, 0, prover.USE_LIMIT, "U1d0.0", 6));
    // a function that reads no owner takes no charge
    assert(!expect_limit(&vacate, 7, 0, "", 0));
    fir.module mut paths = pass_env.parse(&e, PRELUDE[..], PATHS[..]);
    defer fir.module_free(&paths);
    assert(!expect_limit(&paths, 1, 23, "U1d2.1", 23));
    assert(expect_limit(&paths, 1, 22, "U1n", 23));
    assert(expect_limit(&paths, 1, 12, "U1n", 16));
    assert(expect_limit(&paths, 1, 11, "U1n", 12));
    // the first pass passes 5 at bb2, with 11, and its charge is still that of the whole pass
    assert(expect_limit(&paths, 1, 5, "U1n", 12));
    // a function with no `move`, no `del` and no call that vacates takes no charge, also past a
    // limit of 0
    assert(!expect_limit(&paths, 4, 0, "P1 P1", 0));
    // k2 has 7 items and 11 acts in its one block, 18, and one owner, `b[k]`, with one local key:
    // 2 values, so its first pass charges 36, and its fixpoint walks the block once
    fir.module mut keys = pass_env.parse(&e, PRELUDE[..], KEYS[..]);
    defer fir.module_free(&keys);
    assert(!expect_limit(&keys, 1, 36, "P1", 36));
    assert(expect_limit(&keys, 1, 35, "U1n", 36));
    // below 18 the one owner of the read `b[k]` passes the limit before its key counts: 18 times 1
    assert(expect_limit(&keys, 1, 17, "U1n", 18));
    // k7 weighs 3, 4 and 1 in its three blocks, 8, with the 2 values of `b[k]`: 16. At 13 the count
    // stops at the key of `b[k]`, 16, before the fixpoint, which would stop at bb1 with 14; at 7
    // the owner alone passes it: 8
    assert(!expect_limit(&keys, 6, 16, "U1d0.0", 16));
    assert(expect_limit(&keys, 6, 15, "U1n", 16));
    assert(expect_limit(&keys, 6, 13, "U1n", 16));
    assert(expect_limit(&keys, 6, 7, "U1n", 8));
    // n3 has 5 items and 9 acts, 14, and the 4 owners of the memory local `t`: 56. Past the limit
    // its read through `_2` names the first owner of `t`
    fir.module mut nested = pass_env.parse(&e, PRELUDE[..], NESTED[..]);
    defer fir.module_free(&nested);
    assert(!expect_limit(&nested, 2, 56, "U1d0.2#2", 56));
    assert(expect_limit(&nested, 2, 55, "U1n", 56));
    // the default limit is 2^24
    assert(prover.USE_LIMIT == 16777216);
    println("limit ok");
}

fn main() i32 {
    the_vacate_group_holds();
    the_overlap_group_holds();
    the_keys_group_holds();
    the_borrows_group_holds();
    the_ends_group_holds();
    the_order_group_holds();
    the_reads_group_holds();
    the_paths_group_holds();
    the_spans_group_holds();
    the_temps_group_holds();
    the_calls_group_holds();
    the_tempkeys_group_holds();
    the_forms_group_holds();
    the_aborts_group_holds();
    the_nested_group_holds();
    the_operands_group_holds();
    the_joins_group_holds();
    the_consts_group_holds();
    the_expose_group_holds();
    the_limit_of_the_work_stops_the_proof();
    return 0;
}
