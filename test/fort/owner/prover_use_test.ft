    // a span field of a struct: its index reads it, and its `.len` is no use: U1d0.0
    "fn main.s6(_1 (b): bag) -> void {",
    "    let _2: u64;",
    "    let _3: u64;",
    "    let _4: u8;",
    "    bb0: {",
    "        del(move _1.0);",
    "        _2 = copy _1.0.1;",
    "        _3 = const u64 1;",
    "        _4 = copy _1.0[_3];",
    "        return;",
    "    }",
    "}",
    // the null edge of a test of the `.ptr` of a field ends nothing; the other edge does: U1d0.0 P1
    "fn main.s7(_1 (b): bag) -> void {",
    "    let _2: bool;",
    "    let _3: u8 mut*;",
    "    let _4: u8 mut*;",
    "    bb0: {",
    "        del(move _1.0);",
    "        _2 = eq(copy _1.0.0, const null u8 mut*);",
    "        switch(copy _2) -> [true: bb1, otherwise: bb2];",
    "    }",
    "    bb1: {",
    "        _3 = copy _1.0.0;",
    "        return;",
    "    }",
    "    bb2: {",
    "        _4 = copy _1.0.0;",
    "        return;",
    "    }",
    "}",
};

