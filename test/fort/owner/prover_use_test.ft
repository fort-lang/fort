// The state joins by union: a `move` or a `del` on one path reaches the read. A loop carries it
// around its back edge. A block that no edge reaches holds no operation, and a use in an abort
// block keeps its obligation.
string[67] PATHS = {
    // a `del` in one arm reaches the join: U1d1.0
    "fn main.p1(_1 (p): node mut* own, _2 (c): bool) -> void {",
    "    let _3: i32;",
    "    bb0: {",
    "        switch(copy _2) -> [true: bb1, otherwise: bb2];",
    "    }",
    "    bb1: {",
    "        del(move _1);",
    "        goto bb2;",
    "    }",
    "    bb2: {",
    "        _3 = copy (*_1).2;",
    "        return;",
    "    }",
    "}",
    // a `del` at the end of a loop body reaches the read at its head: U1d2.1
    "fn main.p2(_1 (p): node mut* own, _2 (c): bool) -> void {",
    "    let _3: i32;",
    "    let _4: node mut* own;",
    "    bb0: {",
    "        goto bb1;",
    "    }",
    "    bb1: {",
    "        _3 = copy (*_1).2;",
    "        switch(copy _2) -> [true: bb2, otherwise: bb3];",
    "    }",
    "    bb2: {",
    "        _4 = alloc<node>(const u64 1);",
    "        del(move _1);",
    "        goto bb1;",
    "    }",
    "    bb3: {",
    "        return;",
    "    }",
    "}",
    // a block that no edge reaches holds no operation: P1
    "fn main.p3(_1 (p): node mut* own) -> void {",
    "    let _2: i32;",
    "    bb0: {",
    "        return;",
    "    }",
    "    bb1: {",
    "        _2 = copy (*_1).2;",
    "        return;",
    "    }",
    "}",
    // a use in an abort block keeps its obligation: U1d0.0
    "fn main.p4(_1 (p): node mut* own, _2 (c): bool) -> void {",
    "    let _3: i32;",
    "    bb0: {",
    "        del(move _1);",
    "        switch(copy _2) -> [true: bb1, otherwise: bb2];",
    "    }",
    "    bb1: {",
    "        _3 = copy (*_1).2;",
    "        fail(panic, const bytes \"stop\", const u64 4);",
    "    }",
    "    bb2: {",
    "        return;",
    "    }",
    "}",
    // a function with no `move`, no `del` and no call that vacates proves each use: P1 P1
    "fn main.p5(_1 (p): node mut* own) -> void {",
    "    let _2: i32;",
    "    let _3: void;",
    "    bb0: {",
    "        _2 = copy (*_1).2;",
    "        _3 = call fn main.g();",
    "        _2 = copy (*_1).2;",
    "        return;",
    "    }",
    "}",
};

