// The keys at their boundaries: a parameter index is its own key, a store into it undoes an end,
// `_0` is no key, two constant keys of other values differ, and a constant of any integer type
// through a cast to `u64` is a key.
string[69] CONSTS = {
    // a store into a parameter key after the store into `b[k]` undoes its end: U1d0.0
    "fn main.k1(_1 (b): node mut* own[2], _2 (k): u64) -> void {",
    "    let _3: node mut* own;",
    "    let _4: i32;",
    "    bb0: {",
    "        del(move _1[_2]);",
    "        _3 = alloc<node>(const u64 1);",
    "        _1[_2] = move _3;",
    "        _2 = const u64 1;",
    "        _4 = copy (*_1[_2]).2;",
    "        return;",
    "    }",
    "}",
    // `_0` is no key: the store into `b[_0]` ends nothing, and its read reads each owner: U1d0.1
    "fn main.k2(_1 (b): node mut* own[2]) -> u64 {",
    "    let _0: u64;",
    "    let _2: node mut* own;",
    "    let _3: i32;",
    "    bb0: {",
    "        _0 = const u64 0;",
    "        del(move _1[_0]);",
    "        _2 = alloc<node>(const u64 1);",
    "        _1[_0] = move _2;",
    "        _3 = copy (*_1[_0]).2;",
    "        return;",
    "    }",
    "}",
    // the `del` of `b[0]` vacates `b[1]`, and the store into `b[0]` ends only `b[0]`: U1d0.2 P1
    "fn main.k3(_1 (b): node mut* own[2]) -> void {",
    "    let _2: u64;",
    "    let _3: u64;",
    "    let _4: node mut* own;",
    "    let _5: i32;",
    "    let _6: i32;",
    "    bb0: {",
    "        _2 = const u64 0;",
    "        _3 = const u64 1;",
    "        del(move _1[_2]);",
    "        _4 = alloc<node>(const u64 1);",
    "        _1[_2] = move _4;",
    "        _5 = copy (*_1[_3]).2;",
    "        _6 = copy (*_1[_2]).2;",
    "        return;",
    "    }",
    "}",
    // an `i8` constant through a cast to `u64` keys the element of the `u64` constant of one value:
    // P1
    "fn main.k4(_1 (b): node mut* own[2]) -> void {",
    "    let _2: u64;",
    "    let _3: u64;",
    "    let _4: node mut* own;",
    "    let _5: i32;",
    "    bb0: {",
    "        _2 = cast<u64>(const i8 1);",
    "        _3 = const u64 1;",
    "        del(move _1[_3]);",
    "        _4 = alloc<node>(const u64 1);",
    "        _1[_2] = move _4;",
    "        _5 = copy (*_1[_3]).2;",
    "        return;",
    "    }",
    "}",
    // in a nested array the first index that differs makes two elements overlap: U1d0.2
    "fn main.k5(_1 (m): node mut* own[2][2]) -> void {",
    "    let _2: u64;",
    "    let _3: u64;",
    "    let _4: i32;",
    "    bb0: {",
    "        _2 = const u64 0;",
    "        _3 = const u64 1;",
    "        del(move _1[_2][_3]);",
    "        _4 = copy (*_1[_3][_3]).2;",
    "        return;",
    "    }",
    "}",
};

