    "    bb0: {",
    "        _3 = copy _2;",
    "        del(move _1[_3]);",
    "        _4 = alloc<node>(const u64 1);",
    "        _1[_3] = move _4;",
    "        _2 = const u64 1;",
    "        _5 = copy (*_1[_3]).2;",
    "        return;",
    "    }",
    "}",
    // a constant through a cast keys the element `b[1]`: a store into `b[1]` ends its state: P1
    "fn main.y3(_1 (b): node mut* own[2]) -> void {",
    "    let _2: u64;",
    "    let _3: node mut* own;",
    "    let _4: u64;",
    "    let _5: i32;",
    "    bb0: {",
    "        _2 = cast<u64>(const i32 1);",
    "        del(move _1[_2]);",
    "        _3 = alloc<node>(const u64 1);",
    "        _1[_2] = move _3;",
    "        _4 = const u64 1;",
    "        _5 = copy (*_1[_4]).2;",
    "        return;",
    "    }",
    "}",
    // a key that is memory is no key: the read reads each owner: U1d0.2
