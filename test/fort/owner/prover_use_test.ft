    "        _2 = move _1.0;",
    "        _3 = copy (*_1.0.1).2;",
    "        _4 = const u64 0;",
    "        _5 = copy (*_1.1[_4]).2;",
    "        return;",
    "    }",
    "}",
    // a read through a pointer names the first owner of the local that can be vacated, `t.e[0]`,
