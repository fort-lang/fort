    "    bb4: {",
    "        return;",
    "    }",
    "    bb5: {",
    "        return;",
    "    }",
    "}",
    // the value of a whole `&&` ends nothing: the arm of its `switch` reads a vacated owner: U1d0.0
    "fn main.f3(_1 (p): node mut* own, _2 (c): bool) -> void {",
    "    let _3: bool;",
    "    let _4: bool;",
    "    let _5: i32;",
    "    bb0: {",
    "        del(move _1);",
    "        switch(copy _2) -> [true: bb1, otherwise: bb2];",
