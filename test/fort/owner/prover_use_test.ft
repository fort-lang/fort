    "    bb0: {",
    "        _1 = alloc<node>(const u64 1);",
    "        global main.P = addr mut(_1);",
    "        del(move (*global main.P));",
    "        _2 = copy (*_1).2;",
    "        return;",
    "    }",
    "}",
    // a `move` through a global vacates the memory owner, with no call: U1m0.2
    "fn main.b13() -> void {",
    "    let _1 (x): node mut* own;",
    "    let _2: node mut* own;",
    "    let _3: i32;",
    "    bb0: {",
    "        _1 = alloc<node>(const u64 1);",
    "        global main.P = addr mut(_1);",
    "        _2 = move (*global main.P);",
    "        _3 = copy (*_1).2;",
    "        del(move _2);",
    "        return;",
    "    }",
    "}",
    // a place through an `own` global lies in an allocation, and a global itself holds no local
