// Inside one statement the reads come in evaluation order, and a `move` operand vacates its place
// right after its read. A `del` vacates its operand after the reads of its access path. A call
// vacates after the reads of its operands and before the reads of the pointers of its destination,
// and a store ends the state after the reads of its right side and of its destination. A terminator
// reads its operands, and `check(overwrite: p)` reads the pointers of the address of `p` and no
// value of `p`.
string[93] ORDER = {
    // D17.21: `take(move(p), *p)` reads `p` after its `move`: U1m0.0
    "fn main.r1(_1 (p): node mut* own) -> void {",
    "    let _2: void;",
    "    bb0: {",
    "        _2 = call fn main.take(move _1, copy (*_1).2);",
    "        return;",
    "    }",
    "}",
    // the read before the `move` in one statement is proved: P1
    "fn main.r2(_1 (p): node mut* own) -> void {",
    "    let _2: void;",
    "    bb0: {",
    "        _2 = call fn main.take2(copy (*_1).2, move _1);",
    "        return;",
    "    }",
    "}",
    // a `del` reads its access path, and a `del` of `p` vacated it: U1d0.0
    "fn main.r3(_1 (p): node mut* own) -> void {",
    "    bb0: {",
    "        del(move _1);",
    "        del(move (*_1).0);",
    "        return;",
    "    }",
    "}",
    // a call vacates a memory owner before the reads of the pointers of its destination: U1c0.2
    "fn main.r4() -> void {",
    "    let _1 (p): node mut* own;",
    "    let _2: node mut* own mut*;",
    "    bb0: {",
    "        _1 = alloc<node>(const u64 1);",
    "        _2 = addr mut(_1);",
    "        (*_1).0 = call fn main.make();",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // the store of the result of a call ends the state that the call left: P1
    "fn main.r5() -> void {",
    "    let _1 (p): node mut* own;",
    "    let _2: node mut* own mut*;",
    "    let _3: i32;",
    "    bb0: {",
    "        _2 = addr mut(_1);",
    "        _1 = call fn main.make();",
    "        _3 = copy (*_1).2;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // the right side of a store reads before the store ends the state: U1d0.0
    "fn main.r6(_1 (p): node mut* own) -> void {",
    "    let _2: i32;",
    "    bb0: {",
    "        del(move _1);",
    "        _1 = call fn main.fill(copy _1);",
    "        _2 = copy (*_1).2;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // `return` reads `_0`: U0m0.1
    "fn main.r7() -> node mut* own {",
    "    let _0: node mut* own;",
    "    let _1: node mut* own;",
    "    bb0: {",
    "        _0 = alloc<node>(const u64 1);",
    "        _1 = move _0;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // `check(overwrite: (*p).0)` reads `p`, and `check(overwrite: p)` reads no value: U1d0.0 U1d0.0
    "fn main.r8(_1 (p): node mut* own) -> void {",
    "    let _2: node mut* own;",
    "    let _3: node mut* own;",
    "    bb0: {",
    "        del(move _1);",
    "        _2 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_1).0 = move _2;",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: _1) -> bb2;",
    "    }",
    "    bb2: {",
    "        _1 = move _3;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // two reads of one local in one item give one use, and two locals two: U1d0.0 P2
    "fn main.r9(_1 (p): node mut* own, _2 (q): node mut* own) -> void {",
    "    let _3: i32;",
    "    let _4: i32;",
    "    bb0: {",
    "        del(move _1);",
    "        _3 = add(copy (*_1).2, copy (*_2).2);",
    "        _4 = add(copy (*_2).2, copy (*_2).2);",
    "        return;",
    "    }",
    "}",
};

