    "    }",
    "    bb3: {",
    "        _3 = copy (*_2).2;",
    "        del(move _2);",
    "        return;",
    "    }",
    "}",
    // a store on one arm only leaves the other path vacated: U2d0.1
    "fn main.j5(_1 (c): bool) -> void {",
