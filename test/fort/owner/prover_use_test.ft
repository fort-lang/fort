// The state joins by union at each block with more than one predecessor, from each arm of a
// `switch` and along each `goto`. A store on each path ends the state, and a store on one path only
// does not. `live` and `dead` store nothing, and a parameter is not vacated at the entry.
string[159] JOINS = {
    // a `del` in the middle arm of three reaches the join: U2d2.0
    "fn main.j1(_1 (k): i32) -> void {",
    "    let _2 (p): node mut* own;",
    "    let _3: i32;",
    "    bb0: {",
    "        _2 = alloc<node>(const u64 1);",
    "        switch(copy _1) -> [i32 0: bb1, i32 1: bb2, otherwise: bb3];",
    "    }",
    "    bb1: {",
    "        goto bb4;",
    "    }",
    "    bb2: {",
    "        del(move _2);",
    "        goto bb4;",
    "    }",
    "    bb3: {",
    "        goto bb4;",
    "    }",
    "    bb4: {",
    "        _3 = copy (*_2).2;",
    "        del(move _2);",
    "        return;",
    "    }",
    "}",
    // a chain of `goto` carries the state: U1d0.1
    "fn main.j2() -> void {",
    "    let _1 (p): node mut* own;",
    "    let _2: i32;",
    "    bb0: {",
    "        _1 = alloc<node>(const u64 1);",
    "        del(move _1);",
    "        goto bb1;",
    "    }",
    "    bb1: {",
    "        goto bb2;",
    "    }",
    "    bb2: {",
    "        _2 = copy (*_1).2;",
    "        return;",
    "    }",
    "}",
    // a block that is its own successor carries its `del` to its first read: U2d1.1
    "fn main.j3(_1 (c): bool) -> void {",
    "    let _2 (p): node mut* own;",
    "    let _3: i32;",
    "    bb0: {",
    "        _2 = alloc<node>(const u64 1);",
    "        goto bb1;",
    "    }",
    "    bb1: {",
    "        _3 = copy (*_2).2;",
    "        del(move _2);",
    "        switch(copy _1) -> [true: bb1, otherwise: bb2];",
