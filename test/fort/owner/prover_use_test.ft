//! run
//! flags: -I ../../src -I support
//! stdout:
//| vacate ok
//| overlap ok
//| keys ok
//| borrows ok
//| ends ok
//| order ok
//| reads ok
//| paths ok
//| spans ok
//| temps ok
//| calls ok
//| tempkeys ok
//| forms ok
//| aborts ok
//| nested ok
//| operands ok
//| joins ok
//| consts ok
//| expose ok
//| limit ok
/// Checks the proof of rule (b) in owner.prover (D17.21): a use of a local owner after a `move`
/// or a `del`. Each group of cases over FIR text holds one part of the rule, with a case that the
/// pass proves and a case that it does not prove: the operations that vacate an owner, the places
/// that overlap it, the keys, the borrows of a place through a pointer, the events that end the
/// state, the order inside one statement, the reads that are uses and those that are not, and the
/// paths. Then the limit of the work. report_use_test checks the lines of the report over lowered
/// fort source.
import fort.fir;
import fort.owner.prover;
import lower_env;
import pass_env;
import std.strbuf;

// The types, the globals and the functions that the FIR text of each case names. A `node` has two
// owning fields and an `i32`, and a `pair` two owning fields. `keep` stores its pointer in the
// global `P`, which `get` returns.
string[48] PRELUDE = {
    "struct node {",
    "    node mut* own left;",
    "    node mut* own right;",
    "    i32 v;",
    "    i64 w;",
    "}",
    "struct pair {",
    "    node mut* own a;",
    "    node mut* own b;",
    "}",
    "node mut* own mut G = null;",
    "node mut* own mut* mut P = null;",
    "fn g() void {",
    "}",
    "fn take(node mut* own n, i32 v) void {",
    "    del(n);",
    "}",
    "fn take2(i32 v, node mut* own n) void {",
    "    del(n);",
    "}",
    "fn make() node mut* own {",
    "    return new(node);",
    "}",
    "fn fill(node mut* n) node mut* own {",
    "    return new(node);",
    "}",
    "fn keep(node mut* own mut* p) void {",
    "    P = p;",
    "}",
    "fn get() node mut* own mut* {",
    "    return P;",
    "}",
    "struct bag {",
    "    u8 mut@ own data;",
    "    u64 n;",
    "}",
    "fn peek(node mut* n) void {",
    "}",
    "extern fn ext_touch(node mut* own mut* n) i32;",
    "struct outer {",
    "    pair p;",
    "    node mut* own[2] e;",
    "}",
    "pair mut GS = pair{.a = null, .b = null};",
    "struct mix {",
    "    node mut* own o;",
    "    i32 v;",
    "}",
};

// Each group is a FIR module and the uses of each of its functions (write_uses), one word for each
// use in the order of prover.proof.uses: `P` and the local for a use that the pass proves, and `U`
// and the local for one that it does not prove, then the kind of the operation of its note (`m`
// for a `move`, `d` for a `del`, `c` for a call, `n` past the limit) and its block and statement,
// and `#` and the number of the owner when it is not 0. The comment of a case gives its uses.

// ---- the cases over FIR text ---------------------------------------------------------------

// The operations that vacate a local owner: a `move` or a `del` of a place that can overlap it, the
// implicit `move` of `return x`, and a call when the owner is memory. `alloc` and `del` are no
// calls.
string[87] VACATE = {
    // a `del` vacates its place, and a load through it is a use: U1d0.0
    "fn main.v1(_1 (p): node mut* own) -> void {",
    "    let _2: i32;",
    "    bb0: {",
    "        del(move _1);",
    "        _2 = copy (*_1).2;",
    "        return;",
    "    }",
    "}",
    // a load before the `del` is proved: P1
    "fn main.v2(_1 (p): node mut* own) -> void {",
    "    let _2: i32;",
    "    bb0: {",
    "        _2 = copy (*_1).2;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // a `move` vacates its place: U1m0.0
    "fn main.v3(_1 (p): node mut* own) -> void {",
    "    let _2: node mut* own;",
    "    let _3: i32;",
    "    bb0: {",
    "        _2 = move _1;",
    "        _3 = copy (*_1).2;",
    "        del(move _2);",
    "        return;",
    "    }",
    "}",
    // the implicit `move` of `return x` vacates `x`, and the `return` reads `_0`: U1m0.0 P0
    "fn main.v4(_1 (p): node mut* own) -> node mut* own {",
    "    let _0: node mut* own;",
    "    let _2: i32;",
    "    bb0: {",
    "        _0 = move _1;",
    "        _2 = copy (*_1).2;",
    "        return;",
    "    }",
    "}",
    // a call vacates a memory owner: U1c0.2
    "fn main.v5() -> void {",
    "    let _1 (p): node mut* own;",
    "    let _2: node mut* own mut*;",
    "    let _3: void;",
    "    let _4: i32;",
    "    bb0: {",
    "        _1 = alloc<node>(const u64 1);",
    "        _2 = addr mut(_1);",
    "        _3 = call fn main.g();",
    "        _4 = copy (*_1).2;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // a call keeps an owner that is no memory: P1
    "fn main.v6() -> void {",
    "    let _1 (p): node mut* own;",
    "    let _2: void;",
    "    let _3: i32;",
    "    bb0: {",
    "        _1 = alloc<node>(const u64 1);",
    "        _2 = call fn main.g();",
    "        _3 = copy (*_1).2;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // `alloc` and `del` of another local are no calls: P1
    "fn main.v7() -> void {",
    "    let _1 (p): node mut* own;",
    "    let _2: node mut* own mut*;",
    "    let _3: node mut* own;",
    "    let _4: i32;",
    "    bb0: {",
    "        _1 = alloc<node>(const u64 1);",
    "        _2 = addr mut(_1);",
    "        _3 = alloc<node>(const u64 1);",
    "        del(move _3);",
    "        _4 = copy (*_1).2;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // a global and a place through a parameter are no local owners: no use
    "fn main.v8(_1 (q): pair mut*) -> void {",
    "    let _2: i32;",
    "    let _3: i32;",
    "    bb0: {",
    "        del(move global main.G);",
    "        _2 = copy (*global main.G).2;",
    "        del(move (*_1).0);",
    "        _3 = copy (*(*_1).0).2;",
    "        return;",
    "    }",
    "}",
};

string[8] VACATE_USES = {"U1d0.0", "P1", "U1m0.0", "U1m0.0 P0", "U1c0.2", "P1", "P1", ""};

// A place in the fixed storage of the local of an owner that is not separate from it can overlap
// it: the owner, a place that contains it and each element of one fixed array. A read of a tracked
// place uses the owners below it and the owner of which it is a part; a read with an index that is
// no key uses each owner that it can overlap.
string[89] OVERLAP = {
    // a `del` of `s.a` keeps `s.b`: P1 U1d0.0
    "fn main.o1(_1 (s): pair) -> void {",
    "    let _2: i32;",
    "    let _3: i32;",
    "    bb0: {",
    "        del(move _1.0);",
    "        _2 = copy (*_1.1).2;",
    "        _3 = copy (*_1.0).2;",
    "        return;",
    "    }",
    "}",
    // a `move` of `s` vacates `s.b`: U1m0.0
    "fn main.o2(_1 (s): pair) -> void {",
    "    let _2: pair;",
    "    let _3: i32;",
    "    bb0: {",
    "        _2 = move _1;",
    "        _3 = copy (*_1.1).2;",
    "        return;",
    "    }",
    "}",
    // a read of a whole struct reads each owner of it: the `return` reads `_0`, whose first owner
    // that can be vacated is `_0.b`: U0d0.1#1
    "fn main.o3(_1 (s): pair) -> pair {",
    "    let _0: pair;",
    "    bb0: {",
    "        _0 = move _1;",
    "        del(move _0.1);",
    "        return;",
    "    }",
    "}",
    // a `del` of `b[k]` vacates `b[j]`: U1d0.0
    "fn main.o4(_1 (b): node mut* own[2], _2 (k): u64, _3 (j): u64) -> void {",
    "    let _4: i32;",
    "    bb0: {",
    "        del(move _1[_2]);",
    "        _4 = copy (*_1[_3]).2;",
    "        return;",
    "    }",
    "}",
    // a store into `b[k]` ends the state of `b[k]` and of no other element: P1 U1d0.0
    "fn main.o5(_1 (b): node mut* own[2], _2 (k): u64, _3 (j): u64) -> void {",
    "    let _4: node mut* own;",
    "    let _5: i32;",
    "    let _6: i32;",
    "    bb0: {",
    "        del(move _1[_2]);",
    "        _4 = alloc<node>(const u64 1);",
    "        _1[_2] = move _4;",
    "        _5 = copy (*_1[_2]).2;",
    "        _6 = copy (*_1[_3]).2;",
    "        return;",
    "    }",
    "}",
    // an index with no key reads each owner of `b`, and `b[1]` can be vacated; the read itself is
    // of an `own` type, so the use names it: U1d0.3
    "fn main.o6(_1 (b): node mut* own[2], _2 (k): u64) -> void {",
    "    let _3: u64;",
    "    let _4: u64;",
    "    let _5: node mut* own;",
    "    let _6: i32;",
    "    bb0: {",
    "        _3 = const u64 0;",
    "        _3 = const u64 1;",
    "        _4 = const u64 0;",
    "        del(move _1[_2]);",
    "        _5 = alloc<node>(const u64 1);",
    "        _1[_4] = move _5;",
    "        _6 = copy (*_1[_3]).2;",
    "        return;",
    "    }",
    "}",
    // a constant key names one owner: P1
    "fn main.o7(_1 (b): node mut* own[2]) -> void {",
    "    let _2: u64;",
    "    let _3: u64;",
    "    let _4: node mut* own;",
    "    let _5: i32;",
    "    bb0: {",
    "        _2 = const u64 0;",
    "        _3 = cast<u64>(const i32 0);",
    "        del(move _1[_2]);",
    "        _4 = alloc<node>(const u64 1);",
    "        _1[_2] = move _4;",
    "        _5 = copy (*_1[_3]).2;",
    "        return;",
    "    }",
    "}",
    // a read through a pointer reads each owner of the memory local; the first that can be vacated
    // is `s.b`: U1d0.1#1
    "fn main.o8(_1 (s): pair) -> void {",
    "    let _2: pair*;",
    "    let _3: bool;",
    "    bb0: {",
    "        _2 = addr(_1);",
    "        del(move _1.1);",
    "        _3 = eq(copy (*_2).0, copy (*_2).1);",
    "        return;",
    "    }",
    "}",
};

string[8] OVERLAP_USES = {
    "P1 U1d0.0", "U1m0.0", "U0d0.1#1", "U1d0.0", "P1 U1d0.0", "U1d0.3", "P1", "U1d0.1#1",
};

// A store ends the state only when no store into a key of its destination follows it on the path. A
// store into the whole array has no key, and its end holds.
string[107] KEYS = {
    // D17.21: `del(b[k]); k = 1; del(b[k]); b[k] = new(i32); k = 0; *b[k]`: U1d0.2, the first `del`
    "fn main.k1() -> void {",
    "    let _1 (b): node mut* own[2];",
    "    let _2 (k): u64;",
    "    let _3: node mut* own;",
    "    let _4: i32;",
    "    bb0: {",
    "        _1 = const zero node mut* own[2];",
    "        _2 = const u64 0;",
    "        del(move _1[_2]);",
    "        _2 = const u64 1;",
    "        del(move _1[_2]);",
    "        _3 = alloc<node>(const u64 1);",
    "        _1[_2] = move _3;",
    "        _2 = const u64 0;",
    "        _4 = copy (*_1[_2]).2;",
    "        return;",
    "    }",
    "}",
    // D17.21: with no store into `k` after the store into `b[k]`: P1
    "fn main.k2() -> void {",
    "    let _1 (b): node mut* own[2];",
    "    let _2 (k): u64;",
    "    let _3: node mut* own;",
    "    let _4: i32;",
    "    bb0: {",
    "        _1 = const zero node mut* own[2];",
    "        _2 = const u64 1;",
    "        del(move _1[_2]);",
    "        _3 = alloc<node>(const u64 1);",
    "        _1[_2] = move _3;",
    "        _4 = copy (*_1[_2]).2;",
    "        return;",
    "    }",
    "}",
    // a store into the whole array ends the state of `b[k]`, and a later store into `k` undoes
    // nothing: P1
    "fn main.k3() -> void {",
    "    let _1 (b): node mut* own[2];",
    "    let _2 (k): u64;",
    "    let _3: i32;",
    "    bb0: {",
    "        _1 = const zero node mut* own[2];",
    "        _2 = const u64 0;",
    "        del(move _1[_2]);",
    "        _1 = const zero node mut* own[2];",
    "        _2 = const u64 1;",
    "        _3 = copy (*_1[_2]).2;",
    "        return;",
    "    }",
    "}",
    // a store into `k` before the store into `b[k]` undoes nothing: P1
    "fn main.k4() -> void {",
    "    let _1 (b): node mut* own[2];",
    "    let _2 (k): u64;",
    "    let _3: node mut* own;",
    "    let _4: i32;",
    "    bb0: {",
    "        _1 = const zero node mut* own[2];",
    "        _2 = const u64 0;",
    "        del(move _1[_2]);",
    "        _2 = const u64 1;",
    "        _3 = alloc<node>(const u64 1);",
    "        _1[_2] = move _3;",
    "        _4 = copy (*_1[_2]).2;",
    "        return;",
    "    }",
    "}",
    // two keys: a store into the outer key undoes the end of the store into `c[i][k]`, which holds
    // both keys: U3d0.3
    "fn main.k5(_1 (i): u64, _2 (k): u64) -> void {",
    "    let _3 (c): node mut* own[2][2];",
    "    let _4: node mut* own;",
    "    let _5: i32;",
    "    bb0: {",
    "        _3 = const zero node mut* own[2][2];",
    "        _1 = const u64 0;",
    "        _2 = const u64 0;",
    "        del(move _3[_1][_2]);",
    "        _4 = alloc<node>(const u64 1);",
    "        _3[_1][_2] = move _4;",
    "        _1 = const u64 1;",
    "        _5 = copy (*_3[_1][_2]).2;",
    "        return;",
    "    }",
    "}",
    // two keys: a store into `c[i]`, which holds only the outer key, ends the state, and a store
    // into the inner key undoes nothing: P3
    "fn main.k6(_1 (i): u64, _2 (k): u64) -> void {",
    "    let _3 (c): node mut* own[2][2];",
    "    let _4: i32;",
    "    bb0: {",
    "        _3 = const zero node mut* own[2][2];",
    "        _1 = const u64 0;",
    "        _2 = const u64 0;",
    "        del(move _3[_1][_2]);",
    "        _3[_1] = const zero node mut* own[2];",
    "        _2 = const u64 1;",
    "        _4 = copy (*_3[_1][_2]).2;",
    "        return;",
    "    }",
    "}",
    // a read with a local key two blocks after the `del`: U1d0.0
    "fn main.k7(_1 (b): node mut* own[2], _2 (k): u64, _3 (c): bool) -> void {",
    "    let _4: i32;",
    "    bb0: {",
    "        del(move _1[_2]);",
    "        switch(copy _3) -> [true: bb1, otherwise: bb2];",
    "    }",
    "    bb1: {",
    "        _4 = copy (*_1[_2]).2;",
    "        goto bb2;",
    "    }",
    "    bb2: {",
    "        return;",
    "    }",
    "}",
};

string[7] KEYS_USES = {"U1d0.2", "P1", "P1", "P1", "U3d0.3", "P3", "U1d0.0"};

// A `move`, a `del` or a read of a place through a pointer reaches a memory owner only when the
// place can be a place of its local (D17.11, Borrows), also a place through a global. A place
// through an `own` pointer lies in an allocation.
string[187] BORROWS = {
    // D17.21: `del(*px); *x = 1;`: U1d0.2
    "fn main.b1() -> void {",
    "    let _1 (x): node mut* own;",
    "    let _2 (px): node mut* own mut*;",
    "    let _3: i32;",
    "    bb0: {",
    "        _1 = alloc<node>(const u64 1);",
    "        _2 = addr mut(_1);",
    "        del(move (*_2));",
    "        _3 = copy (*_1).2;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // D17.21: `del(*r); *x = 1;` for a parameter `r`, which borrows no origin: P2
    "fn main.b2(_1 (r): node mut* own mut*) -> void {",
    "    let _2 (x): node mut* own;",
    "    let _3 (px): node mut* own mut*;",
    "    let _4: i32;",
    "    bb0: {",
    "        _2 = alloc<node>(const u64 1);",
    "        _3 = addr mut(_2);",
    "        del(move (*_1));",
    "        _4 = copy (*_2).2;",
    "        del(move _2);",
    "        return;",
    "    }",
    "}",
    // D17.21: `del(x); **px`: the read of `*px` can overlap `x`: U1d0.2
    "fn main.b3() -> void {",
    "    let _1 (x): node mut* own;",
    "    let _2 (px): node mut* own mut*;",
    "    let _3: i32;",
    "    bb0: {",
    "        _1 = alloc<node>(const u64 1);",
    "        _2 = addr mut(_1);",
    "        del(move _1);",
    "        _3 = copy (*(*_2)).2;",
    "        return;",
    "    }",
    "}",
    // D17.21: `del(x); del(*px);`: the operand of a `del` is no use, also through a pointer: no use
    "fn main.b4() -> void {",
    "    let _1 (x): node mut* own;",
    "    let _2 (px): node mut* own mut*;",
    "    bb0: {",
    "        _1 = alloc<node>(const u64 1);",
    "        _2 = addr mut(_1);",
    "        del(move _1);",
    "        del(move (*_2));",
    "        return;",
    "    }",
    "}",
    // a read through a parameter, which borrows no origin, uses no memory owner: no use
    "fn main.b5(_1 (r): node mut* own mut*) -> void {",
    "    let _2 (x): node mut* own;",
    "    let _3 (px): node mut* own mut*;",
    "    let _4: i32;",
    "    bb0: {",
    "        _2 = alloc<node>(const u64 1);",
    "        _3 = addr mut(_2);",
    "        del(move _2);",
    "        _4 = copy (*(*_1)).2;",
    "        return;",
    "    }",
    "}",
    // a read through an `own` pointer uses no memory owner, and reads the pointer: P1
    "fn main.b6(_1 (n): pair mut* own) -> void {",
    "    let _2 (x): node mut* own;",
    "    let _3 (px): node mut* own mut*;",
    "    let _4: node mut* own;",
    "    bb0: {",
    "        _2 = alloc<node>(const u64 1);",
    "        _3 = addr mut(_2);",
    "        del(move _2);",
    "        _4 = move (*_1).0;",
    "        del(move _4);",
    "        return;",
    "    }",
    "}",
    // an exposed local: a pointer from a call can name it: U1d0.5
    "fn main.b7() -> void {",
    "    let _1 (x): node mut* own;",
    "    let _2: node mut* own mut*;",
    "    let _3: void;",
    "    let _4: node mut* own mut*;",
    "    let _5: i32;",
    "    bb0: {",
    "        _1 = alloc<node>(const u64 1);",
    "        _2 = addr mut(_1);",
    "        _3 = call fn main.keep(copy _2);",
    "        _4 = call fn main.get();",
    "        _1 = alloc<node>(const u64 1);",
    "        del(move (*_4));",
    "        _5 = copy (*_1).2;",
    "        return;",
    "    }",
    "}",
    // a local that is not exposed: the pointer from a call names no frame of the function: P1
    "fn main.b8() -> void {",
    "    let _1 (x): node mut* own;",
    "    let _2: node mut* own mut*;",
    "    let _3: node mut* own mut*;",
    "    let _4: i32;",
    "    bb0: {",
    "        _2 = addr mut(_1);",
    "        _3 = call fn main.get();",
    "        _1 = alloc<node>(const u64 1);",
    "        del(move (*_3));",
    "        _4 = copy (*_1).2;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // the `.len` of a span through a pointer is a use of the memory owner: U1m0.1
    "fn main.b9(_1 (buf): u8 mut@ own) -> void {",
    "    let _2: u8 mut@ own*;",
    "    let _3: u8 mut@ own;",
    "    let _4: u64;",
    "    bb0: {",
    "        _2 = addr(_1);",
    "        _3 = move _1;",
    "        _4 = copy (*_2).1;",
    "        del(move _3);",
    "        return;",
    "    }",
    "}",
    // a comparison with null through a pointer is no use: no use
    "fn main.b10() -> void {",
    "    let _1 (x): node mut* own;",
    "    let _2 (px): node mut* own mut*;",
    "    let _3: bool;",
    "    bb0: {",
    "        _1 = alloc<node>(const u64 1);",
    "        _2 = addr mut(_1);",
    "        del(move _1);",
    "        _3 = eq(copy (*_2), const null node mut* own);",
    "        return;",
    "    }",
    "}",
    // a load through a global that holds the address of a memory owner can read it, with no call:
    // U1d0.2
    "fn main.b11() -> void {",
    "    let _1 (x): node mut* own;",
    "    let _2: i32;",
    "    bb0: {",
    "        _1 = alloc<node>(const u64 1);",
    "        global main.P = addr mut(_1);",
    "        del(move _1);",
