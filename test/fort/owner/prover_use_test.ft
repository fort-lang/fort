    "        _5 = copy (*_1[_2]).2;",
    "        return;",
    "    }",
    "}",
    // a loop that stores into its index: the back edge undoes the end of the store into `b[k]`:
    // U1d2.0
    "fn main.y5(_1 (b): node mut* own[2], _2 (c): bool) -> void {",
