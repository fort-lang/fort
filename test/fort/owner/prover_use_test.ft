    "    let _2: u8 mut@ own;",
    "    let _3: u64;",
    "    bb0: {",
    "        _2 = move _1;",
    "        _3 = copy _1.1;",
    "        del(move _2);",
    "        return;",
    "    }",
    "}",
    // a comparison with null, of the owner and of its `.ptr`, is no use: no use
    "fn main.u3(_1 (p): node mut* own, _2 (buf): u8 mut@ own) -> void {",
    "    let _3: bool;",
    "    let _4: bool;",
    "    let _5: u8 mut@ own;",
    "    bb0: {",
    "        del(move _1);",
    "        _5 = move _2;",
    "        _3 = eq(const null node mut* own, copy _1);",
    "        _4 = ne(copy _2.0, const zero u8 mut*);",
    "        del(move _5);",
    "        return;",
    "    }",
    "}",
    // a comparison with another pointer is a use: U1d0.0
    "fn main.u4(_1 (p): node mut* own, _2 (q): node mut*) -> void {",
    "    let _3: bool;",
    "    bb0: {",
    "        del(move _1);",
    "        _3 = eq(copy _1, copy _2);",
    "        return;",
    "    }",
    "}",
    // a store and an address are no uses: no use
    "fn main.u5(_1 (p): node mut* own) -> void {",
    "    let _2: node mut* own;",
    "    let _3: node mut* own*;",
    "    bb0: {",
    "        del(move _1);",
    "        _3 = addr(_1);",
    "        _2 = alloc<node>(const u64 1);",
    "        _1 = move _2;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // a span expression of the owner and a copy of its `.ptr` are uses: U1m0.0 U1m0.0
    "fn main.u6(_1 (buf): u8 mut@ own) -> void {",
    "    let _2: u8 mut@ own;",
    "    let _3: u8 mut@;",
    "    let _4: u8 mut*;",
    "    bb0: {",
    "        _2 = move _1;",
    "        _3 = slice(_1, const u64 0, const u64 0);",
    "        _4 = copy _1.0;",
    "        del(move _2);",
    "        return;",
    "    }",
    "}",
    // an index into a span reads its header, a use: U1m0.0
    "fn main.u7(_1 (buf): u8 mut@ own) -> void {",
    "    let _2: u8 mut@ own;",
    "    let _3: u64;",
    "    let _4: u8;",
    "    bb0: {",
    "        _2 = move _1;",
    "        _3 = const u64 0;",
    "        _4 = copy _1[_3];",
    "        del(move _2);",
    "        return;",
    "    }",
    "}",
    // a copy of the owner into a view is a use: U1d0.0
    "fn main.u8(_1 (p): node mut* own) -> void {",
    "    let _2: node mut*;",
    "    bb0: {",
