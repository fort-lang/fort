    "    let _4: bool;",
    "    bb0: {",
    "        _2 = addr(_1);",
    "        _3 = const u64 1;",
    "        del(move _1.1[_3]);",
    "        _4 = eq(copy (*_2).0.0, copy (*_2).0.1);",
    "        return;",
    "    }",
    "}",
    // the `return` of a whole `outer` names its first owner that can be vacated, `_0.p.b`: U0d0.1#1
