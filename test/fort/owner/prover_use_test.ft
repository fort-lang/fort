// The forms of a test against null of gen rule 6 of D17.11: a copy of a flag, a negation, the left
// operand of `&&` and of `||`, whose edge into the right operand ends the state, and the value of a
// whole `&&`, which ends nothing.
string[145] FORMS = {
    // a copy of the flag keeps the edge: P1
    "fn main.f1(_1 (p): node mut* own) -> void {",
    "    let _2: bool;",
    "    let _3: bool;",
    "    let _4: i32;",
    "    bb0: {",
    "        del(move _1);",
    "        _2 = ne(copy _1, const null node mut* own);",
    "        _3 = copy _2;",
    "        switch(copy _3) -> [true: bb1, otherwise: bb2];",
