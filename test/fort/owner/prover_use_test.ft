    "        return;",
    "    }",
    "    bb5: {",
    "        return;",
    "    }",
    "}",
    // the left operand of `||` with `==`: the right operand runs on the edge of another value: P1
    "fn main.f4(_1 (p): node mut* own) -> void {",
    "    let _2: bool;",
    "    let _3: bool;",
    "    let _4: i32;",
    "    bb0: {",
    "        del(move _1);",
    "        _2 = eq(copy _1, const null node mut* own);",
    "        switch(copy _2) -> [true: bb2, otherwise: bb1];",
    "    }",
    "    bb1: {",
    "        _4 = copy (*_1).2;",
    "        _3 = eq(copy _4, const i32 1);",
    "        goto bb3;",
    "    }",
    "    bb2: {",
    "        _3 = const true;",
    "        goto bb3;",
