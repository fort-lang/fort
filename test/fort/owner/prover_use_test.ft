// A use is a copy of the owner, of its `.ptr`, or of a place that contains it, a load through it
// and a span expression of it. The operand of a `move` or of a `del`, a read of the `.len` of a
// span or a `string` in fixed storage, a comparison with null, a store and an address are no uses.
string[85] READS = {
    // the operands of a `move` and of a `del` are no uses: no use
    "fn main.u1(_1 (p): node mut* own) -> void {",
    "    let _2: node mut* own;",
    "    bb0: {",
    "        del(move _1);",
    "        _2 = move _1;",
    "        del(move _1);",
    "        del(move _2);",
    "        return;",
    "    }",
    "}",
    // the `.len` of a span in fixed storage is no use: no use
