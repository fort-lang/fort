// A temporary of an `own` reference type and `_0` are local owners. A `move` of a temporary vacates
// it, and `return` reads `_0`.
string[63] TEMPS = {
    // a temporary that a call fills and a load reads: P2
    "fn main.t1() -> void {",
    "    let _1: i32;",
    "    let _2: node mut* own;",
    "    bb0: {",
    "        _2 = call fn main.make();",
    "        _1 = copy (*_2).2;",
    "        del(move _2);",
    "        return;",
    "    }",
    "}",
    // a temporary that a `move` empties and a call fills again: the store of the call ends the
    // state, and V12 refuses a read of a temporary between its `move` and its next store: P2
    "fn main.t2() -> void {",
    "    let _1: i32;",
    "    let _2: node mut* own;",
    "    let _3: void;",
    "    bb0: {",
    "        _2 = call fn main.make();",
    "        _3 = call fn main.take(move _2, const i32 0);",
    "        _2 = call fn main.make();",
    "        _1 = copy (*_2).2;",
    "        del(move _2);",
    "        return;",
    "    }",
    "}",
    // `_0` of an `own` pointer that a `del` empties before the `return`: U0d0.1
    "fn main.t3() -> node mut* own {",
    "    let _0: node mut* own;",
    "    bb0: {",
    "        _0 = alloc<node>(const u64 1);",
    "        del(move _0);",
    "        return;",
    "    }",
    "}",
    // `_0` of an aggregate is memory: a call vacates its owners, and a store into a field ends only
    // that field: U0c0.1#1
    "fn main.t4() -> pair {",
    "    let _0: pair;",
    "    let _1: void;",
    "    let _2: node mut* own;",
    "    bb0: {",
    "        _0 = const zero pair;",
    "        _1 = call fn main.g();",
    "        _2 = alloc<node>(const u64 1);",
    "        _0.0 = move _2;",
    "        return;",
    "    }",
    "}",
    // a store into the whole `_0` after the call ends the state: P0
    "fn main.t5() -> pair {",
    "    let _0: pair;",
    "    let _1: void;",
    "    bb0: {",
    "        _1 = call fn main.g();",
    "        _0 = const zero pair;",
    "        return;",
    "    }",
    "}",
    // a read through a parameter can be a place of `_0`: U0c0.0
    "fn main.t6(_1 (v): i32*) -> pair {",
    "    let _0: pair;",
    "    let _2: void;",
    "    let _3: i32;",
    "    bb0: {",
    "        _2 = call fn main.g();",
    "        _3 = copy (*_1);",
    "        _0 = const zero pair;",
    "        return;",
    "    }",
    "}",
};

string[6] TEMPS_USES = {"P2", "P2", "U0d0.1", "U0c0.1#1", "P0", "U0c0.0 P0"};

// Each call vacates each memory owner: a call of a fort function, a call through a function value
// and a call of an extern. A call reads its callee and its arguments before it vacates, and an
// argument that reads a vacated owner is a use.
string[85] CALLS = {
    // a call through a function value: U1c0.3
    "fn main.c1() -> void {",
    "    let _1 (x): node mut* own;",
    "    let _2: node mut* own mut*;",
    "    let _3: fn () void;",
    "    let _4: void;",
    "    let _5: i32;",
    "    bb0: {",
    "        _1 = alloc<node>(const u64 1);",
    "        _2 = addr mut(_1);",
    "        _3 = const fn main.g;",
    "        _4 = call copy _3();",
    "        _5 = copy (*_1).2;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // a call of an extern: U1c0.2
    "fn main.c2() -> void {",
    "    let _1 (x): node mut* own;",
    "    let _2: node mut* own mut*;",
    "    let _3: i32;",
    "    let _4: i32;",
    "    bb0: {",
    "        _1 = alloc<node>(const u64 1);",
    "        _2 = addr mut(_1);",
    "        _3 = call extern ext_touch(copy _2);",
    "        _4 = copy (*_1).2;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // an argument that reads a vacated owner is a use: U1d0.0
    "fn main.c3(_1 (p): node mut* own) -> void {",
    "    let _2: node mut*;",
    "    let _3: void;",
    "    bb0: {",
    "        del(move _1);",
    "        _3 = call fn main.peek(copy _1);",
    "        return;",
    "    }",
    "}",
    // the argument reads the memory owner before the call vacates it: P1 U1c0.2
    "fn main.c4() -> void {",
    "    let _1 (x): node mut* own;",
    "    let _2: node mut* own mut*;",
    "    let _3: void;",
    "    let _4: i32;",
    "    bb0: {",
    "        _1 = alloc<node>(const u64 1);",
    "        _2 = addr mut(_1);",
    "        _3 = call fn main.peek(copy _1);",
    "        _4 = copy (*_1).2;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // two calls: the note names the first in the order of the source positions: U1c0.2
    "fn main.c5() -> void {",
    "    let _1 (x): node mut* own;",
    "    let _2: node mut* own mut*;",
    "    let _3: void;",
    "    let _4: void;",
    "    let _5: i32;",
    "    bb0: {",
    "        _1 = alloc<node>(const u64 1) #2:1;",
    "        _2 = addr mut(_1) #3:1;",
    "        _3 = call fn main.g() #4:1;",
    "        _4 = call fn main.g() #5:1;",
    "        _5 = copy (*_1).2 #6:1;",
    "        del(move _1) #7:1;",
    "        return #8:1;",
    "    }",
    "}",
    // a later call in the text that stands first in the source: its position orders the note:
    // U1c0.3
    "fn main.c6() -> void {",
    "    let _1 (x): node mut* own;",
    "    let _2: node mut* own mut*;",
    "    let _3: void;",
    "    let _4: void;",
    "    let _5: i32;",
    "    bb0: {",
    "        _1 = alloc<node>(const u64 1) #2:1;",
