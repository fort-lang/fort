// The key of an index temporary is the local that it copies, also through a cast to `u64`, while no
// store into that local follows its copy; a stale temporary has no key, and its place reads each
// owner of the array.
string[82] TEMPKEYS = {
    // a temporary that copies `k` keys the element `b[k]`, and the store into `b[k]` ends its
