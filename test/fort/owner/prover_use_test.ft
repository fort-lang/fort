// ---- the harness -------------------------------------------------------------------------------

// The letter of the operation of a use.
fn op_letter(prover.operation_kind k) char {
    switch (k) {
    case prover.operation_kind.op_move:
        return 'm';
    case prover.operation_kind.op_del:
        return 'd';
    case prover.operation_kind.op_call:
        return 'c';
    case prover.operation_kind.op_none:
        return 'n';
    }
}

/// Writes the uses of `p` into `out`, one word each (see above), and holds the count of the uses
/// that `p` does not prove against the words.
fn write_uses(prover.proof* p, strbuf.str_buf mut* out) void {
    strbuf.clear(out);
    u32 mut unproved = 0;
    u64 mut k = 0;
    while (k < p->uses.len) {
        prover.use* u = &p->uses[k];
        if (k > 0) {
            strbuf.push(out, ' ');
        }
        if (u->proved) {
            strbuf.push(out, 'P');
            strbuf.append_u64(out, cast(u->local, u64));
        } else {
            unproved += 1;
            strbuf.push(out, 'U');
            strbuf.append_u64(out, cast(u->local, u64));
            strbuf.push(out, op_letter(u->op_kind));
            if (u->op_kind != prover.operation_kind.op_none) {
                strbuf.append_u64(out, cast(u->op_block, u64));
                strbuf.push(out, '.');
                strbuf.append_u64(out, cast(u->op_index, u64));
            }
            if (u->owner != 0) {
                strbuf.push(out, '#');
                strbuf.append_u64(out, u->owner);
            }
        }
        k += 1;
    }
    assert(p->use_unproved == unproved);
}

// Parses `text` against PRELUDE, holds that the verifier accepts each function, proves each one,
// and holds that function `k` of the module gives the uses `want[k]`.
fn expect(string@ text, string@ want) void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    fir.module mut m = pass_env.parse(&e, PRELUDE[..], text);
    defer fir.module_free(&m);
    assert(m.funcs.len == want.len);
    strbuf.str_buf mut got = strbuf.create();
    defer strbuf.free(&got);
    u64 mut k = 0;
    while (k < m.funcs.len) {
        fir.func* f = &m.funcs.items[k];
        pass_env.verified(&e, f, "prover_use_test: the verifier refuses the input");
        prover.proof mut p = prover.prove(f);
        write_uses(&p, &got);
        assert(!p.use_over);
        prover.free(&p);
        if (strbuf.view(&got) != want[k]) {
            eprintln("function ", k, " gives '", strbuf.view(&got), "' and not '", want[k], "'");
            panic("prover_use_test: the uses differ");
        }
        k += 1;
    }
}

