};

string[4] TEXT_RELEASED_LINES = {
    "t.fir:4:1: leak: cannot prove '(*_1).1[1]' is empty before this del\n",
    "t.fir:4:1: note: move '(*_1).1[1]' into a local and del it first\n",
    "t.fir:7:1: leak: cannot prove '(*_1).0' is empty before this cast\n",
    "t.fir:7:1: note: move '(*_1).0' into a local and del it first\n",
};

// With no tree, the report of part 2 names the FIR place.
fn the_report_of_part_2_in_a_fir_text_names_the_fir_place() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    fir.module mut m = pass_env.parse(&e, TEXT_PRELUDE[..], TEXT_RELEASED[..]);
    defer fir.module_free(&m);
    strbuf.str_buf mut got = strbuf.create();
    defer strbuf.free(&got);
    u64 mut f = 0;
    while (f < m.funcs.len) {
        prover.proof mut p = prover.prove(fir.module_function_at(&m, f));
        report.write_inners(fir.module_function_at(&m, f), &p, &e.c.m.s, &got);
        prover.free(&p);
        f += 1;
    }
    strbuf.str_buf mut want = strbuf.create();
    defer strbuf.free(&want);
    u64 mut k = 0;
    while (k < TEXT_RELEASED_LINES.len) {
        strbuf.append(&want, TEXT_RELEASED_LINES[k]);
        k += 1;
    }
    if (strbuf.view(&got) != strbuf.view(&want)) {
        eprintln(strbuf.view(&got));
        panic("report_test: the lines of part 2 of a FIR text differ");
    }
}

fn main() i32 {
    the_report_names_each_place_at_its_position();
    the_report_of_a_fir_text_names_the_fir_place();
    the_first_error_past_the_work_limit_names_the_limit();
    the_report_names_each_store_that_no_check_guards();
    the_report_merges_the_errors_at_one_location();
    println("report ok");
    the_leak_errors_name_each_owner_at_its_exit();
    the_leak_errors_of_a_fir_text_name_the_fir_place();
    the_leak_limit_takes_its_own_note();
    a_proof_with_no_leak_has_no_error();
    println("leak errors ok");
    the_report_of_part_2_names_the_first_inner_owner_of_each_site();
    the_report_of_part_2_in_a_fir_text_names_the_fir_place();
    println("part 2 ok");
    return 0;
}
