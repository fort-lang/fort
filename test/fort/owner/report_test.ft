//! run
//! flags: -I ../../src -I support
//! stdout:
//| report ok
//| leak report ok
/// Checks owner.report: the error and the note of D17.11 at each check and each store that
/// owner.prover does not prove, with the source text of its place, at its position, once for each
/// location, and the note of the work limit. Then the line of the leak report (D17.20) at each exit
/// that owner.prover does not prove, with the text of its owner, once for each location and owner.
import check_env;
import fort.fir;
import fort.fir_lower;
import fort.owner.prover;
import fort.owner.report;
import lower_env;
import modules_env;
import pass_env;
import std.str;
import std.strbuf;

// The types, the global and the function that the FIR texts of the cases name.
string[8] PRELUDE = {
    "struct node {",
    "    node mut* own left;",
    "    node mut* own right;",
    "}",
    "node mut* own mut G = null;",
    "fn make() node mut* own {",
    "    return new(node);",
    "}",
};

// Lowers the function `name` of the checked source of `e` into *out, and holds that the
// verifier accepts it.
fn lower(lower_env.env mut* e, string name, fir.func mut* out) void {
    fir_lower.report mut why = fir_lower.report{};
    if (!fir_lower.lower_function(&e->c.ck, lower_env.decl(e, name), out, &why)) {
        panic("report_test: the lowering refuses the function");
    }
    pass_env.verified(e, out, "report_test: the verifier refuses the lowering");
}

// ---- the report --------------------------------------------------------------------------------

// Sources whose checks the pass does not prove. The report names the source text of each target,
// each parenthesis that it needs included, with each run of white space as one space, and the
// declared name of a declaration. The `defer` expands into two checks at one location.
string[60] REPORTED = {
    "struct node {",
    "    node mut* own left;",
    "    node mut* own right;",
    "}",
    "node mut* own mut G = null;",
    "fn refill(node mut* b) void {",
    "    b->left = new(node);",
    "}",
    "fn paren(node mut* q, node mut* own x) void {",
    "    (*q).right = move(x);",
    "}",
    "fn global_alone(node mut* own x) void {",
    "    G = move(x);",
    "}",
    "fn loop_leak() void {",
    "    for (i32 mut i = 0; i < 3; i++) {",
    "        node mut* own p = new(node);",
    "    }",
    "}",
    "fn param(node mut* own mut p) void {",
    "    p = new(node);",
    "    del(p);",
    "}",
    "fn deferred(node mut* b, bool c) void {",
    "    defer b->left = new(node);",
    "    if (c) {",
    "        return;",
    "    }",
    "}",
    "fn nested(node mut* q, node mut* own x) void {",
    "    ((*q)).right = move(x);",
    "}",
    "fn first(u64 n) u64 {",
    "    return n;",
    "}",
    "fn index_call(node mut* own[4] mut* a, node mut* own x) void {",
    "    (*a)[first(1)] = move(x);",
    "}",
    "fn multi(node mut* q, node mut* own x) void {",
    "    q",
    "        ->right = move(x);",
    "}",
    "struct tree {",
    "    node mut* own[2] kids;",
    "    tree mut* own sub;",
    "}",
    "fn kid(tree mut* t, node mut* own x) void {",
    "    t->kids[1] = move(x);",
    "}",
    "fn deep(tree mut* t, node mut* own x) void {",
    "    t->sub->kids[0] = move(x);",
    "}",
    "fn star(node mut* own mut* out, node mut* own x) void {",
    "    *out = move(x);",
    "}",
    "fn local_field(node mut* own x) void {",
    "    tree mut t = tree{};",
    "    t.kids[0] = move(x);",
    "    t.kids[0] = null;",
    "}",
};

string[13] REPORTED_NAMES = {
    "refill", "paren", "global_alone", "loop_leak", "param", "deferred", "nested", "index_call",
    "multi", "kid", "deep", "star", "local_field",
};

// The error and the note of each function of REPORTED, in order.
string[26] REPORTS = {
    "7:13: overwriting owned value: cannot prove 'b->left' is empty here",
    "7:13: del or move 'b->left' before this store",
    "10:16: overwriting owned value: cannot prove '(*q).right' is empty here",
    "10:16: del or move '(*q).right' before this store",
    "13:7: overwriting owned value: cannot prove 'G' is empty here",
    "13:7: del or move 'G' before this store",
    "17:23: overwriting owned value: cannot prove 'p' is empty here",
    "17:23: del or move 'p' before this store",
    "21:7: overwriting owned value: cannot prove 'p' is empty here",
    "21:7: del or move 'p' before this store",
    "25:19: overwriting owned value: cannot prove 'b->left' is empty here",
    "25:19: del or move 'b->left' before this store",
    "31:18: overwriting owned value: cannot prove '((*q)).right' is empty here",
    "31:18: del or move '((*q)).right' before this store",
    "37:20: overwriting owned value: cannot prove '(*a)[first(1)]' is empty here",
    "37:20: del or move '(*a)[first(1)]' before this store",
    "41:17: overwriting owned value: cannot prove 'q ->right' is empty here",
    "41:17: del or move 'q ->right' before this store",
    "48:16: overwriting owned value: cannot prove 't->kids[1]' is empty here",
    "48:16: del or move 't->kids[1]' before this store",
    "51:21: overwriting owned value: cannot prove 't->sub->kids[0]' is empty here",
    "51:21: del or move 't->sub->kids[0]' before this store",
    "54:10: overwriting owned value: cannot prove '*out' is empty here",
    "54:10: del or move '*out' before this store",
    "59:15: overwriting owned value: cannot prove 't.kids[0]' is empty here",
    "59:15: del or move 't.kids[0]' before this store",
};

// The report of each check that the pass does not prove: the error and its note at the `=` of
// an assignment, a range of the one character, or at the declared name of a declaration, once
// for each location, in the file of the function.
fn the_report_names_each_place_at_its_position() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    lower_env.check_lines(&e, REPORTED[..], true);
    u64 mut k = 0;
    while (k < REPORTED_NAMES.len) {
        fir.func mut f = fir.func{};
        lower(&e, REPORTED_NAMES[k], &f);
        prover.proof mut p = prover.prove(&f);
        u64 before = check_env.reports(&e.c);
        report.write(&f, &p, &e.c.m.s);
        assert(check_env.reports(&e.c) == before + 2);
        assert(check_env.report_severity(&e.c, before) == "error");
        assert(check_env.report_severity(&e.c, before + 1) == "note");
        assert(check_env.report_file(&e.c, before) == check_env.report_file(&e.c, before + 1));
        assert(str.ends_with(check_env.report_file(&e.c, before), "main.ft"));
        prover.free(&p);
        fir.func_free(&f);
        k += 1;
    }
    k = 0;
    while (k < REPORTS.len) {
        if (check_env.report_text(&e.c, k) != REPORTS[k]) {
            eprintln(check_env.report_text(&e.c, k), " and not ", REPORTS[k]);
            panic("report_test: a report differs");
        }
        k += 1;
    }
    // the error at `=` covers the one character
    assert(modules_env.report_at(&e.c.m, 0).loc.end_col == 14);
    // the error at a declared name covers the name
    assert(modules_env.report_at(&e.c.m, 6).loc.end_col == 24);
}

// A FIR text with locations and no tree: the report names the FIR place of an assignment, at the
// one character of its location, and the declared name of a declaration, at its location. The
// store of the first check stands at the location of the check, as the lowering puts it, and the
// store into the temporary `_3`, which its empty start proves, at its own.
string[19] TEXT_REPORTED = {
    "fn main.r1(_1 (b): node mut*) -> void {",
    "    let _2 (p): node mut* own #9:5;",
    "    let _3: node mut* own;",
    "    bb0: {",
    "        _3 = alloc<node>(const u64 1) #6:1;",
    "        check(overwrite: (*_1).0) -> bb1 #7:13;",
    "    }",
    "    bb1: {",
    "        (*_1).0 = move _3 #7:13;",
    "        check(overwrite: _2) -> bb2 #9:5;",
    "    }",
    "    bb2: {",
    "        check(overwrite: global main.G) -> bb3 #11:7;",
    "    }",
    "    bb3: {",
    "        del(move global main.G);",
    "        return;",
    "    }",
    "}",
};

// The report of the three checks of TEXT_REPORTED, none of which the pass proves. The store of the
// first check, which the pass does not prove either, stands at the location of that check, so it
// takes no error of its own.
string[6] TEXT_REPORTS = {
    "7:13: overwriting owned value: cannot prove '(*_1).0' is empty here",
    "7:13: del or move '(*_1).0' before this store",
    "9:5: overwriting owned value: cannot prove 'p' is empty here",
    "9:5: del or move 'p' before this store",
    "11:7: overwriting owned value: cannot prove 'global main.G' is empty here",
    "11:7: del or move 'global main.G' before this store",
};

// With no tree, the report names the FIR place, and a declaration its name.
fn the_report_of_a_fir_text_names_the_fir_place() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    fir.module mut m = pass_env.parse(&e, PRELUDE[..], TEXT_REPORTED[..]);
    defer fir.module_free(&m);
    fir.func* f = &m.funcs.items[0];
    prover.proof mut p = prover.prove(f);
    defer prover.free(&p);
    assert(p.checks == 3 && p.stores.len == 2 && p.unproved == 4 && p.stores[0].proved);
    u64 before = check_env.reports(&e.c);
    report.write(f, &p, &e.c.m.s);
    assert(check_env.reports(&e.c) == before + 6);
    u64 mut k = 0;
    while (k < TEXT_REPORTS.len) {
        assert(check_env.report_text(&e.c, before + k) == TEXT_REPORTS[k]);
        assert(check_env.report_file(&e.c, before + k) == "t.fir");
        k += 1;
    }
}

// The diagnostics of TEXT_REPORTED past the work limit: the error and the note of each check, and
// the second note of the first error, which names the limit (D17.11). The store into the scratch
// local `_3` is no error past the limit, so no error names a temporary.
string[7] LIMIT_REPORTS = {
    "7:13: overwriting owned value: cannot prove '(*_1).0' is empty here",
    "7:13: del or move '(*_1).0' before this store",
    "7:13: the function exceeds the work limit of D17.11; split it",
    "9:5: overwriting owned value: cannot prove 'p' is empty here",
    "9:5: del or move 'p' before this store",
    "11:7: overwriting owned value: cannot prove 'global main.G' is empty here",
    "11:7: del or move 'global main.G' before this store",
};

// Past the work limit each check and each store into no scratch local is unproved, and the first
// error takes a second note that names the limit; the other errors take none (D17.11). A limit of
// 0 puts the three checks and the two stores of TEXT_REPORTED past it, and the report under the
// limit names no limit (the_report_of_a_fir_text_names_the_fir_place).
fn the_first_error_past_the_work_limit_names_the_limit() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    fir.module mut m = pass_env.parse(&e, PRELUDE[..], TEXT_REPORTED[..]);
    defer fir.module_free(&m);
    fir.func* f = &m.funcs.items[0];
    prover.proof mut p = prover.prove_within(f, 0);
    defer prover.free(&p);
    assert(p.over && p.checks == 3 && p.unproved == 4 && p.stores[0].proved);
    u64 before = check_env.reports(&e.c);
    report.write(f, &p, &e.c.m.s);
    assert(check_env.reports(&e.c) == before + LIMIT_REPORTS.len);
    u64 mut k = 0;
    while (k < LIMIT_REPORTS.len) {
        assert(check_env.report_text(&e.c, before + k) == LIMIT_REPORTS[k]);
        k += 1;
    }
    assert(check_env.report_severity(&e.c, before + 2) == "note");
    assert(report.LIMIT_NOTE == "the function exceeds the work limit of D17.11; split it");
}

// Stores that need a proof and that no check guards, in a FIR text with locations and no tree. The
// entry zeroing of `_2` needs no proof, and the empty start of the temporary `_3` proves its store.
// The store into `(*_1).0` writes a place through a parameter, which holds no fact. The first store
// into `_2` finds the zero value of the entry zeroing, so the pass proves it; the second one finds
// the allocation of the first. `_4` has no entry zeroing.
string[16] STORE_REPORTED = {
    "fn main.r2(_1 (b): node mut*) -> void {",
    "    let _2 (p): node mut* own #4:5;",
    "    let _3: node mut* own;",
    "    let _4 (q): node mut* own #7:5;",
    "    bb0: {",
    "        _2 = const zero node mut* own #4:5;",
    "        _3 = alloc<node>(const u64 1) #5:1;",
    "        (*_1).0 = move _3 #5:9;",
    "        _2 = alloc<node>(const u64 1) #4:5;",
    "        _2 = alloc<node>(const u64 1) #6:3;",
    "        del(move _2) #6:9;",
    "        _4 = alloc<node>(const u64 1) #7:5;",
    "        del(move _4) #7:9;",
    "        return;",
    "    }",
    "}",
};

// The report of STORE_REPORTED: one error and its note at each store that the pass does not prove,
// in statement order. A store into a named local at its declared name names that name, and any
// other store the FIR place.
string[6] STORE_REPORTS = {
    "5:9: overwriting owned value: cannot prove '(*_1).0' is empty here",
    "5:9: del or move '(*_1).0' before this store",
    "6:3: overwriting owned value: cannot prove '_2' is empty here",
    "6:3: del or move '_2' before this store",
    "7:5: overwriting owned value: cannot prove 'q' is empty here",
    "7:5: del or move 'q' before this store",
};

// The report of STORE_REPORTED past the work limit: each store into no scratch local is an error,
// the first one with the note of the limit, and the first store into `_2` names the declared name
// `p`. The store into the temporary `_3` is none.
string[9] STORE_LIMIT_REPORTS = {
    "5:9: overwriting owned value: cannot prove '(*_1).0' is empty here",
    "5:9: del or move '(*_1).0' before this store",
    "5:9: the function exceeds the work limit of D17.11; split it",
    "4:5: overwriting owned value: cannot prove 'p' is empty here",
    "4:5: del or move 'p' before this store",
    "6:3: overwriting owned value: cannot prove '_2' is empty here",
    "6:3: del or move '_2' before this store",
    "7:5: overwriting owned value: cannot prove 'q' is empty here",
    "7:5: del or move 'q' before this store",
};

// Writes the report of `f` with the proof `p` and holds that its diagnostics are `want`, each in
// the FIR file, but for one at the zero location, which names no file.
fn expect_reports(lower_env.env mut* e, fir.func* f, prover.proof* p, string@ want) void {
    u64 before = check_env.reports(&e->c);
    report.write(f, p, &e->c.m.s);
    assert(check_env.reports(&e->c) == before + want.len);
    u64 mut k = 0;
    while (k < want.len) {
        if (check_env.report_text(&e->c, before + k) != want[k]) {
            eprintln(check_env.report_text(&e->c, before + k), " and not ", want[k]);
            panic("report_test: a report differs");
        }
        if (str.starts_with(want[k], "0:0:")) {
            assert(check_env.report_file(&e->c, before + k) == "");
        } else {
            assert(check_env.report_file(&e->c, before + k) == "t.fir");
        }
        k += 1;
    }
}

// A store that no check guards takes its error at its own location (spec/fir.md 11), under the
// limit and past it.
fn the_report_names_each_store_that_no_check_guards() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    fir.module mut m = pass_env.parse(&e, PRELUDE[..], STORE_REPORTED[..]);
    defer fir.module_free(&m);
    fir.func* f = &m.funcs.items[0];
    prover.proof mut p = prover.prove(f);
    defer prover.free(&p);
    assert(p.checks == 0 && p.stores.len == 5 && p.unproved == 3 && !p.over);
    assert(p.stores[0].proved && !p.stores[1].proved && p.stores[2].proved);
    assert(!p.stores[3].proved && !p.stores[4].proved);
    expect_reports(&e, f, &p, STORE_REPORTS[..]);
    prover.proof mut over = prover.prove_within(f, 0);
    defer prover.free(&over);
    assert(over.over && over.unproved == 4 && over.stores[0].proved);
    expect_reports(&e, f, &over, STORE_LIMIT_REPORTS[..]);
}

// Stores and checks at shared locations, in a FIR text with no tree. In `r3` the store into
// `(*_1).0` has no location, and the store into `(*_2).1` and the check of its block stand at the
// location of the store into `(*_2).0`. In `r4` a `goto` stands between a check and its store,
// which have two locations. The pass proves no store and no check of the two functions.
string[29] MERGED_REPORTED = {
    "fn main.r3(_1 (b): node mut*, _2 (c): node mut*) -> void {",
    "    let _3: node mut* own;",
    "    let _4: node mut* own;",
    "    let _5: node mut* own;",
    "    bb0: {",
    "        _3 = alloc<node>(const u64 1) #2:1;",
    "        (*_1).0 = move _3;",
    "        _4 = alloc<node>(const u64 1) #3:1;",
    "        (*_2).0 = move _4 #3:9;",
    "        _5 = alloc<node>(const u64 1) #3:1;",
    "        (*_2).1 = move _5 #3:9;",
    "        check(overwrite: (*_2).1) -> bb1 #3:9;",
    "    }",
    "    bb1: {",
    "        return;",
    "    }",
    "}",
    "fn main.r4(_1 (b): node mut*) -> void {",
    "    bb0: {",
    "        check(overwrite: (*_1).0) -> bb1 #5:1;",
    "    }",
    "    bb1: {",
    "        goto bb2 #5:2;",
    "    }",
    "    bb2: {",
    "        (*_1).0 = call fn main.make() #6:1;",
    "        return;",
    "    }",
    "}",
};

// The report of `r3`: the store with no location stands at the zero location, and the store and
// the check at the location of an earlier error take no error of their own.
string[4] MERGED_REPORTS = {
    "0:0: overwriting owned value: cannot prove '(*_1).0' is empty here",
    "0:0: del or move '(*_1).0' before this store",
    "3:9: overwriting owned value: cannot prove '(*_2).0' is empty here",
    "3:9: del or move '(*_2).0' before this store",
};

// The report of `r4`: the check and its store each take an error at their location, the check
// first, because its block comes first.
string[4] SPLIT_REPORTS = {
    "5:1: overwriting owned value: cannot prove '(*_1).0' is empty here",
    "5:1: del or move '(*_1).0' before this store",
    "6:1: overwriting owned value: cannot prove '(*_1).0' is empty here",
    "6:1: del or move '(*_1).0' before this store",
};

// The report merges each error at the location of an earlier one, a check with a store and a
// store with a store, and a check and its store at two locations take two errors.
fn the_report_merges_the_errors_at_one_location() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    fir.module mut m = pass_env.parse(&e, PRELUDE[..], MERGED_REPORTED[..]);
    defer fir.module_free(&m);
    fir.func* f = &m.funcs.items[0];
    prover.proof mut p = prover.prove(f);
    defer prover.free(&p);
    assert(p.checks == 1 && p.stores.len == 6 && p.unproved == 4);
    assert(!prover.is_proved(&p, 0));
    expect_reports(&e, f, &p, MERGED_REPORTS[..]);
    fir.func* g = &m.funcs.items[1];
    prover.proof mut q = prover.prove(g);
    defer prover.free(&q);
    assert(q.checks == 1 && q.stores.len == 1 && q.unproved == 2);
    expect_reports(&e, g, &q, SPLIT_REPORTS[..]);
}

// ---- the leak report ---------------------------------------------------------------------------

// Sources whose exits hold an allocation, one function for each exit kind and for each rule of the
// text. `spread` leaks `n` at two exits, and `deferred` at the closing brace of a deferred block,
// which expands at its two exits. `two` leaks two locals at one closing brace.
string[62] LEAKED = {
    "struct node {",
    "    node mut* own next;",
    "}",
    "fn take(node mut* own n) void {",
    "    del(n);",
    "}",
    "fn brace() void {",
    "    {",
    "        node mut* own n = new(node);",
    "    }",
    "}",
    "fn early(bool c, node mut* own p) void {",
    "    node mut* own n = new(node);",
    "    if (c) {",
    "        return;",
    "    }",
    "    del(n);",
    "    del(p);",
    "}",
    "fn leave(bool c) void {",
    "    while (c) {",
    "        node mut* own n = new(node);",
    "        if (c) {",
    "            break;",
    "        }",
    "        del(n);",
    "    }",
    "}",
    "fn again(bool c) void {",
    "    while (c) {",
    "        node mut* own n = new(node);",
    "        if (c) {",
    "            continue;",
    "        }",
    "        del(n);",
    "    }",
    "}",
    "fn two() void {",
    "    node mut* own a = new(node);",
    "    node mut* own b = new(node);",
    "}",
    "fn deferred(bool c) void {",
    "    defer {",
    "        node mut* own m = new(node);",
    "    }",
    "    if (c) {",
    "        return;",
    "    }",
    "}",
    "fn spread(bool c) void {",
    "    node mut* own n = new(node);",
    "    if (c) {",
    "        return;",
    "    }",
    "}",
    "fn temp() void {",
    "    take(new (",
    "        node));",
    "}",
    "fn clean(node mut* own p) void {",
    "    defer del(p);",
    "}",
};

string[9] LEAK_NAMES = {
    "brace", "early", "leave", "again", "two", "deferred", "spread", "temp", "clean",
};

// The lines of the leak report of the functions of LEAKED, in order, each after the file of the
// function. The closing brace of a block, the `return`, the `break` and the `continue` give the
// position. The report names the declared name of a named local and of a parameter, once for each
// location and owner. `clean` frees its parameter at its one exit, and `temp` has no line.
string[10] LEAK_LINES = {
    "10:5: leak: cannot prove 'n' is empty at this exit",
    "15:9: leak: cannot prove 'n' is empty at this exit",
    "15:9: leak: cannot prove 'p' is empty at this exit",
    "24:13: leak: cannot prove 'n' is empty at this exit",
    "33:13: leak: cannot prove 'n' is empty at this exit",
    "41:1: leak: cannot prove 'a' is empty at this exit",
    "41:1: leak: cannot prove 'b' is empty at this exit",
    "45:5: leak: cannot prove 'm' is empty at this exit",
    "53:9: leak: cannot prove 'n' is empty at this exit",
    "55:1: leak: cannot prove 'n' is empty at this exit",
};

// The line of `temp` once its call is gone: the text of the expression of the temporary, from its
// first token to its last, with each run of white space as one space.
string[1] TEMP_LINE = {"59:1: leak: cannot prove 'new ( node)' is empty at this exit"};

// The lines of `early` past the work limit: no exit is proved but that of the temporary, and the
// first line takes the note of the leak limit, though the work of D17.11 passes the limit too.
string[5] EARLY_LIMIT_LINES = {
    "15:9: leak: cannot prove 'n' is empty at this exit",
    "15:9: note: the function exceeds the work limit of the leak rule; split it",
    "15:9: leak: cannot prove 'p' is empty at this exit",
    "19:1: leak: cannot prove 'n' is empty at this exit",
    "19:1: leak: cannot prove 'p' is empty at this exit",
};

// Holds that the lines of `text` are those of `want`, in order, each after the file `file` and a
// `:`.
fn expect_lines(string text, string file, string@ want) void {
    u64 mut k = 0;
    u64 mut start = 0;
    for (u64 mut i = 0; i < text.len; i++) {
        if (text[i] != '\n') {
            continue;
        }
        string line = text[start..i];
        start = i + 1;
        bool fits = k < want.len && line.len > file.len + 1 && str.starts_with(line, file)
            && line[file.len] == ':' && line[file.len + 1..] == want[k];
        if (!fits) {
            eprintln(line);
            panic("report_test: a leak line differs");
        }
        k += 1;
    }
    assert(k == want.len && start == text.len);
}

// Removes the last statement of the block of the first `return` of `f`: in `temp`, the call that
// takes the temporary of `new`.
fn drop_call(fir.func mut* f) void {
    u32 mut b = 0;
    while (fir.block_at(f, b)->term.kind != fir.term_kind.tk_return) {
        b += 1;
    }
    fir.block_mut(f, b)->statements.len -= 1;
}

// The leak report names the owner of each exit that the pass does not prove, at its position, once
// for each location and owner, in the file of the function, and past the work limit the first line
// takes the note of the limit (D17.20).
fn the_leak_report_names_each_owner_at_its_exit() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    lower_env.check_lines(&e, LEAKED[..], true);
    string file = lower_env.decl(&e, "brace")->loc.file;
    assert(str.ends_with(file, "main.ft"));
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    u64 mut k = 0;
    while (k < LEAK_NAMES.len) {
        fir.func mut f = fir.func{};
        lower(&e, LEAK_NAMES[k], &f);
        prover.proof mut p = prover.prove(&f);
        report.write_leaks(&f, &p, &e.c.m.s, &text);
        prover.free(&p);
        fir.func_free(&f);
        k += 1;
    }
    expect_lines(strbuf.view(&text), file, LEAK_LINES[..]);
    // the temporary of `new` reaches the `return` only once its call is gone
    fir.func mut t = fir.func{};
    defer fir.func_free(&t);
    lower(&e, "temp", &t);
    drop_call(&t);
    prover.proof mut dropped = prover.prove(&t);
    defer prover.free(&dropped);
    assert(dropped.leaks == 1);
    strbuf.clear(&text);
    report.write_leaks(&t, &dropped, &e.c.m.s, &text);
    expect_lines(strbuf.view(&text), file, TEMP_LINE[..]);
    fir.func mut early = fir.func{};
    defer fir.func_free(&early);
    lower(&e, "early", &early);
    prover.proof mut over = prover.prove_within(&early, 0);
    defer prover.free(&over);
    assert(over.leak_over && over.leaks == 4);
    strbuf.clear(&text);
    report.write_leaks(&early, &over, &e.c.m.s, &text);
    expect_lines(strbuf.view(&text), file, EARLY_LIMIT_LINES[..]);
}

// A FIR text with locations and no tree: a named local and a parameter give their declared names,
// and a temporary its FIR place. The `return` and the `dead` before it stand at one location.
string[16] TEXT_LEAKED = {
    "fn main.r5(_1 (p): node mut* own) -> void {",
    "    let _2 (n): node mut* own #3:5;",
    "    let _3: node mut* own;",
    "    bb0: {",
    "        _2 = const zero node mut* own;",
    "        live(_2) #3:5;",
    "        _3 = alloc<node>(const u64 1) #3:9;",
    "        check(overwrite: _2) -> bb1 #3:5;",
    "    }",
    "    bb1: {",
    "        _2 = move _3 #3:5;",
    "        dead(_2) #4:1;",
    "        _3 = alloc<node>(const u64 1) #4:3;",
    "        return #4:1;",
    "    }",
    "}",
};

string[3] TEXT_LEAK_LINES = {
    "4:1: leak: cannot prove 'n' is empty at this exit",
    "4:1: leak: cannot prove 'p' is empty at this exit",
    "4:1: leak: cannot prove '_3' is empty at this exit",
};

// A function whose leak work alone passes the limit: it has no check and no store that needs a
// proof, so its work of D17.11 is 0. The `dead` of `n` comes before its entry zeroing, so the pass
// does not prove it under the limit either (the probe `ff` of the review).
string[8] LEAK_LIMIT = {
    "fn main.r7() -> void {",
    "    let _1 (n): node mut* own;",
    "    bb0: {",
    "        dead(_1) #2:1;",
    "        _1 = const zero node mut* own #3:1;",
    "        return #4:1;",
    "    }",
    "}",
};

// Under the limit the line of the `dead`; past the leak limit, with the note of the leak limit,
// which names no limit of D17.11.
string[1] LEAK_LIMIT_UNDER = {"2:1: leak: cannot prove 'n' is empty at this exit"};

string[2] LEAK_LIMIT_OVER = {
    "2:1: leak: cannot prove 'n' is empty at this exit",
    "2:1: note: the function exceeds the work limit of the leak rule; split it",
};

// The note of a function whose leak work alone passes the limit names the leak limit and not the
// limit of D17.11. The leak work of `r7` is its 3 statements and terminators times its one owner
// local, and 1 block times 2 locals.
fn the_leak_limit_takes_its_own_note() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    fir.module mut m = pass_env.parse(&e, PRELUDE[..], LEAK_LIMIT[..]);
    defer fir.module_free(&m);
    fir.func* f = &m.funcs.items[0];
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    prover.proof mut under = prover.prove(f);
    defer prover.free(&under);
    assert(under.work == 0 && under.leak_work == 5 && !under.leak_over && under.leaks == 1);
    report.write_leaks(f, &under, &e.c.m.s, &text);
    expect_lines(strbuf.view(&text), "t.fir", LEAK_LIMIT_UNDER[..]);
    prover.proof mut over = prover.prove_within(f, 4);
    defer prover.free(&over);
    assert(over.work == 0 && !over.over && over.leak_over && over.unproved == 0);
    strbuf.clear(&text);
    report.write_leaks(f, &over, &e.c.m.s, &text);
    expect_lines(strbuf.view(&text), "t.fir", LEAK_LIMIT_OVER[..]);
    string note = "the function exceeds the work limit of the leak rule; split it";
    assert(report.LEAK_LIMIT_NOTE == note);
}

// With no tree, the leak report names a temporary by its FIR place.
fn the_leak_report_of_a_fir_text_names_the_fir_place() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    fir.module mut m = pass_env.parse(&e, PRELUDE[..], TEXT_LEAKED[..]);
    defer fir.module_free(&m);
    fir.func* f = &m.funcs.items[0];
    prover.proof mut p = prover.prove(f);
    defer prover.free(&p);
    assert(p.unproved == 0 && p.exits.len == 3 && p.leaks == 3);
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    report.write_leaks(f, &p, &e.c.m.s, &text);
    expect_lines(strbuf.view(&text), "t.fir", TEXT_LEAK_LINES[..]);
}

fn main() i32 {
    the_report_names_each_place_at_its_position();
    the_report_of_a_fir_text_names_the_fir_place();
    the_first_error_past_the_work_limit_names_the_limit();
    the_report_names_each_store_that_no_check_guards();
    the_report_merges_the_errors_at_one_location();
    println("report ok");
    the_leak_report_names_each_owner_at_its_exit();
    the_leak_report_of_a_fir_text_names_the_fir_place();
    the_leak_limit_takes_its_own_note();
    println("leak report ok");
    return 0;
}
