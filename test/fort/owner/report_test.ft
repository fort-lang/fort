// Holds that `got` holds the lines of `want`, each after `file`, in order and nothing else.
fn expect_lines(string got, string file, string@ want) void {
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    u64 mut k = 0;
    while (k < want.len) {
        strbuf.append(&text, file);
        strbuf.append(&text, want[k]);
        strbuf.push(&text, '\n');
        k += 1;
    }
    if (got != strbuf.view(&text)) {
        eprintln(got, "and not\n", strbuf.view(&text));
        panic("report_test: the lines of part 2 differ");
    }
}

// The report of part 2 names the first inner owner of each site that the pass does not prove, at
// the `del` keyword or at the `cast`, once for each location, in the file of the function. It
// writes no diagnostic: part 2 is no error yet (D17.20). Past the work limit the first line takes
// the note of the leak limit.
fn the_report_of_part_2_names_the_first_inner_owner_of_each_site() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    lower_env.check_lines(&e, RELEASED[..], true);
    string file = lower_env.decl_file(&e, "param");
    assert(str.ends_with(file, "main.ft"));
    strbuf.str_buf mut got = strbuf.create();
    defer strbuf.free(&got);
    u64 before = check_env.reports(&e.c);
    u64 mut k = 0;
    while (k < RELEASED_NAMES.len) {
        fir.func mut f = fir.func{};
        lower(&e, RELEASED_NAMES[k], &f);
        prover.proof mut p = prover.prove(&f);
        report.write_inners(&f, &p, &e.c.m.s, &got);
        prover.free(&p);
        fir.func_free(&f);
        k += 1;
    }
    assert(check_env.reports(&e.c) == before);
    expect_lines(strbuf.view(&got), file, RELEASED_LINES[..]);
    fir.func mut later = fir.func{};
    defer fir.func_free(&later);
    lower(&e, "later", &later);
    prover.proof mut over = prover.prove_within(&later, 0);
    defer prover.free(&over);
    assert(over.inner_over && over.inner_leaks == 1);
    strbuf.clear(&got);
    report.write_inners(&later, &over, &e.c.m.s, &got);
    expect_lines(strbuf.view(&got), file, RELEASED_LIMIT_LINES[..]);
    fir.func mut two = fir.func{};
    defer fir.func_free(&two);
    lower(&e, "two_sites", &two);
    prover.proof mut both = prover.prove_within(&two, 0);
    defer prover.free(&both);
    assert(both.inner_over && both.inner_leaks == 2);
    strbuf.clear(&got);
    report.write_inners(&two, &both, &e.c.m.s, &got);
    expect_lines(strbuf.view(&got), file, TWO_LIMIT_LINES[..]);
    assert(check_env.reports(&e.c) == before);
}

