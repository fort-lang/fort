// Each cell of the typed family of test/fort/support/generator.ft, a type in a storage class,
// under the closed-world judgement of test/fort/support/judgement.ft: the function with no
// operation, then the functions of one operation. The compiler accepts the declarations of each
// cell and its function with no operation, so each reject of a longer function comes from an
// operation. Each line ends with the count of the failures of the cell.
import judgement;

fn main() i32 {
    println("no operation");
    judgement.print_cells(0);
    println("one operation");
    judgement.print_cells(1);
    return 0;
}
