// The three tables of the typed family of test/fort/support/generator.ft by count: the cells, the
// vocabulary of each cell, the cells of each operation and the functions of each length. A row
// that leaves a table changes a line here, and tools/mutations/generator.json holds two mutants
// for each table: its first 6 rows. The test needs no compiler module. It prints the declarations
// of one cell and one function of each storage class too, so a change of the text of a function
// shows.
import generator;
import std.strbuf;

// Prints the vocabulary size of each cell of the type of row `ty`, and `-` for no cell.
fn print_type(u64 ty) void {
    strbuf.str_buf mut b = strbuf.create();
    defer del(b.data);
    u64[generator.OPERATION_COUNT] mut ops = {};
    for (u64 mut st = 0; st < generator.STORAGE_COUNT; st++) {
        strbuf.append(&b, ", ");
        strbuf.append(&b, generator.STORAGES[st].name);
        strbuf.push(&b, ' ');
        if (generator.typed_fits(ty, st)) {
            strbuf.append_u64(&b, generator.typed_vocabulary(ty, st, ops[..]));
        } else {
            strbuf.push(&b, '-');
        }
    }
    println(generator.TYPES[ty].name, strbuf.view(&b));
}

// The count of the cells that row `op` of generator.OPERATIONS applies to.
fn cells_of(u64 op) u64 {
    u64 mut count = 0;
    for (u64 mut ty = 0; ty < generator.TYPE_COUNT; ty++) {
        for (u64 mut st = 0; st < generator.STORAGE_COUNT; st++) {
            if (generator.typed_applies(op, ty, st)) {
                count += 1;
            }
        }
    }
    return count;
}

// The count of the cells of the family.
fn cells() u64 {
    u64 mut count = 0;
    for (u64 mut ty = 0; ty < generator.TYPE_COUNT; ty++) {
        for (u64 mut st = 0; st < generator.STORAGE_COUNT; st++) {
            if (generator.typed_fits(ty, st)) {
                count += 1;
            }
        }
    }
    return count;
}

// Prints function `seq` of `n` operations of the cell of row `ty` and row `st`, after a line that
// names the cell and says what generator.write_typed gives about the function.
fn print_function(u64 ty, u64 st, u64 n, u64 seq) void {
    strbuf.str_buf mut b = strbuf.create();
    defer del(b.data);
    u64[generator.OPERATION_COUNT] mut ops = {};
    u64 size = generator.typed_vocabulary(ty, st, ops[..]);
    generator.typed_shape mut shape = generator.typed_shape{};
    generator.write_typed(&b, ty, st, ops[..size], n, seq, seq, &shape);
    println("-- ", generator.TYPES[ty].name, "/", generator.STORAGES[st].name, " ", seq,
            ": reads ", shape.reads, ", lines ", shape.lines, ", first ", shape.first);
    print(strbuf.view(&b));
}

// Prints the declarations of the cell of row `ty` and row `st`.
fn print_prelude(u64 ty, u64 st) void {
    strbuf.str_buf mut b = strbuf.create();
    defer del(b.data);
    generator.write_typed_prelude(&b, ty, st);
    println("-- ", generator.TYPES[ty].name, "/", generator.STORAGES[st].name);
    print(strbuf.view(&b));
}

fn main() i32 {
    println("types ", generator.TYPE_COUNT, ", storage classes ", generator.STORAGE_COUNT,
            ", operations ", generator.OPERATION_COUNT, ", cells ", cells());
    for (u64 mut ty = 0; ty < generator.TYPE_COUNT; ty++) {
        print_type(ty);
    }
    for (u64 mut op = 0; op < generator.OPERATION_COUNT; op++) {
        println(generator.OPERATIONS[op].name, ": cells ", cells_of(op));
    }
    for (u64 mut n = 0; n <= 3; n++) {
        println("operations ", n, ": functions ", generator.typed_count(n));
    }
    print_prelude(3, 2);
    print_function(0, 0, 2, 40);
    print_function(5, 1, 2, 777);
    print_function(3, 2, 2, 1500);
    print_function(6, 3, 2, 2000);
    print_function(1, 4, 2, 1777);
    print_function(4, 5, 3, 31000);
    print_function(2, 0, 0, 0);
    return 0;
}
