// The rules of the closed-world judgement of test/fort/support/judgement.ft, apart from the typed
// family that the judgement covers. The first lines are the functions of the judgement that read
// no program. `rule` gives one letter for each of the 16 cases of an event kind: E an error, X the
// excuse of an abort, L, W and S an event that `--leak-report`, `--whole-store-report` or
// `--span-del-report` owns, C the `leak at exit` of a cycle of owners. A group holds the report
// bits 0 to 7 (bit 0 a line of `--leak-report`, bit 1 a line of `--whole-store-report`, bit 2 a
// line of `--span-del-report`). The first group has no `dead` of an abort and the second one has
// it. The second line of a kind holds the same cases for an event with the cycle mark: the
// disposition table of test/fort/support/disposition.ft reads the mark of a `leak at exit` only,
// and the judgement takes an event of a kind that the table trusts as an error.
//
// Then `is_entry`: a path names the entry module by its last component. Then `named_of` for
// lines of a report and lines of another shape. Then `reports_at` and the ruling of an
// `overwrite`, of a `leak` and of a `leak at exit` on each line of the report lines of two
// functions: a report line takes an event of its option on its own line only, a line of a pass
// takes an event of its own function only, and no line takes a `leak at exit`. Then `at_abort`
// over markers with and without an abort, `end_of` and `is_silent` for each end of a run,
// `is_vacate` for each operation in two storage classes, `is_fill` and `is_part_vacate` for each
// operation, `is_part_vacate_text` for texts of a statement, and `class_of` for a function of
// each class and for functions that agree with the cause of no class.
//
// The lines `class_of_event`, `count_failure` and `known` hold the one list of the known
// failures, judgement.KNOWN: the class of an item of the gate for each event kind and for each
// moved tag of a `use after move`, the counts of the classes of the gate, the count of each unit
// and of each class, the total, and `holds_known` and `known_exit` for counts that are equal to
// the list, above it and below it.
//
// The lines `hand` are the judgement of HAND, functions that this test writes: each rule of the
// judgement that the typed family does not reach has a function here. The mutants of the
// judgement that this test holds are rows of tools/mutations/generator.json.
import check_env;
import fort.ast;
import fort.fir.interpreter;
import fort.fir.shadow;
import generator;
import judgement;
import std.str;
import std.strbuf;

shadow.event_kind[judgement.KINDS] EVENTS = {
    shadow.event_kind.ev_overwrite,
    shadow.event_kind.ev_leak,
    shadow.event_kind.ev_leak_at_exit,
    shadow.event_kind.ev_double_release,
    shadow.event_kind.ev_invalid_release,
    shadow.event_kind.ev_use_after_release,
    shadow.event_kind.ev_use_after_move,
    shadow.event_kind.ev_use_after_scope,
    shadow.event_kind.ev_duplicate_owner,
    shadow.event_kind.ev_forged,
};

// One letter for each member of judgement.ruling.
string RULING_LETTERS = "EXLWSC";

// Appends the ruling of each of the 16 cases of an event of the kind `kind` to `b`, as 2 groups:
// the report bits 0 to 7 with no abort, then with an abort. `cycle` is the cycle mark of the event.
fn append_rule(strbuf.str_buf mut* b, shadow.event_kind kind, bool cycle) void {
    shadow.event mut ev = shadow.event{};
    ev.kind = kind;
    ev.cycle = cycle;
    for (u64 mut group = 0; group < 2; group++) {
        strbuf.push(b, ' ');
        for (u32 mut reports = 0; reports < 8; reports++) {
            judgement.ruling said = judgement.rule(&ev, group == 1, reports);
            strbuf.push(b, RULING_LETTERS[cast(cast(said, i32), u64)]);
        }
    }
}

// Prints the ruling of each of the 16 cases of each event kind, then of each event kind with the
// cycle mark, and whether the disposition table trusts the kind.
fn print_rule() void {
    strbuf.str_buf mut b = strbuf.create();
    defer del(b.data);
    for (u64 mut kind = 0; kind < judgement.KINDS; kind++) {
        strbuf.clear(&b);
        append_rule(&b, EVENTS[kind], false);
        println("rule ", shadow.EVENT_TEXT[kind], ":", strbuf.view(&b));
        strbuf.clear(&b);
        append_rule(&b, EVENTS[kind], true);
        println("rule ", shadow.EVENT_TEXT[kind], " of a cycle:", strbuf.view(&b),
                ", the table trusts the kind: ", judgement.is_trusted(EVENTS[kind]));
    }
}

// Lines of a report, as fort.owner.report writes them, and lines that name no line of the entry
// module: another file, a file whose name ends in `main.ft` after another letter or after a `.`,
// no number, no second `:`, the empty line, the line 0 and the line of a `dead` marker.
u64 REPORT_COUNT = 11;
string[REPORT_COUNT] REPORTS = {
    "main.ft:12:5: leak: cannot prove 'p->lo' is empty before this del",
    "/tmp/fort-1/main.ft:7:9: note: move 'b ? x : y' into a local and del it first",
    "main.ft:999999:1: whole store",
    "std/rt.ft:12:5: leak: cannot prove 'p->lo' is empty before this del",
    "xmain.ft:12:5: leak",
    "std/.main.ft:12:5: leak",
    "main.ft:x:5: leak",
    "main.ft:12",
    "",
    "main.ft:0:5: leak",
    "main.ft:1000000:5: leak",
};

// The count of the report lines of print_named.
u64 NAMED_COUNT = 7;

// Appends the ruling of an event of the kind `kind` of the function `of` on each of the lines 2
// to 8 of `file`, with the report lines `named`.
fn append_named(strbuf.str_buf mut* b, judgement.named_line@ named, ast.sym* of,
                shadow.event_kind kind, string file) void {
    shadow.event mut ev = shadow.event{};
    ev.kind = kind;
    for (u32 mut line = 2; line < 9; line++) {
        u32 reports = judgement.reports_at(named, of, file, line);
        judgement.ruling said = judgement.rule(&ev, false, reports);
        strbuf.push(b, RULING_LETTERS[cast(cast(said, i32), u64)]);
    }
}

// Appends reports_at for an event of the function `of` on each of the lines 2 to 8 of the entry
// module, with the report lines `named`.
fn append_reports(strbuf.str_buf mut* b, judgement.named_line@ named, ast.sym* of) void {
    for (u32 mut line = 2; line < 9; line++) {
        strbuf.push(b, ' ');
        strbuf.append_u64(b, cast(judgement.reports_at(named, of, "main.ft", line), u64));
    }
}

// Prints is_entry for paths whose last component is `main.ft` and for paths that end in another
// way, then named_of for each line of REPORTS. The other lines read the report lines of two
// functions `f` and `g`: `--leak-report` names the lines 3 and 4 for `f` and the line 5 for `g`,
// `--whole-store-report` names the lines 4 and 6 for `f`, and `--span-del-report` names the line 7
// for no function. Line 3 has two report lines, as a site with a note. The lines are reports_at on
// the lines 2 to 8 of the entry module for an event of `f`, of `g` and of no function, for line 3
// of another file and for no report line, and for line 3 of the entry module under a directory, of
// two files whose name ends in `main.ft`, and of no file. Then the ruling of an `overwrite`, of a
// `leak` and of a `leak at exit` of `f` on each of those lines, of a `leak` and of an `overwrite`
// of `g`, and of a `use after move` of `f`.
fn print_named() void {
    strbuf.str_buf mut b = strbuf.create();
    defer del(b.data);
    ast.sym f = ast.sym{};
    ast.sym g = ast.sym{};
    judgement.named_line[NAMED_COUNT] named = {
        {judgement.REPORT_LEAK, 3, &f},
        {judgement.REPORT_LEAK, 3, &f},
        {judgement.REPORT_WHOLE, 4, &f},
        {judgement.REPORT_LEAK, 4, &f},
        {judgement.REPORT_LEAK, 5, &g},
        {judgement.REPORT_WHOLE, 6, &f},
        {judgement.REPORT_SPAN, 7, null},
    };
    judgement.named_line@ none = {};
    println("is_entry: 'main.ft' ", judgement.is_entry("main.ft"), ", 'tmp/main.ft' ",
            judgement.is_entry("tmp/main.ft"), ", '/main.ft' ", judgement.is_entry("/main.ft"));
    println("is_entry: 'xmain.ft' ", judgement.is_entry("xmain.ft"), ", 'tmp/xmain.ft' ",
            judgement.is_entry("tmp/xmain.ft"), ", 'tmp/.main.ft' ",
            judgement.is_entry("tmp/.main.ft"));
    println("is_entry: 'main.ftx' ", judgement.is_entry("main.ftx"), ", 'ain.ft' ",
            judgement.is_entry("ain.ft"), ", '' ", judgement.is_entry(""));
    println("is_entry: 'std/libc.ft' ", judgement.is_entry("std/libc.ft"), ", 'libc.ft' ",
            judgement.is_entry("libc.ft"), ", 'fir/main.ft' ", judgement.is_entry("fir/main.ft"));
    for (u64 mut k = 0; k < REPORT_COUNT; k++) {
        println("named_of '", REPORTS[k], "': ", judgement.named_of(REPORTS[k]));
    }
    append_reports(&b, named[..], &f);
    println("reports_at: the lines 2 to 8 of f:", strbuf.view(&b));
    strbuf.clear(&b);
    append_reports(&b, named[..], &g);
    strbuf.append(&b, ", of no function");
    append_reports(&b, named[..], null);
    println("reports_at: the lines 2 to 8 of g:", strbuf.view(&b));
    println("reports_at: line 3 of another file ",
            judgement.reports_at(named[..], &f, "std/rt.ft", 3), ", line 7 of another file ",
            judgement.reports_at(named[..], &f, "std/rt.ft", 7), ", no report line ",
            judgement.reports_at(none, &f, "main.ft", 3));
    println("reports_at: line 3 of 'tmp/main.ft' ",
            judgement.reports_at(named[..], &f, "tmp/main.ft", 3), ", of 'xmain.ft' ",
            judgement.reports_at(named[..], &f, "xmain.ft", 3), ", of 'tmp/xmain.ft' ",
            judgement.reports_at(named[..], &f, "tmp/xmain.ft", 3), ", of '' ",
            judgement.reports_at(named[..], &f, "", 3));
    for (u64 mut kind = 0; kind < 3; kind++) {
        strbuf.clear(&b);
        append_named(&b, named[..], &f, EVENTS[kind], "/tmp/fort-1/main.ft");
        strbuf.append(&b, ", another file ");
        append_named(&b, named[..], &f, EVENTS[kind], "std/rt.ft");
        println("rule ", shadow.EVENT_TEXT[kind], " on the lines 2 to 8: ", strbuf.view(&b));
    }
    strbuf.clear(&b);
    append_named(&b, named[..], &g, EVENTS[1], "main.ft");
    strbuf.append(&b, ", overwrite ");
    append_named(&b, named[..], &g, EVENTS[0], "main.ft");
    println("rule leak of g on the lines 2 to 8: ", strbuf.view(&b));
    strbuf.clear(&b);
    append_named(&b, named[..], &f, MOVE, "main.ft");
    println("rule use after move on the lines 2 to 8: ", strbuf.view(&b));
}

// Prints at_abort for three markers, the second of which ends in no abort, and for the lines
// around them. Then for two markers, the first of which ends in no abort.
fn print_at_abort() void {
    bool[3] aborts = {true, false, true};
    bool@ none = {};
    u32 first = judgement.DEAD_LINE;
    println("at_abort: line 7 ", judgement.at_abort(aborts[..], 7), ", before the first ",
            judgement.at_abort(aborts[..], first - 1), ", after the last ",
            judgement.at_abort(aborts[..], first + 3), ", no marker ",
            judgement.at_abort(none, first));
    println("at_abort: marker 0 ", judgement.at_abort(aborts[..], first), ", marker 1 ",
            judgement.at_abort(aborts[..], first + 1), ", marker 2 ",
            judgement.at_abort(aborts[..], first + 2));
    bool[2] later = {false, true};
    println("at_abort: marker 0 of no abort ", judgement.at_abort(later[..], first),
            ", marker 1 of an abort ", judgement.at_abort(later[..], first + 1));
}

interpreter.outcome_kind[7] OUTCOMES = {
    interpreter.outcome_kind.oc_none,
    interpreter.outcome_kind.oc_return,
    interpreter.outcome_kind.oc_exit,
    interpreter.outcome_kind.oc_abort,
    interpreter.outcome_kind.oc_trap,
    interpreter.outcome_kind.oc_outside,
    interpreter.outcome_kind.oc_fault,
};

// Prints the row of END_TEXT of the end `kind` with the text `what`, and whether a run with that
// end is an error of its own with no error event and with one.
fn print_end(interpreter.outcome_kind kind, string what) void {
    u64 end = judgement.end_of(kind, what);
    println("end_of ", cast(kind, i32), " '", what, "': ", judgement.END_TEXT[end],
            ", silent: 0 errors ", judgement.is_silent(end, 0), ", 1 error ",
            judgement.is_silent(end, 1));
}

// Prints print_end for each outcome kind, and for a fault with each text that has a row.
fn print_ends() void {
    for (u64 mut k = 0; k + 1 < OUTCOMES.len; k++) {
        print_end(OUTCOMES[k], "null dereference");
    }
    print_end(interpreter.outcome_kind.oc_fault, "null dereference");
    print_end(interpreter.outcome_kind.oc_fault, "invalid access");
    print_end(interpreter.outcome_kind.oc_fault, "the stack passes its limit");
    print_end(interpreter.outcome_kind.oc_fault, "");
}

// The row of generator.TYPES with the name `name`.
fn type_of(string name) u64 {
    for (u64 mut k = 0; k < generator.TYPE_COUNT; k++) {
        if (generator.TYPES[k].name == name) {
            return k;
        }
    }
    panic("judgement_test.type_of: no type has the name");
}

// The row of generator.STORAGES with the name `name`.
fn storage_of(string name) u64 {
    for (u64 mut k = 0; k < generator.STORAGE_COUNT; k++) {
        if (generator.STORAGES[k].name == name) {
            return k;
        }
    }
    panic("judgement_test.storage_of: no storage class has the name");
}

// The row of generator.OPERATIONS with the name `name`.
fn operation_of(string name) u64 {
    for (u64 mut k = 0; k < generator.OPERATION_COUNT; k++) {
        if (generator.OPERATIONS[k].name == name) {
            return k;
        }
    }
    panic("judgement_test.operation_of: no operation has the name");
}

// A failure of a function of two or three operations for class_of: the names of the cell and of
// the operations, the kind of the first error, and the statement of the error. The name of the
// third operation is the empty text in a function of two.
struct sample {
    string ty;
    string st;
    string first;
    string second;
    string third;
    shadow.event_kind kind;
    u64 pos;
}

shadow.event_kind MOVE = shadow.event_kind.ev_use_after_move;

// The `pos` of a sample whose error stands in a callee (judgement.AT_CALLEE).
u64 CALLEE = 9;
shadow.event_kind RELEASE = shadow.event_kind.ev_use_after_release;
shadow.event_kind TWICE = shadow.event_kind.ev_double_release;

u64 SAMPLE_COUNT = 86;

// A function of each class, then functions with no class: each differs from a function of a
// class in the one condition that the comment names.
sample[SAMPLE_COUNT] SAMPLES = {
    // moved: the place of the storage is no local
    {"ptr", "field", "release", "read", "", MOVE, 1},
    {"ptr", "spanned", "release", "read", "", MOVE, 1},
    {"ptr", "global", "release", "read", "", MOVE, 1},
    // moved: an inner owner behind a local owner
    {"box", "local", "slot del", "read", "", MOVE, 1},
    {"span", "parameter", "slot move out", "read", "", MOVE, 1},
    {"span", "element", "other del", "choose load", "", MOVE, 1},
    // moved: a statement vacates the whole local after the error, a `swap` fills it again, a
    // `self` passes no `move` of a local, and the drop of a `defer` runs at the end of its block,
    // which no loop holds
    {"box", "local", "slot del", "read", "release", MOVE, 1},
    {"box", "element", "swap", "slot del", "read", MOVE, 2},
    {"box", "local", "slot del", "self", "read", MOVE, 2},
    {"span", "local", "slot del", "defer", "read", MOVE, 2},
    {"box", "local", "defer", "loop", "slot del", MOVE, 2},
    // moved: an event ends the vacated state before the use: a store into the place, and the
    // test of `choose load` against `null`
    {"box", "local", "release", "alloc", "slot del", MOVE, 2},
    {"box", "parameter", "slot del", "self", "choose load", MOVE, 2},
    // no class: the owner is a local
    {"ptr", "local", "release", "read", "", MOVE, 1},
    {"box", "parameter", "move out", "read", "", MOVE, 1},
    {"arr", "element", "slot del", "read", "", MOVE, 1},
    // no class: a statement that vacates the whole local can run before the error: it stands
    // before it, or a loop holds both
    {"box", "local", "release", "slot del", "", MOVE, 1},
    {"span", "element", "slot move out", "shallow", "read", MOVE, 2},
    {"box", "parameter", "slot del", "self", "read", MOVE, 2},
    {"box", "local", "loop", "slot del", "release", MOVE, 1},
    {"span", "local", "range", "slot del", "shallow", MOVE, 1},
    {"box", "local", "loop", "defer", "slot del", MOVE, 2},
    {"box", "local", "loop", "slot del", "defer", MOVE, 1},
    // no class: the store stands before the statement that vacates, and the test of the type
    // compares no pointer with `null`
    {"box", "local", "alloc", "release", "slot del", MOVE, 2},
    {"span", "parameter", "slot del", "self", "choose load", MOVE, 2},
    // no class: another kind at the place of a class
    {"ptr", "global", "release", "read", "", RELEASE, 1},
    {"ptr", "global", "release", "read", "", TWICE, 1},
    // span pointer
    {"ptr", "spanned", "container", "store through", "", RELEASE, 1},
    {"arr", "spanned", "container", "release through", "", RELEASE, 1},
    {"box", "spanned", "container", "move through", "", RELEASE, 1},
    // no class: no release of the span, and no span
    {"ptr", "spanned", "release", "move through", "", RELEASE, 1},
    {"ptr", "field", "release", "move through", "", RELEASE, 1},
    // no class: a del of the collection in the body of its range loop, which the checker refuses
    {"span", "local", "range", "release", "", RELEASE, 0},
    {"arr", "spanned", "range", "container", "", RELEASE, 0},
    {"span", "global", "range", "release through", "", RELEASE, 0},
    // range callback
    {"str", "global", "range", "extern call", "", RELEASE, 0},
    // no class: the callback does not reach the storage, and the callback runs before the loop
    {"str", "local", "range", "extern call", "", RELEASE, 0},
    {"str", "global", "extern call", "range", "", RELEASE, 1},
    // view
    {"arr", "local", "lend call", "else", "load", RELEASE, 2},
    {"nest", "global", "extern pass", "drop", "load", RELEASE, 2},
    {"cell", "parameter", "lend", "release", "load", RELEASE, 2},
    // no class: no statement before the load gives the view a pointer, and no load
    {"arr", "local", "read", "else", "load", RELEASE, 2},
    {"arr", "local", "else", "load", "lend call", RELEASE, 1},
    {"arr", "local", "lend call", "else", "read", RELEASE, 2},
    // moved value
    {"cell", "local", "choose", "swap", "read", MOVE, 2},
    {"nest", "parameter", "read", "take", "self", MOVE, 0},
    {"cell", "local", "else", "move in", "read", MOVE, 2},
    // no class: no store of a moved value before the read, and no call of itself after it
    {"cell", "local", "release", "alloc", "read", MOVE, 2},
    {"cell", "local", "else", "alloc", "read", MOVE, 2},
    {"nest", "parameter", "self", "take", "read", MOVE, 2},
    {"cell", "local", "read", "choose", "swap", MOVE, 0},
    // no class: a statement that vacates the whole local can run before the error: no store
    // follows it, or it runs in the turn before, where the test reads no store
    {"cell", "local", "else", "read", "", MOVE, 1},
    {"arr", "element", "switch arms", "read", "", MOVE, 1},
    {"cell", "local", "move in", "else", "read", MOVE, 2},
    {"cell", "local", "loop", "move in", "switch arms", MOVE, 2},
    // moved value and no class: a local of the type `box` or `span` in a function with no
    // statement that vacates an inner owner is not of the class `moved`
    {"box", "local", "move in", "read", "", MOVE, 1},
    {"span", "local", "alloc", "read", "", MOVE, 1},
    // moved value: the statement that vacates a part stands after the error, and no loop holds
    // both
    {"arr", "parameter", "read", "slot del", "self", MOVE, 0},
    {"cell", "local", "move in", "read", "slot move out", MOVE, 1},
    {"nest", "parameter", "read", "self", "", MOVE, 0},
    // no class: a statement that vacates a part of the local stands before the error: one line
    // for each of the 3 part rows after a store of `move(y)`, then a store after the part row,
    // which this test does not read, then a part row before the error and a `self` after it
    {"arr", "local", "move in", "slot del", "read", MOVE, 2},
    {"arr", "parameter", "choose", "slot move out", "read", MOVE, 2},
    {"nest", "element", "swap", "other del", "read", MOVE, 2},
    {"cell", "local", "slot del", "move in", "read", MOVE, 2},
    {"cell", "parameter", "slot move out", "read", "self", MOVE, 1},
    {"nest", "parameter", "other del", "read", "self", MOVE, 1},
    // no class: the error stands at the head of a range loop, and a statement of the loop
    // vacates a part or the whole local
    {"arr", "local", "swap", "range", "slot del", MOVE, 1},
    {"arr", "local", "swap", "range", "move out", MOVE, 1},
    // no class: the call of the function itself passes no `move` of the place in this storage
    // class, and no statement before the error stores `move(y)`
    {"cell", "local", "read", "take", "self", MOVE, 0},
    {"arr", "element", "read", "self", "", MOVE, 0},
    // moved value: a part row at the statement of the error vacates the part after the use
    {"cell", "local", "move in", "slot move out", "", MOVE, 1},
    // no class: a `self` is a cause only after the statement of the error: not at it, and not
    // before it, also when a store into the place follows it
    {"nest", "parameter", "read", "self", "", MOVE, 1},
    {"nest", "parameter", "self", "alloc", "read", MOVE, 2},
    // callee read: a callee reads through `&%P` after a statement that vacates the whole local
    // (CALLEE marks an error in a callee), also in a later turn of a loop
    {"ptr", "local", "move out", "callee read", "", MOVE, CALLEE},
    {"box", "parameter", "release", "callee read", "", MOVE, CALLEE},
    {"arr", "element", "take", "callee read", "", MOVE, CALLEE},
    {"ptr", "local", "loop", "callee read", "move out", MOVE, CALLEE},
    // callee read: an inner owner of a type that holds it in the place
    {"cell", "argument", "slot move out", "callee read", "", MOVE, CALLEE},
    {"arr", "argument", "other del", "callee read", "", MOVE, CALLEE},
    // no class: the read stands before the statement that vacates, a store fills the place
    // between them, or no statement reads in a callee
    {"ptr", "local", "callee read", "move out", "", MOVE, CALLEE},
    {"ptr", "local", "move out", "alloc", "callee read", MOVE, CALLEE},
    {"ptr", "local", "move out", "put", "", MOVE, CALLEE},
    // moved: the place of the storage is no local, also for a read in a callee
    {"ptr", "global", "release", "callee read", "", MOVE, CALLEE},
    // moved: an inner owner behind a pointer of the local, also for a read in a callee
    {"box", "argument", "slot del", "callee read", "", MOVE, CALLEE},
    {"box", "argument", "slot move out", "callee read", "release", MOVE, CALLEE},
    // moved value: a `self` after the statement passes `move` of the vacated place to the
    // function itself, whose callee reads the place that took the value
    {"cell", "argument", "callee read", "release", "self", MOVE, CALLEE},
};

// A failure of a function of four operations for class_of: a loop, a store of `move(y)`, a use
// and a statement that vacates a part need four statements.
struct long_sample {
    string ty;
    string st;
    string[generator.MOST_STATEMENTS] names;
    shadow.event_kind kind;
    u64 pos;
}

u64 LONG_SAMPLE_COUNT = 15;

long_sample[LONG_SAMPLE_COUNT] LONG_SAMPLES = {
    // moved value: the loop opens after the error, so the part row runs after each use, and so
    // does a statement that vacates the whole local
    {"arr", "local", {"move in", "read", "loop", "slot del"}, MOVE, 1},
    {"cell", "local", {"move in", "read", "loop", "take"}, MOVE, 1},
    // no class: a loop holds the error and the part row after it, so the part row of one turn
    // runs before the use of the next turn, and the test reads no store between them
    {"arr", "local", {"loop", "move in", "read", "slot del"}, MOVE, 2},
    {"cell", "element", {"move in", "loop", "read", "slot move out"}, MOVE, 2},
    {"arr", "parameter", {"range", "swap", "read", "other del"}, MOVE, 2},
    // no class: the part row stands before the error in the loop
    {"nest", "local", {"loop", "choose", "other del", "read"}, MOVE, 3},
    // no class: a statement runs between the statement that vacates the whole local and the
    // store that fills it. One line for each of the 5 statements that the use rule rejects there
    // in the 4-operation family, with each of the 3 stores and the 2 statements of the error
    {"nest", "local", {"release", "lend call", "move in", "load"}, MOVE, 3},
    {"arr", "element", {"release", "extern pass", "swap", "load"}, MOVE, 3},
    {"cell", "parameter", {"switch arms", "lend", "choose", "read"}, MOVE, 3},
    {"cell", "parameter", {"switch arms", "read", "move in", "read"}, MOVE, 3},
    {"cell", "parameter", {"switch arms", "address", "swap", "read"}, MOVE, 3},
    {"cell", "element", {"move out", "lend", "move in", "load"}, MOVE, 3},
    // moved value: the statement stands after the store, or before the statement that vacates,
    // or after a `defer`, whose drop runs at the end of its block
    {"cell", "local", {"else", "move in", "lend", "read"}, MOVE, 3},
    {"cell", "parameter", {"read", "switch arms", "move in", "read"}, MOVE, 3},
    {"cell", "local", {"defer", "lend", "move in", "read"}, MOVE, 3},
};

// The failure of the sample `s`, with the error at statement `s->pos`, or in a callee for the
// `pos` CALLEE.
fn failure_of(sample* s) judgement.failure {
    judgement.failure mut f = judgement.failure{};
    f.ty = type_of(s->ty);
    f.st = storage_of(s->st);
    f.n = 2;
    f.ops[0] = operation_of(s->first);
    f.ops[1] = operation_of(s->second);
    if (s->third.len > 0) {
        f.n = 3;
        f.ops[2] = operation_of(s->third);
    }
    f.what = cast(cast(s->kind, i32), u64);
    f.pos = s->pos;
    if (s->pos == CALLEE) {
        f.pos = f.n;
        f.at = judgement.AT_CALLEE;
        return f;
    }
    f.at = f.ops[s->pos];
    return f;
}

// Prints each operation whose statement vacates the whole place (judgement.is_vacate), 6 names in
// a line, for the storage class `local` and for `parameter`, whose call of the function itself
// moves the place.
fn print_vacates() void {
    strbuf.str_buf mut b = strbuf.create();
    defer del(b.data);
    string[2] storages = {"local", "parameter"};
    for (u64 mut s = 0; s < 2; s++) {
        judgement.failure mut f = judgement.failure{};
        u64 mut count = 0;
        f.st = storage_of(storages[s]);
        strbuf.clear(&b);
        for (u64 mut op = 0; op < generator.OPERATION_COUNT; op++) {
            if (!judgement.is_vacate(&f, op)) {
                continue;
            } else if (count > 0 && count % 6 == 0) {
                println("is_vacate ", storages[s], ":", strbuf.view(&b));
                strbuf.clear(&b);
            }
            strbuf.push(&b, ' ');
            strbuf.append(&b, generator.OPERATIONS[op].name);
            strbuf.push(&b, ';');
            count += 1;
        }
        println("is_vacate ", storages[s], ":", strbuf.view(&b), " ", count, " operations");
    }
}

// Prints each operation whose statement stores a whole value into the place on each path
// (judgement.is_fill).
fn print_fills() void {
    strbuf.str_buf mut b = strbuf.create();
    defer del(b.data);
    u64 mut count = 0;
    for (u64 mut op = 0; op < generator.OPERATION_COUNT; op++) {
        if (judgement.is_fill(op)) {
            strbuf.push(&b, ' ');
            strbuf.append(&b, generator.OPERATIONS[op].name);
            strbuf.push(&b, ';');
            count += 1;
        }
    }
    println("is_fill:", strbuf.view(&b), " ", count, " operations");
}

// Texts of a statement for is_part_vacate_text: a `del` and a `move` of each of the two inner
// owners, with the `move` as the operand of a call, then a store into an inner owner, a test of
// it, and a `del` and a `move` of the whole place. OPERATIONS has no row that moves the second
// inner owner, so only these lines hold that term.
u64 PART_TEXT_COUNT = 9;

string[PART_TEXT_COUNT] PART_TEXTS = {
    "del(%S);",
    "drop_ptr(move(%S));",
    "del(%O);",
    "m = move(%O);",
    "%S = move(m);",
    "%O = new(i32);",
    "if (%S != null) {",
    "del(%P);",
    "e = move(%P);",
};

// Prints each operation whose statement moves or releases an inner owner of the place
// (judgement.is_part_vacate), their count, and the count of the operations on an inner owner:
// the text of such a row names `%S` or `%O`. A new operation on an inner owner changes the
// second count, so its author reads this line. Then it prints is_part_vacate for two places
// that are no statement, and is_part_vacate_text for each text of PART_TEXTS.
fn print_parts() void {
    strbuf.str_buf mut b = strbuf.create();
    defer del(b.data);
    u64 mut count = 0;
    u64 mut inner = 0;
    for (u64 mut op = 0; op < generator.OPERATION_COUNT; op++) {
        string text = generator.OPERATIONS[op].text;
        if (str.find(text, "%S") >= 0 || str.find(text, "%O") >= 0) {
            inner += 1;
        }
        if (judgement.is_part_vacate(op)) {
            strbuf.push(&b, ' ');
            strbuf.append(&b, generator.OPERATIONS[op].name);
            strbuf.push(&b, ';');
            count += 1;
        }
    }
    println("is_part_vacate:", strbuf.view(&b), " ", count, " of the ", inner,
            " operations on an inner owner");
    println("is_part_vacate: the end ", judgement.is_part_vacate(judgement.AT_END),
            ", a callee ", judgement.is_part_vacate(judgement.AT_CALLEE));
    for (u64 mut k = 0; k < PART_TEXT_COUNT; k++) {
        println("is_part_vacate_text '", PART_TEXTS[k], "': ",
                judgement.is_part_vacate_text(PART_TEXTS[k]));
    }
}

// The failure of the long sample `s`, with the error at statement `s->pos`.
fn long_failure_of(long_sample* s) judgement.failure {
    judgement.failure mut f = judgement.failure{};
    f.ty = type_of(s->ty);
    f.st = storage_of(s->st);
    f.n = generator.MOST_STATEMENTS;
    for (u64 mut k = 0; k < f.n; k++) {
        f.ops[k] = operation_of(s->names[k]);
    }
    f.what = cast(cast(s->kind, i32), u64);
    f.pos = s->pos;
    f.at = f.ops[s->pos];
    return f;
}

// Prints the class of the failure `f` after the key of its function, and adds `f` to `each`, and
// to `known` when it has a class.
fn print_class(judgement.failure f, judgement.totals mut* known, judgement.totals mut* each) void {
    strbuf.str_buf mut b = strbuf.create();
    defer del(b.data);
    u64 class = judgement.class_of(&f);
    judgement.append_key(&b, &f);
    println("class_of ", strbuf.view(&b), ": ", shadow.EVENT_TEXT[f.what], " at ", f.pos, ": ",
            judgement.class_key(class));
    judgement.push_failure(&each->failures, f);
    if (class != judgement.NO_CLASS) {
        judgement.push_failure(&known->failures, f);
    }
}

// Prints the exit status of run_part for no failure, the class of each sample and of each long
// sample, then the exit status for the samples of a class only and for each sample.
fn print_classes() void {
    judgement.totals mut* own known = judgement.make();
    defer judgement.drop_made(move(known));
    judgement.totals mut* own each = judgement.make();
    defer judgement.drop_made(move(each));
    println("exit_of: no failure ", judgement.exit_of(known));
    for (u64 mut k = 0; k < SAMPLE_COUNT; k++) {
        print_class(failure_of(&SAMPLES[k]), known, each);
    }
    for (u64 mut k = 0; k < LONG_SAMPLE_COUNT; k++) {
        print_class(long_failure_of(&LONG_SAMPLES[k]), known, each);
    }
    println("exit_of: ", known->failures.len, " failures of a class ", judgement.exit_of(known),
            ", ", each->failures.len, " failures with ",
            judgement.class_count(each, judgement.NO_CLASS), " of no class ",
            judgement.exit_of(each));
}

// The count of the units of judgement.KNOWN: the 3 sets of the gate and the parts of the typed
// family.
u64 UNITS = judgement.UNIT_TYPED + judgement.PARTS;

// Prints holds_known for the unit `unit` with `count` failures of the class `class` and `none`
// failures with no class.
fn print_held(u64 unit, u64 class, u64 count, u64 none) void {
    u64[judgement.CLASS_COUNT + 1] mut counts = {};
    counts[class] = count;
    counts[judgement.NO_CLASS] = none;
    bool held = judgement.holds_known("known", unit, counts[..]);
    println("holds_known: unit ", unit, ", class ", judgement.class_key(class), " ", count,
            ", no class ", none, ": ", held);
}

// The row of SAMPLES of a use after move of a local owner, which has no class.
u64 LOCAL_SAMPLE = 13;

// The row of SAMPLES of the class `callee read`.
u64 CALLEE_SAMPLE = 73;

// Prints known_exit for a unit of KNOWN with `count` failures of the class of the first sample,
// which is `moved`, and `none` failures of the class of the sample LOCAL_SAMPLE, which has none.
// The unit also gets the count of the class `callee read` that KNOWN lists for it, as failures
// of the sample CALLEE_SAMPLE.
fn print_known_exit(u64 unit, u64 count, u64 none) void {
    judgement.totals mut* own t = judgement.make();
    defer judgement.drop_made(move(t));
    judgement.failure listed = failure_of(&SAMPLES[0]);
    judgement.failure other = failure_of(&SAMPLES[LOCAL_SAMPLE]);
    judgement.failure callee = failure_of(&SAMPLES[CALLEE_SAMPLE]);
    for (u64 mut k = 0; k < count; k++) {
        judgement.push_failure(&t->failures, listed);
    }
    for (u64 mut k = 0; k < judgement.known_count(unit, judgement.CLASS_CALLEE_READ); k++) {
        judgement.push_failure(&t->failures, callee);
    }
    for (u64 mut k = 0; k < none; k++) {
        judgement.push_failure(&t->failures, other);
    }
    i32 status = judgement.known_exit("known", unit, t);
    println("known_exit: unit ", unit, ", ", count, " failures of the class ",
            judgement.class_key(judgement.class_of(&listed)), ", ", none, " of the class ",
            judgement.class_key(judgement.class_of(&other)), ": ", status);
}

// Prints the class of an item of the gate whose first error is an event of each kind with the
// moved tag of a slot of no frame (class_of_event). Then the class of a `use after move` with the
// moved tag of a slot of a frame that another frame read, with that of a slot that its own frame
// read, and with no moved tag. Then the counts of count_failure over those 13 events, and
// holds_known over them for the unit of the shapes: a failure with no class stays in the counts.
fn print_class_of_event() void {
    ast.sym caller = ast.sym{};
    u64[judgement.CLASS_COUNT + 1] mut by = {};
    shadow.event mut ev = shadow.event{};
    ev.t.f.kind = shadow.tag_kind.tg_moved;
    for (u64 mut kind = 0; kind < judgement.KINDS; kind++) {
        ev.kind = EVENTS[kind];
        println("class_of_event ", shadow.EVENT_TEXT[kind], ": ",
                judgement.class_key(judgement.class_of_event(&ev)));
        judgement.count_failure(by[..], &ev);
    }
    ev.kind = shadow.event_kind.ev_use_after_move;
    ev.t.f.sym = &caller;
    ev.t.f.flag = true;
    println("class_of_event use after move, a slot of a frame that another frame read: ",
            judgement.class_key(judgement.class_of_event(&ev)));
    judgement.count_failure(by[..], &ev);
    ev.t.f.flag = false;
    println("class_of_event use after move, a slot that its own frame read: ",
            judgement.class_key(judgement.class_of_event(&ev)));
    judgement.count_failure(by[..], &ev);
    ev.t.f = shadow.origin{};
    println("class_of_event use after move, no moved tag: ",
            judgement.class_key(judgement.class_of_event(&ev)));
    judgement.count_failure(by[..], &ev);
    strbuf.str_buf mut b = strbuf.create();
    defer del(b.data);
    for (u64 mut class = 0; class <= judgement.CLASS_COUNT; class++) {
        if (by[class] == 0) {
            continue;
        }
        strbuf.append(&b, b.len == 0 ? "" : ", ");
        strbuf.append(&b, judgement.class_key(class));
        strbuf.push(&b, ' ');
        strbuf.append_u64(&b, by[class]);
    }
    println("count_failure: ", strbuf.view(&b));
    bool held = judgement.holds_known("known", judgement.UNIT_SHAPES, by[..]);
    println("holds_known: the counts of count_failure for unit ", judgement.UNIT_SHAPES, ": ",
            held);
}

// Prints the list KNOWN: one line for each unit with its count of each class that has a row and
// its total, one line for each class with its count over the units, and the total. Then holds_known
// for the unit of the shapes, which has 18 failures of the class `released`: the list exactly,
// one more, one fewer, a failure with no class, and a failure of a class with no row. Then
// known_exit for part 3 of the typed family, which has 88 failures of the class `moved`: the list
// exactly, one more, one fewer, and the list with a failure of no class. Then known_exit for a
// unit with no row.
fn print_known() void {
    strbuf.str_buf mut b = strbuf.create();
    defer del(b.data);
    u64 mut total = 0;
    for (u64 mut unit = 0; unit < UNITS; unit++) {
        u64 mut listed = 0;
        strbuf.clear(&b);
        for (u64 mut class = 0; class < judgement.CLASS_COUNT; class++) {
            u64 count = judgement.known_count(unit, class);
            listed += count;
            if (count > 0) {
                strbuf.push(&b, ' ');
                strbuf.append(&b, judgement.class_key(class));
                strbuf.push(&b, ' ');
                strbuf.append_u64(&b, count);
                strbuf.push(&b, ',');
            }
        }
        println("known: unit ", unit, ":", strbuf.view(&b), " total ", listed);
    }
    for (u64 mut class = 0; class < judgement.CLASS_COUNT; class++) {
        println("known: class ", judgement.class_key(class), ": ",
                judgement.known_of_class(class));
        total += judgement.known_of_class(class);
    }
    println("known: total ", total, ", rows ", judgement.KNOWN.len, ", a unit with no row: ",
            judgement.known_count(UNITS, judgement.CLASS_MOVED));
    print_held(judgement.UNIT_SHAPES, judgement.CLASS_RELEASED, 18, 0);
    print_held(judgement.UNIT_SHAPES, judgement.CLASS_RELEASED, 19, 0);
    print_held(judgement.UNIT_SHAPES, judgement.CLASS_RELEASED, 17, 0);
    print_held(judgement.UNIT_SHAPES, judgement.CLASS_RELEASED, 18, 1);
    print_held(judgement.UNIT_SHAPES, judgement.CLASS_SCOPE, 1, 0);
    print_known_exit(judgement.UNIT_TYPED + 2, 88, 0);
    print_known_exit(judgement.UNIT_TYPED + 2, 89, 0);
    print_known_exit(judgement.UNIT_TYPED + 2, 87, 0);
    print_known_exit(judgement.UNIT_TYPED + 2, 88, 1);
    print_known_exit(UNITS, 0, 0);
    print_known_exit(UNITS, 1, 0);
}

// The declarations of the hand batch, one line in each element: an owner of a struct with an
// inner owner, a global owner, a drop of `del(s, d)` that keeps its operand in a global and so is
// not release-only (D17.9), and `drive`.
u64 DECL_LINES = 40;
string[DECL_LINES] DECLS = {
    "struct pair {",
    "    i32 mut* own lo;",
    "}",
    "struct cell {",
    "    i32 mut* own head;",
    "}",
    "i32 mut* own mut G = null;",
    "i32 mut* own mut KEPT = null;",
    "cell mut C = {};",
    "fn drop_ptr(i32 mut* own d) void {",
    "    del(d);",
    "}",
    "fn keep(i32 mut* own d) void {",
    "    i32 mut* own old = move(KEPT);",
    "    KEPT = move(d);",
    "    del(old);",
    "}",
    "fn fresh_pair() pair mut* own {",
    "    pair mut* own d = new(pair);",
    "    d->lo = new(i32);",
    "    return d;",
    "}",
    "fn fresh_span() i32 mut* own mut@ own {",
    "    i32 mut* own mut@ own d = new(i32 mut* own, 2);",
    "    i32 mut* own nv = new(i32);",
    "    i32 mut* own old = move(d[0]);",
    "    d[0] = move(nv);",
    "    del(old);",
    "    return d;",
    "}",
    "fn drive(fn (bool, u64) void f, bool b, u64 i, bool live) i32 {",
    "    if (live) {",
    "        i32 mut* own nv = new(i32);",
    "        i32 mut* own old = move(G);",
    "        G = move(nv);",
    "        del(old);",
    "    }",
    "    f(b, i);",
    "    return 0;",
    "}",
};

// The count of the functions of the hand batch, and of their lines.
u64 HAND_COUNT = 19;
u64 HAND_LINES = 107;

// The functions of the hand batch, one line in each element. A function ends with the line `}`.
// In `two_casts` the pass reports the first `cast`, whose object holds an owner, and proves the
// second. The function has two `cast` statements, so the report line names no `del`, and the
// `leak` at the `del` of the result of the first `cast` fails it. `cast_and_int` has the same
// reported `cast` and an integer `cast`, and fails in the same way. In `bare_param` the callee
// `pass_on` has one reported `cast` and releases its parameter, the result of the `cast` of
// `hide`: the report line names no `del` of a value that its function did not make, so the `leak`
// there fails the function. `pass_on` ends on the line of its last statement, so it is a part of
// the text of `bare_param` and no function of the batch of its own.
string[HAND_LINES] HAND = {
    "fn clean(bool b, u64 i) void {",
    "    i32 mut* own n = new(i32);",
    "    del(n);",
    "}",
    "fn abort_leak(bool b, u64 i) void {",
    "    {",
    "        i32 mut* own n = new(i32);",
    "    }",
    "    panic(\"stop\");",
    "}",
    "fn leak_report(bool b, u64 i) void {",
    "    pair mut* own p = fresh_pair();",
    "    del(p);",
    "}",
    "fn whole_report(bool b, u64 i) void {",
    "    C = cell{new(i32)};",
    "    C = cell{new(i32)};",
    "}",
    "fn span_report(bool b, u64 i) void {",
    "    i32 mut* own mut@ own s = fresh_span();",
    "    del(s);",
    "}",
    "fn report_and_use(bool b, u64 i) void {",
    "    pair mut* own p = fresh_pair();",
    "    del(p);",
    "    del(G);",
    "    i32 mut n = *G;",
    "    n += 1;",
    "}",
    "fn use_only(bool b, u64 i) void {",
    "    del(G);",
    "    i32 mut n = *G;",
    "    n += 1;",
    "}",
    "fn not_release_only(bool b, u64 i) void {",
    "    i32 mut* own mut@ own s = fresh_span();",
    "    del(s, keep);",
    "}",
    "fn no_end(bool b, u64 i) void {",
    "    no_end(b, i);",
    "}",
    "fn refused(bool b, u64 i) void {",
    "    u64 n = b;",
    "}",
    "fn report_then_abort(bool b, u64 i) void {",
    "    pair mut* own p = fresh_pair();",
    "    del(p);",
    "    panic(\"stop\");",
    "}",
    "fn two_kinds(bool b, u64 i) void {",
    "    if (G == null) {",
    "        i32 mut* own n = new(i32);",
    "        i32* v = n;",
    "        del(n);",
    "        i32 mut u = *v;",
    "        u += 1;",
    "    }",
    "    del(G);",
    "    i32 mut w = *G;",
    "    w += 1;",
    "}",
    "fn cast_report(bool b, u64 i) void {",
    "    pair mut* own p = fresh_pair();",
    "    void* own t = cast(move(p), void* own);",
    "    del(t);",
    "}",
    "fn hide(pair mut* own p) void* own { return cast(move(p), void* own); }",
    "fn cast_elsewhere(bool b, u64 i) void {",
    "    void* own t = hide(fresh_pair());",
    "    del(t);",
    "}",
    "fn other_report(bool b, u64 i) void {",
    "    pair mut* own p = fresh_pair();",
    "    del(p);",
    "    void* own t = hide(fresh_pair());",
    "    del(t);",
    "}",
    "fn cast_and_del(bool b, u64 i) void {",
    "    pair mut* own q = new(pair);",
    "    del(q);",
    "    pair mut* own p = fresh_pair();",
    "    void* own t = cast(move(p), void* own);",
    "    del(t);",
    "}",
    "fn two_casts(bool b, u64 i) void {",
    "    pair mut* own p = fresh_pair();",
    "    void* own t = cast(move(p), void* own);",
    "    pair mut* own q = new(pair);",
    "    void* own u = cast(move(q), void* own);",
    "    del(u);",
    "    del(t);",
    "}",
    "fn pass_on(void* own a) void {",
    "    pair mut* own p = fresh_pair();",
    "    void* own t = cast(move(p), void* own);",
    "    del(t);",
    "    del(a); }",
    "fn bare_param(bool b, u64 i) void {",
    "    pass_on(hide(fresh_pair()));",
    "}",
    "fn cast_and_int(bool b, u64 i) void {",
    "    pair mut* own p = fresh_pair();",
    "    void* own t = cast(move(p), void* own);",
    "    i32 mut k = cast(i, i32);",
    "    k += 1;",
    "    del(t);",
    "}",
};

// Appends each line of `lines` and a newline to `b`. When `ends` is not empty, it gets the length
// of `b` after each line `}`: the end of each function.
fn join(strbuf.str_buf mut* b, string@ lines, u64 mut@ ends) void {
    u64 mut count = 0;
    for (u64 mut k = 0; k < lines.len; k++) {
        strbuf.append(b, lines[k]);
        strbuf.push(b, '\n');
        if (lines[k] == "}" && count < ends.len) {
            ends[count] = b->len;
            count += 1;
        }
    }
}

// Judges the hand batch and prints its counts, then one line for each failure: its function, its
// verdict, its first error and each other kind of error of its runs.
fn print_hand() void {
    strbuf.str_buf mut decls = strbuf.create();
    defer del(decls.data);
    strbuf.str_buf mut kinds = strbuf.create();
    defer del(kinds.data);
    strbuf.str_buf mut hand = strbuf.create();
    defer del(hand.data);
    check_env.env mut* own c = check_env.make();
    defer check_env.drop_made(move(c));
    judgement.totals mut* own t = judgement.make();
    defer judgement.drop_made(move(t));
    u64[HAND_COUNT] mut ends = {};
    u64 mut@ none = {};
    join(&decls, DECLS[..], none);
    join(&hand, HAND[..], ends[..]);
    string[HAND_COUNT] mut texts = {};
    u64 mut start = 0;
    for (u64 mut k = 0; k < HAND_COUNT; k++) {
        texts[k] = strbuf.view(&hand)[start..ends[k]];
        start = ends[k];
    }
    judgement.judge_hand(c, strbuf.view(&decls), texts[..], generator.READS_LIVE, t);
    judgement.print_totals("hand", t);
    println("hand: named lines: ", judgement.REPORT_TEXT[0], " ", t->named[0], ", ",
            judgement.REPORT_TEXT[1], " ", t->named[1], ", ", judgement.REPORT_TEXT[2], " ",
            t->named[2]);
    for (u64 mut k = 0; k < t->failures.len; k++) {
        judgement.failure* f = &t->failures.items[k];
        strbuf.clear(&kinds);
        judgement.append_kinds(&kinds, f);
        println("hand: failure: function ", f->seq, ", ",
                judgement.VERDICT_TEXT[cast(cast(f->said, i32), u64)], ": ",
                judgement.what_text(f->what), " at ", judgement.place_text(f->at),
                strbuf.view(&kinds));
    }
}

fn main() i32 {
    print_rule();
    print_named();
    print_at_abort();
    print_ends();
    print_vacates();
    print_fills();
    print_parts();
    print_classes();
    print_class_of_event();
    print_known();
    print_hand();
    return 0;
}
