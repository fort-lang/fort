//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: judgement.hold_known: the failures of a unit are not those that KNOWN lists
//! stdout:
//| known: failures in KNOWN 18
//| hold_known: unit 2 gives KNOWN
//| known: class released: failures 12, KNOWN lists 11: a failure is new
//| known: failures in KNOWN 14
/// The gate of test/fort/owner/oracle_test.ft holds the failing items of each of its sets against
/// judgement.KNOWN through judgement.hold_known, which stops the test when a count differs. The
/// test gives hold_known the counts of the unit of the shapes as KNOWN lists them, which return,
/// and then the counts of the unit of the hand items with one failure more of the class
/// `released`, which stops it. The stop is a panic of test/fort/support/judgement.ft, a support
/// module and no module of src/fort. So the name of the test does not end in `_panic_test`: such
/// a test answers a panic site of src/fort (tools/panic_coverage.py).
import judgement;

fn main() i32 {
    u64[judgement.CLASS_COUNT + 1] mut counts = {};
    counts[judgement.CLASS_RELEASED] = judgement.known_count(judgement.UNIT_SHAPES,
                                                             judgement.CLASS_RELEASED);
    judgement.hold_known("known", judgement.UNIT_SHAPES, counts[..]);
    println("hold_known: unit ", judgement.UNIT_SHAPES, " gives KNOWN");
    u64[judgement.CLASS_COUNT + 1] mut hand = {};
    for (u64 mut class = 0; class < judgement.CLASS_COUNT; class++) {
        hand[class] = judgement.known_count(judgement.UNIT_HAND, class);
    }
    hand[judgement.CLASS_RELEASED] += 1;
    judgement.hold_known("known", judgement.UNIT_HAND, hand[..]);
    println("hold_known: unit ", judgement.UNIT_HAND, " does not give KNOWN");
    return 0;
}
