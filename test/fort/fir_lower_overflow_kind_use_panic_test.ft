//! run
//! flags: -I ../../src
//! abort
//! stderr: panic: fir_lower.overflow_kind: not a checked form
//! stdout:
//| true
/// Only `+`, `-` and `*` have a checked form. overflow_kind on `use` breaks that
/// precondition, so the call panics.
import fort.fir;
import fort.fir_lower;

fn main() i32 {
    fir.rvalue_kind add = fir.rvalue_kind.rv_add;
    println(fir_lower.overflow_kind(add) == fir.rvalue_kind.rv_add_overflows);
    fir_lower.overflow_kind(fir.rvalue_kind.rv_use);
    return 0;
}
