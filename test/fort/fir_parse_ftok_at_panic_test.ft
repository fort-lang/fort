//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: fir_parse.ftok_at: index out of range
//! stdout:
//| 0
/// ftok_at reads one token of the FIR lexer. An index at or past the length breaks that
/// precondition, so the call panics.
import fir_parse;

fn main() i32 {
    fir_parse.ftok_vec mut v = fir_parse.ftok_vec{};
    defer fir_parse.ftok_free(&v);
    println(v.len);
    fir_parse.ftok_at(&v, 0);
    return 0;
}
