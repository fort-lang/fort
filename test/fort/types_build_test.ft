//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| suffixes ok
//| placement ok
//| ownership ok
//| spelling ok
//| builder ok
//| deep ok
//| ok
import prim;
import types;
import types_env;
import std.strbuf;

// The type builder and the canonical spelling: the reading rules, the
// placement rules, and every row of the tables those rules carry. Each row is
// one assertion: the reader of support/types_env turns the spelling into
// type_build arguments, and the type is checked by the levels it marks mutable
// (`muts`, level 0 first), by the `own` mark of each of its references
// (`owns`, outermost first) and by the spelling type_to_str gives it back. The
// port of test/types_build_test.c.
// D3.6, D5.3, D17.2
//
// Every marker follows the type element whose storage it marks and the last
// position is the binding, so a declaration's own `mut` is just the last one
// written.
// D5.3

// One suffix with no marks, the shape the descriptor tests start from.
fn plain(types.suffix_kind kind, u64 len) types.suffix {
    return types.suffix{kind, len, false, false};
}

// ---- reading suffixes ----------------------------------------------------------
// D3.6

// Reference suffixes read inside-out; the fixed-array group reads outside-in
// and sits between the two reference groups.
fn the_d3_6_shapes_round_trip() void {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    assert(types_env.spell(&e, "node**") == "node**");
    assert(types_env.spell(&e, "node*@") == "node*@");
    assert(types_env.spell(&e, "u8@*") == "u8@*");
    assert(types_env.spell(&e, "u8@@") == "u8@@");
    assert(types_env.spell(&e, "i32[3][4]") == "i32[3][4]");
    assert(types_env.spell(&e, "node*[16]") == "node*[16]");
    assert(types_env.spell(&e, "node@[4]") == "node@[4]");
    assert(types_env.spell(&e, "i32[4]*") == "i32[4]*");
    assert(types_env.spell(&e, "i32[4]@") == "i32[4]@");
    assert(types_env.spell(&e, "node*@*") == "node*@*");
    assert(types_env.spell(&e, "void*[2]") == "void*[2]");
    assert(types_env.spell(&e, "i32@@") == "i32@@");
    assert(types_env.spell(&e, "i32@[4]") == "i32@[4]");
}

fn the_d3_6_shapes_are_the_ones_it_names() void {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    // `node*@` is a span of pointers, `u8@*` a pointer to a span.
    types.node* span_of_ptr = types_env.type_of(&e, "node*@");
    assert(span_of_ptr->kind == types.type_kind.k_span);
    assert(span_of_ptr->elem->kind == types.type_kind.k_ptr);
    types.node* ptr_to_span = types_env.type_of(&e, "u8@*");
    assert(ptr_to_span->kind == types.type_kind.k_ptr);
    assert(ptr_to_span->elem->kind == types.type_kind.k_span);
    // `node*[16]` is sixteen pointers, `node@[4]` four spans.
    types.node* ptrs = types_env.type_of(&e, "node*[16]");
    assert(ptrs->kind == types.type_kind.k_array);
    assert(ptrs->len == 16);
    assert(ptrs->elem->kind == types.type_kind.k_ptr);
    types.node* spans = types_env.type_of(&e, "node@[4]");
    assert(spans->kind == types.type_kind.k_array);
    assert(spans->elem->kind == types.type_kind.k_span);
    // `i32[4]*` points to the whole array, `i32[4]@` spans it.
    assert(types_env.type_of(&e, "i32[4]*")->elem->kind == types.type_kind.k_array);
    assert(types_env.type_of(&e, "i32[4]@")->elem->kind == types.type_kind.k_array);
    // `i32[3][4]` is three arrays of four, indexed a[i][j].
    types.node* m = types_env.type_of(&e, "i32[3][4]");
    assert(m->len == 3);
    assert(m->elem->len == 4);
    // `void*` is its own kind, with no pointee type.
    // D3.11
    assert(types_env.type_of(&e, "void*")->kind == types.type_kind.k_voidptr);
    assert(types_env.type_of(&e, "void mut*")->kind == types.type_kind.k_voidptr);
    assert(types_env.type_of(&e, "void mut*")->is_mut);
    assert(!types_env.type_of(&e, "void*")->is_mut);
    assert(types_env.type_of(&e, "void**")->kind == types.type_kind.k_ptr);
    assert(types_env.type_of(&e, "void**")->elem->kind == types.type_kind.k_voidptr);
}

// `i32[4]*[2]` does not parse; wrap the pointer in a struct.
// D3.6
fn an_array_suffix_never_follows_a_reference_suffix() void {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    string msg = "error: no array suffix may follow a trailing reference suffix";
    assert(types_env.spell(&e, "i32[4]*[2]") == msg);
    assert(types_env.spell(&e, "i32[4]@[2]") == msg);
    assert(types_env.spell(&e, "node*[2]*[2]") == msg);
}

// The elements of a fixed array share its storage, so the marker goes after
// the length: `i32 mut[4]` is an error.
// D5.3
fn a_marker_that_belongs_to_an_array_is_refused() void {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    string msg = "error: mark the array after its length";
    assert(types_env.spell(&e, "i32 mut[4]") == msg);
    assert(types_env.spell(&e, "i32[3] mut[4]") == msg);
    assert(types_env.spell(&e, "node* mut[4]") == msg);
    assert(types_env.spell(&e, "node** mut[4]") == msg);
    assert(types_env.spell(&e, "node@ mut[4]") == msg);
    // The array's own position is where it belongs.
    assert(types_env.spell_decl(&e, "i32[4] mut") == "i32[4] mut");
    assert(types_env.spell_decl(&e, "i32[3][4] mut") == "i32[3][4] mut");
    assert(types_env.spell_decl(&e, "node*[4] mut") == "node*[4] mut");
    assert(types_env.spell(&e, "i32[4] mut*") == "i32[4] mut*");
    // A `mut` after a reference suffix that no array follows is fine.
    assert(types_env.spell(&e, "node* mut*") == "node* mut*");
    assert(types_env.spell(&e, "node* mut@") == "node* mut@");
}

// `own` follows a `*` or an `@`, or `string`, the reference with no suffix; it
// never follows another base type or a fixed-array suffix.
// D17.2
fn an_own_marks_a_reference_and_nothing_else() void {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    string msg = "error: 'own' marks a reference: write it after a '*' or an '@'";
    string arr = "error: 'own' never follows a fixed-array suffix";
    assert(types_env.spell(&e, "node own*") == msg);
    assert(types_env.spell(&e, "i32 own") == msg);
    assert(types_env.spell(&e, "point own") == msg);
    assert(types_env.spell(&e, "color own") == msg);
    assert(types_env.spell(&e, "node*[4] own") == arr);
    assert(types_env.spell(&e, "i32[4] own") == arr);
    // Where it is legal, it marks exactly the reference it follows.
    assert(types_env.spell(&e, "node* own") == "node* own");
    assert(types_env.spell(&e, "u8@ own") == "u8@ own");
    assert(types_env.spell(&e, "string own") == "string own");
    assert(types_env.spell(&e, "void* own") == "void* own");
    assert(types_env.spell(&e, "node* own[4]") == "node* own[4]");
}

fn builder_errors_of_lengths_and_void() void {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    assert(types_env.spell(&e, "i32[0]") == "error: array length must be greater than 0");
    assert(types_env.spell(&e, "i32[4][0]") == "error: array length must be greater than 0");
    assert(types_env.spell(&e, "void") == "void");
    assert(types_env.spell(&e, "void*") == "void*");
    assert(types_env.spell(&e, "void**") == "void**");
    assert(types_env.spell(&e, "void*@") == "void*@");
    assert(types_env.spell_decl(&e, "void* mut") == "void* mut");
    // The storage a `void*` reaches has no type, and `void mut*` marks it
    // writable; the two `mut` positions are distinct and both spell back.
    // D3.11, D5.3
    assert(types_env.spell(&e, "void mut*") == "void mut*");
    assert(types_env.spell_decl(&e, "void mut* mut") == "void mut* mut");
    assert(types_env.spell(&e, "void mut* own") == "void mut* own");
    assert(types_env.spell_decl(&e, "void mut* own mut") == "void mut* own mut");
    assert(types_env.spell(&e, "void mut**") == "void mut**");
    assert(types_env.spell(&e, "void mut* mut*") == "void mut* mut*");
    assert(types_env.spell(&e, "void mut*@") == "void mut*@");
    assert(types_env.spell(&e, "void mut* mut@ own") == "void mut* mut@ own");
    // `void` still names no storage of its own, so every other marker on it is
    // an error, and a span or an array of `void` does not exist.
    // D3.11, D5.3
    string msg = "error: 'void' is only a return type or the base of 'void*'";
    assert(types_env.spell(&e, "void mut@") == msg);
    assert(types_env.spell(&e, "void mut[4]") == msg);
    assert(types_env.spell(&e, "void own*") == msg);
    assert(types_env.spell(&e, "void own") == msg);
    assert(types_env.spell(&e, "void@") == msg);
    assert(types_env.spell(&e, "void[4]") == msg);
    assert(types_env.spell(&e, "void mut") == msg);
}

fn an_own_mark_on_a_function_type_is_refused() void {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node* i32t = types.type_prim(&e.tt, prim.prim_kind.prim_i32);
    types.node* f = types_env.fn1(&e, i32t, i32t);
    types.suffix[1] mut none = {};
    // A function pointer is not a reference that owns anything.
    // D17.1
    types.build_result mut r = types.type_build(&e.tt, true, false, f, none[..0]);
    assert(r.built == null);
    assert(r.error == "'own' marks a reference: write it after a '*' or an '@'");
    // A `mut` after a function type marks the storage holding the function
    // pointer, which in the last position is the binding.
    // D5.3
    r = types.type_build(&e.tt, false, true, f, none[..0]);
    assert(r.built == f);
    assert(r.mut0);
}

// ---- the placement rule --------------------------------------------------------
// D5.3

fn the_d5_3_table_marks_the_levels_it_names() void {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    assert(types_env.muts(&e, "i32 mut") == "y");
    assert(types_env.muts(&e, "point mut") == "y");
    assert(types_env.muts(&e, "i32[4] mut") == "y");
    assert(types_env.muts(&e, "node*") == "nn");
    assert(types_env.muts(&e, "node* mut") == "yn");
    assert(types_env.muts(&e, "node mut*") == "ny");
    assert(types_env.muts(&e, "node mut* mut") == "yy");
    assert(types_env.muts(&e, "i32@") == "nn");
    assert(types_env.muts(&e, "i32@ mut") == "yn");
    assert(types_env.muts(&e, "i32 mut@") == "ny");
    assert(types_env.muts(&e, "node* mut@") == "nyn");
    assert(types_env.muts(&e, "node mut*@") == "nny");
    assert(types_env.muts(&e, "node* mut*") == "nyn");
    assert(types_env.muts(&e, "node mut**") == "nny");
    assert(types_env.muts(&e, "u8 mut@ mut*") == "nyy");
    assert(types_env.muts(&e, "u8@ mut*") == "nyn");
    assert(types_env.muts(&e, "node*[4] mut") == "yn");
    assert(types_env.muts(&e, "string mut") == "y");
}

fn the_d5_3_table_spells_its_declarations_back() void {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    assert(types_env.spell_decl(&e, "i32 mut") == "i32 mut");
    assert(types_env.spell_decl(&e, "point mut") == "point mut");
    assert(types_env.spell_decl(&e, "i32[4] mut") == "i32[4] mut");
    assert(types_env.spell_decl(&e, "node*") == "node*");
    assert(types_env.spell_decl(&e, "node* mut") == "node* mut");
    assert(types_env.spell_decl(&e, "node mut*") == "node mut*");
    assert(types_env.spell_decl(&e, "node mut* mut") == "node mut* mut");
    assert(types_env.spell_decl(&e, "i32@") == "i32@");
    assert(types_env.spell_decl(&e, "i32@ mut") == "i32@ mut");
    assert(types_env.spell_decl(&e, "i32 mut@") == "i32 mut@");
    assert(types_env.spell_decl(&e, "node* mut@") == "node* mut@");
    assert(types_env.spell_decl(&e, "node mut*@") == "node mut*@");
    assert(types_env.spell_decl(&e, "node* mut*") == "node* mut*");
    assert(types_env.spell_decl(&e, "node mut**") == "node mut**");
    assert(types_env.spell_decl(&e, "u8 mut@ mut*") == "u8 mut@ mut*");
    assert(types_env.spell_decl(&e, "u8@ mut*") == "u8@ mut*");
    assert(types_env.spell_decl(&e, "node*[4] mut") == "node*[4] mut");
    assert(types_env.spell_decl(&e, "string mut") == "string mut");
}

fn the_placement_rule_on_further_shapes() void {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    // Chains of three, where each position marks one level.
    // D5.3
    assert(types_env.muts(&e, "node**") == "nnn");
    assert(types_env.muts(&e, "node** mut") == "ynn");
    assert(types_env.muts(&e, "node mut* mut* mut") == "yyy");
    assert(types_env.muts(&e, "i32@ mut@") == "nyn");
    assert(types_env.muts(&e, "i32@@ mut") == "ynn");
    assert(types_env.muts(&e, "i32 mut@ mut@ mut") == "yyy");
    // A fixed array adds no level, so its elements and the array are one
    // storage.
    // D5.2
    assert(types_env.muts(&e, "i32[4]@") == "nn");
    assert(types_env.muts(&e, "i32[4] mut@") == "ny");
    assert(types_env.muts(&e, "i32[4]@ mut") == "yn");
    assert(types_env.muts(&e, "node mut*[4]") == "ny");
    assert(types_env.muts(&e, "node mut*[4] mut") == "yy");
    assert(types_env.muts(&e, "i32[3][4]") == "n");
    assert(types_env.muts(&e, "i32[3][4] mut") == "y");
    // Structs, strings and `void*` behave like any other base type.
    assert(types_env.muts(&e, "point*") == "nn");
    assert(types_env.muts(&e, "point mut*") == "ny");
    assert(types_env.muts(&e, "point mut* mut") == "yy");
    assert(types_env.muts(&e, "string@ mut") == "yn");
    assert(types_env.muts(&e, "string mut@") == "ny");
    // A `void*` reaches a level whose storage has no type, so it has two
    // positions: the binding and the storage behind the pointer.
    // D3.11, D5.2
    assert(types_env.muts(&e, "void*") == "nn");
    assert(types_env.muts(&e, "void* mut") == "yn");
    assert(types_env.muts(&e, "void mut*") == "ny");
    assert(types_env.muts(&e, "void mut* mut") == "yy");
    assert(types_env.muts(&e, "void mut* mut*") == "nyy");
    assert(types_env.muts(&e, "void mut* mut@ mut") == "yyy");
    // Out-parameters, the shape the rule names.
    // D3.6
    assert(types_env.muts(&e, "u8@*") == "nnn");
    assert(types_env.muts(&e, "u8@* mut") == "ynn");
    assert(types_env.muts(&e, "u8 mut@ mut* mut") == "yyy");
    assert(types_env.muts(&e, "i32[4]*") == "nn");
    assert(types_env.muts(&e, "i32[4] mut*") == "ny");
    assert(types_env.muts(&e, "i32[4] mut* mut") == "yy");
}

fn the_placement_rule_spells_further_shapes_back() void {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    assert(types_env.spell_decl(&e, "node** mut") == "node** mut");
    assert(types_env.spell_decl(&e, "node mut* mut* mut") == "node mut* mut* mut");
    assert(types_env.spell_decl(&e, "i32@ mut@") == "i32@ mut@");
    assert(types_env.spell_decl(&e, "i32@@ mut") == "i32@@ mut");
    assert(types_env.spell_decl(&e, "i32 mut@ mut@ mut") == "i32 mut@ mut@ mut");
    assert(types_env.spell_decl(&e, "i32[4] mut@") == "i32[4] mut@");
    assert(types_env.spell_decl(&e, "i32[4]@ mut") == "i32[4]@ mut");
    assert(types_env.spell_decl(&e, "node mut*[4] mut") == "node mut*[4] mut");
    assert(types_env.spell_decl(&e, "i32[3][4] mut") == "i32[3][4] mut");
    assert(types_env.spell_decl(&e, "point mut* mut") == "point mut* mut");
    assert(types_env.spell_decl(&e, "string mut@") == "string mut@");
    assert(types_env.spell_decl(&e, "string@ mut") == "string@ mut");
    assert(types_env.spell_decl(&e, "u8@* mut") == "u8@* mut");
    assert(types_env.spell_decl(&e, "u8 mut@ mut* mut") == "u8 mut@ mut* mut");
    assert(types_env.spell_decl(&e, "i32[4] mut* mut") == "i32[4] mut* mut");
}

// Level 0 is a position like any other: the marker before the name.
fn the_last_position_is_the_binding() void {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    assert(types_env.mut0_of(&e, "node* mut"));
    assert(!types_env.mut0_of(&e, "node mut*"));
    assert(types_env.mut0_of(&e, "i32 mut"));
    assert(!types_env.mut0_of(&e, "i32"));
    assert(types_env.mut0_of(&e, "point mut"));
    assert(types_env.mut0_of(&e, "i32[3][4] mut"));
    assert(types_env.mut0_of(&e, "node*[4] mut"));
    assert(!types_env.mut0_of(&e, "node* mut@"));
    assert(types_env.mut0_of(&e, "node* mut@ mut"));
    assert(types_env.mut0_of(&e, "string own mut"));
    // The binding's marker is not part of the type.
    assert(types_env.type_of(&e, "node* mut") == types_env.type_of(&e, "node*"));
    assert(types_env.type_of(&e, "node mut*") != types_env.type_of(&e, "node*"));
    assert(types_env.type_of(&e, "point mut") == types_env.type_of(&e, "point"));
    assert(types_env.type_of(&e, "i32[4] mut") == types_env.type_of(&e, "i32[4]"));
    assert(types_env.type_of(&e, "i32[3][4] mut") == types_env.type_of(&e, "i32[3][4]"));
    assert(types_env.type_of(&e, "string mut") == types_env.type_of(&e, "string"));
    assert(types_env.type_of(&e, "void* mut") == types_env.type_of(&e, "void*"));
    // A type with a suffix keeps its own marks whatever the binding says.
    assert(types_env.type_of(&e, "node mut* mut") == types_env.type_of(&e, "node mut*"));
    assert(types_env.spell(&e, "node mut* mut") == "node mut*");
    assert(types_env.spell(&e, "i32[4] mut") == "i32[4]");
}

// ---- ownership placement -------------------------------------------------------
// D17.2

fn the_d17_2_table_marks_the_references_it_names() void {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    assert(types_env.owns(&e, "u8 mut@ own") == "y");
    assert(types_env.owns(&e, "u8@ own") == "y");
    assert(types_env.owns(&e, "node mut* own") == "y");
    assert(types_env.owns(&e, "node* mut@ own") == "yn");
    assert(types_env.owns(&e, "node mut* own mut@ own") == "yy");
    assert(types_env.owns(&e, "node* own@") == "ny");
    assert(types_env.owns(&e, "u8 mut@ own mut*") == "ny");
    assert(types_env.owns(&e, "string own") == "y");
}

// `own` never changes which levels are mutable.
// D17.2
fn the_d17_2_table_marks_the_levels_it_names() void {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    assert(types_env.muts(&e, "u8 mut@ own") == "ny");
    assert(types_env.muts(&e, "u8@ own") == "nn");
    assert(types_env.muts(&e, "node mut* own") == "ny");
    assert(types_env.muts(&e, "node* mut@ own") == "nyn");
    assert(types_env.muts(&e, "node mut* own mut@ own") == "nyy");
    assert(types_env.muts(&e, "node* own@") == "nnn");
    assert(types_env.muts(&e, "u8 mut@ own mut*") == "nyy");
    assert(types_env.muts(&e, "string own") == "n");
}

fn the_d17_2_table_spells_its_declarations_back() void {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    assert(types_env.spell_decl(&e, "u8 mut@ own") == "u8 mut@ own");
    assert(types_env.spell_decl(&e, "u8@ own") == "u8@ own");
    assert(types_env.spell_decl(&e, "node mut* own") == "node mut* own");
    assert(types_env.spell_decl(&e, "node* mut@ own") == "node* mut@ own");
    assert(types_env.spell_decl(&e, "node mut* own mut@ own") == "node mut* own mut@ own");
    assert(types_env.spell_decl(&e, "node* own@") == "node* own@");
    assert(types_env.spell_decl(&e, "u8 mut@ own mut*") == "u8 mut@ own mut*");
    assert(types_env.spell_decl(&e, "string own") == "string own");
}

// `kids[i]` of a `node mut* own mut@ own` is a `node mut* own`, and `*out` of
// a `u8 mut@ own mut*` a `u8 mut@ own`.
// D17.2
fn the_marks_inside_a_derived_type_survive() void {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node* kids = types_env.type_of(&e, "node mut* own mut@ own");
    assert(kids->elem == types_env.type_of(&e, "node mut* own"));
    types.node* out = types_env.type_of(&e, "u8 mut@ own mut*");
    assert(out->elem == types_env.type_of(&e, "u8 mut@ own"));
    types.node* view = types_env.type_of(&e, "node* own@");
    assert(view->elem == types_env.type_of(&e, "node* own"));
    types.node* items = types_env.type_of(&e, "node* mut@ own");
    assert(items->elem == types_env.type_of(&e, "node*"));
    types.node* four = types_env.type_of(&e, "node* own[4]");
    assert(four->elem == types_env.type_of(&e, "node* own"));
}

// A reference is owning only where its own position says so.
// D17.2
fn each_own_marks_one_reference_only() void {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    assert(types_env.owns(&e, "node** own") == "yn");
    assert(types_env.owns(&e, "node* own* own") == "yy");
    assert(types_env.owns(&e, "node* own*") == "ny");
    assert(types_env.owns(&e, "u8@* own") == "yn");
    assert(types_env.owns(&e, "u8@ own*") == "ny");
    assert(types_env.owns(&e, "string own@ own") == "yy");
    assert(types_env.owns(&e, "string@ own") == "yn");
    assert(types_env.spell(&e, "node** own") == "node** own");
    assert(types_env.spell(&e, "node* own* own") == "node* own* own");
    assert(types_env.spell(&e, "u8@ own*") == "u8@ own*");
    assert(types_env.spell(&e, "u8@* own") == "u8@* own");
    assert(types_env.spell(&e, "string own@ own") == "string own@ own");
}

// ---- spellings for diagnostics -------------------------------------------------

fn function_types_are_spelled_fn_return_parameters() void {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node* i32t = types.type_prim(&e.tt, prim.prim_kind.prim_i32);
    types.node* v = types.type_void(&e.tt);
    types.node*[1] mut none = {};
    assert(types_env.str_of(&e, types_env.fn2(&e, i32t, i32t, i32t)) == "fn (i32, i32) i32");
    assert(types_env.str_of(&e, types_env.fn1(&e, i32t, i32t)) == "fn (i32) i32");
    assert(types_env.str_of(&e, types_env.fn0(&e, v)) == "fn () void");
    assert(types_env.str_of(&e, types.type_fn(&e.tt, v, none[..0], true)) == "fn () noreturn");
    // Parameter and return types keep their own marks.
    assert(types_env.str_of(&e, types_env.fn1(&e, v, types_env.type_of(&e, "node mut* own"))) ==
           "fn (node mut* own) void");
    assert(types_env.str_of(&e, types_env.fn0(&e, types_env.type_of(&e, "string own"))) ==
           "fn () string own");
    assert(types_env.str_of(&e,
                            types_env.fn1(&e, v, types_env.type_of(&e, "u8 mut@ own mut*"))) ==
           "fn (u8 mut@ own mut*) void");
    // A function type may be a parameter type itself.
    assert(types_env.str_of(&e, types_env.fn1(&e, v, types_env.fn1(&e, i32t, i32t))) ==
           "fn (fn (i32) i32) void");
}

fn suffixes_after_a_function_type_apply_to_it() void {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node* i32t = types.type_prim(&e.tt, prim.prim_kind.prim_i32);
    types.node* f = types_env.fn1(&e, i32t, i32t);
    // `fn i32(i32)[4]`: an array of four function pointers.
    // D3.6
    assert(types_env.str_of(&e, types.type_array(&e.tt, f, 4)) == "fn (i32) i32[4]");
    // `fn i32[4](i32)`: a function returning an `i32[4]`.
    assert(types_env.str_of(&e, types_env.fn1(&e, types.type_array(&e.tt, i32t, 4), i32t)) ==
           "fn (i32) i32[4]");
    // `fn i32(i32)*`: a pointer to a slot holding a function pointer.
    assert(types_env.str_of(&e, types.type_ptr(&e.tt, f, false, false)) == "fn (i32) i32*");
    assert(types_env.str_of(&e, types.type_ptr(&e.tt, f, false, true)) == "fn (i32) i32 mut*");
    assert(types_env.str_of(&e, types.type_span(&e.tt, f, false, false)) == "fn (i32) i32@");
}

// A mutable level behind an immutable one, which `&f` on an immutable struct
// with a `node mut*` field yields, is written by marking each position on its
// own.
// D5.3
fn every_combination_of_markers_has_a_spelling() void {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node* mut_node_ptr = types_env.type_of(&e, "node mut*");
    assert(types_env.str_of(&e, types.type_ptr(&e.tt, mut_node_ptr, false, false)) ==
           "node mut**");
    types.node* mut_span = types_env.type_of(&e, "i32 mut@");
    assert(types_env.str_of(&e, types.type_span(&e.tt, mut_span, false, false)) == "i32 mut@@");
    // An owned string inside a type has its own position too.
    // D3.7, D17.2
    types.node* own_string = types_env.type_of(&e, "string own");
    assert(types_env.str_of(&e, types.type_ptr(&e.tt, own_string, false, false)) ==
           "string own*");
    assert(types_env.str_of(&e, types.type_span(&e.tt, own_string, false, false)) ==
           "string own@");
    // Each of those spellings reads back as the type it came from.
    assert(types_env.type_of(&e, "node mut**") ==
           types.type_ptr(&e.tt, mut_node_ptr, false, false));
    assert(types_env.type_of(&e, "i32 mut@@") ==
           types.type_span(&e.tt, mut_span, false, false));
    assert(types_env.type_of(&e, "string own*") ==
           types.type_ptr(&e.tt, own_string, false, false));
    assert(types_env.type_of(&e, "string own@") ==
           types.type_span(&e.tt, own_string, false, false));
}

// No array suffix may follow a trailing reference suffix, so a pointer to an
// array inside an array has no spelling; diagnostics print the inner type in
// parentheses.
// D3.6
fn only_an_array_behind_a_reference_needs_parentheses() void {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node* arr_ptr = types.type_ptr(&e.tt, types_env.type_of(&e, "i32[4]"), false, false);
    assert(types_env.str_of(&e, types.type_array(&e.tt, arr_ptr, 2)) == "(i32[4])*[2]");
    types.node* arr_span = types.type_span(&e.tt, types_env.type_of(&e, "i32[4]"), false, true);
    assert(types_env.str_of(&e, types.type_array(&e.tt, arr_span, 2)) == "(i32[4] mut)@[2]");
    // The marker of the storage behind the parentheses is written inside them,
    // since the position after `)` belongs to the suffix that follows.
    types.node* mut_ptr = types.type_ptr(&e.tt, types_env.type_of(&e, "i32[4]"), false, true);
    assert(types_env.str_of(&e, types.type_array(&e.tt, mut_ptr, 2)) == "(i32[4] mut)*[2]");
}

// The speller walks 64 nodes in one group; a deeper chain, which no source can
// write, is cut and continued in parentheses rather than truncated.
fn a_chain_deeper_than_one_group_continues_in_parentheses() void {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    u64 depth = 70;
    types.node* mut t = e.node;
    u64 mut i = 0;
    while (i < depth) {
        t = types.type_ptr(&e.tt, t, false, false);
        i += 1;
    }
    strbuf.str_buf mut out = strbuf.create();
    defer strbuf.free(&out);
    types.type_to_str(t, &out);
    string spelled = strbuf.view(&out);
    // One `(`, one `)`, the base once and 70 stars.
    u64 mut stars = 0;
    u64 mut parens = 0;
    u64 mut k = 0;
    while (k < spelled.len) {
        if (spelled[k] == '*') {
            stars += 1;
        }
        if (spelled[k] == '(') {
            parens += 1;
        }
        k += 1;
    }
    assert(stars == depth);
    assert(parens == 1);
    assert(types.type_levels(t) == depth);
}

fn the_null_and_error_types_have_a_spelling() void {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    assert(types_env.str_of(&e, types.type_null(&e.tt)) == "null");
    assert(types_env.str_of(&e, types.type_error(&e.tt)) == "<error>");
    assert(types_env.str_of(&e, types.type_void(&e.tt)) == "void");
    assert(types_env.str_of(&e, e.point) == "point");
    assert(types_env.str_of(&e, e.color) == "color");
}

fn spelling_a_type_appends_to_the_buffer() void {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    strbuf.str_buf mut out = strbuf.create();
    defer strbuf.free(&out);
    strbuf.append(&out, "expected ");
    types.type_to_str(types_env.type_of(&e, "u8 mut@ own"), &out);
    strbuf.append(&out, ", found ");
    types.type_to_str_decl(types_env.type_of(&e, "node* mut"), true, &out);
    assert(strbuf.view(&out) == "expected u8 mut@ own, found node* mut");
}

// `type_to_str` leaves the binding's position empty and `type_to_str_decl`
// writes it; nothing else moves.
// D5.3
fn the_declaration_spelling_writes_the_last_marker_only() void {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node* t = types_env.type_of(&e, "node mut*");
    strbuf.str_buf mut out = strbuf.create();
    defer strbuf.free(&out);
    types.type_to_str_decl(t, false, &out);
    assert(strbuf.view(&out) == "node mut*");
    strbuf.clear(&out);
    types.type_to_str_decl(t, true, &out);
    assert(strbuf.view(&out) == "node mut* mut");
    strbuf.clear(&out);
    types.type_to_str_decl(e.point, true, &out);
    assert(strbuf.view(&out) == "point mut");
    strbuf.clear(&out);
    types.type_to_str_decl(e.point, false, &out);
    assert(strbuf.view(&out) == "point");
    strbuf.clear(&out);
    types.type_to_str_decl(types_env.type_of(&e, "i32[3][4]"), true, &out);
    assert(strbuf.view(&out) == "i32[3][4] mut");
    strbuf.clear(&out);
    types.type_to_str_decl(types_env.type_of(&e, "string own"), true, &out);
    assert(strbuf.view(&out) == "string own mut");
    strbuf.clear(&out);
    types.type_to_str_decl(types_env.type_of(&e, "node* mut@ own"), true, &out);
    assert(strbuf.view(&out) == "node* mut@ own mut");
}

// ---- the builder on descriptors ------------------------------------------------

// `node*@*` is a pointer to a span of pointers: reference suffixes read
// inside-out, and each position carries its own markers.
// D3.6, D5.3
fn the_builder_reads_the_three_suffix_groups() void {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.suffix[3] mut suffixes = {plain(types.suffix_kind.s_ptr, 0),
                                    plain(types.suffix_kind.s_span, 0),
                                    types.suffix{types.suffix_kind.s_ptr, 0, true, true}};
    types.build_result r = types.type_build(&e.tt, false, false, e.node, suffixes[..]);
    assert(r.error == "");
    assert(r.mut0);
    assert(r.built->kind == types.type_kind.k_ptr);
    assert(r.built->is_own);
    assert(r.built->elem->kind == types.type_kind.k_span);
    assert(!r.built->elem->is_own);
    assert(r.built->elem->elem->kind == types.type_kind.k_ptr);
    assert(r.built->elem->elem->elem == e.node);
    assert(types_env.str_of(&e, r.built) == "node*@* own");
    assert(r.built == types_env.type_of(&e, "node*@* own"));
    // The array group sits between the two reference groups.
    types.suffix[3] mut mixed = {plain(types.suffix_kind.s_ptr, 0),
                                 types.suffix{types.suffix_kind.s_array, 4, false, true},
                                 types.suffix{types.suffix_kind.s_span, 0, true, false}};
    types.build_result m = types.type_build(&e.tt, true, false, e.node, mixed[..]);
    assert(m.built == null);
    assert(m.error == "'own' marks a reference: write it after a '*' or an '@'");
    types.build_result ok = types.type_build(&e.tt, false, false, e.node, mixed[..]);
    assert(ok.error == "");
    assert(!ok.mut0);
    assert(types_env.str_of(&e, ok.built) == "node*[4] mut@ own");
}

// `string` is the one base type that takes `own`, being a reference with no
// suffix.
// D3.7, D17.2
fn a_base_position_own_marks_a_string() void {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.suffix[1] mut none = {};
    types.build_result mut r =
        types.type_build(&e.tt, true, false, types_env.type_of(&e, "string"), none[..0]);
    assert(r.error == "");
    assert(r.built == types_env.type_of(&e, "string own"));
    assert(!r.mut0);
    // With the binding's marker as well.
    r = types.type_build(&e.tt, true, true, types_env.type_of(&e, "string"), none[..0]);
    assert(r.built == types_env.type_of(&e, "string own"));
    assert(r.mut0);
    assert(types_env.spell_decl(&e, "string own mut") == "string own mut");
    // No other base type takes it, whatever the caller passes.
    string msg = "'own' marks a reference: write it after a '*' or an '@'";
    r = types.type_build(&e.tt, true, false, types_env.type_of(&e, "node*"), none[..0]);
    assert(r.error == msg);
    r = types.type_build(&e.tt, true, false, types_env.type_of(&e, "u8@"), none[..0]);
    assert(r.error == msg);
    r = types.type_build(&e.tt, true, false, e.point, none[..0]);
    assert(r.error == msg);
}

// The base already failed, so its markers are not diagnosed a second time,
// whatever they are.
fn a_poisoned_base_poisons_the_type_and_says_nothing() void {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node* err = types.type_error(&e.tt);
    types.suffix[1] mut none = {};
    types.build_result mut r = types.type_build(&e.tt, false, true, err, none[..0]);
    assert(r.error == "");
    assert(r.built == err);
    assert(r.mut0);
    types.suffix[2] mut suffixes = {types.suffix{types.suffix_kind.s_ptr, 0, true, false},
                                    types.suffix{types.suffix_kind.s_array, 4, false, true}};
    r = types.type_build(&e.tt, true, true, err, suffixes[..]);
    assert(r.error == "");
    assert(r.built == err);
    assert(r.mut0);
    // A poisoned element does the same through the constructors.
    assert(types.type_ptr(&e.tt, err, true, true) == err);
}

fn the_builder_interns_what_the_constructors_intern() void {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node* i32t = types.type_prim(&e.tt, prim.prim_kind.prim_i32);
    assert(types_env.type_of(&e, "node*") == types.type_ptr(&e.tt, e.node, false, false));
    assert(types_env.type_of(&e, "node mut* own") == types.type_ptr(&e.tt, e.node, true, true));
    assert(types_env.type_of(&e, "i32 mut@") == types.type_span(&e.tt, i32t, false, true));
    assert(types_env.type_of(&e, "string own") == types.type_string(&e.tt, true));
    assert(types_env.type_of(&e, "void* own") == types.type_voidptr(&e.tt, true, false));
    assert(types_env.type_of(&e, "void mut*") == types.type_voidptr(&e.tt, false, true));
    assert(types_env.type_of(&e, "i32[4]") == types.type_array(&e.tt, i32t, 4));
}

// ---- deeper chains -------------------------------------------------------------

fn deep_chains_round_trip() void {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    assert(types_env.spell(&e, "node***") == "node***");
    assert(types_env.spell(&e, "i32[2][3][4]") == "i32[2][3][4]");
    assert(types_env.spell(&e, "u8@**") == "u8@**");
    assert(types_env.spell(&e, "node*[4] mut*") == "node*[4] mut*");
    assert(types_env.spell(&e, "node* own[4]*") == "node* own[4]*");
    assert(types_env.spell(&e, "u8@* own") == "u8@* own");
    assert(types_env.spell(&e, "string@") == "string@");
    assert(types_env.spell(&e, "string@ own") == "string@ own");
    assert(types_env.spell(&e, "void**") == "void**");
    assert(types_env.spell(&e, "i32[4][2]@") == "i32[4][2]@");
    assert(types_env.spell(&e, "node* mut* mut*") == "node* mut* mut*");
    assert(types_env.spell(&e, "point*[2]*") == "point*[2]*");
}

fn deep_chains_mark_the_levels_the_suffixes_name() void {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    assert(types_env.muts(&e, "node***") == "nnnn");
    assert(types_env.muts(&e, "node mut* mut* mut* mut") == "yyyy");
    assert(types_env.muts(&e, "node* mut**") == "nnyn");
    assert(types_env.muts(&e, "node** mut*") == "nynn");
    assert(types_env.muts(&e, "node*** mut") == "ynnn");
    assert(types_env.muts(&e, "node* mut* mut*") == "nyyn");
    assert(types_env.muts(&e, "node*[4] mut*") == "nyn");
    assert(types_env.muts(&e, "node mut*[4] mut* mut") == "yyy");
    assert(types_env.muts(&e, "u8@**") == "nnnn");
    assert(types_env.muts(&e, "i32[4][2]@") == "nn");
}

// Whatever the type ends with, the marker before the name is the binding's.
// D5.3
fn the_binding_takes_the_last_position_of_every_shape() void {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    assert(types_env.muts(&e, "node* mut@ mut") == "yyn");
    assert(types_env.spell_decl(&e, "node* mut@ mut") == "node* mut@ mut");
    assert(types_env.spell(&e, "node* mut@ mut") == "node* mut@");
    assert(types_env.muts(&e, "u8@ mut* mut") == "yyn");
    assert(types_env.spell_decl(&e, "u8@ mut* mut") == "u8@ mut* mut");
    // A fixed array holds its elements, so the array's own position is the
    // last one and it is the binding's.
    // D5.2, D5.3
    assert(types_env.muts(&e, "node*[4] mut") == "yn");
    assert(types_env.muts(&e, "node*[4][2] mut") == "yn");
    assert(types_env.spell_decl(&e, "node*[4][2] mut") == "node*[4][2] mut");
    assert(types_env.muts(&e, "i32[4] mut") == "y");
}

fn own_and_mut_combine_in_both_positions() void {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    assert(types_env.spell(&e, "u8 mut@ own mut* own") == "u8 mut@ own mut* own");
    assert(types_env.muts(&e, "u8 mut@ own mut* own") == "nyy");
    assert(types_env.muts(&e, "u8 mut@ own mut* own mut") == "yyy");
    assert(types_env.spell_decl(&e, "u8 mut@ own mut* own mut") == "u8 mut@ own mut* own mut");
    assert(types_env.owns(&e, "u8 mut@ own mut* own") == "yy");
    assert(types_env.spell(&e, "u8@ own* mut") == "u8@ own*");
    assert(types_env.spell_decl(&e, "u8@ own* mut") == "u8@ own* mut");
    assert(types_env.muts(&e, "u8@ own* mut") == "ynn");
    assert(types_env.owns(&e, "u8@ own* mut") == "ny");
    assert(types_env.spell(&e, "node* own* own* own") == "node* own* own* own");
    assert(types_env.owns(&e, "node* own* own* own") == "yyy");
}

fn array_lengths_are_kept_exactly() void {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    assert(types_env.spell(&e, "i32[1]") == "i32[1]");
    assert(types_env.spell(&e, "i32[65536]") == "i32[65536]");
    assert(types_env.type_of(&e, "i32[65536]")->len == 65536);
    assert(types.type_sizeof(types_env.type_of(&e, "u8[65536]")) == 65536);
    assert(types_env.type_of(&e, "i32[1]") != types_env.type_of(&e, "i32[2]"));
}

fn main() i32 {
    the_d3_6_shapes_round_trip();
    the_d3_6_shapes_are_the_ones_it_names();
    an_array_suffix_never_follows_a_reference_suffix();
    a_marker_that_belongs_to_an_array_is_refused();
    an_own_marks_a_reference_and_nothing_else();
    builder_errors_of_lengths_and_void();
    an_own_mark_on_a_function_type_is_refused();
    println("suffixes ok");
    the_d5_3_table_marks_the_levels_it_names();
    the_d5_3_table_spells_its_declarations_back();
    the_placement_rule_on_further_shapes();
    the_placement_rule_spells_further_shapes_back();
    the_last_position_is_the_binding();
    println("placement ok");
    the_d17_2_table_marks_the_references_it_names();
    the_d17_2_table_marks_the_levels_it_names();
    the_d17_2_table_spells_its_declarations_back();
    the_marks_inside_a_derived_type_survive();
    each_own_marks_one_reference_only();
    println("ownership ok");
    function_types_are_spelled_fn_return_parameters();
    suffixes_after_a_function_type_apply_to_it();
    every_combination_of_markers_has_a_spelling();
    only_an_array_behind_a_reference_needs_parentheses();
    a_chain_deeper_than_one_group_continues_in_parentheses();
    the_null_and_error_types_have_a_spelling();
    spelling_a_type_appends_to_the_buffer();
    the_declaration_spelling_writes_the_last_marker_only();
    println("spelling ok");
    the_builder_reads_the_three_suffix_groups();
    a_base_position_own_marks_a_string();
