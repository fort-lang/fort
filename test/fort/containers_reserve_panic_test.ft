//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: containers.str_reserve: capacity overflow
//! stdout:
//| 1
import containers;

/// Checks that reserve rejects a request when length plus request exceeds u64. The guard
/// prevents checked overflow and release-mode wrap.
fn main() i32 {
    containers.str_vec mut v = containers.str_create();
    defer containers.str_free(&v);
    containers.str_push(&v, "a");
    println(v.len);
    containers.str_reserve(&v, 18446744073709551615);
    return 0;
}
