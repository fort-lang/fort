//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: containers.str_reserve: capacity overflow
//! stdout:
//| 1
import containers;

// A reserve whose length plus request does not fit a u64 panics before the
// sum is computed: detecting the overflow by performing it would trap in a
// checked build and wrap in a release one, so the two builds would disagree.
// The vector holds one element, so the request that overflows is U64_MAX
// itself.
// D3.1, D11.1
fn main() i32 {
    containers.str_vec mut v = containers.str_create();
    defer containers.str_free(&v);
    containers.str_push(&v, "a");
    println(v.len);
    containers.str_reserve(&v, 18446744073709551615);
    return 0;
}
