//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| flags ok
//| valued ok
//| usage ok
//| help ok
//| statuses ok
//| dumps ok
//| front end ok
//| std dir ok
//| reentrancy ok
//| ok
/// Checks command-line options, usage errors, mode statuses, and the standard
/// library directory in src/fort/driver.ft.
import capture;
import containers;
import driver;
import std.io;
import std.os;
import std.str;
import std.strbuf;
import std.sys;

//
// A fort test can drive part of bootstrap0/test/driver_test.c in process. This suite
// covers the command line, dumps, front end, emitter, and exit statuses. It
// also covers a missing --cc program and one that runs and fails.
// bootstrap0/test/driver_test.c checks the complete clang command line through
// bootstrap0/test/common/fake_cc.sh. A fort test cannot ship that script beside itself.
//
// Each driver run writes to stdout or stderr. support/capture.ft captures that
// output in this test's directory and reads it back. Only this file's
// `println`s reach the harness.

// The exit statuses, as this suite spells them.
i32 EXIT_OK = 0;
i32 EXIT_COMPILE_ERROR = 1;
i32 EXIT_USAGE = 2;

// ---- running the driver with its output captured --------------------------------

// The status of `fort <args>`, with stdout in `out.txt` and stderr in
// `err.txt` of the working directory.
fn run(string@ args) i32 {
    i32 saved_out = capture.begin(io.STDOUT, "out.txt");
    i32 saved_err = capture.begin(io.STDERR, "err.txt");
    i32 status = driver.run(args);
    capture.end(io.STDERR, saved_err);
    capture.end(io.STDOUT, saved_out);
    return status;
}

fn captured_out() string own {
    return capture.text("out.txt");
}

fn captured_err() string own {
    return capture.text("err.txt");
}

// Whether the last run's stderr holds `text`.
fn err_has(string text) bool {
    string own got = captured_err();
    defer del(got);
    return str.find(got, text) >= 0;
}

// Whether the last run's stdout holds `text`.
fn out_has(string text) bool {
    string own got = captured_out();
    defer del(got);
    return str.find(got, text) >= 0;
}

// Writes a source file of the working directory, which a run then compiles.
fn write_file(string path, string text) void {
    assert(io.write_file(path, cast(text, u8@)));
}

// The errno a directory that already exists reports.
i32 EEXIST = 17;

// Every closure holds `std.rt`, which the driver reads from `<std-dir>/rt.ft`.
// The driver uses `std` beside the program when no option names a directory.
// The runs below give `fort` as argv[0], so that directory
// is `std` of this test's own working directory. What the driver needs there
// is a file that parses, not a runtime: nothing these tests build is ever run.
fn write_runtime() void {
    assert(mkdir("std".ptr, 0o700) == 0 || sys.errno() == EEXIST);
    write_file("std/rt.ft", "// The empty runtime of a driver test.\n");
}

// ---- the flags that carry no value ----------------------------------------------

// Each spelling sets its own flag and nothing else. The parse stops at
// PARSE_OK with the entry file in place.
fn every_flag_sets_its_own_option() void {
    string[8] mut argv = {"fort", "-S", "-c", "--release", "--no-bounds-check", "--check",
                          "entry.ft", ""};
    driver.options mut opts = driver.options_create();
    defer driver.options_free(&opts);
    assert(driver.parse(&opts, argv[0..7]) == driver.PARSE_OK);
    assert(opts.emit_ir);
    assert(opts.compile_only);
    assert(opts.release);
    assert(opts.no_bounds_check);
    assert(opts.check);
    assert(opts.have_entry);
    assert(opts.entry == "entry.ft");
    // Nothing the command line did not name is set.
    assert(!opts.json);
    assert(!opts.index);
    assert(!opts.tokens);
    assert(!opts.ast);
}

// --index implies --check and --json, so it is the whole command line an
// editor gives the compiler.
fn index_implies_check_and_json() void {
    string[3] mut argv = {"fort", "--index", "entry.ft"};
    driver.options mut opts = driver.options_create();
    defer driver.options_free(&opts);
    assert(driver.parse(&opts, argv[0..3]) == driver.PARSE_OK);
    assert(opts.index);
    assert(opts.check);
    assert(opts.json);
}

// --tokens and --ast imply nothing: each stops the run at one pass.
fn the_two_dumps_imply_nothing() void {
    string[3] mut tokens = {"fort", "--tokens", "entry.ft"};
    driver.options mut a = driver.options_create();
    defer driver.options_free(&a);
    assert(driver.parse(&a, tokens[0..3]) == driver.PARSE_OK);
    assert(a.tokens);
    assert(!a.check && !a.json && !a.ast);
    string[3] mut ast = {"fort", "--ast", "entry.ft"};
    driver.options mut b = driver.options_create();
    defer driver.options_free(&b);
    assert(driver.parse(&b, ast[0..3]) == driver.PARSE_OK);
    assert(b.ast);
    assert(!b.check && !b.json && !b.tokens);
}

// ---- the options that take a value -----------------------------

// The last -o, --std-dir, --cc and --target win.
fn the_last_value_of_a_single_option_wins() void {
    string[11] mut argv = {"fort", "-o", "first", "-o", "second", "--cc", "gcc", "--target",
                           "aarch64-linux-gnu", "--std-dir", "lib"};
    driver.options mut opts = driver.options_create();
    defer driver.options_free(&opts);
    string[12] mut full = {"fort", "-o", "first", "-o", "second", "--cc", "gcc", "--target",
                           "aarch64-linux-gnu", "--std-dir", "lib", "entry.ft"};
    assert(driver.parse(&opts, full[0..12]) == driver.PARSE_OK);
    assert(opts.output == "second");
    assert(opts.cc == "gcc");
    assert(opts.target == "aarch64-linux-gnu");
    assert(opts.std_dir == "lib");
    assert(argv.len == 11);
}

// -I, -l and -Xcc accumulate in command-line order.
fn the_repeatable_options_keep_their_order() void {
    string[10] mut argv = {"fort", "-I", "first", "-I", "second", "-lm", "-lc", "-Xcc", "-g",
                           "entry.ft"};
    driver.options mut opts = driver.options_create();
    defer driver.options_free(&opts);
    assert(driver.parse(&opts, argv[0..10]) == driver.PARSE_OK);
    assert(opts.includes.len == 2);
    assert(containers.str_at(&opts.includes, 0) == "first");
    assert(containers.str_at(&opts.includes, 1) == "second");
    // A `-l<lib>` is one argument: the library is part of the option.
    assert(opts.libs.len == 2);
    assert(containers.str_at(&opts.libs, 0) == "-lm");
    assert(containers.str_at(&opts.libs, 1) == "-lc");
    assert(opts.cc_args.len == 1);
    assert(containers.str_at(&opts.cc_args, 0) == "-g");
}

// The triple the module header of a target carries: the LLVM spelling of the
// Linux target, and the Mac target as it is (D19.1).
fn module_triple(string target) string {
    if (target == "x86_64-linux-gnu") {
        return "x86_64-unknown-linux-gnu";
    }
    return target;
}

// The target this compiler does not build for. A cross-target run names it.
fn other_target() string {
    if (os.TARGET == "x86_64-linux-gnu") {
        return "arm64-apple-macosx15.0.0";
    }
    return "x86_64-linux-gnu";
}

// The line a module starts with for a target.
fn header_line(strbuf.str_buf mut* b, string target) string {
    strbuf.clear(b);
    strbuf.append(b, "target triple = \"");
    strbuf.append(b, module_triple(target));
    strbuf.append(b, "\"\n");
    return strbuf.view(b);
}

// The driver defaults: clang, because nothing else reads LLVM IR, and the
// target of the standard library this compiler was built with (D14.1).
fn the_defaults_are_clang_and_the_built_target() void {
    driver.options mut opts = driver.options_create();
    defer driver.options_free(&opts);
    assert(opts.cc == "clang");
    assert(opts.target == os.TARGET);
    assert(!opts.have_entry);
    assert(!opts.have_output);
    assert(opts.output.len == 0);
    assert(!opts.have_std_dir);
    assert(opts.std_dir.len == 0);
}

// `-o ""` names an output of no characters. It is an output the command line
// gave, not an option left out. So the driver hands that name to --cc and does
// not fall back to `a.out`. bootstrap0/src/driver.c compares the option against
// NULL and answers the same way. A length test here would make the compilers
// handle one command line differently. --std-dir and the entry file already
// prevent that case.
fn an_empty_output_option_is_an_output_that_was_named() void {
    string[4] mut argv = {"fort", "-o", "", "entry.ft"};
    driver.options mut opts = driver.options_create();
    defer driver.options_free(&opts);
    assert(driver.parse(&opts, argv[0..4]) == driver.PARSE_OK);
    assert(opts.have_output);
    assert(opts.output.len == 0);
    // The whole run answers the same way. --cc is given the empty name and
    // fails, where the default would have made `a.out` and exited 0.
    write_file("named.ft", "fn main() i32 {\n    return 0;\n}\n");
    string[6] mut whole = {"fort", "--cc", "false", "-o", "", "named.ft"};
    assert(run(whole[0..6]) == EXIT_USAGE);
    assert(err_has("fort: error: cc failed with status 1\n"));
}

// An option that takes the following argument takes it whatever it looks like,
// an option spelling included.
fn a_valued_option_takes_the_next_argument_whatever_it_is() void {
    string[4] mut argv = {"fort", "-o", "--release", "entry.ft"};
    driver.options mut opts = driver.options_create();
    defer driver.options_free(&opts);
    assert(driver.parse(&opts, argv[0..4]) == driver.PARSE_OK);
    assert(opts.output == "--release");
    assert(!opts.release);
}

// ---- the usage errors ------------------------------------------

fn an_unknown_option_is_a_usage_error() void {
    string[3] mut argv = {"fort", "-Q", "entry.ft"};
    assert(run(argv[0..3]) == EXIT_USAGE);
    assert(err_has("fort: error: unknown option '-Q'"));
    assert(err_has("usage: fort [options] entry.ft"));
}

fn a_missing_option_argument_is_a_usage_error() void {
    string[3] mut argv = {"fort", "entry.ft", "-o"};
    assert(run(argv[0..3]) == EXIT_USAGE);
    assert(err_has("fort: error: missing argument for option '-o'"));
}

fn a_second_entry_file_is_a_usage_error() void {
    string[3] mut argv = {"fort", "one.ft", "two.ft"};
    assert(run(argv[0..3]) == EXIT_USAGE);
    assert(err_has("fort: error: unexpected argument 'two.ft'"));
}

fn no_entry_file_is_a_usage_error() void {
    string[2] mut argv = {"fort", "--release"};
    assert(run(argv[0..2]) == EXIT_USAGE);
    assert(err_has("fort: error: no entry file"));
}

// --tokens stops before the parser, so there is no front end for --check to
// run and no document for --json to write.
fn tokens_combines_with_neither_check_nor_json() void {
    string[4] mut argv = {"fort", "--tokens", "--check", "entry.ft"};
    assert(run(argv[0..4]) == EXIT_USAGE);
    assert(err_has("--tokens does not combine with --check, --json or --index"));
}

// --ast stops before the checker and after the lexer, so there is no front end
// for --check and no dump for --tokens to write.
fn ast_combines_with_neither_dump_nor_check() void {
    string[4] mut argv = {"fort", "--ast", "--tokens", "entry.ft"};
    assert(run(argv[0..4]) == EXIT_USAGE);
    assert(err_has("--ast does not combine with --tokens, --check, --json or --index"));
}

// A build spawns a `--cc` that inherits stdout, so only the check mode can
// promise a complete document or nothing.
fn json_without_check_is_a_usage_error() void {
    string[3] mut argv = {"fort", "--json", "entry.ft"};
    assert(run(argv[0..3]) == EXIT_USAGE);
    assert(err_has("--json requires --check"));
}

// fort with no arguments prints one usage line and exits with 2, with no
// `fort: error:` line before it.
fn no_arguments_prints_the_usage_line_alone() void {
    string[1] mut argv = {"fort"};
    assert(run(argv[0..1]) == EXIT_USAGE);
    string own err = captured_err();
    defer del(err);
    assert(err == "usage: fort [options] entry.ft\n");
}

// A usage error prints its message and then the usage line, in that order and
// nothing else.
fn a_usage_error_is_two_lines() void {
    string[2] mut argv = {"fort", "-Q"};
    assert(run(argv[0..2]) == EXIT_USAGE);
    string own err = captured_err();
    defer del(err);
    assert(err == "fort: error: unknown option '-Q'\nusage: fort [options] entry.ft\n");
}

// ---- --help and --version --------------------------------------

fn help_prints_the_usage_line_and_the_option_table() void {
    string[2] mut argv = {"fort", "--help"};
    assert(run(argv[0..2]) == EXIT_OK);
    string own out = captured_out();
    defer del(out);
    assert(str.starts_with(out, "usage: fort [options] entry.ft\noptions:\n"));
    // One line per option follows the usage line and the
    // `options:` header.
    assert(capture.line_count(out) == 21);
    assert(str.find(out, "  --cfg <list>       set key=value pairs; repeatable\n") >= 0);
    assert(str.find(out, "  --help             print this help and exit\n") >= 0);
    // --help answers whatever follows it, and nothing else runs.
    assert(captured_err_is_empty());
}

fn captured_err_is_empty() bool {
    string own err = captured_err();
    defer del(err);
    return err.len == 0;
}

fn version_prints_the_version_alone() void {
    string[2] mut argv = {"fort", "--version"};
    assert(run(argv[0..2]) == EXIT_OK);
    string own out = captured_out();
    defer del(out);
    assert(out == "fort 0.1.0\n");
}

// --help wins over the entry file and over a later usage error: the parse
// stops at it.
fn help_stops_the_parse_where_it_stands() void {
    string[3] mut argv = {"fort", "--help", "-Q"};
    assert(run(argv[0..3]) == EXIT_OK);
    assert(out_has("usage: fort [options] entry.ft"));
    assert(captured_err_is_empty());
}

// ---- the exit statuses of a run -------------------------------------------------

// An entry file that cannot be read is a usage error, reported with the
// reason the system gave.
fn an_unreadable_entry_file_is_exit_two() void {
    string[2] mut argv = {"fort", "nothere.ft"};
    assert(run(argv[0..2]) == EXIT_USAGE);
    assert(err_has("fort: error: cannot read 'nothere.ft': No such file or directory"));
}

// An entry file that opens and does not read -- a directory, whose read(2) is
// EISDIR -- is not a usage error. The loader reports it as a compile error at
// 1:1, and the run exits 1.
fn an_entry_file_that_is_a_directory_is_the_loader_s_error() void {
    assert(make_directory("adir"));
    string[2] mut argv = {"fort", "adir"};
    assert(run(argv[0..2]) == EXIT_COMPILE_ERROR);
    string own err = captured_err();
    defer del(err);
    assert(err == "adir:1:1: error: cannot read 'adir'\n");
}

// A file whose closure loaded and checked is the emitter's turn, which this
// compiler does not carry. An internal error, exit 2, and no usage line after
// it, since the command line was fine. `--check` alone stops here and is exit
// 0 instead, since a check-only run emits nothing.
fn a_clean_program_is_emitted_and_handed_to_the_cc() void {
    write_file("clean.ft", "fn main() i32 {\n    return 0;\n}\n");
    // -S stops at the module and needs no temporary or --cc command.
    string[5] mut emit = {"fort", "-S", "clean.ft", "-o", "clean.ll"};
    assert(run(emit[0..5]) == EXIT_OK);
    assert(captured_err_is_empty());
    strbuf.str_buf mut module = strbuf.create();
    defer strbuf.free(&module);
    assert(io.read_file("clean.ll", &module));
    string text = strbuf.view(&module);
    strbuf.str_buf mut header = strbuf.create();
    defer strbuf.free(&header);
    assert(str.starts_with(text, header_line(&header, os.TARGET)));
    assert(str.find(text, "define dso_local i32 @\"clean.main\"() #0 {\n") >= 0);
    assert(str.find(text, "define dso_local i32 @fort_entry(ptr %args.in) #0 {\n") >= 0);
    // A --cc that cannot be run is a toolchain error naming the program and
    // the system's reason.
    string[4] mut missing = {"fort", "--cc", "./nosuchcc", "clean.ft"};
    assert(run(missing[0..4]) == EXIT_USAGE);
    assert(err_has("fort: error: cannot run './nosuchcc': No such file or directory\n"));
    // A --cc that runs and fails is reported by its status.
    string[4] mut failing = {"fort", "--cc", "false", "clean.ft"};
    assert(run(failing[0..4]) == EXIT_USAGE);
    assert(err_has("fort: error: cc failed with status 1\n"));
    string[3] mut checked = {"fort", "--check", "clean.ft"};
    assert(run(checked[0..3]) == EXIT_OK);
    string own quiet = captured_err();
    defer del(quiet);
    assert(quiet == "");
}

fn target_error_is(string message) bool {
    strbuf.str_buf mut want = strbuf.create();
    defer strbuf.free(&want);
    strbuf.append(&want, "fort: error: ");
    strbuf.append(&want, message);
    strbuf.append(&want, "\nusage: fort [options] entry.ft\n");
    string own got = captured_err();
    defer del(got);
    return got == strbuf.view(&want);
}

// The four target errors stop before the front end opens
// the entry. Each error uses the exact line and status the contract gives.
fn target_errors_stop_before_output() void {
    string foreign = other_target();
    strbuf.str_buf mut message = strbuf.create();
    defer strbuf.free(&message);
    string[7] mut unsupported = {"fort", "-S", "--target", "x86_64-linux-musl",
                                 "-o", "unsupported.ll", "missing.ft"};
    assert(run(unsupported[0..7]) == EXIT_USAGE);
    assert(target_error_is("unsupported target 'x86_64-linux-musl'"));
    string[7] mut no_root = {"fort", "-S", "--target", foreign, "-o", "no-root.ll",
                             "missing.ft"};
    assert(run(no_root[0..7]) == EXIT_USAGE);
    assert(target_error_is("--std-dir is required for cross-target -S"));
    string[7] mut object = {"fort", "-c", "--target", foreign, "-o", "foreign.o",
                            "missing.ft"};
    assert(run(object[0..7]) == EXIT_USAGE);
    strbuf.append(&message, "cannot compile object for target '");
    strbuf.append(&message, foreign);
    strbuf.append(&message, "' with a '");
    strbuf.append(&message, os.TARGET);
    strbuf.append(&message, "' compiler");
    assert(target_error_is(strbuf.view(&message)));
    string[6] mut link = {"fort", "--target", foreign, "-o", "foreign-bin", "missing.ft"};
    assert(run(link[0..6]) == EXIT_USAGE);
    strbuf.clear(&message);
    strbuf.append(&message, "cannot link target '");
    strbuf.append(&message, foreign);
    strbuf.append(&message, "' with a '");
    strbuf.append(&message, os.TARGET);
    strbuf.append(&message, "' compiler");
    assert(target_error_is(strbuf.view(&message)));
    strbuf.str_buf mut file = strbuf.create();
    defer strbuf.free(&file);
    assert(!io.read_file("unsupported.ll", &file));
    assert(!io.read_file("no-root.ll", &file));
    assert(!io.read_file("foreign.o", &file));
    assert(!io.read_file("foreign-bin", &file));
}

// The Mac form needs three numeric parts. The check mode validates its target
// because that target supplies the compiler configuration keys.
fn target_forms_and_front_end_modes() void {
    assert(driver.target_form("x86_64-linux-gnu"));
    assert(driver.target_form("arm64-apple-macosx15.0.0"));
    assert(driver.target_form("arm64-apple-macosx26.6.2"));
    assert(!driver.target_form("x86_64-linux-musl"));
    assert(!driver.target_form("arm64-apple-macosx15.0"));
    assert(!driver.target_form("arm64-apple-macosx15.a.0"));
    assert(!driver.target_form("arm64-apple-macosx15.0.0.1"));
    string[5] mut checked = {"fort", "--check", "--target", "t", "clean.ft"};
    assert(run(checked[0..5]) == EXIT_USAGE);
    assert(err_has("unsupported target 't'"));
}

// A caller root permits the IR of the other target from this compiler. This
// test checks IR form only. It does not check the C ABI of that target.
fn cross_ir_uses_the_selected_triple() void {
    write_file("cross-form.ft", "fn main() i32 {\n    return 0;\n}\n");
    string[10] mut full = {"fort", "-S", "-c", "--target", other_target(),
                          "--std-dir", "std", "-o", "cross-form.ll", "cross-form.ft"};
    assert(run(full[0..10]) == EXIT_OK);
    strbuf.str_buf mut module = strbuf.create();
    defer strbuf.free(&module);
    assert(io.read_file("cross-form.ll", &module));
    string text = strbuf.view(&module);
    strbuf.str_buf mut header = strbuf.create();
    defer strbuf.free(&header);
    assert(str.starts_with(text, header_line(&header, other_target())));
    assert(str.find(text, "target datalayout") < 0);
}

// The default output names are `<entry>.ll`, `<entry>.o`, and `a.out`. Each
// file uses the working directory or the entry file's directory.
fn the_default_output_follows_the_mode() void {
    write_file("named.ft", "fn main() i32 {\n    return 0;\n}\n");
    string[3] mut emit = {"fort", "-S", "named.ft"};
    assert(run(emit[0..3]) == EXIT_OK);
    strbuf.str_buf mut module = strbuf.create();
    defer strbuf.free(&module);
    assert(io.read_file("named.ll", &module));
    assert(driver.entry_base("dir/sub/prog.ft") == "prog");
    assert(driver.entry_base("prog.ft") == "prog");
    // A name that is not a `.ft` keeps every byte, and a bare `.ft` is a name
    // of three characters and not an empty one.
    assert(driver.entry_base("prog") == "prog");
    assert(driver.entry_base(".ft") == ".ft");
}

// A file with a syntax error is exit 1, with the diagnostic on stderr and
// nothing on stdout.
fn a_syntax_error_is_exit_one() void {
    write_file("broken.ft", "fn main() i32 {\n    return 0\n}\n");
    string[2] mut argv = {"fort", "broken.ft"};
    assert(run(argv[0..2]) == EXIT_COMPILE_ERROR);
    // The missing `;` is reported where the parser found the token that
    // cannot follow the expression, which is the `}` of the next line.
    assert(err_has("broken.ft:3:1: error: expected ';', found '}'"));
    string own out = captured_out();
    defer del(out);
    assert(out.len == 0);
}

// A lexical error is the same, and the file is reported once. The lexer
// resynchronises at the next line and the parser runs on what it left.
fn a_lexical_error_is_exit_one() void {
    write_file("lexical.ft", "fn main() i32 {\n    i32 x = 08;\n    return x;\n}\n");
    string[2] mut argv = {"fort", "lexical.ft"};
    assert(run(argv[0..2]) == EXIT_COMPILE_ERROR);
    assert(err_has("lexical.ft:2:"));
}

// An import the closure cannot resolve is exit 1, reported at the `import`
// with its related notes.
fn a_missing_import_is_exit_one() void {
    write_file("importer.ft", "import nothere;\nfn main() i32 {\n    return 0;\n}\n");
    string[2] mut argv = {"fort", "importer.ft"};
    assert(run(argv[0..2]) == EXIT_COMPILE_ERROR);
    assert(err_has("importer.ft:1:1: error: module 'nothere' not found"));
    assert(err_has("note: looked for"));
}

// ---- the two dumps --------------------------------------------------------------

// --tokens lexes the entry file alone and writes one line per token. A clean
// file is exit 0.
fn tokens_writes_the_dump_and_exits_zero() void {
    write_file("tokens.ft", "fn main() i32 {\n    return 0;\n}\n");
    string[3] mut argv = {"fort", "--tokens", "tokens.ft"};
    assert(run(argv[0..3]) == EXIT_OK);
    string own out = captured_out();
    defer del(out);
    // Each line has the range, nesting depth, text, and
    // the kind, one token per line.
    assert(str.starts_with(out, "1:1-1:3 0 \"fn\" fn\n"));
    assert(str.ends_with(out, "end of file\n"));
}

// A lexical error is reported and lexing goes on, so the dump covers the whole
// file and the status is the compile error.
fn tokens_of_a_file_with_a_lexical_error_is_exit_one() void {
    write_file("tokens_bad.ft", "fn main() i32 {\n    i32 x = 08;\n    return x;\n}\n");
    string[3] mut argv = {"fort", "--tokens", "tokens_bad.ft"};
    assert(run(argv[0..3]) == EXIT_COMPILE_ERROR);
    assert(err_has("tokens_bad.ft:2:"));
    // The dump is written either way, and it reaches the end of the file.
    assert(out_has("end of file"));
}

// --ast parses the entry file alone and writes its syntax tree as one
// S-expression followed by one newline.
fn ast_writes_the_tree_and_exits_zero() void {
    write_file("tree.ft", "fn main() i32 {\n    return 0;\n}\n");
    string[3] mut argv = {"fort", "--ast", "tree.ft"};
    assert(run(argv[0..3]) == EXIT_OK);
    string own out = captured_out();
    defer del(out);
    assert(str.starts_with(out, "(module"));
    assert(str.ends_with(out, ")\n"));
    assert(capture.line_count(out) == 1);
}

// The parser recovers and hands back the tree of what parsed, so a tree is
// written and the status is the compile error.
fn ast_of_a_file_with_a_syntax_error_is_exit_one() void {
    write_file("tree_bad.ft", "fn main() i32 {\n    return 0\n}\n");
    string[3] mut argv = {"fort", "--ast", "tree_bad.ft"};
    assert(run(argv[0..3]) == EXIT_COMPILE_ERROR);
    assert(out_has("(module"));
    assert(err_has("tree_bad.ft:3:"));
}

// Neither dump opens an import. It lexes or parses the
// file alone, so a missing imported module changes no result.
fn neither_dump_opens_an_import() void {
    write_file("lonely.ft", "import nothere;\nfn main() i32 {\n    return 0;\n}\n");
    string[3] mut tokens = {"fort", "--tokens", "lonely.ft"};
    assert(run(tokens[0..3]) == EXIT_OK);
    assert(captured_err_is_empty());
    string[3] mut ast = {"fort", "--ast", "lonely.ft"};
    assert(run(ast[0..3]) == EXIT_OK);
    assert(captured_err_is_empty());
}

// A dump of a file that cannot be read is a usage error, like a build error.
fn a_dump_of_an_unreadable_file_is_exit_two() void {
    string[3] mut argv = {"fort", "--tokens", "gone.ft"};
    assert(run(argv[0..3]) == EXIT_USAGE);
    assert(err_has("fort: error: cannot read 'gone.ft'"));
}

// ---- the front end ---------------------------------------------

// The search roots in order: the entry file's directory first, then the `-I`
// roots. The imported module is read through the front end, so an error inside
// it is reported with its own file name.
fn the_front_end_walks_the_closure() void {
    write_file("app.ft", "import helper;\nfn main() i32 {\n    return helper.one();\n}\n");
    write_file("helper.ft", "fn one() i32 {\n    return 1\n}\n");
    string[2] mut argv = {"fort", "app.ft"};
    assert(run(argv[0..2]) == EXIT_COMPILE_ERROR);
    assert(err_has("helper.ft:3:"));
}

// An `-I` root is searched after the entry file's directory. The module is
// found under it and its own syntax error is what the run reports.
fn an_include_root_is_searched() void {
    assert(make_directory("root"));
    write_file("root/lib.ft", "fn two() i32 {\n    return 2\n}\n");
    write_file("uses_lib.ft", "import lib;\nfn main() i32 {\n    return lib.two();\n}\n");
    string[4] mut argv = {"fort", "-I", "root", "uses_lib.ft"};
    assert(run(argv[0..4]) == EXIT_COMPILE_ERROR);
    assert(err_has("root/lib.ft:3:"));
}

// Without that root the same file does not resolve, which is what says the
// root and not the current directory was what found it.
fn the_current_directory_is_not_a_search_root() void {
    assert(make_directory("root2"));
    write_file("root2/lib2.ft", "fn two() i32 {\n    return 2;\n}\n");
    write_file("uses_lib2.ft", "import lib2;\nfn main() i32 {\n    return lib2.two();\n}\n");
    string[2] mut argv = {"fort", "uses_lib2.ft"};
    assert(run(argv[0..2]) == EXIT_COMPILE_ERROR);
    assert(err_has("module 'lib2' not found"));
}

extern fn mkdir(char* path, u32 mode) i32;

fn make_directory(string path) bool {
    char mut@ own c_path = str.to_cstr(path);
    defer del(c_path);
    return mkdir(c_path.ptr, 0o700) == 0;
}

// ---- the standard library directory ---------------------------------------------

// `std` in the directory containing the binary, or `std` alone when the
// program name has no directory part.
fn std_beside_the_binary_is_the_last_resort() void {
    containers.pool mut p = containers.pool_create();
    defer containers.pool_free(&p);
    assert(driver.std_dir_beside(&p, "/usr/local/bin/fort") == "/usr/local/bin/std");
    assert(driver.std_dir_beside(&p, "fort") == "std");
    assert(driver.std_dir_beside(&p, "./fort") == "./std");
    assert(driver.std_dir_beside(&p, "/fort") == "/std");
}

// --std-dir wins over the environment, which wins over the binary's own
// directory.
fn the_std_dir_option_wins_over_the_environment() void {
    containers.pool mut p = containers.pool_create();
    defer containers.pool_free(&p);
    string[4] mut argv = {"fort", "--std-dir", "chosen", "entry.ft"};
    driver.options mut opts = driver.options_create();
    defer driver.options_free(&opts);
    assert(driver.parse(&opts, argv[0..4]) == driver.PARSE_OK);
    assert(driver.std_dir(&p, &opts, "/usr/bin/fort") == "chosen");
}

// Without --std-dir the directory is $FORT_STD_DIR when it names one, and
// `std` beside the binary otherwise. Both arms are forced
// here rather than read off the environment the run happens to have. A test
// that branches on the ambient variable asserts whichever half the
// environment presents and covers neither on any one run.
fn the_environment_is_read_when_the_option_is_absent() void {
    containers.pool mut p = containers.pool_create();
    defer containers.pool_free(&p);
    driver.options mut opts = driver.options_create();
    defer driver.options_free(&opts);
    set_env("FORT_STD_DIR", "/from/the/environment");
    assert(driver.std_dir(&p, &opts, "/usr/bin/fort") == "/from/the/environment");
}

// An empty value names no directory, so it counts as unset. The search then
// uses `std` beside the binary that std.os.exe_path names.
fn an_empty_std_dir_variable_counts_as_unset() void {
    containers.pool mut p = containers.pool_create();
    defer containers.pool_free(&p);
    driver.options mut opts = driver.options_create();
    defer driver.options_free(&opts);
    set_env("FORT_STD_DIR", "");
    assert(str.ends_with(driver.std_dir(&p, &opts, "/usr/bin/fort"), "/std"));
    // An absent variable gives the same result.
    unset_env("FORT_STD_DIR");
    assert(str.ends_with(driver.std_dir(&p, &opts, "/usr/bin/fort"), "/std"));
}

// An empty --std-dir is a directory that was named, not an option left out.
// bootstrap0/src/driver.c compares the option against NULL, so `--std-dir ""`
// is the empty root and nothing below it is consulted. Reading its length
// instead made stage2 fall back to the environment and resolve, under that
// command line, imports bootstrap-0 refuses.
fn an_empty_std_dir_option_counts_as_named() void {
    containers.pool mut p = containers.pool_create();
    defer containers.pool_free(&p);
    set_env("FORT_STD_DIR", "/from/the/environment");
    string[4] mut argv = {"fort", "--std-dir", "", "entry.ft"};
    driver.options mut opts = driver.options_create();
    defer driver.options_free(&opts);
    assert(driver.parse(&opts, argv[0..4]) == driver.PARSE_OK);
    assert(opts.have_std_dir);
    assert(opts.std_dir.len == 0);
    assert(driver.std_dir(&p, &opts, "/usr/bin/fort").len == 0);
    unset_env("FORT_STD_DIR");
}

// The same at the level a user sees: with the environment naming a directory
// that holds the module, `--std-dir ""` still refuses the import. This is because the
// empty root is the one root a `std` path is looked up in.
fn an_empty_std_dir_option_resolves_no_std_import() void {
    assert(make_directory("stdlib"));
    write_file("stdlib/thing.ft", "fn one() i32 {\n    return 1;\n}\n");
    // Every closure holds `std.rt`, which the loader reads from
    // `<std-dir>/rt.ft`, so the directory the environment names holds one too.
    write_file("stdlib/rt.ft", "// The empty runtime of a driver test.\n");
    write_file("uses_std.ft", "import std.thing;\nfn main() i32 { return thing.one(); }\n");
    set_env("FORT_STD_DIR", "stdlib");
    // With the environment alone the import resolves and the program is
    // emitted, which -S stops at: exit 0 and no diagnostic.
    string[3] mut plain = {"fort", "-S", "uses_std.ft"};
    assert(run(plain[0..3]) == EXIT_OK);
    assert(captured_err_is_empty());
    // With an empty --std-dir it does not resolve at all.
    string[4] mut empty = {"fort", "--std-dir", "", "uses_std.ft"};
    assert(run(empty[0..4]) == EXIT_COMPILE_ERROR);
    assert(err_has("module 'std.thing' not found"));
    unset_env("FORT_STD_DIR");
}

// The environment of this process, which the two tests above set and clear so
// that each arm of the search is forced rather than observed. Neither has a
// std binding and this is their one caller.
extern fn setenv(char* name, char* value, i32 overwrite) i32;
extern fn unsetenv(char* name) i32;

fn set_env(string name, string value) void {
    char mut@ own c_name = str.to_cstr(name);
    defer del(c_name);
    char mut@ own c_value = str.to_cstr(value);
    defer del(c_value);
    assert(setenv(c_name.ptr, c_value.ptr, 1) == 0);
}

fn unset_env(string name) void {
    char mut@ own c_name = str.to_cstr(name);
    defer del(c_name);
    assert(unsetenv(c_name.ptr) == 0);
}

// ---- re-entrancy ----------------------------------------------------------------

// Two runs in one process are independent: the second answers for its own
// command line, whatever the first reported. This is because every allocation and
// every counter belongs to the session the run created.
fn two_runs_in_one_process_share_nothing() void {
    write_file("first.ft", "fn main() i32 {\n    return 0\n}\n");
    write_file("second.ft", "fn main() i32 {\n    return 0;\n}\n");
    string[3] mut bad = {"fort", "--ast", "first.ft"};
    string[3] mut good = {"fort", "--ast", "second.ft"};
    assert(run(bad[0..3]) == EXIT_COMPILE_ERROR);
    // The diagnostics of the first run are not the second's: it reports
    // nothing and exits 0.
    assert(run(good[0..3]) == EXIT_OK);
    assert(captured_err_is_empty());
    // The third run of the broken file reports again instead of
    // answering from a counter the second left behind.
    assert(run(bad[0..3]) == EXIT_COMPILE_ERROR);
    assert(err_has("first.ft:3:"));
}

// A hundred runs of one file neither grow nor change. The status of the
// hundredth is the status of the first, which is what a language server
// re-analysing a document depends on.
u64 RERUNS = 100;

fn a_hundred_runs_answer_alike() void {
    write_file("again.ft", "import nothere;\nfn main() i32 {\n    return 0;\n}\n");
    string[2] mut argv = {"fort", "again.ft"};
    u64 mut i = 0;
    while (i < RERUNS) {
        assert(run(argv[0..2]) == EXIT_COMPILE_ERROR);
        i += 1;
    }
    string own err = captured_err();
    defer del(err);
    // The last run reports one error and one note. A one-segment path uses
    // only the entry file's directory as a root. The result must not
    // accumulate output from 100 runs.
    assert(capture.line_count(err) == 2);
}

fn main() i32 {
    write_runtime();
    every_flag_sets_its_own_option();
    index_implies_check_and_json();
    the_two_dumps_imply_nothing();
    println("flags ok");
    the_last_value_of_a_single_option_wins();
    the_repeatable_options_keep_their_order();
    the_defaults_are_clang_and_the_built_target();
    a_valued_option_takes_the_next_argument_whatever_it_is();
    an_empty_output_option_is_an_output_that_was_named();
    println("valued ok");
    an_unknown_option_is_a_usage_error();
    a_missing_option_argument_is_a_usage_error();
    a_second_entry_file_is_a_usage_error();
    no_entry_file_is_a_usage_error();
    tokens_combines_with_neither_check_nor_json();
    ast_combines_with_neither_dump_nor_check();
    json_without_check_is_a_usage_error();
    no_arguments_prints_the_usage_line_alone();
    a_usage_error_is_two_lines();
    println("usage ok");
    help_prints_the_usage_line_and_the_option_table();
    version_prints_the_version_alone();
    help_stops_the_parse_where_it_stands();
    println("help ok");
    an_unreadable_entry_file_is_exit_two();
    an_entry_file_that_is_a_directory_is_the_loader_s_error();
    a_clean_program_is_emitted_and_handed_to_the_cc();
    target_errors_stop_before_output();
    target_forms_and_front_end_modes();
    cross_ir_uses_the_selected_triple();
    the_default_output_follows_the_mode();
    a_syntax_error_is_exit_one();
    a_lexical_error_is_exit_one();
    a_missing_import_is_exit_one();
    println("statuses ok");
    tokens_writes_the_dump_and_exits_zero();
    tokens_of_a_file_with_a_lexical_error_is_exit_one();
    ast_writes_the_tree_and_exits_zero();
    ast_of_a_file_with_a_syntax_error_is_exit_one();
    neither_dump_opens_an_import();
    a_dump_of_an_unreadable_file_is_exit_two();
    println("dumps ok");
    the_front_end_walks_the_closure();
    an_include_root_is_searched();
    the_current_directory_is_not_a_search_root();
    println("front end ok");
    std_beside_the_binary_is_the_last_resort();
    the_std_dir_option_wins_over_the_environment();
    the_environment_is_read_when_the_option_is_absent();
    an_empty_std_dir_variable_counts_as_unset();
    an_empty_std_dir_option_counts_as_named();
    an_empty_std_dir_option_resolves_no_std_import();
    println("std dir ok");
    two_runs_in_one_process_share_nothing();
    a_hundred_runs_answer_alike();
    println("reentrancy ok");
    println("ok");
    return 0;
}
