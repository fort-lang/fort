//! run
//! flags: -I ../../src/fort -I support -I ../../src
//! abort
//! stderr: panic: json.write_init: no buffer
//! stdout:
//| a writer over a buffer ok
/// A writer needs a buffer to write into. None is a violated precondition and
/// panics, where src/bootstrap/json.c ends the process.
import lsp.json;
import std.strbuf;

fn main() i32 {
    strbuf.str_buf mut out = strbuf.create();
    defer strbuf.free(&out);
    json.writer mut w = json.writer{};
    json.write_init(&w, &out);
    json.write_null(&w);
    assert(strbuf.view(&out) == "null");
    println("a writer over a buffer ok");
    json.write_init(&w, null);
    println(strbuf.view(&out));
    return 0;
}
