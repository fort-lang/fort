//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: run_env.parse_made: a function breaks a premise rule: use parse_breaks_made
//! stderr: fir.verify: V16 a return with a live scratch temporary: main.leaks bb0 statement 1
//! stdout:
//| ready
/// run_env.parse_made stops the test for a text with a function that breaks a premise rule of the
/// verifier.
import fort.fir;
import premise_env;
import run_env;

// A panic ends the program, so the case stands in a file of its own.
fn main() i32 {
    run_env.env mut* own e = run_env.make();
    defer run_env.drop_made(move(e));
    run_env.check(e, premise_env.PRELUDE[..]);
    println("ready");
    fir.module mut* own m = run_env.parse_made(e, premise_env.MIXED[..]);
    defer fir.module_drop_made(move(m));
    return 0;
}
