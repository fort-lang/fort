//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: ownership_source_exit: invalid first pass order
//! stdout:
//| false
/// The first pass runs once for each body, after prepare and before solve. A context that
/// prepare never bound breaks that order, so the call panics before it reads any statement.
import ownership_source_exit;

fn main() i32 {
    ownership_source_exit.context mut c = ownership_source_exit.context{};
    println(c.initialized);
    ownership_source_exit.first(&c);
    return 0;
}
