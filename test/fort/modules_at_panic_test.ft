//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: modules.at: index out of range
//! stdout:
//| main
//| 1
import modules;
import modules_env;

// at answers for every module of the dependency order and panics past the
// last one, rather than reading a slot of the vector no load filled (D13.3).
fn i32 main() {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft", modules_env.src_main());
    assert(modules_env.load(&e, "main.ft"));
    println(modules.at(&e.set, 0)->path);
    println(modules.count(&e.set));
    println(modules.at(&e.set, 1)->path);
    return 0;
}
