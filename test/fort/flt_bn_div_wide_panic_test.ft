//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: flt.bn_div: the quotient does not fit 64 bits
//! stdout:
//| 18446744073709551615
/// Each caller of bn_div scales its operands so that the quotient fits 64 bits. 2^64 / 1
/// breaks that precondition, so the call panics.
import flt;

fn main() i32 {
    flt.bignum mut num = flt.bignum{};
    flt.bignum mut den = flt.bignum{};
    flt.bn_set_u64(&num, 18446744073709551615);
    flt.bn_set_u64(&den, 1);
    bool mut sticky = false;
    println(flt.bn_div(&num, &den, &sticky));
    flt.bn_set_u128(&num, 1, 0);
    flt.bn_div(&num, &den, &sticky);
    return 0;
}
