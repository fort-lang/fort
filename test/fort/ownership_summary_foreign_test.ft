//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| direct requirements ok
//| exported requirements ok
//| kept requirements ok
//| fort callers ok
//| mixed requirements ok
/// Tests the summary of a foreign-called body (D17.13, D17.18). Foreign code can call the body
/// with any argument, so no fort caller binds a requirement on a caller source. The summary
/// records the first lost requirement as incomplete proof at its operation. A requirement that
/// names no caller source, and the empty-output requirement of a result, stay.
import ownership_api;
import ownership_call_bodies;
import ownership_summary_model;

// Line n of each text is line n of the sandbox entry module. Each read through a parameter
// needs the caller source live with an extent that covers the read.
string[4] READS = {
    "fn first(i32* p) i32 { return *p; }",
    "fn both(i32* p, i32* q) i32 {",
    "    i32 a = *p;",
    "    return a + *q; }",
};

// `top` passes its parameter to `first`, so it exports the requirement of `first` on `p`.
// `local` reads its own storage, and `pure` reads no storage.
string[4] WRAPPED = {
    "fn first(i32* p) i32 { return *p; }",
    "fn top(i32* p) i32 { return first(p); }",
    "fn local() i32 { i32 x = 1; i32* p = &x; return *p; }",
    "fn pure(i32 a) i32 { return a + 1; }",
};

// The result of `fac` holds a fresh owner, so the caller must give empty output storage.
string[2] RESULT = {
    "struct ob { u8 mut@ own b; u64 n; }",
    "fn fac() ob { return ob{new(u8, 1), 1}; }",
};

// `load` reads a reference from caller storage and then reads through it. `fresh_after_read`
// reads a caller source and returns a fresh owner, so it has both kinds of requirement.
string[4] MIXED = {
    "struct ob { u8 mut@ own b; u64 n; }",
    "fn load(i32** pp) i32 { i32* q = *pp; return *q; }",
    "fn fresh_after_read(u8* p) ob { u8 c = *p; return ob{new(u8, 1), cast(c, u64)}; }",
    "fn plain(u8* p) u8 { return *p; }",
};

fn line_of(ownership_summary_model.summary* s) u32 { return s->proof.terminal.source.line; }

fn col_of(ownership_summary_model.summary* s) u32 { return s->proof.terminal.source.col; }

// A lost requirement publishes incomplete proof with reason missing_path. The summary keeps no
// requirement and no case, so a caller can apply none of it.
fn lost(ownership_summary_model.summary* s) void {
    assert(s->proof.kind == ownership_api.proof_kind.incomplete);
    assert(s->proof.terminal.reason == ownership_api.incomplete_reason.missing_path);
    assert(s->residual_effects && s->requirements.len == 0 && s->cases.len == 0);
}

fn kinds(ownership_summary_model.summary* s, ownership_summary_model.requirement_kind kind)
    u64 {
    u64 mut found = 0;
    u64 mut i = 0;
    while (i < s->requirements.len) {
        if (s->requirements[i].kind == kind) { found += 1; }
        i += 1;
    }
    return found;
}

// The requirement guard: a direct read of a caller source loses its requirement, and the first
// lost read names the proof. The same body that no foreign code calls keeps each requirement.
fn direct() void {
    string[2] names = {"first", "both"};
    ownership_call_bodies.bodies mut ordinary = ownership_call_bodies.bodies{};
    ownership_call_bodies.open(&ordinary, READS[..], names[..]);
    defer ownership_call_bodies.close(&ordinary);
    ownership_call_bodies.infer_all(&ordinary);
    ownership_summary_model.summary* kept = ownership_call_bodies.summary(&ordinary, 0);
    assert(ownership_api.successful(kept->proof) && !kept->residual_effects);
    assert(kept->requirements.len > 0 &&
        kinds(kept, ownership_summary_model.requirement_kind.extent) > 0);
    ownership_summary_model.summary* kept_both = ownership_call_bodies.summary(&ordinary, 1);
    assert(ownership_api.successful(kept_both->proof));
    assert(kinds(kept_both, ownership_summary_model.requirement_kind.extent) >= 2);

    ownership_call_bodies.bodies mut foreign = ownership_call_bodies.bodies{};
    ownership_call_bodies.open(&foreign, READS[..], names[..]);
    defer ownership_call_bodies.close(&foreign);
    foreign.inputs[0].foreign_called = true;
    foreign.inputs[1].foreign_called = true;
    ownership_call_bodies.infer_all(&foreign);
    // `*p` starts at column 31 of line 1. The first read of `both` is `*p` at column 13 of
    // line 3, so the later read of `*q` on line 4 names no proof.
    ownership_summary_model.summary* one = ownership_call_bodies.summary(&foreign, 0);
    lost(one);
    assert(line_of(one) == 1 && col_of(one) == 31);
    ownership_summary_model.summary* two = ownership_call_bodies.summary(&foreign, 1);
    lost(two);
    assert(line_of(two) == 3 && col_of(two) == 13);
    println("direct requirements ok");
}

// The export guard: a foreign-called wrapper loses the requirement that it exports from its
// callee. An ordinary wrapper exports it, and its callee summary stays the same in both runs.
fn exported() void {
    string[4] names = {"first", "top", "local", "pure"};
    ownership_call_bodies.bodies mut ordinary = ownership_call_bodies.bodies{};
    ownership_call_bodies.open(&ordinary, WRAPPED[..], names[..]);
    defer ownership_call_bodies.close(&ordinary);
    ownership_call_bodies.infer_all(&ordinary);
    ownership_summary_model.summary* wrapper = ownership_call_bodies.summary(&ordinary, 1);
    assert(ownership_api.successful(wrapper->proof) && wrapper->requirements.len > 0);
    u64 exported_rows = wrapper->requirements.len;

    ownership_call_bodies.bodies mut foreign = ownership_call_bodies.bodies{};
    ownership_call_bodies.open(&foreign, WRAPPED[..], names[..]);
    defer ownership_call_bodies.close(&foreign);
    ownership_call_bodies.infer(&foreign, 0);
    foreign.inputs[1].foreign_called = true;
    ownership_call_bodies.infer(&foreign, 1);
    ownership_summary_model.summary* callee = ownership_call_bodies.summary(&foreign, 0);
    assert(ownership_api.successful(callee->proof));
    assert(callee->requirements.len ==
        ownership_call_bodies.summary(&ordinary, 0)->requirements.len);
    ownership_summary_model.summary* lost_wrapper = ownership_call_bodies.summary(&foreign, 1);
    lost(lost_wrapper);
    // The export happens at the call `first(p)`, columns 29 to 36 of line 2.
    assert(line_of(lost_wrapper) == 2);
    assert(col_of(lost_wrapper) >= 29 && col_of(lost_wrapper) <= 36);
    assert(exported_rows == callee->requirements.len);
    println("exported requirements ok");
}

// A foreign-called body keeps each summary that needs no caller source: a read of its own
// storage, a body that reads no storage, and the empty output of a fresh result (D17.13).
fn kept() void {
    string[4] names = {"first", "top", "local", "pure"};
    ownership_call_bodies.bodies mut b = ownership_call_bodies.bodies{};
    ownership_call_bodies.open(&b, WRAPPED[..], names[..]);
    defer ownership_call_bodies.close(&b);
    b.inputs[2].foreign_called = true;
    b.inputs[3].foreign_called = true;
    ownership_call_bodies.infer_all(&b);
    ownership_summary_model.summary* own_storage = ownership_call_bodies.summary(&b, 2);
    assert(ownership_api.successful(own_storage->proof) && !own_storage->residual_effects);
    assert(own_storage->requirements.len == 0);
    ownership_summary_model.summary* no_storage = ownership_call_bodies.summary(&b, 3);
    assert(ownership_api.successful(no_storage->proof) && !no_storage->residual_effects);
    assert(no_storage->requirements.len == 0);

    string[1] made = {"fac"};
    ownership_call_bodies.bodies mut r = ownership_call_bodies.bodies{};
    ownership_call_bodies.open(&r, RESULT[..], made[..]);
    defer ownership_call_bodies.close(&r);
    r.inputs[0].foreign_called = true;
    ownership_call_bodies.infer_all(&r);
    ownership_summary_model.summary* fresh = ownership_call_bodies.summary(&r, 0);
    assert(ownership_api.successful(fresh->proof) && !fresh->residual_effects);
    assert(fresh->requirements.len == 1);
    assert(kinds(fresh, ownership_summary_model.requirement_kind.empty_output) == 1);
    println("kept requirements ok");
}

// A fort caller of a foreign-called body applies an incomplete summary, so its own summary is
// incomplete proof too. The caller of the ordinary twin proves.
fn fort_callers() void {
    string[2] names = {"first", "top"};
    ownership_call_bodies.bodies mut b = ownership_call_bodies.bodies{};
    ownership_call_bodies.open(&b, WRAPPED[..], names[..]);
    defer ownership_call_bodies.close(&b);
    b.inputs[0].foreign_called = true;
    ownership_call_bodies.infer_all(&b);
    lost(ownership_call_bodies.summary(&b, 0));
    ownership_summary_model.summary* caller = ownership_call_bodies.summary(&b, 1);
    assert(!ownership_api.successful(caller->proof));
    assert(caller->proof.kind == ownership_api.proof_kind.incomplete);
    println("fort callers ok");
}

// A loaded reference and a fresh result do not change the rule. The first lost caller-source
// requirement names the proof, and the empty-output requirement does not keep the summary.
fn mixed() void {
    string[3] names = {"load", "fresh_after_read", "plain"};
    ownership_call_bodies.bodies mut ordinary = ownership_call_bodies.bodies{};
    ownership_call_bodies.open(&ordinary, MIXED[..], names[..]);
    defer ownership_call_bodies.close(&ordinary);
    ownership_call_bodies.infer_all(&ordinary);
    ownership_summary_model.summary* loaded = ownership_call_bodies.summary(&ordinary, 0);
    assert(ownership_api.successful(loaded->proof) && loaded->requirements.len > 0);
    ownership_summary_model.summary* both = ownership_call_bodies.summary(&ordinary, 1);
    assert(ownership_api.successful(both->proof));
    assert(kinds(both, ownership_summary_model.requirement_kind.empty_output) == 1);
    assert(both->requirements.len > 1);

    ownership_call_bodies.bodies mut foreign = ownership_call_bodies.bodies{};
    ownership_call_bodies.open(&foreign, MIXED[..], names[..]);
    defer ownership_call_bodies.close(&foreign);
    foreign.inputs[0].foreign_called = true;
    foreign.inputs[1].foreign_called = true;
    ownership_call_bodies.infer_all(&foreign);
    ownership_summary_model.summary* lost_load = ownership_call_bodies.summary(&foreign, 0);
    lost(lost_load);
    assert(line_of(lost_load) == 2);
    ownership_summary_model.summary* lost_both = ownership_call_bodies.summary(&foreign, 1);
    lost(lost_both);
    assert(line_of(lost_both) == 3);
    // The flag of one body changes no other summary.
    ownership_summary_model.summary* untouched = ownership_call_bodies.summary(&foreign, 2);
    assert(ownership_api.successful(untouched->proof));
    assert(untouched->requirements.len ==
        ownership_call_bodies.summary(&ordinary, 2)->requirements.len);
    println("mixed requirements ok");
}

fn main() i32 {
    direct();
    exported();
    kept();
    fort_callers();
    mixed();
    return 0;
}
