//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: session.config_set: duplicate key
//! stdout:
//| on
//| off
/// Checks the configuration of a session. config_set adds a key once. A second value for a key
/// that the session already holds is a violated precondition and panics; it does not replace
/// the first value.
import session;

fn main() i32 {
    session.session mut s = session.create();
    defer session.free(&s);
    session.config_set(&s, "trace", "on");
    session.config_set(&s, "mode", "off");
    string mut value = "";
    assert(session.config_get(&s, "trace", &value));
    println(value);
    assert(session.config_get(&s, "mode", &value));
    println(value);
    session.config_set(&s, "trace", "off");
    return 0;
}
