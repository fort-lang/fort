    "fn sv_moved_out(i64 mut* own mut* pp) i64 {",
    "    i64 mut* own x = move(*pp); i64* y = x; *pp = move(x); i64 mut* own z = move(*pp);",
    "    del(*pp); i64 a = *y; *pp = move(z); return a; }",
    "fn tv_empty_release(i64 mut* own mut* pp) i64 {",
    "    i64 mut* own x = move(*pp); i64* y = x; *pp = move(x); i64 mut* own z = move(*pp);",
