// Bodies of the rules that the base probes do not reach. A local holds a moved caller owner, a
// release or a move goes through an emptied base, a read widens a field address, a load skips
// the private slot of the load before it, and a reference read goes through a local address.
// A release or a move after a call cannot name the load of its old owner, so it stays
// incomplete. After a check that keeps one path the move still names that load. A load after
// a release takes no entry value, because the released allocation can be the loaded one.
string[29] RULES = {
    "struct holder { i64 mut* own item; }",
    "struct pair { i32 a; i32 b; }",
    "struct view { u64@ sp; }",
    "struct sh { view* v; }",
    "fn held_read(holder mut* h) i64 {",
    "    i64 mut* own q = move(h->item); i64 x = *q; del(q); return x; }",
    "fn release_base(holder mut* own h) void { del(h); del(h->item); }",
    "fn move_base(holder mut* own h) i64 {",
    "    holder mut* own g = move(h); i64 mut* own q = move(h->item); del(q); del(g);",
    "    return 0; }",
    "fn widen(pair* p) u64 { i32* b = &p->b; u64* w = cast(b, u64*); return *w; }",
    "fn m6(sh* p) u64 { u64@ s = p->v->sp; return s[0]; }",
    "fn t1_int_typed(i32 mut* own p) u64 {",
    "    i32* s = p; i32** ps = &s; del(p); return cast(*ps, u64); }",
    "fn t6_void_copy_ok(i32 mut* own p) void {",
    "    void* s = cast(p, void*); void** ps = &s; void* q = *ps; void* r = q; del(p); }",
    "fn foo() void {}",
    "fn release_after_call(i64 mut* own mut* pp) i64 {",
    "    i64* inner = *pp; foo(); del(*pp); return *inner; }",
    "fn move_after_call(i64 mut* own mut* pp) i64 {",
    "    i64* inner = *pp; foo(); i64 mut* own q = move(*pp); del(q); return *inner; }",
    "fn move_after_check(i64 mut* own mut* pp, i64@ s) i64 {",
    "    i64 x = s[0];",
    "    i64* inner = *pp; i64 mut* own q = move(*pp); del(q); return *inner + x; }",
    "fn move_keep_valid(i64 mut* own mut* pp) i64 {",
    "    i64* inner = *pp; i64 mut* own q = move(*pp); i64 x = *inner; *pp = move(q);",
    "    return x; }",
    "fn del_then_load(i64 mut* own p, i64** q) i64 { del(p); return **q; }",
    "",
};

