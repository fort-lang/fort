//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| summary base ok
/// Holds the verdicts of the base rule of the summary solver (D17.14, D17.18; spec/fir.md 14.1).
/// Each read, store, reference load and release of caller storage reads the current flow
/// contents of each base in order. A store through another caller root ends that search, and the
/// base is then unknown. A load takes the entry value only when no call, no `del`, and no store
/// behind a dereference comes before it.
///
/// Each group is one probe of `test/ownership/probes/base_*.ft` without its `main`. A long line
/// of a probe is two lines here. Each body has one expected verdict:
/// - F: a faulty body. Neither the summary solver nor the calls_heap row proves it.
/// - K: a valid body that the summary solver proves. It still proves, so a lost proof shows.
/// - V: a valid body that the summary solver does not prove. It stays unproved and reports no
///   violation, so both a new proof and a new failure show.
/// The three bodies that release through one input and read through another keep their proof:
/// the application checks the read after the release (`ownership_calls_projected_test.ft`,
/// G07.5 and G07.6).
import ownership_gate_env;
import ownership_recursive_env;
import ownership_source_calls_env;

string[56] BASE_A = {
    "struct counter { i64 value; }",
    "struct inner { i64 v; }",
    "struct outer { inner part; }",
    "struct holder { i64 mut* own item; }",
    "fn np_released(outer mut* own p) i64 { outer* v = p; del(p); return v->part.v; }",
    "fn np_moved(outer mut* own p) i64 {",
    "    outer mut* own q = move(p);",
    "    i64 r = p->part.v;",
    "    del(q);",
    "    return r;",
    "}",
    "fn hp_released(holder mut* h) i64 { del(h->item); return *h->item; }",
    "fn hp_moved(holder mut* h) i64 {",
    "    i64 mut* own q = move(h->item);",
    "    i64 r = *h->item;",
    "    del(q);",
    "    return r;",
    "}",
    "fn loop_moved(counter mut* own p, i64 n) i64 {",
    "    counter mut* own q = move(p);",
    "    i64 mut s = 0;",
    "    i64 mut i = 0;",
    "    while (i < n) { s += p->value; i += 1; }",
    "    del(q);",
    "    return s;",
    "}",
    "fn rel_inner(i64 mut* own mut* pp) void { del(*pp); }",
    "fn callee_released(i64 mut* own mut* pp) i64 { rel_inner(pp); return **pp; }",
    "fn rel_owner(counter mut* own c) void { del(c); }",
    "fn callee_moved(counter mut* own p) i64 { counter* v = p; rel_owner(move(p));",
    "    return v->value; }",
    "fn drop_item(holder mut* h) void { del(h->item); }",
    "fn callee_field(holder mut* h) i64 { drop_item(h); return *h->item; }",
    "fn joined(i64 mut* own mut* pp, bool c) i64 {",
    "    if (c) { del(*pp); }",
    "    return **pp;",
    "}",
    "fn branch_ret(i64 mut* own mut* pp, bool c) i64 {",
    "    if (c) { return 0; }",
    "    del(*pp);",
    "    return **pp;",
    "}",
    "fn store_released(counter mut* own p) void { del(p); p->value = 1; }",
    "fn store_moved(counter mut* own p) void {",
    "    counter mut* own q = move(p);",
    "    p->value = 1;",
    "    del(q);",
    "}",
    "fn store_alias(counter mut* own p) void { counter mut* v = p; del(p); v->value = 1; }",
    "fn moved_copy(counter mut* own p) i64 {",
    "    counter mut* own q = move(p);",
    "    counter* v = p;",
    "    i64 r = v->value;",
    "    del(q);",
    "    return r;",
    "}",
};

