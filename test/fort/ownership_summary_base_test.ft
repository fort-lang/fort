    "fn m3(hold mut* h, u64 i) u64 { u64@ s = h->buf; del(move(h->buf)); return s[i]; }",
    "fn o1(hold mut* h) u64 { u64@ s = h->buf; del(move(h->buf)); return s[0]; }",
    "fn stale_store(view_store mut* own store, u64@ d) void { del(store); store->data = d; }",
    "fn stale_scalar(view_store mut* own store) void { del(store); store->local[1] = 3; }",
    "fn wr_after_free_exact(S mut* own p) void { del(p); p->a[1] = 1; }",
    "fn wr_param_field(S mut* own p) void { del(p); p->x = 1; }",
    "fn wr_local_exact() void { S mut* own p = new(S); del(p); p->a[1] = 1; }",
    "fn wr_local_field() void { S mut* own p = new(S); del(p); p->x = 1; }",
    "fn put0(views mut* p, i32* q) void { p->items[0] = q; }",
