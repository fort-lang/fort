    "fn l03_old(i32** left, i32** right, i32 mut* own owner) i32 {",
    "    i32 before = **left;",
    "    del(owner);",
    "    return before + **right;",
    "}",
    "fn branch_load_old(owner_box mut* a, owner_box* b, bool read) i32 {",
