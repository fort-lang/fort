// A store back of a held caller owner into caller storage. Flow models that owner as an empty
// slot, so a later load, move or release of the path stops the summary (D17.18). A faulty use
// of the old source after that stays unproved; a valid body without such an access proves.
// Without the load stop, the valid `sv_load_return` and `sv_load_unused` prove through the
// empty slot. A read through the loaded reference stays unproved without the stop. The next 7
// valid bodies prove on main and stay unproved here: the stop gives up their precision.
string[62] STOP = {
    "fn sv_return(i64 mut* own mut* pp) i64* {",
    "    i64 mut* own x = move(*pp); i64* y = x; *pp = move(x); return y; }",
    "fn sv_reload(i64 mut* own mut* pp) i64 {",
    "    i64 mut* own x = move(*pp); *pp = move(x); i64* w = *pp; return *w; }",
    "fn sv_load_return(i64 mut* own mut* pp) i64* {",
    "    i64 mut* own x = move(*pp); *pp = move(x); i64* w = *pp; return w; }",
    "fn sv_load_unused(i64 mut* own mut* pp) i64 {",
    "    i64 mut* own x = move(*pp); *pp = move(x); i64* w = *pp; return 0; }",
    "fn sv_moved_out_z(i64 mut* own mut* pp) i64 {",
    "    i64 mut* own x = move(*pp); *pp = move(x); i64 mut* own z = move(*pp); del(*pp);",
    "    i64 a = *z; *pp = move(z); return a; }",
    "fn sv_new_read(i64 mut* own mut* pp) i64 {",
    "    i64 mut* own x = move(*pp); *pp = move(x); del(*pp); *pp = new(i64);",
    "    i64 mut* w = *pp; *w = 4; return *w; }",
    "fn sv_read_then_release(i64 mut* own mut* pp) i64 {",
    "    i64 mut* own x = move(*pp); i64* y = x; *pp = move(x); i64 a = *y; del(*pp);",
    "    *pp = new(i64); return a; }",
    "fn sv_relay(i64 mut* own mut* pp) i64 {",
    "    i64 mut* own x = move(*pp); i64* y = x; *pp = move(x); i64 mut* own z = move(*pp);",
    "    i64 a = *y; *pp = move(z); return a + *y; }",
    "fn tv_moved_twice(i64 mut* own mut* pp) i64 {",
    "    i64 mut* own x = move(*pp); i64* y = x; *pp = move(x); i64 mut* own z = move(*pp);",
    "    *pp = move(z); i64 mut* own u = move(*pp); del(*pp); i64 a = *y; *pp = move(u);",
    "    return a; }",
    "fn sv_release_new(i64 mut* own mut* pp) i64 {",
    "    i64 mut* own x = move(*pp); *pp = move(x); del(*pp); *pp = new(i64); **pp = 3;",
