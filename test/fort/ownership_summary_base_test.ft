    "g07_1_old", "g07_3_old", "l03_old", "branch_load_old", "local_del_then_load",
};

string[5] OLD_WANT = {"V", "V", "V", "V", "V"};

// Solves one group and prints each body whose verdict differs from its expectation. Gives the
// count of those bodies.
fn check(string label, string@ text, string@ names, string@ want) u64 {
    assert(names.len == want.len);
    ownership_recursive_env.closure mut summaries = ownership_recursive_env.closure{};
    defer ownership_recursive_env.close(&summaries);
    ownership_recursive_env.open(&summaries, text, names);
    ownership_recursive_env.solve(&summaries);
    ownership_source_calls_env.closure mut calls = ownership_source_calls_env.closure{};
    defer ownership_source_calls_env.close(&calls);
    ownership_source_calls_env.run(&calls, text, names);
    u64 mut wrong = 0;
    u64 mut i = 0;
    while (i < names.len) {
        string summary = ownership_gate_env.summary_verdict(&summaries, names[i]);
        string row = ownership_source_calls_env.verdict(&calls, names[i]);
        bool mut held = summary == "unproved";
        if (want[i] == "F") { held = summary != "proved" && row != "proved"; }
        if (want[i] == "K") { held = summary == "proved"; }
        if (!held) {
            eprintln(label, " ", names[i], " expects ", want[i], ": summary ", summary,
                ", calls_heap ", row);
            wrong += 1;
        }
        i += 1;
    }
    return wrong;
}

fn main() i32 {
    u64 mut wrong = 0;
    wrong += check("base_a", BASE_A[..], BASE_A_NAMES[..], BASE_A_WANT[..]);
    wrong += check("base_b", BASE_B[..], BASE_B_NAMES[..], BASE_B_WANT[..]);
    wrong += check("base_c", BASE_C[..], BASE_C_NAMES[..], BASE_C_WANT[..]);
    wrong += check("base_d", BASE_D[..], BASE_D_NAMES[..], BASE_D_WANT[..]);
    wrong += check("base_f", BASE_F[..], BASE_F_NAMES[..], BASE_F_WANT[..]);
    wrong += check("base_accesses", BASE_ACCESSES[..], BASE_ACCESSES_NAMES[..],
        BASE_ACCESSES_WANT[..]);
    wrong += check("base_alias", BASE_ALIAS[..], BASE_ALIAS_NAMES[..], BASE_ALIAS_WANT[..]);
    wrong += check("base_output_h", BASE_OUTPUT_H[..], BASE_OUTPUT_H_NAMES[..],
        BASE_OUTPUT_H_WANT[..]);
    wrong += check("base_output_m", BASE_OUTPUT_M[..], BASE_OUTPUT_M_NAMES[..],
        BASE_OUTPUT_M_WANT[..]);
    wrong += check("base_output_n", BASE_OUTPUT_N[..], BASE_OUTPUT_N_NAMES[..],
        BASE_OUTPUT_N_WANT[..]);
    wrong += check("rules", RULES[..], RULES_NAMES[..], RULES_WANT[..]);
    wrong += check("guards", GUARDS[..], GUARDS_NAMES[..], GUARDS_WANT[..]);
    wrong += check("held", HELD[..], HELD_NAMES[..], HELD_WANT[..]);
    wrong += check("old", OLD[..], OLD_NAMES[..], OLD_WANT[..]);
    wrong += check("stop", STOP[..], STOP_NAMES[..], STOP_WANT[..]);
    if (wrong != 0) {
        eprintln(wrong, " bodies differ from their expectation");
        return 1;
    }
    println("summary base ok");
    return 0;
}
