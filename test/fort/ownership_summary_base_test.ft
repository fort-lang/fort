    "fn tv_load(i64 mut* own mut* pp) i64 {",
    "    i64 mut* own x = move(*pp); i64* y = x; *pp = move(x); i64* w = *pp;",
    "    i64 a = *y + *w; del(*pp); *pp = new(i64); return a; }",
    "fn sd_moved(i64 mut* own mut* pp) i64 {",
    "    i64 mut* own x = move(*pp); i64* y = x; *pp = move(x); del(x); return *y; }",
    "fn sb_load(i64 mut* own mut* pp) i64 {",
    "    i64 mut* own x = move(*pp); i64* y = x; *pp = move(x); i64* w = *pp; del(*pp);",
    "    return *y; }",
    "fn ts_write(i64 mut* own mut* pp) void {",
    "    i64 mut* own x = move(*pp); i64 mut* y = x; *pp = move(x); i64* w = *pp; del(*pp);",
    "    *pp = new(i64); *y = 5; }",
    "fn mb_new(i64 mut* own mut* pp) i64 {",
    "    i64 mut* own x = move(*pp); i64* y = x; *pp = move(x); del(*pp); *pp = new(i64);",
