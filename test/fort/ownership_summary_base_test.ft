    "fn hc_branch(i64 mut* own mut* pp, bool c) void {",
    "    i64 mut* own x = move(*pp); i64 mut* y = x;",
    "    if (c) { del(x); *y = 1; return; }",
    "    *pp = move(x); }",
    "fn hf_reassign(i64 mut* own mut* pp) i64 {",
    "    i64 mut* own mut x = move(*pp); i64 mut* y = x; del(x); x = new(i64); *y = 2;",
    "    del(x); return 0; }",
    "fn held_copy(i64 mut* own mut* pp) i64 {",
