    "fn g12_param_deref_guard(i32 mut* own s) i32 { i32 mut* own t = move(s);",
    "    i32 mut x = 0; if (s != null) { x = *s; } del(t); return x; }",
    "fn g13_released_guard(pair mut* own s) i32 {",
    "    del(s); i32 mut x = 0; if (s != null) { x = s->first; } return x; }",
    "fn g14_callee_guard(pair mut* own s) i32 {",
    "    takepair(move(s)); i32 mut x = 0; if (s != null) { x = s->second; } return x; }",
    "fn g15_released_unguarded(pair mut* own s) i32 { del(s); return s->first; }",
    "",
};

