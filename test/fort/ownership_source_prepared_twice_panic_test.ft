//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: ownership_source: context is already prepared
//! stdout:
//| true
/// prepare fills a context once. A context that is already prepared breaks that
/// precondition, so a second call panics before it changes the context.
import modules;
import ownership_source;

fn main() i32 {
    modules.module_set mut set = modules.create();
    defer modules.free(&set);
    ownership_source.context mut c = ownership_source.context{.prepared = true};
    println(c.prepared);
    ownership_source.prepare(&c, null, &set, false);
    return 0;
}
