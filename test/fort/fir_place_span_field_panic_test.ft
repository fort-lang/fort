//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: fir.place_type: a span or string has two fields
//! stdout:
//| ready
/// Checks that fir.place_type refuses field 2 of a span, which has a pointer and a length.
import diag;
import fir;
import prim;
import types;

fn main() i32 {
    types.table mut tt = types.table{};
    defer types.type_table_free(&tt);
    types.node* i32t = types.type_prim(&tt, prim.prim_kind.prim_i32);
    types.node*[2] params = {i32t, i32t};
    types.node* fnty = types.type_fn(&tt, i32t, params[..], false);
    fir.func mut f = fir.func_new(&tt, null, fnty);
    defer fir.func_free(&f);
    types.node* span = types.type_span(&tt, i32t, false, false);
    u32 s = fir.local_add(&f, span, fir.local_kind.lk_temp, null, diag.loc{});
    fir.place p = fir.place_field(&f, fir.place_local(s), 2);
    println("ready");
    fir.place_type(&f, p);
    return 0;
}
