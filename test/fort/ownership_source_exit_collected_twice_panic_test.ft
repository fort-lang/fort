//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: ownership_source_exit: closure is already collected
//! stdout:
//| true
/// collect enumerates the owning globals of a closure once. A closure that is already collected
/// breaks that precondition, so a second call panics before it reads a module.
import ownership_source_exit;

fn main() i32 {
    ownership_source_exit.closure mut x = ownership_source_exit.closure{.collected = true};
    println(x.collected);
    ownership_source_exit.collect(&x, null);
    return 0;
}
