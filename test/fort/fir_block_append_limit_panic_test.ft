//! run
//! flags: -I ../../src
//! abort
//! stderr: panic: fir.block_append: too many statements
//! stdout:
//| 0
/// A statement number is a u32, so block_append refuses a block that already has U32_LIMIT
/// statements. The test sets the count to that limit, and the call panics.
import fort.fir;
import fort.prim;
import fort.types;

fn main() i32 {
    types.table mut tt = types.table{};
    defer types.type_table_free(&tt);
    types.node* i32t = types.type_prim(&tt, prim.prim_kind.prim_i32);
    types.node*[1] params = {i32t};
    types.node* fnty = types.type_fn(&tt, i32t, params[..], false);
    fir.func mut f = fir.func_new(&tt, null, fnty);
    defer fir.func_free(&f);
    append_past_the_limit(&f);
    return 0;
}

// Sets the statement count of the entry block of `f` to the limit, then appends one more. The
// reads through `f` stand in a function that takes it as a parameter (D17.21).
fn append_past_the_limit(fir.func mut* f) void {
    fir.block mut* entry = fir.block_mut(f, 0);
    println(entry->statements.len);
    entry->statements.len = fir.U32_LIMIT;
    fir.block_append(f, 0, fir.statement{});
}
