//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: types.type_fn: null as a return type
//! stdout:
//| 8
/// The null type is never a signature's result.
import fort.types;
import types_env;

fn main() i32 {
    types_env.env mut* own e = types_env.make();
    defer types_env.drop_made(move(e));
    types.node*[1] mut none = {};
    println(types.type_sizeof(types.type_fn(&e->tt, types.type_void(&e->tt), none[..0], false)));
    println(types.type_sizeof(types.type_fn(&e->tt, types.type_null(&e->tt), none[..0], false)));
    return 0;
}
