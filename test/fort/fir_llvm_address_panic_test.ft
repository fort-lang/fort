//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: fir_llvm.place_addr: a register has no address
//! stdout:
//| slot
/// A register is a value with no storage, so a place that is a whole register has no address
/// (spec/fir.md 12.1). The translator never asks for one: it reads a register through
/// place_load and writes it through place_store. A caller that asks breaks the precondition of
/// place_addr, and the translator panics at that call.
import fir;
import fir_llvm;
import llvm_env;

string[11] TEXT = {
    "fn main.f() -> i32 {",
    "    let _1: i32;",
    "    let _2: i32;",
    "",
    "    bb0: {",
    "        _1 = const i32 1 #1:1 s1;",
    "        _2 = copy _1 #1:1 s2;",
    "        _0 = copy _2 #1:1 s2;",
    "        return #1:1 s2;",
    "    }",
    "}",
};

// A panic ends the program, so the case stands in a file of its own.
fn main() i32 {
    llvm_env.env mut e = llvm_env.env{};
    llvm_env.open(&e);
    defer llvm_env.close(&e);
    string[1] prelude = {"i32 UNUSED = 0;"};
    fir.module mut m = llvm_env.parse(&e, prelude[..], TEXT[..]);
    defer fir.module_free(&m);
    fir.func* f = fir.module_function_at(&m, 0);
    llvm_env.begin(&e.g);
    fir_llvm.translator mut t = fir_llvm.open(&e.g, f);
    defer fir_llvm.close(&t);
    fir_llvm.write_locals(&t);
    // `_1`, which s2 reads, is a slot and has its alloca
    assert(fir_llvm.storage_at(&t, 1) == fir_llvm.storage.sk_slot);
    assert(fir_llvm.place_addr(&t, fir.place_local(1)).val == "%tmp0");
    println("slot");
    // `_2` is a register
    fir_llvm.place_addr(&t, fir.place_local(2));
    return 0;
}
