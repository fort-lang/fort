//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| globals ok
//| initializers ok
//| private ok
//| declarations ok
//| ok
/// Checks module data from src/fort/gen_data.ft. Cases cover declarations,
/// constant initializers, private data, external functions, intrinsics, and
/// attribute groups.
import gen;
import gen_data;
import gen_env;
import gen_stmt;
import std.str;
import std.strbuf;

//
// Nine of the twelve cases here emit a module, and each one runs the
// gen_env.expect_blocks check. Four use `globals_of`, and five call the check
// directly. The other three call
// `attr_text`, `emit_intrinsic` and `section` and emit no definition.
// `grep -c '^ *gen_env.expect_blocks('` reports 6 call sites. Those sites
// cover 9 cases, not all 12.
//
// bootstrap/test/gen_global_test.c checks the bootstrap implementation. Direct emitter
// tests pin the expected text here.

// The globals section of a module whose declarations are `decls`.
fn globals_of(gen_env.env mut* e, strbuf.str_buf mut* b, string decls) string {
    strbuf.clear(b);
    strbuf.append(b, decls);
    strbuf.append(b, "fn main() i32 {\n    return 0;\n}\n");
    assert(gen_env.open_module(e, strbuf.view(b)));
    assert(gen_stmt.gen_program(&e->g, &e->c.ck, &e->c.m.set));
    // Every module a case here emits goes through the structural check of
    // the block structure as well, which is what this helper checks.
    gen_env.expect_blocks(e, gen_env.module_text(e));
    return gen_env.globals(e);
}

// ---- module-level data ----------------------------------------------------

// An immutable declaration uses read-only memory. A `mut` declaration uses
// writable memory. Each global has an explicit `align N` from its layout. A
// named fort constant is not
// `unnamed_addr`: its address is significant, because `&CONST` is
// expressible.
fn a_constant_and_a_mut_global_take_their_own_linkage() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    string got = globals_of(&e, &b, "i64 ANSWER = 42;\ni64 mut counter = 7;\nu8 FLAG = 1;\n");
    string[4] mut want = {
        "@\"main.ANSWER\" = dso_local constant i64 42, align 8\n",
        "@\"main.counter\" = dso_local global i64 7, align 8\n",
        "@\"main.FLAG\" = dso_local constant i8 1, align 1\n",
        "",
    };
    gen_env.expect_text(got, gen_env.join_lines(&e, want[0..3]));
}

// ---- constant initializers ------------------------------------------------

// A constant struct lists fields in declaration order, as its named type does.
// An omitted designated field is zero. An array lists its N elements. A
// `string` is its two header fields,
// the bytes and the length the trailing NUL excludes.
fn a_constant_aggregate_is_written_member_by_member() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.str_buf mut src = strbuf.create();
    defer strbuf.free(&src);
    strbuf.append(&src, "struct point {\n    i64 x;\n    i64 y;\n}\n");
    strbuf.append(&src, "string NAME = \"fort\";\npoint ORIGIN = point{1, 2};\n");
    strbuf.append(&src, "point NAMED = point{.y = 3};\ni64[3] TABLE = {1, 0, 3};\n");
    string got = globals_of(&e, &b, strbuf.view(&src));
    string[5] mut want = {
        "@\"main.NAME\" = dso_local constant %fort.span { ptr @.str.0, i64 4 }, align 8\n",
        "@\"main.ORIGIN\" = dso_local constant %struct.main.point { i64 1, i64 2 }, align 8\n",
        "@\"main.NAMED\" = dso_local constant %struct.main.point { i64 0, i64 3 }, align 8\n",
        "@\"main.TABLE\" = dso_local constant [3 x i64] [i64 1, i64 0, i64 3], align 8\n",
        "",
    };
    gen_env.expect_text(got, gen_env.join_lines(&e, want[0..4]));
}

// An all-zero aggregate is `zeroinitializer` whatever its shape, and `{}`
// zeroes any aggregate, span or string. A pointer's zero is `null`
// and every other scalar's is `0`.
fn an_all_zero_value_is_zeroinitializer() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.str_buf mut src = strbuf.create();
    defer strbuf.free(&src);
    strbuf.append(&src, "struct point {\n    i64 x;\n    i64 y;\n}\n");
    strbuf.append(&src, "point EMPTY = point{};\npoint ZEROED = point{0, 0};\n");
    strbuf.append(&src, "i64[2] NONE = {0, 0};\ni64* NOWHERE = null;\nstring BLANK = \"\";\n");
    string got = globals_of(&e, &b, strbuf.view(&src));
    string[6] mut want = {
        "@\"main.EMPTY\" = dso_local constant %struct.main.point zeroinitializer, align 8\n",
        "@\"main.ZEROED\" = dso_local constant %struct.main.point zeroinitializer, align 8\n",
        "@\"main.NONE\" = dso_local constant [2 x i64] zeroinitializer, align 8\n",
        "@\"main.NOWHERE\" = dso_local constant ptr null, align 8\n",
        // A `string`'s pointer is a relocation, so its value is never
        // all-zero even when the bytes are empty.
        "@\"main.BLANK\" = dso_local constant %fort.span { ptr @.str.0, i64 0 }, align 8\n",
        "",
    };
    gen_env.expect_text(got, gen_env.join_lines(&e, want[0..5]));
}

// Module initializers add three
// constant-expression forms. They are
// declaration addresses, function addresses,
// and values of resolved module constants.
fn the_three_module_level_initializer_forms() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.str_buf mut src = strbuf.create();
    defer strbuf.free(&src);
    strbuf.append(&src, "fn pick() i64 {\n    return 1;\n}\n");
    strbuf.append(&src, "i64 mut counter = 7;\ni64 ANSWER = 42;\n");
    strbuf.append(&src, "i64* ADDRESS = &counter;\ni64 ALIAS = ANSWER;\nfn () i64 FUNC = pick;\n");
    string got = globals_of(&e, &b, strbuf.view(&src));
    string[5] mut want = {
        "@\"main.counter\" = dso_local global i64 7, align 8\n",
        "@\"main.ANSWER\" = dso_local constant i64 42, align 8\n",
        "@\"main.ADDRESS\" = dso_local constant ptr @\"main.counter\", align 8\n",
        "@\"main.ALIAS\" = dso_local constant i64 42, align 8\n",
        "@\"main.FUNC\" = dso_local constant ptr @\"main.pick\", align 8\n",
    };
    gen_env.expect_text(got, gen_env.join_lines(&e, want[0..5]));
}

// ---- private data ------------------------------------------------

// `@.str.N` before `@.enum.*`, each numbered on first use and a string
// constant never deduplicated by content. Every byte outside the printable
// range is a `\XX` hex pair and the trailing NUL that `len` excludes is
// written.
fn the_private_data_is_the_three_lists_in_order() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "enum colour {\n    red,\n    green,\n}\n");
    strbuf.append(&b, "fn main() i32 {\n    println(\"a\\tb\");\n");
    strbuf.append(&b, "    println(\"a\\tb\");\n    println(colour.red);\n    return 0;\n}\n");
    assert(gen_env.open_module(&e, strbuf.view(&b)));
    assert(gen_stmt.gen_program(&e.g, &e.c.ck, &e.c.m.set));
    string got = gen_env.module_text(&e);
    gen_env.expect_blocks(&e, got);
    string[7] mut want = {
        // The same text twice is two constants: private data is assigned on
        // first use and never deduplicated by content.
        "@.str.0 = private unnamed_addr constant [4 x i8] c\"a\\09b\\00\", align 1\n",
        "@.str.1 = private unnamed_addr constant [4 x i8] c\"a\\09b\\00\", align 1\n",
        "@.str.2 = private unnamed_addr constant [4 x i8] c\"red\\00\", align 1\n",
        "@.str.3 = private unnamed_addr constant [6 x i8] c\"green\\00\", align 1\n",
        // One entry per member in declaration order, with C's 16-byte layout.
        "@.enum.main.colour = private unnamed_addr constant [2 x %fort.enum_member] ",
        "[%fort.enum_member { i32 0, ptr @.str.2 }, %fort.enum_member { i32 1, ptr @.str.3 }],",
        " align 8\n",
    };
    assert(str.find(got, gen_env.join_lines(&e, want[0..7])) >= 0);
    // A module that needs no failure position holds no file constant at all,
    // since every record is made on first use.
    assert(e.g.files.len == 0);
}

// The file constant holds the path exactly as the compiler opened it, and one
// record stands per file however many failures name it. An enum member uses
// the constant that the checker folded. It prints as the enum's signed `i32`.
// An explicit value replaces the ordinal.
fn an_enum_table_holds_the_value_of_every_member() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "enum code {\n    ok = 0,\n    bad = 7,\n    worse = -1,\n}\n");
    strbuf.append(&b, "fn main() i32 {\n    println(code.bad);\n    return 0;\n}\n");
    assert(gen_env.open_module(&e, strbuf.view(&b)));
    assert(gen_stmt.gen_program(&e.g, &e.c.ck, &e.c.m.set));
    string got = gen_env.module_text(&e);
    gen_env.expect_blocks(&e, got);
    string[4] mut want = {
        "@.enum.main.code = private unnamed_addr constant [3 x %fort.enum_member] ",
        "[%fort.enum_member { i32 0, ptr @.str.0 }, %fort.enum_member { i32 7, ptr @.str.1 },",
        " %fort.enum_member { i32 -1, ptr @.str.2 }],",
        " align 8\n",
    };
    assert(str.find(got, gen_env.join_lines(&e, want[0..4])) >= 0);
    assert(gen.gen_enum_count(gen_env.sym_main(&e, "code")) == 3);
}

fn one_file_constant_stands_per_file() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "fn main() i32 {\n    i64 mut n = 0;\n    n += 1;\n    n += 2;\n");
    strbuf.append(&b, "    return 0;\n}\n");
    assert(gen_env.open_module(&e, strbuf.view(&b)));
    assert(gen_stmt.gen_program(&e.g, &e.c.ck, &e.c.m.set));
    gen_env.expect_blocks(&e, gen_env.module_text(&e));
    assert(e.g.files.len == 1);
    // The path exactly as the compiler opened it, which in the sandbox is the
    // module's path under the temporary directory.
    assert(str.ends_with(gen.records_at(&e.g.files, 0).text, "main.ft"));
}

// ---- declarations and attribute groups ------------------------------------

// An `extern` function uses its unmangled C types and a variadic tail. The tail
// makes a fixed C prototype safe for a variadic function. Its call site uses
// the `nobuiltin` group. Runtime entry points, intrinsics, and attribute groups
// follow their fixed orders. Attribute group numbers can contain gaps.
fn the_declaration_groups_stand_in_their_fixed_order() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "extern fn puts(char* s) i32;\nextern fn swap(u8 a, i16 b) void;\n");
    strbuf.append(&b, "fn main() i32 {\n    i64 mut n = 0;\n    n += 1;\n");
    strbuf.append(&b, "    println(n);\n    swap(1, 2);\n    return puts(\"hi\".ptr);\n}\n");
    assert(gen_env.open_module(&e, strbuf.view(&b)));
    assert(gen_stmt.gen_program(&e.g, &e.c.ck, &e.c.m.set));
    string got = gen_env.module_text(&e);
    gen_env.expect_blocks(&e, got);
    // Two groups and no third: the runtime is defined in the module rather
    // than declared.
    string[5] mut want = {
        "declare void @swap(i8 zeroext, i16 signext) nobuiltin\n",
        "declare i32 @puts(ptr) nobuiltin\n",
        "\n",
        "declare { i64, i1 } @llvm.sadd.with.overflow.i64(i64, i64) #4\n",
        "",
    };
    assert(str.find(got, gen_env.join_lines(&e, want[0..4])) >= 0);
    assert(str.find(got, "declare void @\"std.rt.") < 0);
    string[4] mut groups = {
        "attributes #0 = { nounwind \"frame-pointer\"=\"all\" \"probe-stack\"=\"inline-asm\" }\n",
        "attributes #3 = { nobuiltin }\n",
        "attributes #4 = { nocallback nofree nosync nounwind speculatable willreturn ",
        "memory(none) }\n",
    };
    assert(str.find(got, gen_env.join_lines(&e, groups[0..4])) >= 0);
    // The groups a module does not use leave no trace, so #1, #2 and #5 to #8
    // are absent here. `#2` is never emitted at all.
    assert(str.find(got, "attributes #1 =") < 0);
    assert(str.find(got, "attributes #2 =") < 0);
    assert(str.find(got, "attributes #5 =") < 0);
    assert(str.find(got, "attributes #8 =") < 0);
}

// Mac marks each extern declaration `nobuiltin`. This test checks two
// declarations. The call-site group remains in the output. Linux keeps the
// declaration bytes tested above.
fn mac_extern_declarations_protect_allocator_effects() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open_with(&e, gen.gen_options{false, false, "arm64-apple-macosx15.0.0"});
    defer gen_env.close(&e);
    strbuf.str_buf mut source = strbuf.create();
    defer strbuf.free(&source);
    strbuf.append(&source, "extern fn calloc(u64 n, u64 size) void*;\n");
    strbuf.append(&source, "extern fn free(void* p) void;\n");
    strbuf.append(&source, "fn main() i32 {\n    free(calloc(1, 16));\n    return 0;\n}\n");
    assert(gen_env.open_module(&e, strbuf.view(&source)));
    assert(gen_stmt.gen_program(&e.g, &e.c.ck, &e.c.m.set));
    string got = gen_env.module_text(&e);
    gen_env.expect_blocks(&e, got);
    assert(str.find(got, "declare ptr @calloc(i64, i64) nobuiltin\n") >= 0);
    assert(str.find(got, "declare void @free(ptr) nobuiltin\n") >= 0);
    assert(str.find(got, ") #3\n") >= 0);
}

// The text of every attribute group, at its fixed index: the one place the
// table is written down. Each `declare` line also points at one entry.
// `mustprogress` is deliberately absent everywhere, since it would license
// the optimizer to delete a `while (true) { }`, which fort keeps running.
fn every_attribute_group_has_its_text() void {
    assert(gen_data.attr_text(gen.ATTR_FN) ==
           "nounwind \"frame-pointer\"=\"all\" \"probe-stack\"=\"inline-asm\"");
    assert(gen_data.attr_text(gen.ATTR_FN_NORET) ==
           "noreturn nounwind \"frame-pointer\"=\"all\" \"probe-stack\"=\"inline-asm\"");
    // The emitter leaves `#2` unused. Its index keeps `#3` through `#7` at
    // their fixed numbers. `#8` is `#1`
    // plus `cold` on `noreturn` entry points.
    assert(gen_data.attr_text(gen.ATTR_UNUSED_2) == "cold noreturn nounwind");
    assert(gen_data.attr_text(gen.ATTR_RT_NORET) ==
           "cold noreturn nounwind \"frame-pointer\"=\"all\" \"probe-stack\"=\"inline-asm\"");
    assert(gen_data.attr_text(gen.ATTR_NOBUILTIN) == "nobuiltin");
    assert(gen_data.attr_text(gen.ATTR_OVERFLOW) ==
           "nocallback nofree nosync nounwind speculatable willreturn memory(none)");
    assert(gen_data.attr_text(gen.ATTR_MEMCPY) ==
           "nocallback nofree nounwind willreturn memory(argmem: readwrite)");
    assert(gen_data.attr_text(gen.ATTR_MEMSET) ==
           "nocallback nofree nounwind willreturn memory(argmem: write)");
    assert(gen_data.attr_text(gen.ATTR_TRAP) ==
           "cold noreturn nounwind memory(inaccessiblemem: write)");
    assert(gen_data.attr_text(gen.ATTR_TRAP) !=
           gen_data.attr_text(gen.ATTR_UNUSED_2));
}

// Overflow intrinsics use the order `sadd ssub smul uadd usub umul`. Each
// family uses widths `i8 i16 i32 i64`. A declaration uses both table
// positions, so the test checks both orders together.
fn the_intrinsic_table_is_in_the_order_item_eight_gives() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    strbuf.str_buf mut out = strbuf.create();
    defer strbuf.free(&out);
    gen_data.emit_intrinsic(&out, gen.IN_MEMCPY);
    gen_data.emit_intrinsic(&out, gen.IN_MEMSET);
    gen_data.emit_intrinsic(&out, gen.IN_OVERFLOW_FIRST);
    gen_data.emit_intrinsic(&out, gen.IN_OVERFLOW_FIRST + gen.OVF_UMUL * gen.OVF_WIDTHS + 3);
    gen_data.emit_intrinsic(&out, gen.IN_TRAP);
    string[7] mut want = {
        "declare void @llvm.memcpy.p0.p0.i64(ptr noalias nocapture writeonly, ",
        "ptr noalias nocapture readonly, i64, i1 immarg) #5\n",
        "declare void @llvm.memset.p0.i64(ptr nocapture writeonly, i8, i64, i1 immarg) #6\n",
        "declare { i8, i1 } @llvm.sadd.with.overflow.i8(i8, i8) #4\n",
        "declare { i64, i1 } @llvm.umul.with.overflow.i64(i64, i64) #4\n",
        "declare void @llvm.trap() #7\n",
        "",
    };
    gen_env.expect_text(strbuf.view(&out), gen_env.join_lines(&e, want[0..6]));
}

// A section a module does not need leaves no trace, and the ones it has are
// separated by exactly one blank line.
fn an_empty_section_is_left_out_entirely() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    strbuf.str_buf mut out = strbuf.create();
    defer strbuf.free(&out);
    gen_data.section(&out, "one\n");
    gen_data.section(&out, "");
    gen_data.section(&out, "two\n");
    assert(strbuf.view(&out) == "one\n\ntwo\n");
}

fn main() i32 {
    a_constant_and_a_mut_global_take_their_own_linkage();
    println("globals ok");
    a_constant_aggregate_is_written_member_by_member();
    an_all_zero_value_is_zeroinitializer();
    the_three_module_level_initializer_forms();
    println("initializers ok");
    the_private_data_is_the_three_lists_in_order();
    an_enum_table_holds_the_value_of_every_member();
    one_file_constant_stands_per_file();
    println("private ok");
    the_declaration_groups_stand_in_their_fixed_order();
    mac_extern_declarations_protect_allocator_effects();
    every_attribute_group_has_its_text();
    the_intrinsic_table_is_in_the_order_item_eight_gives();
    an_empty_section_is_left_out_entirely();
    println("declarations ok");
    println("ok");
    return 0;
}
