fn the_target_of_an_object_is_refused_before_the_libraries_are_read() void {
    string mut other = "arm64-apple-macosx11.0.0";
    if (os.TARGET == other) {
        other = "x86_64-linux-gnu";
    }
    // the artifact does not exist, and step 0 refuses the target first
    string[6] args = {"--use", "std=missing.flib", "-c", "--target", other, "main.ft"};
    assert(use_run(args[..]) == EXIT_USAGE);
    assert(err_has("fort: error: cannot compile object for target '"));
}

fn the_used_libraries_are_read_before_the_entry_file() void {
    string[3] args = {"--use", "std=missing.flib", "nope.ft"};
    assert(use_run(args[..]) == EXIT_USAGE);
    assert(err_is("fort: error: cannot read library 'missing.flib': No such file or directory\n"));
    build_std(NO_MORE[..0]);
    string[3] valid = {"--use", "std=std.flib", "nope.ft"};
    assert(use_run(valid[..]) == EXIT_USAGE);
    assert(err_is("fort: error: cannot read 'nope.ft': No such file or directory\n"));
}

fn a_manifest_that_cannot_be_read_is_exit_two() void {
    build_std(NO_MORE[..0]);
    write_file("main.ft", MAIN);
    char mut@ own c_path = str.to_cstr("std.flib/manifest");
    defer del(c_path);
    assert(libc.chmod(c_path.ptr, 0) == 0);
    string[4] args = {"--use", "std=std.flib", "-S", "main.ft"};
    i32 status = use_run(args[..]);
    assert(libc.chmod(c_path.ptr, 0o644) == 0);
    assert(status == EXIT_USAGE);
    assert(err_is("fort: error: cannot read library 'std.flib': Permission denied\n"));
}

fn a_closure_error_stops_before_the_extern_check() void {
    build_std(NO_MORE[..0]);
    // a wrong `abs` beside a type error: only the error of the closure stands
    write_file("main.ft", "extern fn abs(i64 x) i64;\nbool B = 1;\n");
    string[4] args = {"--use", "std=std.flib", "--check", "main.ft"};
    assert(use_run(args[..]) == EXIT_COMPILE_ERROR);
    assert(err_has("main.ft:2:10: error:"));
    string own err = capture.text("err.txt");
    defer del(err);
    assert(str.find(err, "conflicting declarations") < 0);
}

fn the_cache_options_need_a_library_build() void {
    string[4] args = {"fort", "--cache-dir", "c", "main.ft"};
    assert(usage_error_is(args[..], "--cache-dir requires --lib or --use"));
    string[3] stats = {"fort", "--cache-stats", "main.ft"};
    assert(usage_error_is(stats[..], "--cache-stats requires --lib or --use"));
}

fn a_path_that_holds_an_equal_sign_is_the_path() void {
    write_file("main.ft", MAIN);
    // the argument splits at its first `=`
    string[4] args = {"--use", "std=a=b.flib", "-S", "main.ft"};
    assert(use_run(args[..]) == EXIT_USAGE);
    assert(err_is("fort: error: cannot read library 'a=b.flib': No such file or directory\n"));
}

fn three_libraries_link_in_the_order_of_their_uses() void {
    build_std(NO_MORE[..0]);
    build_geom(NO_MORE[..0]);
    // `app` uses geom and std; the command line names std, app and geom in that order
    // an earlier case wrote the program `app`, so the root of the library has another name
    make_dir("approot");
    write_file("approot/run.ft", "import geom.vec;\nfn go() i32 {\n    return vec.len(1);\n}\n");
    string[4] both = {"--use", "std=std.flib", "--use", "geom=geom.flib"};
    assert(build_library("app", "approot", "app.flib", both[..]) == EXIT_OK);
    assert(err_is(""));
    write_file("main.ft", "import app.run;\nfn main() i32 {\n    return run.go();\n}\n");
    remove("cc.log");
    remove("archives.log");
    string[9] args = {"--use", "std=std.flib", "--use", "app=app.flib", "--use", "geom=geom.flib",
                      "-o", "app4", "main.ft"};
    assert(use_run(args[..]) == EXIT_OK);
    assert(err_is(""));
    string own log = cc_log();
    defer del(log);
    i64 app = str.find(log, "/app.a\n");
    i64 geom = str.find(log, "/geom.a\n");
    i64 std_archive = str.find(log, "/std.a\n");
    assert(app > 0 && geom > app && std_archive > geom);
    // the entry unit declares each function of each interface module of its closure: app.run
    // and geom.vec, which app.run imports (module-system.md 10.4)
    string[6] ir = {"--use", "std=std.flib", "--use", "app=app.flib", "--use", "geom=geom.flib"};
    string[4] more = {"-S", "-o", "app4.ll", "main.ft"};
    string[3] head = {"fort", "--cc", "./cc.sh"};
    string[10] mut all = {};
    u64 mut i = 0;
    while (i < 6) {
        all[i] = ir[i];
        i += 1;
    }
    while (i < 10) {
        all[i] = more[i - 6];
        i += 1;
    }
    assert(run_with(head[..], all[..]) == EXIT_OK);
    string own text = contents("app4.ll");
    defer del(text);
    assert(str.find(text, "declare dso_local i32 @\"app.run.go\"() #0\n") > 0);
    assert(str.find(text, "declare dso_local i32 @\"geom.vec.len\"(i32) #0\n") > 0);
    assert(str.find(text, "define dso_local i32 @\"geom.vec.len\"") < 0);
}

fn the_index_holds_no_record_of_a_module_outside_the_closure() void {
    build_std(NO_MORE[..0]);
    write_file("main.ft", MAIN);
    string[4] args = {"fort", "--index", "--use", "std=std.flib"};
    string[1] entry = {"main.ft"};
    assert(run_with(args[..], entry[..]) == EXIT_OK);
    string own with_zz = contents("out.txt");
    defer del(with_zz);
    // std.zz sorts after std.rt and std.io, so without it no position of their sections moves
    remove("std/zz.ft");
    assert(build_library("std", "std", "std.flib", NO_MORE[..0]) == EXIT_OK);
    assert(run_with(args[..], entry[..]) == EXIT_OK);
    string own without = contents("out.txt");
    defer del(without);
    assert(with_zz == without);
}

fn the_check_document_holds_a_conflict_outside_the_closure() void {
    build_std(NO_MORE[..0]);
    write_file("main.ft", "extern fn abs(i64 x) i64;\n");
    string[5] args = {"fort", "--check", "--json", "--use", "std=std.flib"};
    string[1] entry = {"main.ft"};
    assert(run_with(args[..], entry[..]) == EXIT_COMPILE_ERROR);
    assert(err_is(""));
    string own doc = contents("out.txt");
    defer del(doc);
    // the error stands in the interface file, which the document lists, and its note in main.ft
    assert(str.find(doc, "\"files\":[\"std.flib/interface.ft\",\"main.ft\"]") > 0);
    assert(str.find(doc, "{\"file\":\"std.flib/interface.ft\",\"line\":") > 0);
    assert(str.find(doc, "the result type differs") > 0);
    assert(str.find(doc, "\"notes\":[{\"file\":\"main.ft\",\"line\":1,\"col\":11") > 0);
}

fn a_trailing_separator_of_a_path_takes_no_second_one() void {
    build_std(NO_MORE[..0]);
    write_file("main.ft", MAIN);
    string[5] args = {"fort", "--check", "--json", "--use", "std=std.flib/"};
    string[1] entry = {"main.ft"};
    assert(run_with(args[..], entry[..]) == EXIT_OK);
    string own doc = contents("out.txt");
    defer del(doc);
    assert(str.find(doc, "\"files\":[\"std.flib/interface.ft\",\"main.ft\"]") > 0);
}

fn a_lexical_error_of_an_interface_file_is_in_the_check_document() void {
    build_std(NO_MORE[..0]);
    write_file("main.ft", MAIN);
    string[4] lines = {"/\x2F! fort interface 1", "/\x2F! library std", "/\x2F! module std.rt",
                       "i32 B = 1$;"};
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    u64 mut i = 0;
    while (i < lines.len) {
        strbuf.append(&text, lines[i]);
        strbuf.push(&text, '\n');
        i += 1;
    }
    replace_interface(strbuf.view(&text));
    string[5] args = {"fort", "--check", "--json", "--use", "std=std.flib"};
    string[1] entry = {"main.ft"};
    assert(run_with(args[..], entry[..]) == EXIT_COMPILE_ERROR);
    string own doc = contents("out.txt");
    defer del(doc);
    assert(str.find(doc, "{\"file\":\"std.flib/interface.ft\",\"line\":4,\"col\":10") > 0);
    assert(str.find(doc, "\"files\":[\"std.flib/interface.ft\"]") > 0);
}

fn a_section_that_does_not_parse_is_a_compile_error_at_its_import() void {
    build_std(NO_MORE[..0]);
    write_file("main.ft", "import std.bad;\nfn main() i32 {\n    return 0;\n}\n");
    string[6] lines = {"/\x2F! fort interface 1", "/\x2F! library std", "/\x2F! module std.bad",
                       "fn f(;", "/\x2F! module std.rt", "i32 B = 1;"};
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    u64 mut i = 0;
    while (i < lines.len) {
        strbuf.append(&text, lines[i]);
        strbuf.push(&text, '\n');
        i += 1;
    }
    replace_interface(strbuf.view(&text));
    string[4] args = {"--use", "std=std.flib", "--check", "main.ft"};
    assert(use_run(args[..]) == EXIT_COMPILE_ERROR);
    assert(err_has("std.flib/interface.ft:4:6: error: expected a type, found ';'"));
    // a program that does not import it loads it for the extern check, and reports it there
    write_file("main.ft", "fn main() i32 {\n    return 0;\n}\n");
    assert(use_run(args[..]) == EXIT_COMPILE_ERROR);
    assert(err_has("std.flib/interface.ft:4:6: error: expected a type, found ';'"));
}

fn the_compile_options_of_a_used_library_are_not_compared() void {
    // the key covers --cc, -Xcc and --ar, and a build compares none of them
    string[2] xcc = {"-Xcc", "-g0"};
    build_std(xcc[..]);
    write_file("main.ft", MAIN);
    string[6] args = {"--use", "std=std.flib", "-Xcc", "-O0", "-S", "main.ft"};
    assert(use_run(args[..]) == EXIT_OK);
    assert(err_is(""));
    string own manifest = contents("std.flib/manifest");
    defer del(manifest);
    assert(str.find(manifest, "\nxcc -g0\n") > 0);
}

// A program with an unproved store into an `own` local (D17.11) and a declaration of `abs` in
// another form than std.zz, which it does not import.
string[12] OVERWRITE_LINES = {
    "extern fn abs(i64 x) i64;",
    "fn make(i32 v) i32 mut* own {",
    "    i32 mut* own p = new(i32);",
    "    *p = v;",
    "    return p;",
    "}",
    "fn main() i32 {",
    "    i32 mut* own mut p = make(1);",
    "    p = make(2);",
    "    del(p);",
    "    return 0;",
    "}",
};

// The stderr of `fort --cc ./cc.sh <args>`, which must exit with `status`.
fn stderr_of(string@ args, i32 status) string own {
    assert(use_run(args) == status);
    return capture.text("err.txt");
}

fn the_emptiness_pass_reports_before_the_extern_check_outside() void {
    build_std(NO_MORE[..0]);
    write_lines("main.ft", OVERWRITE_LINES[..]);
    // a whole program reports the store alone: it reads no module that it does not import
    string[4] whole_check = {"--check", "--std-dir", "std", "main.ft"};
    string own want = stderr_of(whole_check[..], EXIT_COMPILE_ERROR);
    defer del(want);
    assert(str.find(want, "main.ft:9:7: error: overwriting owned value: cannot prove 'p' is") == 0);
    // with --use the pass runs first and stops the build, as step 4 of toolchain.md 2.1 does
    string[4] use_check = {"--use", "std=std.flib", "--check", "main.ft"};
    string own got = stderr_of(use_check[..], EXIT_COMPILE_ERROR);
    defer del(got);
    assert(got == want);
    string[4] whole_ir = {"--std-dir", "std", "-S", "main.ft"};
    string own want_ir = stderr_of(whole_ir[..], EXIT_COMPILE_ERROR);
    defer del(want_ir);
    remove("main.ll");
    string[4] use_ir_args = {"--use", "std=std.flib", "-S", "main.ft"};
    string own got_ir = stderr_of(use_ir_args[..], EXIT_COMPILE_ERROR);
    defer del(got_ir);
    assert(got_ir == want_ir);
    assert(!exists("main.ll"));
    // with the store proved, the conflict outside the closure stands
    write_file("main.ft", "extern fn abs(i64 x) i64;\nfn main() i32 {\n    return 0;\n}\n");
    assert(use_run(use_check[..]) == EXIT_COMPILE_ERROR);
    assert(err_has("conflicting declarations of extern 'abs'"));
    // a library build runs the pass before the extern check as well
    // (`main` of a library module is an ordinary function)
    make_dir("store");
    write_lines("store/m.ft", OVERWRITE_LINES[..]);
    string[7] lib = {"fort", "--lib", "store", "store", "--emit-interface", "--use",
                     "std=std.flib"};
    assert(run(lib[..]) == EXIT_COMPILE_ERROR);
    assert(err_has("store/m.ft:9:7: error: overwriting owned value: cannot prove 'p' is"));
    string own lib_err = capture.text("err.txt");
    defer del(lib_err);
    assert(str.find(lib_err, "conflicting declarations") < 0);
}

fn an_import_binding_of_an_interface_section_is_no_declaration() void {
    build_std(NO_MORE[..0]);
    // std.io imports std.rt, and its section binds that import as `_0`
    string[3] forms = {"import std.io._0;", "import std.io.{_0};", "import std.io.rt;"};
    u64 mut i = 0;
    while (i < forms.len) {
        strbuf.str_buf mut b = strbuf.create();
        defer strbuf.free(&b);
        strbuf.append(&b, forms[i]);
        strbuf.append(&b, "\nfn main() i32 {\n    return 0;\n}\n");
        write_file("main.ft", strbuf.view(&b));
        string[4] args = {"--use", "std=std.flib", "--check", "main.ft"};
        assert(use_run(args[..]) == EXIT_COMPILE_ERROR);
        // the binding is no name of the module (module-system.md 13)
        assert(err_has("main.ft:1:1: error: module 'std.io' has no declaration named '"));
        i += 1;
    }
    string own last = capture.text("err.txt");
    defer del(last);
    assert(str.find(last, "has no declaration named 'rt'") > 0);
    // the source holds no binding `_0`, and the binding `rt` is an import there
    string[4] whole = {"--check", "--std-dir", "std", "main.ft"};
    assert(use_run(whole[..]) == EXIT_COMPILE_ERROR);
    assert(err_has("main.ft:1:1: error: cannot import 'rt': it is an import of module 'std.io'"));
    write_file("main.ft", "import std.io._0;\nfn main() i32 {\n    return 0;\n}\n");
    assert(use_run(whole[..]) == EXIT_COMPILE_ERROR);
    assert(err_has("main.ft:1:1: error: module 'std.io' has no declaration named '_0'"));
}

fn the_fir_modes_of_the_build_mode_and_the_report_read_the_used_library() void {
    build_std(NO_MORE[..0]);
    write_file("main.ft", MAIN);
    string[4] after = {"--fir-after=build-mode", "--use", "std=std.flib", "main.ft"};
    assert(use_run(after[..]) == EXIT_OK);
    assert(err_is(""));
    string own fir = contents("out.txt");
    defer del(fir);
    assert(str.starts_with(fir, "fn main.main() -> i32 {\n"));
    assert(str.find(fir, "call fn std.io.f(const i32 2)") > 0);
    string[4] report = {"--fir-verify-report", "--use", "std=std.flib", "main.ft"};
    assert(use_run(report[..]) == EXIT_OK);
    assert(err_is(""));
    assert(out_is_empty());
    // the report mode reports no overwrite error, with --use as without it
    write_lines("main.ft", OVERWRITE_LINES[1..]);
    assert(use_run(report[..]) == EXIT_OK);
    assert(err_is(""));
    string[4] whole = {"--fir-verify-report", "--std-dir", "std", "main.ft"};
    assert(use_run(whole[..]) == EXIT_OK);
    assert(err_is(""));
}

// ---- more of a library build with --use ------------------------------------------------

fn a_library_build_reads_its_used_libraries_before_its_root() void {
    string[6] args = {"fort", "--lib", "geom", "missing", "--use", "std=missing.flib"};
    assert(run(args[..]) == EXIT_USAGE);
    assert(err_is("fort: error: cannot read library 'missing.flib': No such file or directory\n"));
    build_std(NO_MORE[..0]);
    string[6] root = {"fort", "--lib", "geom", "missing", "--use", "std=std.flib"};
    assert(run(root[..]) == EXIT_USAGE);
    assert(err_is("fort: error: cannot read library root 'missing': No such file or directory\n"));
}

fn a_library_object_declares_the_used_library() void {
    build_std(NO_MORE[..0]);
    make_dir("geom");
    write_file("geom/vec.ft", VEC_MODULE);
    string[3] args = {"--use", "std=std.flib", "-c"};
    remove("geom.o");
    assert(build_library("geom", "geom", "geom.o", args[..]) == EXIT_OK);
    string own object = contents("geom.o");
    defer del(object);
    assert(str.find(object, "declare dso_local i32 @\"std.io.f\"(i32) #0\n") > 0);
    assert(str.find(object, "define dso_local i32 @\"std.io.f\"") < 0);
}

fn a_library_build_records_each_used_library_in_byte_order() void {
    build_std(NO_MORE[..0]);
    make_dir("util");
    write_file("util/text.ft", "i32 T = 1;\n");
    string[2] std_only = {"--use", "std=std.flib"};
    assert(build_library("util", "util", "util.flib", std_only[..]) == EXIT_OK);
    // the command line names util first, and the manifest writes std first
    string[4] both = {"--use", "util=util.flib", "--use", "std=std.flib"};
    make_dir("geom");
    write_file("geom/vec.ft", VEC_MODULE);
    assert(build_library("geom", "geom", "geom.flib", both[..]) == EXIT_OK);
    string own manifest = contents("geom.flib/manifest");
    defer del(manifest);
    i64 std_line = str.find(manifest, "\nuse std ");
    i64 util_line = str.find(manifest, "\nuse util ");
    assert(std_line > 0 && util_line > std_line);
    string own util_hash = manifest_value("util.flib", "interface");
    defer del(util_hash);
    assert(str.find(manifest, util_hash) == util_line + 10);
}

// ---- the artifact that a build writes reads back ---------------------------------------

fn the_artifact_of_a_build_reads_back_with_the_fields_of_the_build() void {
    string[3] configured = {"--no-bounds-check", "--cfg", "zone=a b"};
    build_std(configured[..]);
    artifact.contents mut c = artifact.contents{};
    defer artifact.free(&c);
    i32 mut error = 0;
    assert(artifact.read("std.flib", &c, &error) == artifact.verdict.v_valid);
    assert(c.fields.library == "std");
    assert(c.fields.target == os.TARGET);
    assert(!c.fields.release);
    assert(c.fields.no_bounds_check);
    assert(c.fields.cc == "./cc.sh");
    assert(c.fields.ar == "./ar.sh");
    assert(c.fields.use_names.len == 0);
    // the running compiler is this program, which wrote the artifact
    strbuf.str_buf mut compiler = strbuf.create();
    defer strbuf.free(&compiler);
    strbuf.str_buf mut exe = strbuf.create();
    defer strbuf.free(&exe);
    assert(artifact.hash_compiler(&compiler, &exe));
    assert(c.fields.compiler == strbuf.view(&compiler));
    // the configuration map: the three keys of the target and the pair of --cfg, in byte order
    assert(c.fields.cfg_keys.len == 4);
    assert(c.fields.cfg_keys[0] == "target_abi");
    assert(c.fields.cfg_keys[3] == "zone");
    assert(c.fields.cfg_values[3] == "a b");
    // the bytes of the read are the files
    string own interface = contents("std.flib/interface.ft");
    defer del(interface);
    assert(strbuf.view(&c.interface) == interface);
    string own archive = contents("std.flib/lib.a");
    defer del(archive);
    assert(strbuf.view(&c.archive) == archive);
}

fn main() i32 {
    the_argument_of_use_is_a_name_and_a_path();
    a_library_is_named_once();
    a_library_build_needs_the_library_std();
    the_options_of_a_lib_build_still_need_lib();
    the_lexer_and_the_parser_read_no_used_library();
    println("usage ok");
    an_artifact_that_cannot_be_read_is_exit_two();
    an_artifact_that_breaks_a_rule_is_corrupt();
    an_interface_file_of_another_form_is_corrupt();
    a_lexical_error_in_an_interface_file_is_a_compile_error();
    an_artifact_of_another_format_version_is_corrupt();
    an_artifact_of_another_name_is_refused();
    an_artifact_of_another_compiler_or_target_is_refused();
    an_artifact_of_another_mode_is_refused();
    an_artifact_of_another_configuration_is_refused();
    the_first_failure_of_the_command_line_reports();
    println("artifact ok");
    each_used_library_of_a_manifest_must_be_named();
    a_library_built_against_another_interface_is_refused();
    two_libraries_that_use_each_other_are_a_cycle();
    println("uses ok");
    the_ir_module_of_the_entry_unit_declares_the_library();
    the_modules_outside_the_closure_add_nothing_to_the_module();
    the_entry_unit_is_compiled_and_linked_with_each_archive();
    an_object_is_the_compile_line_alone();
    a_dash_output_is_stdout();
    a_failed_link_is_exit_two();
    a_cross_target_module_needs_no_std_dir();
    a_search_root_serves_the_paths_of_no_library();
    a_symbol_import_reads_the_section_of_its_module();
    a_module_that_the_interface_lacks_is_not_found_in_the_library();
    a_release_build_compiles_at_the_release_level();
    ir_and_object_together_stop_at_the_ir();
    the_lowering_count_of_an_entry_unit_counts_its_own_functions();
    a_build_with_use_reads_no_standard_directory();
    a_link_writes_a_out_by_default();
    a_failed_compile_line_runs_no_link();
    a_compile_error_runs_no_tool();
    a_library_that_no_module_imports_is_still_linked();
    the_target_of_an_object_is_refused_before_the_libraries_are_read();
    the_used_libraries_are_read_before_the_entry_file();
    a_manifest_that_cannot_be_read_is_exit_two();
    a_closure_error_stops_before_the_extern_check();
    the_cache_options_need_a_library_build();
    a_path_that_holds_an_equal_sign_is_the_path();
    three_libraries_link_in_the_order_of_their_uses();
    a_trailing_separator_of_a_path_takes_no_second_one();
    a_lexical_error_of_an_interface_file_is_in_the_check_document();
    a_section_that_does_not_parse_is_a_compile_error_at_its_import();
    the_compile_options_of_a_used_library_are_not_compared();
    the_emptiness_pass_reports_before_the_extern_check_outside();
    an_import_binding_of_an_interface_section_is_no_declaration();
    the_fir_modes_of_the_build_mode_and_the_report_read_the_used_library();
    println("build ok");
    an_extern_of_an_unimported_module_conflicts_across_units();
    the_extern_check_reads_the_libraries_in_the_reverse_of_the_link_order();
    the_check_document_lists_each_interface_file_once();
    the_index_records_no_module_outside_the_closure();
    the_fir_of_the_entry_unit_holds_its_own_functions();
    a_fir_test_reads_its_prelude_against_the_used_library();
    the_index_holds_no_record_of_a_module_outside_the_closure();
    the_check_document_holds_a_conflict_outside_the_closure();
    println("closure ok");
    a_library_build_records_each_used_library();
    a_library_build_emits_its_interface_against_the_used_library();
    a_library_build_holds_its_externs_against_the_used_library();
    a_library_build_reads_its_used_libraries_before_its_root();
    a_library_object_declares_the_used_library();
    a_library_build_records_each_used_library_in_byte_order();
    the_artifact_of_a_build_reads_back_with_the_fields_of_the_build();
    println("library ok");
