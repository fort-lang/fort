fn the_lowering_count_of_an_entry_unit_counts_its_own_functions() void {
    build_std(NO_MORE[..0]);
    write_file("main.ft", MAIN);
    string[5] args = {"--use", "std=std.flib", "-S", "--fir-stats", "main.ft"};
    assert(use_run(args[..]) == EXIT_OK);
    string own out = contents("out.txt");
    defer del(out);
    // main.main alone: the functions of std are bodiless in the interface
    assert(out == "lowered 1 of 1\n");
}

fn a_build_with_use_reads_no_standard_directory() void {
    build_std(NO_MORE[..0]);
    write_file("main.ft", MAIN);
    // the directory does not exist, and the build does not open it
    string[6] args = {"--std-dir", "nowhere", "--use", "std=std.flib", "-S", "main.ft"};
    assert(use_run(args[..]) == EXIT_OK);
    assert(err_is(""));
    set_env("FORT_STD_DIR", "nowhere");
