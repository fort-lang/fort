    assert(use_run(env[..]) == EXIT_OK);
    assert(err_is(""));
    set_env("FORT_STD_DIR", "");
}

fn a_link_writes_a_out_by_default() void {
    build_std(NO_MORE[..0]);
    write_file("main.ft", MAIN);
    remove("a.out");
    string[3] args = {"--use", "std=std.flib", "main.ft"};
    assert(use_run(args[..]) == EXIT_OK);
    string own out = contents("a.out");
    defer del(out);
    assert(out == "linked\n");
}

fn a_failed_compile_line_runs_no_link() void {
    build_std(NO_MORE[..0]);
    write_file("main.ft", MAIN);
    remove("cc.log");
    write_file("compile_fail.flag", "1\n");
    string[5] args = {"--use", "std=std.flib", "-o", "app2", "main.ft"};
    assert(use_run(args[..]) == EXIT_USAGE);
    assert(err_is("fort: error: cc failed with status 4\n"));
    assert(!exists("app2"));
    string own log = cc_log();
    defer del(log);
    // the compile line alone ran
    assert(str.find(log, "--\n") == cast(log.len - 3, i64));
    remove("compile_fail.flag");
}

fn a_compile_error_runs_no_tool() void {
    build_std(NO_MORE[..0]);
    write_file("bad.ft", "fn main() i32 {\n    return true;\n}\n");
    remove("cc.log");
    string[3] args = {"--use", "std=std.flib", "bad.ft"};
    assert(use_run(args[..]) == EXIT_COMPILE_ERROR);
    assert(err_has("bad.ft:2:12: error:"));
    assert(!exists("cc.log"));
}

fn a_library_that_no_module_imports_is_still_linked() void {
    build_std(NO_MORE[..0]);
    build_geom(NO_MORE[..0]);
    write_file("main.ft", "fn main() i32 {\n    return 0;\n}\n");
    remove("cc.log");
    remove("archives.log");
    string[7] args = {"--use", "geom=geom.flib", "--use", "std=std.flib", "-o", "app3", "main.ft"};
    assert(use_run(args[..]) == EXIT_OK);
    string own log = cc_log();
    defer del(log);
