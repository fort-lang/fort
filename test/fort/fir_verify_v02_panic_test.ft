//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: V2 a terminator names no block of the function: main.nothing bb1 statement 0 (s4)
//! stdout:
//| bb1 names the last block
/// Checks that fir_verify.verify ends the program on a terminator that names a block past the
/// last one, the violation of V2. The parser refuses such a name, so the constructors build it
/// (test/fir/verify/v02_target_out_of_range.fir).
import fir;
import fir_env;
import fir_verify;

fn main() i32 {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fir.func mut f = fir_env.func_of(&e, "nothing");
    defer fir.func_free(&f);
    fir_verify.runtime rt = fir_verify.runtime{};
    u32 one = fir.block_new(&f);
    u32 two = fir.block_new(&f);
    fir.block_set_terminator(&f, 0, fir.term_goto(one, fir_env.at(1, 1), 1));
    fir.block_set_terminator(&f, one, fir.term_goto(two, fir_env.at(2, 1), 2));
    fir.block_set_terminator(&f, two, fir.term_return(fir_env.at(3, 1), 3));
    fir_verify.verify(&f, &rt);
    println("bb1 names the last block");
    fir.func mut g = fir_env.func_of(&e, "nothing");
    defer fir.func_free(&g);
    u32 last = fir.block_new(&g);
    fir.block_set_terminator(&g, 0, fir.term_goto(last, fir_env.at(1, 1), 1));
    fir.block_set_terminator(&g, last, fir.term_goto(last + 1, fir_env.at(4, 1), 4));
    fir_verify.verify(&g, &rt);
    return 0;
}
