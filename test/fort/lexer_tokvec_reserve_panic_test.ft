//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: lexer.tokvec_reserve: capacity overflow
//! stdout:
//| 1
/// tokvec_reserve adds a request to the length. A request that makes the sum pass u64 is
/// refused before the addition, which would trap.
import containers;
import lexer;

fn main() i32 {
    lexer.tok_vec mut v = lexer.tokvec_create();
    defer lexer.tokvec_free(&v);
    lexer.tokvec_push(&v, lexer.token{});
    println(lexer.tokvec_count(&v));
    lexer.tokvec_reserve(&v, containers.U64_MAX);
    return 0;
}
