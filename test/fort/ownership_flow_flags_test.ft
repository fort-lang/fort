//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| null decisions ok
//| flag steps ok
//| flag edges ok
//| invalid inputs ok
//| site identities ok
//| site renames ok
//| site refusals ok
/// Checks the flag steps, the flag edges and the earlier site identities of ownership_flow.
/// A flag is a bool local: a path keeps its known value until the next write of it. A switch
/// edge refutes a path that knows the other value (spec/fir.md 14.1). An allocation site that
/// runs again gives its earlier allocation the earlier identities of the site (D17.16).
import fir;
import fir_env;
import fir_parse;
import fir_verify;
import ownership_api;
import ownership_flow;
import ownership_limits;
import ownership_local_env;
import ownership_state;
import ownership_transfer;
import std.strbuf;

struct fixture {
    fir_env.env environment;
    fir.module module;
    ownership_limits.meter meter;
    ownership_api.limit_table limits;
    ownership_api.services services;
    u64 events;
    ownership_flow.source_file_binding[4] source_files;
}

fn event(void mut* opaque, ownership_api.event_request* request)
    ownership_api.event_result {
    u64 mut* count = cast(opaque, u64 mut*);
    *count += 1;
    ownership_api.event_result mut out = ownership_api.event_result{};
    out.proof = request->current;
    out.retained = true;
    return out;
}

fn open(fixture mut* f, string lets, string@ blocks) fir.func* {
    fir_env.open(&f->environment);
    f->limits = ownership_limits.production();
    assert(ownership_limits.configure(&f->meter, &f->limits));
    f->services.budget_context = cast(&f->meter, void mut*);
    f->services.budget = ownership_limits.callback;
    f->services.event_context = cast(&f->events, void mut*);
    f->services.event = event;
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    strbuf.append(&text, "fn main.f(_1 (c): bool) -> i32 {\n");
    strbuf.append(&text, lets);
    strbuf.push(&text, '\n');
    u64 mut i = 0;
    while (i < blocks.len) {
        strbuf.append(&text, blocks[i]);
        strbuf.push(&text, '\n');
        i += 1;
    }
    strbuf.append(&text, "}\n");
    u64 before = fir_env.errors(&f->environment);
    f->module = fir_parse.parse_module(&f->environment.c.m.s, "flags.fir", strbuf.view(&text),
        fir_env.prelude(&f->environment));
    if (fir_env.errors(&f->environment) != before) {
        eprintln(strbuf.view(&text));
        panic("ownership_flow_flags_test.open: FIR text does not parse");
    }
    return fir.module_function_at(&f->module, 0);
}

fn close(fixture mut* f) void {
    fir.module_free(&f->module);
    fir_env.close(&f->environment);
}

fn input_of(fixture mut* f, fir.func* function, ownership_state.state mut* entry)
    ownership_flow.program {
    fir_verify.runtime rt = fir_verify.runtime_of(&f->environment.c.ck);
    strbuf.str_buf mut report = strbuf.create();
    defer strbuf.free(&report);
    if (!fir_verify.verify_report(function, &rt, &report)) {
        eprintln(strbuf.view(&report));
        panic("ownership_flow_flags_test: FIR fixture is invalid");
    }
    ownership_flow.program mut input = ownership_flow.program{};
    input.function = function;
    input.entry = entry;
    input.services = &f->services;
    input.limits = &f->limits;
    u64 mut files = 0;
    string filename = fir.block_at(function, 0)->term.loc.file;
    if (filename.len > 0) {
        f->source_files[0] = ownership_flow.source_file_binding{1, 1, filename};
        files = 1;
    }
    input.source_files = f->source_files[0..files];
    input.supplied_complete = true;
    input.verified_fir = true;
    return input;
}

fn id(ownership_api.entity_kind kind, u32 ordinal) ownership_api.entity_id {
    ownership_api.entity_id mut out = ownership_api.entity_id{};
    out.kind = kind;
    out.ordinal = ordinal;
    return out;
}

fn slot(u32 ordinal) ownership_api.place_path {
    return ownership_local_env.place(ordinal);
}

fn flag_of(u32 ordinal) ownership_api.entity_id {
    return id(ownership_api.entity_kind.slot, ordinal);
}

// A state with one contents fact at slot 1 and the sources that it borrows.
fn reference_in(ownership_state.state mut* s, ownership_api.source_kind kind,
    bool complete) void {
    ownership_api.source_fact source = ownership_local_env.source(7, kind,
        ownership_api.entity_id{});
    ownership_state.append_sources(s, source);
    ownership_api.borrow_relation[1] mut borrows = {
        ownership_local_env.borrow(source.key, 3, slot(1)),
    };
    borrows[0].representation_complete = complete;
    ownership_api.contents_fact mut value = ownership_local_env.reference(3, source.key,
        borrows[..]);
    value.place = slot(1);
    ownership_state.append_contents(s, value);
}

fn decides(ownership_state.state* s, bool mut* is_null) bool {
    return ownership_flow.reference_null(s, flag_of(1), is_null);
}

// The contents of a whole slot decide a null test only when they are one exact fact.
fn null_decisions() void {
    bool mut is_null = false;
    ownership_state.state mut s = ownership_state.empty();
    // No contents: the test is open.
    assert(!decides(&s, &is_null));
    // An empty owner is null.
    ownership_api.contents_fact mut empty = ownership_local_env.empty_value();
    empty.place = slot(1);
    ownership_state.append_contents(&s, empty);
    assert(decides(&s, &is_null) && is_null);
    // Two alternatives decide nothing.
    reference_in(&s, ownership_api.source_kind.heap, true);
    assert(!decides(&s, &is_null));
    ownership_state.free(&s);
    // A heap source is an allocation of at least one byte: the reference is not null.
    s = ownership_state.empty();
    reference_in(&s, ownership_api.source_kind.heap, true);
    is_null = true;
    assert(decides(&s, &is_null) && !is_null);
    // Another slot decides nothing about slot 1.
    assert(!ownership_flow.reference_null(&s, flag_of(2), &is_null));
    ownership_state.free(&s);
    // Static, caller, foreign and stack sources can be null or decide nothing here.
    ownership_api.source_kind[4] open_kinds = {ownership_api.source_kind.static_storage,
        ownership_api.source_kind.symbolic_caller, ownership_api.source_kind.trusted_foreign,
        ownership_api.source_kind.stack};
    u64 mut k = 0;
    while (k < open_kinds.len) {
        s = ownership_state.empty();
        reference_in(&s, open_kinds[k], true);
        assert(!decides(&s, &is_null));
        ownership_state.free(&s);
        k += 1;
    }
    // A borrow without its complete representation decides nothing.
    s = ownership_state.empty();
    reference_in(&s, ownership_api.source_kind.heap, false);
    assert(!decides(&s, &is_null));
    ownership_state.free(&s);
    // A borrow whose source is not in the facts decides nothing.
    s = ownership_state.empty();
    reference_in(&s, ownership_api.source_kind.heap, true);
    s.sources_len = 0;
    assert(!decides(&s, &is_null));
    ownership_state.free(&s);
    // A reference without borrows and an unknown value decide nothing.
    s = ownership_state.empty();
    ownership_api.contents_fact mut bare = ownership_api.contents_fact{};
    bare.place = slot(1);
    bare.kind = ownership_api.contents_kind.reference;
    ownership_state.append_contents(&s, bare);
    assert(!decides(&s, &is_null));
    s.contents[0].kind = ownership_api.contents_kind.unknown;
    assert(!decides(&s, &is_null));
    // An empty kind without the empty owner mark decides nothing.
    s.contents[0].kind = ownership_api.contents_kind.empty_owner;
    assert(!decides(&s, &is_null));
    ownership_state.free(&s);
    // A projected or residual place decides nothing about the whole slot.
    s = ownership_state.empty();
    empty.place = slot(1);
    empty.place.residual = true;
    ownership_state.append_contents(&s, empty);
    assert(!decides(&s, &is_null));
    ownership_state.free(&s);
    println("null decisions ok");
}

fn path_with(ownership_state.state* facts) ownership_flow.path {
    ownership_flow.path mut p = ownership_flow.path{};
    p.facts = ownership_state.clone(facts);
    p.retired = ownership_state.empty();
    p.aliases = ownership_state.empty();
    return p;
}

fn free_path(ownership_flow.path mut* p) void {
    ownership_state.free(&p->facts);
    ownership_state.free(&p->retired);
    ownership_state.free(&p->aliases);
}

fn flag_step(ownership_flow.flag_kind kind, u32 flag, u32 from, bool value)
    ownership_flow.step {
    ownership_flow.step mut s = ownership_flow.step{};
    s.kind = ownership_flow.step_kind.flag;
    s.flag = ownership_flow.flag_effect{kind, flag_of(flag), flag_of(from), value, false};
    return s;
}

fn known(ownership_flow.path* p, u32 flag, bool expected) bool {
    bool mut value = !expected;
    return ownership_flow.flag_known(p, flag_of(flag), &value) && value == expected;
}

fn unknown(ownership_flow.path* p, u32 flag) bool {
    bool mut value = false;
    return !ownership_flow.flag_known(p, flag_of(flag), &value);
}

fn apply(ownership_flow.program* in, ownership_flow.path mut* p, ownership_flow.step s)
    void {
    assert(ownership_api.successful(ownership_flow.apply_flag(in, p, &s)));
}

// Each flag step replaces what the path knows about its flag and changes no other fact.
fn flag_steps() void {
    fixture mut f = fixture{};
    string[1] blocks = {"bb0: { _0 = const i32 0; return; }"};
    fir.func* function = open(&f, "", blocks[..]);
    defer close(&f);
    ownership_state.state mut entry = ownership_state.empty();
    defer ownership_state.free(&entry);
    ownership_api.contents_fact mut empty = ownership_local_env.empty_value();
    empty.place = slot(4);
    ownership_state.append_contents(&entry, empty);
    ownership_flow.program mut input = input_of(&f, function, &entry);
    ownership_flow.path mut p = path_with(&entry);
    defer free_path(&p);
    apply(&input, &p, flag_step(ownership_flow.flag_kind.constant, 2, 2, true));
    assert(known(&p, 2, true) && p.facts.predicates_len == 1);
    // A second write replaces the value: it never adds a second one.
    apply(&input, &p, flag_step(ownership_flow.flag_kind.constant, 2, 2, false));
    assert(known(&p, 2, false) && p.facts.predicates_len == 1);
    apply(&input, &p, flag_step(ownership_flow.flag_kind.copy, 3, 2, false));
    assert(known(&p, 3, false) && known(&p, 2, false));
    apply(&input, &p, flag_step(ownership_flow.flag_kind.negate, 3, 3, false));
    assert(known(&p, 3, true));
    // A copy of an unknown flag removes the old value.
    apply(&input, &p, flag_step(ownership_flow.flag_kind.copy, 3, 9, false));
    assert(unknown(&p, 3) && known(&p, 2, false));
    apply(&input, &p, flag_step(ownership_flow.flag_kind.negate, 3, 9, false));
    assert(unknown(&p, 3));
    // `eq(x, null)` holds true for the empty owner in slot 4; `ne` holds false.
    apply(&input, &p, flag_step(ownership_flow.flag_kind.null_test, 5, 4, true));
    assert(known(&p, 5, true));
    apply(&input, &p, flag_step(ownership_flow.flag_kind.null_test, 5, 4, false));
    assert(known(&p, 5, false));
    // A slot without contents leaves the test open.
    apply(&input, &p, flag_step(ownership_flow.flag_kind.null_test, 5, 8, true));
    assert(unknown(&p, 5));
    // An address through a null pointer can fill the slot: its empty owner decides nothing.
    ownership_flow.step mut past = flag_step(ownership_flow.flag_kind.null_test, 5, 4, true);
    past.flag.offset = true;
    apply(&input, &p, past);
    assert(unknown(&p, 5));
    // The same test of a reference to a heap source still decides "not null".
    ownership_state.state mut heap = ownership_state.empty();
    defer ownership_state.free(&heap);
    reference_in(&heap, ownership_api.source_kind.heap, true);
    ownership_flow.path mut q = path_with(&heap);
    defer free_path(&q);
    ownership_flow.step mut through = flag_step(ownership_flow.flag_kind.null_test, 5, 1, true);
    through.flag.offset = true;
    apply(&input, &q, through);
    assert(known(&q, 5, false));
    // With the mark, other sources and two alternatives still decide nothing.
    ownership_api.source_kind[3] open_kinds = {ownership_api.source_kind.static_storage,
        ownership_api.source_kind.symbolic_caller, ownership_api.source_kind.trusted_foreign};
    u64 mut k = 0;
    while (k < open_kinds.len) {
        ownership_state.state mut other = ownership_state.empty();
        reference_in(&other, open_kinds[k], true);
        ownership_flow.path mut o = path_with(&other);
        apply(&input, &o, through);
        assert(unknown(&o, 5));
        free_path(&o);
        ownership_state.free(&other);
        k += 1;
    }
    ownership_state.state mut both = ownership_state.empty();
    defer ownership_state.free(&both);
    ownership_api.contents_fact mut gone = ownership_local_env.empty_value();
    gone.place = slot(1);
    ownership_state.append_contents(&both, gone);
    reference_in(&both, ownership_api.source_kind.heap, true);
    ownership_flow.path mut either = path_with(&both);
    defer free_path(&either);
    apply(&input, &either, through);
    assert(unknown(&either, 5));
    // The mark changes nothing for a flag step of another kind.
    ownership_flow.step mut constant = flag_step(ownership_flow.flag_kind.constant, 6, 6, true);
    constant.flag.offset = true;
    apply(&input, &either, constant);
    assert(known(&either, 6, true));
    apply(&input, &p, flag_step(ownership_flow.flag_kind.clear, 2, 2, true));
    assert(unknown(&p, 2) && p.facts.predicates_len == 0);
    assert(p.facts.contents_len == 1);
    // The predicate of a flag names the flag slot and its own key.
    apply(&input, &p, flag_step(ownership_flow.flag_kind.constant, 6, 6, true));
    ownership_api.predicate_atom atom = p.facts.predicates[0];
    assert(atom.kind == ownership_api.predicate_kind.equality);
    assert(atom.key.kind == ownership_api.entity_kind.predicate && atom.key.ordinal == 6);
    assert(atom.lower.kind == ownership_api.fact_kind.exact && atom.lower.value == 1);
    assert(atom.upper.value == 1 && atom.right.kind == ownership_api.entity_kind.none);
    // At the bound P the path records one lost fact and keeps no value.
    ownership_api.limit_table mut small = f.limits;
    small.p = 1;
    input.limits = &small;
    apply(&input, &p, flag_step(ownership_flow.flag_kind.constant, 7, 7, true));
    assert(unknown(&p, 7) && p.facts.predicates_len == 1 && p.facts.losses_len == 1);
    assert(p.facts.losses[0].category == ownership_api.limit_category.p);
    apply(&input, &p, flag_step(ownership_flow.flag_kind.constant, 7, 7, false));
    assert(p.facts.losses_len == 1);
    // At the bound, a write of the flag that the path knows replaces its value.
    apply(&input, &p, flag_step(ownership_flow.flag_kind.constant, 6, 6, false));
    assert(known(&p, 6, false));
    println("flag steps ok");
}

fn solve_flags(fixture mut* f, fir.func* function, ownership_flow.step@ steps,
    ownership_flow.flag_edge@ edges) ownership_flow.analysis {
    ownership_state.state mut entry = ownership_state.empty();
    defer ownership_state.free(&entry);
    ownership_flow.program mut input = input_of(f, function, &entry);
    input.steps = steps;
    input.flags = edges;
    return ownership_flow.solve(&input);
}

// The switch of bb0 tests the flag c, parameter 1. bb3 tests it again.
string[6] TWICE = {
    "bb0: { switch(copy _1) -> [true: bb1, otherwise: bb2]; }",
    "bb1: { goto bb3; }",
    "bb2: { goto bb3; }",
    "bb3: { switch(copy _1) -> [true: bb4, otherwise: bb5]; }",
    "bb4: { _0 = const i32 1; return; }",
    "bb5: { _0 = const i32 2; return; }",
};

// `keep` keeps the value of the first switch for the second. `written` stores true on the
// path through bb2, which knew false.
fn edges_case(bool keep, bool written) void {
    fixture mut f = fixture{};
    fir.func* function = open(&f, "", TWICE[..]);
    defer close(&f);
    ownership_flow.flag_edge[4] edges = {
        ownership_flow.flag_edge{0, 0, flag_of(1), true, keep},
        ownership_flow.flag_edge{0, 1, flag_of(1), false, keep},
        ownership_flow.flag_edge{3, 0, flag_of(1), true, false},
        ownership_flow.flag_edge{3, 1, flag_of(1), false, false},
    };
    ownership_flow.step[1] mut steps = {flag_step(ownership_flow.flag_kind.constant, 1, 1,
        true)};
    steps[0].block = 2;
    steps[0].operation.block = 2;
    ownership_flow.analysis mut result = solve_flags(&f, function,
        written ? steps[..] : steps[0..0], edges[..]);
    defer ownership_flow.free(&result);
    assert(result.failures == 0);
    if (written) {
        // Both paths know true at bb3, so they are one, and the otherwise arm is refuted.
        assert(result.blocks[3].len == 1 && result.blocks[4].len == 1);
        assert(result.blocks[5].len == 0 && result.normal_returns == 1);
    } else {
        // A kept value makes two alternatives at bb3. Each reaches only its own arm.
        assert(result.blocks[3].len == (keep ? cast(2, u64) : cast(1, u64)));
        assert(result.blocks[4].len == 1 && result.blocks[5].len == 1);
        assert(result.normal_returns == 2);
    }
    // An edge without keep removes the value, so no path at bb4 or bb5 knows the flag.
    u32 mut b = 4;
    while (b <= 5) {
        u64 mut i = 0;
        while (i < result.blocks[cast(b, u64)].len) {
            assert(result.blocks[cast(b, u64)].paths[i].facts.predicates_len == 0);
            i += 1;
        }
        b += 1;
    }
}

// At the bound P an edge cannot keep the value: it records one lost fact, and the second
// switch then reaches both arms.
fn bound_case() void {
    fixture mut f = fixture{};
    fir.func* function = open(&f, "", TWICE[..]);
    defer close(&f);
    ownership_state.state mut entry = ownership_state.empty();
    defer ownership_state.free(&entry);
    ownership_api.predicate_atom mut other = ownership_api.predicate_atom{};
    other.kind = ownership_api.predicate_kind.nullness;
    other.left = id(ownership_api.entity_kind.value, 9);
    ownership_state.append_predicates(&entry, other);
    ownership_flow.program mut input = input_of(&f, function, &entry);
    ownership_api.limit_table mut small = f.limits;
    small.p = 1;
    input.limits = &small;
    ownership_flow.flag_edge[4] edges = {
        ownership_flow.flag_edge{0, 0, flag_of(1), true, true},
        ownership_flow.flag_edge{0, 1, flag_of(1), false, true},
        ownership_flow.flag_edge{3, 0, flag_of(1), true, false},
        ownership_flow.flag_edge{3, 1, flag_of(1), false, false},
    };
    input.flags = edges[..];
    ownership_flow.analysis mut result = ownership_flow.solve(&input);
    defer ownership_flow.free(&result);
    assert(result.failures == 0 && result.normal_returns == 2);
    // Both paths reach bb3 with one lost P fact and no flag value, so they are one path.
    assert(result.blocks[3].len == 1);
    ownership_flow.path* p = &result.blocks[3].paths[0];
    assert(p->facts.predicates_len == 1 && p->facts.losses_len == 1);
    assert(p->facts.losses[0].category == ownership_api.limit_category.p);
    assert(p->facts.losses[0].relation.ordinal == 1);
    assert(result.blocks[4].len == 1 && result.blocks[5].len == 1);
}

// Two edges of one switch can reach one block. Each edge refines its own copy of the path.
fn shared_target() void {
    fixture mut f = fixture{};
    string[2] blocks = {
        "bb0: { _2 = const false; switch(copy _2) -> [true: bb1, otherwise: bb1]; }",
        "bb1: { _0 = const i32 1; return; }",
    };
    fir.func* function = open(&f, "let _2: bool;", blocks[..]);
    defer close(&f);
    ownership_flow.flag_edge[2] edges = {
        ownership_flow.flag_edge{0, 0, flag_of(2), true, true},
        ownership_flow.flag_edge{0, 1, flag_of(2), false, true},
    };
    ownership_flow.step[1] steps = {flag_step(ownership_flow.flag_kind.constant, 2, 2,
        false)};
    ownership_flow.analysis mut result = solve_flags(&f, function, steps[..], edges[..]);
    defer ownership_flow.free(&result);
    // The true arm is refuted, so bb1 holds the one path of the otherwise arm.
    assert(result.blocks[1].len == 1 && result.normal_returns == 1);
    assert(known(&result.blocks[1].paths[0], 2, false));
}

// Each flag step charges one W unit of transfer work for each path that applies it.
fn step_work() void {
    fixture mut f = fixture{};
    string[1] blocks = {"bb0: { _0 = const i32 0; return; }"};
    fir.func* function = open(&f, "", blocks[..]);
    defer close(&f);
    ownership_flow.flag_edge[1] spare = {};
    ownership_flow.step[3] steps = {
        flag_step(ownership_flow.flag_kind.constant, 2, 2, true),
        flag_step(ownership_flow.flag_kind.copy, 3, 2, false),
        flag_step(ownership_flow.flag_kind.clear, 2, 2, false),
    };
    u64 mut used = 0;
    u64 mut k = 0;
    while (k <= 3) {
        assert(ownership_limits.configure(&f.meter, &f.limits));
        ownership_flow.step mut@ own ordered = new(ownership_flow.step, k);
        defer del(ordered);
        u64 mut i = 0;
        while (i < k) {
            ordered[i] = steps[i];
            ordered[i].order = cast(i, u32);
            i += 1;
        }
        ownership_flow.analysis mut result = solve_flags(&f, function, ordered[..],
            spare[0..0]);
        assert(result.failures == 0 && result.normal_returns == 1);
        ownership_flow.free(&result);
        u64 now = f.meter.used.w;
        if (k > 0) { assert(now == used + 1); }
        used = now;
        k += 1;
    }
}

// A known value refutes the other arm, keep carries a value to a later switch, and an edge
// without keep removes it.
fn flag_edges() void {
    fixture mut f = fixture{};
    string[3] blocks = {
        "bb0: { _2 = const true; switch(copy _2) -> [true: bb1, otherwise: bb2]; }",
        "bb1: { _0 = const i32 1; return; }",
        "bb2: { _0 = const i32 2; return; }",
    };
    fir.func* function = open(&f, "let _2: bool;", blocks[..]);
    defer close(&f);
    ownership_flow.flag_edge[2] edges = {
        ownership_flow.flag_edge{0, 0, flag_of(2), true, true},
        ownership_flow.flag_edge{0, 1, flag_of(2), false, true},
    };
    ownership_flow.step[1] steps = {flag_step(ownership_flow.flag_kind.constant, 2, 2, true)};
    ownership_flow.analysis mut known_true = solve_flags(&f, function, steps[..], edges[..]);
    assert(known_true.failures == 0 && known_true.normal_returns == 1);
    assert(known_true.blocks[1].len == 1 && known_true.blocks[2].len == 0);
    assert(known_true.blocks[1].paths[0].facts.predicates_len == 1);
    ownership_flow.free(&known_true);
    // An unknown flag reaches both arms, and each keeps the value of its arm.
    ownership_flow.analysis mut open_flag = solve_flags(&f, function, steps[0..0], edges[..]);
    assert(open_flag.normal_returns == 2);
    assert(open_flag.blocks[1].len == 1 && open_flag.blocks[2].len == 1);
    ownership_flow.path* yes = &open_flag.blocks[1].paths[0];
    ownership_flow.path* no = &open_flag.blocks[2].paths[0];
    assert(known(yes, 2, true) && known(no, 2, false));
    ownership_flow.free(&open_flag);
    // Without keep, the edges add nothing.
    ownership_flow.flag_edge[2] dropped = {
        ownership_flow.flag_edge{0, 0, flag_of(2), true, false},
        ownership_flow.flag_edge{0, 1, flag_of(2), false, false},
    };
    ownership_flow.analysis mut plain = solve_flags(&f, function, steps[0..0], dropped[..]);
    assert(plain.blocks[1].paths[0].facts.predicates_len == 0);
    assert(plain.blocks[2].paths[0].facts.predicates_len == 0);
    ownership_flow.free(&plain);
    edges_case(true, false);
    edges_case(false, false);
    edges_case(true, true);
    bound_case();
    shared_target();
    step_work();
    println("flag edges ok");
}

fn invalid(fixture mut* f, fir.func* function, ownership_flow.step@ steps,
    ownership_flow.flag_edge@ edges) bool {
    ownership_flow.analysis mut result = solve_flags(f, function, steps, edges);
    defer ownership_flow.free(&result);
    return result.failures == 1 && result.blocks.len == 0 &&
        result.first_failure.terminal.reason == ownership_api.incomplete_reason.invalid_input;
}

// Each flag names a slot, and each flag edge names a switch target that exists.
fn invalid_inputs() void {
    fixture mut f = fixture{};
    fir.func* function = open(&f, "", TWICE[..]);
    defer close(&f);
    ownership_flow.flag_edge[1] spare = {};
    ownership_flow.flag_edge@ none = spare[0..0];
    ownership_flow.step[1] mut steps = {flag_step(ownership_flow.flag_kind.copy, 2, 2, true)};
    steps[0].flag.from = id(ownership_api.entity_kind.value, 2);
    assert(invalid(&f, function, steps[..], none));
    steps[0].flag.from = flag_of(2);
    assert(!invalid(&f, function, steps[..], none));
    steps[0].flag.flag = id(ownership_api.entity_kind.value, 2);
    assert(invalid(&f, function, steps[..], none));
    // A constant and a clear need no source slot.
    steps[0] = flag_step(ownership_flow.flag_kind.clear, 2, 2, true);
    steps[0].flag.from = ownership_api.entity_id{};
    assert(!invalid(&f, function, steps[..], none));
    ownership_flow.flag_edge[1] mut edges = {ownership_flow.flag_edge{0, 1, flag_of(2), false,
        false}};
    assert(!invalid(&f, function, steps[0..0], edges[..]));
    // A target index past the otherwise target, a block that does not switch, a block that
    // does not exist and a flag that is no slot are invalid.
    edges[0].target_index = 2;
    assert(invalid(&f, function, steps[0..0], edges[..]));
    edges[0] = ownership_flow.flag_edge{1, 0, flag_of(2), false, false};
    assert(invalid(&f, function, steps[0..0], edges[..]));
    edges[0] = ownership_flow.flag_edge{9, 0, flag_of(2), false, false};
    assert(invalid(&f, function, steps[0..0], edges[..]));
    edges[0] = ownership_flow.flag_edge{0, 0, id(ownership_api.entity_kind.value, 2), true,
        false};
    assert(invalid(&f, function, steps[0..0], edges[..]));
    println("invalid inputs ok");
}

fn local_step(ownership_local_env.env mut* e, ownership_transfer.action kind,
    u32 slot_number, u32 block, u32 gap, u32 order) ownership_flow.step {
    ownership_flow.step mut out = ownership_flow.step{};
    out.kind = ownership_flow.step_kind.local_effect;
    out.block = block;
    out.gap = gap;
    out.order = order;
    out.local = ownership_local_env.req(e, kind, slot_number, slot_number);
    out.local.operation.block = block;
    e->event_bindings[e->event_bindings_len - 1].operation = out.local.operation;
    out.operation = out.local.operation;
    out.source = out.local.source_position;
    return out;
}

// The allocation step of slot 2 at gap `gap` of bb2: site 1, source 101 and value version 1.
// Its earlier identities are allocation 51, source 151, value 51 and relation 51.
fn site_step(ownership_local_env.env mut* e, u32 gap, bool earlier,
    ownership_api.borrow_relation mut@ borrow) ownership_flow.step {
    ownership_flow.step mut s = local_step(e, ownership_transfer.action.allocation, 2, 2, gap,
        0);
    s.local.allocation = ownership_local_env.allocation(1, 1, 2, 1);
    s.local.fresh_source = ownership_local_env.source(101, ownership_api.source_kind.heap,
        s.local.allocation.key);
    s.local.source_key = s.local.fresh_source.key;
    borrow[0] = ownership_local_env.borrow(s.local.fresh_source.key, 1, slot(2));
    s.local.value = ownership_local_env.reference(1, s.local.fresh_source.key, borrow);
    if (earlier) {
        s.earlier = ownership_flow.site_identity{id(ownership_api.entity_kind.allocation, 51),
            id(ownership_api.entity_kind.source, 151), id(ownership_api.entity_kind.value, 51),
            id(ownership_api.entity_kind.relation, 51)};
    }
    return s;
}

fn moved(ownership_local_env.env mut* e, u32 from, u32 to, u32 gap) ownership_flow.step {
    ownership_flow.step mut s = local_step(e, ownership_transfer.action.move_owner, from, 2,
        gap, 0);
    s.local.destination = slot(to);
    return s;
}

fn copied(ownership_local_env.env mut* e, u32 from, u32 to, u32 gap) ownership_flow.step {
    ownership_flow.step mut s = local_step(e, ownership_transfer.action.copy, from, 2, gap, 0);
    s.local.destination = slot(to);
    return s;
}

fn released(ownership_local_env.env mut* e, u32 owner, u32 gap) ownership_flow.step {
    ownership_flow.step mut s = local_step(e, ownership_transfer.action.release, owner, 2,
        gap, 0);
    s.local.leaves_empty_proved = true;
    return s;
}

struct site_result {
    u64 failures;
    u64 returns;
    // At the exit block: the most allocations and the most retired allocations of one path,
    // and whether a path holds the earlier allocation with each fact renamed.
    u64 allocations;
    u64 retired;
    bool renamed;
}

// Whether path `p` holds allocation 51 with source 151, its history and a view of it.
fn renamed_in(ownership_flow.path* p) bool {
    u64 a = ownership_state.allocation_index(&p->facts,
        id(ownership_api.entity_kind.allocation, 51));
    u64 s = ownership_state.source_index(&p->facts, id(ownership_api.entity_kind.source, 151));
    if (a == 18446744073709551615 || s == 18446744073709551615) { return false; }
    ownership_api.allocation_fact earlier = p->facts.allocations[a];
    if (earlier.site.ordinal != 1 || earlier.history.len == 0 ||
        earlier.validity != ownership_api.validity_kind.live ||
        p->facts.sources[s].allocation.ordinal != 51) { return false; }
    u64 mut h = 0;
    while (h < earlier.history.len) {
        if (earlier.history[h].allocation.ordinal != 51) { return false; }
        h += 1;
    }
    u64 mut views = 0;
    u64 mut c = 0;
    while (c < p->facts.contents_len) {
        ownership_api.contents_fact value = p->facts.contents[c];
        if (value.borrows.len == 1 && value.borrows[0].source.ordinal == 151) {
            if (value.borrows[0].value_version.ordinal != 51 ||
                value.borrows[0].key.ordinal != 51 || value.value_version.ordinal != 51) {
                return false;
            }
            views += 1;
        }
        if (value.borrows.len == 1 && value.borrows[0].source.ordinal == 101 &&
            value.value_version.ordinal != 1) { return false; }
        c += 1;
    }
    // The owner y and the view v name the earlier allocation.
    return views == 2;
}

// One loop over bb2, which allocates into x (slot 2). The shapes:
// 0: y releases its value, takes x, and v views y; then x allocates again.
// 1: z takes y, y takes x, and x allocates: y and z keep two earlier allocations live.
// 2: v views y, y releases its value and takes x, and x allocates: v keeps a released one.
fn site_loop(bool earlier, u32 shape) site_result {
    fixture mut f = fixture{};
    // The first entry declares two more locals. Block bb2 takes the entries 3 and 4.
    string[6] mut blocks = {
        "let _4 (v): i32 mut*; let _5 (z): i32 mut* own;",
        "bb0: { goto bb1; }",
        "bb1: { switch(copy _1) -> [true: bb2, otherwise: bb3]; }",
        "",
        "_2 = alloc<i32>(const u64 1); goto bb1; }",
        "bb3: { _0 = const i32 0; return; }",
    };
    if (shape == 0) {
        blocks[3] = "bb2: { del(move _3); _3 = move _2; _4 = copy _3;";
    } else if (shape == 1) {
        blocks[3] = "bb2: { _5 = move _3; _3 = move _2;";
    } else {
        blocks[3] = "bb2: { _4 = copy _3; del(move _3); _3 = move _2;";
    }
    fir.func* function = open(&f, "let _2 (x): i32 mut* own; let _3 (y): i32 mut* own;",
        blocks[..]);
    defer close(&f);
    ownership_local_env.env mut e = ownership_local_env.env{};
    ownership_local_env.init(&e);
    defer ownership_local_env.free(&e);
    u32 mut n = 2;
    while (n <= 5) {
        ownership_api.contents_fact mut empty = ownership_local_env.empty_value();
        empty.place = slot(n);
        if (n != 4) { ownership_state.append_contents(&e.state, empty); }
        n += 1;
    }
    ownership_api.borrow_relation[1] mut borrow = {};
    ownership_flow.step[4] mut steps = {};
    u64 mut count = 4;
    u64 mut site = 3;
    if (shape == 0) {
        steps[0] = released(&e, 3, 0);
        steps[1] = moved(&e, 2, 3, 1);
        steps[2] = copied(&e, 3, 4, 2);
        steps[3] = site_step(&e, 3, earlier, borrow[..]);
    } else if (shape == 1) {
        steps[0] = moved(&e, 3, 5, 0);
        steps[1] = moved(&e, 2, 3, 1);
        steps[2] = site_step(&e, 2, earlier, borrow[..]);
        count = 3;
        site = 2;
    } else {
        steps[0] = copied(&e, 3, 4, 0);
        steps[1] = released(&e, 3, 1);
        steps[2] = moved(&e, 2, 3, 2);
        steps[3] = site_step(&e, 3, earlier, borrow[..]);
    }
    ownership_flow.program mut input = input_of(&f, function, &e.state);
    input.services = &e.service;
    input.steps = steps[0..count];
    ownership_flow.event_binding[1] events = {ownership_flow.event_binding{
        steps[site].operation, ownership_api.event_kind.incomplete_proof,
        steps[site].local.allocation.key, id(ownership_api.entity_kind.event, 90)}};
    input.events = events[..];
    ownership_flow.analysis mut result = ownership_flow.solve(&input);
    defer ownership_flow.free(&result);
    site_result mut out = site_result{.failures = result.failures,
        .returns = result.normal_returns};
    u64 mut i = 0;
    while (i < result.blocks[3].len) {
        ownership_flow.path* p = &result.blocks[3].paths[i];
        if (p->facts.allocations_len > out.allocations) {
            out.allocations = p->facts.allocations_len;
        }
        if (p->retired.allocations_len > out.retired) {
            out.retired = p->retired.allocations_len;
        }
        if (renamed_in(p)) { out.renamed = true; }
        i += 1;
    }
    return out;
}

fn site_identities() void {
    // The allocation in y has a view when x allocates again. One identity cannot name both
    // allocations: the path stops at the allocation.
    site_result one = site_loop(false, 0);
    assert(one.failures == 1);
    // With earlier identities, the allocation in y, its view and its history take them. The
    // next iteration releases it, and its view moves to the new allocation, so it leaves to
    // the retired state and the loop reaches its fixed point.
    site_result two = site_loop(true, 0);
    assert(two.failures == 0 && two.returns >= 3);
    assert(two.allocations == 2 && two.renamed && two.retired == 1);
    // Two earlier allocations stay live in y and z: the earlier identities hold one of them.
    site_result three = site_loop(true, 1);
    assert(three.failures >= 1 && !three.renamed);
    // The view in v keeps the released earlier allocation: the identities stay taken.
    site_result stale = site_loop(true, 2);
    assert(stale.failures >= 1);
    println("site identities ok");
}

fn value_id(u32 ordinal) ownership_api.entity_id {
    return id(ownership_api.entity_kind.value, ordinal);
}

// The facts of one live allocation of site 1 in slot 3 and its view in slot 4: allocation 1,
// source 101, value version 1, relation 1, one history entry and a null fact on the value. A
// symbolic length names the value version.
fn site_facts(ownership_state.state mut* s, bool symbolic) void {
    ownership_api.allocation_fact mut a = ownership_local_env.allocation(1, 1, 3, 1);
    ownership_api.history_fact[1] history = {ownership_api.history_fact{.allocation = a.key,
        .kind = ownership_api.effect_kind.transfer}};
    a.history = history[..];
    ownership_api.scalar_fact length = ownership_api.scalar_fact{
        .kind = ownership_api.fact_kind.symbolic, .symbol = value_id(1)};
    if (symbolic) { a.logical_length = length; }
    ownership_state.append_allocations(s, a);
    ownership_api.source_fact source = ownership_local_env.source(101,
        ownership_api.source_kind.heap, a.key);
    ownership_state.append_sources(s, source);
    u32 mut n = 3;
    while (n <= 4) {
        ownership_api.borrow_relation[1] mut borrows = {
            ownership_local_env.borrow(source.key, 1, slot(n)),
        };
        borrows[0].range.source = source.key;
        ownership_api.contents_fact mut value = ownership_local_env.reference(1, source.key,
            borrows[..]);
        value.place = slot(n);
        if (symbolic) { value.span_length = length; }
        ownership_state.append_contents(s, value);
        n += 1;
    }
    ownership_api.predicate_atom mut atom = ownership_api.predicate_atom{};
    atom.kind = ownership_api.predicate_kind.nullness;
    atom.left = value_id(1);
    atom.lower = ownership_api.scalar_fact{.kind = ownership_api.fact_kind.exact, .value = 1};
    ownership_state.append_predicates(s, atom);
}

// The allocation of slot 2 by an earlier allocation of site 1: the facts that site_facts
// built. `earlier` names allocation 51, source 151, value 51 and relation 51.
struct site_fixture {
    fixture f;
    ownership_local_env.env e;
    ownership_flow.program input;
    ownership_flow.step s;
    ownership_api.borrow_relation[1] borrow;
    ownership_flow.event_binding[1] events;
}

fn site_open(site_fixture mut* x, bool earlier) void {
    string[1] blocks = {"bb0: { _0 = const i32 0; return; }"};
    fir.func* function = open(&x->f, "", blocks[..]);
    ownership_local_env.init(&x->e);
    x->input = input_of(&x->f, function, &x->e.state);
    x->input.services = &x->e.service;
    x->s = site_step(&x->e, 0, earlier, x->borrow[..]);
    x->events[0] = ownership_flow.event_binding{x->s.operation,
        ownership_api.event_kind.incomplete_proof, x->s.local.allocation.key,
        id(ownership_api.entity_kind.event, 90)};
    x->input.events = x->events[..];
}

fn site_close(site_fixture mut* x) void {
    ownership_local_env.free(&x->e);
    close(&x->f);
}

fn separated(site_fixture mut* x, ownership_flow.path mut* p) bool {
    return ownership_api.successful(ownership_flow.retire_released_site(&x->input, p, &x->s));
}

// Whether the last event says that the site identities stay one.
fn refused(site_fixture* x, ownership_api.proof_status proof) bool {
    return !ownership_api.successful(proof) && x->e.counts.last_reason ==
        ownership_api.incomplete_reason.missing_path && x->e.counts.last_relation.ordinal == 1 &&
        x->e.counts.last_relation.kind == ownership_api.entity_kind.allocation;
}

fn contents_of(ownership_state.state* s, u32 slot_number) ownership_api.contents_fact {
    u64 mut i = 0;
    while (i < s->contents_len) {
        if (s->contents[i].place.root.ordinal == slot_number) { return s->contents[i]; }
        i += 1;
    }
    panic("ownership_flow_flags_test: no contents for the slot");
}

// The earlier allocation keeps its owner, view, history and lengths under the new keys.
fn renames(bool symbolic) void {
    site_fixture mut x = site_fixture{};
    site_open(&x, true);
    defer site_close(&x);
    site_facts(&x.e.state, symbolic);
    // A view in slot 9 of another source names no identity of the site.
    ownership_api.borrow_relation[1] other = {
        ownership_local_env.borrow(id(ownership_api.entity_kind.source, 300), 7, slot(9)),
    };
    ownership_api.contents_fact mut unrelated = ownership_local_env.reference(7,
        other[0].source, other[..]);
    unrelated.place = slot(9);
    ownership_state.append_contents(&x.e.state, unrelated);
    ownership_flow.path mut p = path_with(&x.e.state);
    defer free_path(&p);
    ownership_api.borrow_relation* kept = &contents_of(&p.facts, 9).borrows[0];
    ownership_api.borrow_relation* changed = &contents_of(&p.facts, 3).borrows[0];
    u64 charges = x.e.counts.charges;
    assert(separated(&x, &p));
    // One W unit pays for the rename.
    assert(x.e.counts.charges == charges + 1);
    ownership_state.state* facts = &p.facts;
    // The rename gives new borrow storage only to the facts that name the site.
    assert(&contents_of(facts, 9).borrows[0] == kept);
    assert(&contents_of(facts, 3).borrows[0] != changed);
    assert(contents_of(facts, 9).borrows[0].source.ordinal == 300);
    assert(contents_of(facts, 9).value_version.ordinal == 7);
    assert(facts->allocations_len == 1 && facts->sources_len == 1);
    ownership_api.allocation_fact a = facts->allocations[0];
    assert(a.key.ordinal == 51 && a.site.ordinal == 1 && a.owner.place.root.ordinal == 3);
    assert(a.history.len == 1 && a.history[0].allocation.ordinal == 51);
    assert(a.obligation && a.validity == ownership_api.validity_kind.live);
    assert(facts->sources[0].key.ordinal == 151 && facts->sources[0].allocation.ordinal == 51);
    u32 mut n = 3;
    while (n <= 4) {
        ownership_api.contents_fact value = contents_of(facts, n);
        assert(value.value_version.ordinal == 51 && value.borrows.len == 1);
        ownership_api.borrow_relation b = value.borrows[0];
        assert(b.source.ordinal == 151 && b.range.source.ordinal == 151);
        assert(b.key.ordinal == 51 && b.value_version.ordinal == 51);
        assert(b.containing.root.ordinal == n);
        if (symbolic) {
            assert(value.span_length.kind == ownership_api.fact_kind.symbolic);
            assert(value.span_length.symbol.ordinal == 51);
        } else {
            assert(value.span_length.kind == ownership_api.fact_kind.exact);
        }
        n += 1;
    }
    if (symbolic) {
        assert(a.logical_length.symbol.ordinal == 51);
    } else {
        assert(a.logical_length.kind == ownership_api.fact_kind.exact);
    }
    assert(facts->predicates_len == 1 && facts->predicates[0].left.ordinal == 51);
    // The input state still names the site identities: the path owns renamed copies.
    assert(x.e.state.allocations[0].key.ordinal == 1);
    assert(x.e.state.contents[0].borrows[0].source.ordinal == 101);
    assert(p.retired.allocations_len == 0);
}

// An allocation that holds the earlier identities leaves first when it is released and no
// contents fact borrows it. It keeps its record in the retired state.
fn retires_released_earlier() void {
    site_fixture mut x = site_fixture{};
    site_open(&x, true);
    defer site_close(&x);
    site_facts(&x.e.state, false);
    ownership_api.allocation_fact mut old = ownership_local_env.allocation(51, 1, 3, 1);
    old.obligation = false;
    old.validity = ownership_api.validity_kind.released;
    old.owner = ownership_api.owner_location{};
    ownership_state.append_allocations(&x.e.state, old);
    ownership_api.source_fact mut gone = ownership_local_env.source(151,
        ownership_api.source_kind.heap, old.key);
    gone.validity = ownership_api.validity_kind.released;
    ownership_state.append_sources(&x.e.state, gone);
    ownership_flow.path mut p = path_with(&x.e.state);
    defer free_path(&p);
    assert(separated(&x, &p));
    assert(p.retired.allocations_len == 1 && p.retired.allocations[0].key.ordinal == 51);
    assert(p.retired.allocations[0].validity == ownership_api.validity_kind.released);
    assert(p.facts.allocations_len == 1 && p.facts.allocations[0].key.ordinal == 51);
    assert(p.facts.allocations[0].validity == ownership_api.validity_kind.live);
    assert(p.facts.sources_len == 1 && p.facts.sources[0].key.ordinal == 151);
    assert(p.facts.sources[0].validity == ownership_api.validity_kind.live);
    // The retirement records one lost R fact for the site.
    assert(p.facts.losses_len == 1 && p.facts.losses[0].category == ownership_api.limit_category.r);
    assert(p.facts.losses[0].relation.ordinal == 1);
}

// A released allocation of the site that nothing borrows leaves, with or without earlier
// identities, and the identities stay unused.
fn retires_without_views(bool earlier) void {
    site_fixture mut x = site_fixture{};
    site_open(&x, earlier);
    defer site_close(&x);
    ownership_api.allocation_fact mut a = ownership_local_env.allocation(1, 1, 3, 1);
    a.obligation = false;
    a.validity = ownership_api.validity_kind.released;
    ownership_state.append_allocations(&x.e.state, a);
    ownership_api.source_fact mut source = ownership_local_env.source(101,
        ownership_api.source_kind.heap, a.key);
    source.validity = ownership_api.validity_kind.released;
    ownership_state.append_sources(&x.e.state, source);
    ownership_flow.path mut p = path_with(&x.e.state);
    defer free_path(&p);
    assert(separated(&x, &p));
    assert(p.facts.allocations_len == 0 && p.facts.sources_len == 0);
    assert(p.retired.allocations_len == 1 && p.retired.allocations[0].key.ordinal == 1);
}

fn site_renames() void {
    renames(false);
    renames(true);
    retires_released_earlier();
    retires_without_views(true);
    retires_without_views(false);
    println("site renames ok");
}

// One case that refuses the separation. `shape` selects what the facts hold besides the live
// allocation of the site and its view.
fn refusal(u32 shape) bool {
    site_fixture mut x = site_fixture{};
    site_open(&x, shape != 0);
    defer site_close(&x);
    site_facts(&x.e.state, false);
    if (shape == 1 || shape == 2 || shape == 3) {
        // An allocation that holds the earlier identities: live in slot 5, released with a
        // view in slot 6, or without its source.
        ownership_api.allocation_fact mut old = ownership_local_env.allocation(51, 1, 5, 1);
        if (shape == 2) {
            old.obligation = false;
            old.validity = ownership_api.validity_kind.released;
        }
        ownership_state.append_allocations(&x.e.state, old);
        if (shape != 3) {
            ownership_api.source_fact mut gone = ownership_local_env.source(151,
                ownership_api.source_kind.heap, old.key);
            if (shape == 2) { gone.validity = ownership_api.validity_kind.released; }
            ownership_state.append_sources(&x.e.state, gone);
        }
        if (shape == 2) {
            ownership_api.borrow_relation[1] borrows = {
                ownership_local_env.borrow(id(ownership_api.entity_kind.source, 151), 51,
                    slot(6)),
            };
            ownership_api.contents_fact mut view = ownership_local_env.reference(51,
                borrows[0].source, borrows[..]);
            view.place = slot(6);
            ownership_state.append_contents(&x.e.state, view);
        }
    } else if (shape == 4) {
        // A fact that already names the earlier value version.
        ownership_api.contents_fact mut stray = ownership_local_env.empty_value();
        stray.place = slot(7);
        stray.value_version = value_id(51);
        ownership_state.append_contents(&x.e.state, stray);
    } else if (shape == 5) {
        ownership_api.guard_fact guard = ownership_api.guard_fact{
            .key = id(ownership_api.entity_kind.guard, 1)};
        ownership_state.append_guards(&x.e.state, guard);
    }
    ownership_flow.path mut p = path_with(&x.e.state);
    defer free_path(&p);
    if (shape == 6) {
        ownership_api.contents_fact mut alias = ownership_local_env.empty_value();
        alias.place = slot(8);
        ownership_state.append_contents(&p.aliases, alias);
    }
    if (shape == 7) { x.e.counts.deny = true; }
    ownership_api.proof_status proof = ownership_flow.retire_released_site(&x.input, &p, &x.s);
    if (shape == 7) {
        // The W charge of the rename is refused: the path stops before any rename.
        return !ownership_api.successful(proof) && p.facts.allocations[0].key.ordinal == 1;
    }
    // A refusal changes no fact of the path.
    return refused(&x, proof) && p.facts.allocations[0].key.ordinal == 1 &&
        p.facts.sources[0].key.ordinal == 101;
}

fn site_refusals() void {
    // Without earlier identities a live allocation keeps the one identity.
    assert(refusal(0));
    // A live allocation already holds the earlier identities.
    assert(refusal(1));
    // A view keeps the released holder of the earlier identities.
    assert(refusal(2));
    // The holder has no source fact.
    assert(refusal(3));
    // Another fact names the earlier value version.
    assert(refusal(4));
    // Guarded alternatives and place aliases are outside the rename.
    assert(refusal(5));
    assert(refusal(6));
    // A refused W charge.
    assert(refusal(7));
    println("site refusals ok");
}

fn main() i32 {
    null_decisions();
    flag_steps();
    flag_edges();
    invalid_inputs();
    site_identities();
    site_renames();
    site_refusals();
    return 0;
}
