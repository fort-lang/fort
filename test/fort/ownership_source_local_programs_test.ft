// The borrowed return proves its local part; its caller needs summaries.
fn ex07() void {
    string[11] lines = {
        "fn identity(i32* p) i32* {",
        "    return p;",
        "}",
        "fn demo() i32 {",
        "    i32 mut* own owner = new(i32);",
        "    *owner = 9;",
        "    i32* view = identity(owner);",
        "    i32 value = *view;",
        "    del(owner);",
        "    return value;",
        "}",
    };
    ownership_source_env.env mut e = ownership_source_env.env{};
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    analyze(&e, &text, lines[..]);
    defer ownership_source_env.close(&e);
    proved(&e, "identity");
    outside(&e, "demo", ownership_source_local.missing.fort_call);
}

// The deferred release runs before the return reads its result.
fn ex08() void {
    string[6] lines = {
        "fn bad() i32* {",
        "    i32 mut* own p = new(i32);",
        "    defer del(p);",
        "    i32* view = p;",
        "    return view;",
        "}",
    };
    ownership_source_env.env mut e = ownership_source_env.env{};
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    analyze(&e, &text, lines[..]);
    defer ownership_source_env.close(&e);
    violated(&e, "bad", ownership_api.event_kind.invalid_use, "the result", 5);
}

// The retained field is a stored borrow: only remember is local.
fn ex09() void {
    string[13] lines = {
        "struct view_box {",
        "    i32* ptr;",
        "}",
        "fn remember(view_box mut* out, i32* value) void {",
        "    out->ptr = value;",
        "}",
        "fn demo() i32 {",
        "    i32 mut* own p = new(i32);",
        "    view_box mut saved = {};",
        "    remember(&saved, p);",
        "    del(p);",
        "    return *saved.ptr;",
        "}",
    };
    ownership_source_env.env mut e = ownership_source_env.env{};
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    analyze(&e, &text, lines[..]);
    defer ownership_source_env.close(&e);
    proved(&e, "remember");
}

// The output owner moves through a pointer.
fn ex11() void {
    string[11] lines = {
        "fn fill(i32 mut* own mut* out) void {",
        "    *out = new(i32);",
        "    **out = 11;",
        "}",
        "fn demo() i32 {",
        "    i32 mut* own mut p = null;",
        "    fill(&p);",
        "    i32 value = *p;",
        "    del(p);",
        "    return value;",
        "}",
    };
    ownership_source_env.env mut e = ownership_source_env.env{};
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    analyze(&e, &text, lines[..]);
    defer ownership_source_env.close(&e);
    proved(&e, "fill");
}

// One path releases p: no witness validates the other path.
fn ex15() void {
    string[10] lines = {
        "fn demo(bool release) i32 {",
        "    i32 mut* own p = new(i32);",
        "    i32* view = p;",
        "    if (release) {",
        "        del(p);",
        "    }",
        "    i32 value = *view;",
        "    del(p);",
        "    return value;",
        "}",
    };
    ownership_source_env.env mut e = ownership_source_env.env{};
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    analyze(&e, &text, lines[..]);
    defer ownership_source_env.close(&e);
    declared(&e, "demo");
}

// Each iteration ends p with its allocation live.
fn ex16_leak() void {
    string[7] lines = {
        "fn bad(u64 n) void {",
        "    u64 mut i = 0;",
        "    while (i < n) {",
        "        i32 mut* own p = new(i32);",
        "        i += 1;",
        "    }",
        "}",
    };
    ownership_source_env.env mut e = ownership_source_env.env{};
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    analyze(&e, &text, lines[..]);
    defer ownership_source_env.close(&e);
    violated(&e, "bad", ownership_api.event_kind.lost_ownership, "p", 6);
}

// Accepted by design. The earlier allocation of the site takes its earlier identities, and
// the null test refines current (D17.16).
fn ex16_transfer() void {
    string[13] lines = {
        "fn demo(u64 n) i32 {",
        "    i32 mut* own mut current = null;",
        "    u64 mut i = 0;",
        "    while (i < n) {",
        "        i32 mut* own next = new(i32);",
        "        del(current);",
        "        current = move(next);",
        "        i += 1;",
        "    }",
        "    i32 value = current == null ? 0 : *current;",
        "    del(current);",
        "    return value;",
        "}",
    };
    ownership_source_env.env mut e = ownership_source_env.env{};
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    analyze(&e, &text, lines[..]);
    defer ownership_source_env.close(&e);
    proved(&e, "demo");
}

// The retained key is a stored borrow: only put is local.
fn ex18() void {
    string[13] lines = {
        "struct entry {",
        "    string key;",
        "}",
        "fn put(entry mut* e, string key) void {",
        "    e->key = key;",
        "}",
        "fn demo() u8 {",
        "    u8 mut@ own bytes = new(u8, 2);",
        "    entry mut e = {};",
        "    put(&e, cast(bytes, string));",
        "    del(bytes);",
        "    return cast(e.key[0], u8);",
        "}",
    };
    ownership_source_env.env mut e = ownership_source_env.env{};
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    analyze(&e, &text, lines[..]);
    defer ownership_source_env.close(&e);
    proved(&e, "put");
}

