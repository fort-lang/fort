// The corpus expects errors on lines 11 and 12. Line 11 is validated. The flow stops the
// path at that failure, so it never examines the leak of b on line 12: no record and no
// incomplete reason name it. The body stays rejected. Even with the record, no witness
// crosses the print call before line 12.
fn f054() void {
    string[13] lines = {
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "fn main() i32 {",
        "    i32 mut* own a = new(i32);",
        "    i32 mut* own b = move(a);",
        "    println(*a);",
        "    return 0;",
        "}",
    };
    ownership_source_env.env mut e = ownership_source_env.env{};
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    analyze(&e, &text, lines[..]);
    defer ownership_source_env.close(&e);
    violated(&e, "main", ownership_api.event_kind.invalid_use, "a", 11);
    ownership_source.body* row = ownership_source_env.find(&e, "main", "main");
    assert(row->local.unvalidated == 0);
    assert(!row->local.first_incomplete.terminal.present);
    assert(row->local.proof.failed);
}

