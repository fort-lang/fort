//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| approved examples ok
//| deferred fail tests ok
/// Holds the local outcome of the approved ownership examples and of the deferred
/// ownership fail tests. Each program keeps its file lines, so a line here is the line of
/// that file. A validated violation must match the file's deferred expectation.
import ownership_api;
import ownership_report;
import ownership_source;
import ownership_source_env;
import ownership_source_local;
import std.strbuf;

fn analyze(ownership_source_env.env mut* e, strbuf.str_buf mut* text, string@ lines) void {
    u64 mut i = 0;
    while (i < lines.len) {
        strbuf.append(text, lines[i]);
        strbuf.push(text, '\n');
        i += 1;
    }
    ownership_source_env.open(e);
    ownership_source_env.runtime(e);
    assert(ownership_source_env.prepare(e, strbuf.view(text)));
    ownership_source.analyze(&e->source);
}

fn local_row(ownership_source_env.env mut* e, string name, string correspondence,
    string proof) ownership_source.body* {
    ownership_source.body* row = ownership_source_env.find(e, "main", name);
    string got_correspondence = ownership_report.analysis_status(row, ownership_report.LOCAL,
        0);
    string got_proof = ownership_report.analysis_status(row, ownership_report.LOCAL, 2);
    if (got_correspondence != correspondence || got_proof != proof) {
        eprintln(name, ": correspondence ", got_correspondence, ", proof ", got_proof);
        assert(false);
    }
    return row;
}

fn proved(ownership_source_env.env mut* e, string name) void {
    local_row(e, name, "complete", "complete");
}

fn declared(ownership_source_env.env mut* e, string name) void {
    ownership_source.body* row = local_row(e, name, "complete", "incomplete");
    assert(row->local.violations_len == 0);
}

fn outside(ownership_source_env.env mut* e, string name, ownership_source_local.missing why)
    void {
    ownership_source.body* row = local_row(e, name, "incomplete", "incomplete");
    assert(row->local.gap == why);
}

fn violated(ownership_source_env.env mut* e, string name, ownership_api.event_kind kind,
    string slot, u32 line) void {
    ownership_source.body* row = local_row(e, name, "complete", "violated");
    assert(row->local.violations_len == 1);
    ownership_source_local.violation v = row->local.violations[0];
    if (v.kind != kind || v.name != slot || v.source.line != line) {
        eprintln(name, ": ", v.name, " at line ", v.source.line);
        assert(false);
    }
}

// The approved design rejects the read of q after del(p).
fn ex01() void {
    string[6] lines = {
        "fn demo() i32 {",
        "    i32 mut* own p = new(i32);",
        "    i32* q = p;",
        "    del(p);",
        "    return *q;",
        "}",
    };
    ownership_source_env.env mut e = ownership_source_env.env{};
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    analyze(&e, &text, lines[..]);
    defer ownership_source_env.close(&e);
    violated(&e, "demo", ownership_api.event_kind.invalid_use, "q", 5);
}

// The approved design accepts a view that outlives a move.
fn ex02() void {
    string[10] lines = {
        "fn demo() i32 {",
        "    i32 mut* own p = new(i32);",
        "    *p = 7;",
        "    i32* view = p;",
        "    i32 mut* own next = move(p);",
        "    i32 value = *view;",
        "    bool empty = p == null;",
        "    del(next);",
        "    return empty ? value : 0;",
        "}",
    };
    ownership_source_env.env mut e = ownership_source_env.env{};
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    analyze(&e, &text, lines[..]);
    defer ownership_source_env.close(&e);
    proved(&e, "demo");
}

// The release happens in the callee: call summaries own it.
fn ex03() void {
    string[9] lines = {
        "fn drop(i32* own p) void {",
        "    del(p);",
        "}",
        "fn demo() i32 {",
        "    i32 mut* own p = new(i32);",
        "    i32* view = p;",
        "    drop(move(p));",
        "    return *view;",
        "}",
    };
    ownership_source_env.env mut e = ownership_source_env.env{};
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    analyze(&e, &text, lines[..]);
    defer ownership_source_env.close(&e);
    outside(&e, "drop", ownership_source_local.missing.own_parameter);
    outside(&e, "demo", ownership_source_local.missing.call_dependent);
}

// Refilling p does not revive the old borrow.
fn ex04() void {
    string[9] lines = {
        "fn demo() i32 {",
        "    i32 mut* own mut p = new(i32);",
        "    i32* old = p;",
        "    del(p);",
        "    p = new(i32);",
        "    i32 value = *old;",
        "    del(move(p));",
        "    return value;",
        "}",
    };
    ownership_source_env.env mut e = ownership_source_env.env{};
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    analyze(&e, &text, lines[..]);
    defer ownership_source_env.close(&e);
    violated(&e, "demo", ownership_api.event_kind.invalid_use, "old", 6);
}

