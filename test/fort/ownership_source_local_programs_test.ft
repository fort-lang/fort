// A trusted result has a trusted foreign source (D17.13).
fn ex19_alias() void {
    string[11] lines = {
        "extern fn copy_bytes(u8 mut* dst, u8* src, u64 n) u8 mut*;",
        "fn demo() u8 {",
        "    u8 mut@ own dst = new(u8, 1);",
        "    u8 mut@ own src = new(u8, 1);",
        "    src[0] = 5;",
        "    u8 mut* result = copy_bytes(dst.ptr, src.ptr, 1);",
        "    u8 value = *result;",
        "    del(src);",
        "    del(dst);",
        "    return value;",
        "}",
    };
    ownership_source_env.env mut e = ownership_source_env.env{};
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    analyze(&e, &text, lines[..]);
    defer ownership_source_env.close(&e);
    proved(&e, "demo");
}

