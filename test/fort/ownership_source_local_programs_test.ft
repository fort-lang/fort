// Only a later iteration overwrites: no witness validates it.
fn f061() void {
    string[13] lines = {
        "",
        "",
        "",
        "fn main() i32 {",
        "    i32 mut* own mut p = null;",
        "    i32 mut i = 0;",
        "    while (i < 3) {",
        "        p = new(i32);",
        "        i += 1;",
        "    }",
        "    del(p);",
        "    return i;",
        "}",
    };
    ownership_source_env.env mut e = ownership_source_env.env{};
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    analyze(&e, &text, lines[..]);
    defer ownership_source_env.close(&e);
    declared(&e, "main");
}

// The empty argument is the callee's matter: call summaries.
fn f062() void {
    string[18] lines = {
        "",
        "",
        "",
        "fn take(i32 mut* own p) i32 {",
        "    i32 v = *p;",
        "    del(p);",
        "    return v;",
        "}",
        "",
        "fn main() i32 {",
        "    i32 mut* own p = new(i32);",
        "    *p = 1;",
        "    for (i32 mut i = 0; take(move(p)) == 1; i += 1) {",
        "        println(\"iteration \", i);",
        "    }",
        "    println(\"done\");",
        "    return 0;",
        "}",
    };
    ownership_source_env.env mut e = ownership_source_env.env{};
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    analyze(&e, &text, lines[..]);
    defer ownership_source_env.close(&e);
    outside(&e, "take", ownership_source_local.missing.own_parameter);
    proved(&e, "main");
}

