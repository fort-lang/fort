// A void pointer round trip keeps the source (D17.17).
fn ex20_kept() void {
    string[10] lines = {
        "fn demo() u8 {",
        "    u8 mut@ own bytes = new(u8, 4);",
        "    void mut* raw = cast(bytes.ptr, void mut*);",
        "    u8 mut* p = cast(raw, u8 mut*);",
        "    u8 mut@ view = p[0..4];",
        "    view[0] = 6;",
        "    u8 value = view[0];",
        "    del(bytes);",
        "    return value;",
        "}",
    };
    ownership_source_env.env mut e = ownership_source_env.env{};
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    analyze(&e, &text, lines[..]);
    defer ownership_source_env.close(&e);
    proved(&e, "demo");
}

// The deferred test expects the error on line 7.
fn f047() void {
    string[13] lines = {
        "",
        "",
        "",
        "fn main() i32 {",
        "    i32 mut* own a = new(i32);",
        "    i32 mut* own b = move(a);",
        "    println(*a);",
        "    i32 mut* own c = move(b);",
        "    println(b == null);",
        "    println(b == null);",
        "    del(c);",
        "    return 0;",
        "}",
    };
    ownership_source_env.env mut e = ownership_source_env.env{};
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    analyze(&e, &text, lines[..]);
    defer ownership_source_env.close(&e);
    violated(&e, "main", ownership_api.event_kind.invalid_use, "a", 7);
}

// The leak follows print calls, which may not return.
fn f048() void {
    string[13] lines = {
        "",
        "",
        "",
        "fn main() i32 {",
        "    i32* own a = null;",
        "    println(a == null);",
        "    u8 mut@ own s = {};",
        "    println(s.len);",
        "    i32 mut* own mut b = null;",
        "    println(b == null);",
        "    b = new(i32);",
        "    return 0;",
        "}",
    };
    ownership_source_env.env mut e = ownership_source_env.env{};
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    analyze(&e, &text, lines[..]);
    defer ownership_source_env.close(&e);
    declared(&e, "main");
}

