//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| lattice tables
//| keys and views
//| known integers
//| the entry state
//| unfold and fold
//| canonical form
//| joins keep obligations
//| widening removes cells
//| precision covers
//| null tests
//| caller requirements
//| records without storage
//| retired arguments
//| crossed calls
//| values that a call can write
//| joins of refined inputs
//| branch rejoins
//| heap state ok
/// Checks the state operations of the heap proof one at a time (D17.16, D17.18, fir.md 14.1).
import fir;
import ownership_api;
import ownership_heap;
import ownership_heap_env;
import ownership_limits;
import types;

string[20] HOST = {
    "struct node { node mut* own next; u8 mut@ own bytes; i32 v; }",
    "struct holder { node mut* own first; node mut* own second; }",
    "fn host(node mut* own p, node mut* own q, holder mut* h, u8@ view) void {",
    "    node mut* own a = null; node mut* own b = null; node* w = null;",
    "    u8 small = 0; i8 tiny = 0; u64 wide = 0; i64 sign = 0; }",
    "fn diamond(bool c) i32 { i32 mut x = 0; if (c) { x = 1; } else { x = 2; } return x; }",
    "fn looping(u64 n) u64 { u64 mut i = 0; while (i < n) { i += 1; } return i; }",
    "fn aborting(bool c) i32 { i32 mut x = 0; if (c) { panic(\"no\"); } return x; }",
    "fn calling(bool c) i32 { i32 mut x = 0; if (c) { x = leaf(); } return x; }",
    "fn leaf() i32 { return 1; }",
    "fn nested(bool c, bool d) i32 { i32 mut x = 0; if (c) { if (d) { x = 1; } x += 1; }",
    "    return x; }",
    "fn asserting(bool c) i32 { assert(c); return 1; }",
    "fn checked(u8 x) u8 { return x + 1; }",
    "fn unused() void { }",
    "fn empty() void { }",
    "fn addressed(u64 i) u64 { u64 mut j = 5; u64* p = &j; u64 k = 7; return i + j + k; }",
    "fn divide_arm(bool c, i32 d) i32 { i32 mut x = 0; if (c) { x = 10 / d; } return x; }",
    "fn index_arm(bool c, u64 i) u64 { u64[2] a = {1, 2}; u64 mut x = 0;",
    "    if (c) { x = a[i]; } return x; }",
};

string[14] NAMES = {"host", "diamond", "looping", "aborting", "calling", "leaf", "nested",
    "asserting", "checked", "unused", "empty", "addressed", "divide_arm", "index_arm"};

struct fixture {
    ownership_heap_env.closure c;
    ownership_heap.context ctx;
}

fn open(fixture mut* x, string name) void {
    ownership_heap_env.open(&x->c, HOST[..], NAMES[..]);
    ownership_heap_env.context_of(&x->c, name, &x->ctx);
}

fn close(fixture mut* x) void {
    ownership_heap.free_context(&x->ctx);
    ownership_heap_env.close(&x->c);
}

fn local(u32 n) ownership_heap.slot_key {
    return ownership_heap.key_of(ownership_heap.base_kind.local, n);
}

fn field_key(ownership_heap.base_kind base, u32 id, u32 k) ownership_heap.slot_key {
    ownership_heap.slot_key mut key = ownership_heap.key_of(base, id);
    assert(ownership_heap.extend(&key, k));
    return key;
}

fn value_at(ownership_heap.state* s, ownership_heap.slot_key k) ownership_heap.value {
    u64 at = ownership_heap.find_slot(s, k);
    assert(at != ownership_heap.U64_MAX);
    return s->slots[at].v;
}

fn set_value(ownership_heap.state mut* s, ownership_heap.slot_key k, ownership_heap.value v)
    void {
    u64 at = ownership_heap.find_slot(s, k);
    assert(at != ownership_heap.U64_MAX);
    s->slots[at].v = v;
}

// The live obligations of a state: used atoms with a live or unknown status and a root that
// can be nonnull.
fn obligations(ownership_heap.state* s) u64 {
    u64 mut n = 0;
    u64 mut i = 0;
    while (i < s->atoms_len) {
        ownership_heap.atom a = s->atoms[i];
        if (a.used && a.root != ownership_heap.root_kind.null_root &&
            (a.status == ownership_heap.atom_status.live ||
            a.status == ownership_heap.atom_status.unknown)) { n += 1; }
        i += 1;
    }
    return n;
}

fn cells(ownership_heap.state* s) u64 {
    u64 mut n = 0;
    u64 mut i = 0;
    while (i < s->atoms_len) {
        if (s->atoms[i].used && s->atoms[i].kind == ownership_heap.atom_kind.cell) { n += 1; }
        i += 1;
    }
    return n;
}

fn same(ownership_heap.context mut* ctx, ownership_heap.state* a, ownership_heap.state* b) bool {
    bool mut out = false;
    assert(ownership_heap.equal(ctx, a, b, &out));
    return out;
}

// A fresh cell of `node` in local `n`, with its reference leaves empty.
fn fresh_cell(ownership_heap.context mut* ctx, ownership_heap.state mut* s, u32 n) u32 {
    types.node* t = s->atoms[0].ty;
    ownership_heap.atom mut a = ownership_heap.new_atom(ownership_heap.atom_kind.cell, t,
        ownership_heap.shape_of(ctx, t), ownership_heap.root_kind.nonnull);
    a.fresh = true;
    u32 made = ownership_heap.push_atom(s, a);
    ownership_heap.add_cell_slots(ctx, s, made, t);
    set_value(s, local(n), ownership_heap.own_value(made));
    return made;
}

fn tables() void {
    println("lattice tables");
    ownership_heap.root_kind[4] roots = {ownership_heap.root_kind.null_root,
        ownership_heap.root_kind.nonnull, ownership_heap.root_kind.free,
        ownership_heap.root_kind.joined};
    u64 mut i = 0;
    while (i < roots.len) {
        u64 mut j = 0;
        while (j < roots.len) {
            ownership_heap.root_kind r = ownership_heap.join_root(roots[i], roots[j]);
            if (i == j) {
                assert(r == roots[i]);
            } else {
                assert(r == ownership_heap.root_kind.joined);
            }
            assert(r == ownership_heap.join_root(roots[j], roots[i]));
            j += 1;
        }
        i += 1;
    }
    ownership_heap.atom_status[6] all = {ownership_heap.atom_status.live,
        ownership_heap.atom_status.released, ownership_heap.atom_status.maybe_released,
        ownership_heap.atom_status.leaked, ownership_heap.atom_status.escaped,
        ownership_heap.atom_status.unknown};
    i = 0;
    while (i < all.len) {
        u64 mut j = 0;
        while (j < all.len) {
            ownership_heap.atom_status st = ownership_heap.join_status(all[i], all[j]);
            assert(st == ownership_heap.join_status(all[j], all[i]));
            if (i == j) { assert(st == all[i]); }
            j += 1;
        }
        i += 1;
    }
    // A release on one path and a live allocation on the other is a possible release.
    assert(ownership_heap.join_status(ownership_heap.atom_status.live,
        ownership_heap.atom_status.released) == ownership_heap.atom_status.maybe_released);
    // An unknown or escaped side makes the join unknown.
    assert(ownership_heap.join_status(ownership_heap.atom_status.escaped,
        ownership_heap.atom_status.live) == ownership_heap.atom_status.unknown);
    // A reported loss on one side keeps the other side checked.
    assert(ownership_heap.join_status(ownership_heap.atom_status.leaked,
        ownership_heap.atom_status.released) == ownership_heap.atom_status.released);
    assert(ownership_heap.certainty_of(ownership_heap.root_kind.nonnull) ==
        ownership_heap.certainty.definite);
    assert(ownership_heap.certainty_of(ownership_heap.root_kind.free) ==
        ownership_heap.certainty.choice);
    assert(ownership_heap.certainty_of(ownership_heap.root_kind.joined) ==
        ownership_heap.certainty.possible);
    assert(ownership_heap.bit(0) == 1 && ownership_heap.bit(63) != 0);
    assert(ownership_heap.bit(64) == 0);
    assert(ownership_heap.grow(0, 1) == 8 && ownership_heap.grow(8, 9) == 16);
    assert(ownership_heap.grow(16, 3) == 16);
    // A join of two refined values of one free choice stays a free choice only when both sides
    // are witnessed.
    ownership_heap.atom mut x = ownership_heap.new_atom(ownership_heap.atom_kind.region, null, 0,
        ownership_heap.root_kind.nonnull);
    x.choice = true;
    ownership_heap.atom mut y = x;
    y.root = ownership_heap.root_kind.null_root;
    assert(ownership_heap.join_atom(x, y, true, true).root == ownership_heap.root_kind.free);
    assert(ownership_heap.join_atom(x, y, true, false).root == ownership_heap.root_kind.joined);
    y.choice = false;
    assert(ownership_heap.join_atom(x, y, true, true).root == ownership_heap.root_kind.joined);
    // A null root holds no allocation, so the other side gives the status.
    ownership_heap.atom mut gone = x;
    gone.status = ownership_heap.atom_status.released;
    assert(ownership_heap.join_atom(gone, y, true, true).status ==
        ownership_heap.atom_status.released);
    // Different kinds join to an opaque atom with no template.
    ownership_heap.atom mut f = ownership_heap.new_atom(ownership_heap.atom_kind.flat, null, 0,
        ownership_heap.root_kind.nonnull);
    ownership_heap.atom k = ownership_heap.join_atom(x, f, true, true);
    assert(k.kind == ownership_heap.atom_kind.opaque && k.shape == 0);
    // Handles survive only when both sides name one entry value.
    x.handle = 2;
    x.handle_field = ownership_heap.NONE;
    f.handle = 3;
    assert(ownership_heap.join_atom(x, f, true, true).handle == ownership_heap.NONE);
    assert(ownership_heap.join_atom(x, x, true, true).handle == 2);
}

fn keys() void {
    println("keys and views");
    ownership_heap.slot_key mut k = local(3);
    u32 mut i = 0;
    while (i < 6) {
        assert(ownership_heap.extend(&k, i));
        i += 1;
    }
    assert(k.depth == 6);
    // The seventh field is past the path bound.
    assert(!ownership_heap.extend(&k, 6));
    assert(k.depth == 6);
    ownership_heap.slot_key head = field_key(ownership_heap.base_kind.cell, 4, 1);
    ownership_heap.slot_key mut out = ownership_heap.slot_key{};
    u32[6] mut path = {};
    path[0] = 2;
    path[1] = 3;
    assert(ownership_heap.rebase(head, 2, path, &out));
    assert(out.depth == 3 && out.path[0] == 1 && out.path[1] == 2 && out.path[2] == 3);
    assert(ownership_heap.prefix_of(head, out) && !ownership_heap.prefix_of(out, head));
    assert(ownership_heap.prefix_of(head, head));
    assert(!ownership_heap.prefix_of(field_key(ownership_heap.base_kind.cell, 5, 1), out));
    assert(!ownership_heap.rebase(k, 1, path, &out));
    assert(ownership_heap.key_order(local(1), local(2)) < 0);
    assert(ownership_heap.key_order(local(2), field_key(ownership_heap.base_kind.local, 2, 0)) < 0);
    assert(ownership_heap.key_order(local(9), ownership_heap.key_of(
        ownership_heap.base_kind.caller, 0)) < 0);
    assert(ownership_heap.key_order(ownership_heap.key_of(ownership_heap.base_kind.caller, 7),
        ownership_heap.key_of(ownership_heap.base_kind.cell, 0)) < 0);
    assert(ownership_heap.key_order(head, head) == 0 && ownership_heap.same_key(head, head));
    assert(!ownership_heap.same_key(head, out));
    // A view keeps at most eight sources; the ninth fails and a caller makes it unknown.
    ownership_heap.value mut v = ownership_heap.empty_value();
    v.kind = ownership_heap.value_kind.view;
    u32 mut s = 0;
    while (s < 8) {
        assert(ownership_heap.add_source(&v, 20 - s));
        s += 1;
    }
    assert(ownership_heap.add_source(&v, 20));
    assert(!ownership_heap.add_source(&v, 1));
    assert(v.count == 8);
    ownership_heap.sort_sources(&v);
    assert(v.sources[0] == 13 && v.sources[7] == 20);
    ownership_heap.remove_source(&v, 15);
    assert(v.count == 7 && v.sources[2] == 16);
    ownership_heap.value mut w = v;
    assert(ownership_heap.same_value(v, w));
    w.exact = true;
    assert(!ownership_heap.same_value(v, w));
    w = v;
    w.param = 1;
    assert(!ownership_heap.same_value(v, w));
    assert(ownership_heap.same_value(ownership_heap.own_value(3), ownership_heap.own_value(3)));
    assert(!ownership_heap.same_value(ownership_heap.own_value(3), ownership_heap.own_value(4)));
    assert(!ownership_heap.same_value(ownership_heap.empty_value(),
        ownership_heap.unknown_value()));
    ownership_heap.value mut t1 = ownership_heap.scalar_value();
    t1.known = true;
    t1.truth = true;
    ownership_heap.value mut t2 = t1;
    t2.truth = false;
    assert(!ownership_heap.same_value(t1, t2));
    t2 = t1;
    t2.numbered = true;
    t2.number = 7;
    assert(!ownership_heap.same_value(t1, t2));
}

fn integers() void {
    println("known integers");
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "host");
    fir.func* f = x.ctx.f;
    // The locals after the parameters and the three named owners: small, tiny, wide, sign.
    types.node* small = fir.local_at(f, 8)->ty;
    types.node* tiny = fir.local_at(f, 9)->ty;
    types.node* wide = fir.local_at(f, 10)->ty;
    types.node* sign = fir.local_at(f, 11)->ty;
    assert(ownership_heap.numbered_in(255, small).numbered);
    assert(!ownership_heap.numbered_in(256, small).numbered);
    assert(!ownership_heap.numbered_in(-1, small).numbered);
    assert(ownership_heap.numbered_in(-128, tiny).numbered);
    assert(!ownership_heap.numbered_in(-129, tiny).numbered);
    assert(!ownership_heap.numbered_in(128, tiny).numbered);
    assert(ownership_heap.numbered_in(9223372036854775807, wide).numbered);
    assert(!ownership_heap.numbered_in(-1, wide).numbered);
    assert(ownership_heap.numbered_in(-9223372036854775807 - 1, sign).numbered);
    assert(!ownership_heap.numbered_in(1, null).numbered);
    assert(ownership_heap.numbered_in(4, sign).number == 4);
    // `and` and `or` of known truth values; a known side that does not decide gives the other.
    ownership_heap.value yes = known(true);
    ownership_heap.value no = known(false);
    ownership_heap.value open_value = ownership_heap.scalar_value();
    assert(ownership_heap.combined(yes, yes, false).known);
    assert(ownership_heap.combined(yes, yes, false).truth);
    assert(ownership_heap.combined(yes, no, false).known);
    assert(!ownership_heap.combined(yes, no, false).truth);
    assert(ownership_heap.combined(no, open_value, false).known);
    assert(!ownership_heap.combined(no, open_value, false).truth);
    assert(ownership_heap.combined(open_value, yes, true).known);
    assert(ownership_heap.combined(open_value, yes, true).truth);
    assert(ownership_heap.combined(no, no, true).known);
    assert(!ownership_heap.combined(no, no, true).truth);
    assert(!ownership_heap.combined(open_value, no, true).known);
    assert(!ownership_heap.combined(yes, open_value, false).known);
}

fn entry_state() void {
    println("the entry state");
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "host");
    ownership_heap.context mut* ctx = &x.ctx;
    // p, q, h->first, h->second: four owned interface leaves in fixed-slot order.
    assert(ctx->interface_len == 4 && ctx->callers_len == 1);
    assert(ctx->interface[0].kind == ownership_heap.atom_kind.region);
    assert(ctx->interface[2].key.base == ownership_heap.base_kind.caller);
    assert(ctx->interface[2].key.depth == 1 && ctx->interface[2].key.path[0] == 0);
    ownership_heap.state mut s = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&s);
    assert(s.reached && s.witness && s.atoms_len == 4);
    u64 mut i = 0;
    while (i < 4) {
        ownership_heap.atom a = s.atoms[i];
        assert(a.root == ownership_heap.root_kind.free && a.choice);
        assert(a.origin == ownership_heap.bit(i));
        assert(a.handle == cast(i, u32) && a.handle_field == ownership_heap.NONE && !a.strict);
        i += 1;
    }
    assert(value_at(&s, local(1)).kind == ownership_heap.value_kind.owned);
    ownership_heap.value h = value_at(&s, local(3));
    assert(h.kind == ownership_heap.value_kind.address && h.param == 3);
    assert(h.target.base == ownership_heap.base_kind.caller && h.target.id == 0);
    ownership_heap.value view = value_at(&s, local(4));
    assert(view.kind == ownership_heap.value_kind.view && view.external && view.param == 4);
    assert(value_at(&s, local(5)).kind == ownership_heap.value_kind.empty);
    assert(value_at(&s, local(8)).kind == ownership_heap.value_kind.scalar);
    // A copy of the state is equal to it and owns separate storage.
    ownership_heap.state mut copy = ownership_heap.clone(&s);
    defer ownership_heap.free_state(&copy);
    assert(same(ctx, &s, &copy));
    copy.atoms[0].root = ownership_heap.root_kind.nonnull;
    assert(!same(ctx, &s, &copy));
    assert(s.atoms[0].root == ownership_heap.root_kind.free);
}

fn unfold_fold() void {
    println("unfold and fold");
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "host");
    ownership_heap.context mut* ctx = &x.ctx;
    ownership_heap.state mut s = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&s);
    ownership_heap.content mut m = ownership_heap.measure(ctx, &s);
    // Four atoms; two regions of one template: 1 + 1 parameter + 2 clauses + 2 descendants.
    // No root is refined, and the deepest slot is a field of caller storage.
    assert(m.r == 4 && m.h == 6 && m.p == 0 && m.d == 1);
    assert(ownership_heap.unfold(ctx, &s, 0));
    assert(s.atoms[0].kind == ownership_heap.atom_kind.cell);
    assert(s.atoms[0].root == ownership_heap.root_kind.nonnull);
    ownership_heap.value next = value_at(&s, field_key(ownership_heap.base_kind.cell, 0, 0));
    ownership_heap.value bytes = value_at(&s, field_key(ownership_heap.base_kind.cell, 0, 1));
    assert(next.kind == ownership_heap.value_kind.owned);
    assert(bytes.kind == ownership_heap.value_kind.owned);
    ownership_heap.atom child = s.atoms[next.atom];
    assert(child.kind == ownership_heap.atom_kind.region);
    assert(child.root == ownership_heap.root_kind.free);
    assert(child.strict && child.choice && child.origin == 1);
    assert(child.handle == 0 && child.handle_field == 0);
    ownership_heap.atom payload = s.atoms[bytes.atom];
    assert(payload.kind == ownership_heap.atom_kind.flat && payload.handle_field == 1);
    // The scalar field has no slot. Two edges now, and the template of q stays. The root of a
    // cell is no refined fact: its kind gives it.
    m = ownership_heap.measure(ctx, &s);
    assert(m.r == 6 && m.h == 8 && m.p == 0);
    s.atoms[1].root = ownership_heap.root_kind.null_root;
    assert(ownership_heap.measure(ctx, &s).p == 1);
    s.atoms[1].root = ownership_heap.root_kind.free;
    // A child of a strict child is strict and has no handle: it is no entry field.
    assert(ownership_heap.unfold(ctx, &s, next.atom));
    ownership_heap.value deeper = value_at(&s,
        field_key(ownership_heap.base_kind.cell, next.atom, 0));
    assert(s.atoms[deeper.atom].strict && s.atoms[deeper.atom].handle == ownership_heap.NONE);
    // A member view of p gains each child as a source.
    ownership_heap.value mut member = ownership_heap.empty_value();
    member.kind = ownership_heap.value_kind.view;
    assert(ownership_heap.add_source(&member, 0));
    set_value(&s, local(7), member);
    // The fold puts the children back into p, clears its handle, and keeps its identity.
    assert(ownership_heap.fold(ctx, &s, 0));
    assert(s.atoms[0].kind == ownership_heap.atom_kind.region);
    assert(s.atoms[0].handle == ownership_heap.NONE && s.atoms[0].origin == 1);
    assert(!s.atoms[next.atom].used && !s.atoms[bytes.atom].used && !s.atoms[deeper.atom].used);
    assert(!s.atoms[0].strict);
    assert(ownership_heap.find_slot(&s, field_key(ownership_heap.base_kind.cell, 0, 0)) ==
        ownership_heap.U64_MAX);
    ownership_heap.value kept = value_at(&s, local(7));
    assert(kept.kind == ownership_heap.value_kind.view && kept.count == 1 && kept.sources[0] == 0);
    // A self-cycle never folds.
    u32 cycle = fresh_cell(ctx, &s, 5);
    set_value(&s, field_key(ownership_heap.base_kind.cell, cycle, 0),
        ownership_heap.own_value(cycle));
    assert(!ownership_heap.fold(ctx, &s, cycle));
    // A released child never folds.
    u32 parent = fresh_cell(ctx, &s, 6);
    u32 inner = fresh_cell(ctx, &s, 7);
    set_value(&s, local(7), ownership_heap.empty_value());
    set_value(&s, field_key(ownership_heap.base_kind.cell, parent, 0),
        ownership_heap.own_value(inner));
    s.atoms[inner].status = ownership_heap.atom_status.released;
    assert(!ownership_heap.fold(ctx, &s, parent));
    s.atoms[inner].status = ownership_heap.atom_status.live;
    assert(ownership_heap.fold(ctx, &s, parent));
    assert(s.atoms[parent].fresh && !s.atoms[inner].used);
    // An opaque payload never folds.
    u32 boxed = fresh_cell(ctx, &s, 6);
    ownership_heap.atom mut blob = ownership_heap.new_atom(ownership_heap.atom_kind.opaque, null, 0,
        ownership_heap.root_kind.nonnull);
    u32 blob_at = ownership_heap.push_atom(&s, blob);
    set_value(&s, field_key(ownership_heap.base_kind.cell, boxed, 1),
        ownership_heap.own_value(blob_at));
    assert(!ownership_heap.fold(ctx, &s, boxed));
}

fn canonical_form() void {
    println("canonical form");
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "host");
    ownership_heap.context mut* ctx = &x.ctx;
    ownership_heap.state mut a = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&a);
    ownership_heap.state mut b = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&b);
    // The same two fresh cells, made in the opposite order.
    u32 a1 = fresh_cell(ctx, &a, 5);
    u32 a2 = fresh_cell(ctx, &a, 6);
    u32 b2 = fresh_cell(ctx, &b, 6);
    u32 b1 = fresh_cell(ctx, &b, 5);
    assert(a1 != b1 && a2 != b2);
    assert(!same(ctx, &a, &b));
    assert(ownership_heap.canonical(ctx, &a));
    assert(ownership_heap.canonical(ctx, &b));
    assert(same(ctx, &a, &b));
    // Canonical form is stable.
    ownership_heap.state mut again = ownership_heap.clone(&a);
    defer ownership_heap.free_state(&again);
    assert(ownership_heap.canonical(ctx, &again));
    assert(same(ctx, &a, &again));
    // A null root leaves its slot; a released record with no view goes.
    again.atoms[0].root = ownership_heap.root_kind.null_root;
    u32 last = value_at(&again, local(6)).atom;
    again.atoms[last].status = ownership_heap.atom_status.released;
    set_value(&again, local(6), ownership_heap.empty_value());
    u64 before = again.atoms_len;
    assert(ownership_heap.canonical(ctx, &again));
    assert(value_at(&again, local(1)).kind == ownership_heap.value_kind.empty);
    assert(again.atoms_len == before - 1);
    // An interface record keeps its index even when no slot owns it.
    assert(again.atoms[0].kind == ownership_heap.atom_kind.region);
    // A live atom that no slot owns stays: an obligation is never dropped.
    ownership_heap.atom mut orphan = ownership_heap.new_atom(ownership_heap.atom_kind.flat, null, 0,
        ownership_heap.root_kind.nonnull);
    ownership_heap.push_atom(&again, orphan);
    u64 count = obligations(&again);
    assert(ownership_heap.canonical(ctx, &again));
    assert(obligations(&again) == count);
    // A released record that a view names stays for that view.
    ownership_heap.atom mut dead = orphan;
    dead.status = ownership_heap.atom_status.released;
    u32 dead_at = ownership_heap.push_atom(&again, dead);
    ownership_heap.value mut v = ownership_heap.empty_value();
    v.kind = ownership_heap.value_kind.view;
    v.exact = true;
    assert(ownership_heap.add_source(&v, dead_at));
    set_value(&again, local(7), v);
    assert(ownership_heap.canonical(ctx, &again));
    ownership_heap.value seen = value_at(&again, local(7));
    assert(seen.count == 1 && again.atoms[seen.sources[0]].status ==
        ownership_heap.atom_status.released);
}

fn joins() void {
    println("joins keep obligations");
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "host");
    ownership_heap.context mut* ctx = &x.ctx;
    ownership_heap.state mut a = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&a);
    assert(ownership_heap.canonical(ctx, &a));
    // A join with itself changes nothing.
    ownership_heap.state mut self_join = ownership_heap.state{};
    defer ownership_heap.free_state(&self_join);
    assert(ownership_heap.join(ctx, &a, &a, false, &self_join));
    assert(same(ctx, &self_join, &a));
    // One path allocates into `a`, the other leaves it empty.
    ownership_heap.state mut b = ownership_heap.clone(&a);
    defer ownership_heap.free_state(&b);
    u32 made = fresh_cell(ctx, &b, 5);
    assert(ownership_heap.canonical(ctx, &b));
    ownership_heap.state mut ab = ownership_heap.state{};
    defer ownership_heap.free_state(&ab);
    assert(ownership_heap.join(ctx, &a, &b, false, &ab));
    ownership_heap.state mut ba = ownership_heap.state{};
    defer ownership_heap.free_state(&ba);
    assert(ownership_heap.join(ctx, &b, &a, false, &ba));
    // The join commutes, keeps the obligation, and forgets the empty path only by a joined root.
    assert(same(ctx, &ab, &ba));
    assert(obligations(&ab) == obligations(&b));
    ownership_heap.value kept = value_at(&ab, local(5));
    assert(kept.kind == ownership_heap.value_kind.owned);
    assert(ab.atoms[kept.atom].root == ownership_heap.root_kind.joined);
    // The cell met an empty slot, so it folded into its template.
    assert(ab.atoms[kept.atom].kind == ownership_heap.atom_kind.region && made >= 4);
    // A join with bottom is the other side.
    ownership_heap.state mut none = ownership_heap.bottom(ab.ended.len);
    defer ownership_heap.free_state(&none);
    ownership_heap.state mut with_bottom = ownership_heap.state{};
    defer ownership_heap.free_state(&with_bottom);
    assert(ownership_heap.join(ctx, &none, &ab, false, &with_bottom));
    assert(same(ctx, &with_bottom, &ab));
    // An interface atom that one path moves keeps no index: its identity splits.
    ownership_heap.state mut moved = ownership_heap.clone(&a);
    defer ownership_heap.free_state(&moved);
    set_value(&moved, local(5), value_at(&moved, local(1)));
    set_value(&moved, local(1), ownership_heap.empty_value());
    ownership_heap.state mut split = ownership_heap.state{};
    defer ownership_heap.free_state(&split);
    assert(ownership_heap.join(ctx, &a, &moved, false, &split));
    assert(obligations(&split) >= obligations(&a));
    assert(value_at(&split, local(1)).kind == ownership_heap.value_kind.owned);
    assert(value_at(&split, local(5)).kind == ownership_heap.value_kind.owned);
    assert(value_at(&split, local(1)).atom != 0 && value_at(&split, local(5)).atom != 0);
    // A released interface record on one path and a live one on the other is a possible release.
    ownership_heap.state mut gone = ownership_heap.clone(&a);
    defer ownership_heap.free_state(&gone);
    gone.atoms[1].status = ownership_heap.atom_status.released;
    set_value(&gone, local(2), ownership_heap.empty_value());
    ownership_heap.state mut either = ownership_heap.state{};
    defer ownership_heap.free_state(&either);
    assert(ownership_heap.join(ctx, &a, &gone, false, &either));
    assert(value_at(&either, local(2)).kind == ownership_heap.value_kind.owned);
    // The witness of a join holds when one side has it.
    ownership_heap.state mut blind = ownership_heap.clone(&a);
    defer ownership_heap.free_state(&blind);
    blind.witness = false;
    ownership_heap.state mut seen = ownership_heap.state{};
    defer ownership_heap.free_state(&seen);
    assert(ownership_heap.join(ctx, &blind, &a, false, &seen));
    assert(seen.witness);
    ownership_heap.state mut neither = ownership_heap.state{};
    defer ownership_heap.free_state(&neither);
    assert(ownership_heap.join(ctx, &blind, &blind, false, &neither));
    assert(!neither.witness);
    // A local that one path ended is possibly ended after the join.
    ownership_heap.state mut ended = ownership_heap.clone(&a);
    defer ownership_heap.free_state(&ended);
    ended.ended[5] = 1;
    ownership_heap.state mut maybe = ownership_heap.state{};
    defer ownership_heap.free_state(&maybe);
    assert(ownership_heap.join(ctx, &a, &ended, false, &maybe));
    assert(maybe.ended[5] == 2);
}

fn widening() void {
    println("widening removes cells");
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "host");
    ownership_heap.context mut* ctx = &x.ctx;
    ownership_heap.state mut a = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&a);
    // A chain of three fresh cells and a self-cycle.
    u32 head = fresh_cell(ctx, &a, 5);
    u32 mut tail = head;
    u32 mut k = 0;
    while (k < 2) {
        ownership_heap.atom mut c = ownership_heap.new_atom(ownership_heap.atom_kind.cell,
            a.atoms[0].ty, ownership_heap.shape_of(ctx, a.atoms[0].ty),
            ownership_heap.root_kind.nonnull);
        c.fresh = true;
        u32 made = ownership_heap.push_atom(&a, c);
        ownership_heap.add_cell_slots(ctx, &a, made, a.atoms[0].ty);
        set_value(&a, field_key(ownership_heap.base_kind.cell, tail, 0),
            ownership_heap.own_value(made));
        tail = made;
        k += 1;
    }
    u32 cycle = fresh_cell(ctx, &a, 6);
    set_value(&a, field_key(ownership_heap.base_kind.cell, cycle, 0),
        ownership_heap.own_value(cycle));
    assert(cells(&a) == 4);
    u64 before = obligations(&a);
    assert(ownership_heap.widen_cells(ctx, &a));
    assert(cells(&a) == 0);
    // The chain folds into one region; the cycle becomes one opaque atom. No obligation goes.
    assert(a.atoms[head].kind == ownership_heap.atom_kind.region);
    assert(a.atoms[cycle].kind == ownership_heap.atom_kind.opaque);
    assert(obligations(&a) == before - 2);
    assert(a.atoms[head].used && a.atoms[cycle].used && !a.atoms[tail].used);
    // A widened join of two widened states has no cell either.
    ownership_heap.state mut b = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&b);
    fresh_cell(ctx, &b, 6);
    ownership_heap.state mut w = ownership_heap.state{};
    defer ownership_heap.free_state(&w);
    assert(ownership_heap.canonical(ctx, &a));
    assert(ownership_heap.canonical(ctx, &b));
    assert(ownership_heap.join(ctx, &a, &b, true, &w));
    assert(cells(&w) == 0);
    assert(obligations(&w) >= obligations(&a));
}

fn covers() void {
    println("precision covers");
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "host");
    ownership_heap.context mut* ctx = &x.ctx;
    ownership_heap.state mut s = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&s);
    assert(ownership_heap.unfold(ctx, &s, 0));
    u32 a = fresh_cell(ctx, &s, 5);
    ownership_heap.value mut v = ownership_heap.empty_value();
    v.kind = ownership_heap.value_kind.view;
    assert(ownership_heap.add_source(&v, a));
    set_value(&s, local(7), v);
    u64 owners = 0;
    ownership_heap.cover(&s);
    u64 mut i = 0;
    while (i < s.atoms_len) {
        ownership_heap.atom item = s.atoms[i];
        if (item.used) {
            assert(item.kind == ownership_heap.atom_kind.opaque ||
                item.kind == ownership_heap.atom_kind.flat);
        }
        i += 1;
    }
    // Each owner keeps an obligation; the view keeps no source.
    assert(value_at(&s, local(1)).kind == ownership_heap.value_kind.owned);
    assert(value_at(&s, local(5)).kind == ownership_heap.value_kind.owned);
    assert(value_at(&s, local(7)).kind == ownership_heap.value_kind.unknown);
    assert(obligations(&s) == 5 + owners);
    ownership_heap.content m = ownership_heap.measure(ctx, &s);
    assert(m.h == 0 && m.r == 5);
    // A P cover keeps each atom and joins each refined root.
    s.atoms[1].root = ownership_heap.root_kind.nonnull;
    ownership_heap.cover_roots(&s);
    assert(s.atoms[1].root == ownership_heap.root_kind.joined);
    assert(obligations(&s) == 5 + owners);
}

fn tests() void {
    println("null tests");
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "host");
    ownership_heap.context mut* ctx = &x.ctx;
    ownership_heap.state mut s = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&s);
    ownership_heap.value mut cond = ownership_heap.scalar_value();
    cond.test = 0;
    cond.test_nonnull = true;
    ownership_heap.state mut yes = ownership_heap.clone(&s);
    defer ownership_heap.free_state(&yes);
    assert(ownership_heap.refine(&yes, cond, true));
    assert(yes.atoms[0].root == ownership_heap.root_kind.nonnull && yes.witness);
    ownership_heap.state mut no = ownership_heap.clone(&s);
    defer ownership_heap.free_state(&no);
    assert(ownership_heap.refine(&no, cond, false));
    assert(no.atoms[0].root == ownership_heap.root_kind.null_root && no.witness);
    // A refined root contradicts the other edge.
    assert(!ownership_heap.refine(&yes, cond, false));
    assert(!ownership_heap.refine(&no, cond, true));
    // A joined root refines but clears the witness of the edge.
    ownership_heap.state mut joined = ownership_heap.clone(&s);
    defer ownership_heap.free_state(&joined);
    joined.atoms[0].root = ownership_heap.root_kind.joined;
    assert(ownership_heap.refine(&joined, cond, true));
    assert(!joined.witness);
    // An unfold of a free root assumes that the root is nonnull. That assumption removes no
    // path: the null edge stays, without a witness (D17.18). A test that establishes the root
    // nonnull clears the mark, and the null edge then contradicts the state.
    ownership_heap.state mut cell = ownership_heap.clone(&s);
    defer ownership_heap.free_state(&cell);
    assert(ownership_heap.unfold(ctx, &cell, 0));
    assert(cell.atoms[0].unfold_nonnull);
    ownership_heap.state mut assumed = ownership_heap.clone(&cell);
    defer ownership_heap.free_state(&assumed);
    assert(ownership_heap.refine(&assumed, cond, false) && !assumed.witness);
    assert(ownership_heap.refine(&cell, cond, true) && !cell.atoms[0].unfold_nonnull);
    assert(!ownership_heap.refine(&cell, cond, false));
    // A known truth value selects one edge; an untracked one clears each witness.
    ownership_heap.value mut known = ownership_heap.scalar_value();
    known.known = true;
    known.truth = false;
    assert(ownership_heap.refine(&s, known, false) && !ownership_heap.refine(&s, known, true));
    assert(s.witness);
    assert(ownership_heap.refine(&s, ownership_heap.scalar_value(), true));
    assert(!s.witness);
}

fn requirements() void {
    println("caller requirements");
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "host");
    ownership_heap.context mut* ctx = &x.ctx;
    ownership_heap.state mut s = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&s);
    ownership_heap.state mut entry = ownership_heap.clone(&s);
    defer ownership_heap.free_state(&entry);
    // The entry value of q becomes a requirement and an empty root. A store of the body settles
    // it on this path.
    assert(ownership_heap.require_empty(ctx, &s, 1, true));
    assert(ctx->require_null[1] && s.atoms[1].root == ownership_heap.root_kind.null_root);
    assert(s.required_null == 2);
    // The entry next field of p becomes a field requirement. A callee that stores over it on
    // some paths only records it for the caller: this path does not settle it.
    assert(ownership_heap.unfold(ctx, &s, 0));
    ownership_heap.value next = value_at(&s, field_key(ownership_heap.base_kind.cell, 0, 0));
    assert(ownership_heap.require_empty(ctx, &s, next.atom, false));
    assert(ctx->require_fields[0] == 1 && !ctx->require_null[0]);
    assert(s.required_fields[0] == 0 && s.required_null == 2);
    // A field of a field is no entry field: no requirement names it.
    ownership_heap.value bytes = value_at(&s, field_key(ownership_heap.base_kind.cell, 0, 1));
    s.atoms[bytes.atom].root = ownership_heap.root_kind.nonnull;
    assert(!ownership_heap.require_empty(ctx, &s, bytes.atom, true));
    s.atoms[bytes.atom].root = ownership_heap.root_kind.free;
    s.atoms[bytes.atom].status = ownership_heap.atom_status.unknown;
    assert(!ownership_heap.require_empty(ctx, &s, bytes.atom, true));
    assert(s.required_fields[1] == 0);
    // A fresh allocation is no input choice.
    u32 made = fresh_cell(ctx, &s, 5);
    assert(!ownership_heap.require_empty(ctx, &s, made, true));
    // A join keeps a requirement only when each path has it, so one path that stores over q
    // does not settle it for the caller. Equal states need equal requirements.
    ownership_heap.state mut stored = ownership_heap.clone(&entry);
    defer ownership_heap.free_state(&stored);
    assert(ownership_heap.require_empty(ctx, &stored, 1, true));
    assert(ownership_heap.canonical(ctx, &stored));
    assert(ownership_heap.canonical(ctx, &entry));
    ownership_heap.state mut one = ownership_heap.state{};
    defer ownership_heap.free_state(&one);
    assert(ownership_heap.join(ctx, &entry, &stored, false, &one));
    assert(one.required_null == 0);
    ownership_heap.state mut both = ownership_heap.state{};
    defer ownership_heap.free_state(&both);
    assert(ownership_heap.join(ctx, &stored, &stored, false, &both));
    assert(both.required_null == 2);
    ownership_heap.state mut fields = ownership_heap.clone(&stored);
    defer ownership_heap.free_state(&fields);
    fields.required_fields[63] = 4;
    assert(!same(ctx, &fields, &stored));
    ownership_heap.state mut kept = ownership_heap.state{};
    defer ownership_heap.free_state(&kept);
    assert(ownership_heap.join(ctx, &fields, &fields, false, &kept));
    assert(kept.required_fields[63] == 4);
    ownership_heap.state mut dropped = ownership_heap.state{};
    defer ownership_heap.free_state(&dropped);
    assert(ownership_heap.join(ctx, &fields, &stored, false, &dropped));
    assert(dropped.required_fields[63] == 0 && dropped.required_null == 2);
    // A join with bottom keeps the requirements of the other side.
    ownership_heap.state mut none = ownership_heap.bottom(stored.ended.len);
    defer ownership_heap.free_state(&none);
    ownership_heap.state mut lone = ownership_heap.state{};
    defer ownership_heap.free_state(&lone);
    assert(ownership_heap.join(ctx, &none, &fields, false, &lone));
    assert(lone.required_null == 2 && lone.required_fields[63] == 4);
}

// A record whose storage a fold or a graft gives to another record holds no obligation. An
// address of one of its fields can keep it in canonical form, and a use through that address
// finds no live record (`spec/toolchain.md` 4.2).
fn retired_records() void {
    println("records without storage");
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "host");
    ownership_heap.context mut* ctx = &x.ctx;
    ownership_heap.state mut s = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&s);
    // A fold absorbs the inner cell; the address of its field keeps the record, unowned.
    u32 parent = fresh_cell(ctx, &s, 5);
    u32 inner = fresh_cell(ctx, &s, 6);
    set_value(&s, local(6), ownership_heap.empty_value());
    set_value(&s, field_key(ownership_heap.base_kind.cell, parent, 0),
        ownership_heap.own_value(inner));
    set_value(&s, local(7), ownership_heap.address_value(
        field_key(ownership_heap.base_kind.cell, inner, 2)));
    u64 count = obligations(&s);
    assert(ownership_heap.fold(ctx, &s, parent));
    assert(!s.atoms[inner].used && s.atoms[inner].into == parent);
    assert(s.atoms[inner].status == ownership_heap.atom_status.escaped);
    assert(obligations(&s) == count - 1);
    assert(ownership_heap.canonical(ctx, &s));
    ownership_heap.value kept = value_at(&s, local(7));
    assert(kept.kind == ownership_heap.value_kind.address);
    assert(s.atoms[kept.target.id].used);
    assert(s.atoms[kept.target.id].status == ownership_heap.atom_status.escaped);
    assert(obligations(&s) == count - 1);
    // An unowned record that an address brings back keeps no obligation, whatever made it.
    s.atoms[kept.target.id].used = false;
    s.atoms[kept.target.id].status = ownership_heap.atom_status.live;
    assert(ownership_heap.canonical(ctx, &s));
    assert(s.atoms[value_at(&s, local(7)).target.id].status ==
        ownership_heap.atom_status.escaped);
    assert(obligations(&s) == count - 1);
    // A released record stays released.
    s.atoms[value_at(&s, local(7)).target.id].used = false;
    s.atoms[value_at(&s, local(7)).target.id].status = ownership_heap.atom_status.released;
    assert(ownership_heap.canonical(ctx, &s));
    assert(s.atoms[value_at(&s, local(7)).target.id].status ==
        ownership_heap.atom_status.released);
    // `unowned` changes a live or unknown record only.
    s.atoms[parent].status = ownership_heap.atom_status.leaked;
    ownership_heap.unowned(&s, parent);
    assert(s.atoms[parent].status == ownership_heap.atom_status.leaked);
    s.atoms[parent].status = ownership_heap.atom_status.unknown;
    ownership_heap.unowned(&s, parent);
    assert(s.atoms[parent].status == ownership_heap.atom_status.escaped);
}

// The statuses that a retired argument takes, by the facts of the callee exit.
fn retire_case(bool moved, bool released, bool root_released, ownership_heap.atom_status root,
    ownership_heap.atom_status member) void {
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "host");
    ownership_heap.context mut* ctx = &x.ctx;
    ownership_heap.state mut s = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&s);
    u32 b = fresh_cell(ctx, &s, 5);
    u32 m = fresh_cell(ctx, &s, 6);
    set_value(&s, local(6), ownership_heap.empty_value());
    set_value(&s, field_key(ownership_heap.base_kind.cell, b, 0), ownership_heap.own_value(m));
    ownership_heap.value mut view = ownership_heap.empty_value();
    view.kind = ownership_heap.value_kind.view;
    assert(ownership_heap.add_source(&view, m));
    set_value(&s, local(7), view);
    bool mut@ own part = new(bool, s.atoms_len);
    defer del(part);
    ownership_heap.owned_from(&s, b, part);
    assert(part[b] && part[m]);
    ownership_heap.retire(&s, part[..], b, moved, released, root_released);
    assert(s.atoms[b].status == root && s.atoms[m].status == member);
    assert(s.atoms[b].used == !moved && !s.atoms[m].used);
    assert(ownership_heap.find_slot(&s, field_key(ownership_heap.base_kind.cell, b, 0)) ==
        ownership_heap.U64_MAX);
    assert(ownership_heap.find_slot(&s, field_key(ownership_heap.base_kind.cell, m, 0)) ==
        ownership_heap.U64_MAX);
    // A moved record leaves each view; a member view of a released one gains a doubt.
    ownership_heap.value after = value_at(&s, local(7));
    if (moved && !released) {
        assert(after.kind == ownership_heap.value_kind.unknown);
    } else if (moved) {
        assert(after.kind == ownership_heap.value_kind.view && after.count == 1);
        assert(s.atoms[after.sources[0]].status == ownership_heap.atom_status.maybe_released);
    } else {
        assert(after.kind == ownership_heap.value_kind.view && after.sources[0] == m);
    }
    assert(obligations(&s) == 4);
}

fn retired_arguments() void {
    println("retired arguments");
    // The storage moved, and no path released any of it.
    retire_case(true, false, false, ownership_heap.atom_status.escaped,
        ownership_heap.atom_status.escaped);
    // Some path released a member or the root.
    retire_case(true, true, false, ownership_heap.atom_status.maybe_released,
        ownership_heap.atom_status.maybe_released);
    // Each path released the root.
    retire_case(true, true, true, ownership_heap.atom_status.released,
        ownership_heap.atom_status.maybe_released);
    // No exit atom holds the storage: each path released it.
    retire_case(false, true, false, ownership_heap.atom_status.released,
        ownership_heap.atom_status.released);
}

fn known(bool truth) ownership_heap.value {
    ownership_heap.value mut v = ownership_heap.scalar_value();
    v.known = true;
    v.truth = truth;
    return v;
}

fn number(i64 n) ownership_heap.value {
    ownership_heap.value mut v = ownership_heap.scalar_value();
    v.numbered = true;
    v.number = n;
    return v;
}

fn call_at(u32 line, string callee) ownership_heap.crossed_call {
    return ownership_heap.crossed_call{.source = ownership_api.source_position{0, 0, line, 5,
        line, 9, true}, .callee = callee};
}

// A witness crosses each fort call whose summary applies, and it names each crossed call: a
// state keeps them in source order, each once, and at most CROSS_LIMIT of them (D17.18). A join
// names the calls of both sides, and a state that would name more validates nothing.
fn crossed_calls() void {
    println("crossed calls");
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "host");
    ownership_heap.context mut* ctx = &x.ctx;
    ownership_heap.state mut s = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&s);
    assert(s.crossed_len == 0);
    assert(ownership_heap.add_crossed(&s, call_at(7, "late")));
    assert(ownership_heap.add_crossed(&s, call_at(3, "early")));
    assert(ownership_heap.add_crossed(&s, call_at(7, "late")));
    assert(s.crossed_len == 2 && s.crossed[0].source.line == 3 && s.crossed[1].source.line == 7);
    assert(s.crossed[0].callee == "early");
    // A copy keeps the calls; another call makes it a different state.
    ownership_heap.state mut other = ownership_heap.clone(&s);
    defer ownership_heap.free_state(&other);
    assert(other.crossed_len == 2 && same(ctx, &s, &other));
    assert(ownership_heap.add_crossed(&other, call_at(5, "middle")));
    assert(!same(ctx, &s, &other));
    // A state that crosses one call more, after the others, differs too.
    ownership_heap.state mut longer = ownership_heap.clone(&s);
    defer ownership_heap.free_state(&longer);
    assert(ownership_heap.add_crossed(&longer, call_at(9, "after")));
    assert(longer.crossed_len == 3 && !same(ctx, &s, &longer));
    // The join names the calls of each side, in source order.
    ownership_heap.state mut joined = ownership_heap.state{};
    defer ownership_heap.free_state(&joined);
    assert(ownership_heap.join(ctx, &s, &other, false, &joined));
    assert(joined.witness && joined.crossed_len == 3 && joined.crossed[1].callee == "middle");
    // The limit: one call more than a state can name.
    u32 mut k = other.crossed_len;
    while (k < ownership_heap.CROSS_LIMIT) {
        assert(ownership_heap.add_crossed(&other, call_at(20 + k, "more")));
        k += 1;
    }
    assert(other.crossed_len == ownership_heap.CROSS_LIMIT);
    assert(!ownership_heap.add_crossed(&other, call_at(99, "last")));
    assert(ownership_heap.add_crossed(&other, call_at(3, "early")));
    assert(ownership_heap.add_crossed(&s, call_at(98, "other")));
    ownership_heap.state mut full = ownership_heap.state{};
    defer ownership_heap.free_state(&full);
    assert(ownership_heap.join(ctx, &other, &s, false, &full));
    assert(!full.witness);
}

// A write that the proof does not follow can write each top-level scalar local whose storage a
// FIR address names. So the state forgets the known value of each such local there
// (`havoc_reachable`). Any other local keeps its value.
fn addressed_values() void {
    println("values that a call can write");
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "addressed");
    ownership_heap.context mut* ctx = &x.ctx;
    // Local 1 is the parameter, 2 is `j`, whose address `p` (3) holds, and 4 is `k`.
    assert(!ctx->addressed[1] && ctx->addressed[2] && !ctx->addressed[3] && !ctx->addressed[4]);
    ownership_heap.state mut s = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&s);
    set_value(&s, local(1), number(4));
    set_value(&s, local(2), number(5));
    set_value(&s, local(4), number(7));
    ownership_heap.havoc_reachable(ctx, &s, false);
    assert(!value_at(&s, local(2)).numbered);
    assert(value_at(&s, local(1)).number == 4 && value_at(&s, local(4)).number == 7);
    // A known truth value of an addressed local goes too.
    set_value(&s, local(2), known(true));
    ownership_heap.havoc_reachable(ctx, &s, false);
    assert(!value_at(&s, local(2)).known);
    // An unknown effect through the address of a local forgets its value, as each slot below
    // the address gets an unknown value. Another local keeps its value.
    set_value(&s, local(2), number(5));
    assert(!ownership_heap.havoc_prefix(&s, local(2)));
    assert(!value_at(&s, local(2)).numbered);
    assert(value_at(&s, local(4)).number == 7);
}

// A join keeps a free root by the choice rule only when one choice atom differs between the
// two paths: the joined state then holds each value of that input with the rest of each path.
// Two differing inputs can be correlated, so both become joined (`spec/toolchain.md` 4.2).
fn forks() void {
    println("joins of refined inputs");
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "host");
    ownership_heap.context mut* ctx = &x.ctx;
    ownership_heap.state mut a = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&a);
    assert(ownership_heap.canonical(ctx, &a));
    ownership_heap.atom p = a.atoms[0];
    ownership_heap.atom mut q = a.atoms[0];
    q.root = ownership_heap.root_kind.nonnull;
    assert(ownership_heap.choice_split(p, q, true, true));
    assert(!ownership_heap.choice_split(p, q, true, false));
    assert(!ownership_heap.choice_split(p, p, true, true));
    ownership_heap.atom mut lost = q;
    lost.root = ownership_heap.root_kind.joined;
    assert(!ownership_heap.choice_split(p, lost, true, true));
    ownership_heap.atom mut fresh = q;
    fresh.choice = false;
    assert(!ownership_heap.choice_split(p, fresh, true, true));
    // One input differs: it stays a free choice.
    ownership_heap.state mut one = ownership_heap.clone(&a);
    defer ownership_heap.free_state(&one);
    one.atoms[0].root = ownership_heap.root_kind.nonnull;
    ownership_heap.state mut single = ownership_heap.state{};
    defer ownership_heap.free_state(&single);
    assert(ownership_heap.join(ctx, &a, &one, false, &single));
    assert(single.atoms[0].root == ownership_heap.root_kind.free);
    assert(single.atoms[1].root == ownership_heap.root_kind.free);
    // Two inputs differ: neither stays free.
    ownership_heap.state mut two = ownership_heap.clone(&one);
    defer ownership_heap.free_state(&two);
    two.atoms[1].root = ownership_heap.root_kind.nonnull;
    ownership_heap.state mut both = ownership_heap.state{};
    defer ownership_heap.free_state(&both);
    assert(ownership_heap.join(ctx, &a, &two, false, &both));
    assert(both.atoms[0].root == ownership_heap.root_kind.joined);
    assert(both.atoms[1].root == ownership_heap.root_kind.joined);
    assert(both.atoms[2].root == ownership_heap.root_kind.free);
    // A side without a witness takes no choice rule at all.
    ownership_heap.state mut blind = ownership_heap.clone(&one);
    defer ownership_heap.free_state(&blind);
    blind.witness = false;
    ownership_heap.state mut seen = ownership_heap.state{};
    defer ownership_heap.free_state(&seen);
    assert(ownership_heap.join(ctx, &a, &blind, false, &seen));
    assert(seen.atoms[0].root == ownership_heap.root_kind.joined);
}

fn rejoin_of(string name, u32 block) u32 {
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, name);
    assert(ownership_heap.lay_out_rejoins(&x.ctx));
    return x.ctx.rejoin[cast(block, u64)];
}

fn rejoins() void {
    println("branch rejoins");
    // A diamond rejoins at the block after both arms.
    u32 diamond = rejoin_of("diamond", 0);
    assert(diamond != ownership_heap.NONE && diamond > 0);
    // A loop on an untracked condition has a cycle, so its branch rejoins nowhere.
    fixture mut l = fixture{};
    defer close(&l);
    open(&l, "looping");
    assert(ownership_heap.lay_out_rejoins(&l.ctx));
    u64 mut b = 0;
    while (b < l.ctx.rejoin.len) {
        assert(l.ctx.rejoin[b] == ownership_heap.NONE);
        b += 1;
    }
    // A branch with an aborting arm, or with a call, rejoins nowhere.
    assert(rejoin_of("aborting", 0) == ownership_heap.NONE);
    assert(rejoin_of("calling", 0) == ownership_heap.NONE);
    // A nested branch rejoins inside its outer arm, and the outer branch rejoins after it.
    fixture mut n = fixture{};
    defer close(&n);
    open(&n, "nested");
    assert(ownership_heap.lay_out_rejoins(&n.ctx));
    u64 mut found = 0;
    b = 0;
    while (b < n.ctx.rejoin.len) {
        if (n.ctx.rejoin[b] != ownership_heap.NONE) { found += 1; }
        b += 1;
    }
    assert(found == 2);
    // A check has no edge to the exit: a check that fails for known values ends its path when
    // the state reaches it, so a branch around one rejoins.
    fixture mut a = fixture{};
    defer close(&a);
    open(&a, "asserting");
    u32[4] mut out = {};
    assert(ownership_heap.successors(a.ctx.f, 0, fir.block_count(a.ctx.f), out[..]) == 1);
    assert(out[0] != fir.block_count(a.ctx.f));
    assert(rejoin_of("asserting", 0) == ownership_heap.NONE);
    assert(rejoin_of("divide_arm", 0) != ownership_heap.NONE);
    assert(rejoin_of("index_arm", 0) != ownership_heap.NONE);
}

fn main() i32 {
    tables();
    keys();
    integers();
    entry_state();
    unfold_fold();
    canonical_form();
    joins();
    widening();
    covers();
    tests();
    requirements();
    retired_records();
    retired_arguments();
    crossed_calls();
    addressed_values();
    forks();
    rejoins();
    println("heap state ok");
    return 0;
}
