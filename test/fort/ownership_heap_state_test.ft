    scalar_write_footprint();
    scalar_write_type_work();
    fallback_write_footprint();
    param_write_bits();
    reference_scan_work();
    written_reference_flags();
    written_storage();
    written_storage_refusal();
    global_footprint_reach();
    parameter_footprint_select();
    owned_cycle_work();
    unfold_fold();
    canonical_form();
    joins();
    widening();
    covers();
    tests();
    requirements();
    walks();
    requirement_joins();
    requirement_checks();
    lost_requirements();
    retyped();
    escapes();
    escape_bits();
    copied_references();
    copied_leaf_work();
    branch_forms();
    println("heap state ok");
    return 0;
}
