//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| lattice tables
//| keys and views
//| known integers
//| the entry state
//| summary write footprints
//| scalar write footprint
//| fallback write footprint
//| parameter write bits
//| reference scan work
//| written reference flags
//| written storage
//| written storage refusal
//| global footprint reach
//| parameter footprint select
//| owned cycle work
//| unfold and fold
//| canonical form
//| joins keep obligations
//| widening removes cells
//| precision covers
//| null tests
//| caller requirements
//| requirement walks
//| requirement joins
//| requirement checks
//| lost requirements
//| storage of another type
//| a cast pointer that leaves the body
//| copied references
//| copied leaf work
//| branch forms
//| heap state ok
/// Checks the state operations of the heap proof one at a time (D17.16, D17.18, fir.md 14.1).
import ast;
import diag;
import fir;
import ownership_api;
import ownership_facts;
import ownership_heap;
import ownership_heap_env;
import ownership_limits;
import prim;
import types;

string[16] HOST = {
    "struct node { node mut* own next; u8 mut@ own bytes; i32 v; }",
    "struct holder { node mut* own first; node mut* own second; }",
    "fn host(node mut* own p, node mut* own q, holder mut* h, u8@ view) void {",
    "    node mut* own a = null; node mut* own b = null; node* w = null;",
    "    u8 small = 0; i8 tiny = 0; u64 wide = 0; i64 sign = 0; }",
    "fn diamond(bool c) i32 { i32 mut x = 0; if (c) { x = 1; } else { x = 2; } return x; }",
    "fn looping(u64 n) u64 { u64 mut i = 0; while (i < n) { i += 1; } return i; }",
    "fn aborting(bool c) i32 { i32 mut x = 0; if (c) { panic(\"no\"); } return x; }",
    "fn calling(bool c) i32 { i32 mut x = 0; if (c) { x = leaf(); } return x; }",
    "fn leaf() i32 { return 1; }",
    "fn nested(bool c, bool d) i32 { i32 mut x = 0; if (c) { if (d) { x = 1; } x += 1; }",
    "    return x; }",
    "fn asserting(bool c) i32 { assert(c); return 1; }",
    "fn checked(u8 x) u8 { return x + 1; }",
    "fn unused() void { }",
    "fn empty() void { }",
};

string[11] NAMES = {"host", "diamond", "looping", "aborting", "calling", "leaf", "nested",
    "asserting", "checked", "unused", "empty"};

struct fixture {
    ownership_heap_env.closure c;
    ownership_heap.context ctx;
}

fn open(fixture mut* x, string name) void {
    ownership_heap_env.open(&x->c, HOST[..], NAMES[..]);
    ownership_heap_env.context_of(&x->c, name, &x->ctx);
}

fn close(fixture mut* x) void {
    ownership_heap.free_context(&x->ctx);
    ownership_heap_env.close(&x->c);
}

fn local(u32 n) ownership_heap.slot_key {
    return ownership_heap.key_of(ownership_heap.base_kind.local, n);
}

fn field_key(ownership_heap.base_kind base, u32 id, u32 k) ownership_heap.slot_key {
    ownership_heap.slot_key mut key = ownership_heap.key_of(base, id);
    assert(ownership_heap.extend(&key, k));
    return key;
}

fn value_at(ownership_heap.state* s, ownership_heap.slot_key k) ownership_heap.value {
    u64 at = ownership_heap.find_slot(s, k);
    assert(at != ownership_heap.U64_MAX);
    return s->slots[at].v;
}

fn set_value(ownership_heap.state mut* s, ownership_heap.slot_key k, ownership_heap.value v)
    void {
    u64 at = ownership_heap.find_slot(s, k);
    assert(at != ownership_heap.U64_MAX);
    s->slots[at].v = v;
}

// The live obligations of a state: used atoms with a live or unknown status and a root that
// can be nonnull.
fn obligations(ownership_heap.state* s) u64 {
    u64 mut n = 0;
    u64 mut i = 0;
    while (i < s->atoms_len) {
        ownership_heap.atom a = s->atoms[i];
        if (a.used && a.root.value != ownership_facts.root_kind.null_root &&
            (a.status.value == ownership_facts.atom_status.live ||
            a.status.value == ownership_facts.atom_status.unknown)) { n += 1; }
        i += 1;
    }
    return n;
}

fn cells(ownership_heap.state* s) u64 {
    u64 mut n = 0;
    u64 mut i = 0;
    while (i < s->atoms_len) {
        if (s->atoms[i].used && s->atoms[i].kind == ownership_heap.atom_kind.cell) { n += 1; }
        i += 1;
    }
    return n;
}

fn same(ownership_heap.context mut* ctx, ownership_heap.state* a, ownership_heap.state* b) bool {
    bool mut out = false;
    assert(ownership_heap.equal(ctx, a, b, &out));
    return out;
}

// A fresh cell of `node` in local `n`, with its reference leaves empty.
fn fresh_cell(ownership_heap.context mut* ctx, ownership_heap.state mut* s, u32 n) u32 {
    types.node* t = s->atoms[0].ty;
    ownership_heap.atom mut a = ownership_heap.new_atom(ownership_heap.atom_kind.cell, t,
        ownership_heap.shape_of(ctx, t), ownership_facts.root_kind.nonnull,
        ownership_facts.provenance.established);
    a.fresh = true;
    u32 made = ownership_heap.push_atom(s, a);
    ownership_heap.add_cell_slots(ctx, s, made, t);
    set_value(s, local(n), ownership_heap.own_value(made));
    return made;
}

// Two cell atoms and two owning slots. The first atom owns the second through its first slot.
fn nested_havoc_state(ownership_heap.state mut* s) ownership_heap.slot_key {
    u32 parent = ownership_heap.push_atom(s, ownership_heap.new_atom(
        ownership_heap.atom_kind.cell, null, 0, ownership_facts.root_kind.nonnull,
        ownership_facts.provenance.established));
    u32 child = ownership_heap.push_atom(s, ownership_heap.new_atom(
        ownership_heap.atom_kind.cell, null, 0, ownership_facts.root_kind.nonnull,
        ownership_facts.provenance.established));
    assert(parent == 0 && child == 1);
    ownership_heap.slot_key parent_field =
        field_key(ownership_heap.base_kind.cell, parent, 0);
    ownership_heap.slot_key child_field =
        field_key(ownership_heap.base_kind.cell, child, 0);
    ownership_heap.push_slot(s, ownership_heap.slot{.key = parent_field, .owning = true,
        .v = ownership_heap.own_value(child)});
    ownership_heap.push_slot(s, ownership_heap.slot{.key = child_field, .owning = true,
        .v = ownership_heap.empty_value()});
    return ownership_heap.key_of(ownership_heap.base_kind.cell, parent);
}

fn tables() void {
    println("lattice tables");
    ownership_facts.root_kind[4] roots = {ownership_facts.root_kind.null_root,
        ownership_facts.root_kind.nonnull, ownership_facts.root_kind.free,
        ownership_facts.root_kind.joined};
    u64 mut i = 0;
    while (i < roots.len) {
        u64 mut j = 0;
        while (j < roots.len) {
            ownership_facts.root_kind r = ownership_facts.join_root(roots[i], roots[j]);
            if (i == j) {
                assert(r == roots[i]);
            } else {
                assert(r == ownership_facts.root_kind.joined);
            }
            assert(r == ownership_facts.join_root(roots[j], roots[i]));
            j += 1;
        }
        i += 1;
    }
    ownership_facts.atom_status[6] all = {ownership_facts.atom_status.live,
        ownership_facts.atom_status.released, ownership_facts.atom_status.maybe_released,
        ownership_facts.atom_status.leaked, ownership_facts.atom_status.escaped,
        ownership_facts.atom_status.unknown};
    i = 0;
    while (i < all.len) {
        u64 mut j = 0;
        while (j < all.len) {
            ownership_facts.atom_status st = ownership_facts.join_status(all[i], all[j]);
            assert(st == ownership_facts.join_status(all[j], all[i]));
            if (i == j) { assert(st == all[i]); }
            j += 1;
        }
        i += 1;
    }
    // A release on one path and a live allocation on the other is a possible release.
    assert(ownership_facts.join_status(ownership_facts.atom_status.live,
        ownership_facts.atom_status.released) == ownership_facts.atom_status.maybe_released);
    // An unknown or escaped side makes the join unknown.
    assert(ownership_facts.join_status(ownership_facts.atom_status.escaped,
        ownership_facts.atom_status.live) == ownership_facts.atom_status.unknown);
    // A reported loss on one side keeps the other side checked.
    assert(ownership_facts.join_status(ownership_facts.atom_status.leaked,
        ownership_facts.atom_status.released) == ownership_facts.atom_status.released);
    assert(ownership_heap.certainty_of(ownership_facts.root_kind.nonnull) ==
        ownership_api.certainty.definite);
    assert(ownership_heap.certainty_of(ownership_facts.root_kind.free) ==
        ownership_api.certainty.choice);
    assert(ownership_heap.certainty_of(ownership_facts.root_kind.joined) ==
        ownership_api.certainty.possible);
    // The zero of a certainty claims nothing.
    ownership_api.event_descriptor zero = ownership_api.event_descriptor{};
    assert(zero.certainty == ownership_api.certainty.possible);
    assert(ownership_heap.bit(0) == 1 && ownership_heap.bit(63) != 0);
    assert(ownership_heap.bit(64) == 0);
    assert(ownership_heap.grow(0, 1) == 8 && ownership_heap.grow(8, 9) == 16);
    assert(ownership_heap.grow(16, 3) == 16);
    // A join of two refined values of one free choice is a joined root: the join keeps no
    // choice that a path selected.
    ownership_heap.atom mut x = ownership_heap.new_atom(ownership_heap.atom_kind.region, null, 0,
        ownership_facts.root_kind.nonnull, ownership_facts.provenance.established);
    x.choice = true;
    ownership_heap.atom mut y = x;
    y.root.value = ownership_facts.root_kind.null_root;
    assert(ownership_heap.join_atom(x, y).root.value == ownership_facts.root_kind.joined);
    assert(ownership_heap.join_atom(x, y).choice);
    y.root.value = ownership_facts.root_kind.free;
    assert(ownership_heap.join_atom(x, y).root.value == ownership_facts.root_kind.joined);
    y.root.value = ownership_facts.root_kind.null_root;
    y.choice = false;
    assert(ownership_heap.join_atom(x, y).root.value == ownership_facts.root_kind.joined);
    // A null root holds no allocation, so the other side gives the status.
    ownership_heap.atom mut gone = x;
    gone.status.value = ownership_facts.atom_status.released;
    assert(ownership_heap.join_atom(gone, y).status.value ==
        ownership_facts.atom_status.released);
    // A new atom takes one provenance for its root and its status. A join keeps the weaker
    // provenance of each fact, and a null root gives no status provenance to the join.
    assert(x.root.how == ownership_facts.provenance.established);
    assert(x.status.how == ownership_facts.provenance.established);
    ownership_heap.atom mut weak = x;
    weak.root.how = ownership_facts.provenance.assumed;
    weak.status.how = ownership_facts.provenance.imported;
    ownership_heap.atom both = ownership_heap.join_atom(x, weak);
    assert(both.root.how == ownership_facts.provenance.assumed);
    assert(both.status.how == ownership_facts.provenance.imported);
    assert(ownership_heap.join_atom(x, x).root.how ==
        ownership_facts.provenance.established);
    y.status.how = ownership_facts.provenance.assumed;
    ownership_heap.atom kept = ownership_heap.join_atom(gone, y);
    assert(kept.status.value == ownership_facts.atom_status.released);
    assert(kept.status.how == ownership_facts.provenance.established);
    assert(ownership_heap.join_atom(y, gone).status.how ==
        ownership_facts.provenance.established);
    // Different kinds join to an opaque atom with no template.
    ownership_heap.atom mut f = ownership_heap.new_atom(ownership_heap.atom_kind.flat, null, 0,
        ownership_facts.root_kind.nonnull, ownership_facts.provenance.established);
    ownership_heap.atom k = ownership_heap.join_atom(x, f);
    assert(k.kind == ownership_heap.atom_kind.opaque && k.shape == 0);
    // Handles survive only when both sides name one entry path.
    x.handle = 2;
    f.handle = 3;
    assert(ownership_heap.join_atom(x, f).handle == ownership_heap.NONE);
    assert(ownership_heap.join_atom(x, x).handle == 2);
    // One handle with two paths, or with two depths, keeps no entry path, and the join clears the
    // path too.
    x.handle_depth = 2;
    x.handle_path[0] = 1;
    x.handle_path[1] = 4;
    ownership_heap.atom mut y2 = x;
    assert(ownership_heap.join_atom(x, y2).handle == 2);
    assert(ownership_heap.join_atom(x, y2).handle_depth == 2);
    y2.handle_path[1] = 5;
    ownership_heap.atom split = ownership_heap.join_atom(x, y2);
    assert(split.handle == ownership_heap.NONE && split.handle_depth == 0);
    assert(split.handle_path[0] == 0 && split.handle_path[1] == 0);
    assert(!ownership_heap.same_atom(x, y2));
    y2 = x;
    y2.handle_depth = 1;
    assert(ownership_heap.join_atom(x, y2).handle == ownership_heap.NONE);
    assert(!ownership_heap.same_atom(x, y2));
    // A field past the depth names no path: only the first `handle_depth` fields count.
    y2 = x;
    y2.handle_path[2] = 7;
    assert(ownership_heap.join_atom(x, y2).handle == 2 && ownership_heap.same_atom(x, y2));
    // A dereference covers the entry root only when it covers it on each path.
    x.entry_required = true;
    y2 = x;
    assert(ownership_heap.join_atom(x, y2).entry_required);
    y2.entry_required = false;
    assert(!ownership_heap.join_atom(x, y2).entry_required);
    assert(!ownership_heap.join_atom(y2, x).entry_required);
    assert(!ownership_heap.same_atom(x, y2));
    // The fact is about the root: a join that drops the entry path keeps it, and a record that
    // loses its path keeps it.
    y2 = x;
    y2.handle = 3;
    assert(ownership_heap.join_atom(x, y2).entry_required);
    assert(ownership_heap.join_atom(x, y2).handle == ownership_heap.NONE);
    ownership_heap.clear_handle(&y2);
    assert(y2.entry_required && y2.handle == ownership_heap.NONE && y2.handle_depth == 0);
}

fn keys() void {
    println("keys and views");
    ownership_heap.slot_key mut k = local(3);
    u32 mut i = 0;
    while (i < 6) {
        assert(ownership_heap.extend(&k, i));
        i += 1;
    }
    assert(k.depth == 6);
    // The seventh field is past the path bound.
    assert(!ownership_heap.extend(&k, 6));
    assert(k.depth == 6);
    ownership_heap.slot_key head = field_key(ownership_heap.base_kind.cell, 4, 1);
    ownership_heap.slot_key mut out = ownership_heap.slot_key{};
    u32[6] mut path = {};
    path[0] = 2;
    path[1] = 3;
    assert(ownership_heap.rebase(head, 2, path, &out));
    assert(out.depth == 3 && out.path[0] == 1 && out.path[1] == 2 && out.path[2] == 3);
    assert(ownership_heap.prefix_of(head, out) && !ownership_heap.prefix_of(out, head));
    assert(ownership_heap.prefix_of(head, head));
    assert(!ownership_heap.prefix_of(field_key(ownership_heap.base_kind.cell, 5, 1), out));
    assert(!ownership_heap.rebase(k, 1, path, &out));
    assert(ownership_heap.key_order(local(1), local(2)) < 0);
    assert(ownership_heap.key_order(local(2), field_key(ownership_heap.base_kind.local, 2, 0)) < 0);
    assert(ownership_heap.key_order(local(9), ownership_heap.key_of(
        ownership_heap.base_kind.caller, 0)) < 0);
    assert(ownership_heap.key_order(ownership_heap.key_of(ownership_heap.base_kind.caller, 7),
        ownership_heap.key_of(ownership_heap.base_kind.cell, 0)) < 0);
    assert(ownership_heap.key_order(head, head) == 0 && ownership_heap.same_key(head, head));
    assert(!ownership_heap.same_key(head, out));
    // A view keeps at most eight sources; the ninth fails and a caller makes it unknown.
    ownership_heap.value mut v = ownership_heap.empty_value();
    v.kind = ownership_heap.value_kind.view;
    u32 mut s = 0;
    while (s < 8) {
        assert(ownership_heap.add_source(&v, 20 - s));
        s += 1;
    }
    assert(ownership_heap.add_source(&v, 20));
    assert(!ownership_heap.add_source(&v, 1));
    assert(v.count == 8);
    ownership_heap.sort_sources(&v);
    assert(v.sources[0] == 13 && v.sources[7] == 20);
    ownership_heap.remove_source(&v, 15);
    assert(v.count == 7 && v.sources[2] == 16);
    ownership_heap.value mut w = v;
    assert(ownership_heap.same_value(v, w));
    w.exact = true;
    assert(!ownership_heap.same_value(v, w));
    w = v;
    w.param = 1;
    assert(!ownership_heap.same_value(v, w));
    assert(ownership_heap.same_value(ownership_heap.own_value(3), ownership_heap.own_value(3)));
    assert(!ownership_heap.same_value(ownership_heap.own_value(3), ownership_heap.own_value(4)));
    assert(!ownership_heap.same_value(ownership_heap.empty_value(),
        ownership_heap.unknown_value()));
    // An empty value has a null root. An operation of the body establishes it for `null_value`;
    // `empty_value` assumes it. A comparison reads the provenance, so a weaker fact is a change
    // that runs a block again (D17.18).
    ownership_heap.value assumed_empty = ownership_heap.empty_value();
    ownership_heap.value null_empty = ownership_heap.null_value();
    assert(assumed_empty.nullness.value == ownership_facts.root_kind.null_root);
    assert(assumed_empty.nullness.how == ownership_facts.provenance.assumed);
    assert(null_empty.kind == ownership_heap.value_kind.empty);
    assert(null_empty.nullness.value == ownership_facts.root_kind.null_root);
    assert(null_empty.nullness.how == ownership_facts.provenance.established);
    assert(!ownership_heap.same_value(assumed_empty, null_empty));
    assert(!ownership_heap.same_value(null_empty, assumed_empty));
    assert(ownership_heap.same_value(null_empty, ownership_heap.null_value()));
    ownership_heap.value mut imported_empty = null_empty;
    imported_empty.nullness.how = ownership_facts.provenance.imported;
    assert(!ownership_heap.same_value(imported_empty, null_empty));
    assert(!ownership_heap.same_value(imported_empty, assumed_empty));
    ownership_heap.value outside = ownership_heap.external_view();
    assert(outside.nullness.value == ownership_facts.root_kind.joined);
    assert(outside.nullness.how == ownership_facts.provenance.assumed);
    w = v;
    w.nullness.how = ownership_facts.provenance.established;
    assert(!ownership_heap.same_value(v, w));
    w.nullness.how = v.nullness.how;
    assert(ownership_heap.same_value(v, w));
    w.nullness.value = ownership_facts.root_kind.nonnull;
    assert(!ownership_heap.same_value(v, w));
    // An address keeps the fact that it gets, and a comparison of addresses reads it.
    ownership_facts.nullness fact = ownership_facts.nullness{ownership_facts.root_kind.nonnull,
        ownership_facts.provenance.established};
    ownership_heap.value at = ownership_heap.address_value(local(2), fact);
    assert(at.kind == ownership_heap.value_kind.address);
    assert(ownership_heap.same_key(at.target, local(2)));
    assert(at.nullness.value == fact.value && at.nullness.how == fact.how);
    ownership_heap.value mut other = at;
    assert(ownership_heap.same_value(at, other));
    other.nullness = ownership_facts.nullness{ownership_facts.root_kind.free,
        ownership_facts.provenance.assumed};
    assert(!ownership_heap.same_value(at, other));
    other.nullness = ownership_facts.nullness{ownership_facts.root_kind.nonnull,
        ownership_facts.provenance.assumed};
    assert(!ownership_heap.same_value(at, other));
    assert(!ownership_heap.same_value(other, at));
    ownership_heap.value mut t1 = ownership_heap.scalar_value();
    t1.known = true;
    t1.truth = true;
    ownership_heap.value mut t2 = t1;
    t2.truth = false;
    assert(!ownership_heap.same_value(t1, t2));
    t2 = t1;
    t2.numbered = true;
    t2.number = 7;
    assert(!ownership_heap.same_value(t1, t2));
}

fn integers() void {
    println("known integers");
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "host");
    fir.func* f = x.ctx.f;
    // The locals after the parameters and the three named owners: small, tiny, wide, sign.
    types.node* small = fir.local_at(f, 8)->ty;
    types.node* tiny = fir.local_at(f, 9)->ty;
    types.node* wide = fir.local_at(f, 10)->ty;
    types.node* sign = fir.local_at(f, 11)->ty;
    assert(ownership_heap.numbered_in(255, small).numbered);
    assert(!ownership_heap.numbered_in(256, small).numbered);
    assert(!ownership_heap.numbered_in(-1, small).numbered);
    assert(ownership_heap.numbered_in(-128, tiny).numbered);
    assert(!ownership_heap.numbered_in(-129, tiny).numbered);
    assert(!ownership_heap.numbered_in(128, tiny).numbered);
    assert(ownership_heap.numbered_in(9223372036854775807, wide).numbered);
    assert(!ownership_heap.numbered_in(-1, wide).numbered);
    assert(ownership_heap.numbered_in(-9223372036854775807 - 1, sign).numbered);
    assert(!ownership_heap.numbered_in(1, null).numbered);
    assert(ownership_heap.numbered_in(4, sign).number == 4);
}

fn entry_state() void {
    println("the entry state");
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "host");
    ownership_heap.context mut* ctx = &x.ctx;
    // p, q, h->first, h->second: four owned interface leaves in fixed-slot order.
    assert(ctx->interface_len == 4 && ctx->callers_len == 1);
    assert(ctx->interface[0].kind == ownership_heap.atom_kind.region);
    assert(ctx->interface[2].key.base == ownership_heap.base_kind.caller);
    assert(ctx->interface[2].key.depth == 1 && ctx->interface[2].key.path[0] == 0);
    ownership_heap.state mut s = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&s);
    assert(s.reached && s.atoms_len == 4);
    u64 mut i = 0;
    while (i < 4) {
        ownership_heap.atom a = s.atoms[i];
        assert(a.root.value == ownership_facts.root_kind.free && a.choice);
        // An entry fact is an input of the caller, so the proof assumes it.
        assert(a.root.how == ownership_facts.provenance.assumed);
        assert(a.status.how == ownership_facts.provenance.assumed);
        assert(a.origin == ownership_heap.bit(i));
        assert(a.handle == cast(i, u32) && a.handle_depth == 0 && !a.strict);
        i += 1;
    }
    assert(value_at(&s, local(1)).kind == ownership_heap.value_kind.owned);
    ownership_heap.value h = value_at(&s, local(3));
    assert(h.kind == ownership_heap.value_kind.address && h.param == 3);
    assert(h.target.base == ownership_heap.base_kind.caller && h.target.id == 0);
    assert(h.nullness.value == ownership_facts.root_kind.free);
    assert(h.nullness.how == ownership_facts.provenance.assumed);
    ownership_heap.value view = value_at(&s, local(4));
    assert(view.kind == ownership_heap.value_kind.view && view.external && view.param == 4);
    assert(view.nullness.value == ownership_facts.root_kind.free);
    assert(view.nullness.how == ownership_facts.provenance.assumed);
    assert(value_at(&s, local(5)).kind == ownership_heap.value_kind.empty);
    assert(value_at(&s, local(5)).nullness.how == ownership_facts.provenance.assumed);
    // The address of a local is nonnull. The storage that a parameter designates is an input
    // choice. A cell index past the atoms names no cell.
    ownership_facts.nullness own_address = ownership_heap.address_fact(&s, local(5));
    assert(own_address.value == ownership_facts.root_kind.nonnull);
    assert(own_address.how == ownership_facts.provenance.established);
    ownership_facts.nullness param_address = ownership_heap.address_fact(&s,
        ownership_heap.key_of(ownership_heap.base_kind.caller, 0));
    assert(param_address.value == ownership_facts.root_kind.free);
    assert(param_address.how == ownership_facts.provenance.assumed);
    ownership_facts.nullness lost_address = ownership_heap.address_fact(&s,
        ownership_heap.key_of(ownership_heap.base_kind.cell, 4));
    assert(lost_address.value == ownership_facts.root_kind.free);
    assert(lost_address.how == ownership_facts.provenance.assumed);
    assert(value_at(&s, local(8)).kind == ownership_heap.value_kind.scalar);
    // A copy of the state is equal to it and owns separate storage.
    ownership_heap.state mut copy = ownership_heap.clone(&s);
    defer ownership_heap.free_state(&copy);
    assert(same(ctx, &s, &copy));
    copy.atoms[0].root.value = ownership_facts.root_kind.nonnull;
    assert(!same(ctx, &s, &copy));
    assert(s.atoms[0].root.value == ownership_facts.root_kind.free);
    // A graft keeps the value of each nullness fact that a callee gives. The caller imports a
    // fact that the callee established, and it assumes a fact that the callee assumed.
    u32[1] no_atoms = {};
    ownership_heap.slot_key[1] no_storage = {};
    ownership_heap.argument@ no_arguments = {};
    ownership_heap.value empty = ownership_heap.graft_value(ctx, &s, &s,
        ownership_heap.null_value(), no_atoms[..], no_storage[..], no_arguments);
    assert(empty.kind == ownership_heap.value_kind.empty);
    assert(empty.nullness.value == ownership_facts.root_kind.null_root);
    assert(empty.nullness.how == ownership_facts.provenance.imported);
    ownership_heap.value guess = ownership_heap.graft_value(ctx, &s, &s,
        ownership_heap.empty_value(), no_atoms[..], no_storage[..], no_arguments);
    assert(guess.nullness.value == ownership_facts.root_kind.null_root);
    assert(guess.nullness.how == ownership_facts.provenance.assumed);
    ownership_heap.value mut text = ownership_heap.external_view();
    text.nullness = ownership_facts.nullness{ownership_facts.root_kind.nonnull,
        ownership_facts.provenance.established};
    ownership_heap.value seen = ownership_heap.graft_value(ctx, &s, &s, text, no_atoms[..],
        no_storage[..], no_arguments);
    assert(seen.kind == ownership_heap.value_kind.view && seen.external);
    assert(seen.nullness.value == ownership_facts.root_kind.nonnull);
    assert(seen.nullness.how == ownership_facts.provenance.imported);
}

// A summary write footprint forgets only the caller storage that its missing effects can reach.
fn write_footprints() void {
    println("summary write footprints");
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "host");
    ownership_heap.context mut* ctx = &x.ctx;
    ownership_heap.argument@ no_args = {};
    ownership_heap.leaf_list mut no_leaves = ownership_heap.leaf_list{};

    // An indirect global write reaches a cell that an earlier effect exposed. It forgets the
    // cell contents. It does not release the cell.
    ownership_heap.state mut global_state = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&global_state);
    u32 global_cell = fresh_cell(ctx, &global_state, 5);
    global_state.atoms[global_cell].exposed = true;
    ownership_heap.slot_key global_field =
        field_key(ownership_heap.base_kind.cell, global_cell, 0);
    assert(value_at(&global_state, global_field).kind == ownership_heap.value_kind.empty);
    ownership_heap.summary mut global_sum = ownership_heap.summary{.global_writes = true};
    assert(ownership_heap.propagate_write_footprint(ctx, &global_sum, no_args, &no_leaves));
    assert(ownership_heap.apply_write_footprint(ctx, &global_state, &global_sum, no_args,
        &no_leaves));
    assert(ctx->global_writes);
    assert(value_at(&global_state, global_field).kind == ownership_heap.value_kind.owned);
    assert(global_state.atoms[global_cell].status.value == ownership_facts.atom_status.live);

    // A by-value aggregate write follows its matching reference leaf. It does not expose or
    // release the cell.
    ownership_heap.state mut leaf_state = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&leaf_state);
    u32 leaf_cell = fresh_cell(ctx, &leaf_state, 5);
    ownership_heap.value mut view = ownership_heap.empty_value();
    view.kind = ownership_heap.value_kind.view;
    view.param = 3;
    assert(ownership_heap.add_source(&view, leaf_cell));
    ownership_heap.argument[1] mut args = {
        ownership_heap.argument{.aggregate = true, .first = 0, .count = 1},
    };
    ownership_heap.leaf_list mut leaves = ownership_heap.leaf_list{};
    leaves.items = new(ownership_heap.leaf, 1);
    defer ownership_heap.free_leaves(&leaves);
    leaves.items[0].v = view;
    leaves.len = 1;
    ownership_heap.summary mut leaf_sum = ownership_heap.summary{};
    leaf_sum.view_writes = ownership_heap.bit(1);
    ownership_heap.slot_key leaf_field = field_key(ownership_heap.base_kind.cell, leaf_cell, 0);
    assert(value_at(&leaf_state, leaf_field).kind == ownership_heap.value_kind.empty);
    assert(ownership_heap.propagate_write_footprint(ctx, &leaf_sum, args[..], &leaves));
    assert(ownership_heap.apply_write_footprint(ctx, &leaf_state, &leaf_sum, args[..], &leaves));
    assert((ctx->view_writes & ownership_heap.bit(3)) != 0);
    assert(value_at(&leaf_state, leaf_field).kind == ownership_heap.value_kind.owned);
    assert(!leaf_state.atoms[leaf_cell].exposed);
    assert(leaf_state.atoms[leaf_cell].status.value == ownership_facts.atom_status.live);

    // A direct reference parameter uses the exact summary post-state. This footprint does not
    // forget its storage.
    ownership_heap.state mut direct_state = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&direct_state);
    u32 direct_cell = fresh_cell(ctx, &direct_state, 5);
    ownership_heap.value mut direct_view = ownership_heap.empty_value();
    direct_view.kind = ownership_heap.value_kind.view;
    direct_view.param = 4;
    assert(ownership_heap.add_source(&direct_view, direct_cell));
    ownership_heap.argument[1] direct_args = {ownership_heap.argument{.v = direct_view}};
    ownership_heap.summary mut direct_sum = ownership_heap.summary{};
    direct_sum.view_writes = ownership_heap.bit(1);
    ownership_heap.slot_key direct_field =
        field_key(ownership_heap.base_kind.cell, direct_cell, 0);
    assert(ownership_heap.propagate_write_footprint(ctx, &direct_sum, direct_args[..],
        &no_leaves));
    assert(ownership_heap.apply_write_footprint(ctx, &direct_state, &direct_sum, direct_args[..],
        &no_leaves));
    assert((ctx->view_writes & ownership_heap.bit(4)) != 0);
    assert(value_at(&direct_state, direct_field).kind == ownership_heap.value_kind.empty);
}

// A write through a by-value pointer leaf cannot put a retained reference in scalar storage.
fn scalar_write_footprint() void {
    println("scalar write footprint");
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "host");
    ownership_heap.state mut s = ownership_heap.initial(&x.ctx);
    defer ownership_heap.free_state(&s);
    u64 scalar_slot = ownership_heap.find_slot(&s, local(8));
    assert(scalar_slot != ownership_heap.U64_MAX);
    types.node* scalar_type = s.slots[scalar_slot].ty;
    assert(!types.type_is_reference(scalar_type));
    u64 reference_slot = ownership_heap.find_slot(&s, local(4));
    assert(reference_slot != ownership_heap.U64_MAX);
    types.node* scalar_reference = s.slots[reference_slot].ty;
    assert(types.type_is_reference(scalar_reference));
    assert(scalar_reference->elem == scalar_type);
    ownership_heap.atom mut scalar = ownership_heap.new_atom(ownership_heap.atom_kind.flat,
        scalar_type, 0, ownership_facts.root_kind.nonnull,
        ownership_facts.provenance.established);
    scalar.used = true;
    scalar.borrows = false;
    scalar.params = false;
    u32 scalar_atom = ownership_heap.push_atom(&s, scalar);
    ownership_heap.value mut view = ownership_heap.empty_value();
    view.kind = ownership_heap.value_kind.view;
    view.param = 1;
    assert(ownership_heap.add_source(&view, scalar_atom));
    ownership_heap.argument[1] args = {
        ownership_heap.argument{.aggregate = true, .first = 0, .count = 1},
    };
    ownership_heap.leaf_list mut leaves = ownership_heap.leaf_list{};
    leaves.items = new(ownership_heap.leaf, 1);
    defer ownership_heap.free_leaves(&leaves);
    leaves.items[0].ty = scalar_reference;
    leaves.items[0].v = view;
    leaves.len = 1;
    ownership_heap.summary mut sum = ownership_heap.summary{};
    sum.view_writes = ownership_heap.bit(1);
    assert(ownership_heap.apply_write_footprint(&x.ctx, &s, &sum, args[..], &leaves));
    assert(!s.atoms[scalar_atom].borrows);
    assert(!s.atoms[scalar_atom].params);
}

// A shared aggregate type pays once for each occurrence. A refused charge changes no atom fact.
fn scalar_write_type_work() void {
    types.table mut type_table = types.table{};
    defer types.type_table_free(&type_table);
    ast.arena mut node_arena = ast.arena{};
    defer ast.ast_arena_free(&node_arena);
    ast.sym[9] mut declarations = {};
    types.node*[9] mut levels = {};
    types.node* integer = types.type_prim(&type_table, prim.prim_kind.prim_i32);
    diag.loc where = diag.loc{};
    u64 mut i = 0;
    while (i < levels.len) {
        declarations[i].kind = ast.sym_kind.s_struct;
        declarations[i].node = ast.ast_new(&node_arena, ast.ast_kind.k_struct_decl, where);
        levels[i] = types.type_struct(&type_table, "shared", cast(&declarations[i], void mut*));
        types.node* field_type = i == 0 ? integer : levels[i - 1];
        ast.node mut* first = ast.ast_new(&node_arena, ast.ast_kind.k_field_decl, where);
        first->ty = field_type;
        ast.ast_push(declarations[i].node, first);
        if (i > 0) {
            ast.node mut* second = ast.ast_new(&node_arena, ast.ast_kind.k_field_decl, where);
            second->ty = field_type;
            ast.ast_push(declarations[i].node, second);
        }
        i += 1;
    }
    types.node* through = types.type_ptr(&type_table, levels[8], false, true);

    fixture mut complete = fixture{};
    defer close(&complete);
    open(&complete, "empty");
    ownership_heap.atom mut selected = ownership_heap.atom{};
    u64 before = complete.c.counts.meter.used.w;
    assert(ownership_heap.retain_written_reference(&complete.ctx, &selected, through));
    assert(complete.c.counts.meter.used.w == before + 1533);
    assert(!selected.borrows && !selected.params);

    fixture mut refused = fixture{};
    defer close(&refused);
    open(&refused, "empty");
    ownership_heap.state mut refused_state = ownership_heap.state{};
    defer ownership_heap.free_state(&refused_state);
    assert(ownership_heap.push_atom(&refused_state, ownership_heap.atom{}) == 0);
    ownership_heap.value mut target = ownership_heap.empty_value();
    target.kind = ownership_heap.value_kind.view;
    assert(ownership_heap.add_source(&target, 0));
    refused.c.counts.deny_at = refused.c.counts.total_calls + 5;
    assert(!ownership_heap.havoc_written_storage(&refused.ctx, &refused_state, target, through,
        false));
    assert(refused.ctx.stopped);
    assert(!refused_state.atoms[0].borrows && !refused_state.atoms[0].params);
    assert(!refused_state.atoms[0].exposed);
    assert(refused.ctx.first_incomplete.terminal.reason ==
        ownership_api.incomplete_reason.work_limit);

    // A wide struct uses one paid declaration traversal. Refuse the last declaration-child
    // charge before the scan reads that child.
    ast.sym mut wide_declaration = ast.sym{};
    wide_declaration.kind = ast.sym_kind.s_struct;
    wide_declaration.node = ast.ast_new(&node_arena, ast.ast_kind.k_struct_decl, where);
    u64 mut field = 0;
    while (field < 10000) {
        ast.node mut* item = ast.ast_new(&node_arena, ast.ast_kind.k_field_decl, where);
        item->ty = integer;
        ast.ast_push(wide_declaration.node, item);
        field += 1;
    }
    types.node* wide = types.type_struct(&type_table, "wide",
        cast(&wide_declaration, void mut*));
    types.node* wide_through = types.type_ptr(&type_table, wide, false, true);
    fixture mut wide_refused = fixture{};
    defer close(&wide_refused);
    open(&wide_refused, "empty");
    ownership_heap.atom mut wide_selected = ownership_heap.atom{};
    wide_refused.c.counts.deny_at = wide_refused.c.counts.total_calls + 20000;
    assert(!ownership_heap.retain_written_reference(&wide_refused.ctx, &wide_selected,
        wide_through));
    assert(wide_refused.c.counts.total_calls == wide_refused.c.counts.deny_at);
    assert(!wide_selected.borrows && !wide_selected.params);
    assert(wide_refused.ctx.first_incomplete.terminal.reason ==
        ownership_api.incomplete_reason.work_limit);
}

// A usable summary keeps its transitive write footprint when an unused formal cannot bind to a
// null actual. The caller applies the unknown state effect but still publishes the footprint.
fn fallback_write_footprint() void {
    println("fallback write footprint");
    string mut@ own text = new(string, 6);
    defer del(text);
    text[0] = "struct peer { i32* p; }";
    text[1] = "peer mut* mut saved = null;";
    text[2] = "fn keep(peer mut* p) void { saved = p; }";
    text[3] = "fn clear(peer mut* unused) void { saved->p = null; }";
    text[4] = "fn wrapper() void { clear(null); }";
    text[5] = "fn empty() void { }";
    string[4] names = {"keep", "clear", "wrapper", "empty"};
    ownership_heap_env.closure mut c = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&c);
    ownership_heap_env.run(&c, text[..], names[..]);
    assert(ownership_heap_env.proved(&c, "clear"));
    assert(ownership_heap_env.proved(&c, "wrapper"));
    assert(ownership_heap_env.summary(&c, "clear")->callers.len > 0);
    assert(ownership_heap_env.summary(&c, "clear")->global_writes);
    assert(ownership_heap_env.summary(&c, "wrapper")->global_writes);

    // One exposed cell and its one slot pay one atom unit and two prefix units.
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "empty");
    ownership_heap.state mut s = ownership_heap.state{};
    defer ownership_heap.free_state(&s);
    s.slots = new(ownership_heap.slot, 1);
    s.slots_len = 1;
    s.slots[0].key = field_key(ownership_heap.base_kind.cell, 0, 0);
    s.atoms = new(ownership_heap.atom, 1);
    s.atoms_len = 1;
    s.atoms[0].used = true;
    s.atoms[0].kind = ownership_heap.atom_kind.cell;
    s.atoms[0].exposed = true;
    ownership_heap.summary mut footprint = ownership_heap.summary{.global_writes = true};
    ownership_heap.argument@ no_args = {};
    ownership_heap.leaf_list mut no_leaves = ownership_heap.leaf_list{};
    u64 mut before = x.c.counts.meter.used.w;
    assert(ownership_heap.propagate_write_footprint(&x.ctx, &footprint, no_args, &no_leaves));
    assert(ownership_heap.apply_write_footprint(&x.ctx, &s, &footprint, no_args, &no_leaves));
    assert(x.c.counts.meter.used.w == before + 3);

    // An argument and its aggregate leaf each pay in propagation and application.
    ownership_heap.argument[1] args = {
        ownership_heap.argument{.aggregate = true, .first = 0, .count = 1},
    };
    ownership_heap.leaf_list mut leaves = ownership_heap.leaf_list{};
    leaves.items = new(ownership_heap.leaf, 1);
    defer ownership_heap.free_leaves(&leaves);
    leaves.items[0].v = ownership_heap.empty_value();
    leaves.len = 1;
    ownership_heap.summary mut parameter = ownership_heap.summary{};
    parameter.view_writes = ownership_heap.bit(1);
    before = x.c.counts.meter.used.w;
    assert(ownership_heap.propagate_write_footprint(&x.ctx, &parameter, args[..], &leaves));
    assert(ownership_heap.apply_write_footprint(&x.ctx, &s, &parameter, args[..], &leaves));
    assert(x.c.counts.meter.used.w == before + 4);

    // The prefix scan pays 3 units. Its escape pays 3 descendant-walk units and 2 atom units.
    fixture mut nested = fixture{};
    defer close(&nested);
    open(&nested, "empty");
    ownership_heap.state mut nested_state = ownership_heap.state{};
    defer ownership_heap.free_state(&nested_state);
    ownership_heap.slot_key prefix = nested_havoc_state(&nested_state);
    before = nested.c.counts.meter.used.w;
    assert(ownership_heap.havoc_written_prefix(&nested.ctx, &nested_state, prefix));
    assert(nested.c.counts.meter.used.w == before + 8);
    assert(nested_state.atoms[1].status.value == ownership_facts.atom_status.escaped);

    // Refuse the last nested atom unit. The footprint stops and keeps the W exhaustion.
    fixture mut refused = fixture{};
    defer close(&refused);
    open(&refused, "empty");
    ownership_heap.state mut refused_state = ownership_heap.state{};
    defer ownership_heap.free_state(&refused_state);
    ownership_heap.slot_key refused_prefix = nested_havoc_state(&refused_state);
    refused.c.counts.deny_at = refused.c.counts.total_calls + 7;
    assert(!ownership_heap.havoc_written_prefix(&refused.ctx, &refused_state, refused_prefix));
    assert(refused.ctx.stopped);
    assert(refused_state.atoms[1].status.value == ownership_facts.atom_status.live);
    assert(refused.ctx.first_incomplete.terminal.reason ==
        ownership_api.incomplete_reason.work_limit);

    // Refuse the first descendant-slot unit. The ownership walk stops before it reads the slot.
    fixture mut descendant_refused = fixture{};
    defer close(&descendant_refused);
    open(&descendant_refused, "empty");
    ownership_heap.state mut descendant_state = ownership_heap.state{};
    defer ownership_heap.free_state(&descendant_state);
    ownership_heap.slot_key descendant_prefix = nested_havoc_state(&descendant_state);
    descendant_refused.c.counts.deny_at = descendant_refused.c.counts.total_calls + 4;
    assert(!ownership_heap.havoc_written_prefix(&descendant_refused.ctx, &descendant_state,
        descendant_prefix));
    assert(descendant_refused.ctx.stopped);
    assert(descendant_state.atoms[1].status.value == ownership_facts.atom_status.live);
    assert(descendant_refused.ctx.first_incomplete.terminal.reason ==
        ownership_api.incomplete_reason.work_limit);
}

// The W units that the meter of `x` used.
fn used_w(fixture* x) u64 { return x->c.counts.meter.used.w; }

// Pushes `cells` cell atoms. Each cell has one borrowed reference slot of type `ty` that holds an
// empty value. Each cell starts with clear retained-reference flags.
fn reference_cells(ownership_heap.state mut* s, u32 cells, types.node* ty) void {
    u32 mut i = 0;
    while (i < cells) {
        ownership_heap.atom mut a = ownership_heap.new_atom(ownership_heap.atom_kind.cell, null,
            0, ownership_facts.root_kind.nonnull, ownership_facts.provenance.established);
        a.borrows = false;
        a.params = false;
        u32 made = ownership_heap.push_atom(s, a);
        ownership_heap.push_slot(s, ownership_heap.slot{
            .key = field_key(ownership_heap.base_kind.cell, made, 0), .ty = ty,
            .v = ownership_heap.empty_value()});
        i += 1;
    }
}

// The kind of the value in the one slot of cell `a`.
fn cell_kind(ownership_heap.state* s, u32 a) ownership_heap.value_kind {
    return value_at(s, field_key(ownership_heap.base_kind.cell, a, 0)).kind;
}

// A view of the one atom `a`, from parameter `param`.
fn view_of(u32 a, u32 param) ownership_heap.value {
    ownership_heap.value mut v = ownership_heap.empty_value();
    v.kind = ownership_heap.value_kind.view;
    v.param = param;
    assert(ownership_heap.add_source(&v, a));
    return v;
}

// A struct type with one declaration child for each entry of `types_of`. A child is a field
// when its entry of `fields` is true. Otherwise it is a child of another kind with that type.
fn struct_of(types.table mut* tt, ast.arena mut* nodes, ast.sym mut* declaration,
    types.node*@ types_of, bool@ fields) types.node* {
    diag.loc where = diag.loc{};
    declaration->kind = ast.sym_kind.s_struct;
    declaration->node = ast.ast_new(nodes, ast.ast_kind.k_struct_decl, where);
    u64 mut i = 0;
    while (i < types_of.len) {
        ast.ast_kind kind = fields[i] ? ast.ast_kind.k_field_decl : ast.ast_kind.k_compile_if;
        ast.node mut* item = ast.ast_new(nodes, kind, where);
        item->ty = types_of[i];
        ast.ast_push(declaration->node, item);
        i += 1;
    }
    return types.type_struct(tt, "probe", cast(declaration, void mut*));
}

// The W units of one reference scan of `t`. `found` takes the result of the scan.
fn scan_units(fixture mut* x, types.node* t, bool mut* found) u64 {
    u64 before = used_w(x);
    assert(ownership_heap.has_reference_paid(&x->ctx, t, found));
    return used_w(x) - before;
}

// A write records one footprint bit for each parameter from 1 to 63. A parameter from 64 on
// sets the shared high flag, and an unknown parameter sets each bit and the flag.
fn param_write_bits() void {
    println("parameter write bits");
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "empty");
    ownership_heap.context mut* ctx = &x.ctx;
    assert(ctx->view_writes == 0 && !ctx->writes_high);
    // Storage of no parameter records nothing. A read records no write.
    ownership_heap.note_param_write(ctx, ownership_heap.NONE);
    ownership_heap.note_param_read(ctx, 5);
    assert(ctx->view_writes == 0 && !ctx->writes_high);
    ownership_heap.note_param_write(ctx, 1);
    ownership_heap.note_param_write(ctx, 63);
    u64 low = ownership_heap.bit(1) | ownership_heap.bit(63);
    assert(ctx->view_writes == low && !ctx->writes_high);
    // A second write of one parameter changes nothing.
    ownership_heap.note_param_write(ctx, 1);
    assert(ctx->view_writes == low);
    ownership_heap.note_param_write(ctx, 64);
    assert(ctx->view_writes == low && ctx->writes_high);
    ownership_heap.note_param_write(ctx, 200);
    assert(ctx->view_writes == low && ctx->writes_high);

    fixture mut any = fixture{};
    defer close(&any);
    open(&any, "empty");
    ownership_heap.note_param_write(&any.ctx, ownership_heap.ANY_PARAM);
    assert(any.ctx.view_writes == ownership_heap.U64_MAX && any.ctx.writes_high);
    assert(any.ctx.view_reads == 0 && !any.ctx.reads_high);

    // A caller reads one bit for each parameter below 64 and the high flag from 64 on.
    ownership_heap.summary mut sum = ownership_heap.summary{};
    sum.view_writes = ownership_heap.bit(3);
    assert(ownership_heap.writes_param(&sum, 3));
    assert(!ownership_heap.writes_param(&sum, 2));
    assert(!ownership_heap.writes_param(&sum, 4));
    assert(!ownership_heap.writes_param(&sum, 64));
    sum.writes_high = true;
    assert(ownership_heap.writes_param(&sum, 64));
    assert(ownership_heap.writes_param(&sum, 200));
    assert(!ownership_heap.writes_param(&sum, 2));
}

// Each visited type occurrence pays one W unit, and each struct declaration child pays one more
// unit before the scan reads it. A reference field stops the scan.
fn reference_scan_work() void {
    println("reference scan work");
    types.table mut tt = types.table{};
    defer types.type_table_free(&tt);
    ast.arena mut nodes = ast.arena{};
    defer ast.ast_arena_free(&nodes);
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "empty");
    types.node* integer = types.type_prim(&tt, prim.prim_kind.prim_i32);
    types.node* pointer = types.type_ptr(&tt, integer, false, true);
    bool mut found = true;
    // A scalar and a reference each pay one unit.
    assert(scan_units(&x, integer, &found) == 1 && !found);
    assert(scan_units(&x, pointer, &found) == 1 && found);
    // An array pays for itself and for its element type.
    assert(scan_units(&x, types.type_array(&tt, integer, 4), &found) == 2 && !found);
    assert(scan_units(&x, types.type_array(&tt, pointer, 4), &found) == 2 && found);
    // A struct with no declaration has no children to read.
    assert(scan_units(&x, types.type_struct(&tt, "opaque", null), &found) == 1 && !found);

    // Three scalar fields: 1 unit for the struct, then 2 units for each field.
    ast.sym[6] mut declarations = {};
    types.node*[3] three = {integer, integer, integer};
    bool[3] three_fields = {true, true, true};
    types.node* scalars = struct_of(&tt, &nodes, &declarations[0], three[..], three_fields[..]);
    assert(scan_units(&x, scalars, &found) == 7 && !found);
    // The reference in the second field stops the scan. The last 2 fields pay nothing.
    types.node*[4] stop = {integer, pointer, integer, integer};
    bool[4] stop_fields = {true, true, true, true};
    types.node* stopped = struct_of(&tt, &nodes, &declarations[1], stop[..], stop_fields[..]);
    assert(scan_units(&x, stopped, &found) == 5 && found);
    // A child that is not a field pays one unit and starts no type visit, so its type is not
    // read.
    types.node*[2] other = {integer, pointer};
    bool[2] other_fields = {true, false};
    types.node* mixed = struct_of(&tt, &nodes, &declarations[2], other[..], other_fields[..]);
    assert(scan_units(&x, mixed, &found) == 4 && !found);
    // A nested struct pays for its own scan inside the field of the outer struct.
    types.node*[2] nest = {scalars, integer};
    bool[2] nest_fields = {true, true};
    types.node* outer = struct_of(&tt, &nodes, &declarations[3], nest[..], nest_fields[..]);
    assert(scan_units(&x, outer, &found) == 1 + 1 + 7 + 2 && !found);
    // A reference in the nested struct stops the outer scan too.
    types.node*[2] deep = {stopped, integer};
    types.node* deep_outer = struct_of(&tt, &nodes, &declarations[4], deep[..], nest_fields[..]);
    assert(scan_units(&x, deep_outer, &found) == 1 + 1 + 5 && found);

    // A wide scalar struct uses one declaration traversal: 1 unit and 2 units for each of its
    // 1000 fields. A scan that reads an earlier field again pays more.
    types.node* mut@ own wide_types = new(types.node*, 1000);
    defer del(wide_types);
    bool mut@ own wide_fields = new(bool, 1000);
    defer del(wide_fields);
    u64 mut i = 0;
    while (i < 1000) {
        wide_types[i] = integer;
        wide_fields[i] = true;
        i += 1;
    }
    types.node* wide = struct_of(&tt, &nodes, &declarations[5], wide_types, wide_fields);
    assert(scan_units(&x, wide, &found) == 2001 && !found);
    // A second scan of one type node pays again. The scan keeps no memo.
    assert(scan_units(&x, wide, &found) == 2001 && !found);
}

// A footprint adds retained-reference flags only when the written pointee can hold a reference,
// or when the pointee type is unknown or erased.
fn written_reference_flags() void {
    println("written reference flags");
    types.table mut tt = types.table{};
    defer types.type_table_free(&tt);
    ast.arena mut nodes = ast.arena{};
    defer ast.ast_arena_free(&nodes);
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "empty");
    types.node* integer = types.type_prim(&tt, prim.prim_kind.prim_i32);
    types.node* scalar_pointer = types.type_ptr(&tt, integer, false, true);
    types.node* pointer_pointer = types.type_ptr(&tt, scalar_pointer, false, true);
    types.node* scalar_span = types.type_span(&tt, integer, false, true);
    types.node* void_pointer = types.type_voidptr(&tt, false, true);
    ast.sym[1] mut declarations = {};
    types.node*[2] members = {integer, scalar_pointer};
    bool[2] member_fields = {true, true};
    types.node* holder = struct_of(&tt, &nodes, &declarations[0], members[..], member_fields[..]);
    types.node* holder_pointer = types.type_ptr(&tt, holder, false, true);

    // A scalar pointee pays one scan unit and keeps both flags clear.
    ownership_heap.atom mut a = ownership_heap.atom{};
    u64 mut before = used_w(&x);
    assert(ownership_heap.retain_written_reference(&x.ctx, &a, scalar_pointer));
    assert(used_w(&x) == before + 1 && !a.borrows && !a.params);
    assert(ownership_heap.retain_written_reference(&x.ctx, &a, scalar_span));
    assert(!a.borrows && !a.params);
    // A pointee that can hold a reference sets both flags after its scan.
    before = used_w(&x);
    assert(ownership_heap.retain_written_reference(&x.ctx, &a, pointer_pointer));
    assert(used_w(&x) == before + 1 && a.borrows && a.params);
    ownership_heap.atom mut b = ownership_heap.atom{};
    before = used_w(&x);
    assert(ownership_heap.retain_written_reference(&x.ctx, &b, holder_pointer));
    assert(used_w(&x) == before + 5 && b.borrows && b.params);
    // An unknown or erased pointee sets both flags without a scan.
    ownership_heap.atom mut unknown = ownership_heap.atom{};
    before = used_w(&x);
    assert(ownership_heap.retain_written_reference(&x.ctx, &unknown, null));
    assert(used_w(&x) == before && unknown.borrows && unknown.params);
    ownership_heap.atom mut erased = ownership_heap.atom{};
    assert(ownership_heap.retain_written_reference(&x.ctx, &erased, void_pointer));
    assert(used_w(&x) == before && erased.borrows && erased.params);
    // A written type that is not a reference names no pointee, so it is conservative.
    ownership_heap.atom mut plain = ownership_heap.atom{};
    assert(ownership_heap.retain_written_reference(&x.ctx, &plain, integer));
    assert(used_w(&x) == before && plain.borrows && plain.params);
    // The scalar guard does not clear a flag that an earlier effect set.
    ownership_heap.atom mut kept = ownership_heap.atom{.borrows = true, .params = true};
    assert(ownership_heap.retain_written_reference(&x.ctx, &kept, scalar_pointer));
    assert(kept.borrows && kept.params);
}

// A footprint forgets the contents of each storage that a value can designate. It pays one full
// atom scan for each possible root before it reads state. Only a global write exposes the
// storage, and a lost target makes no claim.
fn written_storage() void {
    println("written storage");
    types.table mut tt = types.table{};
    defer types.type_table_free(&tt);
    types.node* integer = types.type_prim(&tt, prim.prim_kind.prim_i32);
    types.node* scalar_pointer = types.type_ptr(&tt, integer, false, true);
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "empty");
    ownership_heap.context mut* ctx = &x.ctx;
    ownership_heap.state mut s = ownership_heap.state{};
    defer ownership_heap.free_state(&s);
    reference_cells(&s, 4, scalar_pointer);
    ownership_heap.value_kind empty = ownership_heap.value_kind.empty;
    ownership_heap.value_kind unknown = ownership_heap.value_kind.unknown;

    // An owned cell pays 5 root units, 1 type unit, and 5 prefix units. The global write exposes
    // it and forgets its slot. The cell stays live, and its scalar pointee adds no flag.
    u64 mut before = used_w(&x);
    assert(ownership_heap.havoc_written_storage(ctx, &s, ownership_heap.own_value(0),
        scalar_pointer, true));
    assert(used_w(&x) == before + 11);
    assert(s.atoms[0].exposed && cell_kind(&s, 0) == unknown);
    assert(s.atoms[0].status.value == ownership_facts.atom_status.live);
    assert(!s.atoms[0].borrows && !s.atoms[0].params);
    assert(cell_kind(&s, 1) == empty && cell_kind(&s, 2) == empty && cell_kind(&s, 3) == empty);
    // A parameter write forgets the slot. It does not expose the cell.
    assert(ownership_heap.havoc_written_storage(ctx, &s, ownership_heap.own_value(1),
        scalar_pointer, false));
    assert(!s.atoms[1].exposed && cell_kind(&s, 1) == unknown);

    // An address pays one root and its prefix scan, and it needs no type scan.
    ownership_heap.value mut address = ownership_heap.empty_value();
    address.kind = ownership_heap.value_kind.address;
    address.target = ownership_heap.key_of(ownership_heap.base_kind.cell, 2);
    before = used_w(&x);
    assert(ownership_heap.havoc_written_storage(ctx, &s, address, scalar_pointer, false));
    assert(used_w(&x) == before + 10);
    assert(!s.atoms[2].exposed && cell_kind(&s, 2) == unknown);
    set_value(&s, field_key(ownership_heap.base_kind.cell, 2, 0), ownership_heap.empty_value());
    assert(ownership_heap.havoc_written_storage(ctx, &s, address, scalar_pointer, true));
    assert(s.atoms[2].exposed && cell_kind(&s, 2) == unknown);

    // A view source that an atom redirect replaced writes the storage of the new atom.
    ownership_heap.atom mut gone = ownership_heap.atom{};
    gone.into = 3;
    u32 redirected = ownership_heap.push_atom(&s, gone);
    s.atoms[redirected].used = false;
    before = used_w(&x);
    assert(ownership_heap.havoc_written_storage(ctx, &s, view_of(redirected, 2), scalar_pointer,
        false));
    // 6 root units, 1 source unit, 1 type unit, and 5 prefix units.
    assert(used_w(&x) == before + 13);
    assert(cell_kind(&s, 3) == unknown && !s.atoms[3].exposed);
    // A view source past the atoms names no storage. It pays its root and its source unit.
    set_value(&s, field_key(ownership_heap.base_kind.cell, 3, 0), ownership_heap.empty_value());
    before = used_w(&x);
    assert(ownership_heap.havoc_written_storage(ctx, &s, view_of(9, 2), scalar_pointer, true));
    assert(used_w(&x) == before + 7 && cell_kind(&s, 3) == empty);

    // An unknown value with a retained target forgets that storage.
    ownership_heap.value mut retained = ownership_heap.unknown_value();
    retained.retained_target = true;
    retained.retained = ownership_heap.key_of(ownership_heap.base_kind.cell, 3);
    assert(ownership_heap.havoc_written_storage(ctx, &s, retained, scalar_pointer, false));
    assert(cell_kind(&s, 3) == unknown);
    // A lost target makes no claim. The caller keeps its fallback, and the proof does not stop.
    ownership_heap.value mut lost = ownership_heap.unknown_value();
    lost.lost_target = true;
    before = used_w(&x);
    assert(!ownership_heap.havoc_written_storage(ctx, &s, lost, scalar_pointer, false));
    assert(used_w(&x) == before && !ctx->stopped);
    // A scalar and an empty value designate no storage and pay nothing.
    ownership_heap.value mut number = ownership_heap.empty_value();
    number.kind = ownership_heap.value_kind.scalar;
    assert(ownership_heap.havoc_written_storage(ctx, &s, number, scalar_pointer, true));
    assert(ownership_heap.havoc_written_storage(ctx, &s, ownership_heap.empty_value(),
        scalar_pointer, true));
    assert(used_w(&x) == before);
}

// A refused type-scan charge of an owned target stops the footprint before exposure or nested
// storage work.
fn written_storage_refusal() void {
    println("written storage refusal");
    types.table mut tt = types.table{};
    defer types.type_table_free(&tt);
    ast.arena mut nodes = ast.arena{};
    defer ast.ast_arena_free(&nodes);
    types.node* integer = types.type_prim(&tt, prim.prim_kind.prim_i32);
    ast.sym[1] mut declarations = {};
    types.node*[2] members = {integer, integer};
    bool[2] member_fields = {true, true};
    types.node* pair = struct_of(&tt, &nodes, &declarations[0], members[..], member_fields[..]);
    types.node* pair_pointer = types.type_ptr(&tt, pair, false, true);
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "empty");
    ownership_heap.state mut s = ownership_heap.state{};
    defer ownership_heap.free_state(&s);
    reference_cells(&s, 1, pair_pointer);
    // Units 1 and 2 are the root scan, and unit 3 is the struct visit. Refuse unit 4, the
    // charge of the first declaration child.
    x.c.counts.deny_at = x.c.counts.total_calls + 4;
    assert(!ownership_heap.havoc_written_storage(&x.ctx, &s, ownership_heap.own_value(0),
        pair_pointer, true));
    assert(x.c.counts.total_calls == x.c.counts.deny_at && x.ctx.stopped);
    assert(!s.atoms[0].exposed && !s.atoms[0].borrows && !s.atoms[0].params);
    assert(cell_kind(&s, 0) == ownership_heap.value_kind.empty);
    assert(x.ctx.first_incomplete.terminal.reason == ownership_api.incomplete_reason.work_limit);
}

// An indirect global write reaches each argument, each caller slot, and each exposed or
// addressed cell. It does not reach a cell that no effect exposed.
fn global_footprint_reach() void {
    println("global footprint reach");
    types.table mut tt = types.table{};
    defer types.type_table_free(&tt);
    types.node* integer = types.type_prim(&tt, prim.prim_kind.prim_i32);
    types.node* scalar_pointer = types.type_ptr(&tt, integer, false, true);
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "empty");
    ownership_heap.state mut s = ownership_heap.state{};
    defer ownership_heap.free_state(&s);
    reference_cells(&s, 5, scalar_pointer);
    s.atoms[0].exposed = true;
    s.atoms[1].addressed = true;
    ownership_heap.argument[2] args = {
        ownership_heap.argument{.v = view_of(3, 1), .ty = scalar_pointer},
        ownership_heap.argument{.aggregate = true, .first = 0, .count = 1},
    };
    ownership_heap.leaf_list mut leaves = ownership_heap.leaf_list{};
    leaves.items = new(ownership_heap.leaf, 1);
    defer ownership_heap.free_leaves(&leaves);
    leaves.items[0].ty = scalar_pointer;
    leaves.items[0].v = view_of(4, 2);
    leaves.len = 1;
    // A summary with no footprint changes nothing.
    ownership_heap.summary none = ownership_heap.summary{};
    assert(ownership_heap.apply_write_footprint(&x.ctx, &s, &none, args[..], &leaves));
    u32 mut i = 0;
    while (i < 5) {
        assert(cell_kind(&s, i) == ownership_heap.value_kind.empty);
        i += 1;
    }
    ownership_heap.summary global = ownership_heap.summary{.global_writes = true};
    assert(ownership_heap.apply_write_footprint(&x.ctx, &s, &global, args[..], &leaves));
    // The exposed and the addressed cells lose their contents. The hidden cell keeps them.
    assert(cell_kind(&s, 0) == ownership_heap.value_kind.unknown);
    assert(cell_kind(&s, 1) == ownership_heap.value_kind.unknown);
    assert(cell_kind(&s, 2) == ownership_heap.value_kind.empty && !s.atoms[2].exposed);
    // A direct argument and an aggregate leaf lose their contents, and the write exposes both.
    assert(cell_kind(&s, 3) == ownership_heap.value_kind.unknown && s.atoms[3].exposed);
    assert(cell_kind(&s, 4) == ownership_heap.value_kind.unknown && s.atoms[4].exposed);
    // A global write changes contents. It releases no cell.
    i = 0;
    while (i < 5) {
        assert(s.atoms[i].status.value == ownership_facts.atom_status.live);
        i += 1;
    }

    // Each caller storage loses its owners. The old owned atom escapes, and a fresh unknown
    // owner takes its slot.
    fixture mut h = fixture{};
    defer close(&h);
    open(&h, "host");
    ownership_heap.state mut entry = ownership_heap.initial(&h.ctx);
    defer ownership_heap.free_state(&entry);
    ownership_heap.slot_key first = field_key(ownership_heap.base_kind.caller, 0, 0);
    ownership_heap.value old = value_at(&entry, first);
    assert(old.kind == ownership_heap.value_kind.owned);
    ownership_heap.argument@ no_args = {};
    ownership_heap.leaf_list mut no_leaves = ownership_heap.leaf_list{};
    assert(ownership_heap.apply_write_footprint(&h.ctx, &entry, &none, no_args, &no_leaves));
    assert(value_at(&entry, first).atom == old.atom);
    assert(ownership_heap.apply_write_footprint(&h.ctx, &entry, &global, no_args, &no_leaves));
    ownership_heap.value now = value_at(&entry, first);
    assert(now.kind == ownership_heap.value_kind.owned && now.atom != old.atom);
    assert(entry.atoms[old.atom].status.value == ownership_facts.atom_status.escaped);
    assert(entry.atoms[now.atom].status.value == ownership_facts.atom_status.unknown);
}

// A parameter footprint follows only the actual leaves of its formal parameter. A wrapper
// publishes it on the parameter of each such leaf.
fn parameter_footprint_select() void {
    println("parameter footprint select");
    types.table mut tt = types.table{};
    defer types.type_table_free(&tt);
    types.node* integer = types.type_prim(&tt, prim.prim_kind.prim_i32);
    types.node* scalar_pointer = types.type_ptr(&tt, integer, false, true);
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "empty");
    ownership_heap.state mut s = ownership_heap.state{};
    defer ownership_heap.free_state(&s);
    reference_cells(&s, 2, scalar_pointer);
    ownership_heap.argument[2] args = {
        ownership_heap.argument{.aggregate = true, .first = 0, .count = 1},
        ownership_heap.argument{.aggregate = true, .first = 1, .count = 1},
    };
    ownership_heap.leaf_list mut leaves = ownership_heap.leaf_list{};
    leaves.items = new(ownership_heap.leaf, 2);
    defer ownership_heap.free_leaves(&leaves);
    leaves.items[0].ty = scalar_pointer;
    leaves.items[0].v = view_of(0, 5);
    leaves.items[1].ty = scalar_pointer;
    leaves.items[1].v = view_of(1, 7);
    leaves.len = 2;
    // The callee writes through its second parameter only.
    ownership_heap.summary mut sum = ownership_heap.summary{};
    sum.view_writes = ownership_heap.bit(2);
    u64 before = used_w(&x);
    assert(ownership_heap.propagate_write_footprint(&x.ctx, &sum, args[..], &leaves));
    // 2 argument units and 1 unit for the leaf of the written parameter.
    assert(used_w(&x) == before + 3);
    assert(x.ctx.view_writes == ownership_heap.bit(7) && !x.ctx.writes_high);
    assert(!x.ctx.global_writes);
    assert(ownership_heap.apply_write_footprint(&x.ctx, &s, &sum, args[..], &leaves));
    assert(cell_kind(&s, 0) == ownership_heap.value_kind.empty);
    assert(cell_kind(&s, 1) == ownership_heap.value_kind.unknown);
    assert(!s.atoms[0].exposed && !s.atoms[1].exposed);

    // A leaf of an unknown parameter publishes a write of each parameter.
    fixture mut any = fixture{};
    defer close(&any);
    open(&any, "empty");
    leaves.items[1].v.param = ownership_heap.ANY_PARAM;
    assert(ownership_heap.propagate_write_footprint(&any.ctx, &sum, args[..], &leaves));
    assert(any.ctx.view_writes == ownership_heap.U64_MAX && any.ctx.writes_high);
    // A direct argument publishes the parameter of its own value.
    fixture mut direct = fixture{};
    defer close(&direct);
    open(&direct, "empty");
    ownership_heap.argument[2] direct_args = {
        ownership_heap.argument{.v = view_of(0, 4)},
        ownership_heap.argument{.v = view_of(1, 6)},
    };
    assert(ownership_heap.propagate_write_footprint(&direct.ctx, &sum, direct_args[..],
        &leaves));
    assert(direct.ctx.view_writes == ownership_heap.bit(6));
}

// The escape walk of a written owner visits each atom of an owned cycle once.
fn owned_cycle_work() void {
    println("owned cycle work");
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "empty");
    ownership_heap.state mut s = ownership_heap.state{};
    defer ownership_heap.free_state(&s);
    ownership_heap.slot_key prefix = nested_havoc_state(&s);
    // Atom 2 owns atom 1, and atom 1 owns atom 2 through the second slot.
    u32 third = ownership_heap.push_atom(&s, ownership_heap.new_atom(
        ownership_heap.atom_kind.cell, null, 0, ownership_facts.root_kind.nonnull,
        ownership_facts.provenance.established));
    assert(third == 2);
    s.slots[1].v = ownership_heap.own_value(third);
    ownership_heap.push_slot(&s, ownership_heap.slot{
        .key = field_key(ownership_heap.base_kind.cell, third, 0), .owning = true,
        .v = ownership_heap.own_value(1)});
    // The prefix pays 1 unit and 3 slot units. The walk pays 2 atom units and 6 slot units, and
    // the escape pays 3 atom units.
    u64 mut before = used_w(&x);
    assert(ownership_heap.havoc_written_prefix(&x.ctx, &s, prefix));
    assert(used_w(&x) == before + 15);
    assert(s.atoms[1].status.value == ownership_facts.atom_status.escaped);
    assert(s.atoms[2].status.value == ownership_facts.atom_status.escaped);
    assert(s.atoms[0].status.value == ownership_facts.atom_status.live);

    // A prefix with no owned value pays only for its direct slot scan.
    fixture mut flat = fixture{};
    defer close(&flat);
    open(&flat, "empty");
    ownership_heap.state mut plain = ownership_heap.state{};
    defer ownership_heap.free_state(&plain);
    reference_cells(&plain, 3, null);
    before = used_w(&flat);
    assert(ownership_heap.havoc_written_prefix(&flat.ctx, &plain,
        ownership_heap.key_of(ownership_heap.base_kind.cell, 1)));
    assert(used_w(&flat) == before + 4);
}

fn unfold_fold() void {
    println("unfold and fold");
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "host");
    ownership_heap.context mut* ctx = &x.ctx;
    ownership_heap.state mut s = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&s);
    ownership_heap.content mut m = ownership_heap.measure(ctx, &s);
    // Four atoms; two regions of one template: 1 + 1 parameter + 2 clauses + 2 descendants.
    // No root is refined, and the deepest slot is a field of caller storage.
    assert(m.r == 4 && m.h == 6 && m.p == 0 && m.d == 1);
    assert(ownership_heap.unfold(ctx, &s, 0));
    assert(s.atoms[0].kind == ownership_heap.atom_kind.cell);
    assert(s.atoms[0].root.value == ownership_facts.root_kind.nonnull);
    // The unfold assumes its nonnull root; a cell address takes the fact of its cell.
    assert(s.atoms[0].root.how == ownership_facts.provenance.assumed);
    ownership_facts.nullness cell_address = ownership_heap.address_fact(&s,
        field_key(ownership_heap.base_kind.cell, 0, 0));
    assert(cell_address.value == ownership_facts.root_kind.nonnull);
    assert(cell_address.how == ownership_facts.provenance.assumed);
    ownership_heap.value next = value_at(&s, field_key(ownership_heap.base_kind.cell, 0, 0));
    ownership_heap.value bytes = value_at(&s, field_key(ownership_heap.base_kind.cell, 0, 1));
    assert(next.kind == ownership_heap.value_kind.owned);
    assert(bytes.kind == ownership_heap.value_kind.owned);
    ownership_heap.atom child = s.atoms[next.atom];
    assert(child.kind == ownership_heap.atom_kind.region);
    assert(child.root.value == ownership_facts.root_kind.free);
    assert(child.root.how == ownership_facts.provenance.assumed);
    assert(child.status.how == ownership_facts.provenance.assumed);
    assert(child.strict && child.choice && child.origin == 1);
    assert(child.handle == 0 && child.handle_depth == 1 && child.handle_path[0] == 0);
    ownership_heap.atom payload = s.atoms[bytes.atom];
    assert(payload.kind == ownership_heap.atom_kind.flat && payload.handle == 0);
    assert(payload.handle_depth == 1 && payload.handle_path[0] == 1);
    // The scalar field has no slot. Two edges now, and the template of q stays. The root of a
    // cell is no refined fact: its kind gives it.
    m = ownership_heap.measure(ctx, &s);
    assert(m.r == 6 && m.h == 8 && m.p == 0);
    s.atoms[1].root.value = ownership_facts.root_kind.null_root;
    assert(ownership_heap.measure(ctx, &s).p == 1);
    s.atoms[1].root.value = ownership_facts.root_kind.free;
    // A child of a strict child is strict. It is the entry value one field deeper: p->next->next.
    assert(ownership_heap.unfold(ctx, &s, next.atom));
    ownership_heap.value deeper = value_at(&s,
        field_key(ownership_heap.base_kind.cell, next.atom, 0));
    assert(s.atoms[deeper.atom].strict && s.atoms[deeper.atom].handle == 0);
    assert(s.atoms[deeper.atom].handle_depth == 2);
    assert(s.atoms[deeper.atom].handle_path[0] == 0 && s.atoms[deeper.atom].handle_path[1] == 0);
    // A member view of p gains each child as a source.
    ownership_heap.value mut member = ownership_heap.empty_value();
    member.kind = ownership_heap.value_kind.view;
    assert(ownership_heap.add_source(&member, 0));
    set_value(&s, local(7), member);
    // The fold puts the children back into p, clears its handle, and keeps its identity.
    assert(ownership_heap.fold(ctx, &s, 0));
    assert(s.atoms[0].kind == ownership_heap.atom_kind.region);
    assert(s.atoms[0].root.value == ownership_facts.root_kind.nonnull);
    assert(s.atoms[0].root.how == ownership_facts.provenance.assumed);
    assert(s.atoms[0].handle == ownership_heap.NONE && s.atoms[0].handle_depth == 0);
    assert(s.atoms[0].origin == 1);
    assert(!s.atoms[next.atom].used && !s.atoms[bytes.atom].used && !s.atoms[deeper.atom].used);
    assert(!s.atoms[0].strict);
    assert(ownership_heap.find_slot(&s, field_key(ownership_heap.base_kind.cell, 0, 0)) ==
        ownership_heap.U64_MAX);
    ownership_heap.value kept = value_at(&s, local(7));
    assert(kept.kind == ownership_heap.value_kind.view && kept.count == 1 && kept.sources[0] == 0);
    // A self-cycle never folds.
    u32 cycle = fresh_cell(ctx, &s, 5);
    set_value(&s, field_key(ownership_heap.base_kind.cell, cycle, 0),
        ownership_heap.own_value(cycle));
    assert(!ownership_heap.fold(ctx, &s, cycle));
    // A released child never folds.
    u32 parent = fresh_cell(ctx, &s, 6);
    u32 inner = fresh_cell(ctx, &s, 7);
    set_value(&s, local(7), ownership_heap.empty_value());
    set_value(&s, field_key(ownership_heap.base_kind.cell, parent, 0),
        ownership_heap.own_value(inner));
    s.atoms[inner].status.value = ownership_facts.atom_status.released;
    assert(!ownership_heap.fold(ctx, &s, parent));
    s.atoms[inner].status.value = ownership_facts.atom_status.live;
    ownership_heap.value mut child_view = ownership_heap.empty_value();
    child_view.kind = ownership_heap.value_kind.view;
    assert(ownership_heap.add_source(&child_view, inner));
    set_value(&s, local(7), ownership_heap.forgotten_value(child_view));
    u64 before_fold = obligations(&s);
    assert(ownership_heap.fold(ctx, &s, parent));
    assert(s.atoms[parent].fresh && !s.atoms[inner].used);
    ownership_heap.value mut retained = value_at(&s, local(7));
    assert(retained.retained_target && retained.retained.id == parent);
    // Canonical form keeps one obligation for this two-node cleanup. It does not restore the
    // absorbed child through the forgotten view.
    assert(ownership_heap.canonical(ctx, &s));
    retained = value_at(&s, local(7));
    ownership_heap.value folded = value_at(&s, local(6));
    assert(retained.retained_target && retained.retained.id == folded.atom);
    assert(obligations(&s) == before_fold - 1);
    // An opaque payload never folds.
    u32 boxed = fresh_cell(ctx, &s, 6);
    ownership_heap.atom mut blob = ownership_heap.new_atom(ownership_heap.atom_kind.opaque, null, 0,
        ownership_facts.root_kind.nonnull, ownership_facts.provenance.established);
    u32 blob_at = ownership_heap.push_atom(&s, blob);
    set_value(&s, field_key(ownership_heap.base_kind.cell, boxed, 1),
        ownership_heap.own_value(blob_at));
    assert(!ownership_heap.fold(ctx, &s, boxed));
}

fn canonical_form() void {
    println("canonical form");
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "host");
    ownership_heap.context mut* ctx = &x.ctx;
    ownership_heap.state mut a = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&a);
    ownership_heap.state mut b = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&b);
    // The same two fresh cells, made in the opposite order.
    u32 a1 = fresh_cell(ctx, &a, 5);
    u32 a2 = fresh_cell(ctx, &a, 6);
    u32 b2 = fresh_cell(ctx, &b, 6);
    u32 b1 = fresh_cell(ctx, &b, 5);
    assert(a1 != b1 && a2 != b2);
    assert(!same(ctx, &a, &b));
    assert(ownership_heap.canonical(ctx, &a));
    assert(ownership_heap.canonical(ctx, &b));
    assert(same(ctx, &a, &b));
    // Canonical form is stable.
    ownership_heap.state mut again = ownership_heap.clone(&a);
    defer ownership_heap.free_state(&again);
    assert(ownership_heap.canonical(ctx, &again));
    assert(same(ctx, &a, &again));
    // A null root leaves its slot; a released record with no view goes.
    again.atoms[0].root = ownership_facts.nullness{ownership_facts.root_kind.null_root,
        ownership_facts.provenance.established};
    u32 last = value_at(&again, local(6)).atom;
    again.atoms[last].status.value = ownership_facts.atom_status.released;
    set_value(&again, local(6), ownership_heap.empty_value());
    u64 before = again.atoms_len;
    assert(ownership_heap.canonical(ctx, &again));
    assert(value_at(&again, local(1)).kind == ownership_heap.value_kind.empty);
    assert(value_at(&again, local(1)).nullness.how == ownership_facts.provenance.established);
    assert(again.atoms_len == before - 1);
    // An interface record keeps its index even when no slot owns it.
    assert(again.atoms[0].kind == ownership_heap.atom_kind.region);
    // A live atom that no slot owns stays: an obligation is never dropped.
    ownership_heap.atom mut orphan = ownership_heap.new_atom(ownership_heap.atom_kind.flat, null, 0,
        ownership_facts.root_kind.nonnull, ownership_facts.provenance.established);
    ownership_heap.push_atom(&again, orphan);
    u64 count = obligations(&again);
    assert(ownership_heap.canonical(ctx, &again));
    assert(obligations(&again) == count);
    // A released record that a view names stays for that view.
    ownership_heap.atom mut dead = orphan;
    dead.status.value = ownership_facts.atom_status.released;
    u32 dead_at = ownership_heap.push_atom(&again, dead);
    ownership_heap.value mut v = ownership_heap.empty_value();
    v.kind = ownership_heap.value_kind.view;
    v.exact = true;
    assert(ownership_heap.add_source(&v, dead_at));
    set_value(&again, local(7), v);
    assert(ownership_heap.canonical(ctx, &again));
    ownership_heap.value seen = value_at(&again, local(7));
    assert(seen.count == 1 && again.atoms[seen.sources[0]].status.value ==
        ownership_facts.atom_status.released);
    // A retained cell target keeps its record and follows the canonical atom map.
    ownership_heap.atom mut skipped = dead;
    u32 skipped_at = ownership_heap.push_atom(&again, skipped);
    u32 retained_at = ownership_heap.push_atom(&again, dead);
    ownership_heap.value mut retained = ownership_heap.forgotten_value(
        ownership_heap.address_value(
            ownership_heap.key_of(ownership_heap.base_kind.cell, retained_at),
            ownership_facts.nullness{ownership_facts.root_kind.nonnull,
                ownership_facts.provenance.established}));
    set_value(&again, local(7), retained);
    u64 atoms_before = again.atoms_len;
    assert(ownership_heap.canonical(ctx, &again));
    retained = value_at(&again, local(7));
    assert(retained.kind == ownership_heap.value_kind.unknown && retained.retained_target);
    assert(retained.retained.base == ownership_heap.base_kind.cell);
    assert(cast(retained.retained.id, u64) < again.atoms_len &&
        retained.retained.id != retained_at);
    assert(again.atoms[retained.retained.id].status.value ==
        ownership_facts.atom_status.released);
    assert(again.atoms_len == atoms_before - 2 && skipped_at != retained_at);
}

fn joins() void {
    println("joins keep obligations");
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "host");
    ownership_heap.context mut* ctx = &x.ctx;
    ownership_heap.state mut a = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&a);
    assert(ownership_heap.canonical(ctx, &a));
    // A join of different storage types keeps no type. Harmonization makes the two cells opaque
    // before their slots can pair.
    types.node* other_ty = fir.local_at(ctx->f, 10)->ty;
    ownership_heap.atom mut different = a.atoms[0];
    different.ty = other_ty;
    assert(ownership_heap.join_atom(a.atoms[0], different).ty == null);
    assert(ownership_heap.join_atom(different, a.atoms[0]).ty == null);
    ownership_heap.state mut type_left = ownership_heap.clone(&a);
    defer ownership_heap.free_state(&type_left);
    ownership_heap.state mut type_right = ownership_heap.clone(&a);
    defer ownership_heap.free_state(&type_right);
    type_right.atoms[0].ty = other_ty;
    assert(ownership_heap.harmonize(ctx, &type_left, &type_right,
        value_at(&type_left, local(1)), value_at(&type_right, local(1)), 0));
    assert(type_left.atoms[0].kind == ownership_heap.atom_kind.opaque);
    assert(type_right.atoms[0].kind == ownership_heap.atom_kind.opaque);
    // A join with itself changes nothing.
    ownership_heap.state mut self_join = ownership_heap.state{};
    defer ownership_heap.free_state(&self_join);
    assert(ownership_heap.join(ctx, &a, &a, false, &self_join));
    assert(same(ctx, &self_join, &a));
    // One path allocates into `a`, the other leaves it empty.
    ownership_heap.state mut b = ownership_heap.clone(&a);
    defer ownership_heap.free_state(&b);
    u32 made = fresh_cell(ctx, &b, 5);
    assert(ownership_heap.canonical(ctx, &b));
    ownership_heap.state mut ab = ownership_heap.state{};
    defer ownership_heap.free_state(&ab);
    assert(ownership_heap.join(ctx, &a, &b, false, &ab));
    ownership_heap.state mut ba = ownership_heap.state{};
    defer ownership_heap.free_state(&ba);
    assert(ownership_heap.join(ctx, &b, &a, false, &ba));
    // The join commutes, keeps the obligation, and forgets the empty path only by a joined root.
    assert(same(ctx, &ab, &ba));
    assert(obligations(&ab) == obligations(&b));
    ownership_heap.value kept = value_at(&ab, local(5));
    assert(kept.kind == ownership_heap.value_kind.owned);
    assert(ab.atoms[kept.atom].root.value == ownership_facts.root_kind.joined);
    // The fold of the cell assumes its nonnull root.
    assert(ab.atoms[kept.atom].root.how == ownership_facts.provenance.assumed);
    // An empty owner on one side gives an assumed null root, so the joined root of a flat atom
    // is assumed even when the other side established its root.
    ownership_heap.state mut flat = ownership_heap.clone(&a);
    defer ownership_heap.free_state(&flat);
    ownership_heap.atom bytes = ownership_heap.new_atom(ownership_heap.atom_kind.flat, null, 0,
        ownership_facts.root_kind.nonnull, ownership_facts.provenance.established);
    set_value(&flat, local(5), ownership_heap.own_value(ownership_heap.push_atom(&flat, bytes)));
    assert(ownership_heap.canonical(ctx, &flat));
    ownership_heap.state mut half = ownership_heap.state{};
    defer ownership_heap.free_state(&half);
    assert(ownership_heap.join(ctx, &a, &flat, false, &half));
    ownership_heap.value one = value_at(&half, local(5));
    assert(one.kind == ownership_heap.value_kind.owned);
    assert(half.atoms[one.atom].kind == ownership_heap.atom_kind.flat);
    assert(half.atoms[one.atom].root.value == ownership_facts.root_kind.joined);
    assert(half.atoms[one.atom].root.how == ownership_facts.provenance.assumed);
    // The cell met an empty slot, so it folded into its template.
    assert(ab.atoms[kept.atom].kind == ownership_heap.atom_kind.region && made >= 4);
    // A join with bottom is the other side.
    ownership_heap.state mut none = ownership_heap.bottom(ab.ended.len);
    defer ownership_heap.free_state(&none);
    ownership_heap.state mut with_bottom = ownership_heap.state{};
    defer ownership_heap.free_state(&with_bottom);
    assert(ownership_heap.join(ctx, &none, &ab, false, &with_bottom));
    assert(same(ctx, &with_bottom, &ab));
    // An interface atom that one path moves keeps no index: its identity splits.
    ownership_heap.state mut moved = ownership_heap.clone(&a);
    defer ownership_heap.free_state(&moved);
    set_value(&moved, local(5), value_at(&moved, local(1)));
    set_value(&moved, local(1), ownership_heap.empty_value());
    ownership_heap.state mut split = ownership_heap.state{};
    defer ownership_heap.free_state(&split);
    assert(ownership_heap.join(ctx, &a, &moved, false, &split));
    assert(obligations(&split) >= obligations(&a));
    assert(value_at(&split, local(1)).kind == ownership_heap.value_kind.owned);
    assert(value_at(&split, local(5)).kind == ownership_heap.value_kind.owned);
    assert(value_at(&split, local(1)).atom != 0 && value_at(&split, local(5)).atom != 0);
    // A released interface record on one path and a live one on the other is a possible release.
    ownership_heap.state mut gone = ownership_heap.clone(&a);
    defer ownership_heap.free_state(&gone);
    gone.atoms[1].status.value = ownership_facts.atom_status.released;
    set_value(&gone, local(2), ownership_heap.empty_value());
    gone.released.bits = 2;
    ownership_heap.state mut either = ownership_heap.state{};
    defer ownership_heap.free_state(&either);
    assert(ownership_heap.join(ctx, &a, &gone, false, &either));
    assert(value_at(&either, local(2)).kind == ownership_heap.value_kind.owned);
    // A release on one path is a possible release after the join.
    assert(either.released.bits == 2 && a.released.bits == 0);
    // A free input choice that one path refined to nonnull and the other to null is a joined
    // root after the join: the join keeps no choice that a path selected.
    ownership_heap.state mut nonnull = ownership_heap.clone(&a);
    defer ownership_heap.free_state(&nonnull);
    nonnull.atoms[0].root = ownership_facts.nullness{ownership_facts.root_kind.nonnull,
        ownership_facts.provenance.established};
    ownership_heap.state mut null_side = ownership_heap.clone(&a);
    defer ownership_heap.free_state(&null_side);
    null_side.atoms[0].root = ownership_facts.nullness{ownership_facts.root_kind.null_root,
        ownership_facts.provenance.established};
    ownership_heap.state mut tested = ownership_heap.state{};
    defer ownership_heap.free_state(&tested);
    assert(ownership_heap.join(ctx, &nonnull, &null_side, false, &tested));
    assert(a.atoms[0].choice && tested.atoms[0].choice);
    assert(tested.atoms[0].root.value == ownership_facts.root_kind.joined);
    // A refined root and the free root of the other path join to a joined root too.
    ownership_heap.state mut half_tested = ownership_heap.state{};
    defer ownership_heap.free_state(&half_tested);
    assert(ownership_heap.join(ctx, &a, &nonnull, false, &half_tested));
    assert(half_tested.atoms[0].root.value == ownership_facts.root_kind.joined);
    // A local that one path ended is possibly ended after the join.
    ownership_heap.state mut ended = ownership_heap.clone(&a);
    defer ownership_heap.free_state(&ended);
    ended.ended[5] = 1;
    ended.escaped[5] = true;
    ownership_heap.state mut maybe = ownership_heap.state{};
    defer ownership_heap.free_state(&maybe);
    assert(ownership_heap.join(ctx, &a, &ended, false, &maybe));
    assert(maybe.ended[5] == 2);
    assert(maybe.escaped[5] && !a.escaped[5]);
    ownership_heap.atom mut addressed = a.atoms[0];
    addressed.address_escaped = true;
    assert(ownership_heap.join_atom(a.atoms[0], addressed).address_escaped);
    // A mixed join maps the retained cell target into the joined atom numbering.
    ownership_heap.state mut left = ownership_heap.clone(&a);
    defer ownership_heap.free_state(&left);
    ownership_heap.state mut right = ownership_heap.clone(&a);
    defer ownership_heap.free_state(&right);
    u32 left_target = fresh_cell(ctx, &left, 6);
    u32 right_extra = fresh_cell(ctx, &right, 5);
    u32 right_target = fresh_cell(ctx, &right, 6);
    ownership_heap.value mut left_view = ownership_heap.empty_value();
    left_view.kind = ownership_heap.value_kind.view;
    assert(ownership_heap.add_source(&left_view, left_target));
    set_value(&left, local(7), left_view);
    ownership_heap.value right_unknown = ownership_heap.forgotten_value(
        ownership_heap.address_value(
            ownership_heap.key_of(ownership_heap.base_kind.cell, right_target),
            ownership_facts.nullness{ownership_facts.root_kind.nonnull,
                ownership_facts.provenance.established}));
    set_value(&right, local(7), right_unknown);
    assert(ownership_heap.canonical(ctx, &left));
    assert(ownership_heap.canonical(ctx, &right));
    ownership_heap.state mut mixed = ownership_heap.state{};
    defer ownership_heap.free_state(&mixed);
    assert(ownership_heap.join(ctx, &left, &right, false, &mixed));
    ownership_heap.value mixed_value = value_at(&mixed, local(7));
    u32 mixed_target = value_at(&mixed, local(6)).atom;
    u32 mixed_extra = value_at(&mixed, local(5)).atom;
    assert(mixed_value.kind == ownership_heap.value_kind.unknown);
    assert(mixed_value.retained_target && !mixed_value.lost_target);
    assert(mixed_value.retained.base == ownership_heap.base_kind.cell);
    assert(mixed_value.retained.id == mixed_target && mixed_target != mixed_extra);
    assert(right_extra != right_target);
}

// A view of the one source atom `a` that reaches the storage of no parameter.
fn source_view(u32 a) ownership_heap.value { return view_of(a, ownership_heap.NONE); }

// Checks a copy of `v` at operation `at`, in the slot of `w` when `keyed`, else in storage
// without a slot. The result is the number of events.
fn copy_events(fixture mut* x, ownership_heap.state mut* s, ownership_heap.value v, u32 at,
    bool keyed) u64 {
    x->ctx.op = ownership_heap.position(&x->ctx, 0, at, false);
    u64 before = x->c.counts.events;
    ownership_heap.location mut loc = ownership_heap.location{};
    loc.kind = keyed ? ownership_heap.location_kind.slots : ownership_heap.location_kind.unknown;
    loc.key = local(7);
    ownership_heap.check_copy(&x->ctx, s, loc, ownership_heap.leaf{.v = v});
    return x->c.counts.events - before;
}

// The last event of the fixture has kind `kind`, certainty `how` and reason `why`.
fn last_event(fixture* x, ownership_api.event_kind kind, ownership_api.certainty how,
    ownership_api.incomplete_reason why) bool {
    ownership_heap_env.event_row row = x->c.counts.rows[x->c.counts.events - 1];
    return row.kind == kind && row.certainty == how && row.reason == why;
}

fn last_text(fixture* x) string {
    return ownership_heap_env.text(&x->c.counts.rows[x->c.counts.events - 1]);
}

fn set_status(ownership_heap.state mut* s, u32 a, ownership_facts.atom_status status) void {
    s->atoms[cast(a, u64)].status = ownership_facts.status_fact{status,
        ownership_facts.provenance.established};
}

// A copy of a reference is a use of it (D17.14). Each kind of value gives the event of its fact.
// A reference that stays valid gives none.
fn copied_references() void {
    println("copied references");
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "host");
    ownership_heap.context mut* ctx = &x.ctx;
    ownership_heap.state mut s = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&s);
    ctx->reporting = true;
    u32 live = fresh_cell(ctx, &s, 5);
    u32 gone = fresh_cell(ctx, &s, 6);
    set_status(&s, gone, ownership_facts.atom_status.released);
    ownership_api.certainty definite = ownership_api.certainty.definite;
    ownership_api.certainty possible = ownership_api.certainty.possible;
    ownership_api.event_kind invalid = ownership_api.event_kind.invalid_use;
    ownership_api.event_kind incomplete = ownership_api.event_kind.incomplete_proof;
    ownership_api.incomplete_reason path = ownership_api.incomplete_reason.missing_path;
    ownership_api.incomplete_reason effect = ownership_api.incomplete_reason.unknown_effect;

    // Null, an input view, and a view of a live or leaked atom need nothing.
    assert(copy_events(&x, &s, ownership_heap.null_value(), 1, true) == 0);
    assert(value_at(&s, local(4)).kind == ownership_heap.value_kind.view);
    assert(copy_events(&x, &s, value_at(&s, local(4)), 2, true) == 0);
    assert(copy_events(&x, &s, source_view(live), 3, true) == 0);
    set_status(&s, live, ownership_facts.atom_status.leaked);
    assert(copy_events(&x, &s, source_view(live), 4, true) == 0);
    set_status(&s, live, ownership_facts.atom_status.live);
    // Each source released: an invalid use of the copied slot, with the released atom.
    assert(copy_events(&x, &s, source_view(gone), 5, true) == 1);
    assert(last_event(&x, invalid, definite, path) && last_text(&x) == "w");
    assert(x.c.counts.rows[x.c.counts.events - 1].relation.ordinal == gone + 1);
    // One released source of two, or a possibly released source: a missing path.
    ownership_heap.value mut both = source_view(live);
    assert(ownership_heap.add_source(&both, gone));
    assert(copy_events(&x, &s, both, 6, true) == 1);
    assert(last_event(&x, incomplete, possible, path));
    set_status(&s, gone, ownership_facts.atom_status.maybe_released);
    assert(copy_events(&x, &s, source_view(gone), 7, true) == 1);
    assert(last_event(&x, incomplete, possible, path));
    set_status(&s, gone, ownership_facts.atom_status.released);
    // A source of unknown status, or one that escaped, can be released by an unknown effect.
    set_status(&s, live, ownership_facts.atom_status.unknown);
    assert(copy_events(&x, &s, source_view(live), 8, true) == 1);
    assert(last_event(&x, incomplete, possible, effect));
    set_status(&s, live, ownership_facts.atom_status.escaped);
    assert(copy_events(&x, &s, source_view(live), 9, true) == 1);
    assert(last_event(&x, incomplete, possible, effect));
    set_status(&s, live, ownership_facts.atom_status.live);

    // An address of a local is valid until the local ends. An ended local gives an invalid use,
    // and a local that ended on some path gives a missing path.
    ownership_heap.value local_address = ownership_heap.address_value(local(8),
        ownership_heap.address_fact(&s, local(8)));
    assert(copy_events(&x, &s, local_address, 10, true) == 0);
    s.ended[8] = 1;
    assert(copy_events(&x, &s, local_address, 11, true) == 1);
    assert(last_event(&x, invalid, definite, path) && last_text(&x) == "w");
    s.ended[8] = 2;
    assert(copy_events(&x, &s, local_address, 12, true) == 1);
    assert(last_event(&x, incomplete, possible, path));
    s.ended[8] = 0;
    // An address of a cell field needs a live or leaked cell. Caller storage stays valid.
    ownership_heap.slot_key gone_field = field_key(ownership_heap.base_kind.cell, gone, 0);
    ownership_heap.value gone_address = ownership_heap.address_value(gone_field,
        ownership_heap.address_fact(&s, gone_field));
    assert(copy_events(&x, &s, gone_address, 13, true) == 1);
    assert(last_event(&x, invalid, definite, path));
    assert(x.c.counts.rows[x.c.counts.events - 1].relation.ordinal == gone + 1);
    ownership_heap.slot_key live_field = field_key(ownership_heap.base_kind.cell, live, 0);
    ownership_heap.value live_address = ownership_heap.address_value(live_field,
        ownership_heap.address_fact(&s, live_field));
    assert(copy_events(&x, &s, live_address, 14, true) == 0);
    set_status(&s, live, ownership_facts.atom_status.leaked);
    assert(copy_events(&x, &s, live_address, 15, true) == 0);
    set_status(&s, live, ownership_facts.atom_status.unknown);
    assert(copy_events(&x, &s, live_address, 16, true) == 1);
    assert(last_event(&x, incomplete, possible, effect));
    set_status(&s, live, ownership_facts.atom_status.live);
    ownership_heap.value caller = value_at(&s, local(3));
    assert(caller.kind == ownership_heap.value_kind.address);
    assert(caller.target.base == ownership_heap.base_kind.caller);
    assert(copy_events(&x, &s, caller, 17, true) == 0);

    // A reference whose facts the body lost gives incomplete proof. An input of the caller does
    // not. The work of an unknown effect does not when that effect made the body residual.
    assert(copy_events(&x, &s, ownership_heap.unknown_value(), 18, true) == 1);
    assert(last_event(&x, incomplete, possible, effect) && last_text(&x) == "w");
    assert(copy_events(&x, &s, ownership_heap.input_value(), 19, true) == 0);
    assert(!ctx->residual);
    assert(copy_events(&x, &s, ownership_heap.effect_value(), 20, true) == 1);
    ctx->residual = true;
    assert(copy_events(&x, &s, ownership_heap.effect_value(), 21, true) == 0);
    assert(copy_events(&x, &s, ownership_heap.unknown_value(), 22, true) == 1);
    ctx->residual = false;
    // A leaf without a slot has a fixed text.
    assert(copy_events(&x, &s, ownership_heap.unknown_value(), 23, false) == 1);
    assert(last_text(&x) == "a reference that this call copies");
    assert(copy_events(&x, &s, source_view(gone), 24, false) == 1);
    assert(last_event(&x, invalid, definite, path));
    assert(last_text(&x) == "a reference that this call copies");
}

// Checks the leaves of `list` at location `loc` and operation `at`. `*events` takes the number
// of events, and the result is the number of W units.
fn leaf_units(fixture mut* x, ownership_heap.state mut* s, ownership_heap.location loc,
    ownership_heap.leaf_list* list, u32 at, u64 mut* events) u64 {
    x->ctx.op = ownership_heap.position(&x->ctx, 0, at, false);
    u64 before = x->c.counts.events;
    u64 units = used_w(x);
    ownership_heap.check_copied_leaves(&x->ctx, s, loc, list);
    *events = x->c.counts.events - before;
    return used_w(x) - units;
}

// Each borrowed leaf of an argument pays one W unit. An owned or scalar leaf pays nothing, and
// the transfer rules follow an owned leaf. Storage without slots keeps the facts of its atoms:
// its leaves need nothing when no atom keeps a reference of the body. The scan of those atoms
// pays one W unit for each argument.
fn copied_leaf_work() void {
    println("copied leaf work");
    types.table mut tt = types.table{};
    defer types.type_table_free(&tt);
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "host");
    ownership_heap.context mut* ctx = &x.ctx;
    ownership_heap.state mut s = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&s);
    ctx->reporting = true;
    u32 gone = fresh_cell(ctx, &s, 6);
    set_status(&s, gone, ownership_facts.atom_status.released);
    types.node* owner = fir.local_at(ctx->f, 1)->ty;
    types.node* view = fir.local_at(ctx->f, 7)->ty;
    types.node* small = fir.local_at(ctx->f, 8)->ty;
    assert(owner->is_own && ownership_heap.is_reference(view) && !view->is_own);
    assert(!ownership_heap.is_reference(small));
    ownership_heap.leaf_list mut list = ownership_heap.leaf_list{};
    defer ownership_heap.free_leaves(&list);
    // An owned leaf with a released view, a scalar, a released borrowed leaf, and an array of
    // references without facts.
    ownership_heap.leaf mut owned = ownership_heap.leaf{.ty = owner, .owning = true};
    owned.v = source_view(gone);
    ownership_heap.push_leaf(&list, owned);
    ownership_heap.push_leaf(&list, ownership_heap.leaf{.ty = small,
        .v = ownership_heap.scalar_value()});
    ownership_heap.leaf mut released = ownership_heap.leaf{.ty = view};
    released.v = source_view(gone);
    ownership_heap.push_leaf(&list, released);
    ownership_heap.push_leaf(&list, ownership_heap.leaf{.ty = types.type_array(&tt, view, 2),
        .array = true, .v = ownership_heap.unknown_value()});
    ownership_heap.location mut slots = ownership_heap.location{};
    slots.kind = ownership_heap.location_kind.slots;
    slots.key = local(7);
    // Two borrowed leaves pay 2 units: an invalid use of `w`, and incomplete proof of the array
    // leaf, which names no slot.
    u64 mut events = 0;
    assert(leaf_units(&x, &s, slots, &list, 1, &events) == 2 && events == 2);
    ownership_heap_env.event_row first = x.c.counts.rows[x.c.counts.events - 2];
    assert(first.kind == ownership_api.event_kind.invalid_use);
    assert(ownership_heap_env.text(&first) == "w");
    assert(last_event(&x, ownership_api.event_kind.incomplete_proof,
        ownership_api.certainty.possible, ownership_api.incomplete_reason.unknown_effect));
    assert(last_text(&x) == "a reference that this call copies");
    // A second leaf without facts at the same call gives no second event.
    ownership_heap.push_leaf(&list, ownership_heap.leaf{.ty = view,
        .v = ownership_heap.unknown_value()});
    assert(leaf_units(&x, &s, slots, &list, 2, &events) == 3 && events == 2);
    // A live atom without a reference of the body: the leaves hold inputs or static data.
    u32 kept = fresh_cell(ctx, &s, 5);
    s.atoms[cast(kept, u64)].borrows = false;
    u32[8] mut one = {};
    one[0] = kept;
    ownership_heap.location none = ownership_heap.element_of(1, one, false, ownership_heap.NONE);
    assert(leaf_units(&x, &s, none, &list, 3, &events) == 4 && events == 0);
    // An atom that keeps a reference of the body: each borrowed leaf is checked.
    s.atoms[cast(kept, u64)].borrows = true;
    assert(leaf_units(&x, &s, none, &list, 4, &events) == 4 && events == 2);
    // A second atom with that fact is enough, and storage without atoms keeps only inputs.
    u32 other = fresh_cell(ctx, &s, 6);
    s.atoms[cast(kept, u64)].borrows = false;
    s.atoms[cast(other, u64)].borrows = true;
    one[1] = other;
    ownership_heap.location both = ownership_heap.element_of(2, one, false, ownership_heap.NONE);
    assert(leaf_units(&x, &s, both, &list, 6, &events) == 4 && events == 2);
    ownership_heap.location caller = ownership_heap.element_of(0, one, true, ownership_heap.NONE);
    assert(leaf_units(&x, &s, caller, &list, 7, &events) == 4 && events == 0);
    // An unknown location, such as a global, has leaves without facts.
    assert(leaf_units(&x, &s, ownership_heap.unknown_location(), &list, 5, &events) == 3);
    assert(events == 2);
}

// The summary mask names parameters 1 through 63. The high bit covers later parameters.
fn escape_bits() void {
    ownership_heap.context mut c = ownership_heap.context{};
    ownership_heap.note_param_escape(&c, 1);
    ownership_heap.note_param_escape(&c, 64);
    ownership_heap.summary mut s = ownership_heap.summary{};
    s.address_escapes = c.address_escapes;
    s.escapes_high = c.escapes_high;
    assert(s.address_escapes == 2 && s.escapes_high);
    assert(ownership_heap.escapes_param(&s, 1));
    assert(!ownership_heap.escapes_param(&s, 2));
    assert(ownership_heap.escapes_param(&s, 64));
    ownership_heap.context mut any = ownership_heap.context{};
    ownership_heap.note_param_escape(&any, ownership_heap.ANY_PARAM);
    assert(any.address_escapes == ownership_heap.U64_MAX && any.escapes_high);
}

fn widening() void {
    println("widening removes cells");
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "host");
    ownership_heap.context mut* ctx = &x.ctx;
    ownership_heap.state mut a = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&a);
    // A chain of three fresh cells and a self-cycle.
    u32 head = fresh_cell(ctx, &a, 5);
    u32 mut tail = head;
    u32 mut k = 0;
    while (k < 2) {
        ownership_heap.atom mut c = ownership_heap.new_atom(ownership_heap.atom_kind.cell,
            a.atoms[0].ty, ownership_heap.shape_of(ctx, a.atoms[0].ty),
            ownership_facts.root_kind.nonnull, ownership_facts.provenance.established);
        c.fresh = true;
        u32 made = ownership_heap.push_atom(&a, c);
        ownership_heap.add_cell_slots(ctx, &a, made, a.atoms[0].ty);
        set_value(&a, field_key(ownership_heap.base_kind.cell, tail, 0),
            ownership_heap.own_value(made));
        tail = made;
        k += 1;
    }
    u32 cycle = fresh_cell(ctx, &a, 6);
    set_value(&a, field_key(ownership_heap.base_kind.cell, cycle, 0),
        ownership_heap.own_value(cycle));
    assert(cells(&a) == 4);
    u64 before = obligations(&a);
    assert(ownership_heap.widen_cells(ctx, &a));
    assert(cells(&a) == 0);
    // The chain folds into one region; the cycle becomes one opaque atom. No obligation goes.
    assert(a.atoms[head].kind == ownership_heap.atom_kind.region);
    assert(a.atoms[cycle].kind == ownership_heap.atom_kind.opaque);
    assert(obligations(&a) == before - 2);
    assert(a.atoms[head].used && a.atoms[cycle].used && !a.atoms[tail].used);
    // A widened join of two widened states has no cell either.
    ownership_heap.state mut b = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&b);
    fresh_cell(ctx, &b, 6);
    ownership_heap.state mut w = ownership_heap.state{};
    defer ownership_heap.free_state(&w);
    assert(ownership_heap.canonical(ctx, &a));
    assert(ownership_heap.canonical(ctx, &b));
    assert(ownership_heap.join(ctx, &a, &b, true, &w));
    assert(cells(&w) == 0);
    assert(obligations(&w) >= obligations(&a));
}

fn covers() void {
    println("precision covers");
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "host");
    ownership_heap.context mut* ctx = &x.ctx;
    ownership_heap.state mut s = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&s);
    assert(ownership_heap.unfold(ctx, &s, 0));
    u32 a = fresh_cell(ctx, &s, 5);
    ownership_heap.value mut v = ownership_heap.empty_value();
    v.kind = ownership_heap.value_kind.view;
    assert(ownership_heap.add_source(&v, a));
    set_value(&s, local(7), v);
    u64 owners = 0;
    ownership_heap.cover(&s);
    u64 mut i = 0;
    while (i < s.atoms_len) {
        ownership_heap.atom item = s.atoms[i];
        if (item.used) {
            assert(item.kind == ownership_heap.atom_kind.opaque ||
                item.kind == ownership_heap.atom_kind.flat);
        }
        i += 1;
    }
    // Each owner keeps an obligation; the view keeps no source.
    assert(value_at(&s, local(1)).kind == ownership_heap.value_kind.owned);
    assert(value_at(&s, local(5)).kind == ownership_heap.value_kind.owned);
    assert(value_at(&s, local(7)).kind == ownership_heap.value_kind.unknown);
    assert(obligations(&s) == 5 + owners);
    ownership_heap.content m = ownership_heap.measure(ctx, &s);
    assert(m.h == 0 && m.r == 5);
    // A P cover keeps each atom and joins each refined root.
    s.atoms[1].root = ownership_facts.nullness{ownership_facts.root_kind.nonnull,
        ownership_facts.provenance.established};
    ownership_heap.cover_roots(&s);
    assert(s.atoms[1].root.value == ownership_facts.root_kind.joined);
    assert(s.atoms[1].root.how == ownership_facts.provenance.assumed);
    assert(obligations(&s) == 5 + owners);
}

fn tests() void {
    println("null tests");
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "host");
    ownership_heap.context mut* ctx = &x.ctx;
    ownership_heap.state mut s = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&s);
    ownership_heap.value mut cond = ownership_heap.scalar_value();
    cond.test = 0;
    cond.test_nonnull = true;
    ownership_heap.state mut yes = ownership_heap.clone(&s);
    defer ownership_heap.free_state(&yes);
    assert(ownership_heap.refine(&yes, cond, true));
    assert(yes.atoms[0].root.value == ownership_facts.root_kind.nonnull);
    // The edge establishes the root that its test read.
    assert(yes.atoms[0].root.how == ownership_facts.provenance.established);
    ownership_heap.state mut no = ownership_heap.clone(&s);
    defer ownership_heap.free_state(&no);
    assert(ownership_heap.refine(&no, cond, false));
    assert(no.atoms[0].root.value == ownership_facts.root_kind.null_root);
    assert(no.atoms[0].root.how == ownership_facts.provenance.established);
    // A refined root contradicts the other edge.
    assert(!ownership_heap.refine(&yes, cond, false));
    assert(!ownership_heap.refine(&no, cond, true));
    // A joined root refines as a free root does.
    ownership_heap.state mut joined = ownership_heap.clone(&s);
    defer ownership_heap.free_state(&joined);
    joined.atoms[0].root.value = ownership_facts.root_kind.joined;
    assert(ownership_heap.refine(&joined, cond, true));
    assert(joined.atoms[0].root.value == ownership_facts.root_kind.nonnull);
    // An unfold assumes the nonnull root of a cell, so the null edge stays (D17.18). The edge
    // establishes the null root of the cell.
    ownership_heap.state mut cell = ownership_heap.clone(&s);
    defer ownership_heap.free_state(&cell);
    assert(ownership_heap.unfold(ctx, &cell, 0));
    assert(ownership_heap.refine(&cell, cond, false));
    assert(cell.atoms[0].root.value == ownership_facts.root_kind.null_root);
    assert(cell.atoms[0].root.how == ownership_facts.provenance.established);
    // A known truth value selects one edge; an untracked one takes each edge and refines nothing.
    ownership_heap.value mut known = ownership_heap.scalar_value();
    known.known = true;
    known.truth = false;
    assert(ownership_heap.refine(&s, known, false) && !ownership_heap.refine(&s, known, true));
    assert(ownership_heap.refine(&s, ownership_heap.scalar_value(), true));
    assert(ownership_heap.refine(&s, ownership_heap.scalar_value(), false));
    assert(s.atoms[0].root.value == ownership_facts.root_kind.free);
}

// Whether `r` is a member of the first `len` requirements of `items`.
fn has(ownership_facts.requirement@ items, u32 len, ownership_facts.requirement r) bool {
    return ownership_facts.has_requirement(items, len, r);
}

fn path2(u32 a, u32 b) u32[6] {
    u32[6] mut out = {};
    out[0] = a;
    out[1] = b;
    return out;
}

fn requirements() void {
    println("caller requirements");
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "host");
    ownership_heap.context mut* ctx = &x.ctx;
    ownership_heap.state mut s = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&s);
    ownership_facts.root_kind empty = ownership_facts.root_kind.null_root;
    ownership_facts.root_kind full = ownership_facts.root_kind.nonnull;
    // The entry value of q becomes a requirement of each path and an empty root.
    assert(ownership_heap.require_empty(ctx, &s, 1, true));
    ownership_facts.requirement empty_q = ownership_heap_env.root_requirement(1, empty);
    assert(has(ctx->required_some.items[..], ctx->required_some.len, empty_q));
    assert(has(s.required.items[..], s.required.len, empty_q));
    assert(s.atoms[1].root.value == ownership_facts.root_kind.null_root);
    // The caller supplies the empty owner, so the body assumes its null root.
    assert(s.atoms[1].root.how == ownership_facts.provenance.assumed);
    // The entry next field of p becomes a requirement at the path of that field. A requirement
    // of some path only stays out of the state.
    assert(ownership_heap.unfold(ctx, &s, 0));
    ownership_heap.value next = value_at(&s, field_key(ownership_heap.base_kind.cell, 0, 0));
    assert(ownership_heap.require_empty(ctx, &s, next.atom, false));
    ownership_facts.requirement empty_next = ownership_heap_env.requirement(0, 1, path2(0, 0),
        empty);
    assert(has(ctx->required_some.items[..], ctx->required_some.len, empty_next));
    assert(!has(s.required.items[..], s.required.len, empty_next));
    assert(!has(ctx->required_some.items[..], ctx->required_some.len,
        ownership_heap_env.root_requirement(0, empty)));
    // A root that is not a free choice, or an atom of unknown status, gives no requirement.
    ownership_heap.value bytes = value_at(&s, field_key(ownership_heap.base_kind.cell, 0, 1));
    s.atoms[bytes.atom].root.value = ownership_facts.root_kind.nonnull;
    assert(!ownership_heap.require_empty(ctx, &s, bytes.atom, true));
    s.atoms[bytes.atom].root.value = ownership_facts.root_kind.free;
    s.atoms[bytes.atom].status.value = ownership_facts.atom_status.unknown;
    assert(!ownership_heap.require_empty(ctx, &s, bytes.atom, true));
    s.atoms[bytes.atom].status.value = ownership_facts.atom_status.live;
    // A fresh allocation is no input choice.
    u32 made = fresh_cell(ctx, &s, 5);
    assert(!ownership_heap.require_empty(ctx, &s, made, true));
    assert(ctx->required_some.len == 2 && s.required.len == 1);
    // A dereference of an entry value whose nonnull root the body did not establish is a
    // requirement of each path (D10.7). No dereference that reads unfolded p, so a read through
    // the cell p requires it. p->bytes has a free root and the entry path of the unfold child.
    assert(!s.atoms[0].entry_required);
    ownership_heap.deref_atom(ctx, &s, 0, true, "p");
    ownership_facts.requirement full_p = ownership_heap_env.root_requirement(0, full);
    assert(has(s.required.items[..], s.required.len, full_p) && s.atoms[0].entry_required);
    ownership_heap.deref_atom(ctx, &s, bytes.atom, true, "p->bytes");
    ownership_facts.requirement full_bytes = ownership_heap_env.requirement(0, 1, path2(1, 0),
        full);
    assert(has(s.required.items[..], s.required.len, full_bytes));
    assert(has(ctx->required_some.items[..], ctx->required_some.len, full_bytes));
    // A second dereference adds nothing: the lists keep one member for each requirement.
    ownership_heap.deref_atom(ctx, &s, bytes.atom, true, "p->bytes");
    assert(ctx->required_some.len == 4 && s.required.len == 3);
    // The dereference of the region p requires p and unfolds it; p->next->next is the entry value
    // two fields down. (The state `s` made p->next empty.)
    ownership_heap.state mut deep = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&deep);
    ownership_heap.deref_atom(ctx, &deep, 0, true, "p");
    assert(deep.atoms[0].kind == ownership_heap.atom_kind.cell);
    assert(has(deep.required.items[..], deep.required.len, full_p));
    ownership_heap.value deep_next = value_at(&deep,
        field_key(ownership_heap.base_kind.cell, 0, 0));
    ownership_heap.deref_atom(ctx, &deep, deep_next.atom, true, "p->next");
    ownership_heap.value deeper = value_at(&deep,
        field_key(ownership_heap.base_kind.cell, deep_next.atom, 0));
    ownership_heap.deref_atom(ctx, &deep, deeper.atom, true, "p->next->next");
    ownership_heap.deref_atom(ctx, &deep, 0, true, "p");
    assert(deep.required.len == 3);
    assert(has(deep.required.items[..], deep.required.len,
        ownership_heap_env.requirement(0, 1, path2(0, 0), full)));
    assert(has(deep.required.items[..], deep.required.len,
        ownership_heap_env.requirement(0, 2, path2(0, 0), full)));
    // The last dereference of an address computation reads no storage, so it requires nothing.
    // It still unfolds the region (D17.18).
    u32 before = ctx->required_some.len;
    ownership_heap.state mut address = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&address);
    ownership_heap.deref_atom(ctx, &address, 0, false, "p");
    assert(address.atoms[0].kind == ownership_heap.atom_kind.cell);
    assert(address.required.len == 0 && ctx->required_some.len == before);
    assert(!address.atoms[0].entry_required);
    // A later read through that cell requires the root: the unfold assumed it, and no read
    // covered it.
    ownership_heap.deref_atom(ctx, &address, 0, true, "p");
    assert(address.required.len == 1 && ownership_facts.requirement_order(
        address.required.items[0], full_p) == 0);
    // After a test, the first read covers the cell, so a read after the unfold adds nothing.
    ownership_heap.state mut tested = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&tested);
    tested.atoms[0].root = ownership_facts.nullness{ownership_facts.root_kind.nonnull,
        ownership_facts.provenance.established};
    ownership_heap.deref_atom(ctx, &tested, 0, true, "p");
    assert(tested.atoms[0].root.how == ownership_facts.provenance.assumed);
    ownership_heap.deref_atom(ctx, &tested, 0, true, "p");
    assert(tested.required.len == 0 && tested.atoms[0].entry_required);
    // An established nonnull root needs no requirement, and a fresh cell has no entry path.
    ownership_heap.state mut fresh = ownership_heap.clone(&s);
    defer ownership_heap.free_state(&fresh);
    fresh.required = ownership_facts.requirement_list{};
    fresh.atoms[bytes.atom].entry_required = false;
    fresh.atoms[bytes.atom].root = ownership_facts.nullness{ownership_facts.root_kind.nonnull,
        ownership_facts.provenance.established};
    ownership_heap.deref_atom(ctx, &fresh, bytes.atom, true, "p->bytes");
    ownership_heap.deref_atom(ctx, &fresh, made, true, "made");
    assert(fresh.required.len == 0 && ctx->required_some.len == before);
    // The entry root is covered now. A fresh cell holds no member of an input: it keeps no fact.
    assert(fresh.atoms[bytes.atom].entry_required && !fresh.atoms[made].entry_required);
    assert(ctx->lost_required == 0);
    // An imported nonnull root needs the requirement.
    fresh.atoms[bytes.atom].entry_required = false;
    fresh.atoms[bytes.atom].root.how = ownership_facts.provenance.imported;
    ownership_heap.deref_atom(ctx, &fresh, bytes.atom, true, "p->bytes");
    assert(fresh.required.len == 1 && ownership_facts.requirement_order(fresh.required.items[0],
        full_bytes) == 0);
    // A full list of the state drops a new requirement of each path: the summary still names it
    // for some path. The body list takes 16; one more gives incomplete proof and makes the
    // summary residual.
    ownership_heap.state mut many = ownership_heap.clone(&s);
    defer ownership_heap.free_state(&many);
    many.required = ownership_facts.requirement_list{};
    u32 room = 16 - ctx->required_some.len;
    assert(room > 9);
    u32 mut k = 0;
    while (k < room) {
        ownership_heap.require(ctx, &many,
            ownership_heap_env.requirement(2, 1, path2(k, 0), full), true);
        k += 1;
    }
    assert(many.required.len == 8 && ctx->required_some.len == 16);
    assert(has(many.required.items[..], many.required.len,
        ownership_heap_env.requirement(2, 1, path2(7, 0), full)));
    assert(!has(many.required.items[..], many.required.len,
        ownership_heap_env.requirement(2, 1, path2(8, 0), full)));
    assert(has(ctx->required_some.items[..], ctx->required_some.len,
        ownership_heap_env.requirement(2, 1, path2(room - 1, 0), full)));
    assert(!ctx->residual && !ctx->incomplete_any);
    ownership_heap.require(ctx, &many, ownership_heap_env.requirement(2, 1, path2(room, 0), full),
        true);
    assert(ctx->required_some.len == 16 && ctx->residual && ctx->incomplete_any);
    assert(ownership_heap.body_proof(ctx).terminal.reason ==
        ownership_api.incomplete_reason.unknown_effect);
    // A member of a full list is no new requirement.
    ctx->residual = false;
    ownership_heap.require(ctx, &many, full_p, true);
    assert(!ctx->residual);
}

fn walk(ownership_heap.state* s, u32 start, types.node* ty, u32 entry, u32 depth, u32 field,
    ownership_facts.root_kind needs) ownership_heap.requirement_walk {
    u32[6] mut path = {};
    u32 mut i = 0;
    while (i < depth) {
        path[i] = field;
        i += 1;
    }
    return ownership_heap.walk_requirement(s, start, ty,
        ownership_heap_env.requirement(entry, depth, path, needs));
}

fn is_test(ownership_heap.requirement_walk w, ownership_heap.requirement_test test) bool {
    return w.test == test;
}

// The walk of one callee requirement through a caller state, each branch alone (D10.7). The
// state of `host` is the caller: p and q are its own entry owners 0 and 1.
fn walks() void {
    println("requirement walks");
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "host");
    ownership_heap.context mut* ctx = &x.ctx;
    ownership_heap.state mut s = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&s);
    types.node* ty = ctx->interface[0].ty;
    ownership_facts.root_kind full = ownership_facts.root_kind.nonnull;
    ownership_facts.root_kind empty = ownership_facts.root_kind.null_root;
    ownership_heap.requirement_test holds = ownership_heap.requirement_test.holds;
    ownership_heap.requirement_test fails = ownership_heap.requirement_test.fails;
    ownership_heap.requirement_test unknown = ownership_heap.requirement_test.unknown;
    ownership_heap.requirement_test passed = ownership_heap.requirement_test.passed;
    u32 none = ownership_heap.NONE;
    // An empty argument: it fails a nonnull requirement at its root and holds an empty one.
    ownership_heap.requirement_walk mut w = walk(&s, none, ty, 0, 0, 0, full);
    assert(is_test(w, fails) && w.at_owner && w.owner == none);
    assert(w.holder == ownership_heap.U64_MAX);
    assert(ownership_heap.requirement_certainty(&s, w, full, true) ==
        ownership_api.certainty.definite);
    assert(ownership_heap.requirement_certainty(&s, w, full, false) ==
        ownership_api.certainty.possible);
    assert(is_test(walk(&s, none, ty, 0, 0, 0, empty), holds));
    // Above the end of the path an empty owner holds: the callee never reaches the field.
    w = walk(&s, none, ty, 0, 2, 0, full);
    assert(is_test(w, holds) && !w.at_owner);
    // The entry owner q of the caller passes the requirement on with its own entry: 1, not 0.
    w = walk(&s, 1, ty, 0, 0, 0, full);
    assert(is_test(w, passed) && w.at_owner && w.owner == 1);
    assert(ownership_facts.requirement_order(w.passed,
        ownership_heap_env.root_requirement(1, full)) == 0);
    w = walk(&s, 1, ty, 0, 0, 0, empty);
    assert(is_test(w, passed) && ownership_facts.requirement_order(w.passed,
        ownership_heap_env.root_requirement(1, empty)) == 0);
    // Above the end, the unchanged region q passes the rest of the path on: q->next->next.
    w = walk(&s, 1, ty, 0, 2, 0, full);
    assert(is_test(w, passed) && !w.at_owner && w.passed.entry == 1 && w.passed.depth == 2);
    assert(w.passed.path[0] == 0 && w.passed.path[1] == 0 && w.passed.needs == full);
    // A joined path of 7 fields is beyond the bound: the caller does not know the owner.
    s.atoms[1].handle_depth = 5;
    w = walk(&s, 1, ty, 0, 2, 0, full);
    assert(is_test(w, unknown) && w.why == ownership_api.incomplete_reason.missing_graph);
    s.atoms[1].handle_depth = 4;
    w = walk(&s, 1, ty, 0, 2, 0, full);
    assert(is_test(w, passed) && w.passed.depth == 6);
    s.atoms[1].handle_depth = 0;
    // A region that is no entry owner, or not live, or no free choice passes nothing on.
    s.atoms[1].choice = false;
    assert(is_test(walk(&s, 1, ty, 0, 1, 0, full), unknown));
    s.atoms[1].choice = true;
    s.atoms[1].status.value = ownership_facts.atom_status.unknown;
    assert(is_test(walk(&s, 1, ty, 0, 1, 0, full), unknown));
    s.atoms[1].status.value = ownership_facts.atom_status.live;
    // Another type above the end gives no field.
    assert(is_test(walk(&s, 1, null, 0, 1, 0, full), unknown));
    // A null root above the end holds.
    s.atoms[1].root.value = empty;
    assert(is_test(walk(&s, 1, ty, 0, 1, 0, full), holds));
    s.atoms[1].root.value = ownership_facts.root_kind.free;
    // A cell: the walk follows the field slot, and the child of an unfold passes its own path.
    assert(ownership_heap.unfold(ctx, &s, 1));
    u64 next_at = ownership_heap.find_slot(&s, field_key(ownership_heap.base_kind.cell, 1, 0));
    u32 child = s.slots[next_at].v.atom;
    w = walk(&s, 1, ty, 0, 1, 0, full);
    assert(is_test(w, passed) && w.at_owner && w.owner == child && w.holder == next_at);
    assert(w.passed.entry == 1 && w.passed.depth == 1 && w.passed.path[0] == 0);
    // An empty field fails a nonnull requirement at it and holds one below it.
    ownership_heap.value kept = s.slots[next_at].v;
    s.slots[next_at].v = ownership_heap.empty_value();
    w = walk(&s, 1, ty, 0, 1, 0, full);
    assert(is_test(w, fails) && w.owner == none && w.holder == next_at);
    assert(is_test(walk(&s, 1, ty, 0, 1, 0, empty), holds));
    assert(is_test(walk(&s, 1, ty, 0, 2, 0, full), holds));
    // A field value that the state does not follow is unknown.
    s.slots[next_at].v = ownership_heap.unknown_value();
    w = walk(&s, 1, ty, 0, 1, 0, full);
    assert(is_test(w, unknown) && !w.at_owner && w.owner == 1);
    assert(w.why == ownership_api.incomplete_reason.unknown_effect);
    s.slots[next_at].v = kept;
    // The owner at the end: each root and status.
    s.atoms[child].handle = none;
    w = walk(&s, 1, ty, 0, 1, 0, full);
    assert(is_test(w, fails));
    assert(ownership_heap.requirement_certainty(&s, w, full, true) ==
        ownership_api.certainty.choice);
    s.atoms[child].root.value = ownership_facts.root_kind.joined;
    w = walk(&s, 1, ty, 0, 1, 0, full);
    assert(is_test(w, fails));
    assert(ownership_heap.requirement_certainty(&s, w, full, true) ==
        ownership_api.certainty.possible);
    s.atoms[child].root.value = empty;
    w = walk(&s, 1, ty, 0, 1, 0, full);
    assert(is_test(w, fails));
    assert(ownership_heap.requirement_certainty(&s, w, full, true) ==
        ownership_api.certainty.definite);
    assert(is_test(walk(&s, 1, ty, 0, 1, 0, empty), holds));
    // A nonnull root that an unfold or a callee assumed meets nothing (rule P1). An owner of an
    // input without an entry path loses the requirement; an established or a covered root holds.
    s.atoms[child].root.value = full;
    w = walk(&s, 1, ty, 0, 1, 0, full);
    assert(is_test(w, ownership_heap.requirement_test.lost) && w.owner == child);
    s.atoms[child].root.how = ownership_facts.provenance.established;
    assert(is_test(walk(&s, 1, ty, 0, 1, 0, full), holds));
    s.atoms[child].root.how = ownership_facts.provenance.assumed;
    s.atoms[child].entry_required = true;
    assert(is_test(walk(&s, 1, ty, 0, 1, 0, full), holds));
    s.atoms[child].entry_required = false;
    // With an entry path, an assumed or an imported root passes the requirement on.
    s.atoms[child].handle = 1;
    s.atoms[child].handle_depth = 1;
    w = walk(&s, 1, ty, 0, 1, 0, full);
    assert(is_test(w, passed) && w.passed.entry == 1 && w.passed.depth == 1);
    s.atoms[child].root.how = ownership_facts.provenance.imported;
    assert(is_test(walk(&s, 1, ty, 0, 1, 0, full), passed));
    s.atoms[child].root.how = ownership_facts.provenance.assumed;
    // A joined root with an entry path is empty on some path of the caller: it fails.
    s.atoms[child].root.value = ownership_facts.root_kind.joined;
    assert(is_test(walk(&s, 1, ty, 0, 1, 0, full), fails));
    s.atoms[child].root.value = full;
    s.atoms[child].handle = none;
    s.atoms[child].handle_depth = 0;
    // An atom without input members and with an assumed root fails: a possible candidate.
    u64 saved_origin = s.atoms[child].origin;
    s.atoms[child].origin = 0;
    w = walk(&s, 1, ty, 0, 1, 0, full);
    assert(is_test(w, fails));
    assert(ownership_heap.requirement_certainty(&s, w, full, true) ==
        ownership_api.certainty.possible);
    s.atoms[child].origin = saved_origin;
    // An empty requirement at a nonnull owner fails: definite for a nonnull root.
    w = walk(&s, 1, ty, 0, 1, 0, empty);
    assert(is_test(w, fails) && w.at_owner && w.owner == child);
    assert(ownership_heap.requirement_certainty(&s, w, empty, true) ==
        ownership_api.certainty.definite);
    assert(ownership_heap.requirement_certainty(&s, w, empty, false) ==
        ownership_api.certainty.possible);
    s.atoms[child].root.value = ownership_facts.root_kind.free;
    s.atoms[child].choice = false;
    w = walk(&s, 1, ty, 0, 1, 0, empty);
    assert(is_test(w, fails));
    assert(ownership_heap.requirement_certainty(&s, w, empty, true) ==
        ownership_api.certainty.choice);
    s.atoms[child].choice = true;
    // A leaked or escaped owner holds an empty requirement: its loss has an event already.
    s.atoms[child].status.value = ownership_facts.atom_status.leaked;
    assert(is_test(walk(&s, 1, ty, 0, 1, 0, empty), holds));
    s.atoms[child].status.value = ownership_facts.atom_status.escaped;
    assert(is_test(walk(&s, 1, ty, 0, 1, 0, empty), holds));
    // An owner of unknown status is unknown at the end.
    s.atoms[child].status.value = ownership_facts.atom_status.unknown;
    w = walk(&s, 1, ty, 0, 1, 0, empty);
    assert(is_test(w, unknown) && w.at_owner && w.owner == child);
    assert(w.why == ownership_api.incomplete_reason.unknown_effect);
    s.atoms[child].status.value = ownership_facts.atom_status.live;
    // A fresh cell is no entry owner: an empty requirement fails definite, a nonnull one holds.
    u32 made = fresh_cell(ctx, &s, 5);
    w = walk(&s, made, ty, 0, 0, 0, empty);
    assert(is_test(w, fails));
    assert(ownership_heap.requirement_certainty(&s, w, empty, true) ==
        ownership_api.certainty.definite);
    assert(is_test(walk(&s, made, ty, 0, 0, 0, full), holds));
    // Its next field is empty: a dereference of it fails at the call.
    w = walk(&s, made, ty, 0, 1, 0, full);
    assert(is_test(w, fails) && w.owner == none);
    // The empty root requirement of the summary.
    ownership_heap.summary mut sum = ownership_heap.summary{};
    assert(!ownership_heap.requires_empty_root(&sum, 0));
    sum.required_some.items[0] = ownership_heap_env.root_requirement(0, full);
    sum.required_some.items[1] = ownership_heap_env.root_requirement(1, empty);
    sum.required_some.len = 2;
    assert(!ownership_heap.requires_empty_root(&sum, 0));
    assert(ownership_heap.requires_empty_root(&sum, 1));
}

// The requirements of a state join by intersection, and a state that differs only in them is a
// change, so a block entry runs again (D10.7, D17.18).
fn requirement_joins() void {
    println("requirement joins");
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "host");
    ownership_heap.context mut* ctx = &x.ctx;
    ownership_heap.state mut s = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&s);
    assert(ownership_heap.canonical(ctx, &s));
    ownership_facts.requirement p_full = ownership_heap_env.root_requirement(0,
        ownership_facts.root_kind.nonnull);
    ownership_facts.requirement q_full = ownership_heap_env.root_requirement(1,
        ownership_facts.root_kind.nonnull);
    ownership_heap.state mut left = ownership_heap.clone(&s);
    defer ownership_heap.free_state(&left);
    ownership_heap.state mut right = ownership_heap.clone(&s);
    defer ownership_heap.free_state(&right);
    ownership_facts.insert_requirement(left.required.items[..], &left.required.len, p_full);
    ownership_facts.insert_requirement(left.required.items[..], &left.required.len, q_full);
    ownership_facts.insert_requirement(right.required.items[..], &right.required.len, q_full);
    // A clone keeps the list, and `equal` sees a list that differs.
    ownership_heap.state mut copy = ownership_heap.clone(&left);
    defer ownership_heap.free_state(&copy);
    assert(copy.required.len == 2);
    bool mut same = false;
    assert(ownership_heap.equal(ctx, &left, &copy, &same) && same);
    assert(ownership_heap.equal(ctx, &left, &right, &same) && !same);
    assert(ownership_heap.equal(ctx, &left, &s, &same) && !same);
    // The join keeps q, which both paths require, and drops p, which one path requires.
    ownership_heap.state mut joined = ownership_heap.state{};
    defer ownership_heap.free_state(&joined);
    assert(ownership_heap.join(ctx, &left, &right, false, &joined));
    assert(joined.required.len == 1);
    assert(ownership_facts.requirement_order(joined.required.items[0], q_full) == 0);
    ownership_heap.state mut flipped = ownership_heap.state{};
    defer ownership_heap.free_state(&flipped);
    assert(ownership_heap.join(ctx, &right, &left, false, &flipped));
    assert(flipped.required.len == 1);
    // A widening keeps the same intersection.
    ownership_heap.state mut widened = ownership_heap.state{};
    defer ownership_heap.free_state(&widened);
    assert(ownership_heap.join(ctx, &left, &right, true, &widened));
    assert(widened.required.len == 1);
    // A path with no requirement empties the list.
    ownership_heap.state mut free_join = ownership_heap.state{};
    defer ownership_heap.free_state(&free_join);
    assert(ownership_heap.join(ctx, &left, &s, false, &free_join));
    assert(free_join.required.len == 0);
    // A side that no path reaches gives the list of the other side.
    ownership_heap.state mut none = ownership_heap.bottom(s.ended.len);
    defer ownership_heap.free_state(&none);
    ownership_heap.state mut one = ownership_heap.state{};
    defer ownership_heap.free_state(&one);
    assert(ownership_heap.join(ctx, &none, &left, false, &one));
    assert(one.required.len == 2);
    ownership_heap.state mut other = ownership_heap.state{};
    defer ownership_heap.free_state(&other);
    assert(ownership_heap.join(ctx, &right, &none, false, &other));
    assert(other.required.len == 1);
}

// The rows of requirement events from row `from` on, of certainty `how`.
fn requirement_rows(fixture* x, u64 from, ownership_api.certainty how) u64 {
    u64 mut found = 0;
    u64 mut i = from;
    while (i < x->c.counts.events && i < x->c.counts.rows.len) {
        ownership_heap_env.event_row row = x->c.counts.rows[i];
        if (row.kind == ownership_api.event_kind.caller_requirement && row.certainty == how) {
            found += 1;
        }
        i += 1;
    }
    return found;
}

// A summary with two interface atoms of the node type of `host`, and requirements of some path.
fn callee_summary(ownership_heap.context* ctx, ownership_facts.requirement@ some,
    ownership_facts.requirement@ each) ownership_heap.summary {
    ownership_heap.summary mut sum = ownership_heap.summary{};
    sum.interface = new(ownership_heap.interface_entry, 2);
    sum.interface[0].ty = ctx->interface[0].ty;
    sum.interface[1].ty = ctx->interface[0].ty;
    u64 mut i = 0;
    while (i < some.len) {
        ownership_facts.insert_requirement(sum.required_some.items[..], &sum.required_some.len,
            some[i]);
        i += 1;
    }
    i = 0;
    while (i < each.len) {
        ownership_facts.insert_requirement(sum.post.required.items[..], &sum.post.required.len,
            each[i]);
        i += 1;
    }
    return sum;
}

// `check_requirements` at one call, with a caller state of `host` and a summary that names each
// requirement directly (D10.7, `spec/fir.md` 14 Calls).
fn requirement_checks() void {
    println("requirement checks");
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "host");
    ownership_heap.context mut* ctx = &x.ctx;
    // Each call below has an operation of its own, so no event repeats another.
    ctx->reporting = true;
    ownership_heap.state mut s = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&s);
    ownership_facts.root_kind full = ownership_facts.root_kind.nonnull;
    ownership_facts.root_kind empty = ownership_facts.root_kind.null_root;
    u32[6] mut next = {};
    ownership_facts.requirement next_full = ownership_heap_env.requirement(0, 1, next, full);
    ownership_facts.requirement next_empty = ownership_heap_env.requirement(0, 1, next, empty);
    ownership_facts.requirement q_empty = ownership_heap_env.root_requirement(1, empty);
    // A fresh node of the caller has an empty next field. The callee reads it on each path:
    // a definite candidate. It stores over its second owner on some path, and the entry owner q
    // of the caller passes that on for some path only, with q's empty root assumed.
    u32 made = fresh_cell(ctx, &s, 5);
    ownership_facts.requirement[2] some1 = {next_full, q_empty};
    ownership_facts.requirement[1] each1 = {next_full};
    ownership_heap.summary mut first = callee_summary(ctx, some1[..], each1[..]);
    defer ownership_heap.free_summary(&first);
    u32[2] bound1 = {made, 1};
    u64 mut before = x.c.counts.events;
    ctx->op = ownership_heap.position(ctx, 0, 1, false);
    ownership_heap.check_requirements(ctx, &s, &first, bound1[..]);
    assert(requirement_rows(&x, before, ownership_api.certainty.definite) == 1);
    assert(x.c.counts.events == before + 1);
    assert(ownership_facts.has_requirement(ctx->required_some.items[..], ctx->required_some.len,
        ownership_heap_env.root_requirement(1, empty)));
    assert(!ownership_facts.has_requirement(s.required.items[..], s.required.len,
        ownership_heap_env.root_requirement(1, empty)));
    assert(s.atoms[1].root.value == empty);
    assert(s.atoms[1].root.how == ownership_facts.provenance.assumed);
    // A fresh node fails the empty requirement of some path: a possible candidate, and the node
    // is lost.
    u32 other = fresh_cell(ctx, &s, 6);
    ownership_facts.requirement[1] some2 = {q_empty};
    ownership_facts.requirement[1] each2 = {q_empty};
    ownership_heap.summary mut second = callee_summary(ctx, some2[..], each2[..0]);
    defer ownership_heap.free_summary(&second);
    u32[2] bound2 = {ownership_heap.NONE, other};
    before = x.c.counts.events;
    ctx->op = ownership_heap.position(ctx, 0, 2, false);
    ownership_heap.check_requirements(ctx, &s, &second, bound2[..]);
    assert(requirement_rows(&x, before, ownership_api.certainty.possible) == 1);
    assert(s.atoms[other].status.value == ownership_facts.atom_status.leaked);
    // On each path it is definite.
    u32 third = fresh_cell(ctx, &s, 6);
    ownership_heap.summary mut each_path = callee_summary(ctx, some2[..], each2[..]);
    defer ownership_heap.free_summary(&each_path);
    u32[2] bound3 = {ownership_heap.NONE, third};
    before = x.c.counts.events;
    ctx->op = ownership_heap.position(ctx, 0, 3, false);
    ownership_heap.check_requirements(ctx, &s, &each_path, bound3[..]);
    assert(requirement_rows(&x, before, ownership_api.certainty.definite) == 1);
    // The dereferences come before the empty owners: a full next field holds the nonnull
    // requirement, and only then fails the empty one and leaves its slot.
    ownership_heap.state mut t = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&t);
    u32 parent = fresh_cell(ctx, &t, 5);
    u32 child = fresh_cell(ctx, &t, 6);
    set_value(&t, local(6), ownership_heap.empty_value());
    set_value(&t, field_key(ownership_heap.base_kind.cell, parent, 0),
        ownership_heap.own_value(child));
    ownership_facts.requirement[2] both = {next_full, next_empty};
    ownership_heap.summary mut order = callee_summary(ctx, both[..], both[..]);
    defer ownership_heap.free_summary(&order);
    u32[2] bound4 = {parent, ownership_heap.NONE};
    before = x.c.counts.events;
    ctx->op = ownership_heap.position(ctx, 0, 4, false);
    ownership_heap.check_requirements(ctx, &t, &order, bound4[..]);
    assert(x.c.counts.events == before + 1);
    assert(requirement_rows(&x, before, ownership_api.certainty.definite) == 1);
    assert(ownership_heap_env.text(&x.c.counts.rows[before]) ==
        "an empty owned field that this call requires");
    assert(value_at(&t, field_key(ownership_heap.base_kind.cell, parent, 0)).kind ==
        ownership_heap.value_kind.empty);
    assert(t.atoms[child].status.value == ownership_facts.atom_status.leaked);
    // A requirement on an interface atom that the call does not bind is no requirement here.
    ownership_facts.requirement[1] beyond = {ownership_heap_env.root_requirement(5, full)};
    ownership_heap.summary mut wide = callee_summary(ctx, beyond[..], beyond[..]);
    defer ownership_heap.free_summary(&wide);
    u32[2] bound5 = {ownership_heap.NONE, ownership_heap.NONE};
    before = x.c.counts.events;
    ctx->op = ownership_heap.position(ctx, 0, 5, false);
    ownership_heap.check_requirements(ctx, &t, &wide, bound5[..]);
    assert(x.c.counts.events == before);
}

// An access through an owner of an input that has no entry path marks the inputs of the body
// lost, and a call of such a summary gives incomplete proof; the body itself keeps its proof
// (D10.7, D17.18).
fn lost_requirements() void {
    println("lost requirements");
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "host");
    ownership_heap.context mut* ctx = &x.ctx;
    ownership_heap.state mut s = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&s);
    // q without its entry path: the access marks q, the interface atom of its members.
    ownership_heap.clear_handle(&s.atoms[1]);
    ownership_heap.deref_atom(ctx, &s, 1, true, "q");
    assert(ctx->lost_required == 2 && s.required.len == 0 && ctx->required_some.len == 0);
    assert(s.atoms[1].entry_required);
    // A covered root marks nothing more, and an address computation marks nothing.
    ctx->lost_required = 0;
    ownership_heap.deref_atom(ctx, &s, 1, true, "q");
    assert(ctx->lost_required == 0);
    ownership_heap.state mut address = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&address);
    ownership_heap.clear_handle(&address.atoms[1]);
    ownership_heap.deref_atom(ctx, &address, 1, false, "q");
    assert(ctx->lost_required == 0 && !address.atoms[1].entry_required);
    // An established nonnull root marks nothing; an imported one does.
    ownership_heap.state mut tested = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&tested);
    ownership_heap.clear_handle(&tested.atoms[0]);
    tested.atoms[0].root = ownership_facts.nullness{ownership_facts.root_kind.nonnull,
        ownership_facts.provenance.established};
    ownership_heap.deref_atom(ctx, &tested, 0, true, "p");
    assert(ctx->lost_required == 0 && tested.atoms[0].entry_required);
    ownership_heap.state mut imported = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&imported);
    ownership_heap.clear_handle(&imported.atoms[0]);
    imported.atoms[0].root = ownership_facts.nullness{ownership_facts.root_kind.nonnull,
        ownership_facts.provenance.imported};
    ownership_heap.deref_atom(ctx, &imported, 0, true, "p");
    assert(ctx->lost_required == 1);
    // An atom that holds no member of an input marks nothing and keeps no fact.
    ctx->lost_required = 0;
    u32 made = fresh_cell(ctx, &imported, 5);
    imported.atoms[made].root = ownership_facts.nullness{ownership_facts.root_kind.joined,
        ownership_facts.provenance.assumed};
    ownership_heap.deref_atom(ctx, &imported, made, true, "a");
    assert(ctx->lost_required == 0 && !imported.atoms[made].entry_required);
    // The members of both entry owners: a view of two atoms marks both.
    ownership_heap.value mut both = ownership_heap.empty_value();
    both.kind = ownership_heap.value_kind.view;
    assert(ownership_heap.add_source(&both, 0) && ownership_heap.add_source(&both, 1));
    both.nullness = ownership_facts.nullness{ownership_facts.root_kind.joined,
        ownership_facts.provenance.assumed};
    ownership_heap.state mut views = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&views);
    ownership_heap.deref_value(ctx, &views, both, false, true, "w");
    assert(ctx->lost_required == 3);
    // A view whose nonnull root the body established, and the last load of an address, mark
    // nothing.
    ctx->lost_required = 0;
    both.nullness = ownership_facts.nullness{ownership_facts.root_kind.nonnull,
        ownership_facts.provenance.established};
    ownership_heap.deref_value(ctx, &views, both, false, true, "w");
    both.nullness = ownership_facts.nullness{ownership_facts.root_kind.joined,
        ownership_facts.provenance.assumed};
    ownership_heap.deref_value(ctx, &views, both, false, false, "w");
    assert(ctx->lost_required == 0);
    // A call of a summary with a lost requirement gives incomplete proof, whatever it binds.
    ctx->reporting = true;
    ctx->op = ownership_heap.position(ctx, 0, 9, false);
    ownership_facts.requirement[1] none_req = {ownership_heap_env.root_requirement(0,
        ownership_facts.root_kind.nonnull)};
    ownership_heap.summary mut lost = callee_summary(ctx, none_req[..0], none_req[..0]);
    defer ownership_heap.free_summary(&lost);
    lost.lost_required = 1;
    u32[2] bound = {made, made};
    u64 before = x.c.counts.events;
    assert(!ctx->incomplete_any);
    ownership_heap.check_requirements(ctx, &views, &lost, bound[..]);
    assert(x.c.counts.events == before + 1 && ctx->incomplete_any);
    ownership_heap_env.event_row row = x.c.counts.rows[before];
    assert(row.kind == ownership_api.event_kind.incomplete_proof);
    assert(row.reason == ownership_api.incomplete_reason.missing_graph);
    assert(ownership_heap_env.text(&row) ==
        "an owner that the callee accesses without its entry path");
    // A summary without one gives nothing.
    lost.lost_required = 0;
    ctx->op = ownership_heap.position(ctx, 0, 10, false);
    ownership_heap.check_requirements(ctx, &views, &lost, bound[..]);
    assert(x.c.counts.events == before + 1);

    // The nonnull edge of a test covers an atom that holds members of an input, so a fold that
    // assumes the root later keeps it covered. A fresh atom keeps no fact.
    ownership_heap.state mut edge = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&edge);
    ownership_heap.clear_handle(&edge.atoms[1]);
    ownership_heap.value mut cond = ownership_heap.scalar_value();
    cond.test = 1;
    cond.test_nonnull = true;
    assert(ownership_heap.refine(&edge, cond, true));
    assert(edge.atoms[1].entry_required);
    ownership_heap.state mut null_edge = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&null_edge);
    assert(ownership_heap.refine(&null_edge, cond, false));
    assert(!null_edge.atoms[1].entry_required);
    u32 cell = fresh_cell(ctx, &edge, 6);
    cond.test = cell;
    assert(ownership_heap.refine(&edge, cond, true));
    assert(!edge.atoms[cell].entry_required);
    // A join with a side that holds no member of an input keeps the fact of the other side.
    ownership_heap.atom covered = edge.atoms[1];
    ownership_heap.atom fresh_atom = edge.atoms[cell];
    assert(ownership_heap.join_atom(covered, fresh_atom).entry_required);
    assert(ownership_heap.join_atom(fresh_atom, covered).entry_required);
    ownership_heap.atom mut bare = covered;
    bare.entry_required = false;
    assert(!ownership_heap.join_atom(bare, fresh_atom).entry_required);
    ownership_heap.atom mut fresh_origin = fresh_atom;
    fresh_origin.origin = 4;
    assert(!ownership_heap.join_atom(covered, fresh_origin).entry_required);
    // An address computation through an established root covers it before its unfold.
    ownership_heap.state mut addressed = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&addressed);
    addressed.atoms[0].root = ownership_facts.nullness{ownership_facts.root_kind.nonnull,
        ownership_facts.provenance.established};
    ownership_heap.deref_atom(ctx, &addressed, 0, false, "p");
    assert(addressed.atoms[0].entry_required);
    assert(addressed.atoms[0].root.how == ownership_facts.provenance.assumed);
    assert(addressed.required.len == 0);
}

// A pointer whose pointee type is not the type of its storage designates no slot of it (D17.17).
// The location becomes unknown, and a store through it forgets each fact of that storage.
fn retyped() void {
    println("storage of another type");
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "host");
    ownership_heap.context mut* ctx = &x.ctx;
    ownership_heap.state mut s = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&s);
    types.node* owner = fir.local_at(ctx->f, 1)->ty;
    types.node* view = fir.local_at(ctx->f, 7)->ty;
    types.node* small = fir.local_at(ctx->f, 8)->ty;
    types.node* tiny = fir.local_at(ctx->f, 9)->ty;
    types.node* wide = fir.local_at(ctx->f, 10)->ty;
    types.node* sign = fir.local_at(ctx->f, 11)->ty;
    assert(types.type_sizeof(small) == 1 && types.type_sizeof(tiny) == 1);
    assert(types.type_sizeof(wide) == 8 && types.type_sizeof(sign) == 8);
    ownership_heap.slot_key storage = ownership_heap.key_of(ownership_heap.base_kind.caller, 0);
    // The storage of a key: a local, caller storage and its field, and a cell. A step into a
    // field of a pointer, a caller past the parameters and a cell past the atoms name nothing.
    assert(ownership_heap.key_type(ctx, &s, local(8)) == small);
    assert(ownership_heap.key_type(ctx, &s, local(1)) == owner);
    types.node* holder = ownership_heap.key_type(ctx, &s, storage);
    assert(holder != null && holder->kind == types.type_kind.k_struct);
    ownership_heap.slot_key first = field_key(ownership_heap.base_kind.caller, 0, 0);
    assert(ownership_heap.key_type(ctx, &s, first) == fir.struct_field_type(holder, 0));
    assert(ownership_heap.key_type(ctx, &s, ownership_heap.key_of(ownership_heap.base_kind.cell,
        0)) == owner->elem);
    ownership_heap.slot_key mut below = first;
    assert(ownership_heap.extend(&below, 0));
    assert(ownership_heap.key_type(ctx, &s, below) == null);
    assert(ownership_heap.key_type(ctx, &s, ownership_heap.key_of(ownership_heap.base_kind.caller,
        1)) == null);
    assert(ownership_heap.key_type(ctx, &s, ownership_heap.key_of(ownership_heap.base_kind.cell,
        99)) == null);
    // A `mut` mark does not count. An `own` mark and the storage type do count.
    assert(!ownership_heap.holds(owner, view) && ownership_heap.holds(owner, owner));
    assert(ownership_heap.holds(small, small));
    assert(!ownership_heap.holds(small, tiny) && !ownership_heap.holds(small, wide));
    assert(!ownership_heap.holds(null, small) && !ownership_heap.holds(small, null));
    // A store stays in its storage up to the size of that storage, and not one byte past it.
    assert(ownership_heap.stays_in(ctx, &s, local(10), small));
    assert(ownership_heap.stays_in(ctx, &s, local(10), sign));
    assert(!ownership_heap.stays_in(ctx, &s, local(8), wide));
    assert(!ownership_heap.stays_in(ctx, &s, below, small));
    // A slot location of another type becomes unknown and keeps its key. A location of its own
    // type, and a location in an atom, stay as they are.
    ownership_heap.location mut same_type = ownership_heap.location{};
    same_type.kind = ownership_heap.location_kind.slots;
    same_type.key = local(8);
    ownership_heap.retype(ctx, &s, &same_type, small);
    assert(same_type.kind == ownership_heap.location_kind.slots && same_type.retyped == null);
    ownership_heap.location mut other = same_type;
    ownership_heap.retype(ctx, &s, &other, wide);
    assert(other.kind == ownership_heap.location_kind.unknown && other.retyped == wide);
    assert(ownership_heap.same_key(other.key, local(8)));
    u32[8] mut one = {};
    ownership_heap.location mut inside = ownership_heap.element_of(1, one, false,
        ownership_heap.NONE);
    ownership_heap.retype(ctx, &s, &inside, wide);
    assert(inside.kind == ownership_heap.location_kind.element && inside.retyped == null);
    // A scalar forgets its value and a reference forgets its source. A write of unmatched bits
    // into an owning leaf gives incomplete proof, also when the old owner is empty.
    ownership_heap.value mut five = ownership_heap.scalar_value();
    five.numbered = true;
    five.number = 5;
    set_value(&s, local(8), five);
    set_value(&s, local(7), ownership_heap.address_value(local(8),
        ownership_heap.address_fact(&s, local(8))));
    u64 before = ctx->notes;
    ownership_heap.clear_storage(ctx, &s, local(8));
    ownership_heap.clear_storage(ctx, &s, local(7));
    ownership_heap.clear_storage(ctx, &s, local(5));
    assert(ctx->notes == before + 1);
    assert(value_at(&s, local(8)).kind == ownership_heap.value_kind.scalar);
    assert(!value_at(&s, local(8)).numbered);
    assert(value_at(&s, local(7)).kind == ownership_heap.value_kind.unknown);
    assert(!value_at(&s, local(7)).external);
    assert(value_at(&s, local(7)).retained_target);
    assert(ownership_heap.same_key(value_at(&s, local(7)).retained, local(8)));
    ownership_heap.value bits = value_at(&s, local(5));
    assert(bits.kind == ownership_heap.value_kind.owned);
    assert(s.atoms[cast(bits.atom, u64)].status.value == ownership_facts.atom_status.unknown);
    // Each owner of caller storage can hold an obligation: each one records an event, loses it,
    // and holds unknown bits. The other slots keep their facts.
    u32 kept = value_at(&s, local(1)).atom;
    ownership_heap.clear_storage(ctx, &s, storage);
    assert(ctx->notes == before + 3 && ctx->incomplete_any);
    assert(s.atoms[2].status.value == ownership_facts.atom_status.leaked);
    assert(s.atoms[3].status.value == ownership_facts.atom_status.leaked);
    ownership_heap.value lost = value_at(&s, first);
    assert(lost.kind == ownership_heap.value_kind.owned && lost.atom > 3);
    assert(s.atoms[cast(lost.atom, u64)].status.value == ownership_facts.atom_status.unknown);
    assert(value_at(&s, local(1)).atom == kept);
    assert(s.atoms[0].status.value == ownership_facts.atom_status.live);
    // A location without a cast clears nothing. A store past the end records its own event.
    ownership_heap.clear_retyped(ctx, &s, same_type);
    assert(ctx->notes == before + 3);
    ownership_heap.clear_retyped(ctx, &s, other);
    assert(ctx->notes == before + 4);
    // A member of a cell or region and an external or opaque view have no matching storage type.
    // A whole known cell, a flat view and an owner keep their source facts.
    u32 made = fresh_cell(ctx, &s, 6);
    ownership_heap.location mut plain_cell = ownership_heap.location{};
    plain_cell.kind = ownership_heap.location_kind.slots;
    plain_cell.key = ownership_heap.key_of(ownership_heap.base_kind.cell, made);
    ownership_heap.mark_addressed(&s, plain_cell);
    assert(s.atoms[cast(made, u64)].addressed);
    s.atoms[cast(made, u64)].addressed = false;
    ownership_heap.location mut cast_cell = other;
    cast_cell.key = ownership_heap.key_of(ownership_heap.base_kind.cell, made);
    ownership_heap.mark_addressed(&s, cast_cell);
    assert(s.atoms[cast(made, u64)].addressed);
    s.atoms[cast(made, u64)].addressed = false;
    cast_cell.offset_unknown = true;
    ownership_heap.mark_addressed(&s, cast_cell);
    assert(s.atoms[cast(made, u64)].addressed);
    s.atoms[cast(made, u64)].addressed = false;
    ownership_heap.location mut unknown_cell = cast_cell;
    unknown_cell.retyped = null;
    ownership_heap.mark_addressed(&s, unknown_cell);
    assert(!s.atoms[cast(made, u64)].addressed);
    ownership_heap.value whole = ownership_heap.as_view(&s, value_at(&s, local(6)));
    assert(whole.exact && whole.count == 1 && !ownership_heap.unmatched(&s, whole));
    ownership_heap.value mut member = whole;
    member.exact = false;
    assert(ownership_heap.unmatched(&s, member));
    ownership_heap.value mut both = whole;
    assert(ownership_heap.add_source(&both, 0));
    both.exact = false;
    assert(both.count == 2 && ownership_heap.unmatched(&s, both));
    s.atoms[cast(made, u64)].kind = ownership_heap.atom_kind.flat;
    assert(!ownership_heap.unmatched(&s, member));
    assert(!ownership_heap.unmatched(&s, value_at(&s, local(6))));
    assert(ownership_heap.unmatched(&s, ownership_heap.external_view()));
    s.atoms[cast(made, u64)].kind = ownership_heap.atom_kind.opaque;
    assert(ownership_heap.unmatched(&s, member));
    // A `void` pointee reads no byte; a type without a size has no bound.
    types.node* none = fir.local_at(ctx->f, 0)->ty;
    assert(none->kind == types.type_kind.k_void);
    u64 mut size = 9;
    assert(ownership_heap.byte_size(none, &size) && size == 0);
    assert(!ownership_heap.byte_size(null, &size));
    // A store keeps its value in the body only in the whole slot of a local that is not the
    // result: not in a field, the result, caller storage, an atom or untracked storage.
    ownership_heap.location mut own_slot = ownership_heap.location{};
    own_slot.kind = ownership_heap.location_kind.slots;
    own_slot.key = local(5);
    assert(ownership_heap.own_local(&s, own_slot));
    ownership_heap.location mut result = own_slot;
    result.key = local(0);
    assert(!ownership_heap.own_local(&s, result));
    ownership_heap.location mut field = own_slot;
    field.key = first;
    assert(!ownership_heap.own_local(&s, field));
    assert(!ownership_heap.own_local(&s, inside) && !ownership_heap.own_local(&s, other));
    // The storage mark controls an untracked write. A non-own scalar type cannot hide an owning
    // array slot.
    u64 own_at = ownership_heap.find_slot(&s, local(5));
    assert(own_at != ownership_heap.U64_MAX && s.slots[own_at].owning);
    s.slots[own_at].array = true;
    u64 write_before = ctx->notes;
    ownership_heap.write_at(ctx, &s, own_slot, wide, ownership_heap.scalar_value());
    assert(ctx->notes == write_before + 1);
}

// A cast pointer that leaves the body forgets the facts of its storage (D17.17): an address names
// its slot key, a view of a whole cell names the cell, and a pointer of the type of its storage, a
// view into an atom and a value that is no pointer leave nothing.
fn escapes() void {
    println("a cast pointer that leaves the body");
    fixture mut x = fixture{};
    defer close(&x);
    open(&x, "host");
    ownership_heap.context mut* ctx = &x.ctx;
    ownership_heap.state mut s = ownership_heap.initial(ctx);
    defer ownership_heap.free_state(&s);
    types.node* owner = fir.local_at(ctx->f, 1)->ty;
    types.node* view = fir.local_at(ctx->f, 7)->ty;
    types.node* writable = fir.local_at(ctx->f, 3)->ty;
    types.node* wide = fir.local_at(ctx->f, 10)->ty;
    ownership_heap.value p = ownership_heap.address_value(local(1),
        ownership_heap.address_fact(&s, local(1)));
    u64 before = ctx->notes;
    // No pointer type, so nothing leaves.
    ownership_heap.escape_cast(ctx, &s, p, wide);
    assert(ctx->notes == before && value_at(&s, local(1)).atom == 0);
    // A read-only pointer cannot write. A writable pointer of another type can write past the
    // owner slot and can lose its allocation: two events.
    ownership_heap.escape_cast(ctx, &s, p, view);
    assert(ctx->notes == before && value_at(&s, local(1)).atom == 0);
    ownership_heap.escape_cast(ctx, &s, p, writable);
    assert(ctx->notes == before + 2);
    assert(s.atoms[0].status.value == ownership_facts.atom_status.leaked);
    ownership_heap.value bits = value_at(&s, local(1));
    assert(bits.kind == ownership_heap.value_kind.owned && bits.atom != 0);
    // A view of a whole cell has the type of the cell; a view of a member names no storage.
    u32 made = fresh_cell(ctx, &s, 6);
    ownership_heap.value whole = ownership_heap.as_view(&s, value_at(&s, local(6)));
    set_value(&s, field_key(ownership_heap.base_kind.cell, made, 0), value_at(&s, local(2)));
    ownership_heap.escape_cast(ctx, &s, whole, view);
    assert(ctx->notes == before + 2);
    ownership_heap.value mut member = whole;
    member.exact = false;
    types.node* other = writable;
    assert(other->kind == types.type_kind.k_ptr && other->elem != view->elem);
    ownership_heap.escape_cast(ctx, &s, member, other);
    assert(ctx->notes == before + 2);
    // The same whole cell through another type changes no owning leaf without incomplete proof.
    // The live owner and the empty owning span each record one event.
    ownership_heap.escape_cast(ctx, &s, whole, other);
    assert(ctx->notes == before + 4);
    assert(s.atoms[1].status.value == ownership_facts.atom_status.leaked);
    // Caller storage through a wider pointer of another type: one bound event, and both entry
    // owners of h can lose their allocations. A store there is no store into a local.
    ownership_heap.value h = value_at(&s, local(3));
    assert(h.kind == ownership_heap.value_kind.address);
    assert(h.target.base == ownership_heap.base_kind.caller);
    ownership_heap.escape_cast(ctx, &s, h, owner);
    assert(ctx->notes == before + 7);
    assert(s.atoms[2].status.value == ownership_facts.atom_status.leaked);
    assert(s.atoms[3].status.value == ownership_facts.atom_status.leaked);
    ownership_heap.location mut caller = ownership_heap.location{};
    caller.kind = ownership_heap.location_kind.slots;
    caller.key = h.target;
    assert(!ownership_heap.own_local(&s, caller));
}

// The heap proof keeps no path, so a body with a branch, a loop, an abort, a call, an assert or
// a check proves with no event, as straight code does (`spec/toolchain.md` 4.2). The entry
// values of `host` stay owned at its return: two candidates of a free input choice.
fn branch_forms() void {
    println("branch forms");
    ownership_heap_env.closure mut c = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&c);
    ownership_heap_env.run(&c, HOST[..], NAMES[..]);
    u64 mut i = 1;
    while (i < NAMES.len) {
        assert(ownership_heap_env.proved(&c, NAMES[i]));
        assert(ownership_heap_env.events(&c, NAMES[i]) == 0);
        i += 1;
    }
    assert(ownership_heap_env.candidate(&c, "host", ownership_api.event_kind.lost_ownership));
    assert(ownership_heap_env.candidates(&c, "host", ownership_api.event_kind.lost_ownership,
        ownership_api.certainty.choice) == 2);
}

