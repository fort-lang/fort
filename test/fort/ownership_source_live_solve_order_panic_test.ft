//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: ownership_source_live: invalid solve order
//! stdout:
//| false
/// solve runs once, after the context is initialized. A context that is not initialized
/// breaks that order, so the call panics.
import ownership_source_live;

fn main() i32 {
    ownership_source_live.context mut c = ownership_source_live.context{};
    println(c.initialized);
    ownership_source_live.solve(&c);
    return 0;
}
