//! run
//! flags: -I ../../src/fort -I support -I ../../src
//! abort
//! stderr: panic: json.node_of: not a handle of this document
//! stdout:
//| a handle of the document ok
import lsp.json;

// Every query takes a handle the document handed out. A handle of another
// document, a handle past the nodes, and the absent handle 0 are a violated
// precondition and panic (D13.3): json.has is the query that answers instead
// of panicking.
fn i32 main() {
    json.doc mut d = json.create();
    defer json.free(&d);
    assert(json.parse(&d, "[1]"));
    assert(json.kind_of(&d, json.root(&d)) == json.value_kind.k_array);
    assert(!json.has(&d, 0));
    assert(!json.has(&d, 99));
    println("a handle of the document ok");
    println(cast(json.kind_of(&d, 99), u64));
    return 0;
}
