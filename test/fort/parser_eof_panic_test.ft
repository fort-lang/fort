//! run
//! flags: -I ../../src
//! abort
//! stderr: panic: parser.parse_module: the token vector does not end in end of file
//! stdout:
//| 0
/// The parser reads the tokens lex_file produced, which always end in the
/// end-of-file token. A vector that does not is a violated precondition and panics
/// at parse_module, where bootstrap0/src/parser.c calls fatal_internal.
import fort.ast;
import fort.lexer;
import fort.parser;
import fort.session;

fn main() i32 {
    session.session mut* own s = session.make();
    defer session.drop_made(move(s));
    lexer.tok_vec mut* own toks = lexer.tokvec_make();
    defer lexer.tokvec_drop_made(move(toks));
    ast.arena mut* own ar = ast.arena_make();
    defer ast.arena_drop_made(move(ar));
    println(lexer.tokvec_count(toks));
    ast.node mut* mod = parser.parse_module(s, "t.ft", toks, ar);
    println(ast.ast_len(mod));
    return 0;
}
