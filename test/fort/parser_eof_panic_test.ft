//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: parser.parse_module: the token vector does not end in end of file
//! stdout:
//| 0
import ast;
import lexer;
import parser;
import session;

// The parser reads the tokens lex_file produced, which always end in the
// end-of-file token; a vector that does not is a violated precondition and panics
// at parse_module, where src/bootstrap/parser.c calls fatal_internal.
// D14.2, D13.3
fn i32 main() {
    session.session mut s = session.create();
    defer session.free(&s);
    lexer.tok_vec mut toks = lexer.tokvec_create();
    defer lexer.tokvec_free(&toks);
    ast.arena mut ar = ast.arena{};
    defer ast.ast_arena_free(&ar);
    println(lexer.tokvec_count(&toks));
    ast.node mut* mod = parser.parse_module(&s, "t.ft", &toks, &ar);
    println(ast.ast_len(mod));
    return 0;
}
