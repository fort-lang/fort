//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: gen_fir.gen_struct_type: a struct field with no type
//! stdout:
//| true
/// The checker types each field of a struct that it accepts. A field whose type the test
/// clears breaks that precondition, so gen_struct_type panics.
import ast;
import check_env;
import gen_env;
import gen_fir;

fn main() i32 {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    string src = "struct p {\n    i32 x;\n}\nfn main() i32 {\n    return 0;\n}\n";
    println(gen_env.open_src(&e, src));
    ast.node mut* decl = check_env.node_in_main(&e.c, ast.ast_kind.k_struct_decl, "p");
    ast.node mut* field = check_env.node_in_main(&e.c, ast.ast_kind.k_field_decl, "x");
    field->ty = null;
    gen_fir.gen_struct_type(&e.g, decl);
    return 0;
}
