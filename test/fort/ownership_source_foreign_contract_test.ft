//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| library contract ok
//| executable contract ok
//| selected main ok
//| export spelling ok
/// Tests the foreign-caller contract of D9.7 in a library closure and in an executable closure.
/// Foreign code calls a fort function only through a function value that it receives, through
/// the emitted `main`, or through generated entry points. So the closure marks those bodies
/// foreign-called, and no other body. A library body keeps its caller requirements, and its fort
/// callers meet them (D17.19). A closure is a library when its entry module has no selected
/// `main` (D20.1). The language has no export attribute: `pub` is a reserved word (D2.4).
import check_env;
import ownership_api;
import ownership_source;
import ownership_source_calls;
import ownership_source_env;
import std.strbuf;

// A line here is a line of the entry module `main`. `helper` reads through its pointer parameter,
// so its summary has a caller-source requirement. `via_helper` meets it with the address of a
// local, and `bad_helper` passes the address of released storage. `hook` has the body of
// `helper`, and `install` gives it to foreign code as a function value. `via_lib` calls the
// `main` of module `lib`, which is no entry.
u32 HOOK_LINE = 6;
string[8] SOURCE = {
    "import lib;",
    "extern fn register(fn (i32*) i32 hook) void;",
    "fn helper(i32* p) i32 { return *p; }",
    "fn via_helper() i32 { i32 x = 1; return helper(&x); }",
    "fn bad_helper() i32 { i32 mut* own b = new(i32); i32* q = b; del(b); return helper(q); }",
    "fn hook(i32* p) i32 { return *p; }",
    "fn install() void { register(hook); }",
    "fn via_lib() i32 { i32 x = 1; return lib.main(&x); }",
};

string LIB = "fn main(i32* p) i32 { return *p; }\n";

// The bodies that keep their caller requirements, with their modules. Each row proves.
string[4] MODULES = {"main", "main", "main", "lib"};
string[4] KEPT = {"helper", "via_helper", "via_lib", "main"};

// The bodies of lower_env.RUNTIME that a generated runtime check calls. FIR lowers a print and a
// string comparison to fort calls, so `str_eq` and the print bodies have fort callers only.
string[11] GENERATED = {"fail_overflow", "fail_shift", "fail_div_zero", "fail_div_overflow",
    "fail_bounds", "fail_span", "fail_alloc_count", "fail_overwrite", "fail_enum",
    "assert_fail", "panic"};
string[3] FORT_CALLED = {"str_eq", "print_str", "print_i64"};

fn open(ownership_source_env.env mut* e, string@ tail) void {
    ownership_source_env.open(e);
    ownership_source_env.runtime(e);
    check_env.add(&e->checked, "lib.ft", LIB);
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    for (string line : SOURCE) {
        strbuf.append(&text, line);
        strbuf.push(&text, '\n');
    }
    // A range loop over the parameter cannot prove that a call keeps its storage, so the loop
    // indexes it.
    u64 mut i = 0;
    while (i < tail.len) {
        strbuf.append(&text, tail[i]);
        strbuf.push(&text, '\n');
        i += 1;
    }
    assert(ownership_source_env.prepare(e, strbuf.view(&text)));
    ownership_source.analyze(&e->source);
    assert(e->source.graph_built && ownership_api.successful(e->source.graph.proof));
}

// The index of the row of `name` in module `module`, which is also its index in the graph.
fn index(ownership_source_env.env* e, string module, string name) u64 {
    u64 mut i = 0;
    while (i < e->source.bodies.len) {
        ownership_source.body* row = &e->source.bodies[i];
        if (row->module->path == module && row->declaration->name == name) { return i; }
        i += 1;
    }
    panic("ownership_source_foreign_contract_test: no such body");
}

fn foreign(ownership_source_env.env* e, string module, string name) bool {
    u64 at = index(e, module, name);
    assert(at < e->source.graph.foreign_called.len);
    return e->source.graph.foreign_called[at];
}

// The count of the bodies that the closure marks foreign-called.
fn marked(ownership_source_env.env* e) u64 {
    u64 mut count = 0;
    for (bool flag : e->source.graph.foreign_called) {
        if (flag) { count += 1; }
    }
    return count;
}

fn row(ownership_source_env.env mut* e, string module, string name)
    ownership_source_calls.row* {
    ownership_source_calls.row* found = ownership_source_env.find(e, module, name)->calls;
    assert(found != null);
    return found;
}

fn report(string name, ownership_source_calls.row* found) void {
    eprintln(name, ": reason ", cast(found->proof.terminal.reason, u64), " at ",
        found->proof.terminal.source.line);
}

fn proved(ownership_source_env.env mut* e, string module, string name) void {
    ownership_source_calls.row* found = row(e, module, name);
    if (!ownership_api.successful(found->proof) || found->violations != 0) {
        report(name, found);
        assert(false);
    }
}

// A foreign-called body loses its requirement, so its row gives incomplete proof at the read.
fn lost_at(ownership_source_env.env mut* e, string name, u32 line) void {
    ownership_source_calls.row* found = row(e, "main", name);
    if (ownership_api.successful(found->proof) || found->violations != 0 ||
        found->proof.terminal.reason != ownership_api.incomplete_reason.missing_path ||
        found->proof.terminal.source.line != line) {
        report(name, found);
        assert(false);
    }
}

// The marks and rows that each closure kind shares. The generated runtime bodies and the
// function value `hook` are foreign-called. Each other body keeps its requirement: its fort
// callers meet it, and a caller that passes released storage does not prove.
fn shared(ownership_source_env.env mut* e) void {
    for (string name : GENERATED) { assert(foreign(e, "std.rt", name)); }
    for (string name : FORT_CALLED) { assert(!foreign(e, "std.rt", name)); }
    assert(foreign(e, "main", "hook"));
    lost_at(e, "hook", HOOK_LINE);
    u64 mut i = 0;
    while (i < KEPT.len) {
        assert(!foreign(e, MODULES[i], KEPT[i]));
        proved(e, MODULES[i], KEPT[i]);
        i += 1;
    }
    assert(!foreign(e, "main", "bad_helper"));
    assert(!ownership_api.successful(row(e, "main", "bad_helper")->proof));
    // The extern call keeps the row of `install` incomplete (D17.13), and the body reads no
    // caller source.
    assert(!foreign(e, "main", "install") && row(e, "main", "install")->violations == 0);
}

// A library has no generated `main`, so its marks are the generated runtime bodies and `hook`.
fn library_contract() void {
    ownership_source_env.env mut e = ownership_source_env.env{};
    string@ none = {};
    open(&e, none);
    assert(!e.source.exit.executable);
    shared(&e);
    assert(marked(&e) == GENERATED.len + 1);
    ownership_source_env.close(&e);
    println("library contract ok");
}

// An executable adds the entry `main`, which the C start-up code reaches through the emitted
// `main`. Its body has no requirement, so its mark changes no proof.
fn executable_contract() void {
    ownership_source_env.env mut e = ownership_source_env.env{};
    string[1] tail = {"fn main() i32 { return 0; }"};
    open(&e, tail[..]);
    assert(e.source.exit.executable);
    shared(&e);
    assert(foreign(&e, "main", "main"));
    proved(&e, "main", "main");
    assert(marked(&e) == GENERATED.len + 2);
    ownership_source_env.close(&e);
    println("executable contract ok");
}

// Compile-time selection decides the kind (D21.2). A `main` in an inactive branch leaves a
// library, and a `main` in the selected branch makes an executable.
fn selected_main() void {
    ownership_source_env.env mut inactive = ownership_source_env.env{};
    string[3] dropped = {"$if (false) {", "    fn main() i32 { return 0; }", "}"};
    open(&inactive, dropped[..]);
    assert(!inactive.source.exit.executable);
    assert(marked(&inactive) == GENERATED.len + 1);
    proved(&inactive, "main", "helper");
    ownership_source_env.close(&inactive);
    ownership_source_env.env mut active = ownership_source_env.env{};
    string[3] chosen = {"$if (true) {", "    fn main() i32 { return 0; }", "}"};
    open(&active, chosen[..]);
    assert(active.source.exit.executable);
    assert(foreign(&active, "main", "main") && !foreign(&active, "main", "helper"));
    assert(marked(&active) == GENERATED.len + 2);
    proved(&active, "main", "via_helper");
    ownership_source_env.close(&active);
    println("selected main ok");
}

// A source that spells an export attribute fails checking, so no graph reads it.
fn export_spelling() void {
    ownership_source_env.env mut e = ownership_source_env.env{};
    ownership_source_env.open(&e);
    ownership_source_env.runtime(&e);
    assert(!ownership_source_env.prepare(&e, "pub fn helper(i32* p) i32 { return *p; }\n"));
    ownership_source.analyze(&e.source);
    assert(!e.source.graph_built && e.source.graph.foreign_called.len == 0);
    ownership_source_env.close(&e);
    println("export spelling ok");
}

fn main() i32 {
    library_contract();
    executable_contract();
    selected_main();
    export_spelling();
    return 0;
}
