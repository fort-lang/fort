//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: fir.projs_push: too many projections
//! stdout:
//| 0
/// A projection number is a u32, so projs_push refuses a function that already has U32_LIMIT
/// projections. The test sets the count to that limit, and the call panics.
import fir;
import prim;
import types;

fn main() i32 {
    types.table mut tt = types.table{};
    defer types.type_table_free(&tt);
    types.node* i32t = types.type_prim(&tt, prim.prim_kind.prim_i32);
    types.node*[1] params = {i32t};
    types.node* fnty = types.type_fn(&tt, i32t, params[..], false);
    fir.func mut f = fir.func_new(&tt, null, fnty);
    defer fir.func_free(&f);
    println(f.projs.len);
    f.projs.len = fir.U32_LIMIT;
    fir.projs_push(&f, fir.projection{});
    return 0;
}
