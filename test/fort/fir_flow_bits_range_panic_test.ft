//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: fir_flow.bits_get: the bit is out of range
//! stdout:
//| ready
/// Checks the bound of fir_flow.bits_get. A set of 65 numbers has two words, so bit 65 stands in
/// a word of the set and is still out of range.
import fir_flow;

fn main() i32 {
    fir_flow.bits mut s = fir_flow.bits_new(65);
    defer fir_flow.bits_free(&s);
    fir_flow.bits_fill(&s);
    assert(fir_flow.bits_get(&s, 64));
    println("ready");
    fir_flow.bits_get(&s, 65);
    return 0;
}
