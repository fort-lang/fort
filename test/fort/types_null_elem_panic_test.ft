//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: types: null as an element type
//! stdout:
//| 16
import types;
import types_env;

/// The type of the literal `null` adopts a pointer type before it is
/// used, so it is never the element of a span.
fn main() i32 {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    println(types.type_sizeof(types.type_span(&e.tt, types_env.type_of(&e, "i32"), false, false)));
    println(types.type_sizeof(types.type_span(&e.tt, types.type_null(&e.tt), false, false)));
    return 0;
}
