fn c13() void {
    ownership_raw_bytes_publication_env.sample mut s = {};
    ownership_raw_bytes_publication_env.open(&s, 0, 0, false, false);
    defer ownership_raw_bytes_publication_env.close(&s);
    assert(s.e.paired.states[0].bytes.representations_len >= 2);
    assert(s.e.paired.states[0].bytes.snapshots_len == 1);
    ownership_raw_bytes_publication_env.partial(&s, 0, 4530);
    assert(s.e.paired.states[0].core->contents[0].kind == ownership_api.contents_kind.unknown);
    assert(s.e.paired.states[0].bytes.representations[0].selected.begin == 0);
    assert(s.e.paired.states[0].bytes.representations[0].selected.end == s.bytes);
    println("publication boundary C13");
}
