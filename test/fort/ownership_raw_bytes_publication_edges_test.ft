/// Tests canonical mappings, incomplete bytes, and original ownership obligations.
import ast;
import ownership_api;
import ownership_keys;
import ownership_raw;
import ownership_raw_bytes;
import ownership_raw_bytes_env;
import ownership_raw_bytes_publication_env;
import ownership_state;
import ownership_transfer;
import types;
fn c01() void {
    ownership_raw_bytes_publication_env.sample mut s = {};
    ownership_raw_bytes_publication_env.open(&s, 1, 0, false, true);
    defer ownership_raw_bytes_publication_env.close(&s);
    s.e.paired.states[0].bytes.representations[0].selected.place = s.captured;
    ownership_raw_bytes_publication_env.write(&s, 4310);
    ownership_raw_bytes_publication_env.assert_value(&s,
        ownership_raw_bytes_publication_env.fact(&s), 2);
    ownership_raw_bytes_publication_env.typed(&s,
        ownership_raw_bytes_publication_env.fact(&s), true, true, 4311);
    ownership_raw_bytes_publication_env.neighbor(&s);
    assert(s.e.paired.states[0].core->contents_len == 2);
    println("publication boundary C01");
}
