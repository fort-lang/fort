fn c25() void {
    ownership_raw_bytes_publication_env.sample mut s = {};
    ownership_raw_bytes_publication_env.open(&s, 0, 1, false, false);
    defer ownership_raw_bytes_publication_env.close(&s);
    ownership_raw_bytes_env.read(&s.e, 1, 0, 16, 81, 4700);
    assert(s.e.paired.states[0].bytes.snapshots[0].fragments[0].value.value_version.ordinal == 2);
    assert(s.e.paired.states[0].bytes.snapshots[1].fragments[0].value.value_version.ordinal == 1);
    ownership_raw_bytes_env.write(&s.e, 1, 0, 8, 80, 0, 4701);
    ownership_raw_bytes_env.write(&s.e, 1, 8, 16, 81, 8, 4702);
    assert(s.e.paired.states[0].bytes.representations[0].fragments_len == 2);
    ownership_raw_bytes_publication_env.unknown(&s, 4703);
    assert(s.e.paired.states[0].bytes.snapshots_len == 2);
    assert(s.e.paired.states[0].core->allocations[0].obligation);
    println("publication boundary C25");
}
fn c26() void {
    ownership_raw_bytes_publication_env.sample mut s = {};
    ownership_raw_bytes_publication_env.string_sample(&s);
    defer ownership_raw_bytes_publication_env.close(&s);
    ownership_api.contents_fact mut other = s.e.second;
    ownership_api.borrow_relation[1] mut borrow = {other.borrows[0]};
    borrow[0].source = ownership_raw_bytes_env.id(&s.e, ownership_api.entity_kind.source, 1);
    borrow[0].range.access.end = ownership_raw_bytes_env.exact(6);
    other.borrows = borrow[..];
    ownership_raw_bytes.byte_effect mut replacement = ownership_raw_bytes_env.effect(&s.e,
        ownership_raw_bytes.effect_kind.replacement,
        ownership_raw_bytes_env.window(&s.e, 3, 0, 16, s.actual));
    replacement.value = other;
    replacement.checked_value = true;
    ownership_raw_bytes_env.apply(&s.e, replacement, 4710);
    ownership_raw_bytes_env.read(&s.e, 3, 0, 16, 81, 4711);
    assert(s.e.paired.states[0].bytes.snapshots[0].fragments[0].value.value_version.ordinal == 2);
    assert(s.e.paired.states[0].bytes.snapshots[1].fragments[0].value.value_version.ordinal == 2);
    assert(s.e.paired.states[0].bytes.snapshots[0].fragments[0].value.borrows[0].source.ordinal ==
        2);
    assert(s.e.paired.states[0].bytes.snapshots[1].fragments[0].value.borrows[0].source.ordinal ==
        1);
    ownership_raw_bytes_env.write(&s.e, 1, 0, 8, 80, 0, 4712);
    ownership_raw_bytes_env.write(&s.e, 1, 8, 16, 81, 8, 4713);
    ownership_raw_bytes_publication_env.unknown(&s, 4714);
    assert(s.e.paired.states[0].bytes.snapshots_len == 2);
    println("publication boundary C26");
}
fn c27() void {
    ownership_raw_bytes_publication_env.sample mut s = {};
    ownership_raw_bytes_publication_env.open(&s, 0, 0, false, false);
    defer ownership_raw_bytes_publication_env.close(&s);
    ownership_state.state mut* core = s.e.paired.states[0].core;
    core->contents[0] = core->contents[1];
    core->contents_len = 1;
    ownership_raw_bytes_publication_env.write(&s, 4720);
    assert(s.e.paired.states[0].core->contents_len == 1);
    assert(s.e.paired.states[0].core->contents[0].place.root.ordinal == 2);
    assert(s.e.paired.states[0].core->contents[0].kind == ownership_api.contents_kind.empty_owner);
    ownership_api.contents_fact mut missing = {};
    missing.place = s.target;
    ownership_raw_bytes_publication_env.typed(&s, missing, false, true, 4721);
    assert(s.e.paired.states[0].bytes.representations_len == 2);
    println("publication boundary C27");
}
