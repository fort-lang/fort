//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: types.index_grown: capacity overflow
//! stdout:
//| 64 128
/// index_grown gives the intern index its first slot count and doubles it after that. It panics
/// when the double does not fit u64. The test passes U64_MAX.
import types;

fn main() i32 {
    println(types.index_grown(0), " ", types.index_grown(64));
    types.index_grown(types.U64_MAX);
    return 0;
}
