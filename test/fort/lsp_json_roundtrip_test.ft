//! run
//! flags: -I ../../src/fort -I support -I ../../src
//! stdout:
//| kinds ok
//| documents ok
//| stability ok
//| ok
import lsp.json;
import lsp_json_env;
import std.strbuf;

/// Checks that accepted JSON round-trips byte for byte when the input uses the writer's
/// canonical spelling.
//
// Two documents correctly differ after a round trip. One uses an escape that
// the writer does not use, such as \u0041 for A. The other has whitespace that
// the reader skips. lsp_json_env.reads_as holds those, here and in
// lsp_json_escape_test.ft, and this file holds the byte-stable half.
//
// The corpus below covers every member of value_kind but k_none, which is the
// kind of the absent node and of no value. kinds_covered counts the covered
// kinds.

// The kinds a value takes, k_none included: the array the coverage count is
// indexed by.
u64 KIND_COUNT = 8;

// The documents of the corpus, each one spelled as the writer spells it.
u64 CORPUS_SIZE = 24;

fn corpus_into(string mut@ out) void {
    out[0] = "null";
    out[1] = "true";
    out[2] = "false";
    out[3] = "0";
    out[4] = "-1";
    out[5] = "9223372036854775807";
    out[6] = "1.5";
    out[7] = "-2.5e-7";
    out[8] = "\"\"";
    out[9] = "\"abc\"";
    out[10] = "\"a\\nb\"";
    out[11] = "[]";
    out[12] = "{}";
    out[13] = "[1]";
    out[14] = "[1,2,3]";
    out[15] = "[[]]";
    out[16] = "[[1],[2,[3]]]";
    out[17] = "{\"a\":1}";
    out[18] = "{\"a\":1,\"b\":2}";
    out[19] = "{\"a\":{\"b\":{\"c\":null}}}";
    out[20] = "{\"a\":[1,{\"b\":[]}]}";
    out[21] = "[null,true,false,0,1.5,\"s\",[],{}]";
    out[22] = "{\"\":\"\"}";
    out[23] = "[\"\\u0000\",\"\\u001F\",\"\\\"\",\"\\\\\"]";
}

// Marks every kind the tree below `v` holds.
fn mark_kinds(json.doc* d, u32 v, bool mut@ seen) void {
    seen[cast(json.kind_of(d, v), u64)] = true;
    u32 mut child = json.first_of(d, v);
    while (child != 0) {
        mark_kinds(d, child, seen);
        child = json.next_of(d, child);
    }
}

// ---- every kind ------------------------------------------------------------------

fn every_kind_round_trips_byte_stably() void {
    string mut@ own corpus = new(string, CORPUS_SIZE);
    defer del(corpus);
    corpus_into(corpus);
    u64 mut i = 0;
    while (i < CORPUS_SIZE) {
        lsp_json_env.round_trip(corpus[i]);
        i += 1;
    }
}

fn the_corpus_covers_every_kind_but_the_absent_one() void {
    string mut@ own corpus = new(string, CORPUS_SIZE);
    defer del(corpus);
    corpus_into(corpus);
    bool mut@ own seen = new(bool, KIND_COUNT);
    defer del(seen);
    json.doc mut d = json.create();
    defer json.free(&d);
    u64 mut i = 0;
    while (i < CORPUS_SIZE) {
        assert(json.parse(&d, corpus[i]));
        mark_kinds(&d, json.root(&d), seen);
        i += 1;
    }
    // k_none is the kind of handle 0 and of nothing the reader builds.
    assert(!seen[cast(json.value_kind.k_none, u64)]);
    u64 mut covered = 0;
    u64 mut k = 0;
    while (k < KIND_COUNT) {
        if (seen[k]) {
            covered += 1;
        }
        k += 1;
    }
    // The seven kinds of a value: null, bool, int, float, string, array and
    // object.
    assert(covered == 7);
}

fn a_bare_value_of_each_kind_is_its_own_document() void {
    lsp_json_env.round_trip("null");
    lsp_json_env.round_trip("true");
    lsp_json_env.round_trip("false");
    lsp_json_env.round_trip("17");
    lsp_json_env.round_trip("1.5");
    lsp_json_env.round_trip("\"text\"");
    lsp_json_env.round_trip("[]");
    lsp_json_env.round_trip("{}");
}

// ---- whole documents -------------------------------------------------------------

fn a_message_of_the_protocol_round_trips() void {
    strbuf.str_buf mut source = strbuf.create();
    defer strbuf.free(&source);
    strbuf.append(&source, "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":");
    strbuf.append(&source, "{\"capabilities\":{\"textDocumentSync\":1,");
    strbuf.append(&source, "\"diagnosticProvider\":{\"interFileDependencies\":true,");
    strbuf.append(&source, "\"workspaceDiagnostics\":false}}}}");
    lsp_json_env.round_trip(strbuf.view(&source));
}

fn a_document_of_diagnostics_round_trips() void {
    strbuf.str_buf mut source = strbuf.create();
    defer strbuf.free(&source);
    strbuf.append(&source, "{\"diagnostics\":[{\"range\":{\"start\":{\"line\":0,");
    strbuf.append(&source, "\"character\":4},\"end\":{\"line\":0,\"character\":9}},");
    strbuf.append(&source, "\"severity\":1,\"message\":\"unknown name 'x'\",");
    strbuf.append(&source, "\"notes\":[]}]}");
    lsp_json_env.round_trip(strbuf.view(&source));
}

fn a_wide_array_round_trips() void {
    strbuf.str_buf mut source = strbuf.create();
    defer strbuf.free(&source);
    strbuf.push(&source, '[');
    u64 mut i = 0;
    while (i < 2000) {
        if (i > 0) {
            strbuf.push(&source, ',');
        }
        strbuf.append_u64(&source, i);
        i += 1;
    }
    strbuf.push(&source, ']');
    lsp_json_env.round_trip(strbuf.view(&source));
}

fn a_deep_document_round_trips() void {
    strbuf.str_buf mut source = strbuf.create();
    defer strbuf.free(&source);
    u64 mut i = 0;
    while (i < 64) {
        strbuf.push(&source, '[');
        i += 1;
    }
    i = 0;
    while (i < 64) {
        strbuf.push(&source, ']');
        i += 1;
    }
    lsp_json_env.round_trip(strbuf.view(&source));
}

fn a_document_of_long_strings_round_trips() void {
    strbuf.str_buf mut source = strbuf.create();
    defer strbuf.free(&source);
    strbuf.append(&source, "[\"");
    u64 mut i = 0;
    while (i < 5000) {
        strbuf.append(&source, "ab\\ncd");
        i += 1;
    }
    strbuf.append(&source, "\"]");
    lsp_json_env.round_trip(strbuf.view(&source));
}

// ---- stability -------------------------------------------------------------------

fn writing_and_reading_again_reaches_a_fixed_point() void {
    // The second round trip of a document is the first: the writer's output
    // is a document the reader accepts and writes back unchanged.
    string mut@ own corpus = new(string, CORPUS_SIZE);
    defer del(corpus);
    corpus_into(corpus);
    json.doc mut first = json.create();
    defer json.free(&first);
    json.doc mut second = json.create();
    defer json.free(&second);
    strbuf.str_buf mut once = strbuf.create();
    defer strbuf.free(&once);
    strbuf.str_buf mut twice = strbuf.create();
    defer strbuf.free(&twice);
    u64 mut i = 0;
    while (i < CORPUS_SIZE) {
        assert(json.parse(&first, corpus[i]));
        string written = lsp_json_env.written(&first, &once);
        assert(json.parse(&second, written));
        lsp_json_env.check(lsp_json_env.written(&second, &twice), written, corpus[i]);
        i += 1;
    }
}

fn a_document_that_is_not_the_writer_s_spelling_reads_as_the_writer_s() void {
    lsp_json_env.reads_as("{ \"a\" : [ 1 , 2 ] }", "{\"a\":[1,2]}");
    lsp_json_env.reads_as("\"\\u0041\"", "\"A\"");
    lsp_json_env.reads_as("\"\\/\"", "\"/\"");
    lsp_json_env.reads_as("[\"\\u00e9\"]", "[\"\xc3\xa9\"]");
}

fn the_writer_writes_a_document_after_other_bytes() void {
    // The buffer belongs to the caller and is not emptied, which is what lets
    // a server write a header and a body into one buffer.
    json.doc mut d = json.create();
    defer json.free(&d);
    assert(json.parse(&d, "{\"a\":1}"));
    strbuf.str_buf mut out = strbuf.create();
    defer strbuf.free(&out);
    strbuf.append(&out, "before:");
    json.writer mut w = json.writer{};
    json.write_init(&w, &out);
    json.write_document(&w, &d);
    lsp_json_env.check(strbuf.view(&out), "before:{\"a\":1}", "a document after other bytes");
}

fn a_subtree_is_written_on_its_own() void {
    json.doc mut d = json.create();
    defer json.free(&d);
    assert(json.parse(&d, "{\"a\":[1,{\"b\":null}]}"));
    strbuf.str_buf mut out = strbuf.create();
    defer strbuf.free(&out);
    json.writer mut w = json.writer{};
    json.write_init(&w, &out);
    json.write_value(&w, &d, json.member_of(&d, json.root(&d), "a"));
    lsp_json_env.check(strbuf.view(&out), "[1,{\"b\":null}]", "a subtree alone");
}

fn a_document_is_built_by_hand_and_read_back() void {
    // The writer is usable without a reader, which is how a server answers a
    // request it built itself.
    strbuf.str_buf mut out = strbuf.create();
    defer strbuf.free(&out);
    json.writer mut w = json.writer{};
    json.write_init(&w, &out);
    json.write_object_begin(&w);
    json.write_key(&w, "jsonrpc");
    json.write_str(&w, "2.0");
    json.write_key(&w, "id");
    json.write_int(&w, -3);
    json.write_key(&w, "size");
    json.write_uint(&w, 18446744073709551615);
    json.write_key(&w, "ok");
    json.write_bool(&w, true);
    json.write_key(&w, "none");
    json.write_null(&w);
    json.write_key(&w, "ratio");
    json.write_number(&w, "1.25");
    json.write_key(&w, "items");
    json.write_array_begin(&w);
    json.write_int(&w, 1);
    json.write_object_begin(&w);
    json.write_object_end(&w);
    json.write_array_end(&w);
    json.write_object_end(&w);
    json.doc mut d = json.create();
    defer json.free(&d);
    assert(json.parse(&d, strbuf.view(&out)));
    u32 root = json.root(&d);
    assert(json.count_of(&d, root) == 7);
    assert(json.text_of(&d, json.member_of(&d, root, "size")) == "18446744073709551615");
    assert(json.kind_of(&d, json.member_of(&d, root, "size")) == json.value_kind.k_float);
    assert(json.int_of(&d, json.member_of(&d, root, "id")) == -3);
    assert(json.count_of(&d, json.member_of(&d, root, "items")) == 2);
    strbuf.str_buf mut again = strbuf.create();
    defer strbuf.free(&again);
    lsp_json_env.check(lsp_json_env.written(&d, &again), strbuf.view(&out),
        "a document built by hand");
}

fn main() i32 {
    every_kind_round_trips_byte_stably();
    the_corpus_covers_every_kind_but_the_absent_one();
    a_bare_value_of_each_kind_is_its_own_document();
    println("kinds ok");
    a_message_of_the_protocol_round_trips();
    a_document_of_diagnostics_round_trips();
    a_wide_array_round_trips();
    a_deep_document_round_trips();
    a_document_of_long_strings_round_trips();
    println("documents ok");
    writing_and_reading_again_reaches_a_fixed_point();
    a_document_that_is_not_the_writer_s_spelling_reads_as_the_writer_s();
    the_writer_writes_a_document_after_other_bytes();
    a_subtree_is_written_on_its_own();
    a_document_is_built_by_hand_and_read_back();
    println("stability ok");
    println("ok");
    return 0;
}
