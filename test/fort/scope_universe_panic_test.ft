//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: scope.universe_at: index out of range
//! stdout:
//| del
//| fprintln
import scope;

// universe_at answers for the ten builtins of D12.2 and panics past the last
// one, rather than returning a name the universe does not hold (D13.3).
fn i32 main() {
    println(scope.universe_at(0));
    println(scope.universe_at(scope.UNIVERSE_COUNT - 1));
    println(scope.universe_at(scope.UNIVERSE_COUNT));
    return 0;
}
