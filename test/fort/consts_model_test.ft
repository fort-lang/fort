//! run
//! flags: -I ../../src/fort
//! stdout:
//| small ok
//| identities ok
//| shifts ok
//| typed ok
//| wrapping ok
//| ok
/// A second oracle for the exact folder, beside the table of cases
/// test/consts_fold_test.c wrote down. Two kinds of check, neither of them a
/// number typed by an author.
import consts;
import prim;

//
// The suite uses two checks.
// - It compares small untyped operations with plain `i64` arithmetic. This
// catches lost signs, wrong magnitude rounding, and incorrect remainder signs.
// - It compares the full range with algebraic identities. These identities
// cover complement, shifts, De Morgan's laws, division, and comparison.
//
// The typed half applies the same checks to typed folding and wrapping
// operators. A typed operation adds a range check to the untyped operation.
// A wrapping operation reduces the exact value modulo 2^width. This file
// computes that result from the width instead of using the module's truncation.
//
// Nothing here replaces the case tables. It is the net under them, and it is
// what stands in for the C suites that a self-hosted compiler cannot run.

u64 U64_MAX = 18446744073709551615;
u64 TWO63 = 9223372036854775808;
i64 I64_MIN = -9223372036854775808;
i64 I64_MAX = 9223372036854775807;

// The grid of small values: enough of a spread to cross zero and both signs
// without the products leaving `i64`.
i64[13] SMALL = {-1000, -257, -256, -255, -13, -1, 0, 1, 13, 255, 256, 257, 1000};

// The values of the whole range the identity half walks, boundaries included.
u64[9] MAGS = {0, 1, 2, 255, 65536, 4294967296, 9223372036854775807,
               9223372036854775808, 18446744073709551615};

fn i(i64 v) consts.cval {
    return consts.cv_from_i64(v);
}

fn u(u64 v) consts.cval {
    return consts.cv_from_u64(v);
}

// Returns grid value `k` for the identity checks. The grid includes each
// magnitude as a non-negative constant and, when possible, as a negative one.
fn grid_at(u64 k) consts.cval {
    u64 mag = MAGS[k % MAGS.len];
    if (k < MAGS.len) {
        return u(mag);
    }
    if (mag > TWO63) {
        // -mag is outside [-2^63, 2^64 - 1], so the non-negative value stands
        // for it.
        return u(mag);
    }
    consts.cval mut r = consts.cv_none();
    assert(consts.cv_neg(u(mag), &r));
    return r;
}

fn grid_len() u64 {
    return MAGS.len * 2;
}

// ---- the small grid against i64 arithmetic --------------------------------------

fn add_and_sub_agree_with_i64() void {
    u64 mut x = 0;
    while (x < SMALL.len) {
        u64 mut y = 0;
        while (y < SMALL.len) {
            i64 a = SMALL[x];
            i64 b = SMALL[y];
            consts.cval mut r = consts.cv_none();
            assert(consts.cv_add(i(a), i(b), &r));
            assert(consts.cv_eq(r, i(a + b)));
            assert(consts.cv_sub(i(a), i(b), &r));
            assert(consts.cv_eq(r, i(a - b)));
            // A zero result is never negative.
            if (a + b == 0) {
                assert(!r.neg || a - b != 0);
            }
            y += 1;
        }
        x += 1;
    }
}

fn mul_agrees_with_i64() void {
    u64 mut x = 0;
    while (x < SMALL.len) {
        u64 mut y = 0;
        while (y < SMALL.len) {
            i64 a = SMALL[x];
            i64 b = SMALL[y];
            consts.cval mut r = consts.cv_none();
            assert(consts.cv_mul(i(a), i(b), &r));
            assert(consts.cv_eq(r, i(a * b)));
            y += 1;
        }
        x += 1;
    }
}

// `/` truncates toward zero and `%` takes the dividend's sign, which is what
// fort's own `/` and `%` do on i64.
fn div_and_rem_agree_with_i64() void {
    u64 mut x = 0;
    while (x < SMALL.len) {
        u64 mut y = 0;
        while (y < SMALL.len) {
            i64 a = SMALL[x];
            i64 b = SMALL[y];
            consts.cval mut r = consts.cv_none();
            if (b == 0) {
                assert(!consts.cv_div(i(a), i(b), &r));
                assert(!consts.cv_rem(i(a), i(b), &r));
            } else {
                assert(consts.cv_div(i(a), i(b), &r));
                assert(consts.cv_eq(r, i(a / b)));
                assert(consts.cv_rem(i(a), i(b), &r));
                assert(consts.cv_eq(r, i(a % b)));
            }
            y += 1;
        }
        x += 1;
    }
}

fn bitwise_agrees_with_i64() void {
    u64 mut x = 0;
    while (x < SMALL.len) {
        u64 mut y = 0;
        while (y < SMALL.len) {
            i64 a = SMALL[x];
            i64 b = SMALL[y];
            consts.cval mut r = consts.cv_none();
            assert(consts.cv_and(i(a), i(b), &r));
            assert(consts.cv_eq(r, i(a & b)));
            assert(consts.cv_or(i(a), i(b), &r));
            assert(consts.cv_eq(r, i(a | b)));
            assert(consts.cv_xor(i(a), i(b), &r));
            assert(consts.cv_eq(r, i(a ^ b)));
            y += 1;
        }
        x += 1;
    }
}

fn neg_and_not_agree_with_i64() void {
    u64 mut x = 0;
    while (x < SMALL.len) {
        i64 a = SMALL[x];
        consts.cval mut r = consts.cv_none();
        assert(consts.cv_neg(i(a), &r));
        assert(consts.cv_eq(r, i(-a)));
        assert(consts.cv_not(i(a), &r));
        assert(consts.cv_eq(r, i(~a)));
        x += 1;
    }
}

fn cmp_agrees_with_i64() void {
    u64 mut x = 0;
    while (x < SMALL.len) {
        u64 mut y = 0;
        while (y < SMALL.len) {
            i64 a = SMALL[x];
            i64 b = SMALL[y];
            i32 mut want = 0;
            if (a < b) {
                want = -1;
            } else if (a > b) {
                want = 1;
            }
            assert(consts.cv_cmp(i(a), i(b)) == want);
            assert(consts.cv_eq(i(a), i(b)) == (a == b));
            y += 1;
        }
        x += 1;
    }
}

// ---- identities over the whole range --------------------------------------------

// `a + b` is `b + a`, and `(a + b) - b` is `a` whenever both steps stay in
// range.
fn addition_is_commutative_and_undone_by_subtraction() void {
    u64 mut x = 0;
    while (x < grid_len()) {
        // Every grid value adds and subtracts zero. A value one below the top
        // also accepts one. These pairs require the folder to fold. The
        // identities below also hold if a folder refuses every
        // operation, so this pair prevents that false result.
        consts.cval mut unit = consts.cv_none();
        assert(consts.cv_add(grid_at(x), i(0), &unit));
        assert(consts.cv_eq(unit, grid_at(x)));
        assert(consts.cv_sub(grid_at(x), i(0), &unit));
        assert(consts.cv_eq(unit, grid_at(x)));
        u64 mut y = 0;
        while (y < grid_len()) {
            consts.cval a = grid_at(x);
            consts.cval b = grid_at(y);
            consts.cval mut left = consts.cv_none();
            consts.cval mut right = consts.cv_none();
            bool ok = consts.cv_add(a, b, &left);
            assert(consts.cv_add(b, a, &right) == ok);
            assert(consts.cv_eq(left, right) || !ok);
            if (ok) {
                consts.cval mut back = consts.cv_none();
                if (consts.cv_sub(left, b, &back)) {
                    assert(consts.cv_eq(back, a));
                }
            }
            y += 1;
        }
        x += 1;
    }
    // The two pairs that stand one step inside each end of the range. The
    // guard of add_raw admits them and a guard one step out would not.
    consts.cval mut edge = consts.cv_none();
    assert(consts.cv_add(u(U64_MAX - 1), i(1), &edge));
    assert(consts.cv_eq(edge, u(U64_MAX)));
    assert(consts.cv_add(i(I64_MIN + 1), i(-1), &edge));
    assert(consts.cv_eq(edge, i(I64_MIN)));
    assert(consts.cv_sub(i(0), u(TWO63), &edge));
    assert(consts.cv_eq(edge, i(I64_MIN)));
    assert(consts.cv_sub(i(I64_MAX), i(I64_MIN), &edge));
    assert(consts.cv_eq(edge, u(U64_MAX)));
}

// `a - b` is `-(b - a)`, so a subtraction that leaves the range one way leaves
// it the other only when the magnitude does.
fn subtraction_is_the_negation_of_its_mirror() void {
    u64 mut x = 0;
    while (x < grid_len()) {
        u64 mut y = 0;
        while (y < grid_len()) {
            consts.cval a = grid_at(x);
            consts.cval b = grid_at(y);
            consts.cval mut ab = consts.cv_none();
            consts.cval mut ba = consts.cv_none();
            if (consts.cv_sub(a, b, &ab) && consts.cv_sub(b, a, &ba)) {
                consts.cval mut neg = consts.cv_none();
                if (consts.cv_neg(ba, &neg)) {
                    assert(consts.cv_eq(neg, ab));
                }
            }
            y += 1;
        }
        x += 1;
    }
}

// `a * b` is `b * a`, `a * 1` is `a` and `a * 0` is a non-negative zero.
fn multiplication_is_commutative_with_its_units() void {
    u64 mut x = 0;
    while (x < grid_len()) {
        u64 mut y = 0;
        while (y < grid_len()) {
            consts.cval a = grid_at(x);
            consts.cval b = grid_at(y);
            consts.cval mut left = consts.cv_none();
            consts.cval mut right = consts.cv_none();
            bool ok = consts.cv_mul(a, b, &left);
            assert(consts.cv_mul(b, a, &right) == ok);
            if (ok) {
                assert(consts.cv_eq(left, right));
            }
            y += 1;
        }
        consts.cval a = grid_at(x);
        consts.cval mut r = consts.cv_none();
        assert(consts.cv_mul(a, i(1), &r));
        assert(consts.cv_eq(r, a));
        assert(consts.cv_mul(a, i(0), &r));
        assert(consts.cv_eq(r, i(0)));
        assert(!r.neg);
        x += 1;
    }
}

// `(a / b) * b + (a % b)` is `a`, the identity that fixes both operators.
fn division_and_remainder_reconstruct_the_dividend() void {
    u64 mut x = 0;
    while (x < grid_len()) {
        u64 mut y = 0;
        while (y < grid_len()) {
            consts.cval a = grid_at(x);
            consts.cval b = grid_at(y);
            consts.cval mut q = consts.cv_none();
            consts.cval mut rem = consts.cv_none();
            if (consts.cv_is_zero(b)) {
                assert(!consts.cv_div(a, b, &q));
            } else if (consts.cv_div(a, b, &q) && consts.cv_rem(a, b, &rem)) {
                consts.cval mut back = consts.cv_none();
                if (consts.cv_mul(q, b, &back) && consts.cv_add(back, rem, &back)) {
                    assert(consts.cv_eq(back, a));
                }
                // The remainder is smaller than the divisor in magnitude and
                // carries the dividend's sign.
                assert(rem.mag < b.mag);
                assert(!rem.neg || a.neg);
            }
            y += 1;
        }
        x += 1;
    }
}

// `~c` is `-c - 1`, computed here from the two operations it is defined by
// rather than from the complement itself.
fn complement_is_minus_c_minus_one() void {
    u64 mut x = 0;
    while (x < grid_len()) {
        consts.cval a = grid_at(x);
        consts.cval mut want = consts.cv_none();
        consts.cval mut got = consts.cv_none();
        bool model = consts.cv_neg(a, &want) && consts.cv_sub(want, i(1), &want);
        bool ok = consts.cv_not(a, &got);
        assert(ok == model);
        if (ok) {
            assert(consts.cv_eq(got, want));
        }
        x += 1;
    }
}

// De Morgan over the infinite two's-complement patterns: `~(a & b)` is `~a |
// ~b` wherever both sides stay in range.
fn the_bitwise_operators_agree_with_de_morgan() void {
    u64 mut x = 0;
    while (x < grid_len()) {
        u64 mut y = 0;
        while (y < grid_len()) {
            consts.cval a = grid_at(x);
            consts.cval b = grid_at(y);
            consts.cval mut and_ab = consts.cv_none();
            consts.cval mut not_a = consts.cv_none();
            consts.cval mut not_b = consts.cv_none();
            if (consts.cv_and(a, b, &and_ab) && consts.cv_not(a, &not_a) &&
                consts.cv_not(b, &not_b)) {
                consts.cval mut left = consts.cv_none();
                consts.cval mut right = consts.cv_none();
                if (consts.cv_not(and_ab, &left) && consts.cv_or(not_a, not_b, &right)) {
                    assert(consts.cv_eq(left, right));
                }
            }
            // `a ^ b` is `(a | b) & ~(a & b)`.
            consts.cval mut xor_ab = consts.cv_none();
            consts.cval mut or_ab = consts.cv_none();
            if (consts.cv_xor(a, b, &xor_ab) && consts.cv_or(a, b, &or_ab) &&
                consts.cv_and(a, b, &and_ab) && consts.cv_not(and_ab, &not_a) &&
                consts.cv_and(or_ab, not_a, &or_ab)) {
                assert(consts.cv_eq(xor_ab, or_ab));
            }
            y += 1;
        }
        x += 1;
    }
}

// `a & a` is `a`, `a | a` is `a`, `a ^ a` is 0 and `-1` is the identity of `&`
// and the annihilator of `|`.
fn the_bitwise_operators_keep_their_units() void {
    u64 mut x = 0;
    while (x < grid_len()) {
        consts.cval a = grid_at(x);
        consts.cval mut r = consts.cv_none();
        assert(consts.cv_and(a, a, &r));
        assert(consts.cv_eq(r, a));
        assert(consts.cv_or(a, a, &r));
        assert(consts.cv_eq(r, a));
        assert(consts.cv_xor(a, a, &r));
        assert(consts.cv_eq(r, i(0)));
        assert(consts.cv_and(a, i(-1), &r));
        assert(consts.cv_eq(r, a));
        assert(consts.cv_or(a, i(-1), &r));
        assert(consts.cv_eq(r, i(-1)));
        x += 1;
    }
}

// A comparison is antisymmetric and agrees with equality.
fn comparison_is_antisymmetric() void {
    u64 mut x = 0;
    while (x < grid_len()) {
        u64 mut y = 0;
        while (y < grid_len()) {
            consts.cval a = grid_at(x);
            consts.cval b = grid_at(y);
            i32 c = consts.cv_cmp(a, b);
            assert(c == -consts.cv_cmp(b, a));
            assert((c == 0) == consts.cv_eq(a, b));
            y += 1;
        }
        x += 1;
    }
}

// ---- shifts ---------------------------------------------------------------------

// `a << n` is exact multiplication by 2^n. `a >> n` is floor division by it.
// The identity compares these results with `*` and `/`.
fn shifts_are_multiplication_and_floor_division() void {
    u64 mut x = 0;
    while (x < grid_len()) {
        u64 mut n = 0;
        while (n <= 63) {
            consts.cval a = grid_at(x);
            consts.cval mut pow = consts.cv_none();
            assert(consts.cv_shl(i(1), i(cast(n, i64)), &pow));
            consts.cval mut shifted = consts.cv_none();
            consts.cval mut product = consts.cv_none();
            bool ok = consts.cv_shl(a, i(cast(n, i64)), &shifted);
            bool model = consts.cv_mul(a, pow, &product);
            assert(ok == model);
            if (ok) {
                assert(consts.cv_eq(shifted, product));
            }
            // The right shift rounds toward negative infinity, so it is the
            // truncating division only for a non-negative value.
            consts.cval mut down = consts.cv_none();
            assert(consts.cv_shr(a, i(cast(n, i64)), &down));
            consts.cval mut quotient = consts.cv_none();
            assert(consts.cv_div(a, pow, &quotient));
            if (!a.neg) {
                assert(consts.cv_eq(down, quotient));
            } else {
                consts.cval mut back = consts.cv_none();
                assert(consts.cv_mul(down, pow, &back));
                // floor(a / 2^n) * 2^n is at most a, and within 2^n of it.
                assert(consts.cv_cmp(back, a) <= 0);
                consts.cval mut diff = consts.cv_none();
                assert(consts.cv_sub(a, back, &diff));
                assert(consts.cv_cmp(diff, pow) < 0);
                assert(!diff.neg);
            }
            n += 7;
        }
        x += 1;
    }
}

// A count outside 0..63 is refused, whatever the value.
fn a_shift_count_outside_the_range_is_refused() void {
    u64 mut x = 0;
    while (x < grid_len()) {
        consts.cval a = grid_at(x);
        consts.cval mut r = consts.cv_none();
        assert(!consts.cv_shl(a, i(64), &r));
        assert(!consts.cv_shr(a, i(64), &r));
        assert(!consts.cv_shl(a, i(-1), &r));
        assert(!consts.cv_shr(a, i(-1), &r));
        assert(!consts.cv_shl(a, u(U64_MAX), &r));
        // A count of 0 changes nothing.
        assert(consts.cv_shl(a, i(0), &r));
        assert(consts.cv_eq(r, a));
        assert(consts.cv_shr(a, i(0), &r));
        assert(consts.cv_eq(r, a));
        x += 1;
    }
}

// ---- the typed operations -------------------------------------------------------

// The eight integer types, with the width and signedness.
fn int_kind(u64 k) prim.prim_kind {
    return cast(k, prim.prim_kind);
}

fn width_of(prim.prim_kind t) u64 {
    return cast(prim.prim_size(t), u64) * prim.PRIM_BITS_PER_BYTE;
}

// The values of `t` this file folds at: both edges, zero and a few inside.
fn typed_value(prim.prim_kind t, u64 k) consts.cval {
    u64 width = width_of(t);
    u64 one = 1;
    if (prim.prim_is_signed(t)) {
        u64 half = one << (width - 1);
        consts.cval mut low = consts.cv_none();
        assert(consts.cv_neg(u(half), &low));
        consts.cval mut low_plus = consts.cv_none();
        assert(consts.cv_add(low, i(1), &low_plus));
        if (k == 0) {
            return low;
        }
        if (k == 1) {
            return low_plus;
        }
        if (k == 2) {
            return i(-1);
        }
        if (k == 3) {
            return i(0);
        }
        if (k == 4) {
            return i(1);
        }
        return u(half - 1);
    }
    u64 mut top = U64_MAX;
    if (width != 64) {
        top = (one << width) - 1;
    }
    if (k == 0) {
        return i(0);
    }
    if (k == 1) {
        return i(1);
    }
    if (k == 2) {
        return i(2);
    }
    if (k == 3) {
        return u(top / 2);
    }
    if (k == 4) {
        return u(top - 1);
    }
    return u(top);
}

// Whether `v` lies in the range of `t`, computed from the width here rather
// than read off the module.
fn in_range(consts.cval v, prim.prim_kind t) bool {
    u64 width = width_of(t);
    u64 one = 1;
    if (prim.prim_is_signed(t)) {
        u64 half = one << (width - 1);
        if (v.neg) {
            return v.mag <= half;
        }
        return v.mag < half;
    }
    if (v.neg) {
        return false;
    }
    if (width == 64) {
        return true;
    }
    return v.mag < (one << width);
}

// A typed operation is the untyped one plus the range check: the model folds
// exactly and then asks whether the result fits.
fn typed_arithmetic_is_the_exact_result_plus_a_range_check() void {
    u64 mut k = 0;
    while (k <= 7) {
        prim.prim_kind t = int_kind(k);
        u64 mut x = 0;
        while (x <= 5) {
            u64 mut y = 0;
            while (y <= 5) {
                consts.cval a = typed_value(t, x);
                consts.cval b = typed_value(t, y);
                assert(in_range(a, t) && in_range(b, t));
                consts.cval mut exact = consts.cv_none();
                consts.cval mut got = consts.cv_none();
                bool mut model = consts.cv_add(a, b, &exact) && in_range(exact, t);
                assert(consts.cv_typed_add(a, b, t, &got) == model);
                if (model) {
                    assert(consts.cv_eq(got, exact));
                }
                model = consts.cv_sub(a, b, &exact) && in_range(exact, t);
                assert(consts.cv_typed_sub(a, b, t, &got) == model);
                if (model) {
                    assert(consts.cv_eq(got, exact));
                }
                model = consts.cv_mul(a, b, &exact) && in_range(exact, t);
                assert(consts.cv_typed_mul(a, b, t, &got) == model);
                if (model) {
                    assert(consts.cv_eq(got, exact));
                }
                model = consts.cv_div(a, b, &exact) && in_range(exact, t);
                assert(consts.cv_typed_div(a, b, t, &got) == model);
                if (model) {
                    assert(consts.cv_eq(got, exact));
                }
                // `MIN % -1` is 0 exactly but a run-time error, so the
                // remainder is folded only where the quotient is too.
                consts.cval mut quotient = consts.cv_none();
                bool rem_model = consts.cv_div(a, b, &quotient) && in_range(quotient, t) &&
                                 consts.cv_rem(a, b, &exact) && in_range(exact, t);
                assert(consts.cv_typed_rem(a, b, t, &got) == rem_model);
                if (rem_model) {
                    assert(consts.cv_eq(got, exact));
                }
                y += 1;
            }
            x += 1;
        }
        k += 1;
    }
}

// Typed bitwise operations use the untyped operations. Their result stays in
// the type when both operands fit. `~` complements the type width.
fn typed_bitwise_stays_inside_the_type() void {
    u64 mut k = 0;
    while (k <= 7) {
        prim.prim_kind t = int_kind(k);
        u64 mut x = 0;
        while (x <= 5) {
            u64 mut y = 0;
            while (y <= 5) {
                consts.cval a = typed_value(t, x);
                consts.cval b = typed_value(t, y);
                consts.cval mut exact = consts.cv_none();
                consts.cval mut got = consts.cv_none();
                assert(consts.cv_and(a, b, &exact));
                assert(consts.cv_typed_and(a, b, t, &got));
                assert(consts.cv_eq(got, exact) && in_range(got, t));
                assert(consts.cv_or(a, b, &exact));
                assert(consts.cv_typed_or(a, b, t, &got));
                assert(consts.cv_eq(got, exact) && in_range(got, t));
                assert(consts.cv_xor(a, b, &exact));
                assert(consts.cv_typed_xor(a, b, t, &got));
                assert(consts.cv_eq(got, exact) && in_range(got, t));
                y += 1;
            }
            // `~a` at the width: the exact complement when it fits, and the
            // wrapped one when it does not (an unsigned type).
            consts.cval a = typed_value(t, x);
            consts.cval mut got = consts.cv_none();
            assert(consts.cv_typed_not(a, t, &got));
            assert(in_range(got, t));
            consts.cval mut exact = consts.cv_none();
            if (consts.cv_not(a, &exact) && in_range(exact, t)) {
                assert(consts.cv_eq(got, exact));
            }
            // `~~a` is `a` at every width.
            consts.cval mut back = consts.cv_none();
            assert(consts.cv_typed_not(got, t, &back));
            assert(consts.cv_eq(back, a));
            x += 1;
        }
        k += 1;
    }
}

// ---- the wrapping operators -----------------------------------------------------

// The exact value reduced modulo 2^width, computed here from the width: the
// low bits of the pattern, sign-extended for a signed type.
fn wrapped(u64 bits, prim.prim_kind t) consts.cval {
    u64 width = width_of(t);
    u64 one = 1;
    u64 mut mask = U64_MAX;
    if (width != 64) {
        mask = (one << width) - 1;
    }
    u64 low = bits & mask;
    if (prim.prim_is_signed(t) && (low & (one << (width - 1))) != 0) {
        u64 modulus = mask - low + 1;
        consts.cval mut r = consts.cv_none();
        assert(consts.cv_neg(u(modulus), &r));
        return r;
    }
    return consts.cv_from_u64(low);
}

fn the_wrapping_operators_reduce_modulo_the_width() void {
    u64 mut k = 0;
    while (k <= 7) {
        prim.prim_kind t = int_kind(k);
        u64 mut x = 0;
        while (x <= 5) {
            u64 mut y = 0;
            while (y <= 5) {
                consts.cval a = typed_value(t, x);
                consts.cval b = typed_value(t, y);
                u64 pa = consts.cv_bits(a);
                u64 pb = consts.cv_bits(b);
                assert(consts.cv_eq(consts.cv_wrap_add(a, b, t), wrapped(pa +% pb, t)));
                assert(consts.cv_eq(consts.cv_wrap_sub(a, b, t), wrapped(pa -% pb, t)));
                assert(consts.cv_eq(consts.cv_wrap_mul(a, b, t), wrapped(pa *% pb, t)));
                // A wrapping result always lies in the type, and equals the
                // checked one wherever that one succeeds.
                assert(in_range(consts.cv_wrap_add(a, b, t), t));
                consts.cval mut exact = consts.cv_none();
                if (consts.cv_typed_add(a, b, t, &exact)) {
                    assert(consts.cv_eq(consts.cv_wrap_add(a, b, t), exact));
                }
                if (consts.cv_typed_sub(a, b, t, &exact)) {
                    assert(consts.cv_eq(consts.cv_wrap_sub(a, b, t), exact));
                }
                if (consts.cv_typed_mul(a, b, t, &exact)) {
                    assert(consts.cv_eq(consts.cv_wrap_mul(a, b, t), exact));
                }
                y += 1;
            }
            x += 1;
        }
        k += 1;
    }
}

// A cast keeps the low bits of the pattern and extends by the target, which is
// the same reduction the wrapping operators make.
fn a_cast_is_the_same_reduction() void {
    u64 mut k = 0;
    while (k <= 7) {
        prim.prim_kind t = int_kind(k);
        u64 mut x = 0;
        while (x < grid_len()) {
            consts.cval a = grid_at(x);
            consts.cval mut got = consts.cv_none();
            assert(consts.cv_cast(a, t, &got));
            assert(consts.cv_eq(got, wrapped(consts.cv_bits(a), t)));
            assert(in_range(got, t));
            // A value already in the type is unchanged by the cast.
            if (in_range(a, t)) {
                assert(consts.cv_eq(got, a));
            }
            x += 1;
        }
        k += 1;
    }
}

fn main() i32 {
    add_and_sub_agree_with_i64();
    mul_agrees_with_i64();
    div_and_rem_agree_with_i64();
    bitwise_agrees_with_i64();
    neg_and_not_agree_with_i64();
    cmp_agrees_with_i64();
    println("small ok");
    addition_is_commutative_and_undone_by_subtraction();
    subtraction_is_the_negation_of_its_mirror();
    multiplication_is_commutative_with_its_units();
    division_and_remainder_reconstruct_the_dividend();
    complement_is_minus_c_minus_one();
    the_bitwise_operators_agree_with_de_morgan();
    the_bitwise_operators_keep_their_units();
    comparison_is_antisymmetric();
    println("identities ok");
    shifts_are_multiplication_and_floor_division();
    a_shift_count_outside_the_range_is_refused();
    println("shifts ok");
    typed_arithmetic_is_the_exact_result_plus_a_range_check();
    typed_bitwise_stays_inside_the_type();
    println("typed ok");
    the_wrapping_operators_reduce_modulo_the_width();
    a_cast_is_the_same_reduction();
    println("wrapping ok");
    println("ok");
    return 0;
}
