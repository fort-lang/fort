//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: pass_env.breaks_premises: another count of functions breaks a premise rule
//! stderr: 2 functions break a premise rule, and not 1
//! stdout:
//| ready
/// pass_env.breaks_premises stops the test for a text of which 2 functions break a premise rule
/// when the test states the count 1: a text that gets a violation by error fails.
import fort.fir;
import lower_env;
import pass_env;
import premise_env;

// A panic ends the program, so the case stands in a file of its own.
fn main() i32 {
    lower_env.env mut* own e = lower_env.make();
    defer lower_env.drop_made(move(e));
    fir.module mut* own m = pass_env.parse_made(e, premise_env.PRELUDE[..], premise_env.BOTH[..]);
    defer fir.module_drop_made(move(m));
    println("ready");
    pass_env.breaks_premises(e, m, 1, "the verifier refuses BOTH");
    return 0;
}
