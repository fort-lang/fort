//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: consts.cv_from_char: char constant outside 0..255
//! stdout:
//| 255
import consts;

// A char literal is a code point 0..255, which the lexer guarantees, so a
// code point above it is a broken precondition and panics where
// src/bootstrap/consts.c calls fatal_internal.
// D2.7, D2.8, D13.3
fn main() i32 {
    println(consts.cv_from_char(255).mag);
    println(consts.cv_from_char(256).mag);
    return 0;
}
