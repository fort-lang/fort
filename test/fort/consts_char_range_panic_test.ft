//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: consts.cv_from_char: char constant outside 0..255
//! stdout:
//| 255
import consts;

/// Checks that character folding rejects a code point above 255. The lexer prevents this value,
/// so it breaks the folder precondition.
fn main() i32 {
    println(consts.cv_from_char(255).mag);
    println(consts.cv_from_char(256).mag);
    return 0;
}
