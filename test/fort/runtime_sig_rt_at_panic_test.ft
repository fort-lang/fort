//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: runtime_sig.rt_at: index out of range
//! stdout:
//| true
/// rt_at reads the entry at an index below RT_ENTRY_COUNT. The index RT_ENTRY_COUNT is past
/// the table, so the call panics.
import runtime_sig;

fn main() i32 {
    println(runtime_sig.rt_at(runtime_sig.RT_ENTRY_COUNT - 1) != runtime_sig.rt_entry.rt_none);
    runtime_sig.rt_at(runtime_sig.RT_ENTRY_COUNT);
    return 0;
}
