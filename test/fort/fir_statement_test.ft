//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| ok
/// Checks FIR statements: the four constructors, their locations and statement indices, and the
/// places a statement reads and writes.
import fir;
import fir_env;
import types;

fn copy(u32 n) fir.operand {
    return fir.operand_copy(fir.place_local(n));
}

fn an_assignment_holds_its_place_and_rvalue() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fir.func mut f = fir_env.func_of(&e, "add");
    defer fir.func_free(&f);
    fir.rvalue r = fir.rvalue_binary(&f, fir.rvalue_kind.rv_add, copy(1), copy(1));
    fir.statement s = fir.stmt_assign(fir.place_local(0), r, fir_env.at(3, 5), 7);
    assert(s.kind == fir.stmt_kind.st_assign);
    assert(s.place.local == 0);
    assert(s.value.kind == fir.rvalue_kind.rv_add);
    assert(s.loc.line == 3 && s.loc.col == 5);
    assert(s.stmt == 7);
}

fn a_del_holds_its_place() void {
    fir.statement s = fir.stmt_del(fir.place_local(4), fir_env.at(9, 1), 2);
    assert(s.kind == fir.stmt_kind.st_del);
    assert(s.place.local == 4);
    assert(s.loc.line == 9);
    assert(s.stmt == 2);
}

fn live_and_dead_hold_their_local() void {
    fir.statement live = fir.stmt_live(3, fir_env.at(2, 4), 1);
    assert(live.kind == fir.stmt_kind.st_live);
    assert(live.local == 3);
    assert(live.loc.line == 2 && live.loc.col == 4);
    assert(live.stmt == 1);
    fir.statement dead = fir.stmt_dead(3, fir_env.at(8, 1), 0);
    assert(dead.kind == fir.stmt_kind.st_dead);
    assert(dead.local == 3);
    // Index 0 is what the lowering emits outside the walk of the body.
    assert(dead.stmt == 0);
}

fn the_exit_location_is_empty_until_an_expansion_sets_it() void {
    fir.statement mut s = fir.stmt_del(fir.place_local(4), fir_env.at(9, 1), 2);
    assert(s.exit_loc.file.len == 0);
    assert(s.exit_loc.line == 0 && s.exit_loc.col == 0);
    assert(fir.stmt_live(1, fir_env.at(1, 1), 1).exit_loc.line == 0);
    assert(fir.stmt_dead(1, fir_env.at(1, 1), 1).exit_loc.line == 0);
    // A deferred copy carries the location of the exit that expanded it.
    s.exit_loc = fir_env.at(12, 9);
    assert(s.exit_loc.line == 12 && s.exit_loc.col == 9);
    assert(s.loc.line == 9);
}

fn an_assignment_writes_its_place_and_reads_its_operands() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fir.func mut f = fir_env.func_of(&e, "add");
    defer fir.func_free(&f);
    fir.place target = fir.place_local(0);
    fir.rvalue r = fir.rvalue_binary(&f, fir.rvalue_kind.rv_add, copy(1), copy(2));
    fir.statement s = fir.stmt_assign(target, r, fir_env.at(1, 1), 1);
    fir.place mut w = fir.place{};
    assert(fir.stmt_writes_place(&s, &w));
    assert(w.base == fir.base_kind.bk_local && w.local == 0);
    fir.operand mut o = fir.operand{};
    assert(fir.stmt_reads(&f, &s, 0, &o) && o.place.local == 1);
    assert(fir.stmt_reads(&f, &s, 1, &o) && o.place.local == 2);
    assert(!fir.stmt_reads(&f, &s, 2, &o));
    fir.place mut p = fir.place{};
    assert(fir.stmt_reads_place(&f, &s, 0, &p) && p.local == 1);
    assert(fir.stmt_reads_place(&f, &s, 1, &p) && p.local == 2);
    assert(!fir.stmt_reads_place(&f, &s, 2, &p));
}

fn a_constant_operand_is_read_but_names_no_place() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fir.func mut f = fir_env.func_of(&e, "add");
    defer fir.func_free(&f);
    fir.operand one = fir.operand_const(fir.const_bool(true));
    fir.operand two = fir.operand_move(fir.place_local(2));
    fir.rvalue r = fir.rvalue_binary(&f, fir.rvalue_kind.rv_eq, one, two);
    fir.statement s = fir.stmt_assign(fir.place_local(0), r, fir_env.at(1, 1), 1);
    fir.operand mut o = fir.operand{};
    assert(fir.stmt_reads(&f, &s, 0, &o) && o.kind == fir.operand_kind.ok_const);
    assert(fir.stmt_reads(&f, &s, 1, &o) && fir.operand_moves(o));
    fir.place mut p = fir.place{};
    assert(fir.stmt_reads_place(&f, &s, 0, &p) && p.local == 2);
    assert(!fir.stmt_reads_place(&f, &s, 1, &p));
}

fn a_call_through_a_value_reads_the_callee_first() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fir.func mut f = fir_env.func_of(&e, "add");
    defer fir.func_free(&f);
    u32 callee = fir.local_add(&f, fir_env.ty(&e, "add"), fir.local_kind.lk_temp, null,
                               fir_env.at(1, 1));
    u32 first = fir.operand_push(&f, copy(1));
    fir.operand_push(&f, copy(2));
    fir.rvalue r = fir.rvalue_call_value(copy(callee), first, 2);
    fir.statement s = fir.stmt_assign(fir.place_local(0), r, fir_env.at(1, 1), 1);
    fir.place mut p = fir.place{};
    assert(fir.stmt_reads_place(&f, &s, 0, &p) && p.local == callee);
    assert(fir.stmt_reads_place(&f, &s, 1, &p) && p.local == 1);
    assert(fir.stmt_reads_place(&f, &s, 2, &p) && p.local == 2);
    assert(!fir.stmt_reads_place(&f, &s, 3, &p));
    // An address names a place and reads none.
    fir.rvalue addr = fir.rvalue_addr(&f, fir.place_local(1), false);
    fir.statement a = fir.stmt_assign(fir.place_local(callee), addr, fir_env.at(1, 1), 2);
    fir.operand mut o = fir.operand{};
    assert(!fir.stmt_reads(&f, &a, 0, &o));
}

fn a_del_reads_and_writes_its_place() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fir.func mut f = fir_env.func_of(&e, "keep");
    defer fir.func_free(&f);
    fir.place held = fir.place_field(&f, fir.place_local(1), 0);
    fir.statement s = fir.stmt_del(held, fir_env.at(1, 1), 1);
    fir.place mut w = fir.place{};
    assert(fir.stmt_writes_place(&s, &w));
    assert(fir.place_compare(&f, w, held) == fir.place_rel.pc_equal);
    fir.operand mut o = fir.operand{};
    assert(fir.stmt_reads(&f, &s, 0, &o));
    assert(fir.operand_moves(o));
    assert(fir.place_compare(&f, o.place, held) == fir.place_rel.pc_equal);
    assert(!fir.stmt_reads(&f, &s, 1, &o));
    fir.place mut r = fir.place{};
    assert(fir.stmt_reads_place(&f, &s, 0, &r));
    assert(!fir.stmt_reads_place(&f, &s, 1, &r));
}

fn live_and_dead_read_and_write_nothing() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fir.func mut f = fir_env.func_of(&e, "add");
    defer fir.func_free(&f);
    fir.statement live = fir.stmt_live(1, fir_env.at(1, 1), 1);
    fir.statement dead = fir.stmt_dead(1, fir_env.at(1, 1), 1);
    fir.place mut p = fir.place{};
    fir.operand mut o = fir.operand{};
    assert(!fir.stmt_writes_place(&live, &p));
    assert(!fir.stmt_writes_place(&dead, &p));
    assert(!fir.stmt_reads(&f, &live, 0, &o));
    assert(!fir.stmt_reads(&f, &dead, 0, &o));
    assert(!fir.stmt_reads_place(&f, &live, 0, &p));
}

// The operands of an assignment of each rvalue form, in the order stmt_reads gives them.
fn reads_of(fir.func* f, fir.statement* s, u32 mut@ out) u32 {
    fir.operand mut o = fir.operand{};
    u32 mut n = 0;
    while (fir.stmt_reads(f, s, n, &o)) {
        assert(o.kind == fir.operand_kind.ok_copy);
        out[cast(n, u64)] = o.place.local;
        n += 1;
    }
    return n;
}

fn assign_of(fir.rvalue r) fir.statement {
    return fir.stmt_assign(fir.place_local(0), r, fir_env.at(1, 1), 1);
}

fn every_rvalue_form_reads_its_operands_in_order() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fir.func mut f = fir_env.func_of(&e, "add");
    defer fir.func_free(&f);
    types.table mut* tt = fir_env.tt(&e);
    u32 ptr = fir.local_add(&f, types.type_ptr(tt, fir_env.i32_ty(&e), false, false),
                            fir.local_kind.lk_temp, null, fir_env.at(1, 1));
    u32 arr = fir.local_add(&f, types.type_array(tt, fir_env.i32_ty(&e), 4),
                            fir.local_kind.lk_temp, null, fir_env.at(1, 1));
    u32 callee = fir.local_add(&f, fir_env.ty(&e, "add"), fir.local_kind.lk_temp, null,
                               fir_env.at(1, 1));
    u32[4] mut got = {};
    // use, a binary form and a unary form
    fir.statement use = assign_of(fir.rvalue_use(&f, copy(1)));
    assert(reads_of(&f, &use, got[..]) == 1 && got[0] == 1);
    fir.statement sub = assign_of(fir.rvalue_binary(&f, fir.rvalue_kind.rv_sub, copy(2), copy(1)));
    assert(reads_of(&f, &sub, got[..]) == 2 && got[0] == 2 && got[1] == 1);
    fir.statement not = assign_of(fir.rvalue_unary(&f, fir.rvalue_kind.rv_not, copy(1)));
    assert(reads_of(&f, &not, got[..]) == 1 && got[0] == 1);
    // cast and alloc read their one operand
    fir.statement conv = assign_of(fir.rvalue_cast(&f, fir_env.i64_ty(&e), copy(1)));
    assert(reads_of(&f, &conv, got[..]) == 1 && got[0] == 1);
    fir.statement alloc = assign_of(fir.rvalue_alloc(&f, fir_env.i32_ty(&e), copy(2)));
    assert(reads_of(&f, &alloc, got[..]) == 1 && got[0] == 2);
    // addr reads nothing; slice reads its two bounds; slice_ptr reads the pointer first
    fir.statement addr = assign_of(fir.rvalue_addr(&f, fir.place_local(arr), false));
    assert(reads_of(&f, &addr, got[..]) == 0);
    fir.rvalue sl = fir.rvalue_slice(&f, fir.place_local(arr), copy(2), copy(1), false);
    fir.statement slice = assign_of(sl);
    assert(reads_of(&f, &slice, got[..]) == 2 && got[0] == 2 && got[1] == 1);
    fir.statement sp = assign_of(fir.rvalue_slice_ptr(&f, copy(ptr), copy(1), copy(2)));
    assert(reads_of(&f, &sp, got[..]) == 3);
    assert(got[0] == ptr && got[1] == 1 && got[2] == 2);
    // an aggregate and the three calls read their operands in order
    u32 first = fir.operand_push(&f, copy(2));
    fir.operand_push(&f, copy(1));
    fir.statement agg = assign_of(fir.rvalue_aggregate_new(fir_env.ty(&e, "pair"), first, 2));
    assert(reads_of(&f, &agg, got[..]) == 2 && got[0] == 2 && got[1] == 1);
    fir.statement direct = assign_of(fir.rvalue_call_fn(fir_env.sym(&e, "add"), first, 2));
    assert(reads_of(&f, &direct, got[..]) == 2 && got[0] == 2 && got[1] == 1);
    fir.statement ext = assign_of(fir.rvalue_call_extern(fir_env.sym(&e, "abs"), first, 1));
    assert(reads_of(&f, &ext, got[..]) == 1 && got[0] == 2);
    fir.statement value = assign_of(fir.rvalue_call_value(copy(callee), first, 2));
    assert(reads_of(&f, &value, got[..]) == 3);
    assert(got[0] == callee && got[1] == 2 && got[2] == 1);
    // A call with no argument reads nothing, or only its callee.
    fir.statement bare = assign_of(fir.rvalue_call_fn(fir_env.sym(&e, "nothing"), first, 0));
    assert(reads_of(&f, &bare, got[..]) == 0);
    fir.statement bare_value = assign_of(fir.rvalue_call_value(copy(callee), first, 0));
    assert(reads_of(&f, &bare_value, got[..]) == 1 && got[0] == callee);
}

fn a_statement_reads_a_place_with_projections() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fir.func mut f = fir_env.func_of(&e, "keep");
    defer fir.func_free(&f);
    // `_0.1 = copy _1.1`: the write and the read are two fields of two locals.
    fir.place target = fir.place_field(&f, fir.place_local(0), 1);
    fir.place source = fir.place_field(&f, fir.place_local(1), 1);
    fir.rvalue r = fir.rvalue_use(&f, fir.operand_copy(source));
    fir.statement s = fir.stmt_assign(target, r, fir_env.at(1, 1), 1);
    fir.place mut w = fir.place{};
    assert(fir.stmt_writes_place(&s, &w));
    assert(fir.place_compare(&f, w, target) == fir.place_rel.pc_equal);
    fir.place mut read = fir.place{};
    assert(fir.stmt_reads_place(&f, &s, 0, &read));
    assert(fir.place_compare(&f, read, source) == fir.place_rel.pc_equal);
    assert(fir.place_compare(&f, read, w) == fir.place_rel.pc_disjoint);
    fir_env.expect(&e, fir.place_type(&f, read), "u64");
}

// ---- index locals -----------------------------------------------------------------------

// A function over `fn add(i32 x, i64 y) u64` with the locals the index cases name.
struct indexed {
    fir.func f;
    u32 a; // i32[4]
    u32 grid; // outer[2]; field 1 of outer is i32[4]
    u32 holders; // holder[2]; field 0 of holder is u8 mut* own
    u32 i; // u64
    u32 j; // u64
    u32 n; // u64
}

fn indexed_of(fir_env.env mut* e) indexed {
    indexed mut x = indexed{};
    x.f = fir_env.func_of(e, "add");
    types.table mut* tt = fir_env.tt(e);
    types.node* u64t = fir_env.u64_ty(e);
    x.a = temp(&x.f, types.type_array(tt, fir_env.i32_ty(e), 4));
    x.grid = temp(&x.f, types.type_array(tt, fir_env.ty(e, "outer"), 2));
    x.holders = temp(&x.f, types.type_array(tt, fir_env.ty(e, "holder"), 2));
    x.i = temp(&x.f, u64t);
    x.j = temp(&x.f, u64t);
    x.n = temp(&x.f, u64t);
    return x;
}

fn temp(fir.func mut* f, types.node* ty) u32 {
    return fir.local_add(f, ty, fir.local_kind.lk_temp, null, fir_env.at(1, 1));
}

// `_grid[_i].1[_j]`, a place with two index locals.
fn nested(indexed mut* x) fir.place {
    fir.place row = fir.place_index(&x->f, fir.place_local(x->grid), x->i);
    return fir.place_index(&x->f, fir.place_field(&x->f, row, 1), x->j);
}

// Whether read `k` of `s` is the local `n` with no projection.
fn reads_local(indexed* x, fir.statement* s, u32 k, u32 n) bool {
    fir.place mut p = fir.place{};
    return fir.stmt_reads_place(&x->f, s, k, &p) && p.base == fir.base_kind.bk_local
        && p.local == n && p.proj_len == 0;
}

// Whether read `k` of `s` equals `want`.
fn reads_place(indexed* x, fir.statement* s, u32 k, fir.place want) bool {
    fir.place mut p = fir.place{};
    return fir.stmt_reads_place(&x->f, s, k, &p)
        && fir.place_compare(&x->f, p, want) == fir.place_rel.pc_equal;
}

fn the_count_of_reads(indexed* x, fir.statement* s) u32 {
    fir.place mut p = fir.place{};
    u32 mut k = 0;
    while (fir.stmt_reads_place(&x->f, s, k, &p)) {
        k += 1;
    }
    return k;
}

fn a_destination_reads_its_index_local_first() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    indexed mut x = indexed_of(&e);
    defer fir.func_free(&x.f);
    // `_a[_i] = copy _1`: `_i` is read, then `_1`. `_a[_i]` is written and not read.
    fir.place target = fir.place_index(&x.f, fir.place_local(x.a), x.i);
    fir.statement s = fir.stmt_assign(target, fir.rvalue_use(&x.f, copy(1)), fir_env.at(1, 1), 1);
    assert(the_count_of_reads(&x, &s) == 2);
    assert(reads_local(&x, &s, 0, x.i));
    assert(reads_local(&x, &s, 1, 1));
    fir.place mut w = fir.place{};
    assert(fir.stmt_writes_place(&s, &w));
    assert(fir.place_compare(&x.f, w, target) == fir.place_rel.pc_equal);
}

fn an_operand_reads_its_index_local_before_its_place() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    indexed mut x = indexed_of(&e);
    defer fir.func_free(&x.f);
    // `_1 = copy _a[_i]`: `_i`, then `_a[_i]`.
    fir.place elem = fir.place_index(&x.f, fir.place_local(x.a), x.i);
    fir.rvalue r = fir.rvalue_use(&x.f, fir.operand_copy(elem));
    fir.statement s = fir.stmt_assign(fir.place_local(1), r, fir_env.at(1, 1), 1);
    assert(the_count_of_reads(&x, &s) == 2);
    assert(reads_local(&x, &s, 0, x.i));
    assert(reads_place(&x, &s, 1, elem));
    // `_1 = add(copy _a[_i], copy _a[_j])`: each operand brings its own index local.
    fir.place other = fir.place_index(&x.f, fir.place_local(x.a), x.j);
    fir.rvalue sum = fir.rvalue_binary(&x.f, fir.rvalue_kind.rv_add, fir.operand_copy(elem),
                                       fir.operand_copy(other));
    fir.statement t = fir.stmt_assign(fir.place_local(1), sum, fir_env.at(1, 1), 1);
    assert(the_count_of_reads(&x, &t) == 4);
    assert(reads_local(&x, &t, 0, x.i));
    assert(reads_place(&x, &t, 1, elem));
    assert(reads_local(&x, &t, 2, x.j));
    assert(reads_place(&x, &t, 3, other));
}

fn an_address_reads_its_index_local_and_not_its_place() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    indexed mut x = indexed_of(&e);
    defer fir.func_free(&x.f);
    // `_n = addr(_a[_i])`: `_i` only.
    fir.place elem = fir.place_index(&x.f, fir.place_local(x.a), x.i);
    fir.rvalue r = fir.rvalue_addr(&x.f, elem, false);
    fir.statement s = fir.stmt_assign(fir.place_local(x.n), r, fir_env.at(1, 1), 1);
    assert(the_count_of_reads(&x, &s) == 1);
    assert(reads_local(&x, &s, 0, x.i));
    // An address of a place with no index reads nothing.
    fir.rvalue whole = fir.rvalue_addr(&x.f, fir.place_local(x.a), false);
    fir.statement t = fir.stmt_assign(fir.place_local(x.n), whole, fir_env.at(1, 1), 1);
    assert(the_count_of_reads(&x, &t) == 0);
}

fn a_slice_reads_the_index_locals_of_its_place_then_its_bounds() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    indexed mut x = indexed_of(&e);
    defer fir.func_free(&x.f);
    // `_n = slice(_grid[_i].1, copy _j, copy _n)`: `_i`, `_j`, `_n`; not `_grid[_i].1`.
    fir.place row = fir.place_index(&x.f, fir.place_local(x.grid), x.i);
    fir.place cells = fir.place_field(&x.f, row, 1);
    fir.rvalue r = fir.rvalue_slice(&x.f, cells, copy(x.j), copy(x.n), false);
    fir.statement s = fir.stmt_assign(fir.place_local(x.n), r, fir_env.at(1, 1), 1);
    assert(the_count_of_reads(&x, &s) == 3);
    assert(reads_local(&x, &s, 0, x.i));
    assert(reads_local(&x, &s, 1, x.j));
    assert(reads_local(&x, &s, 2, x.n));
}

fn a_nested_place_reads_each_index_local_in_order() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    indexed mut x = indexed_of(&e);
    defer fir.func_free(&x.f);
    fir.place deep = nested(&x);
    fir_env.expect(&e, fir.place_type(&x.f, deep), "i32");
    // `_grid[_i].1[_j] = copy _grid[_i].1[_j]`: the destination gives `_i`, `_j`; the operand
    // gives `_i`, `_j` and its place.
    fir.rvalue r = fir.rvalue_use(&x.f, fir.operand_copy(deep));
    fir.statement s = fir.stmt_assign(deep, r, fir_env.at(1, 1), 1);
    assert(the_count_of_reads(&x, &s) == 5);
    assert(reads_local(&x, &s, 0, x.i));
    assert(reads_local(&x, &s, 1, x.j));
    assert(reads_local(&x, &s, 2, x.i));
    assert(reads_local(&x, &s, 3, x.j));
    assert(reads_place(&x, &s, 4, deep));
    // `addr` of the nested place reads its two index locals.
    fir.rvalue a = fir.rvalue_addr(&x.f, deep, true);
    fir.statement t = fir.stmt_assign(fir.place_local(x.n), a, fir_env.at(1, 1), 1);
    assert(the_count_of_reads(&x, &t) == 2);
    assert(reads_local(&x, &t, 0, x.i));
    assert(reads_local(&x, &t, 1, x.j));
}

fn a_del_reads_its_index_local_then_its_place() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    indexed mut x = indexed_of(&e);
    defer fir.func_free(&x.f);
    // `del(move _holders[_i].0)`: `_i`, then the place, which the move reads.
    fir.place row = fir.place_index(&x.f, fir.place_local(x.holders), x.i);
    fir.place held = fir.place_field(&x.f, row, 0);
    fir.statement s = fir.stmt_del(held, fir_env.at(1, 1), 1);
    assert(the_count_of_reads(&x, &s) == 2);
    assert(reads_local(&x, &s, 0, x.i));
    assert(reads_place(&x, &s, 1, held));
}

fn a_call_reads_the_index_locals_of_its_callee_and_arguments() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    indexed mut x = indexed_of(&e);
    defer fir.func_free(&x.f);
    // `_a[_n] = call (copy _fns[_i])(copy _a[_j])`, with `_fns` a `fn (i32, i64) u64[2]`.
    types.node* fns = types.type_array(fir_env.tt(&e), fir_env.ty(&e, "add"), 2);
    u32 table = temp(&x.f, fns);
    fir.place callee = fir.place_index(&x.f, fir.place_local(table), x.i);
    fir.place arg = fir.place_index(&x.f, fir.place_local(x.a), x.j);
    u32 first = fir.operand_push(&x.f, fir.operand_copy(arg));
    fir.rvalue r = fir.rvalue_call_value(fir.operand_copy(callee), first, 1);
    fir.place target = fir.place_index(&x.f, fir.place_local(x.a), x.n);
    fir.statement s = fir.stmt_assign(target, r, fir_env.at(1, 1), 1);
    assert(the_count_of_reads(&x, &s) == 5);
    assert(reads_local(&x, &s, 0, x.n));
    assert(reads_local(&x, &s, 1, x.i));
    assert(reads_place(&x, &s, 2, callee));
    assert(reads_local(&x, &s, 3, x.j));
    assert(reads_place(&x, &s, 4, arg));
}

fn main() i32 {
    an_assignment_holds_its_place_and_rvalue();
    a_del_holds_its_place();
    live_and_dead_hold_their_local();
    the_exit_location_is_empty_until_an_expansion_sets_it();
    an_assignment_writes_its_place_and_reads_its_operands();
    a_constant_operand_is_read_but_names_no_place();
    a_call_through_a_value_reads_the_callee_first();
    a_del_reads_and_writes_its_place();
    live_and_dead_read_and_write_nothing();
    every_rvalue_form_reads_its_operands_in_order();
    a_statement_reads_a_place_with_projections();
    a_destination_reads_its_index_local_first();
    an_operand_reads_its_index_local_before_its_place();
    an_address_reads_its_index_local_and_not_its_place();
    a_slice_reads_the_index_locals_of_its_place_then_its_bounds();
    a_nested_place_reads_each_index_local_in_order();
    a_del_reads_its_index_local_then_its_place();
    a_call_reads_the_index_locals_of_its_callee_and_arguments();
    println("ok");
    return 0;
}
