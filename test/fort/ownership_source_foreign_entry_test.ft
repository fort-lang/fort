//! run
//! flags: -I ../../src/fort
//! stdout:
//| 17 generated foreign entries
/// Tests the bodies that generated code calls without a fort caller.
import ast;
import fir;
import modules;
import ownership_source;

fn called(string module_path, bool entry, string name) bool {
    ast.sym mut symbol = ast.sym{.kind = ast.sym_kind.s_fn, .name = name};
    fir.func mut function = fir.func{.sym = &symbol};
    modules.module mut module_at = modules.module{.path = module_path, .entry = entry};
    ownership_source.body row = ownership_source.body{.module = &module_at,
        .function = move(function)};
    return ownership_source.generated_caller(&row);
}

fn main() i32 {
    u64 mut count = 0;
    if (called("main", true, "main")) { count += 1; }
    // Generated code calls `alloc` for `new` and `free` for `del` (fir_llvm.ft). FIR holds no
    // call site for either.
    string[16] runtime = {"args_init", "args", "shutdown", "alloc", "free", "fail_bounds",
        "fail_span", "fail_overflow", "fail_shift", "fail_div_zero", "fail_div_overflow",
        "fail_alloc_count", "fail_overwrite", "fail_enum", "panic", "assert_fail"};
    for (string name : runtime) {
        if (called("std.rt", false, name)) { count += 1; }
    }
    assert(count == 17);
    assert(!called("other", false, "main"));
    assert(!called("main", true, "helper"));
    // Only fort code calls `exit` and `flush_all`. FIR lowers a print and a string comparison
    // to fort calls, so the graph sees each caller. A body of another module has no exemption.
    string[6] fort_called = {"exit", "print_i64", "print_str", "str_eq", "flush_all", "main"};
    for (string name : fort_called) { assert(!called("std.rt", false, name)); }
    assert(!called("std.rt", true, "helper"));
    assert(!called("other", false, "alloc"));
    assert(!called("other", true, "free"));
    assert(!called("main", true, "args_init"));
    println(count, " generated foreign entries");
    return 0;
}
