//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: fir_llvm.constant_value: a string constant has no value
//! stdout:
//| 1
/// A string constant is an aggregate that hold writes into its place. constant_value on a
/// string constant breaks that precondition, so the call panics.
import fort.consts;
import fort.fir;
import fort.fir_llvm;
import llvm_env;
import fort.types;

string[6] PRELUDE = {
    "struct pair {",
    "    i32 a;",
    "    i32 b;",
    "}",
    "fn take(pair p) i32 {",
    "    return p.a;\n}",
};

string[8] TEXT = {
    "fn main.f() -> i32 {",
    "    let _1: pair;",
    "",
    "    bb0: {",
    "        _0 = call fn main.take(const zero pair) #1:1 s1;",
    "        return #1:1 s1;",
    "    }",
    "}",
};

// Returns the type of local `n` of `f`. The read through `f` stands in a function that takes it
// as a parameter (D17.21).
fn local_type(fir.func* f, u32 n) types.node* {
    return fir.local_at(f, n)->ty;
}

// A panic ends the program, so the case stands in a file of its own.
fn main() i32 {
    llvm_env.env mut e = llvm_env.env{};
    llvm_env.open(&e);
    defer llvm_env.close(&e);
    fir.module mut m = llvm_env.parse(&e, PRELUDE[..], TEXT[..]);
    defer fir.module_free(&m);
    fir.func* f = fir.module_function_at(&m, 0);
    llvm_env.begin(&e.g);
    fir_llvm.translator mut t = fir_llvm.open(&e.g, f);
    defer fir_llvm.close(&t);
    types.node* i32t = local_type(f, 0);
    types.node* pairt = local_type(f, 1);
    println(fir_llvm.constant_value(&t, fir.const_int(i32t, consts.cv_from_i64(1))).val);
    fir_llvm.constant_value(&t, fir.constant{.kind = fir.const_kind.ck_string, .text = "x"});
    return 0;
}
