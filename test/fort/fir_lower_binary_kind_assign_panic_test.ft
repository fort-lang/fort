//! run
//! flags: -I ../../src
//! abort
//! stderr: panic: fir_lower.binary_kind: not a binary operator
//! stdout:
//| true
/// lower_binary passes the operator of a binary node, and `=` is a statement and no binary
/// operator. binary_kind on `=` breaks that precondition, so the call panics.
import fort.fir;
import fort.fir_lower;
import fort.lexer;

fn main() i32 {
    println(fir_lower.binary_kind(lexer.tok_kind.plus, false) == fir.rvalue_kind.rv_add);
    fir_lower.binary_kind(lexer.tok_kind.assign, false);
    return 0;
}
