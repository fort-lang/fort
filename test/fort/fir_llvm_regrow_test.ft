//! run
//! flags: -I ../../src -I support
//! stdout:
//| entries ok
//| counts ok
//| owners ok
//| places ok
//| text ok
/// Checks the text that the FIR translator writes for the rvalue `regrow` (D12.2, spec/fir.md
/// 12.2): the call of `std.rt.regrow` with the pointer and the length of the old span, the element
/// size, the count and the sign of its type; the call of `std.rt.regrow_move` with the bytes of
/// the two spans and the offsets of the owner words; the call of `std.rt.free`; and the zero value
/// that the place of the operand takes when it is no temporary.
import fort.fir;
import fort.fir_lower;
import llvm_env;
import lower_env;
import pass_env;
import std.str;

string[43] SOURCE = {
    "struct two {",
    "    i32 mut* own a;",
    "    i32 tag;",
    "    i32 mut* own b;",
    "}",
    "struct vec {",
    "    u8 mut@ own items;",
    "    u64 len;",
    "}",
    "u8 mut@ own mut table = {};",
    "fn make() u8 mut@ own {",
    "    return new(u8, 2);",
    "}",
    "fn plain(i32 mut@ own s, u64 n) i32 mut@ own {",
    "    return regrow(move(s), n);",
    "}",
    "fn signed(i32 mut@ own s, i32 n) i32 mut@ own {",
    "    return regrow(move(s), n);",
    "}",
    "fn small(i32 mut@ own s, u8 n) i32 mut@ own {",
    "    return regrow(move(s), n);",
    "}",
    "fn owners(two mut@ own s, u64 n) two mut@ own {",
    "    return regrow(move(s), n);",
    "}",
    "fn pointers(i32 mut* own mut@ own s, u64 n) i32 mut* own mut@ own {",
    "    return regrow(move(s), n);",
    "}",
    "fn rvalue(u64 n) u8 mut@ own {",
    "    return regrow(make(), n);",
    "}",
    "fn field(vec mut* v, u64 n) void {",
    "    v->items = regrow(move(v->items), n);",
    "}",
    "fn global(u64 n) void {",
    "    table = regrow(move(table), n);",
    "}",
    "fn constant(u8 mut@ own s) u8 mut@ own {",
    "    return regrow(move(s), 16);",
    "}",
    "fn main() i32 {",
    "    return 0;",
    "}",
};

// The lowering moves the span into a temporary first, so a `regrow` of fort source reads a
// temporary. These two functions give `regrow` a parameter and a local directly.
string[20] NAMED = {
    "fn main.named(_1 (s): u8 mut@ own, _2 (n): i64) -> u8 mut@ own {",
    "    let _3: u8 mut* own;",
    "    bb0: {",
    "        _3 = regrow<u8>(move _1, copy _2) #9:1;",
    "        _0 = aggregate u8 mut@ own(move _3, copy _2) #10:1;",
    "        return #12:1;",
    "    }",
    "}",
    "fn main.local() -> void {",
    "    let _1 (s): u8 mut@ own;",
    "    let _2: u8 mut* own;",
    "    let _3 (t): u8 mut@ own;",
    "    bb0: {",
    "        _1 = const zero u8 mut@ own #2:1;",
    "        _2 = regrow<u8>(move _1, const u64 4) #9:1;",
    "        _3 = aggregate u8 mut@ own(move _2, const u64 4) #10:1;",
    "        del(move _3) #11:3;",
    "        return #12:1;",
    "    }",
    "}",
};

// ---- entries ------------------------------------------------------------------------------------

// The whole text of a `regrow` of a span of `i32` with a count of the type `u64`. No block starts
// in it: the entry `std.rt.regrow` makes each test (D19.6). The products `%t6` and `%t7` are the
// byte lengths of the old span and of the new one. The element type has no owner, so the span of
// offsets is the zero span.
fn a_regrow_calls_three_entries_in_order() void {
    llvm_env.env mut* own e = llvm_env.make();
    defer llvm_env.drop_made(move(e));
    string[40] plain = {
        "entry:",
        "  %n.1 = alloca i64, align 8",
        "  %tmp0 = alloca %fort.span, align 8",
        "  %tmp1 = alloca %fort.span, align 8",
        "  %tmp2 = alloca %fort.span, align 8",
        "  %tmp3 = alloca %fort.span, align 8",
        "  %tmp4 = alloca %fort.span, align 8",
        "  store i64 %n.in, ptr %n.1, align 8",
        "  call void @llvm.memmove.p0.p0.i64(ptr align 8 %tmp1, ptr align 8 %s.in, i64 16, i1 \\",
        "false)",
        "  call void @llvm.memset.p0.i64(ptr align 8 %s.in, i8 0, i64 16, i1 false)",
        "  call void @llvm.memmove.p0.p0.i64(ptr align 8 %tmp0, ptr align 8 %tmp1, i64 16, i1 \\",
        "false)",
        "  %t0 = load i64, ptr %n.1, align 8",
        "  %t1 = getelementptr inbounds %fort.span, ptr %tmp0, i32 0, i32 0",
        "  %t2 = load ptr, ptr %t1, align 8",
        "  %t3 = getelementptr inbounds %fort.span, ptr %tmp0, i32 0, i32 1",
        "  %t4 = load i64, ptr %t3, align 8",
        "  %t5 = call ptr @\"std.rt.regrow\"(ptr %t2, i64 %t4, i64 4, i64 %t0, i1 zeroext \\",
        "false, ptr @.file.0, i32 15, i32 12)",
        "  %t6 = mul i64 %t4, 4",
        "  %t7 = mul i64 %t0, 4",
        "  %t8 = getelementptr inbounds %fort.span, ptr %tmp2, i32 0, i32 0",
        "  store ptr %t5, ptr %t8, align 8",
        "  %t9 = getelementptr inbounds %fort.span, ptr %tmp2, i32 0, i32 1",
        "  store i64 %t7, ptr %t9, align 8",
        "  %t10 = getelementptr inbounds %fort.span, ptr %tmp3, i32 0, i32 0",
        "  store ptr %t2, ptr %t10, align 8",
        "  %t11 = getelementptr inbounds %fort.span, ptr %tmp3, i32 0, i32 1",
        "  store i64 %t6, ptr %t11, align 8",
        "  %t12 = getelementptr inbounds %fort.span, ptr %tmp4, i32 0, i32 0",
        "  store ptr null, ptr %t12, align 8",
        "  %t13 = getelementptr inbounds %fort.span, ptr %tmp4, i32 0, i32 1",
        "  store i64 0, ptr %t13, align 8",
        "  call void @\"std.rt.regrow_move\"(ptr %tmp2, ptr %tmp3, i64 4, ptr %tmp4)",
        "  call void @\"std.rt.free\"(ptr %t2)",
        "  %t14 = getelementptr inbounds %fort.span, ptr %ret.sret, i32 0, i32 0",
        "  store ptr %t5, ptr %t14, align 8",
        "  %t15 = getelementptr inbounds %fort.span, ptr %ret.sret, i32 0, i32 1",
        "  store i64 %t0, ptr %t15, align 8",
    };
    llvm_env.expect(e, llvm_env.lowered(e, SOURCE[..], "plain", pass_env.CHECKED), plain[..]);
    string whole = llvm_env.lowered_whole(e, SOURCE[..], "plain", pass_env.CHECKED);
    llvm_env.verified(e, whole);
    // A release build makes the same tests: the text is the same.
    llvm_env.expect(e, llvm_env.lowered(e, SOURCE[..], "plain", pass_env.RELEASE), plain[..]);
    string fast = llvm_env.lowered_whole(e, SOURCE[..], "plain", pass_env.RELEASE);
    llvm_env.verified(e, fast);
}

// ---- counts -------------------------------------------------------------------------------------

// The count goes to the entry as 64 bits and the bit after it says that its type is signed. A
// signed count is sign-extended, so the entry sees a negative count; an unsigned count is
// zero-extended.
fn the_count_carries_the_sign_of_its_type() void {
    llvm_env.env mut* own e = llvm_env.make();
    defer llvm_env.drop_made(move(e));
    string[7] signed = {
        "  %t1 = sext i32 %t0 to i64",
        "  %t2 = getelementptr inbounds %fort.span, ptr %tmp0, i32 0, i32 0",
        "  %t3 = load ptr, ptr %t2, align 8",
        "  %t4 = getelementptr inbounds %fort.span, ptr %tmp0, i32 0, i32 1",
        "  %t5 = load i64, ptr %t4, align 8",
        "  %t6 = call ptr @\"std.rt.regrow\"(ptr %t3, i64 %t5, i64 4, i64 %t1, i1 zeroext \\",
        "true, ptr @.file.0, i32 18, i32 12)",
    };
    string got = llvm_env.lowered_whole(e, SOURCE[..], "signed", pass_env.CHECKED);
    llvm_env.verified(e, got);
    llvm_env.contains(e, got, signed[..]);
    string[7] small = {
        "  %t1 = zext i8 %t0 to i64",
        "  %t2 = getelementptr inbounds %fort.span, ptr %tmp0, i32 0, i32 0",
        "  %t3 = load ptr, ptr %t2, align 8",
        "  %t4 = getelementptr inbounds %fort.span, ptr %tmp0, i32 0, i32 1",
        "  %t5 = load i64, ptr %t4, align 8",
        "  %t6 = call ptr @\"std.rt.regrow\"(ptr %t3, i64 %t5, i64 4, i64 %t1, i1 zeroext \\",
        "false, ptr @.file.0, i32 21, i32 12)",
    };
    string narrow = llvm_env.lowered_whole(e, SOURCE[..], "small", pass_env.CHECKED);
    llvm_env.verified(e, narrow);
    llvm_env.contains(e, narrow, small[..]);
    // An integer constant has the type i32, which is signed.
    string[7] constant = {
        "  %t0 = sext i32 16 to i64",
        "  %t1 = getelementptr inbounds %fort.span, ptr %tmp0, i32 0, i32 0",
        "  %t2 = load ptr, ptr %t1, align 8",
        "  %t3 = getelementptr inbounds %fort.span, ptr %tmp0, i32 0, i32 1",
        "  %t4 = load i64, ptr %t3, align 8",
        "  %t5 = call ptr @\"std.rt.regrow\"(ptr %t2, i64 %t4, i64 1, i64 %t0, i1 zeroext \\",
        "true, ptr @.file.0, i32 39, i32 12)",
    };
    string fixed = llvm_env.lowered_whole(e, SOURCE[..], "constant", pass_env.CHECKED);
    llvm_env.verified(e, fixed);
    llvm_env.contains(e, fixed, constant[..]);
}

// ---- owners -------------------------------------------------------------------------------------

// Lowers the function `name` of the source that `e` checked last, in the checked mode, as
// llvm_env.lower_made does. It does not make the emitter fresh, so the emitter keeps its data.
fn lowered_more(llvm_env.env mut* e, string name) fir.func mut* own {
    fir.func mut* own f = new(fir.func);
    fir_lower.report mut why = fir_lower.report{};
    if (!fir_lower.lower_function(&e->low.c.ck, lower_env.decl(&e->low, name), f, &why)) {
        panic("fir_llvm_regrow_test: the lowering refuses the function");
    }
    pass_env.build(&e->low, f, pass_env.CHECKED);
    return f;
}

// Holds that `needle` starts at exactly `want` places of `text`.
fn expect_count(string text, string needle, u64 want) void {
    if (count_of(text, needle) == want) {
        return;
    }
    eprintln("fir_llvm_regrow_test: the count of '", needle, "' is not ", want, " in");
    eprint(text);
    panic("fir_llvm_regrow_test: a count differs");
}

// The count of the places in `text` where `needle` starts.
fn count_of(string text, string needle) u64 {
    u64 mut n = 0;
    u64 mut from = 0;
    while (from + needle.len <= text.len) {
        i64 at = str.find(text[from..], needle);
        if (at < 0) {
            return n;
        }
        n += 1;
        from += cast(at, u64) + needle.len;
    }
    return n;
}

// The struct `two` has an owner at byte 0 and at byte 16 and is 24 bytes. The two offsets are the
// private constant `@.words.0` of the module, and `std.rt.regrow_move` takes its span. The
// function stores no offset: its 5 stores of an `i64` are the parameter `n`, the two byte lengths,
// the count of the offsets and the length of the result. A span of owning pointers has one owner
// word at offset 0 in each element of 8 bytes, which is a second table. A second `regrow` of `two`
// gets its own constant, `@.words.2`, with the text of the first: a counter of the module counts
// the sites in the order of first use and joins no two constants by content (D19.5). So the
// module holds 3 constants for 3 sites of 2 tables.
fn each_site_has_a_constant_of_the_offsets() void {
    llvm_env.env mut* own e = llvm_env.make();
    defer llvm_env.drop_made(move(e));
    string[5] table = {
        "  %t12 = getelementptr inbounds %fort.span, ptr %tmp4, i32 0, i32 0",
        "  store ptr @.words.0, ptr %t12, align 8",
        "  %t13 = getelementptr inbounds %fort.span, ptr %tmp4, i32 0, i32 1",
        "  store i64 2, ptr %t13, align 8",
        "  call void @\"std.rt.regrow_move\"(ptr %tmp2, ptr %tmp3, i64 24, ptr %tmp4)",
    };
    fir.func mut* own first = llvm_env.lower_made(e, SOURCE[..], "owners", pass_env.CHECKED);
    defer fir.func_drop_made(move(first));
    string got = llvm_env.whole(e, first);
    llvm_env.verified(e, got);
    llvm_env.contains(e, got, table[..]);
    string[4] sizes = {
        "  %t5 = call ptr @\"std.rt.regrow\"(ptr %t2, i64 %t4, i64 24, i64 %t0, i1 zeroext \\",
        "false, ptr @.file.0, i32 24, i32 12)",
        "  %t6 = mul i64 %t4, 24",
        "  %t7 = mul i64 %t0, 24",
    };
    llvm_env.contains(e, got, sizes[..]);
    expect_count(got, "  store i64 ", 5);
    expect_count(got, "  store i64 16,", 0);
    expect_count(got, "[2 x i64]", 0);
    string[5] one = {
        "  %t12 = getelementptr inbounds %fort.span, ptr %tmp4, i32 0, i32 0",
        "  store ptr @.words.1, ptr %t12, align 8",
        "  %t13 = getelementptr inbounds %fort.span, ptr %tmp4, i32 0, i32 1",
        "  store i64 1, ptr %t13, align 8",
        "  call void @\"std.rt.regrow_move\"(ptr %tmp2, ptr %tmp3, i64 8, ptr %tmp4)",
    };
    fir.func mut* own second = lowered_more(e, "pointers");
    defer fir.func_drop_made(move(second));
    string pointers = llvm_env.whole(e, second);
    llvm_env.verified(e, pointers);
    llvm_env.contains(e, pointers, one[..]);
    expect_count(pointers, "  store i64 ", 5);
    string[5] third = {
        "  %t12 = getelementptr inbounds %fort.span, ptr %tmp4, i32 0, i32 0",
        "  store ptr @.words.2, ptr %t12, align 8",
        "  %t13 = getelementptr inbounds %fort.span, ptr %tmp4, i32 0, i32 1",
        "  store i64 2, ptr %t13, align 8",
        "  call void @\"std.rt.regrow_move\"(ptr %tmp2, ptr %tmp3, i64 24, ptr %tmp4)",
    };
    string again = llvm_env.whole(e, first);
    llvm_env.contains(e, again, third[..]);
    expect_count(again, "@.words.0", 0);
    string[3] data = {
        "@.words.0 = private unnamed_addr constant [2 x i64] [i64 0, i64 16], align 8",
        "@.words.1 = private unnamed_addr constant [1 x i64] [i64 0], align 8",
        "@.words.2 = private unnamed_addr constant [2 x i64] [i64 0, i64 16], align 8",
    };
    string tail = llvm_env.module_tail(e);
    llvm_env.contains(e, tail, data[..]);
    expect_count(tail, "@.words.", 3);
}

// A type with no owner word gives the span of null and 0, and the module holds no table.
fn a_type_with_no_owner_has_no_table() void {
    llvm_env.env mut* own e = llvm_env.make();
    defer llvm_env.drop_made(move(e));
    string[2] none = {
        "  store ptr null, ptr %t12, align 8",
        "  %t13 = getelementptr inbounds %fort.span, ptr %tmp4, i32 0, i32 1",
    };
    string got = llvm_env.lowered_whole(e, SOURCE[..], "plain", pass_env.CHECKED);
    llvm_env.contains(e, got, none[..]);
    expect_count(llvm_env.module_tail(e), "@.words.", 0);
}

// ---- places -------------------------------------------------------------------------------------

// The operand of a `regrow` of fort source is a temporary, so no zero value follows the call of
// `std.rt.free`: the `move` that fills the temporary empties the place before the `regrow`.
fn the_move_before_the_regrow_empties_the_place() void {
    llvm_env.env mut* own e = llvm_env.make();
    defer llvm_env.drop_made(move(e));
    string[4] field = {
        "  call void @llvm.memmove.p0.p0.i64(ptr align 8 %tmp1, ptr align 8 %t3, i64 16, i1 false)",
        "  call void @llvm.memset.p0.i64(ptr align 8 %t3, i8 0, i64 16, i1 false)",
        "  call void @llvm.memmove.p0.p0.i64(ptr align 8 %tmp0, ptr align 8 %tmp1, i64 16, i1 \\",
        "false)",
    };
    string got = llvm_env.lowered_whole(e, SOURCE[..], "field", pass_env.CHECKED);
    llvm_env.verified(e, got);
    llvm_env.contains(e, got, field[..]);
    string[5] after = {
        "  call void @\"std.rt.free\"(ptr %t6)",
        "  %t18 = getelementptr inbounds %fort.span, ptr %t1, i32 0, i32 0",
        "  store ptr %t9, ptr %t18, align 8",
        "  %t19 = getelementptr inbounds %fort.span, ptr %t1, i32 0, i32 1",
        "  store i64 %t4, ptr %t19, align 8",
    };
    llvm_env.contains(e, got, after[..]);
    string[3] emptied = {
        "  call void @llvm.memmove.p0.p0.i64(ptr align 8 %tmp1, ptr align 8 @\"main.table\", \\",
        "i64 16, i1 false)",
        "  call void @llvm.memset.p0.i64(ptr align 8 @\"main.table\", i8 0, i64 16, i1 false)",
    };
    string module = llvm_env.lowered_whole(e, SOURCE[..], "global", pass_env.CHECKED);
    llvm_env.verified(e, module);
    llvm_env.contains(e, module, emptied[..]);
    string[5] stored = {
        "  call void @\"std.rt.free\"(ptr %t2)",
        "  %t14 = getelementptr inbounds %fort.span, ptr @\"main.table\", i32 0, i32 0",
        "  store ptr %t5, ptr %t14, align 8",
        "  %t15 = getelementptr inbounds %fort.span, ptr @\"main.table\", i32 0, i32 1",
        "  store i64 %t0, ptr %t15, align 8",
    };
    llvm_env.contains(e, module, stored[..]);
    // An rvalue operand has no place to empty: the result of the call is the temporary.
    string[35] rvalue = {
        "entry:",
        "  %n.0 = alloca i64, align 8",
        "  %tmp0 = alloca %fort.span, align 8",
        "  %tmp1 = alloca %fort.span, align 8",
        "  %tmp2 = alloca %fort.span, align 8",
        "  %tmp3 = alloca %fort.span, align 8",
        "  store i64 %n.in, ptr %n.0, align 8",
        "  call void @\"main.make\"(ptr sret(%fort.span) %tmp0)",
        "  %t0 = load i64, ptr %n.0, align 8",
        "  %t1 = getelementptr inbounds %fort.span, ptr %tmp0, i32 0, i32 0",
        "  %t2 = load ptr, ptr %t1, align 8",
        "  %t3 = getelementptr inbounds %fort.span, ptr %tmp0, i32 0, i32 1",
        "  %t4 = load i64, ptr %t3, align 8",
        "  %t5 = call ptr @\"std.rt.regrow\"(ptr %t2, i64 %t4, i64 1, i64 %t0, i1 zeroext \\",
        "false, ptr @.file.0, i32 30, i32 12)",
        "  %t6 = mul i64 %t4, 1",
        "  %t7 = mul i64 %t0, 1",
        "  %t8 = getelementptr inbounds %fort.span, ptr %tmp1, i32 0, i32 0",
        "  store ptr %t5, ptr %t8, align 8",
        "  %t9 = getelementptr inbounds %fort.span, ptr %tmp1, i32 0, i32 1",
        "  store i64 %t7, ptr %t9, align 8",
        "  %t10 = getelementptr inbounds %fort.span, ptr %tmp2, i32 0, i32 0",
        "  store ptr %t2, ptr %t10, align 8",
        "  %t11 = getelementptr inbounds %fort.span, ptr %tmp2, i32 0, i32 1",
        "  store i64 %t6, ptr %t11, align 8",
        "  %t12 = getelementptr inbounds %fort.span, ptr %tmp3, i32 0, i32 0",
        "  store ptr null, ptr %t12, align 8",
        "  %t13 = getelementptr inbounds %fort.span, ptr %tmp3, i32 0, i32 1",
        "  store i64 0, ptr %t13, align 8",
        "  call void @\"std.rt.regrow_move\"(ptr %tmp1, ptr %tmp2, i64 1, ptr %tmp3)",
        "  call void @\"std.rt.free\"(ptr %t2)",
        "  %t14 = getelementptr inbounds %fort.span, ptr %ret.sret, i32 0, i32 0",
        "  store ptr %t5, ptr %t14, align 8",
        "  %t15 = getelementptr inbounds %fort.span, ptr %ret.sret, i32 0, i32 1",
        "  store i64 %t0, ptr %t15, align 8",
    };
    llvm_env.expect(e, llvm_env.lowered(e, SOURCE[..], "rvalue", pass_env.CHECKED), rvalue[..]);
}

// ---- text ---------------------------------------------------------------------------------------

// A `regrow` that reads a parameter or a local directly stores the zero value into that place
// after the release, as a `move` does. A constant count goes to the entry as it is.
fn a_place_that_is_no_temporary_takes_the_zero_value() void {
    llvm_env.env mut* own e = llvm_env.make();
    defer llvm_env.drop_made(move(e));
    string[1] prelude = {"i32 UNUSED = 0;"};
    fir.module mut* own m = fir.module_make();
    *m = llvm_env.parse(e, prelude[..], NAMED[..]);
    defer fir.module_drop_made(move(m));
    string[35] named = {
        "entry:",
        "  %n.1 = alloca i64, align 8",
        "  %tmp0 = alloca %fort.span, align 8",
        "  %tmp1 = alloca %fort.span, align 8",
        "  %tmp2 = alloca %fort.span, align 8",
        "  store i64 %n.in, ptr %n.1, align 8",
        "  %t0 = getelementptr inbounds %fort.span, ptr %s.in, i32 0, i32 0",
        "  %t1 = load ptr, ptr %t0, align 8",
        "  %t2 = getelementptr inbounds %fort.span, ptr %s.in, i32 0, i32 1",
        "  %t3 = load i64, ptr %t2, align 8",
        "  %t4 = load i64, ptr %n.1, align 8",
        "  %t5 = call ptr @\"std.rt.regrow\"(ptr %t1, i64 %t3, i64 1, i64 %t4, i1 zeroext \\",
        "true, ptr @.file.0, i32 9, i32 1)",
        "  %t6 = mul i64 %t3, 1",
        "  %t7 = mul i64 %t4, 1",
        "  %t8 = getelementptr inbounds %fort.span, ptr %tmp0, i32 0, i32 0",
        "  store ptr %t5, ptr %t8, align 8",
        "  %t9 = getelementptr inbounds %fort.span, ptr %tmp0, i32 0, i32 1",
        "  store i64 %t7, ptr %t9, align 8",
        "  %t10 = getelementptr inbounds %fort.span, ptr %tmp1, i32 0, i32 0",
        "  store ptr %t1, ptr %t10, align 8",
        "  %t11 = getelementptr inbounds %fort.span, ptr %tmp1, i32 0, i32 1",
        "  store i64 %t6, ptr %t11, align 8",
        "  %t12 = getelementptr inbounds %fort.span, ptr %tmp2, i32 0, i32 0",
        "  store ptr null, ptr %t12, align 8",
        "  %t13 = getelementptr inbounds %fort.span, ptr %tmp2, i32 0, i32 1",
        "  store i64 0, ptr %t13, align 8",
        "  call void @\"std.rt.regrow_move\"(ptr %tmp0, ptr %tmp1, i64 1, ptr %tmp2)",
        "  call void @\"std.rt.free\"(ptr %t1)",
        "  call void @llvm.memset.p0.i64(ptr align 8 %s.in, i8 0, i64 16, i1 false)",
        "  %t14 = load i64, ptr %n.1, align 8",
        "  %t15 = getelementptr inbounds %fort.span, ptr %ret.sret, i32 0, i32 0",
        "  store ptr %t5, ptr %t15, align 8",
        "  %t16 = getelementptr inbounds %fort.span, ptr %ret.sret, i32 0, i32 1",
        "  store i64 %t14, ptr %t16, align 8",
    };
    llvm_env.expect(e, llvm_env.translate(e, fir.module_function_at(m, 0)), named[..]);
    string[38] local = {
        "entry:",
        "  %s.0 = alloca %fort.span, align 8",
        "  %t.2 = alloca %fort.span, align 8",
        "  %tmp0 = alloca %fort.span, align 8",
        "  %tmp1 = alloca %fort.span, align 8",
        "  %tmp2 = alloca %fort.span, align 8",
        "  call void @llvm.memset.p0.i64(ptr align 8 %s.0, i8 0, i64 16, i1 false)",
        "  %t0 = getelementptr inbounds %fort.span, ptr %s.0, i32 0, i32 0",
        "  %t1 = load ptr, ptr %t0, align 8",
        "  %t2 = getelementptr inbounds %fort.span, ptr %s.0, i32 0, i32 1",
        "  %t3 = load i64, ptr %t2, align 8",
        "  %t4 = call ptr @\"std.rt.regrow\"(ptr %t1, i64 %t3, i64 1, i64 4, i1 zeroext false, \\",
        "ptr @.file.0, i32 9, i32 1)",
        "  %t5 = mul i64 %t3, 1",
        "  %t6 = mul i64 4, 1",
        "  %t7 = getelementptr inbounds %fort.span, ptr %tmp0, i32 0, i32 0",
        "  store ptr %t4, ptr %t7, align 8",
        "  %t8 = getelementptr inbounds %fort.span, ptr %tmp0, i32 0, i32 1",
        "  store i64 %t6, ptr %t8, align 8",
        "  %t9 = getelementptr inbounds %fort.span, ptr %tmp1, i32 0, i32 0",
        "  store ptr %t1, ptr %t9, align 8",
        "  %t10 = getelementptr inbounds %fort.span, ptr %tmp1, i32 0, i32 1",
        "  store i64 %t5, ptr %t10, align 8",
        "  %t11 = getelementptr inbounds %fort.span, ptr %tmp2, i32 0, i32 0",
        "  store ptr null, ptr %t11, align 8",
        "  %t12 = getelementptr inbounds %fort.span, ptr %tmp2, i32 0, i32 1",
        "  store i64 0, ptr %t12, align 8",
        "  call void @\"std.rt.regrow_move\"(ptr %tmp0, ptr %tmp1, i64 1, ptr %tmp2)",
        "  call void @\"std.rt.free\"(ptr %t1)",
        "  call void @llvm.memset.p0.i64(ptr align 8 %s.0, i8 0, i64 16, i1 false)",
        "  %t13 = getelementptr inbounds %fort.span, ptr %t.2, i32 0, i32 0",
        "  store ptr %t4, ptr %t13, align 8",
        "  %t14 = getelementptr inbounds %fort.span, ptr %t.2, i32 0, i32 1",
        "  store i64 4, ptr %t14, align 8",
        "  %t15 = getelementptr inbounds %fort.span, ptr %t.2, i32 0, i32 0",
        "  %t16 = load ptr, ptr %t15, align 8",
        "  call void @\"std.rt.free\"(ptr %t16)",
        "  call void @llvm.memset.p0.i64(ptr align 8 %t.2, i8 0, i64 16, i1 false)",
    };
    llvm_env.expect(e, llvm_env.translate(e, fir.module_function_at(m, 1)), local[..]);
}

fn main() i32 {
    a_regrow_calls_three_entries_in_order();
    println("entries ok");
    the_count_carries_the_sign_of_its_type();
    println("counts ok");
    each_site_has_a_constant_of_the_offsets();
    a_type_with_no_owner_has_no_table();
    println("owners ok");
    the_move_before_the_regrow_empties_the_place();
    println("places ok");
    a_place_that_is_no_temporary_takes_the_zero_value();
    println("text ok");
    return 0;
}
