//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| deferred fail tests ok
//| totals ok
/// Holds the stored-run outcome of the deferred ownership fail tests whose local outcome
/// `ownership_source_local_programs_test.ft` holds. Each program keeps its file lines. The
/// stored row has every local step, so it meets each event that the local row validates, and
/// it reports none of them again: one diagnostic for each event (toolchain 1.1). No program
/// here has a stored-borrow event of its own.
import ownership_api;
import ownership_report;
import ownership_source;
import ownership_source_env;
import ownership_source_local;
import std.strbuf;

// The number of bodies in each class, counted as they are checked.
struct counts {
    u64 excluded;
    u64 declared;
    u64 outside;
    u64 proved;
}

fn analyze(ownership_source_env.env mut* e, strbuf.str_buf mut* text, string@ lines) void {
    u64 mut i = 0;
    while (i < lines.len) {
        strbuf.append(text, lines[i]);
        strbuf.push(text, '\n');
        i += 1;
    }
    ownership_source_env.open(e);
    ownership_source_env.runtime(e);
    assert(ownership_source_env.prepare(e, strbuf.view(text)));
    ownership_source.analyze(&e->source);
}

fn stored_row(ownership_source_env.env mut* e, string name, string correspondence,
    string proof) ownership_source.body* {
    ownership_source.body* row = ownership_source_env.find(e, "main", name);
    assert(row->stored.solved && row->stored.stored);
    u64 stored = ownership_report.STORED_BORROWS;
    string got_correspondence = ownership_report.analysis_status(row, stored, 0);
    string got_proof = ownership_report.analysis_status(row, stored, 2);
    if (got_correspondence != correspondence || got_proof != proof) {
        eprintln(name, ": correspondence ", got_correspondence, ", proof ", got_proof, ", gap ",
            cast(row->stored.gap, u64));
        assert(false);
    }
    return row;
}

fn proved(ownership_source_env.env mut* e, counts mut* n, string name) void {
    stored_row(e, name, "complete", "complete");
    n->proved += 1;
}

// The local row validates one violation of `slot`. The stored run meets the same event and
// excludes it, so its row has no violation and incomplete proof.
fn excluded(ownership_source_env.env mut* e, counts mut* n, string name, string slot) void {
    ownership_source.body* row = stored_row(e, name, "complete", "incomplete");
    assert(row->stored.violations_len == 0);
    assert(row->local.violations_len == 1 && row->local.violations[0].name == slot);
    n->excluded += 1;
}

// Incomplete proof in both rows and no violation in either.
fn declared(ownership_source_env.env mut* e, counts mut* n, string name) void {
    ownership_source.body* row = stored_row(e, name, "complete", "incomplete");
    assert(row->stored.violations_len == 0 && row->local.violations_len == 0);
    n->declared += 1;
}

fn outside(ownership_source_env.env mut* e, counts mut* n, string name,
    ownership_source_local.missing why) void {
    ownership_source.body* row = stored_row(e, name, "incomplete", "incomplete");
    assert(row->stored.gap == why && row->local.gap == why);
    n->outside += 1;
}

// The deferred test expects the error on line 7.
fn f047(counts mut* n) void {
    string[13] lines = {
        "",
        "",
        "",
        "fn main() i32 {",
        "    i32 mut* own a = new(i32);",
        "    i32 mut* own b = move(a);",
        "    println(*a);",
        "    i32 mut* own c = move(b);",
        "    println(b == null);",
        "    println(b == null);",
        "    del(c);",
        "    return 0;",
        "}",
    };
    ownership_source_env.env mut e = ownership_source_env.env{};
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    analyze(&e, &text, lines[..]);
    defer ownership_source_env.close(&e);
    excluded(&e, n, "main", "a");
}

// The leak follows print calls, which may not return.
fn f048(counts mut* n) void {
    string[13] lines = {
        "",
        "",
        "",
        "fn main() i32 {",
        "    i32* own a = null;",
        "    println(a == null);",
        "    u8 mut@ own s = {};",
        "    println(s.len);",
        "    i32 mut* own mut b = null;",
        "    println(b == null);",
        "    b = new(i32);",
        "    return 0;",
        "}",
    };
    ownership_source_env.env mut e = ownership_source_env.env{};
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    analyze(&e, &text, lines[..]);
    defer ownership_source_env.close(&e);
    declared(&e, n, "main");
}

// The leaks follow a print call.
fn f049(counts mut* n) void {
    string[16] lines = {
        "",
        "",
        "",
        "fn show() void {",
        "    i32 mut* own a = new(i32);",
        "    {",
        "        u8 mut@ own s = new(u8, 4);",
        "        println(s.len);",
        "    }",
        "    println(*a);",
        "}",
        "",
        "fn main() i32 {",
        "    show();",
        "    return 0;",
        "}",
    };
    ownership_source_env.env mut e = ownership_source_env.env{};
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    analyze(&e, &text, lines[..]);
    defer ownership_source_env.close(&e);
    declared(&e, n, "show");
    proved(&e, n, "main");
}

