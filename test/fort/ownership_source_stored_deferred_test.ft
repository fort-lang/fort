// An own parameter needs the symbolic caller owner.
fn f053(counts mut* n) void {
    string[11] lines = {
        "",
        "",
        "",
        "fn keep(i32 mut* own p) void {",
        "    println(*p);",
        "}",
        "",
        "fn main() i32 {",
        "    keep(new(i32));",
        "    return 0;",
        "}",
    };
    ownership_source_env.env mut e = ownership_source_env.env{};
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    analyze(&e, &text, lines[..]);
    defer ownership_source_env.close(&e);
    outside(&e, n, "keep", ownership_source_local.missing.own_parameter);
    proved(&e, n, "main");
}

// The corpus expects errors on lines 11 and 12. Line 11 is validated. The read does not
// relate b, so the path goes on and examines the leak of b on line 12 (toolchain 4.2). The
// print calls of line 11 are fort calls: no witness crosses them, so line 12 stays an
// unvalidated record and the first incomplete reason. The body stays rejected.
fn f054(counts mut* n) void {
    string[13] lines = {
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "fn main() i32 {",
        "    i32 mut* own a = new(i32);",
        "    i32 mut* own b = move(a);",
        "    println(*a);",
        "    return 0;",
        "}",
    };
    ownership_source_env.env mut e = ownership_source_env.env{};
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    analyze(&e, &text, lines[..]);
    defer ownership_source_env.close(&e);
    excluded(&e, n, "main", "a");
    ownership_source.body* row = ownership_source_env.find(&e, "main", "main");
    assert(row->local.unvalidated == 1);
    assert(row->local.first_incomplete.terminal.present);
    assert(row->local.first_incomplete.terminal.source.line == 12);
    assert(row->local.first_incomplete.terminal.reason ==
        ownership_api.incomplete_reason.missing_path);
    assert(row->local.proof.failed);
}

// The leak follows a print call.
