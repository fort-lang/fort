}

// The flag c holds false, so the deferred release never runs: p leaks at the return.
fn f064(counts mut* n) void {
    string[13] lines = {
        "",
        "",
        "",
        "fn main() i32 {",
        "    i32 mut* own p = new(i32);",
        "    bool c = false;",
        "    defer {",
        "        if (c) {",
        "            del(p);",
        "        }",
        "    }",
        "    return 0;",
        "}",
    };
    ownership_source_env.env mut e = ownership_source_env.env{};
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    analyze(&e, &text, lines[..]);
    defer ownership_source_env.close(&e);
    excluded(&e, n, "main", "p");
}

// The conditional release goes through a call.
fn f065(counts mut* n) void {
    string[20] lines = {
        "",
        "",
        "",
        "fn drop(i32 mut* own p) void {",
        "    del(p);",
        "}",
        "",
        "fn leaky(bool c) void {",
        "    i32 mut* own a = new(i32);",
        "    defer {",
        "        if (c) {",
        "            defer drop(move(a));",
        "        }",
        "    }",
        "}",
        "",
        "fn main() i32 {",
        "    leaky(false);",
        "    return 0;",
        "}",
    };
    ownership_source_env.env mut e = ownership_source_env.env{};
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    analyze(&e, &text, lines[..]);
    defer ownership_source_env.close(&e);
    outside(&e, n, "drop", ownership_source_local.missing.own_parameter);
    declared(&e, n, "leaky");
    proved(&e, n, "main");
}

// The loop releases p on some paths only.
fn f066(counts mut* n) void {
    string[17] lines = {
        "",
        "",
        "",
        "",
        "",
        "fn main() i32 {",
        "    i32 mut* own p = new(i32);",
        "    i32 n = 0;",
        "    defer {",
        "        i32 mut i = 0;",
        "        while (i < n) {",
        "            del(p);",
        "            i += 1;",
        "        }",
        "    }",
        "    return 0;",
        "}",
    };
    ownership_source_env.env mut e = ownership_source_env.env{};
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    analyze(&e, &text, lines[..]);
    defer ownership_source_env.close(&e);
    declared(&e, n, "main");
}

fn main() i32 {
    counts mut n = counts{};
    f047(&n);
    f048(&n);
    f049(&n);
    f050(&n);
    f051(&n);
    f052(&n);
    f053(&n);
    f054(&n);
    f055(&n);
    f056(&n);
    f057(&n);
    f058(&n);
    f059(&n);
    f060(&n);
    f061(&n);
    f062(&n);
    f063(&n);
    f064(&n);
    f065(&n);
    f066(&n);
    println("deferred fail tests ok");
    // 20 programs hold 27 bodies. The local row validates 9 events and the stored row repeats
    // none of them.
    assert(n.excluded == 9 && n.declared == 8 && n.outside == 4 && n.proved == 6);
    println("totals ok");
    return 0;
}
