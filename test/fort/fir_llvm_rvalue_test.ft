//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| arithmetic ok
//| reuse ok
//| comparisons ok
//| casts ok
//| headers ok
//| aggregates ok
/// Checks the text that the FIR translator writes for each rvalue kind (spec/fir.md 12.2): the
/// arithmetic by signedness, the overflow intrinsics and the `add` of their continuation, the
/// comparisons, the casts of toolchain.md 6 item 12, `addr`, `slice`, `slice_ptr`, `alloc` and
/// `aggregate`.
import fir;
import llvm_env;
import pass_env;
import std.str;

// ---- arithmetic ---------------------------------------------------------------------------------

string[55] ARITH = {
    "fn add(i32 a, i32 b) i32 {",
    "    return a + b;",
    "}",
    "fn subu(u8 a, u8 b) u8 {",
    "    return a - b;",
    "}",
    "fn mul64(i64 a, i64 b) i64 {",
    "    return a * b;",
    "}",
    "fn neg(i16 x) i16 {",
    "    return -x;",
    "}",
    "fn div(i32 a, i32 b) i32 {",
    "    return a / b;",
    "}",
    "fn remu(u32 a, u32 b) u32 {",
    "    return a % b;",
    "}",
    "fn bits(u16 a, u16 b) u16 {",
    "    return (a & b) | (a ^ b);",
    "}",
    "fn inv(i32 a, bool c) bool {",
    "    i32 x = ~a;",
    "    return !c;",
    "}",
    "fn shl(i32 a, u8 n) i32 {",
    "    return a << n;",
    "}",
    "fn shr(i32 a, i32 n) i32 {",
    "    return a >> n;",
    "}",
    "fn shru(u64 a, u64 n) u64 {",
    "    return a >> n;",
    "}",
    "fn flt(f64 a, f64 b) f64 {",
    "    return -(a * b + a / b - b);",
    "}",
    "fn addu(u32 a, u32 b) u32 {",
    "    return a + b;",
    "}",
    "fn mulu(u16 a, u16 b) u16 {",
    "    return a * b;",
    "}",
    "fn divu(u64 a, u64 b) u64 {",
    "    return a / b;",
    "}",
    "fn rems(i8 a, i8 b) i8 {",
    "    return a % b;",
    "}",
    "fn div16(i16 a, i16 b) i16 {",
    "    return a / b;",
    "}",
    "fn div64(i64 a, i64 b) i64 {",
    "    return a / b;",
    "}",
};

// `a + b` in checked mode: the intrinsic, `extractvalue 0` and `extractvalue 1` in the order of
// toolchain.md 6 item 15. The `add` of the continuation prints
// nothing, and `_0` takes `%t3`, the name of `extractvalue 0` (spec/fir.md 12.2).
fn a_checked_add_writes_the_intrinsic_once() void {
    llvm_env.env mut e = llvm_env.env{};
    llvm_env.open(&e);
    defer llvm_env.close(&e);
    string[14] want = {
        "entry:",
        "  %result = alloca i32, align 4",
        "  %a.0 = alloca i32, align 4",
        "  %b.1 = alloca i32, align 4",
        "  store i32 %a.in, ptr %a.0, align 4",
        "  store i32 %b.in, ptr %b.1, align 4",
        "  %t0 = load i32, ptr %a.0, align 4",
        "  %t1 = load i32, ptr %b.1, align 4",
        "  %t2 = call { i32, i1 } @llvm.sadd.with.overflow.i32(i32 %t0, i32 %t1)",
        "  %t3 = extractvalue { i32, i1 } %t2, 0",
        "  %t4 = extractvalue { i32, i1 } %t2, 1",
        "",
        "L1:",
        "  store i32 %t3, ptr %result, align 4",
    };
    llvm_env.expect(&e, llvm_env.lowered(&e, ARITH[..], "add", pass_env.CHECKED), want[..]);
    assert(e.g.intrinsics[2 + 0 * 4 + 2]);
    // the intrinsic and `#4` are marked for the declarations
    assert(e.g.attrs[4]);
    // in release the pass leaves a plain `add`, with no `nsw`
    string[4] plain = {
        "  %t0 = load i32, ptr %a.0, align 4",
        "  %t1 = load i32, ptr %b.1, align 4",
        "  %t2 = add i32 %t0, %t1",
        "  store i32 %t2, ptr %result, align 4",
    };
    string got = llvm_env.lowered(&e, ARITH[..], "add", pass_env.RELEASE);
    llvm_env.expect2(&e, got, want[0..6], plain[..]);
    assert(!e.g.intrinsics[2 + 0 * 4 + 2]);
}

// The family and the width of the intrinsic follow the type of `a`: `usub` for a `u8`, `smul`
// for an `i64`, and `ssub` of `0` for the negation of an `i16`, whose continuation reuses the
// `sub` of the same two operands.
fn the_intrinsic_follows_the_signedness_and_the_width() void {
    llvm_env.env mut e = llvm_env.env{};
    llvm_env.open(&e);
    defer llvm_env.close(&e);
    string[8] subu = {
        "  %t0 = load i8, ptr %a.0, align 1",
        "  %t1 = load i8, ptr %b.1, align 1",
        "  %t2 = call { i8, i1 } @llvm.usub.with.overflow.i8(i8 %t0, i8 %t1)",
        "  %t3 = extractvalue { i8, i1 } %t2, 0",
        "  %t4 = extractvalue { i8, i1 } %t2, 1",
        "",
        "L1:",
        "  store i8 %t3, ptr %result, align 1",
    };
    string[6] subu_entry = {
        "entry:",
        "  %result = alloca i8, align 1",
        "  %a.0 = alloca i8, align 1",
        "  %b.1 = alloca i8, align 1",
        "  store i8 %a.in, ptr %a.0, align 1",
        "  store i8 %b.in, ptr %b.1, align 1",
    };
    string mut got = llvm_env.lowered(&e, ARITH[..], "subu", pass_env.CHECKED);
    llvm_env.expect2(&e, got, subu_entry[..], subu[..]);
    string[5] mul = {
        "  %t0 = load i64, ptr %a.0, align 8",
        "  %t1 = load i64, ptr %b.1, align 8",
        "  %t2 = call { i64, i1 } @llvm.smul.with.overflow.i64(i64 %t0, i64 %t1)",
        "  %t3 = extractvalue { i64, i1 } %t2, 0",
        "  %t4 = extractvalue { i64, i1 } %t2, 1",
    };
    string[6] mul_entry = {
        "entry:",
        "  %result = alloca i64, align 8",
        "  %a.0 = alloca i64, align 8",
        "  %b.1 = alloca i64, align 8",
        "  store i64 %a.in, ptr %a.0, align 8",
        "  store i64 %b.in, ptr %b.1, align 8",
    };
    string[3] mul_tail = {"", "L1:", "  store i64 %t3, ptr %result, align 8"};
    got = llvm_env.lowered(&e, ARITH[..], "mul64", pass_env.CHECKED);
    llvm_env.expect3(&e, got, mul_entry[..], mul[..], mul_tail[..]);
    string[11] neg = {
        "entry:",
        "  %result = alloca i16, align 2",
        "  %x.0 = alloca i16, align 2",
        "  store i16 %x.in, ptr %x.0, align 2",
        "  %t0 = load i16, ptr %x.0, align 2",
        "  %t1 = call { i16, i1 } @llvm.ssub.with.overflow.i16(i16 0, i16 %t0)",
        "  %t2 = extractvalue { i16, i1 } %t1, 0",
        "  %t3 = extractvalue { i16, i1 } %t1, 1",
        "",
        "L1:",
        "  store i16 %t2, ptr %result, align 2",
    };
    llvm_env.expect(&e, llvm_env.lowered(&e, ARITH[..], "neg", pass_env.CHECKED), neg[..]);
}

// `a / b` on an `i32`: the zero test, then the two tests of `MIN / -1` and their `and`, then
// `sdiv`. Each operand is loaded for each rvalue that names it (spec/fir.md 12.5). `a % b` on a
// `u32` has no second check and is `urem`.
fn division_by_signedness() void {
    llvm_env.env mut e = llvm_env.env{};
    llvm_env.open(&e);
    defer llvm_env.close(&e);
    string[21] want = {
        "entry:",
        "  %result = alloca i32, align 4",
        "  %a.0 = alloca i32, align 4",
        "  %b.1 = alloca i32, align 4",
        "  store i32 %a.in, ptr %a.0, align 4",
        "  store i32 %b.in, ptr %b.1, align 4",
        "  %t0 = load i32, ptr %b.1, align 4",
        "  %t1 = icmp eq i32 %t0, 0",
        "",
        "L1:",
        "  %t2 = load i32, ptr %b.1, align 4",
        "  %t3 = icmp eq i32 %t2, -1",
        "  %t4 = load i32, ptr %a.0, align 4",
        "  %t5 = icmp eq i32 %t4, -2147483648",
        "  %t6 = and i1 %t3, %t5",
        "",
        "L2:",
        "  %t7 = load i32, ptr %a.0, align 4",
        "  %t8 = load i32, ptr %b.1, align 4",
        "  %t9 = sdiv i32 %t7, %t8",
        "  store i32 %t9, ptr %result, align 4",
    };
    llvm_env.expect(&e, llvm_env.lowered(&e, ARITH[..], "div", pass_env.CHECKED), want[..]);
    string[14] rem = {
        "entry:",
        "  %result = alloca i32, align 4",
        "  %a.0 = alloca i32, align 4",
        "  %b.1 = alloca i32, align 4",
        "  store i32 %a.in, ptr %a.0, align 4",
        "  store i32 %b.in, ptr %b.1, align 4",
        "  %t0 = load i32, ptr %b.1, align 4",
        "  %t1 = icmp eq i32 %t0, 0",
        "",
        "L1:",
        "  %t2 = load i32, ptr %a.0, align 4",
        "  %t3 = load i32, ptr %b.1, align 4",
        "  %t4 = urem i32 %t2, %t3",
        "  store i32 %t4, ptr %result, align 4",
    };
    llvm_env.expect(&e, llvm_env.lowered(&e, ARITH[..], "remu", pass_env.CHECKED), rem[..]);
}

// `+` on a `u32` is `llvm.uadd` and `*` on a `u16` is `llvm.umul`, whose continuations reuse
// `extractvalue 0` as the signed forms do.
fn the_unsigned_intrinsics() void {
    llvm_env.env mut e = llvm_env.env{};
    llvm_env.open(&e);
    defer llvm_env.close(&e);
    string[14] addu = {
        "entry:",
        "  %result = alloca i32, align 4",
        "  %a.0 = alloca i32, align 4",
        "  %b.1 = alloca i32, align 4",
        "  store i32 %a.in, ptr %a.0, align 4",
        "  store i32 %b.in, ptr %b.1, align 4",
        "  %t0 = load i32, ptr %a.0, align 4",
        "  %t1 = load i32, ptr %b.1, align 4",
        "  %t2 = call { i32, i1 } @llvm.uadd.with.overflow.i32(i32 %t0, i32 %t1)",
        "  %t3 = extractvalue { i32, i1 } %t2, 0",
        "  %t4 = extractvalue { i32, i1 } %t2, 1",
        "",
        "L1:",
        "  store i32 %t3, ptr %result, align 4",
    };
    llvm_env.expect(&e, llvm_env.lowered(&e, ARITH[..], "addu", pass_env.CHECKED), addu[..]);
    string[14] mulu = {
        "entry:",
        "  %result = alloca i16, align 2",
        "  %a.0 = alloca i16, align 2",
        "  %b.1 = alloca i16, align 2",
        "  store i16 %a.in, ptr %a.0, align 2",
        "  store i16 %b.in, ptr %b.1, align 2",
        "  %t0 = load i16, ptr %a.0, align 2",
        "  %t1 = load i16, ptr %b.1, align 2",
        "  %t2 = call { i16, i1 } @llvm.umul.with.overflow.i16(i16 %t0, i16 %t1)",
        "  %t3 = extractvalue { i16, i1 } %t2, 0",
        "  %t4 = extractvalue { i16, i1 } %t2, 1",
        "",
        "L1:",
        "  store i16 %t3, ptr %result, align 2",
    };
    llvm_env.expect(&e, llvm_env.lowered(&e, ARITH[..], "mulu", pass_env.CHECKED), mulu[..]);
}

// `/` on a `u64` is `udiv` with the zero test alone, and `%` on an `i8` is `srem` after the test
// of `-128 / -1`, whose smallest value the constant prints signed. The smallest value of `i16`
// and of `i64` print signed too; division_by_signedness holds the one of `i32`.
fn the_other_divisions() void {
    llvm_env.env mut e = llvm_env.env{};
    llvm_env.open(&e);
    defer llvm_env.close(&e);
    string[14] divu = {
        "entry:",
        "  %result = alloca i64, align 8",
        "  %a.0 = alloca i64, align 8",
        "  %b.1 = alloca i64, align 8",
        "  store i64 %a.in, ptr %a.0, align 8",
        "  store i64 %b.in, ptr %b.1, align 8",
        "  %t0 = load i64, ptr %b.1, align 8",
        "  %t1 = icmp eq i64 %t0, 0",
        "",
        "L1:",
        "  %t2 = load i64, ptr %a.0, align 8",
        "  %t3 = load i64, ptr %b.1, align 8",
        "  %t4 = udiv i64 %t2, %t3",
        "  store i64 %t4, ptr %result, align 8",
    };
    llvm_env.expect(&e, llvm_env.lowered(&e, ARITH[..], "divu", pass_env.CHECKED), divu[..]);
    string[21] rems = {
        "entry:",
        "  %result = alloca i8, align 1",
        "  %a.0 = alloca i8, align 1",
        "  %b.1 = alloca i8, align 1",
        "  store i8 %a.in, ptr %a.0, align 1",
        "  store i8 %b.in, ptr %b.1, align 1",
        "  %t0 = load i8, ptr %b.1, align 1",
        "  %t1 = icmp eq i8 %t0, 0",
        "",
        "L1:",
        "  %t2 = load i8, ptr %b.1, align 1",
        "  %t3 = icmp eq i8 %t2, -1",
        "  %t4 = load i8, ptr %a.0, align 1",
        "  %t5 = icmp eq i8 %t4, -128",
        "  %t6 = and i1 %t3, %t5",
        "",
        "L2:",
        "  %t7 = load i8, ptr %a.0, align 1",
        "  %t8 = load i8, ptr %b.1, align 1",
        "  %t9 = srem i8 %t7, %t8",
        "  store i8 %t9, ptr %result, align 1",
    };
    llvm_env.expect(&e, llvm_env.lowered(&e, ARITH[..], "rems", pass_env.CHECKED), rems[..]);
    string[2] min16 = {"  %t4 = load i16, ptr %a.0, align 2", "  %t5 = icmp eq i16 %t4, -32768"};
    llvm_env.contains(&e, llvm_env.lowered(&e, ARITH[..], "div16", pass_env.CHECKED), min16[..]);
    string[2] min64 = {
        "  %t4 = load i64, ptr %a.0, align 8",
        "  %t5 = icmp eq i64 %t4, -9223372036854775808",
    };
    llvm_env.contains(&e, llvm_env.lowered(&e, ARITH[..], "div64", pass_env.CHECKED), min64[..]);
}

// `&`, `^`, `|`, `~` and `!`: one instruction each, `xor` with `-1` for `~` and with `true` for
// `!`.
fn the_bitwise_operations() void {
    llvm_env.env mut e = llvm_env.env{};
    llvm_env.open(&e);
    defer llvm_env.close(&e);
    string[14] want = {
        "entry:",
        "  %result = alloca i16, align 2",
        "  %a.0 = alloca i16, align 2",
        "  %b.1 = alloca i16, align 2",
        "  store i16 %a.in, ptr %a.0, align 2",
        "  store i16 %b.in, ptr %b.1, align 2",
        "  %t0 = load i16, ptr %a.0, align 2",
        "  %t1 = load i16, ptr %b.1, align 2",
        "  %t2 = and i16 %t0, %t1",
        "  %t3 = load i16, ptr %a.0, align 2",
        "  %t4 = load i16, ptr %b.1, align 2",
        "  %t5 = xor i16 %t3, %t4",
        "  %t6 = or i16 %t2, %t5",
        "  store i16 %t6, ptr %result, align 2",
    };
    llvm_env.expect(&e, llvm_env.lowered(&e, ARITH[..], "bits", pass_env.CHECKED), want[..]);
    string[16] inv = {
        "entry:",
        "  %result = alloca i8, align 1",
        "  %a.0 = alloca i32, align 4",
        "  %c.1 = alloca i8, align 1",
        "  %x.2 = alloca i32, align 4",
        "  store i32 %a.in, ptr %a.0, align 4",
        "  %t0 = zext i1 %c.in to i8",
        "  store i8 %t0, ptr %c.1, align 1",
        "  %t1 = load i32, ptr %a.0, align 4",
        "  %t2 = xor i32 %t1, -1",
        "  store i32 %t2, ptr %x.2, align 4",
        "  %t3 = load i8, ptr %c.1, align 1",
        "  %t4 = trunc i8 %t3 to i1",
        "  %t5 = xor i1 %t4, true",
        "  %t6 = zext i1 %t5 to i8",
        "  store i8 %t6, ptr %result, align 1",
    };
    llvm_env.expect(&e, llvm_env.lowered(&e, ARITH[..], "inv", pass_env.CHECKED), inv[..]);
}

// A shift widens the count to `i64` by its own signedness, compares it with the width, and
// narrows it to the type of `a` in the continuation; `>>` is `ashr` for an `i32` and `lshr` for a
// `u64` (toolchain.md 6 item 15). Under --release the mask `and i64 ..., 31` replaces the
// compare.
fn the_shifts() void {
    llvm_env.env mut e = llvm_env.env{};
    llvm_env.open(&e);
    defer llvm_env.close(&e);
    string[15] shl = {
        "entry:",
        "  %result = alloca i32, align 4",
        "  %a.0 = alloca i32, align 4",
        "  %n.1 = alloca i8, align 1",
        "  store i32 %a.in, ptr %a.0, align 4",
        "  store i8 %n.in, ptr %n.1, align 1",
        "  %t0 = load i8, ptr %n.1, align 1",
        "  %t1 = zext i8 %t0 to i64",
        "  %t2 = icmp uge i64 %t1, 32",
        "",
        "L1:",
        "  %t3 = trunc i64 %t1 to i32",
        "  %t4 = load i32, ptr %a.0, align 4",
        "  %t5 = shl i32 %t4, %t3",
        "  store i32 %t5, ptr %result, align 4",
    };
    llvm_env.expect(&e, llvm_env.lowered(&e, ARITH[..], "shl", pass_env.CHECKED), shl[..]);
    string[13] masked = {
        "entry:",
        "  %result = alloca i32, align 4",
        "  %a.0 = alloca i32, align 4",
        "  %n.1 = alloca i8, align 1",
        "  store i32 %a.in, ptr %a.0, align 4",
        "  store i8 %n.in, ptr %n.1, align 1",
        "  %t0 = load i8, ptr %n.1, align 1",
        "  %t1 = zext i8 %t0 to i64",
        "  %t2 = and i64 %t1, 31",
        "  %t3 = trunc i64 %t2 to i32",
        "  %t4 = load i32, ptr %a.0, align 4",
        "  %t5 = shl i32 %t4, %t3",
        "  store i32 %t5, ptr %result, align 4",
    };
    llvm_env.expect(&e, llvm_env.lowered(&e, ARITH[..], "shl", pass_env.RELEASE), masked[..]);
    string[15] shr = {
        "entry:",
        "  %result = alloca i32, align 4",
        "  %a.0 = alloca i32, align 4",
        "  %n.1 = alloca i32, align 4",
        "  store i32 %a.in, ptr %a.0, align 4",
        "  store i32 %n.in, ptr %n.1, align 4",
        "  %t0 = load i32, ptr %n.1, align 4",
        "  %t1 = sext i32 %t0 to i64",
        "  %t2 = icmp uge i64 %t1, 32",
        "",
        "L1:",
        "  %t3 = trunc i64 %t1 to i32",
        "  %t4 = load i32, ptr %a.0, align 4",
        "  %t5 = ashr i32 %t4, %t3",
        "  store i32 %t5, ptr %result, align 4",
    };
    llvm_env.expect(&e, llvm_env.lowered(&e, ARITH[..], "shr", pass_env.CHECKED), shr[..]);
    string[13] shru = {
        "entry:",
        "  %result = alloca i64, align 8",
        "  %a.0 = alloca i64, align 8",
        "  %n.1 = alloca i64, align 8",
        "  store i64 %a.in, ptr %a.0, align 8",
        "  store i64 %n.in, ptr %n.1, align 8",
        "  %t0 = load i64, ptr %n.1, align 8",
        "  %t1 = icmp uge i64 %t0, 64",
        "",
        "L1:",
        "  %t2 = load i64, ptr %a.0, align 8",
        "  %t3 = lshr i64 %t2, %t0",
        "  store i64 %t3, ptr %result, align 8",
    };
    llvm_env.expect(&e, llvm_env.lowered(&e, ARITH[..], "shru", pass_env.CHECKED), shru[..]);
}

// Float arithmetic carries no fast-math flag, and the negation is `fneg` (D16).
fn float_arithmetic() void {
    llvm_env.env mut e = llvm_env.env{};
    llvm_env.open(&e);
    defer llvm_env.close(&e);
    string[17] want = {
        "entry:",
        "  %result = alloca double, align 8",
        "  %a.0 = alloca double, align 8",
        "  %b.1 = alloca double, align 8",
        "  store double %a.in, ptr %a.0, align 8",
        "  store double %b.in, ptr %b.1, align 8",
        "  %t0 = load double, ptr %a.0, align 8",
        "  %t1 = load double, ptr %b.1, align 8",
        "  %t2 = fmul double %t0, %t1",
        "  %t3 = load double, ptr %a.0, align 8",
        "  %t4 = load double, ptr %b.1, align 8",
        "  %t5 = fdiv double %t3, %t4",
        "  %t6 = fadd double %t2, %t5",
        "  %t7 = load double, ptr %b.1, align 8",
        "  %t8 = fsub double %t6, %t7",
        "  %t9 = fneg double %t8",
        "  store double %t9, ptr %result, align 8",
    };
    llvm_env.expect(&e, llvm_env.lowered(&e, ARITH[..], "flt", pass_env.CHECKED), want[..]);
}

// ---- the reuse of an intrinsic ------------------------------------------------------------------

// Hand-written continuations of one overflow check, one function each: the operands in another
// order, a second `add` after the first, a `sub` of the same operands, a check of another flag, an
// `add` in a block that is no continuation, an assignment before the `add`, a `live` before it,
// and an assignment of an operand after the intrinsic in its own block.
string[111] REUSE = {
    "fn main.swapped(_1 (a): i32, _2 (b): i32) -> i32 {",
    "    let _3: bool;",
    "    let _4: i32;",
    "",
    "    bb0: {",
    "        _3 = add_overflows(copy _1, copy _2) #1:1 s1;",
    "        check(copy _3, overflow) -> bb1 #1:1 s1;",
    "    }",
    "    bb1: {",
    "        _4 = add(copy _2, copy _1) #1:1 s1;",
    "        _0 = copy _4 #1:1 s1;",
    "        return #1:1 s1;",
    "    }",
    "}",
    "fn main.second(_1 (a): i32, _2 (b): i32) -> i32 {",
    "    let _3: bool;",
    "    let _4: i32;",
    "",
    "    bb0: {",
    "        _3 = add_overflows(copy _1, copy _2) #1:1 s1;",
    "        check(copy _3, overflow) -> bb1 #1:1 s1;",
    "    }",
    "    bb1: {",
    "        _4 = add(copy _1, copy _2) #1:1 s1;",
    "        _0 = add(copy _1, copy _2) #1:1 s1;",
    "        return #1:1 s1;",
    "    }",
    "}",
    "fn main.other(_1 (a): i32, _2 (b): i32) -> i32 {",
    "    let _3: bool;",
    "",
    "    bb0: {",
    "        _3 = add_overflows(copy _1, copy _2) #1:1 s1;",
    "        check(copy _3, overflow) -> bb1 #1:1 s1;",
    "    }",
    "    bb1: {",
    "        _0 = sub(copy _1, copy _2) #1:1 s1;",
    "        return #1:1 s1;",
    "    }",
    "}",
    "fn main.flag(_1 (a): i32, _2 (b): i32) -> i32 {",
    "    let _3: bool;",
    "    let _4: bool;",
    "",
    "    bb0: {",
    "        _4 = const false #1:1 s1;",
    "        _3 = add_overflows(copy _1, copy _2) #1:1 s1;",
    "        check(copy _4, overflow) -> bb1 #1:1 s1;",
    "    }",
    "    bb1: {",
    "        _0 = add(copy _1, copy _2) #1:1 s1;",
    "        return #1:1 s1;",
    "    }",
    "}",
    "fn main.away(_1 (a): i32, _2 (b): i32) -> i32 {",
    "    let _3: bool;",
    "",
    "    bb0: {",
    "        _3 = add_overflows(copy _1, copy _2) #1:1 s1;",
    "        check(copy _3, overflow) -> bb1 #1:1 s1;",
    "    }",
    "    bb1: {",
    "        goto bb2 #1:1 s1;",
    "    }",
    "    bb2: {",
    "        _0 = add(copy _1, copy _2) #1:1 s1;",
    "        return #1:1 s1;",
    "    }",
    "}",
    "fn main.late(_1 (a): i32, _2 (b): i32) -> i32 {",
    "    let _3: bool;",
    "    let _4: i32;",
    "",
    "    bb0: {",
    "        _3 = add_overflows(copy _1, copy _2) #1:1 s1;",
    "        check(copy _3, overflow) -> bb1 #1:1 s1;",
    "    }",
    "    bb1: {",
    "        _1 = const i32 5 #1:1 s1;",
    "        _0 = add(copy _1, copy _2) #1:1 s1;",
    "        return #1:1 s1;",
    "    }",
    "}",
    "fn main.alive(_1 (a): i32, _2 (b): i32) -> i32 {",
    "    let _3: bool;",
    "    let _4 (y): i32;",
    "",
    "    bb0: {",
    "        _3 = mul_overflows(copy _1, const i32 3) #1:1 s1;",
    "        check(copy _3, overflow) -> bb1 #1:1 s1;",
    "    }",
    "    bb1: {",
    "        live(_4) #1:1 s1;",
    "        _4 = mul(copy _1, const i32 3) #1:1 s1;",
    "        _0 = copy _4 #1:1 s1;",
    "        return #1:1 s1;",
    "    }",
    "}",
    "fn main.written(_1 (a): i32, _2 (b): i32) -> i32 {",
    "    let _3: bool;",
    "",
    "    bb0: {",
    "        _3 = add_overflows(copy _1, copy _2) #1:1 s1;",
    "        _1 = const i32 100 #1:1 s1;",
    "        check(copy _3, overflow) -> bb1 #1:1 s1;",
    "    }",
    "    bb1: {",
    "        _0 = add(copy _1, copy _2) #1:1 s1;",
    "        return #1:1 s1;",
    "    }",
    "}",
};

// The entry of each function of REUSE: two `i32` parameters and `%result`.
string[6] REUSE_ENTRY = {
    "entry:",
    "  %result = alloca i32, align 4",
    "  %a.0 = alloca i32, align 4",
    "  %b.1 = alloca i32, align 4",
    "  store i32 %a.in, ptr %a.0, align 4",
    "  store i32 %b.in, ptr %b.1, align 4",
};

// The intrinsic of `add_overflows(copy _1, copy _2)` at the start of each function of REUSE.
string[5] REUSE_ADD = {
    "  %t0 = load i32, ptr %a.0, align 4",
    "  %t1 = load i32, ptr %b.1, align 4",
    "  %t2 = call { i32, i1 } @llvm.sadd.with.overflow.i32(i32 %t0, i32 %t1)",
    "  %t3 = extractvalue { i32, i1 } %t2, 0",
    "  %t4 = extractvalue { i32, i1 } %t2, 1",
};

// Only the first assignment of the continuation takes the name of `extractvalue 0`, and only when
// its operation and its two operands are those of the intrinsic whose flag the check tests. Every
// other `add` prints a plain `add` (spec/fir.md 12.2).
fn only_the_same_operation_in_the_continuation_reuses() void {
    llvm_env.env mut e = llvm_env.env{};
    llvm_env.open(&e);
    defer llvm_env.close(&e);
    string[1] prelude = {"i32 UNUSED = 0;"};
    fir.module mut m = llvm_env.parse(&e, prelude[..], REUSE[..]);
    defer fir.module_free(&m);
    string[6] swapped = {
        "",
        "L1:",
        "  %t5 = load i32, ptr %b.1, align 4",
        "  %t6 = load i32, ptr %a.0, align 4",
        "  %t7 = add i32 %t5, %t6",
        "  store i32 %t7, ptr %result, align 4",
    };
    string mut got = llvm_env.translate(&e, fir.module_function_at(&m, 0));
    llvm_env.expect3(&e, got, REUSE_ENTRY[..], REUSE_ADD[..], swapped[..]);
    string[6] second = {
        "",
        "L1:",
        "  %t5 = load i32, ptr %a.0, align 4",
        "  %t6 = load i32, ptr %b.1, align 4",
        "  %t7 = add i32 %t5, %t6",
        "  store i32 %t7, ptr %result, align 4",
    };
    got = llvm_env.translate(&e, fir.module_function_at(&m, 1));
    llvm_env.expect3(&e, got, REUSE_ENTRY[..], REUSE_ADD[..], second[..]);
    string[6] other = {
        "",
        "L1:",
        "  %t5 = load i32, ptr %a.0, align 4",
        "  %t6 = load i32, ptr %b.1, align 4",
        "  %t7 = sub i32 %t5, %t6",
        "  store i32 %t7, ptr %result, align 4",
    };
    got = llvm_env.translate(&e, fir.module_function_at(&m, 2));
    llvm_env.expect3(&e, got, REUSE_ENTRY[..], REUSE_ADD[..], other[..]);
    got = llvm_env.translate(&e, fir.module_function_at(&m, 3));
    llvm_env.expect3(&e, got, REUSE_ENTRY[..], REUSE_ADD[..], second[..]);
    string[8] away = {
        "",
        "L1:",
        "",
        "L2:",
        "  %t5 = load i32, ptr %a.0, align 4",
        "  %t6 = load i32, ptr %b.1, align 4",
        "  %t7 = add i32 %t5, %t6",
        "  store i32 %t7, ptr %result, align 4",
    };
    got = llvm_env.translate(&e, fir.module_function_at(&m, 4));
    llvm_env.expect3(&e, got, REUSE_ENTRY[..], REUSE_ADD[..], away[..]);
    string[7] late = {
        "",
        "L1:",
        "  store i32 5, ptr %a.0, align 4",
        "  %t5 = load i32, ptr %a.0, align 4",
        "  %t6 = load i32, ptr %b.1, align 4",
        "  %t7 = add i32 %t5, %t6",
        "  store i32 %t7, ptr %result, align 4",
    };
    got = llvm_env.translate(&e, fir.module_function_at(&m, 5));
    llvm_env.expect3(&e, got, REUSE_ENTRY[..], REUSE_ADD[..], late[..]);
    string[16] alive = {
        "entry:",
        "  %result = alloca i32, align 4",
        "  %a.0 = alloca i32, align 4",
        "  %b.1 = alloca i32, align 4",
        "  %y.3 = alloca i32, align 4",
        "  store i32 %a.in, ptr %a.0, align 4",
        "  store i32 %b.in, ptr %b.1, align 4",
        "  %t0 = load i32, ptr %a.0, align 4",
        "  %t1 = call { i32, i1 } @llvm.smul.with.overflow.i32(i32 %t0, i32 3)",
        "  %t2 = extractvalue { i32, i1 } %t1, 0",
        "  %t3 = extractvalue { i32, i1 } %t1, 1",
        "",
        "L1:",
        "  store i32 %t2, ptr %y.3, align 4",
        "  %t4 = load i32, ptr %y.3, align 4",
        "  store i32 %t4, ptr %result, align 4",
    };
    got = llvm_env.translate(&e, fir.module_function_at(&m, 6));
    llvm_env.expect(&e, got, alive[..]);
    // a store into `a` after the intrinsic changes the sum, so the `add` of the continuation
    // reads `a` again (spec/fir.md 12.2)
    string[7] written = {
        "  store i32 100, ptr %a.0, align 4",
        "",
        "L1:",
        "  %t5 = load i32, ptr %a.0, align 4",
        "  %t6 = load i32, ptr %b.1, align 4",
        "  %t7 = add i32 %t5, %t6",
        "  store i32 %t7, ptr %result, align 4",
    };
    got = llvm_env.translate(&e, fir.module_function_at(&m, 7));
    llvm_env.expect3(&e, got, REUSE_ENTRY[..], REUSE_ADD[..], written[..]);
}

// ---- comparisons --------------------------------------------------------------------------------

string[15] COMPARE = {
    "fn cmp(i32 a, i32 b, u32 c, u32 d) bool {",
    "    return a < b && c >= d;",
    "}",
    "fn fcmp(f32 a, f32 b) bool {",
    "    return a != b;",
    "}",
    "fn peq(i32* p) bool {",
    "    return p == null;",
    "}",
    "fn order(f64 a, f64 b, u8 c, u8 d, i8 x, i8 y) bool {",
    "    bool p = a < b && a <= b && a > b && a >= b && a == b;",
    "    bool q = c < d && c <= d && c > d && c != d;",
    "    return x <= y && x > y && x >= y;",
    "}",
    "",
};

// `<` on an `i32` is `icmp slt` and `>=` on a `u32` is `icmp uge`; the `&&` slot holds each side.
fn integer_comparisons_by_signedness() void {
    llvm_env.env mut e = llvm_env.env{};
    llvm_env.open(&e);
    defer llvm_env.close(&e);
    string[29] want = {
        "entry:",
        "  %result = alloca i8, align 1",
        "  %a.0 = alloca i32, align 4",
        "  %b.1 = alloca i32, align 4",
        "  %c.2 = alloca i32, align 4",
        "  %d.3 = alloca i32, align 4",
        "  %tmp0 = alloca i8, align 1",
        "  store i32 %a.in, ptr %a.0, align 4",
        "  store i32 %b.in, ptr %b.1, align 4",
        "  store i32 %c.in, ptr %c.2, align 4",
        "  store i32 %d.in, ptr %d.3, align 4",
        "  %t0 = load i32, ptr %a.0, align 4",
        "  %t1 = load i32, ptr %b.1, align 4",
        "  %t2 = icmp slt i32 %t0, %t1",
        "  %t3 = zext i1 %t2 to i8",
        "  store i8 %t3, ptr %tmp0, align 1",
        "",
        "L1:",
        "  %t4 = load i32, ptr %c.2, align 4",
        "  %t5 = load i32, ptr %d.3, align 4",
        "  %t6 = icmp uge i32 %t4, %t5",
        "  %t7 = zext i1 %t6 to i8",
        "  store i8 %t7, ptr %tmp0, align 1",
        "",
        "L2:",
        "  %t8 = load i8, ptr %tmp0, align 1",
        "  %t9 = trunc i8 %t8 to i1",
        "  %t10 = zext i1 %t9 to i8",
        "  store i8 %t10, ptr %result, align 1",
    };
    llvm_env.expect(&e, llvm_env.lowered(&e, COMPARE[..], "cmp", pass_env.CHECKED), want[..]);
}

// `!=` on floats is `fcmp une`, which is true for a NaN, and `==` on a pointer against `null` is
// `icmp eq ptr`.
fn float_and_pointer_comparisons() void {
    llvm_env.env mut e = llvm_env.env{};
    llvm_env.open(&e);
    defer llvm_env.close(&e);
    string[11] want = {
        "entry:",
        "  %result = alloca i8, align 1",
        "  %a.0 = alloca float, align 4",
        "  %b.1 = alloca float, align 4",
        "  store float %a.in, ptr %a.0, align 4",
        "  store float %b.in, ptr %b.1, align 4",
        "  %t0 = load float, ptr %a.0, align 4",
        "  %t1 = load float, ptr %b.1, align 4",
        "  %t2 = fcmp une float %t0, %t1",
        "  %t3 = zext i1 %t2 to i8",
        "  store i8 %t3, ptr %result, align 1",
    };
    llvm_env.expect(&e, llvm_env.lowered(&e, COMPARE[..], "fcmp", pass_env.CHECKED), want[..]);
    string[8] ptr = {
        "entry:",
        "  %result = alloca i8, align 1",
        "  %p.0 = alloca ptr, align 8",
        "  store ptr %p.in, ptr %p.0, align 8",
        "  %t0 = load ptr, ptr %p.0, align 8",
        "  %t1 = icmp eq ptr %t0, null",
        "  %t2 = zext i1 %t1 to i8",
        "  store i8 %t2, ptr %result, align 1",
    };
    llvm_env.expect(&e, llvm_env.lowered(&e, COMPARE[..], "peq", pass_env.CHECKED), ptr[..]);
}

// Each predicate once: the ordered float predicates `olt`, `ole`, `ogt`, `oge` and `oeq`, the
// unsigned `ult`, `ule`, `ugt` and `ne` of a `u8`, and the signed `sle`, `sgt` and `sge` of an
// `i8`.
fn every_predicate() void {
    llvm_env.env mut e = llvm_env.env{};
    llvm_env.open(&e);
    defer llvm_env.close(&e);
    string got = llvm_env.lowered(&e, COMPARE[..], "order", pass_env.CHECKED);
    string[12] predicates = {
        "fcmp olt double",
        "fcmp ole double",
        "fcmp ogt double",
        "fcmp oge double",
        "fcmp oeq double",
        "icmp ult i8",
        "icmp ule i8",
        "icmp ugt i8",
        "icmp ne i8",
        "icmp sle i8",
        "icmp sgt i8",
        "icmp sge i8",
    };
    for (string p : predicates) {
        if (str.find(got, p) < 0) {
            eprintln("fir_llvm_rvalue_test: no ", p, " in");
            eprint(got);
            panic("every_predicate: a predicate is missing");
        }
    }
}

// ---- casts --------------------------------------------------------------------------------------

string[27] CASTS = {
    "fn c1(i32 x) u32 {",
    "    return cast(x, u32);",
    "}",
    "fn c2(bool b) u8 {",
    "    return cast(b, u8);",
    "}",
    "fn c3(i64 x) i32 {",
    "    return cast(x, i32);",
    "}",
    "fn c4(i32* p) u64 {",
    "    return cast(p, u64);",
    "}",
    "fn c5(f32 f) i32 {",
    "    return cast(f, i32);",
    "}",
    "fn c6(u8 x) i32 {",
    "    return cast(x, i32);",
    "}",
    "fn c7(u64 x) i32* {",
    "    return cast(x, i32*);",
    "}",
    "fn c8(i32 x) f64 {",
    "    return cast(x, f64);",
    "}",
    "fn c9(f64 x) f32 {",
    "    return cast(x, f32);",
    "}",
};

// Translates the function `name` of CASTS and holds its text: the alloca of `_0` of the value type
// `rt` in memory, the parameter `x` of the memory type `pt`, and `body`, whose last line stores
// into `%result`.
fn cast_case(llvm_env.env mut* e, string name, string@ entry, string@ body) void {
    string got = llvm_env.lowered(e, CASTS[..], name, pass_env.CHECKED);
    llvm_env.expect2(e, got, entry, body);
}

// `cast` prints nothing when the two LLVM value types are equal, and the result takes the name of
// its operand: `i32` to `u32` stores `%t0`, the load of `x`. Every other cast is the instruction
// of toolchain.md 6 item 12: `zext` of the `i1` of a `bool`, `trunc`, `ptrtoint`, the saturating
// `llvm.fptosi.sat`, `zext` of a `u8`, `inttoptr`, `sitofp` and `fptrunc`.
fn each_cast_prints_the_instruction_of_its_types() void {
    llvm_env.env mut e = llvm_env.env{};
    llvm_env.open(&e);
    defer llvm_env.close(&e);
    string[4] i32_entry = {
        "entry:",
        "  %result = alloca i32, align 4",
        "  %x.0 = alloca i32, align 4",
        "  store i32 %x.in, ptr %x.0, align 4",
    };
    string[2] same = {
        "  %t0 = load i32, ptr %x.0, align 4",
        "  store i32 %t0, ptr %result, align 4",
    };
    cast_case(&e, "c1", i32_entry[..], same[..]);
    string[5] bool_entry = {
        "entry:",
        "  %result = alloca i8, align 1",
        "  %b.0 = alloca i8, align 1",
        "  %t0 = zext i1 %b.in to i8",
        "  store i8 %t0, ptr %b.0, align 1",
    };
    string[4] widen = {
        "  %t1 = load i8, ptr %b.0, align 1",
        "  %t2 = trunc i8 %t1 to i1",
        "  %t3 = zext i1 %t2 to i8",
        "  store i8 %t3, ptr %result, align 1",
    };
    cast_case(&e, "c2", bool_entry[..], widen[..]);
    string[4] i64_entry = {
        "entry:",
        "  %result = alloca i32, align 4",
        "  %x.0 = alloca i64, align 8",
        "  store i64 %x.in, ptr %x.0, align 8",
    };
    string[3] narrow = {
        "  %t0 = load i64, ptr %x.0, align 8",
        "  %t1 = trunc i64 %t0 to i32",
        "  store i32 %t1, ptr %result, align 4",
    };
    cast_case(&e, "c3", i64_entry[..], narrow[..]);
    string[4] ptr_entry = {
        "entry:",
        "  %result = alloca i64, align 8",
        "  %p.0 = alloca ptr, align 8",
        "  store ptr %p.in, ptr %p.0, align 8",
    };
    string[3] word = {
        "  %t0 = load ptr, ptr %p.0, align 8",
        "  %t1 = ptrtoint ptr %t0 to i64",
        "  store i64 %t1, ptr %result, align 8",
    };
    cast_case(&e, "c4", ptr_entry[..], word[..]);
    string[4] f32_entry = {
        "entry:",
        "  %result = alloca i32, align 4",
        "  %f.0 = alloca float, align 4",
        "  store float %f.in, ptr %f.0, align 4",
    };
    string[3] saturate = {
        "  %t0 = load float, ptr %f.0, align 4",
        "  %t1 = call i32 @llvm.fptosi.sat.i32.f32(float %t0)",
        "  store i32 %t1, ptr %result, align 4",
    };
    cast_case(&e, "c5", f32_entry[..], saturate[..]);
    // the conversion and its attribute group are marked for the declarations
    assert(e.g.intrinsics[26 + 0 * 4 + 2]);
    assert(e.g.attrs[4]);
    string[4] u8_entry = {
        "entry:",
        "  %result = alloca i32, align 4",
        "  %x.0 = alloca i8, align 1",
        "  store i8 %x.in, ptr %x.0, align 1",
    };
    string[3] unsigned = {
        "  %t0 = load i8, ptr %x.0, align 1",
        "  %t1 = zext i8 %t0 to i32",
        "  store i32 %t1, ptr %result, align 4",
    };
    cast_case(&e, "c6", u8_entry[..], unsigned[..]);
    string[4] u64_entry = {
        "entry:",
        "  %result = alloca ptr, align 8",
        "  %x.0 = alloca i64, align 8",
        "  store i64 %x.in, ptr %x.0, align 8",
    };
    string[3] address = {
        "  %t0 = load i64, ptr %x.0, align 8",
        "  %t1 = inttoptr i64 %t0 to ptr",
        "  store ptr %t1, ptr %result, align 8",
    };
    cast_case(&e, "c7", u64_entry[..], address[..]);
    string[4] to_f64 = {
        "entry:",
        "  %result = alloca double, align 8",
        "  %x.0 = alloca i32, align 4",
        "  store i32 %x.in, ptr %x.0, align 4",
    };
    string[3] signed = {
        "  %t0 = load i32, ptr %x.0, align 4",
        "  %t1 = sitofp i32 %t0 to double",
        "  store double %t1, ptr %result, align 8",
    };
    cast_case(&e, "c8", to_f64[..], signed[..]);
    string[4] f64_entry = {
        "entry:",
        "  %result = alloca float, align 4",
        "  %x.0 = alloca double, align 8",
        "  store double %x.in, ptr %x.0, align 8",
    };
    string[3] shorter = {
        "  %t0 = load double, ptr %x.0, align 8",
        "  %t1 = fptrunc double %t0 to float",
        "  store float %t1, ptr %result, align 4",
    };
    cast_case(&e, "c9", f64_entry[..], shorter[..]);
}

// ---- addresses, headers and allocations ---------------------------------------------------------

string[35] HEADERS = {
    "struct pair {",
    "    i32 a;",
    "    u64 b;",
    "}",
    "fn where(pair mut* p) u64 mut* {",
    "    return &p->b;",
    "}",
    "fn sl(i32[4] a, u64 lo, u64 hi) i32@ {",
    "    return a[lo..hi];",
    "}",
    "fn ss(i32@ s, u64 lo) i32@ {",
    "    return s[lo..];",
    "}",
    "fn sp(i32* p, i32 lo, i32 hi) i32@ {",
    "    return p[lo..hi];",
    "}",
    "fn one() i32 mut* own {",
    "    return new(i32);",
    "}",
    "fn many(i32 n) u8 mut@ own {",
    "    return new(u8, n);",
    "}",
    "fn text() string {",
    "    return \"hi\";",
    "}",
    "fn zero() pair {",
    "    pair z = {};",
    "    return z;",
    "}",
    "fn sub(string s) string {",
    "    return s[1..3];",
    "}",
    "fn onep() pair mut* own {",
    "    return new(pair);",
    "}",
};

// `addr` of a field through a pointer is the address of the field, with no load of it; the
// register that holds it names the `getelementptr`.
fn an_address_prints_no_load() void {
    llvm_env.env mut e = llvm_env.env{};
    llvm_env.open(&e);
    defer llvm_env.close(&e);
    string[7] want = {
        "entry:",
        "  %result = alloca ptr, align 8",
        "  %p.0 = alloca ptr, align 8",
        "  store ptr %p.in, ptr %p.0, align 8",
        "  %t0 = load ptr, ptr %p.0, align 8",
        "  %t1 = getelementptr inbounds %struct.main.pair, ptr %t0, i32 0, i32 1",
        "  store ptr %t1, ptr %result, align 8",
    };
    llvm_env.expect(&e, llvm_env.lowered(&e, HEADERS[..], "where", pass_env.CHECKED), want[..]);
}

// `slice` of a fixed array: the element address at `lo`, `sub hi, lo`, then the pointer and the
// length into the header of `%ret.sret` (toolchain.md 6 item 16).
fn a_slice_of_a_fixed_array() void {
    llvm_env.env mut e = llvm_env.env{};
    llvm_env.open(&e);
    defer llvm_env.close(&e);
    string[18] want = {
        "entry:",
        "  %lo.1 = alloca i64, align 8",
        "  %hi.2 = alloca i64, align 8",
        "  store i64 %lo.in, ptr %lo.1, align 8",
        "  store i64 %hi.in, ptr %hi.2, align 8",
        "  %t0 = load i64, ptr %lo.1, align 8",
        "  %t1 = load i64, ptr %hi.2, align 8",
        "  %t2 = icmp ugt i64 %t0, %t1",
        "  %t3 = icmp ugt i64 %t1, 4",
        "  %t4 = or i1 %t2, %t3",
        "",
        "L1:",
        "  %t5 = getelementptr inbounds [4 x i32], ptr %a.in, i64 0, i64 %t0",
        "  %t6 = sub i64 %t1, %t0",
        "  %t7 = getelementptr inbounds %fort.span, ptr %ret.sret, i32 0, i32 0",
        "  store ptr %t5, ptr %t7, align 8",
        "  %t8 = getelementptr inbounds %fort.span, ptr %ret.sret, i32 0, i32 1",
        "  store i64 %t6, ptr %t8, align 8",
    };
    llvm_env.expect(&e, llvm_env.lowered(&e, HEADERS[..], "sl", pass_env.CHECKED), want[..]);
}

// `slice` of a span reads its header: the length for each operand that names it, and the pointer
// field for the element address.
fn a_slice_of_a_span() void {
    llvm_env.env mut e = llvm_env.env{};
    llvm_env.open(&e);
    defer llvm_env.close(&e);
    string[27] want = {
        "entry:",
        "  %lo.1 = alloca i64, align 8",
        "  store i64 %lo.in, ptr %lo.1, align 8",
        "  %t0 = load i64, ptr %lo.1, align 8",
        "  %t1 = getelementptr inbounds %fort.span, ptr %s.in, i32 0, i32 1",
        "  %t2 = load i64, ptr %t1, align 8",
        "  %t3 = icmp ugt i64 %t0, %t2",
        "  %t4 = getelementptr inbounds %fort.span, ptr %s.in, i32 0, i32 1",
        "  %t5 = load i64, ptr %t4, align 8",
        "  %t6 = getelementptr inbounds %fort.span, ptr %s.in, i32 0, i32 1",
        "  %t7 = load i64, ptr %t6, align 8",
        "  %t8 = icmp ugt i64 %t5, %t7",
        "  %t9 = or i1 %t3, %t8",
        "  %t10 = getelementptr inbounds %fort.span, ptr %s.in, i32 0, i32 1",
        "  %t11 = load i64, ptr %t10, align 8",
        "",
        "L1:",
        "  %t12 = getelementptr inbounds %fort.span, ptr %s.in, i32 0, i32 1",
        "  %t13 = load i64, ptr %t12, align 8",
        "  %t14 = getelementptr inbounds %fort.span, ptr %s.in, i32 0, i32 0",
        "  %t15 = load ptr, ptr %t14, align 8",
        "  %t16 = getelementptr inbounds i32, ptr %t15, i64 %t0",
        "  %t17 = sub i64 %t13, %t0",
        "  %t18 = getelementptr inbounds %fort.span, ptr %ret.sret, i32 0, i32 0",
        "  store ptr %t16, ptr %t18, align 8",
        "  %t19 = getelementptr inbounds %fort.span, ptr %ret.sret, i32 0, i32 1",
        "  store i64 %t17, ptr %t19, align 8",
    };
    llvm_env.expect(&e, llvm_env.lowered(&e, HEADERS[..], "ss", pass_env.CHECKED), want[..]);
}

// `slice_ptr` widens each bound to `i64` by its signedness and checks nothing.
fn a_slice_of_a_pointer() void {
    llvm_env.env mut e = llvm_env.env{};
    llvm_env.open(&e);
    defer llvm_env.close(&e);
    string[18] want = {
        "entry:",
        "  %p.0 = alloca ptr, align 8",
        "  %lo.1 = alloca i32, align 4",
        "  %hi.2 = alloca i32, align 4",
        "  store ptr %p.in, ptr %p.0, align 8",
        "  store i32 %lo.in, ptr %lo.1, align 4",
        "  store i32 %hi.in, ptr %hi.2, align 4",
        "  %t0 = load ptr, ptr %p.0, align 8",
        "  %t1 = load i32, ptr %lo.1, align 4",
        "  %t2 = sext i32 %t1 to i64",
        "  %t3 = load i32, ptr %hi.2, align 4",
        "  %t4 = sext i32 %t3 to i64",
        "  %t5 = getelementptr inbounds i32, ptr %t0, i64 %t2",
        "  %t6 = sub i64 %t4, %t2",
        "  %t7 = getelementptr inbounds %fort.span, ptr %ret.sret, i32 0, i32 0",
        "  store ptr %t5, ptr %t7, align 8",
        "  %t8 = getelementptr inbounds %fort.span, ptr %ret.sret, i32 0, i32 1",
        "  store i64 %t6, ptr %t8, align 8",
    };
    llvm_env.expect(&e, llvm_env.lowered(&e, HEADERS[..], "sp", pass_env.CHECKED), want[..]);
}

// A slice of a `string` keeps the element type `i8`. The bounds are constants that the checker
// types `i32`, so their `cast<u64>` prints `sext` of a constant.
fn a_slice_of_a_string() void {
    llvm_env.env mut e = llvm_env.env{};
    llvm_env.open(&e);
    defer llvm_env.close(&e);
    string[18] want = {
        "entry:",
        "  %t0 = sext i32 1 to i64",
        "  %t1 = sext i32 3 to i64",
        "  %t2 = icmp ugt i64 %t0, %t1",
        "  %t3 = getelementptr inbounds %fort.span, ptr %s.in, i32 0, i32 1",
        "  %t4 = load i64, ptr %t3, align 8",
        "  %t5 = icmp ugt i64 %t1, %t4",
        "  %t6 = or i1 %t2, %t5",
        "",
        "L1:",
        "  %t7 = getelementptr inbounds %fort.span, ptr %s.in, i32 0, i32 0",
        "  %t8 = load ptr, ptr %t7, align 8",
        "  %t9 = getelementptr inbounds i8, ptr %t8, i64 %t0",
        "  %t10 = sub i64 %t1, %t0",
        "  %t11 = getelementptr inbounds %fort.span, ptr %ret.sret, i32 0, i32 0",
        "  store ptr %t9, ptr %t11, align 8",
        "  %t12 = getelementptr inbounds %fort.span, ptr %ret.sret, i32 0, i32 1",
        "  store i64 %t10, ptr %t12, align 8",
    };
    llvm_env.expect(&e, llvm_env.lowered(&e, HEADERS[..], "sub", pass_env.CHECKED), want[..]);
}

// `alloc<i32>(const u64 1)` calls `std.rt.alloc` with the size, the count and the location of
// the `new` (toolchain.md 6 item 17); the `move` of its register prints no zeroing. `new(u8, n)`
// widens the count, checks it, and writes the header member by member.
fn an_allocation_and_its_header() void {
    llvm_env.env mut e = llvm_env.env{};
    llvm_env.open(&e);
    defer llvm_env.close(&e);
    string[4] one = {
        "entry:",
        "  %result = alloca ptr, align 8",
        "  %t0 = call ptr @\"std.rt.alloc\"(i64 4, i64 1, ptr @.file.0, i32 18, i32 12)",
        "  store ptr %t0, ptr %result, align 8",
    };
    llvm_env.expect(&e, llvm_env.lowered(&e, HEADERS[..], "one", pass_env.CHECKED), one[..]);
    // the size of `pair` is 16 and its alignment 8: `std.rt.alloc` takes the size
    string[4] onep = {
        "entry:",
        "  %result = alloca ptr, align 8",
        "  %t0 = call ptr @\"std.rt.alloc\"(i64 16, i64 1, ptr @.file.0, i32 34, i32 12)",
        "  store ptr %t0, ptr %result, align 8",
    };
    llvm_env.expect(&e, llvm_env.lowered(&e, HEADERS[..], "onep", pass_env.CHECKED), onep[..]);
    string[13] many = {
        "entry:",
        "  %n.0 = alloca i32, align 4",
        "  store i32 %n.in, ptr %n.0, align 4",
        "  %t0 = load i32, ptr %n.0, align 4",
        "  %t1 = sext i32 %t0 to i64",
        "  %t2 = icmp slt i64 %t1, 0",
        "",
        "L1:",
        "  %t3 = call ptr @\"std.rt.alloc\"(i64 1, i64 %t1, ptr @.file.0, i32 21, i32 12)",
        "  %t4 = getelementptr inbounds %fort.span, ptr %ret.sret, i32 0, i32 0",
        "  store ptr %t3, ptr %t4, align 8",
        "  %t5 = getelementptr inbounds %fort.span, ptr %ret.sret, i32 0, i32 1",
        "  store i64 %t1, ptr %t5, align 8",
    };
    llvm_env.expect(&e, llvm_env.lowered(&e, HEADERS[..], "many", pass_env.CHECKED), many[..]);
}

// A `string` constant writes `@.str.0` and its length into the header, and the zero of an
// aggregate is `llvm.memset`.
fn a_string_constant_and_an_aggregate_zero() void {
    llvm_env.env mut e = llvm_env.env{};
    llvm_env.open(&e);
    defer llvm_env.close(&e);
    string[5] text = {
        "entry:",
        "  %t0 = getelementptr inbounds %fort.span, ptr %ret.sret, i32 0, i32 0",
        "  store ptr @.str.0, ptr %t0, align 8",
        "  %t1 = getelementptr inbounds %fort.span, ptr %ret.sret, i32 0, i32 1",
        "  store i64 2, ptr %t1, align 8",
    };
    llvm_env.expect(&e, llvm_env.lowered(&e, HEADERS[..], "text", pass_env.CHECKED), text[..]);
    assert(e.g.strs.len == 1 && gen_text(&e, 0) == "hi");
    string[5] zero = {
        "entry:",
        "  %z.0 = alloca %struct.main.pair, align 8",
        "  call void @llvm.memset.p0.i64(ptr align 8 %z.0, i8 0, i64 16, i1 false)",
        "  call void @llvm.memcpy.p0.p0.i64(ptr align 8 %ret.sret, ptr align 8 %z.0, \\",
        "i64 16, i1 false)",
    };
    llvm_env.expect(&e, llvm_env.lowered(&e, HEADERS[..], "zero", pass_env.CHECKED), zero[..]);
}

// The text of string record `i` of the translator's emitter.
fn gen_text(llvm_env.env* e, u64 i) string {
    return e->g.strs.items[i].text;
}

// ---- aggregates ---------------------------------------------------------------------------------

string[31] AGGREGATES = {
    "struct pair {",
    "    i32 a;",
    "    u64 b;",
    "}",
    "struct outer {",
    "    pair inner;",
    "    i32[2] cells;",
    "}",
    "fn lit(i32 x) pair {",
    "    return pair{x, 9};",
    "}",
    "fn lit2() pair {",
    "    return pair{1, 2};",
    "}",
    "fn des(u64 v) pair {",
    "    return pair{.b = v};",
    "}",
    "fn arr(i32 x) i32[2] {",
    "    i32[2] v = {x, 3};",
    "    return v;",
    "}",
    "fn nest(pair p, i32 x) outer {",
    "    return outer{p, {x, x}};",
    "}",
    "fn swap(pair mut* p) void {",
    "    *p = pair{cast(p->b, i32), cast(p->a, u64)};",
    "}",
    "fn flag(bool c) bool[2] {",
    "    bool[2] v = {c, true};",
    "    return v;",
    "}",
};

// A literal of constants writes each field through its `getelementptr`. A member that is no
// constant is read before the first store (spec/fir.md 6), so its load comes before the
// `getelementptr` of its field.
fn a_literal_reads_every_member_first() void {
    llvm_env.env mut e = llvm_env.env{};
    llvm_env.open(&e);
    defer llvm_env.close(&e);
    string[5] lit2 = {
        "entry:",
        "  %t0 = getelementptr inbounds %struct.main.pair, ptr %ret.sret, i32 0, i32 0",
        "  store i32 1, ptr %t0, align 4",
        "  %t1 = getelementptr inbounds %struct.main.pair, ptr %ret.sret, i32 0, i32 1",
        "  store i64 2, ptr %t1, align 8",
    };
    llvm_env.expect(&e, llvm_env.lowered(&e, AGGREGATES[..], "lit2", pass_env.CHECKED), lit2[..]);
    string[8] lit = {
        "entry:",
        "  %x.0 = alloca i32, align 4",
        "  store i32 %x.in, ptr %x.0, align 4",
        "  %t0 = load i32, ptr %x.0, align 4",
        "  %t1 = getelementptr inbounds %struct.main.pair, ptr %ret.sret, i32 0, i32 0",
        "  store i32 %t0, ptr %t1, align 4",
        "  %t2 = getelementptr inbounds %struct.main.pair, ptr %ret.sret, i32 0, i32 1",
        "  store i64 9, ptr %t2, align 8",
    };
    llvm_env.expect(&e, llvm_env.lowered(&e, AGGREGATES[..], "lit", pass_env.CHECKED), lit[..]);
    // a designated literal is `aggregate zeroed`: its member is read first, then the memset of
    // the whole value zeroes the field that it leaves out and the padding, then the named field
    string[7] des = {
        "entry:",
        "  %v.0 = alloca i64, align 8",
        "  store i64 %v.in, ptr %v.0, align 8",
        "  %t0 = load i64, ptr %v.0, align 8",
        "  call void @llvm.memset.p0.i64(ptr align 8 %ret.sret, i8 0, i64 16, i1 false)",
        "  %t1 = getelementptr inbounds %struct.main.pair, ptr %ret.sret, i32 0, i32 1",
        "  store i64 %t0, ptr %t1, align 8",
    };
    llvm_env.expect(&e, llvm_env.lowered(&e, AGGREGATES[..], "des", pass_env.CHECKED), des[..]);
    // an array literal writes each element through the array shape
    string[11] arr = {
        "entry:",
        "  %x.0 = alloca i32, align 4",
        "  %v.1 = alloca [2 x i32], align 4",
        "  store i32 %x.in, ptr %x.0, align 4",
        "  %t0 = load i32, ptr %x.0, align 4",
        "  %t1 = getelementptr inbounds [2 x i32], ptr %v.1, i64 0, i64 0",
        "  store i32 %t0, ptr %t1, align 4",
        "  %t2 = getelementptr inbounds [2 x i32], ptr %v.1, i64 0, i64 1",
        "  store i32 3, ptr %t2, align 4",
        "  call void @llvm.memcpy.p0.p0.i64(ptr align 4 %ret.sret, ptr align 4 %v.1, \\",
        "i64 8, i1 false)",
    };
    llvm_env.expect(&e, llvm_env.lowered(&e, AGGREGATES[..], "arr", pass_env.CHECKED), arr[..]);
    // a `bool` element stores through `zext`
    string[15] flag = {
        "entry:",
        "  %c.0 = alloca i8, align 1",
        "  %v.1 = alloca [2 x i8], align 1",
        "  %t0 = zext i1 %c.in to i8",
        "  store i8 %t0, ptr %c.0, align 1",
        "  %t1 = load i8, ptr %c.0, align 1",
        "  %t2 = trunc i8 %t1 to i1",
        "  %t3 = getelementptr inbounds [2 x i8], ptr %v.1, i64 0, i64 0",
        "  %t4 = zext i1 %t2 to i8",
        "  store i8 %t4, ptr %t3, align 1",
        "  %t5 = getelementptr inbounds [2 x i8], ptr %v.1, i64 0, i64 1",
        "  %t6 = zext i1 true to i8",
        "  store i8 %t6, ptr %t5, align 1",
        "  call void @llvm.memcpy.p0.p0.i64(ptr align 1 %ret.sret, ptr align 1 %v.1, \\",
        "i64 2, i1 false)",
    };
    llvm_env.expect(&e, llvm_env.lowered(&e, AGGREGATES[..], "flag", pass_env.CHECKED), flag[..]);
}

// An aggregate member that is no temporary is copied into a new `%tmp` slot before the first
// store (spec/fir.md 12.1); a temporary is a `%tmp` slot already, and it is copied from in place.
fn an_aggregate_member_goes_through_a_slot() void {
    llvm_env.env mut e = llvm_env.env{};
    llvm_env.open(&e);
    defer llvm_env.close(&e);
    string[19] want = {
        "entry:",
        "  %x.1 = alloca i32, align 4",
        "  %tmp0 = alloca [2 x i32], align 4",
        "  %tmp1 = alloca %struct.main.pair, align 8",
        "  store i32 %x.in, ptr %x.1, align 4",
        "  %t0 = load i32, ptr %x.1, align 4",
        "  %t1 = load i32, ptr %x.1, align 4",
        "  %t2 = getelementptr inbounds [2 x i32], ptr %tmp0, i64 0, i64 0",
        "  store i32 %t0, ptr %t2, align 4",
        "  %t3 = getelementptr inbounds [2 x i32], ptr %tmp0, i64 0, i64 1",
        "  store i32 %t1, ptr %t3, align 4",
        "  call void @llvm.memcpy.p0.p0.i64(ptr align 8 %tmp1, ptr align 8 %p.in, \\",
        "i64 16, i1 false)",
        "  %t4 = getelementptr inbounds %struct.main.outer, ptr %ret.sret, i32 0, i32 0",
        "  call void @llvm.memcpy.p0.p0.i64(ptr align 8 %t4, ptr align 8 %tmp1, \\",
        "i64 16, i1 false)",
        "  %t5 = getelementptr inbounds %struct.main.outer, ptr %ret.sret, i32 0, i32 1",
        "  call void @llvm.memcpy.p0.p0.i64(ptr align 4 %t5, ptr align 4 %tmp0, \\",
        "i64 8, i1 false)",
    };
    llvm_env.expect(&e, llvm_env.lowered(&e, AGGREGATES[..], "nest", pass_env.CHECKED), want[..]);
}

// `*p = pair{p->b, p->a}` reads both members before it writes the first field, so it swaps: an
// aggregate literal reads every member before the destination changes (D6.3, spec/fir.md 6).
fn a_literal_that_reads_its_destination_swaps() void {
    llvm_env.env mut e = llvm_env.env{};
    llvm_env.open(&e);
    defer llvm_env.close(&e);
    string[16] want = {
        "entry:",
        "  %p.0 = alloca ptr, align 8",
        "  store ptr %p.in, ptr %p.0, align 8",
        "  %t0 = load ptr, ptr %p.0, align 8",
        "  %t1 = getelementptr inbounds %struct.main.pair, ptr %t0, i32 0, i32 1",
        "  %t2 = load i64, ptr %t1, align 8",
        "  %t3 = trunc i64 %t2 to i32",
        "  %t4 = load ptr, ptr %p.0, align 8",
        "  %t5 = getelementptr inbounds %struct.main.pair, ptr %t4, i32 0, i32 0",
        "  %t6 = load i32, ptr %t5, align 4",
        "  %t7 = sext i32 %t6 to i64",
        "  %t8 = load ptr, ptr %p.0, align 8",
        "  %t9 = getelementptr inbounds %struct.main.pair, ptr %t8, i32 0, i32 0",
        "  store i32 %t3, ptr %t9, align 4",
        "  %t10 = getelementptr inbounds %struct.main.pair, ptr %t8, i32 0, i32 1",
        "  store i64 %t7, ptr %t10, align 8",
    };
    llvm_env.expect(&e, llvm_env.lowered(&e, AGGREGATES[..], "swap", pass_env.CHECKED), want[..]);
}

// A member of aggregate type that reads the destination goes into a `%tmp` slot before the
// first store (spec/fir.md 12.1), so `*t = twin{t->y, t->x}` swaps the two halves: an aggregate
// literal reads every member before the destination changes (D6.3).
string[14] TWINS = {
    "struct pair {",
    "    i32 a;",
    "    u64 b;",
    "}",
    "struct twin {",
    "    pair x;",
    "    pair y;",
    "}",
    "fn turn(twin mut* t) void {",
    "    *t = twin{t->y, t->x};",
    "}",
    "fn flip(i32[2] mut* a) void {",
    "    *a = i32[2]{(*a)[1], (*a)[0]};",
    "}",
};

fn an_aggregate_member_that_reads_its_destination_swaps() void {
    llvm_env.env mut e = llvm_env.env{};
    llvm_env.open(&e);
    defer llvm_env.close(&e);
    string[20] turn = {
        "entry:",
        "  %t.0 = alloca ptr, align 8",
        "  %tmp0 = alloca %struct.main.pair, align 8",
        "  %tmp1 = alloca %struct.main.pair, align 8",
        "  store ptr %t.in, ptr %t.0, align 8",
        "  %t0 = load ptr, ptr %t.0, align 8",
        "  %t1 = getelementptr inbounds %struct.main.twin, ptr %t0, i32 0, i32 1",
        "  call void @llvm.memcpy.p0.p0.i64(ptr align 8 %tmp0, ptr align 8 %t1, \\",
        "i64 16, i1 false)",
        "  %t2 = load ptr, ptr %t.0, align 8",
        "  %t3 = getelementptr inbounds %struct.main.twin, ptr %t2, i32 0, i32 0",
        "  call void @llvm.memcpy.p0.p0.i64(ptr align 8 %tmp1, ptr align 8 %t3, \\",
        "i64 16, i1 false)",
        "  %t4 = load ptr, ptr %t.0, align 8",
        "  %t5 = getelementptr inbounds %struct.main.twin, ptr %t4, i32 0, i32 0",
        "  call void @llvm.memcpy.p0.p0.i64(ptr align 8 %t5, ptr align 8 %tmp0, \\",
        "i64 16, i1 false)",
        "  %t6 = getelementptr inbounds %struct.main.twin, ptr %t4, i32 0, i32 1",
        "  call void @llvm.memcpy.p0.p0.i64(ptr align 8 %t6, ptr align 8 %tmp1, \\",
        "i64 16, i1 false)",
    };
    llvm_env.expect(&e, llvm_env.lowered(&e, TWINS[..], "turn", pass_env.CHECKED), turn[..]);
}

// `*a = i32[2]{(*a)[1], (*a)[0]}`: the two bounds checks, then both loads, then both stores.
// The right side holds no writer, so target_place (src/fort/fir_lower.ft) holds no address of
// `*a`, and the later load of `a` reads the pointer that the members read (D6.3).
fn an_array_literal_that_reads_its_destination_swaps() void {
    llvm_env.env mut e = llvm_env.env{};
    llvm_env.open(&e);
    defer llvm_env.close(&e);
    string[22] flip = {
        "entry:",
        "  %a.0 = alloca ptr, align 8",
        "  store ptr %a.in, ptr %a.0, align 8",
        "  %t0 = sext i32 1 to i64",
        "  %t1 = icmp uge i64 %t0, 2",
        "",
        "L1:",
        "  %t2 = sext i32 0 to i64",
        "  %t3 = icmp uge i64 %t2, 2",
        "",
        "L2:",
        "  %t4 = load ptr, ptr %a.0, align 8",
        "  %t5 = getelementptr inbounds [2 x i32], ptr %t4, i64 0, i64 %t0",
        "  %t6 = load i32, ptr %t5, align 4",
        "  %t7 = load ptr, ptr %a.0, align 8",
        "  %t8 = getelementptr inbounds [2 x i32], ptr %t7, i64 0, i64 %t2",
        "  %t9 = load i32, ptr %t8, align 4",
        "  %t10 = load ptr, ptr %a.0, align 8",
        "  %t11 = getelementptr inbounds [2 x i32], ptr %t10, i64 0, i64 0",
        "  store i32 %t6, ptr %t11, align 4",
        "  %t12 = getelementptr inbounds [2 x i32], ptr %t10, i64 0, i64 1",
        "  store i32 %t9, ptr %t12, align 4",
    };
    llvm_env.expect(&e, llvm_env.lowered(&e, TWINS[..], "flip", pass_env.CHECKED), flip[..]);
}

fn main() i32 {
    a_checked_add_writes_the_intrinsic_once();
    the_intrinsic_follows_the_signedness_and_the_width();
    division_by_signedness();
    the_unsigned_intrinsics();
    the_other_divisions();
    the_bitwise_operations();
    the_shifts();
    float_arithmetic();
    println("arithmetic ok");
    only_the_same_operation_in_the_continuation_reuses();
    println("reuse ok");
    integer_comparisons_by_signedness();
    float_and_pointer_comparisons();
    every_predicate();
    println("comparisons ok");
    each_cast_prints_the_instruction_of_its_types();
    println("casts ok");
    an_address_prints_no_load();
    a_slice_of_a_fixed_array();
    a_slice_of_a_span();
    a_slice_of_a_pointer();
    a_slice_of_a_string();
    an_allocation_and_its_header();
    a_string_constant_and_an_aggregate_zero();
    println("headers ok");
    a_literal_reads_every_member_first();
    an_aggregate_member_goes_through_a_slot();
    a_literal_that_reads_its_destination_swaps();
    an_aggregate_member_that_reads_its_destination_swaps();
    an_array_literal_that_reads_its_destination_swaps();
    println("aggregates ok");
    return 0;
}
