//! run
//! flags: -I ../../src/fort -I support -I ../../src
//! abort
//! stderr: panic: docs.at: index out of range
//! stdout:
//| the documents that are open ok
import lsp.docs;

/// docs.at takes an index below the count of open documents. One at or past it
/// is a violated precondition and panics. An empty store has no index at all,
/// and a document that was closed takes its index with it.
fn main() i32 {
    docs.store mut s = docs.create();
    defer docs.free(&s);
    docs.open(&s, "file:///a.ft", "a", 1);
    docs.open(&s, "file:///b.ft", "b", 1);
    assert(docs.at(&s, 0)->text == "a");
    assert(docs.at(&s, 1)->text == "b");
    assert(docs.close(&s, "file:///b.ft"));
    println("the documents that are open ok");
    println(docs.at(&s, 1)->text);
    return 0;
}
