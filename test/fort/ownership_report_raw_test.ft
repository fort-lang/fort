//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| rendering ok
//| interleaving ok
//| document ok
//| render refusal ok
//| reasons ok
//| unnamed ok
//| budget error ok
//| raw reason ok
//| mixed records ok
//| record ties ok
//| reason order ok
//| checked addition ok
/// Checks how the report carries the raw analysis: its diagnostics in toolchain 4.2 order, its
/// row and ledger in report version 5, and the analysis order of reasons.
import diag;
import ownership_api;
import ownership_keys;
import ownership_report;
import ownership_source;
import ownership_source_env;
import ownership_source_local;
import std.str;
import std.strbuf;

string WINDOW = "typed access exceeds its inherited window";
// The same reason under "cannot prove": possible wording (toolchain 4.2).
string WINDOW_MAYBE = "typed access window remains unproved";

fn open_program(ownership_source_env.env mut* e, string@ lines) void {
    ownership_source_env.open(e);
    ownership_source_env.runtime(e);
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    u64 mut i = 0;
    while (i < lines.len) {
        strbuf.append(&text, lines[i]);
        strbuf.push(&text, '\n');
        i += 1;
    }
    assert(ownership_source_env.prepare(e, strbuf.view(&text)));
    ownership_source.analyze(&e->source);
}

// The null branch sets r after the address of tag, so the two paths into `*s` disagree and
// the local run validates no null access there.
string[9] MIXED = {
    "fn mixed(bool c) u64 {",
    "    u8 tag = 1;",
    "    u8* mut r = &tag;",
    "    if (c) { r = null; }",
    "    u64* s = cast(r, u64*);",
    "    u64 a = *s;",
    "    u64* w = cast(&tag, u64*);",
    "    return a +% *w;",
    "}",
};

// A raw failure without a witness renders as "cannot prove", a validated one as an invalid
// use. Each has the kernel reason as its note, and the closure reason follows them.
fn rendering() void {
    ownership_source_env.env mut e = ownership_source_env.env{};
    open_program(&e, MIXED[..]);
    defer ownership_source_env.close(&e);
    diag.sink mut found = diag.sink{};
    defer diag.free(&found);
    ownership_report.diagnose(&e.source, &found, "main.ft");
    assert(diag.count(&found) == 3 && diag.record_count(&found) == 5);
    assert(diag.record_at(&found, 0).msg ==
        "cannot prove that 's' designates the accessed storage");
    assert(diag.record_at(&found, 0).loc.line == 6);
    assert(diag.record_at(&found, 1).msg == WINDOW_MAYBE);
    assert(diag.record_at(&found, 2).msg == "invalid use of 'w'");
    assert(diag.record_at(&found, 2).loc.line == 8);
    assert(diag.record_at(&found, 3).msg == WINDOW);
    assert(str.find(diag.record_at(&found, 4).msg, "ownership proof is incomplete") == 0);
    println("rendering ok");
}

// Local and raw records of one body merge in source order. The local flow stops a path at its
// first failure, so the local use of 'q' comes before the raw access through 'w'.
fn interleaving() void {
    ownership_source_env.env mut e = ownership_source_env.env{};
    string[9] lines = {
        "fn both() u64 {",
        "    i32 mut* own p = new(i32);",
        "    i32* q = p;",
        "    del(p);",
        "    u64 a = cast(*q, u64);",
        "    u8 tag = 1;",
        "    u64* w = cast(&tag, u64*);",
        "    return a +% *w;",
        "}",
    };
    open_program(&e, lines[..]);
    defer ownership_source_env.close(&e);
    diag.sink mut found = diag.sink{};
    defer diag.free(&found);
    ownership_report.diagnose(&e.source, &found, "main.ft");
    assert(diag.count(&found) == 3 && diag.record_count(&found) == 5);
    assert(diag.record_at(&found, 0).msg == "invalid use of 'q'");
    assert(diag.record_at(&found, 0).loc.line == 5);
    assert(diag.record_at(&found, 1).msg == "reference source is no longer live");
    assert(diag.record_at(&found, 2).msg == "invalid use of 'w'");
    assert(diag.record_at(&found, 2).loc.line == 8);
    assert(diag.record_at(&found, 3).msg == WINDOW);
    println("interleaving ok");
}

fn contains(strbuf.str_buf* out, string text) void {
    if (str.find(strbuf.view(out), text) < 0) {
        eprintln("missing: ", text);
        assert(false);
    }
}

// Version 4 integrates the raw analysis. Each verified body has one raw ledger with the FIR
// size of its service ledger, and the totals count raw violations.
fn document() void {
    ownership_source_env.env mut e = ownership_source_env.env{};
    open_program(&e, MIXED[..]);
    defer ownership_source_env.close(&e);
    ownership_source.body* row = ownership_source_env.find(&e, "main", "mixed");
    assert(ownership_report.analysis_status(row, ownership_report.RAW, 0) == "complete");
    assert(ownership_report.analysis_status(row, ownership_report.RAW, 1) == "complete");
    assert(ownership_report.analysis_status(row, ownership_report.RAW, 2) == "violated");
    assert(ownership_report.analysis_violations(row, ownership_report.RAW) == 1);
    assert(ownership_report.body_violations(row) == 1);
    assert(ownership_report.body_ownership(row) == "violated");
    assert(ownership_report.integrated(ownership_report.RAW));
    assert(ownership_report.integrated(ownership_report.STORED_BORROWS));
    assert(!ownership_report.integrated(ownership_report.RAW + 1));
    strbuf.str_buf mut out = strbuf.create();
    defer strbuf.free(&out);
    ownership_report.invocation call = ownership_report.invocation{};
    ownership_report.build(&out, &e.source, &call, 1);
    contains(&out, "{\"kind\":\"fort-ownership-report\",\"version\":6,");
    contains(&out, "{\"name\":\"raw\",\"producer\":\"integrated\",\"status\":\"incomplete\"}");
    contains(&out, "{\"name\":\"stored_borrows\",\"producer\":\"integrated\"");
    contains(&out, "{\"name\":\"calls_heap\",\"producer\":\"unavailable\"");
    strbuf.str_buf mut expected = strbuf.create();
    defer strbuf.free(&expected);
    strbuf.append(&expected, "\"name\":\"raw\",\"owner\":{\"module\":");
    contains(&out, strbuf.view(&expected));
    strbuf.clear(&expected);
    strbuf.append(&expected, "\"name\":\"raw\",\"correspondence\":\"complete\",");
    strbuf.append(&expected, "\"solver\":\"complete\",\"proof\":\"violated\",\"violations\":1}");
    contains(&out, strbuf.view(&expected));
    assert(row->raw.fir_size == row->live.fir_size);
    println("document ok");
}

// Rendering charges two V units for each record of the raw ledger. A refused charge keeps
// one terminal error and stops the later records.
fn render_refusal() void {
    ownership_source_env.env mut e = ownership_source_env.env{};
    open_program(&e, MIXED[..]);
    defer ownership_source_env.close(&e);
    ownership_source.body mut* row = ownership_source_env.find(&e, "main", "mixed");
    row->raw.meter.bounds.v = row->raw.meter.used.v + 3;
    diag.sink mut found = diag.sink{};
    defer diag.free(&found);
    ownership_report.diagnose(&e.source, &found, "main.ft");
    assert(diag.count(&found) == 2 && diag.record_count(&found) == 3);
    assert(diag.record_at(&found, 0).loc.line == 6);
    assert(str.find(diag.record_at(&found, 2).msg,
        "cannot prove complete ownership reporting within the report bound ") == 0);
    assert(row->raw.first_refusal.terminal.reason ==
        ownership_api.incomplete_reason.report_limit);
    println("render refusal ok");
}

// The body reason follows analysis order: local, stored borrows, raw, then the first analysis
// without a producer. A violated raw row gives no reason, so the reason names calls_heap.
fn reasons() void {
    ownership_source_env.env mut e = ownership_source_env.env{};
    string[6] lines = {
        "fn static_bytes() u64 {",
        "    string s = \"ab\";",
        "    char* p = s.ptr;",
        "    u64* w = cast(p, u64*);",
        "    return *w;",
        "}",
    };
    open_program(&e, lines[..]);
    defer ownership_source_env.close(&e);
    ownership_source.body mut* row = ownership_source_env.find(&e, "main", "static_bytes");
    row->first_incomplete = ownership_api.proof_status{};
    assert(ownership_report.analysis_status(row, ownership_report.LOCAL, 2) == "complete");
    assert(ownership_report.analysis_status(row, ownership_report.STORED_BORROWS, 2) ==
        "complete");
    assert(ownership_report.analysis_status(row, ownership_report.RAW, 2) == "violated");
    ownership_report.reason why = ownership_report.body_reason(row);
    assert(why.present && why.stage == "calls_heap" && why.code == "missing_producer");
    assert(ownership_report.closure_status(&e.source, ownership_report.RAW) == "incomplete");
    println("reasons ok");
}

// A reference with no source name renders as "a temporary value", without quotes, in both
// forms of the record. The null branch comes after the address, as in MIXED.
fn unnamed() void {
    ownership_source_env.env mut e = ownership_source_env.env{};
    string[10] lines = {
        "fn temporary() u64 {",
        "    u8 tag = 1;",
        "    return *cast(&tag, u64*);",
        "}",
        "fn temporary_unproved(bool c) u64 {",
        "    u8 tag = 1;",
        "    u8* mut r = &tag;",
        "    if (c) { r = null; }",
        "    return *cast(r, u64*);",
        "}",
    };
    open_program(&e, lines[..]);
    defer ownership_source_env.close(&e);
    diag.sink mut found = diag.sink{};
    defer diag.free(&found);
    ownership_report.diagnose(&e.source, &found, "main.ft");
    assert(diag.record_count(&found) >= 4);
    assert(diag.record_at(&found, 0).msg == "invalid use of a temporary value");
    assert(diag.record_at(&found, 0).loc.line == 3);
    assert(diag.record_at(&found, 1).msg == WINDOW);
    assert(diag.record_at(&found, 2).msg ==
        "cannot prove that a temporary value designates the accessed storage");
    assert(diag.record_at(&found, 2).loc.line == 9);
    assert(diag.record_at(&found, 3).msg == WINDOW_MAYBE);
    println("unnamed ok");
}

// A W refusal of the raw ledger renders one budget error (fir.md 14.1).
fn budget_error() void {
    ownership_source_env.env mut e = ownership_source_env.env{};
    ownership_source_env.open(&e);
    ownership_source_env.runtime(&e);
    defer ownership_source_env.close(&e);
    assert(ownership_source_env.prepare(&e,
        "fn wide() u64 {\n    u8 tag = 1;\n    u64* p = cast(&tag, u64*);\n    return *p;\n}\n"));
    ownership_source.body mut* row = ownership_source_env.find(&e, "main", "wide");
    row->raw.meter.bounds.w = 3;
    ownership_source.analyze(&e.source);
    assert(ownership_report.analysis_status(row, ownership_report.RAW, 0) == "complete");
    assert(ownership_report.analysis_status(row, ownership_report.RAW, 1) == "incomplete");
    assert(ownership_report.analysis_status(row, ownership_report.RAW, 2) == "incomplete");
    diag.sink mut found = diag.sink{};
    defer diag.free(&found);
    ownership_report.diagnose(&e.source, &found, "main.ft");
    bool mut seen = false;
    u64 mut i = 0;
    while (i < diag.record_count(&found)) {
        if (diag.record_at(&found, i).msg ==
            "ownership proof is incomplete (raw: work_limit; category W; used 3; bound 3)") {
            seen = true;
        }
        i += 1;
    }
    assert(seen);
    println("budget error ok");
}

// The raw row comes after the stored row. With the local and stored rows complete, an
// incomplete raw row gives the reason of the body.
fn raw_reason() void {
    ownership_source_env.env mut e = ownership_source_env.env{};
    ownership_source_env.open(&e);
    ownership_source_env.runtime(&e);
    defer ownership_source_env.close(&e);
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    strbuf.append(&text, "fn static_bytes() u64 {\n    string s = \"ab\";\n");
    strbuf.append(&text, "    char* p = s.ptr;\n    u64* w = cast(p, u64*);\n    return *w;\n}\n");
    assert(ownership_source_env.prepare(&e, strbuf.view(&text)));
    ownership_source.body mut* row = ownership_source_env.find(&e, "main", "static_bytes");
    row->raw.meter.bounds.w = 3;
    ownership_source.analyze(&e.source);
    row->first_incomplete = ownership_api.proof_status{};
    assert(ownership_report.analysis_status(row, ownership_report.LOCAL, 2) == "complete");
    assert(ownership_report.analysis_status(row, ownership_report.STORED_BORROWS, 2) ==
        "complete");
    assert(ownership_report.analysis_status(row, ownership_report.RAW, 2) == "incomplete");
    ownership_report.reason why = ownership_report.body_reason(row);
    assert(why.present && why.stage == "raw" && why.code == "work_limit");
    println("raw reason ok");
}

// One body has a local, a stored and a raw record, in that source order. The report renders
// each once and in that order. The stored run also reaches the use of 'a' and drops it,
// because the local run validated it (toolchain 1.1). The raw record has no witness, so the
// raw row is incomplete and gives the body reason after two violated rows. The null branch
// comes after the address, as in MIXED.
fn mixed_records() void {
    ownership_source_env.env mut e = ownership_source_env.env{};
    string[16] lines = {
        "struct box {",
        "    i32 mut* own ptr;",
        "}",
        "fn mixed(bool c) u64 {",
        "    i32 mut* own a = new(i32);",
        "    del(a);",
        "    i32 k = *a;",
        "    box mut value = {new(i32)};",
        "    value = box{new(i32)};",
        "    del(value.ptr);",
        "    u8 tag = 1;",
        "    u8* mut r = &tag;",
        "    if (c) { r = null; }",
        "    u64* s = cast(r, u64*);",
        "    return *s +% cast(k, u64);",
        "}",
    };
    open_program(&e, lines[..]);
    defer ownership_source_env.close(&e);
    diag.sink mut found = diag.sink{};
    defer diag.free(&found);
    ownership_report.diagnose(&e.source, &found, "main.ft");
    assert(diag.count(&found) == 4 && diag.record_count(&found) == 7);
    assert(diag.record_at(&found, 0).msg == "invalid use of 'a'");
    assert(diag.record_at(&found, 0).loc.line == 7);
    assert(diag.record_at(&found, 2).msg == "lost ownership of 'value.ptr'");
    assert(diag.record_at(&found, 2).loc.line == 9);
    assert(diag.record_at(&found, 4).msg ==
        "cannot prove that 's' designates the accessed storage");
    assert(diag.record_at(&found, 4).loc.line == 15);
    assert(diag.record_at(&found, 5).msg == WINDOW_MAYBE);
    assert(str.find(diag.record_at(&found, 6).msg, "ownership proof is incomplete") == 0);
    ownership_source.body mut* row = ownership_source_env.find(&e, "main", "mixed");
    assert(ownership_report.analysis_violations(row, ownership_report.LOCAL) == 1);
    assert(ownership_report.analysis_violations(row, ownership_report.STORED_BORROWS) == 1);
    assert(ownership_report.analysis_status(row, ownership_report.RAW, 2) == "incomplete");
    assert(ownership_report.body_violations(row) == 2);
    row->first_incomplete = ownership_api.proof_status{};
    ownership_report.reason why = ownership_report.body_reason(row);
    assert(why.present && why.stage == "raw" && why.code == "unknown_effect");
    assert(why.source.line == 15);
    println("mixed records ok");
}

fn tied(string name) ownership_source_local.violation mut@ own {
    ownership_source_local.violation mut@ own items = new(ownership_source_local.violation, 1);
    items[0] = ownership_source_local.violation{.source = ownership_api.source_position{0, 0, 3,
        5, 3, 9, true}, .kind = ownership_api.event_kind.invalid_use, .text = "same key",
        .name = name, .quoted = true, .leaf = ownership_source_local.WHOLE};
    return items;
}

// Six records with one key, one in each list, merge in list order: local, stored borrows,
// raw violations, raw failures without a witness, process-exit violations and process-exit
// failures without a witness (toolchain 4.2 gives no further key).
fn record_ties() void {
    ownership_source.body mut row = ownership_source.body{};
    row.local.solved = true;
    row.local.violations = tied("local");
    row.local.violations_len = 1;
    row.stored.solved = true;
    row.stored.violations = tied("stored");
    row.stored.violations_len = 1;
    row.raw.solved = true;
    row.raw.violations = tied("raw");
    row.raw.violations_len = 1;
    row.raw.unproved = tied("unproved");
    row.raw.unproved_len = 1;
    row.exit.solved = true;
    row.exit.violations = tied("exit");
    row.exit.violations_len = 1;
    row.exit.unproved = tied("exit unproved");
    row.exit.unproved_len = 1;
    defer del(row.local.violations);
    defer del(row.stored.violations);
    defer del(row.raw.violations);
    defer del(row.raw.unproved);
    defer del(row.exit.violations);
    defer del(row.exit.unproved);
    string[6] names = {"local", "stored", "raw", "unproved", "exit", "exit unproved"};
    u64[6] mut cursor = {0, 0, 0, 0, 0, 0};
    u64 mut list = 0;
    while (list < 6) {
        u64 mut from = 9;
        ownership_source_local.violation* v = ownership_report.next_record(&row, cursor[..],
            &from);
        assert(v != null && from == list && v->name == names[list]);
        cursor[from] += 1;
        list += 1;
    }
    u64 mut from = 9;
    assert(ownership_report.next_record(&row, cursor[..], &from) == null && from == 9);
    println("record ties ok");
}

// The body reason follows analysis order, not source order: with the stored and the raw rows
// incomplete, the stored reason comes first though the raw reason stands earlier.
fn reason_order() void {
    ownership_source.body mut row = ownership_source.body{};
    row.verification = ownership_source.status.complete;
    row.local.solved = true;
    row.local.proof = ownership_api.proof_status{.kind = ownership_api.proof_kind.complete};
    row.stored.solved = true;
    row.stored.proof = ownership_api.incomplete(ownership_api.incomplete_reason.missing_path,
        ownership_api.operation_position{}, ownership_api.source_position{0, 0, 4, 5, 4, 9,
        true});
    row.raw.solved = true;
    row.raw.proof = ownership_api.incomplete(ownership_api.incomplete_reason.unknown_effect,
        ownership_api.operation_position{}, ownership_api.source_position{0, 0, 2, 5, 2, 9,
        true});
    assert(ownership_report.analysis_status(&row, ownership_report.LOCAL, 2) == "complete");
    assert(ownership_report.analysis_status(&row, ownership_report.STORED_BORROWS, 2) ==
        "incomplete");
    assert(ownership_report.analysis_status(&row, ownership_report.RAW, 2) == "incomplete");
    ownership_report.reason why = ownership_report.body_reason(&row);
    assert(why.present && why.stage == "stored_borrows" && why.code == "missing_path");
    assert(why.source.line == 4);
    row.stored.proof = ownership_api.proof_status{.kind = ownership_api.proof_kind.complete};
    ownership_report.reason next = ownership_report.body_reason(&row);
    assert(next.present && next.stage == "raw" && next.code == "unknown_effect");
    println("reason order ok");
}

// A checked addition reads `*q` twice: in `add_overflows` and, after its overflow check, in
// `add`. These are two FIR operations with one source range. A witness reaches the first. The
// walk cannot decide the overflow check, so the second has no witness and is unproved.
// Toolchain 4.2 suppresses a dependent cascade only for the same operation, so both records
// render, in operation-key order.
fn checked_addition() void {
    ownership_source_env.env mut e = ownership_source_env.env{};
    string[10] lines = {
        "struct holder {",
        "    u8* p;",
        "}",
        "fn k() u8 {",
        "    u8 mut* own b = new(u8);",
        "    holder h = {b};",
        "    del(b);",
        "    u8* q = cast(cast(h.p, u64), u8*);",
        "    return *q + *h.p;",
        "}",
    };
    open_program(&e, lines[..]);
    defer ownership_source_env.close(&e);
    ownership_source.body* row = ownership_source_env.find(&e, "main", "k");
    assert(row->raw.violations_len == 1 && row->raw.unproved_len == 1);
    ownership_source_local.violation* first = &row->raw.violations[0];
    ownership_source_local.violation* second = &row->raw.unproved[0];
    assert(ownership_keys.source(first->source, second->source) == 0);
    assert(ownership_keys.operation(first->operation, second->operation) < 0);
    assert(ownership_keys.entity(first->relation, second->relation) == 0);
    assert(first->text == second->text);
    diag.sink mut found = diag.sink{};
    defer diag.free(&found);
    ownership_report.diagnose(&e.source, &found, "main.ft");
    assert(diag.count(&found) == 4 && diag.record_count(&found) == 7);
    assert(diag.record_at(&found, 0).msg == "invalid use of 'h.p'");
    assert(diag.record_at(&found, 0).loc.line == 8);
    assert(diag.record_at(&found, 2).msg == "invalid use of 'q'");
    assert(diag.record_at(&found, 2).loc.line == 9);
    assert(diag.record_at(&found, 4).msg ==
        "cannot prove that 'q' designates the accessed storage");
    assert(diag.record_at(&found, 4).loc.line == 9);
    assert(diag.record_at(&found, 4).loc.col == diag.record_at(&found, 2).loc.col);
    println("checked addition ok");
}

fn main() i32 {
    rendering();
    interleaving();
    document();
    render_refusal();
    reasons();
    unnamed();
    budget_error();
    raw_reason();
    mixed_records();
    record_ties();
    reason_order();
    checked_addition();
    return 0;
}
