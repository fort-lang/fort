//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: check.fold_untyped: folding an operator that is not arithmetic
//! stdout:
//| true
/// check_operands folds an untyped pair only for an arithmetic operator. A comparison takes
/// another path, so a call with `==` breaks the precondition and panics.
import check;
import check_env;
import consts;
import diag;
import lexer;

fn main() i32 {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    println(check_env.open_module(&e, check_env.src_main()));
    consts.cval mut out = consts.cval{};
    check.fold_untyped(&e.ck, diag.loc{}, cast(lexer.tok_kind.eq, i32), consts.cv_from_i64(1),
                       consts.cv_from_i64(2), &out);
    return 0;
}
