//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| while ok
//| do ok
//| for ok
//| for without a condition ok
//| exits ok
/// Checks the lowering of the loops to FIR (spec/fir.md 9.3): the blocks of `while`, `do ...
/// while` and `for` in the order that 9.3 names them, the targets of `break` and `continue` on the
/// stack of scopes (9.5), and the statement index of each part (9.7). Each case lowers one function
/// of a checked source, holds that the result keeps every rule of the verifier, and compares its
/// text.
import lower_env;

// ---- while ------------------------------------------------------------------------------------

// The blocks head, body and done. `break` goes to done and `continue` to head, each at its keyword
// with its own index; the `goto`s and the `switch` of the loop stand at the `while` with its index.
// The statement after `continue` starts a block that nothing names, and the end of the body goes
// back to head.
fn a_while_loop_has_a_head_a_body_and_a_done_block() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[10] source = {
        "fn f(bool c, i32 n) i32 {",
        "    while (c) {",
        "        if (n > 3) {",
        "            break;",
        "        }",
        "        continue;",
        "        i32 z = 1;",
        "    }",
        "    return n;",
        "}",
    };
    string[32] want = {
        "fn main.f(_1 (c): bool, _2 (n): i32) -> i32 {",
        "    let _0: i32;",
        "    let _3 (z): i32 #7:13;",
        "    let _4: bool #3:15;",
        "",
        "    bb0: {",
        "        goto bb1 #2:5 s1;",
        "    }",
        "    bb1: {",
        "        switch(copy _1) -> [true: bb2, otherwise: bb3] #2:5 s1;",
        "    }",
        "    bb2: {",
        "        _4 = gt(copy _2, const i32 3) #3:15 s2;",
        "        switch(copy _4) -> [true: bb4, otherwise: bb5] #3:9 s2;",
        "    }",
        "    bb3: {",
        "        _0 = copy _2 #9:12 s6;",
        "        return #9:5 s6;",
        "    }",
        "    bb4: {",
        "        goto bb3 #4:13 s3;",
        "    }",
        "    bb5: {",
        "        goto bb1 #6:9 s4;",
        "    }",
        "    bb6: {",
        "        live(_3) #7:13 s5;",
        "        _3 = const i32 1 #7:17 s5;",
        "        dead(_3) #8:5 s1;",
        "        goto bb1 #2:5 s1;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "f"), want[..]);
}

// `while (true)`: the checker folds the condition, so head ends in `switch(const true)`. Rule V9
// takes only its edge to body, so the `unreachable` at the end of a body with a result passes: D8.4
// counts a `while (true)` that no `break` leaves as a terminating statement.
fn a_while_true_loop_leaves_its_done_block_unreachable() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[7] source = {
        "fn forever(i32 n) i32 {",
        "    while (true) {",
        "        if (n > 0) {",
        "            return n;",
        "        }",
        "    }",
        "}",
    };
    string[25] want = {
        "fn main.forever(_1 (n): i32) -> i32 {",
        "    let _0: i32;",
        "    let _2: bool #3:15;",
        "",
        "    bb0: {",
        "        goto bb1 #2:5 s1;",
        "    }",
        "    bb1: {",
        "        switch(const true) -> [true: bb2, otherwise: bb3] #2:5 s1;",
        "    }",
        "    bb2: {",
        "        _2 = gt(copy _1, const i32 0) #3:15 s2;",
        "        switch(copy _2) -> [true: bb4, otherwise: bb5] #3:9 s2;",
        "    }",
        "    bb3: {",
        "        unreachable #7:1 s0;",
        "    }",
        "    bb4: {",
        "        _0 = copy _1 #4:20 s3;",
        "        return #4:13 s3;",
        "    }",
        "    bb5: {",
        "        goto bb1 #2:5 s1;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "forever"), want[..]);
}

// A condition that makes blocks: head, body and done are made before the condition, so they take
// bb1 to bb3, and the blocks of `&&` and of the bounds check take bb4 to bb6 (spec/fir.md 9.3).
// The `switch` of the loop ends the last block of the condition, and the check of `i += 1` in the
// body makes bb7.
fn a_condition_that_makes_blocks_follows_the_blocks_of_the_loop() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[7] source = {
        "fn scan(i32[4] a, i32 n) i32 {",
        "    i32 mut i = 0;",
        "    while (i < n && a[i] > 0) {",
        "        i += 1;",
        "    }",
        "    return i;",
        "}",
    };
    string[51] want = {
        "fn main.scan(_1 (a): i32[4], _2 (n): i32) -> i32 {",
        "    let _0: i32;",
        "    let _3 (i): i32 #2:13;",
        "    let _4: bool #3:18;",
        "    let _5: bool #3:14;",
        "    let _6: u64 #3:22;",
        "    let _7: bool #3:22;",
        "    let _8: i64 #3:22;",
        "    let _9: bool #3:26;",
        "    let _10: i32 #4:9;",
        "    let _11: bool #4:11;",
        "",
        "    bb0: {",
        "        live(_3) #2:13 s1;",
        "        _3 = const i32 0 #2:17 s1;",
        "        goto bb1 #3:5 s2;",
        "    }",
        "    bb1: {",
        "        _5 = lt(copy _3, copy _2) #3:14 s2;",
        "        _4 = copy _5 #3:14 s2;",
        "        switch(copy _4) -> [true: bb4, otherwise: bb5] #3:18 s2;",
        "    }",
        "    bb2: {",
        "        _10 = copy _3 #4:9 s3;",
        "        _11 = add_overflows(copy _10, const i32 1) #4:11 s3;",
        "        check(copy _11, overflow) -> bb7 #4:11 s3;",
        "    }",
        "    bb3: {",
        "        _0 = copy _3 #6:12 s4;",
        "        dead(_3) #6:5 s4;",
        "        return #6:5 s4;",
        "    }",
        "    bb4: {",
        "        _6 = cast<u64>(copy _3) #3:22 s2;",
        "        _7 = ge(copy _6, const u64 4) #3:22 s2;",
        "        _8 = cast<i64>(copy _6) #3:22 s2;",
        "        check(copy _7, bounds, copy _8, const u64 4) -> bb6 #3:22 s2;",
        "    }",
        "    bb5: {",
        "        switch(copy _4) -> [true: bb2, otherwise: bb3] #3:5 s2;",
        "    }",
        "    bb6: {",
        "        _9 = gt(copy _1[_6], const i32 0) #3:26 s2;",
        "        _4 = copy _9 #3:26 s2;",
        "        goto bb5 #3:18 s2;",
        "    }",
        "    bb7: {",
        "        _3 = add(copy _10, const i32 1) #4:11 s3;",
        "        goto bb1 #3:5 s2;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "scan"), want[..]);
}

// ---- do ... while -----------------------------------------------------------------------------

// The blocks body, test and done: `goto body` first, `break` to done, `continue` to test, the end
// of the body to test, and the condition in test, whose statements take the index of the `do`.
fn a_do_loop_has_a_body_a_test_and_a_done_block() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[11] source = {
        "fn g(bool c, bool d, i32 n) i32 {",
        "    do {",
        "        if (c) {",
        "            break;",
        "        }",
        "        if (d) {",
        "            continue;",
        "        }",
        "    } while (n < 10);",
        "    return n;",
        "}",
    };
    string[31] want = {
        "fn main.g(_1 (c): bool, _2 (d): bool, _3 (n): i32) -> i32 {",
        "    let _0: i32;",
        "    let _4: bool #9:16;",
        "",
        "    bb0: {",
        "        goto bb1 #2:5 s1;",
        "    }",
        "    bb1: {",
        "        switch(copy _1) -> [true: bb4, otherwise: bb5] #3:9 s2;",
        "    }",
        "    bb2: {",
        "        _4 = lt(copy _3, const i32 10) #9:16 s1;",
        "        switch(copy _4) -> [true: bb1, otherwise: bb3] #2:5 s1;",
        "    }",
        "    bb3: {",
        "        _0 = copy _3 #10:12 s6;",
        "        return #10:5 s6;",
        "    }",
        "    bb4: {",
        "        goto bb3 #4:13 s3;",
        "    }",
        "    bb5: {",
        "        switch(copy _2) -> [true: bb6, otherwise: bb7] #6:9 s4;",
        "    }",
        "    bb6: {",
        "        goto bb2 #7:13 s5;",
        "    }",
        "    bb7: {",
        "        goto bb2 #2:5 s1;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "g"), want[..]);
}

// ---- for ---------------------------------------------------------------------------------------

// The init in the current block with its own index, then the blocks head, body, step and done.
// `break` goes to done and `continue` to step. The walk meets the step after the body, so `i++`
// takes its index after the statements of the body, and its check makes the last block.
fn a_for_loop_has_a_head_a_body_a_step_and_a_done_block() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[13] source = {
        "fn h(i32 n) i32 {",
        "    i32 mut s = 0;",
        "    for (i32 mut i = 0; i < n; i++) {",
        "        if (i == 5) {",
        "            break;",
        "        }",
        "        if (i == 2) {",
        "            continue;",
        "        }",
        "        s = i;",
        "    }",
        "    return s;",
        "}",
    };
    string[55] want = {
        "fn main.h(_1 (n): i32) -> i32 {",
        "    let _0: i32;",
        "    let _2 (s): i32 #2:13;",
        "    let _3 (i): i32 #3:18;",
        "    let _4: bool #3:27;",
        "    let _5: bool #4:15;",
        "    let _6: bool #7:15;",
        "    let _7: i32 #3:32;",
        "    let _8: bool #3:33;",
        "",
        "    bb0: {",
        "        live(_2) #2:13 s1;",
        "        _2 = const i32 0 #2:17 s1;",
        "        live(_3) #3:18 s3;",
        "        _3 = const i32 0 #3:22 s3;",
        "        goto bb1 #3:5 s2;",
        "    }",
        "    bb1: {",
        "        _4 = lt(copy _3, copy _1) #3:27 s2;",
        "        switch(copy _4) -> [true: bb2, otherwise: bb4] #3:5 s2;",
        "    }",
        "    bb2: {",
        "        _5 = eq(copy _3, const i32 5) #4:15 s4;",
        "        switch(copy _5) -> [true: bb5, otherwise: bb6] #4:9 s4;",
        "    }",
        "    bb3: {",
        "        _7 = copy _3 #3:32 s9;",
        "        _8 = add_overflows(copy _7, const i32 1) #3:33 s9;",
        "        check(copy _8, overflow) -> bb9 #3:33 s9;",
        "    }",
        "    bb4: {",
        "        dead(_3) #11:5 s2;",
        "        _0 = copy _2 #12:12 s10;",
        "        dead(_2) #12:5 s10;",
        "        return #12:5 s10;",
        "    }",
        "    bb5: {",
        "        goto bb4 #5:13 s5;",
        "    }",
        "    bb6: {",
        "        _6 = eq(copy _3, const i32 2) #7:15 s6;",
        "        switch(copy _6) -> [true: bb7, otherwise: bb8] #7:9 s6;",
        "    }",
        "    bb7: {",
        "        goto bb3 #8:13 s7;",
        "    }",
        "    bb8: {",
        "        _2 = copy _3 #10:11 s8;",
        "        goto bb3 #3:5 s2;",
        "    }",
        "    bb9: {",
        "        _3 = add(copy _7, const i32 1) #3:33 s9;",
        "        goto bb1 #3:5 s2;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "h"), want[..]);
}

// The init runs before the blocks of the loop are made, so the continuation of its overflow check
// takes the number after the current block, and head, body, step and done follow it. The store of
// `i = n + 1` stands at its `+`, the location of the expression.
fn an_init_with_a_check_runs_before_the_blocks_of_the_loop() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[4] source = {
        "fn start(i32 n) void {",
        "    for (i32 mut i = n + 1; i < 9; ) {",
        "    }",
        "}",
    };
    string[32] want = {
        "fn main.start(_1 (n): i32) -> void {",
        "    let _0: void;",
        "    let _2 (i): i32 #2:18;",
        "    let _3: bool #2:24;",
        "    let _4: i32 #2:24;",
        "    let _5: bool #2:31;",
        "",
        "    bb0: {",
        "        live(_2) #2:18 s2;",
        "        _3 = add_overflows(copy _1, const i32 1) #2:24 s2;",
        "        check(copy _3, overflow) -> bb1 #2:24 s2;",
        "    }",
        "    bb1: {",
        "        _4 = add(copy _1, const i32 1) #2:24 s2;",
        "        _2 = copy _4 #2:24 s2;",
        "        goto bb2 #2:5 s1;",
        "    }",
        "    bb2: {",
        "        _5 = lt(copy _2, const i32 9) #2:31 s1;",
        "        switch(copy _5) -> [true: bb3, otherwise: bb5] #2:5 s1;",
        "    }",
        "    bb3: {",
        "        goto bb4 #2:5 s1;",
        "    }",
        "    bb4: {",
        "        goto bb2 #2:5 s1;",
        "    }",
        "    bb5: {",
        "        dead(_2) #3:5 s1;",
        "        return #4:1 s0;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "start"), want[..]);
}

// ---- for with an empty condition ---------------------------------------------------------------

// An empty condition is `goto body` in head (D7.5). With no step, step goes back to head, and done
// is reached only by the `break`.
fn an_empty_condition_goes_to_the_body() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[7] source = {
        "fn k(bool c) void {",
        "    for (;;) {",
        "        if (c) {",
        "            break;",
        "        }",
        "    }",
        "}",
    };
    string[25] want = {
        "fn main.k(_1 (c): bool) -> void {",
        "    let _0: void;",
        "",
        "    bb0: {",
        "        goto bb1 #2:5 s1;",
        "    }",
        "    bb1: {",
        "        goto bb2 #2:5 s1;",
        "    }",
        "    bb2: {",
        "        switch(copy _1) -> [true: bb5, otherwise: bb6] #3:9 s2;",
        "    }",
        "    bb3: {",
        "        goto bb1 #2:5 s1;",
        "    }",
        "    bb4: {",
        "        return #7:1 s0;",
        "    }",
        "    bb5: {",
        "        goto bb4 #4:13 s3;",
        "    }",
        "    bb6: {",
        "        goto bb3 #2:5 s1;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "k"), want[..]);
}

// An assignment as the init and a call as the step, each with its own index; the store of `k = n`
// stands at `n`. No `break` leaves the loop, so D8.4 counts it as terminating, and nothing reaches
// the `unreachable` in done.
fn an_empty_condition_with_an_assignment_and_a_call() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[10] source = {
        "fn tick() void {",
        "}",
        "fn m(i32 n) i32 {",
        "    i32 mut k = 0;",
        "    for (k = n; ; tick()) {",
        "        if (k > 9) {",
        "            return k;",
        "        }",
        "    }",
        "}",
    };
    string[36] want = {
        "fn main.m(_1 (n): i32) -> i32 {",
        "    let _0: i32;",
        "    let _2 (k): i32 #4:13;",
        "    let _3: bool #6:15;",
        "    let _4: void #5:23;",
        "",
        "    bb0: {",
        "        live(_2) #4:13 s1;",
        "        _2 = const i32 0 #4:17 s1;",
        "        _2 = copy _1 #5:12 s3;",
        "        goto bb1 #5:5 s2;",
        "    }",
        "    bb1: {",
        "        goto bb2 #5:5 s2;",
        "    }",
        "    bb2: {",
        "        _3 = gt(copy _2, const i32 9) #6:15 s4;",
        "        switch(copy _3) -> [true: bb5, otherwise: bb6] #6:9 s4;",
        "    }",
        "    bb3: {",
        "        _4 = call fn main.tick() #5:23 s6;",
        "        goto bb1 #5:5 s2;",
        "    }",
        "    bb4: {",
        "        dead(_2) #10:1 s0;",
        "        unreachable #10:1 s0;",
        "    }",
        "    bb5: {",
        "        _0 = copy _2 #7:20 s5;",
        "        dead(_2) #7:13 s5;",
        "        return #7:13 s5;",
        "    }",
        "    bb6: {",
        "        goto bb3 #5:5 s2;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "m"), want[..]);
}

// A call of a `noreturn` function in the init or in the step ends its block with `trap`, so no
// `goto head` follows it (D8.5, rule V8). head of the first loop is then reached from step alone.
fn a_noreturn_init_or_step_ends_its_block() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[10] source = {
        "fn stop() noreturn {",
        "    while (true) {",
        "    }",
        "}",
        "fn q(bool c) void {",
        "    for (stop(); c; ) {",
        "    }",
        "    for (; c; stop()) {",
        "    }",
        "}",
    };
    string[35] want = {
        "fn main.q(_1 (c): bool) -> void {",
        "    let _0: void;",
        "    let _2: void #6:14;",
        "    let _3: void #8:19;",
        "",
        "    bb0: {",
        "        _2 = call fn main.stop() #6:14 s2;",
        "        trap #6:14 s2;",
        "    }",
        "    bb1: {",
        "        switch(copy _1) -> [true: bb2, otherwise: bb4] #6:5 s1;",
        "    }",
        "    bb2: {",
        "        goto bb3 #6:5 s1;",
        "    }",
        "    bb3: {",
        "        goto bb1 #6:5 s1;",
        "    }",
        "    bb4: {",
        "        goto bb5 #8:5 s3;",
        "    }",
        "    bb5: {",
        "        switch(copy _1) -> [true: bb6, otherwise: bb8] #8:5 s3;",
        "    }",
        "    bb6: {",
        "        goto bb7 #8:5 s3;",
        "    }",
        "    bb7: {",
        "        _3 = call fn main.stop() #8:19 s4;",
        "        trap #8:19 s4;",
        "    }",
        "    bb8: {",
        "        return #10:1 s0;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "q"), want[..]);
}

// ---- exits --------------------------------------------------------------------------------------

// A `break` in an inner loop goes to the done of that loop, and a `continue` after it to the head
// of the outer one: the walk stops at the innermost scope of kind `loop` (spec/fir.md 9.5).
fn an_exit_stops_at_the_innermost_loop() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[8] source = {
        "fn nest(bool c, bool d) void {",
        "    while (c) {",
        "        while (d) {",
        "            break;",
        "        }",
        "        continue;",
        "    }",
        "}",
    };
    string[25] want = {
        "fn main.nest(_1 (c): bool, _2 (d): bool) -> void {",
        "    let _0: void;",
        "",
        "    bb0: {",
        "        goto bb1 #2:5 s1;",
        "    }",
        "    bb1: {",
        "        switch(copy _1) -> [true: bb2, otherwise: bb3] #2:5 s1;",
        "    }",
        "    bb2: {",
        "        goto bb4 #3:9 s2;",
        "    }",
        "    bb3: {",
        "        return #8:1 s0;",
        "    }",
        "    bb4: {",
        "        switch(copy _2) -> [true: bb5, otherwise: bb6] #3:9 s2;",
        "    }",
        "    bb5: {",
        "        goto bb6 #4:13 s3;",
        "    }",
        "    bb6: {",
        "        goto bb1 #6:9 s4;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "nest"), want[..]);
}

// An exit inside the arms of an `if` and inside a statement `$if` walks past their scopes of kind
// `block` to the loop. The `$if` takes no index, so the `if` inside it takes the next one.
fn an_exit_walks_past_blocks_and_branches() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[11] source = {
        "fn sel(bool c, bool d) void {",
        "    while (c) {",
        "        $if (true) {",
        "            if (d) {",
        "                continue;",
        "            } else {",
        "                break;",
        "            }",
        "        }",
        "    }",
        "}",
    };
    string[25] want = {
        "fn main.sel(_1 (c): bool, _2 (d): bool) -> void {",
        "    let _0: void;",
        "",
        "    bb0: {",
        "        goto bb1 #2:5 s1;",
        "    }",
        "    bb1: {",
        "        switch(copy _1) -> [true: bb2, otherwise: bb3] #2:5 s1;",
        "    }",
        "    bb2: {",
        "        switch(copy _2) -> [true: bb4, otherwise: bb5] #4:13 s2;",
        "    }",
        "    bb3: {",
        "        return #11:1 s0;",
        "    }",
        "    bb4: {",
        "        goto bb1 #5:17 s3;",
        "    }",
        "    bb5: {",
        "        goto bb3 #7:17 s4;",
        "    }",
        "    bb6: {",
        "        goto bb1 #2:5 s1;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "sel"), want[..]);
}

fn main() i32 {
    a_while_loop_has_a_head_a_body_and_a_done_block();
    a_while_true_loop_leaves_its_done_block_unreachable();
    a_condition_that_makes_blocks_follows_the_blocks_of_the_loop();
    println("while ok");
    a_do_loop_has_a_body_a_test_and_a_done_block();
    println("do ok");
    a_for_loop_has_a_head_a_body_a_step_and_a_done_block();
    an_init_with_a_check_runs_before_the_blocks_of_the_loop();
    println("for ok");
    an_empty_condition_goes_to_the_body();
    an_empty_condition_with_an_assignment_and_a_call();
    a_noreturn_init_or_step_ends_its_block();
    println("for without a condition ok");
    an_exit_stops_at_the_innermost_loop();
    an_exit_walks_past_blocks_and_branches();
    println("exits ok");
    return 0;
}
