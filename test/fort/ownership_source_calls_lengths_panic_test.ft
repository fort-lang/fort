//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: ownership_source_calls: a body has no file or no declaration
//! stdout:
//| 1
/// Checks that a solve with fewer file bindings than graph bodies panics.
import ownership_source_calls;
import ownership_source_calls_env;

fn main() i32 {
    string[2] text = {"fn noop() void {}", "fn calls_noop() void { noop(); }"};
    string[2] names = {"noop", "calls_noop"};
    ownership_source_calls_env.closure mut c = ownership_source_calls_env.closure{};
    ownership_source_calls_env.lower(&c, text[..], names[..]);
    ownership_source_calls_env.build(&c, 0);
    println(1);
    ownership_source_calls.solve(&c.calls, &c.graph, c.files[..1], c.declarations[..]);
    return 0;
}
