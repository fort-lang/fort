//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: ownership_source_calls: a body has no file or no declaration
//! stdout:
//| 1
/// solve reads one source file and one declaration for each body of the graph. A graph with
/// one body and no file breaks that precondition, so solve panics before it runs a solver.
import ownership_api;
import ownership_flow;
import ownership_graph;
import ownership_source_calls;

fn main() i32 {
    ownership_source_calls.context mut c = ownership_source_calls.context{};
    ownership_graph.body_input[1] bodies = {ownership_graph.body_input{}};
    ownership_graph.graph mut g = ownership_graph.graph{.bodies = bodies[..]};
    println(g.bodies.len);
    ownership_flow.source_file_binding@ files = {};
    ownership_api.source_position[1] declarations = {ownership_api.source_position{}};
    ownership_source_calls.solve(&c, &g, files, declarations[..]);
    return 0;
}
