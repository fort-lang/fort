//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| exit paths ok
//| store paths ok
//| releases ok
//| addresses ok
/// Holds the boundary cases of the process-exit producer: joined paths, releases with owned
/// descendants, and addresses of owning globals (D17.16, D17.19).
import ownership_exit_source_env as env;
import ownership_source_exit;

// A state that holds EMPTY and LIVE without SYMBOLIC has only facts of this body: the
// obligation stays declared and unproved. LIVE alone with a witness is lost ownership. The line
// of each case is its line in `lines`, from 1. This closure has no user global, so the exit
// calls need only the frame owners and the runtime owner.
fn exit_paths() void {
    env.closure mut c = env.closure{};
    string[13] lines = {
        "import std.libc;",
        "fn joined(bool b) void {",
        "    u8 mut@ own p = new(u8, 1);",
        "    if (b) { del(p); }",
        "    libc.exit(0);",
        "}",
        "fn looped(u64 n) void {",
        "    u8 mut@ own p = new(u8, 1);",
        "    u64 mut i = 0;",
        "    while (i < n) { i += 1; }",
        "    libc.exit(0);",
        "}",
        "fn main() i32 { return 0; }",
    };
    env.open(&c, lines[..]);
    defer env.close(&c);
    // The runtime owner stays unproved at each direct exit too: it sorts after `p` here.
    env.unproved(&c, "joined", "p", ownership_source_exit.EXIT_UNPROVED, 5);
    assert(env.body(&c, "joined")->unproved_len == 2);
    // The walk leaves the loop at its first test, so a path reaches the exit call.
    env.violation(&c, "looped", "p", ownership_source_exit.EXIT_LOST, 11);
    env.finish(&c, "exit paths ok");
}

fn store_paths() void {
    env.closure mut c = env.closure{};
    string[11] lines = {
        "u8 mut@ own mut pool = {};",
        "fn store_joined(bool b) void {",
        "    del(pool);",
        "    if (b) { pool = new(u8, 1); }",
        "    pool = new(u8, 2);",
        "}",
        "fn emptied() void {",
        "    del(pool);",
        "    u8 mut@ own e = {}; pool = move(e);",
        "}",
        "fn main() i32 { return 0; }",
    };
    env.open(&c, lines[..]);
    defer env.close(&c);
    env.unproved(&c, "store_joined", "pool", ownership_source_exit.STORE_UNPROVED, 5);
    // A store of an empty local leaves the owner empty: the value follows the local.
    env.proved(&c, "emptied");
    assert(env.empties(&c, "main", "emptied", "pool"));
    env.finish(&c, "store paths ok");
}

// Shallow del of an owning global needs each owned descendant empty: only heap facts prove it
// (D17.9, D17.16). A string or a span of borrowed elements holds no owned descendant.
fn releases() void {
    env.closure mut c = env.closure{};
    string[11] lines = {
        "struct node { node mut* own next; u64 value; }",
        "node mut* own mut head = null;",
        "string mut@ own mut names = {};",
        "u8 mut* own mut byte = null;",
        "fn drop_head() void {",
        "    del(head);",
        "}",
        "fn drop_names() void { del(names); }",
        "fn drop_byte() void { del(byte); }",
        "fn pop() node mut* own { return move(head); }",
        "fn none() void {}",
    };
    env.open(&c, lines[..]);
    defer env.close(&c);
    env.outside(&c, "drop_head", ownership_source_exit.missing.owned_descendants, 6);
    env.proved(&c, "drop_names");
    env.proved(&c, "drop_byte");
    env.proved(&c, "pop");
    assert(env.body(&c, "pop")->global_moves == 1);
    assert(env.body(&c, "drop_head")->global_releases == 1);
    env.finish(&c, "releases ok");
}

// The address of an owning global: the store pattern of a one-definition local resolves to the
// global. Each other use lets an indirect owning write reach it (D17.19).
fn addresses() void {
    env.closure mut c = env.closure{};
    string[15] lines = {
        "u8 mut@ own mut pool = {};",
        "u8 mut@ own mut kept = {};",
        "fn hand(u8 mut@ own mut* p) void {}",
        "fn give() void {",
        "    hand(&pool);",
        "}",
        "fn through_pointer() void {",
        "    u8 mut@ own mut* p = &kept;",
        "    del(*p);",
        "    *p = new(u8, 1);",
        "}",
        "fn view() u64 {",
        "    return kept.len + pool.len;",
        "}",
        "fn none() void {}",
    };
    env.open(&c, lines[..]);
    defer env.close(&c);
    ownership_source_exit.closure* x = env.shared(&c);
    assert(x->leaves[env.leaf_of(&c, "pool")].escaped);
    assert(!x->leaves[env.leaf_of(&c, "kept")].escaped);
    assert(env.body(&c, "give")->escapes == 1);
    // `p` has one definition, the address of `kept`: the release and the store resolve to it.
    env.proved(&c, "through_pointer");
    assert(env.body(&c, "through_pointer")->global_stores == 1);
    assert(env.body(&c, "through_pointer")->global_releases == 1);
    assert(env.body(&c, "through_pointer")->global_addresses == 1);
    assert(env.body(&c, "view")->global_lends == 0);
    env.finish(&c, "addresses ok");
}

fn main() i32 {
    exit_paths();
    store_paths();
    releases();
    addresses();
    return 0;
}
