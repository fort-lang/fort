//! run
//! flags: -I ../../src/fort
//! stdout:
//| integers ok
//| chars ok
//| defaults ok
//| ok
/// Checks cv_fits and cv_default_kind. prim_test.ft checks the primitive type
/// queries.
import consts;
import prim;

//
// The sample values are the edges of every integer type and the examples of
// the type rules and the language rules.

u64 TWO63 = 9223372036854775808;
u64 U64_MAX = 18446744073709551615;
i64 I64_MIN = -9223372036854775808;
i64 I64_MAX = 9223372036854775807;
i64 I32_MIN = -2147483648;
i64 I32_MAX = 2147483647;
i64 U32_MAX = 4294967295;

// One bit per kind, in the order prim_kind declares them (prim_test.ft holds
// that order, so these twelve numbers cannot drift from it).
u64 F_I8 = 1;
u64 F_I16 = 2;
u64 F_I32 = 4;
u64 F_I64 = 8;
u64 F_U8 = 16;
u64 F_U16 = 32;
u64 F_U32 = 64;
u64 F_U64 = 128;
u64 F_BOOL = 256;
u64 F_CHAR = 512;
// f32 and f64 together: an integer constant fits either float type.
u64 F_FLOATS = 3072;
u64 F_SIGNED = 15;
u64 F_UNSIGNED = 240;
u64 F_INTS = 255;

fn i(i64 v) consts.cval {
    return consts.cv_from_i64(v);
}

fn u(u64 v) consts.cval {
    return consts.cv_from_u64(v);
}

fn neg_two63() consts.cval {
    return consts.cv_from_i64(I64_MIN);
}

fn ch(u64 code) consts.cval {
    return consts.cv_from_char(code);
}

// Whether `v` fits exactly the kinds listed in `mask`, a bit per prim_kind over
// the integer and float kinds, `char` and `bool`.
fn fits_exactly(consts.cval v, u64 mask) bool {
    u64 mut k = 0;
    while (k < prim.PRIM_COUNT) {
        u64 one = 1;
        bool expect = (mask & (one << k)) != 0;
        if (consts.cv_fits(v, cast(k, prim.prim_kind)) != expect) {
            return false;
        }
        k += 1;
    }
    return true;
}

// ---- cv_fits: every integer kind at both edges ---------------------------------

fn fits_i8_at_its_edges() void {
    assert(fits_exactly(i(-128), F_SIGNED | F_FLOATS));
    assert(fits_exactly(i(-129), F_I16 | F_I32 | F_I64 | F_FLOATS));
    assert(fits_exactly(i(127), F_INTS | F_FLOATS));
    assert(fits_exactly(i(128), (F_INTS & ~F_I8) | F_FLOATS));
}

fn fits_u8_at_its_edges() void {
    assert(fits_exactly(i(0), F_INTS | F_FLOATS));
    assert(fits_exactly(i(-1), F_SIGNED | F_FLOATS));
    assert(fits_exactly(i(255), (F_INTS & ~F_I8) | F_FLOATS));
    assert(fits_exactly(i(256), (F_INTS & ~(F_I8 | F_U8)) | F_FLOATS));
}

fn fits_i16_at_its_edges() void {
    assert(fits_exactly(i(-32768), (F_SIGNED & ~F_I8) | F_FLOATS));
    assert(fits_exactly(i(-32769), F_I32 | F_I64 | F_FLOATS));
    assert(fits_exactly(i(32767), (F_INTS & ~(F_I8 | F_U8)) | F_FLOATS));
    assert(fits_exactly(i(32768), (F_INTS & ~(F_I8 | F_U8 | F_I16)) | F_FLOATS));
}

fn fits_u16_at_its_edges() void {
    assert(fits_exactly(i(65535), (F_I32 | F_I64 | F_U16 | F_U32 | F_U64) | F_FLOATS));
    assert(fits_exactly(i(65536), (F_I32 | F_I64 | F_U32 | F_U64) | F_FLOATS));
}

fn fits_i32_at_its_edges() void {
    assert(fits_exactly(i(I32_MIN), F_I32 | F_I64 | F_FLOATS));
    assert(fits_exactly(i(I32_MIN - 1), F_I64 | F_FLOATS));
    assert(fits_exactly(i(I32_MAX), (F_I32 | F_I64 | F_U32 | F_U64) | F_FLOATS));
    assert(fits_exactly(i(I32_MAX + 1), (F_I64 | F_U32 | F_U64) | F_FLOATS));
}

fn fits_u32_at_its_edges() void {
    assert(fits_exactly(i(U32_MAX), (F_I64 | F_U32 | F_U64) | F_FLOATS));
    assert(fits_exactly(i(U32_MAX + 1), (F_I64 | F_U64) | F_FLOATS));
}

fn fits_i64_at_its_edges() void {
    assert(fits_exactly(neg_two63(), F_I64 | F_FLOATS));
    assert(fits_exactly(i(I64_MAX), (F_I64 | F_U64) | F_FLOATS));
    assert(fits_exactly(u(TWO63), F_U64 | F_FLOATS));
}

fn fits_u64_at_its_edge() void {
    assert(fits_exactly(u(U64_MAX), F_U64 | F_FLOATS));
    assert(fits_exactly(u(U64_MAX - 1), F_U64 | F_FLOATS));
}

fn fits_two31_in_u32_and_i64_but_not_i32() void {
    consts.cval v = u(2147483648);
    assert(consts.cv_fits(v, prim.prim_kind.prim_u32));
    assert(consts.cv_fits(v, prim.prim_kind.prim_i64));
    assert(consts.cv_fits(v, prim.prim_kind.prim_u64));
    assert(!consts.cv_fits(v, prim.prim_kind.prim_i32));
    assert(!consts.cv_fits(v, prim.prim_kind.prim_u16));
}

fn fits_examples_of_type_system_10_1_and_10_2() void {
    assert(consts.cv_fits(i(1), prim.prim_kind.prim_i64));    // i64 a = 1
    assert(consts.cv_fits(i(1), prim.prim_kind.prim_u8));     // u8 b = 1
    assert(consts.cv_fits(i(1), prim.prim_kind.prim_f64));    // f64 c = 1
    assert(consts.cv_fits(i(255), prim.prim_kind.prim_u8));   // u8 ok = 255
    assert(!consts.cv_fits(i(256), prim.prim_kind.prim_u8));  // u8 e1 = 256
    assert(!consts.cv_fits(i(-1), prim.prim_kind.prim_u32));  // u32 e2 = -1
    assert(consts.cv_fits(i(2), prim.prim_kind.prim_f32));    // f32 ok2 = 2
}

fn fits_examples_of_type_system_10_4() void {
    consts.cval mut r = consts.cv_none();
    assert(consts.cv_not(i(0), &r));
    assert(!consts.cv_fits(r, prim.prim_kind.prim_u32));             // u32 m = ~0
    assert(consts.cv_fits(u(4294967295), prim.prim_kind.prim_u32));  // u32 m2
    assert(consts.cv_shl(i(1), i(40), &r));
    assert(!consts.cv_fits(r, prim.prim_kind.prim_i32));             // i32 n = 1 << 40
    assert(consts.cv_shl(i(1), i(31), &r));
    assert(!consts.cv_fits(r, prim.prim_kind.prim_i32));             // i32 x = 1 << 31
    assert(consts.cv_fits(r, prim.prim_kind.prim_u32));
    assert(!consts.cv_shl(i(1), i(64), &r));                         // u64 big = 1 << 64
    assert(!consts.cv_div(i(1), i(0), &r));                          // i32 z = 1 / 0
}

// ---- cv_fits: chars, bools and the rest ----------------------------------------

// u8 b = 'a' is 97; 'a' also fits i8 and every wider integer.
fn fits_char_literal_in_char_and_integer_contexts() void {
    assert(fits_exactly(ch(cast('a', u64)), F_INTS | F_CHAR));
    assert(fits_exactly(ch(0), F_INTS | F_CHAR));
    assert(fits_exactly(ch(127), F_INTS | F_CHAR));
}

fn fits_char_above_127_skips_i8() void {
    assert(fits_exactly(ch(128), (F_INTS & ~F_I8) | F_CHAR));
    assert(fits_exactly(ch(255), (F_INTS & ~F_I8) | F_CHAR));
}

fn fits_integer_never_becomes_char() void {
    assert(!consts.cv_fits(i(65), prim.prim_kind.prim_char)); // char e = 65
    assert(!consts.cv_fits(i(0), prim.prim_kind.prim_char));
    assert(!consts.cv_fits(i(255), prim.prim_kind.prim_char));
}

fn fits_bool_only_in_bool() void {
    assert(fits_exactly(consts.cv_from_bool(true), F_BOOL));
    assert(fits_exactly(consts.cv_from_bool(false), F_BOOL));
    assert(!consts.cv_fits(i(1), prim.prim_kind.prim_bool));
    assert(!consts.cv_fits(ch(1), prim.prim_kind.prim_bool));
}

fn fits_nothing_for_null_strings_none_and_void() void {
    assert(fits_exactly(consts.cv_null(), 0));
    assert(fits_exactly(consts.cv_from_str("a"), 0));
    assert(fits_exactly(consts.cv_none(), 0));
    assert(!consts.cv_fits(i(0), prim.prim_kind.prim_void));
    assert(!consts.cv_fits(ch(cast('a', u64)), prim.prim_kind.prim_void));
}

// ---- cv_default_kind -----------------------------------------------------------

fn default_kind_of_a_small_integer_is_i32() void {
    prim.prim_kind mut k = prim.prim_kind.prim_void;
    assert(consts.cv_default_kind(i(7), &k)); // print(7)
    assert(k == prim.prim_kind.prim_i32);
    assert(consts.cv_default_kind(i(0), &k));
    assert(k == prim.prim_kind.prim_i32);
    assert(consts.cv_default_kind(i(-7), &k));
    assert(k == prim.prim_kind.prim_i32);
    assert(consts.cv_default_kind(i(I32_MIN), &k));
    assert(k == prim.prim_kind.prim_i32);
    assert(consts.cv_default_kind(i(I32_MAX), &k));
    assert(k == prim.prim_kind.prim_i32);
}

fn default_kind_of_a_large_integer_is_i64() void {
    prim.prim_kind mut k = prim.prim_kind.prim_void;
    assert(consts.cv_default_kind(i(3000000000), &k)); // print(3000000000)
    assert(k == prim.prim_kind.prim_i64);
    assert(consts.cv_default_kind(i(I32_MAX + 1), &k));
    assert(k == prim.prim_kind.prim_i64);
    assert(consts.cv_default_kind(i(I32_MIN - 1), &k));
    assert(k == prim.prim_kind.prim_i64);
    assert(consts.cv_default_kind(u(2147483648), &k));
    assert(k == prim.prim_kind.prim_i64);
    assert(consts.cv_default_kind(i(I64_MAX), &k));
    assert(k == prim.prim_kind.prim_i64);
    assert(consts.cv_default_kind(neg_two63(), &k));
    assert(k == prim.prim_kind.prim_i64);
}

fn default_kind_of_an_integer_above_i64_is_an_error() void {
    prim.prim_kind mut k = prim.prim_kind.prim_void;
    consts.cval mut r = consts.cv_none();
    assert(consts.cv_shl(i(1), i(63), &r));
    assert(!consts.cv_default_kind(r, &k)); // print(1 << 63)
    assert(!consts.cv_default_kind(u(U64_MAX), &k));
    assert(k == prim.prim_kind.prim_void);
}

fn default_kind_of_a_char_is_char_and_of_a_bool_is_bool() void {
    prim.prim_kind mut k = prim.prim_kind.prim_void;
    assert(consts.cv_default_kind(ch(cast('a', u64)), &k)); // print('a')
    assert(k == prim.prim_kind.prim_char);
    assert(consts.cv_default_kind(consts.cv_from_bool(true), &k));
    assert(k == prim.prim_kind.prim_bool);
}

fn default_kind_of_null_strings_and_none_is_an_error() void {
    prim.prim_kind mut k = prim.prim_kind.prim_void;
    assert(!consts.cv_default_kind(consts.cv_null(), &k)); // print(null)
    assert(!consts.cv_default_kind(consts.cv_from_str("a"), &k));
    assert(!consts.cv_default_kind(consts.cv_none(), &k));
    assert(k == prim.prim_kind.prim_void);
}

fn main() i32 {
    fits_i8_at_its_edges();
    fits_u8_at_its_edges();
    fits_i16_at_its_edges();
    fits_u16_at_its_edges();
    fits_i32_at_its_edges();
    fits_u32_at_its_edges();
    fits_i64_at_its_edges();
    fits_u64_at_its_edge();
    fits_two31_in_u32_and_i64_but_not_i32();
    fits_examples_of_type_system_10_1_and_10_2();
    fits_examples_of_type_system_10_4();
    println("integers ok");
    fits_char_literal_in_char_and_integer_contexts();
    fits_char_above_127_skips_i8();
    fits_integer_never_becomes_char();
    fits_bool_only_in_bool();
    fits_nothing_for_null_strings_none_and_void();
    println("chars ok");
    default_kind_of_a_small_integer_is_i32();
    default_kind_of_a_large_integer_is_i64();
    default_kind_of_an_integer_above_i64_is_an_error();
    default_kind_of_a_char_is_char_and_of_a_bool_is_bool();
    default_kind_of_null_strings_and_none_is_an_error();
    println("defaults ok");
    println("ok");
    return 0;
}
