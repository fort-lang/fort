//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: fir_llvm.operation: not an operation of two operands
//! stdout:
//| add
/// operation spells the LLVM instruction of an rvalue of two operands. `use` has one operand,
/// so the call panics.
import fir;
import fir_llvm;
import llvm_env;
import types;

string[6] PRELUDE = {
    "struct pair {",
    "    i32 a;",
    "    i32 b;",
    "}",
    "fn take(pair p) i32 {",
    "    return p.a;\n}",
};

string[8] TEXT = {
    "fn main.f() -> i32 {",
    "    let _1: pair;",
    "",
    "    bb0: {",
    "        _0 = call fn main.take(const zero pair) #1:1 s1;",
    "        return #1:1 s1;",
    "    }",
    "}",
};

// A panic ends the program, so the case stands in a file of its own.
fn main() i32 {
    llvm_env.env mut e = llvm_env.env{};
    llvm_env.open(&e);
    defer llvm_env.close(&e);
    fir.module mut m = llvm_env.parse(&e, PRELUDE[..], TEXT[..]);
    defer fir.module_free(&m);
    fir.func* f = fir.module_function_at(&m, 0);
    types.node* i32t = fir.local_at(f, 0)->ty;
    types.node* pairt = fir.local_at(f, 1)->ty;
    println(fir_llvm.operation(fir.rvalue_kind.rv_add, i32t));
    fir_llvm.operation(fir.rvalue_kind.rv_use, i32t);
    return 0;
}
