//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| same index and held value versions
//| distinct indices keep shared sources
//| distinct owners and selected moves
//| unknown selection and guarded obligations
//| complete range cleanup and multiplicity
//| vector growth keeps the header address
//| no-growth reserve keeps backing views
//| retained map keys keep original sources
//| cleared elements and earlier views
//| aliased writes and failed updates
/// Tests dynamic slots, retained sources, and backing replacement.
import ast;
import check_env;
import ownership_api;
import ownership_join;
import ownership_limits;
import ownership_local_env;
import ownership_places;
import ownership_regions;
import ownership_state;
import ownership_transfer;
import types;
import std.strbuf;

fn id(ownership_api.entity_kind kind, u32 number) ownership_api.entity_id {
    return ownership_local_env.id(kind, number);
}

fn root(u32 slot) ownership_api.place_path { return ownership_local_env.place(slot); }

fn exact(i64 value) ownership_api.scalar_fact {
    ownership_api.scalar_fact mut out = ownership_api.scalar_fact{};
    out.kind = ownership_api.fact_kind.exact;
    out.value = value;
    return out;
}

fn element(u32 slot, u32 version, i64 known, ownership_api.projection mut@ parts)
    ownership_api.place_path {
    parts[0].kind = ownership_api.projection_kind.captured_index;
    parts[0].captured_version = id(ownership_api.entity_kind.value, version);
    if (known >= 0) { parts[0].index = exact(known); }
    ownership_api.place_path mut out = root(slot);
    out.projections = parts[0..1];
    return out;
}

fn selection(ownership_api.place_path path, ownership_api.place_path@ aliases)
    ownership_regions.selection {
    return ownership_regions.selection{path, aliases, true, true, true};
}

fn req(ownership_local_env.env mut* e, ownership_regions.action kind)
    ownership_regions.request {
    ownership_regions.request mut out = ownership_regions.request{};
    out.base = ownership_local_env.req(e, ownership_transfer.action.copy, 1, 2);
    out.base.leaves_empty_proved = true;
    out.kind = kind;
    out.exhaustive_proved = true;
    out.aliases_substituted_proved = true;
    out.limits = ownership_limits.production();
    return out;
}

fn typed_run(ownership_local_env.env mut* e, ownership_regions.action kind, types.node* ty,
    ownership_api.place_path source, ownership_api.place_path destination, bool owning)
    ownership_regions.result {
    ownership_regions.request mut r = req(e, kind);
    r.ty = ty;
    r.base.source = source;
    r.base.destination = destination;
    r.base.destination_owns = owning;
    ownership_api.place_path[1] src = {source};
    ownership_api.place_path[1] dst = {destination};
    ownership_regions.choice[1] mut choices = {};
    choices[0].source = selection(source, src[..]);
    choices[0].destination = selection(destination, dst[..]);
    r.choices = choices[..];
    return ownership_regions.apply(&e->state, &e->service, &r);
}

fn run(ownership_local_env.env mut* e, ownership_regions.action kind,
    ownership_api.place_path source, ownership_api.place_path destination, bool owning)
    ownership_regions.result {
    return typed_run(e, kind, null, source, destination, owning);
}

fn child(ownership_api.place_path parent, u32 number, ownership_api.projection mut@ parts)
    ownership_api.place_path {
    u64 mut i = 0;
    while (i < parent.projections.len) { parts[i] = parent.projections[i]; i += 1; }
    parts[i].kind = ownership_api.projection_kind.field;
    parts[i].field = number;
    ownership_api.place_path mut out = parent;
    out.projections = parts[0..i + 1];
    return out;
}

fn array_child(ownership_api.place_path parent, i64 number,
    ownership_api.projection mut@ parts) ownership_api.place_path {
    u64 mut i = 0;
    while (i < parent.projections.len) { parts[i] = parent.projections[i]; i += 1; }
    parts[i].kind = ownership_api.projection_kind.fixed_index;
    parts[i].index = exact(number);
    ownership_api.place_path mut out = parent;
    out.projections = parts[0..i + 1];
    return out;
}

fn first_field(types.node* record) types.node* {
    ast.sym* declaration = cast(record->decl, ast.sym*);
    return ast.ast_child(declaration->node, 0)->ty;
}

fn seed_ranged_view(ownership_local_env.env mut* e, ownership_api.place_path path,
    u32 source, u32 version, i64 offset) void {
    ownership_api.entity_id key = id(ownership_api.entity_kind.source, source);
    ownership_api.borrow_relation[1] mut borrows = {ownership_local_env.borrow(key, version,
        path)};
    borrows[0].range.source = key;
    borrows[0].range.offset = exact(offset);
    borrows[0].range.access.begin = exact(offset);
    borrows[0].range.access.end = exact(offset + 1);
    borrows[0].range.access.arithmetic_proved = true;
    borrows[0].range.extent = exact(64);
    borrows[0].range.alignment = 1;
    ownership_api.contents_fact mut value = ownership_local_env.reference(version, key,
        borrows[..]);
    value.place = path;
    assert(ownership_state.add_contents(&e->state, &e->service, value,
        ownership_api.operation_position{}, ownership_api.source_position{}).applied);
}

fn seed_kind(ownership_local_env.env mut* e, ownership_api.place_path path,
    ownership_api.contents_kind kind, u32 version) void {
    ownership_api.contents_fact mut value = ownership_api.contents_fact{};
    value.place = path;
    value.kind = kind;
    value.value_version = id(ownership_api.entity_kind.value, version);
    assert(ownership_state.add_contents(&e->state, &e->service, value,
        ownership_api.operation_position{}, ownership_api.source_position{}).applied);
}

fn take(ownership_local_env.env mut* e, ownership_regions.result mut* out) void {
    assert(ownership_api.successful(out->proof) && out->len == 1);
    ownership_state.free(&e->state);
    e->state = move(out->states[0]);
    ownership_regions.free(out);
}

fn okay(ownership_regions.result mut* out) void {
    assert(ownership_api.successful(out->proof) && out->len > 0);
    ownership_regions.free(out);
}

fn bad(ownership_regions.result mut* out) void {
    assert(!ownership_api.successful(out->proof) && out->proof.failed && out->len == 0);
    ownership_regions.free(out);
}

fn seed_owner(ownership_local_env.env mut* e, ownership_api.place_path path,
    u32 allocation, u32 source) void {
    ownership_api.allocation_fact mut owner =
        ownership_local_env.allocation(allocation, allocation, path.root.ordinal, 1);
    owner.owner.place = path;
    ownership_api.source_fact backing = ownership_local_env.source(source,
        ownership_api.source_kind.heap, owner.key);
    ownership_api.borrow_relation[1] borrows = {ownership_local_env.borrow(
        backing.key, allocation, path)};
    ownership_api.contents_fact mut value = ownership_local_env.reference(allocation,
        backing.key, borrows[..]);
    value.place = path;
    ownership_api.operation_position op = ownership_api.operation_position{};
    ownership_api.source_position at = ownership_api.source_position{};
    assert(ownership_state.add_source(&e->state, &e->service, backing, op, at).applied);
    assert(ownership_state.add_allocation(&e->state, &e->service, owner, op, at).applied);
    assert(ownership_state.add_contents(&e->state, &e->service, value, op, at).applied);
}

fn seed_view(ownership_local_env.env mut* e, ownership_api.place_path path,
    u32 source, u32 version) void {
    ownership_api.entity_id key = id(ownership_api.entity_kind.source, source);
    ownership_api.borrow_relation[1] borrows = {ownership_local_env.borrow(key, version, path)};
    ownership_api.contents_fact mut value =
        ownership_local_env.reference(version, key, borrows[..]);
    value.place = path;
    assert(ownership_state.add_contents(&e->state, &e->service, value,
        ownership_api.operation_position{}, ownership_api.source_position{}).applied);
}

fn seed_empty(ownership_local_env.env mut* e, ownership_api.place_path path) void {
    ownership_api.contents_fact mut value = ownership_local_env.empty_value();
    value.place = path;
    assert(ownership_state.add_contents(&e->state, &e->service, value,
        ownership_api.operation_position{}, ownership_api.source_position{}).applied);
}

fn predicate(ownership_local_env.env mut* e, u32 number, ownership_api.predicate_kind kind,
    u32 left, u32 right, i64 lower, i64 upper) void {
    ownership_api.predicate_atom mut p = ownership_api.predicate_atom{};
    p.key = id(ownership_api.entity_kind.predicate, number);
    p.kind = kind;
    p.left = id(ownership_api.entity_kind.value, left);
    p.right = id(ownership_api.entity_kind.value, right);
    p.lower = exact(lower);
    p.upper = exact(upper);
    assert(ownership_state.add_predicate(&e->state, &e->service, p,
        ownership_api.operation_position{}, ownership_api.source_position{}).applied);
}

fn owner(ownership_state.state* s, u32 number) ownership_api.allocation_fact {
    u64 index = ownership_state.allocation_index(s,
        id(ownership_api.entity_kind.allocation, number));
    assert(index != ownership_state.U64_MAX);
    return s->allocations[index];
}

fn fact(ownership_state.state* s, ownership_api.place_path path) ownership_api.contents_fact {
    u64 index = ownership_regions.content(s, path);
    assert(index != ownership_regions.U64_MAX);
    return s->contents[index];
}

fn stored_fact(ownership_state.state* s, ownership_api.place_path path)
    ownership_api.contents_fact {
    u64 index = ownership_transfer.contents_index(s, path);
    assert(index != ownership_regions.U64_MAX);
    return s->contents[index];
}

fn same_index() void {
    ownership_local_env.env mut e = ownership_local_env.env{};
    ownership_local_env.init(&e);
    ownership_api.projection[1] mut a = {};
    ownership_api.projection[1] mut b = {};
    ownership_api.projection[1] mut c = {};
    ownership_api.place_path held = element(1, 10, -1, a[..]);
    ownership_api.place_path equal = element(1, 11, -1, b[..]);
    ownership_api.place_path assigned = element(1, 12, -1, c[..]);
    predicate(&e, 1, ownership_api.predicate_kind.equality, 10, 11, 0, 0);
    assert(ownership_regions.compare(&e.state, held, equal, true) == ownership_places.overlap.same);
    assert(ownership_regions.compare(&e.state, held, assigned, true) ==
        ownership_places.overlap.possible);
    predicate(&e, 2, ownership_api.predicate_kind.inequality, 11, 12, 0, 0);
    assert(ownership_regions.compare(&e.state, held, assigned, true) ==
        ownership_places.overlap.disjoint);
    predicate(&e, 3, ownership_api.predicate_kind.equality, 11, 13, 0, 0);
    ownership_api.projection[1] mut d = {};
    ownership_api.place_path transitive = element(1, 13, -1, d[..]);
    assert(ownership_regions.compare(&e.state, held, transitive, true) ==
        ownership_places.overlap.same);
    ownership_api.place_path mut other_backing = held;
    other_backing.root = root(2).root;
    assert(ownership_regions.compare(&e.state, held, other_backing, false) ==
        ownership_places.overlap.possible);
    assert(ownership_regions.compare(&e.state, held, other_backing, true) ==
        ownership_places.overlap.disjoint);
    seed_owner(&e, held, 50, 60);
    ownership_regions.result mut moved = run(&e, ownership_regions.action.move_value,
        equal, root(2), true);
    take(&e, &moved);
    assert(ownership_state.same_place(owner(&e.state, 50).owner.place, root(2)));
    assert(ownership_transfer.empty_owner_proved(fact(&e.state, held)));
    ownership_regions.result mut released = run(&e, ownership_regions.action.release_value,
        root(2), root(2), true);
    take(&e, &released);
    assert(!owner(&e.state, 50).obligation);
    ownership_local_env.free(&e);
    print("same index and held value versions\n");
}

fn shared_source() void {
    ownership_local_env.env mut e = ownership_local_env.env{};
    ownership_local_env.init(&e);
    seed_owner(&e, root(3), 50, 60);
    ownership_api.projection[1] mut a = {};
    ownership_api.projection[1] mut b = {};
    ownership_api.place_path left = element(1, 10, 0, a[..]);
    ownership_api.place_path right = element(1, 11, 1, b[..]);
    seed_view(&e, left, 60, 70);
    seed_view(&e, right, 60, 71);
    assert(ownership_regions.compare(&e.state, left, right, true) ==
        ownership_places.overlap.disjoint);
    assert(fact(&e.state, left).borrows[0].source.ordinal == 60);
    assert(fact(&e.state, right).borrows[0].source.ordinal == 60);
    ownership_regions.result mut read = run(&e, ownership_regions.action.read_value,
        left, left, false);
    okay(&read);
    ownership_regions.result mut release = run(&e, ownership_regions.action.release_value,
        root(3), root(3), true);
    take(&e, &release);
    read = run(&e, ownership_regions.action.read_value, left, left, false);
    bad(&read);
    assert(e.counts.last_kind == ownership_api.event_kind.invalid_use);
    read = run(&e, ownership_regions.action.read_value, right, right, false);
    bad(&read);
    assert(e.counts.last_kind == ownership_api.event_kind.invalid_use);
    ownership_local_env.free(&e);
    print("distinct indices keep shared sources\n");
}

fn distinct_owners() void {
    ownership_local_env.env mut e = ownership_local_env.env{};
    ownership_local_env.init(&e);
    ownership_api.projection[1] mut a = {};
    ownership_api.projection[1] mut b = {};
    ownership_api.place_path left = element(1, 10, -1, a[..]);
    ownership_api.place_path right = element(1, 11, -1, b[..]);
    predicate(&e, 1, ownership_api.predicate_kind.membership, 10, 0, 0, 2);
    predicate(&e, 2, ownership_api.predicate_kind.membership, 11, 0, 2, 4);
    seed_owner(&e, left, 50, 60);
    seed_owner(&e, right, 51, 61);
    ownership_api.region_partition mut part = ownership_regions.partition(&e.state,
        id(ownership_api.entity_kind.region, 1),
        id(ownership_api.entity_kind.predicate, 1), a[0], 8);
    assert(!part.residual && part.bytes.arithmetic_proved);
    assert(part.bytes.begin.value == 0 && part.bytes.end.value == 16);
    part = ownership_regions.partition(&e.state, id(ownership_api.entity_kind.region, 2),
        id(ownership_api.entity_kind.predicate, 2), b[0], ownership_api.U64_MAX);
    assert(part.residual && !part.bytes.arithmetic_proved);
    ownership_regions.result mut release = run(&e, ownership_regions.action.release_value,
        left, left, true);
    take(&e, &release);
    assert(!owner(&e.state, 50).obligation && owner(&e.state, 51).obligation);
    ownership_regions.result mut read = run(&e, ownership_regions.action.read_value,
        right, right, true);
    okay(&read);
    ownership_regions.result mut move = run(&e, ownership_regions.action.move_value,
        right, root(2), true);
    take(&e, &move);
    assert(ownership_state.same_place(owner(&e.state, 51).owner.place, root(2)));
    assert(ownership_transfer.empty_owner_proved(fact(&e.state, right)));
    move = run(&e, ownership_regions.action.move_value, root(2), root(2), true);
    take(&e, &move);
    assert(owner(&e.state, 51).obligation && fact(&e.state, root(2)).borrows.len == 1);
    release = run(&e, ownership_regions.action.release_value, root(2), root(2), true);
    take(&e, &release);
    ownership_local_env.free(&e);
    print("distinct owners and selected moves\n");
}

fn unknown_selection() void {
    ownership_local_env.env mut e = ownership_local_env.env{};
    ownership_local_env.init(&e);
    ownership_api.projection[1] mut a = {};
    ownership_api.projection[1] mut b = {};
    ownership_api.place_path left = element(1, 10, 0, a[..]);
    ownership_api.place_path right = element(1, 11, 1, b[..]);
    seed_owner(&e, left, 50, 60);
    seed_owner(&e, right, 51, 61);
    seed_empty(&e, root(2));
    ownership_state.state mut before = ownership_state.clone(&e.state);
    ownership_api.place_path[1] l = {left};
    ownership_api.place_path[1] r = {right};
    ownership_api.place_path[1] dst = {root(2)};
    ownership_regions.choice[2] mut choices = {};
    choices[0].guard = id(ownership_api.entity_kind.guard, 1);
    choices[0].source = selection(left, l[..]);
    choices[0].destination = selection(left, l[..]);
    choices[1].guard = id(ownership_api.entity_kind.guard, 2);
    choices[1].source = selection(right, r[..]);
    choices[1].destination = selection(right, r[..]);
    ownership_regions.request mut release = req(&e, ownership_regions.action.release_value);
    release.choices = choices[..];
    ownership_regions.result mut out = ownership_regions.apply(&e.state, &e.service, &release);
    assert(ownership_api.successful(out.proof) && out.len == 2 && !out.widened);
    assert(!owner(&out.states[0], 50).obligation && owner(&out.states[0], 51).obligation);
    assert(owner(&out.states[1], 50).obligation && !owner(&out.states[1], 51).obligation);
    assert(out.guards[0].ordinal == 1 && out.guards[1].ordinal == 2);
    assert(ownership_state.equal(&e.state, &before));
    ownership_regions.free(&out);
    release.limits.g = 1;
    release.limits.r = 1;
    out = ownership_regions.apply(&e.state, &e.service, &release);
    assert(ownership_api.successful(out.proof) && out.len == 1 && out.widened);
    assert(out.states[0].allocations_len == 2);
    assert(owner(&out.states[0], 50).obligation && owner(&out.states[0], 51).obligation);
    assert(owner(&out.states[0], 50).count.zero && owner(&out.states[0], 50).count.many);
    assert(owner(&out.states[0], 51).count.zero && owner(&out.states[0], 51).count.many);
    assert(owner(&out.states[0], 50).history.len == 1);
    assert(owner(&out.states[0], 51).history.len == 1);
    assert(out.states[0].sources_len == 2 && out.states[0].losses_len > 0);
    bool mut retained = false;
    u64 mut retained_i = 0;
    while (retained_i < out.states[0].contents_len) {
        if (out.states[0].contents[retained_i].borrows.len > 0) { retained = true; }
        retained_i += 1;
    }
    assert(retained);
    ownership_regions.free(&out);
    choices[0].destination = selection(root(2), dst[..]);
    choices[1].destination = selection(root(2), dst[..]);
    ownership_regions.request mut move = req(&e, ownership_regions.action.move_value);
    move.base.destination_owns = true;
    move.choices = choices[..];
    out = ownership_regions.apply(&e.state, &e.service, &move);
    assert(ownership_api.successful(out.proof) && out.len == 2);
    assert(ownership_state.same_place(owner(&out.states[0], 50).owner.place, root(2)));
    assert(ownership_state.same_place(owner(&out.states[0], 51).owner.place, right));
    assert(ownership_state.same_place(owner(&out.states[1], 51).owner.place, root(2)));
    assert(ownership_state.same_place(owner(&out.states[1], 50).owner.place, left));
    assert(out.states[0].allocations_len == 2 && out.states[1].allocations_len == 2);
    assert(ownership_transfer.owner_count(&out.states[0], root(2)) == 1);
    assert(ownership_transfer.owner_count(&out.states[1], root(2)) == 1);
    assert(owner(&out.states[0], 50).history.len == 1);
    assert(owner(&out.states[1], 51).history.len == 1);
    assert(owner(&out.states[0], 50).history[0].kind == ownership_api.effect_kind.transfer);
    assert(owner(&out.states[1], 51).history[0].kind == ownership_api.effect_kind.transfer);
    ownership_regions.free(&out);
    move.exhaustive_proved = false;
    out = ownership_regions.apply(&e.state, &e.service, &move);
    bad(&out);
    assert(ownership_state.equal(&e.state, &before));
    move.exhaustive_proved = true;
    choices[1].guard = choices[0].guard;
    out = ownership_regions.apply(&e.state, &e.service, &move);
    bad(&out);
    assert(ownership_state.equal(&e.state, &before));
    choices[1].guard = id(ownership_api.entity_kind.guard, 2);
    choices[1].destination = selection(left, l[..]);
    out = ownership_regions.apply(&e.state, &e.service, &move);
    bad(&out);
    assert(e.counts.last_evidence == ownership_api.evidence_kind.abstract_possibility);
    assert(ownership_state.equal(&e.state, &before));
    ownership_state.free(&before);
    ownership_local_env.free(&e);
    print("unknown selection and guarded obligations\n");
}

struct history_budget {
    u64 releases;
    u64 fail_at;
}

fn charge_history(void mut* opaque, ownership_api.charge_request* r)
    ownership_api.charge_result {
    history_budget mut* count = cast(opaque, history_budget mut*);
    ownership_api.charge_result mut out = ownership_api.charge_result{};
    u64 mut i = 0;
    while (i < r->items.len) {
        if (r->items[i].category == ownership_api.limit_category.e) {
            count->releases += 1;
            if (count->releases >= count->fail_at) {
                out.limit.present = true;
                out.limit.category = ownership_api.limit_category.e;
                out.limit.scope = ownership_api.limit_scope.function;
                out.limit.work = r->work;
                out.limit.operation = r->operation;
                out.limit.source = r->source;
                out.limit.bound = count->fail_at - 1;
                out.limit.used = count->releases - 1;
                out.limit.attempted = r->items[i].amount;
                return out;
            }
        }
        i += 1;
    }
    out.allowed = true;
    out.proof.kind = ownership_api.proof_kind.complete;
    return out;
}

fn range_cleanup() void {
    ownership_local_env.env mut e = ownership_local_env.env{};
    ownership_local_env.init(&e);
    ownership_api.projection[1] mut a = {};
    ownership_api.projection[1] mut b = {};
    ownership_api.projection[1] mut c = {};
    ownership_api.place_path left = element(1, 10, 0, a[..]);
    ownership_api.place_path right = element(1, 11, 1, b[..]);
    ownership_api.place_path group = element(1, 12, -1, c[..]);
    seed_owner(&e, left, 50, 60);
    seed_owner(&e, right, 51, 61);
    seed_owner(&e, group, 52, 62);
    seed_owner(&e, root(2), 53, 63);
    predicate(&e, 1, ownership_api.predicate_kind.membership, 12, 0, 2, 10);
    u64 index = ownership_state.allocation_index(&e.state,
        id(ownership_api.entity_kind.allocation, 52));
    e.state.allocations[index].count.one = false;
    e.state.allocations[index].count.many = true;
    ownership_regions.result mut member = run(&e, ownership_regions.action.release_value,
        group, group, true);
    bad(&member);
    assert(owner(&e.state, 52).obligation && owner(&e.state, 52).count.many);
    ownership_regions.request mut clean = req(&e, ownership_regions.action.cleanup_range);
    clean.base.destination_owns = true;
    clean.range_begin = exact(0);
    clean.range_end = exact(2);
    clean.range_complete_proved = true;
    ownership_api.place_path[1] aliases = {root(1)};
    ownership_regions.choice[1] mut choices = {};
    choices[0].source = selection(root(1), aliases[..]);
    choices[0].destination = choices[0].source;
    clean.choices = choices[..];
    ownership_state.state mut before = ownership_state.clone(&e.state);
    clean.range_end = exact(0);
    ownership_regions.result mut out = ownership_regions.apply(&e.state, &e.service, &clean);
    assert(ownership_api.successful(out.proof) && out.len == 1);
    assert(ownership_state.equal(&out.states[0], &before));
    ownership_regions.free(&out);
    clean.range_end = exact(2);
    history_budget mut meter = history_budget{0, 2};
    e.service.budget_context = cast(&meter, void mut*);
    e.service.budget = charge_history;
    out = ownership_regions.apply(&e.state, &e.service, &clean);
    assert(meter.releases == 2);
    assert(out.proof.terminal.limit.present);
    assert(out.proof.terminal.limit.category == ownership_api.limit_category.e);
    assert(out.proof.terminal.limit.scope == ownership_api.limit_scope.function);
    assert(out.proof.terminal.limit.used == 1 && out.proof.terminal.limit.attempted == 1);
    bad(&out);
    assert(ownership_state.equal(&e.state, &before));
    assert(owner(&e.state, 50).history.len == 0 && owner(&e.state, 51).history.len == 0);
    ownership_state.free(&before);
    e.service.budget_context = cast(&e.counts, void mut*);
    e.service.budget = ownership_local_env.budget;
    out = ownership_regions.apply(&e.state, &e.service, &clean);
    take(&e, &out);
    assert(!owner(&e.state, 50).obligation && !owner(&e.state, 51).obligation);
    assert(owner(&e.state, 52).obligation && owner(&e.state, 53).obligation);
    assert(owner(&e.state, 52).count.many);
    clean.range_end = exact(10);
    clean.range_complete_proved = false;
    out = ownership_regions.apply(&e.state, &e.service, &clean);
    bad(&out);
    assert(owner(&e.state, 52).obligation);
    clean.range_complete_proved = true;
    clean.base.leaves_empty_proved = false;
    out = ownership_regions.apply(&e.state, &e.service, &clean);
    bad(&out);
    clean.base.leaves_empty_proved = true;
    out = ownership_regions.apply(&e.state, &e.service, &clean);
    take(&e, &out);
    assert(!owner(&e.state, 52).obligation && owner(&e.state, 52).count.zero);
    assert(!owner(&e.state, 52).count.one && !owner(&e.state, 52).count.many);
    assert(owner(&e.state, 53).obligation && owner(&e.state, 52).history.len == 1);
    assert(ownership_transfer.empty_owner_proved(fact(&e.state, group)));
    ownership_regions.result mut release = run(&e, ownership_regions.action.release_value,
        root(2), root(2), true);
    take(&e, &release);
    ownership_local_env.free(&e);
    print("complete range cleanup and multiplicity\n");
}

fn backing_inputs(ownership_local_env.env mut* e,
    ownership_api.place_path@ aliases) ownership_regions.backing_request {
    ownership_regions.backing_request mut out = ownership_regions.backing_request{};
    out.base = ownership_local_env.req(e, ownership_transfer.action.assignment, 1, 1);
    out.base.leaves_empty_proved = true;
    out.base.allocation = ownership_local_env.allocation(52, 52, 1, 1);
    out.base.fresh_source = ownership_local_env.source(62, ownership_api.source_kind.heap,
        out.base.allocation.key);
    out.header = selection(root(1), aliases);
    out.old_elements = root(2);
    out.new_elements = root(6);
    out.old_source = id(ownership_api.entity_kind.source, 60);
    out.correspondence_proved = true;
    out.complete_elements_proved = true;
    return out;
}

fn vector_growth() void {
    ownership_local_env.env mut e = ownership_local_env.env{};
    ownership_local_env.init(&e);
    seed_owner(&e, root(1), 50, 60);
    ownership_api.projection[1] mut a = {};
    ownership_api.projection[1] mut b = {};
    ownership_api.place_path old_element = element(2, 10, 0, a[..]);
    ownership_api.place_path new_element = element(6, 10, 0, b[..]);
    seed_owner(&e, old_element, 51, 61);
    ownership_api.graph_edge mut edge = ownership_api.graph_edge{};
    edge.key = id(ownership_api.entity_kind.relation, 100);
    edge.kind = ownership_api.edge_kind.owned;
    edge.place = old_element;
    ownership_state.append_edges(&e.state, edge);
    seed_view(&e, root(3), 60, 70);
    ownership_local_env.add_stack(&e, 80);
    seed_view(&e, root(4), 80, 71);
    seed_view(&e, root(5), 61, 72);
    ownership_api.place_path[1] aliases = {root(1)};
    ownership_regions.backing_request mut change = backing_inputs(&e, aliases[..]);
    ownership_api.borrow_relation[1] borrows = {ownership_local_env.borrow(
        change.base.fresh_source.key, 52, root(1))};
    change.base.value = ownership_local_env.reference(52,
        change.base.fresh_source.key, borrows[..]);
    ownership_state.state mut before = ownership_state.clone(&e.state);
    change.complete_elements_proved = false;
    ownership_regions.result mut out = ownership_regions.replace_backing(&e.state,
        &e.service, &change);
    bad(&out);
    assert(ownership_state.equal(&e.state, &before));
    change.complete_elements_proved = true;
    out = ownership_regions.replace_backing(&e.state, &e.service, &change);
    take(&e, &out);
    assert(!owner(&e.state, 50).obligation && owner(&e.state, 52).obligation);
    assert(owner(&e.state, 51).obligation);
    assert(ownership_state.same_place(owner(&e.state, 51).owner.place, new_element));
    assert(owner(&e.state, 51).history.len == 1);
    assert(e.state.edges_len == 1);
    assert(ownership_state.same_place(e.state.edges[0].place, new_element));
    assert(owner(&e.state, 51).history[0].kind == ownership_api.effect_kind.transfer);
    assert(ownership_regions.content(&e.state, old_element) == ownership_regions.U64_MAX);
    assert(fact(&e.state, new_element).borrows[0].source.ordinal == 61);
    assert(fact(&e.state, root(1)).borrows[0].source.ordinal == 62);
    ownership_regions.result mut read = run(&e, ownership_regions.action.read_value,
        root(3), root(3), false);
    bad(&read);
    assert(e.counts.last_kind == ownership_api.event_kind.invalid_use);
    read = run(&e, ownership_regions.action.read_value, root(4), root(4), false);
    okay(&read);
    read = run(&e, ownership_regions.action.read_value, root(5), root(5), false);
    okay(&read);
    ownership_regions.result mut release = run(&e, ownership_regions.action.release_value,
        new_element, new_element, true);
    take(&e, &release);
    read = run(&e, ownership_regions.action.read_value, root(5), root(5), false);
    bad(&read);
    release = run(&e, ownership_regions.action.release_value, root(1), root(1), true);
    take(&e, &release);
    ownership_state.free(&before);
    ownership_local_env.free(&e);
    print("vector growth keeps the header address\n");
}

fn no_growth() void {
    ownership_local_env.env mut e = ownership_local_env.env{};
    ownership_local_env.init(&e);
    seed_owner(&e, root(1), 50, 60);
    seed_view(&e, root(3), 60, 70);
