//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: comptime.relation: not a comparison
//! stdout:
//| true
/// The selector calls relation only for the six comparison operators. `+` breaks that
/// precondition, so the call panics.
import comptime;
import consts;
import lexer;

fn main() i32 {
    println(comptime.relation(lexer.tok_kind.le) == consts.cv_rel.cv_rel_le);
    comptime.relation(lexer.tok_kind.plus);
    return 0;
}
