//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| local_word_writes ok
//| local_long_writes ok
//| local_pair_writes ok
//| field_long_writes ok
//| constant_element_writes ok
//| variable_element_writes ok
//| whole_array_writes ok
//| global_word_writes ok
//| new_object_writes ok
//| new_span_writes ok
//| array_slice_writes ok
//| span_slice_writes ok
//| raw_range_writes ok
//| void_trip_writes ok
//| foreign_writes ok
/// Holds the raw verdicts of writes and field addresses through each address origin.
import ownership_raw_source_env;
import ownership_source_raw;

// Window 4 bytes, alignment 4: writes and field addresses
// inside it hold, and a write or a field past it fails exactly.
fn local_word_writes() void {
    ownership_raw_source_env.closure mut c = ownership_raw_source_env.closure{};
    string[40] lines = {
        "struct pair { i32 a; i64 b; u8* p; }",
        "u64 mut SHARED = 3;",
        "extern fn shared_bytes() u8 mut*;",
        "fn local_word_write_first() void {",
        "    u32 mut x = 7;",
        "    u8 mut* b = cast(&x, u8 mut*);",
        "    *b = 1;",
        "}",
        "fn local_word_write_last() void {",
        "    u32 mut x = 7;",
        "    u8 mut* b = cast(&x, u8 mut*);",
        "    u8 mut@ v = b[3..4];",
        "    v[0] = 1;",
        "}",
        "fn local_word_write_past() void {",
        "    u32 mut x = 7;",
        "    u8 mut* b = cast(&x, u8 mut*);",
        "    u8 mut@ v = b[0..5];",
        "    v[0] = 1;",
        "}",
        "fn local_word_write_wide() void {",
        "    u32 mut x = 7;",
        "    u8 mut* b = cast(&x, u8 mut*);",
        "    u8[5] mut* w = cast(b, u8[5] mut*);",
        "    u8[5] zeros = {};",
        "    *w = zeros;",
        "}",
        "fn local_word_write_misaligned() void {",
        "    u32 mut x = 7;",
        "    u8 mut* b = cast(&x, u8 mut*);",
        "    u16 mut* m = cast(b[1..4].ptr, u16 mut*);",
        "    *m = 0;",
        "}",
        "fn local_word_field_window() void {",
        "    u32 mut x = 7;",
        "    u8 mut* b = cast(&x, u8 mut*);",
        "    pair mut* q = cast(b, pair mut*);",
        "    i64 mut* f = &q->b;",
        "    *f = 1;",
        "}",
    };
    ownership_raw_source_env.open(&c, lines[..]);
    defer ownership_raw_source_env.close(&c);
    ownership_raw_source_env.proved(&c, "local_word_write_first");
    ownership_raw_source_env.proved(&c, "local_word_write_last");
    ownership_raw_source_env.violation(&c, "local_word_write_past", "b",
        "raw range exceeds proved storage", 18);
    ownership_raw_source_env.violation(&c, "local_word_write_wide", "w",
        "typed access exceeds its inherited window", 26);
    ownership_raw_source_env.violation(&c, "local_word_write_misaligned", "m",
        "typed access alignment remains unproved", 32);
    ownership_raw_source_env.violation(&c, "local_word_field_window", "q",
        "selected byte window remains unproved", 38);
    ownership_raw_source_env.report(&c, "local_word_writes");
}

