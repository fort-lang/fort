//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: flt.read_decimal: the text is not a float literal
//! stdout:
//| 2
/// The lexer checks the shape of a float literal before read_decimal reads it. A letter in
/// the digits breaks that precondition, so the call panics.
import flt;

fn main() i32 {
    flt.decimal mut d = flt.decimal{};
    flt.read_decimal("1.5", &d);
    println(d.len);
    flt.read_decimal("1x5", &d);
    return 0;
}
