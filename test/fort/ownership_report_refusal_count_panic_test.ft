//| 1
/// Checks that the refusal collector rejects a span whose size differs from its counted rows.
import ownership_report;
import ownership_source_calls;

fn main() i32 {
    ownership_source_calls.context calls = ownership_source_calls.context{};
    ownership_report.call_refusal[1] mut items = {};
    println(1);
    ownership_report.collect_call_refusals(&calls, items[..]);
    return 0;
}
