//! run
//! flags: -I ../../src
//! abort
//! stderr: panic: fir.place_type: no such field
//! stdout:
//| ready
/// Checks that fir.place_type refuses a field number past the fields of a struct.
import fort.diag;
import fort.fir;
import fort.prim;
import fort.types;

fn main() i32 {
    types.table mut tt = types.table{};
    defer types.type_table_free(&tt);
    types.node* i32t = types.type_prim(&tt, prim.prim_kind.prim_i32);
    types.node*[2] params = {i32t, i32t};
    types.node* fnty = types.type_fn(&tt, i32t, params[..], false);
    fir.func mut f = fir.func_new(&tt, null, fnty);
    defer fir.func_free(&f);
    diag.loc here = diag.loc_make("t.ft", 1, 1);
    // a struct of one i32 field, laid out as the checker lays it out
    types.node* one = types.type_struct(&tt, "one", 1);
    types.node*[1] fields = {i32t};
    u64[1] mut offsets = {};
    assert(types.type_layout_begin(one));
    assert(types.type_layout_struct(one, fields[..], offsets[..]));
    u32 n = fir.local_add(&f, one, fir.local_kind.lk_temp, null, here);
    assert(fir.place_type(&f, fir.place_field(&f, fir.place_local(n), 0)) == i32t);
    fir.place p = fir.place_field(&f, fir.place_local(n), 1);
    println("ready");
    fir.place_type(&f, p);
    return 0;
}
