//! run
//! flags: -I ../../src/fort -I support -I ../../src
//! abort
//! stderr: panic: json.text_of: not a string and not a number
//! stdout:
//| the text of a string and of a number ok
import lsp.json;

// text_of answers a string or the source text of a number. Every other kind
// is a violated precondition and panics: a caller reads the kind first,
// since a document an editor sent holds whatever it holds.
// D13.3
fn i32 main() {
    json.doc mut d = json.create();
    defer json.free(&d);
    assert(json.parse(&d, "[\"s\",1,2.5,null]"));
    u32 root = json.root(&d);
    assert(json.text_of(&d, json.at_of(&d, root, 0)) == "s");
    assert(json.text_of(&d, json.at_of(&d, root, 1)) == "1");
    assert(json.text_of(&d, json.at_of(&d, root, 2)) == "2.5");
    println("the text of a string and of a number ok");
    println(json.text_of(&d, json.at_of(&d, root, 3)));
    return 0;
}
