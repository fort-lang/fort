//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: fir_flow.dataflow_forward_edges: the set counts differ from the block count
//! stdout:
//| ready
/// dataflow_forward_edges takes one gen set and one kill set for each block, as
/// dataflow_forward_sets does. The function has one block and the test gives no gen set, so the
/// function panics before it reads a set.
import fort.fir;
import fir_env;
import fort.fir_flow;

// The transfer that dataflow_new takes. The set transfer never calls it.
fn no_transfer(fir.func* f, u32 b, fir_flow.bits mut* set) void {
}

fn main() i32 {
    // The test lends the span of the edge set to a call, so the set lives in an allocation and
    // ends through sets_drop_made. The first gen set of the allocation is the edge set.
    fir_env.sets mut* own s = fir_env.sets_make_with(1);
    defer fir_env.sets_drop_made(move(s));
    fir_env.env mut* own e = fir_env.make();
    defer fir_env.drop_made(move(e));
    // `f` lives in an allocation, so that the leak rule proves its end: no call changes the
    // pointer, and drop_made holds each release once.
    fir.func mut* own f = fir_env.func_made(e, "nothing");
    defer fir.func_drop_made(move(f));
    fir.block_set_terminator(f, 0, fir.term_return(fir_env.at(1, 1), 0));
    fir.pred_table mut* own pt = fir.func_predecessors_made(f);
    defer fir.pred_table_drop_made(move(pt));
    fir_flow.dataflow mut* own d = fir_flow.dataflow_make(1, fir_flow.join_kind.join_union,
                                                         no_transfer);
    defer fir_flow.dataflow_drop_made(move(d));
    fir_flow.bits@ none = {};
    u32[1] to = {fir_flow.NO_EDGE};
    println("ready");
    fir_flow.dataflow_forward_edges(f, pt, d, none, none, to[..], s->gens[..1]);
    return 0;
}
