//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| index ok
//| copy ok
//| span ok
//| sret ok
//| ok
/// Checks the IR that the FIR translator writes for nested arrays and spans. The cases cover
/// types, dimension GEPs, bounds checks, and copies.
import check_env;
import gen_env;
import types;
import std.strbuf;

//
// The expected text has a different source from the text in other emitter suites.
// bootstrap-0 refuses a second array or span level, so it produces no reference output. The
// expected blocks are the text that the FIR translator writes for `main` (gen_env.main_text),
// held against the emitter and LLVM contracts. A GEP into `[N x T]` takes the array index after
// the object index. Two other tests check the same rules from another side: run/errors/028 to
// 030 run the checks. run/ffi/011_multidim_layout.ft holds every stride against C's own sizeof
// and offsetof, which is the only shape that sees a stride error at all.

string GRID = "    i32[2][3] mut m = {};";
string I = "    i32 mut i = 1;";
string J = "    i32 mut j = 2;";

// ---- the index of each dimension -----------------------------------------------------

fn each_dimension_is_indexed_and_checked_on_its_own() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    string[4] mut lines = {GRID, I, J, "    i32 mut a = m[i][j];"};
    assert(gen_env.open_lines(&e, lines[..]));
    // The outer index is checked against 2 and the inner one against 3, in the
    // block the first check falls into. Then the outer GEP strides over a whole
    // row, and the inner one, whose base is the row's address and whose type
    // is the row's own, strides over an i32.
    string[15] want = {
        "  %t0 = load i32, ptr %i.1, align 4\n",
        "  %t1 = sext i32 %t0 to i64\n",
        "  %t2 = icmp uge i64 %t1, 2\n",
        "  br i1 %t2, label %L3, label %L1\n",
        "\n",
        "L1:\n",
        "  %t3 = load i32, ptr %j.2, align 4\n",
        "  %t4 = sext i32 %t3 to i64\n",
        "  %t5 = icmp uge i64 %t4, 3\n",
        "  br i1 %t5, label %L4, label %L2\n",
        "\n",
        "L2:\n",
        "  %t6 = getelementptr inbounds [2 x [3 x i32]], ptr %m.0, i64 0, i64 %t1\n",
        "  %t7 = getelementptr inbounds [3 x i32], ptr %t6, i64 0, i64 %t4\n",
        "  %t8 = load i32, ptr %t7, align 4\n",
    };
    gen_env.expect_in(gen_env.main_text(&e), gen_env.join_lines(&e, want[..]));
}

fn the_second_check_fails_to_its_own_block() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    string[4] mut lines = {GRID, I, J, "    i32 mut a = m[i][j];"};
    assert(gen_env.open_lines(&e, lines[..]));
    // Each dimension has a failure block of its own. Each
    // diagnostic names its checked length and `[` column.
    // The outer column is 18, and the inner column is 21.
    string[7] want = {
        "L3:\n",
        "  call void @\"std.rt.fail_bounds\"(i64 %t1, i64 2, ptr @.file.0, i32 5, i32 18)\n",
        "  unreachable\n",
        "\n",
        "L4:\n",
        "  call void @\"std.rt.fail_bounds\"(i64 %t4, i64 3, ptr @.file.0, i32 5, i32 21)\n",
        "  unreachable\n",
    };
    gen_env.expect_in(gen_env.main_text(&e), gen_env.join_lines(&e, want[..]));
}

fn a_literal_index_is_checked_at_each_rank_too() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    string[2] mut lines = {GRID, "    i32 mut a = m[1][2];"};
    assert(gen_env.open_lines(&e, lines[..]));
    // The emitter writes a comparison for every index, including a literal.
    // It folds nothing, and LLVM removes the two comparisons below. What
    // changes with the rank is the type of the GEP and the length compared.
    string[14] want = {
        "  %t0 = sext i32 1 to i64\n",
        "  %t1 = icmp uge i64 %t0, 2\n",
        "  br i1 %t1, label %L3, label %L1\n",
        "\n",
        "L1:\n",
        "  %t2 = sext i32 2 to i64\n",
        "  %t3 = icmp uge i64 %t2, 3\n",
        "  br i1 %t3, label %L4, label %L2\n",
        "\n",
        "L2:\n",
        "  %t4 = getelementptr inbounds [2 x [3 x i32]], ptr %m.0, i64 0, i64 %t0\n",
        "  %t5 = getelementptr inbounds [3 x i32], ptr %t4, i64 0, i64 %t2\n",
        "  %t6 = load i32, ptr %t5, align 4\n",
        "  store i32 %t6, ptr %a.1, align 4\n",
    };
    gen_env.expect_in(gen_env.main_text(&e), gen_env.join_lines(&e, want[..]));
}

// ---- the copy ------------------------------------------------------------------------

fn a_whole_nested_array_copies_every_byte() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    string[2] mut lines = {GRID, "    i32[2][3] mut b = m;"};
    assert(gen_env.open_lines(&e, lines[..]));
    // an aggregate lands in its destination through one memcpy of
    // the whole type, which is 24 bytes here, six elements of four.
    gen_env.expect_in(
        gen_env.main_text(&e),
        gen_env.join2(&e, "  call void @llvm.memcpy.p0.p0.i64(ptr align 4 %b.1, ptr align 4 ",
                      "%m.0, i64 24, i1 false)\n"));
    assert(types.type_sizeof(gen_env.type_of(&e, "b")) == 24);
}

fn one_row_copies_the_row_alone() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    string[2] mut lines = {GRID, "    i32[3] mut r = m[1];"};
    assert(gen_env.open_lines(&e, lines[..]));
    // The row is 12 bytes and the copy is of the row, not of the array it came
    // out of.
    string[8] want = {
        "  %t0 = sext i32 1 to i64\n",
        "  %t1 = icmp uge i64 %t0, 2\n",
        "  br i1 %t1, label %L2, label %L1\n",
        "\n",
        "L1:\n",
        "  %t2 = getelementptr inbounds [2 x [3 x i32]], ptr %m.0, i64 0, i64 %t0\n",
        "  call void @llvm.memcpy.p0.p0.i64(ptr align 4 %r.1, ptr align 4 %t2, ",
        "i64 12, i1 false)\n",
    };
    gen_env.expect_in(gen_env.main_text(&e), gen_env.join_lines(&e, want[..]));
    assert(types.type_sizeof(gen_env.type_of(&e, "r")) == 12);
}

// ---- a span whose element is an array --------------------------------------------------

fn a_span_of_arrays_strides_by_the_row() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    string[3] mut lines = {"    i32[3] mut@ own g = new(i32[3], 2);", I,
                           "    i32 mut a = g[i][0];"};
    assert(gen_env.open_lines(&e, lines[..]));
    // The length comes from the header, and the check reads it once more as the
    // length it reports. The second rank is checked against the row's 3. Then
    // the pointer comes from the header, and the second rank uses an array GEP
    // over the row that the first rank reached.
    string[22] want = {
        "  %t8 = load i32, ptr %i.1, align 4\n",
        "  %t9 = sext i32 %t8 to i64\n",
        "  %t10 = getelementptr inbounds %fort.span, ptr %g.0, i32 0, i32 1\n",
        "  %t11 = load i64, ptr %t10, align 8\n",
        "  %t12 = icmp uge i64 %t9, %t11\n",
        "  %t13 = getelementptr inbounds %fort.span, ptr %g.0, i32 0, i32 1\n",
        "  %t14 = load i64, ptr %t13, align 8\n",
        "  br i1 %t12, label %L7, label %L3\n",
        "\n",
        "L3:\n",
        "  %t15 = sext i32 0 to i64\n",
        "  %t16 = icmp uge i64 %t15, 3\n",
        "  br i1 %t16, label %L8, label %L4\n",
        "\n",
        "L4:\n",
        "  %t17 = getelementptr inbounds %fort.span, ptr %g.0, i32 0, i32 0\n",
        "  %t18 = load ptr, ptr %t17, align 8\n",
        // The element GEP names the element type and takes one index, so it
        // strides by the 12 bytes of one row.
        "  %t19 = getelementptr inbounds [3 x i32], ptr %t18, i64 %t9\n",
        "  %t20 = getelementptr inbounds [3 x i32], ptr %t19, i64 0, i64 %t15\n",
        "  %t21 = load i32, ptr %t20, align 4\n",
        "  store i32 %t21, ptr %a.2, align 4\n",
        "  store i32 0, ptr %result, align 4\n",
    };
    gen_env.expect_in(gen_env.main_text(&e), gen_env.join_lines(&e, want[..]));
}

fn the_element_type_of_that_span_is_the_row() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    string[1] mut lines = {"    i32[3] mut@ own g = new(i32[3], 2);"};
    assert(gen_env.open_lines(&e, lines[..]));
    // A span is two words whatever it spans, and its element carries the row's
    // size, which is what the GEP above strides by.
    types.node* span = gen_env.type_of(&e, "g");
    assert(types.type_sizeof(span) == 16);
    assert(types.type_sizeof(span->elem) == 12);
    assert(span->elem->kind == types.type_kind.k_array);
    assert(span->elem->len == 3);
    assert(check_env.type_text(&e.c, span) == "i32[3] mut@ own");
}

// ---- the array of spans and the span of spans ----------------------------------------

fn an_array_of_spans_strides_by_the_header() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    string[3] mut lines = {"    i32[3] mut a = {1, 2, 3};",
                           "    i32 mut@[2] mut rows = {a[0..3], a[1..3]};",
                           "    i32 mut b = rows[1][0];"};
    assert(gen_env.open_lines(&e, lines[..]));
    // The outer index walks an `[2 x %fort.span]`, so it strides by the 16
    // bytes of one header. The inner one reads the length and the
    // pointer out of the header it reached.
    string[20] want = {
        "  %t23 = sext i32 1 to i64\n",
        "  %t24 = icmp uge i64 %t23, 2\n",
        "  br i1 %t24, label %L7, label %L3\n",
        "\n",
        "L3:\n",
        "  %t25 = sext i32 0 to i64\n",
        "  %t26 = getelementptr inbounds [2 x %fort.span], ptr %rows.1, i64 0, i64 %t23\n",
        "  %t27 = getelementptr inbounds %fort.span, ptr %t26, i32 0, i32 1\n",
        "  %t28 = load i64, ptr %t27, align 8\n",
        "  %t29 = icmp uge i64 %t25, %t28\n",
        "  %t30 = getelementptr inbounds [2 x %fort.span], ptr %rows.1, i64 0, i64 %t23\n",
        "  %t31 = getelementptr inbounds %fort.span, ptr %t30, i32 0, i32 1\n",
        "  %t32 = load i64, ptr %t31, align 8\n",
        "  br i1 %t29, label %L8, label %L4\n",
        "\n",
        "L4:\n",
        "  %t33 = getelementptr inbounds [2 x %fort.span], ptr %rows.1, i64 0, i64 %t23\n",
        "  %t34 = getelementptr inbounds %fort.span, ptr %t33, i32 0, i32 0\n",
        "  %t35 = load ptr, ptr %t34, align 8\n",
        "  %t36 = getelementptr inbounds i32, ptr %t35, i64 %t25\n",
    };
    gen_env.expect_in(gen_env.main_text(&e), gen_env.join_lines(&e, want[..]));
}

fn a_span_of_spans_strides_by_the_header_too() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    string[4] mut lines = {"    i32[3] mut a = {1, 2, 3};",
                           "    i32 mut@[2] mut rows = {a[0..3], a[1..3]};",
                           "    i32 mut@ mut@ view = rows[0..2];",
                           "    i32 mut c = view[1][0];"};
    assert(gen_env.open_lines(&e, lines[..]));
    // The element of the outer span is itself a `%fort.span`. The element GEP
    // names that type and strides by 16 bytes.
    string[29] want = {
        "  %t32 = sext i32 1 to i64\n",
        "  %t33 = getelementptr inbounds %fort.span, ptr %view.2, i32 0, i32 1\n",
        "  %t34 = load i64, ptr %t33, align 8\n",
        "  %t35 = icmp uge i64 %t32, %t34\n",
        "  %t36 = getelementptr inbounds %fort.span, ptr %view.2, i32 0, i32 1\n",
        "  %t37 = load i64, ptr %t36, align 8\n",
        "  br i1 %t35, label %L9, label %L4\n",
        "\n",
        "L4:\n",
        "  %t38 = sext i32 0 to i64\n",
        "  %t39 = getelementptr inbounds %fort.span, ptr %view.2, i32 0, i32 0\n",
        "  %t40 = load ptr, ptr %t39, align 8\n",
        "  %t41 = getelementptr inbounds %fort.span, ptr %t40, i64 %t32\n",
        "  %t42 = getelementptr inbounds %fort.span, ptr %t41, i32 0, i32 1\n",
        "  %t43 = load i64, ptr %t42, align 8\n",
        "  %t44 = icmp uge i64 %t38, %t43\n",
        "  %t45 = getelementptr inbounds %fort.span, ptr %view.2, i32 0, i32 0\n",
        "  %t46 = load ptr, ptr %t45, align 8\n",
        "  %t47 = getelementptr inbounds %fort.span, ptr %t46, i64 %t32\n",
        "  %t48 = getelementptr inbounds %fort.span, ptr %t47, i32 0, i32 1\n",
        "  %t49 = load i64, ptr %t48, align 8\n",
        "  br i1 %t44, label %L10, label %L5\n",
        "\n",
        "L5:\n",
        "  %t50 = getelementptr inbounds %fort.span, ptr %view.2, i32 0, i32 0\n",
        "  %t51 = load ptr, ptr %t50, align 8\n",
        "  %t52 = getelementptr inbounds %fort.span, ptr %t51, i64 %t32\n",
        "  %t53 = getelementptr inbounds %fort.span, ptr %t52, i32 0, i32 0\n",
        "  %t54 = load ptr, ptr %t53, align 8\n",
    };
    gen_env.expect_in(gen_env.main_text(&e), gen_env.join_lines(&e, want[..]));
}

// ---- aggregate results --------------------------------------------------------------

fn a_nested_array_result_arrives_through_the_sret_pointer() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    strbuf.str_buf mut src = strbuf.create();
    defer strbuf.free(&src);
    strbuf.append(&src, "fn same(i32[2][3] m) i32[2][3] {\n    return m;\n}\n");
    strbuf.append(&src, "fn main() i32 {\n    return 0;\n}\n");
    assert(gen_env.open_module(&e, strbuf.view(&src)));
    // an aggregate result of any size leaves through the `sret`
    // pointer and the function returns `void`. Every other sret assertion in
    // the repository names a 16-byte struct. This one is 24 bytes, and the
    // size is in the memcpy that fills it.
    string[5] mut want = {
        "define dso_local void @\"main.same\"(ptr sret([2 x [3 x i32]]) %ret.sret, ptr %m.in)",
        " #0 {\nentry:\n",
        "  call void @llvm.memcpy.p0.p0.i64(ptr align 4 %ret.sret, ptr align 4 %m.in, i64 24,",
        " i1 false)\n",
        "  ret void\n}\n",
    };
    string got = gen_env.emit_function(&e, "same");
    gen_env.expect_text(got, gen_env.join_lines(&e, want[0..5]));
    gen_env.expect_blocks(&e, got);
}

fn main() i32 {
    each_dimension_is_indexed_and_checked_on_its_own();
    the_second_check_fails_to_its_own_block();
    a_literal_index_is_checked_at_each_rank_too();
    println("index ok");
    a_whole_nested_array_copies_every_byte();
    one_row_copies_the_row_alone();
    println("copy ok");
    a_span_of_arrays_strides_by_the_row();
    the_element_type_of_that_span_is_the_row();
    an_array_of_spans_strides_by_the_header();
    a_span_of_spans_strides_by_the_header_too();
    println("span ok");
    a_nested_array_result_arrives_through_the_sret_pointer();
    println("sret ok");
    println("ok");
    return 0;
}
