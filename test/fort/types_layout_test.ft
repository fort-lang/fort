//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| sizes ok
//| layout ok
//| owning ok
//| cycles ok
//| ceiling ok
//| ok
import prim;
import types;
import types_env;

// Sizes, alignment and C/System V struct layout: the sizes of D3.1 and D3.15,
// the layout of type-system.md 4.1, the ceiling on the size of a type (D3.4)
// and the value-containment cycles of D3.8. The port of
// test/types_layout_test.c; its nineteen forked internal errors are panic
// tests of their own here (types_*_panic_test.ft), since a panic ends the
// program (D11.4).

// 2^63 - 1, the largest object the compiler admits (D3.4).
u64 MAX_SIZE = 9223372036854775807;

// A distinct declaration pointer per nominal type built here.
i64[24] mut decls = {};

fn void* decl_at(u64 i) {
    return cast(&decls[i], void*);
}

fn u64 size_of(types_env.env mut* e, string text) {
    return types.type_sizeof(types_env.type_of(e, text));
}

fn u64 align_of(types_env.env mut* e, string text) {
    return types.type_alignof(types_env.type_of(e, text));
}

fn void sizeof_and_alignof_of_every_type_form() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    assert(size_of(&e, "i8") == 1);
    assert(size_of(&e, "u8") == 1);
    assert(size_of(&e, "bool") == 1);
    assert(size_of(&e, "char") == 1);
    assert(size_of(&e, "i16") == 2);
    assert(size_of(&e, "u16") == 2);
    assert(size_of(&e, "i32") == 4);
    assert(size_of(&e, "f32") == 4);
    assert(size_of(&e, "i64") == 8);
    assert(size_of(&e, "f64") == 8);
    assert(types.type_sizeof(e.color) == 4);
    assert(types.type_alignof(e.color) == 4);
    assert(size_of(&e, "node*") == 8);
    assert(size_of(&e, "void*") == 8);
    assert(size_of(&e, "i32@") == 16);
    assert(size_of(&e, "string") == 16);
    assert(align_of(&e, "i32@") == 8);
    assert(align_of(&e, "string") == 8);
    assert(align_of(&e, "node*") == 8);
    assert(align_of(&e, "i8") == 1);
    assert(align_of(&e, "i16") == 2);
    assert(align_of(&e, "i32") == 4);
    assert(align_of(&e, "f64") == 8);
    // A function pointer is 8, and `own` changes no size (D17.1).
    assert(types.type_sizeof(types_env.fn1(&e, types.type_prim(&e.tt, prim.prim_kind.prim_i32),
                                           e.point)) == 8);
    assert(types.type_alignof(types_env.fn0(&e, types.type_void(&e.tt))) == 8);
    assert(size_of(&e, "u8 mut@ own") == 16);
    assert(size_of(&e, "string own") == 16);
    assert(size_of(&e, "node mut* own") == 8);
}

fn void sizeof_of_the_suffix_shapes_of_d3_6() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    assert(size_of(&e, "node*[16]") == 128);
    assert(size_of(&e, "node**") == 8);
    assert(size_of(&e, "i32[3][4]") == 48);
    assert(size_of(&e, "i32[4]@") == 16);
    assert(size_of(&e, "i32@[4]") == 64);
    assert(size_of(&e, "i32@@") == 16);
    assert(size_of(&e, "node* mut@") == 16);
    assert(size_of(&e, "u8@*") == 8);
    assert(size_of(&e, "i32[4]*") == 8);
    assert(size_of(&e, "node*@*") == 8);
    assert(size_of(&e, "void*[2]") == 16);
    assert(size_of(&e, "node mut* own mut@ own") == 16);
    assert(size_of(&e, "node* own@") == 16);
    assert(size_of(&e, "u8 mut@ own mut*") == 8);
    assert(size_of(&e, "node* own[4]") == 32);
    // Alignment of an array is its element's (D3.1).
    assert(align_of(&e, "i32[3][4]") == 4);
    assert(align_of(&e, "node*[16]") == 8);
    assert(align_of(&e, "u8[3]") == 1);
}

fn void sizeof_of_function_types_with_suffixes() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node* i32t = types.type_prim(&e.tt, prim.prim_kind.prim_i32);
    types.node* f = types_env.fn1(&e, i32t, i32t);
    // `fn i32(i32)[4]` is an array of four function pointers (D3.6).
    assert(types.type_sizeof(types.type_array(&e.tt, f, 4)) == 32);
    // `fn i32[4](i32)` is one function pointer returning an `i32[4]`.
    assert(types.type_sizeof(types_env.fn1(&e, types.type_array(&e.tt, i32t, 4), i32t)) == 8);
    // `fn i32(i32)*` points to a slot holding a function pointer.
    assert(types.type_sizeof(types.type_ptr(&e.tt, f, false, false)) == 8);
}

fn void sizeof_of_the_error_type_is_zero() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    assert(types.type_sizeof(types.type_error(&e.tt)) == 0);
    assert(types.type_alignof(types.type_error(&e.tt)) == 1);
}

// ---- struct layout (type-system.md 4.1, D3.8, D9.9) ----------------------------

fn void layout_of_rec_matches_the_c_abi() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node*[4] mut fields = {types_env.type_of(&e, "u8"), types_env.type_of(&e, "i32"),
                                 types_env.type_of(&e, "u16"), types_env.type_of(&e, "f64")};
    u64[4] mut offsets = {};
    assert(types.type_layout_begin(e.rec));
    assert(types.type_layout_struct(e.rec, fields[..], offsets[..]));
    assert(offsets[0] == 0);
    assert(offsets[1] == 4);
    assert(offsets[2] == 8);
    assert(offsets[3] == 16);
    assert(types.type_sizeof(e.rec) == 24);
    assert(types.type_alignof(e.rec) == 8);
    assert(types.type_layout_state(e.rec) == types.layout_state.l_resolved);
    assert(!types.type_is_owning_aggregate(e.rec));
}

// struct str_map_entry { string key; i64 val; u64 hash; u8 state; }
fn void layout_of_a_map_entry_is_40_bytes() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node* entry = types.type_struct(&e.tt, "str_map_entry", decl_at(0));
    types.node*[4] mut fields = {types_env.type_of(&e, "string"), types_env.type_of(&e, "i64"),
                                 types_env.type_of(&e, "u64"), types_env.type_of(&e, "u8")};
    u64[4] mut offsets = {};
    assert(types.type_layout_begin(entry));
    assert(types.type_layout_struct(entry, fields[..], offsets[..]));
    assert(offsets[0] == 0);
    assert(offsets[1] == 16);
    assert(offsets[2] == 24);
    assert(offsets[3] == 32);
    assert(types.type_sizeof(entry) == 40);
    assert(types.type_alignof(entry) == 8);
}

// struct outer { u8 a; point p; u8 b; }: point is 8 bytes, aligned 4.
fn void layout_of_a_struct_with_a_struct_field() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    assert(types.type_sizeof(e.point) == 8);
    assert(types.type_alignof(e.point) == 4);
    types.node* outer = types.type_struct(&e.tt, "outer", decl_at(1));
    types.node*[3] mut fields = {types_env.type_of(&e, "u8"), e.point,
                                 types_env.type_of(&e, "u8")};
    u64[3] mut offsets = {};
    assert(types.type_layout_begin(outer));
    assert(types.type_layout_struct(outer, fields[..], offsets[..]));
    assert(offsets[0] == 0);
    assert(offsets[1] == 4);
    assert(offsets[2] == 12);
    assert(types.type_sizeof(outer) == 16);
    assert(types.type_alignof(outer) == 4);
}

fn void layout_of_arrays_spans_and_pointers_in_a_struct() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    // struct box { u8 a; i32[3] xs; }
    types.node* box = types.type_struct(&e.tt, "box", decl_at(2));
    types.node*[2] mut box_fields = {types_env.type_of(&e, "u8"),
                                     types_env.type_of(&e, "i32[3]")};
    u64[2] mut box_offsets = {};
    assert(types.type_layout_begin(box));
    assert(types.type_layout_struct(box, box_fields[..], box_offsets[..]));
    assert(box_offsets[1] == 4);
    assert(types.type_sizeof(box) == 16);
    assert(types.type_alignof(box) == 4);
    // struct bag { u8 a; i32@ s; node* p; }: a span is 16 aligned 8.
    types.node* bag = types.type_struct(&e.tt, "bag", decl_at(3));
    types.node*[3] mut bag_fields = {types_env.type_of(&e, "u8"), types_env.type_of(&e, "i32@"),
                                     types_env.type_of(&e, "node*")};
    u64[3] mut bag_offsets = {};
    assert(types.type_layout_begin(bag));
    assert(types.type_layout_struct(bag, bag_fields[..], bag_offsets[..]));
    assert(bag_offsets[0] == 0);
    assert(bag_offsets[1] == 8);
    assert(bag_offsets[2] == 24);
    assert(types.type_sizeof(bag) == 32);
    assert(types.type_alignof(bag) == 8);
}

// struct grid { point[3] ps; u8 tag; }: the element must be laid out first,
// which type_layout_pending reports.
fn void layout_of_a_struct_holding_a_struct_array() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node* grid = types.type_struct(&e.tt, "grid", decl_at(4));
    types.node* points = types.type_array(&e.tt, e.point, 3);
    assert(types.type_layout_pending(points) == null);
    types.node*[2] mut fields = {points, types_env.type_of(&e, "u8")};
    u64[2] mut offsets = {};
    assert(types.type_layout_begin(grid));
    assert(types.type_layout_struct(grid, fields[..], offsets[..]));
    assert(offsets[0] == 0);
    assert(offsets[1] == 24);
    assert(types.type_sizeof(grid) == 28);
    assert(types.type_alignof(grid) == 4);
}

// ---- owning aggregates (D17.7) -------------------------------------------------

fn void owning_aggregates_are_recognised_through_fields_and_elements() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    // struct vec { i32 mut@ own data; u64 len; } is owning (D17.7).
    assert(types.type_is_owning_aggregate(e.vec));
    assert(types.type_sizeof(e.vec) == 24);
    assert(!types.type_is_owning_aggregate(e.point));
    assert(!types.type_is_owning_aggregate(e.node));
    // struct pair { vec a; vec b; }: owning through nested aggregates.
    types.node* pair = types.type_struct(&e.tt, "pair", decl_at(5));
    types.node*[2] mut pair_fields = {e.vec, e.vec};
    u64[2] mut pair_offsets = {};
    assert(types.type_layout_begin(pair));
    assert(types.type_layout_struct(pair, pair_fields[..], pair_offsets[..]));
    assert(types.type_is_owning_aggregate(pair));
    assert(types.type_sizeof(pair) == 48);
    // A fixed array of `own` pointers is owning; a span of them is not, since
    // its elements are not held by value (D17.7).
    assert(types.type_is_owning_aggregate(types_env.type_of(&e, "node* own[4]")));
    assert(!types.type_is_owning_aggregate(types_env.type_of(&e, "node*[4]")));
    assert(!types.type_is_owning_aggregate(types_env.type_of(&e, "node* own@")));
    assert(!types.type_is_owning_aggregate(types_env.type_of(&e, "node mut* own mut@ own")));
    // An array of owning arrays is owning too.
    assert(types.type_is_owning_aggregate(
        types.type_array(&e.tt, types_env.type_of(&e, "node* own[4]"), 2)));
    // A struct holding an `own string` is owning (D17.12).
    types.node* named = types.type_struct(&e.tt, "named", decl_at(6));
    types.node*[1] mut named_fields = {types_env.type_of(&e, "string own")};
    u64[1] mut named_offsets = {};
    assert(types.type_layout_begin(named));
    assert(types.type_layout_struct(named, named_fields[..], named_offsets[..]));
    assert(types.type_is_owning_aggregate(named));
}

// An array of owning structs is owning, and so is a struct whose field is an
// owning array (D17.7).
fn void owning_reaches_through_arrays_of_structs_and_struct_fields() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    assert(types.type_is_owning_aggregate(types.type_array(&e.tt, e.vec, 2)));
    assert(!types.type_is_owning_aggregate(types.type_array(&e.tt, e.point, 2)));
    types.node* slots = types.type_struct(&e.tt, "slots", decl_at(7));
    types.node*[2] mut fields = {types_env.type_of(&e, "node* own[4]"),
                                 types_env.type_of(&e, "u64")};
    u64[2] mut offsets = {};
    assert(types.type_layout_begin(slots));
    assert(types.type_layout_struct(slots, fields[..], offsets[..]));
    assert(types.type_is_owning_aggregate(slots));
    assert(types.type_sizeof(slots) == 40);
    // A struct whose field is an array of that struct is owning too.
    types.node* nest = types.type_struct(&e.tt, "nest", decl_at(8));
    types.node*[1] mut nest_fields = {types.type_array(&e.tt, slots, 2)};
    u64[1] mut nest_offsets = {};
    assert(types.type_layout_begin(nest));
    assert(types.type_layout_struct(nest, nest_fields[..], nest_offsets[..]));
    assert(types.type_is_owning_aggregate(nest));
    assert(types.type_sizeof(nest) == 80);
    // A borrowed span of owned pointers is not owning: its elements are not
    // held by value (D17.7).
    types.node* view = types.type_struct(&e.tt, "view", decl_at(9));
    types.node*[1] mut view_fields = {types_env.type_of(&e, "node* own@")};
    u64[1] mut view_offsets = {};
    assert(types.type_layout_begin(view));
    assert(types.type_layout_struct(view, view_fields[..], view_offsets[..]));
    assert(!types.type_is_owning_aggregate(view));
}

fn void layout_packs_the_primitives_by_alignment() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    // struct all { i8 a; i16 b; i32 c; i64 d; }
    types.node* all = types.type_struct(&e.tt, "all", decl_at(10));
    types.node*[4] mut fields = {types_env.type_of(&e, "i8"), types_env.type_of(&e, "i16"),
                                 types_env.type_of(&e, "i32"), types_env.type_of(&e, "i64")};
    u64[4] mut offsets = {};
    assert(types.type_layout_begin(all));
    assert(types.type_layout_struct(all, fields[..], offsets[..]));
    assert(offsets[0] == 0);
    assert(offsets[1] == 2);
    assert(offsets[2] == 4);
    assert(offsets[3] == 8);
    assert(types.type_sizeof(all) == 16);
    assert(types.type_alignof(all) == 8);
}

fn void layout_rounds_the_size_up_to_the_alignment() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    // struct pad { u16 a; u8 b; }: size 4, alignment 2.
    types.node* pad = types.type_struct(&e.tt, "pad", decl_at(11));
    types.node*[2] mut fields = {types_env.type_of(&e, "u16"), types_env.type_of(&e, "u8")};
    u64[2] mut offsets = {};
    assert(types.type_layout_begin(pad));
    assert(types.type_layout_struct(pad, fields[..], offsets[..]));
    assert(offsets[1] == 2);
    assert(types.type_sizeof(pad) == 4);
    assert(types.type_alignof(pad) == 2);
    // struct one { bool b; }: size 1, alignment 1.
    types.node* one = types.type_struct(&e.tt, "one", decl_at(12));
    types.node*[1] mut one_fields = {types_env.type_of(&e, "bool")};
    u64[1] mut one_offsets = {};
    assert(types.type_layout_begin(one));
    assert(types.type_layout_struct(one, one_fields[..], one_offsets[..]));
    assert(types.type_sizeof(one) == 1);
    assert(types.type_alignof(one) == 1);
}

// struct hooks { fn i32(i32) f; void* ctx; u8 tag; }
fn void layout_of_reference_and_function_pointer_fields() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node* i32t = types.type_prim(&e.tt, prim.prim_kind.prim_i32);
    types.node* hooks = types.type_struct(&e.tt, "hooks", decl_at(13));
    types.node*[3] mut fields = {types_env.fn1(&e, i32t, i32t),
                                 types_env.type_of(&e, "void*"), types_env.type_of(&e, "u8")};
    u64[3] mut offsets = {};
    assert(types.type_layout_begin(hooks));
    assert(types.type_layout_struct(hooks, fields[..], offsets[..]));
    assert(offsets[0] == 0);
    assert(offsets[1] == 8);
    assert(offsets[2] == 16);
    assert(types.type_sizeof(hooks) == 24);
    assert(types.type_alignof(hooks) == 8);
    // A function pointer is not an owning field, whatever it returns.
    assert(!types.type_is_owning_aggregate(hooks));
}

// struct arena { u8 mut@ own bytes; void* own raw; u64 used; }
fn void layout_of_a_struct_with_an_owned_pointer_field() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node* arena = types.type_struct(&e.tt, "arena", decl_at(14));
    types.node*[3] mut fields = {types_env.type_of(&e, "u8 mut@ own"),
                                 types_env.type_of(&e, "void* own"),
                                 types_env.type_of(&e, "u64")};
    u64[3] mut offsets = {};
    assert(types.type_layout_begin(arena));
    assert(types.type_layout_struct(arena, fields[..], offsets[..]));
    assert(offsets[0] == 0);
    assert(offsets[1] == 16);
    assert(offsets[2] == 24);
    assert(types.type_sizeof(arena) == 32);
    assert(types.type_is_owning_aggregate(arena));
    // `own` changes no size: the same struct without the marks is as big.
    types.node* plain = types.type_struct(&e.tt, "plain", decl_at(15));
    types.node*[3] mut plain_fields = {types_env.type_of(&e, "u8 mut@"),
                                       types_env.type_of(&e, "void*"),
                                       types_env.type_of(&e, "u64")};
    u64[3] mut plain_offsets = {};
    assert(types.type_layout_begin(plain));
    assert(types.type_layout_struct(plain, plain_fields[..], plain_offsets[..]));
    assert(types.type_sizeof(plain) == types.type_sizeof(arena));
    assert(!types.type_is_owning_aggregate(plain));
}

fn void sizeof_of_arrays_of_structs_and_spans() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    assert(types.type_sizeof(types.type_array(&e.tt, e.point, 3)) == 24);
    assert(types.type_alignof(types.type_array(&e.tt, e.point, 3)) == 4);
    assert(types.type_sizeof(types.type_array(&e.tt, e.node, 2)) == 32);
    assert(types.type_sizeof(types.type_array(&e.tt, e.vec, 2)) == 48);
    assert(size_of(&e, "string[3]") == 48);
    assert(size_of(&e, "i32[2][3][4]") == 96);
    assert(size_of(&e, "bool[7]") == 7);
    assert(align_of(&e, "bool[7]") == 1);
}

// ---- pending layouts and cycles (D3.8) ------------------------------------------

fn void layout_pending_names_the_struct_a_size_needs() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    assert(types.type_layout_pending(e.rec) == e.rec);
    assert(types.type_layout_pending(types.type_array(&e.tt, e.rec, 2)) == e.rec);
    assert(types.type_layout_pending(
        types.type_array(&e.tt, types.type_array(&e.tt, e.rec, 2), 3)) == e.rec);
    // A reference to a struct needs no layout: it is 8 or 16 bytes.
    assert(types.type_layout_pending(types.type_ptr(&e.tt, e.rec, false, false)) == null);
    assert(types.type_layout_pending(types.type_span(&e.tt, e.rec, false, false)) == null);
    assert(types.type_layout_pending(types_env.type_of(&e, "i32[4]")) == null);
    assert(types.type_layout_pending(e.point) == null); // already resolved
    assert(types.type_layout_state(e.rec) == types.layout_state.l_unresolved);
    assert(types.type_layout_state(e.point) == types.layout_state.l_resolved);
    // A struct being laid out is still pending.
    assert(types.type_layout_begin(e.rec));
    assert(types.type_layout_state(e.rec) == types.layout_state.l_resolving);
    assert(types.type_layout_pending(e.rec) == e.rec);
}

// struct a { b x; } and struct b { a y; }: laying out `a` reaches `b`, which
// reaches `a` again (D3.8, "infinite size").
fn void a_value_containment_cycle_is_reported_once() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node* a = types.type_struct(&e.tt, "a", decl_at(16));
    types.node* b = types.type_struct(&e.tt, "b", decl_at(17));
    assert(types.type_layout_begin(a));
    assert(types.type_layout_pending(b) == b);
    assert(types.type_layout_begin(b));
    assert(types.type_layout_pending(a) == a);
    assert(!types.type_layout_begin(a)); // the cycle
    types.type_layout_fail(a);
    types.type_layout_fail(b);
    assert(types.type_layout_state(a) == types.layout_state.l_error);
    assert(types.type_layout_state(b) == types.layout_state.l_error);
    // A failed struct has a size, so the compiler can carry on.
    assert(types.type_sizeof(a) == 0);
    assert(types.type_alignof(a) == 1);
    assert(!types.type_is_owning_aggregate(a));
    assert(types.type_layout_pending(a) == null);
}

// struct loop { i32 v; loop next; }
fn void a_struct_containing_itself_by_value_is_a_cycle() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node* self = types.type_struct(&e.tt, "loop", decl_at(18));
    assert(types.type_layout_begin(self));
    assert(types.type_layout_pending(self) == self);
    assert(!types.type_layout_begin(self));
    types.type_layout_fail(self);
    assert(types.type_sizeof(self) == 0);
    // A self-reference through a pointer or a span is not a cycle: `node` and
    // `tree` lay out (D3.8).
    types.node* tree = types.type_struct(&e.tt, "tree", decl_at(19));
    types.node*[2] mut fields = {types_env.type_of(&e, "i32"),
                                 types.type_span(&e.tt, tree, false, false)};
    u64[2] mut offsets = {};
    assert(types.type_layout_begin(tree));
    assert(types.type_layout_pending(fields[1]) == null);
    assert(types.type_layout_struct(tree, fields[..], offsets[..]));
    assert(offsets[1] == 8);
    assert(types.type_sizeof(tree) == 24);
}

// struct a { b[2] x; } and struct b { a y; }: an array adds no level, so the
// containment is by value and the size is infinite (D3.4, D3.8).
fn void a_cycle_through_an_array_field_is_found_too() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node* a = types.type_struct(&e.tt, "a", decl_at(20));
    types.node* b = types.type_struct(&e.tt, "b", decl_at(21));
    types.node* pair = types.type_array(&e.tt, b, 2);
    assert(types.type_layout_begin(a));
    // The field is an array, and the struct behind it is what needs a layout.
    assert(types.type_layout_pending(pair) == b);
    assert(types.type_layout_begin(b));
    assert(types.type_layout_pending(a) == a);
    assert(!types.type_layout_begin(a));
    types.type_layout_fail(a);
    types.type_layout_fail(b);
    assert(types.type_layout_state(a) == types.layout_state.l_error);
    assert(types.type_sizeof(pair) == 0);
    // A struct that holds the failed array still lays out.
    types.node* holder = types.type_struct(&e.tt, "holder", decl_at(22));
    types.node*[2] mut fields = {types_env.type_of(&e, "i32"), pair};
    u64[2] mut offsets = {};
    assert(types.type_layout_begin(holder));
    assert(types.type_layout_struct(holder, fields[..], offsets[..]));
    assert(types.type_sizeof(holder) == 4);
}

fn void a_failed_struct_can_be_a_field_of_another() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node* bad = types.type_struct(&e.tt, "bad", decl_at(23));
    types.type_layout_fail(bad);
    types.node* holder = types.type_struct(&e.tt, "holder", decl_at(0));
    types.node*[2] mut fields = {types_env.type_of(&e, "i32"), bad};
    u64[2] mut offsets = {};
    assert(types.type_layout_pending(bad) == null);
    assert(types.type_layout_begin(holder));
    assert(types.type_layout_struct(holder, fields[..], offsets[..]));
    assert(offsets[1] == 4);
    assert(types.type_sizeof(holder) == 4);
    assert(types.type_alignof(holder) == 4);
}

// ---- the size ceiling (D3.4) ----------------------------------------------------

fn void a_type_at_the_ceiling_still_fits() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node* u8t = types_env.type_of(&e, "u8");
    types.node* biggest = types.type_array(&e.tt, u8t, MAX_SIZE);
    assert(types.type_size_fits(biggest));
    assert(types.type_sizeof(biggest) == MAX_SIZE);
    assert(types.type_alignof(biggest) == 1);
    // The largest `i64` array holds an eighth as many elements.
    types.node* eighth = types.type_array(&e.tt, types_env.type_of(&e, "i64"), MAX_SIZE >> 3);
    assert(types.type_size_fits(eighth));
    assert(types.type_sizeof(eighth) == (MAX_SIZE >> 3) << 3);
    assert(!types.type_size_fits(
        types.type_array(&e.tt, types_env.type_of(&e, "i64"), (MAX_SIZE >> 3) + 1)));
}

fn void a_type_past_the_ceiling_does_not_fit() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node* u8t = types_env.type_of(&e, "u8");
    // One byte past the ceiling, and a product that would wrap.
    assert(!types.type_size_fits(types.type_array(&e.tt, u8t, MAX_SIZE + 2)));
    assert(!types.type_size_fits(
        types.type_array(&e.tt, types_env.type_of(&e, "i32"), MAX_SIZE)));
    assert(!types.type_size_fits(
        types.type_array(&e.tt, types_env.type_of(&e, "i64"), MAX_SIZE)));
    assert(!types.type_size_fits(types.type_array(&e.tt, e.point, MAX_SIZE)));
    // Nested arrays multiply, and the ceiling holds through them.
    types.node* row = types.type_array(&e.tt, u8t, 8589934592);
    assert(types.type_size_fits(row));
    assert(!types.type_size_fits(types.type_array(&e.tt, row, 2147483648)));
    assert(types.type_size_fits(types.type_array(&e.tt, row, 536870912)));
    // A reference to an object that could never exist is 8 or 16 bytes and
    // fits: only the object itself is too large (D3.4, D3.5).
    assert(types.type_size_fits(
        types.type_ptr(&e.tt, types.type_array(&e.tt, u8t, MAX_SIZE), false, false)));
    assert(types.type_size_fits(types.type_span(&e.tt, u8t, false, false)));
}

// struct twice { u8[2^62] a; u8[2^62] b; }: each field fits, the two together
// do not (D3.4).
fn void a_struct_past_the_ceiling_is_reported_like_a_cycle() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node* half = types.type_array(&e.tt, types_env.type_of(&e, "u8"),
                                        (MAX_SIZE >> 1) + 1);
    assert(types.type_size_fits(half));
    types.node* twice = types.type_struct(&e.tt, "twice", decl_at(1));
    types.node*[2] mut fields = {half, half};
    u64[2] mut offsets = {};
    assert(types.type_layout_begin(twice));
    assert(!types.type_layout_struct(twice, fields[..], offsets[..]));
    // The struct is left as the infinite-size error leaves one.
    assert(types.type_layout_state(twice) == types.layout_state.l_error);
    assert(types.type_sizeof(twice) == 0);
    assert(types.type_alignof(twice) == 1);
    assert(types.type_layout_pending(twice) == null);
}

fn void a_struct_with_a_field_past_the_ceiling_fails() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node* big = types.type_struct(&e.tt, "big", decl_at(2));
    types.node*[2] mut fields = {types_env.type_of(&e, "u8"),
                                 types.type_array(&e.tt, types_env.type_of(&e, "i32"),
                                                  MAX_SIZE)};
    u64[2] mut offsets = {};
    assert(!types.type_size_fits(fields[1]));
    assert(types.type_layout_begin(big));
    assert(!types.type_layout_struct(big, fields[..], offsets[..]));
    assert(types.type_layout_state(big) == types.layout_state.l_error);
    assert(types.type_sizeof(big) == 0);
    // A struct that failed is a field like any other failed struct.
    assert(!types.type_is_owning_aggregate(big));
    assert(types.type_size_fits(big));
}

// struct edge { i64 a; u8[2^63 - 9] b; }: every field fits and so does their
// sum, which is the ceiling exactly, but rounding the size up to the alignment
// of `i64` passes it (D3.4, D3.8).
fn void rounding_the_size_up_cannot_push_a_struct_past_the_ceiling() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node* edge = types.type_struct(&e.tt, "edge", decl_at(3));
    types.node*[2] mut fields = {types_env.type_of(&e, "i64"),
                                 types.type_array(&e.tt, types_env.type_of(&e, "u8"),
                                                  MAX_SIZE - 8)};
    u64[2] mut offsets = {};
    assert(types.type_size_fits(fields[1]));
    assert(types.type_layout_begin(edge));
    assert(!types.type_layout_struct(edge, fields[..], offsets[..]));
    assert(types.type_layout_state(edge) == types.layout_state.l_error);
    assert(types.type_sizeof(edge) == 0);
    // One byte less and the same struct lays out, its size rounded to 2^63
    // minus 8.
    types.node* fits = types.type_struct(&e.tt, "fits", decl_at(4));
    types.node*[2] mut small = {types_env.type_of(&e, "i64"),
                                types.type_array(&e.tt, types_env.type_of(&e, "u8"),
                                                 MAX_SIZE - 15)};
    u64[2] mut small_offsets = {};
    assert(types.type_layout_begin(fits));
    assert(types.type_layout_struct(fits, small[..], small_offsets[..]));
    assert(small_offsets[1] == 8);
    assert(types.type_sizeof(fits) == MAX_SIZE - 7);
    assert(types.type_alignof(fits) == 8);
}

// struct edge { u8[2^63 - 1] a; u8 b; }: the second field is one byte past the
// ceiling.
fn void alignment_padding_cannot_push_a_struct_past_the_ceiling() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node* edge = types.type_struct(&e.tt, "edge", decl_at(5));
    types.node*[2] mut fields = {types.type_array(&e.tt, types_env.type_of(&e, "u8"), MAX_SIZE),
                                 types_env.type_of(&e, "u8")};
    u64[2] mut offsets = {};
    assert(types.type_layout_begin(edge));
    assert(!types.type_layout_struct(edge, fields[..], offsets[..]));
    assert(types.type_layout_state(edge) == types.layout_state.l_error);
    // The same struct with the big field alone lays out at the ceiling.
    types.node* just = types.type_struct(&e.tt, "just", decl_at(6));
    u64[1] mut just_offsets = {};
    assert(types.type_layout_begin(just));
    assert(types.type_layout_struct(just, fields[..1], just_offsets[..]));
    assert(types.type_sizeof(just) == MAX_SIZE);
    assert(types.type_alignof(just) == 1);
}

