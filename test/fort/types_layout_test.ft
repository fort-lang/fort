    sizeof_and_alignof_of_every_type_form();
    sizeof_of_the_suffix_shapes_of_d3_6();
    sizeof_of_function_types_with_suffixes();
    sizeof_of_the_error_type_is_zero();
    sizeof_of_arrays_of_structs_and_spans();
    println("sizes ok");
    layout_of_rec_matches_the_c_abi();
    layout_of_a_map_entry_is_40_bytes();
    layout_of_a_struct_with_a_struct_field();
    layout_of_arrays_spans_and_pointers_in_a_struct();
    layout_of_a_struct_holding_a_struct_array();
    layout_packs_the_primitives_by_alignment();
    layout_rounds_the_size_up_to_the_alignment();
    layout_of_reference_and_function_pointer_fields();
    println("layout ok");
    owning_aggregates_are_recognised_through_fields_and_elements();
    owning_reaches_through_arrays_of_structs_and_struct_fields();
    layout_of_a_struct_with_an_owned_pointer_field();
    println("owning ok");
    layout_pending_names_the_struct_a_size_needs();
    a_value_containment_cycle_is_reported_once();
    a_struct_containing_itself_by_value_is_a_cycle();
    a_cycle_through_an_array_field_is_found_too();
    a_failed_struct_can_be_a_field_of_another();
    println("cycles ok");
    a_type_at_the_ceiling_still_fits();
    a_type_past_the_ceiling_does_not_fit();
    a_struct_past_the_ceiling_is_reported_like_a_cycle();
    a_struct_with_a_field_past_the_ceiling_fails();
    rounding_the_size_up_cannot_push_a_struct_past_the_ceiling();
    alignment_padding_cannot_push_a_struct_past_the_ceiling();
    println("ceiling ok");
    println("ok");
    return 0;
}
