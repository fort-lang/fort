//! run
//! flags: -I ../../src/fort -I support -I ../../src
//! abort
//! stderr: panic: json.bool_of: not a boolean
//! stdout:
//| the two booleans ok
import lsp.json;

// bool_of answers a k_bool node. The string "true" is a string and not a
// boolean, so asking it is a violated precondition and panics (D13.3).
fn i32 main() {
    json.doc mut d = json.create();
    defer json.free(&d);
    assert(json.parse(&d, "[true,false,\"true\"]"));
    u32 root = json.root(&d);
    assert(json.bool_of(&d, json.at_of(&d, root, 0)));
    assert(!json.bool_of(&d, json.at_of(&d, root, 1)));
    println("the two booleans ok");
    println(json.bool_of(&d, json.at_of(&d, root, 2)));
    return 0;
}
