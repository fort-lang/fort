//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: types.type_ref_at: level 0 is not a reference
//! stdout:
//| true
/// Level 0 is the binding's own storage and lives outside the type, so it is
/// not a reference type_ref_at can report.
import fort.types;
import types_env;

fn main() i32 {
    types_env.env mut* own e = types_env.make();
    defer types_env.drop_made(move(e));
    println(types.type_ref_at(types_env.type_of(e, "node*"), 1) != null);
    println(types.type_ref_at(types_env.type_of(e, "node*"), 0) != null);
    return 0;
}
