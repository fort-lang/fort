//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: json: no container is open
//! stdout:
//| opened and closed ok
import json;
import json_env;

// Closing a container that was never opened is a violated precondition and
// panics (D13.3): the depth would otherwise underflow and every comma after it
// would be wrong.
fn i32 main() {
    json_env.env mut e = json_env.env{};
    json_env.open(&e);
    defer json_env.close(&e);
    json.json_object_begin(&e.j);
    json.json_object_end(&e.j);
    println("opened and closed ok");
    json.json_object_end(&e.j);
    println(json_env.written(&e));
    return 0;
}
