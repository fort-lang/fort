//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: gen.refs_at: index out of range
//! stdout:
//| 0
/// refs_at reads one node of a vector while the index is below len, as records_at does. An
/// empty vector holds no node at index 0, so the call panics.
import gen;

fn main() i32 {
    gen.node_ref_vec mut v = gen.node_ref_vec{};
    defer gen.refs_free(&v);
    println(v.len);
    gen.refs_at(&v, 0);
    return 0;
}
