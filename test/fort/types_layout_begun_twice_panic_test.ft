//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: types.type_layout_begin: layout begun twice
//! stdout:
//| true
import types;
import types_env;

// A struct is laid out once: beginning a resolved one is a broken
// precondition, and a second `begin` on a resolving one is the cycle the
// caller reports instead.
// D3.8
fn main() i32 {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    println(types.type_layout_begin(e.rec));
    println(types.type_layout_begin(e.point));
    return 0;
}
