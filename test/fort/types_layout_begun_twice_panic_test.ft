//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: types.type_layout_begin: layout begun twice
//! stdout:
//| true
import types;
import types_env;

/// Checks that struct layout begins once. A second begin breaks the precondition or reports a
/// resolution cycle.
fn main() i32 {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    println(types.type_layout_begin(e.rec));
    println(types.type_layout_begin(e.point));
    return 0;
}
