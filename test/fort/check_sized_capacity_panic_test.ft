//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: check.sized_capacity: capacity overflow
//! stdout:
//| 16 32
/// sized_capacity gives the list of waiting size checks its first capacity and doubles
/// it after that. It panics when the double does not fit u64. The test passes U64_MAX.
import check;
import containers;

fn main() i32 {
    println(check.sized_capacity(0), " ", check.sized_capacity(16));
    check.sized_capacity(containers.U64_MAX);
    return 0;
}
