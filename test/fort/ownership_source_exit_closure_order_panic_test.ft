//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: ownership_source_exit: invalid closure order
//! stdout:
//| false
/// solve_closure runs once, after collect. A closure that collect never ran on breaks that
/// order, so the call panics before it reads a body.
import ownership_source_exit;

fn main() i32 {
    ownership_source_exit.closure mut x = ownership_source_exit.closure{};
    ownership_source_exit.context mut* [1] bodies = {null};
    println(x.collected);
    ownership_source_exit.solve_closure(&x, bodies[..0], true);
    return 0;
}
