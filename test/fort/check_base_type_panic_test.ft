//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: check.base_type: not a base type
//! stdout:
//| true
/// base_type reads a type node that the parser made. An identifier in an expression is no
/// type node, so the call breaks the precondition and panics.
import ast;
import check;
import check_env;

fn main() i32 {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    println(check_env.open_module(&e, "fn main() i32 {\n    i32 k = 1;\n    return k;\n}\n"));
    ast.node mut* id = check_env.node_in_main(&e, ast.ast_kind.k_ident, "k");
    check.base_type(&e.ck, id, false, false);
    return 0;
}
