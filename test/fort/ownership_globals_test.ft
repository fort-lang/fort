    ownership_globals_env.select_entry(&e, false, true);
    ownership_globals_env.caller_input(&e, ownership_globals_env.case_place(&e, 1), false);
    if (mapped) { e.input.contents[0].borrows = e.relations[0..0]; }
    else {
        e.global.entry_selected = false;
        e.global.callback_map_complete_proved = false;
    }
    ownership_state.state mut saved = ownership_state.clone(&e.input);
    failed_entry(&e, run_case(&e), ownership_api.incomplete_reason.missing_correspondence, &saved);
    assert(e.caller_inputs[0].source.key.ordinal == 40);
    ownership_state.free(&saved);
    ownership_globals_env.close(&e);
}

fn case_g8_i2() void {
    missing_caller(true);
    missing_caller(false);
    println("G8-I2 ok");
}

fn put_and_clear(ownership_globals_env.env mut* e, u32 id, u64 alternatives) void {
    ownership_globals_env.case_open(e, id);
    e->projections = new(ownership_api.projection, 1);
    e->projections[0] = ownership_api.projection{
        .kind = ownership_api.projection_kind.field, .field = 11};
    ownership_api.place_path mut pool = ownership_globals_env.case_place(e, 2);
    pool.projections = e->projections[..];
    e->descriptors[0].place = pool;
    ownership_globals_env.add_owner(e, ownership_globals_env.case_place(e, 1), 10, 4);
    ownership_globals_env.add_empty(e, pool);
    ownership_globals_env.add_effect(e, ownership_api.effect_kind.transfer,
        ownership_globals_env.case_place(e, 1), pool, 10);
    ownership_globals_env.add_effect(e, ownership_api.effect_kind.release, pool, pool, 10);
    ownership_globals_env.select_entry(e, true, false);
    ownership_globals_env.select_calls(e, 1, alternatives);
}

fn refused_summary(u64 bound) void {
    ownership_globals_env.env mut e = ownership_globals_env.env{};
    put_and_clear(&e, 34, 1);
    e.events.budget.bounds.w = bound;
    ownership_state.state mut saved = ownership_state.clone(&e.input);
    ownership_api.global_result out = run_case(&e);
    assert(out.proof.terminal.reason == ownership_api.incomplete_reason.work_limit);
    assert(out.proof.terminal.limit.used <= bound && e.events.len == 1);
    assert(ownership_events.at(&e.events, 0)->kind == ownership_api.event_kind.work_failure);
    assert(e.global.paths.len == 0 && e.global.ordered.len == 0);
    assert(ownership_state.equal(&e.input, &saved));
    ownership_state.free(&saved);
    ownership_globals_env.close(&e);
}

fn case_g9_a1() void {
    ownership_globals_env.env mut e = ownership_globals_env.env{};
    put_and_clear(&e, 34, 1);
    ownership_state.state mut saved = ownership_state.clone(&e.input);
    ownership_api.global_result mut out = run_case(&e);
    accepted(&e, out);
    assert(out.persistent[0].initial.owner_empty);
    assert(e.global.retained.allocations[0].key.ordinal == 10);
    assert(!e.global.retained.allocations[0].obligation);
    assert(e.global.retained.sources[0].key.ordinal == 110);
    assert(e.global.retained.sources[0].validity == ownership_api.validity_kind.released);
    assert(e.global.ordered.len == 2 && e.global.paths.len == 1);
    assert(e.global.paths[0].state.allocations[0].history.len == 2);
    assert(e.global.paths[0].state.allocations[0].history[0].kind ==
        ownership_api.effect_kind.transfer);
    assert(e.global.paths[0].state.allocations[0].history[1].kind ==
        ownership_api.effect_kind.release);
    assert(ownership_state.equal(&e.input, &saved));
    ownership_state.free(&saved);
    u64 admitted = e.events.budget.used.w;
    ownership_api.global_request mut req = ownership_globals_env.request(&e);
    req.before = ownership_state.view(&e.global.retained);
    req.entry.globals = out.persistent;
    ownership_globals_env.release_input(&e);
    assert(e.global.ordered[0].effect.place.projections[0].field == 11);
    assert(e.global.ordered[1].binding.from.projections[0].field == 11);
    assert(e.global.paths[0].state.contents[1].place.projections[0].field == 11);
    assert(e.global.paths[0].state.contents.ptr != e.global.retained.contents.ptr);
    // The next two supplied calls read empty owner headers without allocation-source access.
    e.effects_len = 0;
    ownership_api.place_path pool = out.persistent[0].place;
    ownership_globals_env.add_effect(&e, ownership_api.effect_kind.read, pool, pool, 0);
    ownership_globals_env.add_effect(&e, ownership_api.effect_kind.read, pool, pool, 0);
    ownership_globals_env.select_calls(&e, 1, 1);
    req.outcome.effects = e.ordered[0..2];
    u64 before_reuse = e.events.budget.used.w;
    out = ownership_globals.solve(&e.global, &e.service, &req);
    accepted(&e, out);
    u64 reuse_work = e.events.budget.used.w - before_reuse;
    assert(e.global.ordered[1].call_index == 1 && e.global.paths.len == 1);
    req.before = ownership_state.view(&e.global.retained);
    req.entry.globals = out.persistent;
    ownership_globals_env.release_input(&e);
    // A successful replacement releases the previous result's borrowed projections.
    e.effects_len = 0;
    ownership_api.place_path fresh_pool = out.persistent[0].place;
    ownership_globals_env.add_effect(&e, ownership_api.effect_kind.read, fresh_pool, fresh_pool, 0);
    ownership_globals_env.add_effect(&e, ownership_api.effect_kind.read, fresh_pool, fresh_pool, 0);
    ownership_globals_env.select_calls(&e, 1, 1);
    req.outcome.effects = e.ordered[0..2];
    assert(req.outcome.effects[0].place.projections.ptr == fresh_pool.projections.ptr);
    assert(req.outcome.effects[1].place.projections.ptr == fresh_pool.projections.ptr);
    assert(e.summaries[0].effect.place.projections.ptr == fresh_pool.projections.ptr);
    assert(e.summaries[1].binding.from.projections.ptr == fresh_pool.projections.ptr);
    assert(req.outcome.effects[0].place.projections[0].field == 11);
    assert(req.outcome.effects[1].place.projections[0].field == 11);
    assert(e.summaries[0].effect.place.projections[0].field == 11);
    assert(e.summaries[1].binding.from.projections[0].field == 11);
    ownership_state.state mut prior = ownership_state.clone(&e.global.retained);
    ownership_globals.summary_effect mut* ordered = e.global.ordered.ptr;
    ownership_globals.path_snapshot mut* paths = e.global.paths.ptr;
    e.events.budget.bounds.w = e.events.budget.used.w + reuse_work - 1;
    ownership_api.global_result failed = ownership_globals.solve(&e.global, &e.service, &req);
    assert(failed.proof.terminal.reason == ownership_api.incomplete_reason.work_limit);
    assert(e.global.ordered.ptr == ordered && e.global.paths.ptr == paths);
    assert(ownership_state.equal(&e.global.retained, &prior));
    assert(ownership_state.equal(&e.global.paths[0].state, &prior));
    assert(out.persistent[0].initial.owner_empty);
    ownership_state.free(&prior);
    ownership_globals_env.close(&e);
    u64[4] bounds = {2, 16, 64, admitted - 1};
    for (u64 bound : bounds) { refused_summary(bound); }
    ownership_globals_env.env mut alternatives = ownership_globals_env.env{};
    put_and_clear(&alternatives, 34, 2);
    ownership_api.global_result joined = run_case(&alternatives);
    accepted(&alternatives, joined);
    assert(alternatives.global.paths.len == 2);
    assert(alternatives.global.paths[0].state.contents.ptr !=
        alternatives.global.paths[1].state.contents.ptr);
    assert(ownership_state.equal(&alternatives.global.paths[0].state,
        &alternatives.global.paths[1].state));
    ownership_globals_env.release_input(&alternatives);
    assert(alternatives.global.paths[1].state.contents[1].place.projections[0].field == 11);
    ownership_globals_env.close(&alternatives);
    println("G9-A1 ok");
}

fn cleanup_exit(ownership_globals_env.env mut* e) void { cleanup_exit_case(e, 35); }

fn cleanup_exit_case(ownership_globals_env.env mut* e, u32 id) void {
    ownership_globals_env.case_open(e, id);
    ownership_globals_env.add_owner(e, ownership_globals_env.case_place(e, 2), 10, 4);
    ownership_globals_env.add_empty(e, ownership_globals_env.case_place(e, 1));
    ownership_globals_env.add_effect(e, ownership_api.effect_kind.release,
        ownership_globals_env.case_place(e, 2), ownership_globals_env.case_place(e, 2), 10);
    ownership_globals_env.owner_end(e, ownership_globals_env.case_place(e, 2), 0);
    ownership_globals_env.select_entry(e, true, false);
    e->global.normal_cleanup_complete_proved = true;
    e->global.graph_complete_proved = true;
    ownership_globals_env.select_calls(e, 1, 1);
}

fn incomplete_exit(u64 variant) void {
    ownership_globals_env.env mut e = ownership_globals_env.env{};
    cleanup_exit(&e);
    // The request views the input, so input changes come first.
    // Variants 5 and 6 add a residual node or edge outside the released graph.
    // Variant 7 adds an owner whose transfer is pending.
    if (variant == 5 || variant == 6) {
        ownership_state.append_nodes(&e.input, ownership_api.graph_node{
            .key = ownership_globals_env.case_key(&e, ownership_api.entity_kind.graph_node, 10),
            .allocation = ownership_globals_env.case_key(&e,
                ownership_api.entity_kind.allocation, 10)});
        ownership_state.append_nodes(&e.input, ownership_api.graph_node{
            .key = ownership_globals_env.case_key(&e, ownership_api.entity_kind.graph_node, 50),
            .residual = variant == 5});
    }
    if (variant == 6) {
        ownership_state.append_edges(&e.input, ownership_api.graph_edge{
            .key = ownership_globals_env.case_key(&e, ownership_api.entity_kind.relation, 501),
            .from = e.input.nodes[1].key, .kind = ownership_api.edge_kind.residual,
            .place = ownership_globals_env.case_place(&e, 12)});
    }
    if (variant == 7) {
        ownership_api.allocation_fact mut pending = e.input.allocations[0];
        pending.key = ownership_globals_env.case_key(&e, ownership_api.entity_kind.allocation, 30);
        pending.owner.place = ownership_globals_env.case_place(&e, 12);
        pending.owner.transfer_pending = true;
        ownership_state.append_allocations(&e.input, pending);
    }
    ownership_api.global_request mut req = ownership_globals_env.normal_request(&e);
    if (variant == 0) { e.global.normal_cleanup_complete_proved = false; }
    if (variant == 1) { e.global.entry_map_complete_proved = false; }
    if (variant == 2) { req.outcome.cleanup_proved = false; }
    if (variant == 4) { e.global.graph_complete_proved = false; }
    if (variant == 3) {
        ownership_globals_env.add_effect(&e, ownership_api.effect_kind.read,
            ownership_globals_env.case_place(&e, 1), ownership_globals_env.case_place(&e, 1), 0);
        del(e.summaries);
        del(e.paths);
        ownership_globals_env.select_calls(&e, 1, 1);
        req.outcome.effects = e.ordered[0..3];
    }
    ownership_state.state mut saved = ownership_state.clone(&e.input);
    ownership_api.global_result out = ownership_globals.solve(&e.global, &e.service, &req);
    if (variant == 1 || variant == 2) {
        failed_entry(&e, out, variant == 1 ? ownership_api.incomplete_reason.missing_path :
            ownership_api.incomplete_reason.missing_boundary, &saved);
    } else {
        failed_case(&e, out, 1, ownership_api.event_kind.incomplete_proof,
            variant >= 4 && variant <= 6 ? ownership_api.incomplete_reason.missing_graph :
            ownership_api.incomplete_reason.missing_boundary, 0, &saved);
    }
    ownership_state.free(&saved);
    ownership_globals_env.close(&e);
}

fn case_g9_a2() void {
    ownership_globals_env.env mut e = ownership_globals_env.env{};
    cleanup_exit(&e);
    ownership_state.state mut saved = ownership_state.clone(&e.input);
    ownership_api.global_request req = ownership_globals_env.normal_request(&e);
    ownership_api.global_result out = ownership_globals.solve(&e.global, &e.service, &req);
    assert(ownership_api.successful(out.proof) && out.boundary_proved && e.events.len == 0);
    assert(out.persistent[0].initial.owner_empty && !e.global.retained.allocations[0].obligation);
    assert(e.global.paths[0].state.sources[0].validity == ownership_api.validity_kind.released);
    assert(ownership_state.equal(&e.input, &saved));
    ownership_state.free(&saved);
    ownership_globals_env.close(&e);
    u64 mut variant = 0;
    while (variant < 8) { incomplete_exit(variant); variant += 1; }
    ownership_globals_env.env mut caller = ownership_globals_env.env{};
    cleanup_exit(&caller);
    ownership_globals_env.add_owner(&caller, ownership_globals_env.case_place(&caller, 3), 20, 1);
    caller.transitions[1].from = ownership_globals_env.case_place(&caller, 3);
    caller.summaries[1].binding.from = caller.transitions[1].from;
    ownership_state.state mut caller_saved = ownership_state.clone(&caller.input);
    ownership_api.global_request caller_req = ownership_globals_env.normal_request(&caller);
    ownership_api.global_result failed = ownership_globals.solve(
        &caller.global, &caller.service, &caller_req);
    failed_relation(&caller, failed, 1, ownership_api.event_kind.lost_ownership,
        ownership_api.incomplete_reason.none, ownership_api.entity_kind.allocation, 20,
        ownership_globals_env.case_place(&caller, 3), &caller_saved);
    ownership_state.free(&caller_saved);
    ownership_globals_env.close(&caller);
    println("G9-A2 ok");
}

fn clear_and_read(ownership_globals_env.env mut* e, bool conditional) void {
    ownership_globals_env.case_open(e, 36);
    ownership_globals_env.add_owner(e, ownership_globals_env.case_place(e, 2), 10, 4);
    ownership_api.place_path borrowed = ownership_globals_env.case_place(e, 3);
    ownership_api.borrow_relation mut relation = e->input.contents[0].borrows[0];
    relation.containing = borrowed;
    ownership_api.borrow_relation[1] relations = {relation};
    ownership_api.contents_fact mut value = e->input.contents[0];
    value.place = borrowed;
    value.borrows = relations[..];
    ownership_state.append_contents(&e->input, value);
    ownership_globals_env.add_effect(e, ownership_api.effect_kind.release,
        ownership_globals_env.case_place(e, 2), ownership_globals_env.case_place(e, 2), 10);
    ownership_globals_env.add_effect(e, ownership_api.effect_kind.read, borrowed, borrowed, 10);
    ownership_globals_env.select_entry(e, true, false);
    ownership_globals_env.select_calls(e, 1, 1);
    if (conditional) {
        e->paths[0].guard = ownership_globals_env.case_key(e, ownership_api.entity_kind.guard, 400);
        e->paths[0].guard_proved = true;
    }
}

fn case_g9_r1() void {
    ownership_globals_env.env mut e = ownership_globals_env.env{};
    clear_and_read(&e, false);
    ownership_state.state mut saved = ownership_state.clone(&e.input);
    ownership_api.global_result out = run_case(&e);
    failed_relation(&e, out, 1, ownership_api.event_kind.invalid_use,
        ownership_api.incomplete_reason.none, ownership_api.entity_kind.source, 110,
        ownership_globals_env.case_place(&e, 3), &saved);
    ownership_state.free(&saved);
    ownership_globals_env.close(&e);
    ownership_globals_env.env mut conditional = ownership_globals_env.env{};
    clear_and_read(&conditional, true);
    ownership_state.state mut conditional_saved = ownership_state.clone(&conditional.input);
    ownership_api.global_result uncertain = run_case(&conditional);
    failed_relation(&conditional, uncertain, 1, ownership_api.event_kind.incomplete_proof,
        ownership_api.incomplete_reason.missing_correspondence, ownership_api.entity_kind.source,
        110, ownership_globals_env.case_place(&conditional, 3), &conditional_saved);
    ownership_state.free(&conditional_saved);
    ownership_globals_env.close(&conditional);
    u64 mut mismatch = 0;
    while (mismatch < 2) {
        ownership_globals_env.env mut wrong = ownership_globals_env.env{};
        clear_and_read(&wrong, false);
        if (mismatch == 0) {
            wrong.ordered[1].allocation = ownership_globals_env.case_key(&wrong,
                ownership_api.entity_kind.allocation, 20);
        } else {
            wrong.ordered[1].source = ownership_globals_env.case_key(&wrong,
                ownership_api.entity_kind.source, 999);
        }
        wrong.summaries[1].effect = wrong.ordered[1];
        ownership_state.state mut wrong_saved = ownership_state.clone(&wrong.input);
        ownership_api.global_result unproved = run_case(&wrong);
        failed_case(&wrong, unproved, 1, ownership_api.event_kind.incomplete_proof,
            ownership_api.incomplete_reason.missing_correspondence, mismatch == 0 ? 20 : 10,
            &wrong_saved);
        ownership_state.free(&wrong_saved);
        ownership_globals_env.close(&wrong);
        mismatch += 1;
    }
    println("G9-R1 ok");
}

fn case_g9_r2() void {
    ownership_globals_env.env mut e = ownership_globals_env.env{};
    ownership_globals_env.case_open(&e, 37);
    ownership_globals_env.add_owner(&e, ownership_globals_env.case_place(&e, 1), 10, 4);
    ownership_globals_env.add_owner(&e, ownership_globals_env.case_place(&e, 3), 20, 4);
    ownership_globals_env.add_empty(&e, ownership_globals_env.case_place(&e, 2));
    ownership_globals_env.add_effect(&e, ownership_api.effect_kind.transfer,
        ownership_globals_env.case_place(&e, 1), ownership_globals_env.case_place(&e, 2), 10);
    ownership_globals_env.add_effect(&e, ownership_api.effect_kind.transfer,
        ownership_globals_env.case_place(&e, 3), ownership_globals_env.case_place(&e, 2), 20);
    ownership_globals_env.select_entry(&e, true, false);
    ownership_globals_env.select_calls(&e, 1, 1);
    ownership_state.state mut saved = ownership_state.clone(&e.input);
    ownership_api.global_result out = run_case(&e);
    failed_case(&e, out, 1, ownership_api.event_kind.lost_ownership,
        ownership_api.incomplete_reason.none, 10, &saved);
    ownership_state.free(&saved);
    ownership_globals_env.close(&e);
    println("G9-R2 ok");
}

fn missing_summary(u64 variant) void {
    ownership_globals_env.env mut e = ownership_globals_env.env{};
    put_and_clear(&e, 38, 1);
    if (variant == 0) { e.summaries[0].summary_proved = false; }
    if (variant == 1) { e.paths[0].effects_len = 1; }
    if (variant == 2) { e.summaries[0].target = ownership_api.function_id{}; }
    if (variant == 3) { e.summaries[0].binding.key.ordinal += 1; }
    if (variant == 4) { e.paths[0].effects_begin = ownership_api.U64_MAX; }
    ownership_state.state mut saved = ownership_state.clone(&e.input);
    ownership_api.global_result out = run_case(&e);
    ownership_api.incomplete_reason reason = variant < 2 ?
        ownership_api.incomplete_reason.unknown_effect :
        (variant == 4 ? ownership_api.incomplete_reason.invalid_input :
        ownership_api.incomplete_reason.missing_correspondence);
    failed_entry(&e, out, reason, &saved);
    ownership_state.free(&saved);
    ownership_globals_env.close(&e);
}

fn case_g9_i1() void {
    u64 mut variant = 0;
    while (variant < 5) { missing_summary(variant); variant += 1; }
    println("G9-I1 ok");
}

fn case_g9_i2() void {
    ownership_globals_env.env mut e = ownership_globals_env.env{};
    put_and_clear(&e, 39, 2);
    e.paths[1].graph_complete_proved = false;
    ownership_state.state mut saved = ownership_state.clone(&e.input);
    ownership_api.global_result out = run_case(&e);
    failed_entry(&e, out, ownership_api.incomplete_reason.missing_graph, &saved);
    ownership_state.free(&saved);
    ownership_globals_env.close(&e);
    ownership_globals_env.env mut divergent = ownership_globals_env.env{};
    put_and_clear(&divergent, 39, 2);
    divergent.summaries[3].effect.kind = ownership_api.effect_kind.read;
    ownership_state.state mut divergent_saved = ownership_state.clone(&divergent.input);
    ownership_api.global_result unjoined = run_case(&divergent);
    failed_entry(&divergent, unjoined, ownership_api.incomplete_reason.missing_path,
        &divergent_saved);
    ownership_state.free(&divergent_saved);
    ownership_globals_env.close(&divergent);
    println("G9-I2 ok");
}

fn terminal_variant(u64 variant) void {
    ownership_globals_env.env mut e = ownership_globals_env.env{};
    ownership_globals_env.generated_setup(&e, 55, true, true);
    ownership_api.global_request mut req = ownership_globals_env.generated_request(&e);
    ownership_api.incomplete_reason mut reason = ownership_api.incomplete_reason.unknown_effect;
    if (variant == 0) { e.terminal_inputs[0].class_proved = false; }
    if (variant == 1) {
        req.outcome.possible_caller_return = true;
        e.terminal_inputs[0].outcome = req.outcome;
    }
    if (variant == 2) { e.cleanup[0] = e.ordered[0]; }
    if (variant == 3) {
        e.terminal_inputs[0].outcome.effects = e.ordered[0..1];
    }
    if (variant == 4) {
        e.global.normal_cleanup_complete_proved = false;
    }
    if (variant == 5) {
        req.outcome.kind = ownership_api.outcome_kind.unresolved_foreign;
        e.terminal_inputs[0].outcome = req.outcome;
    }
    if (variant == 6) {
        req.entry.final_boundary = e.ordered[1].operation;
        reason = ownership_api.incomplete_reason.missing_boundary;
    }
    ownership_state.state mut saved = ownership_state.clone(&e.input);
    ownership_api.global_result out = ownership_globals.solve(&e.global, &e.service, &req);
    failed_entry(&e, out, reason, &saved);
    assert(e.global.startup.len == 0 && e.global.terminals.len == 0 &&
        e.global.terminal_effects.len == 0);
    ownership_state.free(&saved);
    ownership_globals_env.close(&e);
}

fn terminal_refusal(u64 work) void {
    ownership_globals_env.env mut e = ownership_globals_env.env{};
    ownership_globals_env.generated_setup(&e, 56, true, true);
    ownership_api.global_request req = ownership_globals_env.generated_request(&e);
    e.events.budget.bounds.w = work;
    ownership_state.state mut saved = ownership_state.clone(&e.input);
    ownership_api.global_result out = ownership_globals.solve(&e.global, &e.service, &req);
    assert(out.proof.terminal.reason == ownership_api.incomplete_reason.work_limit);
    assert(out.persistent.len == 0 && e.events.len == 1);
    assert(ownership_state.equal(&e.input, &saved));
    ownership_state.free(&saved);
    ownership_globals_env.close(&e);
}

fn terminal_reuse() void {
    ownership_globals_env.env mut e = ownership_globals_env.env{};
    ownership_globals_env.generated_setup(&e, 56, true, true);
    ownership_api.global_request req = ownership_globals_env.generated_request(&e);
    ownership_api.global_result out = ownership_globals.solve(&e.global, &e.service, &req);
    assert(ownership_api.successful(out.proof));
    u64 admitted = e.events.budget.used.w;
    ownership_api.global_request mut reused = ownership_globals_env.request(&e);
    reused.before = ownership_state.view(&e.global.retained);
    reused.entry.globals = out.persistent;
    reused.entry.startup = e.global.startup[..];
    reused.entry.cleanup = out.cleanup;
    reused.outcome = e.global.terminals[0].outcome;
    reused.entry.boundary_present = true;
    reused.entry.final_boundary = req.entry.final_boundary;
    ownership_api.ordered_effect mut* startup = e.global.startup.ptr;
    ownership_globals.terminal_record mut* terminal = e.global.terminals.ptr;
    ownership_api.ordered_effect mut* effects = e.global.terminal_effects.ptr;
    ownership_state.state mut saved = ownership_state.clone(&e.global.retained);
    e.events.budget.bounds.w = e.events.budget.used.w + 64;
    ownership_api.global_result failed = ownership_globals.solve(&e.global, &e.service, &reused);
    assert(failed.proof.terminal.reason == ownership_api.incomplete_reason.work_limit);
    assert(e.global.startup.ptr == startup && e.global.terminals.ptr == terminal &&
        e.global.terminal_effects.ptr == effects);
    assert(ownership_state.equal(&e.global.retained, &saved));
    ownership_state.free(&saved);
    e.events.budget.bounds.w = ownership_limits.PRODUCTION_W;
    e.global.terminals[0].outcome.kind = ownership_api.outcome_kind.abort;
    e.global.terminals[0].outcome.cleanup_required = false;
    e.global.terminals[0].outcome.cleanup_proved = false;
    e.global.terminals[0].outcome.effects = e.global.terminal_effects[0..0];
    reused.entry.kind = ownership_api.entry_kind.library_symbolic;
    reused.entry.startup = e.global.startup[0..0];
    reused.entry.cleanup = out.cleanup[0..0];
    reused.entry.boundary_present = false;
    reused.outcome = e.global.terminals[0].outcome;
    ownership_api.global_result next = ownership_globals.solve(&e.global, &e.service, &reused);
    assert(ownership_api.successful(next.proof) && !next.boundary_proved);
    assert(e.global.terminals[0].outcome.kind == ownership_api.outcome_kind.abort);
    assert(e.global.retained.contents[1].owner_empty);
    ownership_globals_env.close(&e);
    u64[5] bounds = {2, 16, 64, 256, admitted - 1};
    for (u64 bound : bounds) { terminal_refusal(bound); }
}

fn generated_accept(u32 id) void {
    ownership_globals_env.env mut e = ownership_globals_env.env{};
    ownership_globals_env.generated_setup(&e, id, id != 41, true);
    if (id == 40) {
        e.projections = new(ownership_api.projection, 1);
        e.projections[0] = ownership_api.projection{
            .kind = ownership_api.projection_kind.field, .field = 17};
        e.input.contents[1].place.projections = e.projections[..];
        e.descriptors[0].place = e.input.contents[1].place;
        e.descriptors[0].initial = e.input.contents[1];
        e.entry_bindings[0].place = e.descriptors[0].place;
        e.ordered[0].place = e.descriptors[0].place;
        e.ordered[1].place = e.descriptors[0].place;
        e.ordered[2].place = e.descriptors[0].place;
        e.transitions[1].from = e.descriptors[0].place;
        e.transitions[2].from = e.descriptors[0].place;
        e.cleanup[0] = e.ordered[1];
    }
    ownership_api.global_request req = ownership_globals_env.generated_request(&e);
    if (id == 40) { e.terminal_inputs[0].caller = e.descriptors[0].place; }
    ownership_state.state mut saved = ownership_state.clone(&e.input);
    ownership_api.global_result out = ownership_globals.solve(&e.global, &e.service, &req);
    assert(ownership_api.successful(out.proof) && out.boundary_proved && e.events.len == 0);
    assert(out.persistent[0].initial.owner_empty && e.global.startup.len == 1);
    assert(e.global.terminals.len == 1 && e.global.terminal_effects.len == 2);
    assert(ownership_state.equal(&e.input, &saved));
    if (id != 41) {
        assert(!e.global.retained.allocations[0].obligation);
        assert(e.global.retained.sources[0].validity == ownership_api.validity_kind.released);
    }
    ownership_state.free(&saved);
    ownership_globals_env.release_input(&e);
    if (id == 40) {
        assert(e.global.startup[0].place.projections[0].field == 17);
        assert(e.global.terminals[0].caller.projections[0].field == 17);
        assert(e.global.terminals[0].outcome.effects[0].place.projections[0].field == 17);
    }
    assert(e.global.terminals[0].outcome.effects[0].kind == ownership_api.effect_kind.release);
    assert(e.global.terminals[0].outcome.effects.ptr ==
        cast(e.global.terminal_effects.ptr, ownership_api.ordered_effect*));
    ownership_globals_env.close(&e);
}

fn case_g5_a1() void {
    generated_accept(40);
    terminal_reuse();
    println("G5-A1 ok");
}
fn case_g5_a2() void { generated_accept(41); println("G5-A2 ok"); }
fn case_g5_a3() void { generated_accept(42); println("G5-A3 ok"); }

