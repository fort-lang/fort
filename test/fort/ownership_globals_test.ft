fn case_g3_r1() void {
    ownership_globals_env.env mut e = ownership_globals_env.env{};
    ownership_globals_env.case_open(&e, 13);
    ownership_globals_env.add_borrow(&e, ownership_globals_env.case_place(&e, 1), 40,
        ownership_api.source_kind.stack, 1);
    ownership_globals_env.add_empty(&e, ownership_globals_env.case_place(&e, 2));
    ownership_globals_env.borrow_effect(&e, ownership_globals_env.case_place(&e, 1),
        ownership_globals_env.case_place(&e, 2), 40);
    ownership_globals_env.source_end(&e, 40);
    ownership_state.state mut saved = ownership_state.clone(&e.input);
    ownership_api.global_request mut first = ownership_globals_env.request(&e);
    first.outcome.effects = e.ordered[0..1];
    ownership_api.global_result mut out = ownership_globals.solve(&e.global, &e.service, &first);
    accepted(&e, out);
    ownership_state.state mut retained = ownership_state.clone(&e.global.retained);
    ownership_api.global_request mut ending = ownership_globals_env.request(&e);
    ending.before = ownership_state.view(&e.global.retained);
    ending.entry.globals = out.persistent;
    ending.outcome.effects = e.ordered[1..2];
    out = ownership_globals.solve(&e.global, &e.service, &ending);
    failed_relation(&e, out, 1, ownership_api.event_kind.invalid_use,
        ownership_api.incomplete_reason.none, ownership_api.entity_kind.source, 40,
        ownership_globals_env.case_place(&e, 2), &saved);
    assert(e.global.borrowed.len == 1 && e.global.borrowed[0].source.ordinal == 40);
    assert(ownership_state.equal(&e.global.retained, &retained));
    ownership_state.free(&retained);
    ownership_state.free(&saved);
    ownership_globals_env.close(&e);
    println("G3-R1 ok");
}

