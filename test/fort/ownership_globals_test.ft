fn residual_normal(u32 id, bool global) void {
    ownership_globals_env.env mut e = ownership_globals_env.env{};
    ownership_globals_env.generated_setup(&e, id, true, true);
    if (global) {
        ownership_api.global_input mut@ own both = new(ownership_api.global_input, 2);
        both[0] = e.descriptors[0];
        both[1] = ownership_api.global_input{
            .declaration = ownership_api.declaration_id{1, id + 100},
            .place = ownership_globals_env.case_place(&e, 3), .persistent = true, .symbolic = true};
        del(e.descriptors);
        e.descriptors = move(both);
    }
    ownership_globals_env.add_owner(&e, ownership_globals_env.case_place(&e, 3), 20, 0);
    if (global) {
        del(e.entry_bindings);
        ownership_globals_env.select_entry(&e, true, false);
    }
    e.transitions[2].from = ownership_globals_env.case_place(&e, 3);
    ownership_api.global_request req = ownership_globals_env.generated_request(&e);
    ownership_state.state mut saved = ownership_state.clone(&e.input);
    ownership_api.global_result out = ownership_globals.solve(&e.global, &e.service, &req);
    failed_relation(&e, out, 2, ownership_api.event_kind.lost_ownership,
        ownership_api.incomplete_reason.none, ownership_api.entity_kind.allocation, 20,
        ownership_globals_env.case_place(&e, 3), &saved);
    ownership_state.free(&saved);
    ownership_globals_env.close(&e);
}

fn case_g5_r2() void { residual_normal(44, true); println("G5-R2 ok"); }
fn case_g5_r3() void { residual_normal(45, false); println("G5-R3 ok"); }

