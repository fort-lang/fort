/// Tests supplied global states and ordered process boundaries (D17.19).
// Groups G1 to G9 hold the global obligation and process boundary rules of D17.19.
import ownership_api;
import ownership_events;
import ownership_keys;
import ownership_transfer;
import ownership_globals;
import ownership_globals_env;
import ownership_limits;
import ownership_state;

// This callback isolates the dispatch charge from the global copy work.
fn empty_service(void mut* unused, ownership_api.global_request* req)
    ownership_api.global_result {
    return ownership_api.global_result{.proof = ownership_api.proof_status{
        .kind = ownership_api.proof_kind.complete}};
}

fn case_b01_work_exhaustion() void {
    ownership_globals_env.env mut e = ownership_globals_env.env{};
    ownership_globals_env.open(&e, 1);
    ownership_api.global_request mut req = ownership_globals_env.request(&e);
    e.service.globals = empty_service;
    ownership_api.global_result first = ownership_globals.solve(&e.global, &e.service, &req);
    assert(ownership_api.successful(first.proof));
    ownership_api.global_result second = ownership_globals.solve(&e.global, &e.service, &req);
    assert(second.proof.kind == ownership_api.proof_kind.incomplete);
    assert(second.proof.terminal.reason == ownership_api.incomplete_reason.work_limit);
    assert(second.proof.terminal.limit.present && second.proof.terminal.limit.used == 1);
    assert(second.proof.terminal.limit.bound == 1);
    assert(second.proof.terminal.limit.operation.operation == 1);
    assert(e.events.len == 1);
    assert(ownership_api.event_kind.work_failure ==
        ownership_events.at(&e.events, 0)->kind);
    ownership_globals_env.close(&e);
    u64[3] bounds = {2, 16, 64};
    for (u64 bound : bounds) {
        ownership_globals_env.env mut partial = ownership_globals_env.env{};
        ownership_globals_env.open(&partial, bound);
        ownership_globals_env.seed(&partial);
        ownership_state.state mut saved = ownership_state.clone(&partial.input);
        ownership_api.global_request mut attempt = ownership_globals_env.request(&partial);
        ownership_api.global_result failed = ownership_globals.solve(
            &partial.global, &partial.service, &attempt);
        assert(failed.proof.kind == ownership_api.proof_kind.incomplete);
        assert(failed.proof.terminal.reason == ownership_api.incomplete_reason.work_limit);
        assert(failed.proof.terminal.limit.used == bound);
        assert(partial.events.len == 1);
        assert(ownership_events.at(&partial.events, 0)->kind ==
            ownership_api.event_kind.work_failure);
        assert(ownership_state.equal(&partial.input, &saved));
        assert(failed.persistent.len == 0 && failed.cleanup.len == 0);
        ownership_state.free(&saved);
        ownership_globals_env.close(&partial);
    }
    println("B01 work exhaustion ok");
}

fn case_b02_missing_global_service() void {
    ownership_globals_env.env mut e = ownership_globals_env.env{};
    ownership_globals_env.open(&e, ownership_limits.PRODUCTION_W);
    e.service.globals = null;
    ownership_api.global_request mut req = ownership_globals_env.request(&e);
    ownership_api.global_result out = ownership_api.globals(&e.service, &req);
    assert(out.proof.kind == ownership_api.proof_kind.incomplete);
    assert(out.proof.terminal.reason == ownership_api.incomplete_reason.missing_globals);
    assert(e.events.len == 0 && e.input.contents_len == 0);
    ownership_globals_env.close(&e);
    println("B02 missing service ok");
}

fn case_b03_missing_event_binding() void {
    ownership_globals_env.env mut e = ownership_globals_env.env{};
    ownership_globals_env.open(&e, ownership_limits.PRODUCTION_W);
    e.global.events = e.bindings[2..3];
    ownership_api.global_request mut req = ownership_globals_env.request(&e);
    ownership_api.global_result out = ownership_globals.solve(&e.global, &e.service, &req);
    assert(out.proof.kind == ownership_api.proof_kind.incomplete);
    assert(out.proof.terminal.reason ==
        ownership_api.incomplete_reason.missing_correspondence);
    assert(e.events.len == 0 && e.input.contents_len == 0);
    ownership_globals_env.close(&e);
    println("B03 missing event binding ok");
}

fn case_b04_copied_result_lifetime() void {
    ownership_globals_env.env mut e = ownership_globals_env.env{};
    ownership_globals_env.open(&e, ownership_limits.PRODUCTION_W);
    ownership_globals_env.seed(&e);
    ownership_state.state mut saved = ownership_state.clone(&e.input);
    ownership_api.global_request mut req = ownership_globals_env.request(&e);
    ownership_api.global_result mut out = ownership_globals.solve(&e.global, &e.service, &req);
    assert(ownership_api.successful(out.proof) && !out.boundary_proved);
    assert(e.events.len == 0);
    assert(out.persistent[0].place.projections.ptr != e.descriptors[0].place.projections.ptr);
    assert(out.persistent[0].initial.borrows.ptr != e.descriptors[0].initial.borrows.ptr);
    assert(out.persistent[0].initial.borrows[0].range.leaves.ptr !=
        e.descriptors[0].initial.borrows[0].range.leaves.ptr);
    assert(out.cleanup[0].place.projections.ptr != e.cleanup[0].place.projections.ptr);
    ownership_api.global_request mut reused = req;
    reused.before = ownership_state.view(&e.global.retained);
    reused.entry.globals = out.persistent;
    reused.entry.cleanup = out.cleanup;
    out = ownership_globals.solve(&e.global, &e.service, &reused);
    assert(ownership_api.successful(out.proof));
    ownership_globals_env.release_input(&e);
    assert(out.persistent.len == 1 && out.cleanup.len == 1);
    assert(out.persistent[0].place.projections[0].field == 7);
    assert(out.persistent[0].initial.borrows[0].key.ordinal == 9);
    assert(out.persistent[0].initial.borrows[0].containing.projections[0].field == 7);
    assert(out.cleanup[0].place.projections[0].field == 7);
    assert(ownership_state.equal(&e.global.retained, &saved));
    assert(e.global.retained.contents_len == 1);
    assert(e.global.retained.contents[0].borrows[0].key.ordinal == 9);
    ownership_globals_env.close(&e);
    ownership_state.free(&saved);
    println("B04 copied result life ok");
}

fn case_b05_failure_atomicity() void {
    ownership_globals_env.env mut e = ownership_globals_env.env{};
    ownership_globals_env.open(&e, ownership_limits.PRODUCTION_W);
    ownership_globals_env.seed(&e);
    ownership_state.state mut saved = ownership_state.clone(&e.input);
    ownership_api.global_input descriptor = e.descriptors[0];
    ownership_api.ordered_effect cleanup = e.cleanup[0];
    ownership_api.ordered_effect[2] effects = {
        ownership_api.ordered_effect{.kind = ownership_api.effect_kind.read,
            .operation = ownership_globals_env.position(2)},
        ownership_api.ordered_effect{.kind = ownership_api.effect_kind.write,
            .operation = ownership_globals_env.position(3)},
    };
    ownership_api.global_request mut req = ownership_globals_env.request(&e);
    req.outcome.effects = effects[..];
    ownership_api.global_result mut out = ownership_globals.solve(&e.global, &e.service, &req);
    assert(out.proof.kind == ownership_api.proof_kind.incomplete);
    assert(out.proof.terminal.reason == ownership_api.incomplete_reason.invalid_input);
    assert(e.events.len == 1);
    assert(ownership_events.at(&e.events, 0)->kind == ownership_api.event_kind.incomplete_proof);
    assert(ownership_events.at(&e.events, 0)->operation.operation == 3);
    assert(ownership_state.equal(&e.input, &saved));
    assert(e.descriptors[0].declaration.module == descriptor.declaration.module);
    assert(e.descriptors[0].place.root.ordinal == descriptor.place.root.ordinal);
    assert(ownership_state.same_place(e.descriptors[0].place, descriptor.place));
    assert(ownership_state.same_contents(e.descriptors[0].initial, saved.contents[0]));
    assert(e.descriptors[0].persistent == descriptor.persistent);
    assert(e.descriptors[0].symbolic == descriptor.symbolic);
    assert(ownership_globals_env.same_effect(e.cleanup[0], cleanup));
    assert(out.persistent.len == 0 && out.cleanup.len == 0);
    assert(e.global.retained.contents_len == 0 && e.global.globals.len == 0);
    assert(effects[0].kind == ownership_api.effect_kind.read);
    assert(effects[1].kind == ownership_api.effect_kind.write);
    // A refused later request also preserves the previous result storage.
    ownership_api.ordered_effect@ none = {};
    req.outcome.effects = none;
    ownership_api.global_result previous = ownership_globals.solve(&e.global, &e.service, &req);
    assert(ownership_api.successful(previous.proof));
    ownership_api.projection* previous_path = previous.persistent[0].place.projections.ptr;
    req.before = ownership_state.view(&e.global.retained);
    req.entry.globals = previous.persistent;
    req.entry.cleanup = previous.cleanup;
    req.outcome.effects = effects[..];
    out = ownership_globals.solve(&e.global, &e.service, &req);
    assert(out.proof.kind == ownership_api.proof_kind.incomplete);
    assert(previous.persistent[0].place.projections.ptr == previous_path);
    assert(previous.persistent[0].place.projections[0].field == 7);
    assert(ownership_state.equal(&e.global.retained, &saved));
    ownership_state.free(&saved);
    ownership_globals_env.close(&e);
    println("B05 failure atomicity ok");
}

fn global_value(ownership_globals_env.env* e, u64 index)
    ownership_api.contents_fact {
    return e->global.retained.contents[index];
}

fn accepted(ownership_globals_env.env* e, ownership_api.global_result out) void {
    assert(ownership_api.successful(out.proof) && !out.boundary_proved);
    assert(e->events.len == 0);
}

fn failed_relation(ownership_globals_env.env* e, ownership_api.global_result out, u64 effect,
    ownership_api.event_kind kind, ownership_api.incomplete_reason reason,
    ownership_api.entity_kind relation_kind, u32 relation, ownership_api.place_path owner,
    ownership_state.state* saved) void {
    assert(out.proof.failed);
    assert(out.proof.kind == (reason == ownership_api.incomplete_reason.none ?
        ownership_api.proof_kind.complete : ownership_api.proof_kind.incomplete));
    assert(out.persistent.len == 0 && out.cleanup.len == 0);
    assert(e->events.len == 1);
    ownership_api.event_descriptor* event = ownership_events.at(&e->events, 0);
    assert(event->kind == kind && event->reason == reason);
    assert(event->evidence == (reason == ownership_api.incomplete_reason.none ?
        ownership_api.evidence_kind.unconditional :
        ownership_api.evidence_kind.abstract_possibility));
    assert(ownership_keys.operation(event->operation, e->ordered[effect].operation) == 0);
    assert(ownership_keys.source(event->source, e->transitions[effect].source) == 0);
    assert(ownership_state.same_place(event->source_path, e->transitions[effect].from));
    assert(ownership_state.same_place(event->owner_path, owner));
    if (relation != 0) {
        ownership_api.entity_id expected = ownership_globals_env.case_key(e, relation_kind,
            relation);
        assert(ownership_keys.entity(event->relation, expected) == 0);
    }
    u64 route = 2 + effect * 3 + (kind == ownership_api.event_kind.invalid_use ? 2 :
        (kind == ownership_api.event_kind.lost_ownership ? 1 : 0));
    assert(ownership_keys.entity(event->key, e->bindings[route].key) == 0);
    assert(ownership_state.equal(&e->input, saved));
}

fn failed_case(ownership_globals_env.env* e, ownership_api.global_result out, u64 effect,
    ownership_api.event_kind kind, ownership_api.incomplete_reason reason, u32 allocation,
    ownership_state.state* saved) void {
    failed_relation(e, out, effect, kind, reason, ownership_api.entity_kind.allocation,
        allocation, e->ordered[effect].place, saved);
}

fn run_case(ownership_globals_env.env mut* e) ownership_api.global_result {
    ownership_api.global_request mut req = ownership_globals_env.request(e);
    return ownership_globals.solve(&e->global, &e->service, &req);
}

fn case_g1_a1() void {
    ownership_globals_env.env mut e = ownership_globals_env.env{};
    ownership_globals_env.case_open(&e, 1);
    ownership_globals_env.add_owner(&e, ownership_globals_env.case_place(&e, 1), 10, 4);
    ownership_globals_env.add_empty(&e, ownership_globals_env.case_place(&e, 2));
    ownership_globals_env.add_effect(&e, ownership_api.effect_kind.transfer,
        ownership_globals_env.case_place(&e, 1), ownership_globals_env.case_place(&e, 2), 10);
    ownership_api.global_result mut out = run_case(&e);
    accepted(&e, out);
    assert(global_value(&e, 0).owner_empty);
    assert(e.global.retained.allocations[0].key.ordinal == 10);
    assert(e.global.retained.allocations[0].obligation);
    assert(e.global.retained.allocations[0].owner.place.root.ordinal == 2);
    assert(out.persistent[0].initial.borrows[0].source.ordinal == 110);
    assert(out.persistent[0].initial.borrows[0].containing.root.ordinal == 2);
    e.effects_len = 0;
    ownership_globals_env.add_effect(&e, ownership_api.effect_kind.release,
        ownership_globals_env.case_place(&e, 2), ownership_globals_env.case_place(&e, 2), 10);
    ownership_api.global_request mut cleanup = ownership_globals_env.request(&e);
    cleanup.before = ownership_state.view(&e.global.retained);
    cleanup.entry.globals = out.persistent;
    out = ownership_globals.solve(&e.global, &e.service, &cleanup);
    accepted(&e, out);
    assert(out.persistent[0].initial.owner_empty);
    assert(!e.global.retained.allocations[0].obligation);
    assert(e.global.retained.allocations[0].history.len == 2);
    ownership_globals_env.close(&e);
    println("G1-A1 ok");
}

fn case_g1_a2() void {
    ownership_globals_env.env mut e = ownership_globals_env.env{};
    ownership_globals_env.case_open(&e, 2);
    ownership_api.projection[1] first = {ownership_api.projection{
        .kind = ownership_api.projection_kind.field, .field = 7}};
    ownership_api.projection[1] second = {ownership_api.projection{
        .kind = ownership_api.projection_kind.field, .field = 8}};
    ownership_api.place_path mut destination = ownership_globals_env.case_place(&e, 2);
    destination.projections = first[..];
    ownership_api.place_path mut sibling = ownership_globals_env.case_place(&e, 2);
    sibling.projections = second[..];
    ownership_globals_env.add_owner(&e, ownership_globals_env.case_place(&e, 1), 10, 0);
    ownership_globals_env.add_empty(&e, destination);
    ownership_globals_env.add_owner(&e, sibling, 11, 5);
    del(e.descriptors);
    e.descriptors = new(ownership_api.global_input, 2);
    e.descriptors[0] = ownership_api.global_input{
        .declaration = ownership_api.declaration_id{1, 2}, .place = destination,
        .initial = e.input.contents[1], .persistent = true, .symbolic = true};
    e.descriptors[1] = ownership_api.global_input{
        .declaration = ownership_api.declaration_id{1, 2}, .place = sibling,
        .initial = e.input.contents[2], .persistent = true, .symbolic = true};
    ownership_globals_env.add_effect(&e, ownership_api.effect_kind.transfer,
        ownership_globals_env.case_place(&e, 1), destination, 10);
    ownership_api.global_result out = run_case(&e);
    accepted(&e, out);
    assert(out.persistent[0].initial.place.projections[0].field == 7);
    assert(out.persistent[0].initial.span_length.value == 0);
    assert(!out.persistent[0].initial.owner_empty);
    assert(e.global.retained.allocations[0].obligation);
    assert(e.global.retained.allocations[0].owner.place.projections[0].field == 7);
    assert(e.global.retained.allocations[1].key.ordinal == 11);
    assert(e.global.retained.allocations[1].owner.place.projections[0].field == 8);
    assert(out.persistent[1].initial.borrows[0].source.ordinal == 111);
    assert(global_value(&e, 0).owner_empty);
    ownership_globals_env.close(&e);
    println("G1-A2 ok");
}

fn refused_after_effects(u64 work) void {
    ownership_globals_env.env mut e = ownership_globals_env.env{};
    ownership_globals_env.case_open(&e, 3);
    e.events.budget.bounds.w = work;
    ownership_globals_env.add_owner(&e, ownership_globals_env.case_place(&e, 1), 10, 4);
    ownership_globals_env.add_empty(&e, ownership_globals_env.case_place(&e, 2));
    ownership_globals_env.add_effect(&e, ownership_api.effect_kind.transfer,
        ownership_globals_env.case_place(&e, 1), ownership_globals_env.case_place(&e, 2), 10);
    ownership_globals_env.add_effect(&e, ownership_api.effect_kind.release,
        ownership_globals_env.case_place(&e, 2), ownership_globals_env.case_place(&e, 2), 10);
    ownership_globals_env.add_effect(&e, ownership_api.effect_kind.transfer,
        ownership_globals_env.case_place(&e, 1), ownership_globals_env.case_place(&e, 2), 0);
    ownership_state.state mut saved = ownership_state.clone(&e.input);
    ownership_api.global_result out = run_case(&e);
    assert(out.proof.kind == ownership_api.proof_kind.incomplete);
    assert(out.proof.terminal.reason == ownership_api.incomplete_reason.work_limit);
    assert(out.proof.terminal.limit.used == work && out.proof.terminal.limit.attempted == 1);
    assert(e.events.budget.used.e == 2);
    assert(e.events.len == 1);
    ownership_api.event_descriptor* event = ownership_events.at(&e.events, 0);
    assert(event->kind == ownership_api.event_kind.work_failure);
    assert(ownership_keys.operation(event->operation, e.bindings[1].operation) == 0);
    assert(ownership_state.equal(&e.input, &saved));
    assert(ownership_transfer.empty_owner_proved(e.descriptors[0].initial));
    assert(e.global.retained.contents_len == 0 && out.persistent.len == 0);
    ownership_state.free(&saved);
    ownership_globals_env.close(&e);
}

fn case_g1_a3() void {
    ownership_globals_env.env mut e = ownership_globals_env.env{};
    ownership_globals_env.case_open(&e, 3);
    ownership_globals_env.add_owner(&e, ownership_globals_env.case_place(&e, 1), 10, 4);
    ownership_globals_env.add_empty(&e, ownership_globals_env.case_place(&e, 2));
    ownership_globals_env.add_effect(&e, ownership_api.effect_kind.transfer,
        ownership_globals_env.case_place(&e, 1), ownership_globals_env.case_place(&e, 2), 10);
    ownership_globals_env.add_effect(&e, ownership_api.effect_kind.release,
        ownership_globals_env.case_place(&e, 2), ownership_globals_env.case_place(&e, 2), 10);
    ownership_globals_env.add_effect(&e, ownership_api.effect_kind.transfer,
        ownership_globals_env.case_place(&e, 1), ownership_globals_env.case_place(&e, 2), 0);
    ownership_api.global_result out = run_case(&e);
    accepted(&e, out);
    assert(out.persistent[0].initial.owner_empty);
    assert(global_value(&e, 0).owner_empty);
    assert(!e.global.retained.allocations[0].obligation);
    assert(e.global.retained.allocations[0].history.len == 2);
    u64 admitted_work = e.events.budget.used.w;
    ownership_globals_env.close(&e);
    assert(admitted_work > 1);
    refused_after_effects(admitted_work - 1);
    println("G1-A3 ok");
}

fn case_g1_r1() void {
    ownership_globals_env.env mut e = ownership_globals_env.env{};
    ownership_globals_env.case_open(&e, 4);
    ownership_globals_env.add_owner(&e, ownership_globals_env.case_place(&e, 1), 10, 4);
    ownership_globals_env.add_empty(&e, ownership_globals_env.case_place(&e, 2));
    ownership_globals_env.add_effect(&e, ownership_api.effect_kind.transfer,
        ownership_globals_env.case_place(&e, 1), ownership_globals_env.case_place(&e, 2), 10);
    ownership_globals_env.add_effect(&e, ownership_api.effect_kind.transfer,
        ownership_globals_env.case_place(&e, 1), ownership_globals_env.case_place(&e, 2), 0);
    ownership_state.state mut saved = ownership_state.clone(&e.input);
    ownership_api.global_result out = run_case(&e);
    failed_case(&e, out, 1, ownership_api.event_kind.lost_ownership,
        ownership_api.incomplete_reason.none, 10, &saved);
    ownership_state.free(&saved);
    ownership_globals_env.close(&e);
    println("G1-R1 ok");
}

fn case_g1_i1() void {
    ownership_globals_env.env mut e = ownership_globals_env.env{};
    ownership_globals_env.case_open(&e, 5);
    ownership_globals_env.add_owner(&e, ownership_globals_env.case_place(&e, 1), 10, 4);
    ownership_globals_env.add_empty(&e, ownership_globals_env.case_place(&e, 2));
    ownership_globals_env.add_effect(&e, ownership_api.effect_kind.transfer,
        ownership_globals_env.case_place(&e, 1), ownership_globals_env.case_place(&e, 2), 10);
    e.transitions[0].identity_proved = false;
    ownership_state.state mut saved = ownership_state.clone(&e.input);
    ownership_api.global_result out = run_case(&e);
    failed_case(&e, out, 0, ownership_api.event_kind.incomplete_proof,
        ownership_api.incomplete_reason.missing_correspondence, 10, &saved);
    ownership_state.free(&saved);
    ownership_globals_env.close(&e);
    println("G1-I1 ok");
}

fn case_g2_a1() void {
    ownership_globals_env.env mut e = ownership_globals_env.env{};
    ownership_globals_env.case_open(&e, 6);
    ownership_globals_env.add_owner(&e, ownership_globals_env.case_place(&e, 2), 10, 4);
    ownership_globals_env.add_owner(&e, ownership_globals_env.case_place(&e, 1), 20, 8);
    ownership_globals_env.add_effect(&e, ownership_api.effect_kind.release,
        ownership_globals_env.case_place(&e, 2), ownership_globals_env.case_place(&e, 2), 10);
    ownership_globals_env.add_effect(&e, ownership_api.effect_kind.transfer,
        ownership_globals_env.case_place(&e, 1), ownership_globals_env.case_place(&e, 2), 20);
    ownership_api.global_result out = run_case(&e);
    accepted(&e, out);
    assert(!e.global.retained.allocations[0].obligation);
    assert(e.global.retained.sources[0].validity == ownership_api.validity_kind.released);
    assert(e.global.retained.allocations[1].obligation);
    assert(e.global.retained.allocations[1].owner.place.root.ordinal == 2);
    assert(out.persistent[0].initial.span_length.value == 8);
    ownership_globals_env.close(&e);
    println("G2-A1 ok");
}

