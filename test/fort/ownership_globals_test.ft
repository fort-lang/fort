fn unknown_source_end(u64 variant) void {
    ownership_globals_env.env mut e = ownership_globals_env.env{};
    ownership_globals_env.case_open(&e, 15);
    ownership_globals_env.add_borrow(&e, ownership_globals_env.case_place(&e, 2), 40,
        ownership_api.source_kind.stack, 1);
    ownership_globals_env.source_end(&e, 40);
    if (variant == 0) { e.transitions[0].source_end_proved = false; }
    if (variant == 1) {
        e.input.contents[0].kind = ownership_api.contents_kind.unknown;
        e.input.contents[0].borrows = e.relations[0..0];
    }
    if (variant == 2) { e.input.contents[0].borrows = e.relations[0..0]; }
    if (variant == 3) { e.input.contents_len = 0; }
    if (variant == 4) {
        e.input.contents[0].value_version.ordinal += 1;
    }
    if (variant == 5) { e.input.sources[0].kind = ownership_api.source_kind.unknown_fort; }
    if (variant == 6) {
        e.input.contents_len = 0;
        ownership_globals_env.add_owner(&e, ownership_globals_env.case_place(&e, 2), 10, 1);
    }
    ownership_state.state mut saved = ownership_state.clone(&e.input);
    ownership_api.global_result out = run_case(&e);
    failed_relation(&e, out, 0, ownership_api.event_kind.incomplete_proof,
        ownership_api.incomplete_reason.missing_correspondence, ownership_api.entity_kind.source,
        40, ownership_globals_env.case_place(&e, 1), &saved);
    ownership_state.free(&saved);
    ownership_globals_env.close(&e);
}

fn case_g3_i1() void {
    unknown_source_end(0);
    unknown_source_end(1);
    unknown_source_end(2);
    unknown_source_end(3);
    unknown_source_end(4);
    unknown_source_end(5);
    unknown_source_end(6);
    println("G3-I1 ok");
}

fn seed_children(ownership_globals_env.env mut* e) void {
    ownership_globals_env.add_owner(e, ownership_globals_env.case_place(e, 2), 10, 4);
    ownership_globals_env.add_owner(e, ownership_globals_env.case_place(e, 3), 20, 8);
    ownership_globals_env.child_graph(e);
}

fn refused_child_cleanup(u64 work) void {
    ownership_globals_env.env mut e = ownership_globals_env.env{};
    ownership_globals_env.case_open(&e, 16);
    e.events.budget.bounds.w = work;
    seed_children(&e);
    ownership_globals_env.add_effect(&e, ownership_api.effect_kind.release,
        ownership_globals_env.case_place(&e, 3), ownership_globals_env.case_place(&e, 3), 20);
    ownership_globals_env.add_effect(&e, ownership_api.effect_kind.release,
        ownership_globals_env.case_place(&e, 2), ownership_globals_env.case_place(&e, 2), 10);
    ownership_state.state mut saved = ownership_state.clone(&e.input);
    ownership_api.global_result out = run_case(&e);
    assert(out.proof.kind == ownership_api.proof_kind.incomplete);
    assert(out.proof.terminal.reason == ownership_api.incomplete_reason.work_limit);
    assert(out.proof.terminal.limit.used == work && out.proof.terminal.limit.attempted == 1);
    assert(e.events.budget.used.e == 2 && e.events.len == 1);
    assert(ownership_events.at(&e.events, 0)->kind == ownership_api.event_kind.work_failure);
    assert(ownership_state.equal(&e.input, &saved));
    assert(e.global.descendants.len == 0 && e.global.borrowed.len == 0);
    assert(e.descriptors[0].initial.borrows[0].source.ordinal == 110);
    ownership_state.free(&saved);
    ownership_globals_env.close(&e);
}

fn case_g4_a1() void {
    ownership_globals_env.env mut e = ownership_globals_env.env{};
    ownership_globals_env.case_open(&e, 16);
    seed_children(&e);
    ownership_globals_env.add_effect(&e, ownership_api.effect_kind.release,
        ownership_globals_env.case_place(&e, 3), ownership_globals_env.case_place(&e, 3), 20);
    ownership_globals_env.add_effect(&e, ownership_api.effect_kind.release,
        ownership_globals_env.case_place(&e, 2), ownership_globals_env.case_place(&e, 2), 10);
    ownership_api.global_result out = run_case(&e);
    accepted(&e, out);
    assert(e.global.descendants.len == 2 && e.global.descendants[1] == 2);
    assert(!e.global.retained.allocations[0].obligation);
    assert(!e.global.retained.allocations[1].obligation);
    assert(e.global.retained.allocations[1].history[0].operation.operation == 2);
    assert(e.global.retained.allocations[0].history[0].operation.operation == 3);
    assert(global_value(&e, 0).owner_empty && global_value(&e, 1).owner_empty);
    assert(e.global.retained.sources[0].validity == ownership_api.validity_kind.released);
    assert(e.global.retained.sources[1].validity == ownership_api.validity_kind.released);
    u64 admitted_work = e.events.budget.used.w;
    ownership_globals_env.close(&e);
    assert(admitted_work > 1);
    refused_child_cleanup(admitted_work - 1);
    println("G4-A1 ok");
}

