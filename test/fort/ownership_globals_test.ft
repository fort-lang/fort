fn inline_leaf(bool known) void {
    ownership_globals_env.env mut e = ownership_globals_env.env{};
    ownership_globals_env.case_open(&e, 19);
    ownership_api.projection[1] path = {ownership_api.projection{
        .kind = ownership_api.projection_kind.field, .field = 7}};
    ownership_api.place_path mut leaf = ownership_globals_env.case_place(&e, 2);
    leaf.projections = path[..];
    ownership_globals_env.add_empty(&e, ownership_globals_env.case_place(&e, 2));
    ownership_globals_env.add_owner(&e, leaf, 20, 8);
    if (!known) { e.input.allocations[0].validity = ownership_api.validity_kind.unknown; }
    ownership_globals_env.add_effect(&e, ownership_api.effect_kind.release,
        ownership_globals_env.case_place(&e, 2), ownership_globals_env.case_place(&e, 2), 0);
    ownership_state.state mut saved = ownership_state.clone(&e.input);
    ownership_api.global_result out = run_case(&e);
    failed_relation(&e, out, 0, known ? ownership_api.event_kind.lost_ownership :
        ownership_api.event_kind.incomplete_proof, known ? ownership_api.incomplete_reason.none :
        ownership_api.incomplete_reason.missing_graph, ownership_api.entity_kind.allocation, 20,
        known ? leaf : ownership_globals_env.case_place(&e, 2), &saved);
    ownership_globals_env.release_input(&e);
    if (known) {
        assert(ownership_events.at(&e.events, 0)->owner_path.projections[0].field == 7);
    }
    ownership_state.free(&saved);
    ownership_globals_env.close(&e);
}

fn case_g4_r2() void {
    inline_leaf(true);
    inline_leaf(false);
    println("G4-R2 ok");
}

