fn failed_entry(ownership_globals_env.env* e, ownership_api.global_result out,
    ownership_api.incomplete_reason reason, ownership_state.state* saved) void {
    assert(out.proof.failed && out.proof.kind == ownership_api.proof_kind.incomplete);
    assert(out.proof.terminal.reason == reason);
    assert(out.persistent.len == 0 && out.cleanup.len == 0 && !out.boundary_proved);
    assert(e->events.len == 1);
    ownership_api.event_descriptor* event = ownership_events.at(&e->events, 0);
    assert(event->kind == ownership_api.event_kind.incomplete_proof);
    assert(event->reason == reason);
    assert(event->evidence == ownership_api.evidence_kind.abstract_possibility);
    assert(ownership_keys.entity(event->key, e->bindings[0].key) == 0);
    assert(ownership_keys.operation(event->operation, e->bindings[0].operation) == 0);
    assert(ownership_keys.source(event->source, ownership_globals_env.source(21)) == 0);
    assert(ownership_state.equal(&e->input, saved));
}

fn case_g7_a1() void {
    ownership_globals_env.env mut e = ownership_globals_env.env{};
    ownership_globals_env.case_open(&e, 22);
    e.projections = new(ownership_api.projection, 1);
    e.projections[0] = ownership_api.projection{
        .kind = ownership_api.projection_kind.field, .field = 6};
    e.descriptors[0].place.projections = e.projections[..];
    ownership_globals_env.add_owner(&e, e.descriptors[0].place, 10, 4);
