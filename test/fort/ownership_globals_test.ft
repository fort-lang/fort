fn case_g6_r1() void {
    ownership_globals_env.env mut e = ownership_globals_env.env{};
    ownership_globals_env.case_open(&e, 51);
    ownership_globals_env.add_owner(&e, ownership_globals_env.case_place(&e, 2), 10, 4);
    ownership_api.place_path borrowed = ownership_globals_env.case_place(&e, 3);
    ownership_api.borrow_relation mut relation = e.input.contents[0].borrows[0];
    relation.containing = borrowed;
    ownership_api.borrow_relation[1] relations = {relation};
    ownership_api.contents_fact mut value = e.input.contents[0];
    value.place = borrowed;
    value.borrows = relations[..];
    ownership_state.append_contents(&e.input, value);
    ownership_globals_env.add_effect(&e, ownership_api.effect_kind.release,
        ownership_globals_env.case_place(&e, 2), ownership_globals_env.case_place(&e, 2), 10);
    ownership_globals_env.add_effect(&e, ownership_api.effect_kind.read, borrowed, borrowed, 10);
    ownership_globals_env.select_entry(&e, true, false);
    ownership_api.global_request mut req = ownership_globals_env.request(&e);
    req.outcome.kind = ownership_api.outcome_kind.abort;
    ownership_globals_env.select_terminal(&e, &req);
    ownership_state.state mut saved = ownership_state.clone(&e.input);
    ownership_api.global_result out = ownership_globals.solve(&e.global, &e.service, &req);
    failed_relation(&e, out, 1, ownership_api.event_kind.invalid_use,
        ownership_api.incomplete_reason.none, ownership_api.entity_kind.source, 110,
        borrowed, &saved);
    ownership_state.free(&saved);
    ownership_globals_env.close(&e);
    println("G6-R1 ok");
}

fn case_g6_r2() void {
    ownership_globals_env.env mut e = ownership_globals_env.env{};
    cleanup_exit_case(&e, 52);
    ownership_globals_env.add_owner(&e, ownership_globals_env.case_place(&e, 3), 20, 4);
    ownership_api.global_request req = ownership_globals_env.normal_request(&e);
    ownership_globals_env.select_terminal(&e, &req);
    ownership_globals.terminal_record mut* item = &e.terminal_inputs[0];
    item->caller_empty_required = true;
    item->caller = ownership_globals_env.case_place(&e, 3);
    item->call = ownership_globals_env.case_position(&e, 20);
    item->source = ownership_globals_env.source(520);
    item->callee_exit = ownership_globals_env.source(521);
    u64 offset = 2 + e.effects_len * 3;
    e.bindings[offset] = ownership_globals.event_binding{item->call,
        ownership_api.event_kind.caller_requirement,
        ownership_globals_env.case_key(&e, ownership_api.entity_kind.event, 5200)};
    e.global.events = e.bindings[0..offset + 1];
    ownership_state.state mut saved = ownership_state.clone(&e.input);
    ownership_api.global_result out = ownership_globals.solve(&e.global, &e.service, &req);
    assert(out.proof.failed && e.events.len == 1);
    ownership_api.event_descriptor* event = ownership_events.at(&e.events, 0);
    assert(event->kind == ownership_api.event_kind.caller_requirement);
    assert(event->evidence == ownership_api.evidence_kind.unconditional);
    assert(ownership_keys.operation(event->operation, item->call) == 0);
    assert(ownership_keys.entity(event->relation,
        ownership_globals_env.case_key(&e, ownership_api.entity_kind.allocation, 20)) == 0);
    assert(ownership_keys.entity(event->key, e.bindings[offset].key) == 0);
    assert(ownership_state.same_place(event->owner_path, item->caller));
    assert(event->notes.len == 2 && event->notes[0].role == ownership_api.note_role.callee);
    assert(event->notes[1].role == ownership_api.note_role.substitution);
    assert(event->source.line == 520 && event->notes[0].source.line == 521);
    assert(ownership_state.equal(&e.input, &saved));
    ownership_state.free(&saved);
    ownership_globals_env.release_input(&e);
    assert(event->owner_path.root.ordinal == 3 && event->notes[1].source.line == 520);
    ownership_globals_env.close(&e);
    println("G6-R2 ok");
}

fn case_g6_i1() void {
    ownership_globals_env.env mut e = ownership_globals_env.env{};
    terminal_setup(&e, 53);
    ownership_api.global_request mut req = ownership_globals_env.request(&e);
    req.outcome.kind = ownership_api.outcome_kind.abort;
    ownership_globals_env.select_terminal(&e, &req);
    ownership_globals.terminal_record mut@ own mixed = new(ownership_globals.terminal_record, 2);
    mixed[0] = e.terminal_inputs[0];
    mixed[0].path_proved = false;
    mixed[1] = mixed[0];
    mixed[1].outcome.kind = ownership_api.outcome_kind.normal_process_exit;
    mixed[1].outcome.cleanup_required = true;
    mixed[1].outcome.cleanup_proved = false;
    del(e.terminal_inputs);
    e.terminal_inputs = move(mixed);
    e.global.terminal_inputs = e.terminal_inputs[..];
    ownership_state.state mut saved = ownership_state.clone(&e.input);
    ownership_api.global_result out = ownership_globals.solve(&e.global, &e.service, &req);
    failed_entry(&e, out, ownership_api.incomplete_reason.missing_path, &saved);
    ownership_state.free(&saved);
    ownership_globals_env.close(&e);
    println("G6-I1 ok");
}

