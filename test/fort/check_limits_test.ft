//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| ok
/// Checks the type-size ceiling, also behind a reference, the D2.11 limit of 256 suffixes, and
/// the fixed limits of 128 parameters and 128 fields. Only hand-built declarations reach these
/// limits.

import check;
import check_env;
import std.strbuf;
import types;

// A struct with `n` fields, and the entry module's `main` after it.
fn many_fields(strbuf.str_buf mut* b, u64 n) string {
    strbuf.clear(b);
    strbuf.append(b, "struct wide {\n");
    u64 mut i = 0;
    while (i < n) {
        strbuf.append(b, "    i32 fld");
        strbuf.append_u64(b, i);
        strbuf.append(b, ";\n");
        i += 1;
    }
    strbuf.append(b, "}\n");
    return strbuf.view(b);
}

// A function of `n` parameters.
fn many_params(strbuf.str_buf mut* b, u64 n) string {
    strbuf.clear(b);
    strbuf.append(b, "fn wide(");
    u64 mut i = 0;
    while (i < n) {
        if (i > 0) {
            strbuf.append(b, ", ");
        }
        strbuf.append(b, "i32 p");
        strbuf.append_u64(b, i);
        i += 1;
    }
    strbuf.append(b, ") void {\n    return;\n}\n");
    return strbuf.view(b);
}

// Writes a function type of `n` parameters as a declaration type. base_type
// caps that parameter list at a second site and reports a second diagnostic.
fn many_fn_params(strbuf.str_buf mut* b, u64 n) string {
    strbuf.clear(b);
    strbuf.append(b, "fn (");
    u64 mut i = 0;
    while (i < n) {
        if (i > 0) {
            strbuf.append(b, ", ");
        }
        strbuf.append(b, "i32");
        i += 1;
    }
    strbuf.append(b, ") void wide = null;\n");
    return strbuf.view(b);
}

// Appends `n` copies of `text` to `b`.
fn append_times(strbuf.str_buf mut* b, string text, u64 n) void {
    u64 mut i = 0;
    while (i < n) {
        strbuf.append(b, text);
        i += 1;
    }
}

// The declaration `<base> <suffix * inner> ... deep = <init>;`. A nonzero
// `inner` puts `base` and the first `inner` suffixes into a group, and `outer`
// more suffixes follow it. D2.11 counts the suffixes of the group and its
// suffixes together.
fn deep_decl(strbuf.str_buf mut* b, string base, string suffix, u64 inner, u64 outer,
             string init) string {
    strbuf.clear(b);
    if (inner > 0) {
        strbuf.append(b, "(");
    }
    strbuf.append(b, base);
    append_times(b, suffix, inner);
    if (inner > 0) {
        strbuf.append(b, ")");
    }
    append_times(b, suffix, outer);
    strbuf.append(b, " deep = ");
    strbuf.append(b, init);
    strbuf.append(b, ";\n");
    return strbuf.view(b);
}

// The written suffix of one level of `kind`.
fn suffix_of(types.type_kind kind) string {
    if (kind == types.type_kind.k_span) {
        return "@";
    }
    if (kind == types.type_kind.k_array) {
        return "[1]";
    }
    return "*";
}

// The initializer of a `deep` whose outermost level is of `kind`.
fn init_of(types.type_kind kind) string {
    if (kind == types.type_kind.k_ptr) {
        return "null";
    }
    return "{}";
}

// Checks the declaration of `deep_decl` with the suffix of `kind` in a fresh
// environment. Answers whether the checker took it and gave `deep` `count`
// levels of `kind` above the type spelled `base`, and closed each frame of its
// suffix stack.
fn takes(strbuf.str_buf mut* b, string base, types.type_kind kind, u64 inner, u64 outer,
         u64 count) bool {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    string decl = deep_decl(b, base, suffix_of(kind), inner, outer, init_of(kind));
    if (!check_env.check_decls(&e, decl)) {
        return false;
    }
    types.node* mut t = check_env.sym_main(&e, "deep")->ty;
    u64 mut n = 0;
    while (t->kind == kind) {
        n += 1;
        t = t->elem;
    }
    return check_env.errors(&e) == 0 && n == count && check_env.type_text(&e, t) == base
           && e.ck.suffix_top == 0;
}

// Checks the declaration of `deep_decl` with the suffix of `kind` in a fresh
// environment. Answers whether the parser refused the 257th suffix and the
// checker closed each frame of its suffix stack. The checker's own refusal
// never shows.
fn refused(strbuf.str_buf mut* b, string base, types.type_kind kind, u64 inner, u64 outer) bool {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    string decl = deep_decl(b, base, suffix_of(kind), inner, outer, init_of(kind));
    return !check_env.check_decls(&e, decl)
           && check_env.said(&e, "nesting deeper than 256")
           && !check_env.said(&e, "too many type suffixes") && check_env.errors(&e) == 1
           && e.ck.suffix_top == 0;
}

fn a_struct_of_a_hundred_and_twenty_eight_fields_is_the_last_that_fits() void {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(check_env.check_decls(&e, many_fields(&b, 128)));
    assert(check_env.errors(&e) == 0);
    check_env.env mut f = check_env.env{};
    check_env.open(&f);
    defer check_env.close(&f);
    assert(!check_env.check_decls(&f, many_fields(&b, 129)));
    assert(check_env.said(&f, "too many fields"));
}

fn a_function_of_a_hundred_and_twenty_nine_parameters_is_refused() void {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(check_env.check_decls(&e, many_params(&b, 128)));
    assert(check_env.errors(&e) == 0);
    check_env.env mut f = check_env.env{};
    check_env.open(&f);
    defer check_env.close(&f);
    assert(!check_env.check_decls(&f, many_params(&b, 129)));
    assert(check_env.said(&f, "too many parameters"));
}

fn a_function_type_of_a_hundred_and_twenty_nine_parameters_is_refused() void {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(check_env.check_decls(&e, many_fn_params(&b, 128)));
    assert(check_env.errors(&e) == 0);
    check_env.env mut f = check_env.env{};
    check_env.open(&f);
    defer check_env.close(&f);
    assert(!check_env.check_decls(&f, many_fn_params(&b, 129)));
    assert(check_env.said(&f, "too many parameters"));
}

fn a_type_takes_256_suffixes_and_not_257() void {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    types.type_kind ptr = types.type_kind.k_ptr;
    assert(takes(&b, "i32", ptr, 0, 256, 256));
    assert(refused(&b, "i32", ptr, 0, 257));
    // The array suffix counts as one of the 256.
    assert(takes(&b, "i32[1]", ptr, 0, 255, 255));
    assert(refused(&b, "i32[1]", ptr, 0, 256));
    // The C compiler refuses spans of spans and multi-dimensional arrays; this
    // compiler takes 256 of each.
    assert(takes(&b, "i32", types.type_kind.k_span, 0, 256, 256));
    assert(refused(&b, "i32", types.type_kind.k_span, 0, 257));
    assert(takes(&b, "i32", types.type_kind.k_array, 0, 256, 256));
    assert(refused(&b, "i32", types.type_kind.k_array, 0, 257));
}

// The array length is the size of a type of 200 suffixes. The frame of that type
// grows the suffix stack while the frame of `deep` is open, so the stack moves.
fn a_type_in_an_array_length_grows_the_suffix_stack() void {
    strbuf.str_buf mut base = strbuf.create();
    defer strbuf.free(&base);
    strbuf.append(&base, "i32[sizeof(i32");
    append_times(&base, "*", 200);
    strbuf.append(&base, ")]");
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    types.type_kind ptr = types.type_kind.k_ptr;
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(check_env.check_decls(&e, deep_decl(&b, strbuf.view(&base), "*", 0, 50, "null")));
    assert(check_env.type_text(&e, check_env.sym_main(&e, "deep")->ty)
           == "i32[8]**************************************************");
    assert(e.ck.suffix_top == 0);
    assert(e.ck.suffixes.len >= 251);
    assert(refused(&b, strbuf.view(&base), ptr, 0, 256));
}

// Checks `decl` in a fresh environment. Answers whether the checker gave one
// diagnostic holding `message` and closed each frame of its suffix stack.
fn fails_once(string decl, string message) bool {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    return !check_env.check_decls(&e, decl) && check_env.said(&e, message)
           && check_env.errors(&e) == 1 && e.ck.suffix_top == 0;
}

// A frame that fails closes too: an unknown base stops the frame before its
// loop, and a bad array length stops it in the loop.
fn a_failed_type_closes_its_suffix_frame() void {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    string unknown = deep_decl(&b, "nothing", "*", 0, 256, "null");
    assert(fails_once(unknown, "unknown type 'nothing'"));
    string negative = deep_decl(&b, "i32[-1]", "*", 0, 255, "null");
    assert(fails_once(negative, "an array length must be greater than 0"));
}

fn a_group_does_not_reset_the_suffix_count() void {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    types.type_kind ptr = types.type_kind.k_ptr;
    assert(takes(&b, "i32", ptr, 128, 128, 256));
    assert(takes(&b, "i32", ptr, 255, 1, 256));
    assert(refused(&b, "i32", ptr, 128, 129));
    assert(refused(&b, "i32", ptr, 256, 1));
    assert(refused(&b, "i32", ptr, 1, 256));
    assert(takes(&b, "i32", types.type_kind.k_span, 128, 128, 256));
    assert(refused(&b, "i32", types.type_kind.k_span, 128, 129));
}

fn a_type_whose_size_would_pass_the_ceiling_of_d3_4_is_refused() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // 2,000,000,000,000,000,000 i64 values need more than 2^63 - 1 bytes.
    // This exceeds the largest type size. The diagnostic names the declaration.
    assert(!check_env.check_decls(&e, "i64[2000000000000000000] big = {};\n"));
    assert(check_env.said(&e, "type is too large: i64[2000000000000000000]"));
}

// ---- sizes behind a reference (D3.4) ------------------------------------------------

// Checks `decls` with the entry `main` after them in a fresh environment and
// returns whether the check reported exactly one error, `want` as
// `<line>:<col>: <message>`. The corpus cannot see a second report, so this
// counts the errors.
fn one_report(check_env.env mut* e, string decls, string want) bool {
    check_env.reopen(e);
    return !check_env.check_decls(e, decls) && check_env.errors(e) == 1
        && check_env.report_text(e, 0) == want;
}

// The same for the declarations `first` and then `second`.
fn one_report_of_two(check_env.env mut* e, string first, string second, string want) bool {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, first);
    strbuf.append(&b, second);
    return one_report(e, strbuf.view(&b), want);
}

// The same for the body of `main`, `first` and then `second`; a statement on line
// n of the body is on line n + 1.
fn one_body_report(check_env.env mut* e, string first, string second, string want) bool {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, first);
    strbuf.append(&b, second);
    check_env.reopen(e);
    return !check_env.check_body(e, strbuf.view(&b)) && check_env.errors(e) == 1
        && check_env.report_text(e, 0) == want;
}

// Whether `decls` checks clean in a fresh environment.
fn clean(check_env.env mut* e, string decls) bool {
    check_env.reopen(e);
    return check_env.check_decls(e, decls) && check_env.errors(e) == 0;
}

// The same for the declarations `first` and then `second`.
fn clean_of_two(check_env.env mut* e, string first, string second) bool {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, first);
    strbuf.append(&b, second);
    return clean(e, strbuf.view(&b));
}

fn an_array_behind_a_reference_that_is_too_large_is_refused() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // u64[2^62] needs 2^65 bytes and u16[2^62] needs 2^63, one more than fits
    assert(one_report(&e, "u64[4611686018427387904]* BIG = null;\n",
                      "1:1: type is too large: u64[4611686018427387904]"));
    assert(one_report(&e, "u16[4611686018427387904]* HALVES = null;\n",
                      "1:1: type is too large: u16[4611686018427387904]"));
    assert(one_report(&e, "u64[4611686018427387904]@ VIEW = {};\n",
                      "1:1: type is too large: u64[4611686018427387904]"));
    assert(one_report(&e, "(u64[4611686018427387904]*)[2] PAIR = {};\n",
                      "1:1: type is too large: u64[4611686018427387904]"));
    // 2^60 - 1 values of 8 bytes need 2^63 - 8 bytes; 2^63 - 1 bytes fit exactly
    assert(clean(&e, "u64[1152921504606846975]* WORDS = null;\n"));
    assert(clean(&e, "u8[9223372036854775807]@ BYTES = {};\n"));
}

fn a_nested_array_behind_a_pointer_is_named_whole() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // two u16[2^62] need 2^64 bytes; the message names the outer array
    assert(one_report(&e, "u16[2][4611686018427387904]* N = null;\n",
                      "1:1: type is too large: u16[2][4611686018427387904]"));
    // 2^60 structs of 24 bytes need 3 * 2^63 bytes
    assert(one_report_of_two(&e, "struct trio { u64 a; u64 b; u64 c; }\n",
                             "trio[1152921504606846976]* T = null;\n",
                             "2:1: type is too large: trio[1152921504606846976]"));
}

fn a_declaration_reports_the_type_behind_its_pointer() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(one_report(&e, "fn f(u64[4611686018427387904]* p) void {\n}\n",
                      "1:6: type is too large: u64[4611686018427387904]"));
    assert(one_report(&e, "fn f() u64[4611686018427387904]* {\n    return null;\n}\n",
                      "1:8: type is too large: u64[4611686018427387904]"));
    assert(one_report(&e, "struct holder {\n    u64[4611686018427387904]* p;\n}\n",
                      "2:5: type is too large: u64[4611686018427387904]"));
    // no value stores a parameter of a function type, but D3.4 refuses its type
    assert(one_report(&e, "fn(u64[4611686018427387904]) void OP = null;\n",
                      "1:1: type is too large: u64[4611686018427387904]"));
    assert(one_body_report(&e, "", "    u64[4611686018427387904]* p = null;",
                           "2:5: type is too large: u64[4611686018427387904]"));
    assert(one_body_report(&e, "    u64[2] w = {};\n",
                           "    println((*cast(&w, u64[2305843009213693952]*))[0]);",
                           "3:15: type is too large: u64[2305843009213693952]"));
    assert(one_body_report(&e, "    u64 z = sizeof(u64[4611686018427387904]*);\n",
                           "    println(z);", "2:13: type is too large: u64[4611686018427387904]"));
}

fn a_struct_behind_a_pointer_is_sized_after_its_layout() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // `late` is laid out after `early` resolves, so both orders are one program (D7.10)
    string early = "struct early {\n    late[4611686018427387904]* p;\n}\n";
    string late = "struct late { u64 a; }\n";
    assert(one_report_of_two(&e, early, late, "2:5: type is too large: late[4611686018427387904]"));
    assert(one_report_of_two(&e, late, early, "3:5: type is too large: late[4611686018427387904]"));
    assert(one_report(&e, "struct self {\n    self[4611686018427387904]* next;\n}\n",
                      "2:5: type is too large: self[4611686018427387904]"));
    assert(clean(&e, "struct self {\n    self[2]* next;\n}\n"));
    // `inner` contains `outer` by value. A forced layout of `inner` from the field
    // of `outer` would read `outer` as resolving and report an infinite size (D3.8).
    string inner = "struct inner {\n    outer o;\n    u64 x;\n}\n";
    assert(clean_of_two(&e, "struct outer {\n    inner[2]* p;\n}\n", inner));
    assert(one_report_of_two(&e, "struct outer {\n    inner[4611686018427387904]* p;\n}\n", inner,
                             "2:5: type is too large: inner[4611686018427387904]"));
    assert(!check_env.said(&e, "infinite size"));
    // Two structs each reach the other through a large array. The field of the
    // second struct reports and fails its struct, and the failed struct silences
    // the waiting entry of the first, so one error stays one error in both orders.
    string first = "struct a {\n    b[4611686018427387904]* p;\n}\n";
    string second = "struct b {\n    a[4611686018427387904]* q;\n}\n";
    assert(one_report_of_two(&e, first, second, "5:5: type is too large: a[4611686018427387904]"));
    assert(one_report_of_two(&e, second, first, "5:5: type is too large: b[4611686018427387904]"));
}

fn main() i32 {
    a_struct_of_a_hundred_and_twenty_eight_fields_is_the_last_that_fits();
    a_function_of_a_hundred_and_twenty_nine_parameters_is_refused();
    a_function_type_of_a_hundred_and_twenty_nine_parameters_is_refused();
    a_type_takes_256_suffixes_and_not_257();
    a_type_in_an_array_length_grows_the_suffix_stack();
    a_failed_type_closes_its_suffix_frame();
    a_group_does_not_reset_the_suffix_count();
    a_type_whose_size_would_pass_the_ceiling_of_d3_4_is_refused();
    an_array_behind_a_reference_that_is_too_large_is_refused();
    a_nested_array_behind_a_pointer_is_named_whole();
    a_declaration_reports_the_type_behind_its_pointer();
    a_struct_behind_a_pointer_is_sized_after_its_layout();
    println("ok");
    return 0;
}
