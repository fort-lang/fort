//! run
//! flags: -I ../../src/fort -I support -I ../../src
//! stdout:
//| states ok
//| methods ok
//| ids ok
//| open ok
//| change ok
//| close ok
//| free ok
//| encodings ok
//| ok
import lsp.docs;
import lsp.json;
import lsp.rpc;
import lsp.server;
import lsp.text;
import lsp_env;
import std.io;
import std.strbuf;

/// Checks server state transitions, response ids, error codes, and document notifications.
//
// A session digest contains one item for each frame that the server wrote.
// Spaces join the items. `1:ok` is a result. `1:-32601` is an error with that
// code. `null:-32700` is an error with no request id. A session with no answer
// has an empty digest.

// The bytes of `script` as one session, with the digest in the answer and the
// exit status in *status.
fn digest_of(string script, i32 mut* status) string own {
    lsp_env.pipe_ends in_ends = lsp_env.open_pipe();
    lsp_env.pipe_ends out_ends = lsp_env.open_pipe();
    lsp_env.feed(in_ends, script);
    server.server mut srv = server.create(in_ends.read_fd, out_ends.write_fd);
    *status = server.run(&srv);
    server.free(&srv);
    assert(io.close(in_ends.read_fd));
    assert(io.close(out_ends.write_fd));
    string own answers = lsp_env.drain(out_ends);
    strbuf.str_buf mut out = strbuf.create();
    defer strbuf.free(&out);
    digest_into(&out, answers);
    del(answers);
    return strbuf.take(&out);
}

// The digest of the frames in `answers`.
fn digest_into(strbuf.str_buf mut* out, string answers) void {
    json.doc mut d = json.create();
    defer json.free(&d);
    u64 mut at = 0;
    u64 mut seen = 0;
    while (at < answers.len) {
        // Each frame is `Content-Length: N\r\n\r\nbody`. The answers are this
        // server's own, so the header is the one it writes.
        u64 mut end = at;
        while (end + 4 <= answers.len && answers[end..end + 4] != "\r\n\r\n") {
            end += 1;
        }
        assert(end + 4 <= answers.len);
        string header = answers[at..end];
        assert(header[0..16] == "Content-Length: ");
        u64 mut len = 0;
        assert(str_parse(header[16..], &len));
        string body = answers[end + 4..end + 4 + len];
        if (seen > 0) {
            strbuf.append(out, " ");
        }
        seen += 1;
        assert(json.parse(&d, body));
        u32 root = json.root(&d);
        u32 id = json.member_of(&d, root, "id");
        if (id != 0 && json.kind_of(&d, id) == json.value_kind.k_int) {
            strbuf.append_i64(out, json.int_of(&d, id));
        } else if (id != 0 && json.kind_of(&d, id) == json.value_kind.k_string) {
            strbuf.append(out, json.text_of(&d, id));
        } else {
            strbuf.append(out, "null");
        }
        strbuf.append(out, ":");
        u32 error = json.member_of(&d, root, "error");
        if (error == 0) {
            strbuf.append(out, "ok");
        } else {
            strbuf.append_i64(out, json.int_of(&d, json.member_of(&d, error, "code")));
        }
        at = end + 4 + len;
    }
}

// The decimal number `s` spells. std.str.parse_u64 does the same. This file
// keeps its import list to the modules under test.
fn str_parse(string s, u64 mut* out) bool {
    if (s.len == 0) {
        return false;
    }
    u64 mut value = 0;
    u64 mut i = 0;
    while (i < s.len) {
        if (s[i] < '0' || s[i] > '9') {
            return false;
        }
        value = value * 10 + (cast(s[i], u64) - cast('0', u64));
        i += 1;
    }
    *out = value;
    return true;
}

// One frame around `body`, appended to `b`.
fn frame_into(strbuf.str_buf mut* b, string body) void {
    strbuf.append(b, "Content-Length: ");
    strbuf.append_u64(b, body.len);
    strbuf.append(b, "\r\n\r\n");
    strbuf.append(b, body);
}

// A request of `id` calling `method` with `params`.
fn request_into(strbuf.str_buf mut* b, i64 id, string method, string params) void {
    strbuf.str_buf mut body = strbuf.create();
    defer strbuf.free(&body);
    strbuf.append(&body, "{\"jsonrpc\":\"2.0\",\"id\":");
    strbuf.append_i64(&body, id);
    strbuf.append(&body, ",\"method\":\"");
    strbuf.append(&body, method);
    strbuf.append(&body, "\",\"params\":");
    strbuf.append(&body, params);
    strbuf.append(&body, "}");
    frame_into(b, strbuf.view(&body));
}

// A notification calling `method` with `params`.
fn note_into(strbuf.str_buf mut* b, string method, string params) void {
    strbuf.str_buf mut body = strbuf.create();
    defer strbuf.free(&body);
    strbuf.append(&body, "{\"jsonrpc\":\"2.0\",\"method\":\"");
    strbuf.append(&body, method);
    strbuf.append(&body, "\",\"params\":");
    strbuf.append(&body, params);
    strbuf.append(&body, "}");
    frame_into(b, strbuf.view(&body));
}

// The `initialize` every state below begins with.
fn initialize_into(strbuf.str_buf mut* b) void {
    request_into(b, 1, "initialize", "{}");
}

// The script answers `want` and exits with `status`.
fn answers_are(string script, string want, i64 status, string what) void {
    i32 mut got_status = -1;
    string own got = digest_of(script, &got_status);
    lsp_env.check(got, want, what);
    lsp_env.check_i64(cast(got_status, i64), status, what);
    del(got);
}

// ---- the three lifecycle states --------------------------------------------------

fn a_request_before_initialize_is_not_served() void {
    // Every request but `initialize` answers -32002 before initialize.
    strbuf.str_buf mut script = strbuf.create();
    defer strbuf.free(&script);
    request_into(&script, 2, "shutdown", "null");
    request_into(&script, 3, "textDocument/hover", "{}");
    request_into(&script, 4, "$/madeUp", "{}");
    answers_are(strbuf.view(&script), "2:-32002 3:-32002 4:-32002", 1,
                "requests before initialize");
}

fn a_notification_before_initialize_is_dropped() void {
    strbuf.str_buf mut script = strbuf.create();
    defer strbuf.free(&script);
    note_into(&script, "initialized", "{}");
    note_into(&script, "textDocument/didOpen",
              "{\"textDocument\":{\"uri\":\"file:///a.ft\",\"text\":\"x\"}}");
    note_into(&script, "$/cancelRequest", "{\"id\":1}");
    note_into(&script, "textDocument/didSave", "{}");
    answers_are(strbuf.view(&script), "", 1, "notifications before initialize");
}

fn initialize_is_served_once() void {
    strbuf.str_buf mut script = strbuf.create();
    defer strbuf.free(&script);
    initialize_into(&script);
    request_into(&script, 2, "initialize", "{}");
    request_into(&script, 3, "initialize", "{}");
    answers_are(strbuf.view(&script), "1:ok 2:-32600 3:-32600", 1, "three initializes");
}

fn a_request_after_shutdown_is_refused() void {
    strbuf.str_buf mut script = strbuf.create();
    defer strbuf.free(&script);
    initialize_into(&script);
    request_into(&script, 2, "shutdown", "null");
    request_into(&script, 3, "shutdown", "null");
    request_into(&script, 4, "textDocument/hover", "{}");
    request_into(&script, 5, "initialize", "{}");
    answers_are(strbuf.view(&script), "1:ok 2:ok 3:-32600 4:-32600 5:-32600", 0,
                "requests after shutdown");
}

fn a_notification_after_shutdown_is_dropped() void {
    strbuf.str_buf mut script = strbuf.create();
    defer strbuf.free(&script);
    initialize_into(&script);
    request_into(&script, 2, "shutdown", "null");
    note_into(&script, "initialized", "{}");
    note_into(&script, "textDocument/didOpen",
              "{\"textDocument\":{\"uri\":\"file:///a.ft\",\"text\":\"x\"}}");
    note_into(&script, "$/cancelRequest", "{\"id\":2}");
    note_into(&script, "exit", "null");
    answers_are(strbuf.view(&script), "1:ok 2:ok", 0, "notifications after shutdown");
}

fn exit_ends_the_loop_in_every_state() void {
    strbuf.str_buf mut before = strbuf.create();
    defer strbuf.free(&before);
    note_into(&before, "exit", "null");
    request_into(&before, 1, "initialize", "{}");
    answers_are(strbuf.view(&before), "", 1, "exit before initialize");
    strbuf.str_buf mut after = strbuf.create();
    defer strbuf.free(&after);
    initialize_into(&after);
    note_into(&after, "exit", "null");
    request_into(&after, 2, "shutdown", "null");
    answers_are(strbuf.view(&after), "1:ok", 1, "exit after initialize");
    strbuf.str_buf mut twice = strbuf.create();
    defer strbuf.free(&twice);
    initialize_into(&twice);
    request_into(&twice, 2, "shutdown", "null");
    note_into(&twice, "exit", "null");
    note_into(&twice, "exit", "null");
    answers_are(strbuf.view(&twice), "1:ok 2:ok", 0, "exit twice");
}

// ---- the methods -----------------------------------------------------------------

fn a_method_the_server_does_not_implement_is_not_found() void {
    strbuf.str_buf mut script = strbuf.create();
    defer strbuf.free(&script);
    initialize_into(&script);
    request_into(&script, 2, "textDocument/hover", "{}");
    request_into(&script, 3, "textDocument/definition", "{}");
    request_into(&script, 4, "textDocument/completion", "{}");
    request_into(&script, 5, "workspace/symbol", "{}");
    request_into(&script, 6, "", "{}");
    answers_are(strbuf.view(&script), "1:ok 2:-32601 3:-32601 4:-32601 5:-32601 6:-32601", 1,
                "methods the server does not implement");
}

fn a_notification_the_server_does_not_implement_is_dropped() void {
    strbuf.str_buf mut script = strbuf.create();
    defer strbuf.free(&script);
    initialize_into(&script);
    note_into(&script, "$/setTrace", "{\"value\":\"verbose\"}");
    note_into(&script, "workspace/didChangeConfiguration", "{}");
    note_into(&script, "", "{}");
    note_into(&script, "textDocument/willSave", "{}");
    answers_are(strbuf.view(&script), "1:ok", 1, "notifications the server does not implement");
}

fn exit_as_a_request_is_a_method_that_is_not_found() void {
    // `exit` is a notification in the protocol. A request of that name is a
    // client that is broken, and ending the loop would leave its request
    // unanswered, so the server answers it and reads on.
    strbuf.str_buf mut script = strbuf.create();
    defer strbuf.free(&script);
    initialize_into(&script);
    request_into(&script, 2, "exit", "null");
    request_into(&script, 3, "shutdown", "null");
    answers_are(strbuf.view(&script), "1:ok 2:-32601 3:ok", 0, "exit as a request");
}

fn shutdown_as_a_notification_is_dropped() void {
    // `shutdown` is a request. As a notification it cannot be answered, so it
    // is dropped and the session is still not shutting down.
    strbuf.str_buf mut script = strbuf.create();
    defer strbuf.free(&script);
    initialize_into(&script);
    note_into(&script, "shutdown", "null");
    note_into(&script, "exit", "null");
    answers_are(strbuf.view(&script), "1:ok", 1, "shutdown as a notification");
}

fn initialize_as_a_notification_is_dropped() void {
    // It cannot be answered, so the server is still not initialized.
    strbuf.str_buf mut script = strbuf.create();
    defer strbuf.free(&script);
    note_into(&script, "initialize", "{}");
    request_into(&script, 2, "shutdown", "null");
    answers_are(strbuf.view(&script), "2:-32002", 1, "initialize as a notification");
}

// ---- the ids ---------------------------------------------------------------------

fn an_answer_carries_the_id_of_its_request() void {
    strbuf.str_buf mut script = strbuf.create();
    defer strbuf.free(&script);
    initialize_into(&script);
    request_into(&script, 0, "textDocument/hover", "{}");
    request_into(&script, -7, "textDocument/hover", "{}");
    request_into(&script, 9007199254740993, "textDocument/hover", "{}");
    answers_are(strbuf.view(&script), "1:ok 0:-32601 -7:-32601 9007199254740993:-32601", 1,
                "the ids of the answers");
}

fn a_string_id_is_answered_as_a_string() void {
    strbuf.str_buf mut script = strbuf.create();
    defer strbuf.free(&script);
    initialize_into(&script);
    frame_into(&script, "{\"jsonrpc\":\"2.0\",\"id\":\"abc\",\"method\":\"textDocument/hover\"}");
    frame_into(&script, "{\"jsonrpc\":\"2.0\",\"id\":\"\",\"method\":\"textDocument/hover\"}");
    answers_are(strbuf.view(&script), "1:ok abc:-32601 :-32601", 1, "string ids");
}

fn a_message_that_breaks_a_rule_is_an_invalid_request() void {
    strbuf.str_buf mut script = strbuf.create();
    defer strbuf.free(&script);
    initialize_into(&script);
    // No version, a version of another kind, no method and no result, a method
    // of another kind, and an id of a kind JSON-RPC does not allow.
    frame_into(&script, "{\"id\":2,\"method\":\"shutdown\"}");
    frame_into(&script, "{\"jsonrpc\":2,\"id\":3,\"method\":\"shutdown\"}");
    frame_into(&script, "{\"jsonrpc\":\"2.0\",\"id\":4}");
    frame_into(&script, "{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":[1]}");
    frame_into(&script, "{\"jsonrpc\":\"2.0\",\"id\":1.5,\"method\":\"shutdown\"}");
    frame_into(&script, "[]");
    frame_into(&script, "7");
    answers_are(strbuf.view(&script),
                "1:ok 2:-32600 3:-32600 4:-32600 5:-32600 null:-32600 null:-32600 null:-32600", 1,
                "messages that break a rule");
}

fn a_response_is_dropped() void {
    strbuf.str_buf mut script = strbuf.create();
    defer strbuf.free(&script);
    initialize_into(&script);
    frame_into(&script, "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{}}");
    frame_into(&script, "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":null}");
    frame_into(&script, "{\"jsonrpc\":\"2.0\",\"id\":null,\"error\":{\"code\":-1}}");
    answers_are(strbuf.view(&script), "1:ok", 1, "responses");
}

fn a_body_that_is_no_json_is_a_parse_error() void {
    strbuf.str_buf mut script = strbuf.create();
    defer strbuf.free(&script);
    initialize_into(&script);
    frame_into(&script, "{");
    frame_into(&script, "");
    frame_into(&script, "{\"a\":}");
    frame_into(&script, "{} {}");
    frame_into(&script, "\xff");
    request_into(&script, 2, "shutdown", "null");
    answers_are(strbuf.view(&script),
                "1:ok null:-32700 null:-32700 null:-32700 null:-32700 null:-32700 2:ok", 0,
                "bodies that are no JSON");
}

// ---- didOpen ---------------------------------------------------------------------

// The store of a session, after the script ran.
fn with_store(string script, string uri, string want_text, i64 want_version, u64 want_count,
                   string what) void {
    lsp_env.pipe_ends in_ends = lsp_env.open_pipe();
    lsp_env.pipe_ends out_ends = lsp_env.open_pipe();
    lsp_env.feed(in_ends, script);
    server.server mut srv = server.create(in_ends.read_fd, out_ends.write_fd);
    server.run(&srv);
    docs.store* open_docs = server.documents(&srv);
    lsp_env.check_u64(docs.count(open_docs), want_count, what);
    lsp_env.check(docs.text_of(open_docs, uri), want_text, what);
    lsp_env.check_i64(docs.version_of(open_docs, uri), want_version, what);
    server.free(&srv);
    assert(io.close(in_ends.read_fd));
    assert(io.close(out_ends.write_fd));
    string own answers = lsp_env.drain(out_ends);
    del(answers);
}

fn didopen_holds_the_text_and_the_version() void {
    strbuf.str_buf mut script = strbuf.create();
    defer strbuf.free(&script);
    initialize_into(&script);
    note_into(&script, "textDocument/didOpen",
              "{\"textDocument\":{\"uri\":\"file:///a.ft\",\"version\":4,\"text\":\"body\"}}");
    with_store(strbuf.view(&script), "file:///a.ft", "body", 4, 1, "didOpen");
}

fn didopen_without_a_version_holds_zero() void {
    // The protocol always sends one. A client that does not gets the version
    // the store starts a document at.
    strbuf.str_buf mut script = strbuf.create();
    defer strbuf.free(&script);
    initialize_into(&script);
    note_into(&script, "textDocument/didOpen",
              "{\"textDocument\":{\"uri\":\"file:///a.ft\",\"text\":\"body\"}}");
    with_store(strbuf.view(&script), "file:///a.ft", "body", 0, 1, "didOpen without a version");
}

fn didopen_with_a_version_of_another_kind_holds_zero() void {
    strbuf.str_buf mut script = strbuf.create();
    defer strbuf.free(&script);
    initialize_into(&script);
    note_into(&script, "textDocument/didOpen",
              "{\"textDocument\":{\"uri\":\"file:///a.ft\",\"version\":1.5,\"text\":\"b\"}}");
    with_store(strbuf.view(&script), "file:///a.ft", "b", 0, 1, "a version of 1.5");
}

fn didopen_of_the_empty_text_opens_a_document() void {
    strbuf.str_buf mut script = strbuf.create();
    defer strbuf.free(&script);
    initialize_into(&script);
    note_into(&script, "textDocument/didOpen",
              "{\"textDocument\":{\"uri\":\"file:///new.ft\",\"version\":1,\"text\":\"\"}}");
    with_store(strbuf.view(&script), "file:///new.ft", "", 1, 1, "an empty document");
}

fn didopen_carries_the_escapes_of_the_text() void {
    // The text of a message is JSON, so a newline and a quote arrive escaped
    // and the store holds the bytes they stand for.
    strbuf.str_buf mut script = strbuf.create();
    defer strbuf.free(&script);
    initialize_into(&script);
    strbuf.str_buf mut params = strbuf.create();
    defer strbuf.free(&params);
    strbuf.append(&params, "{\"textDocument\":{\"uri\":\"file:///a.ft\",\"version\":1,");
    strbuf.append(&params, "\"text\":\"a\\nb\\t\\\"c\\\"\\u00e9\"}}");
    note_into(&script, "textDocument/didOpen", strbuf.view(&params));
    with_store(strbuf.view(&script), "file:///a.ft", "a\nb\t\"c\"\xC3\xA9", 1, 1, "escapes");
}

fn didopen_without_the_parameters_it_needs_is_dropped() void {
    strbuf.str_buf mut script = strbuf.create();
    defer strbuf.free(&script);
    initialize_into(&script);
    frame_into(&script, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\"}");
    note_into(&script, "textDocument/didOpen", "[]");
    note_into(&script, "textDocument/didOpen", "{\"textDocument\":[]}");
    note_into(&script, "textDocument/didOpen", "{\"textDocument\":{\"uri\":null,\"text\":\"x\"}}");
    with_store(strbuf.view(&script), "file:///a.ft", "", -1, 0, "didOpen without parameters");
}

// ---- didChange -------------------------------------------------------------------

fn didchange_takes_the_text_of_the_last_change() void {
    strbuf.str_buf mut script = strbuf.create();
    defer strbuf.free(&script);
    initialize_into(&script);
    note_into(&script, "textDocument/didOpen",
              "{\"textDocument\":{\"uri\":\"file:///a.ft\",\"version\":1,\"text\":\"one\"}}");
    strbuf.str_buf mut params = strbuf.create();
    defer strbuf.free(&params);
    strbuf.append(&params, "{\"textDocument\":{\"uri\":\"file:///a.ft\",\"version\":2},");
    strbuf.append(&params, "\"contentChanges\":[{\"text\":\"two\"},{\"text\":\"three\"}]}");
    note_into(&script, "textDocument/didChange", strbuf.view(&params));
    with_store(strbuf.view(&script), "file:///a.ft", "three", 2, 1, "the last change wins");
}

fn didchange_with_no_changes_leaves_the_document_alone() void {
    // The client sent no text to hold, so the version does not move either.
    strbuf.str_buf mut script = strbuf.create();
    defer strbuf.free(&script);
    initialize_into(&script);
    note_into(&script, "textDocument/didOpen",
              "{\"textDocument\":{\"uri\":\"file:///a.ft\",\"version\":1,\"text\":\"one\"}}");
    strbuf.str_buf mut params = strbuf.create();
    defer strbuf.free(&params);
    strbuf.append(&params, "{\"textDocument\":{\"uri\":\"file:///a.ft\",\"version\":2},");
    strbuf.append(&params, "\"contentChanges\":[]}");
    note_into(&script, "textDocument/didChange", strbuf.view(&params));
    with_store(strbuf.view(&script), "file:///a.ft", "one", 1, 1, "a change with no changes");
}

fn didchange_without_a_version_keeps_the_one_it_had() void {
    strbuf.str_buf mut script = strbuf.create();
    defer strbuf.free(&script);
    initialize_into(&script);
    note_into(&script, "textDocument/didOpen",
              "{\"textDocument\":{\"uri\":\"file:///a.ft\",\"version\":5,\"text\":\"one\"}}");
    strbuf.str_buf mut params = strbuf.create();
    defer strbuf.free(&params);
    strbuf.append(&params, "{\"textDocument\":{\"uri\":\"file:///a.ft\"},");
    strbuf.append(&params, "\"contentChanges\":[{\"text\":\"two\"}]}");
    note_into(&script, "textDocument/didChange", strbuf.view(&params));
    with_store(strbuf.view(&script), "file:///a.ft", "two", 5, 1, "a change without a version");
}

fn didchange_of_a_document_that_is_not_open_is_dropped() void {
    strbuf.str_buf mut script = strbuf.create();
    defer strbuf.free(&script);
    initialize_into(&script);
    strbuf.str_buf mut params = strbuf.create();
    defer strbuf.free(&params);
    strbuf.append(&params, "{\"textDocument\":{\"uri\":\"file:///b.ft\",\"version\":2},");
    strbuf.append(&params, "\"contentChanges\":[{\"text\":\"two\"}]}");
    note_into(&script, "textDocument/didChange", strbuf.view(&params));
    with_store(strbuf.view(&script), "file:///b.ft", "", -1, 0, "a change of an unopened document");
}

fn didchange_with_changes_of_the_wrong_kind_is_dropped() void {
    strbuf.str_buf mut script = strbuf.create();
    defer strbuf.free(&script);
    initialize_into(&script);
    note_into(&script, "textDocument/didOpen",
              "{\"textDocument\":{\"uri\":\"file:///a.ft\",\"version\":1,\"text\":\"one\"}}");
    strbuf.str_buf mut params = strbuf.create();
    defer strbuf.free(&params);
    strbuf.append(&params, "{\"textDocument\":{\"uri\":\"file:///a.ft\",\"version\":2},");
    strbuf.append(&params, "\"contentChanges\":{\"text\":\"two\"}}");
    note_into(&script, "textDocument/didChange", strbuf.view(&params));
    strbuf.clear(&params);
    strbuf.append(&params, "{\"textDocument\":{\"uri\":\"file:///a.ft\",\"version\":3},");
    strbuf.append(&params, "\"contentChanges\":[{\"text\":7}]}");
    note_into(&script, "textDocument/didChange", strbuf.view(&params));
    strbuf.clear(&params);
    strbuf.append(&params, "{\"textDocument\":{\"uri\":\"file:///a.ft\",\"version\":4},");
    strbuf.append(&params, "\"contentChanges\":[\"two\"]}");
    note_into(&script, "textDocument/didChange", strbuf.view(&params));
    with_store(strbuf.view(&script), "file:///a.ft", "one", 1, 1, "changes of the wrong kind");
}

// ---- didClose and didSave --------------------------------------------------------

fn didclose_removes_the_document() void {
    strbuf.str_buf mut script = strbuf.create();
    defer strbuf.free(&script);
    initialize_into(&script);
    note_into(&script, "textDocument/didOpen",
              "{\"textDocument\":{\"uri\":\"file:///a.ft\",\"version\":1,\"text\":\"one\"}}");
    note_into(&script, "textDocument/didClose", "{\"textDocument\":{\"uri\":\"file:///a.ft\"}}");
    with_store(strbuf.view(&script), "file:///a.ft", "", -1, 0, "didClose");
}

fn didclose_of_a_document_that_is_not_open_changes_nothing() void {
    strbuf.str_buf mut script = strbuf.create();
    defer strbuf.free(&script);
    initialize_into(&script);
    note_into(&script, "textDocument/didOpen",
              "{\"textDocument\":{\"uri\":\"file:///a.ft\",\"version\":1,\"text\":\"one\"}}");
    note_into(&script, "textDocument/didClose", "{\"textDocument\":{\"uri\":\"file:///b.ft\"}}");
    note_into(&script, "textDocument/didClose", "{\"textDocument\":{}}");
    note_into(&script, "textDocument/didClose", "{}");
    with_store(strbuf.view(&script), "file:///a.ft", "one", 1, 1, "didClose of another document");
}

fn didsave_changes_nothing() void {
    strbuf.str_buf mut script = strbuf.create();
    defer strbuf.free(&script);
    initialize_into(&script);
    note_into(&script, "textDocument/didOpen",
              "{\"textDocument\":{\"uri\":\"file:///a.ft\",\"version\":1,\"text\":\"one\"}}");
    strbuf.str_buf mut params = strbuf.create();
    defer strbuf.free(&params);
    strbuf.append(&params, "{\"textDocument\":{\"uri\":\"file:///a.ft\"},");
    strbuf.append(&params, "\"text\":\"the text on disk, which the server did not ask for\"}");
    note_into(&script, "textDocument/didSave", strbuf.view(&params));
    with_store(strbuf.view(&script), "file:///a.ft", "one", 1, 1, "didSave");
}


fn the_server_is_ready_only_after_the_initialized_notification() void {
    // A server sends nothing before `initialized` arrives. The ready flag is
    // part of this lifecycle even though diagnostics are its first user.
    lsp_env.pipe_ends in_ends = lsp_env.open_pipe();
    lsp_env.pipe_ends out_ends = lsp_env.open_pipe();
    strbuf.str_buf mut script = strbuf.create();
    defer strbuf.free(&script);
    initialize_into(&script);
    lsp_env.feed(in_ends, strbuf.view(&script));
    server.server mut srv = server.create(in_ends.read_fd, out_ends.write_fd);
    assert(!server.is_ready(&srv));
    server.run(&srv);
    // initialize alone does not make a server ready.
    assert(!server.is_ready(&srv));
    json.doc mut d = json.create();
    defer json.free(&d);
    assert(json.parse(&d, "{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{}}"));
    rpc.message mut m = rpc.message{};
    rpc.classify(&d, &m);
    server.dispatch(&srv, &d, &m);
    assert(server.is_ready(&srv));
    // Free clears the flag with the rest of the session state.
    server.free(&srv);
    assert(!server.is_ready(&srv));
    assert(io.close(in_ends.read_fd));
    assert(io.close(out_ends.write_fd));
    string own answers = lsp_env.drain(out_ends);
    del(answers);
}

fn a_notification_before_initialize_leaves_the_server_unready() void {
    // The notification is dropped before initialize, so it does not make the
    // server ready either.
    lsp_env.pipe_ends in_ends = lsp_env.open_pipe();
    lsp_env.pipe_ends out_ends = lsp_env.open_pipe();
    strbuf.str_buf mut script = strbuf.create();
    defer strbuf.free(&script);
    note_into(&script, "initialized", "{}");
    lsp_env.feed(in_ends, strbuf.view(&script));
    server.server mut srv = server.create(in_ends.read_fd, out_ends.write_fd);
    server.run(&srv);
    assert(!server.is_ready(&srv));
    server.free(&srv);
    assert(io.close(in_ends.read_fd));
    assert(io.close(out_ends.write_fd));
    string own answers = lsp_env.drain(out_ends);
    lsp_env.check(answers, "", "a dropped initialized answers nothing");
    del(answers);
}

// ---- what free leaves ------------------------------------------------------------

fn a_server_that_was_freed_is_one_no_client_has_spoken_to() void {
    // free takes the lifecycle back to where create left it, so a server value
    // that is reused does not answer a second client as though it had already
    // been initialized and shut down.
    lsp_env.pipe_ends in_ends = lsp_env.open_pipe();
    lsp_env.pipe_ends out_ends = lsp_env.open_pipe();
    strbuf.str_buf mut script = strbuf.create();
    defer strbuf.free(&script);
    initialize_into(&script);
    request_into(&script, 2, "shutdown", "null");
    lsp_env.feed(in_ends, strbuf.view(&script));
    server.server mut srv = server.create(in_ends.read_fd, out_ends.write_fd);
    lsp_env.check_i64(cast(server.run(&srv), i64), 0, "the first session");
    assert(server.encoding(&srv) == text.position_encoding.enc_utf16);
    server.free(&srv);
    // The store is empty, no request is in flight, and the lifecycle is back
    // at the start: the next request is answered as one before initialize.
    lsp_env.check_u64(docs.count(server.documents(&srv)), 0, "the store after free");
    assert(!server.is_cancelled(&srv));
    assert(server.current_id(&srv).kind == rpc.id_kind.id_absent);
    json.doc mut d = json.create();
    defer json.free(&d);
    assert(json.parse(&d, "{\"jsonrpc\":\"2.0\",\"id\":9,\"method\":\"shutdown\"}"));
    rpc.message mut m = rpc.message{};
    rpc.classify(&d, &m);
    server.dispatch(&srv, &d, &m);
    server.free(&srv);
    assert(io.close(in_ends.read_fd));
    assert(io.close(out_ends.write_fd));
    string own answers = lsp_env.drain(out_ends);
    strbuf.str_buf mut digest = strbuf.create();
    defer strbuf.free(&digest);
    digest_into(&digest, answers);
    lsp_env.check(strbuf.view(&digest), "1:ok 2:ok 9:-32002", "a server that was freed");
    del(answers);
}

fn a_frame_above_the_cap_of_the_conn_ends_the_loop() void {
    // The framing refuses it before a byte of the body is read, and the loop
    // ends because the stream cannot be followed past a frame that was never
    // read. The answers before it stand.
    lsp_env.pipe_ends in_ends = lsp_env.open_pipe();
    lsp_env.pipe_ends out_ends = lsp_env.open_pipe();
    strbuf.str_buf mut script = strbuf.create();
    defer strbuf.free(&script);
    initialize_into(&script);
    request_into(&script, 2, "textDocument/hover", "{}");
    request_into(&script, 3, "shutdown", "null");
    lsp_env.feed(in_ends, strbuf.view(&script));
    server.server mut srv = server.create(in_ends.read_fd, out_ends.write_fd);
    // A cap below the second frame, which is 74 bytes of body.
    rpc.set_max_content(server.connection(&srv), 60);
    lsp_env.check_i64(cast(server.run(&srv), i64), 1, "the status after a frame that is too large");
    server.free(&srv);
    assert(io.close(in_ends.read_fd));
    assert(io.close(out_ends.write_fd));
    string own answers = lsp_env.drain(out_ends);
    strbuf.str_buf mut digest = strbuf.create();
    defer strbuf.free(&digest);
    digest_into(&digest, answers);
    lsp_env.check(strbuf.view(&digest), "1:ok", "the answers before the frame that is too large");
    del(answers);
}

fn a_frame_whose_header_field_holds_a_bare_line_feed_ends_the_loop() void {
    // The framing refuses the field, so the server never reads the body and
    // cannot follow the stream past it: the loop ends with status 1 and the
    // answers before it stand, exactly as for a frame above the cap. The
    // second length is what the refusal is for. A reader that ended a header
    // line at the line feed would take a two-byte body here, where this one
    // sees a five-byte body declared by a field whose value holds a line feed,
    // and the two would disagree about where the next frame begins.
    strbuf.str_buf mut script = strbuf.create();
    defer strbuf.free(&script);
    initialize_into(&script);
    strbuf.append(&script, "Content-Length: 5\r\nX: a\nContent-Length: 2\r\n\r\n{}abc");
    answers_are(strbuf.view(&script), "1:ok", 1, "a header field with a bare line feed");
    // A bare carriage return in the same place ends it the same way, and so
    // does one in the first frame, before anything is answered.
    strbuf.str_buf mut second = strbuf.create();
    defer strbuf.free(&second);
    initialize_into(&second);
    strbuf.append(&second, "Content-Length: 5\r\nX: a\rContent-Length: 2\r\n\r\n{}abc");
    answers_are(strbuf.view(&second), "1:ok", 1, "a header field with a bare carriage return");
    answers_are("Content-Length: 2\r\nX: a\nY: b\r\n\r\n{}", "", 1,
                "a bare line feed in the first frame");
}

fn a_frame_whose_field_name_holds_a_space_ends_the_loop() void {
    // The framing refuses this field after initialization. The loop ends with
    // status 1 and only the answer
    // before it stands. What makes this worth a case of its own: the 48 bytes
    // a reader that trims the name would take hold a whole second request, so
    // the two readers disagree about a message and not only about a frame.
    strbuf.str_buf mut script = strbuf.create();
    defer strbuf.free(&script);
    initialize_into(&script);
    strbuf.append(&script, "Content-Length : 48\r\n");
    strbuf.append(&script, "Content-Length: 2\r\n\r\n{}");
    strbuf.append(&script, "Content-Length: 24\r\n\r\n{\"jsonrpc\":\"2.0\",\"id\":9}");
    answers_are(strbuf.view(&script), "1:ok", 1, "a field name that holds a space");
    // The same script with a vertical tab in place of the space. The RFC calls
    // that byte no whitespace and `String.prototype.trim` in JavaScript strips
    // it, so a reader on that runtime -- vscode-jsonrpc, for one -- takes the
    // 48 bytes and delivers the request this server must not let through.
    strbuf.str_buf mut tabbed = strbuf.create();
    defer strbuf.free(&tabbed);
    initialize_into(&tabbed);
    strbuf.append(&tabbed, "Content-Length\x0B: 48\r\n");
    strbuf.append(&tabbed, "Content-Length: 2\r\n\r\n{}");
    strbuf.append(&tabbed, "Content-Length: 24\r\n\r\n{\"jsonrpc\":\"2.0\",\"id\":9}");
    answers_are(strbuf.view(&tabbed), "1:ok", 1, "a field name that holds a vertical tab");
}

// ---- the position encoding -------------------------------------------------------

// The encoding the server holds after that initialize.
fn negotiates(string params, text.position_encoding want, string what) void {
    strbuf.str_buf mut script = strbuf.create();
    defer strbuf.free(&script);
    request_into(&script, 1, "initialize", params);
    lsp_env.pipe_ends in_ends = lsp_env.open_pipe();
    lsp_env.pipe_ends out_ends = lsp_env.open_pipe();
    lsp_env.feed(in_ends, strbuf.view(&script));
    server.server mut srv = server.create(in_ends.read_fd, out_ends.write_fd);
    server.run(&srv);
    if (server.encoding(&srv) != want) {
        println("case: ", what);
        println("  the server answered ", text.encoding_name(server.encoding(&srv)));
    }
    assert(server.encoding(&srv) == want);
    server.free(&srv);
    assert(io.close(in_ends.read_fd));
    assert(io.close(out_ends.write_fd));
    string own answers = lsp_env.drain(out_ends);
    del(answers);
}

fn the_first_name_the_server_implements_is_the_one() void {
    strbuf.str_buf mut params = strbuf.create();
    defer strbuf.free(&params);
    strbuf.append(&params, "{\"capabilities\":{\"general\":{\"positionEncodings\":");
    strbuf.append(&params, "[\"utf-32\",\"utf-16\",\"utf-8\"]}}}");
    negotiates(strbuf.view(&params), text.position_encoding.enc_utf16, "utf-32 utf-16 utf-8");
    strbuf.clear(&params);
    strbuf.append(&params, "{\"capabilities\":{\"general\":{\"positionEncodings\":");
    strbuf.append(&params, "[\"utf-32\",\"utf-8\",\"utf-16\"]}}}");
    negotiates(strbuf.view(&params), text.position_encoding.enc_utf8, "utf-32 utf-8 utf-16");
}

fn a_list_the_server_cannot_read_leaves_utf16() void {
    strbuf.str_buf mut params = strbuf.create();
    defer strbuf.free(&params);
    strbuf.append(&params, "{\"capabilities\":{\"general\":{\"positionEncodings\":");
    strbuf.append(&params, "[7,null,{},[],\"utf-8\"]}}}");
    // The names that are no strings are passed over, and the one string the
    // server implements decides.
    negotiates(strbuf.view(&params), text.position_encoding.enc_utf8, "a list of other kinds");
    strbuf.clear(&params);
    strbuf.append(&params, "{\"capabilities\":{\"general\":{\"positionEncodings\":");
    strbuf.append(&params, "[7,null,{},[]]}}}");
    negotiates(strbuf.view(&params), text.position_encoding.enc_utf16, "no name at all");
    negotiates("{\"capabilities\":{\"general\":{\"positionEncodings\":null}}}",
               text.position_encoding.enc_utf16, "a list of null");
    negotiates("{\"capabilities\":{\"general\":[]}}", text.position_encoding.enc_utf16,
               "general of another kind");
    negotiates("{\"capabilities\":7}", text.position_encoding.enc_utf16,
               "capabilities of another kind");
    negotiates("[]", text.position_encoding.enc_utf16, "parameters of another kind");
}

fn main() i32 {
    a_request_before_initialize_is_not_served();
    a_notification_before_initialize_is_dropped();
    initialize_is_served_once();
    a_request_after_shutdown_is_refused();
    a_notification_after_shutdown_is_dropped();
    exit_ends_the_loop_in_every_state();
    println("states ok");
    a_method_the_server_does_not_implement_is_not_found();
    a_notification_the_server_does_not_implement_is_dropped();
    exit_as_a_request_is_a_method_that_is_not_found();
    shutdown_as_a_notification_is_dropped();
    initialize_as_a_notification_is_dropped();
    println("methods ok");
    an_answer_carries_the_id_of_its_request();
    a_string_id_is_answered_as_a_string();
    a_message_that_breaks_a_rule_is_an_invalid_request();
    a_response_is_dropped();
    a_body_that_is_no_json_is_a_parse_error();
    println("ids ok");
    didopen_holds_the_text_and_the_version();
    didopen_without_a_version_holds_zero();
    didopen_with_a_version_of_another_kind_holds_zero();
    didopen_of_the_empty_text_opens_a_document();
    didopen_carries_the_escapes_of_the_text();
    didopen_without_the_parameters_it_needs_is_dropped();
    println("open ok");
    didchange_takes_the_text_of_the_last_change();
    didchange_with_no_changes_leaves_the_document_alone();
    didchange_without_a_version_keeps_the_one_it_had();
    didchange_of_a_document_that_is_not_open_is_dropped();
    didchange_with_changes_of_the_wrong_kind_is_dropped();
    println("change ok");
    didclose_removes_the_document();
    didclose_of_a_document_that_is_not_open_changes_nothing();
    didsave_changes_nothing();
    println("close ok");
    the_server_is_ready_only_after_the_initialized_notification();
    a_notification_before_initialize_leaves_the_server_unready();
    a_server_that_was_freed_is_one_no_client_has_spoken_to();
    a_frame_above_the_cap_of_the_conn_ends_the_loop();
    a_frame_whose_header_field_holds_a_bare_line_feed_ends_the_loop();
    a_frame_whose_field_name_holds_a_space_ends_the_loop();
    println("free ok");
    the_first_name_the_server_implements_is_the_one();
    a_list_the_server_cannot_read_leaves_utf16();
    println("encodings ok");
    println("ok");
    return 0;
}
