//! run
//! flags: -I ../../src
//! abort
//! stderr: panic: index.at: index out of range
//! stdout:
//| an empty index ok
/// The records of an index are index.count of them. Asking for one past the end
/// is a violated precondition and panics, where bootstrap0/src/index.c ends the
/// process with an internal error.
import fort.index;

fn main() i32 {
    index.index mut* own ix = index.make();
    defer index.drop_made(move(ix));
    assert(index.count(ix) == 0);
    println("an empty index ok");
    index.entry e = index.at(ix, 0);
    println(e.name);
    return 0;
}
