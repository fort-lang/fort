//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: index.at: index out of range
//! stdout:
//| an empty index ok
import index;

// The records of an index are index.count of them; asking for one past the end
// is a violated precondition and panics, where src/bootstrap/index.c ends the
// process with an internal error.
// D13.3, D20.5
fn main() i32 {
    index.index mut ix = index.create();
    defer index.free(&ix);
    assert(index.count(&ix) == 0);
    println("an empty index ok");
    index.entry e = index.at(&ix, 0);
    println(e.name);
    return 0;
}
