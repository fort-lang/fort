//! run
//! flags: -I ../../src/fort
//! stdout:
//| G08.4 combined teardown ok
//| missing services and limits ok
//| mixed terminal evidence
/// Tests the joined state, limit, event, and extension contracts.
import ownership_api;
import ownership_events;
import ownership_join;
import ownership_limits;
import ownership_state;

fn id(ownership_api.entity_kind kind, u32 ordinal) ownership_api.entity_id {
    ownership_api.entity_id mut out = ownership_api.entity_id{};
    out.kind = kind;
    out.ordinal = ordinal;
    return out;
}

fn allocation(u32 ordinal) ownership_api.allocation_fact {
    ownership_api.allocation_fact mut out = ownership_api.allocation_fact{};
    out.key = id(ownership_api.entity_kind.allocation, ordinal);
    out.site = id(ownership_api.entity_kind.allocation, 1);
    out.validity = ownership_api.validity_kind.live;
    out.count.one = true;
    out.obligation = true;
    out.owner.place.root = id(ownership_api.entity_kind.slot, ordinal);
    return out;
}

fn op(u32 ordinal) ownership_api.operation_position {
    ownership_api.operation_position mut out = ownership_api.operation_position{};
    out.operation = ordinal;
    return out;
}

fn combined_teardown() void {
    u64 mut round = 0;
    while (round < 24) {
        ownership_state.state mut a = ownership_state.empty();
        ownership_state.state mut b = ownership_state.empty();
        ownership_state.append_allocations(&a, allocation(1));
        ownership_state.append_allocations(&b, allocation(2));
        ownership_events.store mut events = ownership_events.store{};
        ownership_api.services mut svc = ownership_api.services{};
        ownership_api.limit_table bounds = ownership_limits.production();
        assert(ownership_events.bind(&events, &bounds, &svc));
        ownership_api.operation_position at = op(cast(round + 1, u32));
        ownership_api.source_position source = ownership_api.source_position{};
        ownership_state.state mut joined = ownership_join.join(&a, &b, &svc, &bounds, at, source);
        assert(ownership_api.successful(joined.proof));
        assert(joined.allocations_len == 2);
        assert(joined.allocations[0].obligation && joined.allocations[1].obligation);
        ownership_api.mutation_result refused = ownership_state.release_member(&joined,
            &svc, allocation(1).key, true, at, source);
        assert(!refused.applied && events.len == 1);
        assert(joined.allocations[0].obligation && joined.allocations[1].obligation);
        ownership_state.state mut widened = ownership_join.widen(&joined, &a, &svc,
            &bounds, at, source);
        assert(ownership_api.successful(widened.proof));
        assert(widened.allocations_len == 2);
        ownership_state.free(&widened);
        ownership_state.free(&a);
        ownership_state.free(&b);
        ownership_api.state_handle mut state = ownership_state.handle(&joined);
        ownership_api.event_handle mut event = ownership_api.event_handle{
            cast(&events, void mut*), ownership_events.destroy};
        ownership_api.teardown(&state, &event);
        assert(state.context == null && event.context == null);
        round += 1;
    }
    println("G08.4 combined teardown ok");
}

fn missing_services() void {
    ownership_state.state mut live = ownership_state.empty();
    ownership_state.state mut empty = ownership_state.empty();
    ownership_state.append_allocations(&live, allocation(3));
    ownership_api.services mut absent = ownership_api.services{};
    ownership_api.operation_position at = op(31);
    ownership_api.source_position source = ownership_api.source_position{};
    ownership_api.limit_table bounds = ownership_limits.production();
    ownership_state.state mut no_budget = ownership_join.join(&live, &empty,
        &absent, &bounds, at, source);
    assert(no_budget.proof.kind == ownership_api.proof_kind.incomplete);
    assert(no_budget.proof.terminal.reason == ownership_api.incomplete_reason.missing_budget);
    assert(no_budget.allocations_len == 1 && no_budget.allocations[0].obligation);
    ownership_events.store mut events = ownership_events.store{};
    assert(ownership_events.bind(&events, &bounds, &absent));
    absent.event = null;
    ownership_state.state mut no_event = ownership_join.join(&live, &empty,
        &absent, &bounds, at, source);
    assert(no_event.proof.kind == ownership_api.proof_kind.incomplete);
    assert(no_event.proof.terminal.reason == ownership_api.incomplete_reason.missing_events);
    assert(no_event.allocations_len == 1 && no_event.allocations[0].obligation);
    ownership_state.free(&no_event);
    ownership_state.free(&no_budget);
    ownership_events.free(&events);
    ownership_state.free(&empty);
    ownership_state.free(&live);
}

fn rejected_limits() void {
    ownership_api.limit_table good = ownership_limits.production();
    ownership_api.limit_table mut bad = good;
    bad.d = 0;
    ownership_events.store mut zero_events = ownership_events.store{};
    ownership_api.services mut svc = ownership_api.services{};
    assert(!ownership_events.bind(&zero_events, &bad, &svc));
    bad = good;
    bad.version += 1;
    ownership_events.store mut version_events = ownership_events.store{};
    assert(!ownership_events.bind(&version_events, &bad, &svc));
    ownership_state.state mut live = ownership_state.empty();
    ownership_state.state mut empty = ownership_state.empty();
    ownership_state.append_allocations(&live, allocation(4));
    ownership_events.store mut valid_events = ownership_events.store{};
    assert(ownership_events.bind(&valid_events, &good, &svc));
    ownership_api.operation_position at = op(32);
    ownership_api.source_position source = ownership_api.source_position{};
    u64 before_work = valid_events.budget.used.w;
    ownership_state.state mut invalid_join = ownership_join.join(&live, &empty,
        &svc, &bad, at, source);
    assert(invalid_join.proof.terminal.reason == ownership_api.incomplete_reason.invalid_input);
    assert(invalid_join.allocations_len == 1 && invalid_join.allocations[0].obligation);
    ownership_state.state mut invalid_widen = ownership_join.widen(&live, &empty,
        &svc, &bad, at, source);
    assert(invalid_widen.proof.terminal.reason == ownership_api.incomplete_reason.invalid_input);
    assert(invalid_widen.allocations_len == 1 && invalid_widen.allocations[0].obligation);
    assert(valid_events.budget.used.w == before_work);
    ownership_state.free(&invalid_join);
    ownership_state.free(&invalid_widen);
    ownership_events.free(&valid_events);
    ownership_events.free(&version_events);
    ownership_events.free(&zero_events);
    ownership_state.free(&empty);
    ownership_state.free(&live);
}

fn exhausted_work() void {
    ownership_state.state mut live = ownership_state.empty();
    ownership_state.state mut empty = ownership_state.empty();
    ownership_state.append_allocations(&live, allocation(5));
    ownership_api.limit_table mut bounds = ownership_limits.production();
    bounds.w = 4;
    ownership_events.store mut events = ownership_events.store{};
    ownership_api.services mut svc = ownership_api.services{};
    assert(ownership_events.bind(&events, &bounds, &svc));
    ownership_api.operation_position at = op(33);
    ownership_api.source_position source = ownership_api.source_position{};
    ownership_state.state mut first = ownership_join.join(&live, &empty, &svc, &bounds, at, source);
    assert(ownership_api.successful(first.proof));
    ownership_state.state mut second = ownership_join.join(&live, &empty, &svc,
        &bounds, at, source);
    assert(second.proof.kind == ownership_api.proof_kind.incomplete);
    assert(second.proof.terminal.reason == ownership_api.incomplete_reason.work_limit);
    assert(second.proof.terminal.limit.present);
    assert(second.proof.terminal.limit.category == ownership_api.limit_category.w);
    assert(second.allocations_len == 1 && second.allocations[0].obligation);
    assert(live.allocations[0].obligation && live.allocations[0].history.len == 0);
    ownership_state.free(&second);
    ownership_state.free(&first);
    ownership_events.free(&events);
    ownership_state.free(&empty);
    ownership_state.free(&live);
}

fn boundary_states() void {
    ownership_state.state mut live = ownership_state.empty();
    ownership_state.state mut unreachable = ownership_state.bottom();
    ownership_state.state mut unknown = ownership_state.unknown();
    ownership_state.append_allocations(&live, allocation(6));
    ownership_events.store mut events = ownership_events.store{};
    ownership_api.services mut svc = ownership_api.services{};
    ownership_api.limit_table bounds = ownership_limits.production();
    assert(ownership_events.bind(&events, &bounds, &svc));
    ownership_api.operation_position at = op(34);
    ownership_api.source_position source = ownership_api.source_position{};
    ownership_state.state mut bottom_left = ownership_join.join(&unreachable, &live,
        &svc, &bounds, at, source);
    ownership_state.state mut bottom_right = ownership_join.join(&live, &unreachable,
        &svc, &bounds, at, source);
    assert(ownership_state.equal(&bottom_left, &live));
    assert(ownership_state.equal(&bottom_left, &bottom_right));
    ownership_state.state mut unknown_left = ownership_join.join(&unknown, &live,
        &svc, &bounds, at, source);
    ownership_state.state mut unknown_right = ownership_join.join(&live, &unknown,
        &svc, &bounds, at, source);
    assert(ownership_state.equal(&unknown_left, &unknown_right));
    assert(unknown_left.proof.kind == ownership_api.proof_kind.incomplete);
    assert(unknown_left.allocations_len == 1 && unknown_left.allocations[0].obligation);
    ownership_state.free(&unknown_right);
    ownership_state.free(&unknown_left);
    ownership_state.free(&bottom_right);
    ownership_state.free(&bottom_left);
    ownership_events.free(&events);
    ownership_state.free(&unknown);
    ownership_state.free(&unreachable);
    ownership_state.free(&live);
}

fn mixed_terminal_evidence() void {
    ownership_state.state mut unknown = ownership_state.unknown();
    ownership_state.state mut failed = ownership_state.empty();
    ownership_state.append_allocations(&failed, allocation(7));
    ownership_api.operation_position at = op(35);
    ownership_api.source_position source = ownership_api.source_position{};
    failed.proof = ownership_api.incomplete(ownership_api.incomplete_reason.work_limit,
        at, source);
    failed.proof.terminal.limit.present = true;
    failed.proof.terminal.limit.category = ownership_api.limit_category.w;
    failed.proof.terminal.limit.used = 4;
    failed.proof.terminal.limit.bound = 4;
    failed.proof.terminal.limit.attempted = 1;
    ownership_events.store mut events = ownership_events.store{};
    ownership_api.services mut svc = ownership_api.services{};
    ownership_api.limit_table bounds = ownership_limits.production();
    assert(ownership_events.bind(&events, &bounds, &svc));
    ownership_state.state mut ab = ownership_join.join(&unknown, &failed, &svc,
        &bounds, at, source);
    ownership_state.state mut ba = ownership_join.join(&failed, &unknown, &svc,
        &bounds, at, source);
    assert(ownership_state.equal(&ab, &ba));
    assert(ab.proof.terminal.reason == ownership_api.incomplete_reason.work_limit);
    assert(ab.proof.terminal.limit.present && ab.proof.terminal.limit.used == 4);
    assert(ab.proof.terminal.limit.bound == 4 && ab.proof.terminal.limit.attempted == 1);
    assert(ab.allocations_len == 1 && ab.allocations[0].obligation);
    ownership_state.state mut later = ownership_state.clone(&failed);
    later.proof.terminal.limit.used = 5;
    ownership_state.state mut first = ownership_join.join(&failed, &later, &svc,
        &bounds, at, source);
    ownership_state.state mut second = ownership_join.join(&later, &failed, &svc,
        &bounds, at, source);
    assert(ownership_state.equal(&first, &second));
    assert(first.proof.terminal.limit.used == 4);
    assert(first.allocations[0].obligation);
    ownership_state.free(&second);
    ownership_state.free(&first);
    ownership_state.free(&later);
    ownership_state.free(&ba);
    ownership_state.free(&ab);
    ownership_events.free(&events);
    ownership_state.free(&failed);
    ownership_state.free(&unknown);
}

fn main() i32 {
    combined_teardown();
    missing_services();
    rejected_limits();
    exhausted_work();
    boundary_states();
    println("missing services and limits ok");
    mixed_terminal_evidence();
    println("mixed terminal evidence");
    return 0;
}
