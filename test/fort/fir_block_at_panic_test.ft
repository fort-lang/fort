//! run
//! flags: -I ../../src
//! abort
//! stderr: panic: fir.block_at: index out of range
//! stdout:
//| ready
/// Checks the bound of fir.block_at: a new function has the entry block and no other.
import fort.fir;
import fort.prim;
import fort.types;

fn main() i32 {
    // `tt` lives in an allocation, so that the leak rule proves its end: no call changes the
    // pointer, and drop_made holds each release once.
    types.table mut* own tt = types.table_make();
    defer types.table_drop_made(move(tt));
    types.node* i32t = types.type_prim(tt, prim.prim_kind.prim_i32);
    types.node*[2] params = {i32t, i32t};
    types.node* fnty = types.type_fn(tt, i32t, params[..], false);
    fir.func mut* own f = fir.func_new_made(tt, null, fnty);
    defer fir.func_drop_made(move(f));
    read_blocks(f);
    return 0;
}

// Reads block 0 of `f`, then block 1, which `f` does not have. The reads through `f` stand in a
// function that takes it as a parameter (D17.21).
fn read_blocks(fir.func* f) void {
    assert(fir.block_at(f, 0)->number == 0);
    println("ready");
    fir.block_at(f, 1);
}
