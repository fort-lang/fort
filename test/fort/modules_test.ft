//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| entry ok
//| errors ok
//| module reading ok
//| roots ok
//| std ok
//| symbol reading ok
//| ambiguity ok
//| prefix ok
//| ok
/// Checks search roots, import paths, the standard library root, ambiguity,
/// and missing modules in src/fort/modules.ft.
import diag;
import modules;
import modules_env;
import scope;
import std.str;
import std.strbuf;

//
// modules_closure_test.ft checks closure order, namespaces, and pass order.
//
// The C suite asks the same questions of the bootstrap loader. Its fixed path
// buffer has an extra length test. The fort loader uses a growing std.strbuf.

// ---- the entry file ----------------------------------------

fn the_entry_module_path_is_its_base_name() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft", modules_env.src_main());
    assert(modules_env.load(&e, "main.ft"));
    assert(modules.count(&e.set) == 1);
    assert(modules_env.ordered(&e, 0) == "main");
    assert(modules.entry(&e.set) == modules.at(&e.set, 0));
}

fn an_entry_file_in_a_directory_keeps_only_its_base_name() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "src/app.ft", modules_env.src_main());
    assert(modules_env.load(&e, "src/app.ft"));
    assert(modules_env.ordered(&e, 0) == "app");
}

fn the_entry_directory_is_the_first_search_root() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "src/app.ft",
                    "import util;\nfn main() i32 { return util.add(1, 2); }\n");
    modules_env.add(&e, "src/util.ft", modules_env.src_add());
    assert(modules_env.load(&e, "src/app.ft"));
    assert(modules_env.ordered(&e, 0) == "util");
    assert(modules_env.ordered(&e, 1) == "app");
}

// An entry base name must be a module path segment. Test corpus names such as
// `NNN_name.ft` are not module path segments. An import cannot spell such a name.
fn an_entry_base_name_that_is_no_identifier_is_taken_as_it_is() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "001_leading_zero.ft", modules_env.src_main());
    assert(modules_env.load(&e, "001_leading_zero.ft"));
    assert(modules_env.ordered(&e, 0) == "001_leading_zero");
}

// The entry base name may not contain a `.`, which would spell a module path
// and break the injectivity of the symbol names.
fn a_dotted_entry_base_name_is_rejected() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "my.app.ft", modules_env.src_main());
    assert(!modules_env.load(&e, "my.app.ft"));
    assert(modules_env.said(&e, "entry file name 'my.app' cannot contain '.'"));
}

fn a_dotted_entry_is_reported_at_the_start_of_the_file() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "my.app.ft", modules_env.src_main());
    assert(!modules_env.load(&e, "my.app.ft"));
    assert(modules_env.reports(&e) == 1);
    diag.record rec = modules_env.report_at(&e, 0);
    // An error with no position in the file is reported at 1:1. It is the
    // file's name that is wrong, not anything written inside it.
    assert(rec.loc.line == 1);
    assert(rec.loc.col == 1);
    assert(rec.severity == diag.severity.error);
    assert(str.find(rec.loc.file, "my.app.ft") >= 0);
}

fn a_dotted_entry_file_is_never_read() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "my.app.ft", modules_env.src_main());
    assert(!modules_env.load(&e, "my.app.ft"));
    // The name is rejected before the file is read, so no module exists and
    // nothing can be emitted for one.
    assert(modules.count(&e.set) == 0);
    assert(modules.file_count(&e.set) == 0);
    assert(modules.entry(&e.set) == null);
}

// `my.app.ft` is the module `my.app`, whose `main` is the `my.app.main` the
// module `my/app.ft` already emits.
fn a_dotted_entry_is_rejected_beside_the_module_it_would_collide_with() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "my.app.ft", "import my.app;\nfn main() i32 { return app.main(); }\n");
    modules_env.add(&e, "my/app.ft", modules_env.src_main());
    assert(!modules_env.load(&e, "my.app.ft"));
    assert(modules_env.said(&e, "cannot contain '.'"));
}

// Only `.` is barred, since only `.` separates a module path: the mangler
// copies the path across. So `my:app.ft` emits `my:app.main`, which no module
// path can spell because a segment is an identifier.
fn a_colon_in_the_entry_base_name_is_accepted() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "my:app.ft", modules_env.src_main());
    assert(modules_env.load(&e, "my:app.ft"));
    assert(modules_env.ordered(&e, 0) == "my:app");
}

// A `:` that has no pair remains in the mangled name. Thus, `my:app.main` and
// `myapp.main` name different modules.
fn a_colon_entry_stands_beside_the_module_it_once_collided_with() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "my:app.ft", "import myapp;\nfn main() i32 { return myapp.main(); }\n");
    modules_env.add(&e, "myapp.ft", modules_env.src_main());
    assert(modules_env.load(&e, "my:app.ft"));
    assert(modules.count(&e.set) == 2);
    assert(modules_env.ordered(&e, 0) == "myapp");
    assert(modules_env.ordered(&e, 1) == "my:app");
}

// A doubled colon is not a module path token. The base name remains unchanged,
// and the loader's path map holds it beside no other name.
fn a_doubled_colon_entry_base_name_is_accepted_as_a_name() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "my::app.ft", modules_env.src_main());
    assert(modules_env.load(&e, "my::app.ft"));
    assert(modules_env.ordered(&e, 0) == "my::app");
    assert(!modules_env.said(&e, "circular import"));
}

// The rule is about any position, not an interior one.
fn a_dot_first_or_last_in_the_entry_base_name_is_rejected() void {
    modules_env.env mut first = modules_env.open();
    defer modules_env.close(&first);
    modules_env.add(&first, ".hidden.ft", modules_env.src_main());
    assert(!modules_env.load(&first, ".hidden.ft"));
    assert(modules_env.said(&first, "entry file name '.hidden' cannot contain '.'"));
    modules_env.env mut last = modules_env.open();
    defer modules_env.close(&last);
    modules_env.add(&last, "app..ft", modules_env.src_main());
    assert(!modules_env.load(&last, "app..ft"));
    assert(modules_env.said(&last, "entry file name 'app.' cannot contain '.'"));
}

// `.ft` is shorter than the suffix plus a name. Nothing is stripped and the base name is `.ft`
// itself, which the dot rule then rejects.
fn an_entry_named_exactly_ft_keeps_its_whole_base_name() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, ".ft", modules_env.src_main());
    assert(!modules_env.load(&e, ".ft"));
    assert(modules_env.said(&e, "entry file name '.ft' cannot contain '.'"));
}

// Only `.` is barred. Every other base name is a legal entry, whatever it
// holds.
fn a_hyphenated_entry_base_name_is_accepted() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "my-app.ft", modules_env.src_main());
    assert(modules_env.load(&e, "my-app.ft"));
    assert(modules_env.ordered(&e, 0) == "my-app");
}

// The rule applies to the base name, which becomes the module path. This test
// catches a check over the whole path. Every guest path here is under
// `/vagrant`, so such a check would reject each compiled entry.
fn a_dot_in_a_directory_of_the_entry_path_is_not_the_base_name() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "my.dir/app.ft", modules_env.src_main());
    assert(modules_env.load(&e, "my.dir/app.ft"));
    assert(modules_env.ordered(&e, 0) == "app");
}

// ---- the errors of a file -------------------------------------------------------

fn an_unreadable_entry_file_is_reported() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    assert(!modules_env.load(&e, "missing.ft"));
    assert(modules_env.said(&e, "cannot read"));
}

fn a_lexical_error_stops_the_file() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft", "fn main() i32 {\n    i32 x = 08;\n    return x;\n}\n");
    assert(!modules_env.load(&e, "main.ft"));
    assert(modules_env.errors(&e) == 1);
}

fn a_syntax_error_stops_the_file() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft", "fn main() i32 {\n    i32 x = 1\n    return x;\n}\n");
    assert(!modules_env.load(&e, "main.ft"));
    assert(modules_env.errors(&e) > 0);
}

// `n` declarations of distinct names, each missing the comma between its two
// parameters, which the parser reports once per declaration.
fn append_broken_declarations(strbuf.str_buf mut* out, u64 n) void {
    u64 mut i = 0;
    while (i < n) {
        strbuf.append(out, "fn i32 f");
        strbuf.append_u64(out, i);
        strbuf.append(out, "(i32 a i32 b) { return a; }\n");
        i += 1;
    }
}

// A file's budget is twenty errors, counted across its lexical and its syntax
// errors together: the loader opens the file with begin_file through the
// lexer. And the parser goes on with what the lexer left of it. So a file
// mistyped from end to end costs a reader twenty lines and no more.
fn a_file_reports_at_most_twenty_errors() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    // Thirty declarations whose parameter list is missing a comma, which is
    // one syntax error each.
    strbuf.str_buf mut src = strbuf.create();
    defer strbuf.free(&src);
    append_broken_declarations(&src, 30);
    strbuf.append(&src, "fn main() i32 { return 0; }\n");
    modules_env.add(&e, "main.ft", strbuf.view(&src));
    assert(!modules_env.load(&e, "main.ft"));
    assert(modules_env.errors(&e) == 20);
}

// The budget is the file's and not the run's, so a second file begins with
// its own twenty. The entry file is clean, but
// its imported module has the typo. The imported
// file therefore spends its own diagnostic budget.
fn each_file_has_a_budget_of_its_own() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft", "import util;\nfn main() i32 { return util.add(1, 2); }\n");
    strbuf.str_buf mut src = strbuf.create();
    defer strbuf.free(&src);
    append_broken_declarations(&src, 30);
    strbuf.append(&src, "fn add(i32 a, i32 b) i32 { return a + b; }\n");
    modules_env.add(&e, "util.ft", strbuf.view(&src));
    assert(!modules_env.load(&e, "main.ft"));
    // The entry file reported nothing, so the twenty are the imported file's,
    // counted from its own begin_file rather than from the run's start.
    assert(modules_env.errors(&e) == 20);
    assert(str.find(modules_env.report_at(&e, 0).loc.file, "util.ft") >= 0);
}

fn a_syntax_error_in_an_imported_module_stops_the_compilation() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft", "import util;\nfn main() i32 { return util.add(1, 2); }\n");
    modules_env.add(&e, "util.ft", "fn add(i32 a i32 b) i32 { return a; }\n");
    assert(!modules_env.load(&e, "main.ft"));
    // The diagnostic is the imported file's, at its first line.
    assert(str.find(modules_env.report_at(&e, 0).loc.file, "util.ft") >= 0);
    assert(modules_env.report_at(&e, 0).loc.line == 1);
}

// ---- the module reading ------------------------------------

fn an_import_binds_the_short_name_to_the_module() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft", "import util;\nfn main() i32 { return util.add(1, 2); }\n");
    modules_env.add(&e, "util.ft", modules_env.src_add());
    assert(modules_env.load(&e, "main.ft"));
    scope.binding* b = modules_env.bound(&e, "main", "util");
    assert(b != null);
    assert(b->kind == scope.bind_kind.b_module);
    // The binding denotes the module itself, held as an opaque pointer the
    // loader casts back.
    assert(b->module == cast(modules.find(&e.set, "util"), void*));
}

fn a_nested_path_names_a_file_in_a_directory() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft", "import geom.vec;\nfn main() i32 { return 0; }\n");
    modules_env.add(&e, "geom/vec.ft", "struct vec2 {\n    i64 x;\n    i64 y;\n}\n");
    assert(modules_env.load(&e, "main.ft"));
    assert(modules_env.ordered(&e, 0) == "geom.vec");
    assert(modules_env.bound(&e, "main", "vec") != null);
}

fn as_renames_a_module_binding() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft", "import util as u;\nfn main() i32 { return u.add(1, 2); }\n");
    modules_env.add(&e, "util.ft", modules_env.src_add());
    assert(modules_env.load(&e, "main.ft"));
    assert(modules_env.bound(&e, "main", "u") != null);
    assert(modules_env.bound(&e, "main", "util") == null);
}

fn import_paths_are_root_relative_and_not_file_relative() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft", "import util.a;\nfn main() i32 { return 0; }\n");
    modules_env.add(&e, "util/a.ft", "import util.b;\nfn one() i32 { return b.two(); }\n");
    modules_env.add(&e, "util/b.ft", "fn two() i32 { return 2; }\n");
    assert(modules_env.load(&e, "main.ft"));
    assert(modules_env.ordered(&e, 0) == "util.b");
    assert(modules_env.ordered(&e, 1) == "util.a");
}

fn a_sibling_is_not_reachable_by_its_short_name() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft", "import util.a;\nfn main() i32 { return 0; }\n");
    modules_env.add(&e, "util/a.ft", "import b;\nfn one() i32 { return b.two(); }\n");
    modules_env.add(&e, "util/b.ft", "fn two() i32 { return 2; }\n");
    assert(!modules_env.load(&e, "main.ft"));
    assert(modules_env.said(&e, "module 'b' not found"));
}

// ---- the search roots -----------------------------------------------------------

fn an_include_root_is_searched_after_the_entry_directory() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "src/main.ft", "import util;\nfn main() i32 { return 0; }\n");
    modules_env.add(&e, "lib/util.ft", modules_env.src_add());
    modules_env.root(&e, "lib");
    assert(modules_env.load(&e, "src/main.ft"));
    assert(modules_env.ordered(&e, 0) == "util");
}

fn the_entry_directory_wins_over_an_include_root() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "src/main.ft", "import util;\nfn main() i32 { return 0; }\n");
    modules_env.add(&e, "src/util.ft", modules_env.src_add());
    modules_env.add(&e, "lib/util.ft", "fn add(i32 a, i32 b) i32 { return 0; }\n");
    modules_env.root(&e, "lib");
    assert(modules_env.load(&e, "src/main.ft"));
    modules.module* util = modules.find(&e.set, "util");
    assert(util != null);
    assert(str.find(util->file, "src/util.ft") >= 0);
}

fn include_roots_are_searched_in_command_line_order() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft", "import util;\nfn main() i32 { return 0; }\n");
    modules_env.add(&e, "first/util.ft", modules_env.src_add());
    modules_env.add(&e, "second/util.ft", modules_env.src_add());
    modules_env.root(&e, "first");
    modules_env.root(&e, "second");
    assert(modules_env.load(&e, "main.ft"));
    modules.module* util = modules.find(&e.set, "util");
    assert(util != null);
    assert(str.find(util->file, "first/util.ft") >= 0);
}

// ---- the standard library root --------------------------------------------------

fn a_std_path_is_looked_up_in_the_standard_library_directory() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft", "import std.io;\nfn main() i32 { return 0; }\n");
    modules_env.add(&e, "lib/io.ft", "fn close(i32 fd) i32 { return fd; }\n");
    modules_env.std_dir(&e, "lib");
    assert(modules_env.load(&e, "main.ft"));
    // `std.rt` is a root of every closure, so it is the first module of the
    // dependency order and the imported one follows it.
    assert(modules_env.ordered(&e, 0) == "std.rt");
    assert(modules_env.ordered(&e, 1) == "std.io");
    assert(modules_env.bound(&e, "main", "io") != null);
}

// ---- the runtime root of every closure ------------------------------------------

fn every_closure_holds_the_runtime() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft", modules_env.src_main());
    modules_env.std_dir(&e, "lib");
    assert(modules_env.load(&e, "main.ft"));
    assert(modules.count(&e.set) == 2);
    // The compiler loads it as a root of its own beside the entry file, so it
    // precedes the program in the dependency order.
    assert(modules_env.ordered(&e, 0) == "std.rt");
    assert(modules_env.ordered(&e, 1) == "main");
    // Membership does not bind the name: a module that wants to call it
    // writes `import std.rt;` like any other importer.
    assert(modules_env.bound(&e, "main", "rt") == null);
    assert(modules_env.bound(&e, "main", "std") == null);
}

fn a_standard_library_directory_with_no_runtime_is_an_error() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft", modules_env.src_main());
    modules_env.std_dir_without_runtime(&e, "lib");
    assert(!modules_env.load(&e, "main.ft"));
    assert(modules_env.said(&e, "cannot read"));
    assert(modules_env.said(&e, "rt.ft"));
}

fn a_set_with_no_standard_library_directory_holds_no_runtime() void {
    // Such a set cannot spell `std.rt` at all: `import std.rt;` there is
    // already `module 'std.rt' not found`. The driver always names a
    // directory.
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft", modules_env.src_main());
    assert(modules_env.load(&e, "main.ft"));
    assert(modules.count(&e.set) == 1);
    assert(modules_env.ordered(&e, 0) == "main");
}

fn a_file_of_the_runtimes_closure_is_the_entry_and_not_a_second_module() void {
    // One file is one module, so an entry file the runtime's closure already
    // read is that module and not a second identity of it. Two files of the
    // repository are such an entry, std/rt.ft and std/libc.ft. The module
    // keeps the path that its importer gave it.
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add2(&e, "lib/rt.ft", "import std.helper;\n",
                     "fn one() i32 { return helper.two(); }\n");
    modules_env.add(&e, "lib/helper.ft", "fn two() i32 { return 2; }\n");
    modules_env.std_dir_without_runtime(&e, "lib");
    assert(modules_env.load(&e, "lib/rt.ft"));
    assert(modules.count(&e.set) == 2);
    assert(modules_env.ordered(&e, 0) == "std.helper");
    assert(modules_env.ordered(&e, 1) == "std.rt");
    assert(modules.entry(&e.set) != null);
    assert(modules.entry(&e.set)->path == "std.rt");

    // This case checks a module imported by the runtime. The
    // loader reads std.helper, and that module becomes the entry file.
    modules_env.env mut f = modules_env.open();
    defer modules_env.close(&f);
    modules_env.add2(&f, "lib/rt.ft", "import std.helper;\n",
                     "fn one() i32 { return helper.two(); }\n");
    modules_env.add(&f, "lib/helper.ft", "fn two() i32 { return 2; }\n");
    modules_env.std_dir_without_runtime(&f, "lib");
    assert(modules_env.load(&f, "lib/helper.ft"));
    assert(modules.count(&f.set) == 2);
    assert(modules.entry(&f.set) != null);
    assert(modules.entry(&f.set)->path == "std.helper");
}

fn the_runtime_is_loaded_once_when_the_program_imports_it() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft", "import std.rt;\nfn main() i32 { return 0; }\n");
    modules_env.std_dir(&e, "lib");
    assert(modules_env.load(&e, "main.ft"));
    assert(modules.count(&e.set) == 2);
    assert(modules_env.ordered(&e, 0) == "std.rt");
    // The import binds the name the root alone does not.
    assert(modules_env.bound(&e, "main", "rt") != null);
}

// ---- the float printers ------------------------------------------------------------

// The float printers stand in std.rt, so the loader has one runtime root. A
// closure that holds a float loads the same modules as a float-free closure.
// A file named rt_float.ft in the standard library directory is an ordinary
// module that nothing reaches.
fn a_closure_that_holds_a_float_loads_the_runtime_and_nothing_else() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft", "fn main() i32 {\n    f64 x = 1.5;\n    return 0;\n}\n");
    modules_env.std_dir(&e, "lib");
    assert(modules_env.load(&e, "main.ft"));
    assert(modules.count(&e.set) == 2);
    // the runtime is the root, before the entry file
    assert(modules_env.ordered(&e, 0) == "std.rt");
    assert(modules_env.ordered(&e, 1) == "main");

    // The same closure without the float reads the same two modules, which is
    // what "one runtime module" means.
    modules_env.env mut f = modules_env.open();
    defer modules_env.close(&f);
    modules_env.add(&f, "main.ft", "fn main() i32 {\n    i32 x = 1;\n    return x;\n}\n");
    modules_env.std_dir(&f, "lib");
    assert(modules_env.load(&f, "main.ft"));
    assert(modules.count(&f.set) == 2);
    assert(modules_env.ordered(&f, 0) == "std.rt");
    assert(modules_env.ordered(&f, 1) == "main");
}

// A file called rt_float.ft in the standard library directory is a module like
// any other: no rule of the loader names it. So a closure that holds a float
// leaves it unread and an `import std.rt_float;` reaches it.
fn a_float_module_in_the_library_directory_is_an_ordinary_module() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft", "fn main() i32 {\n    f64 x = 1.5;\n    return 0;\n}\n");
    modules_env.add(&e, "lib/rt_float.ft", "fn unused() i32 { return 0; }\n");
    modules_env.std_dir(&e, "lib");
    assert(modules_env.load(&e, "main.ft"));
    assert(modules.find(&e.set, "std.rt_float") == null);

    modules_env.env mut f = modules_env.open();
    defer modules_env.close(&f);
    modules_env.add(&f, "main.ft", "import std.rt_float;\nfn main() i32 { return 0; }\n");
    modules_env.add(&f, "lib/rt_float.ft", "fn unused() i32 { return 0; }\n");
    modules_env.std_dir(&f, "lib");
    assert(modules_env.load(&f, "main.ft"));
    assert(modules.find(&f.set, "std.rt_float") != null);
}

fn a_std_path_is_not_looked_up_under_any_other_root() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft", "import std.io;\nfn main() i32 { return 0; }\n");
    modules_env.add(&e, "std/io.ft", "fn close(i32 fd) i32 { return fd; }\n");
    assert(!modules_env.load(&e, "main.ft"));
    assert(modules_env.said(&e, "module 'std.io' not found"));
}

fn a_path_that_does_not_begin_with_std_never_reaches_the_library() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft", "import io;\nfn main() i32 { return 0; }\n");
    modules_env.add(&e, "lib/io.ft", "fn close(i32 fd) i32 { return fd; }\n");
    modules_env.std_dir(&e, "lib");
    assert(!modules_env.load(&e, "main.ft"));
    assert(modules_env.said(&e, "module 'io' not found"));
}

fn std_alone_is_a_directory_and_not_a_module() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft", "import std;\nfn main() i32 { return 0; }\n");
    modules_env.add(&e, "lib/io.ft", "fn close(i32 fd) i32 { return fd; }\n");
    modules_env.std_dir(&e, "lib");
    assert(!modules_env.load(&e, "main.ft"));
    assert(modules_env.said(&e, "module 'std' not found"));
}

// ---- the symbol reading ------------------------------------

fn a_trailing_declaration_is_bound_to_that_declaration() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft", "import util.add;\nfn main() i32 { return add(1, 2); }\n");
    modules_env.add(&e, "util.ft", modules_env.src_add());
    assert(modules_env.load(&e, "main.ft"));
    scope.binding* b = modules_env.bound(&e, "main", "add");
    assert(b != null);
    assert(b->kind == scope.bind_kind.b_symbol);
    assert(b->to == modules_env.bound(&e, "util", "add"));
}

fn as_renames_an_imported_declaration() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft",
                    "import util.add as plus;\nfn main() i32 { return plus(1, 2); }\n");
    modules_env.add(&e, "util.ft", modules_env.src_add());
    assert(modules_env.load(&e, "main.ft"));
    assert(modules_env.bound(&e, "main", "plus") != null);
    assert(modules_env.bound(&e, "main", "add") == null);
}

fn braces_are_sugar_for_independent_symbol_imports() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add2(&e, "main.ft", "import util.{add, mul as times};\n",
                     "fn main() i32 { return add(1, times(2, 3)); }\n");
    modules_env.add2(&e, "util.ft", "fn add(i32 a, i32 b) i32 { return a + b; }\n",
                     "fn mul(i32 a, i32 b) i32 { return a * b; }\n");
    assert(modules_env.load(&e, "main.ft"));
    assert(modules_env.bound(&e, "main", "add") != null);
    assert(modules_env.bound(&e, "main", "times") != null);
    assert(modules_env.bound(&e, "main", "mul") == null);
}

fn a_braced_import_whose_prefix_is_no_module_file_is_an_error() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft", "import std.{io, str};\nfn main() i32 { return 0; }\n");
    modules_env.add(&e, "lib/io.ft", "fn close(i32 fd) i32 { return fd; }\n");
    modules_env.std_dir(&e, "lib");
    assert(!modules_env.load(&e, "main.ft"));
    assert(modules_env.said(&e, "module 'std' not found"));
}

fn a_declaration_the_module_lacks_is_an_error() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft", "import util.strngs;\nfn main() i32 { return 0; }\n");
    modules_env.add(&e, "util.ft", modules_env.src_add());
    assert(!modules_env.load(&e, "main.ft"));
    assert(modules_env.said(&e, "module 'util' has no declaration named 'strngs'"));
}

fn an_import_binding_of_another_module_is_not_importable() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft", "import util.other;\nfn main() i32 { return 0; }\n");
    modules_env.add(&e, "util.ft", "import other;\nfn add(i32 a) i32 { return other.one(); }\n");
    modules_env.add(&e, "other.ft", "fn one() i32 { return 1; }\n");
    assert(!modules_env.load(&e, "main.ft"));
    assert(modules_env.said(&e, "cannot import 'other': it is an import of module 'util'"));
}

fn a_one_segment_path_has_only_the_module_reading() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft", "import add;\nfn main() i32 { return 0; }\n");
    modules_env.add(&e, "util.ft", modules_env.src_add());
    assert(!modules_env.load(&e, "main.ft"));
    assert(modules_env.said(&e, "module 'add' not found"));
}

fn a_missing_module_lists_the_paths_it_looked_for() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft", "import util.strings;\nfn main() i32 { return 0; }\n");
    modules_env.root(&e, "lib");
    assert(!modules_env.load(&e, "main.ft"));
    assert(modules_env.said(&e, "module 'util.strings' not found"));
    assert(modules_env.said(&e, "looked for"));
    assert(modules_env.said(&e, "util/strings.ft"));
    assert(modules_env.said(&e, "util.ft"));
    // One note per root and reading: two roots for `util.strings` and two for
    // the prefix `util`.
    assert(modules_env.reports(&e) == 5);
    assert(modules_env.report_at(&e, 1).severity == diag.severity.note);
}

// ---- ambiguity ---------------------------------------------

fn both_readings_succeeding_is_ambiguous() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft", "import a.b.c;\nfn main() i32 { return 0; }\n");
    modules_env.add(&e, "a/b.ft", "fn c(i32 x) i32 { return x; }\n");
    modules_env.add(&e, "a/b/c.ft", "fn f() i32 { return 0; }\n");
    assert(!modules_env.load(&e, "main.ft"));
    assert(modules_env.said(&e, "ambiguous import 'a.b.c'"));
    assert(modules_env.said(&e, "a/b/c.ft"));
    assert(modules_env.said(&e, "a/b.ft"));
}

fn ambiguity_holds_whichever_roots_the_two_files_live_under() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "src/main.ft", "import a.b.c;\nfn main() i32 { return 0; }\n");
    modules_env.add(&e, "src/a/b.ft", "fn c(i32 x) i32 { return x; }\n");
    modules_env.add(&e, "lib/a/b/c.ft", "fn f() i32 { return 0; }\n");
    modules_env.root(&e, "lib");
    assert(!modules_env.load(&e, "src/main.ft"));
    assert(modules_env.said(&e, "ambiguous import 'a.b.c'"));
}

fn a_prefix_that_lacks_the_name_leaves_the_module_reading() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft", "import a.b.c;\nfn main() i32 { return 0; }\n");
    modules_env.add(&e, "a/b.ft", "fn other() i32 { return 0; }\n");
    modules_env.add(&e, "a/b/c.ft", "fn f() i32 { return 0; }\n");
    assert(modules_env.load(&e, "main.ft"));
    scope.binding* b = modules_env.bound(&e, "main", "c");
    assert(b != null);
    assert(b->kind == scope.bind_kind.b_module);
}

fn a_missing_module_file_leaves_the_symbol_reading() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft", "import a.b.c;\nfn main() i32 { return 0; }\n");
    modules_env.add(&e, "a/b.ft", "fn c(i32 x) i32 { return x; }\n");
    assert(modules_env.load(&e, "main.ft"));
    scope.binding* b = modules_env.bound(&e, "main", "c");
    assert(b != null);
    assert(b->kind == scope.bind_kind.b_symbol);
}

// ---- the prefix of an import is read only when it is the module (10) ------------

fn a_prefix_that_lacks_the_name_is_not_read_into_the_closure() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft", "import util.helper;\nfn main() i32 { return 0; }\n");
    modules_env.add(&e, "util/helper.ft", "fn help() i32 { return 0; }\n");
    modules_env.add(&e, "util.ft", "fn unrelated() i32 { return 0; }\n");
    assert(modules_env.load(&e, "main.ft"));
    // The module reading won, so `util.ft` is a module no import reaches and
    // is never read into the closure.
    assert(modules.count(&e.set) == 2);
    assert(modules.find(&e.set, "util") == null);
    assert(modules_env.ordered(&e, 0) == "util.helper");
}

fn a_syntax_error_in_a_prefix_the_module_reading_beats_is_not_reported() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft", "import util.helper;\nfn main() i32 { return 0; }\n");
    modules_env.add(&e, "util/helper.ft", "fn help() i32 { return 0; }\n");
    modules_env.add(&e, "util.ft", "fn broken(i32 a i32 b) i32 { return a; }\n");
    assert(modules_env.load(&e, "main.ft"));
    // The probe is muted, so the prefix's own errors reach nothing: neither
    // the count nor the records.
    assert(modules_env.reports(&e) == 0);
    assert(modules_env.errors(&e) == 0);
}

fn an_import_of_the_entry_from_such_a_prefix_is_not_a_cycle() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft", "import util.helper;\nfn main() i32 { return 0; }\n");
    modules_env.add(&e, "util/helper.ft", "fn help() i32 { return 0; }\n");
    modules_env.add(&e, "util.ft", "import main;\nfn unrelated() i32 { return 0; }\n");
    assert(modules_env.load(&e, "main.ft"));
    assert(!modules_env.said(&e, "circular"));
}

fn an_extern_of_such_a_prefix_conflicts_with_nothing() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add3(&e, "main.ft", "import util.helper;\n",
                     "extern fn write(i32 fd, void* buf, u64 n) i64;\n",
                     "fn main() i32 { return 0; }\n");
    modules_env.add(&e, "util/helper.ft", "fn help() i32 { return 0; }\n");
    modules_env.add(&e, "util.ft", "extern fn write(i32 fd, void* buf, u64 n) i32;\n");
    assert(modules_env.load(&e, "main.ft"));
    assert(modules_env.reports(&e) == 0);
}

// `util` is in the closure, so the symbol reading is answered from its
// namespace, and both readings succeeding is ambiguous.
fn a_prefix_the_closure_already_holds_answers_from_its_namespace() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft",
                    "import util;\nimport util.add;\nfn main() i32 { return 0; }\n");
    modules_env.add(&e, "util.ft", modules_env.src_add());
    modules_env.add(&e, "util/add.ft", "fn f() i32 { return 0; }\n");
    assert(!modules_env.load(&e, "main.ft"));
    assert(modules_env.said(&e, "ambiguous import 'util.add'"));
}

// All the errors of the module that has them are reported, then processing
// stops at the module boundary.
fn every_failing_import_of_one_module_is_reported() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft",
                    "import nothere;\nimport alsomissing;\nfn main() i32 { return 0; }\n");
    assert(!modules_env.load(&e, "main.ft"));
    assert(modules_env.said(&e, "module 'nothere' not found"));
    assert(modules_env.said(&e, "module 'alsomissing' not found"));
    assert(modules_env.errors(&e) == 2);
}

fn no_further_module_is_read_after_an_import_failed() void {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft",
                    "import nothere;\nimport util;\nfn main() i32 { return 0; }\n");
    modules_env.add(&e, "util.ft", "fn broken(i32 a i32 b) i32 { return a; }\n");
    assert(!modules_env.load(&e, "main.ft"));
    // The second import would have read a module with its own syntax error;
    // one module's errors appear together, so it is left alone.
    assert(modules_env.errors(&e) == 1);
    assert(modules_env.said(&e, "module 'nothere' not found"));
}

fn main() i32 {
    the_entry_module_path_is_its_base_name();
    an_entry_file_in_a_directory_keeps_only_its_base_name();
    the_entry_directory_is_the_first_search_root();
    an_entry_base_name_that_is_no_identifier_is_taken_as_it_is();
    a_dotted_entry_base_name_is_rejected();
    a_dotted_entry_is_reported_at_the_start_of_the_file();
    a_dotted_entry_file_is_never_read();
    a_dotted_entry_is_rejected_beside_the_module_it_would_collide_with();
    a_colon_in_the_entry_base_name_is_accepted();
    a_colon_entry_stands_beside_the_module_it_once_collided_with();
    a_doubled_colon_entry_base_name_is_accepted_as_a_name();
    a_dot_first_or_last_in_the_entry_base_name_is_rejected();
    an_entry_named_exactly_ft_keeps_its_whole_base_name();
    a_hyphenated_entry_base_name_is_accepted();
    a_dot_in_a_directory_of_the_entry_path_is_not_the_base_name();
    println("entry ok");
    an_unreadable_entry_file_is_reported();
    a_lexical_error_stops_the_file();
    a_syntax_error_stops_the_file();
    a_syntax_error_in_an_imported_module_stops_the_compilation();
    a_file_reports_at_most_twenty_errors();
    each_file_has_a_budget_of_its_own();
    println("errors ok");
    an_import_binds_the_short_name_to_the_module();
    a_nested_path_names_a_file_in_a_directory();
    as_renames_a_module_binding();
    import_paths_are_root_relative_and_not_file_relative();
    a_sibling_is_not_reachable_by_its_short_name();
    println("module reading ok");
    an_include_root_is_searched_after_the_entry_directory();
    the_entry_directory_wins_over_an_include_root();
    include_roots_are_searched_in_command_line_order();
    println("roots ok");
    a_std_path_is_looked_up_in_the_standard_library_directory();
    every_closure_holds_the_runtime();
    a_standard_library_directory_with_no_runtime_is_an_error();
    a_set_with_no_standard_library_directory_holds_no_runtime();
    a_file_of_the_runtimes_closure_is_the_entry_and_not_a_second_module();
    the_runtime_is_loaded_once_when_the_program_imports_it();
    a_std_path_is_not_looked_up_under_any_other_root();
    a_path_that_does_not_begin_with_std_never_reaches_the_library();
    std_alone_is_a_directory_and_not_a_module();
    a_closure_that_holds_a_float_loads_the_runtime_and_nothing_else();
    a_float_module_in_the_library_directory_is_an_ordinary_module();
    println("std ok");
    a_trailing_declaration_is_bound_to_that_declaration();
    as_renames_an_imported_declaration();
    braces_are_sugar_for_independent_symbol_imports();
    a_braced_import_whose_prefix_is_no_module_file_is_an_error();
    a_declaration_the_module_lacks_is_an_error();
    an_import_binding_of_another_module_is_not_importable();
    a_one_segment_path_has_only_the_module_reading();
    a_missing_module_lists_the_paths_it_looked_for();
    println("symbol reading ok");
    both_readings_succeeding_is_ambiguous();
    ambiguity_holds_whichever_roots_the_two_files_live_under();
    a_prefix_that_lacks_the_name_leaves_the_module_reading();
    a_missing_module_file_leaves_the_symbol_reading();
    println("ambiguity ok");
    a_prefix_that_lacks_the_name_is_not_read_into_the_closure();
    a_syntax_error_in_a_prefix_the_module_reading_beats_is_not_reported();
    an_import_of_the_entry_from_such_a_prefix_is_not_a_cycle();
    an_extern_of_such_a_prefix_conflicts_with_nothing();
    a_prefix_the_closure_already_holds_answers_from_its_namespace();
    every_failing_import_of_one_module_is_reported();
    no_further_module_is_read_after_an_import_failed();
    println("prefix ok");
    println("ok");
    return 0;
}
