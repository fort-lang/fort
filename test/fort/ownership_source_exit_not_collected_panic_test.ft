//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: ownership_source_exit: closure is not collected
//! stdout:
//| false
/// prepare reads the owning globals of its closure, so the closure is collected first. A
/// closure that collect never ran on breaks that order, and prepare panics before it binds.
import ownership_api;
import ownership_source_exit;

fn main() i32 {
    ownership_source_exit.closure mut x = ownership_source_exit.closure{};
    ownership_source_exit.context mut c = ownership_source_exit.context{};
    println(x.collected);
    ownership_source_exit.prepare(&c, &x, null, ownership_api.function_id{}, 0, "",
        ownership_api.source_position{}, "main");
    return 0;
}
