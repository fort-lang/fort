//! run
//! flags: -I ../../src
//! abort
//! stderr: panic: fir_lower.constant_of: a folded value with no scalar constant
//! stdout:
//| true
/// constant_of makes the constant of a folded scalar. A folded string is an aggregate, which
/// the lowering reads through string_constant, so the call panics.
import fort.consts;
import fort.fir;
import fort.fir_lower;
import fort.prim;
import fort.types;

fn main() i32 {
    // `tt` lives in an allocation, so that the leak rule proves its end: no call changes the
    // pointer, and drop_made holds each release once.
    types.table mut* own tt = types.table_make();
    defer types.table_drop_made(move(tt));
    types.node* i32t = types.type_prim(tt, prim.prim_kind.prim_i32);
    fir.constant c = fir_lower.constant_of(i32t, consts.cv_from_i64(1));
    println(c.kind == fir.const_kind.ck_int);
    fir_lower.constant_of(i32t, consts.cv_from_str("x"));
    return 0;
}
