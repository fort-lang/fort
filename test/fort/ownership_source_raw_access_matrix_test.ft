fn access_inexact() void {
    ownership_raw_source_env.closure mut c = ownership_raw_source_env.closure{};
    string[100] lines = {
        "struct holder { u64* p; }",
        "extern fn shared_bytes() u8*;",
        "fn make(u64* x) u64* { return x; }",
        "fn m_inexact(u8 n) u64 {",
        "    u64[32] big = {};",
        "    u64* mut p = null;",
        "    u8* b = cast(&big, u8*);",
        "    u8@ v = b[0..cast(n, u64)];",
        "    p = cast(v.ptr, u64*);",
