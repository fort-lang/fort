fn access_foreign() void {
    ownership_raw_source_env.closure mut c = ownership_raw_source_env.closure{};
    string[67] lines = {
        "struct holder { u64* p; }",
        "extern fn shared_bytes() u8*;",
        "fn make(u64* x) u64* { return x; }",
        "fn m_foreign() u64 {",
        "    u64* mut p = null;",
        "    p = cast(shared_bytes(), u64*);",
        "    return *p;",
        "}",
        "fn m_foreign_recon(bool c, u64 bits) u64 {",
        "    u64* mut p = null;",
        "    if (c) {",
        "        p = cast(shared_bytes(), u64*);",
        "    } else {",
        "        p = cast(bits, u64*);",
        "    }",
