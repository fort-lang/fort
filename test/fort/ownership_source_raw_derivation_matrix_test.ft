//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| derivation pass ok
//| derivation window ok
//| derivation align ok
//| derivation inexact ok
//| derivation foreign ok
//| derivation recon ok
//| derivation none ok
//| derivation caller ok
//| derivation stored ok
//| derivation call ok
//| derivation unknown ok
/// Holds the raw verdict of a field address through each value class, alone and
/// joined with each other class on a second path (D17.17, D17.18).
///
/// The classes: `pass` is a window that holds the operation; `window` is a constant
/// window that it exceeds; `align` is a window whose start no aligned base repairs;
/// `inexact` is a window whose symbolic end can be too short; `foreign` is an extern
/// result (D17.13); `recon` is an integer cast (D17.17); `none` is null, which the local
/// analysis owns. `caller`, `stored`, `call` and `unknown` are gaps: other analyses own
/// their facts, so the body leaves the declared raw scope with the first of them.
/// A failure is a violation only when each value fails exactly; any other failure is
/// incomplete proof at the operation.
/// A derivation checks the window, not the alignment, so `align` holds it. Null has
/// no window, so a derivation through it fails (memory model 2.8.1).
import ownership_raw_source_env;
import ownership_source_raw;

fn derivation_pass() void {
    ownership_raw_source_env.closure mut c = ownership_raw_source_env.closure{};
    string[122] lines = {
        "struct pair { i32 a; i64 b; }",
        "struct holder { pair* p; }",
        "extern fn shared_bytes() u8*;",
        "fn make(pair* x) pair* { return x; }",
        "fn m_pass() u64 {",
        "    pair whole = pair{1, 2};",
        "    pair* mut p = null;",
        "    p = &whole;",
        "    return cast(&p->b, u64);",
        "}",
        "fn m_pass_window(bool c) u64 {",
        "    pair whole = pair{1, 2};",
        "    u8 tag = 1;",
        "    pair* mut p = null;",
        "    if (c) {",
        "        p = &whole;",
        "    } else {",
        "        p = cast(&tag, pair*);",
        "    }",
        "    return cast(&p->b, u64);",
        "}",
        "fn m_pass_align(bool c) u64 {",
        "    pair whole = pair{1, 2};",
        "    u64[4] words = {1, 2, 3, 4};",
        "    pair* mut p = null;",
        "    if (c) {",
        "        p = &whole;",
        "    } else {",
        "        u8* b = cast(&words, u8*);",
        "        u8@ v = b[4..20];",
        "        p = cast(v.ptr, pair*);",
        "    }",
        "    return cast(&p->b, u64);",
        "}",
        "fn m_pass_inexact(bool c, u8 n) u64 {",
        "    pair whole = pair{1, 2};",
        "    u64[32] big = {};",
        "    pair* mut p = null;",
        "    if (c) {",
        "        p = &whole;",
        "    } else {",
        "        u8* b = cast(&big, u8*);",
        "        u8@ v = b[0..cast(n, u64)];",
        "        p = cast(v.ptr, pair*);",
        "    }",
        "    return cast(&p->b, u64);",
        "}",
        "fn m_pass_foreign(bool c) u64 {",
        "    pair whole = pair{1, 2};",
        "    pair* mut p = null;",
        "    if (c) {",
        "        p = &whole;",
        "    } else {",
        "        p = cast(shared_bytes(), pair*);",
        "    }",
        "    return cast(&p->b, u64);",
        "}",
        "fn m_pass_recon(bool c, u64 bits) u64 {",
        "    pair whole = pair{1, 2};",
        "    pair* mut p = null;",
        "    if (c) {",
        "        p = &whole;",
        "    } else {",
        "        p = cast(bits, pair*);",
        "    }",
        "    return cast(&p->b, u64);",
        "}",
        "fn m_pass_none(bool c) u64 {",
        "    pair whole = pair{1, 2};",
        "    pair* mut p = null;",
        "    if (c) {",
        "        p = &whole;",
        "    } else {",
        "        p = null;",
        "    }",
        "    return cast(&p->b, u64);",
        "}",
        "fn m_pass_caller(bool c, pair* q) u64 {",
        "    pair whole = pair{1, 2};",
        "    pair* mut p = null;",
        "    if (c) {",
        "        p = &whole;",
        "    } else {",
        "        p = q;",
        "    }",
        "    return cast(&p->b, u64);",
        "}",
        "fn m_pass_stored(bool c) u64 {",
        "    pair whole = pair{1, 2};",
        "    u64 word = 1;",
        "    holder h = holder{cast(&word, pair*)};",
        "    pair* mut p = null;",
        "    if (c) {",
        "        p = &whole;",
        "    } else {",
        "        p = h.p;",
        "    }",
        "    return cast(&p->b, u64);",
        "}",
        "fn m_pass_call(bool c) u64 {",
        "    pair whole = pair{1, 2};",
        "    u64 word = 1;",
        "    pair* mut p = null;",
        "    if (c) {",
        "        p = &whole;",
        "    } else {",
        "        p = make(cast(&word, pair*));",
        "    }",
        "    return cast(&p->b, u64);",
        "}",
        "fn m_pass_unknown(bool c, u64 k) u64 {",
        "    pair whole = pair{1, 2};",
        "    u64[4] words = {1, 2, 3, 4};",
        "    pair* mut p = null;",
        "    if (c) {",
        "        p = &whole;",
        "    } else {",
        "        u64@ s = words[k..4];",
        "        p = cast(s.ptr, pair*);",
        "    }",
        "    return cast(&p->b, u64);",
        "}",
    };
    ownership_raw_source_env.open(&c, lines[..]);
    defer ownership_raw_source_env.close(&c);
    ownership_raw_source_env.proved(&c, "m_pass");
    ownership_raw_source_env.unproved_at(&c, "m_pass_window", 20);
    ownership_raw_source_env.proved(&c, "m_pass_align");
    ownership_raw_source_env.unproved_at(&c, "m_pass_inexact", 46);
    ownership_raw_source_env.proved(&c, "m_pass_foreign");
    ownership_raw_source_env.unproved_at(&c, "m_pass_recon", 66);
    ownership_raw_source_env.unproved_at(&c, "m_pass_none", 76);
    ownership_raw_source_env.outside(&c, "m_pass_caller",
        ownership_source_raw.missing.caller_origin);
    ownership_raw_source_env.outside(&c, "m_pass_stored",
        ownership_source_raw.missing.stored_origin);
    ownership_raw_source_env.outside(&c, "m_pass_call",
        ownership_source_raw.missing.call_origin);
    ownership_raw_source_env.outside(&c, "m_pass_unknown",
        ownership_source_raw.missing.unknown_origin);
    ownership_raw_source_env.report(&c, "derivation pass");
}

