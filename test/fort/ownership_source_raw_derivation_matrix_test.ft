fn derivation_inexact() void {
    ownership_raw_source_env.closure mut c = ownership_raw_source_env.closure{};
    string[101] lines = {
        "struct pair { i32 a; i64 b; }",
        "struct holder { pair* p; }",
        "extern fn shared_bytes() u8*;",
        "fn make(pair* x) pair* { return x; }",
        "fn m_inexact(u8 n) u64 {",
        "    u64[32] big = {};",
        "    pair* mut p = null;",
        "    u8* b = cast(&big, u8*);",
        "    u8@ v = b[0..cast(n, u64)];",
        "    p = cast(v.ptr, pair*);",
        "    return cast(&p->b, u64);",
        "}",
        "fn m_inexact_foreign(bool c, u8 n) u64 {",
        "    u64[32] big = {};",
        "    pair* mut p = null;",
        "    if (c) {",
        "        u8* b = cast(&big, u8*);",
        "        u8@ v = b[0..cast(n, u64)];",
        "        p = cast(v.ptr, pair*);",
        "    } else {",
        "        p = cast(shared_bytes(), pair*);",
        "    }",
        "    return cast(&p->b, u64);",
        "}",
        "fn m_inexact_recon(bool c, u8 n, u64 bits) u64 {",
        "    u64[32] big = {};",
        "    pair* mut p = null;",
        "    if (c) {",
        "        u8* b = cast(&big, u8*);",
        "        u8@ v = b[0..cast(n, u64)];",
        "        p = cast(v.ptr, pair*);",
        "    } else {",
        "        p = cast(bits, pair*);",
        "    }",
        "    return cast(&p->b, u64);",
        "}",
        "fn m_inexact_none(bool c, u8 n) u64 {",
        "    u64[32] big = {};",
        "    pair* mut p = null;",
        "    if (c) {",
        "        u8* b = cast(&big, u8*);",
        "        u8@ v = b[0..cast(n, u64)];",
        "        p = cast(v.ptr, pair*);",
        "    } else {",
        "        p = null;",
        "    }",
        "    return cast(&p->b, u64);",
        "}",
        "fn m_inexact_caller(bool c, u8 n, pair* q) u64 {",
        "    u64[32] big = {};",
        "    pair* mut p = null;",
        "    if (c) {",
        "        u8* b = cast(&big, u8*);",
        "        u8@ v = b[0..cast(n, u64)];",
        "        p = cast(v.ptr, pair*);",
        "    } else {",
        "        p = q;",
        "    }",
        "    return cast(&p->b, u64);",
        "}",
        "fn m_inexact_stored(bool c, u8 n) u64 {",
        "    u64[32] big = {};",
        "    u64 word = 1;",
        "    holder h = holder{cast(&word, pair*)};",
        "    pair* mut p = null;",
        "    if (c) {",
        "        u8* b = cast(&big, u8*);",
        "        u8@ v = b[0..cast(n, u64)];",
        "        p = cast(v.ptr, pair*);",
        "    } else {",
        "        p = h.p;",
        "    }",
        "    return cast(&p->b, u64);",
        "}",
        "fn m_inexact_call(bool c, u8 n) u64 {",
        "    u64[32] big = {};",
        "    u64 word = 1;",
        "    pair* mut p = null;",
        "    if (c) {",
        "        u8* b = cast(&big, u8*);",
        "        u8@ v = b[0..cast(n, u64)];",
        "        p = cast(v.ptr, pair*);",
        "    } else {",
        "        p = make(cast(&word, pair*));",
        "    }",
        "    return cast(&p->b, u64);",
        "}",
        "fn m_inexact_unknown(bool c, u8 n, u64 k) u64 {",
        "    u64[32] big = {};",
        "    u64[4] words = {1, 2, 3, 4};",
        "    pair* mut p = null;",
        "    if (c) {",
        "        u8* b = cast(&big, u8*);",
        "        u8@ v = b[0..cast(n, u64)];",
        "        p = cast(v.ptr, pair*);",
        "    } else {",
        "        u64@ s = words[k..4];",
        "        p = cast(s.ptr, pair*);",
        "    }",
        "    return cast(&p->b, u64);",
        "}",
    };
    ownership_raw_source_env.open(&c, lines[..]);
    defer ownership_raw_source_env.close(&c);
    ownership_raw_source_env.unproved_at(&c, "m_inexact", 11);
    ownership_raw_source_env.unproved_at(&c, "m_inexact_foreign", 23);
    ownership_raw_source_env.unproved_at(&c, "m_inexact_recon", 35);
    ownership_raw_source_env.unproved_at(&c, "m_inexact_none", 47);
    ownership_raw_source_env.outside(&c, "m_inexact_caller",
        ownership_source_raw.missing.caller_origin);
    ownership_raw_source_env.outside(&c, "m_inexact_stored",
        ownership_source_raw.missing.stored_origin);
    ownership_raw_source_env.outside(&c, "m_inexact_call",
        ownership_source_raw.missing.call_origin);
