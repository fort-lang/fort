//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| overflow ok
//| float ok
//| division ok
//| bitwise ok
//| shift ok
//| constants ok
/// Checks the lowering of scalar arithmetic with its runtime checks (spec/fir.md 9.4): one source
/// for each operator family. The condition of each `check` is true on failure: the overflow flag
/// for `overflow`, `eq` against zero for `div_zero`, `and(eq, eq)` for `div_overflow`, and `ge`
/// against the width for `shift`.
import lower_env;
import std.str;

// ---- the overflow check -----------------------------------------------------------------------

// `+`, `-` and `*` on a signed integer: `_f = add_overflows(a, b)`, `check(copy _f, overflow)`,
// then `add(a, b)` in the next block.
fn signed_arithmetic_checks_for_overflow() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[5] source = {
        "fn f(i32 x, i32 y) i32 {",
        "    i32 a = x + y;",
        "    i32 b = x - y;",
        "    return x * y;",
        "}",
    };
    string[37] want = {
        "fn main.f(_1 (x): i32, _2 (y): i32) -> i32 {",
        "    let _0: i32;",
        "    let _3 (a): i32 #2:9;",
        "    let _4 (b): i32 #3:9;",
        "    let _5: bool #2:15;",
        "    let _6: i32 #2:15;",
        "    let _7: bool #3:15;",
        "    let _8: i32 #3:15;",
        "    let _9: bool #4:14;",
        "    let _10: i32 #4:14;",
        "",
        "    bb0: {",
        "        live(_3) #2:9 s1;",
        "        _5 = add_overflows(copy _1, copy _2) #2:15 s1;",
        "        check(copy _5, overflow) -> bb1 #2:15 s1;",
        "    }",
        "    bb1: {",
        "        _6 = add(copy _1, copy _2) #2:15 s1;",
        "        _3 = copy _6 #2:15 s1;",
        "        live(_4) #3:9 s2;",
        "        _7 = sub_overflows(copy _1, copy _2) #3:15 s2;",
        "        check(copy _7, overflow) -> bb2 #3:15 s2;",
        "    }",
        "    bb2: {",
        "        _8 = sub(copy _1, copy _2) #3:15 s2;",
        "        _4 = copy _8 #3:15 s2;",
        "        _9 = mul_overflows(copy _1, copy _2) #4:14 s3;",
        "        check(copy _9, overflow) -> bb3 #4:14 s3;",
        "    }",
        "    bb3: {",
        "        _10 = mul(copy _1, copy _2) #4:14 s3;",
        "        _0 = copy _10 #4:14 s3;",
        "        dead(_3) #4:5 s3;",
        "        dead(_4) #4:5 s3;",
        "        return #4:5 s3;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "f"), want[..]);
}

// An unsigned operation checks as a signed one does. The result of an inner operation is a
// temporary, which the outer operation reads in both of its statements.
fn a_nested_operation_reads_its_temporary() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[3] source = {
        "fn g(u64 x) u64 {",
        "    return (x + 1) * 2;",
        "}",
    };
    string[22] want = {
        "fn main.g(_1 (x): u64) -> u64 {",
        "    let _0: u64;",
        "    let _2: bool #2:15;",
        "    let _3: u64 #2:15;",
        "    let _4: bool #2:20;",
        "    let _5: u64 #2:20;",
        "",
        "    bb0: {",
        "        _2 = add_overflows(copy _1, const u64 1) #2:15 s1;",
        "        check(copy _2, overflow) -> bb1 #2:15 s1;",
        "    }",
        "    bb1: {",
        "        _3 = add(copy _1, const u64 1) #2:15 s1;",
        "        _4 = mul_overflows(copy _3, const u64 2) #2:20 s1;",
        "        check(copy _4, overflow) -> bb2 #2:20 s1;",
        "    }",
        "    bb2: {",
        "        _5 = mul(copy _3, const u64 2) #2:20 s1;",
        "        _0 = copy _5 #2:20 s1;",
        "        return #2:5 s1;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "g"), want[..]);
}

// The operands of an operator lower left to right (D6.3), so the statements and the checks of
// the left operand come first, and the temporaries take their numbers in that order.
fn the_left_operand_lowers_first() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[3] source = {
        "fn o(i32 x, i32 y) i32 {",
        "    return (x + y) * (x - y);",
        "}",
    };
    string[29] want = {
        "fn main.o(_1 (x): i32, _2 (y): i32) -> i32 {",
        "    let _0: i32;",
        "    let _3: bool #2:15;",
        "    let _4: i32 #2:15;",
        "    let _5: bool #2:25;",
        "    let _6: i32 #2:25;",
        "    let _7: bool #2:20;",
        "    let _8: i32 #2:20;",
        "",
        "    bb0: {",
        "        _3 = add_overflows(copy _1, copy _2) #2:15 s1;",
        "        check(copy _3, overflow) -> bb1 #2:15 s1;",
        "    }",
        "    bb1: {",
        "        _4 = add(copy _1, copy _2) #2:15 s1;",
        "        _5 = sub_overflows(copy _1, copy _2) #2:25 s1;",
        "        check(copy _5, overflow) -> bb2 #2:25 s1;",
        "    }",
        "    bb2: {",
        "        _6 = sub(copy _1, copy _2) #2:25 s1;",
        "        _7 = mul_overflows(copy _4, copy _6) #2:20 s1;",
        "        check(copy _7, overflow) -> bb3 #2:20 s1;",
        "    }",
        "    bb3: {",
        "        _8 = mul(copy _4, copy _6) #2:20 s1;",
        "        _0 = copy _8 #2:20 s1;",
        "        return #2:5 s1;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "o"), want[..]);
}

// `+%`, `-%` and `*%` wrap: `add`, `sub` and `mul` with no check (D11.1).
fn the_wrapping_operators_skip_the_check() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[5] source = {
        "fn w(u8 x, u8 y) u8 {",
        "    u8 a = x +% y;",
        "    u8 b = x -% y;",
        "    return x *% y;",
        "}",
    };
    string[22] want = {
        "fn main.w(_1 (x): u8, _2 (y): u8) -> u8 {",
        "    let _0: u8;",
        "    let _3 (a): u8 #2:8;",
        "    let _4 (b): u8 #3:8;",
        "    let _5: u8 #2:14;",
        "    let _6: u8 #3:14;",
        "    let _7: u8 #4:14;",
        "",
        "    bb0: {",
        "        live(_3) #2:8 s1;",
        "        _5 = add(copy _1, copy _2) #2:14 s1;",
        "        _3 = copy _5 #2:14 s1;",
        "        live(_4) #3:8 s2;",
        "        _6 = sub(copy _1, copy _2) #3:14 s2;",
        "        _4 = copy _6 #3:14 s2;",
        "        _7 = mul(copy _1, copy _2) #4:14 s3;",
        "        _0 = copy _7 #4:14 s3;",
        "        dead(_3) #4:5 s3;",
        "        dead(_4) #4:5 s3;",
        "        return #4:5 s3;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "w"), want[..]);
}

// Unary `-` on an integer is `sub(const 0, x)` with the overflow check, which fails for the
// smallest value of a signed type.
fn integer_negation_subtracts_from_zero() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[4] source = {
        "fn m(i32 x, i64 y) i64 {",
        "    i32 a = -x;",
        "    return -y;",
        "}",
    };
    string[26] want = {
        "fn main.m(_1 (x): i32, _2 (y): i64) -> i64 {",
        "    let _0: i64;",
        "    let _3 (a): i32 #2:9;",
        "    let _4: bool #2:13;",
        "    let _5: i32 #2:13;",
        "    let _6: bool #3:12;",
        "    let _7: i64 #3:12;",
        "",
        "    bb0: {",
        "        live(_3) #2:9 s1;",
        "        _4 = sub_overflows(const i32 0, copy _1) #2:13 s1;",
        "        check(copy _4, overflow) -> bb1 #2:13 s1;",
        "    }",
        "    bb1: {",
        "        _5 = sub(const i32 0, copy _1) #2:13 s1;",
        "        _3 = copy _5 #2:13 s1;",
        "        _6 = sub_overflows(const i64 0, copy _2) #3:12 s2;",
        "        check(copy _6, overflow) -> bb2 #3:12 s2;",
        "    }",
        "    bb2: {",
        "        _7 = sub(const i64 0, copy _2) #3:12 s2;",
        "        _0 = copy _7 #3:12 s2;",
        "        dead(_3) #3:5 s2;",
        "        return #3:5 s2;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "m"), want[..]);
}

// ---- floats -----------------------------------------------------------------------------------

// Float arithmetic is `fadd`, `fsub`, `fmul`, `fdiv` and `fneg` with no check: a float operation
// does not trap (spec/fir.md 6).
fn float_arithmetic_has_no_check() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[7] source = {
        "fn fl(f64 x, f64 y) f64 {",
        "    f64 a = x + y;",
        "    f64 b = x - y;",
        "    f64 c = x * y;",
        "    f64 d = x / y;",
        "    return -d;",
        "}",
    };
    string[34] want = {
        "fn main.fl(_1 (x): f64, _2 (y): f64) -> f64 {",
        "    let _0: f64;",
        "    let _3 (a): f64 #2:9;",
        "    let _4 (b): f64 #3:9;",
        "    let _5 (c): f64 #4:9;",
        "    let _6 (d): f64 #5:9;",
        "    let _7: f64 #2:15;",
        "    let _8: f64 #3:15;",
        "    let _9: f64 #4:15;",
        "    let _10: f64 #5:15;",
        "    let _11: f64 #6:12;",
        "",
        "    bb0: {",
        "        live(_3) #2:9 s1;",
        "        _7 = fadd(copy _1, copy _2) #2:15 s1;",
        "        _3 = copy _7 #2:15 s1;",
        "        live(_4) #3:9 s2;",
        "        _8 = fsub(copy _1, copy _2) #3:15 s2;",
        "        _4 = copy _8 #3:15 s2;",
        "        live(_5) #4:9 s3;",
        "        _9 = fmul(copy _1, copy _2) #4:15 s3;",
        "        _5 = copy _9 #4:15 s3;",
        "        live(_6) #5:9 s4;",
        "        _10 = fdiv(copy _1, copy _2) #5:15 s4;",
        "        _6 = copy _10 #5:15 s4;",
        "        _11 = fneg(copy _6) #6:12 s5;",
        "        _0 = copy _11 #6:12 s5;",
        "        dead(_3) #6:5 s5;",
        "        dead(_4) #6:5 s5;",
        "        dead(_5) #6:5 s5;",
        "        dead(_6) #6:5 s5;",
        "        return #6:5 s5;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "fl"), want[..]);
}

// `%` on a float never reaches the lowering: the checker refuses it (D6.12).
fn the_checker_refuses_a_float_remainder() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[3] source = {
        "fn r(f64 x, f64 y) f64 {",
        "    return x % y;",
        "}",
    };
    string got = lower_env.diagnostic(&e, source[..]);
    if (!str.starts_with(got, "2:14: ")) {
        eprintln("fir_lower_arith_test: got <", got, ">");
        panic("fir_lower_arith_test: the checker does not refuse the float remainder at `%`");
    }
}

// ---- division ---------------------------------------------------------------------------------

// `/` and `%` on a signed integer: the zero test, then the test of MIN / -1, then `div` or `rem`
// (D6.13). Both checks stay in every build mode.
fn signed_division_checks_zero_and_overflow() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[4] source = {
        "fn d(i32 x, i32 y) i32 {",
        "    i32 q = x / y;",
        "    return x % y;",
        "}",
    };
    string[44] want = {
        "fn main.d(_1 (x): i32, _2 (y): i32) -> i32 {",
        "    let _0: i32;",
        "    let _3 (q): i32 #2:9;",
        "    let _4: bool #2:15;",
        "    let _5: bool #2:15;",
        "    let _6: bool #2:15;",
        "    let _7: bool #2:15;",
        "    let _8: i32 #2:15;",
        "    let _9: bool #3:14;",
        "    let _10: bool #3:14;",
        "    let _11: bool #3:14;",
        "    let _12: bool #3:14;",
        "    let _13: i32 #3:14;",
        "",
        "    bb0: {",
        "        live(_3) #2:9 s1;",
        "        _4 = eq(copy _2, const i32 0) #2:15 s1;",
        "        check(copy _4, div_zero) -> bb1 #2:15 s1;",
        "    }",
        "    bb1: {",
        "        _5 = eq(copy _2, const i32 -1) #2:15 s1;",
        "        _6 = eq(copy _1, const i32 -2147483648) #2:15 s1;",
        "        _7 = and(copy _5, copy _6) #2:15 s1;",
        "        check(copy _7, div_overflow) -> bb2 #2:15 s1;",
        "    }",
        "    bb2: {",
        "        _8 = div(copy _1, copy _2) #2:15 s1;",
        "        _3 = copy _8 #2:15 s1;",
        "        _9 = eq(copy _2, const i32 0) #3:14 s2;",
        "        check(copy _9, div_zero) -> bb3 #3:14 s2;",
        "    }",
        "    bb3: {",
        "        _10 = eq(copy _2, const i32 -1) #3:14 s2;",
        "        _11 = eq(copy _1, const i32 -2147483648) #3:14 s2;",
        "        _12 = and(copy _10, copy _11) #3:14 s2;",
        "        check(copy _12, div_overflow) -> bb4 #3:14 s2;",
        "    }",
        "    bb4: {",
        "        _13 = rem(copy _1, copy _2) #3:14 s2;",
        "        _0 = copy _13 #3:14 s2;",
        "        dead(_3) #3:5 s2;",
        "        return #3:5 s2;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "d"), want[..]);
}

u64 WIDTHS_LINES = 9;

// The smallest value of the narrowest and of the widest signed type, and an unsigned division,
// which cannot overflow and has the zero test alone.
string[WIDTHS_LINES] WIDTHS = {
    "fn e1(i8 x, i8 y) i8 {",
    "    return x / y;",
    "}",
    "fn e2(i64 a, i64 b) i64 {",
    "    return a % b;",
    "}",
    "fn e3(u32 m, u32 n) u32 {",
    "    return m / n;",
    "}",
};

fn division_uses_the_bounds_of_its_type() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[24] narrow = {
        "fn main.e1(_1 (x): i8, _2 (y): i8) -> i8 {",
        "    let _0: i8;",
        "    let _3: bool #2:14;",
        "    let _4: bool #2:14;",
        "    let _5: bool #2:14;",
        "    let _6: bool #2:14;",
        "    let _7: i8 #2:14;",
        "",
        "    bb0: {",
        "        _3 = eq(copy _2, const i8 0) #2:14 s1;",
        "        check(copy _3, div_zero) -> bb1 #2:14 s1;",
        "    }",
        "    bb1: {",
        "        _4 = eq(copy _2, const i8 -1) #2:14 s1;",
        "        _5 = eq(copy _1, const i8 -128) #2:14 s1;",
        "        _6 = and(copy _4, copy _5) #2:14 s1;",
        "        check(copy _6, div_overflow) -> bb2 #2:14 s1;",
        "    }",
        "    bb2: {",
        "        _7 = div(copy _1, copy _2) #2:14 s1;",
        "        _0 = copy _7 #2:14 s1;",
        "        return #2:5 s1;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, WIDTHS[..], "e1"), narrow[..]);
    string[24] wide = {
        "fn main.e2(_1 (a): i64, _2 (b): i64) -> i64 {",
        "    let _0: i64;",
        "    let _3: bool #5:14;",
        "    let _4: bool #5:14;",
        "    let _5: bool #5:14;",
        "    let _6: bool #5:14;",
        "    let _7: i64 #5:14;",
        "",
        "    bb0: {",
        "        _3 = eq(copy _2, const i64 0) #5:14 s1;",
        "        check(copy _3, div_zero) -> bb1 #5:14 s1;",
        "    }",
        "    bb1: {",
        "        _4 = eq(copy _2, const i64 -1) #5:14 s1;",
        "        _5 = eq(copy _1, const i64 -9223372036854775808) #5:14 s1;",
        "        _6 = and(copy _4, copy _5) #5:14 s1;",
        "        check(copy _6, div_overflow) -> bb2 #5:14 s1;",
        "    }",
        "    bb2: {",
        "        _7 = rem(copy _1, copy _2) #5:14 s1;",
        "        _0 = copy _7 #5:14 s1;",
        "        return #5:5 s1;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, WIDTHS[..], "e2"), wide[..]);
    string[15] unsigned = {
        "fn main.e3(_1 (m): u32, _2 (n): u32) -> u32 {",
        "    let _0: u32;",
        "    let _3: bool #8:14;",
        "    let _4: u32 #8:14;",
        "",
        "    bb0: {",
        "        _3 = eq(copy _2, const u32 0) #8:14 s1;",
        "        check(copy _3, div_zero) -> bb1 #8:14 s1;",
        "    }",
        "    bb1: {",
        "        _4 = div(copy _1, copy _2) #8:14 s1;",
        "        _0 = copy _4 #8:14 s1;",
        "        return #8:5 s1;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, WIDTHS[..], "e3"), unsigned[..]);
}

// ---- bitwise operators and shifts -------------------------------------------------------------

// `&`, `|` and `^` are `and`, `or` and `xor`; `!` on a `bool` and `~` on an integer are `not`.
// None of them has a check.
fn bitwise_operators_have_no_check() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[7] source = {
        "fn b(u32 x, u32 y, bool p) u32 {",
        "    u32 a = x & y;",
        "    u32 o = x | y;",
        "    u32 z = x ^ y;",
        "    bool q = !p;",
        "    return ~a;",
        "}",
    };
    string[34] want = {
        "fn main.b(_1 (x): u32, _2 (y): u32, _3 (p): bool) -> u32 {",
        "    let _0: u32;",
        "    let _4 (a): u32 #2:9;",
        "    let _5 (o): u32 #3:9;",
        "    let _6 (z): u32 #4:9;",
        "    let _7 (q): bool #5:10;",
        "    let _8: u32 #2:15;",
        "    let _9: u32 #3:15;",
        "    let _10: u32 #4:15;",
        "    let _11: bool #5:14;",
        "    let _12: u32 #6:12;",
        "",
        "    bb0: {",
        "        live(_4) #2:9 s1;",
        "        _8 = and(copy _1, copy _2) #2:15 s1;",
        "        _4 = copy _8 #2:15 s1;",
        "        live(_5) #3:9 s2;",
        "        _9 = or(copy _1, copy _2) #3:15 s2;",
        "        _5 = copy _9 #3:15 s2;",
        "        live(_6) #4:9 s3;",
        "        _10 = xor(copy _1, copy _2) #4:15 s3;",
        "        _6 = copy _10 #4:15 s3;",
        "        live(_7) #5:10 s4;",
        "        _11 = not(copy _3) #5:14 s4;",
        "        _7 = copy _11 #5:14 s4;",
        "        _12 = not(copy _4) #6:12 s5;",
        "        _0 = copy _12 #6:12 s5;",
        "        dead(_4) #6:5 s5;",
        "        dead(_5) #6:5 s5;",
        "        dead(_6) #6:5 s5;",
        "        dead(_7) #6:5 s5;",
        "        return #6:5 s5;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "b"), want[..]);
}

// `<<` and `>>`: the count widened to `i64` by its own signedness, the test of the count against
// the width of the shifted type, the check that reports the count and the type, then the count
// narrowed to the shifted type (spec/fir.md 9.4, toolchain.md 6 item 15).
fn a_shift_checks_its_count_against_the_width() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[4] source = {
        "fn s(u8 v, i32 n, u8 m) u8 {",
        "    u8 a = v << n;",
        "    return a >> m;",
        "}",
    };
    string[38] want = {
        "fn main.s(_1 (v): u8, _2 (n): i32, _3 (m): u8) -> u8 {",
        "    let _0: u8;",
        "    let _4 (a): u8 #2:8;",
        "    let _5: i64 #2:14;",
        "    let _6: u64 #2:14;",
        "    let _7: bool #2:14;",
        "    let _8: u8 #2:14;",
        "    let _9: u8 #2:14;",
        "    let _10: i64 #3:14;",
        "    let _11: u64 #3:14;",
        "    let _12: bool #3:14;",
        "    let _13: u8 #3:14;",
        "    let _14: u8 #3:14;",
        "",
        "    bb0: {",
        "        live(_4) #2:8 s1;",
        "        _5 = cast<i64>(copy _2) #2:14 s1;",
        "        _6 = cast<u64>(copy _5) #2:14 s1;",
        "        _7 = ge(copy _6, const u64 8) #2:14 s1;",
        "        check(copy _7, shift, copy _5, const bytes \"u8\") -> bb1 #2:14 s1;",
        "    }",
        "    bb1: {",
        "        _8 = cast<u8>(copy _5) #2:14 s1;",
        "        _9 = shl(copy _1, copy _8) #2:14 s1;",
        "        _4 = copy _9 #2:14 s1;",
        "        _10 = cast<i64>(copy _3) #3:14 s2;",
        "        _11 = cast<u64>(copy _10) #3:14 s2;",
        "        _12 = ge(copy _11, const u64 8) #3:14 s2;",
        "        check(copy _12, shift, copy _10, const bytes \"u8\") -> bb2 #3:14 s2;",
        "    }",
        "    bb2: {",
        "        _13 = cast<u8>(copy _10) #3:14 s2;",
        "        _14 = shr(copy _4, copy _13) #3:14 s2;",
        "        _0 = copy _14 #3:14 s2;",
        "        dead(_4) #3:5 s2;",
        "        return #3:5 s2;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "s"), want[..]);
}

// The widest type, 64 bits, shifted by a `u64` count, which `cast<i64>` reinterprets and
// `cast<u64>` gives back for the test, and by a constant count, which the lowering checks too.
fn a_wide_shift_and_a_constant_count() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[4] source = {
        "fn t(i64 w, u64 k) i64 {",
        "    i64 c = w << 3;",
        "    return c >> k;",
        "}",
    };
    string[38] want = {
        "fn main.t(_1 (w): i64, _2 (k): u64) -> i64 {",
        "    let _0: i64;",
        "    let _3 (c): i64 #2:9;",
        "    let _4: i64 #2:15;",
        "    let _5: u64 #2:15;",
        "    let _6: bool #2:15;",
        "    let _7: i64 #2:15;",
        "    let _8: i64 #2:15;",
        "    let _9: i64 #3:14;",
        "    let _10: u64 #3:14;",
        "    let _11: bool #3:14;",
        "    let _12: i64 #3:14;",
        "    let _13: i64 #3:14;",
        "",
        "    bb0: {",
        "        live(_3) #2:9 s1;",
        "        _4 = cast<i64>(const i32 3) #2:15 s1;",
        "        _5 = cast<u64>(copy _4) #2:15 s1;",
        "        _6 = ge(copy _5, const u64 64) #2:15 s1;",
        "        check(copy _6, shift, copy _4, const bytes \"i64\") -> bb1 #2:15 s1;",
        "    }",
        "    bb1: {",
        "        _7 = cast<i64>(copy _4) #2:15 s1;",
        "        _8 = shl(copy _1, copy _7) #2:15 s1;",
        "        _3 = copy _8 #2:15 s1;",
        "        _9 = cast<i64>(copy _2) #3:14 s2;",
        "        _10 = cast<u64>(copy _9) #3:14 s2;",
        "        _11 = ge(copy _10, const u64 64) #3:14 s2;",
        "        check(copy _11, shift, copy _9, const bytes \"i64\") -> bb2 #3:14 s2;",
        "    }",
        "    bb2: {",
        "        _12 = cast<i64>(copy _9) #3:14 s2;",
        "        _13 = shr(copy _3, copy _12) #3:14 s2;",
        "        _0 = copy _13 #3:14 s2;",
        "        dead(_3) #3:5 s2;",
        "        return #3:5 s2;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "t"), want[..]);
}

// ---- constants --------------------------------------------------------------------------------

// The checker folds a constant expression, and the lowering writes its value: no statement
// computes it and no check guards it.
fn a_folded_expression_is_a_constant() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[5] source = {
        "fn k() i32 {",
        "    f32 h = 0.5;",
        "    i64 n = -5;",
        "    return 2 + 3 * 4;",
        "}",
    };
    string[16] want = {
        "fn main.k() -> i32 {",
        "    let _0: i32;",
        "    let _1 (h): f32 #2:9;",
        "    let _2 (n): i64 #3:9;",
        "",
        "    bb0: {",
        "        live(_1) #2:9 s1;",
        "        _1 = const f32 0x3FE0000000000000 #2:13 s1;",
        "        live(_2) #3:9 s2;",
        "        _2 = const i64 -5 #3:13 s2;",
        "        _0 = const i32 14 #4:14 s3;",
        "        dead(_1) #4:5 s3;",
        "        dead(_2) #4:5 s3;",
        "        return #4:5 s3;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "k"), want[..]);
}

// ---- the bounds of the integer types ----------------------------------------------------------

// The overflow check at each width: the flag is a `bool` and the result has the type of the
// operands, from `i8` to `u32`.
fn every_width_checks_for_overflow() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[6] source = {
        "fn widths(i8 a, i16 b, u16 c, u32 d) u32 {",
        "    i8 w = a * a;",
        "    i16 x = b - b;",
        "    u16 y = c + c;",
        "    return d * d;",
        "}",
    };
    string[48] want = {
        "fn main.widths(_1 (a): i8, _2 (b): i16, _3 (c): u16, _4 (d): u32) -> u32 {",
        "    let _0: u32;",
        "    let _5 (w): i8 #2:8;",
        "    let _6 (x): i16 #3:9;",
        "    let _7 (y): u16 #4:9;",
        "    let _8: bool #2:14;",
        "    let _9: i8 #2:14;",
        "    let _10: bool #3:15;",
        "    let _11: i16 #3:15;",
        "    let _12: bool #4:15;",
        "    let _13: u16 #4:15;",
        "    let _14: bool #5:14;",
        "    let _15: u32 #5:14;",
        "",
        "    bb0: {",
        "        live(_5) #2:8 s1;",
        "        _8 = mul_overflows(copy _1, copy _1) #2:14 s1;",
        "        check(copy _8, overflow) -> bb1 #2:14 s1;",
        "    }",
        "    bb1: {",
        "        _9 = mul(copy _1, copy _1) #2:14 s1;",
        "        _5 = copy _9 #2:14 s1;",
        "        live(_6) #3:9 s2;",
        "        _10 = sub_overflows(copy _2, copy _2) #3:15 s2;",
        "        check(copy _10, overflow) -> bb2 #3:15 s2;",
        "    }",
        "    bb2: {",
        "        _11 = sub(copy _2, copy _2) #3:15 s2;",
        "        _6 = copy _11 #3:15 s2;",
        "        live(_7) #4:9 s3;",
        "        _12 = add_overflows(copy _3, copy _3) #4:15 s3;",
        "        check(copy _12, overflow) -> bb3 #4:15 s3;",
        "    }",
        "    bb3: {",
        "        _13 = add(copy _3, copy _3) #4:15 s3;",
        "        _7 = copy _13 #4:15 s3;",
        "        _14 = mul_overflows(copy _4, copy _4) #5:14 s4;",
        "        check(copy _14, overflow) -> bb4 #5:14 s4;",
        "    }",
        "    bb4: {",
        "        _15 = mul(copy _4, copy _4) #5:14 s4;",
        "        _0 = copy _15 #5:14 s4;",
        "        dead(_5) #5:5 s4;",
        "        dead(_6) #5:5 s4;",
        "        dead(_7) #5:5 s4;",
        "        return #5:5 s4;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "widths"), want[..]);
}

// The folded constants at the ends of the integer ranges: the smallest `i64` and `i8`, and the
// largest `u8` and `u64`, which a constant holds exactly (spec/fir.md 5.6).
fn the_bounds_of_the_integer_types_are_constants() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[6] source = {
        "fn lim() u64 {",
        "    i64 low = -9223372036854775808;",
        "    i8 small = -128;",
        "    u8 top = 255;",
        "    return 18446744073709551615;",
        "}",
    };
    string[20] want = {
        "fn main.lim() -> u64 {",
        "    let _0: u64;",
        "    let _1 (low): i64 #2:9;",
        "    let _2 (small): i8 #3:8;",
        "    let _3 (top): u8 #4:8;",
        "",
        "    bb0: {",
        "        live(_1) #2:9 s1;",
        "        _1 = const i64 -9223372036854775808 #2:15 s1;",
        "        live(_2) #3:8 s2;",
        "        _2 = const i8 -128 #3:16 s2;",
        "        live(_3) #4:8 s3;",
        "        _3 = const u8 255 #4:14 s3;",
        "        _0 = const u64 18446744073709551615 #5:12 s4;",
        "        dead(_1) #5:5 s4;",
        "        dead(_2) #5:5 s4;",
        "        dead(_3) #5:5 s4;",
        "        return #5:5 s4;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "lim"), want[..]);
}

fn main() i32 {
    signed_arithmetic_checks_for_overflow();
    a_nested_operation_reads_its_temporary();
    the_left_operand_lowers_first();
    the_wrapping_operators_skip_the_check();
    integer_negation_subtracts_from_zero();
    println("overflow ok");
    float_arithmetic_has_no_check();
    the_checker_refuses_a_float_remainder();
    println("float ok");
    signed_division_checks_zero_and_overflow();
    division_uses_the_bounds_of_its_type();
    println("division ok");
    bitwise_operators_have_no_check();
    println("bitwise ok");
    a_shift_checks_its_count_against_the_width();
    a_wide_shift_and_a_constant_count();
    println("shift ok");
    a_folded_expression_is_a_constant();
    every_width_checks_for_overflow();
    the_bounds_of_the_integer_types_are_constants();
    println("constants ok");
    return 0;
}
