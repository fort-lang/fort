//! run
//! flags: -I ../../src
//! abort
//! stderr: panic: fir.local_mut: index out of range
//! stdout:
//| 3
/// Checks the bound of fir.local_mut. A number at or past the count of locals breaks the
/// precondition and panics at the call site.
import fort.ast;
import fort.fir;
import fort.prim;
import fort.types;

fn main() i32 {
    types.table mut tt = types.table{};
    defer types.type_table_free(&tt);
    types.node* i32t = types.type_prim(&tt, prim.prim_kind.prim_i32);
    types.node*[2] params = {i32t, i32t};
    types.node* fnty = types.type_fn(&tt, i32t, params[..], false);
    ast.sym mut s = ast.sym{};
    s.kind = ast.sym_kind.s_fn;
    s.ty = fnty;
    fir.func mut f = fir.func_new(&tt, &s, fnty);
    defer fir.func_free(&f);
    change_locals(&f);
    return 0;
}

// Prints the count of the locals of `f`, then takes local 3, which `f` does not have. The reads
// through `f` stand in a function that takes it as a parameter (D17.21).
fn change_locals(fir.func mut* f) void {
    println(fir.local_count(f));
    println(fir.local_mut(f, 3)->number);
}
