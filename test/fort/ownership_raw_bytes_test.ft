fn b13_transferred_owner_zero_fill() void {
    ownership_raw_bytes_env.env mut e = {};
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes_env.owner_setup(&e, 24, false);
    ownership_raw_bytes.result mut moved = ownership_raw_bytes_env.try_move(&e, 1, 2, 8, 2215);
    ownership_raw_bytes_env.take(&e, &moved);
    ownership_raw_bytes_env.zero(&e, 1, 0, 8, 2217);
    assert(ownership_transfer.owner_count(e.paired.states[0].core,
        ownership_raw_bytes_env.place(&e, 1)) == 0);
    assert(ownership_transfer.owner_count(e.paired.states[0].core,
        ownership_raw_bytes_env.place(&e, 2)) == 1);
    assert(e.paired.states[0].core->allocations[0].history.len == 2);
    println("required B13.transferred_owner_zero_fill accept");
}
fn aggregate_move_verdict(bool inline_view) void {
    ownership_raw_bytes_env.env mut e = {};
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes_env.aggregate_setup(&e, inline_view ? 44 : 25, inline_view, false);
