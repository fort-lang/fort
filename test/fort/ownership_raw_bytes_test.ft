fn b11_later_repair_cannot_fix_loss() void {
    ownership_raw_bytes_env.env mut e = {};
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes_env.owner_setup(&e, 21, false);
    ownership_raw_bytes.result mut before = ownership_raw_bytes_env.clone_input(&e);
    defer ownership_raw_bytes.free_result(&before);
    ownership_raw_bytes.byte_effect[2] mut effects = {};
    effects[0] = ownership_raw_bytes_env.effect(&e, ownership_raw_bytes.effect_kind.unknown,
        ownership_raw_bytes_env.window(&e, 1, 3, 4, e.byte));
    effects[1] = ownership_raw_bytes_env.effect(&e, ownership_raw_bytes.effect_kind.replacement,
        ownership_raw_bytes_env.window(&e, 1, 0, 8, e.selected_type));
    effects[1].value = e.first;
    effects[1].checked_value = true;
    ownership_raw.request mut req = {};
    ownership_raw_bytes_env.transaction(&e, effects[..], &req, 2175);
    ownership_raw_bytes_env.reset_budget(&e);
    ownership_raw_bytes.result mut out = ownership_raw_bytes.apply_ordered(&e.paired.states[0],
        &e.service, effects[..], &req);
    defer ownership_raw_bytes.free_result(&out);
    assert(!ownership_api.successful(out.proof) && out.proof.failed && out.states.len == 0);
    assert(ownership_keys.operation(e.budget.last_event.operation, effects[0].operation) == 0);
    assert(ownership_keys.source(e.budget.last_event.source, effects[0].source_position) == 0);
    ownership_raw_bytes_env.same(&e, &before.states[0]);
    println("required B11.later_repair_cannot_fix_loss reject");
}
