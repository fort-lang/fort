        ownership_raw_bytes_env.window(&e, 1, 0, 8, e.pointer), &req);
    defer ownership_raw_bytes.free_reference(&out);
    assert(!ownership_api.successful(out.proof));
    assert(out.proof.terminal.reason == ownership_api.incomplete_reason.work_limit);
    assert(e.budget.events > events && e.budget.denied.used > 0);
    assert(ownership_keys.operation(out.proof.terminal.operation, req.base.operation) == 0);
    assert(ownership_keys.source(out.proof.terminal.source, req.base.source_position) == 0);
    ownership_raw_bytes_env.same(&e, &before.states[0]);
    println("unit-storage reference_consumer_work_refusal");
}

fn paired_comparison_work_refusal() void {
    ownership_raw_bytes_env.env mut e = {};
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes_env.setup(&e, 203, 0, false);
    ownership_raw_bytes_env.initial(&e, 0, 1238);
    ownership_raw_bytes.result mut before = ownership_raw_bytes_env.clone_input(&e);
    defer ownership_raw_bytes.free_result(&before);
    ownership_raw.request req = ownership_raw_bytes_env.request(&e, 1241);
    ownership_raw_bytes_env.reset_budget(&e);
    e.budget.deny_at = 5;
    ownership_api.proof_status mut proof = {};
    bool equal = ownership_raw_bytes.equal(&before.states[0], &e.paired.states[0],
        &e.service, &req, &proof);
    assert(!equal && proof.terminal.reason == ownership_api.incomplete_reason.work_limit);
    assert(e.budget.denied.used > 0 && e.budget.denied.attempted > 0);
    ownership_raw_bytes_env.same(&e, &before.states[0]);
    println("unit-storage paired_comparison_work_refusal");
}

fn repeated_reference_consumers_charge_work() void {
    ownership_raw_bytes_env.env mut e = {};
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes_env.setup(&e, 204, 0, false);
    ownership_raw_bytes_env.initial(&e, 0, 1257);
    ownership_raw.request req = ownership_raw_bytes_env.request(&e, 1258);
    ownership_raw_bytes_env.reset_budget(&e);
    ownership_raw_bytes.reference_result mut first = ownership_raw_bytes.read_reference(
        &e.paired.states[0], &e.service,
        ownership_raw_bytes_env.window(&e, 1, 0, 8, e.pointer), &req);
    defer ownership_raw_bytes.free_reference(&first);
    assert(ownership_api.successful(first.proof));
    u64 used = e.budget.meter.used.w;
    u64 calls = e.budget.calls;
    ownership_raw_bytes.reference_result mut second = ownership_raw_bytes.read_reference(
        &e.paired.states[0], &e.service,
        ownership_raw_bytes_env.window(&e, 1, 0, 8, e.pointer), &req);
    defer ownership_raw_bytes.free_reference(&second);
    assert(ownership_api.successful(second.proof));
    assert(e.budget.meter.used.w > used && e.budget.calls > calls);
    assert(first.value.borrows.ptr != second.value.borrows.ptr);
    println("unit-storage repeated_reference_consumers_charge_work");
}

fn repeated_comparisons_charge_work() void {
    ownership_raw_bytes_env.env mut e = {};
