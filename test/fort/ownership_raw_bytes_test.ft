fn b19_unproved_owner_overlap() void {
    ownership_raw_bytes_env.env mut e = {};
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes_env.setup(&e, 34, 0, true);
    ownership_raw_bytes_env.initial(&e, 0, 478);
    ownership_raw_bytes.result mut before = ownership_raw_bytes_env.clone_input(&e);
    defer ownership_raw_bytes.free_result(&before);
    ownership_raw_bytes.byte_effect mut change = ownership_raw_bytes_env.effect(&e,
        ownership_raw_bytes.effect_kind.unknown,
        ownership_raw_bytes_env.window(&e, 1, 3, 4, e.byte));
    change.aliases_substituted = false;
    ownership_raw_bytes.result mut refused = ownership_raw_bytes_env.try_effect(&e, change, 485);
    defer ownership_raw_bytes.free_result(&refused);
    assert(!ownership_api.successful(refused.proof) && refused.states.len == 0);
    ownership_raw_bytes_env.same(&e, &before.states[0]);
    change.aliases_substituted = true;
    ownership_raw_bytes.free_result(&refused);
    refused = ownership_raw_bytes_env.try_effect(&e, change, 491);
    assert(!ownership_api.successful(refused.proof) && refused.states.len == 0);
    ownership_raw_bytes_env.same(&e, &before.states[0]);
    println("required B19.unproved_owner_overlap reject");
}

