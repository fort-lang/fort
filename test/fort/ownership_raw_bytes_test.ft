    ownership_raw_bytes_env.initial(&e, 0, 1326);
    ownership_raw_bytes.result mut before = ownership_raw_bytes_env.clone_input(&e);
    defer ownership_raw_bytes.free_result(&before);
    assert(!types.type_cast_adds_own(e.selected_type, e.selected_type));
    ownership_raw_bytes.reference_result mut out =
        ownership_raw_bytes_env.reference(&e, 1, 0, 8, e.selected_type, 1327);
    defer ownership_raw_bytes.free_reference(&out);
    ownership_raw_bytes_env.accepts(&out, &e, 1, 1, 0, 12);
    ownership_raw_bytes_env.same(&e, &before.states[0]);
    println("unit-storage interpretation_preserves_existing_owner");
}

fn retained_fragment_limit_keeps_input_and_event() void {
    ownership_raw_bytes_env.env mut e = {};
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes_env.setup(&e, 210, 0, false);
    ownership_raw_bytes_env.initial(&e, 0, 1330);
    ownership_raw_bytes.result mut before = ownership_raw_bytes_env.clone_input(&e);
    defer ownership_raw_bytes.free_result(&before);
    // Four borrowed identities, two allocations, seven raw leaves, and two byte partitions.
    assert(e.paired.states[0].raw.leaves_len == 7);
    assert(e.paired.states[0].bytes.representations[0].fragments_len == 1);
    assert(e.paired.states[0].bytes.representations[1].fragments_len == 0);
    assert(e.paired.states[0].bytes.representations[2].fragments_len == 1);
    e.limits.r = 15;
    ownership_raw.request req = ownership_raw_bytes_env.request(&e, 1333);
    ownership_raw_bytes.byte_effect[1] mut effects = {ownership_raw_bytes_env.effect(&e,
        ownership_raw_bytes.effect_kind.unknown,
        ownership_raw_bytes_env.window(&e, 1, 3, 4, e.byte))};
    effects[0].operation = req.base.operation;
    effects[0].source_position = req.base.source_position;
    ownership_raw_bytes_env.reset_budget(&e);
    ownership_raw_bytes.result mut out = ownership_raw_bytes.apply_ordered(&e.paired.states[0],
        &e.service, effects[..], &req);
    defer ownership_raw_bytes.free_result(&out);
    assert(!ownership_api.successful(out.proof) && out.states.len == 0);
    assert(out.proof.terminal.reason == ownership_api.incomplete_reason.work_limit);
    assert(out.proof.terminal.limit.category == ownership_api.limit_category.r);
    assert(out.proof.terminal.limit.used == e.limits.r);
    assert(out.proof.terminal.limit.bound == e.limits.r);
    assert(out.proof.terminal.limit.attempted == 16);
    assert(e.budget.last_event.kind == ownership_api.event_kind.work_failure);
    assert(e.budget.last_event.limit.category == ownership_api.limit_category.r);
    assert(e.budget.last_event.limit.used == e.limits.r);
    assert(e.budget.last_event.limit.attempted == 16);
    assert(e.budget.meter.used.r == e.limits.r && e.budget.meter.used.w > 0);
    ownership_raw_bytes_env.same(&e, &before.states[0]);
    println("unit-storage retained_fragment_limit_keeps_input_and_event");
}

