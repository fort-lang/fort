fn b06_rebuild_wrong_byte_positions() void {
    ownership_raw_bytes_env.env mut e = {};
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes_env.setup(&e, 15, 0, false);
    ownership_raw_bytes_env.initial(&e, 0, 330);
    ownership_raw_bytes_env.read(&e, 1, 0, 4, 1, 331);
    ownership_raw_bytes_env.read(&e, 1, 4, 8, 2, 332);
    ownership_raw_bytes_env.write(&e, 2, 4, 8, 1, 0, 333);
    ownership_raw_bytes_env.write(&e, 2, 0, 4, 2, 0, 334);
    ownership_raw_bytes.reference_result mut out =
