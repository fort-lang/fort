    defer ownership_raw_bytes.free_result(&before);
    u64 saved_count = e.paired.states[0].core->contents_len;
    e.paired.states[0].core->contents_len = ownership_raw_bytes.U64_MAX;
    ownership_raw.request req = ownership_raw_bytes_env.request(&e, 1368);
    ownership_raw_bytes_env.reset_budget(&e);
    ownership_raw_bytes.result mut out = ownership_raw_bytes.clone(&e.paired.states[0],
