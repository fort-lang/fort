fn interpretation_cannot_add_owner_at_original_place() void {
    ownership_raw_bytes_env.env mut e = {};
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes_env.setup(&e, 208, 0, false);
    ownership_raw_bytes_env.initial(&e, 0, 1320);
    ownership_raw_bytes.result mut before = ownership_raw_bytes_env.clone_input(&e);
    defer ownership_raw_bytes.free_result(&before);
    types.node* selected = types.type_ptr(&e.table, e.byte, true, false);
    assert(types.type_cast_allowed(selected, e.selected_type));
    assert(types.type_cast_adds_own(selected, e.selected_type));
    ownership_raw_bytes.reference_result mut out =
        ownership_raw_bytes_env.reference(&e, 1, 0, 8, selected, 1321);
    defer ownership_raw_bytes.free_reference(&out);
    ownership_raw_bytes_env.rejects(&out);
    assert(e.paired.states[0].core->allocations[0].obligation);
    ownership_raw_bytes_env.same(&e, &before.states[0]);
    println("unit-storage interpretation_cannot_add_owner_at_original_place");
}

fn interpretation_cannot_add_nested_owner() void {
    ownership_raw_bytes_env.env mut e = {};
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes_env.setup(&e, 209, 0, false);
    e.selected_type = types.type_ptr(&e.table, e.pointer, false, false);
    ownership_raw_bytes_env.initial(&e, 0, 1323);
    ownership_raw_bytes.result mut before = ownership_raw_bytes_env.clone_input(&e);
    defer ownership_raw_bytes.free_result(&before);
    types.node* inner = types.type_ptr(&e.table, e.byte, true, false);
    types.node* selected = types.type_ptr(&e.table, inner, false, false);
    assert(!selected->is_own && !e.selected_type->is_own);
    assert(types.type_cast_allowed(selected, e.selected_type));
    assert(types.type_cast_adds_own(selected, e.selected_type));
    ownership_raw_bytes.reference_result mut out =
        ownership_raw_bytes_env.reference(&e, 1, 0, 8, selected, 1324);
    defer ownership_raw_bytes.free_reference(&out);
    ownership_raw_bytes_env.rejects(&out);
    assert(e.paired.states[0].core->allocations[0].obligation);
    ownership_raw_bytes_env.same(&e, &before.states[0]);
    println("unit-storage interpretation_cannot_add_nested_owner");
}

fn interpretation_preserves_existing_owner() void {
    ownership_raw_bytes_env.env mut e = {};
