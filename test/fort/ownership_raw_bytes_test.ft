}
fn repair_absence_comparison() void {
    ownership_raw_bytes_env.env mut e = {};
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes_env.owner_setup(&e, 497, false);
    ownership_raw_bytes_env.empty_source(&e);
    ownership_raw_bytes_env.unknown(&e, 1, 3, 4, 2858);
    ownership_raw_bytes.result mut copy = ownership_raw_bytes_env.clone_input(&e);
    defer ownership_raw_bytes.free_result(&copy);
    assert(copy.states[0].bytes.facts.contents_len == 1);
    ownership_raw_bytes_env.same(&e, &copy.states[0]);
    copy.states[0].bytes.facts.contents_len = 0;
    ownership_raw.request req = ownership_raw_bytes_env.request(&e, 2859);
    ownership_api.proof_status mut proof = {};
    assert(!ownership_raw_bytes.equal(&e.paired.states[0], &copy.states[0],
        &e.service, &req, &proof));
    assert(ownership_api.successful(proof));
    println("repair absence-comparison");
}
fn repair_empty_overlap() void {
    assert(!ownership_raw_bytes.overlaps(3, 3, 0, 8));
    assert(!ownership_raw_bytes.overlaps(0, 8, 3, 3));
    assert(!ownership_raw_bytes.overlaps(3, 3, 3, 3));
    assert(!ownership_raw_bytes.overlaps(0, 3, 3, 8));
    assert(ownership_raw_bytes.overlaps(0, 4, 3, 8));
    println("repair empty-overlap");
}

fn repair_regressions() void {
    u32 mut kind = 0;
    while (kind < 8) { repair_marks(kind); kind += 1; }
    u32 mut test_case = 0;
    while (test_case < 10) {
        repair_owner_evidence(false, test_case);
        repair_owner_evidence(true, test_case);
        test_case += 1;
    }
    u32 mut mode = 0;
    while (mode < 3) {
        u32 mut point = 0;
        while (point < 3) {
            repair_empty_interval(mode, false, point, false);
            repair_empty_interval(mode, true, point, false);
            point += 1;
        }
        mode += 1;
    }
    repair_empty_interval(0, true, 1, true);
    repair_empty_interval(1, false, 1, true);
    u32 mut bits = 0;
    while (bits < 8) {
        repair_zero_recovery(bits % 2 == 1, (bits / 2) % 2 == 1, (bits / 4) % 2 == 1, true);
        bits += 1;
    }
    bits = 0;
    while (bits < 4) {
        repair_zero_recovery(bits % 2 == 1, false, (bits / 2) % 2 == 1, false);
        bits += 1;
    }
}

fn review_repeated(u32 kind, u32 mode, u32 index) void {
    ownership_raw_bytes_env.env mut e = {};
    ownership_raw_bytes_env.repeated_setup(&e, 520 + kind, kind, false);
    defer ownership_raw_bytes_env.close(&e);
    u64 stride = kind == 0 ? 8 : 16;
    if (mode == 2) {
        ownership_raw_bytes.window mut source = ownership_raw_bytes_env.window(&e,
            4, 0, 1, e.byte);
        source.source = ownership_raw_bytes_env.id(&e, ownership_api.entity_kind.source, 4);
        ownership_raw_bytes.byte_effect mut read = ownership_raw_bytes_env.effect(&e,
            ownership_raw_bytes.effect_kind.read, source);
        read.snapshot_key = 41;
        ownership_raw_bytes_env.apply(&e, read, 3100);
    }
    ownership_raw_bytes.result mut before = ownership_raw_bytes_env.clone_input(&e);
    defer ownership_raw_bytes.free_result(&before);
    ownership_raw_bytes.effect_kind action = mode == 0 ? ownership_raw_bytes.effect_kind.unknown :
        (mode == 1 ? ownership_raw_bytes.effect_kind.zero : ownership_raw_bytes.effect_kind.write);
    ownership_raw_bytes.byte_effect mut change = ownership_raw_bytes_env.effect(&e, action,
        ownership_raw_bytes_env.window(&e, 1, cast(index, u64) * stride,
        cast(index, u64) * stride + 1, e.byte));
    change.snapshot_key = 41;
    ownership_raw_bytes.result mut out = ownership_raw_bytes_env.try_effect(&e, change, 3101);
    defer ownership_raw_bytes.free_result(&out);
    assert(ownership_api.successful(out.proof));
    ownership_api.contents_fact altered = out.states[0].core->contents[index];
    assert(altered.kind == ownership_api.contents_kind.unknown);
    assert(ownership_state.same_borrow(altered.borrows[0],
        before.states[0].core->contents[index].borrows[0]));
    assert(ownership_state.same_contents(out.states[0].core->contents[1 - index],
        before.states[0].core->contents[1 - index]));
    assert(out.states[0].core->allocations[0].obligation);
    ownership_raw.request mut req = ownership_raw_bytes_env.request(&e, 3102);
    req.base.source = altered.place;
    req.base.source_key = altered.borrows[0].source;
    ownership_api.proof_status read = ownership_transfer.check_read(out.states[0].core,
        &e.service, &req.base, altered, false);
    assert(read.kind == ownership_api.proof_kind.incomplete);
    assert(!e.budget.witness_validated);
    assert(e.budget.last_event.text == "local ownership effect needs a proved fact");
    ownership_raw_bytes_env.same(&e, &before.states[0]);
    println("review repeated ", kind, " ", mode, " ", index);
}
fn review_unavailable(u32 kind) void {
    ownership_raw_bytes_env.env mut e = {};
    ownership_raw_bytes_env.repeated_setup(&e, 530 + kind, 0, false);
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw.term[1] terms = {ownership_raw.term{
        ownership_raw_bytes_env.id(&e, ownership_api.entity_kind.value, 99),
        ownership_raw.natural(1)}};
    if (kind == 0) { e.paired.states[0].raw.origins[0].count.complete = false; }
    if (kind == 1) { e.paired.states[0].raw.origins[0].count.terms = terms[..]; }
    if (kind == 2) { e.paired.states[0].raw.leaves[0].place.residual = true; }
    if (kind == 3) { e.paired.states[0].core->contents_len = 1; }
    if (kind == 4) { ownership_state.append_contents(e.paired.states[0].core,
        e.paired.states[0].core->contents[1]); }
    ownership_raw_bytes.result mut before = ownership_raw_bytes_env.clone_input(&e);
    defer ownership_raw_bytes.free_result(&before);
    ownership_raw_bytes.result mut out = ownership_raw_bytes_env.try_effect(&e,
        ownership_raw_bytes_env.effect(&e, ownership_raw_bytes.effect_kind.unknown,
        ownership_raw_bytes_env.window(&e, 1, 8, 9, e.byte)), 3110);
    defer ownership_raw_bytes.free_result(&out);
    assert(out.proof.kind == ownership_api.proof_kind.incomplete && out.states.len == 0);
    assert(!e.budget.witness_validated);
    assert(e.budget.last_event.evidence == ownership_api.evidence_kind.abstract_possibility);
    assert(e.budget.last_event.text ==
        "repeated reference window needs resolved element correspondence");
    if (kind == 0) {
        // Equality cannot prove an incomplete expression. Check its flag before comparison.
        assert(!e.paired.states[0].raw.origins[0].count.complete);
        assert(!before.states[0].raw.origins[0].count.complete);
        e.paired.states[0].raw.origins[0].count.complete = true;
        before.states[0].raw.origins[0].count.complete = true;
        ownership_raw_bytes_env.same(&e, &before.states[0]);
        e.paired.states[0].raw.origins[0].count.complete = false;
        before.states[0].raw.origins[0].count.complete = false;
    } else { ownership_raw_bytes_env.same(&e, &before.states[0]); }
    println("review unavailable ", kind);
}
fn review_repeated_control(u32 kind) void {
    ownership_raw_bytes_env.env mut e = {};
    ownership_raw_bytes_env.repeated_setup(&e, 540 + kind, 0, kind == 0);
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes.result mut before = ownership_raw_bytes_env.clone_input(&e);
    defer ownership_raw_bytes.free_result(&before);
    ownership_raw_bytes.byte_effect mut change = ownership_raw_bytes_env.effect(&e,
        kind == 2 ? ownership_raw_bytes.effect_kind.unchanged :
        ownership_raw_bytes.effect_kind.unknown,
        ownership_raw_bytes_env.window(&e, 1, 17, kind == 1 ? 17 : 18, e.byte));
    if (kind == 1) { change.selected.begin = 8; change.selected.end = 8; }
    if (kind == 2) {
        change.selected.begin = 8;
        change.selected.end = 9;
        change.unchanged_proved = true;
    }
    if (kind >= 3) {
        change.selected.begin = 8;
        change.selected.end = 9;
        ownership_raw_bytes.result mut success = ownership_raw_bytes_env.try_effect(&e,
            change, 3120);
        assert(ownership_api.successful(success.proof));
        u64 cost = e.budget.calls;
        ownership_raw_bytes.free_result(&success);
        u64 mut charge = 1;
        u64 last = kind == 3 ? 1 : cost;
        while (charge <= last) {
            ownership_raw.request req = ownership_raw_bytes_env.request(&e, 3121);
            change.operation = req.base.operation;
            change.source_position = req.base.source_position;
            ownership_raw_bytes_env.reset_budget(&e);
            e.budget.deny_at = charge;
            ownership_raw_bytes.byte_effect[1] effects = {change};
            ownership_raw_bytes.result mut out = ownership_raw_bytes.apply_ordered(
                &e.paired.states[0], &e.service, effects[..], &req);
            defer ownership_raw_bytes.free_result(&out);
            assert(out.proof.kind == ownership_api.proof_kind.incomplete && out.states.len == 0);
            assert(out.proof.terminal.reason == ownership_api.incomplete_reason.work_limit);
            assert(ownership_keys.operation(out.proof.terminal.operation, req.base.operation) == 0);
            assert(ownership_keys.source(out.proof.terminal.source, req.base.source_position) == 0);
            assert(out.proof.terminal.limit.used == out.proof.terminal.limit.bound);
            assert(out.proof.terminal.limit.attempted > 0);
            ownership_raw_bytes_env.same(&e, &before.states[0]);
            charge += 1;
        }
    } else {
        ownership_raw_bytes.result mut out = ownership_raw_bytes_env.try_effect(&e, change, 3122);
        defer ownership_raw_bytes.free_result(&out);
        assert(ownership_api.successful(out.proof));
        assert(ownership_state.equal(out.states[0].core, before.states[0].core));
    }
    ownership_raw_bytes_env.same(&e, &before.states[0]);
    println("review repeated-control ", kind);
}
fn review_residual(u32 kind) void {
    ownership_raw_bytes_env.env mut e = {};
    ownership_raw_bytes_env.aggregate_setup(&e, 550 + kind, false, false);
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes_env.descendants(&e, false);
    ownership_api.place_path mut path = ownership_raw_bytes_env.place(&e, 1);
    ownership_api.projection[1] mut part = {};
    if (kind == 1 || kind == 3) {
        part[0].kind = ownership_api.projection_kind.field;
        part[0].field = 0;
        path.projections = part[..];
    }
    if (kind == 2) {
        part[0].kind = ownership_api.projection_kind.fixed_index;
        part[0].index = ownership_raw_bytes_env.exact(0);
        path.projections = part[..];
    }
    path.residual = kind != 3;
    e.paired.states[0].core->allocations[0].owner.place =
        ownership_state.copy_place(e.paired.states[0].core, path);
    ownership_raw_bytes.result mut before = ownership_raw_bytes_env.clone_input(&e);
    defer ownership_raw_bytes.free_result(&before);
    ownership_raw_bytes.window selected = ownership_raw_bytes_env.erased_window(&e, 3130);
    ownership_raw.request req = ownership_raw_bytes_env.request(&e, 3131);
    ownership_raw_bytes_env.reset_budget(&e);
    ownership_api.proof_status proof = ownership_raw_bytes.check_shallow_release(
        &e.paired.states[0], &e.service, selected, &req);
    assert(!ownership_api.successful(proof));
    assert((proof.kind == ownership_api.proof_kind.complete) == (kind == 3));
    assert(e.budget.witness_validated == (kind == 3));
    assert(e.budget.last_event.evidence == (kind == 3 ? ownership_api.evidence_kind.unconditional :
        ownership_api.evidence_kind.abstract_possibility));
    assert(e.budget.last_event.text == "shallow release retains an owned descendant");
    assert(e.paired.states[0].core->allocations[0].obligation);
    ownership_raw_bytes_env.same(&e, &before.states[0]);
    println("review residual ", kind);
}
fn review_maximum(u32 kind) void {
    ownership_raw_bytes_env.env mut e = {};
    ownership_raw_bytes_env.setup(&e, 560 + kind, 0, false);
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes.window mut selected = ownership_raw_bytes_env.window(&e,
        4, 0, 24, e.byte);
    selected.source = ownership_raw_bytes_env.id(&e, ownership_api.entity_kind.source, 4);
    if (kind == 5) {
        selected.begin = 16;
        selected.end = 24;
        selected.ty = e.pointer;
        ownership_raw_bytes.byte_effect mut seed = ownership_raw_bytes_env.effect(&e,
            ownership_raw_bytes.effect_kind.seed, selected);
        seed.checked_value = true;
        seed.value = e.first;
        ownership_raw_bytes_env.apply(&e, seed, 3135);
        u64 original = ownership_raw_bytes.U64_MAX - 15;
        e.paired.states[0].bytes.representations[0].fragments[0].original_begin = original;
        selected.begin = 0;
        selected.end = 24;
        selected.ty = e.byte;
        ownership_raw_bytes.byte_effect mut read = ownership_raw_bytes_env.effect(&e,
            ownership_raw_bytes.effect_kind.read, selected);
        read.snapshot_key = 42;
        ownership_raw_bytes_env.apply(&e, read, 3136);
        selected.begin = original;
        selected.end = original + 8;
        selected.ty = e.pointer;
        seed.selected = selected;
        ownership_raw_bytes_env.apply(&e, seed, 3137);
        e.paired.states[0].bytes.representations[1].fragments[0].original_begin = original;
        ownership_raw_bytes.result mut before = ownership_raw_bytes_env.clone_input(&e);
        defer ownership_raw_bytes.free_result(&before);
        selected.ty = e.byte;
        ownership_raw_bytes.byte_effect mut copy = ownership_raw_bytes_env.effect(&e,
            ownership_raw_bytes.effect_kind.write, selected);
        copy.snapshot_key = 42;
        copy.snapshot_begin = 16;
        ownership_raw_bytes_env.apply(&e, copy, 3138);
        ownership_raw_bytes_env.same(&e, &before.states[0]);
        println("review maximum ", kind);
        return;
    }
    ownership_raw_bytes.byte_effect mut change = ownership_raw_bytes_env.effect(&e,
        ownership_raw_bytes.effect_kind.read, selected);
    change.snapshot_key = 42;
    ownership_raw_bytes_env.apply(&e, change, 3140);
    u64 begin = ownership_raw_bytes.U64_MAX - (kind < 2 ? 15 : 31);
    selected.begin = begin;
    selected.end = begin + (kind == 2 ? 16 : 8);
    selected.ty = kind == 2 ? e.span : e.pointer;
    change = ownership_raw_bytes_env.effect(&e, ownership_raw_bytes.effect_kind.seed, selected);
    change.value = e.first;
    change.checked_value = true;
    ownership_raw_bytes_env.apply(&e, change, 3141);
    if (kind == 3) {
        e.paired.states[0].bytes.representations[0].fragments[0].original_begin = begin;
        selected.begin = begin + 4;
        selected.end = begin + 8;
        selected.ty = e.byte;
        change = ownership_raw_bytes_env.effect(&e, ownership_raw_bytes.effect_kind.read, selected);
        change.snapshot_key = 43;
        ownership_raw_bytes_env.apply(&e, change, 3142);
        assert(e.paired.states[0].bytes.snapshots[1].fragments[0].original_begin == begin + 4);
    } else if (kind == 4) {
        e.paired.states[0].bytes.representations[0].fragments[0].original_begin =
            ownership_raw_bytes.U64_MAX - 15;
        ownership_raw.request req = ownership_raw_bytes_env.request(&e, 3148);
        ownership_raw_bytes.reference_result mut maximum = ownership_raw_bytes.read_reference(
            &e.paired.states[0], &e.service, selected, &req);
        defer ownership_raw_bytes.free_reference(&maximum);
        assert(maximum.proof.kind == ownership_api.proof_kind.incomplete);
        assert(e.budget.last_event.text == "reference representation correspondence is incomplete");
        ownership_raw_bytes_env.initial(&e, 0, 3144);
        e.paired.states[0].bytes.representations[1].fragments[0].original_begin = 1;
        ownership_raw_bytes.reference_result mut out = ownership_raw_bytes_env.reference(&e,
            1, 0, 8, e.pointer, 3145);
        defer ownership_raw_bytes.free_reference(&out);
        assert(out.proof.kind == ownership_api.proof_kind.incomplete);
        assert(e.budget.last_event.text == "reference representation correspondence is incomplete");
    } else {
        if (kind == 0) { selected.begin = begin - 8; }
        if (kind == 2) { selected.end = begin + 8; }
        if (kind == 6) { selected.begin = begin + 3; selected.end = selected.begin; }
        selected.ty = e.byte;
        change = ownership_raw_bytes_env.effect(&e,
            ownership_raw_bytes.effect_kind.write, selected);
        change.snapshot_key = 42;
        change.snapshot_begin = kind == 0 ? 8 : (kind == 1 ? 16 : (kind == 7 ? 24 : 0));
        ownership_raw_bytes.result mut before = ownership_raw_bytes_env.clone_input(&e);
        defer ownership_raw_bytes.free_result(&before);
        ownership_raw_bytes.result mut out = ownership_raw_bytes_env.try_effect(&e, change, 3146);
        defer ownership_raw_bytes.free_result(&out);
        if (kind == 7) {
            assert(out.proof.kind == ownership_api.proof_kind.incomplete && out.states.len == 0);
            assert(e.budget.last_event.text == "byte snapshot range exceeds its read");
        } else {
            assert(ownership_api.successful(out.proof));
            if (kind == 6) {
                ownership_raw_bytes_env.take(&e, &out);
                ownership_raw_bytes_env.same(&e, &before.states[0]);
            }
        }
        if (kind == 2) {
            change.selected.begin = begin + 8;
            change.selected.end = begin + 16;
            change.snapshot_begin = 8;
            ownership_raw_bytes_env.apply(&e, change, 3147);
        }
    }
    println("review maximum ", kind);
}
fn review_regressions() void {
    u32 mut kind = 0;
    while (kind < 3) {
        u32 mut mode = 0;
        while (mode < 3) {
            review_repeated(kind, mode, 0);
            review_repeated(kind, mode, 1);
            mode += 1;
        }
        kind += 1;
    }
    kind = 0;
    while (kind < 5) {
        review_unavailable(kind);
        review_repeated_control(kind);
        kind += 1;
    }
    kind = 0;
    while (kind < 4) { review_residual(kind); kind += 1; }
    kind = 0;
    while (kind < 8) { review_maximum(kind); kind += 1; }
}

fn third_count_one(u32 kind, u32 mode, string receipt) void {
    ownership_raw_bytes_env.env mut e = {};
    ownership_raw_bytes_env.repeated_setup_count(&e, 610 + kind, kind, false, 1);
    defer ownership_raw_bytes_env.close(&e);
    if (mode == 2) {
        ownership_raw_bytes.window mut bytes = ownership_raw_bytes_env.window(&e, 4, 0, 1,
            e.byte);
        bytes.source = ownership_raw_bytes_env.id(&e, ownership_api.entity_kind.source, 4);
        ownership_raw_bytes.byte_effect mut read = ownership_raw_bytes_env.effect(&e,
            ownership_raw_bytes.effect_kind.read, bytes);
        read.snapshot_key = 41;
        ownership_raw_bytes_env.apply(&e, read, 3200);
    }
    ownership_raw_bytes.result mut before = ownership_raw_bytes_env.clone_input(&e);
    defer ownership_raw_bytes.free_result(&before);
    ownership_raw_bytes.byte_effect mut change = ownership_raw_bytes_env.effect(&e,
        mode == 0 ? ownership_raw_bytes.effect_kind.unknown :
        (mode == 1 ? ownership_raw_bytes.effect_kind.zero : ownership_raw_bytes.effect_kind.write),
        ownership_raw_bytes_env.window(&e, 1, 0, 1, e.byte));
    change.snapshot_key = 41;
    ownership_raw_bytes.result mut out = ownership_raw_bytes_env.try_effect(&e, change, 3201);
    defer ownership_raw_bytes.free_result(&out);
    assert(ownership_api.successful(out.proof) && out.states.len == 1);
    ownership_api.contents_fact altered = out.states[0].core->contents[0];
    assert(altered.kind == ownership_api.contents_kind.unknown);
    assert(ownership_state.same_borrow(altered.borrows[0], e.first.borrows[0]));
    assert(out.states[0].core->allocations[0].obligation);
    ownership_raw.request mut req = ownership_raw_bytes_env.request(&e, 3202);
    req.base.source = altered.place;
    req.base.source_key = altered.borrows[0].source;
    ownership_raw_bytes_env.reset_budget(&e);
    ownership_api.proof_status read = ownership_transfer.check_read(out.states[0].core,
        &e.service, &req.base, altered, false);
    assert(read.kind == ownership_api.proof_kind.incomplete);
    assert(!e.budget.witness_validated);
    assert(e.budget.last_event.text == "local ownership effect needs a proved fact");
    ownership_raw_bytes_env.same(&e, &before.states[0]);
    println("review3 sequence ", receipt);
}
fn third_count_field(bool padding, string receipt) void {
    ownership_raw_bytes_env.env mut e = {};
    ownership_raw_bytes_env.repeated_setup_count(&e, 614, 0, true, 1);
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes.result mut before = ownership_raw_bytes_env.clone_input(&e);
    defer ownership_raw_bytes.free_result(&before);
    ownership_raw_bytes.result mut out = ownership_raw_bytes_env.try_effect(&e,
        ownership_raw_bytes_env.effect(&e, ownership_raw_bytes.effect_kind.unknown,
        ownership_raw_bytes_env.window(&e, 1, padding ? 1 : 8, padding ? 2 : 9, e.byte)), 3210);
    defer ownership_raw_bytes.free_result(&out);
    assert(ownership_api.successful(out.proof));
    if (padding) {
        assert(ownership_state.same_contents(out.states[0].core->contents[0], e.first));
    }
    else { assert(out.states[0].core->contents[0].kind == ownership_api.contents_kind.unknown); }
    assert(out.states[0].core->allocations[0].obligation);
    ownership_raw_bytes_env.same(&e, &before.states[0]);
    println("review3 sequence ", receipt);
}
fn third_count_unavailable(u32 kind, string receipt) void {
    ownership_raw_bytes_env.env mut e = {};
    ownership_raw_bytes_env.repeated_setup_count(&e, 615, 0, false, 1);
    defer ownership_raw_bytes_env.close(&e);
    ownership_state.state mut* core = e.paired.states[0].core;
    if (kind == 0) { core->contents_len = 0; }
    if (kind == 1) { ownership_state.append_contents(core, core->contents[0]); }
    if (kind == 2) {
        ownership_api.projection[1] mut parts = {core->contents[0].place.projections[0]};
        parts[0].index = ownership_raw_bytes_env.exact(1);
        ownership_api.place_path mut path = core->contents[0].place;
        path.projections = parts[..];
        core->contents[0].place = ownership_state.copy_place(core, path);
    }
    if (kind == 3) { core->contents[0].place.residual = true; }
    ownership_raw_bytes.result mut before = ownership_raw_bytes_env.clone_input(&e);
    defer ownership_raw_bytes.free_result(&before);
    ownership_raw_bytes.result mut out = ownership_raw_bytes_env.try_effect(&e,
        ownership_raw_bytes_env.effect(&e, ownership_raw_bytes.effect_kind.unknown,
        ownership_raw_bytes_env.window(&e, 1, 0, 1, e.byte)), 3220);
    defer ownership_raw_bytes.free_result(&out);
    assert(out.proof.kind == ownership_api.proof_kind.incomplete && out.states.len == 0);
    assert(!e.budget.witness_validated);
    assert(e.budget.last_event.text ==
        "repeated reference window needs resolved element correspondence");
    ownership_raw_bytes_env.same(&e, &before.states[0]);
    println("review3 sequence ", receipt);
}
fn third_typed(u32 kind, u32 release, string receipt) void {
    ownership_raw_bytes_env.env mut e = {};
    ownership_raw_bytes_env.setup(&e, 620 + kind, kind, false);
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes.result mut before = ownership_raw_bytes_env.clone_input(&e);
    defer ownership_raw_bytes.free_result(&before);
    ownership_raw_bytes.byte_effect mut change = ownership_raw_bytes_env.effect(&e,
        ownership_raw_bytes.effect_kind.replacement,
        ownership_raw_bytes_env.window(&e, 1, 0, kind == 0 ? 8 : 16, e.selected_type));
    change.checked_value = true;
    change.value = e.second;
    ownership_raw_bytes.result mut out = ownership_raw_bytes_env.try_effect(&e, change, 3230);
    defer ownership_raw_bytes.free_result(&out);
    assert(ownership_api.successful(out.proof) && out.states.len == 1);
    assert(out.states[0].bytes.representations_len == 1);
    ownership_api.contents_fact actual = out.states[0].core->contents[0];
    assert(actual.kind == ownership_api.contents_kind.reference);
    assert(ownership_raw.same_key(actual.borrows[0].source, e.second.borrows[0].source));
    assert(ownership_raw.same_key(actual.value_version, e.second.value_version));
    assert(actual.span_length.value == e.second.span_length.value);
    assert(actual.borrows[0].range.offset.value == e.second.borrows[0].range.offset.value);
    assert(actual.borrows[0].range.access.end.value == e.second.borrows[0].range.access.end.value);
    ownership_raw.request req = ownership_raw_bytes_env.request(&e, 3231);
    ownership_raw_bytes_env.reset_budget(&e);
    ownership_raw_bytes.reference_result mut rebuilt = ownership_raw_bytes.read_reference(
        &out.states[0], &e.service, change.selected, &req);
    defer ownership_raw_bytes.free_reference(&rebuilt);
    assert(ownership_api.successful(rebuilt.proof));
    assert(ownership_raw.same_key(rebuilt.value.borrows[0].source, e.second.borrows[0].source));
    if (release != 0) {
        out.states[0].core->allocations[release == 1 ? 1 : 0].validity =
            ownership_api.validity_kind.released;
        out.states[0].core->sources[release == 1 ? 4 : 3].validity =
            ownership_api.validity_kind.released;
    }
    ownership_raw.request mut read_req = ownership_raw_bytes_env.request(&e, 3232);
    read_req.base.source = actual.place;
    read_req.base.source_key = actual.borrows[0].source;
    ownership_raw_bytes_env.reset_budget(&e);
    ownership_api.proof_status read = ownership_transfer.check_read(out.states[0].core,
        &e.service, &read_req.base, actual, false);
    assert(ownership_api.successful(read) == (release != 1));
    if (release == 1) {
        assert(e.budget.last_event.kind == ownership_api.event_kind.invalid_use);
        assert(e.budget.last_event.evidence == ownership_api.evidence_kind.unconditional);
        assert(e.budget.last_event.text == "reference source is no longer live");
    }
    ownership_raw_bytes_env.same(&e, &before.states[0]);
    println("review3 sequence ", receipt);
}
fn third_indexed(u32 mode, string receipt) void {
    ownership_raw_bytes_env.env mut e = {};
    ownership_raw_bytes_env.repeated_setup_count(&e, 624, 0, false, mode == 0 ? 1 : 2);
    defer ownership_raw_bytes_env.close(&e);
    u64 index = mode == 2 ? 1 : 0;
    ownership_raw_bytes.result mut before = ownership_raw_bytes_env.clone_input(&e);
    defer ownership_raw_bytes.free_result(&before);
    ownership_raw_bytes.byte_effect mut change = ownership_raw_bytes_env.effect(&e,
        ownership_raw_bytes.effect_kind.replacement,
        ownership_raw_bytes_env.window(&e, 1, index * 8, index * 8 + 8, e.pointer));
    change.selected.place = e.paired.states[0].core->contents[index].place;
    change.checked_value = true;
    change.value = ownership_raw_bytes_env.value(&e, 3, 99, 4, 0, 8, 1);
    ownership_raw_bytes.result mut out = ownership_raw_bytes_env.try_effect(&e, change, 3240);
    defer ownership_raw_bytes.free_result(&out);
    assert(ownership_api.successful(out.proof));
    assert(out.states[0].core->contents[index].kind == ownership_api.contents_kind.reference);
    assert(out.states[0].core->contents[index].borrows[0].source.ordinal == 4);
    if (mode != 0) {
        assert(ownership_state.same_contents(out.states[0].core->contents[1 - index],
            before.states[0].core->contents[1 - index]));
    }
    assert(out.states[0].core->allocations[0].obligation);
    ownership_raw_bytes_env.same(&e, &before.states[0]);
    println("review3 sequence ", receipt);
}
fn third_layout(u32 mode, string receipt) void {
    ownership_raw_bytes_env.env mut e = {};
    if (mode == 2) { ownership_raw_bytes_env.setup(&e, 625, 1, false); }
    else { ownership_raw_bytes_env.borrowed_record(&e, 625, mode == 1); }
    defer ownership_raw_bytes_env.close(&e);
    if (mode == 1) {
        ownership_raw_bytes_env.seed(&e, 1, 0, 16, e.span, e.first, true, 3250);
    }
    ownership_raw_bytes.result mut before = ownership_raw_bytes_env.clone_input(&e);
    defer ownership_raw_bytes.free_result(&before);
    ownership_raw_bytes.byte_effect mut change = ownership_raw_bytes_env.effect(&e,
        ownership_raw_bytes.effect_kind.replacement,
        ownership_raw_bytes_env.window(&e, 1, 0, 8, e.pointer));
    change.selected.place = e.paired.states[0].core->contents[0].place;
    change.value = e.second;
    change.checked_value = true;
    ownership_raw_bytes.result mut out = ownership_raw_bytes_env.try_effect(&e, change, 3251);
    defer ownership_raw_bytes.free_result(&out);
    if (mode == 2) {
        assert(out.proof.kind == ownership_api.proof_kind.incomplete && out.states.len == 0);
        assert(e.budget.last_event.text == "typed replacement needs resolved leaf correspondence");
        assert(!e.budget.witness_validated);
    } else {
        assert(ownership_api.successful(out.proof));
        assert(out.states[0].core->contents[0].kind == ownership_api.contents_kind.reference);
        assert(out.states[0].core->contents[0].borrows[0].source.ordinal == 2);
        if (mode == 0) {
            assert(ownership_state.same_contents(out.states[0].core->contents[1],
                before.states[0].core->contents[1]));
        } else {
            assert(out.states[0].core->contents[3].kind == ownership_api.contents_kind.unknown);
        }
    }
    ownership_raw_bytes_env.same(&e, &before.states[0]);
    println("review3 sequence ", receipt);
}
fn third_unavailable(u32 kind, string receipt) void {
    ownership_raw_bytes_env.env mut e = {};
    ownership_raw_bytes_env.setup(&e, 626, 0, false);
    defer ownership_raw_bytes_env.close(&e);
    ownership_state.state mut* core = e.paired.states[0].core;
    if (kind == 0) { core->contents[0].place.root.ordinal = 99; }
    if (kind == 1) { ownership_state.append_contents(core, core->contents[0]); }
    if (kind == 3) {
        core->sources[4].validity = ownership_api.validity_kind.released;
        core->allocations[1].validity = ownership_api.validity_kind.released;
    }
    ownership_raw_bytes.result mut before = ownership_raw_bytes_env.clone_input(&e);
    defer ownership_raw_bytes.free_result(&before);
    ownership_raw_bytes.byte_effect mut change = ownership_raw_bytes_env.effect(&e,
        ownership_raw_bytes.effect_kind.replacement,
        ownership_raw_bytes_env.window(&e, 1, 0, 8, e.pointer));
    if (kind == 2) { change.selected.place = ownership_raw_bytes_env.place(&e, 2); }
    change.value = e.second;
    change.checked_value = true;
    ownership_raw_bytes.result mut out = ownership_raw_bytes_env.try_effect(&e, change, 3260);
    defer ownership_raw_bytes.free_result(&out);
    assert(!ownership_api.successful(out.proof) && out.states.len == 0);
    if (kind == 3) {
        assert(e.budget.last_event.kind == ownership_api.event_kind.invalid_use);
        assert(e.budget.last_event.text == "raw source is no longer live");
    } else {
        assert(out.proof.kind == ownership_api.proof_kind.incomplete);
        assert(!e.budget.witness_validated);
        assert(e.budget.last_event.text == "typed replacement needs resolved leaf correspondence");
    }
    ownership_raw_bytes_env.same(&e, &before.states[0]);
    println("review3 sequence ", receipt);
}
fn third_marks(bool owning, string receipt) void {
    ownership_raw_bytes_env.env mut e = {};
    ownership_raw_bytes_env.setup(&e, 627, 0, false);
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes.result mut before = ownership_raw_bytes_env.clone_input(&e);
    defer ownership_raw_bytes.free_result(&before);
    types.node* ty = types.type_ptr(&e.table, e.byte, owning, !owning);
    ownership_raw_bytes.byte_effect mut change = ownership_raw_bytes_env.effect(&e,
        ownership_raw_bytes.effect_kind.replacement,
        ownership_raw_bytes_env.window(&e, 1, 0, 8, ty));
    change.value = e.second;
    change.checked_value = true;
    ownership_raw_bytes.result mut out = ownership_raw_bytes_env.try_effect(&e, change, 3270);
    defer ownership_raw_bytes.free_result(&out);
    assert(out.proof.kind == ownership_api.proof_kind.incomplete && out.states.len == 0);
    assert(!e.budget.witness_validated);
    assert(e.budget.last_event.text == "typed replacement needs resolved leaf correspondence");
    ownership_raw_bytes_env.same(&e, &before.states[0]);
    println("review3 sequence ", receipt);
}
fn third_order(bool unknown, string receipt) void {
    ownership_raw_bytes_env.env mut e = {};
    ownership_raw_bytes_env.setup(&e, 628, 0, false);
    defer ownership_raw_bytes_env.close(&e);
    if (unknown) { ownership_raw_bytes_env.unknown(&e, 1, 0, 1, 3280); }
    ownership_raw_bytes.result mut before = ownership_raw_bytes_env.clone_input(&e);
    defer ownership_raw_bytes.free_result(&before);
    ownership_raw_bytes.byte_effect[2] mut changes = {};
    ownership_raw.request mut req = {};
    ownership_raw_bytes_cleanup_env.sequence(&e, changes[..], &req, 3281);
    u32 mut i = 0;
    while (i < 2) {
        changes[i].kind = ownership_raw_bytes.effect_kind.replacement;
        changes[i].selected = ownership_raw_bytes_env.window(&e, 1, 0, 8, e.pointer);
        changes[i].value = i == 0 || unknown ? e.second :
            ownership_raw_bytes_env.value(&e, 3, 99, 4, 0, 8, 1);
        changes[i].checked_value = true;
        i += 1;
    }
    ownership_raw_bytes_env.reset_budget(&e);
    ownership_raw_bytes.result mut out = ownership_raw_bytes.apply_ordered(&e.paired.states[0],
        &e.service, changes[..unknown ? 1 : 2], &req);
    defer ownership_raw_bytes.free_result(&out);
    assert(ownership_api.successful(out.proof));
    assert(out.states[0].core->contents[0].kind == ownership_api.contents_kind.reference);
    assert(out.states[0].core->contents[0].borrows[0].source.ordinal == (unknown ? 2 : 4));
    assert(out.states[0].bytes.representations_len == 1);
    ownership_raw_bytes_env.same(&e, &before.states[0]);
    println("review3 sequence ", receipt);
}
fn third_work_sweep(bool typed) void {
    ownership_raw_bytes_env.env mut e = {};
    if (typed) { ownership_raw_bytes_env.setup(&e, 629, 0, false); }
    else { ownership_raw_bytes_env.repeated_setup_count(&e, 629, 0, false, 1); }
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes.result mut before = ownership_raw_bytes_env.clone_input(&e);
    defer ownership_raw_bytes.free_result(&before);
    ownership_raw_bytes.byte_effect mut change = ownership_raw_bytes_env.effect(&e,
        typed ? ownership_raw_bytes.effect_kind.replacement :
        ownership_raw_bytes.effect_kind.unknown,
        ownership_raw_bytes_env.window(&e, 1, 0, typed ? 8 : 1, typed ? e.pointer : e.byte));
    change.value = e.second;
    change.checked_value = true;
    ownership_raw_bytes.result mut control = ownership_raw_bytes_env.try_effect(&e, change, 3290);
    assert(ownership_api.successful(control.proof));
    u64 cost = e.budget.calls;
    ownership_raw_bytes.free_result(&control);
    u64 mut charge = 1;
    while (charge <= cost) {
        ownership_raw.request req = ownership_raw_bytes_env.request(&e, 3291);
        change.operation = req.base.operation;
        change.source_position = req.base.source_position;
        ownership_raw_bytes_env.reset_budget(&e);
        e.budget.deny_at = charge;
        ownership_raw_bytes.byte_effect[1] changes = {change};
        ownership_raw_bytes.result mut refused = ownership_raw_bytes.apply_ordered(
            &e.paired.states[0], &e.service, changes[..], &req);
        defer ownership_raw_bytes.free_result(&refused);
        assert(refused.proof.kind == ownership_api.proof_kind.incomplete &&
            refused.states.len == 0);
        assert(refused.proof.terminal.reason == ownership_api.incomplete_reason.work_limit);
        assert(ownership_keys.operation(refused.proof.terminal.operation, req.base.operation) == 0);
        assert(ownership_keys.source(refused.proof.terminal.source, req.base.source_position) == 0);
        assert(refused.proof.terminal.limit.used == refused.proof.terminal.limit.bound);
        assert(refused.proof.terminal.limit.attempted > 0);
        ownership_raw_bytes_env.same(&e, &before.states[0]);
        charge += 1;
    }
    println("review3 sweep ", typed);
}
fn third_regressions() void {
    third_count_one(0, 0, "count-one-pointer-unknown");
    third_count_one(0, 1, "count-one-pointer-zero");
    third_count_one(0, 2, "count-one-pointer-snapshot-write");
    third_count_one(1, 0, "count-one-span-unknown");
    third_count_one(1, 1, "count-one-span-zero");
    third_count_one(1, 2, "count-one-span-snapshot-write");
    third_count_one(2, 0, "count-one-string-unknown");
    third_count_one(2, 1, "count-one-string-zero");
    third_count_one(2, 2, "count-one-string-snapshot-write");
    third_count_field(false, "count-one-field");
    third_count_field(true, "count-one-padding");
    third_count_unavailable(0, "count-one-unavailable-missing");
    third_count_unavailable(1, "count-one-unavailable-duplicate");
    third_count_unavailable(2, "count-one-unavailable-wrong-index");
    third_count_unavailable(3, "count-one-unavailable-residual");
    third_typed(0, 0, "typed-pointer-release-neither");
    third_typed(0, 1, "typed-pointer-release-B");
    third_typed(0, 2, "typed-pointer-release-A");
    third_typed(1, 0, "typed-span-release-neither");
    third_typed(1, 1, "typed-span-release-B");
    third_typed(1, 2, "typed-span-release-A");
    third_typed(2, 0, "typed-string-release-neither");
    third_typed(2, 1, "typed-string-release-B");
    third_typed(2, 2, "typed-string-release-A");
    third_indexed(0, "typed-indexed-count-one");
    third_indexed(1, "typed-indexed-count-two-first");
    third_indexed(2, "typed-indexed-count-two-last");
    third_layout(0, "typed-struct-field");
    third_layout(1, "typed-overlapping-view");
    third_layout(2, "typed-partial-original-leaf");
    third_unavailable(0, "typed-unavailable-missing");
    third_unavailable(1, "typed-unavailable-duplicate");
    third_unavailable(2, "typed-unavailable-wrong-path");
    third_unavailable(3, "typed-released-new-source");
    third_marks(false, "typed-added-mut");
    third_marks(true, "typed-added-own");
    third_order(false, "typed-ordered-two-replacements");
    third_order(true, "typed-after-unknown");
    third_work_sweep(false);
    third_work_sweep(true);
    ownership_raw_bytes_cleanup_env.typed_allocator_probe(0);
    ownership_raw_bytes_cleanup_env.typed_allocator_probe(1);
}

