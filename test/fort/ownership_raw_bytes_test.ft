fn nested_shape_and_guard_storage() void {
    ownership_raw_bytes_env.env mut e = {};
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes_env.setup(&e, 246, 0, false);
    ownership_raw_bytes_env.initial(&e, 0, 1743);
    ownership_api.entity_id[1] keys = {ownership_raw_bytes_env.id(&e,
        ownership_api.entity_kind.value, 77)};
    ownership_api.shape_description mut shape = {};
    shape.key = ownership_raw_bytes_env.id(&e, ownership_api.entity_kind.template, 1);
    shape.parameters = keys[..];
    shape.clauses = keys[..];
    shape.descendants = keys[..];
    ownership_state.append_shapes(e.paired.states[0].core, shape);
    ownership_api.guard_fact mut guard = {};
    guard.key = ownership_raw_bytes_env.id(&e, ownership_api.entity_kind.guard, 1);
    guard.positive = keys[..];
    guard.negative = keys[..];
    ownership_state.append_guards(e.paired.states[0].core, guard);
    ownership_raw_bytes.result mut before = ownership_raw_bytes_env.clone_input(&e);
    defer ownership_raw_bytes.free_result(&before);
    ownership_state.state* copied = before.states[0].core;
    ownership_state.state* original = e.paired.states[0].core;
    assert(copied->shapes[0].parameters.ptr != original->shapes[0].parameters.ptr);
    assert(copied->shapes[0].clauses.ptr != original->shapes[0].clauses.ptr);
    assert(copied->shapes[0].descendants.ptr != original->shapes[0].descendants.ptr);
    assert(copied->guards[0].positive.ptr != original->guards[0].positive.ptr);
    assert(copied->guards[0].negative.ptr != original->guards[0].negative.ptr);
    ownership_raw_bytes_env.same(&e, &before.states[0]);
    println("unit-storage nested_shape_and_guard_copy");
    // The fixture constructs a range descriptor. The refusal reads no range element.
    u64 count = types.TYPE_MAX_SIZE / sizeof(ownership_api.entity_id) + 1;
    ownership_api.entity_id@ oversized = keys[..].ptr[0..count];
    u32 mut mode = 0;
    while (mode < 5) {
        ownership_api.entity_id@ mut saved = {};
        switch (mode) {
        case 0:
            saved = original->shapes[0].parameters;
            e.paired.states[0].core->shapes[0].parameters = oversized;
            break;
        case 1:
            saved = original->shapes[0].clauses;
            e.paired.states[0].core->shapes[0].clauses = oversized;
            break;
        case 2:
            saved = original->shapes[0].descendants;
            e.paired.states[0].core->shapes[0].descendants = oversized;
            break;
        case 3:
            saved = original->guards[0].positive;
            e.paired.states[0].core->guards[0].positive = oversized;
            break;
        case 4:
            saved = original->guards[0].negative;
            e.paired.states[0].core->guards[0].negative = oversized;
            break;
        }
        ownership_raw.request req = ownership_raw_bytes_env.request(&e, 1796);
        ownership_raw_bytes_env.reset_budget(&e);
        ownership_raw_bytes.result mut out = ownership_raw_bytes.clone(&e.paired.states[0],
            &e.service, &req);
        defer ownership_raw_bytes.free_result(&out);
        switch (mode) {
        case 0: e.paired.states[0].core->shapes[0].parameters = saved; break;
        case 1: e.paired.states[0].core->shapes[0].clauses = saved; break;
        case 2: e.paired.states[0].core->shapes[0].descendants = saved; break;
        case 3: e.paired.states[0].core->guards[0].positive = saved; break;
        case 4: e.paired.states[0].core->guards[0].negative = saved; break;
        }
        assert(!ownership_api.successful(out.proof) && out.states.len == 0);
        assert(out.proof.terminal.reason == ownership_api.incomplete_reason.unknown_effect);
        assert(e.budget.last_event.kind == ownership_api.event_kind.incomplete_proof);
        ownership_raw_bytes_env.same(&e, &before.states[0]);
        println("unit-storage nested_storage_refusal ", mode);
        mode += 1;
    }
}

