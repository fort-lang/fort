    println("unit-owner shallow_release_refuses_malformed_raw_count");
}

fn move_requires_checked_operand_correspondence() void {
    ownership_raw_bytes_env.env mut e = {};
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes_env.owner_setup(&e, 314, false);
    ownership_raw_bytes.result mut before = ownership_raw_bytes_env.clone_input(&e);
    defer ownership_raw_bytes.free_result(&before);
    ownership_raw.request mut req = ownership_raw_bytes_env.move_request(&e, 1, 2, 2650);
    req.base.source_correspondence_proved = false;
    ownership_raw_bytes_env.reset_budget(&e);
    ownership_raw_bytes.result mut out = ownership_raw_bytes.semantic_move(&e.paired.states[0],
        &e.service, ownership_raw_bytes_env.window(&e, 1, 0, 8, e.selected_type),
        ownership_raw_bytes_env.window(&e, 2, 0, 8, e.selected_type), &req);
    defer ownership_raw_bytes.free_result(&out);
    assert(!ownership_api.successful(out.proof) && out.states.len == 0);
    assert(out.proof.terminal.reason == ownership_api.incomplete_reason.unknown_effect);
    ownership_raw_bytes_env.same(&e, &before.states[0]);
    println("unit-owner move_requires_checked_operand_correspondence");
}
fn fixed_owner_array_preserves_other_obligation() void {
    ownership_raw_bytes_env.env mut e = {};
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes_env.owner_setup(&e, 315, false);
    types.node* owner_type = e.selected_type;
    ownership_api.projection[1] mut index = {};
    index[0].kind = ownership_api.projection_kind.fixed_index;
    index[0].index = ownership_raw_bytes_env.exact(0);
    ownership_api.place_path mut first = ownership_raw_bytes_env.place(&e, 1);
    first.projections = index[..];
    first = ownership_state.copy_place(&e.core, first);
    e.first = ownership_raw_bytes_env.at_place(&e, e.first, first);
    e.core.contents[0] = ownership_state.copy_contents(&e.core, e.first);
    e.core.allocations[0].owner.place = ownership_state.copy_place(&e.core, first);
    index[0].index = ownership_raw_bytes_env.exact(1);
    ownership_api.place_path mut second = ownership_raw_bytes_env.place(&e, 1);
    second.projections = index[..];
    second = ownership_state.copy_place(&e.core, second);
    ownership_api.contents_fact empty = ownership_transfer.empty_value(second);
    ownership_state.append_contents(&e.core, empty);
    ownership_raw_bytes_env.recapture(&e, types.type_array(&e.table, owner_type, 2), 16);
    ownership_raw_bytes.byte_effect mut seed = ownership_raw_bytes_env.effect(&e,
        ownership_raw_bytes.effect_kind.seed,
        ownership_raw_bytes_env.window(&e, 1, 8, 16, owner_type));
    seed.selected.place = second;
    seed.value = empty;
    seed.checked_value = true;
    ownership_raw_bytes_env.apply(&e, seed, 2688);
    ownership_raw_bytes_env.zero(&e, 1, 8, 16, 2689);
    assert(e.paired.states[0].core->allocations[0].obligation);
    assert(ownership_state.same_place(e.paired.states[0].core->allocations[0].owner.place, first));
    ownership_raw.request req = ownership_raw_bytes_env.request(&e, 2692);
    ownership_raw_bytes.window mut selected = seed.selected;
    ownership_raw_bytes_env.reset_budget(&e);
    ownership_raw_bytes.reference_result mut out = ownership_raw_bytes.read_reference(
        &e.paired.states[0], &e.service, selected, &req);
    defer ownership_raw_bytes.free_reference(&out);
    assert(ownership_api.successful(out.proof) && ownership_transfer.empty_owner_proved(out.value));
    println("unit-owner fixed_owner_array_preserves_other_obligation");
}

fn repair_marks(u32 kind) void {
    ownership_raw_bytes_env.env mut e = {};
    defer ownership_raw_bytes_env.close(&e);
    string[5] declarations = {
        "struct record { u8@ own owner; u8 mut@ view; } fn main() i32 { return 0; }\n",
        "struct record { u8@ own owner; u8 mut* view; } fn main() i32 { return 0; }\n",
        "struct record { u8@ own owner; u8 mut*@ view; } fn main() i32 { return 0; }\n",
        "struct record { u8@ own owner; u8 mut@[1] view; } fn main() i32 { return 0; }\n",
        "struct record { u8@ own owner; u8 mut@ view; } fn main() i32 { return 0; }\n"};
    u32 layout = kind < 5 ? kind : 0;
    bool permitted = kind >= 6;
    ownership_raw_bytes_env.aggregate_setup_as(&e, 400 + kind, false, false, permitted ?
        "struct record { u8@ own owner; u8@ view; } fn main() i32 { return 0; }\n" :
        declarations[layout]);
    types.node* mut original = e.span;
    if (kind == 1) { original = e.pointer; }
    if (kind == 2) { original = types.type_span(&e.table, e.pointer, false, false); }
    if (kind == 4) { original = e.string_type; }
    if (permitted) { original = types.type_span(&e.table, e.byte, false, true); }
    u64 bytes = kind == 1 ? 8 : 16;
    ownership_raw_bytes.byte_effect mut seed = ownership_raw_bytes_env.effect(&e,
        ownership_raw_bytes.effect_kind.seed,
        ownership_raw_bytes_env.window(&e, 3, 16, 16 + bytes, original));
    seed.selected.place = ownership_raw_bytes_env.view_field(&e, 3, kind == 3);
    seed.value = ownership_raw_bytes_env.at_place(&e, e.second, seed.selected.place);
    seed.checked_value = true;
    ownership_raw_bytes_env.apply(&e, seed, 2801);
    ownership_raw_bytes_env.read(&e, 3, 16, 16 + bytes, 80, 2802);
    ownership_raw_bytes_env.write(&e, 1, 16, 16 + bytes, 80, 0, 2803);
    ownership_raw_bytes.result mut before = ownership_raw_bytes_env.clone_input(&e);
    defer ownership_raw_bytes.free_result(&before);
    if (kind == 5) {
        types.node* mutable = types.type_span(&e.table, e.byte, false, true);
        ownership_raw_bytes.window mut selected = ownership_raw_bytes_env.window(&e,
            1, 16, 32, mutable);
        selected.place = ownership_raw_bytes_env.field(&e, 1, 1);
        ownership_raw.request req = ownership_raw_bytes_env.request(&e, 2804);
        ownership_raw_bytes.reference_result mut out = ownership_raw_bytes.read_reference(
            &e.paired.states[0], &e.service, selected, &req);
        defer ownership_raw_bytes.free_reference(&out);
        assert(!ownership_api.successful(out.proof));
        assert(e.budget.last_event.text ==
            "byte interpretation cannot add reference marks or ownership");
    } else {
        ownership_raw_bytes.result mut moved = ownership_raw_bytes_env.try_move(&e,
            1, 2, kind == 1 ? 24 : 32, 2805);
        if (!permitted) {
            assert(!ownership_api.successful(moved.proof) && moved.states.len == 0);
            assert(moved.proof.kind == ownership_api.proof_kind.incomplete);
            assert(e.budget.last_event.text == "local ownership effect needs a proved fact");
            assert(!e.budget.witness_validated);
            ownership_raw_bytes.free_result(&moved);
        } else {
            ownership_raw_bytes_env.take(&e, &moved);
            ownership_raw_bytes.window mut selected = ownership_raw_bytes_env.window(&e,
                2, 16, 32, e.span);
            selected.place = ownership_raw_bytes_env.field(&e, 2, 1);
            if (kind == 7) {
                ownership_api.contents_fact owner = ownership_raw_bytes_env.value(&e,
                    11, 11, 2, 0, 12, 12);
                ownership_state.append_contents(e.paired.states[0].core, owner);
                ownership_raw.request mut release = ownership_raw_bytes_env.request(&e, 2806);
                release.base.kind = ownership_transfer.action.release;
                release.base.source = ownership_raw_bytes_env.place(&e, 11);
                release.base.leaves_empty_proved = true;
                ownership_raw_bytes_env.reset_budget(&e);
                assert(ownership_api.successful(ownership_transfer.apply(e.paired.states[0].core,
                    &e.service, &release.base)));
            }
            ownership_raw.request req = ownership_raw_bytes_env.request(&e, 2807);
            ownership_raw_bytes.reference_result mut out = ownership_raw_bytes.read_reference(
                &e.paired.states[0], &e.service, selected, &req);
            defer ownership_raw_bytes.free_reference(&out);
            if (kind == 7) {
                assert(!ownership_api.successful(out.proof));
                assert(e.budget.last_event.text == "raw source is no longer live");
            } else {
                assert(ownership_api.successful(out.proof));
                assert(out.value.borrows[0].source.ordinal == 2);
                assert(out.value.borrows[0].range.access.begin.value == 0);
                assert(out.value.borrows[0].range.access.end.value ==
                    seed.value.borrows[0].range.access.end.value);
                // A second move retains the original mutable byte marks.
                ownership_raw_bytes.result mut again = ownership_raw_bytes_env.try_move(&e,
                    2, 1, 32, 2808);
                ownership_raw_bytes_env.take(&e, &again);
                assert(e.paired.states[0].bytes.representations[1].fragments[0].original_type ==
                    original);
            }
        }
    }
    if (!permitted) { ownership_raw_bytes_env.same(&e, &before.states[0]); }
    println("repair marks ", kind);
}
fn repair_owner_evidence(bool release, u32 test_case) void {
    ownership_raw_bytes_env.env mut e = {};
    defer ownership_raw_bytes_env.close(&e);
    if (release) {
        ownership_raw_bytes_env.aggregate_setup(&e, 420 + test_case, false, false);
        ownership_raw_bytes_env.descendants(&e, false);
    } else { ownership_raw_bytes_env.owner_setup(&e, 440 + test_case, false); }
    u32[6] combinations = {2, 4, 6, 3, 5, 7};
    u32 bits = test_case < 6 ? combinations[test_case] : (test_case == 9 ? 1 : 0);
    ownership_api.allocation_fact mut* owner = &e.paired.states[0].core->allocations[0];
    owner->count.zero = bits % 2 == 1;
    owner->count.one = (bits / 2) % 2 == 1;
    owner->count.many = (bits / 4) % 2 == 1;
    if (test_case == 6) {
        owner->obligation = false;
        if (!release) { e.paired.states[0].core->contents[0] =
            ownership_transfer.empty_value(ownership_raw_bytes_env.place(&e, 1)); }
    }
    if (test_case == 7) {
        owner->count.one = true;
        ownership_api.projection[1] mut part = {};
        part[0].kind = ownership_api.projection_kind.residual;
        ownership_api.place_path mut path = ownership_raw_bytes_env.place(&e, 1);
        path.projections = part[..];
        owner->owner.place = ownership_state.copy_place(e.paired.states[0].core, path);
    }
    ownership_raw_bytes.result mut before = ownership_raw_bytes_env.clone_input(&e);
    defer ownership_raw_bytes.free_result(&before);
    ownership_api.proof_status mut proof = {};
    if (release) {
        ownership_raw_bytes.window selected = ownership_raw_bytes_env.erased_window(&e, 2820);
        ownership_raw.request req = ownership_raw_bytes_env.request(&e, 2821);
        ownership_raw_bytes_env.reset_budget(&e);
        proof = ownership_raw_bytes.check_shallow_release(&e.paired.states[0],
            &e.service, selected, &req);
    } else {
        ownership_raw_bytes.result mut out = ownership_raw_bytes_env.try_effect(&e,
            ownership_raw_bytes_env.zero_change(&e, 1, 0, 8), 2822);
        proof = out.proof;
        ownership_raw_bytes.free_result(&out);
    }
    bool definite = test_case < 3;
    if (test_case == 6) { assert(ownership_api.successful(proof)); }
    else {
        assert(!ownership_api.successful(proof));
        assert((proof.kind == ownership_api.proof_kind.complete) == definite);
        assert(e.budget.witness_validated == definite);
        assert(e.budget.last_event.evidence == (definite ?
            ownership_api.evidence_kind.unconditional :
            ownership_api.evidence_kind.abstract_possibility));
        string text = release ? "shallow release retains an owned descendant" :
            (test_case == 7 ? "owner overlap remains unproved" :
            "byte write would discard a live owner");
        assert(e.budget.last_event.text == text);
    }
    ownership_raw_bytes_env.same(&e, &before.states[0]);
    println("repair owner-evidence ", release, " ", test_case);
}
fn repair_empty_interval(u32 mode, bool seeded, u32 position, bool repeated) void {
    ownership_raw_bytes_env.env mut e = {};
    defer ownership_raw_bytes_env.close(&e);
    if (seeded) { ownership_raw_bytes_env.owner_setup(&e, 460 + mode, false); }
    else { ownership_raw_bytes_env.setup(&e, 470 + mode, 0, true); }
    if (repeated) { e.paired.states[0].raw.origins[0].count = ownership_raw.literal(2); }
    if (mode == 2) { ownership_raw_bytes_env.read(&e, 3, 0, 0, 82, 2830); }
    ownership_raw_bytes.result mut before = ownership_raw_bytes_env.clone_input(&e);
    defer ownership_raw_bytes.free_result(&before);
    u64 point = position == 0 ? 0 : (position == 1 ? 3 : 8);
    ownership_raw_bytes.effect_kind kind = mode == 0 ? ownership_raw_bytes.effect_kind.zero :
        (mode == 1 ? ownership_raw_bytes.effect_kind.unknown :
        ownership_raw_bytes.effect_kind.write);
    ownership_raw_bytes.byte_effect mut effect = ownership_raw_bytes_env.effect(&e, kind,
        ownership_raw_bytes_env.window(&e, 1, point, point, e.byte));
    effect.snapshot_key = 82;
    u64 events = e.budget.events;
    ownership_raw_bytes.result mut out = ownership_raw_bytes_env.try_effect(&e, effect, 2831);
    assert(ownership_api.successful(out.proof) && e.budget.events == events);
    ownership_raw_bytes_env.take(&e, &out);
    ownership_raw_bytes_env.same(&e, &before.states[0]);
    assert(e.paired.states[0].core->allocations[0].obligation);
    println("repair empty-interval ", mode, " ", seeded, " ", position, " ", repeated);
}
fn repair_zero_recovery(bool seeded, bool transferred, bool whole, bool restore) void {
    ownership_raw_bytes_env.env mut e = {};
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes_env.owner_setup(&e, 480, false);
    if (transferred) {
        ownership_raw_bytes.result mut moved = ownership_raw_bytes_env.try_move(&e, 1, 2, 8, 2840);
        ownership_raw_bytes_env.take(&e, &moved);
    } else { ownership_raw_bytes_env.empty_source(&e); }
    if (!seeded) { ownership_raw_bytes.free_ledger(&e.paired.states[0].bytes); }
    ownership_raw_bytes_env.unknown(&e, 1, whole ? 0 : 3, whole ? 8 : 4, 2841);
    ownership_raw_bytes.result mut before = ownership_raw_bytes_env.clone_input(&e);
    defer ownership_raw_bytes.free_result(&before);
    if (!restore) {
        ownership_raw_bytes.reference_result mut out = ownership_raw_bytes_env.reference(&e,
            1, 0, 8, e.selected_type, 2842);
        defer ownership_raw_bytes.free_reference(&out);
        assert(!ownership_api.successful(out.proof));
        assert(e.budget.last_event.text == "reference representation correspondence is incomplete");
        ownership_raw_bytes_env.same(&e, &before.states[0]);
    } else {
        ownership_raw_bytes_env.zero(&e, 1, 0, 8, 2843);
        assert(ownership_transfer.owner_count(e.paired.states[0].core,
            ownership_raw_bytes_env.place(&e, 1)) == 0);
        u64 found = ownership_transfer.contents_index(e.paired.states[0].core,
            ownership_raw_bytes_env.place(&e, 1));
        assert(found != ownership_raw_bytes.U64_MAX);
        assert(ownership_transfer.empty_owner_proved(e.paired.states[0].core->contents[found]));
        if (!seeded) { ownership_raw_bytes_env.seed(&e, 1, 0, 8, e.selected_type,
            e.paired.states[0].core->contents[found], true, 2844); }
        ownership_raw_bytes.reference_result mut out = ownership_raw_bytes_env.reference(&e,
            1, 0, 8, e.selected_type, 2845);
        defer ownership_raw_bytes.free_reference(&out);
        assert(ownership_api.successful(out.proof));
        assert(ownership_transfer.empty_owner_proved(out.value));
        assert(e.paired.states[0].bytes.facts.contents_len == 1);
    }
    println("repair zero-recovery ", seeded, " ", transferred, " ", whole, " ", restore);
}
fn repair_uncertain_descendant(u32 kind) void {
    ownership_raw_bytes_env.env mut e = {};
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes_env.aggregate_setup(&e, 490 + kind, false, false);
    ownership_raw_bytes_env.descendants(&e, false);
    ownership_api.projection[1] mut part = {};
    part[0].kind = kind == 0 ? ownership_api.projection_kind.dereference :
        (kind == 1 ? ownership_api.projection_kind.captured_index :
        ownership_api.projection_kind.fixed_index);
    ownership_api.place_path mut path = ownership_raw_bytes_env.place(&e, 1);
    path.projections = part[..];
    e.paired.states[0].core->allocations[0].owner.place =
        ownership_state.copy_place(e.paired.states[0].core, path);
    if (kind == 3) {
        part[0].index = ownership_raw_bytes_env.exact(0);
        path.projections = part[..];
        e.paired.states[0].core->allocations[0].owner.place =
            ownership_state.copy_place(e.paired.states[0].core, path);
        e.paired.states[0].core->allocations[0].validity = ownership_api.validity_kind.released;
    }
    ownership_raw_bytes.result mut before = ownership_raw_bytes_env.clone_input(&e);
    defer ownership_raw_bytes.free_result(&before);
    ownership_raw_bytes.window selected = ownership_raw_bytes_env.erased_window(&e, 2850);
    ownership_raw.request req = ownership_raw_bytes_env.request(&e, 2851);
    ownership_raw_bytes_env.reset_budget(&e);
    ownership_api.proof_status proof = ownership_raw_bytes.check_shallow_release(
        &e.paired.states[0], &e.service, selected, &req);
    assert(proof.kind == ownership_api.proof_kind.incomplete && !e.budget.witness_validated);
    assert(e.budget.last_event.text == "shallow release retains an owned descendant");
    ownership_raw_bytes_env.same(&e, &before.states[0]);
    println("repair uncertain-descendant ", kind);
}
fn repair_unproved_empty_flag() void {
    ownership_raw_bytes_env.env mut e = {};
