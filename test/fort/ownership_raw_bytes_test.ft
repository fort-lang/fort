/// Tests ordered byte correspondence without owner transfer.
import ownership_api;
import ownership_places;
import ownership_keys;
import ownership_raw;
import ownership_raw_bytes;
import ownership_raw_bytes_env;
import ownership_raw_bytes_cleanup_env;
import ownership_state;
import ownership_transfer;
import types;

fn b01_complete_borrowed_pointer_copy() void {
    ownership_raw_bytes_env.env mut e = {};
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes_env.setup(&e, 1, 0, false);
    ownership_raw_bytes_env.initial(&e, 0, 113);
    ownership_raw_bytes_env.copy_complete(&e, 8, 114);
    ownership_raw_bytes.reference_result mut out =
        ownership_raw_bytes_env.reference(&e, 2, 0, 8, e.pointer, 116);
    defer ownership_raw_bytes.free_reference(&out);
    ownership_raw_bytes_env.accepts(&out, &e, 1, 1, 2, 6);
    println("required B01.complete_borrowed_pointer_copy accept");
}

fn b02_complete_span_header() void {
    ownership_raw_bytes_env.env mut e = {};
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes_env.setup(&e, 2, 1, false);
    ownership_raw_bytes_env.initial(&e, 1, 126);
    ownership_raw_bytes_env.copy_complete(&e, 16, 127);
    ownership_raw_bytes.reference_result mut out =
        ownership_raw_bytes_env.reference(&e, 2, 0, 16, e.span, 129);
    defer ownership_raw_bytes.free_reference(&out);
    ownership_raw_bytes_env.accepts(&out, &e, 1, 1, 2, 6);
    assert(out.value.span_length.value == 4);
    println("required B02.complete_span_header accept");
}

fn b02_complete_string_header() void {
    ownership_raw_bytes_env.env mut e = {};
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes_env.setup(&e, 3, 2, false);
    ownership_raw_bytes_env.initial(&e, 2, 140);
    ownership_raw_bytes_env.copy_complete(&e, 16, 141);
    ownership_raw_bytes.reference_result mut out =
        ownership_raw_bytes_env.reference(&e, 2, 0, 16, e.string_type, 143);
    defer ownership_raw_bytes.free_reference(&out);
    ownership_raw_bytes_env.accepts(&out, &e, 1, 1, 2, 6);
    assert(out.value.span_length.value == 4);
    println("required B02.complete_string_header accept");
}

fn b03_mixed_pointer_length_versions() void {
    ownership_raw_bytes_env.env mut e = {};
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes_env.setup(&e, 4, 1, false);
    ownership_raw_bytes_env.initial(&e, 1, 154);
    ownership_raw_bytes_env.read(&e, 1, 0, 8, 1, 155);
    ownership_raw_bytes_env.read(&e, 3, 8, 16, 2, 156);
    ownership_raw_bytes_env.write(&e, 2, 0, 8, 1, 0, 157);
    ownership_raw_bytes_env.write(&e, 2, 8, 16, 2, 0, 158);
    ownership_raw_bytes.reference_result mut out =
        ownership_raw_bytes_env.reference(&e, 2, 0, 16, e.span, 160);
    defer ownership_raw_bytes.free_reference(&out);
    ownership_raw_bytes_env.rejects(&out);
    println("required B03.mixed_pointer_length_versions reject");
}

fn b03_mixed_pointer_bytes() void {
    ownership_raw_bytes_env.env mut e = {};
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes_env.setup(&e, 5, 0, false);
    ownership_raw_bytes_env.initial(&e, 0, 170);
    ownership_raw_bytes_env.read(&e, 1, 0, 4, 1, 171);
    ownership_raw_bytes_env.read(&e, 3, 4, 8, 2, 172);
    ownership_raw_bytes_env.write(&e, 2, 0, 4, 1, 0, 173);
    ownership_raw_bytes_env.write(&e, 2, 4, 8, 2, 0, 174);
    ownership_raw_bytes.reference_result mut out =
        ownership_raw_bytes_env.reference(&e, 2, 0, 8, e.pointer, 176);
    defer ownership_raw_bytes.free_reference(&out);
    ownership_raw_bytes_env.rejects(&out);
    println("required B03.mixed_pointer_bytes reject");
}

fn b04_partial_borrow_write_alone() void {
    ownership_raw_bytes_env.env mut e = {};
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes_env.setup(&e, 6, 0, false);
    ownership_raw_bytes_env.initial(&e, 0, 186);
    ownership_raw_bytes_env.unknown(&e, 1, 3, 4, 187);
    assert(e.paired.states[0].bytes.representations[0].fragments_len == 2);
    assert(e.paired.states[0].core->contents[0].kind == ownership_api.contents_kind.unknown);
    assert(e.paired.states[0].core->allocations[0].obligation);
    println("required B04.partial_borrow_write_alone accept");
}

fn b04_partial_borrow_read() void {
    ownership_raw_bytes_env.env mut e = {};
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes_env.setup(&e, 7, 0, false);
    ownership_raw_bytes_env.initial(&e, 0, 198);
    ownership_raw_bytes_env.unknown(&e, 1, 3, 4, 199);
    ownership_raw_bytes.reference_result mut out =
        ownership_raw_bytes_env.reference(&e, 1, 0, 8, e.pointer, 201);
    defer ownership_raw_bytes.free_reference(&out);
    ownership_raw_bytes_env.rejects(&out);
    println("required B04.partial_borrow_read reject");
}

fn b04_partial_borrow_escape() void {
    ownership_raw_bytes_env.env mut e = {};
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes_env.setup(&e, 8, 0, false);
    ownership_raw_bytes_env.initial(&e, 0, 211);
    ownership_raw_bytes_env.unknown(&e, 1, 3, 4, 212);
    ownership_raw.request req = ownership_raw_bytes_env.request(&e, 213);
    ownership_api.proof_status proof = ownership_transfer.check_read(e.paired.states[0].core,
        &e.service, &req.base, e.paired.states[0].core->contents[0], false);
    assert(!ownership_api.successful(proof));
    ownership_raw_bytes.reference_result mut out =
        ownership_raw_bytes_env.reference(&e, 1, 0, 8, e.pointer, 218);
    defer ownership_raw_bytes.free_reference(&out);
    ownership_raw_bytes_env.rejects(&out);
    println("required B04.partial_borrow_escape reject");
}

fn b05_unchanged_borrow_fragment() void {
    ownership_raw_bytes_env.env mut e = {};
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes_env.setup(&e, 9, 0, false);
    ownership_raw_bytes_env.initial(&e, 0, 228);
    ownership_raw_bytes_env.read(&e, 1, 2, 5, 1, 229);
    ownership_raw_bytes_env.write(&e, 1, 2, 5, 1, 0, 230);
    ownership_raw_bytes.reference_result mut out =
        ownership_raw_bytes_env.reference(&e, 1, 0, 8, e.selected_type, 232);
    defer ownership_raw_bytes.free_reference(&out);
    ownership_raw_bytes_env.accepts(&out, &e, 1, 1, 2, 6);
    assert(e.paired.states[0].core->allocations[0].history.len == 1);
    assert(e.paired.states[0].core->allocations[0].validity == ownership_api.validity_kind.live);
    println("required B05.unchanged_borrow_fragment accept");
}

fn b05_unchanged_owner_fragment() void {
    ownership_raw_bytes_env.env mut e = {};
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes_env.setup(&e, 10, 0, true);
    assert(ownership_transfer.owner_reference_proved(e.paired.states[0].core,
        e.paired.states[0].core->contents[0], e.paired.states[0].core->allocations[0]));
    ownership_raw_bytes_env.initial(&e, 0, 246);
    ownership_raw_bytes_env.read(&e, 1, 2, 5, 1, 247);
    ownership_raw_bytes_env.write(&e, 1, 2, 5, 1, 0, 248);
    ownership_raw_bytes.reference_result mut out =
        ownership_raw_bytes_env.reference(&e, 1, 0, 8, e.selected_type, 250);
    defer ownership_raw_bytes.free_reference(&out);
    ownership_raw_bytes_env.accepts(&out, &e, 1, 1, 0, 12);
    assert(e.paired.states[0].core->allocations[0].history.len == 1);
    assert(e.paired.states[0].core->allocations[0].validity == ownership_api.validity_kind.live);
    println("required B05.unchanged_owner_fragment accept");
}

fn b06_split_pointer_rebuild() void {
    ownership_raw_bytes_env.env mut e = {};
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes_env.setup(&e, 11, 0, false);
    ownership_raw_bytes_env.initial(&e, 0, 262);
    ownership_raw_bytes_env.read(&e, 1, 0, 3, 1, 263);
    ownership_raw_bytes_env.read(&e, 1, 3, 8, 2, 264);
    ownership_raw_bytes_env.write(&e, 2, 3, 8, 2, 0, 265);
    ownership_raw_bytes_env.write(&e, 2, 0, 3, 1, 0, 266);
    ownership_raw_bytes.reference_result mut out =
        ownership_raw_bytes_env.reference(&e, 2, 0, 8, e.pointer, 268);
    defer ownership_raw_bytes.free_reference(&out);
    ownership_raw_bytes_env.accepts(&out, &e, 1, 1, 2, 6);
    println("required B06.split_pointer_rebuild accept");
}

