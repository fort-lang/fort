    assert(e.budget.meter.used.w > used && ownership_api.successful(proof));
    println("unit-storage repeated_comparisons_charge_work");
}

fn interpretation_cannot_add_owner() void {
    ownership_raw_bytes_env.env mut e = {};
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes_env.setup(&e, 206, 0, false);
    ownership_raw_bytes_env.initial(&e, 0, 1300);
    ownership_raw_bytes_env.copy_complete(&e, 8, 1301);
    types.node* selected = types.type_ptr(&e.table, e.byte, true, false);
    ownership_raw_bytes.reference_result mut out =
        ownership_raw_bytes_env.reference(&e, 2, 0, 8, selected, 1304);
    defer ownership_raw_bytes.free_reference(&out);
    ownership_raw_bytes_env.rejects(&out);
    assert(e.paired.states[0].core->allocations[0].obligation);
    println("unit-storage interpretation_cannot_add_owner");
}

