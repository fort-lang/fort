fn owner_rejection(ownership_raw_bytes_env.env mut* e,
    ownership_raw_bytes.byte_effect change, u32 line) void {
    ownership_raw_bytes.result mut before = ownership_raw_bytes_env.clone_input(e);
    defer ownership_raw_bytes.free_result(&before);
    ownership_raw_bytes.result mut out = ownership_raw_bytes_env.try_effect(e, change, line);
    defer ownership_raw_bytes.free_result(&out);
    assert(!ownership_api.successful(out.proof) && out.proof.failed && out.states.len == 0);
    assert(e->paired.states[0].core->allocations[0].obligation);
    ownership_raw_bytes_env.same(e, &before.states[0]);
}
fn b08_raw_owner_copy_to_empty_owner() void {
    ownership_raw_bytes_env.env mut e = {};
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes_env.owner_setup(&e, 17, false);
    ownership_raw_bytes_env.read(&e, 1, 0, 8, 7, 2101);
    ownership_raw_bytes.byte_effect mut change = ownership_raw_bytes_env.effect(&e,
        ownership_raw_bytes.effect_kind.write,
        ownership_raw_bytes_env.window(&e, 2, 0, 8, e.byte));
    change.snapshot_key = 7;
    owner_rejection(&e, change, 2105);
    u64 index = ownership_transfer.contents_index(e.paired.states[0].core,
        ownership_raw_bytes_env.place(&e, 2));
    assert(ownership_transfer.empty_owner_proved(e.paired.states[0].core->contents[index]));
    assert(ownership_transfer.owner_count(e.paired.states[0].core,
        ownership_raw_bytes_env.place(&e, 2)) == 0);
    println("required B08.raw_owner_copy_to_empty_owner reject");
}
