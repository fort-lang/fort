//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: types.type_layout_struct: too few offset slots
//! stdout:
//| true
import types;
import types_env;

/// The C writes the offsets through a bare pointer and cannot see the caller's
/// room. A span carries its length, so a short one is a broken precondition
/// here rather than a store past the end there.
fn main() i32 {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node*[2] mut fields = {types_env.type_of(&e, "i32"), types_env.type_of(&e, "i32")};
    u64[1] mut offsets = {};
    println(types.type_layout_begin(e.rec));
    println(types.type_layout_struct(e.rec, fields[..], offsets[..]));
    return 0;
}
