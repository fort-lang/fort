//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: consts.cv_compare: constant comparison across kinds
//! stdout:
//| 0
import consts;

/// Checks that folding rejects comparisons of nonconstant values. The value kind none marks an
/// expression that is not constant.
fn main() i32 {
    println(consts.cv_none().mag);
    println(consts.cv_compare(consts.cv_rel.cv_rel_ne, consts.cv_none(), consts.cv_none()).mag);
    return 0;
}
