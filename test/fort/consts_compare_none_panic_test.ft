//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: consts.cv_compare: constant comparison across kinds
//! stdout:
//| 0
import consts;

// "none" is the value of an expression that is not constant, so nothing is
// ever compared with it: folding a comparison of two of them is a broken
// precondition.
// D4.6, D13.3
fn i32 main() {
    println(consts.cv_none().mag);
    println(consts.cv_compare(consts.cv_rel.cv_rel_ne, consts.cv_none(), consts.cv_none()).mag);
    return 0;
}
