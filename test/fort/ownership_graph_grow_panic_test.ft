//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: ownership_graph: capacity overflow
//! stdout:
//| 16
/// grow doubles a capacity. A capacity above U64_MAX / 2 has no double in u64, so the call
/// panics before the multiplication, which would trap.
import ownership_graph;

fn main() i32 {
    println(ownership_graph.grow(8));
    ownership_graph.grow(ownership_graph.U64_MAX);
    return 0;
}
