//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| statuses ok
//| reasons ok
//| outcomes ok
//| rendering ok
//| computation bounds ok
/// Checks report outcomes and supplementary report-rendering boundary controls.
import diag;
import json;
import ownership_api;
import ownership_events;
import ownership_limits;
import ownership_report;
import ownership_source;
import ownership_source_env;
import std.str;
import std.strbuf;

fn proof_failure_flag_does_not_mean_internal_failure() void {
    ownership_api.proof_status mut proof = ownership_api.incomplete(
        ownership_api.incomplete_reason.source_coverage, ownership_api.operation_position{},
        ownership_api.source_position{});
    assert(proof.failed);
    assert(ownership_report.proof_status(proof) == "incomplete");
    proof.terminal.reason = ownership_api.incomplete_reason.invalid_input;
    assert(ownership_report.proof_status(proof) == "failed");
    assert(ownership_report.proof_status(ownership_api.proof_status{}) == "unexecuted");
    assert(ownership_report.proof_status(ownership_api.proof_status{
        .kind = ownership_api.proof_kind.complete}) == "complete");
}

fn zero_bodies_retain_missing_producers_and_no_body_meter() void {
    ownership_source_env.env mut e = ownership_source_env.env{};
    ownership_source_env.open(&e);
    defer ownership_source_env.close(&e);
    assert(ownership_source_env.prepare(&e, "i32 VALUE = 1;\n"));
    ownership_source.analyze(&e.source);
    assert(e.source.bodies.len == 0);
    assert(ownership_report.verdict(&e.source) == 1);
    // The local and raw analyses have no closure facts outside bodies, so no body means no
    // gap of theirs. Each analysis without a producer stays incomplete.
    assert(ownership_report.closure_status(&e.source, ownership_report.LOCAL) == "complete");
    assert(ownership_report.closure_status(&e.source, ownership_report.RAW) == "complete");
    u64 mut stage = ownership_report.STORED_BORROWS;
    while (stage < ownership_report.ANALYSIS_COUNT) {
        if (!ownership_report.integrated(stage)) {
            assert(ownership_report.closure_status(&e.source, stage) == "incomplete");
        }
        stage += 1;
    }
    diag.sink mut diagnostics = diag.sink{};
    defer diag.free(&diagnostics);
    ownership_report.diagnose(&e.source, &diagnostics, "main.ft");
    assert(diag.count(&diagnostics) == 1);
    strbuf.str_buf mut out = strbuf.create();
    defer strbuf.free(&out);
    ownership_report.invocation call = ownership_report.invocation{};
    ownership_report.build(&out, &e.source, &call, 1);
    assert(str.find(strbuf.view(&out), "\"name\":\"services\"") < 0);
    assert(str.find(strbuf.view(&out), "\"bodies\":[]") >= 0);
    assert(str.find(strbuf.view(&out), "\"producer\":\"unavailable\"") >= 0);
}

fn failure_before_any_body_ledger_keeps_unexecuted_analyses() void {
    ownership_source_env.env mut e = ownership_source_env.env{};
    ownership_source_env.open(&e);
    defer ownership_source_env.close(&e);
    assert(!ownership_source_env.prepare(&e, "fn bad() void { missing(); }\n"));
    ownership_source.analyze(&e.source);
    ownership_source.body* row = &e.source.bodies[0];
    assert(!row->live.initialized);
    assert(ownership_report.body_ownership(row) == "failed");
    u64 mut stage = 0;
    while (stage < ownership_report.ANALYSIS_COUNT) {
        assert(ownership_report.analysis_status(row, stage, 0) == "unexecuted");
        assert(ownership_report.analysis_status(row, stage, 1) == "unexecuted");
        assert(ownership_report.analysis_status(row, stage, 2) == "unexecuted");
        stage += 1;
    }
    assert(ownership_report.failure(&e.source, 1).code == "source_error");
    diag.sink mut diagnostics = diag.sink{};
    defer diag.free(&diagnostics);
    ownership_report.diagnose(&e.source, &diagnostics, "main.ft");
    assert(diag.count(&diagnostics) == 1);
    assert(row->live.events.budget.used.v == 0);
}

// The first analysis without a producer gives the reason when the earlier ones have none.
fn missing_reason_uses_an_explicit_missing_producer() void {
    ownership_source_env.env mut e = ownership_source_env.env{};
    ownership_source_env.open(&e);
    defer ownership_source_env.close(&e);
    assert(ownership_source_env.prepare(&e, "fn root() void {}\n"));
    ownership_source.analyze(&e.source);
    ownership_source.body mut* row = &e.source.bodies[0];
    row->first_incomplete = ownership_api.proof_status{};
    assert(ownership_report.analysis_status(row, ownership_report.LOCAL, 2) == "complete");
    assert(ownership_report.analysis_status(row, ownership_report.STORED_BORROWS, 2) ==
        "complete");
    assert(ownership_report.analysis_status(row, ownership_report.RAW, 2) == "complete");
    ownership_report.reason why = ownership_report.body_reason(row);
    assert(why.present && why.stage == "calls_heap" && why.code == "missing_producer");
    assert(why.source.filename_present && !why.limit.present);
    assert(why.source.line == 1 && why.source.col == 4);
}

// An incomplete local proof gives the body reason before the analyses without a producer.
fn local_reason_comes_before_a_missing_producer() void {
    ownership_source_env.env mut e = ownership_source_env.env{};
    ownership_source_env.open(&e);
    defer ownership_source_env.close(&e);
    ownership_source_env.runtime(&e);
    assert(ownership_source_env.prepare(&e,
        "fn root(bool c) void {\n    i32 mut* own p = new(i32);\n    if (c) { del(p); }\n}\n"));
    ownership_source.analyze(&e.source);
    ownership_source.body mut* row = ownership_source_env.find(&e, "main", "root");
    row->first_incomplete = ownership_api.proof_status{};
    assert(ownership_report.analysis_status(row, ownership_report.LOCAL, 2) == "incomplete");
    ownership_report.reason why = ownership_report.body_reason(row);
    assert(why.present && why.stage == "local" && why.code == "missing_path");
    assert(why.source.line == 4 && !why.limit.present);
    // A first reason of graph or liveness stays first.
    row->first_incomplete = ownership_api.incomplete(
        ownership_api.incomplete_reason.source_coverage,
        ownership_api.operation_position{.function = row->key}, row->source);
    assert(ownership_report.body_reason(row).stage == "liveness" ||
        ownership_report.body_reason(row).stage == "graph");
}

fn graph_refusal_keeps_the_original_category_counts_and_location() void {
    ownership_source_env.env mut e = ownership_source_env.env{};
    ownership_source_env.open(&e);
    defer ownership_source_env.close(&e);
    assert(ownership_source_env.prepare(&e, "fn root() void {}\n"));
    ownership_source.analyze(&e.source);
    ownership_source.body* row = &e.source.bodies[0];
    ownership_api.operation_position op = ownership_api.operation_position{.function = row->key};
    ownership_api.proof_status mut refusal = ownership_api.incomplete(
        ownership_api.incomplete_reason.work_limit, op, row->source);
    refusal.terminal.limit = ownership_api.exhaustion{
        .present = true, .category = ownership_api.limit_category.w,
        .scope = ownership_api.limit_scope.computation,
        .used = e.source.graph.limits.w, .bound = e.source.graph.limits.w,
        .operation = op, .source = row->source};
    e.source.graph_first_refusal = refusal;
    e.source.graph.work = e.source.graph.limits.w;
    ownership_report.reason why = ownership_report.first_incomplete(&e.source);
    assert(why.stage == "graph" && why.code == "work_limit");
    assert(why.limit.category == ownership_api.limit_category.w);
    assert(why.limit.used == why.limit.bound);
    assert(why.source.line == row->source.line && why.source.col == row->source.col);
    diag.sink mut diagnostics = diag.sink{};
    defer diag.free(&diagnostics);
    ownership_report.diagnose(&e.source, &diagnostics, "main.ft");
    assert(diag.count(&diagnostics) == 1);
    // The graph bound is the W bound of the closure's FIR size, not the base value.
    u64 bound = ownership_limits.work_bound(e.source.graph.fir_size);
    assert(e.source.graph.fir_size > 0 && e.source.graph.limits.w == bound);
    assert(bound > ownership_limits.PRODUCTION_W);
    strbuf.str_buf mut expected = strbuf.create();
    defer strbuf.free(&expected);
    strbuf.append(&expected, "ownership proof is incomplete (graph: work_limit; category W; used ");
    strbuf.append_u64(&expected, bound);
    strbuf.append(&expected, "; bound ");
    strbuf.append_u64(&expected, bound);
    strbuf.append(&expected, ")");
    assert(diag.record_at(&diagnostics, 0).msg == strbuf.view(&expected));
}

fn internal_verifier_failure_exits_two() void {
    ownership_source_env.env mut e = ownership_source_env.env{};
    ownership_source_env.open(&e);
    defer ownership_source_env.close(&e);
    assert(ownership_source_env.prepare(&e, "fn root() void {}\n"));
    e.source.bodies[0].verification = ownership_source.status.failed;
    ownership_source.analyze(&e.source);
    assert(ownership_report.verdict(&e.source) == 2);
    assert(ownership_report.failure(&e.source, 2).stage == "verification");
    assert(ownership_report.failure(&e.source, 2).code == "verification_failure");
    assert(ownership_report.body_ownership(&e.source.bodies[0]) == "failed");
}

fn unsupported_lowering_stays_a_source_rejection() void {
    ownership_source_env.env mut e = ownership_source_env.env{};
    ownership_source_env.open(&e);
    defer ownership_source_env.close(&e);
    assert(ownership_source_env.prepare(&e, "fn root() void { println(1); }\n"));
    ownership_source.analyze(&e.source);
    assert(ownership_report.verdict(&e.source) == 1);
    assert(ownership_report.failure(&e.source, 1).code == "unsupported_lowering");
}

fn internal_analysis_failure_wins_over_an_earlier_lowering_failure() void {
    ownership_source_env.env mut e = ownership_source_env.env{};
    ownership_source_env.open(&e);
    defer ownership_source_env.close(&e);
    assert(ownership_source_env.prepare(&e,
        "fn unsupported() void { println(1); }\nfn root() void {}\n"));
    ownership_source.analyze(&e.source);
    ownership_source.body mut* row = ownership_source_env.find(&e, "main", "root");
    row->liveness_proof = ownership_api.incomplete(ownership_api.incomplete_reason.invalid_input,
        ownership_api.operation_position{.function = row->key}, row->source);
    assert(ownership_report.verdict(&e.source) == 2);
    assert(ownership_report.failure(&e.source, 2).code == "analysis_failure");
    assert(ownership_report.failure(&e.source, 2).stage == "liveness");
    assert(e.source.bodies[0].lowering == ownership_source.status.failed);
    assert(ownership_report.body_ownership(row) == "failed");
}

fn later_tool_failure_updates_the_final_reason() void {
    ownership_source_env.env mut e = ownership_source_env.env{};
    ownership_source_env.open(&e);
    defer ownership_source_env.close(&e);
    assert(ownership_source_env.prepare(&e, "fn root() void {}\n"));
    ownership_source.analyze(&e.source);
    assert(!ownership_report.failure(&e.source, 1).present);
    assert(ownership_report.failure(&e.source, 2).stage == "tool");
    assert(ownership_report.failure(&e.source, 2).code == "tool_failure");
}

fn rendered_diagnostic_charges_the_existing_service_ledger() void {
    ownership_source_env.env mut e = ownership_source_env.env{};
    ownership_source_env.open(&e);
    defer ownership_source_env.close(&e);
    assert(ownership_source_env.prepare(&e, "fn root() void {}\n"));
    ownership_source.analyze(&e.source);
    ownership_source.body* row = &e.source.bodies[0];
    u64 before = row->live.events.budget.used.v;
    diag.sink mut diagnostics = diag.sink{};
    defer diag.free(&diagnostics);
    ownership_report.diagnose(&e.source, &diagnostics, "main.ft");
    assert(row->live.events.budget.used.v == before + 1);
    assert(row->live.events.rendered == 1);
    assert(diag.count(&diagnostics) == 1);
    assert(e.source.graph.work > 0);
    assert(!e.source.accounting_complete);
}

fn later_report_refusal_keeps_completed_solver_results() void {
    ownership_source_env.env mut e = ownership_source_env.env{};
    ownership_source_env.open(&e);
    defer ownership_source_env.close(&e);
    assert(ownership_source_env.prepare(&e, "fn root() void {}\n"));
    ownership_source.analyze(&e.source);
    ownership_source.body mut* row = &e.source.bodies[0];
    assert(row->liveness_solver == ownership_source.status.complete);
    row->live.events.budget.used.v = row->live.events.budget.bounds.v;
    row->live.events.rendered = row->live.events.budget.bounds.v;
    diag.sink mut diagnostics = diag.sink{};
    defer diag.free(&diagnostics);
    ownership_report.diagnose(&e.source, &diagnostics, "main.ft");
    assert(row->live.first_refusal.terminal.reason == ownership_api.incomplete_reason.report_limit);
    assert(row->live.first_refusal.terminal.limit.category == ownership_api.limit_category.v);
    assert(row->live.events.budget.used.v == row->live.events.budget.bounds.v);
    assert(row->liveness_solver == ownership_source.status.complete);
    assert(ownership_report.body_reason(row).present);
    assert(ownership_report.verdict(&e.source) == 1);
    assert(diag.count(&diagnostics) == 1);
    assert(row->live.events.rendered == row->live.events.budget.bounds.v);
    assert(row->live.events.terminal.present);
    assert(row->live.events.terminal.limit.used == row->live.events.budget.bounds.v);
    assert(row->live.events.terminal.limit.bound == row->live.events.budget.bounds.v);
    assert(diag.record_at(&diagnostics, 0).msg ==
        "ownership proof is incomplete (liveness: report_limit; category V; used 512; bound 512)");
    strbuf.str_buf mut out = strbuf.create();
    defer strbuf.free(&out);
    json.writer mut j = json.writer{};
    json.json_init(&j, &out);
    diag.write_json(&diagnostics, &j);
    assert(str.find(strbuf.view(&out),
        "liveness: report_limit; category V; used 512; bound 512") >= 0);
    ownership_api.terminal_failure original = row->live.events.terminal;
    diag.reset(&diagnostics);
    ownership_report.diagnose(&e.source, &diagnostics, "main.ft");
    assert(diag.count(&diagnostics) == 1);
    assert(row->live.events.rendered == row->live.events.budget.bounds.v);
    assert(row->live.events.terminal.source.line == original.source.line);
    assert(row->live.events.terminal.source.col == original.source.col);
    assert(row->live.events.terminal.limit.used == original.limit.used);
    assert(row->live.events.terminal.limit.bound == original.limit.bound);
}

fn minimum_report_bound_permits_its_last_normal_record() void {
    ownership_source_env.env mut e = ownership_source_env.env{};
    ownership_source_env.open(&e);
    defer ownership_source_env.close(&e);
    assert(ownership_source_env.prepare(&e, "fn root() void {}\n"));
    ownership_source.analyze(&e.source);
    ownership_source.body mut* row = &e.source.bodies[0];
    assert(row->live.events.budget.used.v == 0);
    row->live.events.budget.bounds.v = 1;
    diag.sink mut diagnostics = diag.sink{};
    defer diag.free(&diagnostics);
    ownership_report.diagnose(&e.source, &diagnostics, "main.ft");
    assert(diag.count(&diagnostics) == 1);
    assert(row->live.events.budget.used.v == 1);
    assert(row->live.events.rendered == 1);
    assert(!row->live.events.terminal.present);
    assert(str.find(diag.record_at(&diagnostics, 0).msg, "report_limit") < 0);
    assert(row->liveness_solver == ownership_source.status.complete);
}

fn report_refusal_keeps_the_first_work_reason_and_stops_later_rows() void {
    ownership_source_env.env mut e = ownership_source_env.env{};
    ownership_source_env.open(&e);
    defer ownership_source_env.close(&e);
    assert(ownership_source_env.prepare(&e, "fn first() void {}\nfn second() void {}\n"));
    ownership_source.analyze(&e.source);
    u64 mut i = 0;
    while (i < e.source.bodies.len) {
        ownership_source.body mut* row = &e.source.bodies[i];
        ownership_api.operation_position op = ownership_api.operation_position{
            .function = row->key};
        row->live.first_refusal = ownership_api.incomplete(
            ownership_api.incomplete_reason.work_limit, op, row->source);
        row->live.first_refusal.terminal.limit = ownership_api.exhaustion{
            .present = true, .category = ownership_api.limit_category.w,
            .scope = ownership_api.limit_scope.computation,
            .used = row->live.events.budget.bounds.w, .bound = row->live.events.budget.bounds.w,
            .operation = op, .source = row->source};
        row->live.events.budget.used.w = row->live.events.budget.bounds.w;
        row->live.events.budget.bounds.v = 1;
        i += 1;
    }
    ownership_source.body mut* first = &e.source.bodies[0];
    ownership_source.body* second = &e.source.bodies[1];
    diag.sink mut diagnostics = diag.sink{};
    defer diag.free(&diagnostics);
    ownership_report.diagnose(&e.source, &diagnostics, "main.ft");
    assert(diag.count(&diagnostics) == 2);
    assert(str.find(diag.record_at(&diagnostics, 0).msg, "report_limit") < 0);
    assert(diag.record_at(&diagnostics, 1).msg ==
        "ownership proof is incomplete (liveness: report_limit; category V; used 1; bound 1)");
    assert(first->live.events.budget.used.v == 1 && first->live.events.rendered == 1);
    assert(first->live.events.terminal.reason == ownership_api.incomplete_reason.report_limit);
    assert(first->live.events.terminal.source.line == first->source.line);
    assert(first->live.first_refusal.terminal.reason == ownership_api.incomplete_reason.work_limit);
    assert(first->live.first_refusal.terminal.limit.category == ownership_api.limit_category.w);
    assert(second->live.events.budget.used.v == 0 && second->live.events.rendered == 0);
    assert(!second->live.events.terminal.present);
    assert(first->liveness_solver == ownership_source.status.complete);
    assert(second->liveness_solver == ownership_source.status.complete);
    diag.reset(&diagnostics);
    ownership_report.diagnose(&e.source, &diagnostics, "main.ft");
    assert(diag.count(&diagnostics) == 1);
    assert(first->live.first_refusal.terminal.reason == ownership_api.incomplete_reason.work_limit);
    assert(first->live.events.terminal.source.line == first->source.line);
    assert(first->live.events.rendered == 1 && second->live.events.rendered == 0);
}

fn contains(strbuf.str_buf* text, string expected) void {
    if (str.find(strbuf.view(text), expected) < 0) {
        eprintln("missing: ", expected);
        assert(false);
    }
}

fn count_text(strbuf.str_buf mut* out, string category, string scope) void {
    strbuf.clear(out);
    strbuf.append(out, "{\"category\":\"");
    strbuf.append(out, category);
    strbuf.append(out, "\",\"scope\":\"");
    strbuf.append(out, scope);
    strbuf.append(out, "\",\"used\":");
}

// The report publishes W_scale, each ledger's FIR size, and the W bound that follows from both.
fn computation_bounds_are_published() void {
    ownership_source_env.env mut e = ownership_source_env.env{};
    ownership_source_env.open(&e);
    defer ownership_source_env.close(&e);
    assert(ownership_source_env.prepare(&e,
        "fn leaf() void {}\nfn root() void { i32 x = 1; leaf(); }\n"));
    ownership_source.analyze(&e.source);
    ownership_source.body mut* row = ownership_source_env.find(&e, "main", "root");
    ownership_source.body mut* leaf = ownership_source_env.find(&e, "main", "leaf");
    strbuf.str_buf mut out = strbuf.create();
    defer strbuf.free(&out);
    ownership_report.invocation call = ownership_report.invocation{};
    ownership_report.build(&out, &e.source, &call, 1);
    strbuf.str_buf mut expected = strbuf.create();
    defer strbuf.free(&expected);
    strbuf.append(&expected, "{\"kind\":\"fort-ownership-report\",\"version\":6,");
    contains(&out, strbuf.view(&expected));
    strbuf.clear(&expected);
    strbuf.append(&expected, "\"limits\":{\"version\":2,");
    contains(&out, strbuf.view(&expected));
    strbuf.clear(&expected);
    strbuf.append(&expected, "\"w\":65536,\"w_scale\":");
    strbuf.append_u64(&expected, ownership_limits.PRODUCTION_W_SCALE);
    strbuf.append(&expected, ",\"v\":512}");
    contains(&out, strbuf.view(&expected));
    u64[2] sizes = {e.source.graph.fir_size, row->live.fir_size};
    assert(sizes[1] == ownership_limits.fir_size(&row->function));
    assert(sizes[0] == sizes[1] + ownership_limits.fir_size(&leaf->function));
    u64 mut i = 0;
    while (i < sizes.len) {
        strbuf.clear(&expected);
        strbuf.append(&expected, "\"fir_size\":");
        strbuf.append_u64(&expected, sizes[i]);
        strbuf.append(&expected, ",\"counts\":[");
        contains(&out, strbuf.view(&expected));
        strbuf.clear(&expected);
        strbuf.append(&expected, "{\"category\":\"W\",\"scope\":\"computation\",\"used\":");
        contains(&out, strbuf.view(&expected));
        strbuf.clear(&expected);
        strbuf.append(&expected, ",\"bound\":");
        strbuf.append_u64(&expected, ownership_limits.work_bound(sizes[i]));
        strbuf.append(&expected, "}");
        contains(&out, strbuf.view(&expected));
        i += 1;
    }
    // Each scope name follows ownership_api.scope_of: H counts one state.
    count_text(&expected, "H", "state");
    contains(&out, strbuf.view(&expected));
    count_text(&expected, "T", "call");
    contains(&out, strbuf.view(&expected));
    count_text(&expected, "E", "function");
    contains(&out, strbuf.view(&expected));
    assert(str.find(strbuf.view(&out), "\"scope\":\"other\"") < 0);
    println("computation bounds ok");
}

fn main() i32 {
    proof_failure_flag_does_not_mean_internal_failure();
    zero_bodies_retain_missing_producers_and_no_body_meter();
    failure_before_any_body_ledger_keeps_unexecuted_analyses();
    println("statuses ok");
    missing_reason_uses_an_explicit_missing_producer();
    local_reason_comes_before_a_missing_producer();
    graph_refusal_keeps_the_original_category_counts_and_location();
    println("reasons ok");
    internal_verifier_failure_exits_two();
    unsupported_lowering_stays_a_source_rejection();
    internal_analysis_failure_wins_over_an_earlier_lowering_failure();
    later_tool_failure_updates_the_final_reason();
    println("outcomes ok");
    rendered_diagnostic_charges_the_existing_service_ledger();
    later_report_refusal_keeps_completed_solver_results();
    minimum_report_bound_permits_its_last_normal_record();
    report_refusal_keeps_the_first_work_reason_and_stops_later_rows();
    println("rendering ok");
    computation_bounds_are_published();
    return 0;
}
