//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: fir_llvm.rvalue_into: a scalar rvalue into an aggregate place
//! stdout:
//| true
/// An rvalue that writes an aggregate place is a use, a cast, an aggregate, a span or a call.
/// An addition into the pair `_1` breaks that precondition, so the call panics.
import fir;
import fir_llvm;
import llvm_env;
import types;

string[6] PRELUDE = {
    "struct pair {",
    "    i32 a;",
    "    i32 b;",
    "}",
    "fn take(pair p) i32 {",
    "    return p.a;\n}",
};

string[8] TEXT = {
    "fn main.f() -> i32 {",
    "    let _1: pair;",
    "",
    "    bb0: {",
    "        _0 = call fn main.take(const zero pair) #1:1 s1;",
    "        return #1:1 s1;",
    "    }",
    "}",
};

// A panic ends the program, so the case stands in a file of its own.
fn main() i32 {
    llvm_env.env mut e = llvm_env.env{};
    llvm_env.open(&e);
    defer llvm_env.close(&e);
    fir.module mut m = llvm_env.parse(&e, PRELUDE[..], TEXT[..]);
    defer fir.module_free(&m);
    fir.func* f = fir.module_function_at(&m, 0);
    llvm_env.begin(&e.g);
    fir_llvm.translator mut t = fir_llvm.open(&e.g, f);
    defer fir_llvm.close(&t);
    types.node* i32t = fir.local_at(f, 0)->ty;
    types.node* pairt = fir.local_at(f, 1)->ty;
    fir_llvm.write_locals(&t);
    println(fir.type_aggregate(pairt));
    fir.statement s = fir.statement{.place = fir.place_local(1),
                                    .value = fir.rvalue{.kind = fir.rvalue_kind.rv_add}};
    fir_llvm.rvalue_into(&t, &s);
    return 0;
}
