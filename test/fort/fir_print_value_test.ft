//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| 33 kinds
//| ok
/// Checks the textual form of FIR types, places, operands, constants and rvalues
/// (spec/fir.md 5.5, 5.6, 6 and 13): one spelling for each form.
import consts;
import fir;
import fir_env;
import fir_print;
import prim;
import std.strbuf;
import types;

// A function over `fn add(i32 x, i64 y) u64` with the locals the samples name. `_1` is `x` and
// `_2` is `y`.
struct fixture {
    fir.func f;
    u32 pair_local; // _3: pair
    u32 ptr_local; // _4: pair mut*
    u32 array_local; // _5: i32[4]
    u32 n; // _6: u64
    u32 str_local; // _7: string
    u32 span_local; // _8: i32 mut@
    u32 fn_local; // _9: fn (i32, i64) u64
    u32 real; // _10: f64
    u32 ptr_ptr; // _11: pair mut**
    u32 holder_local; // _12: holder
    u32 int_ptr; // _13: i32*
}

fn temp(fir.func mut* f, types.node* ty) u32 {
    return fir.local_add(f, ty, fir.local_kind.lk_temp, null, fir_env.at(1, 1));
}

fn make(fir_env.env mut* e) fixture {
    fixture mut x = fixture{};
    x.f = fir_env.func_of(e, "add");
    types.table mut* tt = fir_env.tt(e);
    types.node* pair = fir_env.ty(e, "pair");
    types.node* pair_ptr = types.type_ptr(tt, pair, false, true);
    x.pair_local = temp(&x.f, pair);
    x.ptr_local = temp(&x.f, pair_ptr);
    x.array_local = temp(&x.f, types.type_array(tt, fir_env.i32_ty(e), 4));
    x.n = temp(&x.f, fir_env.u64_ty(e));
    x.str_local = temp(&x.f, types.type_string(tt, false));
    x.span_local = temp(&x.f, types.type_span(tt, fir_env.i32_ty(e), false, true));
    x.fn_local = temp(&x.f, fir_env.ty(e, "add"));
    x.real = temp(&x.f, fir_env.prim_ty(e, prim.prim_kind.prim_f64));
    x.ptr_ptr = temp(&x.f, types.type_ptr(tt, pair_ptr, false, false));
    x.holder_local = temp(&x.f, fir_env.ty(e, "holder"));
    x.int_ptr = temp(&x.f, types.type_ptr(tt, fir_env.i32_ty(e), false, false));
    return x;
}

fn copy(u32 n) fir.operand {
    return fir.operand_copy(fir.place_local(n));
}

fn u64_const(fir_env.env mut* e, u64 v) fir.operand {
    return fir.operand_const(fir.const_int(fir_env.u64_ty(e), consts.cv_from_u64(v)));
}

// Holds the text of `p` against `want`.
fn place_is(fixture* x, strbuf.str_buf mut* b, fir.place p, string want) void {
    fir_print.print_place(&x->f, p, b);
    fir_env.expect_text(b, want);
}

// Holds the text of the constant `c` against `want`.
fn constant_is(strbuf.str_buf mut* b, fir.constant c, string want) void {
    fir_print.print_constant(c, b);
    fir_env.expect_text(b, want);
}

// ---- types -----------------------------------------------------------------------------

fn a_type_prints_as_the_checker_spells_it() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    types.table mut* tt = fir_env.tt(&e);
    fir_print.print_type(fir_env.i32_ty(&e), &b);
    fir_env.expect_text(&b, "i32");
    fir_print.print_type(types.type_ptr(tt, fir_env.i32_ty(&e), true, true), &b);
    fir_env.expect_text(&b, "i32 mut* own");
    fir_print.print_type(types.type_span(tt, fir_env.ty(&e, "pair"), false, false), &b);
    fir_env.expect_text(&b, "pair@");
    fir_print.print_type(fir_env.ty(&e, "add"), &b);
    fir_env.expect_text(&b, "fn (i32, i64) u64");
}

// ---- places ------------------------------------------------------------------------------

fn a_place_prints_its_base_and_projections() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    fir.func mut* f = &x.f;
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    // The two bases.
    place_is(&x, &b, fir.place_local(1), "_1");
    place_is(&x, &b, fir.place_local(0), "_0");
    place_is(&x, &b, fir.place_global(fir_env.sym(&e, "LIMIT")), "global main.LIMIT");
    // A field and an index.
    place_is(&x, &b, fir.place_field(f, fir.place_local(x.pair_local), 1), "_3.1");
    place_is(&x, &b, fir.place_index(f, fir.place_local(x.array_local), x.n), "_5[_6]");
    place_is(&x, &b, fir.place_index(f, fir.place_local(x.span_local), x.n), "_8[_6]");
    // A field of a global.
    fir.place origin = fir.place_global(fir_env.sym(&e, "origin"));
    place_is(&x, &b, fir.place_field(f, origin, 1), "global main.origin.1");
}

fn a_deref_wraps_what_comes_before_it() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    fir.func mut* f = &x.f;
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    fir.place target = fir.place_deref(f, fir.place_local(x.ptr_local));
    place_is(&x, &b, target, "(*_4)");
    // A field after the deref stands outside the parentheses.
    place_is(&x, &b, fir.place_field(f, target, 0), "(*_4).0");
    // A deref after a field wraps the field too.
    fir.place held = fir.place_field(f, fir.place_local(x.holder_local), 0);
    place_is(&x, &b, fir.place_deref(f, held), "(*_12.0)");
    // Two derefs nest, and each closes at its own position.
    fir.place once = fir.place_deref(f, fir.place_local(x.ptr_ptr));
    fir.place twice = fir.place_deref(f, once);
    place_is(&x, &b, twice, "(*(*_11))");
    place_is(&x, &b, fir.place_field(f, twice, 1), "(*(*_11)).1");
    // An index after a deref.
    fir.place cells = fir.place_field(f, fir.place_deref(f, fir.place_local(x.ptr_local)), 0);
    place_is(&x, &b, fir.place_index(f, cells, x.n), "(*_4).0[_6]");
}

// ---- operands and constants ----------------------------------------------------------------

fn an_operand_prints_its_kind() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    fir_print.print_operand(&x.f, copy(1), &b);
    fir_env.expect_text(&b, "copy _1");
    fir.place held = fir.place_field(&x.f, fir.place_local(x.holder_local), 0);
    fir_print.print_operand(&x.f, fir.operand_move(held), &b);
    fir_env.expect_text(&b, "move _12.0");
    fir.constant minus = fir.const_int(fir_env.i32_ty(&e), consts.cv_from_i64(-1));
    fir_print.print_operand(&x.f, fir.operand_const(minus), &b);
    fir_env.expect_text(&b, "const i32 -1");
    fir_print.print_operand(&x.f, fir.operand_const(fir.const_bool(true)), &b);
    fir_env.expect_text(&b, "const true");
}

fn an_integer_constant_prints_its_type_and_decimal_value() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    constant_is(&b, fir.const_int(fir_env.i32_ty(&e), consts.cv_from_i64(-1)), "i32 -1");
    constant_is(&b, fir.const_int(fir_env.i32_ty(&e), consts.cv_from_i64(0)), "i32 0");
    types.node* u8t = fir_env.prim_ty(&e, prim.prim_kind.prim_u8);
    constant_is(&b, fir.const_int(u8t, consts.cv_from_u64(255)), "u8 255");
    // The two ends of the constant range.
    constant_is(&b, fir.const_int(fir_env.u64_ty(&e), consts.cv_from_u64(18446744073709551615)),
                "u64 18446744073709551615");
    i64 low = -9223372036854775807 - 1;
    constant_is(&b, fir.const_int(fir_env.i64_ty(&e), consts.cv_from_i64(low)),
                "i64 -9223372036854775808");
    // No constant holds a negative zero: consts.int_make clears `neg` when the magnitude is 0,
    // and every integer constant comes from it. So the negation of 0 prints `0`.
    consts.cval mut minus_zero = consts.cv_none();
    assert(consts.cv_neg(consts.cv_from_i64(0), &minus_zero));
    assert(!minus_zero.neg);
    constant_is(&b, fir.const_int(fir_env.i32_ty(&e), minus_zero), "i32 0");
    // A `char` prints its code point, and an enum its value.
    constant_is(&b, fir.const_int(fir_env.char_ty(&e), consts.cv_from_char(65)), "char 65");
    constant_is(&b, fir.const_int(fir_env.ty(&e, "color"), consts.cv_from_u64(1)), "color 1");
}

fn a_boolean_constant_prints_its_word() void {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    constant_is(&b, fir.const_bool(true), "true");
    constant_is(&b, fir.const_bool(false), "false");
}

// A float prints the 16 hex digits of the bits of its `double` (D19.5), whatever its type.
fn a_float_constant_prints_its_bit_pattern() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    types.node* f64t = fir_env.prim_ty(&e, prim.prim_kind.prim_f64);
    types.node* f32t = fir_env.prim_ty(&e, prim.prim_kind.prim_f32);
    // 1.5
    constant_is(&b, fir.const_float(f64t, consts.cv_from_float(0x3FF8000000000000)),
                "f64 0x3FF8000000000000");
    // The leading zeros stay, so every pattern has 16 digits.
    constant_is(&b, fir.const_float(f32t, consts.cv_from_float(1)), "f32 0x0000000000000001");
    constant_is(&b, fir.const_float(f64t, consts.cv_from_float(0xFEDCBA9876543210)),
                "f64 0xFEDCBA9876543210");
}

fn a_null_and_a_zero_constant_print_their_type() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    types.table mut* tt = fir_env.tt(&e);
    types.node* pair_ptr = types.type_ptr(tt, fir_env.ty(&e, "pair"), false, true);
    constant_is(&b, fir.const_null(pair_ptr), "null pair mut*");
    constant_is(&b, fir.const_zero(fir_env.ty(&e, "pair")), "zero pair");
    constant_is(&b, fir.const_zero(types.type_ptr(tt, fir_env.i32_ty(&e), true, true)),
                "zero i32 mut* own");
}

// The bytes 31, 32, 126, 127, 128 and 255: the two ends of the printable range and the bytes
// on each side of it.
u8[6] EDGE_BYTES = {31, 32, 126, 127, 128, 255};

fn a_string_constant_escapes_its_bytes() void {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    constant_is(&b, fir.const_string("hello"), "\"hello\"");
    constant_is(&b, fir.const_string(""), "\"\"");
    // A `"` and a `\` take a `\`.
    constant_is(&b, fir.const_string("a\"b\\c"), "\"a\\\"b\\\\c\"");
    // A control byte is `\xHH`, not `\n` or `\t`.
    constant_is(&b, fir.const_string("\n\t\r\0"), "\"\\x0A\\x09\\x0D\\x00\"");
    string edge = cast(EDGE_BYTES[..], string);
    constant_is(&b, fir.const_string(edge), "\"\\x1F ~\\x7F\\x80\\xFF\"");
    // A `bytes` constant escapes as a string does.
    constant_is(&b, fir.const_bytes("hi"), "bytes \"hi\"");
    constant_is(&b, fir.const_bytes("a\"\n"), "bytes \"a\\\"\\x0A\"");
}

fn a_symbol_constant_prints_the_dotted_name() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    types.node* member = types.type_ptr(fir_env.tt(&e), fir_env.ty(&e, "enum_member"), false,
                                        false);
    constant_is(&b, fir.const_enum_table(fir_env.sym(&e, "color"), member),
                "enum_table main.color");
    constant_is(&b, fir.const_fn(fir_env.sym(&e, "add")), "fn main.add");
    constant_is(&b, fir.const_fn(fir_env.sym(&e, "stop")), "fn main.stop");
}

// ---- rvalues --------------------------------------------------------------------------------

// One rvalue of `kind` and its text. The switch names every member of the enum and has no
// default, so a new member does not compile until it has a sample here.
fn sample(fir_env.env mut* e, fixture mut* x, fir.rvalue_kind kind, fir.rvalue mut* out)
    string {
    fir.func mut* f = &x->f;
    fir.operand a = copy(1);
    fir.operand wide = copy(2);
    switch (kind) {
    case fir.rvalue_kind.rv_use:
        *out = fir.rvalue_use(f, a);
        return "copy _1";
    case fir.rvalue_kind.rv_add:
        *out = fir.rvalue_binary(f, kind, a, wide);
        return "add(copy _1, copy _2)";
    case fir.rvalue_kind.rv_sub:
        *out = fir.rvalue_binary(f, kind, a, wide);
        return "sub(copy _1, copy _2)";
    case fir.rvalue_kind.rv_mul:
        *out = fir.rvalue_binary(f, kind, a, wide);
        return "mul(copy _1, copy _2)";
    case fir.rvalue_kind.rv_add_overflows:
        *out = fir.rvalue_binary(f, kind, a, wide);
        return "add_overflows(copy _1, copy _2)";
    case fir.rvalue_kind.rv_sub_overflows:
        *out = fir.rvalue_binary(f, kind, a, wide);
        return "sub_overflows(copy _1, copy _2)";
    case fir.rvalue_kind.rv_mul_overflows:
        *out = fir.rvalue_binary(f, kind, a, wide);
        return "mul_overflows(copy _1, copy _2)";
    case fir.rvalue_kind.rv_div:
        *out = fir.rvalue_binary(f, kind, a, wide);
        return "div(copy _1, copy _2)";
    case fir.rvalue_kind.rv_rem:
        *out = fir.rvalue_binary(f, kind, a, wide);
        return "rem(copy _1, copy _2)";
    case fir.rvalue_kind.rv_and:
        *out = fir.rvalue_binary(f, kind, a, wide);
        return "and(copy _1, copy _2)";
    case fir.rvalue_kind.rv_or:
        *out = fir.rvalue_binary(f, kind, a, wide);
        return "or(copy _1, copy _2)";
    case fir.rvalue_kind.rv_xor:
        *out = fir.rvalue_binary(f, kind, a, wide);
        return "xor(copy _1, copy _2)";
    case fir.rvalue_kind.rv_not:
        *out = fir.rvalue_unary(f, kind, a);
        return "not(copy _1)";
    case fir.rvalue_kind.rv_shl:
        *out = fir.rvalue_binary(f, kind, a, copy(1));
        return "shl(copy _1, copy _1)";
    case fir.rvalue_kind.rv_shr:
        *out = fir.rvalue_binary(f, kind, a, copy(1));
        return "shr(copy _1, copy _1)";
    case fir.rvalue_kind.rv_fadd:
        *out = fir.rvalue_binary(f, kind, copy(x->real), copy(x->real));
        return "fadd(copy _10, copy _10)";
    case fir.rvalue_kind.rv_fsub:
        *out = fir.rvalue_binary(f, kind, copy(x->real), copy(x->real));
        return "fsub(copy _10, copy _10)";
    case fir.rvalue_kind.rv_fmul:
        *out = fir.rvalue_binary(f, kind, copy(x->real), copy(x->real));
        return "fmul(copy _10, copy _10)";
    case fir.rvalue_kind.rv_fdiv:
        *out = fir.rvalue_binary(f, kind, copy(x->real), copy(x->real));
        return "fdiv(copy _10, copy _10)";
    case fir.rvalue_kind.rv_fneg:
        *out = fir.rvalue_unary(f, kind, copy(x->real));
        return "fneg(copy _10)";
    case fir.rvalue_kind.rv_eq:
        *out = fir.rvalue_binary(f, kind, a, wide);
        return "eq(copy _1, copy _2)";
    case fir.rvalue_kind.rv_ne:
        *out = fir.rvalue_binary(f, kind, a, wide);
        return "ne(copy _1, copy _2)";
    case fir.rvalue_kind.rv_lt:
        *out = fir.rvalue_binary(f, kind, a, wide);
        return "lt(copy _1, copy _2)";
    case fir.rvalue_kind.rv_le:
        *out = fir.rvalue_binary(f, kind, a, wide);
        return "le(copy _1, copy _2)";
    case fir.rvalue_kind.rv_gt:
        *out = fir.rvalue_binary(f, kind, a, wide);
        return "gt(copy _1, copy _2)";
    case fir.rvalue_kind.rv_ge:
        *out = fir.rvalue_binary(f, kind, a, wide);
        return "ge(copy _1, copy _2)";
    case fir.rvalue_kind.rv_cast:
        *out = fir.rvalue_cast(f, fir_env.i64_ty(e), a);
        return "cast<i64>(copy _1)";
    case fir.rvalue_kind.rv_addr:
        *out = fir.rvalue_addr(f, fir.place_field(f, fir.place_local(x->pair_local), 1), false);
        return "addr(_3.1)";
    case fir.rvalue_kind.rv_slice:
        *out = fir.rvalue_slice(f, fir.place_local(x->array_local), u64_const(e, 0), copy(x->n),
                                false);
        return "slice(_5, const u64 0, copy _6)";
    case fir.rvalue_kind.rv_slice_ptr:
        *out = fir.rvalue_slice_ptr(f, copy(x->int_ptr), u64_const(e, 1), copy(x->n));
        return "slice_ptr(copy _13, const u64 1, copy _6)";
    case fir.rvalue_kind.rv_alloc:
        *out = fir.rvalue_alloc(f, fir_env.ty(e, "pair"), u64_const(e, 3));
        return "alloc<pair>(const u64 3)";
    case fir.rvalue_kind.rv_aggregate:
        u32 first = fir.operand_push(f, a);
        fir.operand_push(f, copy(x->n));
        *out = fir.rvalue_aggregate_new(fir_env.ty(e, "pair"), first, 2);
        return "aggregate pair(copy _1, copy _6)";
    case fir.rvalue_kind.rv_call:
        u32 args = fir.operand_push(f, a);
        fir.operand_push(f, wide);
        *out = fir.rvalue_call_fn(fir_env.sym(e, "add"), args, 2);
        return "call fn main.add(copy _1, copy _2)";
    }
}

fn every_rvalue_kind_prints_its_spelling() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    u32 last = cast(fir.rvalue_kind.rv_call, u32);
    u32 mut k = 0;
    while (k <= last) {
        fir.rvalue_kind kind = cast(k, fir.rvalue_kind);
        fir.rvalue mut r = fir.rvalue{};
        string want = sample(&e, &x, kind, &r);
        assert(r.kind == kind);
        fir_print.print_rvalue(&x.f, r, &b);
        fir_env.expect_text(&b, want);
        k += 1;
    }
    println(k, " kinds");
}

// A call names a fort function, an extern by its C name, or an operand of function type.
fn a_call_prints_its_callee() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    fir.func mut* f = &x.f;
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    u32 text = fir.operand_push(f, fir.operand_const(fir.const_bytes("hi")));
    fir_print.print_rvalue(f, fir.rvalue_call_extern(fir_env.sym(&e, "puts"), text, 1), &b);
    fir_env.expect_text(&b, "call extern puts(const bytes \"hi\")");
    u32 args = fir.operand_push(f, copy(1));
    fir.operand_push(f, copy(2));
    fir_print.print_rvalue(f, fir.rvalue_call_value(copy(x.fn_local), args, 2), &b);
    fir_env.expect_text(&b, "call copy _9(copy _1, copy _2)");
    // A call with no argument.
    u32 none = cast(f->ops.len, u32);
    fir_print.print_rvalue(f, fir.rvalue_call_fn(fir_env.sym(&e, "nothing"), none, 0), &b);
    fir_env.expect_text(&b, "call fn main.nothing()");
    // A function constant as the callee operand.
    fir.operand callee = fir.operand_const(fir.const_fn(fir_env.sym(&e, "make")));
    fir_print.print_rvalue(f, fir.rvalue_call_value(callee, none, 0), &b);
    fir_env.expect_text(&b, "call const fn main.make()");
}

fn the_edge_forms_of_an_rvalue_print_in_full() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    fir.func mut* f = &x.f;
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    // An aggregate with no member, such as a struct with no field, has empty parentheses.
    u32 none = cast(f->ops.len, u32);
    fir_print.print_rvalue(f, fir.rvalue_aggregate_new(fir_env.ty(&e, "pair"), none, 0), &b);
    fir_env.expect_text(&b, "aggregate pair()");
    // The use of a constant and of a move.
    fir.constant zero = fir.const_zero(fir_env.ty(&e, "pair"));
    fir_print.print_rvalue(f, fir.rvalue_use(f, fir.operand_const(zero)), &b);
    fir_env.expect_text(&b, "const zero pair");
    fir_print.print_rvalue(f, fir.rvalue_use(f, fir.operand_move(fir.place_local(3))), &b);
    fir_env.expect_text(&b, "move _3");
    // `addr` of a deref and a slice of a string take the place as it prints.
    fir.place target = fir.place_deref(f, fir.place_local(x.ptr_local));
    fir_print.print_rvalue(f, fir.rvalue_addr(f, target, false), &b);
    fir_env.expect_text(&b, "addr((*_4))");
    fir.place text = fir.place_local(x.str_local);
    fir_print.print_rvalue(f, fir.rvalue_slice(f, text, copy(x.n), copy(x.n), false), &b);
    fir_env.expect_text(&b, "slice(_7, copy _6, copy _6)");
    // A cast to an aggregate type and an alloc of a pointer type spell the type in full.
    types.node* span = types.type_span(fir_env.tt(&e), fir_env.i32_ty(&e), false, true);
    fir_print.print_rvalue(f, fir.rvalue_cast(f, span, copy(x.span_local)), &b);
    fir_env.expect_text(&b, "cast<i32 mut@>(copy _8)");
    types.node* ptr = types.type_ptr(fir_env.tt(&e), fir_env.i32_ty(&e), true, true);
    fir_print.print_rvalue(f, fir.rvalue_alloc(f, ptr, copy(x.n)), &b);
    fir_env.expect_text(&b, "alloc<i32 mut* own>(copy _6)");
}

// `addr` and `slice` write `mut` after the name when `is_mut` is set, so the text keeps the
// `mut` of the pointer or the span (spec/fir.md 6, 13).
fn mut_marks_addr_and_slice() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    fir.func mut* f = &x.f;
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    fir.place field = fir.place_field(f, fir.place_local(x.pair_local), 1);
    fir_print.print_rvalue(f, fir.rvalue_addr(f, field, true), &b);
    fir_env.expect_text(&b, "addr mut(_3.1)");
    fir_print.print_rvalue(f, fir.rvalue_addr(f, field, false), &b);
    fir_env.expect_text(&b, "addr(_3.1)");
    fir.place target = fir.place_deref(f, fir.place_local(x.ptr_local));
    fir_print.print_rvalue(f, fir.rvalue_addr(f, target, true), &b);
    fir_env.expect_text(&b, "addr mut((*_4))");
    fir.place cells = fir.place_local(x.array_local);
    fir.rvalue whole = fir.rvalue_slice(f, cells, u64_const(&e, 0), copy(x.n), true);
    fir_print.print_rvalue(f, whole, &b);
    fir_env.expect_text(&b, "slice mut(_5, const u64 0, copy _6)");
    fir.rvalue view = fir.rvalue_slice(f, cells, u64_const(&e, 0), copy(x.n), false);
    fir_print.print_rvalue(f, view, &b);
    fir_env.expect_text(&b, "slice(_5, const u64 0, copy _6)");
    // No other rvalue writes `mut`, whatever the field holds.
    fir.rvalue mut cast_mut = fir.rvalue_cast(f, fir_env.i64_ty(&e), copy(1));
    cast_mut.is_mut = true;
    fir_print.print_rvalue(f, cast_mut, &b);
    fir_env.expect_text(&b, "cast<i64>(copy _1)");
    fir.rvalue mut ptr_mut = fir.rvalue_slice_ptr(f, copy(x.int_ptr), copy(x.n), copy(x.n));
    ptr_mut.is_mut = true;
    fir_print.print_rvalue(f, ptr_mut, &b);
    fir_env.expect_text(&b, "slice_ptr(copy _13, copy _6, copy _6)");
}

// Each printer appends to what the buffer holds, so a caller builds a line from parts.
fn a_printer_appends_to_the_buffer() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "<");
    fir_print.print_operand(&x.f, copy(2), &b);
    strbuf.append(&b, "|");
    fir_print.print_constant(fir.const_bool(false), &b);
    fir_env.expect_text(&b, "<copy _2|false");
}

fn main() i32 {
    a_type_prints_as_the_checker_spells_it();
    a_place_prints_its_base_and_projections();
    a_deref_wraps_what_comes_before_it();
    an_operand_prints_its_kind();
    an_integer_constant_prints_its_type_and_decimal_value();
    a_boolean_constant_prints_its_word();
    a_float_constant_prints_its_bit_pattern();
    a_null_and_a_zero_constant_print_their_type();
    a_string_constant_escapes_its_bytes();
    a_symbol_constant_prints_the_dotted_name();
    every_rvalue_kind_prints_its_spelling();
    a_call_prints_its_callee();
    the_edge_forms_of_an_rvalue_print_in_full();
    mut_marks_addr_and_slice();
    a_printer_appends_to_the_buffer();
    println("ok");
    return 0;
}
