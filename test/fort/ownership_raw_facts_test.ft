//! run
//! flags: -I ../../src/fort -I support
//! link: support/ownership_depth_alloc.c
//! stdout:
//| raw fact union ok
/// Tests canonical regions, bounds, simultaneous payloads, and explicit replacements.
import ownership_api;
import ownership_depth_env;
import ownership_raw_facts;
import ownership_raw_facts_env;
import ownership_type_work;
import prim;
import types;

fn empty() void {
    ownership_depth_env.fixture mut f = {};
    ownership_type_work.work mut paid = ownership_raw_facts_env.configure(&f, 65536);
    ownership_depth_env.begin();
    ownership_raw_facts.payload_result mut payload = ownership_raw_facts.build_payload(
        ownership_raw_facts.raw_fact_view{.choices_complete = true}, &paid);
    ownership_raw_facts_env.good(&payload);
    assert(payload.payload->bounds.len == 0 && payload.payload->relations.len == 0);
    ownership_raw_facts.raw_fact_payload*[1] live = {payload.payload};
    ownership_raw_facts.union_request req = ownership_raw_facts.union_request{.live = live[..]};
    ownership_raw_facts.union_result mut result = ownership_raw_facts.measure_union(&req, &paid);
    ownership_raw_facts_env.counts(&result, 0, 0);
    assert(result.choices_complete && result.choices == null);
    assert(f.meter.used.w > 0 && f.meter.used.p == 0 && f.meter.used.g == 0);
    ownership_raw_facts.free_union_result(&result);
    ownership_raw_facts.free_payload(&payload.payload);
    ownership_raw_facts.free_payload(&payload.payload);
    assert(ownership_depth_env.finish() > 0);
}
fn union_and_replacement() void {
    ownership_depth_env.fixture mut f = {};
    ownership_type_work.work mut paid = ownership_raw_facts_env.configure(&f, 65536);
    types.node layout = ownership_raw_facts_env.integer();
    ownership_raw_facts.raw_region_view[1] mut regions = {
        ownership_raw_facts_env.region(&layout, 1, 1, 0, 8)};
    ownership_raw_facts.closed_bound_view[1] mut bounds = {
        ownership_raw_facts_env.bound(1, 0, 3)};
    ownership_depth_env.begin();
    ownership_raw_facts.raw_fact_view input = ownership_raw_facts.raw_fact_view{
        .regions = regions[..], .bounds = bounds[..], .choices_complete = true,
        .unconditional_proved = true};
    ownership_raw_facts.payload_result mut first = ownership_raw_facts.build_payload(input, &paid);
    ownership_raw_facts.payload_result mut equal = ownership_raw_facts.copy_payload(first.payload,
        &paid);
    ownership_raw_facts_env.good(&first); ownership_raw_facts_env.good(&equal);
    regions[0].source = ownership_raw_facts_env.id(ownership_api.entity_kind.source, 2);
    bounds[0].upper = ownership_raw_facts.natural(4);
    ownership_raw_facts.payload_result mut unequal =
        ownership_raw_facts.build_payload(input, &paid);
    ownership_raw_facts_env.good(&unequal);
    assert(first.payload->regions[0].source.ordinal == 1);
    assert(first.payload->bounds[0].upper.magnitude == 3);
    ownership_raw_facts.raw_fact_payload*[3] mut live = {first.payload, equal.payload,
        unequal.payload};
    ownership_raw_facts.union_request mut req = ownership_raw_facts.union_request{.live = live[..]};
    ownership_raw_facts.union_result mut result = ownership_raw_facts.measure_union(&req, &paid);
    ownership_raw_facts_env.counts(&result, 2, 2);
    assert(result.choices_complete && result.choices != null);
    ownership_raw_facts.free_union_result(&result);
    live[0] = unequal.payload; live[2] = first.payload;
    result = ownership_raw_facts.measure_union(&req, &paid);
    ownership_raw_facts_env.counts(&result, 2, 2);
    ownership_raw_facts.free_union_result(&result);
    // Replacement removes the changed payload. Both equal copies still retain one semantic set.
    req.live = live[..2]; req.replaced = unequal.payload;
    req.proposed = first.payload;
    result = ownership_raw_facts.measure_union(&req, &paid);
    ownership_raw_facts_env.counts(&result, 1, 1);
    ownership_raw_facts.free_union_result(&result);
    req = ownership_raw_facts.union_request{.live = live[1..2]};
    ownership_raw_facts.free_payload(&first.payload);
    ownership_raw_facts.free_payload(&unequal.payload);
    result = ownership_raw_facts.measure_union(&req, &paid);
    ownership_raw_facts_env.counts(&result, 1, 1);
    ownership_raw_facts.free_union_result(&result);
    ownership_raw_facts.free_payload(&equal.payload);
    req = ownership_raw_facts.union_request{};
    result = ownership_raw_facts.measure_union(&req, &paid);
    ownership_raw_facts_env.counts(&result, 0, 0);
    ownership_raw_facts.free_union_result(&result);
    assert(ownership_depth_env.finish() > 0);
}
fn region_distinctions() void {
    ownership_depth_env.fixture mut f = {};
    ownership_type_work.work mut paid = ownership_raw_facts_env.configure(&f, 65536);
    types.node layout = ownership_raw_facts_env.integer();
    types.node other = types.node{.kind = types.type_kind.k_prim, .prim = prim.prim_kind.prim_u64};
    ownership_api.projection[1] projected = {ownership_api.projection{
        .kind = ownership_api.projection_kind.field, .field = 2}};
    ownership_raw_facts.raw_region_view[8] mut regions = {};
    u64 mut i = 0;
    while (i < regions.len) {
        regions[i] = ownership_raw_facts_env.region(&layout, 1, 1, 0, 8); i += 1;
    }
    regions[1].source = ownership_raw_facts_env.id(ownership_api.entity_kind.source, 2);
    regions[2].place.root = ownership_raw_facts_env.id(ownership_api.entity_kind.slot, 2);
    regions[3].place.projections = projected[..];
    regions[4].end = ownership_raw_facts.literal(9);
    regions[5].layout = &other;
    regions[6].owning = true;
    regions[7].padding = true;
    ownership_depth_env.begin();
    ownership_raw_facts.payload_result mut payload = ownership_raw_facts.build_payload(
        ownership_raw_facts.raw_fact_view{.regions = regions[..]}, &paid);
    ownership_raw_facts_env.good(&payload);
    ownership_raw_facts.union_request req = ownership_raw_facts.union_request{
        .proposed = payload.payload};
    ownership_raw_facts.union_result mut result = ownership_raw_facts.measure_union(&req, &paid);
    ownership_raw_facts_env.counts(&result, 8, 0);
    assert(!result.choices_complete && result.choices == null);
    ownership_raw_facts.free_union_result(&result);
    ownership_raw_facts.free_payload(&payload.payload);
    assert(ownership_depth_env.finish() > 0);
}
fn core_regions() void {
    ownership_depth_env.fixture mut f = {};
    ownership_type_work.work mut paid = ownership_raw_facts_env.configure(&f, 65536);
    types.node layout = ownership_raw_facts_env.integer();
    types.node equal_layout = ownership_raw_facts_env.integer();
    ownership_raw_facts.raw_region_view[1] regions = {
        ownership_raw_facts_env.region(&layout, 1, 1, 0, 8)};
    ownership_raw_facts.core_region_view[2] mut core = {};
    core[0].identity = ownership_raw_facts.core_region_identity{
        ownership_raw_facts.region_identity_kind.region,
        ownership_raw_facts_env.id(ownership_api.entity_kind.region, 1), {}};
    core[0].meaning = regions[0]; core[0].alias_complete = true;
    core[1] = core[0]; core[1].meaning.layout = &equal_layout;
    ownership_depth_env.begin();
    ownership_raw_facts.payload_result mut payload = ownership_raw_facts.build_payload(
        ownership_raw_facts.raw_fact_view{.regions = regions[..]}, &paid);
    ownership_raw_facts_env.good(&payload);
    ownership_raw_facts.union_request mut req = ownership_raw_facts.union_request{
        .core = ownership_raw_facts.core_fact_view{.regions = core[..]},
        .proposed = payload.payload};
    ownership_raw_facts.union_result mut result = ownership_raw_facts.measure_union(&req, &paid);
    ownership_raw_facts_env.counts(&result, 1, 0);
    ownership_raw_facts.free_union_result(&result);
    core[0].alias_complete = false; core[1].alias_complete = false;
    result = ownership_raw_facts.measure_union(&req, &paid);
    ownership_raw_facts_env.counts(&result, 2, 0);
    ownership_raw_facts.free_union_result(&result);
    core[1].alias_complete = true;
    result = ownership_raw_facts.measure_union(&req, &paid);
    ownership_raw_facts_env.counts(&result, 1, 0);
    ownership_raw_facts.free_union_result(&result);
    core[0].alias_complete = true;
    core[1].meaning.end = ownership_raw_facts.literal(9);
    result = ownership_raw_facts.measure_union(&req, &paid);
    ownership_raw_facts_env.refused(result.proof, ownership_api.incomplete_reason.invalid_input);
    assert(result.r == 0 && result.p == 0 && result.choices == null);
    ownership_raw_facts.free_union_result(&result);
    ownership_raw_facts.free_payload(&payload.payload);
    assert(ownership_depth_env.finish() > 0);
}
fn core_representatives() void {
    ownership_depth_env.fixture mut f = {};
    ownership_type_work.work mut paid = ownership_raw_facts_env.configure(&f, 65536);
    ownership_raw_facts.core_region_view[5] mut core = {};
    core[0].identity = ownership_raw_facts.core_region_identity{
        ownership_raw_facts.region_identity_kind.allocation,
        ownership_raw_facts_env.id(ownership_api.entity_kind.allocation, 1), {}};
    core[1].identity = core[0].identity;
    core[1].identity.kind = ownership_raw_facts.region_identity_kind.graph_node;
    core[2].identity = ownership_raw_facts.core_region_identity{
        ownership_raw_facts.region_identity_kind.graph_node,
        ownership_raw_facts_env.id(ownership_api.entity_kind.graph_node, 1), {}};
    core[3].identity = ownership_raw_facts.core_region_identity{
        ownership_raw_facts.region_identity_kind.region,
        ownership_raw_facts_env.id(ownership_api.entity_kind.region, 1), {}};
    core[4].identity = ownership_raw_facts.core_region_identity{
        ownership_raw_facts.region_identity_kind.partition,
        ownership_raw_facts_env.id(ownership_api.entity_kind.region, 1),
        ownership_raw_facts_env.id(ownership_api.entity_kind.region, 1)};
    ownership_depth_env.begin();
    ownership_raw_facts.union_request req = ownership_raw_facts.union_request{
        .core = ownership_raw_facts.core_fact_view{.regions = core[..]}};
    ownership_raw_facts.union_result mut result = ownership_raw_facts.measure_union(&req, &paid);
    ownership_raw_facts_env.counts(&result, 4, 0);
    ownership_raw_facts.free_union_result(&result);
    assert(ownership_depth_env.finish() > 0);
}
fn memberships() void {
    ownership_depth_env.fixture mut f = {};
    ownership_type_work.work mut paid = ownership_raw_facts_env.configure(&f, 65536);
    ownership_raw_facts.closed_bound_view[5] mut bounds = {
        ownership_raw_facts_env.bound(1, 0, 3), ownership_raw_facts_env.bound(1, 0, 3),
        ownership_raw_facts_env.bound(1, 0, 4), ownership_raw_facts_env.bound(2, 0, 3),
        ownership_raw_facts_env.bound(3, -4, -1)};
    bounds[1].lower.negative = true;
    ownership_api.predicate_atom[2] mut core = {
        ownership_raw_facts_env.atom(1, ownership_api.predicate_kind.membership, 1, 1, 0, 4),
        ownership_raw_facts_env.atom(2, ownership_api.predicate_kind.membership, 3, 3, -4, 0)};
    ownership_depth_env.begin();
    ownership_raw_facts.payload_result mut payload = ownership_raw_facts.build_payload(
        ownership_raw_facts.raw_fact_view{.bounds = bounds[..]}, &paid);
    ownership_raw_facts_env.good(&payload);
    assert(!payload.payload->bounds[1].lower.negative);
    ownership_raw_facts.union_request mut req = ownership_raw_facts.union_request{
        .core = ownership_raw_facts.core_fact_view{.predicates = core[..]},
        .proposed = payload.payload};
    ownership_raw_facts.union_result mut result = ownership_raw_facts.measure_union(&req, &paid);
    ownership_raw_facts_env.counts(&result, 0, 5);
    ownership_raw_facts.free_union_result(&result);
    core[0].lower.kind = ownership_api.fact_kind.symbolic;
    result = ownership_raw_facts.measure_union(&req, &paid);
    ownership_raw_facts_env.counts(&result, 0, 6);
    ownership_raw_facts.free_union_result(&result);
    core[0] = core[1];
    result = ownership_raw_facts.measure_union(&req, &paid);
    ownership_raw_facts_env.refused(result.proof, ownership_api.incomplete_reason.invalid_input);
    assert(result.r == 0 && result.p == 0);
    ownership_raw_facts.free_union_result(&result);
    ownership_raw_facts.free_payload(&payload.payload);
    assert(ownership_depth_env.finish() > 0);
}
fn choices() void {
    ownership_depth_env.fixture mut f = {};
    ownership_type_work.work mut paid = ownership_raw_facts_env.configure(&f, 65536);
    ownership_raw_facts.closed_bound_view[1] mut bounds = {
        ownership_raw_facts_env.bound(1, 0, 3)};
    ownership_api.projection[1] mut projections = {ownership_api.projection{
        .kind = ownership_api.projection_kind.field, .field = 2}};
    ownership_api.predicate_atom[1] mut positive = {
        ownership_raw_facts_env.atom(1, ownership_api.predicate_kind.membership, 1, 1, 0, 4)};
    u64[1] mut indices = {0};
    ownership_raw_facts.choice_view[1] mut bindings = {ownership_raw_facts.choice_view{
        .kind = ownership_raw_facts.decision_kind.weak_selection,
        .decision = ownership_raw_facts_env.id(ownership_api.entity_kind.guard, 1),
        .subject = ownership_raw_facts_env.path(1),
        .value_version = ownership_raw_facts_env.id(ownership_api.entity_kind.value, 1),
        .alternative = ownership_raw_facts_env.id(ownership_api.entity_kind.relation, 1),
        .polarity = false, .positive = positive[..], .bounds = indices[..], .complete = true}};
    bindings[0].subject.projections = projections[..];
    ownership_depth_env.begin();
    ownership_raw_facts.payload_result mut payload = ownership_raw_facts.build_payload(
        ownership_raw_facts.raw_fact_view{.bounds = bounds[..], .choices = bindings[..],
        .choices_complete = true}, &paid);
    ownership_raw_facts_env.good(&payload);
    projections[0].field = 9; bounds[0].upper = ownership_raw_facts.natural(7);
    positive[0].upper.value = 8; indices[0] = 9; bindings[0].value_version.ordinal = 9;
    ownership_raw_facts.union_request req = ownership_raw_facts.union_request{
        .proposed = payload.payload};
    ownership_raw_facts.union_result mut result = ownership_raw_facts.measure_union(&req, &paid);
    ownership_raw_facts_env.counts(&result, 0, 1);
    assert(result.choices_complete && result.choices != null);
    ownership_raw_facts.raw_fact_payload* snapshot = result.choices->payload;
    assert(snapshot != cast(payload.payload, ownership_raw_facts.raw_fact_payload*));
    assert(snapshot->bounds[0].upper.magnitude == 3);
    assert(snapshot->choices[0].descriptor.subject.projections[0].field == 2);
    assert(snapshot->choices[0].descriptor.positive[0].upper.value == 4);
    assert(snapshot->choices[0].descriptor.value_version.ordinal == 1);
    assert(snapshot->choices[0].descriptor.bounds[0] == 0);
    assert(!snapshot->choices[0].descriptor.polarity);
    assert(snapshot->choices[0].descriptor.kind ==
        ownership_raw_facts.decision_kind.weak_selection);
    ownership_raw_facts.free_payload(&payload.payload);
    assert(snapshot->choices[0].descriptor.subject.projections[0].field == 2);
    ownership_raw_facts.free_union_result(&result);
    ownership_raw_facts.free_union_result(&result);
    assert(ownership_depth_env.finish() > 0);
}
fn descriptor_controls() void {
    ownership_depth_env.fixture mut f = {};
    ownership_type_work.work mut paid = ownership_raw_facts_env.configure(&f, 65536);
    types.node layout = ownership_raw_facts_env.integer();
    ownership_raw_facts.raw_region_view[1] mut regions = {
        ownership_raw_facts_env.region(&layout, 1, 1, 0, 0)};
    ownership_api.predicate_atom[1] mut predicates = {
        ownership_raw_facts_env.atom(1, ownership_api.predicate_kind.shape, 1, 1, 0, 0)};
    predicates[0].left = ownership_raw_facts_env.id(ownership_api.entity_kind.region, 1);
    ownership_depth_env.begin();
    ownership_raw_facts.payload_result mut payload = ownership_raw_facts.build_payload(
        ownership_raw_facts.raw_fact_view{.regions = regions[..]}, &paid);
    ownership_raw_facts_env.good(&payload);
    ownership_raw_facts.union_request req = ownership_raw_facts.union_request{
        .core = ownership_raw_facts.core_fact_view{.predicates = predicates[..]},
        .proposed = payload.payload};
    ownership_raw_facts.union_result mut result = ownership_raw_facts.measure_union(&req, &paid);
    ownership_raw_facts_env.counts(&result, 1, 1);
    ownership_raw_facts.free_union_result(&result);
    ownership_raw_facts.free_payload(&payload.payload);
    regions[0].place.root.kind = ownership_api.entity_kind.none;
    payload = ownership_raw_facts.build_payload(
        ownership_raw_facts.raw_fact_view{.regions = regions[..]}, &paid);
    ownership_raw_facts_env.refused(payload.proof, ownership_api.incomplete_reason.invalid_input);
    assert(payload.payload == null);
    paid = ownership_raw_facts_env.configure(&f, 65536);
    regions[0] = ownership_raw_facts_env.region(&layout, 1, 1, 2, 1);
    payload = ownership_raw_facts.build_payload(
        ownership_raw_facts.raw_fact_view{.regions = regions[..]}, &paid);
    ownership_raw_facts_env.refused(payload.proof, ownership_api.incomplete_reason.invalid_input);
    assert(payload.payload == null);
    assert(ownership_depth_env.finish() > 0);
}
fn choice_identity_controls() void {
    ownership_depth_env.fixture mut f = {};
    ownership_type_work.work mut paid = ownership_raw_facts_env.configure(&f, 65536);
    ownership_raw_facts.closed_bound_view[1] bounds = {ownership_raw_facts_env.bound(1, 0, 3)};
    ownership_api.predicate_atom[1] mut positive = {ownership_raw_facts_env.atom(1,
        ownership_api.predicate_kind.membership, 1, 1, 0, 4)};
    u64[1] mut indices = {0};
    ownership_raw_facts.choice_view[1] mut bindings = {ownership_raw_facts.choice_view{
        .kind = ownership_raw_facts.decision_kind.opaque,
        .decision = ownership_raw_facts_env.id(ownership_api.entity_kind.guard, 1),
        .subject = ownership_raw_facts_env.path(1),
        .value_version = ownership_raw_facts_env.id(ownership_api.entity_kind.value, 1),
        .alternative = ownership_raw_facts_env.id(ownership_api.entity_kind.relation, 1),
        .positive = positive[..], .bounds = indices[..], .complete = true}};
    ownership_raw_facts.raw_fact_view input = ownership_raw_facts.raw_fact_view{
        .bounds = bounds[..], .choices = bindings[..], .choices_complete = true};
    ownership_depth_env.begin();
    ownership_raw_facts.payload_result mut first = ownership_raw_facts.build_payload(input, &paid);
    ownership_raw_facts_env.good(&first);
    positive[0].upper.value = 5;
    ownership_raw_facts.payload_result mut second = ownership_raw_facts.build_payload(input, &paid);
    ownership_raw_facts_env.good(&second);
    ownership_raw_facts.raw_fact_payload*[1] live = {first.payload};
    ownership_raw_facts.union_request mut req = ownership_raw_facts.union_request{
        .live = live[..], .proposed = second.payload};
    ownership_raw_facts.union_result mut result = ownership_raw_facts.measure_union(&req, &paid);
    ownership_raw_facts_env.refused(result.proof, ownership_api.incomplete_reason.invalid_input);
    assert(result.r == 0 && result.p == 0 && result.choices == null);
    ownership_raw_facts.free_payload(&second.payload);
    paid = ownership_raw_facts_env.configure(&f, 65536);
    positive[0].upper.value = 4; bindings[0].kind = ownership_raw_facts.decision_kind.path;
    second = ownership_raw_facts.build_payload(input, &paid);
    ownership_raw_facts_env.good(&second);
    req.proposed = second.payload;
    result = ownership_raw_facts.measure_union(&req, &paid);
    ownership_raw_facts_env.counts(&result, 0, 1);
    assert(result.choices_complete && result.choices != null && result.choices->next != null);
    assert(result.choices->payload->choices[0].descriptor.kind ==
        ownership_raw_facts.decision_kind.path);
    assert(result.choices->next->payload->choices[0].descriptor.kind ==
        ownership_raw_facts.decision_kind.opaque);
    ownership_raw_facts.free_union_result(&result);
    ownership_raw_facts.free_payload(&second.payload);
    paid = ownership_raw_facts_env.configure(&f, 65536);
    indices[0] = 1;
    second = ownership_raw_facts.build_payload(input, &paid);
    ownership_raw_facts_env.refused(second.proof, ownership_api.incomplete_reason.invalid_input);
    assert(second.payload == null);
    paid = ownership_raw_facts_env.configure(&f, 65536);
    indices[0] = 0; bindings[0].complete = false;
    second = ownership_raw_facts.build_payload(input, &paid);
    ownership_raw_facts_env.refused(second.proof, ownership_api.incomplete_reason.invalid_input);
    assert(second.payload == null);
    ownership_raw_facts.free_union_result(&result);
    ownership_raw_facts.free_payload(&first.payload);
    assert(ownership_depth_env.finish() > 0);
}
fn main() i32 {
    empty(); union_and_replacement(); region_distinctions(); core_regions();
    core_representatives(); memberships(); choices();
    descriptor_controls(); choice_identity_controls();
    println("raw fact union ok");
    return 0;
}
