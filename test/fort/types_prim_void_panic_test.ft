//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: types.type_prim: prim_void as a primitive type: use type_void
//! stdout:
//| 4
/// `void` is a type kind of its own rather than a primitive, so type_prim of
/// prim_void is a broken precondition.
import fort.prim;
import fort.types;
import types_env;

fn main() i32 {
    types_env.env mut* own e = types_env.make();
    defer types_env.drop_made(move(e));
    println(types.type_sizeof(types.type_prim(&e->tt, prim.prim_kind.prim_i32)));
    println(types.type_sizeof(types.type_prim(&e->tt, prim.prim_kind.prim_void)));
    return 0;
}
