//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: ownership_api.teardown: event destructor is absent
//! stdout:
//| empty
/// An event handle that holds a context also holds the destructor of that context. A context
/// with no destructor breaks that precondition, so teardown panics before it leaks.
import ownership_api;

fn main() i32 {
    i32 mut x = 0;
    ownership_api.state_handle mut state = ownership_api.state_handle{};
    ownership_api.event_handle mut events = ownership_api.event_handle{};
    ownership_api.teardown(&state, &events);
    println("empty");
    events.context = cast(&x, void mut*);
    ownership_api.teardown(&state, &events);
    return 0;
}
