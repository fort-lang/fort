//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: types.spell_base: spelling a reference as a base
//! stdout:
//| i32
/// spell writes the suffixes of a pointer, span or array and passes only the innermost
/// base to spell_base. A pointer type breaks that precondition, so the call panics.
import std.strbuf;
import fort.types;
import types_env;

fn main() i32 {
    strbuf.str_buf mut out = strbuf.str_buf{};
    defer del(out.data);
    types_env.env mut* own e = types_env.make();
    defer types_env.drop_made(move(e));
    types.spell_base(types_env.type_of(e, "i32"), &out);
    println(strbuf.view(&out));
    types.spell_base(types_env.type_of(e, "i32*"), &out);
    return 0;
}
