//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: run_env.parse_breaks_made: a text that keeps each rule goes through parse_made
//! stdout:
//| ready
/// run_env.parse_breaks_made stops the test for the count 0, with no look at the text: the count
/// 0 is that of the strict helper run_env.parse_made.
import fort.fir;
import premise_env;
import run_env;

// A panic ends the program, so the case stands in a file of its own.
fn main() i32 {
    run_env.env mut* own e = run_env.make();
    defer run_env.drop_made(move(e));
    run_env.check(e, premise_env.PRELUDE[..]);
    println("ready");
    fir.module mut* own m = run_env.parse_breaks_made(e, premise_env.MIXED[..], 0);
    defer fir.module_drop_made(move(m));
    return 0;
}
