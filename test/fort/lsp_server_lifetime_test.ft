//! run
//! flags: -I ../../src/fort -I support -I ../../src
//! stdout:
//| sessions ok
//| messages ok
//| documents ok
//| ok
/// Checks server resource release. A session that handles 2,000 messages must return the heap
/// to its starting range.
import lsp.docs;
import lsp.rpc;
import lsp.server;
import lsp_env;
import std.io;
import std.strbuf;

//
// The scripts use files instead of a pipe. A pipe holds 64 KiB, and nothing
// drains it while the server reads. Two thousand messages would fill it. The
// server would then wait for a writer that already returned. The harness runs
// a test in a directory of its own, so a
// file the test writes is the test's alone.
//
// The program break is the one view here, and the small-block view is off on purpose. A round
// of this file allocates tens of kilobytes and gives all of it back, which leaves free chunks
// of every size. A 32-byte probe lands wherever one starts. It moved 22800
// bytes with no leak. This noise makes the small-block view unsuitable.
// Removing any of the six server.free releases turns the break probe red.

// The rounds of the session probe and the distance in bytes that fails it.
// Each round runs and frees a complete session. The session includes a server,
// its buffers, its parsed document, and two open documents of about two kibibytes.
// One retained document moves the break by kilobytes.
// Two hundred retained documents exceed the process's initial heap.
u64 SESSION_ROUNDS = 200;
u64 BOUND = 8192;

// What that pair can see, counted off the two sample points and not off
// SESSION_ROUNDS. The early sample is taken after round 4 (`i == 3` below) and
// `moved` takes the smallest distance over the last 16 rounds. So the nearest
// late sample is round 185 (`i == 184`) and the span the bound covers is 181
// rounds. 8192 over 181 is about 45 bytes a round. So a leak below 45 bytes
// per session sits under this probe and a leak above it does not. Every
// release of server.free is far above that. The smallest deletion moved the
// break by 212992 bytes. A new release of a few bytes needs more rounds,
// since the bound is the allocator's own noise.

// The messages of the long session, and how many of them the probe holds
// against the early sample. Two thousand didChange notifications of a
// kibibyte each are 2 MB of text through one server. A server that kept one
// text of each moves the break by that much.
u64 MESSAGES = 2000;
u64 EARLY_MESSAGE = 200;

// How many of the last rounds the probe holds against the early round. The
// allocator does not hand a round the same block every time. So the probe
// takes the smallest distance over a window that covers the cycle.
u64 LATE_SAMPLES = 16;

// The bytes of the text each didChange carries.
u64 TEXT_BYTES = 1024;

// The files the scripts go through. The harness gives the program a directory
// of its own, so these names are the test's alone.
string SESSION_FILE = "session.bin";
string LONG_FILE = "long.bin";
string ANSWER_FILE = "answers.bin";

// The current program break, which is the end of the heap. sbrk(0) moves
// nothing and reports it. std has no binding for it and these tests are its
// only callers.
extern fn sbrk(i64 increment) void*;

fn probe_address() u64 {
    return cast(sbrk(0), u64);
}

// How far apart two addresses are, whichever way the heap moved.
fn distance(u64 a, u64 b) u64 {
    if (a > b) {
        return a - b;
    }
    return b - a;
}

// The smallest distance from the early sample to any of the late ones.
fn moved(u64 early, u64[16] late) u64 {
    u64 mut best = distance(late[0], early);
    u64 mut i = 1;
    while (i < LATE_SAMPLES) {
        u64 one = distance(late[i], early);
        if (one < best) {
            best = one;
        }
        i += 1;
    }
    return best;
}

// One frame around `body`, appended to `b`.
fn frame_into(strbuf.str_buf mut* b, string body) void {
    strbuf.append(b, "Content-Length: ");
    strbuf.append_u64(b, body.len);
    strbuf.append(b, "\r\n\r\n");
    strbuf.append(b, body);
}

// A text of TEXT_BYTES bytes that holds no character JSON escapes.
fn text_into(strbuf.str_buf mut* b) void {
    strbuf.clear(b);
    while (b->len < TEXT_BYTES) {
        strbuf.append(b, "fn main() i32 { return 0; } ");
    }
}

// A didChange of `uri` carrying `body`.
fn change_into(strbuf.str_buf mut* script, string uri, string body, i64 version) void {
    strbuf.str_buf mut params = strbuf.create();
    defer strbuf.free(&params);
    strbuf.append(&params, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",");
    strbuf.append(&params, "\"params\":{\"textDocument\":{\"uri\":\"");
    strbuf.append(&params, uri);
    strbuf.append(&params, "\",\"version\":");
    strbuf.append_i64(&params, version);
    strbuf.append(&params, "},\"contentChanges\":[{\"text\":\"");
    strbuf.append(&params, body);
    strbuf.append(&params, "\"}]}}");
    frame_into(script, strbuf.view(&params));
}

// A didOpen of `uri` carrying `body`.
fn open_into(strbuf.str_buf mut* script, string uri, string body) void {
    strbuf.str_buf mut params = strbuf.create();
    defer strbuf.free(&params);
    strbuf.append(&params, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",");
    strbuf.append(&params, "\"params\":{\"textDocument\":{\"uri\":\"");
    strbuf.append(&params, uri);
    strbuf.append(&params, "\",\"version\":1,\"text\":\"");
    strbuf.append(&params, body);
    strbuf.append(&params, "\"}}}");
    frame_into(script, strbuf.view(&params));
}

// A didClose of `uri`.
fn close_into(strbuf.str_buf mut* script, string uri) void {
    strbuf.str_buf mut params = strbuf.create();
    defer strbuf.free(&params);
    strbuf.append(&params, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didClose\",");
    strbuf.append(&params, "\"params\":{\"textDocument\":{\"uri\":\"");
    strbuf.append(&params, uri);
    strbuf.append(&params, "\"}}}");
    frame_into(script, strbuf.view(&params));
}

// Writes `bytes` to `path`, which the server then reads as its input.
fn write_script(string path, string bytes) void {
    assert(io.write_file(path, cast(bytes, u8@)));
}

// One session over the script in `path`, from the first byte to the end of the
// stream. The answers go to a file, which no probe reads.
fn session(string path) i32 {
    i32 in_fd = io.open_read(path);
    assert(in_fd >= 0);
    i32 out_fd = io.open_write(ANSWER_FILE);
    assert(out_fd >= 0);
    server.server mut srv = server.create(in_fd, out_fd);
    i32 status = server.run(&srv);
    server.free(&srv);
    assert(io.close(in_fd));
    assert(io.close(out_fd));
    return status;
}

// ---- a session gives back everything it took -------------------------------------

fn the_session_script(strbuf.str_buf mut* script) void {
    strbuf.clear(script);
    strbuf.str_buf mut body = strbuf.create();
    defer strbuf.free(&body);
    text_into(&body);
    frame_into(script, "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{}}");
    frame_into(script, "{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{}}");
    open_into(script, "file:///a.ft", strbuf.view(&body));
    open_into(script, "file:///b.ft", strbuf.view(&body));
    u64 mut i = 0;
    while (i < 8) {
        change_into(script, "file:///a.ft", strbuf.view(&body), cast(i, i64) + 2);
        i += 1;
    }
    // An unknown method and a malformed body, so the round covers the two
    // answers that build a message of their own.
    frame_into(script, "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/hover\"}");
    frame_into(script, "{\"jsonrpc\":");
    // A request whose method name and whose string id are each a kibibyte.
    // The server copies the id into a buffer of its own and builds the "not
    // implemented" message in another. So a round that keeps either of those
    // two buffers moves the break rather than hiding inside a round's noise.
    strbuf.str_buf mut long_name = strbuf.create();
    defer strbuf.free(&long_name);
    while (long_name.len < TEXT_BYTES) {
        strbuf.append(&long_name, "aMethodNoServerImplements/");
    }
    strbuf.str_buf mut long_request = strbuf.create();
    defer strbuf.free(&long_request);
    strbuf.append(&long_request, "{\"jsonrpc\":\"2.0\",\"id\":\"");
    strbuf.append(&long_request, strbuf.view(&long_name));
    strbuf.append(&long_request, "\",\"method\":\"");
    strbuf.append(&long_request, strbuf.view(&long_name));
    strbuf.append(&long_request, "\"}");
    frame_into(script, strbuf.view(&long_request));
    close_into(script, "file:///a.ft");
    frame_into(script, "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"shutdown\",\"params\":null}");
    frame_into(script, "{\"jsonrpc\":\"2.0\",\"method\":\"exit\",\"params\":null}");
}

fn a_session_gives_back_everything_it_took() void {
    strbuf.str_buf mut script = strbuf.create();
    defer strbuf.free(&script);
    the_session_script(&script);
    write_script(SESSION_FILE, strbuf.view(&script));
    u64 mut early_break = 0;
    u64[16] mut late_break = u64[16]{};
    u64 mut i = 0;
    while (i < SESSION_ROUNDS) {
        assert(session(SESSION_FILE) == 0);
        if (i == 3) {
            early_break = probe_address();
        }
        if (i + LATE_SAMPLES >= SESSION_ROUNDS) {
            late_break[i + LATE_SAMPLES - SESSION_ROUNDS] = probe_address();
        }
        i += 1;
    }
    u64 break_moved = moved(early_break, late_break);
    if (break_moved >= BOUND) {
        println("the break moved ", break_moved);
    }
    assert(break_moved < BOUND);
}

// ---- a long session does not grow --------------------------------------------

fn a_session_of_two_thousand_messages_does_not_grow() void {
    // One server, one document, two thousand changes of a kibibyte each. The
    // document the reader parses is cleared and not freed between messages, so
    // the arena settles at the largest message. The read buffer drops the frame
    // it answered, and the store holds one text at a time. The break must
    // therefore stand still from the two-hundredth message to the last.
    strbuf.str_buf mut script = strbuf.create();
    defer strbuf.free(&script);
    strbuf.str_buf mut body = strbuf.create();
    defer strbuf.free(&body);
    text_into(&body);
    frame_into(&script, "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{}}");
    open_into(&script, "file:///a.ft", strbuf.view(&body));
    u64 mut i = 0;
    while (i < MESSAGES) {
        change_into(&script, "file:///a.ft", strbuf.view(&body), cast(i, i64) + 2);
        i += 1;
    }
    write_script(LONG_FILE, strbuf.view(&script));

    i32 in_fd = io.open_read(LONG_FILE);
    assert(in_fd >= 0);
    i32 out_fd = io.open_write(ANSWER_FILE);
    assert(out_fd >= 0);
    server.server mut srv = server.create(in_fd, out_fd);
    u64 mut early_break = 0;
    u64[16] mut late_break = u64[16]{};
    u64 mut seen = 0;
    // The two messages before the changes, and the changes themselves.
    u64 steps = MESSAGES + 2;
    // step answers false at the end of the stream, which is where the script
    // ends. Every message before that is one step.
    while (server.step(&srv)) {
        seen += 1;
        if (seen == EARLY_MESSAGE) {
            early_break = probe_address();
        }
        if (seen + LATE_SAMPLES > steps) {
            late_break[seen + LATE_SAMPLES - steps - 1] = probe_address();
        }
    }
    lsp_env.check_u64(seen, steps, "the messages of the long session");
    // The document holds the last text the client sent.
    lsp_env.check(docs.text_of(server.documents(&srv), "file:///a.ft"), strbuf.view(&body),
                  "the text after two thousand changes");
    lsp_env.check_i64(docs.version_of(server.documents(&srv), "file:///a.ft"),
                      cast(MESSAGES, i64) + 1, "the version after two thousand changes");
    u64 break_moved = moved(early_break, late_break);
    if (break_moved >= BOUND) {
        println("the break moved ", break_moved);
    }
    assert(break_moved < BOUND);
    server.free(&srv);
    assert(io.close(in_fd));
    assert(io.close(out_fd));
}

// ---- the documents of a session --------------------------------------------------

fn a_session_of_many_documents_gives_them_all_back() void {
    // One session opens and closes fifty
    // documents. This exercises store
    // growth and removal inside the server loop.
    strbuf.str_buf mut script = strbuf.create();
    defer strbuf.free(&script);
    strbuf.str_buf mut body = strbuf.create();
    defer strbuf.free(&body);
    text_into(&body);
    strbuf.str_buf mut uri = strbuf.create();
    defer strbuf.free(&uri);
    frame_into(&script, "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{}}");
    u64 mut i = 0;
    while (i < 50) {
        strbuf.clear(&uri);
        strbuf.append(&uri, "file:///many/");
        strbuf.append_u64(&uri, i);
        strbuf.append(&uri, ".ft");
        open_into(&script, strbuf.view(&uri), strbuf.view(&body));
        i += 1;
    }
    i = 0;
    while (i < 25) {
        strbuf.clear(&uri);
        strbuf.append(&uri, "file:///many/");
        strbuf.append_u64(&uri, i);
        strbuf.append(&uri, ".ft");
        close_into(&script, strbuf.view(&uri));
        i += 1;
    }
    write_script(SESSION_FILE, strbuf.view(&script));
    u64 mut early_break = 0;
    u64[16] mut late_break = u64[16]{};
    u64 mut round = 0;
    while (round < 60) {
        // The status is 1: the stream ends without a shutdown.
        assert(session(SESSION_FILE) == 1);
        if (round == 3) {
            early_break = probe_address();
        }
        if (round + LATE_SAMPLES >= 60) {
            late_break[round + LATE_SAMPLES - 60] = probe_address();
        }
        round += 1;
    }
    u64 break_moved = moved(early_break, late_break);
    if (break_moved >= BOUND) {
        println("the break moved ", break_moved);
    }
    assert(break_moved < BOUND);
}

fn main() i32 {
    a_session_gives_back_everything_it_took();
    println("sessions ok");
    a_session_of_two_thousand_messages_does_not_grow();
    println("messages ok");
    a_session_of_many_documents_gives_them_all_back();
    println("documents ok");
    println("ok");
    return 0;
}
