//! run
//! flags: -I ../../src -I support
//! stdout:
//| ok
/// The check document mode. `--index` runs the front end, the index walk and
/// the document writer in each round, and the document goes to the captured
/// stdout. `--index` implies `--check --json`, so the three of them are one
/// option here. The driver gives all of it back.
import lifetime;
import std.strbuf;

//
// support/lifetime.ft states the rule of the probe, its view and the
// size of a round. Each file tests one driver mode. This keeps every program
// below the harness limit of 60 s under load.
//
// This mode adds the releases of the identifier index. driver.write_document
// releases `doc`, and driver.check_document releases the file list and the
// index. At b6676ced the deletion of `defer del(doc.data)` moved the live view
// by 31727168 bytes under glibc 2.39 and 2.43, and the deletion of
// `defer del(files.items)` moved it by 131104 bytes or more. index.free
// released the record span, the type spelling pool and the spelling buffer,
// and the deferred block of driver.check_document released each of the three
// again, so the deletion of one release in index.free moved no probe. Now
// driver.check_document holds its index in an allocation of index.make, and
// `index.drop_made` reaches index.drop, which makes each of the three
// releases once: the deletion of each turns this test red.
//
// The width was chosen to make two small releases visible: the file list and
// the spelling buffer. Each record carries a long type spelling. At b6676ced
// the deletion of the file list moved the live view by 131104 bytes or more.
// The deletion of `del(ix.msg.data)` from index.drop turns this test red.
//
// The width was 27 and not 40 for the system view, which does not see a block
// that glibc serves by mmap. The driver.write_document buffer holds the
// complete document, and a strbuf doubles its capacity. A document above
// 65536 bytes gives the buffer a capacity of 131072, and glibc serves that
// block by mmap. At width 40 the document was 92003 bytes, and the deletion
// of `doc` did not move the system view. At 27 the document was 62541 bytes.
// The live view counts the mmap blocks too. Measure the document size when
// the width or the document format changes.
//
// The round count is one quarter of a front-end mode's count. The live view
// stops moving by round 9 with nothing kept, and the early sample comes at
// round 500.
u64 INDEX_ROUNDS = 1000;
u64 INDEX_WIDTH = 27;

fn main() i32 {
    lifetime.write_runtime();
    write_indexed();
    string[3] mut indexed = {"fort", "--index", "indexed.ft"};
    assert(lifetime.measure_rounds(indexed[0..3], INDEX_ROUNDS) < lifetime.BOUND);
    println("ok");
    return 0;
}

// Writes a program that allocates each identifier-index resource. Every
// identifier creates a record, and every record creates a type spelling. A
// long spelling also grows the spelling buffer.
//
// This test is the only witness of `defer del(doc.data)` in
// driver.write_document, of `defer del(files.items)` in
// driver.check_document, and of the three releases of index.drop.
//
// The width is what makes the file list visible. A file list of one name and
// a buffer that holds one spelling are a few hundred bytes in each round. So
// the type of every local is written `a_structure_with_a_long_name mut*
// own`, which is 38 bytes interned one time for each record.
fn write_indexed() void {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "struct a_structure_with_a_long_name {\n    i32 value;\n}\n");
    u64 mut i = 0;
    while (i < INDEX_WIDTH) {
        // One constant apiece: a declaration and a use are two records. And
        // each record interns a spelling of its own, since the pool copies
        // rather than deduplicates (containers.ft).
        strbuf.append(&b, "i32 LIMIT");
        strbuf.append_u64(&b, i);
        strbuf.append(&b, " = ");
        strbuf.append_u64(&b, i);
        strbuf.append(&b, ";\n");
        i += 1;
    }
    strbuf.append(&b, "fn main() i32 {\n    i32 mut total = 0;\n");
    i = 0;
    while (i < INDEX_WIDTH) {
        // One owning local apiece, whose type spelling is the longest this
        // program writes. The record of its declaration and the record of its
        // use in `del` each carry it.
        strbuf.append(&b, "    a_structure_with_a_long_name mut* own p");
        strbuf.append_u64(&b, i);
        strbuf.append(&b, " = new(a_structure_with_a_long_name);\n");
        strbuf.append(&b, "    total += p");
        strbuf.append_u64(&b, i);
        strbuf.append(&b, "->value + LIMIT");
        strbuf.append_u64(&b, i);
        strbuf.append(&b, ";\n    del(p");
        strbuf.append_u64(&b, i);
        strbuf.append(&b, ");\n");
        i += 1;
    }
    // The function has INDEX_WIDTH parameters and
    // a pointer to it. Its type spelling grows the
    // spelling buffer past one block. The deferred
    // block of driver.check_document releases that
    // buffer again after `strbuf.free(&ix->msg)`, so
    // at b6676ced the deletion of that call moved no
    // probe.
    strbuf.append(&b, "    fn (");
    i = 0;
    while (i < INDEX_WIDTH) {
        if (i > 0) {
            strbuf.append(&b, ", ");
        }
        strbuf.append(&b, "i32");
        i += 1;
    }
    strbuf.append(&b, ") i32 op = wide;\n    total += op(");
    i = 0;
    while (i < INDEX_WIDTH) {
        if (i > 0) {
            strbuf.append(&b, ", ");
        }
        strbuf.append_u64(&b, i);
        i += 1;
    }
    strbuf.append(&b, ");\n");
    strbuf.append(&b, "    return total;\n}\n");
    // The function the pointer above denotes, declared after it: a module's
    // declarations are order-independent.
    strbuf.append(&b, "fn wide(");
    i = 0;
    while (i < INDEX_WIDTH) {
        if (i > 0) {
            strbuf.append(&b, ", ");
        }
        strbuf.append(&b, "i32 a");
        strbuf.append_u64(&b, i);
        i += 1;
    }
    strbuf.append(&b, ") i32 {\n    return a0;\n}\n");
    lifetime.write_file("indexed.ft", strbuf.view(&b));
}
