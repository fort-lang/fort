//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| ok
/// The check document mode. `--index` runs the front end, the index walk and
/// the document writer in each round, and the document goes to the captured
/// stdout. `--index` implies `--check --json`, so the three of them are one
/// option here. The driver gives all of it back.
import lifetime;
import std.strbuf;

//
// support/lifetime.ft states the rule of the probe, the two views and the
// size of a round. Each file tests one driver mode. This keeps every program
// below the harness limit of 60 s under load.
//
// This mode adds six releases. index.free releases the record span, the type
// spelling pool, and the spelling buffer. driver.check_document releases the
// file list and the index. driver.write_document releases `doc`.
//
// The width makes the small releases visible. Each round allocates 256 bytes
// for a spelling buffer and a one-name vector. Each record also carries a long
// type spelling. These allocations then affect a complete round.
//
// The width also has a ceiling, and the ceiling is why it is 27 and not 40.
// The driver.write_document buffer holds the complete document. A strbuf
// doubles its capacity. A document above 65536 bytes therefore gives the
// buffer a capacity of 131072. glibc serves that block through mmap, so the
// system view does not move. At width 40, the document is 92003 bytes and
// removing `strbuf.free(&doc)` is invisible to this test. At 27, the document
// is 62541 bytes and the buffer is a heap
// block of 65536, and the deletion turns this test red. A width that makes
// the document exceed 65536 bytes hides that release from the probe. Measure
// the document size when the width or document format changes.
// The shared lifetime probe states the measurement rule.
//
// The round count is one quarter of a front-end mode's count. At 1000 rounds,
// all six releases turn this test red. Each small release then leaks 256 KB.
u64 INDEX_ROUNDS = 1000;
u64 INDEX_WIDTH = 27;

fn main() i32 {
    lifetime.write_runtime();
    write_indexed();
    string[3] mut indexed = {"fort", "--index", "indexed.ft"};
    assert(lifetime.measure_rounds(indexed[0..3], INDEX_ROUNDS, true) < lifetime.BOUND);
    println("ok");
    return 0;
}

// Writes a program that allocates each identifier-index resource. Every
// identifier creates a record, and every record creates a type spelling. A
// long spelling also grows the spelling buffer.
//
// This test is the only witness of six releases. index.free runs
// `del(ix->entries)`, `containers.pool_free(&ix->pool)`, and
// `strbuf.free(&ix->msg)`. driver.check_document runs
// `containers.str_free(&files)` and `defer index.free(&ix)`.
// driver.write_document runs `defer strbuf.free(&doc)`.
// Every release of the six modes was measured this way, one deletion at a
// time, against all six tests. support/lifetime.ft records
// release counts for all six modes. It also records the
// measurement command and the release with no single-test witness.
//
// The width is what makes the two small ones visible. A file list of one name
// and a buffer that holds one spelling are a few hundred bytes in each round.
// So the type of every local is written `a_structure_with_a_long_name mut*
// own`, which is 38 bytes interned one time for each record.
fn write_indexed() void {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "struct a_structure_with_a_long_name {\n    i32 value;\n}\n");
    u64 mut i = 0;
    while (i < INDEX_WIDTH) {
        // One constant apiece: a declaration and a use are two records. And
        // each record interns a spelling of its own, since the pool copies
        // rather than deduplicates (containers.ft).
        strbuf.append(&b, "i32 LIMIT");
        strbuf.append_u64(&b, i);
        strbuf.append(&b, " = ");
        strbuf.append_u64(&b, i);
        strbuf.append(&b, ";\n");
        i += 1;
    }
    strbuf.append(&b, "fn main() i32 {\n    i32 mut total = 0;\n");
    i = 0;
    while (i < INDEX_WIDTH) {
        // One owning local apiece, whose type spelling is the longest this
        // program writes. The record of its declaration and the record of its
        // use in `del` each carry it.
        strbuf.append(&b, "    a_structure_with_a_long_name mut* own p");
        strbuf.append_u64(&b, i);
        strbuf.append(&b, " = new(a_structure_with_a_long_name);\n");
        strbuf.append(&b, "    total += p");
        strbuf.append_u64(&b, i);
        strbuf.append(&b, "->value + LIMIT");
        strbuf.append_u64(&b, i);
        strbuf.append(&b, ";\n    del(p");
        strbuf.append_u64(&b, i);
        strbuf.append(&b, ");\n");
        i += 1;
    }
    // The function has INDEX_WIDTH parameters and
    // a pointer to it. Its type spelling grows the
    // spelling buffer past one block. With the
    // spelling of the owning local alone, 38 bytes,
    // deleting `strbuf.free(&ix->msg)` left this test green.
    strbuf.append(&b, "    fn (");
    i = 0;
    while (i < INDEX_WIDTH) {
        if (i > 0) {
            strbuf.append(&b, ", ");
        }
        strbuf.append(&b, "i32");
        i += 1;
    }
    strbuf.append(&b, ") i32 op = wide;\n    total += op(");
    i = 0;
    while (i < INDEX_WIDTH) {
        if (i > 0) {
            strbuf.append(&b, ", ");
        }
        strbuf.append_u64(&b, i);
        i += 1;
    }
    strbuf.append(&b, ");\n");
    strbuf.append(&b, "    return total;\n}\n");
    // The function the pointer above denotes, declared after it: a module's
    // declarations are order-independent.
    strbuf.append(&b, "fn wide(");
    i = 0;
    while (i < INDEX_WIDTH) {
        if (i > 0) {
            strbuf.append(&b, ", ");
        }
        strbuf.append(&b, "i32 a");
        strbuf.append_u64(&b, i);
        i += 1;
    }
    strbuf.append(&b, ") i32 {\n    return a0;\n}\n");
    lifetime.write_file("indexed.ft", strbuf.view(&b));
}
