    rows();
    unexecuted_rows_before_solve();
    println("rows ok");
    closure();
    failed_prerequisites_leave_the_closure_unexecuted();
    println("closure ok");
    document();
    println("document ok");
    diagnostics();
    println("diagnostics ok");
    report_bound();
    println("report bound ok");
    local_refusal_in_the_document();
    totals_count_local_statuses();
    module_order();
    bound_between_violations();
    source_order();
    subjects();
    budget_errors();
    classification_ledger();
    terminal_budget_error();
    same_reasons();
    one_error_for_two_ledgers();
    return 0;
}
