//! run
//! flags: -I ../../src/fort -I support
//! link: support/ownership_depth_alloc.c
//! stdout:
//| choice prefixes 0:0 2
//| choice prefixes 3:0 12
//| choice prefixes 0:2 6
//| choice prefixes 3:2 22
//| payload prefixes 0:0:false 12
//| payload prefixes 3:0:false 25
//| payload prefixes 0:2:false 18
//| payload prefixes 3:2:false 37
//| payload prefixes 3:2:true 52
//| raw condition work ok
/// Tests permission before each condition visit and negative snapshot storage.
import ownership_api;
import ownership_depth_env;
import ownership_raw_facts;
import ownership_raw_facts_env;
import ownership_type_work;
import types;

fn binding(ownership_api.predicate_atom@ positive, ownership_api.predicate_atom@ negative)
    ownership_raw_facts.choice_view {
    return ownership_raw_facts.choice_view{
        .kind = ownership_raw_facts.decision_kind.opaque,
        .decision = ownership_raw_facts_env.id(ownership_api.entity_kind.guard, 0),
        .subject = ownership_raw_facts_env.path(0),
        .value_version = ownership_raw_facts_env.id(ownership_api.entity_kind.value, 0),
        .alternative = ownership_raw_facts_env.id(ownership_api.entity_kind.relation, 0),
        .positive = positive, .negative = negative, .complete = true};
}
fn atoms(ownership_api.predicate_atom mut@ values, u32 offset) void {
    u64 mut i = 0;
    while (i < values.len) {
        values[i] = ownership_raw_facts_env.atom(cast(i, u32) + offset,
            ownership_api.predicate_kind.inequality, 0, 1, 0, 0);
        i += 1;
    }
}
fn compatibility_empty_inner() void {
    ownership_depth_env.fixture mut f = {};
    ownership_type_work.work mut paid = ownership_raw_facts_env.configure(&f, 1);
    ownership_api.predicate_atom[8] positive = {};
    ownership_raw_facts.choice_view left = binding(positive[..], positive[..0]);
    ownership_raw_facts.choice_view right = binding(positive[..0], positive[..0]);
    assert(!ownership_raw_facts.compatible_choices(&paid, &left, &right));
    ownership_raw_facts_env.refused(paid.proof, ownership_api.incomplete_reason.work_limit);
    assert(f.meter.used.w == 1 && paid.proof.terminal.limit.attempted == 1);
}
fn compatibility_matrix() void {
    ownership_api.predicate_atom[3] mut positive = {};
    ownership_api.predicate_atom[2] mut negative = {};
    atoms(positive[..], 0); atoms(negative[..], 3);
    u64[4] positive_counts = {0, 3, 0, 3};
    u64[4] negative_counts = {0, 0, 2, 2};
    u64 mut row = 0;
    while (row < positive_counts.len) {
        ownership_raw_facts.choice_view left = binding(positive[..positive_counts[row]],
            negative[..negative_counts[row]]);
        u64 mut inner = 0;
        while (inner <= 2) {
            ownership_raw_facts.choice_view right = binding(positive[..inner], positive[..0]);
            u64 cost = 1 + (positive_counts[row] + negative_counts[row]) * (1 + inner);
            u64 mut allowance = 0;
            while (allowance <= cost) {
                ownership_depth_env.fixture mut f = {};
                ownership_type_work.work mut paid =
                    ownership_raw_facts_env.configure(&f, allowance);
                bool equal = ownership_raw_facts.compatible_choices(&paid, &left, &right);
                if (allowance < cost) {
                    assert(!equal);
                    ownership_raw_facts_env.refused(paid.proof,
                        ownership_api.incomplete_reason.work_limit);
                } else { assert(equal && ownership_api.successful(paid.proof)); }
                assert(f.meter.used.w == (allowance == 0 ? 1 : allowance));
                allowance += 1;
            }
            inner += 1;
        }
        row += 1;
    }
}
fn choice_prefixes(u64 positives, u64 negatives) void {
    ownership_api.predicate_atom[3] mut positive = {};
    ownership_api.predicate_atom[2] mut negative = {};
    atoms(positive[..], 0); atoms(negative[..], 3);
    ownership_raw_facts.choice_view input = binding(positive[..positives], negative[..negatives]);
    ownership_raw_facts.raw_fact_payload payload = {};
    ownership_depth_env.fixture mut f = {};
    ownership_type_work.work mut paid = ownership_raw_facts_env.configure(&f, 65536);
    ownership_depth_env.begin();
    ownership_raw_facts.choice mut complete = {};
    assert(ownership_raw_facts.build_choice(&paid, input, &payload, &complete));
    u64 cost = f.meter.used.w;
    assert(complete.descriptor.positive.len == positives);
    assert(complete.descriptor.negative.len == negatives);
    ownership_raw_facts.free_choice(&complete);
    ownership_depth_env.finish();
    u64 mut allowance = 0;
    while (allowance <= cost) {
        paid = ownership_raw_facts_env.configure(&f, allowance);
        ownership_depth_env.begin();
        ownership_raw_facts.choice mut result = {};
        bool okay = ownership_raw_facts.build_choice(&paid, input, &payload, &result);
        if (allowance < cost) {
            assert(!okay);
            ownership_raw_facts_env.refused(paid.proof, ownership_api.incomplete_reason.work_limit);
        } else { assert(okay && f.meter.used.w == cost); }
        ownership_raw_facts.free_choice(&result); ownership_raw_facts.free_choice(&result);
        ownership_depth_env.finish();
        assert(positive[0].key.ordinal == 0 && negative[0].key.ordinal == 3);
        allowance += 1;
    }
    println("choice prefixes ", positives, ":", negatives, " ", cost);
}
fn payload_prefixes(u64 positives, u64 negatives, bool core_atoms) void {
    ownership_api.predicate_atom[3] mut positive = {};
    ownership_api.predicate_atom[2] mut negative = {};
    atoms(positive[..], 0); atoms(negative[..], 3);
    ownership_raw_facts.choice_view[1] choices = {binding(positive[..positives],
        negative[..negatives])};
    ownership_depth_env.fixture mut f = {};
    ownership_type_work.work mut paid = ownership_raw_facts_env.configure(&f, 65536);
    ownership_raw_facts.payload_result mut input = ownership_raw_facts.build_payload(
        ownership_raw_facts.raw_fact_view{.choices = choices[..], .choices_complete = true}, &paid);
    ownership_raw_facts_env.good(&input);
    ownership_api.predicate_atom@ core_predicates = core_atoms ? positive[..] : positive[..0];
    ownership_raw_facts.core_inventory core = {};
    paid = ownership_raw_facts_env.configure(&f, 65536);
    ownership_depth_env.begin();
    ownership_raw_facts.union_keys mut keys = {};
    ownership_raw_facts.union_result mut complete = {};
    complete.choices_complete = true;
    assert(ownership_raw_facts.add_payload(input.payload, &core, core_predicates, &keys,
        &complete, &paid));
    u64 cost = f.meter.used.w;
    assert(complete.r == 0 && complete.p == 0 && complete.choices != null);
    ownership_raw_facts.free_keys(&keys); ownership_raw_facts.free_union_result(&complete);
    ownership_depth_env.finish();
    u64 mut allowance = 0;
    while (allowance <= cost) {
        paid = ownership_raw_facts_env.configure(&f, allowance);
        ownership_depth_env.begin();
        ownership_raw_facts.union_keys mut pending = {};
        ownership_raw_facts.union_result mut result = {};
        result.choices_complete = true;
        bool okay = ownership_raw_facts.add_payload(input.payload, &core, core_predicates,
            &pending, &result, &paid);
        if (allowance < cost) {
            assert(!okay);
            ownership_raw_facts_env.refused(paid.proof, ownership_api.incomplete_reason.work_limit);
        } else { assert(okay && f.meter.used.w == cost && result.choices != null); }
        ownership_raw_facts.free_keys(&pending); ownership_raw_facts.free_union_result(&result);
        ownership_depth_env.finish();
        assert(input.payload->choices[0].descriptor.positive.len == positives);
        assert(input.payload->choices[0].descriptor.negative.len == negatives);
        allowance += 1;
    }
    ownership_raw_facts.free_payload(&input.payload);
    println("payload prefixes ", positives, ":", negatives, ":", core_atoms, " ", cost);
}
fn negative_snapshots() void {
    ownership_depth_env.fixture mut f = {};
    ownership_type_work.work mut paid = ownership_raw_facts_env.configure(&f, 65536);
    types.node layout = ownership_raw_facts_env.integer();
    ownership_raw_facts.raw_region_view[1] regions = {
        ownership_raw_facts_env.region(&layout, 0, 0, 0, 8)};
    ownership_raw_facts.closed_bound_view[1] mut bounds = {ownership_raw_facts_env.bound(0, -3, 3)};
    ownership_raw_facts.ordered_relation_view[1] relations = {
        ownership_raw_facts.ordered_relation_view{ownership_raw_facts.literal(0),
        ownership_raw_facts.literal(3)}};
    ownership_api.predicate_atom[2] mut negative = {
        ownership_raw_facts_env.atom(0, ownership_api.predicate_kind.membership, 0, 0, 0, 4),
        ownership_raw_facts_env.atom(1, ownership_api.predicate_kind.inequality, 0, 1, 0, 0)};
    ownership_api.projection[1] mut projections = {ownership_api.projection{
        .kind = ownership_api.projection_kind.captured_index,
        .captured_version = ownership_raw_facts_env.id(ownership_api.entity_kind.value, 0)}};
    u64[1] mut indices = {0};
    ownership_raw_facts.choice_view[1] mut choices = {binding(negative[..0], negative[..])};
    choices[0].kind = ownership_raw_facts.decision_kind.path; choices[0].polarity = false;
    choices[0].subject.projections = projections[..];
    choices[0].regions = indices[..]; choices[0].bounds = indices[..];
    choices[0].relations = indices[..];
    ownership_depth_env.begin();
    ownership_raw_facts.payload_result mut payload = ownership_raw_facts.build_payload(
        ownership_raw_facts.raw_fact_view{regions[..], bounds[..], relations[..], choices[..],
        true, false}, &paid);
    ownership_raw_facts_env.good(&payload);
    ownership_raw_facts.payload_result mut copied =
        ownership_raw_facts.copy_payload(payload.payload, &paid);
    ownership_raw_facts_env.good(&copied);
    negative[0].upper.value = 99; negative[1].left.ordinal = 99;
    projections[0].captured_version.ordinal = 99; indices[0] = 99;
    bounds[0].lower = ownership_raw_facts.natural(99); choices[0].polarity = true;
    ownership_raw_facts.free_payload(&payload.payload);
    ownership_raw_facts.union_request req = ownership_raw_facts.union_request{
        .proposed = copied.payload};
    ownership_raw_facts.union_result mut result = ownership_raw_facts.measure_union(&req, &paid);
    ownership_raw_facts_env.counts(&result, 1, 2);
    ownership_raw_facts.free_payload(&copied.payload);
    ownership_raw_facts.raw_fact_payload* snapshot = result.choices->payload;
    ownership_raw_facts.choice_view kept = snapshot->choices[0].descriptor;
    assert(kept.positive.len == 0 && kept.negative.len == 2 && !kept.polarity);
    assert(kept.negative[0].upper.value == 4 && kept.negative[1].left.ordinal == 0);
    assert(kept.subject.projections[0].captured_version.ordinal == 0);
    assert(kept.regions[0] == 0 && kept.bounds[0] == 0 && kept.relations[0] == 0);
    assert(snapshot->bounds[0].lower.negative && snapshot->bounds[0].lower.magnitude == 3);
    assert(!snapshot->unconditional_proved && result.choices_complete);
    ownership_raw_facts.free_union_result(&result);
    assert(ownership_depth_env.finish() > 0);
}
fn main() i32 {
    compatibility_empty_inner(); compatibility_matrix();
    choice_prefixes(0, 0); choice_prefixes(3, 0); choice_prefixes(0, 2); choice_prefixes(3, 2);
    payload_prefixes(0, 0, false); payload_prefixes(3, 0, false);
    payload_prefixes(0, 2, false); payload_prefixes(3, 2, false);
    payload_prefixes(3, 2, true); negative_snapshots();
    println("raw condition work ok"); return 0;
}
