//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| failed retained-source teardown ok
/// Measures failed build and query teardown with allocator views.
import heap;
import ownership_api;
import ownership_borrows;
import ownership_borrows_env;
import ownership_limits;

u64 ROUNDS = 32;
u64 CALLS = 512;
u64 LATE_START = 16;

fn failed_result_teardown() void {
    ownership_borrows_env.env mut e = ownership_borrows_env.env{};
    ownership_borrows_env.allocator_setup(&e);
    defer ownership_borrows_env.close(&e);
    ownership_borrows_env.production(&e, ownership_limits.PRODUCTION_W,
        ownership_limits.PRODUCTION_E);
    ownership_borrows.graph mut complete = ownership_borrows_env.solve(&e);
    assert(ownership_api.successful(complete.proof));
    u64 fail_at = e.counts.meter.used.w - 1;
    ownership_borrows.free(&complete);
    u64 mut early_system = 0;
    u64 mut early_block = 0;
    u64 mut system_distance = ownership_api.U64_MAX;
    u64 mut block_distance = ownership_api.U64_MAX;
    u64 mut round = 0;
    while (round < ROUNDS) {
        u64 mut index = 0;
        while (index < CALLS) {
            ownership_borrows_env.production(&e, fail_at, ownership_limits.PRODUCTION_E);
            ownership_borrows.graph mut kept = ownership_borrows_env.solve(&e);
            assert(!ownership_api.successful(kept.proof) && kept.proof.terminal.limit.present);
            assert(kept.snapshot.contents_len == 18 && kept.snapshot.sources_len == 16);
            assert(kept.snapshot.blocks != null && kept.edges_len == 18);
            ownership_borrows.answer mut got = ownership_borrows_env.inspect(&e, &kept, 100);
            assert(!ownership_api.successful(got.proof));
            ownership_borrows.free(&kept);
            assert(kept.snapshot.blocks == null && kept.destinations.len == 0);
            ownership_borrows.free(&kept);
            ownership_borrows_env.production(&e, ownership_limits.PRODUCTION_W,
                ownership_limits.PRODUCTION_E);
            kept = ownership_borrows_env.solve(&e);
            assert(ownership_api.successful(kept.proof) && kept.visited.len == 16);
            ownership_borrows_env.production(&e, 1, ownership_limits.PRODUCTION_E);
            got = ownership_borrows_env.inspect(&e, &kept, 100);
            assert(!ownership_api.successful(got.proof) && got.proof.terminal.limit.present);
            ownership_borrows.free(&kept);
            assert(kept.visited.len == 0 && kept.queue.len == 0 && kept.matches.len == 0);
            ownership_borrows.free(&kept);
            index += 1;
        }
        u64 system_value = heap.system_view();
        u64 block_value = heap.block_view();
        if (round == 4) {
            early_system = system_value;
            early_block = block_value;
        }
        if (round >= LATE_START) {
            u64 mut distance_value = heap.distance(early_system, system_value);
            if (distance_value < system_distance) { system_distance = distance_value; }
            distance_value = heap.distance(early_block, block_value);
            if (distance_value < block_distance) { block_distance = distance_value; }
        }
        round += 1;
    }
    // The build refusal retains copied metadata. The query refusal retains all result buffers.
    u64 bound = heap.ADDRESS_IS_A_VIEW ? 8192 : 1024;
    if (system_distance >= bound || (heap.ADDRESS_IS_A_VIEW && block_distance >= bound)) {
        eprintln("allocator distances: system ", system_distance, " block ", block_distance);
        panic("failed retained-source teardown retains allocations");
    }
}

fn main() i32 {
    failed_result_teardown();
    println("failed retained-source teardown ok");
    return 0;
}
