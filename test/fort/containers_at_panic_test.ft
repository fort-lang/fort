//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: containers.str_at: index out of range
//! stdout:
//| a
//| b
import containers;

// str_at answers while the index is below len and panics one element later,
// because the slots between len and the capacity hold zero or stale strings
// and reading one would hand out a view of nothing. The vector has room for
// sixteen here and holds two, so the index that panics is inside the
// allocation: it is len that bounds the answer, not the capacity.
// D13.3
fn i32 main() {
    containers.str_vec mut v = containers.str_create();
    defer containers.str_free(&v);
    containers.str_push(&v, "a");
    containers.str_push(&v, "b");
    assert(v.items.len == 16);
    println(containers.str_at(&v, 0));
    println(containers.str_at(&v, 1));
    println(containers.str_at(&v, 2));
    return 0;
}
