//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: check.fold_float: folding an operator that takes no floats
//! stdout:
//| true
/// The checker refuses `%` on floats before it folds them. A call with `%` breaks that
/// precondition and panics.
import check;
import check_env;
import consts;
import diag;
import lexer;
import prim;

fn main() i32 {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    println(check_env.open_module(&e, check_env.src_main()));
    consts.cval mut out = consts.cval{};
    check.fold_float(&e.ck, diag.loc{}, cast(lexer.tok_kind.percent, i32), consts.cv_from_i64(1),
                     consts.cv_from_i64(2), prim.prim_kind.prim_f64, &out);
    return 0;
}
