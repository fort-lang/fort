//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: ownership report: effective configuration is absent
//! stdout:
//| 0
/// The driver sets target_os, target_arch and target_abi in the session before it writes a
/// report. A session that holds none of them breaks that precondition, so the call panics.
import containers;
import driver;
import session;

fn main() i32 {
    session.session mut s = session.create();
    defer session.free(&s);
    driver.options mut opts = driver.options_create();
    defer driver.options_free(&opts);
    containers.str_vec mut keys = containers.str_create();
    defer containers.str_free(&keys);
    containers.str_vec mut values = containers.str_create();
    defer containers.str_free(&values);
    println(keys.len);
    driver.report_configuration(&s, &opts, &keys, &values);
    return 0;
}
