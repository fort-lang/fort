//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: fir_llvm.hold: a scalar constant of an aggregate type
//! stdout:
//| true
/// A constant of an aggregate type is a string or a zero. An integer constant read as a pair
/// breaks that precondition, so hold panics.
import fort.consts;
import fort.fir;
import fir_env;
import fort.fir_llvm;
import llvm_env;
import fort.types;

string[6] PRELUDE = {
    "struct pair {",
    "    i32 a;",
    "    i32 b;",
    "}",
    "fn take(pair p) i32 {",
    "    return p.a;\n}",
};

string[8] TEXT = {
    "fn main.f() -> i32 {",
    "    let _1: pair;",
    "",
    "    bb0: {",
    "        _0 = call fn main.take(const zero pair) #1:1 s1;",
    "        return #1:1 s1;",
    "    }",
    "}",
};

// A panic ends the program, so the case stands in a file of its own.
fn main() i32 {
    llvm_env.env mut* own e = llvm_env.make();
    defer llvm_env.drop_made(move(e));
    // `m` lives in an allocation, so that the leak rule proves its end: no call changes the
    // pointer, and drop_made holds each release once.
    fir.module mut* own m = fir.module_make();
    *m = llvm_env.parse(e, PRELUDE[..], TEXT[..]);
    defer fir.module_drop_made(move(m));
    fir.func* f = fir.module_function_at(m, 0);
    llvm_env.begin(&e->g);
    // `t` ends in a block of its own, so that its `del`s come after the last call of its exit.
    {
        fir_llvm.translator mut t = fir_llvm.open(&e->g, f);
        defer {
            del(t.locals);
            del(t.notes);
            del(t.cont_of);
            del(t.fail_label);
        }
        types.node* i32t = fir_env.local_type(f, 0);
        types.node* pairt = fir_env.local_type(f, 1);
        println(fir.type_aggregate(pairt));
        fir.operand o = fir.operand{.kind = fir.operand_kind.ok_const,
                                    .value = fir.const_int(i32t, consts.cv_from_i64(1))};
        fir_llvm.hold(&t, o, pairt, false);
    }
    return 0;
}
