//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: consts: constant folding on a non-integer
//! stdout:
//| 97
/// cv_as_int takes an integer or a char. The checker has typed its
/// operand before folding, so a bool is a broken precondition.
import consts;

fn main() i32 {
    println(consts.cv_as_int(consts.cv_from_char(97)).mag);
    println(consts.cv_as_int(consts.cv_from_bool(true)).mag);
    return 0;
}
