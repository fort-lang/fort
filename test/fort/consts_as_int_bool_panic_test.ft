//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: consts: constant folding on a non-integer
//! stdout:
//| 97
import consts;

// cv_as_int takes an integer or a char (D4.3); the checker has typed its
// operand before folding, so a bool is a broken precondition (D13.3).
fn i32 main() {
    println(consts.cv_as_int(consts.cv_from_char(97)).mag);
    println(consts.cv_as_int(consts.cv_from_bool(true)).mag);
    return 0;
}
