//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: fir.module_function_at: index out of range
//! stdout:
//| ready
/// Checks the bound of fir.module_function_at: a module with one function has no function 1.
import fir;
import prim;
import types;

fn main() i32 {
    types.table mut tt = types.table{};
    defer types.type_table_free(&tt);
    types.node* i32t = types.type_prim(&tt, prim.prim_kind.prim_i32);
    types.node*[2] params = {i32t, i32t};
    types.node* fnty = types.type_fn(&tt, i32t, params[..], false);
    fir.func mut f = fir.func_new(&tt, null, fnty);
    defer fir.func_free(&f);
    fir.module mut m = fir.module_new();
    defer fir.module_free(&m);
    fir.module_add_function(&m, move(f));
    println("ready");
    fir.module_function_at(&m, 1);
    return 0;
}
