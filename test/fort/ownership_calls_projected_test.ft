//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| boundary G05.1
//| boundary G05.2
//| boundary G05.3
//| boundary G05.4
//| boundary X25
//| boundary A01-released-designated
//| boundary A02-live-designated-parameter
/// Checks designated output storage and selected source lifetimes.
import fir;
import ownership_api;
import ownership_calls;
import ownership_calls_env;
import ownership_calls_fixtures;
import ownership_state;
import ownership_summary_body;
import ownership_summary_model;
import ownership_transfer;
import std.strbuf;

string[9] SOURCE_0 = {
    "struct owner_box {",
    "    i32 mut* own item;",
    "    i32 tag;",
    "}",
    "struct view_box { i32* ptr; }",
    "struct inline_box { i32 value; }",
    "struct inline_view { i32 value; i32* ptr; }",
    "fn callee(i32 mut* own mut* out) void { *out = new(i32); }",
    "fn caller(i32 mut* own mut* out) void { callee(out); del(*out); }",
};
string[9] SOURCE_1 = {
    "struct owner_box {",
    "    i32 mut* own item;",
    "    i32 tag;",
    "}",
    "struct view_box { i32* ptr; }",
    "struct inline_box { i32 value; }",
    "struct inline_view { i32 value; i32* ptr; }",
    "fn callee(i32 mut* own mut* out) void { del(*out); *out = new(i32); }",
    "fn caller(i32 mut* own mut* out) void { callee(out); del(*out); }",
};
