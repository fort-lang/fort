fn child_slot(ownership_calls_fixtures.fixture mut* f, u32 parameter) ownership_api.place_path {
    ownership_api.projection[1] field = {ownership_api.projection{
        .kind = ownership_api.projection_kind.field, .field = 0}};
    ownership_api.place_path mut path = ownership_summary_body.caller_slot(&f->inputs[1],
        parameter);
    path.projections = field[..];
    return ownership_state.copy_place(&f->caller, path);
}

fn application_success(ownership_calls_fixtures.fixture* f) void {
    assert(ownership_api.successful(f->summary.proof));
    assert(ownership_api.successful(f->application.proof));
    assert(f->application.normal_continuation);
}

fn application_failure(ownership_calls_fixtures.fixture* f, bool incomplete) void {
    assert(ownership_api.successful(f->summary.proof));
    assert(f->application.proof.failed && !f->application.normal_continuation);
    assert(f->application.outcome.cleanup_required &&
        f->application.outcome.possible_caller_return);
    assert(f->application.proof.kind == (incomplete ? ownership_api.proof_kind.incomplete :
        ownership_api.proof_kind.complete));
    assert(f->services.counts.last.kind == (incomplete ? ownership_api.event_kind.incomplete_proof :
        ownership_api.event_kind.caller_requirement));
    assert(f->services.counts.last.evidence == (incomplete ?
        ownership_api.evidence_kind.abstract_possibility :
            ownership_api.evidence_kind.unconditional));
    assert(f->services.counts.last.source.line == f->call_request.source.line);
    assert(ownership_keys.operation(f->services.counts.last.operation,
        f->call_request.operation) == 0);
    assert(f->services.counts.last_note_count >= 1);
    assert(f->services.counts.last_notes[0].role == ownership_api.note_role.callee);
    assert(f->services.counts.last_notes[0].source.file == f->files[0].file);
    assert(f->services.counts.last_notes[0].source.filename_present);
    assert(ownership_summary_model.same(f->services.counts.last_notes[0].relation,
        f->services.counts.last.relation));
    assert(ownership_state.equal(&f->before, &f->caller));
}

fn borrow_child(ownership_calls_fixtures.fixture mut* f, ownership_api.place_path from,
    ownership_api.place_path to) void {
    u64 at = ownership_transfer.contents_index(&f->caller, from);
    assert(at != ownership_api.U64_MAX);
    ownership_api.contents_fact mut value = f->caller.contents[at];
    value.place = to;
    ownership_state.append_contents(&f->caller, value);
}


fn case_g06_1() void {
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    ownership_calls_fixtures.open(&f, CASE_G06_1_SOURCE[..]);
    defer ownership_calls_fixtures.close(&f);
    assert(ownership_api.successful(f.summary.proof));
    ownership_calls_fixtures.prepare(&f);
    ownership_api.place_path a = child_slot(&f, 1);
    ownership_api.entity_id allocation = seed_output_at(&f, true, a, 90);
    ownership_calls_env.reset(&f.services);
    ownership_calls_fixtures.apply(&f, 30);
    application_success(&f);
    assert(ownership_calls_fixtures.outstanding(&f.application.state) == 0);
    ownership_calls_fixtures.boundary("G06.1",
        "5393313dfec3bf588392a15a4f6326d84c917f22f05d0cb95a07dcd865d313bf", "none");
}

