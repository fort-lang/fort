//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: flt.bn_push: a constant needed more limbs than the bignum has
//! stdout:
//| 1
/// BN_LIMBS holds every value the float reader makes. bn_push on a full bignum breaks that
/// bound, so the call panics before it writes past the array.
import flt;

fn main() i32 {
    flt.bignum mut n = flt.bignum{};
    flt.bn_push(&n, 7);
    println(n.len);
    n.len = flt.BN_LIMBS;
    flt.bn_push(&n, 7);
    return 0;
}
