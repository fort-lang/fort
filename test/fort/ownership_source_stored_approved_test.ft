    defer strbuf.free(&text);
    analyze(&e, &text, lines[..]);
    defer ownership_source_env.close(&e);
    assert(body_count(&e) == 1);
    proved(&e, n, "demo");
}

// A trusted extern keeps a known alias.
fn ex19_known_alias(counts mut* n) void {
    string[11] lines = {
        "extern fn copy_bytes(u8 mut* dst, u8* src, u64 n) u8 mut*;",
        "fn demo() u8 {",
        "    u8 mut@ own dst = new(u8, 1);",
        "    u8 mut@ own src = new(u8, 1);",
        "    src[0] = 5;",
        "    u8 mut* result = copy_bytes(dst.ptr, src.ptr, 1);",
        "    u8 value = *result;",
        "    del(src);",
        "    del(dst);",
        "    return value;",
        "}",
    };
    ownership_source_env.env mut e = ownership_source_env.env{};
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    analyze(&e, &text, lines[..]);
    defer ownership_source_env.close(&e);
    assert(body_count(&e) == 1);
    proved(&e, n, "demo");
}

// A trusted extern with an unknown body keeps its trust.
fn ex19_unknown_extern(counts mut* n) void {
    string[5] lines = {
        "extern fn foreign_view() u8*;",
        "fn demo() u8 {",
        "    u8* p = foreign_view();",
        "    return *p;",
        "}",
    };
    ownership_source_env.env mut e = ownership_source_env.env{};
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    analyze(&e, &text, lines[..]);
    defer ownership_source_env.close(&e);
    assert(body_count(&e) == 1);
    proved(&e, n, "demo");
}

// An integer-to-pointer cast has no proved source: the raw storage increment.
fn ex20_raw_lost(counts mut* n) void {
    string[4] lines = {
        "fn bad(u64 bits) u8 {",
        "    u8* p = cast(bits, u8*);",
        "    return *p;",
        "}",
    };
    ownership_source_env.env mut e = ownership_source_env.env{};
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    analyze(&e, &text, lines[..]);
    defer ownership_source_env.close(&e);
    assert(body_count(&e) == 1);
    outside(&e, n, "bad", ownership_source_local.missing.unknown_source);
}

// A pointer that keeps its source through a raw round trip.
fn ex20_raw_preserved(counts mut* n) void {
    string[10] lines = {
        "fn demo() u8 {",
        "    u8 mut@ own bytes = new(u8, 4);",
        "    void mut* raw = cast(bytes.ptr, void mut*);",
        "    u8 mut* p = cast(raw, u8 mut*);",
        "    u8 mut@ view = p[0..4];",
        "    view[0] = 6;",
        "    u8 value = view[0];",
        "    del(bytes);",
        "    return value;",
        "}",
    };
    ownership_source_env.env mut e = ownership_source_env.env{};
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    analyze(&e, &text, lines[..]);
    defer ownership_source_env.close(&e);
    assert(body_count(&e) == 1);
    proved(&e, n, "demo");
}

fn main() i32 {
    counts mut n = counts{};
    ex01_local_view(&n);
    ex02_transfer(&n);
    ex03_consuming_call(&n);
    ex04_refill(&n);
    ex05_local_address(&n);
    ex06_local_span(&n);
    ex07_borrowed_return(&n);
    ex08_deferred_return(&n);
    ex09_retained_field(&n);
    ex10_call_alias(&n);
    ex11_output_owner(&n);
    ex12_partial_move(&n);
    ex13_owned_child(&n);
    ex14_aggregate_overwrite(&n);
    ex15_conditional_release(&n);
    ex16_loop_leak(&n);
    ex16_loop_transfer(&n);
    ex17_storage_growth(&n);
    ex18_retained_key(&n);
    ex19_call_only(&n);
    ex19_known_alias(&n);
    ex19_unknown_extern(&n);
    ex20_raw_lost(&n);
    ex20_raw_preserved(&n);
    println("approved examples ok");
    // 24 examples hold 31 bodies. The design accepts 8 examples: 2, 7, 11, 16 (loop
    // transfer), the three of 19, and 20 (preserved). None of their bodies has a stored
    // violation. Each stored violation and each excluded event is the rejected operation of
    // its example.
    assert(n.proved == 9 && n.violated == 4 && n.excluded == 4);
    assert(n.unwitnessed == 1 && n.outside == 13);
    println("verdicts ok");
    return 0;
}
