//! run
//! flags: -I ../../src/fort
//! stdout:
//| order ok
//| classes ok
//| sizes ok
//| names ok
//| ok
import prim;

// The primitive kinds of src/fort/prim.ft: the order the two range tests depend
// on, the classification, the sizes and the spellings.
// D3.1, D3.2, D2.4
//
// src/bootstrap/prim.h states the order as a _Static_assert, which fort has no
// spelling for, so this file is that assertion: notes/compiler.md 8 names prim.h's
// assertion as the site where the invariant becomes a test.

// The ordinal of a kind, as prim_ord computes it; an enum has no ordering
// operators, so both the module and this test read the i32 a cast yields.
// D3.9
fn ord(prim.prim_kind k) i32 {
    return cast(k, i32);
}

// The integer kinds lead prim_kind, the four signed ones first: prim_is_integer
// and prim_is_signed are range tests over exactly this order, so a reordering
// of the enum that left them alone would break both.
fn the_integer_kinds_lead_the_enum_signed_first() void {
    assert(ord(prim.prim_kind.prim_i8) == 0);
    assert(ord(prim.prim_kind.prim_i16) == 1);
    assert(ord(prim.prim_kind.prim_i32) == 2);
    assert(ord(prim.prim_kind.prim_i64) == 3);
    assert(ord(prim.prim_kind.prim_u8) == ord(prim.prim_kind.prim_i64) + 1);
    assert(ord(prim.prim_kind.prim_u16) == ord(prim.prim_kind.prim_u8) + 1);
    assert(ord(prim.prim_kind.prim_u32) == ord(prim.prim_kind.prim_u8) + 2);
    assert(ord(prim.prim_kind.prim_u64) == ord(prim.prim_kind.prim_u8) + 3);
    assert(ord(prim.prim_kind.prim_bool) == ord(prim.prim_kind.prim_u64) + 1);
    assert(ord(prim.prim_kind.prim_char) == ord(prim.prim_kind.prim_bool) + 1);
    assert(ord(prim.prim_kind.prim_f32) == ord(prim.prim_kind.prim_char) + 1);
    assert(ord(prim.prim_kind.prim_f64) == ord(prim.prim_kind.prim_f32) + 1);
    assert(ord(prim.prim_kind.prim_void) == ord(prim.prim_kind.prim_f64) + 1);
}

// PRIM_COUNT is one past the last kind: the C reads it off the enum, fort
// cannot, and types.ft sizes the table's `prims` array with the same number.
fn prim_count_is_one_past_the_last_kind() void {
    assert(prim.PRIM_COUNT == cast(ord(prim.prim_kind.prim_void) + 1, u64));
    assert(prim.PRIM_COUNT == 13);
}

// `bool` and `char` are not integers.
// D3.2, D3.3
fn is_integer_holds_for_i8_through_u64_only() void {
    assert(prim.prim_is_integer(prim.prim_kind.prim_i8));
    assert(prim.prim_is_integer(prim.prim_kind.prim_i16));
    assert(prim.prim_is_integer(prim.prim_kind.prim_i32));
    assert(prim.prim_is_integer(prim.prim_kind.prim_i64));
    assert(prim.prim_is_integer(prim.prim_kind.prim_u8));
    assert(prim.prim_is_integer(prim.prim_kind.prim_u16));
    assert(prim.prim_is_integer(prim.prim_kind.prim_u32));
    assert(prim.prim_is_integer(prim.prim_kind.prim_u64));
    assert(!prim.prim_is_integer(prim.prim_kind.prim_bool));
    assert(!prim.prim_is_integer(prim.prim_kind.prim_char));
    assert(!prim.prim_is_integer(prim.prim_kind.prim_f32));
    assert(!prim.prim_is_integer(prim.prim_kind.prim_f64));
    assert(!prim.prim_is_integer(prim.prim_kind.prim_void));
}

fn is_signed_holds_for_i8_through_i64_only() void {
    assert(prim.prim_is_signed(prim.prim_kind.prim_i8));
    assert(prim.prim_is_signed(prim.prim_kind.prim_i16));
    assert(prim.prim_is_signed(prim.prim_kind.prim_i32));
    assert(prim.prim_is_signed(prim.prim_kind.prim_i64));
    assert(!prim.prim_is_signed(prim.prim_kind.prim_u8));
    assert(!prim.prim_is_signed(prim.prim_kind.prim_u64));
    assert(!prim.prim_is_signed(prim.prim_kind.prim_bool));
    assert(!prim.prim_is_signed(prim.prim_kind.prim_char));
    assert(!prim.prim_is_signed(prim.prim_kind.prim_void));
}

fn is_float_holds_for_f32_and_f64_only() void {
    assert(prim.prim_is_float(prim.prim_kind.prim_f32));
    assert(prim.prim_is_float(prim.prim_kind.prim_f64));
    assert(!prim.prim_is_float(prim.prim_kind.prim_i64));
    assert(!prim.prim_is_float(prim.prim_kind.prim_u64));
    assert(!prim.prim_is_float(prim.prim_kind.prim_void));
}

// The sizes; `void` has none and answers 0.
// D3.1
fn sizes_are_those_of_d3_1() void {
    assert(prim.prim_size(prim.prim_kind.prim_i8) == 1);
    assert(prim.prim_size(prim.prim_kind.prim_u8) == 1);
    assert(prim.prim_size(prim.prim_kind.prim_bool) == 1);
    assert(prim.prim_size(prim.prim_kind.prim_char) == 1);
    assert(prim.prim_size(prim.prim_kind.prim_i16) == 2);
    assert(prim.prim_size(prim.prim_kind.prim_u16) == 2);
    assert(prim.prim_size(prim.prim_kind.prim_i32) == 4);
    assert(prim.prim_size(prim.prim_kind.prim_u32) == 4);
    assert(prim.prim_size(prim.prim_kind.prim_f32) == 4);
    assert(prim.prim_size(prim.prim_kind.prim_i64) == 8);
    assert(prim.prim_size(prim.prim_kind.prim_u64) == 8);
    assert(prim.prim_size(prim.prim_kind.prim_f64) == 8);
    assert(prim.prim_size(prim.prim_kind.prim_void) == 0);
}

// The bit width of an integer is its size times PRIM_BITS_PER_BYTE, which is
// how consts.ft and types.ft read a width.
fn the_bit_width_is_the_size_times_eight() void {
    assert(prim.PRIM_BITS_PER_BYTE == 8);
    assert(cast(prim.prim_size(prim.prim_kind.prim_i8), u64) * prim.PRIM_BITS_PER_BYTE == 8);
    assert(cast(prim.prim_size(prim.prim_kind.prim_u64), u64) * prim.PRIM_BITS_PER_BYTE == 64);
}

// The spelling of each type in source and in diagnostics.
// D2.4
fn names_are_the_source_spellings() void {
    assert(prim.prim_name(prim.prim_kind.prim_i8) == "i8");
    assert(prim.prim_name(prim.prim_kind.prim_i16) == "i16");
    assert(prim.prim_name(prim.prim_kind.prim_i32) == "i32");
    assert(prim.prim_name(prim.prim_kind.prim_i64) == "i64");
    assert(prim.prim_name(prim.prim_kind.prim_u8) == "u8");
    assert(prim.prim_name(prim.prim_kind.prim_u16) == "u16");
    assert(prim.prim_name(prim.prim_kind.prim_u32) == "u32");
    assert(prim.prim_name(prim.prim_kind.prim_u64) == "u64");
    assert(prim.prim_name(prim.prim_kind.prim_f32) == "f32");
    assert(prim.prim_name(prim.prim_kind.prim_f64) == "f64");
    assert(prim.prim_name(prim.prim_kind.prim_bool) == "bool");
    assert(prim.prim_name(prim.prim_kind.prim_char) == "char");
    assert(prim.prim_name(prim.prim_kind.prim_void) == "void");
}

fn main() i32 {
    the_integer_kinds_lead_the_enum_signed_first();
    prim_count_is_one_past_the_last_kind();
    println("order ok");
    is_integer_holds_for_i8_through_u64_only();
    is_signed_holds_for_i8_through_i64_only();
    is_float_holds_for_f32_and_f64_only();
    println("classes ok");
    sizes_are_those_of_d3_1();
    the_bit_width_is_the_size_times_eight();
    println("sizes ok");
    names_are_the_source_spellings();
    println("names ok");
    println("ok");
    return 0;
}
