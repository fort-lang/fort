//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: check_stmt.check_stmt: not a statement
//! stdout:
//| true
import ast;
import check_env;
import check_stmt;

/// Checks that check_stmt rejects a node kind that the parser cannot produce as a statement.
/// The broken precondition causes a panic.
fn main() i32 {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    println(check_env.open_module(&e, "fn main() i32 {\n    i32 k = 1;\n    return k;\n}\n"));
    // An identifier is an expression and never a statement.
    ast.node mut* id = check_env.node_in_main(&e, ast.ast_kind.k_ident, "k");
    check_stmt.check_stmt(&e.ck, id);
    return 0;
}
