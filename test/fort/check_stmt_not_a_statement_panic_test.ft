//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: check_stmt.check_stmt: not a statement
//! stdout:
//| true
import ast;
import check_env;
import check_stmt;

// check_stmt's switch names every node kind the parser produces for a
// statement. A node of any other kind is a tree this compiler's parser cannot
// build, so it is a violated precondition and panics, where
// src/bootstrap/check_stmt.c calls fatal_internal.
// D7.3, D13.3
fn main() i32 {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    println(check_env.open_module(&e, "fn main() i32 {\n    i32 k = 1;\n    return k;\n}\n"));
    // An identifier is an expression and never a statement.
    ast.node mut* id = check_env.node_in_main(&e, ast.ast_kind.k_ident, "k");
    check_stmt.check_stmt(&e.ck, id);
    return 0;
}
