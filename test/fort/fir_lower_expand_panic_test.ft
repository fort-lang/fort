//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: fir_lower.unwind: an exit with no scope to leave above the floor
//! stdout:
//| the deferred break has a loop outside it
/// Checks that the expansion of a deferred statement raises the floor (spec/fir.md 9.5): a `break`
/// inside the deferred statement walks no scope that was open before the expansion. The checker
/// refuses such a `break` (D7.8), so the test wraps the `break` of a checked loop in a `defer`
/// node of its own and records it in the scope of that loop. Without the floor the `break` would
/// find the loop, expand its deferred statements, and so itself again, with no end.
import fort.ast;
import check_env;
import fort.diag;
import fort.fir;
import fort.fir_lower;
import fort.gen;
import lower_env;

fn main() i32 {
    lower_env.env mut* own e = lower_env.make();
    defer lower_env.drop_made(move(e));
    string[5] source = {
        "fn f(bool c) void {",
        "    while (c) {",
        "        break;",
        "    }",
        "}",
    };
    lower_env.check_lines(e, source[..], true);
    expand_the_deferred_break(e);
    return 0;
}

// Expands a deferred `break` of the loop of `f`. The function takes the environment as a
// parameter, so the reads through `decl` and `brk` use no owner of its frame. The read of the
// location comes before `f` and `lw` exist (D17.21).
fn expand_the_deferred_break(lower_env.env mut* e) void {
    ast.node mut* decl = check_env.sym_main(&e->c, "f")->node;
    ast.node mut* loop = ast.ast_child_mut(decl->b, 0);
    ast.node mut* brk = ast.ast_child_mut(loop->b, 0);
    diag.loc at = brk->loc;
    // `f` lives in an allocation, so that the leak rule proves its end: no call changes the
    // pointer, and drop_made holds each release once.
    fir.func mut* own f = fir.func_make();
    *f = fir.func_new(&e->c.ck.types, decl->sym, decl->sym->ty);
    defer fir.func_drop_made(move(f));
    // An arena holds the wrapper: a node owns the nodes made before it through a chain, and the
    // drop of the arena ends that chain.
    ast.arena mut* own ar = ast.arena_make();
    defer ast.arena_drop_made(move(ar));
    ast.node mut* wrapper = ast.ast_new(ar, ast.ast_kind.k_defer, at);
    wrapper->a = brk;
    // `lw` ends in a block of its own, so that its `del`s come after the last call of its exit.
    {
        fir_lower.lowerer mut lw = fir_lower.lowerer{.ck = &e->c.ck, .f = f};
        defer {
            del(lw.scopes.items);
            del(lw.defers.items);
            del(lw.named.items);
        }
        fir_lower.scope_push(&lw, fir_lower.scope_kind.sc_fn, 0, 0);
        fir_lower.scope_push(&lw, fir_lower.scope_kind.sc_loop, 0, 0);
        gen.refs_push(&lw.defers, wrapper);
        assert(lw.floor == 0);
        println("the deferred break has a loop outside it");
        fir_lower.expand(&lw, 1, at);
    }
    println("the deferred break left its expansion");
}
