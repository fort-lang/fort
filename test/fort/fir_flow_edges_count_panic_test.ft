//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: fir_flow.dataflow_forward_edges: the edge counts differ from the block count
//! stdout:
//| ready
/// dataflow_forward_edges takes one edge set and one target for each block. The function has one
/// block, and the test gives one gen set and one kill set but no edge set, so the function panics
/// before it reads an edge set.
import fort.fir;
import fir_env;
import fort.fir_flow;

// The transfer that dataflow_new takes. The set transfer never calls it.
fn no_transfer(fir.func* f, u32 b, fir_flow.bits mut* set) void {
}

fn main() i32 {
    // The test lends the spans of the sets to a call, so the sets live in an allocation and end
    // through sets_drop_made. The test reads one gen set and one kill set of the two of each.
    fir_env.sets mut* own s = fir_env.sets_make_with(1);
    defer fir_env.sets_drop_made(move(s));
    fir_env.env mut* own e = fir_env.make();
    defer fir_env.drop_made(move(e));
    // `f` lives in an allocation, so that the leak rule proves its end: no call changes the
    // pointer, and drop_made holds each release once.
    fir.func mut* own f = fir.func_make();
    *f = fir_env.func_of(e, "nothing");
    defer fir.func_drop_made(move(f));
    fir.block_set_terminator(f, 0, fir.term_return(fir_env.at(1, 1), 0));
    fir.pred_table mut* own pt = fir.pred_table_make();
    *pt = fir.func_predecessors(f);
    defer fir.pred_table_drop_made(move(pt));
    fir_flow.dataflow mut* own d = fir_flow.dataflow_make(1, fir_flow.join_kind.join_union,
                                                         no_transfer);
    defer fir_flow.dataflow_drop_made(move(d));
    fir_flow.bits@ none = {};
    u32@ nowhere = {};
    println("ready");
    fir_flow.dataflow_forward_edges(f, pt, d, s->gens[..1], s->kills[..1], nowhere, none);
    return 0;
}
