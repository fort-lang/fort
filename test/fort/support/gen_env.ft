// The environment the emitter suites share: the checked sandbox of
// check_env.ft and an emitter over the same session, with the small queries
// an assertion about emitted text needs.
//
// What this stands in for, and why. src/bootstrap/gen.c emits a whole
// function -- the signature, the allocas of the parameters and locals, the
// body and the failure blocks -- and test/gen*_test.c therefore compiles a
// whole program and reads the module back. An expression suite here drives
// one node at a time instead, so it needs the slots the emitter would have
// made and none of the text around them: gen_stmt.gen_slots is that half of
// gen_function, called here and by gen_function itself, so a suite can never
// assert a slot name the emitter no longer produces. The other job this
// module does is the per-function reset of the counters and buffers, which
// `begin` spells the way function_begin does.
//
// What it cannot do, and what covers that instead. Nothing here runs
// `opt -passes=verify`: the compiler's own modules are run through clang by
// every test of the stage2 corpus, and `opt` would not answer the question
// that matters here in any case -- it accepts an instruction after a
// terminator, splitting the block and inventing a successor (notes/compiler.md 6). The
// structural half of item 10 is therefore `block_terminators` below, over the
// text of a whole definition, which is the fort analogue of
// test/gen_helpers.h's gen_block_terminators. An assertion about the emitted
// text is how a convention rule is pinned in any case, since no language run
// test can see one (notes/compiler.md 6).
import ast;
import check;
import std.str;
import check_env;
import gen;
import gen_expr;
import gen_stmt;
import modules;
import std.strbuf;
import types;

/// The sandbox with its checker, the emitter over its session, and a buffer
/// the source builders below use. The emitter is initialised at the address it
/// is used at, since it stores the session it reports through (gen.ft).
struct env {
    check_env.env c;
    gen.emitter g;
    strbuf.str_buf buf;
}

/// Prepares a fresh sandbox and an emitter over it, in the default build mode:
/// checked arithmetic and bounds checks on.
/// D11.1, D10.6
fn open(env mut* e) void {
    check_env.open(&e->c);
    gen.gen_init(&e->g, &e->c.m.s, gen.gen_options{});
}

/// The same with the options a `--release` or `--no-bounds-check` build has.
fn open_with(env mut* e, gen.gen_options opts) void {
    check_env.open(&e->c);
    gen.gen_init(&e->g, &e->c.m.s, opts);
}

/// Releases the emitter, then the checker and the sandbox: every text the
/// emitter interned is its own, and every annotation it read is the checker's.
/// D20.5
fn close(env mut* e) void {
    gen.gen_free(&e->g);
    strbuf.free(&e->buf);
    check_env.close(&e->c);
}

// ---- driving one function ----------------------------------------------------------

/// Checks `body` as the whole of the body of `fn main() i32` and prepares the
/// emitter over it: the annotations the emitter reads, the module `assert`
/// quotes its argument out of, and one slot per parameter and local. False
/// when the source did not check clean, which is what an assertion asks first.
fn open_body(env mut* e, string body) bool {
    if (!check_env.check_body(&e->c, body)) {
        return false;
    }
    return open_main(e);
}

/// The same for a whole module source, which is how a test that needs a
/// declaration beside `main` writes one.
fn open_src(env mut* e, string src) bool {
    if (!check_env.check_src(&e->c, src)) {
        return false;
    }
    return open_main(e);
}

/// Points the emitter at the checked entry module and binds the slots of
/// `main`.
fn open_main(env mut* e) bool {
    e->g.ck = &e->c.ck;
    e->g.module = check_env.module_at(&e->c, "main");
    ast.node* fn_node = check_env.node_in_main(&e->c, ast.ast_kind.k_fn_decl, "main");
    if (e->g.module == null || fn_node == null) {
        return false;
    }
    // The very slots gen_function makes, from gen_function's own code; the
    // allocas it wrote beside them belong to the entry block, which an
    // expression assertion does not look at, and `begin` clears them before
    // the first emission.
    // D19.4, D19.5
    gen.node_ref_vec mut locals = gen.node_ref_vec{};
    defer gen.refs_free(&locals);
    gen_stmt.gen_slots(&e->g, fn_node, &locals);
    return true;
}

/// The per-function reset of gen_stmt.function_begin, minus the slots, so that
/// two assertions of one test each start from `%t0` and `L0`.
/// D19.5
///
/// It stays a second copy and is not joined to function_begin, which a review
/// asked about. The two answer different questions. function_begin resets
/// fourteen fields, the slot vector and the scope stack among them, because it
/// starts a definition; this resets the seven an expression assertion reads --
/// the three counters, the three buffers and `terminated` -- and keeps the
/// slots, because the expression it is about to emit names the locals of the
/// function `open_main` already bound. A `begin` that called function_begin
/// would drop those slots and every expression suite would panic in
/// gen_slot_place. It also clears `failed`, which function_begin does not, so
/// that one case's gen_todo does not silence the next.
/// T-037: the review that asked about the second copy
fn begin(env mut* e) void {
    e->g.temps = 0;
    e->g.labels = 0;
    e->g.tmps = 0;
    strbuf.clear(&e->g.allocas);
    strbuf.clear(&e->g.body);
    strbuf.clear(&e->g.fail);
    e->g.terminated = false;
    e->g.failed = false;
}

// ---- the nodes of the checked body -------------------------------------------------

/// The declaration of the local named `name` in `main`.
fn decl_of(env* e, string name) ast.node* {
    return check_env.node_in_main(&e->c, ast.ast_kind.k_var_decl, name);
}

/// Its initializer, which is the expression a test emits.
fn init_of(env* e, string name) ast.node* {
    ast.node* d = decl_of(e, name);
    if (d == null) {
        return null;
    }
    return d->b;
}

/// The place of that local, which is what an initializer is written into.
fn place_of(env mut* e, string name) gen.gen_place {
    return gen.gen_slot_place(&e->g, decl_of(e, name)->sym);
}

// ---- emitting -----------------------------------------------------------------------

/// Emits the initializer of the local `name` as a scalar value and answers the
/// operand it lands in; the text it produced is body(e).
fn emit_value(env mut* e, string name) gen.gen_val {
    begin(e);
    return gen_expr.gen_expr_value(&e->g, init_of(e, name));
}

/// The same, answering the text of the blocks it produced.
fn value_text(env mut* e, string name) string {
    emit_value(e, name);
    return body(e);
}

/// The expression of the `i`-th statement of `main`, with the call statement
/// unwrapped to the call it holds.
/// D7.3
fn stmt_expr(env* e, u64 i) ast.node* {
    return check_env.body_expr(&e->c, "main", i);
}

/// Emits that statement's expression for its effects alone, which is what a
/// call statement is.
/// D7.3
fn discard_at(env mut* e, u64 i) string {
    begin(e);
    gen_expr.gen_expr_discard(&e->g, stmt_expr(e, i));
    return body(e);
}

/// Emits it into that local's own place, which is how every aggregate is
/// produced.
/// D19.3
fn into_text(env mut* e, string name) string {
    begin(e);
    gen_expr.gen_expr_into(&e->g, init_of(e, name), place_of(e, name));
    return body(e);
}

/// The normal blocks emitted so far, a view valid until the next emission.
fn body(env* e) string {
    return strbuf.view(&e->g.body);
}

/// The failure blocks, which are held apart until the definition is assembled.
/// D19.6
fn fail(env* e) string {
    return strbuf.view(&e->g.fail);
}

/// The entry-block allocas a temporary place asked for.
/// D19.4
fn allocas(env* e) string {
    return strbuf.view(&e->g.allocas);
}

/// The type of the local `name`, which is how a test over the type lowering
/// names a fort type: it writes a declaration and reads the type the checker
/// gave it.
fn type_of(env* e, string name) types.node* {
    ast.node* d = decl_of(e, name);
    if (d == null || d->sym == null) {
        return null;
    }
    return d->sym->ty;
}

/// The symbol of a top-level declaration of the entry module.
fn sym_main(env* e, string name) ast.sym* {
    return check_env.sym_main(&e->c, name);
}

/// Asserts that emitted text is exactly `expected`, printing both when they
/// differ: an assertion over a block of IR is unreadable without the two texts
/// beside each other, and `assert` quotes its argument and not its value.
/// D11.4
fn expect_text(string got, string expected) void {
    if (got != expected) {
        eprint("got:      [");
        eprint(got);
        eprintln("]");
        eprint("expected: [");
        eprint(expected);
        eprintln("]");
    }
    assert(got == expected);
}

/// Two to five lines of expected IR joined into one text: fort joins no two
/// adjacent string literals and a `.ft` line is 100 columns, so an expected
/// block of instructions is written a line at a time. The buffer is the
/// environment's own and serves this one role, so a test holds emitted text (a
/// view of the emitter's body) against a joined text and never a view of one
/// buffer against another view of it.
/// D2.9
fn join2(env mut* e, string a, string b) string {
    strbuf.clear(&e->buf);
    strbuf.append(&e->buf, a);
    strbuf.append(&e->buf, b);
    return strbuf.view(&e->buf);
}

fn join3(env mut* e, string a, string b, string c) string {
    join2(e, a, b);
    strbuf.append(&e->buf, c);
    return strbuf.view(&e->buf);
}

fn join4(env mut* e, string a, string b, string c, string d) string {
    join3(e, a, b, c);
    strbuf.append(&e->buf, d);
    return strbuf.view(&e->buf);
}

fn join5(env mut* e, string a, string b, string c, string d, string f) string {
    join4(e, a, b, c, d);
    strbuf.append(&e->buf, f);
    return strbuf.view(&e->buf);
}

fn join6(env mut* e, string a, string b, string c, string d, string f, string h) string {
    join5(e, a, b, c, d, f);
    strbuf.append(&e->buf, h);
    return strbuf.view(&e->buf);
}

fn join8(env mut* e, string a, string b, string c, string d, string f, string h,
                string i, string j) string {
    join6(e, a, b, c, d, f, h);
    strbuf.append(&e->buf, i);
    strbuf.append(&e->buf, j);
    return strbuf.view(&e->buf);
}

// ---- diagnostics --------------------------------------------------------------------

/// Whether any diagnostic reported so far holds `text`: what gen_todo wrote is
/// read back here, since an unfinished construct is a diagnostic and never
/// wrong code.
fn said(env mut* e, string text) bool {
    return check_env.said(&e->c, text);
}

/// The errors reported so far, notes excluded.
/// D14.2
fn errors(env* e) u64 {
    return check_env.errors(&e->c);
}

/// One more piece appended to the text the last join built, for a block longer
/// than eight lines.
fn join_more(env mut* e, string a) string {
    strbuf.append(&e->buf, a);
    return strbuf.view(&e->buf);
}

/// The body of `main` written a line at a time, which is how a suite lays a
/// probe out exactly as the program stage1 was run over: a statement on line
/// `i` of `lines` is on line `i + 2` of the module check_body builds, so the
/// position a failure call carries is the position of the operator the test
/// wrote.
/// D11.4
fn open_lines(env mut* e, string@ lines) bool {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    u64 mut i = 0;
    while (i < lines.len) {
        if (i > 0) {
            strbuf.push(&b, '\n');
        }
        strbuf.append(&b, lines[i]);
        i += 1;
    }
    return open_body(e, strbuf.view(&b));
}

/// The bytes of the `i`-th string constant the emitter made, which is how the
/// text `assert` quoted out of the source is read back (item 5).
/// D11.4
fn record_text(env* e, u64 i) string {
    return gen.records_at(&e->g.strs, i).text;
}

/// Emits the initializer of the local `name` as a place, which is what an
/// lvalue has and a value does not.
/// D6.7
fn emit_place(env mut* e, string name) gen.gen_place {
    begin(e);
    return gen_expr.gen_expr_place(&e->g, init_of(e, name));
}

// ---- the structural check of item 10 -------------------------------------------------

/// The answer `block_terminators` gives when every block of every definition
/// ends in exactly one terminator; anything else names the offending block.
string BLOCKS_OK = "one terminator per block";

/// The four terminators the emitter writes: `br`, `ret`, `unreachable` and the
/// `switch` of a fort switch (item 10).
fn is_terminator(string line) bool {
    return str.starts_with(line, "  br ") || str.starts_with(line, "  ret ") ||
           str.starts_with(line, "  unreachable") || str.starts_with(line, "  switch ");
}

/// Whether the line begins an instruction rather than continuing the one above.
/// Every instruction is indented by exactly two spaces, so a line indented
/// further, or one holding the `]` that closes a `switch`, is a continuation of
/// the `switch` above it, which is the one terminator LLVM prints over several
/// lines (item 10).
fn is_instruction(string line) bool {
    return line.len > 2 && str.starts_with(line, "  ") && line[2] != ' ' && line[2] != ']';
}

/// Whether the line is a block label, which is the only unindented line inside
/// a definition.
fn is_label(string line) bool {
    return line.len > 1 && line[0] != ' ' && line[line.len - 1] == ':';
}

/// The line beginning at `from`, and the offset of the one after it in *next;
/// the last line of a text with no final newline is returned whole.
fn line_at(string text, u64 from, u64 mut* next) string {
    u64 mut i = from;
    while (i < text.len && text[i] != '\n') {
        i += 1;
    }
    *next = i + 1;
    return text[from..i];
}

/// BLOCKS_OK when every block of every definition in `text` ends in exactly one
/// terminator and holds no instruction after it, and a report naming the
/// offending block otherwise: the structural half of what `opt -passes=verify`
/// is usually trusted for, stated over the text because `opt` does not reject
/// an instruction after a terminator at all -- it splits the block and invents
/// a successor (notes/compiler.md 6, item 10). It is the transliteration of
/// test/gen_helpers.h's gen_block_terminators_of.
///
/// A block begins at a label line and ends at the next label or at the closing
/// brace of the definition.
fn block_terminators(env mut* e, string text) string {
    bool mut in_function = false;
    bool mut open = false;
    bool mut seen = false;
    u64 mut count = 0;
    string mut label = "";
    u64 mut at = 0;
    while (at < text.len) {
        u64 mut next = 0;
        string line = line_at(text, at, &next);
        at = next;
        if (!in_function) {
            in_function = str.starts_with(line, "define ");
            seen = seen || in_function;
            open = false;
        } else if (line == "}") {
            if (open && count != 1) {
                return terminator_report(e, label, count);
            }
            in_function = false;
        } else if (is_label(line)) {
            if (open && count != 1) {
                return terminator_report(e, label, count);
            }
            label = line;
            open = true;
            count = 0;
        } else if (open && is_instruction(line)) {
            if (is_terminator(line)) {
                count += 1;
            } else if (count > 0) {
                return join3(e, label, " has an instruction after its terminator", "");
            }
        }
    }
    if (!seen || in_function) {
        // A module with no definition, or one whose last definition never
        // closed, would otherwise pass without a block being looked at.
        return "the module holds no closed definition";
    }
    return BLOCKS_OK;
}

/// `<label> has N terminators`, the report of a block that ends in none or in
/// more than one.
fn terminator_report(env mut* e, string label, u64 count) string {
    strbuf.clear(&e->buf);
    strbuf.append(&e->buf, label);
    strbuf.append(&e->buf, " has ");
    strbuf.append_u64(&e->buf, count);
    strbuf.append(&e->buf, " terminators");
    return strbuf.view(&e->buf);
}

/// Asserts the structural rule over `text`, printing the report and the module
/// when it fails: `assert` quotes its argument and not its value.
/// D11.4
fn expect_blocks(env mut* e, string text) void {
    string report = block_terminators(e, text);
    if (report != BLOCKS_OK) {
        eprint("blocks:   ");
        eprintln(report);
        eprint("module:   [");
        eprint(text);
        eprintln("]");
    }
    assert(report == BLOCKS_OK);
}

// ---- whole definitions ---------------------------------------------------------------

/// The function definitions emitted so far, which is what an assertion about a
/// whole definition reads (item 1).
fn funcs(env* e) string {
    return strbuf.view(&e->g.funcs);
}

/// The named types, the module-level data and the assembled module.
fn named(env* e) string {
    return strbuf.view(&e->g.named);
}

fn globals(env* e) string {
    return strbuf.view(&e->g.globals);
}

fn module_text(env* e) string {
    return gen.gen_text(&e->g);
}

/// Emits the definition of the top-level function `name` of the entry module
/// and answers its text, which is the whole of the funcs section when it is the
/// first definition emitted.
fn emit_function(env mut* e, string name) string {
    ast.node* fn_node = check_env.node_in_main(&e->c, ast.ast_kind.k_fn_decl, name);
    if (fn_node == null) {
        return "";
    }
    gen_stmt.gen_function(&e->g, fn_node);
    return funcs(e);
}

/// Checks `src` as a whole module and points the emitter at it without binding
/// any slot: a definition suite lets gen_function do that itself.
fn open_module(env mut* e, string src) bool {
    if (!check_env.check_src(&e->c, src)) {
        return false;
    }
    e->g.ck = &e->c.ck;
    e->g.module = check_env.module_at(&e->c, "main");
    return e->g.module != null;
}

/// The lines of an expected block of IR joined verbatim, each already ending in
/// its newline: fort joins no two adjacent string literals and a `.ft` line is
/// 100 columns, so an expected definition is written a line at a time and
/// passed here as a fixed array. It is the general form of join2 to join8
/// above, which the expression suites use for a two- or three-line block.
/// D2.9
fn join_lines(env mut* e, string@ lines) string {
    strbuf.clear(&e->buf);
    u64 mut i = 0;
    while (i < lines.len) {
        strbuf.append(&e->buf, lines[i]);
        i += 1;
    }
    return strbuf.view(&e->buf);
}

/// The same as `open_with` from the two build-mode flags, which is how a suite
/// asks for a `--release` or a `--no-bounds-check` emitter without naming the
/// option struct.
/// D11.1, D10.6
fn gen_options_open(env mut* e, bool release, bool no_bounds_check) void {
    gen.gen_options mut opts = gen.gen_options{};
    opts.release = release;
    opts.no_bounds_check = no_bounds_check;
    open_with(e, opts);
}
