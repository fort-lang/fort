/// Provides the shared emitter-test environment. It combines a checked sandbox, an emitter, and
/// queries for emitted text.
//
// A suite emits a whole function through FIR (gen_fir.ft) or a whole program, and reads the text
// back, as bootstrap0/test/gen*_test.c does. A suite of the helpers of gen.ft calls them one at a
// time, after `begin`, the per-function reset of the counters and buffers that function_begin
// does. The sandbox holds an empty `std.rt` unless the source opens with open_module_rt, so a
// function whose check needs a runtime entry, or that prints, needs that form.
//
// What it cannot do, and what covers that instead. Nothing here runs `opt -passes=verify`: the
// compiler's own modules are run through clang by every test of the stage2 corpus. `opt` would
// not answer the question that matters here in any case. It accepts an instruction after a
// terminator, splitting the block and inventing a successor. The `block_terminators` checks the
// structure of a whole definition. It is the fort equivalent of
// bootstrap0/test/common/gen_helpers.h's gen_block_terminators. An assertion about the emitted text
// is how a convention rule is pinned in any case, since no language run test can see one.
import ast;
import check_env;
import fir_verify;
import gen;
import gen_fir;
import lower_env;
import modules_env;
import std.str;
import std.strbuf;
import types;

// The sandbox with its checker, the emitter over its session, and a buffer
// the source builders below use. The emitter is initialised at the address it
// is used at, since it stores the session it reports through (gen.ft).
struct env {
    check_env.env c;
    gen.emitter g;
    strbuf.str_buf buf;
}

// Prepares a fresh sandbox and an emitter over it, in the default build mode:
// checked arithmetic and bounds checks on.
fn open(env mut* e) void {
    check_env.open(&e->c);
    gen.gen_init(&e->g, &e->c.m.s, gen.gen_options{});
}

// The same with the options a `--release` or `--no-bounds-check` build has.
fn open_with(env mut* e, gen.gen_options opts) void {
    check_env.open(&e->c);
    gen.gen_init(&e->g, &e->c.m.s, opts);
}

// Releases the emitter, then the checker and the sandbox: every text the
// emitter interned is its own, and every annotation it read is the checker's.
fn close(env mut* e) void {
    gen.gen_free(&e->g);
    strbuf.free(&e->buf);
    check_env.close(&e->c);
}

// ---- the checked source ------------------------------------------------------------

// Checks `body` as the whole of the body of `fn main() i32` and points the
// emitter at the checked entry module. The runtime of the sandbox is
// lower_env.RUNTIME, so that `main` emits with its checks and prints. False
// when the source did not check clean, which is what an assertion asks first.
fn open_body(env mut* e, string body) bool {
    use_runtime(e);
    if (!check_env.check_body(&e->c, body)) {
        return false;
    }
    return open_main(e);
}

// The same for a whole module source, which is how a test that needs a
// declaration beside `main` writes one.
fn open_src(env mut* e, string src) bool {
    use_runtime(e);
    if (!check_env.check_src(&e->c, src)) {
        return false;
    }
    return open_main(e);
}

// Points the emitter at the checked entry module, which must define `main`.
fn open_main(env mut* e) bool {
    e->g.ck = &e->c.ck;
    e->g.module = check_env.module_at(&e->c, "main");
    ast.node* fn_node = check_env.node_in_main(&e->c, ast.ast_kind.k_fn_decl, "main");
    return e->g.module != null && fn_node != null;
}

// The per-function reset of gen.function_begin, so that two assertions of one test each start
// from `%t0`, and the flag of a gen_todo, which function_begin does not clear, so that one
// case's gen_todo does not silence the next.
fn begin(env mut* e) void {
    gen.function_begin(&e->g);
    e->g.failed = false;
}

// ---- the nodes of the checked body -------------------------------------------------

// The declaration of the local named `name` in `main`.
fn decl_of(env* e, string name) ast.node* {
    return check_env.node_in_main(&e->c, ast.ast_kind.k_var_decl, name);
}

// The normal blocks emitted so far, a view valid until the next emission.
fn body(env* e) string {
    return strbuf.view(&e->g.body);
}

// The failure blocks, which are held apart until the definition is assembled.
fn fail(env* e) string {
    return strbuf.view(&e->g.fail);
}

// The entry-block allocas a temporary place asked for.
fn allocas(env* e) string {
    return strbuf.view(&e->g.allocas);
}

// The type of the local `name`, which is how a test over the type lowering
// names a fort type. It writes a declaration and reads the type the checker
// gave it.
fn type_of(env* e, string name) types.node* {
    ast.node* d = decl_of(e, name);
    if (d == null || d->sym == null) {
        return null;
    }
    return d->sym->ty;
}

// The symbol of a top-level declaration of the entry module.
fn sym_main(env* e, string name) ast.sym* {
    return check_env.sym_main(&e->c, name);
}

// Asserts that emitted text is exactly `expected`, printing both when they
// differ. An assertion over a block of IR is unreadable without the two texts
// beside each other, and `assert` quotes its argument and not its value.
fn expect_text(string got, string expected) void {
    if (got != expected) {
        eprint("got:      [");
        eprint(got);
        eprintln("]");
        eprint("expected: [");
        eprint(expected);
        eprintln("]");
    }
    assert(got == expected);
}

// Two to five lines of expected IR joined into one text: fort joins no two
// adjacent string literals and a `.ft` line is 100 columns. So an expected
// block of instructions is written a line at a time. The buffer is the
// environment's own and serves this one role. A
// test compares emitted text with joined expected
// text. It never compares two views of the same buffer.
fn join2(env mut* e, string a, string b) string {
    strbuf.clear(&e->buf);
    strbuf.append(&e->buf, a);
    strbuf.append(&e->buf, b);
    return strbuf.view(&e->buf);
}

fn join3(env mut* e, string a, string b, string c) string {
    join2(e, a, b);
    strbuf.append(&e->buf, c);
    return strbuf.view(&e->buf);
}

fn join4(env mut* e, string a, string b, string c, string d) string {
    join3(e, a, b, c);
    strbuf.append(&e->buf, d);
    return strbuf.view(&e->buf);
}

fn join5(env mut* e, string a, string b, string c, string d, string f) string {
    join4(e, a, b, c, d);
    strbuf.append(&e->buf, f);
    return strbuf.view(&e->buf);
}

fn join6(env mut* e, string a, string b, string c, string d, string f, string h) string {
    join5(e, a, b, c, d, f);
    strbuf.append(&e->buf, h);
    return strbuf.view(&e->buf);
}

fn join8(env mut* e, string a, string b, string c, string d, string f, string h,
                string i, string j) string {
    join6(e, a, b, c, d, f, h);
    strbuf.append(&e->buf, i);
    strbuf.append(&e->buf, j);
    return strbuf.view(&e->buf);
}

// ---- diagnostics --------------------------------------------------------------------

// Whether any diagnostic reported so far holds `text`: what gen_todo wrote is
// read back here. This is because an unfinished construct is a diagnostic and never
// wrong code.
fn said(env mut* e, string text) bool {
    return check_env.said(&e->c, text);
}

// The errors reported so far, notes excluded.
fn errors(env* e) u64 {
    return check_env.errors(&e->c);
}

// One more piece appended to the text the last join built, for a block longer
// than eight lines.
fn join_more(env mut* e, string a) string {
    strbuf.append(&e->buf, a);
    return strbuf.view(&e->buf);
}

// Writes the body of `main` one line at a time. This lets a suite
// match the exact program that bootstrap-0 received. A statement on line
// `i` of `lines` is on line `i + 2` of the module check_body builds. So the
// position a failure call carries is the position of the operator the test
// wrote.
fn open_lines(env mut* e, string@ lines) bool {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    u64 mut i = 0;
    while (i < lines.len) {
        if (i > 0) {
            strbuf.push(&b, '\n');
        }
        strbuf.append(&b, lines[i]);
        i += 1;
    }
    return open_body(e, strbuf.view(&b));
}

// The bytes of the `i`-th string constant the emitter made, which is how the
// text `assert` quoted out of the source is read back.
fn record_text(env* e, u64 i) string {
    return gen.records_at(&e->g.strs, i).text;
}

// ---- structural block check -------------------------------------------------

// The answer `block_terminators` gives when every block of every definition
// ends in exactly one terminator. Anything else names the offending block.
string BLOCKS_OK = "one terminator per block";

// The four terminators the emitter writes: `br`, `ret`, `unreachable` and the
// `switch` of a fort switch.
fn is_terminator(string line) bool {
    return str.starts_with(line, "  br ") || str.starts_with(line, "  ret ") ||
           str.starts_with(line, "  unreachable") || str.starts_with(line, "  switch ");
}

// Whether the line begins an instruction rather than continuing the one above. Every
// instruction is indented by exactly two spaces. A line indented further, or one holding the
// `]` that closes a `switch`, is a continuation of the `switch` above it. It is the one
// terminator LLVM prints over several lines.
fn is_instruction(string line) bool {
    return line.len > 2 && str.starts_with(line, "  ") && line[2] != ' ' && line[2] != ']';
}

// Whether the line is a block label, which is the only unindented line inside
// a definition.
fn is_label(string line) bool {
    return line.len > 1 && line[0] != ' ' && line[line.len - 1] == ':';
}

// The line beginning at `from`, and the offset of the one after it in *next.
// The last line of a text with no final newline is returned whole.
fn line_at(string text, u64 from, u64 mut* next) string {
    u64 mut i = from;
    while (i < text.len && text[i] != '\n') {
        i += 1;
    }
    *next = i + 1;
    return text[from..i];
}

// BLOCKS_OK when every block of every definition in `text` ends in exactly one terminator and
// holds no instruction after it. A report naming the offending block otherwise. The structural
// half of what `opt -passes=verify` is usually trusted for. Stated over the text because `opt`
// does not reject an instruction after a terminator at all. It splits the block and invents a
// successor. This function implements bootstrap0/test/common/gen_helpers.h's
// gen_block_terminators_of.
fn block_terminators(env mut* e, string text) string {
    return block_report(&e->buf, text);
}

// block_terminators over the buffer `buf`, which holds a report, so that a suite with no emitter
// environment of this module holds the same rule.
//
// A block begins at a label line and ends at the next label or at the closing
// brace of the definition.
fn block_report(strbuf.str_buf mut* buf, string text) string {
    bool mut in_function = false;
    bool mut open = false;
    bool mut seen = false;
    u64 mut count = 0;
    string mut label = "";
    u64 mut at = 0;
    while (at < text.len) {
        u64 mut next = 0;
        string line = line_at(text, at, &next);
        at = next;
        if (!in_function) {
            in_function = str.starts_with(line, "define ");
            seen = seen || in_function;
            open = false;
        } else if (line == "}") {
            if (open && count != 1) {
                return terminator_report(buf, label, count);
            }
            in_function = false;
        } else if (is_label(line)) {
            if (open && count != 1) {
                return terminator_report(buf, label, count);
            }
            label = line;
            open = true;
            count = 0;
        } else if (open && is_instruction(line)) {
            if (is_terminator(line)) {
                count += 1;
            } else if (count > 0) {
                strbuf.clear(buf);
                strbuf.append(buf, label);
                strbuf.append(buf, " has an instruction after its terminator");
                return strbuf.view(buf);
            }
        }
    }
    if (!seen || in_function) {
        // A module with no definition, or one whose last definition never
        // closed, would otherwise pass without a block being looked at.
        return "the module holds no closed definition";
    }
    return BLOCKS_OK;
}

// `<label> has N terminators`, the report of a block that ends in none or in
// more than one.
fn terminator_report(strbuf.str_buf mut* buf, string label, u64 count) string {
    strbuf.clear(buf);
    strbuf.append(buf, label);
    strbuf.append(buf, " has ");
    strbuf.append_u64(buf, count);
    strbuf.append(buf, " terminators");
    return strbuf.view(buf);
}

// Asserts the structural rule over `text`, printing the report and the module
// when it fails: `assert` quotes its argument and not its value.
fn expect_blocks(env mut* e, string text) void {
    string report = block_terminators(e, text);
    if (report != BLOCKS_OK) {
        eprint("blocks:   ");
        eprintln(report);
        eprint("module:   [");
        eprint(text);
        eprintln("]");
    }
    assert(report == BLOCKS_OK);
}

// ---- whole definitions ---------------------------------------------------------------

// The function definitions emitted so far, which is what an assertion about a
// whole definition reads.
fn funcs(env* e) string {
    return strbuf.view(&e->g.funcs);
}

// The named types, the module-level data and the assembled module.
fn named(env* e) string {
    return strbuf.view(&e->g.named);
}

fn globals(env* e) string {
    return strbuf.view(&e->g.globals);
}

fn module_text(env* e) string {
    return strbuf.view(&e->g.out);
}

// Emits the entry module's top-level function `name` through FIR, as gen_fir.gen_program does
// for each function in the mode of the emitter, and returns the definitions emitted so far. For
// the first definition, this text is the complete funcs section. A function that gen_fir refuses
// adds a compile error and no text.
fn emit_function(env mut* e, string name) string {
    ast.node* fn_node = check_env.node_in_main(&e->c, ast.ast_kind.k_fn_decl, name);
    if (fn_node == null) {
        return "";
    }
    gen_fir.fir_path mut fp = gen_fir.fir_path{.ck = &e->c.ck,
                                                .rt = fir_verify.runtime_of(&e->c.ck)};
    fir_verify.excuse_mode(&fp.rt, e->g.opts.release, e->g.opts.no_bounds_check);
    gen_fir.emit_function(&e->g, &fp, fn_node);
    return funcs(e);
}

// Checks `src` as a whole module and points the emitter at it.
fn open_module(env mut* e, string src) bool {
    if (!check_env.check_src(&e->c, src)) {
        return false;
    }
    e->g.ck = &e->c.ck;
    e->g.module = check_env.module_at(&e->c, "main");
    return e->g.module != null;
}

// Joins expected IR lines verbatim, including their newlines.
// fort joins no adjacent literals, and `.ft` lines have 100
// columns. So an expected definition is written a line at a time and
// passed here as a fixed array. It is the general form of join2 to join8
// above, which the expression suites use for a two- or three-line block.
fn join_lines(env mut* e, string@ lines) string {
    strbuf.clear(&e->buf);
    u64 mut i = 0;
    while (i < lines.len) {
        strbuf.append(&e->buf, lines[i]);
        i += 1;
    }
    return strbuf.view(&e->buf);
}

// Calls `open_with` with two build-mode flags. A suite can request
// `--release` or `--no-bounds-check` without constructing the option struct.
fn gen_options_open(env mut* e, bool release, bool no_bounds_check) void {
    gen.gen_options mut opts = gen.gen_options{};
    opts.release = release;
    opts.no_bounds_check = no_bounds_check;
    open_with(e, opts);
}

// open_module over a sandbox whose std/rt.ft holds lower_env.RUNTIME: the runtime entry of each
// check kind, str_eq and the print functions, so that a function with a check or a print emits.
// gen_fir.gen_program then writes the functions of that runtime too.
fn open_module_rt(env mut* e, string src) bool {
    use_runtime(e);
    return open_module(e, src);
}

// Writes lower_env.RUNTIME as the std/rt.ft of the sandbox, before the source checks.
fn use_runtime(env mut* e) void {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    for (string line : lower_env.RUNTIME) {
        strbuf.append(&b, line);
        strbuf.push(&b, '\n');
    }
    check_env.add(&e->c, "std/rt.ft", strbuf.view(&b));
    modules_env.std_dir_without_runtime(&e->c.m, "std");
}

// Emits `main` of the checked entry module through FIR, the first time it is asked, holds that
// each of its blocks ends in one terminator, and gives its definition: the text that a case of
// one expression reads its instructions from.
fn main_text(env mut* e) string {
    if (strbuf.view(&e->g.funcs).len == 0) {
        emit_function(e, "main");
        expect_blocks(e, funcs(e));
    }
    return funcs(e);
}

// Asserts that the lines `want` stand, together and in order, in `got`, printing both when they
// do not.
fn expect_in(string got, string want) void {
    if (str.find(got, want) < 0) {
        eprint("text:     [");
        eprint(got);
        eprintln("]");
        eprint("lacks:    [");
        eprint(want);
        eprintln("]");
    }
    assert(str.find(got, want) >= 0);
}
