/// lsp_env: what the tests of the language server's protocol layer share.
//
// Ten test programs compare text, u64, i64, and bool answers with tables of
// expected values. `grep -l '^import lsp_env;' test/fort/*.ft | wc -l` reads
// 10. A failing helper prints the case before it asserts. Thus, a table
// failure names the case instead of only the assertion line.
//
// Six of the ten tests drive the server over a pipe. This module opens the
// pipe, feeds a recorded script, and drains the output. `grep -l
// 'lsp_env.open_pipe' test/fort/*.ft | wc -l` reads 6.
//
// The root of test/fort holds tests and nothing else, so the fixture stands
// here.
//
// This module uses no function-pointer dispatch table.
import std.io;
import std.libc;
import std.strbuf;

// Reports `what` when the two texts differ and then fails the test.
fn check(string got, string want, string what) void {
    if (got != want) {
        println("case: ", what);
        println("  want: ", want);
        println("  got:  ", got);
    }
    assert(got == want);
}

// The same over two unsigned numbers.
fn check_u64(u64 got, u64 want, string what) void {
    if (got != want) {
        println("case: ", what);
        println("  want: ", want);
        println("  got:  ", got);
    }
    assert(got == want);
}

// The same over two signed numbers.
fn check_i64(i64 got, i64 want, string what) void {
    if (got != want) {
        println("case: ", what);
        println("  want: ", want);
        println("  got:  ", got);
    }
    assert(got == want);
}

// The same over two truth values.
fn check_bool(bool got, bool want, string what) void {
    if (got != want) {
        println("case: ", what);
        println("  want: ", want);
        println("  got:  ", got);
    }
    assert(got == want);
}

// The two ends of a pipe, as pipe(2) fills them: `read_fd` is fds[0].
struct pipe_ends {
    i32 read_fd;
    i32 write_fd;
}

// A pipe, which is what drives the server in a test. The recorded bytes of a
// client go in one end and the loop reads them from the other. So the framing
// meets the read boundaries of a real stream.

// A pipe, or an assertion that fails. The caller closes both ends.
fn open_pipe() pipe_ends {
    i32 mut@ own fds = new(i32, 2);
    defer del(fds);
    assert(libc.pipe(&fds[0]) == 0);
    return pipe_ends{fds[0], fds[1]};
}

// Writes `bytes` into the pipe and closes the writing end, so the reader sees
// the whole script and then the end of the stream. The script must be below
// the pipe's capacity, 64 KiB on Linux, since nothing drains it meanwhile.
fn feed(pipe_ends ends, string bytes) void {
    assert(io.write_all(ends.write_fd, cast(bytes, u8@)));
    assert(io.close(ends.write_fd));
}

// Everything written into the pipe, which the writing end must have closed.
fn drain(pipe_ends ends) string own {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    assert(io.read_all(ends.read_fd, &b));
    assert(io.close(ends.read_fd));
    return strbuf.take(&b);
}
