/// Supplies checked extern calls and caller facts for the trusted signature hook.
import ast;
import check_env;
import ownership_api;
import ownership_ffi;
import ownership_ffi_boundary_env as base;
import ownership_ffi_storage_env;
import ownership_keys;
import ownership_limits;
import ownership_raw;
import ownership_raw_env;
import ownership_state;
import ownership_transfer;
import std.str;
import types;

struct env {
    base.env b;
    ownership_ffi.hook_request request;
    ownership_ffi.result_choice[2] choices;
    ownership_api.predicate_atom[4] atoms;
    ownership_ffi.storage_context store;
    u64 charges;
    ownership_state.state input;
    ownership_api.operation_position operation;
    ownership_api.source_position position;
    ownership_transfer.event_binding[1] bindings;
}
fn id(ownership_api.entity_kind kind, u32 ordinal) ownership_api.entity_id {
    return base.id(kind, ordinal);
}
fn slot(u32 ordinal) ownership_api.place_path { return base.slot(ordinal); }
fn exact(i64 n) ownership_api.scalar_fact { return base.exact(n); }
// State mutators send several categories in one canonical request.
fn budget(void mut* opaque, ownership_api.charge_request* req) ownership_api.charge_result {
    env mut* e = cast(opaque, env mut*);
    assert(ownership_keys.operation(req->operation, e->operation) == 0);
    assert(ownership_keys.source(req->source, e->position) == 0);
    e->charges += 1;
    return ownership_raw_env.budget(cast(&e->b.raw.budget, void mut*), req);
}
// Each event names the operation that the test runs now.
fn event(void mut* opaque, ownership_api.event_request* req) ownership_api.event_result {
    env mut* e = cast(opaque, env mut*);
    assert(ownership_keys.operation(req->event.operation, e->operation) == 0);
    assert(ownership_keys.source(req->event.source, e->position) == 0);
    e->b.events_seen += 1;
    e->b.observed = req->event;
    e->b.validated = req->event.witnesses.len == 1 && req->event.witnesses[0].validated;
    return ownership_api.event_result{.proof = req->current, .retained = true};
}
fn at_call(env mut* e) void {
    e->operation = e->b.request.call.operation;
    e->position = e->b.request.call.source;
}
fn reset(env mut* e, u64 deny) void {
    base.reset(&e->b, deny);
    e->charges = 0;
}
fn open(env mut* e, u32 number, string name) void {
    base.open(&e->b, number, name);
    at_call(e);
    e->b.raw.local.service.budget_context = cast(e, void mut*);
    e->b.raw.local.service.budget = budget;
    e->b.raw.local.service.event_context = cast(e, void mut*);
    e->b.raw.local.service.event = event;
    e->request.choices_complete = true;
    e->request.fresh_source = id(ownership_api.entity_kind.source, 12);
    e->request.fresh_allocation = id(ownership_api.entity_kind.allocation, 12);
    e->request.fresh_version = id(ownership_api.entity_kind.value, 120);
    e->request.fresh_relation = id(ownership_api.entity_kind.relation, 120);
}
fn close(env mut* e) void {
    ownership_ffi.clear(&e->store);
    ownership_state.free(&e->input);
    base.close(&e->b);
}
fn declaration(env mut* e, string name) void { base.declaration(&e->b, name); }
fn parameter(env* e, u64 at) types.node* {
    return e->b.request.call.declaration.ty->params[at];
}
fn byte(env* e) types.node* { return e->b.raw.byte; }
fn state(env mut* e) ownership_state.state mut* { return &e->b.raw.local.state; }

fn add_source(env mut* e, u32 ordinal, ownership_api.source_kind kind, bool allocated) void {
    ownership_state.state mut* s = state(e);
    ownership_api.source_fact mut source = {};
    source.key = id(ownership_api.entity_kind.source, ordinal);
    source.kind = kind;
    source.validity = ownership_api.validity_kind.live;
    source.boundary = ownership_api.operation_position{
        e->b.request.call.operation.function, 1, ordinal, false};
    if (allocated) { source.allocation = id(ownership_api.entity_kind.allocation, ordinal); }
    s->sources[s->sources_len] = source;
    s->sources_len += 1;
}
fn add_owner(env mut* e, u32 ordinal, ownership_api.place_path p,
    ownership_api.scalar_fact length) void {
    ownership_state.state mut* s = state(e);
    ownership_api.allocation_fact mut owner = {};
    owner.key = id(ownership_api.entity_kind.allocation, ordinal);
    owner.site = owner.key;
    owner.validity = ownership_api.validity_kind.live;
    owner.count.one = true;
    owner.obligation = true;
    owner.logical_length = length;
    owner.owner.place = ownership_state.copy_place(s, p);
    s->allocations[s->allocations_len] = owner;
    s->allocations_len += 1;
    // Preparation reads the checked payload type of each selected allocation.
    base.binding(&e->b, owner.key, e->b.raw.byte);
}
fn add_view(env mut* e, ownership_api.place_path p, u32 source, u32 version,
    ownership_api.scalar_fact span) u64 {
    ownership_state.state mut* s = state(e);
    ownership_api.contents_fact mut value = base.reference(&e->b, p, source, version);
    value.span_length = span;
    s->contents[s->contents_len] = value;
    s->contents_len += 1;
    return s->contents_len - 1;
}
fn add_empty(env mut* e, ownership_api.place_path p, u32 version) u64 {
    ownership_state.state mut* s = state(e);
    ownership_api.contents_fact mut value = ownership_transfer.empty_value(p);
    value.value_version = id(ownership_api.entity_kind.value, version);
    s->contents[s->contents_len] = ownership_state.copy_contents(s, value);
    s->contents_len += 1;
    return s->contents_len - 1;
}
fn add_scalar(env mut* e, ownership_api.place_path p, u32 version) u64 {
    ownership_state.state mut* s = state(e);
    ownership_api.contents_fact mut value = {};
    value.place = ownership_state.copy_place(s, p);
    value.kind = ownership_api.contents_kind.scalar;
    value.value_version = id(ownership_api.entity_kind.value, version);
    s->contents[s->contents_len] = value;
    s->contents_len += 1;
    return s->contents_len - 1;
}
fn add_guard(env mut* e, u32 ordinal) ownership_api.entity_id {
    ownership_state.state mut* s = state(e);
    ownership_api.guard_fact mut guard = {};
    guard.key = id(ownership_api.entity_kind.guard, ordinal);
    ownership_state.append_guards(s, guard);
    return guard.key;
}
// The guard holds one nullness atom on the fresh result version: 0 is null and 1 is not.
fn null_guard(env mut* e, u32 ordinal, bool is_null) ownership_api.entity_id {
    ownership_state.state mut* s = state(e);
    ownership_api.predicate_atom mut atom = {};
    atom.key = id(ownership_api.entity_kind.predicate, ordinal);
    atom.kind = ownership_api.predicate_kind.nullness;
    atom.left = e->request.fresh_version;
    atom.lower = exact(is_null ? 0 : 1);
    ownership_state.append_predicates(s, atom);
    ownership_api.entity_id[1] positive = {atom.key};
    ownership_api.guard_fact mut guard = {};
    guard.key = id(ownership_api.entity_kind.guard, ordinal);
    guard.positive = positive[..];
    ownership_state.append_guards(s, guard);
    return guard.key;
}
// S9 is trusted foreign and owns A9 at P9. P9 and P8 view S9. P2 is empty.
fn foreign_owner(env mut* e) void {
    add_source(e, 9, ownership_api.source_kind.trusted_foreign, true);
    add_owner(e, 9, slot(9), ownership_api.scalar_fact{});
    add_view(e, slot(9), 9, 91, ownership_api.scalar_fact{});
    add_view(e, slot(8), 9, 81, ownership_api.scalar_fact{});
    add_empty(e, slot(2), 90);
}
// S1 is a heap source of four bytes and owns A1 at P1. P1 and P8 view S1. P2 is empty.
fn heap_owner(env mut* e) void {
    add_source(e, 1, ownership_api.source_kind.heap, true);
    add_owner(e, 1, slot(1), exact(4));
    add_view(e, slot(1), 1, 11, exact(4));
    add_view(e, slot(8), 1, 81, exact(4));
    add_empty(e, slot(2), 90);
}
fn bind(env mut* e, ownership_api.place_path p, types.node* ty) void {
    base.binding(&e->b, p.root, ty);
}
fn operand(env mut* e, u64 at, u64 contents, types.node* ty) void {
    base.operand(&e->b, at, contents, ty);
}
fn choose(env mut* e, u64 at, ownership_api.place_path p, ownership_api.entity_id guard,
    bool empty) void {
    e->choices[at] = ownership_ffi.result_choice{};
    e->choices[at].guard = guard;
    e->choices[at].destination = p;
    e->choices[at].empty = empty;
    e->request.choices = e->choices[..at + 1];
}
// Choice `at` holds `count` nullness facts on the fresh result: 0 is null and 1 is not.
fn nullness(u32 ordinal, ownership_api.entity_id version, bool is_null)
    ownership_api.predicate_atom {
    ownership_api.predicate_atom mut atom = {};
    atom.key = id(ownership_api.entity_kind.predicate, ordinal);
    atom.kind = ownership_api.predicate_kind.nullness;
    atom.left = version;
    atom.lower = exact(is_null ? 0 : 1);
    return atom;
}
fn fact(env mut* e, u64 at, u64 slot, u32 ordinal, bool is_null) void {
    e->atoms[at * 2 + slot] = nullness(ordinal, e->request.fresh_version, is_null);
    e->choices[at].facts = e->atoms[at * 2..at * 2 + slot + 1];
}
fn guard_key(u32 ordinal) ownership_api.entity_id {
    return id(ownership_api.entity_kind.guard, ordinal);
}
// A state holds exactly the facts of its own choice: `ordinal` and no other result fact.
fn local_facts(ownership_state.state* s, u32 guard_ordinal, u32 fact_ordinal, bool has_fact)
    void {
    u64 mut guards = 0;
    u64 mut i = 0;
    while (i < s->guards_len) {
        if (s->guards[i].key.ordinal == guard_ordinal) {
            guards += 1;
            assert(s->guards[i].positive.len == (has_fact ? 1 : 0));
            if (has_fact) { assert(s->guards[i].positive[0].ordinal == fact_ordinal); }
        }
        i += 1;
    }
    assert(guards == 1 && s->guards_len == 1);
    assert(s->predicates_len == (has_fact ? 1 : 0));
    if (has_fact) { assert(s->predicates[0].key.ordinal == fact_ordinal); }
}
// The prior retained result and the input baseline exist before the hook runs.
fn finish(env mut* e) void {
    base.finish(&e->b);
    e->store.retained = move(e->b.retained);
    reset(e, 0);
}
// The hook never writes its input core. The test keeps a copy to show it.
fn call(env mut* e) ownership_api.ffi_result {
    ownership_state.free(&e->input);
    e->input = ownership_state.clone(state(e));
    at_call(e);
    e->b.events_seen = 0;
    e->b.request.call.before = ownership_state.view(state(e));
    e->request.boundary = e->b.request;
    ownership_api.ffi_result out = ownership_ffi.apply_boundary(&e->store,
        &e->b.raw.local.service, &e->request);
    assert(ownership_state.equal(&e->input, state(e)));
    return out;
}
// A refusal keeps the input core and the prior retained result equal.
fn unchanged(env* e) void {
    assert(ownership_state.equal(&e->b.raw.local.state, &e->input));
    assert(e->store.retained != null);
    assert(ownership_ffi_storage_env.same_result(e->b.prior_baseline, e->store.retained));
}
fn rejected(env* e, ownership_api.ffi_result out, ownership_api.event_kind kind, string text)
    void {
    assert(!ownership_api.successful(out.proof) && out.proof.failed);
    assert(out.trusted_sources.len == 0 && out.signature_transfers.len == 0);
    assert(out.outcomes.len == 0 && !out.hidden_effects_outside_proof);
    assert(e->b.events_seen == 1 && e->b.observed.kind == kind);
    assert(text.len == 0 || str.equal(e->b.observed.text, text));
    unchanged(e);
}
fn definite(env* e, ownership_api.ffi_result out) void {
    assert(out.proof.kind == ownership_api.proof_kind.complete && !out.proof.terminal.present);
    assert(e->b.observed.evidence == ownership_api.evidence_kind.unconditional && e->b.validated);
}
fn possible(env* e, ownership_api.ffi_result out) void {
    assert(e->b.observed.evidence == ownership_api.evidence_kind.abstract_possibility);
    assert(!e->b.validated);
}
fn accepted(env* e, ownership_api.ffi_result out) ownership_ffi.result* {
    return accepted_as(e, out, ownership_api.outcome_kind.unresolved_foreign);
}
// An accepted call whose one outcome has termination class `kind` (D17.19). Only abort needs no
// cleanup.
fn accepted_as(env* e, ownership_api.ffi_result out, ownership_api.outcome_kind kind)
    ownership_ffi.result* {
    if (!ownership_api.successful(out.proof)) {
        eprintln("refused: ", e->b.observed.text, " reason ", cast(out.proof.terminal.reason, u64));
    }
    assert(ownership_api.successful(out.proof) && out.hidden_effects_outside_proof);
    assert(e->b.events_seen == 0 && e->store.retained != null);
    assert(out.outcomes.len == 1);
    assert(out.outcomes[0].kind == kind);
    assert(out.outcomes[0].cleanup_required == (kind != ownership_api.outcome_kind.abort));
    assert(!out.outcomes[0].cleanup_proved);
    assert(out.outcomes[0].guard.kind == ownership_api.entity_kind.none);
    assert(out.outcomes[0].effects.len == out.signature_transfers.len);
    // Each published fact names the call that made it.
    ownership_api.operation_position call = e->b.request.call.operation;
    u64 mut i = 0;
    while (i < out.signature_transfers.len) {
        assert(ownership_keys.operation(out.signature_transfers[i].operation, call) == 0);
        i += 1;
    }
    i = 0;
    while (i < out.trusted_sources.len) {
        assert(ownership_keys.operation(out.trusted_sources[i].boundary, call) == 0);
        i += 1;
    }
    return e->store.retained;
}
fn after(env* e, u64 at) ownership_state.state* {
    assert(at < e->store.retained->core->len);
    return &e->store.retained->core->states[at];
}
fn contents(ownership_state.state* s, ownership_api.place_path p) ownership_api.contents_fact {
    u64 index = ownership_transfer.contents_index(s, p);
    assert(index != ownership_transfer.U64_MAX);
    return s->contents[index];
}
fn allocation(ownership_state.state* s, u32 ordinal) ownership_api.allocation_fact {
    u64 index = ownership_state.allocation_index(s, id(ownership_api.entity_kind.allocation,
        ordinal));
    assert(index != ownership_state.U64_MAX);
    return s->allocations[index];
}
fn source(ownership_state.state* s, u32 ordinal) ownership_api.source_fact {
    u64 index = ownership_state.source_index(s, id(ownership_api.entity_kind.source, ordinal));
    assert(index != ownership_state.U64_MAX);
    return s->sources[index];
}
fn empty_at(ownership_state.state* s, ownership_api.place_path p) void {
    assert(ownership_transfer.empty_owner_proved(contents(s, p)));
}
fn obligated(ownership_state.state* s, u32 ordinal, ownership_api.place_path p) void {
    ownership_api.allocation_fact owner = allocation(s, ordinal);
    assert(owner.obligation && owner.count.one && !owner.count.zero && !owner.count.many);
    assert(owner.validity == ownership_api.validity_kind.live);
    assert(!owner.owner.detached && ownership_state.same_place(owner.owner.place, p));
}
// A signature transfer detaches the owner. It records no release.
fn detached(ownership_state.state* s, u32 ordinal) void {
    ownership_api.allocation_fact owner = allocation(s, ordinal);
    assert(!owner.obligation && owner.owner.detached && owner.owner.place.root.kind ==
        ownership_api.entity_kind.none);
    assert(owner.validity == ownership_api.validity_kind.live);
    assert(owner.history.len >= 1);
    assert(owner.history[owner.history.len - 1].kind == ownership_api.effect_kind.transfer);
    u64 mut i = 0;
    while (i < owner.history.len) {
        assert(owner.history[i].kind != ownership_api.effect_kind.release);
        i += 1;
    }
    assert(source(s, ordinal).validity == ownership_api.validity_kind.live);
}
fn views(ownership_state.state* s, ownership_api.place_path p, u32 source_ordinal) void {
    ownership_api.contents_fact value = contents(s, p);
    assert(value.kind == ownership_api.contents_kind.reference && value.borrows.len == 1);
    assert(value.borrows[0].source.ordinal == source_ordinal);
}
// A fresh foreign result names the fresh source and no argument source.
fn foreign_result(ownership_state.state* s, ownership_api.place_path p, bool owning) void {
    ownership_api.contents_fact value = contents(s, p);
    assert(value.kind == ownership_api.contents_kind.reference && !value.owner_empty);
    assert(value.value_version.ordinal == 120 && value.borrows.len == 1);
    assert(value.span_length.kind == ownership_api.fact_kind.unknown);
    ownership_api.borrow_relation relation = value.borrows[0];
    assert(relation.source.ordinal == 12 && relation.representation_complete);
    assert(relation.range.extent.kind == ownership_api.fact_kind.unknown);
    assert(relation.range.alignment == 0 && relation.range.leaves.len == 0);
    ownership_api.source_fact fresh = source(s, 12);
    assert(fresh.kind == ownership_api.source_kind.trusted_foreign);
    assert(fresh.validity == ownership_api.validity_kind.live);
    if (owning) {
        assert(fresh.allocation.kind == ownership_api.entity_kind.allocation &&
            fresh.allocation.ordinal == 12);
        obligated(s, 12, p);
        assert(ownership_keys.entity(allocation(s, 12).site, fresh.allocation) == 0);
        assert(allocation(s, 12).logical_length.kind == ownership_api.fact_kind.unknown);
        assert(allocation(s, 12).history.len == 0);
    } else {
        assert(fresh.allocation.kind == ownership_api.entity_kind.none);
        assert(ownership_state.allocation_index(s, id(ownership_api.entity_kind.allocation, 12)) ==
            ownership_state.U64_MAX);
    }
    // The hook adds no nullness atom. Each atom present is one that the producer keyed.
    u64 mut i = 0;
    while (i < s->predicates_len) {
        assert(s->predicates[i].key.kind == ownership_api.entity_kind.predicate);
        i += 1;
    }
}
// A later fort action runs on a supplied state with its own operation key.
fn act(env mut* e, ownership_state.state mut* s, ownership_transfer.action kind, u32 number,
    ownership_api.place_path from, ownership_api.place_path to) ownership_api.proof_status {
    ownership_transfer.request mut req = {};
    req.kind = kind;
    req.operation = ownership_api.operation_position{e->b.request.call.operation.function, 3,
        number, false};
    req.source_position = ownership_api.source_position{31, 1, 4000 + number, 5, 4000 + number,
        17, true};
    req.source = from;
    req.destination = to;
    req.source_key = from.root;
    req.direct_source_proved = true;
    req.direct_destination_proved = true;
    req.event_map_complete_proved = true;
    req.leaves_empty_proved = true;
    e->bindings[0] = ownership_transfer.event_binding{req.operation,
        id(ownership_api.entity_kind.event, 5000 + number)};
    req.event_bindings = e->bindings[..];
    e->operation = req.operation;
    e->position = req.source_position;
    e->b.events_seen = 0;
    ownership_api.proof_status proof = ownership_transfer.apply(s, &e->b.raw.local.service, &req);
    at_call(e);
    return proof;
}
fn successor(env mut* e) ownership_state.state mut* {
    assert(e->store.retained != null && e->store.retained->core->len >= 1);
    return &e->store.retained->core->states[0];
}
// The successor of the last call becomes the next input core.
fn advance(env mut* e) void {
    ownership_ffi.successor mut* own next = ownership_ffi.take_successor(&e->store);
    assert(next != null && next->len == 1 && e->store.retained == null);
    ownership_state.state mut copy = ownership_state.clone(&next->states[0]);
    ownership_ffi.free_successor(next);
    del(next);
    ownership_state.free(state(e));
    *state(e) = move(copy);
}
fn operand_at(env mut* e, u64 at, ownership_api.place_path p, types.node* ty) void {
    u64 index = ownership_transfer.contents_index(state(e), p);
    assert(index != ownership_transfer.U64_MAX);
    operand(e, at, index, ty);
}
fn result_type(env* e) types.node* { return e->b.request.call.declaration.ty->elem; }
fn released(ownership_state.state* s, u32 ordinal) void {
    assert(allocation(s, ordinal).validity == ownership_api.validity_kind.released);
    assert(!allocation(s, ordinal).obligation);
    assert(source(s, ordinal).validity == ownership_api.validity_kind.released);
}
fn declared(env* e, string name) types.node* {
    ast.sym* symbol = check_env.sym_main(&e->b.checked, name);
    assert(symbol != null);
    return symbol->ty;
}
fn index(env mut* e, u32 root, i64 at) ownership_api.place_path {
    ownership_api.place_path mut p = slot(root);
    ownership_api.projection[1] mut parts = {};
    parts[0].kind = ownership_api.projection_kind.fixed_index;
    parts[0].index = exact(at);
    p.projections = ownership_state.copy_projections(state(e), parts[..]);
    return p;
}
fn transfer_effect(ownership_api.ffi_result out, u64 at, u32 allocation, ownership_api.place_path p,
    u32 source) void {
    ownership_api.ordered_effect effect = out.signature_transfers[at];
    assert(effect.kind == ownership_api.effect_kind.transfer);
    assert(effect.allocation.ordinal == allocation && effect.key.ordinal == allocation);
    assert(effect.source.ordinal == source && effect.guard.kind == ownership_api.entity_kind.none);
    assert(ownership_state.same_place(effect.place, p));
    assert(ownership_state.same_place(out.outcomes[0].effects[at].place, p));
}
// A refusal reports one event and keeps the input and the prior result.
fn refused(env mut* e, ownership_api.event_kind kind, string text) ownership_api.ffi_result {
    ownership_api.ffi_result out = call(e);
    if (ownership_api.successful(out.proof) || !str.equal(e->b.observed.text, text)) {
        eprintln("expected: ", text, " observed: ", e->b.observed.text);
    }
    rejected(e, out, kind, text);
    return out;
}
// Each charge position from first to last refuses with the input and prior result kept.
fn sweep(env mut* e) u64 {
    reset(e, 0);
    ownership_ffi.result mut* own prior = move(e->store.retained);
    ownership_api.ffi_result calibration = call(e);
    accepted(e, calibration);
    u64 total = e->b.raw.budget.calls;
    ownership_ffi.clear(&e->store);
    e->store.retained = move(prior);
    u64 mut k = 1;
    while (k <= total) {
        reset(e, k);
        ownership_api.ffi_result out = call(e);
        assert(!ownership_api.successful(out.proof) && out.proof.failed);
        assert(out.proof.terminal.present && out.proof.terminal.limit.present);
        assert(out.proof.terminal.reason == ownership_api.incomplete_reason.work_limit);
        assert(e->b.raw.budget.calls == k);
        assert(e->b.events_seen == 1);
        assert(e->b.observed.kind == ownership_api.event_kind.work_failure);
        assert(out.signature_transfers.len == 0 && out.trusted_sources.len == 0);
        unchanged(e);
        k += 1;
    }
    reset(e, 0);
    return total;
}
// A raw step on a successor uses its own operation key and event binding.
fn raw_request(env mut* e, u32 number) ownership_raw.request {
    ownership_raw.request mut out = {};
    out.limits = ownership_limits.production();
    out.captured_values = true;
    out.alternatives_complete = true;
    out.base.kind = ownership_transfer.action.use;
    out.base.operation = ownership_api.operation_position{e->b.request.call.operation.function, 4,
        number, false};
    out.base.source_position = ownership_api.source_position{31, 1, 6000 + number, 5,
        6000 + number, 17, true};
    out.base.source = slot(1);
    out.base.destination = slot(1);
    out.base.direct_source_proved = true;
    out.base.direct_destination_proved = true;
    out.base.event_map_complete_proved = true;
    e->bindings[0] = ownership_transfer.event_binding{out.base.operation,
        id(ownership_api.entity_kind.event, 7000 + number)};
    out.base.event_bindings = e->bindings[..];
    e->operation = out.base.operation;
    e->position = out.base.source_position;
    e->b.events_seen = 0;
    return out;
}
