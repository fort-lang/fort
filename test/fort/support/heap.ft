/// heap: the live view of the heap that the leak probes of test/fort and test/lsp share.
//
// A leak probe runs many identical rounds and holds an early sample of the
// heap against the late ones. A round that gives every block back leaves the
// heap where it was. A round that keeps a block moves it.
//
// The live view counts the bytes of the blocks that the allocator does not
// hold as free. A leaked block is in that count, whatever its size and
// wherever the allocator put it. On Linux a free block in the thread cache of
// glibc is in that count too, so the view does not see a release of a small
// block until that cache is full. A block that every round keeps is never in
// that cache, so the view moves by the kept bytes times the rounds between the
// two samples.
//
// Each target gives the view its own way, and the values of the two targets
// are not comparable. A probe compares two samples on one target, so a
// distance in bytes means the same thing on both.
//
// On Linux the view is the sum of two fields of glibc's mallinfo2(3):
// `uordblks`, the heap bytes in use, and `hblkhd`, the bytes of the mmap
// blocks. On macOS it counts the bytes of every live block, which the
// allocator's own enumerator reports zone by zone, as the `heap` tool does. The
// statistics of `malloc_zone_statistics` are no view there: `size_in_use`
// steps by 16384 bytes at a round the program does not choose.
//
// At d2f5b2b6 this module gave two more views, and no probe reads them now.
// The system view was the program break, which sbrk(0) reports. The block view
// was the address of a fresh 32-byte block. Each of them moved when only the
// order or the count of the allocations moved, with nothing kept: the break of
// the emitter probe flipped between two values 1896448 bytes apart under glibc
// 2.43, and the block view of test/lsp/lsp_docs_test.ft moved by 12112 to 32016
// bytes under glibc 2.39. And they missed leaks that the live view saw. Of 303
// deletions of a release on the paths of the 16 test files that read them, the
// two views and the other assertions of those files failed 179 under glibc
// 2.39 or 2.43. The live view and the same assertions failed the same 179 and 3
// more, under each glibc where the two views failed them. notes/testing.md
// gives the measurement.
//
// The module declares and calls C, so it is trusted (D9.8).

import extern;
import std.libc;

$if ($cfg(target_os) == "macos") {
    // <malloc/malloc.h>: one range of live blocks, as the enumerator reports it.
    struct range {
        u64 address;
        u64 size;
    }

    // One walk of the zones: the sum of the sizes so far, a copy of the
    // batch that the recorder reads, and whether a batch did not fit in that
    // copy. C gives a batch as a pointer and a count, and fort takes no span
    // of a pointer (D6.9), so the recorder copies the batch first. The walk
    // is a local of the caller, so the copy takes no block of the heap that
    // the walk counts. A probe of 200000 live blocks on macOS 26 gave batches
    // of at most 341 ranges.
    struct walk {
        u64 sum;
        bool overflow;
        range[4096] batch;
    }

    // The first field of malloc_introspection_t. The enumerator takes the
    // task, a context, a type mask, the zone address, a reader (null reads
    // this process) and the recorder it calls with each batch of ranges. C
    // types the context as a `void*` and gives it to the recorder as it is,
    // so this declaration names the walk that it points at. The recorder takes
    // the batch as bytes, because its length comes from C (D9.8).
    struct introspection {
        fn (u32, walk mut*, u32, u64, void*, fn (u32, walk mut*, u32, u8*, u32) void) i32
            enumerator;
    }

    // malloc_zone_t up to its introspection pointer.
    struct zone {
        void* reserved1;
        void* reserved2;
        void* size;
        void* malloc;
        void* calloc;
        void* valloc;
        void* free;
        void* realloc;
        void* destroy;
        char* name;
        void* batch_malloc;
        void* batch_free;
        introspection* introspect;
    }

    extern fn mach_task_self() u32;
    // C stores the address of its array of zone pointers into *addresses. The array is storage of
    // C that fort code only reads, so the pointer that C stores has no `mut` (D17.13).
    extern fn malloc_get_all_zones(u32 task, void* reader, zone** mut* addresses,
                                   u32 mut* count) i32;

    // bcopy(3) copies the zone pointers that C gives as a pointer and a count.
    // Its parameters name the storage of zone pointers, as D3.14 asks of an
    // extern that takes storage with pointer places. `libc.memcpy` takes
    // bytes, and a cast to bytes would hide each pointer place. Two
    // declarations of one symbol agree (D9.8), so this one is not memcpy.
    extern fn bcopy(zone** source, zone* mut* destination, u64 n) void;

    // MALLOC_PTR_IN_USE_RANGE_TYPE: the live blocks.
    u32 PTR_IN_USE = 1;

    // Adds the size of each range of one batch to the sum of the walk. The
    // zones are locked while it runs, so it allocates nothing and does not
    // panic: a batch larger than the copy sets the flag, and the caller
    // asserts on the flag after the enumerator returns. `ranges` holds `count`
    // ranges that C gives. The pointer and the count come from the caller, so
    // `ranges` has the type `u8*`, and the function is a boundary function
    // that only a trusted module names (D9.8).
    fn record(u32 task, walk mut* w, u32 kind, u8* ranges, u32 count) void {
        u64 n = cast(count, u64);
        if (n > w->batch.len) {
            w->overflow = true;
            return;
        }
        if (n == 0) {
            return;
        }
        libc.memcpy(cast(&w->batch[0], u8 mut*), ranges, n * sizeof(range));
        u64 mut i = 0;
        while (i < n) {
            w->sum += w->batch[i].size;
            i += 1;
        }
    }

    fn live_view() u64 {
        zone** mut zones = null;
        u32 mut count = 0;
        u32 task = mach_task_self();
        void* reader = null;
        assert(malloc_get_all_zones(task, reader, &zones, &count) == 0);
        // A copy of the zone pointers; the same probe found one zone.
        zone*[64] mut list = {};
        u64 n = cast(count, u64);
        assert(n <= list.len);
        if (n > 0) {
            bcopy(zones, &list[0], n * sizeof(zone*));
        }
        walk mut w = {};
        u64 mut i = 0;
        while (i < n) {
            zone* z = list[i];
            i += 1;
            assert(z->introspect->enumerator(task, &w, PTR_IN_USE, cast(z, u64), reader, record)
                   == 0);
            assert(!w.overflow);
        }
        return w.sum;
    }
} else {
    $if ($cfg(target_arch) == "x86_64") {
        // <malloc.h>: struct mallinfo2 of glibc 2.33 and later, ten size_t fields.
        struct malloc_counts {
            u64 arena;
            u64 ordblks;
            u64 smblks;
            u64 hblks;
            u64 hblkhd;
            u64 usmblks;
            u64 fsmblks;
            u64 uordblks;
            u64 fordblks;
            u64 keepcost;
        }

        // mallinfo2(3) returns its struct by value, and D9.8 excludes a struct
        // result from an extern signature. The x86-64 System V ABI returns a
        // struct of 80 bytes through a hidden pointer in the first integer
        // register. So this declaration gives that pointer as the one
        // parameter. Another architecture has no live view, and a probe that
        // calls live_view there does not build. std has no binding for
        // mallinfo2 and this module is its one caller.
        extern fn mallinfo2(malloc_counts mut* result) void;

        fn live_view() u64 {
            malloc_counts mut counts = {};
            mallinfo2(&counts);
            // The bytes of the heap blocks that glibc does not hold as free, its
            // thread cache included, and the bytes of the mmap blocks.
            return counts.uordblks + counts.hblkhd;
        }
    }
}

// How far apart two samples are, whichever way the heap moved. A leak that
// hands a later round a lower value is a leak too, and a subtraction the wrong
// way round traps before the assertion.
fn distance(u64 a, u64 b) u64 {
    if (a > b) {
        return a - b;
    }
    return b - a;
}
