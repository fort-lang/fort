/// Supplies complete raw descriptors and paid query fixtures.
import ownership_api;
import ownership_depth_env;
import ownership_raw_facts;
import ownership_type_work;
import prim;
import types;

fn id(ownership_api.entity_kind kind, u32 ordinal) ownership_api.entity_id {
    return ownership_api.entity_id{ownership_api.function_id{
        ownership_api.declaration_id{2, 3}, 1}, kind, ordinal};
}
fn path(u32 ordinal) ownership_api.place_path {
    return ownership_api.place_path{id(ownership_api.entity_kind.slot, ordinal), {}, false};
}
fn region(types.node* layout, u32 source, u32 slot, u64 begin, u64 end)
    ownership_raw_facts.raw_region_view {
    return ownership_raw_facts.raw_region_view{id(ownership_api.entity_kind.source, source),
        path(slot), ownership_raw_facts.literal(begin), ownership_raw_facts.literal(end),
        layout, false, false, true};
}
fn bound(u32 version, i64 lower, i64 upper) ownership_raw_facts.closed_bound_view {
    return ownership_raw_facts.closed_bound_view{id(ownership_api.entity_kind.value, version),
        ownership_raw_facts.signed(lower), ownership_raw_facts.signed(upper)};
}
fn atom(u32 ordinal, ownership_api.predicate_kind kind, u32 left, u32 right,
    i64 lower, i64 upper) ownership_api.predicate_atom {
    return ownership_api.predicate_atom{id(ownership_api.entity_kind.predicate, ordinal), kind,
        id(ownership_api.entity_kind.value, left), id(ownership_api.entity_kind.value, right),
        ownership_api.scalar_fact{.kind = ownership_api.fact_kind.exact, .value = lower},
        ownership_api.scalar_fact{.kind = ownership_api.fact_kind.exact, .value = upper}};
}
fn configure(ownership_depth_env.fixture mut* f, u64 work) ownership_type_work.work {
    ownership_depth_env.configure(f, work);
    return ownership_depth_env.work(f);
}
fn good(ownership_raw_facts.payload_result* result) void {
    assert(ownership_api.successful(result->proof) && result->payload != null);
}
fn counts(ownership_raw_facts.union_result* result, u64 regions, u64 predicates) void {
    assert(ownership_api.successful(result->proof));
    assert(result->r == regions && result->p == predicates);
}
fn refused(ownership_api.proof_status proof, ownership_api.incomplete_reason reason) void {
    assert(!ownership_api.successful(proof) && proof.failed && proof.terminal.present);
    assert(proof.terminal.reason == reason);
    assert(proof.terminal.operation.operation == 7);
    assert(proof.terminal.source.line == 23 && proof.terminal.source.col == 4);
}
fn integer() types.node { return types.node{.kind = types.type_kind.k_prim,
    .prim = prim.prim_kind.prim_i64}; }
