/// Solves the calls_heap rows of checked bodies through their call graph (D17.14 to D17.19).
import fir;
import fir_lower;
import fir_verify;
import lower_env;
import ownership_api;
import ownership_flow;
import ownership_graph;
import ownership_limits;
import ownership_source_calls;

// Function i gets declaration key i + 1, so the graph keeps the names in their given order.
// Open allocates one entry of each span for each named function, and close frees them.
struct closure {
    lower_env.env checked;
    fir.func mut@ own functions;
    ownership_graph.body_input mut@ own graph_inputs;
    ownership_flow.source_file_binding mut@ own files;
    ownership_api.source_position mut@ own declarations;
    ownership_graph.graph graph;
    ownership_source_calls.context calls;
    u64 count;
}

/// Checks `text`, then lowers and verifies each named function.
fn lower(closure mut* c, string@ text, string@ names) void {
    lower_env.open(&c->checked);
    c->functions = new(fir.func, names.len);
    c->graph_inputs = new(ownership_graph.body_input, names.len);
    c->files = new(ownership_flow.source_file_binding, names.len);
    c->declarations = new(ownership_api.source_position, names.len);
    lower_env.check_lines(&c->checked, text, true);
    u64 mut i = 0;
    while (i < names.len) {
        fir_lower.report mut why = fir_lower.report{};
        assert(fir_lower.lower_function(&c->checked.c.ck, lower_env.decl(&c->checked, names[i]),
            &c->functions[i], &why));
        fir_verify.violation mut failure = fir_verify.violation{};
        assert(!fir_verify.find_violation(&c->functions[i], &c->checked.rt, &failure));
        c->files[i] = ownership_flow.source_file_binding{1, 1,
            fir.block_at(&c->functions[i], 0)->term.loc.file};
        c->graph_inputs[i] = ownership_graph.body_input{ownership_api.function_id{
            ownership_api.declaration_id{1, cast(i + 1, u32)}, 1}, &c->functions[i], true};
        c->declarations[i] = ownership_api.source_position{1, 1, c->functions[i].sym->decl.line,
            c->functions[i].sym->decl.col, c->functions[i].sym->decl.end_line,
            c->functions[i].sym->decl.end_col, true};
        i += 1;
    }
    c->count = names.len;
}

/// Builds the call graph of the lowered functions with the W bound `work`, or with the
/// production bound of the closure when `work` is 0.
fn build(closure mut* c, u64 work) void {
    ownership_api.limit_table mut limits = ownership_limits.computation(
        ownership_graph.closure_size(c->graph_inputs[..c->count]));
    if (work != 0) { limits.w = work; }
    c->graph = ownership_graph.build(c->graph_inputs[..c->count], limits);
}

/// Solves the calls_heap rows of the graph.
fn solve(closure mut* c) void {
    ownership_source_calls.solve(&c->calls, &c->graph, c->files[..c->count],
        c->declarations[..c->count]);
}

/// Checks, lowers, builds and solves `text` in one call.
fn run(closure mut* c, string@ text, string@ names) void {
    lower(c, text, names);
    build(c, 0);
    assert(ownership_api.successful(c->graph.proof));
    solve(c);
}

fn close(closure mut* c) void {
    ownership_source_calls.free(&c->calls);
    ownership_graph.free(&c->graph);
    u64 mut i = 0;
    while (i < c->count) {
        fir.func_free(&c->functions[i]);
        i += 1;
    }
    del(c->functions);
    del(c->graph_inputs);
    del(c->files);
    del(c->declarations);
    lower_env.close(&c->checked);
}

fn index(closure* c, string name) u64 {
    u64 mut i = 0;
    while (i < c->count) {
        if (c->functions[i].sym->name == name) { return i; }
        i += 1;
    }
    panic("ownership_source_calls_env: no such body");
}

/// The calls_heap row of body `name`.
fn row_of(closure mut* c, string name) ownership_source_calls.row mut* {
    return &c->calls.rows[index(c, name)];
}

/// The verdict of the calls_heap row of `name`: `proved`, `failed` or `unproved`.
fn verdict(closure mut* c, string name) string {
    ownership_source_calls.row* r = row_of(c, name);
    if (r->violations > 0) { return "failed"; }
    if (ownership_api.successful(r->proof)) { return "proved"; }
    return "unproved";
}

/// Whether the row of `name` has gap `why` at some call.
fn has_gap(closure mut* c, string name, ownership_source_calls.gap_kind why) bool {
    return (row_of(c, name)->gaps & (cast(1, u32) << cast(why, u32))) != 0;
}

/// The ledger of `solver` for body `name`.
fn ledger_of(closure mut* c, string name, ownership_source_calls.solver_kind solver)
    ownership_source_calls.ledger* {
    ownership_source_calls.row* r = row_of(c, name);
    u64 at = solver == ownership_source_calls.solver_kind.summary ? r->summary_ledger :
        r->heap_ledger;
    return &c->calls.ledgers[at];
}
