/// Provides the environment of the tests of the build-mode pass. It checks a prelude or a fort
/// source in the sandbox of lower_env, parses a FIR text against it or lowers one function of it,
/// runs fir_passes.build_mode with the verifier before and after it, and gives the printed text.
//
// The text of a run stays valid until the next call, because it is the text buffer of the
// lower_env environment.
import check_env;
import fort.fir;
import fort.fir_lower;
import fort.fir_parse;
import fort.fir_passes;
import fort.fir_print;
import fort.fir_verify;
import fort.owner.prover;
import lower_env;
import std.strbuf;

/// The flags of one build mode: `--release` and `--no-bounds-check`.
struct mode {
    bool release;
    bool no_bounds;
}

/// The default mode, which removes no check.
mode CHECKED = mode{false, false};

/// `--release`.
mode RELEASE = mode{true, false};

/// `--no-bounds-check`.
mode NO_BOUNDS = mode{false, true};

/// `--release --no-bounds-check`.
mode BOTH = mode{true, true};

/// The four modes, in the order CHECKED, RELEASE, NO_BOUNDS, BOTH.
u64 MODE_COUNT = 4;

mode[MODE_COUNT] MODES = {mode{false, false}, mode{true, false}, mode{false, true},
                          mode{true, true}};

// Appends each line of `lines` and a newline to `b`.
fn join(strbuf.str_buf mut* b, string@ lines) void {
    {
        string@ range_values = lines;
        u64 mut range_index = 0;
        while (range_index < range_values.len) {
            string line = range_values[range_index];
            range_index += 1;
            strbuf.append(b, line);
            strbuf.push(b, '\n');
        }
    }
}

/// Checks `prelude` with the runtime of lower_env as the module `main`, and parses `text`, the
/// lines of a FIR module, against it into a module in an allocation of its own, which the caller
/// ends through fir.module_drop_made. The parse fills the fresh `new`, so no store follows a make.
/// The text must parse with no diagnostic.
fn parse_made(lower_env.env mut* e, string@ prelude, string@ text) fir.module mut* own {
    lower_env.check_lines(e, prelude, true);
    strbuf.str_buf mut b = strbuf.create();
    defer del(b.data);
    join(&b, text);
    fir_parse.prelude pre = fir_parse.prelude{check_env.module_at(&e->c, "main"), &e->c.ck};
    fir.module mut* own m = new(fir.module);
    fir_parse.parse_into(&e->c.m.s, "t.fir", strbuf.view(&b), pre, m);
    if (check_env.errors(&e->c) != 0) {
        eprintln(check_env.report_text(&e->c, 0));
        panic("pass_env.parse: the text does not parse");
    }
    return m;
}

/// The module of parse_made as a value, for a caller that holds it in a value of its own.
fn parse(lower_env.env mut* e, string@ prelude, string@ text) fir.module {
    fir.module mut* own p = parse_made(e, prelude, text);
    fir.module m = move(*p);
    del(p);
    return m;
}

/// Holds that `f` keeps every rule of the verifier. `what` says which point of the run failed.
fn verified(lower_env.env mut* e, fir.func* f, string what) void {
    fir_verify.violation mut v = fir_verify.violation{};
    if (fir_verify.find_violation(f, &e->rt, &v)) {
        refuse(e, f, &v, what);
    }
}

// Whether `f` breaks a premise rule V14 to V16 of the verifier (spec/fir.md 10). A violation of a
// rule V1 to V13 stops the test with `what`. The premise rules run last, so a violation of one
// says that `f` keeps each rule V1 to V13.
fn premise_broken(lower_env.env mut* e, fir.func* f, string what) bool {
    fir_verify.violation mut v = fir_verify.violation{};
    if (!fir_verify.find_violation(f, &e->rt, &v)) {
        return false;
    }
    if (v.rule < fir_verify.RULE_V14) {
        refuse(e, f, &v, what);
    }
    return true;
}

/// Holds that `f` keeps each rule V1 to V13 of the verifier and breaks a premise rule V14 to V16
/// (spec/fir.md 10). It is for a text that a test of an ownership pass writes by hand: the test
/// holds what the pass says of a function that breaks a premise of the lowering, which the lowering
/// does not write. A function that keeps the 16 rules stops the test: it goes through `verified`.
fn breaks_premise(lower_env.env mut* e, fir.func* f, string what) void {
    if (!premise_broken(e, f, what)) {
        eprintln("the function ", f->sym->name, " keeps each premise rule");
        panic("pass_env.breaks_premise: the function goes through pass_env.verified");
    }
}

/// Holds that each function of `m` keeps each rule V1 to V13 of the verifier, and that `breaks`
/// functions of `m` break a premise rule V14 to V16. `breaks` is the count that the test function
/// of a text states, and it is 1 or more: a text whose functions keep the 16 rules goes through
/// verified_each. A text that breaks no premise stops the test, as each other count does.
fn breaks_premises(lower_env.env mut* e, fir.module* m, u64 breaks, string what) void {
    if (breaks == 0) {
        panic("pass_env.breaks_premises: a text that keeps each rule goes through verified_each");
    }
    u64 mut broken = 0;
    u64 mut k = 0;
    while (k < m->funcs.len) {
        if (premise_broken(e, fir.module_function_at(m, k), what)) {
            broken += 1;
        }
        k += 1;
    }
    if (broken != breaks) {
        eprintln(broken, " functions break a premise rule, and not ", breaks);
        panic("pass_env.breaks_premises: another count of functions breaks a premise rule");
    }
}

/// Holds that each function of `m` keeps every rule of the verifier.
fn verified_each(lower_env.env mut* e, fir.module* m, string what) void {
    u64 mut k = 0;
    while (k < m->funcs.len) {
        verified(e, fir.module_function_at(m, k), what);
        k += 1;
    }
}

/// Holds the rules of a text whose test function states the count `breaks` of its functions that
/// break a premise rule: verified_each for the count 0, and breaks_premises for each other count.
fn verified_with(lower_env.env mut* e, fir.module* m, u64 breaks, string what) void {
    if (breaks == 0) {
        verified_each(e, m, what);
    } else {
        breaks_premises(e, m, breaks, what);
    }
}

// Prints `f` and its violation `v`, and stops the test with `what`.
fn refuse(lower_env.env mut* e, fir.func* f, fir_verify.violation* v, string what) void {
    strbuf.clear(&e->text);
    fir_print.print_function(f, &e->text);
    fir_verify.violation_text(f, v, &e->text);
    eprintln(strbuf.view(&e->text));
    panic(what);
}

/// Runs the emptiness pass on `f` for its proof, which reports nothing, and then the build-mode
/// pass with that proof, so the pass removes the overwrite checks that the proof proves
/// (spec/fir.md 11).
fn build_proved(fir.func mut* f, bool release, bool no_bounds) void {
    prover.proof mut* own p = prover.prove_made(f);
    defer prover.drop_made(move(p));
    fir_passes.build_mode(f, release, no_bounds, p);
}

/// Runs the pass in mode `m` on `f` between two runs of the verifier, as build_proved does, and
/// holds that each block has the number of its position after the pass.
fn build(lower_env.env mut* e, fir.func mut* f, mode m) void {
    verified(e, f, "pass_env.build: the verifier refuses the input");
    build_proved(f, m.release, m.no_bounds);
    verified(e, f, "pass_env.build: the verifier refuses the output");
    numbered(f);
}

/// Holds that block `b` of `f` has the number `b`, for each block.
fn numbered(fir.func* f) void {
    u32 mut b = 0;
    while (b < fir.block_count(f)) {
        assert(fir.block_at(f, b)->number == b);
        b += 1;
    }
}

// Runs the pass in mode `m` on each function of `fm` between two runs of the verifier.
fn build_each(lower_env.env mut* e, fir.module mut* fm, mode m) void {
    u64 mut i = 0;
    while (i < fm->funcs.len) {
        build(e, &fm->funcs.items[i], m);
        i += 1;
    }
}

/// Parses `text` against `prelude`, runs the pass in mode `m` on each function between two runs
/// of the verifier, and gives the printed module.
fn run(lower_env.env mut* e, string@ prelude, string@ text, mode m) string {
    fir.module mut* own fm = parse_made(e, prelude, text);
    defer fir.module_drop_made(move(fm));
    build_each(e, fm, m);
    strbuf.clear(&e->text);
    fir_print.print_module(fm, &e->text);
    return strbuf.view(&e->text);
}

/// Checks `source` with the runtime of lower_env, lowers the function `name`, runs the pass in
/// mode `m` between two runs of the verifier, and gives the printed function.
fn lowered(lower_env.env mut* e, string@ source, string name, mode m) string {
    lower_env.check_lines(e, source, true);
    fir.func mut* own f = fir.func_make();
    fir_lower.report mut why = fir_lower.report{};
    if (!fir_lower.lower_function(&e->c.ck, lower_env.decl(e, name), f, &why)) {
        panic("pass_env.lowered: the lowering refuses the function");
    }
    defer fir.func_drop_made(move(f));
    build(e, f, m);
    strbuf.clear(&e->text);
    fir_print.print_function(f, &e->text);
    return strbuf.view(&e->text);
}

/// Parses `text` against `prelude`, runs the pass in mode `m` as `run` does, and returns whether
/// the printed module after the pass is the text before it.
fn unchanged(lower_env.env mut* e, string@ prelude, string@ text, mode m) bool {
    strbuf.str_buf mut before = strbuf.create();
    defer del(before.data);
    fir.module mut* own fm = parse_made(e, prelude, text);
    defer fir.module_drop_made(move(fm));
    fir_print.print_module(fm, &before);
    build_each(e, fm, m);
    strbuf.clear(&e->text);
    fir_print.print_module(fm, &e->text);
    return strbuf.view(&before) == strbuf.view(&e->text);
}

/// Lowers the function `name` of `source`, runs the pass in mode `m` as `lowered` does, and
/// returns whether the printed function after the pass is the text that the lowering wrote.
fn keeps_lowering(lower_env.env mut* e, string@ source, string name, mode m) bool {
    strbuf.str_buf mut before = strbuf.create();
    defer del(before.data);
    strbuf.append(&before, lower_env.lower(e, source, name));
    return strbuf.view(&before) == lowered(e, source, name, m);
}
