/// lsp_json_env: what the tests of src/lsp/json.ft share.
//
// Nine test programs read the same documents and ask three questions. They
// check byte-for-byte output, refusal offsets and messages, and query answers.
// `grep -l '^import lsp_json_env;' test/lsp/*.ft | wc -l` reads 9. The tests
// of test/lsp share this directory with the tests of test/fort, so one include
// root reaches every fixture.
//
// A failing helper prints the case before it asserts. Thus, a table failure
// names the document instead of only the assertion line.
//
// This module uses no function-pointer dispatch table.
import lsp.json;
import std.strbuf;

// Reports `what` when the two texts differ and then fails the test.
fn check(string got, string want, string what) void {
    if (got != want) {
        println("case: ", what);
        println("  want: ", want);
        println("  got:  ", got);
    }
    assert(got == want);
}

// The same over two numbers.
fn check_u64(u64 got, u64 want, string what) void {
    if (got != want) {
        println("case: ", what);
        println("  want: ", want);
        println("  got:  ", got);
    }
    assert(got == want);
}

// The document `d` holds, written back by the writer of the module that read
// it. The result is a view of `out`, so a caller that needs two of them needs
// two buffers.
fn written(json.doc* d, strbuf.str_buf mut* out) string {
    strbuf.clear(out);
    json.writer mut w = json.writer{};
    json.write_init(&w, out);
    json.write_document(&w, d);
    return strbuf.view(out);
}

// Parses `document` and writes it back: the bytes must be the ones that went
// in. Matches a document in the writer's exact
// form. It permits no whitespace or extra
// escapes and preserves the writer's number text.
fn round_trip(string document) void {
    json.doc mut d = json.create();
    defer json.free(&d);
    if (!json.parse(&d, document)) {
        println("case: ", document);
        println("  refused at ", json.error_offset(&d), ": ", json.error_message(&d));
    }
    assert(json.parse(&d, document));
    strbuf.str_buf mut out = strbuf.create();
    defer strbuf.free(&out);
    check(written(&d, &out), document, document);
}

// Parses `document`, which must be accepted, and writes it back as `want`,
// which it need not equal. This is the pair for a document whose spelling is
// not the writer's, such as an escape the reader decodes or whitespace it
// skips.
fn reads_as(string document, string want) void {
    json.doc mut d = json.create();
    defer json.free(&d);
    if (!json.parse(&d, document)) {
        println("case: ", document);
        println("  refused at ", json.error_offset(&d), ": ", json.error_message(&d));
    }
    assert(json.parse(&d, document));
    strbuf.str_buf mut out = strbuf.create();
    defer strbuf.free(&out);
    check(written(&d, &out), want, document);
}

// `document` must be refused at `at` with `message`, and the document must
// hold no tree afterwards.
fn refused(string document, u64 at, string message) void {
    json.doc mut d = json.create();
    defer json.free(&d);
    if (json.parse(&d, document)) {
        println("case: ", document);
        println("  parsed, and a refusal was expected");
    }
    assert(!json.parse(&d, document));
    check(json.error_message(&d), message, document);
    check_u64(json.error_offset(&d), at, document);
    assert(json.root(&d) == 0);
}

// Returns the text of a document's only value. Escape
// and number tests use it to read one string or number.
fn text_is(string document, string want) void {
    json.doc mut d = json.create();
    defer json.free(&d);
    if (!json.parse(&d, document)) {
        println("case: ", document);
        println("  refused at ", json.error_offset(&d), ": ", json.error_message(&d));
    }
    assert(json.parse(&d, document));
    check(json.text_of(&d, json.root(&d)), want, document);
}

// The kind of the only value of a document.
fn kind_is(string document, json.value_kind want, string what) void {
    json.doc mut d = json.create();
    defer json.free(&d);
    assert(json.parse(&d, document));
    if (json.kind_of(&d, json.root(&d)) != want) {
        println("case: ", what, " (", document, ")");
    }
    assert(json.kind_of(&d, json.root(&d)) == want);
}
