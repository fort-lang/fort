// lsp_json_env: what the tests of src/lsp/json.ft share.
//
// Seven test programs read the same documents and ask the same three
// questions of them: does this document come back byte for byte, is this
// document refused at this offset with this message, and what does this
// query answer. The root of test/fort holds tests and nothing else, so the
// fixture stands here (notes/testing.md 4).
//
// A helper that fails prints the case before it asserts, so that a failure
// over a table names the document rather than the line of the assertion.
//
// D3.10: this module uses no function-pointer dispatch table.
import lsp.json;
import std.strbuf;

// Reports `what` when the two texts differ and then fails the test.
fn void check(string got, string want, string what) {
    if (got != want) {
        println("case: ", what);
        println("  want: ", want);
        println("  got:  ", got);
    }
    assert(got == want);
}

// The same over two numbers.
fn void check_u64(u64 got, u64 want, string what) {
    if (got != want) {
        println("case: ", what);
        println("  want: ", want);
        println("  got:  ", got);
    }
    assert(got == want);
}

// The document `d` holds, written back by the writer of the module that read
// it. The result is a view of `out`, so a caller that needs two of them needs
// two buffers.
fn string written(json.doc* d, strbuf.str_buf mut* out) {
    strbuf.clear(out);
    json.writer mut w = json.writer{};
    json.write_init(&w, out);
    json.write_document(&w, d);
    return strbuf.view(out);
}

// Parses `document` and writes it back: the bytes must be the ones that went
// in. A document in the form the writer produces -- no whitespace, every
// escape the writer would write and no other, a number as the writer leaves
// it -- is one this holds byte for byte.
fn void round_trip(string document) {
    json.doc mut d = json.create();
    defer json.free(&d);
    if (!json.parse(&d, document)) {
        println("case: ", document);
        println("  refused at ", json.error_offset(&d), ": ", json.error_message(&d));
    }
    assert(json.parse(&d, document));
    strbuf.str_buf mut out = strbuf.create();
    defer strbuf.free(&out);
    check(written(&d, &out), document, document);
}

// Parses `document`, which must be accepted, and writes it back as `want`,
// which it need not equal: this is the pair for a document whose spelling is
// not the writer's, such as an escape the reader decodes or whitespace it
// skips.
fn void reads_as(string document, string want) {
    json.doc mut d = json.create();
    defer json.free(&d);
    if (!json.parse(&d, document)) {
        println("case: ", document);
        println("  refused at ", json.error_offset(&d), ": ", json.error_message(&d));
    }
    assert(json.parse(&d, document));
    strbuf.str_buf mut out = strbuf.create();
    defer strbuf.free(&out);
    check(written(&d, &out), want, document);
}

// `document` must be refused at `at` with `message`, and the document must
// hold no tree afterwards.
fn void refused(string document, u64 at, string message) {
    json.doc mut d = json.create();
    defer json.free(&d);
    if (json.parse(&d, document)) {
        println("case: ", document);
        println("  parsed, and a refusal was expected");
    }
    assert(!json.parse(&d, document));
    check(json.error_message(&d), message, document);
    check_u64(json.error_offset(&d), at, document);
    assert(json.root(&d) == 0);
}

// The text of the only value of a document, which is how the tests of the
// escapes and of the numbers read one string or one number.
fn void text_is(string document, string want) {
    json.doc mut d = json.create();
    defer json.free(&d);
    if (!json.parse(&d, document)) {
        println("case: ", document);
        println("  refused at ", json.error_offset(&d), ": ", json.error_message(&d));
    }
    assert(json.parse(&d, document));
    check(json.text_of(&d, json.root(&d)), want, document);
}

// The kind of the only value of a document.
fn void kind_is(string document, json.value_kind want, string what) {
    json.doc mut d = json.create();
    defer json.free(&d);
    assert(json.parse(&d, document));
    if (json.kind_of(&d, json.root(&d)) != want) {
        println("case: ", what, " (", document, ")");
    }
    assert(json.kind_of(&d, json.root(&d)) == want);
}
