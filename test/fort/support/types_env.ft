// The type-table environment the type tests share: the table, the nominal
// types the specification's examples use, a lookup by name, and a reader that
// turns a written type into the arguments of type_build (D3.6, grammar 4), so
// that a table row of decisions.md is one assertion.
//
// This is the port of test/types_helpers.h, which the C suites include. A
// `test/fort` test is a program rather than a translation unit, so the shared
// part is a module the tests import with `-I support`; the directory is not a
// test area, so the harness discovers nothing in it (run_tests.py walks `run`,
// `fail`, `programs` and the `*_test.ft` of the root).
//
// The reader accepts `base [own] [mut] { suffix [own] [mut] }` with a suffix
// `*`, `@` or `[N]`, which is the grammar's type rule without function types;
// a suite that needs `fn R(P)` builds it with fn0, fn1 or fn2. The binding's
// own position is the last one, which the builder returns as `mut0`, so every
// helper reports it beside the type (D5.3).
import prim;
import types;
import std::strbuf;

// The most named types and the most suffixes one spelling may hold.
u64 MAX_NAMED = 32;
u64 MAX_SUFFIX = 8;

// The nominal types the examples use: `node` and `point` (D5.3), `rec`
// (type-system.md 4.1), `vec` (D17.7), the enums `color` and `shape` (D3.9).
// `node`, `point` and `vec` are laid out; `rec` is left unresolved for the
// layout suite to lay out itself.
struct env {
    types.table tt;
    strbuf.str_buf buf;
    string[MAX_NAMED] names;
    types.node*[MAX_NAMED] bound;
    u64 nnamed;
    types.node* node;  // struct node { i32 v; node* next; }
    types.node* point; // struct point { i32 x; i32 y; }
    types.node* rec;   // struct rec { u8 tag; i32 n; u16 k; f64 x; }
    types.node* vec;   // struct vec { i32 mut@ own data; u64 len; }
    types.node* color;
    types.node* shape;
}

fn void bind(env mut* e, string name, types.node* t) {
    if (e->nnamed >= MAX_NAMED) {
        panic("types_env.bind: too many named types in a test environment");
    }
    e->names[e->nnamed] = name;
    e->bound[e->nnamed] = t;
    e->nnamed += 1;
}

// A nominal type whose declaration pointer is the address of the name slot it
// is about to take, so that two declarations are never confused (D3.12). The C
// passes the name pointer itself; a fort `string` is not a pointer (D3.7), so
// the slot's address stands in for it, and it is as stable and as distinct.
fn void* fresh_decl(env mut* e) {
    return cast(&e->names[e->nnamed], void*);
}

fn types.node* make_struct(env mut* e, string name) {
    types.node* t = types.type_struct(&e->tt, name, fresh_decl(e));
    bind(e, name, t);
    return t;
}

fn types.node* make_enum(env mut* e, string name) {
    types.node* t = types.type_enum(&e->tt, name, fresh_decl(e));
    bind(e, name, t);
    return t;
}

// The type of `name`, or null.
fn types.node* lookup(env* e, string name) {
    u64 mut i = 0;
    while (i < e->nnamed) {
        if (e->names[i] == name) {
            return e->bound[i];
        }
        i += 1;
    }
    return null;
}

fn void init(env mut* e) {
    u64 mut i = 0;
    while (i < prim.PRIM_COUNT) {
        prim.prim_kind k = cast(i, prim.prim_kind);
        // `void` is a type kind of its own (D3.1, types.ft).
        if (k != prim.prim_kind.prim_void) {
            bind(e, prim.prim_name(k), types.type_prim(&e->tt, k));
        }
        i += 1;
    }
    bind(e, "string", types.type_string(&e->tt, false));
    bind(e, "void", types.type_void(&e->tt));
    e->node = make_struct(e, "node");
    e->point = make_struct(e, "point");
    e->rec = make_struct(e, "rec");
    e->vec = make_struct(e, "vec");
    e->color = make_enum(e, "color");
    e->shape = make_enum(e, "shape");

    types.node* i32t = types.type_prim(&e->tt, prim.prim_kind.prim_i32);
    types.node* u64t = types.type_prim(&e->tt, prim.prim_kind.prim_u64);
    u64[2] mut offsets = {};

    types.node*[2] mut point_fields = {i32t, i32t};
    assert(types.type_layout_begin(e->point));
    assert(types.type_layout_struct(e->point, point_fields[..], offsets[..]));

    types.node*[2] mut node_fields = {i32t, types.type_ptr(&e->tt, e->node, false, false)};
    assert(types.type_layout_begin(e->node));
    assert(types.type_layout_struct(e->node, node_fields[..], offsets[..]));

    types.node*[2] mut vec_fields = {types.type_span(&e->tt, i32t, true, true), u64t};
    assert(types.type_layout_begin(e->vec));
    assert(types.type_layout_struct(e->vec, vec_fields[..], offsets[..]));
}

fn void free(env mut* e) {
    strbuf.free(&e->buf);
    types.type_table_free(&e->tt);
    e->nnamed = 0;
}

// `fn ret()`, `fn ret(p0)` and `fn ret(p0, p1)`, which the reader cannot
// spell. The C passes a NULL-terminated pair; fort has a span, so the arity is
// in the name.
fn types.node* fn0(env mut* e, types.node* ret) {
    types.node*[1] mut params = {};
    return types.type_fn(&e->tt, ret, params[..0], false);
}

fn types.node* fn1(env mut* e, types.node* ret, types.node* p0) {
    types.node*[1] mut params = {p0};
    return types.type_fn(&e->tt, ret, params[..], false);
}

fn types.node* fn2(env mut* e, types.node* ret, types.node* p0, types.node* p1) {
    types.node*[2] mut params = {p0, p1};
    return types.type_fn(&e->tt, ret, params[..], false);
}

// ---- the spelling reader -------------------------------------------------------

fn bool is_word_char(char c) {
    return (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_';
}

fn void skip_spaces(string text, u64 mut* i) {
    while (*i < text.len && text[*i] == ' ') {
        *i += 1;
    }
}

// The word at `*i` after any spaces, `*i` past it; the empty string when the
// next character starts no word.
fn string take_word(string text, u64 mut* i) {
    skip_spaces(text, i);
    u64 start = *i;
    while (*i < text.len && is_word_char(text[*i])) {
        *i += 1;
    }
    return text[start..*i];
}

// Takes the word `want` when it is next; `*i` is untouched otherwise.
fn bool take_keyword(string text, u64 mut* i, string want) {
    u64 save = *i;
    string word = take_word(text, i);
    if (word == want && word.len > 0) {
        return true;
    }
    *i = save;
    return false;
}

fn types.build_result parse_error(string msg) {
    return types.build_result{null, false, msg};
}

// Reads one suffix into `s`; "" on success, the message otherwise.
fn string take_suffix(string text, u64 mut* i, types.suffix mut* s) {
    s->len = 0;
    s->is_own = false;
    s->is_mut = false;
    if (text[*i] == '*') {
        *i += 1;
        s->kind = types.suffix_kind.s_ptr;
    } else if (text[*i] == '@') {
        *i += 1;
        s->kind = types.suffix_kind.s_span;
    } else if (text[*i] == '[') {
        *i += 1;
        u64 mut len = 0;
        if (*i >= text.len || text[*i] < '0' || text[*i] > '9') {
            return "parse: expected an array length";
        }
        while (*i < text.len && text[*i] >= '0' && text[*i] <= '9') {
            len = (len * 10) + cast(cast(text[*i], u64) - cast('0', u64), u64);
            *i += 1;
        }
        if (*i >= text.len || text[*i] != ']') {
            return "parse: expected ']'";
        }
        *i += 1;
        s->kind = types.suffix_kind.s_array;
        s->len = len;
    } else {
        return "parse: expected a suffix";
    }
    s->is_own = take_keyword(text, i, "own");
    s->is_mut = take_keyword(text, i, "mut");
    return "";
}

// The build of the type spelled by `text`. On failure `error` is the builder's
// message, or one starting with "parse: " when the spelling is not one the
// reader (or the grammar) accepts.
fn types.build_result build(env mut* e, string text) {
    u64 mut i = 0;
    string name = take_word(text, &i);
    if (name.len == 0) {
        return parse_error("parse: expected a base type");
    }
    types.node* base = lookup(e, name);
    if (base == null) {
        return parse_error("parse: unknown base type");
    }
    // The base position, the only marker that precedes a suffix (D5.3).
    bool base_own = take_keyword(text, &i, "own");
    bool base_mut = take_keyword(text, &i, "mut");
    types.suffix[MAX_SUFFIX] mut suffixes = {};
    u64 mut n = 0;
    skip_spaces(text, &i);
    while (i < text.len) {
        if (n >= MAX_SUFFIX) {
            return parse_error("parse: too many suffixes");
        }
        string bad = take_suffix(text, &i, &suffixes[n]);
        if (bad != "") {
            return parse_error(bad);
        }
        n += 1;
        skip_spaces(text, &i);
    }
    return types.type_build(&e->tt, base_own, base_mut, base, suffixes[..n]);
}

// The type `text` spells; a spelling the builder refuses is a test error and
// ends the program, since every caller writes the spelling itself.
fn types.node* type_of(env mut* e, string text) {
    types.build_result r = build(e, text);
    if (r.built == null) {
        panic(r.error);
    }
    return r.built;
}

// Level 0 of the declaration `text` (D5.2).
fn bool mut0_of(env mut* e, string text) {
    types.build_result r = build(e, text);
    if (r.built == null) {
        panic(r.error);
    }
    return r.mut0;
}

// The canonical spelling of the type `text` builds, without level 0, or
// "error: <message>" when the builder refuses it. Valid until the next call on
// `e`.
fn string spell(env mut* e, string text) {
    types.build_result r = build(e, text);
    strbuf.clear(&e->buf);
    if (r.built == null) {
        strbuf.append(&e->buf, "error: ");
        strbuf.append(&e->buf, r.error);
    } else {
        types.type_to_str(r.built, &e->buf);
    }
    return strbuf.view(&e->buf);
}

// The same with level 0, as a declaration is written.
fn string spell_decl(env mut* e, string text) {
    types.build_result r = build(e, text);
    strbuf.clear(&e->buf);
    if (r.built == null) {
        strbuf.append(&e->buf, "error: ");
        strbuf.append(&e->buf, r.error);
    } else {
        types.type_to_str_decl(r.built, r.mut0, &e->buf);
    }
    return strbuf.view(&e->buf);
}

// The spelling of any type, without level 0. Valid until the next call.
fn string str_of(env mut* e, types.node* t) {
    strbuf.clear(&e->buf);
    types.type_to_str(t, &e->buf);
    return strbuf.view(&e->buf);
}

// The mutability of level 0 and of every further level of `text` as `y` and
// `n`, level 0 first: `node* mut p` gives "yn" and `u8 mut@ mut* mut out`
// "yyy" (D5.2, D5.3).
fn string muts(env mut* e, string text) {
    types.build_result r = build(e, text);
    strbuf.clear(&e->buf);
    if (r.built == null) {
        strbuf.append(&e->buf, "error: ");
        strbuf.append(&e->buf, r.error);
        return strbuf.view(&e->buf);
    }
    if (r.mut0) {
        strbuf.push(&e->buf, 'y');
    } else {
        strbuf.push(&e->buf, 'n');
    }
    u64 levels = types.type_levels(r.built);
    u64 mut k = 1;
    while (k <= levels) {
        if (types.type_level_mut(r.built, k)) {
            strbuf.push(&e->buf, 'y');
        } else {
            strbuf.push(&e->buf, 'n');
        }
        k += 1;
    }
    return strbuf.view(&e->buf);
}

// The `own` mark of every reference of `text`, the outermost first:
// `node mut* own mut@ own kids` gives "yy" and `node* mut@ own items` "yn"
// (D17.2). A type with no reference gives "".
fn string owns(env mut* e, string text) {
    types.build_result r = build(e, text);
    strbuf.clear(&e->buf);
    if (r.built == null) {
        strbuf.append(&e->buf, "error: ");
        strbuf.append(&e->buf, r.error);
        return strbuf.view(&e->buf);
    }
    u64 mut k = 1;
    while (k <= MAX_SUFFIX) {
        types.node* ref = types.type_ref_at(r.built, k);
        if (ref == null) {
            break;
        }
        if (ref->is_own) {
            strbuf.push(&e->buf, 'y');
        } else {
            strbuf.push(&e->buf, 'n');
        }
        k += 1;
    }
    return strbuf.view(&e->buf);
}
