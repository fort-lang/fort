/// Supplies verified pre-transform FIR and separate synthetic range metadata.
import fir;
import fir_lower;
import fir_verify;
import lower_env;
import ownership_api;
import ownership_keys;
import types;

struct env {
    lower_env.env checked;
    fir.func body;
    bool verified;
    ownership_api.range_declaration mut@ own declarations;
    ownership_api.range_expansion mut@ own expansions;
    ownership_api.range_loan mut@ own loans;
    ownership_api.range_capture mut@ own captures;
    ownership_api.range_boundary mut@ own boundaries;
    ownership_api.absence_evidence mut@ own absences;
    ownership_api.projection mut@ own projections;
    ownership_api.entity_id mut@ own sources;
    ownership_api.proof_status supplied;
    ownership_api.state_handle state;
    ownership_api.event_handle events;
}

fn open(env mut* e) void {
    lower_env.open(&e->checked);
}

// Release callback storage and FIR before checked symbols and types.
fn clear_input(env mut* e) void {
    ownership_api.teardown(&e->state, &e->events);
    fir.func_free(&e->body);
    e->verified = false;
    del(e->captures);
    del(e->loans);
    del(e->boundaries);
    del(e->absences);
    del(e->expansions);
    del(e->declarations);
    del(e->projections);
    del(e->sources);
    e->supplied = ownership_api.proof_status{};
}

fn close(env mut* e) void {
    clear_input(e);
    lower_env.close(&e->checked);
}

fn load(env mut* e, string@ lines, string name) void {
    clear_input(e);
    lower_env.check_lines(&e->checked, lines, true);
    fir_lower.report mut why = fir_lower.report{};
    if (!fir_lower.lower_function(&e->checked.c.ck, lower_env.decl(&e->checked, name),
    &e->body, &why)) {
        panic("ownership_env.load: the lowering refuses the input");
    }
    fir_verify.violation mut v = fir_verify.violation{};
    if (fir_verify.find_violation(&e->body, &e->checked.rt, &v)) {
        panic("ownership_env.load: the verifier refuses the input");
    }
    e->verified = true;
}

/// Accepts a function only when the existing verifier accepts it.
fn accept(env mut* e, fir.func mut* body) bool {
    bool same = body == &e->body;
    if (same) { e->verified = false; }
    if (body->ty == null || body->ty->kind != types.type_kind.k_fn ||
        body->tt != &e->checked.c.ck.types || body->locals.len == 0 || body->blocks.len == 0) {
        return false;
    }
    fir_verify.violation mut v = fir_verify.violation{};
    if (fir_verify.find_violation(body, &e->checked.rt, &v)) {
        return false;
    }
    if (same) {
        e->verified = true;
        return true;
    }
    clear_input(e);
    e->body = move(*body);
    e->verified = true;
    return true;
}

fn ranges(env* e) ownership_api.range_input {
    ownership_api.range_input mut out = ownership_api.range_input{};
    out.declarations = e->declarations;
    out.expansions = e->expansions;
    out.loans = e->loans;
    out.captures = e->captures;
    out.boundaries = e->boundaries;
    out.absences = e->absences;
    out.coverage.structural_valid = e->verified;
    out.coverage.supplied_complete = ownership_api.successful(e->supplied);
    // Synthetic descriptors cannot establish actual producer completeness.
    out.coverage.actual_source_complete = false;
    return out;
}

fn has_declaration(ownership_api.range_input* input, ownership_api.declaration_id key) bool {
    {
        ownership_api.range_declaration@ declarations = input->declarations;
        u64 mut declarations_index = 0;
        while (declarations_index < declarations.len) {
            ownership_api.range_declaration d = declarations[declarations_index];
            declarations_index += 1;
            if (ownership_keys.declaration(d.key, key) == 0) { return true; }
        }
    }
    return false;
}

fn has_expansion(ownership_api.range_input* input, ownership_api.expansion_id key) bool {
    {
        ownership_api.range_expansion@ expansions = input->expansions;
        u64 mut expansions_index = 0;
        while (expansions_index < expansions.len) {
            ownership_api.range_expansion x = expansions[expansions_index];
            expansions_index += 1;
            if (ownership_keys.expansion(x.key, key) == 0) { return true; }
        }
    }
    return false;
}

fn has_loan(ownership_api.range_input* input, ownership_api.loan_id key) bool {
    {
        ownership_api.range_loan@ loans = input->loans;
        u64 mut loans_index = 0;
        while (loans_index < loans.len) {
            ownership_api.range_loan l = loans[loans_index];
            loans_index += 1;
            if (ownership_keys.loan(l.key, key) == 0) { return true; }
        }
    }
    return false;
}

fn valid_position(env* e, ownership_api.operation_position op) bool {
    if (cast(op.block, u64) >= e->body.blocks.len) { return false; }
    fir.block* bl = fir.block_at(&e->body, op.block);
    if (op.terminator) { return cast(op.operation, u64) == bl->statements.len; }
    return cast(op.operation, u64) <= bl->statements.len;
}

fn missing(ownership_api.incomplete_reason reason) ownership_api.proof_status {
    return ownership_api.incomplete(reason, ownership_api.operation_position{},
        ownership_api.source_position{});
}

// Validate supplied correspondence only. No source producer runs here.
fn validate(env* e, ownership_api.range_input* input) ownership_api.proof_status {
    if (!e->verified) { return missing(ownership_api.incomplete_reason.invalid_input); }
    u64 mut i = 0;
    while (i < input->declarations.len) {
        ownership_api.range_declaration d = input->declarations[i];
        u64 mut j = i + 1;
        while (j < input->declarations.len) {
            if (ownership_keys.declaration(d.key, input->declarations[j].key) == 0) {
                return missing(ownership_api.incomplete_reason.missing_correspondence);
            }
            j += 1;
        }
        bool mut expanded = false;
        {
            ownership_api.range_expansion@ expansions = input->expansions;
            u64 mut expansions_index = 0;
            while (expansions_index < expansions.len) {
                ownership_api.range_expansion x = expansions[expansions_index];
                expansions_index += 1;
                if (ownership_keys.declaration(x.key.declaration, d.key) == 0) {
                    if (ownership_keys.function(x.key.function, d.function) != 0) {
                        return missing(ownership_api.incomplete_reason.missing_correspondence);
                    }
                    expanded = true;
                }
            }
        }
        if (d.selected && !expanded) {
            bool mut absence = false;
            {
                ownership_api.absence_evidence@ absences = input->absences;
                u64 mut absences_index = 0;
                while (absences_index < absences.len) {
                    ownership_api.absence_evidence a = absences[absences_index];
                    absences_index += 1;
                    if (ownership_keys.declaration(a.declaration, d.key) == 0 &&
                        a.proposed != ownership_api.absence_kind.none && a.checked_source &&
                        a.verified_fir && a.correspondence) { absence = true; }
                }
            }
            if (!absence) { return missing(ownership_api.incomplete_reason.source_coverage); }
        }
        i += 1;
    }
    i = 0;
    while (i < input->expansions.len) {
        ownership_api.range_expansion x = input->expansions[i];
        if (!has_declaration(input, x.key.declaration)) {
            return missing(ownership_api.incomplete_reason.missing_correspondence);
        }
        u64 mut j = i + 1;
        while (j < input->expansions.len) {
            if (ownership_keys.expansion(x.key, input->expansions[j].key) == 0) {
                return missing(ownership_api.incomplete_reason.missing_correspondence);
            }
            j += 1;
        }
        bool mut used = false;
        {
            ownership_api.range_loan@ loans = input->loans;
            u64 mut loans_index = 0;
            while (loans_index < loans.len) {
                ownership_api.range_loan l = loans[loans_index];
                loans_index += 1;
                if (ownership_keys.expansion(l.key.expansion, x.key) == 0) { used = true; }
            }
        }
        if (!used) { return missing(ownership_api.incomplete_reason.missing_capture); }
        i += 1;
    }
    i = 0;
    while (i < input->loans.len) {
        ownership_api.range_loan l = input->loans[i];
        if (!l.whole_body || !has_expansion(input, l.key.expansion)) {
            return missing(ownership_api.incomplete_reason.missing_correspondence);
        }
        if (l.parent_present && (!has_loan(input, l.parent) ||
            ownership_keys.loan(l.parent, l.key) == 0)) {
            return missing(ownership_api.incomplete_reason.missing_correspondence);
        }
        ownership_api.range_loan mut ancestor = l;
        u64 mut depth = 0;
        while (ancestor.parent_present) {
            depth += 1;
            if (depth > input->loans.len ||
                ownership_keys.function(ancestor.parent.expansion.function,
                    l.key.expansion.function) != 0) {
                return missing(ownership_api.incomplete_reason.missing_correspondence);
            }
            u64 mut parent_index = 0;
            while (parent_index < input->loans.len &&
                ownership_keys.loan(input->loans[parent_index].key, ancestor.parent) != 0) {
                parent_index += 1;
            }
            if (parent_index == input->loans.len) {
                return missing(ownership_api.incomplete_reason.missing_correspondence);
            }
            ancestor = input->loans[parent_index];
        }
        u64 mut j = i + 1;
        while (j < input->loans.len) {
            if (ownership_keys.loan(l.key, input->loans[j].key) == 0) {
                return missing(ownership_api.incomplete_reason.missing_correspondence);
            }
            j += 1;
        }
        u64 mut capture_count = 0;
        {
            ownership_api.range_capture@ captures = input->captures;
            u64 mut captures_index = 0;
            while (captures_index < captures.len) {
                ownership_api.range_capture c = captures[captures_index];
                captures_index += 1;
                if (ownership_keys.loan(c.loan, l.key) == 0) {
                    capture_count += 1;
                    if (!c.value_present || c.ty == null || c.sources.len == 0) {
                        return missing(ownership_api.incomplete_reason.missing_capture);
                    }
                    if (!c.path_present ||
                        c.original_path.root.kind == ownership_api.entity_kind.none) {
                        return missing(ownership_api.incomplete_reason.missing_path);
                    }
                }
            }
        }
        if (capture_count != 1) { return missing(ownership_api.incomplete_reason.missing_capture); }
        ownership_api.range_boundary[5] mut found = {};
        bool[5] mut present = {};
        {
            ownership_api.range_boundary@ boundaries = input->boundaries;
            u64 mut boundaries_index = 0;
            while (boundaries_index < boundaries.len) {
                ownership_api.range_boundary b = boundaries[boundaries_index];
                boundaries_index += 1;
                if (ownership_keys.loan(b.loan, l.key) == 0) {
                    u64 n = cast(b.kind, u64);
                    if (present[n] || !valid_position(e, b.position) ||
                        ownership_keys.function(b.position.function,
                        l.key.expansion.function) != 0) {
                        return missing(ownership_api.incomplete_reason.missing_boundary);
                    }
                    found[n] = b;
                    present[n] = true;
                }
            }
        }
        // Outer cleanup is optional. Applicable body cleanup is explicit, even when empty.
        j = 0;
        while (j < 4) {
            if (!present[j]) { return missing(ownership_api.incomplete_reason.missing_boundary); }
            if (j > 0 && ownership_keys.boundary(found[j - 1], found[j]) >= 0) {
                return missing(ownership_api.incomplete_reason.missing_boundary);
            }
            j += 1;
        }
        if (present[4] && ownership_keys.boundary(found[3], found[4]) >= 0) {
            return missing(ownership_api.incomplete_reason.missing_boundary);
        }
        i += 1;
    }
    {
        ownership_api.range_capture@ captures = input->captures;
        u64 mut captures_index = 0;
        while (captures_index < captures.len) {
            ownership_api.range_capture c = captures[captures_index];
            captures_index += 1;
            if (!has_loan(input, c.loan)) {
                return missing(ownership_api.incomplete_reason.missing_correspondence);
            }
        }
    }
    {
        ownership_api.range_boundary@ boundaries = input->boundaries;
        u64 mut boundaries_index = 0;
        while (boundaries_index < boundaries.len) {
            ownership_api.range_boundary b = boundaries[boundaries_index];
            boundaries_index += 1;
            if (!has_loan(input, b.loan)) {
                return missing(ownership_api.incomplete_reason.missing_correspondence);
            }
        }
    }
    ownership_api.proof_status mut out = ownership_api.proof_status{};
    out.kind = ownership_api.proof_kind.complete;
    return out;
}

/// Copies supplied descriptors into the input store, including nested path and source slices.
fn supply(env mut* e, ownership_api.range_input* input) void {
    ownership_api.teardown(&e->state, &e->events);
    del(e->declarations);
    del(e->expansions);
    del(e->loans);
    del(e->captures);
    del(e->boundaries);
    del(e->absences);
    del(e->projections);
    del(e->sources);
    e->declarations = new(ownership_api.range_declaration, input->declarations.len);
    e->expansions = new(ownership_api.range_expansion, input->expansions.len);
    e->loans = new(ownership_api.range_loan, input->loans.len);
    e->captures = new(ownership_api.range_capture, input->captures.len);
    e->boundaries = new(ownership_api.range_boundary, input->boundaries.len);
    e->absences = new(ownership_api.absence_evidence, input->absences.len);
    u64 mut path_count = 0;
    u64 mut source_count = 0;
    {
        ownership_api.range_capture@ captures = input->captures;
        u64 mut captures_index = 0;
        while (captures_index < captures.len) {
            ownership_api.range_capture c = captures[captures_index];
            captures_index += 1;
            if (c.original_path.projections.len > ownership_api.U64_MAX - path_count ||
            c.sources.len > ownership_api.U64_MAX - source_count) {
                panic("ownership_env.supply: input count overflow");
            }
            path_count += c.original_path.projections.len;
            source_count += c.sources.len;
        }
    }
    e->projections = new(ownership_api.projection, path_count);
    e->sources = new(ownership_api.entity_id, source_count);
    u64 mut i = 0;
    while (i < input->declarations.len) {
        e->declarations[i] = input->declarations[i];
        i += 1;
    }
    i = 0;
    while (i < input->expansions.len) {
        e->expansions[i] = input->expansions[i];
        i += 1;
    }
    i = 0;
    while (i < input->loans.len) { e->loans[i] = input->loans[i]; i += 1; }
    i = 0;
    while (i < input->boundaries.len) { e->boundaries[i] = input->boundaries[i]; i += 1; }
    i = 0;
    while (i < input->absences.len) { e->absences[i] = input->absences[i]; i += 1; }
    u64 mut path_offset = 0;
    u64 mut source_offset = 0;
    i = 0;
    while (i < input->captures.len) {
        ownership_api.range_capture c = input->captures[i];
        e->captures[i] = c;
        u64 mut j = 0;
        while (j < c.original_path.projections.len) {
            e->projections[path_offset + j] = c.original_path.projections[j];
            j += 1;
        }
        e->captures[i].original_path.projections =
        e->projections[path_offset..path_offset + c.original_path.projections.len];
        path_offset += c.original_path.projections.len;
        j = 0;
        while (j < c.sources.len) { e->sources[source_offset + j] = c.sources[j]; j += 1; }
        e->captures[i].sources = e->sources[source_offset..source_offset + c.sources.len];
        source_offset += c.sources.len;
        i += 1;
    }
    ownership_api.range_input owned = ranges(e);
    e->supplied = validate(e, &owned);
}
