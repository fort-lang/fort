/// Supplies verified pre-transform FIR.
import fir;
import fir_lower;
import fir_verify;
import lower_env;
import ownership_api;
import types;

struct env {
    lower_env.env checked;
    fir.func body;
    bool verified;
    ownership_api.state_handle state;
    ownership_api.event_handle events;
}

fn open(env mut* e) void {
    lower_env.open(&e->checked);
}

// Release callback storage and FIR before checked symbols and types.
fn clear_input(env mut* e) void {
    ownership_api.teardown(&e->state, &e->events);
    fir.func_free(&e->body);
    e->verified = false;

}

fn close(env mut* e) void {
    clear_input(e);
    lower_env.close(&e->checked);
}

fn load(env mut* e, string@ lines, string name) void {
    clear_input(e);
    lower_env.check_lines(&e->checked, lines, true);
    fir_lower.report mut why = fir_lower.report{};
    if (!fir_lower.lower_function(&e->checked.c.ck, lower_env.decl(&e->checked, name),
    &e->body, &why)) {
        panic("ownership_env.load: the lowering refuses the input");
    }
    fir_verify.violation mut v = fir_verify.violation{};
    if (fir_verify.find_violation(&e->body, &e->checked.rt, &v)) {
        panic("ownership_env.load: the verifier refuses the input");
    }
    e->verified = true;
}

/// Accepts a function only when the existing verifier accepts it.
fn accept(env mut* e, fir.func mut* body) bool {
    bool same = body == &e->body;
    if (same) { e->verified = false; }
    if (body->ty == null || body->ty->kind != types.type_kind.k_fn ||
        body->tt != &e->checked.c.ck.types || body->locals.len == 0 || body->blocks.len == 0) {
        return false;
    }
    fir_verify.violation mut v = fir_verify.violation{};
    if (fir_verify.find_violation(body, &e->checked.rt, &v)) {
        return false;
    }
    if (same) {
        e->verified = true;
        return true;
    }
    clear_input(e);
    e->body = move(*body);
    e->verified = true;
    return true;
}
