/// Removes directory trees that a suite made in its working directory: the cache directories of
/// the library builds of a suite (D9.11, toolchain.md 2.3) among them.
//
// The removal follows no symbolic link: unlink(2) removes a link itself, and only a directory
// that is no link is read and removed after its entries.
import std.libc;
import std.str;
import std.strbuf;
import std.sys;

// `<dir>/<name>` in `out`.
fn join(strbuf.str_buf mut* out, string dir, string name) string {
    strbuf.clear(out);
    strbuf.append(out, dir);
    strbuf.push(out, '/');
    strbuf.append(out, name);
    return strbuf.view(out);
}

// The names of the entries of the directory `path` but `.` and `..`, each ended by a NUL, in
// `out`. False when the directory cannot be opened.
fn list(string path, strbuf.str_buf mut* out) bool {
    char mut@ own c_path = str.to_cstr(path);
    defer del(c_path);
    void mut* d = libc.opendir(c_path.ptr);
    if (d == null) {
        return false;
    }
    libc.dirent* mut e = cast(libc.readdir(d), libc.dirent*);
    while (e != null) {
        string name = str.from_cstr(&e->name[0]);
        if (name != "." && name != "..") {
            strbuf.append(out, name);
            strbuf.push(out, '\0');
        }
        e = cast(libc.readdir(d), libc.dirent*);
    }
    libc.closedir(d);
    return true;
}

// The end of the name that starts at `at` in `all`: the position of its NUL. The callers lend
// buffers, so the use rule of `move` and `del` needs this read through `all` in a frame of its own.
fn name_end(string all, u64 at) u64 {
    u64 mut end = at;
    while (all[end] != '\0') {
        end += 1;
    }
    return end;
}

// Whether `path` is a symbolic link: readlink(2) succeeds on a link alone.
fn is_link(string path) bool {
    char mut@ own c_path = str.to_cstr(path);
    defer del(c_path);
    char[1] mut buf = {};
    return libc.readlink(c_path.ptr, &buf[0], 1) >= 0;
}

/// Removes `path` and, when it is a directory, each entry below it first. An absent path is no
/// error; a path that cannot be removed stops the suite.
fn remove_tree(string path) void {
    char mut@ own c_path = str.to_cstr(path);
    defer del(c_path);
    if (libc.unlink(c_path.ptr) == 0 || sys.errno() == libc.ENOENT) {
        return;
    }
    // a directory: its entries go first
    libc.chmod(c_path.ptr, 0o700);
    strbuf.str_buf mut names = strbuf.create();
    defer strbuf.free(&names);
    assert(list(path, &names));
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    string all = strbuf.view(&names);
    u64 mut at = 0;
    while (at < all.len) {
        u64 end = name_end(all, at);
        remove_tree(join(&b, path, all[at..end]));
        at = end + 1;
    }
    assert(libc.rmdir(c_path.ptr) == 0);
}

/// Removes the cache directory `.fort-cache` of the working directory and of each directory in
/// it that is no symbolic link: the default cache directories of the entry files and of the
/// library roots of a suite.
fn remove_caches() void {
    remove_tree(".fort-cache");
    strbuf.str_buf mut names = strbuf.create();
    defer strbuf.free(&names);
    assert(list(".", &names));
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    string all = strbuf.view(&names);
    u64 mut at = 0;
    while (at < all.len) {
        u64 end = name_end(all, at);
        // a link to a directory is not followed, so nothing outside the suite goes
        string name = all[at..end];
        if (!is_link(name)) {
            string sub = join(&b, name, ".fort-cache");
            char mut@ own c_sub = str.to_cstr(sub);
            defer del(c_sub);
            if (libc.access(c_sub.ptr, 0) == 0) {
                remove_tree(sub);
            }
        }
        at = end + 1;
    }
}
