/// Supplies paid type-query and paired-region boundary cases.
import heap;
import ownership_api;
import ownership_keys;
import ownership_limits;
import ownership_raw;
import ownership_raw_bytes;
import ownership_raw_bytes_cleanup_env;
import ownership_raw_bytes_env;
import ownership_raw_bytes_publication_env;
import ownership_state;
import ownership_transfer;
import ownership_type_work;
import types;

fn reference_node(types.node* selected) types.node {
    return types.node{.kind = selected->kind, .elem = selected->elem,
        .is_own = selected->is_own, .is_mut = selected->is_mut};
}
fn terminal(ownership_raw_bytes_env.env* e, ownership_api.proof_status proof,
    ownership_raw.request* req) void {
    assert(!ownership_api.successful(proof) && proof.terminal.present);
    assert(ownership_keys.operation(proof.terminal.operation, req->base.operation) == 0);
    assert(ownership_keys.source(proof.terminal.source, req->base.source_position) == 0);
    assert(ownership_keys.operation(e->budget.last_event.operation, req->base.operation) == 0);
    assert(ownership_keys.source(e->budget.last_event.source, req->base.source_position) == 0);
}
// Direct adapter control: a refused paid query keeps its first mapped terminal.
fn adapter_case(bool late) void {
    ownership_raw_bytes_env.env mut e = {};
    ownership_raw_bytes_env.open(&e, late ? 1201 : 1200, 1);
    defer ownership_raw_bytes_env.close(&e);
    types.node* mut left = e.pointer;
    types.node* mut right = e.pointer;
    u64 mut depth = 0;
    while (depth < 12) {
        left = types.type_ptr(&e.table, left, false, false);
        right = types.type_ptr(&e.table, right, false, false);
        depth += 1;
    }
    ownership_raw.request req = ownership_raw_bytes_env.request(&e, late ? 6101 : 6100);
    ownership_raw_bytes.work mut paid = ownership_raw_bytes.work{&e.service, &req,
        ownership_api.proof_status{.kind = ownership_api.proof_kind.complete}, 0};
    bool mut value = false;
    assert(ownership_raw_bytes.compare_type(&paid, left, right,
        ownership_type_work.relation.cast_allowed, &value) && value);
    u64 count = e.budget.calls;
    assert(count > 1);
    ownership_raw_bytes_env.reset_budget(&e);
    e.budget.deny_at = late ? count : 1;
    paid.proof = ownership_api.proof_status{.kind = ownership_api.proof_kind.complete};
    assert(!ownership_raw_bytes.compare_type(&paid, left, right,
        ownership_type_work.relation.cast_allowed, &value));
    terminal(&e, paid.proof, &req);
    assert(paid.proof.terminal.reason == ownership_api.incomplete_reason.work_limit);
    assert(paid.proof.terminal.limit.category == ownership_api.limit_category.w);
    assert(paid.proof.terminal.limit.attempted == 1);
    assert(e.budget.calls == e.budget.deny_at);
    ownership_api.proof_status first = paid.proof;
    assert(!ownership_raw_bytes.compare_type(&paid, left, right,
        ownership_type_work.relation.adds_own, &value));
    assert(e.budget.calls == e.budget.deny_at);
    assert(first.kind == paid.proof.kind && first.failed == paid.proof.failed);
    assert(first.terminal.reason == paid.proof.terminal.reason);
    assert(first.terminal.limit.category == paid.proof.terminal.limit.category);
    assert(first.terminal.limit.used == paid.proof.terminal.limit.used);
    assert(first.terminal.limit.bound == paid.proof.terminal.limit.bound);
    assert(first.terminal.limit.attempted == paid.proof.terminal.limit.attempted);
    terminal(&e, paid.proof, &req);
}
fn named_query(u32 caller, ownership_raw_bytes_publication_env.sample mut* s,
    ownership_raw_bytes.work mut* paid, ownership_raw_bytes.window selected) bool {
    if (caller == 0) {
        return ownership_raw_bytes.publish_contents(paid, &s->e.paired.states[0],
            &s->e.paired.states[0].bytes.representations[0]);
    }
    if (caller == 1) {
        u64 mut row = ownership_raw_bytes.U64_MAX;
        return ownership_raw_bytes.typed_leaf(paid, &s->e.paired.states[0], selected, &row);
    }
    ownership_raw_bytes.reference_result mut out = ownership_raw_bytes.read_reference(
        &s->e.paired.states[0], paid->service, selected, paid->selected);
    paid->proof = out.proof;
    bool accepted = ownership_api.successful(out.proof);
    ownership_raw_bytes.free_reference(&out);
    return accepted;
}
// Nests the captured leaf and fragment type. Each level adds paid type-query work.
fn nested(ownership_raw_bytes_publication_env.sample mut* s, u64 depth)
    ownership_raw_bytes.window {
    types.node* mut selected_type = s->actual;
    u64 mut level = 0;
    while (level < depth) {
        selected_type = types.type_ptr(&s->e.table, selected_type, false, false);
        level += 1;
    }
    ownership_raw_bytes.state mut* input = &s->e.paired.states[0];
    input->raw.leaves[input->raw.origins[0].first_leaf].ty = selected_type;
    input->bytes.representations[0].fragments[0].original_type = selected_type;
    ownership_raw_bytes.window mut selected = s->selected;
    selected.ty = selected_type;
    return selected;
}
fn caller_cost(u32 caller, u64 depth) u64 {
    ownership_raw_bytes_publication_env.sample mut s = {};
    ownership_raw_bytes_publication_env.open(&s, 0, 0, false, false);
    defer ownership_raw_bytes_publication_env.close(&s);
    ownership_raw_bytes.window selected = nested(&s, depth);
    ownership_raw.request req = ownership_raw_bytes_env.request(&s.e, 6105 + caller);
    ownership_raw_bytes_env.reset_budget(&s.e);
    ownership_raw_bytes.work mut paid = ownership_raw_bytes.work{&s.e.service, &req,
        ownership_api.proof_status{.kind = ownership_api.proof_kind.complete}, 0};
    assert(named_query(caller, &s, &paid, selected));
    return s.e.budget.calls;
}
// Caller-path control: each cut of a named caller keeps its first mapped terminal.
fn caller_denial(u32 caller, bool late) void {
    ownership_raw_bytes_publication_env.sample mut s = {};
    ownership_raw_bytes_publication_env.open(&s, 0, 0, false, false);
    defer ownership_raw_bytes_publication_env.close(&s);
    u64 depth = late ? 12 : 2;
    ownership_raw_bytes.window selected = nested(&s, depth);
    ownership_raw_bytes.state mut* input = &s.e.paired.states[0];
    ownership_raw.request req = ownership_raw_bytes_env.request(&s.e, 6105 + caller);
    // A reference read routes its events first. A refused route charge reports no event.
    u64 mut route = 0;
    if (caller == 2) {
        ownership_raw.work_cursor mut cursor = {};
        ownership_raw_bytes_env.reset_budget(&s.e);
        assert(ownership_api.successful(ownership_raw.begin_work(input->core, &s.e.service,
            &req, &cursor)));
        route = s.e.budget.calls;
        assert(route > 0);
    }
    ownership_raw_bytes_env.reset_budget(&s.e);
    ownership_raw_bytes.work mut paid = ownership_raw_bytes.work{&s.e.service, &req,
        ownership_api.proof_status{.kind = ownership_api.proof_kind.complete}, 0};
    assert(named_query(caller, &s, &paid, selected));
    u64 count = s.e.budget.calls;
    assert(count > route && count > caller_cost(caller, depth - 1));
    u64 mut cut = 1;
    while (cut <= count) {
        ownership_raw_bytes_env.reset_budget(&s.e);
        s.e.budget.events = 0;
        s.e.budget.last_event = ownership_api.event_descriptor{};
        s.e.budget.deny_at = cut;
        paid.proof = ownership_api.proof_status{.kind = ownership_api.proof_kind.complete};
        assert(!named_query(caller, &s, &paid, selected));
        assert(s.e.budget.calls == cut && paid.proof.terminal.present);
        assert(paid.proof.terminal.reason == ownership_api.incomplete_reason.work_limit);
        assert(paid.proof.terminal.limit.category == s.e.budget.denied.category);
        assert(paid.proof.terminal.limit.scope == s.e.budget.denied.scope);
        assert(paid.proof.terminal.limit.work == s.e.budget.denied.work);
        assert(paid.proof.terminal.limit.used == s.e.budget.denied.used);
        assert(paid.proof.terminal.limit.bound == s.e.budget.denied.bound);
        assert(paid.proof.terminal.limit.attempted == s.e.budget.denied.attempted);
        assert(ownership_keys.operation(paid.proof.terminal.operation, req.base.operation) == 0);
        assert(ownership_keys.source(paid.proof.terminal.source, req.base.source_position) == 0);
        if (cut > route) {
            assert(s.e.budget.events > 0);
            terminal(&s.e, paid.proof, &req);
            assert(ownership_raw.same_key(s.e.budget.last_event.key,
                req.base.event_bindings[0].key));
        } else { assert(s.e.budget.events == 0); }
        ownership_api.proof_status first = paid.proof;
        if (caller == 2) { input->core->proof = first; }
        assert(!named_query(caller, &s, &paid, selected));
        assert(s.e.budget.calls == cut);
        assert(first.kind == paid.proof.kind && first.failed == paid.proof.failed);
        assert(first.terminal.reason == paid.proof.terminal.reason);
        assert(first.terminal.limit.category == paid.proof.terminal.limit.category);
        assert(first.terminal.limit.used == paid.proof.terminal.limit.used);
        assert(first.terminal.limit.bound == paid.proof.terminal.limit.bound);
        assert(first.terminal.limit.attempted == paid.proof.terminal.limit.attempted);
        assert(input->core->contents[0].kind == ownership_api.contents_kind.reference);
        assert(input->core->contents[0].value_version.ordinal == 1);
        input->core->proof = ownership_api.proof_status{.kind = ownership_api.proof_kind.complete};
        cut += 1;
    }
}
fn query_case(u32 caller, u32 mode) void {
    if (mode >= 6) { caller_denial(caller, mode == 7); return; }
    ownership_raw_bytes_publication_env.sample mut s = {};
    ownership_raw_bytes_publication_env.open(&s, 0, 0, false, false);
    defer ownership_raw_bytes_publication_env.close(&s);
    types.node mut destination = reference_node(s.actual);
    types.node mut source = reference_node(s.incoming);
    types.node mut nested_destination = reference_node(s.actual);
    types.node mut nested_source = reference_node(s.incoming);
    if (mode == 1 || mode == 2) {
        destination.elem = &nested_destination;
        source.elem = &nested_source;
        if (mode == 1) { nested_destination.is_own = true; }
        else { nested_destination.is_mut = true; }
    }
    if (mode == 3) { source.kind = types.type_kind.k_span; }
    if (mode == 4) { source.elem = &source; }
    if (mode == 5) { source.elem = null; }
    ownership_raw_bytes.state mut* input = &s.e.paired.states[0];
    input->raw.leaves[input->raw.origins[0].first_leaf].ty =
        caller == 1 ? cast(&source, types.node*) : cast(&destination, types.node*);
    input->bytes.representations[0].fragments[0].original_type = &source;
    ownership_raw.request req = ownership_raw_bytes_env.request(&s.e, 6110 + caller * 8 + mode);
    ownership_raw_bytes_env.reset_budget(&s.e);
    ownership_raw_bytes.work mut paid = ownership_raw_bytes.work{&s.e.service, &req,
        ownership_api.proof_status{.kind = ownership_api.proof_kind.complete}, 0};
    bool mut accepted = false;
    if (caller == 0) {
        accepted = ownership_raw_bytes.publish_contents(&paid, input,
            &input->bytes.representations[0]);
        if (mode == 0) {
            assert(accepted && input->core->contents[0].kind ==
                ownership_api.contents_kind.reference);
        } else if (mode < 4) {
            assert(accepted && input->core->contents[0].kind ==
                ownership_api.contents_kind.unknown);
        }
    } else if (caller == 1) {
        ownership_raw_bytes.window mut selected = s.selected;
        selected.ty = &destination;
        u64 mut row = ownership_raw_bytes.U64_MAX;
        accepted = ownership_raw_bytes.typed_leaf(&paid, input, selected, &row);
        if (mode == 0) { assert(accepted && row == 0); }
    } else {
        ownership_raw_bytes.window mut selected = s.selected;
        selected.ty = &destination;
        ownership_raw_bytes.reference_result mut out = ownership_raw_bytes.read_reference(input,
            &s.e.service, selected, &req);
        defer ownership_raw_bytes.free_reference(&out);
        paid.proof = out.proof;
        accepted = ownership_api.successful(out.proof);
        if (mode == 0) { assert(accepted && out.value.borrows.len == 1); }
    }
    if (mode >= 4 || (caller != 0 && mode != 0)) {
        assert(!accepted);
        terminal(&s.e, paid.proof, &req);
        assert(paid.proof.terminal.reason == ownership_api.incomplete_reason.unknown_effect);
        if (mode >= 4) {
            assert(s.e.budget.last_event.text == "raw type layout remains unresolved");
        }
    }
}
fn size_case(u32 site, u32 mode) void {
    ownership_raw_bytes_publication_env.sample mut s = {};
    ownership_raw_bytes_publication_env.open(&s, site == 2 ? 3 : 0, 0, false, false);
    defer ownership_raw_bytes_publication_env.close(&s);
    types.node mut layout = reference_node(s.actual);
    if (mode == 1) { layout.elem = null; }
    if (mode >= 2) {
        layout.kind = types.type_kind.k_array;
        layout.elem = s.actual;
        layout.len = mode == 2 ? 0 : types.TYPE_MAX_SIZE / 8 + 1;
    }
    ownership_raw_bytes.state mut* input = &s.e.paired.states[0];
    input->raw.origins[0].layout = &layout;
    ownership_raw.request req = ownership_raw_bytes_env.request(&s.e, 6200 + site * 4 + mode);
    ownership_raw_bytes_env.reset_budget(&s.e);
    ownership_raw_bytes.work mut paid = ownership_raw_bytes.work{&s.e.service, &req,
        ownership_api.proof_status{.kind = ownership_api.proof_kind.complete}, 0};
    bool mut accepted = false;
    u64 mut number = 0;
    if (site == 0) {
        ownership_raw_bytes.window mut selected = s.selected;
        selected.ty = &layout;
        accepted = ownership_raw_bytes.reference_size(&paid, selected, &number);
        if (mode == 0) { assert(number == 8); }
    } else if (site == 1) {
        types.node* mut actual = null;
        accepted = ownership_raw_bytes.publication_leaf(&paid, input, s.selected, &number,
            &actual);
        if (mode == 0) { assert(number == 0 && actual == s.actual); }
        if (mode == 2) { assert(number == ownership_raw_bytes.U64_MAX && actual == null); }
    } else if (site == 2) {
        ownership_raw.origin captured = input->raw.origins[0];
        ownership_raw.storage_leaf leaf = input->raw.leaves[captured.first_leaf];
        accepted = ownership_raw_bytes.repeated_leaf(&paid, input, captured, leaf, s.selected);
    } else if (site == 3) {
        accepted = ownership_raw_bytes.typed_leaf(&paid, input, s.selected, &number);
        if (mode == 0) { assert(number == 0); }
    } else if (site == 4) {
        ownership_raw_bytes.window mut selected = s.selected;
        selected.ty = &layout;
        accepted = ownership_raw_bytes.move_window(&paid, input, selected);
    } else {
        ownership_raw_bytes_env.env mut e = {};
        ownership_raw_bytes_env.owner_setup(&e, 1230, false);
        defer ownership_raw_bytes_env.close(&e);
        types.node mut selected = reference_node(e.selected_type);
        if (mode == 1) { selected.elem = null; }
        types.node* operand = mode == 0 ? e.selected_type : cast(&selected, types.node*);
        ownership_raw.request moving = ownership_raw_bytes_env.move_request(&e, 1, 2, 6230);
        ownership_raw_bytes_env.reset_budget(&e);
        ownership_raw_bytes.result mut out = ownership_raw_bytes.semantic_move(&e.paired.states[0],
            &e.service, ownership_raw_bytes_env.window(&e, 1, 0, 8, operand),
            ownership_raw_bytes_env.window(&e, 2, 0, 8, operand), &moving);
        defer ownership_raw_bytes.free_result(&out);
        accepted = ownership_api.successful(out.proof);
        if (mode == 0) { assert(accepted); }
        else { assert(!accepted); terminal(&e, out.proof, &moving); }
        return;
    }
    if (mode == 0 || (site == 1 && mode == 2)) { assert(accepted); }
    else { assert(!accepted); terminal(&s.e, paid.proof, &req); }
    assert(input->core->allocations[0].obligation);
}
fn simple(ownership_raw_bytes_env.env* e, u64 entries) ownership_raw_bytes.state {
    ownership_raw_bytes.state mut input = {};
    input.core = new(ownership_state.state);
    *input.core = ownership_state.empty();
    input.raw.core = input.core;
    input.bytes.facts = ownership_state.empty();
    input.bytes.representations = new(ownership_raw_bytes.representation, entries);
    input.bytes.representations_len = entries;
    u64 mut i = 0;
    while (i < entries) {
        ownership_raw_bytes.representation mut* item = &input.bytes.representations[i];
        item->selected = ownership_raw_bytes_env.window(e, 1, 0, 8, e->pointer);
        item->fragments = new(ownership_raw_bytes.fragment, 1);
        item->fragments_len = 1;
        item->fragments[0] = ownership_raw_bytes.fragment{.begin = 0, .end = 8};
        i += 1;
    }
    return input;
}
fn snapshots(ownership_raw_bytes.state mut* input, u64 entries) void {
    input->bytes.snapshots = new(ownership_raw_bytes.snapshot, entries);
    input->bytes.snapshots_len = entries;
    u64 mut i = 0;
    while (i < entries) {
        ownership_raw_bytes.snapshot mut* item = &input->bytes.snapshots[i];
        item->key = 1;
        item->bytes = 8;
        item->facts = ownership_state.empty();
        item->fragments = new(ownership_raw_bytes.fragment, 1);
        item->fragments_len = 1;
        item->fragments[0] = ownership_raw_bytes.fragment{.begin = 0, .end = 8};
        i += 1;
    }
}
fn measure(ownership_raw_bytes_env.env mut* e, ownership_raw_bytes.state* input,
    ownership_raw_bytes.retained_edit edit) u64 {
    ownership_raw.request req = ownership_raw_bytes_env.request(e, 6300);
    ownership_raw_bytes_env.reset_budget(e);
    ownership_raw_bytes.work mut paid = ownership_raw_bytes.work{&e->service, &req,
        ownership_api.proof_status{.kind = ownership_api.proof_kind.complete}, 0};
    u64 mut amount = 0;
    assert(ownership_raw_bytes.paired_regions(&paid, input->core, &input->raw, &input->bytes,
        edit, &amount));
    assert(ownership_api.successful(paid.proof));
    return amount;
}
fn region_case(u32 mode) void {
    ownership_raw_bytes_env.env mut e = {};
    ownership_raw_bytes_env.open(&e, 1250 + mode, 1);
    defer ownership_raw_bytes_env.close(&e);
    if (mode == 11 || mode == 27) {
        ownership_raw_bytes_env.close(&e);
        if (mode == 11) { ownership_raw_bytes_env.setup(&e, 1280, 0, false); }
        else { ownership_raw_bytes_env.owner_setup(&e, 1281, false); }
        if (mode == 11) {
            ownership_raw_bytes.byte_effect change = ownership_raw_bytes_env.effect(&e,
                ownership_raw_bytes.effect_kind.read,
                ownership_raw_bytes_env.window(&e, 1, 0, 8, e.byte));
            ownership_raw_bytes.result mut out = ownership_raw_bytes_env.try_effect(&e, change,
                6301);
            defer ownership_raw_bytes.free_result(&out);
            assert(!ownership_api.successful(out.proof) && out.states.len == 0);
            assert(e.budget.last_event.text == "byte snapshot identity is invalid");
        } else {
            ownership_raw_bytes.result mut out = ownership_raw_bytes_env.try_move(&e, 1, 2, 8,
                6302);
            defer ownership_raw_bytes.free_result(&out);
            assert(ownership_api.successful(out.proof) && out.states.len == 1);
            assert(out.states[0].core->allocations[0].owner.place.root.ordinal == 2);
        }
        return;
    }
    ownership_raw_bytes.state mut input = simple(&e, mode >= 19 && mode != 24 ? 1 : 2);
    defer ownership_raw_bytes.free(&input);
    ownership_raw_bytes.retained_edit mut edit = {};
    u64 mut expected = 1;
    ownership_api.contents_fact first = ownership_raw_bytes_env.value(&e, 1, 1, 1, 0, 8, 1);
    ownership_api.contents_fact second = ownership_raw_bytes_env.value(&e, 2, 2, 2, 0, 8, 1);
    ownership_raw_bytes.fragment[1] mut incoming = {
        ownership_raw_bytes.fragment{.begin = 0, .end = 8}};
    if (mode == 0 || mode == 1) {
        input.bytes.representations[1].selected.source.ordinal += mode == 0 ? 1 : 0;
        input.bytes.representations[1].selected.source.function.declaration.declaration +=
            mode == 1 ? 1 : 0;
        expected = 2;
    }
    if (mode == 3 || mode == 4) {
        input.bytes.representations[1].fragments[0].begin = mode == 3 ? 4 : 8;
        input.bytes.representations[1].fragments[0].end = mode == 3 ? 12 : 16;
        expected = 2;
    }
    if (mode == 5 || mode == 6) {
        u64 mut i = 0;
        while (i < 2) {
            if (mode == 5) { input.bytes.representations[i].fragments[0].end = 0; }
            else { input.bytes.representations[i].selected.source = ownership_api.entity_id{}; }
            i += 1;
        }
        expected = mode == 5 ? 0 : 2;
        if (mode == 6) {
            assert(measure(&e, &input, edit) == 2);
            // A key of another kind proves no source equality, even with a nonzero ordinal.
            i = 0;
            while (i < 2) {
                input.bytes.representations[i].selected.source.kind =
                    ownership_api.entity_kind.allocation;
                input.bytes.representations[i].selected.source.ordinal = 7;
                i += 1;
            }
            assert(measure(&e, &input, edit) == 2);
            // Captured sources exclude ordinal zero, so a public ledger row cannot prove it.
            input.bytes.representations[0].selected.source = ownership_api.entity_id{
                .kind = ownership_api.entity_kind.source};
            input.bytes.representations[1].selected.source = ownership_api.entity_id{
                .kind = ownership_api.entity_kind.source};
        }
    }
    if (mode >= 7 && mode <= 10) {
        input.bytes.representations[0].fragments_len = 0;
        input.bytes.representations[1].fragments_len = 0;
        snapshots(&input, 2);
        if (mode == 7) { input.bytes.snapshots[1].key = 2; expected = 2; }
        if (mode == 9) { input.bytes.snapshots[1].fragments[0].begin = 4; expected = 2; }
        if (mode == 10) {
            input.bytes.snapshots[0].fragments[0].end = 0;
            input.bytes.snapshots[1].fragments[0].end = 0;
            expected = 0;
        }
    }
    if (mode == 12) { snapshots(&input, 1); expected = 2; }
    if (mode >= 13 && mode <= 16) {
        u64 mut i = 0;
        while (i < 2) {
            input.bytes.representations[i].fragments[0].value =
                ownership_state.copy_contents(&input.bytes.facts, first);
            input.bytes.representations[i].fragments[0].known = mode != 16;
            i += 1;
        }
        expected = mode == 16 ? 1 : 3;
        if (mode == 13) { ownership_state.append_contents(input.core, first); }
        if (mode == 14) {
            ownership_api.contents_fact mut value = second;
            ownership_api.borrow_relation[1] mut ranges = {second.borrows[0]};
            ranges[0].range.key = first.borrows[0].range.key;
            value.borrows = ranges[..];
            input.bytes.representations[1].fragments[0].value =
                ownership_state.copy_contents(&input.bytes.facts, value);
            expected = 4;
        }
        if (mode == 15) {
            i = 0;
            while (i < 2) {
                ownership_api.contents_fact mut value = first;
                ownership_api.borrow_relation[1] mut ranges = {first.borrows[0]};
                ranges[0].range.key = ownership_api.entity_id{};
                value.borrows = ranges[..];
                input.bytes.representations[i].fragments[0].value =
                    ownership_state.copy_contents(&input.bytes.facts, value);
                i += 1;
            }
            expected = 5;
        }
    }
    if (mode == 17) {
        ownership_state.append_contents(&input.bytes.facts,
            ownership_transfer.empty_value(ownership_raw_bytes_env.place(&e, 1)));
    }
    if (mode == 18) {
        input.raw.leaves = new(ownership_raw.storage_leaf, 3);
        input.raw.leaves_len = 3;
        expected = 4;
    }
    if (mode == 19 || mode == 20) {
        edit.kind = ownership_raw_bytes.retained_edit_kind.seed;
        edit.selected = ownership_raw_bytes_env.window(&e, 2, 0, 8, e.pointer);
        edit.value = first;
        edit.known = mode == 19;
        expected = mode == 19 ? 4 : 1;
    }
    if (mode == 21) {
        edit.kind = ownership_raw_bytes.retained_edit_kind.capture;
        edit.selected = input.bytes.representations[0].selected;
        edit.snapshot_key = 1;
        expected = 2;
    }
    if (mode >= 22 && mode <= 25) {
        edit.kind = ownership_raw_bytes.retained_edit_kind.replacement;
        edit.target = &input.bytes.representations[0];
        edit.selected = input.bytes.representations[0].selected;
        if (mode == 22 || mode == 24) {
            edit.selected.begin = 3;
            edit.selected.end = 4;
            expected = 2;
        } else { edit.incoming = incoming[..]; }
        if (mode == 23) {
            input.bytes.representations[0].fragments[0].value =
                ownership_state.copy_contents(&input.bytes.facts, first);
            input.bytes.representations[0].fragments[0].known = true;
            assert(measure(&e, &input, ownership_raw_bytes.retained_edit{}) == 3);
        }
        if (mode == 24) {
            input.bytes.representations[0].fragments[0].value =
                ownership_state.copy_contents(&input.bytes.facts, first);
            input.bytes.representations[0].fragments[0].known = true;
            input.bytes.representations[1].selected.source.ordinal = 102;
            input.bytes.representations[1].fragments[0].value =
                ownership_state.copy_contents(&input.bytes.facts, second);
            input.bytes.representations[1].fragments[0].known = true;
            expected = 7;
        }
    }
    if (mode == 28) {
        ownership_state.append_contents(input.core, first);
        edit.value = second;
        edit.add_value = true;
        edit.replace_core = true;
        edit.core_row = 0;
        expected = 3;
    }
    if (mode == 30) { input.bytes.representations[0].fragments_len = 0; expected = 0; }
    assert(measure(&e, &input, edit) == expected);
    if (mode == 16) {
        ownership_state.append_contents(&input.bytes.facts, second);
        assert(measure(&e, &input, edit) == 3);
    }
    if (mode == 8) {
        input.bytes.snapshots[0].key = 0;
        input.bytes.snapshots[1].key = 0;
        assert(measure(&e, &input, edit) == 1);
    }
    e.limits.r = expected == 0 ? 1 : expected;
    if (mode == 16) { e.limits.r = 3; }
    {
        ownership_raw.request req = ownership_raw_bytes_env.request(&e, 6330 + mode);
        ownership_raw_bytes_env.reset_budget(&e);
        ownership_raw_bytes.work mut paid = ownership_raw_bytes.work{&e.service, &req,
            ownership_api.proof_status{.kind = ownership_api.proof_kind.complete}, 0};
        if (mode == 29) { e.budget.meter.used.r = ownership_raw_bytes.U64_MAX; }
        bool accepted = ownership_raw_bytes.require_paired(&paid, &input, edit);
        if (mode == 29) {
            assert(!accepted && paid.proof.terminal.limit.saturated);
            terminal(&e, paid.proof, &req);
        } else {
            assert(accepted && e.budget.meter.used.r == (mode == 16 ? 3 : expected));
            if (mode == 22 || mode == 23 || mode == 24) {
                assert(ownership_raw_bytes.replace_fragments(&paid, &input,
                    &input.bytes.representations[0], edit.selected, edit.incoming,
                    edit.source_begin));
                assert(measure(&e, &input, ownership_raw_bytes.retained_edit{}) == expected);
                if (mode == 22) { assert(input.bytes.representations[0].fragments_len == 2); }
                if (mode == 23) {
                    incoming[0].end = 0;
                    assert(ownership_raw_bytes.replace_fragments(&paid, &input,
                        &input.bytes.representations[0], edit.selected, incoming[..], 0));
                    assert(input.bytes.representations[0].fragments_len == 0);
                    assert(measure(&e, &input, ownership_raw_bytes.retained_edit{}) == 0);
                }
            }
            if (mode == 25) {
                assert(ownership_raw_bytes.replace_fragments(&paid, &input,
                    &input.bytes.representations[0], edit.selected, incoming[..], 0));
                assert(ownership_raw_bytes.replace_fragments(&paid, &input,
                    &input.bytes.representations[0], edit.selected, incoming[..], 0));
                assert(e.budget.meter.used.r == 1);
            }
            if (mode == 30) {
                // An empty edit of an empty representation counts and keeps zero rows.
                ownership_raw_bytes.fragment@ none = {};
                u64 mut rows = 1;
                assert(ownership_raw_bytes.replacement_storage(&paid,
                    &input.bytes.representations[0], input.bytes.representations[0].selected,
                    none, 0, &rows) && rows == 0);
                assert(ownership_raw_bytes.replace_fragments(&paid, &input,
                    &input.bytes.representations[0], input.bytes.representations[0].selected,
                    none, 0));
                assert(input.bytes.representations[0].fragments_len == 0);
                assert(input.bytes.representations[0].fragments.len == 0);
                assert(e.budget.meter.used.r == 0);
            }
            if (mode == 26) {
                ownership_raw_bytes.result mut out = ownership_raw_bytes.clone(&input,
                    &e.service, &req);
                defer ownership_raw_bytes.free_result(&out);
                assert(ownership_api.successful(out.proof) && out.states.len == 1);
                assert(e.budget.meter.used.r == expected);
            }
            if (mode == 31) {
                edit.kind = ownership_raw_bytes.retained_edit_kind.replacement;
                edit.target = &input.bytes.representations[0];
                edit.selected = input.bytes.representations[0].selected;
                edit.selected.begin = 3;
                edit.selected.end = 4;
                assert(!ownership_raw_bytes.require_paired(&paid, &input, edit));
                terminal(&e, paid.proof, &req);
                assert(paid.proof.terminal.limit.category == ownership_api.limit_category.r);
                assert(paid.proof.terminal.limit.used == 1 && paid.proof.terminal.limit.bound == 1);
                assert(paid.proof.terminal.limit.attempted == 2);
                assert(input.bytes.representations[0].fragments_len == 1);
            }
        }
    }
    if (mode == 29) {
        ownership_raw.request req = ownership_raw_bytes_env.request(&e, 6370);
        ownership_raw_bytes_env.reset_budget(&e);
        ownership_raw_bytes.work mut paid = ownership_raw_bytes.work{&e.service, &req,
            ownership_api.proof_status{.kind = ownership_api.proof_kind.complete}, 0};
        u64 mut rows = 0;
        assert(!ownership_raw_bytes.replacement_storage(&paid,
            &input.bytes.representations[0], input.bytes.representations[0].selected,
            incoming[..], ownership_raw_bytes.U64_MAX, &rows));
        terminal(&e, paid.proof, &req);
        assert(input.bytes.representations[0].fragments_len == 1);
    }
}
fn allocator_round(bool regions, bool late) void {
    ownership_raw_bytes_env.env mut e = {};
    ownership_raw_bytes_env.open(&e, 1300, 1);
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes.state mut input = simple(&e, 16);
    defer ownership_raw_bytes.free(&input);
    u64 mut i = 0;
    while (i < 16) {
        input.bytes.representations[i].selected.source.ordinal = 100 + cast(i, u32);
        if (regions) {
            ownership_api.contents_fact value = ownership_raw_bytes_env.value(&e, 1,
                cast(i, u32) + 1, cast(i, u32) + 1, 0, 8, 1);
            input.bytes.representations[i].fragments[0].value =
                ownership_state.copy_contents(&input.bytes.facts, value);
            input.bytes.representations[i].fragments[0].known = true;
        }
        i += 1;
    }
    ownership_raw.request req = ownership_raw_bytes_env.request(&e, 6400);
    ownership_raw_bytes.work mut paid = ownership_raw_bytes.work{&e.service, &req,
        ownership_api.proof_status{.kind = ownership_api.proof_kind.complete}, 0};
    u64 mut amount = 0;
    assert(ownership_raw_bytes.paired_regions(&paid, input.core, &input.raw, &input.bytes,
        ownership_raw_bytes.retained_edit{}, &amount));
    assert(amount == (regions ? 48 : 16));
    u64 cost = e.budget.calls;
    ownership_raw_bytes_env.reset_budget(&e);
    paid.proof = ownership_api.proof_status{.kind = ownership_api.proof_kind.complete};
    if (late) { e.budget.deny_at = cost; }
    bool accepted = ownership_raw_bytes.paired_regions(&paid, input.core, &input.raw,
        &input.bytes, ownership_raw_bytes.retained_edit{}, &amount);
    assert(accepted != late);
    if (late) { terminal(&e, paid.proof, &req); assert(e.budget.calls == cost); }
}
fn allocator(bool regions, bool late) void {
    u64 mut warm = 0;
    u64 mut measured = 0;
    // Linux malloc_info counts tcache chunks as live. The metric's own buffer fills one bin of
    // seven chunks, so the warm rounds measure too. The counter rounds use no chunk of that size.
    while (warm < 64) {
        allocator_round(regions, late);
        measured = ownership_raw_bytes_cleanup_env.live_bytes();
        warm += 1;
    }
    assert(measured > 0);
    allocator_round(regions, late);
    u64 before_live = ownership_raw_bytes_cleanup_env.live_bytes();
    u64 before_system = heap.system_view();
    u64 mut best_live = ownership_raw_bytes.U64_MAX;
    u64 mut best_system = ownership_raw_bytes.U64_MAX;
    u64 mut round = 0;
    while (round < 256) {
        allocator_round(regions, late);
        u64 live = heap.distance(before_live, ownership_raw_bytes_cleanup_env.live_bytes());
        u64 system = heap.distance(before_system, heap.system_view());
        if (round >= 240 && live < best_live) { best_live = live; }
        if (round >= 240 && system < best_system) { best_system = system; }
        round += 1;
    }
    assert(best_live < (heap.ADDRESS_IS_A_VIEW ? 2048 : 256));
    assert(best_system < (heap.ADDRESS_IS_A_VIEW ? 1 : 256));
    println("adaptation allocator ", regions, " ", late, " released");
}
