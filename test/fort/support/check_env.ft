/// Provides the shared checker-test environment. It combines a module sandbox, a checked
/// closure, and queries for symbols, types, and annotations.
//
// The checker writes `ty`, `sym`, `ann`, and `aux` annotations on the tree.
// Neither `--tokens` nor `--ast` prints them. These tests assert the expression
// Tests assert expression types, symbols, folded values, field offsets, and
// `ann` bits. They also assert that a second check clears these annotations.
//
// Two probes of the checker are reachable only from here. src/fort/check.ft resolves the
// declarations of a module and stops before the function bodies, which belong to check_stmt.ft.
// An expression inside a body is reached by calling check_expr on its node directly, after
// check_module_decls has left the module in place. The `empty` and `is_mut` fields belong to
// one checked expression, and no diagnostic prints them separately.
import ast;
import check;
import check_stmt;
import consts;
import diag;
import modules;
import modules_env;
import scope;
import session;
import std.str;
import std.strmap;
import std.strbuf;
import types;

// The sandbox, the checker over it, and the buffer the text queries build
// their answer in.
struct env {
    modules_env.env m;
    check.checker ck;
    strbuf.str_buf buf;
    // The options of the next check, which check_entry applies and resets, so
    // that a test states the ones it needs and leaves the next one the
    // defaults. The C suite's `want_main` and `want_mute`.
    bool want_main;
    bool want_mute;
}

// Prepares a fresh sandbox with an empty session, an empty set and a checker
// over them. The entry rule is on by default, as the driver has it for a
// build.
//
// It fills a caller's value instead of returning one. modules_env.open can
// return because a module set does not point into its adjacent session. A
// checker does hold its reporting session. Therefore, it must initialize at
// its final address.
fn open(env mut* e) void {
    e->m = modules_env.open();
    check.check_init(&e->ck, &e->m.s);
    e->want_main = true;
}

// Releases the checker, then the modules, then the session: every annotation
// points into the checker, every name of a tree into the session, and the
// trees belong to the modules.
fn close(env mut* e) void {
    check.check_free(&e->ck);
    strbuf.free(&e->buf);
    modules_env.close(&e->m);
}

// Closes the environment and opens a fresh one at the same address, which is
// what test/check_helpers.h's begin() does before every check. A module set
// answers a path it has already loaded from the tree that load left, so a
// second check_src over one environment would check the first source again;
// and the diagnostics of the first check would still be in the sink. A test
// that checks two sources calls this between them, after the assertions about
// the first.
fn reopen(env mut* e) void {
    close(e);
    open(e);
}

// Writes a module at `rel` under the sandbox.
fn add(env mut* e, string rel, string text) void {
    modules_env.add(&e->m, rel, text);
}

fn add2(env mut* e, string rel, string first, string second) void {
    modules_env.add2(&e->m, rel, first, second);
}

fn add3(env mut* e, string rel, string first, string second, string third) void {
    modules_env.add3(&e->m, rel, first, second, third);
}

// Loads the closure of the sandbox module `rel` and checks it. False when the
// load or the check reported a diagnostic. Checking runs even when the load
// failed, as the front end does, so that a module whose import did not parse
// is still checked.
fn check_entry(env mut* e, string rel) bool {
    bool loaded = modules_env.load(&e->m, rel);
    e->ck.require_main = e->want_main;
    e->ck.mute = e->want_mute;
    e->want_main = true;
    e->want_mute = false;
    bool checked = check_stmt.check_program(&e->ck, &e->m.set);
    return checked && loaded;
}

// Writes `text` as the entry module `main.ft` and checks it.
fn check_src(env mut* e, string text) bool {
    add(e, "main.ft", text);
    return check_entry(e, "main.ft");
}

// The same for a source that is a list of module-level declarations, with the
// `main` an entry module needs appended: a declaration on line n of `decls` is
// on line n of the module, so a position assertion reads off the text the test
// wrote.
fn check_decls(env mut* e, string decls) bool {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, decls);
    strbuf.append(&b, "fn main() i32 {\n    return 0;\n}\n");
    return check_src(e, strbuf.view(&b));
}

// `body` as the whole of the body of `fn main() i32`, with the `return 0;` a
// value function needs appended: the shape most statement assertions are
// written against, as test/check_helpers.h's check_body is. A statement on
// line n of `body` is on line n + 1 of the module.
fn check_body(env mut* e, string body) bool {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "fn main() i32 {\n");
    strbuf.append(&b, body);
    strbuf.append(&b, "\n    return 0;\n}\n");
    return check_src(e, strbuf.view(&b));
}

// Checks the entry module even though it did not parse, which the driver never
// does but an editor mode will: the error nodes stand where statements, fields
// and declarations were expected, and every pass skips them. The entry rule
// does not apply to a file under inspection, so it is off.
//
// test/check_helpers.h's check_broken starts a fresh sandbox and checker. This
// helper uses its given environment. A caller checks a second source only
// after reopen, as it does after check_src. The options are applied and reset
// as check_entry does them, so a want_mute set for this call does not leak
// into the next one.
fn check_broken(env mut* e, string text) bool {
    add(e, "main.ft", text);
    modules_env.load(&e->m, "main.ft");
    e->ck.require_main = false;
    e->ck.mute = e->want_mute;
    e->want_main = true;
    e->want_mute = false;
    modules.module* m = module_at(e, "main");
    return m != null && check_stmt.check_module(&e->ck, m);
}

// `T N = <expr>;` as the whole of a module. A module initializer is the one
// expression context handled during declaration checking. Returns whether the
// module checked clean.
fn check_init_of(env mut* e, string type_text, string expr_text) bool {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, type_text);
    strbuf.append(&b, " probe = ");
    strbuf.append(&b, expr_text);
    strbuf.append(&b, ";\n");
    return check_decls(e, strbuf.view(&b));
}

// ---- the tree and the symbols ------------------------------------------------------

// The module of the closure at `path`, or null.
fn module_at(env* e, string path) modules.module* {
    return modules.find(&e->m.set, path);
}

// The same module as the set owns it. `modules.find` hands out an immutable
// view on purpose, and no cast turns one back into a mutable reference, so a
// test that writes through a module reads the owning slot instead. It reads
// the index `modules.find` reads rather than scanning, so the two answer the
// same module for the same path by the same route.
fn module_mut(env mut* e, string path) modules.module mut* {
    i64 mut at = 0;
    if (!strmap.get(&e->m.set.by_path, path, &at)) {
        return null;
    }
    return e->m.set.modules.items[cast(at, u64)];
}

// The syntax tree of the module at `path`, or null.
fn module_ast(env* e, string path) ast.node mut* {
    modules.module* m = module_at(e, path);
    if (m == null) {
        return null;
    }
    return m->ast;
}

// The symbol of a top-level declaration of the module at `path`.
fn sym_of(env* e, string path, string name) ast.sym mut* {
    scope.binding* b = modules_env.bound(&e->m, path, name);
    if (b == null || b->node == null) {
        return null;
    }
    return b->node->sym;
}

// The symbol of a top-level declaration of the entry module `main`.
fn sym_main(env* e, string name) ast.sym mut* {
    return sym_of(e, "main", name);
}

// The first node of `kind` in the tree below `n`, in source order. `name`
// selects by the node's own name when it is not the empty string.
fn node_find(ast.node mut* n, ast.ast_kind kind, string name) ast.node mut* {
    if (n == null) {
        return null;
    }
    if (n->kind == kind && (name.len == 0 || n->name == name)) {
        return n;
    }
    ast.node mut* mut hit = node_find(n->a, kind, name);
    if (hit != null) {
        return hit;
    }
    hit = node_find(n->b, kind, name);
    if (hit != null) {
        return hit;
    }
    hit = node_find(n->c, kind, name);
    if (hit != null) {
        return hit;
    }
    hit = node_find(n->d, kind, name);
    if (hit != null) {
        return hit;
    }
    u64 mut i = 0;
    while (i < ast.ast_len(n)) {
        hit = node_find(ast.ast_child_mut(n, i), kind, name);
        if (hit != null) {
            return hit;
        }
        i += 1;
    }
    return null;
}

// The first node of `kind` named `name` in the entry module.
fn node_in_main(env* e, ast.ast_kind kind, string name) ast.node mut* {
    return node_find(module_ast(e, "main"), kind, name);
}

// ---- the annotations ---------------------------------------------------------------

// The canonical spelling of a type, valid until the next text query.
fn type_text(env mut* e, types.node* t) string {
    strbuf.clear(&e->buf);
    if (t == null) {
        strbuf.append(&e->buf, "<null>");
    } else {
        types.type_to_str(t, &e->buf);
    }
    return strbuf.view(&e->buf);
}

// The spelling of a declaration's type, level 0 included.
fn sym_type_text(env mut* e, ast.sym* s) string {
    strbuf.clear(&e->buf);
    if (s == null || s->ty == null) {
        strbuf.append(&e->buf, "<null>");
    } else {
        types.type_to_str_decl(s->ty, s->mut0, &e->buf);
    }
    return strbuf.view(&e->buf);
}

// The declared type of the module declaration `name`, level 0 included.
fn decl_type(env mut* e, string name) string {
    ast.node mut* d = node_in_main(e, ast.ast_kind.k_var_decl, name);
    if (d == null) {
        return sym_type_text(e, null);
    }
    return sym_type_text(e, d->sym);
}

// The type the checker gave the initializer of the declaration `name`.
fn init_type(env mut* e, string name) string {
    ast.node mut* d = node_in_main(e, ast.ast_kind.k_var_decl, name);
    if (d == null || d->b == null) {
        return type_text(e, null);
    }
    return type_text(e, d->b->ty);
}

// The type the checker gave the initializer of `probe`, which is what
// check_init_of writes.
fn probe_type(env mut* e) string {
    return init_type(e, "probe");
}

// The folded value of the initializer of the declaration `name`, as an i64;
// false when it is not an integer constant.
fn init_int(env mut* e, string name, i64 mut* out) bool {
    ast.node mut* d = node_in_main(e, ast.ast_kind.k_var_decl, name);
    if (d == null || d->b == null) {
        return false;
    }
    return consts.cv_to_i64(check.check_node_value(&e->ck, d->b), out);
}

// The folded value of the initializer of the declaration `name` as the
// binary64 pattern of a float constant. False when it is not one. It is
// init_int's float twin: a float constant is held as its bits, since the
// compiler's own source has no float type (consts.ft, flt.ft).
fn init_float(env mut* e, string name, u64 mut* out) bool {
    ast.node mut* d = node_in_main(e, ast.ast_kind.k_var_decl, name);
    if (d == null || d->b == null) {
        return false;
    }
    consts.cval v = check.check_node_value(&e->ck, d->b);
    if (!consts.cv_is_float(v)) {
        return false;
    }
    *out = consts.cv_float_bits(v);
    return true;
}

// The byte offset the checker recorded on the field `field` of the struct
// `name`. `aux` carries a constant's value index on one node kind and a
// field's byte offset on another, so it is never read without the bit that
// says which: on a field declaration that is ANN_RESOLVED, which check_sym_new
// sets when it makes the field's symbol, and a field that did not resolve
// carries no offset to read.
fn field_offset(env* e, string name, string field) u64 {
    ast.node mut* decl = node_in_main(e, ast.ast_kind.k_struct_decl, name);
    ast.node mut* f = node_find(decl, ast.ast_kind.k_field_decl, field);
    if (f == null) {
        panic("check_env.field_offset: no such field");
    }
    if (!has_ann(f, check.ANN_RESOLVED)) {
        panic("check_env.field_offset: the field did not resolve, so aux is not an offset");
    }
    return f->aux;
}

// Whether every bit of `mask` is set on the node.
fn has_ann(ast.node* n, u32 mask) bool {
    return n != null && (n->ann & mask) == mask;
}

// ---- diagnostics -------------------------------------------------------------------

// Whether any diagnostic reported so far holds `text`.
fn said(env mut* e, string text) bool {
    return modules_env.said(&e->m, text);
}

// The errors reported so far, notes excluded.
fn errors(env* e) u64 {
    return modules_env.errors(&e->m);
}

// The number of diagnostics reported, notes included.
fn reports(env mut* e) u64 {
    return modules_env.reports(&e->m);
}

// The `i`-th diagnostic as `<line>:<col>: <message>`, valid until the next
// text query: the position is what a test about a diagnostic asserts.
fn report_text(env mut* e, u64 i) string {
    diag_record_text(e, i);
    return strbuf.view(&e->buf);
}

// The file the `i`-th diagnostic stands in, or the empty string when there is
// no such diagnostic, so that a failing assertion is about the file rather
// than a panic. This result distinguishes reports from two files.
// `report_text` prints only the line and the column.
fn report_file(env mut* e, u64 i) string {
    if (i >= modules_env.reports(&e->m)) {
        return "";
    }
    return modules_env.report_at(&e->m, i).loc.file;
}

// The severity of the `i`-th diagnostic as the text form spells it, `"error"`
// or `"note"`, and `"<none>"` when there is no such diagnostic. A note carries
// no severity of its own in the document, its place saying what it is, so a
// test that asserts a place asserts this beside it. It answers a text and not
// a bool so that an index past the end fails every assertion: `!is_note(e, 0)`
// would also pass over a check that reported nothing at all.
fn report_severity(env mut* e, u64 i) string {
    if (i >= modules_env.reports(&e->m)) {
        return "<none>";
    }
    if (modules_env.report_at(&e->m, i).severity == diag.severity.note) {
        return "note";
    }
    return "error";
}

fn diag_record_text(env mut* e, u64 i) void {
    strbuf.clear(&e->buf);
    if (i >= modules_env.reports(&e->m)) {
        strbuf.append(&e->buf, "<none>");
        return;
    }
    strbuf.append_u64(&e->buf, cast(modules_env.report_at(&e->m, i).loc.line, u64));
    strbuf.push(&e->buf, ':');
    strbuf.append_u64(&e->buf, cast(modules_env.report_at(&e->m, i).loc.col, u64));
    strbuf.append(&e->buf, ": ");
    strbuf.append(&e->buf, modules_env.report_at(&e->m, i).msg);
}

// ---- checking one expression by hand -----------------------------------------------

// Loads the entry module `main.ft` written from `text` and resolves its
// declarations, leaving the module in place so that probe_expr may check an
// expression against it. It deliberately stops where check_module_decls does,
// before the function bodies that check_stmt.check_module_bodies checks. A
// probe checks one body expression by hand and asserts the result fields.
// Checking the body first would report each diagnostic twice. It would also
// give the probe annotations from the earlier check. A test that wants the
// whole module checked, bodies
// included, calls check_src or check_body.
fn open_module(env mut* e, string text) bool {
    add(e, "main.ft", text);
    bool loaded = modules_env.load(&e->m, "main.ft");
    modules.module* m = module_at(e, "main");
    if (m == null) {
        return false;
    }
    check.check_module_decls(&e->ck, m);
    return loaded;
}

// Checks the expression node `n` as the checker would, with the module
// open_module left in place and no block scope, and returns what it found.
// This is how an expression form that cannot stand in a module-level
// initializer -- a call, `new`, `move`, `del`, `&` -- is reached directly.
fn probe_expr(env mut* e, ast.node mut* n) check.expr {
    check.expr mut out = check.expr{};
    check.check_expr(&e->ck, n, &out);
    return out;
}

// The first expression of `kind` in the body of the function `name` of the
// entry module, checked. The test asserts on the fields of the result.
fn probe_in(env mut* e, string fn_name, ast.ast_kind kind) check.expr {
    ast.node mut* f = node_in_main(e, ast.ast_kind.k_fn_decl, fn_name);
    if (f == null) {
        panic("check_env.probe_in: no such function");
    }
    ast.node mut* n = node_find(f->b, kind, "");
    if (n == null) {
        panic("check_env.probe_in: no such expression");
    }
    return probe_expr(e, n);
}

// The sources the suites reuse.
fn src_main() string {
    return "fn main() i32 {\n    return 0;\n}\n";
}

// The `i`-th statement of the body of the function `name`, with the call
// statement unwrapped to the call it holds: the shape probe_stmt checks, since
// a statement is not an expression.
fn body_expr(env* e, string fn_name, u64 i) ast.node mut* {
    ast.node mut* f = node_in_main(e, ast.ast_kind.k_fn_decl, fn_name);
    if (f == null || f->b == null || i >= ast.ast_len(f->b)) {
        panic("check_env.body_expr: no such statement");
    }
    ast.node mut* s = ast.ast_child_mut(f->b, i);
    if (s->kind == ast.ast_kind.k_call_stmt) {
        return s->a;
    }
    return s;
}

// Checks the expression of the `i`-th statement of the body of `fn_name`.
fn probe_stmt(env mut* e, string fn_name, u64 i) check.expr {
    return probe_expr(e, body_expr(e, fn_name, i));
}

// ---- the parameter scope of a body -------------------------------------------------

// Opens the scope check_function_body puts around a body: one block scope with
// no parent holding the function's parameters, so that a name in the body
// resolves to one. This half of the checker resolves the signature and leaves
// the scope to the statement checker, so a probe of a statement expression
// builds it here. close_params closes it.
fn open_params(env mut* e, scope.scope mut* params, string fn_name) void {
    ast.node mut* f = node_in_main(e, ast.ast_kind.k_fn_decl, fn_name);
    if (f == null) {
        panic("check_env.open_params: no such function");
    }
    scope.init(params, scope.scope_kind.s_block, null);
    u64 mut i = 0;
    while (i < ast.ast_len(f)) {
        ast.node mut* p = ast.ast_child_mut(f, i);
        if (p->kind == ast.ast_kind.k_param && p->sym != null) {
            scope.declare(params, p->name, scope.bind_kind.b_param, p->name_loc, p);
        }
        i += 1;
    }
    e->ck.scope = params;
}

fn close_params(env mut* e, scope.scope mut* params) void {
    e->ck.scope = null;
    scope.free(params);
}

// The first `return` of the body of the function `name`.
fn return_in(env* e, string fn_name) ast.node mut* {
    ast.node mut* f = node_in_main(e, ast.ast_kind.k_fn_decl, fn_name);
    if (f == null) {
        panic("check_env.return_in: no such function");
    }
    ast.node mut* r = node_find(f->b, ast.ast_kind.k_return, "");
    if (r == null) {
        panic("check_env.return_in: no return statement");
    }
    return r;
}

// The result type of the function `name`, which is what a `return` of it is
// checked against.
fn result_type(env* e, string fn_name) types.node* {
    ast.sym* s = sym_main(e, fn_name);
    if (s == null || s->ty == null || s->ty->kind != types.type_kind.k_fn) {
        panic("check_env.result_type: not a resolved function");
    }
    return s->ty->elem;
}
