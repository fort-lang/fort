/// json_env: the buffer and the writer the JSON tests write through.
//
// test/fort/json_test.ft and test/fort/json_utf8_test.ft both need it. And the
// root of test/fort holds tests and nothing else, so the fixture stands here
// (test/fort/support). bootstrap0/test/json_test.c keeps the same pair as two file-scope
// statics.
import fort.json;
import std.strbuf;

// The buffer and the writer over it. The writer holds a pointer into the
// buffer beside it, so an env is filled in place and never returned. A return
// would copy the pair and leave the pointer at the dead local.
struct env {
    strbuf.str_buf out;
    json.writer j;
}

// Starts a writer over an empty buffer.
fn open(env mut* e) void {
    e->out = strbuf.create();
    json.json_init(&e->j, &e->out);
}

// Releases the buffer.
fn close(env mut* e) void {
    strbuf.free(&e->out);
}

// Releases an environment that the caller moves in, as close does. The writer is not read.
fn drop(env mut e) void {
    del(e.out.data);
}

// Opens an environment in an allocation of its own, which does not move: the writer points
// into it.
fn make() env mut* own {
    env mut* own e = new(env);
    open(e);
    return e;
}

// Ends an environment of make that the caller moves in.
fn drop_made(env mut* own p) void {
    env kept = move(*p);
    del(p);
    drop(move(kept));
}

// Opens an environment, runs `body` on it, and closes it. `body` reaches the environment through
// a pointer, so the use rule of `move` and `del` (D17.21) asks no proof of its reads after a call.
fn run(fn (env mut*) void body) void {
    env mut* own e = make();
    defer drop_made(move(e));
    body(e);
}

// What the writer has written so far.
fn written(env* e) string {
    return strbuf.view(&e->out);
}

// `form` between two quotes: the document a one-byte string produces. The
// result is a view of `b`, so a caller that needs two of them needs two
// buffers.
fn quoted(strbuf.str_buf mut* b, string form) string {
    strbuf.clear(b);
    strbuf.push(b, '"');
    strbuf.append(b, form);
    strbuf.push(b, '"');
    return strbuf.view(b);
}

// The one-byte string of `byte`, built in `b`.
fn one_byte(strbuf.str_buf mut* b, u64 byte) string {
    strbuf.clear(b);
    strbuf.push_byte(b, cast(byte, u8));
    return strbuf.view(b);
}

// Reports `what` when the two texts differ, so that a failure over a table
// names the case, and then fails the test.
fn check(string got, string want, string what) void {
    if (got != want) {
        println("case: ", what);
        println("  want: ", want);
        println("  got:  ", got);
    }
    assert(got == want);
}
