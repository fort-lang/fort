/// Renders a flag step of the local ownership producer in the form that the step tests pin.
import ownership_flow;
import std.strbuf;

fn flag_name(ownership_flow.flag_kind kind) string {
    switch (kind) {
    case ownership_flow.flag_kind.clear: return "clear";
    case ownership_flow.flag_kind.constant: return "constant";
    case ownership_flow.flag_kind.copy: return "copy";
    case ownership_flow.flag_kind.negate: return "negate";
    case ownership_flow.flag_kind.null_test: return "null";
    }
}

// Appends ` flag kind flag`, then `<-from` and the value where the kind has them, then
// ` offset` for a null test that decides only "not null".
fn describe_flag(ownership_flow.step* s, strbuf.str_buf mut* out) void {
    ownership_flow.flag_effect effect = s->flag;
    strbuf.append(out, " flag ");
    strbuf.append(out, flag_name(effect.kind));
    strbuf.push(out, ' ');
    strbuf.append_u64(out, cast(effect.flag.ordinal, u64));
    if (effect.kind != ownership_flow.flag_kind.clear &&
        effect.kind != ownership_flow.flag_kind.constant) {
        strbuf.append(out, "<-");
        strbuf.append_u64(out, cast(effect.from.ordinal, u64));
    }
    if (effect.kind == ownership_flow.flag_kind.constant ||
        effect.kind == ownership_flow.flag_kind.null_test) {
        strbuf.append(out, effect.value ? " true" : " false");
    }
    if (effect.offset) { strbuf.append(out, " offset"); }
}
