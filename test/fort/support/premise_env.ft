/// Provides the texts of the tests of the premise helpers of pass_env and run_env: FIR texts whose
/// functions keep the 16 rules of the verifier, and texts with a function that breaks a premise
/// rule V14 to V16 (spec/fir.md 10).

/// The declarations that the texts name.
string[3] PRELUDE = {"fn plain() void {}", "fn leaks() void {}", "fn drops() void {}"};

/// One function, which keeps the 16 rules.
string[5] KEEP = {
    "fn main.plain() -> void {",
    "    bb0: {",
    "        return;",
    "    }",
    "}",
};

/// Two functions. The second one breaks V16: its `return` comes while the scratch temporary `_1`
/// is live.
string[12] MIXED = {
    "fn main.plain() -> void {",
    "    bb0: {",
    "        return;",
    "    }",
    "}",
    "fn main.leaks() -> void {",
    "    let _1: u8 mut* own;",
    "    bb0: {",
    "        _1 = alloc<u8>(const u64 1);",
    "        return;",
    "    }",
    "}",
};

/// Two functions, which each break V16 as `leaks` of MIXED does.
string[14] BOTH = {
    "fn main.leaks() -> void {",
    "    let _1: u8 mut* own;",
    "    bb0: {",
    "        _1 = alloc<u8>(const u64 1);",
    "        return;",
    "    }",
    "}",
    "fn main.drops() -> void {",
    "    let _1: u8 mut* own;",
    "    bb0: {",
    "        _1 = alloc<u8>(const u64 1);",
    "        return;",
    "    }",
    "}",
};
