/// The disposition of each event kind of fir.shadow: what the gate of the oracle tests does with
/// an event that no rule of the compiler excuses for its item.
//
// The gate judges in a closed world. It holds no list of event kinds that it does not read and no
// list of statement forms: each event of each run goes through is_error, and TABLE has one row
// for each kind. The `switch` of index_of names each kind and has no `default`, so a new kind of
// the shadow is a compile error of this module until the `switch` names it (D7.7).
import fort.fir.shadow;

/// What the gate does with the events of one kind.
enum disposition_kind {
    dk_error, // the compiler refuses each program that gives the event
    dk_cycle_leak, // an error, unless a cycle of owners holds the allocation (shadow.event.cycle)
    dk_trusted, // the event needs a program that breaks an assumption of the rules
}

/// The names of disposition_kind, in its order.
string[3] DISPOSITION_TEXT = {"error", "cycle leak", "trusted"};

/// One row of TABLE: the event kind, its disposition, and its basis. The basis of an error is the
/// decision that refuses the program. The basis of a trusted kind is the assumption of
/// spec/ownership-design.md 5.1 that the program breaks.
struct row {
    shadow.event_kind event;
    disposition_kind disposition;
    string basis;
}

/// The count of the rows of TABLE.
u64 KINDS = 10;

/// The disposition of each kind of shadow.event_kind, in its order.
//
// An `overwrite`, a `leak` and a `use after move` are errors. A `leak` at an exit into an abort
// block is none (is_error). A `leak at exit` of a cycle of owners is defined behavior, and each
// other `leak at exit` is an error. The six other kinds come from an access or a release through
// a pointer that the rules do not follow. The rules assume that no program does that (A1, A2,
// A8), so the gate does not judge them.
row[KINDS] TABLE = {
    row{shadow.event_kind.ev_overwrite, disposition_kind.dk_error, "D17.11"},
    row{shadow.event_kind.ev_leak, disposition_kind.dk_error, "D17.20"},
    row{shadow.event_kind.ev_leak_at_exit, disposition_kind.dk_cycle_leak, "D17.20"},
    row{shadow.event_kind.ev_double_release, disposition_kind.dk_trusted, "A1"},
    row{shadow.event_kind.ev_invalid_release, disposition_kind.dk_trusted, "A2"},
    row{shadow.event_kind.ev_use_after_release, disposition_kind.dk_trusted, "A1"},
    row{shadow.event_kind.ev_use_after_move, disposition_kind.dk_error, "D17.21"},
    row{shadow.event_kind.ev_use_after_scope, disposition_kind.dk_trusted, "A1"},
    row{shadow.event_kind.ev_duplicate_owner, disposition_kind.dk_trusted, "A2"},
    row{shadow.event_kind.ev_forged, disposition_kind.dk_trusted, "A8"},
};

/// The row of `kind` in TABLE, which is its position in shadow.event_kind. The `switch` has no
/// `default`, so a kind that it does not name is a compile error (D7.7).
fn index_of(shadow.event_kind kind) u64 {
    switch (kind) {
    case shadow.event_kind.ev_overwrite:
        return 0;
    case shadow.event_kind.ev_leak:
        return 1;
    case shadow.event_kind.ev_leak_at_exit:
        return 2;
    case shadow.event_kind.ev_double_release:
        return 3;
    case shadow.event_kind.ev_invalid_release:
        return 4;
    case shadow.event_kind.ev_use_after_release:
        return 5;
    case shadow.event_kind.ev_use_after_move:
        return 6;
    case shadow.event_kind.ev_use_after_scope:
        return 7;
    case shadow.event_kind.ev_duplicate_owner:
        return 8;
    case shadow.event_kind.ev_forged:
        return 9;
    }
}

/// Whether TABLE names each event kind of fir.shadow one time, in the order of the shadow. It has
/// as many rows as the shadow counts kinds (shadow.EVENT_KINDS). Row `i` names the kind at
/// position `i` of shadow.event_kind, and index_of gives `i` for that kind.
//
// The two counts are numbers that a person keeps: the language has no form that counts the
// members of an enum. So is_complete does not see a new kind. The `switch` of index_of does. One
// case stays: a new `case` gives a row that TABLE does not have, and both counts keep their old
// value. Then the first event of that kind traps at the bounds check of TABLE.
fn is_complete() bool {
    if (TABLE.len != shadow.EVENT_KINDS) {
        return false;
    }
    for (u64 mut i = 0; i < TABLE.len; i++) {
        if (cast(cast(TABLE[i].event, i32), u64) != i || index_of(TABLE[i].event) != i) {
            return false;
        }
    }
    return true;
}

/// Whether the event `ev` is an error: an item fails the gate when a run gives it and no rule of
/// the compiler excuses it. `abort_exit` says that the event stands at an exit into an abort
/// block: at the `dead` marker of a block that ends the program. An event of a trusted kind is no
/// error. A `leak at exit` is none when a cycle of owners holds its allocation. A `leak` is none
/// at an exit into an abort block, which has no obligation (D17.20). A `leak` at each other
/// place is an error, also when a later statement of its run ends the program. Each other event
/// of an error kind is one, whatever the statement that gave it.
fn is_error(shadow.event* ev, bool abort_exit) bool {
    row r = TABLE[index_of(ev->kind)];
    if (r.disposition == disposition_kind.dk_trusted) {
        return false;
    }
    if (r.disposition == disposition_kind.dk_cycle_leak) {
        return !ev->cycle;
    }
    return ev->kind != shadow.event_kind.ev_leak || !abort_exit;
}
