/// Reads one source file for the soundness gates of `test/ownership` and names the verdicts of the
/// heap solver and the summary solver (D17.14, D17.18).
import ownership_api;
import ownership_heap_env;
import ownership_recursive_env;
import std.io;
import std.strbuf;

/// One source file: its text, its lines, and the name of each function that a line declares.
/// The lines and the names are views of the text, so the text must stay until close.
struct source {
    strbuf.str_buf text;
    string mut@ own lines;
    string mut@ own names;
}

/// The name of the function that `line` declares at its start, or "".
fn declared(string line) string {
    if (line.len < 4 || line[0..3] != "fn ") { return ""; }
    u64 mut end = 3;
    while (end < line.len && line[end] != '(' && line[end] != ' ') { end += 1; }
    return line[3..end];
}

/// Reads `path` into `s`, one line of the text for each newline and one after the last. Gives
/// false when the file cannot be read.
fn read(source mut* s, string path) bool {
    s->text = strbuf.create();
    if (!io.read_file(path, &s->text)) { return false; }
    string all = strbuf.view(&s->text);
    u64 mut count = 1;
    u64 mut i = 0;
    while (i < all.len) {
        if (all[i] == '\n') { count += 1; }
        i += 1;
    }
    s->lines = new(string, count);
    u64 mut bodies = 0;
    u64 mut line = 0;
    u64 mut from = 0;
    i = 0;
    while (i <= all.len) {
        if (i == all.len || all[i] == '\n') {
            s->lines[line] = all[from..i];
            if (declared(s->lines[line]).len > 0) { bodies += 1; }
            line += 1;
            from = i + 1;
        }
        i += 1;
    }
    s->names = new(string, bodies);
    u64 mut k = 0;
    line = 0;
    while (line < s->lines.len) {
        string name = declared(s->lines[line]);
        if (name.len > 0) {
            s->names[k] = name;
            k += 1;
        }
        line += 1;
    }
    return true;
}

fn close(source mut* s) void {
    del(s->lines);
    del(s->names);
    strbuf.free(&s->text);
}

/// The verdict of the heap solver for `name`: `proved`, `failed` or `unproved`.
fn heap_verdict(ownership_heap_env.closure* c, string name) string {
    if (ownership_heap_env.proved(c, name)) { return "proved"; }
    if (ownership_heap_env.failed(c, name)) { return "failed"; }
    return "unproved";
}

/// The verdict of the summary solver for `name`, in the words of heap_verdict. A proved summary
/// has a successful proof and no residual effect, as `ownership_recursive_env.complete` holds.
fn summary_verdict(ownership_recursive_env.closure* c, string name) string {
    ownership_api.proof_status proof = ownership_recursive_env.summary(c, name)->proof;
    if (ownership_api.successful(proof) &&
        !ownership_recursive_env.summary(c, name)->residual_effects) { return "proved"; }
    if (proof.kind == ownership_api.proof_kind.complete && proof.failed) { return "failed"; }
    return "unproved";
}

/// The name of an incomplete reason, as the enumeration spells it.
fn reason_name(ownership_api.incomplete_reason value) string {
    switch (value) {
    case ownership_api.incomplete_reason.none: return "none";
    case ownership_api.incomplete_reason.missing_transfer: return "missing_transfer";
    case ownership_api.incomplete_reason.missing_graph: return "missing_graph";
    case ownership_api.incomplete_reason.missing_ffi: return "missing_ffi";
    case ownership_api.incomplete_reason.missing_globals: return "missing_globals";
    case ownership_api.incomplete_reason.missing_renderer: return "missing_renderer";
    case ownership_api.incomplete_reason.missing_budget: return "missing_budget";
    case ownership_api.incomplete_reason.missing_events: return "missing_events";
    case ownership_api.incomplete_reason.work_limit: return "work_limit";
    case ownership_api.incomplete_reason.report_limit: return "report_limit";
    case ownership_api.incomplete_reason.missing_capture: return "missing_capture";
    case ownership_api.incomplete_reason.missing_path: return "missing_path";
    case ownership_api.incomplete_reason.missing_boundary: return "missing_boundary";
    case ownership_api.incomplete_reason.missing_correspondence: return "missing_correspondence";
    case ownership_api.incomplete_reason.source_coverage: return "source_coverage";
    case ownership_api.incomplete_reason.unknown_effect: return "unknown_effect";
    case ownership_api.incomplete_reason.invalid_input: return "invalid_input";
    }
}
