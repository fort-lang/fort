//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| join allocator mode 3 released
/// Measures the teardown of a widen refused at its last charge in one program of its own.
import ownership_raw_join_cleanup_env;
fn main() i32 {
    ownership_raw_join_cleanup_env.teardown_probe(3);
    return 0;
}
