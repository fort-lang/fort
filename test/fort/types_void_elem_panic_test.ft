//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: types: void as an element type
//! stdout:
//| 8
/// Checks that void cannot be an element type. Pointers to void use type_voidptr instead.
import types;
import types_env;

fn main() i32 {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    println(types.type_sizeof(types.type_voidptr(&e.tt, false, false)));
    println(types.type_sizeof(types.type_ptr(&e.tt, types.type_void(&e.tt), false, false)));
    return 0;
}
