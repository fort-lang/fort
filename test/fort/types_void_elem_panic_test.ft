//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: types: void as an element type
//! stdout:
//| 8
import types;
import types_env;

// `void` is a return type or the base of `void*`: a pointer to it is built
// with type_voidptr, so `void` as an element is a broken precondition.
// D3.11
fn i32 main() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    println(types.type_sizeof(types.type_voidptr(&e.tt, false, false)));
    println(types.type_sizeof(types.type_ptr(&e.tt, types.type_void(&e.tt), false, false)));
    return 0;
}
