//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: types.type_sizeof: sizeof of a type that is too large
//! stdout:
//| true
import types;
import types_env;

/// The checker asks type_size_fits at the declaration and reports "type is too
/// large" there. Reaching sizeof anyway is a compiler bug.
fn main() i32 {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node* huge = types.type_array(&e.tt, types_env.type_of(&e, "i32"), 9223372036854775807);
    println(!types.type_size_fits(huge));
    println(types.type_sizeof(huge));
    return 0;
}
