//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: modules.listed_outside_at: index out of range
//! stdout:
//| 0
/// Checks the bound of the extern-check order of the modules outside the closure. A set that
/// loaded none holds no module there, so index 0 is past the last one.
import fort.modules;
import modules_env;

fn main() i32 {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft", modules_env.src_main());
    assert(modules_env.load(&e, "main.ft"));
    println(modules.outside_count(&e.set));
    println(modules_env.path_of(modules.listed_outside_at(&e.set, 0)));
    return 0;
}
