    "fn named_component(view_box v) outer_v { outer_v r = outer_v{v}; return r; }",
    "fn caller_component(view_box mut* own src) outer_v {",
    "    outer_v r = outer_v{*src}; del(src); return r; }",
    "fn two_components(view_box v, view_box w) two { return two{v, w}; }",
    "fn deferred_component(view_box mut* own src) outer_v {",
    "    defer del(src); return outer_v{*src}; }",
    "fn released_component(i32 mut* own p) outer_v {",
    "    view_box c = view_box{p}; del(p); return outer_v{c}; }",
    "fn address_over_stale(i32 mut* own p, i32* q) view_box {",
    "    view_box mut d = view_box{p}; view_box other = view_box{q}; view_box* at = &other;",
    "    d = *at; del(p); return d; }",
    "fn unused_components() void {}",
};

// Each body writes caller storage and then copies it whole or loads a leaf from it.
string[33] CALLER = {
    "struct view_box { i32* ptr; }",
    "struct dst_box { i32* ptr; }",
    "struct outer_v { view_box inner; }",
    "struct holder { view_box inner; i32 tag; }",
    "fn set(view_box mut* s, i32* p) void { s->ptr = p; }",
    "fn c2_call_write(view_box mut* src, i32 mut* own p) view_box {",
    "    set(src, p); view_box r = *src; src->ptr = null; del(p); return r; }",
    "fn c1_local_addr(view_box mut* src) view_box {",
    "    i32 x = 1; src->ptr = &x; view_box r = *src; src->ptr = null; return r; }",
    "fn f4_caller_written(view_box mut* src, i32 mut* own p) outer_v {",
    "    src->ptr = p; outer_v r = outer_v{*src}; src->ptr = null; del(p); return r; }",
    "fn f5_caller_direct(view_box mut* src, i32 mut* own p) outer_v {",
    "    src->ptr = p; outer_v r = outer_v{*src}; del(p); src->ptr = null; return r; }",
    "fn f15_direct(view_box mut* src, i32 mut* own p) view_box {",
    "    src->ptr = p; view_box r = *src; src->ptr = null; del(p); return r; }",
    "fn f16_direct_ret(view_box mut* src, i32 mut* own p) view_box {",
    "    src->ptr = p; del(p); view_box r = *src; src->ptr = null; return r; }",
    "fn f17_lit_direct(view_box mut* src, i32 mut* own p) outer_v {",
    "    src->ptr = p; del(p); outer_v r = outer_v{*src}; src->ptr = null; return r; }",
    "fn q2_return_then_clear(view_box mut* src, i32 mut* own p) view_box {",
    "    src->ptr = p; view_box r = *src; del(p); src->ptr = null; return r; }",
    "fn q3_field_of_caller(holder mut* h, i32 mut* own p) view_box {",
    "    h->inner.ptr = p; view_box r = h->inner; h->inner.ptr = null; del(p); return r; }",
    "fn lw2_leaf_named(view_box mut* src, i32 mut* own p) dst_box {",
    "    src->ptr = p; dst_box d = dst_box{src->ptr}; src->ptr = null; del(p); return d; }",
    "fn lw4_field_leaf(holder mut* h, i32 mut* own p) dst_box {",
    "    h->inner.ptr = p; dst_box d = dst_box{h->inner.ptr}; h->inner.ptr = null; del(p);",
    "    return d; }",
    "fn c3_ok_unwritten(view_box mut* src, i32 mut* own p) view_box {",
    "    view_box r = *src; del(p); return r; }",
    "fn q5_ok_clear_first(view_box mut* src, i32* q) view_box {",
    "    src->ptr = q; view_box r = *src; src->ptr = null; return r; }",
    "fn unused_caller() void {}",
};

// A null test makes the read after a move or a release dead, so each body but the last is valid.
string[16] GUARD = {
    "struct pair { i32 first; i32 second; }",
    "fn takepair(pair mut* own s) void { del(s); }",
    "fn g10_moved_owner_guard(pair mut* own s) i32 {",
    "    pair mut* own t = move(s); i32 mut x = 0; if (s != null) { x = s->first; }",
    "    del(t); return x; }",
    "fn g12_param_deref_guard(i32 mut* own s) i32 {",
    "    i32 mut* own t = move(s); i32 mut x = 0; if (s != null) { x = *s; } del(t); return x; }",
    "fn g13_released_guard(pair mut* own s) i32 {",
    "    del(s); i32 mut x = 0; if (s != null) { x = s->first; } return x; }",
    "fn g14_callee_guard(pair mut* own s) i32 {",
    "    takepair(move(s)); i32 mut x = 0; if (s != null) { x = s->second; } return x; }",
    "fn g11_local_owner_guard() i32 {",
    "    pair mut* own a = new(pair); pair mut* own t = move(a); i32 mut x = 0;",
    "    if (a != null) { x = a->first; } del(t); return x; }",
    "fn g15_released_unguarded(pair mut* own s) i32 { del(s); return s->first; }",
    "fn unused_guard() void {}",
};

// A callee writes an aggregate local through its address.
string[11] ADDRESSED = {
    "struct view_box { i32* ptr; }",
    "fn replace(view_box mut* out, i32* ptr) void { out->ptr = ptr; }",
    "fn zero_then_call(i32* current) view_box {",
    "    view_box mut value = {}; replace(&value, current); return value; }",
    "fn copy_then_call(i32* old, i32* current) view_box {",
    "    view_box first = view_box{old}; view_box mut value = first; replace(&value, current);",
    "    return value; }",
    "fn literal_then_call(i32* old, i32* current) view_box {",
    "    view_box mut value = view_box{old}; replace(&value, current); return value; }",
    "fn zero_unaddressed() view_box { view_box value = {}; return value; }",
    "fn unused_addressed() void {}",
};

// A literal keeps an owning leaf of a named local in place, so later checks see the owner.
string[8] OWNERS = {
    "struct owner_box { i32 mut* own item; i32 tag; }",
    "fn zero_over_owner() owner_box {",
    "    owner_box mut a = owner_box{new(i32), 1}; a = owner_box{}; return move(a); }",
    "fn move_over_owner() owner_box {",
    "    owner_box mut a = owner_box{new(i32), 1}; owner_box b = owner_box{new(i32), 2};",
    "    a = move(b); return move(a); }",
    "fn leak_local() i32 { owner_box a = owner_box{new(i32), 1}; return 0; }",
    "fn unused_owners() void {}",
};

// A callee writes a borrowed leaf of a by-value parameter, or of a whole copy of one, through an
// address (D17.14). No refresh publishes that write, so each of these 7 faulty bodies stays
// unsupported. Each proved before the whole effect stopped at an addressed local.
string[23] PARAM_WRITES = {
    "struct view_box { i32* ptr; }",
    "struct view2 { i32* a; i32* b; }",
    "struct two { view_box x; view_box y; }",
    "struct holder { view_box inner; i32 tag; }",
    "fn set(view_box mut* b, i32* v) void { b->ptr = v; }",
    "fn set_b(view2 mut* b, i32* v) void { b->b = v; }",
    "fn set_ty(two mut* t, i32* v) void { t->y.ptr = v; }",
    "fn set_h(holder mut* h, i32* v) void { h->inner.ptr = v; }",
    "fn g4_param_copy(view_box v, i32 mut* own p) view_box {",
    "    view_box mut a = v; set(&a, p); del(p); return a; }",
    "fn g4c_param_two(view2 v, i32 mut* own p) view2 {",
    "    view2 mut a = v; set_b(&a, p); del(p); return a; }",
    "fn k1_param_alias(view_box v, i32 mut* own p) view_box {",
    "    view_box mut a = v; view_box mut* q = &a; set(q, p); del(p); return a; }",
    "fn k2_param_self(view_box mut v, i32 mut* own p) view_box {",
    "    set(&v, p); del(p); return v; }",
    "fn k3_param_two(two tv, i32 mut* own p) two {",
    "    two mut t = tv; set_ty(&t, p); del(p); return t; }",
    "fn k5_param_holder(holder hv, i32 mut* own p) holder {",
    "    holder mut h = hv; set_h(&h, p); del(p); return h; }",
    "fn k6_param_self_two(view2 mut v, i32 mut* own p) view2 {",
    "    set_b(&v, p); del(p); return v; }",
    "fn unused_param_writes() void {}",
};

// A callee releases the owning leaf of an addressed literal local (D17.14). The leaf stays in
// place, where no refresh runs, so each of these 3 faulty bodies stays unsupported. Each proves
// without the guard of `literal_leaf_ready`.
string[12] OWNER_WRITES = {
    "struct owner_box { i32 mut* own item; i32 tag; }",
    "struct mixed { i32 mut* own item; i32* view; }",
    "fn rel_only(owner_box mut* b) void { del(b->item); }",
    "fn mrel(mixed mut* m) void { del(m->item); }",
    "fn e1_rel_only_ret(i32 tag) owner_box {",
    "    owner_box mut a = owner_box{new(i32), tag}; rel_only(&a); return move(a); }",
    "fn e2_rel_only_copy(i32 tag) owner_box {",
    "    owner_box mut a = owner_box{new(i32), tag}; rel_only(&a); owner_box b = move(a);",
    "    return move(b); }",
    "fn e6_mixed_rel(i32* k) mixed {",
    "    mixed mut m = mixed{new(i32), k}; mrel(&m); return move(m); }",
    "fn unused_owner_writes() void {}",
};

// A fixed-array literal of references has index leaves, which `result_leaves` does not read
// (D17.15). So its whole return expands into leaf copies, and body flow checks each leaf at the
// exit. Each of these 8 faulty bodies proved while that return stayed one whole effect.
string[18] ARRAY_RETURNS = {
    "fn seta(i32*[2] mut* a, i32* v) void { (*a)[1] = v; }",
    "fn g1_arr_rel(i32* k, i32 mut* own p) i32*[2] {",
    "    i32*[2] mut a = {k, p}; del(p); return a; }",
    "fn g2_arr_set(i32* k, i32 mut* own p) i32*[2] {",
    "    i32*[2] mut a = {k, k}; seta(&a, p); del(p); return a; }",
    "fn g6_arr_one(i32 mut* own p) i32*[1] {",
    "    i32*[1] mut a = {p}; del(p); return a; }",
    "fn h3_arr_first(i32* k, i32 mut* own p) i32*[2] {",
    "    i32*[2] a = {p, k}; del(p); return a; }",
    "fn h4_arr_param_leaf(i32* v, i32 mut* own p) i32*[2] {",
    "    i32*[2] a = {v, p}; del(p); return a; }",
    "fn h5_arr_null_then(i32 mut* own p) i32*[2] {",
    "    i32*[2] a = {null, p}; del(p); return a; }",
    "fn h8_arr_local(i32* k) i32*[2] {",
    "    i32 x = 1; i32*[2] a = {k, &x}; return a; }",
    "fn i2_arr_two_copies(i32* k, i32 mut* own p) i32*[2] {",
    "    i32*[2] a = {k, p}; i32*[2] b = {k, k}; del(p); return a; }",
    "fn unused_array_returns() void {}",
};

// A projected whole copy out of an addressed by-value parameter keeps its leaves in place, where
// no refresh runs (D17.14). It stops when its source or its destination is addressed, so each
// of these 4 faulty bodies stays unsupported.
string[13] PROJECTED_WRITES = {
    "struct view_box { i32* ptr; }",
    "struct two { view_box x; view_box y; }",
    "struct holder { view_box inner; i32 tag; }",
    "fn set_ty(two mut* t, i32* v) void { t->y.ptr = v; }",
    "fn j1_param_proj(two mut tv, i32 mut* own p) view_box {",
    "    set_ty(&tv, p); del(p); return tv.y; }",
    "fn j5_param_named(two mut tv, i32 mut* own p) view_box {",
    "    set_ty(&tv, p); view_box r = tv.y; del(p); return r; }",
    "fn j9_lit_proj(two mut tv, i32 mut* own p) holder {",
    "    set_ty(&tv, p); del(p); return holder{tv.y, 0}; }",
    "fn j13_alias(two mut tv, i32 mut* own p) view_box {",
    "    two mut* q = &tv; set_ty(q, p); del(p); return tv.y; }",
    "fn unused_projected_writes() void {}",
};

// A literal reserves 2 flow steps for each leaf of an aggregate component (D17.18). The base
// reserve of the few statements of `tight` does not hold the 32 leaf copies of its result, so
// without the component reserve the table is full and extraction gives `invalid_input`.
string[7] TIGHT = {
    "struct tight_holder { i32*[32] items; i32 tag; }",
    "fn tight(i32* q) tight_holder {",
    "    i32*[32] a = {q, q, q, q, q, q, q, q, q, q, q, q, q, q, q, q,",
    "        q, q, q, q, q, q, q, q, q, q, q, q, q, q, q, q};",
    "    return tight_holder{a, 1};",
    "}",
    "fn unused_tight() void {}",
};

