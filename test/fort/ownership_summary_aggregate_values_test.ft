// A dereference after the first projection loads a reference whose contents no flow step reads.
string[29] SECOND = {
    "struct view_box { i32* ptr; }",
    "struct pair { i32 first; i32 second; }",
    "struct mixed { i32 mut* own item; i32* ptr; }",
    "struct outer_v { view_box inner; }",
    "struct hb { view_box mut* own item; }",
    "struct hp { pair mut* own item; }",
    "struct hm { mixed mut* own item; }",
    "struct ho { outer_v mut* own item; }",
    "struct om { mixed inner; }",
    "struct hom { om mut* own item; }",
    "fn pp_copy(view_box mut* own mut* pp) view_box { del(*pp); return **pp; }",
    "fn pp_copy_named(view_box mut* own mut* pp) view_box {",
    "    del(*pp); view_box c = **pp; return c; }",
    "fn field_copy(hb mut* h) view_box { del(h->item); return *h->item; }",
    "fn field_copy_named(hb mut* h) view_box {",
    "    del(h->item); view_box c = *h->item; return c; }",
    "fn field_copy_scalar(hp mut* h) pair { del(h->item); return *h->item; }",
    "fn field_nested(ho mut* h) view_box { del(h->item); return h->item->inner; }",
    "fn field_moved(hb mut* h) view_box {",
    "    view_box mut* own q = move(h->item); view_box c = *h->item; del(q);",
    "    h->item = new(view_box); return c; }",
    "fn literal_component(hb mut* h) outer_v { del(h->item); return outer_v{*h->item}; }",
    "fn literal_leaf(hb mut* h) view_box { del(h->item); return view_box{h->item->ptr}; }",
    "fn field_copy_live(hb* h) view_box { return *h->item; }",
    "fn pp_copy_live(view_box* own* pp) view_box { return **pp; }",
    "fn move_residual(hom mut* h) mixed { return move(h->item->inner); }",
    "fn component_move(hm mut* h) om { return om{move(*h->item)}; }",
    "fn field_move_live(hm mut* h) mixed { return move(*h->item); }",
    "fn unused_second() void {}",
};

// A literal leaf of body storage has no modeled source, as a reference load in `assign`.
string[17] BODY_LEAVES = {
    "struct view_box { i32* ptr; }",
    "struct dst_box { i32* ptr; }",
    "struct outer_box { view_box inner; }",
    "struct holder { view_box* item; }",
    "fn local_leaf(i32 mut* own p) dst_box {",
    "    view_box value = view_box{p}; del(p); return dst_box{value.ptr}; }",
    "fn local_leaf_named(i32 mut* own p) dst_box {",
    "    view_box value = view_box{p}; del(p); dst_box d = dst_box{value.ptr}; return d; }",
    "fn nested_leaf(i32 mut* own p) dst_box {",
    "    view_box inner = view_box{p}; outer_box o = outer_box{inner}; del(p);",
    "    return dst_box{o.inner.ptr}; }",
    "fn local_leaf_live(i32* p) dst_box {",
    "    view_box value = view_box{p}; return dst_box{value.ptr}; }",
    "fn param_leaf(view_box v) dst_box { return dst_box{v.ptr}; }",
    "fn loaded_leaf(holder* h) dst_box { view_box* v = h->item; return dst_box{v->ptr}; }",
    "fn caller_leaf(view_box* v) dst_box { return dst_box{v->ptr}; }",
    "fn unused_leaves() void {}",
};

// A whole component copy names the storage of its source, not a borrowed source.
string[16] COMPONENTS = {
    "struct view_box { i32* ptr; }",
    "struct outer_v { view_box inner; }",
    "struct two { view_box a; view_box b; }",
