//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| aggregate constant ok
//| aggregate zero return ok
//| aggregate copy ok
//| aggregate move ok
//| aggregate return ok
//| aggregate invalid reads ok
//| aggregate base reads ok
//| aggregate private reads ok
//| aggregate partial models ok
//| aggregate second dereferences ok
//| aggregate body leaves ok
//| aggregate components ok
//| aggregate wide literals ok
//| aggregate caller copies ok
//| aggregate guarded bases ok
//| aggregate addressed locals ok
//| aggregate owner leaves ok
//| aggregate parameter writes ok
//| aggregate addressed owners ok
//| aggregate array returns ok
//| aggregate projected writes ok
/// Checks complete aggregate values in summary extraction (D17.5-D17.7, D17.14-D17.15).
import ownership_api;
import ownership_call_bodies;
import ownership_summary_model;
import ownership_state;

string[31] SOURCE = {
    "struct pair { i32 first; i32 second; }",
    "struct owner_box { i32 mut* own item; i32 tag; }",
    "struct moved_view { i32 mut* own item; i32* ptr; }",
    "struct view_box { i32* ptr; }",
    "struct two_views { i32 mut* own item; i32* first; i32* second; }",
    "struct nested_view { view_box inner; }",
    "fn constant_value() owner_box { owner_box value = {}; return move(value); }",
    "fn copied_value(pair p) pair { pair q = p; return q; }",
    "fn moved_value() owner_box { owner_box a = owner_box{new(i32), 1};",
    "    owner_box b = move(a); return b; }",
    "fn returned_value(i32 n) pair { return pair{n, 2}; }",
    "fn moved_borrow(i32* p) moved_view {",
    "    moved_view value = moved_view{new(i32), p}; return move(value);",
    "}",
    "fn returned_param(i32* p) view_box {",
    "    view_box value = view_box{p}; return value;",
    "}",
    "fn caller_copy_live(view_box* value) view_box { return *value; }",
    "fn moved_two(i32* p, i32* q) two_views {",
    "    two_views value = two_views{new(i32), p, q}; return move(value);",
    "}",
    "fn returned_nested_param(i32* p) nested_view {",
    "    view_box inner = view_box{p}; nested_view value = nested_view{inner};",
    "    return value;",
    "}",
    "fn zero_borrowed_result(bool take, i32* p) nested_view {",
    "    view_box item = view_box{p};",
    "    if (take) { return nested_view{item}; }",
    "    return nested_view{{}};",
    "}",
    "fn unused() void {}",
};

string[42] FAILURES = {
