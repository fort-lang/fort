    "    del(p); return move(value);",
    "}",
    "fn returned_local() view_box {",
    "    i32 local = 0; view_box value = view_box{&local}; return value;",
    "}",
    "fn caller_copy_after_release(view_box mut* own value) view_box {",
    "    del(value); return *value; }",
    "fn returned_local_move() mixed_box {",
    "    i32 local = 0; mixed_box value = mixed_box{new(i32), &local};",
