fn payloads(ownership_summary_model.summary* model,
    ownership_summary_model.payload_kind kind) u64 {
    u64 mut count = 0;
    u64 mut i = 0;
    while (i < model->effects.len) {
        if (model->effects[i].payload == kind) { count += 1; }
        i += 1;
    }
    return count;
}

fn payload_at(ownership_summary_model.summary* model,
    ownership_summary_model.payload_kind kind, u64 ordinal) u64 {
    u64 mut seen = 0;
    u64 mut i = 0;
    while (i < model->effects.len) {
        if (model->effects[i].payload == kind) {
            if (seen == ordinal) { return i; }
            seen += 1;
        }
        i += 1;
    }
    return model->effects.len;
}

fn selected(ownership_summary_model.summary* model,
    ownership_summary_model.payload_kind payload,
    ownership_api.projection_kind first_kind, i64 first, u32 second) bool {
    u64 mut i = 0;
    while (i < model->effects.len) {
        ownership_summary_model.effect_node row = model->effects[i];
        if (row.payload == payload && row.effect.place.projections.len == 2) {
            ownership_api.projection outer = row.effect.place.projections[0];
            ownership_api.projection inner = row.effect.place.projections[1];
            bool first_matches = first_kind == ownership_api.projection_kind.field ?
                outer.field == cast(first, u32) :
                outer.index.kind == ownership_api.fact_kind.exact &&
                    outer.index.value == first;
            if (outer.kind == first_kind && first_matches &&
                inner.kind == ownership_api.projection_kind.field && inner.field == second) {
                return true;
            }
        }
        i += 1;
    }
    return false;
}

fn invalid_body_with(ownership_call_bodies.bodies mut* state, u64 index, string message,
    bool terminator) void {
    ownership_call_bodies.infer(state, index);
    ownership_summary_model.summary* failed = ownership_call_bodies.summary(state, index);
    assert(failed->proof.failed && !ownership_api.successful(failed->proof));
    assert(failed->cases.len == 0);
    assert(ownership_call_bodies.saw(state, ownership_api.event_kind.invalid_use));
    assert(state->services.counts.last.evidence ==
        ownership_api.evidence_kind.unconditional);
    assert(state->services.counts.last.reason == ownership_api.incomplete_reason.none);
    assert(state->services.counts.last.text == message);
    assert(state->services.counts.last.operation.terminator == terminator);
}

// A store or a move over a live owner fails with a lost owner (D17.6).
fn lost_owner(ownership_call_bodies.bodies mut* state, u64 index, string message) void {
    ownership_call_bodies.infer(state, index);
    ownership_summary_model.summary* failed = ownership_call_bodies.summary(state, index);
    assert(failed->proof.failed && !ownership_api.successful(failed->proof));
    assert(failed->cases.len == 0);
    assert(ownership_call_bodies.saw(state, ownership_api.event_kind.lost_ownership));
    assert(state->services.counts.last.text == message);
}

fn invalid_body(ownership_call_bodies.bodies mut* state, u64 index) void {
    invalid_body_with(state, index, "reference source is no longer live", false);
}

fn incomplete_with(ownership_call_bodies.bodies mut* state, u64 index,
    ownership_api.incomplete_reason reason) void {
    ownership_call_bodies.infer(state, index);
    ownership_summary_model.summary* stopped = ownership_call_bodies.summary(state, index);
    assert(!ownership_api.successful(stopped->proof));
    assert(stopped->proof.terminal.reason == reason);
    assert(stopped->cases.len == 0);
    assert(state->services.counts.events == 0);
}

fn incomplete_body(ownership_call_bodies.bodies mut* state, u64 index) void {
    incomplete_with(state, index, ownership_api.incomplete_reason.unknown_effect);
}

// A base use of an empty owner stops the proof at the base. Extraction models no null test, so
// it gives incomplete proof with an abstract possibility, never a failure (D17.18).
fn unproved_base(ownership_call_bodies.bodies mut* state, u64 index) void {
    ownership_call_bodies.infer(state, index);
    ownership_summary_model.summary* stopped = ownership_call_bodies.summary(state, index);
    assert(!ownership_api.successful(stopped->proof));
    assert(stopped->proof.kind == ownership_api.proof_kind.incomplete);
    assert(stopped->proof.terminal.reason == ownership_api.incomplete_reason.unknown_effect);
    assert(stopped->cases.len == 0);
    assert(ownership_call_bodies.saw(state, ownership_api.event_kind.incomplete_proof));
    assert(state->services.counts.last.evidence ==
        ownership_api.evidence_kind.abstract_possibility);
    assert(state->services.counts.last.text == "local ownership effect needs a proved fact");
}

fn proved(ownership_call_bodies.bodies* b, u64 index) void {
    ownership_summary_model.summary* model = ownership_call_bodies.summary(b, index);
    assert(ownership_api.successful(model->proof));
    assert(!model->residual_effects && model->cases.len == 1);
}

fn effect(ownership_summary_model.summary* model, u64 index,
    ownership_summary_model.payload_kind payload, ownership_api.effect_kind kind) void {
    assert(index < model->effects.len);
    assert(model->effects[index].payload == payload);
    assert(model->effects[index].effect.kind == kind);
}

// Effect `index` writes `root` at a path of `parts` projections from an operand of `from`.
fn leaf_effect(ownership_summary_model.summary* model, u64 index,
    ownership_summary_model.payload_kind payload, u32 root, u64 parts, u64 from) void {
    assert(index < model->effects.len);
    ownership_summary_model.effect_node row = model->effects[index];
    assert(row.payload == payload);
    assert(row.effect.place.root.ordinal == root);
    assert(row.effect.place.projections.len == parts);
    assert(row.operand.projections.len == from);
}

// The index of the first read of local `local` itself, or the effect count.
fn read_of(ownership_summary_model.summary* model, u32 local) u64 {
    u64 mut i = 0;
    while (i < model->effects.len) {
        ownership_summary_model.effect_node row = model->effects[i];
        if (row.payload == ownership_summary_model.payload_kind.read &&
            row.effect.place.root.ordinal == local && row.effect.place.projections.len == 0) {
            return i;
        }
        i += 1;
    }
    return model->effects.len;
}

// The first effect reads pointer local `local` itself, before any load through it.
fn base_first(ownership_summary_model.summary* model, u32 local) void {
    assert(model->effects.len > 0 && model->requirements.len > 0);
    ownership_summary_model.effect_node first = model->effects[0];
    assert(first.payload == ownership_summary_model.payload_kind.read);
    assert(first.effect.place.root.ordinal == local);
    assert(first.effect.place.projections.len == 0);
    assert(model->requirements[0].kind ==
        ownership_summary_model.requirement_kind.live_source);
}

// Loads, copies and moves through a released, moved or emptied base stop at the base.
fn base_reads() void {
    ownership_call_bodies.bodies mut failures = ownership_call_bodies.bodies{};
    string[2] failure_names = {"scalar_after_release", "deref_after_release"};
    ownership_call_bodies.open(&failures, BASES[..], failure_names[..]);
    defer ownership_call_bodies.close(&failures);
    // A projected read checks the current base of the parent and fails. A one-step read of a
    // caller owner uses this base use, which gives incomplete proof.
    invalid_body_with(&failures, 0, "empty reference has no element", false);
    unproved_base(&failures, 1);
    u64 mut i = 0;

    // A projected literal leaf and a whole copy of caller storage stop before flow, live or
    // released (caller_copies).
    ownership_call_bodies.bodies mut stopped = ownership_call_bodies.bodies{};
    string[6] stopped_names = {"nested_after_release", "nested_live", "leaf_after_release",
        "leaf_after_move", "projected_after_release", "leaf_live"};
    ownership_call_bodies.open(&stopped, BASES[..], stopped_names[..]);
    defer ownership_call_bodies.close(&stopped);
    i = 0;
    while (i < 6) {
        incomplete_body(&stopped, i);
        i += 1;
    }
    ownership_call_bodies.bodies mut projected_copy = ownership_call_bodies.bodies{};
    string[1] projected_copy_names = {"projected_live"};
    ownership_call_bodies.open(&projected_copy, BASES[..], projected_copy_names[..]);
    defer ownership_call_bodies.close(&projected_copy);
    incomplete_body(&projected_copy, 0);

    ownership_call_bodies.bodies mut loads = ownership_call_bodies.bodies{};
    string[4] load_names = {"load_after_release", "read_after_release", "move_after_release",
        "output_after_release"};
    ownership_call_bodies.open(&loads, BASES[..], load_names[..]);
    defer ownership_call_bodies.close(&loads);
    invalid_body_with(&loads, 0, "empty reference has no element", false);
    unproved_base(&loads, 1);
    invalid_body_with(&loads, 2, "empty reference has no element", false);
    invalid_body_with(&loads, 3, "empty reference has no element", false);

    ownership_call_bodies.bodies mut moves = ownership_call_bodies.bodies{};
    string[2] move_names = {"move_live", "output_live"};
    ownership_call_bodies.open(&moves, BASES[..], move_names[..]);
    defer ownership_call_bodies.close(&moves);
    ownership_call_bodies.infer_all(&moves);
    proved(&moves, 0);
    proved(&moves, 1);
    ownership_summary_model.summary* move_load = ownership_call_bodies.summary(&moves, 0);
    u64 move_base = read_of(move_load, 1);
    assert(move_base < payload_at(move_load, ownership_summary_model.payload_kind.move, 0));
    ownership_summary_model.summary* output = ownership_call_bodies.summary(&moves, 1);
    u64 output_base = read_of(output, 1);
    assert(output_base < payload_at(output, ownership_summary_model.payload_kind.move, 0));

    ownership_call_bodies.bodies mut live = ownership_call_bodies.bodies{};
    string[3] live_names = {"load_live", "read_live", "span_live"};
    ownership_call_bodies.open(&live, BASES[..], live_names[..]);
    defer ownership_call_bodies.close(&live);
    ownership_call_bodies.infer_all(&live);
    i = 0;
    while (i < 3) {
        proved(&live, i);
        i += 1;
    }
    // The reference load uses the current base of the parent first: a read of local 1.
    ownership_summary_model.summary* load = ownership_call_bodies.summary(&live, 0);
    assert(load->effects.len == 3 && load->requirements.len == 1);
    assert(read_of(load, 1) == 0);
    assert(load->requirements[0].kind == ownership_summary_model.requirement_kind.extent);
    effect(load, 1, ownership_summary_model.payload_kind.reference_load,
        ownership_api.effect_kind.write);
    leaf_effect(load, 2, ownership_summary_model.payload_kind.copy, 0, 0, 0);

    ownership_summary_model.summary* read = ownership_call_bodies.summary(&live, 1);
    base_first(read, 1);
    assert(read->effects.len == 2 && read->requirements.len == 2);
    effect(read, 1, ownership_summary_model.payload_kind.replacement,
        ownership_api.effect_kind.write);
    println("aggregate base reads ok");
}

// A projected copy or move out of a modeled local expands into flow leaf effects.
fn private_reads() void {
    ownership_call_bodies.bodies mut failures = ownership_call_bodies.bodies{};
    string[5] failure_names = {"private_after_release", "element_after_release",
        "component_after_release", "private_move_after_release", "local_after_release"};
    ownership_call_bodies.open(&failures, PRIVATE[..], failure_names[..]);
    defer ownership_call_bodies.close(&failures);
    u64 mut i = 0;
    while (i < 5) {
        invalid_body(&failures, i);
        i += 1;
    }

    ownership_call_bodies.bodies mut live = ownership_call_bodies.bodies{};
    string[6] live_names = {"private_live", "element_live", "component_live",
        "private_move_live", "local_live", "param_live"};
    ownership_call_bodies.open(&live, PRIVATE[..], live_names[..]);
    defer ownership_call_bodies.close(&live);
    ownership_call_bodies.infer_all(&live);
    i = 0;
    while (i < 6) {
        proved(&live, i);
        i += 1;
    }
    ownership_summary_model.summary* field = ownership_call_bodies.summary(&live, 0);
    assert(field->effects.len == 5);
    leaf_effect(field, 1, ownership_summary_model.payload_kind.copy, 3, 2, 1);
    leaf_effect(field, 2, ownership_summary_model.payload_kind.copy, 0, 1, 2);

    ownership_summary_model.summary* element = ownership_call_bodies.summary(&live, 1);
    assert(element->effects.len == 12);
    leaf_effect(element, 8, ownership_summary_model.payload_kind.copy, 0, 1, 2);
    ownership_api.projection index = element->effects[8].operand.projections[0];
    assert(index.kind == ownership_api.projection_kind.fixed_index);
    assert(index.index.kind == ownership_api.fact_kind.exact && index.index.value == 1);

    ownership_summary_model.summary* component = ownership_call_bodies.summary(&live, 2);
    assert(component->effects.len == 5);
    leaf_effect(component, 2, ownership_summary_model.payload_kind.copy, 0, 2, 2);

    ownership_summary_model.summary* moved = ownership_call_bodies.summary(&live, 3);
    assert(moved->effects.len == 11);
    leaf_effect(moved, 6, ownership_summary_model.payload_kind.move, 0, 1, 2);
    leaf_effect(moved, 7, ownership_summary_model.payload_kind.copy, 0, 1, 2);
    leaf_effect(moved, 8, ownership_summary_model.payload_kind.replacement, 3, 2, 2);

    ownership_summary_model.summary* local = ownership_call_bodies.summary(&live, 4);
    assert(local->effects.len == 7);
    leaf_effect(local, 2, ownership_summary_model.payload_kind.copy, 4, 1, 2);
    leaf_effect(local, 3, ownership_summary_model.payload_kind.copy, 0, 1, 1);

    ownership_summary_model.summary* param = ownership_call_bodies.summary(&live, 5);
    assert(param->effects.len == 1);
    leaf_effect(param, 0, ownership_summary_model.payload_kind.copy, 0, 0, 1);
    println("aggregate private reads ok");
}

// An unmodeled component and a flow reference leaf in one named local keep proof incomplete.
fn partial_models() void {
    ownership_call_bodies.bodies mut partial = ownership_call_bodies.bodies{};
    string[6] partial_names = {"partial_after_release", "partial_live", "partial_reference",
        "partial_result_after_release", "address_after_release", "heap_copy_live"};
    ownership_call_bodies.open(&partial, PARTIAL[..], partial_names[..]);
    defer ownership_call_bodies.close(&partial);
    u64 mut i = 0;
    while (i < 4) {
        incomplete_body(&partial, i);
        i += 1;
    }
    incomplete_with(&partial, 4, ownership_api.incomplete_reason.missing_path);
    incomplete_with(&partial, 5, ownership_api.incomplete_reason.missing_path);

    // A by-value parameter component is unmodeled too, so its named literal stays incomplete.
    ownership_call_bodies.bodies mut param_partial = ownership_call_bodies.bodies{};
    string[2] param_partial_names = {"param_partial_after_release", "param_partial_live"};
    ownership_call_bodies.open(&param_partial, PARTIAL[..], param_partial_names[..]);
    defer ownership_call_bodies.close(&param_partial);
    incomplete_body(&param_partial, 0);
    incomplete_body(&param_partial, 1);

    // A caller component into the result is a whole copy of caller storage (caller_copies).
    ownership_call_bodies.bodies mut whole = ownership_call_bodies.bodies{};
    string[2] whole_names = {"partial_result", "caller_and_zero"};
    ownership_call_bodies.open(&whole, PARTIAL[..], whole_names[..]);
    defer ownership_call_bodies.close(&whole);
    incomplete_body(&whole, 0);
    incomplete_body(&whole, 1);
    println("aggregate partial models ok");
}

// A whole copy, a literal component and a literal leaf through a second dereference stop
// before flow (D17.14). Only the whole caller move of the prior rule keeps its proof.
fn second_derefs() void {
    ownership_call_bodies.bodies mut copies = ownership_call_bodies.bodies{};
    string[6] copy_names = {"pp_copy", "pp_copy_named", "field_copy", "field_copy_named",
        "field_copy_scalar", "field_nested"};
    ownership_call_bodies.open(&copies, SECOND[..], copy_names[..]);
    defer ownership_call_bodies.close(&copies);
    u64 mut i = 0;
    while (i < 6) {
        incomplete_body(&copies, i);
        i += 1;
    }

    ownership_call_bodies.bodies mut literals = ownership_call_bodies.bodies{};
    string[3] literal_names = {"field_moved", "literal_component", "literal_leaf"};
    ownership_call_bodies.open(&literals, SECOND[..], literal_names[..]);
    defer ownership_call_bodies.close(&literals);
    i = 0;
    while (i < 3) {
        incomplete_body(&literals, i);
        i += 1;
    }

    // The valid bodies of the same shapes lose their proof too.
    ownership_call_bodies.bodies mut live = ownership_call_bodies.bodies{};
    string[4] live_names = {"field_copy_live", "pp_copy_live", "move_residual",
        "component_move"};
    ownership_call_bodies.open(&live, SECOND[..], live_names[..]);
    defer ownership_call_bodies.close(&live);
    i = 0;
    while (i < 4) {
        incomplete_body(&live, i);
        i += 1;
    }

    ownership_call_bodies.bodies mut moves = ownership_call_bodies.bodies{};
    string[1] move_names = {"field_move_live"};
    ownership_call_bodies.open(&moves, SECOND[..], move_names[..]);
    defer ownership_call_bodies.close(&moves);
    ownership_call_bodies.infer(&moves, 0);
    proved(&moves, 0);
    ownership_summary_model.summary* moved = ownership_call_bodies.summary(&moves, 0);
    base_first(moved, 1);
    assert(moved->effects.len == 4);
    assert(payload_at(moved, ownership_summary_model.payload_kind.reference_load, 0) == 2);
    effect(moved, 3, ownership_summary_model.payload_kind.move,
        ownership_api.effect_kind.transfer);
    leaf_effect(moved, 3, ownership_summary_model.payload_kind.move, 0, 0, 0);
    println("aggregate second dereferences ok");
}

// A literal leaf of body storage, of a by-value parameter or of a loaded reference stays
// unsupported, live or released (D17.14).
fn body_leaves() void {
    ownership_call_bodies.bodies mut stored = ownership_call_bodies.bodies{};
    string[6] stored_names = {"local_leaf", "local_leaf_named", "nested_leaf",
        "local_leaf_live", "param_leaf", "loaded_leaf"};
    ownership_call_bodies.open(&stored, BODY_LEAVES[..], stored_names[..]);
    defer ownership_call_bodies.close(&stored);
    u64 mut i = 0;
    while (i < 6) {
        incomplete_body(&stored, i);
        i += 1;
    }
    println("aggregate body leaves ok");
}

// A whole component copy keeps proof and gives no result leaf failure (D17.15). A modeled
// component still reads each leaf in body flow.
fn components() void {
    ownership_call_bodies.bodies mut whole = ownership_call_bodies.bodies{};
    string[5] whole_names = {"param_component", "named_component", "two_components",
        "caller_component", "deferred_component"};
    ownership_call_bodies.open(&whole, COMPONENTS[..], whole_names[..]);
    defer ownership_call_bodies.close(&whole);
    ownership_call_bodies.infer_all(&whole);
    u64 mut i = 0;
    while (i < 3) {
        proved(&whole, i);
        i += 1;
    }
    ownership_summary_model.summary* param = ownership_call_bodies.summary(&whole, 0);
    assert(param->effects.len == 1 && param->requirements.len == 0);
    leaf_effect(param, 0, ownership_summary_model.payload_kind.copy, 0, 1, 0);
    ownership_summary_model.summary* two = ownership_call_bodies.summary(&whole, 2);
    assert(two->effects.len == 2);
    leaf_effect(two, 1, ownership_summary_model.payload_kind.copy, 0, 1, 0);
    // A component of caller storage is a whole copy of caller storage (caller_copies).
    incomplete_body(&whole, 3);
    incomplete_body(&whole, 4);

    ownership_call_bodies.bodies mut failures = ownership_call_bodies.bodies{};
    string[2] failure_names = {"released_component", "address_over_stale"};
    ownership_call_bodies.open(&failures, COMPONENTS[..], failure_names[..]);
    defer ownership_call_bodies.close(&failures);
    invalid_body(&failures, 0);
    // A copy through an address writes no flow step, so flow does not run on a stale leaf.
    incomplete_with(&failures, 1, ownership_api.incomplete_reason.missing_path);
    println("aggregate components ok");
}

// Literals of 32 and 64 components stay far below their W bound. Each aggregate assignment
// reserves 2 steps for each reference leaf and 1 for each operand (D17.18).
fn wide_literals() void {
    ownership_call_bodies.bodies mut temps = ownership_call_bodies.bodies{};
    string[2] temp_names = {"temps32", "temps64"};
    ownership_call_bodies.open(&temps, WIDE[..], temp_names[..]);
    defer ownership_call_bodies.close(&temps);
    // Copied temporaries reach the return with a holding mark, a later rule.
    incomplete_body(&temps, 0);
    assert(temps.services.counts.meter.used.w == 5653);
    incomplete_body(&temps, 1);
    assert(temps.services.counts.meter.used.w == 11125);

    ownership_call_bodies.bodies mut tight = ownership_call_bodies.bodies{};
    string[1] tight_names = {"tight"};
    ownership_call_bodies.open(&tight, TIGHT[..], tight_names[..]);
    defer ownership_call_bodies.close(&tight);
    ownership_call_bodies.infer(&tight, 0);
    proved(&tight, 0);
    ownership_summary_model.summary* tight_summary = ownership_call_bodies.summary(&tight, 0);
    // 32 copies build `a`, 32 leaf copies write the result, and 1 storage end ends `a`.
    assert(tight_summary->effects.len == 65);
    assert(payloads(tight_summary, ownership_summary_model.payload_kind.copy) == 64);
    assert(payloads(tight_summary, ownership_summary_model.payload_kind.storage_end) == 1);

    ownership_call_bodies.bodies mut named = ownership_call_bodies.bodies{};
    string[4] named_names = {"named32", "named64", "param32", "param64"};
    ownership_call_bodies.open(&named, WIDE[..], named_names[..]);
    defer ownership_call_bodies.close(&named);
    u64[4] widths = {32, 64, 32, 64};
    u64[4] used = {13785, 27582, 6420, 16009};
    u64 mut i = 0;
    while (i < 4) {
        ownership_call_bodies.infer(&named, i);
        proved(&named, i);
        assert(named.services.counts.meter.used.w == used[i]);
        assert(named.services.counts.meter.used.w < named.services.limits.w / 4);
        assert(ownership_call_bodies.summary(&named, i)->effects.len == widths[i]);
        i += 1;
    }
    println("aggregate wide literals ok");
}

// A whole copy of caller storage and a projected literal leaf read no write of this body to
// that storage (D17.14). So they stay unsupported. The 11 faulty bodies proved before the cut.
fn caller_copies() void {
    ownership_call_bodies.bodies mut written = ownership_call_bodies.bodies{};
    string[5] written_names = {"set", "c2_call_write", "c1_local_addr", "f4_caller_written",
        "f5_caller_direct"};
    ownership_call_bodies.open(&written, CALLER[..], written_names[..]);
    defer ownership_call_bodies.close(&written);
    ownership_call_bodies.infer(&written, 0);
    proved(&written, 0);
    u64 mut i = 1;
    while (i < 5) {
        incomplete_body(&written, i);
        i += 1;
    }

    ownership_call_bodies.bodies mut direct_copies = ownership_call_bodies.bodies{};
    string[6] direct_names = {"f15_direct", "f16_direct_ret", "f17_lit_direct",
        "q2_return_then_clear", "q3_field_of_caller", "lw2_leaf_named"};
    ownership_call_bodies.open(&direct_copies, CALLER[..], direct_names[..]);
    defer ownership_call_bodies.close(&direct_copies);
    i = 0;
    while (i < 6) {
        incomplete_body(&direct_copies, i);
        i += 1;
    }

    // The valid bodies of the same shapes lose their proof too.
    ownership_call_bodies.bodies mut rest = ownership_call_bodies.bodies{};
    string[3] rest_names = {"lw4_field_leaf", "c3_ok_unwritten", "q5_ok_clear_first"};
    ownership_call_bodies.open(&rest, CALLER[..], rest_names[..]);
    defer ownership_call_bodies.close(&rest);
    i = 0;
    while (i < 3) {
        incomplete_body(&rest, i);
        i += 1;
    }
    println("aggregate caller copies ok");
}

// Extraction models no null test. A one-step guarded read of a caller owner uses this base use
// and gives incomplete proof. A projected guarded read reaches the current-base check of the
// parent, which fails it as on the parent: that false violation belongs to the parent rule.
fn guarded_bases() void {
    ownership_call_bodies.bodies mut guarded = ownership_call_bodies.bodies{};
    string[5] guarded_names = {"takepair", "g10_moved_owner_guard", "g12_param_deref_guard",
        "g13_released_guard", "g14_callee_guard"};
    ownership_call_bodies.open(&guarded, GUARD[..], guarded_names[..]);
    defer ownership_call_bodies.close(&guarded);
    ownership_call_bodies.infer(&guarded, 0);
    proved(&guarded, 0);
    invalid_body_with(&guarded, 1, "empty reference has no element", false);
    unproved_base(&guarded, 2);
    invalid_body_with(&guarded, 3, "empty reference has no element", false);
    invalid_body_with(&guarded, 4, "empty reference has no element", false);
    ownership_call_bodies.bodies mut local = ownership_call_bodies.bodies{};
    string[2] local_names = {"g11_local_owner_guard", "g15_released_unguarded"};
    ownership_call_bodies.open(&local, GUARD[..], local_names[..]);
    defer ownership_call_bodies.close(&local);
    // The local owner stops in extraction before flow, unproved as well.
    incomplete_body(&local, 0);
    invalid_body_with(&local, 1, "empty reference has no element", false);
    println("aggregate guarded bases ok");
}

// A proved callee store refreshes the private leaves of a literal, and the summary publishes
// the write as a copy effect, as on the parent. A zero or a whole copy keeps its leaves in place,
// where no refresh runs, so an addressed local of that kind stays unsupported (D17.14).
fn addressed_locals() void {
    ownership_call_bodies.bodies mut set = ownership_call_bodies.bodies{};
    string[5] names = {"replace", "zero_then_call", "copy_then_call", "literal_then_call",
        "zero_unaddressed"};
    ownership_call_bodies.open(&set, ADDRESSED[..], names[..]);
    defer ownership_call_bodies.close(&set);
    ownership_call_bodies.infer(&set, 0);
    proved(&set, 0);
    incomplete_body(&set, 1);
    incomplete_body(&set, 2);
    ownership_call_bodies.infer(&set, 3);
    proved(&set, 3);
    ownership_summary_model.summary* literal = ownership_call_bodies.summary(&set, 3);
    u64 mut published = 0;
    u64 mut i = 0;
    while (i < literal->effects.len) {
        ownership_summary_model.effect_node node = literal->effects[i];
        if (node.payload == ownership_summary_model.payload_kind.copy &&
            node.effect.place.root.ordinal == 3 && node.effect.place.projections.len == 1 &&
            node.operand.root.ordinal == 2) { published += 1; }
        i += 1;
    }
    assert(published == 1);
    ownership_call_bodies.infer(&set, 4);
    proved(&set, 4);
    println("aggregate addressed locals ok");
}

// A store or a zero over a live owning leaf discards that owner, and a storage end of a local
// with an owning leaf stops the proof, because the leaf stays in place (D17.6, D17.15).
fn owner_leaves() void {
    ownership_call_bodies.bodies mut set = ownership_call_bodies.bodies{};
    string[3] names = {"zero_over_owner", "move_over_owner", "leak_local"};
    ownership_call_bodies.open(&set, OWNERS[..], names[..]);
    defer ownership_call_bodies.close(&set);
    lost_owner(&set, 0, "assignment would discard a live owner");
    lost_owner(&set, 1, "move would discard a live owner");
    unproved_base(&set, 2);
    println("aggregate owner leaves ok");
}

// The harness opens at most 6 bodies, so the 7 bodies and their 4 callees take 2 sets.
fn param_writes() void {
    string[6] first_names = {"set", "set_b", "g4_param_copy", "g4c_param_two", "k2_param_self",
        "k6_param_self_two"};
    string[6] second_names = {"set", "set_ty", "set_h", "k1_param_alias", "k3_param_two",
        "k5_param_holder"};
    u64[2] callees = {2, 3};
    u64 mut round = 0;
    while (round < 2) {
        ownership_call_bodies.bodies mut set = ownership_call_bodies.bodies{};
        if (round == 0) {
            ownership_call_bodies.open(&set, PARAM_WRITES[..], first_names[..]);
        } else {
            ownership_call_bodies.open(&set, PARAM_WRITES[..], second_names[..]);
        }
        u64 mut i = 0;
        while (i < callees[round]) {
            ownership_call_bodies.infer(&set, i);
            proved(&set, i);
            i += 1;
        }
        while (i < 6) {
            incomplete_body(&set, i);
            i += 1;
        }
        ownership_call_bodies.close(&set);
        round += 1;
    }
    println("aggregate parameter writes ok");
}

fn owner_writes() void {
    ownership_call_bodies.bodies mut set = ownership_call_bodies.bodies{};
    string[5] names = {"rel_only", "mrel", "e1_rel_only_ret", "e2_rel_only_copy",
        "e6_mixed_rel"};
    ownership_call_bodies.open(&set, OWNER_WRITES[..], names[..]);
    defer ownership_call_bodies.close(&set);
    ownership_call_bodies.infer(&set, 0);
    proved(&set, 0);
    ownership_call_bodies.infer(&set, 1);
    proved(&set, 1);
    incomplete_body(&set, 2);
    incomplete_body(&set, 3);
    incomplete_body(&set, 4);
    println("aggregate addressed owners ok");
}

fn failed_body(ownership_call_bodies.bodies mut* state, u64 index) void {
    ownership_call_bodies.infer(state, index);
    ownership_summary_model.summary* failed = ownership_call_bodies.summary(state, index);
    assert(failed->proof.failed && !ownership_api.successful(failed->proof));
    assert(failed->cases.len == 0);
}

// The harness opens at most 6 bodies, so the 8 bodies and their callee take 2 sets.
fn array_returns() void {
    ownership_call_bodies.bodies mut first = ownership_call_bodies.bodies{};
    string[6] first_names = {"seta", "g1_arr_rel", "g2_arr_set", "g6_arr_one", "h3_arr_first",
        "h4_arr_param_leaf"};
    ownership_call_bodies.open(&first, ARRAY_RETURNS[..], first_names[..]);
    defer ownership_call_bodies.close(&first);
    ownership_call_bodies.infer(&first, 0);
    proved(&first, 0);
    u64 mut i = 1;
    while (i < 6) {
        failed_body(&first, i);
        i += 1;
    }
    ownership_call_bodies.bodies mut second = ownership_call_bodies.bodies{};
    string[3] second_names = {"h5_arr_null_then", "h8_arr_local", "i2_arr_two_copies"};
    ownership_call_bodies.open(&second, ARRAY_RETURNS[..], second_names[..]);
    defer ownership_call_bodies.close(&second);
    i = 0;
    while (i < 3) {
        failed_body(&second, i);
        i += 1;
    }
    println("aggregate array returns ok");
}

fn projected_writes() void {
    ownership_call_bodies.bodies mut set = ownership_call_bodies.bodies{};
    string[5] names = {"set_ty", "j1_param_proj", "j5_param_named", "j9_lit_proj",
        "j13_alias"};
    ownership_call_bodies.open(&set, PROJECTED_WRITES[..], names[..]);
    defer ownership_call_bodies.close(&set);
    ownership_call_bodies.infer(&set, 0);
    proved(&set, 0);
    u64 mut i = 1;
    while (i < 5) {
        incomplete_body(&set, i);
        i += 1;
    }
    println("aggregate projected writes ok");
}

fn main() i32 {
    ownership_call_bodies.bodies mut b = ownership_call_bodies.bodies{};
    string[6] names = {"constant_value", "copied_value", "moved_value", "returned_value",
        "moved_borrow", "returned_param"};
    ownership_call_bodies.open(&b, SOURCE[..], names[..]);
    defer ownership_call_bodies.close(&b);
    ownership_call_bodies.infer_all(&b);

    proved(&b, 0);
    ownership_summary_model.summary* constant = ownership_call_bodies.summary(&b, 0);
    assert(constant->effects.len == 3 && constant->roots.len == 2);
    effect(constant, 0, ownership_summary_model.payload_kind.replacement,
        ownership_api.effect_kind.write);
    effect(constant, 1, ownership_summary_model.payload_kind.move,
        ownership_api.effect_kind.transfer);
    effect(constant, 2, ownership_summary_model.payload_kind.storage_end,
        ownership_api.effect_kind.storage_end);
    println("aggregate constant ok");
    println("aggregate zero return ok");

    proved(&b, 1);
    ownership_summary_model.summary* copied = ownership_call_bodies.summary(&b, 1);
    assert(copied->effects.len == 3 && copied->roots.len == 3);
    effect(copied, 0, ownership_summary_model.payload_kind.copy,
        ownership_api.effect_kind.write);
    effect(copied, 1, ownership_summary_model.payload_kind.copy,
        ownership_api.effect_kind.write);
    effect(copied, 2, ownership_summary_model.payload_kind.storage_end,
        ownership_api.effect_kind.storage_end);
    println("aggregate copy ok");

    proved(&b, 2);
    ownership_summary_model.summary* moved = ownership_call_bodies.summary(&b, 2);
    assert(moved->effects.len == 6 && moved->roots.len == 5);
    effect(moved, 0, ownership_summary_model.payload_kind.allocation,
        ownership_api.effect_kind.write);
    u64[3] moves = {1, 2, 3};
    for (u64 i : moves) {
        effect(moved, i, ownership_summary_model.payload_kind.move,
            ownership_api.effect_kind.transfer);
    }
    u64[2] ends = {4, 5};
    for (u64 i : ends) {
        effect(moved, i, ownership_summary_model.payload_kind.storage_end,
            ownership_api.effect_kind.storage_end);
    }
    println("aggregate move ok");

    proved(&b, 3);
    ownership_summary_model.summary* returned = ownership_call_bodies.summary(&b, 3);
    assert(returned->effects.len == 0 && returned->roots.len == 2);
    println("aggregate return ok");

    proved(&b, 4);
    ownership_summary_model.summary* moved_borrow = ownership_call_bodies.summary(&b, 4);
    assert(payloads(moved_borrow, ownership_summary_model.payload_kind.allocation) == 1);
    assert(payloads(moved_borrow,
        ownership_summary_model.payload_kind.copy) == 2);
    assert(payloads(moved_borrow,
        ownership_summary_model.payload_kind.move) == 2);
    assert(payloads(moved_borrow, ownership_summary_model.payload_kind.replacement) == 1);
    u64 moved_borrow_copy = payload_at(moved_borrow,
        ownership_summary_model.payload_kind.copy, 1);
    u64 moved_borrow_clear = payload_at(moved_borrow,
        ownership_summary_model.payload_kind.replacement, 0);
    assert(moved_borrow_copy < moved_borrow->effects.len);
    assert(moved_borrow_clear < moved_borrow->effects.len);
    assert(ownership_state.same_place(moved_borrow->effects[moved_borrow_copy].operand,
        moved_borrow->effects[moved_borrow_clear].effect.place));

    proved(&b, 5);
    ownership_summary_model.summary* returned_param = ownership_call_bodies.summary(&b, 5);
    assert(payloads(returned_param, ownership_summary_model.payload_kind.copy) == 2);
    assert(returned_param->requirements.len == 1);

    ownership_call_bodies.bodies mut extra_results = ownership_call_bodies.bodies{};
    string[4] extra_result_names = {"caller_copy_live", "moved_two",
        "returned_nested_param", "zero_borrowed_result"};
    ownership_call_bodies.open(&extra_results, SOURCE[..], extra_result_names[..]);
    defer ownership_call_bodies.close(&extra_results);
    ownership_call_bodies.infer_all(&extra_results);

    // A whole copy of caller storage stays unsupported, live or not (caller_copies).
    incomplete_body(&extra_results, 0);

    proved(&extra_results, 1);
    ownership_summary_model.summary* moved_two =
        ownership_call_bodies.summary(&extra_results, 1);
    assert(payloads(moved_two, ownership_summary_model.payload_kind.copy) == 4);
    assert(payloads(moved_two, ownership_summary_model.payload_kind.replacement) == 2);
    u64 mut replacement = 0;
    while (replacement < 2) {
        u64 copied_at = payload_at(moved_two, ownership_summary_model.payload_kind.copy,
            replacement + 2);
        u64 cleared_at = payload_at(moved_two,
            ownership_summary_model.payload_kind.replacement, replacement);
        assert(copied_at < moved_two->effects.len && cleared_at < moved_two->effects.len);
        assert(ownership_state.same_place(moved_two->effects[copied_at].operand,
            moved_two->effects[cleared_at].effect.place));
        replacement += 1;
    }

    proved(&extra_results, 2);
    ownership_summary_model.summary* nested_param =
        ownership_call_bodies.summary(&extra_results, 2);
    assert(payloads(nested_param, ownership_summary_model.payload_kind.copy) == 3);
    assert(nested_param->requirements.len == 1);

    ownership_summary_model.summary* zero_borrowed =
        ownership_call_bodies.summary(&extra_results, 3);
    assert(ownership_api.successful(zero_borrowed->proof));
    assert(!zero_borrowed->residual_effects && zero_borrowed->cases.len == 2);
    assert(payloads(zero_borrowed,
        ownership_summary_model.payload_kind.replacement) == 1);

    ownership_call_bodies.bodies mut nested = ownership_call_bodies.bodies{};
    string[6] nested_names = {"nested_borrow", "fixed_borrow", "nested_owner",
        "nested_zero", "empty_text", "projected_borrow"};
    ownership_call_bodies.open(&nested, NESTED[..], nested_names[..]);
    defer ownership_call_bodies.close(&nested);
    ownership_call_bodies.infer_all(&nested);

    proved(&nested, 0);
    ownership_summary_model.summary* nested_borrow =
        ownership_call_bodies.summary(&nested, 0);
    assert(payloads(nested_borrow, ownership_summary_model.payload_kind.copy) == 6);
    assert(payloads(nested_borrow, ownership_summary_model.payload_kind.storage_end) == 3);
    assert(selected(nested_borrow, ownership_summary_model.payload_kind.copy,
        ownership_api.projection_kind.field, 0, 0));
    assert(selected(nested_borrow, ownership_summary_model.payload_kind.copy,
        ownership_api.projection_kind.field, 1, 0));
    assert(nested_borrow->requirements.len == 2);
    assert(nested_borrow->requirements[0].kind ==
        ownership_summary_model.requirement_kind.live_source);
    assert(nested_borrow->requirements[1].kind ==
        ownership_summary_model.requirement_kind.live_source);

    proved(&nested, 1);
    ownership_summary_model.summary* fixed_borrow =
        ownership_call_bodies.summary(&nested, 1);
    assert(payloads(fixed_borrow, ownership_summary_model.payload_kind.copy) == 6);
    assert(payloads(fixed_borrow, ownership_summary_model.payload_kind.storage_end) == 3);
    assert(selected(fixed_borrow, ownership_summary_model.payload_kind.copy,
        ownership_api.projection_kind.fixed_index, 0, 0));
    assert(selected(fixed_borrow, ownership_summary_model.payload_kind.copy,
        ownership_api.projection_kind.fixed_index, 1, 0));
    assert(fixed_borrow->requirements.len == 2);

    proved(&nested, 2);
    ownership_summary_model.summary* nested_owner =
        ownership_call_bodies.summary(&nested, 2);
    assert(payloads(nested_owner, ownership_summary_model.payload_kind.allocation) == 2);
    assert(payloads(nested_owner, ownership_summary_model.payload_kind.move) == 7);
    assert(payloads(nested_owner, ownership_summary_model.payload_kind.storage_end) == 3);
    assert(selected(nested_owner, ownership_summary_model.payload_kind.move,
        ownership_api.projection_kind.field, 0, 0));
    assert(selected(nested_owner, ownership_summary_model.payload_kind.move,
        ownership_api.projection_kind.field, 1, 0));

    proved(&nested, 3);
    ownership_summary_model.summary* nested_zero =
        ownership_call_bodies.summary(&nested, 3);
    assert(payloads(nested_zero, ownership_summary_model.payload_kind.replacement) == 2);
    assert(payloads(nested_zero, ownership_summary_model.payload_kind.move) == 2);
    assert(payloads(nested_zero, ownership_summary_model.payload_kind.storage_end) == 1);
    assert(selected(nested_zero, ownership_summary_model.payload_kind.replacement,
        ownership_api.projection_kind.field, 0, 0));
    assert(selected(nested_zero, ownership_summary_model.payload_kind.replacement,
        ownership_api.projection_kind.field, 1, 0));

    proved(&nested, 4);
    ownership_summary_model.summary* empty_text = ownership_call_bodies.summary(&nested, 4);
    assert(payloads(empty_text, ownership_summary_model.payload_kind.replacement) == 1);
    assert(payloads(empty_text, ownership_summary_model.payload_kind.reference_load) == 0);
    assert(payloads(empty_text, ownership_summary_model.payload_kind.copy) == 0);

    // A projected borrowed leaf stays unsupported: it would read a fresh source (D17.14).
    incomplete_body(&nested, 5);

    ownership_call_bodies.bodies mut failures = ownership_call_bodies.bodies{};
    string[6] failure_names = {"nested_after_release", "array_after_release",
        "copy_after_release", "move_after_release", "caller_copy_after_release",
        "returned_local"};
    ownership_call_bodies.open(&failures, FAILURES[..], failure_names[..]);
    defer ownership_call_bodies.close(&failures);
    u64 mut i = 0;
    while (i < 2) {
        invalid_body(&failures, i);
        i += 1;
    }
    // A flat literal returned whole is one effect, as on the parent; the exit check fails it.
    invalid_body_with(&failures, 2, "returned aggregate view outlives its source", true);
    invalid_body(&failures, 3);
    incomplete_body(&failures, 4);
    invalid_body_with(&failures, 5, "returned aggregate view outlives its source", true);

    ownership_call_bodies.bodies mut local_failures = ownership_call_bodies.bodies{};
    string[2] local_failure_names = {"returned_local_move", "returned_nested_local"};
    ownership_call_bodies.open(&local_failures, FAILURES[..], local_failure_names[..]);
    defer ownership_call_bodies.close(&local_failures);
    invalid_body_with(&local_failures, 0, "returned view outlives its source", true);
    invalid_body_with(&local_failures, 1, "returned view outlives its source", true);

    ownership_call_bodies.bodies mut caller_failures = ownership_call_bodies.bodies{};
    string[2] caller_failure_names = {"caller_move_after_release",
        "caller_nested_after_release"};
    ownership_call_bodies.open(&caller_failures, FAILURES[..], caller_failure_names[..]);
    defer ownership_call_bodies.close(&caller_failures);
    unproved_base(&caller_failures, 0);
    incomplete_body(&caller_failures, 1);

    ownership_call_bodies.bodies mut second_failures = ownership_call_bodies.bodies{};
    string[2] second_failure_names = {"local_copy_after_release",
        "nested_copy_after_release"};
    ownership_call_bodies.open(&second_failures, FAILURES[..], second_failure_names[..]);
    defer ownership_call_bodies.close(&second_failures);
    // A whole copy through an address of body storage stops before flow (missing path).
    incomplete_with(&second_failures, 0, ownership_api.incomplete_reason.missing_path);
    invalid_body(&second_failures, 1);

    ownership_call_bodies.bodies mut metered = ownership_call_bodies.bodies{};
    string[1] metered_names = {"metered"};
    ownership_call_bodies.open(&metered, METERED[..], metered_names[..]);
    defer ownership_call_bodies.close(&metered);
    ownership_call_bodies.infer(&metered, 0);
    proved(&metered, 0);
    // Each literal field reads one declaration child and pays one W unit for it.
    assert(metered.services.counts.meter.used.w == 435);

    ownership_call_bodies.bodies mut metered_wide = ownership_call_bodies.bodies{};
    string[1] metered_wide_names = {"metered_wide"};
    ownership_call_bodies.open(&metered_wide, METERED_WIDE[..], metered_wide_names[..]);
    defer ownership_call_bodies.close(&metered_wide);
    ownership_call_bodies.infer(&metered_wide, 0);
    proved(&metered_wide, 0);
    assert(metered_wide.services.counts.meter.used.w == 819);
    // The 16 more fields cost 24 W units each, so the field walk stays linear.
    assert(metered_wide.services.counts.meter.used.w -
        metered.services.counts.meter.used.w == 16 * 24);

    ownership_call_bodies.bodies mut metered_nested = ownership_call_bodies.bodies{};
    string[1] metered_nested_names = {"metered_nested"};
    ownership_call_bodies.open(&metered_nested, METERED_NESTED[..], metered_nested_names[..]);
    defer ownership_call_bodies.close(&metered_nested);
    ownership_call_bodies.infer(&metered_nested, 0);
    proved(&metered_nested, 0);
    assert(metered_nested.services.counts.meter.used.w == 1121);
    metered_nested.services.limits.w = 982;
    ownership_call_bodies.infer_with(&metered_nested, 0);
    ownership_summary_model.summary* work_stopped =
        ownership_call_bodies.summary(&metered_nested, 0);
    assert(!ownership_api.successful(work_stopped->proof));
    assert(work_stopped->proof.terminal.reason == ownership_api.incomplete_reason.work_limit);
    assert(work_stopped->cases.len == 0);

    ownership_call_bodies.bodies mut limits = ownership_call_bodies.bodies{};
    string[3] limit_names = {"too_deep", "too_wide", "scalar_wide"};
    ownership_call_bodies.open(&limits, DEEP_LIMIT[..], limit_names[..]);
    defer ownership_call_bodies.close(&limits);
    incomplete_body(&limits, 0);
    incomplete_body(&limits, 1);
    ownership_call_bodies.infer(&limits, 2);
    proved(&limits, 2);
    ownership_summary_model.summary* scalar_wide =
        ownership_call_bodies.summary(&limits, 2);
    assert(scalar_wide->effects.len == 1);
    assert(scalar_wide->requirements.len == 0);
    assert(scalar_wide->roots.len == 2);
    assert(!scalar_wide->residual_effects);
    effect(scalar_wide, 0, ownership_summary_model.payload_kind.storage_end,
        ownership_api.effect_kind.storage_end);
    println("aggregate invalid reads ok");
    base_reads();
    private_reads();
    partial_models();
    second_derefs();
    body_leaves();
    components();
    wide_literals();
    caller_copies();
    guarded_bases();
    addressed_locals();
    owner_leaves();
    param_writes();
    owner_writes();
    array_returns();
    projected_writes();
    return 0;
}
