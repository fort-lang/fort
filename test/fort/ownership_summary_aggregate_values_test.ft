    "    outer_box value = outer_box{inner}; return value;",
    "}",
    "fn caller_move_after_release(mixed_box mut* own value) mixed_box {",
    "    del(value); return move(*value); }",
    "fn caller_nested_after_release(outer_box mut* own value) outer_box {",
    "    del(value); return *value; }",
    "fn local_copy_after_release() view_box {",
    "    view_box mut* own value = new(view_box);",
    "    del(value); return *value;",
    "}",
    "fn nested_copy_after_release(i32 mut* own p) outer_box {",
    "    view_box inner = view_box{p}; outer_box first = outer_box{inner};",
    "    del(p); outer_box second = outer_box{inner};",
    "    return second; }",
};

// Each load, copy or move through a pointer or span local uses that local first (D17.14).
string[39] BASES = {
    "struct src_box { i32* ptr; }",
    "struct dst_box { i32* ptr; }",
    "struct pair { i32 first; i32 second; }",
    "struct num_box { i32 n; }",
    "struct holder { src_box* src; }",
    "struct view_box { i32* ptr; }",
    "struct caller_outer { view_box inner; }",
    "fn leaf_after_release(src_box mut* own s) dst_box {",
    "    del(s); return dst_box{s->ptr}; }",
    "fn leaf_after_move(src_box mut* own s) dst_box {",
    "    src_box mut* own t = move(s); dst_box d = dst_box{s->ptr}; del(t); return d; }",
    "fn nested_after_release(holder mut* own h) dst_box {",
    "    del(h); return dst_box{h->src->ptr}; }",
    "fn scalar_after_release(pair mut* own p) num_box {",
    "    del(p); return num_box{p->first}; }",
    "fn deref_after_release(i32 mut* own q) num_box {",
    "    del(q); return num_box{*q}; }",
    "fn projected_after_release(caller_outer mut* own c) view_box {",
    "    del(c); return c->inner; }",
    "fn load_after_release(src_box mut* own s) i32* {",
    "    del(s); return s->ptr; }",
    "fn read_after_release(i32 mut* own q) i32 {",
    "    del(q); return *q; }",
    "fn leaf_live(src_box* s) dst_box { return dst_box{s->ptr}; }",
    "fn nested_live(holder* h) dst_box { return dst_box{h->src->ptr}; }",
    "fn load_live(src_box* s) i32* { return s->ptr; }",
    "fn read_live(i32* q) i32 { return *q; }",
    "fn span_live(i32@ s) i32 { return s[0]; }",
    "fn projected_live(caller_outer* c) view_box { return c->inner; }",
    "struct owner_holder { i32 mut* own item; }",
    "fn move_after_release(owner_holder mut* own h) i32 mut* own {",
    "    del(h); i32 mut* own out = move(h->item); return out; }",
    "fn output_after_release(owner_holder mut* own h, owner_holder mut* g) void {",
    "    del(h); del(g->item); g->item = move(h->item); }",
    "fn move_live(owner_holder mut* h) i32 mut* own {",
    "    i32 mut* own out = move(h->item); h->item = new(i32); return out; }",
    "fn output_live(owner_holder mut* h, owner_holder mut* g) void {",
    "    del(g->item); g->item = move(h->item); h->item = new(i32); }",
    "fn unused_bases() void {}",
};

// A whole copy or move from a place inside a modeled local reads each leaf in body flow.
string[37] PRIVATE = {
    "struct view_box { i32* ptr; }",
    "struct outer_box { view_box inner; }",
    "struct mixed { i32 mut* own item; i32* ptr; }",
    "struct outer_mixed { mixed inner; }",
    "fn private_after_release(i32 mut* own p) view_box {",
    "    view_box inner = view_box{p}; outer_box outer = outer_box{inner};",
    "    del(p); return outer.inner; }",
    "fn element_after_release(i32* q, i32 mut* own p) view_box {",
    "    view_box a = view_box{q}; view_box b = view_box{p};",
    "    view_box[2] values = {a, b}; del(p); return values[1]; }",
    "fn component_after_release(i32 mut* own p) outer_box {",
    "    view_box inner = view_box{p}; outer_box first = outer_box{inner};",
    "    del(p); return outer_box{first.inner}; }",
    "fn private_move_after_release(i32 mut* own p) mixed {",
    "    mixed value = mixed{new(i32), p}; outer_mixed outer = outer_mixed{move(value)};",
    "    del(p); return move(outer.inner); }",
    "fn local_after_release(i32 mut* own p) view_box {",
    "    view_box inner = view_box{p}; outer_box outer = outer_box{inner};",
    "    del(p); view_box copy = outer.inner; return copy; }",
    "fn private_live(i32* p) view_box {",
    "    view_box inner = view_box{p}; outer_box outer = outer_box{inner};",
    "    return outer.inner; }",
    "fn element_live(i32* p, i32* q) view_box {",
    "    view_box a = view_box{p}; view_box b = view_box{q};",
    "    view_box[2] values = {a, b}; return values[1]; }",
    "fn component_live(i32* p) outer_box {",
    "    view_box inner = view_box{p}; outer_box first = outer_box{inner};",
    "    return outer_box{first.inner}; }",
    "fn private_move_live(i32* p) mixed {",
    "    mixed value = mixed{new(i32), p}; outer_mixed outer = outer_mixed{move(value)};",
    "    return move(outer.inner); }",
    "fn local_live(i32* p) view_box {",
    "    view_box inner = view_box{p}; outer_box outer = outer_box{inner};",
    "    view_box copy = outer.inner; return copy; }",
    "fn param_live(outer_box value) view_box { return value.inner; }",
    "fn unused_private() void {}",
    "fn spare_private() void {}",
};

// A local that holds an unmodeled component and a reference leaf in body flow has a partial model.
string[26] PARTIAL = {
    "struct view_box { i32* ptr; }",
    "struct two { view_box a; view_box b; }",
    "struct with_ref { view_box a; i32* b; }",
    "fn partial_after_release(view_box* src, i32 mut* own p) two {",
    "    view_box mine = view_box{p}; two value = two{*src, mine};",
    "    del(p); return value; }",
    "fn partial_live(view_box* src, i32* p) two {",
    "    view_box mine = view_box{p}; two value = two{*src, mine}; return value; }",
    "fn partial_reference(view_box* src, i32* p) with_ref {",
    "    with_ref value = with_ref{*src, p}; return value; }",
    "fn partial_result(view_box* src, i32* p) two {",
    "    view_box mine = view_box{p}; return two{*src, mine}; }",
    "fn caller_and_zero(view_box* src) two {",
    "    two value = two{*src, {}}; return value; }",
    "fn address_after_release(i32 mut* own p) view_box {",
    "    view_box value = view_box{p}; view_box* at = &value; del(p); return *at; }",
    "fn heap_copy_live() view_box {",
    "    view_box mut* own value = new(view_box); view_box copy = *value; del(value);",
    "    return copy; }",
    "fn partial_result_after_release(view_box* src, i32 mut* own p) two {",
    "    view_box mine = view_box{p}; defer del(p); return two{*src, mine}; }",
    "fn param_partial_after_release(view_box v, i32 mut* own p) two {",
    "    view_box mine = view_box{p}; two value = two{v, mine}; del(p); return value; }",
    "fn param_partial_live(view_box v, i32* p) two {",
    "    view_box mine = view_box{p}; two value = two{v, mine}; return value; }",
    "fn unused_partial() void {}",
};

