//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: containers.str_set: index out of range
//! stdout:
//| A
import containers;

/// Checks that str_set rejects an index at or above len. A caller cannot write directly into
/// unused capacity.
fn main() i32 {
    containers.str_vec mut v = containers.str_create();
    defer containers.str_free(&v);
    containers.str_push(&v, "a");
    containers.str_set(&v, 0, "A");
    println(containers.str_at(&v, 0));
    containers.str_set(&v, 1, "B");
    return 0;
}
