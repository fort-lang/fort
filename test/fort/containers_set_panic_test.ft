//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: containers.str_set: index out of range
//! stdout:
//| A
import containers;

// str_set has the bound str_at has: it replaces a live element and refuses an
// index at or past len, so a caller cannot fill the capacity behind the
// vector's back.
// D13.3
fn i32 main() {
    containers.str_vec mut v = containers.str_create();
    defer containers.str_free(&v);
    containers.str_push(&v, "a");
    containers.str_set(&v, 0, "A");
    println(containers.str_at(&v, 0));
    containers.str_set(&v, 1, "B");
    return 0;
}
