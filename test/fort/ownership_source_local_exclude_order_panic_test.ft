//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: ownership_source_local: invalid exclusion order
//! stdout:
//| false
/// exclude runs after both runs of a body solve, and only on the stored run. A stored run
/// that never solved breaks that order, so the call panics before it reads any violation.
import ownership_source_local;

fn main() i32 {
    ownership_source_local.context mut stored = ownership_source_local.context{};
    ownership_source_local.context mut local = ownership_source_local.context{};
    stored.stored = true;
    local.solved = true;
    println(stored.solved);
    ownership_source_local.exclude(&stored, &local);
    return 0;
}
