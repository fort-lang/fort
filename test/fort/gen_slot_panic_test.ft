//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: gen.gen_slot_place: a local with no slot
//! stdout:
//| bound
import ast;
import gen;
import gen_env;

// Every local and parameter of the function being emitted has a slot, which
// gen_function makes before it walks the body (item 10): asking for the place
// of a symbol that has none is a broken precondition and not a program the
// emitter refuses, so it panics at the call that broke it, where
// src/bootstrap/gen.c calls fatal_internal.
// D13.3
//
// A panic ends the program, so the case stands in a file of its own.
// D11.4
fn main() i32 {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    assert(gen_env.open_body(&e, "    i32 mut a = 3;"));
    // The local the body declares has one.
    assert(gen_env.place_of(&e, "a").addr.val == "%a.0");
    println("bound");
    // The function itself is a declaration of the module and never a slot of
    // the body being emitted.
    gen.gen_slot_place(&e.g, gen_env.sym_main(&e, "main"));
    return 0;
}
