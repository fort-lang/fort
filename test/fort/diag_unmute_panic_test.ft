//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: diag.unmute: no diag.mute is open
//! stdout:
//| balanced ok
/// unmute closes the mute that its matching mute opened.
import diag;

//
// A call with no open mute breaks the precondition and panics. It must not
// underflow the depth and then drop all later diagnostics.
fn main() i32 {
    diag.sink mut s = diag.create();
    defer diag.free(&s);
    diag.mute(&s);
    assert(diag.unmute(&s) == 0);
    println("balanced ok");
    u64 swallowed = diag.unmute(&s);
    println(swallowed);
    return 0;
}
