//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: diag.unmute: no diag.mute is open
//! stdout:
//| balanced ok
import diag;

// unmute closes the mute its matching mute opened; one with no mute open is a
// violated precondition and panics rather than underflowing the depth into a
// sink that would then drop every diagnostic of the run.
// D13.3
fn main() i32 {
    diag.sink mut s = diag.create();
    defer diag.free(&s);
    diag.mute(&s);
    assert(diag.unmute(&s) == 0);
    println("balanced ok");
    u64 swallowed = diag.unmute(&s);
    println(swallowed);
    return 0;
}
