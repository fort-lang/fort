// Solves one group and prints each body whose verdict differs from its expectation. Gives the
// count of those bodies.
fn check(string label, string@ text, string@ names, string@ want) u64 {
    assert(names.len == want.len);
    ownership_recursive_env.closure mut summaries = ownership_recursive_env.closure{};
    defer ownership_recursive_env.close(&summaries);
    ownership_recursive_env.open(&summaries, text, names);
    ownership_recursive_env.solve(&summaries);
    ownership_source_calls_env.closure mut calls = ownership_source_calls_env.closure{};
    defer ownership_source_calls_env.close(&calls);
    ownership_source_calls_env.run(&calls, text, names);
    u64 mut wrong = 0;
    u64 mut i = 0;
    while (i < names.len) {
        string summary = ownership_gate_env.summary_verdict(&summaries, names[i]);
        string row = ownership_source_calls_env.verdict(&calls, names[i]);
        bool mut held = summary == "unproved";
        if (want[i] == "L") { held = summary == "failed" && row != "proved"; }
        if (want[i] == "F") { held = summary != "proved" && row != "proved"; }
        if (want[i] == "K") { held = summary == "proved"; }
        if (!held) {
            eprintln(label, " ", names[i], " expects ", want[i], ": summary ", summary,
                ", calls_heap ", row);
            wrong += 1;
        }
        i += 1;
    }
    return wrong;
}

fn main() i32 {
    u64 mut wrong = 0;
    wrong += check("prefix_clears", PREFIX_CLEARS[..],
        PREFIX_CLEARS_NAMES[..], PREFIX_CLEARS_WANT[..]);
    wrong += check("by_value", BY_VALUE[..], BY_VALUE_NAMES[..], BY_VALUE_WANT[..]);
    wrong += check("stored_owner_callers", STORED[..], STORED_NAMES[..], STORED_WANT[..]);
    wrong += check("aliases", ALIASES[..], ALIASES_NAMES[..], ALIASES_WANT[..]);
    if (wrong != 0) {
        eprintln(wrong, " bodies differ from their expectation");
        return 1;
    }
    println("summary prefix clear ok");
    return 0;
}
