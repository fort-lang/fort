//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| range pass ok
//| range window ok
//| range align ok
//| range inexact ok
//| range foreign ok
//| range recon ok
//| range none ok
//| range caller ok
//| range stored ok
//| range call ok
//| range unknown ok
/// Holds the raw verdict of a raw range through each value class, alone and
/// joined with each other class on a second path (D17.17, D17.18).
///
/// The classes: `pass` is a window that holds the operation; `window` is a constant
/// window that it exceeds; `align` is a window whose start no aligned base repairs;
/// `inexact` is a window whose symbolic end can be too short; `foreign` is an extern
/// result (D17.13); `recon` is an integer cast (D17.17); `none` is null, which the local
/// analysis owns. `caller`, `stored`, `call` and `unknown` are gaps: other analyses own
/// their facts, so the body leaves the declared raw scope with the first of them.
/// A failure is a violation only when each value fails exactly; any other failure is
/// incomplete proof at the operation.
/// A raw range checks the window, not the alignment, so `align` holds it. Null has
/// no source, so a raw range through it fails (memory model 2.8.2, 2.8.5).
import ownership_raw_source_env;
import ownership_source_raw;

fn range_pass() void {
    ownership_raw_source_env.closure mut c = ownership_raw_source_env.closure{};
    string[130] lines = {
        "struct holder { u64* p; }",
        "extern fn shared_bytes() u8*;",
        "fn make(u64* x) u64* { return x; }",
        "fn m_pass() u64 {",
        "    u64 word = 1;",
        "    u64* mut p = null;",
        "    p = &word;",
        "    u64@ r = p[0..1];",
        "    return r.len;",
        "}",
        "fn m_pass_window(bool c) u64 {",
        "    u64 word = 1;",
        "    u8 tag = 1;",
        "    u64* mut p = null;",
        "    if (c) {",
        "        p = &word;",
        "    } else {",
        "        p = cast(&tag, u64*);",
        "    }",
        "    u64@ r = p[0..1];",
        "    return r.len;",
        "}",
        "fn m_pass_align(bool c) u64 {",
        "    u64 word = 1;",
        "    u64[4] words = {1, 2, 3, 4};",
        "    u64* mut p = null;",
        "    if (c) {",
        "        p = &word;",
        "    } else {",
        "        u8* b = cast(&words, u8*);",
        "        u8@ v = b[4..12];",
        "        p = cast(v.ptr, u64*);",
        "    }",
        "    u64@ r = p[0..1];",
        "    return r.len;",
        "}",
        "fn m_pass_inexact(bool c, u8 n) u64 {",
        "    u64 word = 1;",
        "    u64[32] big = {};",
        "    u64* mut p = null;",
        "    if (c) {",
        "        p = &word;",
        "    } else {",
        "        u8* b = cast(&big, u8*);",
        "        u8@ v = b[0..cast(n, u64)];",
        "        p = cast(v.ptr, u64*);",
        "    }",
        "    u64@ r = p[0..1];",
        "    return r.len;",
        "}",
        "fn m_pass_foreign(bool c) u64 {",
        "    u64 word = 1;",
        "    u64* mut p = null;",
        "    if (c) {",
        "        p = &word;",
        "    } else {",
        "        p = cast(shared_bytes(), u64*);",
        "    }",
        "    u64@ r = p[0..1];",
        "    return r.len;",
        "}",
        "fn m_pass_recon(bool c, u64 bits) u64 {",
        "    u64 word = 1;",
        "    u64* mut p = null;",
        "    if (c) {",
        "        p = &word;",
        "    } else {",
        "        p = cast(bits, u64*);",
        "    }",
        "    u64@ r = p[0..1];",
        "    return r.len;",
        "}",
        "fn m_pass_none(bool c) u64 {",
        "    u64 word = 1;",
        "    u64* mut p = null;",
        "    if (c) {",
        "        p = &word;",
        "    } else {",
        "        p = null;",
        "    }",
        "    u64@ r = p[0..1];",
        "    return r.len;",
        "}",
        "fn m_pass_caller(bool c, u64* q) u64 {",
        "    u64 word = 1;",
        "    u64* mut p = null;",
        "    if (c) {",
        "        p = &word;",
        "    } else {",
        "        p = q;",
        "    }",
        "    u64@ r = p[0..1];",
        "    return r.len;",
        "}",
        "fn m_pass_stored(bool c) u64 {",
        "    u64 word = 1;",
        "    holder h = holder{cast(&word, u64*)};",
        "    u64* mut p = null;",
        "    if (c) {",
        "        p = &word;",
        "    } else {",
        "        p = h.p;",
        "    }",
        "    u64@ r = p[0..1];",
        "    return r.len;",
        "}",
        "fn m_pass_call(bool c) u64 {",
        "    u64 word = 1;",
        "    u64* mut p = null;",
        "    if (c) {",
        "        p = &word;",
        "    } else {",
        "        p = make(cast(&word, u64*));",
        "    }",
        "    u64@ r = p[0..1];",
        "    return r.len;",
        "}",
        "fn m_pass_unknown(bool c, u64 k) u64 {",
        "    u64 word = 1;",
        "    u64[4] words = {1, 2, 3, 4};",
        "    u64* mut p = null;",
        "    if (c) {",
        "        p = &word;",
        "    } else {",
        "        u64@ s = words[k..4];",
        "        p = cast(s.ptr, u64*);",
        "    }",
        "    u64@ r = p[0..1];",
        "    return r.len;",
        "}",
    };
    ownership_raw_source_env.open(&c, lines[..]);
    defer ownership_raw_source_env.close(&c);
    ownership_raw_source_env.proved(&c, "m_pass");
    ownership_raw_source_env.unproved_at(&c, "m_pass_window", 20);
    ownership_raw_source_env.proved(&c, "m_pass_align");
    ownership_raw_source_env.unproved_at(&c, "m_pass_inexact", 48);
    ownership_raw_source_env.proved(&c, "m_pass_foreign");
    ownership_raw_source_env.unproved_at(&c, "m_pass_recon", 70);
    ownership_raw_source_env.unproved_at(&c, "m_pass_none", 81);
    ownership_raw_source_env.outside(&c, "m_pass_caller",
        ownership_source_raw.missing.caller_origin);
    ownership_raw_source_env.outside(&c, "m_pass_stored",
        ownership_source_raw.missing.stored_origin);
    ownership_raw_source_env.outside(&c, "m_pass_call",
        ownership_source_raw.missing.call_origin);
    ownership_raw_source_env.outside(&c, "m_pass_unknown",
        ownership_source_raw.missing.unknown_origin);
    ownership_raw_source_env.report(&c, "range pass");
}

