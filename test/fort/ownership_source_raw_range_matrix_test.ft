        "    u64[32] big = {};",
        "    u64 word = 1;",
        "    holder h = holder{cast(&word, u64*)};",
        "    u64* mut p = null;",
        "    if (c) {",
        "        u8* b = cast(&big, u8*);",
        "        u8@ v = b[0..cast(n, u64)];",
        "        p = cast(v.ptr, u64*);",
        "    } else {",
        "        p = h.p;",
        "    }",
        "    u64@ r = p[0..1];",
        "    return r.len;",
        "}",
        "fn m_inexact_call(bool c, u8 n) u64 {",
        "    u64[32] big = {};",
        "    u64 word = 1;",
        "    u64* mut p = null;",
        "    if (c) {",
        "        u8* b = cast(&big, u8*);",
        "        u8@ v = b[0..cast(n, u64)];",
        "        p = cast(v.ptr, u64*);",
        "    } else {",
        "        p = make(cast(&word, u64*));",
        "    }",
        "    u64@ r = p[0..1];",
        "    return r.len;",
        "}",
        "fn m_inexact_unknown(bool c, u8 n, u64 k) u64 {",
        "    u64[32] big = {};",
        "    u64[4] words = {1, 2, 3, 4};",
        "    u64* mut p = null;",
        "    if (c) {",
