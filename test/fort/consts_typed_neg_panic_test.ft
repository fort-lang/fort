//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: consts.cv_typed_neg: unary minus on an unsigned type
//! stdout:
//| true
import consts;
import prim;

// Unary minus takes signed integers and floats only (D6.2), so the checker has
// already refused `-x` on an unsigned constant and a fold of it is a broken
// precondition (D13.3).
fn i32 main() {
    consts.cval mut r = consts.cv_none();
    println(consts.cv_typed_neg(consts.cv_from_i64(1), prim.prim_kind.prim_i32, &r));
    println(consts.cv_typed_neg(consts.cv_from_i64(1), prim.prim_kind.prim_u32, &r));
    return 0;
}
