//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: gen.syms_at: index out of range
//! stdout:
//| puts
import gen;
import gen_env;
import std.strbuf;

// The extern list answers while the index is below len and panics one symbol
// later, as the record vectors beside it do: the slots past len hold stale
// pointers and a declaration would be emitted for whatever one of them
// happens to name (D13.3, item 8).
fn i32 main() {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "extern fn i32 puts(char* s);\n");
    strbuf.append(&b, "fn i32 main() {\n    return 0;\n}\n");
    assert(gen_env.open_src(&e, strbuf.view(&b)));
    gen.gen_use_extern(&e.g, gen_env.sym_main(&e, "puts"));
    assert(e.g.externs.len == 1);
    println(gen.syms_at(&e.g.externs, 0)->name);
    gen.syms_at(&e.g.externs, 1);
    return 0;
}
