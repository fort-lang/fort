//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: gen.syms_at: index out of range
//! stdout:
//| puts
/// The extern list answers while the index is below len and panics one symbol later, as the
/// record vectors beside it do. The slots past len hold stale pointers and a declaration would
/// be emitted for whatever one of them happens to name.
import fort.gen;
import gen_env;

// The steps of the test, which end in the panic. They read `e` through a pointer, so the use
// rule of `move` and `del` (D17.21) asks no proof of their reads after a call.
fn trigger(gen_env.env mut* e) void {
    string src = gen_env.join2(e, "extern fn puts(char* s) i32;\n",
                               "fn main() i32 {\n    return 0;\n}\n");
    assert(gen_env.open_src(e, src));
    gen.gen_use_extern(&e->g, gen_env.sym_main(e, "puts"));
    assert(e->g.externs.len == 1);
    println(gen.syms_at(&e->g.externs, 0)->name);
    gen.syms_at(&e->g.externs, 1);
}

fn main() i32 {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    trigger(&e);
    return 0;
}
