//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: ownership_source_exit: context is already prepared
//! stdout:
//| true
/// prepare binds a context once. A context that is already prepared breaks that precondition,
/// so a second call panics before it reads the function.
import ownership_api;
import ownership_source_exit;

fn main() i32 {
    ownership_source_exit.closure mut x = ownership_source_exit.closure{.collected = true};
    ownership_source_exit.context mut c = ownership_source_exit.context{.initialized = true};
    println(c.initialized);
    ownership_source_exit.prepare(&c, &x, null, ownership_api.function_id{}, 0, "",
        ownership_api.source_position{}, "main");
    return 0;
}
