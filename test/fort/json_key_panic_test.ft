//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: json.json_key: no object is open
//! stdout:
//| a key in an object ok
/// A key belongs to an object. One written at depth 0 is a violated
/// precondition and panics.
import json;
import json_env;

fn main() i32 {
    json_env.env mut e = json_env.env{};
    json_env.open(&e);
    defer json_env.close(&e);
    json.json_object_begin(&e.j);
    json.json_key(&e.j, "k");
    json.json_uint(&e.j, 1);
    json.json_object_end(&e.j);
    println("a key in an object ok");
    json.json_key(&e.j, "loose");
    println(json_env.written(&e));
    return 0;
}
