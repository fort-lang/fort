//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: consts: constant folding on a non-integer
//! stdout:
//| 3
/// A wrapping operator takes two integer constants of the type it wraps at;
/// a bool operand never reaches it, so it is a broken precondition.
import consts;
import prim;

fn main() i32 {
    println(consts.cv_wrap_add(consts.cv_from_i64(1), consts.cv_from_i64(2),
                               prim.prim_kind.prim_i32).mag);
    println(consts.cv_wrap_add(consts.cv_from_bool(true), consts.cv_from_i64(1),
                               prim.prim_kind.prim_i32).mag);
    return 0;
}
