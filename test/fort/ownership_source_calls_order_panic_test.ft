//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: ownership_source_calls: a computation that the graph does not order
//! stdout:
//| 1
/// Checks that a computation whose FIR size is not the size of the next component in the
/// callee-first order panics: its ledger would name another component.
import ownership_api;
import ownership_source_calls;
import ownership_source_calls_env;

fn main() i32 {
    string[2] text = {"fn noop() void {}", "fn calls_noop() void { noop(); }"};
    string[2] names = {"noop", "calls_noop"};
    ownership_source_calls_env.closure mut c = ownership_source_calls_env.closure{};
    ownership_source_calls_env.run(&c, text[..], names[..]);
    c.calls.begun = 0;
    ownership_api.limit_table mut limits = ownership_api.limit_table{};
    println(1);
    ownership_source_calls.begin(cast(&c.calls, void mut*), 12345, &limits);
    return 0;
}
