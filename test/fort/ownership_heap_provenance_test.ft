    "}",
    "fn after_stop() void {",
    "    i32 mut* own extra = new(i32);",
    "    stop();",
    "}",
    "fn unnamed() void {",
    "    i32 mut* own extra = new(i32);",
    "    bool mut b = false;",
    "    nothing();",
    "    if (b) { return; }",
    "    del(extra);",
    "}",
    "fn named_only() void {",
    "    i32 mut* own extra = new(i32);",
    "    bool mut b = false;",
