// Whether an event of body `name` names the leak of `what`: a lost ownership, or an incomplete
// proof of that ownership.
fn loses(ownership_heap_env.closure* c, string name, string what) bool {
    u32 declaration = cast(ownership_heap_env.index(c, name) + 1, u32);
    u64 mut i = 0;
    while (i < c->counts.events && i < c->counts.rows.len) {
        ownership_heap_env.event_row row = c->counts.rows[i];
        if (row.operation.function.declaration.declaration == declaration &&
            (row.kind == ownership_api.event_kind.lost_ownership ||
            row.kind == ownership_api.event_kind.incomplete_proof) &&
            ownership_heap_env.text(&row) == what) { return true; }
        i += 1;
    }
    return false;
}

fn returns(ownership_heap_env.closure* c, string name) bool {
    return ownership_heap_env.summary(c, name)->returns;
}

// The nullness fact of the owned caller slot of the exit state of `name`.
fn caller_owner(ownership_heap_env.closure* c, string name) ownership_facts.nullness {
    ownership_heap.summary* s = ownership_heap_env.summary(c, name);
    u64 mut i = 0;
    while (i < s->post.slots_len) {
        ownership_heap.slot item = s->post.slots[i];
        if (item.key.base == ownership_heap.base_kind.caller && item.owning) {
            assert(item.v.kind == ownership_heap.value_kind.empty);
            return item.v.nullness;
        }
        i += 1;
    }
    panic("no owned caller slot");
}

// a1 to a4 (`test/ownership/probes/round8_a*.ft`): an address computation reads no storage, so
// it gives no fact about its base (D17.18). The address of a cell that an unfold made has the
// assumed root of that cell, and the address of caller storage is a free choice of the caller:
// a null test of either decides nothing, and a leak on the null path stays.
fn addresses() void {
    println("addresses");
    ownership_heap_env.closure mut a1 = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&a1);
    string[3] names1 = {"drop_list", "first_addr", "local_addr"};
    ownership_heap_env.run(&a1, A1[..], names1[..]);
    assert(ownership_heap_env.proved(&a1, "drop_list"));
    // v is at offset 0, so q is null when n is null: `extra` leaks.
    assert(!ownership_heap_env.proved(&a1, "first_addr"));
    assert(loses(&a1, "first_addr", "extra"));
    // A dereference of a null constant is an invalid use.
    assert(!ownership_heap_env.proved(&a1, "local_addr"));
    assert(ownership_heap_env.first(&a1, "local_addr").kind ==
        ownership_api.event_kind.invalid_use);

    ownership_heap_env.closure mut a2 = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&a2);
    string[6] names2 = {"drop_list", "stop", "caller", "caller2", "child_addr", "whole_addr"};
    ownership_heap_env.run(&a2, A2[..], names2[..]);
    // A test of the address of n keeps both edges, so `stop` returns when n is null.
    assert(ownership_heap_env.proved(&a2, "stop") && returns(&a2, "stop"));
    assert(!ownership_heap_env.proved(&a2, "caller") && returns(&a2, "caller"));
    assert(loses(&a2, "caller", "extra"));
    assert(!ownership_heap_env.proved(&a2, "caller2") && returns(&a2, "caller2"));
    assert(loses(&a2, "caller2", "extra"));
    // The child of a new node is a null constant of the allocation: its field is no storage.
    assert(!ownership_heap_env.proved(&a2, "child_addr"));
    // `&*n` is the address of the cell of n.
    assert(!ownership_heap_env.proved(&a2, "whole_addr"));
    assert(loses(&a2, "whole_addr", "extra"));

    ownership_heap_env.closure mut a3 = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&a3);
    string[7] names3 = {"drop_list", "chk_addr", "join_addr", "loop_addr", "two_stop", "two_mid",
        "two_user"};
    ownership_heap_env.run(&a3, A3[..], names3[..]);
    // An assert that fails ends the process, so its null path holds no leak.
    assert(ownership_heap_env.proved(&a3, "chk_addr"));
    // A join of two addresses of one cell keeps the assumed fact of the cell.
    assert(!ownership_heap_env.proved(&a3, "join_addr"));
    assert(loses(&a3, "join_addr", "extra"));
    assert(!ownership_heap_env.proved(&a3, "loop_addr"));
    assert(loses(&a3, "loop_addr", "extra"));
    // No callee on the chain loses its return, so the caller keeps its path and its leak.
    assert(returns(&a3, "two_stop") && returns(&a3, "two_mid"));
    assert(!ownership_heap_env.proved(&a3, "two_user") && returns(&a3, "two_user"));
    assert(loses(&a3, "two_user", "extra"));

    ownership_heap_env.closure mut a4 = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&a4);
    string[3] names4 = {"drop_list", "chk_addr", "param_test"};
    ownership_heap_env.run(&a4, A4[..], names4[..]);
    // The assert passes for a null n, and `extra` leaks then.
    assert(!ownership_heap_env.proved(&a4, "chk_addr"));
    // A null test of a pointer to caller storage decides nothing: a parameter can be null.
    assert(!ownership_heap_env.proved(&a4, "param_test"));
    assert(loses(&a4, "param_test", "extra"));
}

// f1, f2 and f4 (`test/ownership/probes/review_f*.ft`) and d3. A graft imports each callee root
// fact, and an imported fact removes no caller path. The exit contradiction ends a caller path
// only when the callee's null and the caller's nonnull are both established.
fn calls() void {
    println("calls");
    ownership_heap_env.closure mut f1 = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&f1);
    string[3] names1 = {"addr_only", "caller_free", "caller_null"};
    ownership_heap_env.run(&f1, F1[..], names1[..]);
    assert(ownership_heap_env.proved(&f1, "addr_only") && returns(&f1, "addr_only"));
    // The exit root of n is the assumed root of an unfold.
    ownership_heap.summary* addr = ownership_heap_env.summary(&f1, "addr_only");
    assert(addr->post.atoms[0].root.value == ownership_facts.root_kind.nonnull);
    assert(addr->post.atoms[0].root.how == ownership_facts.provenance.assumed);
    assert(!ownership_heap_env.proved(&f1, "caller_free"));
    assert(loses(&f1, "caller_free", "extra"));
    assert(!ownership_heap_env.proved(&f1, "caller_null"));
    assert(loses(&f1, "caller_null", "extra"));

    ownership_heap_env.closure mut f2 = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&f2);
    string[5] names2 = {"addr_flat", "read_flat", "free_param", "null_flat", "read_null"};
    ownership_heap_env.run(&f2, F2[..], names2[..]);
    assert(ownership_heap_env.proved(&f2, "addr_flat") && ownership_heap_env.proved(&f2,
        "read_flat"));
    assert(!ownership_heap_env.proved(&f2, "free_param"));
    assert(loses(&f2, "free_param", "extra"));
    // An empty argument binds no callee atom: the result is an empty value that the caller
    // assumes, so its null test decides nothing.
    assert(!ownership_heap_env.proved(&f2, "null_flat"));
    assert(loses(&f2, "null_flat", "extra"));
    assert(!ownership_heap_env.proved(&f2, "read_null"));
    assert(loses(&f2, "read_null", "extra"));

    ownership_heap_env.closure mut f4 = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&f4);
    string[4] names4 = {"drop_list", "addr_only", "free_param", "null_local"};
    ownership_heap_env.run(&f4, F4[..], names4[..]);
    // The caller root of x takes the callee's assumed nonnull, so the null edge stays.
    assert(!ownership_heap_env.proved(&f4, "free_param"));
    assert(loses(&f4, "free_param", "extra"));
    assert(!ownership_heap_env.proved(&f4, "null_local"));

    ownership_heap_env.closure mut d3 = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&d3);
    string[12] names3 = {"drop_list", "need_null", "fresh_arg", "tested_arg", "unfolded_arg",
        "free_arg", "returned_arg", "fresh", "stop_box", "aggregate_stop", "stop_span",
        "span_stop"};
    ownership_heap_env.run(&d3, D3[..], names3[..]);
    // The test of n establishes its null root on the one returning path.
    assert(ownership_heap_env.proved(&d3, "need_null") && returns(&d3, "need_null"));
    ownership_heap.summary* need = ownership_heap_env.summary(&d3, "need_null");
    assert(need->post.atoms[0].root.value == ownership_facts.root_kind.null_root);
    assert(need->post.atoms[0].root.how == ownership_facts.provenance.established);
    // An allocation establishes a nonnull argument: the call does not return, and the leak of
    // `extra` after it is on no path.
    assert(ownership_heap_env.proved(&d3, "fresh_arg") && !returns(&d3, "fresh_arg"));
    assert(ownership_heap_env.proved(&d3, "aggregate_stop") &&
        !returns(&d3, "aggregate_stop"));
    assert(ownership_heap_env.events(&d3, "aggregate_stop") == 0);
    assert(ownership_heap_env.proved(&d3, "span_stop") && !returns(&d3, "span_stop"));
    assert(ownership_heap_env.events(&d3, "span_stop") == 0);
    // A test establishes n: its nonnull path ends at the call, and the null path returns.
    assert(ownership_heap_env.proved(&d3, "tested_arg") && returns(&d3, "tested_arg"));
    // An unfold only assumes the nonnull root of its cell: need_null(null) returns, and `extra`
    // leaks.
    assert(!ownership_heap_env.proved(&d3, "unfolded_arg") && returns(&d3, "unfolded_arg"));
    assert(loses(&d3, "unfolded_arg", "extra"));
    assert(!ownership_heap_env.proved(&d3, "free_arg") && returns(&d3, "free_arg"));
    // A callee result has an imported root, so the contradiction keeps the path.
    assert(ownership_heap_env.proved(&d3, "fresh"));
    assert(ownership_heap_env.summary(&d3, "fresh")->post.atoms[0].root.how ==
        ownership_facts.provenance.established);
    assert(!ownership_heap_env.proved(&d3, "returned_arg") && returns(&d3, "returned_arg"));
}

// A call that cannot return ends the assignment before the proof resolves its destination. Span
// and string results use the scalar assignment path although their values have two runtime words.
fn stopped_borrowed_results() void {
    println("stopped borrowed results");
    string[19] text = {
        "struct node { node mut* own next; i32 v; }",
        "struct holder { node mut* own p; }",
        "u8@ mut SPAN_OUT = {};",
        "string mut TEXT_OUT = {};",
        "fn stop_span(u8@ s) u8@ { panic(\"stop\"); }",
        "fn stop_text(string s) string { panic(\"stop\"); }",
        "fn span_plain(u8@ s) void { u8@ mut out = {}; out = stop_span(s); }",
        "fn text_plain(string s) void { string mut out = {}; out = stop_text(s); }",
        "fn span_local(u8@ s) void { node mut* own mut p = new(node);",
        "    u8@ mut* dst = cast(&p, u8@ mut*); *dst = stop_span(s); del(p); }",
        "fn span_field(holder mut* h, u8@ s) void {",
        "    u8@ mut* dst = cast(&h->p, u8@ mut*); *dst = stop_span(s); del(h->p); }",
        "fn text_local(string s) void { node mut* own mut p = new(node);",
        "    string mut* dst = cast(&p, string mut*); *dst = stop_text(s); del(p); }",
        "fn text_field(holder mut* h, string s) void {",
        "    string mut* dst = cast(&h->p, string mut*); *dst = stop_text(s); del(h->p); }",
        "fn span_global(u8@ s) void { SPAN_OUT = stop_span(s); }",
        "fn text_global(string s) void { TEXT_OUT = stop_text(s); }",
        "fn main() i32 { return 0; }",
    };
    string[11] names = {"stop_span", "stop_text", "span_plain", "text_plain", "span_local",
        "span_field", "text_local", "text_field", "span_global", "text_global", "main"};
    ownership_heap_env.closure mut c = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&c);
    ownership_heap_env.run(&c, text[..], names[..]);
    assert(ownership_heap_env.proved(&c, "stop_span") && !returns(&c, "stop_span"));
    assert(ownership_heap_env.proved(&c, "stop_text") && !returns(&c, "stop_text"));
    string[8] callers = {"span_plain", "text_plain", "span_local", "span_field", "text_local",
        "text_field", "span_global", "text_global"};
    u64 mut i = 0;
    while (i < callers.len) {
        assert(ownership_heap_env.proved(&c, callers[i]));
        assert(!returns(&c, callers[i]));
        assert(ownership_heap_env.events(&c, callers[i]) == 0);
        i += 1;
    }
}

// An established fact still removes a path: a test, a null constant, a move, an allocation and
// the address of a local or of an allocated cell.
fn kept() void {
    println("kept pruning");
    ownership_heap_env.closure mut c = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&c);
    string[9] names = {"drop_list", "twice", "null_constant", "moved_out", "allocated",
        "local_address", "allocated_field", "tested_field", "read_then_test"};
    ownership_heap_env.run(&c, KEPT[..], names[..]);
    u64 mut i = 0;
    while (i < 7) {
        assert(ownership_heap_env.proved(&c, names[i]));
        assert(ownership_heap_env.events(&c, names[i]) == 0 && returns(&c, names[i]));
        i += 1;
    }
    // Precision limit: an unfold assumes the nonnull root of its cell, also after a test that
    // established it. So the address of a field of a tested owner decides nothing.
    assert(!ownership_heap_env.proved(&c, "tested_field"));
    assert(loses(&c, "tested_field", "extra"));
    // A read through a null n is undefined behavior (D10.7), which the proof does not follow:
    // the dereference assumes the nonnull root, so the null edge stays with its leak.
    assert(!ownership_heap_env.proved(&c, "read_then_test"));
    assert(loses(&c, "read_then_test", "extra"));
}

// The probe `counted` (review of the typed facts): a block entry that a join only weakens runs
// again, so a loop that calls a callee publishes the provenance of one call.
fn counted() void {
    println("counted loops");
    ownership_heap_env.closure mut c = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&c);
    string[6] names = {"clear_first", "straight", "looped", "plain", "counted", "after"};
    ownership_heap_env.run(&c, COUNTED[..], names[..]);
    u64 mut i = 0;
    while (i < 5) {
        assert(ownership_heap_env.proved(&c, names[i]));
        assert(caller_owner(&c, names[i]).value == ownership_facts.root_kind.null_root);
        i += 1;
    }
    // A move establishes the null of the callee, and one call imports it.
    assert(caller_owner(&c, "clear_first").how == ownership_facts.provenance.established);
    assert(caller_owner(&c, "straight").how == ownership_facts.provenance.imported);
    // A loop head joins the null of the entry with the null of the back edge. The join of two
    // empty values assumes its null (`join_values`), and the weaker head runs again, so a loop
    // publishes no stronger fact than one call: with a call or without one.
    assert(caller_owner(&c, "looped").how == ownership_facts.provenance.assumed);
    assert(caller_owner(&c, "counted").how == ownership_facts.provenance.assumed);
    assert(caller_owner(&c, "plain").how == ownership_facts.provenance.assumed);
    // An imported null removes no path: the nonnull edge of the test keeps its leak.
    assert(!ownership_heap_env.proved(&c, "after"));
    assert(loses(&c, "after", "extra"));
}

fn atom_of(ownership_heap.state* s, ownership_heap.slot_key k) u32 {
    u64 at = ownership_heap.find_slot(s, k);
    assert(at != ownership_heap.U64_MAX && s->slots[at].v.kind == ownership_heap.value_kind.owned);
    return s->slots[at].v.atom;
}

fn field(u32 cell, u32 k) ownership_heap.slot_key {
    ownership_heap.slot_key mut key = ownership_heap.key_of(ownership_heap.base_kind.cell, cell);
    assert(ownership_heap.extend(&key, k));
    return key;
}

fn test_of(u32 a) ownership_heap.value {
    ownership_heap.value mut cond = ownership_heap.scalar_value();
    cond.test = a;
    cond.test_nonnull = true;
    return cond;
}

fn is_root(ownership_heap.atom a, ownership_facts.root_kind value,
    ownership_facts.provenance how) bool {
    return a.root.value == value && a.root.how == how;
}

// The two edges of `refine` one at a time (D17.18): only an established root removes an edge.
fn edges() void {
    println("edges");
    ownership_heap_env.closure mut c = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&c);
    string[2] names = {"host", "peek_fill"};
    ownership_heap_env.open(&c, EDGES[..], names[..]);
    ownership_heap.context mut ctx = ownership_heap.context{};
    ownership_heap_env.context_of(&c, "host", &ctx);
    defer ownership_heap.free_context(&ctx);
    ownership_heap.state mut s = ownership_heap.initial(&ctx);
    defer ownership_heap.free_state(&s);
    ownership_heap.value cond = test_of(0);
    // An unfold assumes a nonnull root. Its null edge stays, and the cell, its child region and
    // its payload take an established null root: on that edge they hold no allocation.
    ownership_heap.state mut cell = ownership_heap.clone(&s);
    defer ownership_heap.free_state(&cell);
    assert(ownership_heap.unfold(&ctx, &cell, 0));
    assert(is_root(cell.atoms[0], ownership_facts.root_kind.nonnull,
        ownership_facts.provenance.assumed));
    u32 next = atom_of(&cell, field(0, 0));
    u32 bytes = atom_of(&cell, field(0, 1));
    assert(cell.atoms[next].root.value == ownership_facts.root_kind.free);
    ownership_heap.state mut null_edge = ownership_heap.clone(&cell);
    defer ownership_heap.free_state(&null_edge);
    assert(ownership_heap.refine(&null_edge, cond, false));
    assert(is_root(null_edge.atoms[0], ownership_facts.root_kind.null_root,
        ownership_facts.provenance.established));
    assert(is_root(null_edge.atoms[next], ownership_facts.root_kind.null_root,
        ownership_facts.provenance.established));
    assert(is_root(null_edge.atoms[bytes], ownership_facts.root_kind.null_root,
        ownership_facts.provenance.established));
    // An atom that the cell does not own keeps its root.
    assert(is_root(null_edge.atoms[1], ownership_facts.root_kind.free,
        ownership_facts.provenance.assumed));
    // The established null now removes the nonnull edge, and the established nonnull of the
    // other edge removes the null edge.
    assert(!ownership_heap.refine(&null_edge, cond, true));
    ownership_heap.state mut nonnull_edge = ownership_heap.clone(&cell);
    defer ownership_heap.free_state(&nonnull_edge);
    assert(ownership_heap.refine(&nonnull_edge, cond, true));
    assert(is_root(nonnull_edge.atoms[0], ownership_facts.root_kind.nonnull,
        ownership_facts.provenance.established));
    assert(nonnull_edge.atoms[next].root.value == ownership_facts.root_kind.free);
    assert(!ownership_heap.refine(&nonnull_edge, cond, false));
    // A fold of the null cell keeps its null root; a fold of a nonnull cell assumes it.
    assert(ownership_heap.fold(&ctx, &null_edge, 0));
    assert(null_edge.atoms[0].kind == ownership_heap.atom_kind.region);
    assert(is_root(null_edge.atoms[0], ownership_facts.root_kind.null_root,
        ownership_facts.provenance.established));
    assert(ownership_heap.fold(&ctx, &nonnull_edge, 0));
    assert(is_root(nonnull_edge.atoms[0], ownership_facts.root_kind.nonnull,
        ownership_facts.provenance.assumed));
    // An assumed or imported root keeps both edges; each edge establishes its root.
    ownership_facts.root_kind[2] values = {ownership_facts.root_kind.null_root,
        ownership_facts.root_kind.nonnull};
    ownership_facts.provenance[3] hows = {ownership_facts.provenance.assumed,
        ownership_facts.provenance.imported, ownership_facts.provenance.established};
    u64 mut kept = 0;
    u64 mut i = 0;
    while (i < values.len) {
        u64 mut j = 0;
        while (j < hows.len) {
            bool mut k = false;
            while (true) {
                ownership_heap.state mut t = ownership_heap.clone(&s);
                t.atoms[1].root = ownership_facts.nullness{values[i], hows[j]};
                bool stays = ownership_heap.refine(&t, test_of(1), k);
                bool contrary = (values[i] == ownership_facts.root_kind.nonnull) != k;
                assert(stays == (!contrary || hows[j] != ownership_facts.provenance.established));
                if (stays) {
                    kept += 1;
                    assert(is_root(t.atoms[1], k ? ownership_facts.root_kind.nonnull :
                        ownership_facts.root_kind.null_root,
                        ownership_facts.provenance.established));
                }
                ownership_heap.free_state(&t);
                if (k) { break; }
                k = true;
            }
            j += 1;
        }
        i += 1;
    }
    // 12 edges: the 2 contrary edges of an established root go, the 10 others stay.
    assert(kept == 10);
    // A weaker provenance of a root or a status is a change of the atom.
    ownership_heap.atom base = s.atoms[1];
    ownership_heap.atom mut weak = base;
    assert(ownership_heap.same_atom(base, weak));
    weak.root.how = ownership_facts.provenance.imported;
    assert(!ownership_heap.same_atom(base, weak));
    weak = base;
    weak.status.how = ownership_facts.provenance.established;
    assert(!ownership_heap.same_atom(base, weak));
    ownership_heap.state mut weaker = ownership_heap.clone(&s);
    defer ownership_heap.free_state(&weaker);
    weaker.atoms[1].root.how = ownership_facts.provenance.imported;
    bool mut same = true;
    assert(ownership_heap.equal(&ctx, &s, &weaker, &same) && !same);
}

// A known scalar is a fact too (D17.18). A callee can write a scalar local whose storage a FIR
// address names, so each call forgets its value; a local that no address names keeps it.
fn scalars() void {
    println("known scalars");
    ownership_heap_env.closure mut c = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&c);
    string[12] names = {"set", "count", "clear", "nothing", "set_direct", "count_direct",
        "poked", "stop", "after_stop", "unnamed", "named_only", "written_here"};
    ownership_heap_env.run(&c, SCALARS[..], names[..]);
    // The callee writes the local through its address, and `extra` leaks on the written value.
    assert(!ownership_heap_env.proved(&c, "set_direct"));
    assert(loses(&c, "set_direct", "extra"));
    assert(!ownership_heap_env.proved(&c, "count_direct"));
    assert(loses(&c, "count_direct", "extra"));
    // An extern call writes what its pointer argument designates (D17.13).
    assert(!ownership_heap_env.proved(&c, "poked"));
    assert(loses(&c, "poked", "extra"));
    // `stop` returns because `clear` empties its flag, so its caller keeps its path and its leak.
    assert(ownership_heap_env.proved(&c, "stop") && returns(&c, "stop"));
    assert(!ownership_heap_env.proved(&c, "after_stop") && returns(&c, "after_stop"));
    assert(loses(&c, "after_stop", "extra"));
    // No address names b, so no callee can write it: the known false removes the early return.
    assert(ownership_heap_env.proved(&c, "unnamed"));
    assert(ownership_heap_env.events(&c, "unnamed") == 0);
    // A local that an address names loses its value at any call, also at a call that does not
    // take the address.
    assert(!ownership_heap_env.proved(&c, "named_only"));
    assert(loses(&c, "named_only", "extra"));
    // A store through the address after the call gives the value back.
    assert(ownership_heap_env.proved(&c, "written_here"));
    assert(ownership_heap_env.events(&c, "written_here") == 0);
}

// The frame of a call (D17.18). A callee can write each local whose storage a FIR address names,
// also through an address that an earlier call kept, and the storage that such a local reaches.
// So a call forgets each fact of that storage, and the paths that the fact removed come back.
// The obligations stay, and a local that no address names keeps its facts.
fn frame() void {
    println("address-taken frame");
    ownership_heap_env.closure mut c = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&c);
    string[55] names = {"stash_pp", "clear_pp", "stash_pair", "clear_pair", "keep_node",
        "take_node", "keep_peer", "clear_peer", "nothing", "touch", "fill", "fill_node",
        "stash_view", "clear_view", "clear_through", "stash_rr", "clear_rr", "addr_of",
        "pointer_local", "pointer_field", "owner_root", "owner_cell", "owner_link", "owner_empty",
        "view_cell", "struct_by_value", "returned_address", "unnamed_pointer", "through_pointer",
        "kept_owner", "kept_leak", "clear_arg", "copy_holder", "copy_holder_wrap",
        "escaped_then_fill", "retain_and_fill", "wrap_fill", "fill_nonempty",
        "keep_holder", "keep_holder_wrap", "pass_unknown", "pass_foreign",
        "retained_view", "retained_cleared_view",
        "retained_owner", "retained_view_write", "retained_join", "retained_residual",
        "retained_remap", "retained_param", "retained_param_caller", "retained_param_mixed",
        "retained_param_mixed_caller", "retained_param_choice", "retained_param_choice_caller"};
    ownership_heap_env.run(&c, FRAME[..], names[..]);
    // A callee with a complete proof clears a pointer local through a global, so the address
    // of the local keeps no fact over the call: the leak on the null path stays.
    assert(ownership_heap_env.proved(&c, "clear_pp"));
    assert(!ownership_heap_env.proved(&c, "pointer_local"));
    assert(loses(&c, "pointer_local", "extra"));
    // The same for a field of an address-taken struct.
    assert(ownership_heap_env.proved(&c, "clear_pair"));
    assert(!ownership_heap_env.proved(&c, "pointer_field"));
    assert(loses(&c, "pointer_field", "extra"));
    // A callee releases the owner through the kept address: its allocation root is assumed.
    assert(!ownership_heap_env.proved(&c, "owner_root"));
    assert(ownership_heap_env.summary(&c, "owner_root")->proof.terminal.reason ==
        ownership_api.incomplete_reason.unknown_effect);
    assert(loses(&c, "owner_root", "extra"));
    // A callee with a complete proof clears a field of the cell that the owner holds.
    assert(ownership_heap_env.proved(&c, "clear_peer"));
    assert(!ownership_heap_env.proved(&c, "owner_cell"));
    assert(loses(&c, "owner_cell", "extra"));
    // A scalar that tested the owner before the call establishes no root after it.
    assert(!ownership_heap_env.proved(&c, "owner_link"));
    assert(loses(&c, "owner_link", "extra"));
    // A callee fills an empty owner through the kept address: its null is assumed.
    assert(!ownership_heap_env.proved(&c, "owner_empty"));
    assert(ownership_heap_env.summary(&c, "owner_empty")->proof.terminal.reason ==
        ownership_api.incomplete_reason.unknown_effect);
    assert(loses(&c, "owner_empty", "extra"));
    // A pointer local views the cell, and the callee clears a field of the cell through the kept
    // address of the pointer.
    assert(ownership_heap_env.proved(&c, "clear_view"));
    assert(!ownership_heap_env.proved(&c, "view_cell"));
    assert(loses(&c, "view_cell", "extra"));
    // A by-value struct carries `&m->p` to a callee with a complete proof that clears the field:
    // the address marks the cell, so each call forgets its facts.
    assert(ownership_heap_env.proved(&c, "clear_through"));
    assert(!ownership_heap_env.proved(&c, "struct_by_value"));
    assert(loses(&c, "struct_by_value", "extra"));
    // A callee returns the address of a cell field into a pointer local whose address an earlier
    // call kept: the frame reaches the cell through the address that the local holds.
    assert(ownership_heap_env.proved(&c, "clear_rr") && ownership_heap_env.proved(&c, "addr_of"));
    assert(!ownership_heap_env.proved(&c, "returned_address"));
    assert(loses(&c, "returned_address", "extra"));
    // No address names q, so its established null removes the early return.
    assert(ownership_heap_env.proved(&c, "unnamed_pointer"));
    assert(ownership_heap_env.events(&c, "unnamed_pointer") == 0);
    // `&p->b` names the storage that p designates, not the storage of p.
    assert(ownership_heap_env.proved(&c, "through_pointer"));
    assert(ownership_heap_env.events(&c, "through_pointer") == 0);
    // The owner keeps its obligation over the call: a release proves and a leak stays.
    assert(ownership_heap_env.proved(&c, "kept_owner"));
    assert(!ownership_heap_env.proved(&c, "kept_leak"));
    assert(loses(&c, "kept_leak", "m"));
    // A mutable address stored through caller storage sets its parameter bit. A complete wrapper
    // propagates that bit through the matching argument.
    assert(ownership_heap_env.proved(&c, "copy_holder"));
    assert(ownership_heap_env.proved(&c, "copy_holder_wrap"));
    assert((ownership_heap_env.summary(&c, "copy_holder")->address_escapes & 4) == 4);
    assert((ownership_heap_env.summary(&c, "copy_holder_wrap")->address_escapes & 4) == 4);
    // The requirement uses the pre-frame placeholder. The fill effect uses its replacement.
    // The one incomplete requirement remains. The caller-storage effect creates no second event.
    assert(ownership_heap_env.unproved(&c, "escaped_then_fill",
        ownership_api.incomplete_reason.unknown_effect));
    assert(ownership_heap_env.events(&c, "escaped_then_fill") == 1);
    assert(ownership_heap_env.first_text(&c, "escaped_then_fill") ==
        "an empty owner that this call requires");
    // The frame cannot erase the empty-input requirement that `retain_and_fill` passes through
    // `wrap_fill`. A caller that supplies a nonempty owner must not prove.
    assert(ownership_heap_env.summary(&c, "wrap_fill")->required_some.len == 1);
    assert(!ownership_heap_env.proved(&c, "fill_nonempty"));
    assert((ownership_heap_env.summary(&c, "keep_node")->address_escapes & 2) == 2);
    assert((ownership_heap_env.summary(&c, "keep_holder")->address_escapes & 2) == 2);
    assert((ownership_heap_env.summary(&c, "keep_holder_wrap")->address_escapes & 2) == 2);
    assert((ownership_heap_env.summary(&c, "pass_unknown")->address_escapes & 2) == 2);
    assert(ownership_heap_env.summary(&c, "pass_foreign")->address_escapes == 0);
    assert(ownership_heap_env.summary(&c, "clear_arg")->address_escapes == 0);
    // The first call can retain the cell that q views. The second call reaches that cell after
    // the first frame clears q, so the possible clear of m->p keeps the leak path.
    assert(ownership_heap_env.proved(&c, "clear_arg"));
    assert(!ownership_heap_env.proved(&c, "retained_view"));
    assert(loses(&c, "retained_view", "extra"));
    // A local overwrite removes its retained target. The reached cell remains addressable.
    assert(!ownership_heap_env.proved(&c, "retained_cleared_view"));
    assert(loses(&c, "retained_cleared_view", "extra"));
    // The first call can retain the path to an empty owning local. A later unknown call can fill
    // that owner after the first frame clears the reference that led to it.
    assert(!ownership_heap_env.proved(&c, "retained_owner"));
    // A forgotten view still keeps the cell that it can designate.
    assert(!ownership_heap_env.proved(&c, "retained_view_write"));
    // A join keeps a target when one path has its address and one path forgot the address.
    assert(!ownership_heap_env.proved(&c, "retained_join"));
    // A residual target reaches each possible local and cell.
    assert(!ownership_heap_env.proved(&c, "retained_residual"));
    assert(loses(&c, "retained_residual", "extra"));
    // Canonical atom numbering also updates the retained cell target.
    assert(!ownership_heap_env.proved(&c, "retained_remap"));
    // A forgotten pointer keeps its parameter source. A later extern read makes the caller
    // prove that the designated allocation stays live. The copy of the forgotten pointer into
    // the extern call is a use of a reference whose facts the body lost (D17.14), so the body
    // gives incomplete proof at the copy.
    assert(ownership_heap_env.unproved(&c, "retained_param",
        ownership_api.incomplete_reason.unknown_effect));
    assert((ownership_heap_env.summary(&c, "retained_param")->view_reads & 2) == 2);
    assert(!ownership_heap_env.proved(&c, "retained_param_caller"));
    // A join of a forgotten parameter and its live view keeps the same parameter source.
    assert(ownership_heap_env.unproved(&c, "retained_param_mixed",
        ownership_api.incomplete_reason.unknown_effect));
    assert((ownership_heap_env.summary(&c, "retained_param_mixed")->view_reads & 2) == 2);
    assert(!ownership_heap_env.proved(&c, "retained_param_mixed_caller"));
    // Two forgotten inputs differ only by their parameter source. Their join reads both inputs.
    assert(ownership_heap_env.unproved(&c, "retained_param_choice",
        ownership_api.incomplete_reason.unknown_effect));
    assert((ownership_heap_env.summary(&c, "retained_param_choice")->view_reads & 6) == 6);
    assert(!ownership_heap_env.proved(&c, "retained_param_choice_caller"));
}

// A requirement makes the entry owner an assumed null, which removes no edge: the store over an
// empty owner proves, and the nonnull edge of a later test keeps its leak.
fn assumed_requirements() void {
    println("assumed requirements");
    ownership_heap_env.closure mut c = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&c);
    string[2] names = {"host", "peek_fill"};
    ownership_heap_env.run(&c, EDGES[..], names[..]);
    ownership_heap.summary* s = ownership_heap_env.summary(&c, "peek_fill");
    assert(s->interface.len == 1 && ownership_heap_env.requires(&c, "peek_fill",
        ownership_heap_env.root_requirement(0, ownership_facts.root_kind.null_root)));
    assert(!ownership_heap_env.proved(&c, "peek_fill"));
    assert(loses(&c, "peek_fill", "extra"));
}

fn caller_requirements(ownership_heap_env.closure* c, string name, ownership_api.certainty how)
    u64 {
    return ownership_heap_env.candidates(c, name, ownership_api.event_kind.caller_requirement,
        how);
}

fn requirement_events(ownership_heap_env.closure* c, string name) u64 {
    return ownership_heap_env.saw(c, name, ownership_api.event_kind.caller_requirement,
        ownership_api.evidence_kind.abstract_possibility);
}

fn nonnull_at(u32 entry, u32 depth, u32 field) ownership_facts.requirement {
    u32[6] mut path = {};
    path[0] = field;
    return ownership_heap_env.requirement(entry, depth, path,
        ownership_facts.root_kind.nonnull);
}

// d1, d2, f5 and f2 (`test/ownership/probes`): a callee that dereferences an owner, at the root or
// in an owned field, requires it nonnull, and a caller that passes a proved empty owner there
// fails that requirement (D10.7). The requirement is no fact: the call goes on, and each earlier
// event stays.
fn requirements() void {
    println("requirements");
    ownership_facts.root_kind full = ownership_facts.root_kind.nonnull;
    ownership_api.certainty definite = ownership_api.certainty.definite;
    ownership_api.certainty possible = ownership_api.certainty.possible;
    ownership_heap_env.closure mut d1 = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&d1);
    string[5] names1 = {"drop_list", "read_next", "read_root", "null_next", "null_root"};
    ownership_heap_env.run(&d1, D1[..], names1[..]);
    // read_next reads n->next->v: it requires n and n->next on each returning path.
    assert(ownership_heap_env.proved(&d1, "read_next"));
    assert(ownership_heap_env.requires_each(&d1, "read_next",
        ownership_heap_env.root_requirement(0, full)));
    assert(ownership_heap_env.requires_each(&d1, "read_next", nonnull_at(0, 1, 1)));
    assert(ownership_heap_env.summary(&d1, "read_next")->required_some.len == 2);
    // drop_list tests n before each read, so it requires nothing.
    assert(ownership_heap_env.summary(&d1, "drop_list")->required_some.len == 0);
    // A new node has an empty next field: a definite candidate at the call.
    assert(ownership_heap_env.candidate(&d1, "null_next",
        ownership_api.event_kind.caller_requirement));
    assert(caller_requirements(&d1, "null_next", definite) == 1);
    assert(ownership_heap_env.first(&d1, "null_next").line == 14);
    assert(ownership_heap_env.first_text(&d1, "null_next") ==
        "the empty owner that the callee dereferences");
    // The empty argument itself: a definite candidate, and the earlier event stays.
    assert(caller_requirements(&d1, "null_root", definite) == 1);
    assert(ownership_heap_env.events(&d1, "null_root") == 2);

    ownership_heap_env.closure mut d2 = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&d2);
    string[6] names2 = {"read_p", "read_p_borrow", "get_p", "null_field", "null_field_borrow",
        "null_field_get"};
    ownership_heap_env.run(&d2, D2[..], names2[..]);
    // An owned field of an owned parameter, and an owned leaf of caller storage.
    assert(ownership_heap_env.requires_each(&d2, "read_p", nonnull_at(0, 1, 0)));
    assert(ownership_heap_env.requires_each(&d2, "read_p_borrow",
        ownership_heap_env.root_requirement(0, full)));
    assert(ownership_heap_env.requires_each(&d2, "get_p", nonnull_at(0, 1, 0)));
    assert(caller_requirements(&d2, "null_field", definite) == 1);
    assert(caller_requirements(&d2, "null_field_borrow", definite) == 1);
    assert(ownership_heap_env.candidate(&d2, "null_field_borrow",
        ownership_api.event_kind.caller_requirement));
    assert(caller_requirements(&d2, "null_field_get", definite) == 1);
    assert(ownership_heap_env.candidate(&d2, "null_field_get",
        ownership_api.event_kind.caller_requirement));

    ownership_heap_env.closure mut f5 = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&f5);
    string[4] names5 = {"drop_list", "read_node", "null_read", "local_read"};
    ownership_heap_env.run(&f5, F5[..], names5[..]);
    assert(caller_requirements(&f5, "null_read", definite) == 1);
    // A dereference of its own empty local is an invalid use of the body, not a requirement.
    assert(ownership_heap_env.first(&f5, "local_read").kind ==
        ownership_api.event_kind.invalid_use);
    assert(requirement_events(&f5, "local_read") == 0);

    ownership_heap_env.closure mut f2 = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&f2);
    string[5] names_f2 = {"addr_flat", "read_flat", "free_param", "null_flat", "read_null"};
    ownership_heap_env.run(&f2, F2[..], names_f2[..]);
    // A flat owner is dereferenced without an unfold. Its leak stays an event of its own.
    assert(ownership_heap_env.requires_each(&f2, "read_flat",
        ownership_heap_env.root_requirement(0, full)));
    assert(caller_requirements(&f2, "read_null", definite) == 1);
    assert(loses(&f2, "read_null", "extra"));
    // An address computation reads no storage: addr_flat requires nothing (D17.18).
    assert(ownership_heap_env.summary(&f2, "addr_flat")->required_some.len == 0);
    assert(requirement_events(&f2, "null_flat") == 0);

    ownership_heap_env.closure mut c = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&c);
    string[15] names = {"drop_list", "read_root", "maybe", "maybe_null", "wrap", "wrap_null",
        "skip", "skip_short", "skip_long", "tested_next", "tested_null", "addr", "addr_null",
        "addr_read", "maybe_empty"};
    ownership_heap_env.run(&c, NEEDS[..], names[..]);
    // A requirement of some path only: the join of the two edges keeps it out of the exit
    // state, so the candidate is possible.
    assert(ownership_heap_env.requires(&c, "maybe", ownership_heap_env.root_requirement(0, full)));
    assert(!ownership_heap_env.requires_each(&c, "maybe",
        ownership_heap_env.root_requirement(0, full)));
    assert(caller_requirements(&c, "maybe_null", possible) == 1);
    assert(caller_requirements(&c, "maybe_null", definite) == 0);
    // An entry value of the caller passes the requirement on, with the path of the caller.
    assert(ownership_heap_env.proved(&c, "wrap"));
    assert(ownership_heap_env.requires_each(&c, "wrap",
        ownership_heap_env.root_requirement(0, full)));
    assert(caller_requirements(&c, "wrap_null", definite) == 1);
    // skip passes n->next to read_root, so it requires its own n->next: path [next].
    assert(ownership_heap_env.proved(&c, "skip"));
    assert(ownership_heap_env.requires_each(&c, "skip", nonnull_at(0, 1, 1)));
    assert(ownership_heap_env.requires_each(&c, "skip",
        ownership_heap_env.root_requirement(0, full)));
    assert(caller_requirements(&c, "skip_short", definite) == 1);
    assert(requirement_events(&c, "skip_long") == 0);
    // n->next is read only after a test of n, so an empty n holds: the callee reads no field of
    // it.
    assert(ownership_heap_env.requires(&c, "tested_next", nonnull_at(0, 1, 1)));
    assert(!ownership_heap_env.requires(&c, "tested_next",
        ownership_heap_env.root_requirement(0, full)));
    assert(requirement_events(&c, "tested_null") == 0);
    // &n->v reads no storage; a read after it requires n, though the address unfolded n.
    assert(ownership_heap_env.summary(&c, "addr")->required_some.len == 0);
    assert(requirement_events(&c, "addr_null") == 0);
    assert(ownership_heap_env.requires_each(&c, "addr_read",
        ownership_heap_env.root_requirement(0, full)));
    // An owner that is empty on one path only: a possible candidate.
    assert(caller_requirements(&c, "maybe_empty", possible) == 1);
    assert(caller_requirements(&c, "maybe_empty", definite) == 0);

    ownership_heap_env.closure mut l = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&l);
    string[4] names_l = {"nine", "many", "last_null", "first_null"};
    ownership_heap_env.run(&l, LISTS[..], names_l[..]);
    // The state keeps 8 requirements of each path, so the ninth is a requirement of some path.
    assert(ownership_heap_env.proved(&l, "nine"));
    assert(ownership_heap_env.summary(&l, "nine")->post.required.len == 8);
    assert(ownership_heap_env.requires_each(&l, "nine",
        ownership_heap_env.root_requirement(7, full)));
    assert(!ownership_heap_env.requires_each(&l, "nine",
        ownership_heap_env.root_requirement(8, full)));
    assert(ownership_heap_env.requires(&l, "nine", ownership_heap_env.root_requirement(8, full)));
    assert(caller_requirements(&l, "first_null", definite) == 1);
    assert(caller_requirements(&l, "last_null", possible) == 1);
    // The body keeps 16 requirements of some path; the seventeenth gives incomplete proof, and
    // no caller applies the summary.
    assert(ownership_heap_env.unproved(&l, "many", ownership_api.incomplete_reason.unknown_effect));
    assert(ownership_heap_env.summary(&l, "many")->residual);
    assert(ownership_heap_env.summary(&l, "many")->required_some.len == 16);

    ownership_heap_env.closure mut d = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&d);
    // An extern has no body, so it has no name here.
    string[12] names_d = {"drop_list", "put2", "put2_empty", "put2_full", "put2_short",
        "walk_all", "read_first", "wrap_first", "empty_first", "full_first", "set", "touched"};
    ownership_heap_env.run(&d, DEEP[..], names_d[..]);
    // put2 stores over n->next->next, an entry owner two fields down: it requires it empty, and
    // it requires n and n->next nonnull because it reads through them.
    u32[6] mut two = {};
    two[0] = 1;
    two[1] = 1;
    assert(ownership_heap_env.proved(&d, "put2"));
    assert(ownership_heap_env.requires_each(&d, "put2", ownership_heap_env.requirement(0, 2, two,
        ownership_facts.root_kind.null_root)));
    assert(ownership_heap_env.requires_each(&d, "put2", nonnull_at(0, 1, 1)));
    // FIR stores through the address of the field, so the store requires the cell n->next.
    assert(ownership_heap_env.summary(&d, "put2")->required_some.len == 3);
    assert(requirement_events(&d, "put2_empty") == 0);
    // A full grandchild fails the empty requirement: a definite candidate, and the lost owner
    // stays allocated, so no later event repeats it.
    assert(caller_requirements(&d, "put2_full", definite) == 1);
    assert(ownership_heap_env.first_text(&d, "put2_full") ==
        "an empty owned field that this call requires");
    // An empty child fails the read of it; the empty requirement below it holds.
    assert(caller_requirements(&d, "put2_short", definite) == 1);
    assert(ownership_heap_env.first_text(&d, "put2_short") ==
        "the empty owner that the callee dereferences");
    // A recursive callee that reads without a test passes its requirement one field deeper each
    // round. At depth 6 the path ends, and the next recursive call gives a possible candidate.
    u32[6] mut six = {1, 1, 1, 1, 1, 1};
    assert(ownership_heap_env.requires_each(&d, "walk_all",
        ownership_heap_env.root_requirement(0, full)));
    assert(ownership_heap_env.requires(&d, "walk_all", nonnull_at(0, 1, 1)));
    assert(ownership_heap_env.requires(&d, "walk_all", ownership_heap_env.requirement(0, 6, six,
        full)));
    assert(!ownership_heap_env.proved(&d, "walk_all"));
    assert(caller_requirements(&d, "walk_all", possible) >= 1);
    // An owned leaf of caller storage: wrap_first passes the requirement of read_first on, and
    // an empty field of the caller's holder fails it.
    assert(ownership_heap_env.proved(&d, "wrap_first"));
    assert(ownership_heap_env.requires_each(&d, "wrap_first",
        ownership_heap_env.root_requirement(0, full)));
    assert(caller_requirements(&d, "empty_first", definite) == 1);
    assert(requirement_events(&d, "full_first") == 0);
    // An owner of unknown status cannot meet an empty requirement: incomplete proof, and the
    // owner leaves the proof.
    assert(loses(&d, "touched", "an empty owner that this call requires"));
    assert(requirement_events(&d, "touched") == 0);

    // An owner without an entry path has no requirement that a summary can name: the callee
    // keeps its proof and marks its input lost, and its caller gets incomplete proof.
    ownership_heap_env.closure mut lost = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&lost);
    string[10] names_lost = {"drop_list", "read7", "null7", "either", "either_null", "fold_read",
        "fold_null", "test_join", "test_null", "tested_store"};
    ownership_heap_env.run(&lost, LOST[..], names_lost[..]);
    string[3] callees = {"read7", "either", "fold_read"};
    string[3] callers = {"null7", "either_null", "fold_null"};
    u64 mut k = 0;
    while (k < 3) {
        assert(ownership_heap_env.proved(&lost, callees[k]));
        assert(ownership_heap_env.summary(&lost, callees[k])->lost_required == 1);
        assert(ownership_heap_env.unproved(&lost, callers[k],
            ownership_api.incomplete_reason.missing_graph));
        assert(ownership_heap_env.first_text(&lost, callers[k]) ==
            "an owner that the callee accesses without its entry path");
        k += 1;
    }
    // read7 still requires the 7 owners down to depth 6 by name.
    assert(ownership_heap_env.summary(&lost, "read7")->post.required.len == 7);
    // A test of the joined owner establishes its root: nothing is lost, and the caller proves.
    assert(ownership_heap_env.summary(&lost, "test_join")->lost_required == 0);
    assert(ownership_heap_env.proved(&lost, "test_join"));
    assert(ownership_heap_env.proved(&lost, "test_null"));
    // A store after a test goes through an address: the test covers the root, so the store
    // requires nothing although the unfold of the address assumed the root.
    assert(ownership_heap_env.proved(&lost, "tested_store"));
    assert(ownership_heap_env.summary(&lost, "tested_store")->required_some.len == 0);
    assert(ownership_heap_env.summary(&lost, "tested_store")->lost_required == 0);

    ownership_heap_env.closure mut repairs = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&repairs);
    string[21] repair_names = {"drop_list", "read_b", "addr_then", "null_addr_then", "touch",
        "touched", "null_touched", "child_view", "null_child_view", "read_root", "addr_pass",
        "null_addr_pass", "read_next", "addr_pass_next", "null_addr_pass_next", "addr_arg",
        "null_addr_arg", "null_borrow", "maybe_cut", "after_cut", "caller_cut"};
    ownership_heap_env.run(&repairs, REPAIRS[..], repair_names[..]);
    string[6] candidates = {"null_addr_then", "null_child_view", "null_addr_pass",
        "null_addr_pass_next", "null_addr_arg", "null_borrow"};
    k = 0;
    while (k < candidates.len) {
        assert(!ownership_heap_env.proved(&repairs, candidates[k]));
        assert(requirement_events(&repairs, candidates[k]) == 1);
        k += 1;
    }
    assert(ownership_heap_env.unproved(&repairs, "null_touched",
        ownership_api.incomplete_reason.missing_graph));
    // A callee that changes the parent ends its entry identity. A later member access is lost.
    assert(ownership_heap_env.proved(&repairs, "after_cut"));
    assert(ownership_heap_env.summary(&repairs, "after_cut")->lost_required == 1);
    assert(ownership_heap_env.unproved(&repairs, "caller_cut",
        ownership_api.incomplete_reason.missing_graph));

    ownership_heap_env.closure mut review2 = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&review2);
    string[17] names_review2 = {"read_release_read", "joined_caller", "index_slice",
        "stale_index", "addr_only", "null_addr_only", "addr_use", "null_addr_use",
        "field_only", "null_field_only", "field_use", "null_field_use", "forward_unknown",
        "null_forward_unknown", "field_addr", "returned_field_use", "null_returned_field_use"};
    ownership_heap_env.run(&review2, REVIEW2[..], names_review2[..]);
    // The join of an accessed owner with its empty side loses the entry path and its cover.
    assert(ownership_heap_env.proved(&review2, "read_release_read"));
    assert(ownership_heap_env.summary(&review2, "read_release_read")->lost_required == 1);
    assert(ownership_heap_env.unproved(&review2, "joined_caller",
        ownership_api.incomplete_reason.missing_graph));
    // Slice creation reads nothing. Its later index reads the cell and needs it live.
    assert(ownership_heap_env.proved(&review2, "index_slice"));
    assert(ownership_heap_env.requires_each(&review2, "index_slice",
        ownership_heap_env.root_requirement(0, full)));
    assert(ownership_heap_env.candidate(&review2, "stale_index",
        ownership_api.event_kind.invalid_use));
    // &*p reads no designated storage, so a null caller proves. The address keeps its source,
    // so a later access records the caller read.
    assert(ownership_heap_env.proved(&review2, "addr_only"));
    assert(ownership_heap_env.summary(&review2, "addr_only")->view_reads == 0);
    assert(ownership_heap_env.proved(&review2, "null_addr_only"));
    assert(ownership_heap_env.proved(&review2, "addr_use"));
    assert((ownership_heap_env.summary(&review2, "addr_use")->view_reads & 2) == 2);
    assert(!ownership_heap_env.proved(&review2, "null_addr_use"));
    assert(requirement_events(&review2, "null_addr_use") == 1);
    assert(ownership_heap_env.proved(&review2, "field_only"));
    assert(ownership_heap_env.summary(&review2, "field_only")->view_reads == 0);
    assert(ownership_heap_env.proved(&review2, "null_field_only"));
    assert(ownership_heap_env.proved(&review2, "field_use"));
    assert((ownership_heap_env.summary(&review2, "field_use")->view_reads & 2) == 2);
    assert(!ownership_heap_env.proved(&review2, "null_field_use"));
    assert(requirement_events(&review2, "null_field_use") == 1);
    // An extern can read through its argument. The wrapper records that read for its caller.
    assert(ownership_heap_env.proved(&review2, "forward_unknown"));
    assert((ownership_heap_env.summary(&review2, "forward_unknown")->view_reads & 2) == 2);
    assert(!ownership_heap_env.proved(&review2, "null_forward_unknown"));
    assert(requirement_events(&review2, "null_forward_unknown") == 1);
    // A returned field address keeps the source of the argument after summary translation.
    assert(ownership_heap_env.proved(&review2, "field_addr"));
    assert(ownership_heap_env.summary(&review2, "field_addr")->view_reads == 0);
    assert(ownership_heap_env.proved(&review2, "returned_field_use"));
    assert((ownership_heap_env.summary(&review2, "returned_field_use")->view_reads & 2) == 2);
    assert(!ownership_heap_env.proved(&review2, "null_returned_field_use"));
    assert(requirement_events(&review2, "null_returned_field_use") == 1);
}

fn main() i32 {
    addresses();
    calls();
    stopped_borrowed_results();
    kept();
    counted();
    edges();
    assumed_requirements();
    scalars();
    requirements();
    frame();
    println("heap provenance ok");
    return 0;
}
