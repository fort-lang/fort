// The counted probe.
string[12] COUNTED = {
    "struct node { i32 v; }",
    "struct holder { node mut* own first; }",
    "fn clear_first(holder mut* h) void { del(move(h->first)); }",
    "fn straight(holder mut* h) void { del(move(h->first)); h->first = null; clear_first(h); }",
    "fn looped(holder mut* h, i32 n) void { del(move(h->first)); h->first = null;",
    "    i32 mut i = 0; while (i < n) { clear_first(h); i += 1; } }",
    "fn plain(holder mut* h, i32 n) void { del(move(h->first)); h->first = null;",
    "    i32 mut i = 0; while (i < n) { i += 1; } }",
    "fn counted(holder mut* h, i32 mut* n) void { del(move(h->first)); h->first = null;",
    "    while (*n > 0) { clear_first(h); *n -= 1; } }",
    "fn after(holder mut* h) void { clear_first(h);",
    "    if (h->first != null) { i32 mut* own extra = new(i32); } }",
};

// Known scalars across calls.
string[60] SCALARS = {
    "extern fn poke(bool mut* p) void;",
    "fn set(bool mut* p) void { *p = true; }",
    "fn count(i32 mut* p) void { *p = 1; }",
    "fn clear(bool mut* p) void { *p = false; }",
    "fn nothing() void { }",
    "fn set_direct() void {",
    "    i32 mut* own extra = new(i32);",
    "    bool mut b = false;",
    "    set(&b);",
    "    if (b) { return; }",
    "    del(extra);",
    "}",
    "fn count_direct() void {",
    "    i32 mut* own extra = new(i32);",
    "    i32 mut k = 0;",
    "    count(&k);",
    "    if (k == 1) { return; }",
    "    del(extra);",
    "}",
    "fn poked() void {",
    "    i32 mut* own extra = new(i32);",
    "    bool mut b = false;",
