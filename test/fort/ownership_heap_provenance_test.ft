    "    if (b) { return; }",
    "    del(extra);",
    "}",
    "fn written_here() void {",
    "    i32 mut* own extra = new(i32);",
    "    bool mut b = false;",
    "    bool mut* p = &b;",
    "    nothing();",
    "    *p = false;",
    "    if (b) { return; }",
