//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| addresses
//| calls
//| stopped borrowed results
//| kept pruning
//| counted loops
//| edges
//| assumed requirements
//| known scalars
//| requirements
//| address-taken frame
//| heap provenance ok
/// Checks that only an established fact removes a path of the heap proof (D17.18, rule P1): a
/// null test, both edges of a refinement, and the exit contradiction of a call.
import ownership_api;
import ownership_facts;
import ownership_heap;
import ownership_heap_env;

// Round8_a1.
string[18] A1 = {
    "struct node { i32 v; node mut* own next; }",
    "fn drop_list(node mut* own n) void { if (n == null) { return; }",
    "    drop_list(move(n->next)); del(n); }",
    "fn first_addr(node mut* own n) void {",
    "    i32 mut* own extra = new(i32);",
    "    i32 mut* q = &n->v;",
    "    if (q == null) { return; }",
    "    del(extra);",
    "    drop_list(move(n));",
    "}",
    "fn local_addr() void {",
    "    i32 mut* own extra = new(i32);",
    "    node mut* own n = null;",
    "    i32 mut* q = &n->v;",
    "    if (q == null) { return; }",
    "    del(extra);",
    "    drop_list(move(n));",
    "}",
};

// Round8_a2.
string[33] A2 = {
    "struct node { i32 v; node mut* own next; }",
    "fn drop_list(node mut* own n) void { if (n == null) { return; }",
    "    drop_list(move(n->next)); del(n); }",
    "fn stop(node mut* own n) node mut* own {",
    "    i32 mut* q = &n->v;",
    "    if (q != null) { panic(\"stop\"); }",
    "    return move(n);",
    "}",
    "fn caller() void {",
    "    i32 mut* own extra = new(i32);",
    "    node mut* own y = stop(null);",
    "    drop_list(move(y));",
    "}",
    "fn caller2(node mut* own x) void {",
    "    i32 mut* own extra = new(i32);",
    "    node mut* own y = stop(move(x));",
    "    drop_list(move(y));",
    "}",
    "fn child_addr() void {",
    "    i32 mut* own extra = new(i32);",
    "    node mut* own n = new(node);",
    "    i32 mut* q = &n->next->v;",
    "    if (q == null) { del(n); return; }",
    "    del(extra);",
    "    drop_list(move(n));",
    "}",
    "fn whole_addr(node mut* own n) void {",
    "    i32 mut* own extra = new(i32);",
    "    node mut* r = &*n;",
    "    if (r == null) { return; }",
    "    del(extra);",
    "    drop_list(move(n));",
    "}",
};

// Round8_a3.
string[40] A3 = {
    "struct node { i32 v; node mut* own next; }",
    "fn drop_list(node mut* own n) void { if (n == null) { return; }",
    "    drop_list(move(n->next)); del(n); }",
    "fn chk_addr(node mut* own n) void {",
    "    i32 mut* own extra = new(i32);",
    "    i32 mut* q = &n->v;",
    "    assert(q != null);",
    "    del(extra);",
    "    drop_list(move(n));",
    "}",
    "fn join_addr(node mut* own n, bool f) void {",
    "    i32 mut* own extra = new(i32);",
    "    i32 mut* mut q = null;",
    "    if (f) { q = &n->v; } else { q = &n->v; }",
    "    if (q == null) { drop_list(move(n)); return; }",
    "    del(extra);",
    "    drop_list(move(n));",
    "}",
    "fn loop_addr(node mut* own n, i32 k) void {",
    "    i32 mut* own extra = new(i32);",
    "    i32 mut i = 0;",
    "    while (i < k) {",
    "        i32 mut* q = &n->v;",
    "        if (q == null) { drop_list(move(n)); return; }",
    "        i += 1;",
    "    }",
    "    del(extra);",
    "    drop_list(move(n));",
    "}",
    "fn two_stop(node mut* own n) node mut* own {",
    "    i32 mut* q = &n->v;",
    "    if (q != null) { panic(\"stop\"); }",
    "    return move(n);",
    "}",
    "fn two_mid(node mut* own n) node mut* own { return two_stop(move(n)); }",
    "fn two_user() void {",
    "    i32 mut* own extra = new(i32);",
    "    node mut* own y = two_mid(null);",
    "    drop_list(move(y));",
    "}",
};

