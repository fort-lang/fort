// The exit contradiction of main.
string[44] D3 = {
    "struct node { node mut* own next; i32 v; }",
    "struct box { node mut* own item; }",
    "fn drop_list(node mut* own n) void { if (n == null) { return; }",
    "    drop_list(move(n->next)); del(n); }",
    "fn need_null(node mut* own n) node mut* own {",
    "    if (n != null) { panic(\"need\"); }",
    "    return move(n);",
    "}",
    "fn fresh_arg() void {",
    "    i32 mut* own extra = new(i32);",
    "    node mut* own y = need_null(new(node));",
    "    drop_list(move(y));",
    "}",
    "fn tested_arg(node mut* own n) void {",
    "    if (n == null) { return; }",
    "    i32 mut* own extra = new(i32);",
    "    node mut* own y = need_null(move(n));",
    "    drop_list(move(y));",
    "}",
    "fn unfolded_arg(node mut* own n) void {",
    "    i32 mut* own extra = new(i32);",
    "    i32 mut* q = &n->v;",
    "    node mut* own y = need_null(move(n));",
    "    drop_list(move(y));",
    "}",
    "fn free_arg(node mut* own n) void {",
    "    i32 mut* own extra = new(i32);",
    "    node mut* own y = need_null(move(n));",
    "    drop_list(move(y));",
    "}",
    "fn returned_arg() void {",
    "    i32 mut* own extra = new(i32);",
    "    node mut* own y = need_null(fresh());",
    "    drop_list(move(y));",
    "}",
    "fn fresh() node mut* own { return new(node); }",
    "fn stop_box() box { panic(\"stop\"); }",
    "fn aggregate_stop() void {",
    "    node mut* own mut p = new(node); box mut* dst = cast(&p, box mut*);",
    "    *dst = stop_box(); del(p);",
    "}",
    "fn stop_span(u8@ s) u8@ { panic(\"stop\"); }",
    "fn span_stop(u8@ s) void { node mut* own mut p = new(node);",
    "    u8@ mut* dst = cast(&p, u8@ mut*); *dst = stop_span(s); del(p); }",
};

