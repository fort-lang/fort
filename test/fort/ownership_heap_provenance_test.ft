    "    return move(n);",
    "}",
    "fn caller() void {",
    "    i32 mut* own extra = new(i32);",
    "    node mut* own y = stop(null);",
    "    drop_list(move(y));",
    "}",
    "fn caller2(node mut* own x) void {",
    "    i32 mut* own extra = new(i32);",
    "    node mut* own y = stop(move(x));",
    "    drop_list(move(y));",
    "}",
    "fn child_addr() void {",
    "    i32 mut* own extra = new(i32);",
    "    node mut* own n = new(node);",
    "    i32 mut* q = &n->next->v;",
