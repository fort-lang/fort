    "}",
};

// The frame of a call.
string[295] FRAME = {
    "struct pair { i32 mut* a; i32 b; }",
    "struct node { i32 v; node mut* own next; }",
    "struct peer { i32 v; i32 mut* p; }",
    "struct node_holder { node mut* own mut* pp; }",
    "struct holder { i32 mut* mut* pp; }",
    "struct peer_holder { peer mut* own mut* pp; }",
    "i32 mut* mut* mut saved = null;",
    "pair mut* mut saved_pair = null;",
    "node mut* own mut* mut saved_node = null;",
    "peer mut* own mut* mut saved_peer = null;",
    "fn stash_pp(i32 mut* mut* pp) void { saved = pp; }",
    "fn clear_pp() void { *saved = null; }",
    "fn stash_pair(pair mut* p) void { saved_pair = p; }",
    "fn clear_pair() void { saved_pair->a = null; }",
    "fn keep_node(node_holder* h) void { saved_node = h->pp; }",
    "fn take_node() void { if (saved_node != null) { del(*saved_node); } }",
    "fn keep_peer(peer_holder* h) void { saved_peer = h->pp; }",
    "fn clear_peer() void { (*saved_peer)->p = null; }",
    "fn nothing() void { }",
    "fn touch(i32 mut* p) void { *p = 1; }",
    "fn fill(node mut* own mut* out) void { *out = new(node); }",
    "peer mut* mut* mut saved_view = null;",
    "fn fill_node() void {",
    "    if (saved_node != null && *saved_node == null) { *saved_node = new(node); } }",
    "fn stash_view(peer mut* mut* pp) void { saved_view = pp; }",
    "fn clear_view() void { (*saved_view)->p = null; }",
    "fn clear_through(holder h) void { *h.pp = null; }",
    "fn clear_arg(peer mut* p) void { p->p = null; }",
    "fn copy_holder(node_holder mut* dst, node_holder* src) void { dst->pp = src->pp; }",
    "fn copy_holder_wrap(node_holder mut* dst, node_holder* src) void { copy_holder(dst, src); }",
    "fn escaped_then_fill() void {",
    "    node mut* own mut m = null;",
    "    node_holder mut src = node_holder{};",
    "    node_holder mut dst = node_holder{};",
    "    src.pp = &m;",
    "    copy_holder(&dst, &src);",
    "    fill(&m);",
    "    del(m);",
    "}",
    "fn retain_and_fill(node mut* own mut* out, node_holder mut* h) void {",
    "    h->pp = out;",
    "    fill(out);",
    "}",
    "fn wrap_fill(node mut* own mut out, node_holder mut* h) void {",
    "    retain_and_fill(&out, h); del(out); }",
    "fn fill_nonempty() void {",
    "    node mut* own value = new(node); node_holder mut h = node_holder{};",
    "    wrap_fill(move(value), &h); }",
    "fn keep_holder(holder h) void { saved = h.pp; }",
    "fn keep_holder_wrap(holder h) void { keep_holder(h); }",
    "fn pass_unknown(i32 mut* p, fn (i32 mut*) void f) void { f(p); }",
    "extern fn foreign_write(i32 mut* p) void;",
    "fn pass_foreign(i32 mut* p) void { foreign_write(p); }",
    "i32 mut* mut* mut* mut saved_rr = null;",
    "fn stash_rr(i32 mut* mut* mut* pp) void { saved_rr = pp; }",
    "fn clear_rr() void { **saved_rr = null; }",
    "fn addr_of(peer mut* p) i32 mut* mut* { return &p->p; }",
    "fn pointer_local() void {",
    "    i32 mut* own extra = new(i32);",
    "    i32 mut x = 1;",
    "    i32 mut* mut q = null;",
    "    stash_pp(&q);",
    "    q = &x;",
    "    clear_pp();",
    "    if (q != null) { del(extra); return; }",
    "}",
    "fn pointer_field() void {",
    "    i32 mut* own extra = new(i32);",
    "    i32 mut x = 1;",
    "    pair mut pr = pair{};",
    "    stash_pair(&pr);",
    "    pr.a = &x;",
    "    clear_pair();",
    "    if (pr.a != null) { del(extra); return; }",
    "}",
    "fn owner_root() void {",
    "    i32 mut* own extra = new(i32);",
    "    node mut* own mut m = new(node);",
    "    node_holder mut h = node_holder{};",
    "    h.pp = &m;",
    "    keep_node(&h);",
    "    take_node();",
    "    if (m == null) { return; }",
    "    del(m);",
    "    del(extra);",
    "}",
    "fn owner_cell() void {",
    "    i32 mut* own extra = new(i32);",
    "    i32 mut x = 1;",
    "    peer mut* own mut m = new(peer);",
    "    m->p = &x;",
    "    peer_holder mut h = peer_holder{};",
    "    h.pp = &m;",
    "    keep_peer(&h);",
    "    clear_peer();",
    "    if (m->p != null) { del(extra); }",
    "    m->p = null;",
    "    del(m);",
    "}",
    "fn owner_link() void {",
    "    i32 mut* own extra = new(i32);",
    "    node mut* own mut m = new(node);",
    "    node_holder mut h = node_holder{};",
    "    h.pp = &m;",
    "    keep_node(&h);",
    "    bool t = m == null;",
    "    take_node();",
    "    if (t) { del(extra); del(m); return; }",
    "    if (m == null) { return; }",
    "    del(extra);",
    "    del(m);",
    "}",
    "fn owner_empty() void {",
    "    i32 mut* own extra = new(i32);",
    "    node mut* own mut m = null;",
    "    node_holder mut h = node_holder{};",
    "    h.pp = &m;",
    "    keep_node(&h);",
    "    fill_node();",
    "    if (m == null) { del(extra); return; }",
    "    del(m);",
    "}",
    "fn view_cell() void {",
    "    i32 mut* own extra = new(i32);",
    "    i32 mut x = 1;",
    "    peer mut* own m = new(peer);",
    "    m->p = &x;",
    "    peer mut* mut q = m;",
    "    stash_view(&q);",
    "    clear_view();",
    "    if (m->p != null) { del(extra); }",
    "    m->p = null;",
    "    del(m);",
    "}",
    "fn struct_by_value() void {",
    "    i32 mut* own extra = new(i32);",
    "    i32 mut x = 1;",
    "    peer mut* own m = new(peer);",
    "    m->p = &x;",
    "    holder mut h = holder{};",
    "    h.pp = &m->p;",
    "    clear_through(h);",
    "    if (m->p != null) { del(extra); }",
    "    m->p = null;",
    "    del(m);",
    "}",
    "fn returned_address() void {",
    "    i32 mut* own extra = new(i32);",
    "    i32 mut x = 1;",
    "    peer mut* own m = new(peer);",
    "    i32 mut* mut* mut r = null;",
    "    stash_rr(&r);",
    "    r = addr_of(m);",
    "    m->p = &x;",
    "    clear_rr();",
    "    if (m->p != null) { del(extra); }",
    "    m->p = null;",
    "    del(m);",
    "}",
    "fn unnamed_pointer() void {",
    "    i32 mut* own extra = new(i32);",
    "    i32 mut* q = null;",
    "    nothing();",
    "    if (q != null) { return; }",
    "    del(extra);",
    "}",
    "fn through_pointer() void {",
    "    i32 mut* own extra = new(i32);",
    "    pair mut pr = pair{};",
    "    pair mut* p = &pr;",
    "    touch(&p->b);",
    "    nothing();",
    "    if (p == null) { return; }",
    "    del(extra);",
    "}",
    "fn kept_owner() void {",
    "    node mut* own mut m = null;",
    "    fill(&m);",
    "    nothing();",
    "    del(m);",
    "}",
    "fn kept_leak() void {",
    "    node mut* own mut m = null;",
    "    fill(&m);",
    "    nothing();",
    "}",
    "fn retained_view(fn (peer mut*) void f) void {",
    "    i32 mut* own extra = new(i32);",
    "    i32 mut x = 1;",
    "    peer mut* own m = new(peer);",
    "    peer mut* mut q = m;",
    "    peer mut* mut* address = &q;",
    "    nothing();",
    "    m->p = &x;",
    "    f(q);",
    "    if (m->p != null) { del(extra); }",
    "    m->p = null;",
    "    del(m);",
    "}",
    "fn retained_cleared_view() void {",
    "    i32 mut* own extra = new(i32);",
    "    i32 mut x = 1;",
    "    peer mut* own m = new(peer);",
    "    peer mut* mut q = m;",
    "    peer mut* mut* address = &q;",
    "    nothing();",
    "    q = null;",
    "    m->p = &x;",
    "    nothing();",
    "    if (m->p != null) { del(extra); }",
    "    m->p = null;",
    "    del(m);",
    "}",
    "fn retained_owner(fn (node mut* own mut*) void f) void {",
    "    node mut* own mut p = null;",
    "    node mut* own mut* mut q = &p;",
    "    node mut* own mut* mut* address = &q;",
    "    nothing();",
    "    f(q);",
    "}",
    "fn retained_view_write(fn (node mut*) void f) void {",
    "    node mut* own p = new(node);",
    "    node mut* mut q = p;",
    "    node mut* mut* address = &q;",
    "    nothing();",
    "    f(q);",
    "    del(p);",
    "}",
    "fn retained_join(bool flag, fn (node mut* own mut*) void f) void {",
    "    node mut* own mut p = null;",
    "    node mut* own mut* mut q = &p;",
    "    node mut* own mut* mut* address = &q;",
    "    if (flag) { nothing(); }",
    "    f(q);",
    "}",
    "fn retained_residual(bool flag) void {",
    "    i32 mut* own extra = new(i32);",
    "    i32 mut x = 1;",
    "    peer mut local = peer{};",
    "    peer mut* own m = new(peer);",
    "    peer mut* mut q = null;",
    "    peer mut* mut* address = &q;",
    "    if (flag) { q = &local; } else { q = m; }",
    "    m->p = &x;",
    "    nothing();",
    "    if (m->p != null) { del(extra); }",
    "    m->p = null;",
    "    del(m);",
    "}",
    "fn retained_remap(bool flag, fn (node mut*) void f) void {",
    "    node mut* own first = new(node);",
    "    node mut* own second = new(node);",
    "    node mut* mut q = second;",
    "    node mut* mut* address = &q;",
    "    nothing();",
    "    del(first);",
    "    if (flag) { second->v = 1; } else { second->v = 2; }",
    "    f(q);",
    "    del(second);",
    "}",
    "extern fn foreign_read(i32* p) void;",
    "fn retained_param(i32* p, bool flag) void {",
    "    i32* mut q = p;",
    "    i32* mut* address = &q;",
    "    nothing();",
    "    i32 mut marker = 0;",
    "    if (flag) { marker = 1; } else { marker = 2; }",
    "    foreign_read(q);",
    "}",
    "fn retained_param_caller() void {",
    "    i32 mut* own p = new(i32);",
    "    i32* q = p; del(p); retained_param(q, true);",
    "}",
    "fn retained_param_mixed(i32* p, bool flag) void {",
    "    i32* mut q = p;",
    "    i32* mut* address = &q;",
    "    if (flag) { nothing(); }",
    "    foreign_read(q);",
    "}",
    "fn retained_param_mixed_caller() void {",
    "    i32 mut* own p = new(i32);",
    "    i32* q = p; del(p); retained_param_mixed(q, true);",
    "}",
    "fn retained_param_choice(i32* a, i32* b, bool flag) void {",
    "    i32* mut q = null;",
    "    i32* mut* address = &q;",
    "    if (flag) { q = a; nothing(); }",
    "    else { q = b; nothing(); }",
    "    foreign_read(q);",
    "}",
    "fn retained_param_choice_caller(bool flag) void {",
    "    i32 mut* own a = new(i32); i32 mut* own b = new(i32);",
    "    i32* x = a; i32* y = b;",
    "    del(b); retained_param_choice(x, y, flag); del(a);",
    "}",
};

