//! run
//! flags: -I ../../src
//! abort
//! stderr: panic: fir.func_predecessors: a terminator names no block
//! stdout:
//| ready
/// Checks that fir.func_predecessors refuses a terminator that names a block past the count.
import fort.diag;
import fort.fir;
import fort.prim;
import fort.types;

fn main() i32 {
    // `tt` lives in an allocation, so that the leak rule proves its end: no call changes the
    // pointer, and drop_made holds each release once.
    types.table mut* own tt = types.table_make();
    defer types.table_drop_made(move(tt));
    types.node* i32t = types.type_prim(tt, prim.prim_kind.prim_i32);
    types.node*[2] params = {i32t, i32t};
    types.node* fnty = types.type_fn(tt, i32t, params[..], false);
    fir.func mut* own f = fir.func_make();
    *f = fir.func_new(tt, null, fnty);
    defer fir.func_drop_made(move(f));
    fir.block_set_terminator(f, 0, fir.term_goto(7, diag.loc{}, 1));
    println("ready");
    fir.pred_table mut* own pt = fir.pred_table_make();
    *pt = fir.func_predecessors(f);
    defer fir.pred_table_drop_made(move(pt));
    return 0;
}
