//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: fir.func_predecessors: a terminator names no block
//! stdout:
//| ready
/// Checks that fir.func_predecessors refuses a terminator that names a block past the count.
import diag;
import fir;
import prim;
import types;

fn main() i32 {
    types.table mut tt = types.table{};
    defer types.type_table_free(&tt);
    types.node* i32t = types.type_prim(&tt, prim.prim_kind.prim_i32);
    types.node*[2] params = {i32t, i32t};
    types.node* fnty = types.type_fn(&tt, i32t, params[..], false);
    fir.func mut f = fir.func_new(&tt, null, fnty);
    defer fir.func_free(&f);
    fir.block_set_terminator(&f, 0, fir.term_goto(7, diag.loc{}, 1));
    println("ready");
    fir.pred_table mut pt = fir.func_predecessors(&f);
    defer fir.pred_table_free(&pt);
    return 0;
}
