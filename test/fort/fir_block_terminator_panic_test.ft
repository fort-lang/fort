//! run
//! flags: -I ../../src
//! abort
//! stderr: panic: fir.block_set_terminator: the block already has a terminator
//! stdout:
//| terminated
/// Checks that fir.block_set_terminator refuses a second terminator: a block has one.
import fort.diag;
import fort.fir;
import fort.prim;
import fort.types;

fn main() i32 {
    // `tt` lives in an allocation, so that the leak rule proves its end: no call changes the
    // pointer, and drop_made holds each release once.
    types.table mut* own tt = types.table_make();
    defer types.table_drop_made(move(tt));
    types.node* i32t = types.type_prim(tt, prim.prim_kind.prim_i32);
    types.node*[1] params = {i32t};
    types.node* fnty = types.type_fn(tt, i32t, params[..], false);
    fir.func mut* own f = fir.func_make();
    *f = fir.func_new(tt, null, fnty);
    defer fir.func_drop_made(move(f));
    diag.loc here = diag.loc_make("t.ft", 1, 1);
    u32 next = fir.block_new(f);
    fir.block_set_terminator(f, 0, fir.term_goto(next, here, 1));
    println("terminated");
    fir.block_set_terminator(f, 0, fir.term_return(here, 1));
    return 0;
}
