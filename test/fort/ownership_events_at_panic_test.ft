//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: ownership_events.at: index out of range
//! stdout:
//| 0
/// at reads one retained event while the index is below len. An empty store holds no event
/// at index 0, so the call panics.
import ownership_events;

fn main() i32 {
    ownership_events.store mut s = ownership_events.store{};
    defer ownership_events.free(&s);
    println(s.len);
    ownership_events.at(&s, 0);
    return 0;
}
