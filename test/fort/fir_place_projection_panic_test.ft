//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: fir.place_projection: index out of range
//! stdout:
//| ready
/// Checks the bound of fir.place_projection: a place with no projection has no projection 0.
import fir;
import prim;
import types;

fn main() i32 {
    types.table mut tt = types.table{};
    defer types.type_table_free(&tt);
    types.node* i32t = types.type_prim(&tt, prim.prim_kind.prim_i32);
    types.node*[2] params = {i32t, i32t};
    types.node* fnty = types.type_fn(&tt, i32t, params[..], false);
    fir.func mut f = fir.func_new(&tt, null, fnty);
    defer fir.func_free(&f);
    fir.place p = fir.place_local(1);
    println("ready");
    fir.place_projection(&f, p, 0);
    return 0;
}
