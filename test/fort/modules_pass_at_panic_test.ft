//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: modules.pass_at: index out of range
//! stdout:
//| util
//| main
//| 2
import modules;
import modules_env;

/// Checks the pass-order index bound across ordered and unordered modules. pass_at panics past
/// the second group.
fn main() i32 {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft", "import util;\nfn main() i32 { return util.add(1, 2); }\n");
    modules_env.add(&e, "util.ft", modules_env.src_add());
    assert(modules_env.load(&e, "main.ft"));
    println(modules.pass_at(&e.set, 0)->path);
    println(modules.pass_at(&e.set, 1)->path);
    println(modules.pass_count(&e.set));
    println(modules.pass_at(&e.set, 2)->path);
    return 0;
}
