//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: modules.pass_at: index out of range
//! stdout:
//| util
//| main
//| 2
import modules;
import modules_env;

// pass_at answers for both groups of the pass order -- the dependency order
// and the modules the loader read but never ordered -- and panics past the
// last one, rather than walking off the end of the second group (D9.10,
// D13.3).
fn i32 main() {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft", "import util;\nfn i32 main() { return util.add(1, 2); }\n");
    modules_env.add(&e, "util.ft", modules_env.src_add());
    assert(modules_env.load(&e, "main.ft"));
    println(modules.pass_at(&e.set, 0)->path);
    println(modules.pass_at(&e.set, 1)->path);
    println(modules.pass_count(&e.set));
    println(modules.pass_at(&e.set, 2)->path);
    return 0;
}
