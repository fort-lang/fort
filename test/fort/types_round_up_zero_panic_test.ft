//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: types.round_up: alignment 0
//! stdout:
//| true
//| 16
/// round_up takes the alignment of a laid-out type, which is never 0. An alignment of 0
/// breaks that precondition, so the call panics before it divides by zero.
import types;

fn main() i32 {
    u64 mut out = 0;
    println(types.round_up(13, 8, &out));
    println(out);
    types.round_up(13, 0, &out);
    return 0;
}
