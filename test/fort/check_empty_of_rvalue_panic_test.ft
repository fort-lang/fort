//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: check.empty_of: not a checked lvalue
//! stdout:
//| true
/// Checks that empty_of refuses a node without ANN_LVALUE. The emptiability of
/// an rvalue has no meaning, so an answer would be a guess.
import fort.ast;
import fort.check;
import check_env;

// The steps of the test, which end in the panic. They read `e` through a pointer, so the use
// rule of `move` and `del` (D17.21) asks no proof of their reads after a call.
fn trigger(check_env.env mut* e) void {
    println(check_env.check_decls(e, "i32 k = 1 + 2;\n"));
    // `1 + 2` is a constant rvalue: the checker writes no lvalue mark on it.
    ast.node* d = check_env.node_in_main(e, ast.ast_kind.k_var_decl, "k");
    check.empty_of(d->b);
}

fn main() i32 {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    trigger(&e);
    return 0;
}
