//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| ok
/// The `--tokens` mode of the driver gives back everything it takes. That mode
/// holds a session and a token vector.
import lifetime;

//
// support/lifetime.ft states the rule of the probe, the two views and the
// size of a round. Each file tests one driver mode. This keeps every program
// below the harness limit of 60 s under load.
//
// Removing each listed release moves a view past lifetime.BOUND. The releases
// are `session.free`, `lexer.tokvec_free`, and `strbuf.free` in
// driver.tokens_entry. This test is the only witness of all three.
// Every release of the six modes was measured this way, one deletion at a
// time, against all six tests. support/lifetime.ft gives the release count and
// the measurement command. It also describes the one release with no single
// witness.
fn main() i32 {
    lifetime.write_runtime();
    lifetime.write_file("clean.ft", "fn main() i32 {\n    return 0;\n}\n");
    string[3] mut tokens = {"fort", "--tokens", "clean.ft"};
    assert(lifetime.measure(tokens[0..3]) < lifetime.BOUND);
    println("ok");
    return 0;
}
