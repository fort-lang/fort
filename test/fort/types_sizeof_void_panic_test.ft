//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: types: sizeof of void or null
//! stdout:
//| 1
/// `void` has no size and no values, so sizeof of it is a broken
/// precondition rather than 0.
import fort.types;
import types_env;

fn main() i32 {
    types_env.env mut* own e = types_env.make();
    defer types_env.drop_made(move(e));
    println(types.type_sizeof(types_env.type_of(e, "u8")));
    println(types.type_sizeof(types.type_void(&e->tt)));
    return 0;
}
