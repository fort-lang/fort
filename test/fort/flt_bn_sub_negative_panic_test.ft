//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: flt.bn_sub: the difference would be negative
//! stdout:
//| 1
/// A bignum has no sign, so bn_sub takes a minuend at least as large as the subtrahend. 1 - 2
/// breaks that precondition, so the call panics.
import flt;

fn main() i32 {
    flt.bignum mut a = flt.bignum{};
    flt.bignum mut b = flt.bignum{};
    flt.bn_set_u64(&a, 3);
    flt.bn_set_u64(&b, 2);
    flt.bn_sub(&a, &b);
    println(a.limb[0]);
    flt.bn_sub(&a, &b);
    return 0;
}
