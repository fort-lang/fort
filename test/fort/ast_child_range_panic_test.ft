//! run
//! flags: -I ../../src
//! abort
//! stderr: panic: ast.ast_child: index out of range
//! stdout:
//| 1
/// Checks the AST child bound. An index at or above the child count breaks the precondition and
/// panics at the call site.
import fort.ast;
import fort.diag;

// The steps of the test, which end in the panic. They read `ar` through a pointer, so the use
// rule of `move` and `del` (D17.21) asks no proof of their reads after a call.
fn trigger(ast.arena mut* ar) void {
    ast.node mut* parent = ast.ast_new(ar, ast.ast_kind.k_block, diag.loc_make("t.ft", 1, 1));
    ast.ast_push(parent, ast.ast_new(ar, ast.ast_kind.k_int, diag.loc_make("t.ft", 1, 1)));
    println(ast.ast_len(parent));
    println(ast.ast_child(parent, 1)->ival);
}

fn main() i32 {
    ast.arena mut ar = ast.arena{};
    defer ast.ast_arena_free(&ar);
    trigger(&ar);
    return 0;
}
