//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: gen.gen_define: one name for each parameter
//! stdout:
//| 0
/// gen_define writes one incoming name for each parameter of the signature. A signature with
/// no parameter and one name breaks that precondition, so the call panics.
import gen;
import gen_env;

fn main() i32 {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    gen.signature mut s = gen.signature{.ret = "void"};
    defer gen.signature_free(&s);
    string[1] names = {"%x.in"};
    println(s.params.len);
    gen.gen_define(&e.g, null, &s, names[..]);
    return 0;
}
