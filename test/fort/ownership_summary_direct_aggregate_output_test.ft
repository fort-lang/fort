//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| owner before null leaf applies ok
//| owner before null view applies ok
//| null before owner applies ok
//| null leaves over a live first owner refused ok
//| null leaves over a live second owner refused ok
//| owner before null over a live owner refused ok
//| two null leaves over empty leaves apply ok
/// Checks the old output leaves of a returned literal at the caller (D17.15).
import ownership_api;
import ownership_calls_fixtures;
import ownership_state;
import ownership_summary_body;
import ownership_summary_model;

string[3] OWN_NULL = {
    "struct pr { i32 mut* own a; i32 mut* own b; }",
    "fn callee(pr mut* q) pr { return pr{new(i32), null}; }",
    "fn caller(pr mut* p) void { *p = callee(p); }",
};

string[3] NULL_OWN = {
    "struct pr { i32 mut* own a; i32 mut* own b; }",
    "fn callee(pr mut* q) pr { return pr{null, new(i32)}; }",
    "fn caller(pr mut* p) void { *p = callee(p); }",
};

string[3] NULL_NULL = {
    "struct pr { i32 mut* own a; i32 mut* own b; }",
    "fn callee(pr mut* q) pr { return pr{null, null}; }",
    "fn caller(pr mut* p) void { *p = callee(p); }",
};

string[3] OWN_VIEW = {
    "struct pv { i32 mut* own a; i32* b; }",
    "fn callee(pv mut* q) pv { return pv{new(i32), null}; }",
    "fn caller(pv mut* p) void { *p = callee(p); }",
};

// The old caller leaf `field` of the destination that `p` designates.
fn storage(ownership_calls_fixtures.fixture mut* f, u32 field) ownership_api.place_path {
    ownership_api.place_path mut path = ownership_summary_body.caller_slot(&f->inputs[1], 1);
    ownership_api.projection[1] part = {ownership_api.projection{
        .kind = ownership_api.projection_kind.field, .field = field}};
    path.projections = part[..];
    return ownership_state.copy_place(&f->caller, path);
}

// The old leaf `field` holds a live heap owner with allocation ordinal `number`.
fn live_owner(ownership_calls_fixtures.fixture mut* f, u32 field, u32 number) void {
    ownership_api.place_path item = storage(f, field);
    ownership_api.entity_id key = ownership_summary_body.id(f->inputs[1].function.key,
        ownership_api.entity_kind.allocation, number);
    ownership_api.entity_id mut source = key;
    source.kind = ownership_api.entity_kind.source;
    ownership_state.append_sources(&f->caller, ownership_api.source_fact{
        .key = source, .kind = ownership_api.source_kind.heap,
        .validity = ownership_api.validity_kind.live, .allocation = key});
    ownership_state.append_allocations(&f->caller, ownership_api.allocation_fact{
        .key = key, .site = key, .validity = ownership_api.validity_kind.live,
        .count = ownership_api.multiplicity{false, true, false}, .obligation = true,
        .owner = ownership_api.owner_location{.place = item},
        .logical_length = ownership_summary_body.integer(1)});
    ownership_api.entity_id mut version = source;
    version.kind = ownership_api.entity_kind.value;
    ownership_api.entity_id mut region = source;
    region.kind = ownership_api.entity_kind.region;
    ownership_api.borrow_relation[1] relations = {ownership_api.borrow_relation{
        .value_version = version, .containing = item, .source = source,
        .range = ownership_api.region{.key = region, .source = source,
            .offset = ownership_summary_body.integer(0),
            .access = ownership_api.byte_window{ownership_summary_body.integer(0),
                ownership_summary_body.integer(4), true},
            .extent = ownership_summary_body.integer(4), .alignment = 4},
        .representation_complete = true}};
    ownership_state.append_contents(&f->caller, ownership_api.contents_fact{
        .place = item, .value_version = version,
        .kind = ownership_api.contents_kind.reference, .borrows = relations[..],
        .span_length = ownership_summary_body.integer(1)});
}

// Applies the callee summary to a caller destination. `live` names the old leaf that holds a
// live owner, or 2 for none. The other old leaves are empty. The two flags give leaf kinds.
fn applied(ownership_calls_fixtures.fixture mut* f, string@ text, bool first_owning,
    bool second_owning, u32 live) void {
    ownership_calls_fixtures.open(f, text);
    assert(ownership_api.successful(f->summary.proof) && !f->summary.residual_effects);
    ownership_calls_fixtures.prepare(f);
    ownership_calls_fixtures.configure_source(f, ownership_api.source_kind.symbolic_caller,
        ownership_api.validity_kind.live, 16);
    if (live == 0) { live_owner(f, 0, 90); }
    else {
        ownership_state.append_contents(&f->caller,
            ownership_summary_body.empty(storage(f, 0), first_owning));
    }
    if (live == 1) { live_owner(f, 1, 91); }
    else {
        ownership_state.append_contents(&f->caller,
            ownership_summary_body.empty(storage(f, 1), second_owning));
    }
    ownership_calls_fixtures.apply(f, 1);
}

fn applies(ownership_calls_fixtures.fixture* f, u64 owners) bool {
    return ownership_api.successful(f->application.proof) && f->application.normal_continuation &&
        ownership_calls_fixtures.outstanding(&f->application.state) == owners;
}

fn refused(ownership_calls_fixtures.fixture* f) bool {
    return f->application.proof.failed &&
        f->application.proof.terminal.reason == ownership_api.incomplete_reason.none &&
        f->services.counts.last.kind == ownership_api.event_kind.caller_requirement &&
        f->services.counts.last.text == "call requires an empty old output leaf";
}

// The move fills leaf 0 before the null replacement of leaf 1. The old leaves were empty
// before the first effect of the literal, so the caller accepts the write.
fn owner_before_null_leaf_applies() void {
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    defer ownership_calls_fixtures.close(&f);
    applied(&f, OWN_NULL[..], true, true, 2);
    assert(f.summary.effects.len == 3 && f.summary.requirements.len == 2);
    assert(applies(&f, 1));
    println("owner before null leaf applies ok");
}

// A null view leaf after an owner leaf has no output requirement of its own.
fn owner_before_null_view_applies() void {
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    defer ownership_calls_fixtures.close(&f);
    applied(&f, OWN_VIEW[..], true, false, 2);
    assert(f.summary.requirements.len == 1);
    assert(applies(&f, 1));
    println("owner before null view applies ok");
}

fn null_before_owner_applies() void {
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    defer ownership_calls_fixtures.close(&f);
    applied(&f, NULL_OWN[..], true, true, 2);
    assert(applies(&f, 1));
    println("null before owner applies ok");
}

// Two null fields still check their old leaves. A live old owner would be lost.
fn null_leaves_over_live_first_owner_refused() void {
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    defer ownership_calls_fixtures.close(&f);
    applied(&f, NULL_NULL[..], true, true, 0);
    assert(f.summary.effects.len == 2);
    assert(refused(&f));
    println("null leaves over a live first owner refused ok");
}

fn null_leaves_over_live_second_owner_refused() void {
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    defer ownership_calls_fixtures.close(&f);
    applied(&f, NULL_NULL[..], true, true, 1);
    assert(refused(&f));
    println("null leaves over a live second owner refused ok");
}

// The check before the first effect also sees a live owner in the second old leaf.
fn owner_before_null_over_live_owner_refused() void {
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    defer ownership_calls_fixtures.close(&f);
    applied(&f, OWN_NULL[..], true, true, 1);
    assert(refused(&f));
    println("owner before null over a live owner refused ok");
}

fn two_null_leaves_over_empty_leaves_apply() void {
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    defer ownership_calls_fixtures.close(&f);
    applied(&f, NULL_NULL[..], true, true, 2);
    assert(applies(&f, 0));
    println("two null leaves over empty leaves apply ok");
}

fn main() i32 {
    owner_before_null_leaf_applies();
    owner_before_null_view_applies();
    null_before_owner_applies();
    null_leaves_over_live_first_owner_refused();
    null_leaves_over_live_second_owner_refused();
    owner_before_null_over_live_owner_refused();
    two_null_leaves_over_empty_leaves_apply();
    return 0;
}
