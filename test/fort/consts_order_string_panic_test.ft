//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: consts: constant folding on a non-integer
//! stdout:
//| 2
/// Folding `>=` on two string constants breaks a precondition. The language
/// defines no such operator.
import consts;

fn main() i32 {
    println(consts.cv_from_str("ab").str.len);
    println(consts.cv_compare(consts.cv_rel.cv_rel_ge, consts.cv_from_str("a"),
                              consts.cv_from_str("b")).mag);
    return 0;
}
