//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: consts: constant folding on a non-integer
//! stdout:
//| 2
import consts;

// The same rule for two string constants: `>=` on them is not an operator of
// the language, so folding one is a broken precondition.
// D6.2, D13.3
fn main() i32 {
    println(consts.cv_from_str("ab").str.len);
    println(consts.cv_compare(consts.cv_rel.cv_rel_ge, consts.cv_from_str("a"),
                              consts.cv_from_str("b")).mag);
    return 0;
}
