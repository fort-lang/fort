//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: json: nesting too deep
//! stdout:
//| at the limit ok
/// A writer accepts JSON_MAX_DEPTH open containers. One more is a violated
/// precondition and panics, where src/bootstrap/json.c ends the process with an
/// internal error.
import json;
import json_env;

fn main() i32 {
    json_env.env mut e = json_env.env{};
    json_env.open(&e);
    defer json_env.close(&e);
    u64 mut i = 0;
    while (i < json.JSON_MAX_DEPTH) {
        json.json_array_begin(&e.j);
        i += 1;
    }
    println("at the limit ok");
    json.json_array_begin(&e.j);
    println(json_env.written(&e));
    return 0;
}
