//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: json: nesting too deep
//! stdout:
//| at the limit ok
/// A writer accepts JSON_MAX_DEPTH open containers. One more is a violated
/// precondition and panics, where bootstrap0/src/json.c ends the process with an
/// internal error.
import fort.json;
import json_env;

fn main() i32 {
    json_env.env mut* own e = json_env.make();
    defer json_env.drop_made(move(e));
    u64 mut i = 0;
    while (i < json.JSON_MAX_DEPTH) {
        json.json_array_begin(&e->j);
        i += 1;
    }
    println("at the limit ok");
    json.json_array_begin(&e->j);
    println(json_env.written(e));
    return 0;
}
