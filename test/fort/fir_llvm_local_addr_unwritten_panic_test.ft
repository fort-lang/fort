//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: fir_llvm.local_addr: write_locals has not run
//! stdout:
//| result
/// write_locals gives each local with storage its alloca before a statement asks for it. A
/// call before write_locals finds no alloca for `_0`, so it panics.
import fir;
import fir_llvm;
import llvm_env;

string[6] PRELUDE = {
    "struct pair {",
    "    i32 a;",
    "    i32 b;",
    "}",
    "fn take(pair p) i32 {",
    "    return p.a;\n}",
};

string[8] TEXT = {
    "fn main.f() -> i32 {",
    "    let _1: pair;",
    "",
    "    bb0: {",
    "        _0 = call fn main.take(const zero pair) #1:1 s1;",
    "        return #1:1 s1;",
    "    }",
    "}",
};

// A panic ends the program, so the case stands in a file of its own.
fn main() i32 {
    llvm_env.env mut e = llvm_env.env{};
    llvm_env.open(&e);
    defer llvm_env.close(&e);
    fir.module mut m = llvm_env.parse(&e, PRELUDE[..], TEXT[..]);
    defer fir.module_free(&m);
    fir.func* f = fir.module_function_at(&m, 0);
    llvm_env.begin(&e.g);
    fir_llvm.translator mut t = fir_llvm.open(&e.g, f);
    defer fir_llvm.close(&t);
    if (fir_llvm.storage_at(&t, 0) == fir_llvm.storage.sk_result) {
        println("result");
    }
    fir_llvm.local_addr(&t, 0);
    return 0;
}
