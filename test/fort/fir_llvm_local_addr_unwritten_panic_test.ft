//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: fir_llvm.local_addr: write_locals has not run
//! stdout:
//| result
/// write_locals gives each local with storage its alloca before a statement asks for it. A
/// call before write_locals finds no alloca for `_0`, so it panics.
import fort.fir;
import fort.fir_llvm;
import llvm_env;

string[6] PRELUDE = {
    "struct pair {",
    "    i32 a;",
    "    i32 b;",
    "}",
    "fn take(pair p) i32 {",
    "    return p.a;\n}",
};

string[8] TEXT = {
    "fn main.f() -> i32 {",
    "    let _1: pair;",
    "",
    "    bb0: {",
    "        _0 = call fn main.take(const zero pair) #1:1 s1;",
    "        return #1:1 s1;",
    "    }",
    "}",
};

// A panic ends the program, so the case stands in a file of its own.
fn main() i32 {
    llvm_env.env mut* own e = llvm_env.make();
    defer llvm_env.drop_made(move(e));
    // `m` lives in an allocation, so that the leak rule proves its end: no call changes the
    // pointer, and drop_made holds each release once.
    fir.module mut* own m = llvm_env.parse_made(e, PRELUDE[..], TEXT[..]);
    defer fir.module_drop_made(move(m));
    fir.func* f = fir.module_function_at(m, 0);
    llvm_env.begin(&e->g);
    // `t` ends in a block of its own, so that its `del`s come after the last call of its exit.
    {
        fir_llvm.translator mut t = fir_llvm.open(&e->g, f);
        defer {
            del(t.locals);
            del(t.notes);
            del(t.cont_of);
            del(t.fail_label);
        }
        if (fir_llvm.storage_at(&t, 0) == fir_llvm.storage.sk_result) {
            println("result");
        }
        fir_llvm.local_addr(&t, 0);
    }
    return 0;
}
