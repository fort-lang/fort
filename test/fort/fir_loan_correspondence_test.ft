fn assert_boundary_refusal(ast.node* decl, fir.func* f,
                           fir_lower.range_candidate_set* proposed,
                           fir_lower.range_audit_key expected) void {
    fir_verify.violation mut bad = fir_verify.violation{};
    assert(!fir_verify.find_violation(f, null, &bad));
    fir_lower.range_source_audit mut audit = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&audit);
    assert(!fir_lower.audit_produced_ranges(decl, f, proposed, &audit));
    assert(audit.failure.reason == fir_lower.range_audit_fault.boundary);
    assert(audit.failure.key.declaration == expected.declaration);
    assert(audit.failure.key.expansion == expected.expansion);
    assert(audit.failure.key.context == expected.context);
    assert(audit.failure.key.exit_occurrence == expected.exit_occurrence);
    assert(fir_lower.range_audit_loc_eq(audit.failure.key.source, expected.source));
    assert(fir_lower.range_audit_loc_eq(audit.failure.key.context_source,
                                       expected.context_source));
    assert(fir_lower.range_audit_loc_eq(audit.failure.key.exit_source, expected.exit_source));
    assert_unpublished(f, &audit);
}

fn expansion_gap_damage() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[12] source = {
        "fn walk(i32[2] values, bool skip, bool stop) void {",
        "    for (i32 x : values) {",
        "        defer {",
        "            for (i32 y : values) {",
        "                if (stop) { break; }",
        "            }",
        "        }",
        "        if (skip) { continue; }",
        "    }",
        "}",
        "",
        "",
    };
    lower_env.check_lines(&e, source[..], true);
    ast.node* decl = lower_env.decl(&e, "walk");
    fir.func mut f = fir.func{};
    defer fir.func_free(&f);
    fir_lower.range_candidate_set mut proposed = fir_lower.range_candidate_set{};
    defer fir_lower.range_candidate_set_free(&proposed);
    fir_lower.report mut why = fir_lower.report{};
    assert(fir_lower.lower_function_with_range_candidates(&e.c.ck, decl, &f, &proposed, &why));
    fir_lower.range_source_audit mut audit = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&audit);
    assert(fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert(audit.rows.len == 3 && audit.matched_captures == 3);
    assert(audit.rows.items[1].boundaries_len == 8);
    assert(audit.rows.items[2].boundaries_len == 8);
    fir_lower.range_audit_key expected = audit.rows.items[1].key;
    assert(expected.exit_occurrence == 2);
    assert(audit.rows.items[2].key.exit_occurrence == 7);
    assert(expected.context_source.line == 3 && expected.exit_source.line == 8);
    assert_unpublished(&f, &audit);
    check_output(&e, decl, &f, "expansion_gap_damage", true);
    fir_lower.range_source_audit_free(&audit);
    u64 length = proposed.boundaries.len;
    fir_lower.range_boundary_candidate mut@ own saved =
        new(fir_lower.range_boundary_candidate, length);
    defer del(saved);
    u64 mut i = 0;
    while (i < length) { saved[i] = proposed.boundaries.items[i]; i += 1; }
    u64[3] mut target = {length, length, length};
    u64[3] mut other = {length, length, length};
    u64 mut entry = length;
    u64 mut other_entry = length;
    u64 mut second_gap = length;
    i = 0;
    while (i < length) {
        fir_lower.range_boundary_candidate c = saved[i];
        if (c.boundary.kind == fir.range_boundary_kind.body_entry) {
            if (c.expansion == 2) { entry = i; }
            if (c.expansion == 3) { other_entry = i; }
        }
        if (c.boundary.source.line == 5) {
            if (c.boundary.kind == fir.range_boundary_kind.body_cleanup) {
                if (c.expansion == 2) { target[0] = i; }
                if (c.expansion == 3) { other[0] = i; }
            }
            if (c.boundary.kind == fir.range_boundary_kind.loan_exit) {
                if (c.expansion == 2) { target[1] = i; }
                if (c.expansion == 3) { other[1] = i; }
            }
            if (c.boundary.kind == fir.range_boundary_kind.outer_cleanup) {
                if (c.expansion == 2) { target[2] = i; }
                if (c.expansion == 3) { other[2] = i; }
            }
        } else if (c.expansion == 2
                   && c.boundary.kind == fir.range_boundary_kind.body_cleanup) {
            second_gap = i;
        }
        i += 1;
    }
    assert(entry < length && other_entry < length && second_gap < length);
    i = 0;
    while (i < 3) { assert(target[i] < length && other[i] < length); i += 1; }
    // A candidate body entry cannot select the other expansion's CFG.
    proposed.boundaries.items[entry].boundary = saved[other_entry].boundary;
    proposed.boundaries.items[entry].boundary.loan = 2;
    assert_boundary_refusal(decl, &f, &proposed, expected);
    proposed.boundaries.items[entry] = saved[entry];
    // Copy all three gaps while preserving the target expansion and loan IDs.
    i = 0;
    while (i < 3) {
        proposed.boundaries.items[target[i]].boundary = saved[other[i]].boundary;
        proposed.boundaries.items[target[i]].boundary.loan = 2;
        i += 1;
    }
    assert_boundary_refusal(decl, &f, &proposed, expected);
    i = 0;
    while (i < length) { proposed.boundaries.items[i] = saved[i]; i += 1; }
    // Moving a complete triple by one operation gap still refuses.
    i = 0;
    while (i < 3) { proposed.boundaries.items[target[i]].boundary.position += 1; i += 1; }
    assert_boundary_refusal(decl, &f, &proposed, expected);
    i = 0;
    while (i < length) { proposed.boundaries.items[i] = saved[i]; i += 1; }
    // Reassigning complete triples to the other expansion leaves a required gap.
    i = 0;
    while (i < 3) {
        proposed.boundaries.items[target[i]].expansion = 3;
        proposed.boundaries.items[target[i]].boundary.loan = 3;
        i += 1;
    }
    assert_boundary_refusal(decl, &f, &proposed, expected);
    i = 0;
    while (i < length) { proposed.boundaries.items[i] = saved[i]; i += 1; }
    // Duplicating a complete triple cannot cover a second required gap.
    i = 0;
    while (i < 3) {
        fir_lower.range_boundary_candidate mut duplicate = saved[target[i]];
        duplicate.boundary.order += 30;
        fir_lower.range_boundary_candidate_add(&proposed.boundaries, duplicate);
        i += 1;
    }
    assert_boundary_refusal(decl, &f, &proposed, expected);
    proposed.boundaries.len = length;
    // Remove one complete triple. The remaining candidate subset stays ordered.
    u64 mut written = 0;
    i = 0;
    while (i < length) {
        if (i != target[0] && i != target[1] && i != target[2]) {
            proposed.boundaries.items[written] = saved[i];
            written += 1;
        }
        i += 1;
    }
    assert(written == length - 3);
    proposed.boundaries.len = written;
    assert_boundary_refusal(decl, &f, &proposed, expected);
    proposed.boundaries.len = length;
    i = 0;
    while (i < length) { proposed.boundaries.items[i] = saved[i]; i += 1; }
    // Verified FIR statement tags cannot replace the source exit and CFG proof.
    fir.range_boundary start = saved[target[0]].boundary;
    fir.statement mut* dead = &fir.block_mut(&f, start.block)->statements.items[start.position];
    fir.statement original = *dead;
    dead->stmt += 1;
    assert_boundary_refusal(decl, &f, &proposed, expected);
    *dead = original;
    dead->exit_loc = proposed.captures.items[2].occurrence.exit_source;
    assert_boundary_refusal(decl, &f, &proposed, expected);
    *dead = original;
    fir.range_boundary second = saved[second_gap].boundary;
    fir.statement* other_dead = fir.block_statement(&f, second.block, second.position);
    dead->loc = other_dead->loc;
    assert_boundary_refusal(decl, &f, &proposed, expected);
    *dead = original;
    dead->stmt = other_dead->stmt;
    dead->loc = other_dead->loc;
    assert_boundary_refusal(decl, &f, &proposed, expected);
    *dead = original;
    assert(fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert(audit.rows.len == 3 && audit.matched_boundaries == cast(length, u32));
    assert_unpublished(&f, &audit);
}

fn assert_call_incomplete(ast.node* decl, fir.func* f,
                          fir_lower.range_candidate_set* proposed,
                          fir_lower.range_audit_key expected) void {
    fir_lower.range_source_audit mut audit = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&audit);
    assert(!fir_lower.audit_produced_ranges(decl, f, proposed, &audit));
    assert(audit.failure.reason == fir_lower.range_audit_fault.protected_path);
    assert(audit.rows.len == 0 && audit.matched_captures == 0);
    assert(audit.failure.key.function == expected.function);
    assert(audit.failure.key.declaration == expected.declaration);
    assert(audit.failure.key.expansion == expected.expansion);
    assert(audit.failure.key.context == expected.context);
    assert(audit.failure.key.exit_occurrence == expected.exit_occurrence);
    assert(fir_lower.range_audit_loc_eq(audit.failure.key.source, expected.source));
    assert(fir_lower.range_audit_loc_eq(audit.failure.key.context_source,
                                       expected.context_source));
    assert(fir_lower.range_audit_loc_eq(audit.failure.key.exit_source, expected.exit_source));
    assert_unpublished(f, &audit);
}

fn call_materialization_case(string name, string@ source, u32 source_line,
                              u32 context_line) void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    lower_env.check_lines(&e, source, true);
    ast.node* decl = lower_env.decl(&e, "walk");
    fir.func mut f = fir.func{};
    defer fir.func_free(&f);
    fir_lower.range_candidate_set mut proposed = fir_lower.range_candidate_set{};
    defer fir_lower.range_candidate_set_free(&proposed);
    fir_lower.report mut why = fir_lower.report{};
    assert(fir_lower.lower_function_with_range_candidates(&e.c.ck, decl, &f, &proposed, &why));
    fir_lower.range_source_audit mut audit = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&audit);
    bool incomplete = !fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit);
    if (!incomplete) { eprintln(name, " accepts an unproved protected path"); }
    assert(incomplete);
    assert(audit.failure.reason == fir_lower.range_audit_fault.protected_path);
    assert(audit.selected_declarations == 1 && audit.produced_expansions == 1);
    assert(audit.rows.len == 0 && audit.matched_captures == 0);
    fir_lower.range_audit_key expected = audit.failure.key;
    assert(expected.source.line == source_line);
    assert(expected.context_source.line == context_line);
    if (context_line == 0) {
        assert(expected.context == 0 && expected.exit_occurrence == 0);
        assert(expected.exit_source.line == 0);
    } else {
        assert(expected.context != 0 && expected.exit_occurrence != 0);
        assert(expected.exit_source.line != 0);
    }
    assert_unpublished(&f, &audit);
    check_output(&e, decl, &f, name, true);
    fir_lower.range_source_audit_free(&audit);
    assert(proposed.captures.len == 1);
    fir_lower.range_capture_candidate saved = proposed.captures.items[0];
    // A substituted protected root remains incomplete before binding acceptance.
    proposed.captures.items[0].binding.original = saved.binding.captured;
    assert_call_incomplete(decl, &f, &proposed, expected);
    proposed.captures.items[0] = saved;
    proposed.captures.items[0].binding.original = fir.place_local(1);
    assert_call_incomplete(decl, &f, &proposed, expected);
    proposed.captures.items[0] = saved;
    proposed.captures.items[0].binding.captured = saved.binding.original;
    assert_call_incomplete(decl, &f, &proposed, expected);
    proposed.captures.items[0] = saved;
    proposed.captures.items[0].binding.original_present = false;
    assert_call_incomplete(decl, &f, &proposed, expected);
    proposed.captures.items[0] = saved;
    // Deleting a candidate cannot promote a call-result path to source acceptance.
    proposed.captures.len = 0;
    assert_call_incomplete(decl, &f, &proposed, expected);
    proposed.captures.len = 1;
    // Delete each boundary set while preserving the valid executable function.
    u64 boundaries = proposed.boundaries.len;
    proposed.boundaries.len = 0;
    assert_call_incomplete(decl, &f, &proposed, expected);
    proposed.boundaries.len = boundaries;
    assert_call_incomplete(decl, &f, &proposed, expected);
    fir_verify.violation mut bad = fir_verify.violation{};
    assert(!fir_verify.find_violation(&f, &e.rt, &bad));
}

fn call_materialization_matrix() void {
    string[5] returned_span = {
        "fn pick(i32@ values) i32@ { return values; }",
        "fn walk(i32@ values) void {",
        "    for (i32 x : pick(values)) { }",
        "}",
        "",
    };
    call_materialization_case("call_returned_span", returned_span[..], 3, 0);
    string[5] returned_string = {
        "fn pick(string text) string { return text; }",
        "fn walk(string text) void {",
        "    for (char x : pick(text)) { }",
        "}",
        "",
    };
    call_materialization_case("call_returned_string", returned_string[..], 3, 0);
    string[6] pointer_result = {
        "struct holder { i32@ items; i32@ other; }",
        "fn pick(holder* h) holder* { return h; }",
        "fn walk(holder* h) void {",
        "    for (i32 x : pick(h)->items) { }",
        "}",
        "",
    };
    call_materialization_case("call_pointer_result", pointer_result[..], 4, 0);
    string[7] projected_result = {
        "struct inner { i32@ items; }",
        "struct holder { inner data; }",
        "fn pick(holder* h) holder* { return h; }",
        "fn walk(holder* h) void {",
        "    for (i32 x : pick(h)->data.items) { }",
        "}",
        "",
    };
    call_materialization_case("call_projected_result", projected_result[..], 5, 0);
    string[8] deferred_result = {
        "struct holder { i32@ items; }",
        "fn pick(holder* h) holder* { return h; }",
        "fn walk(holder* h) void {",
        "    defer {",
        "        for (i32 x : pick(h)->items) { }",
        "    }",
        "}",
        "",
    };
    call_materialization_case("call_deferred_result", deferred_result[..], 5, 4);
}

fn conditional_control_case(string name, string@ source, bool accepted) void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    lower_env.check_lines(&e, source, true);
    ast.node* decl = lower_env.decl(&e, "walk");
    fir.func mut f = fir.func{};
    defer fir.func_free(&f);
    fir_lower.range_candidate_set mut proposed = fir_lower.range_candidate_set{};
    defer fir_lower.range_candidate_set_free(&proposed);
    fir_lower.report mut why = fir_lower.report{};
    assert(fir_lower.lower_function_with_range_candidates(&e.c.ck, decl, &f, &proposed, &why));
    fir_lower.range_source_audit mut audit = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&audit);
    bool matched = fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit);
    if (matched != accepted) { eprintln(name, " changes its protected-place verdict"); }
    assert(matched == accepted);
    assert(audit.selected_declarations == 1 && audit.produced_expansions == 1);
    if (accepted) {
        assert(audit.rows.len == 1 && audit.matched_captures == 1);
        assert(audit.matched_boundaries == cast(proposed.boundaries.len, u32));
    } else {
        assert(audit.failure.reason == fir_lower.range_audit_fault.protected_path);
        assert(audit.failure.key.source.line == 5);
        assert(audit.rows.len == 0 && audit.matched_captures == 0);
    }
    check_output(&e, decl, &f, name, true);
    fir_lower.range_candidate_set_free(&proposed);
    assert_unpublished(&f, &audit);
    if (accepted) { assert(audit.rows.len == 1); }
    else { assert(audit.failure.reason == fir_lower.range_audit_fault.protected_path); }
}

fn conditional_materialization_pair(string name, string first, string second,
                                      string parameters, string element, string expression,
                                      bool accepted, bool control) void {
    strbuf.str_buf mut header = strbuf.create();
    defer strbuf.free(&header);
    strbuf.append(&header, "fn walk(");
    strbuf.append(&header, parameters);
    strbuf.append(&header, ") void {");
    strbuf.str_buf mut loop = strbuf.create();
    defer strbuf.free(&loop);
    strbuf.append(&loop, "        for (");
    strbuf.append(&loop, element);
    strbuf.append(&loop, " x : ");
    strbuf.append(&loop, expression);
    strbuf.append(&loop, ") { }");
    u32 mut mode = 0;
    while (mode < 2) {
        string[8] mut source = {
            first, second, strbuf.view(&header), "", strbuf.view(&loop), "", "}", "",
        };
        strbuf.str_buf mut key = strbuf.create();
        strbuf.append(&key, name);
        u32 mut context = 0;
        if (mode == 0) {
            strbuf.append(&key, "_direct");
        } else {
            source[3] = "    defer {";
            source[5] = "    }";
            context = 4;
            strbuf.append(&key, "_deferred");
        }
        if (control) {
            conditional_control_case(strbuf.view(&key), source[..], accepted);
        } else {
            call_materialization_case(strbuf.view(&key), source[..], 5, context);
        }
        strbuf.free(&key);
        mode += 1;
    }
}

fn conditional_materialization_matrix() void {
    string span_call = "fn pick(i32@ values) i32@ { return values; }";
    string span_parameters = "bool select, bool other, i32@ values, i32@ backup";
    conditional_materialization_pair("conditional_span_then", span_call, "",
        span_parameters, "i32", "select ? pick(values) : backup", false, false);
    conditional_materialization_pair("conditional_span_else", span_call, "",
        span_parameters, "i32", "select ? values : pick(backup)", false, false);
    string string_call = "fn pick(string values) string { return values; }";
    string string_parameters = "bool select, string values, string backup";
    conditional_materialization_pair("conditional_string_then", string_call, "",
        string_parameters, "char", "select ? pick(values) : backup", false, false);
    conditional_materialization_pair("conditional_string_else", string_call, "",
        string_parameters, "char", "select ? values : pick(backup)", false, false);
    conditional_materialization_pair("conditional_nested_then_then", span_call, "",
        span_parameters, "i32", "select ? (other ? pick(values) : backup) : values", false, false);
    conditional_materialization_pair("conditional_nested_then_else", span_call, "",
        span_parameters, "i32", "select ? (other ? values : pick(backup)) : values", false, false);
    conditional_materialization_pair("conditional_nested_else_then", span_call, "",
        span_parameters, "i32", "select ? values : (other ? pick(values) : backup)", false, false);
    conditional_materialization_pair("conditional_nested_else_else", span_call, "",
        span_parameters, "i32", "select ? values : (other ? values : pick(backup))", false, false);
    string address_call = "fn pick(i32@* values) i32@* { return values; }";
    string address_parameters = "bool select, i32@* values, i32@* backup";
    conditional_materialization_pair("conditional_address_then", address_call, "",
        address_parameters, "i32", "*(select ? pick(values) : backup)", false, false);
    conditional_materialization_pair("conditional_address_else", address_call, "",
        address_parameters, "i32", "*(select ? values : pick(backup))", false, false);
    string holder = "struct holder { i32@ items; }";
    string member_call = "fn pick(holder* values) holder* { return values; }";
    string member_parameters = "bool select, holder* values, holder* backup";
    conditional_materialization_pair("conditional_member_then", holder, member_call,
        member_parameters, "i32", "(select ? pick(values) : backup)->items", false, false);
    conditional_materialization_pair("conditional_member_else", holder, member_call,
        member_parameters, "i32", "(select ? values : pick(backup))->items", false, false);
    conditional_materialization_pair("conditional_header_then", span_call, "",
        span_parameters, "i32", "(select ? pick(values) : backup)[..]", false, false);
    conditional_materialization_pair("conditional_header_else", span_call, "",
        span_parameters, "i32", "(select ? values : pick(backup))[..]", false, false);
    conditional_materialization_pair("conditional_cast_then", span_call, "",
        span_parameters, "i32", "cast(select ? pick(values) : backup, i32@)", false, false);
    conditional_materialization_pair("conditional_cast_else", span_call, "",
        span_parameters, "i32", "cast(select ? values : pick(backup), i32@)", false, false);
    string condition_call = "fn choose(bool selected) bool { return selected; }";
    conditional_materialization_pair("conditional_condition_call", condition_call, "",
        span_parameters, "i32", "choose(select) ? values : backup", false, false);
    // No-call controls preserve the existing accepted and incomplete source matches.
    conditional_materialization_pair("conditional_span_control", "", "",
        span_parameters, "i32", "select ? values : backup", true, true);
    conditional_materialization_pair("conditional_string_control", "", "",
        string_parameters, "char", "select ? values : backup", true, true);
    conditional_materialization_pair("conditional_nested_control", "", "",
        span_parameters, "i32", "select ? (other ? values : backup) : values", true, true);
    conditional_materialization_pair("conditional_address_control", "", "",
        address_parameters, "i32", "*(select ? values : backup)", false, true);
    conditional_materialization_pair("conditional_member_control", holder, "",
        member_parameters, "i32", "(select ? values : backup)->items", false, true);
    conditional_materialization_pair("conditional_header_control", "", "",
        span_parameters, "i32", "(select ? values : backup)[..]", true, true);
    conditional_materialization_pair("conditional_cast_control", "", "",
        span_parameters, "i32", "cast(select ? values : backup, i32@)", true, true);
}
