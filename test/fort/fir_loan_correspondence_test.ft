    deferred_scope_case("continue_crosses_switch", continue_crosses_switch[..], 1, 2, 2);
    string[4] return_and_falloff = {
        "fn walk(i32[2] values, bool stop) void {",
        "    defer { for (i32 x : values) { } }",
        "    if (stop) { return; }",
        "}",
    };
    deferred_scope_case("return_and_falloff", return_and_falloff[..], 1, 2, 2);
    string[8] both_return_arms = {
        "fn walk(i32[2] values, bool stop) void {",
        "    defer { for (i32 x : values) { } }",
        "    if (stop) {",
        "        return;",
        "    } else {",
        "        return;",
        "    }",
        "}",
    };
    deferred_scope_case("both_return_arms", both_return_arms[..], 1, 3, 3);
    string[4] disconnected_defer = {
        "fn walk(i32[2] values) void {",
        "    return;",
        "    defer { for (i32 x : values) { } }",
        "}",
    };
    deferred_scope_case("disconnected_defer", disconnected_defer[..], 1, 1, 1);
    string[7] suppressed_before_produced = {
        "fn walk(i32[2] values) void {",
        "    {",
        "        defer { for (i32 x : values) { } }",
        "        defer panic(\"stop\");",
        "    }",
        "    defer { for (i32 y : values) { } }",
        "}",
    };
    deferred_scope_case("suppressed_before_produced", suppressed_before_produced[..], 2, 1, 3);
    string[7] nested_empty_scopes = {
        "fn walk(i32[2] values) void {",
        "    defer { for (i32 x : values) { } }",
        "    {",
        "        { }",
        "        { i32 value = 0; }",
        "    }",
        "}",
    };
    deferred_scope_case("nested_empty_scopes", nested_empty_scopes[..], 1, 1, 1);
    string[7] nested_range_body_defers = {
        "fn walk(i32[2] values) void {",
        "    defer {",
        "        for (i32 x : values) {",
        "            defer { for (i32 y : values) { } }",
        "        }",
        "    }",
        "}",
    };
    deferred_scope_case("nested_range_body_defers", nested_range_body_defers[..], 2, 2, 2);
