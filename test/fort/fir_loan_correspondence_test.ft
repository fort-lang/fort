    deferred_scope_case("while_continue_expansions", while_continue_expansions[..], 1, 2, 2);
    string[6] while_break_expansions = {
        "fn walk(i32[2] values, bool repeat, bool stop) void {",
        "    while (repeat) {",
        "        defer { for (i32 x : values) { } }",
