fn capture_kinds() void {
    string[3] owning = {
        "fn walk(u8 mut* own[2] items) void {",
        "    for (u8 mut* item : items) { }",
        "}",
    };
    capture_case("capture_owning", owning[..], fir.range_capture_kind.owning_fixed_array_place, 1);
    string[5] copied = {
        "fn walk(i32[2] mut values) void {",
        "    for (i32 x : values) {",
        "        values[0] = 9;",
        "    }",
        "}",
    };
    capture_case("capture_copied", copied[..], fir.range_capture_kind.non_owning_array_copy, 0);
    string[5] indirect = {
        "struct holder { u8 mut@ own items; }",
        "fn walk(holder mut* mut h, holder mut* next) void {",
        "    for (u8 x : h->items) { }",
        "    h = next;",
        "}",
    };
    capture_case("capture_indirect", indirect[..], fir.range_capture_kind.borrowed_header, 1);
    string[10] projected = {
        "fn select(i32 mut* count) i32 {",
        "    *count += 1;",
        "    return 0;",
        "}",
        "fn walk(u8 mut@ own[2] items, i32 mut count) i32 {",
        "    for (u8 x : items[select(&count)]) {",
        "        count += 1;",
        "    }",
        "    return count;",
        "}",
    };
    capture_case("capture_projected", projected[..], fir.range_capture_kind.borrowed_header, 1);
    string[3] owning_span = {
        "fn walk(u8 mut@ own bytes) void {",
        "    for (u8 x : bytes) { }",
        "}",
    };
    capture_case("capture_owning_span", owning_span[..], fir.range_capture_kind.borrowed_header, 1);
    string[3] owning_string = {
        "fn walk(string own text) void {",
        "    for (char x : text) { }",
        "}",
    };
    capture_case("capture_owning_string", owning_string[..], fir.range_capture_kind.borrowed_header,
                 1);
    string[3] borrowed_string = {
        "fn walk(string text) void {",
        "    for (char x : text) { }",
        "}",
    };
    capture_case("capture_borrowed_string", borrowed_string[..],
                 fir.range_capture_kind.borrowed_header,
                 1);
}

fn selected_paths() void {
    string[7] branch = {
        "fn walk(i32[2] values) void {",
        "    $if (true) {",
        "        for (i32 x : values) { }",
        "    } else {",
        "        for (i32 y : values) { }",
        "    }",
        "}",
    };
    capture_case("capture_branch", branch[..], fir.range_capture_kind.non_owning_array_copy, 0);
    string[4] disconnected = {
        "fn walk(i32[2] values) void {",
        "    return;",
        "    for (i32 x : values) { }",
        "}",
    };
    capture_case("capture_disconnected", disconnected[..],
                 fir.range_capture_kind.non_owning_array_copy,
                 0);
}

fn boundary_case(string name, string@ source, u32 declarations, u32 expansions,
                 bool deferred) void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    lower_env.check_lines(&e, source, true);
    ast.node* decl = lower_env.decl(&e, "walk");
    fir.func mut f = fir.func{};
    defer fir.func_free(&f);
    fir_lower.range_candidate_set mut proposed = fir_lower.range_candidate_set{};
    defer fir_lower.range_candidate_set_free(&proposed);
    fir_lower.report mut why = fir_lower.report{};
    assert(fir_lower.lower_function_with_range_candidates(&e.c.ck, decl, &f,
                                                           &proposed, &why));
    fir_lower.range_source_audit mut audit = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&audit);
    bool matched = fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit);
    assert(matched);
    assert(audit.selected_declarations == declarations);
    assert(audit.produced_expansions == expansions);
    if (deferred) {
        assert(audit.rows.items[1].key.context_source.line == 2);
        assert(audit.rows.items[1].key.exit_source.line != 0);
    } else {
        assert(audit.matched_captures == expansions);
        assert(audit.matched_boundaries == cast(proposed.boundaries.len, u32));
    }
    assert(!audit.source_complete && !f.range_source_complete);
    check_output(&e, decl, &f, name, false);
    if (declarations == 2 && !deferred) {
        fir_lower.range_source_audit_free(&audit);
        u64 mut first = proposed.boundaries.len;
        u64 mut second = proposed.boundaries.len;
        u64 mut i = 0;
        while (i < proposed.boundaries.len) {
            fir_lower.range_boundary_candidate* c = &proposed.boundaries.items[i];
            if (c->boundary.kind == fir.range_boundary_kind.body_entry) {
                if (c->expansion == 1) { first = i; }
                if (c->expansion == 2) { second = i; }
            }
            i += 1;
        }
        assert(first < proposed.boundaries.len && second < proposed.boundaries.len);
        proposed.boundaries.items[first].boundary.block =
            proposed.boundaries.items[second].boundary.block;
        assert(!fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
        assert(audit.failure.reason == fir_lower.range_audit_fault.boundary);
        assert(!audit.source_complete);
    }
}

fn boundary_repeats() void {
    string[12] nested = {
        "fn walk(i32[2] outer, i32[2] inner, bool stop) i32 {",
        "    i32 mut sum = 0;",
        "    for (i32 x : outer) {",
        "        sum += x;",
        "        for (i32 y : inner) {",
        "            if (stop) { break; }",
        "            sum += y;",
        "        }",
        "        sum += 1;",
        "    }",
        "    return sum;",
        "}",
    };
    boundary_case("boundary_nested", nested[..], 2, 2, false);
    string[9] tail = {
        "fn walk(i32[2] values, bool stop) i32 {",
        "    i32 mut sum = 0;",
        "    for (i32 x : values) {",
        "        sum += x;",
        "        if (stop) { sum += 1; }",
        "        sum += 2;",
        "    }",
        "    return sum;",
        "}",
    };
    boundary_case("boundary_tail", tail[..], 1, 1, false);
    string[12] continued = {
        "fn walk(i32[2] values, bool skip) i32 {",
        "    i32 mut count = 0;",
        "    for (i32 x : values) {",
        "        defer count +%= 1;",
        "        defer count +%= 2;",
        "        if (skip) {",
        "            continue;",
        "        }",
        "        count +%= x;",
        "    }",
        "    return count;",
        "}",
    };
    boundary_case("boundary_continued", continued[..], 1, 1, false);
    string[16] switched = {
        "fn walk(i32[2] values, i32 mode, bool stop) i32 {",
        "    i32 mut count = 0;",
        "    for (i32 x : values) {",
        "        switch (mode) {",
        "        case 0:",
        "            count +%= x;",
        "            break;",
        "        default:",
        "            count +%= 1;",
        "        }",
        "        if (stop) { break; }",
        "        count +%= 2;",
        "    }",
        "    return count;",
        "}",
        "",
    };
    boundary_case("boundary_switched", switched[..], 1, 1, false);
    string[10] broken = {
        "fn walk(i32[2] values, bool stop) i32 {",
        "    i32 mut count = 0;",
        "    for (i32 x : values) {",
        "        defer count +%= 1;",
        "        if (stop) { break; }",
        "        count +%= x;",
        "    }",
        "    count +%= 2;",
        "    return count;",
        "}",
    };
    boundary_case("boundary_broken", broken[..], 1, 1, false);
    string[9] returned = {
        "fn walk(i32[2] values, i32 mut base) i32 {",
        "    defer base +%= 10;",
        "    for (i32 x : values) {",
        "        defer base +%= 1;",
        "        return x + base;",
        "    }",
        "    return base;",
        "}",
        "",
    };
    boundary_case("boundary_returned", returned[..], 1, 1, false);
    string[7] function_defer = {
        "fn walk(i32[2] values) void {",
        "    defer { for (i32 y : values) { } }",
        "    for (i32 x : values) {",
        "        return;",
        "    }",
        "}",
        "",
    };
    boundary_case("boundary_function_defer", function_defer[..], 2, 3, true);
    string[7] aborted = {
        "fn walk(i32[2] values) noreturn {",
        "    for (i32 x : values) {",
        "        panic(\"stop\");",
        "    }",
        "    while (true) { }",
        "}",
        "",
    };
    boundary_case("boundary_aborted", aborted[..], 1, 1, false);
    string[6] zero = {
        "fn walk(i32[1] values) i32 {",
        "    i32 mut count = 0;",
        "    for (i32 x : values[0..0]) { count +%= x; }",
        "    return count;",
        "}",
        "",
    };
    boundary_case("boundary_zero", zero[..], 1, 1, false);
    string[8] body_locals = {
        "fn walk(i32[2] values) i32 {",
        "    i32 mut total = 0;",
        "    for (i32 x : values) {",
        "        i32 saved = x;",
        "        total += saved;",
        "    }",
        "    return total;",
        "}",
    };
    boundary_case("boundary_body_locals", body_locals[..], 1, 1, false);
}

fn absence_stays_open() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[8] source = {
        "fn walk(i32[2] values) void {",
        "    defer {",
        "        for (i32 x : values) { }",
        "    }",
        "    defer panic(\"stop\");",
        "    return;",
        "}",
        "",
    };
    lower_env.check_lines(&e, source[..], true);
    ast.node* decl = lower_env.decl(&e, "walk");
    fir.func mut f = fir.func{};
    defer fir.func_free(&f);
    fir_lower.range_candidate_set mut proposed = fir_lower.range_candidate_set{};
    defer fir_lower.range_candidate_set_free(&proposed);
    fir_lower.report mut why = fir_lower.report{};
    assert(fir_lower.lower_function_with_range_candidates(&e.c.ck, decl, &f,
                                                           &proposed, &why));
    fir_lower.range_source_audit mut audit = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&audit);
    assert(fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert(audit.selected_declarations == 1 && audit.produced_expansions == 0);
    assert(audit.rows.len == 0 && proposed.suppressions.len == 1);
    assert(!audit.structural_valid && !audit.source_complete && !audit.ownership_proved);
    assert(!f.range_supplied_complete && !f.range_source_complete);
    check_output(&e, decl, &f, "absence_stays_open", false);
}

// Each refusal keeps the independently derived source and FIR exit key.
fn assert_unpublished(fir.func* f, fir_lower.range_source_audit* audit) void {
    assert(!audit->structural_valid);
    assert(!audit->source_complete);
    assert(!audit->ownership_proved);
    assert(!f->range_supplied_complete);
    assert(!f->range_source_complete);
    assert(f->range_declarations.len == 0);
    assert(f->range_expansions.len == 0);
    assert(f->range_loans.len == 0);
    assert(f->range_captures.len == 0);
    assert(f->range_boundaries.len == 0);
    assert(f->range_absences.len == 0);
}

fn assert_context_key(fir_lower.range_source_audit* audit,
                      fir_lower.range_audit_key expected) void {
    assert(audit->failure.reason == fir_lower.range_audit_fault.context);
    assert(audit->failure.key.function == expected.function);
    assert(audit->failure.key.declaration == expected.declaration);
    assert(audit->failure.key.expansion == expected.expansion);
    assert(audit->failure.key.context == expected.context);
    assert(audit->failure.key.exit_occurrence == expected.exit_occurrence);
    assert(fir_lower.range_audit_loc_eq(audit->failure.key.source, expected.source));
    assert(fir_lower.range_audit_loc_eq(audit->failure.key.context_source,
                                       expected.context_source));
    assert(fir_lower.range_audit_loc_eq(audit->failure.key.exit_source,
                                       expected.exit_source));
}

fn context_identity_damage() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[9] source = {
        "fn walk(i32@ values, bool stop) void {",
        "    defer {",
        "        defer {",
        "            for (i32 x : values) { }",
        "        }",
        "    }",
        "    if (stop) { return; }",
        "}",
        "",
    };
    lower_env.check_lines(&e, source[..], true);
    ast.node* decl = lower_env.decl(&e, "walk");
    fir.func mut f = fir.func{};
    defer fir.func_free(&f);
    fir_lower.range_candidate_set mut proposed = fir_lower.range_candidate_set{};
    defer fir_lower.range_candidate_set_free(&proposed);
    fir_lower.report mut why = fir_lower.report{};
    assert(fir_lower.lower_function_with_range_candidates(&e.c.ck, decl, &f, &proposed, &why));
    fir_lower.range_source_audit mut audit = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&audit);
    assert(fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert(audit.rows.len == 2 && proposed.deferred.len == 4);
    assert(audit.rows.items[0].key.context == 2);
    assert(audit.rows.items[1].key.context == 4);
    fir_lower.range_audit_key expected = audit.rows.items[0].key;
    assert(expected.source.line == 4 && expected.context_source.line == 3);
    assert_context_key_shape(expected, 6, 3);
    assert_unpublished(&f, &audit);
    check_output(&e, decl, &f, "context_identity_damage", true);
    fir_lower.range_source_audit_free(&audit);
    fir_lower.range_defer_context_candidate[4] mut saved = {};
    u64 mut i = 0;
    while (i < 4) { saved[i] = proposed.deferred.items[i]; i += 1; }
    fir_lower.range_capture_candidate first = proposed.captures.items[0];
    fir_lower.range_capture_candidate second = proposed.captures.items[1];
    u64 original_len = proposed.deferred.len;
    // Removing the entire context vector cannot erase checked-source defers.
    proposed.deferred.len = 0;
    assert(!fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert_context_key(&audit, expected);
    assert_unpublished(&f, &audit);
    fir_lower.range_source_audit_free(&audit);
    proposed.deferred.len = original_len;
    // A missing inner context cannot use the outer context as a replacement.
    proposed.deferred.len = 1;
    assert(!fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert_context_key(&audit, expected);
    assert_unpublished(&f, &audit);
    fir_lower.range_source_audit_free(&audit);
    proposed.deferred.len = original_len;
    // Delete the first context while keeping the three other records.
    i = 0;
    while (i < 3) { proposed.deferred.items[i] = saved[i + 1]; i += 1; }
    proposed.deferred.len = 3;
    assert(!fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert_context_key(&audit, expected);
    fir_lower.range_source_audit_free(&audit);
    proposed.deferred.len = original_len;
    i = 0;
    while (i < 4) { proposed.deferred.items[i] = saved[i]; i += 1; }
    // Check each field separately. Each mutation restores its original value.
    proposed.deferred.items[1].parent = 0;
    assert(!fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert_context_key(&audit, expected);
    fir_lower.range_source_audit_free(&audit);
    proposed.deferred.items[1] = saved[1];
    proposed.deferred.items[1].parent = proposed.deferred.items[1].id;
    assert(!fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert_context_key(&audit, expected);
    fir_lower.range_source_audit_free(&audit);
    proposed.deferred.items[1] = saved[1];
    proposed.deferred.items[1].source_node = saved[0].source_node;
    assert(!fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert_context_key(&audit, expected);
    fir_lower.range_source_audit_free(&audit);
    proposed.deferred.items[1] = saved[1];
    proposed.deferred.items[1].exit_source = saved[0].exit_source;
    assert(!fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert_context_key(&audit, expected);
    fir_lower.range_source_audit_free(&audit);
    proposed.deferred.items[1] = saved[1];
    proposed.deferred.items[0] = saved[2];
    proposed.deferred.items[2] = saved[0];
    assert(!fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert_context_key(&audit, expected);
    fir_lower.range_source_audit_free(&audit);
    proposed.deferred.items[0] = saved[0];
    proposed.deferred.items[2] = saved[2];
    proposed.deferred.items[0].exit_source = saved[2].exit_source;
    proposed.deferred.items[1].exit_source = saved[3].exit_source;
    proposed.captures.items[0].occurrence.exit_source = second.occurrence.exit_source;
    assert(!fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert_context_key(&audit, expected);
    fir_lower.range_source_audit_free(&audit);
    proposed.deferred.items[0] = saved[0];
    proposed.deferred.items[1] = saved[1];
    proposed.captures.items[0] = first;
    // Coordinated renumbering cannot replace the independent event count.
    i = 0;
    while (i < 4) {
        proposed.deferred.items[i].exit_occurrence += 20;
        i += 1;
    }
    proposed.captures.items[0].occurrence.exit_occurrence += 20;
    proposed.captures.items[1].occurrence.exit_occurrence += 20;
    assert(!fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert_context_key(&audit, expected);
    fir_lower.range_source_audit_free(&audit);
    i = 0;
    while (i < 4) {
        proposed.deferred.items[i] = saved[i];
        proposed.deferred.items[i].id += 20;
        if (proposed.deferred.items[i].parent != 0) { proposed.deferred.items[i].parent += 20; }
        i += 1;
    }
    proposed.captures.items[0] = first;
    proposed.captures.items[1] = second;
    proposed.captures.items[0].occurrence.context += 20;
    proposed.captures.items[1].occurrence.context += 20;
    assert(!fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert_context_key(&audit, expected);
    fir_lower.range_source_audit_free(&audit);
    i = 0;
    while (i < 4) { proposed.deferred.items[i] = saved[i]; i += 1; }
    proposed.captures.items[0] = first;
    proposed.captures.items[1] = second;
    fir_lower.range_defer_context_candidate_add(&proposed.deferred, saved[1]);
    assert(!fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert_context_key(&audit, expected);
    assert_unpublished(&f, &audit);
    fir_lower.range_source_audit_free(&audit);
    proposed.deferred.len = original_len;
    proposed.captures.len = 0;
    assert(!fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert_context_key(&audit, expected);
    assert_unpublished(&f, &audit);
    fir_lower.range_source_audit_free(&audit);
    proposed.captures.len = 2;
    proposed.captures.items[0].occurrence.context = 0;
    assert(!fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert_context_key(&audit, expected);
    fir_lower.range_source_audit_free(&audit);
    proposed.captures.items[0] = first;
    proposed.captures.items[0].occurrence.exit_occurrence = 0;
    assert(!fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert_context_key(&audit, expected);
    fir_lower.range_source_audit_free(&audit);
    proposed.captures.items[0] = first;
    assert(fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert(audit.rows.len == 2);
    assert_unpublished(&f, &audit);
    fir_lower.range_candidate_set_free(&proposed);
    assert(audit.rows.items[0].key.context == expected.context);
    assert(audit.rows.items[0].boundaries_len == 5);
    assert(audit.rows.items[1].boundaries_len == 5);
}

fn assert_context_key_shape(fir_lower.range_audit_key key, u32 exit_line,
                            u32 context_line) void {
    assert(key.function != null && key.context != 0);
    assert(key.exit_occurrence != 0);
    assert(key.exit_source.line == exit_line);
    assert(key.context_source.line == context_line);
    assert(key.source.file == key.exit_source.file);
}

fn deferred_scope_case(string name, string@ source, u32 declarations,
                        u32 expansions, u32 contexts) void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    lower_env.check_lines(&e, source, true);
    ast.node* decl = lower_env.decl(&e, "walk");
    fir.func mut f = fir.func{};
    defer fir.func_free(&f);
    fir_lower.range_candidate_set mut proposed = fir_lower.range_candidate_set{};
    defer fir_lower.range_candidate_set_free(&proposed);
    fir_lower.report mut why = fir_lower.report{};
    assert(fir_lower.lower_function_with_range_candidates(&e.c.ck, decl, &f, &proposed, &why));
    fir_lower.range_source_audit mut audit = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&audit);
    assert(fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert(audit.selected_declarations == declarations);
    if (audit.produced_expansions != expansions || proposed.deferred.len != cast(contexts, u64)) {
        eprintln(name, " expansions ", audit.produced_expansions,
                 " contexts ", proposed.deferred.len);
    }
    assert(audit.produced_expansions == expansions);
    assert(audit.matched_captures == expansions);
    assert(audit.rows.len == cast(expansions, u64));
    assert(proposed.deferred.len == cast(contexts, u64));
    assert(audit.matched_boundaries == cast(proposed.boundaries.len, u32));
    assert_unpublished(&f, &audit);
    u64 mut i = 0;
    while (i < audit.rows.len) {
        fir_lower.range_audit_row row = audit.rows.items[i];
        assert(row.key.function == cast(decl->sym, ast.sym*));
        assert(row.key.expansion == cast(i + 1, u32));
        assert(row.key.declaration != 0 && row.key.declaration <= declarations);
        assert(row.key.source.file == decl->loc.file);
        assert(row.boundaries_len >= 2);
        if (row.key.context != 0) {
            assert(row.key.context_source.line != 0);
            assert(row.key.exit_occurrence != 0);
            assert(row.key.exit_source.line != 0);
        } else {
            assert(row.key.context_source.line == 0);
            assert(row.key.exit_occurrence == 0);
            assert(row.key.exit_source.line == 0);
        }
        i += 1;
    }
    check_output(&e, decl, &f, name, true);
    fir_lower.range_candidate_set_free(&proposed);
    assert(audit.rows.len == cast(expansions, u64));
    assert_unpublished(&f, &audit);
}

fn deferred_scope_matrix() void {
    string[3] single_defer = {
        "fn walk(i32[2] values) void {",
        "    defer { for (i32 x : values) { } }",
        "}",
    };
    deferred_scope_case("single_defer", single_defer[..], 1, 1, 1);
    string[5] bare_scope_defer = {
        "fn walk(i32[2] values) void {",
        "    {",
        "        defer { for (i32 x : values) { } }",
        "    }",
        "}",
    };
    deferred_scope_case("bare_scope_defer", bare_scope_defer[..], 1, 1, 1);
    string[7] selected_defer = {
        "fn walk(i32[2] values) void {",
        "    $if (true) {",
        "        defer { for (i32 x : values) { } }",
        "    } else {",
        "        defer { for (i32 y : values) { } }",
        "    }",
        "}",
    };
    deferred_scope_case("selected_defer", selected_defer[..], 1, 1, 1);
    string[6] unselected_defer = {
        "fn walk(i32[2] values) void {",
        "    $if (false) {",
        "        defer { for (i32 x : values) { } }",
        "    }",
        "    defer { for (i32 y : values) { } }",
        "}",
    };
    deferred_scope_case("unselected_defer", unselected_defer[..], 1, 1, 1);
    string[9] three_contexts = {
        "fn walk(i32[2] values) void {",
        "    defer {",
        "        defer {",
        "            defer {",
        "                for (i32 x : values) { }",
        "            }",
        "        }",
        "    }",
        "}",
    };
    deferred_scope_case("three_contexts", three_contexts[..], 1, 1, 3);
    string[4] sibling_contexts = {
        "fn walk(i32[2] values) void {",
        "    defer { for (i32 x : values) { } }",
        "    defer { for (i32 y : values) { } }",
        "}",
    };
    deferred_scope_case("sibling_contexts", sibling_contexts[..], 2, 2, 2);
    string[6] shared_context = {
        "fn walk(i32[2] values) void {",
        "    defer {",
        "        for (i32 x : values) { }",
        "        for (i32 y : values) { }",
        "    }",
        "}",
    };
    deferred_scope_case("shared_context", shared_context[..], 2, 2, 1);
    string[5] deferred_owning_span = {
        "fn walk(u8 mut@ own values) void {",
        "    defer {",
        "        for (u8 x : values) { }",
        "    }",
        "}",
    };
    deferred_scope_case("deferred_owning_span", deferred_owning_span[..], 1, 1, 1);
    string[5] deferred_owning_string = {
        "fn walk(string own text) void {",
        "    defer {",
        "        for (char x : text) { }",
        "    }",
        "}",
    };
    deferred_scope_case("deferred_owning_string", deferred_owning_string[..], 1, 1, 1);
    string[5] deferred_borrowed_string = {
        "fn walk(string text) void {",
        "    defer {",
        "        for (char x : text) { }",
        "    }",
        "}",
    };
    deferred_scope_case("deferred_borrowed_string", deferred_borrowed_string[..], 1, 1, 1);
    string[6] deferred_projection = {
        "struct holder { u8 mut@ own items; }",
        "fn walk(holder* h) void {",
        "    defer {",
        "        for (u8 x : h->items) { }",
        "    }",
        "}",
    };
    deferred_scope_case("deferred_projection", deferred_projection[..], 1, 1, 1);
    string[6] while_before_exit = {
        "fn walk(i32[2] values, bool repeat) void {",
        "    defer { for (i32 x : values) { } }",
        "    while (repeat) {",
        "        i32 saved = 0;",
        "    }",
        "}",
    };
    deferred_scope_case("while_before_exit", while_before_exit[..], 1, 1, 1);
    string[6] do_before_exit = {
        "fn walk(i32[2] values, bool repeat) void {",
        "    defer { for (i32 x : values) { } }",
        "    do {",
        "        i32 saved = 0;",
        "    } while (repeat);",
        "}",
    };
    deferred_scope_case("do_before_exit", do_before_exit[..], 1, 1, 1);
    string[6] for_before_exit = {
        "fn walk(i32[2] values) void {",
        "    defer { for (i32 x : values) { } }",
        "    for (i32 mut i = 0; i < 2; i++) {",
        "        i32 saved = i;",
        "    }",
        "}",
    };
    deferred_scope_case("for_before_exit", for_before_exit[..], 1, 1, 1);
    string[6] while_continue_expansions = {
        "fn walk(i32[2] values, bool repeat, bool skip) void {",
        "    while (repeat) {",
        "        defer { for (i32 x : values) { } }",
        "        if (skip) { continue; }",
        "    }",
        "}",
    };
    deferred_scope_case("while_continue_expansions", while_continue_expansions[..], 1, 2, 2);
    string[6] while_break_expansions = {
        "fn walk(i32[2] values, bool repeat, bool stop) void {",
        "    while (repeat) {",
        "        defer { for (i32 x : values) { } }",
        "        if (stop) { break; }",
        "    }",
        "}",
    };
    deferred_scope_case("while_break_expansions", while_break_expansions[..], 1, 2, 2);
    string[6] do_break_expansions = {
        "fn walk(i32[2] values, bool repeat, bool stop) void {",
        "    do {",
        "        defer { for (i32 x : values) { } }",
        "        if (stop) { break; }",
        "    } while (repeat);",
        "}",
    };
    deferred_scope_case("do_break_expansions", do_break_expansions[..], 1, 2, 2);
    string[6] for_continue_expansions = {
        "fn walk(i32[2] values, bool skip) void {",
        "    for (i32 mut i = 0; i < 2; i++) {",
        "        defer { for (i32 x : values) { } }",
        "        if (skip) { continue; }",
        "    }",
        "}",
    };
    deferred_scope_case("for_continue_expansions", for_continue_expansions[..], 1, 2, 2);
    string[9] switch_break_expansions = {
        "fn walk(i32[2] values, i32 tag, bool stop) void {",
        "    switch (tag) {",
        "    case 0:",
        "        defer { for (i32 x : values) { } }",
        "        if (stop) { break; }",
        "    default:",
        "        break;",
        "    }",
        "}",
    };
    deferred_scope_case("switch_break_expansions", switch_break_expansions[..], 1, 2, 2);
    string[12] continue_crosses_switch = {
        "fn walk(i32[2] values, bool repeat, i32 tag) void {",
        "    while (repeat) {",
        "        defer { for (i32 x : values) { } }",
        "        switch (tag) {",
        "        case 0:",
        "            continue;",
        "        default:",
        "            break;",
        "        }",
        "        break;",
        "    }",
        "}",
    };
    deferred_scope_case("continue_crosses_switch", continue_crosses_switch[..], 1, 2, 2);
    string[4] return_and_falloff = {
        "fn walk(i32[2] values, bool stop) void {",
        "    defer { for (i32 x : values) { } }",
        "    if (stop) { return; }",
        "}",
    };
    deferred_scope_case("return_and_falloff", return_and_falloff[..], 1, 2, 2);
    string[8] both_return_arms = {
        "fn walk(i32[2] values, bool stop) void {",
        "    defer { for (i32 x : values) { } }",
        "    if (stop) {",
        "        return;",
        "    } else {",
        "        return;",
        "    }",
        "}",
    };
    deferred_scope_case("both_return_arms", both_return_arms[..], 1, 3, 3);
    string[4] disconnected_defer = {
        "fn walk(i32[2] values) void {",
        "    return;",
        "    defer { for (i32 x : values) { } }",
        "}",
    };
    deferred_scope_case("disconnected_defer", disconnected_defer[..], 1, 1, 1);
    string[7] suppressed_before_produced = {
        "fn walk(i32[2] values) void {",
        "    {",
        "        defer { for (i32 x : values) { } }",
        "        defer panic(\"stop\");",
        "    }",
        "    defer { for (i32 y : values) { } }",
        "}",
    };
    deferred_scope_case("suppressed_before_produced", suppressed_before_produced[..], 2, 1, 3);
    string[7] nested_empty_scopes = {
        "fn walk(i32[2] values) void {",
        "    defer { for (i32 x : values) { } }",
        "    {",
        "        { }",
        "        { i32 value = 0; }",
        "    }",
        "}",
    };
    deferred_scope_case("nested_empty_scopes", nested_empty_scopes[..], 1, 1, 1);
    string[7] nested_range_body_defers = {
        "fn walk(i32[2] values) void {",
        "    defer {",
        "        for (i32 x : values) {",
        "            defer { for (i32 y : values) { } }",
        "        }",
        "    }",
        "}",
    };
    deferred_scope_case("nested_range_body_defers", nested_range_body_defers[..], 2, 2, 2);
}

fn assert_boundary_refusal(ast.node* decl, fir.func* f,
                           fir_lower.range_candidate_set* proposed,
                           fir_lower.range_audit_key expected) void {
    fir_verify.violation mut bad = fir_verify.violation{};
    assert(!fir_verify.find_violation(f, null, &bad));
    fir_lower.range_source_audit mut audit = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&audit);
    assert(!fir_lower.audit_produced_ranges(decl, f, proposed, &audit));
    assert(audit.failure.reason == fir_lower.range_audit_fault.boundary);
    assert(audit.failure.key.declaration == expected.declaration);
    assert(audit.failure.key.expansion == expected.expansion);
    assert(audit.failure.key.context == expected.context);
    assert(audit.failure.key.exit_occurrence == expected.exit_occurrence);
    assert(fir_lower.range_audit_loc_eq(audit.failure.key.source, expected.source));
    assert(fir_lower.range_audit_loc_eq(audit.failure.key.context_source,
                                       expected.context_source));
    assert(fir_lower.range_audit_loc_eq(audit.failure.key.exit_source, expected.exit_source));
    assert_unpublished(f, &audit);
}

fn expansion_gap_damage() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[12] source = {
        "fn walk(i32[2] values, bool skip, bool stop) void {",
        "    for (i32 x : values) {",
        "        defer {",
        "            for (i32 y : values) {",
        "                if (stop) { break; }",
        "            }",
        "        }",
        "        if (skip) { continue; }",
        "    }",
        "}",
        "",
        "",
    };
    lower_env.check_lines(&e, source[..], true);
    ast.node* decl = lower_env.decl(&e, "walk");
    fir.func mut f = fir.func{};
    defer fir.func_free(&f);
    fir_lower.range_candidate_set mut proposed = fir_lower.range_candidate_set{};
    defer fir_lower.range_candidate_set_free(&proposed);
    fir_lower.report mut why = fir_lower.report{};
    assert(fir_lower.lower_function_with_range_candidates(&e.c.ck, decl, &f, &proposed, &why));
    fir_lower.range_source_audit mut audit = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&audit);
    assert(fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert(audit.rows.len == 3 && audit.matched_captures == 3);
    assert(audit.rows.items[1].boundaries_len == 8);
    assert(audit.rows.items[2].boundaries_len == 8);
    fir_lower.range_audit_key expected = audit.rows.items[1].key;
    assert(expected.exit_occurrence == 2);
    assert(audit.rows.items[2].key.exit_occurrence == 7);
    assert(expected.context_source.line == 3 && expected.exit_source.line == 8);
    assert_unpublished(&f, &audit);
    check_output(&e, decl, &f, "expansion_gap_damage", true);
    fir_lower.range_source_audit_free(&audit);
    u64 length = proposed.boundaries.len;
    fir_lower.range_boundary_candidate mut@ own saved =
        new(fir_lower.range_boundary_candidate, length);
    defer del(saved);
    u64 mut i = 0;
    while (i < length) { saved[i] = proposed.boundaries.items[i]; i += 1; }
    u64[3] mut target = {length, length, length};
    u64[3] mut other = {length, length, length};
    u64 mut entry = length;
    u64 mut other_entry = length;
    u64 mut second_gap = length;
    i = 0;
    while (i < length) {
        fir_lower.range_boundary_candidate c = saved[i];
        if (c.boundary.kind == fir.range_boundary_kind.body_entry) {
            if (c.expansion == 2) { entry = i; }
            if (c.expansion == 3) { other_entry = i; }
        }
        if (c.boundary.source.line == 5) {
            if (c.boundary.kind == fir.range_boundary_kind.body_cleanup) {
                if (c.expansion == 2) { target[0] = i; }
                if (c.expansion == 3) { other[0] = i; }
            }
            if (c.boundary.kind == fir.range_boundary_kind.loan_exit) {
                if (c.expansion == 2) { target[1] = i; }
                if (c.expansion == 3) { other[1] = i; }
            }
            if (c.boundary.kind == fir.range_boundary_kind.outer_cleanup) {
                if (c.expansion == 2) { target[2] = i; }
                if (c.expansion == 3) { other[2] = i; }
            }
        } else if (c.expansion == 2
                   && c.boundary.kind == fir.range_boundary_kind.body_cleanup) {
            second_gap = i;
        }
        i += 1;
    }
    assert(entry < length && other_entry < length && second_gap < length);
    i = 0;
    while (i < 3) { assert(target[i] < length && other[i] < length); i += 1; }
    // A candidate body entry cannot select the other expansion's CFG.
    proposed.boundaries.items[entry].boundary = saved[other_entry].boundary;
    proposed.boundaries.items[entry].boundary.loan = 2;
    assert_boundary_refusal(decl, &f, &proposed, expected);
    proposed.boundaries.items[entry] = saved[entry];
    // Copy all three gaps while preserving the target expansion and loan IDs.
    i = 0;
    while (i < 3) {
        proposed.boundaries.items[target[i]].boundary = saved[other[i]].boundary;
        proposed.boundaries.items[target[i]].boundary.loan = 2;
        i += 1;
    }
    assert_boundary_refusal(decl, &f, &proposed, expected);
    i = 0;
    while (i < length) { proposed.boundaries.items[i] = saved[i]; i += 1; }
    // Moving a complete triple by one operation gap still refuses.
    i = 0;
    while (i < 3) { proposed.boundaries.items[target[i]].boundary.position += 1; i += 1; }
    assert_boundary_refusal(decl, &f, &proposed, expected);
    i = 0;
    while (i < length) { proposed.boundaries.items[i] = saved[i]; i += 1; }
    // Reassigning complete triples to the other expansion leaves a required gap.
    i = 0;
    while (i < 3) {
        proposed.boundaries.items[target[i]].expansion = 3;
        proposed.boundaries.items[target[i]].boundary.loan = 3;
        i += 1;
    }
    assert_boundary_refusal(decl, &f, &proposed, expected);
    i = 0;
    while (i < length) { proposed.boundaries.items[i] = saved[i]; i += 1; }
    // Duplicating a complete triple cannot cover a second required gap.
    i = 0;
    while (i < 3) {
        fir_lower.range_boundary_candidate mut duplicate = saved[target[i]];
        duplicate.boundary.order += 30;
        fir_lower.range_boundary_candidate_add(&proposed.boundaries, duplicate);
        i += 1;
    }
    assert_boundary_refusal(decl, &f, &proposed, expected);
    proposed.boundaries.len = length;
    // Remove one complete triple. The remaining candidate subset stays ordered.
    u64 mut written = 0;
    i = 0;
    while (i < length) {
        if (i != target[0] && i != target[1] && i != target[2]) {
            proposed.boundaries.items[written] = saved[i];
            written += 1;
        }
        i += 1;
    }
    assert(written == length - 3);
    proposed.boundaries.len = written;
    assert_boundary_refusal(decl, &f, &proposed, expected);
    proposed.boundaries.len = length;
    i = 0;
    while (i < length) { proposed.boundaries.items[i] = saved[i]; i += 1; }
    // Verified FIR statement tags cannot replace the source exit and CFG proof.
    fir.range_boundary start = saved[target[0]].boundary;
    fir.statement mut* dead = &fir.block_mut(&f, start.block)->statements.items[start.position];
    fir.statement original = *dead;
    dead->stmt += 1;
    assert_boundary_refusal(decl, &f, &proposed, expected);
    *dead = original;
    dead->exit_loc = proposed.captures.items[2].occurrence.exit_source;
    assert_boundary_refusal(decl, &f, &proposed, expected);
    *dead = original;
    fir.range_boundary second = saved[second_gap].boundary;
    fir.statement* other_dead = fir.block_statement(&f, second.block, second.position);
    dead->loc = other_dead->loc;
    assert_boundary_refusal(decl, &f, &proposed, expected);
    *dead = original;
    dead->stmt = other_dead->stmt;
    dead->loc = other_dead->loc;
    assert_boundary_refusal(decl, &f, &proposed, expected);
    *dead = original;
    assert(fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert(audit.rows.len == 3 && audit.matched_boundaries == cast(length, u32));
    assert_unpublished(&f, &audit);
}

fn assert_call_incomplete(ast.node* decl, fir.func* f,
                          fir_lower.range_candidate_set* proposed,
                          fir_lower.range_audit_key expected) void {
    fir_lower.range_source_audit mut audit = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&audit);
    assert(!fir_lower.audit_produced_ranges(decl, f, proposed, &audit));
    assert(audit.failure.reason == fir_lower.range_audit_fault.protected_path);
    assert(audit.rows.len == 0 && audit.matched_captures == 0);
    assert(audit.failure.key.function == expected.function);
    assert(audit.failure.key.declaration == expected.declaration);
    assert(audit.failure.key.expansion == expected.expansion);
    assert(audit.failure.key.context == expected.context);
    assert(audit.failure.key.exit_occurrence == expected.exit_occurrence);
    assert(fir_lower.range_audit_loc_eq(audit.failure.key.source, expected.source));
    assert(fir_lower.range_audit_loc_eq(audit.failure.key.context_source,
                                       expected.context_source));
    assert(fir_lower.range_audit_loc_eq(audit.failure.key.exit_source, expected.exit_source));
    assert_unpublished(f, &audit);
}

fn assert_linear_key(fir_lower.range_audit_key actual, fir_lower.range_audit_key expected) void {
    assert(actual.function == expected.function && actual.declaration == expected.declaration);
    assert(actual.expansion == expected.expansion && actual.context == expected.context);
    assert(actual.exit_occurrence == expected.exit_occurrence);
    assert(fir_lower.range_audit_loc_eq(actual.source, expected.source));
    assert(fir_lower.range_audit_loc_eq(actual.context_source, expected.context_source));
    assert(fir_lower.range_audit_loc_eq(actual.exit_source, expected.exit_source));
}

fn linear_fault(string name, fir_verify.runtime* rt, ast.node* decl, fir.func* f,
                  fir_lower.range_candidate_set* proposed, fir_lower.range_audit_key key,
                  fir_lower.range_audit_fault reason) void {
    fir_verify.violation mut bad = fir_verify.violation{};
    bool verified = !fir_verify.find_violation(f, rt, &bad);
    bool mut llvm_verified = false;
    if (legacy_active && verified) {
        llvm_verified = conditional_verify_damage(legacy_env, decl, f, 100000 + legacy_receipts);
    }
    fir_lower.range_source_audit mut audit = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&audit);
    bool accepted = fir_lower.audit_produced_ranges(decl, f, proposed, &audit);
    if (accepted) { eprintln(name, " accepts a damaged materialization link"); }
    assert(!accepted);
    if (audit.failure.reason != reason) { eprintln(name, " reports a different fault"); }
    assert(audit.failure.reason == reason);
    assert_linear_key(audit.failure.key, key);
    assert_unpublished(f, &audit);
    if (legacy_active) {
        legacy_mutation_receipt(name, f, proposed, &audit, verified, llvm_verified);
    }
    linear_damage_cases += 1;
    if (!verified) { linear_invalid_damage += 1; }
    else { linear_verified_damage += 1; }
}

// Each changed candidate differs from the independently derived binding.
fn linear_candidate_damage(string name, lower_env.env* e, ast.node* decl, fir.func* f,
                             fir_lower.range_candidate_set mut* proposed,
                             fir_lower.range_audit_key key) void {
    fir_lower.range_capture_candidate saved = proposed->captures.items[0];
    proposed->captures.items[0].binding.captured = fir.place_local(0);
    assert(!fir_lower.range_audit_place_eq(f, saved.binding.captured, fir.place_local(0)));
    linear_fault(name, &e->rt, decl, f, proposed, key, fir_lower.range_audit_fault.capture);
    proposed->captures.items[0] = saved;
    if (saved.binding.original_present) {
        proposed->captures.items[0].binding.original = fir.place_local(0);
        assert(!fir_lower.range_audit_place_eq(f, saved.binding.original, fir.place_local(0)));
        linear_fault(name, &e->rt, decl, f, proposed, key,
                     fir_lower.range_audit_fault.protected_path);
        proposed->captures.items[0] = saved;
    }
    proposed->captures.items[0].binding.original_present = !saved.binding.original_present;
    linear_fault(name, &e->rt, decl, f, proposed, key, fir_lower.range_audit_fault.protected_path);
    proposed->captures.items[0] = saved;
    proposed->captures.items[0].binding.kind = fir.range_capture_kind.borrowed_header;
    if (saved.binding.kind == fir.range_capture_kind.borrowed_header) {
        proposed->captures.items[0].binding.kind = fir.range_capture_kind.owning_fixed_array_place;
    }
    linear_fault(name, &e->rt, decl, f, proposed, key, fir_lower.range_audit_fault.capture);
    proposed->captures.items[0] = saved;
    proposed->captures.items[0].binding.source.col += 1;
    linear_fault(name, &e->rt, decl, f, proposed, key, fir_lower.range_audit_fault.capture);
    proposed->captures.items[0] = saved;
    proposed->captures.items[0].declaration += 1;
    linear_fault(name, &e->rt, decl, f, proposed, key, fir_lower.range_audit_fault.expansion_key);
    proposed->captures.items[0] = saved;
    proposed->captures.items[0].occurrence.exit_source.col += 1;
    linear_fault(name, &e->rt, decl, f, proposed, key, fir_lower.range_audit_fault.exit_source);
    proposed->captures.items[0] = saved;
    u64 length = proposed->captures.len;
    proposed->captures.len = 0;
    fir_lower.range_audit_fault mut missing = fir_lower.range_audit_fault.expansion_key;
    if (key.context != 0) { missing = fir_lower.range_audit_fault.context; }
    linear_fault(name, &e->rt, decl, f, proposed, key, missing);
    proposed->captures.len = length;
    u64 boundaries = proposed->boundaries.len;
    proposed->boundaries.len = 0;
    linear_fault(name, &e->rt, decl, f, proposed, key, fir_lower.range_audit_fault.boundary);
    proposed->boundaries.len = boundaries;
}

fn linear_other_parameter(fir.func* f, fir.operand original, fir.operand mut* replacement) bool {
    if (original.kind == fir.operand_kind.ok_const) { return false; }
    u32 mut i = 0;
    while (i < fir.local_count(f)) {
        fir.local* slot = fir.local_at(f, i);
        fir.place candidate = fir.place_local(i);
        if (slot->kind == fir.local_kind.lk_param
            && types.type_equal(slot->ty, fir.operand_type(f, original))
            && !fir_lower.range_audit_place_eq(f, original.place, candidate)) {
            *replacement = fir.operand_copy(candidate);
            return true;
        }
        i += 1;
    }
    return false;
}

fn linear_other_callee(lower_env.env* e, fir.func* f, fir.rvalue value) ast.sym* {
    types.node* signature = fir.callee_type(f, value);
    u64 mut i = 0;
    while (i < check.check_sym_count(&e->c.ck)) {
        ast.sym* s = check.check_sym_at(&e->c.ck, i);
        if (s->kind == ast.sym_kind.s_fn && s != value.callee_sym
            && types.type_equal(s->ty, signature)) { return s; }
        i += 1;
    }
    return null;
}

fn linear_other_field(fir.func mut* f, fir.place original, fir.place mut* replacement) bool {
    if (original.proj_len == 0) { return false; }
    fir.projection selected = fir.place_projection(f, original, original.proj_len - 1);
    if (selected.kind != fir.proj_kind.pj_field) { return false; }
    fir.place mut parent = original;
    parent.proj_len -= 1;
    u32 mut other = 0;
    if (selected.field == 0) { other = 1; }
    fir.proj_fault mut fault = fir.proj_fault.pf_none;
    types.node* ty = fir.projection_type(f, fir.place_type(f, parent),
        fir.projection{fir.proj_kind.pj_field, other, 0}, &fault);
    if (fault != fir.proj_fault.pf_none || !types.type_equal(ty, fir.place_type(f, original))) {
        return false;
    }
    *replacement = fir.place_field(f, parent, other);
    return true;
}

// Mutation probes keep executable FIR damage separate from structural verifier refusals.
fn linear_append(fir.func mut* f, u32 block_index, fir.statement s) void {
    fir.block mut* bk = fir.block_mut(f, block_index);
    fir.statements_reserve(&bk->statements);
    bk->statements.items[bk->statements.len] = s;
    bk->statements.len += 1;
}

// Insert a typed alias write without replacing its call or capture evidence.
fn linear_alias_case(bool projected, bool after, bool deferred) void {
    string[8] mut source = {
        "fn pick(i32@ a, i32@ b) i32@ { return a; }",
        "",
        "fn walk(bool quit, i32@ values, i32@ backup) void {",
        "",
        "    for (i32 x : pick(values, backup)) { }",
        "",
        "    if (quit) { return; }",
        "}",
    };
    if (projected) {
        source[0] = "struct holder { i32@ items; i32@ other; }";
        source[1] = "fn pick(holder a, holder b) holder { return a; }";
        source[2] = "fn walk(bool quit, holder values, holder backup) void {";
        source[4] = "    for (i32 x : pick(values, backup).items) { }";
    }
    if (deferred) { source[3] = "    defer {"; source[5] = "    }"; }
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    lower_env.check_lines(&e, source[..], true);
    ast.node* decl = lower_env.decl(&e, "walk");
    fir.func mut f = fir.func{};
    defer fir.func_free(&f);
    fir_lower.range_candidate_set mut proposed = fir_lower.range_candidate_set{};
    defer fir_lower.range_candidate_set_free(&proposed);
    fir_lower.report mut why = fir_lower.report{};
    assert(fir_lower.lower_function_with_range_candidates(&e.c.ck, decl, &f, &proposed, &why));
    fir_lower.range_source_audit mut original = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&original);
    assert(fir_lower.audit_produced_ranges(decl, &f, &proposed, &original));
    fir_lower.range_audit_key key = original.rows.items[0].key;
    fir_lower.range_material_point mut at = fir_lower.range_material_point{};
    fir.statement mut called = fir.statement{};
    u32 mut calls = 0;
    u32 mut b = 0;
    while (b < fir.block_count(&f)) {
        u32 mut p = 0;
        while (p < fir.block_statement_count(&f, b)) {
            fir.statement* s = fir.block_statement(&f, b, p);
            if (s->kind == fir.stmt_kind.st_assign && s->value.kind == fir.rvalue_kind.rv_call
                && fir_lower.range_audit_loc_eq(s->exit_loc, key.exit_source)) {
                at = fir_lower.range_material_point{.block = b, .position = p + 1};
                called = *s;
                calls += 1;
            }
            p += 1;
        }
        b += 1;
    }
    assert(calls == 1 && called.place.proj_len == 0);
    fir.operand backup = fir.operand_at(&f, called.value.ops_first + 1);
    fir.place mut target = called.place;
    fir.place mut replacement = backup.place;
    if (projected) {
        target = fir.place_field(&f, target, 0);
        replacement = fir.place_field(&f, replacement, 0);
    }
    if (after) {
        u64 mut i = 0;
        u32 mut captures = 0;
        while (i < proposed.boundaries.len) {
            fir_lower.range_boundary_candidate* c = &proposed.boundaries.items[i];
            if (c->expansion == key.expansion
                && c->boundary.kind == fir.range_boundary_kind.capture) {
                at = fir_lower.range_material_point{
                    .block = c->boundary.block, .position = c->boundary.position};
                captures += 1;
            }
            i += 1;
        }
        assert(captures == 1);
    }
    fir.rvalue address = fir.rvalue_addr(&f, target, true);
    u32 alias = fir.local_add(&f, fir.rvalue_type(&f, address),
                              fir.local_kind.lk_temp, null, called.loc);
    fir.statement mut take = fir.stmt_assign(fir.place_local(alias), address,
                                             called.loc, called.stmt);
    take.exit_loc = called.exit_loc;
    fir.place indirect = fir.place_deref(&f, fir.place_local(alias));
    fir.statement mut write = fir.stmt_assign(indirect,
        fir.rvalue_use(&f, fir.operand_copy(replacement)), called.loc, called.stmt);
    write.exit_loc = called.exit_loc;
    assert(fir.place_fixed(&f, target) && indirect.local != target.local);
    linear_append(&f, at.block, take);
    linear_append(&f, at.block, write);
    fir.block mut* bk = fir.block_mut(&f, at.block);
    u64 mut p = bk->statements.len - 2;
    while (p > cast(at.position, u64)) {
        p -= 1;
        bk->statements.items[p + 2] = bk->statements.items[p];
    }
    bk->statements.items[at.position] = take;
    bk->statements.items[at.position + 1] = write;
    u64 mut i = 0;
    while (i < proposed.boundaries.len) {
        fir.range_boundary mut* bd = &proposed.boundaries.items[i].boundary;
        if (bd->block == at.block
            && (bd->position > at.position || (!after && bd->position == at.position))) {
            bd->position += 2;
        }
        i += 1;
    }
    fir_verify.violation mut bad = fir_verify.violation{};
    assert(!fir_verify.find_violation(&f, &e.rt, &bad));
    eprintln("valid alias FIR projected ", projected, " after ", after, " deferred ", deferred);
    linear_fault("temporary alias", &e.rt, decl, &f, &proposed, key,
                 fir_lower.range_audit_fault.protected_path);
    fir_lower.range_candidate_set_free(&proposed);
    assert_unpublished(&f, &original);
    assert_linear_key(original.rows.items[0].key, key);
}

fn linear_alias_matrix() void {
    u32 mut mode = 0;
    while (mode < 8) {
        linear_alias_case((mode & 1) != 0, (mode & 2) != 0, (mode & 4) != 0);
        mode += 1;
    }
}

// A fixed-array slice reaches inline storage. Other slices retain backing storage.
fn linear_slice_case(u32 shape, bool after, bool deferred, bool mutable_alias) void {
    string[8] mut source = {
        "fn pick(i32@[2] a, i32@[2] b) i32@[2] { return a; }",
        "",
        "fn walk(bool quit, i32@[2] values, i32@[2] backup) void {",
        "",
        "    for (i32 x : pick(values, backup)[0]) { }",
        "",
        "    if (quit) { return; }",
        "}",
    };
    if (shape == 1) {
        source[0] = "struct holder { i32@[2] lists; i32@[2] other; }";
        source[1] = "fn pick(holder a, holder b) holder { return a; }";
        source[2] = "fn walk(bool quit, holder values, holder backup) void {";
        source[4] = "    for (i32 x : pick(values, backup).lists[0]) { }";
    } else if (shape == 2) {
        source[0] = "fn pick(i32@ a, i32@ b) i32@ { return a; }";
        source[2] = "fn walk(bool quit, i32@ values, i32@ backup) void {";
        source[4] = "    for (i32 x : pick(values, backup)) { }";
    } else if (shape == 3) {
        source[0] = "fn pick(i32@[2]* a, i32@[2]* b) i32@[2]* { return a; }";
        source[2] = "fn walk(bool quit, i32@[2]* values, i32@[2]* backup) void {";
        source[4] = "    for (i32 x : (*pick(values, backup))[0]) { }";
    }
    if (deferred) { source[3] = "    defer {"; source[5] = "    }"; }
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    lower_env.check_lines(&e, source[..], true);
    ast.node* decl = lower_env.decl(&e, "walk");
    fir.func mut f = fir.func{};
    defer fir.func_free(&f);
    fir_lower.range_candidate_set mut proposed = fir_lower.range_candidate_set{};
    defer fir_lower.range_candidate_set_free(&proposed);
    fir_lower.report mut why = fir_lower.report{};
    assert(fir_lower.lower_function_with_range_candidates(&e.c.ck, decl, &f, &proposed, &why));
    fir_lower.range_source_audit mut original = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&original);
    assert(fir_lower.audit_produced_ranges(decl, &f, &proposed, &original));
    fir_lower.range_audit_key key = original.rows.items[0].key;
    fir_lower.range_material_point mut at = fir_lower.range_material_point{};
    fir.statement mut called = fir.statement{};
    fir.place mut index = fir.place{};
    u32 mut calls = 0;
    u32 mut indices = 0;
    u32 mut b = 0;
    while (b < fir.block_count(&f)) {
        u32 mut p = 0;
        while (p < fir.block_statement_count(&f, b)) {
            fir.statement* s = fir.block_statement(&f, b, p);
            if (s->kind == fir.stmt_kind.st_assign
                && fir_lower.range_audit_loc_eq(s->exit_loc, key.exit_source)) {
                if (s->value.kind == fir.rvalue_kind.rv_call) {
                    called = *s;
                    calls += 1;
                    if (shape == 2) {
                        at = fir_lower.range_material_point{.block = b, .position = p + 1};
                    }
                } else if (s->value.kind == fir.rvalue_kind.rv_cast
                    && s->value.ty->kind == types.type_kind.k_prim
                    && s->value.ty->prim == prim.prim_kind.prim_u64) {
                    index = s->place;
                    at = fir_lower.range_material_point{.block = b, .position = p + 1};
                    indices += 1;
                }
            }
            p += 1;
        }
        b += 1;
    }
    assert(calls == 1 && (shape == 2 || indices == 1));
    fir.place mut target = called.place;
    fir.place mut replacement = fir.operand_at(&f, called.value.ops_first + 1).place;
    if (shape == 1) {
        target = fir.place_field(&f, target, 0);
        replacement = fir.place_field(&f, replacement, 0);
    } else if (shape == 3) {
        target = fir.place_deref(&f, target);
    }
    if (after) {
        u64 mut i = 0;
        u32 mut captures = 0;
        while (i < proposed.boundaries.len) {
            fir_lower.range_boundary_candidate* c = &proposed.boundaries.items[i];
            if (c->expansion == key.expansion
                && c->boundary.kind == fir.range_boundary_kind.capture) {
                at = fir_lower.range_material_point{
                    .block = c->boundary.block, .position = c->boundary.position + 1};
                captures += 1;
            }
            i += 1;
        }
        assert(captures == 1);
    }
    types.node* wide = types.type_prim(f.tt, prim.prim_kind.prim_u64);
    fir.rvalue sliced = fir.rvalue_slice(&f, target, fir_lower.int_const(wide, false, 0),
        fir_lower.int_const(wide, false, 2), mutable_alias);
    u32 alias = fir.local_add(&f, fir.rvalue_type(&f, sliced),
                              fir.local_kind.lk_temp, null, called.loc);
    fir.statement mut take = fir.stmt_assign(fir.place_local(alias), sliced,
                                             called.loc, called.stmt);
    take.exit_loc = called.exit_loc;
    u32 mut inserted = 1;
    fir.statement mut write = fir.statement{};
    if (shape < 2 && mutable_alias) {
        fir.place indirect = fir.place_index(&f, fir.place_local(alias), index.local);
        fir.place backup = fir.place_index(&f, replacement, index.local);
        write = fir.stmt_assign(indirect, fir.rvalue_use(&f, fir.operand_copy(backup)),
                                called.loc, called.stmt);
        write.exit_loc = called.exit_loc;
        assert(indirect.local != target.local && !fir.place_fixed(&f, indirect));
        inserted = 2;
    }
    linear_append(&f, at.block, take);
    if (inserted == 2) { linear_append(&f, at.block, write); }
    fir.block mut* bk = fir.block_mut(&f, at.block);
    u64 mut p = bk->statements.len - cast(inserted, u64);
    while (p > cast(at.position, u64)) {
        p -= 1;
        bk->statements.items[p + cast(inserted, u64)] = bk->statements.items[p];
    }
    bk->statements.items[at.position] = take;
    if (inserted == 2) { bk->statements.items[at.position + 1] = write; }
    u64 mut i = 0;
    while (i < proposed.boundaries.len) {
        fir.range_boundary mut* bd = &proposed.boundaries.items[i].boundary;
        if (bd->block == at.block
            && (bd->position > at.position || (!after && bd->position == at.position))) {
            bd->position += inserted;
        }
        i += 1;
    }
    fir_verify.violation mut bad = fir_verify.violation{};
    assert(!fir_verify.find_violation(&f, &e.rt, &bad));
    eprintln("valid slice FIR shape ", shape, " after ", after, " deferred ", deferred,
             " mutable ", mutable_alias);
    if (shape < 2) {
        assert(fir.place_fixed(&f, target));
        linear_fault("temporary slice alias", &e.rt, decl, &f, &proposed, key,
                     fir_lower.range_audit_fault.protected_path);
    } else {
        assert(shape == 2 || !fir.place_fixed(&f, target));
        fir_lower.range_source_audit mut restored = fir_lower.range_source_audit{};
        defer fir_lower.range_source_audit_free(&restored);
        assert(fir_lower.audit_produced_ranges(decl, &f, &proposed, &restored));
        assert(restored.rows.len == original.rows.len);
        assert_linear_key(restored.rows.items[0].key, key);
        assert_unpublished(&f, &restored);
    }
    fir_lower.range_candidate_set_free(&proposed);
    assert_unpublished(&f, &original);
    assert_linear_key(original.rows.items[0].key, key);
}

fn linear_slice_matrix() void {
    u32 mut mode = 0;
    while (mode < 8) {
        u32 mut shape = 0;
        while (shape < 4) {
            bool mutable_alias = shape < 2;
            linear_slice_case(shape, (mode & 2) != 0, (mode & 4) != 0, mutable_alias);
            if (shape < 2) {
                linear_slice_case(shape, (mode & 2) != 0, (mode & 4) != 0, false);
            }
            shape += 1;
        }
        mode += 2;
    }
}

fn linear_statement_damage(string name, lower_env.env* e, ast.node* decl, fir.func* f,
                             fir_lower.range_candidate_set* proposed,
                             fir_lower.range_audit_key key, u32 statement_index) void {
    u32 mut b = 0;
    while (b < fir.block_count(f)) {
        u32 mut p = 0;
        while (p < fir.block_statement_count(f, b)) {
            fir.statement saved = *fir.block_statement(f, b, p);
            if (saved.kind != fir.stmt_kind.st_assign || saved.stmt != statement_index
                || !fir_lower.range_audit_loc_eq(saved.exit_loc, key.exit_source)
                || saved.place.base != fir.base_kind.bk_local || saved.place.proj_len != 0
                || fir.local_at(f, saved.place.local)->kind != fir.local_kind.lk_temp
                || fir_lower.range_audit_counter(f, &saved)) { p += 1; continue; }
            if (saved.value.kind == fir.rvalue_kind.rv_cast
                && saved.value.ty->kind == types.type_kind.k_prim
                && saved.value.ty->prim == prim.prim_kind.prim_i64) { p += 1; continue; }
            bool link = saved.value.kind == fir.rvalue_kind.rv_call
                || saved.value.kind == fir.rvalue_kind.rv_addr
                || saved.value.kind == fir.rvalue_kind.rv_cast
                || saved.value.kind == fir.rvalue_kind.rv_slice
                || saved.value.kind == fir.rvalue_kind.rv_slice_ptr
                || (saved.value.kind == fir.rvalue_kind.rv_use
                    && saved.value.ops_len == 1);
            if (!link) { p += 1; continue; }
            // Location, statement, and exit substitutions keep the full source failure key.
            u32 mut mode = 0;
            while (mode < 3) {
                fir.func mut damaged = fir.func_clone(f);
                defer fir.func_free(&damaged);
                fir.statement mut* edited = &fir.block_mut(&damaged, b)->statements.items[p];
                if (mode == 0) { edited->loc.col += 1; }
                else if (mode == 1) { edited->stmt += 1; }
                else { edited->exit_loc.col += 1; }
                linear_fault(name, &e->rt, decl, &damaged, proposed, key,
                             fir_lower.range_audit_fault.protected_path);
                mode += 1;
            }
            // A second complete write cannot replace unique reaching-definition evidence.
            fir.func mut duplicate = fir.func_clone(f);
            defer fir.func_free(&duplicate);
            linear_append(&duplicate, b, saved);
            linear_fault(name, &e->rt, decl, &duplicate, proposed, key,
                         fir_lower.range_audit_fault.protected_path);
            // An overwritten temporary remains ambiguous even when the write follows capture.
            fir.func mut overwritten = fir.func_clone(f);
            defer fir.func_free(&overwritten);
            fir.statement mut changed = saved;
            changed.value = fir.rvalue_use(&overwritten,
                fir.operand_const(fir.const_zero(fir.place_type(f, saved.place))));
            linear_append(&overwritten, b, changed);
            linear_fault(name, &e->rt, decl, &overwritten, proposed, key,
                         fir_lower.range_audit_fault.protected_path);
            // Removing the definition preserves the remaining operation tags.
            fir.func mut missing = fir.func_clone(f);
            defer fir.func_free(&missing);
            fir.block mut* bk = fir.block_mut(&missing, b);
            u64 mut at = cast(p, u64);
            while (at + 1 < bk->statements.len) {
                bk->statements.items[at] = bk->statements.items[at + 1];
                at += 1;
            }
            bk->statements.len -= 1;
            linear_fault(name, &e->rt, decl, &missing, proposed, key,
                         fir_lower.range_audit_fault.protected_path);
            // A definition cannot follow a materialization that consumes it.
            u32 mut next = p + 1;
            while (next < fir.block_statement_count(f, b)) {
                fir.statement later = *fir.block_statement(f, b, next);
                bool material = later.value.kind == fir.rvalue_kind.rv_call
                    || later.value.kind == fir.rvalue_kind.rv_addr
                    || later.value.kind == fir.rvalue_kind.rv_slice
                    || later.value.kind == fir.rvalue_kind.rv_slice_ptr
                    || (later.value.kind == fir.rvalue_kind.rv_use && later.value.ops_len == 1)
                    || (later.value.kind == fir.rvalue_kind.rv_cast
                        && !(later.value.ty->kind == types.type_kind.k_prim
                            && later.value.ty->prim == prim.prim_kind.prim_i64));
                if (later.kind == fir.stmt_kind.st_assign && later.stmt == statement_index
                    && fir_lower.range_audit_loc_eq(later.exit_loc, key.exit_source)
                    && !fir_lower.range_audit_counter(f, &later) && material) {
                    fir.func mut reordered = fir.func_clone(f);
                    defer fir.func_free(&reordered);
                    fir.block_mut(&reordered, b)->statements.items[p] = later;
                    fir.block_mut(&reordered, b)->statements.items[next] = saved;
                    linear_fault(name, &e->rt, decl, &reordered, proposed, key,
                                 fir_lower.range_audit_fault.protected_path);
                    break;
                }
                next += 1;
            }
            if (saved.value.kind == fir.rvalue_kind.rv_addr
                || saved.value.kind == fir.rvalue_kind.rv_slice) {
                fir.operand mut replacement = fir.operand{};
                if (linear_other_parameter(f, fir.operand_copy(saved.value.place), &replacement)) {
                    fir.func mut address = fir.func_clone(f);
                    defer fir.func_free(&address);
                    fir.statement mut* edited = &fir.block_mut(&address, b)->statements.items[p];
                    edited->value.place = replacement.place;
                    linear_fault(name, &e->rt, decl, &address, proposed, key,
                                 fir_lower.range_audit_fault.protected_path);
                }
                fir.func mut projected = fir.func_clone(f);
                defer fir.func_free(&projected);
                fir.place mut other = fir.place{};
                if (linear_other_field(&projected, saved.value.place, &other)) {
                    fir.statement mut* edited =
                        &fir.block_mut(&projected, b)->statements.items[p];
                    edited->value.place = other;
                    linear_fault(name, &e->rt, decl, &projected, proposed, key,
                                 fir_lower.range_audit_fault.protected_path);
                }
            }
            if (saved.value.kind == fir.rvalue_kind.rv_call) {
                // A same-type unused result cannot provide a second source-call identity.
                fir.func mut extra = fir.func_clone(f);
                defer fir.func_free(&extra);
                u32 slot = fir.local_add(&extra, fir.place_type(f, saved.place),
                                         fir.local_kind.lk_temp, null, saved.loc);
                fir.statement mut copied = saved;
                copied.place = fir.place_local(slot);
                linear_append(&extra, b, copied);
                linear_fault(name, &e->rt, decl, &extra, proposed, key,
                             fir_lower.range_audit_fault.protected_path);
                ast.sym* other = linear_other_callee(e, f, saved.value);
                if (other != null) {
                    fir.func mut callee = fir.func_clone(f);
                    defer fir.func_free(&callee);
                    fir.statement mut* called = &fir.block_mut(&callee, b)->statements.items[p];
                    called->value.callee = fir.callee_kind.cl_fn;
                    called->value.callee_sym = other;
                    linear_fault(name, &e->rt, decl, &callee, proposed, key,
                                 fir_lower.range_audit_fault.protected_path);
                }
                fir.operand mut replacement = fir.operand{};
                if (saved.value.callee == fir.callee_kind.cl_value
                    && linear_other_parameter(f, saved.value.callee_op, &replacement)) {
                    fir.func mut callee = fir.func_clone(f);
                    defer fir.func_free(&callee);
                    fir.statement mut* called = &fir.block_mut(&callee, b)->statements.items[p];
                    called->value.callee_op = replacement;
                    linear_fault(name, &e->rt, decl, &callee, proposed, key,
                                 fir_lower.range_audit_fault.protected_path);
                }
            }
            u32 mut i = 0;
            while (i < saved.value.ops_len) {
                fir.operand original = fir.operand_at(f, saved.value.ops_first + i);
                fir.operand mut replacement = fir.operand{};
                if (linear_other_parameter(f, original, &replacement)) {
                    fir.func mut operand = fir.func_clone(f);
                    defer fir.func_free(&operand);
                    operand.ops.items[saved.value.ops_first + i] = replacement;
                    linear_fault(name, &e->rt, decl, &operand, proposed, key,
                                 fir_lower.range_audit_fault.protected_path);
                }
                if (original.kind != fir.operand_kind.ok_const) {
                    fir.func mut projected = fir.func_clone(f);
                    defer fir.func_free(&projected);
                    fir.place mut other = fir.place{};
                    if (linear_other_field(&projected, original.place, &other)) {
                        projected.ops.items[saved.value.ops_first + i] = fir.operand_copy(other);
                        linear_fault(name, &e->rt, decl, &projected, proposed, key,
                                     fir_lower.range_audit_fault.protected_path);
                    }
                }
                i += 1;
            }
            p += 1;
        }
        b += 1;
    }
}

fn linear_damage(string name, lower_env.env* e, ast.node* decl, fir.func* f,
                   fir_lower.range_candidate_set mut* proposed,
                   fir_lower.range_source_audit* audit) void {
    fir_lower.range_audit_key key = audit->rows.items[0].key;
    if (legacy_active) {
        strbuf.clear(&legacy_before);
        conditional_snapshot(f, &legacy_before);
        conditional_candidate_snapshot(f, proposed, &legacy_before);
    }
    linear_candidate_damage(name, e, decl, f, proposed, key);
    u32 mut statement_index = 0;
    u32 mut b = 0;
    while (b < fir.block_count(f)) {
        u32 mut p = 0;
        while (p < fir.block_statement_count(f, b)) {
            fir.statement* s = fir.block_statement(f, b, p);
            if (fir_lower.range_audit_counter(f, s)
                && fir_lower.range_audit_loc_eq(s->loc, key.source)
                && fir_lower.range_audit_loc_eq(s->exit_loc, key.exit_source)) {
                assert(statement_index == 0);
                statement_index = s->stmt;
            }
            p += 1;
        }
        b += 1;
    }
    assert(statement_index != 0);
    linear_statement_damage(name, e, decl, f, proposed, key, statement_index);
    fir_lower.range_source_audit mut restored = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&restored);
    assert(fir_lower.audit_produced_ranges(decl, f, proposed, &restored));
    assert(restored.rows.len == audit->rows.len);
    assert_linear_key(restored.rows.items[0].key, key);
    assert_unpublished(f, &restored);
}

fn call_materialization_case(string name, string@ source, u32 source_line,
                              u32 context_line, bool accepted) void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    lower_env.check_lines(&e, source, true);
    ast.node* decl = lower_env.decl(&e, "walk");
    fir.func mut f = fir.func{};
    defer fir.func_free(&f);
    fir_lower.range_candidate_set mut proposed = fir_lower.range_candidate_set{};
    defer fir_lower.range_candidate_set_free(&proposed);
    fir_lower.report mut why = fir_lower.report{};
    assert(fir_lower.lower_function_with_range_candidates(&e.c.ck, decl, &f, &proposed, &why));
    fir_verify.violation mut bad = fir_verify.violation{};
    assert(!fir_verify.find_violation(&f, &e.rt, &bad));
    fir_lower.range_source_audit mut audit = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&audit);
    bool incomplete = !fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit);
    if (accepted) {
        if (incomplete) { eprintln(name, " refuses a proved linear path"); }
        assert(!incomplete);
        assert(audit.rows.len == 1 && audit.matched_captures == 1);
        assert_unpublished(&f, &audit);
        if (legacy_active) { legacy_env = &e; }
        linear_damage(name, &e, decl, &f, &proposed, &audit);
        legacy_env = null;
        check_output(&e, decl, &f, name, true);
        if (decl->b != null && source_line == 5) {
            fir_lower.range_candidate_set_free(&proposed);
            conditional_receipt(name, &f, &audit, true);
        }
        return;
    }
    if (!incomplete) { eprintln(name, " accepts an unproved protected path"); }
    assert(incomplete);
    assert(audit.failure.reason == fir_lower.range_audit_fault.protected_path);
    assert(audit.selected_declarations == 1 && audit.produced_expansions == 1);
    assert(audit.rows.len == 0 && audit.matched_captures == 0);
    fir_lower.range_audit_key expected = audit.failure.key;
    assert(expected.source.line == source_line);
    assert(expected.context_source.line == context_line);
    if (context_line == 0) {
        assert(expected.context == 0 && expected.exit_occurrence == 0);
        assert(expected.exit_source.line == 0);
    } else {
        assert(expected.context != 0 && expected.exit_occurrence != 0);
        assert(expected.exit_source.line != 0);
    }
    assert_unpublished(&f, &audit);
    check_output(&e, decl, &f, name, true);
    fir_lower.range_source_audit_free(&audit);
    assert(proposed.captures.len == 1);
    fir_lower.range_capture_candidate saved = proposed.captures.items[0];
    // A substituted protected root remains incomplete before binding acceptance.
    proposed.captures.items[0].binding.original = saved.binding.captured;
    assert_call_incomplete(decl, &f, &proposed, expected);
    proposed.captures.items[0] = saved;
    proposed.captures.items[0].binding.original = fir.place_local(1);
    assert_call_incomplete(decl, &f, &proposed, expected);
    proposed.captures.items[0] = saved;
    proposed.captures.items[0].binding.captured = saved.binding.original;
    assert_call_incomplete(decl, &f, &proposed, expected);
    proposed.captures.items[0] = saved;
    proposed.captures.items[0].binding.original_present = false;
    assert_call_incomplete(decl, &f, &proposed, expected);
    proposed.captures.items[0] = saved;
    // Deleting a candidate cannot promote a call-result path to source acceptance.
    proposed.captures.len = 0;
    assert_call_incomplete(decl, &f, &proposed, expected);
    proposed.captures.len = 1;
    // Delete each boundary set while preserving the valid executable function.
    u64 boundaries = proposed.boundaries.len;
    proposed.boundaries.len = 0;
    assert_call_incomplete(decl, &f, &proposed, expected);
    proposed.boundaries.len = boundaries;
    assert_call_incomplete(decl, &f, &proposed, expected);
    assert(!fir_verify.find_violation(&f, &e.rt, &bad));
    fir_lower.range_source_audit mut retained = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&retained);
    assert(!fir_lower.audit_produced_ranges(decl, &f, &proposed, &retained));
    fir_lower.range_candidate_set_free(&proposed);
    assert_linear_key(retained.failure.key, expected);
    conditional_receipt(name, &f, &retained, false);
}

fn call_materialization_matrix() void {
    string[5] returned_span = {
        "fn pick(i32@ values) i32@ { return values; }",
        "fn walk(i32@ values) void {",
        "    for (i32 x : pick(values)) { }",
        "}",
        "",
    };
    call_materialization_case("call_returned_span", returned_span[..], 3, 0, true);
    string[5] returned_string = {
        "fn pick(string text) string { return text; }",
        "fn walk(string text) void {",
        "    for (char x : pick(text)) { }",
        "}",
        "",
    };
    call_materialization_case("call_returned_string", returned_string[..], 3, 0, true);
    string[6] pointer_result = {
        "struct holder { i32@ items; i32@ other; }",
        "fn pick(holder* h) holder* { return h; }",
        "fn walk(holder* h) void {",
        "    for (i32 x : pick(h)->items) { }",
        "}",
        "",
    };
    call_materialization_case("call_pointer_result", pointer_result[..], 4, 0, true);
    string[7] projected_result = {
        "struct inner { i32@ items; }",
        "struct holder { inner data; }",
        "fn pick(holder* h) holder* { return h; }",
        "fn walk(holder* h) void {",
        "    for (i32 x : pick(h)->data.items) { }",
        "}",
        "",
    };
    call_materialization_case("call_projected_result", projected_result[..], 5, 0, true);
    string[8] deferred_result = {
        "struct holder { i32@ items; }",
        "fn pick(holder* h) holder* { return h; }",
        "fn walk(holder* h) void {",
        "    defer {",
        "        for (i32 x : pick(h)->items) { }",
        "    }",
        "}",
        "",
    };
    call_materialization_case("call_deferred_result", deferred_result[..], 5, 4, true);
}

// The direct and deferred paths use the same checked expression and distinct exit evidence.
fn linear_materialization_pair(string name, string@ prelude, string parameters,
                                  string element, string expression) void {
    strbuf.str_buf mut header = strbuf.create();
    defer strbuf.free(&header);
    strbuf.append(&header, "fn walk(bool quit, ");
    strbuf.append(&header, parameters);
    strbuf.append(&header, ") void {");
    strbuf.str_buf mut loop = strbuf.create();
    defer strbuf.free(&loop);
    strbuf.append(&loop, "        for (");
    strbuf.append(&loop, element);
    strbuf.append(&loop, " x : ");
    strbuf.append(&loop, expression);
    strbuf.append(&loop, ") { }");
    u32 mut mode = 0;
    while (mode < 2) {
        string mut@ own source = new(string, prelude.len + 7);
        defer del(source);
        u64 mut i = 0;
        while (i < prelude.len) { source[i] = prelude[i]; i += 1; }
        source[i] = strbuf.view(&header);
        source[i + 1] = "";
        source[i + 2] = strbuf.view(&loop);
        source[i + 3] = "";
        source[i + 4] = "    if (quit) { return; }";
        source[i + 5] = "}";
        source[i + 6] = "";
        strbuf.str_buf mut key = strbuf.create();
        defer strbuf.free(&key);
        strbuf.append(&key, "linear_");
        strbuf.append(&key, name);
        u32 mut context_line = 0;
        u64 mut expected_rows = 1;
        if (mode == 0) { strbuf.append(&key, "_direct"); }
        else {
            source[i + 1] = "    defer {";
            source[i + 3] = "    }";
            context_line = cast(i + 2, u32);
            expected_rows = 2;
            strbuf.append(&key, "_deferred");
        }
        lower_env.env mut e = lower_env.env{};
        lower_env.open(&e);
        defer lower_env.close(&e);
        lower_env.check_lines(&e, source, true);
        ast.node* decl = lower_env.decl(&e, "walk");
        fir.func mut f = fir.func{};
        defer fir.func_free(&f);
        fir_lower.range_candidate_set mut proposed = fir_lower.range_candidate_set{};
        defer fir_lower.range_candidate_set_free(&proposed);
        fir_lower.report mut why = fir_lower.report{};
        assert(fir_lower.lower_function_with_range_candidates(&e.c.ck, decl, &f, &proposed, &why));
        fir_lower.range_source_audit mut audit = fir_lower.range_source_audit{};
        defer fir_lower.range_source_audit_free(&audit);
        bool matched = fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit);
        if (!matched) { eprintln(strbuf.view(&key), " refuses a proved linear path"); }
        assert(matched);
        assert(audit.rows.len == expected_rows && proposed.captures.len == expected_rows);
        assert(audit.matched_captures == cast(expected_rows, u32));
        assert(audit.matched_boundaries == cast(proposed.boundaries.len, u32));
        u64 mut row = 0;
        while (row < expected_rows) {
            fir_lower.range_audit_key actual = audit.rows.items[row].key;
            assert(actual.source.line == cast(i + 3, u32));
            assert(actual.context_source.line == context_line);
            if (mode == 0) {
                assert(actual.context == 0 && actual.exit_occurrence == 0);
                assert(actual.exit_source.line == 0);
            } else {
                assert(actual.context != 0 && actual.exit_occurrence != 0);
                assert(actual.exit_source.line != 0);
                if (row != 0) {
                    assert(actual.exit_occurrence != audit.rows.items[row - 1].key.exit_occurrence);
                }
            }
            row += 1;
        }
        assert_unpublished(&f, &audit);
        linear_damage(strbuf.view(&key), &e, decl, &f, &proposed, &audit);
        check_output(&e, decl, &f, strbuf.view(&key), true);
        fir_lower.range_candidate_set_free(&proposed);
        assert(audit.rows.len == expected_rows);
        assert_unpublished(&f, &audit);
        linear_pairs += 1;
        linear_rows += cast(expected_rows, u32);
        mode += 1;
    }
}

fn linear_materialization_matrix() void {
    string[2] returned_span = {
        "fn pick(i32@ a, i32@ b) i32@ { return a; }",
        "fn spare(i32@ a, i32@ b) i32@ { return b; }",
    };
    linear_materialization_pair("returned_span", returned_span[..],
        "i32@ values, i32@ backup", "i32",
        "pick(values, backup)");
    string[2] returned_string = {
        "fn pick(string a, string b) string { return a; }",
        "fn spare(string a, string b) string { return b; }",
    };
    linear_materialization_pair("returned_string", returned_string[..],
        "string values, string backup", "char",
        "pick(values, backup)");
    string[2] dereferenced_header = {
        "fn pick(i32@* a, i32@* b) i32@* { return a; }",
        "fn spare(i32@* a, i32@* b) i32@* { return b; }",
    };
    linear_materialization_pair("dereferenced_header", dereferenced_header[..],
        "i32@* values, i32@* backup", "i32",
        "*pick(values, backup)");
    string[3] projected_aggregate = {
        "struct holder { i32@ items; i32@ other; }",
        "fn pick(holder a, holder b) holder { return a; }",
        "fn spare(holder a, holder b) holder { return b; }",
    };
    linear_materialization_pair("projected_aggregate", projected_aggregate[..],
        "holder values, holder backup", "i32",
        "pick(values, backup).items");
    string[2] cast_result = {
        "fn pick(i32@ a, i32@ b) i32@ { return a; }",
        "fn spare(i32@ a, i32@ b) i32@ { return b; }",
    };
    linear_materialization_pair("cast_result", cast_result[..],
        "i32@ values, i32@ backup", "i32",
        "cast(pick(values, backup), i32@)");
    string[2] nested_call_argument = {
        "fn pick(i32@ a, i32@ b) i32@ { return a; }",
        "fn spare(i32@ a, i32@ b) i32@ { return b; }",
    };
    linear_materialization_pair("nested_call_argument", nested_call_argument[..],
        "i32@ values, i32@ backup", "i32",
        "pick(values, pick(values, backup))");
    string[2] indirect_callee = {
        "fn pick(i32@ a, i32@ b) i32@ { return a; }",
        "fn spare(i32@ a, i32@ b) i32@ { return b; }",
    };
    linear_materialization_pair("indirect_callee", indirect_callee[..],
        "fn (i32@, i32@) i32@ op, fn (i32@, i32@) i32@ other, i32@ values, i32@ backup", "i32",
        "op(values, backup)");
    string[2] held_callee = {
        "fn pick(i32@ a, i32@ b) i32@ { return a; }",
        "fn spare(i32@ a, i32@ b) i32@ { return b; }",
    };
    linear_materialization_pair("held_callee", held_callee[..],
        "fn (i32@, i32@) i32@ op, fn (i32@, i32@) i32@ other, i32@ values, i32@ backup", "i32",
        "op(pick(values, backup), backup)");
    string[2] returned_array_value = {
        "fn pick(i32[2] a, i32[2] b) i32[2] { return a; }",
        "fn spare(i32[2] a, i32[2] b) i32[2] { return b; }",
    };
    linear_materialization_pair("returned_array_value", returned_array_value[..],
        "i32[2] values, i32[2] backup", "i32",
        "pick(values, backup)");
    string[4] chained_projection = {
        "struct inner { i32@ items; i32@ other; }",
        "struct holder { inner data; }",
        "fn pick(holder* a, holder* b) holder* { return a; }",
        "fn spare(holder* a, holder* b) holder* { return b; }",
    };
    linear_materialization_pair("chained_projection", chained_projection[..],
        "holder* values, holder* backup", "i32",
        "pick(values, backup)->data.items");
    string[2] index_call = {
        "fn at(u64 a) u64 { return a; }",
        "fn spare(u64 a) u64 { return a; }",
    };
    linear_materialization_pair("index_call", index_call[..],
        "i32@[2] values, i32@[2] backup, u64 index, u64 other_index", "i32",
        "values[at(index)]");
    string[5] base_and_index_calls = {
        "struct holder { i32@[2] lists; i32@[2] other; }",
        "fn pick(holder* a, holder* b) holder* { return a; }",
        "fn spare(holder* a, holder* b) holder* { return b; }",
        "fn at(u64 a) u64 { return a; }",
        "fn other_at(u64 a) u64 { return a; }",
    };
    linear_materialization_pair("base_and_index_calls", base_and_index_calls[..],
        "holder* values, holder* backup, u64 index, u64 other_index", "i32",
        "pick(values, backup)->lists[at(index)]");
    string[2] lower_bound_call = {
        "fn bound(u64 a) u64 { return a; }",
        "fn spare(u64 a) u64 { return a; }",
    };
    linear_materialization_pair("lower_bound_call", lower_bound_call[..],
        "i32@ values, i32@ backup, u64 index, u64 other_index", "i32",
        "values[bound(index)..]");
    string[2] upper_bound_call = {
        "fn bound(u64 a) u64 { return a; }",
        "fn spare(u64 a) u64 { return a; }",
    };
    linear_materialization_pair("upper_bound_call", upper_bound_call[..],
        "i32@ values, i32@ backup, u64 index, u64 other_index", "i32",
        "values[..bound(index)]");
    string[6] two_bound_calls_with_header_write = {
        "fn low(i32 mut@ mut* p, i32 mut@ replacement, u64 value) u64 {",
        "    *p = replacement; return value;",
        "}",
        "fn high(i32 mut@ mut* p, i32 mut@ replacement, u64 value) u64 {",
        "    *p = replacement; return value;",
        "}",
    };
    linear_materialization_pair("two_bound_calls_with_header_write",
        two_bound_calls_with_header_write[..],
        "i32 mut@ mut values, i32 mut@ mut backup, u64 index, u64 other_index", "i32",
        "values[low(&values, backup, index)..high(&values, backup, index)]");
    string[2] pointer_result_slice = {
        "fn pick(i32* a, i32* b) i32* { return a; }",
        "fn spare(i32* a, i32* b) i32* { return b; }",
    };
    linear_materialization_pair("pointer_result_slice", pointer_result_slice[..],
        "i32* values, i32* backup, u64 count, u64 other_count", "i32",
        "pick(values, backup)[0..count]");
}

fn conditional_json_loc(json.writer mut* j, diag.loc value) void {
    json.json_object_begin(j);
    json.json_key(j, "file");
    json.json_str(j, value.file);
    json.json_key(j, "line");
    json.json_uint(j, cast(value.line, u64));
    json.json_key(j, "column");
    json.json_uint(j, cast(value.col, u64));
    json.json_key(j, "end_line");
    json.json_uint(j, cast(value.end_line, u64));
    json.json_key(j, "end_column");
    json.json_uint(j, cast(value.end_col, u64));
    json.json_object_end(j);
}

fn conditional_candidate_snapshot(fir.func* f, fir_lower.range_candidate_set* proposed,
                                    strbuf.str_buf mut* out) void {
    json.writer mut j = json.writer{};
    json.json_init(&j, out);
    json.json_array_begin(&j);
    json.json_uint(&j, proposed->captures.len);
    json.json_uint(&j, proposed->boundaries.len);
    u64 mut i = 0;
    while (i < proposed->captures.len) {
        fir_lower.range_capture_candidate c = proposed->captures.items[i];
        json.json_array_begin(&j);
        json.json_uint(&j, cast(c.declaration, u64));
        json.json_uint(&j, cast(c.expansion, u64));
        json.json_uint(&j, cast(c.binding.kind, u64));
        json.json_bool(&j, c.binding.original_present);
        conditional_json_loc(&j, c.binding.source);
        conditional_json_loc(&j, c.occurrence.exit_source);
        json.json_uint(&j, cast(c.binding.captured.local, u64));
        json.json_uint(&j, cast(c.binding.captured.proj_first, u64));
        json.json_uint(&j, cast(c.binding.captured.proj_len, u64));
        json.json_uint(&j, cast(c.binding.original.local, u64));
        json.json_uint(&j, cast(c.binding.original.proj_first, u64));
        json.json_uint(&j, cast(c.binding.original.proj_len, u64));
        json.json_array_end(&j);
        i += 1;
    }
    json.json_array_end(&j);
}

fn legacy_mutation_receipt(string name, fir.func* f,
                            fir_lower.range_candidate_set* proposed,
                            fir_lower.range_source_audit* audit, bool verified,
                            bool llvm_verified) void {
    strbuf.str_buf mut after = strbuf.create();
    defer strbuf.free(&after);
    conditional_snapshot(f, &after);
    conditional_candidate_snapshot(f, proposed, &after);
    assert(strbuf.view(&legacy_before) != strbuf.view(&after));
    if (legacy_receipts != 0) { strbuf.append(&legacy_evidence, ",\n"); }
    json.writer mut j = json.writer{};
    json.json_init(&j, &legacy_evidence);
    json.json_object_begin(&j);
    json.json_key(&j, "source_probe");
    json.json_str(&j, name);
    json.json_key(&j, "fault");
    json.json_uint(&j, cast(audit->failure.reason, u64));
    json.json_key(&j, "key");
    conditional_json_key(&j, audit->failure.key);
    json.json_key(&j, "fir_verified_before_audit");
    json.json_bool(&j, verified);
    json.json_key(&j, "llvm_verified_before_audit");
    json.json_bool(&j, llvm_verified);
    json.json_key(&j, "before");
    json.json_str(&j, strbuf.view(&legacy_before));
    json.json_key(&j, "after");
    json.json_str(&j, strbuf.view(&after));
    json.json_object_end(&j);
    legacy_receipts += 1;
}

fn conditional_json_key(json.writer mut* j, fir_lower.range_audit_key key) void {
    json.json_object_begin(j);
    json.json_key(j, "function");
    json.json_str(j, key.function->name);
    json.json_key(j, "declaration");
    json.json_uint(j, cast(key.declaration, u64));
    json.json_key(j, "expansion");
    json.json_uint(j, cast(key.expansion, u64));
    json.json_key(j, "context");
    json.json_uint(j, cast(key.context, u64));
    json.json_key(j, "exit_occurrence");
    json.json_uint(j, cast(key.exit_occurrence, u64));
    json.json_key(j, "source");
    conditional_json_loc(j, key.source);
    json.json_key(j, "context_source");
    conditional_json_loc(j, key.context_source);
    json.json_key(j, "exit_source");
    conditional_json_loc(j, key.exit_source);
    json.json_object_end(j);
}

// The caller inspects this evidence after candidate and proof storage ends.
fn conditional_receipt(string name, fir.func* f, fir_lower.range_source_audit* audit,
                         bool accepted) void {
    assert_unpublished(f, audit);
    u64 mut count = audit->rows.len;
    if (!accepted) { count = 1; }
    u64 mut i = 0;
    while (i < count) {
        if (conditional_receipts != 0) { strbuf.append(&conditional_evidence, ",\n"); }
        json.writer mut j = json.writer{};
        json.json_init(&j, &conditional_evidence);
        json.json_object_begin(&j);
        json.json_key(&j, "source_probe");
        json.json_str(&j, name);
        json.json_key(&j, "accepted");
        json.json_bool(&j, accepted);
        json.json_key(&j, "fault");
        json.json_uint(&j, cast(audit->failure.reason, u64));
        json.json_key(&j, "after_candidate_and_proof_teardown");
        json.json_bool(&j, true);
        json.json_key(&j, "key");
        fir_lower.range_audit_key mut key = audit->failure.key;
        if (accepted) { key = audit->rows.items[i].key; }
        conditional_json_key(&j, key);
        if (accepted) {
            fir_lower.range_audit_row row = audit->rows.items[i];
            assert(fir.place_type(f, row.binding.captured) != null);
            assert(cast(row.boundaries_first + row.boundaries_len, u64) <= audit->boundaries.len);
            json.json_key(&j, "captured_local");
            json.json_uint(&j, cast(row.binding.captured.local, u64));
            json.json_key(&j, "original_local");
            json.json_uint(&j, cast(row.binding.original.local, u64));
            json.json_key(&j, "boundary_count");
            json.json_uint(&j, cast(row.boundaries_len, u64));
        }
        json.json_object_end(&j);
        conditional_receipts += 1;
        i += 1;
    }
}

// Printed FIR omits source metadata. Retain that metadata in the compared operation snapshot.
fn conditional_snapshot(fir.func* f, strbuf.str_buf mut* out) void {
    fir_print.print_function(f, out);
    strbuf.append(out, "\n");
    json.writer mut j = json.writer{};
    json.json_init(&j, out);
    json.json_array_begin(&j);
    u32 mut b = 0;
    while (b < fir.block_count(f)) {
        u32 mut p = 0;
        while (p < fir.block_statement_count(f, b)) {
            fir.statement* s = fir.block_statement(f, b, p);
            json.json_array_begin(&j);
            json.json_uint(&j, cast(b, u64));
            json.json_uint(&j, cast(p, u64));
            json.json_uint(&j, cast(s->stmt, u64));
            conditional_json_loc(&j, s->loc);
            conditional_json_loc(&j, s->exit_loc);
            json.json_array_end(&j);
            p += 1;
        }
        fir.terminator* t = &fir.block_at(f, b)->term;
        json.json_array_begin(&j);
        json.json_uint(&j, cast(b, u64));
        json.json_uint(&j, cast(t->stmt, u64));
        conditional_json_loc(&j, t->loc);
        conditional_json_loc(&j, t->exit_loc);
        json.json_array_end(&j);
        b += 1;
    }
    json.json_array_end(&j);
}

// A development receipt can require actual LLVM verification before the audit sees valid damage.
fn conditional_verify_damage(lower_env.env mut* e, ast.node* decl, fir.func* f, u32 index) bool {
    string mut tool = "";
    if (!sys.env("FORT_RANGE_MUTATION_OPT", &tool)) { return false; }
    string mut dir = "";
    assert(sys.env("FORT_RANGE_PROBE_DIR", &dir));
    strbuf.str_buf mut leaf = strbuf.create();
    defer strbuf.free(&leaf);
    strbuf.append(&leaf, "mutation-");
    strbuf.append_u64(&leaf, cast(index, u64));
    strbuf.append(&leaf, ".ll");
    gen.emitter mut g = gen.emitter{};
    defer gen.gen_free(&g);
    probe_emissions mut count = probe_emissions{};
    probe_module(e, decl, f, &g, &count);
    probe_file(dir, strbuf.view(&leaf), strbuf.view(&g.out));
    strbuf.str_buf mut path = strbuf.create();
    defer strbuf.free(&path);
    strbuf.append(&path, dir);
    strbuf.push(&path, '/');
    strbuf.append(&path, strbuf.view(&leaf));
    char mut@ own command = str.to_cstr(tool);
    defer del(command);
    char mut@ own file = str.to_cstr(strbuf.view(&path));
    defer del(file);
    char*[5] argv = {command.ptr, "-passes=verify".ptr, "-disable-output".ptr, file.ptr, null};
    i32 child = libc.fork();
    assert(child >= 0);
    if (child == 0) {
        libc.execvp(command.ptr, cast(&argv[0], void*));
        libc._exit(127);
    }
    i32 mut status = 0;
    i32 mut waited = libc.waitpid(child, &status, 0);
    while (waited < 0 && sys.errno() == 4) { waited = libc.waitpid(child, &status, 0); }
    assert(waited == child && status == 0);
    return true;
}

// Compare operation bytes before classifying a mutation. Invalid FIR supplies no verified refusal.
fn conditional_fault(string name, string damage, lower_env.env mut* e, ast.node* decl,
                       fir.func* ordinary, fir.func* changed,
                       fir_lower.range_candidate_set* proposed, fir_lower.range_audit_key key,
                       u32 block, u32 position) void {
    strbuf.str_buf mut before = strbuf.create();
    defer strbuf.free(&before);
    strbuf.str_buf mut after = strbuf.create();
    defer strbuf.free(&after);
    conditional_snapshot(ordinary, &before);
    conditional_snapshot(changed, &after);
    assert(strbuf.view(&before) != strbuf.view(&after));
    fir_verify.violation mut bad = fir_verify.violation{};
    bool verified = !fir_verify.find_violation(changed, &e->rt, &bad);
    bool mut llvm_verified = false;
    if (verified) {
        llvm_verified = conditional_verify_damage(e, decl, changed, conditional_damage_cases);
    }
    fir_lower.range_source_audit mut audit = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&audit);
    assert(!fir_lower.audit_produced_ranges(decl, changed, proposed, &audit));
    assert(audit.failure.reason == fir_lower.range_audit_fault.protected_path);
    assert_linear_key(audit.failure.key, key);
    assert_unpublished(changed, &audit);
    if (conditional_damage_cases != 0) { strbuf.append(&conditional_mutations, ",\n"); }
    json.writer mut j = json.writer{};
    json.json_init(&j, &conditional_mutations);
    json.json_object_begin(&j);
    json.json_key(&j, "source_probe");
    json.json_str(&j, name);
    json.json_key(&j, "damage");
    json.json_str(&j, damage);
    json.json_key(&j, "block");
    json.json_uint(&j, cast(block, u64));
    json.json_key(&j, "position");
    json.json_uint(&j, cast(position, u64));
    json.json_key(&j, "fir_bytes_changed");
    json.json_bool(&j, true);
    json.json_key(&j, "before");
    json.json_str(&j, strbuf.view(&before));
    json.json_key(&j, "after");
    json.json_str(&j, strbuf.view(&after));
    json.json_key(&j, "fir_verified_before_audit");
    json.json_bool(&j, verified);
    json.json_key(&j, "llvm_verified_before_audit");
    json.json_bool(&j, llvm_verified);
    json.json_key(&j, "key");
    conditional_json_key(&j, audit.failure.key);
    json.json_key(&j, "fault");
    json.json_uint(&j, cast(audit.failure.reason, u64));
    json.json_object_end(&j);
    conditional_damage_cases += 1;
    if (verified) { conditional_verified_damage += 1; }
    else { conditional_invalid_damage += 1; }
}

fn conditional_damage(string name, lower_env.env mut* e, ast.node* decl, fir.func* f,
                        fir_lower.range_candidate_set* proposed,
                        fir_lower.range_source_audit* audit) void {
    gen.node_ref_vec mut selected = gen.node_ref_vec{};
    defer gen.refs_free(&selected);
    fir_lower.range_audit_selected(decl->b, &selected);
    assert(selected.len == 1);
    u32 expression_column = gen.refs_at(&selected, 0)->b->loc.col;
    u64 mut row = 0;
    while (row < audit->rows.len) {
        fir_lower.range_audit_key key = audit->rows.items[row].key;
        u32 mut b = 0;
        while (b < fir.block_count(f)) {
            fir.terminator saved = fir.block_at(f, b)->term;
            if (saved.kind != fir.term_kind.tk_switch
                || !fir_lower.range_audit_loc_eq(saved.exit_loc, key.exit_source)
                || saved.loc.line != key.source.line
                || saved.loc.col < expression_column) { b += 1; continue; }
            u32 mut mode = 0;
            while (mode < 7) {
                fir.func mut changed = fir.func_clone(f);
                defer fir.func_free(&changed);
                fir.terminator mut* branch = &fir.block_mut(&changed, b)->term;
                string mut damage = "switch source";
                if (mode == 0) { branch->loc.col += 1; }
                else if (mode == 1) { branch->stmt += 1; damage = "switch statement"; }
                else if (mode == 2) { branch->exit_loc.col += 1; damage = "switch exit"; }
                else if (mode == 3) {
                    damage = "arm target swap";
                    changed.arms.items[branch->arms_first].target = saved.otherwise;
                    branch->otherwise = fir.term_arm(f, &saved, 0).target;
                } else if (mode == 4) {
                    damage = "predicate operand";
                    if (saved.cond.kind == fir.operand_kind.ok_const) {
                        branch->cond.value.value.mag = 1 - branch->cond.value.value.mag;
                    } else {
                        fir.operand mut other = fir.operand{};
                        if (!linear_other_parameter(f, saved.cond, &other)) { mode += 1; continue; }
                        branch->cond = other;
                    }
                } else if (mode == 5) {
                    damage = "switch case";
                    changed.arms.items[branch->arms_first].value.mag = 0;
                } else {
                    damage = "extra arm predecessor";
                    u32 extra = fir.block_new(&changed);
                    fir.block_mut(&changed, extra)->term = fir.term_goto(saved.otherwise,
                                                                         saved.loc, saved.stmt);
                }
                conditional_fault(name, damage, e, decl, f, &changed, proposed, key,
                                    b, fir.block_statement_count(f, b));
                mode += 1;
            }
            b += 1;
        }
        b = 0;
        while (b < fir.block_count(f)) {
            u32 mut p = 0;
            while (p < fir.block_statement_count(f, b)) {
                fir.statement saved = *fir.block_statement(f, b, p);
                if (saved.kind != fir.stmt_kind.st_assign
                    || !fir_lower.range_audit_loc_eq(saved.exit_loc, key.exit_source)
                    || saved.loc.line != key.source.line
                    || fir_lower.range_audit_counter(f, &saved)
                    || saved.place.base != fir.base_kind.bk_local || saved.place.proj_len != 0
                    || fir.local_at(f, saved.place.local)->kind != fir.local_kind.lk_temp
                    || (saved.value.kind != fir.rvalue_kind.rv_call
                        && saved.value.kind != fir.rvalue_kind.rv_use)) { p += 1; continue; }
                u32 mut mode = 0;
                while (mode < 7) {
                    fir.func mut changed = fir.func_clone(f);
                    defer fir.func_free(&changed);
                    fir.statement mut* write = &fir.block_mut(&changed, b)->statements.items[p];
                    string mut damage = "arm source";
                    if (mode == 0) { write->loc.col += 1; }
                    else if (mode == 1) { write->stmt += 1; damage = "arm statement"; }
                    else if (mode == 2) { write->exit_loc.col += 1; damage = "arm exit"; }
                    else if (mode == 3) {
                        damage = "duplicate arm write";
                        linear_append(&changed, b, saved);
                    } else if (mode == 4) {
                        damage = "overwritten arm write";
                        fir.statement mut zero = saved;
                        zero.value = fir.rvalue_use(&changed,
                            fir.operand_const(fir.const_zero(fir.place_type(f, saved.place))));
                        linear_append(&changed, b, zero);
                    } else if (mode == 5) {
                        damage = "missing arm write";
                        fir.block mut* bk = fir.block_mut(&changed, b);
                        u64 mut i = cast(p, u64);
                        while (i + 1 < bk->statements.len) {
                            bk->statements.items[i] = bk->statements.items[i + 1]; i += 1;
                        }
                        bk->statements.len -= 1;
                    } else {
                        damage = "result destination";
                        u32 other = fir.local_add(&changed, fir.place_type(f, saved.place),
                                                   fir.local_kind.lk_temp, null, saved.loc);
                        write->place = fir.place_local(other);
                    }
                    conditional_fault(name, damage, e, decl, f, &changed, proposed, key, b, p);
                    mode += 1;
                }
                u32 mut i = 0;
                while (i < saved.value.ops_len) {
                    fir.operand mut other = fir.operand{};
                    if (linear_other_parameter(f, fir.operand_at(f, saved.value.ops_first + i),
                                                &other)) {
                        fir.func mut changed = fir.func_clone(f);
                        defer fir.func_free(&changed);
                        changed.ops.items[saved.value.ops_first + i] = other;
                        conditional_fault(name, "arm operand", e, decl, f, &changed,
                                            proposed, key, b, p);
                    }
                    i += 1;
                }
                if (saved.value.kind == fir.rvalue_kind.rv_call) {
                    u32 mut other_block = 0;
                    bool mut swapped = false;
                    while (!swapped && other_block < fir.block_count(f)) {
                        u32 mut other_position = 0;
                        while (!swapped
                            && other_position < fir.block_statement_count(f, other_block)) {
                            fir.statement other =
                                *fir.block_statement(f, other_block, other_position);
                            if (other.value.kind == fir.rvalue_kind.rv_call
                                && other.stmt == saved.stmt
                                && fir_lower.range_audit_loc_eq(other.exit_loc, saved.exit_loc)
                                && !fir_lower.range_audit_loc_eq(other.loc, saved.loc)
                                && types.type_same_shape(fir.place_type(f, other.place),
                                                          fir.place_type(f, saved.place))) {
                                fir.func mut changed = fir.func_clone(f);
                                defer fir.func_free(&changed);
                                fir.block_mut(&changed, b)->statements.items[p] = other;
                                fir.block mut* other_body = fir.block_mut(&changed, other_block);
                                other_body->statements.items[other_position] = saved;
                                conditional_fault(name, "cross-arm call identity", e, decl, f,
                                                    &changed, proposed, key, b, p);
                                swapped = true;
                            }
                            other_position += 1;
                        }
                        other_block += 1;
                    }
                    u32 mut capture_block = 0;
                    bool mut appended = false;
                    while (!appended && capture_block < fir.block_count(f)) {
                        u32 mut position = 0;
                        while (!appended
                            && position < fir.block_statement_count(f, capture_block)) {
                            fir.statement* capture =
                                fir.block_statement(f, capture_block, position);
                            if (fir_lower.range_audit_counter(f, capture)
                                && capture->stmt == saved.stmt
                                && fir_lower.range_audit_loc_eq(capture->exit_loc,
                                                                 saved.exit_loc)) {
                                fir.func mut changed = fir.func_clone(f);
                                defer fir.func_free(&changed);
                                linear_append(&changed, capture_block, saved);
                                conditional_fault(name, "write after joined read", e, decl, f,
                                                    &changed, proposed, key,
                                                    capture_block, position);
                                appended = true;
                            }
                            position += 1;
                        }
                        capture_block += 1;
                    }
                    assert(appended);
                }
                p += 1;
            }
            fir.terminator saved = fir.block_at(f, b)->term;
            if (saved.kind == fir.term_kind.tk_goto
                && saved.loc.line == key.source.line
                && saved.loc.col >= expression_column
                && fir_lower.range_audit_loc_eq(saved.exit_loc, key.exit_source)) {
                u32 mut mode = 0;
                while (mode < 5) {
                    fir.func mut changed = fir.func_clone(f);
                    defer fir.func_free(&changed);
                    fir.terminator mut* exit = &fir.block_mut(&changed, b)->term;
                    string mut damage = "join exit source";
                    if (mode == 0) { exit->loc.col += 1; }
                    else if (mode == 1) { exit->stmt += 1; damage = "join exit statement"; }
                    else if (mode == 2) { exit->exit_loc.col += 1; damage = "join exit context"; }
                    else if (mode == 3) {
                        damage = "join target substitution";
                        exit->target = b;
                    } else {
                        damage = "extra join predecessor";
                        u32 extra = fir.block_new(&changed);
                        fir.block_mut(&changed, extra)->term = saved;
                    }
                    conditional_fault(name, damage, e, decl, f, &changed,
                                        proposed, key, b, fir.block_statement_count(f, b));
                    mode += 1;
                }
            }
            b += 1;
        }
        row += 1;
    }
}

fn conditional_result_matrix() void {
    string[2] calls = {
        "fn pick(i32@ a, i32@ b) i32@ { return a; }",
        "fn spare(i32@ a, i32@ b) i32@ { return b; }",
    };
    string params = "bool select, bool other, i32@ values, i32@ backup";
    conditional_result_pair("two_result_calls", calls[..], params, "i32",
                              "select ? pick(values, backup) : spare(backup, values)");
    conditional_result_pair("equal_type_distinct_calls", calls[..], params, "i32",
                              "select ? pick(values, backup) : pick(values, backup)");
    conditional_result_pair("nested_then_then", calls[..], params, "i32",
        "select ? (other ? pick(values, backup) : backup) : values");
    conditional_result_pair("nested_then_else", calls[..], params, "i32",
        "select ? (other ? values : pick(backup, values)) : values");
    conditional_result_pair("nested_else_then", calls[..], params, "i32",
        "select ? values : (other ? pick(values, backup) : backup)");
    conditional_result_pair("nested_else_else", calls[..], params, "i32",
        "select ? values : (other ? values : pick(backup, values))");
    conditional_result_pair("constant_true", calls[..], params, "i32",
                              "true ? pick(values, backup) : spare(backup, values)");
    conditional_result_pair("constant_false", calls[..], params, "i32",
                              "false ? pick(values, backup) : spare(backup, values)");
    conditional_result_pair("repeated_deferred_exits", calls[..], params, "i32",
        "select ? pick(values, backup) : (other ? spare(backup, values) : pick(backup, values))");
    assert(conditional_pairs == 18 && conditional_rows == 27);
}

// Folded strings execute separately from the complete pair matrix.
fn conditional_folded_matrix() void {
    u32 mut mode = 0;
    while (mode < 4) {
        string mut expression = "true ? \"selected true\" : \"selected false\"";
        if (mode % 2 == 1) { expression = "false ? \"selected true\" : \"selected false\""; }
        strbuf.str_buf mut line = strbuf.create();
        defer strbuf.free(&line);
        strbuf.append(&line, "        for (char x : ");
        strbuf.append(&line, expression);
        strbuf.append(&line, ") { }");
        string[7] mut source = {
            "fn walk(bool quit) void {", "", strbuf.view(&line), "",
            "    if (quit) { return; }", "}", "",
        };
        if (mode >= 2) { source[1] = "    defer {"; source[3] = "    }"; }
        lower_env.env mut e = lower_env.env{};
        lower_env.open(&e);
        defer lower_env.close(&e);
        lower_env.check_lines(&e, source[..], true);
        ast.node* decl = lower_env.decl(&e, "walk");
        fir.func mut f = fir.func{};
        defer fir.func_free(&f);
        fir_lower.range_candidate_set mut proposed = fir_lower.range_candidate_set{};
        defer fir_lower.range_candidate_set_free(&proposed);
        fir_lower.report mut why = fir_lower.report{};
        assert(fir_lower.lower_function_with_range_candidates(&e.c.ck, decl, &f, &proposed, &why));
        fir_verify.violation mut bad = fir_verify.violation{};
        assert(!fir_verify.find_violation(&f, &e.rt, &bad));
        fir_lower.range_source_audit mut audit = fir_lower.range_source_audit{};
        defer fir_lower.range_source_audit_free(&audit);
        assert(fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
        fir.func mut ordinary = fir.func{};
        defer fir.func_free(&ordinary);
        assert(fir_lower.lower_function(&e.c.ck, decl, &ordinary, &why));
        strbuf.str_buf mut first = strbuf.create();
        defer strbuf.free(&first);
        strbuf.str_buf mut second = strbuf.create();
        defer strbuf.free(&second);
        fir_print.print_function(&f, &first);
        fir_print.print_function(&ordinary, &second);
        assert(strbuf.view(&first) == strbuf.view(&second));
        fir_lower.range_candidate_set_free(&proposed);
        conditional_receipt(expression, &f, &audit, true);
        mode += 1;
    }
}

fn conditional_auxiliary_bytes(string name, fir.func* ordinary, fir.func* changed) void {
    strbuf.str_buf mut before = strbuf.create();
    defer strbuf.free(&before);
    strbuf.str_buf mut after = strbuf.create();
    defer strbuf.free(&after);
    conditional_snapshot(ordinary, &before);
    conditional_snapshot(changed, &after);
    assert(strbuf.view(&before) != strbuf.view(&after));
    string mut dir = "";
    if (!sys.env("FORT_RANGE_PROBE_DIR", &dir)) { return; }
    strbuf.str_buf mut bytes = strbuf.create();
    defer strbuf.free(&bytes);
    json.writer mut j = json.writer{};
    json.json_init(&j, &bytes);
    json.json_object_begin(&j);
    json.json_key(&j, "before");
    json.json_str(&j, strbuf.view(&before));
    json.json_key(&j, "after");
    json.json_str(&j, strbuf.view(&after));
    json.json_object_end(&j);
    probe_file(dir, name, strbuf.view(&bytes));
}

// Eighteen nested regions force growth while ancestor facts remain live.
fn conditional_growth_and_failure() void {
    strbuf.str_buf mut expression = strbuf.create();
    defer strbuf.free(&expression);
    u32 mut i = 0;
    while (i < 18) { strbuf.append(&expression, "select ? ("); i += 1; }
    strbuf.append(&expression, "pick(values)");
    i = 0;
    while (i < 18) { strbuf.append(&expression, ") : backup"); i += 1; }
    strbuf.str_buf mut line = strbuf.create();
    defer strbuf.free(&line);
    strbuf.append(&line, "    for (i32 x : ");
    strbuf.append(&line, strbuf.view(&expression));
    strbuf.append(&line, ") { }");
    string[5] source = {
        "fn pick(i32@ values) i32@ { return values; }",
        "fn walk(bool select, bool other, i32@ values, i32@ backup) void {",
        strbuf.view(&line), "}", "",
    };
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    lower_env.check_lines(&e, source[..], true);
    ast.node* decl = lower_env.decl(&e, "walk");
    fir.func mut f = fir.func{};
    defer fir.func_free(&f);
    fir_lower.range_candidate_set mut proposed = fir_lower.range_candidate_set{};
    defer fir_lower.range_candidate_set_free(&proposed);
    fir_lower.report mut why = fir_lower.report{};
    assert(fir_lower.lower_function_with_range_candidates(&e.c.ck, decl, &f, &proposed, &why));
    fir_verify.violation mut bad = fir_verify.violation{};
    assert(!fir_verify.find_violation(&f, &e.rt, &bad));
    fir_lower.range_source_audit mut audit = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&audit);
    assert(fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    fir_lower.range_audit_key key = audit.rows.items[0].key;
    fir_lower.range_source_audit mut before = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&before);
    fir_lower.range_source_audit mut partial = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&partial);
    fir_lower.range_source_audit mut nested = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&nested);
    u32 mut branch = 0;
    u32 mut leaf_block = 0;
    u32 mut leaf_position = 0;
    u32 mut b = 0;
    bool mut found_branch = false;
    bool mut found_leaf = false;
    while (b < fir.block_count(&f)) {
        if (!found_branch && fir.block_at(&f, b)->term.kind == fir.term_kind.tk_switch) {
            branch = b; found_branch = true;
        }
        u32 mut p = 0;
        while (p < fir.block_statement_count(&f, b)) {
            if (fir.block_statement(&f, b, p)->value.kind == fir.rvalue_kind.rv_call) {
                leaf_block = b; leaf_position = p; found_leaf = true;
            }
            p += 1;
        }
        b += 1;
    }
    assert(found_branch && found_leaf);
    fir.func mut changed = fir.func_clone(&f);
    defer fir.func_free(&changed);
    fir.block_mut(&changed, branch)->term.loc.col += 1;
    assert(!fir_verify.find_violation(&changed, &e.rt, &bad));
    conditional_auxiliary_bytes("growth-before-allocation.json", &f, &changed);
    conditional_verify_damage(&e, decl, &changed, conditional_damage_cases);
    assert(!fir_lower.audit_produced_ranges(decl, &changed, &proposed, &before));
    fir.block_mut(&changed, branch)->term = fir.block_at(&f, branch)->term;
    fir.operand mut other = fir.operand{};
    assert(linear_other_parameter(&f, fir.block_at(&f, branch)->term.cond, &other));
    fir.block_mut(&changed, branch)->term.cond = other;
    assert(!fir_verify.find_violation(&changed, &e.rt, &bad));
    conditional_auxiliary_bytes("growth-partial-region.json", &f, &changed);
    conditional_verify_damage(&e, decl, &changed, conditional_damage_cases + 1);
    assert(!fir_lower.audit_produced_ranges(decl, &changed, &proposed, &partial));
    fir.block_mut(&changed, branch)->term = fir.block_at(&f, branch)->term;
    fir.block_mut(&changed, leaf_block)->statements.items[leaf_position].loc.col += 1;
    assert(!fir_verify.find_violation(&changed, &e.rt, &bad));
    conditional_auxiliary_bytes("growth-nested-arm.json", &f, &changed);
    conditional_verify_damage(&e, decl, &changed, conditional_damage_cases + 2);
    assert(!fir_lower.audit_produced_ranges(decl, &changed, &proposed, &nested));
    fir_lower.range_candidate_set_free(&proposed);
    assert(before.failure.reason == fir_lower.range_audit_fault.protected_path);
    assert(partial.failure.reason == fir_lower.range_audit_fault.protected_path);
    assert(nested.failure.reason == fir_lower.range_audit_fault.protected_path);
    assert_linear_key(before.failure.key, key);
    assert_linear_key(partial.failure.key, key);
    assert_linear_key(nested.failure.key, key);
    conditional_receipt("growth success", &f, &audit, true);
    conditional_receipt("before allocation refusal", &f, &before, false);
    conditional_receipt("partial region refusal", &f, &partial, false);
    conditional_receipt("nested arm refusal", &f, &nested, false);
}

fn conditional_result_pair(string name, string@ prelude, string parameters,
                                  string element, string expression) void {
    strbuf.str_buf mut header = strbuf.create();
    defer strbuf.free(&header);
    strbuf.append(&header, "fn walk(bool quit, ");
    strbuf.append(&header, parameters);
    strbuf.append(&header, ") void {");
    strbuf.str_buf mut loop = strbuf.create();
    defer strbuf.free(&loop);
    strbuf.append(&loop, "        for (");
    strbuf.append(&loop, element);
    strbuf.append(&loop, " x : ");
    strbuf.append(&loop, expression);
    strbuf.append(&loop, ") { }");
    u32 mut mode = 0;
    while (mode < 2) {
        string mut@ own source = new(string, prelude.len + 7);
        defer del(source);
        u64 mut i = 0;
        while (i < prelude.len) { source[i] = prelude[i]; i += 1; }
        source[i] = strbuf.view(&header);
        source[i + 1] = "";
        source[i + 2] = strbuf.view(&loop);
        source[i + 3] = "";
        source[i + 4] = "    if (quit) { return; }";
        source[i + 5] = "}";
        source[i + 6] = "";
        strbuf.str_buf mut key = strbuf.create();
        defer strbuf.free(&key);
        strbuf.append(&key, "conditional_result_");
        strbuf.append(&key, name);
        u32 mut context_line = 0;
        u64 mut expected_rows = 1;
        if (mode == 0) { strbuf.append(&key, "_direct"); }
        else {
            source[i + 1] = "    defer {";
            source[i + 3] = "    }";
            context_line = cast(i + 2, u32);
            expected_rows = 2;
            strbuf.append(&key, "_deferred");
        }
        lower_env.env mut e = lower_env.env{};
        lower_env.open(&e);
        defer lower_env.close(&e);
        lower_env.check_lines(&e, source, true);
        ast.node* decl = lower_env.decl(&e, "walk");
        fir.func mut f = fir.func{};
        defer fir.func_free(&f);
        fir_lower.range_candidate_set mut proposed = fir_lower.range_candidate_set{};
        defer fir_lower.range_candidate_set_free(&proposed);
        fir_lower.report mut why = fir_lower.report{};
        assert(fir_lower.lower_function_with_range_candidates(&e.c.ck, decl, &f, &proposed, &why));
        fir_verify.violation mut bad = fir_verify.violation{};
        assert(!fir_verify.find_violation(&f, &e.rt, &bad));
        eprintln(strbuf.view(&key), " verifies fixture FIR");
        fir_lower.range_source_audit mut audit = fir_lower.range_source_audit{};
        defer fir_lower.range_source_audit_free(&audit);
        bool matched = fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit);
        if (!matched) { eprintln(strbuf.view(&key), " refuses a proved conditional result"); }
        assert(matched);
        assert(audit.rows.len == expected_rows && proposed.captures.len == expected_rows);
        assert(audit.matched_captures == cast(expected_rows, u32));
        assert(audit.matched_boundaries == cast(proposed.boundaries.len, u32));
        u64 mut row = 0;
        while (row < expected_rows) {
            fir_lower.range_audit_key actual = audit.rows.items[row].key;
            assert(actual.source.line == cast(i + 3, u32));
            assert(actual.context_source.line == context_line);
            if (mode == 0) {
                assert(actual.context == 0 && actual.exit_occurrence == 0);
                assert(actual.exit_source.line == 0);
            } else {
                assert(actual.context != 0 && actual.exit_occurrence != 0);
                assert(actual.exit_source.line != 0);
                if (row != 0) {
                    assert(actual.exit_occurrence != audit.rows.items[row - 1].key.exit_occurrence);
                }
            }
            row += 1;
        }
        assert_unpublished(&f, &audit);
        conditional_damage(strbuf.view(&key), &e, decl, &f, &proposed, &audit);
        check_output(&e, decl, &f, strbuf.view(&key), true);
        fir_lower.range_candidate_set_free(&proposed);
        conditional_receipt(strbuf.view(&key), &f, &audit, true);
        assert(audit.rows.len == expected_rows);
        assert_unpublished(&f, &audit);
        conditional_pairs += 1;
        conditional_rows += cast(expected_rows, u32);
        mode += 1;
    }
}

u32 mut conditional_operand_pairs = 0;
u32 mut conditional_operand_rows = 0;

fn conditional_operand_matrix() void {
    string[2] calls = {
        "fn pick(i32@ a, i32@ b) i32@ { return a; }",
        "fn spare(i32@ a, i32@ b) i32@ { return b; }",
    };
    string params = "bool select, bool other, i32@ values, i32@ backup";
    conditional_operand_pair("conditional_argument", calls[..], params, "i32",
        "pick(select ? spare(values, backup) : (other ? values : backup), backup)");
    conditional_operand_pair("conditional_callee", calls[..], params, "i32",
        "(select ? pick : (other ? spare : pick))(values, backup)");
    string[2] pointers = {
        "struct holder { i32@ items; i32@ other; }",
        "fn pick(holder* a, holder* b) holder* { return a; }",
    };
    conditional_operand_pair("joined_pointer_projection", pointers[..],
        "bool select, holder* values, holder* backup", "i32",
        "(select ? pick(values, backup) : backup)->items");
    conditional_operand_pair("joined_header", calls[..], params, "i32",
        "cast((select ? pick(values, backup) : backup)[..], i32@)");
    string[1] arrays = {"fn pick(i32@[2] a, i32@[2] b) i32@[2] { return a; }"};
    conditional_operand_pair("joined_index", arrays[..],
        "bool select, bool other, i32@[2] values, i32@[2] backup", "i32",
        "(select ? pick(values, backup) : backup)[other ? 0 : 1]");
    conditional_operand_pair("joined_slice", calls[..], params, "i32",
        "(select ? pick(values, backup) : backup)[other ? 0 : 1 .. select ? 2 : 3]");
    string[2] bounds = {calls[0], "fn bound(i64 x) i64 { return x; }"};
    conditional_operand_pair("bound_call_after_join", bounds[..],
        "bool select, i32@ values, i32@ backup, i64 low, i64 high", "i32",
        "(select ? pick(values, backup) : backup)[bound(low) .. bound(high)]");
    assert(conditional_operand_pairs == 14 && conditional_operand_rows == 21);
}

fn conditional_operand_damage(string name, lower_env.env mut* e, ast.node* decl, fir.func* f,
                        fir_lower.range_candidate_set* proposed,
                        fir_lower.range_source_audit* audit) void {
    gen.node_ref_vec mut selected = gen.node_ref_vec{};
    defer gen.refs_free(&selected);
    fir_lower.range_audit_selected(decl->b, &selected);
    assert(selected.len == 1);
    u32 expression_column = gen.refs_at(&selected, 0)->b->loc.col;
    u64 mut row = 0;
    while (row < audit->rows.len) {
        fir_lower.range_audit_key key = audit->rows.items[row].key;
        u32 mut b = 0;
        while (b < fir.block_count(f)) {
            fir.terminator saved = fir.block_at(f, b)->term;
            if (saved.kind != fir.term_kind.tk_switch
                || !fir_lower.range_audit_loc_eq(saved.exit_loc, key.exit_source)
                || saved.loc.line != key.source.line
                || saved.loc.col < expression_column) { b += 1; continue; }
            u32 mut mode = 0;
            while (mode < 7) {
                fir.func mut changed = fir.func_clone(f);
                defer fir.func_free(&changed);
                fir.terminator mut* branch = &fir.block_mut(&changed, b)->term;
                string mut damage = "switch source";
                if (mode == 0) { branch->loc.col += 1; }
                else if (mode == 1) { branch->stmt += 1; damage = "switch statement"; }
                else if (mode == 2) { branch->exit_loc.col += 1; damage = "switch exit"; }
                else if (mode == 3) {
                    damage = "arm target swap";
                    changed.arms.items[branch->arms_first].target = saved.otherwise;
                    branch->otherwise = fir.term_arm(f, &saved, 0).target;
                } else if (mode == 4) {
                    damage = "predicate operand";
                    if (saved.cond.kind == fir.operand_kind.ok_const) {
                        branch->cond.value.value.mag = 1 - branch->cond.value.value.mag;
                    } else {
                        fir.operand mut other = fir.operand{};
                        if (!linear_other_parameter(f, saved.cond, &other)) { mode += 1; continue; }
                        branch->cond = other;
                    }
                } else if (mode == 5) {
                    damage = "switch case";
                    changed.arms.items[branch->arms_first].value.mag = 0;
                } else {
                    damage = "extra arm predecessor";
                    u32 extra = fir.block_new(&changed);
                    fir.block_mut(&changed, extra)->term = fir.term_goto(saved.otherwise,
                                                                         saved.loc, saved.stmt);
                }
                conditional_fault(name, damage, e, decl, f, &changed, proposed, key,
                                    b, fir.block_statement_count(f, b));
                mode += 1;
            }
            b += 1;
        }
        b = 0;
        while (b < fir.block_count(f)) {
            u32 mut p = 0;
            while (p < fir.block_statement_count(f, b)) {
                fir.statement saved = *fir.block_statement(f, b, p);
                if (saved.kind != fir.stmt_kind.st_assign
                    || !fir_lower.range_audit_loc_eq(saved.exit_loc, key.exit_source)
                    || saved.loc.line != key.source.line
                    || fir_lower.range_audit_counter(f, &saved)
                    || saved.place.base != fir.base_kind.bk_local || saved.place.proj_len != 0
                    || fir.local_at(f, saved.place.local)->kind != fir.local_kind.lk_temp
                    || (saved.value.kind != fir.rvalue_kind.rv_call
                        && saved.value.kind != fir.rvalue_kind.rv_use
                        && saved.value.kind != fir.rvalue_kind.rv_cast
                        && saved.value.kind != fir.rvalue_kind.rv_addr
                        && saved.value.kind != fir.rvalue_kind.rv_slice
                        && saved.value.kind != fir.rvalue_kind.rv_slice_ptr)) { p += 1; continue; }
                if (saved.value.kind == fir.rvalue_kind.rv_cast
                    && saved.value.ty->kind == types.type_kind.k_prim
                    && saved.value.ty->prim == prim.prim_kind.prim_i64) { p += 1; continue; }
                u32 mut mode = 0;
                while (mode < 7) {
                    fir.func mut changed = fir.func_clone(f);
                    defer fir.func_free(&changed);
                    fir.statement mut* write = &fir.block_mut(&changed, b)->statements.items[p];
                    string mut damage = "arm source";
                    if (mode == 0) { write->loc.col += 1; }
                    else if (mode == 1) { write->stmt += 1; damage = "arm statement"; }
                    else if (mode == 2) { write->exit_loc.col += 1; damage = "arm exit"; }
                    else if (mode == 3) {
                        damage = "duplicate arm write";
                        linear_append(&changed, b, saved);
                    } else if (mode == 4) {
                        damage = "overwritten arm write";
                        fir.statement mut zero = saved;
                        zero.value = fir.rvalue_use(&changed,
                            fir.operand_const(fir.const_zero(fir.place_type(f, saved.place))));
                        linear_append(&changed, b, zero);
                    } else if (mode == 5) {
                        damage = "missing arm write";
                        fir.block mut* bk = fir.block_mut(&changed, b);
                        u64 mut i = cast(p, u64);
                        while (i + 1 < bk->statements.len) {
                            bk->statements.items[i] = bk->statements.items[i + 1]; i += 1;
                        }
                        bk->statements.len -= 1;
                    } else {
                        damage = "result destination";
                        u32 other = fir.local_add(&changed, fir.place_type(f, saved.place),
                                                   fir.local_kind.lk_temp, null, saved.loc);
                        write->place = fir.place_local(other);
                    }
                    conditional_fault(name, damage, e, decl, f, &changed, proposed, key, b, p);
                    mode += 1;
                }
                u32 mut i = 0;
                while (i < saved.value.ops_len) {
                    fir.operand mut other = fir.operand{};
                    if (linear_other_parameter(f, fir.operand_at(f, saved.value.ops_first + i),
                                                &other)) {
                        fir.func mut changed = fir.func_clone(f);
                        defer fir.func_free(&changed);
                        changed.ops.items[saved.value.ops_first + i] = other;
                        conditional_fault(name, "arm operand", e, decl, f, &changed,
                                            proposed, key, b, p);
                    }
                    i += 1;
                }
                if (saved.value.kind == fir.rvalue_kind.rv_call) {
                    u32 mut other_block = 0;
                    bool mut swapped = false;
                    while (!swapped && other_block < fir.block_count(f)) {
                        u32 mut other_position = 0;
                        while (!swapped
                            && other_position < fir.block_statement_count(f, other_block)) {
                            fir.statement other =
                                *fir.block_statement(f, other_block, other_position);
                            if (other.value.kind == fir.rvalue_kind.rv_call
                                && other.stmt == saved.stmt
                                && fir_lower.range_audit_loc_eq(other.exit_loc, saved.exit_loc)
                                && !fir_lower.range_audit_loc_eq(other.loc, saved.loc)
                                && types.type_same_shape(fir.place_type(f, other.place),
                                                          fir.place_type(f, saved.place))) {
                                fir.func mut changed = fir.func_clone(f);
                                defer fir.func_free(&changed);
                                fir.block_mut(&changed, b)->statements.items[p] = other;
                                fir.block mut* other_body = fir.block_mut(&changed, other_block);
                                other_body->statements.items[other_position] = saved;
                                conditional_fault(name, "cross-arm call identity", e, decl, f,
                                                    &changed, proposed, key, b, p);
                                swapped = true;
                            }
                            other_position += 1;
                        }
                        other_block += 1;
                    }
                    u32 mut capture_block = 0;
                    bool mut appended = false;
                    while (!appended && capture_block < fir.block_count(f)) {
                        u32 mut position = 0;
                        while (!appended
                            && position < fir.block_statement_count(f, capture_block)) {
                            fir.statement* capture =
                                fir.block_statement(f, capture_block, position);
                            if (fir_lower.range_audit_counter(f, capture)
                                && capture->stmt == saved.stmt
                                && fir_lower.range_audit_loc_eq(capture->exit_loc,
                                                                 saved.exit_loc)) {
                                fir.func mut changed = fir.func_clone(f);
                                defer fir.func_free(&changed);
                                linear_append(&changed, capture_block, saved);
                                conditional_fault(name, "write after joined read", e, decl, f,
                                                    &changed, proposed, key,
                                                    capture_block, position);
                                appended = true;
                            }
                            position += 1;
                        }
                        capture_block += 1;
                    }
                    assert(appended);
                }
                p += 1;
            }
            fir.terminator saved = fir.block_at(f, b)->term;
            if (saved.kind == fir.term_kind.tk_goto
                && saved.loc.line == key.source.line
                && saved.loc.col >= expression_column
                && fir_lower.range_audit_loc_eq(saved.exit_loc, key.exit_source)) {
                u32 mut mode = 0;
                while (mode < 5) {
                    fir.func mut changed = fir.func_clone(f);
                    defer fir.func_free(&changed);
                    fir.terminator mut* exit = &fir.block_mut(&changed, b)->term;
                    string mut damage = "join exit source";
                    if (mode == 0) { exit->loc.col += 1; }
                    else if (mode == 1) { exit->stmt += 1; damage = "join exit statement"; }
                    else if (mode == 2) { exit->exit_loc.col += 1; damage = "join exit context"; }
                    else if (mode == 3) {
                        damage = "join target substitution";
                        exit->target = b;
                    } else {
                        damage = "extra join predecessor";
                        u32 extra = fir.block_new(&changed);
                        fir.block_mut(&changed, extra)->term = saved;
                    }
                    conditional_fault(name, damage, e, decl, f, &changed,
                                        proposed, key, b, fir.block_statement_count(f, b));
                    mode += 1;
                }
            }
            b += 1;
        }
        row += 1;
    }
}

fn conditional_operand_pair(string name, string@ prelude, string parameters,
                                  string element, string expression) void {
    strbuf.str_buf mut header = strbuf.create();
    defer strbuf.free(&header);
    strbuf.append(&header, "fn walk(bool quit, ");
    strbuf.append(&header, parameters);
    strbuf.append(&header, ") void {");
    strbuf.str_buf mut loop = strbuf.create();
    defer strbuf.free(&loop);
    strbuf.append(&loop, "        for (");
    strbuf.append(&loop, element);
    strbuf.append(&loop, " x : ");
    strbuf.append(&loop, expression);
    strbuf.append(&loop, ") { }");
    u32 mut mode = 0;
    while (mode < 2) {
        string mut@ own source = new(string, prelude.len + 7);
        defer del(source);
        u64 mut i = 0;
        while (i < prelude.len) { source[i] = prelude[i]; i += 1; }
        source[i] = strbuf.view(&header);
        source[i + 1] = "";
        source[i + 2] = strbuf.view(&loop);
        source[i + 3] = "";
        source[i + 4] = "    if (quit) { return; }";
        source[i + 5] = "}";
        source[i + 6] = "";
        strbuf.str_buf mut key = strbuf.create();
        defer strbuf.free(&key);
        strbuf.append(&key, "conditional_operand_");
        strbuf.append(&key, name);
        u32 mut context_line = 0;
        u64 mut expected_rows = 1;
        if (mode == 0) { strbuf.append(&key, "_direct"); }
        else {
            source[i + 1] = "    defer {";
            source[i + 3] = "    }";
            context_line = cast(i + 2, u32);
            expected_rows = 2;
            strbuf.append(&key, "_deferred");
        }
        lower_env.env mut e = lower_env.env{};
        lower_env.open(&e);
        defer lower_env.close(&e);
        lower_env.check_lines(&e, source, true);
        ast.node* decl = lower_env.decl(&e, "walk");
        fir.func mut f = fir.func{};
        defer fir.func_free(&f);
        fir_lower.range_candidate_set mut proposed = fir_lower.range_candidate_set{};
        defer fir_lower.range_candidate_set_free(&proposed);
        fir_lower.report mut why = fir_lower.report{};
        assert(fir_lower.lower_function_with_range_candidates(&e.c.ck, decl, &f, &proposed, &why));
        fir_verify.violation mut bad = fir_verify.violation{};
        assert(!fir_verify.find_violation(&f, &e.rt, &bad));
        eprintln(strbuf.view(&key), " verifies fixture FIR");
        fir_lower.range_source_audit mut audit = fir_lower.range_source_audit{};
        defer fir_lower.range_source_audit_free(&audit);
        bool matched = fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit);
        if (!matched) { eprintln(strbuf.view(&key), " refuses a proved conditional operand"); }
        assert(matched);
        assert(audit.rows.len == expected_rows && proposed.captures.len == expected_rows);
        assert(audit.matched_captures == cast(expected_rows, u32));
        assert(audit.matched_boundaries == cast(proposed.boundaries.len, u32));
        u64 mut row = 0;
        while (row < expected_rows) {
            fir_lower.range_audit_key actual = audit.rows.items[row].key;
            assert(actual.source.line == cast(i + 3, u32));
            assert(actual.context_source.line == context_line);
            if (mode == 0) {
                assert(actual.context == 0 && actual.exit_occurrence == 0);
                assert(actual.exit_source.line == 0);
            } else {
                assert(actual.context != 0 && actual.exit_occurrence != 0);
                assert(actual.exit_source.line != 0);
                if (row != 0) {
                    assert(actual.exit_occurrence != audit.rows.items[row - 1].key.exit_occurrence);
                }
            }
            row += 1;
        }
        assert_unpublished(&f, &audit);
        conditional_operand_damage(strbuf.view(&key), &e, decl, &f, &proposed, &audit);
        check_output(&e, decl, &f, strbuf.view(&key), true);
        fir_lower.range_candidate_set_free(&proposed);
        conditional_receipt(strbuf.view(&key), &f, &audit, true);
        assert(audit.rows.len == expected_rows);
        assert_unpublished(&f, &audit);
        conditional_operand_pairs += 1;
        conditional_operand_rows += cast(expected_rows, u32);
        mode += 1;
    }
}

u32 mut conditional_auxiliary_executions = 0;
u32 mut conditional_callee_mutation_executions = 0;
u32 mut conditional_callee_changed_expansions = 0;

fn conditional_alias_case(bool projected, bool after, bool deferred) void {
    string[8] mut source = {
        "fn pick(i32@ a, i32@ b) i32@ { return a; }",
        "",
        "fn walk(bool quit, bool select, i32@ values, i32@ backup) void {",
        "",
        "    for (i32 x : select ? pick(values, backup) : backup) { }",
        "",
        "    if (quit) { return; }",
        "}",
    };
    if (projected) {
        source[0] = "struct holder { i32@ items; i32@ other; }";
        source[1] = "fn pick(holder a, holder b) holder { return a; }";
        source[2] = "fn walk(bool quit, bool select, holder values, holder backup) void {";
        source[4] = "    for (i32 x : (select ? pick(values, backup) : backup).items) { }";
    }
    if (deferred) { source[3] = "    defer {"; source[5] = "    }"; }
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    lower_env.check_lines(&e, source[..], true);
    ast.node* decl = lower_env.decl(&e, "walk");
    fir.func mut f = fir.func{};
    defer fir.func_free(&f);
    fir_lower.range_candidate_set mut proposed = fir_lower.range_candidate_set{};
    defer fir_lower.range_candidate_set_free(&proposed);
    fir_lower.report mut why = fir_lower.report{};
    assert(fir_lower.lower_function_with_range_candidates(&e.c.ck, decl, &f, &proposed, &why));
    fir_lower.range_source_audit mut original = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&original);
    assert(fir_lower.audit_produced_ranges(decl, &f, &proposed, &original));
    fir_lower.range_audit_key key = original.rows.items[0].key;
    fir_lower.range_material_point mut at = fir_lower.range_material_point{};
    fir.statement mut called = fir.statement{};
    u32 mut calls = 0;
    u32 mut b = 0;
    while (b < fir.block_count(&f)) {
        u32 mut p = 0;
        while (p < fir.block_statement_count(&f, b)) {
            fir.statement* s = fir.block_statement(&f, b, p);
            if (s->kind == fir.stmt_kind.st_assign && s->value.kind == fir.rvalue_kind.rv_call
                && fir_lower.range_audit_loc_eq(s->exit_loc, key.exit_source)) {
                at = fir_lower.range_material_point{.block = b, .position = p + 1};
                called = *s;
                calls += 1;
            }
            p += 1;
        }
        b += 1;
    }
    assert(calls == 1 && called.place.proj_len == 0);
    fir.operand backup = fir.operand_at(&f, called.value.ops_first + 1);
    fir.place mut target = called.place;
    fir.place mut replacement = backup.place;
    if (projected) {
        target = fir.place_field(&f, target, 0);
        replacement = fir.place_field(&f, replacement, 0);
    }
    if (after) {
        u64 mut i = 0;
        u32 mut captures = 0;
        while (i < proposed.boundaries.len) {
            fir_lower.range_boundary_candidate* c = &proposed.boundaries.items[i];
            if (c->expansion == key.expansion
                && c->boundary.kind == fir.range_boundary_kind.capture) {
                at = fir_lower.range_material_point{
                    .block = c->boundary.block, .position = c->boundary.position};
                captures += 1;
            }
            i += 1;
        }
        assert(captures == 1);
    }
    fir.func mut baseline = fir.func_clone(&f);
    defer fir.func_free(&baseline);
    fir.rvalue address = fir.rvalue_addr(&f, target, true);
    u32 alias = fir.local_add(&f, fir.rvalue_type(&f, address),
                              fir.local_kind.lk_temp, null, called.loc);
    fir.statement mut take = fir.stmt_assign(fir.place_local(alias), address,
                                             called.loc, called.stmt);
    take.exit_loc = called.exit_loc;
    fir.place indirect = fir.place_deref(&f, fir.place_local(alias));
    fir.statement mut write = fir.stmt_assign(indirect,
        fir.rvalue_use(&f, fir.operand_copy(replacement)), called.loc, called.stmt);
    write.exit_loc = called.exit_loc;
    assert(fir.place_fixed(&f, target) && indirect.local != target.local);
    linear_append(&f, at.block, take);
    linear_append(&f, at.block, write);
    fir.block mut* bk = fir.block_mut(&f, at.block);
    u64 mut p = bk->statements.len - 2;
    while (p > cast(at.position, u64)) {
        p -= 1;
        bk->statements.items[p + 2] = bk->statements.items[p];
    }
    bk->statements.items[at.position] = take;
    bk->statements.items[at.position + 1] = write;
    u64 mut i = 0;
    while (i < proposed.boundaries.len) {
        fir.range_boundary mut* bd = &proposed.boundaries.items[i].boundary;
        if (bd->block == at.block
            && (bd->position > at.position || (!after && bd->position == at.position))) {
            bd->position += 2;
        }
        i += 1;
    }
    strbuf.str_buf mut name = strbuf.create();
    defer strbuf.free(&name);
    strbuf.append(&name, "joined_alias_address_");
    strbuf.append_u64(&name, cast(projected, u64));
    strbuf.append_u64(&name, cast(after, u64));
    strbuf.append_u64(&name, cast(deferred, u64));
    fir_verify.violation mut bad = fir_verify.violation{};
    assert(!fir_verify.find_violation(&f, &e.rt, &bad));
    eprintln("valid alias FIR projected ", projected, " after ", after, " deferred ", deferred);
    conditional_auxiliary_equal(strbuf.view(&name), &e, decl, &baseline);
    conditional_auxiliary_bytes(strbuf.view(&name), &baseline, &f);
    conditional_verify_damage(&e, decl, &f, 600000 + conditional_auxiliary_executions);
    fir_lower.range_source_audit mut retained = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&retained);
    assert(!fir_lower.audit_produced_ranges(decl, &f, &proposed, &retained));
    fir_lower.range_candidate_set_free(&proposed);
    assert(retained.failure.reason == fir_lower.range_audit_fault.protected_path);
    assert_linear_key(retained.failure.key, key);
    conditional_receipt(strbuf.view(&name), &f, &retained, false);
    conditional_auxiliary_executions += 1;
    assert_unpublished(&f, &original);
    assert_linear_key(original.rows.items[0].key, key);
}

fn conditional_slice_case(u32 shape, bool after, bool deferred, bool mutable_alias) void {
    string[8] mut source = {
        "fn pick(i32@[2] a, i32@[2] b) i32@[2] { return a; }",
        "",
        "fn walk(bool quit, bool select, i32@[2] values, i32@[2] backup) void {",
        "",
        "    for (i32 x : (select ? pick(values, backup) : backup)[0]) { }",
        "",
        "    if (quit) { return; }",
        "}",
    };
    if (shape == 1) {
        source[0] = "struct holder { i32@[2] lists; i32@[2] other; }";
        source[1] = "fn pick(holder a, holder b) holder { return a; }";
        source[2] = "fn walk(bool quit, bool select, holder values, holder backup) void {";
        source[4] = "    for (i32 x : (select ? pick(values, backup) : backup).lists[0]) { }";
    } else if (shape == 2) {
        source[0] = "fn pick(i32@ a, i32@ b) i32@ { return a; }";
        source[2] = "fn walk(bool quit, bool select, i32@ values, i32@ backup) void {";
        source[4] = "    for (i32 x : select ? pick(values, backup) : backup) { }";
    } else if (shape == 3) {
        source[0] = "fn pick(i32@[2]* a, i32@[2]* b) i32@[2]* { return a; }";
        source[2] = "fn walk(bool quit, bool select, i32@[2]* values, i32@[2]* backup) void {";
        source[4] = "    for (i32 x : (*(select ? pick(values, backup) : backup))[0]) { }";
    }
    if (deferred) { source[3] = "    defer {"; source[5] = "    }"; }
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    lower_env.check_lines(&e, source[..], true);
    ast.node* decl = lower_env.decl(&e, "walk");
    fir.func mut f = fir.func{};
    defer fir.func_free(&f);
    fir_lower.range_candidate_set mut proposed = fir_lower.range_candidate_set{};
    defer fir_lower.range_candidate_set_free(&proposed);
    fir_lower.report mut why = fir_lower.report{};
    assert(fir_lower.lower_function_with_range_candidates(&e.c.ck, decl, &f, &proposed, &why));
    fir_lower.range_source_audit mut original = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&original);
    assert(fir_lower.audit_produced_ranges(decl, &f, &proposed, &original));
    fir_lower.range_audit_key key = original.rows.items[0].key;
    fir_lower.range_material_point mut at = fir_lower.range_material_point{};
    fir.statement mut called = fir.statement{};
    fir.place mut index = fir.place{};
    u32 mut calls = 0;
    u32 mut indices = 0;
    u32 mut b = 0;
    while (b < fir.block_count(&f)) {
        u32 mut p = 0;
        while (p < fir.block_statement_count(&f, b)) {
            fir.statement* s = fir.block_statement(&f, b, p);
            if (s->kind == fir.stmt_kind.st_assign
                && fir_lower.range_audit_loc_eq(s->exit_loc, key.exit_source)) {
                if (s->value.kind == fir.rvalue_kind.rv_call) {
                    called = *s;
                    calls += 1;
                    if (shape == 2) {
                        at = fir_lower.range_material_point{.block = b, .position = p + 1};
                    }
                } else if (s->value.kind == fir.rvalue_kind.rv_cast
                    && s->value.ty->kind == types.type_kind.k_prim
                    && s->value.ty->prim == prim.prim_kind.prim_u64) {
                    index = s->place;
                    at = fir_lower.range_material_point{.block = b, .position = p + 1};
                    indices += 1;
                }
            }
            p += 1;
        }
        b += 1;
    }
    assert(calls == 1 && (shape == 2 || indices == 1));
    fir.place mut target = called.place;
    fir.place mut replacement = fir.operand_at(&f, called.value.ops_first + 1).place;
    if (shape == 1) {
        target = fir.place_field(&f, target, 0);
        replacement = fir.place_field(&f, replacement, 0);
    } else if (shape == 3) {
        u32 mut joins = 0;
        b = 0;
        while (b < fir.block_count(&f)) {
            u32 mut p = 0;
            while (p < fir.block_statement_count(&f, b)) {
                fir.statement* s = fir.block_statement(&f, b, p);
                if (s->value.kind == fir.rvalue_kind.rv_use && s->value.ops_len == 1
                    && fir_lower.range_audit_loc_eq(s->loc, called.loc)
                    && fir_lower.range_audit_loc_eq(s->exit_loc, called.exit_loc)) {
                    fir.operand value = fir.operand_at(&f, s->value.ops_first);
                    if (value.kind == fir.operand_kind.ok_copy
                        && fir_lower.range_audit_place_eq(&f, value.place, called.place)) {
                        target = s->place;
                        joins += 1;
                    }
                }
                p += 1;
            }
            b += 1;
        }
        assert(joins == 1);
        target = fir.place_deref(&f, target);
    }
    if (after) {
        u64 mut i = 0;
        u32 mut captures = 0;
        while (i < proposed.boundaries.len) {
            fir_lower.range_boundary_candidate* c = &proposed.boundaries.items[i];
            if (c->expansion == key.expansion
                && c->boundary.kind == fir.range_boundary_kind.capture) {
                at = fir_lower.range_material_point{
                    .block = c->boundary.block, .position = c->boundary.position + 1};
                captures += 1;
            }
            i += 1;
        }
        assert(captures == 1);
    }
    fir.func mut baseline = fir.func_clone(&f);
    defer fir.func_free(&baseline);
    types.node* wide = types.type_prim(f.tt, prim.prim_kind.prim_u64);
    fir.rvalue sliced = fir.rvalue_slice(&f, target, fir_lower.int_const(wide, false, 0),
        fir_lower.int_const(wide, false, 2), mutable_alias);
    u32 alias = fir.local_add(&f, fir.rvalue_type(&f, sliced),
                              fir.local_kind.lk_temp, null, called.loc);
    fir.statement mut take = fir.stmt_assign(fir.place_local(alias), sliced,
                                             called.loc, called.stmt);
    take.exit_loc = called.exit_loc;
    u32 mut inserted = 1;
    fir.statement mut write = fir.statement{};
    if (shape < 2 && mutable_alias) {
        fir.place indirect = fir.place_index(&f, fir.place_local(alias), index.local);
        fir.place backup = fir.place_index(&f, replacement, index.local);
        write = fir.stmt_assign(indirect, fir.rvalue_use(&f, fir.operand_copy(backup)),
                                called.loc, called.stmt);
        write.exit_loc = called.exit_loc;
        assert(indirect.local != target.local && !fir.place_fixed(&f, indirect));
        inserted = 2;
    }
    linear_append(&f, at.block, take);
    if (inserted == 2) { linear_append(&f, at.block, write); }
    fir.block mut* bk = fir.block_mut(&f, at.block);
    u64 mut p = bk->statements.len - cast(inserted, u64);
    while (p > cast(at.position, u64)) {
        p -= 1;
        bk->statements.items[p + cast(inserted, u64)] = bk->statements.items[p];
    }
    bk->statements.items[at.position] = take;
    if (inserted == 2) { bk->statements.items[at.position + 1] = write; }
    u64 mut i = 0;
    while (i < proposed.boundaries.len) {
        fir.range_boundary mut* bd = &proposed.boundaries.items[i].boundary;
        if (bd->block == at.block
            && (bd->position > at.position || (!after && bd->position == at.position))) {
            bd->position += inserted;
        }
        i += 1;
    }
    strbuf.str_buf mut name = strbuf.create();
    defer strbuf.free(&name);
    strbuf.append(&name, "joined_alias_slice_");
    strbuf.append_u64(&name, cast(shape, u64));
    strbuf.append_u64(&name, cast(after, u64));
    strbuf.append_u64(&name, cast(deferred, u64));
    strbuf.append_u64(&name, cast(mutable_alias, u64));
    fir_verify.violation mut bad = fir_verify.violation{};
    assert(!fir_verify.find_violation(&f, &e.rt, &bad));
    eprintln("valid slice FIR shape ", shape, " after ", after, " deferred ", deferred,
             " mutable ", mutable_alias);
    conditional_auxiliary_equal(strbuf.view(&name), &e, decl, &baseline);
    conditional_auxiliary_bytes(strbuf.view(&name), &baseline, &f);
    conditional_verify_damage(&e, decl, &f, 600000 + conditional_auxiliary_executions);
    fir_lower.range_source_audit mut retained = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&retained);
    bool accepted = fir_lower.audit_produced_ranges(decl, &f, &proposed, &retained);
    assert(accepted == (shape >= 2));
    fir_lower.range_candidate_set_free(&proposed);
    if (accepted) {
        assert(retained.rows.len == original.rows.len);
        assert_linear_key(retained.rows.items[0].key, key);
    } else {
        assert(retained.failure.reason == fir_lower.range_audit_fault.protected_path);
        assert_linear_key(retained.failure.key, key);
    }
    conditional_receipt(strbuf.view(&name), &f, &retained, accepted);
    conditional_auxiliary_executions += 1;
    assert_unpublished(&f, &original);
    assert_linear_key(original.rows.items[0].key, key);
}

fn conditional_alias_matrix() void {
    u32 mut mode = 0;
    while (mode < 8) {
        conditional_alias_case((mode & 1) != 0, (mode & 2) != 0, (mode & 4) != 0);
        mode += 1;
    }
    mode = 0;
    while (mode < 8) {
        u32 mut shape = 0;
        while (shape < 4) {
            conditional_slice_case(shape, (mode & 2) != 0, (mode & 4) != 0, shape < 2);
            if (shape < 2) {
                conditional_slice_case(shape, (mode & 2) != 0, (mode & 4) != 0, false);
            }
            shape += 1;
        }
        mode += 2;
    }
}

// These fixture records retain checked producer evidence. The audit reads no value table.
fn conditional_callee_source(string name, lower_env.env* e, ast.node* call,
                               string@ lines, fir.func* f) void {
    ast.node* choice = call->a;
    assert(choice->kind == ast.ast_kind.k_ternary);
    assert(choice->a->kind == ast.ast_kind.k_bool);
    assert(check.check_node_value(&e->c.ck, choice->b).kind == consts.cval_kind.cv_none);
    assert(check.check_node_value(&e->c.ck, choice->c).kind == consts.cval_kind.cv_none);
    assert(choice->b->sym->kind == ast.sym_kind.s_fn);
    assert(choice->c->sym->kind == ast.sym_kind.s_fn);
    string mut dir = "";
    if (!sys.env("FORT_RANGE_PROBE_DIR", &dir)) { return; }
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    json.writer mut j = json.writer{};
    json.json_init(&j, &text);
    json.json_object_begin(&j);
    json.json_key(&j, "source");
    json.json_array_begin(&j);
    u64 mut i = 0;
    while (i < lines.len) { json.json_str(&j, lines[i]); i += 1; }
    json.json_array_end(&j);
    json.json_key(&j, "predicate");
    json.json_uint(&j, choice->a->ival);
    json.json_key(&j, "checked_nodes");
    json.json_array_begin(&j);
    conditional_json_loc(&j, call->loc);
    conditional_json_loc(&j, choice->loc);
    conditional_json_loc(&j, choice->a->loc);
    conditional_json_loc(&j, choice->b->loc);
    conditional_json_loc(&j, choice->c->loc);
    json.json_array_end(&j);
    json.json_key(&j, "arm_symbols");
    json.json_array_begin(&j);
    json.json_str(&j, choice->b->sym->name);
    json.json_str(&j, choice->c->sym->name);
    json.json_array_end(&j);
    json.json_key(&j, "arm_values");
    json.json_array_begin(&j);
    json.json_str(&j, "cv_none");
    json.json_str(&j, "cv_none");
    json.json_array_end(&j);
    strbuf.str_buf mut snapshot = strbuf.create();
    defer strbuf.free(&snapshot);
    conditional_snapshot(f, &snapshot);
    json.json_key(&j, "producer_fir");
    json.json_str(&j, strbuf.view(&snapshot));
    json.json_object_end(&j);
    probe_file(dir, name, strbuf.view(&text));
}

// A source fixture and a substitution fixture have separate executions and counts.
fn conditional_operand_auxiliary(string name, string@ prelude, string parameters,
                                    string expression, bool deferred, bool literal,
                                    bool substitute) void {
    strbuf.str_buf mut header = strbuf.create();
    defer strbuf.free(&header);
    strbuf.append(&header, "fn walk(bool quit, bool select, ");
    strbuf.append(&header, parameters);
    strbuf.append(&header, ") void {");
    strbuf.str_buf mut loop = strbuf.create();
    defer strbuf.free(&loop);
    strbuf.append(&loop, "        for (i32 x : ");
    strbuf.append(&loop, expression);
    strbuf.append(&loop, ") { }");
    string mut@ own source = new(string, prelude.len + 7);
    defer del(source);
    u64 mut i = 0;
    while (i < prelude.len) { source[i] = prelude[i]; i += 1; }
    source[i] = strbuf.view(&header);
    source[i + 1] = "";
    source[i + 2] = strbuf.view(&loop);
    source[i + 3] = "";
    source[i + 4] = "    if (quit) { return; }";
    source[i + 5] = "}";
    source[i + 6] = "";
    if (deferred) { source[i + 1] = "    defer {"; source[i + 3] = "    }"; }
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    lower_env.check_lines(&e, source, true);
    ast.node* decl = lower_env.decl(&e, "walk");
    gen.node_ref_vec mut selected = gen.node_ref_vec{};
    defer gen.refs_free(&selected);
    fir_lower.range_audit_selected(decl->b, &selected);
    assert(selected.len == 1);
    ast.node* call = gen.refs_at(&selected, 0)->b;
    fir.func mut f = fir.func{};
    defer fir.func_free(&f);
    fir_lower.range_candidate_set mut proposed = fir_lower.range_candidate_set{};
    defer fir_lower.range_candidate_set_free(&proposed);
    fir_lower.report mut why = fir_lower.report{};
    assert(fir_lower.lower_function_with_range_candidates(&e.c.ck, decl, &f, &proposed, &why));
    fir_verify.violation mut bad = fir_verify.violation{};
    assert(!fir_verify.find_violation(&f, &e.rt, &bad));
    fir_lower.range_source_audit mut audit = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&audit);
    assert(fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    u64 mut expected = 1;
    if (deferred) { expected = 2; }
    assert(audit.rows.len == expected);
    if (deferred) {
        assert(audit.rows.items[0].key.context != 0 && audit.rows.items[1].key.context != 0);
        assert(audit.rows.items[0].key.exit_occurrence != audit.rows.items[1].key.exit_occurrence);
        assert(!fir_lower.range_audit_loc_eq(audit.rows.items[0].key.exit_source,
                                              audit.rows.items[1].key.exit_source));
    }
    if (literal) { conditional_callee_source(name, &e, call, source, &f); }
    if (substitute) {
        assert(literal);
        u64 mut row = 0;
        while (row < expected) {
            fir_lower.range_audit_key key = audit.rows.items[row].key;
            fir.func mut changed = fir.func_clone(&f);
            defer fir.func_free(&changed);
            u32 mut count = 0;
            u32 mut b = 0;
            while (b < fir.block_count(&changed)) {
                u32 mut p = 0;
                while (p < fir.block_statement_count(&changed, b)) {
                    fir.statement mut* s = &fir.block_mut(&changed, b)->statements.items[p];
                    if (s->value.kind == fir.rvalue_kind.rv_call
                        && fir_lower.range_audit_loc_eq(s->loc, call->loc)
                        && fir_lower.range_audit_loc_eq(s->exit_loc, key.exit_source)) {
                        assert(s->value.callee == fir.callee_kind.cl_value);
                        assert(s->value.callee_op.kind == fir.operand_kind.ok_copy);
                        ast.node* mut arm = call->a->c;
                        if (call->a->a->ival != 0) { arm = call->a->b; }
                        s->value.callee_op = fir.operand_const(fir.const_fn(arm->sym));
                        count += 1;
                    }
                    p += 1;
                }
                b += 1;
            }
            assert(count == 1);
            assert(!fir_verify.find_violation(&changed, &e.rt, &bad));
            conditional_fault(name, "selected symbol replaces consumed callee join", &e,
                                decl, &f, &changed, &proposed, key, 0, 0);
            fir.func mut repeat = fir.func{};
            defer fir.func_free(&repeat);
            fir_lower.range_candidate_set mut candidate = fir_lower.range_candidate_set{};
            defer fir_lower.range_candidate_set_free(&candidate);
            assert(fir_lower.lower_function_with_range_candidates(&e.c.ck, decl,
                &repeat, &candidate, &why));
            fir_lower.range_source_audit mut retained = fir_lower.range_source_audit{};
            defer fir_lower.range_source_audit_free(&retained);
            assert(!fir_lower.audit_produced_ranges(decl, &changed, &candidate, &retained));
            fir_lower.range_candidate_set_free(&candidate);
            assert_linear_key(retained.failure.key, key);
            conditional_receipt(name, &changed, &retained, false);
            conditional_callee_changed_expansions += 1;
            row += 1;
        }
        conditional_callee_mutation_executions += 1;
    } else {
        conditional_auxiliary_equal(name, &e, decl, &f);
        if (!literal) {
            conditional_operand_damage(name, &e, decl, &f, &proposed, &audit);
            conditional_held_refusal(name, &e, decl, &f, &proposed, audit.rows.items[0].key);
        }
        conditional_auxiliary_executions += 1;
    }
    fir_lower.range_candidate_set_free(&proposed);
    conditional_receipt(name, &f, &audit, true);
}

fn conditional_operand_auxiliary_matrix() void {
    string[2] callees = {
        "fn pick(i32@ a, i32@ b) i32@ { return a; }",
        "fn other(i32@ a, i32@ b) i32@ { return b; }",
    };
    u32 mut mode = 0;
    while (mode < 4) {
        string mut expression = "(true ? pick : other)(values, backup)";
        if ((mode & 1) != 0) { expression = "(false ? pick : other)(values, backup)"; }
        strbuf.str_buf mut name = strbuf.create();
        defer strbuf.free(&name);
        strbuf.append(&name, "callee_literal_");
        strbuf.append_u64(&name, cast(mode, u64));
        conditional_operand_auxiliary(strbuf.view(&name), callees[..],
            "i32@ values, i32@ backup", expression, mode >= 2, true, false);
        strbuf.append(&name, "_selected_symbol_mutation");
        conditional_operand_auxiliary(strbuf.view(&name), callees[..],
            "i32@ values, i32@ backup", expression, mode >= 2, true, true);
        mode += 1;
    }
    string[5] change_callee = {
        "struct holder { fn (i32@, i32@) i32@ action; }",
        "fn replace(holder mut* p,",
        "           fn (i32@, i32@) i32@ other, i32@ values) i32@ {",
        "    p->action = other; return values;", "}",
    };
    string[2] change_argument = {
        callees[0],
        "fn replace(i32@ mut* p, i32@ other) i32@ { *p = other; return other; }",
    };
    mode = 0;
    while (mode < 2) {
        string mut callee_name = "held_callee_direct";
        string mut argument_name = "held_argument_direct";
        if (mode != 0) {
            callee_name = "held_callee_deferred";
            argument_name = "held_argument_deferred";
        }
        conditional_operand_auxiliary(callee_name, change_callee[..],
            "holder mut operations, fn (i32@, i32@) i32@ other, i32@ values, i32@ backup",
            "(select ? operations.action : other)(values, replace(&operations, other, backup))",
            mode != 0, false, false);
        conditional_operand_auxiliary(argument_name, change_argument[..],
            "i32@ mut values, i32@ backup",
            "pick(select ? values : backup, replace(&values, backup))",
            mode != 0, false, false);
        mode += 1;
    }
    assert(conditional_auxiliary_executions == 40);
    assert(conditional_callee_mutation_executions == 4);
    assert(conditional_callee_changed_expansions == 6);
}

// Auxiliary output equality does not add a module pair to the required pair ledger.
fn conditional_auxiliary_equal(string name, lower_env.env mut* e, ast.node* decl,
                                  fir.func* audited) void {
    fir.func mut ordinary = fir.func{};
    defer fir.func_free(&ordinary);
    fir_lower.report mut why = fir_lower.report{};
    assert(fir_lower.lower_function(&e->c.ck, decl, &ordinary, &why));
    fir_verify.violation mut bad = fir_verify.violation{};
    assert(!fir_verify.find_violation(&ordinary, &e->rt, &bad));
    strbuf.str_buf mut first = strbuf.create();
    defer strbuf.free(&first);
    strbuf.str_buf mut second = strbuf.create();
    defer strbuf.free(&second);
    conditional_snapshot(&ordinary, &first);
    conditional_snapshot(audited, &second);
    assert(strbuf.view(&first) == strbuf.view(&second));
    gen.emitter mut original = gen.emitter{};
    defer gen.gen_free(&original);
    gen.emitter mut changed = gen.emitter{};
    defer gen.gen_free(&changed);
    probe_emissions mut a = probe_emissions{};
    probe_emissions mut b = probe_emissions{};
    probe_module(e, decl, null, &original, &a);
    probe_module(e, decl, audited, &changed, &b);
    assert(strbuf.view(&original.out) == strbuf.view(&changed.out));
    conditional_verify_damage(e, decl, audited, 610000 + conditional_auxiliary_executions);
    string mut dir = "";
    if (!sys.env("FORT_RANGE_PROBE_DIR", &dir)) { return; }
    strbuf.str_buf mut leaf = strbuf.create();
    defer strbuf.free(&leaf);
    strbuf.append(&leaf, name);
    strbuf.append(&leaf, "_ordinary_equal.json");
    probe_file(dir, strbuf.view(&leaf), "{\"fir_equal\":true,\"llvm_equal\":true}");
}

// The report keeps the held-operand failure after the audited candidate owner ends.
fn conditional_held_refusal(string name, lower_env.env mut* e, ast.node* decl, fir.func* f,
                              fir_lower.range_candidate_set* proposed,
                              fir_lower.range_audit_key key) void {
    fir.func mut changed = fir.func_clone(f);
    defer fir.func_free(&changed);
    u32 mut count = 0;
    u32 mut b = 0;
    while (b < fir.block_count(f)) {
        fir.terminator mut* t = &fir.block_mut(&changed, b)->term;
        if (t->kind == fir.term_kind.tk_switch && t->loc.line == key.source.line
            && t->loc.col > key.source.col
            && fir_lower.range_audit_loc_eq(t->exit_loc, key.exit_source)) {
            fir.operand mut other = fir.operand{};
            assert(linear_other_parameter(f, t->cond, &other));
            t->cond = other;
            count += 1;
            break;
        }
        b += 1;
    }
    assert(count == 1);
    fir_verify.violation mut bad = fir_verify.violation{};
    assert(!fir_verify.find_violation(&changed, &e->rt, &bad));
    conditional_fault(name, "held operand predicate substitution", e, decl, f, &changed,
                        proposed, key, b, fir.block_statement_count(f, b));
    fir.func mut repeat = fir.func{};
    defer fir.func_free(&repeat);
    fir_lower.range_candidate_set mut candidate = fir_lower.range_candidate_set{};
    defer fir_lower.range_candidate_set_free(&candidate);
    fir_lower.report mut why = fir_lower.report{};
    assert(fir_lower.lower_function_with_range_candidates(&e->c.ck, decl,
        &repeat, &candidate, &why));
    fir_lower.range_source_audit mut retained = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&retained);
    assert(!fir_lower.audit_produced_ranges(decl, &changed, &candidate, &retained));
    fir_lower.range_candidate_set_free(&candidate);
    assert_linear_key(retained.failure.key, key);
    conditional_receipt(name, &changed, &retained, false);
}

fn conditional_control_case(string name, string@ source, bool accepted) void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    lower_env.check_lines(&e, source, true);
    ast.node* decl = lower_env.decl(&e, "walk");
    fir.func mut f = fir.func{};
    defer fir.func_free(&f);
    fir_lower.range_candidate_set mut proposed = fir_lower.range_candidate_set{};
    defer fir_lower.range_candidate_set_free(&proposed);
    fir_lower.report mut why = fir_lower.report{};
    assert(fir_lower.lower_function_with_range_candidates(&e.c.ck, decl, &f, &proposed, &why));
    fir_lower.range_source_audit mut audit = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&audit);
    bool matched = fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit);
    if (matched != accepted) { eprintln(name, " changes its protected-place verdict"); }
    assert(matched == accepted);
    assert(audit.selected_declarations == 1 && audit.produced_expansions == 1);
    if (accepted) {
        assert(audit.rows.len == 1 && audit.matched_captures == 1);
        assert(audit.matched_boundaries == cast(proposed.boundaries.len, u32));
    } else {
        assert(audit.failure.reason == fir_lower.range_audit_fault.protected_path);
        assert(audit.failure.key.source.line == 5);
        assert(audit.rows.len == 0 && audit.matched_captures == 0);
    }
    check_output(&e, decl, &f, name, true);
    fir_lower.range_candidate_set_free(&proposed);
    conditional_receipt(name, &f, &audit, accepted);
    assert_unpublished(&f, &audit);
    if (accepted) { assert(audit.rows.len == 1); }
    else { assert(audit.failure.reason == fir_lower.range_audit_fault.protected_path); }
}

fn conditional_materialization_pair(string name, string first, string second,
                                      string parameters, string element, string expression,
                                      bool accepted, bool control) void {
    strbuf.str_buf mut header = strbuf.create();
    defer strbuf.free(&header);
    strbuf.append(&header, "fn walk(");
    strbuf.append(&header, parameters);
    strbuf.append(&header, ") void {");
    strbuf.str_buf mut loop = strbuf.create();
    defer strbuf.free(&loop);
    strbuf.append(&loop, "        for (");
    strbuf.append(&loop, element);
    strbuf.append(&loop, " x : ");
    strbuf.append(&loop, expression);
    strbuf.append(&loop, ") { }");
    u32 mut mode = 0;
    while (mode < 2) {
        string[8] mut source = {
            first, second, strbuf.view(&header), "", strbuf.view(&loop), "", "}", "",
        };
        strbuf.str_buf mut key = strbuf.create();
        strbuf.append(&key, name);
        u32 mut context = 0;
        if (mode == 0) {
            strbuf.append(&key, "_direct");
        } else {
            source[3] = "    defer {";
            source[5] = "    }";
            context = 4;
            strbuf.append(&key, "_deferred");
        }
        if (control) {
            conditional_control_case(strbuf.view(&key), source[..], accepted);
        } else {
            call_materialization_case(strbuf.view(&key), source[..], 5, context, accepted);
        }
        strbuf.free(&key);
        mode += 1;
    }
}

fn conditional_materialization_matrix() void {
    string span_call = "fn pick(i32@ values) i32@ { return values; }";
    string span_parameters = "bool select, bool other, i32@ values, i32@ backup";
    conditional_materialization_pair("conditional_span_then", span_call, "",
        span_parameters, "i32", "select ? pick(values) : backup", true, false);
    conditional_materialization_pair("conditional_span_else", span_call, "",
        span_parameters, "i32", "select ? values : pick(backup)", true, false);
    string string_call = "fn pick(string values) string { return values; }";
    string string_parameters = "bool select, string values, string backup";
    conditional_materialization_pair("conditional_string_then", string_call, "",
        string_parameters, "char", "select ? pick(values) : backup", true, false);
    conditional_materialization_pair("conditional_string_else", string_call, "",
        string_parameters, "char", "select ? values : pick(backup)", true, false);
    conditional_materialization_pair("conditional_nested_then_then", span_call, "",
        span_parameters, "i32", "select ? (other ? pick(values) : backup) : values", true, false);
    conditional_materialization_pair("conditional_nested_then_else", span_call, "",
        span_parameters, "i32", "select ? (other ? values : pick(backup)) : values", true, false);
    conditional_materialization_pair("conditional_nested_else_then", span_call, "",
        span_parameters, "i32", "select ? values : (other ? pick(values) : backup)", true, false);
    conditional_materialization_pair("conditional_nested_else_else", span_call, "",
        span_parameters, "i32", "select ? values : (other ? values : pick(backup))", true, false);
    string address_call = "fn pick(i32@* values) i32@* { return values; }";
    string address_parameters = "bool select, i32@* values, i32@* backup";
    conditional_materialization_pair("conditional_address_then", address_call, "",
        address_parameters, "i32", "*(select ? pick(values) : backup)", true, false);
    conditional_materialization_pair("conditional_address_else", address_call, "",
        address_parameters, "i32", "*(select ? values : pick(backup))", true, false);
    string holder = "struct holder { i32@ items; }";
    string member_call = "fn pick(holder* values) holder* { return values; }";
    string member_parameters = "bool select, holder* values, holder* backup";
    conditional_materialization_pair("conditional_member_then", holder, member_call,
        member_parameters, "i32", "(select ? pick(values) : backup)->items", true, false);
    conditional_materialization_pair("conditional_member_else", holder, member_call,
        member_parameters, "i32", "(select ? values : pick(backup))->items", true, false);
    conditional_materialization_pair("conditional_header_then", span_call, "",
        span_parameters, "i32", "(select ? pick(values) : backup)[..]", true, false);
    conditional_materialization_pair("conditional_header_else", span_call, "",
        span_parameters, "i32", "(select ? values : pick(backup))[..]", true, false);
    conditional_materialization_pair("conditional_cast_then", span_call, "",
        span_parameters, "i32", "cast(select ? pick(values) : backup, i32@)", true, false);
    conditional_materialization_pair("conditional_cast_else", span_call, "",
        span_parameters, "i32", "cast(select ? values : pick(backup), i32@)", true, false);
    string condition_call = "fn choose(bool selected) bool { return selected; }";
    conditional_materialization_pair("conditional_condition_call", condition_call, "",
        span_parameters, "i32", "choose(select) ? values : backup", false, false);
    // No-call controls preserve the existing accepted and incomplete source matches.
    conditional_materialization_pair("conditional_span_control", "", "",
        span_parameters, "i32", "select ? values : backup", true, true);
    conditional_materialization_pair("conditional_string_control", "", "",
        string_parameters, "char", "select ? values : backup", true, true);
    conditional_materialization_pair("conditional_nested_control", "", "",
        span_parameters, "i32", "select ? (other ? values : backup) : values", true, true);
    conditional_materialization_pair("conditional_address_control", "", "",
        address_parameters, "i32", "*(select ? values : backup)", true, true);
    conditional_materialization_pair("conditional_member_control", holder, "",
        member_parameters, "i32", "(select ? values : backup)->items", true, true);
    conditional_materialization_pair("conditional_header_control", "", "",
        span_parameters, "i32", "(select ? values : backup)[..]", true, true);
    conditional_materialization_pair("conditional_cast_control", "", "",
        span_parameters, "i32", "cast(select ? values : backup, i32@)", true, true);
}
fn additional_scope_matrix() void {
    string[8] scalar_defer_order = {
        "fn walk(i32[2] values) void {",
        "    i32 mut count = 0;",
        "    defer count +%= 1;",
        "    defer { for (i32 x : values) { } }",
        "    defer count +%= 2;",
        "}",
        "",
        "",
    };
    deferred_scope_case("scalar_defer_order", scalar_defer_order[..], 1, 1, 3);
    string[8] selected_inside_defer = {
        "fn walk(i32[2] values) void {",
        "    defer {",
        "        $if (true) {",
        "            for (i32 x : values) { }",
        "        }",
        "    }",
        "}",
        "",
    };
    deferred_scope_case("selected_inside_defer", selected_inside_defer[..], 1, 1, 1);
    string[10] empty_selection_inside_defer = {
        "fn walk(i32[2] values) void {",
        "    defer {",
        "        $if (false) {",
        "            for (i32 x : values) { }",
        "        } else {",
        "            for (i32 y : values) { }",
        "        }",
        "    }",
        "}",
        "",
    };
    deferred_scope_case("else_inside_defer", empty_selection_inside_defer[..], 1, 1, 1);
    string[9] abort_suppression = {
        "fn stop() noreturn { while (true) { } }",
        "fn walk(i32[2] values) void {",
        "    defer {",
        "        for (i32 x : values) { }",
        "    }",
        "    defer stop();",
        "    return;",
        "}",
        "",
    };
    deferred_scope_case("abort_suppression", abort_suppression[..], 1, 0, 2);
    string[9] range_then_abort = {
        "fn walk(i32[2] values) void {",
        "    defer {",
        "        for (i32 x : values) { }",
        "        panic(\"stop\");",
        "    }",
        "    defer { i32 value = 0; }",
        "}",
        "",
        "",
    };
    deferred_scope_case("range_then_abort", range_then_abort[..], 1, 1, 2);
    string[10] deferred_switch = {
        "fn walk(i32[2] values, i32 tag) void {",
        "    defer {",
        "        switch (tag) {",
        "        case 0:",
        "            for (i32 x : values) { }",
        "        default:",
        "            for (i32 y : values) { }",
        "        }",
        "    }",
        "}",
    };
    deferred_scope_case("deferred_switch", deferred_switch[..], 2, 2, 1);
    string[10] deferred_if = {
        "fn walk(i32[2] values, bool select) void {",
        "    defer {",
        "        if (select) {",
        "            for (i32 x : values) { }",
        "        } else {",
        "            for (i32 y : values) { }",
        "        }",
        "    }",
        "}",
        "",
    };
    deferred_scope_case("deferred_if", deferred_if[..], 2, 2, 1);
    string[9] deferred_body_local = {
        "fn walk(i32[2] values) void {",
        "    defer {",
        "        for (i32 x : values) {",
        "            i32 saved = x;",
        "            { i32 other = saved; }",
        "        }",
        "    }",
        "}",
        "",
    };
    deferred_scope_case("deferred_body_local", deferred_body_local[..], 1, 1, 1);
}

fn source_body_identity_damage() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[11] source = {
        "fn walk(i32[2] values, bool skip) void {",
        "    for (i32 x : values) {",
        "        defer {",
        "            for (i32 y : values) { }",
        "        }",
        "        if (skip) { continue; }",
        "    }",
        "}",
        "",
        "",
        "",
    };
    lower_env.check_lines(&e, source[..], true);
    ast.node* decl = lower_env.decl(&e, "walk");
    fir.func mut f = fir.func{};
    defer fir.func_free(&f);
    fir_lower.range_candidate_set mut proposed = fir_lower.range_candidate_set{};
    defer fir_lower.range_candidate_set_free(&proposed);
    fir_lower.report mut why = fir_lower.report{};
    assert(fir_lower.lower_function_with_range_candidates(&e.c.ck, decl, &f, &proposed, &why));
    fir_lower.range_source_audit mut audit = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&audit);
    assert(fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert(audit.rows.len == 3);
    fir_lower.range_audit_key expected = audit.rows.items[1].key;
    assert(expected.declaration == 2 && expected.expansion == 2);
    assert(expected.exit_occurrence == 2);
    assert(audit.rows.items[2].key.exit_occurrence == 5);
    check_output(&e, decl, &f, "source_body_identity_damage", true);
    fir_lower.range_source_audit_free(&audit);
    u32 mut body = fir.block_count(&f);
    u64 mut i = 0;
    while (i < proposed.boundaries.len) {
        fir_lower.range_boundary_candidate c = proposed.boundaries.items[i];
        if (c.expansion == 2 && c.boundary.kind == fir.range_boundary_kind.body_entry) {
            body = c.boundary.block;
        }
        i += 1;
    }
    assert(body < fir.block_count(&f));
    fir.statement mut* live = &fir.block_mut(&f, body)->statements.items[0];
    fir.statement original = *live;
    assert(original.kind == fir.stmt_kind.st_live);
    live->stmt += 1;
    assert_boundary_refusal(decl, &f, &proposed, expected);
    *live = original;
    live->loc = expected.source;
    assert_boundary_refusal(decl, &f, &proposed, expected);
    *live = original;
    live->exit_loc = proposed.captures.items[2].occurrence.exit_source;
    assert_boundary_refusal(decl, &f, &proposed, expected);
    *live = original;
    u32 mut head = fir.block_count(&f);
    u32 mut b = 0;
    while (b < fir.block_count(&f)) {
        fir.terminator* term = &fir.block_at(&f, b)->term;
        if (term->kind == fir.term_kind.tk_switch && term->arms_len == 1
            && fir.term_arm(&f, term, 0).target == body) {
            head = b;
        }
        b += 1;
    }
    assert(head < fir.block_count(&f));
    fir.terminator mut* term = &fir.block_mut(&f, head)->term;
    fir.terminator saved_term = *term;
    term->stmt += 1;
    assert_boundary_refusal(decl, &f, &proposed, expected);
    *term = saved_term;
    term->loc = expected.context_source;
    assert_boundary_refusal(decl, &f, &proposed, expected);
    *term = saved_term;
    term->exit_loc = proposed.captures.items[2].occurrence.exit_source;
    assert_boundary_refusal(decl, &f, &proposed, expected);
    *term = saved_term;
    assert(fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert_unpublished(&f, &audit);
    fir_lower.range_source_audit_free(&audit);
    proposed.deferred.items[0].parent = 99;
    assert(!fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert_context_key(&audit, expected);
    assert(audit.rows.len == 1);
    fir_lower.range_candidate_set_free(&proposed);
    assert_context_key(&audit, expected);
    assert_unpublished(&f, &audit);
}

fn ambiguous_gap_partition() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[9] source = {
        "fn walk(i32[2] values) void {",
        "    for (i32 x : values) {",
        "        return;",
        "        i32 saved = x;",
        "    }",
        "}",
        "",
        "",
        "",
    };
    lower_env.check_lines(&e, source[..], true);
    ast.node* decl = lower_env.decl(&e, "walk");
    fir.func mut f = fir.func{};
    defer fir.func_free(&f);
    fir_lower.range_candidate_set mut proposed = fir_lower.range_candidate_set{};
    defer fir_lower.range_candidate_set_free(&proposed);
    fir_lower.report mut why = fir_lower.report{};
    assert(fir_lower.lower_function_with_range_candidates(&e.c.ck, decl, &f, &proposed, &why));
    fir_verify.violation mut bad = fir_verify.violation{};
    assert(!fir_verify.find_violation(&f, &e.rt, &bad));
    fir_lower.range_source_audit mut audit = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&audit);
    assert(!fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert(audit.failure.reason == fir_lower.range_audit_fault.boundary);
    assert(audit.failure.key.source.line == 2);
    assert(audit.failure.key.declaration == 1 && audit.failure.key.expansion == 1);
    assert(audit.failure.key.context == 0 && audit.failure.key.exit_occurrence == 0);
    assert(audit.failure.key.exit_source.line == 0);
    assert(audit.rows.len == 0 && audit.matched_captures == 0);
    assert_unpublished(&f, &audit);
    check_output(&e, decl, &f, "ambiguous_gap_partition", true);
    fir_lower.range_source_audit_free(&audit);
    u64 count = proposed.boundaries.len;
    assert(count == 8);
    // A selected candidate subset cannot turn the ambiguous partition into proof.
    proposed.boundaries.len = 5;
    assert(!fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert(audit.failure.reason == fir_lower.range_audit_fault.boundary);
    assert(audit.failure.key.source.line == 2 && audit.rows.len == 0);
    assert_unpublished(&f, &audit);
    fir_lower.range_source_audit_free(&audit);
    proposed.boundaries.len = count;
    fir_lower.range_candidate_set_free(&proposed);
    assert(!fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert(audit.failure.reason == fir_lower.range_audit_fault.declaration);
    assert(audit.selected_declarations == 1);
    assert_unpublished(&f, &audit);
}


u32 mut repair_r1_pairs = 0;
u32 mut repair_r1_rows = 0;
u32 mut repair_r1_corruptions = 0;

fn repair_r1_candidates(fir_lower.range_candidate_set* source,
                         fir_lower.range_candidate_set mut* copied) void {
    u64 mut i = 0;
    copied->declarations.items = new(fir.range_declaration, source->declarations.len);
    copied->declarations.len = source->declarations.len;
    while (i < source->declarations.len) {
        copied->declarations.items[i] = source->declarations.items[i];
        i += 1;
    }
    i = 0;
    while (i < source->captures.len) {
        fir_lower.range_capture_candidate_add(&copied->captures, source->captures.items[i]);
        i += 1;
    }
    i = 0;
    while (i < source->boundaries.len) {
        fir_lower.range_boundary_candidate_add(&copied->boundaries, source->boundaries.items[i]);
        i += 1;
    }
    i = 0;
    while (i < source->suppressions.len) {
        fir_lower.range_suppression_candidate_add(&copied->suppressions,
                                                  source->suppressions.items[i]);
        i += 1;
    }
    i = 0;
    while (i < source->deferred.len) {
        fir_lower.range_defer_context_candidate_add(&copied->deferred, source->deferred.items[i]);
        i += 1;
    }
}

// Select both independent joined operands from the checked call and its exact FIR occurrence.
fn repair_r1_corrupt(string name, lower_env.env mut* e, ast.node* decl, fir.func* f,
                      fir_lower.range_candidate_set* proposed,
                      fir_lower.range_source_audit* audit) void {
    gen.node_ref_vec mut selected = gen.node_ref_vec{};
    defer gen.refs_free(&selected);
    fir_lower.range_audit_selected(decl->b, &selected);
    assert(selected.len == 1);
    ast.node* call = gen.refs_at(&selected, 0)->b;
    assert(call->kind == ast.ast_kind.k_call && ast.ast_len(call) >= 2);
    assert(ast.ast_child(call, 0)->kind == ast.ast_kind.k_ternary);
    assert(ast.ast_child(call, 1)->kind == ast.ast_kind.k_ternary);
    u64 mut row = 0;
    while (row < audit->rows.len) {
        fir_lower.range_audit_key key = audit->rows.items[row].key;
        u32 mut found = 0;
        u32 mut call_block = 0;
        u32 mut call_position = 0;
        u32 mut b = 0;
        while (b < fir.block_count(f)) {
            u32 mut p = 0;
            while (p < fir.block_statement_count(f, b)) {
                fir.statement* s = fir.block_statement(f, b, p);
                if (s->kind == fir.stmt_kind.st_assign
                    && s->value.kind == fir.rvalue_kind.rv_call
                    && fir_lower.range_audit_loc_eq(s->loc, call->loc)
                    && fir_lower.range_audit_loc_eq(s->exit_loc, key.exit_source)) {
                    call_block = b;
                    call_position = p;
                    found += 1;
                }
                p += 1;
            }
            b += 1;
        }
        assert(found == 1);
        fir.statement actual = *fir.block_statement(f, call_block, call_position);
        fir.operand first = fir.operand_at(f, actual.value.ops_first);
        fir.operand second = fir.operand_at(f, actual.value.ops_first + 1);
        assert(first.kind == fir.operand_kind.ok_copy && second.kind == first.kind);
        assert(first.place.base == fir.base_kind.bk_local && first.place.proj_len == 0);
        assert(second.place.base == fir.base_kind.bk_local && second.place.proj_len == 0);
        assert(first.place.local != second.place.local);
        assert(types.type_same_shape(fir.place_type(f, first.place),
                                     fir.place_type(f, second.place)));
        u32 mut direction = 0;
        while (direction < 2) {
            fir.func mut changed = fir.func_clone(f);
            defer fir.func_free(&changed);
            fir.place mut from = second.place;
            fir.place mut to = first.place;
            u32 mut operand = 1;
            string mut label = "second_to_first";
            if (direction != 0) {
                from = first.place;
                to = second.place;
                operand = 0;
                label = "first_to_second";
            }
            u32 mut writes = 0;
            b = 0;
            while (b < fir.block_count(&changed)) {
                u32 mut p = 0;
                while (p < fir.block_statement_count(&changed, b)) {
                    fir.statement mut* s = &fir.block_mut(&changed, b)->statements.items[p];
                    if (s->kind == fir.stmt_kind.st_assign
                        && fir_lower.range_audit_place_eq(&changed, s->place, from)) {
                        assert(s->stmt == actual.stmt);
                        assert(fir_lower.range_audit_loc_eq(s->exit_loc, key.exit_source));
                        s->place = to;
                        writes += 1;
                    }
                    p += 1;
                }
                b += 1;
            }
            assert(writes == 2);
            changed.ops.items[actual.value.ops_first + operand].place = to;
            fir_verify.violation mut bad = fir_verify.violation{};
            assert(!fir_verify.find_violation(&changed, &e->rt, &bad));
            strbuf.str_buf mut id = strbuf.create();
            defer strbuf.free(&id);
            strbuf.append(&id, name);
            strbuf.push(&id, '_');
            strbuf.append_u64(&id, row + 1);
            strbuf.push(&id, '_');
            strbuf.append(&id, label);
            eprintln(strbuf.view(&id), " verifies corrupted FIR");
            conditional_fault(strbuf.view(&id), "cross-region joined destination reuse", e,
                                decl, f, &changed, proposed, key, call_block, call_position);
            fir_lower.range_candidate_set mut copied = fir_lower.range_candidate_set{};
            defer fir_lower.range_candidate_set_free(&copied);
            repair_r1_candidates(proposed, &copied);
            strbuf.str_buf mut before = strbuf.create();
            defer strbuf.free(&before);
            strbuf.str_buf mut after = strbuf.create();
            defer strbuf.free(&after);
            conditional_candidate_snapshot(&changed, &copied, &before);
            fir_lower.range_source_audit mut retained = fir_lower.range_source_audit{};
            defer fir_lower.range_source_audit_free(&retained);
            assert(!fir_lower.audit_produced_ranges(decl, &changed, &copied, &retained));
            conditional_candidate_snapshot(&changed, &copied, &after);
            assert(strbuf.view(&before) == strbuf.view(&after));
            fir_lower.range_candidate_set_free(&copied);
            assert_linear_key(retained.failure.key, key);
            assert(retained.failure.reason == fir_lower.range_audit_fault.protected_path);
            assert_unpublished(&changed, &retained);
            conditional_receipt(strbuf.view(&id), &changed, &retained, false);
            // Undo exactly the two stores and consumed operand. Other exits retain their bytes.
            b = 0;
            while (b < fir.block_count(f)) {
                u32 mut p = 0;
                while (p < fir.block_statement_count(f, b)) {
                    fir.statement* original = fir.block_statement(f, b, p);
                    if (original->kind == fir.stmt_kind.st_assign
                        && fir_lower.range_audit_place_eq(f, original->place, from)) {
                        fir.block_mut(&changed, b)->statements.items[p].place = from;
                    }
                    p += 1;
                }
                b += 1;
            }
            changed.ops.items[actual.value.ops_first + operand].place = from;
            strbuf.clear(&before);
            strbuf.clear(&after);
            conditional_snapshot(f, &before);
            conditional_snapshot(&changed, &after);
            assert(strbuf.view(&before) == strbuf.view(&after));
            repair_r1_corruptions += 1;
            direction += 1;
        }
        row += 1;
    }
}

// Exercise record guards without changing source syntax or executable FIR.
fn repair_r1_family_records(ast.node* decl, fir.func* f,
                             fir_lower.range_source_audit* audit) void {
    gen.node_ref_vec mut selected = gen.node_ref_vec{};
    defer gen.refs_free(&selected);
    fir_lower.range_audit_selected(decl->b, &selected);
    assert(selected.len == 1);
    ast.node* n = gen.refs_at(&selected, 0);
    fir_lower.range_audit_operation_vec mut operations = fir_lower.range_audit_operation_vec{};
    defer del(operations.items);
    fir_lower.range_audit_operations(f, &selected, &operations);
    assert(operations.len == audit->rows.len);
    u64 mut row = 0;
    while (row < operations.len) {
        fir_lower.range_audit_operation operation = operations.items[row];
        fir_lower.conditional_proof_session mut session = fir_lower.conditional_proof_session{
            .proof = fir_lower.range_material_context{f, operation},
            .key = audit->rows.items[row].key, .declaration = decl, .source = n};
        defer fir_lower.conditional_proof_free(&session);
        u32 mut body = 0;
        assert(fir_lower.range_audit_body(f, n, operation, &body));
        fir.range_capture mut binding = fir.range_capture{};
        assert(fir_lower.conditional_wrapped_capture(&session, n, body, &binding));
        assert(session.regions.len >= 3 && session.arms.len >= 3);
        assert(fir_lower.conditional_writes_proved(&session));
        fir_lower.conditional_region_fact root = session.regions.items[0];
        fir_lower.conditional_region_fact child = session.regions.items[1];
        assert(fir.type_aggregate(root.source->ty) && fir.type_aggregate(child.source->ty));
        assert(fir_lower.range_audit_place_eq(f, root.destination, child.destination));
        assert(cast(root.source->b, ast.node*) == child.source);
        session.regions.items[1].proved = false;
        assert(!fir_lower.conditional_writes_proved(&session));
        session.regions.items[1] = child;
        // Equal source and destination alone cannot establish a direct family edge.
        session.regions.items[1].source = root.source;
        assert(!fir_lower.conditional_writes_proved(&session));
        session.regions.items[1] = child;
        session.regions.items[1].join = root.join;
        assert(!fir_lower.conditional_writes_proved(&session));
        session.regions.items[1] = child;
        session.regions.items[1].branch = root.branch;
        assert(!fir_lower.conditional_writes_proved(&session));
        session.regions.items[1] = child;
        fir_lower.conditional_arm_fact arm = session.arms.items[0];
        session.arms.items[0].region = cast(session.regions.len, u32);
        assert(!fir_lower.conditional_writes_proved(&session));
        session.arms.items[0] = arm;
        session.arms.items[0].region = 0;
        // Shared family membership cannot replace the exact arm owner.
        assert(!fir_lower.conditional_writes_proved(&session));
        session.arms.items[0] = arm;
        u64 arms = session.arms.len;
        session.arms.len = 0;
        assert(!fir_lower.conditional_writes_proved(&session));
        session.arms.len = arms;
        assert(fir_lower.conditional_arm_add(&session, arm));
        assert(!fir_lower.conditional_writes_proved(&session));
        session.arms.len = arms;
        u64 regions = session.regions.len;
        u32 mut duplicate = 0;
        assert(fir_lower.conditional_region_add(&session, root, &duplicate));
        assert(cast(duplicate, u64) == regions);
        assert(!fir_lower.conditional_writes_proved(&session));
        session.regions.len = regions;
        assert(fir_lower.conditional_writes_proved(&session));
        fir_lower.conditional_proof_free(&session);
        assert(session.regions.items.len == 0 && session.arms.items.len == 0);
        assert_unpublished(f, audit);
        row += 1;
    }
}

fn repair_r1_pair(string name, string@ direct, bool corrupt) void {
    u32 mut mode = 0;
    while (mode < 2) {
        u64 mut extra = 0;
        if (mode != 0) { extra = 2; }
        string mut@ own source = new(string, direct.len + extra);
        defer del(source);
        u64 mut i = 0;
        u64 mut j = 0;
        while (i < direct.len) {
            bool collection = i + 3 == direct.len;
            if (mode != 0 && collection) { source[j] = "    defer {"; j += 1; }
            source[j] = direct[i];
            j += 1;
            if (mode != 0 && collection) { source[j] = "    }"; j += 1; }
            i += 1;
        }
        assert(j == source.len);
        strbuf.str_buf mut id = strbuf.create();
        defer strbuf.free(&id);
        strbuf.append(&id, "repair_r1_");
        strbuf.append(&id, name);
        if (mode == 0) { strbuf.append(&id, "_direct"); }
        else { strbuf.append(&id, "_deferred"); }
        lower_env.env mut e = lower_env.env{};
        lower_env.open(&e);
        defer lower_env.close(&e);
        lower_env.check_lines(&e, source, true);
        ast.node* decl = lower_env.decl(&e, "walk");
        fir.func mut f = fir.func{};
        defer fir.func_free(&f);
        fir_lower.range_candidate_set mut proposed = fir_lower.range_candidate_set{};
        defer fir_lower.range_candidate_set_free(&proposed);
        fir_lower.report mut why = fir_lower.report{};
        assert(fir_lower.lower_function_with_range_candidates(&e.c.ck, decl, &f, &proposed, &why));
        fir_verify.violation mut bad = fir_verify.violation{};
        assert(!fir_verify.find_violation(&f, &e.rt, &bad));
        fir_lower.range_source_audit mut audit = fir_lower.range_source_audit{};
        defer fir_lower.range_source_audit_free(&audit);
        assert(fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
        u64 expected = cast(mode + 1, u64);
        assert(audit.rows.len == expected && proposed.captures.len == expected);
        assert(audit.matched_captures == cast(expected, u32));
        assert(audit.matched_boundaries == cast(proposed.boundaries.len, u32));
        if (mode == 0) {
            assert(audit.rows.items[0].key.context == 0);
            assert(audit.rows.items[0].key.exit_occurrence == 0);
            assert(audit.rows.items[0].key.exit_source.line == 0);
        } else {
            assert(audit.rows.items[0].key.context != 0);
            assert(audit.rows.items[1].key.context != 0);
            assert(audit.rows.items[0].key.exit_occurrence
                   != audit.rows.items[1].key.exit_occurrence);
            assert(audit.rows.items[0].key.exit_source.line
                   != audit.rows.items[1].key.exit_source.line);
        }
        assert_unpublished(&f, &audit);
        check_output(&e, decl, &f, strbuf.view(&id), true);
        if (name == "nested_sibling_aggregate_arms") {
            repair_r1_family_records(decl, &f, &audit);
        }
        if (corrupt) { repair_r1_corrupt(strbuf.view(&id), &e, decl, &f, &proposed, &audit); }
        fir_lower.range_candidate_set_free(&proposed);
        conditional_receipt(strbuf.view(&id), &f, &audit, true);
        assert(audit.rows.len == expected);
        repair_r1_pairs += 1;
        repair_r1_rows += cast(expected, u32);
        mode += 1;
    }
}

fn repair_r1_matrix() void {
    string[5] independent_spans = {
        "fn pick(i32@ a, i32@ b) i32@ { return a; }",
        "fn walk(bool select, bool other, bool third, bool quit, i32@ values, i32@ backup) void {",
        "    for (i32 x : pick(select ? values : backup, other ? backup : values)) { }",
        "    if (quit) { return; }",
        "}",
    };
    repair_r1_pair("independent_spans", independent_spans[..], true);
    string own line_1 = str.concat(
        "fn walk(bool select, bool other, bool third, bool quit, i32* a, ",
        "i32* b, i32@ values) void {");
    defer del(line_1);
    string[5] independent_pointers = {
        "fn pick(i32* a, i32* b, i32@ values) i32@ { return values; }",
        line_1,
        "    for (i32 x : pick(select ? a : b, other ? b : a, values)) { }",
        "    if (quit) { return; }",
        "}",
    };
    repair_r1_pair("independent_pointers", independent_pointers[..], true);
    string[7] independent_functions = {
        "fn a() i32 { return 1; }",
        "fn b() i32 { return 2; }",
        "fn pick(fn () i32 a, fn () i32 b, i32@ values) i32@ { return values; }",
        "fn walk(bool select, bool other, bool third, bool quit, i32@ values) void {",
        "    for (i32 x : pick(select ? a : b, other ? b : a, values)) { }",
        "    if (quit) { return; }",
        "}",
    };
    repair_r1_pair("independent_functions", independent_functions[..], true);
    string[4] nested_then_then = {
        "fn walk(bool select, bool other, bool third, bool quit, i32@ values, i32@ backup) void {",
        "    for (i32 x : select ? (other ? (third ? values : backup) : backup) : values) { }",
        "    if (quit) { return; }",
        "}",
    };
    repair_r1_pair("nested_then_then", nested_then_then[..], false);
    string[4] nested_then_else = {
        "fn walk(bool select, bool other, bool third, bool quit, i32@ values, i32@ backup) void {",
        "    for (i32 x : select ? (other ? values : (third ? backup : values)) : backup) { }",
        "    if (quit) { return; }",
        "}",
    };
    repair_r1_pair("nested_then_else", nested_then_else[..], false);
    string[4] nested_else_then = {
        "fn walk(bool select, bool other, bool third, bool quit, i32@ values, i32@ backup) void {",
        "    for (i32 x : select ? values : (other ? (third ? backup : values) : backup)) { }",
        "    if (quit) { return; }",
        "}",
    };
    repair_r1_pair("nested_else_then", nested_else_then[..], false);
    string[4] nested_else_else = {
        "fn walk(bool select, bool other, bool third, bool quit, i32@ values, i32@ backup) void {",
        "    for (i32 x : select ? backup : (other ? values : (third ? backup : values))) { }",
        "    if (quit) { return; }",
        "}",
    };
    repair_r1_pair("nested_else_else", nested_else_else[..], false);
    string[4] nested_sibling_aggregate_arms = {
        "fn walk(bool select, bool other, bool third, bool quit, i32@ values, i32@ backup) void {",
        "    for (i32 x : select ? (other ? values : backup) : (third ? backup : values)) { }",
        "    if (quit) { return; }",
        "}",
    };
    repair_r1_pair("nested_sibling_aggregate_arms", nested_sibling_aggregate_arms[..], false);
    string own line_2 = str.concat(
        "fn walk(bool select, bool other, bool third, bool quit, holder ",
        "values, holder backup) void {");
    defer del(line_2);
    string own line_3 = str.concat(
        "    for (i32 x : (select ? (other ? values : backup) : (third ? ",
        "backup : values)).items) { }");
    defer del(line_3);
    string[5] nested_struct = {
        "struct holder { i32@ items; }",
        line_2,
        line_3,
        "    if (quit) { return; }",
        "}",
    };
    repair_r1_pair("nested_struct", nested_struct[..], false);
    string own line_4 = str.concat(
        "fn walk(bool select, bool other, bool third, bool quit, i32[2] ",
        "values, i32[2] backup) void {");
    defer del(line_4);
    string[4] nested_fixed_array = {
        line_4,
        "    for (i32 x : select ? (other ? values : backup) : (third ? backup : values)) { }",
        "    if (quit) { return; }",
        "}",
    };
    repair_r1_pair("nested_fixed_array", nested_fixed_array[..], false);
    string own line_5 = str.concat(
        "    for (i32 x : pick(select ? leaf(values, backup) : backup, ",
        "other ? backup : leaf(values, backup))) { }");
    defer del(line_5);
    string[6] equal_call_result_regions = {
        "fn leaf(i32@ a, i32@ b) i32@ { return a; }",
        "fn pick(i32@ a, i32@ b) i32@ { return a; }",
        "fn walk(bool select, bool other, bool third, bool quit, i32@ values, i32@ backup) void {",
        line_5,
        "    if (quit) { return; }",
        "}",
    };
    repair_r1_pair("equal_call_result_regions", equal_call_result_regions[..], true);
    string own line_6 = str.concat(
        "fn walk(bool select, bool other, bool third, bool quit, string ",
        "values, string backup) void {");
    defer del(line_6);
    string[4] nested_string = {
        line_6,
        "    for (char x : select ? (other ? values : backup) : (third ? backup : values)) { }",
        "    if (quit) { return; }",
        "}",
    };
    repair_r1_pair("nested_string", nested_string[..], false);
    assert(repair_r1_pairs == 24 && repair_r1_rows == 36 && repair_r1_corruptions == 24);
}

u32 mut repair_r2_pairs = 0;
u32 mut repair_r2_rows = 0;
u32 mut repair_r2_substitutions = 0;
u32 mut repair_r2_invalid = 0;

fn repair_r2_local(fir.func* f, string name) u32 {
    u32 mut found = 0;
    u32 mut count = 0;
    u32 mut i = 0;
    while (i < fir.local_count(f)) {
        fir.local* item = fir.local_at(f, i);
        if (item->kind == fir.local_kind.lk_param && fir.local_name(item) == name) {
            found = i;
            count += 1;
        }
        i += 1;
    }
    assert(count == 1);
    return found;
}

// The exact checked region and side select one proved arm store.
fn repair_r2_arm(fir_lower.conditional_proof_session* session, ast.node* source, bool side,
                  fir_lower.conditional_region_fact mut* region) fir_lower.conditional_arm_fact {
    u32 mut index = 0;
    u32 mut count = 0;
    u64 mut i = 0;
    while (i < session->regions.len) {
        if (session->regions.items[i].source == source) {
            index = cast(i, u32);
            *region = session->regions.items[i];
            count += 1;
        }
        i += 1;
    }
    assert(count == 1 && region->proved);
    fir_lower.conditional_arm_fact mut arm = fir_lower.conditional_arm_fact{};
    count = 0;
    i = 0;
    while (i < session->arms.len) {
        fir_lower.conditional_arm_fact current = session->arms.items[i];
        if (current.region == index && current.side == side) { arm = current; count += 1; }
        i += 1;
    }
    ast.node* mut expected = source->c;
    if (side) { expected = source->b; }
    assert(count == 1 && arm.source == expected);
    return arm;
}

// Node addresses identify the actual checked nodes while their tree remains alive.
fn repair_r2_selector(string name, ast.node* root, fir.func* f,
                       fir_lower.conditional_region_fact region,
                       fir_lower.conditional_arm_fact arm, fir_lower.range_audit_key key,
                       fir.operand old, fir.operand changed, fir_verify.violation* bad,
                       bool invalid, string before, string after) void {
    string mut dir = "";
    if (!sys.env("FORT_RANGE_PROBE_DIR", &dir)) { return; }
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    json.writer mut j = json.writer{};
    json.json_init(&j, &text);
    json.json_object_begin(&j);
    json.json_key(&j, "source_probe"); json.json_str(&j, name);
    json.json_key(&j, "function_symbol_id");
    json.json_uint(&j, cast(key.function, u64));
    json.json_key(&j, "baseline_key"); conditional_json_key(&j, key);
    json.json_key(&j, "exit_key"); conditional_json_key(&j, key);
    json.json_key(&j, "checked_node_ids"); json.json_array_begin(&j);
    json.json_uint(&j, cast(root, u64));
    json.json_uint(&j, cast(region.source, u64));
    json.json_uint(&j, cast(arm.source, u64));
    json.json_array_end(&j);
    json.json_key(&j, "checked_region"); conditional_json_loc(&j, region.source->loc);
    json.json_key(&j, "checked_arm"); conditional_json_loc(&j, arm.source->loc);
    fir.statement* write = fir.block_statement(f, arm.write.block, arm.write.position);
    json.json_key(&j, "block"); json.json_uint(&j, cast(arm.write.block, u64));
    json.json_key(&j, "position"); json.json_uint(&j, cast(arm.write.position, u64));
    json.json_key(&j, "destination_local");
    json.json_uint(&j, cast(arm.destination.local, u64));
    json.json_key(&j, "old_operand_local"); json.json_uint(&j, cast(old.place.local, u64));
    json.json_key(&j, "new_operand_local"); json.json_uint(&j, cast(changed.place.local, u64));
    json.json_key(&j, "old_operand_kind"); json.json_uint(&j, cast(old.kind, u64));
    json.json_key(&j, "new_operand_kind"); json.json_uint(&j, cast(changed.kind, u64));
    json.json_key(&j, "old_operand_name");
    json.json_str(&j, fir.local_name(fir.local_at(f, old.place.local)));
    json.json_key(&j, "new_operand_name");
    json.json_str(&j, fir.local_name(fir.local_at(f, changed.place.local)));
    u32 mut entry = region.no;
    if (arm.side) { entry = region.yes; }
    json.json_key(&j, "entry_block"); json.json_uint(&j, cast(entry, u64));
    json.json_key(&j, "join_block"); json.json_uint(&j, cast(region.join, u64));
    json.json_key(&j, "statement_index"); json.json_uint(&j, cast(write->stmt, u64));
    json.json_key(&j, "statement_source"); conditional_json_loc(&j, write->loc);
    json.json_key(&j, "statement_exit"); conditional_json_loc(&j, write->exit_loc);
    json.json_key(&j, "one_changed_operand"); json.json_bool(&j, true);
    json.json_key(&j, "other_exits_unchanged"); json.json_bool(&j, true);
    json.json_key(&j, "invalid_transfer"); json.json_bool(&j, invalid);
    json.json_key(&j, "verifier_rule"); json.json_uint(&j, cast(bad->rule, u64));
    json.json_key(&j, "verifier_reason"); json.json_str(&j, bad->what);
    json.json_key(&j, "audit_executed"); json.json_bool(&j, !invalid);
    json.json_key(&j, "before"); json.json_str(&j, before);
    json.json_key(&j, "after"); json.json_str(&j, after);
    json.json_object_end(&j);
    string own leaf = str.concat(name, ".selector.json");
    defer del(leaf);
    probe_file(dir, leaf, strbuf.view(&text));
}

fn repair_r2_change(string name, string kind, lower_env.env mut* e, ast.node* decl,
                      ast.node* root, fir.func* f, fir_lower.range_candidate_set* proposed,
                      fir_lower.range_audit_key key, fir_lower.conditional_region_fact region,
                      fir_lower.conditional_arm_fact arm, fir.operand replacement,
                      bool invalid) void {
    fir.statement* write = fir.block_statement(f, arm.write.block, arm.write.position);
    assert(write->kind == fir.stmt_kind.st_assign);
    assert(write->value.kind == fir.rvalue_kind.rv_use && write->value.ops_len == 1);
    assert(fir_lower.range_audit_loc_eq(write->loc, arm.source->loc));
    assert(fir_lower.range_audit_loc_eq(write->exit_loc, key.exit_source));
    u32 operand = write->value.ops_first;
    fir.operand old = fir.operand_at(f, operand);
    assert(old.kind == arm.produced.kind);
    assert(fir_lower.range_audit_place_eq(f, old.place, arm.produced.place));
    assert(old.place.base == fir.base_kind.bk_local && old.place.proj_len == 0);
    assert(replacement.place.base == fir.base_kind.bk_local && replacement.place.proj_len == 0);
    if (!invalid) {
        assert(old.kind == fir.operand_kind.ok_move && replacement.kind == old.kind);
        assert(fir.type_owning(arm.source->ty));
        assert(old.place.local != replacement.place.local);
        assert(types.type_same_shape(fir.operand_type(f, old),
                                     fir.operand_type(f, replacement)));
    }
    u32 mut uses = 0;
    u32 mut b = 0;
    while (b < fir.block_count(f)) {
        u32 mut position = 0;
        while (position < fir.block_statement_count(f, b)) {
            fir.statement* s = fir.block_statement(f, b, position);
            if (s->kind == fir.stmt_kind.st_assign && s->value.kind == fir.rvalue_kind.rv_use
                && s->value.ops_first == operand) { uses += 1; }
            position += 1;
        }
        b += 1;
    }
    assert(uses == 1);
    fir.func mut changed = fir.func_clone(f);
    defer fir.func_free(&changed);
    changed.ops.items[operand] = replacement;
    strbuf.str_buf mut before = strbuf.create();
    defer strbuf.free(&before);
    strbuf.str_buf mut after = strbuf.create();
    defer strbuf.free(&after);
    conditional_snapshot(f, &before);
    conditional_snapshot(&changed, &after);
    assert(strbuf.view(&before) != strbuf.view(&after));
    fir_verify.violation mut bad = fir_verify.violation{};
    bool refused = fir_verify.find_violation(&changed, &e->rt, &bad);
    strbuf.str_buf mut id = strbuf.create();
    defer strbuf.free(&id);
    strbuf.append(&id, name);
    strbuf.push(&id, '_');
    strbuf.append_u64(&id, cast(key.expansion, u64));
    strbuf.push(&id, '_');
    strbuf.append(&id, kind);
    if (invalid) {
        assert(refused && (bad.rule == fir_verify.RULE_V5 || bad.rule == fir_verify.RULE_V6));
        assert(bad.block == arm.write.block && bad.position == arm.write.position);
        repair_r2_invalid += 1;
    } else {
        assert(!refused);
        conditional_fault(strbuf.view(&id), "exact owning scalar source substitution", e,
                            decl, f, &changed, proposed, key, arm.write.block, arm.write.position);
        fir_lower.range_candidate_set mut copied = fir_lower.range_candidate_set{};
        defer fir_lower.range_candidate_set_free(&copied);
        repair_r1_candidates(proposed, &copied);
        fir_lower.range_source_audit mut retained = fir_lower.range_source_audit{};
        defer fir_lower.range_source_audit_free(&retained);
        strbuf.str_buf mut candidate_before = strbuf.create();
        defer strbuf.free(&candidate_before);
        strbuf.str_buf mut candidate_after = strbuf.create();
        defer strbuf.free(&candidate_after);
        conditional_candidate_snapshot(&changed, &copied, &candidate_before);
        assert(!fir_lower.audit_produced_ranges(decl, &changed, &copied, &retained));
        conditional_candidate_snapshot(&changed, &copied, &candidate_after);
        assert(strbuf.view(&candidate_before) == strbuf.view(&candidate_after));
        fir_lower.range_candidate_set_free(&copied);
        assert_linear_key(retained.failure.key, key);
        assert(retained.failure.reason == fir_lower.range_audit_fault.protected_path);
        assert_unpublished(&changed, &retained);
        conditional_receipt(strbuf.view(&id), &changed, &retained, false);
        repair_r2_substitutions += 1;
    }
    changed.ops.items[operand] = old;
    strbuf.str_buf mut restored = strbuf.create();
    defer strbuf.free(&restored);
    conditional_snapshot(&changed, &restored);
    assert(strbuf.view(&before) == strbuf.view(&restored));
    repair_r2_selector(strbuf.view(&id), root, f, region, arm, key, old, replacement, &bad,
                       invalid, strbuf.view(&before), strbuf.view(&after));
}

// These source paths implement the reviewed outer-arm and distinct nested-leaf selectors.
fn repair_r2_damage(string name, string form, bool owning, lower_env.env mut* e,
                      ast.node* decl, fir.func* f, fir_lower.range_candidate_set* proposed,
                      fir_lower.range_source_audit* audit) void {
    gen.node_ref_vec mut selected = gen.node_ref_vec{};
    defer gen.refs_free(&selected);
    fir_lower.range_audit_selected(decl->b, &selected);
    assert(selected.len == 1);
    ast.node* range = gen.refs_at(&selected, 0);
    ast.node* call = range->b;
    assert(call->kind == ast.ast_kind.k_call && ast.ast_len(call) == 2);
    ast.node* root = ast.ast_child(call, 0);
    assert(root->kind == ast.ast_kind.k_ternary && root->a->name == "select");
    bool side = form != "own_pointer_else" && form != "borrowed_own_pointee_else";
    ast.node* mut nested = root->b;
    if (!side) { nested = root->c; }
    assert(nested->kind == ast.ast_kind.k_ternary && nested->a->name == "other");
    ast.node* mut leaf_region = nested;
    if (form == "own_pointer_depth_three" || form == "borrowed_own_pointee_depth_three") {
        leaf_region = nested->b;
    }
    fir_lower.range_audit_operation_vec mut operations = fir_lower.range_audit_operation_vec{};
    defer del(operations.items);
    fir_lower.range_audit_operations(f, &selected, &operations);
    assert(operations.len == audit->rows.len);
    u64 mut row = 0;
    while (row < operations.len) {
        fir_lower.range_audit_key key = audit->rows.items[row].key;
        fir_lower.range_audit_operation op = operations.items[row];
        assert(fir_lower.range_audit_loc_eq(op.exit_source, key.exit_source));
        fir_lower.conditional_proof_session mut session = fir_lower.conditional_proof_session{
            .proof = fir_lower.range_material_context{f, op}, .key = key,
            .declaration = decl, .source = range};
        defer fir_lower.conditional_proof_free(&session);
        u32 mut body = 0;
        assert(fir_lower.range_audit_body(f, range, op, &body));
        fir.range_capture mut binding = fir.range_capture{};
        assert(fir_lower.conditional_wrapped_capture(&session, range, body, &binding));
        fir_lower.conditional_region_fact mut outer_region = fir_lower.conditional_region_fact{};
        fir_lower.conditional_arm_fact outer = repair_r2_arm(&session, root, side, &outer_region);
        fir_lower.conditional_region_fact mut inner_region = fir_lower.conditional_region_fact{};
        fir_lower.conditional_arm_fact inner = repair_r2_arm(&session, leaf_region, true,
                                                              &inner_region);
        assert(outer.write.block != inner.write.block
               || outer.write.position != inner.write.position);
        fir.operand_kind mut expected = fir.operand_kind.ok_copy;
        if (owning) { expected = fir.operand_kind.ok_move; }
        assert(fir.type_owning(root->ty) == owning && outer.produced.kind == expected);
        assert(inner.produced.kind == expected);
        if (form == "borrowed_own_pointee_then" || form == "borrowed_own_pointee_else"
            || form == "borrowed_own_pointee_depth_three") {
            assert(!owning && root->ty->kind == types.type_kind.k_ptr);
            assert(!root->ty->is_own && root->ty->elem->kind == types.type_kind.k_ptr);
            assert(root->ty->elem->is_own && fir.type_owning(root->ty->elem));
            assert(outer.produced.kind == fir.operand_kind.ok_copy);
            assert(inner.produced.kind == fir.operand_kind.ok_copy);
        }
        if (owning) {
            string mut owner = "c";
            if (!side) { owner = "a"; }
            if (form == "own_pointer_depth_three") { owner = "d"; }
            assert(fir.local_at(f, outer.produced.place.local)->kind == fir.local_kind.lk_temp);
            string mut leaf = "a";
            if (!side) { leaf = "b"; }
            assert(fir.local_name(fir.local_at(f, inner.produced.place.local)) == leaf);
            repair_r2_change(name, "named_owner_substitution", e, decl, root, f, proposed, key,
                              outer_region, outer, fir.operand_move(
                                  fir.place_local(repair_r2_local(f, owner))), false);
            repair_r2_change(name, "nested_arm_source_substitution", e, decl, root, f,
                              proposed, key, inner_region, inner,
                              fir.operand_move(fir.place_local(repair_r2_local(f, "d"))), false);
        }
        fir.operand mut wrong = outer.produced;
        wrong.kind = fir.operand_kind.ok_move;
        if (owning) { wrong.kind = fir.operand_kind.ok_copy; }
        repair_r2_change(name, "wrong_transfer", e, decl, root, f, proposed, key,
                          outer_region, outer, wrong, true);
        row += 1;
    }
}

fn repair_r2_pair(string name, string@ direct, bool owning) void {
    bool previous_runtime_free = repair_r2_runtime_free;
    repair_r2_runtime_free = owning;
    defer { repair_r2_runtime_free = previous_runtime_free; }
    u32 mut mode = 0;
    while (mode < 2) {
        u64 mut extra = 0;
        if (mode != 0) { extra = 2; }
        string mut@ own source = new(string, direct.len + extra);
        defer del(source);
        u64 mut i = 0;
        u64 mut j = 0;
        while (i < direct.len) {
            bool collection = i + 3 == direct.len;
            if (mode != 0 && collection) { source[j] = "    defer {"; j += 1; }
            source[j] = direct[i];
            j += 1;
            if (mode != 0 && collection) { source[j] = "    }"; j += 1; }
            i += 1;
        }
        assert(j == source.len);
        strbuf.str_buf mut id = strbuf.create();
        defer strbuf.free(&id);
        strbuf.append(&id, "repair_r2_");
        strbuf.append(&id, name);
        if (mode == 0) { strbuf.append(&id, "_direct"); }
        else { strbuf.append(&id, "_deferred"); }
        lower_env.env mut e = lower_env.env{};
        lower_env.open(&e);
        defer lower_env.close(&e);
        lower_env.check_lines(&e, source, true);
        ast.node* decl = lower_env.decl(&e, "walk");
        fir.func mut f = fir.func{};
        defer fir.func_free(&f);
        fir_lower.range_candidate_set mut proposed = fir_lower.range_candidate_set{};
        defer fir_lower.range_candidate_set_free(&proposed);
        fir_lower.report mut why = fir_lower.report{};
        assert(fir_lower.lower_function_with_range_candidates(&e.c.ck, decl, &f, &proposed, &why));
        fir_verify.violation mut bad = fir_verify.violation{};
        assert(!fir_verify.find_violation(&f, &e.rt, &bad));
        eprintln(strbuf.view(&id), " verifies fixture FIR");
        fir_lower.range_source_audit mut audit = fir_lower.range_source_audit{};
        defer fir_lower.range_source_audit_free(&audit);
        bool matched = fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit);
        if (!matched) { eprintln(strbuf.view(&id), " refuses a proved owning scalar"); }
        assert(matched);
        u64 expected = cast(mode + 1, u64);
        assert(audit.rows.len == expected && proposed.captures.len == expected);
        assert(audit.matched_captures == cast(expected, u32));
        assert(audit.matched_boundaries == cast(proposed.boundaries.len, u32));
        if (mode == 0) {
            assert(audit.rows.items[0].key.context == 0);
            assert(audit.rows.items[0].key.exit_occurrence == 0);
            assert(audit.rows.items[0].key.exit_source.line == 0);
        } else {
            assert(audit.rows.items[0].key.context != 0);
            assert(audit.rows.items[1].key.context != 0);
            assert(audit.rows.items[0].key.exit_occurrence
                   != audit.rows.items[1].key.exit_occurrence);
            assert(audit.rows.items[0].key.exit_source.line
                   != audit.rows.items[1].key.exit_source.line);
        }
        assert_unpublished(&f, &audit);
        check_output(&e, decl, &f, strbuf.view(&id), true);
        repair_r2_damage(strbuf.view(&id), name, owning, &e, decl, &f, &proposed, &audit);
        fir_lower.range_candidate_set_free(&proposed);
        conditional_receipt(strbuf.view(&id), &f, &audit, true);
        assert(audit.rows.len == expected);
        repair_r2_pairs += 1;
        repair_r2_rows += cast(expected, u32);
        mode += 1;
    }
}

fn repair_r2_matrix() void {
    string own line_0_1 = str.concat(
        "fn walk(bool select, bool other, bool third, bool quit, i32* own mut ",
        "a, i32* own mut b, i32* own mut c, i32* own mut d, i32@ values) void {");
    defer del(line_0_1);
    string[5] own_pointer_then = {
        "fn pick(i32* own mut p, i32@ values) i32@ { del(p); return values; }",
        line_0_1,
        "    for (i32 x : pick(select ? (other ? move(a) : move(b)) : move(c), values)) { }",
        "    if (quit) { return; }",
        "}",
    };
    repair_r2_pair("own_pointer_then", own_pointer_then[..], true);
    string own line_1_1 = str.concat(
        "fn walk(bool select, bool other, bool third, bool quit, i32* own mut ",
        "a, i32* own mut b, i32* own mut c, i32* own mut d, i32@ values) void {");
    defer del(line_1_1);
    string[5] own_pointer_else = {
        "fn pick(i32* own mut p, i32@ values) i32@ { del(p); return values; }",
        line_1_1,
        "    for (i32 x : pick(select ? move(a) : (other ? move(b) : move(c)), values)) { }",
        "    if (quit) { return; }",
        "}",
    };
    repair_r2_pair("own_pointer_else", own_pointer_else[..], true);
    string own line_2_1 = str.concat(
        "fn walk(bool select, bool other, bool third, bool quit, i32* own mut ",
        "a, i32* own mut b, i32* own mut c, i32* own mut d, i32@ values) void {");
    defer del(line_2_1);
    string own line_2_2 = str.concat(
        "    for (i32 x : pick(select ? (other ? move(a) : move(b)) : (third ? ",
        "move(c) : move(d)), values)) { }");
    defer del(line_2_2);
    string[5] own_pointer_both = {
        "fn pick(i32* own mut p, i32@ values) i32@ { del(p); return values; }",
        line_2_1,
        line_2_2,
        "    if (quit) { return; }",
        "}",
    };
    repair_r2_pair("own_pointer_both", own_pointer_both[..], true);
    string own line_3_1 = str.concat(
        "fn walk(bool select, bool other, bool third, bool quit, i32* own mut ",
        "a, i32* own mut b, i32* own mut c, i32* own mut d, i32@ values) void {");
    defer del(line_3_1);
    string own line_3_2 = str.concat(
        "    for (i32 x : pick(select ? (other ? (third ? move(a) : move(b)) : ",
        "move(c)) : move(d), values)) { }");
    defer del(line_3_2);
    string[5] own_pointer_depth_three = {
        "fn pick(i32* own mut p, i32@ values) i32@ { del(p); return values; }",
        line_3_1,
        line_3_2,
        "    if (quit) { return; }",
        "}",
    };
    repair_r2_pair("own_pointer_depth_three", own_pointer_depth_three[..], true);
    string own line_4_1 = str.concat(
        "fn walk(bool select, bool other, bool third, bool quit, void mut* own mut a, ",
        "void mut* own mut b, void mut* own mut c, void mut* own mut d, i32@ values) void {");
    defer del(line_4_1);
    string[5] own_void_pointer = {
        "fn pick(void mut* own mut p, i32@ values) i32@ { del(p); return values; }",
        line_4_1,
        "    for (i32 x : pick(select ? (other ? move(a) : move(b)) : move(c), values)) { }",
        "    if (quit) { return; }",
        "}",
    };
    repair_r2_pair("own_void_pointer", own_void_pointer[..], true);
    string own line_5_1 = str.concat(
        "fn walk(bool select, bool other, bool third, bool quit, i32* a, i32* ",
        "b, i32* c, i32* d, i32@ values) void {");
    defer del(line_5_1);
    string[5] borrowed_pointer_control = {
        "fn pick(i32* p, i32@ values) i32@ { return values; }",
        line_5_1,
        "    for (i32 x : pick(select ? (other ? a : b) : c, values)) { }",
        "    if (quit) { return; }",
        "}",
    };
    repair_r2_pair("borrowed_pointer_control", borrowed_pointer_control[..], false);
    string own line_6_1 = str.concat(
        "fn walk(bool select, bool other, bool third, bool quit, i64 a, i64 b, ",
        "i64 c, i64 d, i32@ values) void {");
    defer del(line_6_1);
    string[5] integer_control = {
        "fn pick(i64 p, i32@ values) i32@ { return values; }",
        line_6_1,
        "    for (i32 x : pick(select ? (other ? a : b) : c, values)) { }",
        "    if (quit) { return; }",
        "}",
    };
    repair_r2_pair("integer_control", integer_control[..], false);
    string own line_7_1 = str.concat(
        "fn walk(bool select, bool other, bool third, bool quit, fn () i32 a, ",
        "fn () i32 b, fn () i32 c, fn () i32 d, i32@ values) void {");
    defer del(line_7_1);
    string[5] function_control = {
        "fn pick(fn () i32 p, i32@ values) i32@ { return values; }",
        line_7_1,
        "    for (i32 x : pick(select ? (other ? a : b) : c, values)) { }",
        "    if (quit) { return; }",
        "}",
    };
    repair_r2_pair("function_control", function_control[..], false);
    assert(repair_r2_pairs == 16 && repair_r2_rows == 24);
    assert(repair_r2_substitutions == 30 && repair_r2_invalid == 24);
}

u32 mut coverage_reuse_pairs = 0;
u32 mut coverage_reuse_rows = 0;
u32 mut coverage_reuse_mutations = 0;

// Select one complete region from its exact checked conditional node.
fn coverage_region(fir_lower.conditional_proof_session* session, ast.node* source)
        fir_lower.conditional_region_fact {
    fir_lower.conditional_region_fact mut result = fir_lower.conditional_region_fact{};
    fir_lower.conditional_arm_fact yes = repair_r2_arm(session, source, true, &result);
    fir_lower.conditional_arm_fact no = repair_r2_arm(session, source, false, &result);
    assert(fir_lower.range_audit_place_eq(session->proof.f, yes.destination, no.destination));
    assert(fir_lower.range_audit_place_eq(session->proof.f, result.destination, yes.destination));
    assert(yes.write.block != no.write.block || yes.write.position != no.write.position);
    return result;
}

// Each operand class has a separate consuming path. Equal types cannot select that path.
fn coverage_consumer(fir.func* f, ast.node* use, string form, fir.place from,
                      fir_lower.range_audit_key key) fir_lower.range_material_point {
    fir_lower.range_material_point mut at = fir_lower.range_material_point{};
    u32 mut count = 0;
    u32 mut b = 0;
    while (b < fir.block_count(f)) {
        u32 mut p = 0;
        while (p < fir.block_statement_count(f, b)) {
            fir.statement* s = fir.block_statement(f, b, p);
            bool mut found = s->kind == fir.stmt_kind.st_assign
                && fir_lower.range_audit_loc_eq(s->loc, use->loc)
                && fir_lower.range_audit_loc_eq(s->exit_loc, key.exit_source);
            if (found && form == "independent_callees") {
                found = s->value.kind == fir.rvalue_kind.rv_call
                    && s->value.callee == fir.callee_kind.cl_value
                    && s->value.callee_op.kind == fir.operand_kind.ok_copy
                    && fir_lower.range_audit_place_eq(f, s->value.callee_op.place, from);
            } else if (found && form == "independent_bounds") {
                found = s->value.kind == fir.rvalue_kind.rv_cast && s->value.ops_len == 1
                    && s->value.ty->kind == types.type_kind.k_prim
                    && s->value.ty->prim == prim.prim_kind.prim_u64
                    && fir_lower.range_audit_place_eq(f,
                        fir.operand_at(f, s->value.ops_first).place, from);
            } else if (found) {
                assert(form == "independent_wrappers");
                found = s->value.kind == fir.rvalue_kind.rv_slice
                    && fir_lower.range_audit_place_eq(f, s->value.place, from);
            }
            if (found) { at = fir_lower.range_material_point{b, p}; count += 1; }
            p += 1;
        }
        b += 1;
    }
    assert(count == 1);
    return at;
}

// A slice check reads the same header length before the slice consumes it.
fn coverage_length_operand(fir.func mut* f, u32 index, fir.place from, fir.place to) u32 {
    fir.operand mut* value = &f->ops.items[index];
    if (value->kind != fir.operand_kind.ok_copy || value->place.base != from.base
        || value->place.local != from.local) { return 0; }
    assert(value->place.proj_len == 1);
    fir.projection field = fir.place_projection(f, value->place, 0);
    assert(field.kind == fir.proj_kind.pj_field && field.field == 1);
    value->place.local = to.local;
    return 1;
}

fn coverage_wrapper_lengths(fir.func mut* f, ast.node* use, fir_lower.range_audit_key key,
                             fir.place from, fir.place to) u32 {
    u32 mut count = 0;
    u32 mut b = 0;
    while (b < fir.block_count(f)) {
        u32 mut p = 0;
        while (p < fir.block_statement_count(f, b)) {
            fir.statement* s = fir.block_statement(f, b, p);
            if (s->kind == fir.stmt_kind.st_assign
                && fir_lower.range_audit_loc_eq(s->loc, use->loc)
                && fir_lower.range_audit_loc_eq(s->exit_loc, key.exit_source)) {
                u32 mut i = 0;
                while (i < s->value.ops_len) {
                    count += coverage_length_operand(f, s->value.ops_first + i, from, to);
                    i += 1;
                }
            }
            p += 1;
        }
        fir.terminator* t = &fir.block_at(f, b)->term;
        if (t->kind == fir.term_kind.tk_check && t->check == fir.check_kind.chk_span
            && fir_lower.range_audit_loc_eq(t->loc, use->loc)
            && fir_lower.range_audit_loc_eq(t->exit_loc, key.exit_source)) {
            u32 mut i = 0;
            while (i < t->args_len) {
                count += coverage_length_operand(f, t->args_first + i, from, to);
                i += 1;
            }
        }
        b += 1;
    }
    assert(count == 6);
    return count;
}

fn coverage_selector(string name, string form, fir.func* f,
                      fir_lower.conditional_region_fact from,
                      fir_lower.conditional_region_fact to,
                      fir_lower.range_material_point consumer,
                      fir_lower.range_audit_key key, u32 writes, u32 reads) void {
    string mut dir = "";
    if (!sys.env("FORT_RANGE_PROBE_DIR", &dir)) { return; }
    strbuf.str_buf mut out = strbuf.create();
    defer strbuf.free(&out);
    json.writer mut j = json.writer{};
    json.json_init(&j, &out);
    json.json_object_begin(&j);
    json.json_key(&j, "source_probe"); json.json_str(&j, name);
    json.json_key(&j, "operand_class"); json.json_str(&j, form);
    json.json_key(&j, "function_symbol_id"); json.json_uint(&j, cast(key.function, u64));
    json.json_key(&j, "key_after_teardown"); conditional_json_key(&j, key);
    json.json_key(&j, "from_node_id"); json.json_uint(&j, cast(from.source, u64));
    json.json_key(&j, "to_node_id"); json.json_uint(&j, cast(to.source, u64));
    json.json_key(&j, "from_source"); conditional_json_loc(&j, from.source->loc);
    json.json_key(&j, "to_source"); conditional_json_loc(&j, to.source->loc);
    json.json_key(&j, "from_local"); json.json_uint(&j, cast(from.destination.local, u64));
    json.json_key(&j, "to_local"); json.json_uint(&j, cast(to.destination.local, u64));
    json.json_key(&j, "consumer_block"); json.json_uint(&j, cast(consumer.block, u64));
    json.json_key(&j, "consumer_position"); json.json_uint(&j, cast(consumer.position, u64));
    fir.statement* s = fir.block_statement(f, consumer.block, consumer.position);
    json.json_key(&j, "consumer_source"); conditional_json_loc(&j, s->loc);
    json.json_key(&j, "consumer_exit"); conditional_json_loc(&j, s->exit_loc);
    json.json_key(&j, "arm_writes_changed"); json.json_uint(&j, cast(writes, u64));
    json.json_key(&j, "consumer_reads_changed"); json.json_uint(&j, cast(reads, u64));
    json.json_key(&j, "other_exits_unchanged"); json.json_bool(&j, true);
    json.json_key(&j, "candidate_bytes_unchanged"); json.json_bool(&j, true);
    json.json_object_end(&j);
    string own leaf = str.concat(name, ".reuse-selector.json");
    defer del(leaf);
    probe_file(dir, leaf, strbuf.view(&out));
}

fn coverage_reuse_damage(string name, string form, lower_env.env mut* e, ast.node* decl,
                          fir.func* f, fir_lower.range_candidate_set* proposed,
                          fir_lower.range_source_audit* audit) void {
    gen.node_ref_vec mut selected = gen.node_ref_vec{};
    defer gen.refs_free(&selected);
    fir_lower.range_audit_selected(decl->b, &selected);
    assert(selected.len == 1);
    ast.node* range = gen.refs_at(&selected, 0);
    ast.node* collection = range->b;
    ast.node* mut first = null;
    ast.node* mut second = null;
    ast.node* mut first_use = null;
    ast.node* mut second_use = null;
    if (form == "independent_bounds") {
        assert(collection->kind == ast.ast_kind.k_span);
        first = collection->b;
        second = collection->c;
        first_use = collection;
        second_use = collection;
    } else {
        assert(collection->kind == ast.ast_kind.k_call && ast.ast_len(collection) == 2);
        first_use = ast.ast_child(collection, 0);
        second_use = ast.ast_child(collection, 1);
        first = first_use->a;
        second = second_use->a;
    }
    assert(first->kind == ast.ast_kind.k_ternary && second->kind == first->kind);
    assert(first != second && first->a->name == "select" && second->a->name == "other");
    fir_lower.range_audit_operation_vec mut operations = fir_lower.range_audit_operation_vec{};
    defer del(operations.items);
    fir_lower.range_audit_operations(f, &selected, &operations);
    assert(operations.len == audit->rows.len);
    u64 mut row = 0;
    while (row < operations.len) {
        fir_lower.range_audit_key key = audit->rows.items[row].key;
        fir_lower.conditional_proof_session mut session = fir_lower.conditional_proof_session{
            .proof = fir_lower.range_material_context{f, operations.items[row]},
            .key = key, .declaration = decl, .source = range};
        defer fir_lower.conditional_proof_free(&session);
        u32 mut body = 0;
        assert(fir_lower.range_audit_body(f, range, operations.items[row], &body));
        fir.range_capture mut binding = fir.range_capture{};
        assert(fir_lower.conditional_wrapped_capture(&session, range, body, &binding));
        fir_lower.conditional_region_fact a = coverage_region(&session, first);
        fir_lower.conditional_region_fact b = coverage_region(&session, second);
        assert(a.destination.base == fir.base_kind.bk_local && a.destination.proj_len == 0);
        assert(b.destination.base == fir.base_kind.bk_local && b.destination.proj_len == 0);
        assert(a.destination.local != b.destination.local);
        assert(types.type_same_shape(fir.place_type(f, a.destination),
                                     fir.place_type(f, b.destination)));
        u32 mut direction = 0;
        while (direction < 2) {
            fir_lower.conditional_region_fact mut from = b;
            fir_lower.conditional_region_fact mut to = a;
            ast.node* mut use = second_use;
            if (direction != 0) { from = a; to = b; use = first_use; }
            fir_lower.range_material_point consumer =
                coverage_consumer(f, use, form, from.destination, key);
            fir.statement saved = *fir.block_statement(f, consumer.block, consumer.position);
            fir.func mut changed = fir.func_clone(f);
            defer fir.func_free(&changed);
            u32 mut writes = 0;
            u32 mut block = 0;
            while (block < fir.block_count(&changed)) {
                u32 mut p = 0;
                while (p < fir.block_statement_count(&changed, block)) {
                    fir.statement mut* s = &fir.block_mut(&changed, block)->statements.items[p];
                    if (s->kind == fir.stmt_kind.st_assign
                        && fir_lower.range_audit_place_eq(&changed, s->place, from.destination)) {
                        assert(s->stmt == saved.stmt);
                        assert(fir_lower.range_audit_loc_eq(s->exit_loc, key.exit_source));
                        s->place = to.destination;
                        writes += 1;
                    }
                    p += 1;
                }
                block += 1;
            }
            assert(writes == 2);
            fir.statement mut* read =
                &fir.block_mut(&changed, consumer.block)->statements.items[consumer.position];
            u32 mut reads = 1;
            fir.operand mut saved_operand = fir.operand{};
            u32 mut operand_index = 0;
            if (form == "independent_callees") {
                read->value.callee_op.place = to.destination;
            } else if (form == "independent_bounds") {
                operand_index = read->value.ops_first;
                saved_operand = changed.ops.items[operand_index];
                changed.ops.items[operand_index].place = to.destination;
            } else {
                read->value.place = to.destination;
                assert(read->value.ops_len == 2);
                operand_index = read->value.ops_first + 1;
                saved_operand = changed.ops.items[operand_index];
                assert(saved_operand.kind == fir.operand_kind.ok_copy);
                assert(saved_operand.place.local == from.destination.local);
                assert(saved_operand.place.proj_len == 1);
                fir.projection length = fir.place_projection(f, saved_operand.place, 0);
                assert(length.kind == fir.proj_kind.pj_field && length.field == 1);
                reads += coverage_wrapper_lengths(&changed, use, key,
                                                   from.destination, to.destination);
            }
            fir_verify.violation mut bad = fir_verify.violation{};
            bool invalid = fir_verify.find_violation(&changed, &e->rt, &bad);
            if (invalid) {
                eprintln(form, " direction ", direction, " row ", row, " verifier ", bad.rule,
                         " block ", bad.block, " position ", bad.position, " reason ", bad.what);
                strbuf.str_buf mut damage = strbuf.create();
                defer strbuf.free(&damage);
                conditional_snapshot(&changed, &damage);
                string mut directory = "";
                if (sys.env("FORT_RANGE_PROBE_DIR", &directory)) {
                    probe_file(directory, "failed-wrapper.fir", strbuf.view(&damage));
                }
            }
            assert(!invalid);
            strbuf.str_buf mut id = strbuf.create();
            defer strbuf.free(&id);
            strbuf.append(&id, name);
            strbuf.push(&id, '_');
            strbuf.append_u64(&id, row + 1);
            if (direction == 0) { strbuf.append(&id, "_second_to_first"); }
            else { strbuf.append(&id, "_first_to_second"); }
            conditional_fault(strbuf.view(&id), "independent operand destination reuse", e,
                                decl, f, &changed, proposed, key, consumer.block,
                                consumer.position);
            fir_lower.range_candidate_set mut copied = fir_lower.range_candidate_set{};
            defer fir_lower.range_candidate_set_free(&copied);
            repair_r1_candidates(proposed, &copied);
            strbuf.str_buf mut before = strbuf.create();
            defer strbuf.free(&before);
            strbuf.str_buf mut after = strbuf.create();
            defer strbuf.free(&after);
            conditional_candidate_snapshot(&changed, &copied, &before);
            fir_lower.range_source_audit mut retained = fir_lower.range_source_audit{};
            defer fir_lower.range_source_audit_free(&retained);
            assert(!fir_lower.audit_produced_ranges(decl, &changed, &copied, &retained));
            conditional_candidate_snapshot(&changed, &copied, &after);
            assert(strbuf.view(&before) == strbuf.view(&after));
            fir_lower.range_candidate_set_free(&copied);
            fir_lower.conditional_proof_free(&session);
            assert_linear_key(retained.failure.key, key);
            assert(retained.failure.reason == fir_lower.range_audit_fault.protected_path);
            assert_unpublished(&changed, &retained);
            conditional_receipt(strbuf.view(&id), &changed, &retained, false);
            coverage_selector(strbuf.view(&id), form, f, from, to, consumer,
                              retained.failure.key, writes, reads);
            // Restore only this region's stores and its exact consuming paths.
            block = 0;
            while (block < fir.block_count(f)) {
                u32 mut p = 0;
                while (p < fir.block_statement_count(f, block)) {
                    fir.statement* original = fir.block_statement(f, block, p);
                    if (original->kind == fir.stmt_kind.st_assign
                        && fir_lower.range_audit_place_eq(f, original->place, from.destination)) {
                        fir.block_mut(&changed, block)->statements.items[p].place =
                            from.destination;
                    }
                    p += 1;
                }
                block += 1;
            }
            fir.block_mut(&changed, consumer.block)->statements.items[consumer.position] = saved;
            if (form == "independent_wrappers") {
                assert(coverage_wrapper_lengths(&changed, use, key,
                                                 to.destination, from.destination) == reads - 1);
            } else if (form == "independent_bounds") {
                changed.ops.items[operand_index] = saved_operand;
            }
            strbuf.clear(&before);
            strbuf.clear(&after);
            conditional_snapshot(f, &before);
            conditional_snapshot(&changed, &after);
            assert(strbuf.view(&before) == strbuf.view(&after));
            coverage_reuse_mutations += 1;
            direction += 1;
        }
        row += 1;
    }
}

fn coverage_reuse_pair(string name, string@ direct) void {
    u32 mut mode = 0;
    while (mode < 2) {
        u64 mut extra = 0;
        if (mode != 0) { extra = 2; }
        string mut@ own source = new(string, direct.len + extra);
        defer del(source);
        u64 mut i = 0;
        u64 mut j = 0;
        while (i < direct.len) {
            bool collection = i + 3 == direct.len;
            if (mode != 0 && collection) { source[j] = "    defer {"; j += 1; }
            source[j] = direct[i];
            j += 1;
            if (mode != 0 && collection) { source[j] = "    }"; j += 1; }
            i += 1;
        }
        assert(j == source.len);
        strbuf.str_buf mut id = strbuf.create();
        defer strbuf.free(&id);
        strbuf.append(&id, "coverage_");
        strbuf.append(&id, name);
        if (mode == 0) { strbuf.append(&id, "_direct"); }
        else { strbuf.append(&id, "_deferred"); }
        lower_env.env mut e = lower_env.env{};
        lower_env.open(&e);
        defer lower_env.close(&e);
        lower_env.check_lines(&e, source, true);
        ast.node* decl = lower_env.decl(&e, "walk");
        fir.func mut f = fir.func{};
        defer fir.func_free(&f);
        fir_lower.range_candidate_set mut proposed = fir_lower.range_candidate_set{};
        defer fir_lower.range_candidate_set_free(&proposed);
        fir_lower.report mut why = fir_lower.report{};
        assert(fir_lower.lower_function_with_range_candidates(&e.c.ck, decl, &f, &proposed, &why));
        fir_verify.violation mut bad = fir_verify.violation{};
        assert(!fir_verify.find_violation(&f, &e.rt, &bad));
        fir_lower.range_source_audit mut audit = fir_lower.range_source_audit{};
        defer fir_lower.range_source_audit_free(&audit);
        assert(fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
        u64 expected = cast(mode + 1, u64);
        assert(audit.rows.len == expected && proposed.captures.len == expected);
        assert(audit.matched_captures == cast(expected, u32));
        assert(audit.matched_boundaries == cast(proposed.boundaries.len, u32));
        if (mode == 0) {
            assert(audit.rows.items[0].key.context == 0);
            assert(audit.rows.items[0].key.exit_occurrence == 0);
        } else {
            assert(audit.rows.items[0].key.context != 0 && audit.rows.items[1].key.context != 0);
            assert(audit.rows.items[0].key.exit_occurrence
                   != audit.rows.items[1].key.exit_occurrence);
            assert(audit.rows.items[0].key.exit_source.line
                   != audit.rows.items[1].key.exit_source.line);
        }
        assert_unpublished(&f, &audit);
        check_output(&e, decl, &f, strbuf.view(&id), true);
        coverage_reuse_damage(strbuf.view(&id), name, &e, decl, &f, &proposed, &audit);
        fir_lower.range_candidate_set_free(&proposed);
        conditional_receipt(strbuf.view(&id), &f, &audit, true);
        coverage_reuse_pairs += 1;
        coverage_reuse_rows += cast(expected, u32);
        mode += 1;
    }
}

fn coverage_reuse_matrix() void {
    string own callee_line = str.concat(
        "    for (i32 x : pick((select ? left : right)(values, backup), ",
        "(other ? right : left)(values, backup))) { }");
    defer del(callee_line);
    string[7] callees = {
        "fn left(i32@ a, i32@ b) i32@ { return a; }",
        "fn right(i32@ a, i32@ b) i32@ { return b; }",
        "fn pick(i32@ a, i32@ b) i32@ { return a; }",
        "fn walk(bool select, bool other, bool quit, i32@ values, i32@ backup) void {",
        callee_line,
        "    if (quit) { return; }",
        "}",
    };
    coverage_reuse_pair("independent_callees", callees[..]);
    string[4] bounds = {
        "fn walk(bool select, bool other, bool quit, i32@ values, i64 low, i64 high) void {",
        "    for (i32 x : values[select ? low : high .. other ? high : low]) { }",
        "    if (quit) { return; }",
        "}",
    };
    coverage_reuse_pair("independent_bounds", bounds[..]);
    string own wrapper_line = str.concat(
        "    for (i32 x : pick((select ? values : backup)[..], ",
        "(other ? backup : values)[..])) { }");
    defer del(wrapper_line);
    string[5] wrappers = {
        "fn pick(i32@ a, i32@ b) i32@ { return a; }",
        "fn walk(bool select, bool other, bool quit, i32@ values, i32@ backup) void {",
        wrapper_line,
        "    if (quit) { return; }",
        "}",
    };
    coverage_reuse_pair("independent_wrappers", wrappers[..]);
    assert(coverage_reuse_pairs == 6 && coverage_reuse_rows == 9);
    assert(coverage_reuse_mutations == 18);
}

fn coverage_borrowed_pointee_matrix() void {
    u32 pairs = repair_r2_pairs;
    u32 rows = repair_r2_rows;
    u32 invalid = repair_r2_invalid;
    string own parameters = str.concat(
        "fn walk(bool select, bool other, bool third, bool quit, i32* own* a, ",
        "i32* own* b, i32* own* c, i32* own* d, i32@ values) void {");
    defer del(parameters);
    string[5] nested_then = {
        "fn pick(i32* own* p, i32@ values) i32@ { return values; }",
        parameters,
        "    for (i32 x : pick(select ? (other ? a : b) : c, values)) { }",
        "    if (quit) { return; }",
        "}",
    };
    repair_r2_pair("borrowed_own_pointee_then", nested_then[..], false);
    string[5] nested_else = {
        "fn pick(i32* own* p, i32@ values) i32@ { return values; }",
        parameters,
        "    for (i32 x : pick(select ? a : (other ? b : c), values)) { }",
        "    if (quit) { return; }",
        "}",
    };
    repair_r2_pair("borrowed_own_pointee_else", nested_else[..], false);
    string own depth_line = str.concat(
        "    for (i32 x : pick(select ? (other ? (third ? a : b) : c) : ",
        "d, values)) { }");
    defer del(depth_line);
    string[5] depth_three = {
        "fn pick(i32* own* p, i32@ values) i32@ { return values; }",
        parameters,
        depth_line,
        "    if (quit) { return; }",
        "}",
    };
    repair_r2_pair("borrowed_own_pointee_depth_three", depth_three[..], false);
    assert(repair_r2_pairs - pairs == 6 && repair_r2_rows - rows == 9);
    assert(repair_r2_invalid - invalid == 9);
}

fn main() i32 {
    string mut coverage = "";
    if (sys.env("FORT_CONDITIONAL_COVERAGE_REGRESSION", &coverage)) {
        coverage_reuse_matrix();
        coverage_borrowed_pointee_matrix();
        return 0;
    }
    string mut owner_repair = "";
    if (sys.env("FORT_CONDITIONAL_REPAIR_R2_REGRESSION", &owner_repair)) {
        repair_r2_matrix();
        return 0;
    }
    string mut repair = "";
    if (sys.env("FORT_CONDITIONAL_REPAIR_R1_REGRESSION", &repair)) {
        repair_r1_matrix();
        return 0;
    }
    string mut regression = "";
    if (sys.env("FORT_CONDITIONAL_OPERAND_REGRESSION", &regression)) {
        conditional_operand_matrix();
        return 0;
    }
    defer strbuf.free(&probe_rows);
    defer strbuf.free(&conditional_evidence);
    defer strbuf.free(&conditional_mutations);
    defer strbuf.free(&legacy_before);
    defer strbuf.free(&legacy_evidence);
    selected_inventory();
    println("selected inventory 1");
    println("produced expansion 1");
    repeated_expansion();
    println("repeated expansion 3");
    deferred_context_damage();
    println("context damage 4");
    damaged_keys();
    println("damaged keys 5");
    cleanup_damage();
    multi_exit_cleanup_damage();
    println("boundary damage 5");
    call_result_matched();
    println("call result matched");
    capture_kinds();
    println("capture kinds 7");
    selected_paths();
    println("selected paths 2");
    boundary_repeats();
    println("boundary repeats 10");
    absence_stays_open();
    println("absence remains open");
    context_identity_damage();
    deferred_scope_matrix();
    expansion_gap_damage();
    call_materialization_matrix();
    additional_scope_matrix();
    source_body_identity_damage();
    ambiguous_gap_partition();
    assert(output_comparisons == 70);
    conditional_result_matrix();
    assert(output_comparisons == 88);
    u32 inherited_damage = linear_damage_cases;
    u32 inherited_verified = linear_verified_damage;
    u32 inherited_invalid = linear_invalid_damage;
    legacy_active = true;
    conditional_materialization_matrix();
    legacy_active = false;
    u32 added_damage = linear_damage_cases - inherited_damage;
    u32 added_verified = linear_verified_damage - inherited_verified;
    u32 added_invalid = linear_invalid_damage - inherited_invalid;
    assert(added_damage >= 440 && added_verified >= 400 && added_invalid >= 40);
    assert(legacy_receipts == added_damage);
    assert(output_comparisons == 136);
    linear_materialization_matrix();
    assert(linear_pairs == 32 && linear_rows == 48);
    assert(output_comparisons == 168);
    linear_alias_matrix();
    linear_slice_matrix();
    conditional_folded_matrix();
    conditional_growth_and_failure();
    assert(linear_damage_cases - added_damage == 1211);
    assert(linear_verified_damage - added_verified == 1068);
    assert(linear_invalid_damage - added_invalid == 143);
    eprintln("linear damage ", linear_damage_cases - added_damage, " verified ",
             linear_verified_damage - added_verified, " invalid ",
             linear_invalid_damage - added_invalid);
    eprintln("legacy added damage ", added_damage, " verified ", added_verified,
             " invalid ", added_invalid);
    eprintln("conditional damage ", conditional_damage_cases, " verified ",
             conditional_verified_damage, " invalid ", conditional_invalid_damage);
    conditional_operand_matrix();
    assert(output_comparisons == 182);
    conditional_alias_matrix();
    conditional_operand_auxiliary_matrix();
    eprintln("operand pairs ", conditional_operand_pairs, " rows ", conditional_operand_rows,
             " auxiliaries ", conditional_auxiliary_executions);
    eprintln("callee mutation fixtures ", conditional_callee_mutation_executions,
             " changed expansions ", conditional_callee_changed_expansions);
    eprintln("final conditional damage ", conditional_damage_cases, " verified ",
             conditional_verified_damage, " invalid ", conditional_invalid_damage);
    repair_r1_matrix();
    assert(output_comparisons == 206);
    eprintln("repair R1 pairs ", repair_r1_pairs, " rows ", repair_r1_rows,
             " corruptions ", repair_r1_corruptions);
    repair_r2_matrix();
    assert(output_comparisons == 222);
    eprintln("repair R2 pairs ", repair_r2_pairs, " rows ", repair_r2_rows,
             " substitutions ", repair_r2_substitutions, " invalid ", repair_r2_invalid);
    coverage_reuse_matrix();
    assert(output_comparisons == 228);
    coverage_borrowed_pointee_matrix();
    assert(output_comparisons == 234);
    eprintln("coverage reuse pairs ", coverage_reuse_pairs, " rows ", coverage_reuse_rows,
             " valid mutations ", coverage_reuse_mutations);
    eprintln("coverage borrowed pointee pairs 6 rows 9 invalid transfers 9");
    export_ledger();
    println("output compared 234");
    return 0;
}
