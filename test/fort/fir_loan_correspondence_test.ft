fn source_body_identity_damage() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[11] source = {
        "fn walk(i32[2] values, bool skip) void {",
        "    for (i32 x : values) {",
        "        defer {",
        "            for (i32 y : values) { }",
        "        }",
        "        if (skip) { continue; }",
        "    }",
        "}",
        "",
        "",
        "",
    };
    lower_env.check_lines(&e, source[..], true);
    ast.node* decl = lower_env.decl(&e, "walk");
    fir.func mut f = fir.func{};
    defer fir.func_free(&f);
    fir_lower.range_candidate_set mut proposed = fir_lower.range_candidate_set{};
    defer fir_lower.range_candidate_set_free(&proposed);
    fir_lower.report mut why = fir_lower.report{};
    assert(fir_lower.lower_function_with_range_candidates(&e.c.ck, decl, &f, &proposed, &why));
    fir_lower.range_source_audit mut audit = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&audit);
    assert(fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert(audit.rows.len == 3);
    fir_lower.range_audit_key expected = audit.rows.items[1].key;
    assert(expected.declaration == 2 && expected.expansion == 2);
    assert(expected.exit_occurrence == 2);
    assert(audit.rows.items[2].key.exit_occurrence == 5);
    check_output(&e, decl, &f, "source_body_identity_damage", true);
    fir_lower.range_source_audit_free(&audit);
    u32 mut body = fir.block_count(&f);
    u64 mut i = 0;
    while (i < proposed.boundaries.len) {
        fir_lower.range_boundary_candidate c = proposed.boundaries.items[i];
        if (c.expansion == 2 && c.boundary.kind == fir.range_boundary_kind.body_entry) {
            body = c.boundary.block;
        }
        i += 1;
    }
    assert(body < fir.block_count(&f));
    fir.statement mut* live = &fir.block_mut(&f, body)->statements.items[0];
    fir.statement original = *live;
    assert(original.kind == fir.stmt_kind.st_live);
    live->stmt += 1;
    assert_boundary_refusal(decl, &f, &proposed, expected);
    *live = original;
    live->loc = expected.source;
    assert_boundary_refusal(decl, &f, &proposed, expected);
    *live = original;
    live->exit_loc = proposed.captures.items[2].occurrence.exit_source;
    assert_boundary_refusal(decl, &f, &proposed, expected);
    *live = original;
    u32 mut head = fir.block_count(&f);
    u32 mut b = 0;
    while (b < fir.block_count(&f)) {
        fir.terminator* term = &fir.block_at(&f, b)->term;
        if (term->kind == fir.term_kind.tk_switch && term->arms_len == 1
            && fir.term_arm(&f, term, 0).target == body) {
            head = b;
        }
        b += 1;
    }
    assert(head < fir.block_count(&f));
    fir.terminator mut* term = &fir.block_mut(&f, head)->term;
    fir.terminator saved_term = *term;
    term->stmt += 1;
    assert_boundary_refusal(decl, &f, &proposed, expected);
    *term = saved_term;
    term->loc = expected.context_source;
    assert_boundary_refusal(decl, &f, &proposed, expected);
    *term = saved_term;
    term->exit_loc = proposed.captures.items[2].occurrence.exit_source;
    assert_boundary_refusal(decl, &f, &proposed, expected);
    *term = saved_term;
    assert(fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert_unpublished(&f, &audit);
    fir_lower.range_source_audit_free(&audit);
    proposed.deferred.items[0].parent = 99;
    assert(!fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert_context_key(&audit, expected);
    assert(audit.rows.len == 1);
    fir_lower.range_candidate_set_free(&proposed);
    assert_context_key(&audit, expected);
    assert_unpublished(&f, &audit);
}

fn ambiguous_gap_partition() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[9] source = {
        "fn walk(i32[2] values) void {",
        "    for (i32 x : values) {",
        "        return;",
        "        i32 saved = x;",
        "    }",
        "}",
        "",
        "",
        "",
    };
    lower_env.check_lines(&e, source[..], true);
    ast.node* decl = lower_env.decl(&e, "walk");
    fir.func mut f = fir.func{};
    defer fir.func_free(&f);
    fir_lower.range_candidate_set mut proposed = fir_lower.range_candidate_set{};
    defer fir_lower.range_candidate_set_free(&proposed);
    fir_lower.report mut why = fir_lower.report{};
    assert(fir_lower.lower_function_with_range_candidates(&e.c.ck, decl, &f, &proposed, &why));
    fir_verify.violation mut bad = fir_verify.violation{};
    assert(!fir_verify.find_violation(&f, &e.rt, &bad));
    fir_lower.range_source_audit mut audit = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&audit);
    assert(!fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert(audit.failure.reason == fir_lower.range_audit_fault.boundary);
    assert(audit.failure.key.source.line == 2);
    assert(audit.failure.key.declaration == 1 && audit.failure.key.expansion == 1);
    assert(audit.failure.key.context == 0 && audit.failure.key.exit_occurrence == 0);
    assert(audit.failure.key.exit_source.line == 0);
    assert(audit.rows.len == 0 && audit.matched_captures == 0);
    assert_unpublished(&f, &audit);
    check_output(&e, decl, &f, "ambiguous_gap_partition", true);
    fir_lower.range_source_audit_free(&audit);
    u64 count = proposed.boundaries.len;
    assert(count == 8);
    // A selected candidate subset cannot turn the ambiguous partition into proof.
    proposed.boundaries.len = 5;
    assert(!fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert(audit.failure.reason == fir_lower.range_audit_fault.boundary);
    assert(audit.failure.key.source.line == 2 && audit.rows.len == 0);
    assert_unpublished(&f, &audit);
    fir_lower.range_source_audit_free(&audit);
    proposed.boundaries.len = count;
    fir_lower.range_candidate_set_free(&proposed);
    assert(!fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert(audit.failure.reason == fir_lower.range_audit_fault.declaration);
    assert(audit.selected_declarations == 1);
    assert_unpublished(&f, &audit);
}

fn main() i32 {
    defer strbuf.free(&probe_rows);
    selected_inventory();
    println("selected inventory 1");
    println("produced expansion 1");
    repeated_expansion();
    println("repeated expansion 3");
    deferred_context_damage();
    println("context damage 4");
    damaged_keys();
    println("damaged keys 5");
    cleanup_damage();
    multi_exit_cleanup_damage();
    println("boundary damage 5");
    call_result_incomplete();
    println("call result incomplete");
    capture_kinds();
    println("capture kinds 7");
    selected_paths();
    println("selected paths 2");
    boundary_repeats();
    println("boundary repeats 10");
    absence_stays_open();
    println("absence remains open");
    context_identity_damage();
    deferred_scope_matrix();
    expansion_gap_damage();
    call_materialization_matrix();
    additional_scope_matrix();
    source_body_identity_damage();
    ambiguous_gap_partition();
    assert(output_comparisons == 70);
    conditional_materialization_matrix();
    assert(output_comparisons == 118);
    export_ledger();
    println("output compared 118");
    return 0;
}
