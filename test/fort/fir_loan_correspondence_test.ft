//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| selected inventory 1
//| produced expansion 1
//| repeated expansion 3
//| context damage 4
//| damaged keys 5
//| boundary damage 5
//| call result matched
//| capture kinds 7
//| selected paths 2
//| boundary repeats 10
//| absence remains open
//| output compared 234
/// Checks selected source inventory against inactive range proposals.
import ast;
import check;
import consts;
import diag;
import fir;
import fir_llvm;
import fir_lower;
import fir_print;
import fir_verify;
import gen;
import gen_env;
import gen_fir;
import gen_data;
import json;
import modules;
import prim;
import types;
import lower_env;
import std.strbuf;
import std.io;
import std.sys;
import std.libc;
import std.str;

u32 mut output_comparisons = 0;
u32 mut original_comparisons = 0;
u32 mut exported_comparisons = 0;
u32 mut conditional_pairs = 0;
u32 mut conditional_rows = 0;
u32 mut conditional_damage_cases = 0;
u32 mut conditional_verified_damage = 0;
u32 mut conditional_invalid_damage = 0;
u32 mut conditional_receipts = 0;
strbuf.str_buf mut conditional_evidence = strbuf.str_buf{};
strbuf.str_buf mut conditional_mutations = strbuf.str_buf{};
bool mut legacy_active = false;
lower_env.env mut* mut legacy_env = null;
strbuf.str_buf mut legacy_before = strbuf.str_buf{};
strbuf.str_buf mut legacy_evidence = strbuf.str_buf{};
u32 mut legacy_receipts = 0;
u32 mut linear_pairs = 0;
u32 mut linear_rows = 0;
u32 mut linear_damage_cases = 0;
u32 mut linear_verified_damage = 0;
u32 mut linear_invalid_damage = 0;
strbuf.str_buf mut probe_rows = strbuf.str_buf{};
bool mut repair_r2_runtime_free = false;

struct probe_emissions {
    u32 selected;
    u32 substitutions;
}

fn probe_declarations(gen.emitter mut* g, gen_fir.fir_path mut* fp, ast.node* list,
                      ast.node* selected, fir.func* audited, probe_emissions mut* counts) void {
    u64 mut i = 0;
    while (list != null && i < ast.ast_len(list)) {
        ast.node* d = ast.ast_child(list, i);
        if (d->kind == ast.ast_kind.k_compile_if) {
            probe_declarations(g, fp, fir_lower.selected_branch(d), selected, audited, counts);
        } else if (d->kind == ast.ast_kind.k_fn_decl && d->b != null) {
            if (d == selected) {
                counts->selected += 1;
                if (audited != null) {
                    fir.func replacement = fir.func_clone(audited);
                    gen_fir.emit_fir(g, fp, move(replacement));
                    counts->substitutions += 1;
                } else {
                    gen_fir.emit_function(g, fp, d);
                }
            } else {
                gen_fir.emit_function(g, fp, d);
            }
        }
        i += 1;
    }
}

fn probe_module(lower_env.env mut* e, ast.node* decl, fir.func* audited,
                 gen.emitter mut* g, probe_emissions mut* counts) void {
    gen.gen_init(g, &e->c.m.s, gen.gen_options{});
    g->ck = &e->c.ck;
    gen_fir.fir_path mut fp = gen_fir.fir_path{.ck = &e->c.ck, .rt = e->rt};
    strbuf.append(&g->named, gen.SPAN_TYPE);
    strbuf.append(&g->named, " = type { ptr, i64 }\n");
    strbuf.append(&g->named, gen.ENUM_MEMBER_TYPE);
    strbuf.append(&g->named, " = type { i32, ptr }\n");
    u64 mut i = 0;
    while (i < modules.count(&e->c.m.set)) {
        modules.module* m = modules.at(&e->c.m.set, i);
        g->module = m;
        gen_fir.gen_declarations(g, &fp, m->ast, 1);
        gen_fir.gen_declarations(g, &fp, m->ast, 2);
        probe_declarations(g, &fp, m->ast, decl, audited, counts);
        g->module = null;
        i += 1;
    }
    if (repair_r2_runtime_free) {
        strbuf.append(&g->funcs, "declare void @\"std.rt.free\"(ptr)\n");
    }
    gen_data.gen_finish(g);
    assert(!g->failed && counts->selected == 1);
    if (audited != null) { assert(counts->substitutions == 1); }
    else { assert(counts->substitutions == 0); }
}

fn probe_file(string dir, string leaf, string text) void {
    strbuf.str_buf mut path = strbuf.create();
    defer strbuf.free(&path);
    strbuf.append(&path, dir);
    strbuf.push(&path, '/');
    strbuf.append(&path, leaf);
    assert(io.write_file(strbuf.view(&path), cast(text, u8@)));
}

fn probe_name(strbuf.str_buf mut* out, u32 index, string suffix) void {
    strbuf.append(out, "probe-");
    strbuf.append_u64(out, cast(index, u64));
    strbuf.append(out, suffix);
}

fn export_probe(string name, bool added, ast.node* decl,
                 gen.emitter mut* ordinary, gen.emitter* audited) void {
    string mut dir = "";
    if (!sys.env("FORT_RANGE_PROBE_DIR", &dir)) { return; }
    strbuf.str_buf mut ordinary_name = strbuf.create();
    defer strbuf.free(&ordinary_name);
    probe_name(&ordinary_name, output_comparisons, ".ordinary.ll");
    strbuf.str_buf mut audited_name = strbuf.create();
    defer strbuf.free(&audited_name);
    probe_name(&audited_name, output_comparisons, ".audited.ll");
    probe_file(dir, strbuf.view(&ordinary_name), strbuf.view(&ordinary->out));
    probe_file(dir, strbuf.view(&audited_name), strbuf.view(&audited->out));
    if (exported_comparisons != 0) { strbuf.append(&probe_rows, ",\n"); }
    json.writer mut j = json.writer{};
    json.json_init(&j, &probe_rows);
    json.json_object_begin(&j);
    json.json_key(&j, "index");
    json.json_uint(&j, cast(output_comparisons, u64));
    json.json_key(&j, "source_probe");
    json.json_str(&j, name);
    json.json_key(&j, "origin");
    string mut origin = "original";
    if (added) { origin = "added"; }
    json.json_str(&j, origin);
    json.json_key(&j, "selected_function_key");
    json.json_str(&j, gen.gen_symbol(ordinary, decl->sym));
    json.json_key(&j, "selected_ir_symbol");
    json.json_str(&j, gen.gen_symbol_ref(ordinary, decl->sym));
    json.json_key(&j, "ordinary_selected_emissions");
    json.json_uint(&j, 1);
    json.json_key(&j, "audited_selected_emissions");
    json.json_uint(&j, 1);
    json.json_key(&j, "audited_substitutions");
    json.json_uint(&j, 1);
    json.json_key(&j, "ordinary");
    json.json_str(&j, strbuf.view(&ordinary_name));
    json.json_key(&j, "audited");
    json.json_str(&j, strbuf.view(&audited_name));
    json.json_object_end(&j);
    exported_comparisons += 1;
}

fn export_ledger() void {
    string mut dir = "";
    if (!sys.env("FORT_RANGE_PROBE_DIR", &dir)) { return; }
    assert(exported_comparisons == output_comparisons && original_comparisons == 27);
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    strbuf.append(&text, "{\"comparisons\":");
    strbuf.append_u64(&text, cast(output_comparisons, u64));
    strbuf.append(&text, ",\"original_comparisons\":27,\"added_comparisons\":");
    strbuf.append_u64(&text, cast(output_comparisons - original_comparisons, u64));
    strbuf.append(&text, ",\"excluded_invalid_fir\":[],\"probes\":[\n");
    strbuf.append(&text, strbuf.view(&probe_rows));
    strbuf.append(&text, "\n]}\n");
    probe_file(dir, "probes.json", strbuf.view(&text));
    strbuf.clear(&text);
    strbuf.append(&text, "{\"verdicts\":[\n");
    strbuf.append(&text, strbuf.view(&conditional_evidence));
    strbuf.append(&text, "\n],\"mutations\":[\n");
    strbuf.append(&text, strbuf.view(&conditional_mutations));
    strbuf.append(&text, "\n],\"legacy_mutations\":[\n");
    strbuf.append(&text, strbuf.view(&legacy_evidence));
    strbuf.append(&text, "\n]}\n");
    probe_file(dir, "conditional-evidence.json", strbuf.view(&text));
}

fn check_output(lower_env.env mut* e, ast.node* decl, fir.func* f,
                 string name, bool added) void {
    fir_verify.violation mut bad = fir_verify.violation{};
    assert(!fir_verify.find_violation(f, &e->rt, &bad));
    fir.func mut ordinary = fir.func{};
    defer fir.func_free(&ordinary);
    fir_lower.report mut why = fir_lower.report{};
    assert(fir_lower.lower_function(&e->c.ck, decl, &ordinary, &why));
    assert(!fir_verify.find_violation(&ordinary, &e->rt, &bad));
    strbuf.str_buf mut audited_text = strbuf.create();
    defer strbuf.free(&audited_text);
    strbuf.str_buf mut ordinary_text = strbuf.create();
    defer strbuf.free(&ordinary_text);
    conditional_snapshot(f, &audited_text);
    conditional_snapshot(&ordinary, &ordinary_text);
    assert(strbuf.view(&audited_text) == strbuf.view(&ordinary_text));
    gen.emitter mut audited_ir = gen.emitter{};
    defer gen.gen_free(&audited_ir);
    gen.emitter mut ordinary_ir = gen.emitter{};
    defer gen.gen_free(&ordinary_ir);
    probe_emissions mut audited_counts = probe_emissions{};
    probe_emissions mut ordinary_counts = probe_emissions{};
    probe_module(e, decl, f, &audited_ir, &audited_counts);
    probe_module(e, decl, null, &ordinary_ir, &ordinary_counts);
    assert(strbuf.view(&audited_ir.out) == strbuf.view(&ordinary_ir.out));
    strbuf.str_buf mut report = strbuf.create();
    defer strbuf.free(&report);
    assert(gen_env.block_report(&report, strbuf.view(&audited_ir.funcs))
           == gen_env.BLOCKS_OK);
    output_comparisons += 1;
    if (!added) { original_comparisons += 1; }
    export_probe(name, added, decl, &ordinary_ir, &audited_ir);
}

fn selected_inventory() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[3] source = {
        "fn walk(i32[2] values) void {",
        "    for (i32 x : values) { }",
        "}",
    };
    lower_env.check_lines(&e, source[..], true);
    ast.node* decl = lower_env.decl(&e, "walk");
    fir.func mut f = fir.func{};
    defer fir.func_free(&f);
    fir_lower.range_candidate_set mut proposed = fir_lower.range_candidate_set{};
    defer fir_lower.range_candidate_set_free(&proposed);
    fir_lower.report mut why = fir_lower.report{};
    assert(fir_lower.lower_function_with_range_candidates(&e.c.ck, decl, &f,
                                                           &proposed, &why));
    fir_lower.range_source_audit mut audit = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&audit);
    assert(fir_lower.audit_range_inventory(decl, &proposed, &audit));
    assert(audit.selected_declarations == 1 && !audit.source_complete);
    fir_lower.range_source_audit_free(&audit);
    assert(fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert(audit.produced_expansions == 1 && audit.matched_captures == 1);
    assert(audit.rows.len == 1 && audit.rows.items[0].key.expansion == 1);
    assert(!audit.structural_valid && !audit.source_complete && !audit.ownership_proved);
    check_output(&e, decl, &f, "selected_inventory", false);
    fir_lower.range_source_audit_free(&audit);
    proposed.captures.len = 0;
    assert(!fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert(audit.failure.reason == fir_lower.range_audit_fault.expansion_key);
    assert(audit.failure.key.declaration == 1 && audit.failure.key.expansion == 1);
    fir_lower.range_source_audit_free(&audit);
    proposed.declarations.len = 0;
    proposed.boundaries.len = 0;
    assert(!fir_lower.audit_range_inventory(decl, &proposed, &audit));
    assert(audit.selected_declarations == 1);
    assert(audit.failure.reason == fir_lower.range_audit_fault.declaration);
    assert(audit.failure.key.declaration == 1);
    assert(!audit.source_complete && !f.range_source_complete);
}

fn repeated_expansion() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[12] source = {
        "fn walk(i32[2] values, bool skip) i32 {",
        "    i32 mut count = 0;",
        "    for (i32 x : values) {",
        "        defer {",
        "            for (i32 y : values) { count +%= y; }",
        "        }",
        "        if (skip) { continue; }",
        "        count +%= x;",
        "    }",
        "    return count;",
        "}",
        "",
    };
    lower_env.check_lines(&e, source[..], true);
    ast.node* decl = lower_env.decl(&e, "walk");
    fir.func mut f = fir.func{};
    defer fir.func_free(&f);
    fir_lower.range_candidate_set mut proposed = fir_lower.range_candidate_set{};
    defer fir_lower.range_candidate_set_free(&proposed);
    fir_lower.report mut why = fir_lower.report{};
    assert(fir_lower.lower_function_with_range_candidates(&e.c.ck, decl, &f,
                                                           &proposed, &why));
    fir_lower.range_source_audit mut audit = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&audit);
    assert(fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert(audit.selected_declarations == 2 && audit.produced_expansions == 3);
    assert(audit.matched_captures == 3 && audit.rows.len == 3);
    assert(audit.rows.items[0].key.declaration == 1);
    assert(audit.rows.items[1].key.declaration == 2);
    assert(audit.rows.items[2].key.declaration == 2);
    assert(audit.rows.items[1].key.context_source.line == 4);
    assert(audit.rows.items[1].key.exit_source.line == 7);
    assert(audit.rows.items[1].key.exit_occurrence == 2);
    assert(audit.rows.items[2].key.exit_occurrence == 5);
    assert(!audit.source_complete && !f.range_source_complete);
    check_output(&e, decl, &f, "repeated_expansion", false);
    fir_lower.range_candidate_set_free(&proposed);
    assert(audit.rows.items[0].boundaries_len > 0);
}

fn produced_exit(fir.func* f, u32 source_line) diag.loc {
    u32 mut b = 0;
    while (b < fir.block_count(f)) {
        u32 mut p = 0;
        while (p < fir.block_statement_count(f, b)) {
            fir.statement* s = fir.block_statement(f, b, p);
            if (s->loc.line == source_line && s->exit_loc.line != 0) {
                return s->exit_loc;
            }
            p += 1;
        }
        b += 1;
    }
    panic("range audit test: missing FIR exit");
}

fn expect_context_refusal(ast.node* decl, fir.func* f,
                          fir_lower.range_candidate_set* proposed,
                          diag.loc exit_source) void {
    fir_lower.range_source_audit mut audit = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&audit);
    assert(!fir_lower.audit_produced_ranges(decl, f, proposed, &audit));
    assert(audit.failure.reason == fir_lower.range_audit_fault.context);
    assert(audit.failure.key.declaration == 1 && audit.failure.key.expansion == 1);
    assert(audit.failure.key.source.line == 3);
    assert(audit.failure.key.context_source.line == 3);
    assert(audit.failure.key.exit_source.line == exit_source.line);
    assert(audit.failure.key.exit_source.col == exit_source.col);
    assert(!audit.structural_valid && !audit.source_complete && !audit.ownership_proved);
}

fn deferred_context_damage() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[7] source = {
        "fn walk(i32[2] values) void {",
        "    defer {",
        "        defer { for (i32 x : values) { } }",
        "    }",
        "}",
        "",
        "",
    };
    lower_env.check_lines(&e, source[..], true);
    ast.node* decl = lower_env.decl(&e, "walk");
    fir.func mut f = fir.func{};
    defer fir.func_free(&f);
    fir_lower.range_candidate_set mut proposed = fir_lower.range_candidate_set{};
    defer fir_lower.range_candidate_set_free(&proposed);
    fir_lower.report mut why = fir_lower.report{};
    assert(fir_lower.lower_function_with_range_candidates(&e.c.ck, decl, &f,
                                                           &proposed, &why));
    assert(proposed.captures.len == 1 && proposed.deferred.len == 2);
    diag.loc exit_source = produced_exit(&f, 3);
    fir_lower.range_source_audit mut valid = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&valid);
    assert(fir_lower.audit_produced_ranges(decl, &f, &proposed, &valid));
    assert(valid.rows.len == 1 && valid.rows.items[0].key.context == 2);
    check_output(&e, decl, &f, "deferred_context_damage", false);
    u64 captures = proposed.captures.len;
    proposed.captures.len = 0;
    expect_context_refusal(decl, &f, &proposed, exit_source);
    proposed.captures.len = captures;
    u64 contexts = proposed.deferred.len;
    proposed.deferred.len = 1;
    expect_context_refusal(decl, &f, &proposed, exit_source);
    proposed.deferred.len = contexts;
    u32 parent = proposed.deferred.items[1].parent;
    assert(parent != 0);
    proposed.deferred.items[1].parent = 0;
    expect_context_refusal(decl, &f, &proposed, exit_source);
    proposed.deferred.items[1].parent = parent;
    u32 occurrence = proposed.captures.items[0].occurrence.exit_occurrence;
    u32 inner_occurrence = proposed.deferred.items[1].exit_occurrence;
    proposed.captures.items[0].occurrence.exit_occurrence = 99;
    proposed.deferred.items[1].exit_occurrence = 99;
    expect_context_refusal(decl, &f, &proposed, exit_source);
    proposed.captures.items[0].occurrence.exit_occurrence = occurrence;
    proposed.deferred.items[1].exit_occurrence = inner_occurrence;
}

fn damaged_keys() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[3] source = {
        "fn walk(i32@ values) void {",
        "    for (i32 x : values) { }",
        "}",
    };
    lower_env.check_lines(&e, source[..], true);
    ast.node* decl = lower_env.decl(&e, "walk");
    fir.func mut f = fir.func{};
    defer fir.func_free(&f);
    fir_lower.range_candidate_set mut proposed = fir_lower.range_candidate_set{};
    defer fir_lower.range_candidate_set_free(&proposed);
    fir_lower.report mut why = fir_lower.report{};
    assert(fir_lower.lower_function_with_range_candidates(&e.c.ck, decl, &f,
                                                           &proposed, &why));
    fir_lower.range_source_audit mut audit = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&audit);
    assert(fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert(audit.protected_paths == 1 && audit.rows.items[0].boundaries_len == 5);
    check_output(&e, decl, &f, "damaged_keys", false);
    fir_lower.range_source_audit_free(&audit);
    proposed.captures.items[0].expansion = 9;
    assert(!fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert(audit.failure.reason == fir_lower.range_audit_fault.expansion_key);
    assert(audit.failure.key.declaration == 1 && audit.failure.key.expansion == 1);
    fir_lower.range_source_audit_free(&audit);
    proposed.captures.items[0].expansion = 1;
    proposed.captures.items[0].occurrence.exit_source.line = 3;
    assert(!fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert(audit.failure.reason == fir_lower.range_audit_fault.exit_source);
    assert(audit.failure.key.source.line == 2);
    fir_lower.range_source_audit_free(&audit);
    proposed.captures.items[0].occurrence.exit_source.line = 0;
    proposed.captures.items[0].binding.original = proposed.captures.items[0].binding.captured;
    assert(!fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert(audit.failure.reason == fir_lower.range_audit_fault.protected_path);
    assert(!audit.source_complete && !f.range_source_complete);
}

fn cleanup_damage() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[3] source = {
        "fn walk(i32[2] values) void {",
        "    for (i32 x : values) { }",
        "}",
    };
    lower_env.check_lines(&e, source[..], true);
    ast.node* decl = lower_env.decl(&e, "walk");
    fir.func mut f = fir.func{};
    defer fir.func_free(&f);
    fir_lower.range_candidate_set mut proposed = fir_lower.range_candidate_set{};
    defer fir_lower.range_candidate_set_free(&proposed);
    fir_lower.report mut why = fir_lower.report{};
    assert(fir_lower.lower_function_with_range_candidates(&e.c.ck, decl, &f,
                                                           &proposed, &why));
    assert(proposed.boundaries.len == 5);
    fir_lower.range_source_audit mut audit = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&audit);
    assert(fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    check_output(&e, decl, &f, "cleanup_damage", false);
    fir_lower.range_source_audit_free(&audit);
    proposed.boundaries.len = 2;
    assert(!fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert(audit.failure.reason == fir_lower.range_audit_fault.boundary);
    assert(audit.failure.key.declaration == 1 && audit.failure.key.expansion == 1);
    assert(!audit.source_complete);
    fir_lower.range_source_audit_free(&audit);
    proposed.boundaries.len = 5;
    fir.range_boundary a = proposed.boundaries.items[2].boundary;
    fir.range_boundary b = proposed.boundaries.items[3].boundary;
    fir.range_boundary c = proposed.boundaries.items[4].boundary;
    u32 entry_block = proposed.boundaries.items[1].boundary.block;
    proposed.boundaries.items[2].boundary.block = entry_block;
    proposed.boundaries.items[3].boundary.block = entry_block;
    proposed.boundaries.items[4].boundary.block = entry_block;
    proposed.boundaries.items[2].boundary.position = 0;
    proposed.boundaries.items[3].boundary.position = 0;
    proposed.boundaries.items[4].boundary.position = 0;
    assert(!fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert(audit.failure.reason == fir_lower.range_audit_fault.boundary);
    fir_lower.range_source_audit_free(&audit);
    proposed.boundaries.items[2].boundary = a;
    proposed.boundaries.items[3].boundary = b;
    proposed.boundaries.items[4].boundary = c;
    fir_lower.range_boundary_candidate_add(&proposed.boundaries,
        fir_lower.range_boundary_candidate{.declaration = 77, .expansion = 88,
            .boundary = fir.range_boundary{.loan = 88,
                .kind = fir.range_boundary_kind.capture,
                .source = diag.loc{.line = 99}}});
    assert(!fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert(audit.failure.reason == fir_lower.range_audit_fault.boundary);
    assert(audit.failure.key.declaration == 77 && audit.failure.key.expansion == 88);
    assert(audit.failure.key.source.line == 99);
    assert(!audit.structural_valid && !audit.source_complete && !audit.ownership_proved);
}

fn multi_exit_cleanup_damage() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[5] source = {
        "fn walk(i32[2] values, bool stop) void {",
        "    for (i32 x : values) {",
        "        if (stop) { break; }",
        "    }",
        "}",
    };
    lower_env.check_lines(&e, source[..], true);
    ast.node* decl = lower_env.decl(&e, "walk");
    fir.func mut f = fir.func{};
    defer fir.func_free(&f);
    fir_lower.range_candidate_set mut proposed = fir_lower.range_candidate_set{};
    defer fir_lower.range_candidate_set_free(&proposed);
    fir_lower.report mut why = fir_lower.report{};
    assert(fir_lower.lower_function_with_range_candidates(&e.c.ck, decl, &f,
                                                           &proposed, &why));
    fir_lower.range_source_audit mut audit = fir_lower.range_source_audit{};
    defer fir_lower.range_source_audit_free(&audit);
    assert(fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert(proposed.boundaries.len == 8);
    check_output(&e, decl, &f, "multi_exit_cleanup_damage", false);
    fir_lower.range_source_audit_free(&audit);
    u64 mut source_body = proposed.boundaries.len;
    u64 mut source_exit = proposed.boundaries.len;
    u64 mut source_outer = proposed.boundaries.len;
    u64 mut target_body = proposed.boundaries.len;
    u64 mut target_exit = proposed.boundaries.len;
    u64 mut target_outer = proposed.boundaries.len;
    u64 mut candidate_at = 0;
    while (candidate_at < proposed.boundaries.len) {
        fir.range_boundary bd = proposed.boundaries.items[candidate_at].boundary;
        if (bd.kind == fir.range_boundary_kind.body_cleanup) {
            if (bd.source.line == 3) { target_body = candidate_at; }
            else { source_body = candidate_at; }
        }
        if (bd.kind == fir.range_boundary_kind.loan_exit) {
            if (bd.source.line == 3) { target_exit = candidate_at; }
            else { source_exit = candidate_at; }
        }
        if (bd.kind == fir.range_boundary_kind.outer_cleanup) {
            if (bd.source.line == 3) { target_outer = candidate_at; }
            else { source_outer = candidate_at; }
        }
        candidate_at += 1;
    }
    assert(source_body < proposed.boundaries.len && target_body < proposed.boundaries.len);
    assert(source_exit < proposed.boundaries.len && target_exit < proposed.boundaries.len);
    assert(source_outer < proposed.boundaries.len && target_outer < proposed.boundaries.len);
    assert(proposed.boundaries.items[source_body].boundary.block
           != proposed.boundaries.items[target_body].boundary.block);
    fir.range_boundary saved_body = proposed.boundaries.items[target_body].boundary;
    fir.range_boundary saved_exit = proposed.boundaries.items[target_exit].boundary;
    fir.range_boundary saved_outer = proposed.boundaries.items[target_outer].boundary;
    proposed.boundaries.items[target_body].boundary =
        proposed.boundaries.items[source_body].boundary;
    proposed.boundaries.items[target_exit].boundary =
        proposed.boundaries.items[source_exit].boundary;
    proposed.boundaries.items[target_outer].boundary =
        proposed.boundaries.items[source_outer].boundary;
    proposed.boundaries.items[target_body].boundary.order = 10;
    proposed.boundaries.items[target_exit].boundary.order = 11;
    proposed.boundaries.items[target_outer].boundary.order = 12;
    assert(!fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert(audit.failure.reason == fir_lower.range_audit_fault.boundary);
    assert(audit.failure.key.declaration == 1 && audit.failure.key.expansion == 1);
    assert(!audit.source_complete && !f.range_source_complete);
    fir_lower.range_source_audit_free(&audit);
    proposed.boundaries.items[target_body].boundary = saved_body;
    proposed.boundaries.items[target_exit].boundary = saved_exit;
    proposed.boundaries.items[target_outer].boundary = saved_outer;
    u64 mut read_at = 0;
    u64 mut write_at = 0;
    u32 mut removed = 0;
    while (read_at < proposed.boundaries.len) {
        fir_lower.range_boundary_candidate item = proposed.boundaries.items[read_at];
        bool cleanup = item.boundary.kind == fir.range_boundary_kind.body_cleanup
            || item.boundary.kind == fir.range_boundary_kind.loan_exit
            || item.boundary.kind == fir.range_boundary_kind.outer_cleanup;
        if (cleanup && item.boundary.source.line == 3) {
            removed += 1;
        } else {
            proposed.boundaries.items[write_at] = item;
            write_at += 1;
        }
        read_at += 1;
    }
    assert(removed == 3 && write_at == 5);
    proposed.boundaries.len = write_at;
    assert(!fir_lower.audit_produced_ranges(decl, &f, &proposed, &audit));
    assert(audit.failure.reason == fir_lower.range_audit_fault.boundary);
    assert(audit.failure.key.declaration == 1 && audit.failure.key.expansion == 1);
    assert(!audit.source_complete && !f.range_source_complete);
}

