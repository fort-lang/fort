//! run
//! flags: -I ../../src/fort -I support -I ../../src
//! stdout:
//| paths ok
//| decoding ok
//| refusals ok
//| generation ok
//| round trip ok
//| sweep ok
//| ok
import lsp.uri;
import lsp_env;
import std.strbuf;

// The file URIs of src/lsp/uri.ft: what path_of reads, what it refuses, what
// of_path writes, and the round trip that holds the two together.

// The path `uri` names, which must be one this module reads.
fn path_of(string u, strbuf.str_buf mut* b) string {
    if (!uri.path_of(u, b)) {
        println("case: ", u);
        println("  refused, and a path was expected");
    }
    assert(uri.path_of(u, b));
    return strbuf.view(b);
}

// `u` names `want`.
fn reads_as(string u, string want) void {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    lsp_env.check(path_of(u, &b), want, u);
}

// `u` is no file URI this server reads, and the buffer is empty afterwards.
fn refused(string u) void {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "leftovers");
    if (uri.path_of(u, &b)) {
        println("case: ", u);
        println("  read as ", strbuf.view(&b), ", and a refusal was expected");
    }
    assert(!uri.path_of(u, &b));
    lsp_env.check(strbuf.view(&b), "", u);
}

// `path` is written as `want`.
fn writes_as(string path, string want) void {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    if (!uri.of_path(path, &b)) {
        println("case: ", path);
        println("  refused, and a URI was expected");
    }
    assert(uri.of_path(path, &b));
    lsp_env.check(strbuf.view(&b), want, path);
}

// `path` has no file URI, and the buffer is empty afterwards.
fn no_uri(string path) void {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "leftovers");
    assert(!uri.of_path(path, &b));
    lsp_env.check(strbuf.view(&b), "", path);
}

// ---- the shapes a client sends ---------------------------------------------------

fn the_empty_authority_is_the_form_every_client_sends() void {
    reads_as("file:///a.ft", "/a.ft");
    reads_as("file:///home/user/src/main.ft", "/home/user/src/main.ft");
    reads_as("file:///", "/");
}

fn localhost_is_the_one_authority_beside_the_empty_one() void {
    reads_as("file://localhost/a.ft", "/a.ft");
    reads_as("file://LocalHost/a.ft", "/a.ft");
}

fn the_scheme_is_compared_without_case() void {
    // RFC 3986 3.1: a scheme is case-insensitive.
    reads_as("FILE:///a.ft", "/a.ft");
    reads_as("File:///a.ft", "/a.ft");
}

fn the_form_without_an_authority_is_read_as_well() void {
    // RFC 8089 gives file URIs this minimal form.
    reads_as("file:/a.ft", "/a.ft");
}

fn a_path_of_one_byte_is_a_path() void {
    reads_as("file:///x", "/x");
}

// ---- percent-encoding ------------------------------------------------------------

fn an_escape_is_decoded_in_either_case() void {
    reads_as("file:///a%20b", "/a b");
    reads_as("file:///a%2Fb", "/a/b");
    reads_as("file:///a%2fb", "/a/b");
    reads_as("file:///%C3%A9", "/\xC3\xA9");
    reads_as("file:///%c3%a9", "/\xC3\xA9");
}

fn an_escape_may_stand_at_either_end_of_the_path() void {
    reads_as("file:///%20", "/ ");
    reads_as("file:///a%20", "/a ");
}

fn an_escape_of_a_byte_that_needs_none_is_still_decoded() void {
    // RFC 3986 2.3 calls it equivalent to the byte, so a client that escapes
    // more than it must still names the same file.
    reads_as("file:///%61.ft", "/a.ft");
    // A decoded escape may be a separator. No POSIX file name holds a `/`, so
    // a client cannot have meant a literal one, and the decoded path names the
    // file the client named.
    reads_as("file:///%2Fa", "//a");
}

fn a_byte_above_ascii_is_carried_through() void {
    // A URI is bytes to this module, so an unescaped UTF-8 byte passes.
    reads_as("file:///\xC3\xA9.ft", "/\xC3\xA9.ft");
}

// ---- what is refused -------------------------------------------------------------

fn a_uri_of_another_scheme_is_refused() void {
    refused("untitled:1");
    refused("http://example.com/a.ft");
    refused("filex:///a.ft");
    refused("f:///a.ft");
}

fn text_that_is_no_uri_is_refused() void {
    refused("");
    refused("/a.ft");
    refused("a.ft");
    refused("file");
}

fn an_authority_that_is_not_local_is_refused() void {
    // The file stands on another machine and this server cannot open it, so
    // answering a path for it would open the wrong file.
    refused("file://example.com/a.ft");
    refused("file://127.0.0.1/a.ft");
    refused("file://localhost.example.com/a.ft");
}

fn a_uri_without_an_absolute_path_is_refused() void {
    refused("file:");
    refused("file://");
    refused("file:a.ft");
    refused("file://localhost");
}

fn a_broken_escape_is_refused() void {
    refused("file:///a%");
    refused("file:///a%2");
    refused("file:///a%zz");
    refused("file:///a%2z");
    refused("file:///a%g0");
    refused("file:///%");
}

fn an_escaped_nul_is_refused() void {
    // A NUL ends a path at the C boundary, so a URI carrying one would name a
    // shorter file than it spells.
    refused("file:///a%00b");
    refused("file:///%00");
}

fn a_query_or_a_fragment_is_refused() void {
    refused("file:///a.ft?v=1");
    refused("file:///a.ft#L3");
    refused("file:///a.ft#");
    refused("file:///?");
}

// ---- what of_path writes ---------------------------------------------------------

fn a_path_that_needs_no_escape_is_written_as_it_stands() void {
    writes_as("/a.ft", "file:///a.ft");
    writes_as("/home/user/src/main.ft", "file:///home/user/src/main.ft");
    writes_as("/", "file:///");
    writes_as("/a-b_c.d~e/F9", "file:///a-b_c.d~e/F9");
}

fn every_byte_outside_the_unreserved_set_is_escaped() void {
    writes_as("/a b", "file:///a%20b");
    writes_as("/a:b", "file:///a%3Ab");
    writes_as("/a%b", "file:///a%25b");
    writes_as("/a#b", "file:///a%23b");
    writes_as("/a?b", "file:///a%3Fb");
    writes_as("/\xC3\xA9", "file:///%C3%A9");
    writes_as("/a+b,c;d=e", "file:///a%2Bb%2Cc%3Bd%3De");
}

fn the_hex_of_an_escape_is_uppercase() void {
    // RFC 3986 2.1 prefers uppercase, and a client that compares two URIs
    // byte for byte then agrees with the one this module writes.
    writes_as("/\xFF", "file:///%FF");
    writes_as("/\x0a", "file:///%0A");
    writes_as("/\x7f", "file:///%7F");
}

fn a_relative_path_has_no_file_uri() void {
    no_uri("a.ft");
    no_uri("");
    no_uri("./a.ft");
}

// ---- the round trip --------------------------------------------------------------

fn a_uri_this_module_writes_is_one_it_reads() void {
    string[9] paths = string[9]{"/a.ft", "/", "/a b/c d.ft", "/\xC3\xA9/\xF0\x9D\x84\x9E",
                                "/a%b", "/a#b?c", "/x/y/z/very/deep/path/main.ft",
                                "/\x01\x02\x03", "/a~b-c.d_e"};
    strbuf.str_buf mut written = strbuf.create();
    defer strbuf.free(&written);
    strbuf.str_buf mut back = strbuf.create();
    defer strbuf.free(&back);
    u64 mut i = 0;
    while (i < 9) {
        assert(uri.of_path(paths[i], &written));
        lsp_env.check(path_of(strbuf.view(&written), &back), paths[i], paths[i]);
        i += 1;
    }
}

fn a_path_this_module_reads_is_one_it_writes() void {
    // The other direction holds for a URI in the form of_path writes: an
    // empty authority and every escape uppercase. It does not hold for
    // `file://localhost/x`, which names the same file in another spelling.
    string[4] uris = string[4]{"file:///a.ft", "file:///a%20b", "file:///%C3%A9",
                               "file:///deep/path/main.ft"};
    strbuf.str_buf mut path = strbuf.create();
    defer strbuf.free(&path);
    strbuf.str_buf mut again = strbuf.create();
    defer strbuf.free(&again);
    u64 mut i = 0;
    while (i < 4) {
        assert(uri.path_of(uris[i], &path));
        assert(uri.of_path(strbuf.view(&path), &again));
        lsp_env.check(strbuf.view(&again), uris[i], uris[i]);
        i += 1;
    }
    // The two spellings of one file answer one path.
    assert(uri.path_of("file://localhost/a.ft", &path));
    lsp_env.check(strbuf.view(&path), "/a.ft", "localhost");
}

fn a_buffer_is_reused_between_calls() void {
    // Both directions empty the buffer first, so a caller keeps one buffer for
    // every message it handles.
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    lsp_env.check(path_of("file:///first.ft", &b), "/first.ft", "first");
    lsp_env.check(path_of("file:///second/longer/path.ft", &b), "/second/longer/path.ft", "second");
    lsp_env.check(path_of("file:///x", &b), "/x", "third");
    assert(uri.of_path("/y", &b));
    lsp_env.check(strbuf.view(&b), "file:///y", "fourth");
}


// ---- the sweep over every byte ---------------------------------------------------

// The hex digit of a nibble, written here rather than read from the module
// under test, so the expected text of an escape is the test's own.
fn hex_digit(u64 v) char {
    if (v < 10) {
        return cast(cast('0', u64) + v, char);
    }
    return cast(cast('A', u64) + v - 10, char);
}

// Whether the byte needs no escape (RFC 3986 2.3), counted here again: the
// module's own rule is what this holds against.
fn oracle_unreserved(u64 b) bool {
    if (b >= cast('a', u64) && b <= cast('z', u64)) {
        return true;
    }
    if (b >= cast('A', u64) && b <= cast('Z', u64)) {
        return true;
    }
    if (b >= cast('0', u64) && b <= cast('9', u64)) {
        return true;
    }
    return b == cast('-', u64) || b == cast('.', u64) || b == cast('_', u64)
        || b == cast('~', u64);
}

fn every_byte_of_a_path_is_written_as_the_rule_says() void {
    // All 255 bytes a path may hold -- a NUL ends a path at the C boundary and
    // is not one of them -- through of_path, against the rule written again
    // here. The path is `/x<byte>y`, so the byte stands between two that need
    // no escape and an escape that ran on would show.
    strbuf.str_buf mut path = strbuf.create();
    defer strbuf.free(&path);
    strbuf.str_buf mut want = strbuf.create();
    defer strbuf.free(&want);
    strbuf.str_buf mut got = strbuf.create();
    defer strbuf.free(&got);
    u64 mut b = 1;
    while (b < 256) {
        strbuf.clear(&path);
        strbuf.append(&path, "/x");
        strbuf.push_byte(&path, cast(b, u8));
        strbuf.append(&path, "y");
        strbuf.clear(&want);
        strbuf.append(&want, "file:///x");
        if (oracle_unreserved(b) || b == cast('/', u64)) {
            strbuf.push_byte(&want, cast(b, u8));
        } else {
            strbuf.push(&want, '%');
            strbuf.push(&want, hex_digit(b >> 4));
            strbuf.push(&want, hex_digit(b & 15));
        }
        strbuf.append(&want, "y");
        assert(uri.of_path(strbuf.view(&path), &got));
        lsp_env.check(strbuf.view(&got), strbuf.view(&want), "the byte of a path");
        b += 1;
    }
}

fn every_byte_of_a_path_comes_back_through_the_round_trip() void {
    strbuf.str_buf mut path = strbuf.create();
    defer strbuf.free(&path);
    strbuf.str_buf mut written = strbuf.create();
    defer strbuf.free(&written);
    strbuf.str_buf mut back = strbuf.create();
    defer strbuf.free(&back);
    u64 mut b = 1;
    while (b < 256) {
        strbuf.clear(&path);
        strbuf.append(&path, "/x");
        strbuf.push_byte(&path, cast(b, u8));
        strbuf.append(&path, "y");
        assert(uri.of_path(strbuf.view(&path), &written));
        assert(uri.path_of(strbuf.view(&written), &back));
        lsp_env.check(strbuf.view(&back), strbuf.view(&path), "the round trip of a byte");
        b += 1;
    }
}

fn every_escape_but_the_nul_is_decoded() void {
    // `%XX` of every byte but 0, in both cases of hex, against the byte itself.
    strbuf.str_buf mut written = strbuf.create();
    defer strbuf.free(&written);
    strbuf.str_buf mut want = strbuf.create();
    defer strbuf.free(&want);
    strbuf.str_buf mut got = strbuf.create();
    defer strbuf.free(&got);
    u64 mut b = 1;
    while (b < 256) {
        strbuf.clear(&written);
        strbuf.append(&written, "file:///x%");
        strbuf.push(&written, hex_digit(b >> 4));
        strbuf.push(&written, hex_digit(b & 15));
        strbuf.append(&written, "y");
        strbuf.clear(&want);
        strbuf.append(&want, "/x");
        strbuf.push_byte(&want, cast(b, u8));
        strbuf.append(&want, "y");
        assert(uri.path_of(strbuf.view(&written), &got));
        lsp_env.check(strbuf.view(&got), strbuf.view(&want), "an escape of a byte");
        b += 1;
    }
    // The escape of a NUL is the one this module refuses.
    assert(!uri.path_of("file:///x%00y", &got));
}

fn an_escape_is_read_in_either_case_for_every_byte() void {
    strbuf.str_buf mut upper = strbuf.create();
    defer strbuf.free(&upper);
    strbuf.str_buf mut lower = strbuf.create();
    defer strbuf.free(&lower);
    strbuf.str_buf mut one = strbuf.create();
    defer strbuf.free(&one);
    strbuf.str_buf mut other = strbuf.create();
    defer strbuf.free(&other);
    u64 mut b = 1;
    while (b < 256) {
        strbuf.clear(&upper);
        strbuf.append(&upper, "file:///");
        strbuf.push(&upper, '%');
        strbuf.push(&upper, hex_digit(b >> 4));
        strbuf.push(&upper, hex_digit(b & 15));
        strbuf.clear(&lower);
        strbuf.append(&lower, "file:///");
        strbuf.push(&lower, '%');
        strbuf.push(&lower, lower_hex(hex_digit(b >> 4)));
        strbuf.push(&lower, lower_hex(hex_digit(b & 15)));
        assert(uri.path_of(strbuf.view(&upper), &one));
        assert(uri.path_of(strbuf.view(&lower), &other));
        lsp_env.check(strbuf.view(&other), strbuf.view(&one), "an escape in lowercase hex");
        b += 1;
    }
}

// The lowercase of a hex digit.
fn lower_hex(char c) char {
    if (c >= 'A' && c <= 'F') {
        return cast(cast(c, u64) + 32, char);
    }
    return c;
}

fn a_path_of_many_segments_survives_the_round_trip() void {
    // A path as long as a real one, with a segment of every shape: a space, a
    // byte above ASCII, an escape-looking run and a dot.
    strbuf.str_buf mut path = strbuf.create();
    defer strbuf.free(&path);
    strbuf.str_buf mut written = strbuf.create();
    defer strbuf.free(&written);
    strbuf.str_buf mut back = strbuf.create();
    defer strbuf.free(&back);
    u64 mut i = 0;
    while (i < 20) {
        strbuf.append(&path, "/dir ");
        strbuf.append_u64(&path, i);
        strbuf.append(&path, ".\xC3\xA9%20~-_");
        i += 1;
    }
    strbuf.append(&path, "/main.ft");
    assert(uri.of_path(strbuf.view(&path), &written));
    assert(uri.path_of(strbuf.view(&written), &back));
    lsp_env.check(strbuf.view(&back), strbuf.view(&path), "a long path");
    // Nothing of the URI needs a byte outside the ASCII of RFC 3986.
    u64 mut k = 0;
    string text = strbuf.view(&written);
    while (k < text.len) {
        assert(cast(text[k], u64) < 128);
        k += 1;
    }
}

fn main() i32 {
    the_empty_authority_is_the_form_every_client_sends();
    localhost_is_the_one_authority_beside_the_empty_one();
    the_scheme_is_compared_without_case();
    the_form_without_an_authority_is_read_as_well();
    a_path_of_one_byte_is_a_path();
    println("paths ok");
    an_escape_is_decoded_in_either_case();
    an_escape_may_stand_at_either_end_of_the_path();
    an_escape_of_a_byte_that_needs_none_is_still_decoded();
    a_byte_above_ascii_is_carried_through();
    println("decoding ok");
    a_uri_of_another_scheme_is_refused();
    text_that_is_no_uri_is_refused();
    an_authority_that_is_not_local_is_refused();
    a_uri_without_an_absolute_path_is_refused();
    a_broken_escape_is_refused();
    an_escaped_nul_is_refused();
    a_query_or_a_fragment_is_refused();
    println("refusals ok");
    a_path_that_needs_no_escape_is_written_as_it_stands();
    every_byte_outside_the_unreserved_set_is_escaped();
    the_hex_of_an_escape_is_uppercase();
    a_relative_path_has_no_file_uri();
    println("generation ok");
    a_uri_this_module_writes_is_one_it_reads();
    a_path_this_module_reads_is_one_it_writes();
    a_buffer_is_reused_between_calls();
    println("round trip ok");
    every_byte_of_a_path_is_written_as_the_rule_says();
    every_byte_of_a_path_comes_back_through_the_round_trip();
    every_escape_but_the_nul_is_decoded();
    an_escape_is_read_in_either_case_for_every_byte();
    a_path_of_many_segments_survives_the_round_trip();
    println("sweep ok");
    println("ok");
    return 0;
}
