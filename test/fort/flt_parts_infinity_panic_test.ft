//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: flt.flt_parts: an infinity or a NaN is not a constant
//! stdout:
//| 1
//| 0
/// A constant is finite, so flt_parts never reads the bits of an infinity. The bits of
/// +infinity break that precondition, so the call panics.
import flt;

fn main() i32 {
    bool mut neg = false;
    u64 mut m = 0;
    i64 mut e = 0;
    flt.flt_parts(flt.f64_bits(1, 0), &neg, &m, &e);
    println(m >> 52);
    println(e + 52);
    flt.flt_parts(0x7FF0000000000000, &neg, &m, &e);
    return 0;
}
