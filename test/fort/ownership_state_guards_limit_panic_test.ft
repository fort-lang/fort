//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: ownership_state.guards: capacity overflow
//! stdout:
//| 0
/// append_guards refuses to add an entry after U64_MAX entries, because the count would
/// pass u64. The test sets guards_len to U64_MAX, and the call panics.
import ownership_api;
import ownership_state;

fn main() i32 {
    ownership_state.state mut s = ownership_state.empty();
    defer ownership_state.free(&s);
    println(s.guards_len);
    s.guards_len = ownership_state.U64_MAX;
    ownership_state.append_guards(&s, ownership_api.guard_fact{});
    return 0;
}
