//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| boundary G09.1
//| boundary G09.2
//| boundary G09.3
//| boundary G11.3
//| boundary G12.4
//| boundary G13.1
//| boundary G13.2
//| boundary G13.3
//| boundary G13.4
//| direct-call guards ok
/// Checks guarded call cases: branches on captured formals and mixed abort and return outcomes.
import ownership_api;
import ownership_call_bodies;
import ownership_calls_env;
import ownership_summary_body;
import ownership_summary_model;

string[2] NULLABLE = {
    "fn callee(i32* p, bool choose) i32* { if (choose) { return p; } return null; }",
    "fn caller(i32* p) i32 { i32* q = callee(p, true); if (q != null) { return *q; } return 0; }",
};

string[2] UNCHECKED = {
    "fn callee(i32* p, bool choose) i32* { if (choose) { return p; } return null; }",
    "fn caller(i32* p, bool choose) i32 { return *callee(p, choose); }",
};

// The same choice with the null return first.
string[2] UNCHECKED_SWAPPED = {
    "fn callee(i32* p, bool choose) i32* { if (choose) { return null; } return p; }",
    "fn caller(i32* p, bool choose) i32 { return *callee(p, choose); }",
};

string[6] CHECKED = {
    "fn callee(i32* p, bool choose) i32* { if (choose) { return p; } return null; }",
    "fn caller(i32* p, bool choose) i32 {",
    "    i32* q = callee(p, choose);",
    "    if (q != null) { return *q; }",
    "    return 0;",
    "}",
};

string[2] MAYBE_ABORT = {
    "fn callee(bool fail) void { if (fail) { panic(\"stop\"); } }",
    "fn caller(i32 mut* own p, bool fail) void { callee(fail); }",
};

string[2] RELEASES = {
    "fn callee(bool fail) void { if (fail) { panic(\"stop\"); } }",
    "fn caller(i32 mut* own p, bool fail) void { callee(fail); del(p); }",
};

string[2] ALWAYS = {
    "fn callee(bool fail) void { if (fail) { panic(\"stop\"); } }",
    "fn caller(i32 mut* own p) void { callee(true); }",
};

string[2] NEVER = {
    "fn callee(bool fail) void { if (fail) { panic(\"stop\"); } }",
    "fn caller(i32 mut* own p) void { callee(false); }",
};

string[2] COPIED = {
    "fn callee(bool fail) void { if (fail) { panic(\"stop\"); } }",
    "fn caller(i32 mut* own p, bool fail) void { bool f = fail; callee(f); }",
};

string[2] COMPUTED = {
    "fn callee(bool fail) void { if (fail) { panic(\"stop\"); } }",
    "fn caller(i32 mut* own p, i32 n) void { callee(n > 0); }",
};

string[2] CORRELATED = {
    "fn callee(bool fail) void { if (fail) { panic(\"stop\"); } }",
    "fn caller(i32 mut* own p, bool fail) void { callee(fail); if (fail) { return; } del(p); }",
};

string[2] TWICE = {
    "fn callee(bool fail) void { if (fail) { panic(\"stop\"); } }",
    "fn caller(i32 mut* own p, bool fail) void { callee(fail); callee(fail); del(p); }",
};

string[2] SAME_RESULT = {
    "fn callee(i32* p, bool b) i32* { if (b) { return p; } return p; }",
    "fn caller(i32* p, bool b) i32* { return callee(p, b); }",
};

string[2] OTHER_RESULT = {
    "fn callee(i32* p, i32* q, bool b) i32* { if (b) { return p; } return q; }",
    "fn caller(i32* p, i32* q, bool b) i32* { return callee(p, q, b); }",
};

// The call result goes straight to `use`, so no copy of it needs its origin. Only the join of
// the two results in flow keeps `caller` from one requirement on `p` (D17.18).
string[3] USED_RESULT = {
    "fn callee(i32* p, i32* q, bool b) i32* { if (b) { return p; } return q; }",
    "fn use(i32* p) i32 { return *p; }",
    "fn caller(i32* p, i32* q, bool b) i32 { return use(callee(p, q, b)); }",
};

// Both cases return a field of `s`: one source with two windows.
string[3] OTHER_WINDOW = {
    "struct pair { i32 a; i32 b; }",
    "fn callee(pair* s, bool b) i32* { if (b) { return &s->a; } return &s->b; }",
    "fn caller(pair* s, bool b) i32* { return callee(s, b); }",
};

// The caller tests `x` before and after the call. The join of the two covered cases keeps the
// atom of `x`, so the second test has one branch and `q` is released.
string[5] KEPT_ATOM = {
    "fn callee(i32* p, bool b) i32* { if (b) { return p; } return p; }",
    "fn caller(i32 mut* own q, i32* p, bool x, bool b) void {",
    "    if (x) { i32* r = callee(p, b); if (x) { del(q); return; } return; }",
    "    del(q);",
    "}",
};

// The normal cases need `b == 1, c == 1` or `b == 0`. The value pair `b == 1, c == 0` aborts.
string[3] PARTIAL_RESULT = {
    "fn callee(i32* p, bool b, bool c) i32* {",
    "    if (b) { if (c) { return p; } panic(\"x\"); } return p; }",
    "fn caller(i32* p, bool b, bool c) i32* { return callee(p, b, c); }",
};

// `g` stores `q` in one normal case only. The join of its cases stands for each value of `b`,
// but the store does not, so `h` cannot export it (D17.18). `top` passes false: `v` keeps `a`
// and `top` reads it after `del(a)`, so `top` must not pass.
string[3] ONE_CASE_STORE = {
    "fn g(i32* mut* pp, i32* q, bool b) void { if (b) { *pp = q; return; } }",
    "fn h(i32* mut* pp, i32* q, bool b) void { g(pp, q, b); }",
    "fn top(i32 mut* own a, i32* r) i32 { i32* mut v = a; h(&v, r, false); del(a); return *v; }",
};

// Both cases return `q`, so the call result has one value. The store still runs in one case.
string[4] ONE_CASE_RESULT = {
    "fn g(i32* mut* pp, i32* q, bool b) i32* { if (b) { *pp = q; return q; } return q; }",
    "fn h(i32* mut* pp, i32* q, bool b) i32* { return g(pp, q, b); }",
    "fn top(i32 mut* own a, i32* r) i32 {",
    "    i32* mut v = a; i32* w = h(&v, r, false); del(a); return *v; }",
};

// No guard names the loaded condition, so each case of `g` runs at the call in `h`.
string[4] LOADED_STORE = {
    "fn g(i32* mut* pp, i32* q, i32* sel) void { if (*sel == 0) { *pp = q; return; } }",
    "fn h(i32* mut* pp, i32* q, i32* sel) void { g(pp, q, sel); }",
    "fn top(i32 mut* own a, i32* r, i32* s) i32 {",
    "    i32* mut v = a; h(&v, r, s); del(a); return *v; }",
};

string[4] LOADED_RESULT = {
    "fn g(i32* mut* pp, i32* q, i32* sel) i32* { if (*sel == 0) { *pp = q; return q; } return q; }",
    "fn h(i32* mut* pp, i32* q, i32* sel) i32* { return g(pp, q, sel); }",
    "fn top(i32 mut* own a, i32* r, i32* s) i32 {",
    "    i32* mut v = a; i32* w = h(&v, r, s); del(a); return *v; }",
};

// Only the abort case stores. The export of `h` would reach its normal exit.
string[3] ABORT_STORE = {
    "fn g(i32* mut* pp, i32* q, bool b) void { if (b) { *pp = q; panic(\"x\"); } }",
    "fn h(i32* mut* pp, i32* q, bool b) void { g(pp, q, b); }",
    "fn top(i32 mut* own a, i32* r) i32 { i32* mut v = a; h(&v, r, false); del(a); return *v; }",
};

// Each normal case stores once, but two stores of two values: `top` gets `y`, not `x`.
string[4] OTHER_STORE = {
    "fn g(i32* mut* pp, i32* q, i32* r, bool b) void { if (b) { *pp = q; return; } *pp = r; }",
    "fn h(i32* mut* pp, i32* q, i32* r, bool b) void { g(pp, q, r, b); }",
    "fn top(i32 mut* own a, i32* x) i32 { i32 mut* own y = new(i32); i32* mut v = a;",
    "    h(&v, x, y, false); del(y); i32 z = *v; del(a); return z; }",
};

// One store before the branch: both normal cases do it, so `h` exports it once. `top` then
// reads `t` after `del(t)`, and the export makes that a definite error.
string[4] SHARED_STORE = {
    "fn g(i32* mut* pp, i32* q, bool b) void { *pp = q; if (b) { return; } }",
    "fn h(i32* mut* pp, i32* q, bool b) void { g(pp, q, b); }",
    "fn top(i32 mut* own a, bool b) i32 { i32 mut* own t = new(i32); i32* mut v = a;",
    "    h(&v, t, b); del(t); i32 z = *v; del(a); return z; }",
};

// The abort runs before the store or after it. Each abort store list is a prefix of the
// normal one, so `h` exports the store.
string[4] ABORT_BEFORE = {
    "fn g(i32* mut* pp, i32* q, bool b) void { if (b) { panic(\"x\"); } *pp = q; }",
    "fn h(i32* mut* pp, i32* q, bool b) void { g(pp, q, b); }",
    "fn top(i32 mut* own a, bool b) i32 { i32 mut* own t = new(i32); i32* mut v = a;",
    "    h(&v, t, b); del(t); i32 z = *v; del(a); return z; }",
};

string[4] ABORT_AFTER = {
    "fn g(i32* mut* pp, i32* q, bool b) void { *pp = q; if (b) { panic(\"x\"); } }",
    "fn h(i32* mut* pp, i32* q, bool b) void { g(pp, q, b); }",
    "fn top(i32 mut* own a, bool b) i32 { i32 mut* own t = new(i32); i32* mut v = a;",
    "    h(&v, t, b); del(t); i32 z = *v; del(a); return z; }",
};

// Each case of `second` returns another formal. An exact argument refutes one case, so the
// call result designates the source of one argument (D17.18). `top` passes two different
// views; `false` selects `q` and `true` selects `p`.
string[3] SECOND_A_FALSE = {
    "fn second(i32* p, i32* q, bool b) i32* { if (b) { return p; } return q; }",
    "fn top(i32 mut* own a, i32* r) i32 {",
    "    i32* v = second(r, a, false); del(a); return *v; }",
};

string[3] SECOND_A_TRUE = {
    "fn second(i32* p, i32* q, bool b) i32* { if (b) { return p; } return q; }",
    "fn top(i32 mut* own a, i32* r) i32 {",
    "    i32* v = second(a, r, true); del(a); return *v; }",
};

string[3] SECOND_R_FALSE = {
    "fn second(i32* p, i32* q, bool b) i32* { if (b) { return p; } return q; }",
    "fn top(i32 mut* own a, i32* r) i32 {",
    "    i32* v = second(a, r, false); del(a); return *v; }",
};

string[3] SECOND_R_TRUE = {
    "fn second(i32* p, i32* q, bool b) i32* { if (b) { return p; } return q; }",
    "fn top(i32 mut* own a, i32* r) i32 {",
    "    i32* v = second(r, a, true); del(a); return *v; }",
};

// A symbolic choice keeps both cases possible. The result has two origins, so no proof
// exists and no path is a witness.
string[3] SECOND_SYMBOLIC = {
    "fn second(i32* p, i32* q, bool b) i32* { if (b) { return p; } return q; }",
    "fn top(i32 mut* own a, i32* r, bool b) i32 {",
    "    i32* v = second(r, a, b); del(a); return *v; }",
};

// Three cases with guards of two atoms and one atom: `b == 1, c == 1` returns `p`,
// `b == 1, c == 0` returns `q`, and `b == 0` returns `p`.
string[4] PICK_A = {
    "fn pick(i32* p, i32* q, bool b, bool c) i32* {",
    "    if (b) { if (c) { return p; } return q; } return p; }",
    "fn top(i32 mut* own a, i32* r) i32 {",
    "    i32* v = pick(r, a, true, false); del(a); return *v; }",
};

// `false` refutes both cases of `b == 1`. The symbolic `c` decides nothing more.
string[4] PICK_R = {
    "fn pick(i32* p, i32* q, bool b, bool c) i32* {",
    "    if (b) { if (c) { return p; } return q; } return p; }",
    "fn top(i32 mut* own a, i32* r, bool c) i32 {",
    "    i32* v = pick(r, a, false, c); del(a); return *v; }",
};

// `true` keeps both cases of `b == 1`, and they return two formals.
string[4] PICK_OPEN = {
    "fn pick(i32* p, i32* q, bool b, bool c) i32* {",
    "    if (b) { if (c) { return p; } return q; } return p; }",
    "fn top(i32 mut* own a, i32* r, bool c) i32 {",
    "    i32* v = pick(r, a, true, c); del(a); return *v; }",
};

// `false` refutes the only normal case of `must`, so the call aborts and the read after it
// cannot run. `true` selects the normal case, which returns `a`.
string[3] MUST_LIVE = {
    "fn must(i32* p, bool ok) i32* { if (ok) { return p; } panic(\"no\"); }",
    "fn top(i32* r) i32 {",
    "    i32* v = must(r, false); return *v; }",
};

string[3] MUST_RELEASED = {
    "fn must(i32* p, bool ok) i32* { if (ok) { return p; } panic(\"no\"); }",
    "fn top(i32 mut* own a) i32 {",
    "    i32* v = must(a, false); del(a); return *v; }",
};

string[3] MUST_TRUE = {
    "fn must(i32* p, bool ok) i32* { if (ok) { return p; } panic(\"no\"); }",
    "fn top(i32 mut* own a) i32 {",
    "    i32* v = must(a, true); del(a); return *v; }",
};

// `false` refutes the normal case. No capture decides `z`, so flow keeps the call unresolved
// and its result unknown.
string[4] MUST_UNBOUND = {
    "fn must(i32* p, bool ok, bool z) i32* {",
    "    if (ok) { return p; } if (z) { panic(\"a\"); } panic(\"b\"); }",
    "fn top(i32 mut* own a, i32 n) i32 {",
    "    i32* v = must(a, false, n > 0); del(a); return *v; }",
};

// Both cases return `q`. `refuted_origin` refutes each guard for `false`.
string[3] SAME_FORMAL = {
    "fn same2(i32* p, i32* q, bool b) i32* { if (b) { return q; } return q; }",
    "fn top(i32 mut* own a, i32* r) i32 {",
    "    i32* v = same2(r, a, false); del(a); return *v; }",
};

string[6] BRANCH_LOAD = {
    "struct owner_box { i32 mut* own item; i32 tag; }",
    "fn callee(owner_box mut* a, owner_box* b, bool read) i32 {",
    "    del(a->item);",
    "    if (read) { return *b->item; }",
    "    return 0;",
    "}",
};

string[2] MERGED = {
    "fn callee(bool fail) void { if (fail) { panic(\"stop\"); } }",
    "fn caller(i32 mut* own p, bool fail) void { callee(fail); if (fail) { } else { del(p); } }",
};

string[3] WRAPPED = {
    "fn inner(bool fail) void { if (fail) { panic(\"stop\"); } }",
    "fn callee(bool fail) void { inner(fail); }",
    "fn caller(i32 mut* own p, bool fail) void { callee(fail); }",
};

string[3] WRAPPED_RELEASE = {
    "fn inner(bool fail) void { if (fail) { panic(\"stop\"); } }",
    "fn callee(bool fail) void { inner(fail); }",
    "fn caller(i32 mut* own p, bool fail) void { callee(fail); del(p); }",
};

// `clear` stores false through its pointer. The caller value 1 of `fail` is then stale.
string[3] STORED_BY_CALL = {
    "fn callee(bool fail) void { if (fail) { panic(\"stop\"); } }",
    "fn clear(bool mut* b) void { *b = false; }",
    "fn caller(i32 mut* own p) void { bool mut fail = true; clear(&fail); callee(fail); }",
};

string[3] STORED_HERE = {
    "fn callee(bool fail) void { if (fail) { panic(\"stop\"); } }",
    "fn caller(i32 mut* own p) void { bool mut fail = true; bool mut* q = &fail; *q = false;",
    "    callee(fail); }",
};

// Only the return case of the call reaches the read of the released view.
string[3] STORED_THEN_READ = {
    "fn callee(bool fail) void { if (fail) { panic(\"stop\"); } }",
    "fn caller(i32 mut* own p) i32 { i32* v = p; del(p); bool mut fail = true;",
    "    bool mut* q = &fail; *q = false; callee(fail); return *v; }",
};

// The branch proves `fail == 1`, and then `clear` stores false into the formal.
string[4] STORED_FORMAL = {
    "fn callee(bool fail) void { if (fail) { panic(\"stop\"); } }",
    "fn clear(bool mut* b) void { *b = false; }",
    "fn caller(i32 mut* own p, bool mut fail) i32 { if (fail) { clear(&fail); callee(fail);",
    "    return 0; } del(p); return 1; }",
};

// The callee stores false into its own formal before it tests that formal.
string[3] ADDRESSED_FORMAL = {
    "fn callee(bool mut fail) void { bool mut* q = &fail; *q = false;",
    "    if (fail) { panic(\"stop\"); } }",
    "fn caller(i32 mut* own p) void { callee(true); }",
};

// A cast to the same type keeps the captured formal value.
string[2] CAST_FORMAL = {
    "fn callee(bool fail) void { if (fail) { panic(\"stop\"); } }",
    "fn caller(i32 mut* own p, bool fail) void { callee(cast(fail, bool)); del(p); }",
};

// The release path returns. The other path ends at the call unless the call can return.
string[2] REFUTED = {
    "fn callee(bool fail) void { if (fail) { panic(\"stop\"); } }",
    "fn caller(i32 mut* own p, bool c) void { if (c) { del(p); return; } callee(false); }",
};

// A loop gives its header a back edge. The extractor splits no path, so it refuses the body.
string[2] LOOP = {
    "fn callee(i32 mut* own p, i32 n) void {",
    "    i32 mut i = 0; while (i < n) { i += 1; } del(p); }",
};

fn bodies(ownership_call_bodies.bodies mut* b, string@ text, string@ names) void {
    ownership_call_bodies.open(b, text, names);
    ownership_call_bodies.infer_all(b);
}

// The atom of a one-atom guard: its tested formal and the value that it requires.
fn guard_value(ownership_summary_model.summary* s, ownership_summary_model.case_record row)
    ownership_api.predicate_atom {
    u64 mut g = 0;
    while (g < s->guards.len) {
        if (ownership_summary_model.same(s->guards[g].key, row.guard)) {
            assert(s->guards[g].positive.len == 1 && s->guards[g].negative.len == 0);
            u64 mut k = 0;
            while (k < s->predicates.len) {
                if (ownership_summary_model.same(s->predicates[k].key,
                    s->guards[g].positive[0])) { return s->predicates[k]; }
                k += 1;
            }
        }
        g += 1;
    }
    panic("ownership_calls_guards_test: no guard atom");
}

// The two cases of `if (fail) panic`: the abort needs fail == 1 and the return fail == 0.
// Both test the captured value of formal local `local` of the body.
fn split_on_formal(ownership_call_bodies.bodies* b, u64 index, u32 local) void {
    ownership_summary_model.summary* s = ownership_call_bodies.summary(b, index);
    assert(ownership_api.successful(s->proof) && s->cases.len == 2);
    assert(s->predicates.len == 2 && s->guards.len == 2);
    ownership_api.entity_id formal = ownership_api.entity_id{b->inputs[index].function.key,
        ownership_api.entity_kind.value, local + 1};
    u64 mut i = 0;
    while (i < 2) {
        ownership_summary_model.case_record row = s->cases[i];
        ownership_api.predicate_atom atom = guard_value(s, row);
        assert(ownership_summary_model.same(atom.left, formal));
        assert(atom.kind == ownership_api.predicate_kind.equality);
        if (row.outcome.kind == ownership_api.outcome_kind.abort) {
            assert(atom.lower.value == 1 && !row.outcome.possible_caller_return);
        } else {
            assert(row.outcome.kind == ownership_api.outcome_kind.function_return);
            assert(atom.lower.value == 0 && row.outcome.possible_caller_return);
        }
        assert(ownership_summary_model.same(row.outcome.guard, row.guard));
        i += 1;
    }
}

fn lost(ownership_call_bodies.bodies* b, u64 index) void {
    ownership_summary_model.summary* s = ownership_call_bodies.summary(b, index);
    assert(s->proof.failed && !ownership_api.successful(s->proof));
    assert(ownership_call_bodies.saw(b, ownership_api.event_kind.lost_ownership));
    assert(b->services.counts.last.operation.terminator);
}

// The null result and the view result are two guarded returns of the callee. With
// `choose == true` only the view case runs, and the caller reads it after its null test.
fn case_g09_2() void {
    ownership_call_bodies.bodies mut b = ownership_call_bodies.bodies{};
    string[2] names = {"callee", "caller"};
    bodies(&b, NULLABLE[..], names[..]);
    defer ownership_call_bodies.close(&b);
    ownership_summary_model.summary* callee = ownership_call_bodies.summary(&b, 0);
    assert(ownership_api.successful(callee->proof) && callee->cases.len == 2);
    u64 mut viewing = 0;
    u64 mut i = 0;
    while (i < 2) {
        ownership_summary_model.case_record row = callee->cases[i];
        ownership_api.predicate_atom atom = guard_value(callee, row);
        // Each case holds only the result write of its own branch.
        assert(row.effects.len == 1);
        if (atom.lower.value == 1) {
            assert(row.results.len == 1);
            viewing += 1;
        } else { assert(row.results.len == 0); }
        i += 1;
    }
    assert(viewing == 1 && b.services.counts.events == 0);
    ownership_summary_model.summary* caller = ownership_call_bodies.summary(&b, 1);
    assert(ownership_api.successful(caller->proof) && caller->cases.len == 2);
    ownership_calls_env.boundary("G09.2", "", "none");
}

// A symbolic choice keeps both callee returns possible. The two results differ at one position,
// so the caller cannot export one call result. It reads the result without a null test, and no
// complete proof of that read exists. Flow joins the two normal cases before the read, so the
// read finds the null case and the view case in either order. One case alone would give a
// definite empty read or a valid read.
fn unchecked_read(string@ text) void {
    ownership_call_bodies.bodies mut b = ownership_call_bodies.bodies{};
    string[2] names = {"callee", "caller"};
    bodies(&b, text, names[..]);
    defer ownership_call_bodies.close(&b);
    ownership_summary_model.summary* s = ownership_call_bodies.summary(&b, 1);
    assert(!ownership_api.successful(s->proof) && s->cases.len == 0);
    assert(b.services.counts.events == 1);
    assert(ownership_call_bodies.saw(&b, ownership_api.event_kind.incomplete_proof));
    assert(!b.services.counts.last.operation.terminator);
}

fn case_g09_3() void {
    unchecked_read(UNCHECKED[..]);
    unchecked_read(UNCHECKED_SWAPPED[..]);
    ownership_calls_env.boundary("G09.3", "", "incomplete_proof");
}

// The same symbolic choice with a null test. The joined continuation keeps both values, so
// the summary stays incomplete. No path claims a definite error.
fn case_g09_1() void {
    ownership_call_bodies.bodies mut b = ownership_call_bodies.bodies{};
    string[2] names = {"callee", "caller"};
    bodies(&b, CHECKED[..], names[..]);
    defer ownership_call_bodies.close(&b);
    ownership_summary_model.summary* s = ownership_call_bodies.summary(&b, 1);
    assert(s->proof.kind == ownership_api.proof_kind.incomplete && s->cases.len == 0);
    assert(!ownership_call_bodies.saw(&b, ownership_api.event_kind.invalid_use));
    ownership_calls_env.boundary("G09.1", "", "incomplete_proof");
}

// An unconditional caller of a body that may abort. The abort case needs no cleanup, but the
// return case reaches the caller return with its owner (D17.18).
fn case_g11_3() void {
    ownership_call_bodies.bodies mut b = ownership_call_bodies.bodies{};
    string[2] names = {"callee", "caller"};
    bodies(&b, MAYBE_ABORT[..], names[..]);
    defer ownership_call_bodies.close(&b);
    split_on_formal(&b, 0, 1);
    lost(&b, 1);
    ownership_calls_env.boundary("G11.3", "", "lost_ownership");
}

// The wrapper composes the guarded cases of the inner body onto its own formal.
fn case_g12_4() void {
    ownership_call_bodies.bodies mut b = ownership_call_bodies.bodies{};
    string[3] names = {"inner", "callee", "caller"};
    bodies(&b, WRAPPED[..], names[..]);
    defer ownership_call_bodies.close(&b);
    split_on_formal(&b, 0, 1);
    split_on_formal(&b, 1, 1);
    lost(&b, 2);
    ownership_call_bodies.bodies mut released = ownership_call_bodies.bodies{};
    bodies(&released, WRAPPED_RELEASE[..], names[..]);
    defer ownership_call_bodies.close(&released);
    split_on_formal(&released, 2, 2);
    ownership_calls_env.boundary("G12.4", "", "lost_ownership");
}

// The return case releases the owner after the call. Both caller cases keep their guards.
fn case_g13_1() void {
    ownership_call_bodies.bodies mut b = ownership_call_bodies.bodies{};
    string[2] names = {"callee", "caller"};
    bodies(&b, RELEASES[..], names[..]);
    defer ownership_call_bodies.close(&b);
    assert(b.services.counts.events == 0);
    split_on_formal(&b, 1, 2);
    ownership_calls_env.boundary("G13.1", "", "none");
}

// `true` refutes the return case, so the caller only aborts and needs no cleanup. `false`
// refutes the abort case, so the caller returns and loses its owner.
fn case_g13_2() void {
    ownership_call_bodies.bodies mut b = ownership_call_bodies.bodies{};
    string[2] names = {"callee", "caller"};
    bodies(&b, ALWAYS[..], names[..]);
    defer ownership_call_bodies.close(&b);
    assert(b.services.counts.events == 0);
    ownership_summary_model.case_record row = ownership_call_bodies.only_case(&b, 1);
    assert(row.outcome.kind == ownership_api.outcome_kind.abort);
    assert(row.guard.kind == ownership_api.entity_kind.none);
    ownership_call_bodies.bodies mut never = ownership_call_bodies.bodies{};
    bodies(&never, NEVER[..], names[..]);
    defer ownership_call_bodies.close(&never);
    lost(&never, 1);
    ownership_calls_env.boundary("G13.2", "", "none");
}

// A local copy keeps the captured formal value, so the return case loses the owner.
fn case_g13_3() void {
    ownership_call_bodies.bodies mut b = ownership_call_bodies.bodies{};
    string[2] names = {"callee", "caller"};
    bodies(&b, COPIED[..], names[..]);
    defer ownership_call_bodies.close(&b);
    lost(&b, 1);
    ownership_calls_env.boundary("G13.3", "", "lost_ownership");
}

// A computed argument has no capture. No caller value decides the cases, so the call stays
// unresolved. The caller keeps its owner and reports incomplete proof, not a lost owner.
fn case_g13_4() void {
    ownership_call_bodies.bodies mut b = ownership_call_bodies.bodies{};
    string[2] names = {"callee", "caller"};
    bodies(&b, COMPUTED[..], names[..]);
    defer ownership_call_bodies.close(&b);
    ownership_summary_model.summary* s = ownership_call_bodies.summary(&b, 1);
    assert(s->proof.kind == ownership_api.proof_kind.incomplete && s->cases.len == 0);
    assert(!ownership_call_bodies.saw(&b, ownership_api.event_kind.lost_ownership));
    ownership_calls_env.boundary("G13.4", "", "incomplete_proof");
}

// The return case of the call leaves `fail == 0` on the caller path. The later test of the
// same formal then refutes its true edge, so only the release path returns. Without that atom
// the early return would lose the owner.
fn guard_correlation() void {
    ownership_call_bodies.bodies mut b = ownership_call_bodies.bodies{};
    string[2] names = {"callee", "caller"};
    bodies(&b, CORRELATED[..], names[..]);
    defer ownership_call_bodies.close(&b);
    assert(b.services.counts.events == 0);
    split_on_formal(&b, 1, 2);
}

// After the first call the caller path holds `fail == 0`. That caller fact decides the guards
// of the second call, so its abort case does not run again: two cases, not three.
fn repeated_guard() void {
    ownership_call_bodies.bodies mut b = ownership_call_bodies.bodies{};
    string[2] names = {"callee", "caller"};
    bodies(&b, TWICE[..], names[..]);
    defer ownership_call_bodies.close(&b);
    assert(b.services.counts.events == 0);
    split_on_formal(&b, 1, 2);
}

// Two normal cases reach one call result. They cover each value of `b`, so their join drops
// the case atoms, and both write the source of `p`: the call result has one value, and the
// caller publishes it (D17.18). Two results of two sources keep two values, and normal cases
// that leave a value pair to an abort keep their atoms. Both callers stay incomplete. A result
// of two sources that goes straight to another call keeps its two values in flow too.
fn joined_result() void {
    ownership_call_bodies.bodies mut b = ownership_call_bodies.bodies{};
    string[2] names = {"callee", "caller"};
    bodies(&b, SAME_RESULT[..], names[..]);
    defer ownership_call_bodies.close(&b);
    ownership_summary_model.summary* callee = ownership_call_bodies.summary(&b, 0);
    assert(ownership_api.successful(callee->proof) && callee->cases.len == 2);
    ownership_summary_model.case_record row = ownership_call_bodies.only_case(&b, 1);
    assert(row.guard.kind == ownership_api.entity_kind.none && row.results.len == 1);
    ownership_summary_model.summary* s = ownership_call_bodies.summary(&b, 1);
    assert(ownership_summary_model.same(s->results[0].borrow.source,
        ownership_summary_body.designated(&b.inputs[1], 1)));
    assert(b.services.counts.events == 0);
    ownership_call_bodies.bodies mut other = ownership_call_bodies.bodies{};
    bodies(&other, OTHER_RESULT[..], names[..]);
    defer ownership_call_bodies.close(&other);
    ownership_summary_model.summary* two = ownership_call_bodies.summary(&other, 1);
    assert(two->proof.kind == ownership_api.proof_kind.incomplete && two->cases.len == 0);
    assert(two->proof.terminal.reason == ownership_api.incomplete_reason.unknown_effect);
    ownership_call_bodies.bodies mut used = ownership_call_bodies.bodies{};
    string[3] used_names = {"callee", "use", "caller"};
    bodies(&used, USED_RESULT[..], used_names[..]);
    defer ownership_call_bodies.close(&used);
    ownership_summary_model.summary* passed = ownership_call_bodies.summary(&used, 2);
    assert(passed->proof.kind == ownership_api.proof_kind.incomplete && passed->cases.len == 0);
    assert(passed->proof.terminal.reason == ownership_api.incomplete_reason.unknown_effect);
    assert(passed->requirements.len == 0);
    ownership_call_bodies.bodies mut partial = ownership_call_bodies.bodies{};
    bodies(&partial, PARTIAL_RESULT[..], names[..]);
    defer ownership_call_bodies.close(&partial);
    assert(ownership_call_bodies.summary(&partial, 0)->cases.len == 3);
    ownership_summary_model.summary* kept = ownership_call_bodies.summary(&partial, 1);
    assert(kept->proof.kind == ownership_api.proof_kind.incomplete && kept->cases.len == 0);
    ownership_call_bodies.bodies mut window = ownership_call_bodies.bodies{};
    bodies(&window, OTHER_WINDOW[..], names[..]);
    defer ownership_call_bodies.close(&window);
    assert(ownership_api.successful(ownership_call_bodies.summary(&window, 0)->proof));
    ownership_summary_model.summary* windows = ownership_call_bodies.summary(&window, 1);
    assert(windows->proof.kind == ownership_api.proof_kind.incomplete && windows->cases.len == 0);
    ownership_call_bodies.bodies mut atom = ownership_call_bodies.bodies{};
    bodies(&atom, KEPT_ATOM[..], names[..]);
    defer ownership_call_bodies.close(&atom);
    ownership_summary_model.summary* tested = ownership_call_bodies.summary(&atom, 1);
    assert(ownership_api.successful(tested->proof) && tested->cases.len == 2);
    assert(atom.services.counts.events == 0);
}

// The copy effects of a summary: each names one store of a borrow.
fn copies(ownership_summary_model.summary* s) u64 {
    u64 mut found = 0;
    u64 mut i = 0;
    while (i < s->effects.len) {
        if (s->effects[i].payload == ownership_summary_model.payload_kind.copy) { found += 1; }
        i += 1;
    }
    return found;
}

// A store that not each case of `g` does keeps `h` incomplete, and `top` cannot pass.
fn split_store(string@ text) void {
    ownership_call_bodies.bodies mut b = ownership_call_bodies.bodies{};
    string[3] names = {"g", "h", "top"};
    bodies(&b, text, names[..]);
    defer ownership_call_bodies.close(&b);
    ownership_summary_model.summary* g = ownership_call_bodies.summary(&b, 0);
    assert(ownership_api.successful(g->proof) && g->cases.len == 2);
    ownership_summary_model.summary* h = ownership_call_bodies.summary(&b, 1);
    assert(h->proof.kind == ownership_api.proof_kind.incomplete && h->cases.len == 0);
    assert(h->proof.terminal.reason == ownership_api.incomplete_reason.unknown_effect);
    ownership_summary_model.summary* top = ownership_call_bodies.summary(&b, 2);
    assert(!ownership_api.successful(top->proof) && top->cases.len == 0);
    assert(ownership_call_bodies.saw(&b, ownership_api.event_kind.incomplete_proof));
}

// Each normal case of `g` exports the same store, so `h` exports it once and `top` replays it.
fn shared_store(string@ text, u64 cases) void {
    ownership_call_bodies.bodies mut b = ownership_call_bodies.bodies{};
    string[3] names = {"g", "h", "top"};
    bodies(&b, text, names[..]);
    defer ownership_call_bodies.close(&b);
    assert(ownership_call_bodies.summary(&b, 0)->cases.len == 2);
    ownership_summary_model.summary* h = ownership_call_bodies.summary(&b, 1);
    assert(ownership_api.successful(h->proof) && h->cases.len == cases);
    assert(copies(h) == 1 && h->retained.len == 1);
    ownership_summary_model.summary* top = ownership_call_bodies.summary(&b, 2);
    assert(top->proof.failed && !ownership_api.successful(top->proof));
    assert(ownership_call_bodies.saw(&b, ownership_api.event_kind.invalid_use));
}

// A call export attaches to each exit after the call, so it cannot name one case of the
// callee. The stores of the applied cases must agree, or the caller stays incomplete.
fn joined_stores() void {
    split_store(ONE_CASE_STORE[..]);
    split_store(ONE_CASE_RESULT[..]);
    split_store(LOADED_STORE[..]);
    split_store(LOADED_RESULT[..]);
    split_store(ABORT_STORE[..]);
    ownership_call_bodies.bodies mut b = ownership_call_bodies.bodies{};
    string[3] names = {"g", "h", "top"};
    bodies(&b, OTHER_STORE[..], names[..]);
    defer ownership_call_bodies.close(&b);
    assert(copies(ownership_call_bodies.summary(&b, 0)) == 2);
    ownership_summary_model.summary* h = ownership_call_bodies.summary(&b, 1);
    assert(h->proof.kind == ownership_api.proof_kind.incomplete && h->cases.len == 0);
    assert(ownership_call_bodies.saw(&b, ownership_api.event_kind.incomplete_proof));
    shared_store(SHARED_STORE[..], 1);
    shared_store(ABORT_BEFORE[..], 2);
    shared_store(ABORT_AFTER[..], 2);
}

// The exact arguments select the case that returns `a`. The read of `*v` after `del(a)` is
// then a definite invalid use (D17.18). `top` has one reaching path, so its validated witness
// holds on each path and the evidence is unconditional (`spec/toolchain.md` 4.2).
fn released_origin(string@ text, string callee, u64 cases) void {
    ownership_call_bodies.bodies mut b = ownership_call_bodies.bodies{};
    string[2] names = {callee, "top"};
    bodies(&b, text, names[..]);
    defer ownership_call_bodies.close(&b);
    ownership_summary_model.summary* s = ownership_call_bodies.summary(&b, 0);
    assert(ownership_api.successful(s->proof) && s->cases.len == cases);
    ownership_summary_model.summary* top = ownership_call_bodies.summary(&b, 1);
    assert(top->proof.kind == ownership_api.proof_kind.complete && top->proof.failed);
    assert(top->cases.len == 0 && b.services.counts.events == 1);
    assert(ownership_call_bodies.saw(&b, ownership_api.event_kind.invalid_use));
    assert(b.services.counts.last.evidence == ownership_api.evidence_kind.unconditional);
}

// The exact arguments select a case that returns `r`. It stays live, so `top` proves its read
// and needs `r` live at the call.
fn live_origin(string@ text, string callee) void {
    ownership_call_bodies.bodies mut b = ownership_call_bodies.bodies{};
    string[2] names = {callee, "top"};
    bodies(&b, text, names[..]);
    defer ownership_call_bodies.close(&b);
    ownership_summary_model.summary* top = ownership_call_bodies.summary(&b, 1);
    assert(ownership_api.successful(top->proof) && top->cases.len == 1);
    assert(top->requirements.len != 0 && b.services.counts.events == 0);
}

// Two possible cases return two formals, so the call result has no one origin. The read
// stays incomplete, and no event claims a definite error (D17.18).
fn open_origin(string@ text, string callee) void {
    ownership_call_bodies.bodies mut b = ownership_call_bodies.bodies{};
    string[2] names = {callee, "top"};
    bodies(&b, text, names[..]);
    defer ownership_call_bodies.close(&b);
    ownership_summary_model.summary* top = ownership_call_bodies.summary(&b, 1);
    assert(top->proof.kind == ownership_api.proof_kind.incomplete && top->cases.len == 0);
    assert(top->proof.terminal.reason == ownership_api.incomplete_reason.missing_path);
    assert(b.services.counts.events == 0);
}

// The origin of a call result comes only from the cases that its exact arguments do not
// refute (`ownership_calls.refuted`), as flow applies them. Each caller passes two different
// views, so one refuted case changes the origin.
fn guarded_origins() void {
    released_origin(SECOND_A_FALSE[..], "second", 2);
    released_origin(SECOND_A_TRUE[..], "second", 2);
    released_origin(PICK_A[..], "pick", 3);
    live_origin(SECOND_R_FALSE[..], "second");
    live_origin(SECOND_R_TRUE[..], "second");
    live_origin(PICK_R[..], "pick");
    open_origin(SECOND_SYMBOLIC[..], "second");
    open_origin(PICK_OPEN[..], "pick");
}

// The unchanged callee gives `top` a definite error: both cases return `a`. The test then
// refutes each guard of `same2` for `false`. No case covers the call, so flow keeps the
// published call unresolved with an unknown result. The origin reads each normal case, and
// the read after the call is incomplete proof with abstract evidence, not a definite error.
fn refuted_origin() void {
    ownership_call_bodies.bodies mut b = ownership_call_bodies.bodies{};
    string[2] names = {"same2", "top"};
    ownership_call_bodies.open(&b, SAME_FORMAL[..], names[..]);
    defer ownership_call_bodies.close(&b);
    ownership_call_bodies.infer(&b, 0);
    ownership_call_bodies.infer(&b, 1);
    ownership_summary_model.summary* top = ownership_call_bodies.summary(&b, 1);
    assert(top->proof.failed && !ownership_api.successful(top->proof));
    assert(ownership_call_bodies.saw(&b, ownership_api.event_kind.invalid_use));
    ownership_summary_model.summary* callee = ownership_call_bodies.summary(&b, 0);
    assert(callee->cases.len == 2 && callee->predicates.len == 2);
    u64 mut k = 0;
    while (k < callee->predicates.len) {
        if (callee->predicates[k].lower.value == 0) {
            callee->predicates[k].lower.value = 2;
            callee->predicates[k].upper.value = 2;
        }
        k += 1;
    }
    ownership_call_bodies.infer(&b, 1);
    ownership_summary_model.summary* refuted = ownership_call_bodies.summary(&b, 1);
    assert(refuted->proof.kind == ownership_api.proof_kind.incomplete);
    assert(refuted->cases.len == 0 && b.services.counts.events == 1);
    assert(refuted->proof.terminal.reason == ownership_api.incomplete_reason.unknown_effect);
    assert(ownership_call_bodies.saw(&b, ownership_api.event_kind.incomplete_proof));
    assert(b.services.counts.last.evidence ==
        ownership_api.evidence_kind.abstract_possibility);
}

// The exact arguments leave only the abort case of `must`, so flow ends the path at the call
// (D17.18). The read after the call does not run, and `top` proves its one abort case. The
// origin of the call result reads each normal case here, so extraction does not stop at the
// read with `missing_path`.
fn abort_only(string@ text) void {
    ownership_call_bodies.bodies mut b = ownership_call_bodies.bodies{};
    string[2] names = {"must", "top"};
    bodies(&b, text, names[..]);
    defer ownership_call_bodies.close(&b);
    assert(ownership_call_bodies.summary(&b, 0)->cases.len == 2);
    ownership_summary_model.case_record row = ownership_call_bodies.only_case(&b, 1);
    assert(row.outcome.kind == ownership_api.outcome_kind.abort);
    assert(b.services.counts.events == 0);
}

// The read after an unresolved call proves nothing from the origin of the call result. It is
// incomplete proof with abstract evidence, and no definite error.
fn unresolved_abort() void {
    ownership_call_bodies.bodies mut b = ownership_call_bodies.bodies{};
    string[2] names = {"must", "top"};
    bodies(&b, MUST_UNBOUND[..], names[..]);
    defer ownership_call_bodies.close(&b);
    assert(ownership_call_bodies.summary(&b, 0)->cases.len == 3);
    ownership_summary_model.summary* top = ownership_call_bodies.summary(&b, 1);
    assert(top->proof.kind == ownership_api.proof_kind.incomplete && top->cases.len == 0);
    assert(b.services.counts.events == 1);
    assert(ownership_call_bodies.saw(&b, ownership_api.event_kind.incomplete_proof));
    assert(b.services.counts.last.evidence ==
        ownership_api.evidence_kind.abstract_possibility);
}

fn abort_origins() void {
    abort_only(MUST_LIVE[..]);
    abort_only(MUST_RELEASED[..]);
    released_origin(MUST_TRUE[..], "must", 2);
    unresolved_abort();
}

// Inference writes no negative atom, and each case guard names a record. The test edits the
// guard of the case of `b == 1` in `second`: first it adds a negative atom, then it names a
// guard without a record. `ownership_calls.refuted` reads neither guard, and flow keeps the
// call unresolved (`ownership_calls.case_answer`). The origin keeps that case too, so both
// cases stay and the read of `top` stays incomplete without an event, not a definite error.
fn unread_guard(bool negative) void {
    ownership_call_bodies.bodies mut b = ownership_call_bodies.bodies{};
    string[2] names = {"second", "top"};
    ownership_call_bodies.open(&b, SECOND_A_FALSE[..], names[..]);
    defer ownership_call_bodies.close(&b);
    ownership_call_bodies.infer(&b, 0);
    ownership_summary_model.summary* callee = ownership_call_bodies.summary(&b, 0);
    assert(callee->cases.len == 2 && callee->guards.len == 2);
    u64 mut edited = 0;
    u64 mut i = 0;
    while (i < 2) {
        if (guard_value(callee, callee->cases[i]).lower.value == 1) {
            u64 mut g = 0;
            while (g < 2) {
                if (ownership_summary_model.same(callee->guards[g].key, callee->cases[i].guard)) {
                    if (negative) { callee->guards[g].negative = callee->guards[g].positive; }
                    else { callee->guards[g].key.ordinal += 1000; }
                    edited += 1;
                }
                g += 1;
            }
        }
        i += 1;
    }
    assert(edited == 1);
    ownership_call_bodies.infer(&b, 1);
    ownership_summary_model.summary* top = ownership_call_bodies.summary(&b, 1);
    assert(top->proof.kind == ownership_api.proof_kind.incomplete && top->cases.len == 0);
    assert(top->proof.terminal.reason == ownership_api.incomplete_reason.missing_path);
    assert(b.services.counts.events == 0);
}

// The view of `b->item` is loaded only on the read branch. The other case does not use it, so
// it needs no load of that root, and both cases publish.
fn branch_load() void {
    ownership_call_bodies.bodies mut b = ownership_call_bodies.bodies{};
    string[1] names = {"callee"};
    bodies(&b, BRANCH_LOAD[..], names[..]);
    defer ownership_call_bodies.close(&b);
    ownership_summary_model.summary* s = ownership_call_bodies.summary(&b, 0);
    assert(ownership_api.successful(s->proof) && s->cases.len == 2);
    u64 mut loads = 0;
    u64 mut c = 0;
    while (c < 2) {
        u64 mut e = 0;
        while (e < s->cases[c].effects.len) {
            u64 mut k = 0;
            while (k < s->effects.len) {
                if (ownership_summary_model.same(s->effects[k].effect.key,
                    s->cases[c].effects[e]) && s->effects[k].payload ==
                    ownership_summary_model.payload_kind.reference_load) { loads += 1; }
                k += 1;
            }
            e += 1;
        }
        c += 1;
    }
    assert(loads == 1);
}

// Two branches that meet again give one exit two paths. One case cannot hold either branch,
// so the extractor refuses the merge and the summary stays incomplete.
fn merged_branches() void {
    ownership_call_bodies.bodies mut b = ownership_call_bodies.bodies{};
    string[2] names = {"callee", "caller"};
    bodies(&b, MERGED[..], names[..]);
    defer ownership_call_bodies.close(&b);
    ownership_summary_model.summary* s = ownership_call_bodies.summary(&b, 1);
    assert(s->proof.kind == ownership_api.proof_kind.incomplete && s->cases.len == 0);
    assert(s->proof.terminal.reason == ownership_api.incomplete_reason.unknown_effect);
}

// A local whose address the body takes has no scalar fact, so no capture decides the guards of
// the call. Without that rule the stale value 1 proves an abort that does not occur, and the
// caller hides the lost owner or the read of a released view (D17.14).
fn stored_scalar(string@ text, u64 count, u64 index) void {
    ownership_call_bodies.bodies mut b = ownership_call_bodies.bodies{};
    string[3] names = {"callee", "clear", "caller"};
    string[2] pair = {"callee", "caller"};
    bodies(&b, text, count == 3 ? names[..] : pair[..]);
    defer ownership_call_bodies.close(&b);
    ownership_summary_model.summary* s = ownership_call_bodies.summary(&b, index);
    assert(s->proof.kind == ownership_api.proof_kind.incomplete && s->cases.len == 0);
    assert(s->residual_effects);
}

fn stored_scalars() void {
    stored_scalar(STORED_BY_CALL[..], 3, 2);
    stored_scalar(STORED_HERE[..], 2, 1);
    stored_scalar(STORED_THEN_READ[..], 2, 1);
    stored_scalar(STORED_FORMAL[..], 3, 2);
}

// An addressed formal has no symbol, so its branch gives no guard. Both callee cases stay
// possible, and the caller that passes `true` reaches its return and loses its owner.
fn addressed_formal() void {
    ownership_call_bodies.bodies mut b = ownership_call_bodies.bodies{};
    string[2] names = {"callee", "caller"};
    bodies(&b, ADDRESSED_FORMAL[..], names[..]);
    defer ownership_call_bodies.close(&b);
    ownership_summary_model.summary* s = ownership_call_bodies.summary(&b, 0);
    assert(ownership_api.successful(s->proof) && s->cases.len == 2);
    assert(s->guards.len == 0 && s->predicates.len == 0);
    assert(s->cases[0].guard.kind == ownership_api.entity_kind.none);
    assert(s->cases[1].guard.kind == ownership_api.entity_kind.none);
    lost(&b, 1);
}

// The same-type cast keeps the symbol of `fail`, so both caller cases keep their guards.
fn cast_formal() void {
    ownership_call_bodies.bodies mut b = ownership_call_bodies.bodies{};
    string[2] names = {"callee", "caller"};
    bodies(&b, CAST_FORMAL[..], names[..]);
    defer ownership_call_bodies.close(&b);
    assert(b.services.counts.events == 0);
    split_on_formal(&b, 1, 2);
}

// The test moves the return guard of the callee from `fail == 0` to `fail == 2`. Then no guard
// holds for `false`, and no case of the summary covers the call. The call stays unresolved, so
// the path keeps its return and its owner. It does not end at the call.
fn refuted_cases() void {
    ownership_call_bodies.bodies mut b = ownership_call_bodies.bodies{};
    string[2] names = {"callee", "caller"};
    ownership_call_bodies.open(&b, REFUTED[..], names[..]);
    defer ownership_call_bodies.close(&b);
    ownership_call_bodies.infer(&b, 0);
    split_on_formal(&b, 0, 1);
    ownership_summary_model.summary* callee = ownership_call_bodies.summary(&b, 0);
    u64 mut k = 0;
    while (k < callee->predicates.len) {
        if (callee->predicates[k].lower.value == 0) {
            callee->predicates[k].lower.value = 2;
            callee->predicates[k].upper.value = 2;
        }
        k += 1;
    }
    ownership_call_bodies.infer(&b, 1);
    ownership_summary_model.summary* s = ownership_call_bodies.summary(&b, 1);
    assert(!ownership_api.successful(s->proof) && s->cases.len == 0);
}

// The refusal comes from extraction, before flow runs, so no event names the body.
fn back_edge() void {
    ownership_call_bodies.bodies mut b = ownership_call_bodies.bodies{};
    string[1] names = {"callee"};
    bodies(&b, LOOP[..], names[..]);
    defer ownership_call_bodies.close(&b);
    ownership_summary_model.summary* s = ownership_call_bodies.summary(&b, 0);
    assert(s->proof.kind == ownership_api.proof_kind.incomplete && s->cases.len == 0);
    assert(s->proof.terminal.reason == ownership_api.incomplete_reason.unknown_effect);
    assert(b.services.counts.events == 0);
}

fn main() i32 {
    case_g09_1();
    case_g09_2();
    case_g09_3();
    case_g11_3();
    case_g12_4();
    case_g13_1();
    case_g13_2();
    case_g13_3();
    case_g13_4();
    guard_correlation();
    merged_branches();
    repeated_guard();
    joined_result();
    joined_stores();
    guarded_origins();
    refuted_origin();
    abort_origins();
    unread_guard(true);
    unread_guard(false);
    branch_load();
    stored_scalars();
    addressed_formal();
    cast_formal();
    refuted_cases();
    back_edge();
    println("direct-call guards ok");
    return 0;
}
