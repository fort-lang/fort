//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: ownership_source: declaration key overflow
//! stdout:
//| true
/// A declaration key is a u32. declaration_key refuses an ordinal past U32_LIMIT, so a walk
/// that starts at U32_LIMIT + 1 panics at the first declaration.
import ast;
import check_env;
import fir;
import ownership_source;

fn main() i32 {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    println(check_env.open_module(&e, check_env.src_main()));
    ast.node mut* list = check_env.module_ast(&e, "main");
    u64 mut ordinal = fir.U32_LIMIT + 1;
    u32 mut key = 0;
    ownership_source.declaration_key(list, null, &ordinal, &key);
    return 0;
}
