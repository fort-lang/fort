//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| refused release ok
//| refused expansion release ok
//| lowered release ok
//| lowered defer release ok
//| lowered call release ok
//| lowered print release ok
//| lowered loops release ok
//| deep scopes release ok
//| wide scopes release ok
/// Checks that the lowering gives back every block that it takes (notes/testing.md 4). A function
/// that fir_lower.lower_function refuses is released before the call returns, and a function that
/// it lowers is released by fir.func_free.
import ast;
import fir;
import fir_env;
import fir_lower;
import heap;
import lower_env;

// The count of the lowerings in one round.
u64 CALLS = 100;

u64 SOURCE_LINES = 79;

// `f` fills every vector of a function: locals, blocks, statements, operands, arms and the
// projections of a string equality. `g` records a `defer` and a named local inside a clause inside
// a loop, with three scopes open: the body, the loop and the clause. `h` lowers `new` inside the
// members of a literal inside the arguments of a call, and `k` inside the arguments of
// `fprintln`; each of those holds vectors of its own while it lowers its operands. `m` lowers a
// range `for` and a `switch`. `deep` opens 22 scopes, more than the 16 of the first capacity of the
// stack of scopes, so the stack grows once and copies the 16 open scopes. The `break` in its
// innermost block finds the loop among the copied scopes. `wide` declares 18 named locals and
// records 18 deferred statements in one scope, so the vectors of both grow once, and its `return`
// reads the copied entries.
string[SOURCE_LINES] SOURCE = {
    "fn f(i32 x, i32 y, bool c, string s) i32 {",
    "    i32 a = x + y;",
    "    i32 b = x / y;",
    "    bool e = c && s == \"abc\";",
    "    if (e) {",
    "        return a << 3;",
    "    }",
    "    return b;",
    "}",
    "fn g(bool c, i32 n) void {",
    "    i32 a = 1;",
    "    while (c) {",
    "        switch (n) {",
    "        case 1:",
    "            i32 b = a + 2;",
    "            defer g(c, n);",
    "        }",
    "    }",
    "}",
    "struct pair {",
    "    i32 a;",
    "    i32 b;",
    "}",
    "fn take(i32 mut* own p) i32 {",
    "    del(p);",
    "    return 1;",
    "}",
    "fn pick(i32 a, i32 b, i32 c, i32 d, pair e, i32 f) i32 {",
    "    return a;",
    "}",
    "fn h(i32 x) i32 {",
    "    i32 a = x + 1;",
    "    return pick(a, x, a, x, pair{a, take(new(i32))}, x);",
    "}",
    "fn k(i32 x) void {",
    "    fprintln(x, x, take(new(i32)));",
    "}",
    "fn m(i32[4] v, i32 n) i32 {",
    "    i32 mut s = 0;",
    "    for (i32 x : v) {",
    "        switch (n) {",
    "        case 1, 2:",
    "            continue;",
    "        default:",
    "            s += x;",
    "        }",
    "    }",
    "    return s;",
    "}",
    "fn deep(bool c) void {",
    "    while (c) {",
    "        { { { { { { { { { { { { { { { { { { { {",
    "            break;",
    "        } } } } } } } } } } } } } } } } } } } }",
    "    }",
    "}",
    "fn wide(bool c) void {",
    "    bool a0 = c; defer wide(a0);",
    "    bool a1 = c; defer wide(a1);",
    "    bool a2 = c; defer wide(a2);",
    "    bool a3 = c; defer wide(a3);",
    "    bool a4 = c; defer wide(a4);",
    "    bool a5 = c; defer wide(a5);",
    "    bool a6 = c; defer wide(a6);",
    "    bool a7 = c; defer wide(a7);",
    "    bool a8 = c; defer wide(a8);",
    "    bool a9 = c; defer wide(a9);",
    "    bool b0 = c; defer wide(b0);",
    "    bool b1 = c; defer wide(b1);",
    "    bool b2 = c; defer wide(b2);",
    "    bool b3 = c; defer wide(b3);",
    "    bool b4 = c; defer wide(b4);",
    "    bool b5 = c; defer wide(b5);",
    "    bool b6 = c; defer wide(b6);",
    "    bool b7 = c; defer wide(b7);",
    "    if (c) {",
    "        return;",
    "    }",
    "}",
};

u64 REFUSED_LINES = 24;

// Checked without the runtime, so a print stops the lowering. `r` stops inside a clause inside a
// loop, with three scopes, two named locals and two deferred statements open. `x` stops inside
// the expansion of a deferred block at a `break`, with a floor raised and a scope of the
// deferred code open.
string[REFUSED_LINES] REFUSED_SOURCE = {
    "fn r(bool c, i32 n) void {",
    "    i32 a = 1;",
    "    defer r(c, n);",
    "    while (c) {",
    "        switch (n) {",
    "        case 1:",
    "            i32 b = a;",
    "            defer r(c, b);",
    "            println(b);",
    "        }",
    "    }",
    "}",
    "fn x(bool c) void {",
    "    while (c) {",
    "        bool d = c;",
    "        defer {",
    "            bool e = d;",
    "            while (e) {",
    "                println(e);",
    "            }",
    "        }",
    "        break;",
    "    }",
    "}",
};

// Each round lowers the function `name` CALLS times. A function that the lowering refuses must
// come back empty with nothing held, so the probe frees only a lowered one. A leak of one vector
// of 16 slots in each call keeps 25 KB or more in each round, and the program break moves. The
// probe watches the system view alone, since the free chunks of a round make the address of a
// small block no view.
fn rounds_leave_the_heap_where_it_was(string name, bool lowers) void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    if (lowers) {
        lower_env.check_lines(&e, SOURCE[..], true);
    } else {
        lower_env.check_lines(&e, REFUSED_SOURCE[..], false);
    }
    if (lowers) {
        // the function that the rounds lower keeps every rule of the verifier
        lower_env.lower_checked(&e, name);
    }
    ast.node* decl = lower_env.decl(&e, name);
    u64[3] mut break_at = {};
    u64 mut round = 0;
    while (round < fir_env.LEAK_ROUNDS) {
        u64 mut k = 0;
        while (k < CALLS) {
            fir.func mut f = fir.func{};
            fir_lower.report mut why = fir_lower.report{};
            assert(fir_lower.lower_function(&e.c.ck, decl, &f, &why) == lowers);
            if (lowers) {
                fir.func_free(&f);
            }
            k += 1;
        }
        u64 slot = fir_env.leak_slot(round);
        if (slot < 3) {
            break_at[slot] = heap.system_view();
        }
        round += 1;
    }
    assert(fir_env.moved(break_at) < fir_env.LEAK_BOUND);
}

fn main() i32 {
    rounds_leave_the_heap_where_it_was("r", false);
    println("refused release ok");
    rounds_leave_the_heap_where_it_was("x", false);
    println("refused expansion release ok");
    rounds_leave_the_heap_where_it_was("f", true);
    println("lowered release ok");
    rounds_leave_the_heap_where_it_was("g", true);
    println("lowered defer release ok");
    rounds_leave_the_heap_where_it_was("h", true);
    println("lowered call release ok");
    rounds_leave_the_heap_where_it_was("k", true);
    println("lowered print release ok");
    rounds_leave_the_heap_where_it_was("m", true);
    println("lowered loops release ok");
    rounds_leave_the_heap_where_it_was("deep", true);
    println("deep scopes release ok");
    rounds_leave_the_heap_where_it_was("wide", true);
    println("wide scopes release ok");
    return 0;
}
