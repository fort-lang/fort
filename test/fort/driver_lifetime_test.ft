//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| ok
import capture;
import containers;
import driver;
import std.io;
import std.strbuf;
import std.sys;

// A run of the driver owns its session and its analysis and releases both on
// every path out (D20.5), and no other test can see a release that is
// missing: the gate's sanitizers instrument the C compiler and not the
// x86-64 program the harness runs.
//
// What can see one is the heap itself. Two hundred runs of one command line
// ask for the same blocks in the same order, so a run that gives them back
// leaves the program break where it was, while a run that keeps something
// pushes it up by the leaked bytes per run. The break and not the address of
// a fresh block is what is watched: a leaked module set is large enough that
// the allocator still serves a small block from a free chunk at the same
// address, so an address probe read 0 with `analysis_free` deleted while the
// break had climbed by megabytes.
//
// This is a program of its own rather than a test of driver_test.ft: the
// measurement is of the allocator, so anything the same program did before it
// -- forty other driver runs over forty other files -- fragments the heap and
// moves the address for a reason that is not a leak. Its first act is the
// loop.
//
// Each of the six modes is measured, since each releases a different set:
// --tokens holds a session and a token vector, --ast a syntax tree as well, a
// build the module set of the whole closure and the checker over it, the
// sixth the identifier index and the file list of the check document, and the
// fourth a program written so that the checker allocates everything it has --
// a folded constant for its value vector, an `extern fn` for its extern
// vector and its map, an import that binds nothing for the map of names it
// failed to bind, and two diagnostics for its message buffer -- since a
// release is witnessed only by a round that made the allocation.
//
// Both views are watched, since neither sees the whole heap: the program
// break is blind to a leak the allocator serves out of a free chunk it
// already holds, and the address of a fresh block is blind to a large one,
// which was measured at 0 while the break had climbed by megabytes. The
// answer is the larger of the two distances, so a round that moved either
// view fails the bound.
//
// **Two views are necessary and not sufficient: a round must also be large
// enough for the release it claims to witness.** Deleting `del(ck->syms)`
// leaks about 144 bytes per analysis, and two hundred rounds of that stay
// inside the 132 KB glibc gives a process at startup, so neither view moves
// and the probe reads 0 -- which is how T-035 first cited this test for a
// release it does not witness at that size. ROUNDS is therefore set past the
// point where the smallest release here becomes visible, and a release added
// later is held to the same standard: delete it, watch this test go red, and
// raise ROUNDS until it does.
//
// Verified by deletion, one at a time, each moving a view past BOUND:
// compile_entry's `defer session.free(&s)` and `defer analysis_free(&an)`;
// and in check.check_free the loop that frees the symbol records,
// `del(ck->syms)`, `del(ck->values)`, `del(ck->externs)`,
// `strmap.free(&ck->extern_first)`, `strmap.free(&ck->bad_imports)`,
// `strbuf.free(&ck->msg)` and `types.type_table_free`. That is every release
// check.check_free performs, and the fourth program is what makes the last
// five of them reachable at all. The fourth program also carries a function
// body, so the scopes check_stmt.check_block, check_function_body, check_for
// and check_range_for open are released here too: dropping any one of those
// four `scope.free` calls moves a view past BOUND. The body carries a
// `for (T x : coll)` as well as a `for (init; cond; step)` for that reason,
// and the reason is the third part of the rule above: check_range_for's
// release was invisible here until a round opened the scope it frees.
// Past the point where the smallest release measured here is visible: a leak
// of about 144 bytes a round needs roughly nine hundred rounds to push the
// break out of the heap the process starts with, and the early sample is
// taken at half the rounds, so the count is set well above twice that.
u64 ROUNDS = 4000;
u64 BOUND = 4096;

// The rounds the emitter's own mode is measured over, and how many
// declarations its program carries. The emitter allocates far more per round
// than the front end does -- a pool holding every operand text, seven vectors
// and eight buffers -- so a smaller count reaches the same bound, and the
// program is sized so that each of the sixteen releases gen.gen_free
// performs is a round's worth rather than a block's.
u64 EMIT_ROUNDS = 400;
u64 EMIT_WIDTH = 60;

// The rounds `--check --json --index` is measured over, and how many
// declarations its program carries. The five releases that mode adds are the
// three of index.free -- the record span, the pool of type spellings and the
// buffer a spelling is built in -- and the two of driver.check_document, the
// file list and the index itself. The width is what makes the two small ones
// visible: a spelling buffer and a vector of one file name are 256 bytes a
// round each, and every record carries a long type spelling so that the pool
// and the buffer are a round's worth rather than a block's.
//
// The round count is a quarter of the front end's, and that is measured and
// not guessed: all five releases turn this test red at 1000 rounds, where
// the two small ones leak 256 KB apiece. It is not higher because this
// program is the sixth mode of a test the harness kills at 60 seconds:
// 4000 rounds here took the whole test to 48 s, which passed by hand and
// timed out under the gate's third preset.
u64 INDEX_ROUNDS = 1000;
u64 INDEX_WIDTH = 40;

// How many of the last rounds are held against the early one. The allocator
// does not hand a round the same small block every time: over the emitter's
// program the address it returns runs through a cycle of eight, so two late
// samples are not enough to find one in step with the early round and the
// probe read 26512 with nothing leaking at all. Sixteen covers that cycle
// twice; a leak moves every sample, so taking the smallest costs nothing.
u64 LATE_SAMPLES = 16;

// The exit status of D14.1 a refused program leaves, which the fourth mode
// asserts of its first round.
i32 EXIT_COMPILE_ERROR = 1;

// The current program break, which is where the heap ends: sbrk(0) moves
// nothing and reports it. There is no std binding for it and this is its one
// caller (D9.8).
extern fn void* sbrk(i64 increment);

fn u64 probe_address() {
    return cast(sbrk(0), u64);
}

// The other view: the address a small fresh block is served at, which moves
// when a round kept a block the next round would have been given. The block is
// released at once, so the probe itself leaks nothing.
u64 PROBE_BLOCK = 32;

fn u64 probe_block() {
    u8 mut@ own block = new(u8, PROBE_BLOCK);
    u64 at = cast(block.ptr, u64);
    del(block);
    return at;
}

// How far the allocator moved between the round at half the rounds and the
// end of them, whichever way it went: a leak that hands a later round a lower
// address is a leak too, and a subtraction the wrong way round would trap
// before the assertion (D11.1).
//
// The early round is held against each of the last LATE_SAMPLES rounds and
// the smallest of those distances is the answer, which costs nothing when the
// heap is steady and absorbs an allocator whose small-block position runs
// through a cycle: the address a round is handed here has a period of eight
// over the emitter's program, so one late round in every cycle is in step
// with the early one whatever the period, while a leak moves all of them.
fn u64 measure(string@ args) {
    return measure_rounds(args, ROUNDS, true);
}

// The same over a round count of its own, and with the block view under a
// switch. The emitter's round below compiles a far larger program, so it is
// measured over fewer rounds and the program is made rich enough that every
// release it claims to witness is a round's worth rather than a block's
// (AGENTS.md).
//
// **The block view is switched off for exactly that round, and the reason is
// measured.** A round that allocates a hundred kilobytes and gives it back
// leaves the heap holding free chunks of every size, so the address a 32-byte
// probe is handed lands wherever one of them starts: it moved through a range
// of 450 KB over rounds that leaked nothing at all, and no window or cycle
// makes it repeat. The break is the view that answers for that round, and it
// answers for all of it: each of the sixteen releases below is at least a
// kilobyte a round there, so a missing one pushes the break out by hundreds
// of kilobytes, which the deletion experiment confirms one release at a time.
// The block view stays on for the four front-end rounds above, where it is
// steady and where it is the only view that can see a small release.
fn u64 measure_rounds(string@ args, u64 rounds, bool watch_block) {
    return measure_status(args, rounds, watch_block, 0);
}

// The same, for a mode whose command line ends in a diagnostic: the fourth
// program below is refused by the checker, so its rounds exit 1 and the round
// that exits 0 would be the broken one.
fn u64 measure_status(string@ args, u64 rounds, bool watch_block, i32 want_status) {
    u64 mut early = 0;
    u64 mut early_block = 0;
    u64 mut broke = 0;
    u64 mut block = 0;
    bool mut sampled = false;
    u64 mut i = 0;
    while (i < rounds) {
        // The driver writes to both descriptors; they are captured so that
        // this test's own stdout is its one line.
        i32 saved_out = capture.begin(io.STDOUT, "out.txt");
        i32 saved_err = capture.begin(io.STDERR, "err.txt");
        i32 status = driver.run(args);
        capture.end(io.STDERR, saved_err);
        capture.end(io.STDOUT, saved_out);
        if (i == 0) {
            // The first round answers for the rest: a round that stops early
            // makes the allocations of a pass the probe claims to watch, and
            // a probe that watches nothing is green. The emitter's round in
            // particular ran for a whole afternoon over a program with a type
            // error, so `-S` stopped at the front end and every deletion of a
            // release in gen.gen_free was unwitnessed (AGENTS.md).
            assert(status == want_status);
        }
        if (i == rounds / 2) {
            early = probe_address();
            early_block = probe_block();
        }
        if (i + LATE_SAMPLES >= rounds) {
            u64 broke_now = distance(probe_address(), early);
            u64 mut block_now = 0;
            if (watch_block) {
                block_now = distance(probe_block(), early_block);
            }
            if (!sampled || broke_now < broke) {
                broke = broke_now;
            }
            if (!sampled || block_now < block) {
                block = block_now;
            }
            sampled = true;
        }
        i += 1;
    }
    assert(early != 0 && early_block != 0 && sampled);
    // Either view moving is a leak, so the answer is the larger distance.
    if (broke > block) {
        return broke;
    }
    return block;
}

// How far apart two addresses are, whichever way the allocator moved.
fn u64 distance(u64 a, u64 b) {
    if (a > b) {
        return a - b;
    }
    return b - a;
}

fn void write_file(string path, string text) {
    assert(io.write_file(path, cast(text, u8@)));
}

// Creates one directory, which may already exist.
extern fn i32 mkdir(char* path, u32 mode);

// The errno a directory that already exists reports (stdlib.md 2.2).
i32 EEXIST = 17;

// Every closure holds `std.rt`, which the driver reads from `<std-dir>/rt.ft`
// and looks for in `std` beside the program when nothing names one (D9.10,
// toolchain.md 1). The runs below give `fort` as argv[0], so that directory
// is `std` of this test's own working directory. What the driver needs there
// is a file that parses, not a runtime: nothing these tests build is ever
// run.
fn void write_runtime() {
    assert(mkdir("std".ptr, 0o700) == 0 || sys.errno() == EEXIST);
    write_file("std/rt.ft", "// The empty runtime of a driver test.\n");
}

fn i32 main() {
    write_runtime();
    write_file("clean.ft", "fn i32 main() {\n    return 0;\n}\n");
    write_file("closure.ft", "import helper;\nfn i32 main() {\n    return helper.one();\n}\n");
    write_file("helper.ft", "fn i32 one() {\n    return 1;\n}\n");
    // The fourth program makes the checker allocate everything it owns: a
    // constant that folds, an extern declaration, and a name that is not
    // declared, which is a diagnostic and so a message.
    strbuf.str_buf mut program = strbuf.create();
    defer strbuf.free(&program);
    // An import that resolves to nothing leaves the checker the names it
    // failed to bind, which is the one allocation a clean program never
    // makes (D14.2).
    strbuf.append(&program, "import nosuchmodule;\n");
    strbuf.append(&program, "extern fn i32 puts(char* s);\n");
    strbuf.append(&program, "i32 FOLDED = 41 + 1;\n");
    strbuf.append(&program, "i32 bad = nosuch;\n");
    // A body whose blocks the statement checker opens and closes: every block
    // is a scope that owns its bindings, and a parameter scope stands around
    // the body (check_stmt.ft, D7.9), so a scope left unfreed is a leak this
    // round can see and a clean module-level program cannot.
    strbuf.append(&program, "fn i32 sum(i32 n) {\n    i32 mut total = 0;\n");
    strbuf.append(&program, "    for (i32 mut i = 0; i < n; i++) {\n");
    strbuf.append(&program, "        i32 step = i;\n        total += step;\n    }\n");
    strbuf.append(&program, "    i32[2] steps = {1, 2};\n");
    strbuf.append(&program, "    for (i32 s : steps) {\n        total += s;\n    }\n");
    strbuf.append(&program, "    switch (total) {\n    case 0:\n        i32 zero = 0;\n");
    strbuf.append(&program, "        total += zero;\n    default:\n    }\n");
    strbuf.append(&program, "    return total;\n}\n");
    strbuf.append(&program, "fn i32 main() {\n    return sum(3);\n}\n");
    write_file("checked.ft", strbuf.view(&program));
    string[3] mut tokens = {"fort", "--tokens", "clean.ft"};
    string[3] mut ast = {"fort", "--ast", "clean.ft"};
    // A build of a closure of two modules as far as the module of D19.1,
    // which -S stops at: the emitter runs and is released every round, and
    // no clang is spawned four thousand times.
    string[3] mut build = {"fort", "-S", "closure.ft"};
    assert(measure(tokens[0..3]) < BOUND);
    assert(measure(ast[0..3]) < BOUND);
    assert(measure(build[0..3]) < BOUND);
    string[2] mut checked = {"fort", "checked.ft"};
    // `checked.ft` is refused by the checker, so its rounds exit 1 (D14.1).
    assert(measure_status(checked[0..2], ROUNDS, true, EXIT_COMPILE_ERROR) < BOUND);
    write_emitted();
    // The fifth program is the emitter's: -S runs gen_init, gen_program and
    // gen_free every round, and the program reaches every list and every
    // buffer the emitter owns.
    string[3] mut emitted = {"fort", "-S", "emitted.ft"};
    assert(measure_rounds(emitted[0..3], EMIT_ROUNDS, false) < BOUND);
    write_indexed();
    // The sixth program is the check document's: --index runs the front end,
    // the index walk and the document writer every round, and the document
    // goes to the captured stdout (D20.2, D20.3).
    // --index implies --check --json (D14.1), so the three of them are one
    // option here.
    string[3] mut indexed = {"fort", "--index", "indexed.ft"};
    assert(measure_rounds(indexed[0..3], INDEX_ROUNDS, true) < BOUND);
    println("ok");
    return 0;
}

// A program that makes the emitter allocate everything it owns, so that each
// release gen.gen_free performs is witnessed by a round that made the
// allocation: three files for the file list, an enum some `print` reaches for
// the enum list and its member strings, `extern` declarations for the extern
// list, a string literal per statement for the string list, a struct for the
// named types and a module-level constant for the globals section, a body
// with a slot per local for the slot list, nested blocks with a `defer` each
// for the scope stack and the deferred list, and an index and an `assert` for
// the failure buffer.
//
// Verified by deletion, one at a time, each moving the break past BOUND:
// fifteen of the sixteen releases gen.gen_free performs -- the eight buffers
// `named`, `globals`, `funcs`, `out`, `allocas`, `body`, `fail` and
// `scratch`, the six vectors `scopes`, `defers`, `files`, `strs`, `enums`
// and `externs`, and the pool.
//
// The sixteenth, `slots_free(&g->slots)`, is not witnessed on its own and
// cannot be: gen_stmt's function_begin releases the same vector at every
// definition and `fort_entry` is always the last definition emitted, so the
// vector gen_free is handed is already empty. Deleting either call alone
// leaks nothing and leaves this test green; deleting both moves the break
// past BOUND, which is the measured form of "exactly one of the two runs".
// What function_begin's call answers for is not a leak but a stale slot: a
// symbol of the previous definition still in the vector would be found by
// gen_slot_place, which the emitted text of every other suite covers.
//
// The width is what makes the small ones visible: with the emitter's round
// driven by the two-line program of the mode above, ten of the sixteen were
// left unwitnessed, and only `named`, `funcs`, `out`, `body`, `scopes` and
// the pool turned this test red. `externs` needed more than the width: the
// extern list holds what a module refers to and not what it declares, so it
// stayed empty until the program called every function it declared.
fn void write_emitted() {
    write_file("part_one.ft", "fn i32 one() {\n    return 1;\n}\n");
    write_file("part_two.ft", "fn i32 two() {\n    return 2;\n}\n");
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "import part_one;\nimport part_two;\n");
    strbuf.append(&b, "enum colour {\n    red,\n    green,\n    blue,\n}\n");
    strbuf.append(&b, "string GREETING = \"hello\";\n");
    u64 mut i = 0;
    while (i < EMIT_WIDTH) {
        // A struct and an `extern` apiece, so the named types and the extern
        // list grow with the width.
        strbuf.append(&b, "struct box");
        strbuf.append_u64(&b, i);
        strbuf.append(&b, " {\n    i64 value;\n}\n");
        strbuf.append(&b, "extern fn i64 helper");
        strbuf.append_u64(&b, i);
        strbuf.append(&b, "(i64 v);\n");
        i += 1;
    }
    strbuf.append(&b, "fn i32 main() {\n");
    strbuf.append(&b, "    colour c = colour.green;\n    println(c);\n");
    strbuf.append(&b, "    i64[4] values = {1, 2, 3, 4};\n    i64 mut total = 0;\n");
    i = 0;
    while (i < EMIT_WIDTH) {
        // Each `extern` is called as well as declared: the extern list holds
        // what the module refers to and not what it declares (item 8), so a
        // declaration alone leaves `syms_free` unwitnessed. -S stops at the
        // module, so nothing has to link.
        strbuf.append(&b, "    total += helper");
        strbuf.append_u64(&b, i);
        strbuf.append(&b, "(total);\n");
        i += 1;
    }
    i = 0;
    while (i < EMIT_WIDTH) {
        // One local, one string constant, one `defer` and one nested block
        // per step, so the slot list, the string list, the deferred list and
        // the scope stack all grow with the width.
        strbuf.append(&b, "    {\n        i64 step");
        strbuf.append_u64(&b, i);
        strbuf.append(&b, " = values[total % 4];\n");
        strbuf.append(&b, "        defer println(\"left step ");
        strbuf.append_u64(&b, i);
        strbuf.append(&b, "\");\n        total += step");
        strbuf.append_u64(&b, i);
        strbuf.append(&b, ";\n        assert(total >= 0);\n    }\n");
        i += 1;
    }
    strbuf.append(&b, "    print(GREETING);\n");
    strbuf.append(&b, "    return part_one.one() + part_two.two() + cast(total % 2, i32);\n}\n");
    write_file("emitted.ft", strbuf.view(&b));
}

// A program that makes the identifier index allocate everything it owns, so
// that each release index.free and driver.check_document perform is witnessed
// by a round that made the allocation: a record per identifier occurrence for
// the record span, a type spelling per record for the pool, and a spelling
// long enough to grow the buffer it is built in.
//
// Verified by deletion, one at a time, each moving a view past BOUND:
// `del(ix->entries)`, `containers.pool_free(&ix->pool)` and
// `strbuf.free(&ix->msg)` in index.free, and `containers.str_free(&files)`
// and the `defer index.free(&ix)` of driver.check_document.
//
// The width is what makes the two small ones visible. A file list of one name
// and a buffer holding one spelling are a few hundred bytes a round, so the
// type of every local is written `a_structure_with_a_long_name mut* own`,
// which is 38 bytes interned once per record, and the round count is the
// front end's 4000 rather than the emitter's 400.
fn void write_indexed() {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "struct a_structure_with_a_long_name {\n    i32 value;\n}\n");
    u64 mut i = 0;
    while (i < INDEX_WIDTH) {
        // One constant apiece: a declaration and a use are two records, and
        // each record interns a spelling of its own, since the pool copies
        // rather than deduplicates (containers.ft).
        strbuf.append(&b, "i32 LIMIT");
        strbuf.append_u64(&b, i);
        strbuf.append(&b, " = ");
        strbuf.append_u64(&b, i);
        strbuf.append(&b, ";\n");
        i += 1;
    }
    strbuf.append(&b, "fn i32 main() {\n    i32 mut total = 0;\n");
    i = 0;
    while (i < INDEX_WIDTH) {
        // One owning local apiece, whose type spelling is the longest this
        // program writes: the record of its declaration and the record of its
        // use in `del` each carry it.
        strbuf.append(&b, "    a_structure_with_a_long_name mut* own p");
        strbuf.append_u64(&b, i);
        strbuf.append(&b, " = new(a_structure_with_a_long_name);\n");
        strbuf.append(&b, "    total += p");
        strbuf.append_u64(&b, i);
        strbuf.append(&b, "->value + LIMIT");
        strbuf.append_u64(&b, i);
        strbuf.append(&b, ";\n    del(p");
        strbuf.append_u64(&b, i);
        strbuf.append(&b, ");\n");
        i += 1;
    }
    // One function of INDEX_WIDTH parameters and a function pointer to it:
    // its type is the longest spelling of the program, about two hundred
    // bytes, which is what grows the buffer a spelling is built in past a
    // block's worth. With the spelling of the owning local alone, 38 bytes,
    // deleting `strbuf.free(&ix->msg)` left this test green.
    strbuf.append(&b, "    fn i32(");
    i = 0;
    while (i < INDEX_WIDTH) {
        if (i > 0) {
            strbuf.append(&b, ", ");
        }
        strbuf.append(&b, "i32");
        i += 1;
    }
    strbuf.append(&b, ") op = wide;\n    total += op(");
    i = 0;
    while (i < INDEX_WIDTH) {
        if (i > 0) {
            strbuf.append(&b, ", ");
        }
        strbuf.append_u64(&b, i);
        i += 1;
    }
    strbuf.append(&b, ");\n");
    strbuf.append(&b, "    return total;\n}\n");
    // The function the pointer above denotes, declared after it: a module's
    // declarations are order-independent (D7.10).
    strbuf.append(&b, "fn i32 wide(");
    i = 0;
    while (i < INDEX_WIDTH) {
        if (i > 0) {
            strbuf.append(&b, ", ");
        }
        strbuf.append(&b, "i32 a");
        strbuf.append_u64(&b, i);
        i += 1;
    }
    strbuf.append(&b, ") {\n    return a0;\n}\n");
    write_file("indexed.ft", strbuf.view(&b));
}
