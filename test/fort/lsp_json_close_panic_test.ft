//! run
//! flags: -I ../../src/fort -I support -I ../../src
//! abort
//! stderr: panic: json: no container is open
//! stdout:
//| the container ok
import lsp.json;
import std.strbuf;

// A container is closed once. Closing one that was never opened is a violated
// precondition and panics (D13.3).
fn i32 main() {
    strbuf.str_buf mut out = strbuf.create();
    defer strbuf.free(&out);
    json.writer mut w = json.writer{};
    json.write_init(&w, &out);
    json.write_array_begin(&w);
    json.write_array_end(&w);
    assert(strbuf.view(&out) == "[]");
    println("the container ok");
    json.write_array_end(&w);
    println(strbuf.view(&out));
    return 0;
}
