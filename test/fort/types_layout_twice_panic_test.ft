//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: types.type_layout_struct: layout of a struct twice
//! stdout:
//| true
/// `point` already has a resolved layout. Laying it out again breaks a
/// precondition.
import types;
import types_env;

fn main() i32 {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node*[1] mut fields = {types_env.type_of(&e, "i32")};
    u64[1] mut offsets = {};
    println(types.type_layout_begin(e.rec));
    println(types.type_layout_struct(e.point, fields[..], offsets[..]));
    return 0;
}
