//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: consts.cv_to_float_bits: the target is not a float type
//! stdout:
//| true
/// cv_to_float_bits writes a constant in the bits of f32 or f64. An integer target breaks
/// that precondition, so the call panics.
import consts;
import prim;

fn main() i32 {
    u64 mut bits = 0;
    println(consts.cv_to_float_bits(consts.cv_from_i64(1), prim.prim_kind.prim_f64, &bits));
    consts.cv_to_float_bits(consts.cv_from_i64(1), prim.prim_kind.prim_i32, &bits);
    return 0;
}
