//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| literal capacity counts fields ok
//| eight null leaves fit ok
//| sixteen null leaves fit ok
//| sixty-four null leaves fit ok
//| sixty-five fields refused ok
//| sixty-four borrowed copies fit ok
//| mixed sixty-four leaves fit ok
//| sixteen string leaves reach the call ok
//| sixty-four string leaves reach the call ok
//| nested literal stays unsupported ok
/// Checks that a struct literal reserves one slot for each field effect (D17.15).
import fir;
import ownership_api;
import ownership_call_bodies;
import ownership_summary_body;
import ownership_summary_model;

string[46] NULLS = {
    "struct wide8 {",
    "    i32* m0; i32* m1; i32* m2; i32* m3; i32* m4; i32* m5; i32* m6; i32* m7; }",
