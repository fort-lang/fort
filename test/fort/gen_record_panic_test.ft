//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: gen.records_at: index out of range
//! stdout:
//| @.str.0
/// The private-data vectors answer while the index is below len and panic one record later, as
/// containers.str_at does. The slots beyond len hold stale records, and a file name or a string
/// constant read out of one would be written into the module.
import fort.gen;
import gen_env;

fn main() i32 {
    gen_env.env mut* own e = gen_env.make();
    defer gen_env.drop_made(move(e));
    println(gen.gen_str_ref(&e->g, "hi"));
    assert(e->g.strs.len == 1);
    gen.records_at(&e->g.strs, 1);
    return 0;
}
