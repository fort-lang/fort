//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: gen.records_at: index out of range
//! stdout:
//| @.str.0
import gen;
import gen_env;

// The private-data vectors answer while the index is below len and panic one
// record later, as containers.str_at does: the slots beyond len hold stale
// records, and a file name or a string constant read out of one would be
// written into the module (item 5).
// D13.3
fn i32 main() {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    println(gen.gen_str_ref(&e.g, "hi"));
    assert(e.g.strs.len == 1);
    gen.records_at(&e.g.strs, 1);
    return 0;
}
