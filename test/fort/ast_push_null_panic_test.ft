//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: ast.ast_push of a null child
//! stdout:
//| 0
/// Checks that an AST child list rejects a null child. Both compiler implementations panic on
/// this broken precondition.
import ast;
import diag;

fn main() i32 {
    ast.arena mut ar = ast.arena{};
    defer ast.ast_arena_free(&ar);
    ast.node mut* parent = ast.ast_new(&ar, ast.ast_kind.k_block, diag.loc_make("t.ft", 1, 1));
    println(ast.ast_len(parent));
    ast.ast_push(parent, null);
    return 0;
}
