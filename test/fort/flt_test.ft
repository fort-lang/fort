//! run
//! flags: -I ../../src/fort
//! stdout:
//| literals ok
//| binary32 ok
//| arithmetic ok
//| binary32 arithmetic ok
//| comparison ok
//| integers ok
//| text ok
//| parsed values ok
//| parsed digits ok
//| binary64 operations ok
//| binary32 operations ok
//| narrowings ok
//| integer conversions ok
//| orderings ok
//| ok
/// Checks decimal float parsing, rounding, arithmetic, conversions, and the constant text used
/// in IR.
import flt;
import std.strbuf;

//
// Each expected number is the IEEE 754 binary64 pattern of the value. An
// external oracle computed it with exact rational arithmetic and one
// round-to-nearest operation with ties to even. CPython double arithmetic
// agreed with the oracle for 4000 random pairs. A binary32 result is its value
// encoded as binary64. This is how the compiler holds an f32 constant.
//
// The values cover cases where a wrong implementation can look correct. They
// include two known subnormal boundaries, the least subnormal, and both zero
// thresholds. They also include 2^53 and its neighbours, the largest finite
// value, and the first decimal above it. One 902-digit literal tests a final
// digit that changes rounding. A binary32 division differs if binary64 rounds
// it first.

fn want_parse(string text, u64 bits) void {
    u64 mut got = 0;
    bool ok = flt.flt_parse(text, &got);
    if (!ok || got != bits) {
        println("flt_parse(", text, ") = ", got, " ok ", ok, ", want ", bits);
    }
    assert(ok);
    assert(got == bits);
}

// A literal the format cannot hold is a compile error, so the reader answers
// false and the checker reports it.
fn want_parse_refused(string text) void {
    u64 mut got = 0;
    bool ok = flt.flt_parse(text, &got);
    if (ok) {
        println("flt_parse(", text, ") = ", got, ", want a refusal");
    }
    assert(!ok);
}

fn want_bits(string what, u64 got, u64 bits) void {
    if (got != bits) {
        println(what, " = ", got, ", want ", bits);
    }
    assert(got == bits);
}

fn want_int(string what, i64 got, i64 value) void {
    if (got != value) {
        println(what, " = ", got, ", want ", value);
    }
    assert(got == value);
}

// Every literal reads to the binary64 nearest its exact decimal value, ties
// to even. An untyped float constant is evaluated in binary64.
fn the_reader_gives_a_literal_the_binary64_nearest_its_value() void {
    want_parse("1.0", 0x3FF0000000000000);
    want_parse("0.1", 0x3FB999999999999A);
    want_parse("0.0", 0x0000000000000000);
    want_parse("3.5", 0x400C000000000000);
    want_parse("100.0", 0x4059000000000000);
    want_parse("0.0001", 0x3F1A36E2EB1C432D);
    want_parse("1e16", 0x4341C37937E08000);
    want_parse("2.5e-3", 0x3F647AE147AE147B);
    want_parse("1e10", 0x4202A05F20000000);
    want_parse("3.25", 0x400A000000000000);
    want_parse("1E2", 0x4059000000000000);
    want_parse("0.5", 0x3FE0000000000000);
    want_parse("1.5e0", 0x3FF8000000000000);
    want_parse("12_5.0e-3", 0x3FC0000000000000);
    want_parse("1.0e6", 0x412E848000000000);
    want_parse("1.0E-3", 0x3F50624DD2F1A9FC);
    want_parse("7.5", 0x401E000000000000);
    want_parse("2.0", 0x4000000000000000);
    want_parse("0.2", 0x3FC999999999999A);
    want_parse("0.3", 0x3FD3333333333333);
    want_parse("1e21", 0x444B1AE4D6E2EF50);
    want_parse("123456.789", 0x40FE240C9FBE76C9);
    want_parse("0.25", 0x3FD0000000000000);
    want_parse("1e6", 0x412E848000000000);
    want_parse("0e1", 0x0000000000000000);
    want_parse("000.000", 0x0000000000000000);
    want_parse("1_000.000_1", 0x408F4000346DC5D6);
    want_parse("0.1000000000000000055511151231257827021181583404541015625", 0x3FB999999999999A);
    want_parse("9007199254740992.0", 0x4340000000000000);
    want_parse("9007199254740993.0", 0x4340000000000000);
    want_parse("9007199254740995.0", 0x4340000000000002);
    want_parse("0.000000000000000000001", 0x3B92E3B40A0E9B4F);
    want_parse("1e-300", 0x01A56E1FC2F8F359);
    want_parse("1e300", 0x7E37E43C8800759C);
    want_parse("12345678901234567890.0", 0x43E56A95319D63E1);
    want_parse("0.000001", 0x3EB0C6F7A0B5ED8D);
    want_parse("1e-5", 0x3EE4F8B588E368F1);
    want_parse("1234567890123456789012345678901234567890.0", 0x480D064903AE06E0);
}

// The exact midpoint between 1.0 and the value above it has 55 digits and
// goes to the even mantissa, which is 1.0. One more digit below it puts the
// value above the midpoint and it goes up.
fn a_tie_goes_to_the_even_mantissa_and_one_digit_below_it_goes_up() void {
    want_parse("1.00000000000000011102230246251565404236316680908203125", 0x3FF0000000000000);
    want_parse("1.000000000000000111022302462515654042363166809082031251", 0x3FF0000000000001);
}

// The reader keeps 800 significant digits and records a nonzero digit below
// them, which can only turn a tie away from zero. This literal has 902
// digits: it is above 1.0 and below the value after it, so it rounds to 1.0.
// And the reader must not read it as the 1.0 its first 800 digits spell and
// lose the difference.
fn a_digit_below_the_eight_hundred_kept_still_decides_a_tie() void {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "1.");
    u64 mut i = 0;
    while (i < 900) {
        strbuf.push(&b, '0');
        i += 1;
    }
    strbuf.push(&b, '1');
    want_parse(strbuf.view(&b), 0x3FF0000000000000);
}

// A constant that is not finite in its type is a compile error, so the reader
// refuses it rather than producing an infinity. The last one is the first
// decimal above the rounding threshold of the largest finite value, which is
// where a reader starts producing an infinity.
fn a_literal_past_binary64_is_refused() void {
    want_parse_refused("1e309");
    want_parse_refused("1.7976931348623159e308");
    want_parse_refused("1e400");
    want_parse_refused("1.797693134862315808e308");
}

// The cases cover the least subnormal and
// both sides of its half. They also cover the
// normal boundary and largest finite value.
fn the_edges_of_the_range_read_exactly() void {
    want_parse("4.9406564584124654e-324", 0x0000000000000001);
    want_parse("1e-323", 0x0000000000000002);
    want_parse("1e-324", 0x0000000000000000);
    want_parse("2.4703282292062327e-324", 0x0000000000000000);
    want_parse("2.4703282292062328e-324", 0x0000000000000001);
    want_parse("1e-400", 0x0000000000000000);
    want_parse("1e-500", 0x0000000000000000);
    want_parse("2.2250738585072011e-308", 0x000FFFFFFFFFFFFF);
    want_parse("2.2250738585072012e-308", 0x0010000000000000);
    want_parse("2.2250738585072014e-308", 0x0010000000000000);
    want_parse("1.7976931348623157e308", 0x7FEFFFFFFFFFFFFF);
    want_parse("1.797693134862315508e308", 0x7FEFFFFFFFFFFFFE);
    want_parse("1e308", 0x7FE1CCF385EBC8A0);
    want_parse("1.7976931348623158e308", 0x7FEFFFFFFFFFFFFF);
}

fn literals() void {
    the_reader_gives_a_literal_the_binary64_nearest_its_value();
    a_tie_goes_to_the_even_mantissa_and_one_digit_below_it_goes_up();
    a_digit_below_the_eight_hundred_kept_still_decides_a_tie();
    a_literal_past_binary64_is_refused();
    the_edges_of_the_range_read_exactly();
    println("literals ok");
}


// The result of one operation, and the refusal of one that is not finite.
fn want_op(string what, bool ok, u64 got, u64 bits) void {
    if (!ok || got != bits) {
        println(what, " = ", got, " ok ", ok, ", want ", bits);
    }
    assert(ok);
    assert(got == bits);
}

fn want_refused(string what, bool ok) void {
    if (ok) {
        println(what, " was folded, want a refusal");
    }
    assert(!ok);
}

// flt_to_f32 rounds to binary32 and answers with the binary64 of that value,
// which is exact: 24 mantissa bits out of 53.
fn a_value_rounds_to_binary32_once_and_keeps_its_binary64_form() void {
    // 0.1
    want_bits("f32 0.1", to_f32(0x3FB999999999999A), 0x3FB99999A0000000);
    // 1.5
    want_bits("f32 1.5", to_f32(0x3FF8000000000000), 0x3FF8000000000000);
    // 0.25
    want_bits("f32 0.25", to_f32(0x3FD0000000000000), 0x3FD0000000000000);
    // 16777217.0
    want_bits("f32 16777217.0", to_f32(0x4170000010000000), 0x4170000000000000);
    // 16777219.0
    want_bits("f32 16777219.0", to_f32(0x4170000030000000), 0x4170000040000000);
    // 0.0
    want_bits("f32 0.0", to_f32(0x0000000000000000), 0x0000000000000000);
    // the least binary32 subnormal
    want_bits("f32 1.401298464324817e-45", to_f32(0x36A0000000000000), 0x36A0000000000000);
    // half of it, a tie that goes to zero
    want_bits("f32 7.006492321624085e-46", to_f32(0x3690000000000000), 0x0000000000000000);
    // just above half of it
    want_bits("f32 7.006492321624087e-46", to_f32(0x3690000000000001), 0x36A0000000000000);
    // below half of it
    want_bits("f32 1e-46", to_f32(0x366244CE242C5561), 0x0000000000000000);
    // the largest finite binary32
    want_bits("f32 3.4028234663852886e38", to_f32(0x47EFFFFFE0000000), 0x47EFFFFFE0000000);
    // above it and below the rounding threshold
    want_bits("f32 3.402823466385289e38", to_f32(0x47EFFFFFE0000001), 0x47EFFFFFE0000000);
    // the least normal binary32
    want_bits("f32 1.1754943508222875e-38", to_f32(0x3810000000000000), 0x3810000000000000);
    // far below the subnormals of binary32
    want_bits("f32 1e-300", to_f32(0x01A56E1FC2F8F359), 0x0000000000000000);
}

// The rounding threshold of binary32 is (2 - 2^-24) * 2^127. From it upward
// the value is not finite in binary32, which is a compile error.
fn a_value_past_binary32_is_refused() void {
    want_f32_refused("3.4028235677973366e38", 0x47EFFFFFF0000000);
    want_f32_refused("3.5e38", 0x47F074F8C4D3CD7B);
    want_f32_refused("1e39", 0x48078287F49C4A1D);
    want_f32_refused("1e300", 0x7E37E43C8800759C);
}

// A zero rounds to a zero of the same sign.
// The sign bit distinguishes the two zeros.
fn a_zero_keeps_its_sign_through_binary32() void {
    want_bits("f32 -0.0", to_f32(0x8000000000000000), 0x8000000000000000);
    want_bits("f32 0.0", to_f32(0), 0);
}

// flt_to_f32 as an expression, since every case below asserts its result.
fn to_f32(u64 bits) u64 {
    u64 mut got = 0;
    bool ok = flt.flt_to_f32(bits, &got);
    assert(ok);
    return got;
}

fn want_f32_refused(string text, u64 bits) void {
    u64 mut got = 0;
    bool ok = flt.flt_to_f32(bits, &got);
    if (ok) {
        println("f32 ", text, " = ", got, ", want a refusal");
    }
    assert(!ok);
}

fn binary32() void {
    a_value_rounds_to_binary32_once_and_keeps_its_binary64_form();
    a_value_past_binary32_is_refused();
    a_zero_keeps_its_sign_through_binary32();
    println("binary32 ok");
}

// Each result is the exact sum, difference, product or quotient rounded to
// binary64 once, to nearest with ties to even. The zeros carry the signs IEEE
// 754 gives them. A sum of two zeros is negative only when both are, x - x is
// +0.0, and a product takes the two signs combined.
fn the_four_operations_round_their_exact_result_once() void {
    u64 mut got = 0;
    want_op("0.1 + 0.2", flt.flt_add(0x3FB999999999999A, 0x3FC999999999999A, false, &got), got,
            0x3FD3333333333334);
    want_op("7.5 + 2.0", flt.flt_add(0x401E000000000000, 0x4000000000000000, false, &got), got,
            0x4023000000000000);
    want_op("7.5 / 2.0", flt.flt_div(0x401E000000000000, 0x4000000000000000, false, &got), got,
            0x400E000000000000);
    want_op("2.0 * 0.5", flt.flt_mul(0x4000000000000000, 0x3FE0000000000000, false, &got), got,
            0x3FF0000000000000);
    want_op("1.0 / 3.0", flt.flt_div(0x3FF0000000000000, 0x4008000000000000, false, &got), got,
            0x3FD5555555555555);
    want_op("-5.0 / 2.0", flt.flt_div(0xC014000000000000, 0x4000000000000000, false, &got), got,
            0xC004000000000000);
    want_op("1.0 - 0.9", flt.flt_sub(0x3FF0000000000000, 0x3FECCCCCCCCCCCCD, false, &got), got,
            0x3FB9999999999998);
    want_op("1e16 + 1.0", flt.flt_add(0x4341C37937E08000, 0x3FF0000000000000, false, &got), got,
            0x4341C37937E08000);
    want_op("1e300 + 1e-300", flt.flt_add(0x7E37E43C8800759C, 0x01A56E1FC2F8F359, false, &got),
            got, 0x7E37E43C8800759C);
    want_op("1e300 * 1e-300", flt.flt_mul(0x7E37E43C8800759C, 0x01A56E1FC2F8F359, false, &got),
            got, 0x3FF0000000000000);
    want_op("2^53 + 1.0", flt.flt_add(0x4340000000000000, 0x3FF0000000000000, false, &got), got,
            0x4340000000000000);
    want_op("2^53 + 2.0", flt.flt_add(0x4340000000000000, 0x4000000000000000, false, &got), got,
            0x4340000000000001);
    want_op("2^53 + 2 + 1.0", flt.flt_add(0x4340000000000001, 0x3FF0000000000000, false, &got),
            got, 0x4340000000000002);
    want_op("0.1 * 0.1", flt.flt_mul(0x3FB999999999999A, 0x3FB999999999999A, false, &got), got,
            0x3F847AE147AE147C);
    want_op("123456.789 - 123456.0", flt.flt_sub(0x40FE240C9FBE76C9, 0x40FE240000000000, false,
            &got), got, 0x3FE93F7CED920000);
    want_op("least subnormal * 1.5", flt.flt_mul(0x0000000000000001, 0x3FF8000000000000, false,
            &got), got, 0x0000000000000002);
    want_op("least subnormal / 2.0", flt.flt_div(0x0000000000000001, 0x4000000000000000, false,
            &got), got, 0x0000000000000000);
    want_op("three subnormals / 2.0", flt.flt_div(0x0000000000000003, 0x4000000000000000, false,
            &got), got, 0x0000000000000002);
    want_op("1e-320 * 1e-10", flt.flt_mul(0x00000000000007E8, 0x3DDB7CDFD9D7BDBB, false, &got),
            got, 0x0000000000000000);
    want_op("least normal / 2.0", flt.flt_div(0x0010000000000000, 0x4000000000000000, false, &got),
            got, 0x0008000000000000);
    want_op("1.0 * 0.0", flt.flt_mul(0x3FF0000000000000, 0x0000000000000000, false, &got), got,
            0x0000000000000000);
    want_op("-1.0 * 0.0", flt.flt_mul(0xBFF0000000000000, 0x0000000000000000, false, &got), got,
            0x8000000000000000);
    want_op("0.0 / -1.0", flt.flt_div(0x0000000000000000, 0xBFF0000000000000, false, &got), got,
            0x8000000000000000);
    want_op("1.0 - 1.0", flt.flt_sub(0x3FF0000000000000, 0x3FF0000000000000, false, &got), got,
            0x0000000000000000);
    want_op("-0.0 + 0.0", flt.flt_add(0x8000000000000000, 0x0000000000000000, false, &got), got,
            0x0000000000000000);
    want_op("-0.0 + -0.0", flt.flt_add(0x8000000000000000, 0x8000000000000000, false, &got), got,
            0x8000000000000000);
    want_op("0.0 - 0.0", flt.flt_sub(0x0000000000000000, 0x0000000000000000, false, &got), got,
            0x0000000000000000);
    want_op("0.0 - -0.0", flt.flt_sub(0x0000000000000000, 0x8000000000000000, false, &got), got,
            0x0000000000000000);
    want_op("-0.0 - 0.0", flt.flt_sub(0x8000000000000000, 0x0000000000000000, false, &got), got,
            0x8000000000000000);
    want_op("max + 1e291", flt.flt_add(0x7FEFFFFFFFFFFFFF, 0x7C59A742461887F6, false, &got), got,
            0x7FEFFFFFFFFFFFFF);
}

// A division by zero yields an infinity or a NaN and an overflow yields an
// infinity. Neither is a constant, so the fold answers false and the checker
// reports the error.
fn an_operation_that_leaves_the_range_is_refused() void {
    u64 mut got = 0;
    want_refused("1.0 / 0.0", flt.flt_div(0x3FF0000000000000, 0x0000000000000000, false, &got));
    want_refused("-1.0 / 0.0", flt.flt_div(0xBFF0000000000000, 0x0000000000000000, false, &got));
    want_refused("0.0 / 0.0", flt.flt_div(0x0000000000000000, 0x0000000000000000, false, &got));
    want_refused("1.0 / -0.0", flt.flt_div(0x3FF0000000000000, 0x8000000000000000, false, &got));
    want_refused("1e308 + 1e308", flt.flt_add(0x7FE1CCF385EBC8A0, 0x7FE1CCF385EBC8A0, false, &got));
    want_refused("max * 2.0", flt.flt_mul(0x7FEFFFFFFFFFFFFF, 0x4000000000000000, false, &got));
    want_refused("max + 1e292", flt.flt_add(0x7FEFFFFFFFFFFFFF, 0x7C9008896BCF54FA, false, &got));
    want_refused("-max - 1e292", flt.flt_sub(0xFFEFFFFFFFFFFFFF, 0x7C9008896BCF54FA, false, &got));
    want_refused("1e300 / 1e-300", flt.flt_div(0x7E37E43C8800759C, 0x01A56E1FC2F8F359, false,
                 &got));
}

fn arithmetic() void {
    the_four_operations_round_their_exact_result_once();
    an_operation_that_leaves_the_range_is_refused();
    println("arithmetic ok");
}

// The operands are binary32 values held in binary64 and the result is the
// exact result rounded to binary32, not to binary64 and then narrowed.
fn a_binary32_operation_rounds_to_binary32_directly() void {
    u64 mut got = 0;
    want_op("1.5 + 0.25", flt.flt_add(0x3FF8000000000000, 0x3FD0000000000000, true, &got), got,
            0x3FFC000000000000);
    want_op("0.1 + 0.2", flt.flt_add(0x3FB99999A0000000, 0x3FC99999A0000000, true, &got), got,
            0x3FD3333340000000);
    want_op("1.0 / 3.0", flt.flt_div(0x3FF0000000000000, 0x4008000000000000, true, &got), got,
            0x3FD5555560000000);
    want_op("16777216.0 + 1.0", flt.flt_add(0x4170000000000000, 0x3FF0000000000000, true, &got),
            got, 0x4170000000000000);
    want_op("16777216.0 + 2.0", flt.flt_add(0x4170000000000000, 0x4000000000000000, true, &got),
            got, 0x4170000020000000);
    want_op("least subnormal / 2.0", flt.flt_div(0x36A0000000000000, 0x4000000000000000, true,
            &got), got, 0x0000000000000000);
    want_op("least subnormal * 1.5", flt.flt_mul(0x36A0000000000000, 0x3FF8000000000000, true,
            &got), got, 0x36B0000000000000);
}

// A quotient of two binary32 values, rounded to binary32 from the exact
// result.
//
// It pins the result and not a difference between two methods, because there
// is no difference to pin. Binary64 has 53 mantissa bits and 53 >= 2 * 24 +
// 2. Double rounding gives the same binary32 result
// for each exact binary32 operation. This is
// Figueroa's condition. A search over 231660 operand pairs of
// the four operations, half of them drawn from subnormal exponents, found no
// pair where the two differ. The reading is the one class where two roundings
// are observable, and run/constants/011_float_two_roundings.ft holds it.
fn a_binary32_division_rounds_to_binary32_directly() void {
    u64 mut got = 0;
    want_op("the quotient of two binary32 values",
            flt.flt_div(0x3DD8B9EC00000000, 0xC1B98C5920000000, true, &got), got,
            0xBC0EF86F20000000);
}

fn a_binary32_operation_past_the_range_is_refused() void {
    u64 mut got = 0;
    want_refused("largest binary32 * 2.0", flt.flt_mul(0x47EFFFFFE0000000, 0x4000000000000000,
                 true, &got));
    want_refused("largest binary32 + itself", flt.flt_add(0x47EFFFFFE0000000, 0x47EFFFFFE0000000,
                 true, &got));
}

fn binary32_arithmetic() void {
    a_binary32_operation_rounds_to_binary32_directly();
    a_binary32_division_rounds_to_binary32_directly();
    a_binary32_operation_past_the_range_is_refused();
    println("binary32 arithmetic ok");
}

// Each value is finite. Negative
// values precede positive values,
// and the two zeros compare equal.
fn the_ordering_is_the_ordering_of_the_values() void {
    u64 mut zero = 0;
    want_int("cmp 0.1 0.2", cast(flt.flt_cmp(0x3FB999999999999A, 0x3FC999999999999A), i64), -1);
    want_int("cmp -0.1 -0.2", cast(flt.flt_cmp(0xBFB999999999999A, 0xBFC999999999999A), i64), 1);
    want_int("cmp -0.1 0.2", cast(flt.flt_cmp(0xBFB999999999999A, 0x3FC999999999999A), i64), -1);
    want_int("cmp 0.2 0.1", cast(flt.flt_cmp(0x3FC999999999999A, 0x3FB999999999999A), i64), 1);
    want_int("cmp -0.2 -0.1", cast(flt.flt_cmp(0xBFC999999999999A, 0xBFB999999999999A), i64), -1);
    want_int("cmp -0.2 0.1", cast(flt.flt_cmp(0xBFC999999999999A, 0x3FB999999999999A), i64), -1);
    want_int("cmp 1.0 1.0", cast(flt.flt_cmp(0x3FF0000000000000, 0x3FF0000000000000), i64), 0);
    want_int("cmp -1.0 -1.0", cast(flt.flt_cmp(0xBFF0000000000000, 0xBFF0000000000000), i64), 0);
    want_int("cmp -1.0 1.0", cast(flt.flt_cmp(0xBFF0000000000000, 0x3FF0000000000000), i64), -1);
    want_int("cmp 0.0 0.0", cast(flt.flt_cmp(0x0000000000000000, 0x0000000000000000), i64), 0);
    want_int("cmp -0.0 -0.0", cast(flt.flt_cmp(0x8000000000000000, 0x8000000000000000), i64), 0);
    want_int("cmp -0.0 0.0", cast(flt.flt_cmp(0x8000000000000000, 0x0000000000000000), i64), 0);
    want_int("cmp 1e300 1e-300", cast(flt.flt_cmp(0x7E37E43C8800759C, 0x01A56E1FC2F8F359), i64), 1);
    want_int("cmp -1e300 -1e-300", cast(flt.flt_cmp(0xFE37E43C8800759C, 0x81A56E1FC2F8F359), i64),
             -1);
    want_int("cmp -1e300 1e-300", cast(flt.flt_cmp(0xFE37E43C8800759C, 0x01A56E1FC2F8F359), i64),
             -1);
    want_int("cmp 4.9406564584124654e-324 0.0", cast(flt.flt_cmp(0x0000000000000001,
             0x0000000000000000), i64), 1);
    want_int("cmp -4.9406564584124654e-324 -0.0", cast(flt.flt_cmp(0x8000000000000001,
             0x8000000000000000), i64), -1);
    want_int("cmp -4.9406564584124654e-324 0.0", cast(flt.flt_cmp(0x8000000000000001,
             0x0000000000000000), i64), -1);
    want_int("cmp 1.7976931348623157e308 1e300", cast(flt.flt_cmp(0x7FEFFFFFFFFFFFFF,
             0x7E37E43C8800759C), i64), 1);
    want_int("cmp -1.7976931348623157e308 -1e300", cast(flt.flt_cmp(0xFFEFFFFFFFFFFFFF,
             0xFE37E43C8800759C), i64), -1);
    want_int("cmp -1.7976931348623157e308 1e300", cast(flt.flt_cmp(0xFFEFFFFFFFFFFFFF,
             0x7E37E43C8800759C), i64), -1);
}

// -0.0 == 0.0, and unary minus flips the sign bit rather than subtracting
// from zero: the two differ on a zero. This is because 0.0 - 0.0 is +0.0 and -(0.0) is
// -0.0.
fn the_two_zeros_are_equal_and_a_negation_is_the_sign_bit() void {
    want_int("cmp 0.0 -0.0", cast(flt.flt_cmp(0, 0x8000000000000000), i64), 0);
    want_int("cmp -0.0 0.0", cast(flt.flt_cmp(0x8000000000000000, 0), i64), 0);
    assert(flt.flt_is_zero(0));
    assert(flt.flt_is_zero(0x8000000000000000));
    assert(!flt.flt_is_zero(0x0000000000000001));
    want_bits("-(0.0)", flt.flt_neg(0), 0x8000000000000000);
    want_bits("-(-0.0)", flt.flt_neg(0x8000000000000000), 0);
    want_bits("-(1.0)", flt.flt_neg(0x3FF0000000000000), 0xBFF0000000000000);
    want_bits("-(-1.0)", flt.flt_neg(0xBFF0000000000000), 0x3FF0000000000000);
}

fn comparison() void {
    the_ordering_is_the_ordering_of_the_values();
    the_two_zeros_are_equal_and_a_negation_is_the_sign_bit();
    println("comparison ok");
}

// An integer constant in a float context takes that float type, rounded to
// nearest. 2^53 + 1 and 2^24 + 1 are the first values their formats cannot
// hold, and each one goes to the even mantissa.
fn an_integer_constant_rounds_to_the_nearest_value() void {
    u64 mut got = 0;
    want_from_int(false, 0, false, 0x0000000000000000);
    want_from_int(false, 1, false, 0x3FF0000000000000);
    want_from_int(true, 1, false, 0xBFF0000000000000);
    want_from_int(false, 2, false, 0x4000000000000000);
    want_from_int(true, 2, false, 0xC000000000000000);
    want_from_int(false, 7, false, 0x401C000000000000);
    want_from_int(true, 7, false, 0xC01C000000000000);
    want_from_int(false, 255, false, 0x406FE00000000000);
    want_from_int(true, 255, false, 0xC06FE00000000000);
    want_from_int(false, 12345, false, 0x40C81C8000000000);
    want_from_int(true, 12345, false, 0xC0C81C8000000000);
    want_from_int(false, 16777216, false, 0x4170000000000000);
    want_from_int(true, 16777216, false, 0xC170000000000000);
    want_from_int(false, 16777217, false, 0x4170000010000000);
    want_from_int(true, 16777217, false, 0xC170000010000000);
    want_from_int(false, 16777219, false, 0x4170000030000000);
    want_from_int(true, 16777219, false, 0xC170000030000000);
    want_from_int(false, 9007199254740992, false, 0x4340000000000000);
    want_from_int(true, 9007199254740992, false, 0xC340000000000000);
    want_from_int(false, 9007199254740993, false, 0x4340000000000000);
    want_from_int(true, 9007199254740993, false, 0xC340000000000000);
    want_from_int(false, 9007199254740995, false, 0x4340000000000002);
    want_from_int(true, 9007199254740995, false, 0xC340000000000002);
    want_from_int(false, 9223372036854775808, false, 0x43E0000000000000);
    want_from_int(true, 9223372036854775808, false, 0xC3E0000000000000);
    want_from_int(false, 18446744073709551615, false, 0x43F0000000000000);
    want_from_int(true, 18446744073709551615, false, 0xC3F0000000000000);
    want_from_int(false, 16777217, false, 0x4170000010000000);
    want_from_int(true, 16777217, false, 0xC170000010000000);
    want_from_int(false, 10000000000000000000, false, 0x43E158E460913D00);
    want_from_int(true, 10000000000000000000, false, 0xC3E158E460913D00);
}

// Binary32 rounds 16777217 because it is the first integer the format cannot hold.
fn an_integer_constant_rounds_to_binary32_the_same_way() void {
    u64 mut got = 0;
    want_from_int(false, 0, true, 0x0000000000000000);
    want_from_int(false, 1, true, 0x3FF0000000000000);
    want_from_int(false, 16777216, true, 0x4170000000000000);
    want_from_int(false, 16777217, true, 0x4170000000000000);
    want_from_int(false, 16777219, true, 0x4170000040000000);
    want_from_int(false, 16777217, true, 0x4170000000000000);
    want_from_int(false, 9007199254740992, true, 0x4340000000000000);
    want_from_int(false, 18446744073709551615, true, 0x43F0000000000000);
    want_from_int(false, 12345, true, 0x40C81C8000000000);
}

// A float to integer cast truncates toward zero, so 2.5 gives 2 and -2.5
// gives -2. The sign of the zero comes through, since the caller needs it to
// saturate at the right end.
fn a_value_truncates_toward_zero() void {
    bool mut neg = false;
    u64 mut mag = 0;
    want_to_int("2.5", 0x4004000000000000, false, 2);
    want_to_int("-2.5", 0xC004000000000000, true, 2);
    want_to_int("0.5", 0x3FE0000000000000, false, 0);
    want_to_int("-0.5", 0xBFE0000000000000, true, 0);
    want_to_int("0.0", 0x0000000000000000, false, 0);
    want_to_int("-0.0", 0x8000000000000000, true, 0);
    want_to_int("1.0", 0x3FF0000000000000, false, 1);
    want_to_int("-1.0", 0xBFF0000000000000, true, 1);
    want_to_int("123456.789", 0x40FE240C9FBE76C9, false, 123456);
    want_to_int("1e19", 0x43E158E460913D00, false, 10000000000000000000);
    want_to_int("9223372036854775808.0", 0x43E0000000000000, false, 9223372036854775808);
    want_to_int("4.9406564584124654e-324", 0x0000000000000001, false, 0);
    want_to_int("18446744073709549568.0", 0x43EFFFFFFFFFFFFF, false, 18446744073709549568);
}

// flt_to_int answers false when the magnitude is past 2^64 - 1, and the
// caller saturates at the range of the target type.
fn a_value_past_the_widest_integer_is_left_to_the_caller() void {
    bool mut neg = false;
    u64 mut mag = 0;
    want_to_int_refused("1e20", 0x4415AF1D78B58C40);
    want_to_int_refused("1.7976931348623157e308", 0x7FEFFFFFFFFFFFFF);
    want_to_int_refused("1e30", 0x46293E5939A08CEA);
}

fn integers() void {
    an_integer_constant_rounds_to_the_nearest_value();
    an_integer_constant_rounds_to_binary32_the_same_way();
    a_value_truncates_toward_zero();
    a_value_past_the_widest_integer_is_left_to_the_caller();
    println("integers ok");
}

// An LLVM float or double constant is written as 0x and the sixteen hex
// digits of the binary64 pattern, upper case. The last
// line is binary32 0.1. Its pattern ends in 29 zero
// bits because the type must hold the binary64 exactly.
fn a_constant_prints_as_the_sixteen_hex_digits_of_its_pattern() void {
    want_hex(0x3FB999999999999A, "0x3FB999999999999A");
    want_hex(0x3FF0000000000000, "0x3FF0000000000000");
    want_hex(0x0000000000000000, "0x0000000000000000");
    want_hex(0x4341C37937E08000, "0x4341C37937E08000");
    want_hex(0x400C000000000000, "0x400C000000000000");
    want_hex(0x3F647AE147AE147B, "0x3F647AE147AE147B");
    want_hex(0x8000000000000000, "0x8000000000000000");
    want_hex(0x3FB99999A0000000, "0x3FB99999A0000000");
    // The largest finite value of each format and the least subnormal: every
    // digit of the pattern moves. So a text built from the wrong end or with
    // a short digit count is caught here.
    want_hex(0x7FEFFFFFFFFFFFFF, "0x7FEFFFFFFFFFFFFF");
    want_hex(0x47EFFFFFE0000000, "0x47EFFFFFE0000000");
    want_hex(0x0000000000000001, "0x0000000000000001");
}

fn text() void {
    a_constant_prints_as_the_sixteen_hex_digits_of_its_pattern();
    println("text ok");
}

fn want_from_int(bool neg, u64 mag, bool is_f32, u64 bits) void {
    u64 mut got = 0;
    bool ok = flt.flt_from_int(neg, mag, is_f32, &got);
    if (!ok || got != bits) {
        println("from_int(", neg, ", ", mag, ") = ", got, " ok ", ok, ", want ", bits);
    }
    assert(ok);
    assert(got == bits);
}

fn want_to_int(string what, u64 bits, bool neg, u64 mag) void {
    bool mut got_neg = false;
    u64 mut got_mag = 0;
    bool ok = flt.flt_to_int(bits, &got_neg, &got_mag);
    if (!ok || got_neg != neg || got_mag != mag) {
        println("to_int(", what, ") = ", got_neg, " ", got_mag, " ok ", ok, ", want ", neg,
                " ", mag);
    }
    assert(ok);
    assert(got_neg == neg);
    assert(got_mag == mag);
}

fn want_to_int_refused(string what, u64 bits) void {
    bool mut neg = false;
    u64 mut mag = 0;
    bool ok = flt.flt_to_int(bits, &neg, &mag);
    if (ok) {
        println("to_int(", what, ") = ", mag, ", want a refusal");
    }
    assert(!ok);
}

fn want_hex(u64 bits, string text) void {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    flt.flt_hex(bits, &b);
    string got = strbuf.view(&b);
    if (got != text) {
        println("flt_hex(", bits, ") = ", got, ", want ", text);
    }
    assert(got == text);
}

// ---- the vectors -----------------------------------------------------------------

// The following values use the same exact-rational oracle as the cases above.
// The stored values make the evidence reproducible.
//
// The random values use five classes.
// These include normals, scaled small
// integers, near-subnormal exponents, and
// subnormals. The fifth class uses exponents near
// the largest finite value. Boundary classes
// exercise guard bits, exponent clamps, and mantissa carry.

// A literal and the pattern it reads to.
fn p(string text, u64 bits) void {
    want_parse(text, bits);
}

// One operation in binary64 and in binary32.
fn fadd64(u64 a, u64 b, u64 want) void {
    u64 mut got = 0;
    want_op("add", flt.flt_add(a, b, false, &got), got, want);
}

fn fsub64(u64 a, u64 b, u64 want) void {
    u64 mut got = 0;
    want_op("sub", flt.flt_sub(a, b, false, &got), got, want);
}

fn fmul64(u64 a, u64 b, u64 want) void {
    u64 mut got = 0;
    want_op("mul", flt.flt_mul(a, b, false, &got), got, want);
}

fn fdiv64(u64 a, u64 b, u64 want) void {
    u64 mut got = 0;
    want_op("div", flt.flt_div(a, b, false, &got), got, want);
}

fn fadd32(u64 a, u64 b, u64 want) void {
    u64 mut got = 0;
    want_op("add32", flt.flt_add(a, b, true, &got), got, want);
}

fn fsub32(u64 a, u64 b, u64 want) void {
    u64 mut got = 0;
    want_op("sub32", flt.flt_sub(a, b, true, &got), got, want);
}

fn fmul32(u64 a, u64 b, u64 want) void {
    u64 mut got = 0;
    want_op("mul32", flt.flt_mul(a, b, true, &got), got, want);
}

fn fdiv32(u64 a, u64 b, u64 want) void {
    u64 mut got = 0;
    want_op("div32", flt.flt_div(a, b, true, &got), got, want);
}

// A narrowing to binary32, and one the format cannot hold.
fn n(u64 bits, u64 want) void {
    want_bits("to_f32", to_f32(bits), want);
}

fn n_refused(u64 bits) void {
    want_f32_refused("to_f32", bits);
}

// An integer to a float, in either format.
fn fi(bool neg, u64 mag, u64 want) void {
    want_from_int(neg, mag, false, want);
}

fn fi32(bool neg, u64 mag, u64 want) void {
    want_from_int(neg, mag, true, want);
}

// A float to an integer, truncated toward zero.
fn ti(u64 bits, bool neg, u64 mag) void {
    want_to_int("trunc", bits, neg, mag);
}

fn ti_refused(u64 bits) void {
    want_to_int_refused("trunc", bits);
}

// One comparison.
fn c(u64 a, u64 b, i64 want) void {
    want_int("cmp", cast(flt.flt_cmp(a, b), i64), want);
}

