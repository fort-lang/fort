//! run
//! flags: -I support
//! stdout:
//| ok
/// The live view of support/heap.ft: how far it moves when the program holds
/// and releases blocks at the edges of the sizes of the allocator of the
/// runtime. The view is exact, so each assertion holds one number on each
/// target.
import heap;

// The allocator keeps a multiple of 16 bytes for an allocation of at most
// 2048000 bytes, and at least 16 bytes. Above that size it keeps a multiple of
// 2 MiB (std.heap.kept_bytes).
u64 GRANULE = 16;
u64 SMALL_MOST = 2048000;
u64 CHUNK = 2097152;

// The size of the block of the nested rounds, and the count of the blocks
// that the program holds at once.
u64 SMALL = 64;
u64 NEST = 16;

// How far the view went up from `before` to `after`. It must not go down.
fn rise(u64 before, u64 after) u64 {
    assert(after >= before);
    return after - before;
}

// Holds a block of `size` bytes and releases it. Returns how far the block
// moved the view while the program held it. The release takes the view back
// to where it was.
fn held(u64 size) u64 {
    u64 before = heap.live_view();
    u8 mut@ own block = new(u8, size);
    u64 during = heap.live_view();
    del(block);
    assert(heap.live_view() == before);
    return rise(before, during);
}

// Holds `depth` small blocks at once, one in each frame, and checks the view
// in each frame: each block that the program holds is in the count.
fn hold_nested(u64 depth, u64 before) void {
    u8 mut@ own block = new(u8, SMALL);
    assert(rise(before, heap.live_view()) == (NEST - depth + 1) * SMALL);
    if (depth > 1) {
        hold_nested(depth - 1, before);
    }
    assert(rise(before, heap.live_view()) == (NEST - depth + 1) * SMALL);
    del(block);
    assert(rise(before, heap.live_view()) == (NEST - depth) * SMALL);
}

fn a_block_moves_the_view_by_the_bytes_that_the_allocator_keeps() void {
    // an allocation of 0 bytes is an allocation, and it counts as the smallest one
    assert(held(0) == GRANULE);
    assert(held(1) == GRANULE);
    assert(held(GRANULE) == GRANULE);
    assert(held(GRANULE + 1) == 2 * GRANULE);
    assert(held(SMALL) == SMALL);
    assert(held(SMALL_MOST - GRANULE + 1) == SMALL_MOST);
    assert(held(SMALL_MOST) == SMALL_MOST);
    // the first size that takes whole chunks
    assert(held(SMALL_MOST + 1) == CHUNK);
    assert(held(CHUNK) == CHUNK);
    assert(held(CHUNK + 1) == 2 * CHUNK);
}

fn the_view_counts_each_block_that_the_program_holds() void {
    u64 before = heap.live_view();
    hold_nested(NEST, before);
    assert(heap.live_view() == before);
    // a second pass reads the same numbers: no cache of the allocator hides a block
    hold_nested(NEST, before);
    assert(heap.live_view() == before);
}

// A block that a round keeps moves the view by its bytes in each round, which
// is what a leak probe holds.
fn a_kept_block_moves_the_view_in_each_round() void {
    u64 before = heap.live_view();
    u8 mut@ own first = new(u8, SMALL);
    u64 one = heap.live_view();
    u8 mut@ own second = new(u8, SMALL);
    u64 two = heap.live_view();
    assert(rise(before, one) == SMALL);
    assert(rise(one, two) == SMALL);
    assert(heap.distance(before, two) == 2 * SMALL);
    assert(heap.distance(two, before) == 2 * SMALL);
    del(second);
    del(first);
    assert(heap.distance(before, heap.live_view()) == 0);
}

fn main() i32 {
    a_block_moves_the_view_by_the_bytes_that_the_allocator_keeps();
    the_view_counts_each_block_that_the_program_holds();
    a_kept_block_moves_the_view_in_each_round();
    println("ok");
    return 0;
}
