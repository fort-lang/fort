    v4_integer_forms_take_integers_of_one_type();
    v4_bitwise_shift_and_float_forms();
    v4_comparisons_take_scalars_and_order_numbers();
    v4_casts_follow_d3_14();
    v4_slices_and_allocations();
    v4_aggregates_fill_every_field_or_element();
    v4_calls_switches_and_checks();
    v4_an_rvalue_has_the_count_of_its_form();
    v4_a_switch_names_each_value_once();
    v4_an_overwrite_check_names_its_place();
    v4_no_address_and_no_allocation_of_void();
    println("V4 ok");
    v5_move_and_del_take_owning_places();
    v6_an_owning_place_takes_a_move_a_constant_or_an_owning_rvalue();
    v6_owning_parameters_and_members_take_a_move_or_a_constant();
    v6_a_literal_fills_no_owning_position();
    v6_an_owning_value_lands_in_an_owning_position();
    v6_a_cast_never_adds_own();
    println("V5 V6 ok");
    v7_a_call_matches_its_callee();
    v7_a_check_reports_what_its_runtime_entry_takes();
    v7_a_runtime_entry_matches_its_kind();
    v7_every_kind_holds_its_operands_against_its_entry();
