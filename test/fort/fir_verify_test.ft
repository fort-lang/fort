    v8_a_noreturn_call_ends_its_block_in_trap();
    v10_live_and_dead_name_a_named_local();
    the_lowest_rule_wins_over_an_earlier_block();
    println("V8 V10 ok");
    v9_no_path_from_bb0_reaches_unreachable();
    v9_a_switch_on_a_constant_takes_the_selected_edge_only();
    v9_keeps_a_function_that_ends_in_return_or_an_abort();
    println("V9 ok");
    v11_the_continuation_of_a_check_has_one_predecessor();
    v11_keeps_a_continuation_that_only_its_check_names();
    println("V11 ok");
    v12_no_read_of_a_temporary_after_a_move_of_it();
    v12_a_move_takes_effect_at_its_operand();
    v12_follows_the_moves_of_every_path();
    v12_a_move_of_a_part_empties_the_temporary();
    println("V12 ok");
    v13_no_read_of_a_temporary_before_an_assignment_of_it();
