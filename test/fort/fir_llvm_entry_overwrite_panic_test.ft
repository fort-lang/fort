//! run
//! flags: -I ../../src
//! abort
//! stderr: panic: fir_llvm.entry_of: the overwrite check has no runtime entry
//! stdout:
//| true
/// The kind `overwrite` names no runtime entry (spec/fir.md 8). The verifier refuses a `fail` of
/// that kind (rule V7), and the build-mode pass removes each `check(overwrite: p)`, so no item
/// asks the translator for its entry. A call that asks breaks that precondition and panics.
import fort.fir;
import fort.fir_llvm;
import fort.runtime_sig;

// A panic ends the program, so the case stands in a file of its own.
fn main() i32 {
    println(fir_llvm.entry_of(fir.check_kind.chk_panic) == runtime_sig.rt_entry.rt_panic);
    fir_llvm.entry_of(fir.check_kind.chk_overwrite);
    return 0;
}
