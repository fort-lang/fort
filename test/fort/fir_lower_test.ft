//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| declarations ok
//| locals ok
//| indices ok
//| ends ok
//| refusals ok
//| program ok
/// Checks the lowering of fort to FIR (spec/fir.md 9): scalar declarations, the numbers of the
/// named locals, the statement index, the end of a body, and the report of a construct that the
/// lowering does not lower. Each case lowers one function of a checked source, holds that the
/// result keeps every rule of the verifier, and compares its text.
import ast;
import check_env;
import fir;
import fir_lower;
import fir_print;
import fir_verify;
import gen;
import lower_env;
import modules_env;
import std.str;
import std.strbuf;

// ---- declarations -----------------------------------------------------------------------------

// The case of the ticket: a constant, a name and a scalar `return`. Each statement takes the index
// of its source statement, and each assignment the location of its expression.
fn a_scalar_declaration_takes_a_constant_or_a_name() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[1] source = {"fn f(i32 a) i32 { i32 b = 1; i32 c = a; return c; }"};
    string[16] want = {
        "fn main.f(_1 (a): i32) -> i32 {",
        "    let _0: i32;",
        "    let _2 (b): i32 #1:23;",
        "    let _3 (c): i32 #1:34;",
        "",
        "    bb0: {",
        "        live(_2) #1:23 s1;",
        "        _2 = const i32 1 #1:27 s1;",
        "        live(_3) #1:34 s2;",
        "        _3 = copy _1 #1:38 s2;",
        "        _0 = copy _3 #1:48 s3;",
        "        dead(_2) #1:41 s3;",
        "        dead(_3) #1:41 s3;",
        "        return #1:41 s3;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "f"), want[..]);
}

// A global reads its place, a module-level constant is folded, and a function is a constant. A
// declaration of each scalar kind writes the constant of its type (spec/fir.md 5.6).
fn a_declaration_reads_globals_functions_and_every_scalar_kind() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[21] source = {
        "enum color {",
        "    red,",
        "    green,",
        "}",
        "i32 LIMIT = 7;",
        "i32 mut count = 0;",
        "fn one() i32 {",
        "    return 1;",
        "}",
        "fn f(u8* p) void {",
        "    i32 a = count;",
        "    i32 b = LIMIT;",
        "    fn () i32 g = one;",
        "    f64 x = 1;",
        "    char c = 'A';",
        "    color k = color.green;",
        "    bool t = true;",
        "    u8* q = p;",
        "    u8* z = null;",
        "    u64 s = sizeof(i64);",
        "}",
    };
    string[47] want = {
        "fn main.f(_1 (p): u8*) -> void {",
        "    let _0: void;",
        "    let _2 (a): i32 #11:9;",
        "    let _3 (b): i32 #12:9;",
        "    let _4 (g): fn () i32 #13:15;",
        "    let _5 (x): f64 #14:9;",
        "    let _6 (c): char #15:10;",
        "    let _7 (k): color #16:11;",
        "    let _8 (t): bool #17:10;",
        "    let _9 (q): u8* #18:9;",
        "    let _10 (z): u8* #19:9;",
        "    let _11 (s): u64 #20:9;",
        "",
        "    bb0: {",
        "        live(_2) #11:9 s1;",
        "        _2 = copy global main.count #11:13 s1;",
        "        live(_3) #12:9 s2;",
        "        _3 = const i32 7 #12:13 s2;",
        "        live(_4) #13:15 s3;",
        "        _4 = const fn main.one #13:19 s3;",
        "        live(_5) #14:9 s4;",
        "        _5 = const f64 0x3FF0000000000000 #14:13 s4;",
        "        live(_6) #15:10 s5;",
        "        _6 = const char 65 #15:14 s5;",
        "        live(_7) #16:11 s6;",
        "        _7 = const color 1 #16:20 s6;",
        "        live(_8) #17:10 s7;",
        "        _8 = const true #17:14 s7;",
        "        live(_9) #18:9 s8;",
        "        _9 = copy _1 #18:13 s8;",
        "        live(_10) #19:9 s9;",
        "        _10 = const null u8* #19:13 s9;",
        "        live(_11) #20:9 s10;",
        "        _11 = const u64 8 #20:13 s10;",
        "        dead(_2) #21:1 s0;",
        "        dead(_3) #21:1 s0;",
        "        dead(_4) #21:1 s0;",
        "        dead(_5) #21:1 s0;",
        "        dead(_6) #21:1 s0;",
        "        dead(_7) #21:1 s0;",
        "        dead(_8) #21:1 s0;",
        "        dead(_9) #21:1 s0;",
        "        dead(_10) #21:1 s0;",
        "        dead(_11) #21:1 s0;",
        "        return #21:1 s0;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "f"), want[..]);
}

// `return x` of an `own` parameter or local is an implicit move (ANN_MOVE, D17.5): the operand is
// `move _x` and not a copy, which rule V6 would refuse.
fn a_return_of_an_owning_name_moves_it() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[3] source = {
        "fn keep(u8 mut* own p) u8 mut* own {",
        "    return p;",
        "}",
    };
    string[8] want = {
        "fn main.keep(_1 (p): u8 mut* own) -> u8 mut* own {",
        "    let _0: u8 mut* own;",
        "",
        "    bb0: {",
        "        _0 = move _1 #2:12 s1;",
        "        return #2:5 s1;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "keep"), want[..]);
}

// ---- the named locals -------------------------------------------------------------------------

// The prescan numbers the named locals after the parameters in the order of their declarations,
// nested blocks included, and walks only the branch of a `$if` that the checker selected
// (spec/fir.md 5.3). `x` stands in a branch that the checker did not select, and takes no number.
fn the_prescan_numbers_named_locals_in_declaration_order() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[15] source = {
        "fn f(bool c) i32 {",
        "    i32 a = 1;",
        "    if (c) {",
        "        i32 b = 2;",
        "        {",
        "            i32 d = b;",
        "        }",
        "    }",
        "    $if (sizeof(i64) == 8) {",
        "        i32 e = a;",
        "    } else {",
        "        i32 x = 5;",
        "    }",
        "    return a;",
        "}",
    };
    string[30] want = {
        "fn main.f(_1 (c): bool) -> i32 {",
        "    let _0: i32;",
        "    let _2 (a): i32 #2:9;",
        "    let _3 (b): i32 #4:13;",
        "    let _4 (d): i32 #6:17;",
        "    let _5 (e): i32 #10:13;",
        "",
        "    bb0: {",
        "        live(_2) #2:9 s1;",
        "        _2 = const i32 1 #2:13 s1;",
        "        switch(copy _1) -> [true: bb1, otherwise: bb2] #3:5 s2;",
        "    }",
        "    bb1: {",
        "        live(_3) #4:13 s3;",
        "        _3 = const i32 2 #4:17 s3;",
        "        live(_4) #6:17 s4;",
        "        _4 = copy _3 #6:21 s4;",
        "        dead(_4) #7:9 s2;",
        "        dead(_3) #8:5 s2;",
        "        goto bb2 #3:5 s2;",
        "    }",
        "    bb2: {",
        "        live(_5) #10:13 s5;",
        "        _5 = copy _2 #10:17 s5;",
        "        dead(_5) #11:5 s0;",
        "        _0 = copy _2 #14:12 s6;",
        "        dead(_2) #14:5 s6;",
        "        return #14:5 s6;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "f"), want[..]);
}

// An `else $if` chain lowers its first selected branch alone, and a chain that selects nothing
// lowers nothing. A local of a branch that the checker did not select takes no number.
fn a_compile_time_chain_lowers_its_selected_branch_alone() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[12] source = {
        "fn g() void {",
        "    $if (false) {",
        "        i32 y = 1;",
        "    } else $if (true) {",
        "        i32 z = 2;",
        "    } else {",
        "        i32 w = 3;",
        "    }",
        "    $if (false) {",
        "        i32 v = 0;",
        "    }",
        "}",
    };
    string[11] want = {
        "fn main.g() -> void {",
        "    let _0: void;",
        "    let _1 (z): i32 #5:13;",
        "",
        "    bb0: {",
        "        live(_1) #5:13 s1;",
        "        _1 = const i32 2 #5:17 s1;",
        "        dead(_1) #6:5 s0;",
        "        return #12:1 s0;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "g"), want[..]);
}

// ---- the statement index ----------------------------------------------------------------------

// The case of the ticket: the `if` takes `s1` and the statement inside it `s2`. The `goto` that
// ends the arm belongs to the `if` and takes `s1`.
fn an_if_takes_its_index_before_the_statements_inside_it() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[6] source = {
        "fn f(bool c) i32 {",
        "    if (c) {",
        "        i32 x = 1;",
        "    }",
        "    return 0;",
        "}",
    };
    string[18] want = {
        "fn main.f(_1 (c): bool) -> i32 {",
        "    let _0: i32;",
        "    let _2 (x): i32 #3:13;",
        "",
        "    bb0: {",
        "        switch(copy _1) -> [true: bb1, otherwise: bb2] #2:5 s1;",
        "    }",
        "    bb1: {",
        "        live(_2) #3:13 s2;",
        "        _2 = const i32 1 #3:17 s2;",
        "        dead(_2) #4:5 s1;",
        "        goto bb2 #2:5 s1;",
        "    }",
        "    bb2: {",
        "        _0 = const i32 0 #5:12 s3;",
        "        return #5:5 s3;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "f"), want[..]);
}

// Each `else if` is an `if` of its own and takes its own index (spec/fir.md 9.7). The blocks of
// one `if` are made in the order then, else, done (9.3), so the blocks of an inner `if` take
// larger numbers than the `done` of the outer one. An arm that ends in `return` has no `goto`,
// and a statement after a `return` starts a block that nothing names.
fn an_else_if_chain_and_the_statements_after_a_return() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[15] source = {
        "fn f(bool c, bool d) i32 {",
        "    if (c) {",
        "        i32 x = 1;",
        "    }",
        "    if (c) {",
        "        i32 y = 2;",
        "    } else if (d) {",
        "        i32 z = 3;",
        "    } else {",
        "        return 4;",
        "    }",
        "    return 0;",
        "    i32 after = 5;",
        "    return after;",
        "}",
    };
    string[53] want = {
        "fn main.f(_1 (c): bool, _2 (d): bool) -> i32 {",
        "    let _0: i32;",
        "    let _3 (x): i32 #3:13;",
        "    let _4 (y): i32 #6:13;",
        "    let _5 (z): i32 #8:13;",
        "    let _6 (after): i32 #13:9;",
        "",
        "    bb0: {",
        "        switch(copy _1) -> [true: bb1, otherwise: bb2] #2:5 s1;",
        "    }",
        "    bb1: {",
        "        live(_3) #3:13 s2;",
        "        _3 = const i32 1 #3:17 s2;",
        "        dead(_3) #4:5 s1;",
        "        goto bb2 #2:5 s1;",
        "    }",
        "    bb2: {",
        "        switch(copy _1) -> [true: bb3, otherwise: bb4] #5:5 s3;",
        "    }",
        "    bb3: {",
        "        live(_4) #6:13 s4;",
        "        _4 = const i32 2 #6:17 s4;",
        "        dead(_4) #7:5 s3;",
        "        goto bb5 #5:5 s3;",
        "    }",
        "    bb4: {",
        "        switch(copy _2) -> [true: bb6, otherwise: bb7] #7:12 s5;",
        "    }",
        "    bb5: {",
        "        _0 = const i32 0 #12:12 s8;",
        "        return #12:5 s8;",
        "    }",
        "    bb6: {",
        "        live(_5) #8:13 s6;",
        "        _5 = const i32 3 #8:17 s6;",
        "        dead(_5) #9:5 s5;",
        "        goto bb8 #7:12 s5;",
        "    }",
        "    bb7: {",
        "        _0 = const i32 4 #10:16 s7;",
        "        return #10:9 s7;",
        "    }",
        "    bb8: {",
        "        goto bb5 #5:5 s3;",
        "    }",
        "    bb9: {",
        "        live(_6) #13:9 s9;",
        "        _6 = const i32 5 #13:17 s9;",
        "        _0 = copy _6 #14:12 s10;",
        "        dead(_6) #14:5 s10;",
        "        return #14:5 s10;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "f"), want[..]);
}

// An `if` inside an `if`: the inner one makes its blocks after the outer `done`, and the `goto`
// that ends the outer arm takes the index of the outer `if` again after the inner statements.
fn a_nested_if_restores_the_index_of_the_outer_one() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[9] source = {
        "fn nif(bool a, bool b) i32 {",
        "    if (a) {",
        "        if (b) {",
        "            return 1;",
        "        }",
        "        i32 k = 2;",
        "    }",
        "    return 0;",
        "}",
    };
    string[25] want = {
        "fn main.nif(_1 (a): bool, _2 (b): bool) -> i32 {",
        "    let _0: i32;",
        "    let _3 (k): i32 #6:13;",
        "",
        "    bb0: {",
        "        switch(copy _1) -> [true: bb1, otherwise: bb2] #2:5 s1;",
        "    }",
        "    bb1: {",
        "        switch(copy _2) -> [true: bb3, otherwise: bb4] #3:9 s2;",
        "    }",
        "    bb2: {",
        "        _0 = const i32 0 #8:12 s5;",
        "        return #8:5 s5;",
        "    }",
        "    bb3: {",
        "        _0 = const i32 1 #4:20 s3;",
        "        return #4:13 s3;",
        "    }",
        "    bb4: {",
        "        live(_3) #6:13 s4;",
        "        _3 = const i32 2 #6:17 s4;",
        "        dead(_3) #7:5 s1;",
        "        goto bb2 #2:5 s1;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "nif"), want[..]);
}

// The lowering keeps no state from one call to the next: two lowerings of one declaration give
// one text, and a lowering after a refusal gives the text that it gives alone. The refusal stops
// inside a loop, with scopes, a named local and a deferred statement open. The sandbox has no
// runtime, so the print of `g` stops its lowering, and `f` needs no runtime entry.
fn a_lowering_depends_on_its_function_alone() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[16] source = {
        "fn f(u8 mut* own p, bool c) bool {",
        "    defer del(p);",
        "    while (c) {",
        "        if (c) {",
        "            return c;",
        "        }",
        "    }",
        "    return !c;",
        "}",
        "fn g(bool c) void {",
        "    while (true) {",
        "        bool d = c;",
        "        defer g(d);",
        "        println(d);",
        "    }",
        "}",
    };
    lower_env.check_lines(&e, source[..], false);
    strbuf.str_buf mut first = strbuf.create();
    defer strbuf.free(&first);
    strbuf.append(&first, lower_env.lower_checked(&e, "f"));
    assert(lower_env.lower_checked(&e, "f") == strbuf.view(&first));
    fir.func mut f = fir.func{};
    fir_lower.report mut why = fir_lower.report{};
    assert(!fir_lower.lower_function(&e.c.ck, lower_env.decl(&e, "g"), &f, &why));
    assert(why.kind == ast.ast_kind.k_ident && why.at.line == 14 && why.at.col == 17);
    assert(lower_env.lower_checked(&e, "f") == strbuf.view(&first));
    // the deferred `del(p)` stands at both returns and at no other place
    assert(str.find(strbuf.view(&first), "del(move _1) #2:11 exit 5:13 s5;") > 0);
    assert(str.find(strbuf.view(&first), "del(move _1) #2:11 exit 8:5 s7;") > 0);
}

// ---- the end of a body ------------------------------------------------------------------------

// A body whose last block has no terminator ends in `unreachable` when it has a result, at the
// closing brace and with index 0 (spec/fir.md 9.6, 9.7). The checker proved that no path reaches
// it, and rule V9 holds that.
fn a_body_with_a_result_ends_in_unreachable() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[7] source = {
        "fn f(bool c) i32 {",
        "    if (c) {",
        "        return 1;",
        "    } else {",
        "        return 2;",
        "    }",
        "}",
    };
    string[18] want = {
        "fn main.f(_1 (c): bool) -> i32 {",
        "    let _0: i32;",
        "",
        "    bb0: {",
        "        switch(copy _1) -> [true: bb1, otherwise: bb2] #2:5 s1;",
        "    }",
        "    bb1: {",
        "        _0 = const i32 1 #3:16 s2;",
        "        return #3:9 s2;",
        "    }",
        "    bb2: {",
        "        _0 = const i32 2 #5:16 s3;",
        "        return #5:9 s3;",
        "    }",
        "    bb3: {",
        "        unreachable #7:1 s0;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "f"), want[..]);
}

// A `noreturn` body that reaches its end ends in `trap` (D8.5). The checker accepts such a body
// when it ends in a loop that no `break` leaves, such as `while (true)`, whose done block is then
// the last block and takes the `trap`. A block that has a terminator keeps it: a second call of
// lower_end on a body that ends changes nothing.
fn a_noreturn_body_ends_in_trap() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[4] source = {
        "fn stop() noreturn {",
        "    while (true) {",
        "    }",
        "}",
    };
    string[16] lowered = {
        "fn main.stop() -> noreturn {",
        "    let _0: void;",
        "",
        "    bb0: {",
        "        goto bb1 #2:5 s1;",
        "    }",
        "    bb1: {",
        "        switch(const true) -> [true: bb2, otherwise: bb3] #2:5 s1;",
        "    }",
        "    bb2: {",
        "        goto bb1 #2:5 s1;",
        "    }",
        "    bb3: {",
        "        trap #4:1 s0;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "stop"), lowered[..]);
    ast.node* decl = lower_env.decl(&e, "stop");
    fir.func mut f = fir.func_new(&e.c.ck.types, decl->sym, decl->sym->ty);
    defer fir.func_free(&f);
    fir_lower.lowerer mut lw = fir_lower.lowerer{.ck = &e.c.ck, .f = &f};
    fir_lower.lower_end(&lw, decl->b);
    fir_lower.lower_end(&lw, decl->b);
    fir_verify.violation mut v = fir_verify.violation{};
    assert(!fir_verify.find_violation(&f, &e.rt, &v));
    strbuf.clear(&e.text);
    fir_print.print_function(&f, &e.text);
    string[7] want = {
        "fn main.stop() -> noreturn {",
        "    let _0: void;",
        "",
        "    bb0: {",
        "        trap #4:1 s0;",
        "    }",
        "}",
    };
    lower_env.expect(strbuf.view(&e.text), want[..]);
}

// ---- constructs that stopped the lowering ------------------------------------------------------

u64 REFUSAL_LINES = 89;

// One function for each construct that stopped the lowering before `defer`, `new`, `del` and the
// `own` stores lowered, and one for each position in which such a construct stopped the lowering
// from inside another construct: 83 functions.
string[REFUSAL_LINES] REFUSAL_SOURCE = {
    "struct pair {",
    "    i32 a;",
    "}",
    "struct holder {",
    "    u8 mut* own p;",
    "}",
    "fn one() i32 { return 1; }",
    "fn calls() void { one(); }",
    "fn take(i32 mut* own p) i32 { del(p); return 1; }",
    "fn flag(i32 mut* own p) bool { del(p); return true; }",
    "fn loops(bool c) void { while (c) { } }",
    "fn frees(u8 mut* own p) void { del(p); }",
    "fn reowns(holder mut* h, u8 mut* own q) void { h->p = move(q); }",
    "fn defers() void { defer calls(); }",
    "fn owner() void { u8 mut* own p = null; }",
    "fn allocates() i32 mut* own { return new(i32); }",
    "fn in_if() void { if (flag(new(i32))) { } }",
    "fn in_then(bool c) void { if (c) { calls(); defer calls(); } }",
    "fn in_else(bool c) void { if (c) { } else { defer calls(); } }",
    "fn in_else_if(bool c, bool d) void { if (c) { } else if (d) { defer calls(); } }",
    "fn in_block(bool c) void { { defer calls(); } }",
    "fn in_compile_if(bool c) void { $if (true) { defer calls(); } }",
    "fn in_left(i32 x) i32 { return take(new(i32)) + x; }",
    "fn in_right(i32 x) i32 { return x + take(new(i32)); }",
    "fn in_unary() i32 { return -take(new(i32)); }",
    "fn in_and(bool c) bool { return flag(new(i32)) && c; }",
    "fn in_and_right(bool c) bool { return c && flag(new(i32)); }",
    "fn in_condition() i32 { return flag(new(i32)) ? 1 : 2; }",
    "fn in_then_arm(bool c) i32 { return c ? take(new(i32)) : 2; }",
    "fn in_else_arm(bool c) i32 { return c ? 1 : take(new(i32)); }",
    "fn in_cast() i64 { return cast(take(new(i32)), i64); }",
    "fn in_shift(i32 x) i32 { return x << take(new(i32)); }",
    "fn in_index(i32[2] a) i32 { return a[take(new(i32))]; }",
    "fn in_bound(string s) string { return s[take(new(i32))..]; }",
    "fn in_member() pair { return pair{take(new(i32))}; }",
    "fn in_assign(i32 mut x) void { x = take(new(i32)); }",
    "fn in_compound(i32 mut x) void { x += take(new(i32)); }",
    "fn in_print() void { println(take(new(i32))); }",
    "fn in_fprint(i32 fd) void { fprintln(fd, take(new(i32))); }",
    "fn in_assert() void { assert(flag(new(i32))); }",
    "fn fors(i32 n) void { for (i32 mut i = 0; i < n; i += 1) { } }",
    "fn dos(bool c) void { do { } while (c); }",
    "fn switches(i32 n) void { switch (n) { case 1: calls(); default: calls(); } }",
    "fn ranges(i32[2] a) void { for (i32 v : a) { } }",
    "fn spans() u8 mut@ own { return new(u8, 4); }",
    "fn mkpair(i32 n) pair { return pair{n}; }",
    "fn ptrs(i32 n) pair* { return null; }",
    "fn arrs(i32 n) i32[2] { return i32[2]{}; }",
    "fn strs(i32 n) string { return \"s\"; }",
    "fn bytes(i32 n) u8* { return null; }",
    "fn sum(pair p) i32 { return p.a; }",
    "fn pick_fn(i32 n) fn () i32 { return one; }",
    "fn in_target(i32[2] mut a) void { a[take(new(i32))] = 1; }",
    "fn in_step(i32[2] mut a) void { a[take(new(i32))]++; }",
    "fn in_aggregate_arg() i32 { return sum(pair{take(new(i32))}); }",
    "fn in_address(i32[2] a) i32* { return &a[take(new(i32))]; }",
    "fn in_arrow() i32 { return ptrs(take(new(i32)))->a; }",
    "fn in_deref() pair { return *ptrs(take(new(i32))); }",
    "fn in_field() i32 { return mkpair(take(new(i32))).a; }",
    "fn in_indexed() i32 { return arrs(take(new(i32)))[0]; }",
    "fn in_spanned() string { return strs(take(new(i32)))[0..1]; }",
    "fn in_high(string s) string { return s[0..take(new(i32))]; }",
    "fn in_pointer_span() u8@ { return bytes(take(new(i32)))[0..1]; }",
    "fn in_aggregate_call() pair { return mkpair(take(new(i32))); }",
    "fn in_aggregate_cast() u8@ { return cast(strs(take(new(i32))), u8@); }",
    "fn in_aggregate_condition(pair p) pair { return flag(new(i32)) ? p : p; }",
    "fn in_aggregate_arm(bool c, pair p) pair { return c ? mkpair(take(new(i32))) : p; }",
    "fn in_callee() i32 { return pick_fn(take(new(i32)))(); }",
    "fn in_statement() void { take(new(i32)); }",
    "fn in_descriptor() void { fprintln(take(new(i32))); }",
    "fn in_print_string() void { print(strs(take(new(i32)))); }",
    "fn in_panic() void { panic(strs(take(new(i32)))); }",
    "fn in_equal_left(string s) bool { return strs(take(new(i32))) == s; }",
    "fn in_equal_right(string s) bool { return s == strs(take(new(i32))); }",
    "fn in_moved(u8 mut* own[2] mut o) u8 mut* own { return move(o[take(new(i32))]); }",
    "fn in_while_cond() void { while (flag(new(i32))) { } }",
    "fn in_while_body(bool c) void { while (c) { defer calls(); } }",
    "fn in_do_body(bool c) void { do { defer calls(); } while (c); }",
    "fn in_do_cond() void { do { } while (flag(new(i32))); }",
    "fn in_for_init() void { for (take(new(i32)); ; ) { } }",
    "fn in_for_cond() void { for (; flag(new(i32)); ) { } }",
    "fn in_for_step(bool c) void { for (; c; take(new(i32))) { } }",
    "fn in_for_body(bool c) void { for (; c; ) { defer calls(); } }",
    "fn in_collection() void { for (char ch : strs(take(new(i32)))) { } }",
    "fn in_range_body(i32[2] a) void { for (i32 v : a) { defer calls(); } }",
    "fn in_operand() void { switch (take(new(i32))) { } }",
    "fn in_clause(i32 n) void { switch (n) { case 1: defer calls(); } }",
    "fn in_default(i32 n) void { switch (n) { case 1: default: defer calls(); } }",
    "fn in_after_break(bool c) void { while (c) { break; defer calls(); } }",
};

// The count of the functions of REFUSAL_SOURCE.
u64 FORMER_REFUSALS = 83;

// Each function of REFUSAL_SOURCE lowers, and each keeps every rule of the verifier: the 68 that
// stopped at `defer`, `new`, `del`, an `own` declaration or an `own` store, and the 15 others.
fn each_construct_that_stopped_the_lowering_lowers() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    lower_env.check_lines(&e, REFUSAL_SOURCE[..], true);
    u64 mut lowered = 0;
    for (string line : REFUSAL_SOURCE) {
        if (str.starts_with(line, "fn ")) {
            i64 open = str.index_of(line, '(');
            lower_env.lower_checked(&e, line[3..cast(open, u64)]);
            lowered += 1;
        }
    }
    assert(lowered == FORMER_REFUSALS);
}

// ---- constructs that the lowering does not lower ----------------------------------------------

u64 NO_RUNTIME_LINES = 23;

// Functions that need an entry of the runtime, which a sandbox without std/rt.ft lacks: a print
// and a string equality stop the lowering (spec/fir.md 9.8). Each stands in a position that the
// lowering of this ticket's constructs reaches: a deferred statement expanded at each kind of
// exit and at a fall-off, an `own` declaration, an `own` store, `del`, `new(T, n)` and `return`.
string[NO_RUNTIME_LINES] NO_RUNTIME = {
    "struct pair {",
    "    i32 a;",
    "}",
    "fn own_if(bool c) u8 mut* own { return null; }",
    "fn count(bool c) i32 { return 1; }",
    "fn plain() void { println(1); }",
    "fn at_return(bool c) i32 { defer println(c); if (c) { return 1; } return 2; }",
    "fn at_end() void { defer println(1); }",
    "fn at_break(bool c) void { while (c) { defer println(c); break; } }",
    "fn at_continue(bool c) void { while (c) { defer println(c); continue; } }",
    "fn in_deferred_loop(bool c) void { defer { while (c) { println(c); } } }",
    "fn in_owner(string a, string b) void { u8 mut* own p = own_if(a == b); del(p); }",
    "fn in_own_value(u8 mut* own mut p, string a, string b) void { p = own_if(a == b); }",
    "fn in_own_target(u8 mut* own[2] mut q, string a, string b) void { q[count(a == b)] = null; }",
    "fn in_del(string a, string b) void { del(own_if(a == b)); }",
    "fn in_del_place(u8 mut* own[2] mut q, string a, string b) void { del(q[count(a == b)]); }",
    "fn in_count(string a, string b) void { del(new(u8, count(a == b))); }",
    "fn in_result(pair p, string a, string b) pair { defer count(a == b); return p; }",
    "fn in_value(string a, string b) pair { defer println(a); return pair{count(a == b)}; }",
    "fn in_range(i32[2] v) void { for (i32 x : v) { println(x); } }",
    "fn in_for(string a, string b) void { for (bool d = a == b; d; ) { } }",
    "fn in_clause(i32 n) void { switch (n) { case 1: defer println(n); } }",
    "fn in_nested(bool c) void { { defer println(c); { bool d = c; } } }",
};

u64 REFUSALS = 18;

// The functions of NO_RUNTIME that the lowering refuses, and the line that `--fir` prints for
// each: the kind of the tree node and the location where that node starts.
// .tickets/evidence/T244/refusals.py computes each location from the source text.
string[REFUSALS] REFUSED = {
    "plain", "at_return", "at_end", "at_break", "at_continue", "in_deferred_loop", "in_owner",
    "in_own_value", "in_own_target", "in_del", "in_del_place", "in_count", "in_result",
    "in_value", "in_range", "in_for", "in_clause", "in_nested",
};

string[REFUSALS] REPORTS = {
    "// not supported: int at 6:27",
    "// not supported: ident at 7:42",
    "// not supported: int at 8:34",
    "// not supported: ident at 9:54",
    "// not supported: ident at 10:57",
    "// not supported: ident at 11:64",
    "// not supported: binary at 12:65",
    "// not supported: binary at 13:76",
    "// not supported: binary at 14:77",
    "// not supported: binary at 15:51",
    "// not supported: binary at 16:80",
    "// not supported: binary at 17:60",
    "// not supported: binary at 18:63",
    "// not supported: binary at 19:78",
    "// not supported: ident at 20:56",
    "// not supported: binary at 21:54",
    "// not supported: ident at 22:63",
    "// not supported: ident at 23:45",
};

// A construct that the lowering does not lower stops the lowering of its function, wherever it
// stands, a deferred statement included: the report names the node and where it starts, and the
// function stays empty.
fn a_construct_not_lowered_stops_its_function() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    u64 mut i = 0;
    while (i < REFUSALS) {
        string got = lower_env.refused_with(&e, NO_RUNTIME[..], REFUSED[i], false);
        if (got.len != REPORTS[i].len + 1 || got[0..REPORTS[i].len] != REPORTS[i]) {
            eprintln("fir_lower_test: ", REFUSED[i], ": expected <", REPORTS[i], ">, got <",
                     got, ">");
            panic("fir_lower_test: a report differs");
        }
        i += 1;
    }
    // the lowering lowers the other functions of the source
    lower_env.check_lines(&e, NO_RUNTIME[..], false);
    lower_env.lower_checked(&e, "own_if");
    lower_env.lower_checked(&e, "count");
}

// ---- the program ------------------------------------------------------------------------------

// The functions of a closure in the order of a FIR module: the modules in dependency order, and in
// each module the declarations in source order with the selected branch of each `$if`. An
// `extern fn` has no body and is no function to lower.
fn the_program_lists_its_functions_in_module_order() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    check_env.reopen(&e.c);
    check_env.add(&e.c, "std/rt.ft", "fn first() void {\n}\n");
    modules_env.std_dir_without_runtime(&e.c.m, "std");
    check_env.add(&e.c, "helper.ft", "fn twice(i32 x) i32 {\n    return x;\n}\n");
    string[13] source = {
        "import helper;",
        "extern fn puts(char* s) i32;",
        "fn early() void {",
        "}",
        "$if (false) {",
        "    fn gone() void {",
        "    }",
        "} else {",
        "    fn kept() void {",
        "    }",
        "}",
        "fn main() i32 {",
        "    return helper.twice(0);",
    };
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    for (string line : source) {
        strbuf.append(&b, line);
        strbuf.push(&b, '\n');
    }
    strbuf.append(&b, "}\n");
    check_env.add(&e.c, "main.ft", strbuf.view(&b));
    assert(check_env.check_entry(&e.c, "main.ft"));
    gen.node_ref_vec mut decls = gen.node_ref_vec{};
    defer gen.refs_free(&decls);
    fir_lower.program_functions(&e.c.m.set, &decls);
    string[5] names = {"first", "twice", "early", "kept", "main"};
    assert(decls.len == 5);
    u64 mut i = 0;
    while (i < 5) {
        assert(gen.refs_at(&decls, i)->name == names[i]);
        i += 1;
    }
}

fn main() i32 {
    a_scalar_declaration_takes_a_constant_or_a_name();
    a_declaration_reads_globals_functions_and_every_scalar_kind();
    a_return_of_an_owning_name_moves_it();
    println("declarations ok");
    the_prescan_numbers_named_locals_in_declaration_order();
    a_compile_time_chain_lowers_its_selected_branch_alone();
    println("locals ok");
    an_if_takes_its_index_before_the_statements_inside_it();
    an_else_if_chain_and_the_statements_after_a_return();
    a_nested_if_restores_the_index_of_the_outer_one();
    a_lowering_depends_on_its_function_alone();
    println("indices ok");
    a_body_with_a_result_ends_in_unreachable();
    a_noreturn_body_ends_in_trap();
    println("ends ok");
    each_construct_that_stopped_the_lowering_lowers();
    a_construct_not_lowered_stops_its_function();
    println("refusals ok");
    the_program_lists_its_functions_in_module_order();
    println("program ok");
    return 0;
}
