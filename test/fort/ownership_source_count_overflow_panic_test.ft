//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: ownership_source: declaration count overflow
//! stdout:
//| 1
/// increment adds one inactive declaration to a u64 count. A count of U64_MAX has no
/// successor, so the call panics before the addition, which would trap.
import ownership_api;
import ownership_source;

fn main() i32 {
    u64 mut count = 0;
    ownership_source.increment(&count);
    println(count);
    count = ownership_api.U64_MAX;
    ownership_source.increment(&count);
    return 0;
}
