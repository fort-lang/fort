//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: json.json_init: no buffer
//! stdout:
//| a writer over a buffer ok
import json;
import std.strbuf;

// A writer writes into a buffer the caller owns, so starting one with none is
// a violated precondition and panics (D13.3).
fn i32 main() {
    strbuf.str_buf mut out = strbuf.create();
    defer strbuf.free(&out);
    json.writer mut good = json.writer{};
    json.json_init(&good, &out);
    println("a writer over a buffer ok");
    json.writer mut bad = json.writer{};
    json.json_init(&bad, null);
    json.json_null(&bad);
    return 0;
}
