//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: ownership_source: source file is absent
//! stdout:
//| 0
/// file_id finds the key of a file that the module set loaded. A name that the set does not
/// hold breaks that precondition, so the call panics.
import modules;
import ownership_source;

fn main() i32 {
    modules.module_set mut set = modules.create();
    defer modules.free(&set);
    ownership_source.context mut c = ownership_source.context{.modules = &set};
    println(modules.file_count(&set));
    ownership_source.file_id(&c, "missing.ft");
    return 0;
}
