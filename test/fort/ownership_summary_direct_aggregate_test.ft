//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| aggregate leaves ordered ok
//| multiple aggregate arguments ordered ok
//| dangling aggregate leaf rejected ok
//| live aggregate leaf accepted ok
//| scalar and direct references unchanged ok
//| owning aggregate copy rejected ok
//| aggregate leaf limit rejected ok
//| sibling aggregate leaf accepted ok
//| constant aggregate leaf accepted ok
//| zero aggregate leaves accepted ok
//| empty string aggregate leaf accepted ok
//| current block aggregate leaf accepted ok
//| ancestor aggregate leaf accepted ok
//| aggregate leaf join rejected ok
//| mixed aggregate constants accepted ok
//| projected constant leaf replayed ok
//| conflicting static source rejected ok
//| void pointer aggregate leaf accepted ok
//| projected empty leaves replayed ok
//| aggregate type walk charged ok
//| scalar aggregate type walk charged ok
//| aggregate parent order accepted ok
//| static source lookup charged ok
/// Checks the borrowed leaves of direct aggregate call arguments (D17.14-D17.15, D17.18).
import fir;
import ownership_api;
import ownership_call_bodies;
import ownership_calls;
import ownership_calls_env;
import ownership_calls_fixtures;
import ownership_flow;
import ownership_places;
import ownership_state;
import ownership_summary_body;
import ownership_summary_model;
import ownership_transfer;
import types;

string[6] NESTED = {
    "struct inner { string text; i32@ values; i32* ptr; }",
    "struct outer { i32 tag; inner nested; i32*[2] items; }",
    "fn take(outer value) void {}",
    "fn caller(outer value) void {",
    "    take(value);",
    "}",
};

string[8] DANGLING = {
    "struct view_box { i32* ptr; }",
    "fn take(view_box value) void {}",
    "fn caller(i32 mut* own p, i32* q) view_box {",
    "    view_box mut value = view_box{p};",
    "    del(p); take(value);",
    "    value = view_box{q};",
    "    return value;",
    "}",
};

string[4] MULTIPLE = {
    "struct view_pair { string text; i32* ptr; }",
    "fn take(view_pair left, view_pair right) void {}",
    "fn caller(view_pair left, view_pair right) void {",
    "    take(left, right); }",
};

string[8] LIVE = {
    "struct view_box { i32* ptr; }",
    "fn take(view_box value) void {}",
    "fn caller(i32 mut* own p, i32* q) view_box {",
    "    view_box mut value = view_box{p};",
    "    take(value); del(p);",
    "    value = view_box{q};",
    "    return value;",
    "}",
};

string[4] SCALAR = {
    "struct scalar_box { i32 first; u64 second; }",
    "fn take(scalar_box value, string text, i32@ values) void {}",
    "fn caller(scalar_box value, string text, i32@ values) void {",
    "    take(value, text, values); }",
};

string[5] OWNING = {
    "struct owner_box { i32 mut* own ptr; }",
    "fn take(owner_box value) void { del(value.ptr); }",
    "fn caller() void {",
    "    owner_box value = owner_box{new(i32)}; take(move(value));",
    "}",
};

string[3] LIMIT = {
    "struct many { i32*[257] items; }",
    "fn take(many value) void {}",
    "fn caller(many value) void { take(value); }",
};

string[6] CONSTANT_REPLACEMENT = {
    "struct text_box { string text; }",
    "fn take(text_box value) void {}",
    "fn caller() text_box {",
    "    text_box mut value = text_box{\"fixed\"};",
    "    take(value);",
    "    return value; }",
};

string[9] SIBLING_REPLACEMENT = {
    "struct view_box { i32* ptr; }",
    "fn take(view_box value) void {}",
    "fn caller(bool replace, i32* first, i32* second) view_box {",
    "    view_box mut value = view_box{first};",
    "    if (replace) {",
    "        value = view_box{second};",
    "        return value;",
    "    }",
    "    take(value); return value; }",
};

string[6] ZERO_REPLACEMENT = {
    "struct empty_box { i32* ptr; string text; }",
    "fn take(empty_box value) void {}",
    "fn caller() empty_box {",
    "    empty_box mut value = empty_box{null, \"\"};",
    "    take(value);",
    "    return value; }",
};

string[6] EMPTY_STRING_REPLACEMENT = {
    "struct text_box { string text; }",
    "fn take(text_box value) void {}",
    "fn caller() text_box {",
    "    text_box mut value = text_box{\"\"};",
    "    take(value);",
    "    return value; }",
};

string[9] CURRENT_REPLACEMENT = {
    "struct view_box { i32* ptr; }",
    "fn take(view_box value) void {}",
    "fn caller(bool replace, i32* first, i32* second) view_box {",
    "    view_box mut value = view_box{first};",
    "    if (replace) {",
    "        value = view_box{second};",
    "        take(value); return value;",
    "    }",
    "    return value; }",
};

string[11] ANCESTOR_REPLACEMENT = {
    "struct view_box { i32* ptr; }",
    "fn take(view_box value) void {}",
    "fn caller(bool outer, bool inner, i32* ptr) view_box {",
    "    view_box mut value = view_box{ptr};",
    "    if (outer) {",
    "        if (inner) {",
    "            take(value); return value;",
    "        }",
    "        return value;",
    "    }",
    "    return value; }",
};

string[10] JOIN_REPLACEMENT = {
    "struct view_box { i32* ptr; }",
    "fn take(view_box value) void {}",
    "fn caller(bool replace, i32* first, i32* second) view_box {",
    "    view_box mut value = view_box{first};",
    "    if (replace) {",
    "        value = view_box{second};",
    "    } else {",
    "        value = view_box{first};",
    "    }",
    "    take(value); return value; }",
};

string[6] MIXED_CONSTANTS = {
    "struct mixed_box { i32 tag; i32* ptr; bool ready; }",
    "fn take(mixed_box value) void {}",
    "fn caller(i32* ptr) mixed_box {",
    "    mixed_box mut value = mixed_box{7, ptr, true};",
    "    take(value);",
    "    return value; }",
};

string[3] PROJECTED_REPLAY = {
    "struct text_box { string text; }",
    "fn callee() text_box { return text_box{\"fixed\"}; }",
    "fn caller() void { text_box value = callee(); }",
};

string[3] PROJECTED_EMPTY = {
    "struct empty_box { i32* ptr; i32@ items; }",
    "fn callee() empty_box { return empty_box{null, {}}; }",
    "fn caller() void { empty_box value = callee(); }",
};

string[6] VOID_REPLACEMENT = {
    "struct erased_box { void* ptr; }",
    "fn take(erased_box value) void {}",
    "fn caller() erased_box {",
    "    erased_box mut value = erased_box{null};",
    "    take(value);",
    "    return value; }",
};

fn direct_call(ownership_summary_body.body_program* body) ownership_flow.step* {
    u64 mut i = 0;
    ownership_flow.step* mut found = null;
    while (i < body->steps_len) {
        if (body->steps[i].kind == ownership_flow.step_kind.direct_call) {
            assert(found == null);
            found = &body->steps[i];
        }
        i += 1;
    }
    assert(found != null);
    return found;
}

fn same_call(ownership_flow.step effect, ownership_flow.step* call) bool {
    return effect.block == call->block && effect.gap == call->gap;
}

fn field(ownership_api.place_path path, u64 at, u32 number) void {
    assert(at < path.projections.len);
    assert(path.projections[at].kind == ownership_api.projection_kind.field);
    assert(path.projections[at].field == number);
}

fn index(ownership_api.place_path path, u64 at, i64 number) void {
    assert(at < path.projections.len);
    assert(path.projections[at].kind == ownership_api.projection_kind.fixed_index);
    assert(path.projections[at].index.kind == ownership_api.fact_kind.exact);
    assert(path.projections[at].index.value == number);
}

// The walker stops at string, span, and pointer leaves. It then walks the fixed array.
// Each read precedes the call and uses one exact leaf path.
fn aggregate_leaves_ordered() void {
    ownership_call_bodies.bodies mut set = ownership_call_bodies.bodies{};
    string[2] names = {"take", "caller"};
    ownership_call_bodies.open(&set, NESTED[..], names[..]);
    defer ownership_call_bodies.close(&set);
    ownership_summary_body.body_program mut body =
        ownership_summary_body.extract(&set.inputs[1]);
    defer ownership_summary_body.free(&body);
    assert(ownership_api.successful(body.proof));
    ownership_flow.step* call = direct_call(&body);
    ownership_api.place_path[5] mut paths = {};
    u64 mut reads = 0;
    u64 mut i = 0;
    u32 mut before = 0;
    while (i < body.steps_len) {
        ownership_flow.step row = body.steps[i];
        if (row.kind == ownership_flow.step_kind.local_effect && same_call(row, call) &&
            row.local.kind == ownership_transfer.action.inspect) {
            assert(reads < paths.len && (reads == 0 || row.order > before));
            paths[reads] = row.local.source;
            before = row.order;
            reads += 1;
        }
        i += 1;
    }
    assert(reads == 5 && call->order > before);
    field(paths[0], 0, 1); field(paths[0], 1, 0);
    field(paths[1], 0, 1); field(paths[1], 1, 1);
    field(paths[2], 0, 1); field(paths[2], 1, 2);
    field(paths[3], 0, 2); index(paths[3], 1, 0);
    field(paths[4], 0, 2); index(paths[4], 1, 1);
    println("aggregate leaves ordered ok");
}

// Reads keep operand order. The two leaves of one operand keep one local root.
fn multiple_aggregate_arguments_ordered() void {
    ownership_call_bodies.bodies mut set = ownership_call_bodies.bodies{};
    string[2] names = {"take", "caller"};
    ownership_call_bodies.open(&set, MULTIPLE[..], names[..]);
    defer ownership_call_bodies.close(&set);
    ownership_summary_body.body_program mut body =
        ownership_summary_body.extract(&set.inputs[1]);
    defer ownership_summary_body.free(&body);
    assert(ownership_api.successful(body.proof));
    ownership_flow.step* call = direct_call(&body);
    ownership_api.entity_id[4] mut roots = {};
    u64 mut reads = 0;
    u64 mut i = 0;
    u32 mut order = 0;
    while (i < body.steps_len) {
        ownership_flow.step row = body.steps[i];
        if (row.kind == ownership_flow.step_kind.local_effect && same_call(row, call) &&
            row.local.kind == ownership_transfer.action.inspect) {
            assert(reads < roots.len && (reads == 0 || row.order > order));
            assert(row.local.source.projections.len == 1);
            field(row.local.source, 0, cast(reads % 2, u32));
            roots[reads] = row.local.source.root;
            order = row.order;
            reads += 1;
        }
        i += 1;
    }
    assert(reads == 4 && call->order > order);
    assert(ownership_summary_model.same(roots[0], roots[1]));
    assert(ownership_summary_model.same(roots[2], roots[3]));
    assert(!ownership_summary_model.same(roots[0], roots[2]));
    println("multiple aggregate arguments ordered ok");
}

fn complete(ownership_summary_model.summary* model) bool {
    return ownership_api.successful(model->proof) && !model->residual_effects &&
        model->cases.len == 1;
}

// The later replacement cannot hide the copied dangling leaf at the call.
fn dangling_aggregate_leaf_rejected() void {
    ownership_call_bodies.bodies mut set = ownership_call_bodies.bodies{};
    string[2] names = {"take", "caller"};
    ownership_call_bodies.open(&set, DANGLING[..], names[..]);
    defer ownership_call_bodies.close(&set);
    ownership_call_bodies.infer_all(&set);
    ownership_summary_model.summary* model = ownership_call_bodies.summary(&set, 1);
    assert(model->proof.failed && !ownership_api.successful(model->proof));
    assert(ownership_call_bodies.saw(&set, ownership_api.event_kind.invalid_use));
    assert(model->cases.len == 0);
    println("dangling aggregate leaf rejected ok");
}

// The read accepts the same leaf while its owner is live. The replacement precedes release.
fn live_aggregate_leaf_accepted() void {
    ownership_call_bodies.bodies mut set = ownership_call_bodies.bodies{};
    string[2] names = {"take", "caller"};
    ownership_call_bodies.open(&set, LIVE[..], names[..]);
    defer ownership_call_bodies.close(&set);
    ownership_call_bodies.infer_all(&set);
    ownership_summary_model.summary* model = ownership_call_bodies.summary(&set, 1);
    assert(complete(model));
    u64 mut reads = 0;
    u64 mut i = 0;
    while (i < model->effects.len) {
        if (model->effects[i].payload == ownership_summary_model.payload_kind.read) { reads += 1; }
        i += 1;
    }
    assert(reads == 1);
    println("live aggregate leaf accepted ok");
}

// A scalar aggregate has no borrowed leaf. A direct string and span keep their one-value rules.
fn scalar_and_direct_references_unchanged() void {
    ownership_call_bodies.bodies mut set = ownership_call_bodies.bodies{};
    string[2] names = {"take", "caller"};
    ownership_call_bodies.open(&set, SCALAR[..], names[..]);
    defer ownership_call_bodies.close(&set);
    ownership_summary_body.body_program mut body =
        ownership_summary_body.extract(&set.inputs[1]);
    defer ownership_summary_body.free(&body);
    assert(ownership_api.successful(body.proof));
    ownership_flow.step* call = direct_call(&body);
    u64 mut reads = 0;
    u64 mut i = 0;
    while (i < body.steps_len) {
        ownership_flow.step row = body.steps[i];
        if (row.kind == ownership_flow.step_kind.local_effect && same_call(row, call) &&
            row.local.kind == ownership_transfer.action.inspect) { reads += 1; }
        i += 1;
    }
    assert(reads == 0);
    println("scalar and direct references unchanged ok");
}

fn call_statement(fir.func mut* function) fir.statement* {
    u32 mut block = 0;
    while (block < fir.block_count(function)) {
        u32 mut gap = 0;
        while (gap < fir.block_statement_count(function, block)) {
            fir.statement* stmt = fir.block_statement(function, block, gap);
            if (stmt->kind == fir.stmt_kind.st_assign &&
                stmt->value.kind == fir.rvalue_kind.rv_call) { return stmt; }
            gap += 1;
        }
        block += 1;
    }
    panic("ownership_summary_direct_aggregate_test: missing call");
}

// Verified FIR moves this value. A defensive copy mutation must not copy its owning leaf.
fn owning_aggregate_copy_rejected() void {
    ownership_call_bodies.bodies mut set = ownership_call_bodies.bodies{};
    string[2] names = {"take", "caller"};
    ownership_call_bodies.open(&set, OWNING[..], names[..]);
    defer ownership_call_bodies.close(&set);
    fir.statement* call = call_statement(&set.functions[1]);
    assert(call->value.ops_len == 1);
    u64 operand = cast(call->value.ops_first, u64);
    assert(set.functions[1].ops.items[operand].kind == fir.operand_kind.ok_move);
    set.functions[1].ops.items[operand].kind = fir.operand_kind.ok_copy;
    ownership_summary_body.body_program mut body =
        ownership_summary_body.extract(&set.inputs[1]);
    defer ownership_summary_body.free(&body);
    assert(body.proof.kind == ownership_api.proof_kind.incomplete);
    assert(body.proof.terminal.reason == ownership_api.incomplete_reason.unknown_effect);
    println("owning aggregate copy rejected ok");
}

// A failed bounded walk emits no leaf read and keeps the proof incomplete.
fn aggregate_leaf_limit_rejected() void {
    ownership_call_bodies.bodies mut set = ownership_call_bodies.bodies{};
    string[2] names = {"take", "caller"};
    ownership_call_bodies.open(&set, LIMIT[..], names[..]);
    defer ownership_call_bodies.close(&set);
    ownership_summary_body.body_program mut body =
        ownership_summary_body.extract(&set.inputs[1]);
    defer ownership_summary_body.free(&body);
    assert(body.proof.kind == ownership_api.proof_kind.incomplete);
    assert(body.proof.terminal.reason == ownership_api.incomplete_reason.missing_path);
    u64 mut reads = 0;
    u64 mut i = 0;
    while (i < body.effects_len) {
        if (body.effects[i].payload == ownership_summary_model.payload_kind.read) { reads += 1; }
        i += 1;
    }
    assert(reads == 0);
    println("aggregate leaf limit rejected ok");
}

// A constant string replacement defines the borrowed leaf before the call reads it.
fn constant_leaf_replacement_precedes_read() void {
    ownership_call_bodies.bodies mut set = ownership_call_bodies.bodies{};
    string[2] names = {"take", "caller"};
    ownership_call_bodies.open(&set, CONSTANT_REPLACEMENT[..], names[..]);
    defer ownership_call_bodies.close(&set);
    ownership_summary_body.body_program mut body =
        ownership_summary_body.extract(&set.inputs[1]);
    defer ownership_summary_body.free(&body);
    assert(ownership_api.successful(body.proof));
    u64 mut replacement = ownership_api.U64_MAX;
    u64 mut read = ownership_api.U64_MAX;
    u64 mut i = 0;
    while (i < body.effects_len) {
        ownership_summary_model.effect_node row = body.effects[i];
        if (row.effect.place.projections.len == 1 &&
            row.payload == ownership_summary_model.payload_kind.replacement) {
            assert(replacement == ownership_api.U64_MAX);
            replacement = i;
        }
        if (row.effect.place.projections.len == 1 &&
            row.payload == ownership_summary_model.payload_kind.read) {
            assert(read == ownership_api.U64_MAX);
            read = i;
        }
        i += 1;
    }
    assert(replacement < read);
    assert(ownership_state.same_place(body.effect_flow[replacement], body.effect_flow[read]));
    ownership_call_bodies.infer_all(&set);
    ownership_summary_model.summary* model = ownership_call_bodies.summary(&set, 1);
    assert(complete(model));
    println("constant aggregate leaf accepted ok");
}

// The call path keeps the first replacement. It does not read the private leaf of its sibling.
fn sibling_replacement_stays_on_its_path() void {
    ownership_call_bodies.bodies mut set = ownership_call_bodies.bodies{};
    string[2] names = {"take", "caller"};
    ownership_call_bodies.open(&set, SIBLING_REPLACEMENT[..], names[..]);
    defer ownership_call_bodies.close(&set);
    ownership_call_bodies.infer_all(&set);
    ownership_summary_model.summary* model = ownership_call_bodies.summary(&set, 1);
    assert(ownership_api.successful(model->proof) && !model->residual_effects);
    assert(model->cases.len == 2);
    println("sibling aggregate leaf accepted ok");
}

// Zero initialization records empty reference leaves. Their call reads need no source.
fn zero_reference_leaves_are_empty() void {
    ownership_call_bodies.bodies mut set = ownership_call_bodies.bodies{};
    string[2] names = {"take", "caller"};
    ownership_call_bodies.open(&set, ZERO_REPLACEMENT[..], names[..]);
    defer ownership_call_bodies.close(&set);
    ownership_call_bodies.infer_all(&set);
    ownership_summary_model.summary* model = ownership_call_bodies.summary(&set, 1);
    assert(complete(model));
    u64 mut reads = 0;
    u64 mut i = 0;
    while (i < model->effects.len) {
        if (model->effects[i].payload == ownership_summary_model.payload_kind.read) {
            reads += 1;
        }
        i += 1;
    }
    assert(reads == 2);
    println("zero aggregate leaves accepted ok");
}

// An empty string keeps static source identity and an exact zero-byte source range.
fn empty_string_leaf_keeps_static_source() void {
    ownership_call_bodies.bodies mut set = ownership_call_bodies.bodies{};
    string[2] names = {"take", "caller"};
    ownership_call_bodies.open(&set, EMPTY_STRING_REPLACEMENT[..], names[..]);
    defer ownership_call_bodies.close(&set);
    ownership_call_bodies.infer_all(&set);
    ownership_summary_model.summary* model = ownership_call_bodies.summary(&set, 1);
    assert(complete(model));
    assert(model->sources.len == 1);
    assert(model->sources[0].kind == ownership_api.source_kind.static_storage);
    u64 mut replacements = 0;
    u64 mut i = 0;
    while (i < model->effects.len) {
        ownership_summary_model.effect_node row = model->effects[i];
        if (row.payload == ownership_summary_model.payload_kind.replacement &&
            row.value.borrows.len == 1) {
            replacements += 1;
            assert(row.value.borrows[0].range.extent.kind == ownership_api.fact_kind.exact);
            assert(row.value.borrows[0].range.extent.value == 0);
            assert(row.value.borrows[0].range.access.end.kind ==
                ownership_api.fact_kind.exact);
            assert(row.value.borrows[0].range.access.end.value == 0);
        }
        i += 1;
    }
    assert(replacements == 1);
    println("empty string aggregate leaf accepted ok");
}

// A replacement in the call block is newer than the replacement in its ancestor.
fn current_block_replacement_is_latest() void {
    ownership_call_bodies.bodies mut set = ownership_call_bodies.bodies{};
    string[2] names = {"take", "caller"};
    ownership_call_bodies.open(&set, CURRENT_REPLACEMENT[..], names[..]);
    defer ownership_call_bodies.close(&set);
    ownership_call_bodies.infer_all(&set);
    ownership_summary_model.summary* model = ownership_call_bodies.summary(&set, 1);
    assert(ownership_api.successful(model->proof));
    assert(!model->residual_effects && model->cases.len == 2);
    println("current block aggregate leaf accepted ok");
}

// A call in a nested block resolves the replacement from its ancestor chain.
fn ancestor_replacement_reaches_nested_call() void {
    ownership_call_bodies.bodies mut set = ownership_call_bodies.bodies{};
    string[2] names = {"take", "caller"};
    ownership_call_bodies.open(&set, ANCESTOR_REPLACEMENT[..], names[..]);
    defer ownership_call_bodies.close(&set);
    ownership_call_bodies.infer_all(&set);
    ownership_summary_model.summary* model = ownership_call_bodies.summary(&set, 1);
    assert(ownership_api.successful(model->proof));
    assert(!model->residual_effects && model->cases.len == 3);
    println("ancestor aggregate leaf accepted ok");
}

// The aggregate leaf cache has no join rule. The extractor refuses the missing path.
fn aggregate_leaf_join_stays_unsupported() void {
    ownership_call_bodies.bodies mut set = ownership_call_bodies.bodies{};
    string[2] names = {"take", "caller"};
    ownership_call_bodies.open(&set, JOIN_REPLACEMENT[..], names[..]);
    defer ownership_call_bodies.close(&set);
    ownership_call_bodies.infer_all(&set);
    ownership_summary_model.summary* model = ownership_call_bodies.summary(&set, 1);
    assert(!ownership_api.successful(model->proof));
    assert(model->proof.kind == ownership_api.proof_kind.incomplete);
    assert(model->proof.terminal.reason == ownership_api.incomplete_reason.missing_path);
    println("aggregate leaf join rejected ok");
}

// Scalar constants add no ownership effect. The one borrowed field keeps one call read.
fn scalar_constants_do_not_replace_leaves() void {
    ownership_call_bodies.bodies mut set = ownership_call_bodies.bodies{};
    string[2] names = {"take", "caller"};
    ownership_call_bodies.open(&set, MIXED_CONSTANTS[..], names[..]);
    defer ownership_call_bodies.close(&set);
    ownership_call_bodies.infer_all(&set);
    ownership_summary_model.summary* model = ownership_call_bodies.summary(&set, 1);
    assert(complete(model));
    u64 mut reads = 0;
    u64 mut i = 0;
    while (i < model->effects.len) {
        if (model->effects[i].payload == ownership_summary_model.payload_kind.read) {
            reads += 1;
        }
        i += 1;
    }
    assert(reads == 1);
    println("mixed aggregate constants accepted ok");
}

// Caller replay installs the projected string value and its published static source.
fn projected_constant_leaf_replayed() void {
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    ownership_calls_fixtures.open(&f, PROJECTED_REPLAY[..]);
    defer ownership_calls_fixtures.close(&f);
    assert(ownership_api.successful(f.summary.proof) && f.summary.sources.len == 1);
    assert(f.summary.sources[0].kind == ownership_api.source_kind.static_storage);
    ownership_calls_fixtures.prepare(&f);
    ownership_calls_fixtures.apply(&f, 1);
    assert(ownership_api.successful(f.application.proof) && f.application.normal_continuation);
    u64 at = ownership_state.source_index(&f.application.state, f.summary.sources[0].key);
    assert(at != ownership_api.U64_MAX);
    assert(f.application.state.sources[at].kind == ownership_api.source_kind.static_storage);
    assert(f.application.state.sources[at].validity == ownership_api.validity_kind.live);
    u64 mut projected = 0;
    u64 mut contents = 0;
    while (contents < f.application.state.contents_len) {
        ownership_api.contents_fact value = f.application.state.contents[contents];
        if (ownership_summary_model.same(value.place.root,
            f.application.bound.result.actual_slot.root) && value.place.projections.len == 1) {
            assert(value.kind == ownership_api.contents_kind.reference);
            assert(value.borrows.len == 1);
            assert(ownership_summary_model.same(value.borrows[0].source,
                f.summary.sources[0].key));
            projected += 1;
        }
        contents += 1;
    }
    assert(projected == 1);
    ownership_state.state mut next = ownership_state.clone(&f.application.state);
    ownership_calls.free(&f.application);
    ownership_state.free(&f.caller);
    f.caller = move(next);
    ownership_calls_fixtures.apply(&f, 2);
    assert(ownership_api.successful(f.application.proof) && f.application.normal_continuation);
    u64 mut copies = 0;
    u64 mut i = 0;
    while (i < f.application.state.sources_len) {
        if (ownership_summary_model.same(f.application.state.sources[i].key,
            f.summary.sources[0].key)) { copies += 1; }
        i += 1;
    }
    assert(copies == 1);
    println("projected constant leaf replayed ok");
}

// A same-key caller fact cannot change the published static source classification.
fn conflicting_static_source_rejected() void {
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    ownership_calls_fixtures.open(&f, PROJECTED_REPLAY[..]);
    defer ownership_calls_fixtures.close(&f);
    assert(ownership_api.successful(f.summary.proof) && f.summary.sources.len == 1);
    ownership_calls_fixtures.prepare(&f);
    ownership_state.append_sources(&f.caller, ownership_api.source_fact{
        .key = f.summary.sources[0].key, .kind = ownership_api.source_kind.stack,
        .validity = ownership_api.validity_kind.live});
    ownership_calls_fixtures.apply(&f, 3);
    assert(!ownership_api.successful(f.application.proof));
    assert(f.application.proof.kind == ownership_api.proof_kind.incomplete);
    assert(f.application.proof.terminal.reason ==
        ownership_api.incomplete_reason.missing_correspondence);
    assert(!f.application.normal_continuation);
    assert(f.services.counts.last.text ==
        "published static source conflicts with caller state");
    println("conflicting static source rejected ok");
}

// `void*` is one reference leaf. Its null replacement precedes the call read.
fn void_pointer_leaf_is_empty() void {
    ownership_call_bodies.bodies mut set = ownership_call_bodies.bodies{};
    string[2] names = {"take", "caller"};
    ownership_call_bodies.open(&set, VOID_REPLACEMENT[..], names[..]);
    defer ownership_call_bodies.close(&set);
    ownership_call_bodies.infer_all(&set);
    ownership_summary_model.summary* model = ownership_call_bodies.summary(&set, 1);
    assert(complete(model));
    assert(model->sources.len == 0);
    u64 mut reads = 0;
    u64 mut i = 0;
    while (i < model->effects.len) {
        if (model->effects[i].payload == ownership_summary_model.payload_kind.read) {
            reads += 1;
        }
        i += 1;
    }
    assert(reads == 1);
    println("void pointer aggregate leaf accepted ok");
}

// Null and zero reference leaves remain projected assignments at the caller.
fn projected_empty_leaves_replayed() void {
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    ownership_calls_fixtures.open(&f, PROJECTED_EMPTY[..]);
    defer ownership_calls_fixtures.close(&f);
    assert(ownership_api.successful(f.summary.proof) && f.summary.sources.len == 0);
    ownership_calls_fixtures.prepare(&f);
    ownership_calls_fixtures.apply(&f, 1);
    assert(ownership_api.successful(f.application.proof) && f.application.normal_continuation);
    bool[2] mut seen = {};
    u64 mut empty = 0;
    u64 mut i = 0;
    while (i < f.application.state.contents_len) {
        ownership_api.contents_fact value = f.application.state.contents[i];
        if (ownership_summary_model.same(value.place.root,
            f.application.bound.result.actual_slot.root) && value.place.projections.len == 1) {
            ownership_api.projection part = value.place.projections[0];
            assert(part.kind == ownership_api.projection_kind.field && part.field < 2);
            assert(!seen[part.field]);
            seen[part.field] = true;
            assert(value.kind == ownership_api.contents_kind.empty_owner);
            assert(value.owner_empty && value.borrows.len == 0);
            empty += 1;
        }
        i += 1;
    }
    assert(empty == 2);
    assert(seen[0] && seen[1]);
    println("projected empty leaves replayed ok");
}

// The aggregate walker refuses before its first uncharged type read.
fn aggregate_type_walk_charged() void {
    ownership_call_bodies.bodies mut set = ownership_call_bodies.bodies{};
    string[2] names = {"take", "caller"};
    ownership_call_bodies.open(&set, NESTED[..], names[..]);
    defer ownership_call_bodies.close(&set);
    ownership_summary_body.body_program mut body =
        ownership_summary_body.extract(&set.inputs[1]);
    defer ownership_summary_body.free(&body);
    assert(ownership_api.successful(body.proof));
    fir.statement* call = call_statement(&set.functions[1]);
    fir.operand argument = fir.rvalue_operand(&set.functions[1], call->value, 0);
    types.node* ty = fir.operand_type(&set.functions[1], argument);
    ownership_places.leaf_plan mut plan = ownership_places.leaf_plan{};
    ownership_calls_env.reset(&set.services);
    assert(ownership_summary_body.aggregate_leaves(&body, ty,
        ownership_summary_body.slot(&set.inputs[1], argument.place.local), &plan));
    assert(plan.len == 5 && set.services.counts.meter.used.w > plan.len);
    field(plan.items[0].path, 0, 1);
    field(plan.items[0].path, 1, 0);
    field(plan.items[4].path, 0, 2);
    index(plan.items[4].path, 1, 1);
    ownership_places.free_plan(&plan);
    plan = ownership_places.leaf_plan{};
    set.services.counts.deny_at = 1;
    ownership_calls_env.reset(&set.services);
    bool walked = ownership_summary_body.aggregate_leaves(&body, ty,
        ownership_summary_body.slot(&set.inputs[1], argument.place.local), &plan);
    ownership_places.free_plan(&plan);
    assert(!walked && body.proof.kind == ownership_api.proof_kind.incomplete);
    assert(body.proof.terminal.reason == ownership_api.incomplete_reason.work_limit);
    assert(set.services.counts.denied_work == ownership_api.work_kind.summary_solver);
    println("aggregate type walk charged ok");
}

// A scalar aggregate has no leaf. Its type traversal still spends W.
fn scalar_aggregate_type_walk_charged() void {
    ownership_call_bodies.bodies mut set = ownership_call_bodies.bodies{};
    string[2] names = {"take", "caller"};
    ownership_call_bodies.open(&set, SCALAR[..], names[..]);
    defer ownership_call_bodies.close(&set);
    ownership_summary_body.body_program mut body =
        ownership_summary_body.extract(&set.inputs[1]);
    defer ownership_summary_body.free(&body);
    assert(ownership_api.successful(body.proof));
    fir.statement* call = call_statement(&set.functions[1]);
    fir.operand argument = fir.rvalue_operand(&set.functions[1], call->value, 0);
    types.node* ty = fir.operand_type(&set.functions[1], argument);
    ownership_places.leaf_plan mut plan = ownership_places.leaf_plan{};
    ownership_calls_env.reset(&set.services);
    assert(ownership_summary_body.aggregate_leaves(&body, ty,
        ownership_summary_body.slot(&set.inputs[1], argument.place.local), &plan));
    assert(plan.len == 0 && set.services.counts.meter.used.w > 0);
    ownership_places.free_plan(&plan);
    println("scalar aggregate type walk charged ok");
}

// Block numbers do not give execution order. The bounded parent chain gives the order.
fn aggregate_parent_order_is_graph_order() void {
    ownership_call_bodies.bodies mut set = ownership_call_bodies.bodies{};
    string[2] names = {"take", "caller"};
    ownership_call_bodies.open(&set, ANCESTOR_REPLACEMENT[..], names[..]);
    defer ownership_call_bodies.close(&set);
    ownership_summary_body.body_program mut body =
        ownership_summary_body.extract(&set.inputs[1]);
    defer ownership_summary_body.free(&body);
    assert(ownership_api.successful(body.proof) && body.parents.len > 3);
    body.parents[1] = 3;
    body.parents[3] = 0;
    assert(ownership_summary_body.aggregate_path_block(&body, 1, 3));
    assert(ownership_summary_body.aggregate_path_block(&body, 1, 0));
    assert(ownership_api.successful(body.proof));
    println("aggregate parent order accepted ok");
}

// Static-source lookup pays for all current source rows. A refusal adds no source.
fn static_source_lookup_is_charged() void {
    ownership_call_bodies.bodies mut set = ownership_call_bodies.bodies{};
    string[2] names = {"take", "caller"};
    ownership_call_bodies.open(&set, EMPTY_STRING_REPLACEMENT[..], names[..]);
    defer ownership_call_bodies.close(&set);
    ownership_summary_body.body_program mut body =
        ownership_summary_body.extract(&set.inputs[1]);
    defer ownership_summary_body.free(&body);
    assert(ownership_api.successful(body.proof));
    u64 mut sources = body.entry.sources_len;
    ownership_calls_env.reset(&set.services);
    ownership_api.entity_id mut key =
        ownership_summary_body.add_static_source(&set.inputs[1], &body);
    assert(key.kind == ownership_api.entity_kind.source);
    assert(sources > 0 && set.services.counts.calls == sources);
    sources = body.entry.sources_len;
    set.services.counts.deny_at = 1;
    ownership_calls_env.reset(&set.services);
    key = ownership_summary_body.add_static_source(&set.inputs[1], &body);
    assert(key.kind == ownership_api.entity_kind.none && body.entry.sources_len == sources);
    assert(body.proof.kind == ownership_api.proof_kind.incomplete);
    assert(body.proof.terminal.reason == ownership_api.incomplete_reason.work_limit);
    assert(set.services.counts.denied_work == ownership_api.work_kind.summary_solver);
    println("static source lookup charged ok");
}

fn main() i32 {
    aggregate_leaves_ordered();
    multiple_aggregate_arguments_ordered();
    dangling_aggregate_leaf_rejected();
    live_aggregate_leaf_accepted();
    scalar_and_direct_references_unchanged();
    owning_aggregate_copy_rejected();
    aggregate_leaf_limit_rejected();
    sibling_replacement_stays_on_its_path();
    constant_leaf_replacement_precedes_read();
    zero_reference_leaves_are_empty();
    empty_string_leaf_keeps_static_source();
    current_block_replacement_is_latest();
    ancestor_replacement_reaches_nested_call();
    aggregate_leaf_join_stays_unsupported();
    scalar_constants_do_not_replace_leaves();
    projected_constant_leaf_replayed();
    conflicting_static_source_rejected();
    void_pointer_leaf_is_empty();
    projected_empty_leaves_replayed();
    aggregate_type_walk_charged();
    scalar_aggregate_type_walk_charged();
    aggregate_parent_order_is_graph_order();
    static_source_lookup_is_charged();
    return 0;
}
