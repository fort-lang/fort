//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: ownership_source: invalid analysis order
//! stdout:
//| false
/// analyze runs once, after prepare. A context that prepare did not fill breaks that order,
/// so the call panics.
import ownership_source;

fn main() i32 {
    ownership_source.context mut c = ownership_source.context{};
    println(c.prepared);
    ownership_source.analyze(&c);
    return 0;
}
