//! run
//! flags: -I ../../src/fort -I support -I ../../src
//! abort
//! stderr: panic: json.int_of: not an integer
//! stdout:
//| the integer ok
/// Checks that int_of rejects JSON numbers with fractions or exponents. float_of accepts either
/// numeric kind.
import lsp.json;

fn main() i32 {
    json.doc mut d = json.create();
    defer json.free(&d);
    assert(json.parse(&d, "[7,7.0]"));
    u32 root = json.root(&d);
    assert(json.int_of(&d, json.at_of(&d, root, 0)) == 7);
    assert(json.float_of(&d, json.at_of(&d, root, 1)) == 0x401c000000000000);
    println("the integer ok");
    println(json.int_of(&d, json.at_of(&d, root, 1)));
    return 0;
}
