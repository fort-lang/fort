//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| ok
import ast;
import check;
import check_env;
import std.strbuf;
import types;

// The resolution and the expression typing of src/fort/check.ft, asserted
// through the annotations it writes: the type of an expression, the symbol a
// name denotes, the folded value of a constant expression and the byte offset
// of a field.
// D3 to D6, D17
//
// This suite is the named half of the checker's evidence. The other half is
// differential: the language corpus is run against stage2 and every
// diagnostic, its position and the exit status are held against stage1's over
// every fail test whose diagnostic this pass reports. What that cannot see is
// what the checker leaves on the tree, since no dump prints it, so what
// stands here is one assertion per rule over the annotations themselves.

// ---- the two phases of a module ----------------------------------------------------
// D7.10

fn void declarations_are_order_independent() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // `later` is used by `first` before it is declared: one symbol per
    // declaration is collected before any of them is resolved.
    // D7.10
    assert(check_env.check_decls(&e, "i32 first = later + 1;\ni32 later = 2;\n"));
    i64 mut v = 0;
    assert(check_env.init_int(&e, "first", &v));
    assert(v == 3);
    assert(check_env.decl_type(&e, "first") == "i32");
}

fn void a_declaration_defined_in_terms_of_itself_is_one_error() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!check_env.check_decls(&e, "i32 loop = loop + 1;\n"));
    assert(check_env.said(&e, "'loop' is defined in terms of itself"));
    // One error and nothing more: the symbol is poisoned, so the initializer
    // that mentions it says nothing further.
    // D14.2
    assert(check_env.errors(&e) == 1);
}

fn void a_module_level_initializer_is_a_constant_expression() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!check_env.check_decls(&e, "fn i32 f() {\n    return 1;\n}\ni32 x = f();\n"));
    assert(check_env.said(&e, "a module-level initializer must be a constant expression"));
}

fn void a_mut_module_declaration_is_a_global_and_a_plain_one_a_constant() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(check_env.check_decls(&e, "i32 k = 1;\ni32 mut g = 2;\n"));
    // Which of the two a module-level variable is follows from its type; the
    // symbol kind is what the index walk reads.
    // D7.10
    assert(check_env.sym_main(&e, "k")->kind == ast.sym_kind.s_const);
    assert(check_env.sym_main(&e, "g")->kind == ast.sym_kind.s_global);
    assert(check_env.decl_type(&e, "g") == "i32 mut");
}

fn void reading_a_mut_global_is_not_a_constant_expression() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!check_env.check_decls(&e, "i32 mut g = 1;\ni32 k = g;\n"));
    assert(check_env.said(&e, "a module-level initializer must be a constant expression"));
}

// ---- untyped constants -------------------------------------------------------------
// D4.1 to D4.6

fn void an_integer_literal_takes_the_type_of_its_context() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(check_env.check_init_of(&e, "u8", "200"));
    // The literal is untyped until the context fixes it; the node carries the
    // context's type afterwards and no longer the default one.
    // D4.1
    assert(check_env.probe_type(&e) == "u8");
}

fn void an_untyped_constant_folds_exactly_before_it_meets_its_context() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // The intermediate leaves the range of i32 and the result does not: the
    // folding is exact and only the result meets the context.
    // D4.4
    assert(check_env.check_init_of(&e, "i32", "1000000 * 1000 / 1000000"));
    i64 mut v = 0;
    assert(check_env.init_int(&e, "probe", &v));
    assert(v == 1000);
    assert(check_env.probe_type(&e) == "i32");
}

fn void a_constant_that_does_not_fit_its_context_is_an_error() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!check_env.check_init_of(&e, "u8", "256"));
    assert(check_env.said(&e, "constant 256 does not fit u8"));
}

fn void an_integer_constant_does_not_become_char_or_bool_or_an_enum() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!check_env.check_init_of(&e, "char", "65"));
    assert(check_env.said(&e, "an integer constant does not become char: use cast"));
    check_env.env mut f = check_env.env{};
    check_env.open(&f);
    defer check_env.close(&f);
    assert(!check_env.check_init_of(&f, "bool", "1"));
    assert(check_env.said(&f, "an integer constant does not become bool: write '!= 0'"));
    check_env.env mut g = check_env.env{};
    check_env.open(&g);
    defer check_env.close(&g);
    assert(!check_env.check_decls(&g, "enum color {\n    red,\n}\ncolor c = 0;\n"));
    assert(check_env.said(&g, "an integer constant does not become an enum: use cast"));
}

fn void an_untyped_constant_with_no_context_takes_its_default_type() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // A case label has no declared type here; the shape that reaches
    // default_type at module level is a fixed-array length, which is an
    // untyped constant used as a count.
    // D4.5, D3.4
    assert(check_env.check_init_of(&e, "i32[2]", "{1, 2}"));
    assert(check_env.decl_type(&e, "probe") == "i32[2]");
}

// ---- the default type of an expression that folded to no value ----------------------
// D4.5

// The `println` call of `fn void probe(i32 n) { println(<args>); }`, checked.
// The count of a shift is a parameter, so nothing folds and each argument
// carries the type default_type chose, which nothing else in the program says.
// The text is built here because fort does not join adjacent string literals.
// D2.9, D4.5
fn ast.node* probe_call(check_env.env mut* e, string args, bool ok) {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "fn void probe(i32 n) {\n    println(");
    strbuf.append(&b, args);
    strbuf.append(&b, ");\n}\n");
    assert(check_env.check_decls(e, strbuf.view(&b)) == ok);
    return check_env.body_expr(e, "probe", 0);
}

fn void an_expression_with_no_value_takes_i32_when_every_constant_fits() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    ast.node* call = probe_call(&e, "1 << n, 2147483647 << n, -2147483648 << n", true);
    // The two ends of i32 are inside it, so the rule leaves them there.
    // D4.5
    assert(check_env.type_text(&e, ast.ast_child(call, 0)->ty) == "i32");
    assert(check_env.type_text(&e, ast.ast_child(call, 1)->ty) == "i32");
    assert(check_env.type_text(&e, ast.ast_child(call, 2)->ty) == "i32");
}

fn void an_expression_with_no_value_takes_i64_when_a_constant_needs_it() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    ast.node* call = probe_call(&e,
        "2147483648 << n, -2147483649 << n, 9223372036854775807 >> n", true);
    // One past each end of i32, and the far end of i64.
    // D4.5
    assert(check_env.type_text(&e, ast.ast_child(call, 0)->ty) == "i64");
    assert(check_env.type_text(&e, ast.ast_child(call, 1)->ty) == "i64");
    assert(check_env.type_text(&e, ast.ast_child(call, 2)->ty) == "i64");
}

fn void a_node_that_folded_decides_for_the_subtree_below_it() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    ast.node* call = probe_call(&e, "(2147483648 - 1) << n, (2147483647 + 1) << n", true);
    // The context stops at a node that folded, here as in retype_untyped, so
    // the leaf 2147483648 does not widen an expression whose value is
    // 2147483647.
    // D4.4, D4.5
    assert(check_env.type_text(&e, ast.ast_child(call, 0)->ty) == "i32");
    assert(check_env.type_text(&e, ast.ast_child(call, 1)->ty) == "i64");
}

fn void one_wide_constant_widens_the_whole_untyped_expression() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    ast.node* call = probe_call(&e, "1 + (4294967296 << n)", true);
    ast.node* sum = ast.ast_child(call, 0);
    // One type for the expression, so the `1` beside the wide constant is i64
    // as well: there is no promotion inside it.
    // D4.5, D6.2
    assert(check_env.type_text(&e, sum->ty) == "i64");
    assert(check_env.type_text(&e, sum->a->ty) == "i64");
    assert(check_env.type_text(&e, sum->b->ty) == "i64");
}

fn void an_expression_with_no_value_beyond_i64_is_refused() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // The tail of the rule: neither type holds the constant, so the error names
    // i64, the widest the rule offers. The program compiled in silence until
    // 2026-09-13, because a left operand with no default type left the shift
    // before any context could read it.
    // D4.5
    ast.node* call = probe_call(&e, "9223372036854775808 << n", false);
    assert(call != null);
    assert(check_env.errors(&e) == 1);
    assert(check_env.said(&e, "constant 9223372036854775808 does not fit i64"));
}

fn void a_poisoned_left_operand_that_is_no_constant_is_still_dropped() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // The other half of the guard above it. An untyped constant with no default
    // type goes on to the context, and every other poisoned operand stops at the
    // shift, because whatever reported it has said all there is to say. The count
    // is the assertion: a shift that let the error type through would add
    // "'<<' takes an integer left operand, not <error>" on the same line, which a
    // fail test of the corpus cannot see (the harness judges a line, not a count).
    // D4.5, D14.2
    ast.node* call = probe_call(&e, "nosuch << n", false);
    assert(call != null);
    assert(check_env.errors(&e) == 1);
    assert(check_env.said(&e, "unknown name 'nosuch'"));
    // The count holds the second guard as well: the error type is no integer
    // type, so the shift guard in retype_untyped would report it here a second
    // time if it read a poisoned type.
    // D6.2, D14.2
    assert(!check_env.said(&e, "'<<' takes an integer left operand"));
}

// Every operator that drops a poisoned operand, which is every position that is
// no context at all. A constant with no default type is poisoned and reported
// nowhere, so each of the thirteen accepted the program in silence until
// 2026-09-14: the compiler exited 0 and the program printed nothing.
//
// The C twin is test/check_operand_test.c, a file of its own because
// check_const_test.c's `main` was 6 statements under clang-tidy's cap of 800.
// This suite has no such cap, so the twins stand here.
// D4.1, D4.5

// The thirteen positions, as the text before the operand and the text after it.
// D4.1
string[13] DROP_HEAD = string[13]{
    "    println(*",
    "    println((",
    "    println((",
    "    println((",
    "    println(",
    "    println((",
    "    println(",
    "    println(&",
    "    del(",
    "    println(move(",
    "    ",
    "    ",
    "    for (i32 x : ",
};

string[13] DROP_TAIL = string[13]{
    ");",
    ").x);",
    ")->x);",
    ").len);",
    "[0]);",
    ")[0 .. 1]);",
    "());",
    ");",
    ");",
    "));",
    " = 1;",
    "++;",
    ") {\n        println(x);\n    }",
};

// `DROP_HEAD[i]` with `operand` and `DROP_TAIL[i]` after it, as the body of
// `main`. The buffer is the caller's, so the view outlives this call.
fn string drop_site(strbuf.str_buf mut* b, u64 i, string operand) {
    strbuf.append(b, DROP_HEAD[i]);
    strbuf.append(b, operand);
    strbuf.append(b, DROP_TAIL[i]);
    return strbuf.view(b);
}

fn void every_operator_that_drops_its_operand_reports_a_constant_with_no_type() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    u64 mut i = 0;
    while (i < DROP_HEAD.len) {
        if (i > 0) {
            check_env.reopen(&e);
        }
        strbuf.str_buf mut b = strbuf.create();
        // `2^63` written out folds to a value that neither i32 nor i64 holds,
        // so the rule's own tail reports it. The operand reaches the rule
        // because none of these positions is a context.
        // D4.1, D4.5
        assert(!check_env.check_body(&e, drop_site(&b, i, "9223372036854775808")));
        assert(check_env.said(&e, "constant expression out of range"));
        strbuf.free(&b);
        check_env.reopen(&e);
        strbuf.str_buf mut u = strbuf.create();
        // The other end of the range the rule has no type for, `2^64 - 1`.
        // D4.5
        assert(!check_env.check_body(&e, drop_site(&u, i, "18446744073709551615")));
        assert(check_env.said(&e, "constant expression out of range"));
        strbuf.free(&u);
        i += 1;
    }
}

fn void a_constant_that_folds_back_into_range_leaves_the_operator_its_own_rule() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // The second outcome of the same call, and it is not an error path. The
    // shift leaves `2^63 >> 1` poisoned and carrying the i64 2^62, and the
    // default type accepts that value, so the operand reaches the operator
    // typed and the operator answers by its own rule. Without the call the
    // four programs below compiled, exited 0 and printed nothing.
    // D4.4, D4.5
    assert(!check_env.check_body(&e, "    println(*(9223372036854775808 >> 1));"));
    assert(check_env.said(&e, "cannot dereference i64"));
    assert(check_env.errors(&e) == 1);
    check_env.reopen(&e);
    assert(!check_env.check_body(&e, "    println((9223372036854775808 >> 1).x);"));
    assert(check_env.said(&e, "i64 has no field 'x'"));
    check_env.reopen(&e);
    assert(!check_env.check_body(&e, "    println((9223372036854775808 >> 1)());"));
    assert(check_env.said(&e, "cannot call a value of type i64"));
    check_env.reopen(&e);
    assert(!check_env.check_body(&e, "    del(9223372036854775808 >> 1);"));
    assert(check_env.said(&e, "'del' takes a reference, not i64"));
    check_env.reopen(&e);
    // The value itself is the one the exact folding gives, and a context takes it.
    // D4.4
    assert(check_env.check_body(&e, "    i64 w = 9223372036854775808 >> 1;\n    println(w);"));
    assert(check_env.init_type(&e, "w") == "i64");
}

fn void a_dropped_operand_with_a_type_keeps_the_message_of_its_operator() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // The other half: an operand that is no untyped constant reaches the
    // operator, which answers as it always did. No mutant of the guard turns
    // this red, and that is the point of writing it down: the guard runs only
    // for a poisoned operand, so a typed one never enters it. The test pins
    // the seven messages, so a later change that widens the key is seen. Its
    // C twin is test/check_operand_test.c.
    // D14.2
    assert(!check_env.check_body(&e, "    i32 v = 1;\n    println(*v);"));
    assert(check_env.said(&e, "cannot dereference i32"));
    check_env.reopen(&e);
    assert(!check_env.check_body(&e, "    i32 v = 1;\n    println(v.x);"));
    assert(check_env.said(&e, "i32 has no field 'x'"));
    check_env.reopen(&e);
    assert(!check_env.check_body(&e, "    i32 v = 1;\n    println(v[0]);"));
    assert(check_env.said(&e, "i32 cannot be indexed"));
    check_env.reopen(&e);
    assert(!check_env.check_body(&e, "    i32 v = 1;\n    println(v());"));
    assert(check_env.said(&e, "cannot call a value of type i32"));
    check_env.reopen(&e);
    assert(!check_env.check_body(&e, "    i32 v = 1;\n    del(v);"));
    assert(check_env.said(&e, "'del' takes a reference, not i32"));
    check_env.reopen(&e);
    assert(!check_env.check_body(&e, "    i32 v = 1;\n    println(move(v));"));
    assert(check_env.said(&e, "'move' needs an owning operand, not i32"));
    check_env.reopen(&e);
    assert(!check_env.check_body(&e,
        "    i32 v = 1;\n    for (i32 x : v) {\n        println(x);\n    }"));
    assert(check_env.said(&e, "cannot iterate i32"));
}

fn void every_operator_that_drops_its_operand_reports_a_constant_it_carries() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    u64 mut i = 0;
    while (i < DROP_HEAD.len) {
        if (i > 0) {
            check_env.reopen(&e);
        }
        strbuf.str_buf mut b = strbuf.create();
        strbuf.append(&b, "    i32 n = 1;\n");
        // The same thirteen with an expression that folded to no value. The
        // constant then meets i64, the widest the rule offers, and the message
        // names it. `n` is a local variable, so the shift folds nothing.
        // D4.5, D6.2
        assert(!check_env.check_body(&e, drop_site(&b, i, "(9223372036854775808 << n)")));
        assert(check_env.said(&e, "constant 9223372036854775808 does not fit i64"));
        strbuf.free(&b);
        i += 1;
    }
}

fn void a_dropped_operand_that_is_no_constant_keeps_its_one_diagnostic() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    u64 mut i = 0;
    while (i < DROP_HEAD.len) {
        if (i > 0) {
            check_env.reopen(&e);
        }
        strbuf.str_buf mut b = strbuf.create();
        // The guard reads the operand and not the operator, so an operand that
        // was reported where it arose stays reported once. The count is the
        // assertion: a guard that reported for every poisoned operand would
        // double each of them, and the corpus could not see it, because the
        // harness judges a line and not a count.
        // D14.2
        assert(!check_env.check_body(&e, drop_site(&b, i, "nosuch")));
        assert(check_env.said(&e, "unknown name 'nosuch'"));
        // `move` adds "'move' has no value", which it added before this guard
        // too: its early return leaves the result `void`.
        // D12.2
        u64 mut want = 1;
        if (i == 9) {
            want = 2;
        }
        assert(check_env.errors(&e) == want);
        strbuf.free(&b);
        i += 1;
    }
}

// ---- the error type silences the second diagnostic ---------------------------------
// D14.2
//
// `constant_fits` drew "the expression expects <error>, not a constant"
// whenever a constant with no default type met a context, after the diagnostic
// that poisoned the type had already reported. It also showed the reader the
// internal name `<error>`. The C twin is test/check_poison_test.c.
// D4.5, D14.2

// The eight contexts that fix the type of an untyped constant, as the text
// before the constant and the text after it.
// D4.1
string[8] CONTEXT_HEAD = string[8]{
    "    println(",
    "    println(",
    "    println(cast(",
    "    if (",
    "    while (",
    "    switch (",
    "    println(new(i32, ",
    "    println(1, ",
};

string[8] CONTEXT_TAIL = string[8]{
    ");",
    " + 1);",
    ", i32));",
    ") {\n        println(1);\n    }",
    ") {\n        println(1);\n    }",
    ") {\n        case 1: {\n            println(1);\n        }\n    }",
    "));",
    ");",
};

// `CONTEXT_HEAD[i]` with `operand` and `CONTEXT_TAIL[i]` after it, as the body
// of `main`. The buffer is the caller's, so the view outlives this call.
fn string context_site(strbuf.str_buf mut* b, u64 i, string operand) {
    strbuf.append(b, CONTEXT_HEAD[i]);
    strbuf.append(b, operand);
    strbuf.append(b, CONTEXT_TAIL[i]);
    return strbuf.view(b);
}

fn void a_context_that_meets_a_poisoned_constant_says_nothing_more() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    u64 mut i = 0;
    while (i < CONTEXT_HEAD.len) {
        if (i > 0) {
            check_env.reopen(&e);
        }
        strbuf.str_buf mut b = strbuf.create();
        // The rule of the default type reports the constant and gives the
        // expression the error type. The context then retypes the constant
        // against that error type, which is the second visit, and the error
        // type silences it. Each drew two diagnostics until 2026-09-14.
        // D4.5, D14.2
        assert(!check_env.check_body(&e, context_site(&b, i, "9223372036854775808")));
        assert(check_env.said(&e, "constant expression out of range"));
        assert(!check_env.said(&e, "not a constant"));
        assert(check_env.errors(&e) == 1);
        strbuf.free(&b);
        check_env.reopen(&e);
        strbuf.str_buf mut u = strbuf.create();
        // The other end of the range the rule has no type for, `2^64 - 1`.
        // D4.5
        assert(!check_env.check_body(&e, context_site(&u, i, "18446744073709551615")));
        assert(!check_env.said(&e, "not a constant"));
        assert(check_env.errors(&e) == 1);
        strbuf.free(&u);
        i += 1;
    }
}

fn void every_position_that_drops_its_operand_reports_once() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    u64 mut i = 0;
    while (i < DROP_HEAD.len) {
        if (i > 0) {
            check_env.reopen(&e);
        }
        strbuf.str_buf mut b = strbuf.create();
        // The thirteen positions that are no context at all reach the same
        // rule through `check_operand`, so each of them drew the same second
        // diagnostic. `move` keeps two, because its early return leaves the
        // result `void`, and the rule of an expression with no value answers
        // that.
        // D4.1, D12.2, D14.2
        assert(!check_env.check_body(&e, drop_site(&b, i, "9223372036854775808")));
        assert(check_env.said(&e, "constant expression out of range"));
        assert(!check_env.said(&e, "not a constant"));
        u64 mut want = 1;
        if (i == 9) {
            want = 2;
        }
        assert(check_env.errors(&e) == want);
        strbuf.free(&b);
        i += 1;
    }
}

fn void a_context_with_a_real_type_still_names_itself() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // The other half, and the reason the guard reads the type and not the
    // message: a context whose type is no error still tells the reader what it
    // expected. fail/operators/018 annotates these two messages, and
    // fail/arrays/009 annotates a third, which stage1 never reaches because it
    // refuses a second array level.
    // D4.1, D4.2
    assert(!check_env.check_body(&e, "    i32 n = 1;\n    i32* p = 1 << n;\n    println(p);"));
    assert(check_env.said(&e, "the initializer expects i32*, not a constant"));
    assert(check_env.errors(&e) == 1);
    check_env.reopen(&e);
    strbuf.str_buf mut b = strbuf.create();
    strbuf.append(&b, "struct s {\n    i32 x;\n}\nfn i32 main() {\n    i32 n = 1;\n");
    strbuf.append(&b, "    s q = 1 << n;\n    println(q.x);\n    return 0;\n}\n");
    assert(!check_env.check_src(&e, strbuf.view(&b)));
    strbuf.free(&b);
    assert(check_env.said(&e, "the initializer expects s, not a constant"));
    assert(check_env.errors(&e) == 1);
}

fn void a_poisoned_context_of_its_own_stays_silent() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // The type comes from a declaration that failed rather than from the
    // constant, so the constant meets the error type with nothing wrong with
    // it. One diagnostic, the one that named the unknown type.
    // D14.2
    assert(!check_env.check_body(&e, "    nosuch v = 1;\n    println(v);"));
    assert(check_env.said(&e, "unknown type 'nosuch'"));
    assert(!check_env.said(&e, "not a constant"));
    assert(check_env.errors(&e) == 1);
}

fn void a_char_alone_in_such_an_expression_asks_for_char() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // The third clause of the rule. A char literal defaults to char, a shift
    // takes an integer left operand, and char is not an integer, so the
    // program is an error. It printed 97 until 2026-09-14.
    // D3.3, D4.3, D4.5, D6.2
    ast.node* call = probe_call(&e, "'a' << n", false);
    assert(call != null);
    assert(check_env.errors(&e) == 1);
    assert(check_env.said(&e, "'<<' takes an integer left operand, not char"));
    check_env.env mut f = check_env.env{};
    check_env.open(&f);
    defer check_env.close(&f);
    assert(probe_call(&f, "'a' >> n", false) != null);
    assert(check_env.said(&f, "'>>' takes an integer left operand, not char"));
}

fn void a_declared_char_is_no_more_an_integer_than_the_default_char_is() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // The same guard where a context and not the rule chose char. Both reach
    // retype_untyped, and the operand rule holds at that one point.
    // D4.1, D6.2
    string as_char = "fn void probe(i32 n) {\n    char c = 'a' << n;\n    println(c);\n}\n";
    assert(!check_env.check_decls(&e, as_char));
    assert(check_env.said(&e, "'<<' takes an integer left operand, not char"));
    check_env.env mut f = check_env.env{};
    check_env.open(&f);
    defer check_env.close(&f);
    // An integer context is legal and keeps the code point, so the guard
    // refuses char and not every context of a char constant.
    // D4.3
    string as_u8 = "fn void probe(i32 n) {\n    u8 b = 'a' << n;\n    println(b);\n}\n";
    assert(check_env.check_decls(&f, as_u8));
    assert(check_env.errors(&f) == 0);
}

fn void a_char_beside_an_integer_takes_the_integer_type() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    ast.node* call = probe_call(&e, "'a' | (1 << n), 'a' + (4294967296 << n)", true);
    // One type covers the expression, and an integer constant never becomes
    // char, so the integer clause wins and the char is its code point.
    // D4.3, D4.5, D6.2
    assert(check_env.type_text(&e, ast.ast_child(call, 0)->ty) == "i32");
    assert(check_env.type_text(&e, ast.ast_child(call, 1)->ty) == "i64");
}

fn void a_folded_char_stands_for_its_subtree_as_an_integer() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    ast.node* call = probe_call(&e, "('a' + 1) << n", true);
    // The walk stops at a node that folded, so the left operand of the shift is
    // the integer 98 and not the char below it: the shift is legal and the
    // expression is i32.
    // D4.3, D4.4, D4.5
    assert(check_env.type_text(&e, ast.ast_child(call, 0)->ty) == "i32");
    check_env.env mut f = check_env.env{};
    check_env.open(&f);
    defer check_env.close(&f);
    assert(check_env.check_init_of(&f, "i32", "('a' + 1) << 1"));
    i64 mut v = 0;
    assert(check_env.init_int(&f, "probe", &v));
    assert(v == 196);
}

fn void a_folded_constant_with_no_context_takes_its_clause() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // The rule on a constant that folded, which is the clause `cv_default_kind`
    // answers and the walk of an expression with no value never reaches. The
    // twin of check_const_test.c with_no_context_a_constant_is_i32_then_i64 and
    // with_no_context_a_char_literal_is_char.
    // D4.5
    ast.node* call = probe_call(&e, "1, 4294967296, 'a'", true);
    assert(check_env.type_text(&e, ast.ast_child(call, 0)->ty) == "i32");
    assert(check_env.type_text(&e, ast.ast_child(call, 1)->ty) == "i64");
    assert(check_env.type_text(&e, ast.ast_child(call, 2)->ty) == "char");
}

fn void a_context_that_takes_no_integer_constant_reports_the_constant() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // The operand rule of the shift reads the type the whole expression took,
    // and the left operand there is the integer `1`, which no context of these
    // five accepts. The constant is what the reader must change, so the message
    // that names it comes first and the operand rule stays quiet. Each of these
    // read "'<<' takes an integer left operand" on one branch of 2026-09-14 and
    // on no other day.
    // D3.3, D3.9, D4.1, D4.3, D6.2
    string as_char = "fn void probe(i32 n) {\n    char c = 1 << n;\n    println(c);\n}\n";
    assert(!check_env.check_decls(&e, as_char));
    assert(check_env.said(&e, "an integer constant does not become char: use cast"));
    assert(check_env.errors(&e) == 1);
    check_env.env mut f = check_env.env{};
    check_env.open(&f);
    defer check_env.close(&f);
    string as_bool = "fn void probe(i32 n) {\n    bool b = 1 << n;\n    println(b);\n}\n";
    assert(!check_env.check_decls(&f, as_bool));
    assert(check_env.said(&f, "an integer constant does not become bool: write '!= 0'"));
    check_env.env mut g = check_env.env{};
    check_env.open(&g);
    defer check_env.close(&g);
    strbuf.str_buf mut eb = strbuf.create();
    defer strbuf.free(&eb);
    strbuf.append(&eb, "enum color {\n    red,\n}\nfn void probe(i32 n) {\n");
    strbuf.append(&eb, "    color k = 1 << n;\n    println(k);\n}\n");
    assert(!check_env.check_decls(&g, strbuf.view(&eb)));
    assert(check_env.said(&g, "an integer constant does not become an enum: use cast"));
    check_env.env mut h = check_env.env{};
    check_env.open(&h);
    defer check_env.close(&h);
    string as_ptr = "fn void probe(i32 n) {\n    i32* p = 1 << n;\n    println(p);\n}\n";
    assert(!check_env.check_decls(&h, as_ptr));
    assert(check_env.said(&h, "the initializer expects i32*, not a constant"));
    check_env.env mut j = check_env.env{};
    check_env.open(&j);
    defer check_env.close(&j);
    strbuf.str_buf mut sb = strbuf.create();
    defer strbuf.free(&sb);
    strbuf.append(&sb, "struct s {\n    i32 x;\n}\nfn void probe(i32 n) {\n");
    strbuf.append(&sb, "    s q = 1 << n;\n    println(q.x);\n}\n");
    assert(!check_env.check_decls(&j, strbuf.view(&sb)));
    assert(check_env.said(&j, "the initializer expects s, not a constant"));
}

fn void a_constant_that_asks_for_no_type_leaves_the_expression_at_i32() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // `null` has no default type at all, so nothing in the expression asks for
    // one and i32 stands. The message names the type the expression took.
    // D4.5, D10.5
    assert(probe_call(&e, "null << n", false) != null);
    assert(check_env.said(&e, "'null' needs a pointer type, not i32"));
}

fn void the_arms_of_a_conditional_take_one_default_type() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // A conditional with a run-time condition is the second expression that
    // folds to no value, and the one the bootstrap compiler does not have. Two
    // char arms make it char, which is the clause a shift can never show.
    // D4.5, D6.6
    ast.node* call = probe_call(&e, "n > 0 ? 'a' : 'b', n > 0 ? 'a' : 98, n > 0 ? 1 : 4294967296",
        true);
    assert(check_env.type_text(&e, ast.ast_child(call, 0)->ty) == "char");
    assert(check_env.type_text(&e, ast.ast_child(call, 1)->ty) == "i32");
    assert(check_env.type_text(&e, ast.ast_child(call, 2)->ty) == "i64");
}

fn void the_conditional_takes_its_default_type_at_the_edge_of_i32() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // The boundary of the integer clause, read through the one expression the
    // two compilers cannot both answer: stage1 refuses `?:`, so the fixed point
    // compares nothing here and this assertion is the whole hold on it. The
    // top of i32 keeps i32 and one past it takes i64. One type covers the whole
    // expression, so either arm can decide it; the test below takes the other
    // arm and the other end.
    // D4.5, D6.2, D6.6
    ast.node* call = probe_call(&e, "n > 0 ? 2147483647 : 1, n > 0 ? 2147483648 : 1", true);
    assert(check_env.type_text(&e, ast.ast_child(call, 0)->ty) == "i32");
    assert(check_env.type_text(&e, ast.ast_child(call, 1)->ty) == "i64");
}

fn void the_arm_a_conditional_never_takes_decides_its_type_too() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // The other end of i32 and the other arm. `probe_call` makes `n` a
    // parameter, so nothing here decides the condition and nothing runs; the
    // type still comes from the arm below, because one type covers the whole
    // expression and not the arm a program would take. run/constants/015 makes
    // the condition true and reads the same two types off the values it prints.
    // D4.5, D6.2, D6.6
    ast.node* call = probe_call(&e, "n > 0 ? 1 : -2147483648, n > 0 ? 1 : -2147483649", true);
    assert(check_env.type_text(&e, ast.ast_child(call, 0)->ty) == "i32");
    assert(check_env.type_text(&e, ast.ast_child(call, 1)->ty) == "i64");
}

fn void a_conditional_arm_that_fits_no_type_of_the_rule_is_the_error() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // The tail of the same rule through a conditional: neither type holds the
    // constant, so the error names i64, the widest the clause offers. The count
    // is the assertion beside the text, because the harness of the language
    // corpus judges a line and not a count.
    // D4.5, D6.6
    assert(probe_call(&e, "n > 0 ? 9223372036854775808 : 1", false) != null);
    assert(check_env.said(&e, "constant 9223372036854775808 does not fit i64"));
    assert(check_env.errors(&e) == 1);
}

fn void a_constant_with_no_default_type_may_still_fold_back_into_range() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // The same operand as the test above it, shifted by a constant count. The
    // fold happens before any type is chosen, so the value that meets the rule
    // is 2^62 and not 2^63, and the expression is legal.
    // D4.4, D4.5
    ast.node* call = probe_call(&e, "9223372036854775808 >> 1, 18446744073709551615 >> 32", true);
    assert(check_env.type_text(&e, ast.ast_child(call, 0)->ty) == "i64");
    assert(check_env.type_text(&e, ast.ast_child(call, 1)->ty) == "i64");
    check_env.env mut f = check_env.env{};
    check_env.open(&f);
    defer check_env.close(&f);
    assert(check_env.check_init_of(&f, "i64", "9223372036854775808 >> 1"));
    i64 mut v = 0;
    assert(check_env.init_int(&f, "probe", &v));
    assert(v == 4611686018427387904);
}

fn void a_char_constant_in_an_integer_context_is_its_code_point() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(check_env.check_init_of(&e, "i32", "'A' + 1"));
    i64 mut v = 0;
    assert(check_env.init_int(&e, "probe", &v));
    assert(v == 66);
}

fn void null_needs_a_pointer_typed_context() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(check_env.check_init_of(&e, "i32*", "null"));
    assert(check_env.probe_type(&e) == "i32*");
    check_env.env mut f = check_env.env{};
    check_env.open(&f);
    defer check_env.close(&f);
    assert(!check_env.check_init_of(&f, "i32", "null"));
    assert(check_env.said(&f, "'null' needs a pointer type, not i32"));
}

// ---- operators ---------------------------------------------------------------------
// D6.2

fn void a_comparison_yields_bool_and_folds() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(check_env.check_init_of(&e, "bool", "2 < 3"));
    assert(check_env.probe_type(&e) == "bool");
}

// ---- a comparison of two untyped operands -------------------------------------------
// A comparison yields bool, so no context reaches its operands: the rule of the
// default type answers for them where the comparison is checked, over both
// sides together. The pair took the left operand's type until 2026-09-14, which
// dropped the other operand's poison and its constant. The C twin is
// test/check_untyped_pair_test.c.
// D4.1, D4.5, D6.2

// The four comparisons, two orderings and two equalities, as the text before
// the constant and the text after it. The other operand is `1 << n`, which
// folds to no value.
// D4.5
string[4] PAIR_HEAD = string[4]{
    "    i32 n = 1;\n    println(",
    "    i32 n = 1;\n    println((1 << n) > ",
    "    i32 n = 1;\n    println(",
    "    i32 n = 1;\n    println((1 << n) != ",
};

string[4] PAIR_TAIL = string[4]{
    " > (1 << n));",
    ");",
    " == (1 << n));",
    ");",
};

// The two ends of the range the rule has no type for, `[2^63, 2^64 - 1]`, and
// the message each draws against i64, the widest type the rule offers.
// D4.5
string[2] PAIR_ENDS = string[2]{
    "9223372036854775808",
    "18446744073709551615",
};

string[2] PAIR_MESSAGES = string[2]{
    "constant 9223372036854775808 does not fit i64",
    "constant 18446744073709551615 does not fit i64",
};

fn void a_comparison_reports_the_constant_of_either_operand() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    u64 mut c = 0;
    while (c < PAIR_ENDS.len) {
        u64 mut i = 0;
        while (i < PAIR_HEAD.len) {
            if (c > 0 || i > 0) {
                check_env.reopen(&e);
            }
            strbuf.str_buf mut b = strbuf.create();
            strbuf.append(&b, PAIR_HEAD[i]);
            strbuf.append(&b, PAIR_ENDS[c]);
            strbuf.append(&b, PAIR_TAIL[i]);
            // The constant has no default type, so the rule's own tail reports
            // it against i64, on whichever side it stands. The right side
            // printed a wrong answer until 2026-09-14 and the left side gave
            // the two operands two widths.
            // D4.5, D6.2
            assert(!check_env.check_body(&e, strbuf.view(&b)));
            assert(check_env.said(&e, PAIR_MESSAGES[c]));
            // The count, because the harness of the language corpus groups
            // diagnostics by line and cannot see one that is added or doubled.
            // D14.2
            assert(check_env.errors(&e) == 1);
            strbuf.free(&b);
            i += 1;
        }
        c += 1;
    }
}

fn void a_comparison_reports_a_bad_constant_on_each_side() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // Both sides are retyped, so both are reported. A fix that retyped the left
    // side alone leaves this at one diagnostic, and the corpus cannot see the
    // difference, because both stand on one line.
    // D4.5
    assert(!check_env.check_body(&e,
        "    i32 n = 1;\n    println((9223372036854775808 << n) > (18446744073709551615 << n));"));
    assert(check_env.said(&e, "constant 9223372036854775808 does not fit i64"));
    assert(check_env.said(&e, "constant 18446744073709551615 does not fit i64"));
    assert(check_env.errors(&e) == 2);
}

fn void a_comparison_takes_one_default_type_over_both_operands() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // One type covers the whole untyped expression, and the clause that wins is
    // the strongest either side asks for. The left operand alone decided it
    // until 2026-09-14: `2147483648 > (1 << n)` gave the constant i64 and the
    // shift i32, which clang refused as two widths in one comparison.
    // D4.5, D6.2
    ast.node* one = probe_call(&e, "2147483648 > (1 << n)", true);
    assert(check_env.type_text(&e, ast.ast_child(one, 0)->a->ty) == "i64");
    assert(check_env.type_text(&e, ast.ast_child(one, 0)->b->ty) == "i64");
    check_env.reopen(&e);
    ast.node* two = probe_call(&e, "(1 << n) > 2147483648", true);
    assert(check_env.type_text(&e, ast.ast_child(two, 0)->a->ty) == "i64");
    assert(check_env.type_text(&e, ast.ast_child(two, 0)->b->ty) == "i64");
    check_env.reopen(&e);
    // Neither side asks for more than i32, so the pair keeps i32.
    // D4.5
    ast.node* three = probe_call(&e, "2 > (1 << n)", true);
    assert(check_env.type_text(&e, ast.ast_child(three, 0)->a->ty) == "i32");
    assert(check_env.type_text(&e, ast.ast_child(three, 0)->b->ty) == "i32");
    check_env.reopen(&e);
    // The integer clause wins over the char clause, so the char literal is its
    // code point and both operands are i32. It was i8 beside i32 before.
    // D4.3, D4.5
    ast.node* four = probe_call(&e, "'a' > (1 << n)", true);
    assert(check_env.type_text(&e, ast.ast_child(four, 0)->a->ty) == "i32");
    assert(check_env.type_text(&e, ast.ast_child(four, 0)->b->ty) == "i32");
    check_env.reopen(&e);
    // The float clause loses to the integer clause in the same way, and the
    // float constant is then the error. Its twin for `?:` is in
    // check_float_test.ft; stage1 has no float literal at all.
    // D4.2, D4.5
    assert(probe_call(&e, "0.5 > (1 << n)", false) != null);
    assert(check_env.said(&e, "a float constant does not become i32: use cast"));
    assert(check_env.errors(&e) == 1);
}

fn void a_pair_whose_sides_ask_for_no_type_at_all_keeps_i32() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // The tail of `untyped_pair_type`. A `null` arm asks for no default type
    // of its own, so the walk of both sides answers `prim_void` and the pair keeps
    // the i32 that `default_type` keeps in the same case. The i32 is observable:
    // it is the type each `null` is then reported against. Four diagnostics, one
    // for each `null` leaf, which is both sides retyped.
    // D4.5, D6.2, D10.5
    assert(!check_env.check_body(&e,
        "    bool c = true;\n    println((c ? null : null) == (c ? null : null));"));
    assert(check_env.said(&e, "'null' needs a pointer type, not i32"));
    assert(check_env.errors(&e) == 4);
    check_env.reopen(&e);
    // The same through an inequality, since the branch is every comparison.
    // D6.2
    assert(!check_env.check_body(&e,
        "    bool c = true;\n    println((c ? null : null) != (c ? null : null));"));
    assert(check_env.errors(&e) == 4);
}

fn void a_float_constant_across_a_comparison_is_one_error() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // T-127: the checker passed these two and LLVM refused the module
    // The pair takes one type over both sides. The integer clause and the char
    // clause each win over the float clause, so the float constant then meets
    // a type it cannot take. Each program is one error and not two: the side
    // that folded to no value holds no constant the type refuses, so only the
    // float constant is reported. The language corpus cannot see that count,
    // because `judge_fail` groups its diagnostics by file and by line. So the
    // count is asserted here.
    // Both programs emitted the float bit pattern into an integer comparison
    // until 2026-09-14.
    // D4.2, D4.5, D6.2
    assert(!check_env.check_body(&e,
        "    i32 n = 1;\n    println((1 << n) == 2.5);"));
    assert(check_env.said(&e, "a float constant does not become i32"));
    assert(check_env.errors(&e) == 1);
    check_env.reopen(&e);
    // The char clause of the same rule. Both arms are char literals, so the
    // conditional is a `char` and the float constant meets `char`.
    // D4.3, D4.5
    assert(!check_env.check_body(&e,
        "    i32 n = 1;\n    println((n > 0 ? 'a' : 'b') == 1.5);"));
    assert(check_env.said(&e, "a float constant does not become char"));
    assert(check_env.errors(&e) == 1);
    check_env.reopen(&e);
    // The operand order does not change either answer.
    // D6.2
    assert(!check_env.check_body(&e,
        "    i32 n = 1;\n    println(2.5 == (1 << n));"));
    assert(check_env.errors(&e) == 1);
    check_env.reopen(&e);
    assert(!check_env.check_body(&e,
        "    i32 n = 1;\n    println(1.5 == (n > 0 ? 'a' : 'b'));"));
    assert(check_env.errors(&e) == 1);
}

fn void a_unary_operand_leaves_the_pair_before_the_rule_sees_it() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // `check_unary` gives an operand with no value its default type at once and
    // alone, which the note of 2026-09-14 ratifies, so `-(1 << n)` is a typed
    // i32 and the constant beside it takes i32 from a typed operand, as it takes
    // a type from any typed operand. The pair rule never runs: an untyped pair is
    // two untyped sides. So the constant that is legal in `(1 << n) > 2147483648`
    // is an error one unary minus away from it, and that is the ordinary context
    // rule and not a hole.
    // D4.1, D4.5
    assert(!check_env.check_body(&e, "    i32 n = 1;\n    println(-(1 << n) > 2147483648);"));
    assert(check_env.said(&e, "constant 2147483648 does not fit i32"));
    assert(check_env.errors(&e) == 1);
    check_env.reopen(&e);
    assert(!check_env.check_body(&e, "    i32 n = 1;\n    println(2147483648 > ~(1 << n));"));
    assert(check_env.said(&e, "constant 2147483648 does not fit i32"));
    check_env.reopen(&e);
    // With no unary the same constant carries the pair to i64 and the program
    // runs. run/constants/014 prints the answer.
    // D4.5
    assert(check_env.check_body(&e, "    i32 n = 1;\n    println((1 << n) > 2147483648);"));
    assert(check_env.errors(&e) == 0);
}

fn void a_comparison_that_folds_and_one_with_a_typed_operand_are_unchanged() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // The two neighbours of the rule, so that a change to it is seen here
    // first. Both operands carry a value, so the comparison folds and no
    // default type is chosen for it; and a typed operand is a context, which
    // the untyped one takes its type from. The C twin asserts the folded value.
    // D4.1, D4.4
    assert(check_env.check_init_of(&e, "bool", "2147483648 > 1"));
    assert(check_env.probe_type(&e) == "bool");
    check_env.reopen(&e);
    ast.node* call = probe_call(&e, "n > (1 << n)", true);
    assert(check_env.type_text(&e, ast.ast_child(call, 0)->b->ty) == "i32");
    check_env.reopen(&e);
    // A constant that does not fit the typed operand is reported by the
    // conversion, once, exactly as it was.
    // D4.1
    assert(!check_env.check_body(&e, "    i32 n = 1;\n    println(n > 9223372036854775808);"));
    assert(check_env.said(&e, "constant 9223372036854775808 does not fit i32"));
    assert(check_env.errors(&e) == 1);
}

fn void an_untyped_pair_that_is_no_comparison_still_reaches_its_context() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // The other half of the same branch, which is unchanged: an operator that
    // is no comparison leaves the pair untyped, so the context walks both
    // operands and reports there. The count is what this asserts, because the
    // fix must not add a second report on the way.
    // D4.1, D4.5
    assert(!check_env.check_body(&e,
        "    i32 n = 1;\n    println(9223372036854775808 + (1 << n));"));
    assert(check_env.said(&e, "constant 9223372036854775808 does not fit i64"));
    assert(check_env.errors(&e) == 1);
    check_env.reopen(&e);
    assert(!check_env.check_body(&e,
        "    i32 n = 1;\n    println((1 << n) + 9223372036854775808);"));
    assert(check_env.said(&e, "constant 9223372036854775808 does not fit i64"));
    assert(check_env.errors(&e) == 1);
    check_env.reopen(&e);
    // A sibling that needs i64 carries the whole expression to i64, which is
    // the same rule reached through the context.
    // D4.5, D6.2
    assert(check_env.check_body(&e, "    i32 n = 1;\n    i64 w = (1 << n) + 4294967296;"));
    assert(check_env.init_type(&e, "w") == "i64");
}

fn void there_is_no_promotion_between_two_integer_types() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!check_env.check_decls(&e, "i32 a = 1;\ni64 b = 2;\ni64 c = a + b;\n"));
    assert(check_env.said(&e, "'+' takes two operands of the same type, not i32 and i64"));
}

fn void char_has_no_arithmetic() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!check_env.check_decls(&e, "char c = 'a';\nchar d = c + 1;\n"));
    // The typed operand decides whether the operator applies at all, before
    // the untyped one adopts its type.
    // D3.2, D6.2
    assert(check_env.said(&e, "'+' takes numeric operands, not char"));
}

fn void there_is_no_pointer_arithmetic() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!check_env.check_decls(&e, "i32 k = 1;\ni32* p = &k;\ni32* q = p + 1;\n"));
    assert(check_env.said(&e, "there is no pointer arithmetic: '+' does not apply to i32*"));
}

fn void a_shift_keeps_the_type_of_its_left_operand() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(check_env.check_decls(&e, "u8 n = 2;\nu8 s = n << 1;\n"));
    assert(check_env.decl_type(&e, "s") == "u8");
    check_env.env mut f = check_env.env{};
    check_env.open(&f);
    defer check_env.close(&f);
    assert(!check_env.check_decls(&f, "u8 n = 2;\nu8 s = n << 8;\n"));
    assert(check_env.said(&f, "shift count must be in 0..7 for u8"));
}

fn void a_constant_division_by_zero_is_a_compile_error() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!check_env.check_init_of(&e, "i32", "1 / 0"));
    assert(check_env.said(&e, "constant division by zero"));
}

fn void a_typed_constant_that_overflows_its_type_is_a_compile_error() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!check_env.check_decls(&e, "i8 a = 100;\ni8 b = a + a;\n"));
    assert(check_env.said(&e, "constant expression overflows i8"));
}

fn void a_wrapping_operator_wraps_at_the_width_of_its_type() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(check_env.check_decls(&e, "u8 a = 200;\nu8 b = a +% 100;\n"));
    i64 mut v = 0;
    assert(check_env.init_int(&e, "b", &v));
    // 300 wraps to 44 at eight bits.
    // D11.2
    assert(v == 44);
}

fn void equality_is_defined_on_scalars_and_not_on_aggregates() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!check_env.check_decls(&e,
        "struct point {\n    i32 x;\n}\npoint p = {1};\nbool q = p == p;\n"));
    assert(check_env.said(&e, "'==' takes comparable operands, not point"));
}

fn void ordering_is_defined_on_integers_and_char_and_not_on_bool() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!check_env.check_init_of(&e, "bool", "true < false"));
    assert(check_env.said(&e, "'<' takes ordered operands, not bool"));
}

// ---- types -------------------------------------------------------------------------
// D3, D5.3

fn void a_written_type_resolves_to_the_type_its_markers_spell() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(check_env.check_decls(&e, "i32 k = 1;\ni32 mut* p = null;\n"));
    // Level 0 is the binding's and lives outside the type, and
    // type_to_str_decl writes it last.
    // D5.2, D5.3
    assert(check_env.decl_type(&e, "p") == "i32 mut*");
}

fn void a_field_carries_no_outermost_mut() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!check_env.check_decls(&e, "struct box {\n    i32 mut v;\n}\n"));
    assert(check_env.said(&e, "a field's own storage follows its struct: remove the"));
}

fn void a_return_type_carries_no_outermost_mut() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!check_env.check_decls(&e, "fn i32 mut f() {\n    return 1;\n}\n"));
    assert(check_env.said(&e, "a return type has no binding: remove the outermost 'mut'"));
}

fn void an_unknown_type_name_is_one_error() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!check_env.check_decls(&e, "nosuch k = 1;\n"));
    assert(check_env.said(&e, "unknown type 'nosuch'"));
    assert(check_env.errors(&e) == 1);
}

fn void a_value_is_not_a_type() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!check_env.check_decls(&e, "i32 k = 1;\nk other = 2;\n"));
    assert(check_env.said(&e, "'k' is a constant, not a type"));
}

fn void noreturn_is_a_return_type_and_nothing_else() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // The parser refuses `noreturn` wherever a type is written and the
    // checker answers for the one place it does parse, a return type carrying
    // a suffix.
    // D8.5
    assert(!check_env.check_decls(&e, "fn noreturn* f() {\n    return null;\n}\n"));
    assert(check_env.said(&e, "'noreturn' is a return type"));
}

fn void an_array_length_is_a_constant_expression_greater_than_zero() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!check_env.check_decls(&e, "i32[0] a = {};\n"));
    assert(check_env.said(&e, "an array length must be greater than 0"));
}

// ---- structs and enums -------------------------------------------------------------
// D3.8, D3.9

fn void a_struct_records_the_byte_offset_of_every_field() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(check_env.check_decls(&e,
        "struct rec {\n    u8 tag;\n    i32 value;\n    u8 flag;\n}\nrec r = {1, 2, 3};\n"));
    // The offsets: each field at the next multiple of its alignment.
    // D3.8
    assert(check_env.field_offset(&e, "rec", "tag") == 0);
    assert(check_env.field_offset(&e, "rec", "value") == 4);
    assert(check_env.field_offset(&e, "rec", "flag") == 8);
}

fn void a_struct_of_mixed_alignment_pads_to_the_widest_member() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // The shape the C suite uses, whose widest member is eight bytes: an
    // assertion over a struct of alignment 4 cannot see a field misplaced by
    // a wider one.
    // D3.8
    assert(check_env.check_decls(&e,
        "struct wide {\n    u8 a;\n    i64 b;\n    u8 c;\n}\nwide w = {1, 2, 3};\n"));
    assert(check_env.field_offset(&e, "wide", "a") == 0);
    assert(check_env.field_offset(&e, "wide", "b") == 8);
    assert(check_env.field_offset(&e, "wide", "c") == 16);
}

fn void a_struct_that_contains_itself_by_value_has_infinite_size() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!check_env.check_decls(&e, "struct loop {\n    loop inner;\n}\n"));
    assert(check_env.said(&e, "struct loop has infinite size"));
    // Reported at the `struct` keyword, which is column 1 of line 1.
    // D14.2
    assert(check_env.report_text(&e, 0) == "1:1: struct loop has infinite size");
}

fn void a_struct_may_contain_itself_through_a_pointer() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(check_env.check_decls(&e, "struct node {\n    node mut* next;\n    i32 v;\n}\n"));
    assert(check_env.field_offset(&e, "node", "next") == 0);
    assert(check_env.field_offset(&e, "node", "v") == 8);
}

fn void enum_members_start_at_zero_and_increment() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(check_env.check_decls(&e,
        "enum color {\n    red,\n    green = 5,\n    blue,\n}\ni32 k = cast(color.blue, i32);\n"));
    i64 mut v = 0;
    assert(check_env.init_int(&e, "k", &v));
    assert(v == 6);
}

fn void duplicate_enum_values_are_an_error() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!check_env.check_decls(&e, "enum color {\n    red = 1,\n    green = 1,\n}\n"));
    assert(check_env.said(&e, "duplicate enum value 1 for 'green'"));
}

fn void an_enum_value_must_fit_i32() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!check_env.check_decls(&e, "enum big {\n    one = 4294967296,\n}\n"));
    assert(check_env.said(&e, "enum value 4294967296 does not fit i32"));
}

fn void an_enum_member_is_written_with_its_enum() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!check_env.check_decls(&e, "enum color {\n    red,\n}\ncolor c = red;\n"));
    assert(check_env.said(&e, "unknown name 'red': an enum member is written color.red"));
}

// ---- symbols and annotations -------------------------------------------------------

fn void every_declaration_carries_its_symbol_and_its_type() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(check_env.check_decls(&e,
        "struct point {\n    i32 x;\n}\nenum color {\n    red,\n}\ni32 k = 1;\n"));
    ast.node mut* s = check_env.node_in_main(&e, ast.ast_kind.k_struct_decl, "point");
    assert(s->sym != null && s->sym->kind == ast.sym_kind.s_struct);
    assert(check_env.type_text(&e, s->ty) == "point");
    ast.node mut* c = check_env.node_in_main(&e, ast.ast_kind.k_enum_decl, "color");
    assert(c->sym != null && c->sym->kind == ast.sym_kind.s_enum);
    ast.node mut* f = check_env.node_in_main(&e, ast.ast_kind.k_field_decl, "x");
    assert(f->sym != null && f->sym->kind == ast.sym_kind.s_field);
    assert(f->sym->owner == s->sym);
    ast.node mut* m = check_env.node_in_main(&e, ast.ast_kind.k_enum_member, "red");
    assert(m->sym != null && m->sym->kind == ast.sym_kind.s_enum_member);
    assert(m->sym->owner == c->sym);
}

fn void a_name_denotes_the_symbol_of_its_declaration() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(check_env.check_decls(&e, "i32 k = 1;\ni32 other = k;\n"));
    ast.node mut* other = check_env.node_in_main(&e, ast.ast_kind.k_var_decl, "other");
    ast.node mut* use = check_env.node_find(other->b, ast.ast_kind.k_ident, "k");
    assert(use != null && use->sym == check_env.sym_main(&e, "k"));
    // A symbol is found at the name it declares and not at the construct's
    // first token: `k` is at column 5 of line 1.
    // D20.4
    assert(use->sym->decl.col == 5);
}

fn void a_constant_expression_is_marked_and_its_value_recorded() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(check_env.check_init_of(&e, "i32", "2 + 3"));
    ast.node mut* d = check_env.node_in_main(&e, ast.ast_kind.k_var_decl, "probe");
    // ANN_CONST says `aux` indexes the folded value, which is the only
    // reading of `aux` on an expression.
    // D4.6
    assert(check_env.has_ann(d->b, check.ANN_CONST));
    assert(!check_env.has_ann(d->b, check.ANN_UNTYPED));
    i64 mut v = 0;
    assert(check_env.init_int(&e, "probe", &v));
    assert(v == 5);
}

fn void a_declaration_that_resolved_is_marked_resolved() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(check_env.check_decls(&e, "i32 k = 1;\n"));
    ast.node mut* d = check_env.node_in_main(&e, ast.ast_kind.k_var_decl, "k");
    assert(check_env.has_ann(d, check.ANN_RESOLVED));
    // Nothing is left on the resolution path when the pass is over.
    // D7.10
    assert(!check_env.has_ann(d, check.ANN_RESOLVING));
}

fn i32 main() {
    declarations_are_order_independent();
    a_declaration_defined_in_terms_of_itself_is_one_error();
    a_module_level_initializer_is_a_constant_expression();
    a_mut_module_declaration_is_a_global_and_a_plain_one_a_constant();
    reading_a_mut_global_is_not_a_constant_expression();
    an_integer_literal_takes_the_type_of_its_context();
    an_untyped_constant_folds_exactly_before_it_meets_its_context();
    a_constant_that_does_not_fit_its_context_is_an_error();
    an_integer_constant_does_not_become_char_or_bool_or_an_enum();
    an_untyped_constant_with_no_context_takes_its_default_type();
    an_expression_with_no_value_takes_i32_when_every_constant_fits();
    an_expression_with_no_value_takes_i64_when_a_constant_needs_it();
    a_node_that_folded_decides_for_the_subtree_below_it();
    one_wide_constant_widens_the_whole_untyped_expression();
    an_expression_with_no_value_beyond_i64_is_refused();
    a_poisoned_left_operand_that_is_no_constant_is_still_dropped();
    every_operator_that_drops_its_operand_reports_a_constant_with_no_type();
    every_operator_that_drops_its_operand_reports_a_constant_it_carries();
    a_constant_that_folds_back_into_range_leaves_the_operator_its_own_rule();
    a_dropped_operand_that_is_no_constant_keeps_its_one_diagnostic();
    a_dropped_operand_with_a_type_keeps_the_message_of_its_operator();
    a_context_that_meets_a_poisoned_constant_says_nothing_more();
    every_position_that_drops_its_operand_reports_once();
    a_context_with_a_real_type_still_names_itself();
    a_poisoned_context_of_its_own_stays_silent();
    a_char_alone_in_such_an_expression_asks_for_char();
    a_declared_char_is_no_more_an_integer_than_the_default_char_is();
    a_char_beside_an_integer_takes_the_integer_type();
    a_folded_char_stands_for_its_subtree_as_an_integer();
    a_folded_constant_with_no_context_takes_its_clause();
    a_context_that_takes_no_integer_constant_reports_the_constant();
    a_constant_that_asks_for_no_type_leaves_the_expression_at_i32();
    the_arms_of_a_conditional_take_one_default_type();
    the_conditional_takes_its_default_type_at_the_edge_of_i32();
    the_arm_a_conditional_never_takes_decides_its_type_too();
    a_conditional_arm_that_fits_no_type_of_the_rule_is_the_error();
    a_constant_with_no_default_type_may_still_fold_back_into_range();
    a_char_constant_in_an_integer_context_is_its_code_point();
    null_needs_a_pointer_typed_context();
    a_comparison_yields_bool_and_folds();
    a_comparison_reports_the_constant_of_either_operand();
    a_comparison_reports_a_bad_constant_on_each_side();
    a_comparison_takes_one_default_type_over_both_operands();
    a_pair_whose_sides_ask_for_no_type_at_all_keeps_i32();
    a_float_constant_across_a_comparison_is_one_error();
    a_unary_operand_leaves_the_pair_before_the_rule_sees_it();
    a_comparison_that_folds_and_one_with_a_typed_operand_are_unchanged();
    an_untyped_pair_that_is_no_comparison_still_reaches_its_context();
    there_is_no_promotion_between_two_integer_types();
    char_has_no_arithmetic();
    there_is_no_pointer_arithmetic();
    a_shift_keeps_the_type_of_its_left_operand();
    a_constant_division_by_zero_is_a_compile_error();
    a_typed_constant_that_overflows_its_type_is_a_compile_error();
    a_wrapping_operator_wraps_at_the_width_of_its_type();
    equality_is_defined_on_scalars_and_not_on_aggregates();
    ordering_is_defined_on_integers_and_char_and_not_on_bool();
    a_written_type_resolves_to_the_type_its_markers_spell();
    a_field_carries_no_outermost_mut();
    a_return_type_carries_no_outermost_mut();
    an_unknown_type_name_is_one_error();
    a_value_is_not_a_type();
    noreturn_is_a_return_type_and_nothing_else();
    an_array_length_is_a_constant_expression_greater_than_zero();
    a_struct_records_the_byte_offset_of_every_field();
    a_struct_of_mixed_alignment_pads_to_the_widest_member();
    a_struct_that_contains_itself_by_value_has_infinite_size();
    a_struct_may_contain_itself_through_a_pointer();
    enum_members_start_at_zero_and_increment();
    duplicate_enum_values_are_an_error();
    an_enum_value_must_fit_i32();
    an_enum_member_is_written_with_its_enum();
    every_declaration_carries_its_symbol_and_its_type();
    a_name_denotes_the_symbol_of_its_declaration();
    a_constant_expression_is_marked_and_its_value_recorded();
    a_declaration_that_resolved_is_marked_resolved();
    println("ok");
    return 0;
}
