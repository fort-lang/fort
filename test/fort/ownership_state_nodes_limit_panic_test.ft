//! abort
//! stderr: panic: ownership_state.nodes: capacity overflow
//! stdout:
//| 0
/// append_nodes refuses to add an entry after U64_MAX entries, because the count would
/// pass u64. The test sets nodes_len to U64_MAX, and the call panics.
import ownership_api;
import ownership_state;

fn main() i32 {
    ownership_state.state mut s = ownership_state.empty();
    defer ownership_state.free(&s);
    println(s.nodes_len);
    s.nodes_len = ownership_state.U64_MAX;
    ownership_state.append_nodes(&s, ownership_api.graph_node{});
    return 0;
}
