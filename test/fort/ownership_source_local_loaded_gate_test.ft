//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| standalone ok
//| record ok
//| bound ok
/// Tests standalone and integrated loaded-source gates.
// A line here is a line of SOURCE.
import ownership_api;
import ownership_keys;
import ownership_source;
import ownership_source_calls;
import ownership_source_env;
import ownership_source_local;
import std.strbuf;

u32 CHAIN_MAIN_LINE = 18;
u32 CHAIN2_MAIN_LINE = 25;
u32 CHAIN4_MAIN_LINE = 28;
u32 CALLER_LOCAL_LINE = 36;
u32 VIEW_LINE = 53;
u32 LEGAL_STORE_LINE = 65;

string[70] SOURCE = {
    "struct holder { u8@ s; }",
    "struct cell { i64 a; }",
    "struct ph { cell* p; }",
    "struct block { u32 n; }",
    "struct block_vec { block mut@ own items; u64 len; }",
    "struct func { block_vec blocks; u64 len; }",
    "holder mut GH = holder{{}};",
    "ph mut GPH = ph{null};",
    "fn stash(holder mut* h) void {",
    "    u8 mut@ own b = new(u8, 4);",
    "    h->s = b[..4];",
    "    del(b);",
    "}",
    "fn read(holder* h) u8 {",
    "    u8@ v = h->s[..];",
    "    return v[0];",
    "}",
    "fn chain_main() u8 {",
    "    holder mut h = holder{{}};",
    "    stash(&h);",
    "    return read(&h);",
    "}",
    "fn stash2(ph mut* h) void { cell mut* own b = new(cell); h->p = b; del(b); }",
    "fn read2(ph* h) i64 { i64* q = &h->p->a; return *q; }",
    "fn chain2_main() i64 { ph mut h = ph{null}; stash2(&h); return read2(&h); }",
    "fn gstash() void { u8 mut@ own b = new(u8, 4); GH.s = b[..4]; del(b); }",
    "fn chain3_main() u8 { gstash(); return read(&GH); }",
    "fn chain4_main() u8 {",
    "    u8 mut@ own b = new(u8, 4);",
    "    holder mut h = holder{{}};",
    "    h.s = b[..4];",
    "    del(b);",
    "    return read(&h);",
    "}",
    "fn set(holder mut* h, u8@ s) void { h->s = s; }",
    "fn caller_local() u8 {",
    "    u8 mut@ own b = new(u8, 4);",
    "    holder mut h = holder{{}};",
    "    set(&h, b[..4]);",
    "    del(b);",
    "    return read(&h);",
    "}",
    "fn caller_global() u8 {",
    "    u8 mut@ own b = new(u8, 4);",
    "    set(&GH, b[..4]);",
    "    del(b);",
    "    return read(&GH);",
    "}",
    "fn gset2() void { cell mut* own b = new(cell); GPH.p = b; del(b); }",
    "fn usel(ph* h) i64 { i64* q = &h->p->a; return *q; }",
    "fn use_loaded_main() i64 { gset2(); return usel(&GPH); }",
    "fn block_at(func* f, u32 b) block* { return &f->blocks.items[cast(b, u64)]; }",
    "fn view(holder* h) u8@ { return h->s[..]; }",
    "fn view_caller() u8 {",
    "    u8 mut@ own b = new(u8, 4);",
    "    holder mut h = holder{{}};",
    "    h.s = b[..4];",
    "    u8@ v = view(&h);",
    "    del(b);",
    "    return v[0];",
    "}",
    "fn legal_caller() u8 {",
    "    u8 mut@ own b = new(u8, 4);",
    "    holder mut h = holder{{}};",
    "    h.s = b[..4];",
    "    u8@ v = view(&h);",
    "    u8 x = v[0];",
    "    del(b);",
    "    return x;",
    "}",
};

fn open(ownership_source_env.env mut* e, strbuf.str_buf mut* text) void {
    u64 mut i = 0;
    while (i < SOURCE.len) {
        strbuf.append(text, SOURCE[i]);
        strbuf.push(text, '\n');
        i += 1;
    }
    // The entry `main` makes the closure the program of `test/ownership/probes/loaded_callers.ft`,
    // an executable.
    strbuf.append(text, "fn main() i32 { return 0; }\n");
    ownership_source_env.open(e);
    ownership_source_env.runtime(e);
    assert(ownership_source_env.prepare(e, strbuf.view(text)));
}

fn row(ownership_source_env.env mut* e, string name) ownership_source.body mut* {
    return ownership_source_env.find(e, "main", name);
}

fn gap_in(string name, string run, ownership_source_local.context* c,
    ownership_source_local.missing why, u32 line) void {
    if (c->gap != why || c->gap_source.line != line ||
        c->correspondence != ownership_source_local.status.incomplete) {
        eprintln(name, " ", run, ": gap ", cast(c->gap, u64), " at ", c->gap_source.line);
        assert(false);
    }
    assert(c->violations_len == 0 && !ownership_api.successful(c->proof));
}

fn proved_in(string name, string run, ownership_source_local.context* c) void {
    if (c->correspondence != ownership_source_local.status.complete ||
        !ownership_api.successful(c->proof) || c->violations_len != 0) {
        eprintln(name, " ", run, ": not proved, gap ", cast(c->gap, u64), " at ",
            c->gap_source.line);
        assert(false);
    }
}

fn proved(ownership_source_env.env mut* e, string name) void {
    ownership_source.body mut* found = row(e, name);
    proved_in(name, "local", &found->local);
    proved_in(name, "stored", &found->stored);
}

// A caller that proves in the stored row only: its local row has the gap of `&h` at `line`.
fn stored_only(ownership_source_env.env mut* e, string name, u32 line) void {
    ownership_source.body mut* found = row(e, name);
    proved_in(name, "stored", &found->stored);
    gap_in(name, "local", &found->local, ownership_source_local.missing.unknown_source, line);
}

// The producer keeps one requirement record. The loaded source is live because each caller
// binds the entry requirement before it applies the summary.
fn record(ownership_source_env.env mut* e) void {
    ownership_source_local.context* c = &row(e, "read")->local;
    assert(c->initialized && !c->solved && c->loaded_len == 1);
    ownership_api.entity_id key = ownership_source_local.loaded_source(c, 0);
    u64 mut found = 0;
    u64 mut k = 0;
    while (k < c->entry.sources_len) {
        if (ownership_keys.entity(c->entry.sources[k].key, key) == 0) {
            assert(c->entry.sources[k].kind == ownership_api.source_kind.symbolic_caller);
            assert(c->entry.sources[k].validity == ownership_api.validity_kind.live);
            found += 1;
        }
        k += 1;
    }
    assert(found == 1);
    u64 mut steps = 0;
    u64 mut i = 0;
    while (i < c->steps_len) {
        if (c->relations[i].key.kind == ownership_api.entity_kind.relation &&
            ownership_keys.entity(c->relations[i].source, key) == 0) {
            assert(!c->steps[i].local.opaque_value);
            steps += 1;
        }
        i += 1;
    }
    assert(steps == 1);
    println("record ok");
}

// An unsafe caller gives incomplete proof and no violation: no event validates its read.
fn calls_unproved(ownership_source_env.env mut* e, string name) void {
    ownership_source_calls.row* calls = row(e, name)->calls;
    assert(calls != null && !ownership_api.successful(calls->proof));
    assert(calls->proof.kind == ownership_api.proof_kind.incomplete && calls->violations == 0);
}

// The summary solver gives unknown_effect at `line`, so the calls row is incomplete there.
fn summary_unknown(ownership_source_calls.row* calls, u32 line) void {
    assert(calls != null && !calls->summary_proved && calls->violations == 0);
    assert(calls->summary_proof.terminal.reason == ownership_api.incomplete_reason.unknown_effect);
    assert(calls->proof.terminal.reason == ownership_api.incomplete_reason.unknown_effect);
    if (calls->summary_proof.terminal.source.line != line ||
        calls->proof.terminal.source.line != line) {
        eprintln("summary gap at ", calls->summary_proof.terminal.source.line, ", want ", line);
        assert(false);
    }
}

// A direct FIR analysis has no call summaries. Its loaded source stays unknown, and the load
// stays the unknown-source gap.
fn standalone(ownership_source_env.env mut* e) void {
    ownership_source.body mut* found = row(e, "read");
    ownership_source_local.context mut c = ownership_source_local.context{};
    ownership_source_local.prepare(&c, &found->function, found->key, found->source.file,
        found->module->file, found->source);
    defer ownership_source_local.free(&c);
    assert(!c.callers_bind_loaded && c.loaded_len == 1);
    ownership_api.entity_id key = ownership_source_local.loaded_source(&c, 0);
    u64 mut matches = 0;
    u64 mut i = 0;
    while (i < c.entry.sources_len) {
        if (ownership_keys.entity(c.entry.sources[i].key, key) == 0) {
            assert(c.entry.sources[i].validity == ownership_api.validity_kind.unknown);
            matches += 1;
        }
        i += 1;
    }
    assert(matches == 1 && c.gap == ownership_source_local.missing.unknown_source);
    println("standalone ok");
}

// The local analyses prove each clean loaded source. The call analysis refuses each bad caller.
// The heap solver proves the caller that reads the returned view before release. The summary
// solver gives unknown_effect at the store of a slice into a field of `h`, so the calls row of
// that caller stays incomplete at the store. The heap solver proves the full slice that `view`
// returns. The summary solver gives unknown_effect at that slice, so the calls row of `view`
// stays incomplete there.
fn bound(ownership_source_env.env mut* e) void {
    proved(e, "read");
    proved(e, "read2");
    proved(e, "usel");
    proved(e, "block_at");
    proved(e, "view");
    // These callers pass the dangling buffer and prove in both rows already.
    proved(e, "chain3_main");
    proved(e, "caller_global");
    proved(e, "use_loaded_main");
    // These four prove in the stored row, which tracks the stack source of h. The local run
    // tracks no aggregate, so `&h` is its gap. Call analysis rejects each unsafe caller below.
    stored_only(e, "chain_main", CHAIN_MAIN_LINE + 2);
    stored_only(e, "chain2_main", CHAIN2_MAIN_LINE);
    stored_only(e, "chain4_main", CHAIN4_MAIN_LINE + 5);
    stored_only(e, "caller_local", CALLER_LOCAL_LINE + 3);
    string[5] bad = {"chain_main", "chain2_main", "chain4_main", "caller_local",
        "view_caller"};
    for (string name : bad) { calls_unproved(e, name); }
    ownership_source_calls.row* legal = row(e, "legal_caller")->calls;
    assert(legal != null && legal->heap_proved &&
        ownership_api.successful(legal->heap_proof));
    summary_unknown(legal, LEGAL_STORE_LINE);
    ownership_source_calls.row* viewed = row(e, "view")->calls;
    assert(viewed != null && viewed->heap_proved &&
        ownership_api.successful(viewed->heap_proof));
    summary_unknown(viewed, VIEW_LINE);
    ownership_source_calls.row* unsafe_view = row(e, "view_caller")->calls;
    assert(unsafe_view != null && !unsafe_view->heap_proved);
    println("bound ok");
}

fn main() i32 {
    ownership_source_env.env mut on = ownership_source_env.env{};
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    open(&on, &text);
    standalone(&on);
    record(&on);
    ownership_source.analyze(&on.source);
    bound(&on);
    ownership_source_env.close(&on);
    return 0;
}
