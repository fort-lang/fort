//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: fir_flow.bits_union: the counts differ
//! stdout:
//| ready
/// Checks that fir_flow.bits_union refuses two sets of different counts. The sets of 64 and 65
/// numbers differ in their count of words too, so a join of the two would read past a word.
import fir_flow;

fn main() i32 {
    fir_flow.bits mut a = fir_flow.bits_new(64);
    defer fir_flow.bits_free(&a);
    fir_flow.bits mut b = fir_flow.bits_new(65);
    defer fir_flow.bits_free(&b);
    fir_flow.bits_union(&a, &a);
    println("ready");
    fir_flow.bits_union(&a, &b);
    return 0;
}
