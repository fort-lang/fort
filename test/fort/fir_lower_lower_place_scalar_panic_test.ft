//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: fir_lower.lower_place: a scalar that designates no storage
//! stdout:
//| true
/// The checker gives each scalar lvalue a name, a field, `->`, an index or `*`. An integer
/// literal is none of them, so lower_place panics on it.
import fort.ast;
import check_env;
import fort.fir;
import fort.fir_lower;
import lower_env;

fn main() i32 {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[3] source = {
        "fn f() i32 {",
        "    return 1;",
        "}",
    };
    lower_env.check_lines(&e, source[..], true);
    place_the_literal(&e);
    return 0;
}

// Lowers the literal `1` of `f` as a place. The function takes the environment as a
// parameter, so the reads through `decl` and `one` use no owner of its frame. The read of the
// type comes before `f` and `lw` exist (D17.21).
fn place_the_literal(lower_env.env mut* e) void {
    ast.node* decl = lower_env.decl(e, "f");
    ast.node mut* one = check_env.node_in_main(&e->c, ast.ast_kind.k_int, "");
    println(!fir.type_aggregate(one->ty));
    fir.func mut f = fir.func_new(&e->c.ck.types, decl->sym, decl->sym->ty);
    defer fir.func_free(&f);
    fir_lower.lowerer mut lw = fir_lower.lowerer{.ck = &e->c.ck, .f = &f};
    defer fir_lower.scopes_free(&lw.scopes);
    fir_lower.prescan(&f, decl->b);
    fir.place mut out = fir.place{};
    fir_lower.lower_place(&lw, one, &out);
}
