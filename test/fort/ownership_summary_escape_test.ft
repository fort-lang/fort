//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| boundary G10.1
//| boundary G10.2
//| boundary G10.3
//| boundary G10.4
//| boundary X05
//| boundary X24
/// Checks body-derived linear call effects and their source boundaries.
import fir;
import ownership_api;
import ownership_calls_fixtures;
import ownership_flow;
import ownership_keys;
import ownership_state;
import ownership_summary;
import ownership_summary_body;
import ownership_summary_model;
import ownership_transfer;

string[9] SOURCE_1 = {
    "struct owner_box {",
    "    i32 mut* own item;",
    "    i32 tag;",
    "}",
    "struct view_box { i32* ptr; }",
    "struct inline_box { i32 value; }",
    "struct inline_view { i32 value; i32* ptr; }",
    "fn callee(i32* p) i32* { return p; }",
    "fn caller(i32* p) i32 { return *callee(p); }",
};

string[9] SOURCE_2 = {
    "struct owner_box {",
    "    i32 mut* own item;",
    "    i32 tag;",
    "}",
    "struct view_box { i32* ptr; }",
    "struct inline_box { i32 value; }",
    "struct inline_view { i32 value; i32* ptr; }",
    "fn callee(i32 mut* own p) i32 mut* own { return move(p); }",
    "fn caller(i32 mut* own p) void { i32 mut* own q = callee(move(p)); del(q); }",
};

string[9] SOURCE_3 = {
    "struct owner_box {",
    "    i32 mut* own item;",
    "    i32 tag;",
    "}",
    "struct view_box { i32* ptr; }",
    "struct inline_box { i32 value; }",
    "struct inline_view { i32 value; i32* ptr; }",
    "fn callee(inline_box value) i32* { return &value.value; }",
    "fn caller(inline_box value) i32* { return callee(value); }",
};

string[9] SOURCE_4 = {
    "struct owner_box {",
    "    i32 mut* own item;",
    "    i32 tag;",
    "}",
    "struct view_box { i32* ptr; }",
    "struct inline_box { i32 value; }",
    "struct inline_view { i32 value; i32* ptr; }",
    "fn callee(view_box mut* out, inline_box value) void { out->ptr = &value.value; }",
    "fn caller(view_box mut* out, inline_box value) void { callee(out, value); }",
};

string[12] SOURCE_5 = {
    "struct owner_box {",
    "    i32 mut* own item;",
    "    i32 tag;",
    "}",
    "struct view_box { i32* ptr; }",
    "struct inline_box { i32 value; }",
    "struct inline_view { i32 value; i32* ptr; }",
    "fn callee(i32 mut* own p) i32 mut* own { return move(p); }",
    "fn caller(i32 mut* own p) void {",
    "    i32 mut* own q = callee(move(p));",
    "    del(q);",
    "}",
};

string[9] SOURCE_6 = {
    "struct owner_box {",
    "    i32 mut* own item;",
    "    i32 tag;",
    "}",
    "struct view_box { i32* ptr; }",
    "struct inline_box { i32 value; }",
    "struct inline_view { i32 value; i32* ptr; }",
    "fn callee(inline_box value) i32* { return &value.value; }",
    "fn caller(inline_box value) i32* { return callee(value); }",
};

fn successful(ownership_calls_fixtures.fixture* f) void {
    assert(ownership_api.successful(f->summary.proof));
    assert(!f->summary.residual_effects && !f->summary.coverage.actual_source_complete);
    assert(f->summary.cases.len == 1);
    assert(f->summary.cases[0].outcome.kind == ownership_api.outcome_kind.function_return);
    assert(ownership_api.successful(f->application.proof));
    assert(f->application.normal_continuation);
    assert(f->application.outcome.kind == ownership_api.outcome_kind.function_return);
}

fn original(ownership_calls_fixtures.fixture* f) ownership_api.entity_id {
    return ownership_calls_fixtures.contents(f, 1).borrows[0].source;
}

fn result(ownership_calls_fixtures.fixture* f) ownership_api.contents_fact {
    fir.statement* call = fir.block_statement(&f->functions[1], f->call_block, f->call_gap);
    ownership_api.place_path place = ownership_summary_body.slot(&f->inputs[1], call->place.local);
    u64 index = ownership_transfer.contents_index(&f->application.state, place);
    assert(index != ownership_api.U64_MAX);
    return f->application.state.contents[index];
}

fn case_g10_1() void {
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    ownership_calls_fixtures.open(&f, SOURCE_1[..]);
    defer ownership_calls_fixtures.close(&f);
    assert(ownership_api.successful(f.summary.proof));
    ownership_calls_fixtures.prepare(&f);
    ownership_calls_fixtures.configure_source(&f, ownership_api.source_kind.heap,
        ownership_api.validity_kind.live, 4);
    ownership_calls_fixtures.apply(&f, 1);
    successful(&f);
    assert(result(&f).borrows.len == 1);
    assert(ownership_summary_model.same(result(&f).borrows[0].source, original(&f)));
    assert(result(&f).borrows[0].range.extent.value == 4);
    assert(ownership_api.successful(ownership_calls_fixtures.suffix(&f)));
    u64 parameter = ownership_state.source_index(&f.application.state,
        ownership_summary_body.source(&f.inputs[0], 1));
    assert(f.application.state.sources[parameter].validity == ownership_api.validity_kind.ended);
    ownership_calls_fixtures.boundary("G10.1",
        "87ecd84fbbb9090d4cb40193fb8618a9263ea13bcb0682dfd9d95cf427eaeaf9", "none");
}

fn case_g10_2() void {
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    ownership_calls_fixtures.open(&f, SOURCE_2[..]);
    defer ownership_calls_fixtures.close(&f);
    assert(ownership_api.successful(f.summary.proof));
    ownership_calls_fixtures.prepare(&f);
    ownership_calls_fixtures.apply(&f, 1);
    successful(&f);
    assert(ownership_calls_fixtures.outstanding(&f.application.state) == 1);
    assert(result(&f).borrows.len == 1);
    assert(ownership_summary_model.same(result(&f).borrows[0].source, original(&f)));
    assert(!ownership_summary_model.same(result(&f).borrows[0].source,
        ownership_summary_body.source(&f.inputs[0], 1)));
    assert(ownership_api.successful(ownership_calls_fixtures.suffix(&f)));
    assert(ownership_calls_fixtures.outstanding(&f.caller) == 0);
    ownership_calls_fixtures.boundary("G10.2",
        "a2039a11d6d0d3429e869b248f19dbf0fd0b35f39d6be1cfb5d1dc4939cf6b22", "none");
}

fn case_g10_3() void {
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    ownership_calls_fixtures.open(&f, SOURCE_3[..]);
    defer ownership_calls_fixtures.close(&f);
    assert(f.summary.proof.failed && !ownership_api.successful(f.summary.proof));
    assert(f.services.counts.last.kind == ownership_api.event_kind.invalid_use);
    assert(f.services.counts.last.operation.function.declaration.declaration == 1);
    assert(f.services.counts.last.kind != ownership_api.event_kind.caller_requirement);
    assert(f.summary.requirements.len == 0 && f.summary.residual_effects);
    ownership_calls_fixtures.boundary("G10.3",
        "e28580bfec1ab946dfd5aadaf26ecf1080e793f90be49d408c08c2e96f71e4ec", "invalid_use");
}

