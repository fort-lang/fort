fn check_clone(fir.func* original) void {
    fir.func mut copied = fir.func_clone(original);
    defer fir.func_free(&copied);
    copied.range_declarations.items[0].id = 99;
    copied.range_boundaries.items[0].order = 99;
    copied.blocks.items[0].statements.items[0].stmt = 99;
    assert(original->range_declarations.items[0].id == 1);
    assert(original->range_boundaries.items[0].order == 0);
    assert(original->blocks.items[0].statements.items[0].stmt == 0);
    fir.range_clear(&copied);
    assert(copied.range_declarations.len == 0);
    assert(copied.range_boundaries.len == 0);
    assert(original->range_declarations.len == 1);
    assert(original->range_boundaries.len == 5);
    println("clone ok");
}

fn check_partial(llvm_env.env mut* e, fir.func* original) void {
    fir.func mut partial = fir.func_clone(original);
    defer fir.func_free(&partial);
    partial.range_supplied_complete = false;
    partial.range_claim = fir.range_manifest{};
    fir.range_manifest result = fir_verify.range_manifest_report(&partial, &e->low.rt);
    assert(result.structural_valid);
    assert(!result.supplied_complete && !result.source_complete);
    println("partial inactive");
}

fn check_roundtrip(fir.module* original) void {
    strbuf.str_buf mut first = strbuf.create();
    defer strbuf.free(&first);
    strbuf.str_buf mut second = strbuf.create();
    defer strbuf.free(&second);
    fir_print.print_module(original, &first);
    llvm_env.env mut e = llvm_env.env{};
    llvm_env.open(&e);
    defer llvm_env.close(&e);
    string[1] lines = {strbuf.view(&first)};
    fir.module mut parsed = llvm_env.parse(&e, PRELUDE[..], lines[..]);
    defer fir.module_free(&parsed);
    fir_print.print_module(&parsed, &second);
    assert(strbuf.view(&first) == strbuf.view(&second));
    println("roundtrip ok");
}

fn compare_modes(llvm_env.env mut* e, fir.func* original, string label) void {
    u64 mut mode = 0;
    strbuf.str_buf mut first = strbuf.create();
    defer strbuf.free(&first);
    while (mode < pass_env.MODE_COUNT) {
        fir.func mut full = fir.func_clone(original);
        defer fir.func_free(&full);
        fir.func mut bare = fir.func_clone(original);
        defer fir.func_free(&bare);
        fir.range_clear(&bare);
        pass_env.build(&e->low, &full, pass_env.MODES[mode]);
        pass_env.build(&e->low, &bare, pass_env.MODES[mode]);
        pass_env.verified(&e->low, &full, "carrier pass result");
        pass_env.verified(&e->low, &bare, "bare pass result");
        strbuf.clear(&first);
        llvm_env.reset(e, pass_env.MODES[mode]);
        strbuf.append(&first, llvm_env.whole(e, &full));
        llvm_env.reset(e, pass_env.MODES[mode]);
        string text = llvm_env.whole(e, &bare);
        if (strbuf.view(&first) != text) {
            eprintln("full:\n", strbuf.view(&first), "bare:\n", text);
        }
        assert(strbuf.view(&first) == text);
        llvm_env.verified(e, text);
        mode += 1;
    }
    println(label, " llvm equal ", mode);
}

fn compare_case(string@ prelude, string@ input, string label, u32 loans) void {
    llvm_env.env mut e = llvm_env.env{};
    llvm_env.open(&e);
    defer llvm_env.close(&e);
    fir.module mut m = llvm_env.parse(&e, prelude, input);
    defer fir.module_free(&m);
    assert(fir.module_function_count(&m) == 1);
    fir.func* f = fir.module_function_at(&m, 0);
    fir.range_manifest counts = fir_verify.range_manifest_report(f, &e.low.rt);
    assert(counts.structural_valid && counts.supplied_complete);
    assert(!counts.source_complete && counts.loans == loans);
    compare_modes(&e, f, label);
}

fn main() i32 {
    llvm_env.env mut e = llvm_env.env{};
    llvm_env.open(&e);
    defer llvm_env.close(&e);
    fir.module mut m = llvm_env.parse(&e, PRELUDE[..], INPUT[..]);
    defer fir.module_free(&m);
    assert(fir.module_function_count(&m) == 1);
    fir.func* f = fir.module_function_at(&m, 0);
    fir.range_manifest counts = fir_verify.range_manifest_report(f, &e.low.rt);
    println("carriers ", counts.declarations, " ", counts.expansions, " ",
            counts.protected_expansions, " ", counts.loans, " ", counts.bindings,
            " ", counts.boundaries, " ", counts.absences);
    assert(!counts.source_complete);
    assert(counts.structural_valid && counts.supplied_complete);
    check_roundtrip(&m);
    check_partial(&e, f);
    check_clone(f);
    compare_modes(&e, f, "base");
    compare_case(NESTED_PRELUDE[..], NESTED_INPUT[..], "nested", 3);
    compare_case(SHIFT_PRELUDE[..], SHIFT_INPUT[..], "shift", 1);
    compare_case(FOLD_PRELUDE[..], FOLD_INPUT[..], "fold", 1);
    compare_case(FOLD_PRELUDE[..], FOLD_ENTRY_INPUT[..], "fold entry", 1);
    compare_case(FOLD_PRELUDE[..], FOLD_SPLIT_INPUT[..], "fold split", 1);
    return 0;
}
