//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| carriers 1 1 0 1 1 5 0
//| roundtrip ok
//| partial inactive
//| clone ok
//| base llvm equal 4
//| nested llvm equal 4
//| shift llvm equal 4
//| fold llvm equal 4
//| fold entry llvm equal 4
//| fold split llvm equal 4
/// Checks owned FIR range carriers and unchanged LLVM text across four build modes.
import fir;
import fir_print;
import fir_verify;
import llvm_env;
import pass_env;
import std.strbuf;

string[3] PRELUDE = {
    "fn f(i32[2] a, bool c) i32 {",
    "    return 1;",
    "}",
};

string[25] INPUT = {
    "fn main.f(_1 (a): i32[2], _2 (c): bool) -> i32 {",
    "    let _3: i32[2];",
    "    let _4: u64;",
    "    let _5: i32;",
    "    range complete 1 1 0 1 1 5 0;",
    "    range declaration 1 #1:1;",
    "    range expansion 10 declaration 1 context 0 exit 0 #1:1;",
    "    range loan 20 expansion 10 ordinal 0 whole_body;",
    "    range binding 20 non_owning_array_copy captured _3 #1:1;",
    "    range boundary 20 capture bb0 1 order 0 #1:1;",
    "    range boundary 20 body_entry bb1 0 order 0 #2:1;",
    "    range boundary 20 body_cleanup bb1 3 order 0 #3:1;",
    "    range boundary 20 loan_exit bb1 3 order 1 #3:2;",
    "    range boundary 20 outer_cleanup bb1 3 order 2 #3:3;",
    "    bb0: {",
    "        _3 = copy _1;",
    "        check(copy _2, overflow) -> bb1;",
    "    }",
    "    bb1: {",
    "        _5 = const i32 7;",
    "        _4 = const u64 0;",
    "        _0 = copy _3[_4];",
    "        return;",
    "    }",
    "}",
};

