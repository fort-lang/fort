//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: consts.cv_cmp: a float constant compared with another kind
//! stdout:
//| -1
import consts;

// An ordering of two constants of different kinds cannot arise: the checker
// gives both operands one type before it folds (D4.1), so a float against an
// integer here is a broken precondition (D13.3).
fn i32 main() {
    println(consts.cv_cmp(consts.cv_from_float(0), consts.cv_from_float(0x3FF0000000000000)));
    println(consts.cv_cmp(consts.cv_from_float(0), consts.cv_from_i64(1)));
    return 0;
}
