//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| ok
/// Checks diagnostics from src/fort/check.ft that other fort suites do not
/// assert.
import ast;
import check;
import check_env;
import std.strbuf;

//
// Each test below names the rule rather than the wording, and the wording is
// the assertion. The expressions a module-level initializer cannot hold are
// checked by hand through check_env.probe_stmt, since the statements of a
// function body belong to check_stmt.ft.

// The module the probes are written against.
fn open_probe(check_env.env mut* e, string body) bool {
    return open_probe2(e, body, "");
}

fn open_probe2(check_env.env mut* e, string body, string extra) bool {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "struct point {\n    i32 x;\n    i32 y;\n}\n");
    strbuf.append(&b, "enum color {\n    red,\n}\n");
    strbuf.append(&b, "i32[3] mut nums = {1, 2, 3};\n");
    strbuf.append(&b, "point mut p = {1, 2};\n");
    strbuf.append(&b, "string text = \"hello\";\n");
    strbuf.append(&b, "i32 k = 1;\n");
    strbuf.append(&b, "fn s_i32(i32 v) void {\n    return;\n}\n");
    strbuf.append(&b, "fn s_span(i32@ v) void {\n    return;\n}\n");
    strbuf.append(&b, "fn s_void() void {\n    return;\n}\n");
    strbuf.append(&b, body);
    strbuf.append(&b, extra);
    strbuf.append(&b, "fn main() i32 {\n    return 0;\n}\n");
    return check_env.open_module(e, strbuf.view(&b));
}

// The first node of `kind` in the `i`-th statement of `probe`, checked.
fn probe_kind(check_env.env mut* e, u64 i, ast.ast_kind kind) check.expr {
    ast.node mut* n = check_env.node_find(check_env.body_expr(e, "probe", i), kind, "");
    if (n == null) {
        panic("check_diags_test: no such expression");
    }
    return check_env.probe_expr(e, n);
}

// ---- names and qualified names -----------------------------------------------------

fn a_qualified_type_name_needs_a_module_on_its_left() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // `k.thing` in type position: `k` is a constant, not a module.
    assert(!check_env.check_decls(&e, "i32 k = 1;\nk.thing t = 2;\n"));
    assert(check_env.said(&e, "'k' is not a module"));
}

fn a_module_is_not_a_value() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    check_env.add(&e, "other.ft", "i32 ONE = 1;\n");
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "import other;\n");
    strbuf.append(&b, "i32 k = other;\n");
    strbuf.append(&b, "fn main() i32 {\n    return 0;\n}\n");
    check_env.add(&e, "main.ft", strbuf.view(&b));
    assert(!check_env.check_entry(&e, "main.ft"));
    // A name that denotes a module denotes no value.
    assert(check_env.said(&e, "'other' is a module, not a value"));
}

fn a_type_is_not_a_value() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // `point.x` reads a field of the type rather than of a value.
    assert(open_probe(&e, "fn probe() void {\n    s_i32(point.x);\n}\n"));
    check_env.probe_stmt(&e, "probe", 0);
    assert(check_env.said(&e, "'point' is a type, not a value"));
}

fn an_enum_has_only_the_members_it_declares() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!check_env.check_decls(&e, "enum color {\n    red,\n}\ncolor c = color.blue;\n"));
    assert(check_env.said(&e, "enum color has no member 'blue'"));
}

// ---- values that are not values ----------------------------------------------------

fn a_call_that_yields_nothing_is_not_a_value() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(open_probe(&e, "fn probe() void {\n    s_i32(s_void());\n}\n"));
    check_env.probe_stmt(&e, "probe", 0);
    // The diagnostic names the callee when it has one.
    assert(check_env.said(&e, "'s_void' has no value"));
}

// ---- constants out of range --------------------------------------------------------

fn an_exact_result_outside_the_constant_range_is_an_error() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // Untyped integers are evaluated exactly in [-2^63, 2^64 - 1].
    assert(!check_env.check_init_of(&e, "u64", "18446744073709551615 + 1"));
    assert(check_env.said(&e, "constant expression out of range"));
}

fn an_untyped_constant_that_fits_no_default_type_has_none() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // With no context the constant takes its default type, and one that fits
    // neither i32 nor i64 has none. A case label of a switch would be the
    // other site. An array length is this half's.
    assert(!check_env.check_decls(&e, "i32[18446744073709551615 + 1] a = {};\n"));
    assert(check_env.said(&e, "constant expression out of range"));
}

fn an_untyped_shift_count_is_checked_against_the_constant_range() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // The left operand has no width until its context fixes one, so the count
    // is held against 0..63 whether or not the operand folded.
    assert(!check_env.check_init_of(&e, "i64", "1 << 64"));
    assert(check_env.said(&e, "constant shift count must be in 0..63"));
}

fn two_nulls_do_not_compare() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // `null` has no type of its own, so a pair of them has nothing to
    // compare.
    assert(!check_env.check_init_of(&e, "bool", "null == null"));
    assert(check_env.said(&e, "'null' has no type of its own"));
}

// ---- the address and dereference operators -----------------------------------------

fn the_address_of_a_function_is_not_written() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // A function name is already a value of function-pointer type.
    assert(!check_env.check_decls(&e, "fn f() void {\n    return;\n}\nvoid* p = &f;\n"));
    assert(check_env.said(&e, "'&' on a function: a function name is already a value"));
}

fn the_address_operator_needs_an_lvalue() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!check_env.check_decls(&e, "i32* p = &1;\n"));
    assert(check_env.said(&e, "'&' requires an lvalue"));
}

fn only_a_pointer_is_dereferenced() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // `void*` has no pointee type and a function pointer is called, not
    // dereferenced.
    assert(open_probe(&e, "fn probe() void {\n    s_i32(*k);\n}\n"));
    check_env.probe_stmt(&e, "probe", 0);
    assert(check_env.said(&e, "cannot dereference i32"));
}

// ---- fields, indices and spans -----------------------------------------------------

fn an_arrow_needs_a_pointer() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(open_probe(&e, "fn probe() void {\n    s_i32(p->x);\n}\n"));
    check_env.probe_stmt(&e, "probe", 0);
    assert(check_env.said(&e, "'->' needs a pointer, not point: use '.'"));
}

fn a_value_that_is_not_a_struct_has_no_field() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(open_probe(&e, "fn probe() void {\n    s_i32(k.other);\n}\n"));
    check_env.probe_stmt(&e, "probe", 0);
    assert(check_env.said(&e, "i32 has no field 'other'"));
}

// The expected wording matches bootstrap/src/check.c. `check_count` writes
// "a " before the caller's noun, so an index reads "a index".
fn an_index_and_a_span_bound_are_integers() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(open_probe(&e, "fn probe() void {\n    s_i32(nums[text]);\n}\n"));
    check_env.probe_stmt(&e, "probe", 0);
    assert(check_env.said(&e, "a index must be an integer, not string"));
}

fn only_an_array_a_span_or_a_string_has_a_span() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(open_probe(&e, "fn probe() void {\n    s_span(p[0..1]);\n}\n"));
    check_env.probe_stmt(&e, "probe", 0);
    assert(check_env.said(&e, "cannot take a span of point"));
}

fn a_span_of_a_fixed_array_needs_an_lvalue() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // An rvalue array has no address to view.
    assert(open_probe(&e, "fn probe() void {\n    s_span(i32[3]{1, 2, 3}[0..2]);\n}\n"));
    check_env.probe_stmt(&e, "probe", 0);
    assert(check_env.said(&e, "a span of a fixed array needs an lvalue"));
}

// ---- move, literals and brace initializers -----------------------------------------

fn move_takes_an_lvalue() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(open_probe(&e, "fn probe() void {\n    s_i32(move(1));\n}\n"));
    check_env.probe_stmt(&e, "probe", 0);
    assert(check_env.said(&e, "'move' takes an lvalue"));
}

fn a_struct_literal_names_a_struct_type() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!check_env.check_decls(&e, "enum color {\n    red,\n}\ncolor c = color{1};\n"));
    assert(check_env.said(&e, "color is not a struct type"));
}

fn a_brace_initializer_is_not_an_expression() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // Bare braces initialize a declaration. The parser accepts them nowhere
    // else. So the node is handed to check_expr directly, which is what a
    // pass over a tree an editor is re-checking would do.
    assert(check_env.check_decls(&e, "i32[2] nums = {1, 2};\n"));
    ast.node mut* d = check_env.node_in_main(&e, ast.ast_kind.k_var_decl, "nums");
    check_env.probe_expr(&e, d->b);
    assert(check_env.said(&e, "a brace initializer is not an expression"));
}

// ---- sizes and enum values ---------------------------------------------------------

fn a_struct_whose_fields_together_pass_the_ceiling_is_refused() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    // Each field fits under 2^63 - 1 bytes and the two together do not, so
    // what is reported is the struct and not a field.
    strbuf.append(&b, "struct huge {\n");
    strbuf.append(&b, "    i64[1000000000000000000] a;\n");
    strbuf.append(&b, "    i64[1000000000000000000] b;\n");
    strbuf.append(&b, "}\n");
    assert(!check_env.check_decls(&e, strbuf.view(&b)));
    assert(check_env.said(&e, "type is too large: struct huge"));
}

fn an_enum_value_is_a_constant_expression() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // A read of a `mut` global is not one.
    assert(!check_env.check_decls(&e, "i32 mut g = 1;\nenum color {\n    red = g,\n}\n"));
    assert(check_env.said(&e, "an enum value must be a constant expression"));
}

fn main() i32 {
    a_qualified_type_name_needs_a_module_on_its_left();
    a_module_is_not_a_value();
    a_type_is_not_a_value();
    an_enum_has_only_the_members_it_declares();
    a_call_that_yields_nothing_is_not_a_value();
    an_exact_result_outside_the_constant_range_is_an_error();
    an_untyped_constant_that_fits_no_default_type_has_none();
    an_untyped_shift_count_is_checked_against_the_constant_range();
    two_nulls_do_not_compare();
    the_address_of_a_function_is_not_written();
    the_address_operator_needs_an_lvalue();
    only_a_pointer_is_dereferenced();
    an_arrow_needs_a_pointer();
    a_value_that_is_not_a_struct_has_no_field();
    an_index_and_a_span_bound_are_integers();
    only_an_array_a_span_or_a_string_has_a_span();
    a_span_of_a_fixed_array_needs_an_lvalue();
    move_takes_an_lvalue();
    a_struct_literal_names_a_struct_type();
    a_brace_initializer_is_not_an_expression();
    a_struct_whose_fields_together_pass_the_ceiling_is_refused();
    an_enum_value_is_a_constant_expression();
    println("ok");
    return 0;
}
