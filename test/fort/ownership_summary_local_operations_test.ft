    "fn null_copy() i32* { i32* p = null; i32* q = p; return q; }",
    "fn exact_bytes() u8 mut@ own { return new(u8, 4); }",
    "fn exact_words() u64 mut@ own { return new(u64, 3); }",
    "fn zero_words() u64 mut@ own { return new(u64, 0); }",
