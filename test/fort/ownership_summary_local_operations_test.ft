    "fn erased_copy(i32 mut* p) void mut* { void mut* q = cast(p, void mut*); return q; }",
    "fn address_copy(i32* p) u64 { u64 q = cast(p, u64); return q; }",
    "fn exact_empty() string { string q = \"\"; return q; }",
    "fn const_erased(i32* p) void* { return cast(p, void*); }",
    "fn round_trip(i32* p) i32* { void* q = cast(p, void*); return cast(q, i32*); }",
};

string[6] ALLOCATION_DETAIL_SOURCE = {
    "fn five_u16() u16 mut@ own { return new(u16, 5); }",
    "fn seven_u32() u32 mut@ own { return new(u32, 7); }",
    "fn one_u64() u64 mut@ own { return new(u64, 1); }",
