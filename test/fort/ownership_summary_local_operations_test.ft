string[7] HEADER_SOURCE = {
    "struct buffer { u8 mut@ own data; u64 len; }",
    "struct text_box { string text; }",
    "struct view_box { u8@ data; }",
    "fn capacity(buffer* b) u64 { return b->data.len; }",
