//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| summary local operations ok
/// Checks local parameter, assignment, cast, and allocation summary rules (D17.14-D17.15).
import fir;
import ownership_api;
import ownership_call_bodies;
import ownership_calls_env;
import ownership_flow;
import ownership_state;
import ownership_summary_body;
import ownership_summary_model;
import ownership_transfer;
import types;

string[9] CALLBACK_SOURCE = {
    "struct hooks { fn (void mut*) void callback; void mut* context; }",
    "fn visit(void mut* context) void {}",
    "fn install(hooks mut* h, fn (void mut*) void callback, void mut* context) void {",
    "    h->callback = callback; h->context = context; }",
    "fn configure(hooks mut* h, i32 mut* p) void { install(h, visit, cast(p, void mut*)); }",
    "fn relay(fn (void mut*) void callback) fn (void mut*) void { return callback; }",
    "fn erase_callback(fn (void mut*) void callback) void* { return cast(callback, void*); }",
    "fn accept_two(fn (void mut*) void first, fn (void mut*) void second) void {}",
    "fn pass_two() void { accept_two(visit, visit); }",
};

string[5] FUNCTION_READ_SOURCE = {
    "struct owner_hooks { fn (void mut*) void callback; }",
    "fn load(owner_hooks* h) void {",
    "    fn (void mut*) void callback = h->callback; }",
    "fn stale(owner_hooks mut* own h) void {",
    "    del(h); fn (void mut*) void callback = h->callback; }",
};

string[5] FUNCTION_CAST_SOURCE = {
    "fn live(void* raw) void { fn () void callback = cast(raw, fn () void); }",
    "fn stale(i32 mut* own p) void {",
    "    void* raw = cast(p, void*); del(p);",
    "    fn () void callback = cast(raw, fn () void); }",
    "fn empty() void { void* raw = null; fn () void callback = cast(raw, fn () void); }",
};

string[3] ADDRESSED_FUNCTION_SOURCE = {
    "fn target(i32 value) i32 { return value; }",
    "fn local_address() void { fn (i32) i32 local = target;",
    "    (fn (i32) i32)* address = &local; }",
};

// No slice rule is part of this change. Each slice stays unsupported at the slice, as before it.
string[23] SLICE_SOURCE = {
    "struct index_store { u64[4] local; u64 mut@ own heap; }",
    "struct heap_store { u64 mut@ own heap; }",
    "struct holder { u64 mut@ view; u64 n; }",
    "fn fixed_view(index_store mut* store, u64 count) u64 mut@ { return store->local[0..count]; }",
    "fn span_view(index_store mut* store) u64 mut@ { return store->heap[..]; }",
    "fn bad_view(index_store mut* store, u64 count) u64 mut@ { return store->local[1..count]; }",
    "fn exact_view(index_store mut* store) u64 mut@ { return store->local[0..2]; }",
    "fn empty_view(index_store mut* store) u64 mut@ { return store->local[0..0]; }",
    "fn full_view(index_store mut* store) u64 mut@ { return store->local[..]; }",
    "fn dynamic_lower(index_store mut* store, u64 first) u64 mut@ {",
    "    return store->local[first..]; }",
    "fn span_lower(index_store mut* store) u64 mut@ { return store->heap[1..]; }",
    "fn span_prefix(index_store mut* store, u64 count) u64 mut@ { return store->heap[0..count]; }",
    "fn full_after_move(heap_store mut* s) u64 {",
    "    u64 mut@ own h = move(s->heap);",
    "    u64 mut@ v = s->heap[..];",
    "    del(h); return v[0]; }",
    "fn stored_then_load(index_store mut* store, holder mut* h) u64 {",
    "    u64 mut@ e = store->local[0..0];",
    "    h->view = e; u64 mut@ v = h->view; return v[0]; }",
    "fn stored_then_full(index_store mut* store, holder mut* h) u64 {",
    "    u64 mut@ e = store->local[0..0];",
    "    h->view = e; u64 mut@ v = h->view[..]; return v[0]; }",
};

// Each projected load or move after the release reads the released containing reference.
string[7] STALE_BASE_SOURCE = {
    "struct view_store { u64[4] local; u64@ data; string text; }",
    "struct heap_store { u64 mut@ own heap; }",
    "fn stale_load(view_store mut* own store) u64@ { del(store); return store->data; }",
    "fn stale_move(heap_store mut* own store) u64 mut@ own {",
    "    del(move(store->heap)); del(store); return move(store->heap); }",
    "fn live_load(view_store mut* store) u64@ { return store->data; }",
    "fn live_move(heap_store mut* store) u64 mut@ own { return move(store->heap); }",
};

// Each literal shape stops at the literal. A wrapper of a literal body stays incomplete too.
string[5] LITERAL_SOURCE = {
    "fn literal() string { return \"abc\"; }",
    "fn wrapper() string { return literal(); }",
    "fn local_text() string { string value = \"wxyz\"; return value; }",
    "fn empty_text() string { return \"\"; }",
    "fn two_texts() string { string a = \"ab\"; string b = \"abcdef\"; return b; }",
};

// Projected `void*` loads keep the verdicts of the base revision. A typed cast of a `void*` field
// selects a pointee with no extent, so its load stops with `missing_path`, not `invalid_input`.
string[11] VOID_LOAD_SOURCE = {
    "struct h { void* p; i32 n; }",
    "struct hm { void mut* p; i32 n; }",
    "struct ho { void* own p; i32 n; }",
    "struct outer { h* inner; i32 n; }",
    "struct sym { u64 id; }",
    "fn load_field(h* x) void* { void* q = x->p; return q; }",
    "fn load_mut_field(hm* x) void mut* { void mut* q = x->p; return q; }",
    "fn move_owner(ho mut* x) void* own { void* own q = move(x->p); return q; }",
    "fn load_nested(outer* o) void* { void* q = o->inner->p; return q; }",
    "fn compare_field(h* x) bool { return x->p == null; }",
    "fn typed_field(h* x) sym* { return cast(x->p, sym*); }",
};

// A `void*` result with scalar contents stays scalar. A `void*` result that holds a relation keeps
// the returned-borrow check, so a dangling erased view does not prove.
string[6] VOID_RESULT_SOURCE = {
    "struct h { void* p; i32 n; }",
    "fn load_deref(void** pp) void* { void* q = *pp; return q; }",
    "fn load_by_value(h x) void* { void* q = x.p; return q; }",
    "fn dangling_erased(i32 mut* own p) void* {",
    "    void* q = cast(p, void*); del(p); return q; }",
    "fn local_erased() void* { i32 x = 1; return cast(&x, void*); }",
};

// A moved owner has no element. A projected load through it fails at the load.
string[4] MOVED_BASE_SOURCE = {
    "struct view_store { u64[4] local; u64@ data; string text; }",
    "fn moved_load(view_store mut* own store) u64 {",
    "    view_store mut* own other = move(store); u64@ d = store->data; del(other);",
    "    return d.len; }",
};

