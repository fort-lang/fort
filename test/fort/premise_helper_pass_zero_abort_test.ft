//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: pass_env.breaks_premises: a text that keeps each rule goes through verified_each
//! stdout:
//| ready
/// pass_env.breaks_premises stops the test for the count 0, with no look at the text: the count 0
/// is that of the strict helper pass_env.verified_each.
import fort.fir;
import lower_env;
import pass_env;
import premise_env;

// A panic ends the program, so the case stands in a file of its own.
fn main() i32 {
    lower_env.env mut* own e = lower_env.make();
    defer lower_env.drop_made(move(e));
    fir.module mut* own m = pass_env.parse_made(e, premise_env.PRELUDE[..], premise_env.MIXED[..]);
    defer fir.module_drop_made(move(m));
    println("ready");
    pass_env.breaks_premises(e, m, 0, "the verifier refuses MIXED");
    return 0;
}
