        ":9,\"severity\":\"error\",\"message\":\"lost ownership of 'buffer'\",\"n",
        "otes\":[]}]"
    };
    string[1] text_parts_5 = {
        "case.ft:12:5: error: lost ownership of 'buffer'\n"
    };
    check_one(item, "lost ownership of 'buffer'", json_parts_5[..], text_parts_5[..]);
}

fn caller_requirement() void {
    ownership_api.event_descriptor item = event(ownership_api.event_kind.caller_requirement,
        ownership_api.evidence_kind.unconditional, 15, "arg");
    string[3] json_parts_6 = {
        "[{\"file\":\"case.ft\",\"line\":15,\"col\":5,\"end_line\":15,\"end_col\"",
        ":9,\"severity\":\"error\",\"message\":\"caller requirement fails for 'ar",
        "g'\",\"notes\":[]}]"
    };
    string[1] text_parts_6 = {
