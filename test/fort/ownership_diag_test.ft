//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| 18 ownership diagnostic groups ok
/// Checks text and JSON diagnostics from supplied ownership events.
import capture;
import diag;
import json;
import ownership_api;
import ownership_diag;
import ownership_events;
import std.io;
import std.str;
import std.strbuf;

fn file(void mut* context, ownership_api.source_position at) string {
    if (at.file == 2) { return "lib.ft"; }
    return "case.ft";
}

fn position(u32 file_id, u32 line, u32 col, u32 end_col)
    ownership_api.source_position {
    return ownership_api.source_position{1, file_id, line, col, line, end_col, true};
}

fn event(ownership_api.event_kind kind, ownership_api.evidence_kind evidence,
    u32 line, string label) ownership_api.event_descriptor {
    ownership_api.event_descriptor mut out = ownership_api.event_descriptor{};
    out.key.kind = ownership_api.entity_kind.event;
    out.key.ordinal = line;
    out.operation.function.declaration.module = 1;
    out.operation.function.declaration.declaration = 1;
    out.operation.operation = line;
    out.source = position(1, line, 5, 9);
    out.kind = kind;
    out.evidence = evidence;
    out.text = label;
    out.relation.kind = ownership_api.entity_kind.relation;
    out.relation.ordinal = line;
    return out;
}

fn output(diag.sink* s, strbuf.str_buf mut* out) string {
    strbuf.clear(out);
    json.writer mut j = json.writer{};
    json.json_init(&j, out);
    diag.write_json(s, &j);
    return strbuf.view(out);
}

fn equal_parts(string actual, string@ parts) bool {
    strbuf.str_buf mut out = strbuf.create();
    defer strbuf.free(&out);
    u64 mut i = 0;
    while (i < parts.len) {
        strbuf.append(&out, parts[i]);
        i += 1;
    }
    return actual == strbuf.view(&out);
}

fn setup(ownership_diag.renderer mut* rend, diag.sink mut* s,
    ownership_events.store mut* evs, ownership_api.services mut* svc, u64 v) void {
    ownership_api.limit_table bounds = ownership_api.limit_table{
        ownership_api.LIMIT_VERSION, 8, 8, 8, 8, 8, 8, 8, 8, v};
    assert(ownership_events.bind(evs, &bounds, svc));
    ownership_diag.bind(rend, s, evs, null, file, svc);
}

fn check_one(ownership_api.event_descriptor item, string text, string@ expected_json,
    string@ expected_text) void {
    diag.sink mut s = diag.create();
    defer diag.free(&s);
    diag.set_text(&s, true);
    ownership_diag.renderer mut rend = ownership_diag.renderer{};
    ownership_api.services mut svc = ownership_api.services{};
    ownership_events.store mut evs = ownership_events.store{};
    defer ownership_events.free(&evs);
    setup(&rend, &s, &evs, &svc, 32);
    ownership_api.event_descriptor[1] items = {item};
    ownership_api.proof_status mut verdict = ownership_api.proof_status{};
    verdict.kind = ownership_api.proof_kind.incomplete;
    verdict.failed = true;
    ownership_api.diagnostic_request req = ownership_api.diagnostic_request{items[..], verdict};
    i32 saved = capture.begin(io.STDERR, "ownership.txt");
    ownership_api.diagnostic_result mut result = ownership_api.render(&svc, &req);
    capture.end(io.STDERR, saved);
    string own got = capture.text("ownership.txt");
    defer del(got);
    assert(result.rendered);
    assert(result.proof.failed);
    assert(diag.count(&s) == 1);
    assert(evs.rendered == diag.record_count(&s));
    assert(evs.budget.used.v == evs.rendered);
    assert(diag.record_at(&s, 0).msg == text);
    assert(equal_parts(got, expected_text));
    strbuf.str_buf mut out = strbuf.create();
    defer strbuf.free(&out);
    assert(equal_parts(output(&s, &out), expected_json));
}

fn proved_use() void {
    ownership_api.event_descriptor item = event(ownership_api.event_kind.invalid_use,
        ownership_api.evidence_kind.unconditional, 8, "view");
    string[3] json_parts_1 = {
        "[{\"file\":\"case.ft\",\"line\":8,\"col\":5,\"end_line\":8,\"end_col\":9",
        ",\"severity\":\"error\",\"message\":\"invalid use of 'view'\",\"notes\":",
        "[]}]"
    };
    string[1] text_parts_1 = {
        "case.ft:8:5: error: invalid use of 'view'\n"
    };
    check_one(item, "invalid use of 'view'", json_parts_1[..], text_parts_1[..]);
}

fn path_use() void {
    ownership_api.event_descriptor mut item = event(ownership_api.event_kind.invalid_use,
        ownership_api.evidence_kind.validated_path, 8, "view");
    ownership_api.witness_link[1] mut witnesses = {};
    witnesses[0].validated = true;
    item.witnesses = witnesses[..];
    ownership_api.event_note[1] notes = {ownership_api.event_note{
        ownership_api.note_role.release, position(1, 4, 3, 6),
        ownership_api.entity_id{}, "storage released here"}};
    item.notes = notes[..];
    string[4] json_parts_2 = {
        "[{\"file\":\"case.ft\",\"line\":8,\"col\":5,\"end_line\":8,\"end_col\":9",
        ",\"severity\":\"error\",\"message\":\"invalid use of 'view' on this path",
        "\",\"notes\":[{\"file\":\"case.ft\",\"line\":4,\"col\":3,\"end_line\":4,",
        "\"end_col\":6,\"message\":\"storage released here\"}]}]"
    };
    string[2] text_parts_2 = {
        "case.ft:8:5: error: invalid use of 'view' on this path\ncase.ft:4:3: not",
        "e: storage released here\n"
    };
    check_one(item, "invalid use of 'view' on this path", json_parts_2[..], text_parts_2[..]);
}

fn incomplete() void {
    ownership_api.event_descriptor mut item = event(ownership_api.event_kind.invalid_use,
        ownership_api.evidence_kind.abstract_possibility, 8,
        "that 'view' designates live storage");
    item.precision.category = ownership_api.limit_category.d;
    item.precision.bound = 2;
    item.precision.first_source = position(1, 4, 13, 17);
    string[5] json_parts_3 = {
        "[{\"file\":\"case.ft\",\"line\":8,\"col\":5,\"end_line\":8,\"end_col\":9",
        ",\"severity\":\"error\",\"message\":\"cannot prove that 'view' designate",
        "s live storage\",\"notes\":[{\"file\":\"case.ft\",\"line\":4,\"col\":13,",
        "\"end_line\":4,\"end_col\":17,\"message\":\"access-path depth 2 loses th",
        "e required source relation here\"}]}]"
    };
    string[3] text_parts_3 = {
        "case.ft:8:5: error: cannot prove that 'view' designates live storage\nca",
        "se.ft:4:13: note: access-path depth 2 loses the required source relation",
        " here\n"
    };
    check_one(item, "cannot prove that 'view' designates live storage",
        json_parts_3[..], text_parts_3[..]);
    item.precision = ownership_api.lost_fact{};
    item.evidence = ownership_api.evidence_kind.validated_path;
    string[3] json_parts_4 = {
        "[{\"file\":\"case.ft\",\"line\":8,\"col\":5,\"end_line\":8,\"end_col\":9",
        ",\"severity\":\"error\",\"message\":\"cannot prove that 'view' designate",
        "s live storage\",\"notes\":[]}]"
    };
    string[1] text_parts_4 = {
        "case.ft:8:5: error: cannot prove that 'view' designates live storage\n"
    };
    check_one(item, "cannot prove that 'view' designates live storage",
        json_parts_4[..], text_parts_4[..]);
}

fn lost_owner() void {
    ownership_api.event_descriptor item = event(ownership_api.event_kind.lost_ownership,
        ownership_api.evidence_kind.unconditional, 12, "buffer");
