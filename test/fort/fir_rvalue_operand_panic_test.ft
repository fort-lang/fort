//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: fir.rvalue_operand: index out of range
//! stdout:
//| ready
/// Checks the bound of fir.rvalue_operand: the use of an operand has one operand.
import fir;
import prim;
import types;

fn main() i32 {
    types.table mut tt = types.table{};
    defer types.type_table_free(&tt);
    types.node* i32t = types.type_prim(&tt, prim.prim_kind.prim_i32);
    types.node*[2] params = {i32t, i32t};
    types.node* fnty = types.type_fn(&tt, i32t, params[..], false);
    fir.func mut f = fir.func_new(&tt, null, fnty);
    defer fir.func_free(&f);
    fir.rvalue r = fir.rvalue_use(&f, fir.operand_copy(fir.place_local(1)));
    assert(fir.rvalue_operand(&f, r, 0).place.local == 1);
    println("ready");
    fir.rvalue_operand(&f, r, 1);
    return 0;
}
