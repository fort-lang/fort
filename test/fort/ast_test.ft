//! run
//! flags: -I ../../src/fort
//! stdout:
//| ok
import ast;
import diag;
import lexer;
import prim;
import types;
import std.strbuf;

// The syntax tree and its S-expression printer (src/fort/ast.ft): the arena,
// the children of a node, the kind names and the printed form of a
// hand-built tree. The parser suites cover the trees the parser builds; this
// one covers the shapes only a hand-built tree reaches and the ownership the
// arena promises.

// The arena and the buffer every assertion below works in. They are locals of
// main's callees rather than module state, since a module of the compiler may
// not keep any (D20.5) and a test has no reason to differ.
struct env {
    ast.arena arena;
    strbuf.str_buf buf;
}

fn env open() {
    return env{ast.arena{}, strbuf.create()};
}

fn void close(env mut* e) {
    ast.ast_arena_free(&e->arena);
    strbuf.free(&e->buf);
}

fn diag.loc at(u32 line, u32 col) {
    return diag.loc_make("t.ft", line, col);
}

fn ast.node mut* node(env mut* e, ast.ast_kind kind) {
    return ast.ast_new(&e->arena, kind, at(1, 1));
}

// The S-expression of `n`, valid until the next call.
fn string dump(env mut* e, ast.node* n) {
    strbuf.clear(&e->buf);
    ast.ast_dump(n, &e->buf);
    return strbuf.view(&e->buf);
}

fn ast.node mut* int_lit(env mut* e, u64 v) {
    ast.node mut* n = node(e, ast.ast_kind.k_int);
    n->ival = v;
    return n;
}

fn ast.node mut* ident(env mut* e, string name) {
    ast.node mut* n = node(e, ast.ast_kind.k_ident);
    n->name = name;
    return n;
}

// A primitive base type under a type node, with the marks of the position.
fn ast.node mut* prim_type(env mut* e, prim.prim_kind k, u32 flags) {
    ast.node mut* base = node(e, ast.ast_kind.k_type_prim);
    base->op = cast(k, i32);
    ast.node mut* t = node(e, ast.ast_kind.k_type);
    t->a = base;
    t->flags = flags;
    return t;
}

// One suffix with its marks and, for an array, its length.
fn ast.node mut* suffix(env mut* e, types.suffix_kind k, u32 flags, ast.node mut* len) {
    ast.node mut* s = node(e, ast.ast_kind.k_type_suffix);
    s->op = cast(k, i32);
    s->flags = flags;
    s->a = len;
    return s;
}

// ---- the arena -----------------------------------------------------------------

fn void arena_starts_empty() {
    env mut e = open();
    defer close(&e);
    assert(ast.ast_arena_count(&e.arena) == 0);
}

fn void arena_hands_out_zeroed_nodes() {
    env mut e = open();
    defer close(&e);
    ast.node mut* n = ast.ast_new(&e.arena, ast.ast_kind.k_int, at(3, 7));
    assert(ast.ast_arena_count(&e.arena) == 1);
    assert(n->kind == ast.ast_kind.k_int);
    assert(n->loc.line == 3);
    assert(n->loc.col == 7);
    // Every other field is the zero of a fresh node.
    assert(n->op == 0);
    assert(n->a == null && n->b == null && n->c == null && n->d == null);
    assert(ast.ast_len(n) == 0);
    assert(n->name.len == 0);
    assert(n->ival == 0);
    assert(n->flags == 0);
    assert(n->name_loc.line == 0);
}

fn void arena_nodes_are_stable_while_it_grows() {
    env mut e = open();
    defer close(&e);
    // The arena owns a pointer per node, so a node never moves however many
    // are handed out after it: the first one still reads back its own value
    // after the vector has grown several times.
    ast.node mut* first = int_lit(&e, 11);
    u64 mut i = 0;
    while (i < 500) {
        ast.node mut* n = int_lit(&e, i);
        assert(n->ival == i);
        i += 1;
    }
    assert(ast.ast_arena_count(&e.arena) == 501);
    assert(first->ival == 11);
    assert(first->kind == ast.ast_kind.k_int);
}

fn void arena_free_empties_and_is_reusable() {
    env mut e = open();
    defer close(&e);
    u64 mut i = 0;
    while (i < 40) {
        ast.ast_push(node(&e, ast.ast_kind.k_block), int_lit(&e, i));
        i += 1;
    }
    assert(ast.ast_arena_count(&e.arena) == 80);
    ast.ast_arena_free(&e.arena);
    assert(ast.ast_arena_count(&e.arena) == 0);
    // The arena is usable afterwards, which is what makes a second analysis
    // in one process independent of the first (D20.5).
    ast.node mut* n = int_lit(&e, 5);
    assert(ast.ast_arena_count(&e.arena) == 1);
    assert(n->ival == 5);
}

fn void arena_init_zeroes_a_fresh_arena() {
    env mut e = open();
    defer close(&e);
    ast.ast_arena_init(&e.arena);
    assert(ast.ast_arena_count(&e.arena) == 0);
    assert(int_lit(&e, 1)->ival == 1);
}

// The arena owns every node, every node's list and the vector of nodes
// itself, and nothing else in this directory can see a release that is
// missing: the gate's sanitizers instrument the C compiler and not the
// x86-64 program the harness runs, so a leak here is invisible to every
// other test and to ctest.
//
// What can see one is the allocator, in two views, because each is blind to
// what the other sees (modules_closure_test.ft says which and why). Two
// hundred identical rounds build the same tree and free it: the program break
// sees a leak the allocator had to ask the kernel for, and the address a
// round is handed sees one it served out of its own free chunks. The early
// round is held against the last two and the smaller distance taken, since
// the allocator alternates between two positions from one round to the next
// once the program's path is long enough to change a bin.
//
// ast_arena_free makes three releases. `list_free(&n->list)` and
// `del(ar->nodes)` are each watched here by an address and by the break, and
// each was verified by deleting that one release and watching this test fail.
// The third, `del(n)` on the node itself, is held by the language rather than
// by a probe: an owning local dropped without it makes the checked build
// abort at the next write into that slot with `overwriting owned value`
// (D17.11), which is what deleting it produces here.
u64 LEAK_ROUNDS = 200;
u64 LEAK_EARLY = 100;
u64 LEAK_CHILDREN = 1024;
u64 LEAK_BOUND = 8192;

// The current program break, which is where the heap ends: sbrk(0) moves
// nothing and reports it. There is no std binding for it and this is its one
// caller (D9.8).
extern fn void* sbrk(i64 increment);

fn u64 heap_end() {
    return cast(sbrk(0), u64);
}

// How far apart two positions are, whichever way the heap moved: a
// subtraction the wrong way round would trap before the assertion (D11.1).
fn u64 distance(u64 a, u64 b) {
    if (a > b) {
        return a - b;
    }
    return b - a;
}

// The smaller of the distances from the early round to the last two.
fn u64 moved(u64 early, u64 late, u64 last) {
    assert(early != 0 && late != 0 && last != 0);
    u64 one = distance(late, early);
    u64 other = distance(last, early);
    if (one < other) {
        return one;
    }
    return other;
}

fn void the_nodes_and_their_lists_are_released_with_the_arena() {
    u64[3] mut break_at = {};
    u64[3] mut list_at = {};
    u64[3] mut nodes_at = {};
    u64 mut round = 0;
    while (round < LEAK_ROUNDS) {
        env mut e = open();
        ast.node mut* parent = node(&e, ast.ast_kind.k_block);
        u64 mut i = 0;
        while (i < LEAK_CHILDREN) {
            ast.ast_push(parent, int_lit(&e, i));
            i += 1;
        }
        u64 mut slot = 3;
        if (round == LEAK_EARLY) {
            slot = 0;
        }
        if (round == LEAK_ROUNDS - 2) {
            slot = 1;
        }
        if (round == LEAK_ROUNDS - 1) {
            slot = 2;
        }
        // The addresses are read while the arena still holds them, the break
        // after it is freed, which is where a round's keeping shows.
        if (slot < 3) {
            list_at[slot] = cast(parent->list.items.ptr, u64);
            nodes_at[slot] = cast(e.arena.nodes.ptr, u64);
        }
        close(&e);
        if (slot < 3) {
            break_at[slot] = heap_end();
        }
        round += 1;
    }
    assert(moved(break_at[0], break_at[1], break_at[2]) < LEAK_BOUND);
    // A node owns its list and `del` is shallow (D17.7), so the list goes
    // before the node does; if it did not, this is where it would show.
    assert(moved(list_at[0], list_at[1], list_at[2]) < LEAK_BOUND);
    // The vector of owned node pointers is the arena's own block and is
    // released last.
    assert(moved(nodes_at[0], nodes_at[1], nodes_at[2]) < LEAK_BOUND);
}

// ---- children ------------------------------------------------------------------

fn void children_are_pushed_and_read_back() {
    env mut e = open();
    defer close(&e);
    ast.node mut* parent = node(&e, ast.ast_kind.k_block);
    assert(ast.ast_len(parent) == 0);
    ast.node mut* first = int_lit(&e, 1);
    ast.node mut* second = int_lit(&e, 2);
    ast.ast_push(parent, first);
    ast.ast_push(parent, second);
    assert(ast.ast_len(parent) == 2);
    assert(ast.ast_child(parent, 0)->ival == 1);
    assert(ast.ast_child(parent, 1)->ival == 2);
    // The list grows past its first capacity and keeps every child in order.
    u64 mut i = 2;
    while (i < 100) {
        ast.ast_push(parent, int_lit(&e, i));
        i += 1;
    }
    assert(ast.ast_len(parent) == 100);
    // The first two were pushed with their own values; every later child
    // carries its index.
    assert(ast.ast_child(parent, 0)->ival == 1);
    assert(ast.ast_child(parent, 1)->ival == 2);
    i = 2;
    while (i < 100) {
        assert(ast.ast_child(parent, i)->ival == i);
        i += 1;
    }
}

fn void marks_are_read_from_the_flags() {
    env mut e = open();
    defer close(&e);
    ast.node mut* plain = node(&e, ast.ast_kind.k_type);
    assert(!ast.ast_is_own(plain) && !ast.ast_is_mut(plain));
    ast.node mut* owned = node(&e, ast.ast_kind.k_type);
    owned->flags = ast.FLAG_OWN;
    assert(ast.ast_is_own(owned) && !ast.ast_is_mut(owned));
    ast.node mut* both = node(&e, ast.ast_kind.k_type);
    both->flags = ast.FLAG_OWN | ast.FLAG_MUT;
    assert(ast.ast_is_own(both) && ast.ast_is_mut(both));
    // The other bits are not marks of a type position.
    ast.node mut* external = node(&e, ast.ast_kind.k_fn_decl);
    external->flags = ast.FLAG_EXTERN;
    assert(!ast.ast_is_own(external) && !ast.ast_is_mut(external));
}

fn void every_kind_has_a_name() {
    // ast_kind_name answers for every member of the enum, and no two members
    // of one family share a name; the dump and the diagnostics spell a kind
    // with it.
    assert(ast.ast_kind_name(ast.ast_kind.k_none) == "none");
    assert(ast.ast_kind_name(ast.ast_kind.k_module) == "module");
    assert(ast.ast_kind_name(ast.ast_kind.k_field_decl) == "field-decl");
    assert(ast.ast_kind_name(ast.ast_kind.k_type_suffix) == "suffix");
    assert(ast.ast_kind_name(ast.ast_kind.k_call_stmt) == "call-stmt");
    assert(ast.ast_kind_name(ast.ast_kind.k_range_for) == "range-for");
    assert(ast.ast_kind_name(ast.ast_kind.k_string) == "str");
    assert(ast.ast_kind_name(ast.ast_kind.k_struct_lit) == "struct-lit");
    assert(ast.ast_kind_name(ast.ast_kind.k_array_lit) == "array-lit");
    assert(ast.ast_kind_name(ast.ast_kind.k_error) == "error");
    // Every kind from the first to the last has a name of its own; `?` is the
    // answer for no member at all.
    i32 mut k = cast(ast.ast_kind.k_none, i32);
    i32 last = cast(ast.ast_kind.k_error, i32);
    while (k <= last) {
        assert(ast.ast_kind_name(cast(k, ast.ast_kind)) != "?");
        k += 1;
    }
}

// ---- the dump ------------------------------------------------------------------

fn void dump_of_null_is_nil() {
    env mut e = open();
    defer close(&e);
    assert(dump(&e, null) == "nil");
}

fn void dump_of_an_error_node_has_no_children() {
    env mut e = open();
    defer close(&e);
    ast.node mut* err = node(&e, ast.ast_kind.k_error);
    // A skipped region never has children (D14.2), and the dump prints none
    // even if a pass put one there.
    ast.ast_push(err, int_lit(&e, 1));
    assert(dump(&e, err) == "(error)");
}

fn void dump_of_literals() {
    env mut e = open();
    defer close(&e);
    assert(dump(&e, int_lit(&e, 42)) == "(int 42)");
    ast.node mut* ch = node(&e, ast.ast_kind.k_char);
    ch->ival = 97;
    assert(dump(&e, ch) == "(char 97)");
    ast.node mut* yes = node(&e, ast.ast_kind.k_bool);
    yes->ival = 1;
    assert(dump(&e, yes) == "(bool true)");
    ast.node mut* no = node(&e, ast.ast_kind.k_bool);
    assert(dump(&e, no) == "(bool false)");
    assert(dump(&e, node(&e, ast.ast_kind.k_null)) == "(null)");
    assert(dump(&e, ident(&e, "x")) == "(ident x)");
    ast.node mut* f = node(&e, ast.ast_kind.k_float);
    f->name = "1.5";
    assert(dump(&e, f) == "(float \"1.5\")");
}

fn void dump_escapes_string_bytes() {
    env mut e = open();
    defer close(&e);
    ast.node mut* s = node(&e, ast.ast_kind.k_string);
    s->name = "a\nb";
    assert(dump(&e, s) == "(str \"a\\x0Ab\")");
    s->name = "q\"q";
    assert(dump(&e, s) == "(str \"q\\\"q\")");
    s->name = "back\\slash";
    assert(dump(&e, s) == "(str \"back\\\\slash\")");
    s->name = "";
    assert(dump(&e, s) == "(str \"\")");
}

fn void dump_of_operators_uses_the_token_spelling() {
    env mut e = open();
    defer close(&e);
    ast.node mut* sum = node(&e, ast.ast_kind.k_binary);
    sum->op = cast(lexer.tok_kind.plus, i32);
    sum->a = int_lit(&e, 1);
    sum->b = int_lit(&e, 2);
    assert(dump(&e, sum) == "(binary + (int 1) (int 2))");
    ast.node mut* neg = node(&e, ast.ast_kind.k_unary);
    neg->op = cast(lexer.tok_kind.minus, i32);
    neg->a = ident(&e, "x");
    assert(dump(&e, neg) == "(unary - (ident x))");
    ast.node mut* set = node(&e, ast.ast_kind.k_assign);
    set->op = cast(lexer.tok_kind.shl_assign, i32);
    set->a = ident(&e, "x");
    set->b = int_lit(&e, 1);
    assert(dump(&e, set) == "(assign <<= (ident x) (int 1))");
    ast.node mut* step = node(&e, ast.ast_kind.k_incdec);
    step->op = cast(lexer.tok_kind.plus_plus, i32);
    step->a = ident(&e, "x");
    assert(dump(&e, step) == "(incdec ++ (ident x))");
}

fn void dump_of_a_type_with_marks_and_suffixes() {
    env mut e = open();
    defer close(&e);
    ast.node mut* t = prim_type(&e, prim.prim_kind.prim_u8, ast.FLAG_MUT);
    ast.ast_push(t, suffix(&e, types.suffix_kind.s_span, ast.FLAG_OWN, null));
    ast.ast_push(t, suffix(&e, types.suffix_kind.s_ptr, 0, null));
    assert(dump(&e, t) == "(type (prim u8) mut (span own) (ptr))");
    ast.node mut* arr = prim_type(&e, prim.prim_kind.prim_i32, 0);
    ast.ast_push(arr, suffix(&e, types.suffix_kind.s_array, ast.FLAG_MUT, int_lit(&e, 4)));
    assert(dump(&e, arr) == "(type (prim i32) (array (int 4) mut))");
}

fn void dump_of_named_string_void_and_function_types() {
    env mut e = open();
    defer close(&e);
    ast.node mut* named = node(&e, ast.ast_kind.k_type_name);
    named->name = "node";
    assert(dump(&e, named) == "(name node)");
    // A qualified name prints both identifiers (D9.4).
    named->a = ident(&e, "writer");
    assert(dump(&e, named) == "(name node writer)");
    assert(dump(&e, node(&e, ast.ast_kind.k_type_string)) == "(string)");
    assert(dump(&e, node(&e, ast.ast_kind.k_type_void)) == "(void)");
    assert(dump(&e, node(&e, ast.ast_kind.k_type_noreturn)) == "(noreturn)");
    ast.node mut* fn_type = node(&e, ast.ast_kind.k_type_fn);
    fn_type->a = prim_type(&e, prim.prim_kind.prim_i32, 0);
    ast.ast_push(fn_type, prim_type(&e, prim.prim_kind.prim_bool, 0));
    assert(dump(&e, fn_type) == "(fn-type (type (prim i32)) (type (prim bool)))");
}

fn void dump_keeps_the_position_of_absent_children() {
    env mut e = open();
    defer close(&e);
    // An absent fixed child prints as `nil`, so the position of every child
    // is visible in the text.
    ast.node mut* branch = node(&e, ast.ast_kind.k_if);
    branch->a = ident(&e, "c");
    branch->b = node(&e, ast.ast_kind.k_block);
    assert(dump(&e, branch) == "(if (ident c) (block) nil)");
    ast.node mut* loop = node(&e, ast.ast_kind.k_for);
    loop->d = node(&e, ast.ast_kind.k_block);
    assert(dump(&e, loop) == "(for nil nil nil (block))");
    ast.node mut* ret = node(&e, ast.ast_kind.k_return);
    assert(dump(&e, ret) == "(return nil)");
}

fn void dump_of_a_declaration_and_of_a_module() {
    env mut e = open();
    defer close(&e);
    ast.node mut* var = node(&e, ast.ast_kind.k_var_decl);
    var->name = "n";
    var->a = prim_type(&e, prim.prim_kind.prim_i32, ast.FLAG_MUT);
    var->b = int_lit(&e, 1);
    assert(dump(&e, var) == "(var n (type (prim i32) mut) (int 1))");
    ast.node mut* mod = node(&e, ast.ast_kind.k_module);
    ast.ast_push(mod, var);
    assert(dump(&e, mod) == "(module (var n (type (prim i32) mut) (int 1)))");
    // An `extern fn` is named by its flag rather than by its kind (D9.8).
    ast.node mut* fn_decl = node(&e, ast.ast_kind.k_fn_decl);
    fn_decl->name = "abort";
    fn_decl->flags = ast.FLAG_EXTERN;
    fn_decl->a = node(&e, ast.ast_kind.k_type_void);
    assert(dump(&e, fn_decl) == "(extern-fn (void) abort (params) nil)");
}

fn void dump_of_a_case_clause_and_a_designator() {
    env mut e = open();
    defer close(&e);
    ast.node mut* clause = node(&e, ast.ast_kind.k_case);
    ast.ast_push(clause, int_lit(&e, 1));
    clause->a = node(&e, ast.ast_kind.k_block);
    assert(dump(&e, clause) == "(case (labels (int 1)) (block))");
    // The default clause carries the word rather than a label list (D7.6).
    ast.node mut* other = node(&e, ast.ast_kind.k_case);
    other->flags = ast.FLAG_DEFAULT;
    other->a = node(&e, ast.ast_kind.k_block);
    assert(dump(&e, other) == "(case default (block))");
    ast.node mut* field = node(&e, ast.ast_kind.k_designator);
    field->name = "x";
    field->a = int_lit(&e, 2);
    assert(dump(&e, field) == "(designator x (int 2))");
}

fn i32 main() {
    arena_starts_empty();
    arena_hands_out_zeroed_nodes();
    arena_nodes_are_stable_while_it_grows();
    arena_free_empties_and_is_reusable();
    arena_init_zeroes_a_fresh_arena();
    the_nodes_and_their_lists_are_released_with_the_arena();
    children_are_pushed_and_read_back();
    marks_are_read_from_the_flags();
    every_kind_has_a_name();
    dump_of_null_is_nil();
    dump_of_an_error_node_has_no_children();
    dump_of_literals();
    dump_escapes_string_bytes();
    dump_of_operators_uses_the_token_spelling();
    dump_of_a_type_with_marks_and_suffixes();
    dump_of_named_string_void_and_function_types();
    dump_keeps_the_position_of_absent_children();
    dump_of_a_declaration_and_of_a_module();
    dump_of_a_case_clause_and_a_designator();
    println("ok");
    return 0;
}
