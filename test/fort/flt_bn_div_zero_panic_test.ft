//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: flt.bn_div: division by zero
//! stdout:
//| 3
/// The float reader divides by a power of ten or of two, never by zero. A zero divisor
/// breaks that precondition, so the call panics.
import flt;

fn main() i32 {
    flt.bignum mut num = flt.bignum{};
    flt.bignum mut den = flt.bignum{};
    flt.bn_set_u64(&num, 7);
    flt.bn_set_u64(&den, 2);
    bool mut sticky = false;
    println(flt.bn_div(&num, &den, &sticky));
    flt.bn_set_u64(&den, 0);
    flt.bn_div(&num, &den, &sticky);
    return 0;
}
