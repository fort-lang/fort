};

fn open(ownership_source_env.env mut* e, strbuf.str_buf mut* text) void {
    u64 mut i = 0;
    while (i < SOURCE.len) {
        strbuf.append(text, SOURCE[i]);
        strbuf.push(text, '\n');
        i += 1;
    }
    strbuf.append(text, "fn root() i32 { return 0; }\n");
    ownership_source_env.open(e);
    ownership_source_env.runtime(e);
    assert(ownership_source_env.prepare(e, strbuf.view(text)));
}

fn row(ownership_source_env.env mut* e, string name, string correspondence, string proof)
    ownership_source.body* {
    ownership_source.body* found = ownership_source_env.find(e, "main", name);
    string got = ownership_report.analysis_status(found, ownership_report.LOCAL, 0);
    string result = ownership_report.analysis_status(found, ownership_report.LOCAL, 2);
    if (got != correspondence || result != proof) {
        eprintln(name, ": correspondence ", got, ", proof ", result);
        assert(false);
    }
    return found;
}

fn proved(ownership_source_env.env mut* e, string name) void {
    ownership_source.body* found = row(e, name, "complete", "complete");
    assert(found->local.violations_len == 0 && found->local.unvalidated == 0);
}

fn validated(ownership_source_env.env mut* e, string name, ownership_api.event_kind kind,
    string text, u32 line) void {
    ownership_source.body* found = row(e, name, "complete", "violated");
    assert(found->local.violations_len == 1 && found->local.unvalidated == 0);
    ownership_source_local.violation v = found->local.violations[0];
    if (v.kind != kind || v.name != "p" || !v.quoted || v.text != text ||
        v.source.line != line) {
        eprintln(name, ": ", v.name, " at line ", v.source.line, ": ", v.text);
        assert(false);
    }
}

// A body outside the declared scope because a value has no source that local proof knows.
fn unknown(ownership_source_env.env mut* e, string name) void {
    ownership_source.body* found = row(e, name, "incomplete", "incomplete");
    assert(found->local.violations_len == 0);
    assert(found->local.gap == ownership_source_local.missing.unknown_source);
}

// A declared body whose first incomplete operation is on `line`: scoped CI rejects it there.
fn declared(ownership_source_env.env mut* e, string name, u32 line) void {
    ownership_source.body* found = row(e, name, "complete", "incomplete");
    assert(found->local.violations_len == 0);
    ownership_api.proof_status first = found->local.first_incomplete;
    if (!first.terminal.present || first.terminal.source.line != line) {
        eprintln(name, ": first incomplete line ", first.terminal.source.line);
        assert(false);
    }
}

// A read after a test that the value is not null.
fn null_tests(ownership_source_env.env mut* e) void {
    // The early return takes the null path: the read below has a live allocation.
    proved(e, "after_test");
    // The right operand of && runs only when p is not null, and so does the body. The path
    // that skips the right operand knows that the flag is false at the second switch.
    proved(e, "and_test");
    // The right operand of || runs only when p is not null. The path from the left operand
    // knows that the flag is true at the second switch, so it takes the early return.
    proved(e, "or_test");
    // A negation of the test and a null on the left test the same value.
    proved(e, "negated");
    proved(e, "reversed");
    // A named flag keeps the result of the test until its next write.
    proved(e, "named");
    // A cast keeps the source, so the test of the copy decides it for p too.
    proved(e, "viewed");
    // The loop test refutes the body after the release.
    proved(e, "guarded_loop");
    // Two null tests joined by && decide both owners.
    proved(e, "both");
    // The early return of an else-if chain takes the null path.
    proved(e, "else_chain");
    // The loop test refutes the body after the release in an earlier iteration.
    proved(e, "counted_walk");
    // A null test inside the arm of another keeps both owners decided.
    proved(e, "nested_and");
    // The loop runs only while found is null, so the store over found finds it empty.
    proved(e, "found_once");
    // The address of a field in a heap allocation is not null: the test refutes the return
    // that would leak p.
    proved(e, "heap_field");
    // A cast keeps the heap source, so the test of the cast refutes the leaking return too.
    proved(e, "heap_through_cast");
    // A parameter can be null: the test decides nothing, and the read keeps its caller source.
    proved(e, "param_test");
    println("null tests ok");
}

// A read on the path where the test proved the value null.
fn null_branches(ownership_source_env.env mut* e) void {
    // Only the path without the allocation reaches the read, and a witness takes c = false.
    validated(e, "null_branch", ownership_api.event_kind.invalid_use,
        "empty reference has no element", NULL_BRANCH_LINE);
    // The flag keeps the value that the test stored before the release (spec/fir.md 14.1).
    validated(e, "freed_branch", ownership_api.event_kind.invalid_use,
        "empty reference has no element", FREED_BRANCH_LINE);
    // The arm of a conditional expression that the null test selects reads null.
    validated(e, "null_read", ownership_api.event_kind.invalid_use,
        "empty reference has no element", NULL_READ_LINE);
    // The else arm of a test that p is not null reads null.
    validated(e, "wrong_arm", ownership_api.event_kind.invalid_use,
        "empty reference has no element", WRONG_ARM_LINE);
    // `&r->b` of a null r is r plus 8 bytes, which is not null. So an empty owner in a
    // pointer that an address through a pointer fills decides no null test. Each read through
    // q stays unproved, and the program faults at run time.
    declared(e, "field_of_null", FIELD_OF_NULL_LINE);
    declared(e, "owner_field", OWNER_FIELD_LINE);
    declared(e, "array_element", ARRAY_ELEMENT_LINE);
    // A copy of such a pointer keeps the mark.
    declared(e, "copied_field", COPIED_FIELD_LINE);
    // The return does not hide the leak of buf behind a test that q can pass.
    declared(e, "hidden_leak", HIDDEN_LEAK_LINE);
    // The first field has offset 0, but the rule stays conservative for each address.
    declared(e, "first_field", FIRST_FIELD_LINE);
    // A slice through a null array pointer starts past null, and its pointer keeps the mark.
    declared(e, "slice_of_null", SLICE_OF_NULL_LINE);
    // A cast to a void pointer keeps the mark too.
    declared(e, "void_of_field", VOID_OF_FIELD_LINE);
    // A second dereference, or a span header that the referent holds, designates the storage
    // of another reference (D17.17). Such an address or slice has no known source, so its null
    // test decides nothing: each q here is null at run time, and the early return leaks.
    unknown(e, "field_of_field");
    unknown(e, "cell_of_null");
    unknown(e, "element_of_null");
    unknown(e, "span_field");
    // q points into t and not into h, so its read after del(t) is a use after release. The
    // read has no proved source and stays unproved.
    unknown(e, "uaf_through_field");
    // w copies q before the loop body gives q its address, so the mark of w needs a second
    // pass over the statements. After two iterations w is r plus 8 bytes.
    declared(e, "reversed_chain", REVERSED_CHAIN_LINE);
    println("null branches ok");
}

fn flags(ownership_source_env.env mut* e) void {
    // The constant write replaces the stored test, so the null path reaches the read.
    ownership_source.body* again = row(e, "rewritten", "complete", "incomplete");
    assert(again->local.unvalidated == 1);
    assert(again->local.first_incomplete.terminal.source.line == REWRITTEN_LINE);
    // A copy keeps the value of its flag, and a negation inverts it.
    proved(e, "copied");
    // A constant flag refutes the early return that would leak p.
    proved(e, "constant_flag");
    // The value of found leaves the loop on each path, and each path releases p once.
    proved(e, "found_flag");
    // A flag hides no release: the write through p after del stays unproved. The witness
    // takes c = false at the first test, so it does not reach the write.
    declared(e, "freed_flag", FREED_FLAG_LINE);
    // A copy of the parameter c keeps the correlation, so only the path that released p
    // reaches the write through q. The witness takes the other arm first, as above.
    declared(e, "gone_twice", GONE_TWICE_LINE);
    println("flags ok");
}

fn flag_name(ownership_source_local.context* c, u64 i, strbuf.str_buf mut* out) void {
    ownership_flow.flag_edge edge = c->flag_edges[i];
    strbuf.clear(out);
    strbuf.append_u64(out, cast(edge.block, u64));
    strbuf.push(out, '.');
    strbuf.append_u64(out, cast(edge.target_index, u64));
    strbuf.push(out, ' ');
    strbuf.append_u64(out, cast(edge.flag.ordinal, u64));
    strbuf.append(out, edge.value ? " true" : " false");
    if (edge.keep) { strbuf.append(out, " keep"); }
}

// The edges of the switches of and_test. Only the edge that skips the right operand of &&
// keeps the flag: the second switch reads it. The right operand writes the flag first.
fn flag_edges() void {
    ownership_source_env.env mut environment = ownership_source_env.env{};
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    open(&environment, &text);
    defer ownership_source_env.close(&environment);
    ownership_source.body* found = ownership_source_env.find(&environment, "main", "and_test");
    ownership_source_local.context* c = &found->local;
    string[6] expected = {"1.0 1 true", "1.1 1 false", "3.0 5 true", "3.1 5 false keep",
        "6.0 5 true", "6.1 5 false"};
    strbuf.str_buf mut got = strbuf.create();
    defer strbuf.free(&got);
    bool mut same = c->flag_edges_len == expected.len;
    u64 mut i = 0;
    while (i < c->flag_edges_len) {
        flag_name(c, i, &got);
        if (i >= expected.len || strbuf.view(&got) != expected[i]) { same = false; }
        i += 1;
    }
    if (!same) {
        i = 0;
        while (i < c->flag_edges_len) {
            flag_name(c, i, &got);
            eprintln("    \"", strbuf.view(&got), "\",");
            i += 1;
        }
        assert(false);
    }
    // The comparison and the copies into the flag are its writes. The parameter c has none.
    u64 mut writes = 0;
    i = 0;
    while (i < c->steps_len) {
        if (c->steps[i].kind == ownership_flow.step_kind.flag) { writes += 1; }
        i += 1;
    }
    assert(writes == 4);
    assert(c->flag[1] && c->flag[5] && c->flag[6] && c->flag[7] && !c->flag[2]);
    println("flag edges ok");
}

// Two iterations of one allocation site.
fn loop_sites(ownership_source_env.env mut* e) void {
    // The allocations of two iterations are live at once in a and b, and each is released.
    proved(e, "keep_two");
    // b keeps the allocation of an earlier iteration: its storage ends with a live owner.
    // The leak needs two back edges, so no witness validates it (toolchain 4.2).
    ownership_source.body* leak = row(e, "keep_two_leak", "complete", "incomplete");
    assert(leak->local.unvalidated == 1);
    assert(leak->local.first_incomplete.terminal.source.line == KEEP_TWO_LEAK_LINE);
    // Three iterations keep three allocations live: the site has only two identities.
    declared(e, "three_live", THREE_LIVE_LINE);
    // A view of the earlier allocation follows it to its earlier identities.
    proved(e, "good_view");
    // The view reads the earlier allocation after its release.
    declared(e, "stale_view", STALE_VIEW_LINE);
    // The earlier allocation in b meets the next move into b, and it leaks after two
    // iterations. Both events need back edges, and the move comes first in source order.
    declared(e, "rotate", ROTATE_LINE);
    // first keeps the allocation of the first iteration: its storage ends with a live owner.
    // The test of first is not null after that iteration, so no later store overwrites it.
    declared(e, "keep_first", KEEP_FIRST_LINE);
    // Spans of a symbolic length keep apart: a view reads the earlier span before its release.
    proved(e, "span_views");
    proved(e, "span_reads");
    // The pattern of the loop that once allocated a borrows array in each iteration leaves
    // the declared scope. Its view `storage->items[..]` slices a span that the block holds,
    // so the view has no source that local proof knows (D17.17).
    unknown(e, "old_pattern");
    println("loop sites ok");
}

fn main() i32 {
    ownership_source_env.env mut environment = ownership_source_env.env{};
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    flag_edges();
    open(&environment, &text);
    defer ownership_source_env.close(&environment);
    ownership_source.analyze(&environment.source);
    null_tests(&environment);
    null_branches(&environment);
    flags(&environment);
    loop_sites(&environment);
    return 0;
}
