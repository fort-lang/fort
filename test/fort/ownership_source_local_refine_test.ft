//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| flag edges ok
//| null tests ok
//| null branches ok
//| flags ok
//| loop sites ok
/// Checks the two refinements of the local analysis. A null test or a known flag refutes each
/// switch edge that a path cannot take (spec/fir.md 14.1). An earlier allocation of a loop site
/// takes the earlier identities of its site, so two iterations keep apart (D17.16).
import ownership_api;
import ownership_flow;
import ownership_report;
import ownership_source;
import ownership_source_env;
import ownership_source_local;
import std.strbuf;

u32 NULL_BRANCH_LINE = 63;
u32 FREED_BRANCH_LINE = 70;
u32 REWRITTEN_LINE = 77;
u32 KEEP_TWO_LEAK_LINE = 130;
u32 THREE_LIVE_LINE = 140;
u32 STALE_VIEW_LINE = 172;
u32 FREED_FLAG_LINE = 217;
u32 GONE_TWICE_LINE = 225;
u32 WRONG_ARM_LINE = 270;
u32 ROTATE_LINE = 277;
u32 KEEP_FIRST_LINE = 291;
u32 FIELD_OF_NULL_LINE = 326;
u32 HIDDEN_LEAK_LINE = 334;
u32 OWNER_FIELD_LINE = 339;
u32 ARRAY_ELEMENT_LINE = 345;
u32 FIRST_FIELD_LINE = 351;
u32 COPIED_FIELD_LINE = 366;
u32 SLICE_OF_NULL_LINE = 373;
u32 REVERSED_CHAIN_LINE = 402;
u32 VOID_OF_FIELD_LINE = 380;
u32 NULL_READ_LINE = 209;

string[445] SOURCE = {
    "fn after_test(bool c) void {",
    "    i32 mut* own mut p = null;",
    "    if (c) { p = new(i32); }",
    "    if (p == null) { return; }",
    "    *p = 1;",
    "    del(p);",
    "}",
    "fn and_test(bool c) void {",
    "    i32 mut* own mut p = null;",
    "    if (c) { p = new(i32); }",
    "    if (p != null && *p == 0) { *p = 1; }",
    "    del(p);",
    "}",
    "fn or_test(bool c) void {",
    "    i32 mut* own mut p = null;",
    "    if (c) { p = new(i32); }",
    "    if (p == null || *p == 0) { del(p); return; }",
    "    *p = 1;",
    "    del(p);",
    "}",
    "fn negated(bool c) void {",
    "    i32 mut* own mut p = null;",
    "    if (c) { p = new(i32); }",
    "    if (!(p == null)) { *p = 1; }",
    "    del(p);",
    "}",
    "fn reversed(bool c) void {",
    "    i32 mut* own mut p = null;",
    "    if (c) { p = new(i32); }",
    "    if (null != p) { *p = 1; }",
    "    del(p);",
    "}",
    "fn named(bool c) void {",
    "    i32 mut* own mut p = null;",
    "    if (c) { p = new(i32); }",
    "    bool ok = p != null;",
    "    if (ok) { *p = 1; }",
    "    del(p);",
    "}",
    "fn viewed(bool c) void {",
    "    i32 mut* own mut p = null;",
    "    if (c) { p = new(i32); }",
    "    void* v = cast(p, void*);",
    "    if (v != null) { *p = 1; }",
    "    del(p);",
    "}",
