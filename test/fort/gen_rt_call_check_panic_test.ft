//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: gen.rt_call_check: a call of a runtime entry differs from its row
//! stdout:
//| i32
/// The row of `std.rt.release` takes a `ptr` and a location. A call with one `i32` argument
/// differs from the row, so the call panics before it writes a line.
import fort.gen;
import fort.runtime_sig;
import gen_env;

fn main() i32 {
    gen.gen_args mut* own args = gen.gen_args_make();
    defer gen.gen_args_drop_made(move(args));
    gen_env.env mut* own e = gen_env.make();
    defer gen_env.drop_made(move(e));
    gen.gen_args_add(args, gen.gen_val{"i32", "%p"});
    println(gen.gen_args_text(args)[..3]);
    gen.gen_call_rt(&e->g, runtime_sig.rt_entry.rt_release, args);
    return 0;
}
