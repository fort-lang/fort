//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: ownership_state.edges: capacity overflow
//! stdout:
//| 0
/// append_edges refuses to add an entry after U64_MAX entries, because the count would
/// pass u64. The test sets edges_len to U64_MAX, and the call panics.
import ownership_api;
import ownership_state;

fn main() i32 {
    ownership_state.state mut s = ownership_state.empty();
    defer ownership_state.free(&s);
    println(s.edges_len);
    s.edges_len = ownership_state.U64_MAX;
    ownership_state.append_edges(&s, ownership_api.graph_edge{});
    return 0;
}
