//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: types: one declaration used for a struct and an enum
//! stdout:
//| true
import types;
import types_env;

// One declaration names one nominal type, so the same decl reaching
// type_enum after type_struct is a broken precondition.
// D3.12
fn main() i32 {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    println(types.type_struct(&e.tt, "node", e.node->decl) == e.node);
    println(types.type_enum(&e.tt, "node", e.node->decl) == e.node);
    return 0;
}
