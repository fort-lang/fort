fn extent_count(ownership_summary_body.body_program* program) u64 {
    u64 mut count = 0;
    u64 mut row = 0;
    while (row < program->requirements_len) {
        if (program->requirements[row].kind ==
            ownership_summary_model.requirement_kind.extent) { count += 1; }
        row += 1;
    }
    return count;
}

// A slice has no summary rule. The extraction stops at the first slice, before an extent of
// the sliced view can reach a requirement (D17.18).
fn sliced_callee(string callee, string caller) void {
    string[2] source = {callee, caller};
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    ownership_calls_fixtures.open(&f, source[..]);
    defer ownership_calls_fixtures.close(&f);
    assert(f.summary.proof.kind == ownership_api.proof_kind.incomplete);
    assert(f.summary.proof.terminal.reason == ownership_api.incomplete_reason.unknown_effect);
    assert(f.summary.cases.len == 0 && f.summary.requirements.len == 0);
    ownership_summary_body.body_program mut program =
        ownership_summary_body.extract(&f.inputs[0]);
    defer ownership_summary_body.free(&program);
    assert(program.proof.kind == ownership_api.proof_kind.incomplete);
    assert(program.proof.terminal.reason == ownership_api.incomplete_reason.unknown_effect);
    assert(extent_count(&program) == 0);
}

// A slice of a slice, an index after a slice, and a slice of 0 bytes.
fn slices_stay_incomplete() void {
    string caller = "fn caller(i32@ v) i32 { return callee(v); }";
    sliced_callee("fn callee(i32@ v) i32 { i32@ w = v[1..3][0..1]; return w[0]; }", caller);
    sliced_callee("fn callee(i32@ v) i32 { return v[1..][0]; }", caller);
    sliced_callee("fn callee(i32@ v, u64 i) i32 { i32@ w = v[1..]; return w[i]; }",
        "fn caller(i32@ v, u64 i) i32 { return callee(v, i); }");
    sliced_callee("fn callee(i32@ v) i32 { i32@ w = v[0..0]; return cast(w.len, i32); }",
        caller);
}

// The callee summary needs 8 bytes of its view. A caller that passes a slice of a slice or a
// slice of 0 bytes stops at its own slice, so no sliced view reaches the application.
fn sliced_caller(string caller) void {
    string[2] source = {"fn callee(i32@ v) i32 { return v[1]; }", caller};
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    ownership_calls_fixtures.open(&f, source[..]);
    defer ownership_calls_fixtures.close(&f);
    successful(&f);
    ownership_summary_body.body_program mut program =
        ownership_summary_body.extract(&f.inputs[1]);
    defer ownership_summary_body.free(&program);
    assert(program.proof.kind == ownership_api.proof_kind.incomplete);
    assert(program.proof.terminal.reason == ownership_api.incomplete_reason.unknown_effect);
}

fn caller_slices_stay_incomplete() void {
    sliced_caller("fn caller(i32@ v) i32 { return callee(v[1..3][0..2]); }");
    sliced_caller("fn caller(i32@ v) i32 { return callee(v[2..2]); }");
}

// The caller view starts at `offset` in its storage and holds `bytes` bytes. The application
// measures the requirement from the start of the view and not from the start of the storage.
fn span_index_window(string callee, i64 offset, i64 bytes, bool proved) void {
    string[2] source = {callee, "fn caller(i32@ values) i32 { return callee(values); }"};
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    ownership_calls_fixtures.open(&f, source[..]);
    defer ownership_calls_fixtures.close(&f);
    successful(&f);
    ownership_calls_fixtures.prepare(&f);
    ownership_calls_fixtures.configure_source(&f, ownership_api.source_kind.symbolic_caller,
        ownership_api.validity_kind.live, offset + bytes);
    ownership_api.contents_fact mut value = ownership_calls_fixtures.contents(&f, 1);
    ownership_api.borrow_relation[1] mut relations = {value.borrows[0]};
    relations[0].range.offset = ownership_summary_body.integer(offset);
    relations[0].range.access.begin = ownership_summary_body.integer(offset);
    value.borrows = relations[..];
    u64 at = ownership_transfer.contents_index(&f.caller, value.place);
    f.caller.contents[at] = ownership_state.copy_contents(&f.caller, value);
    ownership_calls_fixtures.apply(&f, 8);
    if (proved) {
        assert(ownership_api.successful(f.application.proof) && f.application.normal_continuation);
        return;
    }
    assert(f.application.proof.failed && !f.application.normal_continuation);
    assert(f.services.counts.last.kind == ownership_api.event_kind.caller_requirement);
    assert(f.services.counts.last.text == "call requires a larger argument access window");
}

// Index 1 needs 8 bytes and index 0 needs 4. The last byte decides each pair of windows.
fn span_index_windows() void {
    string second = "fn callee(i32@ values) i32 { return values[1]; }";
    span_index_window(second, 0, 0, false);
    span_index_window(second, 0, 7, false);
    span_index_window(second, 0, 8, true);
    span_index_window(second, 8, 4, false);
    span_index_window(second, 8, 7, false);
    span_index_window(second, 8, 8, true);
    string first = "fn callee(i32@ values) i32 { return values[0]; }";
    span_index_window(first, 0, 0, false);
    span_index_window(first, 4, 3, false);
    span_index_window(first, 4, 4, true);
}

// The summary of `callee` stays incomplete with `reason`, and a call of it is not proved.
fn callee_stays_incomplete(string@ source, ownership_api.incomplete_reason reason) void {
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    ownership_calls_fixtures.open(&f, source);
    defer ownership_calls_fixtures.close(&f);
    assert(f.summary.proof.kind == ownership_api.proof_kind.incomplete);
    assert(f.summary.proof.terminal.reason == reason);
    assert(f.summary.cases.len == 0 && f.summary.residual_effects);
}

// A store, a release and a load through a dynamic fixed-array index, and a release before a
// dynamic store. Each body has a use after free, and each summary stays incomplete (D17.15).
fn dynamic_fixed_index_faults_stay_incomplete() void {
    string[11] stored = {
        "struct views { i32*[2] items; }",
        "fn callee(views mut* p, u64 i) i32 {",
        "    i32 mut* own a = new(i32);",
        "    p->items[i] = a;",
        "    del(a);",
        "    i32 v = *p->items[i];",
        "    p->items[i] = null;",
        "    return v;",
        "}",
        "fn caller(views mut* p, u64 i) i32 { return callee(p, i); }",
        "fn unused() void {}",
    };
    callee_stays_incomplete(stored[..], ownership_api.incomplete_reason.missing_path);
    string[3] released = {
        "struct S { u8 x; u8[4] a; }",
        "fn callee(S mut* own p, u64 i) void { del(p); p->a[i] = 1; }",
        "fn caller(S mut* own p, u64 i) void { callee(move(p), i); }",
    };
    callee_stays_incomplete(released[..], ownership_api.incomplete_reason.missing_path);
}

// A field address copied into a local names no caller path. The store, the release and the
// load through it stay incomplete, as on main (D17.14).
fn copied_field_address_fault_stays_incomplete() void {
    string[13] source = {
        "struct inner { i32* item; }",
        "struct outer { u64 tag; inner in; }",
        "fn callee(outer mut* p) i32 {",
        "    i32 mut* own a = new(i32);",
        "    inner mut* q = &p->in;",
        "    q->item = a;",
        "    del(a);",
        "    i32 v = *q->item;",
        "    q->item = null;",
        "    return v;",
        "}",
        "fn caller(outer mut* p) i32 { return callee(p); }",
        "fn unused() void {}",
    };
    callee_stays_incomplete(source[..], ownership_api.incomplete_reason.unknown_effect);
}

// A caller binds a span formal to one element at entry. A field read past an index step of
// the formal stays incomplete, so the caller that passes its own span is not failed.
fn formal_span_field_index_stays_incomplete() void {
    string[3] source = {
        "struct node { node@* ptr; u64 v; }",
        "fn callee(node@ s) u64 { return s[1].v; }",
        "fn caller(node@ s) u64 { return callee(s); }",
    };
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    ownership_calls_fixtures.open(&f, source[..]);
    defer ownership_calls_fixtures.close(&f);
    assert(f.summary.proof.kind == ownership_api.proof_kind.incomplete);
    assert(f.summary.proof.terminal.reason == ownership_api.incomplete_reason.missing_path);
    ownership_summary_body.body_program mut program =
        ownership_summary_body.extract(&f.inputs[0]);
    defer ownership_summary_body.free(&program);
    assert(ownership_api.successful(program.proof));
    assert(program.lost_requirement);
    ownership_calls_fixtures.prepare(&f);
    ownership_calls_fixtures.apply(&f, 1);
    // An incomplete application is no violation: a violation is a complete failed proof.
    assert(f.application.proof.kind == ownership_api.proof_kind.incomplete);
    assert(!f.application.normal_continuation);
    string[3] first = {
        "struct node { node@* ptr; u64 v; }",
        "fn callee(node@ s) u64 { return s[0].v; }",
        "fn caller(node@ s) u64 { return callee(s); }",
    };
    callee_stays_incomplete(first[..], ownership_api.incomplete_reason.missing_path);
}

// After a load through `s[0].ptr`, the next index selects the loaded span and not `s`. The
// selection stops, so `s` gets no 32-byte extent requirement.
fn loaded_span_index_names_no_outer_local() void {
    string[3] source = {
        "struct node { node@* ptr; u64 v; }",
        "fn callee(node@ s) u64 { return (*s[0].ptr)[1].v; }",
        "fn caller(node@ s) u64 { return callee(s); }",
    };
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    ownership_calls_fixtures.open(&f, source[..]);
    defer ownership_calls_fixtures.close(&f);
    assert(f.summary.proof.kind == ownership_api.proof_kind.incomplete);
    ownership_summary_body.body_program mut program =
        ownership_summary_body.extract(&f.inputs[0]);
    defer ownership_summary_body.free(&program);
    assert(program.proof.kind == ownership_api.proof_kind.incomplete);
    assert(program.proof.terminal.reason == ownership_api.incomplete_reason.missing_path);
    u64 mut row = 0;
    while (row < program.requirements_len) {
        ownership_summary_model.requirement needed = program.requirements[row];
        assert(needed.kind != ownership_summary_model.requirement_kind.extent ||
            needed.range.access.end.value < 32);
        row += 1;
    }
}

// One index step of a by-value array reads that local, as on main. A dynamic index after a
// field of a by-value struct has no selected path.
fn by_value_array_index_reads_the_local() void {
    string[2] source = {
        "fn callee(i32[2] a, u64 i) i32 { return a[i]; }",
        "fn caller(i32[2] a, u64 i) i32 { return callee(a, i); }",
    };
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    ownership_calls_fixtures.open(&f, source[..]);
    defer ownership_calls_fixtures.close(&f);
    successful(&f);
    assert(f.summary.requirements.len == 0);
    string[3] nested = {
        "struct box { i32[2] a; }",
        "fn callee(box b, u64 i) i32 { return b.a[i]; }",
        "fn caller(box b, u64 i) i32 { return callee(b, i); }",
    };
    callee_stays_incomplete(nested[..], ownership_api.incomplete_reason.missing_path);
}

// A release consumes one exact owner place. An exact span index gives that place and needs a
// valid old owner. A dynamic index names no exact place, so its extraction stops.
fn span_index_release_needs_an_exact_place() void {
    string[3] exact = {
        "struct node { i32 value; }",
        "fn callee(node mut* own mut@ items) void { del(items[0]); }",
        "fn caller(node mut* own mut@ items) void { callee(items); }",
    };
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    ownership_calls_fixtures.open(&f, exact[..]);
    defer ownership_calls_fixtures.close(&f);
    ownership_summary_body.body_program mut program =
        ownership_summary_body.extract(&f.inputs[0]);
    defer ownership_summary_body.free(&program);
    assert(ownership_api.successful(program.proof));
    assert(kind_count(&program, ownership_summary_model.requirement_kind.valid_owner) == 1);
    // A release through a span formal loses its requirement, so the summary keeps the stop of
    // main: missing_path.
    assert(program.lost_requirement);
    assert(f.summary.proof.kind == ownership_api.proof_kind.incomplete);
    assert(f.summary.proof.terminal.reason == ownership_api.incomplete_reason.missing_path);
    string[3] dynamic = {
        "struct node { i32 value; }",
        "fn callee(node mut* own mut@ items, u64 i) void { del(items[i]); }",
        "fn caller(node mut* own mut@ items, u64 i) void { callee(items, i); }",
    };
    ownership_calls_fixtures.fixture mut g = ownership_calls_fixtures.fixture{};
    ownership_calls_fixtures.open(&g, dynamic[..]);
    defer ownership_calls_fixtures.close(&g);
    ownership_summary_body.body_program mut released =
        ownership_summary_body.extract(&g.inputs[0]);
    defer ownership_summary_body.free(&released);
    assert(released.proof.kind == ownership_api.proof_kind.incomplete);
    assert(released.proof.terminal.reason == ownership_api.incomplete_reason.unknown_effect);
    assert(kind_count(&released, ownership_summary_model.requirement_kind.valid_owner) == 0);
}

// A local loaded from caller storage names no caller root, as on main. A store of a borrowed
// pointer, a copy and a read through it stay incomplete with unknown_effect.
fn loaded_root_access_stays_incomplete() void {
    string base = "struct holder { i32* r; u64 n; } struct outer { holder mut* h; }";
    string[3] retained = {base,
        "fn callee(outer mut* p) void { i32 x = 1; holder mut* q = p->h; q->r = &x; }",
        "fn caller(outer mut* p) void { callee(p); }"};
    callee_stays_incomplete(retained[..], ownership_api.incomplete_reason.unknown_effect);
    string[3] copied = {base,
        "fn callee(outer* p) i32* { holder* q = p->h; return q->r; }",
        "fn caller(outer* p) i32* { return callee(p); }"};
    callee_stays_incomplete(copied[..], ownership_api.incomplete_reason.unknown_effect);
    string[3] read = {base,
        "fn callee(outer* p) u64 { holder* q = p->h; return q->n; }",
        "fn caller(outer* p) u64 { return callee(p); }"};
    callee_stays_incomplete(read[..], ownership_api.incomplete_reason.unknown_effect);
}

// The local `q` keeps the old pointer of `b->c`, and the body frees that cell before it reads
// `*q->v`. A second deref through a loaded local takes no caller rule, so the summary stays
// incomplete with unknown_effect, as on main (D17.18).
fn loaded_deref_after_release_stays_incomplete() void {
    string[4] source = {
        "struct cell { i32* v; u64 n; } struct box { cell mut* own c; }",
        "fn callee(box mut* b) i32 { cell* q = b->c; del(move(b->c)); return *q->v; }",
        "fn caller(box mut* b) i32 { return callee(b); }",
        "fn unused() void {}",
    };
    callee_stays_incomplete(source[..], ownership_api.incomplete_reason.unknown_effect);
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    ownership_calls_fixtures.open(&f, source[..]);
    defer ownership_calls_fixtures.close(&f);
    ownership_summary_body.body_program mut program =
        ownership_summary_body.extract(&f.inputs[0]);
    defer ownership_summary_body.free(&program);
    assert(program.proof.kind == ownership_api.proof_kind.incomplete);
    assert(program.proof.terminal.reason == ownership_api.incomplete_reason.unknown_effect);
}

// One index step of a span local loaded from caller storage keeps the read rule of main, which
// proves this body.
fn loaded_span_one_step_keeps_main() void {
    string[3] source = {
        "struct view { u64@ sp; }",
        "fn callee(view* p) u64 { u64@ s = p->sp; return s[0]; }",
        "fn caller(view* p) u64 { return callee(p); }",
    };
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    ownership_calls_fixtures.open(&f, source[..]);
    defer ownership_calls_fixtures.close(&f);
    successful(&f);
    assert(projection_count(&f.summary, ownership_api.projection_kind.captured_index) == 0);
}

// A span local loaded from caller storage names no caller root. A field read past its index
// stops path selection after the release of that span, as on main.
fn loaded_span_after_release_stays_incomplete() void {
    string[3] source = {
        "struct node { u64 v; } struct hold { node mut@ own buf; }",
        "fn callee(hold mut* h) u64 { node@ s = h->buf; del(move(h->buf)); return s[0].v; }",
        "fn caller(hold mut* h) u64 { return callee(h); }",
    };
    callee_stays_incomplete(source[..], ownership_api.incomplete_reason.missing_path);
}

// The callee of `source` changes element 1 of a span formal, and the caller passes its own
// span. The callee summary stays incomplete, so the call is not failed (D17.18).
fn formal_span_change(string@ source) void {
    callee_stays_incomplete(source, ownership_api.incomplete_reason.missing_path);
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    ownership_calls_fixtures.open(&f, source);
    defer ownership_calls_fixtures.close(&f);
    ownership_calls_fixtures.prepare(&f);
    ownership_calls_fixtures.apply(&f, 1);
    assert(f.application.proof.kind == ownership_api.proof_kind.incomplete);
    assert(!f.application.normal_continuation);
}

// A store, a release and a move through one index step of a span formal lose the requirement.
// Only a read of one index step keeps the read rule of main.
fn formal_span_changes_stay_incomplete() void {
    string[2] stored = {"fn callee(u64 mut@ s) void { s[1] = 3; }",
        "fn caller(u64 mut@ s) void { callee(s); }"};
    formal_span_change(stored[..]);
    string[3] released = {"struct node { i32 value; }",
        "fn callee(node mut* own mut@ view) void { del(view[1]); }",
        "fn caller(node mut* own mut@ v) void { callee(v); }"};
    formal_span_change(released[..]);
    string[3] moved = {"struct node { i32 value; }",
        "fn callee(node mut* own mut@ view) node mut* own { return move(view[1]); }",
        "fn caller(node mut* own mut@ v) node mut* own { return callee(v); }"};
    formal_span_change(moved[..]);
}

fn main() i32 {
    dynamic_fixed_index_stays_incomplete();
    exact_fixed_index();
    computed_fixed_index_stays_incomplete();
    dynamic_span_index();
    pointer_backed_span_view();
    dynamic_string_index();
    nested_span_index();
    dynamic_struct_index_keeps_enclosing_extent();
    dynamic_span_write();
    casted_span_index_keeps_owner_storage();
    nested_header_length();
    nested_span_length();
    copied_field_address_stays_incomplete();
    exact_local_allocation_index();
    changed_address_pointee_stays_incomplete();
    changed_array_address_pointee_stays_incomplete();
    replaced_nested_field_address_stays_incomplete();
    repeated_nested_field_read();
    nested_string_value();
    loaded_pointer_field_stays_incomplete();
    global_length();
    repeated_global_length();
    two_global_lengths();
    global_character();
    global_scalar_field();
    mutable_global_header();
    global_reference_field_stays_incomplete();
    global_sources_are_static();
    global_source_is_stable();
    mutable_global_index_stays_incomplete();
    direct_global_aggregate_stays_incomplete();
    global_application_stays_conservative();
    global_store_stays_incomplete();
    by_value_pointer_field_stays_incomplete();
    by_value_span_field_stays_incomplete();
    changed_by_value_pointer_stays_incomplete();
    changed_by_value_span_stays_incomplete();
    mutable_by_value_span_stays_incomplete();
    span_index_end_overflow_stays_incomplete();
    exact_string_index();
    loaded_string_index_loses_requirement();
    slices_stay_incomplete();
    caller_slices_stay_incomplete();
    span_index_windows();
    dynamic_fixed_index_faults_stay_incomplete();
    copied_field_address_fault_stays_incomplete();
    formal_span_field_index_stays_incomplete();
    loaded_span_index_names_no_outer_local();
    by_value_array_index_reads_the_local();
    span_index_release_needs_an_exact_place();
    loaded_root_access_stays_incomplete();
    loaded_deref_after_release_stays_incomplete();
    loaded_span_after_release_stays_incomplete();
    loaded_span_one_step_keeps_main();
    formal_span_changes_stay_incomplete();
    println("projected summary access ok");
    return 0;
}
