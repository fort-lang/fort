        "fn callee(value r) u64 { return r.callee->node->flags; }",
        "fn caller(value r) u64 { return callee(r); }",
    };
    callee_stays_incomplete(source[..], ownership_api.incomplete_reason.missing_path);
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    ownership_calls_fixtures.open(&f, source[..]);
    defer ownership_calls_fixtures.close(&f);
    ownership_summary_body.body_program mut program =
        ownership_summary_body.extract(&f.inputs[0]);
    defer ownership_summary_body.free(&program);
    assert(program.proof.kind == ownership_api.proof_kind.incomplete);
    assert(program.proof.terminal.reason == ownership_api.incomplete_reason.missing_path);
    assert(body_root_count(&program, ownership_summary_model.root_kind.loaded_source) == 0);
}

// A span field of a by-value parameter has no input root. Its index stops path selection with
// missing_path, as on main.
fn by_value_span_field_stays_incomplete() void {
    string[4] dynamic = {
        "struct projection { u64 kind; }",
        "struct path { projection@ projections; }",
        "fn callee(path p, u64 i) u64 { return p.projections[i].kind; }",
        "fn caller(path p, u64 i) u64 { return callee(p, i); }",
    };
    callee_stays_incomplete(dynamic[..], ownership_api.incomplete_reason.missing_path);
    string[4] exact = {
        "struct projection { u64 kind; }",
        "struct path { projection@ projections; }",
        "fn callee(path p) u64 { return p.projections[0].kind; }",
        "fn caller(path p) u64 { return callee(p); }",
    };
    callee_stays_incomplete(exact[..], ownership_api.incomplete_reason.missing_path);
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    ownership_calls_fixtures.open(&f, exact[..]);
    defer ownership_calls_fixtures.close(&f);
    ownership_summary_body.body_program mut program =
        ownership_summary_body.extract(&f.inputs[0]);
    defer ownership_summary_body.free(&program);
    assert(program.proof.kind == ownership_api.proof_kind.incomplete);
    assert(program.proof.terminal.reason == ownership_api.incomplete_reason.missing_path);
    assert(body_root_count(&program, ownership_summary_model.root_kind.loaded_source) == 0);
}

