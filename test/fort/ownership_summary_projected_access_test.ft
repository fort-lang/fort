// A copy of a field address names no caller path. A field read through the copy stays
// incomplete with unknown_effect, as on main (D17.14).
fn copied_field_address_stays_incomplete() void {
    string[5] source = {
        "struct vector { i32@ items; }",
        "struct outer { vector values; }",
        "fn callee(outer* p) u64 {",
        "    vector* v = &p->values; vector* w = v; return w->items.len; }",
        "fn caller(outer* p) u64 { return callee(p); }",
    };
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    ownership_calls_fixtures.open(&f, source[..]);
    defer ownership_calls_fixtures.close(&f);
    assert(f.summary.proof.kind == ownership_api.proof_kind.incomplete);
    assert(f.summary.proof.terminal.reason == ownership_api.incomplete_reason.unknown_effect);
    ownership_summary_body.body_program mut program =
        ownership_summary_body.extract(&f.inputs[0]);
    defer ownership_summary_body.free(&program);
    assert(program.proof.kind == ownership_api.proof_kind.incomplete);
    assert(program.proof.terminal.reason == ownership_api.incomplete_reason.unknown_effect);
    assert(program.residual_effects);
}

fn exact_local_allocation_index() void {
    string[5] source = {
        "fn callee() i32 {",
        "    i32 mut@ own values = new(i32, 2);",
        "    i32 result = values[1]; del(values); return result;",
        "}",
        "fn caller() i32 { return callee(); }",
    };
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    ownership_calls_fixtures.open(&f, source[..]);
    defer ownership_calls_fixtures.close(&f);
    ownership_summary_body.body_program mut program =
        ownership_summary_body.extract(&f.inputs[0]);
    defer ownership_summary_body.free(&program);
    assert(ownership_api.successful(program.proof));
    assert(body_root_count(&program,
        ownership_summary_model.root_kind.allocation_template) == 1);
    assert(body_root_count(&program, ownership_summary_model.root_kind.caller_source) == 0);
    ownership_summary_model.effect_node read = captured_read(&program,
        ownership_api.projection_kind.captured_index);
    assert(read.effect.place.projections.len == 1);
    assert(read.effect.place.projections[0].index.kind == ownership_api.fact_kind.exact);
    assert(read.effect.place.projections[0].index.value == 1);
    assert(read.range.extent.kind == ownership_api.fact_kind.exact);
    assert(read.range.extent.value == 8 && read.range.alignment == 4);
}

