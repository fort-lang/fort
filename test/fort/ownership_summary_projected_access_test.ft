//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| projected summary access ok
/// Checks path selection for span and string indices, loaded fields, and globals. A dynamic
/// fixed-array index and a copied field address stay incomplete.
import ast;
import fir;
import ownership_api;
import ownership_calls_env;
import ownership_calls_fixtures;
import ownership_state;
import ownership_summary_body;
import ownership_summary_model;
import ownership_transfer;

fn successful(ownership_calls_fixtures.fixture* f) void {
    assert(ownership_api.successful(f->summary.proof));
    assert(!f->summary.residual_effects);
    assert(f->summary.cases.len > 0);
}

fn projection_count(ownership_summary_model.summary* model,
    ownership_api.projection_kind kind) u64 {
    u64 mut count = 0;
    u64 mut effect = 0;
    while (effect < model->effects.len) {
        ownership_summary_model.effect_node row = model->effects[effect];
        u64 mut part = 0;
        while (part < row.effect.place.projections.len) {
            if (row.effect.place.projections[part].kind == kind) { count += 1; }
            part += 1;
        }
        part = 0;
        while (part < row.operand.projections.len) {
            if (row.operand.projections[part].kind == kind) { count += 1; }
            part += 1;
        }
        effect += 1;
    }
    return count;
}

fn body_projection_count(ownership_summary_body.body_program* program,
    ownership_api.projection_kind kind) u64 {
    u64 mut count = 0;
    u64 mut effect = 0;
    while (effect < program->effects_len) {
        ownership_summary_model.effect_node row = program->effects[effect];
        u64 mut part = 0;
        while (part < row.effect.place.projections.len) {
            if (row.effect.place.projections[part].kind == kind) { count += 1; }
            part += 1;
        }
        part = 0;
        while (part < row.operand.projections.len) {
            if (row.operand.projections[part].kind == kind) { count += 1; }
            part += 1;
        }
        effect += 1;
    }
    return count;
}

fn body_captured_projection(ownership_summary_body.body_program* program,
    ownership_api.projection_kind kind) ownership_api.projection {
    u64 mut effect = 0;
    while (effect < program->effects_len) {
        ownership_summary_model.effect_node row = program->effects[effect];
        u64 mut part = 0;
        while (part < row.effect.place.projections.len) {
            ownership_api.projection item = row.effect.place.projections[part];
            if (item.kind == kind) { return item; }
            part += 1;
        }
        part = 0;
        while (part < row.operand.projections.len) {
            ownership_api.projection item = row.operand.projections[part];
            if (item.kind == kind) { return item; }
            part += 1;
        }
        effect += 1;
    }
    return ownership_api.projection{};
}

fn captured_projection(ownership_summary_model.summary* model,
    ownership_api.projection_kind kind) ownership_api.projection {
    u64 mut effect = 0;
    while (effect < model->effects.len) {
        ownership_summary_model.effect_node row = model->effects[effect];
        u64 mut part = 0;
        while (part < row.effect.place.projections.len) {
            ownership_api.projection item = row.effect.place.projections[part];
            if (item.kind == kind) { return item; }
            part += 1;
        }
        part = 0;
        while (part < row.operand.projections.len) {
            ownership_api.projection item = row.operand.projections[part];
            if (item.kind == kind) { return item; }
            part += 1;
        }
        effect += 1;
    }
    return ownership_api.projection{};
}

fn root_count(ownership_summary_model.summary* model,
    ownership_summary_model.root_kind kind) u64 {
    u64 mut count = 0;
    u64 mut i = 0;
    while (i < model->roots.len) {
        if (model->roots[i].kind == kind) { count += 1; }
        i += 1;
    }
    return count;
}

fn body_root_count(ownership_summary_body.body_program* program,
    ownership_summary_model.root_kind kind) u64 {
    u64 mut count = 0;
    u64 mut i = 0;
    while (i < program->roots_len) {
        if (program->roots[i].kind == kind) { count += 1; }
        i += 1;
    }
    return count;
}

fn source_count(ownership_summary_body.body_program* program,
    ownership_api.source_kind kind) u64 {
    u64 mut count = 0;
    u64 mut i = 0;
    while (i < program->entry.sources_len) {
        if (program->entry.sources[i].kind == kind) { count += 1; }
        i += 1;
    }
    return count;
}

fn global_read_count(ownership_summary_body.body_program* program) u64 {
    u64 mut count = 0;
    u64 mut effect = 0;
    while (effect < program->effects_len) {
        ownership_summary_model.effect_node row = program->effects[effect];
        u64 mut global = 0;
        while (row.payload == ownership_summary_model.payload_kind.read &&
            global < program->globals_len) {
            if (ownership_summary_model.same(row.effect.place.root,
                program->globals[global].slot)) {
                count += 1;
                break;
            }
            global += 1;
        }
        effect += 1;
    }
    return count;
}

fn read_count(ownership_summary_model.summary* model) u64 {
    u64 mut count = 0;
    u64 mut i = 0;
    while (i < model->effects.len) {
        if (model->effects[i].payload == ownership_summary_model.payload_kind.read) {
            count += 1;
        }
        i += 1;
    }
    return count;
}

fn captured_requirement(ownership_summary_body.body_program* program,
    ownership_api.projection_kind kind) ownership_summary_model.requirement {
    u64 mut row = 0;
    while (row < program->requirements_len) {
        ownership_summary_model.requirement needed = program->requirements[row];
        u64 mut part = 0;
        while (part < needed.path.projections.len) {
            if (needed.path.projections[part].kind == kind) { return needed; }
            part += 1;
        }
        row += 1;
    }
    return ownership_summary_model.requirement{};
}

fn captured_read(ownership_summary_body.body_program* program,
    ownership_api.projection_kind kind) ownership_summary_model.effect_node {
    u64 mut row = program->effects_len;
    while (row > 0) {
        row -= 1;
        ownership_summary_model.effect_node read = program->effects[row];
        u64 mut part = 0;
        while (read.payload == ownership_summary_model.payload_kind.read &&
            part < read.effect.place.projections.len) {
            if (read.effect.place.projections[part].kind == kind) { return read; }
            part += 1;
        }
    }
    return ownership_summary_model.effect_node{};
}

fn select_projected_destination(ownership_calls_fixtures.fixture* f,
    ownership_summary_body.body_program mut* program)
    ownership_summary_body.selected_storage {
    u32 mut block = 0;
    while (block < fir.block_count(&f->functions[0])) {
        u32 mut gap = 0;
        while (gap < fir.block_statement_count(&f->functions[0], block)) {
            fir.statement* stmt = fir.block_statement(&f->functions[0], block, gap);
            if (stmt->kind == fir.stmt_kind.st_assign && stmt->place.proj_len > 0) {
                return ownership_summary_body.select_storage(&f->inputs[0], program,
                    stmt->place, stmt->loc, stmt->exit_loc, stmt->stmt);
            }
            gap += 1;
        }
        block += 1;
    }
    return ownership_summary_body.selected_storage{};
}

// A dynamic index into a fixed array of caller storage has no selected path. The summary stays
// incomplete with missing_path, so no caller can apply it (D17.15, D17.18).
fn dynamic_fixed_index_stays_incomplete() void {
    string[3] source = {
        "struct views { i32*[2] items; }",
        "fn callee(views* p, u64 i) i32 { return *p->items[i]; }",
        "fn caller(views* p, u64 i) i32 { return callee(p, i); }",
    };
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    ownership_calls_fixtures.open(&f, source[..]);
    defer ownership_calls_fixtures.close(&f);
    assert(f.summary.proof.kind == ownership_api.proof_kind.incomplete);
    assert(f.summary.proof.terminal.reason == ownership_api.incomplete_reason.missing_path);
    assert(f.summary.residual_effects);
    assert(projection_count(&f.summary, ownership_api.projection_kind.fixed_index) == 0);
}

fn exact_fixed_index() void {
    string[3] source = {
        "struct views { i32*[2] items; }",
        "fn callee(views* p) i32 { return *p->items[1]; }",
        "fn caller(views* p) i32 { return callee(p); }",
    };
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    ownership_calls_fixtures.open(&f, source[..]);
    defer ownership_calls_fixtures.close(&f);
    successful(&f);
    ownership_api.projection index = captured_projection(&f.summary,
        ownership_api.projection_kind.fixed_index);
    assert(index.index.kind == ownership_api.fact_kind.exact);
    assert(index.index.value == 1);
    assert(index.captured_version.kind == ownership_api.entity_kind.none);
}

fn computed_fixed_index_stays_incomplete() void {
    string[3] source = {
        "struct views { i32*[4] items; }",
        "fn callee(views* p, u64 i) i32 { u64 j = i + 1; return *p->items[j]; }",
        "fn caller(views* p, u64 i) i32 { return callee(p, i); }",
    };
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    ownership_calls_fixtures.open(&f, source[..]);
    defer ownership_calls_fixtures.close(&f);
    assert(f.summary.proof.kind == ownership_api.proof_kind.incomplete);
    assert(f.summary.proof.terminal.reason == ownership_api.incomplete_reason.missing_path);
    ownership_summary_body.body_program mut program =
        ownership_summary_body.extract(&f.inputs[0]);
    defer ownership_summary_body.free(&program);
    assert(program.proof.kind == ownership_api.proof_kind.incomplete);
    assert(program.proof.terminal.reason == ownership_api.incomplete_reason.missing_path);
    assert(body_projection_count(&program, ownership_api.projection_kind.fixed_index) == 0);
}

fn dynamic_span_index() void {
    string[2] source = {
        "fn callee(i32@ values, u64 i) i32 { return values[i]; }",
        "fn caller() i32 { i32[1] values = {7}; return callee(values[..], 1); }",
    };
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    ownership_calls_fixtures.open(&f, source[..]);
    defer ownership_calls_fixtures.close(&f);
    assert(f.summary.proof.kind == ownership_api.proof_kind.incomplete);
    assert(f.summary.proof.terminal.reason == ownership_api.incomplete_reason.missing_path);
    ownership_summary_body.body_program mut program =
        ownership_summary_body.extract(&f.inputs[0]);
    defer ownership_summary_body.free(&program);
    assert(ownership_api.successful(program.proof));
    assert(program.lost_requirement);
    assert(body_projection_count(&program,
        ownership_api.projection_kind.captured_index) > 0);
    ownership_api.projection index = body_captured_projection(&program,
        ownership_api.projection_kind.captured_index);
    assert(index.index.kind == ownership_api.fact_kind.symbolic);
    assert(index.captured_version.kind == ownership_api.entity_kind.value);
    ownership_summary_model.requirement needed = captured_requirement(&program,
        ownership_api.projection_kind.captured_index);
    assert(needed.kind == ownership_summary_model.requirement_kind.extent);
    assert(needed.range.extent.kind == ownership_api.fact_kind.exact);
    assert(needed.range.extent.value == 4 && needed.range.alignment == 4);
    ownership_summary_model.effect_node read = captured_read(&program,
        ownership_api.projection_kind.captured_index);
    assert(read.range.extent.kind == ownership_api.fact_kind.exact);
    assert(read.range.extent.value == 4 && read.range.alignment == 4);
    ownership_calls_fixtures.prepare(&f);
    ownership_calls_fixtures.apply(&f, 1);
    assert(f.application.proof.kind == ownership_api.proof_kind.incomplete);
    assert(!f.application.normal_continuation);
}

fn pointer_backed_span_view() void {
    string[2] source = {
        "fn callee(i32* pointer, i32@ values) i32 { return *pointer; }",
        "fn caller(i32* pointer, i32@ values) i32 { return callee(pointer, values); }",
    };
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    ownership_calls_fixtures.open(&f, source[..]);
    defer ownership_calls_fixtures.close(&f);
    ownership_summary_body.body_program mut program =
        ownership_summary_body.extract(&f.inputs[0]);
    defer ownership_summary_body.free(&program);
    assert(ownership_api.successful(program.proof));
    assert(!program.lost_requirement);
    u64 mut pointer_root = ownership_api.U64_MAX;
    u64 mut span_root = ownership_api.U64_MAX;
    u64 mut root = 0;
    while (root < program.roots_len) {
        ownership_summary_model.symbolic_root item = program.roots[root];
        if (item.kind == ownership_summary_model.root_kind.caller_source && item.formal == 1) {
            pointer_root = root;
        } else if (item.kind == ownership_summary_model.root_kind.caller_source &&
            item.formal == 2) {
            span_root = root;
        }
        root += 1;
    }
    assert(pointer_root != ownership_api.U64_MAX && span_root != ownership_api.U64_MAX);
    assert(program.roots[pointer_root].ty->elem == program.roots[span_root].ty->elem);
    // A caller can bind a pointer formal to the pointer view of a span root.
    program.roots[pointer_root].ty = program.roots[span_root].ty;
    fir.place dereference = fir.place_deref(&f.functions[0], fir.place_local(1));
    fir.terminator* term = &fir.block_at(&f.functions[0], 0)->term;
    ownership_summary_body.selected_storage selected =
        ownership_summary_body.select_storage(&f.inputs[0], &program, dereference, term->loc,
            term->exit_loc, term->stmt);
    assert(ownership_api.successful(program.proof));
    assert(selected.proved && selected.caller && selected.indirect);
}

// A captured index of a caller string reads byte `i`. The summary cannot name `i` in its byte
// end, so a 1-byte requirement would accept a 1-byte caller string. Publication stays
// incomplete, as it does for a span (D17.15, D17.18).
fn dynamic_string_index() void {
    string[2] source = {
        "fn callee(string value, u64 i) char { return value[i]; }",
        "fn caller(string value, u64 i) char { return callee(value, i); }",
    };
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    ownership_calls_fixtures.open(&f, source[..]);
    defer ownership_calls_fixtures.close(&f);
    assert(f.summary.proof.kind == ownership_api.proof_kind.incomplete);
    assert(f.summary.proof.terminal.reason == ownership_api.incomplete_reason.missing_path);
    assert(f.summary.cases.len == 0 && f.summary.residual_effects);
    ownership_summary_body.body_program mut program =
        ownership_summary_body.extract(&f.inputs[0]);
    defer ownership_summary_body.free(&program);
    assert(ownership_api.successful(program.proof));
    assert(program.lost_requirement);
    ownership_api.projection index = body_captured_projection(&program,
        ownership_api.projection_kind.captured_index);
    assert(index.kind == ownership_api.projection_kind.captured_index);
    assert(index.index.kind == ownership_api.fact_kind.symbolic);
    assert(index.captured_version.kind == ownership_api.entity_kind.value);
    ownership_summary_model.requirement needed = captured_requirement(&program,
        ownership_api.projection_kind.captured_index);
    assert(needed.kind == ownership_summary_model.requirement_kind.extent);
    assert(needed.range.access.end.kind == ownership_api.fact_kind.exact);
    assert(needed.range.access.end.value == 1 && needed.range.alignment == 1);
}

// An exact caller string index keeps its exact byte end: index 3 needs 4 bytes.
fn exact_string_index() void {
    string[2] source = {
        "fn callee(string value) char { return value[3]; }",
        "fn caller(string value) char { return callee(value); }",
    };
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    ownership_calls_fixtures.open(&f, source[..]);
    defer ownership_calls_fixtures.close(&f);
    successful(&f);
    ownership_summary_body.body_program mut program =
        ownership_summary_body.extract(&f.inputs[0]);
    defer ownership_summary_body.free(&program);
    assert(ownership_api.successful(program.proof));
    assert(!program.lost_requirement);
    ownership_summary_model.requirement needed = captured_requirement(&program,
        ownership_api.projection_kind.captured_index);
    assert(needed.kind == ownership_summary_model.requirement_kind.extent);
    assert(needed.range.access.end.kind == ownership_api.fact_kind.exact);
    assert(needed.range.access.end.value == 4 && needed.range.alignment == 1);
}

// A string that the body loads from caller storage is caller storage too. Its captured index
// loses the requirement as a parameter string does.
fn loaded_string_index_loses_requirement() void {
    string[3] source = {
        "struct text_box { string text; }",
        "fn callee(text_box* p, u64 i) char { return p->text[i]; }",
        "fn caller(text_box* p, u64 i) char { return callee(p, i); }",
    };
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    ownership_calls_fixtures.open(&f, source[..]);
    defer ownership_calls_fixtures.close(&f);
    assert(f.summary.proof.kind == ownership_api.proof_kind.incomplete);
    ownership_summary_body.body_program mut program =
        ownership_summary_body.extract(&f.inputs[0]);
    defer ownership_summary_body.free(&program);
    assert(ownership_api.successful(program.proof));
    assert(program.lost_requirement);
    assert(body_root_count(&program, ownership_summary_model.root_kind.loaded_source) > 0);
}

fn nested_span_index() void {
    string[3] source = {
        "struct values { i32@ items; }",
        "fn callee(values* p, u64 i) i32 { return p->items[i]; }",
        "fn caller(values* p, u64 i) i32 { return callee(p, i); }",
    };
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    ownership_calls_fixtures.open(&f, source[..]);
    defer ownership_calls_fixtures.close(&f);
    ownership_summary_body.body_program mut program =
        ownership_summary_body.extract(&f.inputs[0]);
    defer ownership_summary_body.free(&program);
    assert(ownership_api.successful(program.proof));
    assert(program.roots_len > 0);
    assert(body_projection_count(&program,
        ownership_api.projection_kind.captured_index) > 0);
}

fn dynamic_struct_index_keeps_enclosing_extent() void {
    string[3] source = {
        "struct row { i32 first; i32 second; i32 third; i32 value; }",
        "fn callee(row@ values, u64 i) i32 { return values[i].value; }",
        "fn caller(row@ values, u64 i) i32 { return callee(values, i); }",
    };
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    ownership_calls_fixtures.open(&f, source[..]);
    defer ownership_calls_fixtures.close(&f);
    ownership_summary_body.body_program mut program =
        ownership_summary_body.extract(&f.inputs[0]);
    defer ownership_summary_body.free(&program);
    assert(ownership_api.successful(program.proof));
    ownership_summary_model.requirement needed = captured_requirement(&program,
        ownership_api.projection_kind.captured_index);
    assert(needed.kind == ownership_summary_model.requirement_kind.extent);
    assert(needed.range.extent.kind == ownership_api.fact_kind.exact);
    assert(needed.range.extent.value == 16 && needed.range.alignment == 4);
}

fn dynamic_span_write() void {
    string[2] source = {
        "fn callee(i32 mut@ values, u64 i, i32 value) void { values[i] = value; }",
        "fn caller(i32 mut@ values, u64 i, i32 value) void { callee(values, i, value); }",
    };
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    ownership_calls_fixtures.open(&f, source[..]);
    defer ownership_calls_fixtures.close(&f);
    ownership_summary_body.body_program mut program =
        ownership_summary_body.extract(&f.inputs[0]);
    defer ownership_summary_body.free(&program);
    assert(ownership_api.successful(program.proof));
    ownership_summary_body.selected_storage selected =
        select_projected_destination(&f, &program);
    assert(selected.proved);
    assert(selected.path.projections.len == 1);
    assert(selected.path.projections[0].kind ==
        ownership_api.projection_kind.captured_index);
    ownership_summary_model.requirement needed = captured_requirement(&program,
        ownership_api.projection_kind.captured_index);
    assert(needed.kind == ownership_summary_model.requirement_kind.extent);
    assert(needed.range.extent.kind == ownership_api.fact_kind.exact);
    assert(needed.range.extent.value == 4 && needed.range.alignment == 4);
}

fn kind_count(ownership_summary_body.body_program* program,
    ownership_summary_model.requirement_kind kind) u64 {
    u64 mut count = 0;
    u64 mut row = 0;
    while (row < program->requirements_len) {
        if (program->requirements[row].kind == kind) { count += 1; }
        row += 1;
    }
    return count;
}

fn casted_span_index_keeps_owner_storage() void {
    string[5] source = {
        "struct node { i32 value; }",
        "fn callee(node mut* own mut@ items) void {",
        "    node mut* mut@ view = cast(items, node mut* mut@);",
        "    view[0] = null; }",
        "fn caller(node mut* own mut@ items) void { callee(items); }",
    };
    ownership_calls_fixtures.fixture mut f = ownership_calls_fixtures.fixture{};
    ownership_calls_fixtures.open(&f, source[..]);
    defer ownership_calls_fixtures.close(&f);
    ownership_summary_body.body_program mut program =
        ownership_summary_body.extract(&f.inputs[0]);
    defer ownership_summary_body.free(&program);
    assert(program.proof.kind == ownership_api.proof_kind.incomplete);
    assert(program.proof.terminal.reason == ownership_api.incomplete_reason.unknown_effect);
    assert(program.residual_effects);
}

fn nested_header_length() void {
    string[3] source = {
        "struct text_box { string text; }",
        "fn callee(text_box* p) u64 { return p->text.len; }",
        "fn caller(text_box* p) u64 { return callee(p); }",
