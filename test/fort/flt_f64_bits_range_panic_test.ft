//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: flt.f64_bits: the value is outside binary64
//! stdout:
//| 4607182418800017408
/// round_ratio calls f64_bits only after it checks the exponent against the format. 1 * 2^2000
/// is above binary64, so the call panics.
import flt;

fn main() i32 {
    println(flt.f64_bits(1, 0));
    flt.f64_bits(1, 2000);
    return 0;
}
