//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: check.check_sym_at: index out of range
//! stdout:
//| true
import check;
import check_env;

// The symbols are the index walk's, in the order they were made, and the
// slots past the last one hold nothing: an index at or past check_sym_count
// is a violated precondition and panics (D13.3), where
// src/bootstrap/check.c's check_sym_at calls fatal_internal.
fn i32 main() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    println(check_env.check_decls(&e, "i32 k = 1;\n"));
    check.check_sym_at(&e.ck, check.check_sym_count(&e.ck));
    return 0;
}
