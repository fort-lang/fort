//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: check.check_expr: not an expression
//! stdout:
//| true
/// check_expr reads an expression node. A `return` statement is no expression, so the call
/// breaks the precondition and panics.
import ast;
import check;
import check_env;

fn main() i32 {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    println(check_env.open_module(&e, check_env.src_main()));
    ast.node mut* ret = check_env.node_in_main(&e, ast.ast_kind.k_return, "");
    check.expr mut out = check.expr{};
    check.check_expr(&e.ck, ret, &out);
    return 0;
}
