// Appends the 64 lower-case hex digits of d to out.
fn append_hex(strbuf.str_buf mut* out, u8[32] d) void {
    for (u8 v : d) {
        strbuf.push(out, HEX[cast(v >> 4, u64)]);
        strbuf.push(out, HEX[cast(v & 0xf, u64)]);
    }
}

// Reports whether d is the digest DIGESTS[n], and prints both when it is not.
fn matches(string how, u64 n, u8[32] d) bool {
    strbuf.str_buf mut got = strbuf.create();
    defer strbuf.free(&got);
    append_hex(&got, d);
    if (strbuf.view(&got) != DIGESTS[n]) {
        println(how, " ", n, ": got ", strbuf.view(&got), " want ", DIGESTS[n]);
        return false;
    }
    return true;
}

// Each length in one call.
fn whole(u8@ m) bool {
    bool mut ok = true;
    u64 mut n = 0;
    while (n < m.len) {
        ok = matches("whole", n, sha256.hash(m[..n])) && ok;
        n += 1;
    }
    return ok;
}

// Each length in three updates, cut at a third and at two thirds, with an empty update before,
// between and after them. An empty update changes nothing.
fn in_parts(u8@ m) bool {
    bool mut ok = true;
    u64 mut n = 0;
    while (n < m.len) {
        u64 one = n / 3;
        u64 two = 2 * n / 3;
        sha256.state mut s = {};
        sha256.init(&s);
        sha256.update(&s, m[..0]);
        sha256.update(&s, m[..one]);
        sha256.update(&s, m[one..one]);
        sha256.update(&s, m[one..two]);
        sha256.update(&s, m[two..n]);
        sha256.update(&s, m[n..n]);
        ok = matches("in parts", n, sha256.finish(&s)) && ok;
        n += 1;
    }
    return ok;
}

fn main() i32 {
    u8 mut@ own m = new(u8, 256);
    defer del(m);
    u64 mut k = 0;
    while (k < m.len) {
        m[k] = cast((k * 31 + 7) % 256, u8);
        k += 1;
    }
    bool a = whole(m);
    if (a) {
        println(m.len, " lengths ok");
    }
    bool b = in_parts(m);
    if (b) {
        println(m.len, " lengths in parts ok");
    }
    if (!a || !b) {
        return 1;
    }
    return 0;
}
