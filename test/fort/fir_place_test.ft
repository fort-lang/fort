//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| ok
/// Checks FIR places: the type of each place form, fixed storage, and the three answers of a
/// place comparison.
import diag;
import fir;
import fir_env;
import types;

// A function over the fixture with one local of each type the suite needs. `add` gives `_1` of
// type i32 and `_2` of type i64.
struct fixture {
    fir.func f;
    u32 pair_local; // pair
    u32 outer_local; // outer
    u32 ptr_local; // pair*
    u32 span_local; // i32 mut@ own
    u32 view_local; // pair@
    u32 str_local; // string
    u32 i; // u64, an index
    u32 j; // u64, an index
    u32 other_pair; // pair
}

fn temp(fir_env.env mut* e, fir.func mut* f, types.node* ty) u32 {
    return fir.local_add(f, ty, fir.local_kind.lk_temp, null, fir_env.at(1, 1));
}

fn make(fir_env.env mut* e) fixture {
    fixture mut x = fixture{};
    x.f = fir_env.func_of(e, "add");
    types.node* pair = fir_env.ty(e, "pair");
    types.table mut* tt = fir_env.tt(e);
    x.pair_local = temp(e, &x.f, pair);
    x.outer_local = temp(e, &x.f, fir_env.ty(e, "outer"));
    x.ptr_local = temp(e, &x.f, types.type_ptr(tt, pair, false, false));
    x.span_local = temp(e, &x.f, types.type_span(tt, fir_env.i32_ty(e), true, true));
    x.view_local = temp(e, &x.f, types.type_span(tt, pair, false, false));
    x.str_local = temp(e, &x.f, types.type_string(tt, false));
    x.i = temp(e, &x.f, fir_env.u64_ty(e));
    x.j = temp(e, &x.f, fir_env.u64_ty(e));
    x.other_pair = temp(e, &x.f, pair);
    return x;
}

// ---- place_type ----------------------------------------------------------------------

fn a_local_has_the_type_of_the_local() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    fir_env.expect(&e, fir.place_type(&x.f, fir.place_local(1)), "i32");
    fir_env.expect(&e, fir.place_type(&x.f, fir.place_local(x.pair_local)), "pair");
    fir_env.expect(&e, fir.place_type(&x.f, fir.place_local(0)), "u64");
}

fn a_global_has_the_type_of_its_symbol() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    fir_env.expect(&e, fir.place_type(&x.f, fir.place_global(fir_env.sym(&e, "total"))), "i32");
    fir_env.expect(&e, fir.place_type(&x.f, fir.place_global(fir_env.sym(&e, "LIMIT"))), "i32");
}

fn a_struct_field_has_its_declared_type() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    fir.place p = fir.place_local(x.pair_local);
    fir_env.expect(&e, fir.place_type(&x.f, fir.place_field(&x.f, p, 0)), "i32");
    fir_env.expect(&e, fir.place_type(&x.f, fir.place_field(&x.f, p, 1)), "u64");
    // A nested struct: `outer.inner.b`.
    fir.place inner = fir.place_field(&x.f, fir.place_local(x.outer_local), 0);
    fir_env.expect(&e, fir.place_type(&x.f, inner), "pair");
    fir_env.expect(&e, fir.place_type(&x.f, fir.place_field(&x.f, inner, 1)), "u64");
    // An owning field keeps its marks.
    u32 h = temp(&e, &x.f, fir_env.ty(&e, "holder"));
    fir.place held = fir.place_field(&x.f, fir.place_local(h), 0);
    fir_env.expect(&e, fir.place_type(&x.f, held), "u8 mut* own");
}

fn the_fields_of_a_span_are_its_pointer_and_its_length() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    // `mut` and `own` of the span carry over to field 0.
    fir.place s = fir.place_local(x.span_local);
    fir_env.expect(&e, fir.place_type(&x.f, s), "i32 mut@ own");
    fir_env.expect(&e, fir.place_type(&x.f, fir.place_field(&x.f, s, 0)), "i32 mut* own");
    fir_env.expect(&e, fir.place_type(&x.f, fir.place_field(&x.f, s, 1)), "u64");
    fir.place v = fir.place_local(x.view_local);
    fir_env.expect(&e, fir.place_type(&x.f, fir.place_field(&x.f, v, 0)), "pair*");
    fir_env.expect(&e, fir.place_type(&x.f, fir.place_field(&x.f, v, 1)), "u64");
}

fn the_fields_of_a_string_are_its_pointer_and_its_length() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    fir.place s = fir.place_local(x.str_local);
    fir_env.expect(&e, fir.place_type(&x.f, fir.place_field(&x.f, s, 0)), "char*");
    fir_env.expect(&e, fir.place_type(&x.f, fir.place_field(&x.f, s, 1)), "u64");
    // The `own` of a string carries over to field 0, as it does for a span.
    types.node* owned = types.type_string(fir_env.tt(&e), true);
    fir.place o = fir.place_local(temp(&e, &x.f, owned));
    fir_env.expect(&e, fir.place_type(&x.f, o), "string own");
    fir_env.expect(&e, fir.place_type(&x.f, fir.place_field(&x.f, o, 0)), "char* own");
    fir_env.expect(&e, fir.place_type(&x.f, fir.place_field(&x.f, o, 1)), "u64");
    // An element of a string is a `char` whatever the string owns.
    fir_env.expect(&e, fir.place_type(&x.f, fir.place_index(&x.f, o, x.i)), "char");
}

fn an_element_has_the_element_type() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    // An array: `outer.cells[_i]`.
    fir.place cells = fir.place_field(&x.f, fir.place_local(x.outer_local), 1);
    fir_env.expect(&e, fir.place_type(&x.f, cells), "i32[4]");
    fir_env.expect(&e, fir.place_type(&x.f, fir.place_index(&x.f, cells, x.i)), "i32");
    // A span and a string.
    fir.place span_elem = fir.place_index(&x.f, fir.place_local(x.span_local), x.i);
    fir_env.expect(&e, fir.place_type(&x.f, span_elem), "i32");
    fir.place view_elem = fir.place_index(&x.f, fir.place_local(x.view_local), x.i);
    fir_env.expect(&e, fir.place_type(&x.f, fir.place_field(&x.f, view_elem, 1)), "u64");
    fir.place str_elem = fir.place_index(&x.f, fir.place_local(x.str_local), x.j);
    fir_env.expect(&e, fir.place_type(&x.f, str_elem), "char");
}

fn a_deref_has_the_pointee_type() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    fir.place d = fir.place_deref(&x.f, fir.place_local(x.ptr_local));
    fir_env.expect(&e, fir.place_type(&x.f, d), "pair");
    // `p->b` is `(*p).1`.
    fir_env.expect(&e, fir.place_type(&x.f, fir.place_field(&x.f, d, 1)), "u64");
}

fn a_projection_leaves_its_place_as_it_was() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    fir.place d = fir.place_deref(&x.f, fir.place_local(x.ptr_local));
    fir.place a = fir.place_field(&x.f, d, 0);
    fir.place b = fir.place_field(&x.f, d, 1);
    assert(d.proj_len == 1);
    assert(a.proj_len == 2 && b.proj_len == 2);
    assert(fir.place_projection(&x.f, d, 0).kind == fir.proj_kind.pj_deref);
    assert(fir.place_projection(&x.f, a, 1).field == 0);
    assert(fir.place_projection(&x.f, b, 1).field == 1);
    assert(fir.place_projection(&x.f, b, 0).kind == fir.proj_kind.pj_deref);
    fir.place idx = fir.place_index(&x.f, fir.place_local(x.span_local), x.j);
    assert(fir.place_projection(&x.f, idx, 0).index == x.j);
}

// ---- place_fixed ---------------------------------------------------------------------

fn fixed_storage_is_a_local_reached_without_memory() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    fir.place outer = fir.place_local(x.outer_local);
    assert(fir.place_fixed(&x.f, outer));
    assert(fir.place_fixed(&x.f, fir.place_field(&x.f, outer, 0)));
    fir.place cells = fir.place_field(&x.f, outer, 1);
    assert(fir.place_fixed(&x.f, fir.place_index(&x.f, cells, x.i)));
    // The header fields of a span are in the local; its elements are not.
    fir.place s = fir.place_local(x.span_local);
    assert(fir.place_fixed(&x.f, fir.place_field(&x.f, s, 1)));
    assert(!fir.place_fixed(&x.f, fir.place_index(&x.f, s, x.i)));
    assert(!fir.place_fixed(&x.f, fir.place_index(&x.f, fir.place_local(x.str_local), x.i)));
    assert(!fir.place_fixed(&x.f, fir.place_deref(&x.f, fir.place_local(x.ptr_local))));
    assert(!fir.place_fixed(&x.f, fir.place_global(fir_env.sym(&e, "total"))));
}

// ---- place_compare -------------------------------------------------------------------

fn rel(fixture mut* x, fir.place a, fir.place b) fir.place_rel {
    fir.place_rel r = fir.place_compare(&x->f, a, b);
    // The comparison is symmetric.
    assert(fir.place_compare(&x->f, b, a) == r);
    return r;
}

fn equal_places_have_one_base_and_the_same_projections() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    fir.place outer = fir.place_local(x.outer_local);
    assert(rel(&x, outer, outer) == fir.place_rel.pc_equal);
    // Two places built apart are equal by their parts.
    fir.place a = fir.place_index(&x.f, fir.place_field(&x.f, outer, 1), x.i);
    fir.place b = fir.place_index(&x.f, fir.place_field(&x.f, outer, 1), x.i);
    assert(a.proj_first != b.proj_first);
    assert(rel(&x, a, b) == fir.place_rel.pc_equal);
    // The same global.
    fir.place g = fir.place_global(fir_env.sym(&e, "total"));
    assert(rel(&x, g, g) == fir.place_rel.pc_equal);
}

fn different_local_bases_are_disjoint() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    fir.place a = fir.place_local(x.pair_local);
    fir.place b = fir.place_local(x.other_pair);
    assert(rel(&x, a, b) == fir.place_rel.pc_disjoint);
    assert(rel(&x, fir.place_field(&x.f, a, 0), b) == fir.place_rel.pc_disjoint);
}

fn different_fields_at_one_position_are_disjoint() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    fir.place outer = fir.place_local(x.outer_local);
    fir.place inner = fir.place_field(&x.f, outer, 0);
    fir.place cells = fir.place_field(&x.f, outer, 1);
    assert(rel(&x, inner, cells) == fir.place_rel.pc_disjoint);
    assert(rel(&x, fir.place_field(&x.f, inner, 1), cells) == fir.place_rel.pc_disjoint);
    // One field of a span header against the other.
    fir.place s = fir.place_local(x.span_local);
    assert(rel(&x, fir.place_field(&x.f, s, 0), fir.place_field(&x.f, s, 1))
           == fir.place_rel.pc_disjoint);
}

fn a_place_that_reads_memory_may_overlap_every_place() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    // A span element is never equal to itself and never disjoint from another local.
    fir.place s = fir.place_index(&x.f, fir.place_local(x.span_local), x.i);
    assert(rel(&x, s, s) == fir.place_rel.pc_may_overlap);
    assert(rel(&x, s, fir.place_local(x.pair_local)) == fir.place_rel.pc_may_overlap);
    fir.place c = fir.place_index(&x.f, fir.place_local(x.str_local), x.i);
    assert(rel(&x, c, c) == fir.place_rel.pc_may_overlap);
    // A deref field against a different field of the same deref.
    fir.place d = fir.place_deref(&x.f, fir.place_local(x.ptr_local));
    assert(rel(&x, fir.place_field(&x.f, d, 0), fir.place_field(&x.f, d, 1))
           == fir.place_rel.pc_may_overlap);
    assert(rel(&x, d, fir.place_local(x.pair_local)) == fir.place_rel.pc_may_overlap);
}

// The five examples that spec/fir.md gives for the place comparison.
fn two_elements_by_two_index_locals_may_overlap() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    // `a[_i]` against `a[_j]`: `_i` and `_j` can hold one value.
    fir.place cells = fir.place_field(&x.f, fir.place_local(x.outer_local), 1);
    fir.place ai = fir.place_index(&x.f, cells, x.i);
    fir.place aj = fir.place_index(&x.f, cells, x.j);
    assert(rel(&x, ai, aj) == fir.place_rel.pc_may_overlap);
}

fn a_deref_is_not_equal_to_itself() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    // `(*_p)` against `(*_p)`: the pointer can change between two uses.
    fir.place d = fir.place_deref(&x.f, fir.place_local(x.ptr_local));
    assert(rel(&x, d, d) == fir.place_rel.pc_may_overlap);
}

fn two_fields_of_two_elements_are_disjoint() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    // `_a[_i].0` against `_a[_j].1`, where `_a` is a local `pair[3]`.
    types.node* arr = types.type_array(fir_env.tt(&e), fir_env.ty(&e, "pair"), 3);
    u32 a = temp(&e, &x.f, arr);
    fir.place ai = fir.place_index(&x.f, fir.place_local(a), x.i);
    fir.place aj = fir.place_index(&x.f, fir.place_local(a), x.j);
    fir.place first = fir.place_field(&x.f, ai, 0);
    fir.place second = fir.place_field(&x.f, aj, 1);
    assert(rel(&x, first, second) == fir.place_rel.pc_disjoint);
    // One field of the two elements may overlap.
    assert(rel(&x, first, fir.place_field(&x.f, aj, 0)) == fir.place_rel.pc_may_overlap);
}

fn a_place_and_its_field_may_overlap() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    // `_x` against `_x.0`.
    fir.place p = fir.place_local(x.pair_local);
    assert(rel(&x, p, fir.place_field(&x.f, p, 0)) == fir.place_rel.pc_may_overlap);
}

fn two_globals_may_overlap() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    // The disjoint rule names two local bases, and two globals are not local bases. A global
    // against a local is the same case.
    fir.place total = fir.place_global(fir_env.sym(&e, "total"));
    fir.place limit = fir.place_global(fir_env.sym(&e, "LIMIT"));
    assert(rel(&x, total, limit) == fir.place_rel.pc_may_overlap);
    assert(rel(&x, total, fir.place_local(1)) == fir.place_rel.pc_may_overlap);
}

fn a_global_takes_projections_like_a_local() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    fir.place g = fir.place_global(fir_env.sym(&e, "origin"));
    assert(g.base == fir.base_kind.bk_global);
    assert(g.proj_len == 0);
    fir_env.expect(&e, fir.place_type(&x.f, g), "pair");
    fir_env.expect(&e, fir.place_type(&x.f, fir.place_field(&x.f, g, 1)), "u64");
    // The same global and different field numbers at one position are disjoint.
    fir.place a = fir.place_field(&x.f, g, 0);
    fir.place b = fir.place_field(&x.f, g, 1);
    assert(rel(&x, a, b) == fir.place_rel.pc_disjoint);
    assert(rel(&x, a, fir.place_field(&x.f, g, 0)) == fir.place_rel.pc_equal);
    assert(rel(&x, a, g) == fir.place_rel.pc_may_overlap);
}

fn a_place_with_the_same_parts_in_another_order_is_not_equal() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    types.node* grid = types.type_array(fir_env.tt(&e), fir_env.ty(&e, "outer"), 2);
    u32 a = temp(&e, &x.f, grid);
    // `_a[_i].1[_j]` against `_a[_j].1[_i]`: one field, two index locals swapped.
    fir.place one = fir.place_index(&x.f, fir.place_field(&x.f,
        fir.place_index(&x.f, fir.place_local(a), x.i), 1), x.j);
    fir.place two = fir.place_index(&x.f, fir.place_field(&x.f,
        fir.place_index(&x.f, fir.place_local(a), x.j), 1), x.i);
    fir_env.expect(&e, fir.place_type(&x.f, one), "i32");
    assert(rel(&x, one, two) == fir.place_rel.pc_may_overlap);
    assert(rel(&x, one, one) == fir.place_rel.pc_equal);
    assert(fir.place_fixed(&x.f, one));
    // `_a[_i].0` against `_a[_i].1[_j]`: field 0 and field 1 at one position.
    fir.place inner = fir.place_field(&x.f, fir.place_index(&x.f, fir.place_local(a), x.i), 0);
    assert(rel(&x, inner, one) == fir.place_rel.pc_disjoint);
}

fn an_index_on_a_span_or_string_that_a_projection_reaches_reads_memory() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    // `_v.0[_i]` and `_v.1[_i]`, where `struct viewer { i32@ items; string text; }`.
    fir.place v = fir.place_local(temp(&e, &x.f, fir_env.ty(&e, "viewer")));
    fir.place items = fir.place_field(&x.f, v, 0);
    fir.place text = fir.place_field(&x.f, v, 1);
    fir.place item = fir.place_index(&x.f, items, x.i);
    fir.place ch = fir.place_index(&x.f, text, x.i);
    fir_env.expect(&e, fir.place_type(&x.f, item), "i32");
    fir_env.expect(&e, fir.place_type(&x.f, ch), "char");
    // The two headers are fields of a local; the elements are behind their pointers.
    assert(fir.place_fixed(&x.f, items) && fir.place_fixed(&x.f, text));
    assert(!fir.place_fixed(&x.f, item));
    assert(!fir.place_fixed(&x.f, ch));
    assert(rel(&x, item, item) == fir.place_rel.pc_may_overlap);
    assert(rel(&x, ch, ch) == fir.place_rel.pc_may_overlap);
    // Field 0 against field 1 is disjoint only while no place reads memory.
    assert(rel(&x, items, text) == fir.place_rel.pc_disjoint);
    assert(rel(&x, item, text) == fir.place_rel.pc_may_overlap);
    assert(rel(&x, item, fir.place_local(x.pair_local)) == fir.place_rel.pc_may_overlap);
    // `_a[_i][_j]` over `i32@[2]`: the first index is into the array, the second into a span.
    types.node* spans = types.type_array(fir_env.tt(&e),
        types.type_span(fir_env.tt(&e), fir_env.i32_ty(&e), false, false), 2);
    fir.place a = fir.place_local(temp(&e, &x.f, spans));
    fir.place row = fir.place_index(&x.f, a, x.i);
    fir.place cell = fir.place_index(&x.f, row, x.j);
    fir_env.expect(&e, fir.place_type(&x.f, row), "i32@");
    fir_env.expect(&e, fir.place_type(&x.f, cell), "i32");
    assert(fir.place_fixed(&x.f, row));
    assert(!fir.place_fixed(&x.f, cell));
    assert(rel(&x, row, row) == fir.place_rel.pc_equal);
    assert(rel(&x, cell, cell) == fir.place_rel.pc_may_overlap);
    assert(rel(&x, cell, fir.place_local(x.outer_local)) == fir.place_rel.pc_may_overlap);
}

fn main() i32 {
    a_local_has_the_type_of_the_local();
    a_global_has_the_type_of_its_symbol();
    a_struct_field_has_its_declared_type();
    the_fields_of_a_span_are_its_pointer_and_its_length();
    the_fields_of_a_string_are_its_pointer_and_its_length();
    an_element_has_the_element_type();
    a_deref_has_the_pointee_type();
    a_projection_leaves_its_place_as_it_was();
    fixed_storage_is_a_local_reached_without_memory();
    equal_places_have_one_base_and_the_same_projections();
    different_local_bases_are_disjoint();
    different_fields_at_one_position_are_disjoint();
    a_place_that_reads_memory_may_overlap_every_place();
    two_elements_by_two_index_locals_may_overlap();
    a_deref_is_not_equal_to_itself();
    two_fields_of_two_elements_are_disjoint();
    a_place_and_its_field_may_overlap();
    two_globals_may_overlap();
    a_global_takes_projections_like_a_local();
    a_place_with_the_same_parts_in_another_order_is_not_equal();
    an_index_on_a_span_or_string_that_a_projection_reaches_reads_memory();
    println("ok");
    return 0;
}
