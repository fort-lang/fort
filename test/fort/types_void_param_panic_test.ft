//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: types.type_fn: void or null as a parameter type
//! stdout:
//| 8
import types;
import types_env;

/// No value has type `void`, so it is never a parameter type.
fn main() i32 {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node*[1] mut params = {types.type_void(&e.tt)};
    println(types.type_sizeof(types.type_fn(&e.tt, types.type_void(&e.tt), params[..0], false)));
    println(types.type_sizeof(types.type_fn(&e.tt, types.type_void(&e.tt), params[..], false)));
    return 0;
}
