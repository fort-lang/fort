//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| rows ok
//| shapes ok
//| forms ok
//| ok
import prim;
import runtime_sig;
import std.strbuf;
import types;
import types_env;

// The runtime entry points of src/fort/runtime_sig.ft, held against the table
// of toolchain.md 5.1 row by row.
//
// Why this suite exists. A runtime entry point is described in two places --
// the fort signature in std/rt.ft, which is what defines it, and one row here
// -- and the emitter renders its call sites from the row, so a wrong row is
// wrong code that nothing else catches: `opt -passes=verify` accepts a call
// whose arguments disagree with its callee's definition, and a fort program is
// one module whose caller and callee agree with each other about a convention
// both get wrong (AGENTS.md). test/runtime_sig_test.c reads std/rt.ft with the
// compiler's own front end and pins the C table to it; a `test/fort` program
// runs in a temporary directory holding only itself (toolchain.md 7) and
// cannot open that file, so what is pinned here is the other edge: every row
// against the text of section 5.1, transcribed below, and the map from a fort
// signature to a row that the C suite compares through.
//
// The count is tied to the enum rather than kept beside it: `RT_ENTRY_COUNT`
// is a module constant fort cannot read off `rt_none`, so the equality is
// asserted instead of trusted.

// One row as `<result> @"<name>"(<params>)`, which is the call site the
// emitter writes without its arguments.
fn string rendered(strbuf.str_buf mut* b, runtime_sig.rt_entry rt) {
    strbuf.clear(b);
    strbuf.append(b, runtime_sig.ir_result_text(runtime_sig.rt_entry_result(rt)));
    strbuf.append(b, " @\"");
    strbuf.append(b, runtime_sig.rt_entry_name(rt));
    strbuf.append(b, "\"(");
    u64 mut i = 0;
    while (i < runtime_sig.rt_entry_param_count(rt)) {
        if (i > 0) {
            strbuf.append(b, ", ");
        }
        strbuf.append(b, runtime_sig.ir_param_text(runtime_sig.rt_entry_param(rt, i)));
        i += 1;
    }
    strbuf.push(b, ')');
    if (runtime_sig.rt_entry_noreturn(rt)) {
        strbuf.append(b, " noreturn");
    }
    return strbuf.view(b);
}

fn void want(runtime_sig.rt_entry rt, string text) {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    string got = rendered(&b, rt);
    if (got != text) {
        eprintln("runtime_sig_test: expected <", text, ">, got <", got, ">");
        panic("runtime_sig_test: a row differs from section 5.1");
    }
}

// ---- section 5.1: the signatures ------------------------------------------------------

fn void the_allocation_and_comparison_entry_points_are_the_ones_of_5_1() {
    want(runtime_sig.rt_entry.rt_alloc, "ptr @\"std.rt.alloc\"(i64, i64, ptr, i32, i32)");
    want(runtime_sig.rt_entry.rt_free, "void @\"std.rt.free\"(ptr)");
    // `str_eq` answers a fort `bool`, which is `i1` as a value and `i8` only
    // in memory, and a narrow result carries its extension attribute on both
    // sides of the call (items 2, 7, D9.9).
    want(runtime_sig.rt_entry.rt_str_eq,
         "zeroext i1 @\"std.rt.str_eq\"(ptr, i64, ptr, i64)");
}

fn void every_failure_entry_point_is_the_one_of_5_1() {
    want(runtime_sig.rt_entry.rt_fail_bounds,
         "void @\"std.rt.fail_bounds\"(i64, i64, ptr, i32, i32) noreturn");
    want(runtime_sig.rt_entry.rt_fail_span,
         "void @\"std.rt.fail_span\"(i64, i64, i64, ptr, i32, i32) noreturn");
    want(runtime_sig.rt_entry.rt_fail_overflow,
         "void @\"std.rt.fail_overflow\"(ptr, i32, i32) noreturn");
    want(runtime_sig.rt_entry.rt_fail_shift,
         "void @\"std.rt.fail_shift\"(i64, ptr, ptr, i32, i32) noreturn");
    want(runtime_sig.rt_entry.rt_fail_div_zero,
         "void @\"std.rt.fail_div_zero\"(ptr, i32, i32) noreturn");
    want(runtime_sig.rt_entry.rt_fail_div_overflow,
         "void @\"std.rt.fail_div_overflow\"(ptr, i32, i32) noreturn");
    want(runtime_sig.rt_entry.rt_fail_alloc_count,
         "void @\"std.rt.fail_alloc_count\"(i64, ptr, i32, i32) noreturn");
    want(runtime_sig.rt_entry.rt_fail_overwrite,
         "void @\"std.rt.fail_overwrite\"(ptr, i32, i32) noreturn");
    want(runtime_sig.rt_entry.rt_fail_enum,
         "void @\"std.rt.fail_enum\"(i64, ptr, ptr, i32, i32) noreturn");
    want(runtime_sig.rt_entry.rt_panic,
         "void @\"std.rt.panic\"(ptr, i64, ptr, i32, i32) noreturn");
    want(runtime_sig.rt_entry.rt_assert_fail,
         "void @\"std.rt.assert_fail\"(ptr, ptr, i32, i32) noreturn");
}

fn void every_print_entry_point_is_the_one_of_5_1() {
    want(runtime_sig.rt_entry.rt_print_i64, "void @\"std.rt.print_i64\"(i32, i64)");
    want(runtime_sig.rt_entry.rt_print_u64, "void @\"std.rt.print_u64\"(i32, i64)");
    // The two float printers stand in `std.rt_float`, because a compiler
    // without floats cannot compile them (D18.1).
    want(runtime_sig.rt_entry.rt_print_f32, "void @\"std.rt_float.print_f32\"(i32, float)");
    want(runtime_sig.rt_entry.rt_print_f64, "void @\"std.rt_float.print_f64\"(i32, double)");
    // A `bool` parameter is `i1 zeroext` and a `char` parameter `i8 zeroext`:
    // the two are different forms (item 2, D19.2).
    want(runtime_sig.rt_entry.rt_print_bool, "void @\"std.rt.print_bool\"(i32, i1 zeroext)");
    want(runtime_sig.rt_entry.rt_print_char, "void @\"std.rt.print_char\"(i32, i8 zeroext)");
    want(runtime_sig.rt_entry.rt_print_ptr, "void @\"std.rt.print_ptr\"(i32, ptr)");
    want(runtime_sig.rt_entry.rt_print_str, "void @\"std.rt.print_str\"(i32, ptr, i64)");
    want(runtime_sig.rt_entry.rt_print_enum,
         "void @\"std.rt.print_enum\"(i32, i32, ptr, i64)");
    want(runtime_sig.rt_entry.rt_flush, "void @\"std.rt.flush\"(i32)");
    want(runtime_sig.rt_entry.rt_flush_all, "void @\"std.rt.flush_all\"()");
}

fn void the_startup_entry_points_are_the_ones_of_5_1() {
    want(runtime_sig.rt_entry.rt_args_init, "void @\"std.rt.args_init\"(i32, ptr)");
    // `args` returns a `string@`, an aggregate, so it is a `void` function
    // with the leading hidden result pointer of item 7.
    want(runtime_sig.rt_entry.rt_args, "void @\"std.rt.args\"(ptr)");
    want(runtime_sig.rt_entry.rt_exit, "void @\"std.rt.exit\"(i32) noreturn");
}

fn void no_row_names_a_c_symbol() {
    // A call into the runtime is a fort-to-fort call by the mangled name of
    // D9.7, so no row may hold an unmangled name: that would be a second
    // declaration of an ELF symbol a program may declare itself (D9.8).
    u64 mut i = 0;
    while (i < runtime_sig.RT_ENTRY_COUNT) {
        string name = runtime_sig.rt_entry_name(runtime_sig.rt_at(i));
        assert(str_starts_with(name, "std.rt.") || str_starts_with(name, "std.rt_float."));
        i += 1;
    }
}

fn bool str_starts_with(string s, string prefix) {
    return s.len >= prefix.len && s[0..prefix.len] == prefix;
}

// ---- the rows themselves -----------------------------------------------------------------

fn void the_count_is_the_length_of_the_enum() {
    // The C derives its count from the enum and cannot drift; fort cannot
    // read a module constant off `rt_none`, so the equality is asserted.
    assert(cast(runtime_sig.rt_entry.rt_none, i32) == cast(runtime_sig.RT_ENTRY_COUNT, i32));
}

fn void every_entry_point_is_found_by_its_own_mangled_name() {
    // rt_entry_of is what tells the definition of an entry point from any
    // other fort function when the emitter stamps the attribute group of
    // item 14, so the round trip holds for all of them and for nothing else.
    u64 mut i = 0;
    while (i < runtime_sig.RT_ENTRY_COUNT) {
        runtime_sig.rt_entry rt = runtime_sig.rt_at(i);
        assert(runtime_sig.rt_entry_of(runtime_sig.rt_entry_name(rt)) == rt);
        i += 1;
    }
    // The short name alone is not an entry point, and neither is the C name
    // the runtime used to have (D9.8 as amended).
    assert(runtime_sig.rt_entry_of("std.rt.nope") == runtime_sig.rt_entry.rt_none);
    assert(runtime_sig.rt_entry_of("alloc") == runtime_sig.rt_entry.rt_none);
    assert(runtime_sig.rt_entry_of("main.exit") == runtime_sig.rt_entry.rt_none);
    assert(runtime_sig.rt_entry_of("fort_rt_new") == runtime_sig.rt_entry.rt_none);
    assert(runtime_sig.rt_entry_of("printf") == runtime_sig.rt_entry.rt_none);
    assert(runtime_sig.rt_entry_of("") == runtime_sig.rt_entry.rt_none);
}

fn void an_arity_is_read_off_the_row_and_the_row_ends_at_its_first_gap() {
    // The list ends at the first ir_none, so an arity is never a number kept
    // beside the row.
    assert(runtime_sig.rt_entry_param_count(runtime_sig.rt_entry.rt_flush_all) == 0);
    assert(runtime_sig.rt_entry_param_count(runtime_sig.rt_entry.rt_free) == 1);
    assert(runtime_sig.rt_entry_param_count(runtime_sig.rt_entry.rt_print_str) == 3);
    assert(runtime_sig.rt_entry_param_count(runtime_sig.rt_entry.rt_alloc) == 5);
    // The widest row of section 5.1.
    assert(runtime_sig.rt_entry_param_count(runtime_sig.rt_entry.rt_fail_span) == 6);
    u64 mut i = 0;
    while (i < runtime_sig.RT_ENTRY_COUNT) {
        runtime_sig.rt_entry rt = runtime_sig.rt_at(i);
        u64 n = runtime_sig.rt_entry_param_count(rt);
        assert(n <= runtime_sig.RT_MAX_PARAMS);
        // Every slot up to the arity is a form and every one past it is not.
        u64 mut k = 0;
        while (k < runtime_sig.RT_MAX_PARAMS) {
            bool used = runtime_sig.rt_entry_param(rt, k) != runtime_sig.ir_form.ir_none;
            assert(used == (k < n));
            k += 1;
        }
        i += 1;
    }
}

fn void only_the_rows_5_1_marks_noreturn_are_noreturn() {
    // Every `std.rt.fail_*`, `std.rt.panic`, `std.rt.assert_fail` and
    // `std.rt.exit` is `fn noreturn`, and nothing else is: twelve of the
    // twenty-eight signatures of section 5.1, and they are the definitions
    // that carry the attribute group `#8` of item 14.
    u64 mut noreturns = 0;
    u64 mut i = 0;
    while (i < runtime_sig.RT_ENTRY_COUNT) {
        runtime_sig.rt_entry rt = runtime_sig.rt_at(i);
        if (runtime_sig.rt_entry_noreturn(rt)) {
            noreturns += 1;
        }
        i += 1;
    }
    assert(noreturns == 12);
    assert(runtime_sig.rt_entry_noreturn(runtime_sig.rt_entry.rt_exit));
    assert(runtime_sig.rt_entry_noreturn(runtime_sig.rt_entry.rt_panic));
    assert(!runtime_sig.rt_entry_noreturn(runtime_sig.rt_entry.rt_alloc));
    assert(!runtime_sig.rt_entry_noreturn(runtime_sig.rt_entry.rt_flush));
}

// ---- item 7 and item 8: the form texts ------------------------------------------------------

fn void a_form_carries_its_extension_attribute_in_a_parameter_list() {
    // D9.9: the attribute is part of the form, since a form is a type text
    // and not a type, and `bool` is a form of its own because it is `i1` as a
    // value and `i8` in memory (D19.2).
    expect(runtime_sig.ir_param_text(runtime_sig.ir_form.ir_ptr), "ptr");
    expect(runtime_sig.ir_param_text(runtime_sig.ir_form.ir_bool), "i1 zeroext");
    expect(runtime_sig.ir_param_text(runtime_sig.ir_form.ir_i8), "i8 signext");
    expect(runtime_sig.ir_param_text(runtime_sig.ir_form.ir_u8), "i8 zeroext");
    expect(runtime_sig.ir_param_text(runtime_sig.ir_form.ir_i16), "i16 signext");
    expect(runtime_sig.ir_param_text(runtime_sig.ir_form.ir_u16), "i16 zeroext");
    expect(runtime_sig.ir_param_text(runtime_sig.ir_form.ir_i32), "i32");
    expect(runtime_sig.ir_param_text(runtime_sig.ir_form.ir_i64), "i64");
    expect(runtime_sig.ir_param_text(runtime_sig.ir_form.ir_f32), "float");
    expect(runtime_sig.ir_param_text(runtime_sig.ir_form.ir_f64), "double");
    // A result drops the attribute nowhere: `zeroext i1` leads the callee.
    expect(runtime_sig.ir_result_text(runtime_sig.ir_form.ir_void), "void");
    expect(runtime_sig.ir_result_text(runtime_sig.ir_form.ir_bool), "zeroext i1");
    expect(runtime_sig.ir_result_text(runtime_sig.ir_form.ir_u8), "zeroext i8");
    expect(runtime_sig.ir_result_text(runtime_sig.ir_form.ir_ptr), "ptr");
    expect(runtime_sig.ir_result_text(runtime_sig.ir_form.ir_i64), "i64");
}

// The map from a fort signature to a row, which is what test/runtime_sig_test.c
// compares std/rt.ft through: an aggregate result is the leading `ptr` of
// item 7 on a `void` function, and every other type takes its value form.
fn void a_fort_signature_maps_to_the_row_the_call_site_needs() {
    types_env.env mut te = types_env.env{};
    types_env.init(&te);
    defer types_env.free(&te);
    types.node* i64t = types.type_prim(&te.tt, prim.prim_kind.prim_i64);
    types.node* boolt = types.type_prim(&te.tt, prim.prim_kind.prim_bool);
    types.node* chart = types.type_prim(&te.tt, prim.prim_kind.prim_char);
    types.node* charp = types.type_ptr(&te.tt, chart, false, false);
    // `fn bool str_eq(char* a, u64 a_len, char* b, u64 b_len)`, whose row is
    // the one a wrong result form would make wrong code of.
    types.node*[4] mut params = {charp, i64t, charp, i64t};
    types.node* sig = types.type_fn(&te.tt, boolt, params[..], false);
    runtime_sig.rt_sig got = runtime_sig.rt_signature_of_type("std.rt.str_eq", sig);
    runtime_sig.rt_sig row = runtime_sig.rt_sig_of(runtime_sig.rt_entry.rt_str_eq);
    assert(got.name == row.name);
    assert(got.result == row.result);
    assert(got.is_noreturn == row.is_noreturn);
    assert(got.p0 == row.p0 && got.p1 == row.p1 && got.p2 == row.p2);
    assert(got.p3 == row.p3 && got.p4 == row.p4 && got.p5 == row.p5);
    // `fn string@ args()`: an aggregate result is a `void` function with one
    // leading `ptr` and no parameter of its own (item 7, D9.9).
    types.node* strspan = types.type_string(&te.tt, false);
    types.node*[1] mut spare = {};
    types.node* args_sig = types.type_fn(&te.tt, strspan, spare[0..0], false);
    runtime_sig.rt_sig args_got = runtime_sig.rt_signature_of_type("std.rt.args", args_sig);
    runtime_sig.rt_sig args_row = runtime_sig.rt_sig_of(runtime_sig.rt_entry.rt_args);
    assert(args_got.result == args_row.result);
    assert(args_got.p0 == args_row.p0 && args_got.p1 == args_row.p1);
    // A `noreturn` signature carries the mark the row does (D8.5, item 14).
    types.node* voidt = types.type_void(&te.tt);
    types.node*[1] mut one = {types.type_prim(&te.tt, prim.prim_kind.prim_i32)};
    types.node* exit_sig = types.type_fn(&te.tt, voidt, one[..], true);
    runtime_sig.rt_sig exit_got = runtime_sig.rt_signature_of_type("std.rt.exit", exit_sig);
    assert(exit_got.is_noreturn);
    assert(exit_got.p0 == runtime_sig.ir_form.ir_i32);
}

fn void a_fort_type_maps_to_the_form_the_boundary_gives_it() {
    // Item 8: `u64` and `i64` are `i64`, an enum is `i32`, `char` is C's
    // `unsigned char` (D3.2) and every pointer is `ptr` (D3.10, D3.11).
    assert(runtime_sig.ir_of_prim(prim.prim_kind.prim_u64) == runtime_sig.ir_form.ir_i64);
    assert(runtime_sig.ir_of_prim(prim.prim_kind.prim_i64) == runtime_sig.ir_form.ir_i64);
    assert(runtime_sig.ir_of_prim(prim.prim_kind.prim_char) == runtime_sig.ir_form.ir_u8);
    assert(runtime_sig.ir_of_prim(prim.prim_kind.prim_u8) == runtime_sig.ir_form.ir_u8);
    assert(runtime_sig.ir_of_prim(prim.prim_kind.prim_i8) == runtime_sig.ir_form.ir_i8);
    assert(runtime_sig.ir_of_prim(prim.prim_kind.prim_bool) == runtime_sig.ir_form.ir_bool);
    assert(runtime_sig.ir_of_prim(prim.prim_kind.prim_void) == runtime_sig.ir_form.ir_void);
}

// Holds one text against another, which every assertion of the form texts
// uses; gen_env is not imported here, so the suite carries its own.
fn void expect(string got, string expected) {
    if (got != expected) {
        eprintln("runtime_sig_test: expected <", expected, ">, got <", got, ">");
        panic("runtime_sig_test: a text differs");
    }
}

fn i32 main() {
    the_allocation_and_comparison_entry_points_are_the_ones_of_5_1();
    every_failure_entry_point_is_the_one_of_5_1();
    every_print_entry_point_is_the_one_of_5_1();
    the_startup_entry_points_are_the_ones_of_5_1();
    no_row_names_a_c_symbol();
    the_count_is_the_length_of_the_enum();
    every_entry_point_is_found_by_its_own_mangled_name();
    an_arity_is_read_off_the_row_and_the_row_ends_at_its_first_gap();
    only_the_rows_5_1_marks_noreturn_are_noreturn();
    println("rows ok");
    a_fort_signature_maps_to_the_row_the_call_site_needs();
    println("shapes ok");
    a_form_carries_its_extension_attribute_in_a_parameter_list();
    a_fort_type_maps_to_the_form_the_boundary_gives_it();
    println("forms ok");
    println("ok");
    return 0;
}
