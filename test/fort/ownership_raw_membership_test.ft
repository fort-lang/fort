//! run
//! flags: -I ../../src/fort -I support
//! link: support/ownership_depth_alloc.c
//! stdout:
//| raw membership boundaries ok
/// Tests supported closed membership and unsupported half-open intervals.
import ownership_api;
import ownership_depth_env;
import ownership_raw_facts;
import ownership_raw_facts_env;
import ownership_type_work;

fn unsupported_intervals() void {
    ownership_depth_env.fixture mut f = {};
    ownership_type_work.work mut paid = ownership_raw_facts_env.configure(&f, 65536);
    i64[5] lower = {0, 3, -3, -3, 0};
    i64[5] upper = {0, 1, 0, -1, 4};
    ownership_raw_facts.closed_bound_view[1] bounds = {ownership_raw_facts_env.bound(0, 0, 3)};
    ownership_depth_env.begin();
    ownership_raw_facts.payload_result mut payload = ownership_raw_facts.build_payload(
        ownership_raw_facts.raw_fact_view{.bounds = bounds[..]}, &paid);
    ownership_raw_facts_env.good(&payload);
    u64 mut i = 0;
    while (i < lower.len) {
        paid = ownership_raw_facts_env.configure(&f, 65536);
        ownership_api.predicate_atom[1] mut core = {ownership_raw_facts_env.atom(0,
            ownership_api.predicate_kind.membership, 0, 0, lower[i], upper[i])};
        if (i == 4) { core[0].lower.kind = ownership_api.fact_kind.symbolic; }
        ownership_raw_facts.bound_result converted =
            ownership_raw_facts.core_membership(core[0], &paid);
        assert(ownership_api.successful(converted.proof) && !converted.supported);
        ownership_raw_facts.union_request req = ownership_raw_facts.union_request{
            .core = ownership_raw_facts.core_fact_view{.predicates = core[..]},
            .proposed = payload.payload};
        ownership_raw_facts.union_result mut result =
            ownership_raw_facts.measure_union(&req, &paid);
        ownership_raw_facts_env.counts(&result, 0, 2);
        ownership_raw_facts.free_union_result(&result); i += 1;
    }
    ownership_raw_facts.free_payload(&payload.payload);
    assert(ownership_depth_env.finish() > 0);
}
fn singleton_membership() void {
    ownership_depth_env.fixture mut f = {};
    ownership_type_work.work mut paid = ownership_raw_facts_env.configure(&f, 65536);
    i64[3] lower = {0, 1, 9223372036854775806};
    u64 mut i = 0;
    ownership_depth_env.begin();
    while (i < lower.len) {
        ownership_api.predicate_atom[1] core = {ownership_raw_facts_env.atom(0,
            ownership_api.predicate_kind.membership, 0, 0, lower[i], lower[i] + 1)};
        ownership_raw_facts.closed_bound_view[1] bounds = {
            ownership_raw_facts_env.bound(0, lower[i], lower[i])};
        ownership_raw_facts.bound_result converted =
            ownership_raw_facts.core_membership(core[0], &paid);
        assert(converted.supported && converted.bound.lower.magnitude == cast(lower[i], u64));
        assert(converted.bound.upper.magnitude == cast(lower[i], u64));
        ownership_raw_facts.payload_result mut payload = ownership_raw_facts.build_payload(
            ownership_raw_facts.raw_fact_view{.bounds = bounds[..]}, &paid);
        ownership_raw_facts_env.good(&payload);
        ownership_raw_facts.union_request req = ownership_raw_facts.union_request{
            .core = ownership_raw_facts.core_fact_view{.predicates = core[..]},
            .proposed = payload.payload};
        ownership_raw_facts.union_result mut result =
            ownership_raw_facts.measure_union(&req, &paid);
        ownership_raw_facts_env.counts(&result, 0, 1);
        ownership_raw_facts.free_union_result(&result);
    ownership_raw_facts.free_payload(&payload.payload);
        i += 1;
    }
    assert(ownership_depth_env.finish() > 0);
}
fn signed_raw_bounds() void {
    ownership_depth_env.fixture mut f = {};
    ownership_type_work.work mut paid = ownership_raw_facts_env.configure(&f, 65536);
    ownership_raw_facts.closed_bound_view[3] mut bounds = {
        ownership_raw_facts_env.bound(0, -3, -3), ownership_raw_facts_env.bound(0, -3, 0),
        ownership_raw_facts_env.bound(0, 0, 0)};
    bounds[2].lower.negative = true; bounds[2].upper.negative = true;
    ownership_depth_env.begin();
    ownership_raw_facts.payload_result mut payload = ownership_raw_facts.build_payload(
        ownership_raw_facts.raw_fact_view{.bounds = bounds[..]}, &paid);
    ownership_raw_facts_env.good(&payload);
    assert(!payload.payload->bounds[2].lower.negative &&
        !payload.payload->bounds[2].upper.negative);
    ownership_raw_facts.union_request req = ownership_raw_facts.union_request{
        .proposed = payload.payload};
    ownership_raw_facts.union_result mut result = ownership_raw_facts.measure_union(&req, &paid);
    ownership_raw_facts_env.counts(&result, 0, 3);
    ownership_raw_facts.free_union_result(&result);
    ownership_raw_facts.free_payload(&payload.payload);
    bounds[0] = ownership_raw_facts_env.bound(0, -1, -3);
    payload = ownership_raw_facts.build_payload(ownership_raw_facts.raw_fact_view{
        .bounds = bounds[..1]}, &paid);
    ownership_raw_facts_env.refused(payload.proof, ownership_api.incomplete_reason.invalid_input);
    assert(payload.payload == null);
    assert(ownership_depth_env.finish() > 0);
}
fn main() i32 {
    unsupported_intervals(); singleton_membership(); signed_raw_bounds();
    println("raw membership boundaries ok"); return 0;
}
