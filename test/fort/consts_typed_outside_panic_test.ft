//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: consts: typed constant folding on a value outside its type
//! stdout:
//| true
import consts;
import prim;

/// Checks that typed folding rejects an operand outside its stated type. Such a value is a
/// checker bug, not a program error.
fn main() i32 {
    consts.cval mut r = consts.cv_none();
    println(consts.cv_typed_and(consts.cv_from_i64(255), consts.cv_from_i64(5),
                                prim.prim_kind.prim_u8, &r));
    println(consts.cv_typed_and(consts.cv_from_i64(-1), consts.cv_from_i64(5),
                                prim.prim_kind.prim_u8, &r));
    return 0;
}
