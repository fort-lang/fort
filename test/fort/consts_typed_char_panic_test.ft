//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: consts: integer folding on a non-integer type
//! stdout:
//| true
import consts;
import prim;

// The typed folding of D4.6 runs on an integer type; `char` has no arithmetic
// at all (D3.2), so a fold asked for at that type is a broken precondition
// (D13.3).
fn i32 main() {
    consts.cval mut r = consts.cv_none();
    println(consts.cv_typed_add(consts.cv_from_i64(1), consts.cv_from_i64(2),
                                prim.prim_kind.prim_i32, &r));
    println(consts.cv_typed_add(consts.cv_from_i64(1), consts.cv_from_i64(2),
                                prim.prim_kind.prim_char, &r));
    return 0;
}
