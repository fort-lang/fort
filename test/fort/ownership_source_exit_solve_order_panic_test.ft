//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: ownership_source_exit: invalid solve order
//! stdout:
//| true
/// solve runs once, after prepare. A context that solve already ran on breaks that order, so a
/// second call panics before it reads any statement.
import ownership_source_exit;

fn main() i32 {
    ownership_source_exit.context mut c = ownership_source_exit.context{.initialized = true,
        .solved = true};
    println(c.solved);
    ownership_source_exit.solve(&c);
    return 0;
}
