//! stdout:
//| 4607182418800017408
/// The checker asks for the bits of a float constant only where it has typed
/// the value, so another kind there is a broken precondition.
import consts;

fn main() i32 {
    println(consts.cv_float_bits(consts.cv_from_float(0x3FF0000000000000)));
    println(consts.cv_float_bits(consts.cv_from_i64(1)));
    return 0;
}
