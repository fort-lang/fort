fn predicate_bound_keeps_return() void {
    fixture mut f = fixture{};
    init(&f);
    defer close(&f);
    types.table mut* tt = fir_env.tt(&f.environment);
    types.node* boolean = types.type_prim(tt, prim.prim_kind.prim_bool);
    types.node*[2] params = {boolean, boolean};
    types.node* signature = types.type_fn(tt, types.type_void(tt), params[..], false);
    fir.func mut function = fir.func_new(tt, null, signature);
    defer fir.func_free(&function);
    diag.loc where = diag.loc_make("predicate.ft", 70, 4);
    assert(fir.block_new(&function) == 1 && fir.block_new(&function) == 2);
    u32 first = fir.arm_push(&function, consts.cv_from_bool(true), 1);
    fir.block_set_terminator(&function, 0,
        fir.term_switch(fir.operand_copy(fir.place_local(1)), first, 1, 1, where, 0));
    u32 second = fir.arm_push(&function, consts.cv_from_bool(true), 2);
    fir.block_set_terminator(&function, 1,
        fir.term_switch(fir.operand_copy(fir.place_local(2)), second, 1, 2, where, 1));
    fir.block_set_terminator(&function, 2, fir.term_return(where, 2));
    ownership_state.state mut entry = ownership_state.empty();
    defer ownership_state.free(&entry);
    f.limits.p = 1;
    assert(ownership_limits.configure(&f.meter, &f.limits));
    ownership_flow.program mut input = input_of(&f, &function, &entry);
    assert(f.source_files_len == 1);
    f.source_files[0].module = 7;
    f.source_files[0].file = 12;
    ownership_flow.edge_fact[4] edges = {
        ownership_flow.edge_fact{0, 0, id(ownership_api.entity_kind.value, 1), false},
        ownership_flow.edge_fact{0, 1, id(ownership_api.entity_kind.value, 1), true},
        ownership_flow.edge_fact{1, 0, id(ownership_api.entity_kind.value, 2), false},
        ownership_flow.edge_fact{1, 1, id(ownership_api.entity_kind.value, 2), true},
    };
    input.edges = edges[..];
    ownership_flow.analysis mut result = ownership_flow.solve(&input);
    assert(result.failures == 0 && result.normal_returns == 2);
    assert(result.blocks[2].len == 2);
    u64 mut i = 0;
    while (i < result.blocks[2].len) {
        assert(result.blocks[2].paths[i].facts.predicates_len == 1);
        assert(result.blocks[2].paths[i].facts.losses_len == 1);
        ownership_api.lost_fact lost = result.blocks[2].paths[i].facts.losses[0];
        assert(lost.first_source.module == 7 && lost.first_source.file == 12);
        assert(lost.first_source.line == 70);
        i += 1;
    }
    ownership_flow.free(&result);
}

fn call_invalidates_null_fact(u32 variant) void {
    fixture mut f = fixture{};
    string[5] blocks = {
        "bb0: { switch(copy _1) -> [true: bb1, otherwise: bb4]; }",
        "bb1: { _2 = call fn main.add(const i32 1, const i64 2); goto bb2; }",
        "bb2: { switch(copy _1) -> [true: bb3, otherwise: bb3]; }",
        "bb3: { _0 = const i32 0; return; }",
        "bb4: { _0 = const i32 1; return; }",
    };
    fir.func* function = open(&f, "let _2: u64;", blocks[..]);
    defer close(&f);
    ownership_state.state mut entry = ownership_state.empty();
    defer ownership_state.free(&entry);
    ownership_flow.program mut input = input_of(&f, function, &entry);
    ownership_flow.edge_fact[4] edges = {
        ownership_flow.edge_fact{0, 0, id(ownership_api.entity_kind.value, 1), false},
        ownership_flow.edge_fact{0, 1, id(ownership_api.entity_kind.value, 1), true},
        ownership_flow.edge_fact{2, 0, id(ownership_api.entity_kind.value, 1), false},
        ownership_flow.edge_fact{2, 1, id(ownership_api.entity_kind.value, 1), true},
    };
    input.edges = edges[..];
    ownership_flow.step[1] mut steps = {};
    steps[0].kind = ownership_flow.step_kind.call_outcome;
    steps[0].block = 1;
    steps[0].gap = 1;
    steps[0].operation.block = 1;
    steps[0].operation.operation = 1;
    steps[0].outcomes_complete = variant != 3;
    ownership_api.outcome_fact[1] mut outcomes = {};
    outcomes[0].kind = variant == 1 ? ownership_api.outcome_kind.unknown_fort :
        ownership_api.outcome_kind.function_return;
    steps[0].outcomes = outcomes[..];
    if (variant == 0) { steps[0].invalidates = edges[0].value_version; }
    input.steps = steps[..];
    ownership_flow.analysis mut result = ownership_flow.solve(&input);
    assert(result.failures == 0);
    assert(result.normal_returns == (variant == 2 ? cast(2, u64) : cast(3, u64)));
    assert(result.blocks[3].len == (variant == 2 ? cast(1, u64) : cast(2, u64)));
    ownership_flow.free(&result);
}

fn widened_parameter_keeps_obligation() void {
    fixture mut f = fixture{};
    init(&f);
    defer close(&f);
    types.table mut* tt = fir_env.tt(&f.environment);
    types.node* integer = types.type_prim(tt, prim.prim_kind.prim_i32);
    types.node* owner = types.type_ptr(tt, integer, true, true);
    types.node* boolean = types.type_prim(tt, prim.prim_kind.prim_bool);
    types.node*[2] params = {owner, boolean};
    types.node* signature = types.type_fn(tt, types.type_void(tt), params[..], false);
    fir.func mut function = fir.func_new(tt, null, signature);
    defer fir.func_free(&function);
    diag.loc where = diag.loc{};
    assert(fir.block_new(&function) == 1);
    assert(fir.block_new(&function) == 2);
    assert(fir.block_new(&function) == 3);
    u32 first = fir.arm_push(&function, consts.cv_from_bool(true), 1);
    fir.block_set_terminator(&function, 0,
        fir.term_switch(fir.operand_copy(fir.place_local(2)), first, 1, 2, where, 0));
    fir.block_append(&function, 1, fir.stmt_del(fir.place_local(1), where, 1));
    fir.block_set_terminator(&function, 1, fir.term_goto(3, where, 1));
    fir.block_set_terminator(&function, 2, fir.term_goto(3, where, 2));
    fir.block_set_terminator(&function, 3, fir.term_return(where, 3));
    ownership_local_env.env mut e = ownership_local_env.env{};
    ownership_local_env.init(&e);
    defer ownership_local_env.free(&e);
    ownership_local_env.add_stack(&e, 1);
    assert(ownership_api.successful(ownership_local_env.alloc(&e, 1, 1, 101, 1)));
    ownership_flow.step[1] mut steps = {
        local_step(&e, ownership_transfer.action.release, 1, 1, 0, 0),
    };
    steps[0].local.leaves_empty_proved = true;
    f.limits.g = 1;
    ownership_flow.program mut input = input_of(&f, &function, &e.state);
    input.services = &e.service;
    input.steps = steps[..];
    ownership_flow.parameter[1] params_input = {
        ownership_flow.parameter{slot(1).root, id(ownership_api.entity_kind.source, 1)},
    };
    input.parameters = params_input[..];
    ownership_flow.event_binding[1] events = {
        flow_event(ownership_api.operation_position{.block = 3, .terminator = true},
            ownership_api.event_kind.incomplete_proof,
            id(ownership_api.entity_kind.allocation, 1), 1),
    };
    input.events = events[..];
    ownership_flow.analysis mut result = ownership_flow.solve(&input);
    assert(result.blocks[3].widened && result.blocks[3].len == 1);
    assert(result.normal_returns == 1 && result.failures == 1);
    assert(result.first_failure.kind == ownership_api.proof_kind.incomplete);
    assert(result.blocks[3].paths[0].facts.allocations[0].obligation);
    ownership_flow.free(&result);
}

fn widened_optional_parameter_uses_incomplete_evidence() void {
    fixture mut f = fixture{};
    init(&f);
    defer close(&f);
    types.table mut* tt = fir_env.tt(&f.environment);
    types.node* integer = types.type_prim(tt, prim.prim_kind.prim_i32);
    types.node* owner = types.type_ptr(tt, integer, true, true);
    types.node* boolean = types.type_prim(tt, prim.prim_kind.prim_bool);
    types.node*[2] params = {owner, boolean};
    types.node* signature = types.type_fn(tt, types.type_void(tt), params[..], false);
    fir.func mut function = fir.func_new(tt, null, signature);
    defer fir.func_free(&function);
    diag.loc where = diag.loc_make("optional.ft", 43, 5);
    assert(fir.block_new(&function) == 1 && fir.block_new(&function) == 2 &&
        fir.block_new(&function) == 3);
    u32 first = fir.arm_push(&function, consts.cv_from_bool(true), 1);
    fir.block_set_terminator(&function, 0,
        fir.term_switch(fir.operand_copy(fir.place_local(2)), first, 1, 2, where, 0));
    fir.block_append(&function, 1, fir.stmt_del(fir.place_local(1), where, 0));
    types.node* count_type = types.type_prim(tt, prim.prim_kind.prim_u64);
    fir.operand one = fir.operand_const(fir.const_int(count_type, consts.cv_from_u64(1)));
    fir.rvalue allocation_value = fir.rvalue_alloc(&function, integer, one);
    fir.block_append(&function, 1,
        fir.stmt_assign(fir.place_local(1), allocation_value, where, 1));
    fir.block_set_terminator(&function, 1, fir.term_goto(3, where, 2));
    fir.block_set_terminator(&function, 2, fir.term_goto(3, where, 0));
    fir.block_set_terminator(&function, 3, fir.term_return(where, 0));
    ownership_state.state mut entry = ownership_state.empty();
    defer ownership_state.free(&entry);
    ownership_api.source_fact mut storage = ownership_api.source_fact{};
    storage.key = id(ownership_api.entity_kind.source, 1);
    storage.kind = ownership_api.source_kind.stack;
    storage.validity = ownership_api.validity_kind.live;
    ownership_state.append_sources(&entry, storage);
    ownership_api.contents_fact mut empty = ownership_local_env.empty_value();
    empty.place = slot(1);
    ownership_state.append_contents(&entry, empty);
    ownership_local_env.env mut e = ownership_local_env.env{};
    ownership_local_env.init(&e);
    defer ownership_local_env.free(&e);
    ownership_flow.step[1] mut steps = {
        local_step(&e, ownership_transfer.action.allocation, 1, 1, 1, 0),
    };
    steps[0].local.allocation = ownership_local_env.allocation(1, 100, 1, 1);
    steps[0].local.fresh_source = ownership_local_env.source(101,
        ownership_api.source_kind.heap, steps[0].local.allocation.key);
    ownership_api.borrow_relation[1] mut borrow = {
        ownership_local_env.borrow(steps[0].local.fresh_source.key, 1, slot(1)),
    };
    steps[0].local.value = ownership_local_env.reference(1,
        steps[0].local.fresh_source.key, borrow[..]);
    steps[0].local.source_key = steps[0].local.fresh_source.key;
    f.limits.g = 1;
    assert(ownership_limits.configure(&f.meter, &f.limits));
    ownership_events.store mut events = ownership_events.store{};
    defer ownership_events.free(&events);
    assert(ownership_events.bind(&events, &f.limits, &f.services));
    ownership_flow.program mut input = input_of(&f, &function, &entry);
    input.steps = steps[..];
    ownership_flow.parameter[1] parameters = {
        ownership_flow.parameter{slot(1).root, storage.key},
    };
    input.parameters = parameters[..];
    ownership_flow.event_binding[1] bindings = {
        flow_event(ownership_api.operation_position{.block = 3, .terminator = true},
            ownership_api.event_kind.incomplete_proof, steps[0].local.allocation.key, 1),
    };
    input.events = bindings[..];
    ownership_flow.analysis mut result = ownership_flow.solve(&input);
    assert(result.blocks[3].widened && result.blocks[3].len == 1);
    assert(result.blocks[3].paths[0].facts.allocations_len == 1);
    assert(result.blocks[3].paths[0].facts.allocations[0].count.zero);
    assert(result.blocks[3].paths[0].facts.allocations[0].count.one);
    assert(result.failures == 1 && result.normal_returns == 1 && events.len == 1);
    ownership_api.event_descriptor* stored = ownership_events.at(&events, 0);
    assert(stored->kind == ownership_api.event_kind.incomplete_proof);
    assert(stored->evidence == ownership_api.evidence_kind.abstract_possibility);
    assert(stored->reason == ownership_api.incomplete_reason.missing_path);
    diag.sink mut diagnostics = diag.create();
    defer diag.free(&diagnostics);
    ownership_diag.renderer mut render_at = ownership_diag.renderer{};
    ownership_diag.bind(&render_at, &diagnostics, &events, null, null, &f.services);
    ownership_api.event_descriptor[1] items = {*stored};
    ownership_api.diagnostic_request request = ownership_api.diagnostic_request{
        items[..], result.first_failure};
    ownership_api.diagnostic_result rendered = ownership_api.render(&f.services, &request);
    assert(rendered.rendered && diag.count(&diagnostics) == 1);
    assert(diag.record_at(&diagnostics, 0).msg ==
        "cannot prove parameter storage has no live owner");
    ownership_flow.free(&result);
}

fn widened_parameter_borrow_stays_incomplete() void {
    fixture mut f = fixture{};
    init(&f);
    defer close(&f);
    types.table mut* tt = fir_env.tt(&f.environment);
    types.node* integer = types.type_prim(tt, prim.prim_kind.prim_i32);
    types.node* boolean = types.type_prim(tt, prim.prim_kind.prim_bool);
    types.node* borrowed = types.type_ptr(tt, integer, false, false);
    types.node*[3] params = {integer, boolean, borrowed};
    types.node* signature = types.type_fn(tt, borrowed, params[..], false);
    fir.func mut function = fir.func_new(tt, null, signature);
    defer fir.func_free(&function);
    diag.loc where = diag.loc_make("escape.ft", 81, 5);
    assert(fir.block_new(&function) == 1 && fir.block_new(&function) == 2 &&
        fir.block_new(&function) == 3);
    u32 first = fir.arm_push(&function, consts.cv_from_bool(true), 1);
    fir.block_set_terminator(&function, 0,
        fir.term_switch(fir.operand_copy(fir.place_local(2)), first, 1, 2, where, 0));
    fir.rvalue address = fir.rvalue_addr(&function, fir.place_local(1), false);
    fir.block_append(&function, 1,
        fir.stmt_assign(fir.place_local(0), address, where, 0));
    fir.block_set_terminator(&function, 1, fir.term_goto(3, where, 1));
    fir.rvalue caller_value = fir.rvalue_use(&function,
        fir.operand_copy(fir.place_local(3)));
    fir.block_append(&function, 2,
        fir.stmt_assign(fir.place_local(0), caller_value, where, 0));
    fir.block_set_terminator(&function, 2, fir.term_goto(3, where, 1));
    fir.block_set_terminator(&function, 3, fir.term_return(where, 0));
    ownership_state.state mut entry = ownership_state.empty();
    defer ownership_state.free(&entry);
    ownership_api.source_fact mut parameter_source = ownership_api.source_fact{};
    parameter_source.key = id(ownership_api.entity_kind.source, 1);
    parameter_source.kind = ownership_api.source_kind.stack;
    parameter_source.validity = ownership_api.validity_kind.live;
    ownership_state.append_sources(&entry, parameter_source);
    ownership_api.source_fact mut caller_source = ownership_api.source_fact{};
    caller_source.key = id(ownership_api.entity_kind.source, 2);
    caller_source.kind = ownership_api.source_kind.symbolic_caller;
    caller_source.validity = ownership_api.validity_kind.live;
    ownership_state.append_sources(&entry, caller_source);
    ownership_api.borrow_relation[1] caller_borrow = {
        ownership_local_env.borrow(caller_source.key, 2, slot(3)),
    };
    ownership_api.contents_fact mut caller_contents = ownership_local_env.reference(2,
        caller_source.key, caller_borrow[..]);
    caller_contents.place = slot(3);
    ownership_state.append_contents(&entry, caller_contents);
    ownership_local_env.env mut e = ownership_local_env.env{};
    ownership_local_env.init(&e);
    defer ownership_local_env.free(&e);
    ownership_flow.step[2] mut steps = {
        local_step(&e, ownership_transfer.action.address, 1, 1, 0, 0),
        local_step(&e, ownership_transfer.action.copy, 3, 2, 0, 0),
    };
    steps[0].local.destination = slot(0);
    steps[0].local.source_key = parameter_source.key;
    steps[0].local.source_correspondence_proved = true;
    ownership_api.borrow_relation[1] parameter_borrow = {
        ownership_local_env.borrow(parameter_source.key, 1, slot(0)),
    };
    steps[0].local.value = ownership_local_env.reference(1, parameter_source.key,
        parameter_borrow[..]);
    steps[1].local.destination = slot(0);
    f.limits.g = 1;
    assert(ownership_limits.configure(&f.meter, &f.limits));
    ownership_events.store mut events = ownership_events.store{};
    defer ownership_events.free(&events);
    assert(ownership_events.bind(&events, &f.limits, &f.services));
    ownership_flow.program mut input = input_of(&f, &function, &entry);
    assert(f.source_files_len == 1);
    f.source_files[0].module = 7;
    f.source_files[0].file = 13;
    input.steps = steps[..];
    input.result_slot = slot(0).root;
    ownership_flow.parameter[1] parameters = {
        ownership_flow.parameter{slot(1).root, parameter_source.key},
    };
    input.parameters = parameters[..];
    ownership_flow.event_binding[2] bindings = {
        flow_event(ownership_api.operation_position{.block = 3, .terminator = true},
            ownership_api.event_kind.incomplete_proof, ownership_api.entity_id{}, 1),
        flow_event(ownership_api.operation_position{.block = 3, .terminator = true},
            ownership_api.event_kind.incomplete_proof, parameter_source.key, 2),
    };
    input.events = bindings[..];
    ownership_flow.analysis mut result = ownership_flow.solve(&input);
    assert(result.blocks[3].widened && result.blocks[3].len == 1);
    assert(result.normal_returns == 1 && result.failures > 0);
    assert(result.first_failure.kind == ownership_api.proof_kind.incomplete);
    assert(events.len == 2);
    ownership_api.event_descriptor[2] mut items = {};
    u64 mut i = 0;
    bool mut saw_parameter = false;
    while (i < events.len) {
        ownership_api.event_descriptor* stored = ownership_events.at(&events, i);
        assert(stored->kind == ownership_api.event_kind.incomplete_proof);
        assert(stored->evidence == ownership_api.evidence_kind.abstract_possibility);
        assert(stored->source.module == 7 && stored->source.file == 13);
        if (stored->relation.kind == ownership_api.entity_kind.source &&
            stored->relation.ordinal == parameter_source.key.ordinal) {
            saw_parameter = true;
            assert(stored->text == "parameter borrow escape has no complete proof");
        }
        items[i] = *stored;
        i += 1;
    }
    assert(saw_parameter);
    diag.sink mut diagnostics = diag.create();
    defer diag.free(&diagnostics);
    ownership_diag.renderer mut render_at = ownership_diag.renderer{};
    ownership_diag.bind(&render_at, &diagnostics, &events, cast(&input, void mut*),
        ownership_flow.source_filename, &f.services);
    ownership_api.diagnostic_request request = ownership_api.diagnostic_request{
        items[0..events.len], result.first_failure};
    ownership_api.diagnostic_result rendered = ownership_api.render(&f.services, &request);
    assert(rendered.rendered && diag.count(&diagnostics) >= 1);
    i = 0;
    bool mut saw_rendered_parameter = false;
    while (i < diag.count(&diagnostics)) {
        assert(diag.record_at(&diagnostics, i).loc.file == "escape.ft");
        assert(str.starts_with(diag.record_at(&diagnostics, i).msg, "cannot prove"));
        if (diag.record_at(&diagnostics, i).msg ==
            "cannot prove parameter borrow escape has no complete proof") {
            saw_rendered_parameter = true;
        }
        i += 1;
    }
    assert(saw_rendered_parameter);
    ownership_flow.free(&result);
}

fn return_source_map_requires_complete_identity() void {
    fixture mut f = fixture{};
    init(&f);
    defer close(&f);
    types.table mut* tt = fir_env.tt(&f.environment);
    types.node*[1] params = {types.type_void(tt)};
    types.node* signature = types.type_fn(tt, types.type_void(tt), params[0..0], false);
    fir.func mut function = fir.func_new(tt, null, signature);
    defer fir.func_free(&function);
    fir.block_set_terminator(&function, 0,
        fir.term_return(diag.loc_make("mapped.ft", 9, 3), 0));
    ownership_state.state mut entry = ownership_state.empty();
    defer ownership_state.free(&entry);
    ownership_flow.program mut input = input_of(&f, &function, &entry);
    assert(f.source_files_len == 1);
    input.source_files = f.source_files[0..0];
    ownership_flow.analysis mut missing = ownership_flow.solve(&input);
    assert(missing.first_failure.terminal.reason ==
        ownership_api.incomplete_reason.invalid_input);
    ownership_flow.free(&missing);
    input.source_files = f.source_files[0..f.source_files_len];
    f.source_files[0].module = 0;
    f.source_files[0].file = 0;
    f.source_files[1] = ownership_flow.source_file_binding{0, 0, "other.ft"};
    input.source_files = f.source_files[0..2];
    ownership_flow.analysis mut conflict = ownership_flow.solve(&input);
    assert(conflict.first_failure.terminal.reason ==
        ownership_api.incomplete_reason.invalid_input);
    ownership_flow.free(&conflict);
    input.source_files = f.source_files[0..1];
    ownership_flow.analysis mut mapped = ownership_flow.solve(&input);
    assert(mapped.failures == 0 && mapped.normal_returns == 1);
    ownership_flow.free(&mapped);
}

fn return_events_keep_function_identity(u32 module, u32 file, bool unnamed_second) void {
    fixture mut f = fixture{};
    init(&f);
    defer close(&f);
    types.table mut* tt = fir_env.tt(&f.environment);
    types.node* integer = types.type_prim(tt, prim.prim_kind.prim_i32);
    types.node* owner = types.type_ptr(tt, integer, true, true);
    types.node* boolean = types.type_prim(tt, prim.prim_kind.prim_bool);
    types.node*[2] params = {owner, boolean};
    types.node* signature = types.type_fn(tt, types.type_void(tt), params[..], false);
    fir.func mut function = fir.func_new(tt, null, signature);
    defer fir.func_free(&function);
    diag.loc where = diag.loc{};
    assert(fir.block_new(&function) == 1 && fir.block_new(&function) == 2);
    u32 first = fir.arm_push(&function, consts.cv_from_bool(true), 1);
    fir.block_set_terminator(&function, 0,
        fir.term_switch(fir.operand_copy(fir.place_local(2)), first, 1, 2, where, 0));
    fir.block_set_terminator(&function, 1,
        fir.term_return(diag.loc_make("return.ft", 11, 2), 1));
    diag.loc second = unnamed_second ? diag.loc{} : diag.loc_make("return.ft", 12, 4);
    fir.block_set_terminator(&function, 2, fir.term_return(second, 2));
    ownership_state.state mut entry = ownership_state.empty();
    defer ownership_state.free(&entry);
    ownership_api.source_fact mut storage = ownership_api.source_fact{};
    storage.key = id(ownership_api.entity_kind.source, 1);
    storage.kind = ownership_api.source_kind.stack;
    storage.validity = ownership_api.validity_kind.live;
    ownership_state.append_sources(&entry, storage);
    ownership_api.allocation_fact mut allocation = ownership_local_env.allocation(1, 1, 1, 1);
    ownership_state.append_allocations(&entry, allocation);
    ownership_events.store mut events = ownership_events.store{};
    defer ownership_events.free(&events);
    assert(ownership_events.bind(&events, &f.limits, &f.services));
    ownership_flow.program mut input = input_of(&f, &function, &entry);
    input.identity.declaration.module = 3;
    input.identity.declaration.declaration = 4;
    input.identity.instance = 5;
    assert(f.source_files_len == 1);
    f.source_files[0].module = module;
    f.source_files[0].file = file;
    ownership_flow.parameter[1] parameters = {
        ownership_flow.parameter{slot(1).root, storage.key},
    };
    input.parameters = parameters[..];
    ownership_flow.event_binding[2] mut bindings = {
        flow_event(ownership_api.operation_position{.function = input.identity,
            .block = 1, .terminator = true}, ownership_api.event_kind.lost_ownership,
            allocation.key, 1),
        flow_event(ownership_api.operation_position{.function = input.identity,
            .block = 2, .terminator = true}, ownership_api.event_kind.lost_ownership,
            allocation.key, 2),
    };
    bindings[0].key.function = input.identity;
    bindings[1].key.function = input.identity;
    input.events = bindings[..];
    ownership_flow.analysis mut result = ownership_flow.solve(&input);
    assert(result.failures == 2 && result.normal_returns == 2);
    assert(events.len == 2);
    ownership_api.event_descriptor* mut named = ownership_events.at(&events, 0);
    ownership_api.event_descriptor* mut second_event = ownership_events.at(&events, 1);
    if (named->operation.block == 2) {
        named = ownership_events.at(&events, 1);
        second_event = ownership_events.at(&events, 0);
    }
    assert(named->operation.block == 1 && second_event->operation.block == 2);
    assert(named->source.line == 11);
    assert(second_event->source.line == (unnamed_second ? 0 : 12));
    assert(named->source.col == 2 && named->source.end_line == 11 &&
        named->source.end_col == 2);
    assert(second_event->source.col == (unnamed_second ? 0 : 4) &&
        second_event->source.end_line ==
        (unnamed_second ? 0 : 12) &&
        second_event->source.end_col == (unnamed_second ? 0 : 4));
    assert(named->source.module == module && named->source.file == file);
    assert(second_event->source.module == module && second_event->source.file == file);
    assert(named->source.filename_present);
    assert(second_event->source.filename_present == !unnamed_second);
    ownership_api.source_position mut unnamed_copy = named->source;
    unnamed_copy.filename_present = false;
    assert(ownership_keys.source(named->source, unnamed_copy) != 0);
    diag.sink mut diagnostics = diag.create();
    defer diag.free(&diagnostics);
    ownership_diag.renderer mut render_at = ownership_diag.renderer{};
    ownership_diag.bind(&render_at, &diagnostics, &events, cast(&input, void mut*),
        ownership_flow.source_filename, &f.services);
    ownership_api.event_descriptor[2] items = {*named, *second_event};
    ownership_api.diagnostic_request request = ownership_api.diagnostic_request{
        items[..], result.first_failure};
    ownership_api.diagnostic_result rendered = ownership_api.render(&f.services, &request);
    assert(rendered.rendered && diag.count(&diagnostics) == 2);
    u64 named_index = diag.record_at(&diagnostics, 0).loc.line == 11 ? 0 : 1;
    u64 second_index = 1 - named_index;
    assert(diag.record_at(&diagnostics, named_index).loc.file == "return.ft");
    assert(diag.record_at(&diagnostics, second_index).loc.file ==
        (unnamed_second ? "" : "return.ft"));
    assert(diag.record_at(&diagnostics, named_index).loc.line == 11 &&
        diag.record_at(&diagnostics, named_index).loc.col == 2);
    assert(diag.record_at(&diagnostics, second_index).loc.line ==
        (unnamed_second ? 1 : 12) &&
        diag.record_at(&diagnostics, second_index).loc.col ==
        (unnamed_second ? 1 : 4));
    ownership_flow.free(&result);
}

fn delegated_events_keep_return_identity() void {
    fixture mut f = fixture{};
    string[3] blocks = {
        "bb0: { _0 = const i32 0; switch(copy _1) -> [true: bb1, otherwise: bb2]; }",
        "bb1: { return #21:2 s1; }",
        "bb2: { return #22:2 s2; }",
    };
    fir.func* function = open(&f, "", blocks[..]);
    defer close(&f);
    ownership_state.state mut entry = ownership_state.empty();
    defer ownership_state.free(&entry);
    ownership_api.source_fact mut storage = ownership_api.source_fact{};
    storage.key = id(ownership_api.entity_kind.source, 1);
    storage.kind = ownership_api.source_kind.stack;
    storage.validity = ownership_api.validity_kind.live;
    ownership_state.append_sources(&entry, storage);
    f.limits.w = 1;
    assert(ownership_limits.configure(&f.meter, &f.limits));
    ownership_events.store mut events = ownership_events.store{};
    defer ownership_events.free(&events);
    assert(ownership_events.bind(&events, &f.limits, &f.services));
    ownership_flow.program mut input = input_of(&f, function, &entry);
    input.identity.declaration.module = 3;
    input.identity.declaration.declaration = 5;
    input.identity.instance = 7;
    assert(f.source_files_len == 1);
    f.source_files[0].module = 7;
    f.source_files[0].file = 10;
    ownership_flow.step[1] mut steps = {};
    steps[0].kind = ownership_flow.step_kind.invalidate_value;
    steps[0].block = 0;
    steps[0].gap = 0;
    steps[0].operation.function = input.identity;
    input.steps = steps[..];
    ownership_flow.parameter[1] parameters = {
        ownership_flow.parameter{slot(1).root, storage.key},
    };
    input.parameters = parameters[..];
    ownership_flow.event_binding[2] mut bindings = {
        flow_event(ownership_api.operation_position{.function = input.identity,
            .block = 1, .terminator = true},
            ownership_api.event_kind.work_failure, ownership_api.entity_id{}, 1),
        flow_event(ownership_api.operation_position{.function = input.identity,
            .block = 2, .terminator = true},
            ownership_api.event_kind.work_failure, ownership_api.entity_id{}, 2),
    };
    bindings[0].key.function = input.identity;
    bindings[1].key.function = input.identity;
    input.events = bindings[..];
    ownership_flow.analysis mut result = ownership_flow.solve(&input);
    assert(result.failures == 2 && result.normal_returns == 2);
    assert(events.len == 2);
    assert(ownership_events.at(&events, 0)->operation.block == 1);
    assert(ownership_events.at(&events, 1)->operation.block == 2);
    assert(ownership_events.at(&events, 0)->reason ==
        ownership_api.incomplete_reason.work_limit);
    assert(ownership_events.at(&events, 1)->reason ==
        ownership_api.incomplete_reason.work_limit);
    u64 mut i = 0;
    while (i < events.len) {
        ownership_api.event_descriptor* stored = ownership_events.at(&events, i);
        assert(stored->limit.present &&
            stored->limit.category == ownership_api.limit_category.w);
        assert(stored->limit.used == 1 && stored->limit.bound == 1);
        assert(stored->limit.work == ownership_api.work_kind.transfer);
        assert(stored->limit.source.line == stored->source.line);
        assert(stored->source.module == 7 && stored->source.file == 10);
        assert(stored->limit.source.module == 7 && stored->limit.source.file == 10);
        assert(stored->limit.operation.block == stored->operation.block);
        i += 1;
    }
    diag.sink mut diagnostics = diag.create();
    defer diag.free(&diagnostics);
    ownership_diag.renderer mut render_at = ownership_diag.renderer{};
    ownership_diag.bind(&render_at, &diagnostics, &events, cast(&input, void mut*),
        ownership_flow.source_filename, &f.services);
    ownership_api.event_descriptor[2] items = {
        *ownership_events.at(&events, 0), *ownership_events.at(&events, 1),
    };
    ownership_api.diagnostic_request request = ownership_api.diagnostic_request{
        items[..], result.first_failure};
    ownership_api.diagnostic_result rendered = ownership_api.render(&f.services, &request);
    assert(rendered.rendered && diag.count(&diagnostics) == 2 &&
        diag.record_count(&diagnostics) == 4);
    assert(diag.record_at(&diagnostics, 0).msg ==
        "ownership analysis exceeds the transfer-work bound 1");
    assert(diag.record_at(&diagnostics, 1).msg ==
        "1 work units complete; this operation needs another work unit");
    assert(diag.record_at(&diagnostics, 2).msg ==
        "ownership analysis exceeds the transfer-work bound 1");
    assert(diag.record_at(&diagnostics, 3).msg ==
        "1 work units complete; this operation needs another work unit");
    assert(diag.record_at(&diagnostics, 0).loc.file == "flow.fir");
    assert(diag.record_at(&diagnostics, 2).loc.file == "flow.fir");
    ownership_flow.free(&result);
}

fn flow_work_limit(u32 variant) void {
    fixture mut f = fixture{};
    strbuf.str_buf mut body = strbuf.create();
    defer strbuf.free(&body);
    strbuf.append(&body, "bb0: { _2 = const u64 1; ");
    strbuf.append(&body, "_2 = call fn main.add(const i32 1, const i64 2); ");
    strbuf.append(&body, "_0 = const i32 0; return; }");
    string[1] blocks = {strbuf.view(&body)};
    fir.func* function = open(&f, "let _2: u64;", blocks[..]);
    defer close(&f);
    ownership_state.state mut entry = ownership_state.empty();
    defer ownership_state.free(&entry);
    if (variant != 2) { f.limits.w = 1; }
    else { f.limits.w = 2; }
    assert(ownership_limits.configure(&f.meter, &f.limits));
    ownership_flow.program mut input = input_of(&f, function, &entry);
    ownership_flow.step[2] mut steps = {};
    steps[0].kind = ownership_flow.step_kind.invalidate_value;
    steps[0].block = 0;
    steps[0].gap = 0;
    steps[0].operation.operation = 0;
    steps[1].kind = variant == 0 ? ownership_flow.step_kind.invalidate_value :
        ownership_flow.step_kind.call_outcome;
    steps[1].block = 0;
    steps[1].gap = 1;
    steps[1].operation.operation = 1;
    steps[1].source.line = 1;
    ownership_api.outcome_fact[1] outcomes = {
        ownership_api.outcome_fact{.kind = ownership_api.outcome_kind.function_return},
    };
    steps[1].outcomes = outcomes[..];
    steps[1].outcomes_complete = variant != 3;
    input.steps = steps[..];
    ownership_flow.event_binding[1] events = {
        flow_event(steps[1].operation, ownership_api.event_kind.work_failure,
            ownership_api.entity_id{}, 1),
    };
    if (variant != 2) { input.events = events[..]; }
    ownership_flow.analysis mut result = ownership_flow.solve(&input);
    assert(result.failures == (variant == 2 ? cast(0, u64) : cast(1, u64)));
    assert(result.normal_returns == (variant == 2 ? cast(1, u64) : cast(0, u64)));
    if (variant != 2) {
        assert(result.first_failure.terminal.reason ==
            ownership_api.incomplete_reason.work_limit);
        assert(result.first_failure.terminal.limit.category == ownership_api.limit_category.w);
        assert(result.first_failure.terminal.limit.bound == 1);
    }
    ownership_flow.free(&result);
}

fn direct_budget_event_renders_once() void {
    fixture mut f = fixture{};
    string[1] blocks = {
        "bb0: { _2 = const u64 1; _2 = const u64 2; _0 = const i32 0; return; }",
    };
    fir.func* function = open(&f, "let _2: u64;", blocks[..]);
    defer close(&f);
    ownership_state.state mut entry = ownership_state.empty();
    defer ownership_state.free(&entry);
    f.limits.w = 1;
    assert(ownership_limits.configure(&f.meter, &f.limits));
    ownership_events.store mut events = ownership_events.store{};
    defer ownership_events.free(&events);
    assert(ownership_events.bind(&events, &f.limits, &f.services));
    ownership_flow.program mut input = input_of(&f, function, &entry);
    ownership_flow.step[2] mut steps = {};
    steps[0].kind = ownership_flow.step_kind.invalidate_value;
    steps[1].kind = ownership_flow.step_kind.invalidate_value;
    steps[1].gap = 1;
    steps[1].source.line = 50;
    steps[1].source.col = 3;
    steps[1].operation.operation = 1;
    input.steps = steps[..];
    ownership_flow.event_binding[1] bindings = {
        flow_event(steps[1].operation, ownership_api.event_kind.work_failure,
            ownership_api.entity_id{}, 1),
    };
    input.events = bindings[..];
    ownership_flow.analysis mut result = ownership_flow.solve(&input);
    assert(result.failures == 1 && result.normal_returns == 0 && events.len == 1);
    ownership_api.event_descriptor* stored = ownership_events.at(&events, 0);
    assert(stored->kind == ownership_api.event_kind.work_failure);
    assert(stored->limit.present && stored->limit.category == ownership_api.limit_category.w);
    assert(stored->limit.used == 1 && stored->limit.bound == 1);
    assert(stored->limit.work == ownership_api.work_kind.transfer);
    assert(stored->limit.source.line == 50 && stored->source.line == 50);
    ownership_api.event_request duplicate = ownership_api.event_request{
        *stored, result.first_failure};
    assert(ownership_api.record_event(&f.services, &duplicate).retained && events.len == 1);
    diag.sink mut diagnostics = diag.create();
    defer diag.free(&diagnostics);
    ownership_diag.renderer mut render_at = ownership_diag.renderer{};
    ownership_diag.bind(&render_at, &diagnostics, &events, null, null, &f.services);
    ownership_api.event_descriptor[2] items = {*stored, *stored};
    ownership_api.diagnostic_request request = ownership_api.diagnostic_request{
        items[..], result.first_failure};
    ownership_api.diagnostic_result rendered = ownership_api.render(&f.services, &request);
    assert(rendered.rendered && diag.count(&diagnostics) == 1 &&
        diag.record_count(&diagnostics) == 2);
    assert(diag.record_at(&diagnostics, 0).msg ==
        "ownership analysis exceeds the transfer-work bound 1");
    assert(diag.record_at(&diagnostics, 1).msg ==
        "1 work units complete; this operation needs another work unit");
    ownership_flow.free(&result);
}

fn parameter_end_work_limit() void {
    fixture mut f = fixture{};
    init(&f);
    defer close(&f);
    types.table mut* tt = fir_env.tt(&f.environment);
    types.node* integer = types.type_prim(tt, prim.prim_kind.prim_i32);
    types.node*[2] params = {integer, integer};
    types.node* signature = types.type_fn(tt, types.type_void(tt), params[..], false);
    fir.func mut function = fir.func_new(tt, null, signature);
    defer fir.func_free(&function);
    fir.block_set_terminator(&function, 0, fir.term_return(diag.loc{}, 0));
    ownership_state.state mut entry = ownership_state.empty();
    defer ownership_state.free(&entry);
    ownership_api.source_fact mut first = ownership_api.source_fact{};
    first.key = id(ownership_api.entity_kind.source, 1);
    first.kind = ownership_api.source_kind.stack;
    first.validity = ownership_api.validity_kind.live;
    ownership_state.append_sources(&entry, first);
    ownership_api.source_fact mut second = first;
    second.key = id(ownership_api.entity_kind.source, 2);
    ownership_state.append_sources(&entry, second);
    f.limits.w = 1;
    assert(ownership_limits.configure(&f.meter, &f.limits));
    ownership_flow.program mut input = input_of(&f, &function, &entry);
    ownership_flow.parameter[2] parameters = {
        ownership_flow.parameter{slot(1).root, first.key},
        ownership_flow.parameter{slot(2).root, second.key},
    };
    input.parameters = parameters[..];
    ownership_flow.event_binding[1] events = {
        flow_event(ownership_api.operation_position{.terminator = true},
            ownership_api.event_kind.work_failure, ownership_api.entity_id{}, 1),
    };
    input.events = events[..];
    ownership_flow.analysis mut result = ownership_flow.solve(&input);
    assert(result.failures == 1 && result.normal_returns == 1 && f.events == 1);
    assert(result.first_failure.terminal.reason == ownership_api.incomplete_reason.work_limit);
    assert(result.first_failure.terminal.limit.category == ownership_api.limit_category.w);
    ownership_flow.free(&result);
}

fn widening_work_limit() void {
    fixture mut f = fixture{};
    init(&f);
    defer close(&f);
    types.table mut* tt = fir_env.tt(&f.environment);
    types.node* boolean = types.type_prim(tt, prim.prim_kind.prim_bool);
    types.node*[2] params = {boolean, boolean};
    types.node* signature = types.type_fn(tt, types.type_void(tt), params[..], false);
    fir.func mut function = fir.func_new(tt, null, signature);
    defer fir.func_free(&function);
    diag.loc where = diag.loc_make("widen.ft", 60, 4);
    assert(fir.block_new(&function) == 1);
    assert(fir.block_new(&function) == 2);
    assert(fir.block_new(&function) == 3);
    u32 first = fir.arm_push(&function, consts.cv_from_bool(true), 1);
    fir.block_set_terminator(&function, 0,
        fir.term_switch(fir.operand_copy(fir.place_local(1)), first, 1, 2, where, 0));
    fir.block_set_terminator(&function, 1, fir.term_goto(3, where, 1));
    u32 second = fir.arm_push(&function, consts.cv_from_bool(true), 3);
    fir.block_set_terminator(&function, 2,
        fir.term_switch(fir.operand_copy(fir.place_local(2)), second, 1, 3, where, 2));
    fir.block_set_terminator(&function, 3, fir.term_return(where, 3));
    ownership_state.state mut entry = ownership_state.empty();
    defer ownership_state.free(&entry);
    f.limits.g = 1;
    f.limits.w = 1;
    assert(ownership_limits.configure(&f.meter, &f.limits));
    ownership_flow.program mut input = input_of(&f, &function, &entry);
    assert(f.source_files_len == 1);
    f.source_files[0].module = 7;
    f.source_files[0].file = 11;
    ownership_flow.edge_fact[4] edges = {
        ownership_flow.edge_fact{0, 0, id(ownership_api.entity_kind.value, 1), false},
        ownership_flow.edge_fact{0, 1, id(ownership_api.entity_kind.value, 1), true},
        ownership_flow.edge_fact{2, 0, id(ownership_api.entity_kind.value, 2), false},
        ownership_flow.edge_fact{2, 1, id(ownership_api.entity_kind.value, 2), true},
    };
    input.edges = edges[..];
    ownership_flow.event_binding[1] events = {
        flow_event(ownership_api.operation_position{.block = 3, .terminator = true},
            ownership_api.event_kind.work_failure, ownership_api.entity_id{}, 1),
    };
    input.events = events[..];
    ownership_flow.analysis mut result = ownership_flow.solve(&input);
    assert(result.blocks[3].widened);
    assert(result.failures == 1 && result.normal_returns == 0);
    assert(result.first_failure.terminal.reason == ownership_api.incomplete_reason.work_limit);
    assert(result.first_failure.terminal.limit.work == ownership_api.work_kind.widening);
    assert(result.first_failure.terminal.source.module == 7 &&
        result.first_failure.terminal.source.file == 11);
    assert(result.first_failure.terminal.source.line == 60);
    ownership_flow.free(&result);
}

fn repeated_allocation_site(bool retained) void {
    fixture mut f = fixture{};
    strbuf.str_buf mut body = strbuf.create();
    defer strbuf.free(&body);
    string[4] mut blocks = {
        "bb0: { goto bb1; }",
        "bb1: { switch(copy _1) -> [true: bb2, otherwise: bb3]; }",
        "bb2: { _2 = alloc<i32>(const u64 1); del(move _2); goto bb1; }",
        "bb3: { _0 = const i32 0; return; }",
    };
    if (retained) {
        strbuf.append(&body, "bb2: { _2 = alloc<i32>(const u64 1); ");
        strbuf.append(&body, "_3 = copy _2; del(move _2); goto bb1; }");
        blocks[2] = strbuf.view(&body);
    }
    fir.func* function = open(&f,
        "let _2 (x): i32 mut* own; let _3 (view): i32 mut*;", blocks[..]);
    defer close(&f);
    ownership_local_env.env mut e = ownership_local_env.env{};
    ownership_local_env.init(&e);
    defer ownership_local_env.free(&e);
    ownership_local_env.add_stack(&e, 2);
    ownership_api.contents_fact mut empty = ownership_local_env.empty_value();
    empty.place = slot(2);
    ownership_state.append_contents(&e.state, empty);
    ownership_flow.step[3] mut steps = {};
    steps[0] = local_step(&e, ownership_transfer.action.allocation, 2, 2, 0, 0);
    steps[0].local.allocation = ownership_local_env.allocation(1, 100, 2, 1);
    steps[0].local.fresh_source = ownership_local_env.source(101,
        ownership_api.source_kind.heap, steps[0].local.allocation.key);
    ownership_api.borrow_relation[1] mut borrow = {
        ownership_local_env.borrow(steps[0].local.fresh_source.key, 1, slot(2)),
    };
    steps[0].local.value = ownership_local_env.reference(1,
        steps[0].local.fresh_source.key, borrow[..]);
    steps[0].local.source_key = steps[0].local.fresh_source.key;
    if (retained) {
        steps[1] = local_step(&e, ownership_transfer.action.copy, 2, 2, 1, 0);
        steps[1].local.destination = slot(3);
        steps[2] = local_step(&e, ownership_transfer.action.release, 2, 2, 2, 0);
        steps[2].local.leaves_empty_proved = true;
    } else {
        steps[1] = local_step(&e, ownership_transfer.action.release, 2, 2, 1, 0);
        steps[1].local.leaves_empty_proved = true;
    }
    ownership_flow.program mut input = input_of(&f, function, &e.state);
    input.services = &e.service;
    input.steps = retained ? steps[..] : steps[0..2];
    ownership_flow.event_binding[1] events = {
        flow_event(steps[0].operation, ownership_api.event_kind.incomplete_proof,
            steps[0].local.allocation.key, 20),
    };
    if (retained) { input.events = events[..]; }
    ownership_flow.analysis mut result = ownership_flow.solve(&input);
    assert(result.failures == (retained ? cast(1, u64) : cast(0, u64)));
    assert(result.normal_returns >= 2 && result.transfers < 20);
    if (retained) {
        assert(result.first_failure.kind == ownership_api.proof_kind.incomplete);
    } else {
        bool mut release_recorded = false;
        u64 mut i = 0;
        while (i < result.blocks[3].len) {
            ownership_state.state* retired = &result.blocks[3].paths[i].retired;
            if (retired->allocations_len == 1 && retired->sources_len == 1 &&
                retired->allocations[0].history.len > 0 &&
                retired->allocations[0].validity == ownership_api.validity_kind.released) {
                release_recorded = true;
            }
            i += 1;
        }
        assert(release_recorded);
    }
    ownership_flow.free(&result);
}

struct loan_events {
    u64 count;
    string text;
    bool witnessed;
}

fn loan_event(void mut* opaque, ownership_api.event_request* request)
    ownership_api.event_result {
    loan_events mut* events = cast(opaque, loan_events mut*);
    events->count += 1;
    events->text = request->event.text;
    events->witnessed = request->event.witnesses.len == 1 &&
        request->event.witnesses[0].validated;
    if (request->event.reason == ownership_api.incomplete_reason.unknown_effect) {
        strbuf.str_buf mut rendered = strbuf.create();
        ownership_api.event_descriptor item = request->event;
        ownership_diag.message(&rendered, &item);
        assert(strbuf.view(&rendered) == "cannot prove call preserves collection storage");
        strbuf.free(&rendered);
    }
    return ownership_api.event_result{.proof = request->current, .retained = true};
}

// The scenarios use real FIR effects. No synthetic write step supplies the loan proof.
fn loan_case(u32 scenario, u32 variant) void {
    fixture mut f = fixture{};
    init(&f);
    defer close(&f);
    types.table mut* tt = fir_env.tt(&f.environment);
    types.node* integer = types.type_prim(tt, prim.prim_kind.prim_i32);
    types.node* span = types.type_span(tt, integer, false, true);
    types.node* mut collection_type = scenario == 6 ?
        types.type_span(tt, integer, true, true) : span;
    if (scenario == 12) { collection_type = types.type_span(tt, span, false, true); }
    if (scenario == 10) {
        collection_type = types.type_array(tt, types.type_ptr(tt, integer, true, true), 2);
    }
    types.node* pointer = types.type_ptr(tt, collection_type, false, true);
    types.node* owner = types.type_ptr(tt, collection_type, true, true);
    types.node*[3] params = {collection_type, pointer, owner};
    types.node* signature = types.type_fn(tt, types.type_void(tt), params[..], false);
    fir.func mut function = fir.func_new(tt, null, signature);
    defer fir.func_free(&function);
    diag.loc where = diag.loc{};
    assert(fir.local_add(&function, span, fir.local_kind.lk_temp, null, where) == 4);
    types.node* wide = types.type_prim(tt, prim.prim_kind.prim_u64);
    assert(fir.local_add(&function, wide, fir.local_kind.lk_temp, null, where) == 5);
    assert(fir.local_add(&function, types.type_void(tt), fir.local_kind.lk_temp, null, where) == 6);
    assert(fir.local_add(&function, collection_type, fir.local_kind.lk_temp, null, where) == 7);
    ast.sym mut global = ast.sym{.kind = ast.sym_kind.s_global, .name = "values",
        .ty = span, .mut0 = true};
    fir.place mut collection = fir.place_local(1);
    if (scenario == 9) { collection = fir.place_global(&global); }
    if (scenario == 5) { collection = fir.place_deref(&function, fir.place_local(3)); }
    fir.place indirect = fir.place_deref(&function, fir.place_local(2));
    fir.place element = fir.place_index(&function, fir.place_local(1), 5);
    if (scenario == 12) { collection = element; }
    fir.place header_field = fir.place_field(&function, collection, 0);
    ownership_api.projection[1] dereference = {
        ownership_api.projection{.kind = ownership_api.projection_kind.dereference},
    };
    ownership_api.projection[1] mut index = {
        ownership_api.projection{.kind = ownership_api.projection_kind.captured_index,
            .captured_version = id(ownership_api.entity_kind.value, 5)},
    };
    ownership_api.projection[1] field = {
        ownership_api.projection{.kind = ownership_api.projection_kind.field},
    };
    ownership_flow.place_binding[4] mut bindings = {
        ownership_flow.place_binding{.place = indirect, .storage =
            ownership_api.place_path{slot(2).root, dereference[..], false}, .complete = true},
        ownership_flow.place_binding{.place = element, .storage =
            ownership_api.place_path{slot(1).root, index[..], false}, .complete = true},
        ownership_flow.place_binding{.place = header_field, .storage =
            ownership_api.place_path{slot(1).root, field[..], false}, .complete = true},
        ownership_flow.place_binding{.place = collection, .storage =
            ownership_api.place_path{slot(3).root, dereference[..], false}, .complete = true},
    };
    fir.rvalue copied_header = scenario == 10 ?
        fir.rvalue_use(&function, fir.operand_const(fir.const_zero(span))) :
        fir.rvalue_use(&function, fir.operand_copy(collection));
    fir.block_append(&function, 0, fir.stmt_assign(fir.place_local(5),
        fir.rvalue_use(&function, fir.operand_const(fir.const_int(wide, consts.cv_from_u64(0)))),
        where, 1));
    fir.block_append(&function, 0, fir.stmt_assign(fir.place_local(4), copied_header, where, 0));
    if (scenario == 3 && variant == 0) {
        fir.block_append(&function, 0, fir.stmt_assign(fir.place_local(2),
            fir.rvalue_addr(&function, fir.place_local(1), true), where, 2));
    }
    if (scenario == 10) { index[0].kind = ownership_api.projection_kind.fixed_index; }
    if (scenario == 9) {
        bindings[2].global = &global;
        bindings[2].storage.root = slot(50).root;
        bindings[3].global = &global;
        bindings[3].storage = slot(50);
    }
    fir.block_append(&function, 0, fir.stmt_loan_begin(1, collection,
        scenario == 10 ? cast(0, u32) : cast(4, u32), where, 2));
    bool after = (scenario == 2 && variant == 3) || scenario == 8;
    if (after) { fir.block_append(&function, 0, fir.stmt_loan_end(1, where, 3)); }
    u32 position = fir.block_statement_count(&function, 0);
    bool call = scenario <= 2 || scenario == 8 || scenario == 11 || scenario == 12 ||
        (scenario == 5 && variant >= 3) || (scenario == 6 && variant == 1);
    ast.sym callee = ast.sym{.ty = types.type_fn(tt, types.type_void(tt), params[0..0], false)};
    if (call) {
        fir.block_append(&function, 0, fir.stmt_assign(fir.place_local(6),
            fir.rvalue_call_extern(&callee, 0, 0), where, 3));
    } else if (scenario == 3) {
        fir.block_append(&function, 0, fir.stmt_assign(indirect,
            fir.rvalue_use(&function, fir.operand_copy(fir.place_local(4))), where, 3));
    } else if (scenario == 4 || scenario == 9 || scenario == 10) {
        fir.place target = scenario == 9 ? header_field : (variant == 0 ? element :
            (variant == 1 ? fir.place_local(1) : header_field));
        fir.constant value = fir.const_zero(fir.place_type(&function, target));
        fir.block_append(&function, 0, fir.stmt_assign(target,
            fir.rvalue_use(&function, fir.operand_const(value)), where, 3));
    } else if (scenario == 5 || scenario == 7 || scenario == 13) {
        fir.block_append(&function, 0, fir.stmt_del(fir.place_local(3), where, 3));
    } else {
        fir.block_append(&function, 0, fir.stmt_assign(fir.place_local(7),
            fir.rvalue_use(&function, fir.operand_move(fir.place_local(1))), where, 3));
    }
    if (!after) { fir.block_append(&function, 0, fir.stmt_loan_end(1, where, 4)); }
    fir.block_set_terminator(&function, 0, fir.term_return(where, 5));
    if (scenario == 11) {
        assert(fir.block_new(&function) == 1 && fir.block_new(&function) == 2);
        function.blocks.items[2].statements = move(function.blocks.items[0].statements);
        function.blocks.items[2].term = function.blocks.items[0].term;
        function.blocks.items[2].terminated = true;
        function.blocks.items[0].terminated = false;
        fir.block_set_terminator(&function, 0, fir.term_goto(2, where, 0));
        fir.block_append(&function, 1, fir.stmt_loan_begin(1, collection, 7, where, 0));
        fir.block_set_terminator(&function, 1, fir.term_trap(where, 0));
    }
    ownership_state.state mut entry = ownership_state.empty();
    defer ownership_state.free(&entry);
    ownership_api.entity_id allocation = id(ownership_api.entity_kind.allocation, 1);
    ownership_api.entity_id container = id(ownership_api.entity_kind.allocation, 2);
    ownership_api.source_fact mut source = ownership_local_env.source(1,
        ownership_api.source_kind.heap, allocation);
    if (scenario == 7 && variant == 3) {
        source.kind = ownership_api.source_kind.trusted_foreign;
        source.allocation = ownership_api.entity_id{};
    }
    ownership_state.append_sources(&entry, source);
    ownership_api.borrow_relation[1] mut borrow = {
        ownership_local_env.borrow(source.key, 1, slot(4)),
    };
    ownership_api.contents_fact mut header = ownership_local_env.reference(1, source.key,
        borrow[..]);
    header.place = slot(4);
    if (scenario == 7) {
        if (variant == 0) { header.kind = ownership_api.contents_kind.unknown; }
        if (variant == 1) { header.borrows = borrow[0..0]; }
        if (variant == 2) { borrow[0].representation_complete = false; }
    }
    ownership_state.append_contents(&entry, header);
    ownership_api.allocation_fact mut owned = ownership_local_env.allocation(2, 2, 3, 1);
    if ((scenario == 2 && variant == 3) || (scenario == 13 && variant != 2)) {
        owned.obligation = false;
    }
    if (scenario == 13) {
        ownership_api.contents_fact mut empty = ownership_local_env.empty_value();
        empty.place = slot(3);
        if (variant == 1) { empty.span_length.kind = ownership_api.fact_kind.unknown; }
        if (variant == 2) {
            owned.owner.place = ownership_api.place_path{slot(2).root, dereference[..], true};
        }
        ownership_state.append_contents(&entry, empty);
    }
    ownership_state.append_allocations(&entry, owned);
    if (scenario == 5 || scenario == 12) {
        ownership_api.source_fact held = ownership_local_env.source(2,
            ownership_api.source_kind.heap, container);
        ownership_state.append_sources(&entry, held);
        ownership_api.borrow_relation[1] container_borrow = {
            ownership_local_env.borrow(held.key, 2, slot(3)),
        };
        ownership_api.contents_fact mut pointer_value = ownership_local_env.reference(2,
            held.key, container_borrow[..]);
        pointer_value.place = slot(scenario == 12 ? cast(1, u32) : cast(3, u32));
        ownership_state.append_contents(&entry, pointer_value);
    }
    loan_events mut recorded = loan_events{};
    f.services.event_context = cast(&recorded, void mut*);
    f.services.event = loan_event;
    ownership_flow.program mut input = input_of(&f, &function, &entry);
    input.places = bindings[0..3];
    if (scenario == 5) { input.places = bindings[..]; }
    if (scenario == 3 && variant == 2) { input.places = bindings[1..3]; }
    if (scenario == 3 && variant == 3) { bindings[0].function.instance = 9; }
    if (scenario == 3 && variant == 4) { bindings[0].storage.root.ordinal = 99; }
    if (scenario == 3 && variant == 5) { bindings[0].complete = false; }
    if (scenario == 9) {
        input.places = bindings[2..4];
        if (variant == 1) { bindings[2].storage.root = slot(51).root; }
        if (variant == 2) { input.places = bindings[2..3]; }
        if (variant == 3) { bindings[3].complete = false; }
    }
    if (scenario == 5 && variant == 1) { input.places = bindings[0..3]; }
    if (scenario == 5 && variant == 2) { bindings[3].storage.root.ordinal = 99; }
    ownership_api.ordered_effect[2] mut effects = {};
    effects[0].kind = scenario == 6 ? ownership_api.effect_kind.transfer :
        ownership_api.effect_kind.release;
    effects[0].allocation = (variant == 1 || (scenario == 5 && variant == 3) || scenario == 12) ?
        container : (scenario == 5 && variant == 4 ?
        id(ownership_api.entity_kind.allocation, 3) : allocation);
    effects[0].place = slot(1);
    if (scenario == 0) {
        effects[0].kind = (variant == 0 || variant == 4) ? ownership_api.effect_kind.read :
            ownership_api.effect_kind.write;
        if (variant == 1 || variant == 5) { effects[0].place = slot(7); }
        if (variant == 3) { effects[0].place.root.function.instance = 99; }
        if (variant >= 7) {
            effects[0].kind = ownership_api.effect_kind.release;
            effects[0].allocation = variant == 8 ? container : allocation;
        }
        if (variant >= 4) { effects[0].guard = id(ownership_api.entity_kind.predicate, 1); }
        if (variant >= 9) {
            effects[0].guard = ownership_api.entity_id{};
            effects[0].kind = variant == 9 ? ownership_api.effect_kind.write :
                ownership_api.effect_kind.release;
        }
    }
    ownership_api.outcome_fact[1] mut outcomes = {
        ownership_api.outcome_fact{.kind = ownership_api.outcome_kind.function_return,
            .possible_caller_return = true, .effects = effects[0..1]},
    };
    if (scenario == 0 && variant >= 9) {
        outcomes[0].guard = id(ownership_api.entity_kind.predicate, 1);
    }
    if (scenario == 2) {
        outcomes[0].effects = effects[0..0];
        outcomes[0].kind = variant == 2 ? ownership_api.outcome_kind.unresolved_foreign :
            ownership_api.outcome_kind.unknown_fort;
    }
    ownership_flow.step[1] mut steps = {};
    steps[0].block = scenario == 11 ? cast(2, u32) : cast(0, u32);
    steps[0].operation.block = steps[0].block;
    steps[0].gap = position;
    steps[0].operation.operation = position;
    steps[0].kind = ownership_flow.step_kind.call_outcome;
    steps[0].outcomes_complete = !(scenario == 2 && variant == 0);
    steps[0].outcomes = outcomes[..];
    if (call && !(scenario == 2 && variant == 4)) { input.steps = steps[..]; }
    ownership_flow.event_binding[32] mut events = {};
    u32 mut i = 0;
    u32 effect_block = scenario == 11 ? cast(2, u32) : cast(0, u32);
    while (i < fir.block_statement_count(&function, effect_block)) {
        ownership_api.operation_position op = ownership_api.operation_position{
            .block = effect_block, .operation = i};
        events[cast(i * 2, u64)] = flow_event(op, ownership_api.event_kind.invalid_use,
            ownership_api.entity_id{}, i * 2 + 1);
        events[cast(i * 2 + 1, u64)] = flow_event(op, ownership_api.event_kind.incomplete_proof,
            ownership_api.entity_id{}, i * 2 + 2);
        i += 1;
    }
    input.events = events[0..cast(i * 2, u64)];
    bool fails = !((scenario == 0 &&
        (variant < 2 || variant == 4 || variant == 5 || variant == 8)) ||
        (scenario == 1 && variant == 1) ||
        (scenario == 5 && variant == 4) ||
        (scenario == 2 && variant == 3) || (scenario == 4 && variant == 0) || scenario == 8 ||
        (scenario == 13 && variant == 0));
    bool incomplete = (scenario == 2 && variant != 3) ||
        (scenario == 3 && variant != 0) || (scenario == 5 && (variant == 1 || variant == 2)) ||
        scenario == 7 || (scenario == 0 && (variant == 3 || variant == 6 || variant == 7)) ||
        (scenario == 9 && variant != 0) || (scenario == 0 && variant >= 9) || scenario == 13;
    ownership_flow.analysis mut result = ownership_flow.solve(&input);
    if (result.failures != (fails ? cast(1, u64) : cast(0, u64))) {
        eprintln("loan case ", scenario, ":", variant, ": ", result.failures, " ", recorded.text);
    }
    assert(result.failures == (fails ? cast(1, u64) : cast(0, u64)));
    assert(result.normal_returns == (fails ? cast(0, u64) : cast(1, u64)));
    if (fails) {
        assert(recorded.count == 1);
        assert(result.first_failure.kind == (incomplete ? ownership_api.proof_kind.incomplete :
            ownership_api.proof_kind.complete));
        assert(recorded.text == (incomplete ? (scenario == 2 ?
            "call preserves collection storage" : "effect preserves collection storage") :
            "cannot change collection storage during a range loop"));
        assert(recorded.witnessed == !incomplete);
    }
    ownership_flow.free(&result);
}

fn loan_accepts_a_proved_call() void {
    loan_case(0, 0);
    loan_case(0, 1);
    loan_case(0, 2);
    loan_case(0, 3);
    loan_case(0, 4);
    loan_case(0, 5);
    loan_case(0, 6);
    loan_case(0, 7);
    loan_case(0, 8);
    loan_case(0, 9);
    loan_case(0, 10);
}
fn loan_refuses_a_call_that_releases_the_collection() void {
    loan_case(1, 0);
    loan_case(1, 1);
    loan_case(11, 0);
}
fn loan_refuses_an_unknown_call() void {
    loan_case(2, 0);
    loan_case(2, 1);
    loan_case(2, 2);
    loan_case(2, 3);
    loan_case(2, 4);
}
fn loan_alias_through_pointer() void {
    loan_case(3, 0);
    loan_case(3, 1);
    loan_case(3, 2);
    loan_case(3, 3);
    loan_case(3, 4);
    loan_case(3, 5);
}
fn loan_permits_an_element_write() void {
    loan_case(4, 0);
    loan_case(4, 1);
    loan_case(4, 2);
    loan_case(9, 0);
    loan_case(9, 1);
    loan_case(9, 2);
    loan_case(9, 3);
    loan_case(10, 0);
}
fn loan_refuses_containing_storage() void {
    loan_case(5, 0);
    loan_case(5, 1);
    loan_case(5, 2);
    loan_case(5, 3);
    loan_case(5, 4);
    loan_case(12, 0);
}
fn loan_move_of_collection() void {
    loan_case(6, 0);
    loan_case(6, 1);
}
fn loan_unknown_header_release_is_incomplete() void {
    loan_case(7, 0);
    loan_case(7, 1);
    loan_case(7, 2);
    loan_case(7, 3);
}
fn loan_closed_after_return_unwind() void { loan_case(8, 0); }

fn loan_alias_retargeting(u32 variant) void {
    fixture mut f = fixture{};
    init(&f);
    defer close(&f);
    types.table mut* tt = fir_env.tt(&f.environment);
    types.node* span = types.type_span(tt, types.type_prim(tt, prim.prim_kind.prim_i32),
        false, true);
    types.node* pointer = types.type_ptr(tt, span, false, true);
    types.node* indirect_pointer = types.type_ptr(tt, pointer, false, true);
    types.node*[2] params = {span, span};
    fir.func mut function = fir.func_new(tt, null,
        types.type_fn(tt, types.type_void(tt), params[..], false));
    defer fir.func_free(&function);
    diag.loc where = diag.loc{};
    assert(fir.local_add(&function, pointer, fir.local_kind.lk_temp, null, where) == 3);
    assert(fir.local_add(&function, indirect_pointer, fir.local_kind.lk_temp, null, where) == 4);
    assert(fir.local_add(&function, span, fir.local_kind.lk_temp, null, where) == 5);
    assert(fir.local_add(&function, types.type_void(tt), fir.local_kind.lk_temp, null, where) == 6);
    assert(fir.local_add(&function, pointer, fir.local_kind.lk_temp, null, where) == 7);
    fir.place p = fir.place_deref(&function, fir.place_local(3));
    fir.place q = fir.place_deref(&function, fir.place_local(4));
    fir.place collection = variant >= 2 ? p : fir.place_local(1);
    fir.block_append(&function, 0, fir.stmt_assign(fir.place_local(3),
        fir.rvalue_addr(&function, fir.place_local(variant >= 2 ? cast(1, u32) : cast(2, u32)),
            true), where, 0));
    fir.block_append(&function, 0, fir.stmt_assign(fir.place_local(4),
        fir.rvalue_addr(&function, fir.place_local(3), true), where, 1));
    fir.block_append(&function, 0, fir.stmt_assign(fir.place_local(7),
        fir.rvalue_addr(&function, fir.place_local(variant >= 2 ? cast(2, u32) : cast(1, u32)),
            true), where, 2));
    types.node*[2] call_params = {indirect_pointer, pointer};
    ast.sym callee = ast.sym{.ty =
        types.type_fn(tt, types.type_void(tt), call_params[..], false)};
    u32 args = fir.operand_push(&function, fir.operand_copy(fir.place_local(4)));
    assert(fir.operand_push(&function, fir.operand_copy(fir.place_local(7))) == args + 1);
    fir.statement call = fir.stmt_assign(fir.place_local(6),
        fir.rvalue_call_extern(&callee, args, 2), where, 3);
    if (variant == 6) {
        fir.block_append(&function, 0, fir.stmt_assign(q,
            fir.rvalue_addr(&function, fir.place_local(2), true), where, 3));
    } else if (variant >= 2) { fir.block_append(&function, 0, call); }
    fir.block_append(&function, 0, fir.stmt_assign(fir.place_local(5),
        fir.rvalue_use(&function, fir.operand_copy(collection)), where, 4));
    fir.block_append(&function, 0, fir.stmt_loan_begin(1, collection, 5, where, 5));
    u32 effect_at = fir.block_statement_count(&function, 0);
    if (variant == 0) {
        fir.block_append(&function, 0, fir.stmt_assign(q,
            fir.rvalue_addr(&function, fir.place_local(1), true), where, 6));
    } else if (variant == 1) { fir.block_append(&function, 0, call); }
    fir.place changed = variant >= 2 ? fir.place_local(2) : p;
    fir.block_append(&function, 0, fir.stmt_assign(changed,
        fir.rvalue_use(&function, fir.operand_const(fir.const_zero(span))), where, 7));
    fir.block_append(&function, 0, fir.stmt_loan_end(1, where, 8));
    fir.block_set_terminator(&function, 0, fir.term_return(where, 9));
    ownership_state.state mut entry = ownership_state.empty();
    defer ownership_state.free(&entry);
    ownership_flow.program mut input = input_of(&f, &function, &entry);
    ownership_api.projection[1] dereference = {
        ownership_api.projection{.kind = ownership_api.projection_kind.dereference},
    };
    ownership_flow.place_binding[2] bindings = {
        ownership_flow.place_binding{.place = p, .storage =
            ownership_api.place_path{slot(3).root, dereference[..], false}, .complete = true},
        ownership_flow.place_binding{.place = q, .storage =
            ownership_api.place_path{slot(4).root, dereference[..], false}, .complete = true},
    };
    input.places = variant == 6 ? bindings[0..1] : bindings[..];
    ownership_api.ordered_effect[1] effects = {
        ownership_api.ordered_effect{.kind = ownership_api.effect_kind.write,
            .place = variant >= 2 ? slot(3) : bindings[1].storage},
    };
    ownership_api.outcome_fact[1] mut outcomes = {
        ownership_api.outcome_fact{.kind = ownership_api.outcome_kind.function_return,
            .possible_caller_return = true, .effects = effects[..]},
    };
    ownership_flow.step[1] mut steps = {
        ownership_flow.step{.gap = variant >= 2 ? cast(3, u32) : effect_at,
            .kind = ownership_flow.step_kind.call_outcome, .outcomes = outcomes[..],
            .outcomes_complete = true},
    };
    steps[0].operation.operation = steps[0].gap;
    if (variant >= 4) {
        outcomes[0].kind = ownership_api.outcome_kind.unknown_fort;
        outcomes[0].effects = effects[0..0];
        steps[0].outcomes_complete = variant == 5;
    }
    if (variant != 0 && variant != 3 && variant != 6) { input.steps = steps[..]; }
    ownership_flow.event_binding[32] mut events = {};
    u32 mut i = 0;
    while (i < fir.block_statement_count(&function, 0)) {
        ownership_api.operation_position op = ownership_api.operation_position{.operation = i};
        events[cast(i * 2, u64)] = flow_event(op, ownership_api.event_kind.invalid_use,
            ownership_api.entity_id{}, i * 2 + 1);
        events[cast(i * 2 + 1, u64)] = flow_event(op, ownership_api.event_kind.incomplete_proof,
            ownership_api.entity_id{}, i * 2 + 2);
        i += 1;
    }
    input.events = events[0..cast(i * 2, u64)];
    ownership_flow.analysis mut result = ownership_flow.solve(&input);
    assert(result.failures == 1 && result.normal_returns == 0);
    assert(result.first_failure.kind == (variant == 0 ? ownership_api.proof_kind.complete :
        ownership_api.proof_kind.incomplete));
    ownership_flow.free(&result);
}

// Aggregate result storage can alias the caller's protected collection.
fn loan_result_storage(u32 variant) void {
    fixture mut f = {};
    init(&f);
    defer close(&f);
    types.table mut* tt = fir_env.tt(&f.environment);
    types.node* integer = types.type_prim(tt, prim.prim_kind.prim_i32);
    types.node* span = types.type_span(tt, integer, false, true);
    types.node* array = types.type_array(tt, span, 1);
    ast.sym mut record_decl = ast.sym{.kind = ast.sym_kind.s_struct};
    types.node* record_type = types.type_struct(tt, "result", cast(&record_decl, void mut*));
    types.node*[1] fields = {span};
    u64[1] mut offsets = {};
    assert(types.type_layout_begin(record_type));
    assert(types.type_layout_struct(record_type, fields[..], offsets[..]));
    types.node* result_type = variant == 0 ? integer : (variant == 1 ? array :
        (variant == 2 ? span : (variant == 3 ? types.type_string(tt, false) : record_type)));
    types.node*[1] params = {types.type_ptr(tt, array, false, true)};
    fir.func mut function = fir.func_new(tt, null,
        types.type_fn(tt, result_type, params[..], false));
    defer fir.func_free(&function);
    diag.loc where = {};
    assert(fir.local_add(&function, span, fir.local_kind.lk_temp, null, where) == 2);
    types.node* wide = types.type_prim(tt, prim.prim_kind.prim_u64);
    assert(fir.local_add(&function, wide, fir.local_kind.lk_temp, null, where) == 3);
    fir.block_append(&function, 0, fir.stmt_assign(fir.place_local(3),
        fir.rvalue_use(&function, fir.operand_const(fir.const_zero(wide))), where, 0));
    fir.place collection = fir.place_index(&function,
        fir.place_deref(&function, fir.place_local(1)), 3);
    fir.block_append(&function, 0, fir.stmt_assign(fir.place_local(2),
        fir.rvalue_use(&function, fir.operand_copy(collection)), where, 0));
    fir.block_append(&function, 0, fir.stmt_loan_begin(1, collection, 2, where, 1));
    fir.block_append(&function, 0, fir.stmt_assign(fir.place_local(0),
        fir.rvalue_use(&function, fir.operand_const(fir.const_zero(result_type))), where, 2));
    fir.block_append(&function, 0, fir.stmt_loan_end(1, where, 3));
    fir.block_set_terminator(&function, 0, fir.term_return(where, 4));
    ownership_api.projection[2] parts = {
        ownership_api.projection{.kind = ownership_api.projection_kind.dereference},
        ownership_api.projection{.kind = ownership_api.projection_kind.fixed_index,
            .index = ownership_api.scalar_fact{.kind = ownership_api.fact_kind.exact},
            .captured_version = id(ownership_api.entity_kind.value, 3)},
    };
    ownership_flow.place_binding[1] binding = {
        ownership_flow.place_binding{.place = collection, .storage =
            ownership_api.place_path{slot(1).root, parts[..], false}, .complete = true},
    };
    ownership_state.state mut entry = ownership_state.empty();
    defer ownership_state.free(&entry);
    ownership_flow.program mut input = input_of(&f, &function, &entry);
    input.places = binding[..];
    ownership_flow.event_binding[1] events = {
        flow_event(ownership_api.operation_position{.operation = 3},
            ownership_api.event_kind.incomplete_proof, ownership_api.entity_id{}, 1),
    };
    input.events = events[..];
    ownership_flow.analysis mut result = ownership_flow.solve(&input);
    assert(result.failures == (variant != 0 ? cast(1, u64) : cast(0, u64)));
    assert(result.normal_returns == (variant != 0 ? cast(0, u64) : cast(1, u64)));
    if (variant != 0) { assert(result.first_failure.kind == ownership_api.proof_kind.incomplete); }
    ownership_flow.free(&result);
}

fn loan_direct_work_requires_permission() void {
    fixture mut f = fixture{};
    init(&f);
    defer close(&f);
    types.table mut* tt = fir_env.tt(&f.environment);
    types.node* span = types.type_span(tt, types.type_prim(tt, prim.prim_kind.prim_i32),
        false, true);
    types.node*[1] params = {span};
    fir.func mut function = fir.func_new(tt, null,
        types.type_fn(tt, types.type_void(tt), params[..], false));
    defer fir.func_free(&function);
    diag.loc where = diag.loc_make("paid.ft", 21, 3);
    assert(fir.local_add(&function, span, fir.local_kind.lk_temp, null, where) == 2);
    fir.block_append(&function, 0, fir.stmt_assign(fir.place_local(2),
        fir.rvalue_use(&function, fir.operand_copy(fir.place_local(1))), where, 0));
    fir.block_append(&function, 0, fir.stmt_loan_begin(1, fir.place_local(1), 2, where, 1));
    fir.block_append(&function, 0, fir.stmt_assign(fir.place_local(2),
        fir.rvalue_use(&function, fir.operand_copy(fir.place_local(1))), where, 2));
    fir.block_append(&function, 0, fir.stmt_loan_end(1, where, 3));
    fir.block_set_terminator(&function, 0, fir.term_return(where, 4));
    ownership_state.state mut entry = ownership_state.empty();
    defer ownership_state.free(&entry);
    f.limits.w = 1;
    assert(ownership_limits.configure(&f.meter, &f.limits));
    ownership_flow.program mut input = input_of(&f, &function, &entry);
    ownership_flow.event_binding[1] events = {
        flow_event(ownership_api.operation_position{.operation = 2},
            ownership_api.event_kind.work_failure, ownership_api.entity_id{}, 1),
    };
    input.events = events[..];
    ownership_flow.analysis mut result = ownership_flow.solve(&input);
    assert(result.failures == 1 && result.normal_returns == 0);
    assert(result.first_failure.terminal.reason == ownership_api.incomplete_reason.work_limit);
    assert(result.first_failure.terminal.limit.used == 1 && f.meter.used.w == 1);
    assert(result.first_failure.terminal.limit.operation.operation == 2);
    assert(result.first_failure.terminal.limit.source.line == 21);
    assert(result.first_failure.terminal.limit.source.col == 3);
    assert(result.first_failure.terminal.limit.source.filename_present && f.events == 1);
    ownership_flow.free(&result);
}

struct loan_widen_counter {
    ownership_limits.meter mut* meter;
    u64 widenings;
    u64 before_capture;
}

fn loan_widen_budget(void mut* opaque, ownership_api.charge_request* request)
    ownership_api.charge_result {
    loan_widen_counter mut* count = cast(opaque, loan_widen_counter mut*);
    if (request->work == ownership_api.work_kind.widening) {
        count->widenings += 1;
        if (count->widenings == 2) { count->before_capture = count->meter->used.w; }
    }
    return ownership_limits.try_charge(count->meter, request);
}

// A captured-fact work refusal remains incomplete even when the successor aborts.
fn loan_capture_widening_requires_permission() void {
    fixture mut f = {};
    init(&f);
    defer close(&f);
    types.table mut* tt = fir_env.tt(&f.environment);
    types.node* span = types.type_span(tt, types.type_prim(tt, prim.prim_kind.prim_i32),
        false, true);
    types.node*[2] params = {span, types.type_prim(tt, prim.prim_kind.prim_bool)};
    fir.func mut function = fir.func_new(tt, null,
        types.type_fn(tt, types.type_void(tt), params[..], false));
    defer fir.func_free(&function);
    diag.loc where = diag.loc_make("loan-widen.ft", 60, 4);
    assert(fir.local_add(&function, span, fir.local_kind.lk_temp, null, where) == 3);
    assert(fir.block_new(&function) == 1 && fir.block_new(&function) == 2 &&
        fir.block_new(&function) == 3);
    fir.block_append(&function, 0, fir.stmt_assign(fir.place_local(3),
        fir.rvalue_use(&function, fir.operand_copy(fir.place_local(1))), where, 0));
    fir.block_append(&function, 0, fir.stmt_loan_begin(1, fir.place_local(1), 3, where, 1));
    u32 arm = fir.arm_push(&function, consts.cv_from_bool(true), 1);
    fir.block_set_terminator(&function, 0,
        fir.term_switch(fir.operand_copy(fir.place_local(2)), arm, 1, 2, where, 2));
    fir.block_set_terminator(&function, 1, fir.term_goto(3, where, 3));
    fir.block_set_terminator(&function, 2, fir.term_goto(3, where, 4));
    fir.block_set_terminator(&function, 3, fir.term_trap(where, 5));
    ownership_state.state mut entry = ownership_state.empty();
    defer ownership_state.free(&entry);
    f.limits.g = 1;
    assert(ownership_limits.configure(&f.meter, &f.limits));
    loan_widen_counter mut count = loan_widen_counter{.meter = &f.meter};
    f.services.budget_context = cast(&count, void mut*);
    f.services.budget = loan_widen_budget;
    ownership_flow.program mut input = input_of(&f, &function, &entry);
    ownership_flow.edge_fact[2] edges = {
        ownership_flow.edge_fact{0, 0, id(ownership_api.entity_kind.value, 2), false},
        ownership_flow.edge_fact{0, 1, id(ownership_api.entity_kind.value, 2), true},
    };
    input.edges = edges[..];
    ownership_flow.event_binding[1] events = {
        flow_event(ownership_api.operation_position{.block = 3, .terminator = true},
            ownership_api.event_kind.work_failure, ownership_api.entity_id{}, 1),
    };
    input.events = events[..];
    ownership_flow.analysis mut baseline = ownership_flow.solve(&input);
    assert(baseline.failures == 0 && baseline.blocks[3].widened && count.widenings == 2);
    assert(count.before_capture > 0);
    ownership_flow.free(&baseline);
    f.limits.w = count.before_capture;
    assert(ownership_limits.configure(&f.meter, &f.limits));
    count.widenings = 0;
    ownership_flow.analysis mut result = ownership_flow.solve(&input);
    assert(result.failures == 1 && result.normal_returns == 0);
    assert(result.first_failure.terminal.reason == ownership_api.incomplete_reason.work_limit);
    assert(result.first_failure.terminal.limit.work == ownership_api.work_kind.widening);
    assert(result.first_failure.terminal.limit.used == f.limits.w);
    assert(result.first_failure.terminal.limit.operation.block == 3);
    assert(result.first_failure.terminal.limit.source.line == 60);
    assert(f.events == 1 && count.widenings == 2);
    ownership_flow.free(&result);
}

