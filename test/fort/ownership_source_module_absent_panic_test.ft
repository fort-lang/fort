//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: ownership_source: checked module is absent
//! stdout:
//| 0
/// module_key finds the key of a module of the set. The empty set holds no module, so a call
/// for any module breaks that precondition and panics.
import modules;
import ownership_source;

fn main() i32 {
    modules.module_set mut set = modules.create();
    defer modules.free(&set);
    ownership_source.context mut c = ownership_source.context{.modules = &set};
    println(modules.count(&set));
    ownership_source.module_key(&c, null);
    return 0;
}
