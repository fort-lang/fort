//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: check.empty_of: both emptiability bits
//! stdout:
//| true
/// Checks that empty_of refuses a node with both emptiability bits. The
/// checker writes at most one, so two bits mean a broken tree.
import ast;
import check;
import check_env;

fn main() i32 {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    println(check_env.check_decls(&e, "i32 k = 1;\n"));
    ast.node mut* d = check_env.node_in_main(&e, ast.ast_kind.k_var_decl, "k");
    d->b->ann |= check.ANN_LVALUE | check.ANN_EMPTY_READONLY | check.ANN_EMPTY_IMMUTABLE;
    check.empty_of(d->b);
    return 0;
}
