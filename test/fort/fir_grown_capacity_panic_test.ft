//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: fir.blocks_reserve: capacity overflow
//! stdout:
//| 16
/// grown_capacity doubles a capacity and panics with the text of its caller when the double
/// does not fit u64. The test passes U64_MAX with the text of blocks_reserve.
import containers;
import fir;

fn main() i32 {
    println(fir.grown_capacity(8, "fir.blocks_reserve: capacity overflow"));
    fir.grown_capacity(containers.U64_MAX, "fir.blocks_reserve: capacity overflow");
    return 0;
}
