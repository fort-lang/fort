//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: check_stmt.check_module_bodies: the module did not parse
//! stdout:
//| true
/// Checks that check_module_bodies rejects a module that did not parse. Calling it for such a
/// module breaks its precondition and panics.
import check_env;
import check_stmt;
import modules;

fn main() i32 {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    println(check_env.open_module(&e, "fn main() i32 {\n    return 0;\n}\n"));
    // The shape a module that did not parse has, made here rather than
    // waited for: nothing the loader reads leaves a tree behind on purpose.
    modules.module mut* m = check_env.module_mut(&e, "main");
    m->ast = null;
    check_stmt.check_module_bodies(&e.ck, m);
    return 0;
}
