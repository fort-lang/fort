//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: check_stmt.check_module_bodies: the module did not parse
//! stdout:
//| true
import check_env;
import check_stmt;
import modules;

// check_module stops before the bodies of a module that did not parse, so
// check_module_bodies states that precondition rather than walking a null
// tree: a caller that calls it directly on such a module is a violated
// precondition and panics (D13.3, D14.2).
fn i32 main() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    println(check_env.open_module(&e, "fn i32 main() {\n    return 0;\n}\n"));
    // The shape a module that did not parse has, made here rather than
    // waited for: nothing the loader reads leaves a tree behind on purpose.
    modules.module mut* m = cast(check_env.module_at(&e, "main"), modules.module mut*);
    m->ast = null;
    check_stmt.check_module_bodies(&e.ck, m);
    return 0;
}
