// A raw range needs lo <= hi and both bounds inside the window: an empty range at the end
// holds, one byte past the end fails.
fn ranges() void {
    ownership_raw_source_env.closure mut c = ownership_raw_source_env.closure{};
    string[136] lines = {
        "fn range_0_to_1_of_1() u64 {",
        "    u8[1] bytes = {};",
        "    u8* b = cast(&bytes, u8*);",
        "    u64 lower = 0;",
        "    u64 upper = 1;",
        "    u8@ s = b[lower..upper];",
        "    return s.len;",
        "}",
