// A span element needs the alignment of the part that the place reads, not of the whole
// element (memory model 2.8.2). A part has the residue of the element start, because its offset
// in the element is a multiple of its alignment. A whole element, or a part at a residue that
// its alignment rules out, fails on each path. A bounds check that traps before an access ends
// each path, so the misaligned part after it has no witness.
fn element_parts() void {
    ownership_raw_source_env.closure mut c = ownership_raw_source_env.closure{};
    string[61] lines = {
        "struct item { u64 a; u32 x; u32 y; }",
        "struct bitem { u64 a; u8 c; }",
        "struct inner { u64 h; u32[4] arr; }",
        "struct outer { inner[4] rows; }",
        "fn span_part_r4(u64 i) u32 {",
        "    u64[16] words = {};",
        "    u8* b = cast(&words, u8*);",
        "    u8@ w = b[4..128];",
        "    item* q = cast(w.ptr, item*);",
        "    item@ s = q[0..4];",
        "    return s[i].x;",
        "}",
        "fn span_part_const_r4() u32 {",
        "    u64[16] words = {};",
        "    u8* b = cast(&words, u8*);",
        "    u8@ w = b[4..128];",
        "    item* q = cast(w.ptr, item*);",
        "    item@ s = q[0..4];",
        "    return s[2].x;",
        "}",
        "fn span_byte_r1(u64 i) u8 {",
        "    u64[16] words = {};",
        "    u8* b = cast(&words, u8*);",
        "    u8@ w = b[1..128];",
        "    bitem* q = cast(w.ptr, bitem*);",
        "    bitem@ s = q[0..4];",
        "    return s[i].c;",
        "}",
        "fn span_whole_r4(u64 i) u64 {",
        "    u64[16] words = {};",
        "    u8* b = cast(&words, u8*);",
        "    u8@ w = b[4..128];",
        "    item* q = cast(w.ptr, item*);",
        "    item@ s = q[0..4];",
        "    item e = s[i];",
        "    return e.a;",
        "}",
        "fn span_part_r2(u64 i) u32 {",
        "    u64[16] words = {};",
        "    u8* b = cast(&words, u8*);",
        "    u8@ w = b[2..128];",
        "    item* q = cast(w.ptr, item*);",
        "    item@ s = q[0..4];",
        "    return s[i].x;",
        "}",
        "fn span_part_write_r4(u64 i) void {",
        "    u64[16] mut words = {};",
        "    u8 mut* b = cast(&words, u8 mut*);",
        "    u8 mut@ w = b[4..128];",
        "    item mut* q = cast(w.ptr, item mut*);",
        "    item mut@ s = q[0..4];",
        "    s[i].x = 5;",
        "}",
        "fn trap_before_part(u64 i) u32 {",
        "    u64[16] words = {};",
        "    u8* b = cast(&words, u8*);",
        "    u8@ w = b[2..128];",
        "    outer* p = cast(w.ptr, outer*);",
        "    u64 k = 7;",
        "    return p->rows[i].arr[k];",
        "}",
    };
    ownership_raw_source_env.open(&c, lines[..]);
    defer ownership_raw_source_env.close(&c);
    ownership_raw_source_env.proved(&c, "span_part_r4");
    ownership_raw_source_env.proved(&c, "span_part_const_r4");
    ownership_raw_source_env.proved(&c, "span_byte_r1");
    ownership_raw_source_env.violation(&c, "span_whole_r4", "s",
        "element alignment remains unproved", 35);
    ownership_raw_source_env.violation(&c, "span_part_r2", "s",
        "element alignment remains unproved", 44);
    ownership_raw_source_env.proved(&c, "span_part_write_r4");
    ownership_raw_source_env.unproved_at(&c, "trap_before_part", 60);
    ownership_raw_source_env.report(&c, "element parts");
}

fn main() i32 {
    accesses();
    elements();
    ranges();
    element_parts();
    return 0;
}
