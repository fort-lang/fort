//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| accesses ok
//| elements ok
//| ranges ok
//| element parts ok
/// Holds the raw verdicts at the boundaries of windows, alignments and ranges.
import ownership_raw_source_env;
import ownership_source_raw;

// A typed access needs the bytes of its type inside its window, then the alignment of its
// type at the start: the object holds 16 bytes aligned to 8, and the window starts at lo.
