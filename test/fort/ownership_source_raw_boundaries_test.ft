// An element of a span needs the alignment of its type at each element start: the window
// start fixes it, because each element size is a multiple of its alignment.
fn elements() void {
    ownership_raw_source_env.closure mut c = ownership_raw_source_env.closure{};
    string[160] lines = {
        "fn element_u8_at_0() u8 {",
        "    u64[4] words = {1, 2, 3, 4};",
        "    u8* b = cast(&words, u8*);",
        "    u8@ w = b[0..8];",
        "    u8* p = cast(w.ptr, u8*);",
        "    u8@ s = p[0..1];",
        "    return s[0];",
        "}",
        "fn element_u16_at_0() u16 {",
        "    u64[4] words = {1, 2, 3, 4};",
        "    u8* b = cast(&words, u8*);",
        "    u8@ w = b[0..8];",
        "    u16* p = cast(w.ptr, u16*);",
        "    u16@ s = p[0..1];",
        "    return s[0];",
        "}",
        "fn element_u32_at_0() u32 {",
        "    u64[4] words = {1, 2, 3, 4};",
        "    u8* b = cast(&words, u8*);",
        "    u8@ w = b[0..8];",
        "    u32* p = cast(w.ptr, u32*);",
        "    u32@ s = p[0..1];",
        "    return s[0];",
        "}",
        "fn element_u64_at_0() u64 {",
        "    u64[4] words = {1, 2, 3, 4};",
        "    u8* b = cast(&words, u8*);",
        "    u8@ w = b[0..8];",
        "    u64* p = cast(w.ptr, u64*);",
        "    u64@ s = p[0..1];",
        "    return s[0];",
        "}",
        "fn element_u8_at_1() u8 {",
        "    u64[4] words = {1, 2, 3, 4};",
        "    u8* b = cast(&words, u8*);",
        "    u8@ w = b[1..9];",
        "    u8* p = cast(w.ptr, u8*);",
        "    u8@ s = p[0..1];",
        "    return s[0];",
