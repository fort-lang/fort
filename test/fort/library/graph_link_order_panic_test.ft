//! run
//! flags: -I ../../src
//! abort
//! stderr: panic: graph.link_order: the uses form a cycle
//! stdout:
//| ordering
/// The driver orders the libraries only after graph.check found no cycle, so two libraries that
/// use each other are a violated precondition of the link order.
import fort.library.graph;
import std.vec;

fn main() i32 {
    graph.graph mut g = graph.graph{};
    defer graph.free(&g);
    graph.add(&g, "a", "aaaa");
    graph.add_use(&g, "b", "bbbb");
    graph.add(&g, "b", "bbbb");
    graph.add_use(&g, "a", "aaaa");
    vec.int_vec mut order = vec.int_create();
    defer vec.int_free(&order);
    println("ordering");
    graph.link_order(&g, &order);
    return 0;
}
