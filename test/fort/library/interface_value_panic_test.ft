//! run
//! flags: -I ../../src
//! abort
//! stderr: panic: interface.write_value: an initializer that is no constant form
//! stdout:
//| {}
/// The checker accepts a module-level initializer only in the constant forms that write_value
/// writes (D4.6). A call is no such form, so reaching one is a violated precondition.
import fort.ast;
import fort.diag;
import fort.library.interface;
import fort.modules;
import fort.prim;
import std.strbuf;
import fort.types;

fn main() i32 {
    strbuf.str_buf mut out = strbuf.create();
    defer del(out.data);
    types.table mut* own tt = types.table_make();
    defer types.table_drop_made(move(tt));
    types.node* i32_type = types.type_prim(tt, prim.prim_kind.prim_i32);
    // A module set holds the module of the section, and an arena holds the value nodes: a module
    // and a node each own the ones made before them through a chain, and each drop ends its chain.
    modules.module_set mut* own set = modules.make();
    defer modules.drop_made(move(set));
    interface.section mut* own sec = new(interface.section);
    defer interface.section_drop_made(move(sec));
    sec->m = modules.admit(set, "geom.a", "", "", "", false);
    ast.arena mut* own ar = ast.arena_make();
    defer ast.arena_drop_made(move(ar));
    ast.node mut* brace = ast.ast_new(ar, ast.ast_kind.k_brace_init, diag.loc{});
    interface.write_value(sec, types.type_string(tt, false), brace, &out);
    println(strbuf.view(&out));
    ast.node mut* call = ast.ast_new(ar, ast.ast_kind.k_call, diag.loc{});
    interface.write_value(sec, i32_type, call, &out);
    return 0;
}
