//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: interface.write_value: an initializer that is no constant form
//! stdout:
//| {}
/// The checker accepts a module-level initializer only in the constant forms that write_value
/// writes (D4.6). A call is no such form, so reaching one is a violated precondition.
import ast;
import library.interface;
import modules;
import prim;
import std.strbuf;
import types;

fn main() i32 {
    types.table mut tt = types.table{};
    defer types.type_table_free(&tt);
    types.node* i32_type = types.type_prim(&tt, prim.prim_kind.prim_i32);
    modules.module mut m = modules.module{};
    m.path = "geom.a";
    interface.section mut sec = interface.section{};
    sec.m = &m;
    strbuf.str_buf mut out = strbuf.create();
    defer strbuf.free(&out);
    ast.node mut brace = ast.node{};
    brace.kind = ast.ast_kind.k_brace_init;
    interface.write_value(&sec, types.type_string(&tt, false), &brace, &out);
    println(strbuf.view(&out));
    ast.node mut call = ast.node{};
    call.kind = ast.ast_kind.k_call;
    interface.write_value(&sec, i32_type, &call, &out);
    return 0;
}
