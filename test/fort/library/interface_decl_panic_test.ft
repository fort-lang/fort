//! run
//! flags: -I ../../src
//! abort
//! stderr: panic: interface.write_decl: a declaration that did not check
//! stdout:
//| writing
/// The driver writes an interface file only after a check with no error, so each declaration
/// has a symbol that did not fail. A declaration with no symbol is a violated precondition.
import fort.ast;
import fort.library.interface;
import fort.modules;
import std.strbuf;

fn main() i32 {
    modules.module mut m = modules.module{};
    m.path = "geom.a";
    interface.section mut sec = interface.section{};
    sec.m = &m;
    strbuf.str_buf mut out = strbuf.create();
    defer strbuf.free(&out);
    ast.node mut decl = ast.node{};
    decl.kind = ast.ast_kind.k_var_decl;
    decl.name = "A";
    println("writing");
    interface.write_decl(&sec, &decl, &out);
    return 0;
}
