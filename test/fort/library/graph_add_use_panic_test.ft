//! run
//! flags: -I ../../src
//! abort
//! stderr: panic: graph.add_use: no library to add the use to
//! stdout:
//| adding
/// A use belongs to the library that the driver added last, so a use before the first library
/// is a violated precondition.
import fort.library.graph;

fn main() i32 {
    graph.graph mut* own g = graph.make();
    defer graph.drop_made(move(g));
    println("adding");
    graph.add_use(g, "std", "aaaa");
    return 0;
}
