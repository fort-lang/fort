//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: interface.write_scalar: a constant with no value
//! stdout:
//| 7
/// write_value calls write_scalar only for a node whose folded value is not cv_none. A value of
/// no kind is a violated precondition.
import consts;
import library.interface;
import modules;
import prim;
import std.strbuf;
import types;

fn main() i32 {
    types.table mut tt = types.table{};
    defer types.type_table_free(&tt);
    types.node* i32_type = types.type_prim(&tt, prim.prim_kind.prim_i32);
    modules.module mut m = modules.module{};
    m.path = "geom.a";
    interface.section mut sec = interface.section{};
    sec.m = &m;
    strbuf.str_buf mut out = strbuf.create();
    defer strbuf.free(&out);
    interface.write_scalar(&sec, i32_type, consts.cv_from_i64(7), &out);
    println(strbuf.view(&out));
    interface.write_scalar(&sec, i32_type, consts.cv_none(), &out);
    return 0;
}
