//! run
//! flags: -I ../../src
//! abort
//! stderr: panic: interface.write_qualifier: a module that the collection did not record
//! stdout:
//| collecting
/// The collection pass records each module that a type or a value of a section names, and the
/// write pass then finds the binding of each one. A module that the write pass meets and the
/// collection did not record is a violated precondition.
import fort.library.interface;
import fort.modules;
import std.strbuf;

fn main() i32 {
    strbuf.str_buf mut out = strbuf.create();
    defer del(out.data);
    // A module set holds the module of the section: a module owns the modules made before it
    // through a chain, and the drop of the set ends that chain.
    modules.module_set mut* own set = modules.make();
    defer modules.drop_made(move(set));
    interface.section mut* own sec = new(interface.section);
    defer interface.section_drop_made(move(sec));
    sec->m = modules.admit(set, "geom.a", "", "", "", false);
    // the collection pass records the module and writes nothing
    sec->collecting = true;
    interface.write_qualifier(sec, "geom.b", &out);
    println("collecting");
    sec->collecting = false;
    interface.write_qualifier(sec, "geom.c", &out);
    println(strbuf.view(&out));
    return 0;
}
