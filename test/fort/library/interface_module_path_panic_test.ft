//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: interface.module_path: a symbol with no module
//! stdout:
//| geom.a
/// A name that a section qualifies is a module-level declaration, whose owner is the symbol of
/// its module. A symbol with another owner is a violated precondition.
import ast;
import library.interface;

fn main() i32 {
    ast.sym mut module = ast.sym{};
    module.kind = ast.sym_kind.s_module;
    module.name = "geom.a";
    ast.sym mut declared = ast.sym{};
    declared.kind = ast.sym_kind.s_fn;
    declared.owner = &module;
    println(interface.module_path(&declared));
    // a field is owned by its struct and not by a module
    ast.sym mut field = ast.sym{};
    field.kind = ast.sym_kind.s_field;
    field.owner = &declared;
    println(interface.module_path(&field));
    return 0;
}
