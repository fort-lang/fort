//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: types.type_array: array length 0
//! stdout:
//| 4
/// Checks that the type builder rejects a zero-length fixed array. Source checking prevents
/// this broken precondition.
import fort.types;
import types_env;

// The steps of the test, which end in the panic. They read `e` through a pointer, so the use
// rule of `move` and `del` (D17.21) asks no proof of their reads after a call.
fn trigger(types_env.env mut* e) void {
    println(types.type_array(&e->tt, types_env.type_of(e, "i32"), 4)->len);
    println(types.type_array(&e->tt, types_env.type_of(e, "i32"), 0)->len);
}

fn main() i32 {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    trigger(&e);
    return 0;
}
