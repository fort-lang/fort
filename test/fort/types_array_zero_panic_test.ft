//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: types.type_array: array length 0
//! stdout:
//| 4
import types;
import types_env;

// A fixed array has a length greater than 0, which the builder refuses with a
// diagnostic, so a zero reaching the constructor is a broken precondition.
// D3.4, D13.3
fn i32 main() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    println(types.type_array(&e.tt, types_env.type_of(&e, "i32"), 4)->len);
    println(types.type_array(&e.tt, types_env.type_of(&e, "i32"), 0)->len);
    return 0;
}
