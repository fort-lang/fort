//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| ok
import ast;
import check;
import check_env;
import check_stmt;
import scope;
import std.strbuf;
import types;

/// The ownership typing and the annotation invariants of check.ft, over the
/// half of the checker src/fort/check.ft carries.
//
// Two rules here are invisible to every other test. `is_mut` answers whether
// an expression permits assignment. `empty` answers whether `move` or `del`
// can empty it. Using the wrong field can permit an invalid `move` without a
// changed diagnostic for a valid program.
//
// A second check must also clear annotations before it writes them. No normal
// compilation performs this second check. The test first sets each annotation
// bit on a node that needs none. It then checks the node again and verifies
// that all bits are clear.
//
// The expressions are checked by hand through check_env.probe_stmt, since the
// statements of a function body belong to check_stmt.ft and this pass stops
// before them.

// The module the ownership probes are written against: a cell, a holder of an
// owning pointer to one, an owning module-level constant and an owning global,
// and the two indirections, one mutable and one not. fort does not join
// adjacent string literals, so a source of this size is built in a buffer. The
// text is written to a file before open_module returns, so the buffer need not
// outlive the call.
fn open_probe(check_env.env mut* e, string body) bool {
    return open_probe2(e, body, "");
}

// `body` is the probe function and `extra` a declaration after it, which is
// the callee most of the probes need.
fn open_probe2(check_env.env mut* e, string body, string extra) bool {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "struct cell {\n    i32 v;\n}\n");
    strbuf.append(&b, "struct holder {\n    cell mut* own inner;\n}\n");
    strbuf.append(&b, "cell mut* own mine = null;\n");
    strbuf.append(&b, "cell mut* own mut theirs = null;\n");
    strbuf.append(&b, "holder mut hh = {};\n");
    strbuf.append(&b, "holder mut* ph = &hh;\n");
    strbuf.append(&b, "holder* qh = &hh;\n");
    strbuf.append(&b, body);
    strbuf.append(&b, extra);
    strbuf.append(&b, "fn main() i32 {\n    return 0;\n}\n");
    return check_env.open_module(e, strbuf.view(&b));
}

// ---- `empty` is not `is_mut` -------------------------------------------------------

fn an_owning_global_may_be_emptied_and_a_constant_may_not() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(open_probe(&e, "fn probe() void {\n    del(theirs);\n    del(mine);\n}\n"));
    // `theirs` is a `mut` global: its own storage is emptiable.
    check_env.probe_stmt(&e, "probe", 0);
    assert(check_env.errors(&e) == 0);
    // `mine` is a module-level constant: it lives in read-only memory, and
    // that, and not its level-0 mutability, is what refuses the `del`.
    check_env.probe_stmt(&e, "probe", 1);
    assert(check_env.said(&e, "'del' cannot empty a module-level constant"));
}

fn an_owning_constant_is_an_immutable_lvalue_whose_reason_is_read_only_memory() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(open_probe(&e, "fn probe() void {\n    del(mine);\n}\n"));
    check.expr o = check_env.probe_stmt(&e, "probe", 0);
    assert(check_env.said(&e, "read-only memory"));
    // The operand is the `del` call, which yields nothing. What the fields
    // below answer for is the name inside it, read through the same path the
    // checker took.
    check.expr name = check_env.probe_expr(&e,
        check_env.node_find(check_env.body_expr(&e, "probe", 0), ast.ast_kind.k_ident, "mine"));
    assert(name.lvalue);
    // Immutable and read-only are two answers, and the second is the one
    // `move` and `del` ask for.
    assert(!name.is_mut);
    assert(name.empty == check.empty_kind.empty_readonly);
    assert(o.ty != null);
}

fn a_mutable_global_is_emptiable_although_it_is_not_read_only() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(open_probe(&e, "fn probe() void {\n    del(theirs);\n}\n"));
    check.expr name = check_env.probe_expr(&e,
        check_env.node_find(check_env.body_expr(&e, "probe", 0), ast.ast_kind.k_ident, "theirs"));
    assert(name.lvalue && name.is_mut);
    assert(name.empty == check.empty_kind.empty_ok);
}

fn an_immutable_indirection_may_not_be_emptied() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(open_probe(&e, "fn probe() void {\n    del(ph->inner);\n    del(qh->inner);\n}\n"));
    // Level 1 of `ph` is mutable, so what it designates is emptiable. The
    // read-only memory of the constant `ph` stops at the indirection.
    check_env.probe_stmt(&e, "probe", 0);
    assert(check_env.errors(&e) == 0);
    // Level 1 of `qh` is not, so nothing may be taken out of what was only
    // lent.
    check_env.probe_stmt(&e, "probe", 1);
    assert(check_env.said(&e, "'del' cannot empty an immutable indirection"));
}

// ---- what owns an allocation -------------------------------------------------------

fn an_own_reference_and_an_owning_aggregate_own_and_a_view_does_not() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "struct cell {\n    i32 v;\n}\n");
    strbuf.append(&b, "struct holder {\n    cell mut* own inner;\n}\n");
    strbuf.append(&b, "cell mut* own owner = null;\n");
    strbuf.append(&b, "cell mut* view = null;\n");
    strbuf.append(&b, "holder hh = {};\n");
    assert(check_env.check_decls(&e, strbuf.view(&b)));
    assert(check.check_owning(check_env.sym_main(&e, "owner")->ty));
    assert(!check.check_owning(check_env.sym_main(&e, "view")->ty));
    // A struct that holds an `own` reference by value is an owning aggregate,
    // and that is the one answer the layout is asked for.
    assert(check.check_owning(check_env.sym_main(&e, "hh")->ty));
}

fn move_needs_an_owning_lvalue() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(open_probe2(&e, "fn probe() void {\n    sink(move(hh));\n}\n",
        "fn sink(i32 x) void {\n    return;\n}\n"));
    // `hh` is an owning aggregate, so `move` takes it and yields the one
    // universe function with a value: an `own` rvalue of its operand's type,
    // which is not an lvalue and which nothing else could free.
    ast.node mut* call = check_env.body_expr(&e, "probe", 0);
    check.expr o = check_env.probe_expr(&e, ast.ast_child_mut(call, 0));
    assert(check_env.type_text(&e, o.ty) == "holder");
    assert(!o.lvalue);
    assert(check.check_owning(o.ty));
    assert(check_env.errors(&e) == 0);
}

fn move_refuses_a_value_that_owns_nothing() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(open_probe(&e, "fn probe() void {\n    del(move(ph));\n}\n"));
    check_env.probe_stmt(&e, "probe", 0);
    assert(check_env.said(&e, "'move' needs an owning operand, not holder mut*"));
}

fn del_takes_an_owning_reference_and_nothing_else() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(open_probe(&e, "fn probe() void {\n    del(ph);\n    del(hh);\n}\n"));
    check_env.probe_stmt(&e, "probe", 0);
    assert(check_env.said(&e, "'del' needs an owning operand, not holder mut*"));
    check_env.probe_stmt(&e, "probe", 1);
    // An owning aggregate is not a reference: `del` frees an allocation and a
    // struct is not one.
    assert(check_env.said(&e, "'del' takes a reference, not holder"));
}

// ---- owning temporaries ------------------------------------------------------------

fn a_field_of_an_owning_rvalue_would_leak() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(open_probe2(&e, "fn probe() void {\n    sink(new(cell)->v);\n}\n",
        "fn sink(i32 x) void {\n    return;\n}\n"));
    check.expr o = check_env.probe_expr(&e,
        check_env.node_find(check_env.body_expr(&e, "probe", 0), ast.ast_kind.k_arrow, "v"));
    assert(check_env.said(&e, "owning temporary would leak: a field of it leaves no owner"));
    assert(o.ty->kind == types.type_kind.k_error);
}

fn an_owning_rvalue_that_reaches_a_borrowing_context_would_leak() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(open_probe2(&e, "fn probe() void {\n    borrow(new(cell));\n}\n",
        "fn borrow(cell mut* p) void {\n    return;\n}\n"));
    check_env.probe_stmt(&e, "probe", 0);
    assert(check_env.said(&e, "owning temporary would leak: the argument expects cell mut*"));
}

fn copying_an_owning_lvalue_into_an_own_place_requires_move() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(open_probe2(&e, "fn probe() void {\n    take(theirs);\n}\n",
        "fn take(cell mut* own p) void {\n    del(p);\n}\n"));
    check_env.probe_stmt(&e, "probe", 0);
    // Transfer is written, and the hint spells the expression because the
    // operand is a name.
    assert(check_env.said(&e, "copying an owning value requires 'move': write move(theirs)"));
}

fn casting_an_owning_lvalue_to_an_owning_type_requires_move() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "struct cell {\n    i32 v;\n}\n");
    strbuf.append(&b, "struct holder {\n    cell mut* own inner;\n}\n");
    strbuf.append(&b, "holder hh = {};\n");
    strbuf.append(&b, "holder other = cast(hh, holder);\n");
    // A cast is `own` exactly when its target says so, so an owning lvalue
    // reaches an owning target only through `move`. The hint spells the whole
    // expression because the operand is a name.
    assert(!check_env.check_decls(&e, strbuf.view(&b)));
    assert(check_env.said(&e,
        "casting an owning value to an owning type requires 'move': write move(hh)"));
}

fn casting_an_owning_rvalue_to_a_type_that_does_not_own_would_leak() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(open_probe2(&e, "fn probe() void {\n    borrow(cast(new(cell), cell mut*));\n}\n",
                      "fn borrow(cell mut* p) void {\n    return;\n}\n"));
    check_env.probe_stmt(&e, "probe", 0);
    // Nothing could free the temporary once the cast has dropped its `own`.
    assert(check_env.said(&e, "owning temporary would leak: the cast target does not own it"));
}

fn an_owning_lvalue_lends_to_a_borrowing_parameter() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(open_probe2(&e, "fn probe() void {\n    borrow(theirs);\n}\n",
        "fn borrow(cell mut* p) void {\n    return;\n}\n"));
    check_env.probe_stmt(&e, "probe", 0);
    // A target that does not own takes the lend of an owning lvalue.
    assert(check_env.errors(&e) == 0);
}

fn equality_lends_both_operands() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(open_probe2(&e, "fn probe() void {\n    yes(mine == theirs);\n}\n",
        "fn yes(bool b) void {\n    return;\n}\n"));
    check.expr o = check_env.probe_expr(&e,
        check_env.node_find(check_env.body_expr(&e, "probe", 0), ast.ast_kind.k_binary, ""));
    // `own` never blocks a comparison: both operands are lent, so two pointers
    // of one element type compare whatever their ownership.
    assert(check_env.errors(&e) == 0);
    assert(check_env.type_text(&e, o.ty) == "bool");
}

// ---- the arms of the conditional ---------------------------------------------------

// The arms of `?:` lend, so two owning lvalue arms yield a view and the
// conditional owns nothing.
fn the_arms_of_a_conditional_lend() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(open_probe2(&e, "fn probe(bool go) void {\n    borrow(go ? mine : theirs);\n}\n",
        "fn borrow(cell mut* p) void {\n    return;\n}\n"));
    scope.scope mut params = scope.scope{};
    check_env.open_params(&e, &params, "probe");
    check.expr o = check_env.probe_expr(&e,
        check_env.node_find(check_env.body_expr(&e, "probe", 0), ast.ast_kind.k_ternary, ""));
    check_env.close_params(&e, &params);
    assert(check_env.errors(&e) == 0);
    assert(check_env.type_text(&e, o.ty) == "cell mut*");
}

// It yields `own` when both arms are `own` rvalues or `null`, which is the one
// case where the value the conditional produces still has an owner. It is an
// rvalue, so it must land in an `own` place.
fn two_owning_rvalue_arms_yield_an_owning_rvalue() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(open_probe2(&e, "fn probe(bool go) void {\n    keep(go ? new(cell) : null);\n}\n",
        "fn keep(cell mut* own p) void {\n    del(p);\n}\n"));
    scope.scope mut params = scope.scope{};
    check_env.open_params(&e, &params, "probe");
    check.expr o = check_env.probe_expr(&e,
        check_env.node_find(check_env.body_expr(&e, "probe", 0), ast.ast_kind.k_ternary, ""));
    check_env.close_params(&e, &params);
    assert(check_env.type_text(&e, o.ty) == "cell mut* own");
    assert(!o.lvalue);
}

// An `own` rvalue beside an arm that does not own would be lent, and nothing
// would be left to free it, which is the error.
fn an_owning_rvalue_arm_beside_a_lending_one_would_leak() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(open_probe2(&e, "fn probe(bool go) void {\n    borrow(go ? theirs : new(cell));\n}\n",
        "fn borrow(cell mut* p) void {\n    return;\n}\n"));
    scope.scope mut params = scope.scope{};
    check_env.open_params(&e, &params, "probe");
    check_env.probe_expr(&e,
        check_env.node_find(check_env.body_expr(&e, "probe", 0), ast.ast_kind.k_ternary, ""));
    check_env.close_params(&e, &params);
    assert(check_env.said(&e, "owning temporary would leak: the other arm does not own"));
}

// Lending strips the `own` of a reference and not the `own` a struct holds by
// value, so an owning aggregate arm still owns after check_lend and the copy
// the conditional makes is a transfer. Without this the conditional would
// yield an owning rvalue that no arm was emptied for, and `del` of each would
// free one allocation twice.
fn an_owning_aggregate_arm_is_a_transfer_and_needs_move() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(open_probe(&e, "fn probe(bool go) void {\n    hh = go ? hh : hh;\n}\n"));
    scope.scope mut params = scope.scope{};
    check_env.open_params(&e, &params, "probe");
    check_env.probe_expr(&e,
        check_env.node_find(check_env.body_expr(&e, "probe", 0), ast.ast_kind.k_ternary, ""));
    check_env.close_params(&e, &params);
    assert(check_env.said(&e, "copying an owning value requires 'move'"));
}

// `move` in each arm is what the rule asks for, and two `move`s are two owning
// rvalues, so the conditional yields an owning value that must land in an
// owning place.
fn two_moved_aggregate_arms_yield_an_owning_rvalue() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(open_probe(&e, "fn probe(bool go) void {\n    hh = go ? move(hh) : move(hh);\n}\n"));
    scope.scope mut params = scope.scope{};
    check_env.open_params(&e, &params, "probe");
    check.expr o = check_env.probe_expr(&e,
        check_env.node_find(check_env.body_expr(&e, "probe", 0), ast.ast_kind.k_ternary, ""));
    check_env.close_params(&e, &params);
    assert(check_env.errors(&e) == 0);
    assert(check_env.type_text(&e, o.ty) == "holder");
    assert(!o.lvalue);
}

// ---- the return of an owning value -------------------------------------------------

fn returning_an_own_parameter_outright_is_an_implicit_move() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "struct cell {\n    i32 v;\n}\n");
    strbuf.append(&b, "fn take(cell mut* own p) cell mut* own {\n    return p;\n}\n");
    strbuf.append(&b, "fn main() i32 {\n    return 0;\n}\n");
    assert(check_env.open_module(&e, strbuf.view(&b)));
    // The result type is the one own place an owning lvalue reaches without
    // `move`, and only when it names a local or a parameter outright: the
    // emitter empties the operand after reading it, which is what lets a
    // `defer del(p)` written above see the zero value.
    scope.scope mut params = scope.scope{};
    check_env.open_params(&e, &params, "take");
    ast.node mut* ret = check_env.return_in(&e, "take");
    check.expr mut out = check.expr{};
    check.check_return_value(&e.ck, ret, check_env.result_type(&e, "take"), &out);
    check_env.close_params(&e, &params);
    assert(check_env.errors(&e) == 0);
    assert(check_env.type_text(&e, out.ty) == "cell mut* own");
    assert(check_env.has_ann(ret, check.ANN_MOVE));
}

fn returning_an_owning_value_that_names_no_local_needs_move() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "struct cell {\n    i32 v;\n}\n");
    strbuf.append(&b, "cell mut* own mut kept = null;\n");
    strbuf.append(&b, "fn give() cell mut* own {\n    return kept;\n}\n");
    strbuf.append(&b, "fn main() i32 {\n    return 0;\n}\n");
    assert(check_env.open_module(&e, strbuf.view(&b)));
    ast.node mut* ret = check_env.return_in(&e, "give");
    check.expr mut out = check.expr{};
    check.check_return_value(&e.ck, ret, check_env.result_type(&e, "give"), &out);
    // A global is not a local or a parameter, so the transfer is written and
    // the emitter is told nothing.
    assert(check_env.said(&e, "copying an owning value requires 'move': write move(kept)"));
    assert(!check_env.has_ann(ret, check.ANN_MOVE));
}

// ---- the annotations the checker owns ----------------------------------------------

fn a_second_check_clears_every_annotation_it_will_write() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(check_env.check_decls(&e, "i32 k = 1;\n"));
    // A node the checker writes nothing on: the block of a function body.
    // The statement checker walks it (check_stmt.ft) and writes no
    // annotation on a k_block, so what is set below is set by this test
    // alone.
    ast.node mut* body = check_env.node_in_main(&e, ast.ast_kind.k_fn_decl, "main")->b;
    assert(body->ann == 0 && body->ty == null && body->sym == null && body->aux == 0);
    // Every bit the checker owns, plus a type and a symbol that belong to
    // nothing, as an earlier check of the same tree would have left them.
    body->ann = check.ANN_ALL;
    body->aux = 7;
    body->ty = check_env.sym_main(&e, "k")->ty;
    body->sym = check_env.sym_main(&e, "k");
    modules_recheck(&e);
    // The clearing is what is asserted, not the writing: a pass that cleared
    // nothing would leave these set, and a pass that wrote them would be
    // caught by the other suites.
    assert(body->ann == 0);
    assert(body->aux == 0);
    assert(body->ty == null);
    assert(body->sym == null);
}

// Checks the entry module a second time through the same checker, which is
// what an editor re-checking a file after an edit does. Whether the second
// check is clean is not what is asserted: the bits it found are, so the call's
// own answer is discarded and the assertions above it stand.
fn modules_recheck(check_env.env mut* e) void {
    check_stmt.check_module(&e->ck, check_env.module_at(e, "main"));
}

fn the_sentinel_bit_is_one_past_the_highest_one() void {
    // ANN_END doubles with the highest bit, and ANN_ALL is the mask
    // clear_annotations clears, so a bit declared without raising the
    // sentinel would not be cleared (check.ft).
    assert(check.ANN_END == check.ANN_MOVE * 2);
    assert(check.ANN_ALL == check.ANN_END - 1);
    // Every bit the checker declares is inside the mask.
    assert((check.ANN_ALL & check.ANN_CONST) != 0);
    assert((check.ANN_ALL & check.ANN_UNTYPED) != 0);
    assert((check.ANN_ALL & check.ANN_NORETURN) != 0);
    assert((check.ANN_ALL & check.ANN_RESOLVING) != 0);
    assert((check.ANN_ALL & check.ANN_RESOLVED) != 0);
    assert((check.ANN_ALL & check.ANN_EXHAUSTIVE) != 0);
    assert((check.ANN_ALL & check.ANN_MOVE) != 0);
}

fn a_call_of_a_noreturn_function_is_marked() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "fn stop() noreturn {\n    panic(\"no\");\n}\n");
    strbuf.append(&b, "fn probe() void {\n    stop();\n}\n");
    strbuf.append(&b, "fn main() i32 {\n    return 0;\n}\n");
    assert(check_env.open_module(&e, strbuf.view(&b)));
    ast.node mut* call = check_env.body_expr(&e, "probe", 0);
    check_env.probe_expr(&e, call);
    // A call to a `noreturn` function terminates its statement, which the
    // emitter and the statement checker read off this bit.
    assert(check_env.has_ann(call, check.ANN_NORETURN));
}

fn main() i32 {
    an_owning_global_may_be_emptied_and_a_constant_may_not();
    an_owning_constant_is_an_immutable_lvalue_whose_reason_is_read_only_memory();
    a_mutable_global_is_emptiable_although_it_is_not_read_only();
    an_immutable_indirection_may_not_be_emptied();
    an_own_reference_and_an_owning_aggregate_own_and_a_view_does_not();
    move_needs_an_owning_lvalue();
    move_refuses_a_value_that_owns_nothing();
    del_takes_an_owning_reference_and_nothing_else();
    a_field_of_an_owning_rvalue_would_leak();
    an_owning_rvalue_that_reaches_a_borrowing_context_would_leak();
    copying_an_owning_lvalue_into_an_own_place_requires_move();
