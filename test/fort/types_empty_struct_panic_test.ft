//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: types.type_layout_struct: layout of an empty struct
//! stdout:
//| true
/// An empty struct is an error the checker reports, so a layout with no field
/// is a broken precondition.
import types;
import types_env;

fn main() i32 {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node*[1] mut fields = {types_env.type_of(&e, "i32")};
    u64[1] mut offsets = {};
    println(types.type_layout_begin(e.rec));
    println(types.type_layout_struct(e.rec, fields[..0], offsets[..]));
    return 0;
}
