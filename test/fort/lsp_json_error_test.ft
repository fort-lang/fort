//! run
//! flags: -I ../../src/fort -I support -I ../../src
//! stdout:
//| empty ok
//| literals ok
//| strings ok
//| containers ok
//| trailing ok
//| depth ok
//| records ok
//| ok
import lsp.json;
import lsp_json_env;
import std.strbuf;

// The corpus of malformed documents src/lsp/json.ft refuses. Every case names
// the offset of the byte that broke the rule and the rule it broke, and no
// case ends the program: a server reads its bytes from an editor and answers
// a bad message rather than aborting over it.
// D20.5
//
// The refusals of a number stand in lsp_json_number_test.ft and those of a
// string's escapes and bytes in lsp_json_escape_test.ft. What is here is
// everything else, and the shape of the record itself.

// The deepest nesting the reader accepts, which JSON_MAX_DEPTH fixes.
u64 DEPTH_LIMIT = 64;

// ---- a document is a value -------------------------------------------------------

fn void an_empty_document_is_refused() {
    lsp_json_env.refused("", 0, "a value was expected");
}

fn void a_document_of_whitespace_alone_is_refused() {
    lsp_json_env.refused(" ", 1, "a value was expected");
    lsp_json_env.refused("\n\t\r ", 4, "a value was expected");
}

fn void a_byte_that_starts_no_value_is_refused() {
    lsp_json_env.refused("x", 0, "a value was expected");
    lsp_json_env.refused("'a'", 0, "a value was expected");
    lsp_json_env.refused("#", 0, "a value was expected");
    lsp_json_env.refused(",", 0, "a value was expected");
    lsp_json_env.refused(":", 0, "a value was expected");
    lsp_json_env.refused("]", 0, "a value was expected");
    lsp_json_env.refused("}", 0, "a value was expected");
}

fn void a_byte_order_mark_is_not_whitespace() {
    // RFC 8259 8.1 says a JSON text is UTF-8 with no byte order mark, so the
    // three bytes of one start no value. A server that meets one strips it
    // before it reads the message.
    lsp_json_env.refused("\xef\xbb\xbf{}", 0, "a value was expected");
    lsp_json_env.refused("\xef\xbb\xbf", 0, "a value was expected");
    lsp_json_env.refused("{}\xef\xbb\xbf", 2, "a document is one value");
}

fn void a_vertical_tab_and_a_form_feed_are_not_whitespace() {
    // JSON has four whitespace bytes and these are not among them, although
    // std.str.is_space counts both (stdlib.md 2.5).
    lsp_json_env.refused("\x0b1", 0, "a value was expected");
    lsp_json_env.refused("\x0c1", 0, "a value was expected");
    lsp_json_env.refused("[1\x0b]", 2, "a ',' or a ']' was expected");
}

fn void a_comment_is_not_a_value_and_not_whitespace() {
    lsp_json_env.refused("// a comment\n1", 0, "a value was expected");
    lsp_json_env.refused("/* a comment */ 1", 0, "a value was expected");
    lsp_json_env.refused("[1] // a comment", 4, "a document is one value");
}

// ---- the three literals ----------------------------------------------------------

fn void a_truncated_literal_is_refused() {
    lsp_json_env.refused("tru", 0, "a value was expected");
    lsp_json_env.refused("fals", 0, "a value was expected");
    lsp_json_env.refused("nul", 0, "a value was expected");
    lsp_json_env.refused("n", 0, "a value was expected");
}

fn void a_literal_in_another_case_is_refused() {
    lsp_json_env.refused("True", 0, "a value was expected");
    lsp_json_env.refused("FALSE", 0, "a value was expected");
    lsp_json_env.refused("Null", 0, "a value was expected");
    lsp_json_env.refused("NULL", 0, "a value was expected");
}

fn void a_word_that_is_no_literal_is_refused() {
    lsp_json_env.refused("undefined", 0, "a value was expected");
    lsp_json_env.refused("none", 0, "a value was expected");
    lsp_json_env.refused("truthy", 0, "a value was expected");
    // A literal the bytes of another word begin is read, and the bytes that
    // follow it are then a second value.
    lsp_json_env.refused("truex", 4, "a document is one value");
    lsp_json_env.refused("nullable", 4, "a document is one value");
}

// ---- strings ---------------------------------------------------------------------

fn void an_unterminated_string_is_refused() {
    lsp_json_env.refused("\"", 1, "the string is not terminated");
    lsp_json_env.refused("\"abc", 4, "the string is not terminated");
    lsp_json_env.refused("[\"abc]", 6, "the string is not terminated");
}

fn void a_string_that_ends_in_a_backslash_is_refused() {
    lsp_json_env.refused("\"\\", 1, "the string is not terminated");
    lsp_json_env.refused("\"abc\\", 4, "the string is not terminated");
    // The escaped quote is not the end of the string, so this one runs out.
    lsp_json_env.refused("\"abc\\\"", 6, "the string is not terminated");
}

fn void a_raw_control_byte_in_a_string_is_refused() {
    lsp_json_env.refused("\"\n\"", 1, "a control byte in a string must be escaped");
    lsp_json_env.refused("\"\t\"", 1, "a control byte in a string must be escaped");
    lsp_json_env.refused("\"\r\"", 1, "a control byte in a string must be escaped");
    lsp_json_env.refused("\"\x00\"", 1, "a control byte in a string must be escaped");
    lsp_json_env.refused("\"a\x1f\"", 2, "a control byte in a string must be escaped");
}

fn void a_byte_at_the_top_of_ascii_is_no_control_byte() {
    // 0x7f is not below 0x20, so JSON leaves it alone and so does the reader.
    lsp_json_env.text_is("\"\x7f\"", "\x7f");
}

fn void an_escape_json_does_not_have_is_refused() {
    lsp_json_env.refused("\"\\q\"", 1, "the escape is not one of JSON's");
    lsp_json_env.refused("\"\\x41\"", 1, "the escape is not one of JSON's");
    lsp_json_env.refused("\"\\U0041\"", 1, "the escape is not one of JSON's");
    lsp_json_env.refused("\"\\0\"", 1, "the escape is not one of JSON's");
    lsp_json_env.refused("\"a\\'\"", 2, "the escape is not one of JSON's");
}

fn void a_short_or_bad_unicode_escape_is_refused() {
    lsp_json_env.refused("\"\\u\"", 1, "a \\u escape needs four hex digits");
    lsp_json_env.refused("\"\\u00\"", 1, "a \\u escape needs four hex digits");
    lsp_json_env.refused("\"\\u004\"", 1, "a \\u escape needs four hex digits");
    lsp_json_env.refused("\"\\u00zz\"", 1, "a \\u escape needs four hex digits");
    lsp_json_env.refused("\"\\u 041\"", 1, "a \\u escape needs four hex digits");
    lsp_json_env.refused("\"\\u+041\"", 1, "a \\u escape needs four hex digits");
}

fn void a_name_is_held_to_the_rules_of_a_string() {
    lsp_json_env.refused("{\"\\q\":1}", 2, "the escape is not one of JSON's");
    lsp_json_env.refused("{\"a\n\":1}", 3, "a control byte in a string must be escaped");
    lsp_json_env.refused("{\"a:1}", 6, "the string is not terminated");
}

// ---- containers ------------------------------------------------------------------

fn void an_unclosed_array_is_refused() {
    lsp_json_env.refused("[", 1, "a value was expected");
    lsp_json_env.refused("[1", 2, "a ',' or a ']' was expected");
    lsp_json_env.refused("[1,2", 4, "a ',' or a ']' was expected");
    lsp_json_env.refused("[[1]", 4, "a ',' or a ']' was expected");
}

fn void an_unclosed_object_is_refused() {
    lsp_json_env.refused("{", 1, "a member name was expected");
    lsp_json_env.refused("{\"a\"", 4, "a ':' was expected");
    lsp_json_env.refused("{\"a\":", 5, "a value was expected");
    lsp_json_env.refused("{\"a\":1", 6, "a ',' or a '}' was expected");
}

fn void a_missing_comma_is_refused() {
    lsp_json_env.refused("[1 2]", 3, "a ',' or a ']' was expected");
    lsp_json_env.refused("{\"a\":1 \"b\":2}", 7, "a ',' or a '}' was expected");
    lsp_json_env.refused("[[][]]", 3, "a ',' or a ']' was expected");
}

fn void a_trailing_comma_is_refused() {
    lsp_json_env.refused("[1,]", 3, "a value was expected");
    lsp_json_env.refused("[1,2,]", 5, "a value was expected");
    lsp_json_env.refused("{\"a\":1,}", 7, "a member name was expected");
    lsp_json_env.refused("[[1,],2]", 4, "a value was expected");
}

fn void an_empty_slot_is_refused() {
    lsp_json_env.refused("[,]", 1, "a value was expected");
    lsp_json_env.refused("[1,,2]", 3, "a value was expected");
    lsp_json_env.refused("{,}", 1, "a member name was expected");
}

fn void a_closing_bracket_of_the_wrong_kind_is_refused() {
    lsp_json_env.refused("[}", 1, "a value was expected");
    lsp_json_env.refused("{]", 1, "a member name was expected");
    lsp_json_env.refused("[1}", 2, "a ',' or a ']' was expected");
    lsp_json_env.refused("{\"a\":1]", 6, "a ',' or a '}' was expected");
}

fn void a_name_that_is_not_a_string_is_refused() {
    lsp_json_env.refused("{a:1}", 1, "a member name was expected");
    lsp_json_env.refused("{1:2}", 1, "a member name was expected");
    lsp_json_env.refused("{true:1}", 1, "a member name was expected");
    lsp_json_env.refused("{'a':1}", 1, "a member name was expected");
    lsp_json_env.refused("{\"a\":1,b:2}", 7, "a member name was expected");
}

fn void a_member_without_a_value_is_refused() {
    lsp_json_env.refused("{\"a\"}", 4, "a ':' was expected");
    lsp_json_env.refused("{\"a\",\"b\"}", 4, "a ':' was expected");
    lsp_json_env.refused("{\"a\"=1}", 4, "a ':' was expected");
    lsp_json_env.refused("{\"a\"::1}", 5, "a value was expected");
}

// ---- what follows the document ---------------------------------------------------

fn void a_second_value_after_the_document_is_refused() {
    lsp_json_env.refused("1 2", 2, "a document is one value");
    lsp_json_env.refused("{}{}", 2, "a document is one value");
    lsp_json_env.refused("[] []", 3, "a document is one value");
    lsp_json_env.refused("null null", 5, "a document is one value");
}

fn void a_byte_after_the_document_is_refused() {
    lsp_json_env.refused("{}x", 2, "a document is one value");
    lsp_json_env.refused("[]]", 2, "a document is one value");
    lsp_json_env.refused("true}", 4, "a document is one value");
    lsp_json_env.refused("\"a\"\"b\"", 3, "a document is one value");
}

fn void whitespace_after_the_document_is_no_error() {
    lsp_json_env.reads_as("1 ", "1");
    lsp_json_env.reads_as("{} \n\t\r", "{}");
}

// ---- the depth limit -------------------------------------------------------------

// A document of `depth` open brackets, closed again, and `pad` bytes of
// nothing: the shape both depth tests build.
fn void nested(strbuf.str_buf mut* b, u64 depth, char open, char close) {
    strbuf.clear(b);
    u64 mut i = 0;
    while (i < depth) {
        strbuf.push(b, open);
        i += 1;
    }
    i = 0;
    while (i < depth) {
        strbuf.push(b, close);
        i += 1;
    }
}

fn void nesting_to_the_limit_is_accepted() {
    strbuf.str_buf mut source = strbuf.create();
    defer strbuf.free(&source);
    json.doc mut d = json.create();
    defer json.free(&d);
    nested(&source, DEPTH_LIMIT, '[', ']');
    assert(json.parse(&d, strbuf.view(&source)));
    assert(json.node_count(&d) == DEPTH_LIMIT + 1);
}

fn void nesting_past_the_limit_is_refused() {
    strbuf.str_buf mut source = strbuf.create();
    defer strbuf.free(&source);
    nested(&source, DEPTH_LIMIT + 1, '[', ']');
    lsp_json_env.refused(strbuf.view(&source), DEPTH_LIMIT, "the nesting is too deep");
}

fn void objects_and_arrays_share_the_limit() {
    // One level of each, alternating, reaches the same limit: the counter is
    // the containers open and not the brackets of one kind.
    strbuf.str_buf mut source = strbuf.create();
    defer strbuf.free(&source);
    strbuf.clear(&source);
    u64 mut i = 0;
    while (i < DEPTH_LIMIT / 2) {
        strbuf.append(&source, "[{\"a\":");
        i += 1;
    }
    strbuf.append(&source, "1");
    i = 0;
    while (i < DEPTH_LIMIT / 2) {
        strbuf.append(&source, "}]");
        i += 1;
    }
    json.doc mut d = json.create();
    defer json.free(&d);
    assert(json.parse(&d, strbuf.view(&source)));
    // One array and one object per pair, the number, and the absent node.
    assert(json.node_count(&d) == DEPTH_LIMIT + 2);
}

fn void a_deep_object_is_refused_like_a_deep_array() {
    strbuf.str_buf mut source = strbuf.create();
    defer strbuf.free(&source);
    strbuf.clear(&source);
    u64 mut i = 0;
    while (i < DEPTH_LIMIT + 1) {
        strbuf.append(&source, "{\"a\":");
        i += 1;
    }
    strbuf.append(&source, "1");
    i = 0;
    while (i < DEPTH_LIMIT + 1) {
        strbuf.push(&source, '}');
        i += 1;
    }
    // Five bytes for each level that was accepted.
    lsp_json_env.refused(strbuf.view(&source), DEPTH_LIMIT * 5, "the nesting is too deep");
}

// ---- the record itself -----------------------------------------------------------

fn void the_first_rule_broken_is_the_one_recorded() {
    // Two rules break in this document: the empty slot at 3 and the missing
    // bracket at the end. The record names the first.
    lsp_json_env.refused("[1,,", 3, "a value was expected");
}

fn void a_refused_document_holds_no_tree() {
    json.doc mut d = json.create();
    defer json.free(&d);
    assert(!json.parse(&d, "[1,2"));
    assert(json.root(&d) == 0);
    assert(!json.has(&d, json.root(&d)));
}

fn void a_refused_document_is_usable_again() {
    json.doc mut d = json.create();
    defer json.free(&d);
    u64 mut i = 0;
    while (i < 100) {
        assert(!json.parse(&d, "{\"a\":}"));
        assert(json.error_offset(&d) == 5);
        i += 1;
    }
    assert(json.parse(&d, "{\"a\":1}"));
    assert(json.error_message(&d) == "");
}

fn void the_offset_is_a_byte_and_not_a_character() {
    // The two-byte sequence before the error counts as two.
    lsp_json_env.refused("[\"\xc3\xa9\",]", 6, "a value was expected");
}

fn i32 main() {
    an_empty_document_is_refused();
    a_document_of_whitespace_alone_is_refused();
    a_byte_that_starts_no_value_is_refused();
    a_comment_is_not_a_value_and_not_whitespace();
    a_byte_order_mark_is_not_whitespace();
    a_vertical_tab_and_a_form_feed_are_not_whitespace();
    println("empty ok");
    a_truncated_literal_is_refused();
    a_literal_in_another_case_is_refused();
    a_word_that_is_no_literal_is_refused();
    println("literals ok");
    an_unterminated_string_is_refused();
    a_string_that_ends_in_a_backslash_is_refused();
    a_raw_control_byte_in_a_string_is_refused();
    a_byte_at_the_top_of_ascii_is_no_control_byte();
    an_escape_json_does_not_have_is_refused();
    a_short_or_bad_unicode_escape_is_refused();
    a_name_is_held_to_the_rules_of_a_string();
    println("strings ok");
    an_unclosed_array_is_refused();
    an_unclosed_object_is_refused();
    a_missing_comma_is_refused();
    a_trailing_comma_is_refused();
    an_empty_slot_is_refused();
    a_closing_bracket_of_the_wrong_kind_is_refused();
    a_name_that_is_not_a_string_is_refused();
    a_member_without_a_value_is_refused();
    println("containers ok");
    a_second_value_after_the_document_is_refused();
    a_byte_after_the_document_is_refused();
    whitespace_after_the_document_is_no_error();
    println("trailing ok");
    nesting_to_the_limit_is_accepted();
    nesting_past_the_limit_is_refused();
    objects_and_arrays_share_the_limit();
    a_deep_object_is_refused_like_a_deep_array();
    println("depth ok");
    the_first_rule_broken_is_the_one_recorded();
    a_refused_document_holds_no_tree();
    a_refused_document_is_usable_again();
    the_offset_is_a_byte_and_not_a_character();
    println("records ok");
    println("ok");
    return 0;
}
