//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: fir_lower.member_slot: a designator with no field index
//! stdout:
//| 1
/// The checker gives each designator of a literal the symbol of its field. The test clears the
/// symbol of `.b`, so member_slot finds no index and panics.
import ast;
import check_env;
import fir;
import fir_lower;
import lower_env;

fn main() i32 {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[8] source = {
        "struct pair {",
        "    i32 a;",
        "    i32 b;",
        "}",
        "fn f() i32 {",
        "    pair q = pair{.b = 1};",
        "    return q.a;",
        "}",
    };
    lower_env.check_lines(&e, source[..], true);
    ast.node* decl = lower_env.decl(&e, "f");
    fir.func mut f = fir.func_new(&e.c.ck.types, decl->sym, decl->sym->ty);
    defer fir.func_free(&f);
    fir_lower.lowerer mut lw = fir_lower.lowerer{.ck = &e.c.ck, .f = &f};
    defer fir_lower.scopes_free(&lw.scopes);
    fir_lower.prescan(&lw, decl->b);
    ast.node mut* init = check_env.node_in_main(&e.c, ast.ast_kind.k_brace_init, "");
    ast.node mut* desig = check_env.node_in_main(&e.c, ast.ast_kind.k_designator, "");
    println(fir_lower.member_slot(init, 0));
    desig->sym = null;
    fir_lower.member_slot(init, 0);
    return 0;
}
