//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: runtime_sig.rt_sig_of: not an entry point
//! stdout:
//| std.rt.exit
/// rt_none marks a call that names no runtime entry, so it has no signature. rt_sig_of on
/// rt_none breaks its precondition and panics.
import runtime_sig;

fn main() i32 {
    println(runtime_sig.rt_sig_of(runtime_sig.rt_entry.rt_exit).name);
    runtime_sig.rt_sig_of(runtime_sig.rt_entry.rt_none);
    return 0;
}
