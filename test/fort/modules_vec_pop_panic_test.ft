//! run
//! flags: -I ../../src
//! abort
//! stderr: panic: modules.vec_pop: the vector is empty
//! stdout:
//| 2
//| 0
/// Checks the module vector that holds the import path. vec_pop drops the last element. A pop
/// with no push is a walk that lost its balance, so a pop from an empty vector panics.
import fort.modules;

fn main() i32 {
    modules.module_vec mut v = modules.module_vec{};
    defer del(v.items);
    // vec_push keeps the pointer and reads nothing through it, so the test pushes no module.
    modules.vec_push(&v, null);
    modules.vec_push(&v, null);
    println(v.len);
    modules.vec_pop(&v);
    modules.vec_pop(&v);
    println(v.len);
    modules.vec_pop(&v);
    return 0;
}
