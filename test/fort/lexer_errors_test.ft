//! run
//! flags: -I ../../src -I support
//! stdout:
//| ok
/// Checks invalid token bytes, line-based recovery, and the 20-diagnostic lexer budget.
/// Recovery resumes at the next line.
import fort.diag;
import lex_env;
import fort.lexer;
import fort.session;
import std.strbuf;

//
// These assertions match the recovery section of bootstrap0/test/lexer_test.c.

// ---- the queries of this suite over lex_env ------------------------------------

// The tokens of the last lex, the end-of-file token excluded: what a resync
// kept.
fn kept(lex_env.env* f) u64 {
    return lex_env.count(f) - 1;
}

// The four tokens of `x = 1;` on line `line` are all the file lexed: the line
// every resync test below resumes on.
fn resumed_line(lex_env.env* f, u32 line) bool {
    return kept(f) == 4 && lex_env.text(f, 0) == "x" && lex_env.kind(f, 1) == "="
        && lex_env.kind(f, 2) == "integer literal" && lex_env.kind(f, 3) == ";"
        && lex_env.at(f, 0, line, 1);
}

// ---- bytes that start no token -------------------------------------------------

fn non_ascii_outside_strings_and_comments_is_an_error() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.one_error(f, "x = \xC3\xA9;", 1, 5,
                             "non-ASCII byte outside a string literal or comment"));
    assert(kept(f) == 0);
    // Two of the three bytes of the mark are not the mark, and no UTF-8 text.
    assert(lex_env.one_error(f, "\xEF\xBBx", 1, 1, "invalid UTF-8 sequence at byte 0xEF"));
    // The three bytes of the mark after the start of the file are text, which code refuses.
    assert(lex_env.one_error(f, "x \xEF\xBB\xBF", 1, 3,
                             "non-ASCII byte outside a string literal or comment"));
}

fn unexpected_printable_character_is_an_error() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.one_error(f, "a # b", 1, 3, "unexpected character '#'"));
    assert(lex_env.one_error(f, "#", 1, 1, "unexpected character '#'"));
    assert(lex_env.one_error(f, "`", 1, 1, "unexpected character '`'"));
    assert(lex_env.one_error(f, "$", 1, 1, "unexpected character '$'"));
    assert(lex_env.one_error(f, "\\", 1, 1, "unexpected character '\\'"));
}

// A byte that cannot be shown is named by its value.
fn unexpected_control_byte_is_an_error() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.one_error(f, "\x01", 1, 1, "unexpected byte 0x01"));
    assert(lex_env.one_error(f, "x\x7F", 1, 2, "unexpected byte 0x7F"));
    assert(lex_env.one_error(f, "\x0C", 1, 1, "unexpected byte 0x0C"));
    assert(lex_env.one_error(f, "\x0B", 1, 1, "unexpected byte 0x0B"));
    // A fort string holds an embedded NUL, so the file really is one byte.
    assert(lex_env.one_error(f, "\x00", 1, 1, "unexpected byte 0x00"));
}

fn error_position_counts_lines_columns_and_tabs() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.one_error(f, "a\n\n\t\tb #", 3, 5, "unexpected character '#'"));
    // The lines before the error keep their tokens, the line of the error
    // loses them.
    assert(kept(f) == 1);
    assert(lex_env.text(f, 0) == "a");
}

// An error drops the whole line it stands on, the tokens lexed before it
// included. And the second error of that line is never reached, so one line
// costs one diagnostic.
fn an_error_drops_its_line_and_reports_once() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.one_error(f, "a b # c #", 1, 5, "unexpected character '#'"));
    assert(kept(f) == 0);
}

// ---- resynchronisation after a lexical error ------------------------------------

// Every kind of lexical error costs its line alone: the line after it is
// lexed as though nothing had happened.
fn every_error_kind_resumes_at_the_next_line() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.one_error(f, "#\nx = 1;\n", 1, 1, "unexpected character '#'"));
    assert(resumed_line(f, 2));
    assert(lex_env.one_error(f, "\x01\nx = 1;\n", 1, 1, "unexpected byte 0x01"));
    assert(resumed_line(f, 2));
    assert(lex_env.one_error(f, "a \xC3\xA9\nx = 1;\n", 1, 3,
                             "non-ASCII byte outside a string literal or comment"));
    assert(resumed_line(f, 2));
    assert(lex_env.one_error(f, "/* c */\nx = 1;\n", 1, 1,
                             "block comments are not supported, use '//'"));
    assert(resumed_line(f, 2));
    assert(lex_env.one_error(f, "i32 const = 1;\nx = 1;\n", 1, 5, "'const' is a reserved word"));
    assert(resumed_line(f, 2));
}

// The same for the literal forms: a bad number, a bad escape and a literal
// left open at the end of its line.
fn a_broken_literal_resumes_at_the_next_line() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.one_error(f, "i32 y = 08;\nx = 1;\n", 1, 9,
                             "decimal literal may not start with '0'"));
    assert(resumed_line(f, 2));
    assert(lex_env.one_error(f, "i32 y = 0xZ;\nx = 1;\n", 1, 9,
                             "hex literal needs at least one digit"));
    assert(resumed_line(f, 2));
    assert(lex_env.one_error(f, "char c = '\\q';\nx = 1;\n", 1, 11, "unknown escape '\\q'"));
    assert(resumed_line(f, 2));
    assert(lex_env.one_error(f, "string s = \"abc;\nx = 1;\n", 1, 12,
                             "unterminated string literal"));
    assert(resumed_line(f, 2));
    assert(lex_env.one_error(f, "char c = 'a\nx = 1;\n", 1, 10, "unterminated char literal"));
    assert(resumed_line(f, 2));
}

// The lines before and after a broken line keep their tokens, so the vector
// covers the file with one line missing.
fn an_error_line_stands_between_two_good_lines() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.one_error(f, "a;\n#\nx = 1;\n", 2, 1, "unexpected character '#'"));
    assert(kept(f) == 6);
    assert(lex_env.text(f, 0) == "a");
    assert(lex_env.kind(f, 1) == ";");
    assert(lex_env.text(f, 2) == "x");
    assert(lex_env.at(f, 2, 3, 1));
}

// Two errors on two lines are both reported, and the lines between and after
// them are lexed.
fn two_errors_on_two_lines_are_both_reported() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.failed(f, "a #\nb;\nc `\nx = 1;\n", 2));
    assert(lex_env.error_is(f, 0, 1, 3, "unexpected character '#'"));
    assert(lex_env.error_is(f, 1, 3, 3, "unexpected character '`'"));
    assert(kept(f) == 6);
    assert(lex_env.text(f, 0) == "b");
    assert(lex_env.text(f, 2) == "x");
    assert(lex_env.at(f, 0, 2, 1));
    assert(lex_env.at(f, 2, 4, 1));
}

// An error on a final line without a newline
// still appends an end-of-file token at the file end.
fn an_error_on_the_last_line_still_ends_in_eof() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.one_error(f, "a;\nb #", 2, 3, "unexpected character '#'"));
    assert(kept(f) == 2);
    assert(lex_env.kind(f, 2) == "end of file");
    assert(lex_env.at(f, 2, 2, 4));
    assert(lex_env.covers(f, 2, 6, 0));
}

// A file that is one broken line is the end-of-file token alone, which is
// what lets the parser run on it.
fn a_file_of_one_broken_line_is_only_eof() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.one_error(f, "#\n", 1, 1, "unexpected character '#'"));
    assert(kept(f) == 0);
    assert(lex_env.at(f, 0, 2, 1));
}

// A string literal lexed after a resync is decoded like any other, so the
// pool is unaffected by the dropped line.
fn a_literal_after_a_resync_is_decoded() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.one_error(f, "s = \"ab;\nt = \"cd\";\n", 1, 5, "unterminated string literal"));
    assert(kept(f) == 4);
    assert(lex_env.text(f, 0) == "t");
    assert(lex_env.kind(f, 2) == "string literal");
    assert(lex_env.text(f, 2) == "cd");
}

// A file reports at most twenty diagnostics, and lexing goes on silently past
// the cap. So the tokens of the lines after it are still there. The cap is
// the lexer's to check, not the sink's: diag.report records every diagnostic
// it is handed. And the lexer asks diag.budget_left before it reports,
// exactly as bootstrap0/src/lexer.c does.
fn a_file_reports_at_most_twenty_diagnostics() void {
    strbuf.str_buf mut b = strbuf.create();
    defer del(b.data);
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    u64 mut i = 0;
    while (i < 25) {
        strbuf.append(&b, "#\n");
        i += 1;
    }
    strbuf.append(&b, "x = 1;\n");
    assert(!lex_env.lex(f, strbuf.view(&b)));
    assert(lex_env.errors(f) == 20);
    assert(diag.record_count(session.diags(&f->sess)) == 20);
    assert(!diag.budget_left(session.diags(&f->sess)));
    // The twentieth error is the one on line 20. The five after it are
    // silent, and the line after them is lexed.
    assert(lex_env.error_is(f, 19, 20, 1, "unexpected character '#'"));
    assert(resumed_line(f, 26));
}

// A second file through one session starts a budget of its own, since the
// lexer opens it with diag.begin_file.
fn a_second_file_starts_a_new_budget() void {
    strbuf.str_buf mut b = strbuf.create();
    defer del(b.data);
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    u64 mut i = 0;
    while (i < 25) {
        strbuf.append(&b, "#\n");
        i += 1;
    }
    assert(!lex_env.lex(f, strbuf.view(&b)));
    assert(lex_env.errors(f) == 20);
    // lex resets the sink, so this is the count of the second file alone. The
    // budget was reopened either way, which the twenty-first error of one
    // file could not be.
    assert(lex_env.one_error(f, "#\n", 1, 1, "unexpected character '#'"));
    assert(diag.budget_left(session.diags(&f->sess)));
}

// A lone carriage return is whitespace, so it ends a line for a resync too. A
// file written with `\r` alone keeps the tokens after the bad line.
fn a_carriage_return_ends_a_resync() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.one_error(f, "a #\rx = 1;\r", 1, 3, "unexpected character '#'"));
    assert(kept(f) == 4);
    assert(lex_env.text(f, 0) == "x");
    assert(lex_env.one_error(f, "a #\r\nx = 1;\n", 1, 3, "unexpected character '#'"));
    assert(resumed_line(f, 2));
}

// The tokens of a file with no error are untouched by any of this, and a
// clean lex reports nothing at all.
fn a_clean_file_reports_nothing() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.clean(f, "fn main() {\n    return 0;\n}\n", 9));
    assert(diag.record_count(session.diags(&f->sess)) == 0);
    assert(diag.budget_left(session.diags(&f->sess)));
}

fn main() i32 {
    non_ascii_outside_strings_and_comments_is_an_error();
    unexpected_printable_character_is_an_error();
    unexpected_control_byte_is_an_error();
    error_position_counts_lines_columns_and_tabs();
    an_error_drops_its_line_and_reports_once();
    every_error_kind_resumes_at_the_next_line();
    a_broken_literal_resumes_at_the_next_line();
    an_error_line_stands_between_two_good_lines();
    two_errors_on_two_lines_are_both_reported();
    an_error_on_the_last_line_still_ends_in_eof();
    a_file_of_one_broken_line_is_only_eof();
    a_literal_after_a_resync_is_decoded();
    a_file_reports_at_most_twenty_diagnostics();
    a_second_file_starts_a_new_budget();
    a_carriage_return_ends_a_resync();
    a_clean_file_reports_nothing();
    println("ok");
    return 0;
}
