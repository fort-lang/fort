//! run
//! flags: -I ../../src/fort
//! stdout:
//| ok
import diag;
import lexer;
import session;
import std.strbuf;

// The lexer of src/fort/lexer.ft: the bytes that start no token, and the
// recovery -- a lexical error costs its line, the tokens already lexed on it
// included, lexing resumes at the start of the next one, and the file's
// budget of twenty diagnostics is spent by the lexer and not by the sink.
// D14.2
//
// These are the assertions of test/lexer_test.c's recovery section, which
// holds the C lexer this module was transliterated from.

// ---- the fixture --------------------------------------------------------------

// One session and one token vector, reused by every lex of one test: the
// session owns the sink the diagnostics go to and the pool the string
// literals are decoded into, and freeing it frees both.
// D20.5
struct fixture {
    session.session sess;
    lexer.tok_vec toks;
}

fn fixture open_fixture() {
    return fixture{session.create(), lexer.tokvec_create()};
}

fn void close_fixture(fixture mut* f) {
    lexer.tokvec_free(&f->toks);
    session.free(&f->sess);
}

// Lexes `src` as t.ft, dropping the tokens and the diagnostics of the lex
// before it; the pool keeps the strings of both, which no test reads across
// a call. Returns whether the file was clean.
fn bool lex(fixture mut* f, string src) {
    lexer.tokvec_free(&f->toks);
    diag.reset(session.diags(&f->sess));
    return lexer.lex_file(&f->sess, "t.ft", src, &f->toks);
}

// The tokens of the last lex, the end-of-file token included.
fn u64 count(fixture* f) {
    return lexer.tokvec_count(&f->toks);
}

fn lexer.token tok(fixture* f, u64 i) {
    return lexer.tokvec_at(&f->toks, i);
}

// The name of the kind of token `i`, which is what an assertion compares:
// two kinds are equal when their names are (tok_kind_name is injective, as
// kind_names_are_distinct asserts).
fn string kind(fixture* f, u64 i) {
    return lexer.tok_kind_name(tok(f, i).kind);
}

fn string text(fixture* f, u64 i) {
    return tok(f, i).text;
}

// Whether token `i` starts at line `line`, column `col`.
// D14.2
fn bool at(fixture* f, u64 i, u32 line, u32 col) {
    return tok(f, i).line == line && tok(f, i).col == col;
}

// Whether token `i` covers `len` bytes from offset `off`.
// D20.4
fn bool covers(fixture* f, u64 i, u64 off, u64 len) {
    return tok(f, i).off == off && tok(f, i).len == len;
}

// The errors the last lex reported, notes excluded.
// D14.2
fn u64 errors(fixture mut* f) {
    return session.error_count(&f->sess);
}

// Whether the diagnostic `i` is an error at `line`:`col` of t.ft saying
// `msg`, which is everything its text line carries (toolchain.md 4).
// D14.2
fn bool error_is(fixture mut* f, u64 i, u32 line, u32 col, string msg) {
    diag.record r = diag.record_at(session.diags(&f->sess), i);
    return r.severity == diag.severity.error && r.loc.file == "t.ft" && r.loc.line == line
        && r.loc.col == col && r.msg == msg;
}

// The last lex succeeded with `n` tokens before the end-of-file token and
// reported nothing.
fn bool clean(fixture mut* f, string src, u64 n) {
    bool ok = lex(f, src);
    return ok && errors(f) == 0 && count(f) == n + 1
        && tok(f, n).kind == lexer.tok_kind.eof;
}

// The last lex failed with exactly the one diagnostic given, and still lexed
// the file whole, so the tokens end in the end-of-file token.
// D14.2
fn bool one_error(fixture mut* f, string src, u32 line, u32 col, string msg) {
    bool ok = lex(f, src);
    if (ok || errors(f) != 1 || count(f) == 0) {
        return false;
    }
    if (tok(f, count(f) - 1).kind != lexer.tok_kind.eof) {
        return false;
    }
    return error_is(f, 0, line, col, msg);
}

// The last lex failed with exactly `n` diagnostics and still lexed the file
// whole, so the tokens end in the end-of-file token.
// D14.2
fn bool failed(fixture mut* f, string src, u64 n) {
    bool ok = lex(f, src);
    if (ok || errors(f) != n || count(f) == 0) {
        return false;
    }
    return tok(f, count(f) - 1).kind == lexer.tok_kind.eof;
}

// The tokens of the last lex, the end-of-file token excluded: what a resync
// kept.
// D14.2
fn u64 kept(fixture* f) {
    return count(f) - 1;
}

// The four tokens of `x = 1;` on line `line` are all the file lexed: the line
// every resync test below resumes on.
fn bool resumed_line(fixture* f, u32 line) {
    return kept(f) == 4 && text(f, 0) == "x" && kind(f, 1) == "=" && kind(f, 2) == "integer literal"
        && kind(f, 3) == ";" && at(f, 0, line, 1);
}

// ---- bytes that start no token -------------------------------------------------
// D2.1, D2.10

fn void non_ascii_outside_strings_and_comments_is_an_error() {
    fixture mut f = open_fixture();
    defer close_fixture(&f);
    assert(one_error(&f, "x = \xC3\xA9;", 1, 5,
                     "non-ASCII byte outside a string literal or comment"));
    assert(kept(&f) == 0);
    // Two of the three bytes of the mark are not the mark.
    // D2.1
    assert(one_error(&f, "\xEF\xBBx", 1, 1,
                     "non-ASCII byte outside a string literal or comment"));
}

fn void unexpected_printable_character_is_an_error() {
    fixture mut f = open_fixture();
    defer close_fixture(&f);
    assert(one_error(&f, "a # b", 1, 3, "unexpected character '#'"));
    assert(one_error(&f, "#", 1, 1, "unexpected character '#'"));
    assert(one_error(&f, "`", 1, 1, "unexpected character '`'"));
    assert(one_error(&f, "$", 1, 1, "unexpected character '$'"));
    assert(one_error(&f, "\\", 1, 1, "unexpected character '\\'"));
}

// A byte that cannot be shown is named by its value (toolchain.md 4).
fn void unexpected_control_byte_is_an_error() {
    fixture mut f = open_fixture();
    defer close_fixture(&f);
    assert(one_error(&f, "\x01", 1, 1, "unexpected byte 0x01"));
    assert(one_error(&f, "x\x7F", 1, 2, "unexpected byte 0x7F"));
    assert(one_error(&f, "\x0C", 1, 1, "unexpected byte 0x0C"));
    assert(one_error(&f, "\x0B", 1, 1, "unexpected byte 0x0B"));
    // A fort string holds an embedded NUL, so the file really is one byte.
    assert(one_error(&f, "\x00", 1, 1, "unexpected byte 0x00"));
}

fn void error_position_counts_lines_columns_and_tabs() {
    fixture mut f = open_fixture();
    defer close_fixture(&f);
    assert(one_error(&f, "a\n\n\t\tb #", 3, 5, "unexpected character '#'"));
    // The lines before the error keep their tokens, the line of the error
    // loses them.
    // D14.2
    assert(kept(&f) == 1);
    assert(text(&f, 0) == "a");
}

// An error drops the whole line it stands on, the tokens lexed before it
// included, and the second error of that line is never reached, so one line
// costs one diagnostic.
// D14.2
fn void an_error_drops_its_line_and_reports_once() {
    fixture mut f = open_fixture();
    defer close_fixture(&f);
    assert(one_error(&f, "a b # c #", 1, 5, "unexpected character '#'"));
    assert(kept(&f) == 0);
}

// ---- resynchronisation after a lexical error ------------------------------------
// D14.2

// Every kind of lexical error costs its line alone: the line after it is
// lexed as though nothing had happened.
// D14.2
fn void every_error_kind_resumes_at_the_next_line() {
    fixture mut f = open_fixture();
    defer close_fixture(&f);
    assert(one_error(&f, "#\nx = 1;\n", 1, 1, "unexpected character '#'"));
    assert(resumed_line(&f, 2));
    assert(one_error(&f, "\x01\nx = 1;\n", 1, 1, "unexpected byte 0x01"));
    assert(resumed_line(&f, 2));
    assert(one_error(&f, "a \xC3\xA9\nx = 1;\n", 1, 3,
                     "non-ASCII byte outside a string literal or comment"));
    assert(resumed_line(&f, 2));
    assert(one_error(&f, "/* c */\nx = 1;\n", 1, 1,
                     "block comments are not supported, use '//'"));
    assert(resumed_line(&f, 2));
    assert(one_error(&f, "i32 const = 1;\nx = 1;\n", 1, 5, "'const' is a reserved word"));
    assert(resumed_line(&f, 2));
}

// The same for the literal forms: a bad number, a bad escape and a literal
// left open at the end of its line.
// D2.5, D2.8, D2.9
fn void a_broken_literal_resumes_at_the_next_line() {
    fixture mut f = open_fixture();
    defer close_fixture(&f);
    assert(one_error(&f, "i32 y = 08;\nx = 1;\n", 1, 9,
                     "decimal literal may not start with '0'"));
    assert(resumed_line(&f, 2));
    assert(one_error(&f, "i32 y = 0xZ;\nx = 1;\n", 1, 9, "hex literal needs at least one digit"));
    assert(resumed_line(&f, 2));
    assert(one_error(&f, "char c = '\\q';\nx = 1;\n", 1, 11, "unknown escape '\\q'"));
    assert(resumed_line(&f, 2));
    assert(one_error(&f, "string s = \"abc;\nx = 1;\n", 1, 12, "unterminated string literal"));
    assert(resumed_line(&f, 2));
    assert(one_error(&f, "char c = 'a\nx = 1;\n", 1, 10, "unterminated char literal"));
    assert(resumed_line(&f, 2));
}

// The lines before and after a broken line keep their tokens, so the vector
// covers the file with one line missing.
// D14.2
fn void an_error_line_stands_between_two_good_lines() {
    fixture mut f = open_fixture();
    defer close_fixture(&f);
    assert(one_error(&f, "a;\n#\nx = 1;\n", 2, 1, "unexpected character '#'"));
    assert(kept(&f) == 6);
    assert(text(&f, 0) == "a");
    assert(kind(&f, 1) == ";");
    assert(text(&f, 2) == "x");
    assert(at(&f, 2, 3, 1));
}

// Two errors on two lines are both reported, and the lines between and after
// them are lexed.
// D14.2
fn void two_errors_on_two_lines_are_both_reported() {
    fixture mut f = open_fixture();
    defer close_fixture(&f);
    assert(failed(&f, "a #\nb;\nc `\nx = 1;\n", 2));
    assert(error_is(&f, 0, 1, 3, "unexpected character '#'"));
    assert(error_is(&f, 1, 3, 3, "unexpected character '`'"));
    assert(kept(&f) == 6);
    assert(text(&f, 0) == "b");
    assert(text(&f, 2) == "x");
    assert(at(&f, 0, 2, 1));
    assert(at(&f, 2, 4, 1));
}

// An error on the last line, with no newline to resume after, still ends the
// vector in an end-of-file token at the end of the file.
// D14.2
fn void an_error_on_the_last_line_still_ends_in_eof() {
    fixture mut f = open_fixture();
    defer close_fixture(&f);
    assert(one_error(&f, "a;\nb #", 2, 3, "unexpected character '#'"));
    assert(kept(&f) == 2);
    assert(kind(&f, 2) == "end of file");
    assert(at(&f, 2, 2, 4));
    assert(covers(&f, 2, 6, 0));
}

// A file that is one broken line is the end-of-file token alone, which is
// what lets the parser run on it.
// D14.2
fn void a_file_of_one_broken_line_is_only_eof() {
    fixture mut f = open_fixture();
    defer close_fixture(&f);
    assert(one_error(&f, "#\n", 1, 1, "unexpected character '#'"));
    assert(kept(&f) == 0);
    assert(at(&f, 0, 2, 1));
}

// A string literal lexed after a resync is decoded like any other, so the
// pool is unaffected by the dropped line.
// D2.9
fn void a_literal_after_a_resync_is_decoded() {
    fixture mut f = open_fixture();
    defer close_fixture(&f);
    assert(one_error(&f, "s = \"ab;\nt = \"cd\";\n", 1, 5, "unterminated string literal"));
    assert(kept(&f) == 4);
    assert(text(&f, 0) == "t");
    assert(kind(&f, 2) == "string literal");
    assert(text(&f, 2) == "cd");
}

// A file reports at most twenty diagnostics, and lexing goes on silently past
// the cap, so the tokens of the lines after it are still there. The cap is
// the lexer's to check, not the sink's: diag.report records every diagnostic
// it is handed, and the lexer asks diag.budget_left before it reports,
// exactly as src/bootstrap/lexer.c does.
// D14.2
fn void a_file_reports_at_most_twenty_diagnostics() {
    fixture mut f = open_fixture();
    defer close_fixture(&f);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    u64 mut i = 0;
    while (i < 25) {
        strbuf.append(&b, "#\n");
        i += 1;
    }
    strbuf.append(&b, "x = 1;\n");
    assert(!lex(&f, strbuf.view(&b)));
    assert(errors(&f) == 20);
    assert(diag.record_count(session.diags(&f.sess)) == 20);
    assert(!diag.budget_left(session.diags(&f.sess)));
    // The twentieth error is the one on line 20; the five after it are
    // silent, and the line after them is lexed.
    assert(error_is(&f, 19, 20, 1, "unexpected character '#'"));
    assert(resumed_line(&f, 26));
}

// A second file through one session starts a budget of its own, since the
// lexer opens it with diag.begin_file.
// D14.2
fn void a_second_file_starts_a_new_budget() {
    fixture mut f = open_fixture();
    defer close_fixture(&f);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    u64 mut i = 0;
    while (i < 25) {
        strbuf.append(&b, "#\n");
        i += 1;
    }
    assert(!lex(&f, strbuf.view(&b)));
    assert(errors(&f) == 20);
    // lex resets the sink, so this is the count of the second file alone; the
    // budget was reopened either way, which the twenty-first error of one
    // file could not be.
    assert(one_error(&f, "#\n", 1, 1, "unexpected character '#'"));
    assert(diag.budget_left(session.diags(&f.sess)));
}

// A lone carriage return is whitespace, so it ends a line for a resync too: a
// file written with `\r` alone keeps the tokens after the bad line.
// D2.1
fn void a_carriage_return_ends_a_resync() {
    fixture mut f = open_fixture();
    defer close_fixture(&f);
    assert(one_error(&f, "a #\rx = 1;\r", 1, 3, "unexpected character '#'"));
    assert(kept(&f) == 4);
    assert(text(&f, 0) == "x");
    assert(one_error(&f, "a #\r\nx = 1;\n", 1, 3, "unexpected character '#'"));
    assert(resumed_line(&f, 2));
}

// The tokens of a file with no error are untouched by any of this, and a
// clean lex reports nothing at all.
fn void a_clean_file_reports_nothing() {
    fixture mut f = open_fixture();
    defer close_fixture(&f);
    assert(clean(&f, "fn main() {\n    return 0;\n}\n", 9));
    assert(diag.record_count(session.diags(&f.sess)) == 0);
    assert(diag.budget_left(session.diags(&f.sess)));
}

fn i32 main() {
    non_ascii_outside_strings_and_comments_is_an_error();
    unexpected_printable_character_is_an_error();
    unexpected_control_byte_is_an_error();
    error_position_counts_lines_columns_and_tabs();
    an_error_drops_its_line_and_reports_once();
    every_error_kind_resumes_at_the_next_line();
    a_broken_literal_resumes_at_the_next_line();
    an_error_line_stands_between_two_good_lines();
    two_errors_on_two_lines_are_both_reported();
    an_error_on_the_last_line_still_ends_in_eof();
    a_file_of_one_broken_line_is_only_eof();
    a_literal_after_a_resync_is_decoded();
    a_file_reports_at_most_twenty_diagnostics();
    a_second_file_starts_a_new_budget();
    a_carriage_return_ends_a_resync();
    a_clean_file_reports_nothing();
    println("ok");
    return 0;
}
