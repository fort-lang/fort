//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: fir.arm_push: too many arms
//! stdout:
//| 0
/// An arm number is a u32, so arm_push refuses a function that already has U32_LIMIT arms. The
/// test sets the count to that limit, and the call panics.
import consts;
import fir;
import prim;
import types;

fn main() i32 {
    types.table mut tt = types.table{};
    defer types.type_table_free(&tt);
    types.node* i32t = types.type_prim(&tt, prim.prim_kind.prim_i32);
    types.node*[1] params = {i32t};
    types.node* fnty = types.type_fn(&tt, i32t, params[..], false);
    fir.func mut f = fir.func_new(&tt, null, fnty);
    defer fir.func_free(&f);
    println(f.arms.len);
    f.arms.len = fir.U32_LIMIT;
    fir.arm_push(&f, consts.cv_from_i64(1), 0);
    return 0;
}
