//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: modules.file_at: index out of range
//! stdout:
//| 1
/// Checks the loaded-file index bound. file_at panics for an index past the last file.
import modules;
import modules_env;
import std.str;

fn main() i32 {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft", modules_env.src_main());
    assert(modules_env.load(&e, "main.ft"));
    assert(str.ends_with(modules.file_at(&e.set, 0), "main.ft"));
    println(modules.file_count(&e.set));
    println(modules.file_at(&e.set, 1));
    return 0;
}
