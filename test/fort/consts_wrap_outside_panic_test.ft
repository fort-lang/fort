//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: consts: typed constant folding on a value outside its type
//! stdout:
//| 45
/// Checks that wrapping operations reject an operand outside its type. The operation must not
/// fold only the low byte.
import consts;
import prim;

fn main() i32 {
    println(consts.cv_wrap_add(consts.cv_from_i64(44), consts.cv_from_i64(1),
                               prim.prim_kind.prim_u8).mag);
    println(consts.cv_wrap_add(consts.cv_from_i64(300), consts.cv_from_i64(1),
                               prim.prim_kind.prim_u8).mag);
    return 0;
}
