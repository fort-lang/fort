//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: ownership_state.correlations: capacity overflow
//! stdout:
//| 0
/// append_correlations refuses to add an entry after U64_MAX entries, because the count would
/// pass u64. The test sets correlations_len to U64_MAX, and the call panics.
import ownership_api;
import ownership_state;

fn main() i32 {
    ownership_state.state mut s = ownership_state.empty();
    defer ownership_state.free(&s);
    println(s.correlations_len);
    s.correlations_len = ownership_state.U64_MAX;
    ownership_state.append_correlations(&s, ownership_api.correlation{});
    return 0;
}
