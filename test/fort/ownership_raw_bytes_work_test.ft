//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| owner scan work ok
//| paired region work ok
//| paired region identities ok
//| batch sort boundaries ok
//| batch counts match sorted counts
//| batch count work ok
//| batch settle refusals ok
//| semantic move work ok
//| semantic move refusals ok
/// Tests that the byte owner scan, the paired region count and the semantic move pay W in
/// linear amounts.
import ownership_api;
import ownership_keys;
import ownership_raw;
import ownership_raw_bytes;
import ownership_raw_bytes_env;
import ownership_state;

struct work_sample {
    u64 write;
    u64 owner;
    u64 paired;
    bool completed;
}

// The B13 state: an empty owner at slot 1 that a zero write may overwrite. The extra
// allocations own separate slots, and the extra rows hold scalars at separate places.
fn build(ownership_raw_bytes_env.env mut* e, u64 allocations, u64 rows) void {
    ownership_raw_bytes_env.owner_setup(e, 23, false);
    u64 mut i = 0;
    while (i < allocations) {
        ownership_raw_bytes_env.add_allocation(e, 200 + cast(i, u32), 200 + cast(i, u32), 12);
        i += 1;
    }
    i = 0;
    while (i < rows) {
        ownership_api.contents_fact mut row = {};
        row.place = ownership_raw_bytes_env.place(e, 1000 + cast(i, u32));
        row.kind = ownership_api.contents_kind.scalar;
        ownership_state.append_contents(&e->core, row);
        i += 1;
    }
    ownership_raw_bytes_env.empty_source(e);
}

fn begin(ownership_raw_bytes_env.env mut* e, ownership_raw.request* req,
    ownership_raw.work_cursor mut* cursor) ownership_raw_bytes.work {
    ownership_raw_bytes_env.reset_budget(e);
    ownership_api.proof_status begun = ownership_raw.begin_work(e->paired.states[0].core,
        &e->service, req, cursor);
    assert(ownership_api.successful(begun));
    return ownership_raw_bytes.work{&e->service, &cursor->selected, begun, 0};
}

// Measures one zero write over the owner, then owner_empty and require_paired alone. Each
// amount after the write includes the one unit that begin_work pays.
fn sample(u64 allocations, u64 rows) work_sample {
    ownership_raw_bytes_env.env mut e = {};
    defer ownership_raw_bytes_env.close(&e);
    build(&e, allocations, rows);
    work_sample mut out = {};
    ownership_raw_bytes.result mut written = ownership_raw_bytes_env.try_effect(&e,
        ownership_raw_bytes_env.zero_change(&e, 1, 0, 8), 2200);
    defer ownership_raw_bytes.free_result(&written);
    out.completed = ownership_api.successful(written.proof);
    out.write = e.budget.meter.used.w;
    ownership_raw.request req = ownership_raw_bytes_env.request(&e, 2300);
    ownership_raw.work_cursor mut cursor = {};
    ownership_raw_bytes.work mut current = begin(&e, &req, &cursor);
    assert(ownership_raw_bytes.owner_empty(&current, &e.paired.states[0],
        ownership_raw_bytes_env.place(&e, 1)));
    out.owner = e.budget.meter.used.w;
    current = begin(&e, &req, &cursor);
    assert(ownership_raw_bytes.require_paired(&current, &e.paired.states[0],
        ownership_raw_bytes.retained_edit{}));
    out.paired = e.budget.meter.used.w;
    return out;
}

// An amount is additive when the cost of both additions is the sum of the two costs. A product
// term, such as the core price times the allocation count, breaks this.
fn additive(u64 base, u64 first, u64 second, u64 both) bool {
    return both - base == (first - base) + (second - base);
}

fn owner_scan_work() void {
    work_sample base = sample(0, 0);
    work_sample allocations = sample(50, 0);
    work_sample rows = sample(0, 500);
    work_sample both = sample(50, 500);
    // Each zero write completes within the production W of 65536.
    assert(base.completed && allocations.completed && rows.completed && both.completed);
    assert(base.write == 1534 && allocations.write == 6584);
    assert(rows.write == 50034 && both.write == 55084);
    assert(additive(base.write, allocations.write, rows.write, both.write));
    // owner_empty pays the core price once and the path price once for each allocation.
    assert(base.owner == 432 && allocations.owner == 2232);
    assert(rows.owner == 12432 && both.owner == 14232);
    assert(additive(base.owner, allocations.owner, rows.owner, both.owner));
    // Twice the allocations cost twice the increment, plus 4 units of the region count: its
    // full fixed array merges once (1 unit) and grows (2 units), and its settle pays for one
    // more group of 64 rows.
    work_sample doubled = sample(100, 0);
    assert(doubled.owner == 4036 && doubled.owner - base.owner ==
        2 * (allocations.owner - base.owner) + 4);
    println("owner scan work ok");
}

fn paired_region_work() void {
    work_sample base = sample(0, 0);
    work_sample allocations = sample(50, 0);
    work_sample rows = sample(0, 500);
    work_sample both = sample(50, 500);
    assert(base.paired == 174 && allocations.paired == 774);
    assert(rows.paired == 4674 && both.paired == 5274);
    assert(additive(base.paired, allocations.paired, rows.paired, both.paired));
    work_sample doubled = sample(100, 0);
    assert(doubled.paired == 1378 && doubled.paired - base.paired ==
        2 * (allocations.paired - base.paired) + 4);
    println("paired region work ok");
}

// Counts the paired regions of the current pair: distinct identities plus unknown ones.
fn paired_amount(ownership_raw_bytes_env.env mut* e) u64 {
    ownership_raw.request req = ownership_raw_bytes_env.request(e, 2400);
    ownership_raw.work_cursor mut cursor = {};
    ownership_raw_bytes.work mut current = begin(e, &req, &cursor);
    ownership_raw_bytes.state* paired = &e->paired.states[0];
    u64 mut amount = 0;
    assert(ownership_raw_bytes.paired_regions(&current, paired->core, &paired->raw,
        &paired->bytes, ownership_raw_bytes.retained_edit{}, &amount));
    return amount;
}

// The batch count sorts its identities and keeps one of each equal run. Rows that repeat a
// borrowed region add no identity; rows with new partitions add one each. Seventy rows take the
// count past 64 identities, so the merge sort runs.
fn paired_region_identities() void {
    u64[3] extra = {0, 70, 70};
    u64 mut before = 0;
    u64 mut kind = 0;
    while (kind < extra.len) {
        ownership_raw_bytes_env.env mut e = {};
        ownership_raw_bytes_env.owner_setup(&e, 25, false);
        u64 mut i = 0;
        while (i < extra[kind]) {
            // Kind 1 repeats region 1 and partition 21 of slot 1. Kind 2 gives new partitions.
            u32 version = kind == 1 ? 1 : 300 + cast(i, u32);
            ownership_state.append_contents(&e.core, ownership_raw_bytes_env.value(&e,
                400 + cast(i, u32), version, 1, 2, 6, 4));
            i += 1;
        }
        ownership_raw_bytes_env.recapture(&e, e.selected_type, 8);
        u64 amount = paired_amount(&e);
        if (kind == 0) { before = amount; }
        assert(amount == before + (kind == 2 ? extra[kind] : 0));
        ownership_raw_bytes_env.close(&e);
        kind += 1;
    }
    println("paired region identities ok");
}

// A batch count sorts up to 64 rows by insertion and more rows by a merge. Each size puts its
// rows in reverse key order, and the last row repeats the key of the first row, so the sort must
// move the last row past every other row before the equal rows meet.
fn batch_sort_boundaries() void {
    u32[6] sizes = {3, 63, 64, 65, 66, 129};
    u64 mut i = 0;
    while (i < sizes.len) {
        ownership_raw_bytes_env.env mut e = {};
        ownership_raw_bytes_env.owner_setup(&e, 26, false);
        ownership_raw.request req = ownership_raw_bytes_env.request(&e, 2500);
        ownership_raw.work_cursor mut cursor = {};
        ownership_raw_bytes.work mut current = begin(&e, &req, &cursor);
        ownership_state.region_counter mut regions = ownership_state.region_counter{
            .service = &e.service, .kind = ownership_api.work_kind.transfer,
            .proof = current.proof, .batch = true};
        ownership_raw_bytes.partition_counter mut partitions =
            ownership_raw_bytes.partition_counter{.batch = true};
        u32 n = sizes[i];
        u32 mut k = 0;
        while (k < n) {
            u32 ordinal = k == n - 1 ? n : n - k;
            assert(ownership_state.region_insert(&regions, ownership_state.region_identity{
                .region = ownership_raw_bytes_env.id(&e, ownership_api.entity_kind.region,
                    ordinal)}));
            assert(ownership_raw_bytes.partition_insert(&current, &partitions,
                ownership_raw_bytes.byte_partition{.source = ownership_raw_bytes_env.id(&e,
                    ownership_api.entity_kind.source, ordinal), .begin = 0, .end = 8}));
            k += 1;
        }
        assert(regions.len == cast(n, u64) && partitions.len == cast(n, u64));
        assert(ownership_state.region_settle(&regions));
        assert(ownership_raw_bytes.partition_settle(&current, &partitions));
        assert(regions.len == cast(n, u64) - 1 && partitions.len == cast(n, u64) - 1);
        // A settled count stays settled and pays nothing more. Its later inserts search, so an
        // equal identity adds nothing. Its entries stand in increasing order.
        u64 paid = e.budget.meter.used.w;
        assert(ownership_state.region_settle(&regions) && regions.len == cast(n, u64) - 1);
        assert(ownership_raw_bytes.partition_settle(&current, &partitions));
        assert(e.budget.meter.used.w == paid && partitions.len == cast(n, u64) - 1);
        assert(ownership_state.region_insert(&regions, ownership_state.region_identity{
            .region = ownership_raw_bytes_env.id(&e, ownership_api.entity_kind.region, n)}));
        assert(ownership_raw_bytes.partition_insert(&current, &partitions,
            ownership_raw_bytes.byte_partition{.source = ownership_raw_bytes_env.id(&e,
                ownership_api.entity_kind.source, n), .begin = 0, .end = 8}));
        assert(regions.len == cast(n, u64) - 1 && partitions.len == cast(n, u64) - 1);
        u64 mut j = 1;
        while (j < regions.len) {
            assert(ownership_state.region_order(ownership_state.region_entries(&regions)[j - 1],
                ownership_state.region_entries(&regions)[j]) < 0);
            assert(ownership_raw_bytes.partition_order(
                ownership_raw_bytes.partition_entries(&partitions)[j - 1],
                ownership_raw_bytes.partition_entries(&partitions)[j]) < 0);
            j += 1;
        }
        del(regions.identities);
        del(partitions.items);
        ownership_raw_bytes_env.close(&e);
        i += 1;
    }
    println("batch sort boundaries ok");
}

// Park-Miller, as in ownership_content_counts_test.ft: each product stays below 2^47.
struct generator { u64 seed; }

fn next(generator mut* g, u64 range) u64 {
    g->seed = g->seed * 48271 % 2147483647;
    return g->seed % range;
}

// Gives repeated regions and partitions, and sometimes a missing key, which proves no equality.
// The regions come from a pool of `pool` keys.
fn identity(ownership_raw_bytes_env.env* e, generator mut* g, u64 pool)
    ownership_state.region_identity {
    ownership_state.region_identity mut out = {};
    if (next(g, 10) != 0) {
        out.region = ownership_raw_bytes_env.id(e, ownership_api.entity_kind.region,
            1 + cast(next(g, pool), u32));
    }
    if (next(g, 3) == 0) {
        out.partitioned = true;
        if (next(g, 8) != 0) {
            out.partition = ownership_raw_bytes_env.id(e, ownership_api.entity_kind.region,
                100 + cast(next(g, 6), u32));
        }
    }
    return out;
}

// Gives both namespaces, empty intervals, repeated intervals, and sources without a key.
fn partition(ownership_raw_bytes_env.env* e, generator mut* g)
    ownership_raw_bytes.byte_partition {
    ownership_raw_bytes.byte_partition mut out = {};
    out.snapshot_namespace = next(g, 4) == 0;
    out.snapshot_key = 1 + next(g, 5);
    out.source = ownership_raw_bytes_env.id(e, ownership_api.entity_kind.source,
        cast(next(g, 21), u32));
    if (next(g, 12) == 0) { out.source.kind = ownership_api.entity_kind.region; }
    out.begin = next(g, 8);
    out.end = out.begin + next(g, 4);
    return out;
}

fn counter(ownership_raw_bytes_env.env* e, ownership_api.proof_status proof, bool batch)
    ownership_state.region_counter {
    return ownership_state.region_counter{.service = &e->service,
        .kind = ownership_api.work_kind.transfer, .proof = proof, .batch = batch};
}

// A batch count and a count by sorted insertion see the same rows. After the settle both hold
// the same distinct entries in the same order and the same unknown count. Each fourth round
// holds more than 64 rows, so the batch merges its full fixed array and its settle may run the
// merge sort. Each eighth round draws its regions from 2 keys, so the merged fixed array keeps
// few entries and takes many more rows. The batch of region identities, with its merges and its
// settle, pays no more W than sorted insertion of the same rows.
fn batch_matches_sorted() void {
    ownership_raw_bytes_env.env mut e = {};
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes_env.owner_setup(&e, 27, false);
    ownership_raw.request req = ownership_raw_bytes_env.request(&e, 2700);
    generator mut g = generator{4242};
    u64 mut round = 0;
    while (round < 120) {
        ownership_raw.work_cursor mut cursor = {};
        ownership_raw_bytes.work mut current = begin(&e, &req, &cursor);
        ownership_state.region_counter mut sorted = counter(&e, current.proof, false);
        ownership_state.region_counter mut batch = counter(&e, current.proof, true);
        ownership_raw_bytes.partition_counter mut ordered = {};
        ownership_raw_bytes.partition_counter mut appended =
            ownership_raw_bytes.partition_counter{.batch = true};
        u64 rows = round % 4 == 3 ? 65 + next(&g, 136) : next(&g, 65);
        u64 pool = round % 8 == 7 ? 2 : 40;
        u64 mut sorted_work = 0;
        u64 mut batch_work = 0;
        u64 mut k = 0;
        while (k < rows) {
            ownership_state.region_identity item = identity(&e, &g, pool);
            u64 start = e.budget.meter.used.w;
            assert(ownership_state.region_insert(&sorted, item));
            u64 middle = e.budget.meter.used.w;
            assert(ownership_state.region_insert(&batch, item));
            sorted_work += middle - start;
            batch_work += e.budget.meter.used.w - middle;
            ownership_raw_bytes.byte_partition part = partition(&e, &g);
            assert(ownership_raw_bytes.partition_insert(&current, &ordered, part));
            assert(ownership_raw_bytes.partition_insert(&current, &appended, part));
            k += 1;
        }
        u64 settling = e.budget.meter.used.w;
        assert(ownership_state.region_settle(&batch));
        batch_work += e.budget.meter.used.w - settling;
        assert(batch_work <= sorted_work);
        assert(ownership_raw_bytes.partition_settle(&current, &appended));
        assert(sorted.len == batch.len && sorted.unknown == batch.unknown);
        assert(ordered.len == appended.len && ordered.unknown == appended.unknown);
        k = 0;
        while (k < sorted.len) {
            assert(ownership_state.region_order(ownership_state.region_entries(&sorted)[k],
                ownership_state.region_entries(&batch)[k]) == 0);
            k += 1;
        }
        k = 0;
        while (k < ordered.len) {
            assert(ownership_raw_bytes.partition_order(
                ownership_raw_bytes.partition_entries(&ordered)[k],
                ownership_raw_bytes.partition_entries(&appended)[k]) == 0);
            k += 1;
        }
        del(sorted.identities);
        del(batch.identities);
        del(ordered.items);
        del(appended.items);
        round += 1;
    }
    println("batch counts match sorted counts");
}

fn units(u64 rows) u64 { return rows / 64 + (rows % 64 == 0 ? 0 : 1); }

// A region append pays one W unit. Its fixed array holds 64 rows. When it is full it merges
// equal rows (1 unit), and these distinct rows stay 64, so it grows. Growth from capacity c pays
// 1 + units(c). A partition append pays two units. Its storage holds 8 rows, and growth from
// capacity c pays 1 + c. Each settle pays units(rows). Sorted insertion pays one more unit for
// each row it compares or moves.
fn batch_cost(u64 rows, bool regions) u64 {
    u64 mut cost = regions ? rows : 2 * rows;
    if (regions && rows > 64) { cost += 1; }
    u64 mut capacity = regions ? 64 : 8;
    while (capacity < rows) {
        cost += 1 + (regions ? units(capacity) : capacity);
        capacity *= 2;
    }
    return cost + units(rows);
}

fn batch_count_work() void {
    u64[8] sizes = {0, 1, 8, 9, 64, 65, 129, 200};
    u64 mut i = 0;
    while (i < sizes.len) {
        ownership_raw_bytes_env.env mut e = {};
        ownership_raw_bytes_env.owner_setup(&e, 28, false);
        ownership_raw.request req = ownership_raw_bytes_env.request(&e, 2800);
        ownership_raw.work_cursor mut cursor = {};
        ownership_raw_bytes.work mut current = begin(&e, &req, &cursor);
        ownership_state.region_counter mut regions = counter(&e, current.proof, true);
        u64 start = e.budget.meter.used.w;
        u64 mut k = 0;
        while (k < sizes[i]) {
            // Distinct rows in reverse order: sorted insertion would move every row.
            assert(ownership_state.region_insert(&regions, ownership_state.region_identity{
                .region = ownership_raw_bytes_env.id(&e, ownership_api.entity_kind.region,
                    cast(sizes[i] - k, u32))}));
            k += 1;
        }
        assert(ownership_state.region_settle(&regions) && regions.len == sizes[i]);
        u64 middle = e.budget.meter.used.w;
        assert(middle - start == batch_cost(sizes[i], true));
        ownership_raw_bytes.partition_counter mut partitions =
            ownership_raw_bytes.partition_counter{.batch = true};
        k = 0;
        while (k < sizes[i]) {
            assert(ownership_raw_bytes.partition_insert(&current, &partitions,
                ownership_raw_bytes.byte_partition{.source = ownership_raw_bytes_env.id(&e,
                    ownership_api.entity_kind.source, cast(sizes[i] - k, u32)), .end = 1}));
            k += 1;
        }
        assert(ownership_raw_bytes.partition_settle(&current, &partitions));
        assert(partitions.len == sizes[i]);
        assert(e.budget.meter.used.w - middle == batch_cost(sizes[i], false));
        del(regions.identities);
        del(partitions.items);
        ownership_raw_bytes_env.close(&e);
        i += 1;
    }
    println("batch count work ok");
}

// A settle that cannot pay its units stops with a work limit and counts nothing more.
fn batch_settle_refusals() void {
    u64 mut kind = 0;
    while (kind < 2) {
        ownership_raw_bytes_env.env mut e = {};
        ownership_raw_bytes_env.owner_setup(&e, 29, false);
        e.limits.w = 1000;
        ownership_raw.request req = ownership_raw_bytes_env.request(&e, 2900);
        ownership_raw.work_cursor mut cursor = {};
        ownership_raw_bytes.work mut current = begin(&e, &req, &cursor);
        ownership_state.region_counter mut regions = counter(&e, current.proof, true);
        ownership_raw_bytes.partition_counter mut partitions =
            ownership_raw_bytes.partition_counter{.batch = true};
        u64 mut k = 0;
        while (k < 65) {
            u32 ordinal = 65 - cast(k, u32);
            if (kind == 0) {
                assert(ownership_state.region_insert(&regions, ownership_state.region_identity{
                    .region = ownership_raw_bytes_env.id(&e, ownership_api.entity_kind.region,
                        ordinal)}));
            } else {
                assert(ownership_raw_bytes.partition_insert(&current, &partitions,
                    ownership_raw_bytes.byte_partition{.source = ownership_raw_bytes_env.id(&e,
                        ownership_api.entity_kind.source, ordinal), .end = 1}));
            }
            k += 1;
        }
        // Leave one unit of the two that 65 rows need.
        e.budget.meter.used.w = e.limits.w - 1;
        if (kind == 0) {
            assert(!ownership_state.region_settle(&regions));
            assert(regions.proof.terminal.reason == ownership_api.incomplete_reason.work_limit);
        } else {
            assert(!ownership_raw_bytes.partition_settle(&current, &partitions));
            assert(current.proof.terminal.reason == ownership_api.incomplete_reason.work_limit);
        }
        assert(e.budget.meter.used.w == e.limits.w);
        del(regions.identities);
        del(partitions.items);
        ownership_raw_bytes_env.close(&e);
        kind += 1;
    }
    println("batch settle refusals ok");
}

// An allocation that owns its own slot and holds no history.
fn unrelated_allocation(ownership_raw_bytes_env.env mut* e, u32 key)
    ownership_api.allocation_fact {
    ownership_api.allocation_fact mut fact = {};
    fact.key = ownership_raw_bytes_env.id(e, ownership_api.entity_kind.allocation, key);
    fact.site = ownership_raw_bytes_env.id(e, ownership_api.entity_kind.allocation, 100 + key);
    fact.validity = ownership_api.validity_kind.live;
    fact.count.one = true;
    fact.obligation = true;
    fact.owner.place = ownership_raw_bytes_env.place(e, key);
    fact.logical_length = ownership_raw_bytes_env.exact(12);
    return fact;
}

// One move of the record { u8@ own owner; u8@ view; } from slot 1 to slot 2 over the populated
// owner state of the cleanup suites. The extra rows are scalars at slots 1000 + i, and the extra
// allocations own slots 2000 + i, so the move reads them but changes none of them.
fn move_work(u64 rows, u64 allocations) u64 {
    ownership_raw_bytes_env.env mut e = {};
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes_env.owner_rich(&e, 53);
    ownership_state.state mut* core = e.paired.states[0].core;
    u64 mut i = 0;
    while (i < rows) {
        ownership_api.contents_fact mut row = {};
        row.place = ownership_raw_bytes_env.place(&e, 1000 + cast(i, u32));
        row.kind = ownership_api.contents_kind.scalar;
        ownership_state.append_contents(core, row);
        i += 1;
    }
    i = 0;
    while (i < allocations) {
        ownership_state.append_allocations(core, unrelated_allocation(&e, 2000 + cast(i, u32)));
        i += 1;
    }
    u64 contents = core->contents_len;
    ownership_raw.request req = ownership_raw_bytes_env.move_request(&e, 1, 2, 133);
    ownership_raw_bytes_env.reset_budget(&e);
    ownership_raw_bytes.result mut moved = ownership_raw_bytes.semantic_move(&e.paired.states[0],
        &e.service, ownership_raw_bytes_env.window(&e, 1, 0, 32, e.selected_type),
        ownership_raw_bytes_env.window(&e, 2, 0, 32, e.selected_type), &req);
    defer ownership_raw_bytes.free_result(&moved);
    assert(ownership_api.successful(moved.proof) && moved.states.len == 1);
    ownership_state.state* next = moved.states[0].core;
    assert(next->allocations[0].owner.place.root.ordinal == 2);
    assert(next->allocations[0].history.len == 33);
    // The move removes the 3 facts of slot 2 and the 2 facts of slot 1. It appends the 2 moved
    // leaves and the 2 empty source leaves.
    assert(next->contents_len == contents - 1 && next->allocations_len == 2 + allocations);
    // The rows that the move does not touch keep their order, before the 4 appended facts.
    u64 first = contents - 5 - rows;
    i = 0;
    while (i < rows) {
        assert(next->contents[first + i].place.root.ordinal == 1000 + cast(i, u32));
        i += 1;
    }
    assert(next->contents[first - 1].place.root.ordinal < 1000);
    return e.budget.meter.used.w;
}

// At af02a72e the same move paid its copy price times (leaves + 1 + contents + allocations)
// times 8: 477403 W for the populated state, and each larger state refused at the bound, 589824
// W. Now the copy pays its price once and the transfer of places pays for each row it reads.
fn semantic_move_work() void {
    u64 base = move_work(0, 0);
    u64 rows = move_work(128, 0);
    u64 doubled = move_work(256, 0);
    assert(base == 20085 && rows == 36989 && doubled == 53893);
    // Twice the rows cost twice the increment: the rows add no square term. Each row adds 132
    // units: 24 for the copy price, 24 for each of the 4 representations that the move
    // rewrites, 8 in the scans of places and 4 in the region scans of 4 contents mutators. Those
    // mutators also pay one guard-count unit for each 64 rows: 8 units.
    assert(doubled - rows == rows - base && rows - base == 128 * 132 + 8);
    // Rows and allocations add their costs: no term multiplies one by the other.
    u64 allocations = move_work(0, 64);
    u64 both = move_work(128, 64);
    assert(allocations == 26841 && both == 43745);
    assert(additive(base, rows, allocations, both));
    // At 921548f4 each contents mutator counted its regions by sorted insertion, and 64 and 128
    // more allocations cost 51025 and 93402 W: the second 64 added 16 thousand units more than the
    // first. A batch count pays one unit for each identity it appends, so each 64 allocations add
    // the same work.
    u64 more = move_work(0, 128);
    assert(more == 33597);
    u64 first = allocations - base;
    u64 second = more - allocations;
    assert(first == 6756 && second == first);
    println("semantic move work ok");
}

// A refusal at any charge of a move publishes no successor and leaves the input as it was.
// The charge that routes events comes first and reports no event. After it, each W refusal
// reports one work failure, except the dispatch unit of the transfer of places. Six charges
// carry a precision request first: the byte kernel's 3 R requests report one event each, and the
// 3 requests of the state mutators (1 E, 2 R) record a precision loss and no event. Each round
// takes a new request: `same` makes a request too, and that rewrites the event binding that an
// older request borrows.
fn semantic_move_refusals() void {
    ownership_raw_bytes_env.env mut e = {};
    defer ownership_raw_bytes_env.close(&e);
    ownership_raw_bytes_env.owner_setup(&e, 31, false);
    ownership_raw_bytes.result mut before = ownership_raw_bytes_env.clone_input(&e);
    defer ownership_raw_bytes.free_result(&before);
    ownership_raw.request mut req = ownership_raw_bytes_env.move_request(&e, 1, 2, 3100);
    ownership_raw_bytes.window source = ownership_raw_bytes_env.window(&e, 1, 0, 8,
        e.selected_type);
    ownership_raw_bytes.window destination = ownership_raw_bytes_env.window(&e, 2, 0, 8,
        e.selected_type);
    ownership_raw.work_cursor mut cursor = {};
    ownership_raw_bytes_env.reset_budget(&e);
    assert(ownership_api.successful(ownership_raw.begin_work(e.paired.states[0].core,
        &e.service, &req, &cursor)));
    u64 route = e.budget.calls;
    req = ownership_raw_bytes_env.move_request(&e, 1, 2, 3100);
    ownership_raw_bytes_env.reset_budget(&e);
    ownership_raw_bytes.result mut control = ownership_raw_bytes.semantic_move(&e.paired.states[0],
        &e.service, source, destination, &req);
    assert(ownership_api.successful(control.proof) && control.states.len == 1);
    ownership_raw_bytes.free_result(&control);
    u64 cost = e.budget.calls;
    assert(cost == 1703 && route == 1);
    u64 mut silent = 0;
    u64 mut precision = 0;
    u64 mut reported = 0;
    u64 mut cut = 1;
    while (cut <= cost) {
        req = ownership_raw_bytes_env.move_request(&e, 1, 2, 3100);
        ownership_raw_bytes_env.reset_budget(&e);
        e.budget.events = 0;
        e.budget.deny_at = cut;
        ownership_raw_bytes.result mut out = ownership_raw_bytes.semantic_move(
            &e.paired.states[0], &e.service, source, destination, &req);
        assert(!ownership_api.successful(out.proof) && out.states.len == 0);
        assert(out.proof.terminal.reason == ownership_api.incomplete_reason.work_limit);
        assert(out.proof.terminal.limit.category == e.budget.denied.category);
        assert(out.proof.terminal.limit.attempted == e.budget.denied.attempted);
        assert(e.budget.calls == cut && e.budget.events <= 1);
        assert(ownership_keys.operation(out.proof.terminal.operation, req.base.operation) == 0);
        assert(ownership_keys.source(out.proof.terminal.source, req.base.source_position) == 0);
        if (e.budget.denied.category != ownership_api.limit_category.w) {
            precision += 1;
            reported += e.budget.events;
        } else if (cut <= route) { assert(e.budget.events == 0); }
        else if (e.budget.events == 0) { silent += 1; }
        else {
            assert(out.proof.terminal.limit.attempted == 1);
            assert(e.budget.last_event.kind == ownership_api.event_kind.work_failure);
        }
        ownership_raw_bytes.free_result(&out);
        ownership_raw_bytes_env.same(&e, &before.states[0]);
        cut += 1;
    }
    assert(silent == 1 && precision == 6 && reported == 3);
    println("semantic move refusals ok");
}

fn main() i32 {
    owner_scan_work();
    paired_region_work();
    paired_region_identities();
    batch_sort_boundaries();
    batch_matches_sorted();
    batch_count_work();
    batch_settle_refusals();
    semantic_move_work();
    semantic_move_refusals();
    return 0;
}
