//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| 33 kinds
//| ok
/// Checks FIR rvalues: the result type of each form, which forms produce an owning value, and
/// which produce an aggregate.
import consts;
import fir;
import fir_env;
import prim;
import types;

// A function over `fn add(i32 x, i64 y) u64` with the locals the samples read.
struct fixture {
    fir.func f;
    u32 real; // f64
    u32 real32; // f32
    u32 pair_local; // pair
    u32 ptr_local; // pair mut*
    u32 span_local; // i32 mut@ own
    u32 array_local; // i32[4]
    u32 str_local; // string
    u32 own_local; // u8 mut* own
    u32 fn_local; // fn (i32, i64) u64
    u32 n; // u64
}

fn temp(fir.func mut* f, types.node* ty) u32 {
    return fir.local_add(f, ty, fir.local_kind.lk_temp, null, fir_env.at(1, 1));
}

fn make(fir_env.env mut* e) fixture {
    fixture mut x = fixture{};
    x.f = fir_env.func_of(e, "add");
    types.table mut* tt = fir_env.tt(e);
    types.node* pair = fir_env.ty(e, "pair");
    x.real = temp(&x.f, fir_env.prim_ty(e, prim.prim_kind.prim_f64));
    x.real32 = temp(&x.f, fir_env.prim_ty(e, prim.prim_kind.prim_f32));
    x.pair_local = temp(&x.f, pair);
    x.ptr_local = temp(&x.f, types.type_ptr(tt, pair, false, true));
    x.span_local = temp(&x.f, types.type_span(tt, fir_env.i32_ty(e), true, true));
    x.array_local = temp(&x.f, types.type_array(tt, fir_env.i32_ty(e), 4));
    x.str_local = temp(&x.f, types.type_string(tt, false));
    types.node* u8t = fir_env.prim_ty(e, prim.prim_kind.prim_u8);
    x.own_local = temp(&x.f, types.type_ptr(tt, u8t, true, true));
    x.fn_local = temp(&x.f, fir_env.ty(e, "add"));
    x.n = temp(&x.f, fir_env.u64_ty(e));
    return x;
}

fn copy(u32 n) fir.operand {
    return fir.operand_copy(fir.place_local(n));
}

// One rvalue of `kind` and the spelling of its result type. The switch names every member of
// the enum and has no default, so a new member does not compile until it has a sample here. A
// binary sample takes two operands of different types, `i32` and `i64` or `f64` and `f32`, so a
// result that must be the type of the first operand cannot be the type of the second.
fn sample(fir_env.env mut* e, fixture mut* x, fir.rvalue_kind kind, fir.rvalue mut* out) string {
    fir.func mut* f = &x->f;
    fir.operand a = copy(1);
    fir.operand wide = copy(2);
    fir.operand real = copy(x->real);
    fir.operand narrow = copy(x->real32);
    switch (kind) {
    case fir.rvalue_kind.rv_use:
        *out = fir.rvalue_use(f, a);
        return "i32";
    case fir.rvalue_kind.rv_add, fir.rvalue_kind.rv_sub, fir.rvalue_kind.rv_mul,
        fir.rvalue_kind.rv_div, fir.rvalue_kind.rv_rem, fir.rvalue_kind.rv_and,
        fir.rvalue_kind.rv_or, fir.rvalue_kind.rv_xor, fir.rvalue_kind.rv_shl,
        fir.rvalue_kind.rv_shr:
        *out = fir.rvalue_binary(f, kind, a, wide);
        return "i32";
    case fir.rvalue_kind.rv_add_overflows, fir.rvalue_kind.rv_sub_overflows,
        fir.rvalue_kind.rv_mul_overflows, fir.rvalue_kind.rv_eq, fir.rvalue_kind.rv_ne,
        fir.rvalue_kind.rv_lt, fir.rvalue_kind.rv_le, fir.rvalue_kind.rv_gt,
        fir.rvalue_kind.rv_ge:
        *out = fir.rvalue_binary(f, kind, a, wide);
        return "bool";
    case fir.rvalue_kind.rv_not:
        *out = fir.rvalue_unary(f, kind, a);
        return "i32";
    case fir.rvalue_kind.rv_fadd, fir.rvalue_kind.rv_fsub, fir.rvalue_kind.rv_fmul,
        fir.rvalue_kind.rv_fdiv:
        *out = fir.rvalue_binary(f, kind, real, narrow);
        return "f64";
    case fir.rvalue_kind.rv_fneg:
        *out = fir.rvalue_unary(f, kind, real);
        return "f64";
    case fir.rvalue_kind.rv_cast:
        *out = fir.rvalue_cast(f, fir_env.i64_ty(e), a);
        return "i64";
    case fir.rvalue_kind.rv_addr:
        *out = fir.rvalue_addr(f, fir.place_local(x->pair_local), true);
        return "pair mut*";
    case fir.rvalue_kind.rv_slice:
        fir.operand lo = fir.operand_const(fir.const_int(fir_env.u64_ty(e), consts.cv_from_u64(0)));
        *out = fir.rvalue_slice(f, fir.place_local(x->span_local), lo, copy(x->n), false);
        return "i32 mut@";
    case fir.rvalue_kind.rv_slice_ptr:
        *out = fir.rvalue_slice_ptr(f, copy(x->ptr_local), copy(x->n), copy(x->n));
        return "pair mut@";
    case fir.rvalue_kind.rv_alloc:
        *out = fir.rvalue_alloc(f, fir_env.ty(e, "pair"), copy(x->n));
        return "pair mut* own";
    case fir.rvalue_kind.rv_aggregate:
        u32 first = fir.operand_push(f, a);
        fir.operand_push(f, copy(x->n));
        *out = fir.rvalue_aggregate_new(fir_env.ty(e, "pair"), first, 2);
        return "pair";
    case fir.rvalue_kind.rv_call:
        u32 args = fir.operand_push(f, a);
        fir.operand_push(f, copy(2));
        *out = fir.rvalue_call_fn(fir_env.sym(e, "add"), args, 2);
        return "u64";
    }
}

fn every_kind_has_its_result_type() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    u32 last = cast(fir.rvalue_kind.rv_call, u32);
    u32 mut k = 0;
    while (k <= last) {
        fir.rvalue_kind kind = cast(k, fir.rvalue_kind);
        fir.rvalue mut r = fir.rvalue{};
        string want = sample(&e, &x, kind, &r);
        assert(r.kind == kind);
        fir_env.expect(&e, fir.rvalue_type(&x.f, r), want);
        k += 1;
    }
    println(k, " kinds");
}

fn a_binary_rvalue_keeps_its_two_operands_in_order() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    fir.rvalue r = fir.rvalue_binary(&x.f, fir.rvalue_kind.rv_sub, copy(1), copy(x.n));
    assert(r.ops_len == 2);
    assert(fir.rvalue_operand(&x.f, r, 0).place.local == 1);
    assert(fir.rvalue_operand(&x.f, r, 1).place.local == x.n);
    // The type is the type of the first operand.
    fir.rvalue s = fir.rvalue_binary(&x.f, fir.rvalue_kind.rv_shl, copy(x.n), copy(1));
    fir_env.expect(&e, fir.rvalue_type(&x.f, s), "u64");
}

fn addr_gives_a_pointer_to_the_type_of_the_place() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    fir.place p = fir.place_field(&x.f, fir.place_local(x.pair_local), 1);
    fir_env.expect(&e, fir.rvalue_type(&x.f, fir.rvalue_addr(&x.f, p, false)), "u64*");
    fir_env.expect(&e, fir.rvalue_type(&x.f, fir.rvalue_addr(&x.f, p, true)), "u64 mut*");
}

fn a_slice_gives_the_span_of_its_place() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    fir.operand n = copy(x.n);
    // A fixed array gives a span whose `mut` the constructor states.
    fir.place arr = fir.place_local(x.array_local);
    fir_env.expect(&e, fir.rvalue_type(&x.f, fir.rvalue_slice(&x.f, arr, n, n, false)), "i32@");
    fir_env.expect(&e, fir.rvalue_type(&x.f, fir.rvalue_slice(&x.f, arr, n, n, true)),
                   "i32 mut@");
    // A span keeps its own `mut` and drops `own`, whatever the constructor states.
    fir.place span = fir.place_local(x.span_local);
    fir_env.expect(&e, fir.rvalue_type(&x.f, fir.rvalue_slice(&x.f, span, n, n, true)),
                   "i32 mut@");
    // A string gives a string.
    fir.place str = fir.place_local(x.str_local);
    fir_env.expect(&e, fir.rvalue_type(&x.f, fir.rvalue_slice(&x.f, str, n, n, false)),
                   "string");
    // A slice is a view, so a slice of a `string own` drops `own`.
    types.node* owned = types.type_string(fir_env.tt(&e), true);
    fir.place own_str = fir.place_local(temp(&x.f, owned));
    fir.rvalue view = fir.rvalue_slice(&x.f, own_str, n, n, false);
    fir_env.expect(&e, fir.rvalue_type(&x.f, view), "string");
    assert(!fir.rvalue_owns(&x.f, view));
}

fn a_call_gives_the_result_of_its_callee() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    u32 first = fir.operand_push(&x.f, copy(1));
    fir.operand_push(&x.f, copy(2));
    fir.rvalue direct = fir.rvalue_call_fn(fir_env.sym(&e, "add"), first, 2);
    assert(direct.callee == fir.callee_kind.cl_fn);
    fir_env.expect(&e, fir.rvalue_type(&x.f, direct), "u64");
    // An `extern fn`.
    u32 arg = fir.operand_push(&x.f, fir.operand_const(fir.const_bytes("x")));
    fir.rvalue ext = fir.rvalue_call_extern(fir_env.sym(&e, "puts"), arg, 1);
    assert(ext.callee == fir.callee_kind.cl_extern);
    fir_env.expect(&e, fir.rvalue_type(&x.f, ext), "i32");
    // An operand of function type.
    fir.rvalue value = fir.rvalue_call_value(copy(x.fn_local), first, 2);
    assert(value.callee == fir.callee_kind.cl_value);
    fir_env.expect(&e, fir.rvalue_type(&x.f, value), "u64");
    // A `noreturn` callee gives `void`.
    fir.rvalue stop = fir.rvalue_call_fn(fir_env.sym(&e, "stop"), first, 0);
    assert(fir.rvalue_type(&x.f, stop)->kind == types.type_kind.k_void);
}

// ---- rvalue_owns ------------------------------------------------------------------------

fn five_forms_produce_an_owning_value() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    fir.func mut* f = &x.f;
    assert(fir.rvalue_owns(f, fir.rvalue_alloc(f, fir_env.ty(&e, "pair"), copy(x.n))));
    // An aggregate of an owning struct.
    u32 first = fir.operand_push(f, fir.operand_move(fir.place_local(x.own_local)));
    fir.operand_push(f, copy(x.n));
    assert(fir.rvalue_owns(f, fir.rvalue_aggregate_new(fir_env.ty(&e, "holder"), first, 2)));
    // A cast to an owning type adopts.
    types.node* owned = fir.local_at(f, x.own_local)->ty;
    assert(fir.rvalue_owns(f, fir.rvalue_cast(f, owned, copy(x.n))));
    // A call with an owning result.
    assert(fir.rvalue_owns(f, fir.rvalue_call_fn(fir_env.sym(&e, "grab"), first, 0)));
    // A move operand.
    fir.operand taken = fir.operand_move(fir.place_local(x.own_local));
    assert(fir.rvalue_owns(f, fir.rvalue_use(f, taken)));
}

fn other_forms_do_not_own() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    fir.func mut* f = &x.f;
    // A copy of an owning place lends it.
    assert(!fir.rvalue_owns(f, fir.rvalue_use(f, copy(x.own_local))));
    // An aggregate, a cast and a call whose types do not own.
    u32 first = fir.operand_push(f, copy(1));
    fir.operand_push(f, copy(x.n));
    assert(!fir.rvalue_owns(f, fir.rvalue_aggregate_new(fir_env.ty(&e, "pair"), first, 2)));
    assert(!fir.rvalue_owns(f, fir.rvalue_cast(f, fir_env.i64_ty(&e), copy(1))));
    assert(!fir.rvalue_owns(f, fir.rvalue_call_fn(fir_env.sym(&e, "add"), first, 2)));
    assert(!fir.rvalue_owns(f, fir.rvalue_binary(f, fir.rvalue_kind.rv_add, copy(1), copy(1))));
    // An address and a slice are views.
    fir.place own_place = fir.place_local(x.own_local);
    assert(!fir.rvalue_owns(f, fir.rvalue_addr(f, own_place, true)));
    fir.place span = fir.place_local(x.span_local);
    assert(!fir.rvalue_owns(f, fir.rvalue_slice(f, span, copy(x.n), copy(x.n), true)));
}

// ---- rvalue_aggregate -------------------------------------------------------------------

fn aggregate_results_are_the_ones_of_the_rule() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    fir.func mut* f = &x.f;
    u32 first = fir.operand_push(f, copy(1));
    fir.operand_push(f, copy(x.n));
    assert(fir.rvalue_aggregate(f, fir.rvalue_aggregate_new(fir_env.ty(&e, "pair"), first, 2)));
    fir.place span = fir.place_local(x.span_local);
    assert(fir.rvalue_aggregate(f, fir.rvalue_slice(f, span, copy(x.n), copy(x.n), true)));
    fir.operand text = fir.operand_const(fir.const_string("hi"));
    assert(fir.rvalue_aggregate(f, fir.rvalue_use(f, text)));
    assert(fir.rvalue_aggregate(f, fir.rvalue_call_fn(fir_env.sym(&e, "make"), first, 0)));
    // A scalar result is not an aggregate.
    assert(!fir.rvalue_aggregate(f, fir.rvalue_binary(f, fir.rvalue_kind.rv_add, copy(1),
                                                       copy(1))));
    assert(!fir.rvalue_aggregate(f, fir.rvalue_call_fn(fir_env.sym(&e, "add"), first, 2)));
    assert(!fir.rvalue_aggregate(f, fir.rvalue_addr(f, span, false)));
}

// ---- constructors -----------------------------------------------------------------------

fn each_constructor_fills_the_fields_of_its_form() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    fir.func mut* f = &x.f;
    types.node* pair = fir_env.ty(&e, "pair");
    fir.rvalue conv = fir.rvalue_cast(f, fir_env.i64_ty(&e), copy(1));
    assert(conv.kind == fir.rvalue_kind.rv_cast && conv.ty == fir_env.i64_ty(&e));
    assert(conv.ops_len == 1);
    fir.rvalue addr = fir.rvalue_addr(f, fir.place_local(x.pair_local), true);
    assert(addr.kind == fir.rvalue_kind.rv_addr && addr.is_mut);
    assert(addr.place.local == x.pair_local && addr.ops_len == 0);
    fir.rvalue sl = fir.rvalue_slice(f, fir.place_local(x.array_local), copy(x.n), copy(x.n),
                                     true);
    assert(sl.kind == fir.rvalue_kind.rv_slice && sl.is_mut);
    assert(sl.place.local == x.array_local && sl.ops_len == 2);
    fir.rvalue sp = fir.rvalue_slice_ptr(f, copy(x.ptr_local), copy(x.n), copy(x.n));
    assert(sp.kind == fir.rvalue_kind.rv_slice_ptr && sp.ops_len == 3);
    assert(fir.rvalue_operand(f, sp, 0).place.local == x.ptr_local);
    fir.rvalue alloc = fir.rvalue_alloc(f, pair, copy(x.n));
    assert(alloc.kind == fir.rvalue_kind.rv_alloc && alloc.ty == pair);
    assert(fir.rvalue_operand(f, alloc, 0).place.local == x.n);
    u32 first = fir.operand_push(f, copy(1));
    fir.operand_push(f, copy(x.n));
    fir.rvalue agg = fir.rvalue_aggregate_new(pair, first, 2);
    assert(agg.kind == fir.rvalue_kind.rv_aggregate && agg.ty == pair);
    assert(agg.ops_first == first && agg.ops_len == 2);
    fir.rvalue call = fir.rvalue_call_extern(fir_env.sym(&e, "abs"), first, 1);
    assert(call.kind == fir.rvalue_kind.rv_call && call.callee == fir.callee_kind.cl_extern);
    assert(call.callee_sym == fir_env.sym(&e, "abs"));
    fir.rvalue value = fir.rvalue_call_value(copy(x.fn_local), first, 2);
    assert(value.callee_sym == null && value.callee_op.place.local == x.fn_local);
}

fn operands_of_consecutive_rvalues_do_not_mix() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    fir.func mut* f = &x.f;
    // Forty rvalues grow the operand vector past its first capacity. Each keeps its own two.
    fir.rvalue[40] mut made = {};
    u32 mut i = 0;
    while (i < 40) {
        u32 other = i % 3;
        made[cast(i, u64)] = fir.rvalue_binary(f, fir.rvalue_kind.rv_add, copy(1), copy(other));
        i += 1;
    }
    i = 0;
    while (i < 40) {
        fir.rvalue r = made[cast(i, u64)];
        assert(r.ops_first == 2 * i);
        assert(fir.rvalue_operand(f, r, 0).place.local == 1);
        assert(fir.rvalue_operand(f, r, 1).place.local == i % 3);
        i += 1;
    }
}

fn an_owning_array_aggregate_owns() void {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    fixture mut x = make(&e);
    defer fir.func_free(&x.f);
    fir.func mut* f = &x.f;
    types.table mut* tt = fir_env.tt(&e);
    // `holder[2]` holds an `own` pointer in each element; `pair[2]` holds none.
    types.node* holders = types.type_array(tt, fir_env.ty(&e, "holder"), 2);
    types.node* pairs = types.type_array(tt, fir_env.ty(&e, "pair"), 2);
    u32 first = fir.operand_push(f, copy(1));
    assert(fir.rvalue_owns(f, fir.rvalue_aggregate_new(holders, first, 0)));
    assert(!fir.rvalue_owns(f, fir.rvalue_aggregate_new(pairs, first, 0)));
    // A call whose result struct holds an `own` field owns.
    fir.rvalue keep = fir.rvalue_call_fn(fir_env.sym(&e, "keep"), first, 0);
    assert(fir.rvalue_owns(f, keep));
    assert(fir.rvalue_aggregate(f, keep));
    // A cast to an owning span adopts; a cast to its view does not.
    types.node* u8t = fir_env.prim_ty(&e, prim.prim_kind.prim_u8);
    assert(fir.rvalue_owns(f, fir.rvalue_cast(f, types.type_span(tt, u8t, true, true), copy(1))));
    assert(!fir.rvalue_owns(f, fir.rvalue_cast(f, types.type_span(tt, u8t, false, true),
                                               copy(1))));
}

fn main() i32 {
    every_kind_has_its_result_type();
    a_binary_rvalue_keeps_its_two_operands_in_order();
    addr_gives_a_pointer_to_the_type_of_the_place();
    a_slice_gives_the_span_of_its_place();
    a_call_gives_the_result_of_its_callee();
    five_forms_produce_an_owning_value();
    other_forms_do_not_own();
    aggregate_results_are_the_ones_of_the_rule();
    each_constructor_fills_the_fields_of_its_form();
    operands_of_consecutive_rvalues_do_not_mix();
    an_owning_array_aggregate_owns();
    println("ok");
    return 0;
}
