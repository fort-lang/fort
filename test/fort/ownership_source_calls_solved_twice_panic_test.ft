//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: ownership_source_calls: context is already solved
//! stdout:
//| true
/// solve runs the two solvers once for a closure. A context that is already solved breaks
/// that precondition, so a second call panics before it reads the graph.
import ownership_api;
import ownership_flow;
import ownership_graph;
import ownership_source_calls;

fn main() i32 {
    ownership_source_calls.context mut c = ownership_source_calls.context{.solved = true};
    println(c.solved);
    ownership_graph.graph mut g = ownership_graph.graph{};
    ownership_flow.source_file_binding@ files = {};
    ownership_api.source_position@ declarations = {};
    ownership_source_calls.solve(&c, &g, files, declarations);
    return 0;
}
