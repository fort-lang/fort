//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: ownership_source_calls: context is already solved
//! stdout:
//| 1
/// Checks that a second solve of one calls context panics: its rows and ledgers are owned.
import ownership_source_calls_env;

fn main() i32 {
    string[1] text = {"fn noop() void {}"};
    string[1] names = {"noop"};
    ownership_source_calls_env.closure mut c = ownership_source_calls_env.closure{};
    ownership_source_calls_env.run(&c, text[..], names[..]);
    println(1);
    ownership_source_calls_env.solve(&c);
    return 0;
}
