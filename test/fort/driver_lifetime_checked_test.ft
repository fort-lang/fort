//! run
//! flags: -I ../../src -I support
//! stdout:
//| ok
/// The program of this mode makes the checker allocate everything that it
/// owns. The checker gives all of it back.
import lifetime;
import std.strbuf;

//
// support/lifetime.ft states the rule of the probe, its view and the
// size of a round. Each file tests one driver mode. This keeps every program
// below the harness limit of 60 s under load.
//
// Deletion verified each release separately. Each deletion moved the live
// view past lifetime.BOUND and turned this test red. The checked releases
// include those of the session and the analysis of driver.compile_entry,
// which `session.drop_made` and `analysis_drop_made` reach, the pool in
// driver.load_closure and `del(b.data)` in driver.std_dir_beside. check.drop
// releases the symbol records with `del(ck.syms)`, `del(ck.values)`,
// `del(ck.externs)` and `del(ck.suffixes)`. It also releases the maps
// `ck.extern_first` and `ck.bad_imports`, the message `ck.msg`, and the type
// table with `types.table_drop`. The deletion of `del(ck.sized)` moved no
// probe: the program has no array whose layout is pending, so no round fills
// `sized`; test/aggregate_sites_test.py fails for it. The compiler refuses the
// program without the `del(s)` of each symbol. diag.drop releases the records
// and the pool of the sink, and session.drop the configuration. The program is
// what makes the refused import, the diagnostics and the message buffer
// reachable.
//
// The program also carries a function body. It covers the scopes opened by
// check_stmt.check_block, check_function_body, check_for, and check_range_for.
// Removing any of those four `scope.free` calls moves the live view past
// lifetime.BOUND. The body carries a
// `for (T x: coll)` as well as a `for (init; cond; step)` for that reason.
// A round opens the scope that makes the check_range_for release visible.
//
// At b6676ced this test was the only witness of `strmap.free(&ck->bad_imports)`,
// `strbuf.free(&ck->msg)`, the two releases of diag.free, `diag.free` in
// session.free, and both `scope.free(&header)` calls in check_for and
// check_range_for. Now it is the only witness of `del(ck.bad_imports.entries)`
// and `del(ck.msg.data)` in check.drop, and of the two releases of diag.drop
// and `diag.drop` in session.drop.
//
// Every release of the six modes was measured this way, one deletion at a
// time, against all six tests. support/lifetime.ft gives the release count and
// the measurement. It also names the releases whose deletion moved no probe,
// and says why for each.
fn main() i32 {
    lifetime.write_runtime();
    strbuf.str_buf mut program = strbuf.create();
    defer strbuf.free(&program);
    // An import that resolves to nothing leaves the checker the names that it
    // failed to bind. That is the one allocation a clean program never makes.
    strbuf.append(&program, "import nosuchmodule;\n");
    strbuf.append(&program, "extern fn puts(char* s) i32;\n");
    strbuf.append(&program, "i32 FOLDED = 41 + 1;\n");
    strbuf.append(&program, "i32 bad = nosuch;\n");
    // A body whose blocks the statement checker opens and closes. Every block
    // is a scope that owns its bindings, and a parameter scope stands around
    // the body in check_stmt.ft. A scope left unfreed is a leak that this
    // round sees and that a program of module-level declarations cannot.
    strbuf.append(&program, "fn sum(i32 n) i32 {\n    i32 mut total = 0;\n");
    strbuf.append(&program, "    for (i32 mut i = 0; i < n; i++) {\n");
    strbuf.append(&program, "        i32 step = i;\n        total += step;\n    }\n");
    strbuf.append(&program, "    i32[2] steps = {1, 2};\n");
    strbuf.append(&program, "    for (i32 s : steps) {\n        total += s;\n    }\n");
    strbuf.append(&program, "    switch (total) {\n    case 0:\n        i32 zero = 0;\n");
    strbuf.append(&program, "        total += zero;\n    default:\n    }\n");
    strbuf.append(&program, "    return total;\n}\n");
    strbuf.append(&program, "fn main() i32 {\n    return sum(3);\n}\n");
    lifetime.write_file("checked.ft", strbuf.view(&program));
    string[4] mut checked = {"fort", "--cfg", "mode=test", "checked.ft"};
    // The checker refuses `checked.ft`, so each round exits 1.
    u64 moved = lifetime.measure_status(checked[0..4], lifetime.ROUNDS,
        lifetime.EXIT_COMPILE_ERROR);
    assert(moved < lifetime.BOUND);
    println("ok");
    return 0;
}
