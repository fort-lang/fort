//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| ok
import lifetime;
import std.strbuf;

// The program of this mode makes the checker allocate everything that it
// owns. The checker gives all of it back.
// D20.5
//
// support/lifetime.ft states the rule of the probe, the two views and the
// size of a round. This file is one of six, one for each mode of the driver,
// because the harness kills a program at 60 s (toolchain.md 7.3) and the six
// modes in one program passed alone and timed out under load.
// T-094: one probe for each mode of the driver
//
// Verified by deletion, one release at a time, each one moving a view past
// lifetime.BOUND and turning this test red: the `defer session.free(&s)` and
// the `defer analysis_release(&an, &analysis_live)` of driver.compile_entry;
// the `defer containers.pool_free(&p)` of driver.load_closure and the `defer
// strbuf.free(&b)` of driver.std_dir_beside; the loop in check.check_free
// that frees the symbol records, `del(ck->syms)`,
// `del(ck->values)`, `del(ck->externs)`, `strmap.free(&ck->extern_first)`,
// `strmap.free(&ck->bad_imports)`, `strbuf.free(&ck->msg)` and
// `types.type_table_free`. That list is every release that check.check_free
// performs. The program is what makes the last five of them reachable.
//
// The program also carries a function body, so the scopes that
// check_stmt.check_block, check_function_body, check_for and check_range_for
// open are released here too: a deletion of any one of those four
// `scope.free` calls moves a view past lifetime.BOUND. The body carries a
// `for (T x : coll)` as well as a `for (init; cond; step)` for that reason.
// The release of check_range_for was invisible until a round opened the scope
// that it frees.
//
// This test is the only witness of `strmap.free(&ck->bad_imports)`, of
// `strbuf.free(&ck->msg)`, and of the two `scope.free(&header)` calls in
// check_for and check_range_for.
// Every release of the six modes was measured this way, one deletion at a
// time, against all six tests. The count of the releases of the six modes,
// the command that measures them and the one release that no single test
// witnesses stand in support/lifetime.ft, once for the six tests.
// T-094: one probe for each mode of the driver
fn i32 main() {
    lifetime.write_runtime();
    strbuf.str_buf mut program = strbuf.create();
    defer strbuf.free(&program);
    // An import that resolves to nothing leaves the checker the names that it
    // failed to bind. That is the one allocation a clean program never makes.
    // D14.2
    strbuf.append(&program, "import nosuchmodule;\n");
    strbuf.append(&program, "extern fn i32 puts(char* s);\n");
    strbuf.append(&program, "i32 FOLDED = 41 + 1;\n");
    strbuf.append(&program, "i32 bad = nosuch;\n");
    // A body whose blocks the statement checker opens and closes. Every block
    // is a scope that owns its bindings, and a parameter scope stands around
    // the body in check_stmt.ft. A scope left unfreed is a leak that this
    // round sees and that a program of module-level declarations cannot.
    // D7.9
    strbuf.append(&program, "fn i32 sum(i32 n) {\n    i32 mut total = 0;\n");
    strbuf.append(&program, "    for (i32 mut i = 0; i < n; i++) {\n");
    strbuf.append(&program, "        i32 step = i;\n        total += step;\n    }\n");
    strbuf.append(&program, "    i32[2] steps = {1, 2};\n");
    strbuf.append(&program, "    for (i32 s : steps) {\n        total += s;\n    }\n");
    strbuf.append(&program, "    switch (total) {\n    case 0:\n        i32 zero = 0;\n");
    strbuf.append(&program, "        total += zero;\n    default:\n    }\n");
    strbuf.append(&program, "    return total;\n}\n");
    strbuf.append(&program, "fn i32 main() {\n    return sum(3);\n}\n");
    lifetime.write_file("checked.ft", strbuf.view(&program));
    string[2] mut checked = {"fort", "checked.ft"};
    // The checker refuses `checked.ft`, so each round exits 1.
    // D14.1
    u64 moved = lifetime.measure_status(checked[0..2], lifetime.ROUNDS, true,
        lifetime.EXIT_COMPILE_ERROR);
    assert(moved < lifetime.BOUND);
    println("ok");
    return 0;
}
