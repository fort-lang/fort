//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: fir_llvm.translate_terminator: a check(overwrite) after the build-mode pass
//! stdout:
//| 2
/// The build-mode pass replaces each `check(overwrite: p)` by `goto` in every mode, so no such
/// check reaches the translator (spec/fir.md 11, 12.4). A function that skips the pass breaks
/// that precondition, so the translation of the check panics.
import fort.fir;
import fort.fir_llvm;
import llvm_env;

string[3] PRELUDE = {
    "struct unused {",
    "    i32 a;",
    "}",
};

string[11] TEXT = {
    "fn main.g() -> void {",
    "    let _1: u8 mut* own;",
    "",
    "    bb0: {",
    "        check(overwrite: _1) -> bb1 #1:1 s1;",
    "    }",
    "    bb1: {",
    "        _1 = const null u8 mut* own #1:1 s1;",
    "        return #1:1 s1;",
    "    }",
    "}",
};

// A panic ends the program, so the case stands in a file of its own.
fn main() i32 {
    llvm_env.env mut e = llvm_env.env{};
    llvm_env.open(&e);
    defer llvm_env.close(&e);
    fir.module mut m = llvm_env.parse(&e, PRELUDE[..], TEXT[..]);
    defer fir.module_free(&m);
    fir.func* f = fir.module_function_at(&m, 0);
    llvm_env.begin(&e.g);
    fir_llvm.translator mut t = fir_llvm.open(&e.g, f);
    defer fir_llvm.close(&t);
    println(fir.block_count(f));
    fir_llvm.translate_terminator(&t, 0);
    return 0;
}
