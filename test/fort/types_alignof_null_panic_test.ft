//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: types.type_alignof: alignof of void or null
//! stdout:
//| 1
import types;
import types_env;

// The null type has no size and no alignment.
// D10.5
fn i32 main() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    println(types.type_alignof(types_env.type_of(&e, "u8")));
    println(types.type_alignof(types.type_null(&e.tt)));
    return 0;
}
