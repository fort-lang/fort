//! run
//! flags: -I ../../src/fort
//! stdout:
//| named ok
//| sign ok
//| read back ok
//| ok
/// Checks flt.shortest, the shortest decimal that reads back as a binary64 value (D18.2), which
/// the interface writer prints each float constant with (module-system.md 10.3).
import flt;
import std.strbuf;

// The cases are generated by Python 3, whose repr of a float is the shortest decimal that reads
// back and, among those of that length, the nearest one. Each case gives the binary64 pattern,
// the digits with no trailing zero and the decimal exponent of the first digit, and the comment
// gives the repr. The values are zero, powers of two and of ten across the whole range, the
// limits of the normal and subnormal ranges, five f32 values widened to f64, and 210 values of a
// seeded random generator.

// Whether the shortest decimal of `bits` has the digits `digits` and the exponent `exponent`.
// A difference prints both.
fn shortest_is(u64 bits, string digits, i64 exponent) bool {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    i64 mut got = 0;
    flt.shortest(bits, &b, &got);
    if (strbuf.view(&b) == digits && got == exponent) {
        return true;
    }
    println("bits ", bits, ": got ", strbuf.view(&b), " e", got, ", want ", digits, " e", exponent);
    return false;
}

fn the_shortest_digits_of_each_case_are_the_ones_of_python() void {
    assert(shortest_is(0x0000000000000000, "0", 0)); // 0.0
    assert(shortest_is(0x3FF0000000000000, "1", 0)); // 1.0
    assert(shortest_is(0x3FE0000000000000, "5", -1)); // 0.5
    assert(shortest_is(0x4059000000000000, "1", 2)); // 100.0
    assert(shortest_is(0x3FB999999999999A, "1", -1)); // 0.1
    assert(shortest_is(0x3FC999999999999A, "2", -1)); // 0.2
    assert(shortest_is(0x3FD3333333333333, "3", -1)); // 0.3
    assert(shortest_is(0x3FD5555555555555, "3333333333333333", -1)); // 0.3333333333333333
    assert(shortest_is(0x3FE5555555555555, "6666666666666666", -1)); // 0.6666666666666666
    assert(shortest_is(0x44B52D02C7E14AF6, "1", 23)); // 1e+23
    assert(shortest_is(0x4480F0CF064DD592, "1", 22)); // 1e+22
    assert(shortest_is(0x4340000000000000, "9007199254740992", 15)); // 9007199254740992.0
    assert(shortest_is(0x0000000000000001, "5", -324)); // 5e-324
    assert(shortest_is(0x0000000000000002, "1", -323)); // 1e-323
    assert(shortest_is(0x0010000000000000, "22250738585072014", -308)); // 2.2250738585072014e-308
    assert(shortest_is(0x000FFFFFFFFFFFFF, "2225073858507201", -308)); // 2.225073858507201e-308
