// The sign bit does not change the digits: the caller writes the `-`.
fn the_sign_bit_is_ignored() void {
    assert(shortest_is(0x8000000000000000, "0", 0));
    assert(shortest_is(0xBFF0000000000000, "1", 0));
    assert(shortest_is(0xBFE0000000000000, "5", -1));
    assert(shortest_is(0xFFEFFFFFFFFFFFFF, "17976931348623157", 308));
    assert(shortest_is(0x8000000000000001, "5", -324));
}

// The decimal of `digits` and `exponent` as a literal that flt_parse reads.
fn literal(string digits, i64 exponent, strbuf.str_buf mut* out) string {
    strbuf.clear(out);
    strbuf.append(out, digits);
    strbuf.push(out, 'e');
    i64 scale = exponent - cast(digits.len, i64) + 1;
    strbuf.append_i64(out, scale);
    return strbuf.view(out);
}

// Whether the shortest decimal of `bits` reads back as `bits`, has no trailing zero, and has no
// more than 17 digits.
fn reads_back(u64 bits) bool {
    strbuf.str_buf mut digits = strbuf.create();
    defer strbuf.free(&digits);
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    i64 mut exponent = 0;
    flt.shortest(bits, &digits, &exponent);
    string d = strbuf.view(&digits);
    u64 mut back = 0;
    bool ok = flt.flt_parse(literal(d, exponent, &text), &back) && back == bits && d.len <= 17
        && (d.len == 1 || d[d.len - 1] != '0') && d[0] != '0';
    if (!ok) {
        println("bits ", bits, ": ", d, " e", exponent);
    }
    return ok;
}

// Every power of two of binary64, the subnormal ones included: the values next to which the
// interval below is the narrower one.
fn every_power_of_two_reads_back() void {
    u64 mut field = 1;
    while (field < 2047) {
        assert(reads_back(field << 52));
        field += 1;
    }
    u64 mut bit = 0;
    while (bit < 52) {
        assert(reads_back(cast(1, u64) << bit));
        bit += 1;
    }
}

// The neighbours of each power of ten that binary64 holds exactly, and of the limits.
fn the_neighbours_of_exact_values_read_back() void {
    u64[8] exact = {
        0x3FF0000000000000, 0x4024000000000000, 0x4059000000000000, 0x408F400000000000,
        0x44B52D02C7E14AF6, 0x7FEFFFFFFFFFFFFF, 0x0010000000000000, 0x000FFFFFFFFFFFFF,
    };
    u64 mut i = 0;
    while (i < exact.len) {
        assert(reads_back(exact[i]));
        assert(reads_back(exact[i] - 1));
        if (exact[i] < 0x7FEFFFFFFFFFFFFF) {
            assert(reads_back(exact[i] + 1));
        }
        i += 1;
    }
}

// Four thousand patterns of a linear congruential generator, its finite values only.
fn a_sample_of_patterns_reads_back() void {
    u64 mut state = 0x9E3779B97F4A7C15;
    u64 mut checked = 0;
    while (checked < 4000) {
        state = state *% 6364136223846793005 +% 1442695040888963407;
        u64 bits = state & 0x7FFFFFFFFFFFFFFF;
        if ((bits >> 52) != 0x7FF) {
            assert(reads_back(bits));
            checked += 1;
        }
    }
}

fn main() i32 {
    the_shortest_digits_of_each_case_are_the_ones_of_python();
    println("named ok");
    the_sign_bit_is_ignored();
    println("sign ok");
    every_power_of_two_reads_back();
    the_neighbours_of_exact_values_read_back();
    a_sample_of_patterns_reads_back();
    println("read back ok");
    println("ok");
    return 0;
}
