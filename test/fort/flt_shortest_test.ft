    assert(shortest_is(0x400921F9F01B866E, "314159", 0)); // 3.14159
    assert(shortest_is(0x4005BF0A8B145769, "2718281828459045", 0)); // 2.718281828459045
    assert(shortest_is(0x3DDB7CDFD9D7BDBB, "1", -10)); // 1e-10
