//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: ownership_source_local: invalid solve order
//! stdout:
//| false
/// solve runs once, after prepare. A context that prepare never filled breaks that order, so
/// the call panics before it runs the flow solver.
import ownership_source_local;

fn main() i32 {
    ownership_source_local.context mut c = ownership_source_local.context{};
    println(c.initialized);
    ownership_source_local.solve(&c);
    return 0;
}
