//! run
//! flags: -I ../../src -I support
//! stdout:
//| types ok
//| globals ok
//| declarations ok
//| definitions ok
//| ok
/// Checks the IR module of a unit whose closure holds interface modules (D9.11,
/// module-system.md 10.4): src/fort/gen_fir.ft declares each function of an interface module
/// with `declare dso_local ... #0`, src/fort/gen_data.ft writes each constant and global of it as
/// an external global, and the unit repeats the named type of each struct. The unit defines its
/// own modules alone, and its private data is numbered from 0. Each declaration carries the
/// types and the attributes of the definition that a whole-program build of the same sources
/// writes.
import fort.gen;
import fort.gen_fir;
import library_env;
import lower_env;
import modules_env;
import std.str;
import std.strbuf;

// The modules of the library `std` under `lib/std`: the runtime of lower_env, a module with a
// function of each signature form, an extern, two structs, an enum, a constant of each kind and
// a `mut` global, and a module that names the types of the first.
string[31] SHAPES = {
    "extern fn printf(char* fmt, ...) i32;",
    "struct vector { f64 x; f64 y; }",
    "struct box { vector lo; vector hi; u8[4] tag; }",
    "enum color { red, green = 5, blue }",
    "i32 DIM = 1 + 1;",
    "vector ORIGIN = {};",
    "vector UNIT_X = {1.0, 0.0};",
    "color FAVOURITE = color.blue;",
    "string NAME = \"shapes\";",
    "u8[4] TAG = {1, 2, 3, 4};",
    "i32* PDIM = &DIM;",
    "i32 mut calls = 7;",
    "fn add(vector a, vector b) vector {",
    "    calls += 1;",
    "    return vector{a.x + b.x, a.y + b.y};",
    "}",
    "fn scale(vector mut* v, f64 k) void {",
    "    v->x = v->x * k;",
    "}",
    "fn fail(string why) noreturn {",
    "    panic(why);",
    "}",
    "fn flag(bool b, u8 x, i8 y, u16 z, i16 w, char c) bool {",
    "    return b;",
    "}",
    "fn wide(i64 a, u32 b, f32 c, fn (i32) i32 f) i16 {",
    "    return 0;",
    "}",
    "fn main() i32 {",
    "    return 7;",
    "}",
};

string[9] PAINT = {
    "import std.shapes;",
    "shapes.color DEFAULT = shapes.color.green;",
    "fn mix(shapes.color a, shapes.color b) shapes.color {",
    "    return a;",
    "}",
    "fn area(shapes.box* b) f64 {",
    "    return (b->hi.x - b->lo.x) * (b->hi.y - b->lo.y);",
    "}",
    "fn (shapes.color, shapes.color) shapes.color MIXER = mix;",
};

// The client: it calls functions of both modules, reads constants and the `mut` global, prints an
// enum of the library and defines a constant and a function of its own.
string[19] CLIENT = {
    "import std.shapes;",
    "import std.paint;",
    "i32 OWN = 5;",
    "fn twice(i32 x) i32 {",
    "    return x * 2;",
    "}",
    "fn main() i32 {",
    "    shapes.vector a = shapes.vector{1.0, 2.0};",
    "    shapes.vector b = shapes.add(a, shapes.ORIGIN);",
    "    print(paint.mix(shapes.color.green, shapes.FAVOURITE));",
    "    println(shapes.NAME);",
    "    shapes.calls += 1;",
    "    u8 t = shapes.TAG[2];",
    "    i32* p = shapes.PDIM;",
    "    print(b.x);",
    "    print(t);",
    "    print(*p);",
    "    return twice(shapes.DIM + OWN);",
    "}",
};

fn add_library(library_env.env mut* e) void {
    library_env.add_lines(e, "lib/std/rt.ft", lower_env.RUNTIME[..]);
    library_env.add_lines(e, "lib/std/shapes.ft", SHAPES[..]);
    library_env.add_lines(e, "lib/std/paint.ft", PAINT[..]);
}

// The IR module of the client `lines` against the interface of the library, in `out`.
fn emit_unit(string@ lines, strbuf.str_buf mut* out) void {
    library_env.env mut lib = library_env.env{};
    library_env.open(&lib);
    defer library_env.close(&lib);
    add_library(&lib);
    assert(library_env.emit(&lib, "std", "lib/std"));
    library_env.env mut e = library_env.env{};
    library_env.open(&e);
    defer library_env.close(&e);
    library_env.add_lines(&e, "main.ft", lines);
    assert(library_env.check_against(&e, "std", "std.flib/interface.ft", library_env.text(&lib),
                                     "main.ft"));
    gen.emitter mut g = gen.emitter{};
    gen.gen_init(&g, &e.m.s, gen.gen_options{});
    defer gen.gen_free(&g);
    assert(gen_fir.gen_program(&g, &e.ck, &e.m.set));
    strbuf.clear(out);
    strbuf.append(out, strbuf.view(&g.out));
}

// The IR module of the same sources as one whole program: the library is a search root.
fn emit_whole(string@ lines, strbuf.str_buf mut* out) void {
    library_env.env mut e = library_env.env{};
    library_env.open(&e);
    defer library_env.close(&e);
    library_env.add_lines(&e, "lib/std/rt.ft", lower_env.RUNTIME[..]);
    library_env.add_lines(&e, "lib/std/shapes.ft", SHAPES[..]);
    library_env.add_lines(&e, "lib/std/paint.ft", PAINT[..]);
    library_env.add_lines(&e, "main.ft", lines);
    modules_env.std_dir_without_runtime(&e.m, "lib/std");
    assert(library_env.check_with_sources(&e, "lib", "main.ft"));
    gen.emitter mut g = gen.emitter{};
    gen.gen_init(&g, &e.m.s, gen.gen_options{});
    defer gen.gen_free(&g);
    assert(gen_fir.gen_program(&g, &e.ck, &e.m.set));
    strbuf.clear(out);
    strbuf.append(out, strbuf.view(&g.out));
}

// Whether `text` holds `part`, printing the text when it does not.
fn has(string text, string part) bool {
    if (str.find(text, part) < 0) {
        println("missing: ", part);
        return false;
    }
    return true;
}

// The number of times `part` stands in `text`.
fn count(string text, string part) u64 {
    u64 mut n = 0;
    u64 mut from = 0;
    while (from <= text.len) {
        i64 at = str.find(text[from..], part);
        if (at < 0) {
            break;
        }
        n += 1;
        from += cast(at, u64) + part.len;
    }
    return n;
}

// The lines of `text` that start with `prefix`, each with its newline, in order.
fn lines_with(string text, string prefix, strbuf.str_buf mut* out) string {
    strbuf.clear(out);
    u64 mut at = 0;
    while (at < text.len) {
        u64 mut end = at;
        while (end < text.len && text[end] != '\n') {
            end += 1;
        }
        string line = text[at..end];
        if (str.starts_with(line, prefix)) {
            strbuf.append(out, line);
            strbuf.push(out, '\n');
        }
        at = end + 1;
    }
    return strbuf.view(out);
}

// Whether `got` is `want`, printing both when they differ.
fn same(string got, string want) bool {
    if (got != want) {
        println("got:");
        print(got);
        println("want:");
        print(want);
    }
    return got == want;
}

// The lines joined, each with its newline. A line that ends with `++` continues on the next
// entry, so that no source line of this file passes 100 columns.
fn joined(string@ lines, strbuf.str_buf mut* out) string {
    strbuf.clear(out);
    u64 mut i = 0;
    while (i < lines.len) {
        string line = lines[i];
        if (str.ends_with(line, CONTINUED)) {
            strbuf.append(out, line[0..line.len - CONTINUED.len]);
        } else {
            strbuf.append(out, line);
            strbuf.push(out, '\n');
        }
        i += 1;
    }
    return strbuf.view(out);
}

string CONTINUED = "++";

// The number of functions of the runtime of lower_env, each of which the unit declares.
fn runtime_functions() u64 {
    u64 mut n = 0;
    for (string line : lower_env.RUNTIME) {
        if (str.starts_with(line, "fn ")) {
            n += 1;
        }
    }
    return n;
}

// ---- named types -------------------------------------------------------------------

// The named types of the unit: the two of every module, then each struct of the interface
// modules in dependency order and then in the order of the interface file, which is byte order
// of the name. `std.rt.enum_member` is `%fort.enum_member` and is not written twice.
string[5] NAMED = {
    "%fort.span = type { ptr, i64 }",
    "%fort.enum_member = type { i32, ptr }",
    "%struct.std.shapes.box = type { %struct.std.shapes.vector, %struct.std.shapes.vector, ++",
    "[4 x i8] }",
    "%struct.std.shapes.vector = type { double, double }",
};

fn the_unit_repeats_the_named_type_of_each_struct() void {
    strbuf.str_buf mut ir = strbuf.create();
    defer strbuf.free(&ir);
    emit_unit(CLIENT[..], &ir);
    strbuf.str_buf mut got = strbuf.create();
    defer strbuf.free(&got);
    strbuf.str_buf mut want = strbuf.create();
    defer strbuf.free(&want);
    assert(same(lines_with(strbuf.view(&ir), "%", &got), joined(NAMED[..], &want)));
}

// ---- globals -----------------------------------------------------------------------

// The globals section of the unit: each constant and global of the interface modules as an
// external global, in dependency order and then in the order of the interface file, and then
// the definition of the client's own constant.
string[11] GLOBALS = {
    "@\"std.shapes.DIM\" = external dso_local constant i32, align 4",
    "@\"std.shapes.FAVOURITE\" = external dso_local constant i32, align 4",
    "@\"std.shapes.NAME\" = external dso_local constant %fort.span, align 8",
    "@\"std.shapes.ORIGIN\" = external dso_local constant %struct.std.shapes.vector, align 8",
    "@\"std.shapes.PDIM\" = external dso_local constant ptr, align 8",
    "@\"std.shapes.TAG\" = external dso_local constant [4 x i8], align 1",
    "@\"std.shapes.UNIT_X\" = external dso_local constant %struct.std.shapes.vector, align 8",
    "@\"std.shapes.calls\" = external dso_local global i32, align 4",
    "@\"std.paint.DEFAULT\" = external dso_local constant i32, align 4",
    "@\"std.paint.MIXER\" = external dso_local constant ptr, align 8",
    "@\"main.OWN\" = dso_local constant i32 5, align 4",
};

fn each_constant_and_global_of_an_interface_module_is_external() void {
    strbuf.str_buf mut ir = strbuf.create();
    defer strbuf.free(&ir);
    emit_unit(CLIENT[..], &ir);
    strbuf.str_buf mut got = strbuf.create();
    defer strbuf.free(&got);
    strbuf.str_buf mut want = strbuf.create();
    defer strbuf.free(&want);
    assert(same(lines_with(strbuf.view(&ir), "@\"", &got), joined(GLOBALS[..], &want)));
}

fn the_private_data_of_the_unit_starts_at_zero() void {
    strbuf.str_buf mut ir = strbuf.create();
    defer strbuf.free(&ir);
    emit_unit(CLIENT[..], &ir);
    string text = strbuf.view(&ir);
    // the first file is the client's, the only module the unit defines a function of
    assert(has(text, "@.file.0 = private unnamed_addr constant ["));
    assert(has(text, "/main.ft\\00\", align 1\n"));
    assert(count(text, "@.file.1 =") == 0);
    // no initializer of the library is written, so the first string is the first member name of
    // the enum table that the first print of the client needs
    assert(has(text, "@.str.0 = private unnamed_addr constant [4 x i8] c\"red\\00\", align 1\n"));
    assert(has(text, "@.str.1 = private unnamed_addr constant [6 x i8] c\"green\\00\", align 1\n"));
    // the client folds the string constant of the library, as a whole program does, so its bytes
    // are a string of the unit once
    string folded = "@.str.3 = private unnamed_addr constant [7 x i8] c\"shapes\\00\", align 1\n";
    assert(has(text, folded));
    assert(count(text, "c\"shapes\\00\"") == 1);
}

fn a_read_of_a_constant_that_is_no_value_reads_the_external_global() void {
    strbuf.str_buf mut ir = strbuf.create();
    defer strbuf.free(&ir);
    emit_unit(CLIENT[..], &ir);
    string text = strbuf.view(&ir);
    // a copy of an aggregate constant, an element of one, a pointer constant, the `mut` global
    assert(has(text, "ptr align 8 @\"std.shapes.ORIGIN\", i64 16, i1 false)\n"));
    assert(has(text, "getelementptr inbounds [4 x i8], ptr @\"std.shapes.TAG\", i64 0, i64 "));
    assert(has(text, "load ptr, ptr @\"std.shapes.PDIM\", align 8\n"));
    assert(has(text, "load i32, ptr @\"std.shapes.calls\", align 4\n"));
    assert(has(text, ", ptr @\"std.shapes.calls\", align 4\n"));
    // a scalar constant is folded and reads no global
    assert(count(text, "@\"std.shapes.DIM\"") == 1);
}

fn an_enum_of_an_interface_module_has_a_private_table_in_the_unit() void {
    strbuf.str_buf mut ir = strbuf.create();
    defer strbuf.free(&ir);
    emit_unit(CLIENT[..], &ir);
    string text = strbuf.view(&ir);
    string table = "@.enum.std.shapes.color = private unnamed_addr constant [3 x %fort.enum_member";
    assert(has(text, table));
    string members =
        "[%fort.enum_member { i32 0, ptr @.str.0 }, %fort.enum_member { i32 5, ptr @.str.1 }, ";
    assert(has(text, members));
    assert(has(text, "%fort.enum_member { i32 6, ptr @.str.2 }], align 8\n"));
}

// ---- declarations ------------------------------------------------------------------

// The `declare` lines of the two modules of the library that the client names, in dependency
// order and then in the order of the interface file. The extern `printf` has none: it is a C
// function, which the unit declares only where a call names it.
string[9] DECLARED = {
    "declare dso_local void @\"std.shapes.add\"(ptr sret(%struct.std.shapes.vector), ptr, ptr) #0",
    "declare dso_local void @\"std.shapes.fail\"(ptr) #0",
    "declare dso_local zeroext i1 @\"std.shapes.flag\"(i1 zeroext, i8 zeroext, i8 signext, ++",
    "i16 zeroext, i16 signext, i8 zeroext) #0",
    "declare dso_local i32 @\"std.shapes.main\"() #0",
    "declare dso_local void @\"std.shapes.scale\"(ptr, double) #0",
    "declare dso_local signext i16 @\"std.shapes.wide\"(i64, i32, float, ptr) #0",
    "declare dso_local double @\"std.paint.area\"(ptr) #0",
    "declare dso_local i32 @\"std.paint.mix\"(i32, i32) #0",
};

fn each_function_of_an_interface_module_is_declared() void {
    strbuf.str_buf mut ir = strbuf.create();
    defer strbuf.free(&ir);
    emit_unit(CLIENT[..], &ir);
    string text = strbuf.view(&ir);
    strbuf.str_buf mut want = strbuf.create();
    defer strbuf.free(&want);
    strbuf.str_buf mut got = strbuf.create();
    defer strbuf.free(&got);
    // the runtime comes first, then std.shapes and std.paint; `mix` stands after `area`
    string mine = lines_with(text, "declare dso_local void @\"std.shapes.", &got);
    assert(str.starts_with(mine, "declare dso_local void @\"std.shapes.add\""));
    assert(has(text, joined(DECLARED[..], &want)));
    assert(count(text, "printf") == 0);
}

fn each_runtime_entry_is_declared_before_the_other_modules() void {
    strbuf.str_buf mut ir = strbuf.create();
    defer strbuf.free(&ir);
    emit_unit(CLIENT[..], &ir);
    string text = strbuf.view(&ir);
    strbuf.str_buf mut got = strbuf.create();
    defer strbuf.free(&got);
    string declared = lines_with(text, "declare dso_local ", &got);
    // each function of the runtime of lower_env, and the 6 and 2 of the library modules
    assert(count(declared, "\n") == runtime_functions() + 6 + 2);
    string first = "declare dso_local void @\"std.rt.assert_fail\"(ptr, ptr, i32, i32) #0\n";
    assert(str.starts_with(declared, first));
    string[2] last = {
        "declare dso_local zeroext i1 @\"std.rt.str_eq\"(ptr, i64, ptr, i64) #0",
        "declare dso_local void @\"std.shapes.add\"++",
    };
    strbuf.str_buf mut want = strbuf.create();
    defer strbuf.free(&want);
    assert(has(declared, joined(last[..], &want)));
    // print_enum takes the member table as one span, which a call passes as one hidden pointer
    assert(has(declared, "declare dso_local void @\"std.rt.print_enum\"(i32, i32, ptr) #0\n"));
    assert(has(declared, "declare dso_local void @\"std.rt.print_str\"(i32, ptr) #0\n"));
    assert(has(declared, "declare dso_local void @\"std.rt.panic\"(ptr, ptr, i32, i32) #0\n"));
    assert(has(declared, "declare dso_local void @\"std.rt.print_bool\"(i32, i1 zeroext) #0\n"));
    // the declarations stand before the C externs and the intrinsics, in one section
    i64 mix = str.find(text, "declare dso_local i32 @\"std.paint.mix\"(i32, i32) #0\n");
    assert(mix > 0);
    i64 intrinsic = str.find(text, "declare { i32, i1 } @llvm.smul.with.overflow.i32");
    assert(intrinsic > mix);
}

fn the_unit_defines_no_function_of_an_interface_module() void {
    strbuf.str_buf mut ir = strbuf.create();
    defer strbuf.free(&ir);
    emit_unit(CLIENT[..], &ir);
    string text = strbuf.view(&ir);
    strbuf.str_buf mut got = strbuf.create();
    defer strbuf.free(&got);
    string defined = lines_with(text, "define ", &got);
    string[3] want_lines = {
        "define dso_local i32 @\"main.twice\"(i32 %x.in) #0 {",
        "define dso_local i32 @\"main.main\"() #0 {",
        "define dso_local i32 @main(i32 %argc, ptr %argv) #0 {",
    };
    strbuf.str_buf mut want = strbuf.create();
    defer strbuf.free(&want);
    assert(same(defined, joined(want_lines[..], &want)));
    // each declared name is declared once and defined nowhere
    assert(count(text, "declare dso_local void @\"std.shapes.add\"(") == 1);
    assert(count(text, "call void @\"std.shapes.add\"(") == 1);
}

// A client with no function: only the declarations use the group `#0`.
string[2] NO_FUNCTION = {
    "import std.shapes;",
    "i32 X = 1;",
};

fn a_declaration_alone_emits_the_attribute_group_it_names() void {
    strbuf.str_buf mut ir = strbuf.create();
    defer strbuf.free(&ir);
    emit_unit(NO_FUNCTION[..], &ir);
    string text = strbuf.view(&ir);
    assert(count(text, "define ") == 0);
    assert(has(text, "declare dso_local i32 @\"std.shapes.main\"() #0\n"));
    assert(has(text, "attributes #0 = { nounwind \"frame-pointer\"=\"all\" "));
    assert(count(text, "attributes #1 ") == 0);
}

// ---- the definitions of the whole program -----------------------------------------

// The text of `line` from `from` to the `)` that closes the parameter list, with each parameter
// name ` %<name>` removed: what a definition and its declaration share. The group `#<n>` after
// the list is not part of it.
fn shape_of(string line, u64 from, strbuf.str_buf mut* out) string {
    strbuf.clear(out);
    u64 mut depth = 0;
    u64 mut i = from;
    while (i < line.len) {
        if (line[i] == ' ' && i + 1 < line.len && line[i + 1] == '%') {
            // skip the name up to the `,` or `)` after it
            i += 1;
            while (i < line.len && line[i] != ',' && line[i] != ')') {
                i += 1;
            }
        } else {
            strbuf.push(out, line[i]);
            if (line[i] == '(') {
                depth += 1;
            } else if (line[i] == ')') {
                depth -= 1;
                if (depth == 0) {
                    break;
                }
            }
            i += 1;
        }
    }
    return strbuf.view(out);
}

// The index of the first `ch` in `text` at or after `from`. `text` holds one there. The test below
// lends its buffers to each call, so the use rule of `move` and `del` (D17.21) asks a proof of each
// read through a pointer after the call; these reads stand in a frame of their own.
fn next_of(string text, u64 from, char ch) u64 {
    u64 mut i = from;
    while (text[i] != ch) {
        i += 1;
    }
    return i;
}

fn each_declaration_carries_the_types_of_the_whole_program_definition() void {
    strbuf.str_buf mut unit = strbuf.create();
    defer strbuf.free(&unit);
    emit_unit(CLIENT[..], &unit);
    strbuf.str_buf mut whole = strbuf.create();
    defer strbuf.free(&whole);
    emit_whole(CLIENT[..], &whole);
    // the whole program declares no fort function and has no external global
    assert(count(strbuf.view(&whole), "declare dso_local") == 0);
    assert(count(strbuf.view(&whole), "external") == 0);
    strbuf.str_buf mut declared_buf = strbuf.create();
    defer strbuf.free(&declared_buf);
    string declared = lines_with(strbuf.view(&unit), "declare dso_local ", &declared_buf);
    strbuf.str_buf mut defined_buf = strbuf.create();
    defer strbuf.free(&defined_buf);
    string defined = lines_with(strbuf.view(&whole), "define dso_local ", &defined_buf);
    strbuf.str_buf mut a = strbuf.create();
    defer strbuf.free(&a);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    u64 mut matched = 0;
    u64 mut at = 0;
    while (at < declared.len) {
        u64 end = next_of(declared, at, '\n');
        string line = declared[at..end];
        string want = shape_of(line, "declare dso_local ".len, &a);
        // the definition of the same symbol in the whole program
        u64 name_at = cast(str.find(line, "@\""), u64);
        u64 name_end = next_of(line, name_at + 2, '"');
        strbuf.str_buf mut name = strbuf.create();
        defer strbuf.free(&name);
        strbuf.append(&name, line[name_at..name_end + 1]);
        strbuf.push(&name, '(');
        u64 mut d = 0;
        u64 mut found = 0;
        while (d < defined.len) {
            u64 e = next_of(defined, d, '\n');
            string def = defined[d..e];
            if (str.find(def, strbuf.view(&name)) >= 0) {
                assert(same(shape_of(def, "define dso_local ".len, &b), want));
                found += 1;
            }
            d = e + 1;
        }
        assert(found == 1);
        matched += 1;
        at = end + 1;
    }
    assert(matched == runtime_functions() + 6 + 2);
}

fn main() i32 {
    the_unit_repeats_the_named_type_of_each_struct();
    println("types ok");
    each_constant_and_global_of_an_interface_module_is_external();
    the_private_data_of_the_unit_starts_at_zero();
    a_read_of_a_constant_that_is_no_value_reads_the_external_global();
    an_enum_of_an_interface_module_has_a_private_table_in_the_unit();
    println("globals ok");
    each_function_of_an_interface_module_is_declared();
    each_runtime_entry_is_declared_before_the_other_modules();
    the_unit_defines_no_function_of_an_interface_module();
    a_declaration_alone_emits_the_attribute_group_it_names();
    println("declarations ok");
    each_declaration_carries_the_types_of_the_whole_program_definition();
    println("definitions ok");
    println("ok");
    return 0;
}
