//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: flt.round_ratio: the quotient has more bits than the scaling allows
//! stdout:
//| true
//| 4607182418800017408
/// round_ratio scales by the bit counts of trimmed bignums, so the quotient has at most two
/// bits more than the mantissa. A divisor with a zero limb on top counts 32 bits for 2^23,
/// so the scaling is too large, and the call panics.
import flt;

fn main() i32 {
    flt.bignum mut num = flt.bignum{};
    flt.bignum mut den = flt.bignum{};
    flt.bn_set_u64(&num, 1);
    flt.bn_set_u64(&den, 1);
    u64 mut out = 0;
    println(flt.round_ratio(&num, &den, false, false, false, &out));
    println(out);
    flt.bn_set_u64(&num, 1);
    flt.bn_shl(&num, 100);
    den.limb[0] = 8388608;
    den.limb[1] = 0;
    den.len = 2;
    flt.round_ratio(&num, &den, false, false, false, &out);
    return 0;
}
