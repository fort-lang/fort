//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: fir.block_append: the block already has a terminator
//! stdout:
//| terminated
/// Checks that fir.block_append refuses a block that already has a terminator: the terminator is
/// the last operation of a block.
import diag;
import fir;
import prim;
import types;

fn main() i32 {
    types.table mut tt = types.table{};
    defer types.type_table_free(&tt);
    types.node* i32t = types.type_prim(&tt, prim.prim_kind.prim_i32);
    types.node*[1] params = {i32t};
    types.node* fnty = types.type_fn(&tt, i32t, params[..], false);
    fir.func mut f = fir.func_new(&tt, null, fnty);
    defer fir.func_free(&f);
    diag.loc here = diag.loc_make("t.ft", 1, 1);
    fir.block_append(&f, 0, fir.stmt_live(1, here, 1));
    fir.block_set_terminator(&f, 0, fir.term_return(here, 1));
    println("terminated");
    fir.block_append(&f, 0, fir.stmt_dead(1, here, 1));
    return 0;
}
