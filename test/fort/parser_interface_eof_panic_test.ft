//! run
//! flags: -I ../../src
//! abort
//! stderr: panic: parser.parse_interface: the token vector does not end in end of file
//! stdout:
//| 0
/// The loader gives parse_interface the tokens of one section with an end-of-file token after
/// them (modules.copy_tokens). A vector that does not end in one is a violated precondition.
import fort.ast;
import fort.lexer;
import fort.parser;
import fort.session;

fn main() i32 {
    session.session mut* own s = session.make();
    defer session.drop_made(move(s));
    lexer.tok_vec mut* own toks = lexer.tokvec_make();
    defer lexer.tokvec_drop_made(move(toks));
    ast.arena mut* own ar = ast.arena_make();
    defer ast.arena_drop_made(move(ar));
    println(lexer.tokvec_count(toks));
    ast.node mut* mod = parser.parse_interface(s, "interface.ft", toks, ar);
    println(ast.ast_len(mod));
    return 0;
}
