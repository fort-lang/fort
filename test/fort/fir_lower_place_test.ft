        "}",
        "box mut B1 = {};",
        "box mut B2 = {};",
        "box mut* mut P = &B1;",
        "i32 mut@ mut S = {};",
        "i32 mut@ mut* mut PS = &S;",
        "fn swap() i32 {",
        "    P = &B2;",
        "    return 0;",
        "}",
        "fn read() i32 {",
        "    return P->arr[swap()];",
        "}",
        "fn write() void {",
        "    P->arr[swap()] = 5;",
        "}",
        "fn span() i32 mut@ {",
        "    return P->arr[swap()..4];",
        "}",
        "fn address() i32 mut* {",
        "    return &P->arr[swap()];",
        "}",
        "fn through() i32 {",
        "    return (*PS)[swap()];",
        "}",
        "fn plain() i32 {",
        "    return S[swap()];",
        "}",
        "box* mut Q = &B1;",
        "fn readq() i32 {",
        "    return Q->arr[swap()];",
        "}",
        "i32 mut@@ W = {};",
        "fn nested(u64 j) i32 {",
        "    return W[j][swap()];",
        "}",
    };
    string[21] want = {
        "fn main.write() -> void {",
        "    let _0: void;",
        "    let _1: i32[4] mut* #17:6;",
        "    let _2: i32 #17:16;",
        "    let _3: u64 #17:11;",
        "    let _4: bool #17:11;",
        "    let _5: i64 #17:11;",
        "",
        "    bb0: {",
        "        _1 = addr mut((*global main.P).0) #17:6 s1;",
        "        _2 = call fn main.swap() #17:16 s1;",
        "        _3 = cast<u64>(copy _2) #17:11 s1;",
        "        _4 = ge(copy _3, const u64 4) #17:11 s1;",
        "        _5 = cast<i64>(copy _3) #17:11 s1;",
        "        check(copy _4, bounds, copy _5, const u64 4) -> bb1 #17:11 s1;",
        "    }",
        "    bb1: {",
        "        (*_1)[_3] = const i32 5 #17:20 s1;",
        "        return #18:1 s0;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "write"), want[..]);
}

// A bound that holds a writer holds the base of a span expression the same way.
fn a_span_holds_its_base_before_a_writer() void {
    lower_env.env mut e = lower_env.env{};
