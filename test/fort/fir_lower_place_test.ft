// `W[j]` reads the header of `W` to find its storage, so it is held after its own check and before
// `swap()`; the element span of `W` is not `mut`, so the address is `addr`.
fn a_held_base_behind_a_span_index() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[38] source = {
        "struct box {",
        "    i32[4] arr;",
        "}",
        "box mut B1 = {};",
        "box mut B2 = {};",
        "box mut* mut P = &B1;",
        "i32 mut@ mut S = {};",
        "i32 mut@ mut* mut PS = &S;",
        "fn swap() i32 {",
        "    P = &B2;",
        "    return 0;",
        "}",
        "fn read() i32 {",
        "    return P->arr[swap()];",
        "}",
        "fn write() void {",
        "    P->arr[swap()] = 5;",
        "}",
        "fn span() i32 mut@ {",
        "    return P->arr[swap()..4];",
        "}",
        "fn address() i32 mut* {",
        "    return &P->arr[swap()];",
        "}",
        "fn through() i32 {",
        "    return (*PS)[swap()];",
        "}",
        "fn plain() i32 {",
        "    return S[swap()];",
        "}",
        "box* mut Q = &B1;",
        "fn readq() i32 {",
        "    return Q->arr[swap()];",
        "}",
        "i32 mut@@ W = {};",
        "fn nested(u64 j) i32 {",
        "    return W[j][swap()];",
        "}",
    };
    string[30] want = {
        "fn main.nested(_1 (j): u64) -> i32 {",
        "    let _0: i32;",
        "    let _2: u64 #37:13;",
        "    let _3: bool #37:13;",
        "    let _4: i64 #37:13;",
        "    let _5: i32 mut@* #37:13;",
        "    let _6: i32 #37:21;",
        "    let _7: u64 #37:16;",
        "    let _8: bool #37:16;",
        "    let _9: i64 #37:16;",
        "",
        "    bb0: {",
        "        _2 = cast<u64>(copy _1) #37:13 s1;",
        "        _3 = ge(copy _2, copy global main.W.1) #37:13 s1;",
        "        _4 = cast<i64>(copy _2) #37:13 s1;",
        "        check(copy _3, bounds, copy _4, copy global main.W.1) -> bb1 #37:13 s1;",
        "    }",
        "    bb1: {",
        "        _5 = addr(global main.W[_2]) #37:13 s1;",
        "        _6 = call fn main.swap() #37:21 s1;",
        "        _7 = cast<u64>(copy _6) #37:16 s1;",
        "        _8 = ge(copy _7, copy (*_5).1) #37:16 s1;",
        "        _9 = cast<i64>(copy _7) #37:16 s1;",
        "        check(copy _8, bounds, copy _9, copy (*_5).1) -> bb2 #37:16 s1;",
        "    }",
        "    bb2: {",
        "        _0 = copy (*_5)[_7] #37:16 s1;",
        "        return #37:5 s1;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "nested"), want[..]);
}

// A writer in the high bound alone holds the base of the span expression too.
fn a_high_bound_alone_holds_the_base() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[21] source = {
        "struct box {",
        "    i32[4] arr;",
        "    i32 mut@@ sp2;",
        "}",
        "box mut B1 = {};",
        "box mut B2 = {};",
        "box mut* mut P = &B1;",
        "box mut@ mut BS = {};",
        "fn swap() i32 {",
        "    P = &B2;",
        "    return 0;",
        "}",
        "fn high() i32 mut@ {",
        "    return P->arr[0..swap()];",
        "}",
        "fn inner(u64 j) i32 {",
        "    return P->sp2[j][swap()];",
        "}",
        "fn element(u64 j) i32 mut@ {",
        "    return BS[j].arr[swap()..];",
        "}",
    };
    string[29] want = {
        "fn main.high() -> i32 mut@ {",
        "    let _0: i32 mut@;",
        "    let _1: i32[4] mut* #14:13;",
        "    let _2: u64 #14:18;",
        "    let _3: i32 #14:26;",
        "    let _4: u64 #14:18;",
        "    let _5: bool #14:18;",
        "    let _6: bool #14:18;",
        "    let _7: bool #14:18;",
        "    let _8: i64 #14:18;",
        "    let _9: i64 #14:18;",
        "",
        "    bb0: {",
        "        _1 = addr mut((*global main.P).0) #14:13 s1;",
        "        _2 = cast<u64>(const i32 0) #14:18 s1;",
        "        _3 = call fn main.swap() #14:26 s1;",
        "        _4 = cast<u64>(copy _3) #14:18 s1;",
        "        _5 = gt(copy _2, copy _4) #14:18 s1;",
        "        _6 = gt(copy _4, const u64 4) #14:18 s1;",
        "        _7 = or(copy _5, copy _6) #14:18 s1;",
        "        _8 = cast<i64>(copy _2) #14:18 s1;",
        "        _9 = cast<i64>(copy _4) #14:18 s1;",
        "        check(copy _7, span, copy _8, copy _9, const u64 4) -> bb1 #14:18 s1;",
        "    }",
        "    bb1: {",
        "        _0 = slice mut((*_1), copy _2, copy _4) #14:18 s1;",
        "        return #14:5 s1;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "high"), want[..]);
}

// `P->sp2[j]` reads the header of `sp2` last, a span that is not `mut`, so the held address is
// `addr` although `P` is `mut`.
fn the_mut_of_a_held_base_is_that_of_its_last_read() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[21] source = {
        "struct box {",
        "    i32[4] arr;",
        "    i32 mut@@ sp2;",
        "}",
        "box mut B1 = {};",
        "box mut B2 = {};",
        "box mut* mut P = &B1;",
        "box mut@ mut BS = {};",
        "fn swap() i32 {",
        "    P = &B2;",
        "    return 0;",
        "}",
        "fn high() i32 mut@ {",
        "    return P->arr[0..swap()];",
        "}",
        "fn inner(u64 j) i32 {",
        "    return P->sp2[j][swap()];",
        "}",
        "fn element(u64 j) i32 mut@ {",
        "    return BS[j].arr[swap()..];",
        "}",
    };
    string[30] want = {
        "fn main.inner(_1 (j): u64) -> i32 {",
        "    let _0: i32;",
        "    let _2: u64 #17:18;",
        "    let _3: bool #17:18;",
        "    let _4: i64 #17:18;",
        "    let _5: i32 mut@* #17:18;",
        "    let _6: i32 #17:26;",
        "    let _7: u64 #17:21;",
        "    let _8: bool #17:21;",
        "    let _9: i64 #17:21;",
        "",
        "    bb0: {",
        "        _2 = cast<u64>(copy _1) #17:18 s1;",
        "        _3 = ge(copy _2, copy (*global main.P).1.1) #17:18 s1;",
        "        _4 = cast<i64>(copy _2) #17:18 s1;",
        "        check(copy _3, bounds, copy _4, copy (*global main.P).1.1) -> bb1 #17:18 s1;",
        "    }",
        "    bb1: {",
        "        _5 = addr((*global main.P).1[_2]) #17:18 s1;",
        "        _6 = call fn main.swap() #17:26 s1;",
        "        _7 = cast<u64>(copy _6) #17:21 s1;",
        "        _8 = ge(copy _7, copy (*_5).1) #17:21 s1;",
        "        _9 = cast<i64>(copy _7) #17:21 s1;",
        "        check(copy _8, bounds, copy _9, copy (*_5).1) -> bb2 #17:21 s1;",
        "    }",
        "    bb2: {",
        "        _0 = copy (*_5)[_7] #17:21 s1;",
        "        return #17:5 s1;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "inner"), want[..]);
}

// `BS[j].arr` reads the header of the `mut` span `BS` last and no pointer, so the held address is
// `addr mut`.
fn a_held_base_behind_a_mut_span_is_mut() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[21] source = {
        "struct box {",
        "    i32[4] arr;",
        "    i32 mut@@ sp2;",
        "}",
        "box mut B1 = {};",
        "box mut B2 = {};",
        "box mut* mut P = &B1;",
        "box mut@ mut BS = {};",
        "fn swap() i32 {",
        "    P = &B2;",
        "    return 0;",
        "}",
        "fn high() i32 mut@ {",
        "    return P->arr[0..swap()];",
        "}",
        "fn inner(u64 j) i32 {",
        "    return P->sp2[j][swap()];",
        "}",
        "fn element(u64 j) i32 mut@ {",
        "    return BS[j].arr[swap()..];",
        "}",
    };
    string[36] want = {
        "fn main.element(_1 (j): u64) -> i32 mut@ {",
        "    let _0: i32 mut@;",
        "    let _2: u64 #20:14;",
        "    let _3: bool #20:14;",
        "    let _4: i64 #20:14;",
        "    let _5: i32[4] mut* #20:17;",
        "    let _6: i32 #20:26;",
        "    let _7: u64 #20:21;",
        "    let _8: bool #20:21;",
        "    let _9: bool #20:21;",
        "    let _10: bool #20:21;",
        "    let _11: i64 #20:21;",
        "    let _12: i64 #20:21;",
        "",
        "    bb0: {",
        "        _2 = cast<u64>(copy _1) #20:14 s1;",
        "        _3 = ge(copy _2, copy global main.BS.1) #20:14 s1;",
        "        _4 = cast<i64>(copy _2) #20:14 s1;",
        "        check(copy _3, bounds, copy _4, copy global main.BS.1) -> bb1 #20:14 s1;",
        "    }",
        "    bb1: {",
        "        _5 = addr mut(global main.BS[_2].0) #20:17 s1;",
        "        _6 = call fn main.swap() #20:26 s1;",
        "        _7 = cast<u64>(copy _6) #20:21 s1;",
        "        _8 = gt(copy _7, const u64 4) #20:21 s1;",
        "        _9 = gt(const u64 4, const u64 4) #20:21 s1;",
        "        _10 = or(copy _8, copy _9) #20:21 s1;",
        "        _11 = cast<i64>(copy _7) #20:21 s1;",
        "        _12 = cast<i64>(const u64 4) #20:21 s1;",
        "        check(copy _10, span, copy _11, copy _12, const u64 4) -> bb2 #20:21 s1;",
        "    }",
        "    bb2: {",
        "        _0 = slice mut((*_5), copy _7, const u64 4) #20:21 s1;",
        "        return #20:5 s1;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "element"), want[..]);
}

fn main() i32 {
    an_index_is_a_temporary_and_a_check();
    the_index_boundaries();
    println("index ok");
    an_index_holds_its_base_before_a_writer();
    an_assigned_index_holds_its_base();
    a_span_holds_its_base_before_a_writer();
    an_address_of_an_index_holds_its_base();
    a_span_behind_a_pointer_holds_the_pointer();
    a_span_with_no_deref_holds_nothing();
    a_held_base_behind_a_pointer_that_is_not_mut();
    a_held_base_behind_a_span_index();
    a_high_bound_alone_holds_the_base();
    the_mut_of_a_held_base_is_that_of_its_last_read();
    a_held_base_behind_a_mut_span_is_mut();
    println("hold ok");
    a_span_is_a_check_and_a_slice();
    a_span_of_a_string_and_of_a_pointer();
    an_empty_span_lowers_as_any_other();
    println("span ok");
    a_field_and_an_arrow();
    the_length_of_a_fixed_array_is_a_constant();
    a_dereference_and_an_address();
    an_rvalue_goes_into_a_temporary_first();
    the_operand_of_an_index_runs_before_its_index();
    an_element_of_an_aggregate_type();
    an_index_of_an_index_a_field_and_a_constant();
    println("field ok");
    return 0;
}
