        "    let _0: i32 mut@;",
        "    let _1: i32[4] mut* #20:13;",
        "    let _2: i32 #20:23;",
        "    let _3: u64 #20:18;",
        "    let _4: u64 #20:18;",
        "    let _5: bool #20:18;",
        "    let _6: bool #20:18;",
        "    let _7: bool #20:18;",
        "    let _8: i64 #20:18;",
        "    let _9: i64 #20:18;",
        "",
        "    bb0: {",
        "        _1 = addr mut((*global main.P).0) #20:13 s1;",
        "        _2 = call fn main.swap() #20:23 s1;",
        "        _3 = cast<u64>(copy _2) #20:18 s1;",
        "        _4 = cast<u64>(const i32 4) #20:18 s1;",
        "        _5 = gt(copy _3, copy _4) #20:18 s1;",
        "        _6 = gt(copy _4, const u64 4) #20:18 s1;",
        "        _7 = or(copy _5, copy _6) #20:18 s1;",
        "        _8 = cast<i64>(copy _3) #20:18 s1;",
        "        _9 = cast<i64>(copy _4) #20:18 s1;",
        "        check(copy _7, span, copy _8, copy _9, const u64 4) -> bb1 #20:18 s1;",
        "    }",
        "    bb1: {",
        "        _0 = slice mut((*_1), copy _3, copy _4) #20:18 s1;",
        "        return #20:5 s1;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "span"), want[..]);
}

// `&P->arr[swap()]` takes the address of an element of `B1`.
fn an_address_of_an_index_holds_its_base() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[38] source = {
        "struct box {",
        "    i32[4] arr;",
        "}",
        "box mut B1 = {};",
        "box mut B2 = {};",
        "box mut* mut P = &B1;",
        "i32 mut@ mut S = {};",
        "i32 mut@ mut* mut PS = &S;",
        "fn swap() i32 {",
        "    P = &B2;",
        "    return 0;",
        "}",
        "fn read() i32 {",
        "    return P->arr[swap()];",
        "}",
        "fn write() void {",
        "    P->arr[swap()] = 5;",
        "}",
        "fn span() i32 mut@ {",
        "    return P->arr[swap()..4];",
        "}",
        "fn address() i32 mut* {",
        "    return &P->arr[swap()];",
        "}",
        "fn through() i32 {",
        "    return (*PS)[swap()];",
        "}",
        "fn plain() i32 {",
        "    return S[swap()];",
        "}",
        "box* mut Q = &B1;",
        "fn readq() i32 {",
        "    return Q->arr[swap()];",
        "}",
        "i32 mut@@ W = {};",
        "fn nested(u64 j) i32 {",
        "    return W[j][swap()];",
        "}",
    };
    string[23] want = {
        "fn main.address() -> i32 mut* {",
        "    let _0: i32 mut*;",
        "    let _1: i32[4] mut* #23:14;",
        "    let _2: i32 #23:24;",
        "    let _3: u64 #23:19;",
        "    let _4: bool #23:19;",
        "    let _5: i64 #23:19;",
        "    let _6: i32 mut* #23:12;",
        "",
        "    bb0: {",
        "        _1 = addr mut((*global main.P).0) #23:14 s1;",
        "        _2 = call fn main.swap() #23:24 s1;",
        "        _3 = cast<u64>(copy _2) #23:19 s1;",
        "        _4 = ge(copy _3, const u64 4) #23:19 s1;",
        "        _5 = cast<i64>(copy _3) #23:19 s1;",
        "        check(copy _4, bounds, copy _5, const u64 4) -> bb1 #23:19 s1;",
        "    }",
        "    bb1: {",
        "        _6 = addr mut((*_1)[_3]) #23:12 s1;",
        "        _0 = copy _6 #23:12 s1;",
        "        return #23:5 s1;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "address"), want[..]);
}

// `(*PS)[swap()]` holds the value of `PS`, the address of the span header; the header itself is
// read after the call, where it is used, as for `S[swap()]` below.
fn a_span_behind_a_pointer_holds_the_pointer() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[38] source = {
        "struct box {",
        "    i32[4] arr;",
        "}",
        "box mut B1 = {};",
        "box mut B2 = {};",
        "box mut* mut P = &B1;",
        "i32 mut@ mut S = {};",
        "i32 mut@ mut* mut PS = &S;",
        "fn swap() i32 {",
        "    P = &B2;",
        "    return 0;",
        "}",
        "fn read() i32 {",
        "    return P->arr[swap()];",
        "}",
        "fn write() void {",
        "    P->arr[swap()] = 5;",
        "}",
        "fn span() i32 mut@ {",
        "    return P->arr[swap()..4];",
        "}",
        "fn address() i32 mut* {",
        "    return &P->arr[swap()];",
        "}",
        "fn through() i32 {",
        "    return (*PS)[swap()];",
        "}",
        "fn plain() i32 {",
        "    return S[swap()];",
        "}",
        "box* mut Q = &B1;",
        "fn readq() i32 {",
        "    return Q->arr[swap()];",
        "}",
        "i32 mut@@ W = {};",
        "fn nested(u64 j) i32 {",
        "    return W[j][swap()];",
        "}",
    };
    string[21] want = {
        "fn main.through() -> i32 {",
        "    let _0: i32;",
        "    let _1: i32 mut@ mut* #26:13;",
        "    let _2: i32 #26:22;",
        "    let _3: u64 #26:17;",
        "    let _4: bool #26:17;",
        "    let _5: i64 #26:17;",
        "",
        "    bb0: {",
        "        _1 = addr mut((*global main.PS)) #26:13 s1;",
        "        _2 = call fn main.swap() #26:22 s1;",
        "        _3 = cast<u64>(copy _2) #26:17 s1;",
        "        _4 = ge(copy _3, copy (*_1).1) #26:17 s1;",
        "        _5 = cast<i64>(copy _3) #26:17 s1;",
        "        check(copy _4, bounds, copy _5, copy (*_1).1) -> bb1 #26:17 s1;",
        "    }",
        "    bb1: {",
        "        _0 = copy (*_1)[_3] #26:17 s1;",
        "        return #26:5 s1;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "through"), want[..]);
}

// `S[swap()]` reads no memory to find the header of `S`, so nothing is held: the header and the
// element are read after the call, as on the direct path (D6.3).
fn a_span_with_no_deref_holds_nothing() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[38] source = {
        "struct box {",
        "    i32[4] arr;",
        "}",
        "box mut B1 = {};",
        "box mut B2 = {};",
        "box mut* mut P = &B1;",
        "i32 mut@ mut S = {};",
        "i32 mut@ mut* mut PS = &S;",
        "fn swap() i32 {",
        "    P = &B2;",
        "    return 0;",
        "}",
        "fn read() i32 {",
        "    return P->arr[swap()];",
        "}",
        "fn write() void {",
        "    P->arr[swap()] = 5;",
        "}",
        "fn span() i32 mut@ {",
        "    return P->arr[swap()..4];",
        "}",
        "fn address() i32 mut* {",
        "    return &P->arr[swap()];",
        "}",
        "fn through() i32 {",
        "    return (*PS)[swap()];",
        "}",
        "fn plain() i32 {",
        "    return S[swap()];",
        "}",
        "box* mut Q = &B1;",
        "fn readq() i32 {",
        "    return Q->arr[swap()];",
        "}",
        "i32 mut@@ W = {};",
        "fn nested(u64 j) i32 {",
        "    return W[j][swap()];",
        "}",
    };
    string[19] want = {
        "fn main.plain() -> i32 {",
        "    let _0: i32;",
        "    let _1: i32 #29:18;",
        "    let _2: u64 #29:13;",
        "    let _3: bool #29:13;",
        "    let _4: i64 #29:13;",
        "",
        "    bb0: {",
        "        _1 = call fn main.swap() #29:18 s1;",
        "        _2 = cast<u64>(copy _1) #29:13 s1;",
        "        _3 = ge(copy _2, copy global main.S.1) #29:13 s1;",
        "        _4 = cast<i64>(copy _2) #29:13 s1;",
        "        check(copy _3, bounds, copy _4, copy global main.S.1) -> bb1 #29:13 s1;",
        "    }",
        "    bb1: {",
        "        _0 = copy global main.S[_2] #29:13 s1;",
        "        return #29:5 s1;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "plain"), want[..]);
}

