//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| index ok
//| hold ok
//| span ok
//| field ok
/// Checks the lowering of places (spec/fir.md 9.4, 5.5): names, fields, `->`, `.len` and `.ptr`,
/// `*p`, `&lv`, `a[i]` with its bounds check, and `a[lo..hi]` with its span check.
import lower_env;


// `a[i]` on a fixed array and on a `string`: the index goes into a `u64` temporary by a cast, which
// sign-extends a signed index, and the check reports it as an `i64` beside the length. The length
// of a fixed array is a constant, and that of a `string` is field 1 (D6.8).
fn an_index_is_a_temporary_and_a_check() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[4] source = {
        "fn f(i32[4] a, i32 i, string s, u8 k) char {",
        "    i32 x = a[i];",
        "    return s[k];",
        "}",
    };
    string[30] want = {
        "fn main.f(_1 (a): i32[4], _2 (i): i32, _3 (s): string, _4 (k): u8) -> char {",
        "    let _0: char;",
        "    let _5 (x): i32 #2:9;",
        "    let _6: u64 #2:14;",
        "    let _7: bool #2:14;",
        "    let _8: i64 #2:14;",
        "    let _9: u64 #3:13;",
        "    let _10: bool #3:13;",
        "    let _11: i64 #3:13;",
        "",
        "    bb0: {",
        "        live(_5) #2:9 s1;",
        "        _6 = cast<u64>(copy _2) #2:14 s1;",
        "        _7 = ge(copy _6, const u64 4) #2:14 s1;",
        "        _8 = cast<i64>(copy _6) #2:14 s1;",
        "        check(copy _7, bounds, copy _8, const u64 4) -> bb1 #2:14 s1;",
        "    }",
        "    bb1: {",
        "        _5 = copy _1[_6] #2:14 s1;",
        "        _9 = cast<u64>(copy _4) #3:13 s2;",
        "        _10 = ge(copy _9, copy _3.1) #3:13 s2;",
        "        _11 = cast<i64>(copy _9) #3:13 s2;",
        "        check(copy _10, bounds, copy _11, copy _3.1) -> bb2 #3:13 s2;",
        "    }",
        "    bb2: {",
        "        _0 = copy _3[_9] #3:13 s2;",
        "        dead(_5) #3:5 s2;",
        "        return #3:5 s2;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "f"), want[..]);
}

// A negative index is an operation whose result the cast sign-extends, so it fails the one
// unsigned compare. An index of `u64` casts to its own type, an `i8` index widens, and the last
// element of a fixed array lowers as any other. The checker refuses a negative constant index and
// a constant index past the end (D6.8), so the lowering never meets them.
fn the_index_boundaries() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[6] source = {
        "fn f(i32[4] a, i32 i, u64 u, i8 b) i32 {",
        "    i32 x = a[-i];",
        "    i32 y = a[u];",
        "    i32 z = a[b];",
        "    return a[3];",
        "}",
    };
    string[63] want = {
        "fn main.f(_1 (a): i32[4], _2 (i): i32, _3 (u): u64, _4 (b): i8) -> i32 {",
        "    let _0: i32;",
        "    let _5 (x): i32 #2:9;",
        "    let _6 (y): i32 #3:9;",
        "    let _7 (z): i32 #4:9;",
        "    let _8: bool #2:15;",
        "    let _9: i32 #2:15;",
        "    let _10: u64 #2:14;",
        "    let _11: bool #2:14;",
        "    let _12: i64 #2:14;",
        "    let _13: u64 #3:14;",
        "    let _14: bool #3:14;",
        "    let _15: i64 #3:14;",
        "    let _16: u64 #4:14;",
        "    let _17: bool #4:14;",
        "    let _18: i64 #4:14;",
        "    let _19: u64 #5:13;",
        "    let _20: bool #5:13;",
        "    let _21: i64 #5:13;",
        "",
        "    bb0: {",
        "        live(_5) #2:9 s1;",
        "        _8 = sub_overflows(const i32 0, copy _2) #2:15 s1;",
        "        check(copy _8, overflow) -> bb1 #2:15 s1;",
        "    }",
        "    bb1: {",
        "        _9 = sub(const i32 0, copy _2) #2:15 s1;",
        "        _10 = cast<u64>(copy _9) #2:14 s1;",
        "        _11 = ge(copy _10, const u64 4) #2:14 s1;",
        "        _12 = cast<i64>(copy _10) #2:14 s1;",
        "        check(copy _11, bounds, copy _12, const u64 4) -> bb2 #2:14 s1;",
        "    }",
        "    bb2: {",
        "        _5 = copy _1[_10] #2:14 s1;",
        "        live(_6) #3:9 s2;",
        "        _13 = cast<u64>(copy _3) #3:14 s2;",
        "        _14 = ge(copy _13, const u64 4) #3:14 s2;",
        "        _15 = cast<i64>(copy _13) #3:14 s2;",
        "        check(copy _14, bounds, copy _15, const u64 4) -> bb3 #3:14 s2;",
        "    }",
        "    bb3: {",
        "        _6 = copy _1[_13] #3:14 s2;",
        "        live(_7) #4:9 s3;",
        "        _16 = cast<u64>(copy _4) #4:14 s3;",
        "        _17 = ge(copy _16, const u64 4) #4:14 s3;",
        "        _18 = cast<i64>(copy _16) #4:14 s3;",
        "        check(copy _17, bounds, copy _18, const u64 4) -> bb4 #4:14 s3;",
        "    }",
        "    bb4: {",
        "        _7 = copy _1[_16] #4:14 s3;",
        "        _19 = cast<u64>(const i32 3) #5:13 s4;",
        "        _20 = ge(copy _19, const u64 4) #5:13 s4;",
        "        _21 = cast<i64>(copy _19) #5:13 s4;",
        "        check(copy _20, bounds, copy _21, const u64 4) -> bb5 #5:13 s4;",
        "    }",
        "    bb5: {",
        "        _0 = copy _1[_19] #5:13 s4;",
        "        dead(_5) #5:5 s4;",
        "        dead(_6) #5:5 s4;",
        "        dead(_7) #5:5 s4;",
        "        return #5:5 s4;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "f"), want[..]);
    string[3] negative = {"fn h(i32[4] a) i32 {", "    return a[-1];", "}"};
    assert(lower_env.diagnostic(&e, negative[..]) == "2:14: a negative index: -1");
    string[3] past = {"fn k(i32[4] a) i32 {", "    return a[4];", "}"};
    assert(lower_env.diagnostic(&e, past[..]) == "2:13: index 4 out of range for i32[4]");
}

// `a[lo..hi]` on a fixed array and a span: each bound as a `u64` temporary, `0` and the length for
// an absent bound, the `or` of two `gt`, the span check with both bounds as `i64`, then `slice`,
// which is `slice mut` for a `mut` span of a fixed array (D6.9).
fn a_span_is_a_check_and_a_slice() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[9] source = {
        "fn f(i32[4] mut a, u8@ s, i64 lo, u32 hi) void {",
        "    i32 mut@ w = a[lo..hi];",
        "    u8@ x = s[..hi];",
        "    i32@ z = a[..];",
        "}",
        "fn g(string t, u8* p, i64 lo, u32 hi) void {",
        "    string y = t[lo..];",
        "    u8@ q = p[lo..hi];",
        "}",
    };
    string[64] want = {
        "fn main.f(_1 (a): i32[4], _2 (s): u8@, _3 (lo): i64, _4 (hi): u32) -> void {",
        "    let _0: void;",
        "    let _5 (w): i32 mut@ #2:14;",
        "    let _6 (x): u8@ #3:9;",
        "    let _7 (z): i32@ #4:10;",
        "    let _8: u64 #2:19;",
        "    let _9: u64 #2:19;",
        "    let _10: bool #2:19;",
        "    let _11: bool #2:19;",
        "    let _12: bool #2:19;",
        "    let _13: i64 #2:19;",
        "    let _14: i64 #2:19;",
        "    let _15: u64 #3:14;",
        "    let _16: bool #3:14;",
        "    let _17: bool #3:14;",
        "    let _18: bool #3:14;",
        "    let _19: i64 #3:14;",
        "    let _20: i64 #3:14;",
        "    let _21: bool #4:15;",
        "    let _22: bool #4:15;",
        "    let _23: bool #4:15;",
        "    let _24: i64 #4:15;",
        "    let _25: i64 #4:15;",
        "",
        "    bb0: {",
        "        live(_5) #2:14 s1;",
        "        _8 = cast<u64>(copy _3) #2:19 s1;",
        "        _9 = cast<u64>(copy _4) #2:19 s1;",
        "        _10 = gt(copy _8, copy _9) #2:19 s1;",
        "        _11 = gt(copy _9, const u64 4) #2:19 s1;",
        "        _12 = or(copy _10, copy _11) #2:19 s1;",
        "        _13 = cast<i64>(copy _8) #2:19 s1;",
        "        _14 = cast<i64>(copy _9) #2:19 s1;",
        "        check(copy _12, span, copy _13, copy _14, const u64 4) -> bb1 #2:19 s1;",
        "    }",
        "    bb1: {",
        "        _5 = slice mut(_1, copy _8, copy _9) #2:19 s1;",
        "        live(_6) #3:9 s2;",
        "        _15 = cast<u64>(copy _4) #3:14 s2;",
        "        _16 = gt(const u64 0, copy _15) #3:14 s2;",
        "        _17 = gt(copy _15, copy _2.1) #3:14 s2;",
        "        _18 = or(copy _16, copy _17) #3:14 s2;",
        "        _19 = cast<i64>(const u64 0) #3:14 s2;",
        "        _20 = cast<i64>(copy _15) #3:14 s2;",
        "        check(copy _18, span, copy _19, copy _20, copy _2.1) -> bb2 #3:14 s2;",
        "    }",
        "    bb2: {",
        "        _6 = slice(_2, const u64 0, copy _15) #3:14 s2;",
        "        live(_7) #4:10 s3;",
        "        _21 = gt(const u64 0, const u64 4) #4:15 s3;",
        "        _22 = gt(const u64 4, const u64 4) #4:15 s3;",
        "        _23 = or(copy _21, copy _22) #4:15 s3;",
        "        _24 = cast<i64>(const u64 0) #4:15 s3;",
        "        _25 = cast<i64>(const u64 4) #4:15 s3;",
        "        check(copy _23, span, copy _24, copy _25, const u64 4) -> bb3 #4:15 s3;",
        "    }",
        "    bb3: {",
        "        _7 = slice mut(_1, const u64 0, const u64 4) #4:15 s3;",
        "        dead(_5) #5:1 s0;",
        "        dead(_6) #5:1 s0;",
        "        dead(_7) #5:1 s0;",
        "        return #5:1 s0;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "f"), want[..]);
}

// `t[lo..]` of a `string` gives a `string`, and its absent high bound is field 1. `p[lo..hi]` of a
// pointer is `slice_ptr` over the bounds as they stand, with no check (D6.9).
fn a_span_of_a_string_and_of_a_pointer() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[9] source = {
        "fn f(i32[4] mut a, u8@ s, i64 lo, u32 hi) void {",
        "    i32 mut@ w = a[lo..hi];",
        "    u8@ x = s[..hi];",
        "    i32@ z = a[..];",
        "}",
        "fn g(string t, u8* p, i64 lo, u32 hi) void {",
        "    string y = t[lo..];",
        "    u8@ q = p[lo..hi];",
        "}",
    };
    string[30] want = {
        "fn main.g(_1 (t): string, _2 (p): u8*, _3 (lo): i64, _4 (hi): u32) -> void {",
        "    let _0: void;",
        "    let _5 (y): string #7:12;",
        "    let _6 (q): u8@ #8:9;",
        "    let _7: u64 #7:17;",
        "    let _8: bool #7:17;",
        "    let _9: bool #7:17;",
        "    let _10: bool #7:17;",
        "    let _11: i64 #7:17;",
        "    let _12: i64 #7:17;",
        "",
        "    bb0: {",
        "        live(_5) #7:12 s1;",
        "        _7 = cast<u64>(copy _3) #7:17 s1;",
        "        _8 = gt(copy _7, copy _1.1) #7:17 s1;",
        "        _9 = gt(copy _1.1, copy _1.1) #7:17 s1;",
        "        _10 = or(copy _8, copy _9) #7:17 s1;",
        "        _11 = cast<i64>(copy _7) #7:17 s1;",
        "        _12 = cast<i64>(copy _1.1) #7:17 s1;",
        "        check(copy _10, span, copy _11, copy _12, copy _1.1) -> bb1 #7:17 s1;",
        "    }",
        "    bb1: {",
        "        _5 = slice(_1, copy _7, copy _1.1) #7:17 s1;",
        "        live(_6) #8:9 s2;",
        "        _6 = slice_ptr(copy _2, copy _3, copy _4) #8:14 s2;",
        "        dead(_5) #9:1 s0;",
        "        dead(_6) #9:1 s0;",
        "        return #9:1 s0;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "g"), want[..]);
}

// An empty span of a `string`, `s[0..0]`, lowers as any other: the check holds `0 <= 0 <= len`.
fn an_empty_span_lowers_as_any_other() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[3] source = {
        "fn g(string s) string {",
        "    return s[0..0];",
        "}",
    };
    string[25] want = {
        "fn main.g(_1 (s): string) -> string {",
        "    let _0: string;",
        "    let _2: u64 #2:13;",
        "    let _3: u64 #2:13;",
        "    let _4: bool #2:13;",
        "    let _5: bool #2:13;",
        "    let _6: bool #2:13;",
        "    let _7: i64 #2:13;",
        "    let _8: i64 #2:13;",
        "",
        "    bb0: {",
        "        _2 = cast<u64>(const i32 0) #2:13 s1;",
        "        _3 = cast<u64>(const i32 0) #2:13 s1;",
        "        _4 = gt(copy _2, copy _3) #2:13 s1;",
        "        _5 = gt(copy _3, copy _1.1) #2:13 s1;",
        "        _6 = or(copy _4, copy _5) #2:13 s1;",
        "        _7 = cast<i64>(copy _2) #2:13 s1;",
        "        _8 = cast<i64>(copy _3) #2:13 s1;",
        "        check(copy _6, span, copy _7, copy _8, copy _1.1) -> bb1 #2:13 s1;",
        "    }",
        "    bb1: {",
        "        _0 = slice(_1, copy _2, copy _3) #2:13 s1;",
        "        return #2:5 s1;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "g"), want[..]);
}

// `a.f` is the field by its declaration index and `p->f` is `(*_p).k`; `.len` and `.ptr` of a
// span or a `string` are fields 1 and 0, through `->` too (D6.10).
fn a_field_and_an_arrow() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[19] source = {
        "struct point {",
        "    i32 x;",
        "    i32 y;",
        "}",
        "i32 mut G = 0;",
        "fn f(point a, point* p, string* s, u8@ b) i32 {",
        "    i32 y = a.y;",
        "    i32 z = p->x;",
        "    u64 n = s->len;",
        "    u8* d = b.ptr;",
        "    return y;",
        "}",
        "fn g(point a, i32 mut* q) i32 {",
        "    i32 w = *q;",
        "    i32* h = &G;",
        "    i32 mut* m = &*q;",
        "    i32* e = &a.y;",
        "    return w;",
        "}",
    };
    string[24] want = {
        "fn main.f(_1 (a): point, _2 (p): point*, _3 (s): string*, _4 (b): u8@) -> i32 {",
        "    let _0: i32;",
        "    let _5 (y): i32 #7:9;",
        "    let _6 (z): i32 #8:9;",
        "    let _7 (n): u64 #9:9;",
        "    let _8 (d): u8* #10:9;",
        "",
        "    bb0: {",
        "        live(_5) #7:9 s1;",
        "        _5 = copy _1.1 #7:14 s1;",
        "        live(_6) #8:9 s2;",
        "        _6 = copy (*_2).0 #8:14 s2;",
        "        live(_7) #9:9 s3;",
        "        _7 = copy (*_3).1 #9:14 s3;",
        "        live(_8) #10:9 s4;",
        "        _8 = copy _4.0 #10:14 s4;",
        "        _0 = copy _5 #11:12 s5;",
        "        dead(_5) #11:5 s5;",
        "        dead(_6) #11:5 s5;",
        "        dead(_7) #11:5 s5;",
        "        dead(_8) #11:5 s5;",
        "        return #11:5 s5;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "f"), want[..]);
}

// `*q` is `(*_q)`. `&lv` is `addr(p)`, or `addr mut(p)` when the checker typed a `mut` pointer:
// `&G` of a `mut` global and `&*q` of a `mut` pointer are `mut`, and `&a.y` of a parameter is not.
fn a_dereference_and_an_address() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[19] source = {
        "struct point {",
        "    i32 x;",
        "    i32 y;",
        "}",
        "i32 mut G = 0;",
        "fn f(point a, point* p, string* s, u8@ b) i32 {",
        "    i32 y = a.y;",
        "    i32 z = p->x;",
        "    u64 n = s->len;",
        "    u8* d = b.ptr;",
        "    return y;",
        "}",
        "fn g(point a, i32 mut* q) i32 {",
        "    i32 w = *q;",
        "    i32* h = &G;",
        "    i32 mut* m = &*q;",
        "    i32* e = &a.y;",
        "    return w;",
        "}",
    };
    string[30] want = {
        "fn main.g(_1 (a): point, _2 (q): i32 mut*) -> i32 {",
        "    let _0: i32;",
        "    let _3 (w): i32 #14:9;",
        "    let _4 (h): i32* #15:10;",
        "    let _5 (m): i32 mut* #16:14;",
        "    let _6 (e): i32* #17:10;",
        "    let _7: i32 mut* #15:14;",
        "    let _8: i32 mut* #16:18;",
        "    let _9: i32* #17:14;",
        "",
        "    bb0: {",
        "        live(_3) #14:9 s1;",
        "        _3 = copy (*_2) #14:13 s1;",
        "        live(_4) #15:10 s2;",
        "        _7 = addr mut(global main.G) #15:14 s2;",
        "        _4 = copy _7 #15:14 s2;",
        "        live(_5) #16:14 s3;",
        "        _8 = addr mut((*_2)) #16:18 s3;",
        "        _5 = copy _8 #16:18 s3;",
        "        live(_6) #17:10 s4;",
        "        _9 = addr(_1.1) #17:14 s4;",
        "        _6 = copy _9 #17:14 s4;",
        "        _0 = copy _3 #18:12 s5;",
        "        dead(_3) #18:5 s5;",
        "        dead(_4) #18:5 s5;",
        "        dead(_5) #18:5 s5;",
        "        dead(_6) #18:5 s5;",
        "        return #18:5 s5;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "g"), want[..]);
}

// A field or an index of an rvalue reads a temporary that holds the rvalue (D6.7): `mk().y` is
// field 1 of the result of the call, and `arr()[1]` an element of it. `move(h->p)` empties field 0
// of the struct that `h` points to, and the owning result of the call leaves its temporary by
// `move` (D17.5).
fn an_rvalue_goes_into_a_temporary_first() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[21] source = {
        "struct point {",
        "    i32 x;",
        "    i32 y;",
        "}",
        "struct holder {",
        "    u8 mut* own p;",
        "}",
        "fn mk() point {",
        "    return point{1, 2};",
        "}",
        "fn arr() i32[2] {",
        "    return i32[2]{3, 4};",
        "}",
        "fn keep(u8 mut* own p) u8 mut* own {",
        "    return p;",
        "}",
        "fn f(holder mut* h) u8 mut* own {",
        "    i32 y = mk().y;",
        "    i32 k = arr()[1];",
        "    return keep(move(h->p));",
        "}",
    };
    string[31] want = {
        "fn main.f(_1 (h): holder mut*) -> u8 mut* own {",
        "    let _0: u8 mut* own;",
        "    let _2 (y): i32 #18:9;",
        "    let _3 (k): i32 #19:9;",
        "    let _4: point #18:15;",
        "    let _5: i32[2] #19:16;",
        "    let _6: u64 #19:18;",
        "    let _7: bool #19:18;",
        "    let _8: i64 #19:18;",
        "    let _9: u8 mut* own #20:16;",
        "",
        "    bb0: {",
        "        live(_2) #18:9 s1;",
        "        _4 = call fn main.mk() #18:15 s1;",
        "        _2 = copy _4.1 #18:17 s1;",
        "        live(_3) #19:9 s2;",
        "        _5 = call fn main.arr() #19:16 s2;",
        "        _6 = cast<u64>(const i32 1) #19:18 s2;",
        "        _7 = ge(copy _6, const u64 2) #19:18 s2;",
        "        _8 = cast<i64>(copy _6) #19:18 s2;",
        "        check(copy _7, bounds, copy _8, const u64 2) -> bb1 #19:18 s2;",
        "    }",
        "    bb1: {",
        "        _3 = copy _5[_6] #19:18 s2;",
        "        _9 = call fn main.keep(move (*_1).0) #20:16 s3;",
        "        _0 = move _9 #20:16 s3;",
        "        dead(_2) #20:5 s3;",
        "        dead(_3) #20:5 s3;",
        "        return #20:5 s3;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "f"), want[..]);
}

// `arr()[g()]` calls `arr` before `g` (D6.3), and the element is read in the continuation of the
// check. `get()->x` dereferences the temporary of the call. `*NP` of a module constant that holds
// `null` puts the constant into a temporary first. A span of a `mut` span keeps its `mut` and is no
// `slice mut`, which only a fixed array takes (spec/fir.md 6).
fn the_operand_of_an_index_runs_before_its_index() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[23] source = {
        "struct point {",
        "    i32 x;",
        "    i32 y;",
        "}",
        "i32* NP = null;",
        "fn arr() i32[2] {",
        "    return i32[2]{3, 4};",
        "}",
        "fn g() i32 {",
        "    return 1;",
        "}",
        "fn get() point* {",
        "    return null;",
        "}",
        "fn f(u8 mut@ s) u8 mut@ {",
        "    i32 k = arr()[g()];",
        "    i32 x = get()->x;",
        "    i32 n = *NP;",
        "    return s[1..];",
        "}",
        "fn h(point[2] pts, i32 i) point {",
        "    return pts[i];",
        "}",
    };
    string[52] want = {
        "fn main.f(_1 (s): u8 mut@) -> u8 mut@ {",
        "    let _0: u8 mut@;",
        "    let _2 (k): i32 #16:9;",
        "    let _3 (x): i32 #17:9;",
        "    let _4 (n): i32 #18:9;",
        "    let _5: i32[2] #16:16;",
        "    let _6: i32 #16:20;",
        "    let _7: u64 #16:18;",
        "    let _8: bool #16:18;",
        "    let _9: i64 #16:18;",
        "    let _10: point* #17:16;",
        "    let _11: i32* #18:14;",
        "    let _12: u64 #19:13;",
        "    let _13: bool #19:13;",
        "    let _14: bool #19:13;",
        "    let _15: bool #19:13;",
        "    let _16: i64 #19:13;",
        "    let _17: i64 #19:13;",
        "",
        "    bb0: {",
        "        live(_2) #16:9 s1;",
        "        _5 = call fn main.arr() #16:16 s1;",
        "        _6 = call fn main.g() #16:20 s1;",
        "        _7 = cast<u64>(copy _6) #16:18 s1;",
        "        _8 = ge(copy _7, const u64 2) #16:18 s1;",
        "        _9 = cast<i64>(copy _7) #16:18 s1;",
        "        check(copy _8, bounds, copy _9, const u64 2) -> bb1 #16:18 s1;",
        "    }",
        "    bb1: {",
        "        _2 = copy _5[_7] #16:18 s1;",
        "        live(_3) #17:9 s2;",
        "        _10 = call fn main.get() #17:16 s2;",
        "        _3 = copy (*_10).0 #17:18 s2;",
        "        live(_4) #18:9 s3;",
        "        _11 = const null i32* #18:14 s3;",
        "        _4 = copy (*_11) #18:13 s3;",
        "        _12 = cast<u64>(const i32 1) #19:13 s4;",
        "        _13 = gt(copy _12, copy _1.1) #19:13 s4;",
        "        _14 = gt(copy _1.1, copy _1.1) #19:13 s4;",
        "        _15 = or(copy _13, copy _14) #19:13 s4;",
        "        _16 = cast<i64>(copy _12) #19:13 s4;",
        "        _17 = cast<i64>(copy _1.1) #19:13 s4;",
        "        check(copy _15, span, copy _16, copy _17, copy _1.1) -> bb2 #19:13 s4;",
        "    }",
        "    bb2: {",
        "        _0 = slice(_1, copy _12, copy _1.1) #19:13 s4;",
        "        dead(_2) #19:5 s4;",
        "        dead(_3) #19:5 s4;",
        "        dead(_4) #19:5 s4;",
        "        return #19:5 s4;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "f"), want[..]);
}

// An element of an aggregate type is a place: `return pts[i]` copies the element into `_0` in the
// continuation of the check.
fn an_element_of_an_aggregate_type() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[23] source = {
        "struct point {",
        "    i32 x;",
        "    i32 y;",
        "}",
        "i32* NP = null;",
        "fn arr() i32[2] {",
        "    return i32[2]{3, 4};",
        "}",
        "fn g() i32 {",
        "    return 1;",
        "}",
        "fn get() point* {",
        "    return null;",
        "}",
        "fn f(u8 mut@ s) u8 mut@ {",
        "    i32 k = arr()[g()];",
        "    i32 x = get()->x;",
        "    i32 n = *NP;",
        "    return s[1..];",
        "}",
        "fn h(point[2] pts, i32 i) point {",
        "    return pts[i];",
        "}",
    };
    string[17] want = {
        "fn main.h(_1 (pts): point[2], _2 (i): i32) -> point {",
        "    let _0: point;",
        "    let _3: u64 #22:15;",
        "    let _4: bool #22:15;",
        "    let _5: i64 #22:15;",
        "",
        "    bb0: {",
        "        _3 = cast<u64>(copy _2) #22:15 s1;",
        "        _4 = ge(copy _3, const u64 2) #22:15 s1;",
        "        _5 = cast<i64>(copy _3) #22:15 s1;",
        "        check(copy _4, bounds, copy _5, const u64 2) -> bb1 #22:15 s1;",
        "    }",
        "    bb1: {",
        "        _0 = copy _1[_3] #22:15 s1;",
        "        return #22:5 s1;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "h"), want[..]);
}

// `pts[i].y` is a field of an element, and `m[j][i]` checks the outer index against 2 and the
// inner one against 3, since `i32[2][3]` holds two `i32[3]` (D3.6). `&m[1][j]` takes the address
// after both checks. A string literal is indexed through a temporary, and a module constant
// `string` is indexed in place, its length being field 1 of the global.
fn an_index_of_an_index_a_field_and_a_constant() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[12] source = {
        "struct point {",
        "    i32 x;",
        "    i32 y;",
        "}",
        "string NAME = \"name\";",
        "fn f(point[2] pts, i32[2][3] m, i32 i, u8 j) char {",
        "    i32 y = pts[i].y;",
        "    i32 z = m[j][i];",
        "    i32* q = &m[1][j];",
        "    char c = \"abc\"[i];",
        "    return NAME[j];",
        "}",
    };
    string[91] want = {
        "fn main.f(_1 (pts): point[2], _2 (m): i32[2][3], _3 (i): i32, _4 (j): u8) -> char {",
        "    let _0: char;",
        "    let _5 (y): i32 #7:9;",
        "    let _6 (z): i32 #8:9;",
        "    let _7 (q): i32* #9:10;",
        "    let _8 (c): char #10:10;",
        "    let _9: u64 #7:16;",
        "    let _10: bool #7:16;",
        "    let _11: i64 #7:16;",
        "    let _12: u64 #8:14;",
        "    let _13: bool #8:14;",
        "    let _14: i64 #8:14;",
        "    let _15: u64 #8:17;",
        "    let _16: bool #8:17;",
        "    let _17: i64 #8:17;",
        "    let _18: u64 #9:16;",
        "    let _19: bool #9:16;",
        "    let _20: i64 #9:16;",
        "    let _21: u64 #9:19;",
        "    let _22: bool #9:19;",
        "    let _23: i64 #9:19;",
        "    let _24: i32* #9:14;",
        "    let _25: string #10:14;",
        "    let _26: u64 #10:19;",
        "    let _27: bool #10:19;",
        "    let _28: i64 #10:19;",
        "    let _29: u64 #11:16;",
        "    let _30: bool #11:16;",
        "    let _31: i64 #11:16;",
        "",
        "    bb0: {",
        "        live(_5) #7:9 s1;",
        "        _9 = cast<u64>(copy _3) #7:16 s1;",
        "        _10 = ge(copy _9, const u64 2) #7:16 s1;",
        "        _11 = cast<i64>(copy _9) #7:16 s1;",
        "        check(copy _10, bounds, copy _11, const u64 2) -> bb1 #7:16 s1;",
        "    }",
        "    bb1: {",
        "        _5 = copy _1[_9].1 #7:19 s1;",
        "        live(_6) #8:9 s2;",
        "        _12 = cast<u64>(copy _4) #8:14 s2;",
        "        _13 = ge(copy _12, const u64 2) #8:14 s2;",
        "        _14 = cast<i64>(copy _12) #8:14 s2;",
        "        check(copy _13, bounds, copy _14, const u64 2) -> bb2 #8:14 s2;",
        "    }",
        "    bb2: {",
        "        _15 = cast<u64>(copy _3) #8:17 s2;",
        "        _16 = ge(copy _15, const u64 3) #8:17 s2;",
        "        _17 = cast<i64>(copy _15) #8:17 s2;",
        "        check(copy _16, bounds, copy _17, const u64 3) -> bb3 #8:17 s2;",
        "    }",
        "    bb3: {",
        "        _6 = copy _2[_12][_15] #8:17 s2;",
        "        live(_7) #9:10 s3;",
        "        _18 = cast<u64>(const i32 1) #9:16 s3;",
        "        _19 = ge(copy _18, const u64 2) #9:16 s3;",
        "        _20 = cast<i64>(copy _18) #9:16 s3;",
        "        check(copy _19, bounds, copy _20, const u64 2) -> bb4 #9:16 s3;",
        "    }",
        "    bb4: {",
        "        _21 = cast<u64>(copy _4) #9:19 s3;",
        "        _22 = ge(copy _21, const u64 3) #9:19 s3;",
        "        _23 = cast<i64>(copy _21) #9:19 s3;",
        "        check(copy _22, bounds, copy _23, const u64 3) -> bb5 #9:19 s3;",
        "    }",
        "    bb5: {",
        "        _24 = addr(_2[_18][_21]) #9:14 s3;",
        "        _7 = copy _24 #9:14 s3;",
        "        live(_8) #10:10 s4;",
        "        _25 = const \"abc\" #10:14 s4;",
        "        _26 = cast<u64>(copy _3) #10:19 s4;",
        "        _27 = ge(copy _26, copy _25.1) #10:19 s4;",
        "        _28 = cast<i64>(copy _26) #10:19 s4;",
        "        check(copy _27, bounds, copy _28, copy _25.1) -> bb6 #10:19 s4;",
        "    }",
        "    bb6: {",
        "        _8 = copy _25[_26] #10:19 s4;",
        "        _29 = cast<u64>(copy _4) #11:16 s5;",
        "        _30 = ge(copy _29, copy global main.NAME.1) #11:16 s5;",
        "        _31 = cast<i64>(copy _29) #11:16 s5;",
        "        check(copy _30, bounds, copy _31, copy global main.NAME.1) -> bb7 #11:16 s5;",
        "    }",
        "    bb7: {",
        "        _0 = copy global main.NAME[_29] #11:16 s5;",
        "        dead(_5) #11:5 s5;",
        "        dead(_6) #11:5 s5;",
        "        dead(_7) #11:5 s5;",
        "        dead(_8) #11:5 s5;",
        "        return #11:5 s5;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "f"), want[..]);
}

// `.len` of a fixed array is a constant that the checker folds, so it reads no place (D3.4).
fn the_length_of_a_fixed_array_is_a_constant() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[3] source = {
        "fn f(i32[4] a) u64 {",
        "    return a.len;",
        "}",
    };
    string[8] want = {
        "fn main.f(_1 (a): i32[4]) -> u64 {",
        "    let _0: u64;",
        "",
        "    bb0: {",
        "        _0 = const u64 4 #2:13 s1;",
        "        return #2:5 s1;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "f"), want[..]);
}

// `swap()` sets `P = &B2`. D6.3 evaluates the base to its address before the index, so the
// lowering holds the address of `P->arr` before the call, and the element is of `B1`, as on the
// direct path. `addr mut` follows the `mut` of `P`.
fn an_index_holds_its_base_before_a_writer() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[38] source = {
        "struct box {",
        "    i32[4] arr;",
        "}",
        "box mut B1 = {};",
        "box mut B2 = {};",
        "box mut* mut P = &B1;",
        "i32 mut@ mut S = {};",
        "i32 mut@ mut* mut PS = &S;",
        "fn swap() i32 {",
        "    P = &B2;",
        "    return 0;",
        "}",
        "fn read() i32 {",
        "    return P->arr[swap()];",
        "}",
        "fn write() void {",
        "    P->arr[swap()] = 5;",
        "}",
        "fn span() i32 mut@ {",
        "    return P->arr[swap()..4];",
        "}",
        "fn address() i32 mut* {",
        "    return &P->arr[swap()];",
        "}",
        "fn through() i32 {",
        "    return (*PS)[swap()];",
        "}",
        "fn plain() i32 {",
        "    return S[swap()];",
        "}",
        "box* mut Q = &B1;",
        "fn readq() i32 {",
        "    return Q->arr[swap()];",
        "}",
        "i32 mut@@ W = {};",
        "fn nested(u64 j) i32 {",
        "    return W[j][swap()];",
        "}",
    };
    string[21] want = {
        "fn main.read() -> i32 {",
        "    let _0: i32;",
        "    let _1: i32[4] mut* #14:13;",
        "    let _2: i32 #14:23;",
        "    let _3: u64 #14:18;",
        "    let _4: bool #14:18;",
        "    let _5: i64 #14:18;",
        "",
        "    bb0: {",
        "        _1 = addr mut((*global main.P).0) #14:13 s1;",
        "        _2 = call fn main.swap() #14:23 s1;",
        "        _3 = cast<u64>(copy _2) #14:18 s1;",
        "        _4 = ge(copy _3, const u64 4) #14:18 s1;",
        "        _5 = cast<i64>(copy _3) #14:18 s1;",
        "        check(copy _4, bounds, copy _5, const u64 4) -> bb1 #14:18 s1;",
        "    }",
        "    bb1: {",
        "        _0 = copy (*_1)[_3] #14:18 s1;",
        "        return #14:5 s1;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "read"), want[..]);
}

// `P->arr[swap()] = 5` stores into the `B1` that the held address names.
fn an_assigned_index_holds_its_base() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[38] source = {
        "struct box {",
