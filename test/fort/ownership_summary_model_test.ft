//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| boundary X19
//| boundary X23
//| boundary X27
//| direct-call model ok
/// Checks owned model records, canonical inputs, and refusal outcomes.
import ownership_api;
import ownership_calls;
import ownership_calls_env;
import ownership_keys;
import ownership_state;
import ownership_summary_model;

fn case_x27() void {
    ownership_calls_env.env mut e = ownership_calls_env.env{};
    ownership_calls_env.open(&e);
    defer ownership_calls_env.close(&e);
    ownership_summary_model.summary mut first = ownership_summary_model.clone(&e.input,
        &e.services);
    ownership_calls_env.accepted(first.proof);
    u64 calls = e.counts.calls;
    ownership_calls_env.reset(&e);
    ownership_summary_model.summary_view observed = ownership_summary_model.view(&first);
    ownership_summary_model.summary mut second = ownership_summary_model.clone(&observed,
        &e.services);
    ownership_calls_env.accepted(second.proof);
    assert(e.counts.calls == calls && e.counts.events == 0);
    assert(observed.effects.len == 2 && observed.cases[0].effects.len == 2);
    assert(first.roots.len == 6 && second.roots.len == 6);
    assert(first.requirements.len == 2 && second.requirements.len == 2);
    assert(first.effects.len == 2 && second.effects.len == 2);
    assert(first.order.len == 1 && second.order.len == 1);
    assert(first.predicates.len == 1 && second.predicates.len == 1);
    assert(first.guards.len == 1 && second.guards.len == 1);
    assert(first.correlations.len == 1 && second.correlations.len == 1);
    assert(first.results.len == 1 && second.results.len == 1);
    assert(first.retained.len == 1 && second.retained.len == 1);
    assert(first.cases.len == 1 && second.cases.len == 1);
    assert(first.provenance_records.len == 1 && second.provenance_records.len == 1);
    assert(first.witnesses.len == 1 && second.witnesses.len == 1);
    u64 mut i = 0;
    while (i < first.roots.len) {
        assert(ownership_summary_model.same(first.roots[i].key, second.roots[i].key));
        assert(first.roots[i].kind == second.roots[i].kind);
        assert(first.roots[i].formal == second.roots[i].formal);
        assert(first.roots[i].ownership == second.roots[i].ownership);
        assert(first.roots[i].ty == second.roots[i].ty);
        assert(ownership_summary_model.same(first.roots[i].slot, second.roots[i].slot));
        assert(ownership_summary_model.same(first.roots[i].source, second.roots[i].source));
        assert(ownership_summary_model.same(first.roots[i].allocation, second.roots[i].allocation));
        assert(ownership_summary_model.same(first.roots[i].value_version,
            second.roots[i].value_version));
        i += 1;
    }
    i = 0;
    while (i < first.requirements.len) {
        assert(ownership_summary_model.same(first.requirements[i].key, second.requirements[i].key));
        assert(first.requirements[i].kind == second.requirements[i].kind);
        assert(ownership_state.same_place(first.requirements[i].path, second.requirements[i].path));
        assert(ownership_state.same_region(first.requirements[i].range,
            second.requirements[i].range));
        assert(ownership_summary_model.same(first.requirements[i].guard,
            second.requirements[i].guard));
        assert(ownership_summary_model.same(first.requirements[i].source,
            second.requirements[i].source));
        assert(ownership_summary_model.same(first.requirements[i].provenance,
            second.requirements[i].provenance));
        assert(ownership_keys.operation(first.requirements[i].operation,
            second.requirements[i].operation) == 0);
        i += 1;
    }
    i = 0;
    while (i < first.effects.len) {
        assert(ownership_summary_model.same(first.effects[i].effect.key,
            second.effects[i].effect.key));
        assert(first.effects[i].effect.kind == second.effects[i].effect.kind);
        assert(first.effects[i].payload == second.effects[i].payload);
        assert(first.effects[i].residual == second.effects[i].residual);
        assert(ownership_keys.operation(first.effects[i].effect.operation,
            second.effects[i].effect.operation) == 0);
        assert(ownership_state.same_place(first.effects[i].effect.place,
            second.effects[i].effect.place));
        assert(ownership_state.same_place(first.effects[i].operand, second.effects[i].operand));
        assert(ownership_state.same_contents(first.effects[i].value, second.effects[i].value));
        assert(ownership_state.same_region(first.effects[i].range, second.effects[i].range));
        assert(first.effects[i].deferred.exit_occurrence
            == second.effects[i].deferred.exit_occurrence);
        assert(ownership_keys.source(first.effects[i].deferred.exit_source,
            second.effects[i].deferred.exit_source) == 0);
        i += 1;
    }
    assert(ownership_state.same_predicate(first.predicates[0], second.predicates[0]));
    assert(ownership_state.same_guard(first.guards[0], second.guards[0]));
    assert(ownership_state.same_correlation(first.correlations[0], second.correlations[0]));
    assert(ownership_state.same_borrow(first.results[0].borrow, second.results[0].borrow));
    assert(ownership_state.same_borrow(first.retained[0].borrow, second.retained[0].borrow));
    assert(ownership_state.same_entities(first.cases[0].requirements,
        second.cases[0].requirements));
    assert(ownership_state.same_entities(first.cases[0].effects, second.cases[0].effects));
    assert(ownership_state.same_entities(first.cases[0].results, second.cases[0].results));
    assert(ownership_state.same_entities(first.cases[0].retained, second.cases[0].retained));
    assert(first.cases[0].outcome.kind == second.cases[0].outcome.kind);
    assert(!second.cases[0].outcome.possible_caller_return
        && !second.cases[0].outcome.cleanup_proved);
    assert(first.cases[0].outcome.effects.len == 2 && second.cases[0].outcome.effects.len == 2);
    assert(ownership_state.same_place(first.cases[0].outcome.effects[0].place,
        second.cases[0].outcome.effects[0].place));
    assert(first.order[0].proved && second.order[0].proved);
    assert(ownership_summary_model.same(first.order[0].before, second.order[0].before));
    assert(ownership_summary_model.same(first.order[0].after, second.order[0].after));
    assert(ownership_state.same_entities(first.provenance_records[0].substitutions,
        second.provenance_records[0].substitutions));
    assert(ownership_state.same_entities(first.provenance_records[0].witnesses,
        second.provenance_records[0].witnesses));
    assert(ownership_keys.function(first.provenance_records[0].callee,
        second.provenance_records[0].callee) == 0);
    assert(first.provenance_records[0].filename == second.provenance_records[0].filename);
    assert(ownership_summary_model.same(first.witnesses[0].key, second.witnesses[0].key));
    assert(ownership_state.same_proof(first.proof, second.proof));
    assert(second.residual_effects && !second.coverage.actual_source_complete);
    ownership_summary_model.free(&first);
    assert(second.requirements[0].path.projections[1].index.kind
        == ownership_api.fact_kind.symbolic);
    assert(second.cases[0].effects.len == 2 && second.provenance_records[0].witnesses.len == 1);
    ownership_summary_model.free(&second);
    ownership_summary_model.free(&first);
    ownership_summary_model.free(&second);
    ownership_calls_env.reset(&e);
    ownership_calls.request req = ownership_calls_env.request(&e);
    ownership_calls.frame mut first_frame = ownership_calls.bind(&req);
    ownership_calls_env.accepted(first_frame.proof);
    ownership_calls_env.possible(&first_frame);
    ownership_calls_env.reset(&e);
    ownership_calls.frame mut second_frame = ownership_calls.bind(&req);
    ownership_calls_env.accepted(second_frame.proof);
    ownership_calls_env.possible(&second_frame);
    assert(first_frame.aliases.len == second_frame.aliases.len && e.counts.events == 0);
    assert(ownership_state.same_place(first_frame.result.actual_slot,
        second_frame.result.actual_slot));
    assert(ownership_state.same_borrow(first_frame.model.results[0].borrow,
        second_frame.model.results[0].borrow));
    ownership_calls.free_frame(&first_frame);
    ownership_calls.free_frame(&second_frame);
    e.limits.e = 1;
    ownership_calls_env.reset(&e);
    first = ownership_summary_model.clone(&e.input, &e.services);
    ownership_api.event_descriptor event_first = e.counts.last;
    ownership_summary_model.free(&first);
    ownership_calls_env.reset(&e);
    second = ownership_summary_model.clone(&e.input, &e.services);
    assert(e.counts.events == 1 && e.counts.last_note_count == 2);
    assert(ownership_summary_model.same(event_first.key, e.counts.last.key));
    assert(ownership_keys.operation(event_first.operation, e.counts.last.operation) == 0);
    assert(ownership_keys.source(event_first.source, e.counts.last.source) == 0);
    assert(event_first.reason == e.counts.last.reason
        && event_first.evidence == e.counts.last.evidence);
    ownership_summary_model.free(&second);
    ownership_calls_env.boundary("X27",
        "f39fbcb1e588b6361611a2fed7564e0f5455c7eeaad85d1c94cc669ee32bc97f", "none");
}

fn case_x19() void {
    ownership_calls_env.env mut e = ownership_calls_env.env{};
    ownership_calls_env.open(&e);
    defer ownership_calls_env.close(&e);
    e.input.requirements = e.requirements[0..0];
    e.limits.e = 1;
    ownership_calls_env.reset(&e);
    ownership_summary_model.summary mut out = ownership_summary_model.clone(&e.input, &e.services);
    ownership_calls_env.rejected(out.proof, ownership_api.incomplete_reason.work_limit);
    assert(out.proof.terminal.limit.category == ownership_api.limit_category.e);
    assert(out.proof.terminal.limit.used == 1 && out.proof.terminal.limit.bound == 1);
    assert(out.proof.terminal.limit.attempted == 2 && out.relations == 1);
    assert(out.effects.len == 2 && out.effects[0].effect.kind == ownership_api.effect_kind.read);
    assert(out.effects[1].effect.key.kind == ownership_api.entity_kind.none);
    assert(out.metadata.blocks != null && out.residual_effects);
    assert(e.counts.events == 1 && e.counts.last_note_count == 2);
    assert(e.requirements[1].source.kind == ownership_api.entity_kind.source);
    assert(e.actual_allocations[0].obligation);
    ownership_summary_model.free(&out);
    assert(out.roots.len == 0 && out.metadata.blocks == null && out.outcome_blocks == null);
    ownership_summary_model.free(&out);
    ownership_calls_env.boundary("X19",
        "60abf66a115cfb8b3bed60cfe58b90306583bde465b4de003c07166b470bdb96", "incomplete_proof");
}

fn case_x23() void {
    ownership_calls_env.env mut e = ownership_calls_env.env{};
    ownership_calls_env.open(&e);
    defer ownership_calls_env.close(&e);
    e.limits.e = 1;
    e.counts.refuse_second_note = true;
    ownership_calls_env.reset(&e);
    ownership_summary_model.summary mut out = ownership_summary_model.clone(&e.input, &e.services);
    ownership_calls_env.rejected(out.proof, ownership_api.incomplete_reason.report_limit);
    assert(e.counts.events == 1 && e.counts.last_note_count == 2);
    assert(e.counts.last.evidence == ownership_api.evidence_kind.abstract_possibility);
    assert(e.counts.last.reason == ownership_api.incomplete_reason.work_limit);
    assert(ownership_keys.operation(out.proof.terminal.operation, e.input.operation) == 0);
    assert(ownership_keys.source(out.proof.terminal.source, e.input.source) == 0);
    assert(out.metadata.blocks != null && out.residual_effects);
    ownership_summary_model.free(&out);
    assert(e.counts.last.source.line == 10 && e.counts.last.operation.operation == 1);
    ownership_summary_model.free(&out);
    ownership_calls_env.boundary("X23",
        "4508b224f5e112d2cffdf1854dc121b36b2da473f998a24cbac7e2130abe9546", "work_failure");
}

fn canonical_refusals() void {
    u32 mut scenario = 0;
    while (scenario < 19) {
        ownership_calls_env.env mut e = ownership_calls_env.env{};
        ownership_calls_env.open(&e);
        ownership_api.ordering_constraint[2] repeated_order = {e.order[0], e.order[0]};
        ownership_api.correlation[2] repeated_correlation = {e.correlations[0], e.correlations[0]};
        ownership_api.entity_id[2] reversed = {e.keys[4], e.keys[3]};
        if (scenario == 0) { e.roots[1].key = e.roots[0].key; }
        if (scenario == 1) { e.requirements[1].key = e.requirements[0].key; }
        if (scenario == 2) { e.effects[1].effect.key = e.effects[0].effect.key; }
        if (scenario == 3) { e.predicates[0].key = ownership_api.entity_id{}; }
        if (scenario == 4) { e.guards[0].key = ownership_api.entity_id{}; }
        if (scenario == 5) { e.results[0].key = ownership_api.entity_id{}; }
        if (scenario == 6) { e.retained[0].key = ownership_api.entity_id{}; }
        if (scenario == 7) { e.cases[0].key = ownership_api.entity_id{}; }
        if (scenario == 8) { e.provenance_records[0].key = ownership_api.entity_id{}; }
        if (scenario == 9) { e.witnesses[0].key = ownership_api.entity_id{}; }
        if (scenario == 10) { e.order[0].after = e.order[0].before; }
        if (scenario == 11) { e.input.order = repeated_order[..]; }
        if (scenario == 12) { e.input.correlations = repeated_correlation[..]; }
        if (scenario == 13) { e.correlations[0].relation.ordinal = 999; }
        if (scenario == 14) { e.keys[7].ordinal = 999; }
        if (scenario == 15) { e.keys[0].ordinal = 999; }
        if (scenario == 16) { e.keys[4] = e.keys[3]; }
        if (scenario == 17) { e.cases[0].guard.ordinal = 999; }
        // The case applies the second effect first against a proved order.
        if (scenario == 18) { e.cases[0].effects = reversed[..]; }
        ownership_summary_model.summary mut out = ownership_summary_model.clone(&e.input,
            &e.services);
        ownership_calls_env.rejected(out.proof, ownership_api.incomplete_reason.invalid_input);
        assert(e.counts.events == 1 && out.residual_effects);
        ownership_summary_model.free(&out);
        ownership_summary_model.free(&out);
        ownership_calls_env.close(&e);
        scenario += 1;
    }
}

// An order that is not proved permits either case order.
fn unproved_order() void {
    ownership_calls_env.env mut e = ownership_calls_env.env{};
    ownership_calls_env.open(&e);
    defer ownership_calls_env.close(&e);
    ownership_api.entity_id[2] reversed = {e.keys[4], e.keys[3]};
    e.order[0].proved = false;
    e.cases[0].effects = reversed[..];
    ownership_summary_model.summary mut out = ownership_summary_model.clone(&e.input, &e.services);
    assert(ownership_api.successful(out.proof) && e.counts.events == 0);
    assert(out.cases[0].effects.len == 2 && !out.order[0].proved);
    ownership_summary_model.free(&out);
}

fn retained_refusal() void {
    ownership_calls_env.env mut e = ownership_calls_env.env{};
    ownership_calls_env.open(&e);
    defer ownership_calls_env.close(&e);
    e.input.proof = ownership_api.incomplete(ownership_api.incomplete_reason.missing_capture,
        e.input.operation, e.input.source);
    ownership_summary_model.summary mut out = ownership_summary_model.clone(&e.input, &e.services);
    ownership_calls_env.rejected(out.proof, ownership_api.incomplete_reason.missing_capture);
    assert(ownership_state.same_proof(out.proof, e.input.proof) && out.residual_effects);
    assert(out.cases.len == 1 && out.cases[0].effects.len == 2);
    ownership_summary_model.free(&out);
}

// E names the relations that one owner retains now. A second copy adds no unit.
// The input retains 12: two requirements, two effects, one guard, one result, one
// retained relation, one case, two outcome effects, one order, and one correlation.
fn content_count() void {
    ownership_calls_env.env mut e = ownership_calls_env.env{};
    ownership_calls_env.open(&e);
    defer ownership_calls_env.close(&e);
    e.limits.e = 12;
    ownership_calls_env.reset(&e);
    ownership_summary_model.summary mut first = ownership_summary_model.clone(&e.input,
        &e.services);
    ownership_calls_env.accepted(first.proof);
    assert(first.relations == 12 && e.counts.meter.used.e == 12);
    ownership_summary_model.summary mut second = ownership_summary_model.clone(&e.input,
        &e.services);
    ownership_calls_env.accepted(second.proof);
    assert(second.relations == 12 && e.counts.meter.used.e == 12);
    ownership_summary_model.free(&first);
    ownership_summary_model.free(&second);
    e.limits.e = 11;
    ownership_calls_env.reset(&e);
    ownership_summary_model.summary mut short = ownership_summary_model.clone(&e.input,
        &e.services);
    ownership_calls_env.rejected(short.proof, ownership_api.incomplete_reason.work_limit);
    assert(short.proof.terminal.limit.category == ownership_api.limit_category.e);
    assert(short.proof.terminal.limit.used == 11 && short.proof.terminal.limit.bound == 11);
    assert(short.proof.terminal.limit.attempted == 12 && short.relations == 11);
    assert(short.order.len == 1 && short.correlations.len == 1 && short.residual_effects);
    ownership_summary_model.free(&short);
}

fn main() i32 {
    case_x19();
    case_x23();
    case_x27();
    canonical_refusals();
    unproved_order();
    retained_refusal();
    content_count();
    println("direct-call model ok");
    return 0;
}
