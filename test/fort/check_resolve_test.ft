//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| ok
/// Checks lazy resolution, value containment, resolution edges, cycles, and ordinary recursion.
import ast;
import check;
import check_env;
import std.strbuf;
import types;

//
// Resolution edges are value-containment edges. A type name resolves when the
// written type stores its value. Function results and parameters do not add
// these edges.
//
// The suite checks bases behind arrays and references in both declaration
// orders. `behind_arrays` in types.ft and `struct_of` in check.ft both follow
// value-containment edges.

fn decls(check_env.env mut* e, string one, string two, string three) bool {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, one);
    strbuf.append(&b, two);
    strbuf.append(&b, three);
    return check_env.check_decls(e, strbuf.view(&b));
}

// ---- value containment is the resolution edge --------------------------------------

fn a_struct_stored_by_value_is_resolved_before_its_holder() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // `inner` is declared after `outer` and `outer` stores one by value. So the
    // resolution reaches it and the layout is exact whichever order the two are
    // written in.
    assert(decls(&e, "struct outer {\n    i32 tag;\n    inner part;\n}\n",
                 "struct inner {\n    i64 a;\n}\n",
                 "outer o = {1, {2}};\n"));
    assert(check_env.field_offset(&e, "outer", "tag") == 0);
    assert(check_env.field_offset(&e, "outer", "part") == 8);
}

fn an_array_of_a_struct_carries_the_base_through() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // A fixed array is N of its element, so the array's holder stores the
    // element by value and the element is a resolution edge.
    assert(decls(&e, "struct outer {\n    inner[2] parts;\n}\n",
                 "struct inner {\n    i64 a;\n}\n", "outer o = {{{1}, {2}}};\n"));
    assert(check_env.sym_main(&e, "o") != null);
    assert(types.type_sizeof(check_env.sym_main(&e, "o")->ty) == 16);
}

// The struct the two layout tests below hold, one field to a line.
string GROUPED_HOLDER =
    "struct a {\nu8 tag;\n(fn (b) i32)[2] table;\n((b mut*)) link;\n((u8)) last;\n}\n";

// A group stores what it groups (D3.6). A grouped pointer is one word whatever
// its pointee is, and a grouped array of function pointers holds its pointers
// by value. The offsets are C's for the same fields without the parentheses.
fn a_grouped_field_is_laid_out_as_the_type_it_groups() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(decls(&e, GROUPED_HOLDER,
                 "struct b {\n    a value;\n}\n", "b x = {};\n"));
    assert(check_env.field_offset(&e, "a", "table") == 8);
    assert(check_env.field_offset(&e, "a", "link") == 24);
    assert(check_env.field_offset(&e, "a", "last") == 32);
    assert(types.type_sizeof(check_env.sym_main(&e, "x")->ty) == 40);
    check_env.reopen(&e);
    assert(decls(&e, "struct b {\n    a value;\n}\n", GROUPED_HOLDER, "b x = {};\n"));
    assert(check_env.field_offset(&e, "a", "last") == 32);
    assert(types.type_sizeof(check_env.sym_main(&e, "x")->ty) == 40);
}

// A group around a struct stores the struct by value, so it is a resolution
// edge as the plain field is, and a group around a pointer to it is not.
fn a_grouped_struct_field_is_a_resolution_edge() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(decls(&e, "struct a {\n    i32 tag;\n    ((b)) part;\n}\n",
                 "struct b {\n    i64 v;\n    (a)* back;\n}\n", "a x = {};\n"));
    assert(check_env.field_offset(&e, "a", "part") == 8);
    assert(types.type_sizeof(check_env.sym_main(&e, "x")->ty) == 24);
    check_env.reopen(&e);
    assert(!decls(&e, "struct a {\n    ((b)) part;\n}\n", "struct b {\n    (a) whole;\n}\n",
                  ""));
    assert(check_env.said(&e, "infinite size"));
}

fn a_struct_behind_a_reference_is_identity_only() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // `first` holds a pointer to `second` and `second` holds one by value to
    // nothing. Neither order is a cycle because a pointer is one word for any
    // pointee. A pointer must not create a resolution edge or an infinite-size
    // error for this pair.
    assert(decls(&e, "struct first {\n    second mut* link;\n    i32 v;\n}\n",
                 "struct second {\n    first mut* back;\n    i32 w;\n}\n",
                 "first f = {null, 1};\n"));
    assert(check_env.errors(&e) == 0);
    assert(check_env.field_offset(&e, "first", "link") == 0);
    assert(check_env.field_offset(&e, "first", "v") == 8);
}

fn a_span_of_a_struct_is_identity_only_as_well() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // A span is two words whatever it views, so it stores no value of its
    // element type either.
    assert(decls(&e, "struct holder {\n    item@ items;\n}\n",
                 "struct item {\n    holder mut* owner;\n}\n", "holder h = {};\n"));
    assert(check_env.errors(&e) == 0);
    assert(types.type_sizeof(check_env.sym_main(&e, "h")->ty) == 16);
}

fn a_pair_that_reaches_through_a_span_checks_in_either_order() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // `vec` holds a span of pointers to `node` and `node` holds a `vec` by
    // value. Neither layout depends on the other, so the pair checks whichever
    // order the file declares them in. Resolving `node` from `vec`'s pointer
    // field puts `vec` on its own resolution path through the value field.
    // The cycle makes the layout read an infinite size.
    assert(decls(&e, "struct vec {\n    node mut* mut@ own items;\n}\n",
                 "struct node {\n    vec kids;\n    i32 tag;\n}\n", "vec v = {};\n"));
    assert(check_env.errors(&e) == 0);
    assert(types.type_sizeof(check_env.sym_main(&e, "v")->ty) == 16);
    check_env.env mut f = check_env.env{};
    check_env.open(&f);
    defer check_env.close(&f);
    // The same pair with the declarations swapped, which is the other half of
    // "the two declaration orders of a pair are one program".
    assert(decls(&f, "struct node {\n    vec kids;\n    i32 tag;\n}\n",
                 "struct vec {\n    node mut* mut@ own items;\n}\n", "vec v = {};\n"));
    assert(check_env.errors(&f) == 0);
    assert(check_env.field_offset(&f, "node", "kids") == 0);
    assert(check_env.field_offset(&f, "node", "tag") == 16);
}

fn a_reference_behind_two_array_levels_is_identity_only() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // `node*[2][3]` is six pointers: the array levels carry the base through
    // and the `*` ends the containment. So `vec` stores no `node` by value and
    // the pair checks in this order. This is the rank-two half of the rule,
    // which bootstrap-0 cannot write at all.
    assert(decls(&e, "struct vec {\n    node mut*[2][3] rows;\n}\n",
                 "struct node {\n    vec kids;\n    i32 tag;\n}\n", "vec v = {};\n"));
    assert(check_env.errors(&e) == 0);
    assert(types.type_sizeof(check_env.sym_main(&e, "v")->ty) == 48);
    check_env.env mut f = check_env.env{};
    check_env.open(&f);
    defer check_env.close(&f);
    // The second environment checks the same program in the other order.
    assert(decls(&f, "struct node {\n    vec kids;\n    i32 tag;\n}\n",
                 "struct vec {\n    node mut*[2][3] rows;\n}\n", "vec v = {};\n"));
    assert(check_env.errors(&f) == 0);
    assert(check_env.field_offset(&f, "node", "kids") == 0);
    assert(check_env.field_offset(&f, "node", "tag") == 48);
}

fn a_span_of_arrays_of_a_struct_is_identity_only_as_well() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // `node[3] mut@ own` is two words whatever it views, the array level inside
    // it included. So it opens no resolution edge and the pair checks in both
    // orders.
    assert(decls(&e, "struct vec {\n    node[3] mut@ own rows;\n}\n",
                 "struct node {\n    vec kids;\n    i32 tag;\n}\n", "vec v = {};\n"));
    assert(check_env.errors(&e) == 0);
    assert(types.type_sizeof(check_env.sym_main(&e, "v")->ty) == 16);
    check_env.env mut f = check_env.env{};
    check_env.open(&f);
    defer check_env.close(&f);
    assert(decls(&f, "struct node {\n    vec kids;\n    i32 tag;\n}\n",
                 "struct vec {\n    node[3] mut@ own rows;\n}\n", "vec v = {};\n"));
    assert(check_env.errors(&f) == 0);
    assert(check_env.field_offset(&f, "node", "kids") == 0);
    assert(check_env.field_offset(&f, "node", "tag") == 16);
}

fn an_array_of_arrays_of_a_struct_contains_it_by_value() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // A fixed array of any rank over `node` contains `node` by value. So this
    // pair is a cycle and the error is the same in both orders. The two tests
    // above and this one are the two answers the demand graph must tell apart
    // at rank two.
    assert(!decls(&e, "struct vec {\n    node[2][3] rows;\n}\n",
                  "struct node {\n    vec kids;\n}\n", "vec v = {};\n"));
    assert(check_env.said(&e, "has infinite size"));
    check_env.env mut f = check_env.env{};
    check_env.open(&f);
    defer check_env.close(&f);
    assert(!decls(&f, "struct node {\n    vec kids;\n}\n",
                  "struct vec {\n    node[2][3] rows;\n}\n", "vec v = {};\n"));
    assert(check_env.said(&f, "has infinite size"));
}

fn a_function_type_stores_neither_its_result_nor_its_parameters() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // A function pointer is one word and its signature is stored nowhere. So a
    // struct holding one that mentions the struct itself is not a cycle.
    assert(decls(&e, "struct node {\n    fn (node mut*) void visit;\n    i32 v;\n}\n",
                 "node n = {null, 1};\n", ""));
    assert(check_env.errors(&e) == 0);
    assert(check_env.field_offset(&e, "node", "visit") == 0);
    assert(check_env.field_offset(&e, "node", "v") == 8);
}

fn two_structs_that_contain_each_other_by_value_have_infinite_size() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!decls(&e, "struct a {\n    b inner;\n}\n", "struct b {\n    a inner;\n}\n",
                  "a x = {{{}}};\n"));
    assert(check_env.said(&e, "has infinite size"));
}

// ---- the lazy resolution of constants ----------------------------------------------

fn a_constant_reached_from_another_is_resolved_on_the_spot() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(decls(&e, "i32 third = second + 1;\n", "i32 second = first + 1;\n",
                 "i32 first = 1;\n"));
    i64 mut v = 0;
    assert(check_env.init_int(&e, "third", &v));
    assert(v == 3);
}

fn a_cycle_between_two_constants_is_reported_once() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    assert(!decls(&e, "i32 one = two;\n", "i32 two = one;\n", ""));
    assert(check_env.said(&e, "is defined in terms of itself"));
    // One error and nothing more: both symbols are poisoned.
    assert(check_env.errors(&e) == 1);
}

fn a_declaration_may_hold_its_own_address() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // `&N` inside N's own initializer asks for an address and not for a value.
    // And a module-level initializer admits `&` of a module-level declaration
    // from any module, this one included: a self-pointing sentinel is legal.
    assert(decls(&e, "struct node {\n    node* self;\n}\n", "node n = node{&n};\n", ""));
    assert(check_env.errors(&e) == 0);
    assert(check_env.sym_main(&e, "n")->kind == ast.sym_kind.s_const);
}

fn an_enum_value_may_not_refer_to_its_own_enum() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // An enum member's value may close no cycle.
    assert(!decls(&e, "enum color {\n    red = cast(color.green, i32),\n    green,\n}\n", "",
                  ""));
    assert(check_env.said(&e, "is defined in terms of itself"));
}

// ---- failure is local --------------------------------------------------------------

fn a_declaration_that_failed_silences_everything_that_reads_it() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    // The type is unknown, so the declaration fails. The two that read it say
    // nothing further, because the error type poisons through.
    assert(!decls(&e, "nosuch k = 1;\n", "i32 a = k;\n", "i32 b = k + 1;\n"));
    assert(check_env.errors(&e) == 1);
    assert(check_env.sym_main(&e, "k")->error);
    assert(check_env.type_text(&e, check_env.sym_main(&e, "k")->ty) == "<error>");
}

fn a_use_of_a_name_an_import_failed_to_bind_is_silent() void {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "import missing;\n");
    strbuf.append(&b, "i32 k = missing.ONE;\n");
    strbuf.append(&b, "fn main() i32 {\n    return 0;\n}\n");
    check_env.add(&e, "main.ft", strbuf.view(&b));
    assert(!check_env.check_entry(&e, "main.ft"));
    // The loader reported the import. The checker says nothing about the name
    // it left unbound.
    assert(check_env.said(&e, "module 'missing' not found"));
    assert(!check_env.said(&e, "unknown name 'missing'"));
}

fn main() i32 {
    a_struct_stored_by_value_is_resolved_before_its_holder();
    an_array_of_a_struct_carries_the_base_through();
    a_grouped_field_is_laid_out_as_the_type_it_groups();
    a_grouped_struct_field_is_a_resolution_edge();
    a_struct_behind_a_reference_is_identity_only();
    a_span_of_a_struct_is_identity_only_as_well();
    a_pair_that_reaches_through_a_span_checks_in_either_order();
    a_reference_behind_two_array_levels_is_identity_only();
    a_span_of_arrays_of_a_struct_is_identity_only_as_well();
    an_array_of_arrays_of_a_struct_contains_it_by_value();
    a_function_type_stores_neither_its_result_nor_its_parameters();
    two_structs_that_contain_each_other_by_value_have_infinite_size();
    a_constant_reached_from_another_is_resolved_on_the_spot();
    a_cycle_between_two_constants_is_reported_once();
    a_declaration_may_hold_its_own_address();
    an_enum_value_may_not_refer_to_its_own_enum();
    a_declaration_that_failed_silences_everything_that_reads_it();
    a_use_of_a_name_an_import_failed_to_bind_is_silent();
    println("ok");
    return 0;
}
