//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: modules.read_at: index out of range
//! stdout:
//| main util
/// modules.read_at gives the module at a position of the set in read order, and a set of two
/// modules has no position 2.
import fort.modules;
import modules_env;

fn main() i32 {
    modules_env.env mut e = modules_env.open();
    defer modules_env.close(&e);
    modules_env.add(&e, "main.ft", "import util;\nfn main() i32 { return util.add(1, 2); }\n");
    modules_env.add(&e, "util.ft", modules_env.src_add());
    assert(modules_env.load(&e, "main.ft"));
    println(modules.read_at(&e.set, 0)->path, " ", modules.read_at(&e.set, 1)->path);
    modules.read_at(&e.set, 2);
    return 0;
}
