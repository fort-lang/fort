        ownership_transfer.empty_value(ownership_ffi_helpers_env.place(9));
    ownership_ffi_helpers_env.replace(&e, empty);
    ownership_ffi_helpers_env.apply(&e, &req, false, ownership_api.event_kind.invalid_use);
}

fn f05_b() void {
    ownership_ffi_arithmetic_env.env mut e = {};
    ownership_ffi_helpers_env.open(&e, true);
    defer ownership_ffi_helpers_env.close(&e);
    ownership_transfer.request mut req = ownership_ffi_helpers_env.request(&e,
        ownership_transfer.action.move_owner, 384, 172, 9, 2);

    ownership_ffi_helpers_env.apply(&e, &req, true, ownership_api.event_kind.invalid_use);
    assert(ownership_ffi_helpers_env.value(&e, 9).owner_empty);
    assert(e.raw.local.state.allocations[0].owner.place.root.ordinal == 2);
    assert(e.raw.local.state.sources[0].kind == ownership_api.source_kind.trusted_foreign);
    assert(e.raw.local.state.allocations[0].logical_length.kind == ownership_api.fact_kind.unknown);
}

fn f05_c() void {
    ownership_ffi_arithmetic_env.env mut e = {};
    ownership_ffi_helpers_env.open(&e, true);
    defer ownership_ffi_helpers_env.close(&e);
    ownership_transfer.request mut req = ownership_ffi_helpers_env.request(&e,
        ownership_transfer.action.release, 400, 175, 9, 9);

    ownership_ffi_helpers_env.apply(&e, &req, true, ownership_api.event_kind.invalid_use);
    assert(!e.raw.local.state.allocations[0].obligation);
    assert(e.raw.local.state.sources[0].validity == ownership_api.validity_kind.released);
}

