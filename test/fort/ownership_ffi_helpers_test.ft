fn f05_h() void {
    ownership_ffi_arithmetic_env.env mut e = {};
    ownership_ffi_helpers_env.open(&e, true);
    defer ownership_ffi_helpers_env.close(&e);
    ownership_transfer.request mut req = ownership_ffi_helpers_env.request(&e,
        ownership_transfer.action.use, 480, 190, 1, 1);
    ownership_api.source_fact mut unrelated = e.raw.local.state.sources[0];
    unrelated.kind = ownership_api.source_kind.static_storage;
    unrelated.boundary.operation = 1;
    unrelated.key = ownership_ffi_helpers_env.id(ownership_api.entity_kind.source, 1);
    unrelated.allocation = ownership_api.entity_id{};
    assert(ownership_state.add_source(&e.raw.local.state, &e.raw.local.service, unrelated,
        req.operation, req.source_position).applied);
    ownership_ffi_helpers_env.seed_reference(&e, 1, 1, 11);
    ownership_api.contents_fact mut independent = ownership_ffi_helpers_env.value(&e, 1);
    independent.span_length = ownership_api.scalar_fact{
        .kind = ownership_api.fact_kind.exact, .value = 1};
    ownership_ffi_helpers_env.replace(&e, independent);
    release_at(&e, 480, 190);
    req = ownership_ffi_helpers_env.request(&e, ownership_transfer.action.use, 481, 190, 1, 1);
    ownership_ffi_helpers_env.apply(&e, &req, true, ownership_api.event_kind.invalid_use);
}

