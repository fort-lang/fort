    ownership_transfer.request mut req = ownership_ffi_helpers_env.request(&e,
        ownership_transfer.action.use, 128, 124, 8, 8);
    release_at(&e, 128, 124);
    req = ownership_ffi_helpers_env.request(&e, ownership_transfer.action.use, 129, 124, 8, 8);
    ownership_ffi_helpers_env.apply(&e, &req, false, ownership_api.event_kind.invalid_use);
}

