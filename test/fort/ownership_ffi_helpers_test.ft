fn h13() void {
    ownership_ffi_arithmetic_env.env mut e = {};
    ownership_ffi_helpers_env.open(&e, true);
    defer ownership_ffi_helpers_env.close(&e);
    ownership_transfer.request mut req = ownership_ffi_helpers_env.request(&e,
        ownership_transfer.action.move_owner, 1312, 346, 9, 2);
    e.raw.local.state.sources[0].kind = ownership_api.source_kind.heap;
    e.raw.local.state.allocations[0].logical_length = ownership_api.scalar_fact{
        .kind = ownership_api.fact_kind.exact, .value = 4};
    ownership_api.contents_fact mut borrowed = ownership_ffi_helpers_env.value(&e, 8);
    borrowed.span_length = e.raw.local.state.allocations[0].logical_length;
    ownership_ffi_helpers_env.replace(&e, borrowed);
    ownership_api.contents_fact mut unequal = ownership_ffi_helpers_env.value(&e, 9);
    unequal.span_length = ownership_api.scalar_fact{
        .kind = ownership_api.fact_kind.exact, .value = 3};
    ownership_ffi_helpers_env.replace(&e, unequal);
    ownership_ffi_helpers_env.apply(&e, &req, false, ownership_api.event_kind.incomplete_proof);
}

