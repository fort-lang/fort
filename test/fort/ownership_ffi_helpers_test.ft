/// Tests supplied foreign helper boundaries and failed-input preservation.
import ownership_api;
import ownership_ffi_arithmetic_env;
import ownership_ffi_helpers_env;
import ownership_state;
import heap;
import std.str;
import std.libc;
import ownership_keys;
import ownership_borrows;
import ownership_borrows_env;
import ownership_liveness;
import ownership_raw;
import ownership_raw_env;
import ownership_regions;
import ownership_places;
import ownership_transfer;

fn changed_relation(ownership_ffi_arithmetic_env.env mut* e, bool complete, u32 version) void {
    ownership_api.contents_fact mut value = ownership_ffi_helpers_env.value(e, 9);
    ownership_api.borrow_relation[1] mut relation = {value.borrows[0]};
    relation[0].representation_complete = complete;
    relation[0].value_version =
        ownership_ffi_helpers_env.id(ownership_api.entity_kind.value, version);
    value.borrows = relation[..];
    ownership_ffi_helpers_env.replace(e, value);
}

fn f02_a() void {
    ownership_ffi_arithmetic_env.env mut e = {};
    ownership_ffi_helpers_env.open(&e, false);
    defer ownership_ffi_helpers_env.close(&e);
    ownership_transfer.request mut req = ownership_ffi_helpers_env.request(&e,
        ownership_transfer.action.use, 96, 118, 9, 9);

    ownership_ffi_helpers_env.apply(&e, &req, true, ownership_api.event_kind.invalid_use);
}

fn f02_c() void {
    ownership_ffi_arithmetic_env.env mut e = {};
