fn release_at(ownership_ffi_arithmetic_env.env mut* e, u32 operation, u32 line) void {
    ownership_transfer.request req = ownership_ffi_helpers_env.request(e,
        ownership_transfer.action.release, operation, line, 9, 9);
    ownership_ffi_helpers_env.apply(e, &req, true, ownership_api.event_kind.invalid_use);
}
fn transfer_at(ownership_ffi_arithmetic_env.env mut* e, u32 operation, u32 line) void {
    ownership_transfer.request req = ownership_ffi_helpers_env.request(e,
        ownership_transfer.action.move_owner, operation, line, 9, 2);
    ownership_ffi_helpers_env.apply(e, &req, true, ownership_api.event_kind.invalid_use);
}
fn field_path(u32 slot, ownership_api.projection mut@ parts) ownership_api.place_path {
    parts[0].kind = ownership_api.projection_kind.field;
    parts[0].field = 0;
    ownership_api.place_path mut out = ownership_ffi_helpers_env.place(slot);
    out.projections = parts[..];
    return out;
}
fn element_path(ownership_api.projection mut@ parts) ownership_api.place_path {
    parts[0].kind = ownership_api.projection_kind.fixed_index;
    parts[0].index = ownership_api.scalar_fact{.kind = ownership_api.fact_kind.exact, .value = 2};
    ownership_api.place_path mut out = ownership_ffi_helpers_env.place(4);
    out.projections = parts[..];
    return out;
}
fn f04_b() void {
    ownership_ffi_arithmetic_env.env mut e = {};
    ownership_ffi_helpers_env.open(&e, true);
    defer ownership_ffi_helpers_env.close(&e);
    ownership_transfer.request mut base = ownership_ffi_helpers_env.request(&e,
        ownership_transfer.action.inspect, 304, 157, 9, 9);
    ownership_api.projection[1] mut parts = {};
    base.destination = field_path(3, parts[..]);
    base.destination_owns = true;
    ownership_ffi_helpers_env.projected_apply(&e, &base,
        ownership_places.action.move_value, true, ownership_api.event_kind.invalid_use);
    assert(ownership_ffi_helpers_env.value(&e, 9).owner_empty);
    assert(ownership_state.same_place(e.raw.local.state.allocations[0].owner.place,
        base.destination));
}

fn f04_c() void {
    ownership_ffi_arithmetic_env.env mut e = {};
    ownership_ffi_helpers_env.open(&e, true);
    defer ownership_ffi_helpers_env.close(&e);
    ownership_transfer.request mut base = ownership_ffi_helpers_env.request(&e,
        ownership_transfer.action.inspect, 320, 160, 9, 9);
    ownership_api.projection[1] mut parts = {};
    base.source = field_path(3, parts[..]);
    ownership_ffi_helpers_env.project(&e, base.source, true);
    base.destination = base.source;
    ownership_ffi_helpers_env.projected_apply(&e, &base,
        ownership_places.action.release_value, true, ownership_api.event_kind.invalid_use);
    assert(!e.raw.local.state.allocations[0].obligation);
    assert(e.raw.local.state.sources[0].validity == ownership_api.validity_kind.released);
}

fn f04_d() void {
    ownership_ffi_arithmetic_env.env mut e = {};
    ownership_ffi_helpers_env.open(&e, true);
    defer ownership_ffi_helpers_env.close(&e);
    ownership_transfer.request mut base = ownership_ffi_helpers_env.request(&e,
        ownership_transfer.action.inspect, 336, 163, 9, 9);
    ownership_api.projection[1] mut parts = {};
    base.source = element_path(parts[..]);
    ownership_ffi_helpers_env.project(&e, base.source, true);
    base.destination = ownership_ffi_helpers_env.place(9);
    base.destination_owns = true;
    ownership_regions.result mut out = ownership_ffi_helpers_env.region_apply(&e, &base,
        ownership_regions.action.move_value, true);
    defer ownership_regions.free(&out);
    assert(ownership_api.successful(out.proof) && out.len == 1);
    assert(out.states[0].allocations[0].owner.place.root.ordinal == 9);
    assert(out.states[0].sources[0].kind == ownership_api.source_kind.trusted_foreign);
}

