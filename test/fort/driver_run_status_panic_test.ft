//! run
//! flags: -I ../../src
//! abort
//! stderr: panic: driver.run_status: a program run that did not end
//! stdout:
//| 7
/// run_status gives the status of the end of a program that --fir-run ran, and a program never
/// ends with the return of run_function. The test passes an exit, then a return.
import fort.driver;
import fort.fir.interpreter;

fn main() i32 {
    interpreter.outcome mut o = interpreter.outcome{};
    o.kind = interpreter.outcome_kind.oc_exit;
    o.status = 7;
    println(driver.run_status(&o, "x86_64-linux-gnu"));
    o.kind = interpreter.outcome_kind.oc_return;
    driver.run_status(&o, "x86_64-linux-gnu");
    return 0;
}
