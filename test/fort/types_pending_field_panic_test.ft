//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: types.type_layout_struct: layout with a pending field
//! stdout:
//| true
import types;
import types_env;

// Every field is laid out before the struct that holds it, which
// type_layout_pending is how a caller finds out.
// D3.8
fn main() i32 {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node* holder = types.type_struct(&e.tt, "holder", cast(&e.names[0], void mut*));
    types.node*[1] mut fields = {e.rec};
    u64[1] mut offsets = {};
    println(types.type_layout_begin(holder));
    println(types.type_layout_struct(holder, fields[..], offsets[..]));
    return 0;
}
