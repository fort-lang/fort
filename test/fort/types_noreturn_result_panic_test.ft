//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: types.type_fn: noreturn with a return type
//! stdout:
//| 8
/// A `noreturn` function has no result type: its elem is `void`.
import fort.types;
import types_env;

fn main() i32 {
    types_env.env mut* own e = types_env.make();
    defer types_env.drop_made(move(e));
    types.node*[1] mut none = {};
    println(types.type_sizeof(types.type_fn(&e->tt, types.type_void(&e->tt), none[..0], true)));
    println(types.type_sizeof(types.type_fn(&e->tt, types_env.type_of(e, "i32"), none[..0], true)));
    return 0;
}
