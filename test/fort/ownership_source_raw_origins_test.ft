//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| local_word ok
//| local_long ok
//| local_pair ok
//| field_long ok
//| field_word ok
//| constant_element ok
//| variable_element ok
//| whole_array ok
//| global_word ok
//| parameter_slot ok
//| new_object ok
//| new_span ok
//| array_slice ok
//| span_slice ok
//| raw_range ok
//| void_trip ok
//| string_bytes ok
//| foreign ok
//| reconstructed ok
/// Holds the raw verdicts of each address origin under each kind of obligation.
import ownership_raw_source_env;
import ownership_source_raw;

// Window 4 bytes, alignment 4: the obligations hold inside the
// window, and a range, a read or an alignment past it fails exactly.
fn local_word() void {
    ownership_raw_source_env.closure mut c = ownership_raw_source_env.closure{};
    string[45] lines = {
        "struct pair { i32 a; i64 b; u8* p; }",
        "u64 WORD = 3;",
        "extern fn shared_bytes() u8*;",
        "fn local_word_in_window() u64 {",
        "    u32 x = 7;",
        "    u8* b = cast(&x, u8*);",
        "    u8@ view = b[0..4];",
        "    return view.len;",
        "}",
        "fn local_word_first_byte() u8 {",
        "    u32 x = 7;",
        "    u8* b = cast(&x, u8*);",
        "    return *b;",
        "}",
        "fn local_word_last_byte() u8 {",
        "    u32 x = 7;",
        "    u8* b = cast(&x, u8*);",
        "    u8@ view = b[3..4];",
        "    return view[0];",
        "}",
        "fn local_word_aligned_read() u32 {",
        "    u32 x = 7;",
        "    u8* b = cast(&x, u8*);",
        "    u32* typed = cast(b, u32*);",
        "    return *typed;",
        "}",
        "fn local_word_past_window() u64 {",
        "    u32 x = 7;",
        "    u8* b = cast(&x, u8*);",
        "    u8@ view = b[0..5];",
        "    return view.len;",
        "}",
        "fn local_word_wide_read() u8 {",
        "    u32 x = 7;",
        "    u8* b = cast(&x, u8*);",
        "    u8[5]* w = cast(b, u8[5]*);",
        "    u8[5] copy = *w;",
        "    return copy[0];",
        "}",
        "fn local_word_misaligned_read() u16 {",
        "    u32 x = 7;",
        "    u8* b = cast(&x, u8*);",
        "    u16* m = cast(b[1..4].ptr, u16*);",
        "    return *m;",
        "}",
    };
    ownership_raw_source_env.open(&c, lines[..]);
    defer ownership_raw_source_env.close(&c);
    ownership_raw_source_env.proved(&c, "local_word_in_window");
    ownership_raw_source_env.proved(&c, "local_word_first_byte");
    ownership_raw_source_env.proved(&c, "local_word_last_byte");
    ownership_raw_source_env.proved(&c, "local_word_aligned_read");
    ownership_raw_source_env.violation(&c, "local_word_past_window", "b",
        "raw range exceeds proved storage", 30);
    ownership_raw_source_env.violation(&c, "local_word_wide_read", "w",
        "typed access exceeds its inherited window", 37);
    ownership_raw_source_env.violation(&c, "local_word_misaligned_read", "m",
        "typed access alignment remains unproved", 44);
    ownership_raw_source_env.report(&c, "local_word");
}

