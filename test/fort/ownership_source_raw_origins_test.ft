    ownership_raw_source_env.proved(&c, "raw_range_last_byte");
    ownership_raw_source_env.proved(&c, "raw_range_aligned_read");
    ownership_raw_source_env.violation(&c, "raw_range_past_window", "b",
        "raw range exceeds proved storage", 40);
    ownership_raw_source_env.violation(&c, "raw_range_wide_read", "w",
        "typed access exceeds its inherited window", 49);
    ownership_raw_source_env.violation(&c, "raw_range_misaligned_read", "m",
        "typed access alignment remains unproved", 58);
    ownership_raw_source_env.report(&c, "raw_range");
}

// Window 8 bytes, alignment 8: the obligations hold inside the
// window, and a range, a read or an alignment past it fails exactly.
fn void_trip() void {
    ownership_raw_source_env.closure mut c = ownership_raw_source_env.closure{};
    string[52] lines = {
        "struct pair { i32 a; i64 b; u8* p; }",
        "u64 WORD = 3;",
        "extern fn shared_bytes() u8*;",
        "fn void_trip_in_window() u64 {",
        "    u64 x = 7;",
        "    void* v = cast(&x, void*);",
        "    u8* b = cast(v, u8*);",
        "    u8@ view = b[0..8];",
        "    return view.len;",
        "}",
        "fn void_trip_first_byte() u8 {",
        "    u64 x = 7;",
        "    void* v = cast(&x, void*);",
        "    u8* b = cast(v, u8*);",
        "    return *b;",
        "}",
        "fn void_trip_last_byte() u8 {",
        "    u64 x = 7;",
        "    void* v = cast(&x, void*);",
        "    u8* b = cast(v, u8*);",
        "    u8@ view = b[7..8];",
        "    return view[0];",
        "}",
        "fn void_trip_aligned_read() u64 {",
        "    u64 x = 7;",
        "    void* v = cast(&x, void*);",
        "    u8* b = cast(v, u8*);",
        "    u64* typed = cast(b, u64*);",
        "    return *typed;",
        "}",
        "fn void_trip_past_window() u64 {",
        "    u64 x = 7;",
        "    void* v = cast(&x, void*);",
        "    u8* b = cast(v, u8*);",
        "    u8@ view = b[0..9];",
        "    return view.len;",
        "}",
        "fn void_trip_wide_read() u8 {",
        "    u64 x = 7;",
        "    void* v = cast(&x, void*);",
        "    u8* b = cast(v, u8*);",
        "    u8[9]* w = cast(b, u8[9]*);",
        "    u8[9] copy = *w;",
        "    return copy[0];",
        "}",
        "fn void_trip_misaligned_read() u16 {",
        "    u64 x = 7;",
        "    void* v = cast(&x, void*);",
        "    u8* b = cast(v, u8*);",
        "    u16* m = cast(b[1..8].ptr, u16*);",
        "    return *m;",
        "}",
    };
    ownership_raw_source_env.open(&c, lines[..]);
    defer ownership_raw_source_env.close(&c);
    ownership_raw_source_env.proved(&c, "void_trip_in_window");
    ownership_raw_source_env.proved(&c, "void_trip_first_byte");
    ownership_raw_source_env.proved(&c, "void_trip_last_byte");
    ownership_raw_source_env.proved(&c, "void_trip_aligned_read");
    ownership_raw_source_env.violation(&c, "void_trip_past_window", "b",
        "raw range exceeds proved storage", 35);
    ownership_raw_source_env.violation(&c, "void_trip_wide_read", "w",
        "typed access exceeds its inherited window", 43);
    ownership_raw_source_env.violation(&c, "void_trip_misaligned_read", "m",
        "typed access alignment remains unproved", 51);
    ownership_raw_source_env.report(&c, "void_trip");
}

// Window 8 bytes, alignment 1: the obligations hold inside the
// window, and a range, a read or an alignment past it fails exactly.
fn string_bytes() void {
    ownership_raw_source_env.closure mut c = ownership_raw_source_env.closure{};
    string[45] lines = {
        "struct pair { i32 a; i64 b; u8* p; }",
        "u64 WORD = 3;",
        "extern fn shared_bytes() u8*;",
        "fn string_bytes_in_window() u64 {",
        "    string s = \"abcdefgh\";",
        "    u8* b = cast(s.ptr, u8*);",
        "    u8@ view = b[0..8];",
        "    return view.len;",
        "}",
        "fn string_bytes_first_byte() u8 {",
        "    string s = \"abcdefgh\";",
        "    u8* b = cast(s.ptr, u8*);",
        "    return *b;",
        "}",
        "fn string_bytes_last_byte() u8 {",
        "    string s = \"abcdefgh\";",
        "    u8* b = cast(s.ptr, u8*);",
        "    u8@ view = b[7..8];",
        "    return view[0];",
        "}",
        "fn string_bytes_aligned_read() u8 {",
        "    string s = \"abcdefgh\";",
        "    u8* b = cast(s.ptr, u8*);",
        "    u8* typed = cast(b, u8*);",
        "    return *typed;",
        "}",
        "fn string_bytes_past_window() u64 {",
        "    string s = \"abcdefgh\";",
        "    u8* b = cast(s.ptr, u8*);",
        "    u8@ view = b[0..9];",
        "    return view.len;",
        "}",
        "fn string_bytes_wide_read() u8 {",
        "    string s = \"abcdefgh\";",
        "    u8* b = cast(s.ptr, u8*);",
        "    u8[9]* w = cast(b, u8[9]*);",
        "    u8[9] copy = *w;",
        "    return copy[0];",
        "}",
        "fn string_bytes_misaligned_read() u16 {",
        "    string s = \"abcdefgh\";",
        "    u8* b = cast(s.ptr, u8*);",
        "    u16* m = cast(b[1..8].ptr, u16*);",
        "    return *m;",
        "}",
    };
    ownership_raw_source_env.open(&c, lines[..]);
    defer ownership_raw_source_env.close(&c);
    ownership_raw_source_env.proved(&c, "string_bytes_in_window");
    ownership_raw_source_env.proved(&c, "string_bytes_first_byte");
    ownership_raw_source_env.proved(&c, "string_bytes_last_byte");
    ownership_raw_source_env.proved(&c, "string_bytes_aligned_read");
    ownership_raw_source_env.violation(&c, "string_bytes_past_window", "b",
        "raw range exceeds proved storage", 30);
    ownership_raw_source_env.violation(&c, "string_bytes_wide_read", "w",
        "typed access exceeds its inherited window", 37);
    ownership_raw_source_env.unproved(&c, "string_bytes_misaligned_read",
        "typed access alignment remains unproved", 44);
    ownership_raw_source_env.report(&c, "string_bytes");
}

// A trusted foreign source has no static window or alignment (D17.13).
fn foreign() void {
    ownership_raw_source_env.closure mut c = ownership_raw_source_env.closure{};
    string[43] lines = {
        "struct pair { i32 a; i64 b; u8* p; }",
        "u64 WORD = 3;",
        "extern fn shared_bytes() u8*;",
        "fn foreign_in_window() u64 {",
        "    u8* b = shared_bytes();",
        "    u8@ view = b[0..8];",
        "    return view.len;",
        "}",
        "fn foreign_first_byte() u8 {",
        "    u8* b = shared_bytes();",
        "    return *b;",
        "}",
        "fn foreign_last_byte() u8 {",
        "    u8* b = shared_bytes();",
        "    u8@ view = b[7..8];",
        "    return view[0];",
        "}",
        "fn foreign_aligned_read() u64 {",
        "    u8* b = shared_bytes();",
        "    u64* typed = cast(b, u64*);",
        "    return *typed;",
        "}",
        "fn foreign_past_window() u64 {",
        "    u8* b = shared_bytes();",
        "    u8@ view = b[0..9];",
        "    return view.len;",
        "}",
        "fn foreign_wide_read() u8 {",
        "    u8* b = shared_bytes();",
        "    u8[9]* w = cast(b, u8[9]*);",
        "    u8[9] copy = *w;",
        "    return copy[0];",
        "}",
        "fn foreign_misaligned_read() u16 {",
        "    u8* b = shared_bytes();",
        "    u16* m = cast(b[1..8].ptr, u16*);",
        "    return *m;",
        "}",
        "fn foreign_field_address() i64 {",
        "    pair* q = cast(shared_bytes(), pair*);",
        "    i64* f = &q->b;",
        "    return *f;",
        "}",
    };
    ownership_raw_source_env.open(&c, lines[..]);
    defer ownership_raw_source_env.close(&c);
    ownership_raw_source_env.proved(&c, "foreign_in_window");
    ownership_raw_source_env.proved(&c, "foreign_first_byte");
    ownership_raw_source_env.proved(&c, "foreign_last_byte");
    ownership_raw_source_env.proved(&c, "foreign_aligned_read");
    ownership_raw_source_env.proved(&c, "foreign_past_window");
    ownership_raw_source_env.proved(&c, "foreign_wide_read");
    ownership_raw_source_env.proved(&c, "foreign_misaligned_read");
    // A field address narrows no foreign window: the trusted value has none (D17.13).
    ownership_raw_source_env.proved(&c, "foreign_field_address");
    ownership_raw_source_env.counts(&c, "foreign_field_address", 2, 0, 1, 1, 0, 0);
    ownership_raw_source_env.report(&c, "foreign");
}

// An integer cast supplies no source: each access fails on each path, wherever the body keeps
// the bits (D17.17). D17.17 names no source for a function address, so an access through one
// stays incomplete proof and is no integer reconstruction.
fn reconstructed() void {
    ownership_raw_source_env.closure mut c = ownership_raw_source_env.closure{};
    string[46] lines = {
        "struct pair { i32 a; i64 b; u8* p; }",
        "u64 WORD = 3;",
        "extern fn shared_bytes() u8*;",
        "fn reconstructed_first_byte(u64 bits) u8 {",
        "    u8* b = cast(bits, u8*);",
        "    return *b;",
        "}",
        "fn reconstructed_in_window(u64 bits) u64 {",
        "    u8* b = cast(bits, u8*);",
        "    u8@ view = b[0..1];",
        "    return view.len;",
        "}",
        "fn reconstructed_wide_read(u64 bits) u64 {",
        "    u8* b = cast(bits, u8*);",
        "    u64* w = cast(b, u64*);",
        "    return *w;",
        "}",
        "struct bits { u64 v; }",
        "fn round_trip_field() i32 {",
        "    i32 x = 7;",
        "    bits mut h = bits{};",
        "    h.v = cast(&x, u64);",
        "    i32* q = cast(h.v, i32*);",
        "    return *q;",
        "}",
        "fn round_trip_element() i32 {",
        "    i32 x = 7;",
        "    u64[1] mut h = {0};",
        "    h[0] = cast(&x, u64);",
        "    i32* q = cast(h[0], i32*);",
        "    return *q;",
        "}",
        "fn round_trip_loaded() i32 {",
        "    i32 x = 7;",
        "    u64 mut bits_of_x = cast(&x, u64);",
        "    u64* w = &bits_of_x;",
        "    i32* q = cast(*w, i32*);",
        "    return *q;",
        "}",
        "fn seven() u8 { return 7; }",
        "fn function_bytes() u8 {",
        "    fn () u8 f = seven;",
        "    void* v = cast(f, void*);",
        "    u8* b = cast(v, u8*);",
        "    return *b;",
        "}",
    };
    ownership_raw_source_env.open(&c, lines[..]);
    defer ownership_raw_source_env.close(&c);
    ownership_raw_source_env.violation(&c, "reconstructed_first_byte", "b",
        "raw access needs a proved original source", 6);
    ownership_raw_source_env.violation(&c, "reconstructed_in_window", "b",
        "raw access needs a proved original source", 10);
    ownership_raw_source_env.violation(&c, "reconstructed_wide_read", "w",
        "raw access needs a proved original source", 16);
    ownership_raw_source_env.counts(&c, "reconstructed_wide_read", 1, 0, 0, 1, 0, 1);
    // Integer bits in a field, an element or loaded storage name no source either (D17.17).
    ownership_raw_source_env.violation(&c, "round_trip_field", "q",
        "raw access needs a proved original source", 24);
    ownership_raw_source_env.violation(&c, "round_trip_element", "q",
        "raw access needs a proved original source", 31);
    ownership_raw_source_env.violation(&c, "round_trip_loaded", "q",
        "raw access needs a proved original source", 38);
    // Two accesses (*w and *q), two addresses (&x and &bits_of_x), one reconstruction.
    ownership_raw_source_env.counts(&c, "round_trip_loaded", 2, 0, 2, 0, 0, 1);
    ownership_raw_source_env.outside(&c, "function_bytes",
        ownership_source_raw.missing.unknown_origin);
    ownership_raw_source_env.counts(&c, "function_bytes", 1, 0, 0, 1, 0, 0);
    ownership_raw_source_env.report(&c, "reconstructed");
}

