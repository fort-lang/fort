//! run
//! flags: -I ../../src -I support
//! stdout:
//| ok
/// Checks the token dump from `fort --tokens`.
import fort.diag;
import lex_env;
import fort.lexer;
import fort.session;
import std.strbuf;

//
// Each output line has this form:
// <line>:<col>-<end_line>:<end_col> <value> "<spelling>" <kind>
//
// Each line describes one token. The range starts at 1 and has an exclusive
// end. The value is an integer or character literal, or 0 for other tokens.
// Escaping keeps newlines, tabs, quotes, and non-printable bytes on one line.
// The kind is last because only that field can contain a space.
//
// The assertions pin the dump format.

// ---- the queries of this suite over lex_env ------------------------------------

// The dump of `src`, held against `lines` with a newline after each: the
// whole of what --tokens writes for that file.
fn dumps_as(lex_env.env mut* f, string src, string@ lines) bool {
    lex_env.lex(f, src);
    strbuf.str_buf mut got = strbuf.create();
    defer del(got.data);
    lexer.tok_dump(&f->toks, &got);
    strbuf.str_buf mut want = strbuf.create();
    defer del(want.data);
    {
        string@ range_values = lines;
        u64 mut range_index = 0;
        while (range_index < range_values.len) {
            string line = range_values[range_index];
            range_index += 1;
            strbuf.append(&want, line);
            strbuf.push(&want, '\n');
        }
    }
    if (strbuf.view(&got) != strbuf.view(&want)) {
        // The assertion that follows says only that a dump differed, so the
        // two texts are printed here. Stdout is compared, so this can only
        // run on a test that is failing anyway.
        println("--- the dump is");
        print(strbuf.view(&got));
        println("--- expected");
        print(strbuf.view(&want));
        return false;
    }
    return true;
}

// ---- the form of a line ---------------------------------------------------------

// The complete worked example, byte for byte.
fn the_worked_example_of_toolchain_md_1() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    string[5] want = {
        "1:1-1:2 0 \"x\" identifier",
        "1:3-1:4 0 \"=\" =",
        "1:5-1:9 16 \"0x10\" integer literal",
        "1:9-1:10 0 \";\" ;",
        "2:1-2:1 0 \"\" end of file",
    };
    assert(dumps_as(f, "x = 0x10;\n", want[..]));
}

// An empty file is the end-of-file token alone, an empty range at 1:1 with an
// empty spelling.
fn an_empty_file_dumps_one_line() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    string[1] want = {"1:1-1:1 0 \"\" end of file"};
    assert(dumps_as(f, "", want[..]));
}

// The range ends where the next token may begin: `col + len`, exclusive.
fn the_range_is_the_tokens_own() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    string[4] want = {
        "1:1-1:3 0 \"fn\" fn",
        "2:3-2:6 0 \"+%=\" +%=",
        "2:6-2:7 0 \"@\" @",
        "2:7-2:7 0 \"\" end of file",
    };
    assert(dumps_as(f, "fn\n  +%=@", want[..]));
}

// A tab is one column, so the range of the token after it moves by one.
fn a_tab_moves_the_range_by_one_column() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    string[2] want = {
        "1:2-1:3 0 \"a\" identifier",
        "1:3-1:3 0 \"\" end of file",
    };
    assert(dumps_as(f, "\ta", want[..]));
}

// ---- the value field ------------------------------------------------------------

// An integer literal carries its magnitude, whatever its radix, and the
// spelling stays the source's.
fn an_integer_literal_dumps_its_magnitude() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    string[5] want = {
        "1:1-1:7 4095 \"0xFF_F\" integer literal",
        "1:8-1:12 2 \"0b10\" integer literal",
        "1:13-1:17 15 \"0o17\" integer literal",
        "1:18-1:38 18446744073709551615 \"18446744073709551615\" integer literal",
        "1:38-1:38 0 \"\" end of file",
    };
    assert(dumps_as(f, "0xFF_F 0b10 0o17 18446744073709551615", want[..]));
}

// A char literal carries its byte value and keeps the source's spelling, so
// the escape is visible beside the byte it decoded to.
fn a_char_literal_dumps_its_byte_and_its_spelling() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    string[4] want = {
        "1:1-1:5 10 \"'\\\\n'\" char literal",
        "1:6-1:12 255 \"'\\\\xff'\" char literal",
        "1:13-1:16 97 \"'a'\" char literal",
        "1:16-1:16 0 \"\" end of file",
    };
    assert(dumps_as(f, "'\\n' '\\xff' 'a'", want[..]));
}

// Every other kind leaves the value at 0, a float literal included: the lexer
// computes no float value.
fn every_other_kind_dumps_a_zero_value() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    string[4] want = {
        "1:1-1:6 0 \"1.5e2\" float literal",
        "1:7-1:11 0 \"ab\" string literal",
        "1:12-1:15 0 \"own\" own",
        "1:15-1:15 0 \"\" end of file",
    };
    assert(dumps_as(f, "1.5e2 \"ab\" own", want[..]));
}

// ---- the escaped spelling --------------------------------------------------------

// A string literal's spelling is its decoded bytes, so what the dump escapes
// is what the literal means and not what was typed.
fn a_decoded_newline_tab_and_return_are_escaped() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    string[2] want = {
        "1:1-1:13 0 \"a\\nb\\tc\\rd\" string literal",
        "1:13-1:13 0 \"\" end of file",
    };
    assert(dumps_as(f, "\"a\\nb\\tc\\rd\"", want[..]));
}

// The two bytes that would end the field, or start an escape of the dump's
// own, are escaped: `"` and `\`.
fn a_quote_and_a_backslash_are_escaped() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    string[2] want = {
        "1:1-1:10 0 \"a\\\"b\\\\c\" string literal",
        "1:10-1:10 0 \"\" end of file",
    };
    assert(dumps_as(f, "\"a\\\"b\\\\c\"", want[..]));
}

// A byte outside printable ASCII is written 0xHH with uppercase digits, the
// NUL and the high bytes of UTF-8 included.
fn a_byte_outside_printable_ascii_is_written_in_hex() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    string[2] want = {
        "1:1-1:19 0 \"a\\x00b\\x01\\x7F\\xC3\\xA9\" string literal",
        "1:19-1:19 0 \"\" end of file",
    };
    assert(dumps_as(f, "\"a\\x00b\\x01\\x7F\xC3\xA9\"", want[..]));
}

// A raw tab inside a string literal is a byte of it and is escaped like a
// decoded one. So one token is still one line.
fn a_raw_tab_inside_a_literal_is_escaped() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    string[2] want = {
        "1:1-1:6 0 \"a\\tb\" string literal",
        "1:6-1:6 0 \"\" end of file",
    };
    assert(dumps_as(f, "\"a\tb\"", want[..]));
}

// A printable byte stands for itself, the space and the quote-adjacent ones
// included, so a spelling is readable.
fn printable_bytes_stand_for_themselves() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    string[2] want = {
        "1:1-1:16 0 \"a b // c /* d\" string literal",
        "1:16-1:16 0 \"\" end of file",
    };
    assert(dumps_as(f, "\"a b // c /* d\"", want[..]));
}

// ---- a file that does not lex ----------------------------------------------------

// The dump covers the file whatever was reported: the broken line is dropped
// and the lines around it are there.
fn a_broken_line_is_missing_from_the_dump() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    string[3] want = {
        "1:1-1:2 0 \"a\" identifier",
        "3:1-3:2 0 \"b\" identifier",
        "4:1-4:1 0 \"\" end of file",
    };
    assert(dumps_as(f, "a\n#\nb\n", want[..]));
    assert(lex_env.errors(f) == 1);
}

fn main() i32 {
    the_worked_example_of_toolchain_md_1();
    an_empty_file_dumps_one_line();
    the_range_is_the_tokens_own();
    a_tab_moves_the_range_by_one_column();
    an_integer_literal_dumps_its_magnitude();
    a_char_literal_dumps_its_byte_and_its_spelling();
    every_other_kind_dumps_a_zero_value();
    a_decoded_newline_tab_and_return_are_escaped();
    a_quote_and_a_backslash_are_escaped();
    a_byte_outside_printable_ascii_is_written_in_hex();
    a_raw_tab_inside_a_literal_is_escaped();
    printable_bytes_stand_for_themselves();
    a_broken_line_is_missing_from_the_dump();
    println("ok");
    return 0;
}
