//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: ownership_source_raw: invalid solve order
//! stdout:
//| false
/// solve runs once, after prepare. A context that prepare never bound breaks that order, so
/// the call panics before it reads any statement.
import ownership_source_raw;

fn main() i32 {
    ownership_source_raw.context mut c = ownership_source_raw.context{};
    println(c.initialized);
    ownership_source_raw.solve(&c);
    return 0;
}
