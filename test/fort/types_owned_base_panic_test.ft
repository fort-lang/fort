//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: types.check_positions: own on a base type that is already owned
//! stdout:
//| true
import types;
import types_env;

// No source can write `own` on a base type that already owns: the base of a
// written type is never an owned type, so the builder treats it as a compiler bug
// rather than a diagnostic.
// D17.2
fn main() i32 {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.suffix[1] mut none = {};
    types.node* owned = types.type_string(&e.tt, true);
    println(types.type_build(&e.tt, false, false, owned, none[..0]).built != null);
    println(types.type_build(&e.tt, true, false, owned, none[..0]).built != null);
    return 0;
}
