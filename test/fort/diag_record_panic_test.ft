//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: diag.record_at: index out of range
//! stdout:
//| only one
//| 1
import diag;

// record_at answers for every record reported and panics past the last one,
// rather than reading a slot of the records vector that no report filled.
// The vector has room for sixteen here and holds one.
// D13.3
fn main() i32 {
    diag.sink mut s = diag.create();
    defer diag.free(&s);
    diag.error(&s, diag.loc_make("a.ft", 1, 1), "only one");
    println(diag.record_at(&s, 0).msg);
    println(diag.record_count(&s));
    println(diag.record_at(&s, 1).msg);
    return 0;
}
