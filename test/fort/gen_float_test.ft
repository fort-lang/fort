//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| constants ok
//| arithmetic ok
//| comparisons ok
//| casts ok
//| printing ok
//| signatures ok
//| module ok
//| ok
/// Checks float constants, arithmetic, comparisons, conversions, printing,
/// signatures, and module output.
import gen;
import gen_env;
import gen_stmt;
import std.str;
import std.strbuf;

//
// stage1 rejects floats, so it provides no reference output. The assertions
// instead check the cast table, fast-math flags,
// print routing, constant forms, and NaN behavior.
//
// A run test can see the selected fcmp predicate only through a NaN comparison.
// It cannot see a fast-math flag. The assembler also rejects an f32 constant
// that binary64 cannot hold exactly. Therefore, these cases check the emitted
// text. The stage2 language corpus gives a second check.

// The two locals every probe starts from, and the loads of them.
string A_F64 = "    f64 mut a = 3.5;";
string B_F64 = "    f64 mut b = 0.5;";
string A_F32 = "    f32 mut a = 3.5;";
string B_F32 = "    f32 mut b = 0.5;";
string LOAD_A = "  %t0 = load double, ptr %a.0, align 8\n";
string LOAD_B = "  %t1 = load double, ptr %b.1, align 8\n";
string LOAD_A32 = "  %t0 = load float, ptr %a.0, align 4\n";
string LOAD_B32 = "  %t1 = load float, ptr %b.1, align 4\n";

// This line holds the emitted function signature. It stays separate
// because fort does not join literals and `.ft` lines have 100 columns.
string DEFINE_NARROW =
    "define dso_local float @\"main.narrow\"(double %a.in, float %b.in, i8 signext %c.in) #0 {\n";

// The eight fast-math flags of LLVM, which no float instruction may carry (item
// 15). `contract` and `afn` are among them, so a module that holds none of
// these words holds no fast-math flag at all.
string[8] FAST_MATH = {"fast", "nnan", "ninf", "nsz", "arcp", "contract", "afn", "reassoc"};

fn open3(gen_env.env mut* e, string one, string two, string three) bool {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, one);
    strbuf.push(&b, '\n');
    strbuf.append(&b, two);
    strbuf.push(&b, '\n');
    strbuf.append(&b, three);
    return gen_env.open_body(e, strbuf.view(&b));
}

// The value of the local `name` in a body of three lines, held against one,
// two or three lines of expected text. Each probe opens a sandbox of its own.
// A second body checked into one sandbox declares a second local of that name
// beside the first, and the emitter would answer about the first.
fn probe1(string one, string two, string three, string name, string x1) void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    assert(open3(&e, one, two, three));
    gen_env.emit_value(&e, name);
    gen_env.expect_text(gen_env.body(&e), x1);
}

fn probe2(string one, string two, string three, string name, string x1, string x2) void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    assert(open3(&e, one, two, three));
    gen_env.emit_value(&e, name);
    gen_env.expect_text(gen_env.body(&e), gen_env.join2(&e, x1, x2));
}

fn probe3(string one, string two, string three, string name, string x1, string x2,
               string x3) void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    assert(open3(&e, one, two, three));
    gen_env.emit_value(&e, name);
    gen_env.expect_text(gen_env.body(&e), gen_env.join3(&e, x1, x2, x3));
}

// The same for a cast to an integer, which also asserts the intrinsic slot the
// emitter marked used and the attribute group its declaration carries.
fn probe_conv(string one, string two, string three, string name, string x1, string x2,
                   u64 slot) void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    assert(open3(&e, one, two, three));
    gen_env.emit_value(&e, name);
    gen_env.expect_text(gen_env.body(&e), gen_env.join2(&e, x1, x2));
    assert(gen.gen_uses_intrinsic(&e.g, slot));
    assert(gen.gen_uses_attr(&e.g, gen.ATTR_OVERFLOW));
}

// ---- a float constant ----------------------------------------------------

// A folded constant is a literal and emits nothing. Its text is `0x` and the
// sixteen hex digits of the binary64 pattern, which is the form LLVM 18 reads
// a float constant in.
fn a_float_constant_is_the_hex_form_of_its_pattern() void {
    want_const(A_F64, B_F64, "    f64 mut c = 0.1;", "c", "double", "0x3FB999999999999A");
}

// An f32 constant carries the binary64 pattern of the binary32 value, whose
// last 29 bits are zero. LLVM rejects a `float 0x...` that is not a binary64
// the type holds exactly. And a wrong value here would still look like a
// constant of 0.1.
fn an_f32_constant_is_a_binary64_the_type_holds_exactly() void {
    want_const(A_F32, B_F32, "    f32 mut c = 0.1;", "c", "float", "0x3FB99999A0000000");
}

// The same for a constant folded from an expression, and for an integer
// constant the context gave a float type. A constant value of the local `name`,
// asserted as a type and a text: the sandbox is its own, as in the probes
// above.
fn want_const(string one, string two, string three, string name, string ty, string val) void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    assert(open3(&e, one, two, three));
    gen.gen_val v = gen_env.emit_value(&e, name);
    gen_env.expect_text(gen_env.body(&e), "");
    gen_env.expect_text(v.ty, ty);
    gen_env.expect_text(v.val, val);
}

fn a_folded_expression_and_an_integer_take_the_float_form() void {
    want_const(A_F64, B_F64, "    f64 mut c = 1.0 / 3.0;", "c", "double",
               "0x3FD5555555555555");
    // An untyped integer takes the float type of its context and is emitted in
    // the float form.
    want_const(A_F64, B_F64, "    f64 mut c = 7;", "c", "double", "0x401C000000000000");
    want_const(A_F32, B_F32, "    f32 mut c = 3;", "c", "float", "0x4008000000000000");
}

fn constants() void {
    a_float_constant_is_the_hex_form_of_its_pattern();
    an_f32_constant_is_a_binary64_the_type_holds_exactly();
    a_folded_expression_and_an_integer_take_the_float_form();
    println("constants ok");
}

// ---- the four operations ---------------------------------------------------------

// `+ - * /` on floats are fadd, fsub, fmul and fdiv, with no check of any kind. Nothing traps,
// so integer overflow intrinsics and division checks have no float form. No instruction carries
// a fast-math flag.
fn the_four_operations_are_the_f_instructions() void {
    probe3(A_F64, B_F64, "    f64 mut c = a + b;", "c", LOAD_A, LOAD_B,
           "  %t2 = fadd double %t0, %t1\n");
    probe3(A_F64, B_F64, "    f64 mut c = a - b;", "c", LOAD_A, LOAD_B,
           "  %t2 = fsub double %t0, %t1\n");
    probe3(A_F64, B_F64, "    f64 mut c = a * b;", "c", LOAD_A, LOAD_B,
           "  %t2 = fmul double %t0, %t1\n");
    probe3(A_F64, B_F64, "    f64 mut c = a / b;", "c", LOAD_A, LOAD_B,
           "  %t2 = fdiv double %t0, %t1\n");
}

// A division by zero emits the bare instruction: no comparison against zero and
// no failure block. This is because the result is an infinity or a NaN and never a trap,
// where an integer division checks in both modes.
fn a_float_division_has_no_zero_check() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    assert(open3(&e, A_F64, B_F64, "    f64 mut c = a / b;"));
    gen_env.emit_value(&e, "c");
    gen_env.expect_text(gen_env.body(&e),
                        gen_env.join3(&e, LOAD_A, LOAD_B, "  %t2 = fdiv double %t0, %t1\n"));
    gen_env.expect_text(gen_env.fail(&e), "");
}

// The same four in binary32, which differ only in the type text.
fn the_same_four_in_binary32() void {
    probe3(A_F32, B_F32, "    f32 mut c = a + b;", "c", LOAD_A32, LOAD_B32,
           "  %t2 = fadd float %t0, %t1\n");
    probe3(A_F32, B_F32, "    f32 mut c = a / b;", "c", LOAD_A32, LOAD_B32,
           "  %t2 = fdiv float %t0, %t1\n");
}

// Unary minus is `fneg` and not a subtraction from zero: the two differ on a
// zero and on the sign bit of a NaN.
fn unary_minus_is_fneg() void {
    probe2(A_F64, B_F64, "    f64 mut c = -a;", "c", LOAD_A, "  %t1 = fneg double %t0\n");
    probe2(A_F32, B_F32, "    f32 mut c = -a;", "c", LOAD_A32, "  %t1 = fneg float %t0\n");
}

fn arithmetic() void {
    the_four_operations_are_the_f_instructions();
    a_float_division_has_no_zero_check();
    the_same_four_in_binary32();
    unary_minus_is_fneg();
    println("arithmetic ok");
}

// ---- the comparisons -------------------------------------------------------------

// `==` is `oeq` and `!=` is `une`, which is the pair that makes NaN != NaN
// true and NaN == NaN false. `one` in place of `une` would answer false for
// both, and no program that compares two numbers could tell.
fn equality_is_oeq_and_inequality_is_une() void {
    probe3(A_F64, B_F64, "    bool mut c = a == b;", "c", LOAD_A, LOAD_B,
           "  %t2 = fcmp oeq double %t0, %t1\n");
    probe3(A_F64, B_F64, "    bool mut c = a != b;", "c", LOAD_A, LOAD_B,
           "  %t2 = fcmp une double %t0, %t1\n");
}

// The four orderings are the ordered predicates, so every comparison with a NaN
// is false whichever way it is written.
fn the_orderings_are_ordered_predicates() void {
    probe3(A_F64, B_F64, "    bool mut c = a < b;", "c", LOAD_A, LOAD_B,
           "  %t2 = fcmp olt double %t0, %t1\n");
    probe3(A_F64, B_F64, "    bool mut c = a <= b;", "c", LOAD_A, LOAD_B,
           "  %t2 = fcmp ole double %t0, %t1\n");
    probe3(A_F64, B_F64, "    bool mut c = a > b;", "c", LOAD_A, LOAD_B,
           "  %t2 = fcmp ogt double %t0, %t1\n");
    probe3(A_F64, B_F64, "    bool mut c = a >= b;", "c", LOAD_A, LOAD_B,
           "  %t2 = fcmp oge double %t0, %t1\n");
    probe3(A_F32, B_F32, "    bool mut c = a < b;", "c", LOAD_A32, LOAD_B32,
           "  %t2 = fcmp olt float %t0, %t1\n");
}

fn comparisons() void {
    equality_is_oeq_and_inequality_is_une();
    the_orderings_are_ordered_predicates();
    println("comparisons ok");
}

// ---- the conversions ----------------------------------------------------

// Between the two float types: `fptrunc` down and `fpext` up, and nothing at
// all for the identity.
fn the_float_types_convert_with_fptrunc_and_fpext() void {
    probe2(A_F64, B_F64, "    f32 mut c = cast(a, f32);", "c", LOAD_A,
           "  %t1 = fptrunc double %t0 to float\n");
    probe2(A_F32, B_F32, "    f64 mut c = cast(a, f64);", "c", LOAD_A32,
           "  %t1 = fpext float %t0 to double\n");
    probe1(A_F64, B_F64, "    f64 mut c = cast(a, f64);", "c", LOAD_A);
}

// An integer to a float widens by the source's signedness: `sitofp` for a
// signed source and `uitofp` for an unsigned one.
fn an_integer_converts_with_sitofp_or_uitofp() void {
    probe2("    i32 mut a = 3;", B_F64, "    f64 mut c = cast(a, f64);", "c",
           "  %t0 = load i32, ptr %a.0, align 4\n", "  %t1 = sitofp i32 %t0 to double\n");
    probe2("    u64 mut a = 3;", B_F64, "    f64 mut c = cast(a, f64);", "c",
           "  %t0 = load i64, ptr %a.0, align 8\n",
                        "  %t1 = uitofp i64 %t0 to double\n");
    probe2("    i16 mut a = 3;", B_F32, "    f32 mut c = cast(a, f32);", "c",
           "  %t0 = load i16, ptr %a.0, align 2\n",
                        "  %t1 = sitofp i16 %t0 to float\n");
}

// Float-to-integer conversion uses the
// saturating intrinsic, never plain `fptosi`. It
// truncates, saturates, maps NaN to 0, and does not trap.
fn a_float_to_an_integer_is_the_saturating_intrinsic() void {
    // Each slot follows the intrinsic family order at the target width, counting from
    // IN_FPCONV_FIRST. The order is fptosi from f32, fptosi from f64, fptoui from f32, and
    // fptoui from f64. Each family uses `i8 i16 i32 i64`.
    probe_conv(A_F64, B_F64, "    i32 mut c = cast(a, i32);", "c", LOAD_A,
               "  %t1 = call i32 @llvm.fptosi.sat.i32.f64(double %t0)\n",
               gen.IN_FPCONV_FIRST + gen.FP_SI_F64 * gen.FP_WIDTHS + 2);
    probe_conv(A_F64, B_F64, "    u8 mut c = cast(a, u8);", "c", LOAD_A,
               "  %t1 = call i8 @llvm.fptoui.sat.i8.f64(double %t0)\n",
               gen.IN_FPCONV_FIRST + gen.FP_UI_F64 * gen.FP_WIDTHS + 0);
    probe_conv(A_F32, B_F32, "    i64 mut c = cast(a, i64);", "c", LOAD_A32,
               "  %t1 = call i64 @llvm.fptosi.sat.i64.f32(float %t0)\n",
               gen.IN_FPCONV_FIRST + gen.FP_SI_F32 * gen.FP_WIDTHS + 3);
    probe_conv(A_F32, B_F32, "    u16 mut c = cast(a, u16);", "c", LOAD_A32,
               "  %t1 = call i16 @llvm.fptoui.sat.i16.f32(float %t0)\n",
               gen.IN_FPCONV_FIRST + gen.FP_UI_F32 * gen.FP_WIDTHS + 1);
}

fn casts() void {
    the_float_types_convert_with_fptrunc_and_fpext();
    an_integer_converts_with_sitofp_or_uitofp();
    a_float_to_an_integer_is_the_saturating_intrinsic();
    println("casts ok");
}

// ---- the print family ---------------------------------------------------

// A float goes to the printer of its own type and is never widened first: the
// digits printed depend on the type.
fn want_print(string one, string two, string three, string x1, string x2) void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    assert(open3(&e, one, two, three));
    gen_env.expect_text(gen_env.discard_at(&e, 2), gen_env.join2(&e, x1, x2));
}

fn a_float_prints_through_the_entry_point_of_its_type() void {
    want_print(A_F64, B_F64, "    print(a);", LOAD_A,
               "  call void @\"std.rt.print_f64\"(i32 1, double %t0)\n");
    want_print(A_F32, B_F32, "    print(a);", LOAD_A32,
               "  call void @\"std.rt.print_f32\"(i32 1, float %t0)\n");
}

// A float constant argument prints as the literal itself, with no slot and no
// load.
fn a_constant_argument_prints_as_a_literal() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    assert(open3(&e, A_F64, B_F64, "    print(0.5);"));
    string call = "  call void @\"std.rt.print_f64\"(i32 1, double 0x3FE0000000000000)\n";
    gen_env.expect_text(gen_env.discard_at(&e, 2), call);
}

fn printing() void {
    a_float_prints_through_the_entry_point_of_its_type();
    a_constant_argument_prints_as_a_literal();
    println("printing ok");
}

// ---- a float in a signature -----------------------------------------------

// A float parameter and result carry no extension attribute. The emitter
// gives `zeroext` and `signext` to the narrow integers alone, and a float is
// already the width its type says.
fn a_float_signature_carries_no_extension_attribute() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    string[5] src = {"fn narrow(f64 a, f32 b, i8 c) f32 {\n", "    return b;\n", "}\n",
                     "fn main() i32 {\n", "    return 0;\n}\n"};
    assert(gen_env.open_module(&e, gen_env.join_lines(&e, src[..])));
    string[11] mut want = {
        DEFINE_NARROW,
        "entry:\n",
        "  %a.0 = alloca double, align 8\n",
        "  %b.1 = alloca float, align 4\n",
        "  %c.2 = alloca i8, align 1\n",
        "  store double %a.in, ptr %a.0, align 8\n",
        "  store float %b.in, ptr %b.1, align 4\n",
        "  store i8 %c.in, ptr %c.2, align 1\n",
        "  %t0 = load float, ptr %b.1, align 4\n",
        "  ret float %t0\n",
        "}\n",
    };
    string got = gen_env.emit_function(&e, "narrow");
    gen_env.expect_text(got, gen_env.join_lines(&e, want[0..11]));
    gen_env.expect_blocks(&e, got);
}

// ---- the module ------------------------------------------------------------------

// A float global is a `double` or a `float` with the alignment of its type, and
// its initializer is the constant's own form.
fn a_float_global_holds_its_constant() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    string[4] src = {"f64 SCALE = 3.5;\n", "f32 mut STEP = 0.5;\n", "fn main() i32 {\n",
                     "    return 0;\n}\n"};
    assert(gen_env.open_module(&e, gen_env.join_lines(&e, src[..])));
    assert(gen_stmt.gen_program(&e.g, &e.c.ck, &e.c.m.set));
    gen_env.expect_blocks(&e, gen_env.module_text(&e));
    string scale = "@\"main.SCALE\" = dso_local constant double 0x400C000000000000, align 8\n";
    string step = "@\"main.STEP\" = dso_local global float 0x3FE0000000000000, align 4\n";
    gen_env.expect_text(gen_env.globals(&e), gen_env.join2(&e, scale, step));
}

// An aggregate of floats is written out element by element, and only an aggregate of positive
// zeros is a `zeroinitializer`. -0.0 has its sign bit set, so a zeroinitializer would lose it.
fn a_float_aggregate_is_zeroinitializer_only_for_positive_zeros() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    string[5] src = {"f64[2] STEPS = {0.5, 1.0};\n", "f64[2] ZEROS = {0.0, 0.0};\n",
                     "f64[2] SIGNS = {0.0, -0.0};\n", "fn main() i32 {\n",
                     "    return 0;\n}\n"};
    assert(gen_env.open_module(&e, gen_env.join_lines(&e, src[..])));
    assert(gen_stmt.gen_program(&e.g, &e.c.ck, &e.c.m.set));
    string[3] mut want = {
        "@\"main.STEPS\" = dso_local constant [2 x double] [double 0x3FE0000000000000, ",
        "double 0x3FF0000000000000], align 8\n",
        "@\"main.ZEROS\" = dso_local constant [2 x double] zeroinitializer, align 8\n",
    };
    string[2] mut signs = {
        "@\"main.SIGNS\" = dso_local constant [2 x double] [double 0x0000000000000000, ",
        "double 0x8000000000000000], align 8\n",
    };
    string head = gen_env.join_lines(&e, want[0..3]);
    string text = gen_env.globals(&e);
    assert(str.find(text, head) == 0);
    assert(str.find(text, gen_env.join_lines(&e, signs[0..2])) > 0);
}

// The saturating intrinsics are declared with the spellings LLVM 18 prints,
// after the overflow family and before llvm.trap.
fn the_conversion_intrinsics_are_declared_in_the_order_of_item_8() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    string[5] src = {"fn main() i32 {\n", "    f64 mut a = 3.5;\n",
                     "    i32 mut b = cast(a, i32);\n", "    u8 mut c = cast(a, u8);\n",
                     "    return 0;\n}\n"};
    assert(gen_env.open_module(&e, gen_env.join_lines(&e, src[..])));
    assert(gen_stmt.gen_program(&e.g, &e.c.ck, &e.c.m.set));
    gen_env.expect_blocks(&e, gen_env.module_text(&e));
    string text = gen_env.module_text(&e);
    assert(str.find(text, "declare i8 @llvm.fptoui.sat.i8.f64(double) #4\n") >= 0);
    assert(str.find(text, "declare i32 @llvm.fptosi.sat.i32.f64(double) #4\n") >= 0);
    // fptosi comes before fptoui.
    assert(str.find(text, "declare i32 @llvm.fptosi.sat.i32.f64(double) #4\n")
           < str.find(text, "declare i8 @llvm.fptoui.sat.i8.f64(double) #4\n"));
    assert(str.find(text, "attributes #4 = { nocallback") >= 0);
}

// No float instruction carries a fast-math flag, since floats are IEEE 754 and
// the optimizer may not reassociate them. The module below holds
// every float instruction the emitter writes, and none of the eight flag names
// appears anywhere in it.
fn no_float_instruction_carries_a_fast_math_flag() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    string[13] src = {"fn main() i32 {\n", "    f64 mut a = 3.5;\n", "    f64 mut b = 0.5;\n",
                      "    f64 mut c = a + b - a * b / a;\n", "    f64 mut d = -c;\n",
                      "    f32 mut g = cast(d, f32);\n", "    f64 mut h = cast(g, f64);\n",
                      "    i64 mut k = cast(h, i64);\n", "    f64 mut m = cast(k, f64);\n",
                      "    bool mut p = a < b;\n", "    bool mut q = a == b;\n",
                      "    println(a, g, m, p, q);\n", "    return 0;\n}\n"};
    assert(gen_env.open_module(&e, gen_env.join_lines(&e, src[..])));
    assert(gen_stmt.gen_program(&e.g, &e.c.ck, &e.c.m.set));
    gen_env.expect_blocks(&e, gen_env.module_text(&e));
    string text = gen_env.module_text(&e);
    // The module really does hold the instructions the flags would sit on.
    assert(str.find(text, "fadd double") >= 0);
    assert(str.find(text, "fsub double") >= 0);
    assert(str.find(text, "fmul double") >= 0);
    assert(str.find(text, "fdiv double") >= 0);
    assert(str.find(text, "fneg double") >= 0);
    assert(str.find(text, "fcmp olt double") >= 0);
    assert(str.find(text, "fptrunc double") >= 0);
    assert(str.find(text, "fpext float") >= 0);
    assert(str.find(text, "sitofp i64") >= 0);
    assert(str.find(text, "llvm.fptosi.sat.i64.f64") >= 0);
    u64 mut i = 0;
    while (i < FAST_MATH.len) {
        if (str.find(text, FAST_MATH[i]) >= 0) {
            println("the module holds the fast-math flag ", FAST_MATH[i]);
        }
        assert(str.find(text, FAST_MATH[i]) < 0);
        i += 1;
    }
}

fn signatures() void {
    a_float_signature_carries_no_extension_attribute();
    println("signatures ok");
}

fn module() void {
    a_float_global_holds_its_constant();
    a_float_aggregate_is_zeroinitializer_only_for_positive_zeros();
    the_conversion_intrinsics_are_declared_in_the_order_of_item_8();
    no_float_instruction_carries_a_fast_math_flag();
    println("module ok");
}

fn main() i32 {
    constants();
    arithmetic();
    comparisons();
    casts();
    printing();
    signatures();
    module();
    println("ok");
    return 0;
}
