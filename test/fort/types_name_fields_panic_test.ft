//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: types.name_fields: the names do not match the fields
//! stdout:
//| first second
/// types.name_fields takes one name for each field of a resolved struct, in declaration order.
/// A list of another length matches no field order.
import fort.types;
import types_env;

fn main() i32 {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node* u64t = types_env.type_of(&e, "u64");
    types.node* pair = types.type_struct(&e.tt, "pair", 1);
    types.node*[2] fields = {u64t, u64t};
    u64[2] mut offsets = {};
    assert(types.type_layout_begin(pair));
    assert(types.type_layout_struct(pair, fields[..], offsets[..]));
    string[2] names = {"first", "second"};
    types.name_fields(pair, names[..]);
    println(types.field_at(pair, 0).name, " ", types.field_at(pair, 1).name);
    types.name_fields(pair, names[0..1]);
    return 0;
}
