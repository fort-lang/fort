//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: consts: constant folding on a non-integer
//! stdout:
//| 0
import consts;

/// cv_cmp orders two integers or two chars. The checker never compares one
/// value of each type. It first converts a char in an integer context to its
/// code point. This call breaks that precondition.
fn main() i32 {
    println(consts.cv_cmp(consts.cv_from_i64(97), consts.cv_from_i64(97)));
    println(consts.cv_cmp(consts.cv_from_i64(97), consts.cv_from_char(97)));
    return 0;
}
