//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: consts: constant folding on a non-integer
//! stdout:
//| 0
import consts;

// cv_cmp orders two integers or two chars; one of each is a comparison the
// checker never asks for, since a char in an integer context has been turned
// into its code point first (D4.3), so it is a broken precondition (D13.3).
fn i32 main() {
    println(consts.cv_cmp(consts.cv_from_i64(97), consts.cv_from_i64(97)));
    println(consts.cv_cmp(consts.cv_from_i64(97), consts.cv_from_char(97)));
    return 0;
}
