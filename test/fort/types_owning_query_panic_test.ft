//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: types.type_is_owning_aggregate: owning query on a struct without layout
//! stdout:
//| true
/// Whether a struct owns an allocation is read off its layout, so the question cannot be
/// asked before the struct is laid out.
import types;
import types_env;

fn main() i32 {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    println(types.type_is_owning_aggregate(e.vec));
    println(types.type_is_owning_aggregate(e.rec));
    return 0;
}
