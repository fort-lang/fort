//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| casts ok
//| slices ok
//| ledger ok
/// Checks the witness walk that another analysis runs with a ledger of its own: a parameter
/// keeps its entry value through a cast to a type that holds each of its values, the walk reads
/// the length of `slice_ptr`, each searched block and statement charges the given ledger, and
/// the walk gives back the table of address-taken locals that it borrows.
import fir;
import ownership_api;
import ownership_limits;
import ownership_source;
import ownership_source_env;
import ownership_source_local;
import std.strbuf;

string[48] WALK = {
    "extern fn marker() void;",
    "fn same_width(u64 n) void {",
    "    u64 m = cast(n, u64);",
    "    if (m == 3) { marker(); }",
    "}",
    "fn wider(u32 n) void {",
    "    u64 m = cast(n, u64);",
    "    if (m == 70000) { marker(); }",
    "}",
    "fn signed_wider(i8 n) void {",
    "    i64 m = cast(n, i64);",
    "    if (m == -3) { marker(); }",
    "}",
    "fn unsigned_into_signed(u32 n) void {",
    "    i64 m = cast(n, i64);",
    "    if (m == 5) { marker(); }",
    "}",
    "fn narrower(u64 n) void {",
    "    u8 m = cast(n, u8);",
    "    if (m == 3) { marker(); }",
    "}",
    "fn signed_into_unsigned(i32 n) void {",
    "    u64 m = cast(n, u64);",
    "    if (m == 3) { marker(); }",
    "}",
    "fn same_size_into_signed(u64 n) void {",
    "    i64 m = cast(n, i64);",
    "    if (m == 3) { marker(); }",
    "}",
    "fn raw_range_length() void {",
    "    u8[4] mut bytes = {1, 2, 3, 4};",
    "    u8* p = cast(&bytes, u8*);",
    "    u8@ s = p[1..3];",
    "    if (s.len == 2) { marker(); }",
    "}",
    "fn wrong_length() void {",
    "    u8[4] mut bytes = {1, 2, 3, 4};",
    "    u8* p = cast(&bytes, u8*);",
    "    u8@ s = p[1..3];",
    "    if (s.len == 3) { marker(); }",
    "}",
    "fn reversed_range() void {",
    "    u8[4] mut bytes = {1, 2, 3, 4};",
    "    u8* p = cast(&bytes, u8*);",
    "    u8@ s = p[3..1];",
    "    if (s.len == 0) { marker(); }",
    "}",
    "fn root() i32 { return 0; }",
};

// Whether the walk reaches the call of `marker` in body `name`, with a fresh production ledger.
fn reaches(ownership_source_env.env mut* e, string name) bool {
    ownership_source.body* row = ownership_source_env.find(e, "main", name);
    fir.func* f = &row->function;
    ownership_api.limit_table limits = ownership_limits.computation(ownership_limits.fir_size(f));
    ownership_limits.meter mut ledger = ownership_limits.meter{};
    assert(ownership_limits.configure(&ledger, &limits));
    ownership_api.proof_status mut refusal = ownership_api.proof_status{};
    fir.pred_table mut preds = fir.func_predecessors(f);
    defer fir.pred_table_free(&preds);
    bool mut@ own mut taken = new(bool, cast(fir.local_count(f), u64));
    defer del(taken);
    ownership_source_local.mark_taken(f, taken);
    u32 mut b = 0;
    while (b < fir.block_count(f)) {
        u32 mut g = 0;
        while (g < fir.block_statement_count(f, b)) {
            fir.statement* s = fir.block_statement(f, b, g);
            if (s->kind == fir.stmt_kind.st_assign &&
                s->value.kind == fir.rvalue_kind.rv_call &&
                s->value.callee == fir.callee_kind.cl_extern) {
                bool found = ownership_source_local.witness_in(f, row->key, row->source,
                    &taken, &ledger, &refusal, &preds, b, g);
                assert(!refusal.terminal.present && ledger.used.w > 0);
                // The walk gives the table back.
                assert(taken.len == cast(fir.local_count(f), u64));
                return found;
            }
            g += 1;
        }
        b += 1;
    }
    panic("ownership_source_local_witness_in_test: no marker");
}

fn open(ownership_source_env.env mut* e) void {
    ownership_source_env.open(e);
    ownership_source_env.runtime(e);
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    u64 mut i = 0;
    while (i < WALK.len) {
        strbuf.append(&text, WALK[i]);
        strbuf.push(&text, '\n');
        i += 1;
    }
    assert(ownership_source_env.prepare(e, strbuf.view(&text)));
    ownership_source.analyze(&e->source);
}

// A cast keeps the entry value when the target type holds each value of the parameter type:
// the same type, a wider type of the same sign, or a signed type wider than an unsigned one.
fn casts() void {
    ownership_source_env.env mut e = ownership_source_env.env{};
    open(&e);
    defer ownership_source_env.close(&e);
    assert(reaches(&e, "same_width"));
    assert(reaches(&e, "wider"));
    assert(reaches(&e, "signed_wider"));
    assert(reaches(&e, "unsigned_into_signed"));
    assert(!reaches(&e, "narrower"));
    assert(!reaches(&e, "signed_into_unsigned"));
    assert(!reaches(&e, "same_size_into_signed"));
    println("casts ok");
}

// `slice_ptr(a, lo, hi)` has the length hi - lo, as a checked slice has. A negative length
// stays unknown.
fn slices() void {
    ownership_source_env.env mut e = ownership_source_env.env{};
    open(&e);
    defer ownership_source_env.close(&e);
    assert(reaches(&e, "raw_range_length"));
    assert(!reaches(&e, "wrong_length"));
    assert(!reaches(&e, "reversed_range"));
    println("slices ok");
}

// The walk charges the ledger it gets. A refusal there ends the walk and stays in `refusal`.
fn ledger() void {
    ownership_source_env.env mut e = ownership_source_env.env{};
    open(&e);
    defer ownership_source_env.close(&e);
    ownership_source.body* row = ownership_source_env.find(&e, "main", "raw_range_length");
    fir.func* f = &row->function;
    ownership_api.limit_table mut limits = ownership_limits.computation(
        ownership_limits.fir_size(f));
    limits.w = 2;
    ownership_limits.meter mut small = ownership_limits.meter{};
    assert(ownership_limits.configure(&small, &limits));
    ownership_api.proof_status mut refusal = ownership_api.proof_status{};
    fir.pred_table mut preds = fir.func_predecessors(f);
    defer fir.pred_table_free(&preds);
    bool mut@ own mut taken = new(bool, cast(fir.local_count(f), u64));
    defer del(taken);
    ownership_source_local.mark_taken(f, taken);
    u32 last = fir.block_count(f) - 1;
    assert(!ownership_source_local.witness_in(f, row->key, row->source, &taken, &small,
        &refusal, &preds, last, fir.block_statement_count(f, last)));
    assert(taken.len == cast(fir.local_count(f), u64));
    assert(refusal.terminal.present && refusal.terminal.limit.present);
    assert(refusal.terminal.limit.category == ownership_api.limit_category.w);
    assert(small.used.w == 2);
    println("ledger ok");
}

fn main() i32 {
    casts();
    slices();
    ledger();
    return 0;
}
