//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: runtime_sig.rt_signature_of_type: too many parameters
//! stdout:
//| 7
/// A runtime signature holds at most RT_MAX_PARAMS parameters. A function type with one more
/// parameter does not fit, so the call panics.
import fort.runtime_sig;
import fort.types;
import types_env;

// The steps of the test, which end in the panic. They read `e` through a pointer, so the use
// rule of `move` and `del` (D17.21) asks no proof of their reads after a call.
fn trigger(types_env.env mut* e) void {
    types.node* i = types_env.type_of(e, "i32");
    types.node*[7] params = {i, i, i, i, i, i, i};
    types.node* sig = types.type_fn(&e->tt, types_env.type_of(e, "void"), params[..], false);
    println(sig->params.len);
    runtime_sig.rt_signature_of_type("std.rt.x", sig);
}

fn main() i32 {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    trigger(&e);
    return 0;
}
