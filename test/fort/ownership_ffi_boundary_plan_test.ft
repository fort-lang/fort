//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| accept A01
//| accept A02
//| accept A03
//| reject A04
//| reject A05
//| reject A06
//| reject A07
//| reject A08
//| reject A09
//| reject A10
//| reject A11
//| reject A12
//| reject A13
//| reject A14
//| accept A15
//| accept A16
//| reject A17
//| reject A18
//| reject A19
//| reject A20
//| reject A21
//| reject A22
//| reject A23
//| accept A24
//| reject A25
//| reject A26
//| reject A27
//| accept A28
//| accept A29
//| reject A30
//| reject A31
//| reject A32
//| reject missing caller state
//| reject incomplete caller state
//| reject released argument allocation
//| reject unknown argument allocation
/// Tests checked private preparation without a foreign hook or public publication.
import ownership_api;
import ownership_ffi;
import ownership_ffi_boundary_env as env;
import ownership_keys;
import ownership_state;
import check_env;
import ast;
import types;
import std.str;

ownership_api.projection@ NO_PROJECTIONS = {};

fn scalar(env.env mut* e, u64 at) void {
    ownership_api.contents_fact mut value = {};
    value.place = env.slot(10);
    value.value_version = env.id(ownership_api.entity_kind.value, 111);
    value.kind = ownership_api.contents_kind.scalar;
    e->raw.local.state.contents[0] = value;
    e->raw.local.state.contents_len = 1;
    env.operand(e, at, 0, e->request.call.declaration.ty->params[0]);
}
fn tail(env.env mut* e, bool span) void {
    types.node* pointer = check_env.sym_main(&e->checked, "borrow")->ty->params[0];
    env.binding(e, env.slot(1).root, pointer);
    env.allocation(e, env.slot(1), pointer->elem, 1);
    types.node* mut ty = pointer;
    if (span) { ty = types.type_span(&e->raw.table, pointer->elem, false, false); }
    env.operand(e, 1, 1, ty);
}
fn empty_owner(env.env mut* e) void {
    types.node* parameter = e->request.call.declaration.ty->params[0];
    env.binding(e, env.slot(1).root, parameter);
    ownership_api.contents_fact mut value = {};
    value.place = env.slot(1);
    value.value_version = env.id(ownership_api.entity_kind.value, 11);
    value.kind = ownership_api.contents_kind.empty_owner;
    value.owner_empty = true;
    value.span_length = env.exact(0);
    e->raw.local.state.contents[0] = value;
    e->raw.local.state.contents_len = 1;
    env.operand(e, 0, 0, parameter);
}
fn orphan(env.env mut* e) void {
    ownership_state.state mut* s = &e->raw.local.state;
    ownership_api.place_path actual = env.field(e, s->allocations[1].key, 0);
    s->allocations[0].owner.place = actual;
    s->contents[0] = env.reference(e, actual, 1, 11);
    env.operand(e, 0, 0, e->request.call.declaration.ty->params[0]);
    // Both allocations retain obligations. No caller slot owns the cycle.
    s->edges[1] = s->edges[0];
    s->edges[1].key.ordinal += 1;
    s->edges[1].from = s->nodes[1].key;
    s->edges[1].to = s->nodes[0].key;
    s->edges[1].place = actual;
    s->edges_len = 2;
}
fn borrowed_cycle(env.env mut* e) void {
    types.node* parameter = e->request.call.declaration.ty->params[0];
    types.node* payload = parameter->elem;
    ast.sym* record = cast(payload->decl, ast.sym*);
    types.node* leaf = ast.ast_child(record->node, 0)->ty;
    env.binding(e, env.slot(1).root, parameter);
    env.binding(e, env.slot(2).root, parameter);
    env.allocation(e, env.slot(1), payload, 1);
    env.allocation(e, env.slot(2), payload, 2);
    env.node(e, 0, 301); env.node(e, 1, 302);
    ownership_api.place_path p = env.field(e, e->raw.local.state.allocations[0].key, 0);
    ownership_api.place_path q = env.field(e, e->raw.local.state.allocations[1].key, 0);
    e->raw.local.state.contents[2] = env.reference(e, p, 2, 31);
    e->raw.local.state.contents[3] = env.reference(e, q, 1, 41);
    e->raw.local.state.contents_len = 4;
    env.edge(e, 0, 1, p, payload, leaf, 0, false);
    env.edge(e, 1, 0, q, payload, leaf, 0, false);
    env.operand(e, 0, 0, parameter);
}

fn a01() void {
    env.env mut e = {};
    env.open(&e, 1, "empty");
    defer env.close(&e);
    env.finish(&e);
    ownership_ffi.preparation mut out = ownership_ffi.prepare_boundary(
        &e.raw.local.service, &e.request);
    env.unchanged(&e);
    assert(ownership_api.successful(out.proof) && out.selected != null);
    assert(e.events_seen == 0 && out.selected->selected_len == 0);
    ownership_ffi.drop_boundary_plan(move(out.selected));
}

