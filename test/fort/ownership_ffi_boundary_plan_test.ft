    assert(out.selected == null && e.events_seen == 1);
    assert(out.proof.kind == ownership_api.proof_kind.incomplete);
    assert(e.observed.kind == ownership_api.event_kind.incomplete_proof);
    assert(e.observed.evidence == ownership_api.evidence_kind.abstract_possibility);
    assert(str.equal(e.observed.text,
        "The supplied tail type violates the checked extern ABI precondition."));
    assert(e.validated == false);
    ownership_ffi.drop_boundary_plan(move(out.selected));
}

