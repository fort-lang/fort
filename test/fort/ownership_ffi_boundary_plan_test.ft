fn a04() void {
    env.env mut e = {};
    env.open(&e, 4, "borrow");
    defer env.close(&e);
    env.basic(&e, false);
    e.request.event_map_complete = false;
    env.finish(&e);
    ownership_ffi.preparation mut out = ownership_ffi.prepare_boundary(
        &e.raw.local.service, &e.request);
    env.unchanged(&e);
    assert(!ownership_api.successful(out.proof) && out.proof.failed);
    assert(out.selected == null && e.events_seen == 1);
    assert(out.proof.kind == ownership_api.proof_kind.incomplete);
    assert(e.observed.kind == ownership_api.event_kind.incomplete_proof);
    assert(e.observed.evidence == ownership_api.evidence_kind.abstract_possibility);
    assert(str.equal(e.observed.text, "The event map is missing."));
    assert(e.validated == false);
    ownership_ffi.drop_boundary_plan(move(out.selected));
}

