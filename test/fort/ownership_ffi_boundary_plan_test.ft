fn a31() void {
    env.env mut e = {};
    env.open(&e, 31, "borrow");
    defer env.close(&e);
    env.basic(&e, false);
    env.finish(&e);
    ownership_ffi.preparation_context mut c = {};
    c.copy.services = &e.raw.local.service;
    c.copy.proof.kind = ownership_api.proof_kind.complete;
    c.request = &e.request;
    c.metadata.operation = e.request.call.operation;
    c.metadata.source = e.request.call.source;
    c.metadata.event = e.events[0].key;
    c.copy.request = &c.metadata;
    assert(!ownership_ffi.preparation_price(&c, ownership_api.U64_MAX, 2));
    assert(e.raw.budget.calls == 0);
    ownership_ffi.preparation_report(&c);
    ownership_ffi.preparation mut out = {.proof = c.copy.proof};
    env.unchanged(&e);
    assert(!ownership_api.successful(out.proof) && out.proof.failed);
    assert(out.selected == null && e.events_seen == 1);
    assert(out.proof.kind == ownership_api.proof_kind.incomplete);
    assert(e.observed.kind == ownership_api.event_kind.work_failure);
    assert(e.observed.evidence == ownership_api.evidence_kind.abstract_possibility);
    assert(str.equal(e.observed.text, "The work price is not representable."));
    assert(e.validated == false);
    ownership_ffi.drop_boundary_plan(move(out.selected));
}

fn a32() void {
    env.env mut e = {};
    env.open(&e, 32, "borrow");
    defer env.close(&e);
    env.basic(&e, false);
    env.finish(&e);
    env.reset(&e, 1);
    e.refuse_event = true;
    ownership_ffi.preparation mut out = ownership_ffi.prepare_boundary(
        &e.raw.local.service, &e.request);
    env.unchanged(&e);
    assert(!ownership_api.successful(out.proof) && out.proof.failed);
    assert(out.selected == null && e.events_seen == 1);
    assert(out.proof.kind == ownership_api.proof_kind.incomplete);
    assert(e.observed.kind == ownership_api.event_kind.work_failure);
    assert(e.observed.evidence == ownership_api.evidence_kind.abstract_possibility);
    assert(str.equal(e.observed.text, "The work or representation budget refuses the operation."));
    assert(e.validated == false);
    assert(out.proof.terminal.present && out.proof.terminal.limit.present);
    assert(out.proof.terminal.limit.used == 7 && out.proof.terminal.limit.bound == 7);
    assert(out.proof.terminal.limit.attempted == 1);
    assert(ownership_keys.operation(out.proof.terminal.operation,
        e.request.call.operation) == 0);
    assert(ownership_keys.source(out.proof.terminal.source, e.request.call.source) == 0);
    assert(ownership_keys.entity(e.observed.key, e.events[0].key) == 0);
    ownership_ffi.drop_boundary_plan(move(out.selected));
}

// The refusal names the missing caller state, not the declaration.
fn caller_state(u32 number, bool missing) void {
    env.env mut e = {};
    env.open(&e, number, "borrow");
    defer env.close(&e);
    env.basic(&e, false);
    env.finish(&e);
    if (missing) { e.request.before = null; }
    else { e.raw.local.state.proof.kind = ownership_api.proof_kind.incomplete; }
    ownership_ffi.preparation mut out = ownership_ffi.prepare_boundary(
        &e.raw.local.service, &e.request);
    assert(!ownership_api.successful(out.proof) && out.proof.failed);
    assert(out.selected == null && e.events_seen == 1);
    assert(out.proof.kind == ownership_api.proof_kind.incomplete);
    assert(e.observed.kind == ownership_api.event_kind.incomplete_proof);
    assert(str.equal(e.observed.text, "The caller state is missing or incomplete."));
    e.raw.local.state.proof.kind = ownership_api.proof_kind.complete;
    e.request.before = &e.raw.local.state;
    env.unchanged(&e);
}
// A live source does not hide a released or unknown known allocation.
fn argument_allocation(u32 number, ownership_api.validity_kind validity) void {
    env.env mut e = {};
    env.open(&e, number, "borrow");
    defer env.close(&e);
    env.basic(&e, false);
    e.raw.local.state.allocations[0].validity = validity;
    env.finish(&e);
    ownership_ffi.preparation mut out = ownership_ffi.prepare_boundary(
        &e.raw.local.service, &e.request);
    env.unchanged(&e);
    assert(!ownership_api.successful(out.proof) && out.proof.failed);
    assert(out.selected == null && e.events_seen == 1);
    assert(e.raw.local.state.sources[0].validity == ownership_api.validity_kind.live);
    if (validity == ownership_api.validity_kind.released) {
        assert(out.proof.kind == ownership_api.proof_kind.complete);
        assert(e.observed.kind == ownership_api.event_kind.invalid_use && e.validated);
        assert(str.equal(e.observed.text, "The argument source is released."));
    } else {
        assert(out.proof.kind == ownership_api.proof_kind.incomplete);
        assert(e.observed.kind == ownership_api.event_kind.incomplete_proof && !e.validated);
        assert(str.equal(e.observed.text, "The captured argument version does not match."));
    }
}
fn main() i32 {
    a01(); println("accept A01");
    a02(); println("accept A02");
    a03(); println("accept A03");
    a04(); println("reject A04");
    a05(); println("reject A05");
    a06(); println("reject A06");
    a07(); println("reject A07");
    a08(); println("reject A08");
    a09(); println("reject A09");
    a10(); println("reject A10");
    a11(); println("reject A11");
    a12(); println("reject A12");
    a13(); println("reject A13");
    a14(); println("reject A14");
    a15(); println("accept A15");
    a16(); println("accept A16");
    a17(); println("reject A17");
    a18(); println("reject A18");
    a19(); println("reject A19");
    a20(); println("reject A20");
    a21(); println("reject A21");
    a22(); println("reject A22");
    a23(); println("reject A23");
    a24(); println("accept A24");
    a25(); println("reject A25");
    a26(); println("reject A26");
    a27(); println("reject A27");
    a28(); println("accept A28");
    a29(); println("accept A29");
    a30(); println("reject A30");
    a31(); println("reject A31");
    a32(); println("reject A32");
    caller_state(40, true); println("reject missing caller state");
    caller_state(41, false); println("reject incomplete caller state");
    argument_allocation(42, ownership_api.validity_kind.released);
    println("reject released argument allocation");
    argument_allocation(43, ownership_api.validity_kind.unknown);
    println("reject unknown argument allocation");
    return 0;
}
