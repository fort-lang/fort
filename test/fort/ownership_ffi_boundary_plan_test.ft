fn a15() void {
    env.env mut e = {};
    env.open(&e, 15, "take_node");
    defer env.close(&e);
    env.graph(&e, false);
    env.finish(&e);
    ownership_ffi.preparation mut out = ownership_ffi.prepare_boundary(
        &e.raw.local.service, &e.request);
    env.unchanged(&e);
    assert(ownership_api.successful(out.proof) && out.selected != null);
    assert(e.events_seen == 0 && out.selected->selected_len == 2);
    assert(out.selected->selected[1].allocation.ordinal == 2);
    assert(&out.selected->selected[1].owner.projections[0] !=
        &e.raw.local.state.allocations[1].owner.place.projections[0]);
    assert(&out.selected->selected[1].incoming.range.leaves[0] !=
        &e.raw.local.state.edges[0].range.leaves[0]);
    ownership_ffi.drop_boundary_plan(move(out.selected));
}

