//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| ok
import parse_env;
import std.strbuf;

// The recovery toolchain.md 4 describes, in the shapes the repository's own
// sources do not hold, which is what tools/diff_ast.sh can therefore not
// compare: where a skip stops, what it drops afterwards, what the tree keeps,
// and the nesting limit.
// D14.2, D2.11
//
// Every assertion is a whole module's S-expression, so it says both what
// survived the error and where the region the parser skipped stands.

// ---- where a skip stops (toolchain.md 4) ---------------------------------------

fn void a_skip_stops_before_the_next_statement_keyword() {
    parse_env.env mut e = parse_env.create();
    defer parse_env.free(&e);
    // A statement keyword starts the next statement, so the skip leaves it
    // where the block reads it and the statements after the broken one are
    // parsed.
    string src = "fn void f() {\n    x = ;\n    return;\n}\n";
    assert(parse_env.parse_dump(&e, src)
           == "(module (fn (type (void)) f (params) (block (error) (return nil))))");
    assert(parse_env.errors(&e) == 1);
}

fn void a_skip_stops_before_the_next_case_keyword() {
    parse_env.env mut e = parse_env.create();
    defer parse_env.free(&e);
    // Neither `case` nor `default` appears in a statement or an expression,
    // so a skip inside a switch stops before one rather than swallowing the
    // clause that follows the broken one.
    // D7.6
    string src = parse_env.join2(&e, "fn void f() {\n    switch (c) {\n    case 1:\n",
                                 "        x = ;\n    default:\n        g();\n    }\n}\n");
    string dumped = parse_env.parse_dump(&e, src);
    string expected = parse_env.join3(&e, "(module (fn (type (void)) f (params) (block (switch",
                                      " (ident c) (case (labels (int 1)) (block (error)))",
                                      " (case default (block (call-stmt (call (ident g)))))))))");
    assert(dumped == expected);
    assert(parse_env.errors(&e) == 1);
}

fn void a_skip_stops_before_a_top_level_declaration() {
    parse_env.env mut e = parse_env.create();
    defer parse_env.free(&e);
    // A body ends where a top-level declaration starts, so a file whose
    // braces are unbalanced costs one diagnostic and the declarations after
    // it are read.
    // D14.2
    string src = parse_env.join2(&e, "fn void f() {\n    x = ;\n",
                                 "struct s {\n    i32 x;\n}\n");
    string dumped = parse_env.parse_dump(&e, src);
    string expected = parse_env.join2(&e, "(module (fn (type (void)) f (params) (block (error)))",
                                      " (struct s (field-decl (type (prim i32)) x)))");
    assert(dumped == expected);
}

fn void a_skip_runs_over_a_semicolon_inside_a_bracket() {
    parse_env.env mut e = parse_env.create();
    defer parse_env.free(&e);
    // The `;` of a `for` header and the `,` of an argument list stand inside
    // the brackets the failed construct left open, so they are not statement
    // boundaries (toolchain.md 4): the whole header goes with the skipped
    // region and the statement after it is read.
    string src = "fn void f() {\n    for (i32 mut i = ; i < 2; i++) { }\n    g();\n}\n";
    string dumped = parse_env.parse_dump(&e, src);
    string expected = parse_env.join2(&e, "(module (fn (type (void)) f (params) (block (error)",
                                      " (call-stmt (call (ident g))))))");
    assert(dumped == expected);
    assert(parse_env.errors(&e) == 1);
}

fn void a_run_of_semicolons_is_one_boundary() {
    parse_env.env mut e = parse_env.create();
    defer parse_env.free(&e);
    // The empty statement that follows a skipped region is part of it and not
    // an error of its own, so this file reports once.
    // D7.3, D14.2
    //
    // What this cannot separate: the run is consumed by skip_to_boundary and
    // again by drop_leftovers directly afterwards, so deleting either loop
    // leaves the tree and the diagnostics unchanged and only the error node's
    // range -- which no dump prints -- moves. The assertion below is
    // therefore about the pair and not about the loop inside
    // skip_to_boundary; the same blind spot is why tools/diff_ast.sh misses
    // that mutation.
    // T-033: the review that found the blind spot
    string src = "fn void f() {\n    x = ;;;\n    g();\n}\n";
    string dumped = parse_env.parse_dump(&e, src);
    string expected = parse_env.join2(&e, "(module (fn (type (void)) f (params) (block (error)",
                                      " (call-stmt (call (ident g))))))");
    assert(dumped == expected);
    assert(parse_env.errors(&e) == 1);
}

fn void a_leftover_bracket_is_dropped_rather_than_reported_again() {
    parse_env.env mut e = parse_env.create();
    defer parse_env.free(&e);
    // Directly after a skip, a `)` or a `]` that closes nothing is the tail
    // of the construct that failed, so reading it as the next construct would
    // cost a second diagnostic for one mistake. Here the two `)` and the
    // statement behind them are all part of the region the skip took, which
    // costs the file the call that followed and saves it a second diagnostic.
    // D14.2
    string src = "fn void f() {\n    g(h(;))\n    k();\n}\n";
    assert(parse_env.parse_dump(&e, src)
           == "(module (fn (type (void)) f (params) (block (error))))");
    assert(parse_env.errors(&e) == 1);
}

// ---- what the tree keeps -------------------------------------------------------

fn void every_recovery_point_keeps_an_error_node() {
    parse_env.env mut e = parse_env.create();
    defer parse_env.free(&e);
    // The four recovery points of toolchain.md 4, one file each: the
    // declarations of a module, the statements of a block, the clauses of a
    // switch and the fields of a struct.
    assert(parse_env.parse_dump(&e, "i32 a = ;\ni32 b = 1;\n")
           == "(module (error) (var b (type (prim i32)) (int 1)))");
    string in_block = parse_env.parse_dump(&e, "fn void f() {\n    x = ;\n    g();\n}\n");
    assert(in_block == parse_env.join2(&e, "(module (fn (type (void)) f (params)",
                                       " (block (error) (call-stmt (call (ident g))))))"));
    assert(parse_env.parse_dump(&e, "struct s {\n    i32 ;\n    i32 y;\n}\n")
           == "(module (struct s (error) (field-decl (type (prim i32)) y)))");
    string switch_src = parse_env.join2(&e, "fn void f() {\n    switch (c) {\n    1:\n",
                                        "    case 2:\n    }\n}\n");
    string dumped = parse_env.parse_dump(&e, switch_src);
    string expected = parse_env.join2(&e, "(module (fn (type (void)) f (params) (block (switch",
                                      " (ident c) (error) (case (labels (int 2)) (block))))))");
    assert(dumped == expected);
}

fn void a_construct_that_stands_at_the_boundary_keeps_its_node() {
    parse_env.env mut e = parse_env.create();
    defer parse_env.free(&e);
    // A block, a switch, a struct body and an enum body are returned whether
    // or not their `}` was found, so the recovery point pushes the node and
    // skips nothing: the tree holds the construct and not an error node over
    // it. The body ends at the `fn` that follows it, since a declaration
    // keyword is a boundary and a global's type is not: `i32 N = 1;` there
    // would be a local of the unterminated body.
    // D14.2
    string src = "fn void f() {\n    g();\nfn void h() {\n}\n";
    string dumped = parse_env.parse_dump(&e, src);
    assert(dumped == parse_env.join3(&e, "(module (fn (type (void)) f (params)",
                                     " (block (call-stmt (call (ident g)))))",
                                     " (fn (type (void)) h (params) (block)))"));
    assert(parse_env.errors(&e) == 1);
}

fn void a_file_that_is_nothing_but_errors_still_yields_a_module() {
    parse_env.env mut e = parse_env.create();
    defer parse_env.free(&e);
    // The result is never null and the tree always covers the whole file,
    // which is what lets a later pass walk a broken file at all.
    // D14.2
    assert(parse_env.parse_dump(&e, ")\n") == "(module (error))");
    assert(parse_env.parse_dump(&e, "}\n") == "(module (error))");
    assert(parse_env.parse_dump(&e, "; ; ;\n") == "(module (error))");
    assert(parse_env.parse_dump(&e, "1 2 3\n") == "(module (error))");
    // An empty file is an empty module and no error at all.
    assert(parse_env.parse_dump(&e, "") == "(module)");
    assert(parse_env.errors(&e) == 0);
}

fn void a_recovery_always_consumes_a_token() {
    parse_env.env mut e = parse_env.create();
    defer parse_env.free(&e);
    // The first token is consumed when the construct consumed none, so the
    // parse of a file made of tokens no construct accepts terminates.
    // Reaching this assertion at all is the test.
    // D14.2
    assert(parse_env.parse_dump(&e, ") ) ) )\n") == "(module (error))");
    assert(parse_env.parse_dump(&e, "] } ] }\n") == "(module (error))");
    assert(parse_env.parse_dump(&e, ", , ,\n") == "(module (error))");
}

// ---- the nesting limit ---------------------------------------------------------
// D2.11

// One source with `depth` nested parentheses around an integer literal,
// built here because a limit of 256 cannot be written out by hand.
fn string nested(strbuf.str_buf mut* out, u64 depth) {
    strbuf.clear(out);
    strbuf.append(out, "i32 x = ");
    u64 mut i = 0;
    while (i < depth) {
        strbuf.push(out, '(');
        i += 1;
    }
    strbuf.push(out, '1');
    i = 0;
    while (i < depth) {
        strbuf.push(out, ')');
        i += 1;
    }
    strbuf.append(out, ";\n");
    return strbuf.view(out);
}

fn void nesting_deeper_than_the_limit_is_an_error() {
    parse_env.env mut e = parse_env.create();
    defer parse_env.free(&e);
    strbuf.str_buf mut src = strbuf.create();
    defer strbuf.free(&src);
    // Blocks, brace initializers, bracketed groups, unary operands,
    // conditional branches and types count towards one limit of 256, so the
    // parser's recursion is bounded.
    // D2.11
    parse_env.parse(&e, nested(&src, 200));
    assert(parse_env.errors(&e) == 0);
    parse_env.parse(&e, nested(&src, 256));
    assert(parse_env.errors(&e) == 0);
    parse_env.parse(&e, nested(&src, 300));
    assert(parse_env.errors(&e) == 1);
    assert(parse_env.diag_at(&e, 0) == "1:266: error: nesting deeper than 256");
    // The file is still parsed whole: the declaration after the deep one is
    // read like any other.
    parse_env.parse(&e, nested(&src, 300));
    assert(parse_env.errors(&e) == 1);
}

// One source whose type carries `count` pointer suffixes, which is the limit
// push_suffix counts and not the one `enter` counts.
fn string suffixed(strbuf.str_buf mut* out, u64 count) {
    strbuf.clear(out);
    strbuf.append(out, "i32");
    u64 mut i = 0;
    while (i < count) {
        strbuf.push(out, '*');
        i += 1;
    }
    strbuf.append(out, " x = 0;\n");
    return strbuf.view(out);
}

fn void the_suffixes_of_one_type_have_their_own_arm_of_the_limit() {
    parse_env.env mut e = parse_env.create();
    defer parse_env.free(&e);
    strbuf.str_buf mut src = strbuf.create();
    defer strbuf.free(&src);
    // push_suffix counts the suffixes already on the type against the same
    // limit of 256, which is a second report site: the depth `enter` tracks
    // never rises here, since a suffix opens no nested construct. The two
    // hundred and fifty-seventh suffix is the one that reports, at its own
    // token.
    // D2.11
    parse_env.parse(&e, suffixed(&src, 255));
    assert(parse_env.errors(&e) == 0);
    parse_env.parse(&e, suffixed(&src, 256));
    assert(parse_env.errors(&e) == 0);
    parse_env.parse(&e, suffixed(&src, 257));
    assert(parse_env.errors(&e) == 1);
    assert(parse_env.diag_at(&e, 0) == "1:260: error: nesting deeper than 256");
    parse_env.parse(&e, suffixed(&src, 300));
    assert(parse_env.errors(&e) == 1);
    assert(parse_env.diag_at(&e, 0) == "1:260: error: nesting deeper than 256");
}

fn void deep_blocks_count_towards_the_same_limit() {
    parse_env.env mut e = parse_env.create();
    defer parse_env.free(&e);
    strbuf.str_buf mut src = strbuf.create();
    defer strbuf.free(&src);
    strbuf.append(&src, "fn void f() {\n");
    u64 mut i = 0;
    while (i < 300) {
        strbuf.push(&src, '{');
        i += 1;
    }
    i = 0;
    while (i < 300) {
        strbuf.push(&src, '}');
        i += 1;
    }
    strbuf.append(&src, "\n}\n");
    parse_env.parse(&e, strbuf.view(&src));
    assert(parse_env.errors(&e) == 1);
    assert(parse_env.diag_at(&e, 0) == "2:257: error: nesting deeper than 256");
}

fn i32 main() {
    a_skip_stops_before_the_next_statement_keyword();
    a_skip_stops_before_the_next_case_keyword();
    a_skip_stops_before_a_top_level_declaration();
    a_skip_runs_over_a_semicolon_inside_a_bracket();
    a_run_of_semicolons_is_one_boundary();
    a_leftover_bracket_is_dropped_rather_than_reported_again();
    every_recovery_point_keeps_an_error_node();
    a_construct_that_stands_at_the_boundary_keeps_its_node();
    a_file_that_is_nothing_but_errors_still_yields_a_module();
    a_recovery_always_consumes_a_token();
    nesting_deeper_than_the_limit_is_an_error();
    the_suffixes_of_one_type_have_their_own_arm_of_the_limit();
    deep_blocks_count_towards_the_same_limit();
    println("ok");
    return 0;
}
