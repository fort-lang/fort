//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: types.fields_of: a struct with no layout
//! stdout:
//| 1
/// The fields of a struct are known only once its layout is resolved: types.field_count reads
/// them, and a struct whose layout has not begun has none to give.
import fort.types;
import types_env;

fn main() i32 {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    types.node* laid = types.type_struct(&e.tt, "laid", 1);
    types.node*[1] fields = {types_env.type_of(&e, "u64")};
    u64[1] mut offsets = {};
    assert(types.type_layout_begin(laid));
    assert(types.type_layout_struct(laid, fields[..], offsets[..]));
    println(types.field_count(laid));
    types.node* waiting = types.type_struct(&e.tt, "waiting", 2);
    types.field_count(waiting);
    return 0;
}
