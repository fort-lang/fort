    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.heap(&e, 8);
    ownership_raw.expression mut lo = ownership_raw.literal(0);
    lo.constant = ownership_raw.signed(-1);
    ownership_raw.result mut value = ownership_raw_env.slice(&e, &e.root, lo,
        ownership_raw.literal(1), e.byte);
    ownership_raw_env.rejects(&value);
    println("reject negative_bound");
}

