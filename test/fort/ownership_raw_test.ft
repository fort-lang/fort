fn canonical_empty_inspection() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.open(&e);
    ownership_api.contents_fact header = ownership_local_env.empty_value();
    ownership_raw.request mut req = ownership_raw_env.request(&e);
    ownership_raw_env.accepted(ownership_raw.inspect_empty_header(&e.local.state,
        &e.local.service, &header, true, &req));
    assert(e.local.state.sources_len == 0 && e.local.state.allocations_len == 0);
    println("accept canonical_empty_inspection");
}

fn canonical_empty_element() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.open(&e);
    ownership_api.contents_fact header = ownership_local_env.empty_value();
    ownership_raw.request mut req = ownership_raw_env.request(&e);
    ownership_raw_env.rejected(ownership_transfer.check_read(&e.local.state,
        &e.local.service, &req.base, header, true));
    println("reject canonical_empty_element");
}

