//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| accept live_heap_range
//| accept live_object_access
//| reject range_exceeds_window
//| reject typed_access_exceeds_window
//| reject unproved_source
//| reject negative_bound
//| reject reversed_bounds
//| reject unproved_bound
//| accept canonical_empty_inspection
//| reject canonical_empty_element
//| reject raw_zero_range_without_source
//| accept live_boundary_zero_range
//| reject end_pointer_read
//| reject end_pointer_positive_range
//| accept aligned_same_size_reinterpretation
//| accept misaligned_pointer_cast_alone
//| reject misaligned_access
//| accept exact_integer_cast_alone
//| reject exact_integer_access
//| reject identity_integer_copy_access
//| reject changed_address_bits
//| reject bitwise_address_bits
//| reject narrowed_widened_bits
//| reject restored_equal_bits
//| reject arbitrary_integer_access
//| reject foreign_integer_access
//| accept void_round_trip
//| accept cast_preserves_original_obligation
//| accept field_window_access
//| accept element_window_access
//| accept span_backing_pointer
//| reject header_is_not_backing
//| reject cast_cannot_widen_subobject
//| accept captured_symbolic_byte_count
//| accept captured_symbolic_nonbyte_stride
//| accept proved_symbolic_subrange
//| accept reassigned_count_preserves_old_extent
//| accept ordinary_bounds_success_narrows_view
/// Tests required raw-range verdicts from captured compiler facts.
import check_env;
import ownership_api;
import ownership_keys;
import ownership_local_env;
import ownership_raw;
import ownership_raw_env;
import ownership_state;
import ownership_transfer;
import prim;
import types;

fn live_heap_range() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.heap(&e, 16);
    ownership_raw.result mut value = ownership_raw_env.slice(&e, &e.root,
        ownership_raw.literal(0), ownership_raw.literal(16), e.byte);
    defer ownership_raw.free_result(&value);
    ownership_raw_env.accepts(&value);
    ownership_raw_env.source(&value, 1, 0, 16);
    assert(e.local.state.allocations[0].obligation);
    println("accept live_heap_range");
}

fn live_object_access() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.object(&e, 8);
    ownership_raw_env.accepted(ownership_raw_env.access(&e, &e.root, e.byte));
    assert(e.root.storage.leaves_len == 8);
    assert(e.local.state.sources[0].kind == ownership_api.source_kind.stack);
    println("accept live_object_access");
}

fn range_exceeds_window() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.heap(&e, 16);
    ownership_raw.result mut value = ownership_raw_env.slice(&e, &e.root,
        ownership_raw.literal(0), ownership_raw.literal(17), e.byte);
    ownership_raw_env.rejects(&value);
    println("reject range_exceeds_window");
}

fn typed_access_exceeds_window() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.heap(&e, 1);
    types.node* wider = types.type_prim(&e.table, prim.prim_kind.prim_i32);
    ownership_raw_env.rejected(ownership_raw_env.access(&e, &e.root, wider));
    println("reject typed_access_exceeds_window");
}

fn unproved_source() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.heap(&e, 8);
    e.local.state.sources[0].kind = ownership_api.source_kind.unknown_fort;
    ownership_raw_env.rejected(ownership_raw_env.access(&e, &e.root, e.byte));
    println("reject unproved_source");
}

