fn aligned_same_size_reinterpretation() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.typed_heap(&e, prim.prim_kind.prim_i32, 1);
    types.node* left = types.type_ptr(&e.table, e.root.storage.origins[0].layout, false, false);
    types.node* floating = types.type_prim(&e.table, prim.prim_kind.prim_f32);
    types.node* right = types.type_ptr(&e.table, floating, false, false);
    ownership_raw.result mut value = ownership_raw_env.cast_value(&e, &e.root, left, right);
    defer ownership_raw.free_result(&value);
    ownership_raw_env.accepts(&value);
    ownership_raw_env.accepted(ownership_raw_env.access(&e, &value, floating));
    ownership_raw_env.source(&value, 1, 0, 4);
    println("accept aligned_same_size_reinterpretation");
}

fn misaligned_pointer_cast_alone() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.heap(&e, 16);
       ownership_raw.result mut selected = ownership_raw_env.window(&e, &e.root, 1, 9);
       defer ownership_raw.free_result(&selected);
       types.node* wider = types.type_prim(&e.table, prim.prim_kind.prim_i32);
       types.node* left = types.type_ptr(&e.table, e.byte, false, false);
       types.node* right = types.type_ptr(&e.table, wider, false, false);
       ownership_raw.result mut value = ownership_raw_env.cast_value(&e, &selected, left, right);
       defer ownership_raw.free_result(&value);
       ownership_raw_env.accepts(&value);
       ownership_raw_env.source(&value, 1, 1, 9);
    assert(value.addresses[0].alignment == 8);
    println("accept misaligned_pointer_cast_alone");
}

fn misaligned_access() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.heap(&e, 16);
       ownership_raw.result mut selected = ownership_raw_env.window(&e, &e.root, 1, 9);
       defer ownership_raw.free_result(&selected);
       types.node* wider = types.type_prim(&e.table, prim.prim_kind.prim_i32);
       types.node* left = types.type_ptr(&e.table, e.byte, false, false);
       types.node* right = types.type_ptr(&e.table, wider, false, false);
       ownership_raw.result mut value = ownership_raw_env.cast_value(&e, &selected, left, right);
       defer ownership_raw.free_result(&value);
       ownership_raw_env.accepts(&value);
       ownership_raw_env.source(&value, 1, 1, 9);
    ownership_raw_env.rejected(ownership_raw_env.access(&e, &value, wider));
    println("reject misaligned_access");
}

fn exact_integer_cast_alone() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.heap(&e, 8);
    ownership_raw.result mut bits = ownership_raw_env.integer(&e);
    defer ownership_raw.free_result(&bits);
    ownership_raw_env.accepts(&bits);
    assert(!bits.addresses[0].complete && bits.addresses[0].source.kind ==
        ownership_api.entity_kind.none && bits.storage.origins.len == 0);
    println("accept exact_integer_cast_alone");
}

fn exact_integer_access() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.open(&e);
    u64 original = 4096;
    u64 reconstructed = original;
        assert(reconstructed > 0);
        ownership_raw.result mut bits = ownership_raw_env.integer(&e);
        defer ownership_raw.free_result(&bits);
        ownership_raw_env.rejected(ownership_raw_env.access(&e, &bits, e.byte));
    println("reject exact_integer_access");
}

