//! run
//! flags: -I ../../src
//! abort
//! stderr: panic: fir.local_add: too many locals
//! stdout:
//| 2
/// A local number is a u32, so local_add refuses a function that already has U32_LIMIT locals.
/// The test sets the count to that limit, and the call panics before it adds a local.
import fort.diag;
import fort.fir;
import fort.prim;
import fort.types;

fn main() i32 {
    // `tt` lives in an allocation, so that the leak rule proves its end: no call changes the
    // pointer, and drop_made holds each release once.
    types.table mut* own tt = types.table_make();
    defer types.table_drop_made(move(tt));
    types.node* i32t = types.type_prim(tt, prim.prim_kind.prim_i32);
    types.node*[1] params = {i32t};
    types.node* fnty = types.type_fn(tt, i32t, params[..], false);
    fir.func mut* own f = fir.func_new_made(tt, null, fnty);
    defer fir.func_drop_made(move(f));
    println(fir.local_count(f));
    f->locals.len = fir.U32_LIMIT;
    fir.local_add(f, i32t, fir.local_kind.lk_temp, null, diag.loc{});
    return 0;
}
