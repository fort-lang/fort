//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: ownership_source: source location is absent
//! stdout:
//| 0
/// source makes the position of a location with a file, a line and a column. The zero
/// location has none of them, so the call panics.
import diag;
import modules;
import ownership_source;

fn main() i32 {
    modules.module_set mut set = modules.create();
    defer modules.free(&set);
    ownership_source.context mut c = ownership_source.context{.modules = &set};
    println(modules.file_count(&set));
    ownership_source.source(&c, 0, diag.loc{});
    return 0;
}
