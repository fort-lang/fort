// The faulty bodies store a pointer through a call, release its target, and read through it.
string[44] CALL_FAULTY = {
    "struct cell { i64 v; }",
    "struct cbox { cell* c; }",
    "fn setc(cbox mut* p, cell* r) void { p->c = r; }",
    "fn local_free(cbox mut* p) i64 {",
    "    cell mut* own x = new(cell);",
    "    setc(p, x);",
    "    del(x);",
    "    i64 b = p->c->v;",
    "    p->c = null;",
    "    return b;",
    "}",
    "fn stale_slot(cbox mut* p, cell* r1, cell mut* own r2) i64 {",
    "    p->c = r1;",
    "    setc(p, r2);",
    "    del(r2);",
    "    i64 b = p->c->v;",
    "    p->c = r1;",
    "    return b;",
    "}",
    "fn reuse_free(cbox mut* p, cell mut* own r) i64 {",
    "    i64 a = p->c->v;",
    "    setc(p, r);",
    "    del(r);",
    "    i64 b = p->c->v;",
    "    p->c = null;",
    "    return a + b;",
    "}",
    "fn stale_two(cbox mut* p, cell mut* own r1, cell* r3) i64 {",
    "    p->c = r3;",
    "    setc(p, r1);",
    "    del(r1);",
    "    i64 b = p->c->v;",
    "    p->c = r3;",
    "    return b;",
    "}",
    "fn local_free_reuse(cbox mut* p) i64 {",
    "    i64 a = p->c->v;",
    "    cell mut* own x = new(cell);",
    "    setc(p, x);",
    "    del(x);",
    "    i64 b = p->c->v;",
    "    p->c = null;",
    "    return a + b;",
    "}",
};

