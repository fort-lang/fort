fn projected_scalar() void {
    ownership_call_bodies.bodies mut b = ownership_call_bodies.bodies{};
    string[1] names = {"projected"};
    ownership_call_bodies.open(&b, PROJECTED[..], names[..]);
    defer ownership_call_bodies.close(&b);
    ownership_call_bodies.infer_all(&b);
    ownership_call_bodies.only_case(&b, 0);
}

// A scalar leaf has no ownership contents. Its designated source must still be live.
fn projected_released() void {
    ownership_call_bodies.bodies mut b = ownership_call_bodies.bodies{};
    string[1] names = {"projected_released"};
    ownership_call_bodies.open(&b, PROJECTED_RELEASED[..], names[..]);
    defer ownership_call_bodies.close(&b);
    ownership_call_bodies.infer_all(&b);
    ownership_summary_model.summary* model = ownership_call_bodies.summary(&b, 0);
    assert(model->proof.kind == ownership_api.proof_kind.complete && model->proof.failed);
    assert(ownership_call_bodies.saw(&b, ownership_api.event_kind.invalid_use));
    assert(b.services.counts.last.text == "reference source is no longer live");
}

// A projected void pointer stays a reference. Unknown reference contents prove no source.
fn projected_void() void {
    ownership_call_bodies.bodies mut b = ownership_call_bodies.bodies{};
    string[1] names = {"projected_void"};
    ownership_call_bodies.open(&b, PROJECTED_VOID[..], names[..]);
    defer ownership_call_bodies.close(&b);
    ownership_call_bodies.infer_all(&b);
    ownership_summary_model.summary* model = ownership_call_bodies.summary(&b, 0);
    assert(model->proof.kind == ownership_api.proof_kind.incomplete);
    assert(model->proof.terminal.reason == ownership_api.incomplete_reason.unknown_effect);
    assert(model->cases.len == 0);
}

// A move leaves the allocation live through its destination. The old owner is still empty.
fn projected_moved() void {
    ownership_call_bodies.bodies mut b = ownership_call_bodies.bodies{};
    string[1] names = {"projected_moved"};
    ownership_call_bodies.open(&b, PROJECTED_MOVED[..], names[..]);
    defer ownership_call_bodies.close(&b);
    ownership_call_bodies.infer_all(&b);
    ownership_summary_model.summary* model = ownership_call_bodies.summary(&b, 0);
    assert(model->proof.kind == ownership_api.proof_kind.complete && model->proof.failed);
    assert(ownership_call_bodies.saw(&b, ownership_api.event_kind.invalid_use));
    assert(b.services.counts.last.text == "empty reference has no element");
}

// Address formation reads no storage. A later read still observes the empty owner used to form
// the address.
fn address_moved() void {
    ownership_call_bodies.bodies mut b = ownership_call_bodies.bodies{};
    string[1] names = {"address_moved"};
    ownership_call_bodies.open(&b, ADDRESS_MOVED[..], names[..]);
    defer ownership_call_bodies.close(&b);
    ownership_call_bodies.infer_all(&b);
    ownership_summary_model.summary* model = ownership_call_bodies.summary(&b, 0);
    assert(model->proof.kind == ownership_api.proof_kind.complete && model->proof.failed);
    assert(ownership_call_bodies.saw(&b, ownership_api.event_kind.invalid_use));
    assert(b.services.counts.last.text == "empty reference has no element");
}

