//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: runtime_sig.rt_entry_param: index out of range
//! stdout:
//| true
/// A runtime entry has at most RT_MAX_PARAMS parameters. rt_entry_param at that index reads
/// no parameter, so the call panics.
import runtime_sig;

fn main() i32 {
    runtime_sig.rt_entry rt = runtime_sig.rt_entry.rt_exit;
    println(runtime_sig.rt_entry_param(rt, 0) == runtime_sig.ir_form.ir_i32);
    runtime_sig.rt_entry_param(rt, runtime_sig.RT_MAX_PARAMS);
    return 0;
}
