//! run
//! flags: -I ../../src -I support
//! stdout:
//| function ok
//| predecessors ok
//| bits ok
//| module ok
//| parser ok
//| block ok
//| release ok
/// Checks the `_made` functions of fir, fir_flow and fir_parse, each of which gives a value in an
/// allocation of its own: fir.func_new_made, fir.func_predecessors_made, fir_flow.bits_new_made,
/// fir_parse.parse_made and fir_parse.parser_create_made. Each gives the value that the function
/// of the same name without `_made` gives. It also checks fir.block_drop, and that a round of each
/// leaves the heap where it was (notes/testing.md 4).
import fort.ast;
import fort.diag;
import fort.fir;
import fir_env;
import fort.fir_flow;
import fort.fir_parse;
import heap;
import fort.session;
import std.strbuf;
import fort.types;

fn goto(fir.func mut* f, u32 from, u32 to) void {
    fir.block_set_terminator(f, from, fir.term_goto(to, fir_env.at(1, 1), 1));
}

fn ret(fir.func mut* f, u32 from) void {
    fir.block_set_terminator(f, from, fir.term_return(fir_env.at(1, 1), 1));
}

// `from` ends in `switch(_1) -> [1: yes, otherwise: no]`.
fn branch(fir.func mut* f, u32 from, u32 yes, u32 no) void {
    u32 first = fir.arm_push(f, fir_env.int_value(1), yes);
    fir.operand c = fir.operand_copy(fir.place_local(1));
    fir.block_set_terminator(f, from, fir.term_switch(c, first, 1, no, fir_env.at(1, 1), 1));
}

// ---- fir.func_new_made ------------------------------------------------------------------------

// Holds that `f` is the function of `s` that func_new makes: `_0` and one local for each parameter,
// the entry block with no statement and no terminator.
fn expect_new(fir.func* f, ast.sym* s, u32 locals) void {
    assert(f->sym == s);
    assert(f->ty == s->ty);
    assert(fir.local_count(f) == locals);
    assert(fir.block_count(f) == 1);
    assert(fir.block_statement_count(f, 0) == 0);
    assert(!fir_env.terminated(f, 0));
}

// The same function as a value, for a comparison with the allocation.
fn expect_same(fir.func* made, fir.func* value) void {
    assert(made->sym == value->sym);
    assert(made->ty == value->ty);
    assert(fir.local_count(made) == fir.local_count(value));
    assert(fir.block_count(made) == fir.block_count(value));
    u32 mut n = 0;
    while (n < fir.local_count(made)) {
        assert(fir_env.local_type(made, n) == fir_env.local_type(value, n));
        n += 1;
    }
}

// Holds that `made` is the function that func_new gives for `s` as a value.
fn same_as_new(fir_env.env mut* e, ast.sym* s, fir.func* made) void {
    fir.func mut* own value = boxed_func(fir.func_new(fir_env.tt(e), s, s->ty));
    defer fir.func_drop_made(move(value));
    expect_same(made, value);
}

fn a_made_function_is_the_function_of_func_new() void {
    fir_env.env mut* own e = fir_env.make();
    defer fir_env.drop_made(move(e));
    ast.sym* add = fir_env.sym(e, "add");
    fir.func mut* own f = fir.func_new_made(fir_env.tt(e), add, add->ty);
    defer fir.func_drop_made(move(f));
    expect_new(f, add, 3);
    same_as_new(e, add, f);
    // a function with no parameter has `_0` alone
    ast.sym* nothing = fir_env.sym(e, "nothing");
    fir.func mut* own g = fir.func_new_made(fir_env.tt(e), nothing, nothing->ty);
    defer fir.func_drop_made(move(g));
    expect_new(g, nothing, 1);
    // the fixture function of fir_env.func_made is the same function
    fir.func mut* own h = fir_env.func_made(e, "add");
    defer fir.func_drop_made(move(h));
    same_as_new(e, add, h);
}

// ---- fir.func_predecessors_made ---------------------------------------------------------------

// Holds that `a` and `b` give each block of `f` the same predecessors in the same order.
fn same_table(fir.func* f, fir.pred_table* a, fir.pred_table* b) void {
    assert(a->first.len == b->first.len);
    u32 mut blk = 0;
    while (blk < fir.block_count(f)) {
        assert(fir.pred_count(a, blk) == fir.pred_count(b, blk));
        u32 mut i = 0;
        while (i < fir.pred_count(a, blk)) {
            assert(fir.pred_at(a, blk, i) == fir.pred_at(b, blk, i));
            i += 1;
        }
        blk += 1;
    }
}

// The diamond bb0 -> bb1, bb2 -> bb3, with bb3 back to bb1: bb1 has two predecessors, bb3 has two
// and bb0 none.
fn diamond(fir.func mut* f) void {
    u32 one = fir.block_new(f);
    u32 two = fir.block_new(f);
    u32 three = fir.block_new(f);
    u32 four = fir.block_new(f);
    goto(f, 0, one);
    branch(f, one, two, three);
    goto(f, two, four);
    goto(f, three, four);
    branch(f, four, one, four + 1);
    u32 last = fir.block_new(f);
    ret(f, last);
}

fn expect_diamond(fir.pred_table* pt) void {
    assert(pt->first.len == 7);
    assert(fir.pred_count(pt, 0) == 0);
    assert(fir.pred_count(pt, 1) == 2);
    assert(fir.pred_at(pt, 1, 0) == 0 && fir.pred_at(pt, 1, 1) == 4);
    assert(fir.pred_count(pt, 2) == 1 && fir.pred_at(pt, 2, 0) == 1);
    assert(fir.pred_count(pt, 3) == 1 && fir.pred_at(pt, 3, 0) == 1);
    assert(fir.pred_count(pt, 4) == 2);
    assert(fir.pred_at(pt, 4, 0) == 2 && fir.pred_at(pt, 4, 1) == 3);
    assert(fir.pred_count(pt, 5) == 1 && fir.pred_at(pt, 5, 0) == 4);
}

// Holds that `made` is the table that func_predecessors gives for `f` as a value.
fn same_as_value(fir.func* f, fir.pred_table* made) void {
    fir.pred_table mut* own value = boxed_table(fir.func_predecessors(f));
    defer fir.pred_table_drop_made(move(value));
    same_table(f, made, value);
}

fn a_made_table_is_the_table_of_func_predecessors() void {
    fir_env.env mut* own e = fir_env.make();
    defer fir_env.drop_made(move(e));
    fir.func mut* own f = fir_env.func_made(e, "f");
    defer fir.func_drop_made(move(f));
    diamond(f);
    fir.pred_table mut* own pt = fir.func_predecessors_made(f);
    defer fir.pred_table_drop_made(move(pt));
    expect_diamond(pt);
    same_as_value(f, pt);
    // a function of one block with no edge: one entry and one more, and no predecessor
    fir.func mut* own g = fir_env.func_made(e, "nothing");
    defer fir.func_drop_made(move(g));
    ret(g, 0);
    fir.pred_table mut* own lone = fir.func_predecessors_made(g);
    defer fir.pred_table_drop_made(move(lone));
    assert(lone->first.len == 2);
    assert(fir.pred_count(lone, 0) == 0);
    assert(lone->preds.len == 0);
}

// ---- fir_flow.bits_new_made -------------------------------------------------------------------

// Holds that `s` is the empty set of the numbers below `count`, as bits_new gives it.
fn expect_empty(fir_flow.bits* s, u32 count) void {
    assert(s->count == count);
    assert(s->words.len == (cast(count, u64) + 63) / 64);
    u32 mut i = 0;
    while (i < count) {
        assert(!fir_flow.bits_get(s, i));
        i += 1;
    }
}

// The set of bits_new as a value, moved into an allocation, so that a test compares it with the
// set of bits_new_made.
fn boxed_bits(u32 count) fir_flow.bits mut* own {
    fir_flow.bits value = fir_flow.bits_new(count);
    fir_flow.bits mut* own p = new(fir_flow.bits);
    *p = move(value);
    return p;
}

// `value` moved into an allocation, which the caller ends through fir.func_drop_made.
fn boxed_func(fir.func value) fir.func mut* own {
    fir.func mut* own p = new(fir.func);
    *p = move(value);
    return p;
}

// `value` moved into an allocation, which the caller ends through fir.pred_table_drop_made.
fn boxed_table(fir.pred_table value) fir.pred_table mut* own {
    fir.pred_table mut* own p = new(fir.pred_table);
    *p = move(value);
    return p;
}

// `value` moved into an allocation, which the caller ends through fir.module_drop_made.
fn boxed_module(fir.module value) fir.module mut* own {
    fir.module mut* own p = new(fir.module);
    *p = move(value);
    return p;
}

// A set of `count` from bits_new_made equals the set of bits_new, empty, after each number is
// set, and after the last number is cleared.
fn expect_bits(u32 count) void {
    fir_flow.bits mut* own s = fir_flow.bits_new_made(count);
    defer fir_flow.bits_drop_made(move(s));
    expect_empty(s, count);
    fir_flow.bits mut* own value = boxed_bits(count);
    defer fir_flow.bits_drop_made(move(value));
    assert(fir_flow.bits_equal(s, value));
    u32 mut i = 0;
    while (i < count) {
        fir_flow.bits_set(s, i);
        fir_flow.bits_set(value, i);
        i += 1;
    }
    assert(fir_flow.bits_equal(s, value));
    if (count > 0) {
        fir_flow.bits_clear(s, count - 1);
        assert(!fir_flow.bits_get(s, count - 1));
        assert(!fir_flow.bits_equal(s, value));
    }
}

fn a_made_set_is_the_set_of_bits_new() void {
    u32[7] counts = {0, 1, 63, 64, 65, 128, 130};
    u64 mut k = 0;
    while (k < 7) {
        expect_bits(counts[k]);
        k += 1;
    }
}

// ---- fir_parse.parse_made ---------------------------------------------------------------------

// A function of two blocks against the fixture, whose second block holds no statement.
string TWO = "fn main.f(_1 (c): bool) -> i32 {\nbb0: { goto bb1; }\nbb1: { return; }\n}\n";

// A function that names a block that it does not have.
string BAD = "fn main.f(_1 (c): bool) -> i32 {\nbb0: { goto bb7; }\n}\n";

fn expect_two(fir.module* m) void {
    assert(fir.module_function_count(m) == 1);
    fir.func* f = fir.module_function_at(m, 0);
    assert(fir.block_count(f) == 2);
    assert(fir.local_count(f) == 2);
    assert(fir.block_statement_count(f, 0) == 0);
    assert(fir.block_statement_count(f, 1) == 0);
    assert(fir_env.term_kind_of(f, 0) == fir.term_kind.tk_goto);
    assert(fir_env.term_kind_of(f, 1) == fir.term_kind.tk_return);
}

// Holds that parse_module gives the module of TWO as a value too.
fn module_value(fir_env.env mut* e) void {
    fir.module mut* own value =
        boxed_module(fir_parse.parse_module(&e->c.m.s, "t.fir", TWO, fir_env.prelude(e)));
    defer fir.module_drop_made(move(value));
    expect_two(value);
}

fn a_made_module_is_the_module_of_parse_module() void {
    fir_env.env mut* own e = fir_env.make();
    defer fir_env.drop_made(move(e));
    fir.module mut* own m = fir_parse.parse_made(&e->c.m.s, "t.fir", TWO, fir_env.prelude(e));
    defer fir.module_drop_made(move(m));
    assert(fir_env.errors(e) == 0);
    expect_two(m);
    module_value(e);
    // a text with an error reports it, and the module still ends through module_drop_made
    diag.mute(session.diags(&e->c.m.s));
    fir.module mut* own bad = fir_parse.parse_made(&e->c.m.s, "t.fir", BAD, fir_env.prelude(e));
    fir.module_drop_made(move(bad));
    assert(diag.unmute(session.diags(&e->c.m.s)) == 1);
}

// ---- fir_parse.parser_create_made -------------------------------------------------------------

fn expect_type(fir_parse.fir_parser mut* p, string text, types.node* want) void {
    types.node* got = fir_parse.parse_type_text(p, text, fir_env.at(1, 1));
    assert(got == want);
}

fn a_made_parser_reads_as_the_parser_of_parser_create() void {
    fir_env.env mut* own e = fir_env.make();
    defer fir_env.drop_made(move(e));
    fir_parse.fir_parser mut* own p =
        fir_parse.parser_create_made(&e->c.m.s, "t.fir", "", fir_env.prelude(e));
    defer fir_parse.parser_drop_made(move(p));
    assert(p->file == "t.fir");
    assert(p->pos == 0);
    expect_type(p, "i32", fir_env.i32_ty(e));
    expect_type(p, "u64", fir_env.u64_ty(e));
    expect_type(p, "bool", fir_env.bool_ty(e));
    assert(fir_env.errors(e) == 0);
    // the parser of fir_env.parser_made reads its text from the first token
    fir_parse.fir_parser mut* own q = fir_env.parser_made(e, "i32");
    defer fir_parse.parser_drop_made(move(q));
    assert(q->src == "i32");
    assert(q->pos == 0);
}

// ---- fir.block_drop ---------------------------------------------------------------------------

// Appends `count` statements to block `b` of `f`.
fn fill(fir.func mut* f, u32 b, u32 count) void {
    u32 mut i = 0;
    while (i < count) {
        fir.block_append(f, b, fir.stmt_live(1, fir_env.at(1, 1), i));
        i += 1;
    }
}

// Moves block `b` out of `f` into block_drop, and gives the count of the statements it held. The
// slot keeps the zero block.
fn drop_block(fir.func mut* f, u32 b) u32 {
    u32 held = fir.block_statement_count(f, b);
    fir.block_drop(move(f->blocks.items[cast(b, u64)]));
    return held;
}

fn a_block_drop_frees_the_statements() void {
    fir_env.env mut* own e = fir_env.make();
    defer fir_env.drop_made(move(e));
    fir.func mut* own f = fir_env.func_made(e, "f");
    defer fir.func_drop_made(move(f));
    u32 one = fir.block_new(f);
    fill(f, 0, 3);
    fill(f, one, 40);
    assert(drop_block(f, one) == 40);
    assert(fir.block_statement_count(f, one) == 0);
    assert(fir.block_count(f) == 2);
    assert(fir.block_statement_count(f, 0) == 3);
    // a zero block holds no statement, and its drop frees nothing
    fir.block_drop(fir.block{});
}

// ---- the release ------------------------------------------------------------------------------

// One round: each `_made` function once, each value ended through its drop.
fn round_of_each(fir_env.env mut* e) void {
    ast.sym* add = fir_env.sym(e, "add");
    fir.func mut* own f = fir.func_new_made(fir_env.tt(e), add, add->ty);
    diamond(f);
    fir.pred_table mut* own pt = fir.func_predecessors_made(f);
    fir.pred_table_drop_made(move(pt));
    u32 one = fir.block_new(f);
    fill(f, one, 20);
    drop_block(f, one);
    fir.func_drop_made(move(f));
    fir_flow.bits mut* own s = fir_flow.bits_new_made(200);
    fir_flow.bits_drop_made(move(s));
    fir_parse.fir_parser mut* own p =
        fir_parse.parser_create_made(&e->c.m.s, "t.fir", "", fir_env.prelude(e));
    fir_parse.parser_drop_made(move(p));
}

fn the_made_values_leave_the_heap_where_they_were() void {
    fir_env.env mut* own e = fir_env.make();
    defer fir_env.drop_made(move(e));
    u64[3] mut live_at = {};
    u64 mut round = 0;
    while (round < fir_env.LEAK_ROUNDS) {
        round_of_each(e);
        u64 slot = fir_env.leak_slot(round);
        if (slot < 3) {
            live_at[slot] = heap.live_view();
        }
        round += 1;
    }
    assert(fir_env.moved(live_at) < fir_env.LEAK_BOUND);
}

fn main() i32 {
    a_made_function_is_the_function_of_func_new();
    println("function ok");
    a_made_table_is_the_table_of_func_predecessors();
    println("predecessors ok");
    a_made_set_is_the_set_of_bits_new();
    println("bits ok");
    a_made_module_is_the_module_of_parse_module();
    println("module ok");
    a_made_parser_reads_as_the_parser_of_parser_create();
    println("parser ok");
    a_block_drop_frees_the_statements();
    println("block ok");
    the_made_values_leave_the_heap_where_they_were();
    println("release ok");
    return 0;
}
