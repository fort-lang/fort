// Each place reads and writes its bytes in the layout of the target: the offsets of
// types.type_layout_struct and little-endian words. A global holds its initializer, a
// constant and the bytes of a string constant are read-only, and no address comes twice.
fn places(run_env.env mut* e) void {
    run_env.check(e, PRELUDE[..]);
    fir.module mut m = run_env.parse(e, PLACES[..]);
    defer fir.module_free(&m);
    u64[1] a1810 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.fields", a1810[..0]), "return u16 9");
    u64[1] a1811 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.layout", a1811[..1]), "return u8 0");
    u64[1] a1812 = {7};
    run_env.expect_line(run_env.run_in(e, &m, "main.layout", a1812[..1]), "return u8 0");
    u64[1] a1813 = {8};
    run_env.expect_line(run_env.run_in(e, &m, "main.layout", a1813[..1]), "return u8 8");
    u64[1] a1814 = {15};
    run_env.expect_line(run_env.run_in(e, &m, "main.layout", a1814[..1]), "return u8 1");
    u64[1] a1815 = {16};
    run_env.expect_line(run_env.run_in(e, &m, "main.layout", a1815[..1]), "return u8 176");
    u64[1] a1816 = {17};
    run_env.expect_line(run_env.run_in(e, &m, "main.layout", a1816[..1]), "return u8 160");
    u64[1] a1817 = {23};
    run_env.expect_line(run_env.run_in(e, &m, "main.layout", a1817[..1]), "return u8 0");
    u64[1] a1818 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.element", a1818[..1]), "return i32 1");
    u64[1] a1819 = {1};
    run_env.expect_line(run_env.run_in(e, &m, "main.element", a1819[..1]), "return i32 2");
    u64[1] a1820 = {2};
    run_env.expect_line(run_env.run_in(e, &m, "main.element", a1820[..1]), "return i32 3");
    u64[1] a1821 = {3};
    run_env.expect_line(run_env.run_in(e, &m, "main.element", a1821[..1]), "return i32 -4");
    u64[1] a1822 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.span_len", a1822[..0]), "return u64 2");
    u64[1] a1823 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.span_element", a1823[..1]), "return i32 2");
    u64[1] a1824 = {1};
    run_env.expect_line(run_env.run_in(e, &m, "main.span_element", a1824[..1]), "return i32 3");
    u64[1] a1825 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.span_of_span", a1825[..1]), "return i32 3");
    u64[1] a1826 = {1};
    run_env.expect_line(run_env.run_in(e, &m, "main.span_of_span", a1826[..1]), "return i32 4");
    u64[1] a1827 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.text_len", a1827[..0]), "return u64 5");
    u64[1] a1828 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.text_byte", a1828[..1]), "return char 104");
    u64[1] a1829 = {1};
    run_env.expect_line(run_env.run_in(e, &m, "main.text_byte", a1829[..1]), "return char 101");
    u64[1] a1830 = {2};
    run_env.expect_line(run_env.run_in(e, &m, "main.text_byte", a1830[..1]), "return char 108");
    u64[1] a1831 = {3};
    run_env.expect_line(run_env.run_in(e, &m, "main.text_byte", a1831[..1]), "return char 108");
    u64[1] a1832 = {4};
    run_env.expect_line(run_env.run_in(e, &m, "main.text_byte", a1832[..1]), "return char 111");
    u64[1] a1833 = {5};
    // the byte after a literal is its NUL (D3.7)
    run_env.expect_line(run_env.run_in(e, &m, "main.text_byte", a1833[..1]), "return char 0");
    u64[1] a1834 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.through", a1834[..0]), "return i32 7");
    u64[1] a1835 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.swap", a1835[..0]), "return i32 2");
    u64[1] a1836 = {0};
    // a positional aggregate leaves the padding of its destination
    run_env.expect_line(run_env.run_in(e, &m, "main.padding", a1836[..1]), "return u8 255");
    u64[1] a1837 = {1};
    // a designated aggregate zeroes it first
    run_env.expect_line(run_env.run_in(e, &m, "main.padding", a1837[..1]), "return u8 0");
    u64[1] a1838 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.global_value", a1838[..0]), "return i32 42");
    u64[1] a1839 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.global_element", a1839[..1]), "return i32 5");
    u64[1] a1840 = {1};
    run_env.expect_line(run_env.run_in(e, &m, "main.global_element", a1840[..1]), "return i32 6");
    u64[1] a1841 = {2};
    run_env.expect_line(run_env.run_in(e, &m, "main.global_element", a1841[..1]), "return i32 7");
    u64[1] a1842 = {1};
    run_env.expect_line(run_env.run_in(e, &m, "main.global_field", a1842[..1]), "return i32 0");
    u64[1] a1843 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.global_field", a1843[..1]), "return i32 4");
    u64[1] a1844 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.global_text", a1844[..0]), "return u64 4");
    u64[1] a1845 = {0};
    // each run starts its globals from their initializers
    run_env.expect_line(run_env.run_in(e, &m, "main.bump", a1845[..0]), "return i32 1");
    u64[1] a1846 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.bump_twice", a1846[..0]), "return i32 2");
    u64[1] a1847 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.store_constant", a1847[..0]),
                        "fault a store into read-only storage at 4:9");
    u64[1] a1848 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.store_text", a1848[..0]),
                        "fault a store into read-only storage at 5:9");
    u64[1] a1849 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.bytes_len", a1849[..0]), "return u64 3");
    u64[1] a1850 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.table_value", a1850[..1]), "return i32 0");
    u64[1] a1851 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.table_name", a1851[..1]), "return u64 3");
    u64[1] a1852 = {1};
    run_env.expect_line(run_env.run_in(e, &m, "main.table_value", a1852[..1]), "return i32 1");
    u64[1] a1853 = {1};
    run_env.expect_line(run_env.run_in(e, &m, "main.table_name", a1853[..1]), "return u64 5");
    u64[1] a1854 = {2};
    run_env.expect_line(run_env.run_in(e, &m, "main.table_value", a1854[..1]), "return i32 2");
    u64[1] a1855 = {2};
    run_env.expect_line(run_env.run_in(e, &m, "main.table_name", a1855[..1]), "return u64 4");
    u64[1] a1856 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.round_trip", a1856[..0]), "return i32 11");
    u64[1] a1857 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.fresh", a1857[..0]), "return true");
    u64[1] a1858 = {15};
    run_env.expect_line(run_env.run_in(e, &m, "main.gap", a1858[..1]), "return u8 0");
    u64[1] a1859 = {16};
    // the end of one region is no address of the next
    run_env.expect_line(run_env.run_in(e, &m, "main.gap", a1859[..1]),
                        "fault invalid access at 8:9");
    u64[1] a1860 = {17};
    run_env.expect_line(run_env.run_in(e, &m, "main.gap", a1860[..1]),
                        "fault invalid access at 8:9");
    u64[1] a1861 = {31};
    run_env.expect_line(run_env.run_in(e, &m, "main.gap", a1861[..1]),
                        "fault invalid access at 8:9");
    u64[1] a1862 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.del_zeroes", a1862[..0]), "return true");
    u64[1] a1863 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.zeroed_memory", a1863[..0]), "return i64 0");
    u64[1] a1864 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.owned_span", a1864[..1]), "return u64 0");
    u64[1] a1865 = {1};
    run_env.expect_line(run_env.run_in(e, &m, "main.owned_span", a1865[..1]), "return u64 0");
    u64[1] a1866 = {2};
    run_env.expect_line(run_env.run_in(e, &m, "main.owned_span", a1866[..1]), "return u64 9");
    println("places ok");
}

// Each bound of `slice_ptr` becomes 64 bits by the signedness of its own type, as
// fir_llvm.bound_value makes it: a sign-extension for a signed type and a zero-extension for
// an unsigned one. The pointer is `p + lo * 4` and the length `hi - lo`, each modulo 2^64.
fn bounds(run_env.env mut* e) void {
    run_env.check(e, PRELUDE[..]);
    fir.module mut m = run_env.parse(e, BOUNDS[..]);
    defer fir.module_free(&m);
    u64[2] a1867 = {128, 127};
    run_env.expect_line(run_env.run_in(e, &m, "main.offset_i8", a1867[..2]),
                        "return u64 18446744073709551104");
    run_env.expect_line(run_env.run_in(e, &m, "main.length_i8", a1867[..2]), "return u64 255");
    u64[2] a1868 = {127, 128};
    run_env.expect_line(run_env.run_in(e, &m, "main.offset_i8", a1868[..2]), "return u64 508");
    run_env.expect_line(run_env.run_in(e, &m, "main.length_i8", a1868[..2]),
                        "return u64 18446744073709551361");
    u64[2] a1869 = {255, 1};
    run_env.expect_line(run_env.run_in(e, &m, "main.offset_i8", a1869[..2]),
                        "return u64 18446744073709551612");
    run_env.expect_line(run_env.run_in(e, &m, "main.length_i8", a1869[..2]), "return u64 2");
    u64[2] a1870 = {255, 255};
    run_env.expect_line(run_env.run_in(e, &m, "main.offset_i8", a1870[..2]),
                        "return u64 18446744073709551612");
    run_env.expect_line(run_env.run_in(e, &m, "main.length_i8", a1870[..2]), "return u64 0");
    u64[2] a1871 = {0, 0};
    run_env.expect_line(run_env.run_in(e, &m, "main.offset_i8", a1871[..2]), "return u64 0");
    run_env.expect_line(run_env.run_in(e, &m, "main.length_i8", a1871[..2]), "return u64 0");
    u64[2] a1872 = {128, 129};
    run_env.expect_line(run_env.run_in(e, &m, "main.offset_i8", a1872[..2]),
                        "return u64 18446744073709551104");
