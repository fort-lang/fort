//! run
//! flags: -I ../../src -I support
//! stdout:
//| integers ok
//| negation ok
//| floats ok
//| casts ok
//| places ok
//| bounds ok
//| bools ok
//| terminators ok
//| calls ok
//| faults ok
//| bare runtime ok
//| unverified ok
/// Checks fir.interpreter over FIR text: each rvalue at the boundaries of its types, the
/// places and the constants over storage, the terminators, the calls and the ends of a run.
/// Python's integers and IEEE doubles gave each expected value when the cases were written,
/// and they share no code with the interpreter.
import fort.fir;
import run_env;

// The declarations that the FIR text of each case names: three structs, the second and the
// third with padding, the member record of an enum table, a struct with a `bool`, an enum,
// globals of four kinds and functions that the run lowers.
string[43] PRELUDE = {
    "struct pair {",
    "    i32 x;",
    "    i32 y;",
    "}",
    "struct gap {",
    "    u8 a;",
    "    u32 b;",
    "}",
    "struct pad {",
    "    u8 a;",
    "    u64 b;",
    "    u16 c;",
    "}",
    "struct enum_member {",
    "    i32 value;",
    "    char* name;",
    "}",
    "struct flagged {",
    "    i32 n;",
    "    bool flag;",
    "}",
    "enum color {",
    "    red,",
    "    green,",
    "    blue,",
    "}",
    "i32 G = 42;",
    "i32[3] T = {5, 6, 7};",
    "pair P = pair{.y = 4};",
    "string NAME = \"fort\";",
    "i32 mut counter = 0;",
    "fn sq(i32 x) i32 {",
    "    return x * x;",
    "}",
    "fn twice(i32 x) i32 {",
    "    return x * 2;",
    "}",
    "fn shout(i64 v) void {",
    "    println(v);",
    "}",
    "fn take(i32 mut* own p) void {",
    "    del(p);",
    "}",
};

