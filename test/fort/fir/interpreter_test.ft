// `not` of a `bool` is `!`, and `not` of an integer flips every bit at its width (D11.2).
fn negation(run_env.env mut* e) void {
    run_env.check(e, PRELUDE[..]);
    fir.module mut m = run_env.parse(e, NOTS[..]);
    defer fir.module_free(&m);
    u64[1] a1119 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.not_bool", a1119[..1]), "return true");
    u64[1] a1120 = {1};
    run_env.expect_line(run_env.run_in(e, &m, "main.not_bool", a1120[..1]), "return false");
    u64[1] a1121 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.not_i8", a1121[..1]), "return i8 -1");
    u64[1] a1122 = {255};
    run_env.expect_line(run_env.run_in(e, &m, "main.not_i8", a1122[..1]), "return i8 0");
    u64[1] a1123 = {128};
    run_env.expect_line(run_env.run_in(e, &m, "main.not_i8", a1123[..1]), "return i8 127");
    u64[1] a1124 = {5};
    run_env.expect_line(run_env.run_in(e, &m, "main.not_i8", a1124[..1]), "return i8 -6");
    u64[1] a1125 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.not_u8", a1125[..1]), "return u8 255");
    u64[1] a1126 = {255};
    run_env.expect_line(run_env.run_in(e, &m, "main.not_u8", a1126[..1]), "return u8 0");
    u64[1] a1127 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.not_u8", a1127[..1]), "return u8 255");
    u64[1] a1128 = {5};
    run_env.expect_line(run_env.run_in(e, &m, "main.not_u8", a1128[..1]), "return u8 250");
    u64[1] a1129 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.not_u16", a1129[..1]), "return u16 65535");
    u64[1] a1130 = {65535};
    run_env.expect_line(run_env.run_in(e, &m, "main.not_u16", a1130[..1]), "return u16 0");
    u64[1] a1131 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.not_u16", a1131[..1]), "return u16 65535");
    u64[1] a1132 = {5};
    run_env.expect_line(run_env.run_in(e, &m, "main.not_u16", a1132[..1]), "return u16 65530");
    u64[1] a1133 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.not_i64", a1133[..1]), "return i64 -1");
    u64[1] a1134 = {18446744073709551615};
    run_env.expect_line(run_env.run_in(e, &m, "main.not_i64", a1134[..1]), "return i64 0");
    u64[1] a1135 = {9223372036854775808};
    run_env.expect_line(run_env.run_in(e, &m, "main.not_i64", a1135[..1]),
                        "return i64 9223372036854775807");
    u64[1] a1136 = {5};
    run_env.expect_line(run_env.run_in(e, &m, "main.not_i64", a1136[..1]), "return i64 -6");
    u64[1] a1137 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.not_u64", a1137[..1]),
                        "return u64 18446744073709551615");
    u64[1] a1138 = {18446744073709551615};
    run_env.expect_line(run_env.run_in(e, &m, "main.not_u64", a1138[..1]), "return u64 0");
    u64[1] a1139 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.not_u64", a1139[..1]),
                        "return u64 18446744073709551615");
    u64[1] a1140 = {5};
    run_env.expect_line(run_env.run_in(e, &m, "main.not_u64", a1140[..1]),
                        "return u64 18446744073709551610");
    println("negation ok");
}

// IEEE arithmetic on `f32` and `f64`, in the precision of the type: rounding, overflow to an
// infinity, a signed zero and subnormal values. No case makes a NaN, whose bits differ
// between the targets.
fn floats(run_env.env mut* e) void {
    run_env.check(e, PRELUDE[..]);
    fir.module mut m = run_env.parse(e, FLOATS[..]);
    defer fir.module_free(&m);
    u64[2] a1141 = {1036831949, 1045220557};
    run_env.expect_line(run_env.run_in(e, &m, "main.fadd_f32", a1141[..2]),
                        "return f32 0x3FD3333340000000");
    u64[2] a1142 = {2139095040, 2139095040};
    run_env.expect_line(run_env.run_in(e, &m, "main.fadd_f32", a1142[..2]),
                        "return f32 0x7FF0000000000000");
    u64[2] a1143 = {2147483648, 0};
    run_env.expect_line(run_env.run_in(e, &m, "main.fadd_f32", a1143[..2]),
                        "return f32 0x0000000000000000");
    u64[2] a1144 = {0, 0};
    run_env.expect_line(run_env.run_in(e, &m, "main.fadd_f32", a1144[..2]),
                        "return f32 0x0000000000000000");
    u64[2] a1145 = {1065353216, 1077936128};
    run_env.expect_line(run_env.run_in(e, &m, "main.fadd_f32", a1145[..2]),
                        "return f32 0x4010000000000000");
    u64[2] a1146 = {3223322624, 1056964608};
    run_env.expect_line(run_env.run_in(e, &m, "main.fadd_f32", a1146[..2]),
                        "return f32 0xC000000000000000");
    u64[2] a1147 = {2139095040, 1065353216};
    run_env.expect_line(run_env.run_in(e, &m, "main.fadd_f32", a1147[..2]),
                        "return f32 0x7FF0000000000000");
    u64[2] a1148 = {1065353216, 2147483648};
    run_env.expect_line(run_env.run_in(e, &m, "main.fadd_f32", a1148[..2]),
                        "return f32 0x3FF0000000000000");
    u64[2] a1149 = {1077936128, 0};
    run_env.expect_line(run_env.run_in(e, &m, "main.fadd_f32", a1149[..2]),
                        "return f32 0x4008000000000000");
    u64[2] a1150 = {0, 0};
