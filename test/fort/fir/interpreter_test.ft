// Each arithmetic, bitwise, shift, overflow and comparison rvalue on six integer types, at the
// boundaries of each type: the wrap at the width, the sign of `div`, `rem` and `shr`, and the
// fault of a zero divisor, of the minimum divided by -1 and of a count at the width.
fn integers(run_env.env mut* e) void {
    run_env.check(e, PRELUDE[..]);
    fir.module mut m = run_env.parse(e, INTEGERS[..]);
    defer fir.module_free(&m);
    u64[2] a1 = {127, 1};
    run_env.expect_line(run_env.run_in(e, &m, "main.add_i8", a1[..2]), "return i8 -128");
    u64[2] a2 = {128, 255};
    run_env.expect_line(run_env.run_in(e, &m, "main.add_i8", a2[..2]), "return i8 127");
    u64[2] a3 = {128, 1};
    run_env.expect_line(run_env.run_in(e, &m, "main.add_i8", a3[..2]), "return i8 -127");
    u64[2] a4 = {127, 255};
    run_env.expect_line(run_env.run_in(e, &m, "main.add_i8", a4[..2]), "return i8 126");
    u64[2] a5 = {255, 255};
    run_env.expect_line(run_env.run_in(e, &m, "main.add_i8", a5[..2]), "return i8 -2");
    u64[2] a6 = {0, 0};
