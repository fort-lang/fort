// A `bool` in memory is a byte, and a load keeps its low bit, as the `load i8` and the
// `trunc` of toolchain.md 6 item 2 keep it: the byte 3 reads as `true` and the byte 2 as
// `false`. A store writes the byte of the value, 0 or 1. The run takes each argument byte
// of the function that it runs as it is.
fn bools(run_env.env mut* e) void {
    run_env.check(e, PRELUDE[..]);
    fir.module mut m = run_env.parse(e, BOOLS[..]);
    defer fir.module_free(&m);
    u64[1] a1916 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_cast", a1916[..1]), "return i32 0");
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_switch", a1916[..1]), "return i32 2");
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_switch_false", a1916[..1]),
                        "return i32 1");
    string[2] w1917 = {
        "stderr \"3:5: assert b\\x0A\"",
        "abort",
    };
    run_env.expect(run_env.run_in(e, &m, "main.bool_assert", a1916[..1]), w1917[..]);
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_check", a1916[..1]), "return");
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_not", a1916[..1]), "return true");
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_eq", a1916[..1]), "return false");
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_id", a1916[..1]), "return false");
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_pass", a1916[..1]), "return i32 0");
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_store", a1916[..1]), "return u8 0");
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_member", a1916[..1]), "return u8 0");
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_argument", a1916[..1]), "return u8 0");
    run_env.expect_line(run_env.run_in(e, &m, "main.param_byte", a1916[..1]), "return u8 0");
    u64[1] a1918 = {1};
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_cast", a1918[..1]), "return i32 1");
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_switch", a1918[..1]), "return i32 1");
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_switch_false", a1918[..1]),
                        "return i32 2");
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_assert", a1918[..1]), "return");
    string[2] w1919 = {
        "stderr \"4:5: overflow\\x0A\"",
        "abort",
    };
    run_env.expect(run_env.run_in(e, &m, "main.bool_check", a1918[..1]), w1919[..]);
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_not", a1918[..1]), "return false");
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_eq", a1918[..1]), "return true");
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_id", a1918[..1]), "return true");
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_pass", a1918[..1]), "return i32 1");
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_store", a1918[..1]), "return u8 1");
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_member", a1918[..1]), "return u8 1");
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_argument", a1918[..1]), "return u8 1");
    run_env.expect_line(run_env.run_in(e, &m, "main.param_byte", a1918[..1]), "return u8 1");
    u64[1] a1920 = {2};
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_cast", a1920[..1]), "return i32 0");
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_switch", a1920[..1]), "return i32 2");
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_switch_false", a1920[..1]),
                        "return i32 1");
    string[2] w1921 = {
        "stderr \"3:5: assert b\\x0A\"",
        "abort",
    };
    run_env.expect(run_env.run_in(e, &m, "main.bool_assert", a1920[..1]), w1921[..]);
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_check", a1920[..1]), "return");
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_not", a1920[..1]), "return true");
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_eq", a1920[..1]), "return false");
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_id", a1920[..1]), "return false");
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_pass", a1920[..1]), "return i32 0");
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_store", a1920[..1]), "return u8 0");
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_member", a1920[..1]), "return u8 0");
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_argument", a1920[..1]), "return u8 0");
    run_env.expect_line(run_env.run_in(e, &m, "main.param_byte", a1920[..1]), "return u8 2");
    u64[1] a1922 = {3};
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_cast", a1922[..1]), "return i32 1");
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_switch", a1922[..1]), "return i32 1");
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_switch_false", a1922[..1]),
                        "return i32 2");
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_assert", a1922[..1]), "return");
    string[2] w1923 = {
        "stderr \"4:5: overflow\\x0A\"",
        "abort",
    };
    run_env.expect(run_env.run_in(e, &m, "main.bool_check", a1922[..1]), w1923[..]);
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_not", a1922[..1]), "return false");
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_eq", a1922[..1]), "return true");
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_id", a1922[..1]), "return true");
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_pass", a1922[..1]), "return i32 1");
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_store", a1922[..1]), "return u8 1");
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_member", a1922[..1]), "return u8 1");
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_argument", a1922[..1]), "return u8 1");
    run_env.expect_line(run_env.run_in(e, &m, "main.param_byte", a1922[..1]), "return u8 3");
    u64[1] a1924 = {254};
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_cast", a1924[..1]), "return i32 0");
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_switch", a1924[..1]), "return i32 2");
    run_env.expect_line(run_env.run_in(e, &m, "main.bool_switch_false", a1924[..1]),
                        "return i32 1");
    string[2] w1925 = {
        "stderr \"3:5: assert b\\x0A\"",
        "abort",
    };
    run_env.expect(run_env.run_in(e, &m, "main.bool_assert", a1924[..1]), w1925[..]);
