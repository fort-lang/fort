    u64[2] a1153 = {9223372036854775808, 0};
    run_env.expect_line(run_env.run_in(e, &m, "main.fadd_f64", a1153[..2]),
                        "return f64 0x0000000000000000");
    u64[2] a1154 = {1, 1};
