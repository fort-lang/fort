// A callee takes a copy of each aggregate argument (toolchain.md 6 item 7), a `move` argument
// zeroes its place, a result arrives after the callee ends, and a call through a value runs
// the function at the address. A null or wild address and a deep recursion end the run. The
// arguments are read before the frame of the callee exists, so a fault in one is at the call.
fn calls(run_env.env mut* e) void {
    run_env.check(e, PRELUDE[..]);
    fir.module mut m = run_env.parse(e, CALLS[..]);
    defer fir.module_free(&m);
    u64[1] a1983 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.caller_copy", a1983[..0]), "return i32 100");
    u64[1] a1984 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.result_copy", a1984[..0]), "return i32 5");
    u64[1] a1985 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.moved", a1985[..0]), "return true");
    u64[1] a1986 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.fact", a1986[..1]), "return i64 1");
    u64[1] a1987 = {1};
    run_env.expect_line(run_env.run_in(e, &m, "main.fact", a1987[..1]), "return i64 1");
    u64[1] a1988 = {2};
    run_env.expect_line(run_env.run_in(e, &m, "main.fact", a1988[..1]), "return i64 2");
    u64[1] a1989 = {20};
    run_env.expect_line(run_env.run_in(e, &m, "main.fact", a1989[..1]),
                        "return i64 2432902008176640000");
    u64[1] a1990 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.by_value", a1990[..1]), "return i32 0");
    u64[1] a1991 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.through_void", a1991[..1]), "return i32 0");
    u64[1] a1992 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.lowered", a1992[..1]), "return i32 0");
    u64[1] a1993 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.model_call", a1993[..1]), "return i32 0");
    u64[1] a1994 = {7};
    run_env.expect_line(run_env.run_in(e, &m, "main.by_value", a1994[..1]), "return i32 49");
    u64[1] a1995 = {7};
    run_env.expect_line(run_env.run_in(e, &m, "main.through_void", a1995[..1]), "return i32 14");
    u64[1] a1996 = {7};
    run_env.expect_line(run_env.run_in(e, &m, "main.lowered", a1996[..1]), "return i32 14");
    u64[1] a1997 = {7};
    run_env.expect_line(run_env.run_in(e, &m, "main.model_call", a1997[..1]), "return i32 49");
    u64[1] a1998 = {4294967287};
    run_env.expect_line(run_env.run_in(e, &m, "main.by_value", a1998[..1]), "return i32 81");
    u64[1] a1999 = {4294967287};
    run_env.expect_line(run_env.run_in(e, &m, "main.through_void", a1999[..1]), "return i32 -18");
    u64[1] a2000 = {4294967287};
    run_env.expect_line(run_env.run_in(e, &m, "main.lowered", a2000[..1]), "return i32 -18");
    u64[1] a2001 = {4294967287};
    run_env.expect_line(run_env.run_in(e, &m, "main.model_call", a2001[..1]), "return i32 81");
    u64[1] a2002 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.null_call", a2002[..0]),
                        "fault a call of a null function pointer at 3:9");
    u64[1] a2003 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.wild_call", a2003[..0]),
                        "fault a call of an address that holds no function at 4:9");
    u64[1] a2004 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.model_pass", a2004[..0]), "return true");
    u64[1] a2005 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.model_null_call", a2005[..0]),
                        "fault a call of a null function pointer at 6:9");
    u64[1] a2006 = {0};
    // a fault in an argument stands at the call, because the callee has no frame yet
    run_env.expect_line(run_env.run_in(e, &m, "main.null_argument", a2006[..0]),
                        "fault null dereference at 7:9");
    u64[1] a2007 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.second_argument", a2007[..0]),
                        "fault null dereference at 9:9");
    e->stack_limit = 800;
    u64[1] a2008 = {49};
    // 50 frames of 16 bytes fit a limit of 800 bytes, and 51 do not
    run_env.expect_line(run_env.run_in(e, &m, "main.depth", a2008[..1]), "return i32 49");
    u64[1] a2009 = {50};
    run_env.expect_line(run_env.run_in(e, &m, "main.depth", a2009[..1]),
                        "fault the stack passes its limit at 5:9");
    u64[1] a2010 = {49};
    // a frame with 4096 bytes of locals counts 16 bytes too
    run_env.expect_line(run_env.run_in(e, &m, "main.heavy", a2010[..1]), "return i32 49");
    u64[1] a2011 = {50};
    run_env.expect_line(run_env.run_in(e, &m, "main.heavy", a2011[..1]),
                        "fault the stack passes its limit at 10:9");
    u64[1] a2012 = {48};
    // a frame that ended no longer counts: 1 frame and 49 fit, twice
    run_env.expect_line(run_env.run_in(e, &m, "main.twice_deep", a2012[..1]), "return i32 96");
    u64[1] a2013 = {49};
    run_env.expect_line(run_env.run_in(e, &m, "main.twice_deep", a2013[..1]),
                        "fault the stack passes its limit at 5:9");
    u64[1] a2014 = {0};
    // a frame with no byte of locals counts 16 bytes too
    run_env.expect_line(run_env.run_in(e, &m, "main.forever", a2014[..0]),
                        "fault the stack passes its limit at 8:9");
    e->stack_limit = 24;
    u64[1] a2015 = {0};
    // the run reads the arguments before it tests the limit for the new frame
    run_env.expect_line(run_env.run_in(e, &m, "main.null_argument", a2015[..0]),
                        "fault null dereference at 7:9");
    e->stack_limit = 0;
    u64[1] a2016 = {1000};
    run_env.expect_line(run_env.run_in(e, &m, "main.depth", a2016[..1]), "return i32 1000");
    u64[1] a2017 = {1000};
    run_env.expect_line(run_env.run_in(e, &m, "main.heavy", a2017[..1]), "return i32 1000");
    u64[1] a2018 = {524287};
    // the default limit is 8 MiB: 524288 frames fit, and 524289 do not
    run_env.expect_line(run_env.run_in(e, &m, "main.depth", a2018[..1]), "return i32 524287");
    u64[1] a2019 = {524288};
    run_env.expect_line(run_env.run_in(e, &m, "main.depth", a2019[..1]),
                        "fault the stack passes its limit at 5:9");
    println("calls ok");
}

// A load or a store below the first region is a null dereference, and one outside every
// live region is an invalid access, also after a release. The report quotes the bytes
// that a run writes, and an extern with no model ends the run as `outside`.
fn faults(run_env.env mut* e) void {
    run_env.check(e, PRELUDE[..]);
    fir.module mut m = run_env.parse(e, FAULTS[..]);
    defer fir.module_free(&m);
    u64[1] a2020 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.null_load", a2020[..0]),
                        "fault null dereference at 2:9");
    u64[1] a2021 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.null_store", a2021[..0]),
                        "fault null dereference at 3:9");
    u64[1] a2022 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.null_field", a2022[..0]),
                        "fault null dereference at 4:9");
    u64[1] a2023 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.past_end", a2023[..0]),
                        "fault invalid access at 5:9");
    u64[1] a2024 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.after_del", a2024[..0]),
                        "fault invalid access at 6:9");
    u64[1] a2025 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.code_load", a2025[..0]),
                        "fault invalid access at 7:9");
    u64[1] a2026 = {1};
    string[2] w2027 = {
        "stdout \"q\\\"b\\\\s\\x0A\"",
        "return i64 6",
    };
    run_env.expect(run_env.run_in(e, &m, "main.speak", a2026[..1]), w2027[..]);
    u64[1] a2028 = {2};
    string[2] w2029 = {
        "stderr \"q\\\"b\\\\s\\x0A\"",
        "return i64 6",
    };
    run_env.expect(run_env.run_in(e, &m, "main.speak", a2028[..1]), w2029[..]);
    u64[1] a2030 = {3};
    // a captured run has descriptors 1 and 2 only
    run_env.expect_line(run_env.run_in(e, &m, "main.speak", a2030[..1]), "outside write");
    u64[1] a2031 = {0};
    string[3] w2032 = {
        "stdout \"q\\\"b\\\\s\\x0Aq\\\"b\\\\s\\x0A\"",
        "stderr \"q\\\"b\\\\s\\x0A\"",
        "return",
    };
    run_env.expect(run_env.run_in(e, &m, "main.speak_both", a2031[..0]), w2032[..]);
    u64[1] a2033 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.terminal", a2033[..0]), "return i32 0");
    u64[1] a2034 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.pid", a2034[..0]), "outside getpid");
    u64[1] a2035 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.make_pair", a2035[..0]),
                        "return pair, an aggregate of 8 bytes");
    u64[1] a2036 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.make_pad", a2036[..0]),
                        "return pad, an aggregate of 24 bytes");
    println("faults ok");
}

// A function that the lowering refuses (spec/fir.md 9.8) and an entry that std.rt lacks end
// the run as a fault at the call, as a build refuses them.
fn bare_runtime(run_env.env mut* e) void {
    run_env.check_with(e, BARE_PRELUDE[..], BARE_RUNTIME[..]);
    fir.module mut m = run_env.parse(e, BARE[..]);
    defer fir.module_free(&m);
    u64[1] a2037 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.shouts", a2037[..0]),
                        "fault a function that the lowering does not lower at 3:9");
    u64[1] a2038 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.allocates", a2038[..0]),
                        "fault a runtime entry that std.rt lacks at 4:9");
    println("bare runtime ok");
}

// A function that breaks a rule of the verifier runs only when no verifier saw it. Each such
// item ends the run where it stands, as a fault or as `outside`, and the compiler goes on.
fn unverified(run_env.env mut* e) void {
    run_env.check(e, PRELUDE[..]);
    fir.module mut m = run_env.parse_unverified(e, UNVERIFIED[..]);
    defer fir.module_free(&m);
    u64[1] a2039 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.bad_scalar", a2039[..0]),
                        "fault an aggregate rvalue in a scalar place at 2:3");
    u64[1] a2040 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.bad_aggregate", a2040[..0]),
                        "fault a scalar rvalue in an aggregate place at 3:3");
    u64[1] a2041 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.dead_end", a2041[..0]),
                        "fault unreachable at 4:3");
    u64[1] a2042 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.wide", a2042[..0]), "outside strlen");
    u64[1] a2043 = {0};
    // oracle_call passes the arguments up to the parameters of its function
    run_env.expect_line(run_env.run_in(e, &m, "main.extra", a2043[..0]), "return i32 25");
    u64[1] a2044 = {0};
    run_env.expect_line(run_env.run_in(e, &m, "main.no_parameter", a2044[..0]), "return i32 7");
    u64[1] a2045 = {0};
    // an extra argument is still read
    run_env.expect_line(run_env.run_in(e, &m, "main.extra_null", a2045[..0]),
                        "fault null dereference at 6:4");
    u64[1] a2046 = {2};
    // a result wider than its place keeps its low byte
    run_env.expect_line(run_env.run_in(e, &m, "main.narrow", a2046[..1]), "return u8 4");
    u64[1] a2047 = {15};
    run_env.expect_line(run_env.run_in(e, &m, "main.narrow", a2047[..1]), "return u8 225");
    u64[1] a2048 = {16};
    run_env.expect_line(run_env.run_in(e, &m, "main.narrow", a2048[..1]), "return u8 0");
    u64[1] a2049 = {300};
    run_env.expect_line(run_env.run_in(e, &m, "main.narrow", a2049[..1]), "return u8 144");
    u64[1] a2050 = {4294966996};
    run_env.expect_line(run_env.run_in(e, &m, "main.narrow", a2050[..1]), "return u8 144");
    run_env.check_with(e, BARE_PRELUDE[..], BARE_RUNTIME[..]);
    fir.module mut bare = run_env.parse_unverified(e, BARE_CHECK[..]);
    defer fir.module_free(&bare);
    u64[1] a2051 = {0};
    run_env.expect_line(run_env.run_in(e, &bare, "main.checks", a2051[..0]),
                        "fault a runtime entry that std.rt lacks at 5:3");
    println("unverified ok");
}

fn main() i32 {
    run_env.env mut e = run_env.env{};
    run_env.open(&e);
    defer run_env.close(&e);
    integers(&e);
    negation(&e);
    floats(&e);
    casts(&e);
    places(&e);
    bounds(&e);
    bools(&e);
    terminators(&e);
    calls(&e);
    faults(&e);
    bare_runtime(&e);
    unverified(&e);
    return 0;
}
