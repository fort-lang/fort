//! run
//! flags: -I ../../src -I support
//! stdout:
//| heap ok
//| externs ok
//| globals ok
//| checks ok
//| bools ok
//| arguments ok
//| depth ok
//| programs ok
/// Checks fir.interpreter over fort source that the run lowers when it calls a function: the
/// heap, the externs that std.rt reaches, the initializers of globals, the location and the
/// entry of each check, and the start of a program.
import fort.fir;
import run_env;

// The cases of the group heap: `new` and `del`, `calloc` and `free`.
string[99] HEAP = {
    "import std.libc;",
    "struct node {",
    "    i64 value;",
    "    node mut* own next;",
    "}",
    "fn new_and_del() i32 {",
    "    i32 mut* own p = new(i32);",
    "    *p = 5;",
    "    i32 v = *p;",
    "    del(p);",
    "    return v;",
    "}",
    "fn del_empties() bool {",
    "    i32 mut* own mut p = new(i32);",
    "    del(p);",
    "    return p == null;",
    "}",
    "fn del_null() bool {",
    "    i32 mut* own mut p = null;",
    "    del(p);",
    "    return p == null;",
    "}",
    "fn read_after_del() i32 {",
    "    i32 mut* own p = new(i32);",
    "    i32* q = p;",
    "    del(p);",
    "    return *q; // after del",
    "}",
    "fn zero_count() u64 {",
    "    u8 mut@ own s = new(u8, 0);",
    "    u64 n = s.len;",
    "    del(s);",
    "    return n;",
    "}",
    "fn huge() i64 {",
    "    return 4611686018427387904;",
    "}",
    "fn out_of_memory() void {",
    "    u8 mut@ own s = new(u8, huge());",
    "    del(s);",
    "}",
    "fn calloc_overflow() bool {",
    "    void mut* own p = libc.calloc(18446744073709551615, 2);",
    "    bool none = p == null;",
    "    libc.free(move(p));",
    "    return none;",
    "}",
    "fn calloc_zero() bool {",
    "    void mut* own p = libc.calloc(0, 8);",
    "    bool some = p != null;",
    "    libc.free(move(p));",
    "    return some;",
    "}",
    "fn calloc_zero_read() u8 {",
    "    void mut* own p = libc.calloc(0, 8);",
    "    u8* b = cast(p, u8*);",
    "    u8 v = *b; // zero bytes",
    "    libc.free(move(p));",
    "    return v;",
    "}",
    "fn never_reused() bool {",
    "    u8 mut* own a = new(u8);",
    "    u64 first = cast(a, u64);",
    "    del(a);",
    "    u8 mut* own b = new(u8);",
    "    u64 second = cast(b, u64);",
    "    del(b);",
    "    return second > first;",
    "}",
    "fn local_address() u64 {",
    "    i32 x = 0;",
    "    return cast(&x, u64);",
    "}",
    "fn two_frames() bool {",
    "    u64 first = local_address();",
    "    u64 second = local_address();",
    "    return second > first;",
    "}",
    "fn push(node mut* own head, i64 v) node mut* own {",
    "    node mut* own n = new(node);",
    "    n->value = v;",
    "    n->next = move(head);",
    "    return n;",
    "}",
    "fn list_sum(i64 count) i64 {",
    "    node mut* own mut head = null;",
    "    for (i64 mut i = 1; i <= count; i++) {",
    "        node mut* own n = push(move(head), i);",
    "        head = move(n);",
    "    }",
    "    i64 mut sum = 0;",
    "    while (head != null) {",
    "        sum += head->value;",
    "        node mut* own rest = move(head->next);",
    "        del(head);",
    "        head = move(rest);",
    "    }",
    "    return sum;",
    "}",
};

// The lowering of two functions of fort source that gave an owner the bits of another address
// through an argument of `libc.memcpy`: a `mut` view of the bytes of an owner let C write them.
// D3.14 refuses that view now, as each cast that hides a pointer place, so no fort source makes
// such an owner, and the FIR text keeps the lowering that the source gave. `twin` gives `b` the
// address of the allocation of `a`, and `interior` gives it an address inside an allocation.
string[108] HEAP_LOWERED = {
    "fn main.twin() -> void {",
    "    let _1 (a): u8 mut* own;",
    "    let _2 (b): u8 mut* own;",
    "    let _3: u8 mut* own;",
    "    let _4: u8 mut* own;",
    "    let _5: u8 mut* own mut*;",
    "    let _6: u8 mut*;",
    "    let _7: u8 mut* own*;",
    "    let _8: u8*;",
    "    let _9: u8 mut*;",
    "    bb0: {",
    "        _1 = const zero u8 mut* own #80:17;",
    "        _2 = const zero u8 mut* own #81:21;",
    "        live(_1) #80:17;",
    "        _3 = alloc<u8>(const u64 1) #80:21;",
    "        check(overwrite: _1) -> bb1 #80:17;",
    "    }",
    "    bb1: {",
    "        _1 = move _3 #80:17;",
    "        live(_2) #81:21;",
    "        _4 = const null u8 mut* own #81:25;",
    "        check(overwrite: _2) -> bb2 #81:21;",
    "    }",
    "    bb2: {",
    "        _2 = move _4 #81:21;",
    "        _5 = addr mut(_2) #82:22;",
    "        _6 = cast<u8 mut*>(copy _5) #82:17;",
    "        _7 = addr(_1) #82:41;",
    "        _8 = cast<u8*>(copy _7) #82:36;",
    "        _9 = call extern memcpy(copy _6, copy _8, const u64 8) #82:16;",
    "        del(move _1) #83:5;",
    "        del(move _2) #84:5;",
    "        dead(_1) #85:1;",
    "        dead(_2) #85:1;",
    "        return #85:1;",
    "    }",
    "}",
    "fn main.interior() -> void {",
    "    let _1 (a): u8 mut@ own;",
    "    let _2 (inside): u64;",
    "    let _3 (b): u8 mut* own;",
    "    let _4: u8 mut@ own;",
    "    let _5: i64;",
    "    let _6: bool;",
    "    let _7: u64;",
    "    let _8: u8 mut* own;",
    "    let _9: u64;",
    "    let _10: bool;",
    "    let _11: u64;",
    "    let _12: u8 mut* own;",
    "    let _13: u8 mut* own mut*;",
    "    let _14: u8 mut*;",
    "    let _15: u64*;",
    "    let _16: u8*;",
    "    let _17: u8 mut*;",
    "    let _18: u64;",
    "    let _19: bool;",
    "    let _20: i64;",
    "    bb0: {",
    "        _1 = const zero u8 mut@ own #87:17;",
    "        _3 = const zero u8 mut* own #89:21;",
    "        live(_1) #87:17;",
    "        _5 = cast<i64>(const i32 4) #87:21;",
    "        _6 = lt(copy _5, const i64 0) #87:21;",
    "        check(copy _6, alloc_count, copy _5) -> bb1 #87:21;",
    "    }",
    "    bb1: {",
    "        _7 = cast<u64>(copy _5) #87:21;",
    "        _8 = alloc<u8>(copy _7) #87:21;",
    "        _4 = aggregate u8 mut@ own(move _8, copy _7) #87:21;",
    "        check(overwrite: _1) -> bb2 #87:17;",
    "    }",
    "    bb2: {",
    "        _1 = move _4 #87:17;",
    "        live(_2) #88:9;",
    "        _9 = cast<u64>(copy _1.0) #88:18;",
    "        _10 = add_overflows(copy _9, const u64 1) #88:35;",
    "        check(copy _10, overflow) -> bb3 #88:35;",
    "    }",
    "    bb3: {",
    "        _11 = add(copy _9, const u64 1) #88:35;",
    "        _2 = copy _11 #88:35;",
    "        live(_3) #89:21;",
    "        _12 = const null u8 mut* own #89:25;",
    "        check(overwrite: _3) -> bb4 #89:21;",
    "    }",
    "    bb4: {",
    "        _3 = move _12 #89:21;",
    "        _13 = addr mut(_3) #90:22;",
    "        _14 = cast<u8 mut*>(copy _13) #90:17;",
    "        _15 = addr(_2) #90:41;",
    "        _16 = cast<u8*>(copy _15) #90:36;",
    "        _17 = call extern memcpy(copy _14, copy _16, const u64 8) #90:16;",
    "        del(move _3) #91:5;",
    "        _18 = cast<u64>(const i32 0) #92:6;",
    "        _19 = ge(copy _18, copy _1.1) #92:6;",
    "        _20 = cast<i64>(copy _18) #92:6;",
    "        check(copy _19, bounds, copy _20, copy _1.1) -> bb5 #92:6;",
    "    }",
    "    bb5: {",
    "        _1[_18] = const u8 1 #92:10;",
    "        del(move _1) #93:5;",
    "        dead(_1) #94:1;",
    "        dead(_2) #94:1;",
    "        dead(_3) #94:1;",
    "        return #94:1;",
    "    }",
    "}",
};

// The cases of the group externs: the C functions that std.rt reaches.
string[104] EXTERNS = {
    "import std.libc;",
    "fn length() u64 {",
    "    return libc.strlen(\"hello\".ptr);",
    "}",
    "fn unterminated() u64 {",
    "    u8 mut@ own b = new(u8, 4);",
    "    b[0] = 65;",
    "    b[1] = 66;",
    "    b[2] = 67;",
    "    b[3] = 68;",
    "    u64 n = libc.strlen(cast(b.ptr, char*)); // no NUL",
    "    del(b);",
    "    return n;",
    "}",
    "fn moves(bool forward, u64 at) u8 {",
    "    u8[4] mut b = {1, 2, 3, 4};",
    "    if (forward) {",
    "        libc.memmove(&b[1], &b[0], 3);",
    "    } else {",
    "        libc.memmove(&b[0], &b[1], 3);",
    "    }",
    "    return b[at];",
    "}",
    "fn copies() u8 {",
    "    u8[3] a = {7, 8, 9};",
    "    u8[3] mut b = {};",
    "    libc.memcpy(&b[0], &a[0], 3);",
    "    return b[2];",
    "}",
    "fn compares(u64 which) i32 {",
    "    string[3] left = {\"abc\", \"abc\", \"b\"};",
    "    string[3] right = {\"abd\", \"abc\", \"a\"};",
    "    u64 n = left[which].len;",
    "    return libc.memcmp(cast(left[which], u8@).ptr, cast(right[which], u8@).ptr, n);",
    "}",
    "fn same_strings() bool {",
    "    string a = \"two\";",
    "    string b = \"two\";",
    "    return a == b;",
    "}",
    "fn errno_slot() i32 {",
    "    *libc.__errno_location() = 5;",
    "    return *libc.__error();",
    "}",
    "fn formats() i32 {",
    "    char[32] mut buf = {};",
    "    i32 n = libc.snprintf(&buf[0], 32, \"%.*e\".ptr, cast(3, i32), 1.5);",
    "    show(cast(buf[..], string)[0..cast(n, u64)]);",
    "    return n;",
    "}",
    "fn show(string s) void {",
    "    println(s);",
    "}",
    "fn formats_short(u64 at) u8 {",
    "    char[4] mut buf = {'x', 'x', 'x', 'x'};",
    "    libc.snprintf(&buf[0], 4, \"%.*e\".ptr, cast(3, i32), 1.5);",
    "    return cast(buf[at], u8);",
    "}",
    "fn formats_other() i32 {",
    "    char[32] mut buf = {};",
    "    return libc.snprintf(&buf[0], 32, \"%d\".ptr, cast(3, i32), 1.5);",
    "}",
    "fn parses() f64 {",
    "    return libc.strtod(\"2.5\".ptr, null);",
    "}",
    "fn parses_single() f32 {",
    "    return libc.strtof(\"0.1\".ptr, null);",
    "}",
    "fn parses_end() f64 {",
    "    char* mut end = null;",
    "    return libc.strtod(\"2.5\".ptr, &end);",
    "}",
    "fn range_error(bool single) i32 {",
    "    *libc.__errno_location() = 0;",
    "    if (single) {",
    "        f32 v = libc.strtof(\"1e99\".ptr, null);",
    "        if (v < 1.0) {",
    "            return -1;",
    "        }",
    "    } else {",
    "        f64 v = libc.strtod(\"1e999\".ptr, null);",
    "        if (v < 1.0) {",
    "            return -1;",
    "        }",
    "    }",
    "    return *libc.__errno_location();",
    "}",
    "fn no_error() i32 {",
    "    *libc.__errno_location() = 5;",
    "    f64 v = libc.strtod(\"2.5\".ptr, null);",
    "    if (v != 2.5) {",
    "        return -1;",
    "    }",
    "    return *libc.__errno_location();",
    "}",
    "fn reads() i64 {",
    "    u8[4] mut b = {};",
    "    return libc.read(0, &b[0], 4);",
    "}",
    "fn fills() u8 {",
    "    u8[4] mut b = {};",
    "    libc.memset(&b[0], 1, 4);",
    "    return b[0];",
    "}",
};

