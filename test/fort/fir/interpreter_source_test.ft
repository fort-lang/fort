    "    tally += 1;",
    "    return tally;",
    "}",
};

// The cases of the group checks: one source construct of each kind.
string[42] CHECKS = {
    "enum mood {",
    "    calm,",
    "    loud,",
    "}",
    "fn index(u64 i) i32 {",
    "    i32[3] a = {1, 2, 3};",
    "    return a[i];",
    "}",
    "fn add(i32 a, i32 b) i32 {",
    "    return a + b;",
    "}",
    "fn divide(i32 a, i32 b) i32 {",
    "    return a / b;",
    "}",
    "fn shift(i64 v, i32 n) i64 {",
    "    return v << n;",
    "}",
    "fn count(i32 n) u64 {",
    "    u8 mut@ own s = new(u8, n);",
    "    u64 len = s.len;",
    "    del(s);",
    "    return len;",
    "}",
    "fn span(u64 hi) u64 {",
    "    u8[3] a = {1, 2, 3};",
    "    u8@ s = a[1..hi];",
    "    return s.len;",
    "}",
    "fn sure(i32 x) void {",
    "    assert(x > 0);",
    "}",
    "fn give_up() void {",
    "    panic(\"gave up\");",
    "}",
    "fn name(mood m) i32 {",
    "    switch (m) {",
    "    case mood.calm:",
    "        return 1;",
    "    case mood.loud:",
    "        return 2;",
    "    }",
    "}",
};

// The cases of the group bools: a `bool` whose byte holds 0 to 255.
string[92] BOOLS = {
    "struct holder {",
    "    i32 n;",
    "    bool flag;",
    "}",
    "fn as_int(u8 v) i32 {",
    "    bool mut b = false;",
    "    u8 mut* p = cast(&b, u8 mut*);",
    "    *p = v;",
    "    return cast(b, i32);",
    "}",
    "fn branch(u8 v) i32 {",
    "    bool mut b = false;",
    "    u8 mut* p = cast(&b, u8 mut*);",
    "    *p = v;",
    "    if (b) {",
    "        return 1;",
    "    }",
    "    return 0;",
    "}",
    "fn both(u8 v, u8 w) bool {",
    "    bool mut b = false;",
    "    bool mut c = false;",
    "    u8 mut* p = cast(&b, u8 mut*);",
    "    u8 mut* q = cast(&c, u8 mut*);",
    "    *p = v;",
    "    *q = w;",
    "    return b && c;",
    "}",
    "fn either(u8 v, u8 w) bool {",
    "    bool mut b = false;",
    "    bool mut c = false;",
    "    u8 mut* p = cast(&b, u8 mut*);",
    "    u8 mut* q = cast(&c, u8 mut*);",
    "    *p = v;",
    "    *q = w;",
    "    return b || c;",
    "}",
    "fn negate(u8 v) bool {",
    "    bool mut b = false;",
    "    u8 mut* p = cast(&b, u8 mut*);",
    "    *p = v;",
    "    return !b;",
    "}",
    "fn sure(u8 v) void {",
    "    bool mut b = false;",
    "    u8 mut* p = cast(&b, u8 mut*);",
    "    *p = v;",
    "    assert(b);",
    "}",
    "fn show(u8 v) void {",
    "    bool mut b = false;",
    "    u8 mut* p = cast(&b, u8 mut*);",
    "    *p = v;",
    "    println(b);",
    "}",
    "fn pick(bool x) i32 {",
    "    if (x) {",
    "        return 1;",
    "    }",
    "    return 0;",
    "}",
    "fn pass(u8 v) i32 {",
    "    bool mut b = false;",
    "    u8 mut* p = cast(&b, u8 mut*);",
    "    *p = v;",
    "    return pick(b);",
    "}",
    "fn loop(u8 v) i32 {",
    "    bool mut b = false;",
    "    u8 mut* p = cast(&b, u8 mut*);",
    "    *p = v;",
    "    i32 mut n = 0;",
    "    while (b && n < 3) {",
    "        n += 1;",
    "    }",
    "    return n;",
    "}",
    "fn field(u8 v) i32 {",
    "    holder mut h = holder{7, false};",
    "    u8 mut* p = cast(&h.flag, u8 mut*);",
    "    *p = v;",
    "    if (h.flag) {",
    "        return 1;",
    "    }",
    "    return 0;",
    "}",
    "fn element(u8 v) bool {",
    "    bool[2] mut a = {};",
    "    u8 mut* p = cast(&a[1], u8 mut*);",
    "    *p = v;",
    "    return a[1];",
    "}",
};

// A call whose argument loads through null.
string[7] ARGUMENTS = {
    "fn show(i64 v) void {",
    "    println(v);",
    "}",
    "fn null_argument() void {",
    "    i64* p = null;",
    "    show(*p);",
    "}",
};

// A recursion whose native frame takes 16 bytes.
string[6] DEPTH = {
    "fn r(u64 n) u64 {",
    "    if (n == 0) {",
    "        return 0;",
    "    }",
    "    return r(n - 1) + 1;",
    "}",
};

