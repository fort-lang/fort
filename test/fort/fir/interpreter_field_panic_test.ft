//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: fir.interpreter: no such field
//! stdout:
//| 8
/// field_at gives the offset of a field of a struct, and the fixture `pair` has two fields. The
/// test asks for the second field, then for a third.
import fort.fir.interpreter;
import fir_env;
import fort.types;

fn main() i32 {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    types.node* t = fir_env.ty(&e, "pair");
    types.node* mut field = null;
    println(interpreter.field_at(t, 1, &field));
    interpreter.field_at(t, 2, &field);
    return 0;
}
