//! run
//! flags: -I ../../src
//! abort
//! stderr: panic: fir.interpreter: a string constant as a scalar
//! stdout:
//| 7
/// const_bits gives the bits of a scalar constant, and a `string` constant is a header of two
/// words and no scalar. The test asks for an integer, then for a string.
import fort.consts;
import fort.fir;
import fort.fir.interpreter;
import fort.prim;
import fort.types;

fn main() i32 {
    types.table mut tt = types.table{};
    defer types.type_table_free(&tt);
    types.node* i32t = types.type_prim(&tt, prim.prim_kind.prim_i32);
    interpreter.machine mut it = interpreter.machine{};
    println(interpreter.const_bits(&it, fir.const_int(i32t, consts.cv_from_i64(7))));
    interpreter.const_bits(&it, fir.const_string("text"));
    return 0;
}
