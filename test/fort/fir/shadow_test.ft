//! run
//! flags: -I ../../src -I support
//! stdout:
//| overwrite ok
//| leak ok
//| release ok
//| after release ok
//| after move ok
//| after scope ok
//| duplicate ok
//| owner tags ok
//| flows ok
//| unverified ok
//| source ok
//| programs ok
//| off ok
/// Checks fir.shadow, the shadow state of fir.interpreter (spec/ownership-design.md 3.3,
/// 3.4): each event at a run that makes it and at a boundary of it that makes none, and
/// the tags that each event names. A person derived each expected report from the design,
/// not from a run.
import fort.fir;
import run_env;
import std.strbuf;

// Holds the report `got` against the text that the items of `parts` make when they are
// joined: the lines of a report, a long line in two items.
fn expect_text(string got, string@ parts) void {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    for (u64 mut i = 0; i < parts.len; i++) {
        strbuf.append(&b, parts[i]);
    }
    if (got != strbuf.view(&b)) {
        eprintln("shadow_test: got <", got, "> want <", strbuf.view(&b), ">");
        panic("shadow_test.expect_text: the report differs");
    }
}

// The declarations that the FIR text of each case names: a struct with an owner, a link of a chain,
// a global view, a global pointer to an owner, and a function that takes an owner.
string[24] PRELUDE = {
    "import std.libc;",
    "struct box {",
    "    i32 mut* own p;",
    "    i32 v;",
    "}",
    "struct link {",
    "    link mut* own next;",
    "}",
    "struct holder {",
    "    i32* v;",
    "}",
    "struct mixed {",
    "    i32 mut* own p;",
    "    i32* v;",
    "}",
    "struct pair_own {",
    "    i32 mut* own a;",
    "    i32 mut* own b;",
    "}",
    "i32* mut VIEW = null;",
    "i32 mut* own* mut SLOT = null;",
    "fn take(i32 mut* own p) void {",
    "    del(p);",
    "}",
};

