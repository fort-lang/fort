//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: release.scan: a second function with the symbol of an entry
//! stdout:
//| true
/// Each function of a unit has its own symbol (D9.7), so fir.release.scan takes a function once.
/// The test scans one function and then the same function again, which breaks the precondition.
import fort.fir;
import fort.fir.release;
import lower_env;
import pass_env;

string[1] PRELUDE = {
    "i32 UNUSED = 0;",
};

string[5] ONE = {
    "fn main.one() -> void {",
    "    bb0: {",
    "        return;",
    "    }",
    "}",
};

fn main() i32 {
    lower_env.env mut* own e = lower_env.make();
    defer lower_env.drop_made(move(e));
    fir.module mut* own m = fir.module_make();
    *m = pass_env.parse(e, PRELUDE[..], ONE[..]);
    defer fir.module_drop_made(move(m));
    release.table mut* own t = release.make();
    defer release.drop_made(move(t));
    release.scan(t, fir.module_function_at(m, 0));
    release.solve(t);
    println(release.is_release_only(t, fir.module_function_at(m, 0)->sym));
    release.scan(t, fir.module_function_at(m, 0));
    return 0;
}
