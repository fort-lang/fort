    "    let _7: node mut* own;",
    "    bb0: {",
    "        _2 = const zero node mut* own;",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: _2) -> bb1;",
    "    }",
    "    bb1: {",
    "        _2 = move _3;",
    "        _4 = addr mut((*_2).1);",
    "        _5 = move (*_1).0;",
    "        check(overwrite: (*_4)) -> bb2;",
    "    }",
    "    bb2: {",
    "        (*_4) = move _5;",
    "        _6 = addr mut((*_1).0);",
    "        _7 = move _2;",
    "        check(overwrite: (*_6)) -> bb3;",
    "    }",
    "    bb3: {",
    "        (*_6) = move _7;",
    "        return;",
    "    }",
    "}",
    // the held address of a field makes no memory: P
    "fn main.h6() -> void {",
    "    let _1 (s): node;",
    "    let _2: node mut* own mut*;",
    "    let _3: node mut* own;",
    "    let _4: void;",
    "    bb0: {",
    "        _1 = const zero node;",
    "        _2 = addr mut(_1.0);",
    "        _4 = call fn main.g();",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_2)) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_2) = move _3;",
    "        return;",
    "    }",
    "}",
    // an address with a third read makes the local memory: U
    "fn main.h7() -> void {",
    "    let _1 (s): node;",
    "    let _2: node mut* own mut*;",
    "    let _3: node mut* own;",
    "    let _4: void;",
    "    let _5: node mut* own mut*;",
    "    bb0: {",
