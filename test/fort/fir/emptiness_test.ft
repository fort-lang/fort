    "        (*_1).0 = move _4;",
    "        return;",
    "    }",
    "}",
    // n->next = move(l->head); l->head = move(n): the held address ends no freshness: PPP
    "fn main.h5(_1 (l): node mut*) -> void {",
    "    let _2 (n): node mut* own;",
    "    let _3: node mut* own;",
    "    let _4: node mut* own mut*;",
