    "    let _4: node*;",
    "    let _5 (y): node;",
    "    bb0: {",
    "        _4 = addr(_3);",
    "        del(move _5.3[_2]);",
    "        _3.1 = move _1;",
    "        check(overwrite: _5.3[_2]) -> bb1;",
    "    }",
