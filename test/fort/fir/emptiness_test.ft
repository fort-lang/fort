    "        check(overwrite: _2.1) -> bb1;",
    "    }",
    "    bb1: {",
    "        check(overwrite: (*_3)) -> bb2;",
    "    }",
    "    bb2: {",
    "        (*_3) = move _1;",
    "        return;",
    "    }",
    "}",
    // a check with no store through the address: U
    "fn main.o5(_1 (b): node mut*) -> void {",
    "    let _2: node mut* own mut*;",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        _2 = addr mut((*_1).0);",
    "        check(overwrite: (*_2)) -> bb1;",
    "    }",
    "    bb1: {",
    "        return;",
    "    }",
    "}",
};

string[6] HELD_SHAPES_VERDICTS = {"P", "P", "U", "UU", "UU", "U"};

// Only an address of the fixed storage of a local makes it memory.
string[42] ADDRESSES = {
    // an address of an element of a span field makes no memory: a call keeps the fact: P
