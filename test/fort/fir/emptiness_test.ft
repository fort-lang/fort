    "        _2 = addr(_1.1);",
    "        _3 = call fn main.g();",
    "        check(overwrite: _1.0) -> bb1;",
    "    }",
    "    bb1: {",
    "        return;",
    "    }",
    "}",
    // an address of an element of a fixed array field makes the local memory: U
    "fn main.m3(_1 (k): u64) -> void {",
    "    let _2 (s): node;",
    "    let _3: node mut* own*;",
    "    let _4: void;",
    "    bb0: {",
