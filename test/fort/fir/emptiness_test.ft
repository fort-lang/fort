//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| release ok
//| entry ok
//| del ok
//| move ok
//| zero ok
//| fresh ok
//| same base ok
//| keys ok
//| fresh store ok
//| memory ok
//| calls ok
//| globals ok
//| held ok
//| join ok
//| bounds ok
//| constants ok
//| loops ok
//| aggregates ok
//| kill matrix ok
//| zero sequence ok
//| freshness ok
//| zero values ok
//| key shapes ok
//| return key ok
//| held shapes ok
//| addresses ok
//| straight stores ok
//| examples ok
//| report ok
//| work ok
/// Checks the emptiness pass of fir.emptiness, the proof of each overwrite check. Each gen rule,
/// each kill rule and each definition of the rule has a group of cases over FIR text, and each
/// group holds a case that the pass proves and a case that it does not prove. The examples of
/// the rule then run over lowered fort source, and the report names each check that the pass
/// does not prove.
import check_env;
import fir;
import fir.emptiness;
import fir_env;
import fir_lower;
import fir_parse;
import heap;
import lower_env;
import modules_env;
import pass_env;
import std.str;
import std.strbuf;

// The types, the globals and the functions that the FIR text of each case names. A `node` has
// two owning fields, a fixed array of two owning pointers and an owning span of them. A `pair`
// has two owning fields.
string[18] PRELUDE = {
    "struct node {",
    "    node mut* own left;",
    "    node mut* own right;",
    "    node mut* own[2] kids;",
    "    node mut* own mut@ own list;",
    "}",
    "node mut* own mut G = null;",
    "node mut* own mut H = null;",
    "struct pair {",
    "    node mut* own a;",
    "    node mut* own b;",
    "}",
    "pair mut S = pair{};",
    "fn g() void {",
    "}",
    "fn take(node mut* own n) void {",
    "    del(n);",
    "}",
};

// ---- the cases over FIR text ----------------------------------------------------------------

// Each group is a FIR module and the verdicts of its functions: the verdict of each check of a
// function, in block order, `P` for a check that the pass proves and `U` for one that it does
// not prove.

// The store of the zero value in the entry block makes a named local empty.
string[39] ENTRY = {
    // the entry block zeroes the named local: P
    "fn main.e1() -> void {",
    "    let _1 (p): node mut* own;",
    "    let _2: node mut* own;",
    "    bb0: {",
    "        _1 = const zero node mut* own;",
    "        _2 = alloc<node>(const u64 1);",
    "        check(overwrite: _1) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1 = move _2;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // a parameter has no store in the entry block: U
    "fn main.e2(_1 (p): node mut* own) -> void {",
    "    let _2: node mut* own;",
    "    bb0: {",
    "        _2 = alloc<node>(const u64 1);",
    "        check(overwrite: _1) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1 = move _2;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // a named local with no store in the entry block: U
    "fn main.e3() -> void {",
    "    let _1 (p): node mut* own;",
    "    let _2: node mut* own;",
    "    bb0: {",
    "        _2 = alloc<node>(const u64 1);",
    "        check(overwrite: _1) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1 = move _2;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
};

string[3] ENTRY_VERDICTS = {"P", "U", "U"};

// `del(move p)` makes `p` empty, and only `p`.
string[47] DEL = {
    // del of the field before the store: P
    "fn main.d1(_1 (b): node mut*) -> void {",
    "    let _2: node mut* own;",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        _2 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_1).0 = move _2;",
    "        return;",
    "    }",
    "}",
    // no del: the entry value of the field is not known: U
    "fn main.d2(_1 (b): node mut*) -> void {",
    "    let _2: node mut* own;",
    "    bb0: {",
    "        _2 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_1).0 = move _2;",
    "        return;",
    "    }",
    "}",
    // del of the other field: U
    "fn main.d3(_1 (b): node mut*) -> void {",
    "    let _2: node mut* own;",
    "    bb0: {",
    "        del(move (*_1).1);",
    "        _2 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_1).0 = move _2;",
    "        return;",
    "    }",
    "}",
    // del(*out) before *out = move(buf): P
    "fn main.d4(_1 (out): node mut* own mut*) -> void {",
    "    let _2: node mut* own;",
    "    bb0: {",
    "        del(move (*_1));",
    "        _2 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1)) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_1) = move _2;",
    "        return;",
    "    }",
    "}",
};

string[4] DEL_VERDICTS = {"P", "U", "U", "P"};

// A `move` operand makes its place and each tracked place below it empty.
string[82] MOVE = {
    // a move of the local after a store into it: PP
    "fn main.m1(_1 (x): node mut* own) -> void {",
    "    let _2 (p): node mut* own;",
    "    let _3: node mut* own;",
    "    bb0: {",
    "        _2 = const zero node mut* own;",
    "        check(overwrite: _2) -> bb1;",
    "    }",
    "    bb1: {",
    "        _2 = move _1;",
    "        _3 = move _2;",
    "        check(overwrite: _2) -> bb2;",
    "    }",
    "    bb2: {",
    "        _2 = move _3;",
    "        del(move _2);",
    "        return;",
    "    }",
    "}",
    // no move after the store: PU
    "fn main.m2(_1 (x): node mut* own) -> void {",
    "    let _2 (p): node mut* own;",
    "    let _3: node mut* own;",
    "    bb0: {",
    "        _2 = const zero node mut* own;",
    "        check(overwrite: _2) -> bb1;",
    "    }",
    "    bb1: {",
    "        _2 = move _1;",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: _2) -> bb2;",
    "    }",
    "    bb2: {",
    "        _2 = move _3;",
    "        del(move _2);",
    "        return;",
    "    }",
    "}",
    // a move of a struct: its field and an element of its fixed array, not a span element: PPU
    "fn main.m3(_1 (s): node, _2 (k): u64) -> void {",
    "    let _3: node;",
    "    let _4: node mut* own;",
    "    let _5: node mut* own;",
    "    let _6: node mut* own;",
    "    bb0: {",
    "        _3 = move _1;",
    "        _4 = alloc<node>(const u64 1);",
    "        check(overwrite: _1.0) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1.0 = move _4;",
    "        _5 = alloc<node>(const u64 1);",
    "        check(overwrite: _1.2[_2]) -> bb2;",
    "    }",
    "    bb2: {",
    "        _1.2[_2] = move _5;",
    "        _6 = alloc<node>(const u64 1);",
    "        check(overwrite: _1.3[_2]) -> bb3;",
    "    }",
    "    bb3: {",
    "        _1.3[_2] = move _6;",
    "        return;",
    "    }",
    "}",
    // the read of the move comes before the kill of the store: PU
    "fn main.m4() -> void {",
    "    let _1 (p): node mut* own;",
    "    let _2: node mut* own;",
    "    let _3: node mut* own;",
    "    bb0: {",
    "        _1 = const zero node mut* own;",
    "        _2 = alloc<node>(const u64 1);",
    "        check(overwrite: _1) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1 = move _2;",
    "        _1 = move _1;",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: _1) -> bb2;",
    "    }",
    "    bb2: {",
    "        _1 = move _3;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
};

string[4] MOVE_VERDICTS = {"PP", "PU", "PPU", "PU"};

// A store of the zero value makes its place and each tracked place below it empty.
string[112] ZERO = {
    // the move of a temporary that holds the zero value: UP
    "fn main.z1(_1 (b): node mut*) -> void {",
    "    let _2: node mut* own;",
    "    let _3: node mut* own;",
    "    bb0: {",
    "        _2 = const zero node mut* own;",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_1).0 = move _2;",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).0) -> bb2;",
    "    }",
    "    bb2: {",
    "        (*_1).0 = move _3;",
    "        return;",
    "    }",
    "}",
    // a store of null: P
    "fn main.z2(_1 (b): node mut*) -> void {",
    "    let _2: node mut* own;",
    "    bb0: {",
    "        (*_1).0 = const null node mut* own;",
    "        _2 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_1).0 = move _2;",
    "        return;",
    "    }",
    "}",
    // an aggregate of zero constants: a field and an element of a fixed array below it: PP
    "fn main.z3() -> void {",
    "    let _1 (s): node;",
    "    let _2: node mut* own;",
    "    let _3: node mut* own;",
    "    let _4: u64;",
    "    bb0: {",
    "        _1 = aggregate node(const null node mut* own, const zero node mut* own,",
    "            const zero node mut* own[2], const zero node mut* own mut@ own);",
    "        _4 = const u64 1;",
    "        _2 = alloc<node>(const u64 1);",
    "        check(overwrite: _1.1) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1.1 = move _2;",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: _1.2[_4]) -> bb2;",
    "    }",
    "    bb2: {",
    "        _1.2[_4] = move _3;",
    "        return;",
    "    }",
    "}",
    // an aggregate with an operand that is no constant: U
    "fn main.z4(_1 (x): node mut* own) -> void {",
    "    let _2 (s): node;",
    "    let _3: node mut* own;",
    "    bb0: {",
    "        _2 = aggregate node(move _1, const null node mut* own,",
    "            const zero node mut* own[2], const zero node mut* own mut@ own);",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: _2.1) -> bb1;",
    "    }",
    "    bb1: {",
    "        _2.1 = move _3;",
    "        return;",
    "    }",
    "}",
    // a zero temporary that a second item reads: U
    "fn main.z5(_1 (b): node mut*) -> void {",
    "    let _2: node mut* own;",
    "    let _3: bool;",
    "    let _4: node mut* own;",
    "    bb0: {",
    "        _2 = const zero node mut* own;",
    "        _3 = eq(copy _2, const null node mut* own);",
    "        (*_1).0 = move _2;",
    "        _4 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_1).0 = move _4;",
    "        return;",
    "    }",
    "}",
    // a zero temporary that a second store writes in part: U
    "fn main.z6(_1 (b): node mut*) -> void {",
    "    let _2: node mut* own mut@ own;",
    "    let _3: node mut* own mut@ own;",
    "    bb0: {",
    "        _2 = const zero node mut* own mut@ own;",
    "        _2.1 = const u64 1;",
    "        (*_1).3 = move _2;",
    "        _3 = const zero node mut* own mut@ own;",
    "        check(overwrite: (*_1).3) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_1).3 = move _3;",
    "        return;",
    "    }",
    "}",
    // a zero temporary that is memory: U
    "fn main.z7(_1 (b): node mut*) -> void {",
    "    let _2: node mut* own;",
    "    let _3: node mut* own mut*;",
    "    let _4: node mut* own;",
    "    bb0: {",
    "        _2 = const zero node mut* own;",
    "        _3 = addr mut(_2);",
    "        (*_1).0 = move _2;",
    "        _4 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_1).0 = move _4;",
    "        return;",
    "    }",
    "}",
};

string[7] ZERO_VERDICTS = {"UP", "P", "PP", "U", "U", "U", "U"};

// A store of a fresh `new` makes each tracked place through the pointer empty.
string[88] FRESH = {
    // a fresh new: a field and an element of a fixed array through it: PPP
    "fn main.f1() -> void {",
    "    let _1 (n): node mut* own;",
    "    let _2: node mut* own;",
    "    let _3: node mut* own;",
    "    let _4: u64;",
    "    let _5: node mut* own;",
    "    bb0: {",
    "        _1 = const zero node mut* own;",
    "        _2 = alloc<node>(const u64 1);",
    "        check(overwrite: _1) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1 = move _2;",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).0) -> bb2;",
    "    }",
    "    bb2: {",
    "        (*_1).0 = move _3;",
    "        _4 = const u64 0;",
    "        _5 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).2[_4]) -> bb3;",
    "    }",
    "    bb3: {",
    "        (*_1).2[_4] = move _5;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // a pointer that is no fresh new: PU
    "fn main.f2(_1 (m): node mut* own) -> void {",
    "    let _2 (n): node mut* own;",
    "    let _3: node mut* own;",
    "    bb0: {",
    "        _2 = const zero node mut* own;",
    "        check(overwrite: _2) -> bb1;",
    "    }",
    "    bb1: {",
    "        _2 = move _1;",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_2).0) -> bb2;",
    "    }",
    "    bb2: {",
    "        (*_2).0 = move _3;",
    "        del(move _2);",
    "        return;",
    "    }",
    "}",
    // an allocation that a second item reads is no fresh new: PU
    "fn main.f3() -> void {",
    "    let _1 (n): node mut* own;",
    "    let _2: node mut* own;",
    "    let _3: bool;",
    "    let _4: node mut* own;",
    "    bb0: {",
    "        _1 = const zero node mut* own;",
    "        _2 = alloc<node>(const u64 1);",
    "        _3 = eq(copy _2, const null node mut* own);",
    "        check(overwrite: _1) -> bb1;",
    "    }",
    "    bb1: {",
    "        _1 = move _2;",
    "        _4 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).0) -> bb2;",
    "    }",
    "    bb2: {",
    "        (*_1).0 = move _4;",
    "        del(move _1);",
    "        return;",
    "    }",
    "}",
    // no element of a span through a fresh new: PU
    "fn main.f4(_1 (k): u64) -> void {",
    "    let _2 (n): node mut* own;",
    "    let _3: node mut* own;",
    "    let _4: node mut* own;",
    "    bb0: {",
    "        _2 = const zero node mut* own;",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: _2) -> bb1;",
    "    }",
    "    bb1: {",
    "        _2 = move _3;",
    "        _4 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_2).3[_1]) -> bb2;",
    "    }",
    "    bb2: {",
    "        (*_2).3[_1] = move _4;",
    "        del(move _2);",
    "        return;",
    "    }",
    "}",
};

string[4] FRESH_VERDICTS = {"PPP", "PU", "PU", "PU"};

// A store kills the fact of each place with its base that is not separate from it.
string[67] SAME_BASE = {
    // a store into the place: U
    "fn main.k1(_1 (b): node mut*) -> void {",
    "    let _2: node mut* own;",
    "    let _3: node mut* own;",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        _2 = alloc<node>(const u64 1);",
    "        (*_1).0 = move _2;",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_1).0 = move _3;",
    "        return;",
    "    }",
    "}",
    // a store into a separate field through the same pointer: P
    "fn main.k2(_1 (b): node mut*) -> void {",
    "    let _2: node mut* own;",
    "    let _3: node mut* own;",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        _2 = alloc<node>(const u64 1);",
    "        (*_1).1 = move _2;",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_1).0 = move _3;",
    "        return;",
    "    }",
    "}",
    // a store into the pointer local: U
    "fn main.k3(_1 (b): node mut*, _2 (c): node mut*) -> void {",
    "    let _3: node mut* own;",
    "    bb0: {",
    "        del(move (*_1).0);",
    "        _1 = copy _2;",
    "        _3 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_1).0 = move _3;",
    "        return;",
    "    }",
    "}",
    // a store into a separate field of a local, and a store into the whole local: PU
    "fn main.k4(_1 (t): node) -> void {",
    "    let _2 (s): node;",
    "    let _3: node mut* own;",
    "    let _4: node mut* own;",
    "    let _5: node mut* own;",
    "    bb0: {",
    "        _2 = const zero node;",
    "        _3 = alloc<node>(const u64 1);",
    "        _2.1 = move _3;",
    "        _4 = alloc<node>(const u64 1);",
    "        check(overwrite: _2.0) -> bb1;",
    "    }",
    "    bb1: {",
    "        _2.0 = move _4;",
    "        del(move _2.0);",
    "        _2 = move _1;",
    "        _5 = alloc<node>(const u64 1);",
    "        check(overwrite: _2.0) -> bb2;",
    "    }",
    "    bb2: {",
    "        _2.0 = move _5;",
    "        return;",
    "    }",
    "}",
};

string[4] SAME_BASE_VERDICTS = {"U", "P", "U", "PU"};

// Two elements with one key are one place, and an element with no key is not tracked.
string[142] KEYS = {
    // two temporaries that copy one local: P
    "fn main.y1(_1 (v): node mut*, _2 (k): u64) -> void {",
    "    let _3: u64;",
    "    let _4: u64;",
    "    let _5: node mut* own;",
    "    bb0: {",
    "        _3 = copy _2;",
    "        del(move (*_1).3[_3]);",
    "        _4 = cast<u64>(copy _2);",
    "        _5 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).3[_4]) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_1).3[_4] = move _5;",
    "        return;",
    "    }",
    "}",
    // an index read from memory has no key: U
    "fn main.y2(_1 (v): node mut*) -> void {",
    "    let _2: u64;",
    "    let _3: u64;",
    "    let _4: node mut* own;",
    "    bb0: {",
    "        _2 = copy (*_1).3.1;",
    "        del(move (*_1).3[_2]);",
    "        _3 = copy (*_1).3.1;",
    "        _4 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).3[_3]) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_1).3[_3] = move _4;",
    "        return;",
    "    }",
    "}",
    // a store into the key local after the copy and before its use: U
    "fn main.y3(_1 (v): node mut*, _2 (k): u64) -> void {",
    "    let _3: u64;",
    "    let _4: u64;",
    "    let _5: node mut* own;",
    "    bb0: {",
    "        _4 = copy _2;",
    "        _2 = const u64 1;",
    "        _3 = copy _2;",
    "        del(move (*_1).3[_3]);",
    "        _5 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1).3[_4]) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_1).3[_4] = move _5;",
    "        return;",
    "    }",
    "}",
    // two equal constants, and two constants that differ: PU
    "fn main.y4(_1 (v): node mut* own[2] mut*) -> void {",
    "    let _2: u64;",
    "    let _3: u64;",
    "    let _4: node mut* own;",
    "    let _5: u64;",
    "    let _6: node mut* own;",
    "    bb0: {",
    "        _2 = cast<u64>(const i32 1);",
    "        del(move (*_1)[_2]);",
    "        _3 = const u64 1;",
    "        _4 = alloc<node>(const u64 1);",
    "        check(overwrite: (*_1)[_3]) -> bb1;",
    "    }",
    "    bb1: {",
    "        (*_1)[_3] = move _4;",
    "        _5 = const u64 0;",
