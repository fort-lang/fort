    "    }",
    "    bb2: {",
    "        return;",
    "    }",
    "}",
    // into a memory local: a fact through a pointer that holds its address dies: U
    "fn main.k3(_1 (v): node mut* own) -> void {",
    "    let _2 (x): node;",
    "    let _3: node mut*;",
    "    bb0: {",
    "        _2 = const zero node;",
    "        _3 = addr mut(_2);",
    "        del(move (*_3).0);",
    "        _2.0 = move _1;",
    "        check(overwrite: (*_3).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        return;",
    "    }",
    "}",
    // into a global: a fact through a pointer that holds its address dies: U
    "fn main.k4(_1 (v): node mut* own) -> void {",
    "    let _2: node mut* own mut*;",
