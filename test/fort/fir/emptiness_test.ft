    "    }",
    "    bb1: {",
    "        return;",
    "    }",
    "}",
    // into a memory local: a fact through a fresh pointer stays: P
    "fn main.k5(_1 (v): node mut* own) -> void {",
    "    let _2 (x): node;",
    "    let _3: node*;",
    "    let _4 (n): node mut* own;",
    "    let _5: node mut* own;",
    "    bb0: {",
    "        _3 = addr(_2);",
    "        _4 = const zero node mut* own;",
    "        _5 = alloc<node>(const u64 1);",
    "        _4 = move _5;",
    "        _2.1 = move _1;",
    "        check(overwrite: (*_4).0) -> bb1;",
    "    }",
    "    bb1: {",
    "        del(move _4);",
    "        return;",
