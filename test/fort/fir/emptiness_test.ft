    "    }",
    "    bb4: {",
    "        (*_1).0 = move _3;",
    "        return;",
    "    }",
    "}",
    // a declaration in a loop whose body does not del the local: U
    "fn main.j3(_1 (c): bool) -> void {",
    "    let _2 (p): node mut* own;",
    "    let _3: node mut* own;",
    "    bb0: {",
