//! run
//! flags: -I ../../src -I support
//! stdout:
//| moves ok
//| tests ok
//| owners ok
//| events ok
//| forged ok
//| entry ok
/// Checks the rvalue `regrow` in fir.interpreter (D12.2): the move of the elements into new
/// storage, the five tests of the run time in their order, the zero stores into the owner words
/// of the old elements, the events of the shadow, and the operand test over FIR text that no
/// fort source gives.
///
/// The runtime is the sandbox of run_env. Its entry `regrow` writes `regrow <n> <len>` for a
/// count below the length and `invalid release` for a span of a null pointer and a length that is
/// not 0.
import fort.fir;
import run_env;

// The source of the groups moves, tests, owners and events. A report names a line of this text.
string[106] SOURCE = {
    "struct two {",
    "    i32 mut* own a;",
    "    i32 tag;",
    "    i32 mut* own b;",
    "}",
    "struct rows {",
    "    two[2] cells;",
    "}",
    "fn grow(u64 n) i32 {",
    "    i32 mut@ own mut s = new(i32, 3);",
    "    s[0] = 7;",
    "    s[1] = 8;",
    "    s[2] = 9;",
    "    s = regrow(move(s), n);",
    "    i32 mut digits = 0;",
    "    for (u64 mut i = 0; i < s.len; i++) {",
    "        digits = digits * 10 + s[i];",
    "    }",
    "    i32 r = digits + cast(s.len, i32) * 1000000;",
    "    del(s);",
    "    return r;",
    "}",
    "fn signed(i64 n) u64 {",
    "    i32 mut@ own s = regrow(new(i32, 1), n);",
    "    u64 r = s.len;",
    "    del(s);",
    "    return r;",
    "}",
    "fn wide(u64 n) u64 {",
    "    u8 mut@ own s = regrow(new(u8, 1), n);",
    "    u64 r = s.len;",
    "    del(s);",
    "    return r;",
    "}",
    "fn empty(u64 n) u64 {",
    "    u64 mut@ own mut s = {};",
    "    s = regrow(move(s), n);",
    "    u64 mut r = s.len * 100;",
    "    for (u64 mut i = 0; i < s.len; i++) {",
    "        r += s[i];",
    "    }",
    "    del(s);",
    "    return r;",
    "}",
    "fn twice() u64 {",
    "    u8 mut@ own mut s = new(u8, 3);",
    "    u8 mut@ own t = regrow(move(s), 4);",
    "    u8 mut@ own u = regrow(move(s), 2);",
    "    u64 r = s.len * 100 + t.len * 10 + u.len;",
    "    del(t);",
    "    del(u);",
    "    del(s);",
    "    return r;",
    "}",
    "fn fresh_storage() bool {",
    "    u8 mut@ own mut s = new(u8, 3);",
    "    u64 before = cast(&s[0], u64);",
    "    s = regrow(move(s), 3);",
    "    bool moved = cast(&s[0], u64) != before;",
    "    del(s);",
    "    return moved;",
    "}",
    "fn owners(u64 n) i32 {",
    "    two mut@ own mut s = new(two, 2);",
    "    for (u64 mut i = 0; i < 2; i++) {",
    "        s[i].a = new(i32);",
    "        s[i].b = new(i32);",
    "        *s[i].a = cast(i, i32) + 1;",
    "        *s[i].b = cast(i, i32) + 5;",
    "        s[i].tag = 3;",
    "    }",
    "    s = regrow(move(s), n);",
    "    i32 mut r = 0;",
    "    for (u64 mut i = 0; i < s.len; i++) {",
    "        r = r * 10 + s[i].tag;",
    "        if (s[i].a != null) {",
    "            r = r * 100 + *s[i].a * 10 + *s[i].b;",
    "        }",
    "        del(s[i].a);",
    "        del(s[i].b);",
    "    }",
    "    del(s);",
    "    return r;",
    "}",
    "fn nested(u64 n) i32 {",
    "    rows mut@ own mut s = new(rows, 1);",
    "    s[0].cells[1].b = new(i32);",
    "    *s[0].cells[1].b = 4;",
    "    s = regrow(move(s), n);",
    "    i32 r = *s[0].cells[1].b;",
    "    del(s[0].cells[1].b);",
    "    del(s);",
    "    return r;",
    "}",
    "fn stale() i32 {",
    "    i32 mut@ own mut s = new(i32, 2);",
    "    i32* v = &s[0];",
    "    s = regrow(move(s), 4);",
    "    i32 r = *v;",
    "    del(s);",
    "    return r;",
    "}",
    "fn dropped() void {",
    "    i32 mut@ own mut s = new(i32, 2);",
    "    s = regrow(move(s), 4);",
    "}",
};

// The struct that the FIR text of the group forged names.
string[4] PRELUDE = {
    "struct two {",
    "    i32 mut* own a;",
    "    i32 mut* own b;",
    "}",
};

// Each function builds a span that no fort source gives, and gives it to `regrow` at line 9.
// The first three write the pointer word of the span `s` through a pointer to its first word.
// The last three give `regrow` the start of an allocation that a `del` released, a length of 2
// and the count `n`, so that a run shows which test of D12.2 comes first.
string[182] FORGED = {
    "fn main.inside() -> u64 {",
    "    let _1 (p): u8 mut* own;",
    "    let _2 (s): u8 mut@ own;",
    "    let _3: u8 mut@ own mut*;",
    "    let _4: u64 mut*;",
    "    let _5: u64;",
    "    let _6: u64;",
    "    let _7: u8 mut* own;",
    "    let _8 (t): u8 mut@ own;",
    "    bb0: {",
    "        _1 = alloc<u8>(const u64 4) #2:1;",
    "        _3 = addr mut(_2) #3:1;",
    "        _4 = cast<u64 mut*>(copy _3) #4:1;",
    "        _5 = cast<u64>(copy _1) #5:1;",
    "        _6 = add(copy _5, const u64 1) #6:1;",
    "        (*_4) = copy _6 #7:1;",
    "        _2.1 = const u64 2 #8:1;",
    "        _7 = regrow<u8>(move _2, const u64 4) #9:1;",
    "        _8 = aggregate u8 mut@ own(move _7, const u64 4) #10:1;",
    "        _0 = copy _8.1 #11:1;",
    "        return #12:1;",
    "    }",
    "}",
    "fn main.frame() -> u64 {",
    "    let _1 (x): u64;",
    "    let _2 (s): u8 mut@ own;",
    "    let _3: u8 mut@ own mut*;",
    "    let _4: u64 mut*;",
    "    let _5: u64*;",
    "    let _6: u64;",
    "    let _7: u8 mut* own;",
    "    let _8 (t): u8 mut@ own;",
    "    bb0: {",
    "        _1 = const u64 0 #2:1;",
    "        _3 = addr mut(_2) #3:1;",
    "        _4 = cast<u64 mut*>(copy _3) #4:1;",
    "        _5 = addr(_1) #5:1;",
    "        _6 = cast<u64>(copy _5) #6:1;",
    "        (*_4) = copy _6 #7:1;",
    "        _2.1 = const u64 2 #8:1;",
    "        _7 = regrow<u8>(move _2, const u64 4) #9:1;",
    "        _8 = aggregate u8 mut@ own(move _7, const u64 4) #10:1;",
    "        _0 = copy _8.1 #11:1;",
    "        return #12:1;",
    "    }",
    "}",
    "fn main.released() -> u64 {",
    "    let _1 (p): u8 mut* own;",
    "    let _2 (s): u8 mut@ own;",
    "    let _3: u8 mut@ own mut*;",
    "    let _4: u64 mut*;",
    "    let _5: u64;",
    "    let _6: u8 mut* own;",
    "    let _7 (t): u8 mut@ own;",
    "    bb0: {",
    "        _1 = alloc<u8>(const u64 4) #2:1;",
    "        _3 = addr mut(_2) #3:1;",
    "        _4 = cast<u64 mut*>(copy _3) #4:1;",
    "        _5 = cast<u64>(copy _1) #5:1;",
    "        (*_4) = copy _5 #6:1;",
    "        _2.1 = const u64 2 #7:1;",
    "        del(move _1) #8:1;",
    "        _6 = regrow<u8>(move _2, const u64 4) #9:1;",
    "        _7 = aggregate u8 mut@ own(move _6, const u64 4) #10:1;",
    "        _0 = copy _7.1 #11:1;",
    "        return #12:1;",
    "    }",
    "}",
    "fn main.null_with_length() -> u64 {",
    "    let _1 (s): u8 mut@ own;",
    "    let _2: u8 mut* own;",
    "    let _3 (t): u8 mut@ own;",
    "    bb0: {",
    "        _1 = const zero u8 mut@ own #2:1;",
    "        _1.1 = const u64 2 #7:1;",
    "        _2 = regrow<u8>(move _1, const u64 4) #9:1;",
    "        _3 = aggregate u8 mut@ own(move _2, const u64 4) #10:1;",
    "        _0 = copy _3.1 #11:1;",
    "        return #12:1;",
    "    }",
    "}",
    "fn main.shorter() -> u64 {",
    "    let _1 (p): u8 mut* own;",
    "    let _2 (s): u8 mut@ own;",
    "    let _3: u8 mut* own;",
    "    let _4 (t): u8 mut@ own;",
    "    let _5: u8;",
    "    let _6: u64;",
    "    bb0: {",
    "        _1 = alloc<u8>(const u64 4) #2:1;",
    "        _6 = const u64 1 #2:2;",
    "        _2 = aggregate u8 mut@ own(move _1, const u64 2) #3:1;",
    "        _2[_6] = const u8 9 #3:2;",
    "        _3 = regrow<u8>(move _2, const u64 3) #9:1;",
    "        _4 = aggregate u8 mut@ own(move _3, const u64 3) #10:1;",
    "        _5 = copy _4[_6] #11:1;",
    "        _0 = cast<u64>(copy _5) #11:2;",
    "        del(move _4) #11:3;",
    "        return #12:1;",
    "    }",
    "}",
    "fn main.moved_out() -> u64 {",
    "    let _1 (p): u8 mut* own;",
    "    let _2 (s): u8 mut@ own;",
    "    let _3: u8 mut* own;",
    "    let _4 (t): u8 mut@ own;",
    "    bb0: {",
    "        _1 = alloc<u8>(const u64 4) #2:1;",
    "        _2 = aggregate u8 mut@ own(move _1, const u64 4) #3:1;",
    "        _3 = regrow<u8>(move _2, const u64 4) #9:1;",
    "        _4 = aggregate u8 mut@ own(move _3, const u64 4) #10:1;",
    "        _0 = copy _2.1 #11:1;",
    "        del(move _4) #11:3;",
    "        return #12:1;",
    "    }",
    "}",
    "fn main.late(_1 (n): u64) -> u64 {",
    "    let _2 (p): u8 mut* own;",
    "    let _3 (s): u8 mut@ own;",
    "    let _4: u8 mut@ own mut*;",
    "    let _5: u64 mut*;",
    "    let _6: u64;",
    "    let _7: u8 mut* own;",
    "    let _8 (t): u8 mut@ own;",
    "    bb0: {",
    "        _2 = alloc<u8>(const u64 4) #2:1;",
    "        _4 = addr mut(_3) #3:1;",
    "        _5 = cast<u64 mut*>(copy _4) #4:1;",
    "        _6 = cast<u64>(copy _2) #5:1;",
    "        (*_5) = copy _6 #6:1;",
    "        _3.1 = const u64 2 #7:1;",
    "        del(move _2) #8:1;",
    "        _7 = regrow<u8>(move _3, copy _1) #9:1;",
    "        _8 = aggregate u8 mut@ own(move _7, const u64 2) #10:1;",
    "        _0 = copy _8.1 #11:1;",
    "        return #12:1;",
    "    }",
    "}",
    "fn main.late_signed(_1 (n): i64) -> u64 {",
    "    let _2 (p): u8 mut* own;",
    "    let _3 (s): u8 mut@ own;",
    "    let _4: u8 mut@ own mut*;",
    "    let _5: u64 mut*;",
    "    let _6: u64;",
    "    let _7: u8 mut* own;",
    "    let _8 (t): u8 mut@ own;",
    "    bb0: {",
    "        _2 = alloc<u8>(const u64 4) #2:1;",
    "        _4 = addr mut(_3) #3:1;",
    "        _5 = cast<u64 mut*>(copy _4) #4:1;",
    "        _6 = cast<u64>(copy _2) #5:1;",
    "        (*_5) = copy _6 #6:1;",
    "        _3.1 = const u64 2 #7:1;",
    "        del(move _2) #8:1;",
    "        _7 = regrow<u8>(move _3, copy _1) #9:1;",
    "        _8 = aggregate u8 mut@ own(move _7, const u64 2) #10:1;",
    "        _0 = copy _8.1 #11:1;",
    "        return #12:1;",
    "    }",
    "}",
    "fn main.late_wide(_1 (n): u64) -> u64 {",
    "    let _2 (p): u64 mut* own;",
    "    let _3 (s): u64 mut@ own;",
    "    let _4: u64 mut@ own mut*;",
    "    let _5: u64 mut*;",
    "    let _6: u64;",
    "    let _7: u64 mut* own;",
    "    let _8 (t): u64 mut@ own;",
    "    bb0: {",
    "        _2 = alloc<u64>(const u64 4) #2:1;",
    "        _4 = addr mut(_3) #3:1;",
    "        _5 = cast<u64 mut*>(copy _4) #4:1;",
    "        _6 = cast<u64>(copy _2) #5:1;",
    "        (*_5) = copy _6 #6:1;",
    "        _3.1 = const u64 2 #7:1;",
    "        del(move _2) #8:1;",
    "        _7 = regrow<u64>(move _3, copy _1) #9:1;",
    "        _8 = aggregate u64 mut@ own(move _7, const u64 2) #10:1;",
    "        _0 = copy _8.1 #11:1;",
    "        return #12:1;",
    "    }",
    "}",
};

// Runs `name` of the checked source with the one argument `arg` and holds the report against
// the one line `want`, so a report with an event fails the case.
fn gives(run_env.env mut* e, string name, u64 arg, string want) void {
    u64[1] a = {arg};
    fir.module mut* own none = fir.module_make();
    defer fir.module_drop_made(move(none));
    run_env.expect_line(run_env.run_in(e, none, name, a[..]), want);
}

// The same for a function that takes no argument.
fn gives_plain(run_env.env mut* e, string name, string want) void {
    u64[1] a = {0};
    fir.module mut* own none = fir.module_make();
    defer fir.module_drop_made(move(none));
    run_env.expect_line(run_env.run_in(e, none, name, a[..0]), want);
}

// Runs `name` with `arg` and holds that the runtime writes `text` and the program aborts.
fn aborts(run_env.env mut* e, string name, u64 arg, string text) void {
    u64[1] a = {arg};
    fir.module mut* own none = fir.module_make();
    defer fir.module_drop_made(move(none));
    string[2] want = {text, "abort"};
    run_env.expect(run_env.run_in(e, none, name, a[..]), want[..]);
}

// Runs `name` with no argument and holds the report against the two lines `first` and `second`.
fn reports(run_env.env mut* e, fir.module* m, string name, string first, string second) void {
    u64[1] a = {0};
    string[2] want = {first, second};
    run_env.expect(run_env.run_in(e, m, name, a[..0]), want[..]);
}

// ---- moves ---------------------------------------------------------------------------

fn moves(run_env.env mut* e) void {
    run_env.check(e, SOURCE[..]);
    e->events = true;
    // The digits are the elements in order and the millions are the new length. A count that
    // equals the length keeps each element; a count above it adds elements that hold 0.
    gives(e, "grow", 3, "return i32 3000789");
    gives(e, "grow", 5, "return i32 5078900");
    // The result is in new storage also when the count equals the length.
    gives_plain(e, "fresh_storage", "return true");
    // The empty span gives a span of `n` zero elements, and a count of 0 gives a span of 0.
    gives(e, "empty", 0, "return u64 0");
    gives(e, "empty", 4, "return u64 400");
    // The `move` empties the place: its length reads 0, and a second `regrow` of it takes the
    // empty span.
    gives_plain(e, "twice", "return u64 42");
}

// ---- tests ---------------------------------------------------------------------------

fn tests(run_env.env mut* e) void {
    run_env.check(e, SOURCE[..]);
    e->events = true;
    // A count below the length. The position is the name `regrow`.
    aborts(e, "grow", 2, "stderr \"14:9: regrow 2 3\\x0A\"");
    aborts(e, "grow", 0, "stderr \"14:9: regrow 0 3\\x0A\"");
    gives(e, "signed", 1, "return u64 1");
    aborts(e, "signed", 0, "stderr \"24:22: regrow 0 1\\x0A\"");
    // A count of a signed type that is below 0 fails the first test, before the test of the
    // length: -1 is also below the length 1.
    aborts(e, "signed", 18446744073709551615, "stderr \"24:22: alloc_count -1\\x0A\"");
    aborts(e, "signed", 9223372036854775808,
        "stderr \"24:22: alloc_count -9223372036854775808\\x0A\"");
    // The same bits in a count of an unsigned type are a count the storage cannot hold.
    aborts(e, "wide", 9223372036854775808, "stderr \"30:21: out of memory\\x0A\"");
    aborts(e, "wide", 18446744073709551615, "stderr \"30:21: out of memory\\x0A\"");
    aborts(e, "wide", 0, "stderr \"30:21: regrow 0 1\\x0A\"");
}

// ---- owners --------------------------------------------------------------------------

fn owners(run_env.env mut* e) void {
    run_env.check(e, SOURCE[..]);
    e->events = true;
    // Each element holds two owners with a plain field between them. The new elements own what
    // the old elements owned, and the release of the old storage gives no event: the old owner
    // words hold 0 at the release.
    gives(e, "owners", 2, "return i32 315326");
    // The third element is new: its tag is 0 and its two owners are null.
    gives(e, "owners", 3, "return i32 3153260");
    aborts(e, "owners", 1, "stderr \"72:9: regrow 1 2\\x0A\"");
    // An owner in an array in a struct moves also.
    gives(e, "nested", 1, "return i32 4");
    gives(e, "nested", 2, "return i32 4");
}

// ---- events --------------------------------------------------------------------------

fn events(run_env.env mut* e) void {
    run_env.check(e, SOURCE[..]);
    e->events = true;
    fir.module mut* own none = fir.module_make();
    defer fir.module_drop_made(move(none));
    // A view of the old storage is stale after the `regrow`: the storage is released.
    reports(e, none, "stale",
        "event use after release in main.stale at 99:13 through owner main.stale _1",
        "fault invalid access at 99:13");
    // The result is a fresh allocation: a function that drops it leaks.
    reports(e, none, "dropped", "event leak in main.dropped at 106:1", "return");
    // Without the events the stale read still faults.
    e->events = false;
    gives_plain(e, "stale", "fault invalid access at 99:13");
}

// ---- forged --------------------------------------------------------------------------

// Runs `name` of `m` with the one argument `arg` and holds the report against the lines `want`.
fn reports_for(run_env.env mut* e, fir.module* m, string name, u64 arg, string@ want) void {
    u64[1] a = {arg};
    run_env.expect(run_env.run_in(e, m, name, a[..]), want);
}

// The operand test comes after the three tests of the count and before the storage (D12.2). The
// operand of each function is released storage with a length of 2.
fn order(run_env.env mut* e, fir.module* m) void {
    string[2] below = {"stderr \"9:1: regrow 1 2\\x0A\"", "abort"};
    string[2] negative = {"stderr \"9:1: alloc_count -1\\x0A\"", "abort"};
    string[2] refused = {
        "event double release in main.late at 9:1 through owner main.late _2",
        "fault invalid release at 9:1",
    };
    string[2] refused_signed = {
        "event double release in main.late_signed at 9:1 through owner main.late_signed _2",
        "fault invalid release at 9:1",
    };
    string[2] refused_wide = {
        "event double release in main.late_wide at 9:1 through owner main.late_wide _2",
        "fault invalid release at 9:1",
    };
    string[2] wide = {"stderr \"104:30: overflow\\x0A\"", "abort"};
    // A count below the length fails the second test: the run does not reach the operand.
    reports_for(e, m, "main.late", 1, below[..]);
    // A negative count fails the first test.
    reports_for(e, m, "main.late_signed", 18446744073709551615, negative[..]);
    reports_for(e, m, "main.late_signed", 2, refused_signed[..]);
    // A count that passes the three tests reaches the operand, also when the storage cannot hold
    // the count: the greatest `u64` for elements of 1 byte.
    reports_for(e, m, "main.late", 2, refused[..]);
    reports_for(e, m, "main.late", 18446744073709551615, refused[..]);
    // Elements of 8 bytes: 2305843009213693951 is the greatest count whose size fits a `u64`.
    reports_for(e, m, "main.late_wide", 2305843009213693951, refused_wide[..]);
    // The next count fails the third test. The entry of the sandbox has no size test of its own:
    // its `alloc` reports the overflow of the product at line 104 of run_env.RUNTIME.
    reports_for(e, m, "main.late_wide", 2305843009213693952, wide[..]);
}

fn forged(run_env.env mut* e) void {
    run_env.check(e, PRELUDE[..]);
    // Each of the 9 functions returns in the open scope of a named owner local (V14), because the
    // text writes no `dead`: the cases hold the operand tests of `regrow` and no exit.
    fir.module mut* own m = run_env.parse_breaks_made(e, FORGED[..], 9);
    defer fir.module_drop_made(move(m));
    e->events = true;
    // A pointer into the middle of a live allocation starts no allocation.
    reports(e, m, "main.inside",
        "event invalid release in main.inside at 9:1 through owner main.inside _1",
        "fault invalid release at 9:1");
    // The address of a local starts no allocation.
    reports(e, m, "main.frame",
        "event invalid release in main.frame at 9:1 through frame main.frame _1",
        "fault invalid release at 9:1");
    // The start of an allocation that a `del` released is live no more.
    reports(e, m, "main.released",
        "event double release in main.released at 9:1 through owner main.released _1",
        "fault invalid release at 9:1");
    // A null pointer with a length that is not 0 is no zero span: the entry of the runtime
    // refuses it.
    reports(e, m, "main.null_with_length", "stderr \"9:1: invalid release\\x0A\"", "abort");
    order(e, m);
    u64[1] a = {0};
    // A span shorter than its storage is a legal operand: the storage starts at its pointer.
    run_env.expect_line(run_env.run_in(e, m, "main.shorter", a[..0]), "return u64 9");
    // The `move` of the operand empties the place: its length reads 0 after the `regrow`.
    run_env.expect_line(run_env.run_in(e, m, "main.moved_out", a[..0]), "return u64 0");
}

// ---- entry ---------------------------------------------------------------------------

// A runtime that lacks the entry `regrow` gives a fault and no silent result.
fn entry(run_env.env mut* e) void {
    u64 lines = run_env.RUNTIME_LINES - run_env.REGROW_LINES;
    run_env.check_with(e, SOURCE[..], run_env.RUNTIME[..lines]);
    e->events = true;
    gives(e, "grow", 3, "fault a runtime entry that std.rt lacks at 14:9");
}

fn main() i32 {
    run_env.env mut* own e = run_env.make();
    defer run_env.drop_made(move(e));
    moves(e);
    println("moves ok");
    tests(e);
    println("tests ok");
    owners(e);
    println("owners ok");
    events(e);
    println("events ok");
    forged(e);
    println("forged ok");
    entry(e);
    println("entry ok");
    return 0;
}
