//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| byte type 0 0
//| byte type 0 1
//| byte type 0 2
//| byte type 0 3
//| byte type 0 4
//| byte type 0 5
//| byte type 0 6
//| byte type 0 7
//| byte type 1 0
//| byte type 1 1
//| byte type 1 2
//| byte type 1 3
//| byte type 1 4
//| byte type 1 5
//| byte type 1 6
//| byte type 1 7
//| byte type 2 0
//| byte type 2 1
//| byte type 2 2
//| byte type 2 3
//| byte type 2 4
//| byte type 2 5
//| byte type 2 6
//| byte type 2 7
//| byte adapter early
//| byte adapter late
//| byte size 0 0
//| byte size 0 1
//| byte size 1 0
//| byte size 1 1
//| byte size 2 0
//| byte size 2 1
//| byte size 3 0
//| byte size 3 1
//| byte size 4 0
//| byte size 4 1
