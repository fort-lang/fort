/// Tests paid type callers and layout failure boundaries.
import ownership_raw_bytes_adaptation_env;
fn main() i32 {
    ownership_raw_bytes_adaptation_env.query_case(0, 0);
    println("byte type 0 0");
    ownership_raw_bytes_adaptation_env.query_case(0, 1);
    println("byte type 0 1");
    ownership_raw_bytes_adaptation_env.query_case(0, 2);
    println("byte type 0 2");
    ownership_raw_bytes_adaptation_env.query_case(0, 3);
    println("byte type 0 3");
    ownership_raw_bytes_adaptation_env.query_case(0, 4);
    println("byte type 0 4");
    ownership_raw_bytes_adaptation_env.query_case(0, 5);
    println("byte type 0 5");
    ownership_raw_bytes_adaptation_env.query_case(0, 6);
    println("byte type 0 6");
    ownership_raw_bytes_adaptation_env.query_case(0, 7);
    println("byte type 0 7");
    ownership_raw_bytes_adaptation_env.query_case(1, 0);
    println("byte type 1 0");
    ownership_raw_bytes_adaptation_env.query_case(1, 1);
    println("byte type 1 1");
    ownership_raw_bytes_adaptation_env.query_case(1, 2);
    println("byte type 1 2");
    ownership_raw_bytes_adaptation_env.query_case(1, 3);
    println("byte type 1 3");
    ownership_raw_bytes_adaptation_env.query_case(1, 4);
    println("byte type 1 4");
    ownership_raw_bytes_adaptation_env.query_case(1, 5);
    println("byte type 1 5");
    ownership_raw_bytes_adaptation_env.query_case(1, 6);
    println("byte type 1 6");
    ownership_raw_bytes_adaptation_env.query_case(1, 7);
    println("byte type 1 7");
    ownership_raw_bytes_adaptation_env.query_case(2, 0);
    println("byte type 2 0");
    ownership_raw_bytes_adaptation_env.query_case(2, 1);
    println("byte type 2 1");
    ownership_raw_bytes_adaptation_env.query_case(2, 2);
    println("byte type 2 2");
    ownership_raw_bytes_adaptation_env.query_case(2, 3);
    println("byte type 2 3");
    ownership_raw_bytes_adaptation_env.query_case(2, 4);
    println("byte type 2 4");
    ownership_raw_bytes_adaptation_env.query_case(2, 5);
    println("byte type 2 5");
    ownership_raw_bytes_adaptation_env.query_case(2, 6);
    println("byte type 2 6");
    ownership_raw_bytes_adaptation_env.query_case(2, 7);
    println("byte type 2 7");
    ownership_raw_bytes_adaptation_env.adapter_case(false);
    println("byte adapter early");
    ownership_raw_bytes_adaptation_env.adapter_case(true);
    println("byte adapter late");
    ownership_raw_bytes_adaptation_env.size_case(0, 0);
    println("byte size 0 0");
    ownership_raw_bytes_adaptation_env.size_case(0, 1);
    println("byte size 0 1");
    ownership_raw_bytes_adaptation_env.size_case(1, 0);
    println("byte size 1 0");
    ownership_raw_bytes_adaptation_env.size_case(1, 1);
    println("byte size 1 1");
    ownership_raw_bytes_adaptation_env.size_case(2, 0);
    println("byte size 2 0");
    ownership_raw_bytes_adaptation_env.size_case(2, 1);
    println("byte size 2 1");
    ownership_raw_bytes_adaptation_env.size_case(3, 0);
    println("byte size 3 0");
    ownership_raw_bytes_adaptation_env.size_case(3, 1);
    println("byte size 3 1");
    ownership_raw_bytes_adaptation_env.size_case(4, 0);
    println("byte size 4 0");
    ownership_raw_bytes_adaptation_env.size_case(4, 1);
    println("byte size 4 1");
    ownership_raw_bytes_adaptation_env.size_case(5, 0);
    println("byte size 5 0");
    ownership_raw_bytes_adaptation_env.size_case(5, 1);
    println("byte size 5 1");
    ownership_raw_bytes_adaptation_env.size_case(1, 2);
    println("byte size 1 2");
    ownership_raw_bytes_adaptation_env.size_case(1, 3);
    println("byte size 1 3");
    ownership_raw_bytes_adaptation_env.size_case(2, 2);
    println("byte size 2 2");
    ownership_raw_bytes_adaptation_env.size_case(2, 3);
    println("byte size 2 3");
    ownership_raw_bytes_adaptation_env.size_case(3, 2);
    println("byte size 3 2");
    ownership_raw_bytes_adaptation_env.size_case(3, 3);
    println("byte size 3 3");
    return 0;
}
