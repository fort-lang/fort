//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: pass_env.breaks_premises: another count of functions breaks a premise rule
//! stderr: 0 functions break a premise rule, and not 1
//! stdout:
//| ready
/// pass_env.breaks_premises stops the test for a text whose functions keep the 16 rules of the
/// verifier: such a text goes through the strict helper pass_env.verified_each.
import fort.fir;
import lower_env;
import pass_env;
import premise_env;

// A panic ends the program, so the case stands in a file of its own.
fn main() i32 {
    lower_env.env mut* own e = lower_env.make();
    defer lower_env.drop_made(move(e));
    fir.module mut* own m = pass_env.parse_made(e, premise_env.PRELUDE[..], premise_env.KEEP[..]);
    defer fir.module_drop_made(move(m));
    println("ready");
    pass_env.breaks_premises(e, m, 1, "the verifier refuses KEEP");
    return 0;
}
