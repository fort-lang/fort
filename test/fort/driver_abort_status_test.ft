//! run
//! flags: -I ../../src
//! abort
//! stdout:
//| before
/// Checks that driver.process_status ends the process by SIGABRT for the status of an abort of
/// --fir-run, after the buffered output went out.
import fort.driver;

fn main() i32 {
    println("before");
    return driver.process_status(-6);
}
