//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: fir_lower.lower_string_eq: a string that owns
//! stdout:
//| true
/// The checker refuses to compare an owning rvalue, which would leave no owner. The test puts
/// `move(p)` on the left of `s == t`, so lower_string_eq panics.
import fort.ast;
import fort.check;
import check_env;
import fort.fir;
import fort.fir_lower;
import lower_env;

fn main() i32 {
    lower_env.env mut* own e = lower_env.make();
    defer lower_env.drop_made(move(e));
    string[5] source = {
        "fn f(u8 mut@ own p, string s, string t) bool {",
        "    u8 mut@ own q = move(p);",
        "    del(q);",
        "    return s == t;",
        "}",
    };
    lower_env.check_lines(e, source[..], true);
    compare_the_move(e);
    return 0;
}

// Lowers `s == t` with `move(p)` on its left. The function takes the environment as a
// parameter, so the reads through `decl` and `call` use no owner of its frame. The read of the
// mark comes before `f` and `lw` exist (D17.21).
fn compare_the_move(lower_env.env mut* e) void {
    ast.node* decl = lower_env.decl(e, "f");
    ast.node mut* call = check_env.node_in_main(&e->c, ast.ast_kind.k_call, "");
    ast.node mut* eq = check_env.node_in_main(&e->c, ast.ast_kind.k_binary, "");
    println((call->ann & check.ANN_MOVE) != 0);
    // `f` lives in an allocation, so that the leak rule proves its end: no call changes the
    // pointer, and drop_made holds each release once.
    fir.func mut* own f = fir.func_make();
    *f = fir.func_new(&e->c.ck.types, decl->sym, decl->sym->ty);
    defer fir.func_drop_made(move(f));
    // `lw` ends in a block of its own, so that its `del`s come after the last call of its exit.
    {
        fir_lower.lowerer mut lw = fir_lower.lowerer{.ck = &e->c.ck, .f = f};
        defer {
            del(lw.scopes.items);
            del(lw.defers.items);
            del(lw.named.items);
        }
        fir_lower.prescan(f, decl->b);
        fir_lower.scope_push(&lw, fir_lower.scope_kind.sc_fn, 0, 0);
        eq->a = call;
        fir.operand mut out = fir.operand{};
        fir_lower.lower_string_eq(&lw, eq, &out);
    }
}
