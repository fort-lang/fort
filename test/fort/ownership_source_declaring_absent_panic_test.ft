//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: ownership_source: declaring module is absent
//! stdout:
//| 0
/// declaring_module finds the module whose file holds a declaration. The empty set holds no
/// file, so a call for any declaration breaks that precondition and panics.
import ast;
import modules;
import ownership_source;

fn main() i32 {
    modules.module_set mut set = modules.create();
    defer modules.free(&set);
    ownership_source.context mut c = ownership_source.context{.modules = &set};
    ast.node declaration = ast.node{};
    println(modules.file_count(&set));
    ownership_source.declaring_module(&c, &declaration);
    return 0;
}
