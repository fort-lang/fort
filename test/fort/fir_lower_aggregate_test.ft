//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| literal ok
//| owning ok
//| place ok
//| whole ok
/// Checks the lowering of aggregate values into a destination place (spec/fir.md 9.4, 6): struct
/// and array literals, string constants, `move(lv)`, calls, conditionals and casts of an aggregate
/// type.
import lower_env;


// `point{1, 2}` is one `aggregate` with its fields in declaration order, `point{.y = 2}` is
// `aggregate zeroed` with `const zero i32` for the field that it leaves out, `{}` is `const zero
// point`, and an array literal lists every element, an operation among them in a temporary
// first (D6.5).
fn a_literal_is_one_aggregate() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[11] source = {
        "struct point {",
        "    i32 x;",
        "    i32 y;",
        "}",
        "fn f(i32 k) i32 {",
        "    point a = point{1, 2};",
        "    point b = point{.y = 2};",
        "    point c = {};",
        "    i32[3] d = i32[3]{k, k + 1, 3};",
        "    return a.x;",
        "}",
    };
    string[31] want = {
        "fn main.f(_1 (k): i32) -> i32 {",
        "    let _0: i32;",
        "    let _2 (a): point #6:11;",
        "    let _3 (b): point #7:11;",
        "    let _4 (c): point #8:11;",
        "    let _5 (d): i32[3] #9:12;",
        "    let _6: bool #9:28;",
        "    let _7: i32 #9:28;",
        "",
        "    bb0: {",
        "        live(_2) #6:11 s1;",
        "        _2 = aggregate point(const i32 1, const i32 2) #6:15 s1;",
        "        live(_3) #7:11 s2;",
        "        _3 = aggregate zeroed point(const zero i32, const i32 2) #7:15 s2;",
        "        live(_4) #8:11 s3;",
        "        _4 = const zero point #8:15 s3;",
        "        live(_5) #9:12 s4;",
        "        _6 = add_overflows(copy _1, const i32 1) #9:28 s4;",
        "        check(copy _6, overflow) -> bb1 #9:28 s4;",
        "    }",
        "    bb1: {",
        "        _7 = add(copy _1, const i32 1) #9:28 s4;",
        "        _5 = aggregate i32[3](copy _1, copy _7, const i32 3) #9:16 s4;",
        "        _0 = copy _2.0 #10:13 s5;",
        "        dead(_2) #10:5 s5;",
        "        dead(_3) #10:5 s5;",
        "        dead(_4) #10:5 s5;",
        "        dead(_5) #10:5 s5;",
        "        return #10:5 s5;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "f"), want[..]);
}

// The members of a designated literal run in source order and stand in the `aggregate` in
// declaration order (D6.3, D6.5). `s.x` is read into a temporary before `next(&s)` runs, because a
// writer follows it (spec/fir.md 9.4).
fn a_designated_literal_runs_in_source_order() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[11] source = {
        "struct point {",
        "    i32 x;",
        "    i32 y;",
        "}",
        "fn next(point mut* p) i32 {",
        "    return 1;",
        "}",
        "fn f(point mut s) point {",
        "    point t = point{.y = s.x, .x = next(&s)};",
        "    return point{.y = next(&s)};",
        "}",
    };
    string[22] want = {
        "fn main.f(_1 (s): point) -> point {",
        "    let _0: point;",
        "    let _2 (t): point #9:11;",
        "    let _3: i32 #9:27;",
        "    let _4: point mut* #9:41;",
        "    let _5: i32 #9:40;",
        "    let _6: point mut* #10:28;",
        "    let _7: i32 #10:27;",
        "",
        "    bb0: {",
        "        live(_2) #9:11 s1;",
        "        _3 = copy _1.0 #9:27 s1;",
        "        _4 = addr mut(_1) #9:41 s1;",
        "        _5 = call fn main.next(copy _4) #9:40 s1;",
        "        _2 = aggregate zeroed point(copy _5, copy _3) #9:15 s1;",
        "        _6 = addr mut(_1) #10:28 s2;",
        "        _7 = call fn main.next(copy _6) #10:27 s2;",
        "        _0 = aggregate zeroed point(const zero i32, copy _7) #10:12 s2;",
        "        dead(_2) #10:5 s2;",
        "        return #10:5 s2;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "f"), want[..]);
}

// `s = pair{s.b, s.a}` is one `aggregate` whose operands the translator reads before it writes `s`,
// so it swaps (D6.3 as amended). An owning member enters as `move _t` for an owning rvalue and as
// `move p` for `move(lv)` (D17.5). A string literal is `const "..."`, and an aggregate place is
// `copy p`.
fn a_literal_reads_its_destination_first() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[22] source = {
        "struct pair {",
        "    i32 a;",
        "    i32 b;",
        "}",
        "struct node {",
        "    u8 mut* own p;",
        "    i32 v;",
        "}",
        "fn mk() u8 mut* own {",
        "    return null;",
        "}",
        "fn bump(pair mut* s) i32 {",
        "    return 1;",
        "}",
        "fn f(pair mut s, u8 mut* own q) node {",
        "    s = pair{s.b, s.a};",
        "    s = pair{s.b, bump(&s)};",
        "    string t = \"hi\";",
        "    pair c = s;",
        "    node n = node{mk(), c.a};",
        "    return node{move(q), 0};",
        "}",
    };
    string[30] want = {
        "fn main.f(_1 (s): pair, _2 (q): u8 mut* own) -> node {",
        "    let _0: node;",
        "    let _3 (t): string #18:12;",
        "    let _4 (c): pair #19:10;",
        "    let _5 (n): node #20:10;",
        "    let _6: i32 #17:15;",
        "    let _7: pair mut* #17:24;",
        "    let _8: i32 #17:23;",
        "    let _9: u8 mut* own #20:21;",
        "",
        "    bb0: {",
        "        _1 = aggregate pair(copy _1.1, copy _1.0) #16:9 s1;",
        "        _6 = copy _1.1 #17:15 s2;",
        "        _7 = addr mut(_1) #17:24 s2;",
        "        _8 = call fn main.bump(copy _7) #17:23 s2;",
        "        _1 = aggregate pair(copy _6, copy _8) #17:9 s2;",
        "        live(_3) #18:12 s3;",
        "        _3 = const \"hi\" #18:16 s3;",
        "        live(_4) #19:10 s4;",
        "        _4 = copy _1 #19:14 s4;",
        "        live(_5) #20:10 s5;",
        "        _9 = call fn main.mk() #20:21 s5;",
        "        _5 = aggregate node(move _9, copy _4.0) #20:14 s5;",
        "        _0 = aggregate node(move _2, const i32 0) #21:12 s6;",
        "        dead(_3) #21:5 s6;",
        "        dead(_4) #21:5 s6;",
        "        dead(_5) #21:5 s6;",
        "        return #21:5 s6;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "f"), want[..]);
    // `new(u8)` is an owning rvalue in a temporary, and it enters its field as `move _t`
    string[7] fresh = {
        "struct node {",
        "    u8 mut* own p;",
        "    i32 v;",
        "}",
        "fn g() node {",
        "    return node{new(u8), 0};",
        "}",
    };
    string[10] allocated = {
        "fn main.g() -> node {",
        "    let _0: node;",
        "    let _1: u8 mut* own #6:17;",
        "",
        "    bb0: {",
        "        _1 = alloc<u8>(const u64 1) #6:17 s1;",
        "        _0 = aggregate node(move _1, const i32 0) #6:12 s1;",
        "        return #6:5 s1;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, fresh[..], "g"), allocated[..]);
}

// `box{}` of a struct that owns is `const zero box`, which fills an owning place (rule V6).
fn an_empty_literal_of_an_owning_struct() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[18] source = {
        "enum color {",
        "    red,",
        "    green,",
        "}",
        "struct box {",
        "    u8 mut@ own data;",
        "}",
        "fn make() box {",
        "    return box{};",
        "}",
        "fn f(bool c, u8 mut@ own s, u8@ v, box mut b) u8@ {",
        "    color k = {};",
        "    box m = move(b);",
        "    box r = make();",
        "    u8@ w = c ? v : cast(s, u8@);",
        "    string t = cast(v, string);",
        "    return w;",
        "}",
    };
    string[8] want = {
        "fn main.make() -> box {",
        "    let _0: box;",
        "",
        "    bb0: {",
        "        _0 = const zero box #9:12 s1;",
        "        return #9:5 s1;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "make"), want[..]);
}

// `{}` of an enum is `const zero color`. `move(b)` of an owning struct is `dst = move p`, a call
// with an aggregate result writes its destination, each arm of an aggregate `?:` writes the
// destination, and a cast between aggregate types writes it too (D3.14): the cast of the owning
// `s` to `u8@` lends it.
fn a_move_a_call_a_conditional_and_a_cast() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[18] source = {
        "enum color {",
        "    red,",
        "    green,",
        "}",
        "struct box {",
        "    u8 mut@ own data;",
        "}",
        "fn make() box {",
        "    return box{};",
        "}",
        "fn f(bool c, u8 mut@ own s, u8@ v, box mut b) u8@ {",
        "    color k = {};",
        "    box m = move(b);",
        "    box r = make();",
        "    u8@ w = c ? v : cast(s, u8@);",
        "    string t = cast(v, string);",
        "    return w;",
        "}",
    };
    string[38] want = {
        "fn main.f(_1 (c): bool, _2 (s): u8 mut@ own, _3 (v): u8@, _4 (b): box) -> u8@ {",
        "    let _0: u8@;",
        "    let _5 (k): color #12:11;",
        "    let _6 (m): box #13:9;",
        "    let _7 (r): box #14:9;",
        "    let _8 (w): u8@ #15:9;",
        "    let _9 (t): string #16:12;",
        "",
        "    bb0: {",
        "        live(_5) #12:11 s1;",
        "        _5 = const zero color #12:15 s1;",
        "        live(_6) #13:9 s2;",
        "        _6 = move _4 #13:17 s2;",
        "        live(_7) #14:9 s3;",
        "        _7 = call fn main.make() #14:17 s3;",
        "        live(_8) #15:9 s4;",
        "        switch(copy _1) -> [true: bb1, otherwise: bb2] #15:15 s4;",
        "    }",
        "    bb1: {",
        "        _8 = copy _3 #15:17 s4;",
        "        goto bb3 #15:15 s4;",
        "    }",
        "    bb2: {",
        "        _8 = cast<u8@>(copy _2) #15:21 s4;",
        "        goto bb3 #15:15 s4;",
        "    }",
        "    bb3: {",
        "        live(_9) #16:12 s5;",
        "        _9 = cast<string>(copy _3) #16:16 s5;",
        "        _0 = copy _8 #17:12 s6;",
        "        dead(_5) #17:5 s6;",
        "        dead(_6) #17:5 s6;",
        "        dead(_7) #17:5 s6;",
        "        dead(_8) #17:5 s6;",
        "        dead(_9) #17:5 s6;",
        "        return #17:5 s6;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "f"), want[..]);
}

// A member of an aggregate type is a place: a parameter as it stands, and a nested literal in a
// temporary first. A string constant and `{}` stand as constants, as the `const zero` of a field
// that a designated literal leaves out does (spec/fir.md 9.4).
fn a_member_of_an_aggregate_type() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[17] source = {
        "struct point {",
        "    i32 x;",
        "    i32 y;",
        "}",
        "struct line {",
        "    point a;",
        "    point b;",
        "    string name;",
        "}",
        "fn f(point p, string s) line {",
        "    line l = line{p, point{1, 2}, \"ab\"};",
        "    point[2] q = {p, {}};",
        "    return line{.b = l.a, .name = s};",
        "}",
        "fn g(point p) line {",
        "    return line{point{}, p, \"\"};",
        "}",
    };
    string[18] want = {
        "fn main.f(_1 (p): point, _2 (s): string) -> line {",
        "    let _0: line;",
        "    let _3 (l): line #11:10;",
        "    let _4 (q): point[2] #12:14;",
        "    let _5: point #11:22;",
        "",
        "    bb0: {",
        "        live(_3) #11:10 s1;",
        "        _5 = aggregate point(const i32 1, const i32 2) #11:22 s1;",
        "        _3 = aggregate line(copy _1, copy _5, const \"ab\") #11:14 s1;",
        "        live(_4) #12:14 s2;",
        "        _4 = aggregate point[2](copy _1, const zero point) #12:18 s2;",
        "        _0 = aggregate zeroed line(const zero point, copy _3.0, copy _2) #13:12 s3;",
        "        dead(_3) #13:5 s3;",
        "        dead(_4) #13:5 s3;",
        "        return #13:5 s3;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "f"), want[..]);
}

// `point{}` and the empty string stand in the `aggregate` as constants too.
fn an_empty_member_is_a_constant() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[17] source = {
        "struct point {",
        "    i32 x;",
        "    i32 y;",
        "}",
        "struct line {",
        "    point a;",
        "    point b;",
        "    string name;",
        "}",
        "fn f(point p, string s) line {",
        "    line l = line{p, point{1, 2}, \"ab\"};",
        "    point[2] q = {p, {}};",
        "    return line{.b = l.a, .name = s};",
        "}",
        "fn g(point p) line {",
        "    return line{point{}, p, \"\"};",
        "}",
    };
    string[8] want = {
        "fn main.g(_1 (p): point) -> line {",
        "    let _0: line;",
        "",
        "    bb0: {",
        "        _0 = aggregate line(const zero point, copy _1, const \"\") #16:12 s1;",
        "        return #16:5 s1;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "g"), want[..]);
}

// Each arm of an aggregate `?:` writes its literal into the destination, the checked `k + 1` of the
// second arm in a continuation block that the arm makes after `done` (spec/fir.md 9.4).
fn each_arm_of_a_conditional_is_a_literal() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[7] source = {
        "struct pair {",
        "    i32 a;",
        "    i32 b;",
        "}",
        "fn f(bool c, i32 k) pair {",
        "    return c ? pair{1, k} : pair{k + 1, 2};",
        "}",
    };
    string[25] want = {
        "fn main.f(_1 (c): bool, _2 (k): i32) -> pair {",
        "    let _0: pair;",
        "    let _3: bool #6:36;",
        "    let _4: i32 #6:36;",
        "",
        "    bb0: {",
        "        switch(copy _1) -> [true: bb1, otherwise: bb2] #6:14 s1;",
        "    }",
        "    bb1: {",
        "        _0 = aggregate pair(const i32 1, copy _2) #6:16 s1;",
        "        goto bb3 #6:14 s1;",
        "    }",
        "    bb2: {",
        "        _3 = add_overflows(copy _2, const i32 1) #6:36 s1;",
        "        check(copy _3, overflow) -> bb4 #6:36 s1;",
        "    }",
        "    bb3: {",
        "        return #6:5 s1;",
        "    }",
        "    bb4: {",
        "        _4 = add(copy _2, const i32 1) #6:36 s1;",
        "        _0 = aggregate pair(copy _4, const i32 2) #6:29 s1;",
        "        goto bb3 #6:14 s1;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "f"), want[..]);
}

// A whole function: `v->items[v->len] = x` checks the index against field 1 of the span that field
// 0 of `*v` holds, and writes in place, since the right side holds no writer; `v->len += 1` reads
// the old length first.
fn a_push_through_a_pointer() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[8] source = {
        "struct vec {",
        "    i32 mut@ own items;",
        "    u64 len;",
        "}",
        "fn push(vec mut* v, i32 x) void {",
        "    v->items[v->len] = x;",
        "    v->len += 1;",
        "}",
    };
    string[25] want = {
        "fn main.push(_1 (v): vec mut*, _2 (x): i32) -> void {",
        "    let _0: void;",
        "    let _3: u64 #6:13;",
        "    let _4: bool #6:13;",
        "    let _5: i64 #6:13;",
        "    let _6: u64 #7:6;",
        "    let _7: bool #7:12;",
        "",
        "    bb0: {",
        "        _3 = cast<u64>(copy (*_1).1) #6:13 s1;",
        "        _4 = ge(copy _3, copy (*_1).0.1) #6:13 s1;",
        "        _5 = cast<i64>(copy _3) #6:13 s1;",
        "        check(copy _4, bounds, copy _5, copy (*_1).0.1) -> bb1 #6:13 s1;",
        "    }",
        "    bb1: {",
        "        (*_1).0[_3] = copy _2 #6:22 s1;",
        "        _6 = copy (*_1).1 #7:6 s2;",
        "        _7 = add_overflows(copy _6, const u64 1) #7:12 s2;",
        "        check(copy _7, overflow) -> bb2 #7:12 s2;",
        "    }",
        "    bb2: {",
        "        (*_1).1 = add(copy _6, const u64 1) #7:12 s2;",
        "        return #8:1 s0;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "push"), want[..]);
}

// A whole function: `a[i] = a[j]` checks the index of its target before the index of its value
// (D6.3), and each element of the span is read at the statement that uses it.
fn a_swap_checks_the_target_first() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[5] source = {
        "fn swap(i32 mut@ a, u64 i, u64 j) void {",
        "    i32 t = a[i];",
        "    a[i] = a[j];",
        "    a[j] = t;",
        "}",
    };
    string[49] want = {
        "fn main.swap(_1 (a): i32 mut@, _2 (i): u64, _3 (j): u64) -> void {",
        "    let _0: void;",
        "    let _4 (t): i32 #2:9;",
        "    let _5: u64 #2:14;",
        "    let _6: bool #2:14;",
        "    let _7: i64 #2:14;",
        "    let _8: u64 #3:6;",
        "    let _9: bool #3:6;",
        "    let _10: i64 #3:6;",
        "    let _11: u64 #3:13;",
        "    let _12: bool #3:13;",
        "    let _13: i64 #3:13;",
        "    let _14: u64 #4:6;",
        "    let _15: bool #4:6;",
        "    let _16: i64 #4:6;",
        "",
        "    bb0: {",
        "        live(_4) #2:9 s1;",
        "        _5 = cast<u64>(copy _2) #2:14 s1;",
        "        _6 = ge(copy _5, copy _1.1) #2:14 s1;",
        "        _7 = cast<i64>(copy _5) #2:14 s1;",
        "        check(copy _6, bounds, copy _7, copy _1.1) -> bb1 #2:14 s1;",
        "    }",
        "    bb1: {",
        "        _4 = copy _1[_5] #2:14 s1;",
        "        _8 = cast<u64>(copy _2) #3:6 s2;",
        "        _9 = ge(copy _8, copy _1.1) #3:6 s2;",
        "        _10 = cast<i64>(copy _8) #3:6 s2;",
        "        check(copy _9, bounds, copy _10, copy _1.1) -> bb2 #3:6 s2;",
        "    }",
        "    bb2: {",
        "        _11 = cast<u64>(copy _3) #3:13 s2;",
        "        _12 = ge(copy _11, copy _1.1) #3:13 s2;",
        "        _13 = cast<i64>(copy _11) #3:13 s2;",
        "        check(copy _12, bounds, copy _13, copy _1.1) -> bb3 #3:13 s2;",
        "    }",
        "    bb3: {",
        "        _1[_8] = copy _1[_11] #3:10 s2;",
        "        _14 = cast<u64>(copy _3) #4:6 s3;",
        "        _15 = ge(copy _14, copy _1.1) #4:6 s3;",
        "        _16 = cast<i64>(copy _14) #4:6 s3;",
        "        check(copy _15, bounds, copy _16, copy _1.1) -> bb4 #4:6 s3;",
        "    }",
        "    bb4: {",
        "        _1[_14] = copy _4 #4:10 s3;",
        "        dead(_4) #5:1 s0;",
        "        return #5:1 s0;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "swap"), want[..]);
}

// `r.hi.x` is field 0 of field 1 of `r`, one place with two projections.
fn a_field_of_a_field() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[16] source = {
        "struct point {",
        "    i32 x;",
        "    i32 y;",
        "}",
        "struct rect {",
        "    point lo;",
        "    point hi;",
        "}",
        "fn width(rect r) i32 {",
        "    return r.hi.x - r.lo.x;",
        "}",
        "fn grow(rect mut r, i32 d) rect {",
        "    r.hi.x += d;",
        "    r.lo = point{r.lo.x - d, r.lo.y};",
        "    return rect{.hi = r.hi, .lo = r.lo};",
        "}",
    };
    string[15] want = {
        "fn main.width(_1 (r): rect) -> i32 {",
        "    let _0: i32;",
        "    let _2: bool #10:19;",
        "    let _3: i32 #10:19;",
        "",
        "    bb0: {",
        "        _2 = sub_overflows(copy _1.1.0, copy _1.0.0) #10:19 s1;",
        "        check(copy _2, overflow) -> bb1 #10:19 s1;",
        "    }",
        "    bb1: {",
        "        _3 = sub(copy _1.1.0, copy _1.0.0) #10:19 s1;",
        "        _0 = copy _3 #10:19 s1;",
        "        return #10:5 s1;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "width"), want[..]);
}

// A whole function: a compound assignment into a field of a field, a literal into a field whose
// member reads the field it replaces, and a designated literal of two aggregate members.
fn a_rect_grows_in_place() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[16] source = {
        "struct point {",
        "    i32 x;",
        "    i32 y;",
        "}",
        "struct rect {",
        "    point lo;",
        "    point hi;",
        "}",
        "fn width(rect r) i32 {",
        "    return r.hi.x - r.lo.x;",
        "}",
        "fn grow(rect mut r, i32 d) rect {",
        "    r.hi.x += d;",
        "    r.lo = point{r.lo.x - d, r.lo.y};",
        "    return rect{.hi = r.hi, .lo = r.lo};",
        "}",
    };
    string[24] want = {
        "fn main.grow(_1 (r): rect, _2 (d): i32) -> rect {",
        "    let _0: rect;",
        "    let _3: i32 #13:9;",
        "    let _4: bool #13:12;",
        "    let _5: bool #14:25;",
        "    let _6: i32 #14:25;",
        "",
        "    bb0: {",
        "        _3 = copy _1.1.0 #13:9 s1;",
        "        _4 = add_overflows(copy _3, copy _2) #13:12 s1;",
        "        check(copy _4, overflow) -> bb1 #13:12 s1;",
        "    }",
        "    bb1: {",
        "        _1.1.0 = add(copy _3, copy _2) #13:12 s1;",
        "        _5 = sub_overflows(copy _1.0.0, copy _2) #14:25 s2;",
        "        check(copy _5, overflow) -> bb2 #14:25 s2;",
        "    }",
        "    bb2: {",
        "        _6 = sub(copy _1.0.0, copy _2) #14:25 s2;",
        "        _1.0 = aggregate point(copy _6, copy _1.0.1) #14:12 s2;",
        "        _0 = aggregate zeroed rect(copy _1.0, copy _1.1) #15:12 s3;",
        "        return #15:5 s3;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "grow"), want[..]);
}

// The source of the two tests below: `inner` has padding, `pair` has none.
string[30] MEMBERS = {
    "struct inner {",
    "    u8 a;",
    "    i64 b;",
    "}",
    "struct pair {",
    "    i64 a;",
    "    i64 b;",
    "}",
    "struct outer {",
    "    inner i;",
    "    pair p;",
    "    inner[2] two;",
    "}",
    "fn make(i64 n) inner {",
    "    return inner{1, n};",
    "}",
    "fn wrap(inner x) inner {",
    "    return x;",
    "}",
    "fn couple() pair {",
    "    return pair{1, 2};",
    "}",
    "fn f(bool c, i64 n) outer {",
    "    outer o = outer{.i = make(n), .p = couple(),",
    "        .two = {inner{2, n}, c ? make(n) : inner{.a = 3}}};",
    "    return outer{.i = wrap(inner{4, n}), .p = o.p};",
    "}",
    "fn g(i64 n) outer {",
    "    return outer{make(n), pair{1, 2}, {inner{.a = 5}, {}}};",
    "}",
};

// A member of a literal that the lowering builds in a new temporary of a type with padding starts
// as `const zero`, so that its copy writes zero padding into the zeroed field of a designated
// literal (D6.5). The rule reaches a nested literal,
// a conditional and the result of a call, and it skips a type with no padding (`pair`), a
// designated literal, which zeroes itself, and the argument of a call (`_10`).
fn a_designated_member_starts_zeroed() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[41] want = {
        "fn main.f(_1 (c): bool, _2 (n): i64) -> outer {",
        "    let _0: outer;",
        "    let _3 (o): outer #24:11;",
        "    let _4: inner #24:30;",
        "    let _5: pair #24:46;",
        "    let _6: inner[2] #25:16;",
        "    let _7: inner #25:17;",
        "    let _8: inner #25:32;",
        "    let _9: inner #26:27;",
        "    let _10: inner #26:28;",
        "",
        "    bb0: {",
        "        live(_3) #24:11 s1;",
        "        _4 = const zero inner #24:30 s1;",
        "        _4 = call fn main.make(copy _2) #24:30 s1;",
        "        _5 = call fn main.couple() #24:46 s1;",
        "        _6 = const zero inner[2] #25:16 s1;",
        "        _7 = const zero inner #25:17 s1;",
        "        _7 = aggregate inner(const u8 2, copy _2) #25:17 s1;",
        "        _8 = const zero inner #25:32 s1;",
        "        switch(copy _1) -> [true: bb1, otherwise: bb2] #25:32 s1;",
        "    }",
        "    bb1: {",
        "        _8 = call fn main.make(copy _2) #25:38 s1;",
        "        goto bb3 #25:32 s1;",
        "    }",
        "    bb2: {",
        "        _8 = aggregate zeroed inner(const u8 3, const zero i64) #25:44 s1;",
        "        goto bb3 #25:32 s1;",
        "    }",
        "    bb3: {",
        "        _6 = aggregate inner[2](copy _7, copy _8) #25:16 s1;",
        "        _3 = aggregate zeroed outer(copy _4, copy _5, copy _6) #24:15 s1;",
        "        _9 = const zero inner #26:27 s2;",
        "        _10 = aggregate inner(const u8 4, copy _2) #26:28 s2;",
        "        _9 = call fn main.wrap(copy _10) #26:27 s2;",
        "        _0 = aggregate zeroed outer(copy _9, copy _3.1, const zero inner[2]) #26:12 s2;",
        "        dead(_3) #26:5 s2;",
        "        return #26:5 s2;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, MEMBERS[..], "f"), want[..]);
}

// A member of a positional literal starts zeroed too. Its destination can be a field whose
// padding the caller zeroed: a designated literal whose member is
// `g(n)` passes a zeroed field as the `sret` pointer of `g`. A designated member, `_5`, zeroes
// itself and takes no zero first.
fn a_positional_member_starts_zeroed() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[18] want = {
        "fn main.g(_1 (n): i64) -> outer {",
        "    let _0: outer;",
        "    let _2: inner #29:22;",
        "    let _3: pair #29:27;",
        "    let _4: inner[2] #29:39;",
        "    let _5: inner #29:40;",
        "",
        "    bb0: {",
        "        _2 = const zero inner #29:22 s1;",
        "        _2 = call fn main.make(copy _1) #29:22 s1;",
        "        _3 = aggregate pair(const i64 1, const i64 2) #29:27 s1;",
        "        _4 = const zero inner[2] #29:39 s1;",
        "        _5 = aggregate zeroed inner(const u8 5, const zero i64) #29:40 s1;",
        "        _4 = aggregate inner[2](copy _5, const zero inner) #29:39 s1;",
        "        _0 = aggregate outer(copy _2, copy _3, copy _4) #29:12 s1;",
        "        return #29:5 s1;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, MEMBERS[..], "g"), want[..]);
}

// Tail padding counts: `tail` is i64 then u8, so the result of `mk_tail()` starts as `const
// zero`. A cast copies the whole value, so its own temporary `_1` needs no zero. `packed` and
// `string` have no padding, so their temporaries start as they are.
fn a_member_with_tail_padding_starts_zeroed() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[27] source = {
        "struct tail {",
        "    i64 a;",
        "    u8 b;",
        "}",
        "struct packed {",
        "    u8 a;",
        "    u8 b;",
        "    u16 c;",
        "    u32 d;",
        "}",
        "struct both {",
        "    tail t;",
        "    packed p;",
        "    string s;",
        "}",
        "fn mk_tail() tail {",
        "    return tail{1, 2};",
        "}",
        "fn mk_packed() packed {",
        "    return packed{1, 2, 3, 4};",
        "}",
        "fn name() string {",
        "    return \"n\";",
        "}",
        "fn h() both {",
        "    return both{.t = cast(mk_tail(), tail), .p = mk_packed(), .s = name()};",
        "}",
    };
    string[17] want = {
        "fn main.h() -> both {",
        "    let _0: both;",
        "    let _1: tail #26:22;",
        "    let _2: tail #26:34;",
        "    let _3: packed #26:59;",
        "    let _4: string #26:72;",
        "",
        "    bb0: {",
        "        _2 = const zero tail #26:34 s1;",
        "        _2 = call fn main.mk_tail() #26:34 s1;",
        "        _1 = cast<tail>(copy _2) #26:22 s1;",
        "        _3 = call fn main.mk_packed() #26:59 s1;",
        "        _4 = call fn main.name() #26:72 s1;",
        "        _0 = aggregate zeroed both(copy _1, copy _3, copy _4) #26:12 s1;",
        "        return #26:5 s1;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "h"), want[..]);
}

fn main() i32 {
    a_literal_is_one_aggregate();
    a_designated_literal_runs_in_source_order();
    a_literal_reads_its_destination_first();
    a_designated_member_starts_zeroed();
    a_positional_member_starts_zeroed();
    a_member_with_tail_padding_starts_zeroed();
    println("literal ok");
    each_arm_of_a_conditional_is_a_literal();
    an_empty_literal_of_an_owning_struct();
    a_move_a_call_a_conditional_and_a_cast();
    println("owning ok");
    a_member_of_an_aggregate_type();
    an_empty_member_is_a_constant();
    println("place ok");
    a_push_through_a_pointer();
    a_swap_checks_the_target_first();
    a_field_of_a_field();
    a_rect_grows_in_place();
    println("whole ok");
    return 0;
}
