//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: fir_lower.scope_pop: no open scope
//! stdout:
//| 0
/// Each scope_pop closes a scope that scope_push opened. A lowerer with no open scope breaks
/// that precondition, so the call panics.
import fort.ast;
import fort.fir;
import fort.fir_lower;
import lower_env;

fn main() i32 {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[2] source = {
        "fn f() void {",
        "}",
    };
    lower_env.check_lines(&e, source[..], true);
    pop_with_no_scope(&e);
    return 0;
}

// Lowers `f` up to a scope_pop with no open scope. The function takes the environment as a
// parameter, so the reads through `decl` use no owner of its frame (D17.21).
fn pop_with_no_scope(lower_env.env mut* e) void {
    ast.node* decl = lower_env.decl(e, "f");
    fir.func mut f = fir.func_new(&e->c.ck.types, decl->sym, decl->sym->ty);
    defer fir.func_free(&f);
    fir_lower.lowerer mut lw = fir_lower.lowerer{.ck = &e->c.ck, .f = &f};
    defer fir_lower.scopes_free(&lw.scopes);
    fir_lower.prescan(&f, decl->b);
    println(lw.scopes.len);
    fir_lower.scope_pop(&lw);
}
