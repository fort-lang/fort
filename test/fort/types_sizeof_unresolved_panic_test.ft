//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: types: sizeof of a struct without layout
//! stdout:
//| 8
/// A struct answers sizeof from its layout, so asking before the checker has
/// laid it out is a broken precondition.
import types;
import types_env;

fn main() i32 {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    println(types.type_sizeof(e.point));
    println(types.type_sizeof(e.rec));
    return 0;
}
