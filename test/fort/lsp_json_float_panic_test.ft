//! run
//! flags: -I ../../src/fort -I support -I ../../src
//! abort
//! stderr: panic: json.float_of: not a number
//! stdout:
//| the numbers ok
import lsp.json;

/// float_of answers the binary64 bits of a number of either kind. A string
/// that holds digits is a string, so asking it is a violated precondition and
/// panics.
fn main() i32 {
    json.doc mut d = json.create();
    defer json.free(&d);
    assert(json.parse(&d, "[1,1.5,\"1.5\"]"));
    u32 root = json.root(&d);
    assert(json.float_of(&d, json.at_of(&d, root, 0)) == 0x3ff0000000000000);
    assert(json.float_of(&d, json.at_of(&d, root, 1)) == 0x3ff8000000000000);
    println("the numbers ok");
    println(json.float_of(&d, json.at_of(&d, root, 2)));
    return 0;
}
