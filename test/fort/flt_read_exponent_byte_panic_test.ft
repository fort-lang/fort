//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: flt.read_exponent: the text is not a float literal
//! stdout:
//| 3
/// The lexer checks the shape of a float literal before read_exponent reads it. A letter in
/// the exponent breaks that precondition, so the call panics.
import flt;

fn main() i32 {
    flt.decimal mut d = flt.decimal{};
    flt.read_decimal("1e2", &d);
    println(d.point);
    flt.read_decimal("1e2x", &d);
    return 0;
}
