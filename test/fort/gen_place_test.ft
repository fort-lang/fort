//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| places ok
//| aggregates ok
//| ownership ok
//| ok
/// Checks the text that the FIR translator writes for places and aggregates: indexing, spans,
/// fields, initializers, and ownership operations.
import gen;
import gen_env;
import std.str;
import std.strbuf;

//
// Each case emits `main` through FIR (gen_env.main_text) and holds the lines of its expression in
// the definition, numbered as they stand there. Each failure call keeps the line and column that
// bootstrap-0 `fort -S` wrote for the same operator.

// A point, a value of it, a pointer to it and a read through each: the module
// the field assertions are made against. `p` is slot 0 and `q` slot 2.
fn open_point(gen_env.env mut* e) bool {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "struct point {\n    i32 x;\n    i32 y;\n}\n");
    strbuf.append(&b, "fn main() i32 {\n");
    strbuf.append(&b, "    point mut p = point{1, 2};\n");
    strbuf.append(&b, "    i32 mut c = p.x;\n");
    strbuf.append(&b, "    point mut* mut q = &p;\n");
    strbuf.append(&b, "    i32 mut d = q->y;\n");
    strbuf.append(&b, "    return 0;\n}\n");
    return gen_env.open_src(e, strbuf.view(&b));
}

string ARR = "    i32[3] mut arr = {1, 2, 3};";
string IDX = "    i32 mut i = 1;";

// ---- the index ------------------------------------------------------------------------

fn an_index_into_an_array_is_checked_against_its_written_length() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    string[3] mut lines = {ARR, IDX, "    i32 mut a = arr[i];"};
    assert(gen_env.open_lines(&e, lines[..]));
    // the index is extended by its own signedness, so a negative one
    // fails the same unsigned compare, and a fixed array's length is a
    // literal.
    string[8] want = {
        "  %t3 = load i32, ptr %i.1, align 4\n",
        "  %t4 = sext i32 %t3 to i64\n",
        "  %t5 = icmp uge i64 %t4, 3\n",
        "  br i1 %t5, label %L2, label %L1\n",
        "\n",
        "L1:\n",
        "  %t6 = getelementptr inbounds [3 x i32], ptr %arr.0, i64 0, i64 %t4\n",
        "  %t7 = load i32, ptr %t6, align 4\n",
    };
    string got = gen_env.main_text(&e);
    gen_env.expect_in(got, gen_env.join_lines(&e, want[..]));
    gen_env.expect_in(
        got, gen_env.join4(&e, "L2:\n",
                           "  call void @\"std.rt.fail_bounds\"(i64 %t4, i64 3, ptr @.file.0, ",
                           "i32 4, i32 20)\n", "  unreachable\n"));
}

fn an_index_into_a_span_reads_the_length_out_of_its_header() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    string[4] mut lines = {ARR, IDX, "    i32 mut@ mut sp = arr[..];", "    i32 mut b = sp[i];"};
    assert(gen_env.open_lines(&e, lines[..]));
    // a span's elements are reached through its `.ptr`, and its
    // length is the header field the check compares against. The check reads
    // the length once more as the operand it reports.
    string[14] want = {
        "  %t10 = load i32, ptr %i.1, align 4\n",
        "  %t11 = sext i32 %t10 to i64\n",
        "  %t12 = getelementptr inbounds %fort.span, ptr %sp.2, i32 0, i32 1\n",
        "  %t13 = load i64, ptr %t12, align 8\n",
        "  %t14 = icmp uge i64 %t11, %t13\n",
        "  %t15 = getelementptr inbounds %fort.span, ptr %sp.2, i32 0, i32 1\n",
        "  %t16 = load i64, ptr %t15, align 8\n",
        "  br i1 %t14, label %L4, label %L2\n",
        "\n",
        "L2:\n",
        "  %t17 = getelementptr inbounds %fort.span, ptr %sp.2, i32 0, i32 0\n",
        "  %t18 = load ptr, ptr %t17, align 8\n",
        "  %t19 = getelementptr inbounds i32, ptr %t18, i64 %t11\n",
        "  %t20 = load i32, ptr %t19, align 4\n",
    };
    string got = gen_env.main_text(&e);
    gen_env.expect_in(got, gen_env.join_lines(&e, want[..]));
    gen_env.expect_in(
        got, gen_env.join2(&e, "  call void @\"std.rt.fail_bounds\"(i64 %t11, i64 %t16, ",
                           "ptr @.file.0, i32 5, i32 19)\n"));
}

fn no_bounds_check_removes_the_branch_and_nothing_else() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open_with(&e, gen.gen_options{false, true, ""});
    defer gen_env.close(&e);
    string[3] mut lines = {ARR, IDX, "    i32 mut a = arr[i];"};
    assert(gen_env.open_lines(&e, lines[..]));
    // `--no-bounds-check` removes the index branch, and the element is
    // reached the same way.
    string got = gen_env.main_text(&e);
    gen_env.expect_in(
        got, gen_env.join4(&e, "  %t3 = load i32, ptr %i.1, align 4\n",
                           "  %t4 = sext i32 %t3 to i64\n",
                           "  %t5 = getelementptr inbounds [3 x i32], ptr %arr.0, i64 0, i64 %t4\n",
                           "  %t6 = load i32, ptr %t5, align 4\n"));
    assert(str.find(got, "br i1") < 0);
    assert(str.find(got, "fail_bounds") < 0);
}

// ---- span expressions --------------------------------------------------------------------

fn a_span_of_an_array_checks_both_bounds_in_one_branch() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    string[3] mut lines = {ARR, IDX, "    i32 mut@ mut sp = arr[..];"};
    assert(gen_env.open_lines(&e, lines[..]));
    // `0 <= lo <= hi <= len` in one branch, both compares unsigned,
    // and an absent low bound is zero and an absent high one the length.
    string[12] want = {
        "  %t3 = icmp ugt i64 0, 3\n",
        "  %t4 = icmp ugt i64 3, 3\n",
        "  %t5 = or i1 %t3, %t4\n",
        "  br i1 %t5, label %L2, label %L1\n",
        "\n",
        "L1:\n",
        "  %t6 = getelementptr inbounds [3 x i32], ptr %arr.0, i64 0, i64 0\n",
        "  %t7 = sub i64 3, 0\n",
        "  %t8 = getelementptr inbounds %fort.span, ptr %sp.2, i32 0, i32 0\n",
        "  store ptr %t6, ptr %t8, align 8\n",
        "  %t9 = getelementptr inbounds %fort.span, ptr %sp.2, i32 0, i32 1\n",
        "  store i64 %t7, ptr %t9, align 8\n",
    };
    string got = gen_env.main_text(&e);
    gen_env.expect_in(got, gen_env.join_lines(&e, want[..]));
    gen_env.expect_in(
        got, gen_env.join4(&e, "L2:\n",
                           "  call void @\"std.rt.fail_span\"(i64 0, i64 3, i64 3, ptr @.file.0, ",
                           "i32 4, i32 26)\n", "  unreachable\n"));
}

// ---- fields and pseudo fields --------------------------------------------------------------

fn a_field_of_a_value_and_a_field_behind_a_pointer_are_one_shape() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    assert(open_point(&e));
    // `p->f` is `(*p).f`, so the pointer is loaded first and the same shape
    // follows.
    string[8] want = {
        "  %t2 = getelementptr inbounds %struct.main.point, ptr %p.0, i32 0, i32 0\n",
        "  %t3 = load i32, ptr %t2, align 4\n",
        "  store i32 %t3, ptr %c.1, align 4\n",
        "  store ptr %p.0, ptr %q.2, align 8\n",
        "  %t4 = load ptr, ptr %q.2, align 8\n",
        "  %t5 = getelementptr inbounds %struct.main.point, ptr %t4, i32 0, i32 1\n",
        "  %t6 = load i32, ptr %t5, align 4\n",
        "  store i32 %t6, ptr %d.3, align 4\n",
    };
    gen_env.expect_in(gen_env.main_text(&e), gen_env.join_lines(&e, want[..]));
}

fn the_pseudo_fields_of_a_span_are_its_header_fields() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    string[4] mut lines = {ARR, IDX, "    i32 mut@ mut sp = arr[..];", "    u64 mut n = sp.len;"};
    assert(gen_env.open_lines(&e, lines[..]));
    // `.len` and `.ptr` are the two header fields and not a load of a struct
    // member the user declared.
    gen_env.expect_in(
        gen_env.main_text(&e),
        gen_env.join3(&e,
                      "  %t10 = getelementptr inbounds %fort.span, ptr %sp.2, i32 0, i32 1\n",
                      "  %t11 = load i64, ptr %t10, align 8\n",
                      "  store i64 %t11, ptr %n.3, align 8\n"));
}

// ---- the initializers ---------------------------------------------------------------------

fn a_positional_struct_literal_writes_its_members_in_field_order() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    assert(open_point(&e));
    // The four walks that count field declarations must agree, so the
    // literal's members land at the indices the named type wrote.
    gen_env.expect_in(
        gen_env.main_text(&e),
        gen_env.join4(&e,
                      "  %t0 = getelementptr inbounds %struct.main.point, ptr %p.0, i32 0, i32 0\n",
                      "  store i32 1, ptr %t0, align 4\n",
                      "  %t1 = getelementptr inbounds %struct.main.point, ptr %p.0, i32 0, i32 1\n",
                      "  store i32 2, ptr %t1, align 4\n"));
}

fn a_designated_literal_zeroes_the_place_first() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "struct point {\n    i32 x;\n    i32 y;\n}\n");
    strbuf.append(&b, "fn main() i32 {\n    point mut z = point{.y = 5};\n");
    strbuf.append(&b, "    i32[2] mut arr = {};\n    return 0;\n}\n");
    assert(gen_env.open_src(&e, strbuf.view(&b)));
    // Omitted fields are zeroed, so the designated form memsets the place
    // before it writes the members it names.
    gen_env.expect_in(
        gen_env.main_text(&e),
        gen_env.join3(&e,
                      "  call void @llvm.memset.p0.i64(ptr align 4 %z.0, i8 0, i64 8, i1 false)\n",
                      "  %t0 = getelementptr inbounds %struct.main.point, ptr %z.0, i32 0, i32 1\n",
                      "  store i32 5, ptr %t0, align 4\n"));
    // `{}` is the zero value of the type, whatever the type is.
    gen_env.expect_in(
        gen_env.main_text(&e),
        "  call void @llvm.memset.p0.i64(ptr align 4 %arr.1, i8 0, i64 8, i1 false)\n");
}

fn an_array_literal_writes_one_element_at_a_time() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    string[2] mut lines = {ARR, IDX};
    assert(gen_env.open_lines(&e, lines[..]));
    // the array shape, with the element index a literal.
    gen_env.expect_in(
        gen_env.main_text(&e),
        gen_env.join6(&e,
                      "  %t0 = getelementptr inbounds [3 x i32], ptr %arr.0, i64 0, i64 0\n",
                      "  store i32 1, ptr %t0, align 4\n",
                      "  %t1 = getelementptr inbounds [3 x i32], ptr %arr.0, i64 0, i64 1\n",
                      "  store i32 2, ptr %t1, align 4\n",
                      "  %t2 = getelementptr inbounds [3 x i32], ptr %arr.0, i64 0, i64 2\n",
                      "  store i32 3, ptr %t2, align 4\n"));
}

fn a_string_value_is_its_two_header_fields() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    string[2] mut lines = {"    string mut s = \"hi\";", IDX};
    assert(gen_env.open_lines(&e, lines[..]));
    // The bytes and the length the trailing NUL excludes.
    gen_env.expect_in(
        gen_env.main_text(&e),
        gen_env.join4(&e,
                      "  %t0 = getelementptr inbounds %fort.span, ptr %s.0, i32 0, i32 0\n",
                      "  store ptr @.str.0, ptr %t0, align 8\n",
                      "  %t1 = getelementptr inbounds %fort.span, ptr %s.0, i32 0, i32 1\n",
                      "  store i64 2, ptr %t1, align 8\n"));
}

// ---- the ownership operations ----------------------------------------------------------------

// The module the ownership assertions are made against: `p` is slot 0, `s`
// slot 1, `t` slot 2 and `u` slot 3. And the three `del` statements are
// statements 3, 4 and 5 of the body.
fn open_own(gen_env.env mut* e) bool {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "fn main() i32 {\n");
    strbuf.append(&b, "    i32 mut* own mut p = new(i32);\n");
    strbuf.append(&b, "    i32 mut@ own mut s = new(i32, 3);\n");
    strbuf.append(&b, "    i32 mut@ own mut t = move(s);\n");
    strbuf.append(&b, "    del(p);\n");
    strbuf.append(&b, "    del(s);\n");
    strbuf.append(&b, "    del(new(i32));\n");
    strbuf.append(&b, "    i32 mut* own mut u = move(p);\n");
    strbuf.append(&b, "    return 0;\n}\n");
    return gen_env.open_src(e, strbuf.view(&b));
}

fn new_of_one_object_is_a_call_whose_result_is_an_ordinary_scalar() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    assert(open_own(&e));
    // The runtime zeroes the storage and never returns null, so the module
    // emits no test of the result. The position is the builtin's name.
    gen_env.expect_in(
        gen_env.main_text(&e),
        "  %t0 = call ptr @\"std.rt.alloc\"(i64 4, i64 1, ptr @.file.0, i32 2, i32 26)\n");
}

fn new_of_a_span_writes_the_header_it_allocated() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    assert(open_own(&e));
    // The count is an `i32` even when it is a literal, so it is widened to 64
    // bits and checked. The header is then written field by field into a
    // `%tmp` slot, which the overwrite check of `s` lets into `s`.
    string[18] want = {
        "  %t3 = sext i32 3 to i64\n",
        "  %t4 = icmp slt i64 %t3, 0\n",
        "  br i1 %t4, label %L7, label %L2\n",
        "\n",
        "L2:\n",
        "  %t5 = call ptr @\"std.rt.alloc\"(i64 4, i64 %t3, ptr @.file.0, i32 3, i32 26)\n",
        "  %t6 = getelementptr inbounds %fort.span, ptr %tmp0, i32 0, i32 0\n",
        "  store ptr %t5, ptr %t6, align 8\n",
        "  %t7 = getelementptr inbounds %fort.span, ptr %tmp0, i32 0, i32 1\n",
        "  store i64 %t3, ptr %t7, align 8\n",
        "  %t8 = getelementptr inbounds %fort.span, ptr %s.1, i32 0, i32 0\n",
        "  %t9 = load ptr, ptr %t8, align 8\n",
        "  %t10 = icmp ne ptr %t9, null\n",
        "  br i1 %t10, label %L8, label %L3\n",
        "\n",
        "L3:\n",
        "  call void @llvm.memcpy.p0.p0.i64(ptr align 8 %s.1, ptr align 8 %tmp0, ",
        "i64 16, i1 false)\n",
    };
    gen_env.expect_in(gen_env.main_text(&e), gen_env.join_lines(&e, want[..]));
}

fn an_unsigned_count_needs_no_branch_at_all() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    string[2] mut lines = {"    u64 mut m = 3;", "    i32 mut@ own mut s = new(i32, m);"};
    assert(gen_env.open_lines(&e, lines[..]));
    // An unsigned count is never negative. So the check is on the signed path
    // alone and the width already agrees, so nothing widens it either (item
    // 9). The one branch is the overwrite check of `s`.
    string[6] want = {
        "  %t0 = load i64, ptr %m.0, align 8\n",
        "  %t1 = call ptr @\"std.rt.alloc\"(i64 4, i64 %t0, ptr @.file.0, i32 3, i32 26)\n",
        "  %t2 = getelementptr inbounds %fort.span, ptr %tmp0, i32 0, i32 0\n",
        "  store ptr %t1, ptr %t2, align 8\n",
        "  %t3 = getelementptr inbounds %fort.span, ptr %tmp0, i32 0, i32 1\n",
        "  store i64 %t0, ptr %t3, align 8\n",
    };
    string got = gen_env.main_text(&e);
    gen_env.expect_in(got, gen_env.join_lines(&e, want[..]));
    assert(str.find(got, "icmp slt") < 0);
    assert(str.find(got, "fail_alloc_count") < 0);
}

fn a_negative_count_is_checked_and_the_check_survives_release_mode() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open_with(&e, gen.gen_options{true, true, ""});
    defer gen_env.close(&e);
    string[2] mut lines = {"    i32 mut n = 3;", "    i32 mut@ own mut s = new(i32, n);"};
    assert(gen_env.open_lines(&e, lines[..]));
    // It is not a bounds check, so neither `--release` nor
    // `--no-bounds-check` removes it, and it is reported with the signed
    // value the source wrote. Release mode has no overwrite check, so the
    // header goes straight into `s`.
    string[11] want = {
        "  %t0 = load i32, ptr %n.0, align 4\n",
        "  %t1 = sext i32 %t0 to i64\n",
        "  %t2 = icmp slt i64 %t1, 0\n",
        "  br i1 %t2, label %L2, label %L1\n",
        "\n",
        "L1:\n",
        "  %t3 = call ptr @\"std.rt.alloc\"(i64 4, i64 %t1, ptr @.file.0, i32 3, i32 26)\n",
        "  %t4 = getelementptr inbounds %fort.span, ptr %s.1, i32 0, i32 0\n",
        "  store ptr %t3, ptr %t4, align 8\n",
        "  %t5 = getelementptr inbounds %fort.span, ptr %s.1, i32 0, i32 1\n",
        "  store i64 %t1, ptr %t5, align 8\n",
    };
    string got = gen_env.main_text(&e);
    gen_env.expect_in(got, gen_env.join_lines(&e, want[..]));
    gen_env.expect_in(
        got, gen_env.join4(&e, "L2:\n",
                           "  call void @\"std.rt.fail_alloc_count\"(i64 %t1, ptr @.file.0, ",
                           "i32 3, i32 26)\n", "  unreachable\n"));
}

fn del_of_an_lvalue_frees_the_pointer_and_empties_the_storage() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    assert(open_own(&e));
    // The emptying is not an assignment and carries no overwrite check, which
    // is what makes `del(v); v = new(...)` pass one.
    gen_env.expect_in(gen_env.main_text(&e),
                      gen_env.join4(&e, "  %t14 = load ptr, ptr %p.0, align 8\n",
                                    "  call void @\"std.rt.free\"(ptr %t14)\n",
                                    "  store ptr null, ptr %p.0, align 8\n",
                                    "  %t15 = getelementptr inbounds %fort.span, ptr %s.1, "));
}

fn move_of_an_aggregate_goes_through_an_intermediate() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    assert(open_own(&e));
    // The destination may be the operand itself and nothing here can tell. The value is read
    // into a place of the emitter's own and the operand is emptied before it is handed on, here
    // into the slot that the overwrite check of `t` lets into `t`.
    string got = gen_env.main_text(&e);
    gen_env.expect_in(got, "  %tmp2 = alloca %fort.span, align 8\n");
    string[5] want = {
        "  call void @llvm.memcpy.p0.p0.i64(ptr align 8 %tmp2, ptr align 8 %s.1, i64 16, ",
        "i1 false)\n",
        "  call void @llvm.memset.p0.i64(ptr align 8 %s.1, i8 0, i64 16, i1 false)\n",
        "  call void @llvm.memcpy.p0.p0.i64(ptr align 8 %tmp1, ptr align 8 %tmp2, i64 16, ",
        "i1 false)\n",
    };
    gen_env.expect_in(got, gen_env.join_lines(&e, want[..]));
    gen_env.expect_in(
        got, "  call void @llvm.memcpy.p0.p0.i64(ptr align 8 %t.2, ptr align 8 %tmp1, i64 16, ");
}

fn an_arrow_reaches_the_header_the_pointer_points_at() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    string[3] mut lines = {"    string mut s = \"hi\";", "    string mut* mut q = &s;",
                           "    u64 mut n = q->len;"};
    assert(gen_env.open_lines(&e, lines[..]));
    // `p->f` is `(*p).f`, so the pointer is loaded and the header field is
    // read where it reaches. The `.len` is that field and not a member the
    // user declared.
    gen_env.expect_in(
        gen_env.main_text(&e),
        gen_env.join3(&e, "  %t2 = load ptr, ptr %q.1, align 8\n",
                      "  %t3 = getelementptr inbounds %fort.span, ptr %t2, i32 0, i32 1\n",
                      "  %t4 = load i64, ptr %t3, align 8\n"));
}

fn a_span_of_a_pointer_checks_nothing_at_all() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    string[3] mut lines = {ARR, "    i32 mut* mut p = &arr[0];",
                           "    i32 mut@ mut w = p[1..3];"};
    assert(gen_env.open_lines(&e, lines[..]));
    // A pointer has no length, so only the two-bound form exists and it is
    // the explicit unsafe escape. The one check before it is the index of
    // `&arr[0]`.
    string[11] want = {
        "  store ptr %t5, ptr %p.1, align 8\n",
        "  %t6 = load ptr, ptr %p.1, align 8\n",
        "  %t7 = sext i32 1 to i64\n",
        "  %t8 = sext i32 3 to i64\n",
        "  %t9 = getelementptr inbounds i32, ptr %t6, i64 %t7\n",
        "  %t10 = sub i64 %t8, %t7\n",
        "  %t11 = getelementptr inbounds %fort.span, ptr %w.2, i32 0, i32 0\n",
        "  store ptr %t9, ptr %t11, align 8\n",
        "  %t12 = getelementptr inbounds %fort.span, ptr %w.2, i32 0, i32 1\n",
        "  store i64 %t10, ptr %t12, align 8\n",
        "  store i32 0, ptr %result, align 4\n",
    };
    string got = gen_env.main_text(&e);
    gen_env.expect_in(got, gen_env.join_lines(&e, want[..]));
    assert(str.find(got, "fail_span") < 0);
}

fn a_written_high_bound_makes_the_length_a_read_of_its_own() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    string[3] mut lines = {ARR, "    i32 mut@ mut sp = arr[..];",
                           "    i32 mut@ mut v = sp[1..3];"};
    assert(gen_env.open_lines(&e, lines[..]));
    // The length is read after the bounds the source writes, so the check holds against the
    // length the operation sees. With both bounds written it is a load of its own. This is
    // where `sp[1..]` reads it once and uses it as the high bound as well.
    string[20] want = {
        "  %t10 = sext i32 1 to i64\n",
        "  %t11 = sext i32 3 to i64\n",
        "  %t12 = icmp ugt i64 %t10, %t11\n",
        "  %t13 = getelementptr inbounds %fort.span, ptr %sp.1, i32 0, i32 1\n",
        "  %t14 = load i64, ptr %t13, align 8\n",
        "  %t15 = icmp ugt i64 %t11, %t14\n",
        "  %t16 = or i1 %t12, %t15\n",
        "  %t17 = getelementptr inbounds %fort.span, ptr %sp.1, i32 0, i32 1\n",
        "  %t18 = load i64, ptr %t17, align 8\n",
        "  br i1 %t16, label %L4, label %L2\n",
        "\n",
        "L2:\n",
        "  %t19 = getelementptr inbounds %fort.span, ptr %sp.1, i32 0, i32 0\n",
        "  %t20 = load ptr, ptr %t19, align 8\n",
        "  %t21 = getelementptr inbounds i32, ptr %t20, i64 %t10\n",
        "  %t22 = sub i64 %t11, %t10\n",
        "  %t23 = getelementptr inbounds %fort.span, ptr %v.2, i32 0, i32 0\n",
        "  store ptr %t21, ptr %t23, align 8\n",
        "  %t24 = getelementptr inbounds %fort.span, ptr %v.2, i32 0, i32 1\n",
        "  store i64 %t22, ptr %t24, align 8\n",
    };
    string got = gen_env.main_text(&e);
    gen_env.expect_in(got, gen_env.join_lines(&e, want[..]));
    // The three bounds the failure carries are the low, the high and the
    // length the check compared.
    gen_env.expect_in(
        got,
        gen_env.join4(&e, "L4:\n",
                      "  call void @\"std.rt.fail_span\"(i64 %t10, i64 %t11, i64 %t18, ",
                      "ptr @.file.0, i32 4, i32 24)\n", "  unreachable\n"));
}

fn del_of_a_span_frees_its_pointer_and_zeroes_its_header() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    assert(open_own(&e));
    // The second `del` of the body is the `del(s)` of the span.
    // A span or `string` operand is an aggregate, so its pointer is field 0
    // and the emptying is a 16-byte memset.
    string[4] want = {
        "  %t15 = getelementptr inbounds %fort.span, ptr %s.1, i32 0, i32 0\n",
        "  %t16 = load ptr, ptr %t15, align 8\n",
        "  call void @\"std.rt.free\"(ptr %t16)\n",
        "  call void @llvm.memset.p0.i64(ptr align 8 %s.1, i8 0, i64 16, i1 false)\n",
    };
    gen_env.expect_in(gen_env.main_text(&e), gen_env.join_lines(&e, want[..]));
}

fn del_of_an_rvalue_stores_nothing() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    assert(open_own(&e));
    // `del` empties storage, and an `own` rvalue -- here the result of `new`
    // -- designates none, so it is freed and nothing is stored.
    gen_env.expect_in(
        gen_env.main_text(&e),
        gen_env.join3(&e,
                      "  %t17 = call ptr @\"std.rt.alloc\"(i64 4, i64 1, ptr @.file.0, ",
                      "i32 7, i32 9)\n",
                      "  call void @\"std.rt.free\"(ptr %t17)\n  %t18 = load ptr"));
}

fn move_of_a_scalar_reads_the_value_before_it_empties_the_operand() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    assert(open_own(&e));
    // The order is the whole of the rule. The value is read into the register the `load` names
    // and the operand is zeroed only afterwards, so `p = move(p)` yields what `p` held. The
    // store into `u` waits for its overwrite check.
    string[8] want = {
        "  %t18 = load ptr, ptr %p.0, align 8\n",
        "  store ptr null, ptr %p.0, align 8\n",
        "  %t19 = load ptr, ptr %u.3, align 8\n",
        "  %t20 = icmp ne ptr %t19, null\n",
        "  br i1 %t20, label %L10, label %L5\n",
        "\n",
        "L5:\n",
        "  store ptr %t18, ptr %u.3, align 8\n",
    };
    gen_env.expect_in(gen_env.main_text(&e), gen_env.join_lines(&e, want[..]));
}

fn main() i32 {
    an_index_into_an_array_is_checked_against_its_written_length();
    an_index_into_a_span_reads_the_length_out_of_its_header();
    no_bounds_check_removes_the_branch_and_nothing_else();
    a_span_of_an_array_checks_both_bounds_in_one_branch();
    a_field_of_a_value_and_a_field_behind_a_pointer_are_one_shape();
    the_pseudo_fields_of_a_span_are_its_header_fields();
    an_arrow_reaches_the_header_the_pointer_points_at();
    a_span_of_a_pointer_checks_nothing_at_all();
    a_written_high_bound_makes_the_length_a_read_of_its_own();
    println("places ok");
    a_positional_struct_literal_writes_its_members_in_field_order();
    a_designated_literal_zeroes_the_place_first();
    an_array_literal_writes_one_element_at_a_time();
    a_string_value_is_its_two_header_fields();
    println("aggregates ok");
    new_of_one_object_is_a_call_whose_result_is_an_ordinary_scalar();
    new_of_a_span_writes_the_header_it_allocated();
    an_unsigned_count_needs_no_branch_at_all();
    a_negative_count_is_checked_and_the_check_survives_release_mode();
    del_of_an_lvalue_frees_the_pointer_and_empties_the_storage();
    del_of_a_span_frees_its_pointer_and_zeroes_its_header();
    del_of_an_rvalue_stores_nothing();
    move_of_a_scalar_reads_the_value_before_it_empties_the_operand();
    move_of_an_aggregate_goes_through_an_intermediate();
    println("ownership ok");
    println("ok");
    return 0;
}
