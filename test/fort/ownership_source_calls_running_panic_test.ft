//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: ownership_source_calls: no computation runs
//! stdout:
//| 1
/// Checks that a charge outside a component computation panics: no ledger takes it.
import ownership_api;
import ownership_source_calls;

fn main() i32 {
    ownership_source_calls.context mut c = ownership_source_calls.context{};
    c.current = ownership_source_calls.NONE;
    ownership_api.charge_item[1] item = {ownership_api.charge_item{
        ownership_api.limit_category.w, ownership_api.limit_scope.computation, 1}};
    ownership_api.charge_request request = ownership_api.charge_request{
        ownership_api.work_kind.transfer, ownership_api.operation_position{},
        ownership_api.source_position{}, item[..]};
    println(1);
    ownership_source_calls.budget(cast(&c, void mut*), &request);
    return 0;
}
