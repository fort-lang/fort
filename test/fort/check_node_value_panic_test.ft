//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: check.check_node_value: value index out of range
//! stdout:
//| true
import ast;
import check;
import check_env;

// `aux` indexes the checker's own value vector on a node ANN_CONST marks, so
// it is never read without the bit that says which of its two meanings it
// carries. An index past the vector is a violated precondition and panics: a
// node whose bit says "constant" and whose index is not one belongs to a tree
// some other checker annotated.
// D3.8, D4.6, D13.3
fn i32 main() {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    println(check_env.check_decls(&e, "i32 k = 1;\n"));
    ast.node mut* d = check_env.node_in_main(&e, ast.ast_kind.k_var_decl, "k");
    d->b->aux = check.check_sym_count(&e.ck) + 4096;
    check.check_node_value(&e.ck, d->b);
    return 0;
}
