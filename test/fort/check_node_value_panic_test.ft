//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: check.check_node_value: value index out of range
//! stdout:
//| true
import ast;
import check;
import check_env;

/// Checks the value index on a node marked ANN_CONST. An out-of-range index breaks the
/// annotated tree invariant and panics.
fn main() i32 {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    println(check_env.check_decls(&e, "i32 k = 1;\n"));
    ast.node mut* d = check_env.node_in_main(&e, ast.ast_kind.k_var_decl, "k");
    d->b->aux = check.check_sym_count(&e.ck) + 4096;
    check.check_node_value(&e.ck, d->b);
    return 0;
}
