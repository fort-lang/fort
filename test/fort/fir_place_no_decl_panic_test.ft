//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: fir.place_type: a struct with no declaration
//! stdout:
//| ready
/// Checks that fir.place_type refuses a field of a struct type that has no declaring symbol: the
/// field types come from the declaration.
import diag;
import fir;
import prim;
import types;

fn main() i32 {
    types.table mut tt = types.table{};
    defer types.type_table_free(&tt);
    types.node* i32t = types.type_prim(&tt, prim.prim_kind.prim_i32);
    types.node*[2] params = {i32t, i32t};
    types.node* fnty = types.type_fn(&tt, i32t, params[..], false);
    fir.func mut f = fir.func_new(&tt, null, fnty);
    defer fir.func_free(&f);
    types.node* anon = types.type_struct(&tt, "anon", null);
    u32 n = fir.local_add(&f, anon, fir.local_kind.lk_temp, null, diag.loc{});
    fir.place p = fir.place_field(&f, fir.place_local(n), 0);
    println("ready");
    fir.place_type(&f, p);
    return 0;
}
