//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: fir_passes.build_mode: the proof is of another function
//! stdout:
//| 2 blocks, a proof of 0
/// The build-mode pass reads the verdict of each block from the proof that prover.prove gave
/// for the function (spec/fir.md 11). A proof with another count of blocks is the proof of
/// another function, which breaks that precondition, so the pass panics.
import fort.fir;
import fort.fir_passes;
import fort.owner.prover;
import lower_env;
import pass_env;

string[1] PRELUDE = {"fn g(bool c) void {}"};

string[8] TEXT = {
    "fn main.g(_1 (c): bool) -> void {",
    "    bb0: {",
    "        check(copy _1, overflow) -> bb1;",
    "    }",
    "    bb1: {",
    "        return;",
    "    }",
    "}",
};

// A panic ends the program, so the case stands in a file of its own.
fn main() i32 {
    // the empty proof of prover.make, whose end prover.drop_made holds; no run reaches it, because
    // the panic comes first
    prover.proof mut* own other = prover.make();
    defer prover.drop_made(move(other));
    lower_env.env mut* own e = lower_env.make();
    defer lower_env.drop_made(move(e));
    // `fm` lives in an allocation, so that the leak rule proves its end: no call changes the
    // pointer, and drop_made holds each release once.
    fir.module mut* own fm = pass_env.parse_made(e, PRELUDE[..], TEXT[..]);
    defer fir.module_drop_made(move(fm));
    fir.func mut* f = &fm->funcs.items[0];
    println(fir.block_count(f), " blocks, a proof of ", other->proved.len);
    fir_passes.build_mode(f, true, false, other);
    return 0;
}
