//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| ok
import ast;
import parse_env;
import std.strbuf;

// The diagnostics of src/fort/parser.ft and the recovery of D14.2: what is
// reported, where, how often, and what the tree holds afterwards.
//
// tools/diff_ast.sh compares this parser's diagnostics with the C's over the
// 69 .ft files of the repository that report one, so the messages themselves
// are held against stage1 there. What this suite adds is the behaviour no
// file in the repository exhibits: the cap of twenty per file, the dedupe of
// two errors at one position, the error nodes a skip leaves, and the
// speculative parses that must report nothing.

// ---- what is reported ----------------------------------------------------------

fn void a_missing_token_is_reported_where_it_is_missing() {
    parse_env.env mut e = parse_env.create();
    defer parse_env.free(&e);
    parse_env.parse(&e, "fn void f( {\n}\n");
    assert(parse_env.errors(&e) == 1);
    assert(parse_env.diag_at(&e, 0) == "1:12: error: expected a type, found '{'");
    parse_env.parse(&e, "i32 n = 1\n");
    assert(parse_env.errors(&e) == 1);
    assert(parse_env.diag_at(&e, 0) == "2:1: error: expected ';', found end of file");
    parse_env.parse(&e, "fn void f() {\n    g(1;\n}\n");
    assert(parse_env.errors(&e) == 1);
    assert(parse_env.diag_at(&e, 0) == "2:8: error: expected ')', found ';'");
}

fn void a_token_that_starts_no_expression_or_type_is_reported() {
    parse_env.env mut e = parse_env.create();
    defer parse_env.free(&e);
    parse_env.parse(&e, "i32 n = ;\n");
    assert(parse_env.diag_at(&e, 0) == "1:9: error: expected an expression, found ';'");
    parse_env.parse(&e, "fn void f() {\n    g(*);\n}\n");
    assert(parse_env.diag_at(&e, 0) == "2:8: error: expected an expression, found ')'");
    parse_env.parse(&e, "fn void f() {\n    ;\n}\n");
    assert(parse_env.diag_at(&e, 0) == "2:5: error: an empty statement is not allowed");
}

fn void a_missing_identifier_is_reported_as_such() {
    parse_env.env mut e = parse_env.create();
    defer parse_env.free(&e);
    parse_env.parse(&e, "fn void f(i32 1) {\n}\n");
    assert(parse_env.diag_at(&e, 0)
           == "1:15: error: expected an identifier, found integer literal");
    parse_env.parse(&e, "struct { i32 x; }\n");
    assert(parse_env.diag_at(&e, 0) == "1:8: error: expected an identifier, found '{'");
}

// The separator a source spells wrongly is named where it stands, rather than
// ending the path and being reported as the `;` that is then missing. `::` is
// the one that matters: it separated a module path until the separator became
// `.` (D9.1), so it is what every source written before that spells, and it
// now lexes as two colons (D2.10).
fn void the_old_path_separator_names_the_mistake() {
    parse_env.env mut e = parse_env.create();
    defer parse_env.free(&e);
    parse_env.parse(&e, "import a::b;\nfn i32 main() { return 0; }\n");
    assert(parse_env.errors(&e) == 1);
    assert(parse_env.diag_at(&e, 0)
           == "1:9: error: a module path is separated by '.', not '::'");
    parse_env.parse(&e, "import a.b::{c};\nfn i32 main() { return 0; }\n");
    assert(parse_env.diag_at(&e, 0)
           == "1:11: error: a module path is separated by '.', not '::'");
    // One colon is not two, and the message says which one it found.
    parse_env.parse(&e, "import a:b;\nfn i32 main() { return 0; }\n");
    assert(parse_env.diag_at(&e, 0) == "1:9: error: a module path is separated by '.', not ':'");
    // A colon before the first segment is not a separator at all.
    parse_env.parse(&e, "import ::a;\nfn i32 main() { return 0; }\n");
    assert(parse_env.diag_at(&e, 0) == "1:8: error: expected an identifier, found ':'");
}

// `..` is one token and longest match wins (D2.10), so the separator of a
// path written with two dots is the range operator and never reaches the
// parser as two separators; the diagnostic says so rather than reporting the
// `;` the path's end would then be missing (D9.1).
fn void a_path_separator_written_twice_names_the_mistake() {
    parse_env.env mut e = parse_env.create();
    defer parse_env.free(&e);
    parse_env.parse(&e, "import a..b;\nfn i32 main() { return 0; }\n");
    assert(parse_env.errors(&e) == 1);
    assert(parse_env.diag_at(&e, 0)
           == "1:9: error: a module path is separated by '.', not '..'");
    parse_env.parse(&e, "import a.b..c;\nfn i32 main() { return 0; }\n");
    assert(parse_env.diag_at(&e, 0)
           == "1:11: error: a module path is separated by '.', not '..'");
    // A `..` before the first segment is not a separator at all.
    parse_env.parse(&e, "import ..a;\nfn i32 main() { return 0; }\n");
    assert(parse_env.diag_at(&e, 0) == "1:8: error: expected an identifier, found '..'");
}

fn void the_marker_placement_rules_are_reported_at_the_marker() {
    parse_env.env mut e = parse_env.create();
    defer parse_env.free(&e);
    // Every one of these is decidable from the written form (D5.3, D17.2), so
    // the parser and not the checker reports it.
    parse_env.parse(&e, "mut i32 x = 0;\n");
    string leading_mut = parse_env.diag_at(&e, 0);
    assert(leading_mut == parse_env.join2(&e, "1:1: error: a mut never precedes the base type:",
                                          " write 'node mut* p' or 'node* mut p'"));
    parse_env.parse(&e, "i32 mut mut x = 0;\n");
    assert(parse_env.diag_at(&e, 0) == "1:9: error: a mut appears once in a type position");
    parse_env.parse(&e, "node* mut own x = 0;\n");
    assert(parse_env.diag_at(&e, 0)
           == "1:11: error: an own precedes the mut of its position: write 'node* own mut p'");
    parse_env.parse(&e, "i32 own x = 0;\n");
    string own_on_value = parse_env.diag_at(&e, 0);
    assert(own_on_value == parse_env.join2(&e, "1:5: error: an own marks a reference: write it",
                                           " after a '*' or an '@', or on a string"));
    parse_env.parse(&e, "i32 mut[4] x = 0;\n");
    string mut_before_array = parse_env.diag_at(&e, 0);
    assert(mut_before_array
           == parse_env.join2(&e, "1:5: error: the elements share the array's storage: write",
                              " the mut after the length, as 'i32[4] mut'"));
    parse_env.parse(&e, "i32[4]*[2] x = 0;\n");
    string array_after_ref = parse_env.diag_at(&e, 0);
    assert(array_after_ref
           == parse_env.join2(&e, "1:8: error: no array suffix follows a reference suffix:",
                              " wrap the array in a struct"));
}

fn void the_constructs_the_bootstrap_lacks_are_reported_as_unsupported() {
    parse_env.env mut e = parse_env.create();
    defer parse_env.free(&e);
    // toolchain.md 7.3: each is parsed whole and then refused, so the
    // self-hosted compiler answers for such a program the way stage1 does.
    parse_env.parse(&e, "f64 x = 1.5;\n");
    assert(parse_env.diag_at(&e, 0)
           == "1:9: error: not supported by the bootstrap compiler: float literals");
    parse_env.parse(&e, "fn void f() {\n    i32 x = a ? b : c;\n}\n");
    assert(parse_env.diag_at(&e, 0) == "2:15: error: not supported by the bootstrap compiler: ?:");
    // A second array or span level is on that list in the C parser and is not
    // on it here (T-043): this parser reads every form of D3.6.
    parse_env.parse(&e, "i32[2][3] x = 0;\n");
    assert(parse_env.errors(&e) == 0);
    parse_env.parse(&e, "i32[2]@ x = 0;\n");
    assert(parse_env.errors(&e) == 0);
    parse_env.parse(&e, "u8@@ x = 0;\n");
    assert(parse_env.errors(&e) == 0);
    parse_env.parse(&e, "node@[4] x = 0;\n");
    assert(parse_env.errors(&e) == 0);
}

fn void new_refuses_the_markers_it_does_not_take() {
    parse_env.env mut e = parse_env.create();
    defer parse_env.free(&e);
    // Inside `new` a `mut` never parses, an `own` follows only a `*`, and a
    // span is asked for with a count (D10.2, D17.3).
    parse_env.parse(&e, "i32 x = new(i32 mut);\n");
    assert(parse_env.diag_at(&e, 0)
           == "1:17: error: a mut does not parse inside new: new allocates writable storage");
    parse_env.parse(&e, "i32 x = new(i32 own);\n");
    assert(parse_env.diag_at(&e, 0)
           == "1:17: error: inside new an own follows a '*' of the element type");
    parse_env.parse(&e, "i32 x = new(i32@);\n");
    assert(parse_env.diag_at(&e, 0)
           == "1:16: error: a span suffix does not parse inside new: write new(T, n)");
}

fn void a_brace_list_may_not_mix_its_two_forms() {
    parse_env.env mut e = parse_env.create();
    defer parse_env.free(&e);
    // Positional and designated initializers do not mix (D6.5).
    parse_env.parse(&e, "point p = {.x = 1, 2};\n");
    assert(parse_env.diag_at(&e, 0)
           == "1:20: error: positional and designated initializers do not mix");
}

fn void an_empty_struct_or_enum_body_is_reported() {
    parse_env.env mut e = parse_env.create();
    defer parse_env.free(&e);
    parse_env.parse(&e, "struct s {\n}\n");
    assert(parse_env.diag_at(&e, 0) == "2:1: error: a struct has at least one field");
    parse_env.parse(&e, "enum k {\n}\n");
    assert(parse_env.diag_at(&e, 0) == "2:1: error: an enum has at least one member");
}

// ---- how often it is reported (D14.2) ------------------------------------------

fn void one_mistake_costs_one_diagnostic() {
    parse_env.env mut e = parse_env.create();
    defer parse_env.free(&e);
    // The first report starts an unwind: everything between it and the next
    // recovery point is silent, so a construct that fails deep inside itself
    // still reports once.
    parse_env.parse(&e, "fn void f() {\n    g(h(i(;\n}\n");
    assert(parse_env.errors(&e) == 1);
    assert(parse_env.diag_at(&e, 0) == "2:11: error: expected an expression, found ';'");
}

fn void later_errors_are_reported_too() {
    parse_env.env mut e = parse_env.create();
    defer parse_env.free(&e);
    // A file reports one diagnostic for each construct that failed, not only
    // for the first (D14.2).
    parse_env.parse(&e, "i32 a = ;\ni32 b = ;\ni32 c = ;\n");
    assert(parse_env.errors(&e) == 3);
    assert(parse_env.diag_at(&e, 0) == "1:9: error: expected an expression, found ';'");
    assert(parse_env.diag_at(&e, 1) == "2:9: error: expected an expression, found ';'");
    assert(parse_env.diag_at(&e, 2) == "3:9: error: expected an expression, found ';'");
}

fn void a_file_reports_at_most_twenty_diagnostics() {
    parse_env.env mut e = parse_env.create();
    defer parse_env.free(&e);
    // The cap is the file's and is checked before each report, exactly as
    // src/bootstrap/parser.c checks it (D14.2); the parse goes on, so the
    // tree still covers the file.
    //
    // The source is built in a buffer of this suite's own rather than in the
    // environment's, since appending a view of a buffer into that same buffer
    // is what std/strbuf.ft's `append` states as a precondition it does not
    // detect (stdlib: "s must not alias b's own storage").
    strbuf.str_buf mut src = strbuf.create();
    defer strbuf.free(&src);
    u64 mut i = 0;
    while (i < 25) {
        strbuf.append(&src, "i32 a = ;\n");
        i += 1;
    }
    ast.node mut* mod = parse_env.parse(&e, strbuf.view(&src));
    assert(parse_env.errors(&e) == 20);
    assert(parse_env.diag_count(&e) == 20);
    // The parse goes on past the cap: the tree holds an error node for every
    // one of the twenty-five failed declarations, the five that were never
    // reported included, so a later pass still sees that those regions were
    // skipped (D14.2).
    assert(ast.ast_len(mod) == 25);
    u64 mut n = 0;
    while (n < 25) {
        assert(ast.ast_child(mod, n)->kind == ast.ast_kind.k_error);
        n += 1;
    }
    // The twenty-first diagnostic is the one dropped: the twentieth is the
    // twentieth declaration's, not the twenty-fifth's.
    assert(parse_env.diag_at(&e, 19) == "20:9: error: expected an expression, found ';'");
}

fn void two_errors_at_one_position_are_reported_once() {
    parse_env.env mut e = parse_env.create();
    defer parse_env.free(&e);
    // An error that starts where the one before it started is dropped
    // (D14.2), which is what keeps a half-typed construct from reporting
    // twice about one token.
    parse_env.parse(&e, "fn void f() {\n    x = ;;\n}\n");
    assert(parse_env.errors(&e) == 1);
    assert(parse_env.diag_at(&e, 0) == "2:9: error: expected an expression, found ';'");
}

// ---- what the tree holds afterwards (D14.2) ------------------------------------

fn void a_skipped_region_is_an_error_node() {
    parse_env.env mut e = parse_env.create();
    defer parse_env.free(&e);
    // The skipped tokens are kept as an error node, so a later pass sees that
    // the region was skipped; the declarations after it are parsed.
    assert(parse_env.parse_dump(&e, "i32 a = ;\ni32 b = 1;\n")
           == "(module (error) (var b (type (prim i32)) (int 1)))");
    string body = parse_env.parse_dump(&e, "fn i32 f() {\n    x = ;\n    return 0;\n}\n");
    assert(body == "(module (fn (type (prim i32)) f (params) (block (error) (return (int 0)))))");
}

fn void a_broken_field_leaves_the_struct_standing() {
    parse_env.env mut e = parse_env.create();
    defer parse_env.free(&e);
    // The fields are a recovery point of their own: a broken one is skipped
    // to its `;` and the fields after it are read (D14.2).
    assert(parse_env.parse_dump(&e, "struct s {\n    i32 ;\n    i32 y;\n}\n")
           == "(module (struct s (error) (field-decl (type (prim i32)) y)))");
}

fn void a_broken_clause_leaves_the_switch_standing() {
    parse_env.env mut e = parse_env.create();
    defer parse_env.free(&e);
    string src = parse_env.join2(&e, "fn void f() {\n    switch (c) {\n    case :\n",
                                 "    case 2:\n        g();\n    }\n}\n");
    string dumped = parse_env.parse_dump(&e, src);
    string expected = parse_env.join3(&e, "(module (fn (type (void)) f (params) (block (switch",
                                      " (ident c) (error) (case (labels (int 2))",
                                      " (block (call-stmt (call (ident g)))))))))");
    assert(dumped == expected);
    assert(parse_env.errors(&e) == 1);
}

fn void a_missing_closing_brace_is_reported_once() {
    parse_env.env mut e = parse_env.create();
    defer parse_env.free(&e);
    // A block ends where a top-level declaration starts as well as at its
    // `}`, so a missing brace costs one diagnostic and not one per following
    // declaration (D14.2).
    string src = "fn void f() {\n    g();\nfn void h() {\n    k();\n}\n";
    string dumped = parse_env.parse_dump(&e, src);
    string expected = parse_env.join4(&e, "(module (fn (type (void)) f (params)",
                                      " (block (call-stmt (call (ident g)))))",
                                      " (fn (type (void)) h (params)",
                                      " (block (call-stmt (call (ident k))))))");
    assert(dumped == expected);
    assert(parse_env.errors(&e) == 1);
    assert(parse_env.diag_at(&e, 0) == "3:1: error: expected '}', found 'fn'");
}

fn void a_missing_opening_brace_is_reported_once_too() {
    parse_env.env mut e = parse_env.create();
    defer parse_env.free(&e);
    // The mirror of the rule above: a declaration header is complete before
    // its `{`, so the body is read as though the brace were there (D14.2).
    string dumped = parse_env.parse_dump(&e, "fn void f()\n    g();\n}\n");
    assert(dumped == "(module (fn (type (void)) f (params) (block (call-stmt (call (ident g))))))");
    assert(parse_env.errors(&e) == 1);
    assert(parse_env.diag_at(&e, 0) == "2:5: error: expected '{', found identifier 'g'");
}

fn void a_lexical_error_leaves_the_parser_the_rest_of_the_file() {
    parse_env.env mut e = parse_env.create();
    defer parse_env.free(&e);
    // A lexical error costs the lexer its line and the parser recovers from
    // whatever that missing line broke (D14.2); the budget is shared, so the
    // count here is the lexer's error and no cascade.
    assert(parse_env.parse_dump(&e, "#\ni32 b = 1;\n")
           == "(module (var b (type (prim i32)) (int 1)))");
    assert(parse_env.errors(&e) == 1);
    assert(parse_env.diag_at(&e, 0) == "1:1: error: unexpected character '#'");
}

// ---- the speculative parses (grammar.md 7) -------------------------------------

fn void a_speculation_reports_nothing() {
    parse_env.env mut e = parse_env.create();
    defer parse_env.free(&e);
    // The three decisions of grammar.md 7 are taken by a speculative parse
    // that always rewinds, so a program that needs them reports nothing: the
    // array-literal probe fails on `v[0]`, the declaration probe on a call,
    // and the `for` probe on a plain init.
    parse_env.parse(&e, "fn void f() {\n    g(v[0]);\n    for (n = 0; n < 2; n++) { }\n}\n");
    assert(parse_env.errors(&e) == 0);
    // The committed branch reports its own error, once: `i32[` speculates as
    // an array literal, fails, and the declaration branch reports.
    parse_env.parse(&e, "fn void f() {\n    i32[2] v = i32[2]{1;\n}\n");
    assert(parse_env.errors(&e) == 1);
}

fn i32 main() {
    a_missing_token_is_reported_where_it_is_missing();
    a_token_that_starts_no_expression_or_type_is_reported();
    a_missing_identifier_is_reported_as_such();
    the_old_path_separator_names_the_mistake();
    a_path_separator_written_twice_names_the_mistake();
    the_marker_placement_rules_are_reported_at_the_marker();
    the_constructs_the_bootstrap_lacks_are_reported_as_unsupported();
    new_refuses_the_markers_it_does_not_take();
    a_brace_list_may_not_mix_its_two_forms();
    an_empty_struct_or_enum_body_is_reported();
    one_mistake_costs_one_diagnostic();
    later_errors_are_reported_too();
    a_file_reports_at_most_twenty_diagnostics();
    two_errors_at_one_position_are_reported_once();
    a_skipped_region_is_an_error_node();
    a_broken_field_leaves_the_struct_standing();
    a_broken_clause_leaves_the_switch_standing();
    a_missing_closing_brace_is_reported_once();
    a_missing_opening_brace_is_reported_once_too();
    a_lexical_error_leaves_the_parser_the_rest_of_the_file();
    a_speculation_reports_nothing();
    println("ok");
    return 0;
}
