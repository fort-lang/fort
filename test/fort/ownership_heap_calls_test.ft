//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| caller storage takes the exit facts
//| separate instances stay apart
//| shape requirements bind at the call
//| recursive calls need strict parts and a covered return
//| unknown effects keep obligations unproved
//| views at a call
//| aggregates and pointers to owners
//| write footprints at calls
//| copied leaves of aggregate arguments
//| copied scalar references
//| whole-array stores
//| array leaves below the path bound
//| casts of element addresses
//| copies of loaded caller references
//| copies of loaded inputs
//| heap calls ok
/// Checks heap summaries at calls (D17.16, D17.18, `spec/fir.md` 14 Calls).
import ownership_api;
import ownership_facts;
import ownership_heap;
import ownership_heap_env;
import std.str;

string[11] LIST = {
    "struct node { node mut* own next; i32 v; }",
    "fn drop_list(node mut* own n) void { if (n == null) { return; }",
    "    drop_list(move(n->next)); del(n); }",
    "struct holder { node mut* own first; node mut* own second; i32 count; }",
    "fn push(holder mut* h, node mut* own n) void {",
    "    n->next = move(h->first); h->first = move(n); }",
    "fn clear(holder mut* h) void { drop_list(move(h->first)); drop_list(move(h->second)); }",
    "fn take(holder mut* h) node mut* own { return move(h->first); }",
    "fn stash(holder mut* h, node mut* own n) void {",
    "    drop_list(move(h->second)); h->second = move(n); }",
    "fn pick(node mut* own a, node mut* own b) node mut* own { drop_list(move(b)); return a; }",
};

fn with_list(string@ tail, string mut@ out) u64 {
    u64 mut n = 0;
    while (n < LIST.len) { out[n] = LIST[n]; n += 1; }
    u64 mut i = 0;
    while (i < tail.len) { out[n] = tail[i]; n += 1; i += 1; }
    return n;
}

fn names_with(string@ tail, string mut@ out) u64 {
    string[6] base = {"drop_list", "push", "clear", "take", "stash", "pick"};
    u64 mut n = 0;
    while (n < base.len) { out[n] = base[n]; n += 1; }
    u64 mut i = 0;
    while (i < tail.len) { out[n] = tail[i]; n += 1; i += 1; }
    return n;
}

fn base_proved(ownership_heap_env.closure* c) void {
    assert(ownership_heap_env.proved(c, "drop_list"));
    assert(ownership_heap_env.proved(c, "push"));
    assert(ownership_heap_env.proved(c, "clear"));
    assert(ownership_heap_env.proved(c, "take"));
    assert(ownership_heap_env.proved(c, "stash"));
    assert(ownership_heap_env.proved(c, "pick"));
}

// A callee that writes caller storage hands its exit facts to the caller storage that each
// argument designates (`spec/fir.md` 14 Calls).
fn caller_storage() void {
    println("caller storage takes the exit facts");
    string[10] tail = {
        "fn filled() void { holder mut h = holder{}; push(&h, new(node)); push(&h, new(node));",
        "    clear(&h); }",
        "fn half_cleared() void { holder mut h = holder{}; push(&h, new(node));",
        "    h.second = new(node);",
        "    node mut* own t = take(&h); drop_list(move(t)); }",
        "fn taken_back() void { holder mut h = holder{}; push(&h, new(node));",
        "    node mut* own t = take(&h); drop_list(move(t)); clear(&h); }",
        "fn stashed() void { holder mut h = holder{}; stash(&h, new(node)); clear(&h); }",
        "fn stash_twice() void { holder mut h = holder{}; stash(&h, new(node));",
        "    stash(&h, new(node)); clear(&h); }",
    };
    string[30] mut text = {};
    u64 n = with_list(tail[..], text[..]);
    string[16] mut names = {};
    string[5] more = {"filled", "half_cleared", "taken_back", "stashed", "stash_twice"};
    u64 m = names_with(more[..], names[..]);
    ownership_heap_env.closure mut c = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&c);
    ownership_heap_env.run(&c, text[0..n], names[0..m]);
    base_proved(&c);
    assert(ownership_heap_env.proved(&c, "filled"));
    assert(ownership_heap_env.proved(&c, "taken_back"));
    assert(ownership_heap_env.proved(&c, "stashed"));
    assert(ownership_heap_env.proved(&c, "stash_twice"));
    // The second owner of the holder stays full when the holder ends.
    assert(ownership_heap_env.candidate(&c, "half_cleared",
        ownership_api.event_kind.lost_ownership));
    ownership_heap_env.event_row row = ownership_heap_env.first(&c, "half_cleared");
    assert(row.kind == ownership_api.event_kind.lost_ownership);
    assert(ownership_heap_env.text(&row) == "h.second");
    // The summary of clear releases both caller owners and leaves them empty.
    ownership_heap.summary* s = ownership_heap_env.summary(&c, "clear");
    assert(s->interface.len == 2 && (s->post.released.bits & 3) == 3);
    assert(s->interface[0].needs_shape && s->interface[1].needs_shape);
    // The release of drop_list is its own operation. Clear takes it from a summary, so clear
    // assumes it.
    ownership_heap.summary* drop = ownership_heap_env.summary(&c, "drop_list");
    assert(drop->post.atoms[0].status.value == ownership_facts.atom_status.released);
    assert(drop->post.atoms[0].status.how == ownership_facts.provenance.established);
    assert(s->post.atoms[0].status.value == ownership_facts.atom_status.released);
    assert(s->post.atoms[0].status.how == ownership_facts.provenance.assumed);
    assert(s->post.atoms[1].status.how == ownership_facts.provenance.assumed);
}

// Each argument binds its own atom. Two arguments that designate one caller storage cannot
// prove separate effects (D17.16).
fn separate_instances() void {
    println("separate instances stay apart");
    string[12] tail = {
        "fn pair_ok() i32 { node mut* own a = new(node); node mut* own b = new(node);",
        "    node* va = a;",
        "    node mut* own kept = pick(move(a), move(b)); i32 x = va->v; drop_list(move(kept));",
        "    return x; }",
        "fn pair_bad() i32 { node mut* own a = new(node); node mut* own b = new(node);",
        "    node* vb = b;",
        "    node mut* own kept = pick(move(a), move(b)); i32 x = vb->v; drop_list(move(kept));",
        "    return x; }",
        "fn both(holder mut* x, holder mut* y) void { clear(x); clear(y); }",
        "fn same_twice() void { holder mut h = holder{}; both(&h, &h); }",
        "fn two_holders() void { holder mut h = holder{}; holder mut k = holder{};",
        "    push(&h, new(node)); push(&k, new(node)); both(&h, &k); }",
    };
    string[30] mut text = {};
    u64 n = with_list(tail[..], text[..]);
    string[16] mut names = {};
    string[5] more = {"pair_ok", "pair_bad", "both", "same_twice", "two_holders"};
    u64 m = names_with(more[..], names[..]);
    ownership_heap_env.closure mut c = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&c);
    ownership_heap_env.run(&c, text[0..n], names[0..m]);
    base_proved(&c);
    // The view of the kept argument stays live; the view of the released one does not.
    assert(ownership_heap_env.proved(&c, "pair_ok"));
    assert(ownership_heap_env.candidate(&c, "pair_bad", ownership_api.event_kind.invalid_use));
    ownership_heap_env.event_row bad = ownership_heap_env.first(&c, "pair_bad");
    assert(bad.kind == ownership_api.event_kind.invalid_use && bad.line == 18);
    assert(ownership_heap_env.proved(&c, "both"));
    assert(ownership_heap_env.proved(&c, "two_holders"));
    assert(ownership_heap_env.unproved(&c, "same_twice",
        ownership_api.incomplete_reason.unknown_effect));
    assert(ownership_heap_env.first(&c, "same_twice").line == 21);
}

// A caller proves the shape that the callee needs: a fresh cell folds, an owned cycle and an
// opaque owner do not (`spec/memory-model.md` 2.7).
fn shape_requirements() void {
    println("shape requirements bind at the call");
    string[12] tail = {
        "fn fresh_cells() void { node mut* own a = new(node); a->next = new(node);",
        "    a->next->next = new(node); drop_list(move(a)); }",
        "fn cyclic() void { node mut* own a = new(node); a->next = new(node);",
        "    node mut* v = a->next;",
        "    node mut* own w = new(node); w->next = move(a); v->next = move(w); }",
        "struct wide { node mut* own mut@ own kids; }",
        "fn kids_free(wide mut* own w) void { del(w->kids); del(w); }",
        "fn kids_made() void { wide mut* own w = new(wide); w->kids = new(node mut* own, 2);",
        "    kids_free(move(w)); }",
        "fn owner_slot(node mut* own mut* slot) void { drop_list(move(*slot)); }",
        "fn through_slot() void { node mut* own mut a = new(node); owner_slot(&a);",
        "    owner_slot(&a); }",
    };
    string[30] mut text = {};
    u64 n = with_list(tail[..], text[..]);
    string[16] mut names = {};
    string[6] more = {"fresh_cells", "cyclic", "kids_free", "kids_made", "owner_slot",
        "through_slot"};
    u64 m = names_with(more[..], names[..]);
    ownership_heap_env.closure mut c = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&c);
    ownership_heap_env.run(&c, text[0..n], names[0..m]);
    assert(ownership_heap_env.proved(&c, "fresh_cells"));
    // An owned cycle with no external owner is lost at the return.
    assert(ownership_heap_env.candidate(&c, "cyclic", ownership_api.event_kind.lost_ownership));
    // An owned collection of owners is an opaque atom: its release cannot prove empty leaves.
    assert(ownership_heap_env.unproved(&c, "kids_free",
        ownership_api.incomplete_reason.missing_graph));
    ownership_heap.summary* kids = ownership_heap_env.summary(&c, "kids_free");
    assert(kids->interface.len == 1 && kids->interface[0].kind == ownership_heap.atom_kind.opaque);
    // A pointer to an owner designates caller storage with one owned leaf.
    assert(ownership_heap_env.proved(&c, "owner_slot"));
    assert(ownership_heap_env.proved(&c, "through_slot"));
    ownership_heap.summary* slot_summary = ownership_heap_env.summary(&c, "owner_slot");
    assert(slot_summary->callers.len == 1 && slot_summary->interface.len == 1);
    assert(slot_summary->interface[0].key.base == ownership_heap.base_kind.caller);
}

// Recursion needs strict parts of the input and a covered return (`spec/fir.md` 14.1; the ratified
// reading of the recursive solver): a call on the whole input or a call without a return publishes
// no proof.
fn recursion() void {
    println("recursive calls need strict parts and a covered return");
    string[19] text = {
        "struct node { node mut* own next; i32 v; }",
        "fn same(node mut* own n) void { if (n == null) { return; } same(move(n)); }",
        "fn whole(node mut* own n) void { if (n == null) { return; }",
        "    node mut* own k = move(n->next); del(k); n->next = null; whole(move(n)); }",
        "fn even(node mut* own n) void { if (n == null) { return; }",
        "    node mut* own r = move(n->next); del(n); odd(move(r)); }",
        "fn odd(node mut* own n) void { if (n == null) { return; }",
        "    node mut* own r = move(n->next); del(n); even(move(r)); }",
        "fn use_even() void { node mut* own a = new(node); a->next = new(node); even(move(a)); }",
        "fn spin(node mut* own n) void { spin(move(n)); }",
        "fn rebuild(node mut* own n) void { if (n == null) { return; }",
        "    node mut* own r = move(n->next); del(n); node mut* own f = new(node);",
        "    f->next = move(r); rebuild(move(f)); }",
        "fn leaf_first(node mut* own n) void { if (n == null) { return; }",
        "    leaf_first(move(n->next)); del(n); }",
        "fn drop_list(node mut* own n) void { if (n == null) { return; } drop_list(move(n->next));",
        "    del(n); }",
        "fn flip(node mut* own n, bool again) void { if (again) { flip(move(n), false); return; }",
        "    drop_list(move(n)); }",
    };
    string[10] names = {"same", "whole", "even", "odd", "use_even", "spin", "rebuild",
        "leaf_first", "drop_list", "flip"};
    ownership_heap_env.closure mut c = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&c);
    ownership_heap_env.run(&c, text[..], names[..]);
    assert(ownership_heap_env.unproved(&c, "same", ownership_api.incomplete_reason.unknown_effect));
    assert(!ownership_heap_env.proved(&c, "whole"));
    // `whole` loses `k->next` before the call on its whole input. Its proof names the call and not
    // the earlier candidate, because a checker of candidates removes no other reason.
    assert(ownership_heap_env.unproved(&c, "whole", ownership_api.incomplete_reason.missing_graph));
    assert(ownership_heap_env.candidates(&c, "whole", ownership_api.event_kind.lost_ownership,
        ownership_api.certainty.choice) == 1);
    assert(ownership_heap_env.first(&c, "whole").kind == ownership_api.event_kind.lost_ownership);
    assert(ownership_heap_env.events(&c, "whole") == 2);
    assert(ownership_heap_env.proved(&c, "even"));
    assert(ownership_heap_env.proved(&c, "odd"));
    assert(ownership_heap_env.rounds(&c, "even") == ownership_heap_env.rounds(&c, "odd"));
    assert(ownership_heap_env.proved(&c, "use_even"));
    assert(!ownership_heap_env.proved(&c, "spin"));
    // A fresh node around the tail is no strict part of the input.
    assert(!ownership_heap_env.proved(&c, "rebuild"));
    assert(ownership_heap_env.saw(&c, "rebuild", ownership_api.event_kind.incomplete_proof,
        ownership_api.evidence_kind.abstract_possibility) >= 1);
    assert(ownership_heap_env.proved(&c, "leaf_first"));
    // `flip` passes its whole input to itself once. Its recursion ends, but the input is no
    // strict part, so the recursive cleanup has no proof (memory model 2.7).
    assert(ownership_heap_env.proved(&c, "drop_list"));
    assert(!ownership_heap_env.proved(&c, "flip"));
    assert(ownership_heap_env.first(&c, "flip").kind == ownership_api.event_kind.incomplete_proof);
    assert(ownership_heap_env.first(&c, "flip").line == 18);
    assert(ownership_heap_env.first(&c, "flip").reason ==
        ownership_api.incomplete_reason.missing_graph);
}

// A call without a complete summary takes owned arguments and can change each storage that a
// reference argument designates, each caller storage, and each exposed atom (D17.13, D17.18).
fn unknown_effects() void {
    println("unknown effects keep obligations unproved");
    string[15] text = {
        "struct node { node mut* own next; i32 v; }",
        "extern fn touch(node* n) void;",
        "extern fn keep(node mut* own n) void;",
        "fn drop_list(node mut* own n) void { if (n == null) { return; }",
        "    drop_list(move(n->next)); del(n); }",
        "fn touched() void { node mut* own a = new(node); touch(a); drop_list(move(a)); }",
        "fn kept() void { node mut* own a = new(node); keep(move(a)); }",
        "fn scalar_only(i32 x) i32 { node mut* own a = new(node); i32 y = abs(x); del(a);",
        "    return y; }",
        "fn abs(i32 x) i32 { return x < 0 ? -x : x; }",
        "fn bad_callee(node mut* own n) void { }",
        "fn after_bad() void { node mut* own a = new(node); bad_callee(move(a)); }",
        "fn by_value(node mut* own n) void { fnptr(move(n)); }",
        "fn fnptr(node mut* own n) void { fn (node mut* own) void f = drop_list; f(move(n)); }",
        "fn unused() void { }",
    };
    string[9] names = {"drop_list", "touched", "kept", "scalar_only", "abs", "bad_callee",
        "after_bad", "by_value", "fnptr"};
    ownership_heap_env.closure mut c = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&c);
    ownership_heap_env.run(&c, text[..], names[..]);
    // The extern receives a view of the node, so its fields can change.
    assert(ownership_heap_env.unproved(&c, "touched",
        ownership_api.incomplete_reason.unknown_effect));
    assert(ownership_heap_env.unproved(&c, "kept", ownership_api.incomplete_reason.unknown_effect));
    // A call with scalar arguments reaches no tracked obligation.
    assert(ownership_heap_env.proved(&c, "scalar_only"));
    // The callee reports its own loss. A callee without a proof supplies no proof of safe
    // effects (`spec/fir.md` 14, Calls), so the call gives incomplete proof in its caller too,
    // and the summary of the caller cannot use the callee's.
    assert(ownership_heap_env.candidate(&c, "bad_callee", ownership_api.event_kind.lost_ownership));
    assert(ownership_heap_env.events(&c, "after_bad") == 1);
    assert(ownership_heap_env.first_text(&c, "after_bad") ==
        "a call of a function without a proof");
    assert(ownership_heap_env.summary(&c, "after_bad")->residual);
    // A call of a function value is unknown to this module.
    assert(ownership_heap_env.unproved(&c, "fnptr",
        ownership_api.incomplete_reason.unknown_effect));
}

// A callee that reads storage that an argument designates needs that storage live at the call.
// A callee that releases an interface atom cannot also read a view of that atom (D17.14, D17.15).
fn views_at_call() void {
    println("views at a call");
    // The node owns no field, so each release here loses nothing (`spec/fir.md` 14.1).
    string[25] text = {
        "struct node { node* next; i32 v; }",
        "fn read(node* n) i32 { return n->v; }",
        "fn ignore(node* n) i32 { return 1; }",
        "fn live_read() i32 { node mut* own a = new(node); i32 x = read(a); del(a); return x; }",
        "fn stale_read() i32 { node mut* own a = new(node); node* v = a; del(a); return read(v); }",
        "fn stale_pass() i32 { node mut* own a = new(node); node* v = a; del(a);",
        "    return ignore(v); }",
        "fn eat_and_read(node mut* own n, node* m) i32 { del(n); return m->v; }",
        "fn self_view() i32 { node mut* own a = new(node); node* v = a;",
        "    return eat_and_read(move(a), v); }",
        "fn other_view() i32 { node mut* own a = new(node); node mut* own b = new(node);",
        "    node* v = b;",
        "    i32 r = eat_and_read(move(a), v); del(b); return r; }",
        "fn identity(i32* p) i32* { return p; }",
        "fn returned_view() i32 { i32 mut* own owner = new(i32); i32* view = identity(owner);",
        "    del(owner); return *view; }",
        "fn returned_live() i32 { i32 mut* own owner = new(i32); i32* view = identity(owner);",
        "    i32 x = *view; del(owner); return x; }",
        "fn keep(u8@ s) u8@ { return s[1..2]; }",
        "fn returned_span() u8 { u8 mut@ own b = new(u8, 2); u8@ v = keep(b); del(b);",
        "    return v[0]; }",
        "fn text() string { return \"fixed\"; }",
        "fn static_text() u64 { string t = text(); return t.len; }",
        "fn returned_local() i32 { i32 x = 1; i32* p = identity(&x); return *p; }",
        "fn returned_escape() i32* { i32 x = 1; return identity(&x); }",
    };
    string[19] names = {"read", "ignore", "live_read", "stale_read", "stale_pass", "eat_and_read",
        "self_view", "other_view", "identity", "returned_view", "returned_live", "keep",
        "returned_span", "text", "static_text", "returned_local", "returned_escape", "read",
        "read"};
    ownership_heap_env.closure mut c = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&c);
    ownership_heap_env.run(&c, text[..], names[0..17]);
    assert(ownership_heap_env.proved(&c, "read"));
    assert((ownership_heap_env.summary(&c, "read")->view_reads & 2) == 2);
    assert(ownership_heap_env.summary(&c, "ignore")->view_reads == 0);
    assert(ownership_heap_env.proved(&c, "live_read"));
    assert(ownership_heap_env.candidate(&c, "stale_read", ownership_api.event_kind.invalid_use));
    assert(ownership_heap_env.first(&c, "stale_read").kind == ownership_api.event_kind.invalid_use);
    // A copy of a reference is a use of it (D17.14). So passing a dangling view to a callee that
    // never reads it is an invalid use of the copied `v`.
    assert(ownership_heap_env.candidate(&c, "stale_pass", ownership_api.event_kind.invalid_use));
    ownership_heap_env.event_row passed = ownership_heap_env.first(&c, "stale_pass");
    assert(passed.kind == ownership_api.event_kind.invalid_use && passed.line == 7);
    assert(ownership_heap_env.text(&passed) == "v");
    assert(ownership_heap_env.events(&c, "stale_pass") == 1);
    assert(ownership_heap_env.proved(&c, "eat_and_read"));
    assert(!ownership_heap_env.proved(&c, "self_view"));
    assert(ownership_heap_env.proved(&c, "other_view"));
    // A returned view of a parameter designates the caller's argument, not storage that stays
    // live: its release invalidates the view (D17.14).
    assert(ownership_heap_env.proved(&c, "identity"));
    assert(ownership_heap_env.candidate(&c, "returned_view", ownership_api.event_kind.invalid_use));
    assert(is_invalid(ownership_heap_env.first(&c, "returned_view")));
    assert(ownership_heap_env.proved(&c, "returned_live"));
    assert(ownership_heap_env.candidate(&c, "returned_span", ownership_api.event_kind.invalid_use));
    assert(is_invalid(ownership_heap_env.first(&c, "returned_span")));
    // A string constant is static storage on each side of the call.
    assert(ownership_heap_env.proved(&c, "static_text"));
    // An address of a local returns through the call as that address.
    assert(ownership_heap_env.proved(&c, "returned_local"));
    assert(ownership_heap_env.candidate(&c, "returned_escape",
        ownership_api.event_kind.invalid_use));
}

fn is_invalid(ownership_heap_env.event_row row) bool {
    return row.kind == ownership_api.event_kind.invalid_use &&
        row.certainty == ownership_api.certainty.definite;
}

// Aggregates carry their owned leaves through by-value parameters and results; a pointer to an
// owner designates caller storage (`spec/fir.md` 14 Calls).
fn aggregates() void {
    println("aggregates and pointers to owners");
    string[12] text = {
        "struct node { node mut* own next; i32 v; }",
        "struct pair { node mut* own a; node mut* own b; }",
        "fn drop_list(node mut* own n) void { if (n == null) { return; }",
        "    drop_list(move(n->next)); del(n); }",
        "fn make_pair() pair { return pair{new(node), new(node)}; }",
        "fn drop_pair(pair p) void { drop_list(move(p.a)); drop_list(move(p.b)); }",
        "fn half_pair(pair p) void { drop_list(move(p.a)); }",
        "fn round_trip() void { pair p = make_pair(); drop_pair(move(p)); }",
        "fn swap(node mut* own mut* x, node mut* own mut* y) void { node mut* own t = move(*x);",
        "    *x = move(*y); *y = move(t); }",
        "fn swapped() void { node mut* own mut a = new(node); node mut* own mut b = null;",
        "    swap(&a, &b); drop_list(move(b)); }",
    };
    string[7] names = {"drop_list", "make_pair", "drop_pair", "half_pair", "round_trip", "swap",
        "swapped"};
    ownership_heap_env.closure mut c = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&c);
    ownership_heap_env.run(&c, text[..], names[..]);
    assert(ownership_heap_env.proved(&c, "make_pair"));
    assert(ownership_heap_env.proved(&c, "drop_pair"));
    assert(ownership_heap_env.candidate(&c, "half_pair", ownership_api.event_kind.lost_ownership));
    assert(ownership_heap_env.first_text(&c, "half_pair") == "p.b");
    assert(ownership_heap_env.proved(&c, "round_trip"));
    assert(ownership_heap_env.proved(&c, "swap"));
    assert(ownership_heap_env.proved(&c, "swapped"));
}

// A callee with a complete proof can write caller storage that its post-state does not name. It
// can store through a pointer that a global holds, or through a pointer leaf of a by-value
// struct. The summary records that write footprint. Each caller forgets only the facts of storage
// that the footprint can reach (D17.18, `spec/fir.md` 14.1). The text is not a `string[N]`
// array, so `heap_rows` does not read it.
fn write_footprints() void {
    println("write footprints at calls");
    string mut@ own text = new(string, 47);
    defer del(text);
    text[0] = "struct node { i32 v; }";
    text[1] = "struct peer { i32 v; i32 mut* p; }";
    text[2] = "struct cpeer { i32 v; node* p; }";
    text[3] = "struct holder2 { peer mut* p; }";
    text[4] = "cpeer mut* mut saved_c = null;";
    text[5] = "fn stash_c(cpeer mut* c) void { saved_c = c; }";
    text[6] = "fn clear_c() void { saved_c->p = null; }";
    text[7] = "fn reset_c() void { saved_c = null; }";
    text[8] = "fn read_c() i32 { return saved_c->v; }";
    text[9] = "fn wrap_global() void { clear_c(); }";
    text[10] = "fn clear2(holder2 h) void { h.p->p = null; }";
    text[11] = "fn clear_second(i32 k, holder2 h) void { h.p->p = null; }";
    text[12] = "fn copy_only(holder2 mut h) void { h.p = null; }";
    text[13] = "fn direct(peer mut* q) void { q->p = null; }";
    text[14] = "fn set_v(cpeer mut* c) void { c->v = 1; }";
    text[15] = "fn wrap_view(i32 k, holder2 h) void { clear2(h); }";
    text[16] = "fn wrap_direct(i32 k, peer mut* q) void { direct(q); }";
    text[17] = "fn wrap_copy(holder2 h) void { copy_only(h); }";
    // Each caller leaks `extra` on one path. Only a stale caller fact removes that path.
    text[18] = "fn kept_global(cpeer mut* c) void { i32 mut* own extra = new(i32); stash_c(c);";
    text[19] = "    node mut* own b = new(node); c->p = b; clear_c();";
    text[20] = "    if (c->p == null) { del(b); return; } c->p = null; del(b); del(extra); }";
    text[21] = "fn kept_wrapped(cpeer mut* c) void { i32 mut* own extra = new(i32); stash_c(c);";
    text[22] = "    node mut* own b = new(node); c->p = b; wrap_global();";
    text[23] = "    if (c->p == null) { del(b); return; } c->p = null; del(b); del(extra); }";
    text[24] = "fn kept_reset(cpeer mut* c) void { i32 mut* own extra = new(i32); stash_c(c);";
    text[25] = "    node mut* own b = new(node); c->p = b; reset_c();";
    text[26] = "    if (c->p == null) { del(b); return; } c->p = null; del(b); del(extra); }";
    text[27] = "fn kept_read(cpeer mut* c) void { i32 mut* own extra = new(i32); stash_c(c);";
    text[28] = "    node mut* own b = new(node); c->p = b; i32 r = read_c();";
    text[29] = "    if (c->p == null) { del(b); return; } c->p = null; del(b); del(extra); }";
    text[30] = "fn local_kept() void { i32 mut* own extra = new(i32); i32 mut x = 1;";
    text[31] = "    peer mut* own m = new(peer); m->p = &x; clear_c();";
    text[32] = "    if (m->p == null) { del(m); return; } m->p = null; del(m); del(extra); }";
    text[33] = "fn view_val() void { i32 mut* own extra = new(i32); i32 mut x = 1;";
    text[34] = "    peer mut* own m = new(peer); m->p = &x; holder2 mut h = holder2{}; h.p = m;";
    text[35] = "    clear2(h); if (m->p != null) { del(extra); } m->p = null; del(m); }";
    text[36] = "fn view_wrapped() void { i32 mut* own extra = new(i32); i32 mut x = 1;";
    text[37] = "    peer mut* own m = new(peer); m->p = &x; holder2 mut h = holder2{}; h.p = m;";
    text[38] = "    wrap_view(0, h); if (m->p != null) { del(extra); } m->p = null; del(m); }";
    text[39] = "fn view_copy() void { i32 mut* own extra = new(i32); i32 mut x = 1;";
    text[40] = "    peer mut* own m = new(peer); m->p = &x; holder2 mut h = holder2{}; h.p = m;";
    text[41] = "    wrap_copy(h); if (m->p != null) { del(extra); } m->p = null; del(m); }";
    text[42] = "fn view_freed() void { peer mut* own m = new(peer); holder2 mut h = holder2{};";
    text[43] = "    h.p = m; clear2(h); del(m); }";
    text[44] = "fn kept_direct(cpeer mut* c) void { i32 mut* own extra = new(i32);";
    text[45] = "    node mut* own b = new(node); c->p = b; set_v(c);";
    text[46] = "    if (c->p == null) { del(b); return; } c->p = null; del(b); del(extra); }";
    string[23] names = {"stash_c", "clear_c", "reset_c", "read_c", "wrap_global", "clear2",
        "clear_second", "copy_only", "direct", "set_v", "wrap_view", "wrap_direct", "wrap_copy",
        "kept_global", "kept_wrapped", "kept_reset", "kept_read", "local_kept", "view_val",
        "view_wrapped", "view_copy", "view_freed", "kept_direct"};
    ownership_heap_env.closure mut c = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&c);
    ownership_heap_env.run(&c, text[..], names[..]);

    // A store through a pointer that a global holds is a global write. A direct store into the
    // global and a read through it are not. A wrapper publishes the global write of its callee.
    assert(ownership_heap_env.proved(&c, "clear_c"));
    assert(ownership_heap_env.summary(&c, "clear_c")->global_writes);
    assert(ownership_heap_env.proved(&c, "reset_c"));
    assert(!ownership_heap_env.summary(&c, "reset_c")->global_writes);
    assert(ownership_heap_env.proved(&c, "read_c"));
    assert(!ownership_heap_env.summary(&c, "read_c")->global_writes);
    assert(ownership_heap_env.proved(&c, "wrap_global"));
    assert(ownership_heap_env.summary(&c, "wrap_global")->global_writes);
    // A by-value struct parameter records a write through its pointer leaf. The bit is the
    // position of the parameter, from 1.
    ownership_heap.summary* clear2 = ownership_heap_env.summary(&c, "clear2");
    assert(ownership_heap_env.proved(&c, "clear2"));
    assert(clear2->view_writes == ownership_heap.bit(1) && !clear2->writes_high);
    assert(!clear2->global_writes);
    ownership_heap.summary* second = ownership_heap_env.summary(&c, "clear_second");
    assert(second->view_writes == ownership_heap.bit(2) && !second->writes_high);
    // A store into a field of the by-value copy changes no caller storage.
    assert(ownership_heap_env.proved(&c, "copy_only"));
    assert(ownership_heap_env.summary(&c, "copy_only")->view_writes == 0);
    assert(!ownership_heap_env.summary(&c, "copy_only")->writes_high);
    // A direct pointer parameter records its write as well. Its caller uses the exact post-state.
    assert(ownership_heap_env.summary(&c, "direct")->view_writes == ownership_heap.bit(1));
    assert(ownership_heap_env.summary(&c, "set_v")->view_writes == ownership_heap.bit(1));
    // A wrapper maps the footprint of the callee to the parameter of its own actual leaf.
    ownership_heap.summary* wrapped = ownership_heap_env.summary(&c, "wrap_view");
    assert(ownership_heap_env.proved(&c, "wrap_view"));
    assert(wrapped->view_writes == ownership_heap.bit(2) && !wrapped->global_writes);
    assert(ownership_heap_env.proved(&c, "wrap_direct"));
    assert(ownership_heap_env.summary(&c, "wrap_direct")->view_writes == ownership_heap.bit(2));
    assert(ownership_heap_env.proved(&c, "wrap_copy"));
    assert(ownership_heap_env.summary(&c, "wrap_copy")->view_writes == 0);

    // `stash_c` stores a parameter into a global, so it has no proof, and each call of it gives
    // incomplete proof in its caller (`spec/fir.md` 14, Calls). A global write reaches caller
    // storage that the earlier call exposed. The leak path stays, directly and through the
    // wrapper.
    assert(ownership_heap_env.unproved(&c, "kept_global",
        ownership_api.incomplete_reason.unknown_effect));
    assert(ownership_heap_env.saw(&c, "kept_global", ownership_api.event_kind.lost_ownership,
        ownership_api.evidence_kind.abstract_possibility) == 1);
    assert(ownership_heap_env.unproved(&c, "kept_wrapped",
        ownership_api.incomplete_reason.unknown_effect));
    assert(ownership_heap_env.saw(&c, "kept_wrapped", ownership_api.event_kind.lost_ownership,
        ownership_api.evidence_kind.abstract_possibility) == 1);
    // A callee with no global write keeps the exact caller facts, so the leak path is absent:
    // the call of `stash_c` gives the only event.
    assert(unproved_call(&c, "kept_reset"));
    assert(unproved_call(&c, "kept_read"));
    // A global write cannot reach a cell that no effect exposed.
    assert(ownership_heap_env.proved(&c, "local_kept"));
    // A write through a by-value pointer leaf reaches the cell of that leaf, directly and
    // through the wrapper.
    assert(ownership_heap_env.unproved(&c, "view_val",
        ownership_api.incomplete_reason.missing_path));
    assert(ownership_heap_env.unproved(&c, "view_wrapped",
        ownership_api.incomplete_reason.missing_path));
    assert(ownership_heap_env.proved(&c, "view_copy"));
    // A write changes storage contents. It does not release the cell, so the caller frees it.
    assert(ownership_heap_env.proved(&c, "view_freed"));
    assert(ownership_heap_env.events(&c, "view_freed") == 0);
    // The footprint does not erase the exact post-state of a direct pointer parameter.
    assert(ownership_heap_env.proved(&c, "kept_direct"));
}

// A copy of an aggregate argument copies each borrowed leaf, and a copy of a reference is a use
// of it (D17.14). So each borrowed leaf must not dangle at the call, also when the callee does
// not read it.
fn copied_leaves() void {
    println("copied leaves of aggregate arguments");
    string[40] text = {
        "struct box { i32* p; }",
        "struct outer { box inner; i32 n; }",
        "struct pair { string s; i32* p; }",
        "struct mixed { i32 mut* own o; i32* p; }",
        "fn take(box b) void {}",
        "fn take_outer(outer o) void {}",
        "fn take_pair(pair v) void {}",
        "fn take_arr(i32*[2] a) void {}",
        "fn take_mixed(mixed m) void { del(m.o); }",
        "fn copy_bad(i32 mut* own p) void { box b = box{p}; del(p); take(b); }",
        "fn copy_ok(i32 mut* own p) void { box b = box{p}; take(b); del(p); }",
        "fn nested_bad(i32 mut* own p) void { outer o = outer{box{p}, 1}; del(p);",
        "    take_outer(o); }",
        "fn nested_ok(i32 mut* own p) void { outer o = outer{box{p}, 1}; take_outer(o);",
        "    del(p); }",
        "fn text_bad(i32 mut* own p) void { pair v = pair{\"x\", p}; del(p); take_pair(v); }",
        "fn text_ok(i32* q) void { pair v = pair{\"x\", q}; take_pair(v); }",
        "fn moved_bad(i32 mut* own p) void { mixed mut m = mixed{new(i32), p}; del(p);",
        "    take_mixed(move(m)); }",
        "fn moved_ok(i32* q) void { mixed mut m = mixed{new(i32), q}; take_mixed(move(m)); }",
        "fn ended_bad() void { box mut b = box{null}; { i32 x = 1; b = box{&x}; } take(b); }",
        "fn ended_ok() void { i32 x = 1; box b = box{&x}; take(b); }",
        "fn cell_bad(i32 mut* own p) void { box mut* own c = new(box); c->p = p; del(p);",
        "    take(*c); del(c); }",
        "fn cell_ok(i32 mut* own p) void { box mut* own c = new(box); c->p = p; take(*c);",
        "    del(c); del(p); }",
        "fn inputs_ok(box b, box* h) void { take(b); take(*h); }",
        "fn null_ok() void { box b = box{null}; take(b); }",
        "fn joined_bad(bool k, i32 mut* own p, i32* q) void { box mut b = box{q};",
        "    if (k) { b = box{p}; } del(p); take(b); }",
        "fn array_ok(i32* q) void { i32*[2] a = {q, q}; take_arr(a); }",
        "fn array_bad(i32 mut* own p, i32* q) void { i32*[2] a = {q, p}; del(p); take_arr(a); }",
        "fn span_ok(i32* q) void { box mut@ own a = new(box, 2); a[1].p = q; take(a[1]);",
        "    del(a); }",
        "fn span_body(i32 mut* own p) void { box mut@ own a = new(box, 2); a[1].p = p;",
        "    take(a[1]); del(a); del(p); }",
        "fn nothing() void {}",
        "fn put(box mut* b, i32* q) void { b->p = q; }",
        "fn framed(i32 mut* own p) void { box mut b = box{p}; nothing(); take(b); del(p);",
        "    put(&b, null); }",
    };
    string[27] names = {"take", "take_outer", "take_pair", "take_arr", "take_mixed", "copy_bad",
        "copy_ok", "nested_bad", "nested_ok", "text_bad", "text_ok", "moved_bad", "moved_ok",
        "ended_bad", "ended_ok", "cell_bad", "cell_ok", "inputs_ok", "null_ok", "joined_bad",
        "array_ok", "array_bad", "span_ok", "span_body", "nothing", "put", "framed"};
    ownership_heap_env.closure mut c = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&c);
    ownership_heap_env.run(&c, text[..], names[..]);
    // A callee that does not read its parameter has a complete proof.
    assert(ownership_heap_env.proved(&c, "take"));
    assert(ownership_heap_env.proved(&c, "take_arr"));
    assert(ownership_heap_env.proved(&c, "take_mixed"));
    // A leaf whose source is released before the call: one candidate at the call. It names the
    // copied leaf, at each depth and next to a string constant.
    assert(copy_candidate(&c, "copy_bad", 10, "b.p"));
    assert(ownership_heap_env.proved(&c, "copy_ok"));
    assert(copy_candidate(&c, "nested_bad", 13, "o.inner.p"));
    assert(ownership_heap_env.proved(&c, "nested_ok"));
    assert(copy_candidate(&c, "text_bad", 16, "v.p"));
    assert(ownership_heap_env.proved(&c, "text_ok"));
    // A whole move copies its borrowed leaves too. Its owned leaf moves.
    assert(copy_candidate(&c, "moved_bad", 19, "m.p"));
    assert(ownership_heap_env.proved(&c, "moved_ok"));
    // An address of a local that ended, and a cell field whose source is released.
    assert(copy_candidate(&c, "ended_bad", 21, "b.p"));
    assert(ownership_heap_env.proved(&c, "ended_ok"));
    assert(copy_candidate(&c, "cell_bad", 24, "c->p"));
    assert(ownership_heap_env.proved(&c, "cell_ok"));
    // Inputs of the caller and null leaves need nothing.
    assert(ownership_heap_env.proved(&c, "inputs_ok"));
    assert(ownership_heap_env.proved(&c, "null_ok"));
    // A join keeps the released source of one path.
    assert(ownership_heap_env.candidate(&c, "joined_bad", ownership_api.event_kind.invalid_use));
    assert(ownership_heap_env.first(&c, "joined_bad").line == 30);
    // One slot stands for each element of a fixed array. The literal keeps the join of its
    // elements, so an input proves and a released element is an invalid use.
    assert(ownership_heap_env.proved(&c, "array_ok"));
    assert(copy_candidate(&c, "array_bad", 32, "a reference that this call copies"));
    // Storage without slots keeps the facts of its atom. An input keeps the proof. A reference
    // of the body gives incomplete proof, because the facts do not name its source.
    assert(ownership_heap_env.proved(&c, "span_ok"));
    assert(lost_copy(&c, "span_body", 36, "a reference that this call copies"));
    // A call forgets the facts of a local whose storage a FIR address names (D17.18). The
    // copy then uses a leaf with no facts, so the body gives incomplete proof.
    assert(lost_copy(&c, "framed", 39, "b.p"));
}

// A store of a whole array replaces each element, so the array slot takes the facts of the
// stored value; a store of one row joins them (D17.14, D17.15). Storage without slots records
// the references of the store, and untracked storage gives incomplete proof.
fn array_stores() void {
    println("whole-array stores");
    string[38] text = {
        "struct holder { i32*[2] arr; }",
        "struct abox { i32*[2] ps; }",
        "struct mh { i32 mut*[1] ps; }",
        "abox mut garr = abox{};",
        "fn take_arr(i32*[2] value) void {}",
        "fn take_abox(abox value) void {}",
        "fn take_rows(i32*[2][2] value) void {}",
        "fn caller_bad(holder mut* h, i32 mut* own p) void {",
        "    i32*[2] t = {p, p}; h->arr = t; del(p); }",
        "fn caller_ok(holder mut* h, i32* q) void { i32*[2] t = {q, null}; h->arr = t; }",
        "fn param_bad(i32*[2] mut a, i32 mut* own p) void {",
        "    i32*[2] t = {p, p}; a = t; del(p); take_arr(a); }",
        "fn param_ok(i32*[2] mut a, i32 mut* own p) void {",
        "    i32*[2] t = {p, p}; a = t; take_arr(a); del(p); }",
        "fn field_bad(abox mut b, i32 mut* own p) void {",
        "    i32*[2] t = {p, p}; b.ps = t; del(p); take_abox(b); }",
        "fn field_ok(abox mut b, i32* q) void { i32*[2] t = {q, q}; b.ps = t; take_abox(b); }",
        "fn row_bad(i32*[2][2] mut m, i32 mut* own p) void {",
        "    i32*[2] r = {p, p}; m[0] = r; del(p); take_rows(m); }",
        "fn row_ok(i32*[2][2] mut m, i32* q) void { i32*[2] r = {q, q}; m[0] = r; take_rows(m); }",
        "fn heap_bad(i32 mut* own p) void { abox mut@ own a = new(abox, 2); i32*[2] t = {p, p};",
        "    a[1].ps = t; del(p); take_abox(a[1]); del(a); }",
        "fn heap_ok(i32* q) void { abox mut@ own a = new(abox, 2); i32*[2] t = {q, q};",
        "    a[1].ps = t; take_abox(a[1]); del(a); }",
        "fn global_store(i32 mut* own p) void { i32*[2] t = {p, p}; garr.ps = t; del(p); }",
        "fn global_copy() void { take_abox(garr); }",
        "fn copy_arr(mh mut* dst, mh* src) void { dst->ps = src->ps; }",
        "fn keep_arr(mh mut* dst, mh* src) void { i32 mut*[1] t = {null}; dst->ps = t; }",
        "fn null_first(i32 mut* own p) void { i32*[2] a = {null, p}; take_arr(a); del(p); }",
        "fn null_last(i32 mut* own p) void { i32*[2] a = {p, null}; take_arr(a); del(p); }",
        "fn zero_ok() void { i32*[2] a = {}; take_arr(a); }",
        "fn zero_box_ok() void { abox b = abox{}; take_abox(b); }",
        "fn zero_elem_bad(i32 mut* own p) void { i32*[2] mut a = {}; a[1] = p; del(p);",
        "    take_arr(a); }",
        "fn zero_field_bad(i32 mut* own p) void { abox mut b = abox{}; i32*[2] t = {p, p};",
        "    b.ps = t; del(p); take_abox(b); }",
        "fn zero_copy_bad(i32 mut* own p) void { i32*[2] mut a = {}; i32*[2] t = {p, null};",
        "    a = t; del(p); take_arr(a); }",
    };
    string[24] names = {"take_arr", "take_abox", "take_rows", "caller_bad", "caller_ok",
        "param_bad", "param_ok", "field_bad", "field_ok", "row_bad", "row_ok", "heap_bad",
        "heap_ok", "global_store", "global_copy", "copy_arr", "keep_arr", "null_first",
        "null_last", "zero_ok", "zero_box_ok", "zero_elem_bad", "zero_field_bad",
        "zero_copy_bad"};
    ownership_heap_env.closure mut c = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&c);
    ownership_heap_env.run(&c, text[..], names[..]);
    // A whole store into caller storage: the caller slot keeps the released element after the
    // return. Inputs and null stay valid.
    assert(ownership_heap_env.candidate(&c, "caller_bad", ownership_api.event_kind.invalid_use));
    assert(ownership_heap_env.events(&c, "caller_bad") == 1);
    assert(ownership_heap_env.proved(&c, "caller_ok"));
    // A whole store into a by-value parameter and into one of its fields, then a copy.
    assert(copy_candidate(&c, "param_bad", 12, "a reference that this call copies"));
    assert(ownership_heap_env.proved(&c, "param_ok"));
    assert(copy_candidate(&c, "field_bad", 16, "a reference that this call copies"));
    assert(ownership_heap_env.proved(&c, "field_ok"));
    // A row keeps the other row: the join of an input and a view of the body has no facts.
    assert(lost_copy(&c, "row_bad", 19, "a reference that this call copies"));
    assert(ownership_heap_env.proved(&c, "row_ok"));
    // Storage without slots records a reference of the body.
    assert(lost_copy(&c, "heap_bad", 22, "a reference that this call copies"));
    assert(ownership_heap_env.proved(&c, "heap_ok"));
    // Untracked storage cannot keep a reference of the body, and a global has no facts.
    assert(ownership_heap_env.unproved(&c, "global_store",
        ownership_api.incomplete_reason.unknown_effect));
    assert(ownership_heap_env.events(&c, "global_store") == 1);
    assert(ownership_heap_env.first(&c, "global_store").line == 25);
    assert(lost_copy(&c, "global_copy", 26, "a reference that this call copies"));
    // Mutable element references escape as a store of one element does. Null escapes nothing.
    assert(ownership_heap_env.proved(&c, "copy_arr"));
    assert((ownership_heap_env.summary(&c, "copy_arr")->address_escapes & 4) == 4);
    assert(ownership_heap_env.proved(&c, "keep_arr"));
    assert(ownership_heap_env.summary(&c, "keep_arr")->address_escapes == 0);
    // A null element keeps the view of the other element in either order.
    assert(ownership_heap_env.proved(&c, "null_first"));
    assert(ownership_heap_env.proved(&c, "null_last"));
    // A zero value holds no reference, as an array and as a field. A later store into it keeps
    // the facts of the stored references: one element joins, and a whole store replaces.
    assert(ownership_heap_env.proved(&c, "zero_ok"));
    assert(ownership_heap_env.proved(&c, "zero_box_ok"));
    assert(lost_copy(&c, "zero_elem_bad", 34, "a reference that this call copies"));
    assert(copy_candidate(&c, "zero_field_bad", 36, "a reference that this call copies"));
    assert(copy_candidate(&c, "zero_copy_bad", 38, "a reference that this call copies"));
}

// A struct below the path bound is one array leaf, as a fixed array is (`add_leaves`). A store
// of the whole struct replaces its slot. A store into a part of an owning leaf keeps the owner
// and gives incomplete proof at the store (D17.15, D17.17).
fn deep_leaves() void {
    println("array leaves below the path bound");
    string[18] text = {
        "struct d0 { i32* p; }",
        "struct d1 { d0 x; }",
        "struct d2 { d1 x; }",
        "struct d3 { d2 x; }",
        "struct d4 { d3 x; }",
        "struct d5 { d4 x; }",
        "struct d6 { d5 x; }",
        "struct e0 { i32 mut* own o; i32*[2] ps; }",
        "struct e1 { e0 x; }",
        "struct e2 { e1 x; }",
        "struct e3 { e2 x; }",
        "struct e4 { e3 x; }",
        "struct e5 { e4 x; }",
        "struct e6 { e5 x; }",
        "fn take6(d6 value) void {}",
        "fn deep_copy(d6 w) void { d6 mut v = w; take6(v); }",
        "fn deep_part(i32* q) void { e6 mut v = e6{}; i32*[2] t = {q, q};",
        "    v.x.x.x.x.x.x.ps = t; }",
    };
    string[3] names = {"take6", "deep_copy", "deep_part"};
    ownership_heap_env.closure mut c = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&c);
    ownership_heap_env.run(&c, text[..], names[..]);
    // The copy of `w` gives the leaf of `v` the input of `w`.
    assert(ownership_heap_env.proved(&c, "deep_copy"));
    // The zero value already puts an owner into the leaf at line 17. The array field is a part
    // of that owning leaf, so the store at line 18 gives incomplete proof of its own.
    assert(ownership_heap_env.unproved(&c, "deep_part",
        ownership_api.incomplete_reason.unknown_effect));
    assert(ownership_heap_env.events(&c, "deep_part") == 2);
    ownership_heap_env.event_row store = second_event(&c, "deep_part");
    assert(store.line == 18 &&
        str.starts_with(ownership_heap_env.text(&store), "the reference that this store puts"));
}

// The address of an element at an index that is not known to be zero keeps the key of its
// array at another byte offset. A cast of it to the array type is a cast store, so it cannot
// replace the whole array slot (D17.17). Index zero keeps the start of the array.
fn element_casts() void {
    println("casts of element addresses");
    string[28] text = {
        "fn take_arr(i32*[2] value) void {}",
        "fn cast_bad(i32 mut* own p, i32* q) void { i32*[2] mut a = {p, p}; del(p);",
        "    i32*[2] mut* pa = cast(&a[1], i32*[2] mut*); i32*[2] t = {q, q}; *pa = t;",
        "    take_arr(a); }",
        "fn cast_zero_ok(i32 mut* own p, i32* q) void { i32*[2] mut a = {p, p}; del(p);",
        "    i32*[2] mut* pa = cast(&a[0], i32*[2] mut*); i32*[2] t = {q, q}; *pa = t;",
        "    take_arr(a); }",
        "fn elem_ok(i32* q, i32* r) void { i32*[2] mut a = {q, q}; i32* mut* pe = &a[1];",
        "    *pe = r; take_arr(a); }",
        "fn join_bad(bool k, i32 mut* own p, i32* q) void { i32*[2] mut a = {p, p}; del(p);",
        "    i32*[2] mut* mut pa = &a; if (k) { pa = cast(&a[1], i32*[2] mut*); }",
        "    i32*[2] t = {q, q}; *pa = t; take_arr(a); }",
        "fn join2_bad(bool k, i32 mut* own p, i32* q) void { i32*[2] mut a = {p, p}; del(p);",
        "    i32*[2] mut* mut pa = cast(&a[1], i32*[2] mut*); if (k) { pa = &a; }",
        "    i32*[2] t = {q, q}; *pa = t; take_arr(a); }",
        "fn span_bad(i32 mut* own p, i32* q) void { i32*[2] mut a = {p, p}; del(p);",
        "    i32* mut@ sl = a[..]; i32*[2] mut* pa = cast(&sl[1], i32*[2] mut*);",
        "    i32*[2] t = {q, q}; *pa = t; take_arr(a); }",
        "fn span_start_bad(i32 mut* own p, i32* q) void { i32*[2] mut a = {p, p}; del(p);",
        "    i32* mut@ sl = a[1..]; i32*[2] mut* pa = cast(&sl[0], i32*[2] mut*);",
        "    i32*[2] t = {q, q}; *pa = t; take_arr(a); }",
        "fn span_elem_ok(i32* q, i32* r) void { i32*[2] mut a = {q, q}; i32* mut@ sl = a[..];",
        "    sl[1] = r; take_arr(a); }",
        "struct pph { i32*[2] mut* pp; }",
        "fn esc_store(pph mut* h, i32* q) void { i32*[2] mut a = {q, q};",
        "    h->pp = cast(&a[1], i32*[2] mut*); take_arr(a); h->pp = null; }",
        "fn esc_whole(pph mut* h, i32* q) void { i32*[2] mut a = {q, q};",
        "    h->pp = &a; take_arr(a); h->pp = null; }",
    };
    string[11] names = {"take_arr", "cast_bad", "cast_zero_ok", "elem_ok", "join_bad",
        "join2_bad", "span_bad", "span_start_bad", "span_elem_ok", "esc_store", "esc_whole"};
    ownership_heap_env.closure mut c = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&c);
    ownership_heap_env.run(&c, text[..], names[..]);
    // The cast store forgets the facts of the array, and the copy then gives incomplete proof.
    assert(!ownership_heap_env.proved(&c, "cast_bad"));
    assert(ownership_heap_env.proved(&c, "cast_zero_ok"));
    // A store of one element through its own address joins it into the slot.
    assert(ownership_heap_env.proved(&c, "elem_ok"));
    // A join of the start and an element address has no known offset, in either order.
    assert(!ownership_heap_env.proved(&c, "join_bad"));
    assert(!ownership_heap_env.proved(&c, "join2_bad"));
    // An address through a slice never matches the whole array type, also from index zero of a
    // slice that starts at index 1. A store of one element through the slice joins it.
    assert(!ownership_heap_env.proved(&c, "span_bad"));
    assert(!ownership_heap_env.proved(&c, "span_start_bad"));
    assert(ownership_heap_env.proved(&c, "span_elem_ok"));
    // An element address cast to the array type that leaves the body can write past the end of
    // the array, and the array forgets its facts, so the copy gives incomplete proof too. The
    // address of the whole array keeps them.
    assert(ownership_heap_env.events(&c, "esc_store") == 2);
    assert(ownership_heap_env.first(&c, "esc_store").line == 26);
    ownership_heap_env.event_row copied = second_event(&c, "esc_store");
    assert(copied.line == 26 &&
        ownership_heap_env.text(&copied) == "a reference that this call copies");
    assert(ownership_heap_env.proved(&c, "esc_whole"));
}

// The second event of body `name`, or a zero row.
fn second_event(ownership_heap_env.closure* c, string name) ownership_heap_env.event_row {
    u32 declaration = cast(ownership_heap_env.index(c, name) + 1, u32);
    u64 mut seen = 0;
    u64 mut i = 0;
    while (i < c->counts.events && i < c->counts.rows.len) {
        if (c->counts.rows[i].operation.function.declaration.declaration == declaration) {
            seen += 1;
            if (seen == 2) { return c->counts.rows[i]; }
        }
        i += 1;
    }
    return ownership_heap_env.event_row{};
}

// The only event of `name` is an invalid use of the copied leaf `leaf` with a definite
// certainty, at line `line`.
fn copy_candidate(ownership_heap_env.closure* c, string name, u32 line, string leaf) bool {
    ownership_heap_env.event_row row = ownership_heap_env.first(c, name);
    return ownership_heap_env.events(c, name) == 1 &&
        row.kind == ownership_api.event_kind.invalid_use &&
        row.certainty == ownership_api.certainty.definite &&
        row.reason == ownership_api.incomplete_reason.missing_path && row.line == line &&
        ownership_heap_env.text(&row) == leaf;
}

// The only event of `name` is an invalid use of the copied caller slot `leaf` at the call at line
// `line`. The callee copies on some path, so the certainty is possible (D17.18).
fn use_candidate(ownership_heap_env.closure* c, string name, u32 line, string leaf) bool {
    ownership_heap_env.event_row row = ownership_heap_env.first(c, name);
    return ownership_heap_env.events(c, name) == 1 &&
        row.kind == ownership_api.event_kind.invalid_use &&
        row.certainty == ownership_api.certainty.possible &&
        row.reason == ownership_api.incomplete_reason.missing_path && row.line == line &&
        ownership_heap_env.text(&row) == leaf;
}

// The only event of `name` is the incomplete proof of a call of a callee without a proof.
fn unproved_call(ownership_heap_env.closure* c, string name) bool {
    return ownership_heap_env.events(c, name) == 1 &&
        ownership_heap_env.unproved(c, name, ownership_api.incomplete_reason.unknown_effect) &&
        ownership_heap_env.first_text(c, name) == "a call of a function without a proof";
}

// The only event of `name` is incomplete proof of a copied leaf without facts, at line `line`.
fn lost_copy(ownership_heap_env.closure* c, string name, u32 line, string leaf) bool {
    ownership_heap_env.event_row row = ownership_heap_env.first(c, name);
    return ownership_heap_env.events(c, name) == 1 &&
        ownership_heap_env.unproved(c, name, ownership_api.incomplete_reason.unknown_effect) &&
        row.kind == ownership_api.event_kind.incomplete_proof && row.line == line &&
        ownership_heap_env.text(&row) == leaf;
}

// A copy of a borrowed reference is a use of it (D17.14): a scalar call argument, the value of an
// assignment, a whole aggregate copy or move by assignment, and each operand of a struct or array
// literal. Each copy checks the reference against the state at the copy, also when no later
// operation reads it. A copy of an owner needs nothing: a release or a move empties its place.
fn copied_scalars() void {
    println("copied scalar references");
    string[53] text = {
        "struct box { i32* p; }",
        "struct mixed { i32 mut* own o; i32* p; }",
        "struct holder { i32* p; }",
        "fn takep(i32* p) void {}",
        "fn takes(u8@ s) void {}",
        "fn arg_bad(i32 mut* own p) void { i32* x = p; del(p); takep(x); }",
        "fn arg_ok(i32 mut* own p) void { i32* x = p; takep(x); del(p); }",
        "fn copy_bad(i32 mut* own p) void { i32* x = p; del(p); i32* y = x; }",
        "fn copy_ok(i32 mut* own p) void { i32* x = p; i32* y = x; del(p); }",
        "fn whole_bad(i32 mut* own p) void { box b = box{p}; del(p); box c = b; }",
        "fn whole_ok(i32 mut* own p) void { box b = box{p}; box c = b; del(p); }",
        "fn moved_bad(i32 mut* own p) void { mixed mut m = mixed{new(i32), p}; del(p);",
        "    mixed n = move(m); del(n.o); }",
        "fn moved_ok(i32 mut* own p) void { mixed mut m = mixed{new(i32), p};",
        "    mixed n = move(m); del(p); del(n.o); }",
        "fn field_bad(i32 mut* own p) void { i32* x = p; del(p); box b = box{x}; }",
        "fn element_bad(i32 mut* own p) void { i32* x = p; del(p); i32*[2] a = {x, x}; }",
        "fn store_bad(i32 mut* own p) void { i32* x = p; box mut b = box{null}; del(p);",
        "    b.p = x; }",
        "fn ended_bad() void { i32* mut q = null; { i32 z = 1; q = &z; } takep(q); }",
        "fn ended_ok() void { i32* mut q = null; { i32 z = 1; q = &z; takep(q); } }",
        "fn cell_bad() void { holder mut* own h = new(holder); i32* mut* a = &h->p; del(h);",
        "    i32* mut* b = a; }",
        "fn span_bad() void { u8 mut@ own b = new(u8, 4); u8@ v = b; del(b); takes(v); }",
        "fn cast_bad(i32 mut* own p) void { i32* x = p; del(p); takep(cast(x, i32*)); }",
        "fn owner_ok(i32 mut* own p, bool k) i32 mut* own { if (k) { del(p); } takep(p);",
        "    return move(p); }",
        "fn input_ok(i32* q, holder* h) void { i32* x = q; takep(x); takep(h->p); }",
        "fn null_ok() void { i32* x = null; takep(x); }",
        "fn text_ok() void { string s = \"x\"; string t = s; }",
        "fn lost_bad(bool k, i32 mut* own p) void { i32 z = 1; i32* mut x = &z;",
        "    if (k) { x = p; } del(p); takep(x); }",
        "i32* mut gp = null;",
        "fn global_copy() void { takep(gp); }",
        "fn compared(i32 mut* own p) bool { i32* x = p; del(p); return x == null; }",
        "fn kept_ok(i32 mut* own p) void { i32* x = p; del(p); }",
        "fn returned_bad(i32 mut* own p) i32* { i32* x = p; del(p); return x; }",
        "fn unused_ok(i32 mut* own p) void { i32* x = p; del(p); i32* mut y = null; y = null; }",
        "fn owner_view_ok(i32 mut* own p, bool k) i32 mut* own { i32* v = p; if (k) { del(p); }",
        "    takep(p); return move(p); }",
        "i32 mut gv = 0;",
        "fn gaddr_ok() void { takep(&gv); }",
        "fn gaddr_ret_ok() i32* { return &gv; }",
        "fn elem_ok(i32* q) void { i32*[2] t = {q, q}; takep(t[1]); }",
        "fn elem_bad(i32 mut* own p) void { i32* x = p; i32*[2] t = {x, x}; del(p);",
        "    takep(t[0]); }",
        "extern fn ext_set(i32* mut* out) void;",
        "fn lost_callee(i32* q) i32 { i32* mut r = q; ext_set(&r); takep(r); return *q; }",
        "fn null_pass_bad() i32 { return lost_callee(null); }",
        "fn lost_int(i32 k) i32 { i32 z = k; i32* mut r = &z; ext_set(&r); takep(r); return k; }",
        "fn scalar_pass_ok() i32 { return lost_int(1); }",
        "fn lost_box(box b) i32 { i32* mut r = b.p; ext_set(&r); takep(r); return *b.p; }",
        "fn box_pass_bad() i32 { box b = box{null}; return lost_box(b); }",
    };
    string[39] names = {"takep", "takes", "arg_bad", "arg_ok", "copy_bad", "copy_ok", "whole_bad",
        "whole_ok", "moved_bad", "moved_ok", "field_bad", "element_bad", "store_bad", "ended_bad",
        "ended_ok", "cell_bad", "span_bad", "cast_bad", "owner_ok", "input_ok", "null_ok",
        "text_ok", "lost_bad", "global_copy", "compared", "kept_ok", "returned_bad",
        "unused_ok", "owner_view_ok", "gaddr_ok", "gaddr_ret_ok", "elem_ok", "elem_bad",
        "lost_callee", "null_pass_bad", "lost_int", "scalar_pass_ok", "lost_box", "box_pass_bad"};
    ownership_heap_env.closure mut c = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&c);
    ownership_heap_env.run(&c, text[..], names[..]);
    // A scalar argument, a scalar copy, and their copies before the release.
    assert(copy_candidate(&c, "arg_bad", 6, "x"));
    assert(ownership_heap_env.proved(&c, "arg_ok"));
    assert(copy_candidate(&c, "copy_bad", 8, "x"));
    assert(ownership_heap_env.proved(&c, "copy_ok"));
    // A whole copy and a whole move by assignment use each borrowed leaf.
    assert(copy_candidate(&c, "whole_bad", 10, "b.p"));
    assert(ownership_heap_env.proved(&c, "whole_ok"));
    assert(copy_candidate(&c, "moved_bad", 13, "m.p"));
    assert(ownership_heap_env.proved(&c, "moved_ok"));
    // A struct literal, an array literal and a field store copy `x`. Two elements of one literal
    // give one event.
    assert(copy_candidate(&c, "field_bad", 16, "x"));
    assert(copy_candidate(&c, "element_bad", 17, "x"));
    assert(copy_candidate(&c, "store_bad", 19, "x"));
    // An address of an ended local, an address into a released cell, and a released span.
    assert(copy_candidate(&c, "ended_bad", 20, "q"));
    assert(ownership_heap_env.proved(&c, "ended_ok"));
    assert(copy_candidate(&c, "cell_bad", 23, "a"));
    assert(copy_candidate(&c, "span_bad", 24, "v"));
    // A cast result keeps its source. Its temporary has no name, so the text is fixed.
    assert(copy_candidate(&c, "cast_bad", 25, "a reference that this call copies"));
    // On the release path the owner is empty, so its copy needs nothing. In `owner_view_ok` the
    // view `v` also keeps the released atom on that path.
    assert(ownership_heap_env.proved(&c, "owner_ok"));
    assert(ownership_heap_env.proved(&c, "owner_view_ok"));
    // Inputs of the caller, null, and static text need nothing.
    assert(ownership_heap_env.proved(&c, "input_ok"));
    assert(ownership_heap_env.proved(&c, "null_ok"));
    assert(ownership_heap_env.proved(&c, "text_ok"));
    // A reference whose facts the body lost gives incomplete proof at its copy.
    assert(lost_copy(&c, "lost_bad", 32, "x"));
    // The proof keeps no fact of a mutable global, so the copy of its reference is lost (a
    // precision limit). The global place has no slot, so the text is fixed.
    assert(lost_copy(&c, "global_copy", 34, "a reference that this call copies"));
    // A comparison is no copy, and a dangling local that no operation copies needs nothing.
    assert(ownership_heap_env.proved(&c, "compared"));
    assert(ownership_heap_env.proved(&c, "kept_ok"));
    assert(ownership_heap_env.proved(&c, "unused_ok"));
    // The copy into the result and the return each record an event.
    assert(ownership_heap_env.candidate(&c, "returned_bad", ownership_api.event_kind.invalid_use));
    assert(ownership_heap_env.events(&c, "returned_bad") == 2);
    assert(ownership_heap_env.first(&c, "returned_bad").line == 37);
    // The address of a global designates static storage, so its copy and its return need
    // nothing (D17.14).
    assert(ownership_heap_env.proved(&c, "gaddr_ok"));
    assert(ownership_heap_env.proved(&c, "gaddr_ret_ok"));
    // A read of one element of a fixed array of references gives no fact, so its copy is lost:
    // a precision limit for a valid copy, and incomplete proof for a dangling one.
    assert(lost_copy(&c, "elem_ok", 44, "t"));
    assert(lost_copy(&c, "elem_bad", 46, "t"));
    // The copy of `r` after the extern call is lost, so `lost_callee` has no proof. A caller
    // that passes it a reference gives incomplete proof at the call, because the callee
    // publishes no requirement. A caller that passes a scalar can violate no requirement.
    assert(ownership_heap_env.unproved(&c, "lost_callee",
        ownership_api.incomplete_reason.unknown_effect));
    assert(unproved_call(&c, "null_pass_bad"));
    assert(!ownership_heap_env.proved(&c, "lost_int"));
    assert(ownership_heap_env.proved(&c, "scalar_pass_ok"));
    // A reference leaf of a by-value aggregate argument counts as a reference.
    assert(!ownership_heap_env.proved(&c, "lost_box"));
    assert(unproved_call(&c, "box_pass_bad"));
}

// Whether the use set of `name` holds exactly the caller slots `uses`, in order: each a caller
// storage base, its id and its first field.
fn entry_uses_are(ownership_heap_env.closure* c, string name, u32[2]@ uses) bool {
    ownership_heap.summary* s = ownership_heap_env.summary(c, name);
    if (cast(s->entry_uses.len, u64) != uses.len) { return false; }
    u64 mut i = 0;
    while (i < uses.len) {
        ownership_heap.slot_key k = s->entry_uses.items[i];
        if (k.base != ownership_heap.base_kind.caller || k.id != uses[i][0] || k.depth == 0 ||
            k.path[0] != uses[i][1]) { return false; }
        i += 1;
    }
    return true;
}

// The first event of `name` is incomplete proof with the text `what` at line `line`.
fn unproved_at(ownership_heap_env.closure* c, string name, u32 line, string what) bool {
    ownership_heap_env.event_row row = ownership_heap_env.first(c, name);
    return row.kind == ownership_api.event_kind.incomplete_proof &&
        row.reason == ownership_api.incomplete_reason.unknown_effect && row.line == line &&
        ownership_heap_env.text(&row) == what;
}

// A callee that loads a reference from caller storage and copies it uses the reference that the
// caller holds in that slot (D17.14, `spec/fir.md` 14.1). The callee cannot check it, so its
// summary names the slot, and the caller checks its own value of the slot at the call. A
// wrapper passes an entry value of its own on. The summary does not order a copy and a release
// of the callee, so the reference must not designate storage that the callee releases. Storage
// that the call cannot bind, and a set of more than 16 slots, give incomplete proof.
fn loaded_copies() void {
    println("copies of loaded caller references");
    string[43] text = {
        "struct ph { i32* p; }",
        "struct outer { ph inner; }",
        "struct box { i32 mut* own c; }",
        "fn pick(ph* h) i32* { return h->p; }",
        "fn copy_over(ph mut* d, ph* s) void { d->p = s->p; }",
        "fn wrap_copy(ph mut* d, ph* s) void { copy_over(d, s); }",
        "fn peek(ph* h) void { i32* c = h->p; }",
        "fn both(ph* a, outer* o) void { i32* x = a->p; i32* y = o->inner.p; i32* z = x; }",
        "fn rel_copy(box mut* bx, ph mut* d, ph* s) void { del(bx->c); d->p = s->p; }",
        "fn noop(ph* h) void {}",
        "fn copy_bad(i32 mut* own p) void { ph s = ph{p}; ph mut d = ph{null}; del(p);",
        "    copy_over(&d, &s); }",
        "fn copy_ok(i32 mut* own p) void { ph s = ph{p}; ph mut d = ph{null}; copy_over(&d, &s);",
        "    del(p); }",
        "fn wrap_bad(i32 mut* own p) void { ph s = ph{p}; ph mut d = ph{null}; del(p);",
        "    wrap_copy(&d, &s); }",
        "fn peek_bad(i32 mut* own p) void { ph h = ph{p}; del(p); peek(&h); }",
        "fn noop_ok(i32 mut* own p) void { ph h = ph{p}; del(p); noop(&h); }",
        "fn input_ok(ph* h) void { peek(h); }",
        "fn cell_bad(i32 mut* own p) void { ph mut* own n = new(ph); n->p = p; del(p); peek(n);",
        "    del(n); }",
        "fn ended_bad() void { ph mut h = ph{null}; { i32 x = 1; h.p = &x; } peek(&h); }",
        "fn release_bad() void { box mut bx = box{new(i32)}; ph s = ph{bx.c}; ph mut d = ph{null};",
        "    rel_copy(&bx, &d, &s); }",
        "fn release_ok(i32* q) void { box mut bx = box{new(i32)}; ph s = ph{q};",
        "    ph mut d = ph{null}; rel_copy(&bx, &d, &s); }",
        "fn span_peek(i32* q) void { ph mut@ own sp = new(ph, 2); sp[1].p = q; peek(&sp[1]);",
        "    del(sp); }",
        "struct wide { i32* a; i32* b; i32* c; i32* d; i32* e; i32* f; i32* g; i32* h; i32* i;",
        "    i32* j; i32* k; i32* l; i32* m; i32* n; i32* o; i32* p; i32* q; }",
        "fn copy_all(wide* w) void { i32* xa = w->a; i32* xb = w->b; i32* xc = w->c;",
        "    i32* xd = w->d; i32* xe = w->e; i32* xf = w->f; i32* xg = w->g; i32* xh = w->h;",
        "    i32* xi = w->i; i32* xj = w->j; i32* xk = w->k; i32* xl = w->l; i32* xm = w->m;",
        "    i32* xn = w->n; i32* xo = w->o; i32* xp = w->p;",
        "    i32* xq = w->q; }",
        "fn copy_most(wide* w) void { i32* xa = w->a; i32* xb = w->b; i32* xc = w->c;",
        "    i32* xd = w->d; i32* xe = w->e; i32* xf = w->f; i32* xg = w->g; i32* xh = w->h;",
        "    i32* xi = w->i; i32* xj = w->j; i32* xk = w->k; i32* xl = w->l; i32* xm = w->m;",
        "    i32* xn = w->n; i32* xo = w->o; i32* xp = w->p; }",
        "fn wide_call(wide* w) void { copy_all(w); }",
        "fn keep_copy(box mut* bx, ph mut* d, ph* s) void { d->p = s->p; }",
        "fn keep_ok() void { box mut bx = box{new(i32)}; ph s = ph{bx.c}; ph mut d = ph{null};",
        "    keep_copy(&bx, &d, &s); del(bx.c); }",
    };
    string[23] names = {"pick", "copy_over", "wrap_copy", "peek", "both", "rel_copy", "noop",
        "copy_bad", "copy_ok", "wrap_bad", "peek_bad", "noop_ok", "input_ok", "cell_bad",
        "ended_bad", "release_bad", "release_ok", "span_peek", "copy_all", "copy_most",
        "wide_call", "keep_copy", "keep_ok"};
    ownership_heap_env.closure mut c = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&c);
    ownership_heap_env.run(&c, text[..], names[..]);
    // A copy into the result, into caller storage and into a local each name the slot. A
    // wrapper names the slot of its own caller storage, and a callee that copies nothing names
    // none. Each body proves.
    u32[1][2] first = {{0, 0}};
    u32[1][2] second = {{1, 0}};
    u32[2][2] two = {{0, 0}, {1, 0}};
    u32[1][2] none = {};
    assert(ownership_heap_env.proved(&c, "pick") && entry_uses_are(&c, "pick", first[..]));
    assert(ownership_heap_env.proved(&c, "copy_over") &&
        entry_uses_are(&c, "copy_over", second[..]));
    assert(ownership_heap_env.proved(&c, "wrap_copy") &&
        entry_uses_are(&c, "wrap_copy", second[..]));
    assert(ownership_heap_env.proved(&c, "peek") && entry_uses_are(&c, "peek", first[..]));
    assert(ownership_heap_env.proved(&c, "noop") && entry_uses_are(&c, "noop", none[..0]));
    // Two slots of two caller storages, in key order. A copy of a copy names no slot again.
    assert(ownership_heap_env.proved(&c, "both") && entry_uses_are(&c, "both", two[..]));
    assert(ownership_heap_env.summary(&c, "both")->entry_uses.items[1].depth == 2);
    // The caller checks its value of the slot at the call: a released view, through one
    // wrapper too, a released source of a cell field, and an address of an ended local. The
    // callee copies on some path, so each candidate is possible (D17.18).
    assert(use_candidate(&c, "copy_bad", 12, "s.p"));
    assert(ownership_heap_env.proved(&c, "copy_ok"));
    assert(use_candidate(&c, "wrap_bad", 16, "s.p"));
    assert(use_candidate(&c, "peek_bad", 17, "h.p"));
    assert(use_candidate(&c, "cell_bad", 20, "n->p"));
    assert(use_candidate(&c, "ended_bad", 22, "h.p"));
    // A dangling slot that the callee does not copy needs nothing. An entry value of the
    // caller passes the use on to its own callers.
    assert(ownership_heap_env.proved(&c, "noop_ok"));
    assert(ownership_heap_env.proved(&c, "input_ok") &&
        entry_uses_are(&c, "input_ok", first[..]));
    // The callee releases `bx->c` and copies `s->p`, which views it: the release can come first.
    assert(unproved_at(&c, "release_bad", 24, "that the arguments of this call are separate"));
    assert(ownership_heap_env.proved(&c, "release_ok"));
    // A bound atom that the callee keeps can own the storage of the copied reference.
    assert(ownership_heap_env.proved(&c, "keep_ok"));
    // An element of a span is a flat atom, so the call cannot bind its caller storage.
    assert(unproved_at(&c, "span_peek", 27,
        "the caller storage of a reference that this call copies"));
    // 16 slots fit the set. A 17th gives incomplete proof, and the summary is residual, so a
    // caller that passes a reference gives incomplete proof at the call.
    assert(ownership_heap_env.proved(&c, "copy_most"));
    assert(ownership_heap_env.summary(&c, "copy_most")->entry_uses.len == 16);
    assert(unproved_at(&c, "copy_all", 35,
        "each copied reference of caller storage within its list"));
    assert(ownership_heap_env.summary(&c, "copy_all")->residual);
    assert(ownership_heap_env.first_text(&c, "wide_call") ==
        "a call of a function without a proof");
    // In a recursive component a use reaches one more member in each round: the members run in
    // their order, and only `ring_f` copies. Each member reads `h->n`, so the other facts stop
    // changing after round 2. The fixed point must compare the use sets too. Without that
    // comparison the solve stops after round 3, `ring_a` and `ring_b` name no slot, and
    // `ring_bad` proves (measured on 2026-10-18).
    string[10] ring = {
        "struct ph { i32* p; u32 n; }",
        "fn ring_a(ph* h) void { if (h->n == 0) { return; } ring_b(h); }",
        "fn ring_b(ph* h) void { if (h->n == 0) { return; } ring_c(h); }",
        "fn ring_c(ph* h) void { if (h->n == 0) { return; } ring_d(h); }",
        "fn ring_d(ph* h) void { if (h->n == 0) { return; } ring_e(h); }",
        "fn ring_e(ph* h) void { if (h->n == 0) { return; } ring_f(h); }",
        "fn ring_f(ph* h) void { i32* c = h->p; if (h->n == 0) { return; }",
        "    ring_a(h); }",
        "fn ring_bad(i32 mut* own p) void { ph h = ph{p, 4}; del(p); ring_a(&h); }",
        "fn ring_ok(i32 mut* own p) void { ph h = ph{p, 4}; ring_a(&h); del(p); }",
    };
    string[8] ring_names = {"ring_a", "ring_b", "ring_c", "ring_d", "ring_e", "ring_f", "ring_bad",
        "ring_ok"};
    ownership_heap_env.closure mut r = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&r);
    ownership_heap_env.run(&r, ring[..], ring_names[..]);
    u64 mut m = 0;
    while (m < 6) {
        assert(ownership_heap_env.proved(&r, ring_names[m]) &&
            entry_uses_are(&r, ring_names[m], first[..]));
        m += 1;
    }
    assert(ownership_heap_env.rounds(&r, "ring_a") > 5);
    assert(use_candidate(&r, "ring_bad", 9, "h.p"));
    assert(ownership_heap_env.proved(&r, "ring_ok"));
}

// A copy needs nothing only when it names the caller slot of its entry value, or when its value
// is valid by a fact of the proof: static data, a view of a parameter, or a reference that this
// body copied into storage that it made (D17.14, `spec/fir.md` 14.1). A join of entry values of
// two caller slots, or of a stored element with one, names the slot that a later copy reads. A
// cast or a slice that moves a reference out of a caller slot names the slot too. A reference
// that a caller stored in heap storage, or in the storage of a span or a pointer parameter, has
// no check that covers it, so its copy gives incomplete proof.
fn loaded_inputs() void {
    println("copies of loaded inputs");
    string[45] text = {
        "struct ph { i32* p; }",
        "struct arrh { i32*[2] ps; }",
        "struct node { i32* v; node mut* own next; i32 n; }",
        "struct list { node mut* own head; }",
        "struct inner { i32* v; }",
        "struct boxi { inner mut* own h; }",
        "struct wp { ph* inner; }",
        "fn join_two(ph mut* h, ph* g, bool f) void { if (f) { h->p = g->p; } i32* c = h->p; }",
        "fn join_bad(i32 mut* own b, i32* k, bool f) void { ph mut h = ph{b}; ph g = ph{k};",
        "    del(b); join_two(&h, &g, f); }",
        "fn join_ok(i32* b, i32* k, bool f) void { ph mut h = ph{b}; ph g = ph{k};",
        "    join_two(&h, &g, f); }",
        "fn weak(arrh mut* h, i32* q) void { h->ps[0] = q; arrh t = *h; }",
        "fn weak_bad(i32 mut* own b, i32* k) void { arrh mut a = arrh{{k, b}}; del(b);",
        "    weak(&a, k); }",
        "fn weak_ok(i32* b, i32* k) void { arrh mut a = arrh{{k, b}}; weak(&a, k); }",
        "fn peekv(list* l) i32* { return l->head->v; }",
        "fn region_join(list mut* l, ph* g, bool f) void { i32 x = l->head->n;",
        "    if (f) { l->head->v = g->p; } i32* c = l->head->v; }",
        "fn peek_mid(boxi* l) void { i32* c = l->h->v; }",
        "fn own_param(inner mut* own o) void { i32* c = o->v; del(o); }",
        "fn span_el(i32*@ ps) void { i32* c = ps[0]; }",
        "fn byval_load(wp w) void { i32* c = w.inner->p; }",
        "fn span_el_bad(i32 mut* own b) void { i32*[1] mut arr = {b}; del(b);",
        "    span_el(arr[..]); }",
        "fn byval_bad(i32 mut* own b) void { ph h = ph{b}; del(b); byval_load(wp{&h}); }",
        "fn fresh_ok(i32* q) void { inner mut@ own a = new(inner, 1); a[0].v = q;",
        "    i32* c = a[0].v; del(a); }",
        "fn drop(node mut* own n) void { if (n == null) { return; } drop(move(n->next)); del(n); }",
        "fn mk_copy(i32* p, u64 k) void { node mut* own mut h = null; u64 mut i = 0;",
        "    while (i < k) { node mut* own n = new(node); n->v = p; n->next = move(h);",
        "        h = move(n); i += 1; } if (h != null) { i32* c = h->v; } drop(move(h)); }",
        "struct hs { u8@ s; }",
        "fn join_cast(ph mut* h, ph* g, bool f) void { if (f) { h->p = g->p; }",
        "    i32* c = cast(h->p, i32*); i32* d = c; }",
        "fn cast_bad(i32 mut* own b, i32* k, bool f) void { ph mut h = ph{b}; ph g = ph{k};",
        "    del(b); join_cast(&h, &g, f); }",
        "fn cast_ok(i32* b, i32* k, bool f) void { ph mut h = ph{b}; ph g = ph{k};",
        "    join_cast(&h, &g, f); }",
        "fn view(hs* h) u8@ { return h->s[..]; }",
        "fn slice_bad(u8 mut@ own b) void { hs h = hs{b[..4]}; del(b); u8@ v = view(&h); }",
        "fn slice_ok(u8 mut@ own b) void { hs h = hs{b[..4]}; u8@ v = view(&h); del(b); }",
        "fn join_view(hs mut* h, hs* g, bool f) u8@ { if (f) { h->s = g->s; } return h->s[..]; }",
        "fn jslice_bad(u8 mut@ own b, u8@ k, bool f) void { hs mut h = hs{b[..4]}; hs g = hs{k};",
        "    del(b); u8@ v = join_view(&h, &g, f); }",
    };
    string[25] names = {"join_two", "join_bad", "join_ok", "weak", "weak_bad", "weak_ok", "peekv",
        "region_join", "peek_mid", "own_param", "span_el", "byval_load", "span_el_bad",
        "byval_bad", "fresh_ok", "drop", "mk_copy", "join_cast", "cast_bad", "cast_ok", "view",
        "slice_bad", "slice_ok", "join_view", "jslice_bad"};
    ownership_heap_env.closure mut c = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&c);
    ownership_heap_env.run(&c, text[..], names[..]);
    u32[1][2] first = {{0, 0}};
    u32[2][2] both = {{0, 0}, {1, 0}};
    // A join of the entry values of `h->p` and `g->p` names `h->p` at its copy from that slot.
    assert(ownership_heap_env.proved(&c, "join_two") &&
        entry_uses_are(&c, "join_two", both[..]));
    assert(use_candidate(&c, "join_bad", 10, "h.p"));
    assert(ownership_heap_env.proved(&c, "join_ok"));
    // A store of one element joins it with the entry value of the array, so the whole copy
    // names the array slot.
    assert(ownership_heap_env.proved(&c, "weak") && entry_uses_are(&c, "weak", first[..]));
    assert(use_candidate(&c, "weak_bad", 15, "a reference that this call copies"));
    assert(ownership_heap_env.proved(&c, "weak_ok"));
    // A field of an entry region holds a stored input, also after a join with an entry value.
    assert(unproved_at(&c, "peekv", 17, "l->head->v"));
    assert(unproved_at(&c, "region_join", 19, "l->head->v"));
    // A field of a flat member of an input, of an element of a span parameter, and behind a
    // pointer leaf of a by-value aggregate. A caller that passes a reference to such a callee
    // gives incomplete proof at the call.
    assert(unproved_at(&c, "peek_mid", 20, ownership_heap.ASSIGNMENT_COPY));
    assert(unproved_at(&c, "own_param", 21, ownership_heap.ASSIGNMENT_COPY));
    assert(unproved_at(&c, "span_el", 22, ownership_heap.ASSIGNMENT_COPY));
    assert(unproved_at(&c, "byval_load", 23, ownership_heap.ASSIGNMENT_COPY));
    assert(unproved_call(&c, "span_el_bad"));
    assert(unproved_call(&c, "byval_bad"));
    // Storage and a region that this body made keep what it copied there: a view of `q` or `p`.
    assert(ownership_heap_env.proved(&c, "fresh_ok"));
    assert(ownership_heap_env.proved(&c, "mk_copy"));
    // A cast and a slice move a reference out of a caller slot without a copy, so each names the
    // slot: a joined input names the slot that it leaves, and an entry value names its own.
    assert(ownership_heap_env.proved(&c, "join_cast") &&
        entry_uses_are(&c, "join_cast", both[..]));
    assert(use_candidate(&c, "cast_bad", 37, "h.p"));
    assert(ownership_heap_env.proved(&c, "cast_ok"));
    assert(ownership_heap_env.proved(&c, "view") && entry_uses_are(&c, "view", first[..]));
    assert(use_candidate(&c, "slice_bad", 41, "h.s"));
    assert(ownership_heap_env.proved(&c, "slice_ok"));
    assert(ownership_heap_env.proved(&c, "join_view") &&
        entry_uses_are(&c, "join_view", both[..]));
    assert(use_candidate(&c, "jslice_bad", 45, "h.s"));
}

fn main() i32 {
    caller_storage();
    separate_instances();
    shape_requirements();
    recursion();
    unknown_effects();
    views_at_call();
    aggregates();
    write_footprints();
    copied_leaves();
    copied_scalars();
    array_stores();
    deep_leaves();
    element_casts();
    loaded_copies();
    loaded_inputs();
    println("heap calls ok");
    return 0;
}
