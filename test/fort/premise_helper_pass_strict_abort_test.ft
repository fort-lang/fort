//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: the verifier refuses MIXED
//! stderr: fir.verify: V16 a return with a live scratch temporary: main.leaks bb0 statement 1
//! stdout:
//| ready
/// pass_env.verified_each stops the test for a text with a function that breaks a premise rule of
/// the verifier.
import fort.fir;
import lower_env;
import pass_env;
import premise_env;

// A panic ends the program, so the case stands in a file of its own.
fn main() i32 {
    lower_env.env mut* own e = lower_env.make();
    defer lower_env.drop_made(move(e));
    fir.module mut* own m = pass_env.parse_made(e, premise_env.PRELUDE[..], premise_env.MIXED[..]);
    defer fir.module_drop_made(move(m));
    println("ready");
    pass_env.verified_each(e, m, "the verifier refuses MIXED");
    return 0;
}
