//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: pass_env.breaks_premise: the function goes through pass_env.verified
//! stderr: the function plain keeps each premise rule
//! stdout:
//| ready
/// pass_env.breaks_premise stops the test for a function that keeps the 16 rules of the verifier:
/// such a function goes through the strict helper pass_env.verified.
import fort.fir;
import lower_env;
import pass_env;
import premise_env;

// A panic ends the program, so the case stands in a file of its own.
fn main() i32 {
    lower_env.env mut* own e = lower_env.make();
    defer lower_env.drop_made(move(e));
    fir.module mut* own m = pass_env.parse_made(e, premise_env.PRELUDE[..], premise_env.KEEP[..]);
    defer fir.module_drop_made(move(m));
    println("ready");
    pass_env.breaks_premise(e, fir.module_function_at(m, 0), "the verifier refuses KEEP");
    return 0;
}
