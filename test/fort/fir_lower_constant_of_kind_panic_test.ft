//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: fir_lower.constant_of: a folded value of another kind than its type
//! stdout:
//| true
/// The checker folds a value of the kind of its type: a float for a float type, and no float
/// for another type. A float value for i32 breaks that precondition, so the call panics.
import consts;
import fir;
import fir_lower;
import prim;
import types;

fn main() i32 {
    types.table mut tt = types.table{};
    defer types.type_table_free(&tt);
    types.node* i32t = types.type_prim(&tt, prim.prim_kind.prim_i32);
    fir.constant c = fir_lower.constant_of(i32t, consts.cv_from_i64(1));
    println(c.kind == fir.const_kind.ck_int);
    fir_lower.constant_of(i32t, consts.cv_from_float(0x3FF0000000000000));
    return 0;
}
