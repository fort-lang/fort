//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| owner allocator mode 4 released
//| required B26.kernel_allocator_teardown accept
/// Measures one populated allocator mode within the production execution limit.
import ownership_raw_bytes_cleanup_env;
fn main() i32 {
    ownership_raw_bytes_cleanup_env.owner_allocator_probe(4);
    println("owner allocator mode 4 released");
    println("required B26.kernel_allocator_teardown accept");
    return 0;
}
