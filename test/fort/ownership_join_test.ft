//! run
//! flags: -I ../../src/fort
//! stdout:
//| G04.3 G05.1 G05.2
//| G06.3 cycle join and widening
//| duplicate union records
//| bottom duplicate normalization
/// Tests conservative predecessor joins in both operand orders.
import ownership_api;
import ownership_events;
import ownership_join;
import ownership_limits;
import ownership_state;

fn id(ownership_api.entity_kind kind, u32 ordinal) ownership_api.entity_id {
    ownership_api.entity_id mut out = ownership_api.entity_id{};
    out.kind = kind;
    out.ordinal = ordinal;
    return out;
}

fn place(u32 ordinal) ownership_api.place_path {
    ownership_api.place_path mut out = ownership_api.place_path{};
    out.root = id(ownership_api.entity_kind.slot, ordinal);
    return out;
}

fn allocation(u32 ordinal, u32 site, u32 owner)
    ownership_api.allocation_fact {
    ownership_api.allocation_fact mut out = ownership_api.allocation_fact{};
    out.key = id(ownership_api.entity_kind.allocation, ordinal);
    out.site = id(ownership_api.entity_kind.allocation, site);
    out.validity = ownership_api.validity_kind.live;
    out.count.one = true;
    out.obligation = true;
    out.owner.place = place(owner);
    out.logical_length.kind = ownership_api.fact_kind.exact;
    out.logical_length.value = 1;
    return out;
}

fn contents(u32 slot, u32 value) ownership_api.contents_fact {
    ownership_api.contents_fact mut out = ownership_api.contents_fact{};
    out.place = place(slot);
    out.kind = ownership_api.contents_kind.reference;
    out.value_version = id(ownership_api.entity_kind.value, value);
    return out;
}

fn setup(ownership_events.store mut* events, ownership_api.services mut* svc) void {
    ownership_api.limit_table limits = ownership_limits.production();
    assert(ownership_events.bind(events, &limits, svc));
}

fn op(u32 ordinal) ownership_api.operation_position {
    ownership_api.operation_position mut out = ownership_api.operation_position{};
    out.operation = ordinal;
    return out;
}

fn joined(ownership_state.state* a, ownership_state.state* b,
    ownership_api.services* svc, ownership_api.operation_position at,
    ownership_api.source_position source) ownership_state.state {
    ownership_api.limit_table bounds = ownership_limits.production();
    return ownership_join.join(a, b, svc, &bounds, at, source);
}

fn alternatives(ownership_api.services* svc) void {
    ownership_state.state mut a = ownership_state.empty();
    ownership_state.state mut b = ownership_state.empty();
    ownership_api.operation_position at = op(1);
    ownership_api.source_position source = ownership_api.source_position{};
    ownership_api.place_path[2] slots = {place(1), place(2)};
    assert(ownership_state.add_contents(&a, svc, contents(1, 1), at, source).applied);
    assert(ownership_state.add_contents(&b, svc, contents(1, 2), at, source).applied);
    assert(ownership_state.weak_contents(&a, svc, contents(1, 3), slots[..],
        id(ownership_api.entity_kind.guard, 1), at, source).applied);
    assert(ownership_state.weak_contents(&b, svc, contents(1, 4), slots[..],
        id(ownership_api.entity_kind.guard, 2), at, source).applied);
    ownership_state.state mut ab = joined(&a, &b, svc, at, source);
    ownership_state.state mut ba = joined(&b, &a, svc, at, source);
    assert(ownership_state.equal(&ab, &ba));
    ownership_api.state_view view = ownership_state.view(&ab);
    assert(ownership_api.successful(view.proof));
    assert(view.contents.len == 6 && view.correlations.len == 4);
    assert(view.contents[0].value_version.ordinal == 1);
    assert(view.contents[3].value_version.ordinal == 2);
    ownership_state.free(&ba);
    ownership_state.free(&ab);
    ownership_state.free(&b);
    ownership_state.free(&a);
}

fn empty_and_live(ownership_api.services* svc) void {
    ownership_state.state mut empty = ownership_state.empty();
    ownership_state.state mut live = ownership_state.empty();
    ownership_api.allocation_fact fact = allocation(1, 8, 1);
    ownership_api.operation_position at = op(2);
    ownership_api.source_position source = ownership_api.source_position{};
    assert(ownership_state.add_allocation(&live, svc, fact, at, source).applied);
    ownership_state.state mut ab = joined(&empty, &live, svc, at, source);
    ownership_state.state mut ba = joined(&live, &empty, svc, at, source);
    assert(ownership_state.equal(&ab, &ba));
    assert(ownership_api.successful(ab.proof));
    assert(ab.allocations_len == 1 && ab.allocations[0].obligation);
    assert(ab.allocations[0].count.zero && ab.allocations[0].count.one);
    u64 before = ab.allocations[0].history.len;
    ownership_api.mutation_result release = ownership_state.release_member(&ab, svc,
        fact.key, true, at, source);
    assert(!release.applied && ab.allocations[0].history.len == before);
    assert(ab.allocations[0].obligation);
    ownership_state.free(&ba);
    ownership_state.free(&ab);
    ownership_state.free(&live);
    ownership_state.free(&empty);
}

fn released_source(ownership_api.services* svc) void {
    ownership_state.state mut live = ownership_state.empty();
    ownership_api.allocation_fact fact = allocation(3, 8, 3);
    ownership_api.source_fact mut storage = ownership_api.source_fact{};
    storage.key = id(ownership_api.entity_kind.source, 3);
    storage.kind = ownership_api.source_kind.heap;
    storage.validity = ownership_api.validity_kind.live;
    storage.allocation = fact.key;
    ownership_api.operation_position at = op(3);
    ownership_api.source_position source = ownership_api.source_position{};
    assert(ownership_state.add_allocation(&live, svc, fact, at, source).applied);
    assert(ownership_state.add_source(&live, svc, storage, at, source).applied);
    ownership_state.state mut released = ownership_state.clone(&live);
    assert(ownership_state.release_member(&released, svc, fact.key, true, at, source).applied);
    ownership_state.state mut ab = joined(&live, &released, svc, at, source);
    ownership_state.state mut ba = joined(&released, &live, svc, at, source);
    assert(ownership_state.equal(&ab, &ba));
    assert(ab.sources_len == 1);
    assert(ab.sources[0].validity == ownership_api.validity_kind.unknown);
    assert(ab.allocations[0].obligation);
    assert(ab.allocations[0].validity == ownership_api.validity_kind.unknown);
    assert(ab.allocations[0].history.len == 1);
    assert(ab.allocations[0].history[0].kind == ownership_api.effect_kind.release);
    ownership_state.free(&ba);
    ownership_state.free(&ab);
    ownership_state.free(&released);
    ownership_state.free(&live);
}

fn conflicting_owner(ownership_api.services* svc) void {
    ownership_state.state mut left = ownership_state.empty();
    ownership_state.state mut right = ownership_state.empty();
    ownership_api.operation_position at = op(5);
    ownership_api.source_position source = ownership_api.source_position{};
    ownership_api.allocation_fact first = allocation(7, 7, 1);
    ownership_api.allocation_fact second = allocation(7, 7, 2);
    assert(ownership_state.add_allocation(&left, svc, first, at, source).applied);
    assert(ownership_state.add_allocation(&right, svc, second, at, source).applied);
    ownership_state.state mut ab = joined(&left, &right, svc, at, source);
    ownership_state.state mut ba = joined(&right, &left, svc, at, source);
    assert(ownership_state.equal(&ab, &ba));
    assert(ab.allocations_len == 1 && ab.allocations[0].obligation);
    assert(ab.allocations[0].owner.place.residual);
    ownership_state.state mut before = ownership_state.clone(&ab);
    ownership_api.mutation_result released = ownership_state.release_member(&ab,
        svc, first.key, true, at, source);
    ownership_api.owner_location after = ownership_api.owner_location{place(3), false, false};
    ownership_api.mutation_result moved = ownership_state.transfer_owner(&ab,
        svc, first.key, after, true, at, source);
    assert(!released.applied && !moved.applied);
    assert(ownership_state.equal(&ab, &before));
    ownership_state.free(&before);
    ownership_state.free(&ba);
    ownership_state.free(&ab);
    ownership_state.free(&right);
    ownership_state.free(&left);
}

fn conflicting_conditions(ownership_api.services* svc) void {
    ownership_state.state mut left = ownership_state.empty();
    ownership_state.state mut right = ownership_state.empty();
    ownership_state.append_allocations(&left, allocation(20, 1, 20));
    ownership_api.predicate_atom mut p = ownership_api.predicate_atom{};
    p.key = id(ownership_api.entity_kind.predicate, 1);
    p.kind = ownership_api.predicate_kind.equality;
    p.left = id(ownership_api.entity_kind.value, 1);
    p.right = id(ownership_api.entity_kind.value, 2);
    ownership_state.append_predicates(&left, p);
    p.right = id(ownership_api.entity_kind.value, 3);
    ownership_state.append_predicates(&right, p);
    ownership_api.entity_id[1] positives = {
        id(ownership_api.entity_kind.predicate, 1)};
    ownership_api.entity_id[1] negatives = {
        id(ownership_api.entity_kind.predicate, 2)};
    ownership_api.guard_fact mut guard = ownership_api.guard_fact{};
    guard.key = id(ownership_api.entity_kind.guard, 1);
    guard.positive = positives[..];
    ownership_state.append_guards(&left, guard);
    ownership_api.entity_id@ none = {};
    guard.positive = none;
    guard.negative = negatives[..];
    ownership_state.append_guards(&right, guard);
    ownership_api.operation_position at = op(6);
    ownership_api.source_position source = ownership_api.source_position{};
    ownership_state.state mut ab = joined(&left, &right, svc, at, source);
    ownership_state.state mut ba = joined(&right, &left, svc, at, source);
    assert(ownership_state.equal(&ab, &ba));
    assert(ownership_api.successful(ab.proof));
    assert(ab.predicates_len == 0 && ab.guards_len == 0 && ab.losses_len == 2);
    assert(ab.allocations_len == 1 && ab.allocations[0].obligation);
    assert(ab.allocations[0].count.zero && ab.allocations[0].count.one);
    ownership_state.free(&ba);
    ownership_state.free(&ab);
    ownership_state.free(&right);
    ownership_state.free(&left);
}

fn cycle(ownership_api.services* svc) void {
    ownership_state.state mut left = ownership_state.empty();
    ownership_state.state mut right = ownership_state.empty();
    ownership_api.operation_position at = op(4);
    ownership_api.source_position source = ownership_api.source_position{};
    ownership_api.allocation_fact first = allocation(10, 7, 10);
    ownership_api.allocation_fact mut second = allocation(11, 7, 11);
    second.count.many = true;
    ownership_api.history_fact[1] mut history = {};
    history[0].allocation = second.key;
    history[0].operation = at;
    history[0].kind = ownership_api.effect_kind.release;
    history[0].before.place = place(11);
    second.history = history[..];
    assert(ownership_state.add_allocation(&left, svc, first, at, source).applied);
    assert(ownership_state.add_allocation(&right, svc, second, at, source).applied);
    ownership_api.graph_node n1 = ownership_api.graph_node{
        id(ownership_api.entity_kind.graph_node, 1), first.key,
        ownership_api.entity_id{}, false};
    ownership_api.graph_node n2 = ownership_api.graph_node{
        id(ownership_api.entity_kind.graph_node, 2), second.key,
        ownership_api.entity_id{}, false};
    assert(ownership_state.add_node(&left, svc, n1, at, source).applied);
    assert(ownership_state.add_node(&right, svc, n2, at, source).applied);
    ownership_api.graph_edge mut e1 = ownership_api.graph_edge{};
    e1.key = id(ownership_api.entity_kind.relation, 1);
    e1.from = n1.key;
    e1.to = n2.key;
    e1.kind = ownership_api.edge_kind.owned;
    e1.place = place(10);
    ownership_api.graph_edge mut e2 = e1;
    e2.key = id(ownership_api.entity_kind.relation, 2);
    e2.from = n2.key;
    e2.to = n1.key;
    e2.place = place(11);
    assert(ownership_state.add_edge(&left, svc, e1, at, source).applied);
    assert(ownership_state.add_edge(&right, svc, e2, at, source).applied);
    ownership_state.state mut ab = joined(&left, &right, svc, at, source);
    ownership_state.state mut ba = joined(&right, &left, svc, at, source);
    assert(ownership_state.equal(&ab, &ba));
    assert(ab.allocations_len == 2 && ab.nodes_len == 2 && ab.edges_len == 2);
    assert(ab.allocations[0].obligation && ab.allocations[1].obligation);
    assert(ab.allocations[0].count.zero && ab.allocations[1].count.zero);
    assert(ab.allocations[1].history.len == 1);
    ownership_api.limit_table bounds = ownership_limits.production();
    ownership_state.state mut widened = ownership_join.widen(&ab, &ba, svc,
        &bounds, at, source);
    assert(widened.allocations_len == 2 && widened.allocations[1].history.len == 1);
    assert(widened.allocations[0].obligation && widened.allocations[1].obligation);
    ownership_state.free(&widened);
    ownership_state.free(&ba);
    ownership_state.free(&ab);
    ownership_state.free(&right);
    ownership_state.free(&left);
}

fn one_sided_proofs(ownership_api.services* svc) void {
    ownership_state.state mut left = ownership_state.empty();
    ownership_state.state mut right = ownership_state.empty();
    ownership_api.allocation_fact a = allocation(70, 70, 70);
    ownership_state.append_allocations(&left, a);
    ownership_state.append_allocations(&right, a);
    ownership_api.predicate_atom mut predicate = ownership_api.predicate_atom{};
    predicate.key = id(ownership_api.entity_kind.predicate, 70);
    predicate.kind = ownership_api.predicate_kind.equality;
    ownership_state.append_predicates(&left, predicate);
    ownership_api.guard_fact mut guard = ownership_api.guard_fact{};
    guard.key = id(ownership_api.entity_kind.guard, 70);
    ownership_state.append_guards(&left, guard);
    ownership_api.correlation relation = ownership_api.correlation{
        guard.key, id(ownership_api.entity_kind.value, 70), a.key};
    ownership_state.append_correlations(&left, relation);
    ownership_api.shape_description mut shape = ownership_api.shape_description{};
    shape.key = id(ownership_api.entity_kind.template, 70);
    shape.acyclic_proved = true;
    shape.separation_proved = true;
    ownership_state.append_shapes(&left, shape);
    ownership_api.operation_position at = op(70);
    ownership_api.source_position source = ownership_api.source_position{};
    ownership_state.state mut ab = joined(&left, &right, svc, at, source);
    ownership_state.state mut ba = joined(&right, &left, svc, at, source);
    assert(ownership_state.equal(&ab, &ba));
    assert(ab.allocations_len == 1 && ab.allocations[0].obligation);
    assert(ab.predicates_len == 0 && ab.guards_len == 0);
    assert(ab.correlations_len == 1 && ab.correlations[0].guard.ordinal == 70);
    assert(ab.shapes_len == 1 && ab.shapes[0].residual);
    assert(!ab.shapes[0].acyclic_proved && !ab.shapes[0].separation_proved);
    assert(ab.losses_len == 3);
    ownership_state.free(&ba);
    ownership_state.free(&ab);
    ownership_state.free(&right);
    ownership_state.free(&left);
}

fn duplicate_union(ownership_api.services* svc) void {
    ownership_state.state mut left = ownership_state.empty();
    ownership_state.state mut right = ownership_state.empty();
    ownership_state.state mut later = ownership_state.empty();
    ownership_api.allocation_fact a = allocation(90, 90, 90);
    ownership_state.append_allocations(&left, a);
    ownership_state.append_allocations(&right, a);
    ownership_state.append_allocations(&later, a);
    ownership_api.contents_fact first = contents(90, 90);
    ownership_api.contents_fact second = contents(91, 91);
    ownership_state.append_contents(&left, first);
    ownership_state.append_contents(&left, first);
    ownership_state.append_contents(&right, first);
    ownership_state.append_contents(&later, second);
    ownership_api.limit_table mut bound = ownership_limits.production();
    bound.g = 2;
    ownership_api.operation_position at = op(90);
    ownership_api.source_position source = ownership_api.source_position{};
    ownership_state.state mut ab = ownership_join.join(&left, &right, svc,
        &bound, at, source);
    ownership_state.state mut ba = ownership_join.join(&right, &left, svc,
        &bound, at, source);
    assert(ownership_state.equal(&ab, &ba));
    assert(ab.contents_len == 1 && ab.allocations[0].obligation);
    ownership_state.state mut next_ab = ownership_join.join(&ab, &later, svc,
        &bound, at, source);
    ownership_state.state mut next_ba = ownership_join.join(&ba, &later, svc,
        &bound, at, source);
    assert(ownership_state.equal(&next_ab, &next_ba));
    assert(next_ab.contents_len == 2 && next_ab.losses_len == 0);
    ownership_state.free(&next_ba);
    ownership_state.free(&next_ab);
    ownership_state.free(&ba);
    ownership_state.free(&ab);
    ownership_state.free(&later);
    ownership_state.free(&right);
    ownership_state.free(&left);

    ownership_state.state mut corr_left = ownership_state.empty();
    ownership_state.state mut corr_right = ownership_state.empty();
    ownership_state.state mut corr_later = ownership_state.empty();
    ownership_api.correlation first_corr = ownership_api.correlation{
        id(ownership_api.entity_kind.guard, 90),
        id(ownership_api.entity_kind.value, 90),
        id(ownership_api.entity_kind.slot, 90)};
    ownership_api.correlation second_corr = ownership_api.correlation{
        id(ownership_api.entity_kind.guard, 91),
        id(ownership_api.entity_kind.value, 91),
        id(ownership_api.entity_kind.slot, 91)};
    ownership_state.append_correlations(&corr_left, first_corr);
    ownership_state.append_correlations(&corr_left, first_corr);
    ownership_state.append_correlations(&corr_right, first_corr);
    ownership_state.append_correlations(&corr_later, second_corr);
    ownership_state.state mut corr_ab = ownership_join.join(&corr_left, &corr_right,
        svc, &bound, at, source);
    ownership_state.state mut corr_ba = ownership_join.join(&corr_right, &corr_left,
        svc, &bound, at, source);
    assert(ownership_state.equal(&corr_ab, &corr_ba));
    assert(corr_ab.correlations_len == 1);
    ownership_state.state mut corr_next = ownership_join.join(&corr_ab, &corr_later,
        svc, &bound, at, source);
    assert(corr_next.correlations_len == 2 && corr_next.losses_len == 0);
    ownership_state.free(&corr_next);
    ownership_state.free(&corr_ba);
    ownership_state.free(&corr_ab);
    ownership_state.free(&corr_later);
    ownership_state.free(&corr_right);
    ownership_state.free(&corr_left);
}

fn duplicate_proofs(ownership_api.services* svc) void {
    ownership_state.state mut left = ownership_state.empty();
    ownership_state.state mut right = ownership_state.empty();
    ownership_api.allocation_fact a = allocation(95, 95, 95);
    ownership_state.append_allocations(&left, a);
    ownership_state.append_allocations(&right, a);
    ownership_api.predicate_atom mut predicate = ownership_api.predicate_atom{};
    predicate.key = id(ownership_api.entity_kind.predicate, 95);
    predicate.kind = ownership_api.predicate_kind.equality;
    ownership_state.append_predicates(&left, predicate);
    ownership_state.append_predicates(&left, predicate);
    ownership_state.append_predicates(&right, predicate);
    ownership_api.guard_fact mut guard = ownership_api.guard_fact{};
    guard.key = id(ownership_api.entity_kind.guard, 95);
    ownership_state.append_guards(&left, guard);
    ownership_state.append_guards(&left, guard);
    ownership_state.append_guards(&right, guard);
    ownership_api.limit_table mut bound = ownership_limits.production();
    bound.p = 1;
    bound.g = 1;
    ownership_api.operation_position at = op(95);
    ownership_api.source_position source = ownership_api.source_position{};
    ownership_state.state mut ab = ownership_join.join(&left, &right, svc,
        &bound, at, source);
    ownership_state.state mut ba = ownership_join.join(&right, &left, svc,
        &bound, at, source);
    assert(ownership_state.equal(&ab, &ba));
    assert(ab.predicates_len == 1 && ab.guards_len == 1);
    assert(ab.losses_len == 0 && ab.allocations[0].obligation);
    ownership_state.free(&ba);
    ownership_state.free(&ab);
    ownership_state.free(&right);
    ownership_state.free(&left);
}

fn bottom_duplicates(ownership_api.services* svc) void {
    ownership_state.state mut reaching = ownership_state.empty();
    ownership_state.state mut bottom = ownership_state.bottom();
    ownership_api.allocation_fact a = allocation(110, 110, 110);
    ownership_state.append_allocations(&reaching, a);
    ownership_api.source_fact mut storage = ownership_api.source_fact{};
    storage.key = id(ownership_api.entity_kind.source, 110);
    storage.kind = ownership_api.source_kind.heap;
    storage.validity = ownership_api.validity_kind.live;
    storage.allocation = a.key;
    ownership_state.append_sources(&reaching, storage);
    ownership_api.borrow_relation[1] mut loans = {};
    loans[0].key = id(ownership_api.entity_kind.relation, 110);
    loans[0].source = storage.key;
    loans[0].range.key = id(ownership_api.entity_kind.region, 110);
    loans[0].range.source = storage.key;
    loans[0].representation_complete = true;
    ownership_api.contents_fact mut value = contents(110, 110);
    value.borrows = loans[..];
    ownership_state.append_contents(&reaching, value);
    ownership_state.append_contents(&reaching, value);
    ownership_api.correlation relation = ownership_api.correlation{
        id(ownership_api.entity_kind.guard, 110),
        id(ownership_api.entity_kind.value, 110),
        id(ownership_api.entity_kind.slot, 110)};
    ownership_state.append_correlations(&reaching, relation);
    ownership_state.append_correlations(&reaching, relation);
    ownership_api.predicate_atom mut predicate = ownership_api.predicate_atom{};
    predicate.key = id(ownership_api.entity_kind.predicate, 110);
    predicate.kind = ownership_api.predicate_kind.equality;
    ownership_state.append_predicates(&reaching, predicate);
    ownership_state.append_predicates(&reaching, predicate);
    ownership_api.guard_fact mut guard = ownership_api.guard_fact{};
    guard.key = relation.guard;
    ownership_state.append_guards(&reaching, guard);
    ownership_state.append_guards(&reaching, guard);
    ownership_api.limit_table mut bound = ownership_limits.production();
    bound.p = 1;
    bound.g = 3;
    ownership_api.operation_position at = op(110);
    ownership_api.source_position source = ownership_api.source_position{};
    ownership_state.state mut join_left = ownership_join.join(&bottom, &reaching, svc,
        &bound, at, source);
    ownership_state.state mut join_right = ownership_join.join(&reaching, &bottom, svc,
        &bound, at, source);
    ownership_state.state mut widen_left = ownership_join.widen(&bottom, &reaching, svc,
        &bound, at, source);
    ownership_state.state mut widen_right = ownership_join.widen(&reaching, &bottom, svc,
        &bound, at, source);
    assert(ownership_state.equal(&join_left, &join_right));
    assert(ownership_state.equal(&join_left, &widen_left));
    assert(ownership_state.equal(&widen_left, &widen_right));
    assert(join_left.contents_len == 1 && join_left.correlations_len == 1);
    assert(join_left.predicates_len == 1 && join_left.guards_len == 1);
    assert(join_left.losses_len == 0 && join_left.allocations[0].obligation);
    assert(join_left.sources[0].validity == ownership_api.validity_kind.live);
    assert(join_left.contents[0].borrows.len == 1);
    assert(join_left.contents[0].borrows[0].source.ordinal == 110);
    assert(join_left.contents[0].borrows[0].representation_complete);
    ownership_state.free(&widen_right);
    ownership_state.free(&widen_left);
    ownership_state.free(&join_right);
    ownership_state.free(&join_left);
    ownership_state.free(&bottom);
    ownership_state.free(&reaching);
}

fn main() i32 {
    ownership_events.store mut events = ownership_events.store{};
    ownership_api.services mut svc = ownership_api.services{};
    setup(&events, &svc);
    alternatives(&svc);
    empty_and_live(&svc);
    released_source(&svc);
    conflicting_owner(&svc);
    conflicting_conditions(&svc);
    one_sided_proofs(&svc);
    println("G04.3 G05.1 G05.2");
    cycle(&svc);
    println("G06.3 cycle join and widening");
    duplicate_union(&svc);
    duplicate_proofs(&svc);
    println("duplicate union records");
    bottom_duplicates(&svc);
    println("bottom duplicate normalization");
    ownership_events.free(&events);
    return 0;
}
