//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: lexer.tokvec_at: index out of range
//! stdout:
//| 2
//| 7
//| 2
/// Checks the token vector bound. tokvec_at takes an index below the count. A truncated vector
/// keeps its stale slots, so an index past the new count panics although its slot holds a token.
import lexer;

fn main() i32 {
    lexer.tok_vec mut v = lexer.tokvec_create();
    defer lexer.tokvec_free(&v);
    lexer.token mut t = lexer.token{};
    t.kind = lexer.tok_kind.int_lit;
    t.ival = 2;
    lexer.tokvec_push(&v, t);
    t.ival = 7;
    lexer.tokvec_push(&v, t);
    println(lexer.tokvec_count(&v));
    println(lexer.tokvec_at(&v, 1).ival);
    lexer.tokvec_truncate(&v, 1);
    println(lexer.tokvec_at(&v, 0).ival);
    println(lexer.tokvec_at(&v, 1).ival);
    return 0;
}
