//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: fir.verify: V7 a kind with no runtime entry: main.f bb0 statement 0 (s1)
//! stdout:
//| the check is excused before the pass
/// Checks that gen_fir.check_fir runs the verifier after the build-mode pass with no kind
/// excused (spec/fir.md 9.8, rule V7): a check that the pass keeps needs its runtime entry. The
/// runtime here lacks `fail_overflow` and excuses its kind, as `--release` does, while the
/// emitter runs in the default mode, whose pass keeps the overflow check. The verifier before the
/// pass accepts the check; the verifier after it stops the compiler with the V7 text.
import fir;
import fir_env;
import fir_parse;
import fir_verify;
import gen;
import gen_fir;
import std.strbuf;

string[9] TEXT = {
    "fn main.f(_1 (c): bool) -> i32 {\n",
    "    bb0: {\n",
    "        check(copy _1, overflow) -> bb1 #2:5 s1;\n",
    "    }\n",
    "    bb1: {\n",
    "        _0 = const i32 1 #3:5 s2;\n",
    "        return #3:5 s2;\n",
    "    }\n",
    "}\n",
};

fn main() i32 {
    fir_env.env mut e = fir_env.env{};
    fir_env.open(&e);
    defer fir_env.close(&e);
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    for (string line : TEXT) {
        strbuf.append(&text, line);
    }
    fir.module mut m = fir_parse.parse_module(&e.c.m.s, "t.fir", strbuf.view(&text),
                                              fir_env.prelude(&e));
    defer fir.module_free(&m);
    assert(fir_env.errors(&e) == 0);
    fir_verify.runtime mut rt = fir_verify.runtime_of(&e.c.ck);
    rt.entry[cast(fir.check_kind.chk_overflow, u64)] = null;
    fir_verify.excuse_mode(&rt, true, false);
    fir_verify.violation mut v = fir_verify.violation{};
    assert(!fir_verify.find_violation(fir.module_function_at(&m, 0), &rt, &v));
    println("the check is excused before the pass");
    gen.emitter mut g = gen.emitter{};
    gen.gen_init(&g, &e.c.m.s, gen.gen_options{});
    defer gen.gen_free(&g);
    gen_fir.check_fir(&g, &rt, &m.funcs.items[0]);
    return 0;
}
