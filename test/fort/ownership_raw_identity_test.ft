//! run
//! flags: -I ../../src/fort -I support
//! link: support/ownership_depth_alloc.c
//! stdout:
//| raw identity boundaries ok
/// Tests present zero identities and absent parent semantics.
import ownership_api;
import ownership_depth_env;
import ownership_raw_facts;
import ownership_raw_facts_env;
import ownership_type_work;
import types;

fn zero(ownership_api.entity_kind kind) ownership_api.entity_id {
    return ownership_api.entity_id{.kind = kind};
}
fn present_zero() void {
    ownership_depth_env.fixture mut f = {};
    ownership_type_work.work mut paid = ownership_raw_facts_env.configure(&f, 65536);
    types.node layout = ownership_raw_facts_env.integer();
    ownership_raw_facts.raw_region_view[1] mut regions = {
        ownership_raw_facts_env.region(&layout, 1, 1, 0, 8)};
    regions[0].source = zero(ownership_api.entity_kind.source);
    regions[0].place.root = zero(ownership_api.entity_kind.slot);
    ownership_raw_facts.closed_bound_view[1] bounds = {ownership_raw_facts.closed_bound_view{
        zero(ownership_api.entity_kind.value), ownership_raw_facts.natural(0),
        ownership_raw_facts.natural(3)}};
    ownership_api.predicate_atom[1] core = {ownership_api.predicate_atom{
        .key = zero(ownership_api.entity_kind.predicate),
        .kind = ownership_api.predicate_kind.membership,
        .left = zero(ownership_api.entity_kind.value),
        .lower = ownership_api.scalar_fact{.kind = ownership_api.fact_kind.exact},
        .upper = ownership_api.scalar_fact{.kind = ownership_api.fact_kind.exact, .value = 4}}};
    ownership_raw_facts.affine_term[1] terms = {ownership_raw_facts.affine_term{
        zero(ownership_api.entity_kind.value), ownership_raw_facts.natural(1)}};
    ownership_raw_facts.ordered_relation_view[1] relations = {
        ownership_raw_facts.ordered_relation_view{
            ownership_raw_facts.affine_view{ownership_raw_facts.natural(0), terms[..], true},
            ownership_raw_facts.literal(4)}};
    u64[1] index = {0};
    ownership_raw_facts.choice_view[1] choices = {ownership_raw_facts.choice_view{
        .kind = ownership_raw_facts.decision_kind.opaque,
        .decision = zero(ownership_api.entity_kind.guard),
        .subject = ownership_api.place_path{.root = zero(ownership_api.entity_kind.slot)},
        .value_version = zero(ownership_api.entity_kind.value),
        .alternative = zero(ownership_api.entity_kind.relation),
        .positive = core[..], .regions = index[..], .bounds = index[..],
        .relations = index[..], .complete = true}};
    ownership_raw_facts.core_region_view[1] core_regions = {ownership_raw_facts.core_region_view{
        .identity = ownership_raw_facts.core_region_identity{
            .kind = ownership_raw_facts.region_identity_kind.region,
            .key = zero(ownership_api.entity_kind.region)},
        .meaning = regions[0], .alias_complete = true}};
    ownership_depth_env.begin();
    ownership_raw_facts.payload_result mut payload = ownership_raw_facts.build_payload(
        ownership_raw_facts.raw_fact_view{regions[..], bounds[..], relations[..], choices[..],
        true, false}, &paid);
    ownership_raw_facts_env.good(&payload);
    ownership_raw_facts.union_request req = ownership_raw_facts.union_request{
        .core = ownership_raw_facts.core_fact_view{core_regions[..], core[..]},
        .proposed = payload.payload};
    ownership_raw_facts.union_result mut result = ownership_raw_facts.measure_union(&req, &paid);
    ownership_raw_facts_env.counts(&result, 1, 2);
    assert(result.choices_complete && result.choices != null);
    assert(result.choices->payload->choices[0].descriptor.decision.ordinal == 0);
    assert(result.choices->payload->regions[0].source.ordinal == 0);
    assert(result.choices->payload->bounds[0].version.ordinal == 0);
    ownership_raw_facts.free_union_result(&result);
    ownership_raw_facts.free_payload(&payload.payload);
    assert(ownership_depth_env.finish() > 0);
}
fn absent_parents() void {
    ownership_depth_env.fixture mut f = {};
    ownership_type_work.work mut paid = ownership_raw_facts_env.configure(&f, 65536);
    types.node layout = ownership_raw_facts_env.integer();
    ownership_raw_facts.core_region_view[2] mut core = {};
    core[0].identity = ownership_raw_facts.core_region_identity{
        .kind = ownership_raw_facts.region_identity_kind.region,
        .key = zero(ownership_api.entity_kind.region)};
    core[0].meaning = ownership_raw_facts_env.region(&layout, 1, 1, 0, 8);
    core[0].alias_complete = true;
    core[1] = core[0];
    core[1].identity.parent = ownership_raw_facts_env.id(ownership_api.entity_kind.none, 999);
    ownership_depth_env.begin();
    ownership_raw_facts.union_request req = ownership_raw_facts.union_request{
        .core = ownership_raw_facts.core_fact_view{.regions = core[..]}};
    ownership_raw_facts.union_result mut result = ownership_raw_facts.measure_union(&req, &paid);
    ownership_raw_facts_env.counts(&result, 1, 0);
    ownership_raw_facts.free_union_result(&result);
    core[1].meaning.end = ownership_raw_facts.literal(9);
    result = ownership_raw_facts.measure_union(&req, &paid);
    ownership_raw_facts_env.refused(result.proof,
        ownership_api.incomplete_reason.invalid_input);
    assert(result.r == 0 && result.p == 0);
    ownership_raw_facts.free_union_result(&result);
    ownership_raw_facts.region_identity_kind[3] kinds = {
        ownership_raw_facts.region_identity_kind.allocation,
        ownership_raw_facts.region_identity_kind.graph_node,
        ownership_raw_facts.region_identity_kind.region};
    u64 mut i = 0;
    while (i < kinds.len) {
        paid = ownership_raw_facts_env.configure(&f, 65536);
        core[0].identity.kind = kinds[i];
        core[0].identity.key = zero(i == 2 ? ownership_api.entity_kind.region :
            ownership_api.entity_kind.allocation);
        core[0].alias_complete = false;
        core[1] = core[0];
        core[1].identity.parent = ownership_raw_facts_env.id(ownership_api.entity_kind.none,
            4294967295);
        result = ownership_raw_facts.measure_union(&req, &paid);
        ownership_raw_facts_env.counts(&result, 1, 0);
        ownership_raw_facts.free_union_result(&result);
        i += 1;
    }
    assert(ownership_depth_env.finish() > 0);
}
fn partition_parents() void {
    ownership_depth_env.fixture mut f = {};
    ownership_type_work.work mut paid = ownership_raw_facts_env.configure(&f, 65536);
    ownership_raw_facts.core_region_view[3] mut core = {};
    core[0].identity = ownership_raw_facts.core_region_identity{
        .kind = ownership_raw_facts.region_identity_kind.partition,
        .key = zero(ownership_api.entity_kind.region),
        .parent = zero(ownership_api.entity_kind.region)};
    core[1] = core[0]; core[1].identity.parent.ordinal = 1;
    core[2] = core[0]; core[2].identity.kind = ownership_raw_facts.region_identity_kind.region;
    core[2].identity.parent = ownership_api.entity_id{};
    ownership_depth_env.begin();
    ownership_raw_facts.union_request req = ownership_raw_facts.union_request{
        .core = ownership_raw_facts.core_fact_view{.regions = core[..]}};
    ownership_raw_facts.union_result mut result = ownership_raw_facts.measure_union(&req, &paid);
    ownership_raw_facts_env.counts(&result, 3, 0);
    ownership_raw_facts.free_union_result(&result);
    core[2].identity.parent = zero(ownership_api.entity_kind.region);
    result = ownership_raw_facts.measure_union(&req, &paid);
    ownership_raw_facts_env.refused(result.proof,
        ownership_api.incomplete_reason.invalid_input);
    ownership_raw_facts.free_union_result(&result);
    assert(ownership_depth_env.finish() > 0);
}
fn value_coordinates() void {
    ownership_depth_env.fixture mut f = {};
    ownership_type_work.work mut paid = ownership_raw_facts_env.configure(&f, 65536);
    ownership_raw_facts.closed_bound_view[5] mut bounds = {};
    u64 mut i = 0;
    while (i < bounds.len) {
        bounds[i] = ownership_raw_facts.closed_bound_view{zero(ownership_api.entity_kind.value),
            ownership_raw_facts.natural(0), ownership_raw_facts.natural(0)};
        i += 1;
    }
    bounds[1].version.function.declaration.module = 1;
    bounds[2].version.function.declaration.declaration = 1;
    bounds[3].version.function.instance = 1;
    bounds[4].version.ordinal = 1;
    ownership_depth_env.begin();
    ownership_raw_facts.payload_result mut payload = ownership_raw_facts.build_payload(
        ownership_raw_facts.raw_fact_view{.bounds = bounds[..]}, &paid);
    ownership_raw_facts_env.good(&payload);
    ownership_raw_facts.union_request req = ownership_raw_facts.union_request{
        .proposed = payload.payload};
    ownership_raw_facts.union_result mut result = ownership_raw_facts.measure_union(&req, &paid);
    ownership_raw_facts_env.counts(&result, 0, 5);
    ownership_raw_facts.free_union_result(&result);
    ownership_raw_facts.free_payload(&payload.payload);
    assert(ownership_depth_env.finish() > 0);
}
fn absence_and_kinds() void {
    ownership_api.entity_id absent = ownership_raw_facts_env.id(ownership_api.entity_kind.none,
        4294967295);
    assert(ownership_raw_facts.valid_operand(absent));
    assert(!ownership_raw_facts.valid_key(absent, ownership_api.entity_kind.value));
    assert(!ownership_raw_facts.valid_key(zero(ownership_api.entity_kind.source),
        ownership_api.entity_kind.value));
    ownership_depth_env.fixture mut f = {};
    ownership_type_work.work mut paid = ownership_raw_facts_env.configure(&f, 65536);
    ownership_api.predicate_atom[1] atoms = {ownership_api.predicate_atom{
        .key = zero(ownership_api.entity_kind.predicate), .left = absent, .right = absent,
        .lower = ownership_api.scalar_fact{.symbol = absent},
        .upper = ownership_api.scalar_fact{.symbol = absent}}};
    ownership_depth_env.begin();
    ownership_raw_facts.union_request req = ownership_raw_facts.union_request{
        .core = ownership_raw_facts.core_fact_view{.predicates = atoms[..]}};
    ownership_raw_facts.union_result mut result = ownership_raw_facts.measure_union(&req, &paid);
    ownership_raw_facts_env.counts(&result, 0, 1);
    ownership_raw_facts.free_union_result(&result);
    ownership_depth_env.finish();
}
fn optional_absence() void {
    ownership_depth_env.fixture mut f = {};
    ownership_type_work.work mut paid = ownership_raw_facts_env.configure(&f, 65536);
    ownership_api.entity_id absent =
        ownership_raw_facts_env.id(ownership_api.entity_kind.none, 999);
    ownership_api.predicate_atom[1] mut positive = {ownership_api.predicate_atom{
        .key = zero(ownership_api.entity_kind.predicate),
        .kind = ownership_api.predicate_kind.shape}};
    ownership_api.predicate_atom[1] mut negative = positive;
    negative[0].left = absent; negative[0].right = absent;
    negative[0].lower.symbol = absent; negative[0].upper.symbol = absent;
    assert(ownership_raw_facts.same_predicate(positive[0], negative[0]));
    assert(ownership_raw_facts.key(ownership_api.entity_id{}, absent));
    assert(!ownership_raw_facts.key(zero(ownership_api.entity_kind.value), absent));
    ownership_raw_facts.choice_view[1] bindings = {ownership_raw_facts.choice_view{
        .kind = ownership_raw_facts.decision_kind.opaque,
        .decision = zero(ownership_api.entity_kind.guard),
        .subject = ownership_api.place_path{.root = zero(ownership_api.entity_kind.slot)},
        .value_version = zero(ownership_api.entity_kind.value),
        .alternative = zero(ownership_api.entity_kind.relation),
        .positive = positive[..], .negative = negative[..], .complete = true}};
    ownership_depth_env.begin();
    ownership_raw_facts.payload_result mut payload = ownership_raw_facts.build_payload(
        ownership_raw_facts.raw_fact_view{.choices = bindings[..], .choices_complete = true},
        &paid);
    ownership_raw_facts_env.good(&payload);
    ownership_raw_facts.union_request req = ownership_raw_facts.union_request{
        .core = ownership_raw_facts.core_fact_view{.predicates = negative[..]},
        .proposed = payload.payload};
    ownership_raw_facts.union_result mut result = ownership_raw_facts.measure_union(&req, &paid);
    ownership_raw_facts_env.counts(&result, 0, 1);
    assert(result.choices_complete && result.choices != null);
    ownership_raw_facts.free_union_result(&result);
    ownership_raw_facts.free_payload(&payload.payload);
    assert(ownership_depth_env.finish() > 0);
}
fn main() i32 {
    present_zero(); absent_parents(); partition_parents(); value_coordinates(); absence_and_kinds();
    optional_absence();
    println("raw identity boundaries ok"); return 0;
}
