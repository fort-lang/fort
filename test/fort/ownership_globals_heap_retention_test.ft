//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| globals heap retention ok
/// Checks current heap storage retained by ordinary library returns.
import ownership_api;
import ownership_events;
import ownership_globals_env;
import ownership_globals_review_env;
import ownership_keys;
import ownership_state;

fn graph_node(ownership_globals_env.env mut* e, u32 id, u32 allocation) void {
    ownership_state.append_nodes(&e->input, ownership_api.graph_node{
        .key = ownership_globals_env.case_key(e, ownership_api.entity_kind.graph_node, id),
        .allocation = allocation == 0 ? ownership_api.entity_id{} :
            ownership_globals_env.case_key(e, ownership_api.entity_kind.allocation, allocation)});
}

fn graph_edge(ownership_globals_env.env mut* e, u32 from, u32 to,
    ownership_api.edge_kind kind, ownership_api.place_path field) void {
    ownership_state.append_edges(&e->input, ownership_api.graph_edge{
        .key = ownership_globals_env.case_key(e, ownership_api.entity_kind.relation, 800 + from),
        .from = ownership_globals_env.case_key(e, ownership_api.entity_kind.graph_node, from),
        .to = ownership_globals_env.case_key(e, ownership_api.entity_kind.graph_node, to),
        .kind = kind, .place = field});
}

fn heap_case(u32 mode) void {
    ownership_globals_env.env mut e = ownership_globals_env.env{};
    ownership_globals_env.case_open(&e, 600 + mode);
    ownership_api.place_path a = ownership_globals_env.case_place(&e, 2);
    ownership_api.place_path b = ownership_globals_env.case_place(&e, 4);
    ownership_api.place_path mut field = ownership_globals_env.case_place(&e, 3);
    if (mode == 6 || mode == 18) {
        field = ownership_globals_review_env.path(&e, 3, mode == 6);
    }
    ownership_globals_env.add_owner(&e, a, 10, 4);
    if (mode != 16) {
        ownership_globals_review_env.add_global(&e, b, 640);
        ownership_globals_env.add_owner(&e, b, 20, 4);
        ownership_globals_review_env.copy_borrow(&e, 1, field);
    } else {
        ownership_globals_env.add_borrow(&e, field, 40, ownership_api.source_kind.stack, 1);
    }
    graph_node(&e, 10, 10);
    graph_node(&e, 20, mode == 16 ? 0 : 20);
    if (mode == 4 || mode == 5) {
        ownership_api.place_path child = ownership_globals_env.case_place(&e, 5);
        ownership_globals_env.add_owner(&e, child, 30, 4);
        graph_node(&e, 30, 30);
        graph_edge(&e, 10, 30, ownership_api.edge_kind.owned, child);
        graph_edge(&e, 30, 20, ownership_api.edge_kind.borrowed, field);
    } else if (mode == 8) {
        ownership_api.place_path intermediate = ownership_globals_env.case_place(&e, 5);
        ownership_globals_env.add_borrow(&e, intermediate, 50, ownership_api.source_kind.heap, 1);
        e.input.sources[e.input.sources_len - 1].allocation =
            ownership_globals_env.case_key(&e, ownership_api.entity_kind.allocation, 30);
        graph_node(&e, 30, 30);
        graph_edge(&e, 10, 30, ownership_api.edge_kind.borrowed, intermediate);
        graph_edge(&e, 30, 20, ownership_api.edge_kind.borrowed, field);
    } else {
        if (mode == 7) { graph_node(&e, 30, 30); }
        graph_edge(&e, mode == 7 ? 30 : 10, 20, ownership_api.edge_kind.borrowed, field);
    }
    e.global.graph_complete_proved = mode != 9;
    if (mode == 10) { e.input.edges[0].kind = ownership_api.edge_kind.residual; }
    if (mode == 11) { e.input.nodes[0].residual = true; }
    if (mode == 12) { e.input.nodes[0].allocation.ordinal += 1; }
    if (mode == 13) {
        e.input.contents[2].kind = ownership_api.contents_kind.unknown;
        e.input.contents[2].borrows = e.input.contents[2].borrows[0..0];
    }
    if (mode == 14 || mode == 15) {
        ownership_api.borrow_relation mut relation = e.input.contents[2].borrows[0];
        relation.source = ownership_globals_env.case_key(&e, ownership_api.entity_kind.source, 40);
        ownership_api.borrow_relation[1] relations = {relation};
        ownership_api.contents_fact mut value = e.input.contents[2];
        value.borrows = relations[..];
        e.input.contents[2] = ownership_state.copy_contents(&e.input, value);
        if (mode == 15) {
            ownership_state.append_sources(&e.input, ownership_api.source_fact{
                .key = relation.source, .kind = ownership_api.source_kind.heap,
                .validity = ownership_api.validity_kind.unknown,
                .allocation = e.input.allocations[1].key});
        }
    }
    ownership_globals_env.select_entry(&e, true, mode == 19);
    if (mode == 3) {
        ownership_api.place_path empty = ownership_globals_env.case_place(&e, 6);
        ownership_globals_env.add_empty(&e, empty);
        ownership_globals_env.borrow_effect(&e, empty, field, 0);
        e.ordered[e.effects_len - 1].source = ownership_api.entity_id{};
    }
    bool released = mode == 1 || mode == 3 || mode == 4 || mode == 6 || mode == 7 ||
        mode == 8 || mode >= 19;
    if (released) {
        ownership_globals_env.add_effect(&e, ownership_api.effect_kind.release, b, b, 20);
    }
    if (mode >= 19) {
        ownership_globals_env.add_effect(&e, ownership_api.effect_kind.read, field, field, 20);
        ownership_api.place_path empty = ownership_globals_env.case_place(&e, 6);
        ownership_globals_env.add_empty(&e, empty);
        ownership_globals_env.borrow_effect(&e, empty, field, 0);
        e.ordered[e.effects_len - 1].source = ownership_api.entity_id{};
    }
    if (mode == 20) { ownership_globals_env.select_calls(&e, 1, 1); }
    ownership_globals_review_env.return_event(&e);
    ownership_api.global_request req = ownership_globals_env.request(&e);
    if (mode == 17) {
        ownership_api.global_result prior = ownership_globals_review_env.solve(&e, &req);
        assert(ownership_api.successful(prior.proof));
        u64 cost = e.events.budget.used.w;
        ownership_globals_review_env.budget(&e, cost - 1);
    }
    ownership_api.global_result out = ownership_globals_review_env.solve(&e, &req);
    bool invalid = mode == 1 || mode == 4 || mode == 6 || mode == 8 || mode >= 19;
    bool missing = mode >= 9 && mode <= 16;
    ownership_api.incomplete_reason mut reason = ownership_api.incomplete_reason.none;
    if (mode >= 9 && mode <= 12) { reason = ownership_api.incomplete_reason.missing_graph; }
    if (mode >= 13 && mode <= 15) {
        reason = ownership_api.incomplete_reason.missing_correspondence;
    }
    if (mode == 16) { reason = ownership_api.incomplete_reason.missing_boundary; }
    if (mode == 17) { reason = ownership_api.incomplete_reason.work_limit; }
    ownership_globals_review_env.result(&e, out, !invalid && !missing && mode != 17,
        mode == 17 ? ownership_api.event_kind.work_failure : (invalid ?
            ownership_api.event_kind.invalid_use : ownership_api.event_kind.incomplete_proof),
        reason);
    if (invalid) {
        ownership_api.event_descriptor* event = ownership_events.at(&e.events, 0);
        assert(ownership_state.same_entity(event->relation,
            ownership_globals_env.case_key(&e, ownership_api.entity_kind.source, 120)));
        assert(ownership_state.same_place(event->owner_path, field));
        assert(ownership_keys.operation(event->operation,
            mode >= 19 ? e.ordered[1].operation : req.operation) == 0);
    }
    if (ownership_api.successful(out.proof)) {
        assert(e.global.retained.allocations[0].obligation);
        if (mode == 5) { assert(e.global.retained.allocations[2].obligation); }
        if (mode == 3) { assert(e.global.borrowed.len == 1); }
    }
    if (mode == 18) {
        ownership_globals_env.release_input(&e);
        assert(e.global.retained.contents[2].place.projections.len == 1);
        assert(e.global.retained.contents[2].place.projections[0].field == 7);
        assert(e.global.borrowed.len == 3);
        assert(e.global.borrowed[2].containing.projections[0].field == 7);
    }
    ownership_globals_env.close(&e);
}

fn case_h01() void { heap_case(1); }
fn case_h02() void { heap_case(2); }
fn case_h03() void { heap_case(3); }
fn case_h04() void { heap_case(4); }
fn case_h05() void { heap_case(5); }
fn case_h06() void { heap_case(6); }
fn case_h07() void { heap_case(7); }
fn case_h08() void { heap_case(8); }
fn case_h09() void { heap_case(9); }
fn case_h10() void { heap_case(10); }
fn case_h11() void { heap_case(11); }
fn case_h12() void { heap_case(12); }
fn case_h13() void { heap_case(13); }
fn case_h14() void { heap_case(14); }
fn case_h15() void { heap_case(15); }
fn case_h16() void { heap_case(16); }
fn case_h17() void { heap_case(17); }
fn case_h18() void { heap_case(18); }
fn case_h19() void { heap_case(19); }
fn case_h20() void { heap_case(20); }

fn main() i32 {
    case_h01();
    case_h02();
    case_h03();
    case_h04();
    case_h05();
    case_h06();
    case_h07();
    case_h08();
    case_h09();
    case_h10();
    case_h11();
    case_h12();
    case_h13();
    case_h14();
    case_h15();
    case_h16();
    case_h17();
    case_h18();
    case_h19();
    case_h20();
    println("globals heap retention ok");
    return 0;
}
