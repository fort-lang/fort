fn denied_charge_preserves_input() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.symbolic_heap(&e, 4, 0, 64);
    ownership_state.state mut before = ownership_state.clone(&e.local.state);
    defer ownership_state.free(&before);
    ownership_raw.context mut raw_before = ownership_raw.clone(&e.root.storage, &before);
    defer ownership_raw.free(&raw_before);
    ownership_raw.origin mut input = e.root.storage.origins[0];
    ownership_raw.request mut req = ownership_raw_env.request(&e);
    ownership_raw.work_cursor mut cursor = {};
    ownership_raw_env.accepted(ownership_raw.begin_work(&e.local.state, &e.local.service,
        &req, &cursor));
    e.budget.deny_at = e.budget.calls + 8;
    ownership_raw.result mut value = ownership_raw.capture_origin(&e.local.state,
        &e.local.service, &input, e.root.storage.bounds[..], ownership_raw_env.NO_RELATIONS,
        &cursor.selected);
    ownership_raw_env.rejected(value.proof);
    assert(value.proof.terminal.limit.present && value.proof.terminal.limit.used == 7 &&
        value.proof.terminal.limit.bound == 7 && value.proof.terminal.limit.attempted > 0);
    assert(ownership_keys.operation(value.proof.terminal.limit.operation, req.base.operation) == 0);
    assert(e.local.counts.last_kind == ownership_api.event_kind.work_failure);
    ownership_raw_env.rejects(&value);
    assert(ownership_state.equal(&before, &e.local.state));
    assert(ownership_raw.same_expression(raw_before.origins[0].end,
        e.root.storage.origins[0].end));
    assert(raw_before.leaves_len == e.root.storage.leaves_len);
    println("reject denied_charge_preserves_input");
}

fn additional_input_guards() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.heap(&e, 8);
    ownership_state.state mut before = ownership_state.clone(&e.local.state);
    defer ownership_state.free(&before);
    ownership_raw.request mut req = ownership_raw_env.request(&e);
    req.alternatives_complete = false;
    ownership_raw_env.rejected(ownership_raw.access(&e.root.storage, &e.local.service,
        e.root.addresses[..], e.byte, &req));
    req = ownership_raw_env.request(&e);
    req.captured_values = false;
    ownership_raw_env.rejected(ownership_raw.access(&e.root.storage, &e.local.service,
        e.root.addresses[..], e.byte, &req));
    req = ownership_raw_env.request(&e);
    ownership_raw.address[1] mut forged = {e.root.addresses[0]};
    forged[0].end = ownership_raw.literal(9);
    ownership_raw_env.rejected(ownership_raw.access(&e.root.storage, &e.local.service,
        forged[..], e.byte, &req));
    forged[0] = e.root.addresses[0];
    forged[0].alignment = 16;
    ownership_raw_env.rejected(ownership_raw.access(&e.root.storage, &e.local.service,
        forged[..], e.byte, &req));
    ownership_raw.term[129] mut excessive = {};
    u64 mut i = 0;
    while (i < excessive.len) {
        excessive[i] = ownership_raw.term{ownership_local_env.id(
            ownership_api.entity_kind.value, 10), ownership_raw.natural(1)};
        i += 1;
    }
    ownership_raw.origin mut input = e.root.storage.origins[0];
    ownership_raw.expression mut count = input.count;
    count.terms = excessive[..];
    input.count = count;
    ownership_raw.result mut failed = ownership_raw.capture_origin(&e.local.state,
        &e.local.service, &input, ownership_raw_env.NO_BOUNDS, ownership_raw_env.NO_RELATIONS,
        &req);
    ownership_raw_env.rejects(&failed);
    assert(ownership_raw.add_work(ownership_raw.U64_MAX, 1) == ownership_raw.U64_MAX);
    assert(ownership_raw.square_work(ownership_raw.U64_MAX) == ownership_raw.U64_MAX);
    assert(ownership_state.equal(&before, &e.local.state));
    println("additional input guards");
}

fn unproved_reference_cast() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.open(&e);
    e.root = ownership_raw_env.integer(&e);
    types.node* from = types.type_ptr(&e.table, e.byte, false, false);
    types.node* to = types.type_voidptr(&e.table, false, false);
    ownership_raw.result mut casted = ownership_raw_env.cast_value(&e, &e.root, from, to);
    defer ownership_raw.free_result(&casted);
    ownership_raw_env.accepts(&casted);
    assert(!casted.addresses[0].complete && casted.storage.origins.len == 0);
    ownership_raw_env.rejected(ownership_raw_env.access(&e, &casted, e.byte));
    println("unproved reference cast preserves missing source");
}


fn range_operand_work() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.zero_bound_heap(&e);
    ownership_state.state mut before = ownership_state.clone(&e.local.state);
    defer ownership_state.free(&before);
    ownership_raw.term[128] mut lower_terms = {};
    ownership_raw.term[128] mut upper_terms = {};
    ownership_raw.expression lower = ownership_raw_env.zero_terms(lower_terms[..]);
    ownership_raw.expression upper = ownership_raw_env.zero_terms(upper_terms[..]);
    ownership_raw.request mut req = ownership_raw_env.request(&e);
    e.budget.meter.bounds.w = 300000;
    req.limits.w = e.budget.meter.bounds.w;
    ownership_raw.result mut accepted = ownership_raw.slice_ptr(&e.root.storage,
        &e.local.service, e.root.addresses[..], lower, upper, e.byte, &req);
    ownership_raw_env.accepts(&accepted);
    assert(accepted.addresses[0].begin.terms.len == 128 &&
        accepted.addresses[0].end.terms.len == 128);
    ownership_raw.free_result(&accepted);
    ownership_raw_env.remaining_work(&e, 25);
    ownership_raw.result mut refused = ownership_raw.slice_ptr(&e.root.storage,
        &e.local.service, e.root.addresses[..], lower, upper, e.byte, &req);
    ownership_raw_env.work_failure(&e, refused.proof, &req);
    ownership_raw_env.rejects(&refused);
    assert(ownership_state.equal(&before, &e.local.state));
    ownership_raw_env.source(&e.root, 1, 0, 8);
    assert(e.root.storage.bounds.len == 1 && lower.terms.len == 128 && upper.terms.len == 128);
    println("range operand work exhaustion");
}
fn subobject_operand_work() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.zero_bound_heap(&e);
    ownership_state.state mut before = ownership_state.clone(&e.local.state);
    defer ownership_state.free(&before);
    ownership_raw.term[128] mut lower_terms = {};
    ownership_raw.term[128] mut upper_terms = {};
    ownership_raw.expression lower = ownership_raw_env.zero_terms(lower_terms[..]);
    ownership_raw.expression upper = ownership_raw_env.zero_terms(upper_terms[..]);
    ownership_raw.request mut req = ownership_raw_env.request(&e);
    e.budget.meter.bounds.w = 300000;
    req.limits.w = e.budget.meter.bounds.w;
    ownership_raw.result mut accepted = ownership_raw.derive_address(&e.root.storage,
        &e.local.service, e.root.addresses[..], lower, upper, e.byte, &req);
    ownership_raw_env.accepts(&accepted);
    assert(accepted.addresses[0].begin.terms.len == 128 &&
        accepted.addresses[0].end.terms.len == 128);
    ownership_raw.free_result(&accepted);
    ownership_raw_env.remaining_work(&e, 25);
    ownership_raw.result mut refused = ownership_raw.derive_address(&e.root.storage,
        &e.local.service, e.root.addresses[..], lower, upper, e.byte, &req);
    ownership_raw_env.work_failure(&e, refused.proof, &req);
    ownership_raw_env.rejects(&refused);
    assert(ownership_state.equal(&before, &e.local.state));
    ownership_raw_env.source(&e.root, 1, 0, 8);
    assert(e.root.storage.bounds.len == 1 && lower.terms.len == 128 && upper.terms.len == 128);
    println("subobject operand work exhaustion");
}
fn accepted_depth_boundary() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.open(&e);
    ownership_local_env.add_stack(&e.local, 1);
    ownership_raw.request mut req = ownership_raw_env.request(&e);
    types.node* mut selected = e.byte;
    u64 mut i = 1;
    while (i <= req.limits.d) { selected = types.type_array(&e.table, selected, 1); i += 1; }
    ownership_raw.origin input = ownership_raw_env.origin(&e, 1, selected,
        ownership_raw.literal(1), ownership_raw.literal(1), false);
    ownership_state.state mut before = ownership_state.clone(&e.local.state);
    defer ownership_state.free(&before);
    e.root = ownership_raw.capture_origin(&e.local.state, &e.local.service, &input,
        ownership_raw_env.NO_BOUNDS, ownership_raw_env.NO_RELATIONS, &req);
    ownership_raw_env.accepts(&e.root);
    assert(e.root.storage.leaves_len == 1 &&
        e.root.storage.leaves[0].place.projections.len == req.limits.d);
    ownership_raw_env.accepted(ownership_raw.access(&e.root.storage, &e.local.service,
        e.root.addresses[..], selected, &req));
    assert(ownership_state.equal(&before, &e.local.state));
    println("accepted storage depth boundary");
}
fn first_depth_rejection() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.open(&e);
    ownership_local_env.add_stack(&e.local, 1);
    ownership_raw.request mut req = ownership_raw_env.request(&e);
    types.node* mut selected = e.byte;
    u64 mut i = 0;
    while (i <= req.limits.d) { selected = types.type_array(&e.table, selected, 1); i += 1; }
    ownership_raw.origin input = ownership_raw_env.origin(&e, 1, selected,
        ownership_raw.literal(1), ownership_raw.literal(1), false);
    ownership_state.state mut before = ownership_state.clone(&e.local.state);
    defer ownership_state.free(&before);
    e.root = ownership_raw.capture_origin(&e.local.state, &e.local.service, &input,
        ownership_raw_env.NO_BOUNDS, ownership_raw_env.NO_RELATIONS, &req);
    ownership_raw_env.rejected(e.root.proof);
    assert(e.root.proof.terminal.reason != ownership_api.incomplete_reason.work_limit);
    ownership_raw_env.rejects(&e.root);
    assert(ownership_state.equal(&before, &e.local.state));
    println("first storage depth rejection");
}
fn preliminary_size_work() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.open(&e);
    ownership_raw.request mut req = ownership_raw_env.request(&e);
    req.limits.d = 1;
    e.budget.meter.bounds.d = req.limits.d;
    types.node* mut selected = e.byte;
    u64 mut i = 0;
    while (i < 32) { selected = types.type_array(&e.table, selected, 1); i += 1; }
    u64 mut bytes = 999;
    u64 before = e.budget.meter.used.w;
    ownership_raw_env.accepted(ownership_raw.size(selected, &e.local.service, &req, &bytes));
    assert(bytes == 1 && e.budget.meter.used.w - before == 771 &&
        e.budget.meter.used.d == 0);
    ownership_raw_env.remaining_work(&e, 3);
    bytes = 999;
    ownership_api.proof_status refused = ownership_raw.size(selected, &e.local.service, &req,
        &bytes);
    ownership_raw_env.work_failure(&e, refused, &req);
    assert(bytes == 999);
    println("preliminary type sizing work exhaustion");
}
fn retained_projection_work() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.heap(&e, 8);
    ownership_raw.origin mut input = e.root.storage.origins[0];
    ownership_raw.request mut req = ownership_raw_env.request(&e);
    u64 mut before = e.budget.meter.used.w;
    ownership_raw.result mut plain = ownership_raw.capture_origin(&e.local.state,
        &e.local.service, &input, ownership_raw_env.NO_BOUNDS, ownership_raw_env.NO_RELATIONS,
        &req);
    ownership_raw_env.accepts(&plain);
    u64 plain_capture = e.budget.meter.used.w - before;
    types.node* from = types.type_ptr(&e.table, e.byte, false, false);
    types.node* to = types.type_voidptr(&e.table, false, false);
    before = e.budget.meter.used.w;
    ownership_raw.result mut casted = ownership_raw.cast_reference(&plain.storage,
        &e.local.service, plain.addresses[..], from, to, &req);
    ownership_raw_env.accepts(&casted);
    u64 plain_clone = e.budget.meter.used.w - before;
    ownership_raw.free_result(&casted);
    ownership_raw.free_result(&plain);
    ownership_api.projection[8] mut parts = {};
    ownership_raw_env.projections(parts[..]);
    input.place.projections = parts[..];
    before = e.budget.meter.used.w;
    ownership_raw.result mut projected = ownership_raw.capture_origin(&e.local.state,
        &e.local.service, &input, ownership_raw_env.NO_BOUNDS, ownership_raw_env.NO_RELATIONS,
        &req);
    defer ownership_raw.free_result(&projected);
    ownership_raw_env.accepts(&projected);
    assert(e.budget.meter.used.w - before == plain_capture + 3 * parts.len + 7);
    assert(projected.storage.origins[0].place.projections.len == parts.len &&
        projected.storage.leaves[0].place.projections.len == parts.len);
    before = e.budget.meter.used.w;
    casted = ownership_raw.cast_reference(&projected.storage, &e.local.service,
        projected.addresses[..], from, to, &req);
    ownership_raw_env.accepts(&casted);
    assert(e.budget.meter.used.w - before > plain_clone + 2 * parts.len);
    ownership_raw.free_result(&casted);
    ownership_raw_env.remaining_work(&e, plain_clone);
    casted = ownership_raw.cast_reference(&projected.storage, &e.local.service,
        projected.addresses[..], from, to, &req);
    ownership_raw_env.work_failure(&e, casted.proof, &req);
    ownership_raw_env.rejects(&casted);
    assert(projected.storage.leaves_len == 1 && parts[0].index.value == 0);
    println("retained projection copy work exhaustion");
}
