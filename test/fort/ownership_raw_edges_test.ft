//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| reject extent_product_overflow
//| reject endpoint_add_overflow
//| reject wrapped_endpoint_is_not_extent
//| reject released_heap_source
//| reject ended_stack_source
//| reject mixed_live_and_ended_sources
//| accept zero_allocation_inspection
//| reject zero_allocation_element
//| accept zero_allocation_move
//| accept zero_allocation_release
//| reject zero_allocation_lost_owner
//| accept existing_foreign_trust
//| reject cast_cannot_create_trust
//| reject known_released_foreign_allocation
//| reject missing_event_map
//| reject malformed_source_key
//| reject unresolved_layout
//| reject required_residual_fact
//| reject denied_charge_preserves_input
//| additional input guards
//| unproved reference cast preserves missing source
//| range operand work exhaustion
//| subobject operand work exhaustion
//| accepted type depth boundary
//| first type depth rejection
//| preliminary type sizing work exhaustion
//| retained projection copy work exhaustion
//| array projection copy work exhaustion
//| field projection copy work exhaustion
//| checked array sizing preserves overflow refusal
//| successful result allocator teardown
//| early failure allocator teardown
//| late failure allocator teardown
/// Tests required raw-range verdicts from captured compiler facts.
import check_env;
import heap;
import ownership_api;
import ownership_keys;
import ownership_local_env;
import ownership_raw;
import ownership_raw_env;
import ownership_state;
import ownership_transfer;
import prim;
import std.libc;
import std.str;
import types;

fn extent_product_overflow() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.open(&e);
    ownership_raw_env.accepted(ownership_local_env.alloc(&e.local, 1, 1, 1, 0));
    ownership_api.scalar_fact mut count = ownership_api.scalar_fact{};
    count.kind = ownership_api.fact_kind.symbolic;
    count.symbol = ownership_local_env.id(ownership_api.entity_kind.value, 10);
    e.local.state.allocations[0].logical_length = count;
    ownership_raw.term[1] mut count_terms = {};
    ownership_raw.term[1] mut extent_terms = {};
    ownership_raw.expression n = ownership_raw_env.symbol(10, count_terms[..], 1);
    ownership_raw.expression bytes = ownership_raw_env.symbol(10, extent_terms[..], 4);
    ownership_raw.captured_bound[1] bounds = {ownership_raw.captured_bound{count.symbol,
        ownership_raw.natural(ownership_raw.U64_MAX),
            ownership_raw.natural(ownership_raw.U64_MAX)}};
    types.node* word = types.type_prim(&e.table, prim.prim_kind.prim_i32);
    ownership_raw.origin input = ownership_raw_env.origin(&e, 1, word, n, bytes, true);
    ownership_raw.request mut req = ownership_raw_env.request(&e);
    ownership_raw.result mut value = ownership_raw.capture_origin(&e.local.state,
        &e.local.service, &input, bounds[..], ownership_raw_env.NO_RELATIONS, &req);
    ownership_raw_env.rejects(&value);
    assert(e.local.state.allocations[0].obligation);
    println("reject extent_product_overflow");
}

fn endpoint_add_overflow() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.symbolic_heap(&e, 1, ownership_raw.U64_MAX, ownership_raw.U64_MAX);
    ownership_raw.result mut selected = ownership_raw_env.window(&e, &e.root,
        ownership_raw.U64_MAX - 1, ownership_raw.U64_MAX);
    defer ownership_raw.free_result(&selected);
    ownership_raw.result mut value = ownership_raw_env.slice(&e, &selected,
        ownership_raw.literal(0), ownership_raw.literal(2), e.byte);
    ownership_raw_env.rejects(&value);
    println("reject endpoint_add_overflow");
}

fn wrapped_endpoint_is_not_extent() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.heap(&e, 16);
    u64 wrapped = ownership_raw.U64_MAX *% 8;
    assert(wrapped == ownership_raw.U64_MAX - 7);
    types.node* wide = types.type_prim(&e.table, prim.prim_kind.prim_u64);
    ownership_raw.result mut value = ownership_raw_env.slice(&e, &e.root,
        ownership_raw.literal(0), ownership_raw.literal(ownership_raw.U64_MAX), wide);
    ownership_raw_env.rejects(&value);
    println("reject wrapped_endpoint_is_not_extent");
}

fn released_heap_source() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.heap(&e, 16);
    ownership_raw_env.accepted(ownership_local_env.release(&e.local, 1, true));
    ownership_raw_env.rejected(ownership_raw_env.access(&e, &e.root, e.byte));
    assert(e.local.counts.last_kind == ownership_api.event_kind.invalid_use);
    println("reject released_heap_source");
}

fn ended_stack_source() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.object(&e, 8);
    e.local.state.sources[0].validity = ownership_api.validity_kind.ended;
    ownership_raw_env.rejected(ownership_raw_env.access(&e, &e.root, e.byte));
    assert(e.local.counts.last_kind == ownership_api.event_kind.invalid_use);
    println("reject ended_stack_source");
}

fn mixed_live_and_ended_sources() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.object(&e, 8);
    ownership_local_env.add_stack(&e.local, 2);
    ownership_raw.origin[2] mut inputs = {e.root.storage.origins[0], e.root.storage.origins[0]};
    inputs[1].source.ordinal = 2;
    inputs[1].place.root.ordinal = 2;
    ownership_raw.request mut req = ownership_raw_env.request(&e);
    ownership_raw.result mut value = ownership_raw.capture_origins(&e.local.state,
        &e.local.service, inputs[..], ownership_raw_env.NO_BOUNDS, ownership_raw_env.NO_RELATIONS,
            &req);
    defer ownership_raw.free_result(&value);
    ownership_raw_env.accepts(&value);
    e.local.state.sources[1].validity = ownership_api.validity_kind.ended;
    ownership_raw_env.rejected(ownership_raw_env.access(&e, &value, e.byte));
    assert(value.addresses.len == 2 && e.local.state.sources[0].validity ==
        ownership_api.validity_kind.live);
    println("reject mixed_live_and_ended_sources");
}

fn zero_allocation_inspection() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.heap(&e, 0);
    ownership_raw.request mut req = ownership_raw_env.request(&e);
    ownership_raw_env.accepted(ownership_raw.inspect_empty_header(&e.local.state,
        &e.local.service, &e.local.state.contents[0], false, &req));
    assert(e.local.state.allocations[0].obligation && e.local.state.allocations[0].count.one);
    println("accept zero_allocation_inspection");
}

fn zero_allocation_element() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.heap(&e, 0);
    ownership_raw_env.rejected(ownership_raw_env.access(&e, &e.root, e.byte));
    assert(e.local.state.allocations[0].obligation);
    println("reject zero_allocation_element");
}

fn zero_allocation_move() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.heap(&e, 0);
    ownership_raw_env.accepted(ownership_local_env.move_owner(&e.local, 1, 2));
    assert(e.local.state.allocations[0].obligation &&
        e.local.state.allocations[0].owner.place.root.ordinal == 2);
    assert(e.local.state.contents[0].owner_empty);
    println("accept zero_allocation_move");
}

fn zero_allocation_release() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.heap(&e, 0);
    ownership_raw_env.accepted(ownership_local_env.release(&e.local, 1, true));
    assert(!e.local.state.allocations[0].obligation &&
        e.local.state.allocations[0].validity == ownership_api.validity_kind.released);
    println("accept zero_allocation_release");
}

fn zero_allocation_lost_owner() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.heap(&e, 0);
    ownership_raw.request mut req = ownership_raw_env.request(&e);
    req.base.kind = ownership_transfer.action.dead;
    req.base.source_key = ownership_local_env.id(ownership_api.entity_kind.source, 1);
    ownership_raw_env.rejected(ownership_transfer.apply(&e.local.state, &e.local.service,
        &req.base));
    assert(e.local.counts.last_kind == ownership_api.event_kind.lost_ownership);
    assert(e.local.state.allocations[0].obligation);
    println("reject zero_allocation_lost_owner");
}

fn existing_foreign_trust() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.trusted(&e);
    types.node* wide = types.type_array(&e.table, e.byte, 4096);
    ownership_raw_env.accepted(ownership_raw_env.access(&e, &e.root, wide));
    assert(e.local.state.sources[0].kind == ownership_api.source_kind.trusted_foreign);
    println("accept existing_foreign_trust");
}

fn cast_cannot_create_trust() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.heap(&e, 1);
    types.node* pointer = types.type_ptr(&e.table, e.byte, false, false);
    types.node* erased = types.type_voidptr(&e.table, false, false);
    ownership_raw.result mut value = ownership_raw_env.cast_value(&e, &e.root, pointer, erased);
    defer ownership_raw.free_result(&value);
    types.node* wide = types.type_prim(&e.table, prim.prim_kind.prim_u64);
    ownership_raw_env.rejected(ownership_raw_env.access(&e, &value, wide));
    assert(e.local.state.sources[0].kind == ownership_api.source_kind.heap);
    println("reject cast_cannot_create_trust");
}

fn known_released_foreign_allocation() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.heap(&e, 8);
    e.local.state.sources[0].kind = ownership_api.source_kind.trusted_foreign;
    ownership_raw.request mut req = ownership_raw_env.request(&e);
    ownership_api.mutation_result released = ownership_state.release_member(&e.local.state,
        &e.local.service, e.local.state.allocations[0].key, true,
        req.base.operation, req.base.source_position);
    assert(released.applied);
    e.local.state.sources[0].validity = ownership_api.validity_kind.live;
    ownership_raw_env.rejected(ownership_raw_env.access(&e, &e.root, e.byte));
    println("reject known_released_foreign_allocation");
}

fn missing_event_map() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.heap(&e, 8);
    ownership_raw.request mut req = ownership_raw_env.request(&e);
    req.base.event_map_complete_proved = false;
    ownership_api.proof_status proof = ownership_raw.access(&e.root.storage,
        &e.local.service, e.root.addresses[..], e.byte, &req);
    ownership_raw_env.rejected(proof);
    assert(proof.terminal.reason == ownership_api.incomplete_reason.missing_events);
    println("reject missing_event_map");
}

fn malformed_source_key() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.heap(&e, 8);
       ownership_raw.origin mut input = e.root.storage.origins[0];
    input.source.kind = ownership_api.entity_kind.value;
       ownership_raw.request mut req = ownership_raw_env.request(&e);
       ownership_raw.result mut value = ownership_raw.capture_origin(&e.local.state,
           &e.local.service, &input, ownership_raw_env.NO_BOUNDS, ownership_raw_env.NO_RELATIONS,
               &req);
       ownership_raw_env.rejects(&value);
       assert(e.local.state.allocations[0].obligation);
    println("reject malformed_source_key");
}

