    ownership_raw_env.accepted(ownership_raw.access(&e.root.storage, &e.local.service,
        values[..], e.byte, &req));
    println("unit-a accept address_validation_access");
    terms[127].coefficient.valid = false;
    ownership_raw_env.remaining_work(&e, 25);
    value = ownership_raw.start(&e.root.storage, &e.local.service, values[..], &req, 0);
    ownership_raw_env.work_failure(&e, value.proof, &req);
    ownership_raw_env.rejects(&value);
    println("unit-a reject address_validation_start");
    ownership_raw_env.remaining_work(&e, 25);
    ownership_raw_env.work_failure(&e, ownership_raw.access(&e.root.storage, &e.local.service,
        values[..], e.byte, &req), &req);
    assert(e.root.addresses[0].offset.terms.len == 0 && !terms[127].coefficient.valid);
    println("unit-a reject address_validation_access");
}
fn metadata_work(u32 mode) void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.symbolic_heap(&e, 1, 0, 8);
    ownership_api.projection[8] mut parts = {};
    ownership_raw_env.projections(parts[..]);
    if (mode == 0) { e.root.storage.origins[0].place.projections = parts[..]; }
    if (mode == 1) { e.root.storage.leaves[0].place.projections = parts[..]; }
    if (mode == 3) {
        del(e.root.storage.relations);
        e.root.storage.relations = new(ownership_raw.relation, 1);
        ownership_raw.term[128] mut terms = {};
        ownership_raw.expression item = ownership_raw_env.zero_terms(terms[..]);
        e.root.storage.relations[0].left = ownership_raw.copy_expression(&e.root.storage, item);
        e.root.storage.relations[0].right = ownership_raw.copy_expression(&e.root.storage, item);
    }
    ownership_raw.request mut req = ownership_raw_env.request(&e);
    ownership_raw.work_cursor mut cursor = {};
    ownership_raw.calculation mut work = ownership_raw_env.calculation(&e, &req, &cursor);
    u64 mut price = 999;
    assert(ownership_raw.measure_context_work(&work, e.root.addresses[..], 0, &price));
    ownership_raw_env.accepted(work.proof);
    assert(price != 999);
    string name = mode == 0 ? "origin_metadata" : mode == 1 ? "leaf_metadata" :
        mode == 2 ? "term_block_metadata" : "relation_metadata";
    println("unit-a accept ", name);
    ownership_raw_env.remaining_work(&e, 1);
    work.proof = ownership_raw.complete();
    price = 999;
    assert(!ownership_raw.measure_context_work(&work, e.root.addresses[..], 0, &price));
    ownership_raw_env.work_failure(&e, work.proof, &req);
    assert(price == 999 && e.root.storage.origins.len == 1);
    println("unit-a reject ", name);
}
fn query_bound_work() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.heap(&e, 8);
    del(e.root.storage.bounds);
    e.root.storage.bounds = new(ownership_raw.captured_bound, 127);
    u64 mut i = 0;
    while (i < e.root.storage.bounds.len) {
        e.root.storage.bounds[i] = ownership_raw.captured_bound{
            ownership_local_env.id(ownership_api.entity_kind.value, cast(i, u32) + 20),
            ownership_raw.natural(1), ownership_raw.natural(1)};
        i += 1;
    }
    e.root.storage.bounds[126].version = ownership_local_env.id(
        ownership_api.entity_kind.value, 10);
    ownership_raw.term[1] mut terms = {};
    ownership_raw.expression left = ownership_raw_env.symbol(10, terms[..], 1);
    ownership_raw.request mut req = ownership_raw_env.request(&e);
    ownership_raw_env.accepted(ownership_raw.compare_expressions(&e.root.storage,
        &e.local.service, left, ownership_raw.literal(2), &req));
    println("unit-a accept query_bound_lookup");
    ownership_raw_env.remaining_work(&e, 25);
    ownership_raw_env.work_failure(&e, ownership_raw.compare_expressions(&e.root.storage,
        &e.local.service, left, ownership_raw.literal(2), &req), &req);
    assert(e.root.storage.bounds[126].version.ordinal == 10 && terms[0].coefficient.magnitude == 1);
    println("unit-a reject query_bound_lookup");
}
fn query_relation_work() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.heap(&e, 8);
    ownership_raw.term[128] mut left_terms = {};
    ownership_raw.term[128] mut right_terms = {};
    ownership_raw.expression mut left = ownership_raw_env.zero_terms(left_terms[..]);
    ownership_raw.expression mut right = ownership_raw_env.zero_terms(right_terms[..]);
    u64 mut i = 0;
    while (i < right_terms.len) { right_terms[i].version.ordinal = 11; i += 1; }
    del(e.root.storage.relations);
    e.root.storage.relations = new(ownership_raw.relation, 1);
    e.root.storage.relations[0].left = ownership_raw.copy_expression(&e.root.storage, left);
    e.root.storage.relations[0].right = ownership_raw.copy_expression(&e.root.storage, right);
    ownership_raw.term[1] mut query_left = {};
    ownership_raw.term[1] mut query_right = {};
    left = ownership_raw_env.symbol(10, query_left[..], 128);
    right = ownership_raw_env.symbol(11, query_right[..], 128);
    ownership_raw.request mut req = ownership_raw_env.request(&e);
    u64 before = e.budget.meter.used.w;
    ownership_raw_env.accepted(ownership_raw.compare_expressions(&e.root.storage,
        &e.local.service, left, right, &req));
    assert(e.budget.meter.used.w - before > 32000);
    println("unit-a accept query_relation_terms");
    ownership_raw_env.remaining_work(&e, 100);
    ownership_raw_env.work_failure(&e, ownership_raw.compare_expressions(&e.root.storage,
        &e.local.service, left, right, &req), &req);
    assert(e.root.storage.relations[0].left.terms.len == 128 &&
        query_right[0].version.ordinal == 11);
    println("unit-a reject query_relation_terms");
}
fn event_map_work() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.heap(&e, 8);
