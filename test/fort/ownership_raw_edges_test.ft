fn denied_charge_preserves_input() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.symbolic_heap(&e, 4, 0, 64);
    ownership_state.state mut before = ownership_state.clone(&e.local.state);
    defer ownership_state.free(&before);
    ownership_raw.context mut raw_before = ownership_raw.clone(&e.root.storage, &before);
    defer ownership_raw.free(&raw_before);
    ownership_raw.origin mut input = e.root.storage.origins[0];
    ownership_raw.request mut req = ownership_raw_env.request(&e);
    e.budget.deny_at = e.budget.calls + 8;
    ownership_raw.result mut value = ownership_raw.capture_origin(&e.local.state,
        &e.local.service, &input, e.root.storage.bounds[..], ownership_raw_env.NO_RELATIONS, &req);
    ownership_raw_env.rejected(value.proof);
    assert(value.proof.terminal.limit.present && value.proof.terminal.limit.used == 7 &&
        value.proof.terminal.limit.bound == 7 && value.proof.terminal.limit.attempted > 0);
    assert(ownership_keys.operation(value.proof.terminal.limit.operation, req.base.operation) == 0);
    assert(e.local.counts.last_kind == ownership_api.event_kind.work_failure);
    ownership_raw_env.rejects(&value);
    assert(ownership_state.equal(&before, &e.local.state));
    assert(ownership_raw.same_expression(raw_before.origins[0].end,
        e.root.storage.origins[0].end));
    assert(raw_before.leaves_len == e.root.storage.leaves_len);
    println("reject denied_charge_preserves_input");
}

fn additional_input_guards() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.heap(&e, 8);
    ownership_state.state mut before = ownership_state.clone(&e.local.state);
    defer ownership_state.free(&before);
    ownership_raw.request mut req = ownership_raw_env.request(&e);
    req.alternatives_complete = false;
    ownership_raw_env.rejected(ownership_raw.access(&e.root.storage, &e.local.service,
        e.root.addresses[..], e.byte, &req));
    req = ownership_raw_env.request(&e);
    req.captured_values = false;
    ownership_raw_env.rejected(ownership_raw.access(&e.root.storage, &e.local.service,
        e.root.addresses[..], e.byte, &req));
    req = ownership_raw_env.request(&e);
    ownership_raw.address[1] mut forged = {e.root.addresses[0]};
    forged[0].end = ownership_raw.literal(9);
    ownership_raw_env.rejected(ownership_raw.access(&e.root.storage, &e.local.service,
        forged[..], e.byte, &req));
    forged[0] = e.root.addresses[0];
    forged[0].alignment = 16;
    ownership_raw_env.rejected(ownership_raw.access(&e.root.storage, &e.local.service,
        forged[..], e.byte, &req));
    ownership_raw.term[129] mut excessive = {};
    u64 mut i = 0;
    while (i < excessive.len) {
        excessive[i] = ownership_raw.term{ownership_local_env.id(
            ownership_api.entity_kind.value, 10), ownership_raw.natural(1)};
        i += 1;
    }
    ownership_raw.origin mut input = e.root.storage.origins[0];
    ownership_raw.expression mut count = input.count;
    count.terms = excessive[..];
    input.count = count;
    ownership_raw.result mut failed = ownership_raw.capture_origin(&e.local.state,
        &e.local.service, &input, ownership_raw_env.NO_BOUNDS, ownership_raw_env.NO_RELATIONS,
        &req);
    ownership_raw_env.rejects(&failed);
    assert(ownership_raw.add_work(ownership_raw.U64_MAX, 1) == ownership_raw.U64_MAX);
    assert(ownership_raw.square_work(ownership_raw.U64_MAX) == ownership_raw.U64_MAX);
    assert(ownership_state.equal(&before, &e.local.state));
    println("additional input guards");
}

fn unproved_reference_cast() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.open(&e);
    e.root = ownership_raw_env.integer(&e);
    types.node* from = types.type_ptr(&e.table, e.byte, false, false);
    types.node* to = types.type_voidptr(&e.table, false, false);
    ownership_raw.result mut casted = ownership_raw_env.cast_value(&e, &e.root, from, to);
    defer ownership_raw.free_result(&casted);
    ownership_raw_env.accepts(&casted);
    assert(!casted.addresses[0].complete && casted.storage.origins.len == 0);
    ownership_raw_env.rejected(ownership_raw_env.access(&e, &casted, e.byte));
    println("unproved reference cast preserves missing source");
}


fn range_operand_work() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.zero_bound_heap(&e);
    ownership_state.state mut before = ownership_state.clone(&e.local.state);
    defer ownership_state.free(&before);
    ownership_raw.term[128] mut lower_terms = {};
    ownership_raw.term[128] mut upper_terms = {};
    ownership_raw.expression lower = ownership_raw_env.zero_terms(lower_terms[..]);
    ownership_raw.expression upper = ownership_raw_env.zero_terms(upper_terms[..]);
    ownership_raw.request mut req = ownership_raw_env.request(&e);
    e.budget.meter.bounds.w = 300000;
    req.limits.w = e.budget.meter.bounds.w;
    ownership_raw.result mut accepted = ownership_raw.slice_ptr(&e.root.storage,
        &e.local.service, e.root.addresses[..], lower, upper, e.byte, &req);
    ownership_raw_env.accepts(&accepted);
    assert(accepted.addresses[0].begin.terms.len == 128 &&
        accepted.addresses[0].end.terms.len == 128);
    ownership_raw.free_result(&accepted);
    ownership_raw_env.remaining_work(&e, 25);
    ownership_raw.result mut refused = ownership_raw.slice_ptr(&e.root.storage,
        &e.local.service, e.root.addresses[..], lower, upper, e.byte, &req);
    ownership_raw_env.work_failure(&e, refused.proof, &req);
    ownership_raw_env.rejects(&refused);
    assert(ownership_state.equal(&before, &e.local.state));
    ownership_raw_env.source(&e.root, 1, 0, 8);
    assert(e.root.storage.bounds.len == 1 && lower.terms.len == 128 && upper.terms.len == 128);
    println("range operand work exhaustion");
}
fn subobject_operand_work() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.zero_bound_heap(&e);
    ownership_state.state mut before = ownership_state.clone(&e.local.state);
    defer ownership_state.free(&before);
    ownership_raw.term[128] mut lower_terms = {};
    ownership_raw.term[128] mut upper_terms = {};
    ownership_raw.expression lower = ownership_raw_env.zero_terms(lower_terms[..]);
    ownership_raw.expression upper = ownership_raw_env.zero_terms(upper_terms[..]);
    ownership_raw.request mut req = ownership_raw_env.request(&e);
    e.budget.meter.bounds.w = 300000;
    req.limits.w = e.budget.meter.bounds.w;
    ownership_raw.result mut accepted = ownership_raw.derive_address(&e.root.storage,
        &e.local.service, e.root.addresses[..], lower, upper, e.byte, &req);
    ownership_raw_env.accepts(&accepted);
    assert(accepted.addresses[0].begin.terms.len == 128 &&
        accepted.addresses[0].end.terms.len == 128);
    ownership_raw.free_result(&accepted);
    ownership_raw_env.remaining_work(&e, 25);
    ownership_raw.result mut refused = ownership_raw.derive_address(&e.root.storage,
        &e.local.service, e.root.addresses[..], lower, upper, e.byte, &req);
    ownership_raw_env.work_failure(&e, refused.proof, &req);
    ownership_raw_env.rejects(&refused);
    assert(ownership_state.equal(&before, &e.local.state));
    ownership_raw_env.source(&e.root, 1, 0, 8);
    assert(e.root.storage.bounds.len == 1 && lower.terms.len == 128 && upper.terms.len == 128);
    println("subobject operand work exhaustion");
}
fn accepted_depth_boundary() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.open(&e);
    ownership_local_env.add_stack(&e.local, 1);
    ownership_raw.request mut req = ownership_raw_env.request(&e);
    types.node* mut selected = e.byte;
    u64 mut i = 1;
    while (i < req.limits.d) { selected = types.type_array(&e.table, selected, 1); i += 1; }
    ownership_raw.origin input = ownership_raw_env.origin(&e, 1, selected,
        ownership_raw.literal(1), ownership_raw.literal(1), false);
    ownership_state.state mut before = ownership_state.clone(&e.local.state);
    defer ownership_state.free(&before);
    e.root = ownership_raw.capture_origin(&e.local.state, &e.local.service, &input,
        ownership_raw_env.NO_BOUNDS, ownership_raw_env.NO_RELATIONS, &req);
    ownership_raw_env.accepts(&e.root);
    assert(e.root.storage.leaves_len == 1 &&
        e.root.storage.leaves[0].place.projections.len == req.limits.d - 1);
    ownership_raw_env.accepted(ownership_raw.access(&e.root.storage, &e.local.service,
        e.root.addresses[..], selected, &req));
    assert(ownership_state.equal(&before, &e.local.state));
    println("accepted type depth boundary");
}
fn first_depth_rejection() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.open(&e);
    ownership_local_env.add_stack(&e.local, 1);
    ownership_raw.request mut req = ownership_raw_env.request(&e);
    types.node* mut selected = e.byte;
    u64 mut i = 0;
    while (i < req.limits.d) { selected = types.type_array(&e.table, selected, 1); i += 1; }
    ownership_raw.origin input = ownership_raw_env.origin(&e, 1, selected,
        ownership_raw.literal(1), ownership_raw.literal(1), false);
    ownership_state.state mut before = ownership_state.clone(&e.local.state);
    defer ownership_state.free(&before);
    e.root = ownership_raw.capture_origin(&e.local.state, &e.local.service, &input,
        ownership_raw_env.NO_BOUNDS, ownership_raw_env.NO_RELATIONS, &req);
    ownership_raw_env.rejected(e.root.proof);
    assert(e.root.proof.terminal.reason != ownership_api.incomplete_reason.work_limit);
    ownership_raw_env.rejects(&e.root);
    assert(ownership_state.equal(&before, &e.local.state));
    println("first type depth rejection");
}
fn preliminary_size_work() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.open(&e);
    ownership_raw.request mut req = ownership_raw_env.request(&e);
    req.limits.d = 64;
    e.budget.meter.bounds.d = req.limits.d;
    types.node* mut selected = e.byte;
    u64 mut i = 0;
    while (i < 32) { selected = types.type_array(&e.table, selected, 1); i += 1; }
    u64 mut bytes = 999;
    u64 before = e.budget.meter.used.w;
    ownership_raw_env.accepted(ownership_raw.size(selected, &e.local.service, &req, 0, &bytes));
    assert(bytes == 1 && e.budget.meter.used.w - before == 33);
    ownership_raw_env.remaining_work(&e, 3);
    bytes = 999;
    ownership_api.proof_status refused = ownership_raw.size(selected, &e.local.service, &req,
        0, &bytes);
    ownership_raw_env.work_failure(&e, refused, &req);
    assert(bytes == 999);
    println("preliminary type sizing work exhaustion");
}
fn retained_projection_work() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.heap(&e, 8);
    ownership_raw.origin mut input = e.root.storage.origins[0];
    ownership_raw.request mut req = ownership_raw_env.request(&e);
    u64 mut before = e.budget.meter.used.w;
    ownership_raw.result mut plain = ownership_raw.capture_origin(&e.local.state,
        &e.local.service, &input, ownership_raw_env.NO_BOUNDS, ownership_raw_env.NO_RELATIONS,
        &req);
    ownership_raw_env.accepts(&plain);
    u64 plain_capture = e.budget.meter.used.w - before;
    types.node* from = types.type_ptr(&e.table, e.byte, false, false);
    types.node* to = types.type_voidptr(&e.table, false, false);
    before = e.budget.meter.used.w;
    ownership_raw.result mut casted = ownership_raw.cast_reference(&plain.storage,
        &e.local.service, plain.addresses[..], from, to, &req);
    ownership_raw_env.accepts(&casted);
    u64 plain_clone = e.budget.meter.used.w - before;
    ownership_raw.free_result(&casted);
    ownership_raw.free_result(&plain);
    ownership_api.projection[8] mut parts = {};
    ownership_raw_env.projections(parts[..]);
    input.place.projections = parts[..];
    before = e.budget.meter.used.w;
    ownership_raw.result mut projected = ownership_raw.capture_origin(&e.local.state,
        &e.local.service, &input, ownership_raw_env.NO_BOUNDS, ownership_raw_env.NO_RELATIONS,
        &req);
    defer ownership_raw.free_result(&projected);
    ownership_raw_env.accepts(&projected);
    assert(e.budget.meter.used.w - before == plain_capture + 2 * parts.len);
    assert(projected.storage.origins[0].place.projections.len == parts.len &&
        projected.storage.leaves[0].place.projections.len == parts.len);
    before = e.budget.meter.used.w;
    casted = ownership_raw.cast_reference(&projected.storage, &e.local.service,
        projected.addresses[..], from, to, &req);
    ownership_raw_env.accepts(&casted);
    assert(e.budget.meter.used.w - before > plain_clone + 2 * parts.len);
    ownership_raw.free_result(&casted);
    ownership_raw_env.remaining_work(&e, plain_clone);
    casted = ownership_raw.cast_reference(&projected.storage, &e.local.service,
        projected.addresses[..], from, to, &req);
    ownership_raw_env.work_failure(&e, casted.proof, &req);
    ownership_raw_env.rejects(&casted);
    assert(projected.storage.leaves_len == 1 && parts[0].index.value == 0);
    println("retained projection copy work exhaustion");
}
fn array_projection_work() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.heap(&e, 8);
    ownership_raw.context mut output = {};
    defer ownership_raw.free(&output);
    ownership_api.projection[8] mut parts = {};
    ownership_raw_env.projections(parts[..]);
    ownership_api.place_path mut path = ownership_local_env.place(1);
    path.projections = parts[..];
    ownership_raw.request mut req = ownership_raw_env.request(&e);
    ownership_raw_env.remaining_work(&e, 5);
    types.node* selected = types.type_array(&e.table, e.byte, 1);
    ownership_api.proof_status refused = ownership_raw.layout(&output, &e.local.service, &req,
        selected, path, 0, 0);
    ownership_raw_env.work_failure(&e, refused, &req);
    assert(output.leaves_len == 0 && output.paths.blocks == null && output.leaves.ptr == null);
    assert(parts[0].index.value == 0 && e.root.storage.leaves_len == 1);
    println("array projection copy work exhaustion");
}
fn field_projection_work() void {
    check_env.env mut checked = {};
    check_env.open(&checked);
    defer check_env.close(&checked);
    assert(check_env.check_decls(&checked, "struct wrapper { u8 value; }"));
    types.node* selected = check_env.sym_main(&checked, "wrapper")->ty;
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.heap(&e, 8);
    ownership_raw.context mut output = {};
    defer ownership_raw.free(&output);
    ownership_api.projection[8] mut parts = {};
    ownership_raw_env.projections(parts[..]);
    ownership_api.place_path mut path = ownership_local_env.place(1);
    path.projections = parts[..];
    ownership_raw.request mut req = ownership_raw_env.request(&e);
    ownership_raw_env.remaining_work(&e, 6);
    ownership_api.proof_status refused = ownership_raw.layout(&output, &e.local.service, &req,
        selected, path, 0, 0);
    ownership_raw_env.work_failure(&e, refused, &req);
    assert(output.leaves_len == 0 && output.paths.blocks == null && output.leaves.ptr == null);
    assert(parts[0].index.value == 0 && e.root.storage.leaves_len == 1);
    println("field projection copy work exhaustion");
}
fn sizing_array_overflow() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.open(&e);
    ownership_raw.request mut req = ownership_raw_env.request(&e);
    types.node* large = types.type_array(&e.table, e.byte, types.TYPE_MAX_SIZE);
    types.node* overflow = types.type_array(&e.table, large, 2);
    types.node* nested_overflow = types.type_array(&e.table, overflow, 1);
    u64 mut bytes = 999;
    ownership_raw_env.rejected(ownership_raw.size(overflow, &e.local.service, &req, 0, &bytes));
    assert(bytes == 999);
    ownership_raw_env.rejected(ownership_raw.size(nested_overflow, &e.local.service, &req, 0,
        &bytes));
    assert(bytes == 999);
    ownership_raw_env.accepted(ownership_raw.size(large, &e.local.service, &req, 0, &bytes));
    assert(bytes == types.TYPE_MAX_SIZE);
    println("checked array sizing preserves overflow refusal");
}

// These probes measure allocator state separately from abstract input equality.
$if ($cfg(target_os) == "linux") {
    extern fn open_memstream(char mut* own mut* buffer, u64 mut* length) void mut*;
    extern fn malloc_info(i32 options, void mut* stream) i32;
    extern fn fclose(void mut* stream) i32;
    fn metric(string data, string prefix) u64 {
        i64 mut found = str.find(data, prefix);
        assert(found >= 0);
        string mut tail = data[cast(found, u64)..];
        while (true) {
            found = str.find(tail[prefix.len..], prefix);
            if (found < 0) { break; }
            tail = tail[prefix.len + cast(found, u64)..];
        }
        found = str.find(tail, "size=\"");
        assert(found >= 0);
        tail = tail[cast(found, u64) + 6..];
        found = str.index_of(tail, '\"');
        assert(found >= 0);
        u64 mut value = 0;
        assert(str.parse_u64(tail[..cast(found, u64)], 10, &value));
        return value;
    }
    fn live_bytes() u64 {
        char mut* own mut buffer = null;
        u64 mut length = 0;
        void mut* stream = open_memstream(&buffer, &length);
        assert(stream != null && malloc_info(0, stream) == 0 && fclose(stream) == 0);
        string data = cast(buffer[0..length], string);
        u64 arena = metric(data, "<system type=\"current\"");
        u64 fast = metric(data, "<total type=\"fast\"");
        u64 rest = metric(data, "<total type=\"rest\"");
        u64 mapped = metric(data, "<total type=\"mmap\"");
        libc.free(cast(move(buffer), void* own));
        assert(arena >= fast && arena - fast >= rest);
        return arena - fast - rest + mapped;
    }
} else {
    fn live_bytes() u64 { return heap.system_view(); }
}
struct allocation_sample { u64[9] addresses; }
fn cleanup_round(u32 mode, types.node* record_type) allocation_sample {
    ownership_raw_env.env mut e = {};
    ownership_raw_env.open(&e);
    ownership_local_env.add_stack(&e.local, 1);
    types.node* array_type = types.type_array(&e.table, record_type, 4);
    ownership_raw.origin input = ownership_raw_env.origin(&e, 1, array_type,
        ownership_raw.literal(1), ownership_raw.literal(96), false);
    ownership_raw.term[1] mut left_terms = {};
    ownership_raw.term[1] mut right_terms = {};
    ownership_raw.expression left = ownership_raw_env.symbol(10, left_terms[..], 1);
    ownership_raw.expression right = ownership_raw_env.symbol(11, right_terms[..], 1);
    ownership_raw.captured_bound[2] bounds = {
        ownership_raw.captured_bound{left_terms[0].version, ownership_raw.natural(16),
            ownership_raw.natural(16)},
        ownership_raw.captured_bound{right_terms[0].version, ownership_raw.natural(32),
            ownership_raw.natural(32)}};
    ownership_raw.relation[1] relations = {ownership_raw.relation{left, right}};
    ownership_raw.request mut req = ownership_raw_env.request(&e);
    e.root = ownership_raw.capture_origin(&e.local.state, &e.local.service, &input,
        bounds[..], relations[..], &req);
    ownership_raw_env.accepts(&e.root);
    allocation_sample mut sample = {};
    sample.addresses[0] = cast(e.root.storage.origins.ptr, u64);
    sample.addresses[1] = cast(e.root.storage.leaves.ptr, u64);
    sample.addresses[2] = cast(e.root.storage.bounds.ptr, u64);
    sample.addresses[3] = cast(e.root.storage.relations.ptr, u64);
    sample.addresses[4] = cast(e.root.addresses.ptr, u64);
    sample.addresses[5] = cast(e.root.storage.terms, u64);
    sample.addresses[6] = cast(e.root.storage.terms->items.ptr, u64);
    sample.addresses[7] = cast(e.root.storage.paths.blocks, u64);
    sample.addresses[8] = cast(e.root.storage.leaves[0].place.projections.ptr, u64);
    u64 mut i = 0;
    while (i < sample.addresses.len) { assert(sample.addresses[i] != 0); i += 1; }
    ownership_raw.result mut next = {};
    if (mode == 0) {
        types.node* from = types.type_ptr(&e.table, array_type, false, false);
        types.node* to = types.type_voidptr(&e.table, false, false);
        next = ownership_raw_env.cast_value(&e, &e.root, from, to);
        ownership_raw_env.accepts(&next);
        assert(next.storage.origins[0].layout == array_type &&
            next.storage.leaves[0].owning && next.storage.relations.len == 1);
        ownership_raw.free_result(&next);
    } else {
        req = ownership_raw_env.request(&e);
        e.budget.deny_at = e.budget.calls + (mode == 1 ? 1 : 12);
        next = ownership_raw.capture_origin(&e.local.state, &e.local.service, &input,
            bounds[..], relations[..], &req);
        ownership_raw_env.rejects(&next);
    }
    ownership_raw_env.close(&e);
    return sample;
}
fn allocator_probe(u32 mode) void {
    check_env.env mut checked = {};
    check_env.open(&checked);
    defer check_env.close(&checked);
    assert(check_env.check_decls(&checked,
        "struct storage { u8* own left; u8 tag; u8* own right; }"));
    types.node* record_type = check_env.sym_main(&checked, "storage")->ty;
    u64 mut warm = 0;
    while (warm < 64) { cleanup_round(mode, record_type); warm += 1; }
    cleanup_round(mode, record_type);
    u64 live_before = live_bytes();
    u64 system_before = heap.system_view();
    u64 mut best_live = ownership_raw.U64_MAX;
    u64 mut best_system = ownership_raw.U64_MAX;
    u64 mut trial = 0;
    while (trial < 256) {
        cleanup_round(mode, record_type);
        u64 live_distance = heap.distance(live_before, live_bytes());
        u64 system_distance = heap.distance(system_before, heap.system_view());
        if (trial >= 240 && live_distance < best_live) { best_live = live_distance; }
        if (trial >= 240 && system_distance < best_system) { best_system = system_distance; }
        trial += 1;
    }
    // Linux free-bin metadata and allocator caches can change this view below 2048 bytes.
    u64 bound = heap.ADDRESS_IS_A_VIEW ? 2048 : 256;
    if (best_live >= bound) { println("allocator live bytes ", mode, " ", best_live); }
    assert(best_live < bound);
    assert(best_system < (heap.ADDRESS_IS_A_VIEW ? 1 : 256));
}
fn successful_allocator_teardown() void {
    allocator_probe(0);
    println("successful result allocator teardown");
}
fn early_allocator_teardown() void {
    allocator_probe(1);
    println("early failure allocator teardown");
}
fn late_allocator_teardown() void {
    allocator_probe(2);
    println("late failure allocator teardown");
}

fn main() i32 {
    extent_product_overflow();
    endpoint_add_overflow();
    wrapped_endpoint_is_not_extent();
    released_heap_source();
    ended_stack_source();
    mixed_live_and_ended_sources();
    zero_allocation_inspection();
    zero_allocation_element();
    zero_allocation_move();
    zero_allocation_release();
    zero_allocation_lost_owner();
    existing_foreign_trust();
    cast_cannot_create_trust();
    known_released_foreign_allocation();
    missing_event_map();
    malformed_source_key();
    unresolved_layout();
    required_residual_fact();
    denied_charge_preserves_input();
    additional_input_guards();
    unproved_reference_cast();
    range_operand_work();
    subobject_operand_work();
    accepted_depth_boundary();
    first_depth_rejection();
    preliminary_size_work();
    retained_projection_work();
    array_projection_work();
    field_projection_work();
    sizing_array_overflow();
    successful_allocator_teardown();
    early_allocator_teardown();
    late_allocator_teardown();
    return 0;
}
