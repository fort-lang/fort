fn sizing_array_overflow() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.open(&e);
    ownership_raw.request mut req = ownership_raw_env.request(&e);
    types.node* large = types.type_array(&e.table, e.byte, types.TYPE_MAX_SIZE);
    types.node* overflow = types.type_array(&e.table, large, 2);
    types.node* nested_overflow = types.type_array(&e.table, overflow, 1);
    u64 mut bytes = 999;
    ownership_raw_env.rejected(ownership_raw.size(overflow, &e.local.service, &req, &bytes));
    assert(bytes == 999);
    ownership_raw_env.rejected(ownership_raw.size(nested_overflow, &e.local.service, &req, &bytes));
    assert(bytes == 999);
    ownership_raw_env.accepted(ownership_raw.size(large, &e.local.service, &req, &bytes));
    assert(bytes == types.TYPE_MAX_SIZE);
    println("checked array sizing preserves overflow refusal");
}

// These probes measure allocator state separately from abstract input equality.
$if ($cfg(target_os) == "linux") {
    extern fn open_memstream(char mut* own mut* buffer, u64 mut* length) void mut*;
    extern fn malloc_info(i32 options, void mut* stream) i32;
    extern fn fclose(void mut* stream) i32;
    fn metric(string data, string prefix) u64 {
        i64 mut found = str.find(data, prefix);
        assert(found >= 0);
        string mut tail = data[cast(found, u64)..];
        while (true) {
            found = str.find(tail[prefix.len..], prefix);
            if (found < 0) { break; }
            tail = tail[prefix.len + cast(found, u64)..];
        }
        found = str.find(tail, "size=\"");
        assert(found >= 0);
        tail = tail[cast(found, u64) + 6..];
        found = str.index_of(tail, '\"');
        assert(found >= 0);
        u64 mut value = 0;
        assert(str.parse_u64(tail[..cast(found, u64)], 10, &value));
        return value;
    }
    fn live_bytes() u64 {
        char mut* own mut buffer = null;
        u64 mut length = 0;
        void mut* stream = open_memstream(&buffer, &length);
        assert(stream != null && malloc_info(0, stream) == 0 && fclose(stream) == 0);
        string data = cast(buffer[0..length], string);
        u64 arena = metric(data, "<system type=\"current\"");
        u64 fast = metric(data, "<total type=\"fast\"");
        u64 rest = metric(data, "<total type=\"rest\"");
        u64 mapped = metric(data, "<total type=\"mmap\"");
        libc.free(cast(move(buffer), void* own));
        assert(arena >= fast && arena - fast >= rest);
        return arena - fast - rest + mapped;
    }
} else {
    fn live_bytes() u64 { return heap.system_view(); }
}
struct allocation_sample { u64[9] addresses; }
fn range_validation_work() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.zero_bound_heap(&e);
    ownership_raw.term[128] mut terms = {};
    ownership_raw.expression lower = ownership_raw_env.zero_terms(terms[..]);
    ownership_raw.request mut req = ownership_raw_env.request(&e);
    e.budget.meter.bounds.w = 300000;
    req.limits.w = e.budget.meter.bounds.w;
    ownership_raw.result mut value = ownership_raw.slice_ptr(&e.root.storage, &e.local.service,
        e.root.addresses[..], lower, lower, e.byte, &req);
    ownership_raw_env.accepts(&value);
    ownership_raw.free_result(&value);
    println("unit-a accept range_validation_slice");
    value = ownership_raw.derive_address(&e.root.storage, &e.local.service,
        e.root.addresses[..], lower, lower, e.byte, &req);
    ownership_raw_env.accepts(&value);
    ownership_raw.free_result(&value);
    println("unit-a accept range_validation_derive");
    terms[127].coefficient.valid = false;
    ownership_raw_env.remaining_work(&e, 25);
    value = ownership_raw.slice_ptr(&e.root.storage, &e.local.service,
        e.root.addresses[..], lower, lower, e.byte, &req);
    ownership_raw_env.work_failure(&e, value.proof, &req);
    ownership_raw_env.rejects(&value);
    println("unit-a reject range_validation_slice");
    ownership_raw_env.remaining_work(&e, 25);
    value = ownership_raw.derive_address(&e.root.storage, &e.local.service,
        e.root.addresses[..], lower, lower, e.byte, &req);
    ownership_raw_env.work_failure(&e, value.proof, &req);
    ownership_raw_env.rejects(&value);
    assert(!terms[127].coefficient.valid && e.root.addresses.len == 1);
    println("unit-a reject range_validation_derive");
}
fn address_validation_work() void {
    ownership_raw_env.env mut e = {};
    defer ownership_raw_env.close(&e);
    ownership_raw_env.zero_bound_heap(&e);
    ownership_raw.term[128] mut terms = {};
    ownership_raw.address[1] mut values = {e.root.addresses[0]};
    values[0].offset = ownership_raw_env.zero_terms(terms[..]);
    ownership_raw.request mut req = ownership_raw_env.request(&e);
    e.budget.meter.bounds.w = 300000;
    req.limits.w = e.budget.meter.bounds.w;
