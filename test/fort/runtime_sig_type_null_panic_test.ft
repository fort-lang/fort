//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: runtime_sig.rt_signature_of_type: not a function type
//! stdout:
//| true
/// rt_signature_of_type reads the type of a function that std.rt declares. A type that is
/// not a function type breaks that precondition, so the call panics.
import runtime_sig;
import types_env;

fn main() i32 {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    println(types_env.type_of(&e, "i32") != null);
    runtime_sig.rt_signature_of_type("std.rt.x", types_env.type_of(&e, "i32"));
    return 0;
}
