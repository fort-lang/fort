//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: gen_stmt.gen_break: break or continue outside a loop or switch
//! stdout:
//| inside
import ast;
import check_env;
import gen_env;
import gen_stmt;

// `break` targets the innermost enclosing loop or `switch` and `continue` the
// innermost enclosing loop alone. The checker refused a `break` with neither
// construct around it and a `continue` outside every loop, so a target is always
// set by the time the emitter sees one: reaching it with none is a broken
// precondition and not a program the emitter refuses, so it panics at the call
// that broke it, where src/bootstrap/gen_stmt.c calls fatal_internal.
// D7.5, D7.6, D13.3
//
// A panic ends the program, so the case stands in a file of its own.
// D11.4
fn i32 main() {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    assert(gen_env.open_body(&e, "    while (true) {\n        break;\n    }"));
    ast.node* loop = check_env.node_in_main(&e.c, ast.ast_kind.k_while, "");
    ast.node* jump = check_env.node_in_main(&e.c, ast.ast_kind.k_break, "");
    assert(loop != null && jump != null);
    // Inside the loop the target is set, and the `break` is the branch the
    // loop's continuation takes.
    gen_env.begin(&e);
    gen_stmt.gen_stmt(&e.g, loop);
    println("inside");
    // On its own it has none, because nothing opened a loop or a switch
    // around it.
    gen_env.begin(&e);
    gen_stmt.gen_stmt(&e.g, jump);
    return 0;
}
