//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| worked example ok
//| exits ok
//| floor ok
//| markers ok
//| scopes ok
//| growth ok
/// Checks the lowering of `defer` and of the scope markers (spec/fir.md 9.5, 9.7): each exit and
/// each fall-off lowers the deferred statements of the scopes that it leaves, the last one first,
/// then a `dead` for each named local of those scopes. Each case lowers one function of a checked
/// source, holds that the result keeps every rule of the verifier, and compares its text.
import lower_env;
import std.strbuf;

// ---- the worked example -----------------------------------------------------------------------

// The program of spec/fir.md 13 lowers to the text of that section, byte for byte: the zeroing of
// the entry block, the overwrite check of the declaration, one expansion of `del(p)` on each path
// to an exit with the location of that exit, and the indices of 9.7. The text of the section
// writes the comment `// the value of new(i32)` after the `let` of `_3`, which the printer does
// not write.
fn the_worked_example_lowers_byte_for_byte() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[9] source = {
        "fn f(bool c) i32 {",
        "    i32 mut* own p = new(i32);",
        "    defer del(p);",
        "    if (c) {",
        "        return 1;",
        "    }",
        "    *p = 7;",
        "    return *p;",
        "}",
    };
    string[29] want = {
        "fn main.f(_1 (c): bool) -> i32 {",
        "    let _0: i32;",
        "    let _2 (p): i32 mut* own #2:18;",
        "    let _3: i32 mut* own #2:22;",
        "",
        "    bb0: {",
        "        _2 = const zero i32 mut* own #2:18 s0;",
        "        live(_2) #2:18 s1;",
        "        _3 = alloc<i32>(const u64 1) #2:22 s1;",
        "        check(overwrite: _2) -> bb1 #2:18 s1;",
        "    }",
        "    bb1: {",
        "        _2 = move _3 #2:18 s1;",
        "        switch(copy _1) -> [true: bb2, otherwise: bb3] #4:5 s3;",
        "    }",
        "    bb2: {",
        "        _0 = const i32 1 #5:16 s4;",
        "        del(move _2) #3:11 exit 5:9 s5;",
        "        dead(_2) #5:9 s4;",
        "        return #5:9 s4;",
        "    }",
        "    bb3: {",
        "        (*_2) = const i32 7 #7:8 s6;",
        "        _0 = copy (*_2) #8:12 s7;",
        "        del(move _2) #3:11 exit 8:5 s8;",
        "        dead(_2) #8:5 s7;",
        "        return #8:5 s7;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "f"), want[..]);
}

// ---- exits ------------------------------------------------------------------------------------

// `defer { a(); b(); }` with two exits: each exit lowers the block again, so four calls stand in
// the function, and each takes a new index at its expansion (spec/fir.md 9.7). The `defer`
// itself takes `s1` and emits nothing.
fn a_deferred_block_expands_at_each_exit_with_new_indices() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[11] source = {
        "fn a() void {",
        "}",
        "fn b() void {",
        "}",
        "fn f(bool c) i32 {",
        "    defer { a(); b(); }",
        "    if (c) {",
        "        return 1;",
        "    }",
        "    return 2;",
        "}",
    };
    string[23] want = {
        "fn main.f(_1 (c): bool) -> i32 {",
        "    let _0: i32;",
        "    let _2: void #6:14;",
        "    let _3: void #6:19;",
        "    let _4: void #6:14;",
        "    let _5: void #6:19;",
        "",
        "    bb0: {",
        "        switch(copy _1) -> [true: bb1, otherwise: bb2] #7:5 s2;",
        "    }",
        "    bb1: {",
        "        _0 = const i32 1 #8:16 s3;",
        "        _2 = call fn main.a() #6:14 exit 8:9 s4;",
        "        _3 = call fn main.b() #6:19 exit 8:9 s5;",
        "        return #8:9 s3;",
        "    }",
        "    bb2: {",
        "        _0 = const i32 2 #10:12 s6;",
        "        _4 = call fn main.a() #6:14 exit 10:5 s7;",
        "        _5 = call fn main.b() #6:19 exit 10:5 s8;",
        "        return #10:5 s6;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "f"), want[..]);
}

// A `defer` inside a loop expands at the `break`, at the `continue` and at the fall-off of the
// body, whose expansion stands at the closing brace of the body. The `return` after the loop
// expands nothing, because the scope of the loop closed with its deferred statement (D7.8).
fn a_deferred_statement_in_a_loop_expands_at_the_exits_of_the_loop() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[14] source = {
        "fn a() void {",
        "}",
        "fn f(bool c, bool d) i32 {",
        "    while (c) {",
        "        defer a();",
        "        if (d) {",
        "            break;",
        "        }",
        "        if (c) {",
        "            continue;",
        "        }",
        "    }",
        "    return 0;",
        "}",
    };
    string[35] want = {
        "fn main.f(_1 (c): bool, _2 (d): bool) -> i32 {",
        "    let _0: i32;",
        "    let _3: void #5:16;",
        "    let _4: void #5:16;",
        "    let _5: void #5:16;",
        "",
        "    bb0: {",
        "        goto bb1 #4:5 s1;",
        "    }",
        "    bb1: {",
        "        switch(copy _1) -> [true: bb2, otherwise: bb3] #4:5 s1;",
        "    }",
        "    bb2: {",
        "        switch(copy _2) -> [true: bb4, otherwise: bb5] #6:9 s3;",
        "    }",
        "    bb3: {",
        "        _0 = const i32 0 #13:12 s10;",
        "        return #13:5 s10;",
        "    }",
        "    bb4: {",
        "        _3 = call fn main.a() #5:16 exit 7:13 s5;",
        "        goto bb3 #7:13 s4;",
        "    }",
        "    bb5: {",
        "        switch(copy _1) -> [true: bb6, otherwise: bb7] #9:9 s6;",
        "    }",
        "    bb6: {",
        "        _4 = call fn main.a() #5:16 exit 10:13 s8;",
        "        goto bb1 #10:13 s7;",
        "    }",
        "    bb7: {",
        "        _5 = call fn main.a() #5:16 exit 12:5 s9;",
        "        goto bb1 #4:5 s1;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "f"), want[..]);
}

// A `defer` in a clause belongs to the scope of kind `case`: a `break` expands it and leaves the
// `switch`, a `continue` expands it and walks on to the loop around the `switch` (D7.6), and the
// fall-off of the clause expands it before `goto` done. The `default` clause is a scope of its own
// and expands nothing.
fn a_deferred_statement_in_a_clause_expands_at_its_exits() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[18] source = {
        "fn a() void {",
        "}",
        "fn f(i32 n, bool c) void {",
        "    while (c) {",
        "        switch (n) {",
        "        case 1:",
        "            defer a();",
        "            if (c) {",
        "                break;",
        "            }",
        "            if (c) {",
        "                continue;",
        "            }",
        "        default:",
        "            break;",
        "        }",
        "    }",
        "}",
    };
    string[43] want = {
        "fn main.f(_1 (n): i32, _2 (c): bool) -> void {",
        "    let _0: void;",
        "    let _3: void #7:20;",
        "    let _4: void #7:20;",
        "    let _5: void #7:20;",
        "",
        "    bb0: {",
        "        goto bb1 #4:5 s1;",
        "    }",
        "    bb1: {",
        "        switch(copy _2) -> [true: bb2, otherwise: bb3] #4:5 s1;",
        "    }",
        "    bb2: {",
        "        switch(copy _1) -> [i32 1: bb4, otherwise: bb5] #5:9 s2;",
        "    }",
        "    bb3: {",
        "        return #18:1 s0;",
        "    }",
        "    bb4: {",
        "        switch(copy _2) -> [true: bb7, otherwise: bb8] #8:13 s4;",
        "    }",
        "    bb5: {",
        "        goto bb6 #15:13 s11;",
        "    }",
        "    bb6: {",
        "        goto bb1 #4:5 s1;",
        "    }",
        "    bb7: {",
        "        _3 = call fn main.a() #7:20 exit 9:17 s6;",
        "        goto bb6 #9:17 s5;",
        "    }",
        "    bb8: {",
        "        switch(copy _2) -> [true: bb9, otherwise: bb10] #11:13 s7;",
        "    }",
        "    bb9: {",
        "        _4 = call fn main.a() #7:20 exit 12:17 s9;",
        "        goto bb1 #12:17 s8;",
        "    }",
        "    bb10: {",
        "        _5 = call fn main.a() #7:20 exit 13:13 s10;",
        "        goto bb6 #5:9 s2;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "f"), want[..]);
}

// A deferred statement that ends its block, a call of a `noreturn` function, stops the expansion
// (spec/fir.md 9.5): the deferred statement before it, the `dead` markers and the `return` do not
// follow its `trap`.
fn a_deferred_call_that_does_not_return_stops_the_expansion() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[12] source = {
        "fn stop() noreturn {",
        "    while (true) {",
        "    }",
        "}",
        "fn a() void {",
        "}",
        "fn f() i32 {",
        "    defer a();",
        "    defer stop();",
        "    i32 x = 1;",
        "    return x;",
        "}",
    };
    string[13] want = {
        "fn main.f() -> i32 {",
        "    let _0: i32;",
        "    let _1 (x): i32 #10:9;",
        "    let _2: void #9:15;",
        "",
        "    bb0: {",
        "        live(_1) #10:9 s3;",
        "        _1 = const i32 1 #10:13 s3;",
        "        _0 = copy _1 #11:12 s4;",
        "        _2 = call fn main.stop() #9:15 exit 11:5 s5;",
        "        trap #9:15 exit 11:5 s5;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "f"), want[..]);
}

// Two nested scopes, each with a local and a `defer`, left by a `break` and by a `return`. Each
// exit leaves the inner scope first: its deferred statement, then its `dead`, and only then the
// deferred statement and the `dead` of the outer scope (D7.8, spec/fir.md 9.5).
fn nested_scopes_unwind_inner_first_each_with_its_markers() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[17] source = {
        "fn a(i32 v) void {",
        "}",
        "fn f(bool c) i32 {",
        "    while (c) {",
        "        i32 x = 1;",
        "        defer a(x);",
        "        {",
        "            i32 y = 2;",
        "            defer a(y);",
        "            if (c) {",
        "                break;",
        "            }",
        "            return y;",
        "        }",
        "    }",
        "    return 0;",
        "}",
    };
    string[42] want = {
        "fn main.f(_1 (c): bool) -> i32 {",
        "    let _0: i32;",
        "    let _2 (x): i32 #5:13;",
        "    let _3 (y): i32 #8:17;",
        "    let _4: void #9:20;",
        "    let _5: void #6:16;",
        "    let _6: void #9:20;",
        "    let _7: void #6:16;",
        "",
        "    bb0: {",
        "        goto bb1 #4:5 s1;",
        "    }",
        "    bb1: {",
        "        switch(copy _1) -> [true: bb2, otherwise: bb3] #4:5 s1;",
        "    }",
        "    bb2: {",
        "        live(_2) #5:13 s2;",
        "        _2 = const i32 1 #5:17 s2;",
        "        live(_3) #8:17 s4;",
        "        _3 = const i32 2 #8:21 s4;",
        "        switch(copy _1) -> [true: bb4, otherwise: bb5] #10:13 s6;",
        "    }",
        "    bb3: {",
        "        _0 = const i32 0 #16:12 s13;",
        "        return #16:5 s13;",
        "    }",
        "    bb4: {",
        "        _4 = call fn main.a(copy _3) #9:20 exit 11:17 s8;",
        "        dead(_3) #11:17 s7;",
        "        _5 = call fn main.a(copy _2) #6:16 exit 11:17 s9;",
        "        dead(_2) #11:17 s7;",
        "        goto bb3 #11:17 s7;",
        "    }",
        "    bb5: {",
        "        _0 = copy _3 #13:20 s10;",
        "        _6 = call fn main.a(copy _3) #9:20 exit 13:13 s11;",
        "        dead(_3) #13:13 s10;",
        "        _7 = call fn main.a(copy _2) #6:16 exit 13:13 s12;",
        "        dead(_2) #13:13 s10;",
        "        return #13:13 s10;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "f"), want[..]);
}

// A `defer` in the body of a range `for` expands at the `continue` and at the fall-off of the body,
// each time before the `dead` of the variable, since the body of a range `for` is a scope of kind
// `loop` of its own.
fn a_deferred_statement_in_a_range_for_expands_before_the_variable_ends() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[10] source = {
        "fn a(i32 v) void {",
        "}",
        "fn f(i32[2] v, bool c) void {",
        "    for (i32 x : v) {",
        "        defer a(x);",
        "        if (c) {",
        "            continue;",
        "        }",
        "    }",
        "}",
    };
    string[41] want = {
        "fn main.f(_1 (v): i32[2], _2 (c): bool) -> void {",
        "    let _0: void;",
        "    let _3 (x): i32 #4:14;",
        "    let _4: i32[2] #4:18;",
        "    let _5: u64 #4:5;",
        "    let _6: bool #4:5;",
        "    let _7: void #5:16;",
        "    let _8: void #5:16;",
        "",
        "    bb0: {",
        "        _4 = copy _1 #4:18 s1;",
        "        _5 = const u64 0 #4:5 s1;",
        "        goto bb1 #4:5 s1;",
        "    }",
        "    bb1: {",
        "        _6 = lt(copy _5, const u64 2) #4:5 s1;",
        "        switch(copy _6) -> [true: bb2, otherwise: bb4] #4:5 s1;",
        "    }",
        "    bb2: {",
        "        live(_3) #4:14 s1;",
        "        _3 = copy _4[_5] #4:18 s1;",
        "        switch(copy _2) -> [true: bb5, otherwise: bb6] #6:9 s3;",
        "    }",
        "    bb3: {",
        "        _5 = add(copy _5, const u64 1) #4:5 s1;",
        "        goto bb1 #4:5 s1;",
        "    }",
        "    bb4: {",
        "        return #10:1 s0;",
        "    }",
        "    bb5: {",
        "        _7 = call fn main.a(copy _3) #5:16 exit 7:13 s5;",
        "        dead(_3) #7:13 s4;",
        "        goto bb3 #7:13 s4;",
        "    }",
        "    bb6: {",
        "        _8 = call fn main.a(copy _3) #5:16 exit 9:5 s6;",
        "        dead(_3) #9:5 s1;",
        "        goto bb3 #4:5 s1;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "f"), want[..]);
}

// A deferred call that does not return ends the path of a `break` and of a fall-off as well: the
// `break` writes no `goto`, and the fall-off of the block writes no `dead(_2)` for its local `y`
// after the `trap`.
fn a_deferred_call_that_does_not_return_ends_a_break_and_a_fall_off() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[14] source = {
        "fn stop() noreturn {",
        "    while (true) {",
        "    }",
        "}",
        "fn f(bool c) void {",
        "    while (c) {",
        "        defer stop();",
        "        break;",
        "    }",
        "    {",
        "        i32 y = 1;",
        "        defer stop();",
        "    }",
        "}",
    };
    string[23] want = {
        "fn main.f(_1 (c): bool) -> void {",
        "    let _0: void;",
        "    let _2 (y): i32 #11:13;",
        "    let _3: void #7:19;",
        "    let _4: void #12:19;",
        "",
        "    bb0: {",
        "        goto bb1 #6:5 s1;",
        "    }",
        "    bb1: {",
        "        switch(copy _1) -> [true: bb2, otherwise: bb3] #6:5 s1;",
        "    }",
        "    bb2: {",
        "        _3 = call fn main.stop() #7:19 exit 8:9 s4;",
        "        trap #7:19 exit 8:9 s4;",
        "    }",
        "    bb3: {",
        "        live(_2) #11:13 s5;",
        "        _2 = const i32 1 #11:17 s5;",
        "        _4 = call fn main.stop() #12:19 exit 13:5 s7;",
        "        trap #12:19 exit 13:5 s7;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "f"), want[..]);
}

// ---- the floor --------------------------------------------------------------------------------

// A `break` inside deferred code binds to the loop written inside it (D7.8). The expansion raises
// the floor to the depth of the stack, so the walk of that `break` stops at the loop inside the
// deferred block and never reaches the scopes of the `if` and of the body. The deferred block
// expands at the `return` and again at the fall-off of the body, each time with new blocks and
// new indices.
fn a_break_inside_deferred_code_leaves_the_loop_inside_it() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[13] source = {
        "fn a() void {",
        "}",
        "fn f(bool c) void {",
        "    defer {",
        "        while (true) {",
        "            break;",
        "        }",
        "        a();",
        "    }",
        "    if (c) {",
        "        return;",
        "    }",
        "}",
    };
    string[35] want = {
        "fn main.f(_1 (c): bool) -> void {",
        "    let _0: void;",
        "    let _2: void #8:10;",
        "    let _3: void #8:10;",
        "",
        "    bb0: {",
        "        switch(copy _1) -> [true: bb1, otherwise: bb2] #10:5 s2;",
        "    }",
        "    bb1: {",
        "        goto bb3 #5:9 exit 11:9 s4;",
        "    }",
        "    bb2: {",
        "        goto bb6 #5:9 exit 13:1 s7;",
        "    }",
        "    bb3: {",
        "        switch(const true) -> [true: bb4, otherwise: bb5] #5:9 exit 11:9 s4;",
        "    }",
        "    bb4: {",
        "        goto bb5 #6:13 exit 11:9 s5;",
        "    }",
        "    bb5: {",
        "        _2 = call fn main.a() #8:10 exit 11:9 s6;",
        "        return #11:9 s3;",
        "    }",
        "    bb6: {",
        "        switch(const true) -> [true: bb7, otherwise: bb8] #5:9 exit 13:1 s7;",
        "    }",
        "    bb7: {",
        "        goto bb8 #6:13 exit 13:1 s8;",
        "    }",
        "    bb8: {",
        "        _3 = call fn main.a() #8:10 exit 13:1 s9;",
        "        return #13:1 s0;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "f"), want[..]);
}

// A `continue` and a `break` in the clauses of a `switch` inside a loop inside deferred code. The
// `continue` walks past the scope of kind `case` to the loop, and the `break` stops at the clause;
// both stay above the floor, and each carries the exit of the expansion, the end of the body.
fn clause_exits_inside_deferred_code_stay_inside_it() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[12] source = {
        "fn f(i32 n, bool c) void {",
        "    defer {",
        "        while (c) {",
        "            switch (n) {",
        "            case 1:",
        "                continue;",
        "            default:",
        "                break;",
        "            }",
        "        }",
        "    }",
        "}",
    };
    string[25] want = {
        "fn main.f(_1 (n): i32, _2 (c): bool) -> void {",
        "    let _0: void;",
        "",
        "    bb0: {",
        "        goto bb1 #3:9 exit 12:1 s2;",
        "    }",
        "    bb1: {",
        "        switch(copy _2) -> [true: bb2, otherwise: bb3] #3:9 exit 12:1 s2;",
        "    }",
        "    bb2: {",
        "        switch(copy _1) -> [i32 1: bb4, otherwise: bb5] #4:13 exit 12:1 s3;",
        "    }",
        "    bb3: {",
        "        return #12:1 s0;",
        "    }",
        "    bb4: {",
        "        goto bb1 #6:17 exit 12:1 s4;",
        "    }",
        "    bb5: {",
        "        goto bb6 #8:17 exit 12:1 s5;",
        "    }",
        "    bb6: {",
        "        goto bb1 #3:9 exit 12:1 s2;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "f"), want[..]);
}

// A deferred block with a named local and a `defer` of its own: each expansion writes `live` and
// `dead` for the one local that the prescan numbered, and the fall-off of the deferred block
// expands the inner `defer` with the closing brace of that block as its exit. The `dead` of the
// local takes the index of the exit that expands the block (spec/fir.md 9.7): `s3` at the
// `return` and 0 at the end of the body.
fn a_deferred_block_ends_its_own_local_and_expands_its_own_defer() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[12] source = {
        "fn a(i32 v) void {",
        "}",
        "fn f(bool c) void {",
        "    defer {",
        "        i32 t = 1;",
        "        defer a(t);",
        "        a(2);",
        "    }",
        "    if (c) {",
        "        return;",
        "    }",
        "}",
    };
    string[28] want = {
        "fn main.f(_1 (c): bool) -> void {",
        "    let _0: void;",
        "    let _2 (t): i32 #5:13;",
        "    let _3: void #7:10;",
        "    let _4: void #6:16;",
        "    let _5: void #7:10;",
        "    let _6: void #6:16;",
        "",
        "    bb0: {",
        "        switch(copy _1) -> [true: bb1, otherwise: bb2] #9:5 s2;",
        "    }",
        "    bb1: {",
        "        live(_2) #5:13 exit 10:9 s4;",
        "        _2 = const i32 1 #5:17 exit 10:9 s4;",
        "        _3 = call fn main.a(const i32 2) #7:10 exit 10:9 s6;",
        "        _4 = call fn main.a(copy _2) #6:16 exit 8:5 s7;",
        "        dead(_2) #8:5 exit 10:9 s3;",
        "        return #10:9 s3;",
        "    }",
        "    bb2: {",
        "        live(_2) #5:13 exit 12:1 s8;",
        "        _2 = const i32 1 #5:17 exit 12:1 s8;",
        "        _5 = call fn main.a(const i32 2) #7:10 exit 12:1 s10;",
        "        _6 = call fn main.a(copy _2) #6:16 exit 8:5 s11;",
        "        dead(_2) #8:5 exit 12:1 s0;",
        "        return #12:1 s0;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "f"), want[..]);
}

// ---- markers ----------------------------------------------------------------------------------

// A local of a nested block ends at the closing brace of that block (spec/fir.md 7): an `if`
// arm, an `else` arm, a block inside an arm, a bare block in the body and a `$if` branch. The
// marker takes the index of the node around the block: the `if` for its arms and for a block
// inside them, and 0 for a bare block and a `$if` branch directly in the body (9.7). The locals
// of the body end at the `return`.
fn a_local_of_a_nested_block_ends_at_the_end_of_that_block() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[18] source = {
        "fn f(bool c) i32 {",
        "    i32 a = 1;",
        "    if (c) {",
        "        i32 b = 2;",
        "        {",
        "            i32 d = b;",
        "        }",
        "    } else {",
        "        i32 e = a;",
        "    }",
        "    {",
        "        i32 g = a;",
        "    }",
        "    $if (true) {",
        "        i32 h = a;",
        "    }",
        "    return a;",
        "}",
    };
    string[41] want = {
        "fn main.f(_1 (c): bool) -> i32 {",
        "    let _0: i32;",
        "    let _2 (a): i32 #2:9;",
        "    let _3 (b): i32 #4:13;",
        "    let _4 (d): i32 #6:17;",
        "    let _5 (e): i32 #9:13;",
        "    let _6 (g): i32 #12:13;",
        "    let _7 (h): i32 #15:13;",
        "",
        "    bb0: {",
        "        live(_2) #2:9 s1;",
        "        _2 = const i32 1 #2:13 s1;",
        "        switch(copy _1) -> [true: bb1, otherwise: bb2] #3:5 s2;",
        "    }",
        "    bb1: {",
        "        live(_3) #4:13 s3;",
        "        _3 = const i32 2 #4:17 s3;",
        "        live(_4) #6:17 s4;",
        "        _4 = copy _3 #6:21 s4;",
        "        dead(_4) #7:9 s2;",
        "        dead(_3) #8:5 s2;",
        "        goto bb3 #3:5 s2;",
        "    }",
        "    bb2: {",
        "        live(_5) #9:13 s5;",
        "        _5 = copy _2 #9:17 s5;",
        "        dead(_5) #10:5 s2;",
        "        goto bb3 #3:5 s2;",
        "    }",
        "    bb3: {",
        "        live(_6) #12:13 s6;",
        "        _6 = copy _2 #12:17 s6;",
        "        dead(_6) #13:5 s0;",
        "        live(_7) #15:13 s7;",
        "        _7 = copy _2 #15:17 s7;",
        "        dead(_7) #16:5 s0;",
        "        _0 = copy _2 #17:12 s8;",
        "        dead(_2) #17:5 s8;",
        "        return #17:5 s8;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "f"), want[..]);
}

// An exit ends the locals declared before it and no local declared after it, since the scope of a
// local starts after its declaration (D7.9). The `dead` markers of one scope follow the order of
// the declarations.
fn an_exit_ends_the_locals_declared_before_it() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[8] source = {
        "fn f(bool c) i32 {",
        "    i32 a = 1;",
        "    if (c) {",
        "        return a;",
        "    }",
        "    i32 b = 2;",
        "    return b;",
        "}",
    };
    string[24] want = {
        "fn main.f(_1 (c): bool) -> i32 {",
        "    let _0: i32;",
        "    let _2 (a): i32 #2:9;",
        "    let _3 (b): i32 #6:9;",
        "",
        "    bb0: {",
        "        live(_2) #2:9 s1;",
        "        _2 = const i32 1 #2:13 s1;",
        "        switch(copy _1) -> [true: bb1, otherwise: bb2] #3:5 s2;",
        "    }",
        "    bb1: {",
        "        _0 = copy _2 #4:16 s3;",
        "        dead(_2) #4:9 s3;",
        "        return #4:9 s3;",
        "    }",
        "    bb2: {",
        "        live(_3) #6:9 s4;",
        "        _3 = const i32 2 #6:13 s4;",
        "        _0 = copy _3 #7:12 s5;",
        "        dead(_2) #7:5 s5;",
        "        dead(_3) #7:5 s5;",
        "        return #7:5 s5;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "f"), want[..]);
}

// A local of the body of a `do` ends at each exit of the body: the `continue` ends it before it
// goes to test, and the fall-off ends it at the closing brace of the body with the index of the
// `do`.
fn a_local_of_a_do_body_ends_before_the_test() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[8] source = {
        "fn f(bool c) void {",
        "    do {",
        "        i32 k = 1;",
        "        if (c) {",
        "            continue;",
        "        }",
        "    } while (c);",
        "}",
    };
    string[27] want = {
        "fn main.f(_1 (c): bool) -> void {",
        "    let _0: void;",
        "    let _2 (k): i32 #3:13;",
        "",
        "    bb0: {",
        "        goto bb1 #2:5 s1;",
        "    }",
        "    bb1: {",
        "        live(_2) #3:13 s2;",
        "        _2 = const i32 1 #3:17 s2;",
        "        switch(copy _1) -> [true: bb4, otherwise: bb5] #4:9 s3;",
        "    }",
        "    bb2: {",
        "        switch(copy _1) -> [true: bb1, otherwise: bb3] #2:5 s1;",
        "    }",
        "    bb3: {",
        "        return #8:1 s0;",
        "    }",
        "    bb4: {",
        "        dead(_2) #5:13 s4;",
        "        goto bb2 #5:13 s4;",
        "    }",
        "    bb5: {",
        "        dead(_2) #7:5 s1;",
        "        goto bb2 #2:5 s1;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "f"), want[..]);
}

// ---- the scopes of a `for` --------------------------------------------------------------------

// The local that the init of a `for` declares lives once for the whole loop: it belongs to a
// scope of kind `block` around the loop, so a `return` in the body ends it and the end of the
// loop ends it in done, at the closing brace of the body with the index of the `for`. The
// variable of a range `for` lives once for each iteration: it belongs to the scope of the body,
// so the `break`, the `continue` and the fall-off of the body each end it.
fn the_locals_of_a_for_end_where_their_loop_leaves_them() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[16] source = {
        "fn f(i32[2] v, bool c) i32 {",
        "    for (i32 mut i = 0; c; i = 1) {",
        "        if (c) {",
        "            return i;",
        "        }",
        "    }",
        "    for (i32 x : v) {",
        "        if (c) {",
        "            break;",
        "        }",
        "        if (c) {",
        "            continue;",
        "        }",
        "    }",
        "    return 0;",
        "}",
    };
    string[70] want = {
        "fn main.f(_1 (v): i32[2], _2 (c): bool) -> i32 {",
        "    let _0: i32;",
        "    let _3 (i): i32 #2:18;",
        "    let _4 (x): i32 #7:14;",
        "    let _5: i32[2] #7:18;",
        "    let _6: u64 #7:5;",
        "    let _7: bool #7:5;",
        "",
        "    bb0: {",
        "        live(_3) #2:18 s2;",
        "        _3 = const i32 0 #2:22 s2;",
        "        goto bb1 #2:5 s1;",
        "    }",
        "    bb1: {",
        "        switch(copy _2) -> [true: bb2, otherwise: bb4] #2:5 s1;",
        "    }",
        "    bb2: {",
        "        switch(copy _2) -> [true: bb5, otherwise: bb6] #3:9 s3;",
        "    }",
        "    bb3: {",
        "        _3 = const i32 1 #2:30 s5;",
        "        goto bb1 #2:5 s1;",
        "    }",
        "    bb4: {",
        "        dead(_3) #6:5 s1;",
        "        _5 = copy _1 #7:18 s6;",
        "        _6 = const u64 0 #7:5 s6;",
        "        goto bb7 #7:5 s6;",
        "    }",
        "    bb5: {",
        "        _0 = copy _3 #4:20 s4;",
        "        dead(_3) #4:13 s4;",
        "        return #4:13 s4;",
        "    }",
        "    bb6: {",
        "        goto bb3 #2:5 s1;",
        "    }",
        "    bb7: {",
        "        _7 = lt(copy _6, const u64 2) #7:5 s6;",
        "        switch(copy _7) -> [true: bb8, otherwise: bb10] #7:5 s6;",
        "    }",
        "    bb8: {",
        "        live(_4) #7:14 s6;",
        "        _4 = copy _5[_6] #7:18 s6;",
        "        switch(copy _2) -> [true: bb11, otherwise: bb12] #8:9 s7;",
        "    }",
        "    bb9: {",
        "        _6 = add(copy _6, const u64 1) #7:5 s6;",
        "        goto bb7 #7:5 s6;",
        "    }",
        "    bb10: {",
        "        _0 = const i32 0 #15:12 s11;",
        "        return #15:5 s11;",
        "    }",
        "    bb11: {",
        "        dead(_4) #9:13 s8;",
        "        goto bb10 #9:13 s8;",
        "    }",
        "    bb12: {",
        "        switch(copy _2) -> [true: bb13, otherwise: bb14] #11:9 s9;",
        "    }",
        "    bb13: {",
        "        dead(_4) #12:13 s10;",
        "        goto bb9 #12:13 s10;",
        "    }",
        "    bb14: {",
        "        dead(_4) #14:5 s6;",
        "        goto bb9 #7:5 s6;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "f"), want[..]);
}

// ---- growth -----------------------------------------------------------------------------------

// The count of the locals and of the deferred statements of `w`: one more than the 16 slots of
// the first capacity of a vector, so that the vector of the named locals grows once and copies
// the 16 that it holds.
u64 WIDE = 17;

// Appends `text` and a newline to `b`.
fn line(strbuf.str_buf mut* b, string text) void {
    strbuf.append(b, text);
    strbuf.push(b, '\n');
}

// Appends `n` in decimal to `b`.
fn number(strbuf.str_buf mut* b, u64 n) void {
    strbuf.append_u64(b, n);
}

// `w` declares WIDE named locals, then records WIDE deferred statements, then returns. The return
// expands the deferred statements, the last one first, and ends the locals in the order of their
// declarations. The source and the text are built by loops, one line for each local and each
// deferred statement: local `k` stands on line `k + 2`, and its `defer` on line `k + 2 + WIDE`.
fn a_wide_scope_ends_every_local_and_expands_every_defer() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    strbuf.str_buf mut src = strbuf.create();
    defer strbuf.free(&src);
    strbuf.str_buf mut want = strbuf.create();
    defer strbuf.free(&want);
    line(&src, "fn w(bool c) void {");
    u64 mut k = 0;
    while (k < WIDE) {
        strbuf.append(&src, "    bool a");
        number(&src, k);
        line(&src, " = c;");
        k += 1;
    }
    k = 0;
    while (k < WIDE) {
        strbuf.append(&src, "    defer w(a");
        number(&src, k);
        line(&src, ");");
        k += 1;
    }
    line(&src, "    return;");
    line(&src, "}");
    // `return` stands on line `2 + 2 * WIDE`, the index of local `k` is `k + 1`, the index of its
    // `defer` is `k + 1 + WIDE`, and the index of the return is `1 + 2 * WIDE`
    u64 ret = 2 + 2 * WIDE;
    u64 ret_index = 1 + 2 * WIDE;
    line(&want, "fn main.w(_1 (c): bool) -> void {");
    line(&want, "    let _0: void;");
    k = 0;
    while (k < WIDE) {
        strbuf.append(&want, "    let _");
        number(&want, k + 2);
        strbuf.append(&want, " (a");
        number(&want, k);
        strbuf.append(&want, "): bool #");
        number(&want, k + 2);
        line(&want, ":10;");
        k += 1;
    }
    // the temporary of the expansion of the `defer` of local `WIDE - 1 - j`, the last one first
    u64 mut j = 0;
    while (j < WIDE) {
        strbuf.append(&want, "    let _");
        number(&want, j + 2 + WIDE);
        strbuf.append(&want, ": void #");
        number(&want, 2 * WIDE + 1 - j);
        line(&want, ":12;");
        j += 1;
    }
    line(&want, "");
    line(&want, "    bb0: {");
    k = 0;
    while (k < WIDE) {
        strbuf.append(&want, "        live(_");
        number(&want, k + 2);
        strbuf.append(&want, ") #");
        number(&want, k + 2);
        strbuf.append(&want, ":10 s");
        number(&want, k + 1);
        line(&want, ";");
        strbuf.append(&want, "        _");
        number(&want, k + 2);
        strbuf.append(&want, " = copy _1 #");
        number(&want, k + 2);
        // `c` stands one column further right after a name of two digits
        if (k < 10) {
            strbuf.append(&want, ":15 s");
        } else {
            strbuf.append(&want, ":16 s");
        }
        number(&want, k + 1);
        line(&want, ";");
        k += 1;
    }
    j = 0;
    while (j < WIDE) {
        strbuf.append(&want, "        _");
        number(&want, j + 2 + WIDE);
        strbuf.append(&want, " = call fn main.w(copy _");
        number(&want, WIDE + 1 - j);
        strbuf.append(&want, ") #");
        number(&want, 2 * WIDE + 1 - j);
        strbuf.append(&want, ":12 exit ");
        number(&want, ret);
        strbuf.append(&want, ":5 s");
        number(&want, ret_index + 1 + j);
        line(&want, ";");
        j += 1;
    }
    k = 0;
    while (k < WIDE) {
        strbuf.append(&want, "        dead(_");
        number(&want, k + 2);
        strbuf.append(&want, ") #");
        number(&want, ret);
        strbuf.append(&want, ":5 s");
        number(&want, ret_index);
        line(&want, ";");
        k += 1;
    }
    strbuf.append(&want, "        return #");
    number(&want, ret);
    strbuf.append(&want, ":5 s");
    number(&want, ret_index);
    line(&want, ";");
    line(&want, "    }");
    line(&want, "}");
    string[1] whole = {strbuf.view(&src)};
    string got = lower_env.lower(&e, whole[..], "w");
    if (got != strbuf.view(&want)) {
        eprintln("expected:");
        eprint(strbuf.view(&want));
        eprintln("got:");
        eprint(got);
        panic("fir_lower_defer_test: the wide scope differs");
    }
}

fn a_deferred_range_for_takes_a_new_loan_at_each_expansion() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[7] source = {
        "fn f(bool c, i32@ a) void {",
        "    defer {",
        "        for (i32 x : a) {",
        "        }",
        "    }",
        "    if (c) { return; }",
        "}",
    };
    string[62] want = {
        "fn main.f(_1 (c): bool, _2 (a): i32@) -> void {",
        "    let _0: void;",
        "    let _3 (x): i32 #3:18;",
        "    let _4: i32@ #3:22;",
        "    let _5: u64 #3:9;",
        "    let _6: bool #3:9;",
        "    let _7: i32@ #3:22;",
        "    let _8: u64 #3:9;",
        "    let _9: bool #3:9;",
        "",
        "    bb0: {",
        "        switch(copy _1) -> [true: bb1, otherwise: bb2] #6:5 s2;",
        "    }",
        "    bb1: {",
        "        _4 = copy _2 #3:22 exit 6:14 s4;",
        "        loan_begin 1 _2 _4 #3:9 exit 6:14 s4;",
        "        _5 = const u64 0 #3:9 exit 6:14 s4;",
        "        goto bb3 #3:9 exit 6:14 s4;",
        "    }",
        "    bb2: {",
        "        _7 = copy _2 #3:22 exit 7:1 s5;",
        "        loan_begin 2 _2 _7 #3:9 exit 7:1 s5;",
        "        _8 = const u64 0 #3:9 exit 7:1 s5;",
        "        goto bb7 #3:9 exit 7:1 s5;",
        "    }",
        "    bb3: {",
        "        _6 = lt(copy _5, copy _4.1) #3:9 exit 6:14 s4;",
        "        switch(copy _6) -> [true: bb4, otherwise: bb6] #3:9 exit 6:14 s4;",
        "    }",
        "    bb4: {",
        "        live(_3) #3:18 exit 6:14 s4;",
        "        _3 = copy _4[_5] #3:22 exit 6:14 s4;",
        "        dead(_3) #4:9 exit 6:14 s4;",
        "        goto bb5 #3:9 exit 6:14 s4;",
        "    }",
        "    bb5: {",
        "        _5 = add(copy _5, const u64 1) #3:9 exit 6:14 s4;",
        "        goto bb3 #3:9 exit 6:14 s4;",
        "    }",
        "    bb6: {",
        "        loan_end 1 #3:9 exit 6:14 s4;",
        "        return #6:14 s3;",
        "    }",
        "    bb7: {",
        "        _9 = lt(copy _8, copy _7.1) #3:9 exit 7:1 s5;",
        "        switch(copy _9) -> [true: bb8, otherwise: bb10] #3:9 exit 7:1 s5;",
        "    }",
        "    bb8: {",
        "        live(_3) #3:18 exit 7:1 s5;",
        "        _3 = copy _7[_8] #3:22 exit 7:1 s5;",
        "        dead(_3) #4:9 exit 7:1 s5;",
        "        goto bb9 #3:9 exit 7:1 s5;",
        "    }",
        "    bb9: {",
        "        _8 = add(copy _8, const u64 1) #3:9 exit 7:1 s5;",
        "        goto bb7 #3:9 exit 7:1 s5;",
        "    }",
        "    bb10: {",
        "        loan_end 2 #3:9 exit 7:1 s5;",
        "        return #7:1 s0;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "f"), want[..]);
}

fn a_panicking_defer_in_a_range_body_ends_without_a_loan_end() void {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[5] source = {
        "fn f(i32@ a) void {",
        "    for (i32 x : a) {",
        "        defer panic(\"stop\");",
        "    }",
        "}",
    };
    string[31] want = {
        "fn main.f(_1 (a): i32@) -> void {",
        "    let _0: void;",
        "    let _2 (x): i32 #2:14;",
        "    let _3: i32@ #2:18;",
        "    let _4: u64 #2:5;",
        "    let _5: bool #2:5;",
        "",
        "    bb0: {",
        "        _3 = copy _1 #2:18 s1;",
        "        loan_begin 1 _1 _3 #2:5 s1;",
        "        _4 = const u64 0 #2:5 s1;",
        "        goto bb1 #2:5 s1;",
        "    }",
        "    bb1: {",
        "        _5 = lt(copy _4, copy _3.1) #2:5 s1;",
        "        switch(copy _5) -> [true: bb2, otherwise: bb4] #2:5 s1;",
        "    }",
        "    bb2: {",
        "        live(_2) #2:14 s1;",
        "        _2 = copy _3[_4] #2:18 s1;",
        "        fail(panic, const bytes \"stop\", const u64 4) #3:15 exit 4:5 s3;",
        "    }",
        "    bb3: {",
        "        _4 = add(copy _4, const u64 1) #2:5 s1;",
        "        goto bb1 #2:5 s1;",
        "    }",
        "    bb4: {",
        "        loan_end 1 #2:5 s1;",
        "        return #5:1 s0;",
        "    }",
        "}",
    };
    lower_env.expect(lower_env.lower(&e, source[..], "f"), want[..]);
}

fn main() i32 {
    a_deferred_range_for_takes_a_new_loan_at_each_expansion();
    a_panicking_defer_in_a_range_body_ends_without_a_loan_end();

    the_worked_example_lowers_byte_for_byte();
    println("worked example ok");
    a_deferred_block_expands_at_each_exit_with_new_indices();
    a_deferred_statement_in_a_loop_expands_at_the_exits_of_the_loop();
    a_deferred_statement_in_a_clause_expands_at_its_exits();
    a_deferred_call_that_does_not_return_stops_the_expansion();
    a_deferred_call_that_does_not_return_ends_a_break_and_a_fall_off();
    nested_scopes_unwind_inner_first_each_with_its_markers();
    a_deferred_statement_in_a_range_for_expands_before_the_variable_ends();
    println("exits ok");
    a_break_inside_deferred_code_leaves_the_loop_inside_it();
    clause_exits_inside_deferred_code_stay_inside_it();
    a_deferred_block_ends_its_own_local_and_expands_its_own_defer();
    println("floor ok");
    a_local_of_a_nested_block_ends_at_the_end_of_that_block();
    an_exit_ends_the_locals_declared_before_it();
    a_local_of_a_do_body_ends_before_the_test();
    println("markers ok");
    the_locals_of_a_for_end_where_their_loop_leaves_them();
    println("scopes ok");
    a_wide_scope_ends_every_local_and_expands_every_defer();
    println("growth ok");
    return 0;
}
