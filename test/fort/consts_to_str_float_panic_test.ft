//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: consts.cv_to_str: a float constant has no text form
//! stdout:
//| 7
import consts;
import std.strbuf;

// No message of the checker prints the value of a float constant: the two
// that print a constant at all name the float instead, and the shortest
// decimal that reads back is the runtime's work. So asking cv_to_str for the
// text of one is a broken precondition.
// D18.2, D13.3
fn main() i32 {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    consts.cv_to_str(consts.cv_from_i64(7), &b);
    println(strbuf.view(&b));
    consts.cv_to_str(consts.cv_from_float(0x3FF0000000000000), &b);
    println(strbuf.view(&b));
    return 0;
}
