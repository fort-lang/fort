//! run
//! flags: -I ../../src/fort -I support -I ../../src
//! abort
//! stderr: panic: json.at_of: index out of range
//! stdout:
//| the children of the array ok
import lsp.json;

// at_of takes an index below the child count; one at or past it is a violated
// precondition and panics. A value that is no container has no child at all,
// so every index of one is past its count.
// D13.3
fn main() i32 {
    json.doc mut d = json.create();
    defer json.free(&d);
    assert(json.parse(&d, "[1,2]"));
    u32 root = json.root(&d);
    assert(json.int_of(&d, json.at_of(&d, root, 0)) == 1);
    assert(json.int_of(&d, json.at_of(&d, root, 1)) == 2);
    println("the children of the array ok");
    println(json.at_of(&d, root, 2));
    return 0;
}
