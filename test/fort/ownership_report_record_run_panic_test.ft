//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: ownership_report.record_run: a raw record names a leaf
//! stdout:
//| local
//| stored
//| raw whole
/// A raw record names a whole local, so it has no flow run whose leaves name it. A raw record
/// with a leaf breaks that rule, so `record_run` panics before it names the leaf through a
/// flow run that does not hold it.
import ownership_report;
import ownership_source;
import ownership_source_local;

fn main() i32 {
    ownership_source.body row = ownership_source.body{};
    ownership_source_local.violation mut v = ownership_source_local.violation{
        .leaf = ownership_source_local.WHOLE};
    if (ownership_report.record_run(&row, 0, &v) == &row.local) { println("local"); }
    if (ownership_report.record_run(&row, 1, &v) == &row.stored) { println("stored"); }
    if (ownership_report.record_run(&row, 3, &v) == null) { println("raw whole"); }
    v.leaf = 0;
    ownership_report.record_run(&row, 2, &v);
    return 0;
}
