//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: types: layout of a non-struct
//! stdout:
//| true
import types;
import types_env;

// Only a struct has a layout (D3.8): a pointer's size is fixed by D3.1.
fn i32 main() {
    types_env.env mut e = types_env.env{};
    types_env.init(&e);
    defer types_env.free(&e);
    println(types.type_layout_state(e.point) == types.layout_state.l_resolved);
    types.node* p = types_env.type_of(&e, "node*");
    println(types.type_layout_state(p) == types.layout_state.l_resolved);
    return 0;
}
