//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| join allocator mode 4 released
/// Measures the teardown of a join refused at its first core charge in one program of its own.
import ownership_raw_join_cleanup_env;
fn main() i32 {
    ownership_raw_join_cleanup_env.teardown_probe(4);
    return 0;
}
