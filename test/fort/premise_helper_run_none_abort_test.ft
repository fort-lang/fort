//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: run_env.parse_breaks_made: another count of functions breaks a premise rule
//! stderr: 0 functions break a premise rule, and not 1
//! stdout:
//| ready
/// run_env.parse_breaks_made stops the test for a text whose functions keep the 16 rules of the
/// verifier: such a text goes through the strict helper run_env.parse_made.
import fort.fir;
import premise_env;
import run_env;

// A panic ends the program, so the case stands in a file of its own.
fn main() i32 {
    run_env.env mut* own e = run_env.make();
    defer run_env.drop_made(move(e));
    run_env.check(e, premise_env.PRELUDE[..]);
    println("ready");
    fir.module mut* own m = run_env.parse_breaks_made(e, premise_env.KEEP[..], 1);
    defer fir.module_drop_made(move(m));
    return 0;
}
