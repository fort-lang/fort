//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: check.resolve_struct: a struct laid out twice
//! stdout:
//| true
//| true
/// resolve_struct starts the layout of a struct that no other layout holds open. A struct
/// whose layout is already in progress breaks that precondition, so the call panics.
import ast;
import check;
import check_env;
import types;

fn main() i32 {
    check_env.env mut e = check_env.env{};
    check_env.open(&e);
    defer check_env.close(&e);
    println(check_env.open_module(&e, "struct p {\n    i32 x;\n}\n"));
    ast.sym mut* s = check_env.sym_main(&e, "p");
    s->ty = types.type_struct(&e.ck.types, "q", null);
    println(types.type_layout_begin(s->ty));
    check.resolve_struct(&e.ck, s);
    return 0;
}
