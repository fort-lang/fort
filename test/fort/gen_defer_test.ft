//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| scopes ok
//| exits ok
//| results ok
//| ok
/// Checks deferred statements in src/fort/gen_stmt.ft. The cases cover exited scopes, execution
/// order, and aggregate returns.
import gen_env;
import std.str;
import std.strbuf;

//
// Each exit has a static set of deferred statements. The emitter reads them
// from the scope stack and copies their code into each exit. The cases can
// therefore count the copies. A `defer` in a loop body expands at `continue`,
// at `break`, and at the iteration end. Each copy uses the statement emitted
// at that exit.
//
// Each expected text comes from bootstrap-0 `fort -S` output for the same program.
// It does not come from the fort emitter under test.
//
// All seven cases emit a definition through the `emit` helper below. The
// helper has one block-check call site that covers all seven cases.

fn emit(gen_env.env mut* e, string src, string name) string {
    assert(gen_env.open_module(e, src));
    string got = gen_env.emit_function(e, name);
    gen_env.expect_blocks(e, got);
    return got;
}

fn wrap(strbuf.str_buf mut* b, string decls) string {
    strbuf.clear(b);
    strbuf.append(b, decls);
    strbuf.append(b, "fn main() i32 {\n    return 0;\n}\n");
    return strbuf.view(b);
}

// ---- scopes ------------------------------------------------------------------------

// Falling off the end of a block runs the deferred statements it holds, in
// reverse textual order. And an inner block's own statements run when that
// block ends and not at the function's exit. The three `eprintln`s are
// therefore c, b, a: the inner block's `c`, then its `defer`, then the
// function's.
fn a_block_runs_its_own_deferred_statements_when_it_ends() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.str_buf mut src = strbuf.create();
    defer strbuf.free(&src);
    strbuf.append(&src, "fn at_end(i64 n) i64 {\n    defer eprintln(\"a\");\n    {\n");
    strbuf.append(&src, "        defer eprintln(\"b\");\n        eprintln(\"c\");\n    }\n");
    strbuf.append(&src, "    return n;\n}\n");
    string got = emit(&e, wrap(&b, strbuf.view(&src)), "at_end");
    string[11] mut want = {
        "define dso_local i64 @\"main.at_end\"(i64 %n.in) #0 {\n",
        "entry:\n",
        "  %n.0 = alloca i64, align 8\n",
        "  store i64 %n.in, ptr %n.0, align 8\n",
        "  call void @\"std.rt.print_str\"(i32 2, ptr @.str.0, i64 1)\n",
        "  call void @\"std.rt.print_char\"(i32 2, i8 zeroext 10)\n",
        "  call void @\"std.rt.print_str\"(i32 2, ptr @.str.1, i64 1)\n",
        "  call void @\"std.rt.print_char\"(i32 2, i8 zeroext 10)\n",
        "  %t0 = load i64, ptr %n.0, align 8\n",
        "  call void @\"std.rt.print_str\"(i32 2, ptr @.str.2, i64 1)\n",
        "  call void @\"std.rt.print_char\"(i32 2, i8 zeroext 10)\n  ret i64 %t0\n}\n",
    };
    gen_env.expect_text(got, gen_env.join_lines(&e, want[0..11]));
    // Nothing was captured at `defer` time: each copy is the statement emitted
    // where the exit stands. So the three literals are three string constants
    // in the order the copies were written.
    assert(gen_env.record_text(&e, 0) == "c");
    assert(gen_env.record_text(&e, 1) == "b");
    assert(gen_env.record_text(&e, 2) == "a");
}

// ---- exits -------------------------------------------------------------------------

// A loop body is a scope that `break` and `continue` both leave. So its
// deferred statements run at either exit and at the end of every iteration. In
// a `for`, `continue` runs them before `step`.
fn a_defer_in_a_loop_body_is_copied_into_every_exit() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.str_buf mut src = strbuf.create();
    defer strbuf.free(&src);
    strbuf.append(&src, "fn in_loop(bool go) void {\n    for (;;) {\n");
    strbuf.append(&src, "        defer eprintln(\"step\");\n        if (go) {\n");
    strbuf.append(&src, "            continue;\n        }\n        break;\n    }\n}\n");
    string got = emit(&e, wrap(&b, strbuf.view(&src)), "in_loop");
    string[10] mut want = {
        "\nL4:\n",
        // The `continue` runs the body's deferred statement and then branches
        // to the step block.
        "  call void @\"std.rt.print_str\"(i32 2, ptr @.str.0, i64 4)\n",
        "  call void @\"std.rt.print_char\"(i32 2, i8 zeroext 10)\n",
        "  br label %L2\n",
        "\nL5:\n",
        // The `break` runs its own copy and branches to the continuation.
        "  call void @\"std.rt.print_str\"(i32 2, ptr @.str.1, i64 4)\n",
        "  call void @\"std.rt.print_char\"(i32 2, i8 zeroext 10)\n",
        "  br label %L3\n",
        "\nL2:\n",
        "  br label %L0\n",
    };
    assert(str.find(got, gen_env.join_lines(&e, want[0..10])) >= 0);
    // Two exits, two copies, two string constants: the body never falls off
    // its own end here, since both arms of the `if` terminate.
    assert(gen_env.record_text(&e, 0) == "step");
    assert(gen_env.record_text(&e, 1) == "step");
    assert(e.g.strs.len == 2);
}

// The same in a `do`, where the two exits go to two different blocks. The
// `continue` runs the body's deferred statement and branches to the test, and
// the `break` runs its own copy and branches to the continuation. bootstrap-0
// refuses `do`-`while`, so the expected text of this one case was read off
// stage2 and its blocks are named here.
fn a_defer_in_a_do_while_body_is_copied_into_both_exits() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.str_buf mut src = strbuf.create();
    defer strbuf.free(&src);
    strbuf.append(&src, "fn in_do(bool go) void {\n    do {\n");
    strbuf.append(&src, "        defer eprintln(\"step\");\n        if (go) {\n");
    strbuf.append(&src, "            continue;\n        }\n        break;\n");
    strbuf.append(&src, "    } while (go);\n}\n");
    string got = emit(&e, wrap(&b, strbuf.view(&src)), "in_do");
    string[10] mut want = {
        "\nL3:\n",
        "  call void @\"std.rt.print_str\"(i32 2, ptr @.str.0, i64 4)\n",
        "  call void @\"std.rt.print_char\"(i32 2, i8 zeroext 10)\n",
        // The `continue` branches to the test block, which is L1 here.
        "  br label %L1\n",
        "\nL4:\n",
        "  call void @\"std.rt.print_str\"(i32 2, ptr @.str.1, i64 4)\n",
        "  call void @\"std.rt.print_char\"(i32 2, i8 zeroext 10)\n",
        // The `break` branches to the continuation and runs no test.
        "  br label %L2\n",
        "\nL1:\n",
        "  %t3 = load i8, ptr %go.0, align 1\n",
    };
    assert(str.find(got, gen_env.join_lines(&e, want[0..10])) >= 0);
    assert(gen_env.record_text(&e, 0) == "step");
    assert(gen_env.record_text(&e, 1) == "step");
    assert(e.g.strs.len == 2);
}

// A `break` inside deferred code binds to a loop written inside that deferred
// code. And the deferred code is expanded at the exit that runs it, so that
// loop is emitted inside the expansion. L2 is the enclosing loop's exit and L5
// the exit of the loop inside the deferred code. The inner `break` branches to
// L5, `out` still runs, and the enclosing loop is left once, at the end of the
// expansion. A branch to L2 there would put `out` after a terminator.
fn a_break_of_a_loop_inside_deferred_code_branches_to_that_loop() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.str_buf mut src = strbuf.create();
    defer strbuf.free(&src);
    strbuf.append(&src, "fn in_loop() void {\n    while (true) {\n        defer {\n");
    strbuf.append(&src, "            while (true) {\n                eprintln(\"in\");\n");
    strbuf.append(&src, "                break;\n            }\n");
    strbuf.append(&src, "            eprintln(\"out\");\n        }\n        break;\n");
    strbuf.append(&src, "    }\n}\n");
    string got = emit(&e, wrap(&b, strbuf.view(&src)), "in_loop");
    string[9] mut want = {
        "\nL4:\n",
        "  call void @\"std.rt.print_str\"(i32 2, ptr @.str.0, i64 2)\n",
        "  call void @\"std.rt.print_char\"(i32 2, i8 zeroext 10)\n",
        "  br label %L5\n",
        "\nL5:\n",
        "  call void @\"std.rt.print_str\"(i32 2, ptr @.str.1, i64 3)\n",
        "  call void @\"std.rt.print_char\"(i32 2, i8 zeroext 10)\n",
        "  br label %L2\n",
        "\nL2:\n",
    };
    assert(str.find(got, gen_env.join_lines(&e, want[0..9])) >= 0);
    assert(gen_env.record_text(&e, 0) == "in");
    assert(gen_env.record_text(&e, 1) == "out");
    assert(e.g.strs.len == 2);
}

// `return e` evaluates `e` before the deferred code runs, which cannot then
// change the value returned: the value is in a register first.
fn a_return_reads_its_value_before_the_deferred_code_runs() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.str_buf mut src = strbuf.create();
    defer strbuf.free(&src);
    strbuf.append(&src, "fn early(i64 n) i64 {\n    defer eprintln(\"out\");\n");
    strbuf.append(&src, "    return n;\n}\n");
    string got = emit(&e, wrap(&b, strbuf.view(&src)), "early");
    string[4] mut want = {
        "  %t0 = load i64, ptr %n.0, align 8\n",
        "  call void @\"std.rt.print_str\"(i32 2, ptr @.str.0, i64 3)\n",
        "  call void @\"std.rt.print_char\"(i32 2, i8 zeroext 10)\n",
        "  ret i64 %t0\n",
    };
    assert(str.find(got, gen_env.join_lines(&e, want[0..4])) >= 0);
}

// ---- results -----------------------------------------------------------------------

// The `sret` block belongs to the caller. The caller can also pass its pointer as an argument,
// so deferred code can reach it. The result lands in a temporary of the callee's own and
// is copied out after the deferred code has run.
fn an_aggregate_return_lands_in_a_temporary_when_anything_is_deferred() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.str_buf mut src = strbuf.create();
    defer strbuf.free(&src);
    strbuf.append(&src, "struct point {\n    i64 x;\n    i64 y;\n}\n");
    strbuf.append(&src, "fn aggregate(point p) point {\n    defer eprintln(\"out\");\n");
    strbuf.append(&src, "    return p;\n}\n");
    string got = emit(&e, wrap(&b, strbuf.view(&src)), "aggregate");
    string[9] mut want = {
        "entry:\n",
        "  %tmp0 = alloca %struct.main.point, align 8\n",
        "  call void @llvm.memcpy.p0.p0.i64(ptr align 8 %tmp0, ptr align 8 %p.in, i64 16,",
        " i1 false)\n",
        "  call void @\"std.rt.print_str\"(i32 2, ptr @.str.0, i64 3)\n",
        "  call void @\"std.rt.print_char\"(i32 2, i8 zeroext 10)\n",
        "  call void @llvm.memcpy.p0.p0.i64(ptr align 8 %ret.sret, ptr align 8 %tmp0, i64 16,",
        " i1 false)\n",
        "  ret void\n}\n",
    };
    assert(str.find(got, gen_env.join_lines(&e, want[0..9])) >= 0);
}

// A function with nothing deferred writes the caller's block directly and pays
// for no temporary.
fn an_aggregate_return_writes_the_sret_block_when_nothing_is_deferred() void {
    gen_env.env mut e = gen_env.env{};
    gen_env.open(&e);
    defer gen_env.close(&e);
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.str_buf mut src = strbuf.create();
    defer strbuf.free(&src);
    strbuf.append(&src, "struct point {\n    i64 x;\n    i64 y;\n}\n");
    strbuf.append(&src, "fn plain(point p) point {\n    return p;\n}\n");
    string got = emit(&e, wrap(&b, strbuf.view(&src)), "plain");
    string[5] mut want = {
        "entry:\n",
        "  call void @llvm.memcpy.p0.p0.i64(ptr align 8 %ret.sret, ptr align 8 %p.in, i64 16,",
        " i1 false)\n",
        "  ret void\n}\n",
        "",
    };
    assert(str.find(got, gen_env.join_lines(&e, want[0..4])) >= 0);
    assert(str.find(got, "%tmp0") < 0);
}

fn main() i32 {
    a_block_runs_its_own_deferred_statements_when_it_ends();
    println("scopes ok");
    a_defer_in_a_loop_body_is_copied_into_every_exit();
    a_defer_in_a_do_while_body_is_copied_into_both_exits();
    a_break_of_a_loop_inside_deferred_code_branches_to_that_loop();
    a_return_reads_its_value_before_the_deferred_code_runs();
    println("exits ok");
    an_aggregate_return_lands_in_a_temporary_when_anything_is_deferred();
    an_aggregate_return_writes_the_sret_block_when_nothing_is_deferred();
    println("results ok");
    println("ok");
    return 0;
}
