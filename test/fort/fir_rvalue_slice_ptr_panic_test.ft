//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: fir.rvalue_type: slice_ptr of a non-pointer
//! stdout:
//| ready
/// Checks that fir.rvalue_type refuses slice_ptr of an operand that is not a pointer.
import fir;
import prim;
import types;

fn main() i32 {
    types.table mut tt = types.table{};
    defer types.type_table_free(&tt);
    types.node* i32t = types.type_prim(&tt, prim.prim_kind.prim_i32);
    types.node*[2] params = {i32t, i32t};
    types.node* fnty = types.type_fn(&tt, i32t, params[..], false);
    fir.func mut f = fir.func_new(&tt, null, fnty);
    defer fir.func_free(&f);
    fir.operand a = fir.operand_copy(fir.place_local(1));
    fir.rvalue r = fir.rvalue_slice_ptr(&f, a, a, a);
    println("ready");
    fir.rvalue_type(&f, r);
    return 0;
}
