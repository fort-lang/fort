//! run
//! flags: -I ../../src
//! abort
//! stderr: panic: scope.at: index out of range
//! stdout:
//| add
//| 1
/// at answers for every binding declared and panics past the last one, rather
/// than reading a slot of the vector that no declare filled. The vector has
/// room for eight here and holds one.
import fort.diag;
import fort.scope;

// The steps of the test, which end in the panic. They read `s` through a pointer, so the use
// rule of `move` and `del` (D17.21) asks no proof of their reads after a call.
fn trigger(scope.scope mut* s) void {
    scope.init(s, scope.scope_kind.s_module, null);
    scope.declare(s, "add", scope.bind_kind.b_fn, diag.loc_make("a.ft", 1, 1), null);
    println(scope.at(s, 0)->name);
    println(scope.count(s));
    println(scope.at(s, 1)->name);
}

fn main() i32 {
    scope.scope mut s = scope.scope{};
    defer scope.free(&s);
    trigger(&s);
    return 0;
}
