//! run
//! flags: -I ../../src/fort -I support
//! abort
//! stderr: panic: fir_lower.string_parts: a string that owns
//! stdout:
//| true
/// The checker gives a print argument and `panic` no owning rvalue, which would leak.
/// string_parts on `move(p)` breaks that precondition, so the call panics.
import ast;
import check;
import check_env;
import fir;
import fir_lower;
import lower_env;

fn main() i32 {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[4] source = {
        "fn f(u8 mut@ own p) void {",
        "    u8 mut@ own q = move(p);",
        "    del(q);",
        "}",
    };
    lower_env.check_lines(&e, source[..], true);
    ast.node* decl = lower_env.decl(&e, "f");
    fir.func mut f = fir.func_new(&e.c.ck.types, decl->sym, decl->sym->ty);
    defer fir.func_free(&f);
    fir_lower.lowerer mut lw = fir_lower.lowerer{.ck = &e.c.ck, .f = &f};
    defer fir_lower.scopes_free(&lw.scopes);
    fir_lower.prescan(&lw, decl->b);
    fir_lower.scope_push(&lw, fir_lower.scope_kind.sc_fn, 0, 0);
    ast.node mut* call = check_env.node_in_main(&e.c, ast.ast_kind.k_call, "");
    println((call->ann & check.ANN_MOVE) != 0);
    fir.operand mut ptr = fir.operand{};
    fir.operand mut len = fir.operand{};
    fir_lower.string_parts(&lw, call, &ptr, &len);
    return 0;
}
