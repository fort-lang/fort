//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: ownership_source_live: service binding failed
//! stdout:
//| 1
/// prepare binds the event services to a fresh store. A store that already rendered an
/// event refuses the binding, so the call panics.
/// prepare reads the FIR size of its function before the binding, so the test gives it an
/// empty function and not null.
import fir;
import ownership_api;
import ownership_source_live;

fn main() i32 {
    ownership_source_live.context mut c = ownership_source_live.context{};
    c.events.rendered = 1;
    println(c.events.rendered);
    fir.func empty = fir.func{};
    ownership_source_live.prepare(&c, &empty, ownership_api.function_id{}, 0,
        ownership_api.source_position{});
    return 0;
}
