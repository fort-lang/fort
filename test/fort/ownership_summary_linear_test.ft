    successful(&f);
    assert(ownership_calls_fixtures.outstanding(&f.application.state) == 0);
    assert(f.application.state.allocations[0].validity == ownership_api.validity_kind.released);
    u64 owner = ownership_transfer.contents_index(&f.application.state,
        ownership_summary_body.slot(&f.inputs[1], 1));
    assert(f.application.state.contents[owner].owner_empty);
    assert(ownership_api.successful(ownership_calls_fixtures.suffix(&f)));
    ownership_calls_fixtures.boundary("G03.1",
        "7951f42e5aaa57d9db530cc1248407a246f2c65e4beb6d935bf1cec7a53f1e74", "none");
}

