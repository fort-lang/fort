    assert(f.application.proof.failed && !f.application.normal_continuation);
    assert(f.application.outcome.possible_caller_return && f.application.outcome.cleanup_required);
    assert(f.services.counts.last.kind == ownership_api.event_kind.incomplete_proof);
    assert(f.services.counts.last.operation.function.declaration.declaration == 2);
    assert(f.application.bound.model.results.len == 1);
    assert(ownership_summary_model.same(f.application.bound.model.results[0].borrow.source,
        original(&f)));
    assert(ownership_state.equal(&f.before, &f.caller));
    ownership_calls_fixtures.boundary("G01.4",
        "87ecd84fbbb9090d4cb40193fb8618a9263ea13bcb0682dfd9d95cf427eaeaf9", "incomplete_proof");
}

