//! run
//! flags: -I ../../src -I support
//! abort
//! stderr: panic: fir_lower.project_field: a field with no declaration index
//! stdout:
//| true
/// The checker gives each field node the symbol of its field declaration. The test clears the
/// symbol of `p.a`, so project_field finds no index and panics.
import fort.ast;
import check_env;
import fort.fir;
import fort.fir_lower;
import lower_env;

fn main() i32 {
    lower_env.env mut e = lower_env.env{};
    lower_env.open(&e);
    defer lower_env.close(&e);
    string[7] source = {
        "struct pair {",
        "    i32 a;",
        "    i32 b;",
        "}",
        "fn f(pair p) i32 {",
        "    return p.a;",
        "}",
    };
    lower_env.check_lines(&e, source[..], true);
    project_without_symbol(&e);
    return 0;
}

// Projects `p.a` with no symbol. The function takes the environment as a parameter, so the
// reads through `decl` and `field` use no owner of its frame (D17.21).
fn project_without_symbol(lower_env.env mut* e) void {
    ast.node* decl = lower_env.decl(e, "f");
    // `f` lives in an allocation, so that the leak rule proves its end: no call changes the
    // pointer, and drop_made holds each release once.
    fir.func mut* own f = fir.func_make();
    *f = fir.func_new(&e->c.ck.types, decl->sym, decl->sym->ty);
    defer fir.func_drop_made(move(f));
    // `lw` ends in a block of its own, so that its `del`s come after the last call of its exit.
    {
        fir_lower.lowerer mut lw = fir_lower.lowerer{.ck = &e->c.ck, .f = f};
        defer {
            del(lw.scopes.items);
            del(lw.defers.items);
            del(lw.named.items);
        }
        fir_lower.prescan(f, decl->b);
        ast.node mut* field = check_env.node_in_main(&e->c, ast.ast_kind.k_field, "a");
        println(field->sym != null);
        field->sym = null;
        fir_lower.project_field(&lw, field, fir.place_local(1));
    }
}
