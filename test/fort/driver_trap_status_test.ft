//! run
//! flags: -I ../../src
//! signal: ILL
//! stdout:
//| before
/// Checks that driver.process_status ends the process by the signal of a trap of --fir-run,
/// SIGILL here, after the buffered output went out.
import fort.driver;

fn main() i32 {
    println("before");
    return driver.process_status(-4);
}
