//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| owners ok
//| borrows ok
//| spans ok
//| results ok
//| paths ok
//| loops ok
//| calls ok
//| storage ok
//| shapes ok
/// Holds the local outcome of small actual programs, one body for each rule it shows.
/// Each body gives its local correspondence, its local proof and its violations.
import ownership_api;
import ownership_report;
import ownership_source;
import ownership_source_env;
import ownership_source_local;
import std.strbuf;

// Mismatches print and count, so one run lists each wrong case.
u64 mut mismatches = 0;

fn mismatch() void { mismatches += 1; }

struct closure {
    ownership_source_env.env e;
    strbuf.str_buf text;
}

fn open(closure mut* c, string@ lines) void {
    c->text = strbuf.create();
    u64 mut i = 0;
    while (i < lines.len) {
        strbuf.append(&c->text, lines[i]);
        strbuf.push(&c->text, '\n');
        i += 1;
    }
    strbuf.append(&c->text, "fn root() i32 { return 0; }\n");
    ownership_source_env.open(&c->e);
    ownership_source_env.runtime(&c->e);
    if (!ownership_source_env.prepare(&c->e, strbuf.view(&c->text))) {
        eprintln(strbuf.view(&c->text));
        panic("ownership_source_local_cases_test: the program does not check");
    }
    ownership_source.analyze(&c->e.source);
}

fn close(closure mut* c) void {
    ownership_source_env.close(&c->e);
    strbuf.free(&c->text);
}

fn row(closure mut* c, string name) ownership_source.body* {
    ownership_source.body* found = ownership_source_env.find(&c->e, "main", name);
    assert(found->verification == ownership_source.status.complete);
    assert(found->local.solved);
    return found;
}

// The local correspondence and proof of one body, in the report's words.
fn outcome(closure mut* c, string name, string correspondence, string proof) void {
    ownership_source.body* found = row(c, name);
    string got_correspondence = ownership_report.analysis_status(found, ownership_report.LOCAL,
        0);
    string got_proof = ownership_report.analysis_status(found, ownership_report.LOCAL, 2);
    if (got_correspondence != correspondence || got_proof != proof) {
        eprintln(name, ": correspondence ", got_correspondence, ", proof ", got_proof);
        mismatch();
        return;
    }
    assert(ownership_report.analysis_status(found, ownership_report.LOCAL, 1) == "complete");
    if (proof != "violated") { assert(found->local.violations_len == 0); }
}

// A body that proves its local obligations.
fn proved(closure mut* c, string name) void { outcome(c, name, "complete", "complete"); }

// A declared body that cannot prove its obligations: scoped CI rejects it.
fn declared_unproved(closure mut* c, string name) void {
    outcome(c, name, "complete", "incomplete");
}

// A body outside the declared scope, with the first gap that put it there.
fn outside(closure mut* c, string name, ownership_source_local.missing why) void {
    outcome(c, name, "incomplete", "incomplete");
    ownership_source.body* found = row(c, name);
    if (found->local.gap != why) {
        eprintln(name, ": gap ", cast(found->local.gap, i32), ", wanted ", cast(why, i32));
        mismatch();
    }
}

// One validated violation of `kind` on `line` with the transfer reason `text`.
fn violation(closure mut* c, string name, ownership_api.event_kind kind, string slot,
    string text, u32 line) void {
    ownership_source.body* found = row(c, name);
    if (found->local.violations_len != 1) {
        eprintln(name, ": ", found->local.violations_len, " violations, proof ",
            ownership_report.analysis_status(found, ownership_report.LOCAL, 2));
        mismatch();
        return;
    }
    assert(ownership_report.analysis_status(found, ownership_report.LOCAL, 2) == "violated");
    ownership_source_local.violation v = found->local.violations[0];
    if (v.kind != kind || v.name != slot || v.text != text || v.source.line != line) {
        eprintln(name, ": ", v.name, " ", v.text, " at line ", v.source.line);
        mismatch();
    }
}

fn owners() void {
    closure mut c = closure{};
    string[16] lines = {
        "fn released() void { i32 mut* own p = new(i32); del(p); }",
        "fn leaked() void { i32 mut* own p = new(i32); }",
        "fn twice() void { i32 mut* own p = new(i32); del(p); del(p); }",
        "fn nulled() void { i32 mut* own mut p = new(i32); p = null; }",
        "fn moved() void { i32 mut* own p = new(i32); i32 mut* own q = move(p); del(q); }",
        "fn moved_both() void { i32* own p = new(i32); i32* own q = move(p); del(p); del(q); }",
        "fn moved_leak() void { i32 mut* own p = new(i32); i32 mut* own q = move(p); del(p); }",
        "fn refilled() void {",
        "    i32 mut* own mut p = new(i32);",
        "    del(p);",
        "    p = new(i32);",
        "    del(p);",
        "}",
        "fn empty_start() void { i32 mut* own mut p = null; p = new(i32); del(p); }",
        "fn deferred() void { i32 mut* own p = new(i32); defer del(p); }",
        "fn zero_length() void { u8 mut@ own s = new(u8, 0); del(s); }",
    };
    open(&c, lines[..]);
    defer close(&c);
    proved(&c, "released");
    violation(&c, "leaked", ownership_api.event_kind.lost_ownership, "p",
        "storage ends with a live owner", 2);
    // del empties its operand, so a second del releases nothing.
    proved(&c, "twice");
    // `p = null` moves an empty temporary into p, so the move finds the live owner.
    violation(&c, "nulled", ownership_api.event_kind.lost_ownership, "p",
        "move would discard a live owner", 4);
    proved(&c, "moved");
    proved(&c, "moved_both");
    violation(&c, "moved_leak", ownership_api.event_kind.lost_ownership, "q",
        "storage ends with a live owner", 7);
    proved(&c, "refilled");
    proved(&c, "empty_start");
    proved(&c, "deferred");
    // A zero-element allocation still needs its release (D17.9).
    proved(&c, "zero_length");
    println("owners ok");
}

fn borrows() void {
    closure mut c = closure{};
    string[38] lines = {
        "struct cell { i32 value; i32 other; }",
        "fn view_after_move() i32 {",
        "    i32 mut* own p = new(i32);",
        "    i32* view = p;",
        "    i32 mut* own q = move(p);",
        "    i32 v = *view;",
        "    del(q);",
        "    return v;",
        "}",
        "fn view_after_release() i32 {",
        "    i32 mut* own p = new(i32);",
        "    i32* view = p;",
        "    i32 mut* own q = move(p);",
        "    del(q);",
        "    return *view;",
        "}",
        "fn moved_from() i32 { i32 mut* own a = new(i32); i32 mut* own b = move(a); i32 v = *a;",
        "    del(b); return v; }",
        "fn field_view() i32 {",
        "    cell mut* own p = new(cell);",
        "    i32* inner = &p->other;",
        "    del(p);",
        "    return *inner;",
        "}",
        "fn field_ok() i32 {",
        "    cell mut* own p = new(cell);",
        "    i32* inner = &p->value;",
        "    i32 v = *inner;",
        "    del(p);",
        "    return v;",
        "}",
        "fn compared() bool {",
        "    i32 mut* own p = new(i32);",
        "    i32* q = p;",
        "    del(p);",
        "    return q == null;",
        "}",
        "fn null_after_release() bool { i32 mut* own p = new(i32); del(p); return p == null; }",
    };
    open(&c, lines[..]);
    defer close(&c);
    // A move keeps the allocation, so a view of it stays live (D17.6).
    proved(&c, "view_after_move");
    violation(&c, "view_after_release", ownership_api.event_kind.invalid_use, "view",
        "reference source is no longer live", 15);
    violation(&c, "moved_from", ownership_api.event_kind.invalid_use, "a",
        "empty reference has no element", 17);
    violation(&c, "field_view", ownership_api.event_kind.invalid_use, "inner",
        "reference source is no longer live", 23);
    proved(&c, "field_ok");
    // A comparison reads the reference value: a semantic use of a dangling borrow.
    violation(&c, "compared", ownership_api.event_kind.invalid_use, "q",
        "reference source is no longer live", 36);
    // A released owner holds null, and reading it is no use of storage.
    proved(&c, "null_after_release");
    println("borrows ok");
}

fn spans() void {
    closure mut c = closure{};
    string[30] lines = {
        "fn indexed(u64 n) u8 {",
        "    u8 mut@ own s = new(u8, n);",
        "    s[0] = 1;",
        "    u8 v = s[0];",
        "    del(s);",
        "    return v;",
        "}",
        "fn indexed_after(u64 n) u8 {",
        "    u8 mut@ own s = new(u8, n);",
        "    del(s);",
        "    return s[0];",
        "}",
        "fn sliced() u8 {",
        "    u8 mut@ own s = new(u8, 4);",
        "    u8 mut@ part = s[1..3];",
        "    del(s);",
        "    return part[0];",
        "}",
        "fn length_after() u64 { u8 mut@ own s = new(u8, 4); u8@ v = s; del(s); return v.len; }",
        "fn literal() u8 { string t = \"abc\"; return cast(t[1], u8); }",
        "fn literal_bytes() u64 { u8@ b = cast(\"xy\", u8@); return b.len; }",
        "fn pointer_of() u8 {",
        "    u8 mut@ own s = new(u8, 4);",
        "    u8 mut* p = s.ptr;",
        "    del(s);",
        "    return *p;",
        "}",
        "fn view_param(u8@ s) u8 { return s[0]; }",
        "fn view_param_len(string s) u64 { return s.len; }",
        "fn parameter_slice(u8@ s) u8 { u8@ t = s[1..]; return t[0]; }",
    };
    open(&c, lines[..]);
    defer close(&c);
    proved(&c, "indexed");
    // A released owner is {null, 0}: its element access is invalid in every mode.
    violation(&c, "indexed_after", ownership_api.event_kind.invalid_use, "s",
        "empty reference has no element", 11);
    violation(&c, "sliced", ownership_api.event_kind.invalid_use, "part",
        "reference source is no longer live", 17);
    // The length lives in the header. Its read is no use of the released elements.
    proved(&c, "length_after");
    proved(&c, "literal");
    proved(&c, "literal_bytes");
    violation(&c, "pointer_of", ownership_api.event_kind.invalid_use, "p",
        "reference source is no longer live", 26);
    // A parameter borrows caller storage that no local effect ends.
    proved(&c, "view_param");
    proved(&c, "view_param_len");
    proved(&c, "parameter_slice");
    println("spans ok");
}

fn results() void {
    closure mut c = closure{};
    string[28] lines = {
        "fn give() i32 mut* own { return new(i32); }",
        "fn give_null() i32 mut* own { return null; }",
        "fn give_moved() i32 mut* own { i32 mut* own p = new(i32); return move(p); }",
        "fn same(i32* p) i32* { return p; }",
        "fn first(string s) string { return s; }",
        "fn literal() string { return \"text\"; }",
        "fn released() i32* {",
        "    i32 mut* own p = new(i32);",
        "    i32* view = p;",
        "    del(p);",
        "    return view;",
        "}",
        "fn deferred_release() i32* {",
        "    i32 mut* own p = new(i32);",
        "    defer del(p);",
        "    return p;",
        "}",
        "fn kept() i32* {",
        "    i32 mut* own p = new(i32);",
        "    i32* view = p;",
        "    del(p);",
        "    return null;",
        "}",
        "fn chosen(bool c, i32* a, i32* b) i32* {",
        "    if (c) { return a; }",
        "    return b;",
        "}",
        "fn owned_text() string own { u8@ own b = new(u8, 2); return cast(move(b), string own); }",
    };
    open(&c, lines[..]);
    defer close(&c);
    // An owning result hands its obligation to the caller at return.
    proved(&c, "give");
    proved(&c, "give_null");
    proved(&c, "give_moved");
    proved(&c, "same");
    proved(&c, "first");
    proved(&c, "literal");
    // The copy of view into the result is itself a semantic read of a dangling view.
    violation(&c, "released", ownership_api.event_kind.invalid_use, "view",
        "reference source is no longer live", 11);
    // The deferred release runs before the return reads its result (D17.14).
    violation(&c, "deferred_release", ownership_api.event_kind.invalid_use, "the result",
        "returned view outlives its source", 16);
    // An unused dangling local alone needs no error.
    proved(&c, "kept");
    proved(&c, "chosen");
    proved(&c, "owned_text");
    println("results ok");
}

fn paths() void {
    closure mut c = closure{};
    string[42] lines = {
        "fn early(bool c) i32 {",
        "    i32 mut* own p = new(i32);",
        "    if (c) { return 1; }",
        "    del(p);",
        "    return 0;",
        "}",
        "fn both(bool c) void {",
        "    i32 mut* own p = new(i32);",
        "    if (c) { del(p); } else { del(p); }",
        "}",
        "fn one_side(bool c) void {",
        "    i32 mut* own p = new(i32);",
        "    if (c) { del(p); }",
        "}",
        "fn released_on_one_side(bool c) i32 {",
        "    i32 mut* own p = new(i32);",
        "    i32* view = p;",
        "    if (c) { del(p); }",
        "    i32 v = *view;",
        "    del(p);",
        "    return v;",
        "}",
        "fn released_on_both(bool c) i32 {",
        "    i32 mut* own p = new(i32);",
        "    i32* view = p;",
        "    if (c) { del(p); } else { del(p); }",
        "    return *view;",
        "}",
        "fn handed(bool c) void {",
        "    i32 mut* own p = new(i32);",
        "    i32 mut* own mut q = null;",
        "    if (c) { q = move(p); }",
        "    del(p);",
        "    del(q);",
        "}",
        "fn switched(i32 k) void {",
        "    i32 mut* own p = new(i32);",
        "    switch (k) {",
        "    case 0: del(p);",
        "    default: del(p);",
        "    }",
        "}",
    };
    open(&c, lines[..]);
    defer close(&c);
    // Every path that reaches the early return holds p.
    violation(&c, "early", ownership_api.event_kind.lost_ownership, "p",
        "storage ends with a live owner", 3);
    proved(&c, "both");
    // The join holds p on one path only: the end is unproved and stays declared.
    declared_unproved(&c, "one_side");
    declared_unproved(&c, "released_on_one_side");
    // Every reaching path released p, so the read through view fails on each one.
    violation(&c, "released_on_both", ownership_api.event_kind.invalid_use, "view",
        "reference source is no longer live", 27);
    proved(&c, "handed");
    proved(&c, "switched");
    println("paths ok");
}

fn loops() void {
    closure mut c = closure{};
    string[52] lines = {
        "fn churn(u64 n) void {",
        "    u64 mut i = 0;",
        "    while (i < n) { i32 mut* own p = new(i32); del(p); i += 1; }",
        "}",
        "fn body_leak(u64 n) void {",
        "    u64 mut i = 0;",
        "    while (i < n) { i32 mut* own p = new(i32); i += 1; }",
        "}",
        "fn at_break(u64 n) void {",
        "    while (true) {",
        "        i32 mut* own p = new(i32);",
        "        break;",
        "    }",
        "}",
        "fn at_continue(u64 n) void {",
        "    u64 mut i = 0;",
        "    while (i < n) {",
        "        i += 1;",
        "        i32 mut* own p = new(i32);",
        "        if (i > 1) { continue; }",
        "        del(p);",
        "    }",
        "}",
        "fn accumulated(u64 n) void {",
        "    i32 mut* own mut p = null;",
        "    u64 mut i = 0;",
        "    while (i < n) { p = new(i32); i += 1; }",
        "    del(p);",
        "}",
        "fn replaced(u64 n) void {",
        "    i32 mut* own mut current = null;",
        "    u64 mut i = 0;",
        "    while (i < n) { del(current); current = new(i32); i += 1; }",
        "    del(current);",
        "}",
        "struct holder { i32 mut* own p; }",
        "fn stored(holder mut* h, u64 n) void {",
        "    u64 mut i = 0;",
        "    while (i < n) { del(h->p); h->p = new(i32); i += 1; }",
        "}",
        "fn views(u64 n) u32 {",
        "    u64 mut i = 0;",
        "    u32 mut total = 0;",
        "    while (i < n) {",
        "        u8 mut@ own s = new(u8, 2);",
        "        u8@ v = s;",
        "        total += cast(v.len, u32);",
        "        del(s);",
        "        i += 1;",
        "    }",
        "    return total;",
        "}",
    };
    open(&c, lines[..]);
    defer close(&c);
    proved(&c, "churn");
    violation(&c, "body_leak", ownership_api.event_kind.lost_ownership, "p",
        "storage ends with a live owner", 7);
    violation(&c, "at_break", ownership_api.event_kind.lost_ownership, "p",
        "storage ends with a live owner", 12);
    // The leak at continue needs a second iteration. Its only path crosses a back edge, so no
    // witness validates it (toolchain 4.2): the proof stays incomplete.
    declared_unproved(&c, "at_continue");
    // The first iteration stores into an empty owner. Only a later one overwrites.
    declared_unproved(&c, "accumulated");
    // The release precedes each new allocation of the site.
    proved(&c, "replaced");
    // The releases through h are outside effects. h's caller storage stays unknown after
    // the first one, so the later store through h needs heap facts: call scope.
    outside(&c, "stored", ownership_source_local.missing.call_dependent);
    proved(&c, "views");
    println("loops ok");
}

fn calls() void {
    closure mut c = closure{};
    string[47] lines = {
        "extern fn foreign_count(char* p) i32;",
        "extern fn foreign_text() char*;",
        "extern fn foreign_owner() i32 mut* own;",
        "extern fn foreign_take(i32 mut* own p) void;",
        "fn helper() void {}",
        "fn scalar() i32 { return 1; }",
        "fn reference() i32* { return null; }",
        "fn take(i32 mut* own p) void { del(p); }",
        "fn around_call() void { i32 mut* own p = new(i32); helper(); del(p); }",
        "fn scalar_result() i32 { i32 mut* own p = new(i32); i32 v = scalar(); del(p); return v; }",
        "fn read_after_call() i32 {",
        "    i32 mut* own p = new(i32);",
        "    helper();",
        "    i32 v = *p;",
        "    del(p);",
        "    return v;",
        "}",
        "fn leak_after_call() void { i32 mut* own p = new(i32); helper(); }",
        "fn handed() void { i32 mut* own p = new(i32); take(move(p)); del(p); }",
        "fn handed_view() i32 {",
        "    i32 mut* own p = new(i32);",
        "    i32* view = p;",
        "    take(move(p));",
        "    return *view;",
        "}",
        "fn reference_result() i32 { i32* r = reference(); return *r; }",
        "fn through_value(fn () void f) void { i32 mut* own p = new(i32); f(); del(p); }",
        "fn trusted() i32 { char* t = foreign_text(); return foreign_count(t); }",
        "fn trusted_keeps() void {",
        "    i32 mut* own p = new(i32);",
        "    char* t = foreign_text();",
        "    i32 n = foreign_count(t);",
        "    del(p);",
        "}",
        "fn trusted_owner() void { i32 mut* own p = foreign_owner(); del(p); }",
        "fn trusted_take() void { i32 mut* own p = new(i32); foreign_take(move(p)); }",
        "fn parameter_after_call(i32* v) i32 { helper(); return *v; }",
        "fn parameter_before_call(i32* v) i32 { i32 r = *v; helper(); return r; }",
        "fn owned_parameter(i32 mut* own p) void { del(p); }",
        "fn violation_before_call() i32 {",
        "    i32 mut* own p = new(i32);",
        "    i32* q = p;",
        "    del(p);",
        "    i32 v = *q;",
        "    helper();",
        "    return v;",
        "}",
    };
    open(&c, lines[..]);
    defer close(&c);
    // A slot owner keeps its allocation across an unknown fort call.
    proved(&c, "around_call");
    proved(&c, "scalar_result");
    proved(&c, "read_after_call");
    // The call may never return, so the leak after it has no validated path (A06).
    declared_unproved(&c, "leak_after_call");
    proved(&c, "handed");
    // The callee owns the allocation now and may release it: cross-call scope.
    outside(&c, "handed_view", ownership_source_local.missing.call_dependent);
    outside(&c, "reference_result", ownership_source_local.missing.fort_call);
    proved(&c, "through_value");
    // Trusted extern calls keep known facts and give trusted foreign sources (D17.13).
    proved(&c, "trusted");
    proved(&c, "trusted_keeps");
    outside(&c, "trusted_owner", ownership_source_local.missing.foreign_owner);
    // An own argument of a trusted call leaves local proof. Nothing reads it later.
    proved(&c, "trusted_take");
    outside(&c, "parameter_after_call", ownership_source_local.missing.call_dependent);
    proved(&c, "parameter_before_call");
    outside(&c, "owned_parameter", ownership_source_local.missing.own_parameter);
    // A violation before the first call keeps its validated path.
    violation(&c, "violation_before_call", ownership_api.event_kind.invalid_use, "q",
        "reference source is no longer live", 44);
    println("calls ok");
}

fn storage() void {
    closure mut c = closure{};
    string[36] lines = {
        "struct pair { i32 a; i32 b; }",
        "struct owner { i32 mut* own p; }",
        "struct named { string s; }",
        "i32 GLOBAL = 3;",
        "string NAME = \"global\";",
        "string mut CHANGING = \"first\";",
        "fn plain_struct() i32 { pair mut v = {}; v.a = 1; return v.a + v.b; }",
        "fn owning_struct() void { owner mut o = {}; o.p = new(i32); del(o.p); }",
        "fn array_view() u8 { u8[4] a = {1, 2, 3, 4}; u8@ s = a[..]; return s[0]; }",
        "fn local_address() i32 { i32 mut x = 1; i32 mut* q = &x; *q = 2; return x; }",
        "fn global_address() i32 { i32* g = &GLOBAL; return *g; }",
        "fn global_load() u64 { string s = NAME; return s.len; }",
        "fn changing_load() u64 { string s = CHANGING; return s.len; }",
        "fn integer_pointer(u64 bits) i32 { i32* p = cast(bits, i32*); return *p; }",
        "fn pointer_integer() u64 {",
        "    i32 mut* own p = new(i32);",
        "    u64 bits = cast(p, u64);",
        "    del(p);",
        "    return bits;",
        "}",
        "fn named_result() named { return named{\"x\"}; }",
        "fn pair_result() pair { return pair{1, 2}; }",
        "fn loaded_field(owner* o) i32 { return *o->p; }",
        "fn moved_field(owner mut* o) void { i32 mut* own p = move(o->p); del(p); }",
        "fn released_field(owner mut* o) void { del(o->p); }",
        "fn stored_field(owner mut* o) void { o->p = new(i32); }",
        "fn ranged(u8@ s) u32 {",
        "    u32 mut t = 0;",
        "    for (u8 b : s) { t += cast(b, u32); }",
        "    return t;",
        "}",
        "struct tree { i32 v; tree mut* own left; }",
        "fn shallow() void { tree mut* own t = new(tree); del(t); }",
        "fn opaque_pointer() void { void mut* own p = cast(new(i32), void mut* own); del(p); }",
        "fn text_owner() void { string own s = cast(new(u8, 3), string own); del(s); }",
        "fn root_two() i32 { return GLOBAL; }",
    };
    open(&c, lines[..]);
    defer close(&c);
    proved(&c, "plain_struct");
    outside(&c, "owning_struct", ownership_source_local.missing.owning_storage);
    outside(&c, "array_view", ownership_source_local.missing.unknown_source);
    outside(&c, "local_address", ownership_source_local.missing.unknown_source);
    // A global lives in static storage, which no local effect ends.
    proved(&c, "global_address");
    // An immutable global with a constant initializer reads as its constant.
    proved(&c, "global_load");
    // A mutable global can hold any reference: its load has an unknown source.
    outside(&c, "changing_load", ownership_source_local.missing.unknown_source);
    outside(&c, "integer_pointer", ownership_source_local.missing.unknown_source);
    // The cast reads the pointer while its source is live.
    proved(&c, "pointer_integer");
    outside(&c, "named_result", ownership_source_local.missing.aggregate_result);
    proved(&c, "pair_result");
    // A field load gives an unknown source: stored borrows own that obligation.
    proved(&c, "loaded_field");
    outside(&c, "moved_field", ownership_source_local.missing.owner_load);
    proved(&c, "released_field");
    proved(&c, "stored_field");
    outside(&c, "ranged", ownership_source_local.missing.range_loan);
    // Del stays shallow: a tree node can own a left child (D17.16).
    outside(&c, "shallow", ownership_source_local.missing.owned_leaves);
    outside(&c, "opaque_pointer", ownership_source_local.missing.owned_leaves);
    proved(&c, "text_owner");
    proved(&c, "root_two");
    println("storage ok");
}

fn shapes() void {
    closure mut c = closure{};
    string[63] lines = {
        "enum kind { small, large }",
        "struct holder { i32 mut* own p; }",
        "fn by_kind(kind k) void {",
        "    i32 mut* own p = new(i32);",
        "    switch (k) {",
        "    case kind.small: del(p);",
        "    case kind.large: { i32 mut* own q = move(p); del(q); }",
        "    }",
        "}",
        "fn nested() void {",
        "    i32 mut* own outer = new(i32);",
        "    {",
        "        i32 mut* own inner = new(i32);",
        "        del(inner);",
        "    }",
        "    del(outer);",
        "}",
        "fn early_defer(bool c) i32 {",
        "    i32 mut* own p = new(i32);",
        "    defer del(p);",
        "    if (c) { return 1; }",
        "    return 0;",
        "}",
        "fn chosen(bool c) void {",
        "    i32 mut* own a = new(i32);",
        "    i32 mut* own b = new(i32);",
        "    i32 mut* own r = c ? move(a) : move(b);",
        "    del(r); del(a); del(b);",
        "}",
        "fn tested() void {",
        "    i32 mut* own p = new(i32);",
        "    if (p != null) { del(p); }",
        "}",
        "fn broken(u64 n) void {",
        "    u64 mut i = 0;",
        "    while (i < n) {",
        "        i32 mut* own p = new(i32);",
        "        if (i > 3) { del(p); break; }",
        "        del(p);",
        "        i += 1;",
        "    }",
        "}",
        "fn returned_in_loop(u64 n) i32 {",
        "    u64 mut i = 0;",
        "    while (i < n) {",
        "        i32 mut* own p = new(i32);",
        "        if (i > 3) { del(p); return 1; }",
        "        del(p);",
        "        i += 1;",
        "    }",
        "    return 0;",
        "}",
        "fn wrapped() void { i32 mut* own p = new(i32); holder h = holder{move(p)}; }",
        "fn deep(i32** pp) i32 { return **pp; }",
        "fn owned_text() void { string own s = cast(new(u8, 4), string own); del(s); }",
        "fn owned_strings() void { i32* own mut@ own list = new(i32* own, 2); del(list); }",
        "fn given(bool c) i32 mut* own {",
        "    i32 mut* own p = new(i32);",
        "    if (c) { return move(p); }",
        "    del(p);",
        "    return null;",
        "}",
        "fn root_three() i32 { return 0; }",
    };
    open(&c, lines[..]);
    defer close(&c);
    proved(&c, "by_kind");
    proved(&c, "nested");
    // The deferred release runs on each exit.
    proved(&c, "early_defer");
    // del of a moved-from owner releases nothing, so each path ends empty.
    proved(&c, "chosen");
    // An allocation is not null, so the flow refutes the false edge of the null test.
    proved(&c, "tested");
    proved(&c, "broken");
    proved(&c, "returned_in_loop");
    // The struct literal moves p into a local struct, which no TL tracks.
    outside(&c, "wrapped", ownership_source_local.missing.owning_storage);
    // The second dereference reads through heap storage: stored borrows own it.
    proved(&c, "deep");
    proved(&c, "owned_text");
    // Del stays shallow: each element can own a string (D17.16).
    outside(&c, "owned_strings", ownership_source_local.missing.owned_leaves);
    proved(&c, "given");
    println("shapes ok");
}

fn main() i32 {
    owners();
    borrows();
    spans();
    results();
    paths();
    loops();
    calls();
    storage();
    shapes();
    assert(mismatches == 0);
    return 0;
}
