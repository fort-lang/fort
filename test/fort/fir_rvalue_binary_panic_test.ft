//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: fir.rvalue_binary: not a binary rvalue
//! stdout:
//| ready
/// Checks that fir.rvalue_binary refuses a kind that does not take two operands.
import ast;
import fir;
import prim;
import types;

fn main() i32 {
    types.table mut tt = types.table{};
    defer types.type_table_free(&tt);
    types.node* i32t = types.type_prim(&tt, prim.prim_kind.prim_i32);
    types.node*[1] params = {i32t};
    types.node* fnty = types.type_fn(&tt, i32t, params[..], false);
    fir.func mut f = fir.func_new(&tt, null, fnty);
    defer fir.func_free(&f);
    fir.operand a = fir.operand_copy(fir.place_local(1));
    println("ready");
    fir.rvalue_binary(&f, fir.rvalue_kind.rv_not, a, a);
    return 0;
}
