//! run
//! flags: -I ../../src -I support
//! stdout:
//| ok
/// The lexer of src/fort/lexer.ft: the file, positions and comments,
/// identifiers, keywords and reserved words, operators, the kind names and the
/// token vector. The literal forms are in lexer_literals_test.ft and the error
/// recovery in lexer_errors_test.ft.
import fort.diag;
import heap;
import lex_env;
import fort.lexer;
import fort.session;
import std.strbuf;

//
// These direct tests hold the fort lexer. The C suite holds the C lexer.

// ---- files, whitespace and positions -------------------------------------------

fn empty_file_is_only_eof() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.clean(f, "", 0));
    assert(lex_env.kind(f, 0) == "end of file");
    assert(lex_env.at(f, 0, 1, 1));
    assert(lex_env.covers(f, 0, 0, 0));
    assert(lex_env.text(f, 0).len == 0);
}

fn whitespace_only_file_is_only_eof() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.clean(f, " \t\r\n \n", 0));
    assert(lex_env.at(f, 0, 3, 1));
    assert(lex_env.covers(f, 0, 6, 0));
}

fn file_without_trailing_newline() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.clean(f, "x", 1));
    assert(lex_env.kind(f, 0) == "identifier");
    assert(lex_env.at(f, 1, 1, 2));
    assert(lex_env.covers(f, 1, 1, 0));
}

fn eof_sits_after_the_trailing_newline() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.clean(f, "x;\n", 2));
    assert(lex_env.at(f, 2, 2, 1));
    assert(lex_env.covers(f, 2, 3, 0));
}

// The byte-order mark is skipped and takes no column.
fn bom_is_skipped_and_takes_no_column() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.clean(f, "\xEF\xBB\xBFx", 1));
    assert(lex_env.kind(f, 0) == "identifier");
    assert(lex_env.text(f, 0) == "x");
    assert(lex_env.at(f, 0, 1, 1));
    assert(lex_env.covers(f, 0, 3, 1));
    assert(lex_env.clean(f, "\xEF\xBB\xBF", 0));
    assert(lex_env.at(f, 0, 1, 1));
    assert(lex_env.covers(f, 0, 3, 0));
}

// A lone carriage return is whitespace and numbers no line.
fn cr_is_whitespace() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.clean(f, "a\r\nb\rc", 3));
    assert(lex_env.at(f, 0, 1, 1));
    assert(lex_env.at(f, 1, 2, 1));
    assert(lex_env.at(f, 2, 2, 3));
}

// A tab is one column, not a stop.
fn tab_counts_as_one_column() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.clean(f, "\t\tx\ty", 2));
    assert(lex_env.at(f, 0, 1, 3));
    assert(lex_env.at(f, 1, 1, 5));
    assert(lex_env.covers(f, 0, 2, 1));
    assert(lex_env.covers(f, 1, 4, 1));
}

fn positions_advance_across_lines() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.clean(f, "fn main() {\n    return 0;\n}\n", 9));
    assert(lex_env.at(f, 0, 1, 1));
    assert(lex_env.at(f, 1, 1, 4));
    assert(lex_env.at(f, 2, 1, 8));
    assert(lex_env.at(f, 3, 1, 9));
    assert(lex_env.at(f, 4, 1, 11));
    assert(lex_env.at(f, 5, 2, 5));
    assert(lex_env.at(f, 6, 2, 12));
    assert(lex_env.at(f, 7, 2, 13));
    assert(lex_env.at(f, 8, 3, 1));
    assert(lex_env.at(f, 9, 4, 1));
    assert(lex_env.covers(f, 5, 16, 6));
    assert(lex_env.covers(f, 9, 28, 0));
}

// ---- comments ------------------------------------------------------------------

fn line_comment_runs_to_the_end_of_the_line() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.clean(f, "a // b c \"d\" /* e\nf", 2));
    assert(lex_env.text(f, 0) == "a");
    assert(lex_env.text(f, 1) == "f");
    assert(lex_env.at(f, 1, 2, 1));
}

fn line_comment_at_the_end_of_the_file() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.clean(f, "a //", 1));
    assert(lex_env.clean(f, "//", 0));
    assert(lex_env.clean(f, "// no newline", 0));
    assert(lex_env.at(f, 0, 1, 14));
}

// `/*` is a lexical error rather than a comment.
fn block_comment_start_is_an_error() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.one_error(f, "a /* stale */ + 1", 1, 3,
                             "block comments are not supported, use '//'"));
    assert(lex_env.count(f) == 1);
    assert(lex_env.one_error(f, "/*", 1, 1, "block comments are not supported, use '//'"));
    assert(lex_env.one_error(f, "/**/", 1, 1, "block comments are not supported, use '//'"));
    assert(lex_env.one_error(f, "x/*", 1, 2, "block comments are not supported, use '//'"));
    assert(lex_env.one_error(f, "a/*=b", 1, 2, "block comments are not supported, use '//'"));
}

fn block_comment_start_is_an_error_wherever_it_stands() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.one_error(f, "// fine\nx = /* y */ 1;\n", 2, 5,
                             "block comments are not supported, use '//'"));
    assert(lex_env.count(f) == 1);
    assert(lex_env.one_error(f, "f(/*x*/)", 1, 3,
                             "block comments are not supported, use '//'"));
    assert(lex_env.one_error(f, "a\n\t/*", 2, 2,
                             "block comments are not supported, use '//'"));
}

// `a / *p`, with the operators separated, is a division by a dereference and
// not a comment.
fn a_slash_before_a_separated_star_is_a_division() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.clean(f, "a / *p", 4));
    assert(lex_env.kind(f, 0) == "identifier");
    assert(lex_env.kind(f, 1) == "/");
    assert(lex_env.kind(f, 2) == "*");
    assert(lex_env.kind(f, 3) == "identifier");
    assert(lex_env.at(f, 2, 1, 5));
    assert(lex_env.clean(f, "a/ *p", 4));
    assert(lex_env.kind(f, 1) == "/");
    assert(lex_env.kind(f, 2) == "*");
    assert(lex_env.clean(f, "a /\n*p", 4));
    assert(lex_env.at(f, 2, 2, 1));
    assert(lex_env.clean(f, "a / *(p)", 6));
    assert(lex_env.kind(f, 2) == "*");
    assert(lex_env.kind(f, 3) == "(");
}

fn line_comments_may_hold_non_ascii_bytes() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.clean(f, "// caf\xC3\xA9\nx // na\xC3\xAFve", 1));
    assert(lex_env.text(f, 0) == "x");
    assert(lex_env.at(f, 0, 2, 1));
}

fn comment_markers_inside_a_line_comment_are_text() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.clean(f, "// /* still a line comment */\nx", 1));
    assert(lex_env.text(f, 0) == "x");
    assert(lex_env.clean(f, "x // //\n", 1));
}

// ---- identifiers, keywords and reserved words ----------------------------------

fn identifier_forms() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.clean(f, "_ a1 _x_ CamelCase __ a_b_c z9", 7));
    assert(lex_env.text(f, 0) == "_");
    assert(lex_env.text(f, 1) == "a1");
    assert(lex_env.text(f, 2) == "_x_");
    assert(lex_env.text(f, 3) == "CamelCase");
    assert(lex_env.text(f, 4) == "__");
    assert(lex_env.text(f, 5) == "a_b_c");
    assert(lex_env.text(f, 6) == "z9");
    u64 mut i = 0;
    while (i < 7) {
        assert(lex_env.kind(f, i) == "identifier");
        i += 1;
    }
    // A digit may not start an identifier, but `_` may and the digit after it
    // is an ordinary identifier byte.
    assert(lex_env.clean(f, "_1 _0x", 2));
    assert(lex_env.kind(f, 0) == "identifier");
    assert(lex_env.kind(f, 1) == "identifier");
}

// An identifier's text is a view into the source, not a copy: it has the
// bytes at its own offset and its own length.
fn identifier_text_is_a_view_into_the_source() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.clean(f, "  hello  ", 1));
    assert(lex_env.text(f, 0) == "hello");
    assert(lex_env.text(f, 0).len == 5);
    assert(lex_env.covers(f, 0, 2, 5));
}

fn identifiers_have_no_length_limit() void {
    strbuf.str_buf mut b = strbuf.create();
    defer del(b.data);
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    // Ten thousand bytes of `a`, built here because adjacent literals do not
    // concatenate in fort and a line is a hundred columns.
    u64 mut i = 0;
    while (i < 10000) {
        strbuf.push(&b, 'a');
        i += 1;
    }
    assert(lex_env.clean(f, strbuf.view(&b), 1));
    assert(lex_env.kind(f, 0) == "identifier");
    assert(lex_env.text(f, 0).len == 10000);
    assert(lex_env.at(f, 1, 1, 10001));
}

// Every keyword lexes as its own kind, and the kind's name is the word: the
// table tok_kind_name holds is the table keyword_kind walks.
fn every_keyword_lexes_as_its_kind() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    i64 mut k = cast(lexer.tok_kind.kw_as, i64);
    i64 last = cast(lexer.tok_kind.kw_while, i64);
    i64 mut seen = 0;
    while (k <= last) {
        string word = lexer.tok_kind_name(cast(k, lexer.tok_kind));
        assert(lex_env.clean(f, word, 1));
        assert(lex_env.kind(f, 0) == word);
        assert(lex_env.text(f, 0) == word);
        assert(lex_env.covers(f, 0, 0, word.len));
        seen += 1;
        k += 1;
    }
    // The language has forty-one keywords.
    assert(seen == 41);
}

fn the_keyword_list_of_d2_4() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    // The list, in its order, in five lines because adjacent literals do not
    // concatenate and a line is a hundred columns.
    assert(lex_env.clean(f, "as bool break case cast char continue default defer do", 10));
    assert(lex_env.kind(f, 0) == "as");
    assert(lex_env.kind(f, 5) == "char");
    assert(lex_env.kind(f, 9) == "do");
    assert(lex_env.clean(f, "else enum extern f32 f64 false fn for", 8));
    assert(lex_env.kind(f, 0) == "else");
    assert(lex_env.kind(f, 3) == "f32");
    assert(lex_env.kind(f, 7) == "for");
    assert(lex_env.clean(f, "i8 i16 i32 i64 if import mut new noreturn null own", 11));
    assert(lex_env.kind(f, 0) == "i8");
    assert(lex_env.kind(f, 8) == "noreturn");
    assert(lex_env.kind(f, 10) == "own");
    assert(lex_env.clean(f, "return sizeof string struct switch true", 6));
    assert(lex_env.kind(f, 2) == "string");
    assert(lex_env.kind(f, 5) == "true");
    assert(lex_env.clean(f, "u8 u16 u32 u64 void while", 6));
    assert(lex_env.kind(f, 0) == "u8");
    assert(lex_env.kind(f, 5) == "while");
    // Ten and eight and eleven and six and six are the forty-one keywords.
    assert(10 + 8 + 11 + 6 + 6 == 41);
}

fn own_is_a_keyword() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.clean(f, "own mut node* n", 5));
    assert(lex_env.kind(f, 0) == "own");
    assert(lex_env.kind(f, 1) == "mut");
    assert(lex_env.kind(f, 2) == "identifier");
    assert(lex_env.kind(f, 3) == "*");
}

fn a_word_extending_a_keyword_is_an_identifier() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.clean(f, "iff i3 fnx structs _if if_ i32_t", 7));
    u64 mut i = 0;
    while (i < 7) {
        assert(lex_env.kind(f, i) == "identifier");
        i += 1;
    }
}

fn keywords_are_case_sensitive() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.clean(f, "If TRUE Fn i32 I32", 5));
    assert(lex_env.kind(f, 0) == "identifier");
    assert(lex_env.kind(f, 1) == "identifier");
    assert(lex_env.kind(f, 2) == "identifier");
    assert(lex_env.kind(f, 3) == "i32");
    assert(lex_env.kind(f, 4) == "identifier");
}

// The universe functions are names, not keywords.
fn universe_functions_are_not_keywords() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.clean(f, "del move assert panic print", 5));
    u64 mut i = 0;
    while (i < 5) {
        assert(lex_env.kind(f, i) == "identifier");
        i += 1;
    }
}

// The ten words reserved for future use are usable nowhere.
fn reserved_words_are_errors() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.one_error(f, "i32 const = 1;", 1, 5, "'const' is a reserved word"));
    assert(lex_env.count(f) == 1);
    assert(lex_env.one_error(f, "async", 1, 1, "'async' is a reserved word"));
    assert(lex_env.one_error(f, "await", 1, 1, "'await' is a reserved word"));
    assert(lex_env.one_error(f, "match", 1, 1, "'match' is a reserved word"));
    assert(lex_env.one_error(f, "pub", 1, 1, "'pub' is a reserved word"));
    assert(lex_env.one_error(f, "priv", 1, 1, "'priv' is a reserved word"));
    assert(lex_env.one_error(f, "trait", 1, 1, "'trait' is a reserved word"));
    assert(lex_env.one_error(f, "type", 1, 1, "'type' is a reserved word"));
    assert(lex_env.one_error(f, "union", 1, 1, "'union' is a reserved word"));
    assert(lex_env.one_error(f, "yield", 1, 1, "'yield' is a reserved word"));
}

fn a_word_extending_a_reserved_word_is_an_identifier() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.clean(f, "constant types union_ _pub", 4));
    u64 mut i = 0;
    while (i < 4) {
        assert(lex_env.kind(f, i) == "identifier");
        i += 1;
    }
}

// ---- operators and punctuation -------------------------------------------------

// Every operator lexes alone as its own kind, spelled as its name.
fn every_operator_lexes_alone_as_its_kind() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    i64 mut k = cast(lexer.tok_kind.plus, i64);
    i64 last = cast(lexer.tok_kind.at, i64);
    i64 mut seen = 0;
    while (k <= last) {
        string op = lexer.tok_kind_name(cast(k, lexer.tok_kind));
        assert(lex_env.clean(f, op, 1));
        assert(lex_env.kind(f, 0) == op);
        assert(lex_env.text(f, 0) == op);
        assert(lex_env.covers(f, 0, 0, op.len));
        assert(lex_env.at(f, 1, 1, cast(op.len, u32) + 1));
        seen += 1;
        k += 1;
    }
    // The language has fifty-four operator and punctuation tokens.
    assert(seen == 54);
}

fn the_operator_list_of_d2_10() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    // The list, in its order, split across lines of a hundred columns. The
    // kinds are the enum's own order, so the walk below is the list read back.
    assert(lex_env.clean(f, "+ - * / % +% -% *% = += -= *= /= %= +%= -%= *%= &= |= ^= <<= >>=",
                         22));
    u64 mut i = 0;
    i64 mut k = cast(lexer.tok_kind.plus, i64);
    while (i < 22) {
        assert(lex_env.tok(f, i).kind == cast(k, lexer.tok_kind));
        i += 1;
        k += 1;
    }
    assert(lex_env.clean(f, "== != < <= > >= && || ! & | ^ ~ << >> ++ -- ? : . -> .. ...", 23));
    i = 0;
    while (i < 23) {
        assert(lex_env.tok(f, i).kind == cast(k, lexer.tok_kind));
        i += 1;
        k += 1;
    }
    assert(lex_env.clean(f, "( ) [ ] { } , ; @", 9));
    i = 0;
    while (i < 9) {
        assert(lex_env.tok(f, i).kind == cast(k, lexer.tok_kind));
        i += 1;
        k += 1;
    }
    // Twenty-two and twenty-three and nine are the fifty-four. The walk
    // ended one past the last of them.
    assert(k == cast(lexer.tok_kind.at, i64) + 1);
}

// The three-byte operators and the prefixes they extend.
fn three_character_operators_and_their_prefixes() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.clean(f, "+%= +% + -%= -% - *%= *% * <<= << < >>= >> >", 15));
    assert(lex_env.kind(f, 0) == "+%=");
    assert(lex_env.kind(f, 1) == "+%");
    assert(lex_env.kind(f, 2) == "+");
    assert(lex_env.kind(f, 3) == "-%=");
    assert(lex_env.kind(f, 4) == "-%");
    assert(lex_env.kind(f, 5) == "-");
    assert(lex_env.kind(f, 6) == "*%=");
    assert(lex_env.kind(f, 7) == "*%");
    assert(lex_env.kind(f, 8) == "*");
    assert(lex_env.kind(f, 9) == "<<=");
    assert(lex_env.kind(f, 10) == "<<");
    assert(lex_env.kind(f, 11) == "<");
    assert(lex_env.kind(f, 12) == ">>=");
    assert(lex_env.kind(f, 13) == ">>");
    assert(lex_env.kind(f, 14) == ">");
    assert(lex_env.covers(f, 0, 0, 3));
    assert(lex_env.covers(f, 1, 4, 2));
    assert(lex_env.covers(f, 2, 7, 1));
}

// The longest match wins, with no space to separate the operands.
fn longest_match_without_spaces() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.clean(f, "a+%=b", 3));
    assert(lex_env.kind(f, 1) == "+%=");
    assert(lex_env.clean(f, "a+%b", 3));
    assert(lex_env.kind(f, 1) == "+%");
    assert(lex_env.kind(f, 2) == "identifier");
    assert(lex_env.clean(f, "a+b", 3));
    assert(lex_env.kind(f, 1) == "+");
    assert(lex_env.clean(f, "x<<=1", 3));
    assert(lex_env.kind(f, 1) == "<<=");
    assert(lex_env.clean(f, "x>>=1", 3));
    assert(lex_env.kind(f, 1) == ">>=");
    assert(lex_env.clean(f, "p->q", 3));
    assert(lex_env.kind(f, 1) == "->");
    assert(lex_env.clean(f, "a.b", 3));
    assert(lex_env.kind(f, 1) == ".");
    assert(lex_env.clean(f, "a..b", 3));
    assert(lex_env.kind(f, 1) == "..");
    // The lexer reads `...` before `..` before `.`.
    assert(lex_env.clean(f, "a...b", 3));
    assert(lex_env.kind(f, 1) == "...");
    assert(lex_env.covers(f, 1, 1, 3));
}

fn runs_of_operator_characters_split_greedily() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.clean(f, "&&=", 2));
    assert(lex_env.kind(f, 0) == "&&");
    assert(lex_env.kind(f, 1) == "=");
    assert(lex_env.clean(f, "||=", 2));
    assert(lex_env.kind(f, 0) == "||");
    assert(lex_env.kind(f, 1) == "=");
    assert(lex_env.clean(f, "...", 1));
    assert(lex_env.kind(f, 0) == "...");
    assert(lex_env.clean(f, ".. .", 2));
    assert(lex_env.kind(f, 0) == "..");
    assert(lex_env.kind(f, 1) == ".");
    assert(lex_env.clean(f, "===", 2));
    assert(lex_env.kind(f, 0) == "==");
    assert(lex_env.kind(f, 1) == "=");
    assert(lex_env.clean(f, "->>", 2));
    assert(lex_env.kind(f, 0) == "->");
    assert(lex_env.kind(f, 1) == ">");
    assert(lex_env.clean(f, "+++", 2));
    assert(lex_env.kind(f, 0) == "++");
    assert(lex_env.kind(f, 1) == "+");
    assert(lex_env.clean(f, "-->", 2));
    assert(lex_env.kind(f, 0) == "--");
    assert(lex_env.kind(f, 1) == ">");
    // `::` is not a token: the module path separator is `.`.
    assert(lex_env.clean(f, "::", 2));
    assert(lex_env.kind(f, 0) == ":");
    assert(lex_env.kind(f, 1) == ":");
    assert(lex_env.clean(f, ":::", 3));
    assert(lex_env.kind(f, 2) == ":");
    assert(lex_env.clean(f, "<<<=", 2));
    assert(lex_env.kind(f, 0) == "<<");
    assert(lex_env.kind(f, 1) == "<=");
    assert(lex_env.clean(f, "!==", 2));
    assert(lex_env.kind(f, 0) == "!=");
    assert(lex_env.kind(f, 1) == "=");
    assert(lex_env.clean(f, "%%=", 2));
    assert(lex_env.kind(f, 0) == "%");
    assert(lex_env.kind(f, 1) == "%=");
}

fn slash_operators_beside_comments() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.clean(f, "a/=b//c\n/d", 5));
    assert(lex_env.kind(f, 1) == "/=");
    assert(lex_env.kind(f, 3) == "/");
    assert(lex_env.kind(f, 4) == "identifier");
    assert(lex_env.clean(f, "a / b", 3));
    assert(lex_env.kind(f, 1) == "/");
    assert(lex_env.clean(f, "*/", 2));
    assert(lex_env.kind(f, 0) == "*");
    assert(lex_env.kind(f, 1) == "/");
}

// `@` is a one-byte operator token, the span suffix.
fn at_lexes_as_the_span_suffix_token() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.clean(f, "@", 1));
    assert(lex_env.kind(f, 0) == "@");
    assert(lex_env.text(f, 0) == "@");
    assert(lex_env.at(f, 0, 1, 1));
    assert(lex_env.covers(f, 0, 0, 1));
    assert(lex_env.clean(f, "a\n  @ b", 3));
    assert(lex_env.kind(f, 1) == "@");
    assert(lex_env.at(f, 1, 2, 3));
    assert(lex_env.covers(f, 1, 4, 1));
}

fn at_in_a_type_lexes_beside_its_neighbours() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    // A span of writable bytes, `u8 mut@ mut s`.
    assert(lex_env.clean(f, "u8 mut@ mut s", 5));
    assert(lex_env.kind(f, 0) == "u8");
    assert(lex_env.kind(f, 1) == "mut");
    assert(lex_env.kind(f, 2) == "@");
    assert(lex_env.kind(f, 3) == "mut");
    assert(lex_env.kind(f, 4) == "identifier");
    assert(lex_env.covers(f, 2, 6, 1));
    // Reference suffixes may be adjacent and repeat: `node*@`, `u8@*`, `u8@@`.
    assert(lex_env.clean(f, "node*@ u8@* u8@@", 9));
    assert(lex_env.kind(f, 1) == "*");
    assert(lex_env.kind(f, 2) == "@");
    assert(lex_env.kind(f, 4) == "@");
    assert(lex_env.kind(f, 5) == "*");
    assert(lex_env.kind(f, 7) == "@");
    assert(lex_env.kind(f, 8) == "@");
}

// No two-byte operator begins with `@`, so a run splits after each one.
fn at_starts_no_longer_operator() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.clean(f, "@=", 2));
    assert(lex_env.kind(f, 0) == "@");
    assert(lex_env.kind(f, 1) == "=");
    assert(lex_env.clean(f, "@@", 2));
    assert(lex_env.kind(f, 0) == "@");
    assert(lex_env.kind(f, 1) == "@");
    assert(lex_env.clean(f, "a@b", 3));
    assert(lex_env.kind(f, 1) == "@");
    assert(lex_env.kind(f, 2) == "identifier");
    assert(lex_env.clean(f, "x[..]@", 5));
    assert(lex_env.kind(f, 4) == "@");
}

fn at_inside_a_literal_or_a_comment_is_an_ordinary_byte() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    // A string keeps `@` as a byte of its text.
    assert(lex_env.clean(f, "\"a@b\"", 1));
    assert(lex_env.kind(f, 0) == "string literal");
    assert(lex_env.text(f, 0) == "a@b");
    assert(lex_env.clean(f, "\"@\"", 1));
    assert(lex_env.text(f, 0) == "@");
    // A char literal holds its byte value, 0x40.
    assert(lex_env.clean(f, "'@'", 1));
    assert(lex_env.kind(f, 0) == "char literal");
    assert(lex_env.tok(f, 0).ival == 0x40);
    assert(lex_env.covers(f, 0, 0, 3));
    // A comment swallows it.
    assert(lex_env.clean(f, "a // @ @\n@", 2));
    assert(lex_env.kind(f, 0) == "identifier");
    assert(lex_env.kind(f, 1) == "@");
    assert(lex_env.at(f, 1, 2, 1));
}

fn a_statement_lexes_into_the_expected_sequence() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    // An owned span of writable bytes from new(T, n).
    assert(lex_env.clean(f, "u8 mut@ own mut s = new(u8, n +% 1);", 16));
    assert(lex_env.kind(f, 0) == "u8");
    assert(lex_env.kind(f, 1) == "mut");
    assert(lex_env.kind(f, 2) == "@");
    assert(lex_env.kind(f, 3) == "own");
    assert(lex_env.kind(f, 4) == "mut");
    assert(lex_env.kind(f, 5) == "identifier");
    assert(lex_env.kind(f, 6) == "=");
    assert(lex_env.kind(f, 7) == "new");
    assert(lex_env.kind(f, 8) == "(");
    assert(lex_env.kind(f, 9) == "u8");
    assert(lex_env.kind(f, 10) == ",");
    assert(lex_env.kind(f, 11) == "identifier");
    assert(lex_env.kind(f, 12) == "+%");
    assert(lex_env.kind(f, 13) == "integer literal");
    assert(lex_env.kind(f, 14) == ")");
    assert(lex_env.kind(f, 15) == ";");
}

fn every_kind_of_token_in_one_file() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.clean(f, "fn f(x) { s = \"a\"; c = 'b'; n = 1; y = 1.5; }", 23));
    assert(lex_env.kind(f, 0) == "fn");
    assert(lex_env.kind(f, 1) == "identifier");
    assert(lex_env.kind(f, 2) == "(");
    assert(lex_env.kind(f, 8) == "string literal");
    assert(lex_env.kind(f, 12) == "char literal");
    assert(lex_env.kind(f, 16) == "integer literal");
    assert(lex_env.kind(f, 20) == "float literal");
    assert(lex_env.kind(f, 22) == "}");
    assert(lex_env.kind(f, 23) == "end of file");
}

// `$cfg` is one compiler token. A shorter spelling or an identifier extension
// is an error at `$`, not a `$cfg` token followed by an identifier.
fn configuration_token_has_an_exact_identifier_boundary() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.clean(f, "$cfg", 1));
    assert(lex_env.kind(f, 0) == "$cfg");
    assert(lex_env.covers(f, 0, 0, 4));
    assert(lex_env.one_error(f, "$", 1, 1, "unexpected character '$'"));
    assert(lex_env.one_error(f, "$c", 1, 1, "unexpected character '$'"));
    assert(lex_env.one_error(f, "$cf", 1, 1, "unexpected character '$'"));
    assert(lex_env.one_error(f, "$cfgx", 1, 1, "unexpected character '$'"));
}

// `$if` follows the same exact boundary rule as `$cfg`.
fn condition_token_has_an_exact_identifier_boundary() void {
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    assert(lex_env.clean(f, "$if", 1));
    assert(lex_env.kind(f, 0) == "$if");
    assert(lex_env.covers(f, 0, 0, 3));
    assert(lex_env.one_error(f, "$i", 1, 1, "unexpected character '$'"));
    assert(lex_env.one_error(f, "$ifx", 1, 1, "unexpected character '$'"));
}

// ---- kinds and the token vector ------------------------------------------------

fn kind_names_of_the_literal_classes() void {
    assert(lexer.tok_kind_name(lexer.tok_kind.eof) == "end of file");
    assert(lexer.tok_kind_name(lexer.tok_kind.ident) == "identifier");
    assert(lexer.tok_kind_name(lexer.tok_kind.int_lit) == "integer literal");
    assert(lexer.tok_kind_name(lexer.tok_kind.float_lit) == "float literal");
    assert(lexer.tok_kind_name(lexer.tok_kind.char_lit) == "char literal");
    assert(lexer.tok_kind_name(lexer.tok_kind.string_lit) == "string literal");
    assert(lexer.tok_kind_name(lexer.tok_kind.dollar_cfg) == "$cfg");
    assert(lexer.tok_kind_name(lexer.tok_kind.dollar_if) == "$if");
    assert(lexer.tok_kind_name(lexer.tok_kind.kw_own) == "own");
    assert(lexer.tok_kind_name(lexer.tok_kind.plus_wrap_assign) == "+%=");
    // Six literal classes, two compiler forms, forty-one keywords and fifty-four operators.
    assert(cast(lexer.tok_kind.at, i64) + 1 == 6 + 2 + 41 + 54);
}

// No two kinds share a name, which is what lets every assertion above compare
// kinds by their names.
fn kind_names_are_distinct() void {
    i64 last = cast(lexer.tok_kind.at, i64);
    i64 mut a = 0;
    while (a <= last) {
        i64 mut b = a + 1;
        while (b <= last) {
            string one = lexer.tok_kind_name(cast(a, lexer.tok_kind));
            string two = lexer.tok_kind_name(cast(b, lexer.tok_kind));
            assert(one != two);
            b += 1;
        }
        a += 1;
    }
}

// The vector grows and keeps every token, as containers.str_vec does.
fn tokvec_grows_and_keeps_its_tokens() void {
    lexer.tok_vec mut* own v = lexer.tokvec_make();
    defer lexer.tokvec_drop_made(move(v));
    assert(lexer.tokvec_count(v) == 0);
    u64 mut i = 0;
    while (i < 100) {
        lexer.token mut t = lexer.token{};
        t.kind = lexer.tok_kind.int_lit;
        t.ival = i;
        t.off = i * 2;
        lexer.tokvec_push(v, t);
        i += 1;
    }
    assert(lexer.tokvec_count(v) == 100);
    i = 0;
    while (i < 100) {
        assert(lexer.tokvec_at(v, i).ival == i);
        assert(lexer.tokvec_at(v, i).off == i * 2);
        i += 1;
    }
    lexer.tokvec_free(v);
    assert(lexer.tokvec_count(v) == 0);
}

// A reserve large enough for everything that follows grows the vector once,
// which a push into the reserved room must not undo.
fn tokvec_reserve_grows_once() void {
    lexer.tok_vec mut* own v = lexer.tokvec_make();
    defer lexer.tokvec_drop_made(move(v));
    lexer.tokvec_reserve(v, 1000);
    assert(v->items.len >= 1000);
    u64 cap = v->items.len;
    u64 mut i = 0;
    while (i < 1000) {
        lexer.tokvec_push(v, lexer.token{});
        i += 1;
    }
    assert(v->items.len == cap);
    assert(lexer.tokvec_count(v) == 1000);
}

// Truncation drops the tokens after the length and keeps the rest. A length at
// or past the end leaves the vector alone, which is what a resync on the first
// line of a file relies on.
fn tokvec_truncate_drops_the_tail() void {
    lexer.tok_vec mut* own v = lexer.tokvec_make();
    defer lexer.tokvec_drop_made(move(v));
    u64 mut i = 0;
    while (i < 10) {
        lexer.token mut t = lexer.token{};
        t.ival = i;
        lexer.tokvec_push(v, t);
        i += 1;
    }
    lexer.tokvec_truncate(v, 20);
    assert(lexer.tokvec_count(v) == 10);
    lexer.tokvec_truncate(v, 10);
    assert(lexer.tokvec_count(v) == 10);
    lexer.tokvec_truncate(v, 3);
    assert(lexer.tokvec_count(v) == 3);
    assert(lexer.tokvec_at(v, 2).ival == 2);
    lexer.tokvec_truncate(v, 0);
    assert(lexer.tokvec_count(v) == 0);
}

// A long file grows the output vector many times and every token survives it.
fn lexing_a_long_file_grows_the_output() void {
    strbuf.str_buf mut b = strbuf.create();
    defer del(b.data);
    lex_env.env mut* own f = lex_env.make();
    defer lex_env.drop_made(move(f));
    u64 mut i = 0;
    while (i < 500) {
        strbuf.append(&b, "x = x + 1;\n");
        i += 1;
    }
    assert(lex_env.lex(f, strbuf.view(&b)));
    assert(lex_env.count(f) == 3001);
    assert(lex_env.at(f, 3000, 501, 1));
    assert(lex_env.kind(f, 2999) == ";");
    assert(lex_env.at(f, 2999, 500, 10));
    assert(lex_env.covers(f, 2999, 500 * 11 - 2, 1));
    assert(lex_env.errors(f) == 0);
}

// ---- the release of a vector and of a lexer environment ------------------------

// The rounds of a leak probe, the round it samples early, and how far a sample may move.
u64 LEAK_ROUNDS = 200;
u64 LEAK_EARLY = 100;
u64 LEAK_BOUND = 8192;

// The slot that round `round` samples into: 0 for the early round, 1 and 2 for the last two
// rounds, and 3 for a round that samples nothing.
fn leak_slot(u64 round) u64 {
    if (round == LEAK_EARLY) {
        return 0;
    }
    if (round == LEAK_ROUNDS - 2) {
        return 1;
    }
    if (round == LEAK_ROUNDS - 1) {
        return 2;
    }
    return 3;
}

// The smaller of the distances from the early sample to the last two. A leak moves both late
// samples, so the smaller distance costs a probe nothing.
fn moved(u64[3] samples) u64 {
    assert(samples[0] != 0 && samples[1] != 0 && samples[2] != 0);
    u64 one = heap.distance(samples[1], samples[0]);
    u64 other = heap.distance(samples[2], samples[0]);
    if (one < other) {
        return one;
    }
    return other;
}

// The tokens of each round of the vector probe.
u64 LEAK_TOKENS = 1000;

// Each round fills a vector of tokvec_make, empties it with tokvec_free, fills it again and ends
// it with tokvec_drop_made. A deletion of the release of lexer.tokvec_drop, or of its call in
// tokvec_free or in tokvec_drop_made, keeps a block of tokens in each round, and the live view
// of support/heap.ft moves by that much.
fn a_vector_in_an_allocation_leaves_the_heap_where_it_was() void {
    u64[3] mut live_at = {};
    u64 mut round = 0;
    while (round < LEAK_ROUNDS) {
        lexer.tok_vec mut* own v = lexer.tokvec_make();
        u64 mut i = 0;
        while (i < LEAK_TOKENS) {
            lexer.tokvec_push(v, lexer.token{});
            i += 1;
        }
        lexer.tokvec_free(v);
        assert(lexer.tokvec_count(v) == 0);
        i = 0;
        while (i < LEAK_TOKENS) {
            lexer.tokvec_push(v, lexer.token{});
            i += 1;
        }
        lexer.tokvec_drop_made(move(v));
        u64 slot = leak_slot(round);
        if (slot < 3) {
            live_at[slot] = heap.live_view();
        }
        round += 1;
    }
    assert(moved(live_at) < LEAK_BOUND);
}

// Each round lexes a file of string literals with an escape, which the session pool keeps, and
// one error, which the sink records, and ends the environment with lex_env.drop_made. A deletion
// of a release of lex_env.drop, or of its call in lex_env.drop_made, keeps the tokens or the
// session of each round. The four lexer suites share support/lex_env.ft, so this probe holds its
// drop for all four.
fn an_environment_leaves_the_heap_where_it_was() void {
    strbuf.str_buf mut b = strbuf.create();
    defer del(b.data);
    u64 mut i = 0;
    while (i < 100) {
        strbuf.append(&b, "s = \"a\\tb\";\n");
        i += 1;
    }
    strbuf.append(&b, "#\n");
    u64[3] mut live_at = {};
    u64 mut round = 0;
    while (round < LEAK_ROUNDS) {
        lex_env.env mut* own f = lex_env.make();
        assert(!lex_env.lex(f, strbuf.view(&b)));
        assert(lex_env.errors(f) == 1);
        lex_env.drop_made(move(f));
        u64 slot = leak_slot(round);
        if (slot < 3) {
            live_at[slot] = heap.live_view();
        }
        round += 1;
    }
    assert(moved(live_at) < LEAK_BOUND);
}

fn main() i32 {
    empty_file_is_only_eof();
    whitespace_only_file_is_only_eof();
    file_without_trailing_newline();
    eof_sits_after_the_trailing_newline();
    bom_is_skipped_and_takes_no_column();
    cr_is_whitespace();
    tab_counts_as_one_column();
    positions_advance_across_lines();
    line_comment_runs_to_the_end_of_the_line();
    line_comment_at_the_end_of_the_file();
    block_comment_start_is_an_error();
    block_comment_start_is_an_error_wherever_it_stands();
    a_slash_before_a_separated_star_is_a_division();
    line_comments_may_hold_non_ascii_bytes();
    comment_markers_inside_a_line_comment_are_text();
    identifier_forms();
    identifier_text_is_a_view_into_the_source();
    identifiers_have_no_length_limit();
    every_keyword_lexes_as_its_kind();
    the_keyword_list_of_d2_4();
    own_is_a_keyword();
    a_word_extending_a_keyword_is_an_identifier();
    keywords_are_case_sensitive();
    universe_functions_are_not_keywords();
    reserved_words_are_errors();
    a_word_extending_a_reserved_word_is_an_identifier();
    every_operator_lexes_alone_as_its_kind();
    the_operator_list_of_d2_10();
    three_character_operators_and_their_prefixes();
    longest_match_without_spaces();
    runs_of_operator_characters_split_greedily();
    slash_operators_beside_comments();
    at_lexes_as_the_span_suffix_token();
    at_in_a_type_lexes_beside_its_neighbours();
    at_starts_no_longer_operator();
    at_inside_a_literal_or_a_comment_is_an_ordinary_byte();
    a_statement_lexes_into_the_expected_sequence();
    every_kind_of_token_in_one_file();
    configuration_token_has_an_exact_identifier_boundary();
    condition_token_has_an_exact_identifier_boundary();
    kind_names_of_the_literal_classes();
    kind_names_are_distinct();
    tokvec_grows_and_keeps_its_tokens();
    tokvec_reserve_grows_once();
    tokvec_truncate_drops_the_tail();
    lexing_a_long_file_grows_the_output();
    a_vector_in_an_allocation_leaves_the_heap_where_it_was();
    an_environment_leaves_the_heap_where_it_was();
    println("ok");
    return 0;
}
