    "fn chain_alias(nd mut* p, nd mut* q) void { q->n = 1; nd mut* b = p->next->next;",
    "    i32 mut* own k = new(i32); }",
    "fn release_field(hold mut* h, ib mut* q) void { bool b = h->item->c; del(h->item);",
