    "    i32 mut* own k = new(i32); if (p->n == 1) { return; } del(k); }",
    "fn swap_alias(ib mut* p, ib mut* q) void { q->n = 1; i32 a = p->n; p->n = 2;",
    "    i32 mut* own k = new(i32); if (q->n == 1) { return; } del(k); }",
    "fn rename_alias(ib mut* p, ib mut* q) void { p->n = 1; q->n = 2; ib mut* r = q;",
