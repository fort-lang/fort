// The bodies of the typed-value regressions. A second closure keeps the first one below its
// 64 recorded events.
string[39] TYPED_TEXT = {
    "struct int_box { i32 n; }",
    "struct flag_box { bool c; }",
    "struct outer_box { int_box inner; }",
    "struct flag_ref { bool mut* flag; }",
    "fn bool_zero() void { bool mut* own z = new(bool); bool c = *z; del(z);",
    "    assert(c == false); i32 mut* own p = new(i32); }",
    "fn zero_decides() void { i32 mut* own z = new(i32); i32 n = *z; del(z);",
    "    i32 mut* own p = new(i32); if (n != 0) { del(p); } }",
    "fn stale_copy() void { int_box mut b = int_box{}; b.n = 1; int_box a = b;",
    "    i32 mut* own p = new(i32); if (a.n == 0) { return; } del(p); }",
    "fn exact_copy() void { int_box mut b = int_box{}; b.n = 1; int_box a = b;",
    "    i32 mut* own p = new(i32); if (a.n == 1) { return; } del(p); }",
    "fn copy_snapshot() void { int_box mut b = int_box{}; int_box a = b; b.n = 1;",
    "    i32 mut* own p = new(i32); if (a.n == 0) { return; } del(p); }",
    "fn nested_stale(int_box q) void { outer_box mut o = outer_box{}; o.inner = q;",
    "    i32 mut* own p = new(i32); if (o.inner.n == 0) { return; } del(p); }",
    "fn leaf_alias(flag_ref a) void { flag_ref b = a; *a.flag = false;",
    "    i32 mut* own p = new(i32); assert(*b.flag); }",
    "fn leaf_identity(flag_ref a) void { flag_ref b = a; *a.flag = true;",
    "    i32 mut* own p = new(i32); assert(*b.flag); }",
    "fn self_compare(i32 n) void { assert(n != n); i32 mut* own p = new(i32); }",
    "fn self_equal(i32 n) void { assert(n == n); i32 mut* own p = new(i32); }",
    "fn null_compare() void { i32* a = null; i32* b = null; assert(a != b);",
    "    i32 mut* own p = new(i32); }",
    "fn free_compare(i32* q) void { assert(*q != *q); i32 mut* own p = new(i32); }",
    "fn null_then_read(i32* q) void { assert(q == null); i32 x = *q;",
    "    i32 mut* own p = new(i32); }",
    "fn first_invalid() i32 { i32* a = null; i32 mut* own b = new(i32); i32* v = b; del(b);",
    "    i32 n = *a +% *v; return n; }",
    "fn later_invalid() i32 { i32 x = 1; i32* a = &x; i32 mut* own b = new(i32); i32* v = b;",
    "    del(b); i32 n = *a +% *v; return n; }",
    "fn zero_field(outer_box mut o) void { o.inner = int_box{}; i32 mut* own p = new(i32);",
    "    if (o.inner.n == 0) { return; } del(p); }",
    "fn null_address() void { flag_box* n = null; bool* q = &n->c; i32 mut* own k = new(i32);",
    "    assert(*q); }",
    "fn wrap_positive() void { i32 mut* own p = new(i32); u8 a = 255; u8 b = 1; u8 n = a +% b;",
    "    if (n != 0) { del(p); } }",
    "fn wrap_signed() void { i32 mut* own p = new(i32); i8 a = 127; i8 b = 1; i8 n = a +% b;",
    "    if (n != -128) { del(p); } }",
};

string[19] TYPED_NAMES = {"bool_zero", "zero_decides", "stale_copy", "exact_copy",
    "copy_snapshot", "nested_stale", "leaf_alias", "leaf_identity", "self_compare", "self_equal",
    "null_compare", "free_compare", "null_then_read", "first_invalid", "later_invalid",
    "zero_field", "null_address", "wrap_positive", "wrap_signed"};

// The bodies of the alias, address, step, copy and return rules. A third closure keeps each
// closure below its 64 recorded events.
string[68] RULES_TEXT = {
    "struct ib { i32 n; bool c; }",
    "struct nd { nd mut* next; i32 n; }",
    "struct pr { ib mut* a; ib mut* b; }",
    "struct cell { i32* ptr; }",
    "struct holder { i32 mut* own item; }",
    "struct wide { u64[16] v; }",
    "struct huge { u8[1100] v; }",
    "i32 mut LIMIT = 4;",
    "fn al(ib mut* p, ib mut* q) void { p->n = 1; q->n = 2; i32 mut* own k = new(i32);",
    "    if (p->n == 1) { return; } del(k); }",
    "fn al_next(nd mut* p) void { nd mut* r = p->next; p->n = 1; r->n = 2;",
    "    i32 mut* own k = new(i32); if (p->n == 1) { return; } del(k); }",
    "fn copy_alias(ib mut* p, ib mut* q) void { q->n = 2; ib z = ib{}; *p = z;",
    "    i32 mut* own k = new(i32); if (q->n == 2) { return; } del(k); }",
    "fn width_alias(ib mut* p, i32 mut* q) void { p->n = 1; *q = 2; i32 mut* own k = new(i32);",
    "    if (p->n == 1) { return; } del(k); }",
    "fn leaf_alias(pr r) void { r.a->n = 1; r.b->n = 2; i32 mut* own k = new(i32);",
    "    if (r.a->n == 1) { return; } del(k); }",
    "fn equal_alias(nd mut* p, nd mut* q) void { nd mut* a = p->next; i32 x = a->n;",
    "    q->next = null; i32 mut* own k = new(i32); if (a == p->next) { return; } del(k); }",
    "fn use_alias(cell mut* p, cell mut* q) i32 { i32 local = 3; i32 mut* own a = new(i32);",
    "    i32* v = a; p->ptr = v; q->ptr = &local; del(a); return *p->ptr; }",
    "fn one_input(ib mut* p) void { p->n = 1; p->c = true; i32 mut* own k = new(i32);",
    "    if (p->n == 1) { return; } del(k); }",
    "fn read_inputs(ib* p, ib* q) void { i32 a = p->n; i32 b = q->n; i32 mut* own k = new(i32); }",
    "fn local_after_store(ib mut* p, ib mut* q) void { p->n = 1; q->n = 2; i32 x = 1;",
    "    i32 mut* own k = new(i32); if (x == 1) { return; } del(k); }",
    "fn fresh_after_store(ib mut* p, ib mut* q) void { ib mut* own f = new(ib); f->n = 1;",
    "    p->n = 1; q->n = 2; i32 mut* own k = new(i32); if (f->n == 1) { del(f); return; }",
    "    del(f); del(k); }",
    "fn addr_only(ib* p, bool c) void { bool* q = &p->c; i32 mut* own k = new(i32);",
    "    if (p != null) { return; } del(k); }",
    "fn addr_fresh() void { ib mut* own f = new(ib); bool* q = &f->c; i32 mut* own k = new(i32);",
    "    if (*q) { del(f); del(k); return; } del(f); }",
    "fn addr_read(ib* p) void { i32 x = p->n; bool* q = &p->c; i32 mut* own k = new(i32);",
    "    if (p != null) { return; } del(k); }",
    "fn store_out(holder mut* h) void { i32 mut* own old = move(h->item); del(old);",
    "    h->item = new(i32); }",
    "fn store_moved(holder mut* h) void { i32 mut* own old = move(h->item); del(old);",
    "    h->item = new(i32); i32 mut* own b = move(h->item); }",
    "fn loop_twice() void { i32 mut* own k = new(i32); u32 mut i = 0; while (i < 2) { i += 1; } }",
    "fn loop_zero() void { i32 mut* own k = new(i32); u32 mut i = 0; while (i > 0) { i -= 1; } }",
    "fn copy_wide() void { wide a = wide{}; wide b = a; i32 mut* own k = new(i32); }",
    "fn copy_none() void { wide a = wide{}; i32 mut* own k = new(i32); }",
    "fn copy_huge() void { huge a = huge{}; huge b = a; i32 mut* own k = new(i32); }",
    "fn global_read() void { i32 x = LIMIT; i32 mut* own k = new(i32); }",
    "fn literal_stop() void { ib b = ib{1, true}; i32 mut* own k = new(i32); }",
    "fn overwrite_view() void { i32 mut* own a = new(i32); i32* mut v = a; v = null; del(a); }",
    "fn true_branch(bool c) void { i32 mut* own k = new(i32); if (c) { return; } del(k); }",
    "fn zero_alias(ib mut* p, ib mut* q) void { q->n = 1; *p = ib{}; i32 mut* own k = new(i32);",
    "    if (q->n == 1) { return; } del(k); }",
    "fn release_alias(ib mut* own p, ib mut* q) void { bool b = p->c; del(p); q->n = 1;",
    "    i32 mut* own k = new(i32); if (q->n == 1) { return; } del(k); }",
    "struct duo { i32 mut* own left; }",
    "struct d1 { i32 v; }",
    "struct d2 { d1 a; }",
    "struct d3 { d2 a; }",
    "struct d4 { d3 a; }",
    "struct d5 { d4 a; }",
    "struct d6 { d5 a; }",
    "struct d7 { d6 a; }",
    "fn overwrite_live() void { i32 mut* own mut p = new(i32); p = new(i32); del(p); }",
    "fn owning_copy() void { duo mut a = duo{}; duo b = move(a); i32 mut* own k = new(i32); }",
    "fn deep_read() void { d7 x = d7{}; i32 v = x.a.a.a.a.a.a.v; i32 mut* own k = new(i32); }",
    "fn shallow_read() void { d6 x = d6{}; i32 v = x.a.a.a.a.a.v; i32 mut* own k = new(i32); }",
    "struct ha { i32[2] v; }",
    "fn arr_alias(ha mut* p, i32 mut* q) void { *q = 2; ha z = ha{}; p->v = z.v;",
    "    i32 mut* own k = new(i32); if (*q == 2) { return; } del(k); }",
};

