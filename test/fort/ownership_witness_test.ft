// The bodies of the branch-note forms. `demo` is the body of the review probe `heapboth.ft`,
// the `iu_` bodies those of `probes3.ft`, `both_` those of `probes4.ft`, `d` and `e` those of
// `dfr.ft`, and `two` and `sw` those of `child.ft`. A fourth closure keeps each closure below
// its 64 recorded events.
string[29] NOTES_TEXT = {
    "struct node { i32 mut* own child; }",
    "fn demo(bool c) i32 { node mut* own parent = new(node); parent->child = new(i32);",
    "    i32 mut x = 0; if (c) { x = 1; } else { x = 2; } del(parent); return x; }",
    "struct ib { i32 n; bool c; }",
    "fn iu_view(bool c) i32 { i32 mut* own p = new(i32); i32* v = p; if (c) { del(p); return *v; }",
    "    del(p); return 0; }",
    "fn iu_after(bool c) i32 { ib mut* own p = new(ib); ib* v = p; if (c) { del(p); }",
    "    else { del(p); } return v->n; }",
    "fn iu_switch(u8 c) i32 { i32 mut* own p = new(i32); i32* v = p; switch (c) {",
    "    case 3: del(p); return *v;",
    "    default: del(p); return 0; } }",
    "fn both_leak(bool c) void { i32 mut* own k = new(i32); i32 mut x = 0;",
    "    if (c) { x = 1; } else { x = 2; } }",
    "fn both_switch(u8 c) i32 { i32 mut* own k = new(i32); i32 mut x = 0;",
    "    switch (c) { case 1: x = 1; default: x = 2; } return x; }",
    "fn arm_leak(bool c) void { if (c) { i32 mut* own k = new(i32); } }",
    "fn arm_false(bool c) void { if (c) { return; } i32 mut* own k = new(i32); }",
    "fn arm_case(u8 c) void { switch (c) { case 4: { i32 mut* own k = new(i32); } default: {} } }",
    "fn arm_other(u8 c) void { switch (c) { case 4: {} default: { i32 mut* own k = new(i32); } } }",
    "fn d(bool c) i32 { node mut* own parent = new(node); parent->child = new(i32);",
    "    defer del(parent); if (c) { return 1; } return 0; }",
    "fn e(u8 c) i32 { node mut* own parent = new(node); parent->child = new(i32);",
    "    defer del(parent); switch (c) { case 1: { return 1; } default: { return 0; } } }",
    "fn two(bool c) i32 { node mut* own parent = new(node); parent->child = new(i32);",
    "    if (c) { del(parent); return 1; } del(parent); return 0; }",
    "fn sw(u8 c) i32 { node mut* own parent = new(node); parent->child = new(i32);",
    "    switch (c) { case 1: { del(parent); return 1; } default: { del(parent); return 0; } } }",
    "fn other_both(u8 c) void { i32 mut* own k = new(i32); i32 mut x = 0;",
    "    switch (c) { case 1: { if (x == 0) { x = 1; } } default: {} } }",
};

// The return rule without a release of the loaded owner. A sixth closure keeps each closure
// below its 64 recorded events.
string[5] RETURN_TEXT = {
    "struct holder { i32 mut* own item; }",
    "fn store_kept(holder mut* h) void { i32 mut* own old = move(h->item);",
    "    h->item = new(i32); }",
    "fn store_taken(holder mut* h) void { i32 mut* own old = move(h->item);",
    "    h->item = new(i32); i32 mut* own b = move(h->item); }",
};

string[2] RETURN_NAMES = {"store_kept", "store_taken"};

string[15] NOTES_NAMES = {"demo", "iu_view", "iu_after", "iu_switch", "both_leak",
    "both_switch", "arm_leak", "arm_false", "arm_case", "arm_other", "d", "e", "two", "sw",
    "other_both"};

// The bodies of the alias pairs, the note names and the X step of a condition. A fifth closure
