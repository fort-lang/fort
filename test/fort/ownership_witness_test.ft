// The bodies of the branch-note forms. `demo` is the body of the review probe `heapboth.ft`,
// the `iu_` bodies those of `probes3.ft`, `both_` those of `probes4.ft`, `d` and `e` those of
// `dfr.ft`, and `two` and `sw` those of `child.ft`. A fourth closure keeps each closure below
// its 64 recorded events.
string[29] NOTES_TEXT = {
    "struct node { i32 mut* own child; }",
    "fn demo(bool c) i32 { node mut* own parent = new(node); parent->child = new(i32);",
    "    i32 mut x = 0; if (c) { x = 1; } else { x = 2; } del(parent); return x; }",
    "struct ib { i32 n; bool c; }",
    "fn iu_view(bool c) i32 { i32 mut* own p = new(i32); i32* v = p; if (c) { del(p); return *v; }",
    "    del(p); return 0; }",
    "fn iu_after(bool c) i32 { ib mut* own p = new(ib); ib* v = p; if (c) { del(p); }",
    "    else { del(p); } return v->n; }",
    "fn iu_switch(u8 c) i32 { i32 mut* own p = new(i32); i32* v = p; switch (c) {",
    "    case 3: del(p); return *v;",
    "    default: del(p); return 0; } }",
    "fn both_leak(bool c) void { i32 mut* own k = new(i32); i32 mut x = 0;",
    "    if (c) { x = 1; } else { x = 2; } }",
    "fn both_switch(u8 c) i32 { i32 mut* own k = new(i32); i32 mut x = 0;",
    "    switch (c) { case 1: x = 1; default: x = 2; } return x; }",
    "fn arm_leak(bool c) void { if (c) { i32 mut* own k = new(i32); } }",
    "fn arm_false(bool c) void { if (c) { return; } i32 mut* own k = new(i32); }",
    "fn arm_case(u8 c) void { switch (c) { case 4: { i32 mut* own k = new(i32); } default: {} } }",
    "fn arm_other(u8 c) void { switch (c) { case 4: {} default: { i32 mut* own k = new(i32); } } }",
    "fn d(bool c) i32 { node mut* own parent = new(node); parent->child = new(i32);",
    "    defer del(parent); if (c) { return 1; } return 0; }",
    "fn e(u8 c) i32 { node mut* own parent = new(node); parent->child = new(i32);",
    "    defer del(parent); switch (c) { case 1: { return 1; } default: { return 0; } } }",
    "fn two(bool c) i32 { node mut* own parent = new(node); parent->child = new(i32);",
    "    if (c) { del(parent); return 1; } del(parent); return 0; }",
    "fn sw(u8 c) i32 { node mut* own parent = new(node); parent->child = new(i32);",
    "    switch (c) { case 1: { del(parent); return 1; } default: { del(parent); return 0; } } }",
    "fn other_both(u8 c) void { i32 mut* own k = new(i32); i32 mut x = 0;",
    "    switch (c) { case 1: { if (x == 0) { x = 1; } } default: {} } }",
};

string[15] NOTES_NAMES = {"demo", "iu_view", "iu_after", "iu_switch", "both_leak",
    "both_switch", "arm_leak", "arm_false", "arm_case", "arm_other", "d", "e", "two", "sw",
    "other_both"};

// The producer rule `ownership_source_calls.sole_candidate` over the recorded events: `event`
// names an allocation, and no candidate of body `index` at another operation names it.
fn sole(ownership_heap_env.closure* c, u64 index, ownership_heap_env.event_row event) bool {
    if (event.relation.kind != ownership_api.entity_kind.allocation) { return false; }
    u32 declaration = cast(index + 1, u32);
    u64 mut i = 0;
    while (i < c->counts.events && i < c->counts.rows.len) {
        ownership_heap_env.event_row other = c->counts.rows[i];
        bool candidate = other.reason == ownership_api.incomplete_reason.missing_path ||
            other.kind == ownership_api.event_kind.invalid_use ||
            other.kind == ownership_api.event_kind.lost_ownership ||
            other.kind == ownership_api.event_kind.caller_requirement;
        if (other.operation.function.declaration.declaration == declaration && candidate &&
            ownership_keys.entity(other.relation, event.relation) == 0 &&
            ownership_keys.operation(other.operation, event.operation) != 0) { return false; }
        i += 1;
    }
    return true;
}

fn candidate(ownership_heap_env.closure mut* c, string name, u64 bound)
    ownership_witness.result {
    ownership_heap_env.event_row event = ownership_heap_env.first(c, name);
    ownership_api.event_descriptor mut item = ownership_api.event_descriptor{};
    item.operation = event.operation;
    item.kind = event.kind;
    item.relation = event.relation;
    item.text = ownership_heap_env.text(&event);
    u64 index = ownership_heap_env.index(c, name);
    ownership_witness.request query = ownership_witness.request{&c->functions[index],
        ownership_heap_env.summary(c, name), &item, c->files[..], bound, sole(c, index, event)};
    return ownership_witness.check(&query);
}

fn candidate_kind(ownership_heap_env.closure mut* c, string name,
    ownership_api.event_kind kind) ownership_witness.result {
    u64 index = ownership_heap_env.index(c, name);
    u32 declaration = cast(index + 1, u32);
    u64 mut i = 0;
    while (i < c->counts.events && i < c->counts.rows.len) {
        ownership_heap_env.event_row event = c->counts.rows[i];
        if (event.operation.function.declaration.declaration == declaration &&
            event.kind == kind) {
            ownership_api.event_descriptor mut item = ownership_api.event_descriptor{};
            item.operation = event.operation;
            item.kind = event.kind;
            item.relation = event.relation;
            item.text = ownership_heap_env.text(&event);
            ownership_witness.request query = ownership_witness.request{&c->functions[index],
                ownership_heap_env.summary(c, name), &item, c->files[..],
                ownership_witness.PRODUCTION_X, sole(c, index, event)};
            return ownership_witness.check(&query);
        }
        i += 1;
    }
    panic("candidate_kind: no event");
}

fn return_candidate(ownership_heap_env.closure mut* c, string name, string text,
    u32 fallback_relation)
    ownership_witness.result {
    u64 index = ownership_heap_env.index(c, name);
    fir.func* body = &c->functions[index];
    ownership_api.event_descriptor mut item = ownership_api.event_descriptor{};
    item.kind = ownership_api.event_kind.lost_ownership;
    item.text = text;
    u32 declaration = cast(index + 1, u32);
    u64 mut event_index = 0;
    while (event_index < c->counts.events && event_index < c->counts.rows.len) {
        ownership_heap_env.event_row event = c->counts.rows[event_index];
        if (event.operation.function.declaration.declaration == declaration &&
            event.kind == ownership_api.event_kind.lost_ownership &&
            ownership_heap_env.text(&event) == text) {
            item.relation = event.relation;
            break;
        }
        event_index += 1;
    }
    if (item.relation.kind != ownership_api.entity_kind.allocation && fallback_relation != 0) {
        item.relation = ownership_api.entity_id{.kind = ownership_api.entity_kind.allocation,
            .ordinal = fallback_relation};
    }
    u32 mut block = 0;
    while (block < fir.block_count(body)) {
        fir.terminator* term = &fir.block_at(body, block)->term;
        if (term->kind == fir.term_kind.tk_return) {
            item.operation = ownership_api.operation_position{.block = block,
                .operation = fir.block_statement_count(body, block), .terminator = true};
            item.source = ownership_api.source_position{.line = term->loc.line,
                .col = term->loc.col};
            ownership_witness.request query = ownership_witness.request{body,
                ownership_heap_env.summary(c, name), &item, c->files[..],
                ownership_witness.PRODUCTION_X, false};
            return ownership_witness.check(&query);
        }
        block += 1;
    }
    panic("return_candidate: no return");
}

fn text_candidate(ownership_heap_env.closure mut* c, string name, string text)
    ownership_witness.result {
    ownership_heap_env.event_row event = ownership_heap_env.first(c, name);
    ownership_api.event_descriptor mut item = ownership_api.event_descriptor{};
    item.operation = event.operation;
    item.kind = event.kind;
    item.text = text;
    u64 index = ownership_heap_env.index(c, name);
    ownership_witness.request query = ownership_witness.request{&c->functions[index],
        ownership_heap_env.summary(c, name), &item, c->files[..],
        ownership_witness.PRODUCTION_X, false};
    return ownership_witness.check(&query);
}

fn complete_bool_otherwise(ownership_heap_env.closure mut* c) void {
    u64 index = ownership_heap_env.index(c, "false_branch");
    fir.func* body = &c->functions[index];
    fir.terminator* mut selected = null;
    u32 mut block = 0;
    while (block < fir.block_count(body)) {
        fir.terminator* term = &fir.block_at(body, block)->term;
        if (term->kind == fir.term_kind.tk_switch) { selected = term; break; }
        block += 1;
    }
    assert(selected != null && selected->cond.kind != fir.operand_kind.ok_const);
    u32 param = selected->cond.place.local;
    ownership_witness.request query = ownership_witness.request{.body = body,
        .bound = ownership_witness.PRODUCTION_X};
    ownership_witness.exact_state mut path = ownership_witness.exact_state{.input = &query};
    defer ownership_witness.state_free(&path);
    assert(ownership_witness.start(&path, selected->otherwise));
    fir_flow.bits_free(&path.toward);
    path.toward = fir_flow.bits_new(fir.block_count(body));
    fir_flow.bits_set(&path.toward, selected->otherwise);
    assert(ownership_witness.exclude_choice(&path, param, consts.cv_from_bool(false)));
    assert(ownership_witness.exclude_choice(&path, param, consts.cv_from_bool(true)));
    u32 mut next = 0;
    assert(!ownership_witness.choose(&path, selected, &next));
}

fn exact_paths(ownership_heap_env.closure mut* c) void {
    ownership_witness.result mut straight = candidate(c, "straight",
        ownership_witness.PRODUCTION_X);
    defer ownership_witness.free(&straight);
    assert(straight.verdict == ownership_witness.status.validated);
    assert(straight.conditions_len == 0 && straight.used > 0);

    ownership_witness.result mut decided = candidate(c, "decided",
        ownership_witness.PRODUCTION_X);
    defer ownership_witness.free(&decided);
    assert(decided.verdict == ownership_witness.status.validated);
    assert(decided.conditions_len == 0);

    ownership_witness.result mut checked = candidate(c, "checked_true",
        ownership_witness.PRODUCTION_X);
    defer ownership_witness.free(&checked);
    assert(checked.verdict == ownership_witness.status.validated);
    assert(checked.conditions_len == 0);

    ownership_witness.result mut null_read = candidate(c, "null_first",
        ownership_witness.PRODUCTION_X);
    defer ownership_witness.free(&null_read);
    assert(null_read.verdict == ownership_witness.status.rejected);
    assert(null_read.conditions_len == 0);

    ownership_witness.result mut casted = candidate(c, "cast_stop",
        ownership_witness.PRODUCTION_X);
    defer ownership_witness.free(&casted);
    assert(casted.verdict == ownership_witness.status.rejected);

    string[4] conservative = {"single", "narrow_branch", "element_index", "narrow"};
    for (string name : conservative) {
        ownership_witness.result mut got = candidate(c, name, ownership_witness.PRODUCTION_X);
        assert(got.verdict == ownership_witness.status.rejected);
        ownership_witness.free(&got);
    }

    ownership_witness.result mut stopped = candidate(c, "after_call",
        ownership_witness.PRODUCTION_X);
    defer ownership_witness.free(&stopped);
    assert(stopped.verdict == ownership_witness.status.rejected);
    assert(stopped.conditions_len == 0);

    ownership_witness.result mut absent = candidate(c, "no_loss",
        ownership_witness.PRODUCTION_X);
    defer ownership_witness.free(&absent);
    assert(absent.verdict == ownership_witness.status.rejected);

    string[3] exact_regressions = {"wrap_width", "distinct_labels", "otherwise_exclusion"};
    for (string name : exact_regressions) {
        ownership_witness.result mut got = candidate(c, name, ownership_witness.PRODUCTION_X);
        assert(got.verdict == ownership_witness.status.rejected);
        ownership_witness.free(&got);
    }

    ownership_heap_env.event_row field_event = ownership_heap_env.first(c, "one_field");
    assert(ownership_heap_env.text(&field_event) == "p->left");
    ownership_witness.result mut right = candidate(c, "one_field",
        ownership_witness.PRODUCTION_X);
    defer ownership_witness.free(&right);
    assert(right.verdict == ownership_witness.status.validated);
    ownership_api.event_descriptor mut sibling = ownership_api.event_descriptor{};
    sibling.operation = field_event.operation;
    sibling.kind = field_event.kind;
    sibling.text = "p->right";
    u64 field_index = ownership_heap_env.index(c, "one_field");
    ownership_witness.request field_query = ownership_witness.request{&c->functions[field_index],
        ownership_heap_env.summary(c, "one_field"), &sibling, c->files[..],
        ownership_witness.PRODUCTION_X, false};
    ownership_witness.result mut wrong_field = ownership_witness.check(&field_query);
    defer ownership_witness.free(&wrong_field);
    assert(wrong_field.verdict == ownership_witness.status.rejected);

    ownership_heap_env.event_row event = ownership_heap_env.first(c, "straight");
    ownership_api.event_descriptor mut wrong = ownership_api.event_descriptor{};
    wrong.operation = event.operation;
    wrong.operation.operation += 1;
    wrong.kind = event.kind;
    u64 index = ownership_heap_env.index(c, "straight");
    ownership_witness.request query = ownership_witness.request{&c->functions[index],
        ownership_heap_env.summary(c, "straight"), &wrong, c->files[..],
        ownership_witness.PRODUCTION_X, false};
    ownership_witness.result mut mismatch = ownership_witness.check(&query);
    defer ownership_witness.free(&mismatch);
    assert(mismatch.verdict == ownership_witness.status.rejected);
    println("exact paths ok");
}

fn rendered_condition(ownership_witness.condition* item, string expected) void {
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    ownership_report.witness_condition(item, &text);
    if (strbuf.view(&text) != expected) {
        eprintln("condition: ", strbuf.view(&text));
        assert(false);
    }
}

fn rendered_condition2(ownership_witness.condition* item, string first, string second) void {
    strbuf.str_buf mut expected = strbuf.create();
    defer strbuf.free(&expected);
    strbuf.append(&expected, first);
    strbuf.append(&expected, second);
    rendered_condition(item, strbuf.view(&expected));
}

fn exact_storage_field(ownership_heap_env.closure mut* c) void {
    u64 index = ownership_heap_env.index(c, "storage_field");
    fir.func* body = &c->functions[index];
    u32 mut local = 0;
    while (local < fir.local_count(body) &&
        fir.local_name(fir.local_at(body, local)) != "value") { local += 1; }
    assert(local < fir.local_count(body));
    ownership_api.event_descriptor mut event = ownership_api.event_descriptor{};
    event.text = "value.right";
    ownership_witness.request query = ownership_witness.request{body,
        ownership_heap_env.summary(c, "storage_field"), &event, c->files[..],
        ownership_witness.PRODUCTION_X, false};
    ownership_witness.exact_state state = ownership_witness.exact_state{.input = &query};
    ownership_witness.storage_key mut key = ownership_witness.storage_key{
        .kind = ownership_witness.storage_kind.local, .root = local, .depth = 1};
    key.path[0] = 0;
    ownership_witness.slot left = ownership_witness.slot{.key = key,
        .ty = fir.struct_field_type(fir.local_at(body, local)->ty, 0)};
    assert(!ownership_witness.candidate_slot(&state, left));
    event.text = "value.left";
    assert(ownership_witness.candidate_slot(&state, left));
}

fn review_regressions(ownership_heap_env.closure mut* c) void {
    string[2] rejected_returns = {"aggregate_replace", "return_tree"};
    string[2] texts = {"p", "p->next"};
    u32[2] relations = {0, 2};
    u64 mut i = 0;
    while (i < rejected_returns.len) {
        ownership_witness.result mut got = return_candidate(c, rejected_returns[i], texts[i],
            relations[i]);
        assert(got.verdict == ownership_witness.status.rejected);
        ownership_witness.free(&got);
        i += 1;
    }

    ownership_witness.result mut alias = candidate(c, "alias_copy",
        ownership_witness.PRODUCTION_X);
    defer ownership_witness.free(&alias);
    assert(alias.verdict == ownership_witness.status.validated);

    exact_storage_field(c);

    complete_bool_otherwise(c);

    ownership_witness.result mut nested = return_candidate(c, "nested_read", "p", 0);
    defer ownership_witness.free(&nested);
    assert(nested.verdict == ownership_witness.status.validated);
    assert(nested.conditions_len == 3);
    rendered_condition(&nested.conditions[0],
        "this path needs 'pp' to be non-null here; a null 'pp' faults at this read first");
    rendered_condition(&nested.conditions[1],
        "this path needs '*(pp)' to be non-null here; a null '*(pp)' faults at this read first");
    rendered_condition2(&nested.conditions[2],
        "this path needs '(*(*(pp))).next' to be non-null ",
        "here; a null '(*(*(pp))).next' faults at this read first");

    ownership_witness.result mut branch = candidate(c, "false_branch",
        ownership_witness.PRODUCTION_X);
    defer ownership_witness.free(&branch);
    assert(branch.verdict == ownership_witness.status.validated && branch.conditions_len == 1);
    // The true arm releases `p` and then reaches the same storage end, so the note states only
    // the selected outcome.
    rendered_condition(&branch.conditions[0], "this path needs the condition here to be false");

    ownership_witness.result mut selected = candidate(c, "switch_case",
        ownership_witness.PRODUCTION_X);
    defer ownership_witness.free(&selected);
    assert(selected.verdict == ownership_witness.status.validated && selected.conditions_len == 1);
    rendered_condition2(&selected.conditions[0],
        "this path needs the switch here to select case ",
        "i32 2; other switch outcomes do not reach the leak");

    ownership_witness.result mut other = candidate(c, "switch_other",
        ownership_witness.PRODUCTION_X);
    defer ownership_witness.free(&other);
    assert(other.verdict == ownership_witness.status.validated && other.conditions_len == 1);
    rendered_condition2(&other.conditions[0],
        "this path needs the switch here to select ",
        "otherwise; the listed cases do not reach the leak");
}

fn latest_review_regressions(ownership_heap_env.closure mut* c) void {
    bool mut failed = false;
    string[2] stopped = {"unsupported_bitwise", "scalar_zero"};
    u64 mut i = 0;
    while (i < stopped.len) {
        ownership_witness.result mut got = candidate(c, stopped[i],
            ownership_witness.PRODUCTION_X);
        if (got.verdict != ownership_witness.status.rejected) {
            eprintln("red ", stopped[i]);
            failed = true;
        }
        ownership_witness.free(&got);
        i += 1;
    }

    ownership_witness.result mut aggregate = candidate_kind(c, "aggregate_zero",
        ownership_api.event_kind.lost_ownership);
    if (aggregate.verdict != ownership_witness.status.rejected) {
        eprintln("red aggregate_zero");
        failed = true;
    }
    ownership_witness.free(&aggregate);

    string[2] invalid_addresses = {"released_address", "ended_address"};
    i = 0;
    while (i < invalid_addresses.len) {
        ownership_witness.result mut got = candidate(c, invalid_addresses[i],
            ownership_witness.PRODUCTION_X);
        if (got.verdict != ownership_witness.status.validated) {
            eprintln("red ", invalid_addresses[i]);
            failed = true;
        }
        ownership_witness.free(&got);
        i += 1;
    }

    ownership_heap_env.event_row event = ownership_heap_env.first(c, "wrong_invalid_source");
    assert(event.kind == ownership_api.event_kind.invalid_use);
    ownership_api.event_descriptor mut wrong = ownership_api.event_descriptor{};
    wrong.operation = event.operation;
    wrong.kind = event.kind;
    wrong.relation = event.relation;
    wrong.relation.ordinal += 1;
    wrong.text = "b";
    u64 index = ownership_heap_env.index(c, "wrong_invalid_source");
    ownership_witness.request query = ownership_witness.request{&c->functions[index],
        ownership_heap_env.summary(c, "wrong_invalid_source"), &wrong, c->files[..],
        ownership_witness.PRODUCTION_X, false};
    ownership_witness.result mut mismatch = ownership_witness.check(&query);
    defer ownership_witness.free(&mismatch);
    if (mismatch.verdict != ownership_witness.status.rejected) {
        eprintln("red candidate_identity");
        failed = true;
    }

    ownership_witness.result mut refill = candidate(c, "refill_source",
        ownership_witness.PRODUCTION_X);
    if (refill.verdict != ownership_witness.status.validated) {
        eprintln("red remapped_identity");
        failed = true;
    }
    ownership_witness.free(&refill);

    ownership_api.event_descriptor mut residual = ownership_api.event_descriptor{};
    residual.kind = ownership_api.event_kind.lost_ownership;
    residual.relation = ownership_api.entity_id{.kind = ownership_api.entity_kind.allocation,
        .ordinal = 2};
    ownership_witness.request residual_query = ownership_witness.request{.candidate = &residual};
    ownership_witness.exact_state mut residual_state = ownership_witness.exact_state{
        .input = &residual_query};
    residual_state.allocations = new(ownership_witness.allocation, 2);
    residual_state.allocations_len = 2;
    residual_state.allocations[0] = ownership_witness.allocation{true, true, false, 1};
    residual_state.allocations[1] = ownership_witness.allocation{false, false, false, 2};
    if (ownership_witness.return_loses(&residual_state)) {
        eprintln("red residual_identity");
        failed = true;
    }
    ownership_witness.state_free(&residual_state);
    assert(!failed);
}

fn one_condition(ownership_heap_env.closure mut* c, string name,
    ownership_witness.condition_kind kind, bool input) void {
    ownership_witness.result mut got = candidate(c, name, ownership_witness.PRODUCTION_X);
    defer ownership_witness.free(&got);
    assert(got.verdict == ownership_witness.status.validated);
    assert(got.conditions_len == 1);
    assert(got.conditions[0].kind == kind && got.conditions[0].input == input);
}

// Each undecided step of a real path records its row, and the report renders each row in the
// words that the user ruled.
fn conditions(ownership_heap_env.closure mut* c) void {
    one_condition(c, "branch", ownership_witness.condition_kind.input_branch, true);
    one_condition(c, "checked", ownership_witness.condition_kind.check_passes, true);
    one_condition(c, "read_first", ownership_witness.condition_kind.nonnull, true);
    string[2] names = {"checked", "read_first"};
    string[2] texts = {
        "this path needs the user check here to pass; if it fails, the program stops",
        "this path needs 'p' to be non-null here; a null 'p' faults at this read first"};
    u64 mut i = 0;
    while (i < names.len) {
        ownership_witness.result mut got = candidate(c, names[i], ownership_witness.PRODUCTION_X);
        assert(rendered_all(&got, texts[i..i + 1]));
        ownership_witness.free(&got);
        i += 1;
    }
    println("conditions ok");
}

fn refusals(ownership_heap_env.closure mut* c) void {
    ownership_heap.summary* heap_summary = ownership_heap_env.summary(c, "straight");
    ownership_api.proof_status before = heap_summary->proof;
    ownership_witness.result mut got = candidate(c, "straight", 1);
    defer ownership_witness.free(&got);
    assert(got.verdict == ownership_witness.status.refused);
    assert(got.conditions_len == 0 && got.used == 1);
    assert(heap_summary->proof.kind == before.kind);
    assert(heap_summary->proof.terminal.reason == before.terminal.reason);
    assert(heap_summary->proof.terminal.reason == ownership_api.incomplete_reason.missing_path);
    ownership_witness.value assumed = ownership_witness.value{.entry_root =
        ownership_facts.nullness{ownership_facts.root_kind.nonnull,
            ownership_facts.provenance.assumed}};
    ownership_witness.value imported = ownership_witness.value{.entry_root =
        ownership_facts.nullness{ownership_facts.root_kind.nonnull,
            ownership_facts.provenance.imported}};
    ownership_witness.value established = ownership_witness.value{.entry_root =
        ownership_facts.nullness{ownership_facts.root_kind.nonnull,
            ownership_facts.provenance.established}};
    assert(!ownership_witness.established_root(assumed, ownership_facts.root_kind.nonnull));
    assert(!ownership_witness.established_root(imported, ownership_facts.root_kind.nonnull));
    assert(ownership_witness.established_root(established, ownership_facts.root_kind.nonnull));
    ownership_witness.exact_state mut path = ownership_witness.exact_state{};
    path.passed = fir_flow.bits_new(1);
    defer fir_flow.bits_free(&path.passed);
    assert(ownership_witness.enter_block(&path, 0));
    assert(!ownership_witness.enter_block(&path, 0));
    println("refusals ok");
}

fn renders(ownership_witness.condition item, string expected) void {
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    ownership_report.witness_condition(&item, &text);
    assert(strbuf.view(&text) == expected);
}

fn condition_text() void {
    ownership_api.source_position place = ownership_api.source_position{};
    renders(ownership_witness.condition{.kind = ownership_witness.condition_kind.call_returns,
        .subject = "check", .place = place, .required = "to return here",
        .outcome = "if it does not return, 'buf' does not leak"},
        "this path needs 'check' to return here; if it does not return, 'buf' does not leak");
    renders(ownership_witness.condition{.kind = ownership_witness.condition_kind.check_passes,
        .subject = "the bounds check", .place = place, .required = "here to pass",
        .outcome = "if it fails, the program stops"},
        "this path needs the bounds check here to pass; if it fails, the program stops");
    renders(ownership_witness.condition{.kind = ownership_witness.condition_kind.nonnull,
        .subject = "p", .place = place, .required = "to be non-null here", .input = true},
        "this path needs 'p' to be non-null here; a null 'p' faults at this read first");
    renders(ownership_witness.condition{.kind = ownership_witness.condition_kind.input_branch,
        .place = place, .input = true,
        .selected = ownership_witness.branch_selection.boolean_true, .excludes = true,
        .reached = "the leak"},
        "this path needs the condition here to hold; the other arm does not reach the leak");
    // Without a proof that the other arm cannot reach the operation, only the first clause.
    renders(ownership_witness.condition{.kind = ownership_witness.condition_kind.input_branch,
        .place = place, .input = true,
        .selected = ownership_witness.branch_selection.boolean_true, .reached = "the leak"},
        "this path needs the condition here to hold");
    ownership_witness.condition false_arm = ownership_witness.condition{
        .kind = ownership_witness.condition_kind.input_branch, .place = place, .input = true,
        .selected = ownership_witness.branch_selection.boolean_false, .excludes = true,
        .reached = "the invalid use"};
    rendered_condition2(&false_arm, "this path needs the condition here to be false; ",
        "the true arm does not reach the invalid use");
    println("condition text ok");
}

// Whether `v` is an exact comparison result: a typed Boolean constant or an input relation, or
// the path stopped. A comparison never gives an unknown result.
fn exact_or_stopped(ownership_witness.exact_state* path, ownership_witness.value v) bool {
    if (path->stopped) { return v.kind == ownership_witness.value_kind.unknown; }
    if (v.kind == ownership_witness.value_kind.relation) { return true; }
    return v.kind == ownership_witness.value_kind.constant && ownership_witness.typed(v) &&
        v.constant_value.kind == consts.cval_kind.cv_bool;
}

fn compared(ownership_witness.exact_state mut* path, fir.rvalue_kind kind,
    ownership_witness.value a, ownership_witness.value b) ownership_witness.value {
    path->stopped = false;
    ownership_witness.value out = ownership_witness.compare(path, kind, a, b);
    assert(exact_or_stopped(path, out));
    return out;
}

fn decided(ownership_witness.exact_state* path, ownership_witness.value v, bool expected) bool {
    return !path->stopped && v.kind == ownership_witness.value_kind.constant &&
        v.constant_value.mag == (expected ? 1 : 0);
}

// The typed-value invariant: each exact constant carries its FIR type, a typed zero of each
// primitive matches it, and a comparison gives an exact typed result or stops the path.
fn typed_values(ownership_heap_env.closure mut* c) void {
    fir.func* body = &c->functions[ownership_heap_env.index(c, "self_equal")];
    ownership_witness.request query = ownership_witness.request{.body = body,
        .bound = ownership_witness.PRODUCTION_X};
    ownership_witness.exact_state mut path = ownership_witness.exact_state{.input = &query};
    defer ownership_witness.state_free(&path);
    prim.prim_kind[12] kinds = {prim.prim_kind.prim_i8, prim.prim_kind.prim_i16,
        prim.prim_kind.prim_i32, prim.prim_kind.prim_i64, prim.prim_kind.prim_u8,
        prim.prim_kind.prim_u16, prim.prim_kind.prim_u32, prim.prim_kind.prim_u64,
        prim.prim_kind.prim_bool, prim.prim_kind.prim_char, prim.prim_kind.prim_f32,
        prim.prim_kind.prim_f64};
    u64 mut constants = 0;
    for (prim.prim_kind kind : kinds) {
        types.node* ty = types.type_prim(body->tt, kind);
        ownership_witness.value zero = ownership_witness.typed_zero(ty);
        assert(ownership_witness.typed(zero));
        if (kind == prim.prim_kind.prim_bool) {
            assert(zero.kind == ownership_witness.value_kind.constant && zero.ty == ty);
            assert(zero.constant_value.kind == consts.cval_kind.cv_bool);
            assert(zero.constant_value.mag == 0);
            constants += 1;
        } else if (prim.prim_is_integer(kind)) {
            assert(zero.kind == ownership_witness.value_kind.constant && zero.ty == ty);
            assert(zero.constant_value.kind == consts.cval_kind.cv_int);
            assert(zero.constant_value.mag == 0 && !zero.constant_value.neg);
            constants += 1;
        } else {
            assert(zero.kind == ownership_witness.value_kind.unknown);
        }
    }
    assert(constants == 9);

    types.node* boolean = types.type_prim(body->tt, prim.prim_kind.prim_bool);
    types.node* narrow = types.type_prim(body->tt, prim.prim_kind.prim_u8);
    types.node* signed_narrow = types.type_prim(body->tt, prim.prim_kind.prim_i8);
    types.node* wide = types.type_prim(body->tt, prim.prim_kind.prim_i32);
    types.node* pointer = types.type_ptr(body->tt, wide, false, false);
    ownership_witness.value_kind unknown = ownership_witness.value_kind.unknown;
    ownership_witness.value_kind constant = ownership_witness.value_kind.constant;
    assert(ownership_witness.typed_constant(boolean, consts.cv_from_u64(0)).kind == unknown);
    assert(ownership_witness.typed_constant(wide, consts.cv_from_bool(false)).kind == unknown);
    assert(ownership_witness.typed_constant(narrow, consts.cv_from_u64(255)).kind == constant);
    assert(ownership_witness.typed_constant(narrow, consts.cv_from_u64(256)).kind == unknown);
    assert(ownership_witness.typed_constant(signed_narrow, consts.cv_from_i64(-128)).kind ==
        constant);
    assert(ownership_witness.typed_constant(signed_narrow, consts.cv_from_i64(-129)).kind ==
        unknown);
    types.node* widest = types.type_prim(body->tt, prim.prim_kind.prim_u64);
    types.node* signed_widest = types.type_prim(body->tt, prim.prim_kind.prim_i64);
    ownership_witness.value most = ownership_witness.typed_constant(widest,
        consts.cv_from_u64(18446744073709551615));
    assert(most.kind == constant && ownership_witness.typed(most));
    assert(ownership_witness.typed_constant(widest, consts.int_make(true, 1)).kind == unknown);
    assert(ownership_witness.typed_constant(signed_widest,
        consts.int_make(true, 9223372036854775808)).kind == constant);
    assert(ownership_witness.typed_constant(signed_widest,
        consts.int_make(true, 9223372036854775809)).kind == unknown);
    assert(ownership_witness.typed_constant(signed_widest,
        consts.cv_from_u64(9223372036854775808)).kind == unknown);
    assert(ownership_witness.typed_constant(null, consts.cv_from_u64(0)).kind == unknown);
    ownership_witness.value untyped = ownership_witness.value{.kind = constant,
        .constant_value = consts.cv_from_u64(0)};
    assert(!ownership_witness.typed(untyped));
    ownership_witness.value null_zero = ownership_witness.typed_zero(pointer);
    assert(null_zero.kind == ownership_witness.value_kind.null_value && null_zero.ty == pointer);
    assert(ownership_witness.typed(null_zero));
    assert(ownership_witness.typed_zero(null).kind == unknown);

    ownership_witness.value zero_bool = ownership_witness.typed_zero(boolean);
    ownership_witness.value no = ownership_witness.typed_constant(boolean,
        consts.cv_from_bool(false));
    assert(decided(&path, compared(&path, fir.rvalue_kind.rv_eq, zero_bool, no), true));
    assert(decided(&path, compared(&path, fir.rvalue_kind.rv_ne, zero_bool, no), false));
    compared(&path, fir.rvalue_kind.rv_eq, untyped, no);
    assert(path.stopped);
    ownership_witness.value zero_int = ownership_witness.typed_zero(wide);
    compared(&path, fir.rvalue_kind.rv_eq, zero_int, no);
    assert(path.stopped);
    compared(&path, fir.rvalue_kind.rv_lt, no, no);
    assert(path.stopped);
    ownership_witness.value small = ownership_witness.typed_zero(narrow);
    compared(&path, fir.rvalue_kind.rv_eq, small, zero_int);
    assert(path.stopped);

    ownership_witness.value entry = ownership_witness.value{
        .kind = ownership_witness.value_kind.entry_value, .param = 0, .ty = wide};
    assert(decided(&path, compared(&path, fir.rvalue_kind.rv_eq, entry, entry), true));
    assert(decided(&path, compared(&path, fir.rvalue_kind.rv_ne, entry, entry), false));
    assert(decided(&path, compared(&path, fir.rvalue_kind.rv_lt, entry, entry), false));
    assert(decided(&path, compared(&path, fir.rvalue_kind.rv_le, entry, entry), true));
    assert(decided(&path, compared(&path, fir.rvalue_kind.rv_gt, entry, entry), false));
    assert(decided(&path, compared(&path, fir.rvalue_kind.rv_ge, entry, entry), true));
    ownership_witness.value other = ownership_witness.value{
        .kind = ownership_witness.value_kind.entry_value, .param = 1, .ty = wide};
    compared(&path, fir.rvalue_kind.rv_eq, entry, other);
    assert(path.stopped);
    ownership_witness.value three = ownership_witness.typed_constant(wide, consts.cv_from_u64(3));
    ownership_witness.value relation = compared(&path, fir.rvalue_kind.rv_eq, entry, three);
    assert(!path.stopped && relation.kind == ownership_witness.value_kind.relation);
    assert(decided(&path, compared(&path, fir.rvalue_kind.rv_eq, null_zero, null_zero), true));
    assert(decided(&path, compared(&path, fir.rvalue_kind.rv_ne, null_zero, null_zero), false));
    ownership_witness.value seen = ownership_witness.value{
        .kind = ownership_witness.value_kind.reference_value, .allocation_value = 3};
    ownership_witness.value bound = ownership_witness.value{
        .kind = ownership_witness.value_kind.allocation, .allocation_value = 3};
    ownership_witness.value fresh = ownership_witness.value{
        .kind = ownership_witness.value_kind.allocation, .allocation_value = 4};
    assert(decided(&path, compared(&path, fir.rvalue_kind.rv_eq, seen, bound), true));
    assert(decided(&path, compared(&path, fir.rvalue_kind.rv_ne, bound, null_zero), true));
    compared(&path, fir.rvalue_kind.rv_eq, bound, fresh);
    assert(path.stopped);
    compared(&path, fir.rvalue_kind.rv_eq, seen, null_zero);
    assert(path.stopped);
    compared(&path, fir.rvalue_kind.rv_eq, ownership_witness.value{}, ownership_witness.value{});
    assert(path.stopped);
    compared(&path, fir.rvalue_kind.rv_ne, ownership_witness.value{}, three);
    assert(path.stopped);
    compared(&path, fir.rvalue_kind.rv_eq, entry, null_zero);
    assert(path.stopped);
    println("typed values ok");
}

fn typed_result(ownership_heap_env.closure mut* c, string name) ownership_witness.result {
    return candidate(c, name, ownership_witness.PRODUCTION_X);
}

fn expect(ownership_heap_env.closure mut* c, string name, ownership_witness.status verdict,
    u64 conditions) bool {
    ownership_witness.result mut got = typed_result(c, name);
    defer ownership_witness.free(&got);
    if (got.verdict != verdict || got.conditions_len != conditions) {
        eprintln("red ", name, " verdict ", cast(got.verdict, u32), " conditions ",
            got.conditions_len);
        return false;
    }
    return true;
}

// A zero Boolean is a Boolean constant. A copy writes each leaf of its destination from the
// source leaf at the copy. Equal exact operands compare by their value, and an inexact comparison
// stops the path. The first invalid read of a statement ends the path.
fn typed_regressions(ownership_heap_env.closure mut* c) void {
    bool mut ok = true;
    ownership_witness.status validated = ownership_witness.status.validated;
    ownership_witness.status rejected = ownership_witness.status.rejected;
    ok = expect(c, "bool_zero", validated, 0) && ok;
    ok = expect(c, "zero_decides", validated, 0) && ok;
    ok = expect(c, "stale_copy", rejected, 0) && ok;
    ok = expect(c, "exact_copy", validated, 0) && ok;
    ok = expect(c, "copy_snapshot", validated, 0) && ok;
    ok = expect(c, "nested_stale", rejected, 0) && ok;
    ok = expect(c, "leaf_alias", rejected, 0) && ok;
    ok = expect(c, "self_compare", rejected, 0) && ok;
    ok = expect(c, "self_equal", validated, 0) && ok;
    ok = expect(c, "null_compare", rejected, 0) && ok;
    ok = expect(c, "free_compare", rejected, 0) && ok;
    ok = expect(c, "null_then_read", rejected, 0) && ok;
    ok = expect(c, "first_invalid", rejected, 0) && ok;
    ok = expect(c, "later_invalid", validated, 0) && ok;
    ok = expect(c, "zero_field", validated, 0) && ok;
    ok = expect(c, "wrap_positive", validated, 0) && ok;
    ok = expect(c, "wrap_signed", validated, 0) && ok;
    ownership_witness.result mut address = candidate_kind(c, "null_address",
        ownership_api.event_kind.lost_ownership);
    if (address.verdict != rejected) {
        eprintln("red null_address verdict ", cast(address.verdict, u32));
        ok = false;
    }
    ownership_witness.free(&address);
    ownership_witness.result mut identity = typed_result(c, "leaf_identity");
    defer ownership_witness.free(&identity);
    if (identity.verdict != validated || identity.conditions_len != 2) {
        eprintln("red leaf_identity verdict ", cast(identity.verdict, u32), " conditions ",
            identity.conditions_len);
        ok = false;
    } else {
        u64 mut i = 0;
        while (i < identity.conditions_len) {
            if (identity.conditions[i].kind != ownership_witness.condition_kind.nonnull) {
                eprintln("red leaf_identity condition ", i);
                ok = false;
            }
            i += 1;
        }
    }
    assert(ok);
    println("typed regressions ok");
}

// The check of the first lost-ownership event of `name` that names `text`, at bound `bound`. The
// prover must give that candidate, so a test of a rule cannot pass without its event.
fn loss_at(ownership_heap_env.closure mut* c, string name, string text, u64 bound)
    ownership_witness.result {
    return loss_with(c, name, text, bound, false);
}

// `loss_at`, and with `sole` set for the request when `assume_sole` holds.
fn loss_with(ownership_heap_env.closure mut* c, string name, string text, u64 bound,
    bool assume_sole) ownership_witness.result {
    u64 index = ownership_heap_env.index(c, name);
    u32 declaration = cast(index + 1, u32);
    u64 mut i = 0;
    while (i < c->counts.events && i < c->counts.rows.len) {
        ownership_heap_env.event_row event = c->counts.rows[i];
        if (event.operation.function.declaration.declaration == declaration &&
            event.kind == ownership_api.event_kind.lost_ownership &&
            ownership_heap_env.text(&event) == text) {
            ownership_api.event_descriptor mut item = ownership_api.event_descriptor{};
            item.operation = event.operation;
            item.kind = event.kind;
            item.relation = event.relation;
            item.text = ownership_heap_env.text(&event);
            ownership_witness.request query = ownership_witness.request{&c->functions[index],
                ownership_heap_env.summary(c, name), &item, c->files[..], bound,
                assume_sole || sole(c, index, event)};
            return ownership_witness.check(&query);
        }
        i += 1;
    }
    eprintln("no lost-ownership candidate for '", text, "' in ", name);
    ownership_heap_env.dump(c);
    panic("loss_at: no candidate");
}

fn loss(ownership_heap_env.closure mut* c, string name, string text) ownership_witness.result {
    return loss_at(c, name, text, ownership_witness.PRODUCTION_X);
}

// Whether the loss of `k` in `name` has verdict `verdict` with `conditions` conditions.
fn expect_loss(ownership_heap_env.closure mut* c, string name,
    ownership_witness.status verdict, u64 conditions) bool {
    ownership_witness.result mut got = loss(c, name, "k");
    defer ownership_witness.free(&got);
    if (got.verdict != verdict || got.conditions_len != conditions) {
        eprintln("red ", name, " verdict ", cast(got.verdict, u32), " conditions ",
            got.conditions_len);
        return false;
    }
    return true;
}

// A lost-ownership candidate at the last assignment of local `local` in `name`, for a rule for
// which the prover gives no candidate.
fn assignment_candidate(ownership_heap_env.closure mut* c, string name, string local)
    ownership_witness.result {
    u64 index = ownership_heap_env.index(c, name);
    fir.func* body = &c->functions[index];
    ownership_api.event_descriptor mut item = ownership_api.event_descriptor{};
    item.kind = ownership_api.event_kind.lost_ownership;
    item.text = local;
    bool mut found = false;
    u32 mut block = 0;
    while (block < fir.block_count(body)) {
        u32 mut i = 0;
        while (i < fir.block_statement_count(body, block)) {
            fir.statement* stmt = fir.block_statement(body, block, i);
            if (stmt->kind == fir.stmt_kind.st_assign &&
                stmt->place.base == fir.base_kind.bk_local && stmt->place.proj_len == 0 &&
                fir.local_name(fir.local_at(body, stmt->place.local)) == local) {
                item.operation = ownership_api.operation_position{.block = block,
                    .operation = i};
                found = true;
            }
            i += 1;
        }
        block += 1;
    }
    assert(found);
    ownership_witness.request query = ownership_witness.request{body,
        ownership_heap_env.summary(c, name), &item, c->files[..],
        ownership_witness.PRODUCTION_X, false};
    return ownership_witness.check(&query);
}

// The rendered text of each condition of `got`, which must be `expected`.
fn rendered_all(ownership_witness.result* got, string@ expected) bool {
    if (got->verdict != ownership_witness.status.validated ||
        got->conditions_len != expected.len) {
        eprintln("red rendered verdict ", cast(got->verdict, u32), " conditions ",
            got->conditions_len);
        return false;
    }
    bool mut ok = true;
    u64 mut i = 0;
    while (i < expected.len) {
        strbuf.str_buf mut text = strbuf.create();
        ownership_report.witness_condition(&got->conditions[i], &text);
        if (strbuf.view(&text) != expected[i]) {
            eprintln("red rendered: ", strbuf.view(&text));
            ok = false;
        }
        strbuf.free(&text);
        i += 1;
    }
    return ok;
}

// An overflow, shift or overwrite check that the path does not decide stops it with no
// condition: this core does not assume that such a check passes. A user check of the same
// input records `check_passes` and continues.
fn undecided_checks(ownership_heap_env.closure mut* c) void {
    fir.func* body = &c->functions[ownership_heap_env.index(c, "checked")];
    fir.terminator* mut found = null;
    u32 mut block = 0;
    while (block < fir.block_count(body)) {
        fir.terminator* term = &fir.block_at(body, block)->term;
        if (term->kind == fir.term_kind.tk_check) { found = term; break; }
        block += 1;
    }
    assert(found != null && found->check == fir.check_kind.chk_user);
    ownership_witness.request query = ownership_witness.request{.body = body,
        .bound = ownership_witness.PRODUCTION_X};
    fir.check_kind[5] kinds = {fir.check_kind.chk_overflow, fir.check_kind.chk_div_overflow,
        fir.check_kind.chk_shift, fir.check_kind.chk_overwrite, fir.check_kind.chk_user};
    u64 mut passed = 0;
    for (fir.check_kind kind : kinds) {
        ownership_witness.exact_state mut path = ownership_witness.exact_state{.input = &query};
        assert(ownership_witness.start(&path, found->target));
        fir.terminator mut term = *found;
        term.check = kind;
        bool passes = ownership_witness.check_passes(&path, &term);
        if (kind == fir.check_kind.chk_user) {
            assert(passes && path.conditions_len == 1);
            assert(path.conditions[0].kind == ownership_witness.condition_kind.check_passes);
            assert(path.conditions[0].input);
        } else {
            assert(!passes && path.conditions_len == 0);
        }
        if (passes) { passed += 1; }
        ownership_witness.state_free(&path);
    }
    assert(passed == 1);
    println("undecided checks ok");
}

// The checker makes no alias assumption between two inputs. Each of the first nine bodies
// stores through one input with a write, a struct or array copy, a zero store or a release, and
// then reads input storage through another one. `use_alias` loads `p->ptr` after a store
// through `q`. Each path stops, so each event stays incomplete proof. The checker validated the
// first six and `use_alias` when it gave each input its own storage. The controls store through
// one input, only read inputs, or read a local or a fresh cell after two input stores: the rule
// does not stop them.
fn alias_rules(ownership_heap_env.closure mut* c) void {
    bool mut ok = true;
    ownership_witness.status validated = ownership_witness.status.validated;
    ownership_witness.status rejected = ownership_witness.status.rejected;
    string[9] aliased = {"al", "al_next", "copy_alias", "width_alias", "leaf_alias",
        "equal_alias", "zero_alias", "release_alias", "arr_alias"};
    for (string name : aliased) { ok = expect_loss(c, name, rejected, 0) && ok; }
    ownership_heap_env.event_row read = ownership_heap_env.first(c, "use_alias");
    assert(read.kind == ownership_api.event_kind.invalid_use);
    assert(ownership_heap_env.text(&read) == "p->ptr");
    ownership_witness.result mut used = candidate(c, "use_alias",
        ownership_witness.PRODUCTION_X);
    if (used.verdict != rejected) {
        eprintln("red use_alias verdict ", cast(used.verdict, u32));
        ok = false;
    }
    ownership_witness.free(&used);
    ok = expect_loss(c, "one_input", validated, 1) && ok;
    ok = expect_loss(c, "read_inputs", validated, 2) && ok;
    ok = expect_loss(c, "local_after_store", validated, 2) && ok;
    ok = expect_loss(c, "fresh_after_store", validated, 2) && ok;
    ownership_witness.result mut one = loss(c, "one_input", "k");
    defer ownership_witness.free(&one);
    string[1] one_note = {
        "this path needs 'p' to be non-null here; a null 'p' faults at this read first"};
    ok = rendered_all(&one, one_note[..]) && ok;
    assert(ok);
    println("alias rules ok");
}

// An address computation reads no storage at its last dereference and establishes no fact about
// its base (D17.18). `&p->c` of a free input records no condition and no "faults" note: the path
// stops, so the later `p != null` test decides nothing. An address in a fresh allocation stays
// exact, and an earlier read of `p` still records its own condition.
fn address_rules(ownership_heap_env.closure mut* c) void {
    bool mut ok = true;
    ownership_witness.result mut only = loss(c, "addr_only", "k");
    if (only.verdict != ownership_witness.status.rejected || only.conditions_len != 0) {
        eprintln("red addr_only verdict ", cast(only.verdict, u32), " conditions ",
            only.conditions_len);
        ok = false;
    }
    ownership_witness.free(&only);
    ok = expect_loss(c, "addr_fresh", ownership_witness.status.validated, 0) && ok;
    ownership_witness.result mut read = loss(c, "addr_read", "k");
    defer ownership_witness.free(&read);
    string[1] read_note = {
        "this path needs 'p' to be non-null here; a null 'p' faults at this read first"};
    ok = rendered_all(&read, read_note[..]) && ok;
    assert(ok);
    println("address rules ok");
}

// A loop header that the path enters twice stops it; a loop that runs 0 times validates. A
// global read, an aggregate literal and a non-owning overwrite validate nothing: the first two
// stop the path, and only an owning destination can lose its old value. A failed overwrite
// check, an owning aggregate copy and a place deeper than 6 projections validate nothing. A
// selected true arm records the input-branch row.
fn step_rules(ownership_heap_env.closure mut* c) void {
    bool mut ok = true;
    ownership_witness.status validated = ownership_witness.status.validated;
    ownership_witness.status rejected = ownership_witness.status.rejected;
    ok = expect_loss(c, "loop_twice", rejected, 0) && ok;
    ok = expect_loss(c, "loop_zero", validated, 0) && ok;
    ok = expect_loss(c, "global_read", rejected, 0) && ok;
    ok = expect_loss(c, "literal_stop", rejected, 0) && ok;
    ownership_witness.result mut view = assignment_candidate(c, "overwrite_view", "v");
    if (view.verdict != rejected) {
        eprintln("red overwrite_view verdict ", cast(view.verdict, u32));
        ok = false;
    }
    ownership_witness.free(&view);
    // A live owner fails the overwrite check, so the program stops before the store loses it.
    ownership_witness.result mut live = assignment_candidate(c, "overwrite_live", "p");
    if (live.verdict != rejected) {
        eprintln("red overwrite_live verdict ", cast(live.verdict, u32));
        ok = false;
    }
    ownership_witness.free(&live);
    // The copy of an owning aggregate stops the path. A place deeper than 6 projections stops
    // it; 6 projections stay exact.
    ok = expect_loss(c, "owning_copy", rejected, 0) && ok;
    ok = expect_loss(c, "deep_read", rejected, 0) && ok;
    ok = expect_loss(c, "shallow_read", validated, 0) && ok;
    // The true arm of an input branch renders the input-branch row in the words that the user
    // ruled.
    ownership_witness.result mut arm = loss(c, "true_branch", "k");
    defer ownership_witness.free(&arm);
    string[1] arm_note = {
        "this path needs the condition here to hold; the other arm does not reach the leak"};
    ok = rendered_all(&arm, arm_note[..]) && ok;
    assert(ok);
    println("step rules ok");
}

// Each leaf of a whole aggregate copy pays one X step. So a copy of 16 leaves needs at least 16
// more steps than the same body without the copy, one step less refuses that candidate, and a
// copy of 1100 leaves refuses at the production X of 1024. A refusal leaves the candidate
// incomplete proof: it has no condition, and the heap proof and its events show no budget error.
fn copy_refusals(ownership_heap_env.closure mut* c) void {
    ownership_witness.result mut wide = loss(c, "copy_wide", "k");
    defer ownership_witness.free(&wide);
    ownership_witness.result mut none = loss(c, "copy_none", "k");
    defer ownership_witness.free(&none);
    assert(wide.verdict == ownership_witness.status.validated);
    assert(none.verdict == ownership_witness.status.validated);
    if (wide.used < none.used + 16) {
        eprintln("red copy_wide used ", wide.used, " copy_none used ", none.used);
        assert(false);
    }
    ownership_witness.result mut short = loss_at(c, "copy_wide", "k", wide.used - 1);
    defer ownership_witness.free(&short);
    assert(short.verdict == ownership_witness.status.refused);
    assert(short.used == wide.used - 1 && short.conditions_len == 0);
    ownership_heap.summary* heap_summary = ownership_heap_env.summary(c, "copy_huge");
    ownership_api.proof_status before = heap_summary->proof;
    ownership_witness.result mut huge = loss(c, "copy_huge", "k");
    defer ownership_witness.free(&huge);
    if (huge.verdict != ownership_witness.status.refused) {
        eprintln("red copy_huge verdict ", cast(huge.verdict, u32), " used ", huge.used);
        assert(false);
    }
    assert(huge.used == ownership_witness.PRODUCTION_X && huge.conditions_len == 0);
    assert(heap_summary->proof.kind == before.kind);
    assert(heap_summary->proof.terminal.reason == before.terminal.reason);
    assert(!before.terminal.limit.present);
    assert(ownership_heap_env.budget_events(c) == 0);
    println("copy refusals ok");
}

// At a return the caller can reach each owner in input storage, so that owner transfers. The
// owner that `store_out` leaves in `h->item` is no loss. `store_moved` moves it out of that
// storage again, so the same allocation is lost at the return.
fn return_rules(ownership_heap_env.closure mut* c) void {
    u32 stored = cast(ownership_heap_env.summary(c, "store_out")->interface.len + 1, u32);
    ownership_witness.result mut out = return_candidate(c, "store_out", "h->item", stored);
    if (out.verdict != ownership_witness.status.rejected) {
        eprintln("red store_out verdict ", cast(out.verdict, u32));
        assert(false);
    }
    ownership_witness.free(&out);
    u32 moved = cast(ownership_heap_env.summary(c, "store_moved")->interface.len + 1, u32);
    ownership_witness.result mut back = return_candidate(c, "store_moved", "h->item", moved);
    defer ownership_witness.free(&back);
    if (back.verdict != ownership_witness.status.validated) {
        eprintln("red store_moved verdict ", cast(back.verdict, u32));
        assert(false);
    }
    println("return rules ok");
}

// Whether `got` validates with exactly the notes `expected`. On a mismatch it prints each note.
fn notes_are(string name, ownership_witness.result* got, string@ expected) bool {
    bool mut ok = got->verdict == ownership_witness.status.validated &&
        got->conditions_len == expected.len;
    u64 mut i = 0;
    while (ok && i < expected.len) {
        strbuf.str_buf mut text = strbuf.create();
        ownership_report.witness_condition(&got->conditions[i], &text);
        ok = strbuf.view(&text) == expected[i];
        strbuf.free(&text);
        i += 1;
    }
    if (!ok) {
        eprintln("red ", name, " verdict ", cast(got->verdict, u32), " notes ",
            got->conditions_len);
        i = 0;
        while (i < got->conditions_len) {
            strbuf.str_buf mut text = strbuf.create();
            ownership_report.witness_condition(&got->conditions[i], &text);
            eprintln("    ", strbuf.view(&text));
            strbuf.free(&text);
            i += 1;
        }
    }
    return ok;
}

// `notes_are` for one note whose text is `first` followed by `second`.
fn one_note(string name, ownership_witness.result* got, string first, string second) bool {
    strbuf.str_buf mut text = strbuf.create();
    defer strbuf.free(&text);
    strbuf.append(&text, first);
    strbuf.append(&text, second);
    string[1] expected = {strbuf.view(&text)};
    return notes_are(name, got, expected[..]);
}

// An input-branch note states its second clause only when no unselected arm can reach the
// operation, another operation at its source range, or another candidate of its allocation.
// That clause names the event: "the leak" or "the invalid use". When another arm reaches the
// operation too (`demo`, `iu_after`, `both_leak`, `both_switch`, `other_both`), a copy of it
// (`d`, `e`), or another loss of its allocation (`two`, `sw`), the note states only the
// selected outcome: a run of that arm reaches the same event.
fn branch_notes(ownership_heap_env.closure mut* c) void {
    bool mut ok = true;
    string[1] demo = {"this path needs the condition here to hold"};
    ownership_witness.result mut got = loss(c, "demo", "parent->child");
    ok = notes_are("demo", &got, demo[..]) && ok;
    ownership_witness.free(&got);
    string[1] view = {
        "this path needs the condition here to hold; the other arm does not reach the invalid use"};
    got = candidate_kind(c, "iu_view", ownership_api.event_kind.invalid_use);
    ok = notes_are("iu_view", &got, view[..]) && ok;
    ownership_witness.free(&got);
    string[1] after = {"this path needs the condition here to hold"};
    got = candidate_kind(c, "iu_after", ownership_api.event_kind.invalid_use);
    ok = notes_are("iu_after", &got, after[..]) && ok;
    ownership_witness.free(&got);
    got = candidate_kind(c, "iu_switch", ownership_api.event_kind.invalid_use);
    ok = one_note("iu_switch", &got, "this path needs the switch here to select case u8 3; ",
        "other switch outcomes do not reach the invalid use") && ok;
    ownership_witness.free(&got);
    string[1] both = {"this path needs the condition here to hold"};
    got = loss(c, "both_leak", "k");
    ok = notes_are("both_leak", &got, both[..]) && ok;
    ownership_witness.free(&got);
    string[1] both_case = {"this path needs the switch here to select case u8 1"};
    got = loss(c, "both_switch", "k");
    ok = notes_are("both_switch", &got, both_case[..]) && ok;
    ownership_witness.free(&got);
    string[1] arm = {
        "this path needs the condition here to hold; the other arm does not reach the leak"};
    got = loss(c, "arm_leak", "k");
    ok = notes_are("arm_leak", &got, arm[..]) && ok;
    ownership_witness.free(&got);
    string[1] arm_false = {
        "this path needs the condition here to be false; the true arm does not reach the leak"};
    got = loss(c, "arm_false", "k");
    ok = notes_are("arm_false", &got, arm_false[..]) && ok;
    ownership_witness.free(&got);
    got = loss(c, "arm_case", "k");
    ok = one_note("arm_case", &got, "this path needs the switch here to select case u8 4; ",
        "other switch outcomes do not reach the leak") && ok;
    ownership_witness.free(&got);
    got = loss(c, "arm_other", "k");
    ok = one_note("arm_other", &got, "this path needs the switch here to select otherwise; ",
        "the listed cases do not reach the leak") && ok;
    ownership_witness.free(&got);
    // The case arm reaches the leak too, so the otherwise note has no second clause.
    got = loss(c, "other_both", "k");
    ok = one_note("other_both", &got, "this path needs the switch here to select otherwise",
        "") && ok;
    ownership_witness.free(&got);
    // A `defer` body has one operation at each scope exit. The other arm reaches the copy of
    // `del(parent)` at its own exit and loses `parent->child` there (b).
    got = loss(c, "d", "parent->child");
    ok = one_note("d", &got, "this path needs the condition here to hold", "") && ok;
    ownership_witness.free(&got);
    got = loss(c, "e", "parent->child");
    ok = one_note("e", &got, "this path needs the switch here to select case u8 1", "") && ok;
    ownership_witness.free(&got);
    // Test (b) holds without test (c): the producer can keep one candidate of the copies.
    got = loss_with(c, "d", "parent->child", ownership_witness.PRODUCTION_X, true);
    ok = one_note("d sole", &got, "this path needs the condition here to hold", "") && ok;
    ownership_witness.free(&got);
    got = loss_with(c, "e", "parent->child", ownership_witness.PRODUCTION_X, true);
    ok = one_note("e sole", &got, "this path needs the switch here to select case u8 1", "") &&
        ok;
    ownership_witness.free(&got);
    // A sole candidate with no other copy keeps its second clause.
    got = loss_with(c, "arm_leak", "k", ownership_witness.PRODUCTION_X, true);
    ok = one_note("arm_leak sole", &got, "this path needs the condition here to hold; ",
        "the other arm does not reach the leak") && ok;
    ownership_witness.free(&got);
    // The other arm loses the same allocation at another `del(parent)`: the producer has two
    // candidates of that allocation (c).
    got = loss(c, "two", "parent->child");
    ok = one_note("two", &got, "this path needs the condition here to hold", "") && ok;
    ownership_witness.free(&got);
    got = loss(c, "sw", "parent->child");
    ok = one_note("sw", &got, "this path needs the switch here to select case u8 1", "") && ok;
    ownership_witness.free(&got);
    assert(ok);
    println("branch notes ok");
}

fn main() i32 {
    ownership_heap_env.closure mut c = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&c);
    ownership_heap_env.run(&c, TEXT[..], NAMES[..]);
    exact_paths(&c);
    review_regressions(&c);
    latest_review_regressions(&c);
    conditions(&c);
    refusals(&c);
    condition_text();
    ownership_heap_env.closure mut typed = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&typed);
    ownership_heap_env.run(&typed, TYPED_TEXT[..], TYPED_NAMES[..]);
    typed_values(&typed);
    typed_regressions(&typed);
    undecided_checks(&c);
    ownership_heap_env.closure mut rules = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&rules);
    ownership_heap_env.run(&rules, RULES_TEXT[..], RULES_NAMES[..]);
    alias_rules(&rules);
    address_rules(&rules);
    step_rules(&rules);
    copy_refusals(&rules);
    return_rules(&rules);
    ownership_heap_env.closure mut notes = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&notes);
    ownership_heap_env.run(&notes, NOTES_TEXT[..], NOTES_NAMES[..]);
    branch_notes(&notes);
    return 0;
}
