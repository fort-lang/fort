//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| exact paths ok
//| conditions ok
//| refusals ok
//| condition text ok
//| typed values ok
//| typed regressions ok
//| undecided checks ok
//| alias rules ok
//| address rules ok
//| step rules ok
//| copy refusals ok
//| return rules ok
//| branch notes ok
/// Checks the one-body witness walk and its four diagnostic condition rows.
import consts;
import fir;
import fir_flow;
import ownership_api;
import ownership_facts;
import ownership_heap;
import ownership_heap_env;
import ownership_keys;
import ownership_report;
import ownership_witness;
import prim;
import std.strbuf;
import types;

