//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| exact paths ok
//| conditions ok
//| refusals ok
//| condition text ok
//| typed values ok
//| typed regressions ok
//| undecided checks ok
//| alias rules ok
//| address rules ok
//| step rules ok
//| copy refusals ok
//| return rules ok
//| branch notes ok
//| alias pairs ok
//| alias names ok
//| alias state ok
/// Checks the one-body witness walk and its five diagnostic condition rows.
import consts;
import diag;
import fir;
import fir_flow;
import ownership_api;
import ownership_facts;
import ownership_heap;
import ownership_heap_env;
import ownership_keys;
import ownership_report;
import ownership_witness;
import prim;
import std.strbuf;
import types;

string[85] TEXT = {
    "struct node { node mut* own next; i32 value; }",
    "struct pair { i32 mut* own left; i32 mut* own right; }",
    "struct flag_box { bool c; }",
    "fn helper() void {}",
    "fn straight() void { i32 mut* own p = new(i32); }",
    "fn branch(bool c) void { i32 mut* own p = new(i32); if (c) { i32 x = 1; } }",
    "fn checked(bool c) void { assert(c); i32 mut* own p = new(i32); }",
    "fn read_first(i32* p) void { i32 x = *p; i32 mut* own q = new(i32); }",
    "fn after_call() void { i32 mut* own p = new(i32); helper(); }",
    "fn no_loss() void { i32 mut* own p = new(i32); del(p); }",
    "fn decided() void { i32 mut* own p = new(i32); if (true) { i32 x = 1; } }",
    "fn checked_true() void { assert(true); i32 mut* own p = new(i32); }",
    "fn null_first() void { i32* p = null; i32 x = *p; i32 mut* own q = new(i32); }",
    "fn cast_stop() void { u32 x = 1; i32 y = cast(x, i32); i32 mut* own p = new(i32); }",
    "fn single(i32 mut* own p, i32 mut* own q) void {",
    "    if (p == null) { if (q != null) { panic(\"x\"); } }",
    "    i32 mut* own leak = new(i32);",
    "    if (p == null) { if (q != null) { return; } }",
    "    del(leak); del(p); del(q); }",
    "fn narrow_branch() void {",
    "    node mut* own a = new(node); u32 mut i = 256;",
    "    u8 mut* p = cast(&i, u8 mut*); *p = 1;",
    "    if (i == 257) { del(a); return; }",
    "}",
    "fn element_index() void {",
    "    u64[1] index = {5}; u64[2] values = {1, 2};",
    "    u64 value = values[index[0]];",
    "    node mut* own item = new(node); item->next = new(node);",
    "    del(item);",
    "}",
    "fn narrow() void {",
    "    u32 mut i = 256; u8 mut* p = cast(&i, u8 mut*); *p = 1;",
    "    u64[2] values = {1, 2}; u64 value = values[i];",
    "    node mut* own leak = new(node);",
    "}",
    "fn wrap_width() void { i32 mut* own p = new(i32); u8 a = 255; u8 b = 1; u8 n = a +% b;",
    "    if (n == 0) { del(p); } }",
    "fn distinct_labels(i32 n) void { i32 mut* own p = new(i32);",
    "    switch (n) { case 1: switch (n) { case 2: return; default: del(p); return; }",
    "    default: del(p); return; } }",
    "fn otherwise_exclusion(i32 n) void { i32 mut* own p = new(i32);",
    "    switch (n) { case 0: del(p); return; default: switch (n) {",
    "    case 0: return; default: del(p); return; } } }",
    "fn one_field() void { pair mut* own p = new(pair); p->left = new(i32); del(p); }",
    "fn aggregate_replace(flag_box mut a, flag_box mut b) void {",
    "    i32 mut* own p = new(i32); a.c = false; b.c = true; a = b;",
    "    if (a.c) { del(p); }",
    "}",
    "fn alias_copy(pair mut* a) void {",
    "    pair mut* b = a; del(a->left); i32 x = *b->left;",
    "}",
    "fn nested_read(node** pp) void {",
    "    i32 x = (*pp)->next->value; i32 mut* own p = new(i32);",
    "}",
    "fn return_tree() node mut* own {",
    "    node mut* own p = new(node); p->next = new(node); return p;",
    "}",
    "fn storage_field() void { pair mut value = pair{}; value.left = new(i32); }",
    "fn false_branch(bool c) void { i32 mut* own p = new(i32); if (c) { del(p); } }",
    "fn switch_case(i32 n) void { i32 mut* own p = new(i32); switch (n) {",
    "    case 1: del(p); case 2: return; default: del(p); }",
    "}",
    "fn switch_other(i32 n) void { i32 mut* own p = new(i32); switch (n) {",
    "    case 1: del(p); default: return; }",
    "}",
    "fn unsupported_bitwise(u8 a, u8 b) void {",
    "    u8 n = a & b;",
    "    i32 mut* own p = new(i32);",
    "}",
    "fn scalar_zero() void {",
    "    i32 mut* own z = new(i32); i32 n = *z; del(z); assert(n != 0);",
    "    i32 mut* own p = new(i32);",
    "}",
    "fn aggregate_zero() void { pair mut z = pair{}; i32 n = *z.left;",
    "    i32 mut* own p = new(i32); }",
    "fn released_address() i32 { flag_box mut* own p = new(flag_box); bool* q = &p->c;",
    "    del(p); return cast(*q, i32); }",
    "fn ended_address() i32 { i32* mut q = null; { i32 n = 1; q = &n; } return *q; }",
    "fn wrong_invalid_source() i32 { i32 mut* own a = new(i32);",
    "    i32 mut* own b = new(i32); i32* v = a; del(a); i32 n = *v + *b; del(b); return n; }",
    "fn refill_source() i32 { i32 mut* own mut p = new(i32); i32* old = p; del(p);",
    "    p = new(i32); i32 value = *old; del(move(p)); return value;",
    "}",
    "fn unused() void {}",
    "fn again() void {}",
};

