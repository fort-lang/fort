    lower_numbered_edge();
    equal_forward_join();
    different_forward_join();
    directed_cycle();
    constant_switch_edge();
    origin_join();
    equal_origin_join();
    address_and_null_join();
    symbolic_value_join();
    duplicate_switch_target();
    unreachable_cycle();
    irreducible_cycle();
    self_loop_and_exit();
    nested_cycles();
    lower_numbered_diamond_equal();
    lower_numbered_diamond_different();
    lower_numbered_calls_sort();
    merge_publication_is_conservative();
    cycle_publication_is_conservative();
    definite_read_before_loop();
    unreachable_read_after_loop();
    deterministic_repetition();
    reverse_number_chain();
    unknown_origin_propagates();
    pruned_unreachable_cycle();
    println("summary control flow ok");
    return 0;
}
