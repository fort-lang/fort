//! run
//! flags: -I ../../src/fort -I support
//! stdout:
//| ok
/// The emitter mode. `-S` runs gen_init, gen_program and gen_free in each
/// round, and the program reaches every list and every buffer that the emitter
/// owns. The emitter gives all of it back.
import lifetime;
import std.strbuf;

//
// support/lifetime.ft states the rule of the probe, the two views and the size
// of a round. Each file tests one driver mode. This keeps every program below
// the harness limit of 60 s under load.
//
// The emitter allocates much more in each round than the front end does: a
// pool that holds every operand text, seven vectors and eight buffers. A
// smaller count of rounds therefore reaches the same bound. Each of the
// sixteen gen.gen_free releases is large enough to affect a complete round.
u64 EMIT_ROUNDS = 400;
u64 EMIT_WIDTH = 60;

fn main() i32 {
    lifetime.write_runtime();
    write_emitted();
    string[3] mut emitted = {"fort", "-S", "emitted.ft"};
    assert(lifetime.measure_rounds(emitted[0..3], EMIT_ROUNDS, false) < lifetime.BOUND);
    println("ok");
    return 0;
}

// Writes a program that makes the emitter allocate everything that it owns.
// Each round allocates every resource that gen.gen_free releases. Three files
// grow `files`. An enum reached by `print` grows `enums` and its member strings.
// `extern` declarations and calls grow `externs`. String literals grow `strs`.
// A struct grows `named`, and a module constant grows `globals`. Local slots
// grow `allocas`. Nested blocks with `defer` grow `scopes` and `defers`. An
// index and an `assert` grow `fail`.
//
// Deletion checks fourteen of the sixteen gen.gen_free releases. Seven are the
// buffers `named`, `globals`, `funcs`, `allocas`, `body`, `fail`, and `scratch`.
// Six are the vectors `scopes`, `defers`, `files`, `strs`, `enums`, and
// `externs`. The pool is the final release. This test is the only witness of
// `globals`, `fail`, `defers`, `files`, `strs`, `enums`, `externs`, and `scratch`.
//
// The fifteenth, `strbuf.free(&g->out)`, turns
// driver_lifetime_closure_test.ft red and leaves this test green, and the
// reason is a measurement. The module of this program is 226998
// bytes. The buffer exceeds 128 KB. At this threshold, glibc
// uses mmap instead of the heap. A leak of such a block does not
// move the system view. And the block view is off for this mode, so neither
// view sees it. The closure mode emits a module of about two kilobytes, which
// comes out of the heap. Read the two files together for gen.gen_free.
//
// The sixteenth, `slots_free(&g->slots)`, has no witness of its own and can
// have none. gen_stmt's function_begin releases the same vector at each
// definition, and the C `main` is always the last definition, so the vector
// that gen_free gets is already empty. A deletion of either call alone leaks
// nothing and leaves all six tests green. A deletion of both turns this test
// red, which is the measured form of "exactly one of the two runs". What the
// call in function_begin answers for is a stale slot and not a leak. A symbol
// of the previous definition still in the vector would be found by
// gen_slot_place, which the emitted text of every other suite covers.
//
// The width makes the small releases visible. A two-line program covers only
// `named`, `funcs`, `out`, `body`, `scopes`, and the pool. The `externs` list
// holds references, not declarations. Thus, the program calls each declared
// function to grow `externs` past the width.
fn write_emitted() void {
    lifetime.write_file("part_one.ft", "fn one() i32 {\n    return 1;\n}\n");
    lifetime.write_file("part_two.ft", "fn two() i32 {\n    return 2;\n}\n");
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "import part_one;\nimport part_two;\n");
    strbuf.append(&b, "enum colour {\n    red,\n    green,\n    blue,\n}\n");
    strbuf.append(&b, "string GREETING = \"hello\";\n");
    u64 mut i = 0;
    while (i < EMIT_WIDTH) {
        // A struct and an `extern` apiece, so the named types and the extern
        // list grow with the width.
        strbuf.append(&b, "struct box");
        strbuf.append_u64(&b, i);
        strbuf.append(&b, " {\n    i64 value;\n}\n");
        strbuf.append(&b, "extern fn helper");
        strbuf.append_u64(&b, i);
        strbuf.append(&b, "(i64 v) i64;\n");
        i += 1;
    }
    strbuf.append(&b, "fn main() i32 {\n");
    strbuf.append(&b, "    colour c = colour.green;\n    println(c);\n");
    strbuf.append(&b, "    i64[4] values = {1, 2, 3, 4};\n    i64 mut total = 0;\n");
    i = 0;
    while (i < EMIT_WIDTH) {
        // Each `extern` is called as well as declared. The extern list holds
        // what the module refers to and not what it declares, so a
        // declaration alone leaves `syms_free` unwitnessed. -S stops at the
        // module, so nothing has to link.
        strbuf.append(&b, "    total += helper");
        strbuf.append_u64(&b, i);
        strbuf.append(&b, "(total);\n");
        i += 1;
    }
    i = 0;
    while (i < EMIT_WIDTH) {
        // Each step adds one local, one string constant, one `defer`, and one
        // nested block. Thus, the slot list, `strs`, `defers`, and `scopes`
        // grow with the width.
        strbuf.append(&b, "    {\n        i64 step");
        strbuf.append_u64(&b, i);
        strbuf.append(&b, " = values[total % 4];\n");
        strbuf.append(&b, "        defer println(\"left step ");
        strbuf.append_u64(&b, i);
        strbuf.append(&b, "\");\n        total += step");
        strbuf.append_u64(&b, i);
        strbuf.append(&b, ";\n        assert(total >= 0);\n    }\n");
        i += 1;
    }
    strbuf.append(&b, "    print(GREETING);\n");
    strbuf.append(&b, "    return part_one.one() + part_two.two() + cast(total % 2, i32);\n}\n");
    lifetime.write_file("emitted.ft", strbuf.view(&b));
}
