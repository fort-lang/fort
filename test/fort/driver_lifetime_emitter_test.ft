//! run
//! flags: -I ../../src -I support
//! stdout:
//| ok
/// The emitter mode. `-S` runs gen_init, gen_program and gen_free in each
/// round, and the program reaches every list and every buffer that the emitter
/// owns. The emitter gives all of it back.
import lifetime;
import std.strbuf;

//
// support/lifetime.ft states the rule of the probe, its view and the size
// of a round. Each file tests one driver mode. This keeps every program below
// the harness limit of 60 s under load.
//
// The emitter allocates much more in each round than the front end does: a
// pool that holds every operand text, four lists and eight buffers. A
// smaller count of rounds therefore reaches the same bound. Each release of
// gen.drop but `declared` is large enough to affect a complete round.
//
// The early sample comes at half the rounds, round 400, after the live view
// reaches its steady value. With nothing kept, its last move came at round 10
// or before under glibc 2.39 and 2.43, on the trees b6676ced, e0080544 and
// bda63b82. So 800 rounds give a margin of 390 rounds. They also give the
// smallest release that this test watches, `strbuf.free(&g->scratch)`, a
// distance of 24032 bytes or more at b6676ced, about six times BOUND.
u64 EMIT_ROUNDS = 800;
u64 EMIT_WIDTH = 60;

fn main() i32 {
    lifetime.write_check_runtime();
    write_emitted();
    string[3] mut emitted = {"fort", "-S", "emitted.ft"};
    assert(lifetime.measure_rounds(emitted[0..3], EMIT_ROUNDS) < lifetime.BOUND);
    println("ok");
    return 0;
}

// Writes a program that makes the emitter allocate everything that it owns.
// Each round allocates every resource that gen.drop releases but `declared`.
// Three files grow `files`. An enum reached by `print` grows `enums` and its
// member strings.
// `extern` declarations and calls grow `externs`. String literals grow `strs`.
// A struct grows `named`, and a module constant grows `globals`. Local slots
// grow `allocas`. An index and an `assert` grow `fail`. The program checks and
// prints, so the probe writes the stub runtime of lifetime.write_check_runtime.
//
// gen.gen_free made fourteen releases. At b6676ced the deletion of each of
// thirteen of them turned this test red under glibc 2.39 and 2.43, one
// deletion at a time: the buffers `named`, `globals`, `funcs`, `out`,
// `allocas`, `body`, `fail` and `scratch`, the lists `files`, `strs`, `enums`
// and `externs`, and the pool. The live view moved by 24032 bytes or more.
// The deletion of `syms_free(&g->declared)` moved no probe: the program has no
// interface module, so no round fills `declared`. gen.drop holds the fourteen
// releases now, and gen.gen_free moves its value into it. The deletion of each
// of the same thirteen from gen.drop turns this test red under glibc 2.39, and
// the leak rule refuses the deletion of `declared` (D17.20). This test
// is the only witness of `globals`, `fail`, `files`, `strs`, `enums` and
// `externs`.
// The break did not move for a deleted `globals` or `scratch` under glibc
// 2.39 and 2.43, or for a deleted `files` under 2.43. The live view counts
// the mmap blocks of glibc too, so the release of a buffer above 128 KB stays
// in view.
//
// The width makes the small releases visible. A two-line program covers only
// `named`, `funcs`, `out`, `body`, and the pool. The `externs` list
// holds references, not declarations. Thus, the program calls each declared
// function to grow `externs` past the width.
fn write_emitted() void {
    lifetime.write_file("part_one.ft", "fn one() i32 {\n    return 1;\n}\n");
    lifetime.write_file("part_two.ft", "fn two() i32 {\n    return 2;\n}\n");
    strbuf.str_buf mut b = strbuf.create();
    defer del(b.data);
    strbuf.append(&b, "import extern; import part_one;\nimport part_two;\n");
    strbuf.append(&b, "enum colour {\n    red,\n    green,\n    blue,\n}\n");
    strbuf.append(&b, "string GREETING = \"hello\";\n");
    u64 mut i = 0;
    while (i < EMIT_WIDTH) {
        // A struct and an `extern` apiece, so the named types and the extern
        // list grow with the width.
        strbuf.append(&b, "struct box");
        strbuf.append_u64(&b, i);
        strbuf.append(&b, " {\n    i64 value;\n}\n");
        strbuf.append(&b, "extern fn helper");
        strbuf.append_u64(&b, i);
        strbuf.append(&b, "(i64 v) i64;\n");
        i += 1;
    }
    strbuf.append(&b, "fn main() i32 {\n");
    strbuf.append(&b, "    colour c = colour.green;\n    println(c);\n");
    strbuf.append(&b, "    i64[4] values = {1, 2, 3, 4};\n    i64 mut total = 0;\n");
    i = 0;
    while (i < EMIT_WIDTH) {
        // Each `extern` is called as well as declared. The extern list holds
        // what the module refers to and not what it declares, so a
        // declaration alone leaves `syms_free` unwitnessed. -S stops at the
        // module, so nothing has to link.
        strbuf.append(&b, "    total += helper");
        strbuf.append_u64(&b, i);
        strbuf.append(&b, "(total);\n");
        i += 1;
    }
    i = 0;
    while (i < EMIT_WIDTH) {
        // Each step adds one local, one string constant, one `defer`, and one
        // nested block. Thus, the allocas and `strs` grow with the width.
        strbuf.append(&b, "    {\n        i64 step");
        strbuf.append_u64(&b, i);
        strbuf.append(&b, " = values[total % 4];\n");
        strbuf.append(&b, "        defer println(\"left step ");
        strbuf.append_u64(&b, i);
        strbuf.append(&b, "\");\n        total += step");
        strbuf.append_u64(&b, i);
        strbuf.append(&b, ";\n        assert(total >= 0);\n    }\n");
        i += 1;
    }
    strbuf.append(&b, "    print(GREETING);\n");
    strbuf.append(&b, "    return part_one.one() + part_two.two() + cast(total % 2, i32);\n}\n");
    lifetime.write_file("emitted.ft", strbuf.view(&b));
}
