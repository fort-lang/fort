//! run
//! flags: -I ../../src/fort
//! abort
//! stderr: panic: fir.block_new: too many blocks
//! stdout:
//| 1
/// A block number is a u32, so block_new refuses a function that already has U32_LIMIT blocks.
/// The test sets the count to that limit, and the call panics.
import fir;
import prim;
import types;

fn main() i32 {
    types.table mut tt = types.table{};
    defer types.type_table_free(&tt);
    types.node* i32t = types.type_prim(&tt, prim.prim_kind.prim_i32);
    types.node*[1] params = {i32t};
    types.node* fnty = types.type_fn(&tt, i32t, params[..], false);
    fir.func mut f = fir.func_new(&tt, null, fnty);
    defer fir.func_free(&f);
    println(fir.block_count(&f));
    f.blocks.len = fir.U32_LIMIT;
    fir.block_new(&f);
    return 0;
}
