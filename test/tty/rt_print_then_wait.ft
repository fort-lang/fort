/// test/tty_test.py drives this program after print_then_wait.ft. This program
/// calls the std.rt entry points that the compiler uses for the print family.
/// The two programs must show the same buffering behavior.
//
// This program calls flush_all before it returns. The generated main calls the
// same function after fort_entry returns. The manual call runs after the
// parent reads all requested output.
import std.io;
import std.rt;

fn main() i32 {
    rt.print_str(1, "out\n".ptr, 4);
    rt.print_str(2, "err\n".ptr, 4);
    // This blocks until the parent sends a byte. Nothing below it runs, and
    // nothing flushes, while the parent reads what arrived.
    u8[1] mut gate = {};
    io.read(io.STDIN, gate[..]);
    rt.print_str(1, "bye\n".ptr, 4);
    // This blocks a second time, so the parent reads the line above while the
    // process still runs. Closing the last slave of a pty drops what is still
    // in its buffer, so a line read after the exit would be a race.
    io.read(io.STDIN, gate[..]);
    rt.flush_all();
    return 0;
}
