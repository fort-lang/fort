/// test/net_layout_test.sh compares these values with test/net/net_probe.c.
import std.net;

extern fn net_address_matches(void* raw, u32 port, u32 addr) i32;

fn main() i32 {
    println("AF_INET ", net.AF_INET);
    println("SOCK_STREAM ", net.SOCK_STREAM);
    println("SOL_SOCKET ", net.SOL_SOCKET);
    println("SO_REUSEADDR ", net.SO_REUSEADDR);
    println("INADDR_ANY ", net.INADDR_ANY);
    println("sizeof_sockaddr_in ", sizeof(net.sockaddr_in));
    net.sockaddr_in mut address = {};
    // The family field of each target has the width of its C header: u8 after
    // the length byte on darwin, u16 on linux.
    $if ($cfg(target_os) == "macos") {
        address.len = 16;
        address.family = cast(net.AF_INET, u8);
    } else {
        address.family = cast(net.AF_INET, u16);
    }
    address.port = net.hton16(12345);
    address.addr = net.hton32(0x7F000001);
    println("field_values ", net_address_matches(cast(&address, void*),
        cast(address.port, u32), address.addr) == 1);
    return 0;
}
