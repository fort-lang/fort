// Probe b.ft of the review of PR 120: an access through a released, moved or emptied base.
struct counter { i64 value; }
struct holder { i64 mut* own item; }
fn ws_nested(i64 mut* own mut* pp) void { del(*pp); **pp = 5; }
fn ws_field(holder mut* h) void { del(h->item); *h->item = 5; }
fn ws_direct(i64 mut* own p) void { del(p); *p = 5; }
fn ws_moved_index(i64[2] mut* own p) void {
    i64[2] mut* own q = move(p);
    (*p)[1] = 5;
    del(q);
}
fn ws_live(counter mut* own p) void { p->value = 1; del(p); }
fn ws_alias_moved(counter mut* own p) void {
    counter mut* own q = move(p);
    counter mut* v = p;
    v->value = 1;
    del(q);
}
fn rd_released(i64 mut* own p) i64 { del(p); return *p; }
fn rd_moved(i64 mut* own p) i64 {
    i64 mut* own q = move(p);
    i64 r = *p;
    del(q);
    return r;
}
fn rd_index_moved(i64[2] mut* own p) i64 {
    i64[2] mut* own q = move(p);
    i64 r = (*p)[1];
    del(q);
    return r;
}
fn ws_nested_moved(i64 mut* own mut* pp) void {
    i64 mut* own q = move(*pp);
    **pp = 5;
    del(q);
}
fn main() i32 { return 0; }
