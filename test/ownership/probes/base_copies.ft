// Probes of the delta review of PR 143: copies of a held caller owner, a store back into
// caller storage, and a load, a move or a release of that path after it.
struct rb { i64* r; }
struct mrb { i64 mut* r; }
fn rd(i64* p) i64 { return *p; }
fn wr(i64 mut* p) void { *p = 1; }
fn keep(i64* mut* o, i64* p) void { *o = p; }
// two levels of copies
fn h2_write(i64 mut* own mut* pp) void {
    i64 mut* own x = move(*pp);
    i64 mut* y = x;
    i64 mut* z = y;
    del(x);
    *z = 1;
}
fn h2_late(i64 mut* own mut* pp) i64 {
    i64 mut* own x = move(*pp);
    i64* y = x;
    del(x);
    i64* z = y;
    return *z;
}
fn h2_move(i64 mut* own mut* pp) i64 {
    i64 mut* own x = move(*pp);
    i64* y = x;
    i64 mut* own w = move(x);
    i64* z = w;
    del(w);
    return *y + *z;
}
fn h2_cast(i64 mut* own mut* pp) i64 {
    i64 mut* own x = move(*pp);
    i64* y = cast(x, i64*);
    del(x);
    return *y;
}
fn h2_ok(i64 mut* own mut* pp) i64 {
    i64 mut* own x = move(*pp);
    i64* y = x;
    i64* z = y;
    i64 a = *z;
    *pp = move(x);
    return a + *z;
}
// a copy stored into a struct field and reloaded
fn hf_lit(i64 mut* own mut* pp) i64 {
    i64 mut* own x = move(*pp);
    rb b = rb{.r = x};
    del(x);
    return *b.r;
}
fn hf_lit_copy(i64 mut* own mut* pp) i64 {
    i64 mut* own x = move(*pp);
    i64* y = x;
    rb b = rb{.r = y};
    del(x);
    return *b.r;
}
fn hf_field_store(i64 mut* own mut* pp) i64 {
    i64 mut* own x = move(*pp);
    i64* y = x;
    rb mut b = rb{.r = null};
    b.r = y;
    del(x);
    i64* z = b.r;
    return *z;
}
fn hf_out(i64 mut* own mut* pp, rb mut* o) i64 {
    i64 mut* own x = move(*pp);
    i64* y = x;
    o->r = y;
    del(x);
    return *o->r;
}
fn hf_out_exit(i64 mut* own mut* pp, rb mut* o) void {
    i64 mut* own x = move(*pp);
    i64* y = x;
    o->r = y;
    del(x);
}
fn hf_mut_out(i64 mut* own mut* pp, mrb mut* o) void {
    i64 mut* own x = move(*pp);
    i64 mut* y = x;
    o->r = y;
    del(x);
    *o->r = 2;
}
fn hf_ok(i64 mut* own mut* pp) i64 {
    i64 mut* own x = move(*pp);
    i64* y = x;
    rb b = rb{.r = y};
    i64 a = *b.r;
    *pp = move(x);
    return a;
}
fn hf_out_ok(i64 mut* own mut* pp, rb mut* o) i64 {
    i64 mut* own x = move(*pp);
    i64* y = x;
    o->r = y;
    *pp = move(x);
    return *o->r;
}
// an address of a copy or of the held owner
fn ha_copy(i64 mut* own mut* pp) i64 {
    i64 mut* own x = move(*pp);
    i64* y = x;
    i64** py = &y;
    del(x);
    return **py;
}
// a copy passed to a callee
fn hc_rd(i64 mut* own mut* pp) i64 {
    i64 mut* own x = move(*pp);
    i64* y = x;
    del(x);
    return rd(y);
}
fn hc_rd_x(i64 mut* own mut* pp) i64 {
    i64 mut* own x = move(*pp);
    del(x);
    return rd(x);
}
fn hc_wr(i64 mut* own mut* pp) void {
    i64 mut* own x = move(*pp);
    i64 mut* y = x;
    del(x);
    wr(y);
}
fn hc_keep(i64 mut* own mut* pp, i64* mut* o) void {
    i64 mut* own x = move(*pp);
    i64* y = x;
    keep(o, y);
    del(x);
}
fn hc_rd_ok(i64 mut* own mut* pp) i64 {
    i64 mut* own x = move(*pp);
    i64* y = x;
    i64 r = rd(y);
    *pp = move(x);
    return r;
}
fn hc_rd_x_ok(i64 mut* own mut* pp) i64 {
    i64 mut* own x = move(*pp);
    i64 r = rd(x);
    *pp = move(x);
    return r;
}
fn hc_wr_ok(i64 mut* own mut* pp) void {
    i64 mut* own x = move(*pp);
    i64 mut* y = x;
    wr(y);
    *pp = move(x);
}
// a store back, a load, then a release of the path
fn sb_load(i64 mut* own mut* pp) i64 {
    i64 mut* own x = move(*pp);
    i64* y = x;
    *pp = move(x);
    i64* w = *pp;
    del(*pp);
    return *y;
}
fn sb_read(i64 mut* own mut* pp) i64 {
    i64 mut* own x = move(*pp);
    i64* y = x;
    *pp = move(x);
    i64 a = **pp;
    del(*pp);
    return a + *y;
}
fn sb_cmp(i64 mut* own mut* pp) i64 {
    i64 mut* own x = move(*pp);
    i64* y = x;
    *pp = move(x);
    bool z = *pp == null;
    del(*pp);
    return z ? 0 : *y;
}
fn sb_other_load(i64 mut* own mut* pp, i64 mut* own mut* qq) i64 {
    i64 mut* own x = move(*pp);
    i64* y = x;
    del(*qq);
    *qq = move(x);
    i64* w = *qq;
    del(*qq);
    *pp = new(i64);
    *qq = new(i64);
    return *y;
}
fn sb_plain_load(i64 mut* own mut* pp) i64 {
    i64* r = *pp;
    i64 mut* own x = move(*pp);
    *pp = move(x);
    i64* w = *pp;
    del(*pp);
    return *r;
}
fn sb_plain_read(i64 mut* own mut* pp) i64 {
    i64* r = *pp;
    i64 mut* own x = move(*pp);
    *pp = move(x);
    i64 a = **pp;
    del(*pp);
    return a + *r;
}
// a move back into the same path after the release
fn mb_new(i64 mut* own mut* pp) i64 {
    i64 mut* own x = move(*pp);
    i64* y = x;
    *pp = move(x);
    del(*pp);
    *pp = new(i64);
    return *y;
}
fn mb_param(i64 mut* own mut* pp, i64 mut* own n) i64 {
    i64 mut* own x = move(*pp);
    i64* y = x;
    del(x);
    *pp = move(n);
    return *y;
}
fn mb_again(i64 mut* own mut* pp) i64 {
    i64 mut* own mut x = move(*pp);
    i64* y = x;
    *pp = move(x);
    del(*pp);
    x = new(i64);
    *pp = move(x);
    return *y;
}
fn mb_twice(i64 mut* own mut* pp) i64 {
    i64 mut* own x = move(*pp);
    i64* y = x;
    *pp = move(x);
    del(*pp);
    *pp = new(i64);
    del(*pp);
    *pp = new(i64);
    return *y;
}
fn mb_out_again(i64 mut* own mut* pp) i64 {
    i64 mut* own x = move(*pp);
    i64* y = x;
    *pp = move(x);
    i64 mut* own z = move(*pp);
    del(z);
    *pp = new(i64);
    return *y;
}
fn mb_relay(i64 mut* own mut* pp) i64 {
    i64 mut* own x = move(*pp);
    i64* y = x;
    *pp = move(x);
    i64 mut* own z = move(*pp);
    *pp = move(z);
    del(*pp);
    *pp = new(i64);
    return *y;
}
// valid bodies that store, move back and read
fn sv_release_new(i64 mut* own mut* pp) i64 {
    i64 mut* own x = move(*pp);
    *pp = move(x);
    del(*pp);
    *pp = new(i64);
    **pp = 3;
    return **pp;
}
fn sv_read_then_release(i64 mut* own mut* pp) i64 {
    i64 mut* own x = move(*pp);
    i64* y = x;
    *pp = move(x);
    i64 a = *y;
    del(*pp);
    *pp = new(i64);
    return a;
}
fn sv_moved_out(i64 mut* own mut* pp) i64 {
    i64 mut* own x = move(*pp);
    i64* y = x;
    *pp = move(x);
    i64 mut* own z = move(*pp);
    del(*pp);
    i64 a = *y;
    *pp = move(z);
    return a;
}
fn sv_moved_out_z(i64 mut* own mut* pp) i64 {
    i64 mut* own x = move(*pp);
    *pp = move(x);
    i64 mut* own z = move(*pp);
    del(*pp);
    i64 a = *z;
    *pp = move(z);
    return a;
}
fn sv_relay(i64 mut* own mut* pp) i64 {
    i64 mut* own x = move(*pp);
    i64* y = x;
    *pp = move(x);
    i64 mut* own z = move(*pp);
    i64 a = *y;
    *pp = move(z);
    return a + *y;
}
fn sv_return(i64 mut* own mut* pp) i64* {
    i64 mut* own x = move(*pp);
    i64* y = x;
    *pp = move(x);
    return y;
}
fn sv_new_read(i64 mut* own mut* pp) i64 {
    i64 mut* own x = move(*pp);
    *pp = move(x);
    del(*pp);
    *pp = new(i64);
    i64 mut* w = *pp;
    *w = 4;
    return *w;
}
fn main() i32 { return 0; }
