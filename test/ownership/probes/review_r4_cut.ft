struct node { i32 v; node mut* own next; }
fn drop_list(node mut* own n) void { if (n == null) { return; }
    drop_list(move(n->next)); del(n); }
fn maybe_cut(node mut* own n, bool c) node mut* own {
    if (c) {
        node mut* own t = move(n->next);
        drop_list(move(t));
    }
    return move(n);
}
fn after_cut(node mut* own n) i32 {
    node mut* own m = maybe_cut(move(n), true);
    i32 w = m->next->v;
    drop_list(move(m));
    return w;
}
fn caller_cut() i32 {
    node mut* own a = new(node);
    a->next = new(node);
    return after_cut(move(a));
}
fn main() i32 { return caller_cut(); }
