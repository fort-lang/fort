struct node { node mut* own next; i32 v; }
struct carrier { u64 mut* w; }
struct side { i32 n; node mut* own p; }
struct pair16 { u64 lo; u64 hi; }
fn poke(u64 mut* w) void { *w = 0; }
fn take(carrier k) void { *k.w = 0; }
fn zap16(pair16 mut* w) void { w->lo = 0; w->hi = 0; }
fn cast_arg() void {
    node mut* own mut p = new(node);
    poke(cast(&p, u64 mut*));
    del(p);
}
fn cast_field() void {
    node mut* own mut p = new(node);
    carrier mut k = carrier{};
    k.w = cast(&p, u64 mut*);
    take(k);
    del(p);
}
fn cast_side() void {
    side mut s = side{};
    s.p = new(node);
    zap16(cast(&s, pair16 mut*));
    del(s.p);
}
fn main() i32 { cast_arg(); cast_field(); cast_side(); return 0; }
