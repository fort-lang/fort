struct node { node mut* own next; i32 v; }
struct side { i32 n; node mut* own p; }
struct pair16 { u64 lo; u64 hi; }
extern fn ext_write(u64 mut* p) void;
u64 mut* mut gw = null;
fn pass_on(u64 mut* w) void { ext_write(w); }
fn poke(u64 mut* w) void { *w = 0; }
fn addr_pass_on() void {
    side mut s = side{};
    s.p = new(node);
    pair16 mut* q = cast(&s, pair16 mut*);
    pass_on(&q->hi);
    del(s.p);
}
fn addr_extern() void {
    side mut s = side{};
    s.p = new(node);
    pair16 mut* q = cast(&s, pair16 mut*);
    ext_write(&q->hi);
    del(s.p);
}
fn addr_poke() void {
    side mut s = side{};
    s.p = new(node);
    pair16 mut* q = cast(&s, pair16 mut*);
    poke(&q->hi);
    del(s.p);
}
fn addr_global() void {
    side mut s = side{};
    s.p = new(node);
    pair16 mut* q = cast(&s, pair16 mut*);
    gw = &q->hi;
    gw = null;
    del(s.p);
}
fn direct_extern() void {
    side mut s = side{};
    s.p = new(node);
    ext_write(cast(&s.p, u64 mut*));
    del(s.p);
}
fn main() i32 { return 0; }
