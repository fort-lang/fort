struct holder { i32 mut* own p; i32 k; }
fn read_p(holder mut* own h) holder mut* own {
    i32 w = *h->p;
    return move(h);
}
fn read_p_borrow(holder* h) i32 {
    return *h->p;
}
fn get_p(holder mut* own h) i32 {
    i32 w = *h->p;
    del(h->p);
    del(h);
    return w;
}
fn null_field() void {
    holder mut* own h = new(holder);
    holder mut* own g = read_p(move(h));
    del(g);
}
fn null_field_borrow() i32 {
    holder mut* own h = new(holder);
    i32 w = read_p_borrow(h);
    del(h);
    return w;
}
fn null_field_get() i32 {
    holder mut* own h = new(holder);
    return get_p(move(h));
}
fn main() i32 { null_field(); return null_field_borrow() + null_field_get(); }
