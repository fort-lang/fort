struct view_pair { i32* first; i32* second; }
fn put_first(view_pair mut* out, i32* ptr) void { out->first = ptr; }
fn take(view_pair value) void {}
fn maybe(view_pair mut* out, i32* ptr, bool c) void { if (c) { out->first = ptr; } }
// The callee refreshes the first leaf. The second leaf still dangles.
fn cw1_bad(i32 mut* own a, i32 mut* own b, i32* cur) view_pair {
    view_pair mut v = view_pair{a, b};
    del(a); del(b); put_first(&v, cur); take(v);
    v = view_pair{cur, cur}; return v; }
// The callee writes the first leaf on one path only.
fn cw2_bad(bool c, i32 mut* own a, i32* cur) view_pair {
    view_pair mut v = view_pair{a, cur};
    del(a); maybe(&v, cur, c); take(v);
    v = view_pair{cur, cur}; return v; }
// The callee writes a leaf that dies before the call.
fn cw3_bad(i32 mut* own a, i32 mut* own cur, i32* later) view_pair {
    view_pair mut v = view_pair{a, later};
    del(a); put_first(&v, cur); del(cur); take(v);
    v = view_pair{later, later}; return v; }
fn cw3_ok(i32 mut* own a, i32 mut* own cur, i32* later) view_pair {
    view_pair mut v = view_pair{a, later};
    del(a); put_first(&v, cur); take(v); del(cur);
    v = view_pair{later, later}; return v; }
fn main() i32 { return 0; }
