// Probe n.ft of the delta review of PR 120: an owner output after a call.
struct node { i64 v; }
struct nholder { node mut* own item; }
fn nop() void {}
fn rel_in(nholder mut* h, node mut* own n, node mut* own m) void {
    nop();
    node mut* own m2 = move(m);
    h->item = move(n);
    del(h->item);
    del(m2);
}
fn double_free(nholder mut* h, node mut* own n, node mut* own m) void {
    rel_in(h, move(n), move(m));
    del(h->item);
}
fn read_after(nholder mut* h, node mut* own n, node mut* own m) i64 {
    rel_in(h, move(n), move(m));
    return h->item->v;
}
fn rel_in_nocall(nholder mut* h, node mut* own n, node mut* own m) void {
    node mut* own m2 = move(m);
    h->item = move(n);
    del(h->item);
    del(m2);
}
fn double_free_nocall(nholder mut* h, node mut* own n, node mut* own m) void {
    rel_in_nocall(h, move(n), move(m));
    del(h->item);
}
fn body_double(nholder mut* h, node mut* own n) void {
    nop();
    h->item = move(n);
    del(h->item);
    del(h->item);
}
fn body_double_nocall(nholder mut* h, node mut* own n) void {
    h->item = move(n);
    del(h->item);
    del(h->item);
}
fn main() i32 { return 0; }
