// Probes of the delta review of PR 143: joins before a release of a path, and a second
// source of one allocation after a store back.
struct holder { i64 mut* own item; }
fn noop() void { }
// joins before a release of the path
fn sj_valid(i64 mut* own mut* pp, bool c) i64 {
    i64 mut* own x = move(*pp);
    i64* y = x;
    i64 mut* own n = new(i64);
    if (c) { *pp = move(n); } else { del(n); *pp = move(x); }
    del(*pp);
    i64 mut a = 0;
    if (c) { a = *y; }
    del(x);
    *pp = new(i64);
    return a;
}
fn sj_both(i64 mut* own mut* pp, bool c) i64 {
    i64 mut* own x = move(*pp);
    i64* y = x;
    if (c) { *pp = move(x); } else { *pp = move(x); }
    del(*pp);
    *pp = new(i64);
    return *y;
}
fn sj_one(i64 mut* own mut* pp, bool c) i64 {
    i64 mut* own x = move(*pp);
    i64* y = x;
    i64 mut* own n = new(i64);
    if (c) { del(n); *pp = move(x); } else { *pp = move(n); del(x); }
    del(*pp);
    *pp = new(i64);
    return *y;
}
fn sj_after(i64 mut* own mut* pp, bool c) i64 {
    i64 mut* own x = move(*pp);
    i64* y = x;
    *pp = move(x);
    if (c) { noop(); }
    del(*pp);
    *pp = new(i64);
    return *y;
}
// a second source of one allocation: a load or a move after the store back
fn ts_move_read(i64 mut* own mut* pp) i64 {
    i64 mut* own x = move(*pp);
    i64* y = x;
    *pp = move(x);
    i64 mut* own z = move(*pp);
    del(z);
    i64 a = *y;
    *pp = new(i64);
    return a;
}
fn ts_load_copy(i64 mut* own mut* pp) i64 {
    i64 mut* own x = move(*pp);
    i64* y = x;
    *pp = move(x);
    i64* w = *pp;
    i64 mut* own z = move(*pp);
    del(z);
    *pp = new(i64);
    return *y;
}
fn ts_field(holder mut* h) i64 {
    i64 mut* own x = move(h->item);
    i64* y = x;
    h->item = move(x);
    i64* w = h->item;
    del(h->item);
    h->item = new(i64);
    return *y;
}
fn ts_plain_move(i64 mut* own mut* pp) i64 {
    i64* r = *pp;
    i64 mut* own x = move(*pp);
    *pp = move(x);
    i64 mut* own z = move(*pp);
    del(z);
    *pp = new(i64);
    return *r;
}
fn ts_plain_field(holder mut* h) i64 {
    i64* r = h->item;
    i64 mut* own x = move(h->item);
    h->item = move(x);
    i64* w = h->item;
    del(h->item);
    h->item = new(i64);
    return *r;
}
fn ts_write(i64 mut* own mut* pp) void {
    i64 mut* own x = move(*pp);
    i64 mut* y = x;
    *pp = move(x);
    i64* w = *pp;
    del(*pp);
    *pp = new(i64);
    *y = 5;
}
fn ts_return(i64 mut* own mut* pp) i64* {
    i64 mut* own x = move(*pp);
    i64* y = x;
    *pp = move(x);
    i64* w = *pp;
    del(*pp);
    *pp = new(i64);
    return y;
}
// valid: a second source, then a read before the release
fn tv_load(i64 mut* own mut* pp) i64 {
    i64 mut* own x = move(*pp);
    i64* y = x;
    *pp = move(x);
    i64* w = *pp;
    i64 a = *y + *w;
    del(*pp);
    *pp = new(i64);
    return a;
}
fn tv_moved_twice(i64 mut* own mut* pp) i64 {
    i64 mut* own x = move(*pp);
    i64* y = x;
    *pp = move(x);
    i64 mut* own z = move(*pp);
    *pp = move(z);
    i64 mut* own u = move(*pp);
    del(*pp);
    i64 a = *y;
    *pp = move(u);
    return a;
}
fn tv_empty_release(i64 mut* own mut* pp) i64 {
    i64 mut* own x = move(*pp);
    i64* y = x;
    *pp = move(x);
    i64 mut* own z = move(*pp);
    del(*pp);
    del(*pp);
    i64 a = *z;
    *pp = move(z);
    return a + *y;
}
fn main() i32 { return 0; }
