struct node { i32 v; node mut* own next; }
fn drop_list(node mut* own n) void { if (n == null) { return; }
    drop_list(move(n->next)); del(n); }
fn fold_read(node mut* own n, bool c) node mut* own {
    if (c) { i32 x = n->v; }
    i32 w = n->next->v;
    return move(n);
}
fn fold_null() void {
    node mut* own n = new(node);
    node mut* own m = fold_read(move(n), false);
    drop_list(move(m));
}
fn main() i32 { fold_null(); return 0; }
