struct node { node mut* own next; i32 v; }
fn drop_list(node mut* own n) void { if (n == null) { return; }
    drop_list(move(n->next)); del(n); }
fn addr_only(node mut* own n) node mut* own {
    i32 mut* q = &n->v;
    return move(n);
}
fn free_param(node mut* own x) void {
    i32 mut* own extra = new(i32);
    node mut* own y = addr_only(move(x));
    if (y == null) { return; }
    del(extra);
    drop_list(move(y));
}
fn null_local() void {
    i32 mut* own extra = new(i32);
    node mut* own y = addr_only(null);
    if (y == null) { return; }
    del(extra);
    drop_list(move(y));
}
fn main() i32 { free_param(null); null_local(); return 0; }
