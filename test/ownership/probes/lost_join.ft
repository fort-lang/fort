struct node { i32 v; node mut* own next; }
fn drop_list(node mut* own n) void { if (n == null) { return; }
    drop_list(move(n->next)); del(n); }
fn either(node mut* own a, bool c) i32 {
    node mut* own mut m = null;
    if (c) { m = new(node); } else { m = move(a); }
    i32 w = m->v;
    drop_list(move(m));
    drop_list(move(a));
    return w;
}
fn either_null() i32 { return either(null, false); }
fn main() i32 { return either_null(); }
