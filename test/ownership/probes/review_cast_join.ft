struct node { node mut* own next; i32 v; }
struct ta { node mut* own o; }
struct tb { u32 lo; u32 hi; }
fn joined_ret(bool c) tb mut* own {
    void mut* own mut v = null;
    if (c) {
        v = cast(new(tb), void mut* own);
    } else {
        ta mut* own a = new(ta);
        a->o = new(node);
        v = cast(move(a), void mut* own);
    }
    tb mut* own b = cast(move(v), tb mut* own);
    b->hi = 7;
    return move(b);
}
fn joined_ret_ab(bool c) tb mut* own {
    void mut* own mut v = null;
    if (c) {
        ta mut* own a = new(ta);
        a->o = new(node);
        v = cast(move(a), void mut* own);
    } else {
        v = cast(new(tb), void mut* own);
    }
    tb mut* own b = cast(move(v), tb mut* own);
    b->hi = 7;
    return move(b);
}
fn single_ret() tb mut* own {
    ta mut* own a = new(ta);
    a->o = new(node);
    void mut* own v = cast(move(a), void mut* own);
    tb mut* own b = cast(move(v), tb mut* own);
