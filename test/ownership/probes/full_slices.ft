// D17.14, D17.18: a full slice of caller storage after a move, a release or a store. Each body
// reads storage through the slice after that storage stops being live. The summary solver and
// the calls_heap row prove none of the 4 bodies. The heap solver alone proves `full_after_move`
// and `ptr_after_move`: class P of test/ownership/solvers/false_accepts.txt.
struct heap_store { u64 mut@ own heap; }
struct view_store { u64@ data; }
fn full_after_move(heap_store mut* s) u64 {
    u64 mut@ own h = move(s->heap);
    u64 mut@ v = s->heap[..];
    del(h);
    return v[0];
}
fn ptr_after_move(heap_store mut* s) u64 {
    u64 mut@ own h = move(s->heap);
    u64 mut@ v = s->heap[..];
    u64 mut* p = v.ptr;
    del(h);
    return *p;
}
fn full_after_release(heap_store mut* s) u64 {
    u64 mut@ v = s->heap[..];
    u64 mut@ own h = move(s->heap);
    del(h);
    return v[0];
}
fn load_after_store_full(view_store mut* s, u64@ other) u64 {
    u64 mut@ own a = new(u64, 4);
    s->data = a;
    u64@ d = s->data[..];
    s->data = other;
    del(a);
    return d[0];
}
fn main() i32 { return 0; }
