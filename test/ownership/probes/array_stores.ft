struct holder { i32*[2] arr; }
struct abox { i32*[2] ps; }
fn take_arr(i32*[2] value) void {}
fn take_abox(abox value) void {}
// A whole-array store into caller storage keeps a dangling element after the return.
fn caller_arr_bad(holder mut* h, i32 mut* own p) void {
    i32*[2] t = {p, p}; h->arr = t; del(p); }
fn caller_arr_ok(holder mut* h, i32* q) void { i32*[2] t = {q, q}; h->arr = t; }
// A whole-array store into a by-value parameter, then a copy of the dangling array.
fn param_arr_bad(i32*[2] mut a, i32 mut* own p) void {
    i32*[2] t = {p, p}; a = t; del(p); take_arr(a); }
fn param_arr_ok(i32*[2] mut a, i32 mut* own p) void {
    i32*[2] t = {p, p}; a = t; take_arr(a); del(p); }
// A whole-array store into a field of a by-value struct parameter.
fn param_box_bad(abox mut b, i32 mut* own p) void {
    i32*[2] t = {p, p}; b.ps = t; del(p); take_abox(b); }
fn param_box_ok(abox mut b, i32* q) void { i32*[2] t = {q, null}; b.ps = t; take_abox(b); }
fn main() i32 { return 0; }
