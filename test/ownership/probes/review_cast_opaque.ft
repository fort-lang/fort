struct node { node mut* own next; i32 v; }
struct wide { node mut* own mut@ own kids; }
fn zap_kid(wide mut* w) void { *cast(&w->kids[0], u64 mut*) = 0; }
fn zap_kid_typed(wide mut* w) void { w->kids[0] = null; }
fn zap_owned(node mut* own mut@ own mut* xsp) void {
    u64 mut* q = cast(&(*xsp)[0], u64 mut*);
    *q = 0;
}
fn wide_ext(u8 mut* b) void { *cast(b, u64 mut*) = 0; }
fn void_ext(void mut* v) void { *cast(v, u64 mut*) = 0; }
fn main() i32 { return 0; }
