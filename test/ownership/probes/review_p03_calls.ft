struct node { i32 v; node mut* own next; }
struct holder { node mut* own first; node mut* own second; }
fn drop_list(node mut* own n) void { if (n == null) { return; }
    drop_list(move(n->next)); del(n); }
fn field_of(node mut* n) i32 mut* { return &n->v; }
fn graft_addr(node mut* own n) void {
    i32 mut* own extra = new(i32);
    i32 mut* q0 = &n->v;
    i32 mut* r = field_of(n);
    if (r == null) { drop_list(move(n)); return; }
    del(extra);
    drop_list(move(n));
}
fn give(node mut* own n) node mut* own { return move(n); }
fn graft_fresh_then_test() void {
    i32 mut* own extra = new(i32);
    node mut* own m = give(null);
    if (m == null) { return; }
    del(extra);
    drop_list(move(m));
}
fn clear(holder mut* h) void { drop_list(move(h->first)); }
fn null_after_clear(holder mut* h) void {
    i32 mut* own extra = new(i32);
    clear(h);
    h->first = new(node);
    clear(h);
    if (h->first != null) { return; }
    del(extra);
}
fn set_next(node mut* own mut* slot, node mut* own b, bool f) void {
    if (f) { drop_list(move(*slot)); *slot = move(b); return; }
    drop_list(move(b));
}
fn via_slot(node mut* own n, bool f) void {
    i32 mut* own extra = new(i32);
    node mut* own b = new(node);
    set_next(&n->next, move(b), f);
    if (n == null) { return; }
    del(extra);
    drop_list(move(n));
}
fn need_null(node mut* own n) node mut* own {
    if (n != null) { panic("need"); }
    return move(n);
}
fn contra_after_graft(holder mut* h) void {
    i32 mut* own extra = new(i32);
    clear(h);
    node mut* own y = need_null(move(h->first));
    drop_list(move(y));
}
fn contra_moved(node mut* own n) void {
    i32 mut* own extra = new(i32);
    node mut* own m = move(n);
    node mut* own y = need_null(move(n));
    drop_list(move(y));
    drop_list(move(m));
}
fn main() i32 { graft_addr(null); graft_fresh_then_test(); return 0; }
