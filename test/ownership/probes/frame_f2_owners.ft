// Class F shapes (D17.18): a call changes an owner local, an owned field of a local, or a field of
// the cell that the owner holds, through an address that an earlier call kept. A local struct
// carries the address, so the first call changes no tracked fact. Each faulty body leaks `extra`
// on a path that the call makes.
struct node { i32 v; node mut* own next; }
struct peer { i32 v; i32 mut* p; i32 mut* own q; }
struct peer_holder { peer mut* own mut* pp; }
struct bag { node mut* own item; }
struct holder { node mut* own mut* pp; }
struct bag_holder { bag mut* pb; }
struct box { i32 mut* own p; i32 v; }
struct box_holder { box mut* own mut* pp; }
node mut* own mut* mut saved = null;
bag mut* mut saved_bag = null;
box mut* own mut* mut saved_box = null;
peer mut* own mut* mut saved_peer = null;
i32 mut target = 7;
fn keep_owner(holder* h) void { saved = h->pp; }
fn take_owner() void { if (saved != null) { del(*saved); } }
fn fill_owner() void { if (saved != null && *saved == null) { *saved = new(node); } }
fn keep_bag(bag_holder* h) void { saved_bag = h->pb; }
fn take_bag() void { if (saved_bag != null) { del(saved_bag->item); } }
fn keep_box(box_holder* h) void { saved_box = h->pp; }
fn take_box() void { if (saved_box != null) { del(*saved_box); } }
fn keep_peer(peer_holder* h) void { saved_peer = h->pp; }
fn point_peer() void { if (saved_peer != null) { (*saved_peer)->p = &target; } }
// The callee releases the owner and zeroes it.
fn owner_root() void {
    i32 mut* own extra = new(i32);
    node mut* own mut m = new(node);
    holder mut h = holder{};
    h.pp = &m;
    keep_owner(&h);
    take_owner();
    if (m == null) { return; }
    del(m);
    del(extra);
}
// A view of the owner keeps its address after the callee released the owner.
fn owner_view() void {
    i32 mut* own extra = new(i32);
    node mut* own mut m = new(node);
    node* v = m;
    holder mut h = holder{};
    h.pp = &m;
    keep_owner(&h);
    take_owner();
    if (m == null) {
        if (v == null) { del(extra); return; }
        return;
    }
    del(m);
    del(extra);
}
// The same with a cell, whose null atom `canonical` keeps.
fn box_view() void {
    i32 mut* own extra = new(i32);
    box mut* own mut m = new(box);
    box* v = m;
    box_holder mut h = box_holder{};
    h.pp = &m;
    keep_box(&h);
    take_box();
    if (m == null) {
        if (v == null) { del(extra); return; }
        return;
    }
    del(m);
    del(extra);
}
// The callee writes a field of the cell that the owner holds.
fn peer_field() void {
    i32 mut* own extra = new(i32);
    peer mut* own mut m = new(peer);
    peer_holder mut h = peer_holder{};
    h.pp = &m;
    keep_peer(&h);
    point_peer();
    if (m->p == null) { del(extra); }
    del(m);
}
// A scalar tests the owner before the call, and a branch reads it after the call.
fn owner_test_link() void {
    i32 mut* own extra = new(i32);
    node mut* own mut m = new(node);
    holder mut h = holder{};
    h.pp = &m;
    keep_owner(&h);
    bool t = m == null;
    take_owner();
    if (t) {
        del(extra);
        del(m);
        return;
    }
    if (m == null) { return; }
    del(extra);
    del(m);
}
// The callee fills an empty owner, and the filled path leaks `extra`.
fn owner_empty() void {
    i32 mut* own extra = new(i32);
    node mut* own mut m = null;
    holder mut h = holder{};
    h.pp = &m;
    keep_owner(&h);
    fill_owner();
    if (m == null) {
        del(extra);
        return;
    }
    del(m);
}
// An owned field of an address-taken struct.
fn bag_field() void {
    i32 mut* own extra = new(i32);
    bag mut b = bag{};
    b.item = new(node);
    bag_holder mut h = bag_holder{};
    h.pb = &b;
    keep_bag(&h);
    take_bag();
    if (b.item == null) { return; }
    del(b.item);
    del(extra);
}
fn main() i32 {
    owner_root();
    owner_view();
    box_view();
    peer_field();
    owner_test_link();
    owner_empty();
    bag_field();
    return 0;
}
