// Class M review (D17.14, D17.18, spec/fir.md 14.1): a callee joins the entry values of two
// caller slots and then copies the slot. The join named no slot, so on 13cc1703 the heap solver
// alone proved join_two_dangling, join_two_false_dangling and join_store_dangling: the copy
// read the dangling entry value of `h->p` on the path where the callee did not store into it.
// A join of two entry values is now a joined input, and its copy from a caller slot names that
// slot. `join_two_ok` holds the same shape with a live referent.
struct cell { i64 a; }
struct ph { cell* p; }
fn join_two(ph mut* h, ph* g, bool f) void { if (f) { h->p = g->p; } cell* c = h->p; }
fn join_ret(ph mut* h, ph* g, bool f) cell* { if (f) { h->p = g->p; } return h->p; }
fn join_store(ph mut* h, ph* g, ph mut* d, bool f) void { if (f) { h->p = g->p; } d->p = h->p; }
fn join_two_dangling(bool f) i64 {
    cell mut* own b = new(cell);
    cell mut* own k = new(cell);
    ph mut h = ph{b};
    ph g = ph{k};
    del(b);
    join_two(&h, &g, f);
    del(k);
    return 0;
}
fn join_two_false_dangling() i64 {
    cell mut* own b = new(cell);
    cell mut* own k = new(cell);
    ph mut h = ph{b};
    ph g = ph{k};
    del(b);
    join_two(&h, &g, false);
    del(k);
    return 0;
}
fn join_ret_dangling(bool f) i64 {
    cell mut* own b = new(cell);
    cell mut* own k = new(cell);
    ph mut h = ph{b};
    ph g = ph{k};
    del(b);
    cell* r = join_ret(&h, &g, f);
    del(k);
    return 0;
}
fn join_store_dangling(bool f) i64 {
    cell mut* own b = new(cell);
    cell mut* own k = new(cell);
    ph mut h = ph{b};
    ph g = ph{k};
    ph mut d = ph{null};
    del(b);
    join_store(&h, &g, &d, f);
    del(k);
    return 0;
}
fn join_two_ok(bool f) i64 {
    cell mut* own b = new(cell);
    cell mut* own k = new(cell);
    ph mut h = ph{b};
    ph g = ph{k};
    join_two(&h, &g, f);
    del(b);
    del(k);
    return 0;
}
fn main() i32 { return 0; }
