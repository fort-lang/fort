fn set(bool mut* p) void { *p = true; }
fn count(i32 mut* p) void { *p = 1; }
fn set_direct() void {
    i32 mut* own extra = new(i32);
    bool mut b = false;
    set(&b);
    if (b) { return; }
    del(extra);
}
fn count_direct() void {
    i32 mut* own extra = new(i32);
    i32 mut k = 0;
    count(&k);
    if (k == 1) { return; }
    del(extra);
}
fn main() i32 { set_direct(); count_direct(); return 0; }
