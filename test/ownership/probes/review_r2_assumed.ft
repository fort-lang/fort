struct node { i32 v; node mut* own next; }
fn drop_list(node mut* own n) void { if (n == null) { return; }
    drop_list(move(n->next)); del(n); }
fn read_root(node mut* own n) node mut* own { i32 w = n->v; return move(n); }
fn addr_pass(node mut* own n) void {
    i32* q = &n->v;
    node mut* own m = read_root(move(n));
    drop_list(move(m));
}
fn null_addr_pass() void { addr_pass(null); }
fn read_next(node mut* own n) node mut* own { i32 w = n->next->v; return move(n); }
fn addr_pass_next(node mut* own n) void {
    i32* q = &n->v;
    node mut* own m = read_next(move(n));
    drop_list(move(m));
}
fn null_addr_pass_next() void { addr_pass_next(null); }
fn main() i32 { null_addr_pass(); null_addr_pass_next(); return 0; }
