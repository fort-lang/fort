// Class F shapes (D17.18): a call writes a pointer local whose address an earlier call kept. Each
// faulty body tests the pointer after the call, and the path that the test keeps leaks `extra`.
struct pair { i32 mut* a; i32 mut* b; }
struct holder { i32 mut* mut* pp; }
struct peer { i32 v; i32 mut* p; }
extern fn keep_pp(i32 mut* mut* pp) void;
extern fn fire_ext() void;
extern fn keep_holder_ext(holder* h) void;
i32 mut* mut* mut saved = null;
pair mut* mut saved_pair = null;
peer mut* mut* mut saved_peer = null;
i32 mut* mut* mut* mut saved_rr = null;
i32 mut target = 7;
fn stash_pp(i32 mut* mut* pp) void { saved = pp; }
fn fire_pp() void { if (saved != null) { *saved = &target; } }
fn clear_pp() void { *saved = null; }
fn set_then_clear(i32 mut* mut* pp) void { *pp = &target; *saved = null; }
fn clear_only(i32 mut* mut* pp) void { *saved = null; }
fn stash_pair(pair mut* p) void { saved_pair = p; }
fn fire_pair() void { if (saved_pair != null) { saved_pair->a = &target; } }
fn keep_holder(holder* h) void { saved = h->pp; }
fn clear_through(holder h) void { *h.pp = null; }
fn stash_rr(i32 mut* mut* mut* pp) void { saved_rr = pp; }
fn clear_rr() void { **saved_rr = null; }
fn addr_of(peer mut* p) i32 mut* mut* { return &p->p; }
fn stash_peer(peer mut* mut* pp) void { saved_peer = pp; }
fn clear_peer() void { (*saved_peer)->p = null; }
// A field of an address-taken struct.
fn field_global() void {
    i32 mut* own extra = new(i32);
    pair mut pr = pair{};
    stash_pair(&pr);
    pr.a = null;
    fire_pair();
    if (pr.a == null) { del(extra); return; }
}
// An element of an address-taken array.
fn element_global() void {
    i32 mut* own extra = new(i32);
    pair[2] mut prs = {};
    stash_pair(&prs[0]);
    prs[0].a = null;
    fire_pair();
    if (prs[0].a == null) { del(extra); return; }
}
// An address that a loop takes.
fn loop_global(i32 k) void {
    i32 mut* own extra = new(i32);
    i32 mut* mut q = null;
    i32 mut i = 0;
    while (i < k) {
        stash_pp(&q);
        i += 1;
    }
    q = null;
    fire_pp();
    if (q == null) { del(extra); return; }
}
// An address that a heap cell holds before the call.
fn cell_global() void {
    i32 mut* own extra = new(i32);
    holder mut* own h = new(holder);
    i32 mut* mut q = null;
    h->pp = &q;
    keep_holder(h);
    del(h);
    q = null;
    fire_pp();
    if (q == null) { del(extra); return; }
}
// An address that a local struct holds before the call.
fn holder_global() void {
    i32 mut* own extra = new(i32);
    i32 mut* mut q = null;
    holder mut h = holder{};
    h.pp = &q;
    keep_holder(&h);
    q = null;
    fire_pp();
    if (q == null) { del(extra); return; }
}
// The address of a local, which a callee then clears through the kept address.
fn address_cleared() void {
    i32 mut* own extra = new(i32);
    i32 mut x = 1;
    i32 mut* mut q = null;
    stash_pp(&q);
    q = &x;
    clear_pp();
    if (q != null) { del(extra); return; }
}
// The same through an extern that kept the address.
fn address_cleared_extern() void {
    i32 mut* own extra = new(i32);
    i32 mut x = 1;
    i32 mut* mut q = null;
    keep_pp(&q);
    q = &x;
    fire_ext();
    if (q != null) { del(extra); return; }
}
// A pointer local views a cell, and the callee clears a field of that cell through the kept
// address of the pointer.
fn view_cell() void {
    i32 mut* own extra = new(i32);
    i32 mut x = 1;
    peer mut* own m = new(peer);
    m->p = &x;
    peer mut* mut q = m;
    stash_peer(&q);
    clear_peer();
    if (m->p != null) { del(extra); }
    m->p = null;
    del(m);
}
// The address of a cell field, which an earlier call kept.
fn cell_address() void {
    i32 mut* own extra = new(i32);
    i32 mut x = 1;
    peer mut* own m = new(peer);
    stash_pp(&m->p);
    m->p = &x;
    clear_pp();
    if (m->p != null) { del(extra); }
    m->p = null;
    del(m);
}
// The callee writes the storage that its argument designates, then clears it through the kept
// address.
fn designated_alias() void {
    i32 mut* own extra = new(i32);
    i32 mut* mut q = null;
    stash_pp(&q);
    set_then_clear(&q);
    if (q != null) { del(extra); return; }
}
// The callee clears the storage that its argument designates through the kept address only, so
// the graft gives back the value before the call.
fn untouched_alias() void {
    i32 mut* own extra = new(i32);
    i32 mut x = 1;
    i32 mut* mut q = null;
    stash_pp(&q);
    q = &x;
    clear_only(&q);
    if (q != null) { del(extra); return; }
}
// A by-value struct carries the address of a cell field, and a callee with a complete proof
// clears the field through it.
fn struct_by_value() void {
    i32 mut* own extra = new(i32);
    i32 mut x = 1;
    peer mut* own m = new(peer);
    m->p = &x;
    holder mut h = holder{};
    h.pp = &m->p;
    clear_through(h);
    if (m->p != null) { del(extra); }
    m->p = null;
    del(m);
}
// A local struct holds the address of a cell field at the first call only.
fn cell_holder() void {
    i32 mut* own extra = new(i32);
    i32 mut x = 1;
    peer mut* own m = new(peer);
    holder mut h = holder{};
    h.pp = &m->p;
    keep_holder(&h);
    m->p = &x;
    clear_pp();
    if (m->p != null) { del(extra); }
    m->p = null;
    del(m);
}
// The same through externs.
fn cell_holder_extern() void {
    i32 mut* own extra = new(i32);
    i32 mut x = 1;
    peer mut* own m = new(peer);
    holder mut h = holder{};
    h.pp = &m->p;
    keep_holder_ext(&h);
    m->p = &x;
    fire_ext();
    if (m->p != null) { del(extra); }
    m->p = null;
    del(m);
}
// A callee returns the address of a cell field, and a pointer local whose address an earlier call
// kept holds it.
fn returned_address() void {
    i32 mut* own extra = new(i32);
    i32 mut x = 1;
    peer mut* own m = new(peer);
    i32 mut* mut* mut r = null;
    stash_rr(&r);
    r = addr_of(m);
    m->p = &x;
    clear_rr();
    if (m->p != null) { del(extra); }
    m->p = null;
    del(m);
}
fn main() i32 {
    field_global();
    element_global();
    loop_global(1);
    cell_global();
    holder_global();
    address_cleared();
    address_cleared_extern();
    view_cell();
    cell_address();
    designated_alias();
    untouched_alias();
    struct_by_value();
    cell_holder();
    cell_holder_extern();
    returned_address();
    return 0;
}
