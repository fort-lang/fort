struct node { i32 v; }
fn read_release_read(node mut* own n, bool cut) node mut* own {
    if (n == null) { return null; }
    i32 first = n->v;
    if (cut) { del(n); }
    i32 second = n->v;
    return move(n);
}
fn caller(bool cut) void {
    node mut* own n = new(node);
    node mut* own out = read_release_read(move(n), cut);
    del(out);
}
fn main() i32 { caller(true); return 0; }
