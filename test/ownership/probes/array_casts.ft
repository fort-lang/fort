struct two { i32*[2] a; i32*[2] b; }
fn take_two(two value) void {}
fn take_arr(i32*[2] value) void {}
// A cast of the address of `a[1]` to the array type writes past the start of `a`. The element
// `a[0]` keeps its released reference.
fn cast_bad(i32 mut* own p, i32* q) void {
    two mut tw = two{};
    i32*[2] t0 = {p, p}; tw.a = t0;
    del(p);
    i32*[2] mut* pa = cast(&tw.a[1], i32*[2] mut*);
    i32*[2] t = {q, q};
    *pa = t;
    take_two(tw);
}
fn cast_arr_bad(i32 mut* own p, i32* q) void {
    two mut tw = two{};
    i32*[2] t0 = {p, p}; tw.a = t0;
    del(p);
    i32*[2] mut* pa = cast(&tw.a[1], i32*[2] mut*);
    i32*[2] t = {q, q};
    *pa = t;
    take_arr(tw.a);
}
// Index zero is the start of the array, so the store replaces each element.
fn cast_zero_ok(i32 mut* own p, i32* q) void {
    two mut tw = two{};
    i32*[2] t0 = {p, p}; tw.a = t0;
    del(p);
    i32*[2] mut* pa = cast(&tw.a[0], i32*[2] mut*);
    i32*[2] t = {q, q};
    *pa = t;
    take_arr(tw.a);
}
fn cast_two_bad(i32 mut* own p, i32* q) void {
    two mut tw = two{};
    i32*[2] t0 = {p, p}; tw.a = t0;
    i32*[2] t1 = {q, q}; tw.b = t1;
    del(p);
    i32*[2] mut* pa = cast(&tw.a[1], i32*[2] mut*);
    i32*[2] t = {q, q};
    *pa = t;
    take_two(tw);
}
fn cast_local_bad(i32 mut* own p, i32* q) void {
    i32*[2] mut a = {p, p};
    del(p);
    i32*[2] mut* pa = cast(&a[1], i32*[2] mut*);
    i32*[2] t = {q, q};
    *pa = t;
    take_arr(a);
}
// The store writes into `tw.b` too.
fn cast_sibling_bad(i32 mut* own p, i32* q) void {
    two mut tw = two{};
    i32*[2] t0 = {q, q}; tw.a = t0; tw.b = t0;
    i32*[2] mut* pa = cast(&tw.a[1], i32*[2] mut*);
    i32*[2] t = {p, p};
    *pa = t;
    del(p);
    take_arr(tw.b);
}
// A cast of the address of `sl[1]` through a slice writes past the start of `tw.a`.
fn span_idx_bad(i32 mut* own p, i32* q) void {
    two mut tw = two{};
    i32*[2] t0 = {p, p}; tw.a = t0;
    del(p);
    i32* mut@ sl = tw.a[..];
    i32*[2] mut* pa = cast(&sl[1], i32*[2] mut*);
    i32*[2] t = {q, q};
    *pa = t;
    take_arr(tw.a);
}
// A slice from index 1 starts after the start of `tw.a`.
fn span_start_bad(i32 mut* own p, i32* q) void {
    two mut tw = two{};
    i32*[2] t0 = {p, p}; tw.a = t0;
    del(p);
    i32* mut@ sl = tw.a[1..];
    i32*[2] mut* pa = cast(&sl[0], i32*[2] mut*);
    i32*[2] t = {q, q};
    *pa = t;
    take_arr(tw.a);
}
// An address through a slice never matches the whole array type, so this valid store is a
// cast store, and the body gives incomplete proof.
fn span_zero_ok(i32 mut* own p, i32* q) void {
    two mut tw = two{};
    i32*[2] t0 = {p, p}; tw.a = t0;
    del(p);
    i32* mut@ sl = tw.a[..];
    i32*[2] mut* pa = cast(&sl[0], i32*[2] mut*);
    i32*[2] t = {q, q};
    *pa = t;
    take_arr(tw.a);
}
fn span_idx_two_bad(i32 mut* own p, i32* q) void {
    two mut tw = two{};
    i32*[2] t0 = {p, p}; tw.a = t0;
    del(p);
    i32* mut@ sl = tw.a[..];
    i32*[2] mut* pa = cast(&sl[1], i32*[2] mut*);
    i32*[2] t = {q, q};
    *pa = t;
    take_two(tw);
}
fn main() i32 { return 0; }
