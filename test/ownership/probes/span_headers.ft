// D17.14, D17.18: a copy of the pointer field of a caller span after or before a move of the
// span. Each body then reads through the copied pointer after the release. The summary solver
// and the calls_heap row prove neither body. The heap solver alone proves `ptr_field_move`:
// class P of test/ownership/solvers/false_accepts.txt.
struct heap_store { u64 mut@ own heap; }
fn ptr_field_move(heap_store mut* s) u64 {
    u64 mut@ own h = move(s->heap);
    u64 mut* p = s->heap.ptr;
    del(h);
    return *p;
}
fn ptr_field_release(heap_store mut* s) u64 {
    u64 mut* p = s->heap.ptr;
    u64 mut@ own h = move(s->heap);
    del(h);
    return *p;
}
fn main() i32 { return 0; }
