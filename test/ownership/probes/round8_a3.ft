struct node { i32 v; node mut* own next; }
fn drop_list(node mut* own n) void { if (n == null) { return; }
    drop_list(move(n->next)); del(n); }
fn chk_addr(node mut* own n) void {
    i32 mut* own extra = new(i32);
    i32 mut* q = &n->v;
    assert(q != null);
    del(extra);
    drop_list(move(n));
}
fn join_addr(node mut* own n, bool f) void {
    i32 mut* own extra = new(i32);
    i32 mut* mut q = null;
    if (f) { q = &n->v; } else { q = &n->v; }
    if (q == null) { drop_list(move(n)); return; }
    del(extra);
    drop_list(move(n));
}
fn loop_addr(node mut* own n, i32 k) void {
    i32 mut* own extra = new(i32);
    i32 mut i = 0;
    while (i < k) {
        i32 mut* q = &n->v;
        if (q == null) { drop_list(move(n)); return; }
        i += 1;
    }
    del(extra);
    drop_list(move(n));
}
fn rec_stop(node mut* own n, i32 k) node mut* own {
    if (k > 0) { return rec_stop(move(n), k - 1); }
    i32 mut* q = &n->v;
    if (q != null) { panic("stop"); }
    return move(n);
}
fn rec_user() void {
    i32 mut* own extra = new(i32);
    node mut* own y = rec_stop(null, 2);
    drop_list(move(y));
}
fn two_stop(node mut* own n) node mut* own {
    i32 mut* q = &n->v;
    if (q != null) { panic("stop"); }
    return move(n);
}
fn two_mid(node mut* own n) node mut* own { return two_stop(move(n)); }
fn two_user() void {
    i32 mut* own extra = new(i32);
    node mut* own y = two_mid(null);
    drop_list(move(y));
}
fn main() i32 {
    join_addr(null, true); loop_addr(null, 2); rec_user(); two_user();
    chk_addr(null);
    return 0;
}
