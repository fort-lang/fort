struct node { node mut* own next; i32 v; }
struct pairo { node mut* own[2] kids; i32 tag; }
fn struct_arr_null(pairo mut* p) void {
    node* mut* q = cast(&p->kids[0], node* mut*);
    *q = null;
}
fn struct_arr_typed(pairo mut* p) void {
    p->kids[0] = null;
}
fn whole_arr_null(pairo mut* p) void {
    node* mut* q = cast(&p->kids, node* mut*);
    *q = null;
}
fn local_arr_null() void {
    node mut* own[2] mut a = {};
    node* mut* q = cast(&a[0], node* mut*);
    *q = null;
}
fn main() i32 { return 0; }
