struct node { i32 v; node mut* own next; }
struct word { u64 bits; }
fn pun_null_address() void {
    i32 mut* own extra = new(i32);
    i32 mut x = 0;
    i32 mut* mut q = &x;
    word mut* w = cast(&q, word mut*);
    w->bits = 0;
    if (q == null) { return; }
    del(extra);
}
fn pun_null_owner() void {
    node mut* own mut p = new(node);
    word mut* w = cast(&p, word mut*);
    w->bits = 0;
    if (p == null) {
        i32 mut* own lost = new(i32);
        return;
    }
    del(p);
}
fn joined_targets(bool c) void {
    i32 mut* own extra = new(i32);
    bool mut a = false;
    bool mut b = false;
    bool mut* q = c ? &a : &b;
    *q = true;
    if (a || b) { return; }
    del(extra);
}
fn main() i32 {
    pun_null_address();
    pun_null_owner();
    joined_targets(true);
    return 0;
}
