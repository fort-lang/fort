struct node { i32 v; node mut* own next; }
fn drop_list(node mut* own n) void { if (n == null) { return; }
    drop_list(move(n->next)); del(n); }
fn read_b(node* p) i32 { return p->v; }
fn addr_then(node mut* own n) i32 {
    i32* q = &n->v;
    i32 w = read_b(n);
    drop_list(move(n));
    return w;
}
fn null_addr_then() i32 { return addr_then(null); }
fn touch(node mut* own n) node mut* own { i32* q = &n->v; return move(n); }
fn touched(node mut* own n) i32 {
    node mut* own m = touch(move(n));
    i32 w = read_b(m);
    drop_list(move(m));
    return w;
}
fn null_touched() i32 { return touched(null); }
fn child_view(node mut* own n) i32 {
    i32* q = &n->next->v;
    i32 w = read_b(n->next);
    drop_list(move(n));
    return w;
}
fn null_child_view() i32 {
    node mut* own n = new(node);
    return child_view(move(n));
}
fn main() i32 { return null_addr_then() + null_touched() + null_child_view(); }
