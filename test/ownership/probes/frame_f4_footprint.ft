// Classes K and L (D17.18): a callee with a complete proof writes storage that its summary does
// not record. Class K: the callee writes caller storage through a global that an earlier call
// set, directly or through a pointer local whose address that call kept. Class L: the callee
// writes through a pointer leaf of a by-value struct. Each faulty body leaks on the path that the
// write makes.
struct node { i32 v; }
struct peer { i32 v; i32 mut* p; }
struct cpeer { i32 v; node* p; }
struct holder2 { peer mut* p; }
cpeer mut* mut saved_c = null;
cpeer mut* mut* mut saved_cp = null;
fn stash_c(cpeer mut* c) void { saved_c = c; }
fn clear_c() void { saved_c->p = null; }
fn stash_cp(cpeer mut* mut* pp) void { saved_cp = pp; }
fn clear_cp() void { (*saved_cp)->p = null; }
fn clear2(holder2 h) void { h.p->p = null; }
// K: an earlier call keeps the pointer to caller storage.
fn caller_kept(cpeer mut* c) void {
    i32 mut* own extra = new(i32);
    stash_c(c);
    node mut* own b = new(node);
    c->p = b;
    clear_c();
    if (c->p == null) { del(b); return; }
    c->p = null;
    del(b);
    del(extra);
}
// K: a named local holds the pointer to caller storage.
fn caller_local(cpeer mut* c) void {
    i32 mut* own extra = new(i32);
    cpeer mut* mut q = c;
    stash_cp(&q);
    node mut* own b = new(node);
    c->p = b;
    clear_cp();
    if (c->p == null) { del(b); return; }
    c->p = null;
    del(b);
    del(extra);
}
// L: a by-value struct holds a view of the cell, and the callee clears a field of the cell.
fn struct_view_val() void {
    i32 mut* own extra = new(i32);
    i32 mut x = 1;
    peer mut* own m = new(peer);
    m->p = &x;
    holder2 mut h = holder2{};
    h.p = m;
    clear2(h);
    if (m->p != null) { del(extra); }
    m->p = null;
    del(m);
}
fn main() i32 {
    cpeer mut cp = cpeer{};
    caller_kept(&cp);
    caller_local(&cp);
    struct_view_val();
    return 0;
}
