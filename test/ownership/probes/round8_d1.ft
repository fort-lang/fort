struct node { i32 v; node mut* own next; }
fn drop_list(node mut* own n) void { if (n == null) { return; }
    drop_list(move(n->next)); del(n); }
fn read_next(node mut* own n) node mut* own {
    i32 w = n->next->v;
    return move(n);
}
fn read_root(node mut* own n) node mut* own {
    i32 w = n->v;
    return move(n);
}
fn null_next() void {
    node mut* own n = new(node);
    node mut* own m = read_next(move(n));
    drop_list(move(m));
}
fn null_root() void {
    node mut* own n = null;
    node mut* own m = read_root(move(n));
    drop_list(move(m));
}
fn main() i32 { null_next(); return 0; }
