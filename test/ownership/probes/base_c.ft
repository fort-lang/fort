// Probe c.ft of the review of PR 120: an access through a released, moved or emptied base.
struct counter { i64 value; }
struct pair { i64 a; i64 b; }
struct holder { i64 mut* own item; }
fn copy_after_move(i64 mut* own mut* pp) i64 {
    i64 mut* own q = move(*pp);
    i64 mut* r = *pp;
    i64 b = *r;
    del(q);
    return b;
}
fn copy_after_read_move(i64 mut* own mut* pp) i64 {
    i64 a = **pp;
    i64 mut* own q = move(*pp);
    i64 mut* r = *pp;
    i64 b = *r;
    del(q);
    return a + b;
}
fn ret_addr_released(counter mut* own p) i64* {
    counter* v = p;
    del(p);
    return &v->value;
}
fn loaded_release(i64 mut* own mut* pp) i64 {
    i64 mut* inner = *pp;
    del(*pp);
    return *inner;
}
fn naddr_before(i64 mut* own mut* pp) i64 {
    i64* a = &**pp;
    del(*pp);
    return *a;
}
fn naddr_before_move(i64 mut* own mut* pp) i64 {
    i64* a = &**pp;
    i64 mut* own q = move(*pp);
    del(q);
    return *a;
}
fn addr_nested_rel(i64 mut* own mut* pp) i64 {
    del(*pp);
    i64* a = &**pp;
    return *a;
}
fn addr_pair_rel(pair mut* own mut* pp) i64* {
    del(*pp);
    return &(*pp)->b;
}
fn addr_before(counter mut* own p) i64 {
    i64* a = &p->value;
    del(p);
    return *a;
}
fn addr_before_move(counter mut* own p) i64 {
    i64* a = &p->value;
    counter mut* own q = move(p);
    i64 r = *a;
    del(q);
    return r;
}
fn two_level(holder mut* mut* hh) i64 {
    del((*hh)->item);
    return *(*hh)->item;
}
fn read_then_release(i64 mut* own mut* pp) i64 {
    i64 a = **pp;
    del(*pp);
    return a + **pp;
}
fn nested_scalar_after_loaded_release(counter mut* own mut* pp) i64 {
    counter* c = *pp;
    del(*pp);
    return c->value;
}
fn main() i32 { return 0; }
