struct view_box { i32* ptr; }
fn takep(i32* p) void {}
// A scalar reference argument that dangles. The callee does not read it.
fn sc_arg_bad(i32 mut* own p) void { i32* x = p; del(p); takep(x); }
fn sc_arg_ok(i32 mut* own p) void { i32* x = p; takep(x); del(p); }
// A scalar copy of a dangling reference.
fn sc_copy_bad(i32 mut* own p) i32 { i32* x = p; del(p); i32* y = x; return 0; }
fn sc_copy_ok(i32 mut* own p) i32 { i32* x = p; i32* y = x; del(p); return 0; }
// An aggregate assignment copies a dangling borrowed leaf.
fn ag_copy_bad(i32 mut* own p, i32* q) view_box {
    view_box mut v = view_box{p}; del(p); view_box w = v; v = view_box{q}; return v; }
fn ag_copy_ok(i32 mut* own p, i32* q) view_box {
    view_box mut v = view_box{p}; view_box w = v; del(p); v = view_box{q}; return v; }
fn main() i32 { return 0; }
