struct node { node mut* own next; i32 v; }
struct holder { node mut* own first; i32 tag; }
fn fake(node mut* n) node mut* own {
    node mut* own mut p = null;
    node mut* mut* q = cast(&p, node mut* mut*);
    *q = n;
    return move(p);
}
fn fake_field(holder mut* h, node mut* n) void {
    node mut* mut* q = cast(&h->first, node mut* mut*);
    *q = n;
}
fn fake_cell(node mut* n) void {
    holder mut* own h = new(holder);
    node mut* mut* q = cast(&h->first, node mut* mut*);
    *q = n;
    del(h->first);
    del(h);
}
fn own_span_return(node mut* own mut@ own a) node mut* own mut@ own {
    *cast(a.ptr, u64 mut*) = 0;
    return move(a);
}
fn field_load() void {
    node mut* own mut p = new(node);
    holder mut k = holder{};
    u64 mut* w = cast(&p, u64 mut*);
    *w = 0;
    del(p);
}
fn main() i32 { return 0; }
fn use_fake() void {
    node mut* own mut keep = new(node);
    node mut* own f = fake(keep);
    del(f);
    del(keep);
}
fn use_fake_field() void {
    node mut* own mut keep = new(node);
    holder mut h = holder{};
    fake_field(&h, keep);
    del(h.first);
    del(keep);
}
