// Probe f.ft of the review of PR 120: an access through a released, moved or emptied base.
struct box { i64 value; }
fn zero_addr_deref(i64 mut* own p) i64 {
    i64 mut* own q = move(p);
    i64* a = &*p;
    i64 r = *a;
    del(q);
    return r;
}
fn zero_field_deref(box mut* own p) i64 {
    box mut* own q = move(p);
    i64* a = &p->value;
    i64 r = *a;
    del(q);
    return r;
}
fn released_addr_deref(i64 mut* own p) i64 {
    del(p);
    i64* a = &*p;
    return *a;
}
fn main() i32 { return 0; }
