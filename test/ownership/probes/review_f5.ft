struct node { node mut* own next; i32 v; }
fn drop_list(node mut* own n) void { if (n == null) { return; }
    drop_list(move(n->next)); del(n); }
fn read_node(node mut* own n) node mut* own {
    i32 w = n->v;
    return move(n);
}
fn null_read() void {
    node mut* own y = read_node(null);
    drop_list(move(y));
}
fn local_read() i32 {
    node mut* own y = null;
    return y->v;
}
fn main() i32 { null_read(); return 0; }
