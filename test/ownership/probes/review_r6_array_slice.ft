struct box { box mut* own next; u8[4] data; }
fn index_slice(box mut* own b) box mut* own {
    u8 mut@ s = b->data[0..4];
    u8 x = s[0];
    return move(b);
}
fn stale_index() u8 {
    box mut* own b = new(box);
    u8 mut@ s = b->data[0..4];
    del(b);
    return s[0];
}
fn main() i32 { return cast(stale_index(), i32); }
