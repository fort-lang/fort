struct node { i32 v; node mut* own next; }
fn drop_list(node mut* own n) void { if (n == null) { return; }
    drop_list(move(n->next)); del(n); }
fn join_est(node mut* own n, bool f) void {
    i32 mut* own extra = new(i32);
    if (f) { if (n == null) { del(extra); return; } }
    if (n == null) { return; }
    del(extra);
    drop_list(move(n));
}
fn loop_est(node mut* own p, i32 k) void {
    i32 mut* own extra = new(i32);
    node mut* own mut m = new(node);
    i32 mut i = 0;
    while (i < k) {
        if (m == null) { drop_list(move(p)); return; }
        drop_list(move(m));
        m = move(p);
        i += 1;
    }
    del(extra);
    drop_list(move(m));
    drop_list(move(p));
}
fn loop_addr_est(node mut* own p, i32 k) void {
    i32 mut* own extra = new(i32);
    node mut* own mut m = new(node);
    i32 mut i = 0;
    while (i < k) {
        i32 mut* q = &m->v;
        if (q == null) { drop_list(move(p)); return; }
        drop_list(move(m));
        m = move(p);
        i += 1;
    }
    del(extra);
    drop_list(move(m));
    drop_list(move(p));
}
fn join_addr_mix(node mut* own n, bool f) void {
    i32 mut* own extra = new(i32);
    node mut* own m = new(node);
    i32 mut* mut q = null;
    if (f) { q = &m->v; } else { q = &n->v; }
    if (q == null) { drop_list(move(m)); drop_list(move(n)); return; }
    del(extra);
    drop_list(move(m));
    drop_list(move(n));
}
fn swap_cell(node mut* own p, bool f) void {
    i32 mut* own extra = new(i32);
    node mut* own mut m = new(node);
    node mut* own mut n = move(p);
    if (f) { node mut* own t = move(m); m = move(n); n = move(t); }
    i32 mut* q = &m->v;
    if (q == null) { drop_list(move(m)); drop_list(move(n)); return; }
    del(extra);
    drop_list(move(m));
    drop_list(move(n));
}
fn deep_loop(node mut* own p, i32 k) void {
    i32 mut* own extra = new(i32);
    node mut* own mut m = new(node);
    node mut* own mut a = new(node);
    node mut* own mut b = new(node);
    node mut* own mut c = new(node);
    i32 mut i = 0;
    while (i < k) {
        if (c == null) { drop_list(move(m)); drop_list(move(a)); drop_list(move(b));
            drop_list(move(p)); return; }
        drop_list(move(c));
        c = move(b);
        b = move(a);
        a = move(m);
        m = move(p);
        i += 1;
    }
    del(extra);
    drop_list(move(m)); drop_list(move(a)); drop_list(move(b)); drop_list(move(c));
    drop_list(move(p));
}
fn main() i32 { join_est(null, false); loop_est(null, 2); loop_addr_est(null, 2);
    join_addr_mix(null, false); swap_cell(null, true); deep_loop(null, 6); return 0; }
