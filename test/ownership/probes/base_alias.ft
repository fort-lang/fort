// Formals that can alias (D17.4). The review of PR 120 found that the summary solver proves the
// first 11 bodies alone; direct_alias_free proved before that PR too. A caller that passes one
// pointer twice reaches the error. A store or a release through one formal now ends the
// current-contents search of another, so the first 10 bodies stay unproved, and so do
// rel_alias and move_alias. field_alias_free, direct_alias_free and alias_del read through a
// formal or a load before the release: their summaries hold, and the application of each
// fails for an aliased caller.
struct cell { i64 v; }
struct cbox { cell* c; }
struct outer { cbox b; i64 n; }
struct node { i64 v; }
struct nholder { node mut* own item; }
struct holder { i64 mut* own item; }
struct ibox { i64 v; }
struct hbox { ibox mut* own item; }
fn two_alias_free(cbox mut* p, cbox mut* q, cell* r1) i64 {
    p->c = r1;
    cell mut* own x = new(cell);
    q->c = x;
    del(x);
    i64 b = p->c->v;
    p->c = r1;
    q->c = r1;
    return b;
}
fn two_alias_null(cbox mut* p, cbox mut* q, cell* r1) i64 {
    p->c = r1;
    q->c = null;
    return p->c->v;
}
fn two_alias_entry(cbox mut* p, cbox mut* q) i64 {
    q->c = null;
    return p->c->v;
}
fn outer_alias_free(cbox mut* p, outer mut* o, cell* r1) i64 {
    p->c = r1;
    cell mut* own x = new(cell);
    o->b.c = x;
    del(x);
    i64 b = p->c->v;
    p->c = r1;
    o->b.c = r1;
    return b;
}
fn outer_alias_zero(cbox mut* p, outer mut* o, cell* r1) i64 {
    p->c = r1;
    *o = outer{};
    return p->c->v;
}
fn owner_alias_free(nholder mut* h, nholder mut* k, node mut* own n) i64 {
    del(h->item);
    h->item = move(n);
    del(k->item);
    k->item = null;
    return h->item->v;
}
fn reuse_alias_null(cbox mut* p, cbox mut* q) i64 {
    i64 a = p->c->v;
    q->c = null;
    i64 b = p->c->v;
    return a + b;
}
fn reuse_alias_free(cbox mut* p, cbox mut* q) i64 {
    i64 a = p->c->v;
    cell mut* own x = new(cell);
    q->c = x;
    del(x);
    i64 b = p->c->v;
    q->c = null;
    return a + b;
}
fn slot_alias_null(cbox mut* p, cell* mut* q, cell* r1) i64 {
    p->c = r1;
    *q = null;
    return p->c->v;
}
fn slot_alias_entry(cbox mut* p, cell* mut* q) i64 {
    *q = null;
    return p->c->v;
}
fn field_alias_free(ibox* p, hbox mut* h) i64 {
    del(h->item);
    return p->v;
}
fn direct_alias_free(i64* p, holder mut* h) i64 {
    del(h->item);
    return *p;
}
fn rel_alias(nholder mut* h, nholder mut* k, node mut* own n) i64 {
    del(h->item);
    h->item = move(n);
    del(k->item);
    return h->item->v;
}
fn move_alias(nholder mut* h, nholder mut* k, node mut* own n) i64 {
    del(h->item);
    h->item = move(n);
    node mut* own t = move(k->item);
    del(t);
    return h->item->v;
}
fn alias_del(holder mut* h, holder mut* k) i64 {
    i64* r = h->item;
    del(k->item);
    return *r;
}
fn two_alias_caller(cbox mut* p, cell* r1) i64 { return two_alias_free(p, p, r1); }
fn two_alias_null_caller(cbox mut* p, cell* r1) i64 { return two_alias_null(p, p, r1); }
fn two_alias_entry_caller(cbox mut* p) i64 { return two_alias_entry(p, p); }
fn owner_alias_caller(nholder mut* h, node mut* own n) i64 {
    return owner_alias_free(h, h, move(n));
}
fn main() i32 { return 0; }
