struct node { node mut* own next; i32 v; }
struct flat { i32 v; }
fn addr_only(node mut* own n) node mut* own {
    i32 mut* q = &n->v;
    return move(n);
}
fn addr_flat(flat mut* own n) flat mut* own {
    i32 mut* q = &n->v;
    return move(n);
}
fn read_flat(flat mut* own n) flat mut* own {
    i32 w = n->v;
    return move(n);
}
fn free_param(flat mut* own x) void {
    i32 mut* own extra = new(i32);
    flat mut* own y = addr_flat(move(x));
    if (y == null) { return; }
    del(extra);
    del(y);
}
fn null_flat() void {
    i32 mut* own extra = new(i32);
    flat mut* own x = null;
    flat mut* own y = addr_flat(move(x));
    if (y == null) { return; }
    del(extra);
    del(y);
}
fn read_null() void {
    i32 mut* own extra = new(i32);
    flat mut* own x = null;
    flat mut* own y = read_flat(move(x));
    if (y == null) { return; }
    del(extra);
    del(y);
}
fn main() i32 { free_param(null); null_flat(); return 0; }
