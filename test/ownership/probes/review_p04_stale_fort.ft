struct node { i32 v; node mut* own next; }
extern fn poke(bool mut* p) void;
fn set_true(bool mut* p) void {
    i32 mut* own lost = new(i32);
    *p = true;
}
fn stale_fort() void {
    i32 mut* own extra = new(i32);
    bool mut b = false;
    set_true(&b);
    if (b) { return; }
    del(extra);
}
fn set_via(bool mut* p) void { poke(p); }
fn stale_via() void {
    i32 mut* own extra = new(i32);
    bool mut b = false;
    set_via(&b);
    if (b) { return; }
    del(extra);
}
fn stale_null(node mut* own n) void {
    i32 mut* own extra = new(i32);
    bool mut gone = false;
    if (n == null) { gone = true; }
    poke(&gone);
    if (!gone) { del(extra); }
    if (n == null) { return; }
    drop(move(n));
}
fn drop(node mut* own n) void { if (n == null) { return; } drop(move(n->next)); del(n); }
fn main() i32 { stale_fort(); stale_via(); stale_null(null); return 0; }
