struct node { node mut* own next; i32 v; }
fn addr_only(node mut* own n) node mut* own {
    i32 mut* q = &n->v;
    return move(n);
}
fn caller_free(node mut* own x) void {
    i32 mut* own extra = new(i32);
    node mut* own y = addr_only(move(x));
    if (y == null) { return; }
    del(extra);
    del(y);
}
fn caller_null() void {
    i32 mut* own extra = new(i32);
    node mut* own x = null;
    node mut* own y = addr_only(move(x));
    if (y == null) { return; }
    del(extra);
    del(y);
}
fn main() i32 { caller_free(null); caller_null(); return 0; }
