struct node { i32 v; node mut* own next; }
struct holder { node mut* own first; }
fn drop_list(node mut* own n) void { if (n == null) { return; }
    drop_list(move(n->next)); del(n); }
fn fold_null(node mut* own n, bool f) void {
    i32 mut* own extra = new(i32);
    i32 mut* q = &n->v;
    if (n == null) {
        if (f) { del(extra); return; }
    }
    if (n == null) { return; }
    del(extra);
    drop_list(move(n));
}
fn fold_loop(node mut* own n, i32 k) void {
    i32 mut* own extra = new(i32);
    i32 mut i = 0;
    while (i < k) {
        i32 mut* q = &n->v;
        if (n == null) { break; }
        i += 1;
    }
    if (n == null) { return; }
    del(extra);
    drop_list(move(n));
}
fn child_null(node mut* own n) void {
    i32 mut* own extra = new(i32);
    i32 mut* q = &n->next->v;
    if (n->next == null) { return; }
    del(extra);
    drop_list(move(n));
}
fn reset(holder mut* h) void { drop_list(move(h->first)); }
fn loop_reset(holder mut* h, i32 k) void {
    i32 mut* own extra = new(i32);
    drop_list(move(h->first));
    i32 mut i = 0;
    while (i < k) { reset(h); i += 1; }
    if (h->first != null) { return; }
    del(extra);
}
fn main() i32 { fold_null(null, false); fold_loop(null, 0); return 0; }
