// Callers of bodies that store over the entry value of a by-value owner parameter. The heap
// solver proves each callee with the caller requirement that the parameter is null (D17.18).
// The bodies that end in `_live` pass a live owner, so they fail that requirement at the call
// and lose the owner: each is faulty. The bodies that end in `_null` pass null and meet it.
struct holder { i64 mut* own item; }
struct pair { i64 mut* own a; i64 mut* own b; }
struct outer { holder in; i64 v; }
fn clear_live(holder mut* h, i64 mut* own n) void {
    del(h->item);
    h->item = move(n);
    *h = holder{};
}
fn drop_moved(i64 mut* own n) void {
    i64 mut* own mut x = move(n);
    x = null;
}
fn clear_nested_mid(outer mut* o, i64 mut* own n) void {
    del(o->in.item);
    o->in.item = move(n);
    o->in = holder{};
}
fn clear_pair_a(pair mut* p, i64 mut* own n) void {
    del(p->a);
    p->a = move(n);
    del(p->b);
    *p = pair{};
}
fn clear_live_live(holder mut* h) void {
    i64 mut* own n = new(i64);
    clear_live(h, move(n));
}
fn clear_live_null(holder mut* h) void {
    clear_live(h, null);
}
fn drop_moved_live() void {
    i64 mut* own n = new(i64);
    drop_moved(move(n));
}
fn drop_moved_null() void {
    drop_moved(null);
}
fn nested_mid_live(outer mut* o) void {
    i64 mut* own n = new(i64);
    clear_nested_mid(o, move(n));
}
fn nested_mid_null(outer mut* o) void {
    clear_nested_mid(o, null);
}
fn pair_a_live(pair mut* p) void {
    i64 mut* own n = new(i64);
    clear_pair_a(p, move(n));
}
fn pair_a_null(pair mut* p) void {
    clear_pair_a(p, null);
}
fn main() i32 { return 0; }
