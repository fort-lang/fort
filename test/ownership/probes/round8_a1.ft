struct node { i32 v; node mut* own next; }
fn drop_list(node mut* own n) void { if (n == null) { return; }
    drop_list(move(n->next)); del(n); }
fn first_addr(node mut* own n) void {
    i32 mut* own extra = new(i32);
    i32 mut* q = &n->v;
    if (q == null) { return; }
    del(extra);
    drop_list(move(n));
}
fn local_addr() void {
    i32 mut* own extra = new(i32);
    node mut* own n = null;
    i32 mut* q = &n->v;
    if (q == null) { return; }
    del(extra);
    drop_list(move(n));
}
fn main() i32 { first_addr(null); local_addr(); return 0; }
