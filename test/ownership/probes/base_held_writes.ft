// Probes of the delta review of PR 143: writes through a borrow copy after a store back, and
// a release of a held local after its move.
struct hold { i64 mut* own item; i64 v; }
struct cell { i64 v; }
fn consume(i64 mut* own x) void { del(x); }
fn wr(i64 mut* p) void { *p = 1; }
// writes through a borrow copy after a second source of the allocation
fn tw_move(i64 mut* own mut* pp) void {
    i64 mut* own x = move(*pp);
    i64 mut* y = x;
    *pp = move(x);
    i64 mut* own z = move(*pp);
    del(z);
    *pp = new(i64);
    *y = 1;
}
fn tw_field(cell mut* own mut* pp) void {
    cell mut* own x = move(*pp);
    cell mut* y = x;
    *pp = move(x);
    cell* w = *pp;
    del(*pp);
    *pp = new(cell);
    y->v = 3;
}
fn tw_branch(i64 mut* own mut* pp, bool c) void {
    i64 mut* own x = move(*pp);
    i64 mut* y = x;
    *pp = move(x);
    i64* w = *pp;
    del(*pp);
    *pp = new(i64);
    if (c) { *y = 1; }
}
fn tw_callee(i64 mut* own mut* pp) void {
    i64 mut* own x = move(*pp);
    i64 mut* y = x;
    *pp = move(x);
    i64* w = *pp;
    del(*pp);
    *pp = new(i64);
    wr(y);
}
fn tw_relay(i64 mut* own mut* pp) void {
    i64 mut* own x = move(*pp);
    i64 mut* y = x;
    *pp = move(x);
    i64 mut* own z = move(*pp);
    *pp = move(z);
    del(*pp);
    *pp = new(i64);
    *y = 1;
}
// a release of a held local after its move into caller storage or into a callee
fn sd_moved(i64 mut* own mut* pp) i64 {
    i64 mut* own x = move(*pp);
    i64* y = x;
    *pp = move(x);
    del(x);
    return *y;
}
fn sd_moved_write(i64 mut* own mut* pp) void {
    i64 mut* own x = move(*pp);
    i64 mut* y = x;
    *pp = move(x);
    del(x);
    *y = 2;
}
fn sd_moved_plain(i64 mut* own mut* pp) i64 {
    i64 mut* own x = move(*pp);
    *pp = move(x);
    del(x);
    return **pp;
}
fn sd_field(hold mut* own mut* pp) i64 {
    hold mut* own x = move(*pp);
    hold* y = x;
    *pp = move(x);
    del(x);
    return y->v;
}
fn sd_consume(i64 mut* own mut* pp) i64 {
    i64 mut* own x = move(*pp);
    i64* y = x;
    consume(move(x));
    del(x);
    *pp = new(i64);
    return *y;
}
fn sd_other(i64 mut* own mut* pp, i64 mut* own mut* qq) i64 {
    i64 mut* own x = move(*pp);
    i64* y = x;
    del(*qq);
    *qq = move(x);
    del(x);
    i64 a = *y;
    *pp = new(i64);
    return a;
}
fn main() i32 { return 0; }
