struct node { i32 v; node mut* own next; }
struct holder { node mut* own first; }
fn drop_list(node mut* own n) void { if (n == null) { return; }
    drop_list(move(n->next)); del(n); }
fn zap(holder mut* h) void {
    u64 mut* w = cast(h, u64 mut*);
    *w = 0;
}
fn user() void {
    holder mut h = holder{};
    h.first = new(node);
    zap(&h);
    drop_list(move(h.first));
}
fn main() i32 { user(); return 0; }
