// Probe m.ft of the delta review of PR 120: an owner output after a call.
struct node { i64 v; }
struct nholder { node mut* own item; }
fn nop() void {}
fn mis_leak(nholder mut* h, node mut* own n, node mut* own m) void {
    nop();
    node mut* own m2 = move(m);
    h->item = move(n);
    del(h->item);
}
fn nomis_leak(nholder mut* h, node mut* own n, node mut* own m) void {
    node mut* own m2 = move(m);
    h->item = move(n);
    del(h->item);
}
fn mis_read(nholder mut* h, node mut* own n, node mut* own m) i64 {
    nop();
    node mut* own m2 = move(m);
    h->item = move(n);
    del(h->item);
    i64 r = h->item->v;
    del(m2);
    return r;
}
fn mis_ok(nholder mut* h, node mut* own n, node mut* own m) void {
    nop();
    node mut* own m2 = move(m);
    h->item = move(n);
    del(h->item);
    del(m2);
}
fn main() i32 { return 0; }
