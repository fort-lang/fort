struct node { i32 v; node mut* own next; }
struct word { u64 bits; }
fn pun_owner() void {
    node mut* own mut p = new(node);
    word mut* w = cast(&p, word mut*);
    w->bits = 0;
    del(p);
}
fn pun_owner_u64() void {
    node mut* own mut p = new(node);
    u64 mut* w = cast(&p, u64 mut*);
    *w = 0;
    del(p);
}
fn main() i32 {
    pun_owner();
    pun_owner_u64();
    return 0;
}
