struct node { node mut* own next; i32 v; }
struct holder { node mut* own mut* w; }
fn take(holder h) void { *cast(h.w, u64 mut*) = 0; }
fn take_typed(holder h) void { *h.w = null; }
fn zap_elem(node mut* own mut@ xs) void { *cast(&xs[0], u64 mut*) = 0; }
fn zap_elem_typed(node mut* own mut@ xs) void { xs[0] = null; }
fn zap_ptr(node mut* own mut@ xs) void { u64 mut* w = cast(xs.ptr, u64 mut*); *w = 0; }
fn caller() void { node mut* own mut p = new(node); holder h = holder{&p}; take(h); del(p); }
fn main() i32 { caller(); return 0; }
