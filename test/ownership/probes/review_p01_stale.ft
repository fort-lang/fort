struct node { i32 v; node mut* own next; }
extern fn poke(bool mut* p) void;
extern fn poke_i(i32 mut* p) void;
fn drop_list(node mut* own n) void { if (n == null) { return; }
    drop_list(move(n->next)); del(n); }
fn stale_bool() void {
    i32 mut* own extra = new(i32);
    bool mut b = false;
    poke(&b);
    if (b) { return; }
    del(extra);
}
fn stale_int() void {
    i32 mut* own extra = new(i32);
    i32 mut k = 0;
    poke_i(&k);
    if (k != 0) { return; }
    del(extra);
}
fn stale_test() void {
    i32 mut* own extra = new(i32);
    node mut* own n = new(node);
    bool mut b = n == null;
    poke(&b);
    if (b) { drop_list(move(n)); return; }
    del(extra);
    drop_list(move(n));
}
fn stale_ptr_alias() void {
    i32 mut* own extra = new(i32);
    bool mut b = false;
    bool mut* p = &b;
    poke(p);
    if (b) { return; }
    del(extra);
}
fn main() i32 { stale_bool(); stale_int(); stale_test(); stale_ptr_alias(); return 0; }
