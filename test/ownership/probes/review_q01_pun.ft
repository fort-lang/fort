struct flagbox { bool f; }
struct halves { u8 lo; u8 hi; }
fn pun_struct() void {
    i32 mut* own extra = new(i32);
    bool mut b = false;
    flagbox mut* fb = cast(&b, flagbox mut*);
    fb->f = true;
    if (b) { return; }
    del(extra);
}
fn pun_halves() void {
    i32 mut* own extra = new(i32);
    u16 mut x = 256;
    halves mut* h = cast(&x, halves mut*);
    h->lo = 1;
    if (x == 256) { del(extra); return; }
}
fn pun_byte() void {
    i32 mut* own extra = new(i32);
    i32 mut x = 256;
    u8 mut* q = cast(&x, u8 mut*);
    *q = 1;
    if (x == 1) { del(extra); return; }
}
fn main() i32 {
    pun_struct();
    pun_halves();
    pun_byte();
    return 0;
}
