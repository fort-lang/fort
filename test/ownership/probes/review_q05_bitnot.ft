fn bitnot() void {
    i32 mut* own extra = new(i32);
    i32 x = 5;
    i32 y = ~x;
    if (y == 5) { del(extra); return; }
}
fn bitnot_u8() void {
    i32 mut* own extra = new(i32);
    u8 x = 0;
    u8 y = ~x;
    if (y < 1) { del(extra); return; }
}
fn main() i32 {
    bitnot();
    bitnot_u8();
    return 0;
}
