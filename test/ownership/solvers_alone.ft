/// Prints, for each named body of one source file, the verdict of the summary solver alone and of
/// the heap solver alone (D17.14, D17.18). Each solver solves the closure of every function of
/// the file.
///
/// Usage: solvers_alone <file.ft> <body>... Run it in an empty directory of its own: the test
/// environment writes its sandboxes there. The file must check with no diagnostic in a sandbox
/// whose `std` holds only a runtime. Each line of output is `<body> <summary> <heap>`, and each
/// verdict is `proved`, `failed` or `unproved`. `test/ownership_driver_test.py` gives it each
/// faulty body and holds that neither solver alone proves one outside the ledger
/// `test/ownership/solvers/false_accepts.txt`.
import ownership_gate_env;
import ownership_heap_env;
import ownership_recursive_env;
import std.sys;

fn main() i32 {
    string@ args = sys.args();
    if (args.len < 3) {
        eprintln("usage: solvers_alone <file.ft> <body>...");
        return 2;
    }
    ownership_gate_env.source mut file = ownership_gate_env.source{};
    defer ownership_gate_env.close(&file);
    if (!ownership_gate_env.read(&file, args[1])) {
        eprintln("solvers_alone: cannot read ", args[1]);
        return 2;
    }
    ownership_recursive_env.closure mut summaries = ownership_recursive_env.closure{};
    defer ownership_recursive_env.close(&summaries);
    ownership_recursive_env.open(&summaries, file.lines[..], file.names[..]);
    ownership_recursive_env.solve(&summaries);
    ownership_heap_env.closure mut heap = ownership_heap_env.closure{};
    defer ownership_heap_env.close(&heap);
    ownership_heap_env.run(&heap, file.lines[..], file.names[..]);
    u64 mut i = 2;
    while (i < args.len) {
        println(args[i], " ", ownership_gate_env.summary_verdict(&summaries, args[i]), " ",
            ownership_gate_env.heap_verdict(&heap, args[i]));
        i += 1;
    }
    return 0;
}
