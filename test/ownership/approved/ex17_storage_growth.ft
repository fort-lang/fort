struct buffer {
    u8 mut@ own data;
}
fn grow(buffer mut* b) void {
    u8 mut@ own next = new(u8, b->data.len + 1);
    del(b->data);
    b->data = move(next);
}
fn demo() u8 {
    buffer mut b = {new(u8, 1)};
    u8@ view = b.data;
    grow(&b);
    u8 value = view[0];
    del(b.data);
    return value;
}