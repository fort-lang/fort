/// The input-alias probes of the one-body witness checker, with two runs of each (D17.4, D17.18).
// Each body but `same_only` leaks `k` only when its inputs designate distinct storage. The
// checker validates each such loss under the conditions that name the referents, but for the
// bodies whose paths stop: they write over a slot that names a referent.
// `alias_runs <body> distinct` passes inputs that designate distinct storage, and the body
// leaks `k`. `alias_runs <body> alias` passes inputs that designate one storage, as the final
// review of PR 125 did, and the body leaks nothing. `same_only` leaks only when its inputs
// designate one storage. The checker takes no such relation, so its loss stays incomplete
// proof. `test/ownership_driver_test.py` holds both runs of each body. `mtrace` starts the
// glibc allocation trace that the test reads; without `libc_malloc_debug.so` it does nothing.
extern fn mtrace() void;

struct ib { i32 n; bool c; }
struct nd { nd mut* next; i32 n; }
struct pr { ib mut* a; ib mut* b; }
struct ha { i32[2] v; }
struct in2 { i32 x; }
struct ob { i32 n; in2 m; }
struct hd { ib mut* c; }
struct pr2 { ib mut* a; ib mut* b; }
struct pr3 { ib mut* a; ib mut* b; i32 n; }

fn al(ib mut* p, ib mut* q) void {
    p->n = 1;
    q->n = 2;
    i32 mut* own k = new(i32);
    if (p->n == 1) { return; }
    del(k);
}

fn al_next(nd mut* p) void {
    nd mut* r = p->next;
    p->n = 1;
    r->n = 2;
    i32 mut* own k = new(i32);
    if (p->n == 1) { return; }
    del(k);
}

fn copy_alias(ib mut* p, ib mut* q) void {
    q->n = 2;
    ib z = ib{};
    *p = z;
    i32 mut* own k = new(i32);
    if (q->n == 2) { return; }
    del(k);
}

fn width_alias(ib mut* p, i32 mut* q) void {
    p->n = 1;
    *q = 2;
    i32 mut* own k = new(i32);
    if (p->n == 1) { return; }
    del(k);
}

fn leaf_alias(pr r) void {
    r.a->n = 1;
    r.b->n = 2;
    i32 mut* own k = new(i32);
    if (r.a->n == 1) { return; }
    del(k);
}

fn equal_alias(nd mut* p, nd mut* q) void {
    nd mut* a = p->next;
    i32 x = a->n;
    q->next = null;
    i32 mut* own k = new(i32);
    if (a == p->next) { return; }
    del(k);
}

fn zero_alias(ib mut* p, ib mut* q) void {
    q->n = 1;
    *p = ib{};
    i32 mut* own k = new(i32);
    if (q->n == 1) { return; }
    del(k);
}

fn arr_alias(ha mut* p, i32 mut* q) void {
    *q = 2;
    ha z = ha{};
    p->v = z.v;
    i32 mut* own k = new(i32);
    if (*q == 2) { return; }
    del(k);
}

fn same_only(ib mut* p, ib mut* q) void {
    p->n = 1;
    q->n = 2;
    i32 mut* own k = new(i32);
    if (p->n == 2) { return; }
    del(k);
}

// Three inputs: one pair that designates one storage is enough to stop the leak.
fn three_alias(ib mut* p, ib mut* q, ib mut* r) void {
    p->n = 1;
    q->n = 2;
    r->n = 3;
    i32 mut* own k = new(i32);
    if (p->n == 1) { return; }
    del(k);
}

// The probes of the names (the review of 2026-10-16). A store through `a = &p->n` writes a part
// of the referent of `p`, so the note names `p`, and the run with `q = &o.m` breaks it.
fn sub_store(ob mut* p, in2 mut* q) void {
    q->x = 7;
    p->m.x = 1;
    i32 mut* a = &p->n;
    *a = 3;
    i32 mut* own k = new(i32);
    if (q->x == 7) { return; }
    del(k);
}

fn sub_read(ob mut* p, in2 mut* q) void {
    p->m.x = 7;
    i32 mut* a = &p->n;
    q->x = 0;
    i32 t = *a;
    i32 mut* own k = new(i32);
    if (p->m.x == 7) { return; }
    del(k);
}

// The local of the store changes before the read, so the note names the parameter `q`.
fn moved_local(ib mut* p, ib mut* q, ib mut* r) void {
    ib mut* mut w = q;
    p->n = 1;
    w->n = 2;
    w = r;
    i32 mut* own k = new(i32);
    if (p->n == 1) { return; }
    del(k);
}

// A store writes over the slot that names the referent of the store, so the path stops.
fn moved_field(ib mut* p, hd mut* h, ib mut* r) void {
    p->n = 1;
    h->c->n = 2;
    h->c = r;
    i32 mut* own k = new(i32);
    if (p->n == 1) { return; }
    del(k);
}

// One local holds both pointers; the note names `p` and the slot `(*(p)).next`.
fn self_name(nd mut* p) void {
    nd mut* mut cur = p->next;
    cur->n = 1;
    cur = p;
    cur->n = 2;
    cur = p->next;
    i32 mut* own k = new(i32);
    if (cur->n == 1) { return; }
    del(k);
}

// The local of the store ends before the read, so the note names the parameter `q`.
fn dead_local(ib mut* p, ib mut* q) void {
    p->n = 1;
    if (true) {
        ib mut* w = q;
        w->n = 2;
    }
    i32 mut* own k = new(i32);
    if (p->n == 1) { return; }
    del(k);
}

// A name of two slots: the note of `b` and `q` needs the pairs of `p`, `(*(p)).next` and `b`.
fn deep_name(nd mut* p, nd mut* q) void {
    nd mut* a = p->next;
    nd mut* b = a->next;
    b->n = 1;
    q->n = 2;
    i32 mut* own k = new(i32);
    if (b->n == 1) { return; }
    del(k);
}

// A zero store over `*p` writes over the slot that names the referent of `r`: the path stops.
fn zero_parent(nd mut* p, nd mut* q) void {
    q->n = 5;
    nd mut* r = p->next;
    r->n = 1;
    *p = nd{};
    i32 mut* own k = new(i32);
    if (q->n == 5) { return; }
    del(k);
}

// A copy over the parameter `r` writes over the slot `(r).a`: the path stops.
fn leaf_moved(pr2 mut r, pr2 t) void {
    ib mut* a = r.a;
    a->n = 1;
    r.b->n = 2;
    r = t;
    i32 mut* own k = new(i32);
    if (a->n == 1) { return; }
    del(k);
}

// The pair rules of `test/fort/ownership_witness_test.ft`. A second read of the pair, and a read
// in the other order, take no second note; a copy `r` of `q` makes the store, and the note
// names `q`.
fn twice_alias(ib mut* p, ib mut* q) void {
    p->n = 1;
    q->n = 2;
    i32 a = p->n;
    i32 mut* own k = new(i32);
    if (p->n == 1) { return; }
    del(k);
}

fn swap_alias(ib mut* p, ib mut* q) void {
    q->n = 1;
    i32 a = p->n;
    p->n = 2;
    i32 mut* own k = new(i32);
    if (q->n == 1) { return; }
    del(k);
}

fn rename_alias(ib mut* p, ib mut* q) void {
    p->n = 1;
    q->n = 2;
    ib mut* r = q;
    r->c = true;
    i32 mut* own k = new(i32);
    if (p->n == 1) { return; }
    del(k);
}

// Bodies that leak with one storage too: their notes are more than the leak needs.
fn known_alias(nd mut* p, nd mut* q) void {
    p->next = q;
    q->n = 2;
    nd mut* r = p->next;
    i32 mut* own k = new(i32);
    if (r->n == 2) { return; }
    del(k);
}

fn origin_alias(nd mut* p, nd mut* q) void {
    nd mut* r = p->next;
    i32 v = r->n;
    q->n = 1;
    i32 w = r->n;
    i32 mut* own k = new(i32);
}

// A store over the field `n` beside the pointer slots writes over no name.
fn leaf_kept(pr3 mut r) void {
    ib mut* a = r.a;
    a->n = 1;
    r.b->n = 2;
    r.n = 5;
    i32 mut* own k = new(i32);
    if (a->n == 1) { return; }
    del(k);
}

// A store over a `mut` parameter forgets its name, before the note (`moved_param`) or before
// its copy `w` reaches the referent (`copied_param`): each path stops.
fn moved_param(ib mut* p, ib mut* mut q, ib mut* r) void {
    p->n = 1;
    q->n = 2;
    q = r;
    i32 mut* own k = new(i32);
    if (p->n == 1) { return; }
    del(k);
}

fn copied_param(ib mut* p, ib mut* mut q, ib mut* r) void {
    ib mut* w = q;
    q = r;
    p->n = 1;
    w->n = 2;
    i32 mut* own k = new(i32);
    if (p->n == 1) { return; }
    del(k);
}

// Runs `body` with inputs that designate one storage when `alias` holds, else with inputs that
// designate distinct storage. It gives false for an unknown body.
fn run(string body, bool alias) bool {
    ib mut x = ib{};
    ib mut y = ib{};
    nd mut m = nd{};
    nd mut n = nd{};
    ha mut h = ha{};
    i32 mut z = 0;
    if (body == "al") {
        if (alias) { al(&x, &x); } else { al(&x, &y); }
    } else if (body == "al_next") {
        if (alias) { m.next = &m; } else { m.next = &n; }
        al_next(&m);
    } else if (body == "copy_alias") {
        if (alias) { copy_alias(&x, &x); } else { copy_alias(&x, &y); }
    } else if (body == "width_alias") {
        if (alias) { width_alias(&x, &x.n); } else { width_alias(&x, &z); }
    } else if (body == "leaf_alias") {
        if (alias) { leaf_alias(pr{&x, &x}); } else { leaf_alias(pr{&x, &y}); }
    } else if (body == "equal_alias") {
        m.next = &m;
        if (alias) { equal_alias(&m, &m); } else { equal_alias(&m, &n); }
    } else if (body == "zero_alias") {
        if (alias) { zero_alias(&x, &x); } else { zero_alias(&x, &y); }
    } else if (body == "arr_alias") {
        if (alias) { arr_alias(&h, &h.v[0]); } else { arr_alias(&h, &z); }
    } else if (body == "three_alias") {
        ib mut w = ib{};
        if (alias) { three_alias(&x, &y, &x); } else { three_alias(&x, &y, &w); }
    } else if (body == "sub_store") {
        ob mut o = ob{};
        in2 mut w = in2{};
        if (alias) { sub_store(&o, &o.m); } else { sub_store(&o, &w); }
    } else if (body == "sub_read") {
        ob mut o = ob{};
        in2 mut w = in2{};
        if (alias) { sub_read(&o, &o.m); } else { sub_read(&o, &w); }
    } else if (body == "moved_local") {
        if (alias) { moved_local(&x, &x, &y); } else { moved_local(&x, &y, &y); }
    } else if (body == "moved_field") {
        hd mut g = hd{};
        if (alias) { g.c = &x; } else { g.c = &y; }
        moved_field(&x, &g, &y);
    } else if (body == "self_name") {
        if (alias) { m.next = &m; } else { m.next = &n; }
        self_name(&m);
    } else if (body == "dead_local") {
        if (alias) { dead_local(&x, &x); } else { dead_local(&x, &y); }
    } else if (body == "deep_name") {
        nd mut o = nd{};
        nd mut w = nd{};
        m.next = &n;
        n.next = &o;
        if (alias) { deep_name(&m, &o); } else { deep_name(&m, &w); }
    } else if (body == "zero_parent") {
        m.next = &n;
        nd mut w = nd{};
        if (alias) { zero_parent(&m, &n); } else { zero_parent(&m, &w); }
    } else if (body == "leaf_moved") {
        ib mut w = ib{};
        if (alias) { leaf_moved(pr2{&x, &x}, pr2{&w, &w}); } else {
            leaf_moved(pr2{&x, &y}, pr2{&w, &w}); }
    } else if (body == "twice_alias") {
        if (alias) { twice_alias(&x, &x); } else { twice_alias(&x, &y); }
    } else if (body == "swap_alias") {
        if (alias) { swap_alias(&x, &x); } else { swap_alias(&x, &y); }
    } else if (body == "rename_alias") {
        if (alias) { rename_alias(&x, &x); } else { rename_alias(&x, &y); }
    } else if (body == "known_alias") {
        if (alias) { known_alias(&m, &m); } else { known_alias(&m, &n); }
    } else if (body == "origin_alias") {
        m.next = &n;
        nd mut w = nd{};
        if (alias) { origin_alias(&m, &n); } else { origin_alias(&m, &w); }
    } else if (body == "leaf_kept") {
        if (alias) { leaf_kept(pr3{&x, &x, 0}); } else { leaf_kept(pr3{&x, &y, 0}); }
    } else if (body == "moved_param") {
        if (alias) { moved_param(&x, &x, &y); } else { moved_param(&x, &y, &y); }
    } else if (body == "copied_param") {
        if (alias) { copied_param(&x, &x, &y); } else { copied_param(&x, &y, &y); }
    } else if (body == "same_only") {
        if (alias) { same_only(&x, &x); } else { same_only(&x, &y); }
    } else {
        return false;
    }
    return true;
}

fn main(string@ argv) i32 {
    if (argv.len != 3 || (argv[2] != "alias" && argv[2] != "distinct")) { return 2; }
    mtrace();
    if (!run(argv[1], argv[2] == "alias")) { return 2; }
    return 0;
}
