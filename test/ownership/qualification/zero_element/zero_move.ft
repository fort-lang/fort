//! run
//! stdout:
//| 0 true
// A move of a zero-element allocation transfers its release obligation once. The new owner
// releases it (D17.14, D17.16, D17.17).
fn main() i32 {
    u8 mut@ own empty = new(u8, 0);
    u8 mut@ own next = move(empty);
    println(next.len, " ", empty.ptr == null);
    del(next);
    return 0;
}
