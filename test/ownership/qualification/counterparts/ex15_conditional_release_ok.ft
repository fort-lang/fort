//! run
//! stdout:
//| 15 15
// Counterpart of approved example 15: the view is read before the conditional release. The
// second del meets a live or an empty owner on each path (D17.9, D17.14).
fn demo(bool release) i32 {
    i32 mut* own p = new(i32);
    *p = 15;
    i32* view = p;
    i32 value = *view;
    if (release) {
        del(p);
    }
    del(p);
    return value;
}

fn main() i32 {
    println(demo(true), " ", demo(false));
    return 0;
}
