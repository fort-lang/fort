//! run
//! stdout:
//| 5
// Counterpart of approved example 4: the old view is read before the release, and the
// refilled owner is read through itself (D17.14, D17.16).
fn demo() i32 {
    i32 mut* own mut p = new(i32);
    *p = 4;
    i32* old = p;
    i32 value = *old;
    del(p);
    p = new(i32);
    *p = value + 1;
    i32 result = *p;
    del(move(p));
    return result;
}

fn main() i32 {
    println(demo());
    return 0;
}
