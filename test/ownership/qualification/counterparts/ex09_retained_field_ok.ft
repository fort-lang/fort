//! run
//! stdout:
//| 9
// Counterpart of approved example 9: the retained field is read before the release. The
// dangling field is not used after the release (D17.14).
struct view_box {
    i32* ptr;
}

fn remember(view_box mut* out, i32* value) void {
    out->ptr = value;
}

fn demo() i32 {
    i32 mut* own p = new(i32);
    *p = 9;
    view_box mut saved = {};
    remember(&saved, p);
    i32 value = *saved.ptr;
    del(p);
    return value;
}

fn main() i32 {
    println(demo());
    return 0;
}
