//! run
//! stdout:
//| 3
// Counterpart of approved example 16 (the leak): each iteration releases its allocation before
// its loop-body storage ends (D17.14).
fn good(u64 n) u64 {
    u64 mut i = 0;
    while (i < n) {
        i32 mut* own p = new(i32);
        del(p);
        i += 1;
    }
    return i;
}

fn main() i32 {
    println(good(3));
    return 0;
}
