//! run
//! stdout:
//| done
// Counterpart of approved example 14: the old owning field is released before the aggregate
// store, so the replacement discards no obligation (D17.11, D17.14).
struct box {
    i32 mut* own ptr;
}

fn demo() void {
    box mut value = {new(i32)};
    del(value.ptr);
    value = box{new(i32)};
    del(value.ptr);
}

fn main() i32 {
    demo();
    println("done");
    return 0;
}
