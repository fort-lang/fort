//! run
//! stdout:
//| 21
// An owning global is filled, read and released before the normal exit, so the global is
// empty at the final obligation boundary (D17.19).
i32 mut* own mut cell = null;

fn fill() void {
    cell = new(i32);
    *cell = 21;
}

fn main() i32 {
    fill();
    println(*cell);
    del(cell);
    return 0;
}
