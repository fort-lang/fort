//! run
//! stdout:
//| 8
// Counterpart of approved example 8: the function returns a value copy, so the deferred
// release ends no returned borrow (D17.14).
fn good() i32 {
    i32 mut* own p = new(i32);
    defer del(p);
    *p = 8;
    i32* view = p;
    return *view;
}

fn main() i32 {
    println(good());
    return 0;
}
