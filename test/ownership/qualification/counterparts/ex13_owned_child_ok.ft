//! run
//! stdout:
//| done
// Counterpart of approved example 13: the child is released before its parent, because del
// stays shallow (D17.16).
struct node {
    i32 mut* own child;
}

fn demo() void {
    node mut* own parent = new(node);
    parent->child = new(i32);
    del(parent->child);
    del(parent);
}

fn main() i32 {
    demo();
    println("done");
    return 0;
}
