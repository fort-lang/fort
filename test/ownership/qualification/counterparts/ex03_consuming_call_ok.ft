//! run
//! stdout:
//| 3
// Counterpart of approved example 3: the view is read before the consuming call (D17.14).
fn drop(i32* own p) void {
    del(p);
}

fn demo() i32 {
    i32 mut* own p = new(i32);
    *p = 3;
    i32* view = p;
    i32 value = *view;
    drop(move(p));
    return value;
}

fn main() i32 {
    println(demo());
    return 0;
}
