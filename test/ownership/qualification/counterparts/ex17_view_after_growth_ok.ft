//! run
//! stdout:
//| 17 2
// Counterpart of approved example 17: the view is taken after the growth call, so it refers to
// the live replacement storage (D17.14, D17.15).
struct buffer {
    u8 mut@ own data;
}

fn grow(buffer mut* b) void {
    u8 mut@ own next = new(u8, b->data.len + 1);
    del(b->data);
    b->data = move(next);
}

fn demo() u8 {
    buffer mut b = {new(u8, 1)};
    grow(&b);
    b.data[0] = 17;
    u8@ view = b.data;
    u8 value = view[0];
    println(value, " ", view.len);
    del(b.data);
    return value;
}

fn main() i32 {
    demo();
    return 0;
}
