//! run
//! stdout:
//| 65
// Counterpart of approved example 18: the retained key is read before its character
// allocation is released (D17.14).
struct entry {
    string key;
}

fn put(entry mut* e, string key) void {
    e->key = key;
}

fn demo() u8 {
    u8 mut@ own bytes = new(u8, 2);
    bytes[0] = 65;
    entry mut e = {};
    put(&e, cast(bytes, string));
    u8 value = cast(e.key[0], u8);
    del(bytes);
    return value;
}

fn main() i32 {
    println(demo());
    return 0;
}
