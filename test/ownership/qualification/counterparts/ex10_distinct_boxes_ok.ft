//! run
//! stdout:
//| 10
// Counterpart of approved example 10: the two parameters name distinct boxes, so the release
// through the first does not end the source of the second (D17.15).
struct box {
    i32 mut* own item;
}

fn release_then_read(box mut* a, box* b) i32 {
    del(a->item);
    return *b->item;
}

fn demo() i32 {
    box mut first = {new(i32)};
    box mut second = {new(i32)};
    *second.item = 10;
    i32 value = release_then_read(&first, &second);
    del(second.item);
    return value;
}

fn main() i32 {
    println(demo());
    return 0;
}
