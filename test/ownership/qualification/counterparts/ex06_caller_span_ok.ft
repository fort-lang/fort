//! run
//! stdout:
//| 2 2
// Counterpart of approved example 6: the returned span refers to caller storage (D17.14).
fn head(u8@ bytes) u8@ {
    return bytes[0..2];
}

fn main() i32 {
    u8[4] bytes = {1, 2, 3, 4};
    u8@ first = head(bytes[..]);
    println(first.len, " ", first[1]);
    return 0;
}
