//! run
//! stdout:
//| 20
// Counterpart of approved example 20 (the lost source): the pointer comes from fort storage
// through a void-pointer round trip, which keeps its source and extent (D17.17).
fn read(void* raw) u8 {
    u8* p = cast(raw, u8*);
    return *p;
}

fn main() i32 {
    u8 mut@ own bytes = new(u8, 1);
    bytes[0] = 20;
    u8 value = read(cast(bytes.ptr, void*));
    del(bytes);
    println(value);
    return 0;
}
