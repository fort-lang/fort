//! run
//! stdout:
//| 6
// A range loop over a view that a call returns. The view aliases the owner, and the owner is
// released only after the loop (D17.10, D17.14).
fn view_of(u8@ bytes) u8@ {
    return bytes;
}

fn main() i32 {
    u8 mut@ own s = new(u8, 3);
    s[0] = 1;
    s[1] = 2;
    s[2] = 3;
    u8@ v = view_of(s);
    u64 mut sum = 0;
    for (u8 x : v) {
        sum += cast(x, u64);
    }
    println(sum);
    del(s);
    return 0;
}
