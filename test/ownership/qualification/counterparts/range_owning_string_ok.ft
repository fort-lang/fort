//! run
//! stdout:
//| abc 3
// A range loop over an owning string reads one captured header and lends each element. The
// owner is released after the loop (D7.5, D17.10, D17.14).
import std.str;

fn main() i32 {
    string own text = str.concat("ab", "c");
    u64 mut count = 0;
    for (char c : text) {
        print(c);
        count += 1;
    }
    println(" ", count);
    del(text);
    return 0;
}
