//! run
//! stdout:
//| 30
// A range loop over a view local that is reassigned before the loop. The loop reads the second
// owner, and both owners are released after the loop (D17.10, D17.14, D17.15).
fn main() i32 {
    u8 mut@ own a = new(u8, 2);
    u8 mut@ own b = new(u8, 2);
    a[0] = 1;
    b[0] = 10;
    b[1] = 20;
    u8@ mut v = a;
    v = b;
    u64 mut sum = 0;
    for (u8 x : v) {
        sum += cast(x, u64);
    }
    println(sum);
    del(a);
    del(b);
    return 0;
}
