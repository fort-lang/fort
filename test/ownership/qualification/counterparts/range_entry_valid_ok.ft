//! run
//! stdout:
//| 4 2
// A borrowed collection is live when its range loop starts: the owner moves to a new local
// before the view is taken, and the new owner is released after the loop (D17.10, D17.14).
fn main() i32 {
    u8 mut@ own first = new(u8, 2);
    first[0] = 1;
    first[1] = 3;
    u8 mut@ own second = move(first);
    u8@ view = second;
    u64 mut sum = 0;
    for (u8 x : view) {
        sum += cast(x, u64);
    }
    println(sum, " ", view.len);
    del(second);
    return 0;
}
