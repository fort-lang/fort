//! run
//! stdout:
//| 15
// Counterpart of approved example 12: the moved pointer is read through its new owner, and
// the other field of the aggregate stays readable (D17.15).
struct inner {
    i32 mut* own ptr;
}

struct outer {
    inner part;
    i32 tag;
}

fn demo() i32 {
    outer mut value = {inner{new(i32)}, 3};
    i32 mut* own taken = move(value.part.ptr);
    *taken = 12;
    i32 result = *taken + value.tag;
    del(taken);
    return result;
}

fn main() i32 {
    println(demo());
    return 0;
}
