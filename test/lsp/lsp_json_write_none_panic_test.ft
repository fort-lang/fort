//! run
//! flags: -I ../../src -I ../fort/support
//! abort
//! stderr: panic: json.write_value: the absent value
//! stdout:
//| 7
/// Only handle 0 is a k_none node, and node_of refuses handle 0. The test changes the kind of
/// the root to k_none after the parse, so write_value panics on it.
import lsp.json;
import std.strbuf;

// A store through a pointer: the owner is no local owner here (D17.21).
fn set_root_kind_none(json.doc mut* d) void {
    d->chunks[0]->slots[cast(json.root(d), u64)].kind = json.value_kind.k_none;
}

fn main() i32 {
    json.doc mut d = json.create();
    defer json.free(&d);
    assert(json.parse(&d, "7"));
    strbuf.str_buf mut out = strbuf.create();
    defer strbuf.free(&out);
    json.writer mut w = json.writer{};
    json.write_init(&w, &out);
    json.write_value(&w, &d, json.root(&d));
    println(strbuf.view(&out));
    set_root_kind_none(&d);
    json.write_value(&w, &d, json.root(&d));
    return 0;
}
