//! run
//! flags: -I ../../src/fort -I ../fort/support -I ../../src
//! abort
//! stderr: panic: json.write_begin: nesting too deep
//! stdout:
//| at the limit ok
/// The writer allows JSON_MAX_DEPTH open containers, which is the reader's
/// limit as well, so a tree the reader built always writes. One more is a
/// violated precondition and panics.
import lsp.json;
import std.strbuf;

fn main() i32 {
    strbuf.str_buf mut out = strbuf.create();
    defer strbuf.free(&out);
    json.writer mut w = json.writer{};
    json.write_init(&w, &out);
    u64 mut i = 0;
    while (i < json.JSON_MAX_DEPTH) {
        json.write_array_begin(&w);
        i += 1;
    }
    println("at the limit ok");
    json.write_array_begin(&w);
    println(strbuf.view(&out));
    return 0;
}
