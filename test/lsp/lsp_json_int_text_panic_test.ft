//! run
//! flags: -I ../../src/fort -I ../fort/support -I ../../src
//! abort
//! stderr: panic: json.int_of: the text is not an i64
//! stdout:
//| 7
/// The reader makes a k_int node only for text that str.parse_i64 reads. The test changes
/// the bytes of the document after the parse, so int_of reads `x` and panics.
import lsp.json;
import std.strbuf;

fn main() i32 {
    json.doc mut d = json.create();
    defer json.free(&d);
    assert(json.parse(&d, "7"));
    println(json.int_of(&d, json.root(&d)));
    strbuf.clear(&d.bytes);
    strbuf.append(&d.bytes, "x");
    json.int_of(&d, json.root(&d));
    return 0;
}
