//! run
//! flags: -I ../../src/fort -I ../fort/support -I ../../src
//! abort
//! stderr: panic: json.node_of: not a handle of this document
//! stdout:
//| a handle of the document ok
/// Checks that JSON access rejects absent, foreign, and out-of-range handles. json.has provides
/// the non-panicking query.
import lsp.json;

fn main() i32 {
    json.doc mut d = json.create();
    defer json.free(&d);
    assert(json.parse(&d, "[1]"));
    assert(json.kind_of(&d, json.root(&d)) == json.value_kind.k_array);
    assert(!json.has(&d, 0));
    assert(!json.has(&d, 99));
    println("a handle of the document ok");
    println(cast(json.kind_of(&d, 99), u64));
    return 0;
}
