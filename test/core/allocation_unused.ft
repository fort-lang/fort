/// allocation_unused.ft: require an allocation failure when storage is unused.
//
// The optimizer must keep the libc call even when del releases the block
// without a read. The count fits u64 and asks the target for too much storage.
fn main() i32 {
    u8 mut@ own storage = new(u8, 9223372036854775807);
    del(storage);
    return 0;
}
