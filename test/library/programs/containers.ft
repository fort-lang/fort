/// Uses the containers of std: a vector, a map and a sort, and a digest that std returns as an
/// array, which the library passes back through the result pointer.
import std.digest.sha256;
import std.sort;
import std.str;
import std.strmap;
import std.vec;

fn main() i32 {
    vec.int_vec mut v = vec.int_create();
    defer vec.int_free(&v);
    i64 mut i = 0;
    while (i < 100) {
        vec.int_push(&v, (i * 37) % 101);
        i += 1;
    }
    sort.sort_i64(v.items[0..v.len], sort.cmp_i64);
    println(v.items[0], ' ', v.items[50], ' ', v.items[99], ' ', v.len);
    strmap.str_map mut m = strmap.create();
    defer strmap.free(&m);
    strmap.put(&m, "one", 1);
    strmap.put(&m, "two", 2);
    strmap.put(&m, "one", 11);
    i64 mut got = 0;
    println(strmap.get(&m, "one", &got), ' ', got, ' ', strmap.count(&m));
    println(strmap.has(&m, "three"), ' ', str.cmp("abc", "abd"), ' ', str.hash("fort"));
    u8[32] digest = sha256.hash(cast("abc", u8@));
    u64 mut k = 0;
    while (k < 4) {
        print(digest[k], ' ');
        k += 1;
    }
    println();
    return 0;
}
