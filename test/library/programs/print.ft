/// Writes a value of each printed kind through the runtime of std, and text through std.io and
/// std.strbuf, so each print entry of std.rt is a call into the library.
import std.io;
import std.strbuf;

fn main() i32 {
    i64 low = -9223372036854775807 - 1;
    u64 high = 18446744073709551615;
    print(low);
    print(' ');
    println(high);
    println(true, ' ', false);
    println(1.5, ' ', -0.0, ' ', 1.0e300);
    f32 small = 0.25;
    println(small);
    println("text with a \t tab");
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "built ");
    strbuf.append_i64(&b, -42);
    strbuf.append_u64(&b, 7);
    // the print family buffers stdout, so it flushes before the direct write
    io.flush(io.STDOUT);
    io.write_all(io.STDOUT, strbuf.bytes(&b));
    println();
    return 0;
}
