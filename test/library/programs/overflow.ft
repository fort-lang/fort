/// Stops in a runtime error of the entry module: the check calls the runtime entry of std.rt,
/// which the entry unit declares and the library defines.
fn add(i32 a, i32 b) i32 {
    return a + b;
}

fn main(string@ args) i32 {
    println("before");
    i32 big = 2147483600 + cast(args.len, i32);
    println(add(big, 100));
    return 0;
}
