/// Stops in a panic inside std: the message names the file of std that the build opened, and the
/// output before it is flushed.
import std.vec;

fn main() i32 {
    vec.int_vec mut v = vec.int_create();
    defer vec.int_free(&v);
    vec.int_push(&v, 4);
    println(vec.int_pop(&v));
    println(vec.int_pop(&v));
    return 0;
}
