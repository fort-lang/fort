/// Writes the arguments after the program name: the C `main` of the entry unit builds them
/// with the runtime entries of std.rt, and std.sys hands them out again.
import std.sys;

fn main(string@ args) i32 {
    println(args.len);
    u64 mut i = 1;
    while (i < args.len) {
        println("[", args[i], "]");
        i += 1;
    }
    string@ again = sys.args();
    println(again.len == args.len);
    return cast(args.len, i32);
}
