/// Reads the constants and a `mut` global of std: a folded scalar, an element of an array
/// constant at an index known only at run time, a copy of an array constant, a string constant
/// and the address of a constant, which the entry unit reads from the library object.
import std.digest.sha256;
import std.libc;
import std.os;
import std.rt;

fn main(string@ args) i32 {
    println(libc.O_CREAT, ' ', libc.EEXIST, ' ', sha256.BLOCK);
    u64 at = args.len + 2;
    println(sha256.K[at], ' ', sha256.K[63]);
    u32[8] h = sha256.H0;
    println(h[0], ' ', h[7]);
    println(os.TARGET);
    u64* block = &sha256.BLOCK;
    println(*block);
    println(rt.buffers_ready);
    print("flushed");
    println(rt.buffers_ready);
    return 0;
}
