/// The program of the chain: it reaches `aaa` only through `zzz`. Each `lib.a` holds one member,
/// so GNU ld pulls the member of `aaa` only when it scans `aaa.a` after `zzz.a`.
import zzz.top;

fn main() i32 {
    println("twice ", top.twice());
    println("total ", top.total());
    println("counter ", top.count());
    return 0;
}
