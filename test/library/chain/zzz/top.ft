/// The second library of the chain: it uses `aaa`, so the link names it before `aaa`, against
/// the byte order of the names.
import aaa.base;

fn twice() i32 {
    return base.bump() + base.bump();
}

fn total() i64 {
    return base.sum(base.make(base.LIMIT, 2));
}

// The global of `aaa`, read across the unit.
fn count() i32 {
    return base.counter;
}
