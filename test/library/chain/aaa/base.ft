/// The first library of the chain that test/library/use_test.py links: a mutable global, a
/// constant and a struct that crosses a unit by value.
struct pair {
    i64 a;
    i64 b;
}

i32 mut counter = 40;
i64 LIMIT = 1000;

fn bump() i32 {
    counter += 1;
    return counter;
}

fn make(i64 a, i64 b) pair {
    return pair{a, b};
}

fn sum(pair p) i64 {
    return p.a + p.b;
}
