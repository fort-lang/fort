//! run
//! stdout:
//| 3 7 7 7
//| 2 30
fn void alloc_fill(mut i32[] own* out, u64 n, i32 v) {
    *out = new(i32[n]);
    for (mut u64 i = 0; i < n; i++) {
        (*out)[i] = v;
    }
}

fn i32 pick(i32[4]* arr, i32 i) {
    return (*arr)[i];
}

fn i32 main() {
    own mut i32[] s = {};
    alloc_fill(&s, 3, 7);
    println(s.len, " ", s[0], " ", s[1], " ", s[2]);
    i32[4] fixed = {10, 20, 30, 40};
    i32[4]* p = &fixed;
    println(pick(p, 2) / 15, " ", (*p)[2]);
    del(s);
    return 0;
}
