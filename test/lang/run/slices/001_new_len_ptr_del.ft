//! run
//! stdout:
//| 5 0 true
//| 0 1 2 3 4
//| 0 true
//| 3 7 0 true
fn i32 main() {
    own mut i32[] s = new(i32[5]);
    u64 n = s.len;
    println(n, " ", s[0], " ", s.ptr != null);
    for (mut u64 i = 0; i < s.len; i++) {
        s[i] = cast(i, i32);
    }
    for (mut u64 i = 0; i < s.len; i++) {
        print(s[i]);
        if (i + 1 < s.len) {
            print(" ");
        }
    }
    println();
    del(s);
    i32[] z = {};
    println(z.len, " ", z.ptr == null);
    u8 small = 3;
    i64 big = 7;
    own mut u8[] a = new(u8[small]);
    own mut f64[] b = new(f64[big]);
    own i32[] e = new(i32[0]);
    println(a.len, " ", b.len, " ", e.len, " ", e.ptr != null);
    del(a);
    del(b);
    del(e);
    return 0;
}
