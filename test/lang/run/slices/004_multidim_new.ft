//! run
//! stdout:
//| 3 4 0
//| 5 5
//| 10
fn i32 main() {
    i32 n = 3;
    own mut i32[][4] g = new(i32[n][4]);
    println(g.len, " ", g[1].len, " ", g[2][3]);
    g[1][2] = 5;
    i32[4] row = g[1];
    println(g[1][2], " ", row[2]);
    mut i32 total = 0;
    for (i32[4] r : g) {
        for (i32 v : r) {
            total += v;
        }
    }
    total += 5;
    println(total);
    del(g);
    return 0;
}
