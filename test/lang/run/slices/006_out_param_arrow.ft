//! run
//! stdout:
//| 0 true 4 104 107
//| true 8 false
//| 12 1
fn bool fill_bytes(u8 mut@ own mut* out, u64 n) {
    if (n == 0) {
        return false;
    }
    *out = new(u8, n);
    for (u64 mut i = 0; i < out->len; i++) {
        (*out)[i] = cast(104 + i, u8);
    }
    return true;
}

fn u64 total_len(u8@* a, u8@* b) {
    return a->len + b->len;
}

fn i32 main() {
    u8 mut@ own mut bytes = {};
    u8 mut@ own mut* p = &bytes;
    println(p->len, " ", fill_bytes(p, 4), " ", p->len, " ", bytes[0], " ", bytes[3]);
    u8@ view = bytes;
    println(bytes.ptr == p->ptr, " ", total_len(&bytes, &view), " ", fill_bytes(p, 0));
    i32[3] fixed = {1, 2, 3};
    i32[3] mut copy = fixed;
    i32[3] mut* fp = &copy;
    (*fp)[0] = 9;
    println((*fp)[0] + (*fp)[2], " ", fixed[0]);
    del(bytes);
    return 0;
}
