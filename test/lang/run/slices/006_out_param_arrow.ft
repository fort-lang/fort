//! run
//! stdout:
//| 0 true 4 104 107
//| true 8 false
//| 12 1
fn bool fill_bytes(mut u8[]* out, u64 n) {
    if (n == 0) {
        return false;
    }
    *out = new(u8[n]);
    for (mut u64 i = 0; i < out->len; i++) {
        (*out)[i] = cast(104 + i, u8);
    }
    return true;
}

fn u64 total_len(u8[]* a, u8[]* b) {
    return a->len + b->len;
}

fn i32 main() {
    mut u8[] bytes = {};
    mut u8[]* p = &bytes;
    println(p->len, " ", fill_bytes(p, 4), " ", p->len, " ", bytes[0], " ", bytes[3]);
    u8[] view = bytes;
    println(bytes.ptr == p->ptr, " ", total_len(&bytes, &view), " ", fill_bytes(p, 0));
    i32[3] fixed = {1, 2, 3};
    mut i32[3] copy = fixed;
    mut i32[3]* fp = &copy;
    (*fp)[0] = 9;
    println((*fp)[0] + (*fp)[2], " ", fixed[0]);
    del(bytes);
    return 0;
}
