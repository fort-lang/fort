//! run
//! stdout:
//| 42 42
//| 7 7
//| 1 1 1
fn void fill(mut i32[] s, i32 v) {
    for (mut u64 i = 0; i < s.len; i++) {
        s[i] = v;
    }
}

fn i32 main() {
    mut i32[] s = new(i32[4]);
    mut i32[] sub = s[1..3];
    sub[0] = 42;
    println(s[1], " ", sub[0]);
    mut i32[] alias = s;
    alias[3] = 7;
    println(s[3], " ", alias[3]);
    fill(s[..3], 1);
    println(s[0], " ", s[2], " ", sub[1]);
    del(s);
    return 0;
}
