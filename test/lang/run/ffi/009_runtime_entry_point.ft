//! run
//! stdout:
//| 7 true
// The standard library reaches the runtime through ordinary `extern fn`
// declarations (D13.1), and so may a program: a declaration that agrees with
// the canonical signature of toolchain.md 5.1 is called through that
// prototype, with no variadic tail (toolchain.md 6 item 8). Agreement is by
// IR form (D9.9), so `char` is what a `uint8_t` parameter takes, being C's
// `unsigned char` (D3.2), `u32` is an `int32_t`'s form, and every pointer is
// one pointer. `fort_rt_exit` is `_Noreturn` and is declared here as `void`,
// which claims less and passes the same values: the compiler stamps the
// `noreturn` attribute from its own table, so the call still exits, and the
// `return` below it is unreachable code fort's flow analysis nevertheless
// requires.
extern fn void fort_rt_print_i64(i32 fd, i64 v);
extern fn void fort_rt_print_char(i32 fd, char c);
extern fn void fort_rt_print_bool(i32 fd, u8 b);
extern fn void fort_rt_print_str(i32 fd, void* ptr, u64 len);
extern fn void fort_rt_flush(u32 fd);
extern fn void fort_rt_exit(i32 status);

fn i32 main() {
    fort_rt_print_i64(1, 7);
    fort_rt_print_char(1, ' ');
    fort_rt_print_bool(1, 1);
    fort_rt_print_str(1, cast("\n".ptr, void*), 1);
    fort_rt_flush(1);
    fort_rt_exit(0);
    return 1;
}
