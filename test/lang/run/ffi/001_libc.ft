//! run
//! stdout:
//| hi
//| 3 5 0 7
extern fn strlen(char* s) u64;
extern fn abs(i32 x) i32;
extern fn write(i32 fd, u8* buf, u64 n) i64;

fn main() i32 {
    string msg = "hi\n";
    i64 w = write(1, cast(msg.ptr, u8*), msg.len);
    println(w, " ", strlen("hello".ptr), " ", strlen("".ptr), " ", abs(-7));
    return 0;
}
