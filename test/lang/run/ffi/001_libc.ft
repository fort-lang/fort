//! run
//! stdout:
//| hi
//| 3 5 0 7
import extern;
// C: strlen, ISO C11 7.24.6.3, strlen(3).
// writes: nothing; C reads s to its NUL. gives: the count of bytes before the NUL. keeps: no
// pointer. calls: no fort function. frees: nothing.
extern fn strlen(char* s) u64;
// C: abs, ISO C11 7.22.6.1, abs(3).
// gives: an int and no pointer. writes: no fort storage. keeps: no pointer. calls: no fort
// function. frees: nothing.
extern fn abs(i32 x) i32;
// C: write, write(2) of POSIX.1-2017.
// writes: nothing in fort storage; C reads at most n bytes at buf. gives: the count of bytes, or
// -1. keeps: no pointer. calls: no fort function. frees: nothing.
extern fn write(i32 fd, u8* buf, u64 n) i64;

// C call write: cast(msg, u8@).ptr keeps the bound of the literal msg, msg.len bytes (D9.8 rule 2),
// and the length msg.len fits it.
// C call strlen x2: "hello".ptr and "".ptr name string literals, and strlen reads each to the NUL
// of its literal (rule 4, D3.7).
// C call abs: no pointer argument.
fn main() i32 {
    string msg = "hi\n";
    i64 w = write(1, cast(msg, u8@).ptr, msg.len);
    println(w, " ", strlen("hello".ptr), " ", strlen("".ptr), " ", abs(-7));
    return 0;
}
