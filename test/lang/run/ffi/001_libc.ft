//! run
//! stdout:
//| hi
//| 3 5 0 7
extern fn u64 strlen(char* s);
extern fn i32 abs(i32 x);
extern fn i64 write(i32 fd, u8* buf, u64 n);

fn i32 main() {
    string msg = "hi\n";
    i64 w = write(1, cast(msg.ptr, u8*), msg.len);
    println(w, " ", strlen("hello".ptr), " ", strlen("".ptr), " ", abs(-7));
    return 0;
}
