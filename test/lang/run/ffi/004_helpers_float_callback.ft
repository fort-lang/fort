//! run
//! link: ffi/helpers.c
//! stdout:
//| 4.5
//| 30 -9
extern fn f64 helper_scale(f64 x, i32 k);
extern fn i32 helper_apply(fn i32(i32) cb, i32 x);

fn i32 triple(i32 x) {
    return x * 3;
}

fn i32 negate(i32 x) {
    return -x;
}

fn i32 main() {
    println(helper_scale(1.5, 3));
    println(helper_apply(triple, 10), " ", helper_apply(negate, 9));
    return 0;
}
