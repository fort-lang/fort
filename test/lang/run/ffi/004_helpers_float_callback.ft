//! run
//! link: ffi/helpers.c
//! stdout:
//| 4.5
//| 6.25
//| 2.5
import extern;
// A float crosses the boundary in an SSE register in both directions, as an
// argument, as a result, and through a function pointer C calls back (D9.9).
// The integer half of these helpers is run/ffi/005, which bootstrap-0 supports.
// C: helper_scale, test/lang/ffi/helpers.c, which gives x * k.
// gives: a double and no pointer. writes: no fort storage. keeps: no pointer. calls: no fort
// function. frees: nothing.
extern fn helper_scale(f64 x, i32 k) f64;
// C: helper_apply_f64, test/lang/ffi/helpers.c, which gives cb(x).
// gives: the double that cb gives and no pointer. calls: cb once, with the arguments that follow
// it; cb is a fort function that the caller gives. writes: no fort storage. keeps: no pointer: C
// does not keep cb after the call. frees: nothing.
extern fn helper_apply_f64(fn (f64) f64 cb, f64 x) f64;

fn square(f64 x) f64 {
    return x * x;
}

fn halve(f64 x) f64 {
    return x / 2.0;
}

// C call helper_scale: no pointer argument.
// C call helper_apply_f64 x2: square and halve, fort functions that take and give an f64 and are no
// boundary functions; no pointer argument.
fn main() i32 {
    println(helper_scale(1.5, 3));
    println(helper_apply_f64(square, 2.5));
    println(helper_apply_f64(halve, 5.0));
    return 0;
}
