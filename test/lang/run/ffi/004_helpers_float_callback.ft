//! run
//! link: ffi/helpers.c
//! stdout:
//| 4.5
//| 6.25
//| 2.5
// A float crosses the boundary in an SSE register in both directions, as an
// argument, as a result, and through a function pointer C calls back (D9.9).
// The integer half of these helpers is run/ffi/005, which stage1 supports.
extern fn f64 helper_scale(f64 x, i32 k);
extern fn f64 helper_apply_f64(fn f64(f64) cb, f64 x);

fn f64 square(f64 x) {
    return x * x;
}

fn f64 halve(f64 x) {
    return x / 2.0;
}

fn i32 main() {
    println(helper_scale(1.5, 3));
    println(helper_apply_f64(square, 2.5));
    println(helper_apply_f64(halve, 5.0));
    return 0;
}
