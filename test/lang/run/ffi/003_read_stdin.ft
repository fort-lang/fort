//! run
//! stdin:
//< hello
//< world
//! stdout:
//| hello
//| world
//| 12 2
extern fn i64 read(i32 fd, void* buf, u64 n);

fn i32 main() {
    own mut u8[] buf = new(u8[64]);
    defer del(buf);
    mut u64 total = 0;
    while (total < buf.len) {
        i64 n = read(0, cast(&buf[total], void*), buf.len - total);
        if (n <= 0) {
            break;
        }
        total += cast(n, u64);
    }
    string text = cast(buf[..total], string);
    print(text);
    mut i32 lines = 0;
    for (char c : text) {
        if (c == '\n') {
            lines++;
        }
    }
    println(total, " ", lines);
    return 0;
}
