//! run
//! stdin:
//< hello
//< world
//! stdout:
//| hello
//| world
//| 12 2
import extern;
// C: read, read(2) of POSIX.1-2017.
// writes: at most n bytes at buf. gives: the count of bytes, 0 at the end of the file, or -1.
// keeps: no pointer. calls: no fort function. frees: nothing.
extern fn read(i32 fd, u8 mut* buf, u64 n) i64;

// C call read: &buf[total] keeps the bound of the span buf from element total, buf.len - total
// bytes (D9.8 rule 2), and the length buf.len - total fits it; total < buf.len in the loop.
fn main() i32 {
    u8 mut@ own buf = new(u8, 64);
    defer del(buf);
    u64 mut total = 0;
    while (total < buf.len) {
        i64 n = read(0, &buf[total], buf.len - total);
        if (n <= 0) {
            break;
        }
        total += cast(n, u64);
    }
    string text = cast(buf[..total], string);
    print(text);
    i32 mut lines = 0;
    for (char c : text) {
        if (c == '\n') {
            lines++;
        }
    }
    println(total, " ", lines);
    return 0;
}
