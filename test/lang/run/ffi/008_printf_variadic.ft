//! run
//! stdout:
//| n = 42 and -7
//| printf wrote 14 characters
import extern;
// A variadic C function is declared with its variable tail (D9.8). The call then has a variadic
// LLVM function type: on Linux the caller sets the vector-register count in `al`, and on Mac the
// tail goes on the stack. A fixed prototype of printf is an incorrect C prototype on both targets.
// A tail argument may be i32, u32, i64, u64, f64, a pointer or a function pointer: the callee
// applies the default argument promotions. Both arguments below are already `i32`.
// C: printf, ISO C11 7.21.6.3, printf(3).
// writes: no fort storage; C reads fmt to its NUL, and each tail argument that a conversion of fmt
// names, with the type that the conversion names. gives: the count of bytes, or a negative value.
// keeps: no pointer. calls: no fort function. frees: nothing.
extern fn printf(char* fmt, ...) i32;
// C: fflush, ISO C11 7.21.5.2, fflush(3).
// writes: no fort storage; for a null stream C flushes each output stream of C. gives: 0 or EOF.
// keeps: no pointer. calls: no fort function. frees: nothing.
extern fn fflush(void* stream) i32;

// C call printf: fmt.ptr names the literal fmt, and printf reads it to the NUL of that literal
// (D9.8 rule 4, D3.7). Its two conversions %d read the two i32 of the tail.
// C call fflush: null, which names no stream.
fn main() i32 {
    // A string literal is NUL-terminated (D3.7), so `.ptr` is a C string.
    string fmt = "n = %d and %d\n";
    i32 wrote = printf(fmt.ptr, 42, -7);
    // printf writes through C's stdio buffer and `println` through fort's
    // (D11.5), so the two orders are only fixed by flushing C's first;
    // `fflush(null)` flushes every C stream.
    fflush(null);
    println("printf wrote ", wrote, " characters");
    return 0;
}
