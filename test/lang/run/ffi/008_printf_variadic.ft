//! run
//! stdout:
//| n = 42 and -7
//| printf wrote 14 characters
// A variadic C function is declared with a fixed prototype for the arguments
// actually passed (module-system.md 8.4). That is safe because the compiler
// declares and calls every extern through a variadic LLVM function type, so
// the caller passes the vector-register count System V requires of a variadic
// callee (D9.8); a fixed prototype would leave `al` unset and printf would
// spill from registers it was never told about.
// A variadic position may spell only i32, i64, f64 or a pointer: the callee
// applies the default argument promotions and the compiler cannot check them,
// since a declared parameter is a fixed LLVM parameter either way
// (module-system.md 8.4, D15). Both arguments below are already `i32`.
extern fn i32 printf(char* fmt, i32 a, i32 b);
extern fn i32 fflush(void* stream);

fn i32 main() {
    // A string literal is NUL-terminated (D3.7), so `.ptr` is a C string.
    string fmt = "n = %d and %d\n";
    i32 wrote = printf(fmt.ptr, 42, -7);
    // printf writes through C's stdio buffer and `println` through fort's
    // (D11.5), so the two orders are only fixed by flushing C's first;
    // `fflush(null)` flushes every C stream.
    fflush(null);
    println("printf wrote ", wrote, " characters");
    return 0;
}
