//! run
//! stdout:
//| -3 1 4 9
//| 9 4 1 -3
import extern;
// std.libc declares no qsort (stdlib.md 2.2), so a program declares it with the element type
// that it sorts: the example of spec/module-system.md 8.5. One C symbol has one signature in a
// closure (D9.8). The comparator reads two elements through typed pointers, with no cast
// (D3.14), and C calls it with the addresses of two elements of `base` (D9.9).
// C: qsort, ISO C11 7.22.5.2, qsort(3).
// writes: the n elements of size bytes at base, which C moves into order. calls: cmp, with the
// addresses of two elements of base, and the fort comparator reads one i32 at each. gives: no
// result. keeps: no pointer: C does not keep cmp after the call. frees: nothing.
extern fn qsort(i32 mut* base, u64 n, u64 size, fn (i32*, i32*) i32 cmp) void;

fn by_value(i32* a, i32* b) i32 {
    return *a < *b ? -1 : (*a > *b ? 1 : 0);
}

fn by_value_down(i32* a, i32* b) i32 {
    return by_value(b, a);
}

fn show(i32@ xs) void {
    for (u64 mut i = 0; i < xs.len; i += 1) {
        if (i > 0) {
            print(" ");
        }
        print(xs[i]);
    }
    println("");
}

// C call qsort x2: &xs[0] keeps the bound of the span xs from element 0, xs.len elements of
// sizeof(i32), 16 bytes (D9.8 rule 2), and n * size, xs.len * sizeof(i32), fits it. by_value and
// by_value_down are fort functions of two i32* that are no boundary functions.
fn main() i32 {
    i32[4] mut values = {4, -3, 9, 1};
    i32 mut@ xs = values[..];
    // C gives the comparator pointers into `base`, so the argument is the address of an element
    // and no `.ptr` (D3.5).
    qsort(&xs[0], xs.len, sizeof(i32), by_value);
    show(xs);
    qsort(&xs[0], xs.len, sizeof(i32), by_value_down);
    show(xs);
    return 0;
}
