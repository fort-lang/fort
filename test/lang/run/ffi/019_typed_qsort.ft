//! run
//! stdout:
//| -3 1 4 9
//| 9 4 1 -3
// std.libc declares no qsort (stdlib.md 2.2), so a program declares it with the element type
// that it sorts: the example of spec/module-system.md 8.5. One C symbol has one signature in a
// closure (D9.8). The comparator reads two elements through typed pointers, with no cast
// (D3.14), and C calls it with the addresses of two elements of `base` (D9.9).
extern fn qsort(i32 mut* base, u64 n, u64 size, fn (i32*, i32*) i32 cmp) void;

fn by_value(i32* a, i32* b) i32 {
    return *a < *b ? -1 : (*a > *b ? 1 : 0);
}

fn by_value_down(i32* a, i32* b) i32 {
    return by_value(b, a);
}

fn show(i32@ xs) void {
    for (u64 mut i = 0; i < xs.len; i += 1) {
        if (i > 0) {
            print(" ");
        }
        print(xs[i]);
    }
    println("");
}

fn main() i32 {
    i32[4] mut values = {4, -3, 9, 1};
    i32 mut@ xs = values[..];
    qsort(xs.ptr, xs.len, sizeof(i32), by_value);
    show(xs);
    qsort(&xs[0], xs.len, sizeof(i32), by_value_down);
    show(xs);
    return 0;
}
