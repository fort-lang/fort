//! run
//! link: ffi/helpers.c
//! stdout:
//| 30 -9
//| 43
//| 10
import extern;
// A fort function is usable as a C callback exactly when its signature is
// extern-legal, function-pointer parameters included (D9.9), so C calls back
// into fort through an ordinary function pointer (D3.10).
// C: helper_apply, test/lang/ffi/helpers.c, which gives cb(x).
// gives: the int32_t that cb gives and no pointer. calls: cb once, with the arguments that follow
// it; cb is a fort function that the caller gives. writes: no fort storage. keeps: no pointer: C
// does not keep cb after the call. frees: nothing.
extern fn helper_apply(fn (i32) i32 cb, i32 x) i32;
// C: helper_apply_narrow, test/lang/ffi/helpers.c, which gives cb(a, b).
// gives: the uint8_t that cb gives and no pointer. calls: cb once, with the arguments that follow
// it; cb is a fort function that the caller gives. writes: no fort storage. keeps: no pointer: C
// does not keep cb after the call. frees: nothing.
extern fn helper_apply_narrow(fn (i8, u16) u8 cb, i8 a, u16 b) u8;
// C: helper_sum_to, test/lang/ffi/helpers.c, which gives the sum of 1 to n.
// gives: an int64_t and no pointer. writes: no fort storage. keeps: no pointer. calls: no fort
// function. frees: nothing.
extern fn helper_sum_to(i64 n) i64;

// An extern name is not a value, so a C function reaches C as a callback
// through a fort wrapper, whose own call to it is direct and keeps the
// variadic form (D3.10, D9.8).
// C call helper_sum_to: no pointer argument.
fn sum_to(i32 n) i32 {
    return cast(helper_sum_to(cast(n, i64)), i32);
}

fn triple(i32 x) i32 {
    return x * 3;
}

fn negate(i32 x) i32 {
    return -x;
}

// -1 arrives as 255 and 300 as 44 once the callee truncates them, so a
// callback that read a stale register would print another number.
fn low_sum(i8 a, u16 b) u8 {
    return cast(a, u8) +% cast(b, u8);
}

// C call helper_apply x3: triple, negate and sum_to, fort functions of i32 that are no boundary
// functions; no pointer argument.
// C call helper_apply_narrow: low_sum, a fort function of i8 and u16 that is no boundary function;
// no pointer argument.
fn main() i32 {
    println(helper_apply(triple, 10), " ", helper_apply(negate, 9));
    println(helper_apply_narrow(low_sum, -1, 300));
    println(helper_apply(sum_to, 4));
    return 0;
}
