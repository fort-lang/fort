//! run
//! link: ffi/helpers.c
//! stdout:
//| 36
import extern;
// The C callee reads direct and nested callbacks from a variable tail.
// D9.8, D9.9
// C: helper_tail_nested_callback, test/lang/ffi/helpers.c, which reads a tail of a function of
// int32_t and a function that takes such a function, and gives fixed + direct(3) + outer(direct).
// gives: an int32_t and no pointer. writes: no fort storage. calls: the first function of the tail
// once with 3, and the second once with the first; the caller gives fort functions. keeps: no
// pointer. frees: nothing.
extern fn helper_tail_nested_callback(i32 fixed, ...) i32;

fn triple(i32 n) i32 {
    return n * 3;
}

// C call callback: a function value of the caller, a fort function or a function of C; C gives
// triple, the fort function that main gave it. No pointer argument.
fn outer(fn (i32) i32 callback) i32 {
    return callback(5) + 2;
}

// C call helper_tail_nested_callback: triple and outer, fort functions that are no boundary
// functions; the tail gives them in the order that C reads.
fn main() i32 {
    println(helper_tail_nested_callback(10, triple, outer));
    return 0;
}
