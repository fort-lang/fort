//| 36
// The C callee reads direct and nested callbacks from a variable tail.
// D9.8, D9.9
extern fn helper_tail_nested_callback(i32 fixed, ...) i32;

fn triple(i32 n) i32 {
    return n * 3;
}

fn outer(fn (i32) i32 callback) i32 {
    return callback(5) + 2;
}

fn main() i32 {
    println(helper_tail_nested_callback(10, triple, outer));
    return 0;
}
