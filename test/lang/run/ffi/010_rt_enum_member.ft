//! run
//! link: ffi/rt_enum.c
//! stdout:
//| true true true
//| true 16
//| minus_seven zero million 42
//| true true
import extern;
import std.rt;

// std.rt declares struct enum_member { i32 value; char* name; }. The compiler
// emits the table a print of an enum reads as [N x %fort.enum_member], and
// %fort.enum_member is { i32, ptr } (toolchain.md 5.1, 6 items 2 and 21).
//
// No fort-only program can see those two disagree. A table that one wrong
// layout writes and reads answers correctly, and under opaque pointers a
// field's type shows only through the offsets it moves. The C file beside
// this test is the boundary that can see it: it declares the same two fields
// with C's own offsetof and sizeof. So C writes a table here and print_enum
// reads it, and then fort writes a table and C reads it back.
// C: rt_enum_sizeof, test/lang/ffi/rt_enum.c, which gives sizeof(struct rt_enum_member).
// gives: a uint64_t and no pointer. writes: no fort storage. keeps: no pointer. calls: no fort
// function. frees: nothing.
extern fn rt_enum_sizeof() u64;
// C: rt_enum_offset_value, test/lang/ffi/rt_enum.c, which gives the offsetof of value.
// gives: a uint64_t and no pointer. writes: no fort storage. keeps: no pointer. calls: no fort
// function. frees: nothing.
extern fn rt_enum_offset_value() u64;
// C: rt_enum_offset_name, test/lang/ffi/rt_enum.c, which gives the offsetof of name.
// gives: a uint64_t and no pointer. writes: no fort storage. keeps: no pointer. calls: no fort
// function. frees: nothing.
extern fn rt_enum_offset_name() u64;
// C: rt_enum_fill, test/lang/ffi/rt_enum.c, which fills three rows.
// writes: three rt.enum_member at m, each with a value and a name, a pointer to a static C string
// literal with its NUL. gives: no result. keeps: no pointer. calls: no fort function. frees:
// nothing.
extern fn rt_enum_fill(rt.enum_member mut* m) void;
// C: rt_enum_check, test/lang/ffi/rt_enum.c, which compares three rows with its own.
// writes: nothing; C reads three rt.enum_member at m, and the name of each row to its NUL with
// strcmp, until a row differs. gives: a bool and no pointer. keeps: no pointer. calls: no fort
// function. frees: nothing.
extern fn rt_enum_check(rt.enum_member* m) bool;

// Answers with the distance between two addresses. That distance is fort's
// own offset of a field (D3.11: a pointer reaches u64 through cast).
fn off(void* base, void* field) u64 {
    return cast(field, u64) - cast(base, u64);
}

// C call rt_enum_sizeof x2: no argument.
// C call rt_enum_offset_value: no argument.
// C call rt_enum_offset_name: no argument.
// C call rt_enum_fill: &table[0] keeps the bound of table from element 0, three rows (D9.8 rule 2),
// and C writes three.
// C call rt.print_enum x4: table[..], a span of three rows (rule 2); the name of each row is a C
// string literal with its NUL that rt_enum_fill stored in this function (rule 3).
// C call rt_enum_check x2: &mine[0] and &table[0] keep the bounds of mine and table, three rows
// each (rule 2), and C reads three. The names of mine are &"minus_seven"[0], &"zero"[0] and
// &"million"[0], which end in the NUL of their literals (rule 4); the names of table are the ones
// that rt_enum_fill stored (rule 3).
// C call off x3: the addresses of a local and of its parts, cast to void*; off reads no byte at
// them and subtracts them as integers (D3.11).
fn main() i32 {
    rt.enum_member[3] mut table = {};

    // The size and both offsets: fort's answers against C's.
    println(sizeof(rt.enum_member) == rt_enum_sizeof(), " ",
            off(cast(&table[0], void*), cast(&table[0].value, void*)) ==
                rt_enum_offset_value(), " ",
            off(cast(&table[0], void*), cast(&table[0].name, void*)) ==
                rt_enum_offset_name());

    // The stride between two rows is the size LLVM gave the struct. The
    // compiler's own table strides by that same size.
    println(off(cast(&table[0], void*), cast(&table[1], void*)) == rt_enum_sizeof(), " ",
            sizeof(rt.enum_member));

    // C fills the table and print_enum reads it. A name that comes back right
    // says print_enum found the pointer where C put it. A value that matches
    // says it found the i32 there too. No row holds 42, so the last call takes
    // the fallback, which says the search read the values and did not match by
    // position.
    rt.flush(1);
    rt_enum_fill(&table[0]);
    i32 first = -7;
    i32 third = 1000000;
    i32 absent = 42;
    rt.print_enum(1, first, table[..]);
    rt.print_char(1, ' ');
    rt.print_enum(1, 0, table[..]);
    rt.print_char(1, ' ');
    rt.print_enum(1, third, table[..]);
    rt.print_char(1, ' ');
    rt.print_enum(1, absent, table[..]);
    rt.print_char(1, '\n');
    rt.flush(1);

    // Now the other way round: fort writes the rows and C reads them.
    rt.enum_member[3] mut mine = {};
    mine[0].value = first;
    mine[0].name = &"minus_seven"[0];
    mine[1].value = 0;
    mine[1].name = &"zero"[0];
    mine[2].value = third;
    mine[2].name = &"million"[0];
    println(rt_enum_check(&mine[0]), " ", rt_enum_check(&table[0]));
    return 0;
}
