//! run
//! link: ffi/helpers.c
//! stdout:
//| 525
//| 4294967317
import extern;
// The C callee reads signed, unsigned, float, pointer and callback tails.
// D9.8
// C: helper_tail_mix, test/lang/ffi/helpers.c, which reads a tail of an int32_t, a uint32_t, a
// uint64_t, a double, an int32_t* and a function of int32_t, in that order, and sums them with
// fixed.
// gives: an int64_t and no pointer. writes: nothing; C reads the one int32_t at the pointer of the
// tail. calls: the function of the tail once, with 3; the caller gives a fort function. keeps: no
// pointer. frees: nothing.
extern fn helper_tail_mix(i32 fixed, ...) i64;
// C: helper_tail_defaults, test/lang/ffi/helpers.c, which reads a tail of an int32_t, an int64_t
// and a double, in that order, and sums them with fixed.
// gives: an int64_t and no pointer. writes: no fort storage. keeps: no pointer. calls: no fort
// function. frees: nothing.
extern fn helper_tail_defaults(i32 fixed, ...) i64;

fn triple(i32 n) i32 {
    return n * 3;
}

// C call helper_tail_mix: item, a typed pointer to one i32 that new gave in this function and that
// del frees after the call (D9.8 rule 2); C reads one i32 at it. triple is a fort function of i32
// that is no boundary function. The other tail arguments have the types that C reads.
// C call helper_tail_defaults: no pointer argument; the tail gives an i32, an i64 and an f64, which
// C reads as int32_t, int64_t and double.
fn main() i32 {
    i32 mut* own item = new(i32);
    *item = 9;
    println(helper_tail_mix(10, -7, cast(200, u32), cast(300, u64), 4.0, item, triple));
    println(helper_tail_defaults(10, 7, 4294967296, 4.0));
    del(item);
    return 0;
}
