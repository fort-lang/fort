//! run
//! link: ffi/helpers.c
//! stdout:
//| 525
//| 4294967317
// The C callee reads signed, unsigned, float, pointer and callback tails.
// D9.8
extern fn helper_tail_mix(i32 fixed, ...) i64;
extern fn helper_tail_defaults(i32 fixed, ...) i64;

fn triple(i32 n) i32 {
    return n * 3;
}

fn main() i32 {
    i32 mut* own item = new(i32);
    *item = 9;
    println(helper_tail_mix(10, -7, cast(200, u32), cast(300, u64), 4.0, item, triple));
    println(helper_tail_defaults(10, 7, 4294967296, 4.0));
    del(item);
    return 0;
}
