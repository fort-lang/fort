//! run
//! link: ffi/helpers.c
//! stdout:
//| 0.75 0.25
//| 6.5
//| 2.5 0.0625
// A binary32 value crosses the C boundary in an SSE register of its own
// width, as an argument, as a result and through a function pointer C calls
// back (D9.9). run/ffi/004 is the binary64 half of these helpers.
extern fn f32 helper_half(f32 x);
extern fn f64 helper_mix(f32 a, f64 b, i32 k);
extern fn f32 helper_apply_f32(fn f32(f32) cb, f32 x);

fn f32 square(f32 x) {
    return x * x;
}

fn i32 main() {
    println(helper_half(1.5), " ", helper_half(0.5));
    println(helper_mix(0.5, 3.0, 2));
    println(helper_apply_f32(square, 1.5) + 0.25, " ", helper_apply_f32(square, 0.25));
    return 0;
}
