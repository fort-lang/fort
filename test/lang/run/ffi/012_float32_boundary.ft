//! run
//! link: ffi/helpers.c
//! stdout:
//| 0.75 0.25
//| 6.5
//| 2.5 0.0625
import extern;
// A binary32 value crosses the C boundary in an SSE register of its own
// width, as an argument, as a result and through a function pointer C calls
// back (D9.9). run/ffi/004 is the binary64 half of these helpers.
// C: helper_half, test/lang/ffi/helpers.c, which gives x / 2.
// gives: a float and no pointer. writes: no fort storage. keeps: no pointer. calls: no fort
// function. frees: nothing.
extern fn helper_half(f32 x) f32;
// C: helper_mix, test/lang/ffi/helpers.c, which gives a + b * k.
// gives: a double and no pointer. writes: no fort storage. keeps: no pointer. calls: no fort
// function. frees: nothing.
extern fn helper_mix(f32 a, f64 b, i32 k) f64;
// C: helper_apply_f32, test/lang/ffi/helpers.c, which gives cb(x).
// gives: the float that cb gives and no pointer. calls: cb once, with x; cb is a fort function that
// the caller gives. writes: no fort storage. keeps: no pointer: C does not keep cb after the call.
// frees: nothing.
extern fn helper_apply_f32(fn (f32) f32 cb, f32 x) f32;

fn square(f32 x) f32 {
    return x * x;
}

// C call helper_half x2: no pointer argument.
// C call helper_mix: no pointer argument.
// C call helper_apply_f32 x2: square, a fort function of f32 that is no boundary function; no
// pointer argument.
fn main() i32 {
    println(helper_half(1.5), " ", helper_half(0.5));
    println(helper_mix(0.5, 3.0, 2));
    println(helper_apply_f32(square, 1.5) + 0.25, " ", helper_apply_f32(square, 0.25));
    return 0;
}
