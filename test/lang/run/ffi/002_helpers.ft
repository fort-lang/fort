//! run
//! link: ffi/helpers.c
//! stdout:
//| 7 4.5 52
//| true false
//| 30 -9 10
extern fn i32 helper_add(i32 a, i32 b);
extern fn f64 helper_scale(f64 x, i32 k);
extern fn u8 helper_low_byte(u32 x);
extern fn bool helper_is_even(i64 n);
extern fn i32 helper_apply(fn i32(i32) cb, i32 x);
extern fn i64 helper_sum_to(i64 n);

fn i32 triple(i32 x) {
    return x * 3;
}

fn i32 negate(i32 x) {
    return -x;
}

fn i32 main() {
    println(helper_add(3, 4), " ", helper_scale(1.5, 3), " ", helper_low_byte(0x1234));
    println(helper_is_even(10), " ", helper_is_even(7));
    println(helper_apply(triple, 10), " ", helper_apply(negate, 9), " ", helper_sum_to(4));
    return 0;
}
