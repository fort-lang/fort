//! run
//! link: ffi/helpers.c
//! stdout:
//| 7 52
//| true false
//| 10
extern fn helper_add(i32 a, i32 b) i32;
extern fn helper_low_byte(u32 x) u8;
extern fn helper_is_even(i64 n) bool;
extern fn helper_sum_to(i64 n) i64;

fn main() i32 {
    println(helper_add(3, 4), " ", helper_low_byte(0x1234));
    println(helper_is_even(10), " ", helper_is_even(7));
    println(helper_sum_to(4));
    return 0;
}
