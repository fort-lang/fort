//! run
//! link: ffi/helpers.c
//! stdout:
//| 7 52
//| true false
//| 10
import extern;
// C: helper_add, test/lang/ffi/helpers.c, which gives a + b.
// gives: an int32_t and no pointer. writes: no fort storage. keeps: no pointer. calls: no fort
// function. frees: nothing.
extern fn helper_add(i32 a, i32 b) i32;
// C: helper_low_byte, test/lang/ffi/helpers.c, which gives the low byte of x.
// gives: a uint8_t and no pointer. writes: no fort storage. keeps: no pointer. calls: no fort
// function. frees: nothing.
extern fn helper_low_byte(u32 x) u8;
// C: helper_is_even, test/lang/ffi/helpers.c, which tells whether n is even.
// gives: a bool and no pointer. writes: no fort storage. keeps: no pointer. calls: no fort
// function. frees: nothing.
extern fn helper_is_even(i64 n) bool;
// C: helper_sum_to, test/lang/ffi/helpers.c, which gives the sum of 1 to n.
// gives: an int64_t and no pointer. writes: no fort storage. keeps: no pointer. calls: no fort
// function. frees: nothing.
extern fn helper_sum_to(i64 n) i64;

// C call helper_add: no pointer argument.
// C call helper_low_byte: no pointer argument.
// C call helper_is_even x2: no pointer argument.
// C call helper_sum_to: no pointer argument.
fn main() i32 {
    println(helper_add(3, 4), " ", helper_low_byte(0x1234));
    println(helper_is_even(10), " ", helper_is_even(7));
    println(helper_sum_to(4));
    return 0;
}
