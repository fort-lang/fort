//! run
//! stdout:
//| 0 true
import std.io;

// A program that declares fstat(2) with types of its own, and imports no std.os, binds no
// declaration of the standard library: std.os declares fstat and std.libc does not (D9.8,
// D9.10). Built against std.flib it conflicts with std.os, which the library holds (D9.11), and
// test/library/use_test.py holds that conflict.
extern fn fstat(i32 fd, void mut* buf) i32;

fn main() i32 {
    i32 fd = io.open_write("own-fstat.txt");
    u8[256] mut st = {};
    i32 status = fstat(fd, cast(&st[0], void mut*));
    println(status, " ", io.close(fd));
    return 0;
}
