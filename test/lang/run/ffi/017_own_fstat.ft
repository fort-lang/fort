//! run
//! stdout:
//| 0 true
import extern;
import std.io;

// A program that declares fstat(2) with types of its own, and imports no std.os, binds no
// declaration of the standard library: std.os declares fstat and std.libc does not (D9.8,
// D9.10). Built against std.flib it conflicts with std.os, which the library holds (D9.11), and
// test/library/use_test.py holds that conflict.
// C: fstat, fstat(2) of POSIX.1-2017.
// writes: one struct stat at buf on success, 144 bytes on Linux x86-64 and on macOS arm64. gives:
// 0, or -1 with errno set. keeps: no pointer. calls: no fort function. frees: nothing.
extern fn fstat(i32 fd, void mut* buf) i32;

// C call fstat: cast(&st[0], void mut*) keeps the bound of st from element 0, 256 bytes (D9.8 rule
// 2), and C writes one struct stat of 144 bytes. A failed open gives fd -1, and fstat then writes
// nothing.
fn main() i32 {
    i32 fd = io.open_write("own-fstat.txt");
    u8[256] mut st = {};
    i32 status = fstat(fd, cast(&st[0], void mut*));
    println(status, " ", io.close(fd));
    return 0;
}
