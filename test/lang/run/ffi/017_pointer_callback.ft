//! run
//! link: ffi/helpers.c
//! stdout:
//| 9
//| 5
//| 13
//| 8
// D17.13, D17.18: C calls `bump` twice with a pointer of its own choice. The graph marks `bump`
// foreign-called, so its caller-source requirement gives incomplete proof in the calls_heap row.
// The default build enforces no calls_heap scope, so the program compiles and runs. `bump`
// reads and writes through the pointer on each call, and a fort call of it still works.
extern fn helper_apply_ptr(fn (i32 mut*) i32 cb, i32 mut* p) i32;

fn bump(i32 mut* p) i32 {
    *p += 1;
    return *p;
}

fn main() i32 {
    i32 mut x = 3;
    println(helper_apply_ptr(bump, &x));
    println(x);
    println(helper_apply_ptr(bump, &x));
    println(bump(&x));
    return 0;
}
