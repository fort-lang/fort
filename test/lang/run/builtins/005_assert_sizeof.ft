//! run
//! stdout:
//| 1 2 4 8 1 2 4 8
//| 4 8 1 1
//| 8 8 16 16 8 4
//| 40 48 128 8 16 6
//| ok
struct Point {
    i32 x;
    i32 y;
}

struct Mixed {
    u8 tag;
    i64 value;
}

struct Padded {
    i8 a;
    i16 b;
    i8 c;
}

struct Node {
    i32 v;
}

enum Color {
    Red,
}

fn i32 main() {
    println(sizeof(i8), " ", sizeof(i16), " ", sizeof(i32), " ", sizeof(i64), " ",
            sizeof(u8), " ", sizeof(u16), " ", sizeof(u32), " ", sizeof(u64));
    println(sizeof(f32), " ", sizeof(f64), " ", sizeof(bool), " ", sizeof(char));
    println(sizeof(i32*), " ", sizeof(void*), " ", sizeof(i32[]), " ", sizeof(string), " ",
            sizeof(fn i32(i32)), " ", sizeof(Color));
    println(sizeof(i32[10]), " ", sizeof(i32[3][4]), " ", sizeof(Node*[16]), " ",
            sizeof(Point), " ", sizeof(Mixed), " ", sizeof(Padded));
    string s = "hello";
    assert(true);
    assert(1 + 1 == 2);
    assert(s.len == 5);
    assert(sizeof(Point) == 8);
    println("ok");
    return 0;
}
