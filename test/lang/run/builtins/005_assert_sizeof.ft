//! run
//! stdout:
//| 1 2 4 8 1 2 4 8
//| 1 1
//| 8 8 16 16 4
//| 40 128 8 16 6
//| ok
struct point {
    i32 x;
    i32 y;
}

struct mixed {
    u8 tag;
    i64 value;
}

struct padded {
    i8 a;
    i16 b;
    i8 c;
}

struct node {
    i32 v;
}

enum color {
    red,
}

fn i32 main() {
    println(sizeof(i8), " ", sizeof(i16), " ", sizeof(i32), " ", sizeof(i64), " ",
            sizeof(u8), " ", sizeof(u16), " ", sizeof(u32), " ", sizeof(u64));
    println(sizeof(bool), " ", sizeof(char));
    println(sizeof(i32*), " ", sizeof(void*), " ", sizeof(i32@), " ", sizeof(string), " ",
            sizeof(color));
    println(sizeof(i32[10]), " ", sizeof(node*[16]), " ", sizeof(point), " ", sizeof(mixed), " ",
            sizeof(padded));
    string s = "hello";
    assert(true);
    assert(1 + 1 == 2);
    assert(s.len == 5);
    assert(sizeof(point) == 8);
    println("ok");
    return 0;
}
