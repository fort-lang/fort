//! run
//! stdout:
//| 0.1 0.1
//| 0.10000000149011612 0.1
//| 16777217.0 16777216.0
//| 1e-45 5e-324
// A float prints the shortest decimal that reads back in its own type, so the
// same value prints differently as f32 and as f64 (D11.7, D18.1, D18.2).
fn i32 main() {
    f32 a = 0.1;
    f64 b = 0.1;
    println(a, " ", b);
    println(cast(a, f64), " ", cast(b, f32));
    f64 c = 16777217.0;
    println(c, " ", cast(c, f32));
    f32 tiny = 1.401298464324817e-45;
    f64 wtiny = 4.9406564584124654e-324;
    println(tiny, " ", wtiny);
    return 0;
}
