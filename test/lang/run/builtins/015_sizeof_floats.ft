//! run
//! stdout:
//| 4 8
//| 16 8
//| 8 24
// f32 is 4 bytes and f64 is 8, and each aligns to its own size (D3.1, D3.15).
struct pair {
    f32 low;
    f64 high;
}

struct mixed {
    u8 tag;
    f64 value;
    f32 tail;
}

fn main() i32 {
    println(sizeof(f32), " ", sizeof(f64));
    println(sizeof(pair), " ", sizeof(f64[1]));
    println(sizeof(f32[2]), " ", sizeof(mixed));
    return 0;
}
