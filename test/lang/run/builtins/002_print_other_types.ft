//! run
//! stdout:
//| true false
//| a Z !
//| hello  world
//| green 7
//| 0x0 0x0 0x0
enum color {
    red,
    green,
}

fn i32 main() {
    bool t = true;
    println(t, " ", !t);
    char c = 'Z';
    println('a', " ", c, " ", '!');
    string s = "world";
    println("hello", " ", " ", s);
    color g = color.green;
    println(g, " ", cast(7, color));
    i32* p = null;
    void* v = null;
    fn void() f = null;
    println(p, " ", v, " ", f);
    return 0;
}
