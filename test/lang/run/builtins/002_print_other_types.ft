//! run
//! stdout:
//| true false
//| a Z !
//| hello  world
//| Green 7
//| 0x0 0x0 0x0
enum Color {
    Red,
    Green,
}

fn i32 main() {
    bool t = true;
    println(t, " ", !t);
    char c = 'Z';
    println('a', " ", c, " ", '!');
    string s = "world";
    println("hello", " ", " ", s);
    Color g = Color.Green;
    println(g, " ", cast(7, Color));
    i32* p = null;
    void* v = null;
    fn void() f = null;
    println(p, " ", v, " ", f);
    return 0;
}
