//! run
//! stdout:
//| 1.0 0.1 -0.0 3.5 100.0
//| 0.0001 10000000000000000.0 0.3333333333333333
//| 1.5 0.25 1.0
//| 1e+21
//| 0.30000000000000004 -2.5 123456.789
fn i32 main() {
    f64 one = 1.0;
    f64 tenth = 0.1;
    f64 zero = 0.0;
    f64 negzero = -zero;
    println(one, " ", tenth, " ", negzero, " ", 3.5, " ", 100.0);
    f64 small = 0.0001;
    f64 big = 1e16;
    f64 third = 1.0 / 3.0;
    println(small, " ", big, " ", third);
    f32 a = 1.5;
    f32 b = 0.25;
    f64 c = 2.0 * 0.5;
    println(a, " ", b, " ", c);
    println(1e21);
    f64 x = 0.1;
    f64 y = 0.2;
    println(x + y, " ", -2.5, " ", 123456.789);
    return 0;
}
