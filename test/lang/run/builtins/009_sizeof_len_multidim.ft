//! run
//! stdout:
//| 24 12 4 96
//| 2 3 4
//| 0 3
//| 3 2 12
//| 0
//| 7 3
// `sizeof` of a nested array and `.len` of one of its rows (D3.15, D4.6).
// `.len` of an expression of fixed-array type is an untyped integer constant
// and its operand is not evaluated, which `m[calls()].len` shows: the call
// never runs, and the value sizes an array.
i32 mut calls = 0;

fn bump() i32 {
    calls++;
    return 0;
}

// A constant expression may size an array (D4.6), including one written with
// `.len` of a row of a module-level constant.
i32[2][3] TABLE = {{1, 2, 3}, {4, 5, 6}};
u64 ROW_LEN = TABLE[0].len;
i32[TABLE[0].len] ROW_SIZED = {7, 0, 0};

fn main() i32 {
    println(sizeof(i32[2][3]), " ", sizeof(i32[3]), " ", sizeof(i32), " ",
            sizeof(i32[2][2][2][3]));
    // `.len` reads the dimension of the type, one rank at a time.
    i32[2][3][4] m = {};
    println(m.len, " ", m[0].len, " ", m[0][0].len);
    // The operand of `.len` is not evaluated, so the call inside it does not
    // run and the result is still a constant.
    i32[m[bump()].len] sized = {};
    println(calls, " ", sized.len);
    println(TABLE[1].len, " ", TABLE.len, " ", sizeof(i32[TABLE[0].len]));
    println(calls);
    println(ROW_SIZED[0], " ", ROW_LEN);
    return 0;
}
