//! run
//! stdout:
//| 7
// A function of the module may take the universe name `regrow` (D7.9, D12.2). A call of the name
// is then a call of that function, with its parameters and its result.
fn regrow(i32 a, i32 b) i32 {
    return a + b;
}

fn main() i32 {
    println(regrow(3, 4));
    return 0;
}
