//! run
//! stdout:
//| 1.7976931348623157e+308 -1.7976931348623157e+308
//| 2.2250738585072014e-308 5e-324
//| 1.1125369292536007e-308 -1.1125369292536007e-308
//| 1e-323 -1e-323
//| 16777217.0 123456789.0 9007199254740992.0 9007199254740994.0
//| 0.12345678901234566 1.2345678901234568e-05 123456789012345.67
//| 7.120236347223045e-307 7.291122019556398e-304
//| 1.5474250491067253e+26 1.2379400392853803e+27
// The ends of the f64 encoding, transcribed from the C runtime's own suite
// before that runtime was deleted (T-091); bootstrap-0 refuses it and T-041
// answers for it.
//
// A subnormal prints like any other value, and seventeen digits are printed
// when the value needs them (D18.2). The last four are powers of two, which
// are the one place where the values that read back are not centred on the
// value: the binade below is coarser, so they reach half an ulp above and
// only a quarter below, and the nearest decimal of the shortest length can
// fall outside the interval while the next one up falls inside it
// (toolchain.md 5.1). Each text below reads back as the power of two it
// stands for, which is what makes it the answer.
fn main() i32 {
    println(1.7976931348623157e+308, " ", -1.7976931348623157e+308);
    println(2.2250738585072014e-308, " ", 5e-324);
    println(1.1125369292536007e-308, " ", -1.1125369292536007e-308);

    // The second smallest subnormal is 9.88e-324, and the shortest decimal
    // that reads back as it stands one power of ten higher.
    println(1e-323, " ", -1e-323);
    println(16777217.0, " ", 123456789.0, " ", 9007199254740992.0, " ", 9007199254740994.0);
    println(0.12345678901234566, " ", 1.2345678901234568e-5, " ", 123456789012345.67);

    // 2^-1017, 2^-1007, 2^87 and 2^90.
    println(7.120236347223045e-307, " ", 7.291122019556398e-304);
    println(1.5474250491067253e+26, " ", 1.2379400392853803e+27);
    return 0;
}
