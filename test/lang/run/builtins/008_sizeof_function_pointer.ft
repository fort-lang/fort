//! run
//! stdout:
//| 8 8 8
//| 24 16
// A function pointer is an ordinary pointer value, so `sizeof` of one is the
// pointer size whatever its signature (D3.10).
struct handler {
    fn i32(i32) f;
    i32 tag;
}

fn i32 main() {
    println(sizeof(fn i32(i32)), " ", sizeof(fn void()), " ", sizeof(fn noreturn(string)));
    println(sizeof(fn i32()[3]), " ", sizeof(handler));
    return 0;
}
