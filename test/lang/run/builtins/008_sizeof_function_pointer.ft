//! run
//! stdout:
//| 8 8 8
//| 24 16
// A function pointer is an ordinary pointer value, so `sizeof` of one is the
// pointer size whatever its signature (D3.10).
struct handler {
    fn (i32) i32 f;
    i32 tag;
}

// A function type carries no suffix of its own (D3.10, D8.1), so three
// function pointers side by side are an array of a struct that holds one.
struct slot {
    fn () i32 f;
}

fn main() i32 {
    println(sizeof(fn (i32) i32), " ", sizeof(fn () void), " ", sizeof(fn (string) noreturn));
    println(sizeof(slot[3]), " ", sizeof(handler));
    return 0;
}
