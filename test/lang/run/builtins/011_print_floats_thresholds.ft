//! run
//! stdout:
//| 0.0001 0.00049 9.999e-05 1e-05 3e-05
//| 1.5e-07 -1.5e-07
//| 1000000000000000.0 10000000000000000.0 12345678901234568.0
//| 1e+17 -1e+17 1e+18
//| 1e+21 1e+100 1e-300 2.5e-09
//| 99999999999999980.0 1e+17
//| 9.999999999999999e-05 0.0001
//| 20000000000000000.0 -99999999999999980.0
// D18.3 decides the form on the decimal exponent of the leading digit:
// exponent form when it is below -4 or at 17 and above, fixed form between.
// This is the C runtime's own threshold suite, transcribed before that
// runtime was deleted (T-091); stage1 refuses it and T-041 answers for it.
//
// The exponent carries a sign and at least two digits (D11.7), and the fixed
// form pads the integer part with zeros when the digits run out before the
// point.
fn i32 main() {
    println(1e-4, " ", 4.9e-4, " ", 9.999e-5, " ", 1e-5, " ", 3e-5);
    println(1.5e-7, " ", -1.5e-7);
    println(1e15, " ", 1e16, " ", 12345678901234567.0);
    println(1e17, " ", -1e17, " ", 1e18);
    println(1e21, " ", 1e100, " ", 1e-300, " ", 2.5e-9);

    // The last value below each threshold and the first at it.
    println(9.999999999999998e16, " ", 1e17);
    println(9.999999999999999e-5, " ", 1e-4);
    println(2e16, " ", -9.999999999999998e16);
    return 0;
}
