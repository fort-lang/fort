//! run
//! stdout:
//| 8 16 24 4 8
//| 16 32 16 24 1 16 32 16 16 48 1 16 4294967296 8
// `sizeof` of a reference to an array that fits gives the size of the
// reference (D3.4). `late` is declared after its use and `node` reaches itself
// through a pointer; each takes 16 bytes, so 2^59 - 1 of them need 2^63 - 16
// bytes (D3.8, D7.10). An enum takes 4 bytes, so 2^61 - 1 of them need
// 2^63 - 4 bytes (D3.9). u64[2^60 - 1] needs 2^63 - 8 bytes. A group has the
// size of its type, and each suffix after the `)` applies to that size (D3.6).
u64 LATE = sizeof(late[576460752303423487]*);
u64 NODE = sizeof(node[576460752303423487]@);
u64 PART = sizeof(fn(node[576460752303423487]) void) * 3;
u64 ENUM = sizeof(color[2305843009213693951]*) / 2;
u64 WORDS = sizeof(fn(u64[1152921504606846975]*) void);
enum color { red, green }
struct late {
    u64 a;
    u64 b;
}
struct node {
    node* next;
    u64 value;
}

fn main() i32 {
    println(LATE, " ", NODE, " ", PART, " ", ENUM, " ", WORDS);
    println(sizeof((i32*)[2]), " ", sizeof((i32[4])[2]), " ", sizeof((i32[4]*)[2]), " ",
            sizeof((fn (i32) i32)[3]), " ", sizeof(((u8))), " ", sizeof((void*)[2]), " ",
            sizeof((u8@)[2]), " ", sizeof((node*)[2]), " ", sizeof((i32[2])@), " ",
            sizeof(((i64)[2])[3]), " ", sizeof((u8)[1]), " ", sizeof(((void*))@), " ",
            sizeof(((u8)[4294967296])[1]), " ", sizeof((node)*));
    return 0;
}
