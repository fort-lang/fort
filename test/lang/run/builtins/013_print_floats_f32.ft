//! run
//! stdout:
//| 0.1 0.33333334 0.10000000149011612
//| 16777216.0 123456790.0 16777217.0
//| 0.0001 1e-05 10000000000000000.0 1e+17 1e+21
//| 3.4028235e+38 -3.4028235e+38 1.1754944e-38 1e-45
//| 0.0 -0.0 1.0 -2.5
//| 2971111.8 -2971111.8
//| 1.2621775e-29 2.9802322e-08
//| 9.999999e-05 0.0001 1.5e-07
//| 0.5|0.251.0-0.52.25
// An f32 argument is never widened to an f64 first, because the digits
// printed depend on the argument's own type (D18.1). Transcribed from the C
// runtime's own suite before that runtime was deleted (T-091); stage1 refuses
// it and T-041 answers for it.
fn i32 main() {
    // The shortest digits of its own type: 0.1 as an f32 is a different value
    // from 0.1 as an f64, and printing the f32 as an f64 shows it.
    f32 tenth = 0.1;
    f32 third = 1.0 / 3.0;
    f64 widened = cast(tenth, f64);
    println(tenth, " ", third, " ", widened);

    // The value it holds and not the one asked for: neither of the first two
    // is representable as an f32.
    f32 odd = 16777217.0;
    f32 wide = 123456792.0;
    println(odd, " ", wide, " ", 16777217.0);

    // The same form thresholds as an f64 (D18.3).
    f32 tiny = 1e-4;
    f32 tinier = 1e-5;
    f32 big = 1e16;
    f32 bigger = 1e17;
    f32 biggest = 1e21;
    println(tiny, " ", tinier, " ", big, " ", bigger, " ", biggest);

    // The ends of the f32 encoding: the largest, the smallest normal and the
    // smallest subnormal.
    f32 largest = 3.4028235e+38;
    f32 smallest_normal = 1.1754944e-38;
    f32 smallest = 1e-45;
    println(largest, " ", -largest, " ", smallest_normal, " ", smallest);

    f32 zero = 0.0;
    f32 one = 1.0;
    f32 negative = -2.5;
    println(zero, " ", -zero, " ", one, " ", negative);

    // 2971111.75 is exactly midway between the two shortest decimals that
    // read back as it, and the tie goes to the even last digit (D18.2).
    f32 tie = 2971111.75;
    println(tie, " ", -tie);

    // Two powers of two, where the interval of values that read back is not
    // centred on the value: 2^-96 and 2^-25.
    f32 low = 1.2621775e-29;
    f32 lower = 2.9802322e-08;
    println(low, " ", lower);

    // The last value below each threshold and the first at it.
    f32 last = 9.999999e-5;
    f32 first = 1e-4;
    f32 exponent = 1.5e-7;
    println(last, " ", first, " ", exponent);

    // No separator stands between two printed values, whatever their types
    // (D11.7).
    f64 half = 0.5;
    f32 quarter = 0.25;
    f64 minus_half = -0.5;
    f32 two_and_a_quarter = 2.25;
    println(half, "|", quarter, one, minus_half, two_and_a_quarter);
    return 0;
}
