//! run
//! stdout:
//| 2
//| 3
// `regrow` is a universe name and no keyword, so a local declaration may take the name (D7.9,
// D12.2). Outside the scope of that local the name is the builtin.
fn local() i32 {
    i32 regrow = 3;
    return regrow;
}

fn main() i32 {
    i32 mut@ own s = new(i32, 1);
    i32 mut@ own t = regrow(move(s), 2);
    println(t.len);
    del(t);
    println(local());
    return 0;
}
