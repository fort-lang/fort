//! run
//! stdout:
//| 0.0 1.0 -1.0 100.0 -100.0
//| -0.0 0.0
//| 0.5 2.5 -2.5 1234.5678
//| 0.1 0.2 0.3 0.30000000000000004 0.3333333333333333
//| inf -inf nan nan
// The layout D11.7 and D18.3 fix for an f64, transcribed from the C runtime's
// suite before T-091 deleted that runtime. This test holds std.rt to these
// bytes.
//
// `.0` is appended when the text has neither a `.` nor an `e`, a negative
// zero keeps its sign from the sign bit (D18.3), a fraction is never padded,
// and the digits are the shortest that read back in the value's own type
// (D18.2).
fn main() i32 {
    println(0.0, " ", 1.0, " ", -1.0, " ", 100.0, " ", -100.0);
    f64 zero = 0.0;
    println(-zero, " ", zero);
    println(0.5, " ", 2.5, " ", -2.5, " ", 1234.5678);
    f64 tenth = 0.1;
    f64 fifth = 0.2;
    println(tenth, " ", fifth, " ", 0.3, " ", tenth + fifth, " ", 1.0 / 3.0);

    // D11.7 lists `inf`, `-inf` and `nan` and no `-nan`, so a NaN prints the
    // same whatever its sign bit. Neither has a literal, so both are built at
    // run time: floats are IEEE 754 and neither operation traps (D6.12).
    f64 mut huge = 1.7976931348623157e+308;
    huge = huge * 2.0;
    f64 mut divisor = 0.0;
    f64 not_a_number = divisor / divisor;
    println(huge, " ", -huge, " ", not_a_number, " ", -not_a_number);
    return 0;
}
