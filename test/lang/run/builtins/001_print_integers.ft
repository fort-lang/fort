//! run
//! stdout:
//| -128 127 255
//| -32768 32767 65535
//| -2147483648 2147483647 4294967295
//| -9223372036854775808 9223372036854775807 18446744073709551615
//| 0 -1 97
//| ab
//| 123
fn i32 main() {
    i8 a = -128;
    i8 b = 127;
    u8 c = 255;
    println(a, " ", b, " ", c);
    i16 d = -32768;
    i16 e = 32767;
    u16 f = 65535;
    println(d, " ", e, " ", f);
    i32 g = -2147483648;
    i32 h = 2147483647;
    u32 i = 4294967295;
    println(g, " ", h, " ", i);
    i64 j = -9223372036854775808;
    i64 k = 9223372036854775807;
    u64 l = 18446744073709551615;
    println(j, " ", k, " ", l);
    u8 m = 'a';
    i32 z = 0;
    println(z, " ", -1, " ", m);
    print("a");
    print("b");
    println();
    print(1, 2);
    println(3);
    return 0;
}
