//! run
//! stdout:
//| true
//| abc true
//| true 6
// An argument of an `extern fn` may still add a pointer place that carries `mut` or `own` and
// reaches no function pointer (D3.14). C sees no `own`, and no function pointer is in the view.
// A view that keeps a function pointer place with its type, or hides it, stays exempt too. A cast
// that is no argument reads `cell` and `entry` first, and each walk keeps its own answer.
import std.libc;
import std.str;

struct cell {
    u64* own p;
}

struct entry {
    i64 key;
    string own name;
}

struct cb_cell {
    fn (u64) u64 f;
    u64* own p;
}

// A pointer with no mark to a struct that holds an owner reaches no function pointer.
struct link {
    cell* p;
}

// The same places as `cb_cell` under other names.
struct cb_view {
    fn (u64) u64 g;
    u64* own q;
}

// C reads and writes no byte for a count of 0. Each function is in the C library of Linux and of
// Darwin.
extern fn bzero(cell* c, u64 n) void;
extern fn memchr(entry* e, i32 c, u64 n) void*;
extern fn strnlen(cb_view* s, u64 n) u64;
extern fn swab(link* from, void mut* to, i64 n) void;

fn twice(u64 x) u64 {
    return 2 * x;
}

fn main() i32 {
    u64 mut x = 0;
    void* v = cast(&x, void*);
    cell mut c = cell{.p = new(u64)};
    cell* seen = cast(&c, cell*);
    bzero(cast(v, cell*), 0);
    bzero((cast(v, cell*)), 0);
    swab(cast(v, link*), cast(&x, void mut*), 0);
    println(seen->p == c.p);
    entry mut e = entry{.key = 1, .name = str.dup("abc")};
    entry* look = cast(&e, entry*);
    void* anon = cast(&e, void*);
    void* found = memchr(cast(anon, entry*), 0, 0);
    println(look->name, " ", found == null);
    cb_cell mut k = cb_cell{.f = twice, .p = new(u64)};
    u64 len = strnlen(cast(&k, cb_view*), 0);
    libc.memset(cast(&k, u8 mut*), 0, 0);
    println(len == 0, " ", k.f(3));
    del(c.p);
    del(e.name);
    del(k.p);
    return 0;
}
