//! run
//! stdout:
//| 7 7 true
//| 9 9
//| true true
//| 42 84
//| true true
//| 3 1
struct point {
    i32 x;
    i32 y;
}

fn twice(i32 n) i32 {
    return n + n;
}

fn main() i32 {
    i32 mut v = 7;
    // Any pointer casts to any pointer or to `void*`, and the round trip
    // through `void*` gives the same address back (D3.14). The `void` pointer
    // carries the mark, because the trip back may not add it: a cast of a
    // `void*` to an `i32 mut*` is the error of fail/casts/012.
    i32 mut* p = &v;
    void mut* anon = cast(p, void mut*);
    i32 mut* q = cast(anon, i32 mut*);
    println(*p, " ", *q, " ", cast(p, u64) == cast(q, u64));
    *q = 9;
    println(v, " ", *p);

    // Pointer to and from `u64`, both directions, with the address preserved.
    u64 bits = cast(p, u64);
    i32* r = cast(bits, i32*);
    println(*r == 9, " ", cast(r, u64) == bits);

    // A function pointer casts to and from `void*`, so a table of callbacks
    // can be stored anonymously and called after the trip back (D3.10).
    fn (i32) i32 f = twice;
    void* fv = cast(f, void*);
    fn (i32) i32 g = cast(fv, fn (i32) i32);
    println(g(21), " ", g(42));
    // A function pointer converts to and from `void*` but not to `u64`: the
    // integer round trip is a data-pointer rule only (D3.14).
    println(cast(g, void*) == fv, " ", cast(f, void*) == fv);

    // Casting a pointer to another pointee type reinterprets the storage: the
    // first field of a point shares the struct's address (D3.13).
    point mut s = point{3, 4};
    point mut* sp = &s;
    i32 mut* first = cast(sp, i32 mut*);
    println(*first, " ", cast(cast(sp, u64) == cast(first, u64), i32));
    return 0;
}
