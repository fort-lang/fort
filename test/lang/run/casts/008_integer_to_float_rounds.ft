//! run
//! stdout:
//| -5.0 4000000000.0 9007199254740992.0
//| 1.8446744073709552e+19 -5.0 9007199000000000.0
//| 16777216.0 16777217.0
// An integer to a float rounds to nearest: 2^53 + 1 has no binary64 and
// 2^24 + 1 no binary32, and each one goes to the even mantissa (D3.14).
fn main() i32 {
    i32 a = -5;
    u32 b = 4000000000;
    i64 c = 9007199254740993;
    u64 d = 18446744073709551615;
    println(cast(a, f64), " ", cast(b, f64), " ", cast(c, f64));
    println(cast(d, f64), " ", cast(a, f32), " ", cast(c, f32));
    i64 e = 16777217;
    println(cast(e, f32), " ", cast(e, f64));
    return 0;
}
