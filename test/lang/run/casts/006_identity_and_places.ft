//! run
//! stdout:
//| 5 5 true
//| 3 0
//| 110 4
//| 12 1
//| 258 2
//| yes
u8 BASE = cast(300, u8);
u8 WIDE = cast(-1, u8);

struct box {
    i32 v;
}

fn u8 low(i64 n) {
    return cast(n, u8);
}

fn i32 main() {
    // Identity is an allowed cast and changes nothing (D3.14).
    i32 n = 5;
    i32 same = cast(n, i32);
    println(n, " ", same, " ", cast(same, i32) == n);

    // A cast that only drops mutability is a no-op: the value and its address
    // are the same, only the binding's view narrows (D3.14, D5.4).
    i32 mut v = 3;
    i32 mut* p = &v;
    i32* frozen = cast(p, i32*);
    println(*frozen, " ", cast(cast(frozen, u64) != cast(p, u64), i32));

    // A cast is an expression, so it appears where any expression does: a
    // module constant's initializer, an argument, an index and a condition.
    println(cast(BASE, i32) + cast(low(322), i32), " ", cast(WIDE, i32) - 251);
    i32[4] table = {10, 11, 12, 13};
    println(table[cast(cast('\x02', i32), i64)], " ", cast(cast(1, u8), i32));
    if (cast(2, u8) == 2) {
        box b = box{cast(258, i32)};
        println(b.v, " ", cast(cast(b.v, u8), i32));
    }
    if (cast(true, i32) == 1) {
        println("yes");
    }
    return 0;
}
