//! run
//! stdout:
//| true true
//| 1.0 1.0 true
//| -0.0 true true
// A value that fits binary32 comes back unchanged through binary64, and a
// widening and a narrowing of the same value are each exact (D3.14).
fn i32 main() {
    f32 a = 0.5;
    f64 wide = cast(a, f64);
    println(cast(wide, f32) == a, " ", wide == 0.5);
    i32 one = 1;
    f64 from_int = cast(one, f64);
    f32 narrow = cast(from_int, f32);
    println(from_int, " ", narrow, " ", cast(narrow, i32) == one);
    f64 zero = 0.0;
    f64 neg = -zero;
    f32 nzero = cast(neg, f32);
    println(nzero, " ", nzero == 0.0, " ", cast(nzero, f64) == 0.0);
    return 0;
}
