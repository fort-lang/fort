//! run
//! stdout:
//| 0.3333333333333333 0.33333334
//| 0.10000000149011612 0.1
//| inf 3.4028234663852886e+38
// f64 to f32 narrows and f32 to f64 widens exactly (D3.14). The digits of a
// value are the shortest that read back in its own type, so the same number
// prints differently in the two (D11.7).
fn main() i32 {
    f64 x = 1.0;
    f64 y = 3.0;
    println(x / y, " ", cast(x / y, f32));
    f32 p = 0.1;
    println(cast(p, f64), " ", p);
    f64 huge = 1e300;
    f32 largest = 3.4028234663852886e38;
    println(cast(huge, f32), " ", cast(largest, f64));
    return 0;
}
