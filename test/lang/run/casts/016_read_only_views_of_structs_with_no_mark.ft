//! run
//! stdout:
//| 3 1 2
//| 1
//| 7 hello
//| 9 9
// A pointer place of a read-only view that reaches no reference marked `mut` or `own` and no
// function pointer carries no mark, and it may drop the marks of the place under it (D3.14). The
// place may reach through any chain of pointers, fields and elements, cycles included. Through
// such a view a program only reads. The casts below drop the `mut` of such places, and a view may
// hide a pointer as two integers.
struct node {
    node* next;
    u64 value;
}

// The two words of a node, the pointer as an integer.
struct pair_view {
    u64 first;
    u64 second;
}

// A `string` and a `void*` carry no mark. A function pointer carries one, because a call is no
// read (fail/casts/038).
struct named {
    u64 id;
    string name;
    void* any;
}

// Two structs that reach each other, one through an array of pointers.
struct ring_a {
    ring_b*[2] next;
    u64 n;
}

struct ring_b {
    ring_a* back;
}

fn main() i32 {
    node mut third = node{.next = null, .value = 2};
    node mut second = node{.next = &third, .value = 1};
    node mut head = node{.next = &second, .value = 3};
    node* back = cast(cast(&head, void*), node*);
    println(back->value, " ", back->next->value, " ", back->next->next->value);
    pair_view* words = cast(&second, pair_view*);
    println(words->second);
    named mut n = named{.id = 7, .name = "hello", .any = null};
    named mut* mut np = &n;
    named** seen = cast(&np, named**);
    println((*seen)->id, " ", (*seen)->name);
    ring_a mut ra = ring_a{.next = {null, null}, .n = 9};
    ring_b mut rb = ring_b{.back = &ra};
    ra.next[0] = &rb;
    ring_b* seen_b = cast(cast(&rb, void*), ring_b*);
    ring_a mut* mut rp = &ra;
    ring_a** seen_a = cast(&rp, ring_a**);
    println(seen_b->back->n, " ", (*seen_a)->next[0]->back->n);
    return 0;
}
