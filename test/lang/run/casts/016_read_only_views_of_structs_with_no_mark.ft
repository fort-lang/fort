//! run
//! stdout:
//| 3 1 2
//| 1
//| 7 hello 4
//| 9 9
// A read-only view may add a pointer place that reaches no reference marked `mut` or `own`, through
// any chain of pointers, fields and elements, cycles included (D3.14): through such a view a
// program only reads. Each cast below adds or changes such places, from a pointer, from a `void*`
// and from an integer.
struct node {
    node* next;
    u64 value;
}

// The two words of a node, the pointer as an integer.
struct pair_view {
    u64 first;
    u64 second;
}

// A `string`, a `void*` and a function pointer carry no mark.
struct named {
    u64 id;
    string name;
    void* any;
    fn (u64) u64 f;
}

// Two structs that reach each other, one through an array of pointers.
struct ring_a {
    ring_b*[2] next;
    u64 n;
}

struct ring_b {
    ring_a* back;
}

fn twice(u64 v) u64 {
    return v * 2;
}

fn main() i32 {
    node mut third = node{.next = null, .value = 2};
    node mut second = node{.next = &third, .value = 1};
    node mut head = node{.next = &second, .value = 3};
    node* back = cast(cast(&head, void*), node*);
    println(back->value, " ", back->next->value, " ", back->next->next->value);
    pair_view* words = cast(&second, pair_view*);
    println(words->second);
    named mut n = named{.id = 7, .name = "hello", .any = null, .f = twice};
    named* seen = cast(cast(&n, u64), named*);
    println(seen->id, " ", seen->name, " ", seen->f(2));
    ring_a mut ra = ring_a{.next = {null, null}, .n = 9};
    ring_b mut rb = ring_b{.back = &ra};
    ra.next[0] = &rb;
    ring_b* seen_b = cast(cast(&rb, void*), ring_b*);
    ring_a* seen_a = cast(cast(&ra, u64), ring_a*);
    println(seen_b->back->n, " ", seen_a->next[0]->back->n);
    return 0;
}
