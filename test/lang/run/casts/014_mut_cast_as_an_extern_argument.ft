//! run
//! stdout:
//| abc
//| abc
//| abc
//| cba
// A cast that is itself an argument of a call of an `extern fn` may hide an
// owner place of its source (D3.14). C sees no `own` (D17.13), and fort trusts
// the C side of an extern signature. Parentheses around the cast change
// nothing, and an extern call inside the operand of the cast leaves the cast an
// argument of the outer call.
import std.libc;
import std.str;

struct entry {
    i64 key;
    string own name;
}

fn by_key(void* a, void* b) i32 {
    entry* x = cast(a, entry*);
    entry* y = cast(b, entry*);
    if (x->key < y->key) {
        return -1;
    }
    if (x->key > y->key) {
        return 1;
    }
    return 0;
}

// Entry `n` of `a`. A cast of the bytes that C gives back to `entry mut*` would add the owner of
// each entry, so the extern result picks the index.
fn pick(entry[3] mut* a, u64 n) entry mut* {
    return &(*a)[n];
}

fn main() i32 {
    entry[3] mut items = {entry{.key = 3, .name = str.dup("c")},
                          entry{.key = 1, .name = str.dup("a")},
                          entry{.key = 2, .name = str.dup("b")}};
    // C sorts the entries in place, and each owner moves whole.
    libc.qsort(cast(&items, void mut*), 3, sizeof(entry), by_key);
    println(items[0].name, items[1].name, items[2].name);
    libc.qsort((cast(&items, void mut*)), 3, sizeof(entry), by_key);
    println(items[0].name, items[1].name, items[2].name);
    libc.qsort(cast(pick(&items, cast(libc.memcmp(cast(&items, u8*), cast(&items, u8*), 0), u64)),
                    void mut*),
               3, sizeof(entry), by_key);
    println(items[0].name, items[1].name, items[2].name);
    // C swaps the first and the last entry through a scratch entry, which it
    // then clears, so each name keeps one owner.
    entry mut spare = {};
    libc.memcpy(cast(&spare, u8 mut*), cast(&items[0], u8*), sizeof(entry));
    libc.memcpy(cast(&items[0], u8 mut*), cast(&items[2], u8*), sizeof(entry));
    libc.memcpy(cast(&items[2], u8 mut*), cast(&spare, u8*), sizeof(entry));
    libc.memset(cast(&spare, u8 mut*), 0, sizeof(entry));
    println(items[0].name, items[1].name, items[2].name);
    del(items[0].name);
    del(items[1].name);
    del(items[2].name);
    return 0;
}
