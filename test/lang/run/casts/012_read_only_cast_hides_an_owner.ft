//! run
//! stdout:
//| 7 7 true
//| true 2
//| 2
//| 2
//| 0 9 9 0
//| 3 3
//| 7 true
// A cast whose result can change no level may hide a pointer place of its source, an owner
// included, and it may add or change a pointer place that carries neither `mut` nor `own`
// (D3.14): no store and no release goes through such a view. A read through it yields the bits,
// as D10.7 defines for a pointer to another type of the same size.
import std.str;

struct holder {
    u64 count;
    u64* own data;
}

// The layout of a holder, with other names.
struct mirror {
    u64 tally;
    u64* own payload;
}

// The layout of a holder, with a pointer that carries no mark.
struct holder_view {
    u64 count;
    u64* data;
}

// The two words of a span or a `string` header.
struct header {
    u64 ptr;
    u64 len;
}

struct node {
    i32 v;
}

// Owners whose slots the program takes the address of.
struct slots {
    u64* own one;
    string own text;
    u8 mut@ own buf;
}

// A list that reaches itself through a pointer that carries no mark.
struct link {
    link* next;
    u64 v;
}

// main takes the address of each owner, so a call in main can change them, and a read of
// one after a call is a use that D17.21 cannot prove. So each part of the test is a function
// that reads through a parameter, where the owner is no local owner.
fn holder_views(holder mut* h) void {
    u64* first = cast(h, u64*);
    void* anon = cast(h, void*);
    holder_view* back = cast(anon, holder_view*);
    u64* bits = cast(&h->data, u64*);
    println(*first, " ", back->count, " ", *bits == cast(h->data, u64));
}

fn slot_views(slots mut* k) void {
    u64* slot = cast(&k->one, u64*);
    header* words = cast(&k->text, header*);
    println(*slot == cast(k->one, u64), " ", words->len);
}

// A read-only view of an owning span header.
fn span_view(slots mut* k) void {
    header* span_words = cast(&k->buf, header*);
    println(span_words->len);
}

// Pointers with no mark added over an integer, over the storage behind a `void mut*`, from an
// integer, and two levels down.
fn unmarked() void {
    u64 mut word = 0;
    u64** seen = cast(&word, u64**);
    void mut* anon_word = cast(&word, void mut*);
    holder_view* from_void = cast(anon_word, holder_view*);
    u64 mut nine = 9;
    u64 mut* mut pn = &nine;
    u64** deep = cast(&pn, u64**);
    u64* from_bits = cast(cast(&nine, u64), u64*);
    println(cast(*seen, u64), " ", **deep, " ", *from_bits, " ", from_void->count);
}

// A struct that reaches itself carries no mark when none of its pointers carries one.
fn self_reaching() void {
    link mut tail = link{.next = null, .v = 3};
    link mut head = link{.next = &tail, .v = 1};
    link* again = cast(cast(&head, void*), link*);
    println(again->next->v, " ", cast(cast(&tail, u64), link*)->v);
}

// A place that carries a mark is legal where the source holds a place of the same type.
fn mirror_view(holder mut* h) void {
    mirror* seen_mirror = cast(h, mirror*);
    println(seen_mirror->tally, " ", seen_mirror->payload == h->data);
}

fn main() i32 {
    holder mut h = holder{.count = 7, .data = new(u64)};
    holder_views(&h);
    slots mut k = slots{.one = new(u64), .text = str.dup("ab"), .buf = new(u8, 2)};
    slot_views(&k);
    // A span of owners seen through read-only elements that keep their `own`.
    node mut* own mut@ own kids = new(node mut* own, 2);
    node mut* own@ kept = cast(kids, node mut* own@);
    println(kept.len);
    span_view(&k);
    unmarked();
    self_reaching();
    mirror_view(&h);
    del(kids);
    del(k.buf);
    del(k.text);
    del(k.one);
    del(h.data);
    return 0;
}
