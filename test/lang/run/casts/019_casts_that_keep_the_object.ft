//! run
//! stdout:
//| true true
//| 4611686018427387904 7
//| 3 true
//| 9
//| 9 9 true
//| true 42
// The casts that the rules of a pointer from an integer, of a larger pointee and of the pointer
// places of a view leave legal (D3.14). A pointer and a `void*` cast to `u64`. A pointee of the
// same size or smaller, with the same alignment or a smaller one, is legal: the bits of an `f64`
// as a `u64`, the first byte of an `i64`, the first element of an array, and an array as a struct
// of the same layout. A read-only view hides a pointer place, keeps a place of the same type, and
// a place with no mark drops the marks of the place under it. A function pointer casts to `void*`.
struct holder {
    u64 count;
    u64* own data;
}

struct mirror {
    u64 tally;
    u64* own payload;
}

struct two {
    i32 x;
    i32 y;
}

fn twice(u64 n) u64 {
    return n + n;
}

// main takes the address of the owner, so the views read through a parameter (D17.21).
fn mirror_view(holder mut* h) void {
    mirror* m = cast(h, mirror*);
    u64* count = cast(h, u64*);
    println(m->tally, " ", *count, " ", m->payload == h->data);
}

fn main() i32 {
    i32 v = 3;
    i32* p = &v;
    u64 a = cast(p, u64);
    println(a == cast(cast(p, void*), u64), " ", a != 0);
    f64 f = 2.0;
    i64 x = 7;
    println(*cast(&f, u64*), " ", *cast(&x, u8*));
    i32[2] pair = {3, 4};
    two* t = cast(&pair, two*);
    println(*cast(&pair, i32*), " ", t->y == pair[1]);
    u64 mut nine = 9;
    u64 mut* mut pn = &nine;
    u64** seen = cast(&pn, u64**);
    println(**seen);
    holder mut h = holder{.count = 9, .data = new(u64)};
    mirror_view(&h);
    del(h.data);
    fn (u64) u64 g = twice;
    void* gv = cast(g, void*);
    println(gv != null, " ", g(21));
    return 0;
}
