//! run
//! stdout:
//| 1 2 3
//| 10 2 3
//| 10 20 3
//| 5 7
//| 7 5
//| true 3
struct cell {
    i32 v;
}

fn i64 sum(i32@ xs) {
    i64 mut total = 0;
    for (i64 mut i = 0; i < cast(xs.len, i64); i++) {
        total += cast(xs[i], i64);
    }
    return total;
}

fn i32 main() {
    i32 mut@ own xs = new(i32, 3);
    xs[0] = 1;
    xs[1] = 2;
    xs[2] = 3;

    // Dropping writability is the implicit conversion of D5.4, so a read-only
    // span parameter takes the writable span with no cast at all.
    i32@ ro = xs;
    println(ro[0], " ", ro[1], " ", ro[2]);

    // Nothing adds it back. A cast never adds `mut`, from a span as from a
    // pointer (D3.14), and fail/casts/013 is the diagnostic; the writable span
    // is the one the allocation gave, which `xs` still holds.
    xs[0] = 10;
    println(xs[0], " ", xs[1], " ", xs[2]);

    // The header itself is another level: `i32 mut@ mut` is an assignable
    // binding over writable elements, and the drop of D5.4 is what makes the
    // initializer legal.
    i32 mut@ mut cursor = xs;
    cursor = xs[1..3];
    cursor[0] = 20;
    println(xs[0], " ", xs[1], " ", xs[2]);

    // A span of pointers has a mark for the slots and one for the pointees.
    // Dropping both is implicit, because the target is immutable at level 1
    // (D5.4, D5.3).
    cell mut a = cell{5};
    cell mut b = cell{7};
    cell mut* mut@ own slots = new(cell mut*, 2);
    slots[0] = &a;
    slots[1] = &b;
    cell*@ frozen = slots;
    println(frozen[0]->v, " ", frozen[1]->v);

    // Dropping the pointee mark alone, with the slots left writable, is the
    // drop D5.4 refuses at a level behind a mutable one, and the cast makes it
    // (D3.14). `std.sort_ptr` takes such a span, and a caller reaches it this
    // way. The slots are still writable, so the two pointers exchange.
    cell* mut@ view = cast(slots, cell* mut@);
    cell* first = view[0];
    view[0] = view[1];
    view[1] = first;
    println(view[0]->v, " ", view[1]->v);

    println(sum(xs) == 33, " ", xs.len);
    del(slots);
    del(xs);
    return 0;
}
