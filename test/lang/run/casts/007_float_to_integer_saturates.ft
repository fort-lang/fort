//! run
//! stdout:
//| 2 -2 0 0
//| 2147483647 -2147483648 255 0
//| 9223372036854775807 -9223372036854775808 18446744073709551615 0
//| 0 0 0 0
// A float to an integer truncates toward zero and saturates at the target's
// range; a NaN gives 0 and nothing traps (D3.14, D6.12).
fn i32 main() {
    f64 a = 2.9;
    f64 b = -2.9;
    f64 half = 0.5;
    f64 nhalf = -0.5;
    println(cast(a, i32), " ", cast(b, i32), " ", cast(half, i32), " ", cast(nhalf, i32));
    f64 big = 1e20;
    f64 nbig = -1e20;
    println(cast(big, i32), " ", cast(nbig, i32), " ", cast(big, u8), " ", cast(nbig, u8));
    println(cast(big, i64), " ", cast(nbig, i64), " ", cast(big, u64), " ", cast(nbig, u64));
    f64 zero = 0.0;
    f64 nan = zero / zero;
    println(cast(nan, i32), " ", cast(nan, u8), " ", cast(nan, i64), " ", cast(nan, u64));
    return 0;
}
