//! run
//! stdout:
//| 5 104 101 111
//| hello 5
//| h e l
//| HELLO
//| hello 5 true
//| he
// `string`, `char@`, `u8@`, `char mut@` and `u8 mut@` cast among themselves,
// because they are the same header over the same bytes (D3.14).
fn i32 main() {
    string s = "hello";
    u8@ b = cast(s, u8@);
    println(b.len, " ", b[0], " ", b[1], " ", b[4]);
    string back = cast(b, string);
    println(back, " ", back.len);
    char@ c = cast(s, char@);
    println(c[0], " ", c[1], " ", c[2]);

    // The writable forms carry the mark they were given: bytes allocated
    // writable are seen as characters and edited in place, and no cast puts
    // the mark on bytes that lack it (D3.14, fail/casts/013).
    u8 mut@ own m = new(u8, 5);
    for (u64 mut i = 0; i < 5; i++) {
        m[i] = b[i];
    }
    char mut@ cm = cast(m, char mut@);
    for (u64 mut i = 0; i < cm.len; i++) {
        cm[i] = cast(cast(cm[i], i32) - 32, char);
    }
    println(cast(m, string));

    // Dropping back to the read-only forms is a no-op that keeps the bytes.
    u8@ ro = cast(m, u8@);
    for (u64 mut i = 0; i < ro.len; i++) {
        m[i] = b[i];
    }
    println(cast(ro, string), " ", ro.len, " ", cast(m, char@)[0] == 'h');
    del(m);

    // A cast of a sub-span keeps the length the range gave it.
    println(cast(cast(s, u8@)[0..2], string));
    return 0;
}
