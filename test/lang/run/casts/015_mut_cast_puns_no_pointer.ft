//! run
//! stdout:
//| 4611686018427387904
//| 1 2
//| true 7
// A place that holds no pointer stays free to pun through a `mut` view (D3.14): the bits of a
// float as an integer, two `u32` as one `u64`. A read-only view may hide a pointer: it reads the
// address as an integer, and no cast takes the integer back to a pointer.
struct halves {
    u32 lo;
    u32 hi;
}

fn main() i32 {
    f64 mut f = 2.0;
    u64 mut* bits = cast(&f, u64 mut*);
    println(*bits);
    u64 mut w = 0;
    halves mut* hv = cast(&w, halves mut*);
    hv->lo = 1;
    hv->hi = 2;
    println(w & 0xFFFFFFFF, " ", w >> 32);
    u64 mut y = 7;
    u64 mut* mut p = &y;
    u64* seen = cast(&p, u64*);
    println(*seen == cast(&y, u64), " ", *p);
    return 0;
}
