//! run
//! stdout:
//| 1 0 1 0
//| 65 90 122 0
//| A Z , !
//| 44 255 0
//| 0 5 6 -1
//| red blue 6
//| true false
// `bool` casts to an integer as 0 or 1, `char` casts to and from any integer
// type and an enum casts to and from any integer type (D3.14).
enum color {
    red,
    green = 5,
    blue,
}

enum sign {
    neg = -1,
    zero,
}

fn main() i32 {
    println(cast(true, i32), " ", cast(false, i32), " ", cast(1 == 1, u8), " ",
            cast(1 != 1, u64));

    // `char` is one unsigned byte (D3.2), so a cast to an integer never
    // sign-extends and '\0' is zero like any other code.
    println(cast('A', i32), " ", cast('Z', u8), " ", cast('z', i64), " ", cast('\0', i32));
    println(cast(65, char), " ", cast(90, char), " ", cast(44, char), " ", cast(33, char));

    // Narrowing to `char` truncates to the low byte, so 300 is 44 and -1 is
    // 255; a char reaching back out is that byte again.
    println(cast(cast(300, char), i32), " ", cast(cast(-1, char), i32), " ",
            cast(cast(256, char), i32));

    println(cast(color.red, i32), " ", cast(color.green, u8), " ", cast(color.blue, i64), " ",
            cast(sign.neg, i32));
    println(cast(0, color), " ", cast(6, color), " ", cast(cast(color.blue, u32), i32));
    println(cast(6, color) == color.blue, " ", cast(sign.zero, i32) == -1);
    return 0;
}
