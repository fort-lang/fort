struct hi17 {
    u8 head;
    u8[17] a;
}

fn up17() bool {
    hi17 mut x = hi17{};
    u8[18] mut* all = cast(&x, u8[18] mut*);
    fill((*all)[..]);
    u8[17]* low = cast(&x, u8[17]*);
    x.a = *low;
    return is_up((*all)[..]);
}

