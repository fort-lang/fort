    words16 mut x = words16{};
    u64[17] mut* all = cast(&x, u64[17] mut*);
    fill_words((*all)[..]);
    u64[16] mut* low = cast(&x, u64[16] mut*);
    *low = x.a;
    return words_down((*all)[..]);
}

struct words512 {
    u64 head;
    u64[512] a;
}

fn words_up512() bool {
    words512 mut x = words512{};
    u64[513] mut* all = cast(&x, u64[513] mut*);
    fill_words((*all)[..]);
    u64[512]* low = cast(&x, u64[512]*);
    x.a = *low;
    return words_up((*all)[..]);
}

fn words_down512() bool {
    words512 mut x = words512{};
    u64[513] mut* all = cast(&x, u64[513] mut*);
    fill_words((*all)[..]);
    u64[512] mut* low = cast(&x, u64[512] mut*);
    *low = x.a;
    return words_down((*all)[..]);
}

fn id(w17 v) w17 {
    return v;
}

fn rd(wlo* p) w17 {
    return p->inner;
}

fn wr(whi mut* to, w17 v) void {
    to->inner = v;
}

// The bytes of a `whi` as 18 bytes: `head`, then the 17 bytes of `inner`.
fn bytes_of(whi* x) u8@ {
    u8[18]* all = cast(x, u8[18]*);
    return (*all)[..];
}

fn filled() whi {
    whi mut x = whi{};
    u8[18] mut* all = cast(&x, u8[18] mut*);
    fill((*all)[..]);
    return x;
}

// A struct literal whose member reads the storage that the literal then fills.
fn literal() bool {
    whi mut x = filled();
    wlo* p = cast(&x, wlo*);
    x = whi{.head = byte(0), .inner = p->inner};
    return is_up(bytes_of(&x));
}

// The two ranges are one range: the store changes no byte.
fn equal() bool {
    whi mut x = filled();
    whi mut* p = &x;
    x.inner = p->inner;
    *p = x;
    u8@ all = bytes_of(&x);
    u64 mut i = 0;
    while (i < all.len) {
        if (all[i] != byte(i)) {
            return false;
        }
        i += 1;
    }
    return true;
}

// The source goes through an argument and a result.
fn by_value() bool {
    whi mut x = filled();
    wlo* p = cast(&x, wlo*);
    x.inner = id(p->inner);
    return is_up(bytes_of(&x));
}

// The callee reads the source and writes its result.
fn by_result() bool {
    whi mut x = filled();
    x.inner = rd(cast(&x, wlo*));
    return is_up(bytes_of(&x));
}

// The store through two pointer parameters, in a function that knows nothing of the two places.
fn copy17(w17 mut* to, w17* from) void {
    *to = *from;
}

fn through() bool {
    whi mut x = filled();
    wlo* p = cast(&x, wlo*);
    copy17(&x.inner, &p->inner);
    return is_up(bytes_of(&x));
}

// The callee does the store of its parameter.
fn by_callee() bool {
    whi mut x = filled();
    wlo* p = cast(&x, wlo*);
    wr(&x, p->inner);
    return is_up(bytes_of(&x));
}

// The source is one arm of a conditional expression.
fn choose(bool c) bool {
    whi mut x = filled();
    wlo* p = cast(&x, wlo*);
    x.inner = c ? p->inner : x.inner;
    if (c) {
        return is_up(bytes_of(&x));
    }
    return x.head == byte(0) && x.inner.a[0] == byte(1) && x.inner.a[16] == byte(17);
}

// A swap of two views through a local. The second store moves the bytes 1 to 17 to offset 0, and
// the third store writes the old bytes 0 to 16 at offset 1.
fn swap() bool {
    whi mut x = filled();
    wlo mut* p = cast(&x, wlo mut*);
    w17 keep = p->inner;
    p->inner = x.inner;
    x.inner = keep;
    u8@ all = bytes_of(&x);
    u64 mut i = 1;
    while (i < all.len) {
        if (all[i] != byte(i - 1)) {
            return false;
        }
        i += 1;
    }
    return all[0] == byte(1);
}

fn main() i32 {
    i32[4] mut arr = {1, 2, 3, 4};
    shift(&arr);
    println(arr[0]);
    println(arr[1]);
    println(arr[2]);
    println(arr[3]);
    // the same store of elements that hold no zero byte
    i32[4] mut full = {0x11111111, 0x22222222, 0x33333333, 0x44444444};
    shift(&full);
    println("shift ", full[0] == 0x11111111 && full[1] == 0x11111111 && full[2] == 0x22222222
            && full[3] == 0x33333333);
    println("up 1 ", up1());
    println("down 1 ", down1());
    println("up 2 ", up2());
    println("down 2 ", down2());
    println("up 3 ", up3());
    println("down 3 ", down3());
    println("up 15 ", up15());
    println("down 15 ", down15());
    println("up 16 ", up16());
    println("down 16 ", down16());
    println("up 17 ", up17());
    println("down 17 ", down17());
    println("up 255 ", up255());
    println("down 255 ", down255());
    println("up 4097 ", up4097());
    println("down 4097 ", down4097());
    println("words up 3 ", words_up3());
    println("words down 3 ", words_down3());
    println("words up 16 ", words_up16());
    println("words down 16 ", words_down16());
    println("words up 512 ", words_up512());
    println("words down 512 ", words_down512());
    println("literal ", literal());
    println("equal ", equal());
    println("by_value ", by_value());
    println("by_result ", by_result());
    println("through ", through());
    println("by_callee ", by_callee());
    println("choose true ", choose(true));
    println("choose false ", choose(false));
    println("swap ", swap());
    return 0;
}
