struct hi4097 {
    u8 head;
    u8[4097] a;
}

fn up4097() bool {
    hi4097 mut x = hi4097{};
    u8[4098] mut* all = cast(&x, u8[4098] mut*);
    fill((*all)[..]);
    u8[4097]* low = cast(&x, u8[4097]*);
    x.a = *low;
    return is_up((*all)[..]);
}

fn down4097() bool {
    hi4097 mut x = hi4097{};
    u8[4098] mut* all = cast(&x, u8[4098] mut*);
    fill((*all)[..]);
    u8[4097] mut* low = cast(&x, u8[4097] mut*);
    *low = x.a;
    return is_down((*all)[..]);
}

struct words3 {
    u64 head;
    u64[3] a;
}

fn words_up3() bool {
    words3 mut x = words3{};
    u64[4] mut* all = cast(&x, u64[4] mut*);
    fill_words((*all)[..]);
    u64[3]* low = cast(&x, u64[3]*);
    x.a = *low;
    return words_up((*all)[..]);
}

fn words_down3() bool {
    words3 mut x = words3{};
    u64[4] mut* all = cast(&x, u64[4] mut*);
    fill_words((*all)[..]);
    u64[3] mut* low = cast(&x, u64[3] mut*);
    *low = x.a;
    return words_down((*all)[..]);
}

struct words16 {
    u64 head;
    u64[16] a;
}

fn words_up16() bool {
    words16 mut x = words16{};
    u64[17] mut* all = cast(&x, u64[17] mut*);
    fill_words((*all)[..]);
    u64[16]* low = cast(&x, u64[16]*);
    x.a = *low;
    return words_up((*all)[..]);
}

