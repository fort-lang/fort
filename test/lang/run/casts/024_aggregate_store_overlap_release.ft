//! run
//! flags: --release
//! link: ffi/memcpy_overlap.c
//! stdout:
//| 1
//| 1
//| 2
//| 3
//| shift true
//| up 1 true
//| down 1 true
//| up 2 true
//| down 2 true
//| up 3 true
//| down 3 true
//| up 15 true
//| down 15 true
//| up 16 true
//| down 16 true
//| up 17 true
//| down 17 true
//| up 255 true
//| down 255 true
//| up 4097 true
//| down 4097 true
//| words up 3 true
//| words down 3 true
//| words up 16 true
//| words down 16 true
//| words up 512 true
//| words down 512 true
//| literal true
//| equal true
//| by_value true
//| by_result true
//| through true
//| by_callee true
//| choose true true
//| choose false true
//| swap true
/// A store of an aggregate reads the whole source before it changes the destination, so the
/// result is defined when the two places overlap in part (D6.3). A view cast makes such places:
/// each pointee is no larger and no more aligned than the object.
///   - `shift` stores bytes 0 to 12 of an array of 4 `i32` into bytes 4 to 16.
///   - `up<n>` stores `n` bytes into the place 1 byte above the source, and `down<n>` into the
///     place 1 byte below, for 1, 2, 3, 15, 16, 17, 255 and 4097 bytes.
///   - `words_up<n>` and `words_down<n>` store `n` words of 8 bytes into the place 8 bytes
///     above and below the source, for 24, 128 and 4096 bytes.
///   - The last 9 lines store 17 bytes into the place 1 byte above the source: from a struct
///     literal, between two equal ranges, through an argument, through a result, through two
///     pointer parameters, in a callee, from a conditional expression, and as a swap.
/// Each source ends in a byte that is not 0 and that differs from the byte that it replaces,
/// except in the first 4 lines, which are the output of the first program that showed the
/// fault. So a copy of 1 byte less than the size gives another output.
/// The flags select the optimization level: a copy that reads a part of the source after it
/// wrote the destination gives a result that differs between the levels and the sizes. The C
/// file replaces `memcpy` with a function that stops the run when its two ranges overlap, so a
/// copy that reaches `memcpy` of the C library with such ranges fails the test.
struct w {
    i32 x;
    i32[3] tail;
}

struct w17 {
    u8[17] a;
}

struct wlo {
    w17 inner;
    u8 tail;
}

struct whi {
    u8 head;
    w17 inner;
}

// The byte at index `i` of a filled array: it is not 0, and it differs from the byte below it.
fn byte(u64 i) u8 {
    return cast(i % 251 + 1, u8);
}

fn fill(u8 mut@ a) void {
    u64 mut i = 0;
    while (i < a.len) {
        a[i] = byte(i);
        i += 1;
    }
}

// Whether `a` holds the bytes of `fill` after a store of `a.len - 1` bytes from offset 0 to
// offset 1: byte 0 keeps its value, and byte i holds the old byte i - 1.
fn is_up(u8@ a) bool {
    if (a[0] != byte(0)) {
        return false;
    }
    u64 mut i = 1;
    while (i < a.len) {
        if (a[i] != byte(i - 1)) {
            return false;
        }
        i += 1;
    }
    return true;
}

// Whether `a` holds the bytes of `fill` after a store of `a.len - 1` bytes from offset 1 to
// offset 0: byte i holds the old byte i + 1, and the last byte keeps its value.
fn is_down(u8@ a) bool {
    u64 mut i = 0;
    while (i + 1 < a.len) {
        if (a[i] != byte(i + 1)) {
            return false;
        }
        i += 1;
    }
    return a[a.len - 1] == byte(a.len - 1);
}

// The word at index `i` of a filled array: each of its 8 bytes is not 0, and each word differs
// from the word below it in each byte.
fn word(u64 i) u64 {
    return ((i & 0x7f) + 1) * 0x0101010101010101;
}

fn fill_words(u64 mut@ a) void {
    u64 mut i = 0;
    while (i < a.len) {
        a[i] = word(i);
        i += 1;
    }
}

// Whether `a` holds the words of `fill_words` after a store of `a.len - 1` words from index 0 to
// index 1.
fn words_up(u64@ a) bool {
    if (a[0] != word(0)) {
        return false;
    }
    u64 mut i = 1;
    while (i < a.len) {
        if (a[i] != word(i - 1)) {
            return false;
        }
        i += 1;
    }
    return true;
}

// Whether `a` holds the words of `fill_words` after a store of `a.len - 1` words from index 1 to
// index 0.
fn words_down(u64@ a) bool {
    u64 mut i = 0;
    while (i + 1 < a.len) {
        if (a[i] != word(i + 1)) {
            return false;
        }
        i += 1;
    }
    return a[a.len - 1] == word(a.len - 1);
}

// The store of the first program that showed the fault: `tail` is elements 1 to 3 of `big`, and
// `*head` is elements 0 to 2. The two ranges of 12 bytes have 8 bytes in common.
fn shift(i32[4] mut* big) void {
    w mut* shifted = cast(big, w mut*);
    i32[3]* head = cast(big, i32[3]*);
    shifted->tail = *head;
}

struct hi1 {
    u8 head;
    u8[1] a;
}

fn up1() bool {
    hi1 mut x = hi1{};
    u8[2] mut* all = cast(&x, u8[2] mut*);
    fill((*all)[..]);
    u8[1]* low = cast(&x, u8[1]*);
    x.a = *low;
    return is_up((*all)[..]);
}

fn down1() bool {
    hi1 mut x = hi1{};
    u8[2] mut* all = cast(&x, u8[2] mut*);
    fill((*all)[..]);
    u8[1] mut* low = cast(&x, u8[1] mut*);
    *low = x.a;
    return is_down((*all)[..]);
}

struct hi2 {
    u8 head;
    u8[2] a;
}

fn up2() bool {
    hi2 mut x = hi2{};
    u8[3] mut* all = cast(&x, u8[3] mut*);
    fill((*all)[..]);
    u8[2]* low = cast(&x, u8[2]*);
    x.a = *low;
    return is_up((*all)[..]);
}

fn down2() bool {
    hi2 mut x = hi2{};
    u8[3] mut* all = cast(&x, u8[3] mut*);
    fill((*all)[..]);
    u8[2] mut* low = cast(&x, u8[2] mut*);
    *low = x.a;
    return is_down((*all)[..]);
}

struct hi3 {
    u8 head;
    u8[3] a;
}

fn up3() bool {
    hi3 mut x = hi3{};
    u8[4] mut* all = cast(&x, u8[4] mut*);
    fill((*all)[..]);
    u8[3]* low = cast(&x, u8[3]*);
    x.a = *low;
    return is_up((*all)[..]);
}

fn down3() bool {
    hi3 mut x = hi3{};
    u8[4] mut* all = cast(&x, u8[4] mut*);
    fill((*all)[..]);
    u8[3] mut* low = cast(&x, u8[3] mut*);
    *low = x.a;
    return is_down((*all)[..]);
}

struct hi15 {
    u8 head;
    u8[15] a;
}

fn up15() bool {
    hi15 mut x = hi15{};
    u8[16] mut* all = cast(&x, u8[16] mut*);
    fill((*all)[..]);
    u8[15]* low = cast(&x, u8[15]*);
    x.a = *low;
    return is_up((*all)[..]);
}

