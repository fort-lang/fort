//! run
//! stdout:
//| 255 65535 4294967295 18446744073709551615
//| -1 -1 -1
//| -128 128 65408 4294967168
//| 200 -56 200 200
//| 1000 -24 232 1000
//| -1 4294967295 -1 4294967295
//| 127 -128 32767 -32768
// Integer to integer: widening extends by the source's signedness, narrowing
// truncates and a same-width change of sign reinterprets the bits (D3.14).
fn main() i32 {
    i32 neg = -1;
    println(cast(neg, u8), " ", cast(neg, u16), " ", cast(neg, u32), " ", cast(neg, u64));
    println(cast(neg, i8), " ", cast(neg, i16), " ", cast(neg, i64));

    // A signed source sign-extends: -128 stays -128 in i32 and becomes the
    // two's-complement pattern in every unsigned width.
    i8 small = -128;
    println(cast(small, i32), " ", cast(small, u8), " ", cast(small, u16), " ",
            cast(small, u32));

    // An unsigned source zero-extends, so 200 survives every widening and only
    // the same-width change of sign reinterprets it.
    u8 big = 200;
    println(big, " ", cast(big, i8), " ", cast(big, i32), " ", cast(big, u64));

    // Narrowing keeps the low bytes: 1000 is 0x3E8, so the low byte is 0xE8.
    i32 wide = 1000;
    println(wide, " ", cast(wide, i8), " ", cast(wide, u8), " ", cast(wide, i16));

    // u32 and i32 are the same eight bytes once widened by their own
    // signedness, which is what makes the round trip lossless.
    u32 top = 4294967295;
    println(cast(top, i32), " ", cast(cast(top, i32), u32), " ",
            cast(cast(top, i32), i64), " ", cast(top, u64));

    println(cast(127, i8), " ", cast(cast(128, u8), i8), " ", cast(32767, i16), " ",
            cast(cast(32768, u16), i16));
    return 0;
}
