//! run
//! stdout:
//| 2 9 9
//| he
fn i32 main() {
    own mut i32[] s = new(i32[4]);
    mut i32* base = s.ptr;
    mut i32[] view = base[1..3];
    view[0] = 9;
    println(view.len, " ", view[0], " ", s[1]);
    string str = "hello";
    char* cp = str.ptr;
    char[] two = cp[0..2];
    println(cast(two, string));
    del(s);
    return 0;
}
