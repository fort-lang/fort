//! run
//! stdout:
//| 8 24 12
//| 5 6 2 3
//| 42 42 2 3
//| 7 7 1
//| 3 4
// A pointer to a nested array is one word, whatever the array's size, and a
// reference suffix after the array group points at the whole array (D3.6,
// D3.11): `i32[2][3]*` points at two rows of three and `i32[3]*` at one row.
fn fill(i32[2][3] mut* m) void {
    (*m)[1][1] = 42;
}

fn first(i32[3]* row) i32 {
    return (*row)[0];
}

fn main() i32 {
    i32[2][3] mut grid = {{1, 2, 3}, {4, 5, 6}};
    i32[2][3] mut* p = &grid;
    println(sizeof(i32[2][3]*), " ", sizeof(i32[2][3]), " ", sizeof(i32[3]));
    println((*p)[1][1], " ", (*p)[1][2], " ", grid.len, " ", (*p)[0].len);
    // The pointer names the array itself, so a write through it is a write to
    // the array.
    fill(p);
    println(grid[1][1], " ", (*p)[1][1], " ", (*p).len, " ", (*p)[1].len);
    // A pointer to one row addresses that row alone.
    i32[3] mut* row = &grid[0];
    (*row)[0] = 7;
    println(grid[0][0], " ", first(row), " ", cast(cast(row, u64) == cast(&grid[0][0], u64), i32));
    println(grid[0][2], " ", grid[1][0]);
    return 0;
}
