//! run
//! stdout:
//| 2 9 9
//| he
fn i32 main() {
    i32 mut@ own s = new(i32, 4);
    i32 mut* base = s.ptr;
    i32 mut@ view = base[1..3];
    view[0] = 9;
    println(view.len, " ", view[0], " ", s[1]);
    string str = "hello";
    char* cp = str.ptr;
    char@ two = cp[0..2];
    println(cast(two, string));
    del(s);
    return 0;
}
