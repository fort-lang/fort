//! run
//! signal: SEGV
//! signal-macos: BUS
// An allocation of 4 GiB takes a mapping of its own. The runtime gives its storage back to the
// system at its `del` and keeps the mapping, so no later allocation takes its address range
// (D10.9 rule 1). A read through a view of it stops the program with a memory fault (rule 2),
// and the fault writes no line and does not flush the buffered output (D11.5): stdout stays
// empty. The program writes 2 bytes of each allocation, so the run needs little storage.
// D10.3, D10.9, D11.5
fn main() i32 {
    u8 mut@ own block = new(u8, 4294967296);
    block[0] = 7;
    block[4294967295] = 9;
    u8@ view = block;
    del(block);
    u8 mut@ own later = new(u8, 4294967296);
    later[0] = 1;
    println("before the read");
    u8 seen = view[0];
    println("after the read ", seen);
    del(later);
    return 0;
}
