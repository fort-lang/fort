//! run
//! stdout:
//| 5 true h
//| 5 5
//| 3 3 2
//| bye 3
//| 5 6 5 6
// `->` is `(*p).f` (D6.10), and through a pointer to a span or string it
// reaches the `.len` and `.ptr` pseudo-fields as well; indexing through such
// a pointer is written `(*p)[i]` and never `p[i]` (D10.4).
struct box {
    string name;
}

// A struct may name a field `len` or `ptr`: they are fields like any other,
// and the pseudo-fields of D3.5 and D3.7 belong to spans and strings alone.
struct hdr {
    i32 len;
    i32 ptr;
}

fn length_of(string* s) u64 {
    return s->len;
}

fn main() i32 {
    string mut s = "hello";
    string* p = &s;
    // `.len`, `.ptr` and the element behind the dereference.
    println(p->len, " ", p->ptr == s.ptr, " ", (*p)[0]);
    println(length_of(p), " ", length_of(&s));
    // Through a pointer to a fixed array, `.len` is the constant of D3.4 and
    // the operand is not evaluated.
    i32[3] mut xs = {1, 2, 3};
    i32[3]* xp = &xs;
    println(xp->len, " ", (*xp)[2], " ", (*xp)[1]);
    // A pointer to a struct reaches a string field, whose pseudo-fields are
    // then read with `.` (D6.7).
    box b = {"bye"};
    box* bp = &b;
    println(bp->name, " ", bp->name.len);
    hdr h = {5, 6};
    hdr* hp = &h;
    println(hp->len, " ", hp->ptr, " ", h.len, " ", h.ptr);
    return 0;
}
