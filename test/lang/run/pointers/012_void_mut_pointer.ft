//! run
//! stdout:
//| 1 2
//| 0 2
//| 0 0
//| true true
import extern;
// `void* mut p` marks the binding and `void mut* p` the storage the pointer
// reaches, so the two are distinct types and both are legal (D3.11, D5.3).
// No expression reaches that storage, and no cast gives a type to a `void*`
// (D3.14), so the mark states what C may do with the address: bzero writes
// through a `void mut*`.
// C: bzero, bzero(3) of glibc and of macOS, <strings.h>; POSIX.1-2001, which POSIX.1-2008 removed.
// writes: n zero bytes at dst. gives: no result. keeps: no pointer. calls: no fort function. frees:
// nothing.
extern fn bzero(void mut* dst, u64 n) void;

// C call bzero x2: w, which is cast(&x, void mut*), and cast(&y, void mut*) keep the bounds of the
// locals x and y, one i32 each (D9.8 rule 2), and the length sizeof(i32) fits each.
fn main() i32 {
    i32 mut x = 1;
    i32 mut y = 2;
    println(x, " ", y);

    // A fixed binding whose target may be written.
    void mut* w = cast(&x, void mut*);
    bzero(w, sizeof(i32));
    println(x, " ", y);

    // A rebindable binding whose target is read-only. No cast puts the mark
    // back, so the holder of this address never writes through it (D3.14). A
    // writable view of `y` comes from `&y`, which is a mutable lvalue, and
    // never from `r`.
    void* mut r = cast(&x, void*);
    r = cast(&y, void*);
    bzero(cast(&y, void mut*), sizeof(i32));
    println(x, " ", y);

    // Dropping the mark is implicit, and the two types are one machine word,
    // so the address survives the conversion (D5.4, D3.1). The comparison below
    // casts, because `==` requires identical types and the drop does not reach
    // it: `lent == w` is an error (D6.2, fail/mutability/011).
    void* lent = w;
    println(lent == cast(w, void*), " ", r == cast(&y, void*));
    return 0;
}
