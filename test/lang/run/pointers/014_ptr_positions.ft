//! run
//! stdout:
//| abc
//| 3 0 3
//| true true true
//| true true
//| xyz 3
//| true true
import extern;
import std.libc;
import std.str;

// The `.ptr` of a span or a string stands in two positions (D3.5), each as it stands: an argument
// of an `extern fn`, which only a trusted module calls (D9.8), and an operand of `==` or `!=`. No
// cast takes a `.ptr`, so a program casts a span first, `cast(text, u8@).ptr`, or writes the
// address of an element, `cast(&s[0], void*)`. A buffer that C wrote a C string into goes to
// `str.from_cbuf`. Each line below uses one of these forms.

// strdup gives a new allocation, which says `own`. C reads its argument up to the NUL that a
// string literal holds after its last byte (D3.7).
// C: strdup, strdup(3) of POSIX.1-2017.
// writes: nothing in fort storage; C reads s to its NUL. gives: null, or a new allocation of malloc
// that holds a copy of s with its NUL. keeps: no pointer. calls: no fort function. frees: nothing.
extern fn strdup(char* s) char mut* own;

// C call libc.write x2: cast(text, u8@).ptr keeps the bound of the literal text, 4 bytes, with the
// length text.len; cast(empty, u8@).ptr keeps the bound of empty, 0 bytes, with the length
// empty.len, 0, so C reads no byte (D9.8 rule 2).
// C call libc.strlen: text.ptr names the literal text, which strlen reads to the NUL of that
// literal (rule 4).
// C call libc.memcmp: bytes.ptr twice, with the length 0, so C reads no byte.
// C call strdup: text.ptr, the literal text with its NUL (rule 4).
// C call libc.getenv: &name[0] names the local name, which a literal initializes and no store
// changes, and getenv reads it to the NUL of that literal (rule 4).
// C call libc.free: cast(move(copy), void* own), the allocation that strdup gave in this function,
// or null (rule 3).
fn main() i32 {
    string text = "abc\n";
    // write reads the `.len` bytes from the `.ptr` of its span. The span cast gives the bytes the
    // type of the parameter, and the `.ptr` of an empty span goes to C too, with a length of 0.
    i64 wrote = libc.write(1, cast(text, u8@).ptr, text.len);
    string empty = text[4..];
    libc.write(1, cast(empty, u8@).ptr, empty.len);
    // strlen reads up to the NUL of the literal, and memcmp reads no byte for a length of 0.
    u8@ bytes = cast(text, u8@);
    println(libc.strlen(text.ptr) - 1, " ", libc.memcmp(bytes.ptr, bytes.ptr, 0), " ", wrote - 1);

    // == and != compare the address, through `->` too. The `.ptr` of an empty span at the end of
    // its object compares as the byte after the object, and a read through it does not exist.
    u8 mut@ own heap = new(u8, 4);
    u8 mut@ tail = heap[4..];
    u8 mut@* where = &tail;
    println(tail.ptr != null, " ", where->ptr == tail.ptr, " ", heap[0..0].ptr == heap.ptr);
    // The address of an element goes to a `void*` or to a `u64`, and its index is checked.
    println(cast(&heap[0], void*) != null, " ", cast(&heap[3], u64) - cast(&heap[0], u64) == 3);

    // An extern whose result says `own`, and a buffer for str.from_cbuf.
    char mut* own copy = strdup(text.ptr);
    char mut@ own buf = new(char, 4);
    buf[0] = 'x';
    buf[1] = 'y';
    buf[2] = 'z';
    string view = str.from_cbuf(cast(buf[..], u8@));
    println(view, " ", view.len);

    // The address of an element stands in each position: getenv reads `name` up to its NUL.
    string name = "FORT_T542_UNSET";
    char* found = libc.getenv(&name[0]);
    println(found == null, " ", copy != null);
    libc.free(cast(move(copy), void* own));
    del(buf);
    del(heap);
    return 0;
}
