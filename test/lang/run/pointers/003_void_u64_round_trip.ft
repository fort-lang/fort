//! run
//! stdout:
//| 5 true
//| true 5
//| 8
fn i32 five() {
    return 5;
}

fn i32 main() {
    i32 x = 5;
    i32* p = &x;
    void* v = cast(p, void*);
    i32* back = cast(v, i32*);
    println(*back, " ", back == p);
    u64 addr = cast(p, u64);
    i32* again = cast(addr, i32*);
    println(again == p, " ", *again);
    fn i32() fp = five;
    void* fv = cast(fp, void*);
    fn i32() fback = cast(fv, fn i32());
    println(fback() + 3);
    return 0;
}
