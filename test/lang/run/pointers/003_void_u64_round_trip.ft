//! run
//! stdout:
//| 5 true
//| true 5
fn main() i32 {
    i32 x = 5;
    i32* p = &x;
    // The `void*` keeps the address, and no cast takes it back to a typed pointer (D3.14).
    void* v = cast(p, void*);
    println(*p, " ", cast(v, u64) == cast(p, u64));
    // The address goes to a `u64` and stays the same, and no cast takes it back (D3.14).
    u64 addr = cast(p, u64);
    println(addr == cast(v, u64), " ", *p);
    return 0;
}
