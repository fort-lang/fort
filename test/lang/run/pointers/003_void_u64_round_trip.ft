//! run
//! stdout:
//| 5 true
//| true 5
fn i32 main() {
    i32 x = 5;
    i32* p = &x;
    void* v = cast(p, void*);
    i32* back = cast(v, i32*);
    println(*back, " ", back == p);
    u64 addr = cast(p, u64);
    i32* again = cast(addr, i32*);
    println(again == p, " ", *again);
    return 0;
}
