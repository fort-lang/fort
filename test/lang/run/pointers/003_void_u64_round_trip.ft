//! run
//! stdout:
//| 5 true
//| true 5
fn main() i32 {
    i32 x = 5;
    i32* p = &x;
    void* v = cast(p, void*);
    i32* back = cast(v, i32*);
    println(*back, " ", back == p);
    // The address goes to a `u64` and stays the same, and no cast takes it back (D3.14).
    u64 addr = cast(p, u64);
    println(addr == cast(back, u64), " ", *p);
    return 0;
}
