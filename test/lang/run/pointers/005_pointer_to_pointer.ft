//! run
//! stdout:
//| 1 9
//| 2 2
//| 3
fn void set_target(mut i32** pp, i32 v) {
    **pp = v;
}

fn i32 main() {
    mut i32 x = 1;
    mut i32 other = 2;
    mut i32* p = &x;
    mut i32** pp = &p;
    i32 before = **pp;
    **pp = 9;
    println(before, " ", x);
    *pp = &other;
    println(*p, " ", **pp);
    set_target(pp, 3);
    println(other);
    return 0;
}
