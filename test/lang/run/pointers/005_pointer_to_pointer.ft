//! run
//! stdout:
//| 1 9
//| 2 2
//| 3
fn void set_target(i32 mut* mut* pp, i32 v) {
    **pp = v;
}

fn i32 main() {
    i32 mut x = 1;
    i32 mut other = 2;
    i32 mut* mut p = &x;
    i32 mut* mut* pp = &p;
    i32 before = **pp;
    **pp = 9;
    println(before, " ", x);
    *pp = &other;
    println(*p, " ", **pp);
    set_target(pp, 3);
    println(other);
    return 0;
}
