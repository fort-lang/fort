//! run
//! stdout:
//| false true
//| true 4 true
//| 7 7
//| 3 true
//| true
// `new(void*)` allocates one pointer slot and `new(void*, n)` a span of them,
// zeroed like every allocation (D10.2, D17.3): `void` has no target level to
// mark, so the storage is writable at the levels the suffixes introduce and
// nowhere else (D3.11, D5.8). This is the allocation std::vec's ptr_vec makes.
struct node {
    i32 value;
}

fn i32 main() {
    void* mut* own one = new(void*);
    println(one == null, " ", *one == null);

    void* mut@ own many = new(void*, 4);
    println(many.ptr != null, " ", many.len, " ", many[0] == null);

    node mut n = {7};
    *one = cast(&n, void*);
    many[3] = cast(&n, void*);
    println(cast(*one, node*)->value, " ", cast(many[3], node*)->value);

    // A span of no slots is still an allocation of its own (D10.2).
    void* mut@ own none = new(void*, 0);
    println(many.len - 1, " ", none.ptr != null);

    // del frees the slots and never the pointees, which belong to whoever
    // made them (D13.5, D17.9).
    del(one);
    del(many);
    del(none);
    println(n.value == 7);
    return 0;
}
