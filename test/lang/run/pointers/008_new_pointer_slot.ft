//! run
//! stdout:
//| false true
//| 5 5
//| true
// new(T*) has no count, so it allocates one zeroed pointer slot and yields T mut* mut* own
// (D10.2); the slot borrows what is stored in it, and del frees the slot alone.
struct node {
    i32 value;
}

fn i32 main() {
    node mut* mut* own pp = new(node*);
    println(pp == null, " ", *pp == null);
    node mut* own n = new(node);
    n->value = 5;
    *pp = n;                                  // lends: the slot borrows the node
    println((*pp)->value, " ", n->value);
    del(n);
    del(pp);                                  // frees the slot, not the node
    println(pp == null);
    return 0;
}
