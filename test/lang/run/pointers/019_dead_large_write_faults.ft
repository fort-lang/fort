//! run
//! signal: SEGV
//! signal-macos: BUS
// The runtime gives the storage of a large allocation back to the system at its `del` and keeps
// the address range (D10.9 rule 1). So a write through a view of it stops the program with a
// memory fault (rule 2), and the fault writes no line and does not flush the buffered output
// (D11.5): stdout stays empty. The write changes no live allocation.
// D10.3, D10.9, D11.5
fn main() i32 {
    u8 mut@ own block = new(u8, 4194304);
    u8 mut@ view = block;
    del(block);
    u8 mut@ own later = new(u8, 4194304);
    later[0] = 1;
    println("before the write");
    view[4194303] = 2;
    println("after the write ", later[0]);
    del(later);
    return 0;
}
