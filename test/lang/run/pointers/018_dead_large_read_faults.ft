//! run
//! signal: SEGV
//! signal-macos: BUS
// The runtime gives the storage of a large allocation back to the system at its `del` and keeps
// the address range (D10.9 rule 1). So a read through a view of it stops the program with a
// memory fault (rule 2), and the fault writes no line and does not flush the buffered output
// (D11.5): stdout stays empty. The read gives no zero byte and no byte of the later allocation.
// D10.3, D10.9, D11.5
fn main() i32 {
    u8 mut@ own block = new(u8, 4194304);
    block[0] = 7;
    block[4194303] = 9;
    u8@ view = block;
    del(block);
    u8 mut@ own later = new(u8, 4194304);
    later[0] = 1;
    println("before the read");
    u8 seen = view[0];
    println("after the read ", seen);
    del(later);
    return 0;
}
