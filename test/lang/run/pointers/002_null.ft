//! run
//! stdout:
//| true false
//| 0x0 0x0
//| none some
//| ok
fn describe(i32* p) string {
    if (p == null) {
        return "none";
    }
    return "some";
}

fn main() i32 {
    i32 x = 1;
    i32* own n = null;
    i32* p = &x;
    println(n == null, " ", p == null);
    void* own v = null;
    println(n, " ", v);
    println(describe(null), " ", describe(p));
    del(n);
    del(v);
    println("ok");
    return 0;
}
