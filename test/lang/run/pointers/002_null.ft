//! run
//! stdout:
//| true false
//| 0x0 0x0 0x0
//| none some
//| ok
fn string describe(i32* p) {
    if (p == null) {
        return "none";
    }
    return "some";
}

fn i32 main() {
    i32 x = 1;
    own i32* n = null;
    i32* p = &x;
    println(n == null, " ", p == null);
    own void* v = null;
    fn void() f = null;
    println(n, " ", v, " ", f);
    println(describe(null), " ", describe(p));
    del(n);
    del(v);
    println("ok");
    return 0;
}
