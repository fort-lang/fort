//! run
//! stdout:
//| 8
//| true true
// A function pointer goes to `void*`, and the `void*` compares by identity. No cast brings it
// back: a `void*` reaches no type, so `cast(fv, fn () i32)` is an error (D3.14). The function
// stays callable through its own type, and an identity cast keeps it.
fn five() i32 {
    return 5;
}

fn main() i32 {
    fn () i32 fp = five;
    void* fv = cast(fp, void*);
    fn () i32 same = cast(fp, fn () i32);
    println(same() + 3);
    println(cast(same, void*) == fv, " ", fv != null);
    return 0;
}
