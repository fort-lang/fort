//! run
//! stdout:
//| 0
// A copy of a released pointer stays in a local. A later `new` of the same size does not get the
// dead storage (D10.9 rule 1), so the store of an owner through the copy changes only dead
// storage (rule 2): the `data` of the new object stays null. The allocation `anchor` stands
// beside the dead object, so the runtime keeps that storage.
// D10.3, D10.9
struct box {
    u8 mut* own data;
}

fn main() i32 {
    u8 mut* own anchor = new(u8);
    box mut* own mut p = new(box);
    box mut* q = p;
    del(p);
    p = new(box);
    del(q->data);
    q->data = new(u8);
    i32 mut seen = 0;
    if (p->data != null) {
        seen = 1;
    }
    println(seen);
    p->data = new(u8);
    del(p->data);
    del(p);
    del(anchor);
    return seen;
}
