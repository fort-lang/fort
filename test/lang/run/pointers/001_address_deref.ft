//! run
//! stdout:
//| 5 5
//| 7 7
//| 3 4 4
struct point {
    i32 x;
    i32 y;
}

fn main() i32 {
    i32 x = 5;
    i32* p = &x;
    println(*p, " ", x);
    i32 mut y = 1;
    i32 mut* q = &y;
    *q = 7;
    println(y, " ", *q);
    point mut pt = {3, 0};
    point mut* pp = &pt;
    pp->y = 4;
    println(pp->x, " ", (*pp).y, " ", pt.y);
    return 0;
}
