//! run
//! stdout:
//| 5 5
//| 7 7
//| 3 4 4
struct point {
    i32 x;
    i32 y;
}

fn i32 main() {
    i32 x = 5;
    i32* p = &x;
    println(*p, " ", x);
    mut i32 y = 1;
    mut i32* q = &y;
    *q = 7;
    println(y, " ", *q);
    mut point pt = {3, 0};
    mut point* pp = &pt;
    pp->y = 4;
    println(pp->x, " ", (*pp).y, " ", pt.y);
    return 0;
}
