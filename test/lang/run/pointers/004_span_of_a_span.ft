//! run
//! stdout:
//| 2 9 9
//| he
// A span of a span and of a string stays legal everywhere, with its check (D6.9). A pointer holds
// no length, so no span of a pointer exists outside str.from_cstr and rt.args_init, and the
// element address `&s[1]` replaces the pointer that `p[1..3]` took a view of before.
fn main() i32 {
    i32 mut@ own s = new(i32, 4);
    i32 mut@ view = s[1..3];
    view[0] = 9;
    println(view.len, " ", view[0], " ", s[1]);
    i32 mut* second = &s[1];
    *second = 9;
    string str = "hello";
    string two = str[0..2];
    println(two);
    del(s);
    return 0;
}
