//! run
//! stdout:
//| 0 1 2
//| 3 2 1
//| 5
//| 4
//| 2
fn step_of(i32 mut* mut cell) i32 {
    *cell = *cell + 1;
    return *cell;
}

fn main() i32 {
    for (i32 mut i = 0; i < 3; i++) {
        print(i);
        if (i < 2) {
            print(" ");
        }
    }
    println();
    for (i32 mut i = 3; i > 0; i--) {
        print(i);
        if (i > 1) {
            print(" ");
        }
    }
    println();
    i32 mut cell = 0;
    for (step_of(&cell); cell < 5; step_of(&cell)) {
    }
    println(cell);
    i32 mut outer = 0;
    for (outer = 4; false; outer++) {
        outer = 99;
    }
    println(outer);
    i32 mut seen = 0;
    for (i32 mut i = 0; i < 4; i++) {
        if (i == 0) {
            continue;
        }
        if (i == 3) {
            break;
        }
        seen++;
    }
    println(seen);
    return 0;
}
