//! run
//! stdout:
//| 4 6
//| 1 2
//| 2
//| 6
struct point { i32 x; i32 y; }

fn i32 main() {
    point[2] ps = {{1, 2}, {3, 4}};
    i32 mut sx = 0;
    i32 mut sy = 0;
    for (point p : ps) {
        sx += p.x;
        sy += p.y;
    }
    println(sx, " ", sy);
    for (point mut p : ps) {
        p.x = 0;
        p.y = 0;
    }
    println(ps[0].x, " ", ps[0].y);
    i32 mut stopped = 0;
    for (point p : ps) {
        stopped += p.x;
        break;
    }
    println(stopped + 1);
    i32 mut skipped = 0;
    for (point p : ps) {
        if (p.x == 1) {
            continue;
        }
        skipped += p.x;
    }
    println(skipped + 3);
    return 0;
}
