//! run
//! stdout:
//| 5.0 10
//| 0.5 true
//| 1.0 2.0 4.0 8.0
// Floats in the conditions and the bodies of the loops: a `while` that halves
// a value, a counted loop that accumulates one, and a `break` on a float
// comparison (D7.4, D7.5).
fn i32 main() {
    f64 mut total = 0.0;
    i32 mut count = 0;
    while (count < 10) {
        total = total + 0.5;
        count += 1;
    }
    println(total, " ", count);
    f64 mut value = 8.0;
    while (value > 0.5) {
        value = value / 2.0;
    }
    println(value, " ", value == 0.5);
    f64 mut step = 1.0;
    i32 mut i = 0;
    while (true) {
        print(step);
        if (step >= 8.0) {
            break;
        }
        print(" ");
        step = step * 2.0;
        i += 1;
    }
    println("");
    return 0;
}
