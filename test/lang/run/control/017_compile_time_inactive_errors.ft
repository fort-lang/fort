//! run
//! flags: --cfg mode=good
//! stdout:
//| good
// An inactive branch is parsed and never checked: the four errors of the
// `else` branch (a bool from an integer, an unknown name, a `break` outside a
// loop, a copied owning value) are silent while `--cfg mode=good` selects the
// first branch. The selected branch alone decides return and ownership
// analysis.
fn main() i32 {
    $if ($cfg(mode) == "good") {
        println("good");
        return 0;
    } else {
        bool wrong = 1;
        i32 missing_copy = missing_value;
        break;
        i32 mut* own first = new(i32);
        i32 mut* own second = first;
        del(first);
        del(second);
        return 1;
    }
}
