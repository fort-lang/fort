//! run
//! stdout:
//| 5 4 3 2 1
//| 15
fn i32 main() {
    i32 mut n = 5;
    while (n > 0) {
        print(n);
        if (n > 1) {
            print(" ");
        }
        n--;
    }
    println();
    i32 mut total = 0;
    i32 mut i = 1;
    while (i <= 5) {
        total += i;
        i++;
    }
    println(total);
    return 0;
}
