//! run
//! stdout:
//| 1 4
//| 6 3
//| 4:5 |5:5
fn main() i32 {
    i32 mut outer = 0;
    i32 mut inner = 0;
    for (i32 mut i = 0; i < 4; i++) {
        for (i32 mut j = 0; j < 2; j++) {
            inner++;
        }
        if (i == 1) {
            break;
        }
        outer++;
    }
    println(outer, " ", inner);
    i32 mut kept = 0;
    i32 mut runs = 0;
    for (i32 mut i = 0; i < 3; i++) {
        i32 mut j = 0;
        while (j < 2) {
            j++;
            if (j == 9) {
                break;
            }
        }
        runs += j;
        if (i == 0) {
            continue;
        }
        kept++;
    }
    println(runs, " ", kept + 1);
    i32[2] two = {4, 5};
    for (i32 v : two) {
        for (i32 w : two) {
            if (w == 4) {
                continue;
            }
            print(v, ":", w);
        }
        if (v == 5) {
            break;
        }
        print(" |");
    }
    println();
    return 0;
}
