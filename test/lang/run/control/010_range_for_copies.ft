//! run
//! stdout:
//| 6
//| 1 2 100
//| 3
//| 5
fn main() i32 {
    i32[3] mut a = {1, 2, 3};
    i32 mut sum = 0;
    for (i32 v : a) {
        a[2] = 100;
        sum += v;
    }
    println(sum);
    println(a[0], " ", a[1], " ", a[2]);
    i32 mut hops = 0;
    for (i32 v : a) {
        hops++;
    }
    println(hops);
    i32 mut empty = 5;
    for (char c : "") {
        empty = 0;
    }
    println(empty);
    return 0;
}
