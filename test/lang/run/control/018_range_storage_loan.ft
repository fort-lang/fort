//! run
//! stdout:
//| 1 2 3 6 4
//| ab 1
// The loop holds its collection once. Element writes remain legal (D7.5, D17.10).
u64 mut CALLS = 0;
fn text() string {
    *(&CALLS) += 1;
    return "ab";
}
fn main() i32 {
    u8 mut@ own s = new(u8, 3);
    s[0] = 1;
    s[1] = 2;
    s[2] = 3;
    u64 mut sum = 0;
    for (u8 x : s) {
        print(x, " ");
        sum += cast(x, u64);
        s[2] = 3;
        s[0] = 4;
    }
    println(sum, " ", s[0]);
    del(s);
    for (char x : text()) { print(x); }
    println(" ", *(&CALLS));
    return 0;
}
