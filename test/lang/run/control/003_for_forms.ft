//! run
//! stdout:
//| 0 1 2 3 4
//| 0 2 4 6 8
//| 10
//| 1 3 5
//| 3
fn main() i32 {
    for (i32 mut i = 0; i < 5; i++) {
        print(i);
        if (i < 4) {
            print(" ");
        }
    }
    println();
    i32 mut j = 0;
    for (j = 0; j < 10; j += 2) {
        print(j);
        if (j < 8) {
            print(" ");
        }
    }
    println();
    println(j);
    for (i32 mut k = 0; k < 6; k++) {
        if (k % 2 == 0) {
            continue;
        }
        print(k);
        if (k < 5) {
            print(" ");
        }
    }
    println();
    i32 mut n = 0;
    for (;;) {
        n++;
        if (n == 3) {
            break;
        }
    }
    println(n);
    return 0;
}
