//! run
//! stdout:
//| 8 16 24 1 4
// The checker sizes an array of a named type in a `$if` condition (D3.4). An
// array that fits gives the size of its reference. `late` is declared after its
// use and `node` reaches itself through a pointer; each takes 16 bytes, so
// 2^59 - 1 of them need 2^63 - 16 bytes (D3.8, D7.10). An enum takes 4 bytes,
// so 2^61 - 1 of them need 2^63 - 4 bytes (D3.9). `||` does not evaluate
// its right operand, and an inactive branch evaluates no condition (D21.2).
$if (sizeof(late[576460752303423487]*) == 8) { u64 LATE = 8; } else { u64 LATE = 0; }
$if (sizeof(node[576460752303423487]@) == 16) { u64 NODE = 16; } else { u64 NODE = 0; }
$if (sizeof(fn(node[576460752303423487]) void) == 8) { u64 PART = 24; } else { u64 PART = 0; }
$if (true || sizeof(node[4611686018427387904]*) == 8) { u64 SHORT = 1; } else { u64 SHORT = 0; }
$if (sizeof(color[2305843009213693951]*) == 8) { u64 ENUM = 4; } else { u64 ENUM = 0; }
$if (false) {
    $if (sizeof(node[4611686018427387904]*) == 8) { i32 INACTIVE = 1; }
}
enum color { red, green }
struct late {
    u64 a;
    u64 b;
}
struct node {
    node* next;
    u64 value;
}

fn main() i32 {
    println(LATE, " ", NODE, " ", PART, " ", SHORT, " ", ENUM);
    return 0;
}
