//! run
//! stdout:
//| 6
//| 30
//| 5 o
//| 1 2 3
//| 2 4 6
fn i32 main() {
    i32[3] a = {1, 2, 3};
    i32 mut sum = 0;
    for (i32 v : a) {
        sum += v;
    }
    println(sum);
    i32 mut@ own s = new(i32, 3);
    s[0] = 10;
    s[1] = 10;
    s[2] = 10;
    i32 mut total = 0;
    for (i32 v : s) {
        total += v;
    }
    println(total);
    i32 mut count = 0;
    char mut last = 'a';
    for (char c : "hello") {
        count++;
        last = c;
    }
    println(count, " ", last);
    for (i32 mut v : a) {
        v *= 2;
    }
    println(a[0], " ", a[1], " ", a[2]);
    for (u64 mut i = 0; i < s.len; i++) {
        s[i] = cast(i + 1, i32) * 2;
    }
    println(s[0], " ", s[1], " ", s[2]);
    del(s);
    return 0;
}
