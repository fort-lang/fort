//! run
//! stdout:
//| 6
//| 5 o
//| 1 2 3
//| 6
fn main() i32 {
    i32[3] a = {1, 2, 3};
    i32 mut sum = 0;
    for (i32 v : a) {
        sum += v;
    }
    println(sum);
    i32 mut count = 0;
    char mut last = 'a';
    for (char c : "hello") {
        count++;
        last = c;
    }
    println(count, " ", last);
    for (i32 mut v : a) {
        v *= 2;
    }
    println(a[0], " ", a[1], " ", a[2]);
    i32 mut again = 0;
    for (i32 v : a) {
        again += v;
    }
    println(again);
    return 0;
}
