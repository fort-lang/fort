//! run
//! stdout:
//| 6
//| 30
//| 5 o
//| 1 2 3
//| 2 4 6
fn i32 main() {
    i32[3] a = {1, 2, 3};
    mut i32 sum = 0;
    for (i32 v : a) {
        sum += v;
    }
    println(sum);
    mut i32[] s = new(i32[3]);
    s[0] = 10;
    s[1] = 10;
    s[2] = 10;
    mut i32 total = 0;
    for (i32 v : s) {
        total += v;
    }
    println(total);
    mut i32 count = 0;
    mut char last = 'a';
    for (char c : "hello") {
        count++;
        last = c;
    }
    println(count, " ", last);
    for (mut i32 v : a) {
        v *= 2;
    }
    println(a[0], " ", a[1], " ", a[2]);
    for (mut u64 i = 0; i < s.len; i++) {
        s[i] = cast(i + 1, i32) * 2;
    }
    println(s[0], " ", s[1], " ", s[2]);
    del(s);
    return 0;
}
