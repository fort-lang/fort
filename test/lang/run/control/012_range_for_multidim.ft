//! run
//! stdout:
//| 21
//| 1 2 3 4 5 6
//| 6 1 2 3 4 5 6
//| 3 3 0
//| 21 2
//| 1 2 3 4 5 6
//| 56
// A range `for` over a nested array walks the rows, and each row is a value
// of its own (D3.4, D7.4): the loop variable is a copy, so a write to it
// leaves the array alone.
fn i32 main() {
    i32[2][3] mut m = {{1, 2, 3}, {4, 5, 6}};
    i32 mut total = 0;
    for (i32[3] row : m) {
        for (i32 v : row) {
            total += v;
        }
    }
    println(total);
    // The rows come out in order.
    bool mut first = true;
    for (i32[3] row : m) {
        for (i32 v : row) {
            if (!first) {
                print(" ");
            }
            first = false;
            print(v);
        }
    }
    println();
    // A write to the loop variable writes the copy.
    i32 mut seen = 0;
    for (i32[3] mut row : m) {
        row[0] = 0;
        seen += row.len;
    }
    print(seen);
    for (i32[3] row : m) {
        for (i32 v : row) {
            print(" ");
            print(v);
        }
    }
    println();
    // The same loop over a span of rows, whose length is a run-time value.
    i32 n = 2;
    i32[3] mut@ own g = new(i32[3], n);
    i32 mut k = 1;
    for (i32[3] mut row : g) {
        row[0] = 1;
        k++;
    }
    // The row the loop bound is a copy here too, so the span still holds the
    // zeros new() gave it (D3.4, D10.2).
    println(k, " ", g[0].len, " ", g[0][0]);
    for (u64 mut i = 0; i < g.len; i++) {
        for (i32 mut j = 0; j < 3; j++) {
            g[i][j] = m[i][j];
        }
    }
    total = 0;
    i32 mut rows = 0;
    for (i32[3] row : g) {
        rows++;
        for (i32 v : row) {
            total += v;
        }
    }
    println(total, " ", rows);
    first = true;
    for (i32[3] row : g) {
        for (i32 v : row) {
            if (!first) {
                print(" ");
            }
            first = false;
            print(v);
        }
    }
    println();
    // An array of spans lends each element to the loop (D17.4).
    i32[3] mut a = {10, 11, 12};
    i32 mut@[2] mut spans = {a[0..3], a[1..3]};
    total = 0;
    for (i32 mut@ s : spans) {
        for (i32 v : s) {
            total += v;
        }
    }
    println(total);
    return 0;
}
