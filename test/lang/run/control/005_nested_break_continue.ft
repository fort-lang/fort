//! run
//! stdout:
//| 0,0 0,1 1,0 1,1 2,0 2,1
//| 8
fn i32 main() {
    for (i32 mut i = 0; i < 3; i++) {
        for (i32 mut j = 0; j < 5; j++) {
            if (j == 2) {
                break;
            }
            print(i, ",", j);
            if (i < 2 || j < 1) {
                print(" ");
            }
        }
    }
    println();
    i32 mut hits = 0;
    for (i32 mut i = 0; i < 4; i++) {
        if (i % 2 == 0) {
            continue;
        }
        i32 mut j = 0;
        while (j < 10) {
            j++;
            if (j == i + 2) {
                break;
            }
        }
        hits += j;
    }
    println(hits);
    return 0;
}
