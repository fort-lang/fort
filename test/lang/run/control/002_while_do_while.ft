//! run
//! stdout:
//| 5 4 3 2 1
//| 15
//| ran once 1
//| 3
fn i32 main() {
    mut i32 n = 5;
    while (n > 0) {
        print(n);
        if (n > 1) {
            print(" ");
        }
        n--;
    }
    println();
    mut i32 total = 0;
    mut i32 i = 1;
    while (i <= 5) {
        total += i;
        i++;
    }
    println(total);
    mut i32 k = 0;
    do {
        print("ran once ");
        k++;
    } while (k < 1);
    println(k);
    mut i32 j = 0;
    do {
        j++;
    } while (j < 3);
    println(j);
    return 0;
}
