//! run
//! stdout:
//| negative zero small large
//| odd even
fn classify(i32 n) string {
    if (n < 0) {
        return "negative";
    } else if (n == 0) {
        return "zero";
    } else if (n < 10) {
        return "small";
    } else {
        return "large";
    }
}

fn parity(i32 n) string {
    string mut r = "even";
    if (n % 2 != 0) {
        r = "odd";
    }
    return r;
}

fn main() i32 {
    println(classify(-4), " ", classify(0), " ", classify(3), " ", classify(50));
    println(parity(7), " ", parity(8));
    return 0;
}
