//! run
//! stdout:
//| 4
//| 6
//| 12
//| 3
fn i32 first_over(i32 limit) {
    i32 mut n = 0;
    while (true) {
        n++;
        if (n > limit) {
            return n;
        }
    }
}

fn i32 sum_until(i32 limit) {
    i32 mut total = 0;
    i32 mut i = 0;
    for (;;) {
        i++;
        if (i > limit) {
            return total;
        }
        total += i;
    }
}

fn i32 countdown(i32 from) {
    for (i32 mut i = from; ; i--) {
        if (i <= 0) {
            return from * 2;
        }
    }
}

fn i32 main() {
    println(first_over(3));
    println(sum_until(3));
    println(countdown(6));
    i32 mut hops = 0;
    while (true) {
        hops++;
        if (hops == 3) {
            break;
        }
    }
    println(hops);
    return 0;
}
