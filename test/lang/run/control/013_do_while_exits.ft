//! run
//! stdout:
//| 1 2 3 4 5
//| a ab c
//| 2
//| left 3
// The two exits of a `do` and the deferred statements they run (D7.5, D7.6,
// D7.8): `continue` goes to the test, `break` leaves the loop before the
// test, and a `defer` in the body runs at every exit and at the end of every
// iteration. The second loop prints "a" and the deferred space on the
// iteration that continues, then "ab" and the deferred space on the one that
// breaks.
fn main() i32 {
    i32 mut i = 0;
    do {
        i++;
        print(i);
        if (i < 5) {
            print(" ");
            continue;
        }
    } while (i < 5);
    println();
    i32 mut n = 0;
    do {
        defer print(" ");
        n++;
        print("a");
        if (n == 1) {
            continue;
        }
        print("b");
        if (n == 2) {
            break;
        }
        print("z");
    } while (n < 9);
    println("c");
    println(n);
    i32 mut k = 0;
    do {
        k++;
    } while (false);
    println("left ", k + 2);
    return 0;
}
