//! run
//! stdout:
//| 6 0 0
// The selector reads a constant declared after its use, keeps the ordinary
// precedence of the logical operators, folds a fixed-array `.len`, a shift
// and a character operand from the declared types and values, and does not
// evaluate an operand that `&&`, `||` or `?:` skips: a missing name or a
// division by zero. It does not evaluate a nested `$if` in an inactive
// branch, so a `sizeof` there reports nothing (D21.2). Every alternative pair
// declares its name once.
bool FIRST = BASE;
string EMPTY = {};
bool BASE = true;
i32[3] ITEMS = {};
u8 LEFT = 1;
u64 LAST = 7;

$if ((!false && FIRST || false) && EMPTY == "") {
    fn selected_value() i32 { return 6; }
} else {
    fn selected_value() i32 { return 90; }
}

$if (false && MISSING_AND) { i32 SKIPPED_AND = 1; } else { i32 SKIPPED_AND = 0; }
$if (true || (1 / 0 == 0)) { i32 SKIPPED_OR = 0; } else { i32 SKIPPED_OR = 1; }
$if (true ? true : MISSING_TERNARY) { i32 SKIPPED_TERNARY = 0; } else { i32 SKIPPED_TERNARY = 1; }
$if (false) {
    $if (sizeof(i32) == 4) { i32 SKIPPED_NESTED = 1; }
}
i32 SKIPPED_SIZEOF = 0;

$if (ITEMS.len == 3 && (LEFT << LAST) == cast(128, u8) && ('a' & 15) == 1
     && cast(9223372036854775807, u64) == 9223372036854775807) {
    i32 FOLDED = 0;
} else {
    i32 FOLDED = 1;
}

fn main() i32 {
    $if (false) {
        return missing_value;
    } else $if (true) {
        println(selected_value(), " ", SKIPPED_AND + SKIPPED_OR + SKIPPED_TERNARY + SKIPPED_SIZEOF,
                " ", FOLDED);
    } else {
        return 91;
    }
    return 0;
}
