//! run
//! stdout:
//| 0 3 2 3 7 x
// The selector reads a parenthesized type as the type it groups (D3.6). A
// cast target, a constant type and the type of a fixed-array `.len` name can
// each be a group. Every alternative pair declares its name once, and the
// unselected name is 1.
(i32[3]) ARR = {1, 2, 3};
(i32[4])[2] ROWS = {};
(i32[3]) mut MARR = {};
(i32*)[2] PTRS = {};
(void*)[2] VOIDS = {};
((i32)[1]) ONE = {};
(u8) BYTE = 7;
((string)) NAME = "x";

$if (cast(300, (u8)) == 44 && cast(-1, ((i64))) == -1
     && (true ? cast(1, (u8)) : cast(2, u8)) == 1) {
    i32 CASTS = 0;
} else {
    i32 CASTS = 1;
}

$if (ARR.len == 3) { i32 ARR_LEN = 3; } else { i32 ARR_LEN = 1; }
$if (ROWS.len == 2) { i32 ROWS_LEN = 2; } else { i32 ROWS_LEN = 1; }
$if (MARR.len == 3 && PTRS.len == 2 && VOIDS.len == 2 && ONE.len == 1) {
    i32 MARR_LEN = 3;
} else {
    i32 MARR_LEN = 1;
}
$if (BYTE == 7) { i32 BYTE_VALUE = 7; } else { i32 BYTE_VALUE = 1; }
$if (NAME == "x") { string NAME_VALUE = "x"; } else { string NAME_VALUE = "y"; }

fn main() i32 {
    println(CASTS, " ", ARR_LEN, " ", ROWS_LEN, " ", MARR_LEN, " ", BYTE_VALUE, " ",
            NAME_VALUE);
    return 0;
}
