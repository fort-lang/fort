//! run
//! stdout:
//| 0 1
//| 103 -1
//| one one / one other / other one / other other
//| 4031
// Every nesting of `switch` and loop: `break` inside a case exits the switch
// and `continue` targets the loop the switch stands in (D7.6), a loop inside
// a case owns both again (D7.5), and a `switch` inside a `switch` is the
// target of its own `break`.
fn classify(i32 n) i32 {
    // A `break` whose only enclosing construct is the switch (D7.6).
    switch (n) {
    case 0:
        return 0;
    default:
        break;
    }
    return 1;
}

fn sum_to(i32 limit) i32 {
    i32 mut total = 0;
    switch (limit) {
    case 0:
        return -1;
    default:
        for (i32 mut i = 0; i < limit; i++) {
            if (i == 3) {
                // The loop's own `break`, not the switch's (D7.5).
                break;
            }
            total += i;
        }
        total += 100;
    }
    return total;
}

fn grid(i32 a, i32 b) string {
    switch (a) {
    case 1:
        switch (b) {
        case 1:
            return "one one";
        default:
            break;
        }
        return "one other";
    default:
        switch (b) {
        case 1:
            break;
        default:
            return "other other";
        }
        return "other one";
    }
}

fn main() i32 {
    println(classify(0), " ", classify(7));
    println(sum_to(5), " ", sum_to(0));
    println(grid(1, 1), " / ", grid(1, 2), " / ", grid(2, 1), " / ", grid(2, 2));
    i32 mut hits = 0;
    for (i32 mut i = 0; i < 6; i++) {
        switch (i) {
        case 0, 5:
            continue;
        case 1:
            while (true) {
                switch (i) {
                case 1:
                    break;
                default:
                    hits += 100;
                }
                break;
            }
            hits += 1;
        default:
            hits += 10;
        }
        hits += 1000;
    }
    println(hits);
    return 0;
}
