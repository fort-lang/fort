//! run
//! stdout:
//| 0.1.x.3.4.
//| skip 1 skip 3
//| 2
fn main() i32 {
    for (i32 mut i = 0; i < 5; i++) {
        switch (i) {
        case 2:
            print("x");
            break;
        default:
            print(i);
        }
        print(".");
    }
    println();
    for (i32 mut i = 0; i < 4; i++) {
        switch (i) {
        case 0, 2:
            continue;
        default:
            print("skip ", i);
        }
        if (i < 3) {
            print(" ");
        }
    }
    println();
    i32 mut n = 0;
    while (true) {
        switch (n) {
        case 2:
            break;
        default:
            n++;
        }
        if (n == 2) {
            break;
        }
    }
    println(n);
    return 0;
}
