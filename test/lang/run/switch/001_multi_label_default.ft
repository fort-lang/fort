//! run
//! stdout:
//| low low low mid high other
//| none
//| big
fn bucket(i32 n) string {
    switch (n) {
    case 1, 2, 3:
        return "low";
    default:
        return "other";
    case 4, 5:
        return "mid";
    case 6:
        return "high";
    }
}

fn main() i32 {
    println(bucket(1), " ", bucket(2), " ", bucket(3), " ", bucket(4), " ", bucket(6), " ",
            bucket(9));
    u8 b = 7;
    string mut r = "none";
    switch (b) {
    case 7:
    case 8:
        r = "eight";
    }
    println(r);
    switch (200) {
    case 200:
        println("big");
    }
    return 0;
}
