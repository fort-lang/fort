//! run
//! stdout:
//| 255,0,0 0,255,0 0,0,255
//| 3
// Every switch below lists every member and has no `default` clause (D7.7), so
// each one carries the default the compiler gives it; every operand here is a
// member, so none of them takes it. run/errors/022 is the program that does.
enum color {
    red,
    green,
    blue,
}

fn i32 red(color c) {
    switch (c) {
    case color.red:
        return 255;
    case color.green, color.blue:
        return 0;
    }
}

fn void show(color c) {
    i32 mut g = 0;
    i32 mut b = 0;
    switch (c) {
    case color.green:
        g = 255;
    case color.blue:
        b = 255;
    case color.red:
    }
    print(red(c), ",", g, ",", b);
}

fn i32 main() {
    show(color.red);
    print(" ");
    show(color.green);
    print(" ");
    show(color.blue);
    println();
    i32 mut n = 0;
    color[3] all = {color.red, color.green, color.blue};
    for (color c : all) {
        switch (c) {
        case color.red, color.green, color.blue:
            n++;
        }
    }
    println(n);
    return 0;
}
