//! run
//! stdout:
//| 255,0,0 0,255,0 0,0,255
//| 3
enum Color {
    Red,
    Green,
    Blue,
}

fn i32 red(Color c) {
    switch (c) {
    case Color.Red:
        return 255;
    case Color.Green, Color.Blue:
        return 0;
    }
}

fn void show(Color c) {
    mut i32 g = 0;
    mut i32 b = 0;
    switch (c) {
    case Color.Green:
        g = 255;
    case Color.Blue:
        b = 255;
    case Color.Red:
    }
    print(red(c), ",", g, ",", b);
}

fn i32 main() {
    show(Color.Red);
    print(" ");
    show(Color.Green);
    print(" ");
    show(Color.Blue);
    println();
    mut i32 n = 0;
    Color[3] all = {Color.Red, Color.Green, Color.Blue};
    for (Color c : all) {
        switch (c) {
        case Color.Red, Color.Green, Color.Blue:
            n++;
        }
    }
    println(n);
    return 0;
}
