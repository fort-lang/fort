//! run
//! stdout:
//| 255,0,0 0,255,0 0,0,255
//| 3
enum color {
    red,
    green,
    blue,
}

fn i32 red(color c) {
    switch (c) {
    case color.red:
        return 255;
    case color.green, color.blue:
        return 0;
    }
}

fn void show(color c) {
    mut i32 g = 0;
    mut i32 b = 0;
    switch (c) {
    case color.green:
        g = 255;
    case color.blue:
        b = 255;
    case color.red:
    }
    print(red(c), ",", g, ",", b);
}

fn i32 main() {
    show(color.red);
    print(" ");
    show(color.green);
    print(" ");
    show(color.blue);
    println();
    mut i32 n = 0;
    color[3] all = {color.red, color.green, color.blue};
    for (color c : all) {
        switch (c) {
        case color.red, color.green, color.blue:
            n++;
        }
    }
    println(n);
    return 0;
}
