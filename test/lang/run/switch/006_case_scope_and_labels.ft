//! run
//! stdout:
//| 1 2 100
//| min mid max
//| max zero other
//| five eight other
//| 7 7
//| bump
//| hit
// The implicit block scope of a case body (D7.6), labels at every width and
// signedness, and a switch no label matches, which does nothing.
fn string narrow(i8 v) {
    switch (v) {
    case -128:
        return "min";
    case 127:
        return "max";
    default:
        return "mid";
    }
}

fn string wide(u64 v) {
    switch (v) {
    case 18446744073709551615:
        return "max";
    case 0:
        return "zero";
    default:
        return "other";
    }
}

fn string folded(i32 v) {
    switch (v) {
    case 2 + 3:
        return "five";
    case sizeof(i64):
        return "eight";
    default:
        return "other";
    }
}

fn i32 bump() {
    // Printed once per evaluation, so a switch that evaluated its operand per
    // label would say so (D6.3).
    println("bump");
    return 2;
}

fn i32 main() {
    i32 n = 1;
    i32 mut first = 0;
    i32 mut second = 0;
    // Sibling case bodies are sibling scopes, so both may name a local `v`
    // (D7.6, D7.9).
    switch (n) {
    case 1:
        i32 v = 1;
        first = v;
    default:
        i32 v = 9;
        first = v;
    }
    switch (n + 1) {
    case 1: {
        i32 v = 8;
        second = v;
    }
    default: {
        i32 v = 2;
        second = v;
    }
    }
    println(first, " ", second, " ", 100);
    println(narrow(-128), " ", narrow(0), " ", narrow(127));
    println(wide(18446744073709551615), " ", wide(0), " ", wide(3));
    println(folded(5), " ", folded(8), " ", folded(0));
    i32 mut untouched = 7;
    switch (untouched) {
    case 1:
        untouched = 0;
    }
    i32 mut empty = 7;
    switch (empty) {
    }
    println(untouched, " ", empty);
    switch (bump()) {
    case 1, 2, 3:
        println("hit");
    default:
        println("miss");
    }
    return 0;
}
