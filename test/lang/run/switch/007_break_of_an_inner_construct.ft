//! run
//! stdout:
//| 3 -1 7
//| 10 20 30
// A `break` inside a loop or a `switch` that stands in a clause targets
// that inner construct (D7.6). The outer switch still terminates (D8.4),
// so each function below ends in it with no `return` after it.
fn first_over(i32 k, i32 limit) i32 {
    switch (k) {
    case 0:
        i32 mut i = 0;
        while (true) {
            i++;
            if (i % 2 == 0) {
                continue;
            }
            if (i > limit) {
                break;
            }
        }
        return i;
    default:
        return -1;
    }
}

fn nested(i32 a, i32 b) i32 {
    switch (a) {
    case 1:
        i32 mut r = 0;
        switch (b) {
        case 0:
            r = 10;
            break;
        case 1:
            r = 20;
            break;
        default:
            r = 30;
        }
        return r;
    default:
        return 0;
    }
}

fn main() i32 {
    println(first_over(0, 2), " ", first_over(1, 2), " ", first_over(0, 6));
    println(nested(1, 0), " ", nested(1, 1), " ", nested(1, 2));
    return 0;
}
