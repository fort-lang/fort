//! run
//! abort
//! stderr: runtime error: span bounds 2..1 out of range for length 3
//! stdout:
//| before
// The other half of the span check: `0 <= lo <= hi <= len` fails on `lo > hi`
// even though both bounds are inside the operand (D6.9), and the message
// names them in source order (D11.4).
fn one() u64 {
    return 1;
}

fn main() i32 {
    i32 mut@ own s = new(i32, 3);
    println("before");
    i32@ t = s[2..one()];
    println(t.len);
    del(s);
    return 0;
}
