//! run
//! abort
//! stderr: runtime error: enum value 0 is not a member of level
//! stdout:
//| before
// Listing every member is not covering every value: `{}` zeroes an enum whose
// members are 1 and 2, so the switch meets a value no clause names and takes
// the `default` the compiler gave it (D3.9, D7.7).
enum level {
    low = 1,
    high = 2,
}

fn name(level l) string {
    switch (l) {
    case level.low:
        return "low";
    case level.high:
        return "high";
    }
}

fn main() i32 {
    println("before");
    level z = {};
    println(name(z));
    println("after");
    return 0;
}
