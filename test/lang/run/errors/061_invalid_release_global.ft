//! run
//! abort
//! link: ffi/oracle.c
//! stderr: ft:24:5: runtime error: invalid release
//! stdout:
//| before
// A `del` of the address of a global is the runtime error `invalid release`: the storage of a
// global is no allocation of the runtime (D10.9 rule 4). A trusted module forges the owner.
// D10.3, D10.6, D10.9
import extern;

u8 mut counter = 4;

// C: oracle_pass, test/lang/ffi/oracle.c.
// gives: p itself, which is no new allocation; this declaration says `own` to make an owner of
// the address of a global. writes: nothing. keeps: no pointer. calls: no fort function.
// frees: nothing.
extern fn oracle_pass(u8* p) u8 mut* own;

// C call oracle_pass: &counter, the address of a global, one u8 (D9.8 rule 2); C reads no byte.
fn main() i32 {
    u8 mut* own forged = oracle_pass(&counter);
    println("before");
    del(forged);
    println("after ", counter);
    return 0;
}
