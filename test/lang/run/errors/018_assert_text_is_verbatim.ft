//! run
//! abort
//! stderr: assertion failed: a + b == 3 && a != 0
//! stdout:
//| before
// The assert message is the source text of the argument, verbatim, spaces
// and all (D11.4), and the position is the builtin's name (toolchain.md 4).
fn i32 one() {
    return 1;
}

fn i32 main() {
    i32 a = one();
    i32 b = one();
    println("before");
    assert(a + b == 3 && a != 0);
    println("after");
    return 0;
}
