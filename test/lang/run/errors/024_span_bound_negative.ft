//! run
//! abort
//! stderr: runtime error: span bounds -1..2 out of range for length 3
//! stdout:
//| before
// A signed bound is sign-extended, so a negative one fails the same unsigned
// compare and is reported with its signed value (D6.9, D11.4).
fn minus_one() i32 {
    return -1;
}

fn main() i32 {
    i32[3] a = {1, 2, 3};
    i32 lo = minus_one();
    println("before");
    i32@ t = a[lo..2];
    println(t.len);
    return 0;
}
