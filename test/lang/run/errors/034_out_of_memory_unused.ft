//! run
//! abort
//! stderr: runtime error: out of memory
//! stdout:
//| before
// An allocation whose block nothing reads still fails: the C library call
// carries `nobuiltin`, so the optimizer cannot drop a `calloc` whose result
// only reaches `del` (D9.8, D10.8). The count fits u64 and asks for too much.
fn huge() i64 {
    return 9223372036854775807;
}

fn main() i32 {
    i64 n = huge();
    println("before");
    u8 mut@ own storage = new(u8, n);
    del(storage);
    return 0;
}
