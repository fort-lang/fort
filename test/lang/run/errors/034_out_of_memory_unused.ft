//! run
//! abort
//! stderr: runtime error: out of memory
//! stdout:
//| before
// An allocation whose block nothing reads still fails: `new` calls the
// allocator of the runtime, which stops the process when the size is above its
// address range (D10.2, D10.9 rule 5). The optimizer cannot drop a call that
// can stop the process. The count fits u64 and asks for too much.
fn huge() i64 {
    return 9223372036854775807;
}

fn main() i32 {
    i64 n = huge();
    println("before");
    u8 mut@ own storage = new(u8, n);
    del(storage);
    return 0;
}
