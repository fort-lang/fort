//! run
//! abort
//! stderr: runtime error: index 2 out of range for length 2
//! stdout:
//| before
fn two() i32 {
    return 2;
}

fn callback() void {
    println("callback");
}

fn main() i32 {
    (fn () void)[2] table = {callback, callback};
    i32 index = two();
    println("before");
    table[index]();
    println("after");
    return 0;
}
