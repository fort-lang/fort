//! run
//! abort
//! stderr: runtime error: integer overflow
//! stdout:
//| before
// The smallest product that does not fit an i8: the checked multiplication
// of D11.1 traps at the boundary, one step past 127.
fn sixteen() i8 {
    return 16;
}

fn main() i32 {
    i8 a = sixteen();
    i8 b = 8;
    println("before");
    println(a * b);
    return 0;
}
