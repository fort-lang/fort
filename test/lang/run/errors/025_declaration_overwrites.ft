//! run
//! abort
//! stderr: run/errors/025_declaration_overwrites.ft:20:22: runtime error: overwriting owned value
//! stdout:
//| 0
// A declaration is a store like any other and carries the overwrite check
// (D17.11): the slot of an owning local is zeroed once on entry, so the first
// execution passes and the second traps, because the body has no `del` and the
// allocation of the first iteration would leak. The same program with a `del`
// at the end of the body runs to completion, which the loop below it shows.
fn i32 main() {
    i32 mut freed = 0;
    for (i32 mut i = 0; i < 3; i++) {
        i32 mut* own kept = new(i32);
        *kept = i;
        del(kept);
        freed += 1;
    }
    for (i32 mut i = 0; i < 3; i++) {
        i32 mut* own leaked = new(i32);
        *leaked = i;
        println(*leaked);
    }
    return freed;
}
