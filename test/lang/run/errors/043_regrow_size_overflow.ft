//! run
//! abort
//! stderr: runtime error: allocation size overflow
//! stdout:
//| before
// A size that overflows is the error of `new` (D12.2, D10.2).
fn huge() i64 {
    return 9223372036854775807;
}

fn main() i32 {
    i64 mut@ own s = new(i64, 1);
    i64 n = huge();
    println("before");
    i64 mut@ own more = regrow(move(s), n);
    println(more.len);
    del(more);
    return 0;
}
