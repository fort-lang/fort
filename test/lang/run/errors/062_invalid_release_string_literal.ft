//! run
//! abort
//! link: ffi/oracle.c
//! stderr: ft:25:5: runtime error: invalid release
//! stdout:
//| before
// A `del` of the address of a string literal is the runtime error `invalid release`: the bytes
// of a literal are no allocation of the runtime (D10.9 rule 4). A trusted module forges the
// owner.
// D10.3, D10.6, D10.9
import extern;

// C: oracle_pass, test/lang/ffi/oracle.c.
// gives: p itself, which is no new allocation; this declaration says `own` to make an owner of
// the address of a literal. writes: nothing. keeps: no pointer. calls: no fort function.
// frees: nothing.
extern fn oracle_pass(u8* p) u8 mut* own;

// C call oracle_pass: &text[0], the first of the 7 bytes of a literal (D9.8 rule 4); C reads
// no byte.
fn main() i32 {
    u8@ text = cast("literal", u8@);
    u8 mut* own forged = oracle_pass(&text[0]);
    println("before");
    del(forged);
    println("after ", text.len);
    return 0;
}
