//! run
//! abort
//! link: ffi/oracle.c
//! stderr: ft:23:5: runtime error: invalid release
//! stdout:
//| before
// A `del` of the address of a local is the runtime error `invalid release`: the address is
// outside the storage of the allocator (D10.9 rule 4).
// D10.3, D10.6, D10.9
import extern;

// C: oracle_pass, test/lang/ffi/oracle.c.
// gives: p itself, which is no new allocation; this declaration says `own` to make an owner of
// an address that the allocator did not give. writes: nothing. keeps: no pointer. calls: no fort
// function. frees: nothing.
extern fn oracle_pass(u8* p) u8 mut* own;

// C call oracle_pass: &local, the address of one u8 of this frame (D9.8 rule 2); C reads no byte.
fn main() i32 {
    u8 mut local = 3;
    u8 mut* own forged = oracle_pass(&local);
    println("before");
    del(forged);
    println("after ", local);
    return 0;
}
