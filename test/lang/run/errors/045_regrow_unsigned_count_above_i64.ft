//! run
//! abort
//! stderr: runtime error: allocation size overflow
//! stdout:
//| before
// A count of an unsigned type is never negative (D12.2, D10.2). The count 9223372036854775808
// has the bits of the smallest `i64`, and it is a `u64`, so the first test passes it. The count is
// not below the length, and the size overflows.
fn huge() u64 {
    return 9223372036854775808;
}

fn main() i32 {
    i64 mut@ own s = new(i64, 1);
    u64 n = huge();
    println("before");
    i64 mut@ own more = regrow(move(s), n);
    println(more.len);
    del(more);
    return 0;
}
