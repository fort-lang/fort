//! run
//! abort
//! stderr: runtime error: span bounds 0..4 out of range for length 2
//! stdout:
//| before
// The upper bound changes s. The slice reads the new header.
string mut s = "abcd";

fn swap() i32 {
    s = "wx";
    return 4;
}

fn main() i32 {
    println("before");
    string v = s[0..swap()];
    println(v);
    return 0;
}
