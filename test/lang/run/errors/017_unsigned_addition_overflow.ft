//! run
//! abort
//! stderr: runtime error: integer overflow
//! stdout:
//| before
// Unsigned overflow traps too in the checked mode (D11.1), which is where
// the uadd intrinsic of toolchain.md 6 item 15 differs from C.
fn umax() u64 {
    return 18446744073709551615;
}

fn main() i32 {
    u64 a = umax();
    u64 b = 1;
    println("before");
    println(a + b);
    return 0;
}
