//! run
//! abort
//! link: ffi/oracle.c
//! stderr: ft:44:21: runtime error: invalid release
//! stdout:
//| before 64
// `regrow` makes the start test of a `del` on the `.ptr` of its operand, and it makes that test
// before it takes storage (D10.9 rule 4, D12.2). A trusted module forges a span owner here: the
// two words of a span header stand in a local, and a pointer from C gives them the type of a
// struct with a span owner. The `.ptr` is byte 16 of an allocation of 64 bytes, which starts no
// allocation, so the `regrow` is the runtime error `invalid release`. The count is 2^47 + 1
// elements of 1 byte: its size fits a `u64`, and no storage of the allocator holds it. A
// `regrow` that took its storage first would stop with `out of memory`, so the line shows that
// the operand test comes first and that the `regrow` takes no storage.
// D9.8, D10.6, D10.9, D12.2
import extern;
import std.heap;

struct holder {
    u8 mut@ own bytes;
}

// The two words of a span header.
struct words {
    u64 ptr;
    u64 len;
}

// C: oracle_pass, test/lang/ffi/oracle.c.
// gives: p itself, which is no new allocation; this declaration gives the storage the type of a
// struct with a span owner, to make an owner that starts no allocation. writes: nothing. keeps:
// no pointer. calls: no fort function. frees: nothing.
extern fn oracle_pass(words* p) holder mut*;

// C call oracle_pass: &raw, the address of a local, one words (D9.8 rule 2); C reads no byte.
fn main() i32 {
    u8 mut@ own block = new(u8, 64);
    block[16] = 5;
    words mut raw = {.ptr = cast(&block[16], u64), .len = 48};
    holder mut* forged = oracle_pass(&raw);
    u64 live = heap.live_bytes();
    println("before ", block.len);
    u64 count = 140737488355329;
    forged->bytes = regrow(move(forged->bytes), count);
    println("after ", heap.live_bytes() - live);
    del(block);
    return 0;
}
