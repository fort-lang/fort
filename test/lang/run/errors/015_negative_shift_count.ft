//! run
//! abort
//! stderr: runtime error: shift count -1 out of range for i32
//! stdout:
//| before
// The count is materialized at 64 bits before the check so that a negative
// one is reported with its signed value, and the type in the message is the
// shifted operand's (toolchain.md 6 item 15, D11.4).
fn minus_one() i32 {
    return -1;
}

fn main() i32 {
    i32 v = 1;
    i32 n = minus_one();
    println("before");
    i32 r = v << n;
    println(r);
    return 0;
}
