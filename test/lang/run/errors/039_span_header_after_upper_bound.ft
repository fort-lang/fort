//! run
//! abort
//! stderr: runtime error: span bounds 0..4 out of range for length 2
//! stdout:
//| before
// The upper bound changes s. The slice reads the new header.
i32[4] D1 = {0, 11, 22, 33};
i32[2] D2 = {0, 1};
i32@ mut s = {};

fn swap() i32 {
    s = D2[0..2];
    return 4;
}

fn main() i32 {
    s = D1[0..4];
    println("before");
    i32@ v = s[0..swap()];
    println(v.len);
    return 0;
}
