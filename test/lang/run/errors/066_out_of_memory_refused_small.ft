//! run
//! abort
//! link: ffi/heap_calls.c
//! stderr: ft:28:25: runtime error: out of memory
//! stdout:
//| before
// A small block of 2,048,000 bytes takes the whole storage of one small chunk, so its `new`
// opens a new chunk: the allocator asks for the access to the state of the chunk and to the
// units of the block. The C file refuses the first of those calls of `mprotect`, as the system
// does at the limit of the map entries. The `new` is then the runtime error `out of memory` at
// its position (D10.9 rule 5), and the program gets no storage that it cannot access.
// D10.2, D10.6, D10.9
import extern;

// The kind of a call in test/lang/ffi/heap_calls.c: an mprotect that gives access.
i32 ACCESS = 3;

// C: heap_calls_refuse, test/lang/ffi/heap_calls.c, which makes one later call of one kind fail.
// gives: nothing. writes: no fort storage. keeps: no pointer. calls: no fort function.
// frees: nothing.
extern fn heap_calls_refuse(i32 kind, u64 nth, u64 part) void;

// C call heap_calls_refuse: no pointer argument.
fn main() i32 {
    println("before");
    heap_calls_refuse(ACCESS, 1, 0);
    // the bytes of one small chunk without the 3 units of its state
    u8 mut@ own block = new(u8, 2048000);
    println("after ", block.len);
    del(block);
    return 0;
}
