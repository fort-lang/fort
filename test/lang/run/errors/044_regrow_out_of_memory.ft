//! run
//! abort
//! stderr: runtime error: out of memory
//! stdout:
//| before
// A request that the allocator refuses is the error of `new` (D12.2, D10.2).
fn huge() i64 {
    return 9223372036854775807;
}

fn main() i32 {
    u8 mut@ own s = new(u8, 1);
    i64 n = huge();
    println("before");
    u8 mut@ own more = regrow(move(s), n);
    println(more.len);
    del(more);
    return 0;
}
