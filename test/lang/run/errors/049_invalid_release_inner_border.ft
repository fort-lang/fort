//! run
//! abort
//! link: ffi/oracle.c
//! stderr: ft:25:5: runtime error: invalid release
//! stdout:
//| before
// A `del` of a pointer into an allocation is the runtime error `invalid release` for each inner
// address. Byte 16 has the alignment of a start, and no allocation starts there (D10.9 rule 4).
// D10.3, D10.6, D10.9
import extern;

// C: oracle_pass, test/lang/ffi/oracle.c.
// gives: p itself, which is no new allocation; this declaration says `own` to make an owner that
// starts no allocation. writes: nothing. keeps: no pointer. calls: no fort function.
// frees: nothing.
extern fn oracle_pass(u8* p) u8 mut* own;

// C call oracle_pass: &block[16] keeps the bound of block from element 16, 48 bytes (D9.8 rule
// 2); C reads no byte.
fn main() i32 {
    u8 mut@ own block = new(u8, 64);
    block[16] = 5;
    u8 mut* own inner = oracle_pass(&block[16]);
    println("before");
    del(inner);
    println("after ", block[16]);
    del(block);
    return 0;
}
