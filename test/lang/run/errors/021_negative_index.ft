//! run
//! abort
//! stderr: runtime error: index -1 out of range for length 3
//! stdout:
//| before
// A signed index is sign-extended and the one unsigned compare against the
// length catches it (D6.8).
fn i32 minus_one() {
    return -1;
}

fn i32 main() {
    i32[3] a = {1, 2, 3};
    i32 i = minus_one();
    println("before");
    println(a[i]);
    println("after");
    return 0;
}
