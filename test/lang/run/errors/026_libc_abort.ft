//! run
//! abort
//! stdout:
//| flushed
import std.libc;
import std.rt;

// libc.abort is what the runtime calls after a runtime error (D11.4,
// stdlib.md 2.2). It is declared noreturn and takes no argument, so the call
// ends the function without a return and the deferred statement never runs
// (D7.8, D11.4). It does not flush the runtime's buffers either, so the
// program flushes what it wants seen first.
fn main() i32 {
    defer println("deferred, must not run");
    println("flushed");
    rt.flush_all();
    libc.abort();
}
