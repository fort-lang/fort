//! run
//! abort
//! stderr: runtime error: regrow count 0 below length 3
//! stdout:
//| before
// The operands of `regrow` are evaluated left to right (D12.2, D6.3). The count reads the span
// after the `move` emptied it, so the count is 0, which is below the length that the `move` took.
// The form of doubling computes the count in a local before the call.
fn main() i32 {
    i32 mut@ own mut v = new(i32, 3);
    println("before");
    v = regrow(move(v), v.len * 2);
    println(v.len);
    del(v);
    return 0;
}
