//! run
//! abort
//! stderr: 041_regrow_negative_count.ft:17:25: runtime error: negative allocation count -1
//! stdout:
//| before
// A negative count is the error of `new` (D12.2, D10.2). The runtime tests the sign before it
// tests the count against the length, so a count of -1 for a span of 3 elements gives this text
// and not the text of a count below the length.
fn neg_one() i32 {
    return -1;
}

fn main() i32 {
    i32 mut@ own s = new(i32, 3);
    i32 n = neg_one();
    println("before");
    i32 mut@ own less = regrow(move(s), n);
    println(less.len);
    del(less);
    return 0;
}
