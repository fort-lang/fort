//! run
//! abort
//! stderr: runtime error: index 3 out of range for length 2
//! stdout:
//| before
// The index changes s. The bounds check reads the new header.
i32[4] D1 = {0, 11, 22, 33};
i32[2] D2 = {0, 1};
i32@ mut s = {};

fn swap() i32 {
    s = D2[0..2];
    return 1;
}

fn main() i32 {
    s = D1[0..4];
    println("before");
    println(s[swap() + 2]);
    return 0;
}
