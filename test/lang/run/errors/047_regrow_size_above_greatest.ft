//! run
//! abort
//! stderr: runtime error: allocation size overflow
//! stdout:
//| before
// The count 2305843009213693952 is 1 above the greatest count of elements of 8 bytes whose size
// fits a `u64`. It fails the test of the size (D12.2, D10.2).
fn count() u64 {
    return 2305843009213693952;
}

fn main() i32 {
    u64 mut@ own s = new(u64, 1);
    u64 n = count();
    println("before");
    u64 mut@ own more = regrow(move(s), n);
    println(more.len);
    del(more);
    return 0;
}
