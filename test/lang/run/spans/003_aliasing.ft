//! run
//! stdout:
//| 42 42
//| 7 7
//| 1 1 1
fn fill(i32 mut@ s, i32 v) void {
    for (u64 mut i = 0; i < s.len; i++) {
        s[i] = v;
    }
}

fn main() i32 {
    i32 mut@ own s = new(i32, 4);
    i32 mut@ sub = s[1..3];
    sub[0] = 42;
    println(s[1], " ", sub[0]);
    i32 mut@ alias = s;
    alias[3] = 7;
    println(s[3], " ", alias[3]);
    fill(s[..3], 1);
    println(s[0], " ", s[2], " ", sub[1]);
    del(s);
    return 0;
}
