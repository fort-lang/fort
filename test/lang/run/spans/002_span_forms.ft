//! run
//! stdout:
//| 2 20 30
//| 2 10 20
//| 2 40 50
//| 5 10 50
//| 0 0 1
//| 3 2 4 4
fn i32 main() {
    i32 mut@ own s = new(i32, 5);
    for (u64 mut i = 0; i < s.len; i++) {
        s[i] = cast(i + 1, i32) * 10;
    }
    i32@ a = s[1..3];
    println(a.len, " ", a[0], " ", a[1]);
    i32@ b = s[..2];
    println(b.len, " ", b[0], " ", b[1]);
    i32@ c = s[3..];
    println(c.len, " ", c[0], " ", c[1]);
    i32@ d = s[..];
    println(d.len, " ", d[0], " ", d[4]);
    i32@ e = s[2..2];
    i32@ f = s[5..];
    i32@ g = c[1..];
    println(e.len, " ", f.len, " ", g.len);
    i32[5] fixed = {1, 2, 3, 4, 5};
    i32@ h = fixed[1..4];
    i8 lo = 0;
    u64 hi = 2;
    println(h.len, " ", h[lo], " ", h[hi], " ", h[1..][0] + 1);
    del(s);
    return 0;
}
