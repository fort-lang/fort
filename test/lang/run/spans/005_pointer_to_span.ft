//! run
//! stdout:
//| 3 7 7 7
//| 2 30
fn alloc_fill(i32 mut@ own mut* out, u64 n, i32 v) void {
    *out = new(i32, n);
    for (u64 mut i = 0; i < n; i++) {
        (*out)[i] = v;
    }
}

fn pick(i32[4]* arr, i32 i) i32 {
    return (*arr)[i];
}

fn main() i32 {
    i32 mut@ own mut s = {};
    alloc_fill(&s, 3, 7);
    println(s.len, " ", s[0], " ", s[1], " ", s[2]);
    i32[4] fixed = {10, 20, 30, 40};
    i32[4]* p = &fixed;
    println(pick(p, 2) / 15, " ", (*p)[2]);
    del(s);
    return 0;
}
