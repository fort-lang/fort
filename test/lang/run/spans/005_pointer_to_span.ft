//! run
//! stdout:
//| 3 7 7 7
//| 2 30
fn alloc_fill(i32 mut@ own mut* out, u64 n, i32 v) void {
    del(*out);
    *out = new(i32, n);
    for (u64 mut i = 0; i < n; i++) {
        (*out)[i] = v;
    }
}

fn pick(i32[4]* arr, i32 i) i32 {
    return (*arr)[i];
}

// A read through a pointer: the owner is no local owner here (D17.21).
fn at(i32 mut@ own* s, u64 i) i32 {
    return (*s)[i];
}

fn main() i32 {
    i32 mut@ own mut s = {};
    alloc_fill(&s, 3, 7);
    println(s.len, " ", at(&s, 0), " ", at(&s, 1), " ", at(&s, 2));
    i32[4] fixed = {10, 20, 30, 40};
    i32[4]* p = &fixed;
    println(pick(p, 2) / 15, " ", (*p)[2]);
    del(s);
    return 0;
}
