//! run
//! stdout:
//| 4 0.0 0.0
//| 0.5 1.5 2.5 3.5
//| 8.0
// A span of floats is allocated zeroed, written through and read back, and
// `del` releases it (D10.2, D6.9).
fn main() i32 {
    i64 count = 4;
    f64 mut@ own values = new(f64, count);
    println(values.len, " ", values[0], " ", values[3]);
    u64 mut i = 0;
    while (i < values.len) {
        values[i] = cast(i, f64) + 0.5;
        i += 1;
    }
    println(values[0], " ", values[1], " ", values[2], " ", values[3]);
    f64 mut total = 0.0;
    for (f64 v : values) {
        total = total + v;
    }
    println(total);
    del(values);
    return 0;
}
