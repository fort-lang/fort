//! run
//! stdout:
//| 30
//| 2 4 6
fn i32 main() {
    i32 mut@ own s = new(i32, 3);
    s[0] = 10;
    s[1] = 10;
    s[2] = 10;
    i32 mut total = 0;
    for (i32 v : s) {
        total += v;
    }
    println(total);
    for (u64 mut i = 0; i < s.len; i++) {
        s[i] = cast(i + 1, i32) * 2;
    }
    println(s[0], " ", s[1], " ", s[2]);
    del(s);
    return 0;
}
