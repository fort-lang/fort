//! run
//! stdout:
//| 2 3 2 16
//| 1 2 3 40 50
//| 2 2 3
//| 99 99 2
//| 5 32
// An array of spans and a span of spans (D3.6): `i32 mut@[2]` is two fat
// pointers side by side, each with its own length, and a range over that
// array is an `i32 mut@ mut@`.
fn u64 total_len(i32@@ rows) {
    u64 mut n = 0;
    u64 mut i = 0;
    while (i < rows.len) {
        n += rows[i].len;
        i++;
    }
    return n;
}

fn i32 main() {
    i32[3] mut a = {1, 2, 3};
    i32[2] mut b = {40, 50};
    // Each element carries its own length, and the array strides by the size
    // of the header (D19.2).
    i32 mut@[2] mut rows = {a[0..3], b[0..2]};
    println(rows.len, " ", rows[0].len, " ", rows[1].len, " ", sizeof(i32 mut@));
    println(rows[0][0], " ", rows[0][1], " ", rows[0][2], " ", rows[1][0], " ", rows[1][1]);
    // The elements are views, so a write through the array reaches the arrays
    // the spans were taken from (D6.9).
    i32 mut@ mut@ view = rows[0..2];
    println(view.len, " ", view[1].len, " ", view[0].len);
    view[0][0] = 99;
    println(a[0], " ", rows[0][0], " ", view[1].len);
    println(total_len(rows[0..2]), " ", sizeof(i32 mut@[2]));
    return 0;
}
