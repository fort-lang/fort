//! run
//! stdout:
//| 0 true 4 104 107
//| true 8 false
//| 12 1
fn fill_bytes(u8 mut@ own mut* out, u64 n) bool {
    if (n == 0) {
        return false;
    }
    del(*out);
    *out = new(u8, n);
    for (u64 mut i = 0; i < out->len; i++) {
        (*out)[i] = cast(104 + i, u8);
    }
    return true;
}

fn total_len(u8@* a, u8@* b) u64 {
    return a->len + b->len;
}

// Reads through a pointer: the owner is no local owner here, so a read after a call is no use
// (D17.21).
fn len_of(u8 mut@ own* p) u64 {
    return p->len;
}

fn byte_at(u8 mut@ own* p, u64 i) u8 {
    return (*p)[i];
}

// A view of bytes, held against p, which points to bytes.
fn check_view(u8 mut@ own* bytes, u8 mut@ own mut* p) void {
    u8@ view = *bytes;
    println(bytes->ptr == p->ptr, " ", total_len(bytes, &view), " ", fill_bytes(p, 0));
}

fn main() i32 {
    u8 mut@ own mut bytes = {};
    u8 mut@ own mut* p = &bytes;
    println(p->len, " ", fill_bytes(p, 4), " ", len_of(p), " ", byte_at(p, 0), " ", byte_at(p, 3));
    check_view(&bytes, p);
    i32[3] fixed = {1, 2, 3};
    i32[3] mut copy = fixed;
    i32[3] mut* fp = &copy;
    (*fp)[0] = 9;
    println((*fp)[0] + (*fp)[2], " ", fixed[0]);
    del(bytes);
    return 0;
}
