//! run
//! stdout:
//| 103
//| 1 1
// The index reads the new pointer when both headers have length 4.
// The absent upper bound reads the new length after the lower bound.
i32[4] D1 = {0, 11, 22, 33};
i32[4] D2 = {100, 101, 102, 103};
i32[2] D3 = {0, 1};
i32@ mut s = {};

fn swap_same() i32 {
    s = D2[0..4];
    return 3;
}

fn swap_short() i32 {
    s = D3[0..2];
    return 1;
}

fn main() i32 {
    s = D1[0..4];
    println(s[swap_same()]);
    s = D1[0..4];
    i32@ tail = s[swap_short()..];
    println(tail.len, " ", tail[0]);
    return 0;
}
