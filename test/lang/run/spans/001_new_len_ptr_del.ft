//! run
//! stdout:
//| 5 0 true
//| 0 1 2 3 4
//| 0 true
//| 3 0 true
fn i32 main() {
    i32 mut@ own s = new(i32, 5);
    u64 n = s.len;
    println(n, " ", s[0], " ", s.ptr != null);
    for (u64 mut i = 0; i < s.len; i++) {
        s[i] = cast(i, i32);
    }
    for (u64 mut i = 0; i < s.len; i++) {
        print(s[i]);
        if (i + 1 < s.len) {
            print(" ");
        }
    }
    println();
    del(s);
    i32@ z = {};
    println(z.len, " ", z.ptr == null);
    u8 small = 3;
    u8 mut@ own a = new(u8, small);
    i32@ own e = new(i32, 0);
    println(a.len, " ", e.len, " ", e.ptr != null);
    del(a);
    del(e);
    return 0;
}
