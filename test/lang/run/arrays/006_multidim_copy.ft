//! run
//! stdout:
//| 24 12 4
//| 1 9
//| 1 100
//| 1 7
//| 4 5 6
//| 1 2 3 4 5 6
//| 1 2 3 8 5 6
//| 0 0 0 8 5 6
//| true
// A fixed array is a value, and that holds at every rank (D3.4): assignment,
// argument passing and return copy all elements. The copy here is
// sizeof(i32[2][3]) = 24 bytes, six elements of four, and each assertion
// below writes through one name and reads the other.
struct grid {
    i32[2][3] cells;
}

fn i32[2][3] bump(i32[2][3] mut m) {
    m[0][0] = 100;
    return m;
}

fn i32 first(i32[3] row) {
    return row[0];
}

fn void print_all(i32[2][3] m) {
    i32 mut i = 0;
    while (i < 2) {
        i32 mut j = 0;
        while (j < 3) {
            print(m[i][j]);
            if (i * 3 + j < 5) {
                print(" ");
            }
            j++;
        }
        i++;
    }
    println();
}

fn i32 main() {
    println(sizeof(i32[2][3]), " ", sizeof(i32[3]), " ", sizeof(i32));
    i32[2][3] mut a = {{1, 2, 3}, {4, 5, 6}};
    // Assignment copies the whole array, so the write to `b` leaves `a` alone.
    i32[2][3] mut b = a;
    b[0][0] = 9;
    println(a[0][0], " ", b[0][0]);
    // Argument passing copies, so the callee's write is its own; the return
    // copies again.
    i32[2][3] c = bump(a);
    println(a[0][0], " ", c[0][0]);
    // A struct field of array type copies with the struct.
    grid mut g = grid{a};
    g.cells[0][0] = 7;
    println(a[0][0], " ", g.cells[0][0]);
    // One row is a value of its own: it copies out, and it copies in.
    i32[3] mut row = a[1];
    row[0] = 40;
    println(a[1][0], " ", a[1][1], " ", a[1][2]);
    print_all(a);
    i32[2][3] mut d = a;
    d[1][0] = 8;
    print_all(d);
    // A whole row is assignable, and it copies three elements. A typed array
    // literal is the form an assignment takes (D6.5).
    d[0] = i32[3]{};
    print_all(d);
    println(first(a[1]) == 4);
    return 0;
}
