//! run
//! stdout:
//| 8 24 3 a
//| 1 7 4
//| 10 -5 2
//| 3
//| 2 1 8 abc
// The element classes a `[N x T]` stride must get right: an element type
// whose size is padded, a single-element array, and an array of function
// pointers, which is an array of `ptr` (D3.4, D3.6, D3.10).
struct pixel {
    i32 code;
    char tag;
}

fn i32 twice(i32 n) {
    return n * 2;
}

fn i32 negate(i32 n) {
    return -n;
}

fn i32 main() {
    // sizeof(pixel) is 8 with its three bytes of padding, so the stride of a
    // pixel[3] is 8 and the whole array 24 bytes (D3.4, D3.8).
    pixel[3] mut ps = {};
    ps[0] = pixel{1, 'a'};
    ps[2] = pixel{3, 'c'};
    println(sizeof(pixel), " ", sizeof(pixel[3]), " ", ps[2].code, " ", ps[0].tag);
    i32[1] one = {7};
    println(one.len, " ", one[0], " ", sizeof(i32[1]));
    fn i32(i32)[2] table = {twice, negate};
    println(table[0](5), " ", table[1](5), " ", table.len);
    i32 mut total = 0;
    for (fn i32(i32) f : table) {
        total += f(3);
    }
    println(total);
    // A one-byte element and an eight-byte one, so the stride is the element
    // type's size and not a fixed word (D3.4).
    char[4] mut cs = {};
    cs[0] = 'a';
    cs[1] = 'b';
    cs[2] = 'c';
    i64[2] longs = {2, 1};
    println(longs[0], " ", longs[1], " ", sizeof(i64), " ", cs[0], cs[1], cs[2]);
    return 0;
}
