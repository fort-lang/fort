//! run
//! stdout:
//| 1 2 3 3
//| 9 2 3 1
//| 0 0 0 0
//| 30 40
//| 6 1
fn sum3(i32[3] a) i32 {
    return a[0] + a[1] + a[2];
}

fn doubled(i32[3] a) i32[3] {
    i32[3] mut r = a;
    for (i32 mut i = 0; i < 3; i++) {
        r[i] *= 2;
    }
    return r;
}

fn clobber(i32[3] mut a) void {
    a[0] = 999;
}

fn main() i32 {
    i32[3] a = {1, 2, 3};
    println(a[0], " ", a[1], " ", a[2], " ", a.len);
    i32[3] mut b = a;
    b[0] = 9;
    println(b[0], " ", b[1], " ", b[2], " ", a[0]);
    i32[4] z = {};
    println(z[0], " ", z[1], " ", z[2], " ", z[3]);
    u8 i = 1;
    i64 j = 2;
    i32[3] d = doubled(i32[3]{10, 15, 20});
    println(d[i], " ", d[j]);
    clobber(a);
    println(sum3(a), " ", a[0]);
    return 0;
}
