//! run
//! stdout:
//| 1 2 3 4 5 6
//| 1 0 0 0 0 6
//| 0 0 0 0 0 0
//| 7 8 0 0
//| 5 6 7 8
//| 2 2
// Nested brace initializers at rank two and three (D6.5): a bare `{...}` is
// the initializer of a declaration and nests inside another literal, `{}`
// zeroes an aggregate of any rank, and a list that is not empty holds exactly
// one element per dimension. A typed array literal names its type first and
// is an expression anywhere.
i32[2][3] TABLE = {{1, 2, 3}, {4, 5, 6}};

fn row6(i32[2][3] m) void {
    println(m[0][0], " ", m[0][1], " ", m[0][2], " ", m[1][0], " ", m[1][1], " ", m[1][2]);
}

fn main() i32 {
    row6(TABLE);
    // An inner `{}` zeroes that row alone.
    i32[2][3] mut part = {{1, 0, 0}, {}};
    part[1][2] = 6;
    row6(part);
    i32[2][3] zero = {};
    row6(zero);
    // Rank three: the rows the list writes and the ones it zeroes.
    i32[2][2][2] cube = {{{7, 8}, {}}, {}};
    println(cube[0][0][0], " ", cube[0][0][1], " ", cube[0][1][0], " ", cube[1][1][1]);
    // A typed array literal of a nested type is an expression, so it stands on
    // the right of an assignment and as an argument.
    i32[2][3] mut m = {};
    m = i32[2][3]{{5, 6, 7}, {8, 0, 0}};
    println(m[0][0], " ", m[0][1], " ", m[0][2], " ", m[1][0]);
    println(i32[2][3]{{2, 3, 4}, {5, 6, 7}}[0][0], " ", TABLE[0][2] - 1);
    return 0;
}
