//! run
//! stdout:
//| 3 1.5 0.0
//| 0.5 2.5 6.0
//| 1.0 2.0
// A fixed array of floats: a literal initializer, an element assignment, a
// copy on assignment and a range `for` over the elements (D3.4, D7.5).
fn main() i32 {
    f64[3] mut values = {1.5, 0.5, 2.5};
    f32[2] mut small = {};
    println(values.len, " ", values[0], " ", small[0]);
    values[0] = 0.5;
    f64 mut total = 0.0;
    for (f64 v : values) {
        total = total + v;
    }
    println(values[0], " ", values[2], " ", total + 2.5);
    small[0] = 1.0;
    small[1] = 2.0;
    println(small[0], " ", small[1]);
    return 0;
}
