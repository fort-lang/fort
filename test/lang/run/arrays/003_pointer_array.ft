//! run
//! stdout:
//| true 16
//| 2 8 15
struct Node {
    i32 value;
}

fn i32 main() {
    Node*[16] empty = {};
    println(empty[3] == null, " ", empty.len);
    mut Node a = {8};
    mut Node b = {15};
    mut Node*[16] table = {};
    table[2] = &a;
    table[9] = &b;
    mut i32 count = 0;
    mut i32 total = 0;
    for (mut i32 i = 0; i < 16; i++) {
        if (table[i] != null) {
            count++;
            total += table[i]->value;
        }
    }
    table[9]->value = total - a.value;
    println(count, " ", table[2]->value, " ", table[9]->value);
    return 0;
}
