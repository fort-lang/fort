//! run
//! stdout:
//| true 16
//| 2 8 15
struct node {
    i32 value;
}

fn main() i32 {
    node*[16] empty = {};
    println(empty[3] == null, " ", empty.len);
    node mut a = {8};
    node mut b = {15};
    node mut*[16] mut table = {};
    table[2] = &a;
    table[9] = &b;
    i32 mut count = 0;
    i32 mut total = 0;
    for (i32 mut i = 0; i < 16; i++) {
        if (table[i] != null) {
            count++;
            total += table[i]->value;
        }
    }
    table[9]->value = total - a.value;
    println(count, " ", table[2]->value, " ", table[9]->value);
    return 0;
}
