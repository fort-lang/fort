//! run
//! stdout:
//| 3 3 15
//| 1 2 3 4
//| a bc 1 2
//| blue red green
//| 0 0 0 0 true
//| 7 8 9 1 2 3
//| 10 20 30 40 4
//| true
// A fixed array holds any element type -- structs, strings, enums, pointers --
// and `a.len` is an untyped integer constant, so it can stand where a constant
// expression is required, an array length included (D3.4).
struct point {
    i32 x;
    i32 y;
}

enum color {
    red,
    green,
    blue,
}

i32[3] BASE = {1, 2, 3};

fn sum(i32[3] a) i32 {
    return a[0] + a[1] + a[2];
}

fn bumped(i32[3] a) i32[3] {
    i32[3] mut out = a;
    for (i64 mut i = 0; i < 3; i++) {
        out[i] += 6;
    }
    return out;
}

fn main() i32 {
    // `BASE.len` is a constant expression, so it is a legal array length.
    i32[BASE.len] copy = {4, 5, 6};
    println(copy.len, " ", BASE.len, " ", copy[0] + copy[1] + copy[2]);

    point[2] pts = {point{1, 2}, point{3, 4}};
    println(pts[0].x, " ", pts[0].y, " ", pts[1].x, " ", pts[1].y);

    string[2] names = {"a", "bc"};
    println(names[0], " ", names[1], " ", names[0].len, " ", names[1].len);

    color[3] cs = {color.blue, color.red, color.green};
    println(cs[0], " ", cs[1], " ", cs[2]);

    // `{}` zeroes every element, whatever the element type is.
    i32[4] zeroed = {};
    point[1] zero_point = {};
    println(zeroed[0], " ", zeroed[3], " ", zero_point[0].x, " ", zero_point[0].y, " ",
            zeroed.len == 4);

    // Passing and returning copy every element, so the caller's array is
    // untouched by a callee that writes to its parameter.
    i32[3] before = BASE;
    i32[3] after = bumped(before);
    println(after[0], " ", after[1], " ", after[2], " ", before[0], " ", before[1], " ",
            before[2]);

    // An array of pointers indexes through the slot and then the pointee.
    i32 mut a = 10;
    i32 mut b = 20;
    i32 mut c = 30;
    i32 mut d = 40;
    i32*[4] table = {&a, &b, &c, &d};
    println(*table[0], " ", *table[1], " ", *table[2], " ", *table[3], " ", table.len);
    println(sum(BASE) == 6);
    return 0;
}
