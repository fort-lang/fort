//! run
//! abort
//! stderr: panic: stopped
//! stdout:
//| before
// A `noreturn` call never exits the block, so nothing deferred runs (D7.8, D8.5): the call is
// a terminating statement and the deferred statements below it are never reached.
fn stop(string msg) noreturn {
    defer println("never from stop");
    panic(msg);
}

fn work() void {
    defer println("never from work");
    println("before");
    stop("stopped");
}

fn main() i32 {
    defer println("never from main");
    work();
    return 0;
}
