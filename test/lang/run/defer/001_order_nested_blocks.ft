//! run
//! stdout:
//| start
//| inner
//| B2
//| B1
//| end
//| C
//| A2
//| A1
//| early
//| g-exit
//| 1
//| late
//| late-defer
//| g-exit
//| 2
fn void f() {
    defer println("A1");
    defer println("A2");
    println("start");
    {
        defer println("B1");
        defer {
            println("B2");
        }
        println("inner");
    }
    defer println("C");
    println("end");
}

fn i32 g(bool early) {
    defer println("g-exit");
    if (early) {
        println("early");
        return 1;
    }
    defer println("late-defer");
    println("late");
    return 2;
}

fn i32 main() {
    f();
    println(g(true));
    println(g(false));
    return 0;
}
