//! run
//! stdout:
//| 1 2
//| at exit p holds 2
//| done
fn void f() {
    own mut i32* p = new(i32);
    own mut i32* q = new(i32);
    *p = 1;
    *q = 2;
    defer del(p);
    defer println("at exit p holds ", *p);
    own i32* first = move(p);
    defer del(first);
    p = move(q);
    println(*first, " ", *p);
}

fn i32 main() {
    f();
    println("done");
    return 0;
}
