//! run
//! stdout:
//| false 2 true
//| at exit p holds 2
//| done
// defer captures nothing (D7.8): after defer del(p), a later del(p) followed by p = move(q)
// makes the deferred statement free q. The del empties p, so the store passes the overwrite
// check (D17.11), and q is empty after the move (D17.6).
fn f() void {
    i32 mut* own mut p = new(i32);
    i32 mut* own q = new(i32);
    *p = 1;
    *q = 2;
    defer del(p);
    defer println("at exit p holds ", *p);
    del(p);
    p = move(q);
    println(p == null, " ", *p, " ", q == null);
}

fn main() i32 {
    f();
    println("done");
    return 0;
}
