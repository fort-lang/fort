//! run
//! stdout:
//| 1 10
//| 5
//| 2 99
mut i32 g = 1;

fn i32 h() {
    defer g = 10;
    return g;
}

fn i32 k() {
    mut i32 x = 5;
    defer x++;
    return x;
}

fn i32 m(mut i32* p) {
    defer *p = 99;
    return *p + 1;
}

fn i32 main() {
    i32 r = h();
    println(r, " ", g);
    println(k());
    mut i32 v = 1;
    i32 r2 = m(&v);
    println(r2, " ", v);
    return 0;
}
