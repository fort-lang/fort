//! run
//! stdout:
//| 1 10
//| 5
//| 2 99
i32 mut g = 1;

fn h() i32 {
    defer g = 10;
    return g;
}

fn k() i32 {
    i32 mut x = 5;
    defer x++;
    return x;
}

fn m(i32 mut* p) i32 {
    defer *p = 99;
    return *p + 1;
}

fn main() i32 {
    i32 r = h();
    println(r, " ", g);
    println(k());
    i32 mut v = 1;
    i32 r2 = m(&v);
    println(r2, " ", v);
    return 0;
}
