//! run
//! stdout:
//| 0 d d 2 d d
//| wdwd
fn i32 main() {
    for (mut i32 i = 0; i < 4; i++) {
        defer print(" d");
        if (i == 1) {
            continue;
        }
        if (i == 3) {
            break;
        }
        if (i > 0) {
            print(" ");
        }
        print(i);
    }
    println();
    mut i32 n = 0;
    while (n < 2) {
        defer print("d");
        n++;
        print("w");
        if (n == 2) {
            break;
        }
    }
    println();
    return 0;
}
