//! run
//! abort
//! stderr: runtime error: index 5 out of range for length 3
//! stdout:
//| before
// A runtime error aborts without running deferred code (D7.8, D11.4): neither the deferred
// statement of the block the check is in nor that of the block around it runs.
fn element(i32[3] a, i32 i) i32 {
    defer println("never from element");
    {
        defer println("never from the inner block");
        println("before");
        return a[i];
    }
}

fn main() i32 {
    defer println("never from main");
    i32[3] a = {1, 2, 3};
    i32 mut i = 5;
    return element(a, i);
}
