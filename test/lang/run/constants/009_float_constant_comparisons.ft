//! run
//! stdout:
//| true false true false
//| true true true
//| 1 2
// Comparisons among constants fold too, with the float rules: the two zeros
// are equal and 0.1 + 0.2 is not 0.3 (D4.6, D6.12).
bool LESS = 1.0 < 2.0;
bool EQUAL_TENTHS = 0.1 + 0.2 == 0.3;
bool ZEROS = -0.0 == 0.0;
bool MIXED = 3 > 3.5;
bool INTEGRAL = 2.0 == 2;
bool CLOSE = 1.0 / 3.0 < 0.34;
bool EXACT = 0.1 == 0.1000000000000000055511151231257827;

fn main() i32 {
    println(LESS, " ", EQUAL_TENTHS, " ", ZEROS, " ", MIXED);
    println(INTEGRAL, " ", CLOSE, " ", EXACT);
    i32[2] sizes = {1, 2};
    println(sizes[0], " ", sizes[1]);
    return 0;
}
