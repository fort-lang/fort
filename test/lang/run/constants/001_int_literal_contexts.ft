//! run
//! stdout:
//| 18446744073709551615 -9223372036854775808 255 -32768 65535
//| 4 2147483647 2147483648 6 200
fn i64 twice(i64 v) {
    return v * 2;
}

fn u8 limit() {
    return 200;
}

fn i32 main() {
    u64 big = 18446744073709551615;
    i64 low = -9223372036854775808;
    u8 top = 255;
    i16 bottom = -32768;
    u16 wide = 65535;
    println(big, " ", low, " ", top, " ", bottom, " ", wide);
    println(sizeof(i32), " ", 2147483647, " ", 2147483648, " ", twice(3), " ", limit());
    return 0;
}
