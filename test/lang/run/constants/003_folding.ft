//! run
//! stdout:
//| 6 1023 2 -6 1
//| 4294967295 -2147483648 4294967295 44
//| true 15
fn main() i32 {
    i32 x = 7 / 2 * 2;
    i32 y = (1 << 10) - 1;
    i32 z = -(3 - 5);
    i32 k = ~5;
    i32 r = 10 % 3;
    println(x, " ", y, " ", z, " ", k, " ", r);
    u32 m = 0xFFFFFFFF;
    println(m, " ", cast(0x80000000, i32), " ", cast(-1, u32), " ", cast(300, u8));
    bool b = 3 > 2 && 1 != 2;
    i32 mask = 0xF0 >> 4 | 0x0F & 0x05 ^ 0x0A;
    println(b, " ", mask);
    return 0;
}
