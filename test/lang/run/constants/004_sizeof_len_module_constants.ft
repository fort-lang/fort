//! run
//! stdout:
//| 8 16 12
//| 4 8
//| n m other
i32 N = 4;
i32 M = N * 2;

fn classify(i32 x) string {
    switch (x) {
    case N:
        return "n";
    case M:
        return "m";
    default:
        return "other";
    }
}

fn main() i32 {
    i32[sizeof(i64)] a = {};
    i32[a.len * 2] b = {};
    u8[sizeof(i32[3])] c = {};
    println(a.len, " ", b.len, " ", c.len);
    i32[N] arr = {1, 2, 3, 4};
    i32[M] arr2 = {};
    println(arr.len, " ", arr2.len);
    println(classify(4), " ", classify(8), " ", classify(5));
    return 0;
}
