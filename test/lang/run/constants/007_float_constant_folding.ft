//! run
//! stdout:
//| 3.0 -1.0 2.0 0.5
//| 0.30000000000000004 2.5 -2.5
//| 7.0 3.5 0.5
//| true false true
// Arithmetic among untyped constants folds exactly at compile time, an
// integer with a float folding as a float, and every value below is computed
// by the compiler and not by the program (D4.4, D4.6).
f64 SUM = 1.0 + 2.0;
f64 DIFF = 1.0 - 2.0;
f64 PRODUCT = 4.0 * 0.5;
f64 QUOTIENT = 1.0 / 2.0;
f64 TENTHS = 0.1 + 0.2;
f64 MIXED = 5 / 2.0;
f64 NEGATIVE = -5 / 2.0;
f64 FROM_INT = 7;
f32 HALVED = 7.0 / 2.0;
f32 SMALL = 1 / 2.0;

fn main() i32 {
    println(SUM, " ", DIFF, " ", PRODUCT, " ", QUOTIENT);
    println(TENTHS, " ", MIXED, " ", NEGATIVE);
    println(FROM_INT, " ", HALVED, " ", SMALL);
    println(SUM > DIFF, " ", QUOTIENT == 0.4, " ", 1.0 / 3.0 > 0.333);
    return 0;
}
