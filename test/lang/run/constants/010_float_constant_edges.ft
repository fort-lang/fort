//! run
//! stdout:
//| 1.7976931348623157e+308 5e-324 2.2250738585072014e-308
//| 3.4028235e+38 1e-45
//| 0.0 -0.0 1.5e-323
// The edges of both formats as constants: the largest finite value, the least
// subnormal, the least normal, and a literal below half the least subnormal,
// which rounds to zero (D4.4, D2.6).
f64 LARGEST = 1.7976931348623157e308;
f64 LEAST = 4.9406564584124654e-324;
f64 LEAST_NORMAL = 2.2250738585072014e-308;
f32 LARGEST_F32 = 3.4028234663852886e38;
f32 LEAST_F32 = 1.401298464324817e-45;
f64 UNDERFLOW = 1e-400;
f64 THREE_SUBNORMALS = 9.88131291682493e-324;

fn i32 main() {
    println(LARGEST, " ", LEAST, " ", LEAST_NORMAL);
    println(LARGEST_F32, " ", LEAST_F32);
    println(UNDERFLOW, " ", -UNDERFLOW, " ", THREE_SUBNORMALS + LEAST);
    return 0;
}
