//! run
//! stdout:
//| 7.0 3.0 0.5 0.1
//| 0.1 0.10000000149011612
//| 2.0 -3.0 1024.0
// An untyped constant takes the float type of its context: the declared type,
// the parameter, the return type and the other operand (D4.1, D4.2). An
// untyped float becomes f64 with no context (D4.5).
fn f32 half_of(f32 x) {
    return x / 2;
}

fn f64 whole() {
    return 2;
}

fn i32 main() {
    f64 a = 7;
    f32 b = 3;
    f32 c = half_of(1);
    f32 d = 0.1;
    println(a, " ", b, " ", c, " ", d);
    println(d, " ", cast(d, f64));
    f64 e = -3;
    println(whole(), " ", e, " ", 1024.0);
    return 0;
}
