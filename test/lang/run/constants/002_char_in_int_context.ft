//! run
//! stdout:
//| 97 65 10 7
//| a 97
//| 5 true
fn i32 digit(char c) {
    return cast(c, i32) - '0';
}

fn i32 main() {
    u8 b = 'a';
    i32 n = 'A';
    i64 nl = '\n';
    println(b, " ", n, " ", nl, " ", digit('7'));
    println('a', " ", cast('a', u8));
    char c = '5';
    println(digit(c), " ", c == '5');
    return 0;
}
