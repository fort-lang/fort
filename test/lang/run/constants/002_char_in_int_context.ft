//! run
//! stdout:
//| 97 65 10 7
//| a 97
//| 5 true
//| 97 98 4294967393 194
// The last line is the other side of D4.5's char clause, which
// fail/operators/018 holds. A char literal with no context becomes `char`, and
// `char` is no integer type, so the clause reaches the operand rules of D6.2.
// These four expressions stay legal under both compilers, because an integer
// context or an integer constant beside the char literal makes the whole
// untyped expression an integer one and the char is then its code point (D4.3,
// D6.2), and because a shift that folded is an integer constant (D4.4).
fn z(i32 v) i32 {
    return v;
}

fn digit(char c) i32 {
    return cast(c, i32) - '0';
}

fn main() i32 {
    u8 b = 'a';
    i32 n = 'A';
    i64 nl = '\n';
    println(b, " ", n, " ", nl, " ", digit('7'));
    println('a', " ", cast('a', u8));
    char c = '5';
    println(digit(c), " ", c == '5');
    i32 zero = z(0);
    u8 shifted = 'a' << zero;
    println(shifted, " ", 'a' + (1 << zero), " ", 'a' + (4294967296 << zero), " ", 'a' << 1);
    return 0;
}
