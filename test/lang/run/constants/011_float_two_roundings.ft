//! run
//! stdout:
//| 1.0 1.0000000596046448
//| 1.0000001 true
//| 0.1 0.1
// An untyped float is evaluated in binary64 and then takes the float type of
// its context, so a literal that reaches an f32 is rounded twice (D4.4, D4.2).
// This literal is where the two roundings differ from one: it stands exactly
// at the binary64 value midway between two binary32 values, so the second
// rounding is a tie and goes to the even one, while a reader that rounded
// the decimal straight to binary32 would answer the value above.
//
// C, strtof and clang answer 1.0000001 here. fort answers 1.0, and the two
// steps D4.4 fixes are why (the note on D4.4). Every other literal of this
// test reads the same either way, which is the usual case: a decimal must
// land on a binary64 midpoint between two binary32 values to tell them apart.
f32 TIE = 1.000000059604644776257986737988403547205962240695953369140625;
f64 WIDE = 1.000000059604644776257986737988403547205962240695953369140625;

fn i32 main() {
    println(TIE, " ", WIDE);
    // The value above it, which is what one rounding would have given, and
    // the proof that the two are different f32 values.
    f32 above = 1.0000001;
    println(above, " ", above != TIE);
    // A literal that is not at a midpoint reads the same in either method.
    f32 tenth = 0.1;
    f64 wide_tenth = 0.1;
    println(tenth, " ", cast(wide_tenth, f32));
    return 0;
}
