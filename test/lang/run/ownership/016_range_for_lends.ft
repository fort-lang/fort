//! run
//! stdout:
//| 3 6
//| 12 true
//| 6 true
// The collection of a range for lends (D17.10): an owning fixed array and an own slice of owned
// nodes are iterated in place without slicing, the loop variable has the element type without
// its outermost own, and the collection still owns its nodes afterwards.
struct Node {
    i32 value;
}

fn own mut Node* make(i32 v) {
    own mut Node* n = new(Node);
    n->value = v;
    return n;
}

fn i32 main() {
    mut Node* own[3] kids = {};
    kids[0] = make(1);
    kids[1] = make(2);
    kids[2] = make(3);
    mut i32 sum = 0;
    for (mut Node* c : kids) {                // element own mut Node*, variable mut Node*
        sum += c->value;
    }
    println(kids.len, " ", sum);
    for (mut Node* c : kids) {                // writes reach the nodes kids owns
        c->value *= 2;
    }
    println(kids[0]->value + kids[1]->value + kids[2]->value, " ", kids[0] != null);
    own mut Node* own[] all = new(Node* own[2]);
    all[0] = move(kids[0]);
    all[1] = move(kids[1]);
    mut i32 total = 0;
    for (mut Node* c : all) {                 // an own slice lends the same way
        total += c->value;
    }
    println(total, " ", all[0] != null);
    del(kids[2]);
    del(all[0]);
    del(all[1]);
    del(all);
    return 0;
}
