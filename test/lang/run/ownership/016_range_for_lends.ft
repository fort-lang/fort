//! run
//! stdout:
//| 3 6
//| 12 true
//| 6 true
// The collection of a range for lends (D17.10): an owning fixed array and an own span of owned
// nodes are iterated in place without taking a span, the loop variable has the element type
// without its outermost own, and the collection still owns its nodes afterwards.
struct node {
    i32 value;
}

fn node mut* own make(i32 v) {
    node mut* own n = new(node);
    n->value = v;
    return n;
}

fn i32 main() {
    node mut* own[3] mut kids = {};
    kids[0] = make(1);
    kids[1] = make(2);
    kids[2] = make(3);
    i32 mut sum = 0;
    for (node mut* c : kids) {                // element node mut* own, variable node mut*
        sum += c->value;
    }
    println(kids.len, " ", sum);
    for (node mut* c : kids) {                // writes reach the nodes kids owns
        c->value *= 2;
    }
    println(kids[0]->value + kids[1]->value + kids[2]->value, " ", kids[0] != null);
    node mut* own mut@ own all = new(node* own, 2);
    all[0] = move(kids[0]);
    all[1] = move(kids[1]);
    i32 mut total = 0;
    for (node mut* c : all) {                 // an own span lends the same way
        total += c->value;
    }
    println(total, " ", all[0] != null);
    del(kids[2]);
    del(all[0]);
    del(all[1]);
    del(all);
    return 0;
}
