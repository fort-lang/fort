//! run
// The immutable k is 1. The selected case releases a. The default does not run.
fn main() i32 {
    i32 mut* own a = new(i32);
    i32 k = 1;
    switch (k) {
    case 1:
        del(a);
        break;
    default:
        println(*a);
    }
    del(a);                                   // the default leaves a full
    return 0;
}
