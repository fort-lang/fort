//! run
//! stdout:
//| hello 5 true
//| ok 0 true
//| 0 0
// A cast is own exactly when its target says own (D3.14), so bytes built in a u8 mut@ own
// become a string own through cast(move(buf), string own); it lends like any own value and
// is freed with del (D17.12).
fn build() string own {
    u8 mut@ own buf = new(u8, 5);
    buf[0] = 104;
    buf[1] = 101;
    buf[2] = 108;
    buf[3] = 108;
    buf[4] = 111;
    return cast(move(buf), string own);
}

fn main() i32 {
    string own s = build();
    println(s, " ", s.len, " ", s == "hello");
    u8 mut@ own raw = new(u8, 2);
    raw[0] = 111;
    raw[1] = 107;
    string own t = cast(move(raw), string own);
    string view = t;
    println(view, " ", raw.len, " ", raw.ptr == null);
    del(s);
    del(t);
    println(s.len, " ", t.len);
    return 0;
}
