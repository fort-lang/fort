//! run
//! stdout:
//| hello 5 true
//| ok 0 true
//| 0 0
// A cast is own exactly when its target says own (D3.14), so bytes built in an own mut u8[]
// become an own string through cast(move(buf), own string); it lends like any own value and
// is freed with del (D17.12).
fn own string build() {
    own mut u8[] buf = new(u8[5]);
    buf[0] = 104;
    buf[1] = 101;
    buf[2] = 108;
    buf[3] = 108;
    buf[4] = 111;
    return cast(move(buf), own string);
}

fn i32 main() {
    own string s = build();
    println(s, " ", s.len, " ", s == "hello");
    own mut u8[] raw = new(u8[2]);
    raw[0] = 111;
    raw[1] = 107;
    own string t = cast(move(raw), own string);
    string view = t;
    println(view, " ", raw.len, " ", raw.ptr == null);
    del(s);
    del(t);
    println(s.len, " ", t.len);
    return 0;
}
