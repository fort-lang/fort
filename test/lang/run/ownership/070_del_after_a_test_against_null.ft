//! run
//! stdout:
//| done
// `if (p != null) { del(p); }` leaves `p` empty after the `if`: on the edge where the test finds
// null, and after the arm (D17.11 gen rule 6). So the parameter holds no allocation at the
// closing brace, and the leak rule needs no other `del` there (D17.20).
fn drop(i32 mut* own p) void {
    if (p != null) {
        del(p);
    }
}

fn main() i32 {
    drop(new(i32));
    drop(null);
    println("done");
    return 0;
}
