//! run
//! stdout:
//| true true
//| 5 true
// ?: yields an own value only when both operands are own rvalues or null (D6.2, D17.4); the
// result lands in an own place like any own rvalue, while own lvalue operands lend a view.
fn own mut i32* maybe(bool make, i32 v) {
    own mut i32* p = make ? new(i32) : null;
    if (p != null) {
        *p = v;
    }
    return p;
}

fn i32 main() {
    own mut i32* a = maybe(true, 5);
    own mut i32* b = maybe(false, 0);
    println(a != null, " ", b == null);
    mut i32* pick = b == null ? a : b;        // lvalue operands lend: pick is a view
    println(*pick, " ", pick == a);
    del(b);
    del(a);
    return 0;
}
