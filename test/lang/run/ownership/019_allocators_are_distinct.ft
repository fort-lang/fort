//! run
//! stdout:
//| true true
//| 5
//| 0 true true
import extern;
// The runtime has its own allocator, so `new`/`del` and C `calloc`/`free` are not
// interchangeable (D10.3, D10.9). Memory from C is owned when its extern says so (D17.13), and
// the C function that takes the owner as `own` releases it. `del` releases an allocation of
// `new`. run/errors/044 holds the `del` of storage of C, which is `invalid release`.
// `del` of an already emptied operand frees once, since `del` leaves the zero
// value behind and a null pointer or a zero span is a no-op (D17.9).
//
// The two declarations below are `std.libc`'s, `own` included. Every closure
// holds `std.rt`, which imports `std.libc`, so a program declaring a libc
// symbol itself is held against that declaration (D9.8, D9.10, D17.13). No
// cast gives a type to the `void*` that calloc gives (D3.14).
// C: calloc, ISO C11 7.22.3.2 and 7.22.3, calloc(3).
// gives: null, also when count * size does not fit a size_t, or a new allocation of count * size
// zero bytes, aligned for each type of a fundamental alignment, that only free frees (`own`, A2).
// writes: no fort storage. keeps: no pointer. calls: no fort function. frees: nothing.
extern fn calloc(u64 count, u64 size) void mut* own;
// C: free, ISO C11 7.22.3.3, free(3).
// frees: p, an allocation that malloc or calloc gave, which the `own` moves to C; nothing for
// null. gives: no pointer. writes: no storage that fort code still holds. keeps: no pointer.
// calls: no fort function.
extern fn free(void* own p) void;

// C call calloc: no pointer argument.
// C call free: move(from_c), the allocation that calloc gave in this function, or null (D9.8 rule
// 3).
fn main() i32 {
    void mut* own from_c = calloc(1, sizeof(i32));
    bool got = from_c != null;
    free(move(from_c));                       // C releases what C allocated
    println(got, " ", from_c == null);

    del(new(i32));                            // del releases what new allocated
    del(new(u8, 4));                          // an own rvalue may be del'ed (D17.8)
    u8 mut@ own bytes = new(u8, 5);
    println(bytes.len);

    del(bytes);
    del(bytes);                               // a zero span: a second del frees nothing
    i32 mut* own gone = null;
    del(gone);
    println(bytes.len, " ", bytes.ptr == null, " ", gone == null);
    return 0;
}
