//! run
//! stdout:
//| 3 0 1
//| 2 9
//| 4 0
// An own lvalue enters a literal or a field through move; an own rvalue enters directly
// (D17.5). A struct frees its own fields with del, one at a time (D17.7).
struct buf {
    own mut u8[] data;
    u64 len;
}

fn i32 main() {
    own mut u8[] raw = new(u8[3]);
    raw[0] = 1;
    buf b = {move(raw), 3};
    println(b.len, " ", raw.len, " ", b.data[0]);
    mut buf c = buf{.data = new(u8[2])};      // omitted len is zeroed
    c.data[1] = 9;
    println(c.data.len, " ", c.data[1]);
    del(c.data);                              // empty the slot before refilling it
    c.data = new(u8[4]);
    del(b.data);
    println(c.data.len, " ", b.data.len);
    del(c.data);
    return 0;
}
