//! run
//! stdout:
//| one 1
//| other 1
//| 2
// D17.14: Each switch clause releases p.
i32 mut freed = 0;

fn pick(i32 k) void {
    i32 mut* own p = new(i32);
    *p = k;
    switch (k) {
    case 1:
        println("one ", *p);
        del(p);
        freed += 1;
    default:
        println("other ", 1);
        del(p);
        freed += 1;
        break;
    }
}

fn main() i32 {
    pick(1);
    pick(2);
    println(freed);
    return 0;
}
