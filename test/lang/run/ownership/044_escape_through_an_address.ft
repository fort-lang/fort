//! run
//! stdout:
//| 5 true
//| 7 true
// D17.14: The available fill body releases the previous slot and transfers fresh ownership. The
// caller performs final cleanup.
fn fill(i32 mut* own mut* out, i32 v) void {
    i32 mut* own fresh = new(i32);
    *fresh = v;
    del(*out);
    *out = move(fresh);
}

fn main() i32 {
    i32 mut* own mut slot = null;
    fill(&slot, 5);
    println(*slot, " ", slot != null);
    fill(&slot, 7);
    println(*slot, " ", slot != null);
    del(slot);
    return 0;
}
