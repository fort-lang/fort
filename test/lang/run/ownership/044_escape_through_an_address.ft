//! run
//! stdout:
//| 5 true
//| 7 true
// fill releases the old value of the slot and stores a new allocation there. The caller
// releases the slot at the end.
fn fill(i32 mut* own mut* out, i32 v) void {
    i32 mut* own fresh = new(i32);
    *fresh = v;
    del(*out);
    *out = move(fresh);
}

// A read through a pointer: the owner is no local owner here (D17.21).
fn value_in(i32 mut* own* s) i32 {
    return **s;
}

fn main() i32 {
    i32 mut* own mut slot = null;
    fill(&slot, 5);
    println(value_in(&slot), " ", slot != null);
    fill(&slot, 7);
    println(value_in(&slot), " ", slot != null);
    del(slot);
    return 0;
}
