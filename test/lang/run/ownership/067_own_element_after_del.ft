//! run
//! stdout:
//| 3
//| 4
// The overwrite rule of D17.11 reaches an owning element of an array (D17.7). The `del` of
// `owners[0]` empties the element, so the second store into it passes: the constant index 0 is
// the key of both elements (spec/fir.md 11). fail/ownership/049 holds the program with no `del`,
// which does not compile; a checked build of it trapped at run time before the rule became static.
fn main() i32 {
    i32 n = 3;
    i32 mut@ own[2] mut owners = {};
    owners[0] = new(i32, n);
    println(owners[0].len);
    del(owners[0]);
    owners[0] = new(i32, n + 1);
    println(owners[0].len);
    del(owners[0]);
    return 0;
}
