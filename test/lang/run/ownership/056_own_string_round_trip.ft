//! run
//! stdout:
//| abcabc 6
//| 0 true
//| freed 1
// D17.9: Take releases the string allocation. The caller inspects the emptied slot.
import std.str;

i32 mut freed = 0;

fn take(string own s) u64 {
    u64 n = s.len;
    del(s);
    freed += 1;
    return n;
}

fn main() i32 {
    string own joined = str.concat("abc", "abc");
    string own* jp = &joined;
    println(joined, " ", joined.len);
    u64 n = take(move(joined));
    println(n - 6, " ", jp->ptr == null);
    println("freed ", freed);
    return 0;
}
