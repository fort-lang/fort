//! run
//! stdout:
//| 3
// A designated literal leaves the owner `b` out, and gen rule 7 of D17.11 makes it empty after
// the store of the literal, so the store into `pr.b` passes. The literal is no zero form: its
// member `a` holds an allocation, and gen rule 4 makes nothing empty.
struct pair {
    u8 mut* own a;
    u8 mut* own b;
}

fn main() i32 {
    pair mut pr = pair{.a = new(u8)};
    pr.b = new(u8);
    *pr.a = 1;
    *pr.b = 2;
    println(*pr.a + *pr.b);
    del(pr.a);
    del(pr.b);
    return 0;
}
