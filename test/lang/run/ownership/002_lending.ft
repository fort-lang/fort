//! run
//! stdout:
//| 6 3
//| 9 9
//| true false
// An own value converts implicitly to the non-own type wherever a value meets an expected type,
// and the operands of == and != lend (D17.4).
struct point {
    i32 x;
    i32 y;
}

fn i32 sum(i32@ s) {
    i32 mut total = 0;
    for (i32 v : s) {
        total += v;
    }
    return total;
}

fn void fill(i32 mut@ s, i32 v) {
    for (u64 mut i = 0; i < s.len; i++) {
        s[i] = v;
    }
}

fn i32 read_x(point* p) {
    return p->x;
}

fn i32 main() {
    i32 mut@ own buf = new(i32, 3);
    fill(buf, 2);                             // i32 mut@ own lends as i32 mut@
    i32@ view = buf;                          // and as i32@
    println(sum(buf), " ", view.len);
    point mut* own p = new(point);
    p->x = 9;
    point mut* q = p;                         // point mut* own lends as point mut*
    println(read_x(p), " ", q->x);            // and as point* at the call
    println(p == q, " ", p != q);                // p lends as point mut* (D6.2)
    del(p);
    del(buf);
    return 0;
}
