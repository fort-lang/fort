//! run
//! stdout:
//| 6 3
//| 9 9
//| true false 3
// An own value converts implicitly to the non-own type wherever a value meets an expected type,
// and the operands of ==, != and ?: lend (D17.4).
struct point {
    i32 x;
    i32 y;
}

fn i32 sum(i32[] s) {
    mut i32 total = 0;
    for (i32 v : s) {
        total += v;
    }
    return total;
}

fn void fill(mut i32[] s, i32 v) {
    for (mut u64 i = 0; i < s.len; i++) {
        s[i] = v;
    }
}

fn i32 read_x(point* p) {
    return p->x;
}

fn i32 main() {
    own mut i32[] buf = new(i32[3]);
    fill(buf, 2);                             // own mut i32[] lends as mut i32[]
    i32[] view = buf;                         // and as i32[]
    println(sum(buf), " ", view.len);
    own mut point* p = new(point);
    p->x = 9;
    mut point* q = p;                         // own mut point* lends as mut point*
    println(read_x(p), " ", q->x);            // and as point* at the call
    own mut i32[] other = new(i32[1]);
    i32[] pick = buf.len > other.len ? buf : other;
    println(p == q, " ", p != q, " ", pick.len);   // p lends as mut point* (D6.2)
    del(other);
    del(p);
    del(buf);
    return 0;
}
