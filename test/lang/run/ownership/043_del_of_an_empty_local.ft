//! run
//! stdout:
//| 2 true
//| true
// D17.9: Repeated del frees once. Slot aliases inspect empty owner values.
fn main() i32 {
    u8 mut@ own s = new(u8, 2);
    u8 mut@ own* sp = &s;
    println(s.len, " ", s.ptr != null);
    del(s);
    del(s);
    del(s);
    i32* own gone = null;
    i32* own* gonep = &gone;
    del(gone);
    println(sp->ptr == null && *gonep == null);
    return 0;
}
