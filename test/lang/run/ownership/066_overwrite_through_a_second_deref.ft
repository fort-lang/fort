//! run
//! abort
//! stderr: run/ownership/066_overwrite_through_a_second_deref.ft:23:10: runtime error: overwriting owned value
//! stdout:
//| before
// A store through a pointer field can name any object: `p->next` holds the
// value of `p`, so `p->next->g` and `p->g` are one place (D17.11). The `del`
// empties it, the store through `p->next` fills it, and the store into `p->g`
// finds it live and traps. The compile-time proof must not prove that store.
struct node {
    i32 v;
}

struct outer {
    node mut* own g;
    outer mut* next;
}

fn bad(outer mut* p) void {
    p->next = p;
    del(p->g);
    p->next->g = new(node);
    p->g = new(node);
}

fn main() i32 {
    outer mut o = {};
    println("before");
    bad(&o);
    println("never");
    del(o.g);
    return 0;
}
