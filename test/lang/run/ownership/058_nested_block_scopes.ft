//! run
//! stdout:
//| inner 1
//| outer 2
//| freed 2
// The inner and the outer block each release their allocation at their own end.
i32 mut freed = 0;

fn drop(i32 mut* own p) void {
    del(p);
    freed += 1;
}

fn main() i32 {
    i32 mut* own outer = new(i32);
    *outer = 2;
    {
        i32 mut* own inner = new(i32);
        *inner = 1;
        println("inner ", *inner);
        drop(move(inner));
    }
    println("outer ", *outer);
    drop(move(outer));
    println("freed ", freed);
    return 0;
}
