//! run
//! stdout:
//| hey 3
//| 7 true
//| 1 true
// The result of a cast is own exactly when its target type says own (D3.14, D17.3): an own
// source cast to a non-own target lends a view, a non-own source cast to an own target adopts
// the allocation, and an own lvalue cast to an own target has to be moved (D17.5). own in an
// extern signature records the C convention and is erased (D17.13).
extern fn own void* malloc(u64 n);
extern fn void* calloc(u64 count, u64 size);
extern fn void free(own void* p);

fn i32 main() {
    own mut u8[] buf = new(u8[3]);
    buf[0] = 104;
    buf[1] = 101;
    buf[2] = 121;
    string text = cast(buf, string);          // lends: buf still owns the bytes
    println(text, " ", text.len);
    own mut i32* p = cast(calloc(1, sizeof(i32)), own mut i32*);   // adopts C memory
    *p = 7;
    i32 seen = *p;
    del(p);                                   // the same allocator as free (D10.3)
    println(seen, " ", p == null);
    own mut u8* raw = cast(malloc(1), own mut u8*);   // own void* rvalue: stays own
    *raw = 1;
    u8 first = *raw;
    free(cast(move(raw), own void*));         // an own lvalue is moved into the cast
    println(first, " ", raw == null);
    del(buf);
    return 0;
}
