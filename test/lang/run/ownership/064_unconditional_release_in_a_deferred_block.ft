//! run
//! stdout:
//| body
//| block 2
//| freed 2
// D17.14: The deferred block reads second before transferring and releasing both owners.
i32 mut freed = 0;

fn drop(i32 mut* own p) void {
    del(p);
    freed += 1;
}

fn use_two() void {
    i32 mut* own first = new(i32);
    i32 mut* own second = new(i32);
    *second = 2;
    defer {
        println("block ", *second);
        drop(move(second));
        drop(move(first));
    }
    println("body");
}

fn main() i32 {
    use_two();
    println("freed ", freed);
    return 0;
}
