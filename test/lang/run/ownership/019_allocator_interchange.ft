//! run
//! stdout:
//| 7 true
//| 5
//| 0 true true
// Allocation has no header, so `new`/`del` and C `malloc`/`free` are
// interchangeable, and memory from C is owned when its extern says so (D10.3, D17.13).
// `del` of an already emptied operand frees once, since `del` leaves the zero
// value behind and a null pointer or a zero span is a no-op (D17.9).
//
// The two declarations below are `std.libc`'s, `own` included. Every closure
// holds `std.rt`, which imports `std.libc`, so a program declaring a libc
// symbol itself is held against that declaration (D9.8, D9.10, D17.13).
extern fn calloc(u64 count, u64 size) void mut* own;
extern fn free(void* own p) void;

fn main() i32 {
    i32 mut* own from_c = cast(calloc(1, sizeof(i32)), i32 mut* own);
    *from_c = 7;
    i32 seen = *from_c;
    del(from_c);                              // the same allocator as free
    println(seen, " ", from_c == null);

    free(cast(new(i32), void* own));          // C frees what new allocated
    del(new(u8, 4));                          // an own rvalue may be del'ed (D17.8)
    u8 mut@ own bytes = new(u8, 5);
    println(bytes.len);

    del(bytes);
    del(bytes);                               // a zero span: a second del frees nothing
    i32 mut* own gone = null;
    del(gone);
    println(bytes.len, " ", bytes.ptr == null, " ", gone == null);
    return 0;
}
