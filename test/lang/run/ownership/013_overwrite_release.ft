//! run
//! flags: --release
//! stdout:
//| making 1
//| before 1
//| making 2
//| after 2
// Release builds store over a live own value without a check (D11.1, D17.11); the old
// allocation is simply leaked, which is not tracked (D17.14). Same program as 012.
fn i32 mut* own make(i32 v) {
    i32 mut* own p = new(i32);
    *p = v;
    println("making ", v);
    return p;
}

fn i32 main() {
    i32 mut* own mut p = make(1);
    println("before ", *p);
    p = make(2);
    println("after ", *p);
    del(p);
    return 0;
}
