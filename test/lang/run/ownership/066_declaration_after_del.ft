//! run
//! stdout:
//| 0
//| 1
//| 2
// A declaration in a loop passes the proof of D17.11 when the body deletes or moves its local
// before the back edge: the back edge then joins an empty slot with the entry zeroing.
// fail/ownership/048 holds the same loop with no `del`, which does not compile; a checked build
// of that program trapped at run time before the rule became static.
fn main() i32 {
    for (i32 mut i = 0; i < 3; i++) {
        i32 mut* own kept = new(i32);
        *kept = i;
        println(*kept);
        del(kept);
    }
    return 0;
}
