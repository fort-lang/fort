//! run
//! stdout:
//| 4 42
//| 0 true
//| 0 done
// return of an own local is an implicit move that runs before deferred code (D7.8, D17.5), so
// defer del(buf) frees the buffer on every path except the one that hands it to the caller.
fn read_all(bool fail) u8 mut@ own {
    u8 mut@ own buf = new(u8, 4);
    defer del(buf);
    buf[0] = 42;
    if (fail) {
        u8 mut@ own empty = {};
        return empty;                         // buf is freed by the defer
    }
    return buf;                               // buf is empty when the defer runs
}

fn main() i32 {
    u8 mut@ own ok = read_all(false);
    println(ok.len, " ", ok[0]);              // alive: the deferred del was a no-op
    u8 mut@ own bad = read_all(true);
    println(bad.len, " ", bad.ptr == null);
    del(ok);                                  // the one and only free of that buffer
    del(bad);
    println(ok.len, " done");
    return 0;
}
