//! run
//! stdout:
//| 3 30
//| true true
//| 30 2
//| 20 1
//| 10 0
//| 0 true
//| 3
// The container idiom of memory-model.md 2.3: pushing moves the new element
// in and popping moves it out, and every field a store overwrites was emptied
// by a `move` or a `del` first, so the compiler proves each store (D17.5,
// D17.6, D17.11). `del(pop(l))` frees an owning rvalue on the spot (D17.8).
struct node {
    i32 value;
    node mut* own next;
}

struct list {
    node mut* own head;
    u64 size;
}

fn push(list mut* l, node mut* own n) void {
    del(n->next);                             // the entry value of n->next is unknown
    n->next = move(l->head);                  // the head slot is empty afterwards
    del(l->head);                             // frees nothing: the store through n killed its fact
    l->head = move(n);                        // and takes the new node
    l->size += 1;
}

fn pop(list mut* l) node mut* own {
    node mut* own n = move(l->head);
    if (n != null) {
        l->head = move(n->next);              // the emptied head takes the tail
        l->size -= 1;
    }
    return n;
}

// Frees each node of a list that the caller moves in. `del` is shallow, so each node gives up its
// tail before it is freed.
fn list_drop(list mut l) void {
    while (l.head != null) {
        node mut* own gone = move(l.head);
        node mut* own rest = move(gone->next);
        del(gone);
        l.head = move(rest);
    }
}

// Ends a list in an allocation that the caller moves in.
fn list_drop_made(list mut* own p) void {
    list kept = move(*p);
    del(p);
    list_drop(move(kept));
}

// A read through a pointer: the owner is no local owner here (D17.21).
fn head_value(list* l) i32 {
    return l->head->value;
}

fn main() i32 {
    list mut* own l = new(list);
    defer list_drop_made(move(l));
    node mut* own first = new(node);
    first->value = 10;
    push(l, move(first));
    node mut* own second = new(node);
    second->value = 20;
    push(l, move(second));                    // an own lvalue needs move
    node mut* own third = new(node);
    third->value = 30;
    push(l, move(third));
    println(l->size, " ", head_value(l));
    println(second == null, " ", third == null);
    while (l->head != null) {
        node mut* own n = pop(l);
        println(n->value, " ", l->size);
        del(n);
    }
    println(l->size, " ", l->head == null);
    i32 mut freed = 0;
    push(l, new(node));
    push(l, new(node));
    push(l, new(node));
    while (l->head != null) {
        del(pop(l));                          // an own rvalue: freed on the spot
        freed += 1;
    }
    println(freed);
    return 0;
}
