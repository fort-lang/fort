//! run
//! stdout:
//| left 1
//| right 1
//| freed 2
// Both enum switch clauses move bytes to drop, which releases it (D17.5).
enum side {
    left,
    right,
}

i32 mut freed = 0;

fn drop(u8 mut@ own s) void {
    del(s);
    freed += 1;
}

fn show(side s) void {
    u8 mut@ own bytes = new(u8, 1);
    switch (s) {
    case side.left:
        println("left ", bytes.len);
        drop(move(bytes));
    case side.right:
        println("right ", bytes.len);
        drop(move(bytes));
    }
}

fn main() i32 {
    show(side.left);
    show(side.right);
    println("freed ", freed);
    return 0;
}
