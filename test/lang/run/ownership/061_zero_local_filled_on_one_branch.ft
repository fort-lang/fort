//! run
//! stdout:
//| 5 true
//| 0 true
//| freed 1
// D17.14: The guarded read dereferences only a live p. Drop releases a live value or ignores
// zero.
i32 mut freed = 0;

fn drop(i32 mut* own p) void {
    if (p != null) {
        freed += 1;
    }
    del(p);
}

fn pick(bool c) void {
    i32 mut* own mut p = null;
    if (c) {
        p = new(i32);
        *p = 5;
    }
    if (p != null) {
        println(*p, " ", true);
    } else {
        println(0, " ", p == null);
    }
    drop(move(p));
}

fn main() i32 {
    pick(true);
    pick(false);
    println("freed ", freed);
    return 0;
}
