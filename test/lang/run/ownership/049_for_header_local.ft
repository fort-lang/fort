//! run
//! stdout:
//| 0 1 2
//| freed 1
// D17.14: The header allocation survives iterations and transfers to drop before the only break.
i32 mut freed = 0;

fn drop(i32 mut* own p) void {
    del(p);
    freed += 1;
}

fn main() i32 {
    for (i32 mut* own count = new(i32); ; *count += 1) {
        print(*count);
        if (*count < 2) {
            print(" ");
        }
        if (*count == 2) {
            drop(move(count));
            break;
        }
    }
    println();
    println("freed ", freed);
    return 0;
}
