//! run
//! stdout:
//| outer 0 inner 2
//| outer 1 inner 2
//| freed 6
// D17.14: Each inner body releases b. Each outer body releases a.
i32 mut freed = 0;

fn drop(i32 mut* own p) void {
    del(p);
    freed += 1;
}

fn main() i32 {
    i32 mut outer = 0;
    while (outer < 2) {
        i32 mut* own a = new(i32);
        *a = outer;
        i32 mut inner = 0;
        while (true) {
            i32 mut* own b = new(i32);
            *b = inner;
            inner += 1;
            drop(move(b));
            if (inner == 2) {
                break;
            }
        }
        println("outer ", *a, " inner ", inner);
        drop(move(a));
        outer += 1;
    }
    println("freed ", freed);
    return 0;
}
