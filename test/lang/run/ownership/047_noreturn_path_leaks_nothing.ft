//! run
//! stdout:
//| 4 ok
// D17.14: The available stop body panics. The normal use_buffer path releases buf.
fn stop(string why) noreturn {
    panic(why);
}

fn use_buffer(bool fail) u64 {
    u8 mut@ own buf = new(u8, 4);
    if (fail) {
        stop("no buffer");
    }
    u64 n = buf.len;
    del(buf);
    return n;
}

fn main() i32 {
    println(use_buffer(false), " ok");
    return 0;
}
