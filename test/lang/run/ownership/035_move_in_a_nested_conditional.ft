//! run
// Both immutable c tests are true. The selected nested arm moves a, and del(b) releases
// it (D17.6).
fn main() i32 {
    i32 mut* own a = new(i32);
    bool c = true;
    i32 mut* own b = c ? (c ? move(a) : new(i32)) : new(i32);
    del(b);
    del(a);                                   // the other arms leave a full
    return 0;
}
