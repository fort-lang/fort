//! run
//! stdout:
//| 6
// A store through an `own` pointer keeps the fact of a memory local (D17.11, Borrows): `n` holds
// the start of an allocation, which lies in no frame, so `n->v = 1` cannot write `x`, though the
// store into `P` exposed `x`. fail/ownership/077 stores through a copy of `P` and is an error.
struct cell {
    i32 mut* own o;
    u64 v;
}

i32 mut* own mut* mut P = null;

fn fill(cell mut* own n) i32 {
    i32 mut* own mut x = null;
    P = &x;
    del(x);
    n->v = 1;
    x = new(i32);
    *x = 5;
    i32 r = *x + cast(n->v, i32);
    del(x);
    del(n->o);
    del(n);
    P = null;
    return r;
}

fn main() i32 {
    println(fill(new(cell)));
    return 0;
}
