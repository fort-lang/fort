//! run
//! stdout:
//| one
//| freed 1
//| two
//| freed 2
//| other
//| freed 3
// D17.14: Each else-if arm transfers a to drop, which releases it.
i32 mut freed = 0;

fn drop(i32 mut* own p) void {
    del(p);
    freed += 1;
}

fn pick(i32 k) void {
    i32 mut* own a = new(i32);
    *a = k;
    if (k == 1) {
        println("one");
        drop(move(a));
    } else if (k == 2) {
        println("two");
        drop(move(a));
    } else {
        println("other");
        drop(move(a));
    }
    println("freed ", freed);
}

fn main() i32 {
    pick(1);
    pick(2);
    pick(3);
    return 0;
}
