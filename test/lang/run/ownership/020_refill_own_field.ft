//! run
//! stdout:
//| 2 2
//| 3 4
//| 4 6
// A store into an owning field through a pointer parameter needs the proof that
// the field is empty, and the entry value of `v->data` is unknown (D17.11). The
// `del(v->data)` makes it empty, and a `del` of an empty span frees nothing
// (D17.9), so each call of `fill` replaces the field, the first call included.
// fail/ownership/053 is the program with no `del`, and it does not compile.
struct vec {
    i32 mut@ own data;
    u64 len;
}

fn fill(vec mut* v, u64 n) void {
    del(v->data);
    v->data = new(i32, n);
    v->len = n;
    for (u64 mut i = 0; i < n; i++) {
        v->data[i] = cast(i * 2, i32);
    }
}

fn main() i32 {
    vec mut v = {};
    fill(&v, 2);
    println(v.len, " ", v.data[1]);
    fill(&v, 3);
    println(v.len, " ", v.data[2]);
    fill(&v, 4);
    println(v.len, " ", v.data[3]);
    del(v.data);
    return 0;
}
