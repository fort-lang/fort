//! run
//! stdout:
//| 4 42
//| 2 7
//| freed 2
// Deferred calls release the buffers on the early and the late return (D7.8).
i32 mut freed = 0;

fn released(u8 mut@ own b) void {
    del(b);
    freed += 1;
}

fn make(u64 n, bool early) u64 {
    u8 mut@ own buf = new(u8, n);
    defer released(move(buf));
    buf[0] = 42;
    if (early) {
        return buf.len;
    }
    return buf.len;
}

fn main() i32 {
    u8 mut@ own first = new(u8, 4);
    defer del(first);
    first[0] = 42;
    println(first.len, " ", first[0]);
    println(make(2, true), " ", make(7, false));
    println("freed ", freed);
    return 0;
}
