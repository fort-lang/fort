//! run
//! stdout:
//| body
//| inner
//| outer
// D17.14: The inner deferred del releases b. The outer deferred body releases a.
fn main() i32 {
    i32 mut* own a = new(i32);
    defer {
        i32 mut* own b = new(i32);
        defer del(b);
        println("inner");
        del(a);
        println("outer");
    }
    println("body");
    return 0;
}
