//! run
//! stdout:
//| 7 8
// A store through a parameter keeps the fact of a memory local (D17.11, Borrows): `q` borrows no
// origin, because no address that the run takes reaches a parameter, so the store into `q->o`
// cannot write `x`, and `x = new(i32)` needs no `del` before it. fail/ownership/076 stores through
// a pointer that a call can give the address of `x`.
struct cell {
    i32 mut* own o;
    u64 v;
}

fn fill(cell mut* q) i32 {
    i32 mut* own mut x = null;
    i32 mut* own mut* px = &x;
    del(q->o);
    q->o = new(i32);
    *q->o = 7;
    x = new(i32);
    **px = 8;
    i32 r = *x;
    del(x);
    return r;
}

// A read through a pointer: the owner is no local owner here (D17.21).
fn value_in(cell* c) i32 {
    return *c->o;
}

fn main() i32 {
    cell mut c = {};
    i32 r = fill(&c);
    println(value_in(&c), " ", r);
    del(c.o);
    return 0;
}
