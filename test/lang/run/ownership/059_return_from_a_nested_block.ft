//! run
//! stdout:
//| 5
//| freed 1
// D17.14: The function transfers answer and releases scratch through the nested block defer.
i32 mut freed = 0;

fn drop(u8 mut@ own s) void {
    del(s);
    freed += 1;
}

fn make() i32 mut* own {
    i32 mut* own answer = new(i32);
    *answer = 5;
    {
        u8 mut@ own scratch = new(u8, 3);
        defer drop(move(scratch));
        return move(answer);
    }
}

fn main() i32 {
    i32 mut* own p = make();
    println(*p);
    del(p);
    println("freed ", freed);
    return 0;
}
