//! run
//! stdout:
//| 0 true 2
//| true 4
//| 0 0
//| 2 0
// move leaves the zero value behind: {null, 0} for a slice, null for a pointer (D17.6). Moving
// a zero value yields a zero value, and an emptied slot accepts a new value (D17.11).
fn i32 main() {
    own mut i32[] a = new(i32[2]);
    own mut i32[] b = move(a);
    println(a.len, " ", a.ptr == null, " ", b.len);
    own mut i32* p = new(i32);
    *p = 4;
    own mut i32* q = move(p);
    println(p == null, " ", *q);
    own mut i32[] z = {};
    own mut i32[] y = move(z);
    println(y.len, " ", z.len);
    a = move(b);                              // a is empty, so the store passes the check
    println(a.len, " ", b.len);
    del(a);
    del(q);
    return 0;
}
