//! run
//! stdout:
//| 0 true 2
//| true 4
//| 0 0
//| 2 0
// move leaves the zero value behind: {null, 0} for a span, null for a pointer (D17.6). Moving
// a zero value yields a zero value, and an emptied slot accepts a new value (D17.11).
fn main() i32 {
    i32 mut@ own mut a = new(i32, 2);
    i32 mut@ own b = move(a);
    println(a.len, " ", a.ptr == null, " ", b.len);
    i32 mut* own p = new(i32);
    *p = 4;
    i32 mut* own q = move(p);
    println(p == null, " ", *q);
    i32 mut@ own z = {};
    i32 mut@ own y = move(z);
    println(y.len, " ", z.len);
    a = move(b);                              // a is empty, so the store passes the check
    println(a.len, " ", b.len);
    del(a);
    del(q);
    return 0;
}
