//! run
//! stdout:
//| 7
//| freed 1
//| 0 true
// D17.14: Outer transfers p to inner. Inner releases it. The caller inspects its empty slot.
i32 mut freed = 0;

fn inner(i32 mut* own p) i32 {
    i32 v = *p;
    del(p);
    freed += 1;
    return v;
}

fn outer(i32 mut* own p) i32 {
    return inner(move(p));
}

fn main() i32 {
    i32 mut* own a = new(i32);
    *a = 7;
    i32 mut* own* ap = &a;
    println(outer(move(a)));
    println("freed ", freed);
    println(0, " ", *ap == null);
    return 0;
}
