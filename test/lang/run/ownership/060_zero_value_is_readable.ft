//! run
//! stdout:
//| true 0 true
//| true 0
//| true true
// D17.6: All owner values are empty. Move, del, and zero inspections retain no allocation
// obligation.
fn main() i32 {
    i32* own p = null;
    u8 mut@ own s = {};
    println(p == null, " ", s.len, " ", s.ptr == null);
    u8 mut@ own t = move(s);
    println(s.ptr == null, " ", t.len);
    del(p);
    del(s);
    del(t);
    println(p == null, " ", s.len == 0);
    return 0;
}
