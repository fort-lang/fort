//! run
//! stdout:
//| body 0
//| body 2
//| freed 4
// D17.14: Each body path releases step. The final del releases keep.
i32 mut freed = 0;

fn drop(i32 mut* own p) void {
    del(p);
    freed += 1;
}

fn main() i32 {
    i32 mut* own keep = new(i32);
    i32 mut i = 0;
    while (i < 4) {
        i32 mut* own step = new(i32);
        *step = i;
        i += 1;
        if (*step % 2 == 1) {
            drop(move(step));
            continue;
        }
        println("body ", *step);
        drop(move(step));
    }
    println("freed ", freed);
    del(keep);
    return 0;
}
