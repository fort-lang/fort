//! run
//! stdout:
//| 7
// A call keeps the facts through a fresh pointer local (D17.11 kill rule 5): no pointer but `n`
// names the object of `new(node)`, and `n` is no memory, so `g` cannot fill `n->left`, and the
// store into it after the call passes. fail/ownership/096 gives its fresh pointer to the call,
// which ends its freshness, and is an error.
struct leaf {
    i32 v;
}

struct node {
    leaf mut* own left;
    i32 v;
}

i32 mut COUNT = 0;

fn g() void {
    COUNT += 1;
}

fn free_node(node mut* own n) void {
    del(n->left);
    del(n);
}

fn main() i32 {
    leaf mut* own mut l = new(leaf);
    l->v = 6;
    node mut* own n = new(node);
    g();
    n->left = move(l);
    n->v = n->left->v + COUNT;
    println(n->v);
    free_node(move(n));
    return 0;
}
