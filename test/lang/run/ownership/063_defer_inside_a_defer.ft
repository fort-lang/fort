//! run
//! stdout:
//| 1
//| freed 1
// The read comes before the deferred move to drop, and drop releases a (D7.8).
i32 mut freed = 0;

fn drop(i32 mut* own p) void {
    del(p);
    freed += 1;
}

fn use_it() void {
    i32 mut* own a = new(i32);
    *a = 1;
    defer {
        defer drop(move(a));
    }
    println(*a);
}

fn main() i32 {
    use_it();
    println("freed ", freed);
    return 0;
}
