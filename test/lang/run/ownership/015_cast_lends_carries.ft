//! run
//! stdout:
//| hey 3
//| 7 true
//| 1 true
// The result of a cast is own exactly when its target type says own (D3.14, D17.3): an own
// source cast to a non-own target lends a view, an own rvalue cast to an own target carries
// the allocation, and an own lvalue cast to an own target has to be moved (D17.5). own in an
// extern signature records the C convention and is erased (D17.13).
// These three are `std.libc`'s declarations, `own` included: every closure
// holds `std.rt`, which imports `std.libc`, so a program that declares a libc
// symbol itself must agree with it (D9.8, D9.10, D17.13).
extern fn malloc(u64 size) void mut* own;
extern fn calloc(u64 n, u64 size) void mut* own;
extern fn free(void* own p) void;

fn main() i32 {
    u8 mut@ own buf = new(u8, 3);
    buf[0] = 104;
    buf[1] = 101;
    buf[2] = 121;
    string text = cast(buf, string);          // lends: buf still owns the bytes
    println(text, " ", text.len);
    i32 mut* own p = cast(calloc(1, sizeof(i32)), i32 mut* own);   // carries calloc's own
    *p = 7;
    i32 seen = *p;
    del(p);                                   // the same allocator as free (D10.3)
    println(seen, " ", p == null);
    u8 mut* own raw = cast(malloc(1), u8 mut* own);   // void mut* own rvalue: stays own
    *raw = 1;
    u8 first = *raw;
    free(cast(move(raw), void* own));         // an own lvalue is moved into the cast
    println(first, " ", raw == null);
    del(buf);
    return 0;
}
