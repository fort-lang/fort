//! run
//! stdout:
//| hey 3
//| 7 true
//| true true
import extern;
// The result of a cast is own exactly when its target type says own (D3.14, D17.3): an own
// source cast to a non-own target lends a view, an own rvalue cast to an own target carries
// the allocation, and an own lvalue cast to an own target has to be moved (D17.5). own in an
// extern signature records the C convention and is erased (D17.13).
// These two are `std.libc`'s declarations, `own` included: every closure
// holds `std.rt`, which imports `std.libc`, so a program that declares a libc
// symbol itself must agree with it (D9.8, D9.10, D17.13). No cast gives a type
// to the `void*` that malloc gives (D3.14), so the block stays a `void*`.
// C: malloc, ISO C11 7.22.3.4 and 7.22.3, malloc(3).
// gives: null, or a new allocation of size bytes, aligned for each type of a fundamental alignment,
// that only free frees (`own`, A2). writes: no fort storage. keeps: no pointer. calls: no fort
// function. frees: nothing.
extern fn malloc(u64 size) void mut* own;
// C: free, ISO C11 7.22.3.3, free(3).
// frees: p, an allocation that malloc or calloc gave, which the `own` moves to C; nothing for
// null. gives: no pointer. writes: no storage that fort code still holds. keeps: no pointer.
// calls: no fort function.
extern fn free(void* own p) void;

// C call malloc: no pointer argument.
// C call free: cast(move(raw), void* own), the allocation that malloc gave in this function, or
// null (D9.8 rule 3).
fn main() i32 {
    u8 mut@ own buf = new(u8, 3);
    buf[0] = 104;
    buf[1] = 101;
    buf[2] = 121;
    string text = cast(buf, string);          // lends: buf still owns the bytes
    println(text, " ", text.len);
    i32 mut* own p = cast(new(i64), i32 mut* own);   // an own rvalue: carries the allocation
    *p = 7;
    i32 seen = *p;
    del(p);                                   // an allocation of new (D10.3)
    println(seen, " ", p == null);
    void mut* own raw = malloc(1);            // void mut* own rvalue: stays own
    bool got = raw != null;
    free(cast(move(raw), void* own));         // an own lvalue is moved into the cast
    println(got, " ", raw == null);
    del(buf);
    return 0;
}
