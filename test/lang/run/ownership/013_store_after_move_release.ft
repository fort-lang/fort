//! run
//! flags: --release
//! stdout:
//| making 1
//| before 1
//| making 2
//| after 2, old 1
// A `move` out of an `own` reference empties its source, so a store into the
// source after the move passes in every build mode (D17.11, gen rule 3). This
// test builds with --release. fail/ownership/052 is the release build of the
// same store with no `move`, and it does not compile.
fn make(i32 v) i32 mut* own {
    i32 mut* own p = new(i32);
    *p = v;
    println("making ", v);
    return p;
}

fn main() i32 {
    i32 mut* own mut p = make(1);
    println("before ", *p);
    i32 mut* own old = move(p);
    p = make(2);
    println("after ", *p, ", old ", *old);
    del(old);
    del(p);
    return 0;
}
