//! run
//! stdout:
//| 6
// A literal whose members are each a zero form, at any depth, is a zero form (D17.11 gen rule
// 4): the store of `outer{pair{null, null}, null}` makes `o.i.a`, `o.i.b` and `o.q` empty, so
// the three stores after it pass. The stores through the three pointers come after them, because
// such a store kills the facts of the other places of `o` (kill rule 1).
struct pair {
    u8 mut* own a;
    u8 mut* own b;
}

struct outer {
    pair i;
    u8 mut* own q;
}

fn main() i32 {
    outer mut o = outer{.i = pair{}};
    o = outer{pair{null, null}, null};
    o.i.a = new(u8);
    o.i.b = new(u8);
    o.q = new(u8);
    *o.i.a = 1;
    *o.i.b = 2;
    *o.q = 3;
    println(*o.i.a + *o.i.b + *o.q);
    del(o.i.a);
    del(o.i.b);
    del(o.q);
    return 0;
}
