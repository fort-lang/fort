//! run
//! stdout:
//| body 0
//| body 2
//| freed 4
//| i 4
// D17.14: Deferred calls release each body allocation on break, continue, and body completion.
i32 mut freed = 0;

fn drop(i32 mut* own p) void {
    del(p);
    freed += 1;
}

fn main() i32 {
    i32 mut i = 0;
    while (i < 5) {
        i32 mut* own p = new(i32);
        defer drop(move(p));
        *p = i;
        i += 1;
        if (*p > 2) {
            break;
        }
        if (*p == 1) {
            continue;
        }
        println("body ", *p);
    }
    println("freed ", freed);
    println("i ", i);
    return 0;
}
