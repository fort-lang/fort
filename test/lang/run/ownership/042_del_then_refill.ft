//! run
//! stdout:
//| 1 2 3
//| 0 true
// D17.11: Each replacement follows del or move. del(a) empties a. The last del(b) frees nothing.
fn main() i32 {
    i32 mut* own mut a = new(i32);
    *a = 1;
    i32 mut n = *a;
    del(a);
    a = new(i32);
    *a = 2;
    n = n * 10 + *a;
    i32 mut* own b = new(i32);
    *b = 3;
    del(a);
    a = move(b);
    println(n / 10, " ", n % 10, " ", *a);
    i32 mut* own* bp = &b;
    del(a);
    println(0, " ", *bp == null);
    del(b);                                   // the call above can write b through bp
    return 0;
}
