//! run
// The immutable c is true. Its arm releases b and fills a, del(a) releases a, and the final
// del(b) frees nothing.
fn main() i32 {
    i32 mut* own mut a = null;
    i32 mut* own b = new(i32);
    bool c = true;
    if (c) {
        a = new(i32);
        del(b);
    }
    del(a);
    del(b);                                   // a false c leaves b full
    return 0;
}
