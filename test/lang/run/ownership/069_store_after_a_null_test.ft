//! run
//! stdout:
//| 1
//| 1
// A test against null makes the field that it tests empty in the arm where it finds null (D17.11
// gen rule 6), so the arm stores into `l->head` with no `del` first. The second call finds the
// field full and stores nothing.
struct node {
    i32 value;
}

struct list {
    node mut* own head;
}

fn fill(list mut* l) void {
    if (l->head == null) {
        l->head = new(node);
        l->head->value = 1;
    }
}

// A read through a pointer: the owner is no local owner here (D17.21).
fn head_value(list* l) i32 {
    return l->head->value;
}

fn main() i32 {
    list mut l = list{};
    fill(&l);
    println(head_value(&l));
    fill(&l);
    println(head_value(&l));
    del(l.head);
    return 0;
}
