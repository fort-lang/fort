//! run
//! stdout:
//| making 1
//| before 1
//| making 2
//| after 2
// A `del` before a store into an `own` reference empties the destination, so
// the emptiness pass proves the store and the checked build runs it (D17.11,
// gen rule 2). fail/ownership/051 is the same program with no `del`, and it
// does not compile.
fn make(i32 v) i32 mut* own {
    i32 mut* own p = new(i32);
    *p = v;
    println("making ", v);
    return p;
}

fn main() i32 {
    i32 mut* own mut p = make(1);
    println("before ", *p);
    del(p);
    p = make(2);
    println("after ", *p);
    del(p);
    return 0;
}
