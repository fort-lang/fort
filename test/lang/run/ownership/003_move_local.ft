//! run
//! stdout:
//| 3 7
//| 5
//| 2
//| 3 done
// move(lv) transfers an owning local into an own place: a new binding or an own parameter
// (D17.5, D17.6). The source need not be mut, and mut may be dropped on the way.
struct Point {
    i32 x;
    i32 y;
}

fn void consume(own mut i32[] s) {
    print(s.len);
    del(s);
}

fn i32 main() {
    own mut i32[] a = new(i32[3]);
    a[0] = 7;
    own mut i32[] b = move(a);
    println(b.len, " ", b[0]);
    own mut Point* p = new(Point);
    p->x = 5;
    own Point* q = move(p);
    println(q->x);
    own i32[] c = new(i32[2]);
    own i32[] d = move(c);
    println(d.len);
    consume(move(b));
    println(" done");
    del(d);
    del(q);
    return 0;
}
