//! run
//! stdout:
//| 3 7
//| 5
//| 2
//| 3 done
// move(lv) transfers an owning local into an own place: a new binding or an own parameter
// (D17.5, D17.6). The source need not be mut, and mut may be dropped on the way.
struct point {
    i32 x;
    i32 y;
}

fn consume(i32 mut@ own s) void {
    print(s.len);
    del(s);
}

fn main() i32 {
    i32 mut@ own a = new(i32, 3);
    a[0] = 7;
    i32 mut@ own b = move(a);
    println(b.len, " ", b[0]);
    point mut* own p = new(point);
    p->x = 5;
    point* own q = move(p);
    println(q->x);
    i32@ own c = new(i32, 2);
    i32@ own d = move(c);
    println(d.len);
    consume(move(b));
    println(" done");
    del(d);
    del(q);
    return 0;
}
