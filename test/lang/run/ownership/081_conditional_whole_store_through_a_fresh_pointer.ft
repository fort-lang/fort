//! run
//! stdout:
//| 4
//| 9
// The two arms of a conditional whole store through the fresh pointer `p` store through one
// address that the lowering holds (spec/fir.md 11). The test of each store reads that address as
// `*p`, and `new` made `p->data` empty (D17.11 gen rule 5), so each arm passes. Each arm moves
// one source, and the `del` of the other source releases its allocation.
struct box {
    u8 mut* own data;
}

fn fill(u8 v) box {
    box mut b = box{};
    b.data = new(u8);
    *b.data = v;
    return b;
}

fn pick(bool c) void {
    box mut x = fill(4);
    box mut y = fill(9);
    box mut* own p = new(box);
    *p = c ? move(x) : move(y);
    println(*p->data);
    del(p->data);
    del(p);
    del(x.data);
    del(y.data);
}

fn main() i32 {
    pick(true);
    pick(false);
    return 0;
}
