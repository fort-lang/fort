//! run
//! stdout:
//| 3 0 true
//| true
//| 2 true
//| 5 0
// del of an lvalue frees and empties it, so a second del is a no-op and the slot may be refilled
// (D17.9, D17.11). This holds through a mutable indirection and on an immutable binding;
// del(null) with the literal is a no-op too.
struct Node {
    i32 value;
    own mut Node* next;
}

fn i32 main() {
    own mut i32[] s = new(i32[3]);
    u64 before = s.len;
    del(s);
    del(s);
    println(before, " ", s.len, " ", s.ptr == null);
    own mut Node* n = new(Node);
    del(n);
    del(n);
    del(null);                                // the literal adopts own void*
    println(n == null);
    own mut Node* head = new(Node);
    head->next = new(Node);
    head->next->value = 2;
    i32 v = head->next->value;
    del(head->next);
    println(v, " ", head->next == null);
    head->next = new(Node);                   // the slot is empty, so the store is allowed
    head->next->value = 5;
    own i32[] r = new(i32[1]);
    del(r);                                   // emptying needs no mut on the binding
    println(head->next->value, " ", r.len);
    del(head->next);
    del(head);
    return 0;
}
