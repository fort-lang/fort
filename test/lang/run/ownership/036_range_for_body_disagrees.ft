//! run
// The fixed array has two elements. The iterations free a once, because a second del of
// the empty a frees nothing (D17.9).
fn main() i32 {
    i32 mut* own a = new(i32);
    i32[2] mut xs = {1, 2};
    for (i32 x : xs) {
        del(a);
    }
    del(a);                                   // a loop of no iteration leaves a full
    return 0;
}
