//! run
//! stdout:
//| case 1
//| case 2
//| freed 4
// D17.14: Switch-local allocations transfer to drop. The body defer releases body on break or
// continue.
i32 mut freed = 0;

fn drop(i32 mut* own p) void {
    del(p);
    freed += 1;
}

fn main() i32 {
    i32 mut i = 0;
    while (i < 2) {
        i += 1;
        i32 mut* own body = new(i32);
        defer drop(move(body));
        switch (i) {
        case 1:
            i32 mut* own here = new(i32);
            println("case 1");
            drop(move(here));
            break;
        default:
            i32 mut* own other = new(i32);
            println("case 2");
            drop(move(other));
            continue;
        }
    }
    println("freed ", freed);
    return 0;
}
