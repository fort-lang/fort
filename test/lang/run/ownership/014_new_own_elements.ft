//! run
//! stdout:
//| 3 true true true
//| 1 2 true
//| true 3
//| 0
// new(T* own[n]) yields own mut T* own[] whose slots are null (D17.3, D10.2): the slots take
// owned nodes, each node is freed on its own through the mutable slot, and the slice last.
struct node {
    i32 value;
}

fn i32 main() {
    u64 n = 3;
    own mut node* own[] kids = new(node* own[n]);
    println(kids.len, " ", kids[0] == null, " ", kids[1] == null, " ", kids[2] == null);
    kids[0] = new(node);
    kids[1] = new(node);
    kids[0]->value = 1;
    kids[1]->value = 2;
    del(kids[2]);                             // an empty slot: no-op
    println(kids[0]->value, " ", kids[1]->value, " ", kids[2] == null);
    for (mut u64 i = 0; i < kids.len; i++) {
        del(kids[i]);                         // the slots are mutable, so del empties each
    }
    println(kids[0] == null, " ", kids.len);
    del(kids);
    println(kids.len);
    return 0;
}
