//! run
//! abort
//! stderr: runtime error: overwriting owned value
//! stdout:
//| before 1
// Storing over an own reference that still holds a live allocation is a runtime error in checked
// builds (D17.11, D11.4); the old allocation would leak.
fn i32 main() {
    own mut i32* p = new(i32);
    *p = 1;
    i32* old = p;
    println("before ", *p);
    p = new(i32);
    println("after ", *p, " ", *old);
    del(p);
    return 0;
}
