//! run
//! abort
//! stderr: run/ownership/012_overwrite_checked.ft:22:7: runtime error: overwriting owned value
//! stdout:
//| making 1
//| before 1
//| making 2
// Storing over an own reference that still holds a live allocation is a runtime error in checked
// builds (D17.11, D11.4): the old allocation would leak. The check runs after the right-hand
// side is evaluated, immediately before the store, and is reported at the `=` token, so the
// output of make(2) appears before the abort and "after" never does.
fn i32 mut* own make(i32 v) {
    i32 mut* own p = new(i32);
    *p = v;
    println("making ", v);
    return p;
}

fn i32 main() {
    i32 mut* own mut p = make(1);
    println("before ", *p);
    p = make(2);
    println("after ", *p);
    del(p);
    return 0;
}
