//! run
//! stdout:
//| 0 1 2
//| freed 3
//| kept 1
// D17.14: Each body defer releases p. The main defer releases outer.
i32 mut freed = 0;
i32 mut kept = 0;

fn drop(i32 mut* own p) void {
    del(p);
    freed += 1;
}

fn hold(i32 mut* own p) void {
    del(p);
    kept += 1;
}

fn main() i32 {
    i32 mut* own outer = new(i32);
    bool c = false;
    if (c) {
        println("never");
    }
    i32 mut warm = 0;
    while (warm < 1) {
        warm += 1;
    }
    defer hold(move(outer));
    for (i32 mut i = 0; i < 3; i += 1) {
        i32 mut* own p = new(i32);
        defer drop(move(p));
        *p = i;
        print(*p);
        if (i < 2) {
            print(" ");
        }
    }
    println();
    println("freed ", freed);
    println("kept ", kept + 1);
    return 0;
}
