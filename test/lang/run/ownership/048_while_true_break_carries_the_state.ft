//! run
//! stdout:
//| 3 true
//| 9 true
// D17.14: The first break releases p. The second loop fills empty p, followed by final cleanup.
fn main() i32 {
    i32 mut* own mut p = new(i32);
    *p = 3;
    i32 mut* own mut* pp = &p;
    while (true) {
        println(*p, " ", p != null);
        del(p);
        break;
    }
    while (true) {
        p = new(i32);
        *p = 9;
        break;
    }
    println(*p, " ", *pp != null);
    del(p);
    return 0;
}
