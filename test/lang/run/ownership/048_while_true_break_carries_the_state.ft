//! run
//! stdout:
//| 3 true
//| 9 true
// The first break releases p. The second loop fills the empty p, and the final del
// releases it. The proof of D17.11 also joins the exit edge of `while (true)`, where p is
// live, so the second loop dels the empty p before it fills it.

// The exit edge of the second `while (true)` carries the del of the first loop, so a read of
// p after the loops is a use that D17.21 cannot prove. The read goes through a pointer.
fn value_in(i32 mut* own* q) i32 {
    return **q;
}

fn main() i32 {
    i32 mut* own mut p = new(i32);
    *p = 3;
    i32 mut* own mut* pp = &p;
    while (true) {
        println(*p, " ", p != null);
        del(p);
        break;
    }
    while (true) {
        del(p);
        p = new(i32);
        *p = 9;
        break;
    }
    println(value_in(pp), " ", *pp != null);
    del(p);
    return 0;
}
