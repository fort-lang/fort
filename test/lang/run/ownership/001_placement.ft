//! run
//! stdout:
//| 2 1 7
//| 7 7 true
//| 1 4 104
// An own follows the * or @ whose reference it marks as owning, the outermost one being the
// reference the binding holds (D17.2). Every row of the D17.2 table is here but string own (011)
// and node* mut@ own: new(node mut*, 2) yields node mut* mut@ own, because the element type of
// the result is the element type written, and dropping the pointees' mut behind the mutable
// slots is refused (D5.4).
struct node {
    i32 value;
    node* next;
}

fn make_bytes(u8 mut@ own mut* out, u64 n) void {
    del(*out);                                // the entry value of *out is unknown here
    *out = new(u8, n);
    (*out)[0] = 104;
}

// A read through a pointer: the owner is no local owner here (D17.21).
fn first_byte(u8 mut@ own* b) u8 {
    return (*b)[0];
}

fn main() i32 {
    u8 mut@ own mut bytes = {};               // an own slot for an out-parameter, before a call
    i32 mut@ own buf = new(i32, 2);           // owned span of writable ints
    i32@ own data = new(i32, 1);              // owned span, read-only through this binding
    node mut* own n = new(node);              // owned node
    n->value = 7;
    println(buf.len, " ", data.len, " ", n->value);
    node mut* mut@ own items = new(node mut*, 2); // owned span of borrowed pointers
    items[0] = n;
    node mut* own[2] mut kids = {};           // fixed array of owned nodes
    kids[1] = new(node);
    kids[1]->value = items[0]->value;
    node* own@ view = kids[..];               // borrowed span of owned nodes
    i32 direct = kids[1]->value;              // read before the print call (D17.21)
    println(view[1]->value, " ", direct, " ", view[0] == null);
    node mut* own mut@ own all = new(node mut* own, 1);   // owned span of owned nodes
    del(all[0]);                              // the slot new left null: frees nothing
    all[0] = new(node);
    make_bytes(&bytes, 4);
    println(all.len, " ", bytes.len, " ", first_byte(&bytes));
    del(bytes);
    del(all[0]);
    del(all);
    del(kids[1]);
    del(items);
    del(n);
    del(data);
    del(buf);
    return 0;
}
