//! run
//! stdout:
//| 2 1 7
//| 7 7 true
//| 0 4 104
// Prefix own marks the reference the binding holds; own after * or [] marks the reference that
// suffix introduces (D17.2). Every row of the D17.2 table but own string (test 011) is below.
struct Node {
    i32 value;
    Node* next;
}

fn void make_bytes(mut u8[] own* out, u64 n) {
    *out = new(u8[n]);
    (*out)[0] = 104;
}

fn i32 main() {
    own mut i32[] buf = new(i32[2]);          // owned slice of writable ints
    own i32[] data = new(i32[1]);             // owned slice, read-only through this binding
    own mut Node* n = new(Node);              // owned node
    n->value = 7;
    println(buf.len, " ", data.len, " ", n->value);
    own mut Node*[] items = new(Node*[2]);    // owned slice of borrowed pointers
    items[0] = n;
    mut Node* own[2] kids = {};               // fixed array of owned nodes
    kids[1] = new(Node);
    kids[1]->value = items[0]->value;
    Node* own[] view = kids[..];              // borrowed slice of owned nodes
    println(view[1]->value, " ", kids[1]->value, " ", view[0] == null);
    own mut Node* own[] all = {};             // owned slice of owned nodes, empty here
    own mut u8[] bytes = {};                  // an own slot for an out-parameter
    make_bytes(&bytes, 4);
    println(all.len, " ", bytes.len, " ", bytes[0]);
    del(bytes);
    del(all);
    del(kids[1]);
    del(items);
    del(n);
    del(data);
    del(buf);
    return 0;
}
