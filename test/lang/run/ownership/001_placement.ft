//! run
//! stdout:
//| 2 1 7
//| 7 7 true
//| 1 4 104
// An own follows the * or @ whose reference it marks as owning, the outermost one being the
// reference the binding holds (D17.2). Every row of the D17.2 table is here but string own (011)
// and node* mut@ own: new(node*, 2) yields node mut* mut@ own, and dropping the pointees' mut
// behind the mutable slots is refused (D5.4), so items keeps the mut it was allocated with.
struct node {
    i32 value;
    node* next;
}

fn void make_bytes(u8 mut@ own mut* out, u64 n) {
    *out = new(u8, n);
    (*out)[0] = 104;
}

fn i32 main() {
    i32 mut@ own buf = new(i32, 2);           // owned span of writable ints
    i32@ own data = new(i32, 1);              // owned span, read-only through this binding
    node mut* own n = new(node);              // owned node
    n->value = 7;
    println(buf.len, " ", data.len, " ", n->value);
    node mut* mut@ own items = new(node*, 2); // owned span of borrowed pointers
    items[0] = n;
    node mut* own[2] mut kids = {};           // fixed array of owned nodes
    kids[1] = new(node);
    kids[1]->value = items[0]->value;
    node* own@ view = kids[..];               // borrowed span of owned nodes
    println(view[1]->value, " ", kids[1]->value, " ", view[0] == null);
    node mut* own mut@ own all = new(node* own, 1);   // owned span of owned nodes
    all[0] = new(node);                       // the slot new left null
    u8 mut@ own mut bytes = {};               // an own slot for an out-parameter
    make_bytes(&bytes, 4);
    println(all.len, " ", bytes.len, " ", bytes[0]);
    del(bytes);
    del(all[0]);
    del(all);
    del(kids[1]);
    del(items);
    del(n);
    del(data);
    del(buf);
    return 0;
}
