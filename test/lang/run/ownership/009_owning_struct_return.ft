//! run
//! stdout:
//| 4 0
//| 4 0 true
//| 20
// A struct that contains an own reference is an owning aggregate: returning a local one is an
// implicit move, copying one needs move, and functions take it by pointer (D17.7).
struct buf {
    u8 mut@ own data;
    u64 len;
}

fn buf make(u64 n) {
    buf mut b = {};
    b.data = new(u8, n);
    b.len = n;
    return b;
}

fn void fill(buf mut* b, u8 v) {
    for (u64 mut i = 0; i < b->len; i++) {
        b->data[i] = v;
    }
}

fn u64 total(buf* b) {
    u64 mut t = 0;
    for (u8 v : b->data) {
        t += cast(v, u64);
    }
    return t;
}

fn i32 main() {
    buf a = make(4);
    println(a.len, " ", a.data[0]);
    buf mut b = move(a);
    println(b.len, " ", a.data.len, " ", a.data.ptr == null);
    fill(&b, 5);
    println(total(&b));
    del(b.data);
    return 0;
}
