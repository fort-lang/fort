//! run
//! stdout:
//| 3 0.0
//| 1.5 4.5
//| 4.5 true
//| done
// An owning span of floats moves and is released like any other allocation
// (D17.3, D17.5, D10.3).
fn total_of(f64@ values) f64 {
    f64 mut sum = 0.0;
    for (f64 v : values) {
        sum = sum + v;
    }
    return sum;
}

fn consume(f64 mut@ own values) void {
    println(values[0], " ", total_of(values));
    del(values);
}

fn main() i32 {
    f64 mut@ own values = new(f64, 3);
    println(values.len, " ", values[0]);
    values[0] = 1.5;
    values[1] = 2.0;
    values[2] = 1.0;
    f64 sum = total_of(values);
    consume(move(values));
    println(sum, " ", sum == 4.5);
    println("done");
    return 0;
}
