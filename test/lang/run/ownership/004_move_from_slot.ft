//! run
//! stdout:
//| 1 true
//| 2 true
//| 3 true
// Moving out of a field, an array element or a slice element is allowed when the level that
// holds the value is mutable (D17.6); the slot is left null.
struct node {
    i32 value;
}

struct box {
    own mut node* node;
}

fn own mut node* make(i32 v) {
    own mut node* n = new(node);
    n->value = v;
    return n;
}

fn own mut node* take(mut box* b) {
    return move(b->node);                     // not a local, so the move is written
}

fn i32 main() {
    mut box bx = {};
    bx.node = make(1);
    own mut node* first = take(&bx);
    println(first->value, " ", bx.node == null);
    mut node* own[2] kids = {};
    kids[0] = make(2);
    kids[1] = make(3);
    own mut node* second = move(kids[0]);     // element of a local array
    println(second->value, " ", kids[0] == null);
    mut node* own[] slots = kids[..];         // mutable view of the owned slots
    own mut node* third = move(slots[1]);     // level 1 of slots is mutable
    println(third->value, " ", kids[1] == null);
    del(third);
    del(second);
    del(first);
    return 0;
}
