//! run
//! stdout:
//| 1 true
//| 2 true
//| 3 true
// Moving out of a field, an array element or a slice element is allowed when the level that
// holds the value is mutable (D17.6); the slot is left null.
struct node {
    i32 value;
}

struct box {
    node mut* own node;
}

fn node mut* own make(i32 v) {
    node mut* own n = new(node);
    n->value = v;
    return n;
}

fn node mut* own take(box mut* b) {
    return move(b->node);                     // not a local, so the move is written
}

fn i32 main() {
    box mut bx = {};
    bx.node = make(1);
    node mut* own first = take(&bx);
    println(first->value, " ", bx.node == null);
    node mut* own[2] mut kids = {};
    kids[0] = make(2);
    kids[1] = make(3);
    node mut* own second = move(kids[0]);     // element of a local array
    println(second->value, " ", kids[0] == null);
    node mut* own mut@ slots = kids[..];      // mutable view of the owned slots
    node mut* own third = move(slots[1]);     // level 1 of slots is mutable
    println(third->value, " ", kids[1] == null);
    del(third);
    del(second);
    del(first);
    return 0;
}
