//! run
//! stdout:
//| 1 true
//| 2 true
//| 3 true
// Moving out of a field, an array element or a span element is allowed when the level that
// holds the value is mutable (D17.6); the slot is left null.
struct node {
    i32 value;
}

struct box {
    node mut* own node;
}

fn make(i32 v) node mut* own {
    node mut* own n = new(node);
    n->value = v;
    return n;
}

fn take(box mut* b) node mut* own {
    return move(b->node);                     // not a local, so the move is written
}

fn main() i32 {
    box mut bx = {};
    node mut* own one = make(1);
    del(bx.node);                             // the call can write bx through its address
    bx.node = move(one);
    node mut* own first = take(&bx);
    println(first->value, " ", bx.node == null);
    node mut* own[2] mut kids = {};
    node mut* own two = make(2);
    del(kids[0]);
    kids[0] = move(two);
    node mut* own three = make(3);
    del(kids[1]);
    kids[1] = move(three);
    node mut* own second = move(kids[0]);     // element of a local array
    println(second->value, " ", kids[0] == null);
    node mut* own mut@ slots = kids[..];      // mutable view of the owned slots
    node mut* own third = move(slots[1]);     // level 1 of slots is mutable
    println(third->value, " ", kids[1] == null);
    del(third);
    del(second);
    del(first);
    return 0;
}
