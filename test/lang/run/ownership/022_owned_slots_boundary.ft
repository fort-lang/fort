//! run
//! stdout:
//| 0 true
//| 1 true 5
//| 7 9 2
//| true true 2
//| 0 true
// The boundaries of a span of owned slots (D17.3, D17.6, D17.9): a span of
// zero slots keeps the non-null pointer D10.2 promises and is freed like any
// other, a span of one has the same element as its first and its last, and
// moving out of the first and the last slot leaves each null while the span
// itself stays alive.
struct node {
    i32 value;
}

fn make(i32 v) node mut* own {
    node mut* own n = new(node);
    n->value = v;
    return n;
}

fn main() i32 {
    node mut* own mut@ own none = new(node mut* own, 0);
    println(none.len, " ", none.ptr != null);
    del(none);

    node mut* own mut@ own one = new(node mut* own, 1);
    one[0] = make(5);
    println(one.len, " ", one[0] == one[one.len - 1], " ", one[0]->value);
    del(one[0]);
    del(one);

    node mut* own mut@ own kids = new(node mut* own, 3);
    kids[0] = make(7);
    kids[kids.len - 1] = make(9);
    node mut* own first = move(kids[0]);
    node mut* own last = move(kids[kids.len - 1]);
    println(first->value, " ", last->value, " ", kids.len - 1);
    println(kids[0] == null, " ", kids[2] == null, " ", kids.len - 1);
    del(first);
    del(last);
    del(kids);
    println(kids.len, " ", kids.ptr == null);
    return 0;
}
