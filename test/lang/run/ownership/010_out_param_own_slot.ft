//! run
//! stdout:
//| true 3 7
//| false 3
//| true 11
//| 0 true
// An out-parameter that hands over an allocation is a pointer to an own slot, which the caller
// initializes to {} or null (D13.5, D17.2).
struct node {
    i32 value;
}

fn bool alloc_ints(i32 mut@ own mut* out, u64 n, i32 v) {
    if (n == 0) {
        return false;                         // *out is left as it was
    }
    *out = new(i32, n);
    for (u64 mut i = 0; i < out->len; i++) {
        (*out)[i] = v;
    }
    return true;
}

fn bool alloc_node(node mut* own mut* out, i32 v) {
    *out = new(node);
    (*out)->value = v;
    return true;
}

fn i32 main() {
    i32 mut@ own mut s = {};
    println(alloc_ints(&s, 3, 7), " ", s.len, " ", s[0]);
    println(alloc_ints(&s, 0, 1), " ", s.len);
    node mut* own mut n = null;
    println(alloc_node(&n, 11), " ", n->value);
    del(n);
    del(s);
    println(s.len, " ", n == null);
    return 0;
}
