//! run
//! stdout:
//| true 3 7
//| false 3
//| true 11
//| 0 true
// An out-parameter that hands over an allocation is a pointer to an own slot, which the caller
// initializes to {} or null (D13.5, D17.2).
struct Node {
    i32 value;
}

fn bool alloc_ints(mut i32[] own* out, u64 n, i32 v) {
    if (n == 0) {
        return false;                         // *out is left as it was
    }
    *out = new(i32[n]);
    for (mut u64 i = 0; i < out->len; i++) {
        (*out)[i] = v;
    }
    return true;
}

fn bool alloc_node(mut Node* own* out, i32 v) {
    *out = new(Node);
    (*out)->value = v;
    return true;
}

fn i32 main() {
    own mut i32[] s = {};
    println(alloc_ints(&s, 3, 7), " ", s.len, " ", s[0]);
    println(alloc_ints(&s, 0, 1), " ", s.len);
    own mut Node* n = null;
    println(alloc_node(&n, 11), " ", n->value);
    del(n);
    del(s);
    println(s.len, " ", n == null);
    return 0;
}
