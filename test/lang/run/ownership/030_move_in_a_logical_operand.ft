//! run
//! stdout:
//| true
// The immutable c is true. The call moves a and releases its allocation (D17.5).
fn take(i32 mut* own p) bool {
    del(p);
    return true;
}

fn main() i32 {
    i32 mut* own a = new(i32);
    bool c = true;
    println(c && take(move(a)));
    del(a);                                   // a false c leaves a full
    return 0;
}
