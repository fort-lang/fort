//! run
//! stdout:
//| 3 2 1
//| freed 3
// The reversal keeps every node. `del` is shallow (D17.7), so the cleanup moves next out of
// each node before it releases the node.
struct node {
    i64 value;
    node mut* own next;
}

i32 mut freed = 0;

// Frees the tail of a node that the caller moves in. `del` is shallow, so each node gives up its
// tail before it is freed.
fn node_drop(node mut n) void {
    while (n.next != null) {
        node mut* own gone = move(n.next);
        node mut* own rest = move(gone->next);
        del(gone);
        n.next = move(rest);
    }
}

// Ends a node and its tail that the caller moves in, or nothing for null.
fn node_drop_made(node mut* own p) void {
    if (p == null) {
        return;
    }
    node v = move(*p);
    del(p);
    node_drop(move(v));
}

// Gives back the new head, so that head stays a local that is not memory (D17.11 form 2).
fn push(node mut* own head, i64 v) node mut* own {
    node mut* own fresh = new(node);
    fresh->value = v;
    fresh->next = move(head);
    return fresh;
}

fn main() i32 {
    node mut* own mut head = null;
    head = push(move(head), 3);
    head = push(move(head), 2);
    head = push(move(head), 1);
    node mut* own mut done = null;
    while (head != null) {
        node mut* own step = move(head);
        head = move(step->next);
        del(step->next);                      // frees nothing: the move emptied it
        step->next = move(done);
        done = move(step);
    }
    node* mut walk = done;
    while (walk != null) {
        print(walk->value);
        if (walk->next != null) {
            print(" ");
        }
        walk = walk->next;
    }
    println();
    while (done != null) {
        node mut* own gone = move(done);
        done = move(gone->next);
        del(gone);
        freed += 1;
    }
    del(done);                                // null now: `del` of a null frees nothing
    println("freed ", freed);
    node_drop_made(move(head));               // null now: node_drop_made frees nothing
    return 0;
}
