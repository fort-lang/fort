//! run
//! stdout:
//| 3 2 1
//| freed 3
// D17.16: The reversal preserves nodes. Cleanup moves next out before releasing each node.
struct node {
    i64 value;
    node mut* own next;
}

i32 mut freed = 0;

fn push(node mut* own mut* head, i64 v) void {
    node mut* own fresh = new(node);
    fresh->value = v;
    fresh->next = move(*head);
    *head = move(fresh);
}

fn main() i32 {
    node mut* own mut head = null;
    push(&head, 3);
    push(&head, 2);
    push(&head, 1);
    node mut* own mut done = null;
    while (head != null) {
        node mut* own step = move(head);
        head = move(step->next);
        step->next = move(done);
        done = move(step);
    }
    node* mut walk = done;
    while (walk != null) {
        print(walk->value);
        if (walk->next != null) {
            print(" ");
        }
        walk = walk->next;
    }
    println();
    while (done != null) {
        node mut* own gone = move(done);
        done = move(gone->next);
        del(gone);
        freed += 1;
    }
    del(done);                                // null now: `del` of a null frees nothing
    println("freed ", freed);
    return 0;
}
