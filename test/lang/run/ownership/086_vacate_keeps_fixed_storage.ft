//! run
//! stdout:
//| field 2 5
//| element 3 7
//| swap 4 8
//| local 5 9
//| struct 2 6 1
//| pointer 2 3
// A statement that vacates an owner ends the facts of the places in the storage that the owner
// owned, and keeps the facts of the places in its own fixed storage (`spec/fir.md` 11, Kill). Each
// store here goes into the place that its right side vacates, into a place that an earlier
// statement vacated and that no later statement can reach through a vacated owner, or into a
// field of a struct value that a `move` vacated.
struct row {
    row mut@ own sub;
    u64 tag;
}

struct table {
    row mut@ own rows;
    u64 n;
}

struct both {
    row mut@ own left;
    row mut@ own right;
}

fn row_drop(row mut r) void {
    del(r.sub, row_drop);
}

// The destination is the place that the right side vacates.
fn grow_field(table mut* t, u64 n) void {
    t->rows = regrow(move(t->rows), n);
}

// The same for a field of an element: the `move` vacates no owner on the path to the element.
fn grow_element(table mut* t, u64 i, u64 n) void {
    t->rows[i].sub = regrow(move(t->rows[i].sub), n);
}

// The swap form on an element (D17.11): the new value is complete before the `move` of the old
// one, and the store goes into the place that this `move` vacated.
fn grow_swap(table mut* t, u64 i, u64 n) void {
    row mut* q = &t->rows[i];
    row mut@ own nv = regrow(move(q->sub), n);
    row mut@ own old = move(q->sub);
    q->sub = move(nv);
    del(old, row_drop);
}

// The owner goes into a local first, so the right side of the store vacates no owner on the path
// of its destination.
fn grow_through_local(table mut* t, u64 n) void {
    row mut@ own old = move(t->rows[0].sub);
    row mut@ own more = regrow(move(old), n);
    t->rows[0].sub = move(more);
}

fn main() i32 {
    table mut* own t = new(table);
    t->rows = new(row, 1);
    grow_field(t, 2);
    t->rows[1].tag = 5;
    println("field ", t->rows.len, " ", t->rows[1].tag);
    grow_element(t, 1, 3);
    t->rows[1].sub[2].tag = 7;
    println("element ", t->rows[1].sub.len, " ", t->rows[1].sub[2].tag);
    grow_swap(t, 1, 4);
    t->rows[1].sub[3].tag = 8;
    println("swap ", t->rows[1].sub.len, " ", t->rows[1].sub[3].tag);
    grow_through_local(t, 5);
    t->rows[0].sub[4].tag = 9;
    println("local ", t->rows[0].sub.len, " ", t->rows[0].sub[4].tag);
    // a `move` of a struct value makes each owner field of the local empty
    both mut pair = both{};
    pair.left = new(row, 2);
    pair.right = new(row, 6);
    both kept = move(pair);
    pair.left = new(row, 1);
    pair.right = move(kept.left);
    println("struct ", pair.right.len, " ", kept.right.len, " ", pair.left.len);
    // the same through a pointer: the fields lie in the storage of `*p`, which `p` still owns
    both mut* own p = new(both);
    p->left = new(row, 2);
    both held = move(*p);
    p->left = new(row, 3);
    println("pointer ", held.left.len, " ", p->left.len);
    del(held.left, row_drop);
    del(p->left, row_drop);
    del(held.right, row_drop);
    del(p);
    del(pair.left, row_drop);
    del(pair.right, row_drop);
    del(kept.right, row_drop);
    del(t->rows, row_drop);
    del(t);
    return 0;
}
