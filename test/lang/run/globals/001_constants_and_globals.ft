//! run
//! stdout:
//| 10 hi
//| 0 3
//| 10 true
//| 3 10
i32 LIMIT = 10;
string GREETING = "hi";
i32* LP = &LIMIT;
mut i32 counter = 0;

fn void bump() {
    counter++;
}

fn i32 shadowed() {
    i32 LIMIT = 3;
    return LIMIT;
}

fn i32 main() {
    println(LIMIT, " ", GREETING);
    i32 before = counter;
    bump();
    bump();
    bump();
    println(before, " ", counter);
    println(*LP, " ", LP == &LIMIT);
    println(shadowed(), " ", LIMIT);
    return 0;
}
