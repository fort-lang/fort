//! run
//! stdout:
//| 10 hi
//| 0 3
//| 10 true
//| 3 10
i32 LIMIT = 10;
string GREETING = "hi";
i32* LP = &LIMIT;
i32 mut counter = 0;

fn bump() void {
    counter++;
}

fn shadowed() i32 {
    i32 LIMIT = 3;
    return LIMIT;
}

fn main() i32 {
    println(LIMIT, " ", GREETING);
    i32 before = counter;
    bump();
    bump();
    bump();
    println(before, " ", counter);
    println(*LP, " ", LP == &LIMIT);
    println(shadowed(), " ", LIMIT);
    return 0;
}
