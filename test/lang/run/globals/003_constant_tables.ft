//! run
//! stdout:
//| 21 two
//| red blue
//| 0 3 3
struct point {
    i32 x;
    i32 y;
}

enum color {
    red,
    green,
    blue,
}

point[3] PTS = {{1, 2}, {3, 4}, {5, 6}};
string[3] NAMES = {"zero", "one", "two"};
color[2] CS = {color.red, color.blue};
point ORIGIN = {};
point[2] mut cells = {};

fn void mark(i32 i, i32 v) {
    cells[i].x = v;
}

fn i32 main() {
    i32 mut total = 0;
    for (point p : PTS) {
        total += p.x + p.y;
    }
    println(total, " ", NAMES[2]);
    println(CS[0], " ", CS[1]);
    mark(1, 3);
    println(cells[0].x, " ", cells[1].x, " ", cells[1].x + ORIGIN.x);
    return 0;
}
