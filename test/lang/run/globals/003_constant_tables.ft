//! run
//! stdout:
//| 21 two
//| Red Blue
//| 0 3 3
struct Point {
    i32 x;
    i32 y;
}

enum Color {
    Red,
    Green,
    Blue,
}

Point[3] PTS = {{1, 2}, {3, 4}, {5, 6}};
string[3] NAMES = {"zero", "one", "two"};
Color[2] CS = {Color.Red, Color.Blue};
Point ORIGIN = {};
mut Point[2] cells = {};

fn void mark(i32 i, i32 v) {
    cells[i].x = v;
}

fn i32 main() {
    mut i32 total = 0;
    for (Point p : PTS) {
        total += p.x + p.y;
    }
    println(total, " ", NAMES[2]);
    println(CS[0], " ", CS[1]);
    mark(1, 3);
    println(cells[0].x, " ", cells[1].x, " ", cells[1].x + ORIGIN.x);
    return 0;
}
