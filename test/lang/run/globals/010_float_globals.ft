//! run
//! stdout:
//| 3.5 0.25 0.0
//| 3.5 1.5 2.0
//| 6.0
// A float global is read-only or `mut` like any other, and a `mut` one keeps
// its value across calls (D7.10).
f64 SCALE = 3.5;
f32 STEP = 0.25;
f64 mut total = 0.0;
f32 mut level = 1.5;

fn void add(f64 x) {
    total = total + x;
}

fn i32 main() {
    println(SCALE, " ", STEP, " ", total);
    add(SCALE);
    println(total, " ", level, " ", cast(STEP, f64) * 8.0);
    add(2.5);
    println(total);
    return 0;
}
