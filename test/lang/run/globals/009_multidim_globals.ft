//! run
//! stdout:
//| 1 2 3 4 5 6
//| 0 0 0 0
//| 9 0 4 3
//| 6 3 2
//| 1 4
// A nested array at module level: a constant one goes into read-only memory
// as one initializer, a mutable one into zeroed storage, and a constant may
// read the `.len` of another constant, which indexing is not (D4.6, D7.10).
i32[2][3] TABLE = {{1, 2, 3}, {4, 5, 6}};
i32[2][2] mut COUNTS = {};
u64 CELLS = TABLE.len * TABLE[0].len;

fn void bump(i32 i, i32 j) {
    COUNTS[i][j] = COUNTS[i][j] + 1;
}

fn i32 main() {
    println(TABLE[0][0], " ", TABLE[0][1], " ", TABLE[0][2], " ", TABLE[1][0], " ",
            TABLE[1][1], " ", TABLE[1][2]);
    // A mutable global starts at zero (D7.10).
    println(COUNTS[0][0], " ", COUNTS[0][1], " ", COUNTS[1][0], " ", COUNTS[1][1]);
    COUNTS[0][0] = 9;
    bump(1, 1);
    bump(1, 1);
    bump(1, 1);
    bump(1, 0);
    bump(1, 0);
    bump(1, 0);
    bump(1, 0);
    println(COUNTS[0][0], " ", COUNTS[0][1], " ", COUNTS[1][0], " ", COUNTS[1][1]);
    println(TABLE[1][2], " ", CELLS / 2, " ", TABLE.len);
    // A copy of the constant is a value of its own.
    i32[2][3] mut copy = TABLE;
    copy[0][0] = 100;
    println(TABLE[0][0], " ", TABLE[1][0]);
    return 0;
}
