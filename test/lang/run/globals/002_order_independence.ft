//! run
//! stdout:
//| 12 6
//| 3 4
//| 20
fn i32 main() {
    println(B, " ", A);
    Later l = {3, 4};
    println(l.a, " ", l.b);
    println(helper(l));
    return 0;
}

i32 B = A * 2;
i32 A = 6;

fn i32 helper(Later l) {
    return l.a * l.b + PAD;
}

struct Later {
    i32 a;
    i32 b;
}

i32 PAD = 8;
