//! run
//! stdout:
//| 12 6
//| 3 4
//| 20
fn main() i32 {
    println(B, " ", A);
    later l = {3, 4};
    println(l.a, " ", l.b);
    println(helper(l));
    return 0;
}

i32 B = A * 2;
i32 A = 6;

fn helper(later l) i32 {
    return l.a * l.b + PAD;
}

struct later {
    i32 a;
    i32 b;
}

i32 PAD = 8;
