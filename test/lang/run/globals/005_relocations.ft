//! run
//! stdout:
//| 14 21
//| twice thrice
//| 5 5
//| 9 9
//| true 4
// Module-level data whose initializers hold relocations (D7.10): a table of
// function addresses, a table of string headers and a pointer to a `mut`
// global. Each is a constant the linker fills in, which is what puts it in
// .data.rel.ro rather than .rodata (toolchain.md 6 item 5).
fn twice(i32 x) i32 {
    return x *% 2;
}

fn thrice(i32 x) i32 {
    return x *% 3;
}

// A function type carries no suffix of its own (D3.10, D8.1), so a table of
// function addresses is an array of a struct that holds one.
struct op {
    fn (i32) i32 f;
}

op[2] OPS = {{twice}, {thrice}};
string[2] OP_NAMES = {"twice", "thrice"};
fn (i32) i32 FIRST = twice;

i32 mut total = 0;
i32 mut ticks = 3;
i32 mut* WATCH = &total;

struct pair {
    i32 a;
    i32 b;
}

pair BASE = {9, 9};
pair ECHO = BASE;

fn main() i32 {
    println(OPS[0].f(7), " ", OPS[1].f(7));
    println(OP_NAMES[0], " ", OP_NAMES[1]);
    // The constant holds the global's address, so the write lands in the
    // global itself (D6.7).
    *WATCH = 5;
    println(total, " ", *WATCH);
    // A constant that names another one holds that one's value (D4.6).
    println(ECHO.a, " ", ECHO.b);
    // A `mut` global with a nonzero initializer holds it before main runs.
    ticks++;
    println(FIRST(3) == twice(3), " ", ticks);
    return 0;
}
