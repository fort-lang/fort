//! run
//! stdout:
//| 0 0
//| 3 7 hi
//| bye 3
//| 0
// A `mut` global may own its storage (D17.2): the span below is zero until
// main fills it, the assignment carries the overwrite check of D17.11 over
// the global's own storage, and `del` empties it. The `string` global holds
// its initializer's header before main runs and takes another afterwards.
i32 mut@ own mut pool = {};
i32@ VIEW = {};
string mut greeting = "hi";

fn main() i32 {
    println(pool.len, " ", VIEW.len);
    pool = new(i32, 3);
    pool[0] = 7;
    println(pool.len, " ", pool[0], " ", greeting);
    greeting = "bye";
    println(greeting, " ", pool.len);
    del(pool);
    println(pool.len);
    return 0;
}
