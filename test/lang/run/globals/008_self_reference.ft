//! run
//! stdout:
//| 7 true 7
//| 1 2 true
//| true
// A module-level declaration may hold its own address: D7.10 admits `&` of a
// module-level declaration from any module, this one included, and the value
// of `N` does not depend on the value of `N`, only its address does. The lazy
// resolution of D4.6 therefore closes no cycle here, while `node C = C;`,
// which does need the value, stays the error of fail/globals/002.
struct node {
    i32 v;
    node* next;
}

node N = node{7, &N};
node A = node{1, &B};
node B = node{2, &A};
i32 mut counter = 0;
i32 mut* WATCH = &counter;

fn i32 main() {
    println(N.v, " ", N.next == &N, " ", N.next->v);
    // Two constants may name each other's address in either order.
    println(A.v, " ", A.next->v, " ", B.next->next == &B);
    *WATCH = 3;
    println(counter == 3);
    return 0;
}
