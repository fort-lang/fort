//! run
//! stdout:
//| 1 2 3
//| 0 0 1 2
//| true z green hey
//| 0 5 6
// Constant aggregates that nest (D7.10, D6.5): a struct inside a struct, an
// array whose first element is all-zero while the array is not, and a struct
// holding one member of every scalar kind. Each is read back through the
// storage the constant lives in.
struct inner {
    i32 a;
    i32 b;
}

struct outer {
    inner in;
    i64 n;
}

outer O = {{1, 2}, 3};

struct point {
    i32 x;
    i32 y;
}

point[2] PTS = {{0, 0}, {1, 2}};

enum color {
    red,
    green = 5,
    blue,
}

struct row {
    bool on;
    char tag;
    color hue;
    string name;
}

row R = {true, 'z', color.green, "hey"};
color[3] ALL = {color.red, color.green, color.blue};

fn i32 main() {
    println(O.in.a, " ", O.in.b, " ", O.n);
    println(PTS[0].x, " ", PTS[0].y, " ", PTS[1].x, " ", PTS[1].y);
    println(R.on, " ", R.tag, " ", R.hue, " ", R.name);
    println(cast(ALL[0], i32), " ", cast(ALL[1], i32), " ", cast(ALL[2], i32));
    return 0;
}
