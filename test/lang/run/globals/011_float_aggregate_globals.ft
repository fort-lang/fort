//! run
//! stdout:
//| 1.5 -0.25 2
//| 0.5 1.0 2.0 3
//| 3.5 0.125
//| 0.0 -0.0 true
// A float inside a module-level aggregate: a struct literal and an array
// literal are constant initializers like any other, so their float fields and
// elements are written into the data of the module (D7.10, D4.6).
struct sample {
    f64 value;
    f32 weight;
    i32 tag;
}

sample POINT = sample{1.5, -0.25, 2};
f64[3] STEPS = {0.5, 1.0, 2.0};
f32[2] mut LEVELS = {3.5, 0.125};
// A zero of each sign: the array is not all-zero bytes, so it may not be
// written as a zeroinitializer, which would lose the sign (D6.12).
f64[2] SIGNS = {0.0, -0.0};

fn i32 main() {
    println(POINT.value, " ", POINT.weight, " ", POINT.tag);
    println(STEPS[0], " ", STEPS[1], " ", STEPS[2], " ", STEPS.len);
    println(LEVELS[0], " ", LEVELS[1]);
    println(SIGNS[0], " ", SIGNS[1], " ", SIGNS[0] == SIGNS[1]);
    return 0;
}
