//! run
//! flags: --release
//! abort
//! stderr: src/app.ft:45:11: runtime error: division overflow
//! stdout:
//| src/app.ft:45:11: runtime error: division overflow
//| before
import std.rt;

// This runs std.rt's fail_div_overflow in release mode. In that mode the
// arithmetic does not trap and the compiler does not emit the overwrite
// check of D17.11 (D11.1). A failure line holds the same bytes in both
// modes, because nothing it writes depends on a check. run/stdlib/080 runs
// this entry point in the checked mode, and run/errors/007 holds the C
// entry point to the same text.

string FILE = "src/app.ft";

fn main() i32 {
    u32 line = 45;
    u32 col = 11;
    println(FILE, ":", line, ":", col, ": runtime error: division overflow");
    rt.flush_all();
    rt.print_str(1, "before\n".ptr, 7);
    rt.fail_div_overflow(FILE.ptr, line, col);
}
