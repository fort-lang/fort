//! run
//! flags: --release
//! abort
//! stderr: src/app.ft:16:5: runtime error: enum value -2147483648 is not a member of state
//! stdout:
//| src/app.ft:16:5: runtime error: enum value -2147483648 is not a member of state
//| before
import extern;
import std.rt;

// This runs std.rt's fail_enum in release mode. In that mode the arithmetic
// does not trap and the compiler does not emit the overwrite check of
// D17.11 (D11.1). A failure line holds the same bytes in both modes,
// because nothing it writes depends on a check. run/stdlib/083 runs this
// entry point in the checked mode, and run/errors/022 holds the C entry
// point to the same text.
//
// The compiler emits this call in both modes (toolchain.md 5.1). The value is
// i32's minimum. It reaches the entry point sign-extended to i64.
string FILE = "src/app.ft";
string TYPE = "state";

// C call rt.fail_enum: &FILE[0] names the first byte of the global FILE, no mut global, which the
// literal "src/app.ft" initializes, so its bytes end in the NUL of that literal (D9.8 rule 4,
// D3.7), and fail_enum reads them to that NUL. &TYPE[0] names the global TYPE, no mut global, which
// a literal initializes, and fail_enum reads it to the NUL of that literal (rule 4). The other
// arguments are integers.
fn main() i32 {
    u32 line = 16;
    u32 col = 5;
    i64 v = -2147483648;
    println(FILE, ":", line, ":", col, ": runtime error: enum value ", v,
            " is not a member of ", TYPE);
    rt.flush_all();
    rt.print_str(1, "before\n");
    rt.fail_enum(v, &TYPE[0], &FILE[0], line, col);
}
