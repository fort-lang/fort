//! run
//! flags: --no-bounds-check
//! abort
//! stderr: run/modes/008_overwrite_check_kept.ft:20:7: runtime error: overwriting owned value
//! stdout:
//| 1
// `--no-bounds-check` removes exactly the index and span branches (D10.6), so
// the overwrite check of D17.11 still traps on a store over a live `own`
// value. Only `--release` removes it, which run/ownership/013 shows with the
// same store; here the second `make` runs and then the store aborts.
fn i32 mut* own make(i32 v) {
    i32 mut* own p = new(i32);
    *p = v;
    return p;
}

fn i32 main() {
    i32 mut* own mut p = make(1);
    println(*p);
    p = make(2);
    del(p);
    return 0;
}
