//! run
//! flags: --no-bounds-check
//! stdout:
//| 1
//| 2
// The overwrite rule of D17.11 holds in every build mode, and
// `--no-bounds-check` changes no store into an `own` reference (D10.6). The
// `del` empties `p`, so the store passes and the program runs. With no `del`,
// the store is a compile error in every mode: fail/ownership/050 shows it
// with this flag.
fn make(i32 v) i32 mut* own {
    i32 mut* own p = new(i32);
    *p = v;
    return p;
}

fn main() i32 {
    i32 mut* own mut p = make(1);
    println(*p);
    del(p);
    p = make(2);
    println(*p);
    del(p);
    return 0;
}
