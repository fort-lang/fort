//! run
//! flags: --release
//! abort
//! stderr: src/app.ft:6:13: runtime error: negative allocation count -9223372036854775808
//! stdout:
//| src/app.ft:6:13: runtime error: negative allocation count -9223372036854775808
//| before
import std.rt;

// This runs std.rt's fail_alloc_count in release mode. In that mode the
// arithmetic does not trap and the compiler does not emit the overwrite
// check of D17.11 (D11.1). A failure line holds the same bytes in both
// modes, because nothing it writes depends on a check. run/stdlib/081 runs
// this entry point in the checked mode, and run/errors/010 holds the C
// entry point to the same text.
//
// The count is i64's minimum. No i64 holds its magnitude, so the digits come
// out of an unsigned subtraction that wraps (D11.2). That subtraction is the
// one piece of arithmetic in this module where the two build modes could
// differ. This test is not a copy of run/stdlib/081 for that reason.
string FILE = "src/app.ft";

fn main() i32 {
    u32 line = 6;
    u32 col = 13;
    i64 n = -9223372036854775808;
    println(FILE, ":", line, ":", col, ": runtime error: negative allocation count ", n);
    rt.flush_all();
    rt.print_str(1, "before\n".ptr, 7);
    rt.fail_alloc_count(n, FILE.ptr, line, col);
}
