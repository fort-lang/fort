//! run
//! flags: --release
//! abort
//! stderr: runtime error: out of memory
//! stdout:
//| before
// The release twin of run/errors/034: at -O2 the unused block is still
// requested, because the `calloc` declaration carries `nobuiltin` (D10.8).
fn huge() i64 {
    return 9223372036854775807;
}

fn main() i32 {
    i64 n = huge();
    println("before");
    u8 mut@ own storage = new(u8, n);
    del(storage);
    return 0;
}
