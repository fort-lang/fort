//! run
//! flags: --release
//! abort
//! stderr: 032_regrow_count_below_length_release.ft:18:25: runtime error: regrow count 2 below length 3
//! stdout:
//| before 3
// The release twin of run/errors/040: the runtime makes the test of the count inside its entry,
// so no build mode removes it (D12.2, D19.6).
fn two() u64 {
    return 2;
}

fn main() i32 {
    i32 mut@ own s = new(i32, 3);
    s[2] = 7;
    u64 n = two();
    println("before ", s.len);
    i32 mut@ own less = regrow(move(s), n);
    println(less.len);
    del(less);
    return 0;
}
