//! run
//! flags: --release
//! abort
//! stderr: src/app.ft:8:5: panic:
//! stdout:
//| src/app.ft:8:5: panic:
//| before
import std.rt;

// This runs std.rt's panic in release mode. In that mode the arithmetic does
// not trap and the compiler does not emit the overwrite check of D17.11
// (D11.1). run/stdlib/084 runs this entry point in the checked mode, and
// run/errors/009 holds the C entry point to its text.
//
// The message here is empty. That is the boundary the length test in panic
// guards: the line ends after the space fail_begin wrote, and panic writes no
// byte after it. An empty message is also the one case where the pointer may
// be null, which is why panic never reads it when the length is zero.
string FILE = "src/app.ft";

fn main() i32 {
    u32 line = 8;
    u32 col = 5;
    string empty = {};
    println(FILE, ":", line, ":", col, ": panic:");
    rt.flush_all();
    rt.print_str(1, "before\n".ptr, 7);
    rt.panic(empty.ptr, empty.len, FILE.ptr, line, col);
}
