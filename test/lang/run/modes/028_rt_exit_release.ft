//! run
//! flags: --release
//! exit: 255
//! stdout:
//| flushed by exit
import std.rt;

// This runs std.rt's exit in release mode (D11.1). exit flushes every runtime
// buffer and ends the process with status & 0xFF (D11.6). run/stdlib/088 runs
// it in the checked mode. The status here is -1, and one byte of -1 is 255,
// so the mask narrows a negative value. run/stdlib/088 passes 263 and
// narrows a large positive one.
fn i32 main() {
    string line = "flushed by exit\n";
    rt.print_str(1, line.ptr, line.len);
    rt.exit(-1);
}
