//! run
//! flags: --release
//! abort
//! stderr: src/app.ft:21:4: runtime error: overwriting owned value
//! stdout:
//| src/app.ft:21:4: runtime error: overwriting owned value
//| before
import std.rt;

// This runs std.rt's fail_overwrite in release mode. In that mode the
// arithmetic does not trap and the compiler does not emit the overwrite
// check of D17.11 (D11.1). A failure line holds the same bytes in both
// modes, because nothing it writes depends on a check. run/stdlib/082 runs
// this entry point in the checked mode, and run/errors/025 holds the C
// entry point to the same text.
//
// The compiler does not emit the check that calls this entry point in this
// mode (D17.11). Only a direct call reaches it here, and this test makes
// that call.
string FILE = "src/app.ft";

fn i32 main() {
    u32 line = 21;
    u32 col = 4;
    println(FILE, ":", line, ":", col, ": runtime error: overwriting owned value");
    rt.flush_all();
    rt.print_str(1, "before\n".ptr, 7);
    rt.fail_overwrite(FILE.ptr, line, col);
}
