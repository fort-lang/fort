//! run
//! flags: --release
//! abort
//! stderr: src/app.ft:21:4: runtime error: overwriting owned value
//! stdout:
//| src/app.ft:21:4: runtime error: overwriting owned value
//| before
import std.rt;

// This runs std.rt's fail_overwrite in release mode. In that mode the
// arithmetic does not trap (D11.1). A failure line holds the same bytes in
// both modes, because nothing it writes depends on a check. run/stdlib/082
// runs this function in the checked mode.
//
// The compiler of this tree emits no check that calls this function: the
// emptiness pass proves each store into an `own` reference (D17.11). The
// pinned bootstrap-1 of tools/bootstrap.ref emits such calls, and it builds
// the compiler with this library. Only a direct call reaches it here, and
// this test makes that call.
string FILE = "src/app.ft";

fn main() i32 {
    u32 line = 21;
    u32 col = 4;
    println(FILE, ":", line, ":", col, ": runtime error: overwriting owned value");
    rt.flush_all();
    rt.print_str(1, "before\n");
    rt.fail_overwrite(&FILE[0], line, col);
}
