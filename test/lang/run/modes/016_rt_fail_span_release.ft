//! run
//! flags: --release
//! abort
//! stderr: src/app.ft:2:30: runtime error: span bounds -1..2 out of range for length 3
//! stdout:
//| src/app.ft:2:30: runtime error: span bounds -1..2 out of range for length 3
//| before
import std.rt;

// This runs std.rt's fail_span in release mode. In that mode the arithmetic
// does not trap and the compiler does not emit the overwrite check of
// D17.11 (D11.1). A failure line holds the same bytes in both modes,
// because nothing it writes depends on a check. run/stdlib/076 runs this
// entry point in the checked mode, and run/errors/002 holds the C entry
// point to the same text.
//
// The low bound is negative here. Both bounds are positive in
// run/stdlib/076.
string FILE = "src/app.ft";

fn main() i32 {
    u32 line = 2;
    u32 col = 30;
    i64 lo = -1;
    i64 hi = 2;
    u64 len = 3;
    println(FILE, ":", line, ":", col, ": runtime error: span bounds ", lo, "..", hi,
            " out of range for length ", len);
    rt.flush_all();
    rt.print_str(1, "before\n".ptr, 7);
    rt.fail_span(lo, hi, len, FILE.ptr, line, col);
}
