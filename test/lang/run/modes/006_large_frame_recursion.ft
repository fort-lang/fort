//! run
//! stdout:
//| dcba
//| 4
import extern;
import std.libc;

// The same 64 KiB frame as 005, recursing instead of nesting a fixed chain of
// functions: probing (D10.8) establishes each frame one page at a time, so the
// four frames of sixteen pages each walk down the stack a page at a time
// instead of jumping over the guard page.

fn zero() i64 {
    return 0;
}

// Writes `letter` at the last byte of a 64 KiB frame and prints it after the
// deeper frames printed theirs.
// C call libc.write: &room[i + 65535] keeps the bound of room from element 65535, 1 byte (D9.8 rule
// 2), and the length 1 fits it.
fn descend(u8 letter, i32 depth) i64 {
    u8[65536] mut room = {};
    i64 i = zero();
    room[i + 65535] = letter;
    i64 mut below = 0;
    if (depth > 0) {
        below = descend(letter + 1, depth - 1);
    }
    return below + libc.write(1, &room[i + 65535], 1);
}

fn main() i32 {
    u8 a = 97;
    i64 written = descend(a, 3);
    println();
    println(written);
    return 0;
}
