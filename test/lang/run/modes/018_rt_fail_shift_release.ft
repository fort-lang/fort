//! run
//! flags: --release
//! abort
//! stderr: src/app.ft:3:18: runtime error: shift count -1 out of range for u8
//! stdout:
//| src/app.ft:3:18: runtime error: shift count -1 out of range for u8
//| before
import extern;
import std.rt;

// This runs std.rt's fail_shift in release mode. In that mode the
// arithmetic does not trap and the compiler does not emit the overwrite
// check of D17.11 (D11.1). A failure line holds the same bytes in both
// modes, because nothing it writes depends on a check. run/stdlib/078 runs
// this entry point in the checked mode, and run/errors/005 holds the C
// entry point to the same text.
//
// The count is negative here and the type is narrow. run/stdlib/078 passes a
// positive count and i64.
string FILE = "src/app.ft";
string TYPE = "u8";

// C call rt.fail_shift: &FILE[0] names the first byte of the global FILE, no mut global, which the
// literal "src/app.ft" initializes, so its bytes end in the NUL of that literal (D9.8 rule 4,
// D3.7), and fail_shift reads them to that NUL. &TYPE[0] names the global TYPE, no mut global,
// which a literal initializes, and fail_shift reads it to the NUL of that literal (rule 4). The
// other arguments are integers.
fn main() i32 {
    u32 line = 3;
    u32 col = 18;
    i64 count = -1;
    println(FILE, ":", line, ":", col, ": runtime error: shift count ", count,
            " out of range for ", TYPE);
    rt.flush_all();
    rt.print_str(1, "before\n");
    rt.fail_shift(count, &TYPE[0], &FILE[0], line, col);
}
