//! run
//! flags: --release
//! stdout:
//| true 9223372036854775807
//| true -9223372036854775808
//| false 1
//| false 1
//| true 18446744073709551615
//| false 1
//| false 1
//| 14695981039346656037 9625390261332436968
import std::str;

// str.parse_i64 and str.parse_u64 detect overflow arithmetically, before the
// multiply, so the release build answers exactly as the checked build does
// (D11.1, stdlib.md 2.5): run/stdlib/016 and run/stdlib/018 are the same
// cases with the checks on. str.hash uses the wrapping multiply (D11.2), so
// its values do not depend on the mode either.
fn void signed(string text) {
    i64 mut value = 1;
    bool ok = str.parse_i64(text, &value);
    println(ok, " ", value);
}

fn void unsigned(string text) {
    u64 mut value = 1;
    bool ok = str.parse_u64(text, 10, &value);
    println(ok, " ", value);
}

fn i32 main() {
    signed("9223372036854775807");
    signed("-9223372036854775808");
    signed("9223372036854775808");
    signed("-9223372036854775809");
    unsigned("18446744073709551615");
    unsigned("18446744073709551616");
    unsigned("99999999999999999999999");
    println(str.hash(""), " ", str.hash("foobar"));
    return 0;
}
