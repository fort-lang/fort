//! run
//! flags: --release
//! args: alpha
//! stdout:
//| 0 0
//| -9223372036854775808 -9223372036854775808
//| 9223372036854775807 9223372036854775807
//| 18446744073709551615 18446744073709551615
//| true true
//| false false
//| blue blue
//| ~ ~
//| 0x0 0x0 0xffffffffffffffff
//| hello hello
//| true true
//| false false
//| true true
//| true true true
//| 2 true true
//| buffered
//| done
import extern;
import std.rt;

// This runs std.rt in release mode. In that mode the arithmetic does not trap
// and the compiler does not emit the overwrite check of D17.11 (D11.1). Every
// entry point that formats, compares, allocates or buffers must still give
// the answers run/stdlib/067 to 073 record with the checks on, because none
// of them depends on a check. One piece of arithmetic does depend on
// wrapping: the magnitude of i64's minimum. It is written to wrap in both
// modes (D11.2), so the second line below is where the two modes would
// differ.
//
// The compiler lowers a print to an entry point of this module (D12.2), so
// each line here holds one value written twice: through the builtin, then
// through the entry point beside it, as run/stdlib/067 does.
enum color {
    red,
    blue = 2,
}

// bcmp(3) and bcopy(3) read and write the bytes of a block through a `void*`.
// No cast gives a type to a `void*` (D3.14), so the test gives the block of
// alloc to C as it is.
// C: bcmp, bcmp(3) of glibc and of macOS, <strings.h>; POSIX.1-2001, which POSIX.1-2008 removed.
// writes: nothing; C reads at most n bytes at a and at b. gives: 0 when the n bytes are the same,
// and another int when not; no pointer. keeps: no pointer. calls: no fort function. frees: nothing.
extern fn bcmp(void* a, void* b, u64 n) i32;
// C: bcopy, bcopy(3) of glibc and of macOS, <strings.h>; POSIX.1-2001, which POSIX.1-2008 removed.
// writes: n bytes at destination, which it reads from n bytes at source; the two can overlap.
// gives: no result. keeps: no pointer. calls: no fort function. frees: nothing.
extern fn bcopy(void* source, void mut* destination, u64 n) void;

fn both_i64(i64 v) void {
    print(v, " ");
    rt.flush(1);
    rt.print_i64(1, v);
    rt.print_char(1, '\n');
    rt.flush(1);
}

fn both_u64(u64 v) void {
    print(v, " ");
    rt.flush(1);
    rt.print_u64(1, v);
    rt.print_char(1, '\n');
    rt.flush(1);
}

fn both_bool(bool v) void {
    print(v, " ");
    rt.flush(1);
    rt.print_bool(1, v);
    rt.print_char(1, '\n');
    rt.flush(1);
}

// C call rt.str_eq: start(a) and start(b), which start of this module makes as &s[0] of the string
// parameter, with the bound s.len, or as null when s is empty (D9.8 rule 2); the lengths a.len and
// b.len are the bounds of those strings. str_eq reads a_len bytes of each only when a_len == b_len
// and a_len > 0, so the length fits both.
fn both_eq(string a, string b) void {
    print(a == b, " ");
    rt.flush(1);
    rt.print_bool(1, rt.str_eq(start(a), a.len, start(b), b.len));
    rt.print_char(1, '\n');
    rt.flush(1);
}

// The address of the first byte of s, or null for an empty s. str_eq reads no
// byte of an empty string, and a `.ptr` is no argument of a fort function
// (D3.5).
fn start(string s) char* {
    if (s.len == 0) {
        return null;
    }
    return &s[0];
}

// C call rt.print_enum: table[..], a span of the two rows of the local table (D9.8 rule 2). This
// function stores each name as &"red"[0] or &"blue"[0], which ends in the NUL of its literal (rule
// 4), and no store changes table before the call.
// C call rt.print_ptr: p, null; print_ptr reads no byte at a pointer.
// C call rt.alloc: &"modes.ft"[0], a literal with its NUL (rule 4); the other arguments are
// integers.
// C call bcmp: block, the storage that rt.alloc gave in this function: the gives: of rt.alloc
// states n = 32 zeroed bytes, never null (D9.8 rule 3); cast(&seen, void*) keeps the bound of seen,
// one u8[32] (rule 2). The length n, 32, fits both.
// C call bcopy x2: cast(&seen, void*) or cast(&seen, void mut*), the 32 bytes of seen (rule 2), and
// block, the 32 bytes that rt.alloc gave (rule 3); the length n, 32, fits both.
// C call rt.free: move(block), the allocation that rt.alloc gave, which free takes (A3).
fn main(string@ argv) i32 {
    i64 i64_min = -9223372036854775808;
    u64 u64_max = 18446744073709551615;
    both_i64(0);
    both_i64(i64_min);
    both_i64(9223372036854775807);
    both_u64(u64_max);
    both_bool(true);
    both_bool(false);

    // print_enum reads a table and not a check, so the mode changes nothing
    // here either. The builtin passes the compiler's own table for the same
    // value (D11.7, D7.7).
    rt.enum_member[2] mut table = {};
    table[0].value = cast(color.red, i32);
    table[0].name = &"red"[0];
    table[1].value = cast(color.blue, i32);
    table[1].name = &"blue"[0];
    print(color.blue, " ");
    rt.flush(1);
    rt.print_enum(1, cast(color.blue, i32), table[..]);
    rt.print_char(1, '\n');
    rt.flush(1);

    print('~', " ");
    rt.flush(1);
    rt.print_char(1, '~');
    rt.print_char(1, '\n');
    rt.flush(1);

    // No cast makes a pointer from an integer (D3.14), so the widest text of an address goes
    // through format_hex, which print_ptr calls with the address.
    void* p = null;
    print(p, " ");
    rt.flush(1);
    rt.print_ptr(1, p);
    rt.print_char(1, ' ');
    u8[rt.HEX_MAX] mut hex = {};
    u64 first = rt.format_hex(hex[..], u64_max);
    rt.emit(1, hex[first..]);
    rt.print_char(1, '\n');
    rt.flush(1);

    string greeting = "hello";
    print(greeting, " ");
    rt.flush(1);
    rt.print_str(1, greeting);
    rt.print_char(1, '\n');
    rt.flush(1);

    both_eq("abc", "abc");
    both_eq("abc", "abd");
    string zero = {};
    both_eq(zero, "");

    // alloc still zeroes its block and still never answers null. free still
    // releases what alloc made (D10.2, D10.3). The result is void mut* own in
    // this mode as in the other, so bcopy writes the block through it
    // (D3.11, toolchain.md 5.1).
    u64 n = 32;
    void mut* own block = rt.alloc(1, n, &"modes.ft"[0], 1, 1);
    u8[32] mut seen = {};
    bool zeroed = bcmp(block, cast(&seen, void*), n) == 0;
    seen[n - 1] = 5;
    bcopy(cast(&seen, void*), block, n);
    seen[n - 1] = 0;
    bcopy(block, cast(&seen, void mut*), n);
    println(block != null, " ", zeroed, " ", seen[n - 1] == 5);
    rt.free(move(block));

    // args answers with the span main was given. Only the main that the
    // compiler emits calls args_init (D6.9).
    string@ mine = rt.args();
    println(mine.len, " ", mine.len == argv.len, " ", mine[1] == argv[1]);

    // The buffer still holds bytes back until something flushes it, and
    // print_str of nothing still writes nothing. Both the builtin above and
    // the calls below write into the one buffer of fd 1, so this flush is
    // what puts the line above before the bytes below (D11.5).
    rt.flush(1);
    rt.print_str(1, greeting[0..0]);
    rt.print_str(1, "buffered\n");
    rt.flush_all();
    println("done");
    return 0;
}
