//! run
//! flags: --release
//! args: alpha
//! stdout:
//| 0 0
//| -9223372036854775808 -9223372036854775808
//| 9223372036854775807 9223372036854775807
//| 18446744073709551615 18446744073709551615
//| true true
//| false false
//| blue blue
//| ~ ~
//| 0xffffffffffffffff 0xffffffffffffffff
//| hello hello
//| true true
//| false false
//| true true
//| true true true
//| 2 true true
//| buffered
//| done
import std.rt;

// This runs std.rt in release mode. In that mode the arithmetic does not trap
// and the compiler does not emit the overwrite check of D17.11 (D11.1). Every
// entry point that formats, compares, allocates or buffers must still give
// the answers run/stdlib/067 to 073 record with the checks on, because none
// of them depends on a check. One piece of arithmetic does depend on
// wrapping: the magnitude of i64's minimum. It is written to wrap in both
// modes (D11.2), so the second line below is where the two modes would
// differ.
//
// The compiler lowers a print to an entry point of this module (D12.2), so
// each line here holds one value written twice: through the builtin, then
// through the entry point beside it, as run/stdlib/067 does.
enum color {
    red,
    blue = 2,
}

rt.enum_member[2] mut table = {};

fn both_i64(i64 v) void {
    print(v, " ");
    rt.flush(1);
    rt.print_i64(1, v);
    rt.print_char(1, '\n');
    rt.flush(1);
}

fn both_u64(u64 v) void {
    print(v, " ");
    rt.flush(1);
    rt.print_u64(1, v);
    rt.print_char(1, '\n');
    rt.flush(1);
}

fn both_bool(bool v) void {
    print(v, " ");
    rt.flush(1);
    rt.print_bool(1, v);
    rt.print_char(1, '\n');
    rt.flush(1);
}

fn both_eq(string a, string b) void {
    print(a == b, " ");
    rt.flush(1);
    rt.print_bool(1, rt.str_eq(a.ptr, a.len, b.ptr, b.len));
    rt.print_char(1, '\n');
    rt.flush(1);
}

fn main(string@ argv) i32 {
    i64 i64_min = -9223372036854775808;
    u64 u64_max = 18446744073709551615;
    both_i64(0);
    both_i64(i64_min);
    both_i64(9223372036854775807);
    both_u64(u64_max);
    both_bool(true);
    both_bool(false);

    // print_enum reads a table and not a check, so the mode changes nothing
    // here either. The builtin passes the compiler's own table for the same
    // value (D11.7, D7.7).
    table[0].value = cast(color.red, i32);
    table[0].name = "red".ptr;
    table[1].value = cast(color.blue, i32);
    table[1].name = "blue".ptr;
    print(color.blue, " ");
    rt.flush(1);
    rt.print_enum(1, cast(color.blue, i32), &table[0], 2);
    rt.print_char(1, '\n');
    rt.flush(1);

    print('~', " ");
    rt.flush(1);
    rt.print_char(1, '~');
    rt.print_char(1, '\n');
    rt.flush(1);

    void* p = cast(u64_max, void*);
    print(p, " ");
    rt.flush(1);
    rt.print_ptr(1, p);
    rt.print_char(1, '\n');
    rt.flush(1);

    string greeting = "hello";
    print(greeting, " ");
    rt.flush(1);
    rt.print_str(1, greeting.ptr, greeting.len);
    rt.print_char(1, '\n');
    rt.flush(1);

    both_eq("abc", "abc");
    both_eq("abc", "abd");
    string zero = {};
    both_eq(zero, "");

    // alloc still zeroes its block and still never answers null. free still
    // releases what alloc made (D10.2, D10.3). The result is void mut* own in
    // this mode as in the other, so the cast below carries the mark rather
    // than adding one (D3.11, toolchain.md 5.1).
    u64 n = 32;
    void mut* own block = rt.alloc(1, n, "modes.ft".ptr, 1, 1);
    u8 mut@ bytes = cast(block, u8 mut*)[0..n];
    bool mut zeroed = true;
    for (u64 mut i = 0; i < n; i++) {
        if (bytes[i] != 0) {
            zeroed = false;
        }
    }
    bytes[n - 1] = 5;
    println(block != null, " ", zeroed, " ", bytes[n - 1] == 5);
    rt.free(move(block));

    // args_init and args answer with the span main was given. The first manual
    // call releases the runtime storage behind argv. Save the values that the
    // test needs later. The saved string header still points at process bytes,
    // which args_init does not own. The second call is the one the overwrite
    // check refuses in the other mode, unless args_init releases what the first
    // call allocated (D17.11).
    u64 saved_argc = argv.len;
    string saved_arg = argv[1];
    char*[2] mut raw = {};
    for (u64 mut i = 0; i < saved_argc; i++) {
        raw[i] = argv[i].ptr;
    }
    rt.args_init(cast(saved_argc, i32), &raw[0]);
    rt.args_init(cast(saved_argc, i32), &raw[0]);
    string@ mine = rt.args();
    println(mine.len, " ", mine.len == saved_argc, " ", mine[1] == saved_arg);

    // The buffer still holds bytes back until something flushes it, and
    // print_str of nothing still writes nothing. Both the builtin above and
    // the calls below write into the one buffer of fd 1, so this flush is
    // what puts the line above before the bytes below (D11.5).
    rt.flush(1);
    rt.print_str(1, greeting.ptr, 0);
    rt.print_str(1, "buffered\n".ptr, 9);
    rt.flush_all();
    println("done");
    return 0;
}
