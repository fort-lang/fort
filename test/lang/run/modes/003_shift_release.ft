//! run
//! flags: --release
//! stdout:
//| -2147483648 -2147483648 -2147483648
//| 0 -128 128
fn thirty_one() i32 {
    return 31;
}

fn main() i32 {
    i32 one = 1;
    i32 n = thirty_one();
    i32 folded = cast(1 << 31, i32);   // untyped 2147483648, i64 by default, truncated
    println(folded, " ", one << 31, " ", one << n);
    i32 top = -2147483648;
    i8 small = 64;
    u8 byte = 1;
    println(top << 1, " ", small << 1, " ", byte << 7);
    return 0;
}
