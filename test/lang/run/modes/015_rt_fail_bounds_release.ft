//! run
//! flags: --release
//! abort
//! stderr: src/app.ft:1:1: runtime error: index -1 out of range for length 0
//! stdout:
//| src/app.ft:1:1: runtime error: index -1 out of range for length 0
//| before
import extern;
import std.rt;

// This runs std.rt's fail_bounds in release mode. In that mode the
// arithmetic does not trap and the compiler does not emit the overwrite
// check of D17.11 (D11.1). A failure line holds the same bytes in both
// modes, because nothing it writes depends on a check. run/stdlib/075 runs
// this entry point in the checked mode, and run/errors/001 holds the C
// entry point to the same text.
//
// The values sit at the other end of the message. The index is negative, so
// it prints with a sign. The length is zero, the shortest number there is.
string FILE = "src/app.ft";

// C call rt.fail_bounds: &FILE[0] names the first byte of the global FILE, no mut global, which the
// literal "src/app.ft" initializes, so its bytes end in the NUL of that literal (D9.8 rule 4,
// D3.7), and fail_bounds reads them to that NUL. The other arguments are integers.
fn main() i32 {
    u32 line = 1;
    u32 col = 1;
    i64 index = -1;
    u64 len = 0;
    println(FILE, ":", line, ":", col, ": runtime error: index ", index,
            " out of range for length ", len);
    rt.flush_all();
    rt.print_str(1, "before\n");
    rt.fail_bounds(index, len, &FILE[0], line, col);
}
