//! run
//! stdout:
//| 1 3 5
//| h o 5
//| 2 1 3
//| ell 5 3
// The twin of 004: the same source without `--no-bounds-check`. Bounds checks
// are performed on every index and span operation in every build mode (D10.6),
// and an in-range program prints what its unchecked twin prints.
fn i64 first() {
    return 0;
}

fn i32 main() {
    i32[3] a = {1, 3, 5};
    i64 i = first();
    println(a[i], " ", a[i + 1], " ", a[i + 2]);
    string s = "hello";
    u64 k = 0;
    println(s[k], " ", s[k + 4], " ", s.len);
    i32@ sp = a[i..i + 2];
    println(sp.len, " ", sp[0], " ", sp[1]);
    string t = s[k + 1..k + 4];
    println(t, " ", s[..].len, " ", s[k + 2..].len);
    return 0;
}
