//! run
//! flags: --release
//! abort
//! stderr: src/app.ft:6:5: assertion failed: a[i] > 0 && *p != null
//! stdout:
//| src/app.ft:6:5: assertion failed: a[i] > 0 && *p != null
//| before
import extern;
import std.rt;

// This runs std.rt's assert_fail in release mode. In that mode the
// arithmetic does not trap and the compiler does not emit the overwrite
// check of D17.11 (D11.1). A failure line holds the same bytes in both
// modes, because nothing it writes depends on a check. run/stdlib/085 runs
// this entry point in the checked mode, and run/errors/008 holds the C
// entry point to the same text.
//
// assert runs in both build modes (D12.2), so this entry point is reached in
// this one too. The text is the source of the expression, byte for byte, with
// every operator and space.
string FILE = "src/app.ft";

// C call rt.assert_fail: &FILE[0] names the first byte of the global FILE, no mut global, which the
// literal "src/app.ft" initializes, so its bytes end in the NUL of that literal (D9.8 rule 4,
// D3.7), and assert_fail reads them to that NUL. &text[0] names the local text, which a literal
// initializes and which no store changes, and assert_fail reads it to the NUL of that literal (rule
// 4).
fn main() i32 {
    u32 line = 6;
    u32 col = 5;
    string text = "a[i] > 0 && *p != null";
    println(FILE, ":", line, ":", col, ": assertion failed: ", text);
    rt.flush_all();
    rt.print_str(1, "before\n");
    rt.assert_fail(&text[0], &FILE[0], line, col);
}
