//! run
//! flags: --release
//! stdout:
//| start
//| -2147483648 255 2
fn imax() i32 {
    return 2147483647;
}

fn zero() u8 {
    return 0;
}

fn thirty_three() i32 {
    return 33;
}

fn main() i32 {
    println("start");
    i32 mut big = imax();
    big++;
    u8 mut small = zero();
    small--;
    u32 one = 1;
    i32 count = thirty_three();
    println(big, " ", small, " ", one << count);
    return 0;
}
