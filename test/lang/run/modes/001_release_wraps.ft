//! run
//! flags: --release
//! stdout:
//| start
//| -2147483648 255 2
fn i32 imax() {
    return 2147483647;
}

fn u8 zero() {
    return 0;
}

fn i32 thirty_three() {
    return 33;
}

fn i32 main() {
    println("start");
    mut i32 big = imax();
    big++;
    mut u8 small = zero();
    small--;
    u32 one = 1;
    i32 count = thirty_three();
    println(big, " ", small, " ", one << count);
    return 0;
}
