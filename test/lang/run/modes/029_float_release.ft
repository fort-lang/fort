//! run
//! flags: --release
//! stdout:
//| 9.5 3.75 inf nan
//| 2147483647 0 -2.5
// A float operation is the same instruction in both build modes: nothing
// traps, so release mode removes no check from it and the answers are the
// ones the checked build gives (D6.12, D11.1).
fn i32 main() {
    f64 a = 7.5;
    f64 b = 2.0;
    f64 zero = 0.0;
    println(a + b, " ", a / b, " ", a / zero, " ", zero / zero);
    f64 big = 1e20;
    println(cast(big, i32), " ", cast(zero / zero, u8), " ", -2.5);
    return 0;
}
