//! run
//! flags: --no-bounds-check
//! stdout:
//| 1 3 5
//| h o 5
// `--no-bounds-check` removes exactly the index and span branches and keeps
// the `inbounds` of every getelementptr (D10.6, toolchain.md 6 item 16), so
// an in-range program behaves as it does without the flag.
fn i64 first() {
    return 0;
}

fn i32 main() {
    i32[3] a = {1, 3, 5};
    i64 i = first();
    println(a[i], " ", a[i + 1], " ", a[i + 2]);
    string s = "hello";
    u64 k = 0;
    println(s[k], " ", s[k + 4], " ", s.len);
    return 0;
}
