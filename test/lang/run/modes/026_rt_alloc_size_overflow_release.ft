//! run
//! flags: --release
//! abort
//! stderr: src/app.ft:5:14: runtime error: allocation size overflow
//! stdout:
//| src/app.ft:5:14: runtime error: allocation size overflow
//| before
import std.rt;

// This runs std.rt's alloc size guard in release mode. In that mode the
// arithmetic does not trap and the compiler does not emit the overwrite
// check of D17.11 (D11.1). A failure line holds the same bytes in both
// modes, because nothing it writes depends on a check. run/stdlib/086 runs
// this entry point in the checked mode, and run/errors/011 holds the C
// entry point to the same text.
//
// The guard is a comparison and a division. It is not a check that the mode
// removes, so alloc refuses the same product here.
string FILE = "src/app.ft";

fn main() i32 {
    u32 line = 5;
    u32 col = 14;
    u64 elem_size = 16;
    u64 count = 1152921504606846976;
    println(FILE, ":", line, ":", col, ": runtime error: allocation size overflow");
    rt.flush_all();
    rt.print_str(1, "before\n".ptr, 7);
    void mut* own p = rt.alloc(elem_size, count, FILE.ptr, line, col);
    rt.free(move(p));
    return 0;
}
