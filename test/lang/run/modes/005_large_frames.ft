//! run
//! stdout:
//| abcd
//| 4
import extern;
import std.libc;

// These frames are larger than one page. Linux requests the inline-asm probe.
// Mac requests the Darwin stack probe (D10.8). Each function holds a 64 KiB
// array. Four such frames nest without passing over the stack guard page.
// The array's address leaves the function through `libc.write`, so the frame is
// real whatever the optimizer does with the body.

fn zero() i64 {
    return 0;
}

// Writes `letter` at the last byte of a 64 KiB frame, prints it, and returns
// one more than what the frame below it returned.
// C call libc.write: &room[i + 65535] keeps the bound of room from element 65535, 1 byte (D9.8 rule
// 2), and the length 1 fits it.
fn deep4(u8 letter) i64 {
    u8[65536] mut room = {};
    i64 i = zero();
    room[i + 65535] = letter;
    i64 w = libc.write(1, &room[i + 65535], 1);
    return w;
}

// C call libc.write: &room[i + 65535] keeps the bound of room from element 65535, 1 byte (D9.8 rule
// 2), and the length 1 fits it.
fn deep3(u8 letter) i64 {
    u8[65536] mut room = {};
    i64 i = zero();
    room[i + 65535] = letter;
    i64 w = libc.write(1, &room[i + 65535], 1);
    return w + deep4(letter + 1);
}

// C call libc.write: &room[i + 65535] keeps the bound of room from element 65535, 1 byte (D9.8 rule
// 2), and the length 1 fits it.
fn deep2(u8 letter) i64 {
    u8[65536] mut room = {};
    i64 i = zero();
    room[i + 65535] = letter;
    i64 w = libc.write(1, &room[i + 65535], 1);
    return w + deep3(letter + 1);
}

// C call libc.write: &room[i + 65535] keeps the bound of room from element 65535, 1 byte (D9.8 rule
// 2), and the length 1 fits it.
fn deep1(u8 letter) i64 {
    u8[65536] mut room = {};
    i64 i = zero();
    room[i + 65535] = letter;
    i64 w = libc.write(1, &room[i + 65535], 1);
    return w + deep2(letter + 1);
}

fn main() i32 {
    u8 a = 97;
    i64 written = deep1(a);
    println();
    println(written);
    return 0;
}
