//! run
//! stdout:
//| abcd
//| 4
// A chain of frames larger than a page. Every fort definition carries
// "probe-stack"="inline-asm" (D10.8), so the backend establishes such a frame
// one page at a time instead of jumping over the guard page; each function
// here holds a 64 KiB array, which is sixteen pages, and the four frames nest.
// The array's address leaves the function through `write`, so the frame is
// real whatever the optimizer does with the body.
extern fn write(i32 fd, u8* buf, u64 n) i64;

fn zero() i64 {
    return 0;
}

// Writes `letter` at the last byte of a 64 KiB frame, prints it, and returns
// one more than what the frame below it returned.
fn deep4(u8 letter) i64 {
    u8[65536] mut room = {};
    i64 i = zero();
    room[i + 65535] = letter;
    i64 w = write(1, &room[i + 65535], 1);
    return w;
}

fn deep3(u8 letter) i64 {
    u8[65536] mut room = {};
    i64 i = zero();
    room[i + 65535] = letter;
    i64 w = write(1, &room[i + 65535], 1);
    return w + deep4(letter + 1);
}

fn deep2(u8 letter) i64 {
    u8[65536] mut room = {};
    i64 i = zero();
    room[i + 65535] = letter;
    i64 w = write(1, &room[i + 65535], 1);
    return w + deep3(letter + 1);
}

fn deep1(u8 letter) i64 {
    u8[65536] mut room = {};
    i64 i = zero();
    room[i + 65535] = letter;
    i64 w = write(1, &room[i + 65535], 1);
    return w + deep2(letter + 1);
}

fn main() i32 {
    u8 a = 97;
    i64 written = deep1(a);
    println();
    println(written);
    return 0;
}
