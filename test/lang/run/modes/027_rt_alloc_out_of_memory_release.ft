//! run
//! flags: --release
//! abort
//! stderr: src/app.ft:5:14: runtime error: out of memory
//! stdout:
//| src/app.ft:5:14: runtime error: out of memory
//| before
import std.rt;

// This runs std.rt's alloc failure path in release mode. In that mode the
// arithmetic does not trap and the compiler does not emit the overwrite
// check of D17.11 (D11.1). A failure line holds the same bytes in both
// modes, because nothing it writes depends on a check. run/stdlib/087 runs
// this entry point in the checked mode, and run/errors/012 holds the C
// entry point to the same text.
//
// The count is one element under run/modes/026's. It is the largest count
// that does not overflow, so C is what says no.
string FILE = "src/app.ft";

fn i32 main() {
    u32 line = 5;
    u32 col = 14;
    u64 elem_size = 16;
    u64 count = 1152921504606846975;
    println(FILE, ":", line, ":", col, ": runtime error: out of memory");
    rt.fort_rt_flush_all();
    rt.print_str(1, "before\n".ptr, 7);
    void* own p = rt.alloc(elem_size, count, FILE.ptr, line, col);
    rt.free(move(p));
    return 0;
}
