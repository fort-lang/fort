//! run
//! flags: --release
//! abort
//! stderr: src/app.ft:44:9: runtime error: division by zero
//! stdout:
//| src/app.ft:44:9: runtime error: division by zero
//| before
import std.rt;

// This runs std.rt's fail_div_zero in release mode. In that mode the
// arithmetic does not trap and the compiler does not emit the overwrite
// check of D17.11 (D11.1). A failure line holds the same bytes in both
// modes, because nothing it writes depends on a check. run/stdlib/079 runs
// this entry point in the checked mode, and run/errors/006 holds the C
// entry point to the same text.

string FILE = "src/app.ft";

fn main() i32 {
    u32 line = 44;
    u32 col = 9;
    println(FILE, ":", line, ":", col, ": runtime error: division by zero");
    rt.flush_all();
    rt.print_str(1, "before\n".ptr, 7);
    rt.fail_div_zero(FILE.ptr, line, col);
}
