//! run
//! flags: --release
//! stdout:
//| -2147483648 -9223372036854775808
//| 5 5 7 7
//| true true
import std.math;

// math.abs_i32 and math.abs_i64 at the minimum of their type in release mode.
// The negation of the minimum has no answer in the type, so a checked build
// traps there (run/stdlib/101 and 102) and release mode wraps and yields the
// minimum again (D11.1, stdlib.md 2.9).
fn i32 main() {
    i32 min32 = math.I32_MIN;
    i64 min64 = math.I64_MIN;
    println(math.abs_i32(min32), " ", math.abs_i64(min64));

    // Every other value answers the same in both modes.
    println(math.abs_i32(-5), " ", math.abs_i32(5), " ", math.abs_i64(-7), " ",
            math.abs_i64(7));

    // The wrap is the value itself, which is the one case a caller must test
    // for before it calls.
    println(math.abs_i32(min32) == math.I32_MIN, " ",
            math.abs_i64(min64) == math.I64_MIN);
    return 0;
}
