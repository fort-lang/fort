//! run
//! flags: --release
//! abort
//! stderr: src/app.ft:100:7: runtime error: integer overflow
//! stdout:
//| src/app.ft:100:7: runtime error: integer overflow
//| before
import std.rt;

// This runs std.rt's fail_overflow in release mode. In that mode the
// arithmetic does not trap and the compiler does not emit the overwrite
// check of D17.11 (D11.1). A failure line holds the same bytes in both
// modes, because nothing it writes depends on a check. run/stdlib/077 runs
// this entry point in the checked mode, and run/errors/003 holds the C
// entry point to the same text.
//
// Only a checked build calls this entry point. The compiler still compiles it
// into a release program like every other function, and it must still write
// this line.
string FILE = "src/app.ft";

fn i32 main() {
    u32 line = 100;
    u32 col = 7;
    println(FILE, ":", line, ":", col, ": runtime error: integer overflow");
    rt.fort_rt_flush_all();
    rt.print_str(1, "before\n".ptr, 7);
    rt.fail_overflow(FILE.ptr, line, col);
}
