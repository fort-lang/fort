//! run
//! stdout:
//| 7 1
//| 9 7
//| 2 2
i32 X = 7;

fn universe() i32 {
    i32 print = 1;
    i32 X = X;
    println(X, " ", print);
    return X;
}

fn param(i32 X) i32 {
    return X + 2;
}

fn main() i32 {
    universe();
    println(param(X), " ", X);
    {
        i32 k = 2;
        print(k, " ");
    }
    {
        i32 k = 2;
        println(k);
    }
    return 0;
}
