//! run
//! stdout:
//| ell lo hel hello
//| 2 3
//| 0
fn count(string s, char target) i32 {
    i32 mut n = 0;
    for (char c : s) {
        if (c == target) {
            n++;
        }
    }
    return n;
}

fn main() i32 {
    string s = "hello";
    println(s[1..4], " ", s[3..], " ", s[..3], " ", s[..]);
    println(count(s, 'l'), " ", count("banana", 'a'));
    println(s[2..2].len);
    return 0;
}
