//! run
//! stdout:
//| 5 0 true true
//| 3 7 true
//| h o true false
//| ell hello  true
//| true true false
//| 104 101 108 108 111
//| 2 true
// `string` is a header over bytes (D3.7): a literal carries a trailing NUL
// that `len` does not count, a sub-string is a `string` again, `==` compares
// the length and then the bytes, and the zero string equals `""`.
string GREETING = "hello";
string EMPTY = "";

fn first_word(string s) string {
    for (u64 mut i = 0; i < s.len; i++) {
        if (s[i] == ' ') {
            return s[0..i];
        }
    }
    return s;
}

fn main() i32 {
    string s = GREETING;
    println(s.len, " ", EMPTY.len, " ", EMPTY == "", " ", s.ptr != null);

    // A literal with escapes counts bytes, not characters: "a\tb\0c\x7E\n" is
    // seven bytes and an embedded NUL is one of them.
    string escaped = "a\tb";
    string with_nul = "a\tb\0c\x7E\n";
    println(escaped.len, " ", with_nul.len, " ", with_nul[3] == '\0');

    println(s[0], " ", s[s.len - 1], " ", s[1] == 'e', " ", s[1] == 'E');

    // A sub-string is a `string`; the empty range is the empty string.
    println(s[1..4], " ", s[0..s.len], " ", s[2..2], " ", s[0..0] == EMPTY);

    // Equality is by content, so two different allocations of the same bytes
    // compare equal and a prefix does not.
    string other = "hel";
    println(s == "hello", " ", s[0..3] == other, " ", s == other);

    // The bytes seen through `u8@` are the same storage the characters are.
    u8@ bytes = cast(s, u8@);
    println(bytes[0], " ", bytes[1], " ", bytes[2], " ", bytes[3], " ", bytes[4]);

    println(first_word("go home").len, " ", first_word("solo") == "solo");
    return 0;
}
