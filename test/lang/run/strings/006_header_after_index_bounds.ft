//! run
//! stdout:
//| z
//| x
// The index reads the new pointer when both headers have length 4.
// The absent upper bound reads the new length after the lower bound.
string mut s = "abcd";

fn swap_same() i32 {
    s = "wxyz";
    return 3;
}

fn swap_short() i32 {
    s = "wx";
    return 1;
}

fn main() i32 {
    println(s[swap_same()]);
    s = "abcd";
    string tail = s[swap_short()..];
    println(tail);
    return 0;
}
