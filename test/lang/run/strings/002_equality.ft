//! run
//! stdout:
//| true false false true
//| true true
//| true false
//| false true
fn same(string a, string b) bool {
    return a == b;
}

fn main() i32 {
    string s = "hello";
    println(s == "hello", " ", s == "hellO", " ", s == "hell", " ", s != "world");
    string z = {};
    string e = "";
    println(z == "", " ", z == e);
    println(s[0..2] == "he", " ", s[1..] == s);
    char mut@ own buf = new(char, 5);
    buf[0] = 'h';
    buf[1] = 'e';
    buf[2] = 'l';
    buf[3] = 'l';
    buf[4] = 'o';
    string built = cast(buf, string);
    println(built.ptr == s.ptr, " ", same(built, s));
    del(buf);
    return 0;
}
