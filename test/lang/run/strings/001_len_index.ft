//! run
//! stdout:
//| 5 h o
//| true 104
//| 10 4
fn main() i32 {
    string s = "hello";
    println(s.len, " ", s[0], " ", s[4]);
    char c = s[0];
    println(s.ptr != null, " ", cast(c, i32));
    string t = "tab\tand\nnl";
    u64 i = 3;
    println(t.len, " ", cast(t[i], u8) - 5);
    return 0;
}
