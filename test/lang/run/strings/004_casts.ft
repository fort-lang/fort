//! run
//! stdout:
//| 104 111 5
//| h o
//| abc true 3
//| Hi
fn main() i32 {
    string s = "hello";
    u8@ bytes = cast(s, u8@);
    println(bytes[0], " ", bytes[4], " ", bytes.len);
    char@ chars = cast(s, char@);
    println(chars[0], " ", chars[4]);
    char mut@ own buf = new(char, 3);
    buf[0] = 'a';
    buf[1] = 'b';
    buf[2] = 'c';
    string built = cast(buf, string);
    println(built, " ", built == "abc", " ", built.len);
    u8 mut@ own raw = new(u8, 2);
    raw[0] = 72;
    raw[1] = 105;
    string hi = cast(raw, string);
    println(hi);
    del(buf);
    del(raw);
    return 0;
}
