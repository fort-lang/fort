//! run
//! stdout:
//| 0 5 6
//| red green blue
//| blue 3 green
//| true false true
//| -1 0 1
//| -1 255 true
enum color {
    red,
    green = 5,
    blue,
}

enum sign {
    neg = -1,
    zero,
    pos,
}

fn i32 main() {
    println(cast(color.red, i32), " ", cast(color.green, i32), " ", cast(color.blue, i32));
    println(color.red, " ", color.green, " ", color.blue);
    color c = cast(6, color);
    color d = cast(3, color);
    println(c, " ", d, " ", cast(5, color));
    println(c == color.blue, " ", c == d, " ", d != color.red);
    println(cast(sign.neg, i32), " ", cast(sign.zero, i32), " ", cast(sign.pos, i32));
    // The representation is the signed `i32` of D3.1, so a widening cast of a
    // negative member sign-extends and a narrowing one truncates (D3.9).
    sign s = sign.neg;
    println(cast(s, i64), " ", cast(s, u8), " ", cast(s, i32) == -1);
    return 0;
}
