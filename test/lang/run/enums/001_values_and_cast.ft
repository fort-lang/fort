//! run
//! stdout:
//| 0 5 6
//| Red Green Blue
//| Blue 3 Green
//| true false true
//| -1 0 1
enum Color {
    Red,
    Green = 5,
    Blue,
}

enum Sign {
    Neg = -1,
    Zero,
    Pos,
}

fn i32 main() {
    println(cast(Color.Red, i32), " ", cast(Color.Green, i32), " ", cast(Color.Blue, i32));
    println(Color.Red, " ", Color.Green, " ", Color.Blue);
    Color c = cast(6, Color);
    Color d = cast(3, Color);
    println(c, " ", d, " ", cast(5, Color));
    println(c == Color.Blue, " ", c == d, " ", d != Color.Red);
    println(cast(Sign.Neg, i32), " ", cast(Sign.Zero, i32), " ", cast(Sign.Pos, i32));
    return 0;
}
