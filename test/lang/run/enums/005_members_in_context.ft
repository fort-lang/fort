//! run
//! stdout:
//| 4 0 10 11 20
//| idle running stopping done
//| 5 -1 stopping
//| walk: idle running stopping done done
//| labels: quiet busy busy quiet
//| idle 7
//| done true true
//| running done 2
//| idle 0 0
// An enum is an `i32`-sized nominal type (D3.9): it names its members with a
// qualified form, it is a field type, an element type, a parameter and a
// return type, it switches exhaustively (D7.6) and it prints as the member
// name, or as the number when no member matches (D11.7).
enum state {
    idle,
    running = 10,
    stopping,
    done = 20,
}

struct job {
    state where;
    i32 id;
}

fn next(state s) state {
    switch (s) {
    case state.idle:
        return state.running;
    case state.running:
        return state.stopping;
    case state.stopping:
        return state.done;
    case state.done:
        return state.done;
    }
}

fn label(state s) string {
    switch (s) {
    case state.idle, state.done:
        return "quiet";
    default:
        return "busy";
    }
}

state[4] ORDER = {state.idle, state.running, state.stopping, state.done};

fn main() i32 {
    println(sizeof(state), " ", cast(state.idle, i32), " ", cast(state.running, i32), " ",
            cast(state.stopping, i32), " ", cast(state.done, i32));

    // An implicit member takes the previous value plus one, so `stopping` is
    // 11 and the list need not be dense or ordered.
    println(state.idle, " ", state.running, " ", state.stopping, " ", state.done);

    // A value with no member prints as its number.
    println(cast(5, state), " ", cast(-1, state), " ", cast(11, state));

    state mut s = state.idle;
    print("walk:");
    for (i32 mut i = 0; i < 5; i++) {
        print(" ", s);
        s = next(s);
    }
    println();

    print("labels:");
    for (state e : ORDER) {
        print(" ", label(e));
    }
    println();

    job mut j = job{state.idle, 7};
    println(j.where, " ", j.id);
    j.where = state.done;
    println(j.where, " ", j.where == state.done, " ", j.where != state.idle);

    job[2] jobs = {job{state.running, 1}, job{state.done, 2}};
    println(jobs[0].where, " ", jobs[1].where, " ", jobs.len);

    // A zeroed enum holds 0 whether or not 0 is a member, and `{}` zeroes it.
    job mut blank = {};
    println(blank.where, " ", cast(blank.where, i32), " ", blank.id);
    return 0;
}
