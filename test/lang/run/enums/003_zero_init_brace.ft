//! run
//! stdout:
//| Red true 0
//| 0 Green
enum Color {
    Red,
    Green,
}

enum Level {
    Low = 1,
    High = 2,
}

fn i32 main() {
    Color c = {};
    Level l = {};
    println(c, " ", c == Color.Red, " ", cast(l, i32));
    mut Color d = {};
    d = Color.Green;
    println(l, " ", d);
    return 0;
}
