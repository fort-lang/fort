//! run
//! stdout:
//| red true 0
//| 0 green
enum color {
    red,
    green,
}

enum level {
    low = 1,
    high = 2,
}

fn i32 main() {
    color c = {};
    level l = {};
    println(c, " ", c == color.red, " ", cast(l, i32));
    color mut d = {};
    d = color.green;
    println(l, " ", d);
    return 0;
}
