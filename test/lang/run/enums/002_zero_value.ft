//! run
//! stdout:
//| red 0
//| 2 2 high
//| 0 4
// A zeroed enum holds 0 even when 0 is not a member (D3.9), and a member
// casts to and from any integer type.
enum color {
    red,
    green,
}

enum level {
    low = 1,
    high = 2,
}

struct pair {
    color c;
    level l;
}

fn i32 main() {
    pair p = {};
    println(p.c, " ", p.l);
    level h = level.high;
    println(cast(h, u8), " ", cast(h, i64), " ", h);
    level[2] arr = {};
    println(arr[1], " ", sizeof(level));
    return 0;
}
