//! run
//! stdout:
//| Red 0
//| 0 Low
//| 2 2 High
//| 0 4
enum Color {
    Red,
    Green,
}

enum Level {
    Low = 1,
    High = 2,
}

struct Pair {
    Color c;
    Level l;
}

fn i32 main() {
    Pair p = {};
    println(p.c, " ", p.l);
    own mut Level* lp = new(Level);
    println(*lp, " ", cast(1, Level));
    del(lp);
    Level h = Level.High;
    println(cast(h, u8), " ", cast(h, i64), " ", h);
    Level[2] arr = {};
    println(arr[1], " ", sizeof(Level));
    return 0;
}
