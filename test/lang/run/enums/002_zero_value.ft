//! run
//! stdout:
//| red 0
//| 0 low
//| 2 2 high
//| 0 4
enum color {
    red,
    green,
}

enum level {
    low = 1,
    high = 2,
}

struct pair {
    color c;
    level l;
}

fn i32 main() {
    pair p = {};
    println(p.c, " ", p.l);
    level mut* own lp = new(level);
    println(*lp, " ", cast(1, level));
    del(lp);
    level h = level.high;
    println(cast(h, u8), " ", cast(h, i64), " ", h);
    level[2] arr = {};
    println(arr[1], " ", sizeof(level));
    return 0;
}
