//! run
//! stdout:
//| 0 low
// The heap half of the zero value of D3.9: `new` zeroes the storage it
// returns (D10.2), so the enum it holds is 0 even when 0 is not a member.
enum level {
    low = 1,
    high = 2,
}

fn i32 main() {
    level mut* own lp = new(level);
    println(*lp, " ", cast(1, level));
    del(lp);
    return 0;
}
