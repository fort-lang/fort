//! run
//! stdout:
//| 9 1.250e+00
//| 9 1.2
//| 9 1.250e+00
//| 12 1.500000e+00
//| 10 -2.500e+10
import std.str;

// str.format_f64 writes the `%.*e` text of snprintf(3) (stdlib.md 2.5). It returns the length of
// the whole text. A buffer too short for the text gets the part that fits and a NUL, and an empty
// buffer gets no byte, so the text of the call before stays. A precision below 0 gives 6 digits
// after the point.

// The text in `buf` before its NUL.
fn text_of(u8@ buf) string {
    return str.from_cbuf(buf);
}

fn main() i32 {
    u8[32] mut buf = {};
    println(str.format_f64(buf[..], 3, 1.25), " ", text_of(buf[..]));
    u8[4] mut short = {};
    println(str.format_f64(short[..], 3, 1.25), " ", text_of(short[..]));
    println(str.format_f64(buf[..0], 3, 1.25), " ", text_of(buf[..]));
    println(str.format_f64(buf[..], -1, 1.5), " ", text_of(buf[..]));
    println(str.format_f64(buf[..], 3, -2.5e10), " ", text_of(buf[..]));
    return 0;
}
