//! run
//! stdout:
//| 1 Operation not permitted
//| 2 No such file or directory
//| 3 No such process
//| 4 Interrupted system call
//| 5 Input/output error
//| 9 Bad file descriptor
//| 13 Permission denied
//| 17 File exists
//| 20 Not a directory
//| 21 Is a directory
//| 22 Invalid argument
//| 24 Too many open files
//| 25 Inappropriate ioctl for device
//| 28 No space left on device
//| 32 Broken pipe
//| no error: true
//| a negative value: true
import std.os;
import std.strbuf;

// os.error_text gives the strerror(3) text of an errno value (stdlib.md 2.14). The values and
// the texts below are the same in glibc and in the Darwin C library. The value 0 and a negative
// value give a text and no failure.
i32[15] CODES = {1, 2, 3, 4, 5, 9, 13, 17, 20, 21, 22, 24, 25, 28, 32};

// The text of `code` alone in `b`.
fn text(i32 code, strbuf.str_buf mut* b) string {
    strbuf.clear(b);
    os.error_text(code, b);
    return strbuf.view(b);
}

fn main() i32 {
    strbuf.str_buf mut b = strbuf.create();
    defer del(b.data);
    for (i32 code : CODES) {
        println(code, " ", text(code, &b));
    }
    println("no error: ", text(0, &b).len > 0);
    println("a negative value: ", text(-5, &b).len > 0);
    return 0;
}
