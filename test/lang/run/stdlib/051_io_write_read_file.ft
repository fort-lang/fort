//! run
//! stdout:
//| true
//| true 11 hello world
//| true 11 hello world
//| true 22 hello worldhello world
//| true 3 abc
//| true
//| true 0 true
import std.io;
import std.strbuf;

// write_file and read_file are the whole-file pair of stdlib.md 2.4: what one
// wrote, the other returns, read_file adds the contents after what the buffer
// already holds, and a second write_file over the same path truncates it.
fn main() i32 {
    println(io.write_file("t028-io.txt", cast("hello world", u8@)));

    strbuf.str_buf mut buf = strbuf.create();
    defer strbuf.free(&buf);
    println(io.read_file("t028-io.txt", &buf), " ", buf.len, " ", strbuf.view(&buf));
    // The contents are the same bytes whether they are read as text or raw.
    println(io.read_file("t028-io.txt", &buf) && buf.len == 22, " ", buf.len - 11, " ",
            cast(strbuf.bytes(&buf)[11..], string));
    // The second read appended rather than replacing.
    println(buf.len == 22, " ", buf.len, " ", strbuf.view(&buf));

    // A second write truncates: the file is three bytes long afterwards.
    io.write_file("t028-io.txt", cast("abc", u8@));
    strbuf.clear(&buf);
    println(io.read_file("t028-io.txt", &buf), " ", buf.len, " ", strbuf.view(&buf));

    // An empty file is written and read as an empty buffer.
    println(io.write_file("t028-empty.txt", cast("", u8@)));
    strbuf.clear(&buf);
    println(io.read_file("t028-empty.txt", &buf) && buf.len == 0, " ", buf.len, " ",
            strbuf.view(&buf) == "");
    return 0;
}
