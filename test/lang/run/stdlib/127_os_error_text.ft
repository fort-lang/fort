//! run
//! stdout:
//| No such file or directory
//| File exists
//| true
//| true
//| > No such file or directory
import std.libc;
import std.os;
import std.str;
import std.strbuf;

// os.error_text appends the strerror(3) text of an errno value (stdlib.md 2.14). The two texts
// below are the same in glibc and in the Darwin C library. A value that the system does not have
// gives a text that names the value, and no error. The text goes after what the buffer holds.

// The text of `code` alone in `b`.
fn text(i32 code, strbuf.str_buf mut* b) string {
    strbuf.clear(b);
    os.error_text(code, b);
    return strbuf.view(b);
}

fn main() i32 {
    strbuf.str_buf mut b = strbuf.create();
    defer del(b.data);
    println(text(libc.ENOENT, &b));
    println(text(libc.EEXIST, &b));
    string unknown = text(99999, &b);
    println(unknown.len > 0);
    println(str.find(unknown, "99999") >= 0);
    strbuf.clear(&b);
    strbuf.append(&b, "> ");
    os.error_text(libc.ENOENT, &b);
    println(strbuf.view(&b));
    return 0;
}
