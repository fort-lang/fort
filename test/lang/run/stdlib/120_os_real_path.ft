//! run
//! stdout:
//| true
//| true true true
//| true true
//| false true
import std.io;
import std.os;
import std.str;
import std.strbuf;

// os.real_path appends the canonical form of a path: absolute, with `.` and
// `..` resolved (stdlib.md 2.13, D17.13). The test prints no path itself,
// because the temporary directory has another canonical form on each host.
fn main() i32 {
    println(io.write_file("t256-real.txt", cast("x", u8@)));

    strbuf.str_buf mut out = strbuf.create();
    defer strbuf.free(&out);
    bool found = os.real_path("./t256-real.txt", &out);
    string first = strbuf.view(&out);
    println(found, " ", first.len > 0 && first[0] == '/', " ",
            str.ends_with(first, "/t256-real.txt"));

    // A second call appends after what the buffer already holds, and another
    // spelling of the same file gives the same text.
    u64 len = out.len;
    bool again = os.real_path("t256-real.txt", &out);
    println(again, " ", out.len == 2 * len);

    // A missing file makes realpath(3) fail, and the buffer stays unchanged.
    bool missing = os.real_path("t256-missing.txt", &out);
    println(missing, " ", out.len == 2 * len);
    return 0;
}
