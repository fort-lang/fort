//! run
//! stdout:
//| true
//| false
import std.mem;

// mem.can_allocate asks the allocator of the runtime for a size and takes no storage (stdlib.md
// 2.3). A size above the address range of the allocator, near 2 to the power 63, gives false
// where `new` would stop the process.
fn huge() u64 {
    return 9223372036854775807;
}

fn main() i32 {
    println(mem.can_allocate(1048576));
    println(mem.can_allocate(huge()));
    return 0;
}
