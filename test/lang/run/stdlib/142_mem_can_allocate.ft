//! run
//! stdout:
//| true
//| false
import std.mem;

// mem.can_allocate asks calloc(3) for a size and frees the block at once (stdlib.md 2.3). A size
// that no system gives, near 2 to the power 63, gives false where `new` would stop the process.
fn huge() u64 {
    return 9223372036854775807;
}

fn main() i32 {
    println(mem.can_allocate(1048576));
    println(mem.can_allocate(huge()));
    return 0;
}
