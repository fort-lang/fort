//! run
//! stdout:
//| empty false 1
//| minus false 1
//| minusminus false 1
//| plus false 1
//| space_before false 1
//| space_after false 1
//| inner_space false 1
//| underscore false 1
//| hex_prefix false 1
//| trailing_letter false 1
//| leading_letter false 1
//| dot false 1
//| nul false 1
//| high_byte false 1
import std::str;

// Everything parse_i64 rejects: no +, no whitespace, no _, no prefix, no
// trailing text, and at least one digit after the optional - (stdlib.md 2.5).
// A rejected parse leaves *out alone (stdlib.md 1.2), which the 1 shows.
fn void show(string label, string text) {
    i64 mut value = 1;
    bool ok = str.parse_i64(text, &value);
    println(label, " ", ok, " ", value);
}

fn i32 main() {
    show("empty", "");
    show("minus", "-");
    show("minusminus", "--1");
    show("plus", "+1");
    show("space_before", " 1");
    show("space_after", "1 ");
    show("inner_space", "1 2");
    show("underscore", "1_000");
    show("hex_prefix", "0x10");
    show("trailing_letter", "12a");
    show("leading_letter", "a12");
    show("dot", "1.5");
    show("nul", "1\x002");
    show("high_byte", "1\xff");
    return 0;
}
