//! run
//! stdout:
//| true true
//| 4 abcd
//| 4 efgh
//| 2 ijgh
//| 0 0
//| true
import std::io;

// The descriptor level of stdlib.md 2.4: write_all writes every byte it is
// given, read fills at most its buffer and says how many bytes it got, end of
// file is 0, and a buffer of no bytes is answered with 0 and no system call.
fn i32 main() {
    i32 out = io.open_write("t028-fd.txt");
    // Two writes in a row land one after the other in the file.
    bool first = io.write_all(out, cast("abcdef", u8@));
    bool second = io.write_all(out, cast("ghij", u8@));
    println(first && second, " ", io.close(out));

    i32 in = io.open_read("t028-fd.txt");
    // A buffer shorter than the file is filled and no more.
    u8[4] mut small = {};
    i64 a = io.read(in, small[..]);
    println(a, " ", cast(small[..], string));
    i64 b = io.read(in, small[..]);
    println(b, " ", cast(small[..], string));
    // The file is ten bytes long, so the last read returns the two that are
    // left and touches nothing beyond them: the rest of the buffer still
    // holds what the previous read put there.
    i64 c = io.read(in, small[..]);
    println(c, " ", cast(small[..], string));

    // At end of file read answers 0, and an empty buffer answers 0 without
    // asking the operating system at all.
    i64 eof = io.read(in, small[0..0]);
    i64 nothing = io.read(in, small[..]);
    println(eof, " ", nothing);
    println(io.close(in));
    return 0;
}
