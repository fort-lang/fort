//! run
//! abort
//! stderr: panic: sort.sort_i64: null comparator
//! stdout:
//| 1 2 3
import std.sort;

// null is a valid function-pointer value and calling it is undefined (D3.10),
// so the library tests for it and panics (stdlib.md 1.2, 2.10). The message
// names the entry that the program called.
//
// The failing call sorts one element, which the count test alone would let
// through: the test of the comparator comes first (stdlib.md 2.10).
fn main() i32 {
    i64[3] mut xs = {3, 1, 2};
    sort.sort_i64(xs[..], sort.cmp_i64);
    println(xs[0], " ", xs[1], " ", xs[2]);
    sort.sort_i64(xs[0..1], null);
    println("not reached");
    return 0;
}
