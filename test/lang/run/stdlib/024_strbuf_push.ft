//! run
//! stdout:
//| 0 0
//| 1 16 a
//| 2 16 ab
//| 5 16 ab|~!
//| 16 16 ab|~!ccccccccccc
//| 17 32 ab|~!cccccccccccd
import std.strbuf;

// push and push_byte add exactly one byte each and grow the buffer only when
// it is full (stdlib.md 2.6). The first push of an empty buffer is the one
// that takes the capacity from nothing to the floor of 16.
fn i32 main() {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    println(b.len, " ", b.data.len);

    strbuf.push(&b, 'a');
    println(b.len, " ", b.data.len, " ", strbuf.view(&b));
    strbuf.push(&b, 'b');
    println(b.len, " ", b.data.len, " ", strbuf.view(&b));

    // push_byte takes the byte itself, so a character is spelled by its value
    // and a byte with no character name is as easy to write as a letter.
    strbuf.push_byte(&b, 0x7c);
    strbuf.push_byte(&b, cast('~', u8));
    strbuf.push_byte(&b, 33);
    println(b.len, " ", b.data.len, " ", strbuf.view(&b));

    // Filling the last free byte still does not grow; the byte after it does,
    // and the contents survive the move to the new storage.
    u64 mut i = 0;
    while (i < 11) {
        strbuf.push(&b, 'c');
        i += 1;
    }
    println(b.len, " ", b.data.len, " ", strbuf.view(&b));
    strbuf.push(&b, 'd');
    println(b.len, " ", b.data.len, " ", strbuf.view(&b));
    return 0;
}
