//! run
//! exit: 7
//! stdout:
//| buffered, not yet flushed
import std::sys;

// sys.exit flushes every runtime output buffer and terminates with
// status & 0xFF; the deferred statements of the calling function do not run
// (stdlib.md 2.1, D11.5, D11.6).
fn noreturn quit(i32 code) {
    sys.exit(code);
}

fn i32 main() {
    defer println("deferred, must not run");
    print("buffered, not yet flushed\n");
    quit(7);
}
