//! run
//! stdout:
//| 5 5 0 7
//| 2147483647 2147483647 2147483646
//| 9223372036854775807 9223372036854775807 9223372036854775806
//| true true true true
//| -2147483648 -9223372036854775808
import std.math;

// math.abs_i32 and math.abs_i64 (stdlib.md 2.9): `x < 0 ? -x : x`.
//
// The minimum of each type is the case the function cannot answer, since its
// magnitude is one above the maximum. The negation traps there in a checked
// build, which run/stdlib/101 and 102 hold; this test stops one short of it and
// shows that the caller's own test for the minimum is the total function
// stdlib.md 2.9 asks for.
fn abs_or_max(i32 x) i32 {
    if (x == math.I32_MIN) {
        return math.I32_MAX;
    }
    return math.abs_i32(x);
}

fn abs_or_max_i64(i64 x) i64 {
    if (x == math.I64_MIN) {
        return math.I64_MAX;
    }
    return math.abs_i64(x);
}

fn main() i32 {
    // Both signs, zero, and a value that is already positive.
    println(math.abs_i32(-5), " ", math.abs_i32(5), " ", math.abs_i32(0), " ",
            math.abs_i64(-7));

    // One below the minimum of each type, where the magnitude still fits.
    i32 near_min = math.I32_MIN + 1;
    println(math.abs_i32(near_min), " ", math.abs_i32(math.I32_MAX), " ",
            math.abs_i32(math.I32_MAX - 1));
    i64 near_min_i64 = math.I64_MIN + 1;
    println(math.abs_i64(near_min_i64), " ", math.abs_i64(math.I64_MAX), " ",
            math.abs_i64(math.I64_MAX - 1));

    // The guard stdlib.md 2.9 names: the caller tests for the minimum first and
    // the function is then total.
    println(abs_or_max(math.I32_MIN) == math.I32_MAX, " ", abs_or_max(-3) == 3,
            " ", abs_or_max_i64(math.I64_MIN) == math.I64_MAX, " ",
            abs_or_max_i64(-3) == 3);

    // The two values that trap, printed rather than passed, so that this test
    // names them without ending.
    println(math.I32_MIN, " ", math.I64_MIN);
    return 0;
}
