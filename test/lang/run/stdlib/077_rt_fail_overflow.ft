//! run
//! abort
//! stderr: src/app.ft:0:0: runtime error: integer overflow
//! stdout:
//| src/app.ft:0:0: runtime error: integer overflow
//| before
import std.rt;

// + - * ++ -- and unary - call fail_overflow when a checked build finds an
// overflow (D11.1, D11.4). run/errors/003 holds the C entry point to this
// text. The position here is 0:0. A failure before any user code runs carries
// that position, and a decimal loop that stops at zero must still print each
// 0 as one digit.
string FILE = "src/app.ft";

fn i32 main() {
    u32 line = 0;
    u32 col = 0;
    // The C runtime writes the same line. The compiler still lowers every
    // println to it (D12.2). This flushes that line before the fort runtime
    // writes anything, so the two directives above hold one text against both
    // runtimes, the position and every digit included.
    println(FILE, ":", line, ":", col, ": runtime error: integer overflow");
    rt.fort_rt_flush_all();

    // This line stays in the fort runtime's buffer. The failure path calls
    // flush_all, and that call puts the line on stdout before it writes to
    // stderr (D11.4).
    rt.print_str(1, "before\n".ptr, 7);
    rt.fail_overflow(FILE.ptr, line, col);
}
