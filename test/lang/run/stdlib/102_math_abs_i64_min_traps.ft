//! run
//! abort
//! stderr: runtime error: integer overflow
//! stdout:
//| before
import std.math;

// math.abs_i64(I64_MIN) is run/stdlib/101 one width up: the negation of the
// minimum traps in a checked build (D11.1, stdlib.md 2.9).
fn i32 main() {
    i64 x = math.I64_MIN;
    println("before");
    println(math.abs_i64(x));
    return 0;
}
