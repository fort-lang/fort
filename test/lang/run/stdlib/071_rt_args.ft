//! run
//! args: alpha beta
//! stdout:
//| 3 3
//| true true true
//| true true true
//| true true true
//| alpha beta
import std.rt;

// args_init builds the argument span from argv, and args hands it out (D11.6,
// D8.6, stdlib.md 3). The main the compiler emits calls both before it calls
// this main, so main's parameter is already that span. Only that main calls
// args_init (D6.9), so this program compares the span of args with main's
// parameter: the same count, the same lengths and the same element pointers.
// The span views the argv bytes. It does not copy them (D17.3).
fn main(string@ argv) i32 {
    string@ mine = rt.args();
    println(argv.len, " ", mine.len);

    // One line for each element: equal bytes, equal lengths, and the same
    // pointer. The same pointer is what "a view of the runtime's storage"
    // means.
    for (u64 mut i = 0; i < mine.len; i++) {
        println(mine[i] == argv[i], " ", mine[i].len == argv[i].len, " ",
                mine[i].ptr == argv[i].ptr);
    }

    // The two arguments the directive gave, read from the span and written by
    // print_str rather than by the print family. Both go into one buffer, so
    // the flush below is what puts these bytes after the lines above (D11.5).
    rt.flush(1);
    rt.print_str(1, mine[1]);
    rt.print_char(1, ' ');
    rt.print_str(1, mine[2]);
    rt.print_char(1, '\n');
    rt.flush(1);
    return 0;
}
