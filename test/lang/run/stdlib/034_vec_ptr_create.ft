//! run
//! stdout:
//| 0 0 true
//| 0 8 false
//| 0 0 false
//| 0 0 true
//| 0 0 true
import std.vec;

// The three ways a ptr_vec comes into being and the one way it goes away
// (stdlib.md 2.7): ptr_create allocates nothing, ptr_with_cap allocates its
// slots up front, ptr_with_cap(0) allocates a block of no slots (D10.2), and
// ptr_free leaves ptr_vec{} however often it is called.
fn main() i32 {
    vec.ptr_vec mut empty = vec.ptr_create();
    defer vec.ptr_free(&empty);
    println(empty.len, " ", empty.items.len, " ", empty.items.ptr == null);

    vec.ptr_vec mut v = vec.ptr_with_cap(8);
    defer vec.ptr_free(&v);
    println(v.len, " ", v.items.len, " ", v.items.ptr == null);

    vec.ptr_vec mut nothing = vec.ptr_with_cap(0);
    defer vec.ptr_free(&nothing);
    println(nothing.len, " ", nothing.items.len, " ", nothing.items.ptr == null);

    vec.ptr_free(&v);
    println(v.len, " ", v.items.len, " ", v.items.ptr == null);
    vec.ptr_free(&v);
    println(v.len, " ", v.items.len, " ", v.items.ptr == null);
    return 0;
}
