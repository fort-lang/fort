//! run
//! stdout:
//| apple fig pear plum
//| pear apple fig plum
//| plum pear fig apple
//| pear apple fig plum
import std.str;

// The shape stdlib.md 2.10 asks for when the data is owned: the owner stays
// where it is and the sort orders views of it. A string is a view (stdlib.md
// 1.3), and the permutation moves those views and touches no character of the
// buffer behind them. A view is a pointer place, so no `mut` cast gives the
// array to C as bytes, as an argument of an `extern fn` too (D3.14). The sort
// is a typed copy of the pattern of `std.sort` for string elements (stdlib.md
// 2.10), and its comparator reads two elements through `string*`.

fn by_text(string* p, string* q) i32 {
    return str.cmp(*p, *q);
}

fn by_text_down(string* p, string* q) i32 {
    return by_text(q, p);
}

// Sorts `ws` in place by `cmp`: each element moves left past the elements
// that sort after it.
fn sort_views(string mut@ ws, fn (string*, string*) i32 cmp) void {
    for (u64 mut i = 1; i < ws.len; i += 1) {
        string w = ws[i];
        u64 mut j = i;
        while (j > 0 && cmp(&w, &ws[j - 1]) < 0) {
            ws[j] = ws[j - 1];
            j -= 1;
        }
        ws[j] = w;
    }
}

fn show(string@ ws) void {
    for (u64 mut i = 0; i < ws.len; i += 1) {
        if (i > 0) {
            print(" ");
        }
        print(ws[i]);
    }
    println("");
}

fn main() i32 {
    // One allocation holds every word. Nothing below allocates again and the
    // single del at the end frees it once, which is the point of the rule: an
    // array of string own would move four owners.
    string own text = str.dup("pear apple fig plum");
    defer del(text);

    string[4] mut words = {text[0..4], text[5..10], text[11..14], text[15..19]};
    sort_views(words[..], by_text);
    show(words[..]);

    // The buffer behind the views is untouched, so the owner still reads as it
    // was written and the views still point into it.
    println(text);

    sort_views(words[..], by_text_down);
    show(words[..]);
    println(text);
    return 0;
}
