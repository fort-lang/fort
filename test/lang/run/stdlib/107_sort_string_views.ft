//! run
//! stdout:
//| apple fig pear plum
//| pear apple fig plum
//| plum pear fig apple
//| pear apple fig plum
import std.sort;
import std.str;

// The shape stdlib.md 2.10 asks for when the data is owned: the owner stays
// where it is and the sort orders views of it. A string is a view (stdlib.md
// 1.3), sizeof(string) is 16 (D3.15), and the permutation moves those 16-byte
// views and touches no character of the buffer behind them.

fn i32 by_text(void* a, void* b) {
    string* p = cast(a, string*);
    string* q = cast(b, string*);
    return str.cmp(*p, *q);
}

fn i32 by_text_down(void* a, void* b) {
    return by_text(b, a);
}

fn void show(string@ ws) {
    for (u64 mut i = 0; i < ws.len; i += 1) {
        if (i > 0) {
            print(" ");
        }
        print(ws[i]);
    }
    println("");
}

fn i32 main() {
    // One allocation holds every word. Nothing below allocates again and the
    // single del at the end frees it once, which is the point of the rule: an
    // array of string own would have handed four owners to C.
    string own text = str.dup("pear apple fig plum");
    defer del(text);

    string[4] mut words = {text[0..4], text[5..10], text[11..14], text[15..19]};
    sort.sort(cast(words[..].ptr, void*), words.len, sizeof(string), by_text);
    show(words[..]);

    // The buffer behind the views is untouched, so the owner still reads as it
    // was written and the views still point into it.
    println(text);

    sort.sort(cast(words[..].ptr, void*), words.len, sizeof(string), by_text_down);
    show(words[..]);
    println(text);
    return 0;
}
