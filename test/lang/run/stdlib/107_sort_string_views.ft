//! run
//! stdout:
//| apple fig pear plum
//| pear apple fig plum
//| plum pear fig apple
//| pear apple fig plum
import std.str;

// The shape stdlib.md 2.10 asks for when the data is owned: the owner stays
// where it is and the sort orders views of it. A string is a view (stdlib.md
// 1.3), and the permutation moves those views and touches no character of the
// buffer behind them. The sort is a typed copy of sort.sort_i64 for `string`,
// so the comparator reads each view with no cast (D3.14).

// The copy of sort.sort_i64 for string: `i64` is `string` and the prefix is `string_`.
fn string_sort(string mut@ items, fn (string*, string*) i32 cmp) void {
    if (cmp == null) {
        panic("string_sort: null comparator");
    }
    u64 mut start = items.len / 2;
    u64 mut end = items.len;
    while (end > 1) {
        if (start > 0) {
            start -= 1;
        } else {
            end -= 1;
            string last = items[end];
            items[end] = items[0];
            items[0] = last;
        }
        u64 mut at = start;
        while (at < end / 2) {
            u64 mut child = 2 * at + 1;
            if (child + 1 < end && cmp(&items[child], &items[child + 1]) < 0) {
                child += 1;
            }
            if (cmp(&items[at], &items[child]) >= 0) {
                break;
            }
            string parent = items[at];
            items[at] = items[child];
            items[child] = parent;
            at = child;
        }
    }
}

fn by_text(string* p, string* q) i32 {
    return str.cmp(*p, *q);
}

fn by_text_down(string* p, string* q) i32 {
    return by_text(q, p);
}

fn show(string@ ws) void {
    for (u64 mut i = 0; i < ws.len; i += 1) {
        if (i > 0) {
            print(" ");
        }
        print(ws[i]);
    }
    println("");
}

fn main() i32 {
    // One allocation holds every word. Nothing below allocates again and the
    // single del at the end frees it once: the slots hold views, and no slot
    // owns a word.
    string own text = str.dup("pear apple fig plum");
    defer del(text);

    string[4] mut words = {text[0..4], text[5..10], text[11..14], text[15..19]};
    string_sort(words[..], by_text);
    show(words[..]);

    // The buffer behind the views is untouched, so the owner still reads as it
    // was written and the views still point into it.
    println(text);

    string_sort(words[..], by_text_down);
    show(words[..]);
    println(text);
    return 0;
}
