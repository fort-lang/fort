//! run
//! stderr: to stderr through write_all
//! stderr: to stderr through eprintln
//! stdout:
//| 0 1 2
//| true
import std::io;

// The descriptor constants of stdlib.md 2.4 and the descriptor that is not
// buffered: eprint and eprintln go straight out (D11.5), so a write_all to
// STDERR needs no flush before it, unlike the STDOUT pair of 057.
fn i32 main() {
    println(io.STDIN, " ", io.STDOUT, " ", io.STDERR);
    eprintln("to stderr through eprintln");
    println(io.write_all(io.STDERR, cast("to stderr through write_all\n", u8@)));
    return 0;
}
