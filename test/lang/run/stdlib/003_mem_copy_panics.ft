//! run
//! abort
//! stderr: panic: mem.copy: destination too short
//! stdout:
//| before
import std.mem;

// A destination shorter than the source is a violated precondition, so it
// panics rather than reporting a result (stdlib.md 1.2, 2.3, D13.3).
fn i32 main() {
    u8[2] mut buf = {};
    println("before");
    mem.copy(buf[..], cast("abc", u8@));
    println("not reached");
    return 0;
}
