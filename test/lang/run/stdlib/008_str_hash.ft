//! run
//! link: ffi/std_hash.c
//! stdout:
//| 14695981039346656037
//| 12638187200555641996
//| 12638190499090526629
//| 9625390261332436968
//| mirror agrees
import extern;
import std.str;

// str.hash is the 64-bit FNV-1a that stdlib.md 2.5 fixes, so its values are
// part of the contract. The four numbers are the published FNV-1a 64 vectors
// for "", "a", "b" and "foobar" (0xcbf29ce484222325, 0xaf63dc4c8601ec8c,
// 0xaf63df4c8601f1a5, 0x85944171f73967e8), and the last line holds the
// function against an independent C implementation over a wider corpus, so
// the wrapping multiply of D11.2 and the byte order are witnessed twice.
// The C helper takes `const unsigned char*`, which fort spells `u8*`. The `.ptr` of the bytes of s
// is its argument as it stands: no cast takes a `.ptr` (D3.5).
// C: std_fnv1a, test/lang/ffi/std_hash.c, which hashes len bytes at bytes.
// writes: nothing; C reads len bytes at bytes, and no byte when len is 0. gives: a u64 and no
// pointer. keeps: no pointer. calls: no fort function. frees: nothing.
extern fn std_fnv1a(u8* bytes, u64 len) u64;

// C call std_fnv1a: cast(s, u8@).ptr keeps the bound of the string s, and the length s.len fits it
// (D9.8 rule 2).
fn mirror(string s) u64 {
    return std_fnv1a(cast(s, u8@).ptr, s.len);
}

fn agrees(string s) bool {
    if (str.hash(s) == mirror(s)) {
        return true;
    }
    println("disagree on '", s, "': ", str.hash(s), " vs ", mirror(s));
    return false;
}

fn main() i32 {
    println(str.hash(""));
    println(str.hash("a"));
    println(str.hash("b"));
    println(str.hash("foobar"));
    bool mut ok = agrees("") && agrees("a") && agrees("b") && agrees("foobar");
    ok = ok && agrees("http://www.google.com/") && agrees("\x00\x01\xfe\xff");
    ok = ok && agrees("the quick brown fox jumps over the lazy dog");
    // A sub-string hashes as the bytes it covers, not as its backing store.
    string text = "xxfoobaryy";
    ok = ok && str.hash(text[2..8]) == str.hash("foobar");
    if (!ok) {
        return 1;
    }
    println("mirror agrees");
    return 0;
}
