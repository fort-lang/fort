//! run
//! abort
//! stderr: panic: sort.sort_u64: null comparator
//! stdout:
//| 1 2 3
import std.sort;

// null is a valid function-pointer value and calling it is undefined (D3.10),
// so sort_u64 tests for it and panics (stdlib.md 1.2, 2.10).
//
// The failing call sorts no element, which pins the order stdlib.md 2.10
// fixes: the test of the comparator comes before the count, so a call with
// nothing to sort still panics. An implementation that returned early for a
// short span would print nothing more and exit 0, and this test would fail.
fn main() i32 {
    u64[3] mut xs = {3, 1, 2};
    sort.sort_u64(xs[..], sort.cmp_u64);
    println(xs[0], " ", xs[1], " ", xs[2]);
    u64 mut@ none = {};
    sort.sort_u64(none, null);
    println("not reached");
    return 0;
}
