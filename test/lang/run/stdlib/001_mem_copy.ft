//! run
//! stdout:
//| ................
//| abc.............
//| abcabc..........
//| ababcc..........
//| ababcc..........
//| ababcc..........
import std::mem;

// mem.copy moves src.len bytes to the start of dst, with memmove's overlap
// rule, and an empty src is a no-op (stdlib.md 2.3).
fn i32 main() {
    u8[16] mut buf = {};
    mem.fill(buf[..], cast('.', u8));
    println(cast(buf[..], string));
    mem.copy(buf[..], cast("abc", u8@));
    println(cast(buf[..], string));
    // Overlapping, destination above source.
    mem.copy(buf[3..6], buf[0..3]);
    println(cast(buf[..], string));
    // Overlapping, destination below source.
    mem.copy(buf[2..5], buf[3..6]);
    println(cast(buf[..], string));
    // An empty source leaves a long destination alone.
    mem.copy(buf[..], cast("", u8@));
    println(cast(buf[..], string));
    // An empty destination accepts an empty source.
    mem.copy(buf[4..4], cast("", u8@));
    println(cast(buf[..], string));
    return 0;
}
