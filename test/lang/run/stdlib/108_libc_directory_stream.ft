//! run
//! stdout:
//| true
//| false
//| true
import extern;
// A directory stream is an allocation of C (D17.13, stdlib.md 2.2). `opendir` and `fdopendir`
// give it with `own`, and `closedir` takes it with `move`. A stream that fails to open is null,
// and the test against `null` proves it empty on that edge (D17.11), so no exit leaks it
// (D17.20). The root directory holds `.` and `..`, so `readdir` gives two entries at least.
import std.libc;
import std.str;

// The count of the entries of the directory stream `d`.
// C call libc.readdir x2: d is a parameter source (D9.8 rule 1), so entries is a boundary function,
// and each caller gives a directory stream that opendir or fdopendir gave and that closedir has not
// freed. C reads no fort storage.
fn entries(void mut* d) u64 {
    u64 mut n = 0;
    libc.dirent_head* mut e = libc.readdir(d);
    while (e != null) {
        n += 1;
        e = libc.readdir(d);
    }
    return n;
}

// Whether the directory `path` opens and holds two entries at least.
// C call libc.opendir: &c_path[0] names the buffer c_path that str.to_cstr gave, with its NUL (D9.8
// rule 4).
// C call entries: d, the stream that opendir gave in this function, not null (rule 3).
// C call libc.closedir: move(d), the same stream (rule 3).
fn opens(string path) bool {
    char mut@ own c_path = str.to_cstr(path);
    defer del(c_path);
    void mut* own d = libc.opendir(&c_path[0]);
    if (d == null) {
        return false;
    }
    u64 n = entries(d);
    libc.closedir(move(d));
    return n >= 2;
}

// The same through a descriptor: closedir(3) closes the descriptor of `fdopendir` too.
// C call libc.open: &c_path[0] names the buffer c_path that str.to_cstr gave, with its NUL (D9.8
// rule 4).
// C call libc.fdopendir: no pointer argument.
// C call libc.close: no pointer argument.
// C call entries: d, the stream that fdopendir gave in this function, not null (rule 3).
// C call libc.closedir: move(d), the same stream (rule 3).
fn opens_through_descriptor(string path) bool {
    char mut@ own c_path = str.to_cstr(path);
    defer del(c_path);
    i32 fd = libc.open(&c_path[0], libc.O_RDONLY | libc.O_DIRECTORY);
    if (fd < 0) {
        return false;
    }
    void mut* own d = libc.fdopendir(fd);
    if (d == null) {
        libc.close(fd);
        return false;
    }
    u64 n = entries(d);
    libc.closedir(move(d));
    return n >= 2;
}

fn main() i32 {
    println(opens("/"));
    println(opens("/no/such/directory"));
    println(opens_through_descriptor("/"));
    return 0;
}
