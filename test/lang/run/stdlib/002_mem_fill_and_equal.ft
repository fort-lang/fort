//! run
//! stdout:
//| 0 0 0 0 0 0 0 0
//| 7 7 7 7 7 7 7 7
//| 0 0 7 7 7 7 7 7
//| true true false false
//| true true
import std.mem;

// mem.fill sets every byte and mem.equal compares length then bytes; two
// empty spans are equal whatever their pointers (stdlib.md 2.3).
fn void show(u8@ bytes) {
    for (u64 mut i = 0; i < bytes.len; i += 1) {
        if (i > 0) {
            print(" ");
        }
        print(bytes[i]);
    }
    println("");
}

fn i32 main() {
    u8[8] mut buf = {};
    show(buf[..]);
    mem.fill(buf[..], 7);
    show(buf[..]);
    mem.fill(buf[0..2], 0);
    show(buf[..]);
    u8[8] mut other = {};
    mem.fill(other[..], 7);
    mem.fill(other[0..2], 0);
    println(mem.equal(buf[..], other[..]), " ", mem.equal(buf[2..], other[2..]), " ",
            mem.equal(buf[..], other[1..]), " ", mem.equal(buf[..], other[0..7]));
    // Two empty spans taken at unrelated addresses.
    println(mem.equal(buf[0..0], other[5..5]), " ", mem.equal(buf[8..], cast("", u8@)));
    return 0;
}
