//! run
//! abort
//! stderr: panic: sha256.update: message too long
//! stdout:
//| ok
import std.digest.sha256;

// FIPS 180-4 5.1.1 limits a message to less than 2^64 bits, and update counts bytes, so it
// accepts 2^61 - 1 bytes and no more (stdlib.md 2.15). The test sets the byte count of a state
// near the limit. An update that reaches the limit passes, and one more byte panics.
fn main() i32 {
    sha256.state mut s = {};
    sha256.init(&s);
    s.total = 0x1ffffffffffffffe;
    sha256.update(&s, cast("a", u8@));
    println("ok");
    sha256.update(&s, cast("b", u8@));
    println("not reached");
    return 0;
}
