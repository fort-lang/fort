//! run
//! stdout:
//| abc 3
//| 0 true
//| zbc abc
//| consumed: hello
//| done
import std.mem;
import std.str;

// str.dup returns an exact-length heap copy that carries ownership: the
// caller binds it to a string own variable, passes it to a string own
// parameter or dels it (stdlib.md 1.3, 2.5, D13.5, D17.12).
fn void consume(string own taken) {
    println("consumed: ", taken);
    del(taken);
}

fn i32 main() {
    string own copy = str.dup("abc");
    defer del(copy);
    println(copy, " ", copy.len);

    // dup("") is a zero-length but non-null allocation (D10.2).
    string own empty = str.dup("");
    defer del(empty);
    println(empty.len, " ", empty.ptr != null);

    // The copy is independent of the bytes it was made from.
    u8 mut@ own backing = new(u8, 3);
    defer del(backing);
    mem.copy(backing, cast("abc", u8@));
    string view = cast(backing[..], string);
    string own snapshot = str.dup(view);
    defer del(snapshot);
    backing[0] = cast('z', u8);
    println(view, " ", snapshot);

    // An own value may be moved into an own parameter, which then owns it.
    string own given = str.dup("hello");
    consume(move(given));

    println("done");
    return 0;
}
