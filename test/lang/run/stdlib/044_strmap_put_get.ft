//! run
//! stdout:
//| true true true 3
//| 1 2 3
//| false 3
//| 99 2 3
//| false 3 -5
//| true true false 3
import std.strmap;
import std.str;

// put inserts or replaces and says which it did; get and has answer from the
// table (stdlib.md 2.8). A key is compared by its bytes, so a copy of a key
// found the original's entry rather than adding a second one.
fn i32 main() {
    strmap.str_map mut m = strmap.create();
    defer strmap.free(&m);
    println(strmap.put(&m, "one", 1), " ", strmap.put(&m, "two", 2), " ",
            strmap.put(&m, "three", 3), " ", strmap.count(&m));

    i64 mut a = 0;
    i64 mut b = 0;
    i64 mut c = 0;
    strmap.get(&m, "one", &a);
    strmap.get(&m, "two", &b);
    strmap.get(&m, "three", &c);
    println(a, " ", b, " ", c);

    // A second put of a key that is there replaces the value and says the key
    // was not new; the count does not move.
    println(strmap.put(&m, "one", 99), " ", strmap.count(&m));
    strmap.get(&m, "one", &a);
    println(a, " ", b, " ", c);

    // A key with the same bytes in other storage is the same key (D3.7).
    string own copy = str.dup("two");
    defer del(copy);
    println(strmap.put(&m, copy, -5), " ", strmap.count(&m), " ", b - 7);
    i64 mut through_copy = 0;
    strmap.get(&m, "two", &through_copy);
    println(strmap.has(&m, copy), " ", through_copy == -5, " ",
            strmap.has(&m, "missing"), " ", strmap.count(&m));
    return 0;
}
