//! run
//! stdout:
//| true hello
//| true
//| true 42
//| true
//| abcdefgh
import extern;
import std.libc;
import std.mem;

// libc.malloc returns void mut* own, storage of no type the caller may write,
// and libc.free takes void* own, which the result reaches by dropping the mut
// (D3.11, D5.4). The own is erased at the boundary and states C's convention
// (D17.13), so the pair is interchangeable with new and del (D10.3,
// stdlib.md 2.2).

// bcopy(3) copies bytes through a `void*`. No cast gives a type to a `void*`
// (D3.14), so the test gives the block of malloc to C as it is.
extern fn bcopy(void* source, void mut* destination, u64 n) void;

fn main() i32 {
    // A block sized in bytes, which owns: no cast gives it a type (D3.14), so
    // bcopy writes the block and copies it back into a fixed array.
    void mut* own block = libc.malloc(32);
    if (block == null) {
        del(block);
        return 1;
    }
    u8@ hello = cast("hello", u8@);
    bcopy(cast(&hello[0], void*), block, hello.len);
    u8[5] mut back = {};
    bcopy(block, cast(&back, void mut*), 5);
    println(block != null, " ", cast(back[..], string));
    // del releases what malloc returned, frees by the pointer alone, and
    // empties the lvalue (D10.3, D17.9, stdlib.md 3).
    del(block);
    println(block == null);

    // The other direction: libc.free releases what new returned. The own
    // lvalue must be moved into the own parameter (D6.11) and is left null
    // afterwards (D17.6).
    i64 mut* own slot = new(i64);
    *slot = 42;
    println(slot != null, " ", *slot);
    libc.free(cast(move(slot), void* own));
    println(slot == null);

    // memcpy counts bytes, so it takes u8 mut* and u8* and a span's .ptr
    // crosses with no cast. It returns its dst, a view, which is discarded
    // (stdlib.md 2.2).
    u8[8] mut src = {};
    u8[8] mut dst = {};
    mem.copy(src[..], cast("abcdefgh", u8@));
    libc.memcpy(dst[..].ptr, src[..].ptr, 8);
    if (!mem.equal(dst[..], src[..])) {
        return 1;
    }
    println(cast(dst[..], string));
    return 0;
}
