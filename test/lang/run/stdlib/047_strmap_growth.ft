//! run
//! stdout:
//| 12 12 12 16
//| 13 13 13 32
//| 13 78
//| 20 20 20 32
//| 20 190
import std.strmap;

// The rebuild rule of stdlib.md 2.8: before an insert, a table whose
// (used + 1) * 4 exceeds cap * 3 is replaced by one large enough for
// (live + 1) * 2, starting at 16 and doubling. Twelve entries fit in sixteen
// slots; the thirteenth is the one that rebuilds, and every earlier entry must
// come through the move.
fn main() i32 {
    string[20] keys = {"k00", "k01", "k02", "k03", "k04", "k05", "k06", "k07", "k08", "k09",
                       "k10", "k11", "k12", "k13", "k14", "k15", "k16", "k17", "k18", "k19"};
    strmap.str_map mut m = strmap.create();
    defer strmap.free(&m);

    u64 mut i = 0;
    while (i < 12) {
        strmap.put(&m, keys[i], cast(i, i64));
        i += 1;
    }
    println(strmap.count(&m), " ", m.live, " ", m.used, " ", m.entries.len);

    strmap.put(&m, keys[12], 12);
    println(strmap.count(&m), " ", m.live, " ", m.used, " ", m.entries.len);

    // Every key placed before the rebuild is still there, with its value.
    u64 mut found = 0;
    i64 mut sum = 0;
    i = 0;
    while (i < 13) {
        i64 mut v = -1;
        if (strmap.get(&m, keys[i], &v)) {
            found += 1;
            sum += v;
        }
        i += 1;
    }
    // 0 + 1 + ... + 12 is 78.
    println(found, " ", sum);

    // The rule measures the load on the capacity, so the next rebuild waits
    // for the twenty-fourth entry and these twenty stay in the table of
    // thirty-two the thirteenth insert made.
    while (i < 20) {
        strmap.put(&m, keys[i], cast(i, i64));
        i += 1;
    }
    println(strmap.count(&m), " ", m.live, " ", m.used, " ", m.entries.len);

    // And the walk of stdlib.md 2.8 over the table finds exactly the live
    // entries, in table order.
    u64 mut walked = 0;
    i64 mut total = 0;
    u64 mut k = 0;
    while (k < m.entries.len) {
        if (m.entries[k].state == strmap.SLOT_FULL) {
            walked += 1;
            total += m.entries[k].val;
        }
        k += 1;
    }
    // 0 + 1 + ... + 19 is 190.
    println(walked, " ", total);
    return 0;
}
