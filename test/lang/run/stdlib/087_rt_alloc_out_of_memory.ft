//! run
//! abort
//! stderr: src/app.ft:5:14: runtime error: out of memory
//! stdout:
//| src/app.ft:5:14: runtime error: out of memory
//| before
import std.rt;

// A failed allocation is a runtime error at the same position (D10.2, D11.4,
// toolchain.md 5.2). run/errors/012 holds the C entry point to this text. The
// count below is one element under run/stdlib/086's, and it is the largest
// count that does not overflow: the product is 18446744073709551600 bytes.
// The guard lets it through, and C says no. The two tests hold the two sides
// of that boundary. A guard written >= instead of > would swap them.
string FILE = "src/app.ft";

fn i32 main() {
    u32 line = 5;
    u32 col = 14;
    u64 elem_size = 16;
    u64 count = 1152921504606846975;
    println(FILE, ":", line, ":", col, ": runtime error: out of memory");
    rt.fort_rt_flush_all();
    rt.print_str(1, "before\n".ptr, 7);
    void* own p = rt.alloc(elem_size, count, FILE.ptr, line, col);
    rt.free(move(p));
    return 0;
}
