//! run
//! abort
//! stderr: src/app.ft:5:14: runtime error: out of memory
//! stdout:
//| src/app.ft:5:14: runtime error: out of memory
//| before
import extern;
import std.rt;

// A failed allocation is a runtime error at the same position (D10.2, D11.4,
// toolchain.md 5.2). run/errors/012 holds the C entry point to this text. The
// count below is one element under run/stdlib/086's, and it is the largest
// count that does not overflow: the product is 18446744073709551600 bytes.
// The guard lets it through, and the allocator says no: the product is above
// the address range that it reserves (D10.9 rule 5). The two tests hold the
// two sides of that boundary. A guard written >= instead of > would swap them.
string FILE = "src/app.ft";

// C call rt.alloc: &FILE[0] names the first byte of the global FILE, no mut global, which the
// literal "src/app.ft" initializes, so its bytes end in the NUL of that literal (D9.8 rule 4,
// D3.7), and alloc reads them to that NUL. elem_size and count are integers; alloc stops the
// process with its failure line before the allocator gives storage.
// C call rt.release: p, the block that rt.alloc gives in this function and that no call
// released before; release tests the address and reads no byte of it. &FILE[0] is the name of
// the rt.alloc row.
fn main() i32 {
    u32 line = 5;
    u32 col = 14;
    u64 elem_size = 16;
    u64 count = 1152921504606846975;
    println(FILE, ":", line, ":", col, ": runtime error: out of memory");
    rt.flush_all();
    rt.print_str(1, "before\n");
    void mut* p = rt.alloc(elem_size, count, &FILE[0], line, col);
    rt.release(p, &FILE[0], line, col);
    return 0;
}
