//! run
//! stdout:
//| 1 2 1 2
//| -7 -7 3 3
//| 5 5 5 5
//| -2147483648 2147483647 -9223372036854775808 9223372036854775807
//| 0 18446744073709551615 0 18446744073709551615
//| true true true true
//| 4 2 4 4
import std.math;

// math.min_i32, max_i32, min_i64, max_i64, min_u64 and max_u64 (stdlib.md 2.9):
// `a < b ? a : b` and `a > b ? a : b`.
//
// Three cases answer for each pair: a < b, a > b and a == b. The last one is
// what a wrong comparison shows up on when the arguments are swapped, so both
// orders are here. min_u64 and max_u64 compare unsigned, which the U64_MAX line
// holds: read as signed, U64_MAX is -1 and every answer there would swap.
fn main() i32 {
    // a < b and a > b, both orders.
    println(math.min_i32(1, 2), " ", math.max_i32(1, 2), " ",
            math.min_i32(2, 1), " ", math.max_i32(2, 1));

    // A negative operand, where the sign decides.
    println(math.min_i32(-7, 3), " ", math.min_i64(3, -7), " ",
            math.max_i32(-7, 3), " ", math.max_i64(3, -7));

    // Equal operands: both functions return that value.
    println(math.min_i32(5, 5), " ", math.max_i32(5, 5), " ",
            math.min_i64(5, 5), " ", math.max_i64(5, 5));

    // The limits of each signed type as operands.
    println(math.min_i32(math.I32_MIN, math.I32_MAX), " ",
            math.max_i32(math.I32_MIN, math.I32_MAX), " ",
            math.min_i64(math.I64_MIN, math.I64_MAX), " ",
            math.max_i64(math.I64_MIN, math.I64_MAX));

    // The unsigned pair over the whole u64 range. U64_MAX beside 0 is the line
    // a signed comparison gets wrong.
    println(math.min_u64(0, math.U64_MAX), " ", math.max_u64(0, math.U64_MAX),
            " ", math.min_u64(math.U64_MAX, 0), " ",
            math.max_u64(math.U64_MAX, 0));
    u64 top = math.U64_MAX;
    u64 half = 9223372036854775808;
    println(math.min_u64(half, top) == half, " ", math.max_u64(half, top) == top,
            " ", math.min_u64(top, top) == top, " ", math.max_u64(0, 0) == 0);

    // The functions take an expression like any other, and evaluate it once
    // each: the counter below is 2 after the first line and 4 after the second.
    i64 mut calls = 0;
    println(math.min_i64(bump(&calls), bump(&calls)), " ", calls, " ",
            math.max_i64(bump(&calls), bump(&calls)), " ", calls);
    return 0;
}

// Raises the counter and returns 4, so the value is the same whichever argument
// the call stands in and only the count of calls shows.
fn bump(i64 mut* counter) i64 {
    *counter += 1;
    return 4;
}
