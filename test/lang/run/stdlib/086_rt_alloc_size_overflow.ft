//! run
//! abort
//! stderr: src/app.ft:5:14: runtime error: allocation size overflow
//! stdout:
//| src/app.ft:5:14: runtime error: allocation size overflow
//| before
import extern;
import std.rt;

// alloc refuses a product that overflows. It reports the position the
// compiler passed for the new, and it asks the allocator for nothing (D10.2, D11.4,
// toolchain.md 5.2). run/errors/011 holds the C entry point to this text.
// U64_MAX / 16 is 1152921504606846975, so the count below is the smallest
// count that overflows for this element size. run/stdlib/087 takes the same
// guard one element lower, where the product fits and the allocation itself
// fails.
string FILE = "src/app.ft";

// C call rt.alloc: &FILE[0] names the first byte of the global FILE, no mut global, which the
// literal "src/app.ft" initializes, so its bytes end in the NUL of that literal (D9.8 rule 4,
// D3.7), and alloc reads them to that NUL. elem_size and count are integers; alloc stops the
// process with its failure line before the allocator gives storage.
// C call rt.release: p, the block that rt.alloc gives in this function and that no call
// released before; release tests the address and reads no byte of it. &FILE[0] is the name of
// the rt.alloc row.
fn main() i32 {
    u32 line = 5;
    u32 col = 14;
    u64 elem_size = 16;
    u64 count = 1152921504606846976;
    println(FILE, ":", line, ":", col, ": runtime error: allocation size overflow");
    rt.flush_all();
    rt.print_str(1, "before\n");
    void mut* p = rt.alloc(elem_size, count, &FILE[0], line, col);
    rt.release(p, &FILE[0], line, col);
    return 0;
}
