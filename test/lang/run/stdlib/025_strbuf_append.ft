//! run
//! stdout:
//| 0 0 
//| 5 16 hello
//| 5 16 hello
//| 11 16 hello world
//| 14 16 hello world!?!
//| 14 16 hello world!?!
//| 34 34 hello world!?!hello world!?!hello!
import std.strbuf;

// append and append_bytes add a whole span at once, growing once for the
// whole of it; an empty argument changes nothing, not even the capacity
// (stdlib.md 2.6).
fn main() i32 {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    println(b.len, " ", b.data.len, " ", strbuf.view(&b));

    strbuf.append(&b, "hello");
    println(b.len, " ", b.data.len, " ", strbuf.view(&b));
    strbuf.append(&b, "");
    println(b.len, " ", b.data.len, " ", strbuf.view(&b));
    strbuf.append(&b, " world");
    println(b.len, " ", b.data.len, " ", strbuf.view(&b));

    // append_bytes takes the byte span family instead (D3.14).
    u8[3] mut bang = {33, 63, 33};
    strbuf.append_bytes(&b, bang[..]);
    println(b.len, " ", b.data.len, " ", strbuf.view(&b));
    strbuf.append_bytes(&b, bang[1..1]);
    println(b.len, " ", b.data.len, " ", strbuf.view(&b));

    // One append that needs more than twice the capacity takes the capacity
    // to exactly what it needs, in a single growth.
    strbuf.append(&b, "hello world!?!hello!");
    println(b.len, " ", b.data.len, " ", strbuf.view(&b));
    return 0;
}
