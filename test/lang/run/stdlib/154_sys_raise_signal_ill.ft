//! run
//! signal: ILL
//! stdout:
//| before
// sys.raise_signal sends SIGILL, 4 on both targets, and the signal ends the process with
// no handler (stdlib.md 2.1). The call does not return, so the text after it does not show.
import std.io;
import std.sys;

fn main() i32 {
    println("before");
    io.flush(io.STDOUT);
    sys.raise_signal(4);
    println("after");
    return 0;
}
