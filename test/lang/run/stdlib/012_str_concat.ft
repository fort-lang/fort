//! run
//! stdout:
//| foobar 6
//| foo 3
//| bar 3
//| 0 true
//| ab|cd 5
//| aXc
import std.str;

// str.concat returns an exact-length heap copy of a followed by b, with
// result.len == a.len + b.len (stdlib.md 2.5, D13.5).
fn main() i32 {
    string own joined = str.concat("foo", "bar");
    defer del(joined);
    println(joined, " ", joined.len);

    // Either side may be empty.
    string own left = str.concat("foo", "");
    defer del(left);
    println(left, " ", left.len);
    string own right = str.concat("", "bar");
    defer del(right);
    println(right, " ", right.len);

    // Both empty is a zero-length, non-null allocation (D10.2).
    string own nothing = str.concat("", "");
    defer del(nothing);
    println(nothing.len, " ", nothing.ptr != null);

    // The result of one concat feeds the next as a plain string (D17.4).
    string own inner = str.concat("ab", "|");
    defer del(inner);
    string own outer = str.concat(inner, "cd");
    defer del(outer);
    println(outer, " ", outer.len);

    // Sub-strings of the operands are copied, not aliased.
    string text = "aXbXc";
    string own picked = str.concat(text[..2], text[4..]);
    defer del(picked);
    println(picked);
    return 0;
}
