//! run
//! stdout:
//| 0 0
//| 1 16 -1
//| 3 16 -1 0 9223372036854775807
//| 9223372036854775807 2
//| 0 1
//| -1 0 16
//| 1 16 42
//| 16 16 0
//| 17 32 0
//| 136 17
import std.vec;

// int_push appends and int_pop removes from the same end (stdlib.md 2.7). The
// elements are values, so the extremes of i64 must survive storage and the
// growth that moves them.

// A read through a pointer: the owner is no local owner here (D17.21).
fn item(vec.int_vec* v, u64 k) i64 {
    return v->items[k];
}

// Ends a vector in an allocation of `new`: the value moves out, the allocation goes, and
// vec.int_drop frees the elements. The calls under test take the vector by pointer, so the vector
// lives in an allocation: no call changes its pointer.
fn drop_made(vec.int_vec mut* own p) void {
    vec.int_vec kept = move(*p);
    del(p);
    vec.int_drop(move(kept));
}

fn main() i32 {
    vec.int_vec mut* own v = new(vec.int_vec);
    defer drop_made(move(v));
    println(v->len, " ", v->items.len);

    vec.int_push(v, -1);
    println(v->len, " ", v->items.len, " ", item(v, 0));
    vec.int_push(v, 0);
    vec.int_push(v, 9223372036854775807);
    println(v->len, " ", v->items.len, " ", item(v, 0), " ", item(v, 1), " ", item(v, 2));

    println(vec.int_pop(v), " ", v->len);
    println(vec.int_pop(v), " ", v->len);
    println(vec.int_pop(v), " ", v->len, " ", v->items.len);

    // The emptied vector keeps its slots and takes a new element.
    vec.int_push(v, 42);
    println(v->len, " ", v->items.len, " ", item(v, 0));

    // Sixteen elements fit; the seventeenth doubles the capacity and the sum
    // shows that every one of them moved.
    vec.int_free(v);
    i64 mut i = 0;
    while (i < 16) {
        vec.int_push(v, i);
        i += 1;
    }
    println(v->len, " ", v->items.len, " ", item(v, 0));
    vec.int_push(v, 16);
    println(v->len, " ", v->items.len, " ", item(v, 0));
    i64 mut sum = 0;
    u64 mut k = 0;
    while (k < v->len) {
        sum += item(v, k);
        k += 1;
    }
    println(sum, " ", v->len);
    return 0;
}
