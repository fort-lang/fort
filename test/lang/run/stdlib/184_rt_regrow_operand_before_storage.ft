//! run
//! abort
//! stderr: src/app.ft:9:3: runtime error: invalid release
//! stdout:
//| before
import extern;
import std.rt;

// The entry of `regrow` tests the operand before it asks for the storage (D12.2). This call
// fails the two tests: the operand is a null pointer with a length that is not 0, and no
// allocator gives 9223372036854775807 bytes. The text is the text of the operand.
string FILE = "src/app.ft";

// C call rt.regrow: &FILE[0] names the first byte of the global FILE, no mut global, which the
// literal "src/app.ft" initializes, so its bytes end in the NUL of that literal (D9.8 rule 4,
// D3.7), and regrow reads them to that NUL. The first argument is null and the others are
// integers.
// C call rt.free: p is the allocation that regrow gives (A3).
fn main() i32 {
    println("before");
    u64 count = 9223372036854775807;
    void mut* own p = rt.regrow(null, 2, 1, count, false, &FILE[0], 9, 3);
    println("after");
    rt.free(move(p));
    return 0;
}
