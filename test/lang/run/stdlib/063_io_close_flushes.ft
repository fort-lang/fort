//! run
//! stdout:
//| buffered before the close
import std.io;

// close flushes the runtime's buffer for the descriptor before closing it
// (D11.5, stdlib.md 2.4). This program's only output is a println whose bytes
// are still in that buffer when close runs: the flush at exit cannot save it,
// because by then there is no descriptor left to write it to, so the line
// appears if and only if close flushed it.
fn main() i32 {
    println("buffered before the close");
    if (!io.close(io.STDOUT)) {
        // Reported on stderr, which this test does not read, because stdout
        // is gone by now.
        eprintln("close failed");
        return 1;
    }
    return 0;
}
