//! run
//! stdout:
//| true 0
//| true 7
//| true -7
//| true 0
//| true 0
//| true 42
//| true -42
//| true 1000000
//| true 123
import std.str;

// parse_i64 reads decimal with an optional leading -, at least one digit and
// nothing else (stdlib.md 2.5). Leading zeros are digits like any other.
fn show(string text) void {
    i64 mut value = 0;
    bool ok = str.parse_i64(text, &value);
    println(ok, " ", value);
}

fn main() i32 {
    show("0");
    show("7");
    show("-7");
    // -0 parses as 0, and any number of leading zeros is accepted.
    show("-0");
    show("0000");
    show("0042");
    show("-0042");
    show("1000000");
    // A sub-string is parsed as its own text.
    string line = "n=123;";
    show(line[2..5]);
    return 0;
}
