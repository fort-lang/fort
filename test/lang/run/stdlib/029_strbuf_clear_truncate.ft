//! run
//! stdout:
//| 9 16 abcdefghi
//| 3 16 abc
//| 3 16 abc
//| 0 16 
//| 0 16 
//| 3 16 xyz
//| 0 16 
import std::strbuf;

// clear and truncate move len alone and never touch the storage
// (stdlib.md 2.6): the capacity stays, so the buffer refills without
// allocating and truncating to the current length is a no-op.
fn i32 main() {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "abcdefghi");
    println(b.len, " ", b.data.len, " ", strbuf.view(&b));

    strbuf.truncate(&b, 3);
    println(b.len, " ", b.data.len, " ", strbuf.view(&b));
    // Truncating to the length it already has changes nothing; that boundary
    // is inside the precondition, one past it is not (030).
    strbuf.truncate(&b, 3);
    println(b.len, " ", b.data.len, " ", strbuf.view(&b));
    strbuf.truncate(&b, 0);
    println(b.len, " ", b.data.len, " ", strbuf.view(&b));

    // clear on an already empty buffer is harmless, and the storage it kept
    // takes the next three bytes without a new allocation.
    strbuf.clear(&b);
    println(b.len, " ", b.data.len, " ", strbuf.view(&b));
    strbuf.append(&b, "xyz");
    println(b.len, " ", b.data.len, " ", strbuf.view(&b));
    strbuf.clear(&b);
    println(b.len, " ", b.data.len, " ", strbuf.view(&b));
    return 0;
}
