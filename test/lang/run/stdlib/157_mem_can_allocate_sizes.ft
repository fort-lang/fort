//! run
//! stdout:
//| 0 bytes: true
//| 1 byte: true
//| 4096 bytes: true
//| 16 MiB: true
//| 2 to the power 62: false
//| u64 max: false
//| a new after the probes: 16
import std.mem;

// mem.can_allocate asks the allocator of the runtime for each size and takes no storage
// (stdlib.md 2.3). A size of 0 is no refusal, and 16 MiB is free on each machine that runs the
// tests. A size near 2 to the power 62 or 64 is more than the limit of the allocator, 2 to
// the power 47 bytes, so the allocator refuses it (D10.9 rule 5). The probe keeps no
// block, so a new allocation after it works. The interpreter of `--fir-run` runs this program
// too (test/fir_run_test.py): it models the allocator with the same limit and sets no errno, so
// the test does not read errno.

fn size(u64 n) u64 {
    return n;
}

fn main() i32 {
    println("0 bytes: ", mem.can_allocate(size(0)));
    println("1 byte: ", mem.can_allocate(size(1)));
    println("4096 bytes: ", mem.can_allocate(size(4096)));
    println("16 MiB: ", mem.can_allocate(size(16777216)));
    println("2 to the power 62: ", mem.can_allocate(size(4611686018427387904)));
    println("u64 max: ", mem.can_allocate(size(18446744073709551615)));
    u8 mut@ own bytes = new(u8, 16);
    println("a new after the probes: ", bytes.len);
    del(bytes);
    return 0;
}
