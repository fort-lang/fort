fn void the_table() {
    the_fixed_texts_and_the_entry_point();
    table_f64_normal_1();
    table_f64_normal_2();
    table_f64_normal_3();
    table_f64_simple_1();
    table_f64_simple_2();
    table_f64_decimal_1();
    table_f64_decimal_2();
    table_f64_decimal_3();
    table_f64_power10_1();
    table_f64_power10_2();
    table_f64_power10_3();
    table_f64_power2_1();
    table_f64_power2_2();
    table_f64_power2_3();
    table_f64_sub_1();
    table_f64_sub_2();
    println("f64 table ok");
    table_f32_1();
    table_f32_2();
    table_f32_3();
    table_f32_4();
    table_f32_5();
    println("f32 table ok");
}

fn i32 main() {
    the_ordinary_values();
    the_infinities_and_the_nan();
    the_thresholds();
    the_extremes();
    the_binary32_values();
    the_table();
    // The print family is not used here, so the buffers of std.rt are flushed
    // by hand: the entry point that flushes them arrives with the runtime
    // (D11.5, T-091).
    rt.flush_all();
    return 0;
}
