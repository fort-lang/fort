//! run
//! stdout:
//| 0.0 1.0 -1.0 100.0 -100.0
//| -0.0 0.0 0.5 -2.5 1234.5678
//| 0.1 0.2 0.30000000000000004 0.3333333333333333
//| inf -inf nan nan
//| 0.0001 9.999e-05 1e-05 1.5e-07
//| 1000000000000000.0 10000000000000000.0 1e+17 1e+21
//| 1.7976931348623157e+308 2.2250738585072014e-308 5e-324 1e-323
//| 16777217.0 9007199254740992.0 123456789012345.67
//| 7.120236347223045e-307 1.5474250491067253e+26
//| 0.1 0.33333334 16777216.0 123456790.0
//| 3.4028235e+38 1.1754944e-38 1e-45 2971111.8
//| 1.2621775e-29 9.999999e-05 1e-05 -0.0
//| 1.5 1.5
//| f64 table ok
//| f32 table ok
import std.rt;
import std.rt_float;

// The bits of a float: the one way a fort program reaches every encoding,
// since a cast converts values and not patterns (D3.14).
extern fn u8 mut* memcpy(u8 mut* dst, u8* src, u64 n);

// std.rt_float against D18.2 and D18.3, called directly rather than through
// the print family.
//
// Why directly. The print family reaches these two entry points through the
// emitter (D12.2, toolchain.md 6 item 19), and run/builtins holds the values
// that way. This test calls them as functions, so the module answers for its
// own bytes whatever the emitter does with it, and it is the test that runs
// while the two are being wired together.
//
// Every value and every expected text below is one of run/builtins/009 to
// 012, which were transcribed from the C runtime's own suite before that
// runtime was deleted (T-091). The last line of each family is the one that
// would look right with a wrong implementation: a power of two, a subnormal,
// a tie that goes to the even digit, and a negative zero.

fn f64 f64_of_bits(u64 bits) {
    f64 mut v = 0.0;
    u64 mut source = bits;
    memcpy(cast(&v, u8 mut*), cast(&source, u8*), 8);
    return v;
}

fn void put(string s) {
    rt.emit_str(1, s);
}

fn void f64_value(f64 v) {
    rt_float.print_f64(1, v);
}

fn void f32_value(f32 v) {
    rt_float.print_f32(1, v);
}

fn void space() {
    put(" ");
}

fn void line() {
    put("\n");
}

// The layout of D18.3 on the values a program writes.
fn void the_ordinary_values() {
    f64_value(0.0);
    space();
    f64_value(1.0);
    space();
    f64_value(-1.0);
    space();
    f64_value(100.0);
    space();
    f64_value(-100.0);
    line();
    f64 zero = 0.0;
    f64_value(-zero);
    space();
    f64_value(zero);
    space();
    f64_value(0.5);
    space();
    f64_value(-2.5);
    space();
    f64_value(1234.5678);
    line();
    f64 tenth = 0.1;
    f64 fifth = 0.2;
    f64_value(tenth);
    space();
    f64_value(fifth);
    space();
    f64_value(tenth + fifth);
    space();
    f64_value(1.0 / 3.0);
    line();
}

// D11.7 lists inf, -inf and nan and no -nan, so a NaN prints the same
// whatever its sign bit. Neither has a literal, so both are built at run
// time (D6.12).
fn void the_infinities_and_the_nan() {
    f64 mut huge = 1.7976931348623157e+308;
    huge = huge * 2.0;
    f64 divisor = 0.0;
    f64 not_a_number = divisor / divisor;
    f64_value(huge);
    space();
    f64_value(-huge);
    space();
    f64_value(not_a_number);
    space();
    f64_value(-not_a_number);
    line();
}

// The form changes on the decimal exponent of the leading digit: below -4 and
// at 17 and above it is exponent form (D18.3).
fn void the_thresholds() {
    f64_value(1e-4);
    space();
    f64_value(9.999e-5);
    space();
    f64_value(1e-5);
    space();
    f64_value(1.5e-7);
    line();
    f64_value(1e15);
    space();
    f64_value(1e16);
    space();
    f64_value(1e17);
    space();
    f64_value(1e21);
    line();
}

// The ends of the encoding, where the digits are the most delicate: the
// largest finite value, the least normal, the least subnormal, the second
// subnormal, a value needing seventeen digits and two powers of two.
fn void the_extremes() {
    f64_value(1.7976931348623157e+308);
    space();
    f64_value(2.2250738585072014e-308);
    space();
    f64_value(5e-324);
    space();
    f64_value(1e-323);
    line();
    f64_value(16777217.0);
    space();
    f64_value(9007199254740992.0);
    space();
    f64_value(123456789012345.67);
    line();
    // 2^-1017 and 2^87, where the values that read back are not centred on
    // the value and the nearest decimal of the shortest length falls outside
    // the interval.
    f64_value(7.120236347223045e-307);
    space();
    f64_value(1.5474250491067253e+26);
    line();
}

// An f32 prints the digits of its own type, which are fewer (D18.1).
fn void the_binary32_values() {
    f32 tenth = 0.1;
    f32 third = 1.0 / 3.0;
    f32 odd = 16777217.0;
    f32 wide = 123456792.0;
    f32_value(tenth);
    space();
    f32_value(third);
    space();
    f32_value(odd);
    space();
    f32_value(wide);
    line();
    f32 largest = 3.4028235e+38;
    f32 smallest_normal = 1.1754944e-38;
    f32 smallest = 1e-45;
    // 2971111.75 is exactly midway between the two shortest decimals that
    // read back as it, and the tie goes to the even last digit (D18.2).
    f32 tie = 2971111.75;
    f32_value(largest);
    space();
    f32_value(smallest_normal);
    space();
    f32_value(smallest);
    space();
    f32_value(tie);
    line();
    // 2^-96, the last value below the low threshold, the first at it, and a
    // negative zero, whose sign comes from the sign bit alone.
    f32 low = 1.2621775e-29;
    f32 last = 9.999999e-5;
    f32 first = 1e-5;
    f32 zero = 0.0;
    f32_value(low);
    space();
    f32_value(last);
    space();
    f32_value(first);
    space();
    f32_value(-zero);
    line();
}

// ---- the table ---------------------------------------------------------------------

// 1110 values and the text D18.2 and D18.3 give each of them, held against
// the module one value at a time.
//
// Where the texts come from: an oracle off this tree, the shortest decimal
// that reads back in the value's own type -- the neighbour probe of
// toolchain.md 5.1 included -- laid out by D18.3's rules, and checked against
// the C runtime's own answers on the values the cases above hold. The
// patterns are drawn at random from the classes whose paths through the
// search differ, and no value appears twice.
//
// What the table is for. The property test beside this one proves every text
// reads back, which a text of 17 digits does as well as the shortest one, so
// the shortest-ness is what a table of values has to hold. It found the first
// draft of this oracle wrong rather than the module: the nearest decimal of a
// length can miss while the one above it reads back, and an oracle without
// that probe answers with one digit too many.

// One value and its text, in each type.
fn void p64(u64 bits, string text) {
    char[64] mut out = {};
    u64 n = rt_float.text_f64(f64_of_bits(bits), out[..]);
    want_text(bits, cast(out[0..n], string), text);
}

fn void p32(u64 bits, string text) {
    char[64] mut out = {};
    u64 n = rt_float.text_f32(cast(f64_of_bits(bits), f32), out[..]);
    want_text(bits, cast(out[0..n], string), text);
}

fn void want_text(u64 bits, string got, string text) {
    if (got != text) {
        println("the text of ", bits, " is ", got, ", want ", text);
    }
    assert(got == text);
}

// The three fixed texts of D11.7 through the same path, and the entry point
// holding the same bytes as the text it writes: print_f64 is text_f64 and a
// write, so a value that prints differently from its text would mean the two
// had drifted apart.
fn void the_fixed_texts_and_the_entry_point() {
    char[64] mut out = {};
    f64 zero = 0.0;
    f64 one = 1.0;
    u64 mut n = rt_float.text_f64(zero / zero, out[..]);
    want_text(0, cast(out[0..n], string), "nan");
    n = rt_float.text_f64(one / zero, out[..]);
    want_text(0, cast(out[0..n], string), "inf");
    n = rt_float.text_f64(-one / zero, out[..]);
    want_text(0, cast(out[0..n], string), "-inf");
    n = rt_float.text_f32(cast(one / zero, f32), out[..]);
    want_text(0, cast(out[0..n], string), "inf");
    // The entry point of each type writes exactly that text.
    rt_float.print_f64(1, 1.5);
    put(" ");
    n = rt_float.text_f64(1.5, out[..]);
    put(cast(out[0..n], string));
    line();
}

