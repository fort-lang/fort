//! run
//! stdout:
//| true
//| true 5 first
//| true 6 second
//| true 5 first
import std.io;

// A caller can reuse an own slot. read_file_bytes dels *out just before its
// store, because the entry value of *out is unknown to it (D17.11, stdlib.md
// 2.4). On an empty slot that del frees nothing, and on a live slot it frees
// the old bytes, so the slot never leaks.
fn main() i32 {
    // The slot comes before the first call, which can write it (D17.11).
    u8 mut@ own mut data = {};
    println(io.write_file("t028-slot-a.txt", cast("first", u8@)) &&
            io.write_file("t028-slot-b.txt", cast("second", u8@)));

    defer del(data);
    println(io.read_file_bytes("t028-slot-a.txt", &data), " ", data.len, " ",
            cast(data[..], string));

    // Released first, the slot is zero again and the next file lands in it.
    del(data);
    println(io.read_file_bytes("t028-slot-b.txt", &data), " ", data.len, " ",
            cast(data[..], string));

    // Not released, the slot is live, and the library frees the old bytes
    // before it stores the new ones.
    println(io.read_file_bytes("t028-slot-a.txt", &data), " ", data.len, " ",
            cast(data[..], string));
    return 0;
}
