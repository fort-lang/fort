//! run
//! abort
//! stderr: runtime error: overwriting owned value
//! stdout:
//| true
//| true 5 first
//| true 6 second
import std.io;

// A caller that reuses an own slot dels it first: the store inside
// read_file_bytes never frees what the slot held, so a live slot is the
// overwriting owned value runtime error in a checked build and a leak in a
// release build (D17.11, stdlib.md 2.4).
fn main() i32 {
    println(io.write_file("t028-slot-a.txt", cast("first", u8@)) &&
            io.write_file("t028-slot-b.txt", cast("second", u8@)));

    u8 mut@ own mut data = {};
    defer del(data);
    println(io.read_file_bytes("t028-slot-a.txt", &data), " ", data.len, " ",
            cast(data[..], string));

    // Released first, the slot is zero again and the next file lands in it.
    del(data);
    println(io.read_file_bytes("t028-slot-b.txt", &data), " ", data.len, " ",
            cast(data[..], string));

    // Not released, it is a live slot, and the store inside the library traps
    // rather than dropping the allocation it holds.
    io.read_file_bytes("t028-slot-a.txt", &data);
    println("not reached");
    return 0;
}
