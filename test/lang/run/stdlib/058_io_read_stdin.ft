//! run
//! stdin:
//< first line
//< second line
//! stdout:
//| true 23
//| first line
//| second line
//| true 23
import std.io;
import std.strbuf;

// Standard input is a descriptor like any other (stdlib.md 2.4): read_all
// reads it to end of file, and a second call at end of file adds nothing.
fn i32 main() {
    strbuf.str_buf mut buf = strbuf.create();
    defer strbuf.free(&buf);
    println(io.read_all(io.STDIN, &buf), " ", buf.len);
    print(strbuf.view(&buf));
    println(io.read_all(io.STDIN, &buf), " ", buf.len);
    return 0;
}
