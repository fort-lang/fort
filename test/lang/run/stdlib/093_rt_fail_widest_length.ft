//! run
//! abort
//! stderr: src/app.ft:1:1: runtime error: index 0 out of range for length 18446744073709551615
//! stdout:
//| src/app.ft:1:1: runtime error: index 0 out of range for length 18446744073709551615
//| before
import extern;
import std.rt;

// The other half of run/stdlib/092: message_u64 with the largest u64 there
// is, inside a failure line. 20 digits fill a DECIMAL_MAX array exactly, so
// one byte more would underflow start in format_u64, and that underflow
// traps and calls this same path again. The index beside it is 0, the
// shortest number, so both ends of format_u64 run in one line.
string FILE = "src/app.ft";

// C call rt.fail_bounds: &FILE[0] names the first byte of the global FILE, no mut global, which the
// literal "src/app.ft" initializes, so its bytes end in the NUL of that literal (D9.8 rule 4,
// D3.7), and fail_bounds reads them to that NUL. The other arguments are integers.
fn main() i32 {
    u32 line = 1;
    u32 col = 1;
    i64 index = 0;
    u64 len = 18446744073709551615;
    println(FILE, ":", line, ":", col, ": runtime error: index ", index,
            " out of range for length ", len);
    rt.flush_all();
    rt.print_str(1, "before\n");
    rt.fail_bounds(index, len, &FILE[0], line, col);
}
