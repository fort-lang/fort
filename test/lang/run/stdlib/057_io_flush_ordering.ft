//! run
//! stdout:
//| printed first
//| written second
//| printed third
import std.io;

// print writes through the runtime's buffer for the descriptor and io.write_all
// goes straight to it (D11.5, stdlib.md 2.4), so a program that mixes them
// calls io.flush between them; this is that program, and its output is in the
// order the calls were made.
fn main() i32 {
    println("printed first");
    io.flush(io.STDOUT);
    io.write_all(io.STDOUT, cast("written second\n", u8@));
    println("printed third");
    // Nothing follows, so the flush at exit would deliver the last line in
    // any case; the call is here to show that flushing an already flushed
    // buffer is a no-op. The flush inside close is 063's subject.
    io.flush(io.STDOUT);
    return 0;
}
