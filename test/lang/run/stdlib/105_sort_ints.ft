//! run
//! stdout:
//| empty one
//| -9223372036854775808 -3 0 0 7 9223372036854775807
//| -3 0 0 7
//| 1 7 18446744073709551615
//| 18446744073709551615 1 7
//| 4 4 4 4
//| 12 5 3 1
//| 2 4 6 8
import std.sort;

// sort_i64, sort_u64 and the two ready-made comparators of stdlib.md 2.10.
// The span carries the count and the element type carries the size, so these
// entries take two arguments where the core sort takes four.

fn show(i64@ xs) void {
    for (u64 mut i = 0; i < xs.len; i += 1) {
        if (i > 0) {
            print(" ");
        }
        print(xs[i]);
    }
    println("");
}

fn show_u(u64@ xs) void {
    for (u64 mut i = 0; i < xs.len; i += 1) {
        if (i > 0) {
            print(" ");
        }
        print(xs[i]);
    }
    println("");
}

// Descending order is the caller's own comparator with the two arguments
// exchanged, which is what stdlib.md 2.10 says instead of a flag.
fn down_i64(void* a, void* b) i32 {
    return sort.cmp_i64(b, a);
}

fn main() i32 {
    // n below 2 is already sorted. An empty span has a null .ptr and reaches
    // no C call; a single element reaches none either.
    i64 mut@ empty = {};
    sort.sort_i64(empty, sort.cmp_i64);
    i64[1] mut one = {42};
    sort.sort_i64(one[..], sort.cmp_i64);
    println("empty one");

    // The two ends of i64 and a repeated element, from the reverse order.
    i64[6] mut xs = {9223372036854775807, 7, 0, 0, -3, -9223372036854775808};
    sort.sort_i64(xs[..], sort.cmp_i64);
    show(xs[..]);

    // A sub-span sorts what it covers and nothing else: the two limits stay
    // at the ends because this call never sees them.
    i64[6] mut ys = {9223372036854775807, 7, 0, 0, -3, -9223372036854775808};
    sort.sort_i64(ys[1..5], sort.cmp_i64);
    show(ys[1..5]);

    // cmp_u64 compares unsigned and cmp_i64 compares signed, so the same
    // three words come out in two orders. The bytes are identical; only the
    // comparator differs.
    u64[3] mut us = {18446744073709551615, 7, 1};
    sort.sort_u64(us[..], sort.cmp_u64);
    show_u(us[..]);
    u64[3] mut vs = {18446744073709551615, 7, 1};
    sort.sort_u64(vs[..], sort.cmp_i64);
    show_u(vs[..]);

    // Every element equal. The order is unspecified between ties, so the test
    // holds what is specified: the elements are still there.
    i64[4] mut same = {4, 4, 4, 4};
    sort.sort_i64(same[..], sort.cmp_i64);
    show(same[..]);

    // An already sorted array sorted the other way round.
    i64[4] mut down = {1, 3, 5, 12};
    sort.sort_i64(down[..], down_i64);
    show(down[..]);

    // An own span lends to the T mut@ parameter (D17.4, stdlib.md 2.10): the
    // sort borrows the elements for the call and gives nothing back, so the
    // del below is the one release of the one allocation. Without the lend
    // this call would need a move and the del would not compile.
    i64 mut@ own heap = new(i64, 4);
    defer del(heap);
    heap[0] = 8;
    heap[1] = 2;
    heap[2] = 6;
    heap[3] = 4;
    sort.sort_i64(heap, sort.cmp_i64);
    show(heap);
    return 0;
}
