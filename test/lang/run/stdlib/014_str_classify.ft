//! run
//! stdout:
//| digit 0123456789
//| alpha ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz
//| alnum 0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz
//| space 9 10 11 12 13 32
//| hex 0123456789ABCDEFabcdef
//| underscore false false false
//| high false false false false false
//| 0 7 9
//| 10 11 35
//| 10 11 35
//| -1 -1 -1 -1 -1
//| 62 35
import std.str;

// The classification functions are ASCII-only: every byte at or above 0x80
// classifies as false (stdlib.md 2.5). Each family is listed by walking all
// 256 byte values, so a stray member cannot hide.
fn void show_chars(string label, bool digits, bool alpha, bool alnum, bool hex) {
    print(label, " ");
    for (u64 mut i = 0; i < 256; i += 1) {
        char ch = cast(cast(i, u8), char);
        bool member = (digits && str.is_digit(ch)) || (alpha && str.is_alpha(ch))
                || (alnum && str.is_alnum(ch)) || (hex && str.is_hex(ch));
        if (member) {
            print(ch);
        }
    }
    println("");
}

fn i32 main() {
    show_chars("digit", true, false, false, false);
    show_chars("alpha", false, true, false, false);
    show_chars("alnum", false, false, true, false);
    print("space");
    for (u64 mut i = 0; i < 256; i += 1) {
        char ch = cast(cast(i, u8), char);
        if (str.is_space(ch)) {
            print(" ", i);
        }
    }
    println("");
    show_chars("hex", false, false, false, true);

    // '_' is not a letter (stdlib.md 2.5).
    println("underscore ", str.is_alpha('_'), " ", str.is_alnum('_'), " ", str.is_digit('_'));

    // A high byte is in no family.
    char high = '\x80';
    println("high ", str.is_digit(high), " ", str.is_alpha(high), " ", str.is_alnum(high), " ",
            str.is_space(high), " ", str.is_hex(high));

    // digit_value is the value of ch as a digit in bases up to 36 ('7' is 7,
    // 'b' and 'B' are 11), or -1 (stdlib.md 2.5).
    println(str.digit_value('0'), " ", str.digit_value('7'), " ", str.digit_value('9'));
    println(str.digit_value('a'), " ", str.digit_value('b'), " ", str.digit_value('z'));
    println(str.digit_value('A'), " ", str.digit_value('B'), " ", str.digit_value('Z'));
    // The bytes just outside each range, plus a high byte.
    println(str.digit_value('/'), " ", str.digit_value(':'), " ", str.digit_value('@'), " ",
            str.digit_value('['), " ", str.digit_value('\x80'));
    // Ten digits and twenty-six letters in each case is 62 accepted bytes,
    // and the largest value is 35.
    i64 mut members = 0;
    i64 mut largest = -1;
    for (u64 mut i = 0; i < 256; i += 1) {
        i64 value = str.digit_value(cast(cast(i, u8), char));
        if (value >= 0) {
            members += 1;
            if (value > largest) {
                largest = value;
            }
        }
    }
    println(members, " ", largest);
    return 0;
}
