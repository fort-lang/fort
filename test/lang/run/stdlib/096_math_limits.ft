//! run
//! stdout:
//| -2147483648 2147483647
//| -9223372036854775808 9223372036854775807
//| 4294967295 18446744073709551615
//| min max other
//| 8 8
//| true true true true
import std.math;

// The six integer limits of stdlib.md 2.9. Each one is a module-level constant
// (D7.10), so the last two blocks use one in a case label and one in an array
// length, which is what a constant can do and a call cannot (D4.6).

// The limit of a type is the value that type holds and the value beside it does
// not, so each constant is held against arithmetic on the other end as well as
// against its own digits.
fn digits() void {
    println(math.I32_MIN, " ", math.I32_MAX);
    println(math.I64_MIN, " ", math.I64_MAX);
    println(math.U32_MAX, " ", math.U64_MAX);
}

// A case label takes a constant, and these are constants.
fn classify(i32 x) string {
    switch (x) {
        case math.I32_MIN: {
            return "min";
        }
        case math.I32_MAX: {
            return "max";
        }
        default: {
            return "other";
        }
    }
}

fn main() i32 {
    digits();
    println(classify(math.I32_MIN), " ", classify(math.I32_MAX), " ", classify(0));

    // An array length takes a constant too. U32_MAX would ask for four
    // gigabytes, so the length here is a small expression over a constant,
    // which is the same rule.
    i64[math.I64_MAX - 9223372036854775799] room = {};
    println(room.len, " ", sizeof(i64[math.I64_MAX - 9223372036854775799]) / 8);

    // The value beside each limit is outside the type, which is why these
    // comparisons are the whole contract of the constants.
    i32 max_i32 = math.I32_MAX;
    i64 max_i64 = math.I64_MAX;
    u32 max_u32 = math.U32_MAX;
    u64 max_u64 = math.U64_MAX;
    println(max_i32 - 1 < math.I32_MAX, " ", max_i64 - 1 < math.I64_MAX, " ",
            max_u32 - 1 < math.U32_MAX, " ", max_u64 - 1 < math.U64_MAX);
    return 0;
}
