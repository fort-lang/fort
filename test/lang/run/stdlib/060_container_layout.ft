//! run
//! stdout:
//| 24 24 24
//| 40 32
//| 16 8 24
//| true true
import std::strbuf;
import std::strmap;
import std::vec;

// The sizes stdlib.md 1.1 says may be relied on: a struct field list and its
// order are part of the contract, and own is erased at run time (D17.1), so an
// own field has the size of the same field without it. A str_buf, a ptr_vec
// and an int_vec are a span and a u64; a str_map_entry is a string, an i64, a
// u64 and a u8 with padding; a str_map is a span and two u64.
fn i32 main() {
    println(sizeof(strbuf.str_buf), " ", sizeof(vec.ptr_vec), " ", sizeof(vec.int_vec));
    println(sizeof(strmap.str_map_entry), " ", sizeof(strmap.str_map));

    // Which is a span (a pointer and a length) followed by the count, the
    // layout every one of the three shares (D3.8).
    println(sizeof(u8 mut@), " ", sizeof(u64), " ", sizeof(u8 mut@) + sizeof(u64));

    // And the own of the field changes none of it (D17.1).
    println(sizeof(u8 mut@ own) == sizeof(u8 mut@), " ",
            sizeof(strmap.str_map_entry) * 2 == 80);
    return 0;
}
