//! run
//! stdout:
//| 0 0 0 0
//| 5 hello 2 20
//| 8 helloXYZ 3 30
//| 0 0 0 0 true true
import std.strbuf;
import std.vec;

// The zero value of every container is a valid empty one, so a struct holding
// them starts empty in the storage of new (D10.2) and is itself an owning
// aggregate (D17.7, stdlib.md 1.3): it is passed by pointer, and its drop
// releases the storage of each field in turn.
struct record {
    strbuf.str_buf text;
    vec.int_vec numbers;
}

fn record_free(record mut* r) void {
    record_drop(move(*r));
}

// Frees a record that the caller moves in: the storage of each container in turn.
fn record_drop(record mut r) void {
    del(r.text.data);
    del(r.numbers.items);
}

// Ends a record in an allocation that the caller moves in.
fn record_drop_made(record mut* own p) void {
    record kept = move(*p);
    del(p);
    record_drop(move(kept));
}

fn add(record mut* r, string s, i64 n) void {
    strbuf.append(&r->text, s);
    vec.int_push(&r->numbers, n);
}

// A read through a pointer: the owner is no local owner here (D17.21).
fn number_at(record* r, u64 k) i64 {
    return r->numbers.items[k];
}

fn main() i32 {
    record mut* own r = new(record);
    defer record_drop_made(move(r));
    println(r->text.len, " ", r->text.data.len, " ", r->numbers.len, " ", r->numbers.items.len);

    add(r, "hello", 10);
    add(r, "", 20);
    println(r->text.len, " ", strbuf.view(&r->text), " ", r->numbers.len, " ",
            number_at(r, 1));

    add(r, "XYZ", 30);
    println(r->text.len, " ", strbuf.view(&r->text), " ", r->numbers.len, " ",
            number_at(r, 2));

    // Freeing the record leaves both fields at their zero value, so the
    // deferred drop above frees nothing a second time (D17.9).
    record_free(r);
    println(r->text.len, " ", r->text.data.len, " ", r->numbers.len, " ", r->numbers.items.len,
            " ", r->text.data.ptr == null, " ", r->numbers.items.ptr == null);
    return 0;
}
