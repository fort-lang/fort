//! run
//! stdout:
//| 0 0 true
//| 0 8 false
//| 0 0 false
//| 0 0 true
//| 0 0 true
// A vector of pointers is a typed copy of int_vec (stdlib.md 2.7): no cast gives a type to a
// `void*` (D3.14), so std.vec holds no vector of `void*`. The copy answers as int_vec does: the
// zero value allocates nothing, node_with_cap allocates its slots up front, node_with_cap(0)
// allocates a block of no slots (D10.2), and node_free leaves node_vec{} however often it is
// called.
struct node { i64 value; }

// The typed copy of int_vec with the slot type node mut*.
struct node_vec {
    node mut* mut@ own items;
    u64 len;
}

fn node_with_cap(u64 cap) node_vec {
    return node_vec{new(node mut*, cap), 0};
}

fn node_free(node_vec mut* v) void {
    node_drop(move(*v));
}

// Frees a vector that the caller moves in.
fn node_drop(node_vec mut v) void {
    del(v.items);
}

// A vector in an allocation of its own, for a function that lends the vector to calls.
fn node_make(u64 cap) node_vec mut* own {
    node_vec mut* own v = new(node_vec);
    *v = node_with_cap(cap);
    return v;
}

// Ends a vector of node_make that the caller moves in.
fn node_drop_made(node_vec mut* own p) void {
    node_vec kept = move(*p);
    del(p);
    node_drop(move(kept));
}

fn main() i32 {
    node_vec mut empty = node_vec{};
    defer node_drop(move(empty));
    println(empty.len, " ", empty.items.len, " ", empty.items.ptr == null);

    node_vec mut* own v = node_make(8);
    defer node_drop_made(move(v));
    println(v->len, " ", v->items.len, " ", v->items.ptr == null);

    node_vec mut nothing = node_with_cap(0);
    defer node_drop(move(nothing));
    println(nothing.len, " ", nothing.items.len, " ", nothing.items.ptr == null);

    node_free(v);
    println(v->len, " ", v->items.len, " ", v->items.ptr == null);
    node_free(v);
    println(v->len, " ", v->items.len, " ", v->items.ptr == null);
    return 0;
}
