//! run
//! stdout:
//| 0 0 0 true
//| false 0
//| false false
//| true 16 1 false
//| 0 0 0 true
//| 0 0 0 true
import std::strmap;

// A map comes into being empty and allocates nothing until the first put
// (stdlib.md 2.8); free releases the table and leaves str_map{} however often
// it is called. A map with no table must answer every lookup rather than
// index a span of no entries.
fn i32 main() {
    strmap.str_map mut m = strmap.create();
    defer strmap.free(&m);
    println(strmap.count(&m), " ", m.live, " ", m.used, " ", m.entries.ptr == null);

    // Every lookup on the empty map is answered without a table.
    i64 mut got = -7;
    println(strmap.get(&m, "absent", &got), " ", m.entries.len);
    println(strmap.has(&m, "absent"), " ", strmap.remove(&m, "absent"));

    // The first put allocates the floor capacity of 16.
    println(strmap.put(&m, "one", 1), " ", m.entries.len, " ", strmap.count(&m), " ",
            m.entries.ptr == null);

    strmap.free(&m);
    println(strmap.count(&m), " ", m.live, " ", m.used, " ", m.entries.ptr == null);
    strmap.free(&m);
    println(strmap.count(&m), " ", m.live, " ", m.used, " ", m.entries.ptr == null);
    return 0;
}
