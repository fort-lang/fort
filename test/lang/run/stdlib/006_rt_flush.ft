//! run
//! exit: 3
//! stdout:
//| buffered
//| direct
import std.libc;
import std.rt;

// The runtime's print buffers (D11.5) and the two flush entry points
// std.rt declares (stdlib.md 2.11, 3): a program that writes through
// libc.write after printing flushes first, or the two streams interleave
// wrongly. libc.exit does not flush them; sys.exit does (2.2, 2.1).
fn raw(string s) void {
    libc.write(1, cast(s.ptr, u8*), s.len);
}

fn main() i32 {
    print("buffered\n");
    rt.flush(1);
    raw("direct\n");

    // flush_all writes out every buffer, so the same holds for a
    // program that does not name the descriptor.
    print("");
    rt.flush_all();

    // libc.exit does not flush the runtime's buffers, so this line is lost;
    // programs call sys.exit instead (stdlib.md 2.2).
    print("lost\n");
    libc.exit(3);
}
