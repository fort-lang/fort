//! run
//! abort
//! stderr: src/app.ft:12:9: runtime error: index 5 out of range for length 3
//! stdout:
//| src/app.ft:12:9: runtime error: index 5 out of range for length 3
//| before
import std.rt;

// fail_bounds writes the line an index outside a span or an array produces
// (D11.4, toolchain.md 5.2). A real index check calls this same entry point,
// and run/errors/001 holds that one to this same text. Calling it directly
// with the same values holds the text the runtime builds against the text the
// print family builds: the println below formats the position, the signed
// index and the length, and so does fail_bounds.
string FILE = "src/app.ft";

fn i32 main() {
    u32 line = 12;
    u32 col = 9;
    i64 index = 5;
    u64 len = 3;
    // This line is built by the print family. The flush below puts it out
    // before the failure path writes anything, so the two directives above
    // hold one text against both ways of building it, the position and every
    // digit included.
    println(FILE, ":", line, ":", col, ": runtime error: index ", index,
            " out of range for length ", len);
    rt.flush_all();

    // This line stays in the buffer. The failure path calls flush_all, and
    // that call puts the line on stdout before it writes to stderr (D11.4).
    rt.print_str(1, "before\n".ptr, 7);
    rt.fail_bounds(index, len, FILE.ptr, line, col);
}
