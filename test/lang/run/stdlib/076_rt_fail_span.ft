//! run
//! abort
//! stderr: src/app.ft:7:21: runtime error: span bounds 2..7 out of range for length 3
//! stdout:
//| src/app.ft:7:21: runtime error: span bounds 2..7 out of range for length 3
//| before
import std.rt;

// fail_span writes the line a span expression outside its operand produces
// (D11.4, toolchain.md 5.2). hi is len for e[lo..] (toolchain.md 5.1). The C
// entry point writes run/errors/002's text, value for value.
string FILE = "src/app.ft";

fn i32 main() {
    u32 line = 7;
    u32 col = 21;
    i64 lo = 2;
    i64 hi = 7;
    u64 len = 3;
    // This line is built by the print family. The flush below puts it out
    // before the failure path writes anything, so the two directives above
    // hold one text against both ways of building it, the position and every
    // digit included.
    println(FILE, ":", line, ":", col, ": runtime error: span bounds ", lo, "..", hi,
            " out of range for length ", len);
    rt.flush_all();

    // This line stays in the buffer. The failure path calls flush_all, and
    // that call puts the line on stdout before it writes to stderr (D11.4).
    rt.print_str(1, "before\n".ptr, 7);
    rt.fail_span(lo, hi, len, FILE.ptr, line, col);
}
