//! run
//! stdout:
//| 0 0
//| 4 0
//| 0 4
//| 0 0 0 0
//| 4 4 4 4
//| 2 2 5 5
//| 0 5 -1
import std::str;

// The first and the last byte of a string are the positions index_of and
// last_index_of are likeliest to get wrong, because a loop that stops one
// short of either end still answers every interior case (stdlib.md 2.5).
// Each pair below pins one end that the interior cases cannot reach.
fn i32 main() {
    // A one-byte string: the only position is both the first and the last.
    println(str.index_of("a", 'a'), " ", str.last_index_of("a", 'a'));

    // The last byte, reached by index_of because it occurs once and it is
    // last, and the first byte, reached by last_index_of for the same reason.
    println(str.index_of("hello", 'o'), " ", str.last_index_of("hello", 'h'));
    println(str.index_of("hello", 'h'), " ", str.last_index_of("hello", 'o'));

    // A byte at every position: each function keeps its own end.
    println(str.index_of("aaaaa", 'a'), " ", str.index_of("abbbb", 'a'), " ",
            str.last_index_of("aaaaa", 'a') - 4, " ", str.last_index_of("bbbba", 'a') - 4);
    println(str.last_index_of("aaaaa", 'a'), " ", str.last_index_of("bbbba", 'a'), " ",
            str.index_of("aaaaa", 'a') + 4, " ", str.index_of("abbbb", 'a') + 4);

    // The same two ends for a repeated byte with something between them.
    println(str.index_of("ccacc", 'a'), " ", str.last_index_of("ccacc", 'a'), " ",
            str.index_of("ccaccxa", 'a') + 3, " ", str.last_index_of("axccacc", 'a') + 1);

    // find at both ends, and a needle that reaches past the last position.
    println(str.find("hello", "he"), " ", str.find("hellox", "x"), " ",
            str.find("hello", "lox"));
    return 0;
}
