//! run
//! abort
//! stderr: runtime error: integer overflow
//! stdout:
//| before
import std.math;

// math.abs_i32(I32_MIN) has no answer in an i32: the magnitude is one above
// I32_MAX. `x < 0 ? -x : x` therefore negates the minimum, which a checked
// build traps (D11.1, stdlib.md 2.9). run/modes/030 is the same call in release
// mode, where it yields the minimum again.
fn i32 main() {
    i32 x = math.I32_MIN;
    println("before");
    println(math.abs_i32(x));
    return 0;
}
