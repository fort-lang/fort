//! run
//! abort
//! stderr: panic: str.from_cbuf: no NUL in the buffer
//! stdout:
//| before
import std.str;

// An empty buffer holds no NUL, so str.from_cbuf panics for it as for each buffer with no NUL
// (stdlib.md 2.5, D13.3). A from_cbuf that gave back the empty string here would wrap a buffer
// that C wrote no C string into.
fn main() i32 {
    u8[4] mut buf = {};
    println("before");
    string none = str.from_cbuf(buf[..0]);
    println("not reached ", none.len);
    return 0;
}
