//! run
//! stdout:
//| 30 10 20
//| 10 20 30
//| 10 20 30
//| 30 10 20
//| fig apple pear
//| apple fig pear
import std.sort;
import std.str;

// sort_ptr orders an array of void*: it permutes the slots, so they must be
// writable, and it never writes through a pointee, so the pointees need not be
// (stdlib.md 2.10). A caller holds slots of `void*`: a cast from slots of
// `void mut*`, which is what vec.ptr_vec holds (2.7), would change the type of
// a pointer place behind the `mut` level 1, which D3.14 refuses. The pointees
// are borrowed: the sort moves the pointers and never reads through one, and a
// comparator that orders by pointee reads them itself. That is the second way
// stdlib.md 2.10 gives of ordering data the sort may not move.

fn by_pointee(void* a, void* b) i32 {
    i64* p = *cast(a, i64**);
    i64* q = *cast(b, i64**);
    return sort.cmp_i64(cast(p, void*), cast(q, void*));
}

fn by_pointed_text(void* a, void* b) i32 {
    string* p = *cast(a, string**);
    string* q = *cast(b, string**);
    return str.cmp(*p, *q);
}

fn main() i32 {
    // The owner is one allocation and every pointer below borrows one of its
    // elements. The order of the allocation never changes.
    i64 mut@ own values = new(i64, 3);
    defer del(values);
    values[0] = 30;
    values[1] = 10;
    values[2] = 20;

    void*[3] mut ps = {cast(&values[0], void*), cast(&values[1], void*), cast(&values[2], void*)};
    println(*cast(ps[0], i64*), " ", *cast(ps[1], i64*), " ", *cast(ps[2], i64*));
    sort.sort_ptr(ps[..], by_pointee);
    println(*cast(ps[0], i64*), " ", *cast(ps[1], i64*), " ", *cast(ps[2], i64*));

    // A caller that allocates its slots with new(void*, n) holds the element
    // type the entry takes and reaches it with no cast at all (D5.8, T-135).
    void* mut@ own slots = new(void*, 3);
    defer del(slots);
    slots[0] = cast(&values[0], void*);
    slots[1] = cast(&values[1], void*);
    slots[2] = cast(&values[2], void*);
    sort.sort_ptr(slots, by_pointee);
    println(*cast(slots[0], i64*), " ", *cast(slots[1], i64*), " ", *cast(slots[2], i64*));

    // The elements themselves stayed where they were: only the three pointers
    // moved.
    println(values[0], " ", values[1], " ", values[2]);

    // Pointers to views sort the same way. A `string` is a pointer place, and the
    // slots hold `void*` views of the strings, so no `mut` cast hides one.
    string[3] mut words = {"fig", "apple", "pear"};
    void*[3] mut wp = {cast(&words[0], void*), cast(&words[1], void*), cast(&words[2], void*)};
    println(*cast(wp[0], string*), " ", *cast(wp[1], string*), " ", *cast(wp[2], string*));
    sort.sort_ptr(wp[..], by_pointed_text);
    println(*cast(wp[0], string*), " ", *cast(wp[1], string*), " ", *cast(wp[2], string*));
    return 0;
}
