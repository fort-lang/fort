//! run
//! stdout:
//| 30 10 20
//| 10 20 30
//| 30 10 20
//| fig apple pear
//| apple fig pear
import std.sort;
import std.str;
import std.vec;

// sort_ptr orders an array of void*: it permutes the slots, so they must be
// writable, and it never writes through a pointee, so the pointees need not be
// (stdlib.md 2.10). A caller holding void mut* slots, which is what
// vec.ptr_vec holds (2.7), drops the mark at level 2 with a cast; the implicit
// conversion refuses that drop behind a mutable level 1 (D5.4) and no cast
// puts the mark back (D3.14). The pointees are borrowed: the sort moves the
// pointers and never reads through one, and a comparator that orders by
// pointee reads them itself. That is the second way stdlib.md 2.10 gives of
// ordering data the sort may not move.

fn i32 by_pointee(void* a, void* b) {
    i64* p = *cast(a, i64**);
    i64* q = *cast(b, i64**);
    return sort.cmp_i64(cast(p, void*), cast(q, void*));
}

fn i32 by_pointed_text(void* a, void* b) {
    string* p = *cast(a, string**);
    string* q = *cast(b, string**);
    return str.cmp(*p, *q);
}

fn i32 main() {
    // The owner is one allocation and every pointer below borrows one of its
    // elements. The order of the allocation never changes.
    i64 mut@ own values = new(i64, 3);
    defer del(values);
    values[0] = 30;
    values[1] = 10;
    values[2] = 20;

    void mut*[3] mut ps = {cast(&values[0], void mut*), cast(&values[1], void mut*),
                           cast(&values[2], void mut*)};
    println(*cast(ps[0], i64*), " ", *cast(ps[1], i64*), " ", *cast(ps[2], i64*));
    sort.sort_ptr(cast(ps[..], void* mut@), by_pointee);
    println(*cast(ps[0], i64*), " ", *cast(ps[1], i64*), " ", *cast(ps[2], i64*));

    // The elements themselves stayed where they were: only the three pointers
    // moved.
    println(values[0], " ", values[1], " ", values[2]);

    // A ptr_vec holds the same element type, so its live prefix sorts with the
    // same entry. The vector owns its slots and borrows every pointer in them
    // (stdlib.md 1.3), which is exactly what this sort needs.
    string[3] mut words = {"fig", "apple", "pear"};
    vec.ptr_vec mut v = vec.ptr_create();
    defer vec.ptr_free(&v);
    vec.ptr_push(&v, cast(&words[0], void mut*));
    vec.ptr_push(&v, cast(&words[1], void mut*));
    vec.ptr_push(&v, cast(&words[2], void mut*));
    println(*cast(v.items[0], string*), " ", *cast(v.items[1], string*), " ",
            *cast(v.items[2], string*));
    sort.sort_ptr(cast(v.items[0..v.len], void* mut@), by_pointed_text);
    println(*cast(v.items[0], string*), " ", *cast(v.items[1], string*), " ",
            *cast(v.items[2], string*));
    return 0;
}
