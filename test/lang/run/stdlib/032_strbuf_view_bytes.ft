//! run
//! stdout:
//| 0 0 true
//| 0 0 true
//| 3 3 abc true
//| 3 3 abc
//| 5 5 abcde
//| 97 98 99
import std.strbuf;

// view and bytes are two spellings of the same alias of the bytes in use
// (stdlib.md 2.6): they stop at len, not at the capacity, they alias the
// buffer's own storage rather than copying it, and they follow the buffer as
// it grows.

// Whether `bytes` starts at the storage of `b`. The `.ptr` of each is an operand of `==`, and a
// cast of a span drops the `mut` and the `own` of the storage (D3.5). A read through a pointer:
// the owner is no local owner here (D17.21).
fn at_data(strbuf.str_buf* b, u8@ bytes) bool {
    return bytes.ptr == cast(b->data, u8@).ptr;
}

// The first three bytes. raw is a parameter, so a read of it uses no local owner here
// (D17.21).
fn show_three(u8@ raw) void {
    println(raw[0], " ", raw[1], " ", raw[2]);
}

fn main() i32 {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    // An empty buffer with no storage views as the empty string.
    println(strbuf.view(&b).len, " ", strbuf.bytes(&b).len, " ", strbuf.view(&b).ptr == null);
    // With storage but nothing in it, the view is still empty.
    strbuf.reserve(&b, 16);
    println(strbuf.view(&b).len, " ", strbuf.bytes(&b).len, " ", strbuf.view(&b).len == 0);

    // Three bytes in a buffer of sixteen: the view is three long and starts
    // at the buffer's own storage.
    strbuf.append(&b, "abc");
    println(strbuf.view(&b).len, " ", strbuf.bytes(&b).len, " ", strbuf.view(&b), " ",
            at_data(&b, strbuf.bytes(&b)));
    println(b.data.len - 13, " ", b.len, " ", cast(strbuf.bytes(&b), string));

    // A later append lengthens what the next call returns.
    strbuf.append(&b, "de");
    println(strbuf.view(&b).len, " ", strbuf.bytes(&b).len, " ", strbuf.view(&b));

    // bytes gives the byte family, so the elements are numbers (D3.14).
    u8@ raw = strbuf.bytes(&b);
    show_three(raw);
    return 0;
}
