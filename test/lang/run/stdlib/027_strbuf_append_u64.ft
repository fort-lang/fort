//! run
//! stdout:
//| 0
//| 0
//| 7
//| 7
//| 10
//| 10
//| 99
//| 99
//| 100
//| 100
//| 4294967296
//| 4294967296
//| 18446744073709551615
//| 18446744073709551615
//| 0123456789
import std.strbuf;

// append_u64 must produce the digits print produces (D11.7, stdlib.md 2.6),
// so every value below is written twice: once through the buffer and once
// through println. The interesting ones are zero, which the digit loop cannot
// reach, the powers of ten either side of a carry, and the widest u64 there
// is, which has twenty digits.
fn void both(u64 v) {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append_u64(&b, v);
    println(strbuf.view(&b));
    println(v);
}

fn i32 main() {
    both(0);
    both(7);
    both(10);
    both(99);
    both(100);
    both(4294967296);
    both(18446744073709551615);

    // Appending several numbers one after another leaves them in order, with
    // no separator of the function's own.
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    u64 mut i = 0;
    while (i < 10) {
        strbuf.append_u64(&b, i);
        i += 1;
    }
    println(strbuf.view(&b));
    return 0;
}
