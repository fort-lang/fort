//! run
//! stdout:
//| 3 3 3
//| true 2 3
//| false 5 false
//| false 2
//| true true
//| 0 3 16
//| true 1 3 16
//| 4
import std.strmap;

// remove takes an entry out and says whether it was there (stdlib.md 2.8).
// What the table keeps is the point: live falls, used does not, the capacity
// does not move, and the map answers correctly when every entry has gone.
fn main() i32 {
    strmap.str_map mut m = strmap.create();
    defer strmap.free(&m);
    strmap.put(&m, "one", 1);
    strmap.put(&m, "two", 2);
    strmap.put(&m, "three", 3);
    println(strmap.count(&m), " ", m.live, " ", m.used);

    println(strmap.remove(&m, "two"), " ", strmap.count(&m), " ", m.used);

    // The value is gone with the key, and *out keeps what the caller left.
    i64 mut out = 5;
    println(strmap.get(&m, "two", &out), " ", out, " ", strmap.has(&m, "two"));
    // Removing it a second time says it was not there.
    println(strmap.remove(&m, "two"), " ", strmap.count(&m));
    // The keys beside it are untouched.
    println(strmap.has(&m, "one"), " ", strmap.has(&m, "three"));

    // Emptying the map leaves the table and its tombstones standing.
    strmap.remove(&m, "one");
    strmap.remove(&m, "three");
    println(strmap.count(&m), " ", m.used, " ", m.entries.len);

    // A key can be put back afterwards; this insert fits the load factor, so
    // no rebuild happens and the tombstone count still stands.
    println(strmap.put(&m, "two", 4), " ", strmap.count(&m), " ", m.used, " ", m.entries.len);
    i64 mut back = 0;
    strmap.get(&m, "two", &back);
    println(back);
    return 0;
}
