//! run
//! abort
//! stderr: src/app.ft:20:22: runtime error: overwriting owned value
//! stdout:
//| src/app.ft:20:22: runtime error: overwriting owned value
//| before
import std.rt;

// An assignment to an own reference-typed lvalue that is not zero calls
// fail_overwrite (D17.11). The compiler emits that call in checked builds
// only. run/errors/025 holds the C entry point to this text, the position
// included.
string FILE = "src/app.ft";

fn i32 main() {
    u32 line = 20;
    u32 col = 22;
    // The C runtime writes the same line. The compiler still lowers every
    // println to it (D12.2). This flushes that line before the fort runtime
    // writes anything, so the two directives above hold one text against both
    // runtimes, the position and every digit included.
    println(FILE, ":", line, ":", col, ": runtime error: overwriting owned value");
    rt.fort_rt_flush_all();

    // This line stays in the fort runtime's buffer. The failure path calls
    // flush_all, and that call puts the line on stdout before it writes to
    // stderr (D11.4).
    rt.print_str(1, "before\n".ptr, 7);
    rt.fail_overwrite(FILE.ptr, line, col);
}
