//! run
//! exit: 7
//! stdout:
//| buffered, not yet flushed
import std.rt;

// exit flushes every runtime buffer and ends the process with status & 0xFF
// (D11.6, toolchain.md 5.1). The deferred statements of the calling function
// do not run. run/stdlib/020 drives the C entry point through sys.exit. The
// status below is 263, and one byte of 263 is 7, so the harness compares the
// masked status and not the number passed.
fn i32 main() {
    defer println("deferred, must not run");
    string line = "buffered, not yet flushed\n";
    rt.print_str(1, line.ptr, line.len);
    rt.exit(263);
}
