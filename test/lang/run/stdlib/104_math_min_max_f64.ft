//! run
//! stdout:
//| 1.0 2.0 1.0 2.0
//| -2.5 -2.5 0.5 0.5
//| -inf inf -inf inf
//| true true
//| nan 1.0 nan 1.0
//| true false true false
//| 0.0 -0.0 -0.0 0.0
import std.math;

// math.min_f64 and math.max_f64 (stdlib.md 2.9): `a < b ? a : b` and
// `a > b ? a : b` over f64.
//
// Two cases of these two functions are not the integer ones. A comparison
// against a NaN is false (D6.12), so a NaN in either operand makes the answer
// `b` and nothing propagates; and the two zeros compare equal, so the answer is
// whichever one `b` is. stdlib.md 2.9 says both, and a caller that wants IEEE
// 754 minNum writes its own test.
fn i32 main() {
    f64 nan = math.f64_nan();
    f64 inf = math.f64_inf();

    // The ordinary cases, both orders.
    println(math.min_f64(1.0, 2.0), " ", math.max_f64(1.0, 2.0), " ",
            math.min_f64(2.0, 1.0), " ", math.max_f64(2.0, 1.0));
    println(math.min_f64(-2.5, 0.5), " ", math.min_f64(0.5, -2.5), " ",
            math.max_f64(-2.5, 0.5), " ", math.max_f64(0.5, -2.5));

    // The infinities are ordered, so they behave like any other operand.
    println(math.min_f64(-inf, inf), " ", math.max_f64(-inf, inf), " ",
            math.min_f64(-inf, 0.0), " ", math.max_f64(inf, 0.0));

    // Equal operands return that value.
    println(math.min_f64(1.5, 1.5) == 1.5, " ", math.max_f64(1.5, 1.5) == 1.5);

    // A NaN in either operand returns b, because every comparison with it is
    // false. So `b` is the answer whichever side the NaN is on.
    println(math.min_f64(1.0, nan), " ", math.min_f64(nan, 1.0), " ",
            math.max_f64(1.0, nan), " ", math.max_f64(nan, 1.0));
    println(math.is_nan(math.min_f64(1.0, nan)), " ",
            math.is_nan(math.min_f64(nan, 1.0)), " ",
            math.is_nan(math.max_f64(1.0, nan)), " ",
            math.is_nan(math.max_f64(nan, 1.0)));

    // The two zeros are equal, so neither comparison holds and the answer is
    // `b` in all four calls. The printer shows the sign (D11.7), which is the
    // one way to see which operand came back.
    f64 negative_zero = math.f64_from_bits(0x8000000000000000);
    println(math.min_f64(negative_zero, 0.0), " ", math.min_f64(0.0, negative_zero),
            " ", math.max_f64(0.0, negative_zero), " ",
            math.max_f64(negative_zero, 0.0));
    return 0;
}
