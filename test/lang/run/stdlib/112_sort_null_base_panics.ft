//! run
//! abort
//! stderr: panic: sort.sort: null base
//! stdout:
//| empty is not an error
import std.sort;

// A null base with elements to order is a caller that lost its storage, so it
// panics (stdlib.md 1.2, 2.10). A null base with no elements is not an error:
// the zero value of a span is {null, 0} (D3.5), and the first call below is
// the ordinary way to reach the sort with nothing to order.
//
// The failing call names one element. One element is already sorted, so an
// implementation that tested the count first would return and print the line
// after it; the preconditions come first (stdlib.md 2.10).
fn i32 main() {
    i64 mut@ empty = {};
    sort.sort_i64(empty, sort.cmp_i64);
    sort.sort(null, 0, sizeof(i64), sort.cmp_i64);
    println("empty is not an error");
    sort.sort(null, 1, sizeof(i64), sort.cmp_i64);
    println("not reached");
    return 0;
}
