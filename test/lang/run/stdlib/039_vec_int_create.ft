//! run
//! stdout:
//| 0 0 true
//| 0 8 false
//| 0 0 false
//| 0 0 true
//| 0 0 true
import std.vec;

// The int_vec of stdlib.md 2.7 is the pattern of each other element type, so
// a typed copy answers the same way: int_create allocates nothing,
// int_with_cap allocates up front, int_with_cap(0) allocates no elements, and
// int_free leaves int_vec{} however often it is called.
fn main() i32 {
    vec.int_vec mut empty = vec.int_create();
    defer del(empty.items);
    println(empty.len, " ", empty.items.len, " ", empty.items.ptr == null);

    vec.int_vec mut v = vec.int_with_cap(8);
    defer vec.int_free(&v);
    println(v.len, " ", v.items.len, " ", v.items.ptr == null);

    vec.int_vec mut nothing = vec.int_with_cap(0);
    defer del(nothing.items);
    println(nothing.len, " ", nothing.items.len, " ", nothing.items.ptr == null);

    vec.int_free(&v);
    println(v.len, " ", v.items.len, " ", v.items.ptr == null);
    vec.int_free(&v);
    println(v.len, " ", v.items.len, " ", v.items.ptr == null);
    return 0;
}
