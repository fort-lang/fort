//! run
//! stdout:
//| 2 3 -1
//| 0 4 -1
//| 2 0 -1
//| 0 0 0
//| -1 -1
//| 0 3
import std.str;

// index_of, last_index_of and find report a position as i64, or -1
// (stdlib.md 2.5). An empty needle is found at 0.
fn i32 main() {
    println(str.index_of("hello", 'l'), " ", str.last_index_of("hello", 'l'), " ",
            str.index_of("hello", 'z'));
    println(str.index_of("hello", 'h'), " ", str.last_index_of("hello", 'o'), " ",
            str.last_index_of("hello", 'z'));
    println(str.find("hello", "llo"), " ", str.find("hello", "hell"), " ",
            str.find("hello", "lol"));
    // An empty needle is found at 0, even in an empty string.
    println(str.find("hello", ""), " ", str.find("", ""), " ", str.find("aaaa", ""));
    // Nothing is found in the empty string, and no needle longer than it.
    println(str.index_of("", 'a'), " ", str.find("ab", "abc"));
    // The first occurrence wins, and a needle may overlap itself.
    println(str.find("aaaa", "aa"), " ", str.find("abcabc", "abc"[0..3]) + 3);
    return 0;
}
