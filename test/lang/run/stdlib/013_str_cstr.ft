//! run
//! stdout:
//| 5 4 path
//| 1 0 true
//| 3 abc
//| 0 true true true
//| 0 true
//| 6 6
import extern;
import std.libc;
import std.str;

// str.to_cstr is the one sanctioned way to hand a string to C (D13.4): an
// owned char span of length s.len + 1 whose .ptr is the C string, and
// str.from_cstr wraps a C string back without copying (stdlib.md 2.5).
// str.from_cbuf wraps the C string in a buffer and reads no byte past the
// buffer; from_cstr takes no .ptr (D3.5).
// C call libc.strlen x3: path.ptr, empty.ptr and cut.ptr name buffers that str.to_cstr gave, each
// with its NUL at index s.len (D9.8 rule 4); strlen reads to the first NUL, inside the buffer.
// C call str.from_cstr x2: null, of which from_cstr reads no byte; and &text[0], the buffer text
// that str.to_cstr gave, 7 bytes from element 0 (rule 2) with its NUL at index 6 (rule 4). The
// buffer lives until the defer of main.
fn main() i32 {
    char mut@ own path = str.to_cstr("path");
    defer del(path);
    println(path.len, " ", libc.strlen(path.ptr), " ", cast(path[..4], string));

    // to_cstr("") is one byte, the terminator, and C reads an empty string.
    char mut@ own empty = str.to_cstr("");
    defer del(empty);
    println(empty.len, " ", libc.strlen(empty.ptr), " ", empty.ptr != null);

    // An embedded NUL means C sees the prefix while fort still sees the whole.
    char mut@ own cut = str.to_cstr("abc\x00de");
    defer del(cut);
    println(libc.strlen(cut.ptr), " ", str.from_cbuf(cast(cut[..], u8@)));

    // from_cstr(null) is the zero string, not "": both have length 0 and D3.7
    // makes them ==, but a literal's .ptr is never null, so only the null .ptr
    // lets a caller tell the wrap of a null pointer from the wrap of an empty
    // C string (stdlib.md 2.5).
    string zero = str.from_cstr(null);
    println(zero.len, " ", zero == "", " ", zero.ptr == null, " ", "".ptr != null);
    // The wrap of an empty C string is empty too, but its .ptr is the C one.
    char mut@ own nothing = str.to_cstr("");
    defer del(nothing);
    string wrapped_empty = str.from_cbuf(cast(nothing[..], u8@));
    // .ptr of a string is char* and of a char mut@ is char mut*, and the
    // operands of == must be of identical type, mutability levels included:
    // the implicit drop of D5.4 reaches initialization, assignment, argument
    // passing and return, but not a comparison (D6.2). No cast takes a .ptr
    // (D3.5), so the span is cast to a string first.
    println(wrapped_empty.len, " ", wrapped_empty.ptr == cast(nothing, string).ptr);

    // The wrap is a view: it aliases the bytes rather than copying them. The
    // address of the first element goes to from_cstr, which reads to the NUL.
    char mut@ own text = str.to_cstr("abcdef");
    defer del(text);
    string wrapped = str.from_cbuf(cast(text[..], u8@));
    println(wrapped.len, " ", str.from_cstr(&text[0]).len);
    return 0;
}
