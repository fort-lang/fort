//! run
//! stdout:
//| true false
//| -3 1 4 9
//| 9 4 1 -3
//| calls above zero: true
//| 64 sorted, sum 20676
//| ties keep every element: true
import std.sort;

// The comparator of stdlib.md 2.10 is an ordinary function value (D3.10): it
// is held in a variable, compared for identity, passed through a parameter and
// called by C, which is what makes the sort usable without generics.

u64 mut calls = 0;

fn i32 counted(void* a, void* b) {
    calls += 1;
    return sort.cmp_i64(a, b);
}

fn i32 down(void* a, void* b) {
    return sort.cmp_i64(b, a);
}

// A comparator reaches the sort through a parameter as easily as through a
// module name, which is how a caller chooses an order at run time.
fn void order_with(i64 mut@ xs, fn i32(void*, void*) cmp) {
    sort.sort_i64(xs, cmp);
}

fn void show(i64@ xs) {
    for (u64 mut i = 0; i < xs.len; i += 1) {
        if (i > 0) {
            print(" ");
        }
        print(xs[i]);
    }
    println("");
}

// Everything ties, so the order is unspecified. What is specified is that the
// call permutes: each of the four values is still there afterwards.
fn i32 tie(void* a, void* b) {
    return 0;
}

fn bool holds_each(i64@ xs) {
    i64[4] mut wanted = {1, 2, 3, 4};
    for (u64 mut w = 0; w < 4; w += 1) {
        bool mut found = false;
        for (u64 mut i = 0; i < xs.len; i += 1) {
            if (xs[i] == wanted[w]) {
                found = true;
            }
        }
        if (!found) {
            return false;
        }
    }
    return true;
}

fn i32 main() {
    // A qualified name is a value and identity is what == compares (D3.10,
    // D3.13), so the variable and the name are the same function.
    fn i32(void*, void*) cmp = sort.cmp_i64;
    println(cmp == sort.cmp_i64, " ", cmp == down);

    i64[4] mut xs = {4, -3, 9, 1};
    order_with(xs[..], cmp);
    show(xs[..]);
    order_with(xs[..], down);
    show(xs[..]);

    // C calls back into fort, so the counter moves. The exact number is
    // qsort's business and the test does not pin it.
    i64[8] mut ys = {8, 3, 7, 1, 6, 2, 5, 4};
    sort.sort_i64(ys[..], counted);
    println("calls above zero: ", calls > 0);

    // A longer array, which is where qsort does real work. The check is the
    // whole contract: every adjacent pair is ordered and the sum says no
    // element was lost or duplicated.
    i64[64] mut many = {};
    i64 mut seed = 17;
    for (u64 mut i = 0; i < 64; i += 1) {
        seed = (seed * 37 + 11) % 641;
        many[i] = seed;
    }
    sort.sort_i64(many[..], sort.cmp_i64);
    bool mut ordered = true;
    i64 mut sum = 0;
    for (u64 mut i = 0; i < 64; i += 1) {
        sum += many[i];
        if (i > 0 && many[i - 1] > many[i]) {
            ordered = false;
        }
    }
    if (ordered) {
        println("64 sorted, sum ", sum);
    } else {
        println("64 out of order, sum ", sum);
    }

    i64[4] mut ties = {3, 1, 4, 2};
    sort.sort_i64(ties[..], tie);
    println("ties keep every element: ", holds_each(ties[..]));
    return 0;
}
