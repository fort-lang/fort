//! run
//! abort
//! stderr: strbuf.reserve: capacity overflow
//! stdout:
//| 3 16
import std.strbuf;

// A capacity that cannot be represented is caught before it is computed: the
// sum len + extra is tested against the u64 maximum, never performed and
// examined afterwards, so a checked build does not trap on the addition and a
// release build does not wrap to a small capacity and overrun the storage
// (D3.1, D11.1). The library reports it as the programming error it is
// (D13.3); run/modes/012 runs the same program in release mode.
fn i32 main() {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append(&b, "abc");
    println(b.len, " ", b.data.len);
    // 3 bytes are in use, so the largest extra that could be represented is
    // three below the maximum; this is one above it.
    u64 u64_max = 18446744073709551615;
    strbuf.reserve(&b, u64_max - 2);
    println("not reached");
    return 0;
}
