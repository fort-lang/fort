//! run
//! abort
//! stderr: vec.int_reserve: capacity overflow
//! stdout:
//| 2 16
//| 2 100
import std.vec;

// A capacity that cannot be represented is caught before it is computed, as
// in strbuf: the sum len + extra is tested against the u64 maximum and never
// performed, so a checked build does not trap on the addition and a release
// build does not wrap to a capacity below the length (D3.1, D11.1). The
// library reports it as the programming error it is (D13.3).
fn main() i32 {
    vec.int_vec mut v = vec.int_create();
    defer vec.int_free(&v);
    vec.int_push(&v, 1);
    vec.int_push(&v, 2);
    println(v.len, " ", v.items.len);

    // A reservation that can be represented is served whatever its size.
    vec.int_reserve(&v, 98);
    println(v.len, " ", v.items.len);

    u64 u64_max = 18446744073709551615;
    vec.int_reserve(&v, u64_max - 1);
    println("not reached");
    return 0;
}
