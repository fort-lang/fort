//! run
//! stdout:
//| true true true false
//| true true true false
//| true true
//| false false
//| true true false
import std.str;

// starts_with is prefix.len <= s.len && s[..prefix.len] == prefix, and
// ends_with its mirror image (stdlib.md 2.5).
fn i32 main() {
    println(str.starts_with("hello", "hel"), " ", str.starts_with("hello", "hello"), " ",
            str.starts_with("hello", ""), " ", str.starts_with("hello", "help"));
    println(str.ends_with("hello", "llo"), " ", str.ends_with("hello", "hello"), " ",
            str.ends_with("hello", ""), " ", str.ends_with("hello", "ello!"));
    // An empty prefix or suffix matches even the empty string.
    println(str.starts_with("", ""), " ", str.ends_with("", ""));
    // A prefix longer than the string never matches, whatever its bytes.
    println(str.starts_with("ab", "abc"), " ", str.ends_with("ab", "zab"));
    // Sub-strings work like any other string.
    string text = "prefix-body-suffix";
    println(str.starts_with(text[7..], "body"), " ", str.ends_with(text[..11], "body"), " ",
            str.starts_with(text[7..], "prefix"));
    return 0;
}
