//! run
//! stdout:
//| 42 false 42
//| false false
//| true 7
//| false 7
//| false 7
//| 1 1
import std.strmap;

// What a map says about a key it does not hold (D13.3, stdlib.md 2.8): get
// leaves *out exactly as it was, has and remove answer false, and none of the
// three changes the table. The interesting one is a miss on a table that is
// not empty, whose probe must stop at the first empty slot rather than walk
// for ever.
fn i32 main() {
    strmap.str_map mut m = strmap.create();
    defer strmap.free(&m);

    i64 mut out = 42;
    println(out, " ", strmap.get(&m, "nothing", &out), " ", out);
    println(strmap.has(&m, "nothing"), " ", strmap.remove(&m, "nothing"));

    strmap.put(&m, "here", 7);
    println(strmap.has(&m, "here"), " ", strmap.count(&m) + 6);

    // A miss beside a hit: *out keeps the value the caller left in it.
    i64 mut kept = 7;
    println(strmap.get(&m, "her", &kept), " ", kept);
    println(strmap.get(&m, "heree", &kept), " ", kept);

    // Neither miss touched the entry that is there.
    i64 mut found = 0;
    strmap.get(&m, "here", &found);
    println(found - 6, " ", strmap.count(&m));
    return 0;
}
