//! run
//! abort
//! stderr: src/app.ft:1:1: runtime error: negative allocation count -9223372036854775808
//! stdout:
//| src/app.ft:1:1: runtime error: negative allocation count -9223372036854775808
//| before
import std.rt;

// message_i64 formats the numbers inside a failure line. It is a different
// caller from the emit_i64 that print_i64 uses, and run/stdlib/089 sweeps
// only that one. An off-by-one here prints nothing at all, because the
// failure path writes one line and then aborts, so the widest value gets a
// test of its own.
//
// The count is i64's minimum. No i64 holds its magnitude, so format_i64 takes
// that magnitude in u64 and wraps (D11.2). The magnitude is 19 digits and the
// minus takes the twentieth byte of a DECIMAL_MAX array, so this value fills
// the array exactly. run/modes/021 passes the same count in the release
// build; this one passes it in the checked build, where an underflow in
// format_i64 would trap and call this same path again.
string FILE = "src/app.ft";

fn i32 main() {
    u32 line = 1;
    u32 col = 1;
    i64 n = -9223372036854775808;
    println(FILE, ":", line, ":", col, ": runtime error: negative allocation count ", n);
    rt.fort_rt_flush_all();
    rt.print_str(1, "before\n".ptr, 7);
    rt.fail_alloc_count(n, FILE.ptr, line, col);
}
