//! run
//! stdout:
//| true
//| true 11 hello world
//| true
//| true 0 true
//| false 0 true
//| 11 hello world
import std.io;

// read_file_bytes delivers the file as one exact-size allocation through a
// pointer to an own slot (stdlib.md 2.4, D17.2): the slot starts empty, the
// callee stores into it, and the caller dels it. An empty file still yields an
// allocation, and a failure leaves the slot as it was.
fn i32 main() {
    println(io.write_file("t028-bytes.txt", cast("hello world", u8@)));

    // The idiom of stdlib.md 1.3: declare the slot empty, defer its release,
    // then fill it.
    u8 mut@ own mut data = {};
    defer del(data);
    bool ok = io.read_file_bytes("t028-bytes.txt", &data);
    // len is the file's length exactly, not a buffer's capacity.
    println(ok, " ", data.len, " ", cast(data[..], string));

    println(io.write_file("t028-bytes-empty.txt", cast("", u8@)));
    u8 mut@ own mut none = {};
    defer del(none);
    println(io.read_file_bytes("t028-bytes-empty.txt", &none), " ", none.len, " ",
            none.ptr != null);

    // A file that is not there leaves its slot untouched, so the del below is
    // a no-op on a zero span (D17.9).
    u8 mut@ own mut missing = {};
    defer del(missing);
    println(io.read_file_bytes("t028-no-such-file.txt", &missing), " ", missing.len, " ",
            missing.ptr == null);

    // The first allocation is still the file's bytes after all of that.
    println(data.len, " ", cast(data[..], string));
    return 0;
}
