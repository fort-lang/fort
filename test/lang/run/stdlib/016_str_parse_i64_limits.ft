//! run
//! stdout:
//| true 9223372036854775807
//| true -9223372036854775808
//| false 1
//| false 1
//| false 1
//| false 1
//| true 999999999999999999
//| false 1
import std::str;

// The limits of i64 (D4.4, D3.1): MAX and MIN parse, one past each fails, a
// value whose digits overflow midway fails, and a failing parse leaves *out
// as it was (stdlib.md 1.2, 2.5). Overflow is detected arithmetically, before
// the multiply, so the checked and release builds agree (D11.1).
fn void show(string text) {
    i64 mut value = 1;
    bool ok = str.parse_i64(text, &value);
    println(ok, " ", value);
}

fn i32 main() {
    show("9223372036854775807");
    // MIN is accepted even though its magnitude has no i64 negation.
    show("-9223372036854775808");
    // One past MAX, and one past MIN.
    show("9223372036854775808");
    show("-9223372036854775809");
    // A magnitude that overflows u64 too, and one far beyond it.
    show("18446744073709551616");
    show("99999999999999999999999999999999");
    // The largest value with fewer digits than MAX, and its overflowing twin
    // whose product exceeds the limit only at the last digit.
    show("999999999999999999");
    show("9223372036854775810");
    return 0;
}
