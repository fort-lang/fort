//! run
//! signal: FPE
//! stdout:
//| before
// sys.raise_signal sends a signal to the process (stdlib.md 2.1). SIGFPE, 8 on both targets,
// ends the process, so the call does not return.
import std.io;
import std.sys;

fn main() i32 {
    println("before");
    io.flush(io.STDOUT);
    sys.raise_signal(8);
    println("after");
    return 0;
}
