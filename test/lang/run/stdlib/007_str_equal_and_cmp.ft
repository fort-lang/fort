//! run
//! stdout:
//| true false false true
//| 0 -1 1
//| -1 1 0
//| 1 -1
//| -1 1
import std.str;

// str.equal is ==, and str.cmp orders lexicographically by unsigned byte
// value with a proper prefix first (stdlib.md 2.5, D3.2).
fn main() i32 {
    println(str.equal("abc", "abc"), " ", str.equal("abc", "abd"), " ",
            str.equal("abc", "ab"), " ", str.equal("", ""));
    println(str.cmp("abc", "abc"), " ", str.cmp("abc", "abd"), " ", str.cmp("abd", "abc"));
    // A proper prefix sorts first, and the empty string before everything.
    println(str.cmp("ab", "abc"), " ", str.cmp("abc", "ab"), " ", str.cmp("", ""));
    println(str.cmp("a", ""), " ", str.cmp("", "a"));
    // Bytes at or above 0x80 are above every ASCII byte: unsigned order.
    println(str.cmp("\x01", "\xff"), " ", str.cmp("\xff", "\x01"));
    return 0;
}
