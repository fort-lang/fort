//! run
//! stdout:
//| true true
//| true true
//| true true
//| true true 0
//| true true
//| true true
//| freed
import extern;
import std.rt;

// new and del call alloc and free (D10.2, D10.3, toolchain.md 5.1). Each
// line below asks one question of a block new made and of a block alloc made:
// is it zeroed, is it not null, and does it accept a write to its last byte.
// The pair holds the lowering of the builtin against a direct call, which is
// what catches a `new` that asked for the wrong size or passed its arguments
// in the wrong order.
//
// The entry points are not called new and del. new is a keyword (D2.4). A
// module-level declaration named del would shadow the universe function, and
// std.rt calls del on its own storage (D12.2, D7.9).
string FILE = "070_rt_alloc_free.ft";

// bcmp(3) and bcopy(3) read and write the bytes of a block through a `void*`. A
// cast gives no type to a `void*` (D3.14), and no span of a pointer exists
// (D6.9), so these helpers hand the block to C as it is.
// C: bcmp, bcmp(3) of glibc and of macOS, <strings.h>; POSIX.1-2001, which POSIX.1-2008 removed.
// writes: nothing; C reads at most n bytes at a and at b. gives: 0 when the n bytes are the same,
// and another int when not; no pointer. keeps: no pointer. calls: no fort function. frees: nothing.
extern fn bcmp(void* a, void* b, u64 n) i32;
// C: bcopy, bcopy(3) of glibc and of macOS, <strings.h>; POSIX.1-2001, which POSIX.1-2008 removed.
// writes: n bytes at destination, which it reads from n bytes at source; the two can overlap.
// gives: no result. keeps: no pointer. calls: no fort function. frees: nothing.
extern fn bcopy(void* source, void mut* destination, u64 n) void;

// Answers whether all n bytes at p are zero, for an n above 0. D10.2 promises
// that of both. The parameter is void*, which alloc's void mut* own result
// reaches by the monotone drop of D5.4, so a reader writes no cast. bcmp holds
// the bytes against zeroed ones.
// C call bcmp: p and n are parameter sources (D9.8 rule 1), so all_zero is a boundary function, and
// each caller gives a block of at least n bytes. cast(&zeros[0], void*) keeps the bound of zeros
// from element 0, n bytes (rule 2), so n fits both.
fn all_zero(void* p, u64 n) bool {
    u8@ own zeros = new(u8, n);
    bool same = bcmp(p, cast(&zeros[0], void*), n) == 0;
    del(zeros);
    return same;
}

// Answers byte i of the block at p, through a copy of its first i + 1 bytes.
// C call bcopy: p and i are parameter sources (D9.8 rule 1), so byte_at is a boundary function, and
// each caller gives a block of at least i + 1 bytes. cast(&copy[0], void mut*) keeps the bound of
// copy from element 0, i + 1 bytes (rule 2), so i + 1 fits both.
fn byte_at(void* p, u64 i) u8 {
    u8 mut@ own copy = new(u8, i + 1);
    bcopy(p, cast(&copy[0], void mut*), i + 1);
    u8 v = copy[i];
    del(copy);
    return v;
}

// Writes one byte of a block alloc answered with. The parameter is void mut*,
// which is what alloc answers: a callee that writes takes the result as it
// comes. A caller that bound the result as void* own could not call this at
// all, because the drop of D5.4 runs one way only (D3.11, toolchain.md 5.1).
// bcopy copies the first i + 1 bytes out, and back with byte i set.
// C call bcopy x2: p and i are parameter sources (D9.8 rule 1), so poke is a boundary function, and
// each caller gives a block of at least i + 1 bytes. &copy[0], cast to void mut* or void*, keeps
// the bound of copy from element 0, i + 1 bytes (rule 2), so i + 1 fits both.
fn poke(void mut* p, u64 i, u8 v) void {
    u8 mut@ own copy = new(u8, i + 1);
    bcopy(p, cast(&copy[0], void mut*), i + 1);
    copy[i] = v;
    bcopy(cast(&copy[0], void*), p, i + 1);
    del(copy);
}

// C call rt.alloc x4: &FILE[0] names the global FILE, no mut global, which a literal initializes,
// with the NUL of that literal (D9.8 rule 4); the other arguments are integers.
// C call all_zero x4: cast(&from_new[0], void*) keeps the bound of from_new from element 0, n bytes
// (rule 2), with n; from_alloc with n, 64 bytes, zero_elem with 1, 1 byte, and large with big, big
// bytes, each storage that rt.alloc gave in main: the word gives: of its row states elem_size *
// count zeroed bytes, or 1 byte for a product of 0, never null (D9.8 rule 3).
// C call poke x2: from_alloc, the 64 bytes that rt.alloc gave (rule 3), with i 0 and n - 1, so i +
// 1 is at most 64.
// C call byte_at x2: from_alloc, 64 bytes, with i 0 and n - 1, as for poke.
// C call rt.free x5: null, and four blocks that rt.alloc gave in this function, which free takes
// (A3).
fn main() i32 {
    u64 n = 64;
    u8 mut@ own from_new = new(u8, n);
    void mut* own from_alloc = rt.alloc(1, n, &FILE[0], 1, 1);
    println(from_new.ptr != null, " ", all_zero(cast(&from_new[0], void*), n));
    println(from_alloc != null, " ", all_zero(from_alloc, n));

    // This writes the first and the last byte of each block. A count used as
    // a size, or a size used as a count, gives out a block that is too short,
    // and the last byte is where that shows. The two writes into the alloc
    // block go through poke, so the write crosses a void mut* parameter, and
    // the cast in poke adds no mut: alloc answered with the mark already.
    from_new[0] = 7;
    from_new[n - 1] = 9;
    poke(from_alloc, 0, 7);
    poke(from_alloc, n - 1, 9);
    println(from_new[0] == byte_at(from_alloc, 0), " ",
            from_new[n - 1] == byte_at(from_alloc, n - 1));

    // new(T, 0) allocates and does not answer null (D10.2). alloc gets there
    // by asking for one byte when the product is zero. An element size of zero
    // reaches the same line from the other side.
    i32@ own empty_new = new(i32, 0);
    void mut* own empty_alloc = rt.alloc(4, 0, &FILE[0], 1, 1);
    void mut* own zero_elem = rt.alloc(0, 100, &FILE[0], 1, 1);
    println(empty_new.ptr != null, " ", empty_alloc != null, " ", empty_new.len);
    println(zero_elem != null, " ", all_zero(zero_elem, 1));

    // A product larger than one page, zeroed the whole way. calloc zeroes a
    // large block by asking the kernel for fresh pages. That is a different
    // path in the C library from the small block above.
    u64 big = 1048576;
    void mut* own large = rt.alloc(8, big / 8, &FILE[0], 1, 1);
    println(large != null, " ", all_zero(large, big));

    // free releases what alloc answered with. A null p does nothing, and del
    // of a zero own value does nothing either (D10.3, D17.9).
    void* own nothing = null;
    rt.free(move(nothing));
    rt.free(move(from_alloc));
    rt.free(move(empty_alloc));
    rt.free(move(zero_elem));
    rt.free(move(large));
    del(from_new);
    del(empty_new);
    println("freed");
    return 0;
}
