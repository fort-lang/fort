//! run
//! abort
//! stderr: src/app.ft:33:12: runtime error: division by zero
//! stdout:
//| src/app.ft:33:12: runtime error: division by zero
//| before
import extern;
import std.rt;

// A division or a remainder by zero is a runtime error in both build modes
// (D11.3, D11.4). run/errors/006 holds the C entry point to this text.
string FILE = "src/app.ft";

// C call rt.fail_div_zero: &FILE[0] names the first byte of the global FILE, no mut global, which
// the literal "src/app.ft" initializes, so its bytes end in the NUL of that literal (D9.8 rule 4,
// D3.7), and fail_div_zero reads them to that NUL. The other arguments are integers.
fn main() i32 {
    u32 line = 33;
    u32 col = 12;
    // This line is built by the print family. The flush below puts it out
    // before the failure path writes anything, so the two directives above
    // hold one text against both ways of building it, the position and every
    // digit included.
    println(FILE, ":", line, ":", col, ": runtime error: division by zero");
    rt.flush_all();

    // This line stays in the buffer. The failure path calls flush_all, and
    // that call puts the line on stdout before it writes to stderr (D11.4).
    rt.print_str(1, "before\n");
    rt.fail_div_zero(&FILE[0], line, col);
}
