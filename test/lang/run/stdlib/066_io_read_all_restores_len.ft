//! run
//! link: ffi/std_io_fds.c
//! stdout:
//| true 5 hello
//| false 5 hello
//| false 5 hello
import extern;
import std.io;
import std.strbuf;

// read_all restores out->len when a read fails (stdlib.md 2.4), and the case
// that says anything is a read that fails after another has succeeded: the
// first read adds bytes to the buffer, and the restore has to undo those and
// not merely leave a length it never moved. The helper's descriptor holds a
// hundred bytes and then fails rather than reporting end of file.
// C: std_io_pipe_with_bytes, test/lang/ffi/std_io_fds.c, which makes a pipe (pipe(2)), writes n
// bytes 'p' into it and sets O_NONBLOCK on its read end (fcntl(2)).
// gives: the read descriptor, which the caller closes, or -1. writes: no fort storage. keeps: no
// pointer; C keeps the write descriptor open until the process ends. calls: no fort function.
// frees: nothing.
extern fn std_io_pipe_with_bytes(i64 n) i32;

// C call std_io_pipe_with_bytes: no pointer argument.
fn main() i32 {
    strbuf.str_buf mut buf = strbuf.create();
    defer del(buf.data);
    strbuf.append(&buf, "hello");

    i32 fd = std_io_pipe_with_bytes(100);
    println(fd >= 0, " ", buf.len, " ", strbuf.view(&buf));

    // A hundred bytes arrive, then the read fails: what the caller gave is
    // what the caller gets back, storage grown but contents unchanged.
    println(io.read_all(fd, &buf), " ", buf.len, " ", strbuf.view(&buf));
    io.close(fd);

    // The same through read_file's descriptor-owning path: a directory opens
    // and fails on the first read, so nothing was added to undo.
    println(io.read_file(".", &buf), " ", buf.len, " ", strbuf.view(&buf));
    return 0;
}
