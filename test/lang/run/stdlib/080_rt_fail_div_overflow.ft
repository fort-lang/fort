//! run
//! abort
//! stderr: src/app.ft:41:5: runtime error: division overflow
//! stdout:
//| src/app.ft:41:5: runtime error: division overflow
//| before
import std.rt;

// MIN / -1 and MIN % -1 have a result that no signed type holds (D6.13,
// D11.3). run/errors/007 holds the C entry point to this text.
string FILE = "src/app.ft";

fn i32 main() {
    u32 line = 41;
    u32 col = 5;
    // This line is built by the print family. The flush below puts it out
    // before the failure path writes anything, so the two directives above
    // hold one text against both ways of building it, the position and every
    // digit included.
    println(FILE, ":", line, ":", col, ": runtime error: division overflow");
    rt.flush_all();

    // This line stays in the buffer. The failure path calls flush_all, and
    // that call puts the line on stdout before it writes to stderr (D11.4).
    rt.print_str(1, "before\n".ptr, 7);
    rt.fail_div_overflow(FILE.ptr, line, col);
}
