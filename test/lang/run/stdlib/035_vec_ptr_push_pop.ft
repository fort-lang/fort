//! run
//! stdout:
//| 0 0
//| 1 16 10
//| 3 16 10 20 30
//| 30 2
//| 20 1
//| 10 0 16
//| 1 16 40
import std.vec;

// ptr_push appends and ptr_pop removes from the same end, so the vector is a
// stack (stdlib.md 2.7). A pointer survives the round trip through void*,
// including the added mutability a pointer cast may carry (D3.14).
struct node { i64 value; }

// A read through a pointer: the owner is no local owner here (D17.21).
fn value_at(vec.ptr_vec* v, u64 k) i64 {
    return cast(v->items[k], node*)->value;
}

// A read through a pointer: the owner is no local owner here (D17.21).
fn value_of(node* n) i64 {
    return n->value;
}

fn main() i32 {
    vec.ptr_vec mut v = vec.ptr_create();
    defer vec.ptr_free(&v);
    println(v.len, " ", v.items.len);

    node mut a = {10};
    node mut b = {20};
    node mut c = {30};
    vec.ptr_push(&v, cast(&a, void mut*));
    println(v.len, " ", v.items.len, " ", value_at(&v, 0));
    vec.ptr_push(&v, cast(&b, void mut*));
    vec.ptr_push(&v, cast(&c, void mut*));
    println(v.len, " ", v.items.len, " ", value_at(&v, 0), " ",
            value_at(&v, 1), " ", value_at(&v, 2));

    // Each pop hands back the last pointer pushed and shortens the vector by
    // one without touching the capacity.
    node mut* third = cast(vec.ptr_pop(&v), node mut*);
    println(value_of(third), " ", v.len);
    node* second = cast(vec.ptr_pop(&v), node*);
    println(value_of(second), " ", v.len);
    node* first = cast(vec.ptr_pop(&v), node*);
    println(value_of(first), " ", v.len, " ", v.items.len);

    // The emptied vector still holds its slots and accepts a new element.
    node mut d = {40};
    vec.ptr_push(&v, cast(&d, void mut*));
    println(v.len, " ", v.items.len, " ", value_at(&v, 0));
    return 0;
}
