//! run
//! stdout:
//| 0
//| 0
//| 7
//| 7
//| -7
//| -7
//| -10
//| -10
//| 9223372036854775807
//| 9223372036854775807
//| -9223372036854775808
//| -9223372036854775808
//| -1-2-3
import std.strbuf;

// append_i64 must produce the digits print produces for the same value
// (D11.7, stdlib.md 2.6), so every value is written through the buffer and
// through println. The minimum has no i64 magnitude, which is why it is
// taken in u64; a build that negated it would trap in a checked build and
// wrap in a release one (D11.1).
fn both(i64 v) void {
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append_i64(&b, v);
    println(strbuf.view(&b));
    println(v);
}

fn main() i32 {
    both(0);
    both(7);
    both(-7);
    both(-10);
    both(9223372036854775807);
    // The minimum is written as its u64 magnitude, reinterpreted by a cast of
    // the same width (D3.14), because -9223372036854775808 is a negation of a
    // literal that does not fit.
    u64 i64_min_magnitude = 9223372036854775808;
    both(cast(i64_min_magnitude, i64));

    // Several numbers in a row keep their signs and their order.
    strbuf.str_buf mut b = strbuf.create();
    defer strbuf.free(&b);
    strbuf.append_i64(&b, -1);
    strbuf.append_i64(&b, -2);
    strbuf.append_i64(&b, -3);
    println(strbuf.view(&b));
    return 0;
}
