//! run
//! stdout:
//| 0 0
//| 1 16
//| 16 16
//| 17 32
//| 32 32 496
//| 32 64 496
//| 32 200 496
import std.vec;

// The growth policy of stdlib.md 2.7, which is strbuf's counted in elements:
// the floor of 16 on the first push, doubling when the last slot is taken, and
// len + extra when a reservation asks for more than doubling gives. Every
// element must survive each move to new storage, which is what the running sum
// checks.

// The sum of the elements in use. It reads through a pointer, so the owner is no local owner here
// (D17.21).
fn sum_values(vec.int_vec* v) i64 {
    i64 mut sum = 0;
    u64 mut i = 0;
    while (i < v->len) {
        sum += v->items[i];
        i += 1;
    }
    return sum;
}

fn main() i32 {
    vec.int_vec mut v = vec.int_create();
    defer vec.int_free(&v);
    println(v.len, " ", v.items.len);

    vec.int_push(&v, 0);
    println(v.len, " ", v.items.len);

    // Filling the sixteenth slot does not grow; the seventeenth does.
    i64 mut i = 1;
    while (i < 16) {
        vec.int_push(&v, i);
        i += 1;
    }
    println(v.len, " ", v.items.len);
    vec.int_push(&v, 16);
    println(v.len, " ", v.items.len);

    i = 17;
    while (i < 32) {
        vec.int_push(&v, i);
        i += 1;
    }
    // 0 + 1 + ... + 31 is 496: every element is still there after two moves to fresh storage.
    i64 sum = sum_values(&v);
    println(v.len, " ", v.items.len, " ", sum);

    // A reservation that fits within doubling takes the doubling.
    vec.int_reserve(&v, 3);
    println(v.len, " ", v.items.len, " ", sum_values(&v));
    // One that does not is met exactly.
    vec.int_reserve(&v, 168);
    println(v.len, " ", v.items.len, " ", sum_values(&v));
    return 0;
}
