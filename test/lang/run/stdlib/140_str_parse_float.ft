//! run
//! stdout:
//| true true 42
//| true true
//| true true
//| true true
//| false true true
//| false true true
//| true true 42
//| false true true
import std.libc;
import std.str;
import std.sys;

// str.parse_f64 and str.parse_f32 read the longest prefix that strtod(3) and strtof(3) read
// (stdlib.md 2.5): white space first, then a decimal or a hexadecimal form, and the text after it
// stays unread. A text with no number gives 0. A value out of range gives false, ERANGE and the
// value that C gives: an infinity, or a value near 0. A value in range leaves errno unchanged.
fn main() i32 {
    f64 mut v = 0.0;
    sys.set_errno(42);
    println(str.parse_f64("1.5", &v), " ", v == 1.5, " ", sys.errno());
    println(str.parse_f64("  2.5e3xyz", &v), " ", v == 2500.0);
    println(str.parse_f64("0x1p4", &v), " ", v == 16.0);
    println(str.parse_f64("no number", &v), " ", v == 0.0);
    println(str.parse_f64("1e999", &v), " ", v > 1e308, " ", sys.errno() == libc.ERANGE);
    println(str.parse_f64("-1e999", &v), " ", v < -1e308, " ", sys.errno() == libc.ERANGE);
    f32 mut w = 0.0;
    sys.set_errno(42);
    println(str.parse_f32("0.5", &w), " ", w == 0.5, " ", sys.errno());
    println(str.parse_f32("1e99", &w), " ", w > 3e38, " ", sys.errno() == libc.ERANGE);
    return 0;
}
