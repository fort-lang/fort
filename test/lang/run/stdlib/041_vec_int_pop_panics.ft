//! run
//! abort
//! stderr: vec.int_pop: empty
//! stdout:
//| 1 7
//| 7 0 16
import std.vec;

// int_pop on an empty vector panics, and the boundary is the last element:
// the vector answers while it holds it and panics one pop later, with its
// storage untouched (D13.3, stdlib.md 2.7).

// A read through a pointer: the owner is no local owner here (D17.21).
fn item(vec.int_vec* v, u64 k) i64 {
    return v->items[k];
}

fn main() i32 {
    vec.int_vec mut v = vec.int_create();
    defer vec.int_free(&v);
    vec.int_push(&v, 7);
    println(v.len, " ", item(&v, 0));
    println(vec.int_pop(&v), " ", v.len, " ", v.items.len);
    println(vec.int_pop(&v));
    return 0;
}
