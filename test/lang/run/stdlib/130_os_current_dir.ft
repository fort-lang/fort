//! run
//! stdout:
//| true true
//| true true
//| false true true
import extern;
import std.libc;
import std.os;
import std.str;
import std.strbuf;
import std.sys;

// os.current_dir appends the absolute path of the working directory (stdlib.md 2.14). After the
// directory is removed, getcwd(3) fails with ENOENT, and the buffer stays as it was.

// chdir(2), which std.libc does not declare.
// C: chdir, chdir(2) of POSIX.1-2017.
// writes: nothing in fort storage; C reads path to its NUL. gives: 0, or -1 with errno set. keeps:
// no pointer. calls: no fort function. frees: nothing.
extern fn chdir(char* path) i32;

// C call chdir: c_path.ptr names the buffer c_path that str.to_cstr gave, with its NUL (D9.8 rule
// 4).
fn change_dir(string path) bool {
    char mut@ own c_path = str.to_cstr(path);
    defer del(c_path);
    return chdir(c_path.ptr) == 0;
}

fn main() i32 {
    strbuf.str_buf mut b = strbuf.create();
    defer del(b.data);
    bool found = os.current_dir(&b);
    println(found, " ", str.starts_with(strbuf.view(&b), "/"));
    os.make_dir("t-gone", 0o700);
    println(change_dir("t-gone"), " ", os.remove_dir("../t-gone"));
    strbuf.clear(&b);
    strbuf.append(&b, "kept");
    println(os.current_dir(&b), " ", strbuf.view(&b) == "kept", " ", sys.errno() == libc.ENOENT);
    return 0;
}
