//! run
//! abort
//! stderr: src/app.ft:15:5: runtime error: enum value 0 is not a member of level
//! stdout:
//| src/app.ft:15:5: runtime error: enum value 0 is not a member of level
//| before
import std.rt;

// The compiler gives a switch over an enum with no default clause a default
// that calls fail_enum. A value that no member names reaches it (D3.9, D7.7).
// run/errors/022 holds the C entry point to this text. The compiler emits
// this call in both build modes.
string FILE = "src/app.ft";
string TYPE = "level";

fn i32 main() {
    u32 line = 15;
    u32 col = 5;
    i64 v = 0;
    // The C runtime writes the same line. The compiler still lowers every
    // println to it (D12.2). This flushes that line before the fort runtime
    // writes anything, so the two directives above hold one text against both
    // runtimes, the position and every digit included.
    println(FILE, ":", line, ":", col, ": runtime error: enum value ", v,
            " is not a member of ", TYPE);
    rt.fort_rt_flush_all();

    // This line stays in the fort runtime's buffer. The failure path calls
    // flush_all, and that call puts the line on stdout before it writes to
    // stderr (D11.4).
    rt.print_str(1, "before\n".ptr, 7);
    rt.fail_enum(v, TYPE.ptr, FILE.ptr, line, col);
}
