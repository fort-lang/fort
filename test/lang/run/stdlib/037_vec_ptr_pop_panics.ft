//! run
//! abort
//! stderr: vec.ptr_pop: empty
//! stdout:
//| 1 10
//| 0 16
//| 10
import std.vec;

// Popping what is not there is a violated precondition, so ptr_pop panics
// rather than reporting it (D13.3, stdlib.md 2.7). The boundary is the last
// element: the vector that still holds it answers, and the same vector one
// pop later does not, even though its storage is untouched.
struct node { i64 value; }

fn i32 main() {
    vec.ptr_vec mut v = vec.ptr_create();
    defer vec.ptr_free(&v);
    node mut only = {10};
    vec.ptr_push(&v, cast(&only, void*));
    println(v.len, " ", cast(v.items[0], node*)->value);
    void* last = vec.ptr_pop(&v);
    println(v.len, " ", v.items.len);
    println(cast(last, node*)->value);
    void* none = vec.ptr_pop(&v);
    println(cast(none, node*)->value);
    return 0;
}
