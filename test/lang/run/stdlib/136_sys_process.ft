//! run
//! stdout:
//| true
//| 42
//| true true yes
//| true true again
//| false true
//| false true
//| true
//| false true
import std.libc;
import std.strbuf;
import std.sys;

// The process functions of std.sys (stdlib.md 2.1): the process id, a store of errno, a variable
// of the environment that set_env sets and replaces, and raise_signal with the signal 0, which
// sends nothing. setenv(3) refuses an empty name and a name with '=', and raise(3) a signal
// number that the system does not have; each gives EINVAL.
fn main() i32 {
    println(sys.pid() > 0);
    sys.set_errno(42);
    println(sys.errno());
    strbuf.str_buf mut value = strbuf.create();
    defer del(value.data);
    bool set = sys.set_env("FORT_T_VALUE", "yes");
    println(set, " ", sys.env("FORT_T_VALUE", &value), " ", strbuf.view(&value));
    strbuf.clear(&value);
    bool reset = sys.set_env("FORT_T_VALUE", "again");
    println(reset, " ", sys.env("FORT_T_VALUE", &value), " ", strbuf.view(&value));
    println(sys.set_env("", "x"), " ", sys.errno() == libc.EINVAL);
    println(sys.set_env("A=B", "x"), " ", sys.errno() == libc.EINVAL);
    println(sys.raise_signal(0));
    println(sys.raise_signal(-1), " ", sys.errno() == libc.EINVAL);
    return 0;
}
