//! run
//! abort
//! stderr: src/app.ft:9:13: runtime error: negative allocation count -1
//! stdout:
//| src/app.ft:9:13: runtime error: negative allocation count -1
//| before
import std.rt;

// new(T, n) with a negative signed n calls fail_alloc_count (D10.2, D11.4).
// run/errors/010 holds the C entry point to this text. This message prints
// the count as a signed number, which the fixed messages never do.
string FILE = "src/app.ft";

fn i32 main() {
    u32 line = 9;
    u32 col = 13;
    i64 n = -1;
    // This line is built by the print family. The flush below puts it out
    // before the failure path writes anything, so the two directives above
    // hold one text against both ways of building it, the position and every
    // digit included.
    println(FILE, ":", line, ":", col, ": runtime error: negative allocation count ", n);
    rt.flush_all();

    // This line stays in the buffer. The failure path calls flush_all, and
    // that call puts the line on stdout before it writes to stderr (D11.4).
    rt.print_str(1, "before\n".ptr, 7);
    rt.fail_alloc_count(n, FILE.ptr, line, col);
}
