//! run
//! abort
//! stderr: panic: sort.sort: element size is zero
//! stdout:
//| 1 2 3
import std.sort;

// A zero element size is a violated precondition, so it panics rather than
// reporting a result (stdlib.md 1.2, 2.10, D13.3). qsort with a zero size
// would read the whole array as one element, so the library stops the call
// here and never reaches C.
//
// The count below is 0, which pins the order stdlib.md 2.10 fixes: the three
// preconditions are tested before the count, so a call with nothing to sort
// still panics. An implementation that returned early for n < 2 would print
// nothing more and exit 0, and this test would fail.
fn main() i32 {
    i64[3] mut xs = {3, 1, 2};
    sort.sort(cast(xs[..].ptr, void mut*), xs.len, sizeof(i64), sort.cmp_i64);
    println(xs[0], " ", xs[1], " ", xs[2]);
    sort.sort(cast(xs[..].ptr, void mut*), 0, 0, sort.cmp_i64);
    println("not reached");
    return 0;
}
