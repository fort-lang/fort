//! run
//! abort
//! stderr: strbuf.truncate: beyond len
//! stdout:
//| 3
import std.strbuf;

// A length above the one in use is a violated precondition, so truncate
// panics rather than reporting it (D13.3, stdlib.md 2.6). One byte past the
// end is the boundary: truncate(&b, 3) is accepted in 029.
fn main() i32 {
    strbuf.str_buf mut b = strbuf.with_cap(16);
    defer strbuf.free(&b);
    strbuf.append(&b, "abc");
    println(b.len);
    // The capacity is 16, so the bytes are there; it is len that rules.
    strbuf.truncate(&b, 4);
    println("not reached");
    return 0;
}
