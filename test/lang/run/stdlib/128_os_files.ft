//! run
//! stdout:
//| make_dir true
//| make_dir again false true
//| make_dir below a missing directory false true
//| can_access true
//| can_access missing false true
//| rename true false true
//| rename missing false true
//| remove_dir full false
//| remove_file true
//| remove_file missing false true
//| remove_dir true
//| remove_dir missing false true
import std.io;
import std.libc;
import std.os;
import std.sys;

// The file functions of std.os (stdlib.md 2.14) in the working directory of the run: each one
// returns true when its C call succeeds, and false with the errno of the C call when it fails.
fn main() i32 {
    println("make_dir ", os.make_dir("t-files", 0o700));
    println("make_dir again ", os.make_dir("t-files", 0o700), " ", sys.errno() == libc.EEXIST);
    println("make_dir below a missing directory ", os.make_dir("t-missing/sub", 0o700), " ",
            sys.errno() == libc.ENOENT);
    io.write_file("t-files/a.txt", cast("a", u8@));
    println("can_access ", os.can_access("t-files/a.txt", libc.R_OK));
    println("can_access missing ", os.can_access("t-files/b.txt", libc.R_OK), " ",
            sys.errno() == libc.ENOENT);
    println("rename ", os.rename("t-files/a.txt", "t-files/b.txt"), " ",
            os.can_access("t-files/a.txt", libc.R_OK), " ",
            os.can_access("t-files/b.txt", libc.R_OK));
    println("rename missing ", os.rename("t-files/a.txt", "t-files/c.txt"), " ",
            sys.errno() == libc.ENOENT);
    println("remove_dir full ", os.remove_dir("t-files"));
    println("remove_file ", os.remove_file("t-files/b.txt"));
    println("remove_file missing ", os.remove_file("t-files/b.txt"), " ",
            sys.errno() == libc.ENOENT);
    println("remove_dir ", os.remove_dir("t-files"));
    println("remove_dir missing ", os.remove_dir("t-files"), " ", sys.errno() == libc.ENOENT);
    return 0;
}
