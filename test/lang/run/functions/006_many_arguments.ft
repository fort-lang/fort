//! run
//! stdout:
//| 1 2 3 4 5 6 7 8 9
//| 9 8 7 6 5 4 3 2 1
//| 45 45
//| 65805
// Nine arguments: LLVM places them by System V, six in registers and the rest
// on the stack, and the compiler only fixes the signature (D9.9). The same
// call through a function pointer takes the same path (D3.10).
fn nine(i32 a, i32 b, i32 c, i32 d, i32 e, i32 f, i32 g, i32 h, i32 i) i32 {
    println(a, " ", b, " ", c, " ", d, " ", e, " ", f, " ", g, " ", h, " ", i);
    return a +% b +% c +% d +% e +% f +% g +% h +% i;
}

// Narrow parameters are normalized on both sides of the call, so the callee
// reads -1 and 65535 and not the low bytes of a wider register (D9.9).
fn narrow_nine(i8 a, u8 b, i16 c, u16 d, i32 e, u32 f, i64 g, u64 h, bool k) i32 {
    if (!k) {
        return 0;
    }
    return cast(a, i32) +% cast(b, i32) +% cast(c, i32) +% cast(d, i32) +% e +%
           cast(f, i32) +% cast(g, i32) +% cast(h, i32);
}

fn main() i32 {
    i32 direct = nine(1, 2, 3, 4, 5, 6, 7, 8, 9);
    fn (i32, i32, i32, i32, i32, i32, i32, i32, i32) i32 call = nine;
    i32 through = call(9, 8, 7, 6, 5, 4, 3, 2, 1);
    println(direct, " ", through);
    println(narrow_nine(-1, 255, -2, 65535, 3, 4, 5, 6, true));
    return 0;
}
