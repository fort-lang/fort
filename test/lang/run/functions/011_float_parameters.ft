//! run
//! stdout:
//| 4.5 2.25
//| 1.5 0.75 6
//| 12.5 2.5
// Floats pass as parameters and come back as results, in both types and
// beside integers (D9.9).
fn scale(f64 x, i32 k) f64 {
    return x * cast(k, f64);
}

fn halve(f32 x) f32 {
    return x / 2.0;
}

fn sum_of(f64 a, f32 b, i64 c) f64 {
    return a + cast(b, f64) + cast(c, f64);
}

fn split(f64 x, f64 mut* whole, f32 mut* half) void {
    *whole = x;
    *half = cast(x / 2.0, f32);
}

fn main() i32 {
    println(scale(1.5, 3), " ", halve(4.5));
    f64 mut whole = 0.0;
    f32 mut half = 0.0;
    split(1.5, &whole, &half);
    println(whole, " ", half, " ", 6);
    println(sum_of(10.0, 0.5, 2), " ", scale(0.5, 5));
    return 0;
}
