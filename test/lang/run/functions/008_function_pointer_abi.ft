//! run
//! stdout:
//| 6 1
//| 7 8
//| -6 254
// An aggregate argument is a pointer to a copy the caller made and an
// aggregate result arrives through a hidden pointer, through a function
// pointer as through a name (D9.9). Binding-level `mut` on a parameter is not
// part of the function's type, so `clobber` has the type `fn i32(point)`
// (D3.10, D5.6).
struct point {
    i32 x;
    i32 y;
}

fn i32 clobber(point mut p) {
    p.x = 100;
    return p.x -% 94;
}

fn point offset(point p, i32 by) {
    point q = {p.x +% by, p.y +% by};
    return q;
}

fn i8 shrink(i8 a, u16 b) {
    return a -% cast(b, i8);
}

fn u8 widen(u8 a) {
    return a +% 250;
}

fn i32 main() {
    point p = {1, 2};
    fn i32(point) hit = clobber;
    i32 got = hit(p);
    // The callee wrote 100 into the caller's copy, so `p` still holds 1.
    println(got, " ", p.x);
    fn point(point, i32) shift = offset;
    point q = shift(p, 6);
    println(q.x, " ", q.y);
    fn i8(i8, u16) narrow = shrink;
    fn u8(u8) wide = widen;
    println(cast(narrow(-1, 5), i32), " ", cast(wide(4), i32));
    return 0;
}
