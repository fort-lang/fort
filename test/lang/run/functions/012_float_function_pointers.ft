//! run
//! stdout:
//| 2.5 6.25
//| 0.5 2.5
//| true
// A function pointer with float parameters and a float result is called
// through like any other (D3.10, D9.9).
fn twice(f64 x) f64 {
    return x + x;
}

fn square(f64 x) f64 {
    return x * x;
}

fn apply(fn (f64) f64 f, f64 x) f64 {
    return f(x);
}

// A function type carries no marker of its own (D3.10, D8.1), so a function
// pointer that is reassigned is a field of a `mut` struct: the mutability comes
// from the access path (D5.5).
struct cell {
    fn (f64) f64 f;
}

fn main() i32 {
    println(apply(twice, 1.25), " ", apply(square, 2.5));
    cell mut chosen = {twice};
    f64 first = chosen.f(0.25);
    chosen.f = square;
    println(first, " ", chosen.f(1.25) + 0.9375);
    println(apply(twice, 0.5) == 1.0);
    return 0;
}
