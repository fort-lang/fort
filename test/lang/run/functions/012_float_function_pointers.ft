//! run
//! stdout:
//| 2.5 6.25
//| 0.5 2.5
//| true
// A function pointer with float parameters and a float result is called
// through like any other (D3.10, D9.9).
fn f64 twice(f64 x) {
    return x + x;
}

fn f64 square(f64 x) {
    return x * x;
}

fn f64 apply(fn f64(f64) f, f64 x) {
    return f(x);
}

fn i32 main() {
    println(apply(twice, 1.25), " ", apply(square, 2.5));
    fn f64(f64) mut chosen = twice;
    f64 first = chosen(0.25);
    chosen = square;
    println(first, " ", chosen(1.25) + 0.9375);
    println(apply(twice, 0.5) == 1.0);
    return 0;
}
