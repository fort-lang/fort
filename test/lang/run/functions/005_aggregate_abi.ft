//! run
//! stdout:
//| 1 2 3
//| 100 8 1
//| hello 5
//| 12 -3 250 9
// An aggregate argument is a plain pointer to a copy the caller made, and an
// aggregate result arrives through a hidden pointer, so a callee may write to
// its parameter without the caller seeing it (D9.9, toolchain.md 6 item 7).
struct point {
    i32 x;
    i32 y;
}

struct triple {
    i32 a;
    i32 b;
    i32 c;
}

fn make(i32 base) triple {
    triple t = {base, base +% 1, base +% 2};
    return t;
}

fn sum(point p, point q) i32 {
    return p.x +% p.y +% q.x +% q.y;
}

fn clobber(point mut p) i32 {
    p.x = 100;
    return p.x;
}

fn length(string s) u64 {
    return s.len;
}

fn narrow(i8 a, i16 b, u8 c, u16 d) i8 {
    return a;
}

fn main() i32 {
    triple t = make(1);
    println(t.a, " ", t.b, " ", t.c);
    point p = {1, 2};
    point q = {2, 2};
    i32 before = p.x;
    i32 got = clobber(p);
    // The callee wrote 100 into its own copy, so `p` still holds 1 here.
    println(got, " ", sum(p, q) +% before, " ", p.x);
    string s = "hello";
    println(s, " ", length(s));
    i8 wrapped = narrow(-6, 1, 2, 3) *% -1;
    println(clobber(q) -% 88, " ", cast(narrow(-3, 1, 2, 3), i32), " ",
            cast(wrapped, u8) +% 244, " ", cast(narrow(9, 1, 2, 3), i32));
    return 0;
}
