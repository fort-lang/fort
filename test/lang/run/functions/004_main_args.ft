//! run
//! args: alpha beta gamma
//! exit: 3
//! stdout:
//| 4
//| alpha gamma
//| alpha beta gamma
fn main(string@ args) i32 {
    println(args.len);
    println(args[1], " ", args[3]);
    u64 mut i = 1;
    for (string a : args[1..]) {
        print(a);
        if (i < 3) {
            print(" ");
        }
        i++;
    }
    println();
    return 3;
}
