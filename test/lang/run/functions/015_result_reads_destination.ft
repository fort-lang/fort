//! run
//! stdout:
//| 16
//| 22
//| 26
// A function that returns an aggregate can read the place that takes its result. `s = mk(&s)`
// passes the address of `s`, and `mk` reads `s.b` through it before the store of the result. The
// same holds for the global `g`, which `mg` reads by its name. The compiler passes the place as
// the storage of the result, so the entry of the function must write nothing into that storage:
// a compiler that writes zero bytes there prints 10, 20 and 20.
struct holed {
    u8 a;
    u64 b;
}

holed mut g = holed{1, 2};

fn mk(holed* p) holed {
    u64 old = p->b;
    return holed{3, old + 10};
}

fn mg() holed {
    u64 old = g.b;
    return holed{4, old + 20};
}

fn main() i32 {
    holed mut s = holed{5, 6};
    s = mk(&s);
    println(s.b);
    g = mg();
    println(g.b);
    holed t = mk(&s);
    println(t.b);
    return 0;
}
