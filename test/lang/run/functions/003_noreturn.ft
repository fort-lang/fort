//! run
//! stdout:
//| 1 -1
//| 4
//| 3
fn noreturn fail(string msg) {
    eprintln("fatal: ", msg);
    panic(msg);
}

fn i32 sign(i32 x) {
    if (x > 0) {
        return 1;
    }
    if (x < 0) {
        return -1;
    }
    fail("zero has no sign");
}

fn i32 first_even(i32[] s) {
    mut u64 i = 0;
    while (true) {
        if (s[i] % 2 == 0) {
            return s[i];
        }
        i++;
    }
}

fn i32 count_up(i32 limit) {
    mut i32 n = 0;
    for (;;) {
        n++;
        if (n == limit) {
            return n;
        }
    }
}

fn i32 main() {
    println(sign(5), " ", sign(-5));
    own mut i32[] s = new(i32[3]);
    s[0] = 1;
    s[1] = 4;
    s[2] = 6;
    println(first_even(s));
    del(s);
    println(count_up(3));
    return 0;
}
