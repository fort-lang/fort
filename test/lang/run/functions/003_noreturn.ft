//! run
//! stdout:
//| 1 -1
//| 4
//| 3
fn fail(string msg) noreturn {
    eprintln("fatal: ", msg);
    panic(msg);
}

fn sign(i32 x) i32 {
    if (x > 0) {
        return 1;
    }
    if (x < 0) {
        return -1;
    }
    fail("zero has no sign");
}

fn first_even(i32@ s) i32 {
    u64 mut i = 0;
    while (true) {
        if (s[i] % 2 == 0) {
            return s[i];
        }
        i++;
    }
}

fn count_up(i32 limit) i32 {
    i32 mut n = 0;
    for (;;) {
        n++;
        if (n == limit) {
            return n;
        }
    }
}

fn main() i32 {
    println(sign(5), " ", sign(-5));
    i32 mut@ own s = new(i32, 3);
    s[0] = 1;
    s[1] = 4;
    s[2] = 6;
    println(first_even(s));
    del(s);
    println(count_up(3));
    return 0;
}
