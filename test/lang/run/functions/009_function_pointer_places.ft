//! run
//! stdout:
//| 4 1
//| 6
//| 8
//| 5
//| 10
// A function-pointer-typed expression is callable whatever place it was read
// from (D6.11): a field, a field through a pointer, a field of a call's
// result, an element of an array and a parameter.
struct handler {
    fn i32(i32) f;
    i32 tag;
}

fn i32 twice(i32 x) {
    return x +% x;
}

fn u64 length(string s) {
    return s.len;
}

fn handler make() {
    handler h = {twice, 7};
    return h;
}

fn i32 main() {
    handler h = {twice, 1};
    println(h.f(2), " ", h.tag);
    handler* p = &h;
    println(p->f(3));
    println(make().f(4));
    fn u64(string) size = length;
    println(size("hello"));
    fn i32(i32)[2] table = {twice, twice};
    fn i32(i32) mut current = table[0];
    current = h.f;
    println(current(5));
    return 0;
}
