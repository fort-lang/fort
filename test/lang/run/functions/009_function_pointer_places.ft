//! run
//! stdout:
//| 4 1
//| 6
//| 8
//| 5
//| 10
// A function-pointer-typed expression is callable whatever place it was read
// from (D6.11): a field, a field through a pointer, a field of a call's
// result, an element of an array and a parameter.
struct handler {
    fn (i32) i32 f;
    i32 tag;
}

fn twice(i32 x) i32 {
    return x +% x;
}

fn length(string s) u64 {
    return s.len;
}

fn make() handler {
    handler h = {twice, 7};
    return h;
}

fn main() i32 {
    handler h = {twice, 1};
    println(h.f(2), " ", h.tag);
    handler* p = &h;
    println(p->f(3));
    println(make().f(4));
    fn (string) u64 size = length;
    println(size("hello"));
    // A struct can also hold a function pointer and its associated data (D3.10).
    handler[2] table = {{twice, 0}, {twice, 0}};
    handler mut current = {table[0].f, 0};
    current.f = h.f;
    println(current.f(5));
    return 0;
}
