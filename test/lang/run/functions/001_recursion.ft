//! run
//! stdout:
//| 55 3628800 2432902008176640000
//| true false
fn fib(i32 n) i32 {
    if (n < 2) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

fn fact(i64 n) i64 {
    if (n <= 1) {
        return 1;
    }
    return n * fact(n - 1);
}

fn is_even(i32 n) bool {
    if (n == 0) {
        return true;
    }
    return is_odd(n - 1);
}

fn is_odd(i32 n) bool {
    if (n == 0) {
        return false;
    }
    return is_even(n - 1);
}

fn main() i32 {
    println(fib(10), " ", fact(10), " ", fact(20));
    println(is_even(10), " ", is_odd(10));
    return 0;
}
