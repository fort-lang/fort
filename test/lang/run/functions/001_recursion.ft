//! run
//! stdout:
//| 55 3628800 2432902008176640000
//| true false
fn i32 fib(i32 n) {
    if (n < 2) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

fn i64 fact(i64 n) {
    if (n <= 1) {
        return 1;
    }
    return n * fact(n - 1);
}

fn bool is_even(i32 n) {
    if (n == 0) {
        return true;
    }
    return is_odd(n - 1);
}

fn bool is_odd(i32 n) {
    if (n == 0) {
        return false;
    }
    return is_even(n - 1);
}

fn i32 main() {
    println(fib(10), " ", fact(10), " ", fact(20));
    println(is_even(10), " ", is_odd(10));
    return 0;
}
