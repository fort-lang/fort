//! run
//! stdout:
//| 5 -1 6
//| 5 -1 6
//| 9
//| true false true
//| 6 2 0
//| 0x0 true
fn i32 add(i32 a, i32 b) {
    return a + b;
}

fn i32 sub(i32 a, i32 b) {
    return a - b;
}

fn i32 mul(i32 a, i32 b) {
    return a * b;
}

fn i32 apply(fn i32(i32, i32) f, i32 x, i32 y) {
    return f(x, y);
}

fn fn i32(i32, i32) choose(bool plus) {
    return plus ? add : sub;
}

fn i32 main() {
    fn i32(i32, i32) op = add;
    println(op(2, 3), " ", sub(2, 3), " ", mul(2, 3));
    fn i32(i32, i32)[3] ops = {add, sub, mul};
    for (i32 mut i = 0; i < 3; i++) {
        print(ops[i](2, 3));
        if (i < 2) {
            print(" ");
        }
    }
    println();
    println(apply(mul, 3, 3));
    fn i32(i32, i32) mut cur = add;
    println(cur == add, " ", cur == sub, " ", op == ops[0]);
    cur = sub;
    println(choose(true)(4, 2), " ", choose(false)(4, 2), " ", cur(1, 1));
    fn void() none = null;
    println(none, " ", none == null);
    return 0;
}
