//! run
//! stdout:
//| 5 -1 6
//| 5 -1 6
//| 9
//| true false true
//| 6 2 0
//| 0x0 true
fn add(i32 a, i32 b) i32 {
    return a + b;
}

fn sub(i32 a, i32 b) i32 {
    return a - b;
}

fn mul(i32 a, i32 b) i32 {
    return a * b;
}

fn apply(fn (i32, i32) i32 f, i32 x, i32 y) i32 {
    return f(x, y);
}

fn choose(bool plus) fn (i32, i32) i32 {
    if (plus) {
        return add;
    }
    return sub;
}

// A function type carries no suffix and no marker of its own (D3.10, D8.1), so
// a dispatch table and a pointer that is reassigned both go through a struct.
struct slot {
    fn (i32, i32) i32 f;
}

fn main() i32 {
    fn (i32, i32) i32 op = add;
    println(op(2, 3), " ", sub(2, 3), " ", mul(2, 3));
    slot[3] ops = {{add}, {sub}, {mul}};
    for (i32 mut i = 0; i < 3; i++) {
        print(ops[i].f(2, 3));
        if (i < 2) {
            print(" ");
        }
    }
    println();
    println(apply(mul, 3, 3));
    slot mut cur = {add};
    println(cur.f == add, " ", cur.f == sub, " ", op == ops[0].f);
    cur.f = sub;
    println(choose(true)(4, 2), " ", choose(false)(4, 2), " ", cur.f(1, 1));
    fn () void none = null;
    println(none, " ", none == null);
    return 0;
}
