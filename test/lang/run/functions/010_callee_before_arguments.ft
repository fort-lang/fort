//! run
//! stdout:
//| callee
//| argument
//| 6
// The callee of a call is evaluated before its arguments, which is the source
// order the walk keeps (D6.3), so a function pointer that a call produces runs
// before the arguments of the call it is the callee of.
fn i32 twice(i32 x) {
    return x +% x;
}

fn fn i32(i32) pick() {
    println("callee");
    return twice;
}

fn i32 argument() {
    println("argument");
    return 3;
}

fn i32 main() {
    println(pick()(argument()));
    return 0;
}
