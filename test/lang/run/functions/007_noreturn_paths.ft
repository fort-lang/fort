//! run
//! abort
//! stderr: stopping
//! stderr: panic: through a pointer
//! stdout:
//| 1
//| 2
// A call to a `noreturn` function terminates the statement it stands in
// (D8.4), and the compiler emits a trap after the call and after the body of
// such a function (D8.5), so the statements D14.2 allows after one never run.
fn noreturn stop(string msg) {
    eprintln("stopping");
    panic(msg);
}

fn i32 guard(i32 n) {
    if (n > 0) {
        return n;
    }
    stop("not positive");
}

fn i32 main() {
    println(guard(1));
    fn noreturn(string) fail = stop;
    println(2);
    fail("through a pointer");
    println(3);
    return 0;
}
