import extern;
import std.libc;

// A trusted module (D9.8). No parameter type of a function below reaches a pointer to `char`,
// `u8` or `void`, so none is a boundary function, and each module may name each one: a `string`
// and a span of `u8` bring their length, and the other types reach no byte pointer.

struct plain {
    i64 v;
    i64* p;
}

enum shade {
    dark,
    light,
}

fn text_length(string s) u64 {
    return s.len;
}

fn byte_count(u8@ b) u64 {
    return b.len;
}

// C call f: a function value that the caller gives, a fort function or a function of C. Its type
// reaches no byte pointer, so it is no boundary function, and f gets v as the caller gave it.
fn apply(fn (i64*) i32 f, i64* v) i32 {
    return f(v);
}

fn plain_sum(plain* p) i64 {
    return p->v + *p->p;
}

fn narrow(i8* p) i8 {
    return *p;
}

fn shade_of(shade s) i32 {
    return cast(s, i32);
}

// The module calls C itself: the literal ends with a NUL (D3.7), and strlen stops at it.
// C call libc.strlen: &text[0] names the local text, which a literal initializes and no store
// changes, and strlen reads it to the NUL of that literal (D9.8 rule 4).
fn literal_length() u64 {
    string text = "four";
    return libc.strlen(&text[0]);
}
