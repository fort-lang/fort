//! run
//! stdout:
//| 5 3 8 13 -2 1 4
import helper;

// A module that is not trusted calls each function of the trusted module `helper`, which are no
// boundary functions (D9.8), and passes a function of its own as a value.
fn twice(i64* v) i32 {
    return cast(*v * 2, i32);
}

fn main() i32 {
    u8[3] raw = {1, 2, 3};
    i64 mut x = 4;
    helper.plain p = helper.plain{9, &x};
    i8 small = -2;
    println(helper.text_length("hello"), " ", helper.byte_count(raw[..]), " ",
            helper.apply(twice, &x), " ", helper.plain_sum(&p), " ", helper.narrow(&small), " ",
            helper.shade_of(helper.shade.light), " ", helper.literal_length());
    return 0;
}
