// D21.3: a `$if` condition around an import short-circuits. A skipped operand
// resolves no name and folds no division, and the selection goes on to the
// next import.
$if (false && MISSING) { import absent; }
$if (true || (1 / 0 == 0)) { import safe; }

fn main() i32 {
    println(safe.value());
    return 0;
}
