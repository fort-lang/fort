//! run
//! flags: --cfg shared=hello,empty= --cfg third=three=parts
//! stdout:
//| hello hello 0 three=parts
// D21.1: every `--cfg` pair reaches the entry module and each import. A list
// holds several pairs, a value can be empty, and a value keeps its own `=`.
import dep.SHARED;

string LOCAL = $cfg(shared);
string EMPTY = $cfg(empty);
string THIRD = $cfg(third);

fn main() i32 {
    println(LOCAL, " ", SHARED, " ", EMPTY.len, " ", THIRD);
    return 0;
}
