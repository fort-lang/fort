//! run
//! abort
//! stderr: runtime error: overwriting owned value
//! stdout:
//| 1
// The store that traps is in the imported module `slot`, so the directive
// names no position. The overwrite oracle finds the site in IMPORTED_SITES
// (test/overwrite_oracle_test.py).
import slot;

fn main() i32 {
    slot.cell mut* own mut c = null;
    slot.fill(&c, 1);
    println(c->value);
    // The slot is live, so the store in slot.fill traps.
    slot.fill(&c, 2);
    println("not reached");
    del(c);
    return 0;
}
