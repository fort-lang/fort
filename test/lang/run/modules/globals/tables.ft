// Module `tables`, whose module-level data main.ft reads across the module
// boundary: a scalar constant folds into its use sites, but an array, a
// struct and a `mut` global are storage another module addresses by symbol
// (D7.10, D9.4).
i32 COUNT = 3;

struct point {
    i32 x;
    i32 y;
}

point ORIGIN = {4, 5};
point[3] PTS = {{1, 2}, {3, 4}, {5, 6}};
string[2] NAMES = {"alpha", "beta"};
i32 mut served = 0;

fn i32 serve() {
    served++;
    return served;
}
