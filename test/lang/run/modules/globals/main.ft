//! run
//! stdout:
//| 3 4 5
//| 21 alpha beta
//| 1 2 2
//| 4 9
import tables;
import tables::PTS;
import tables::ORIGIN as start;

fn i32 main() {
    println(tables.COUNT, " ", tables.ORIGIN.x, " ", tables.ORIGIN.y);
    i32 mut total = 0;
    for (tables.point p : tables.PTS) {
        total += p.x + p.y;
    }
    println(total, " ", tables.NAMES[0], " ", tables.NAMES[1]);
    // A `mut` global of another module is one storage, whoever writes it.
    println(tables.serve(), " ", tables.serve(), " ", tables.served);
    // The same data through a symbol import and through an alias.
    println(PTS[1].x + start.x - 3, " ", start.x + start.y);
    return 0;
}
