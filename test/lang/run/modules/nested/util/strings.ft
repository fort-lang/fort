// Module `util.strings`; imports its sibling by its root-relative path (D9.2).
import util.chars;

fn count_char(string s, char target) i32 {
    i32 mut n = 0;
    for (char c : s) {
        if (c == target) {
            n++;
        }
    }
    return n;
}

fn count_vowels(string s) i32 {
    i32 mut n = 0;
    {
        string range_values = s;
        u64 mut range_index = 0;
        while (range_index < range_values.len) {
            char c = range_values[range_index];
            range_index += 1;
            if (chars.is_vowel(c)) {
                n++;
            }
        }
    }
    return n;
}

fn starts_with(string s, string prefix) bool {
    if (prefix.len > s.len) {
        return false;
    }
    return s[..prefix.len] == prefix;
}
