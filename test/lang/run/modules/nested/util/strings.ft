// Module `util.strings`; imports its sibling by its root-relative path (D9.2).
import util.chars;

fn i32 count_char(string s, char target) {
    i32 mut n = 0;
    for (char c : s) {
        if (c == target) {
            n++;
        }
    }
    return n;
}

fn i32 count_vowels(string s) {
    i32 mut n = 0;
    for (char c : s) {
        if (chars.is_vowel(c)) {
            n++;
        }
    }
    return n;
}

fn bool starts_with(string s, string prefix) {
    if (prefix.len > s.len) {
        return false;
    }
    return s[..prefix.len] == prefix;
}
