//! run
//! stdout:
//| 3 2
//| true false
//| true true
import util.strings;
// An item list whose prefix is a path of several segments (D9.3): the braces
// never name modules, so `util.chars` must be a module file and each item one
// of its declarations.
import util.chars.{is_vowel, is_consonant as hard};

fn i32 main() {
    println(strings.count_char("banana", 'a'), " ", strings.count_vowels("hello"));
    println(strings.starts_with("hello", "he"), " ", strings.starts_with("hello", "lo"));
    println(is_vowel('e'), " ", hard('z'));
    return 0;
}
