import extern;
// Declares the enum and the same C symbol main.ft declares, spelling the
// parameter with the only name it has for it (D9.4, D9.8).
enum color {
    red = 1,
    green = 2,
}

// C: helper_paint, test/lang/ffi/helpers.c, which gives color * 10.
// gives: an int32_t and no pointer. writes: no fort storage. keeps: no pointer. calls: no fort
// function. frees: nothing.
extern fn helper_paint(color c) i32;

// C call helper_paint: no pointer argument.
fn paint_red() i32 {
    return helper_paint(color.red);
}
