//! run
//! link: ffi/helpers.c
//! stdout:
//| 20
//| 10
import extern;
import shade;

// The module that declares the enum can only spell it `color`, since it can
// neither qualify a name with its own module name nor import itself, and this
// module must spell it `shade.color`: two spellings of one type (D9.4). The
// declarations of one C symbol are compared as types, so they are identical
// and the program is legal (D9.8).
// C: helper_paint, test/lang/ffi/helpers.c, which gives color * 10.
// gives: an int32_t and no pointer. writes: no fort storage. keeps: no pointer. calls: no fort
// function. frees: nothing.
extern fn helper_paint(shade.color c) i32;

// C call helper_paint: no pointer argument.
fn main() i32 {
    println(helper_paint(shade.color.green));
    println(shade.paint_red());
    return 0;
}
