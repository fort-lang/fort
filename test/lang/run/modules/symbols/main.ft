//! run
//! stdout:
//| 9 12
//| 9 4
//| 2 9
import shapes;
import shapes::area as shape_area;
import shapes::{Square, perimeter as perim};

fn i32 main() {
    Square sq = {3};
    println(shape_area(sq), " ", perim(sq));
    println(shapes.area(sq), " ", shapes.SIDES);
    shapes.Square other = {1};
    fn i32(shapes.Square) f = shapes.area;
    println(shape_area(other) + shape_area(other), " ", f(sq));
    return 0;
}
