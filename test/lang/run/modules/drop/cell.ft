// A cell owns one number. Its drop counts the cells that it frees and the cells that hold the
// zero value.
struct cell {
    i32 mut* own value;
}

u64 mut FREED = 0;
u64 mut EMPTY = 0;

fn make(i32 v) cell {
    cell mut c = cell{.value = new(i32)};
    *c.value = v;
    return c;
}

fn drop(cell mut c) void {
    if (c.value == null) {
        EMPTY += 1;
    } else {
        FREED += 1;
    }
    del(c.value);
}

fn freed() u64 {
    return FREED;
}

fn empty() u64 {
    return EMPTY;
}
