//! run
//! stdout:
//| 3 cells
//| 2 freed, 3 empty
// In the expected line `2 freed, 3 empty`, 2 of the 3 empty cells come from the swaps that store
// cells 0 and 2: each swap gives `cell.drop` the empty value that the slot held (D17.11).
// The drop of `del(s, d)` can name a function of another module as `m.f` (D17.9). `cell.drop`
// is release-only: it counts in a global of its module, which stores no owner, and it frees the
// owner of its cell. The span holds two cells with an allocation and one with the zero value, and
// each of the three goes into the drop once.
import cell;

fn main() i32 {
    cell.cell mut@ own cells = new(cell.cell, 3);
    cell.cell first = cell.make(4);
    cell.cell mut* at_first = &cells[0];
    cell.cell old_first = move(*at_first);
    *at_first = move(first);
    cell.drop(move(old_first));
    cell.cell last = cell.make(5);
    cell.cell mut* at_last = &cells[2];
    cell.cell old_last = move(*at_last);
    *at_last = move(last);
    cell.drop(move(old_last));
    println(cells.len, " cells");
    del(cells, cell.drop);
    println(cell.freed(), " freed, ", cell.empty(), " empty");
    return 0;
}
