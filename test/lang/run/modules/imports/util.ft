// Module `util`, imported whole, renamed, and by symbol from main.ft (D9.3).
struct box {
    i32 side;
}

enum flavour {
    sweet,
    sour,
}

fn twice(i32 n) i32 {
    return n * 2;
}

fn volume(box b) i32 {
    return b.side * b.side * b.side;
}

fn taste() flavour {
    return flavour.sour;
}
