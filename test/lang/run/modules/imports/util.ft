// Module `util`, imported whole, renamed, and by symbol from main.ft (D9.3).
struct box {
    i32 side;
}

enum flavour {
    sweet,
    sour,
}

fn i32 twice(i32 n) {
    return n * 2;
}

fn i32 volume(box b) {
    return b.side * b.side * b.side;
}

fn flavour taste() {
    return flavour.sour;
}
