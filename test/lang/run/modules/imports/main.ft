//! run
//! stdout:
//| 4 4 4
//| 27 27 sour
//| shadowed 9
//| 7
import util;
import util as tools;
import util.twice;
import util.{box, volume as bulk, taste};

// A module-level declaration shadows a universe name throughout this module
// (D7.9, module-system.md 5).
fn void print(string label, i32 n) {
    println(label, " ", n);
}

fn i32 main() {
    // One module under three names binds the same entities (D9.3).
    println(util.twice(2), " ", tools.twice(2), " ", twice(2));
    box b = {3};
    println(bulk(b), " ", util.volume(util.box{3}), " ", taste());
    print("shadowed", 9);
    // A local shadows a module binding; `util` names the local here
    // (D7.9, module-system.md 5).
    i32 util = 7;
    println(util);
    return 0;
}
