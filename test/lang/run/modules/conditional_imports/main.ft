//! run
//! stdout:
//| 42
//! stdout-macos:
//| 99
// D21.3: target configuration selects one import before module loading. The
// Linux target selects the first import; every other target the second.
$if ($cfg(target_os) == "linux") {
    import linux_value as selected;
} else {
    import other_value as selected;
}

fn main() i32 {
    println(selected.answer());
    return 0;
}
