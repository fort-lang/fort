//! run
//! stdout:
//| green blue 5
//| mid
//| light dark true
//| red 0 6
//| mixer sees blue
import palette;
import mixer;

fn i32 main() {
    palette.color c = palette.color.green;
    println(c, " ", palette.next(c), " ", palette.code(c));
    // An imported enum switches like any other, and an exhaustive switch over
    // it needs no default (D7.6, D7.7).
    switch (c) {
    case palette.color.red, palette.color.blue:
        println("edge");
    case palette.color.green:
        println("mid");
    }
    palette.shade s = {};
    println(s, " ", palette.shade.dark, " ", s == palette.shade.light);
    palette.color z = {};
    println(z, " ", palette.code(z), " ", cast(palette.next(palette.color.green), i32));
    // The same enum printed from a third module: one declaration, one table
    // (D3.9, toolchain.md 6 item 21).
    mixer.show(mixer.darkest());
    return 0;
}
