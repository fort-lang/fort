// Module imported by main.ft as `palette`: an enum crossing a module
// boundary, its members reached as `palette.color.red` from there (D3.9).
enum color {
    red,
    green = 5,
    blue,
}

enum shade {
    light,
    dark,
}

// Exhaustive over the members and without a `default` clause, so it carries
// the default D7.7 gives it, which no call here reaches.
fn color next(color c) {
    switch (c) {
    case color.red:
        return color.green;
    case color.green:
        return color.blue;
    case color.blue:
        return color.red;
    }
}

fn i32 code(color c) {
    return cast(c, i32);
}
