//! run
//! abort
//! stderr: guard.ft:9:5: assertion failed: n > 0
//! stdout:
//| 2 3
//| before
import guard;

fn i32 zero() {
    return 0;
}

fn i32 main() {
    i32[3] xs = {1, 2, 3};
    println(guard.at(xs, 1), " ", guard.at(xs, 2));
    println("before");
    println(guard.must_be_positive(zero()));
    println("after");
    return 0;
}
