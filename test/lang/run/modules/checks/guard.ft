// Module `guard`: the runtime checks of D11.4 fire inside an imported module,
// so their position names this file and the assert text is read from this
// file's source (toolchain.md 5.2).
fn at(i32[3] xs, i32 i) i32 {
    return xs[i];
}

fn must_be_positive(i32 n) i32 {
    assert(n > 0);
    return n;
}
