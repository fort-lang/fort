//! run
//! stdout:
//| 3.5 0.5 4.0
//| 7.0 2.5
//| 1.5 -0.25
// Floats cross a module boundary as a constant, as a parameter, as a result
// and as a field of an imported struct (D9.4, D9.9).
import geometry;

fn i32 main() {
    println(geometry.SCALE, " ", geometry.STEP, " ", geometry.SCALE + cast(geometry.STEP, f64));
    println(geometry.scaled(2.0), " ", geometry.halve(5.0));
    geometry.point mut p = geometry.point{1.5, -0.25};
    println(p.x, " ", p.y);
    return 0;
}
