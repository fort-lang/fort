//! run
//! stdout:
//| true true 0
// D21.1: one map supplies compiler values to the entry module and its imports.
import dep.TARGET_OS;

string LOCAL_OS = $cfg(target_os);
string ARCH = $cfg(target_arch);
string ABI = $cfg(target_abi);

fn main() i32 {
    println(LOCAL_OS == TARGET_OS, " ", ARCH.len > 0, " ", ABI.len);
    return 0;
}
