//! run
//! stdout:
//| 3 5
//| 1 2 Green
//| 4 10
import mathx;

fn i32 main() {
    println(mathx.add(1, 2), " ", mathx.LIMIT);
    mathx.Vec v = {1, 2};
    mathx.Vec w = mathx.Vec{.y = 2, .x = 1};
    println(v.x, " ", w.y, " ", mathx.Color.Green);
    i32[mathx.N] arr = {};
    println(arr.len, " ", mathx.scale(v).x);
    return 0;
}
