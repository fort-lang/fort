//! run
//! stdout:
//| 6 20
//| wide thin
//| 8 12
//| 20 3
import shapes;

struct frame {
    shapes.rect inner;
    shapes.kind tag;
}

fn i32 side(shapes.rect r) {
    return r.w;
}

fn i32 main() {
    shapes.rect r = {2, 3};
    shapes.rect big = shapes.grow(r, 2);
    println(shapes.area(r), " ", shapes.area(big));
    println(shapes.classify(shapes.rect{.w = 3, .h = 1}), " ", shapes.classify(r));
    frame f = {big, shapes.kind.thin};
    println(sizeof(shapes.rect), " ", sizeof(frame));
    fn i32(shapes.rect) f_area = shapes.area;
    println(f_area(f.inner) + side(r) - shapes.name_len("ab"), " ", shapes.name_len("abc"));
    return 0;
}
