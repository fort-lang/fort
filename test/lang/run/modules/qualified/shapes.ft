// Module `shapes`: the declarations main.ft reaches through a qualified name
// in every position D9.4 lists.
struct rect {
    i32 w;
    i32 h;
}

enum kind {
    thin,
    wide,
}

fn area(rect r) i32 {
    return r.w * r.h;
}

fn grow(rect r, i32 by) rect {
    return rect{r.w + by, r.h + by};
}

fn classify(rect r) kind {
    if (r.w > r.h) {
        return kind.wide;
    }
    return kind.thin;
}

fn name_len(string s) i32 {
    return cast(s.len, i32);
}
