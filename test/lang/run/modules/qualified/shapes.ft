// Module `shapes`: the declarations main.ft reaches through a qualified name
// in every position D9.4 lists.
struct rect {
    i32 w;
    i32 h;
}

enum kind {
    thin,
    wide,
}

fn i32 area(rect r) {
    return r.w * r.h;
}

fn rect grow(rect r, i32 by) {
    return rect{r.w + by, r.h + by};
}

fn kind classify(rect r) {
    if (r.w > r.h) {
        return kind.wide;
    }
    return kind.thin;
}

fn i32 name_len(string s) {
    return cast(s.len, i32);
}
