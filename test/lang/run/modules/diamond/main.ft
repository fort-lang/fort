//! run
//! stdout:
//| 1 0
//| 0 2
//| 1 2
import left;
import right;
import geom.vec.vec2;

fn i32 main() {
    vec2 zero = {0, 0};
    vec2 a = left.shift(zero);
    vec2 b = right.lift(zero);
    vec2 both = left.shift(right.lift(zero));
    println(a.x, " ", a.y);
    println(b.x, " ", b.y);
    println(both.x, " ", both.y);
    return 0;
}
