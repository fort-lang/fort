//! run
//! stdout:
//| 3 97 99
//| true 3
//| abc 3 true
//| 0 true
// An owning value crosses a module boundary in both directions: `store.make`
// hands one over as an `own` rvalue, `move` passes it to `store.take`, and the
// moved-from binding is left null (D17.5, D17.6). A `string own` built in one
// module is freed in the other (D17.12).
import store;

fn i32 main() {
    store.buf mut* own b = store.make(3);
    println(b->len, " ", b->data[0], " ", b->data[2]);
    store.buf mut* own c = move(b);
    println(b == null, " ", c->len);
    string own text = store.copy("abc");
    println(text, " ", text.len, " ", text == "abc");
    store.take(move(c));
    del(text);
    println(text.len, " ", c == null);
    return 0;
}
