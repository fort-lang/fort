// An owning aggregate, its allocator and its consumer, all in an imported
// module: `own` is part of every signature that crosses the boundary (D9.8,
// D17.13), and the module that allocates need not be the one that frees.
struct buf {
    u8 mut@ own data;
    u64 len;
}

fn buf mut* own make(u64 n) {
    buf mut* own b = new(buf);
    b->data = new(u8, n);
    b->len = n;
    for (u64 mut i = 0; i < n; i++) {
        b->data[i] = cast(97 + i, u8);
    }
    return b;
}

fn void take(buf mut* own b) {
    del(b->data);
    del(b);
}

fn string own copy(string s) {
    u8 mut@ own bytes = new(u8, s.len);
    for (u64 mut i = 0; i < s.len; i++) {
        bytes[i] = cast(s[i], u8);
    }
    return cast(move(bytes), string own);
}
