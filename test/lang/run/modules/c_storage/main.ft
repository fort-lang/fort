//! run
//! stdout:
//| 41 41
//| 42 42
import cbox;

// A module outside the trusted set holds two values of the trusted module `cbox` over a call
// that releases storage of C (D9.8, "Storage of C"). `get` gives a copy of a record that
// `reset` releases, so the copy keeps its value. `kept` gives a view of a record that no
// function releases, by the `gives:` line of its row, so the load through the view after the
// two calls of `reset` and a new call of `get` reads the same record.
fn main() i32 {
    cbox.rec v = cbox.get();
    cbox.rec* k = cbox.kept();
    if (k == null) {
        return 1;
    }
    print(v.a, " ");
    cbox.reset();
    println(v.a);
    print(k->a, " ");
    cbox.reset();
    cbox.rec again = cbox.get();
    cbox.reset();
    println(k->a + again.a - 41);
    return 0;
}
