//! run
//! stdout:
//| a false
//| cd false
//| e true
//| gh false
//| ij 1
//| ln 2
//| o true
//| pqr true
fn bool say(string tag, bool v) {
    print(tag);
    return v;
}

fn i32 num(string tag, i32 v) {
    print(tag);
    return v;
}

fn i32 main() {
    bool r1 = say("a", false) && say("b", true);
    println(" ", r1);
    bool r2 = say("c", true) && say("d", false);
    println(" ", r2);
    bool r3 = say("e", true) || say("f", true);
    println(" ", r3);
    bool r4 = say("g", false) || say("h", false);
    println(" ", r4);
    i32 t1 = say("i", true) ? num("j", 1) : num("k", 2);
    println(" ", t1);
    i32 t2 = say("l", false) ? num("m", 1) : num("n", 2);
    println(" ", t2);
    bool r5 = !say("o", false);
    println(" ", r5);
    bool r6 = say("p", true) && (say("q", false) || say("r", true));
    println(" ", r6);
    return 0;
}
