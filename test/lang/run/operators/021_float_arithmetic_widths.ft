//! run
//! stdout:
//| 9.5 5.5 15.0 3.75
//| 9.5 5.5 15.0 3.75
//| 0.33333334 0.3333333333333333
//| 16777216.0 16777216.0 16777218.0
// The four operations run in the operand's own type: the same expression in
// f32 and in f64 gives different digits, and an f32 addition rounds to
// binary32 (D6.12, D11.7).
fn i32 main() {
    f64 a = 7.5;
    f64 b = 2.0;
    println(a + b, " ", a - b, " ", a * b, " ", a / b);
    f32 c = 7.5;
    f32 d = 2.0;
    println(c + d, " ", c - d, " ", c * d, " ", c / d);
    f32 one = 1.0;
    f32 three = 3.0;
    f64 wone = 1.0;
    f64 wthree = 3.0;
    println(one / three, " ", wone / wthree);
    f32 big = 16777216.0;
    f32 step = 1.0;
    // 16777216 + 1 has no binary32 and goes to the even mantissa, so it
    // stands still whatever the step is added to it; 16777216 + 2 has one.
    f32 two = 2.0;
    println(big + step, " ", big + step + step, " ", big + two);
    return 0;
}
