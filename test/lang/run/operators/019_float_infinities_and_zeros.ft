//! run
//! stdout:
//| inf -inf nan
//| true false true
//| -0.0 0.0 0.0
//| inf -inf inf
// Division by zero yields an infinity or a NaN and never traps, and the two
// zeros compare equal (D6.12).
fn i32 main() {
    f64 zero = 0.0;
    f64 one = 1.0;
    f64 inf = one / zero;
    f64 below = -one / zero;
    println(inf, " ", below, " ", inf + below);
    println(zero == -zero, " ", inf == below, " ", inf > below);
    f64 nzero = -zero;
    println(nzero, " ", zero + nzero, " ", nzero + nzero + zero);
    println(inf + inf, " ", below * one, " ", inf * inf);
    return 0;
}
