//! run
//! stdout:
//| -2 -2
//| -5 -5
//| 9 9
//| 9 9
//| 2 2
//| 80 80
//| 8 8
//| true true
//| true true
//| 7 7
//| 6 6
//| 7 7
//| false false
//| true true
//| 75 75
//| 10 10
//| 32 32
//| 8 8
//| 7 7
//| 40 40
//| -4 -4
//| 14 14
//| 27 27
//| 16 16
//| 4 4
//| 11 11
//| 27 27
//| true true
// The precedence ladder of D6.1 read off by value rather than by syntax tree:
// each line evaluates an expression written without parentheses beside the
// same expression parenthesized the way the ladder says it groups, and prints
// both. The parser's own view of the ladder is parser_test.c; this is the
// emitter agreeing with it.
struct point {
    i32 x;
    i32@ row;
}

fn twice(i32 n) i32 {
    return n + n;
}

i32[4] TABLE = {10, 20, 30, 40};

fn main() i32 {
    i32 a = 2;
    i32 b = 3;
    i32 c = 4;
    i32 d = 5;

    // Unary binds tighter than `*`, which binds tighter than `+`.
    println(-a * b + c, " ", ((-a) * b) + c);
    println(~a * b + c, " ", ((~a) * b) + c);

    // `* / % *%` above `+ - +% -%`.
    println(a + b * c - d, " ", (a + (b * c)) - d);
    println(a +% b *% c -% d, " ", (a +% (b *% c)) -% d);
    println(20 / b % c, " ", (20 / b) % c);

    // `+ -` above `<< >>`.
    println(a + b << c, " ", (a + b) << c);
    println(64 >> a + 1, " ", 64 >> (a + 1));

    // `<< >>` above the relational operators.
    println(a << b < c << b, " ", (a << b) < (c << b));

    // Relational above equality.
    println(a < b == c < d, " ", (a < b) == (c < d));

    // `&` is above `^`, which is above `|`. Equality sits above all three,
    // which no value can show -- `6 & 3 == 3` groups as `6 & (3 == 3)` and is
    // a type error -- so fail/operators/009 records that level instead.
    println(6 ^ 3 & 5, " ", 6 ^ (3 & 5));
    println(6 | 3 ^ 5, " ", 6 | (3 ^ 5));
    println(6 | 3 & 5, " ", 6 | (3 & 5));

    // `|` above `&&`, and `&&` above `||`.
    bool t = true;
    bool f = false;
    println(f || t && f, " ", f || (t && f));
    println(t && f || t, " ", (t && f) || t);

    // Every binary operator is left-associative.
    println(100 - 20 - 5, " ", (100 - 20) - 5);
    println(100 / 5 / 2, " ", (100 / 5) / 2);
    println(1 << 2 << 3, " ", (1 << 2) << 3);
    println(64 >> 2 >> 1, " ", (64 >> 2) >> 1);

    // Primary binds tightest of all: calls, indexes, fields and `->`.
    point p = point{7, TABLE[0..TABLE.len]};
    point* pp = &p;
    println(twice(a) + b, " ", (twice(a)) + b);
    println(TABLE[1] * a, " ", (TABLE[1]) * a);
    println(-p.x + b, " ", (-(p.x)) + b);
    println(pp->x * a, " ", (pp->x) * a);
    println(p.row[2] - b, " ", (p.row[2]) - b);
    println(sizeof(i64) * a, " ", (sizeof(i64)) * a);
    println(cast(b, i64) + 1, " ", (cast(b, i64)) + 1);

    // `&` and `*` as unary operators bind tighter than any binary one.
    i32 mut v = 9;
    i32 mut* q = &v;
    println(*q + a, " ", (*q) + a);
    println(*q * b, " ", (*q) * b);
    println(!(*q == 9) || true, " ", (!(*q == 9)) || true);
    return 0;
}
