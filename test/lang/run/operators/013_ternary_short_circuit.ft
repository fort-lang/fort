//! run
//! stdout:
//| ij 1
//| ln 2
fn say(string tag, bool v) bool {
    print(tag);
    return v;
}

fn num(string tag, i32 v) i32 {
    print(tag);
    return v;
}

fn main() i32 {
    i32 t1 = say("i", true) ? num("j", 1) : num("k", 2);
    println(" ", t1);
    i32 t2 = say("l", false) ? num("m", 1) : num("n", 2);
    println(" ", t2);
    return 0;
}
