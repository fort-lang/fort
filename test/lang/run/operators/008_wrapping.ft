//! run
//! stdout:
//| 0 255 -128 127
//| -2147483648 0 1
//| 12638187200555641996 0 255
fn i32 main() {
    u8 u = 255;
    u8 z = 0;
    i8 p = 127;
    i8 n = -128;
    println(u +% 1, " ", z -% 1, " ", p +% 1, " ", n -% 1);
    i32 imax = 2147483647;
    u32 half = 0x80000000;
    u32 umax = 0xFFFFFFFF;
    println(imax +% 1, " ", half *% 2, " ", umax *% umax);
    mut u64 h = 14695981039346656037;
    h ^= 'a';
    h *%= 1099511628211;
    mut u8 c = 250;
    c +%= 6;
    mut u8 d = 3;
    d -%= 4;
    println(h, " ", c, " ", d);
    return 0;
}
