//! run
//! stdout:
//| 0 255 -128 127
//| -2147483648 0 1
//| 12638187200555641996 0 255
//| 9000000000 6000000000 -9000000000
fn main() i32 {
    u8 u = 255;
    u8 z = 0;
    i8 p = 127;
    i8 n = -128;
    println(u +% 1, " ", z -% 1, " ", p +% 1, " ", n -% 1);
    i32 imax = 2147483647;
    u32 half = 0x80000000;
    u32 umax = 0xFFFFFFFF;
    println(imax +% 1, " ", half *% 2, " ", umax *% umax);
    u64 mut h = 14695981039346656037;
    h ^= 'a';
    h *%= 1099511628211;
    u8 mut c = 250;
    c +%= 6;
    u8 mut d = 3;
    d -%= 4;
    println(h, " ", c, " ", d);
    // Two untyped constants have no width to wrap at, so a wrapping operator
    // folds them exactly, as its plain form does (D4.4, D4.6, D11.2). The
    // operands of every line above have a type, so the wrap there is the one
    // the width decides. One assertion for each of the three operators,
    // because check.fold_untyped gives each its own case and a case holds
    // nothing of its neighbours. The fourth thing D11.2 asks -- that an exact
    // result outside the constant range is an error -- cannot stand in a run
    // test, and test/fort/check_diags_test.ft:114 holds it.
    i64 exact = 3000000000 *% 3;
    println(exact, " ", 3000000000 +% 3000000000, " ", 0 -% 9000000000);
    return 0;
}
