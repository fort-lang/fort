//! run
//! stdout:
//| 48 252 204 240
//| 0 -1 -256
//| 18446744073709551360 255
//| 6 14 12
fn i32 main() {
    u8 a = 0xF0;
    u8 b = 0x3C;
    u8 c = 0x0F;
    println(a & b, " ", a | b, " ", a ^ b, " ", ~c);
    i32 zero = 0;
    i32 ff = 255;
    println(zero & ff, " ", ~zero, " ", ~ff);
    u64 big = 0xFF;
    println(~big, " ", big & 0xFFF);
    u8 mut m = 0x0E;
    m &= 0x07;
    print(m, " ");
    m |= 0x08;
    print(m, " ");
    m ^= 0x02;
    println(m);
    return 0;
}
