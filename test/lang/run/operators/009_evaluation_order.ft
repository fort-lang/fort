//! run
//! stdout:
//| 123 7
//| 45 9
//| 67 6 7
//| 89 8 9
//| idx val 3
fn i32 f(i32 x) {
    print(x);
    return x;
}

fn i32 add(i32 a, i32 b) {
    return a + b;
}

struct point {
    i32 x;
    i32 y;
}

fn u64 idx() {
    print("idx ");
    return 1;
}

fn i32 val() {
    print("val ");
    return 3;
}

fn i32 main() {
    i32 s = f(1) + f(2) * f(3);
    println(" ", s);
    i32 t = add(f(4), f(5));
    println(" ", t);
    point p = {f(6), f(7)};
    println(" ", p.x, " ", p.y);
    i32[2] a = {f(8), f(9)};
    println(" ", a[0], " ", a[1]);
    i32[3] mut arr = {};
    arr[idx()] = val();
    println(arr[1]);
    return 0;
}
