//! run
//! stdout:
//| 123 7
//| 45 9
//| 67 6 7
//| 89 8 9
//| idx val 3
fn f(i32 x) i32 {
    print(x);
    return x;
}

fn add(i32 a, i32 b) i32 {
    return a + b;
}

struct point {
    i32 x;
    i32 y;
}

fn idx() u64 {
    print("idx ");
    return 1;
}

fn val() i32 {
    print("val ");
    return 3;
}

fn main() i32 {
    i32 s = f(1) + f(2) * f(3);
    println(" ", s);
    i32 t = add(f(4), f(5));
    println(" ", t);
    point p = {f(6), f(7)};
    println(" ", p.x, " ", p.y);
    i32[2] a = {f(8), f(9)};
    println(" ", a[0], " ", a[1]);
    i32[3] mut arr = {};
    arr[idx()] = val();
    println(arr[1]);
    return 0;
}
