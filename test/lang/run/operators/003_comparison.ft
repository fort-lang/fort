//! run
//! stdout:
//| true false true true false true
//| true false true
//| true false true
//| true false true
//| false true
enum color {
    red,
    green,
}

fn main() i32 {
    i32 a = 3;
    i32 b = 5;
    println(a < b, " ", a > b, " ", a <= 3, " ", b >= 5, " ", a == b, " ", a != b);
    char c = 'a';
    println(c < 'b', " ", c == 'A', " ", c >= 'a');
    string s = "hi";
    println(s == "hi", " ", s == "ho", " ", s != "");
    bool t = true;
    i32* p = &a;
    i32* q = &b;
    i32* r = p;
    println(t == true, " ", p == q, " ", p == r);
    println(color.red == color.green, " ", color.red != color.green);
    return 0;
}
