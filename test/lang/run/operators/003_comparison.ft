//! run
//! stdout:
//| true false true true false true
//| false true true
//| true false true
//| true false true
//| true false true
//| false true
enum Color {
    Red,
    Green,
}

fn i32 main() {
    i32 a = 3;
    i32 b = 5;
    println(a < b, " ", a > b, " ", a <= 3, " ", b >= 5, " ", a == b, " ", a != b);
    f64 x = 0.1 + 0.2;
    f64 zero = 0.0;
    f64 z = -zero;
    println(x == 0.3, " ", z == 0.0, " ", x > 0.3);
    char c = 'a';
    println(c < 'b', " ", c == 'A', " ", c >= 'a');
    string s = "hi";
    println(s == "hi", " ", s == "ho", " ", s != "");
    bool t = true;
    i32* p = &a;
    i32* q = &b;
    i32* r = p;
    println(t == true, " ", p == q, " ", p == r);
    println(Color.Red == Color.Green, " ", Color.Red != Color.Green);
    return 0;
}
