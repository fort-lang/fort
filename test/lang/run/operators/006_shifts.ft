//! run
//! stdout:
//| 128 1 -128 -1
//| -1 15 2147483648 1099511627776
//| 9223372036854775808 8 4 -4
//| 1024 4096
fn i32 main() {
    u8 one = 1;
    u8 high = 0x80;
    i8 neg = -128;
    println(one << 7, " ", high >> 7, " ", neg >> 0, " ", neg >> 7);
    i16 m1 = -1;
    u16 all = 0xFFFF;
    u32 w = 1;
    i64 big = 1;
    println(m1 >> 3, " ", all >> 12, " ", w << 31, " ", big << 40);
    u64 top = 1;
    u64 k = 3;
    mut i32 s = 1;
    s <<= 3;
    mut i32 t = -32;
    t >>= 3;
    println(top << 63, " ", one << k, " ", s >> 1, " ", t);
    i8 ten = 10;
    u64 wide = 1 << ten;
    i32 twelve = 12;
    i32 narrow = 1 << twelve;
    println(wide, " ", narrow);
    return 0;
}
