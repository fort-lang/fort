//! run
//! stdout:
//| 127 -128 255 0
//| 32767 -32768 65535 0
//| 2147483647 -2147483648 4294967295 0
//| 9223372036854775807 -9223372036854775808 18446744073709551615 0
//| -128 127 -9223372036854775808 9223372036854775807
//| 0 -1 1 -1
// The extremes of every integer type reached through the checked operators
// of D11.1: an operation whose exact result is the largest or the smallest
// value of its type must not trap, which is the boundary the overflow
// intrinsics of toolchain.md 6 item 15 sit on.
fn one8() i8 {
    return 1;
}

fn main() i32 {
    i8 a = 126;
    i8 b = -127;
    u8 c = 254;
    u8 d = 1;
    println(a + one8(), " ", b - one8(), " ", c + 1, " ", d - 1);
    i16 e = 32766;
    i16 f = -32767;
    u16 g = 65534;
    u16 h = 1;
    println(e + 1, " ", f - 1, " ", g + 1, " ", h - 1);
    i32 i = 2147483646;
    i32 j = -2147483647;
    u32 k = 4294967294;
    u32 l = 1;
    println(i + 1, " ", j - 1, " ", k + 1, " ", l - 1);
    i64 m = 9223372036854775806;
    i64 n = -9223372036854775807;
    u64 o = 18446744073709551614;
    u64 p = 1;
    println(m + 1, " ", n - 1, " ", o + 1, " ", p - 1);
    // MIN is divisible by 1 and by itself, and the negation of MIN + 1 fits.
    i8 min8 = -128;
    i64 min64 = -9223372036854775808;
    println(min8 / one8(), " ", -(min8 + one8()), " ", min64 / 1, " ", -(min64 + 1));
    // MIN % -1 traps, but MIN % 1 and MAX % -1 do not (D6.13).
    i32 neg = -1;
    i32 big = 2147483647;
    println(-2147483648 % 1, " ", big % neg + neg, " ", big / big, " ", neg * 1);
    return 0;
}
