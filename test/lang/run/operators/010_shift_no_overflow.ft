//! run
//! stdout:
//| -2147483648 -2147483648 -2147483648
//| 0 -128 128
fn i32 thirty_one() {
    return 31;
}

fn i32 main() {
    i32 one = 1;
    i32 n = thirty_one();
    i32 folded = 1 << 31;
    println(folded, " ", one << 31, " ", one << n);
    i32 top = -2147483648;
    i8 small = 64;
    u8 byte = 1;
    println(top << 1, " ", small << 1, " ", byte << 7);
    return 0;
}
