//! run
//! stdout:
//| 10 4 21 2 1
//| -7
//| 13 11 22 11 1
//| 6 5
fn i32 main() {
    i32 a = 7;
    i32 b = 3;
    println(a + b, " ", a - b, " ", a * b, " ", a / b, " ", a % b);
    println(-a);
    mut i32 c = 11;
    c += 2;
    print(c, " ");
    c -= 2;
    print(c, " ");
    c *= 2;
    print(c, " ");
    c /= 2;
    print(c, " ");
    c %= 5;
    println(c);
    mut i32 d = 5;
    d++;
    print(d, " ");
    d--;
    println(d);
    return 0;
}
