//! run
//! stdout:
//| 1 2 3
//| 10 -5
//| big small
//| x
// The `f64 f = true ? 4.5 : 1.0;` line of this test went in T-044. No
// compiler can run it: stage1 refuses every `?:` and stage2 refuses every
// float, so the line kept the whole test on stage2's unsupported list for a
// case neither compiler reaches. run/constants/006_folding_float_ternary.ft
// holds a float `?:` and stays on both lists, so the case returns as a run
// test the day stage2 gains floats.
fn pick(i32 n) i32 {
    return n == 1 ? 1 : n == 2 ? 2 : 3;
}

fn size(i32 n) string {
    return n > 100 ? "big" : "small";
}

fn main() i32 {
    println(pick(1), " ", pick(2), " ", pick(9));
    i32 v = 5;
    i32 w = v > 0 ? v * 2 : v;
    i32 x = v < 0 ? v : -v;
    println(w, " ", x);
    println(size(1000), " ", size(1));
    char c = false ? 'y' : 'x';
    println(c);
    return 0;
}
