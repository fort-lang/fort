//! run
//! stdout:
//| 1 2 3
//| 10 -5
//| big small
//| 4.5 x
fn i32 pick(i32 n) {
    return n == 1 ? 1 : n == 2 ? 2 : 3;
}

fn string size(i32 n) {
    return n > 100 ? "big" : "small";
}

fn i32 main() {
    println(pick(1), " ", pick(2), " ", pick(9));
    i32 v = 5;
    i32 w = v > 0 ? v * 2 : v;
    i32 x = v < 0 ? v : -v;
    println(w, " ", x);
    println(size(1000), " ", size(1));
    f64 f = true ? 4.5 : 1.0;
    char c = false ? 'y' : 'x';
    println(f, " ", c);
    return 0;
}
