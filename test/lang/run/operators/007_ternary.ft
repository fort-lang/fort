//! run
//! stdout:
//| 1 2 3
//| 10 -5
//| big small
//| x
// T-044 added this conditional test. The float conditional has its own test in
// run/constants/006_folding_float_ternary.ft.
fn pick(i32 n) i32 {
    return n == 1 ? 1 : n == 2 ? 2 : 3;
}

fn size(i32 n) string {
    return n > 100 ? "big" : "small";
}

fn main() i32 {
    println(pick(1), " ", pick(2), " ", pick(9));
    i32 v = 5;
    i32 w = v > 0 ? v * 2 : v;
    i32 x = v < 0 ? v : -v;
    println(w, " ", x);
    println(size(1000), " ", size(1));
    char c = false ? 'y' : 'x';
    println(c);
    return 0;
}
