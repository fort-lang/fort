//! run
//! stdout:
//| 3 4
//| 2 7
//| hi
//| 4 7 0 2
// An aggregate arm of `?:` is written into the destination of the whole
// conditional, and only the arm the condition selects runs (D6.6, D19.3).
struct point {
    i32 x;
    i32 y;
}

struct buf {
    u8 mut@ own data;
    u64 len;
}

fn point pick(bool go, point a, point b) {
    return go ? a : b;
}

fn i32 main() {
    point one = {1, 2};
    point two = {3, 4};
    point p = pick(false, one, two);
    println(p.x, " ", p.y);
    i32[3] nums = {5, 6, 7};
    i32@ view = 1 > 2 ? nums[0..1] : nums[1..3];
    println(view.len, " ", view[1]);
    string s = "hi";
    println(view.len == 2 ? s : "bye");
    // An owning aggregate arm is the transfer of D17.7 and is written
    // `move`, which empties the arm the condition selects and leaves the
    // other one holding its own allocation.
    buf mut big = buf{new(u8, 4), 4};
    buf mut small = buf{new(u8, 2), 2};
    buf mut got = true ? move(big) : move(small);
    got.data[0] = 7;
    println(got.len, " ", got.data[0], " ", big.data.len, " ", small.len);
    del(got.data);
    del(small.data);
    return 0;
}
