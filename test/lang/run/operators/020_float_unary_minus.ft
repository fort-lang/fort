//! run
//! stdout:
//| -1.5 1.5 -0.0 0.0
//| true true
//| -2.5 2.5 -0.0
// Unary minus flips the sign, a zero included: -(0.0) is -0.0 while
// 0.0 - 0.0 is +0.0, which is the difference between a negation and a
// subtraction (D6.12).
fn i32 main() {
    f64 a = 1.5;
    f64 zero = 0.0;
    println(-a, " ", -(-a), " ", -zero, " ", zero - zero);
    println(-zero == zero, " ", -zero == 0.0);
    f32 b = 2.5;
    f32 fzero = 0.0;
    println(-b, " ", -(-b), " ", -fzero);
    return 0;
}
