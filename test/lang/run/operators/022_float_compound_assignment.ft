//! run
//! stdout:
//| 3.5 1.5 3.0 1.5
//| 2.5 5.0
//| 0.5 2.0
// The compound assignments of D7.2 take the operand rules of their operator,
// so `+= -= *= /=` apply to floats and every other one does not.
struct box {
    f64 value;
}

fn main() i32 {
    f64 mut a = 1.5;
    a += 2.0;
    print(a, " ");
    a -= 2.0;
    print(a, " ");
    a *= 2.0;
    print(a, " ");
    a /= 2.0;
    println(a);
    box mut b = box{2.0};
    b.value += 0.5;
    f64 mut@ own span = new(f64, 2);
    span[0] = 4.0;
    span[0] *= 1.25;
    println(b.value, " ", span[0]);
    f64 mut* p = &a;
    *p /= 3.0;
    f32 mut small = 4.0;
    small /= 2.0;
    println(a, " ", small);
    del(span);
    return 0;
}
