//! run
//! stdout:
//| false true false false false false
//| false true false false false false
//| false true
//| true false true true
// NaN != NaN and every ordering with a NaN is false, in both directions and
// in both types (D6.12). A program can only see this rule through a NaN, and
// there is no NaN literal: 0.0 / 0.0 makes one and never traps.
fn i32 main() {
    f64 zero = 0.0;
    f64 nan = zero / zero;
    f64 one = 1.0;
    println(nan == nan, " ", nan != nan, " ", nan < nan, " ", nan <= nan, " ", nan > nan, " ",
            nan >= nan);
    println(nan == one, " ", nan != one, " ", nan < one, " ", nan <= one, " ", nan > one, " ",
            nan >= one);
    println(one == nan, " ", one != nan);
    f32 fzero = 0.0;
    f32 fnan = fzero / fzero;
    f32 fone = 1.0;
    println(fnan != fnan, " ", fnan == fone, " ", fone != fnan, " ", !(fnan < fone));
    return 0;
}
