//! run
//! stdout:
//| -3 -1
//| -3 1
//| 3 -1
//| -2 -1
fn i32 neg(i32 v) {
    return -v;
}

fn i32 main() {
    i32 a = neg(7);
    i32 b = 2;
    i32 c = neg(2);
    println(a / b, " ", a % b);
    println(7 / c, " ", 7 % c);
    println(a / c, " ", a % c);
    i64 d = cast(neg(9), i64);
    i64 e = 4;
    println(d / e, " ", d % e);
    return 0;
}
