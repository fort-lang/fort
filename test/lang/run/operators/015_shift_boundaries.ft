//! run
//! stdout:
//| 1 128 -128 1
//| 1 32768 -32768 1
//| 1 2147483648 -2147483648 1
//| 1 9223372036854775808 -9223372036854775808 1
//| 1 -1 0 -1
// A shift count of zero and of width - 1 is the last count that does not
// trap (D11.1); the count is materialized at 64 bits and compared against
// the width, so both ends of the range are worth pinning down.
fn zero() i32 {
    return 0;
}

fn main() i32 {
    u8 a = 1;
    i8 b = 1;
    println(a << zero(), " ", cast(a, u64) << 7, " ", b << 7, " ", a >> zero());
    u16 c = 1;
    i16 d = 1;
    println(c << zero(), " ", cast(c, u64) << 15, " ", d << 15, " ", c >> zero());
    u32 e = 1;
    i32 f = 1;
    println(e << zero(), " ", cast(e, u64) << 31, " ", f << 31, " ", e >> zero());
    u64 g = 1;
    i64 h = 1;
    println(g << zero(), " ", g << 63, " ", h << 63, " ", g >> zero());
    // The high bit shifted right: logical for an unsigned operand and
    // arithmetic for a signed one (D6.2).
    u64 top = 9223372036854775808;
    i64 neg = -9223372036854775808;
    println(top >> 63, " ", neg >> 63, " ", top >> 63 >> 1, " ", neg >> 63 >> zero());
    return 0;
}
