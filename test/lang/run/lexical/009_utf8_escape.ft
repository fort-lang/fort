//! run
//! stdout:
//| 1 233
//| 2 255 254
//| 3 237 160 128
//| 233
// The bytes of a string value are UTF-8 by convention and never validated (D3.7). The lexer
// checks the source text, not the value: the escape `\xHH` puts each byte into a string
// literal and into a char literal. The third string holds the bytes of a surrogate, which are
// no UTF-8 text.
fn main() i32 {
    string one = "\xE9";
    println(one.len, " ", cast(one[0], u8));
    string two = "\xff\xfe";
    println(two.len, " ", cast(two[0], u8), " ", cast(two[1], u8));
    string three = "\xED\xA0\x80";
    println(three.len, " ", cast(three[0], u8), " ", cast(three[1], u8), " ", cast(three[2], u8));
    char c = '\xE9';
    println(cast(c, u8));
    return 0;
}
