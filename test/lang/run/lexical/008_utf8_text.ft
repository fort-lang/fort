//! run
//! stdout:
//| café 2 5
//| € 3
//| 😀 4
//| 2 2 3 3 3 3 4 4
//| 3
// Source is UTF-8 (D2.1). UTF-8 text of two, three and four bytes stands in a string literal
// and in a comment, and the lexer keeps each byte: `len` counts bytes. The fourth line holds
// the first and the last code point of each length, U+0080, U+07FF, U+0800, U+D7FF, U+E000,
// U+FFFF, U+10000 and U+10FFFF. U+FEFF is a byte-order mark only at the start of a file.
fn main() i32 {
    // café, €, 😀, ߿ࠀ퟿￿𐀀􏿿
    println("café", " ", "é".len, " ", "café".len); // café
    println("€", " ", "€".len);
    println("😀", " ", "😀".len);
    println("".len, " ", "߿".len, " ", "ࠀ".len, " ", "퟿".len, " ",
            "".len, " ", "￿".len, " ", "𐀀".len, " ",
            "􏿿".len);
    println("﻿".len); // ﻿
    return 0;
}
