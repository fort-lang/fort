//! run
//! stdout:
//| aZ0 '\"A
//| 0 10 13 9 127 39
//| x|y
fn main() i32 {
    println('a', 'Z', '0', ' ', '\'', '\\', '"', '\x41');
    println(cast('\0', i32), " ", cast('\n', i32), " ", cast('\r', i32), " ", cast('\t', i32),
            " ", cast('\x7F', i32), " ", cast('\'', i32));
    char bar = '|';
    println('x', bar, 'y');
    return 0;
}
