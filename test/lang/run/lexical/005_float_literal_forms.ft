//! run
//! stdout:
//| 1.0 0.5 1000000.0 0.0001
//| 0.0025 10000000000.0 100.0 0.0
//| 1000.0001 123.456 7.0
// Every form of D2.6: digits, a point and digits, an exponent in either case
// with either sign, and `_` between two digits. There are no suffixes.
fn i32 main() {
    println(1.0, " ", 0.5, " ", 1e6, " ", 1E-4);
    println(2.5e-3, " ", 1e10, " ", 1.0E+2, " ", 0.0);
    println(1_000.000_1, " ", 12_3.45_6, " ", 0.7e1);
    return 0;
}
