//! run
//! stdout:
//| plain
//| say "hi"
//| back\slash
//| Hi
//| it's
//| 3 0
//| a // b /* c */
//| héllo
//| 7 8 9
fn i32 main() {
    println("plain");
    println("say \"hi\"");
    println("back\\slash");
    println("\x48\x69");
    println("it\'s");
    println("a\0b".len, " ", "".len);
    println("a // b /* c */");
    println("héllo"); // non-ASCII bytes are fine in strings and in comments: café
    /* a block comment
       spanning lines */
    i32 x = /* inline */ 7;
    i32 y = 8; // trailing
    i32 z = /* outer /* not nested */ 9;
    println(x, /* between args */ " ", y, " ", z);
    return 0;
}
