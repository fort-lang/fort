//! run
//! stdout:
//| 1.0 0.0025 10000000000.0 3.25 100.0
//| 0.5 1.5 0.125
//| 1000000.0 0.001
fn main() i32 {
    println(1.0, " ", 2.5e-3, " ", 1e10, " ", 3.25, " ", 1E2);
    f32 h = 0.5;
    f32 q = 1.5e0;
    f64 e = 12_5.0e-3;
    println(h, " ", q, " ", e);
    println(1.0e6, " ", 1.0E-3);
    return 0;
}
