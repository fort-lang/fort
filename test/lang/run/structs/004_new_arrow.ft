//! run
//! stdout:
//| 0 0
//| 5 6
//| 5 6 7
//| 30
struct point {
    i32 x;
    i32 y;
}

fn sum(point* p) i32 {
    return p->x + p->y;
}

fn make(i32 x, i32 y) point mut* own {
    point mut* own p = new(point);
    p->x = x;
    p->y = y;
    return p;
}

fn main() i32 {
    point mut* own p = new(point);
    println(p->x, " ", p->y);
    p->x = 5;
    (*p).y = 6;
    println(p->x, " ", (*p).y);
    point copy = *p;
    p->x = 7;
    println(copy.x, " ", copy.y, " ", p->x);
    del(p);
    point mut* own q = make(10, 20);
    println(sum(q));
    del(q);
    return 0;
}
