//! run
//! stdout:
//| 0 0
//| 5 6
//| 5 6 7
//| 30
struct Point {
    i32 x;
    i32 y;
}

fn i32 sum(Point* p) {
    return p->x + p->y;
}

fn mut Point* make(i32 x, i32 y) {
    mut Point* p = new(Point);
    p->x = x;
    p->y = y;
    return p;
}

fn i32 main() {
    mut Point* p = new(Point);
    println(p->x, " ", p->y);
    p->x = 5;
    (*p).y = 6;
    println(p->x, " ", (*p).y);
    Point copy = *p;
    p->x = 7;
    println(copy.x, " ", copy.y, " ", p->x);
    del(p);
    mut Point* q = make(10, 20);
    println(sum(q));
    del(q);
    return 0;
}
