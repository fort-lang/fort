//! run
//! stdout:
//| 16 24
//| 7 9 11 2
// Two mutually recursive structs, declared with the one that reaches the
// other through a span first. `vec` holds a span of pointers to `node`, so
// its size is two words whatever a `node` is, and `node` holds a `vec` by
// value: neither layout depends on the other and the pair must check
// whichever order the file declares them in (D7.10, D3.5, D3.11, D3.8).
// 009_recursive_value_first.ft is the same program with the two declarations
// swapped, and prints the same lines.
struct vec {
    node mut* mut@ own items;
}

struct node {
    vec kids;
    i32 tag;
}

fn main() i32 {
    // A span is a fat pointer, two words; the struct holding one and an i32
    // rounds up to three (D3.5, D3.8).
    println(sizeof(vec), " ", sizeof(node));
    node mut root = {};
    node mut left = {};
    node mut right = {};
    root.tag = 7;
    left.tag = 9;
    right.tag = 11;
    // `new` marks the storage it allocates and nothing below it, so the `mut`
    // the field's type wants is written inside it (D17.3, D5.8, D10.2).
    root.kids.items = new(node mut*, 2);
    root.kids.items[0] = &left;
    root.kids.items[1] = &right;
    println(root.tag, " ", root.kids.items[0]->tag, " ", root.kids.items[1]->tag, " ",
            root.kids.items.len);
    del(root.kids.items);
    return 0;
}
