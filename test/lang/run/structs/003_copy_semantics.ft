//! run
//! stdout:
//| 1 9
//| 1 100
//| 2 1
//| 5 0
struct Point {
    i32 x;
    i32 y;
}

struct Buf {
    i32[3] data;
}

fn void bump(mut Point p) {
    p.x = 100;
}

fn Point moved(Point p) {
    return Point{p.x + 1, p.y};
}

fn i32 main() {
    mut Point a = {1, 2};
    Point b = a;
    a.x = 9;
    println(b.x, " ", a.x);
    bump(b);
    mut Point c = b;
    bump(c);
    c.x = 100;
    println(b.x, " ", c.x);
    Point m = moved(b);
    println(m.x, " ", b.x);
    mut Buf k = {{5, 6, 7}};
    Buf j = k;
    k.data[0] = 0;
    println(j.data[0], " ", k.data[0]);
    return 0;
}
