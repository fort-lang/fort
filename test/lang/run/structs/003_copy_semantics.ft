//! run
//! stdout:
//| 1 9
//| 1 100
//| 2 1
//| 5 0
struct point {
    i32 x;
    i32 y;
}

struct buf {
    i32[3] data;
}

fn void bump(mut point p) {
    p.x = 100;
}

fn point moved(point p) {
    return point{p.x + 1, p.y};
}

fn i32 main() {
    mut point a = {1, 2};
    point b = a;
    a.x = 9;
    println(b.x, " ", a.x);
    bump(b);
    mut point c = b;
    bump(c);
    c.x = 100;
    println(b.x, " ", c.x);
    point m = moved(b);
    println(m.x, " ", b.x);
    mut buf k = {{5, 6, 7}};
    buf j = k;
    k.data[0] = 0;
    println(j.data[0], " ", k.data[0]);
    return 0;
}
