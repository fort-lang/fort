//! run
//! stdout:
//| 1
//| 3
//| 5
//| 18446744073709551361
//| 18446744073709551361
//| 1
//| 18446744073709551361
//| 1
//| 1
//| 3
//| 1 3 struct
//| 1 3 array
//| 18446744073709551615 0 18446744073709551615 emptied
// The padding bytes of a global, of a module-level constant and of an emptied place, and the
// stores that write padding (D10.1, spec/fir.md 6). Each value is the word that holds the field
// `a` and the padding bytes 1 to 7 of a `holed`. Lines 1 to 3: the padding of a global, of an
// element of a global array and of a module-level constant holds 0 when the run starts. Line 4: a
// store into one field leaves the padding that `soil` wrote. Line 5: a literal with each field
// writes its members and leaves the padding of a named place. Line 6: the result of a call writes
// each byte. Line 7: the literal leaves the padding of a local too. Line 8: a copy of a place
// writes each byte. Lines 9 and 10: a member that is a literal goes in whole, and the padding
// after the field `t` holds its zero bytes. The lines `struct` and `array`: a member of a literal
// that a call gives carries zero padding. The line `emptied`: a `move` copies each byte of `keep`
// and leaves 0 in each byte of `keep`, padding included. This program stands at the default level,
// at `-Xcc -O0` and at `-Xcc -O2`: before the compiler wrote the zero bytes, line 6 was
// 18446744073709551361 in each build and line 8 at the default level and at `-Xcc -O2`.
struct holed {
    u8 a;
    u64 b;
}

struct raw {
    u64 x;
    u64 y;
}

struct outer {
    holed h;
    u8 t;
}

struct raw3 {
    u64 x;
    u64 y;
    u64 z;
}

struct owner {
    u8 tag;
    i32 mut* own p;
}

struct wide {
    u64 w;
    i32 mut* own p;
}

holed mut g = holed{1, 2};
holed[2] mut ga = holed[2]{holed{1, 2}, holed{3, 4}};
holed fixed = holed{5, 6};
owner mut keep = owner{0, null};

fn mk(u8 a, u64 b) holed {
    return holed{a, b};
}

fn soil(holed mut* p) void {
    raw mut* r = cast(p, raw mut*);
    r->x = 0xFFFFFFFFFFFFFFFF;
}

fn word(holed* p) u64 {
    raw* r = cast(p, raw*);
    return r->x;
}

fn stores() void {
    println(word(&g));
    println(word(&ga[1]));
    println(word(&fixed));
    soil(&g);
    g.a = 1;
    println(word(&g));
    g = holed{1, 2};
    println(word(&g));
    g = mk(1, 2);
    println(word(&g));
    holed mut l = holed{1, 2};
    soil(&l);
    l = holed{1, 2};
    println(word(&l));
    soil(&l);
    holed other = holed{1, 2};
    l = other;
    println(word(&l));
    outer mut o = outer{holed{1, 2}, 3};
    soil(&o.h);
    o = outer{holed{1, 2}, 3};
    println(word(&o.h));
    raw3* r3 = cast(&o, raw3*);
    println(r3->z);
}

fn members() void {
    outer o = outer{mk(1, 2), 3};
    raw3* r = cast(&o, raw3*);
    println(r->x, " ", r->z, " struct");
    holed[2] a = {holed{1, 2}, mk(3, 4)};
    println(word(&a[0]), " ", word(&a[1]), " array");
}

fn first_word(owner* o) u64 {
    wide* w = cast(o, wide*);
    return w->w;
}

fn soil_owner(owner mut* o) void {
    wide mut* w = cast(o, wide mut*);
    w->w = 0xFFFFFFFFFFFFFFFF;
}

fn emptied() void {
    keep = owner{2, new(i32)};
    soil_owner(&keep);
    print(first_word(&keep), " ");
    owner mut n = move(keep);
    print(first_word(&keep), " ");
    println(first_word(&n), " emptied");
    del(n.p);
}

fn main() i32 {
    stores();
    members();
    emptied();
    return 0;
}
