//! run
//! stdout:
//| 3 4
//| 8 7
//| 6 0
//| 2 12
//| 5 10
//| 30
// Field access and indexing on an rvalue struct or array are allowed and
// yield rvalues, copied through a temporary (D6.7). The rvalues are the
// literals of D6.5, a cast that only drops marks (D3.14) and a call result.
struct point {
    i32 x;
    i32 y;
}

struct line {
    point a;
    point b;
}

struct holder {
    i32 mut* cell;
}

fn mk(i32 x, i32 y) point {
    return point{x, y};
}

fn pair_of(i32 n) line {
    return line{point{n, n + 1}, point{n + 2, n + 3}};
}

fn main() i32 {
    // A struct literal and an array literal as the operand.
    println(point{3, 4}.x, " ", point{3, 4}.y);
    println(i32[3]{7, 8, 9, }[1], " ", i32[3]{7, 8, 9}[0]);
    // The designated form, whose omitted fields are zeroed (D6.5).
    // A trailing comma is allowed in a brace list (D6.5).
    println(point{.y = 6, }.y, " ", point{.y = 6}.x);
    // A field of a field, and a field of an element.
    println(line{point{1, 2}, point{11, 12}}.a.y, " ",
            point[2]{point{1, 2}, point{11, 12}}[1].y);
    // A call result read for one field, and a nested one.
    println(mk(5, 6).x, " ", pair_of(7).b.y);
    // A cast that only drops marks is an rvalue too, so its field is read out
    // of a temporary (D3.14, D5.4).
    i32 mut v = 30;
    holder h = {&v};
    println(*cast(h, holder).cell);
    return 0;
}
