//! run
//! stdout:
//| 1.5 -0.25 2
//| 3.0 -0.5
//| 1.5 -0.25
//| -0.0 0.0 true
// A struct holds floats like any other field: a literal initializer, a copy,
// a field assignment and a pointer to the whole value (D3.8, D9.9).
struct point {
    f64 x;
    f32 y;
    i32 tag;
}

fn double_it(point mut* p) void {
    p->x = p->x * 2.0;
    p->y = p->y * 2.0;
}

// A zero of each sign in a struct: the constant initializer of a module-level
// one is written field by field, so a negative zero may not be lost to a
// zeroinitializer (D6.12, item 5). run/globals/010 holds the array of them.
struct signs {
    f64 low;
    f32 high;
}

signs ZEROS = signs{-0.0, 0.0};

fn main() i32 {
    point mut a = point{1.5, -0.25, 2};
    println(a.x, " ", a.y, " ", a.tag);
    point copy = a;
    double_it(&a);
    println(a.x, " ", a.y);
    println(copy.x, " ", copy.y);
    println(ZEROS.low, " ", ZEROS.high, " ", ZEROS.low == cast(ZEROS.high, f64));
    return 0;
}
