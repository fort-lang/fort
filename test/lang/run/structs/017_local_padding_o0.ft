//! run
//! flags: -Xcc -O0
//! stdout:
//| 1
//| padding is zero
// Each byte of a local holds 0 when its declaration runs, padding included (D10.1). `dirty` and
// `peek` have frames of one shape, so the padding of `h` stands where `dirty` left bytes that are
// not 0. The view `raw*` reads byte 0 of `h`, which is the field `a`, and the padding bytes 1 to 7.
// This program stands at the default level, at `-Xcc -O0` and at `-Xcc -O2`: before the compiler
// wrote the zero bytes, `-Xcc -O0` printed 18446744073709551361 and the other builds printed 1.
struct holed { u8 a; u64 b; }
struct raw { u64 x; u64 y; }

fn dirty(u8 a, u64 b) u64 {
    raw h = raw{0xFFFFFFFFFFFFFFFF, b};
    raw* r = &h;
    return r->x + cast(a, u64);
}

fn peek(u8 a, u64 b) u64 {
    holed h = holed{a, b};
    raw* r = cast(&h, raw*);
    return r->x;
}

fn main() i32 {
    u64 d = dirty(0, 2);
    u64 x = peek(1, 2);
    println(x);
    if (x == 1) { println("padding is zero"); } else { println("padding is not zero"); }
    return cast(d & 0, i32);
}
