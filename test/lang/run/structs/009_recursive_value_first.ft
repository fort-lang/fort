//! run
//! stdout:
//| 16 24
//| 7 9 11 2
// The pair of 008_recursive_span_first.ft with the two struct declarations
// swapped: `node`, which holds a `vec` by value, stands before the `vec`
// whose span of pointers reaches it. Top-level declarations are
// order-independent within a module (D7.10), so this file must check, lay
// the two structs out the same way and print the same lines as 008.
struct node {
    vec kids;
    i32 tag;
}

struct vec {
    node mut* mut@ own items;
}

// The tags through the span. A print call can change an owner of left or right, which the span
// reaches, so the reads take a pointer, where the owners are no local owners (D17.21).
fn show(node* root) void {
    println(root->tag, " ", root->kids.items[0]->tag, " ", root->kids.items[1]->tag, " ",
            root->kids.items.len);
}

fn main() i32 {
    println(sizeof(vec), " ", sizeof(node));
    node mut root = {};
    node mut left = {};
    node mut right = {};
    root.tag = 7;
    left.tag = 9;
    right.tag = 11;
    root.kids.items = new(node mut*, 2);
    root.kids.items[0] = &left;
    root.kids.items[1] = &right;
    show(&root);
    del(root.kids.items);
    return 0;
}
