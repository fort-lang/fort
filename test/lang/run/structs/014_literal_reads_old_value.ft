//! run
//! stdout:
//| 0 9
//| 0 11
//| 4 3
//| 3 4
// An aggregate literal reads every member before the destination changes (D6.3), so a member
// that reads the destination reads the old value. A designated literal zeroes the destination
// after it reads its members, and a positional literal swaps. The direct path wrote the members
// one by one and printed `0 0`, `0 10`, `0 0` and `0 0` here (spec/fir.md 12.5, T-253 review
// round 3).
struct S {
    u8 a;
    i64 b;
}

struct P {
    i64 a;
    i64 b;
}

fn reads() void {
    S mut s = S{.a = 4, .b = 5};
    s = S{.b = s.b + cast(s.a, i64)};
    println(s.a, " ", s.b);
    P mut p = P{.a = 1, .b = 2};
    p = P{.b = p.a + 10};
    println(p.a, " ", p.b);
    p = P{.a = 3, .b = 4};
    p = P{.a = p.b, .b = p.a};
    println(p.a, " ", p.b);
    p = P{p.b, p.a};
    println(p.a, " ", p.b);
}

fn main() i32 {
    reads();
    return 0;
}
