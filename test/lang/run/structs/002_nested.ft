//! run
//! stdout:
//| 0 0 3 4
//| 1 2 0 9
//| 12
//| 9 0
struct point {
    i32 x;
    i32 y;
}

struct rect {
    point min;
    point max;
}

fn i32 area(rect r) {
    return (r.max.x - r.min.x) * (r.max.y - r.min.y);
}

fn i32 main() {
    rect a = rect{point{0, 0}, point{3, 4}};
    println(a.min.x, " ", a.min.y, " ", a.max.x, " ", a.max.y);
    rect b = {{1, 2}, {.y = 9}};
    println(b.min.x, " ", b.min.y, " ", b.max.x, " ", b.max.y);
    println(area(a));
    rect mut c = {};
    c.max = point{4, 3};
    c.min.x = 1;
    println(area(c), " ", c.min.y);
    return 0;
}
