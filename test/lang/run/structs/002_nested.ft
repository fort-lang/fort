//! run
//! stdout:
//| 0 0 3 4
//| 1 2 0 9
//| 12
//| 9 0
struct Point {
    i32 x;
    i32 y;
}

struct Rect {
    Point min;
    Point max;
}

fn i32 area(Rect r) {
    return (r.max.x - r.min.x) * (r.max.y - r.min.y);
}

fn i32 main() {
    Rect a = Rect{Point{0, 0}, Point{3, 4}};
    println(a.min.x, " ", a.min.y, " ", a.max.x, " ", a.max.y);
    Rect b = {{1, 2}, {.y = 9}};
    println(b.min.x, " ", b.min.y, " ", b.max.x, " ", b.max.y);
    println(area(a));
    mut Rect c = {};
    c.max = Point{4, 3};
    c.min.x = 1;
    println(area(c), " ", c.min.y);
    return 0;
}
