//! run
//! stdout:
//| 1 2
//| 0 5
//| 0 0
//| 3 4
//| 7 8
//| true 0 true
//| 30 15
struct Point {
    i32 x;
    i32 y;
}

struct Rec {
    string name;
    i32[] vals;
    Point* at;
}

fn i32 sum(Point p) {
    return p.x + p.y;
}

fn i32 main() {
    Point a = Point{1, 2};
    println(a.x, " ", a.y);
    Point b = Point{.y = 5};
    println(b.x, " ", b.y);
    Point c = Point{};
    println(c.x, " ", c.y);
    Point d = {3, 4};
    println(d.x, " ", d.y);
    Point e = {.y = 8, .x = 7,};
    println(e.x, " ", e.y);
    Rec r = {};
    println(r.name == "", " ", r.vals.len, " ", r.at == null);
    println(sum(Point{10, 20}), " ", sum(e));
    return 0;
}
