//! run
//! stdout:
//| 1 2
//| 0 5
//| 0 0
//| 3 4
//| 7 8
//| true 0 true
//| 30 15
struct point {
    i32 x;
    i32 y;
}

struct rec {
    string name;
    i32@ vals;
    point* at;
}

fn sum(point p) i32 {
    return p.x + p.y;
}

fn main() i32 {
    point a = point{1, 2};
    println(a.x, " ", a.y);
    point b = point{.y = 5};
    println(b.x, " ", b.y);
    point c = point{};
    println(c.x, " ", c.y);
    point d = {3, 4};
    println(d.x, " ", d.y);
    point e = {.y = 8, .x = 7,};
    println(e.x, " ", e.y);
    rec r = {};
    println(r.name == "", " ", r.vals.len, " ", r.at == null);
    println(sum(point{10, 20}), " ", sum(e));
    return 0;
}
