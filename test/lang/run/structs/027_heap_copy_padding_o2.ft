//! run
//! flags: -Xcc -O2
//! stdout:
//| 1 local
//| 1 call
//| 1 parameter
//| 1 temporary
//| 1 3 1 3 span
//| 1 1 1 loop
// A copy of a local aggregate to heap storage carries zero padding (D10.1, spec/fir.md 6). Each
// line reads the copy in the heap: the word that holds the field `a` and the padding bytes 1 to 7.
// `soil` first writes 255 into each of those bytes of the heap storage, so the 0 in the padding
// comes from the copy and not from `new`. The source is a named local, the result of a call, a
// parameter, a temporary, and a local of a loop body. This program stands at the default level,
// at `-Xcc -O0` and at `-Xcc -O2`: before the compiler wrote the zero bytes, each build printed
// 18446744073709551361 on a line.
struct holed {
    u8 a;
    u64 b;
}

struct raw {
    u64 x;
    u64 y;
}

fn mk(u8 a, u64 b) holed {
    return holed{a, b};
}

fn soil(holed mut* p) void {
    raw mut* r = cast(p, raw mut*);
    r->x = 0xFFFFFFFFFFFFFFFF;
}

fn word(holed* p) u64 {
    raw* r = cast(p, raw*);
    return r->x;
}

fn heap_of(holed v) holed mut* own {
    holed mut* own p = new(holed);
    soil(p);
    *p = v;
    return p;
}

fn local() void {
    holed h = holed{1, 2};
    holed mut* own p = new(holed);
    soil(p);
    *p = h;
    println(word(p), " local");
    soil(p);
    *p = mk(1, 2);
    println(word(p), " call");
    del(p);
}

fn parameter() void {
    holed h = holed{1, 2};
    holed mut* own q = heap_of(h);
    println(word(q), " parameter");
    del(q);
    holed mut* own t = heap_of(holed{1, 2});
    println(word(t), " temporary");
    del(t);
}

fn span() void {
    holed mut@ own s = new(holed, 4);
    for (u64 mut i = 0; i < s.len; i++) {
        soil(&s[i]);
    }
    holed h = holed{1, 2};
    holed[2] a = {holed{1, 2}, holed{3, 4}};
    s[0] = h;
    s[1] = mk(3, 4);
    s[2] = a[0];
    s[3] = a[1];
    print(word(&s[0]), " ", word(&s[1]), " ");
    println(word(&s[2]), " ", word(&s[3]), " span");
    del(s);
}

fn loop() void {
    holed mut* own p = new(holed);
    for (u64 mut i = 0; i < 3; i++) {
        holed mut h = holed{1, i};
        soil(p);
        *p = h;
        print(word(p), " ");
        soil(&h);
    }
    println("loop");
    del(p);
}

fn main() i32 {
    local();
    parameter();
    span();
    loop();
    return 0;
}
