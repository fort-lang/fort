//! run
//! stdout:
//| 1 5
//| 1 2 3
//| 6
struct Node {
    i32 value;
    mut Node* next;
}

fn i32 sum(Node* head) {
    mut i32 total = 0;
    Node* mut cur = head;
    while (cur != null) {
        total += cur->value;
        cur = cur->next;
    }
    return total;
}

fn i32 main() {
    mut Node m = {2, null};
    Node n = {1, &m};
    n.next->value = 5;
    println(n.value, " ", m.value);
    mut Node c = {3, null};
    mut Node b = {2, &c};
    mut Node a = {1, &b};
    mut Node* cur = &a;
    while (cur != null) {
        print(cur->value);
        if (cur->next != null) {
            print(" ");
        }
        cur = cur->next;
    }
    println();
    println(sum(&a));
    return 0;
}
