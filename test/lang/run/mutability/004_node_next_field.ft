//! run
//! stdout:
//| 1 5
//| 1 2 3
//| 6
struct node {
    i32 value;
    node mut* next;
}

fn i32 sum(node* head) {
    i32 mut total = 0;
    node* mut cur = head;
    while (cur != null) {
        total += cur->value;
        cur = cur->next;
    }
    return total;
}

fn i32 main() {
    node mut m = {2, null};
    node n = {1, &m};
    n.next->value = 5;
    println(n.value, " ", m.value);
    node mut c = {3, null};
    node mut b = {2, &c};
    node mut a = {1, &b};
    node mut* mut cur = &a;
    while (cur != null) {
        print(cur->value);
        if (cur->next != null) {
            print(" ");
        }
        cur = cur->next;
    }
    println();
    println(sum(&a));
    return 0;
}
