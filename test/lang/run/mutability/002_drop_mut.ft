//! run
//! stdout:
//| 5 5 7
//| 1 2 3
//| 3 3
fn i32 read_ptr(i32* p) {
    return *p;
}

fn i32 sum(i32@ s) {
    i32 mut total = 0;
    for (i32 v : s) {
        total += v;
    }
    return total;
}

fn i32 main() {
    i32 mut x = 5;
    i32 mut* mut mp = &x;
    i32* ip = mp;
    println(*ip, " ", read_ptr(mp), " ", read_ptr(&x) + 2);
    i32 mut@ own ms = new(i32, 2);
    ms[0] = 1;
    ms[1] = 2;
    i32@ view = ms;
    println(view[0], " ", view[1], " ", sum(ms));
    i32 mut* mut@ own mps = new(i32 mut*, 1);
    mps[0] = &x;
    i32*@ ips = mps;
    i32 mut* mut* mpp = &mp;
    i32** ipp = mpp;
    x = 3;
    println(**ipp, " ", *ips[0]);
    del(ms);
    del(mps);
    return 0;
}
