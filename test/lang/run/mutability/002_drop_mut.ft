//! run
//! stdout:
//| 5 5 7
//| 1 2 3
//| 3 3
fn i32 read_ptr(i32* p) {
    return *p;
}

fn i32 sum(i32[] s) {
    mut i32 total = 0;
    for (i32 v : s) {
        total += v;
    }
    return total;
}

fn i32 main() {
    mut i32 x = 5;
    mut i32* mp = &x;
    i32* ip = mp;
    println(*ip, " ", read_ptr(mp), " ", read_ptr(&x) + 2);
    mut i32[] ms = new(i32[2]);
    ms[0] = 1;
    ms[1] = 2;
    i32[] view = ms;
    println(view[0], " ", view[1], " ", sum(ms));
    mut i32*[] mps = new(i32*[1]);
    mps[0] = &x;
    i32*[] ips = mps;
    mut i32** mpp = &mp;
    i32** ipp = mpp;
    x = 3;
    println(**ipp, " ", *ips[0]);
    del(ms);
    del(mps);
    return 0;
}
