//! run
//! stdout:
//| 42
//| 2 1
//| 7 7 7
//| 11 20
struct point {
    i32 x;
    i32 y;
}

fn void set(mut i32* out, i32 v) {
    *out = v;
}

fn void swap(mut i32* a, mut i32* b) {
    i32 tmp = *a;
    *a = *b;
    *b = tmp;
}

fn void fill(mut i32[] s, i32 v) {
    for (mut u64 i = 0; i < s.len; i++) {
        s[i] = v;
    }
}

fn void bump(mut point* p) {
    p->x++;
    p->y += 10;
}

fn i32 main() {
    mut i32 x = 0;
    set(&x, 42);
    println(x);
    mut i32 a = 1;
    mut i32 b = 2;
    swap(&a, &b);
    println(a, " ", b);
    mut i32[3] arr = {};
    fill(arr[..], 7);
    println(arr[0], " ", arr[1], " ", arr[2]);
    mut point pt = {10, 10};
    bump(&pt);
    println(pt.x, " ", pt.y);
    return 0;
}
