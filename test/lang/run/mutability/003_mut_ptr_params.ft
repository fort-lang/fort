//! run
//! stdout:
//| 42
//| 2 1
//| 7 7 7
//| 11 20
struct point {
    i32 x;
    i32 y;
}

fn void set(i32 mut* out, i32 v) {
    *out = v;
}

fn void swap(i32 mut* a, i32 mut* b) {
    i32 tmp = *a;
    *a = *b;
    *b = tmp;
}

fn void fill(i32 mut@ s, i32 v) {
    for (u64 mut i = 0; i < s.len; i++) {
        s[i] = v;
    }
}

fn void bump(point mut* p) {
    p->x++;
    p->y += 10;
}

fn i32 main() {
    i32 mut x = 0;
    set(&x, 42);
    println(x);
    i32 mut a = 1;
    i32 mut b = 2;
    swap(&a, &b);
    println(a, " ", b);
    i32[3] mut arr = {};
    fill(arr[..], 7);
    println(arr[0], " ", arr[1], " ", arr[2]);
    point mut pt = {10, 10};
    bump(&pt);
    println(pt.x, " ", pt.y);
    return 0;
}
