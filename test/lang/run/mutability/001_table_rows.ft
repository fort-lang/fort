//! run
//! stdout:
//| 10 20 10 20
//| 1 2 100
//| 20 10 20
//| 9 hello bye 3 4
struct node {
    i32 value;
    mut node* next;
}

struct point {
    i32 x;
    i32 y;
}

fn i32 main() {
    mut node a = {1, null};
    mut node b = {2, null};
    node* p = &a;
    node* mut p2 = &a;
    p2 = &b;
    mut node* p3 = &a;
    p3->value = 10;
    p3 = &b;
    p3->value = 20;
    println(p->value, " ", p2->value, " ", a.value, " ", b.value);

    mut i32[3] arr = {1, 2, 3};
    i32[] s = arr[..];
    i32[] mut s2 = s;
    s2 = arr[1..];
    mut i32[] s3 = arr[..];
    s3[2] = 100;
    println(s[0], " ", s2[0], " ", arr[2]);

    node* mut[2] slots = {&a, &b};
    node* mut[] t = slots[..];
    t[0] = &b;
    t[1] = &a;
    node* mut q = &a;
    node* mut* pp = &q;
    *pp = &b;
    println(t[0]->value, " ", t[1]->value, " ", q->value);

    mut string str = "hello";
    string first = str;
    str = "bye";
    mut point pt = {1, 2};
    pt.x = 9;
    print(pt.x, " ");
    pt = point{3, 4};
    println(first, " ", str, " ", pt.x, " ", pt.y);
    return 0;
}
