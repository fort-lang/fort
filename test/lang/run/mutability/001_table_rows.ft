//! run
//! stdout:
//| 10 20 10 20
//| 1 2 100
//| 20 10 20
//| 13 13 2
//| 21 2 3
//| 9 hello bye 3 4
struct node {
    i32 value;
    node mut* next;
}

struct point {
    i32 x;
    i32 y;
}

fn main() i32 {
    node mut a = {1, null};
    node mut b = {2, null};
    node* p = &a;
    node* mut p2 = &a;
    p2 = &b;
    node mut* mut p3 = &a;
    p3->value = 10;
    p3 = &b;
    p3->value = 20;
    println(p->value, " ", p2->value, " ", a.value, " ", b.value);

    i32[3] mut arr = {1, 2, 3};
    i32@ s = arr[..];
    i32@ mut s2 = s;
    s2 = arr[1..];
    i32 mut@ s3 = arr[..];
    s3[2] = 100;
    println(s[0], " ", s2[0], " ", arr[2]);

    node*[2] mut slots = {&a, &b};
    node* mut@ t = slots[..];
    t[0] = &b;
    t[1] = &a;
    node* mut q = &a;
    node* mut* pp = &q;
    *pp = &b;
    println(t[0]->value, " ", t[1]->value, " ", q->value);

    node mut* fixed = &a;                     // writable target, fixed binding
    fixed->value = 11;
    node mut** ppf = &fixed;                  // *ppf: no, **ppf: yes
    (*ppf)->value = 12;
    node mut*[2] pins = {&a, &b};
    node mut*@ u = pins[..];                  // slots: no, pointees: yes
    u[0]->value = 13;
    println(a.value, " ", u[0]->value, " ", u.len);

    i32 mut@ mut s4 = arr[..];
    i32 mut@ mut* sp = &s4;
    (*sp)[0] = 21;                            // the elements, through the pointer
    *sp = arr[1..];                           // the header, through the pointer
    i32@ mut* sq = &s2;
    *sq = arr[..];                            // rebinds; the elements stay read-only
    println(arr[0], " ", s4[0], " ", s2.len);

    string mut str = "hello";
    string first = str;
    str = "bye";
    point mut pt = {1, 2};
    pt.x = 9;
    print(pt.x, " ");
    pt = point{3, 4};
    println(first, " ", str, " ", pt.x, " ", pt.y);
    return 0;
}
