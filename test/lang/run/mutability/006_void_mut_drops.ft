//! run
//! stdout:
//| 4 4
//| 7 7
//| true
// The storage a `void*` reaches is a level like any other, so the drop of
// D5.4 is monotone over it: `void mut* mut*` converts to `void**`, because
// level 1 of the target is immutable, and `void mut*` converts to `void*`.
fn i32 load(void* src) {
    i32* p = cast(src, i32*);
    return *p;
}

fn i32 main() {
    i32 mut x = 4;
    i32 mut y = 7;

    void mut* mut slot = cast(&x, void mut*);
    // Level 2 drops because level 1 is immutable in the target.
    void** pp = &slot;
    println(load(slot), " ", load(*pp));

    // The binding is mutable, so the same address holds the other variable
    // afterwards, and the view through pp follows it.
    slot = cast(&y, void mut*);
    println(load(slot), " ", load(*pp));

    // Both drops at once: an owned allocation lends as a plain view (D17.4).
    void mut* own block = cast(new(i32), void mut* own);
    void* view = block;
    println(load(view) == 0);
    del(block);
    return 0;
}
