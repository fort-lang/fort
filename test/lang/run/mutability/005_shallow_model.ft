//! run
//! stdout:
//| 5 9 10
//| 99 111 111
//| 7 5
//| 10 2 30
//| 4 21 21
//| 22 2 22
//| 120 3
// The shallow model of D5.9: immutability of a binding never reaches through
// a pointer or a span it holds, and the levels behind an indirection are
// fixed by the type rather than by the binding. D5.7 says which lvalues are
// assignable; every writable one below is reached from an immutable binding.
struct node {
    i32 value;
    node mut* next;
    i32 mut@ data;
}

struct box {
    i32 plain;
    i32[2] pair;
}

fn i32 main() {
    i32 mut target = 1;
    i32 mut other = 2;
    i32 mut@ own numbers = new(i32, 3);
    numbers[0] = 10;
    numbers[1] = 11;
    numbers[2] = 12;

    // `tail` is immutable and its field `next` cannot be reassigned through
    // it, but the node behind `next` is `node mut*`, so writing there is fine.
    node mut tail = node{9, null, numbers};
    node head = node{5, &tail, numbers};
    println(head.value, " ", head.next->value, " ", head.data[0]);
    head.next->value = 99;
    head.data[1] = 111;
    println(tail.value, " ", numbers[1], " ", head.data[1]);

    // A struct value's own fields follow the binding: `head` is immutable, so
    // `head.value` is not assignable, while `tail.value` is.
    tail.value = 7;
    println(tail.value, " ", head.value);

    // A fixed array and a struct share the storage of the value that holds
    // them (D5.2), so one `mut` on the binding reaches every field and slot.
    box mut b = box{1, {2, 3}};
    b.plain = 10;
    b.pair[1] = 30;
    println(b.plain, " ", b.pair[0], " ", b.pair[1]);

    // `&e` takes its level-1 bit from the mutability of `e` (D5.8): the
    // address of a mutable local is a `T mut*`, of an immutable one a `T*`.
    i32 fixed = 4;
    i32* readonly = &fixed;
    i32 mut* writable = &target;
    *writable = 21;
    println(*readonly, " ", *writable, " ", target);

    // An immutable pointer binding still writes through, and a mutable one
    // still rebinds; the two bits are independent (D5.3).
    i32 mut* through = &target;
    i32* mut rebind = &fixed;
    *through = 22;
    rebind = &other;
    println(target, " ", *rebind, " ", *through);

    // A span's header and its elements are two levels as well: `mut@ ` alone
    // gives writable elements over a fixed header.
    i32 mut@ elements = numbers;
    elements[2] = 120;
    println(numbers[2], " ", elements.len);

    del(numbers);
    return 0;
}
