//! fail
// A span refers to its elements as a pointer does, so an element type whose size
// does not fit an i64 index is an error at the declaration that writes it (D3.4).
// u8[2^63 - 1] fits exactly; u16[2^62] needs 2^63 bytes, one more than fits.
fn main() i32 {
    u64[4611686018427387904]@ s = {}; //! error: type is too large: u64[4611686018427387904]
    u8[9223372036854775807]@ fits = {};
    u16[4611686018427387904]@ over = {}; //! error: type is too large: u16[4611686018427387904]
    return 0;
}
