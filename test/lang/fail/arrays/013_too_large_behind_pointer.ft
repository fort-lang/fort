//! fail
// A type that a pointer reaches is a type too. Its size must fit an i64 index
// whatever refers to it, and the declaration that writes it reports it (D3.4).
// u64[2^62] needs 2^65 bytes; u64[2^60 - 1] needs 2^63 - 8 and fits.
u64[4611686018427387904]* GLOBAL = null; //! error: type is too large: u64[4611686018427387904]
u64[1152921504606846975]* FITS = null;

fn result() u64[4611686018427387904]* { //! error: type is too large: u64[4611686018427387904]
    return null;
}

fn main() i32 {
    u64[4611686018427387904]* p = null; //! error: type is too large: u64[4611686018427387904]
    (u64[4611686018427387904]*)[2] pair = {}; //! error: type is too large: u64[4611686018427387904]
    return 0;
}
