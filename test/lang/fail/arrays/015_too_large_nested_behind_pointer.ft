//! fail
// A nested array behind a pointer is checked whole: two u16[2^62] need 2^64
// bytes, and 2^60 structs of 24 bytes need 3 * 2^63 (D3.4). The message names
// the array that does not fit, not the pointer to it.
struct trio {
    u64 a;
    u64 b;
    u64 c;
}

fn main() i32 {
    u16[2][4611686018427387904]* n = null; //! error: type is too large: u16[2][4611686018427387904]
    trio[1152921504606846976]* t = null; //! error: type is too large: trio[1152921504606846976]
    return 0;
}
