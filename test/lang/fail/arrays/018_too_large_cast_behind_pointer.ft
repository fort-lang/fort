//! fail
// A cast target and the type of sizeof write their pointee too, and the
// expression that writes it reports it (D3.4).
fn main() i32 {
    u64[2] words = {};
    u64 first = (*cast(&words, u64[4611686018427387904]*))[0]; //! error: type is too large: u64[4611686018427387904]
    u64 size = sizeof(u64[4611686018427387904]*); //! error: type is too large: u64[4611686018427387904]
    return cast(first + size, i32);
}
