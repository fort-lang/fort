//! fail
// A nested array type is one type: the dimensions are part of it, the rank
// bounds how deep an index may go, and neither rank has a `.ptr` (D3.4, D3.6).
fn i32 main() {
    i32[2][3] mut a = {};
    i32[3][2] mut t = a; //! error: expects i32[3][2], not i32[2][3]
    i32[3] mut row = a; //! error: expects i32[3], not i32[2][3]
    i32 mut one = a[0]; //! error: expects i32, not i32[3]
    i32 mut deep = a[0][0][0]; //! error: i32 cannot be indexed
    i32 mut far = a[5][0]; //! error: index 5 out of range for i32[2][3]
    i32 mut inner = a[1][3]; //! error: index 3 out of range for i32[3]
    i32 mut@ mut view = a[0].ptr; //! error: a fixed array has no '.ptr'
    bool same = a == a; //! error: takes comparable operands, not i32[2][3]
    return one + deep + far + inner + view[0] + cast(same, i32) + t[0][0] + row[0];
}
