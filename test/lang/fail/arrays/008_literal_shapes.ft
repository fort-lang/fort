//! fail
// An array literal names every element: there is no partial initializer and
// no trailing fill, and `{}` is the only short form (D3.4, D7.4).
fn i32 main() {
    i32[4] short_form = {1, 2}; //! error: needs 4 elements
    i32[2] long_form = {1, 2, 3}; //! error: needs 2 elements
    i32[2] wrong_element = {"a", "b"}; //! error: expects i32
    return short_form[0] + long_form[0] + wrong_element[0];
}
