//! fail
// `sizeof` refuses a type that is too large behind a reference and in each part
// of a function type (D3.4). An array of a struct or an enum waits for the
// layout of its element, so a struct declared after its use and a struct that
// reaches itself through a pointer each have their size (D3.8, D7.10). `early`
// and `node` each take 16 bytes, so 2^59 of them need 2^63 bytes, one more than
// fits. An enum takes 4 bytes (D3.9), so 2^61 of them need 2^63 bytes. `late`
// takes 2 bytes. A constant, an array length and a nested `sizeof` each report
// once, at their own `sizeof`.
u64 EARLY = sizeof(early[576460752303423488]*); //! error: type is too large: early[576460752303423488]
struct early {
    u64 a;
    u64 b;
}
struct node {
    node* next;
    u64 value;
}
enum color { red, green }
u64 NODE = sizeof(node[576460752303423488]*); //! error: type is too large: node[576460752303423488]
u64 COLOR = sizeof(color[2305843009213693952]*); //! error: type is too large: color[2305843009213693952]
u64 PART = sizeof(fn(node[4611686018427387904]) void); //! error: type is too large: node[4611686018427387904]
u64 RESULT = sizeof(fn() u64[4611686018427387904]*); //! error: type is too large: u64[4611686018427387904]
// 2^60 values of 8 bytes need 2^63 bytes, one more than fits.
u64 EDGE = sizeof(fn(u64[1152921504606846976]) void); //! error: type is too large: u64[1152921504606846976]
u64 GROUP = sizeof((node)[2][4611686018427387904]@); //! error: type is too large: node[2][4611686018427387904]
u64 OUTER = sizeof((u8[4294967296])[4294967296]); //! error: type is too large: u8[4294967296][4294967296]
u64 NESTED = sizeof(node[sizeof(node[4611686018427387904]*)]*); //! error: type is too large: node[4611686018427387904]
u8[sizeof(late[4611686018427387904]*)] X = {}; //! error: type is too large: late[4611686018427387904]

fn main() i32 {
    u64 size = sizeof(late[4611686018427387904]*); //! error: type is too large: late[4611686018427387904]
    return cast(size, i32);
}

struct late {
    u16 a;
}
