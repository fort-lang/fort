//! fail
// A fixed array is an aggregate: it copies, but it has no equality and no
// order, and it has no `.ptr` (D3.4, D6.3).
fn main() i32 {
    i32[3] a = {1, 2, 3};
    i32[3] b = {1, 2, 3};
    bool same = a == b; //! error: comparable
    bool order = a < b; //! error: ordered
    i32* p = a.ptr; //! error: a fixed array has no '.ptr'
    return cast(same, i32) + cast(order, i32) + cast(p == null, i32);
}
