//! fail
// Every dimension of a nested array is a constant expression greater than 0,
// and the whole type must fit in an i64 index (D3.4, D4.6).
i32[4000000000][4000000000] BIG = {}; //! error: type is too large
i32[2][3] TABLE = {{1, 2, 3}, {4, 5, 6}};
// `.len` of a fixed array is constant and an index of one is not (D4.6).
i32[TABLE[0][0]] INDEXED = {}; //! error: an array length must be a constant expression

fn main() i32 {
    i32 n = 2;
    i32[0][3] mut none = {}; //! error: an array length must be greater than 0
    i32[2][0] mut inner = {}; //! error: an array length must be greater than 0
    i32[n][3] mut var = {}; //! error: an array length must be a constant expression
    i32[2][n] mut deep = {}; //! error: an array length must be a constant expression
    return none[0][0] + inner[0][0] + var[0][0] + deep[0][0] + BIG[0][0] + INDEXED[0];
}
