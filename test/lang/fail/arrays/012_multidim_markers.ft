//! fail
// The two markers a dimension never carries are refused on an inner dimension
// as on the outer one: the elements share the array's storage, so the `mut`
// goes after the last length (D5.3, D5.5), and an `own` marks a reference and
// never a dimension (D17.2). The parser decides both from the written form,
// which is why this file holds no type error: a syntax error stops the driver
// before the checker runs (D14.2).
fn main() i32 {
    i32[2] mut[3] mut marked = {}; //! error: write the mut after the length
    i32[2] own[3] mut owned = {}; //! error: an own never follows a fixed-array suffix
    return marked[0][0] + owned[0][0];
}
