//! fail
// A brace list for an array holds exactly one element per dimension or is
// empty, and that holds at each rank of a nested array (D6.5).
i32[2][3] SHORT = {{1, 2, 3}}; //! error: needs 2 elements, 1 given
i32[2][3] LONG = {{1, 2, 3}, {4, 5, 6}, {7, 8, 9}}; //! error: needs 2 elements, 3 given

fn main() i32 {
    i32[2][3] mut inner = {{1, 2}, {4, 5, 6}}; //! error: for i32[3] needs 3 elements, 2 given
    i32[2][3] mut deep = {1, 2}; //! error: the element expects i32[3], not a constant
    i32[2][3] mut typed = i32[2][3]{{1, 2, 3}}; //! error: needs 2 elements, 1 given
    return inner[0][0] + deep[0][0] + typed[0][0];
}
