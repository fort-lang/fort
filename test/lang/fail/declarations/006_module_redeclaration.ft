//! stderr: fail/declarations/006_module_redeclaration.ft:9:1: note: previous declaration
// Two declarations of one module have no dependency order between them, so
// the error stands at the later of the two by position and the note at the
// earlier. The two directives above pin both places; an error annotation
// pins the line alone and cannot see the two exchange places.
// D7.9, D14.2
fn twice(i32 n) i32 {
    return n * 2;
}

i32 twice = 2; //! error: 'twice'

fn main() i32 {
    return 0;
}
