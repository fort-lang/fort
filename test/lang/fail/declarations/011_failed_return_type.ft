//! fail
// A function whose return type failed has the error type (D14.2). A `return`
// operand still reports its own errors, but nothing that only the return type
// could settle: `null`, a void call and an owning temporary each stay silent.
fn nothing() void {
}

fn pointer() missing* { //! error: unknown type 'missing'
    return null;
}

fn value() missing { //! error: unknown type 'missing'
    return nothing();
}

fn owner() missing* own { //! error: unknown type 'missing'
    return new(i32);
}

fn operand() missing { //! error: unknown type 'missing'
    return unknown; //! error: unknown name 'unknown'
}

fn main() i32 {
    return 0;
}
