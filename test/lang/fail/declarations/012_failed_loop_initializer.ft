//! fail
// A declaration that fails in a `for` header reports once (D14.2). Recovery
// skips the whole header: a `{}` initializer closes no block, so its `;` stays
// inside the open `(` and the condition and the step are not statements. The
// first header spans three lines, so a cascade would stand on a line that no
// annotation names.
fn main() i32 {
    for (i32 mut[2] a = {}; //! error: the elements share the array's storage
         a[0] < 3;
         a[0]++) {
        println(a[0]);
    }
    for (i32 mut[2] b = {1, 2}; ; b = {3, 4}) { //! error: the elements share the array's storage
        println(b[0]);
    }
    return 0;
}
