//! fail
// An array length is a constant integer expression, so a float is an error
// there whatever its value (D3.4, D4.6).
f64[1.0] mut widths = {}; //! error: an array length must be an integer, not f64

fn i32 main() {
    i32[2.0] mut counts = {}; //! error: an array length must be an integer, not f64
    println(counts[0], " ", widths[0]);
    return 0;
}
