//! fail
// `bool` has exactly two values and nothing casts to it: not an integer, not
// a `char`, not a pointer (D3.3, D3.14).
fn main() i32 {
    char c = 'a';
    bool b = cast(c, bool); //! error: cannot cast
    i32 mut n = 0;
    bool d = cast(&n, bool); //! error: cannot cast
    bool e = cast(cast(1, u8), bool); //! error: cannot cast
    return cast(b, i32) + cast(d, i32) + cast(e, i32);
}
