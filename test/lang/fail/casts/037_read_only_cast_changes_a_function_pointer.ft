//! fail
// A read-only view keeps each function pointer place with its type (D3.14). A function pointer
// carries a mark always, because a call through it runs the function that the bits name. Each
// cast below compiled before. The place is a field, the storage of a function pointer, a place at
// level 2 and an element of an array. A call through each of the first three freed a local.
fn take(u64* own p) void {
    del(p);
}

struct owner_cb {
    fn (u64* own) void f;
}

struct view_cb {
    fn (u64*) void f;
}

struct oh {
    owner_cb* p;
}

struct vh {
    view_cb* p;
}

struct table {
    u64 n;
    (fn (u64* own) void)[2] slots;
}

struct view_table {
    u64 n;
    (fn (u64*) void)[2] slots;
}

fn main() i32 {
    u64 mut y = 7;
    owner_cb o = owner_cb{.f = take};
    view_cb* v = cast(&o, view_cb*); //! error: cannot cast owner_cb* to view_cb*: a cast adds the pointer fn (u64*) void at byte 0
    v->f(&y);
    fn (u64* own) void t = take;
    view_cb* w = cast(&t, view_cb*); //! error: cannot cast (fn (u64* own) void)* to view_cb*: a cast adds the pointer fn (u64*) void at byte 0
    w->f(&y);
    oh h = oh{.p = &o};
    vh* x = cast(&h, vh*); //! error: cannot cast oh* to vh*: a cast adds the pointer view_cb* at byte 0
    x->p->f(&y);
    table tb = table{.n = 2, .slots = {take, take}};
    view_table* vt = cast(&tb, view_table*); //! error: cannot cast table* to view_table*: a cast adds the pointer fn (u64*) void at byte 8
    return cast(vt->n, i32);
}
