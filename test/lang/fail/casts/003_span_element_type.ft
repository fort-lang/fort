//! fail
// The element type of a span never changes, because `len` counts elements
// (D3.14); only the mutability marks may differ.
fn main() i32 {
    i32 mut@ own xs = new(i32, 2);
    u8@ b = cast(xs, u8@); //! error: cannot cast
    i64@ w = cast(xs, i64@); //! error: cannot cast
    del(xs);
    return cast(b.len + w.len, i32);
}
