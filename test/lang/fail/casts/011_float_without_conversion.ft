//! fail
// The only implicit conversion is dropping mutability (D3.14): a float and an
// integer never convert to one another on their own, and neither do the two
// float types. Each one needs a cast.
fn widen(f32 x) f64 {
    return x; //! error: the return value expects f64, not f32
}

fn take(f64 x) void {
}

fn main() i32 {
    f64 a = 1.5;
    i32 b = a; //! error: the initializer expects i32, not f64
    f64 c = b; //! error: the initializer expects f64, not i32
    f32 d = a; //! error: the initializer expects f32, not f64
    take(d); //! error: expects f64, not f32
    println(widen(1.5), " ", c, " ", d);
    return 0;
}
