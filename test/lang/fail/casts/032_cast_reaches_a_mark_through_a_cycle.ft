//! fail
// A pointer place carries a mark when a type that it reaches does, through any chain of pointers,
// fields and elements, cycles included (D3.14). The walk keeps the mark on its path to it, and it
// walks again a struct that it left in a cycle that was still open: each cast below adds a pointer
// place whose pointee reaches a reference marked `mut` or `own`. Each place sits on a place that
// differs from it only by a `mut`, which a place with no mark may drop, so each cast walks the
// marks.
struct a {
    b* first;
}

struct b {
    a* back;
    u64 mut* m;
}

struct hb {
    b* p;
}

struct ha {
    a* p;
}

// A ring of three with an owner in the last one, reached through an array of pointers.
struct r0 {
    r1*[2] next;
}

struct r1 {
    r2* next;
}

struct r2 {
    r0* next;
    string own tag;
}

fn main() i32 {
    b mut* mut pb = null;
    hb* one = cast(&pb, hb*); //! error: cannot cast b mut* mut* to hb*: a cast adds the pointer b* at byte 0
    a mut* mut pa = null;
    ha* two = cast(&pa, ha*); //! error: cannot cast a mut* mut* to ha*: a cast adds the pointer a* at byte 0
    r0 mut* mut pr = null;
    r0** three = cast(&pr, r0**); //! error: cannot cast r0 mut* mut* to r0**: a cast adds the pointer r0* at byte 0
    r2 mut* mut pt = null;
    r1* four = cast(&pt, r1*); //! error: cannot cast r2 mut* mut* to r1*: a cast adds the pointer r2* at byte 0
    println(one == null, two == null, three == null, four == null);
    return 0;
}
