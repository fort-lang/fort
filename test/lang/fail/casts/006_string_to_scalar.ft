//! fail
// `string` casts only among the byte and character span forms (D3.14): it is
// a header, not a number and not a pointer.
fn i32 main() {
    string s = "hi";
    i32 n = cast(s, i32); //! error: cannot cast
    u64 bits = cast(s, u64); //! error: cannot cast
    char* p = cast(s, char*); //! error: cannot cast
    return n + cast(bits, i32) + cast(p == null, i32);
}
