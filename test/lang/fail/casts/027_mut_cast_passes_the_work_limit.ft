//! fail
// The check of a cast has a work limit (D3.14). Past it, it proves nothing, and the cast is an
// error with a note, as a store that D17.11 cannot prove empty is one ("Unknown is an error").
// Both sides hold the same 100003 * 100019 owners, but the elements of the two arrays meet at
// about 100003 offsets, so the check passes the limit before it proves the cast.
struct src_elem {
    u64* own[100003] a;
}

struct dst_elem {
    u64* own[100019] a;
}

fn view(src_elem[100019] mut* x) dst_elem[100003] mut* {
    return cast(x, dst_elem[100003] mut*); //! error: cannot cast src_elem[100019] mut* to dst_elem[100003] mut*: the check of a 'mut' cast passes its work limit of 65536 steps
}

// The same walk of a read-only view, which keeps each pointer place that carries a mark.
fn view_read(src_elem[100019]* x) dst_elem[100003]* {
    return cast(x, dst_elem[100003]*); //! error: cannot cast src_elem[100019]* to dst_elem[100003]*: the check of a cast passes its work limit of 65536 steps
}

fn main() i32 {
    return 0;
}
