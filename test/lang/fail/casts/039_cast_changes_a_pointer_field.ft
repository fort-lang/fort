//! fail
// A cast keeps a pointer field with its exact type (D3.14). `holder` holds a `wrapper*` at byte
// 0 and `holder2` a `u64 mut*`, so `*g->q = 1234` would write the owner slot of the `wrapper`.
// The `mut` view hides the `wrapper*`, and the read-only view adds the `u64 mut*`.
struct wrapper {
    u64* own x;
}

struct holder {
    wrapper* p;
}

struct holder2 {
    u64 mut* q;
}

fn main() i32 {
    wrapper mut w = wrapper{.x = new(u64)};
    holder mut h = holder{.p = &w};
    holder2 mut* g = cast(&h, holder2 mut*); //! error: cannot cast holder mut* to holder2 mut*: a 'mut' cast hides the pointer wrapper* at byte 0
    holder2* r = cast(&h, holder2*); //! error: cannot cast holder mut* to holder2*: a cast adds the pointer u64 mut* at byte 0
    del(w.x);
    return 0;
}
