//! fail
// The rule of D3.14 reads the layout of the source pointee and of the target
// pointee. A module-level initializer is the one place where a layout can still
// wait. D4.6 makes a `cast` a constant only among numeric types, `char` and
// enums, so such an initializer is an error anyway: while `later` has no
// layout the rule reads nothing, and the initializer reports. With both layouts
// known, the rule reports in place of the initializer. A struct in error has
// reported, and a cast to it reports nothing more.
struct holder {
    u64 count;
    u64* own data;
}

holder mut g = {};
later mut* early = cast(&g, later mut*); //! error: a module-level initializer must be a constant expression
void mut* known = cast(&g, void mut*); //! error: cannot cast holder mut* to void mut*: a 'mut' cast hides the pointer u64* own at byte 8

struct later {
    u64 a;
    u64 b;
}

struct endless { //! error: struct endless has infinite size
    endless again;
}

fn main() i32 {
    holder mut h = holder{.count = 1, .data = new(u64)};
    endless mut* one = cast(&h, endless mut*);
    endless[2] mut* two = cast(&h, endless[2] mut*);
    println(one == null, two == null);
    del(h.data);
    return 0;
}
