//! fail
// The walk of a cast that is an argument of an `extern fn` has the work limit of D3.14. Past it,
// the walk proves nothing, and the cast is an error with a note, as in fail/casts/027. Both sides
// hold the same function pointers. The elements of the two arrays meet at about 100003 offsets,
// so the walk passes the limit before it proves the cast.
struct src_elem {
    (fn () void)[100003] a;
}

struct dst_elem {
    (fn () void)[100019] a;
}

extern fn peek(dst_elem[100003]* p) void;

fn view_read(src_elem[100019]* x) void {
    peek(cast(x, dst_elem[100003]*)); //! error: cannot cast src_elem[100019]* to dst_elem[100003]*: the check of a cast passes its work limit of 65536 steps
}

fn main() i32 {
    return 0;
}
