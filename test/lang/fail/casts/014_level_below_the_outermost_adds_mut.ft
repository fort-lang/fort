//! fail
// A level below the outermost is a level like any other: the cast compares the
// two types at every depth and refuses the first level the target marks and the
// source does not (D3.14). The drop at such a level is what the cast is for,
// because the implicit conversion refuses it behind a mutable level (D5.4).
struct cell {
    i32 v;
}

fn main() i32 {
    cell mut a = cell{1};
    cell* mut slot = &a;
    cell* mut* pp = &slot;
    cell mut* mut* deep = cast(pp, cell mut* mut*); //! error: cannot cast cell* mut* to cell mut* mut*: a cast never adds 'mut'
    cell* mut@ slots = {};
    cell mut* mut@ thawed = cast(slots, cell mut* mut@); //! error: cannot cast cell* mut@ to cell mut* mut@: a cast never adds 'mut'
    // The other direction is the drop a caller of std.sort_ptr makes, and it
    // compiles: level 2 loses the mark while level 1 keeps it.
    cell mut* mut@ own writable = new(cell mut*, 1);
    cell* mut@ dropped = cast(writable, cell* mut@);
    println(deep == null, thawed.len, dropped.len);
    del(writable);
    return 0;
}
