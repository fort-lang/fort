//! fail
// A span: the pointee is one element, and each element holds the same owner
// places (D3.14). A cast to a `mut` span that drops the `own` of the elements is
// the cast form of what D17.4 refuses, and so is a cast that changes the mark
// of an owner that the span keeps writable.
struct node {
    i32 v;
}

// `new` makes no span of `string own` (D10.2), so a parameter gives one.
fn names_of(string own mut@ names) u64 {
    string mut@ plain = cast(names, string mut@); //! error: cannot cast string own mut@ to string mut@: a 'mut' cast hides the pointer string own at byte 0
    return plain.len;
}

fn main() i32 {
    node mut* own mut@ own kids = new(node mut* own, 2);
    node mut* mut@ esc = cast(kids, node mut* mut@); //! error: cannot cast node mut* own mut@ own to node mut* mut@: a 'mut' cast hides the pointer node mut* own at byte 0
    node* own mut@ frozen = cast(kids, node* own mut@); //! error: cannot cast node mut* own mut@ own to node* own mut@: a 'mut' cast hides the pointer node mut* own at byte 0
    println(esc.len, frozen.len);
    del(kids);
    return 0;
}
