//! fail
// A function pointer converts to `void*` only, and no cast brings it back
// (D3.14). A function pointer and a `u64` do not convert at all: no cast makes
// a pointer of any kind from an integer.
fn twice(i32 n) i32 {
    return n + n;
}

fn main() i32 {
    fn (i32) i32 f = twice;
    u64 bits = cast(f, u64); //! error: cannot cast
    fn (i32) i32 g = cast(cast(0, u64), fn (i32) i32); //! error: cannot cast u64 to fn (i32) i32: a cast never makes a pointer from an integer
    return cast(bits, i32) + g(1);
}
