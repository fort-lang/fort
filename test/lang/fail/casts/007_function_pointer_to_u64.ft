//! fail
// A function pointer converts to and from `void*` only; the integer round
// trip of D3.14 is a data-pointer rule, so the `u64` forms are errors.
fn i32 twice(i32 n) {
    return n + n;
}

fn i32 main() {
    fn i32(i32) f = twice;
    u64 bits = cast(f, u64); //! error: cannot cast
    fn i32(i32) g = cast(cast(0, u64), fn i32(i32)); //! error: cannot cast
    return cast(bits, i32) + g(1);
}
