//! fail
// The span rows of the cast matrix drop a mark and never add one (D3.14). A
// span's own level is its slots, and the `string` family is a span family, so
// the bytes of a `string` reach no writable spelling either.
fn i32 main() {
    i32[3] fixed = {1, 2, 3};
    i32@ ro = fixed[..];
    i32 mut@ rw = cast(ro, i32 mut@); //! error: cannot cast i32@ to i32 mut@: a cast never adds 'mut'
    string s = "ab";
    u8 mut@ bytes = cast(s, u8 mut@); //! error: cannot cast string to u8 mut@: a cast never adds 'mut'
    u8@ view = cast(s, u8@);
    char mut@ chars = cast(view, char mut@); //! error: cannot cast u8@ to char mut@: a cast never adds 'mut'
    // Adopting a span adds the `own` alone.
    i32 mut@ own owned = cast(ro, i32 mut@ own); //! error: cannot cast i32@ to i32 mut@ own: a cast never adds 'mut'
    println(rw.len, bytes.len, chars.len, owned.len);
    return 0;
}
