//! fail
// A source that names no level at all adds the mark as surely as an immutable
// one does: the `void` behind a `void*` and a function pointer both reach a
// target that marks a level (D3.14). The first line was the laundering route
// that the rule closed: a round trip through `void*` gave back a mark the
// source had dropped. Now no cast gives a type to a `void*`, and an address in
// a `u64` gives no pointer at all. Both rules come before the `mut`.
fn twice(i32 n) i32 {
    return n + n;
}

fn main() i32 {
    i32 mut v = 1;
    i32 mut* p = &v;
    void* anon = cast(p, void*);
    i32 mut* w = cast(anon, i32 mut*); //! error: cannot cast void* to i32 mut*: a cast never gives a type to a void*
    u64 bits = cast(p, u64);
    i32 mut* q = cast(bits, i32 mut*); //! error: cannot cast u64 to i32 mut*: a cast never makes a pointer from an integer
    fn (i32) i32 f = twice;
    void mut* fv = cast(f, void mut*); //! error: cannot cast fn (i32) i32 to void mut*: a cast never adds 'mut'
    // A `void` pointer that carries the mark gives no typed pointer back either.
    void mut* kept = cast(p, void mut*);
    i32 mut* back = cast(kept, i32 mut*); //! error: cannot cast void mut* to i32 mut*: a cast never gives a type to a void*
    println(*w, *q, fv == null, *back);
    return 0;
}
