//! fail
// A source that names no level at all adds the mark as surely as an immutable
// one does: an address in a `u64`, the `void` behind a `void*` and a function
// pointer all reach a target that marks a level (D3.14). The first two lines
// are the laundering route the rule closes: a round trip through `void*`
// cannot give back a mark the source had dropped.
fn i32 twice(i32 n) {
    return n + n;
}

fn i32 main() {
    i32 mut v = 1;
    i32 mut* p = &v;
    void* anon = cast(p, void*);
    i32 mut* w = cast(anon, i32 mut*); //! error: cannot cast void* to i32 mut*: a cast never adds 'mut'
    u64 bits = cast(p, u64);
    i32 mut* q = cast(bits, i32 mut*); //! error: cannot cast u64 to i32 mut*: a cast never adds 'mut'
    fn i32(i32) f = twice;
    void mut* fv = cast(f, void mut*); //! error: cannot cast fn i32(i32) to void mut*: a cast never adds 'mut'
    // The mark survives the same round trip when the `void` pointer carries it.
    void mut* kept = cast(p, void mut*);
    i32 mut* back = cast(kept, i32 mut*);
    println(*w, *q, fv == null, *back);
    return 0;
}
