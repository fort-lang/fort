//! fail
// An integer reaches no level, so the target of a cast from an integer holds no pointer place
// that carries a mark at level 1 (D3.14), as the target of a cast from a `void*` holds none.
struct wrap {
    u64* own p;
}

struct holder2 {
    u64 mut* q;
}

// A list whose first field reaches a `mut` pointer through its second.
struct link {
    link* next;
    holder2* side;
}

fn main() i32 {
    u64 mut x = 0;
    u64 bits = cast(&x, u64);
    wrap* w = cast(bits, wrap*); //! error: cannot cast u64 to wrap*: a cast adds the pointer u64* own at byte 0
    holder2* g = cast(bits, holder2*); //! error: cannot cast u64 to holder2*: a cast adds the pointer u64 mut* at byte 0
    link* l = cast(bits, link*); //! error: cannot cast u64 to link*: a cast adds the pointer link* at byte 0
    println(w == null, g == null, l == null);
    return 0;
}
