//! fail
// An integer reaches no level, so the target of a cast from an integer would add each pointer
// place that its pointee holds, a place that carries a mark too. No cast makes a pointer from an
// integer (D3.14), and that rule comes before each rule of the pointer places.
struct wrap {
    u64* own p;
}

struct holder2 {
    u64 mut* q;
}

// A list whose first field reaches a `mut` pointer through its second.
struct link {
    link* next;
    holder2* side;
}

fn main() i32 {
    u64 mut x = 0;
    u64 bits = cast(&x, u64);
    wrap* w = cast(bits, wrap*); //! error: cannot cast u64 to wrap*: a cast never makes a pointer from an integer
    holder2* g = cast(bits, holder2*); //! error: cannot cast u64 to holder2*: a cast never makes a pointer from an integer
    link* l = cast(bits, link*); //! error: cannot cast u64 to link*: a cast never makes a pointer from an integer
    println(w == null, g == null, l == null);
    return 0;
}
