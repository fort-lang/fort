//! fail
// The pointee is itself an owner: the slot of an `own` local (D3.14). A target
// that holds an owner of another type at byte 0 hides it too, and so does a
// cast that drops the `own` of the slot behind the `mut` level 1, which D17.4
// refuses without a cast.
import std.str;

fn main() i32 {
    u64* own mut o = new(u64);
    u64 mut* bits = cast(&o, u64 mut*); //! error: cannot cast u64* own mut* to u64 mut*: a 'mut' cast hides the pointer u64* own at byte 0
    void mut* any = cast(&o, void mut*); //! error: cannot cast u64* own mut* to void mut*: a 'mut' cast hides the pointer u64* own at byte 0
    u8* own mut* other = cast(&o, u8* own mut*); //! error: cannot cast u64* own mut* to u8* own mut*: a 'mut' cast hides the pointer u64* own at byte 0
    u64* mut* lent = cast(&o, u64* mut*); //! error: cannot cast u64* own mut* to u64* mut*: a 'mut' cast hides the pointer u64* own at byte 0
    string own mut s = str.dup("ab");
    u8@ mut* view = cast(&s, u8@ mut*); //! error: cannot cast string own mut* to u8@ mut*: a 'mut' cast hides the pointer string own at byte 0
    u8 mut@ own mut buf = new(u8, 4);
    u8 mut@ mut* raw = cast(&buf, u8 mut@ mut*); //! error: cannot cast u8 mut@ own mut* to u8 mut@ mut*: a 'mut' cast hides the pointer u8 mut@ own at byte 0
    println(*bits, any == null, other == null, lent == null, view == null, raw == null);
    del(o);
    del(s);
    del(buf);
    return 0;
}
