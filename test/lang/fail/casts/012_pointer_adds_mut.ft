//! fail
// A cast never adds `mut`, so a writable pointer comes from a writable source
// and from nowhere else. Every line below names a source that reaches the
// storage read-only and a target that would write it (D3.14). Dropping the
// mark is still a cast and still implicit, which the last two lines show.
struct cell {
    i32 v;
}

fn i32 main() {
    i32 v = 1;
    i32* p = &v;
    i32 mut* w = cast(p, i32 mut*); //! error: cannot cast i32* to i32 mut*: a cast never adds 'mut'
    cell c = cell{2};
    cell* q = &c;
    cell mut* r = cast(q, cell mut*); //! error: cannot cast cell* to cell mut*: a cast never adds 'mut'
    // Another pointee type does not change the answer: the level is the same.
    i32 mut* t = cast(q, i32 mut*); //! error: cannot cast cell* to i32 mut*: a cast never adds 'mut'
    // Adopting is a cast that adds `own`, and it adds no `mut` on the way.
    i32 mut* own a = cast(p, i32 mut* own); //! error: cannot cast i32* to i32 mut* own: a cast never adds 'mut'
    // The drop is the direction that works, at level 1 and through `void*`.
    i32 mut x = 3;
    i32* ro = cast(&x, i32*);
    void* anon = cast(&x, void*);
    println(*w, r->v, *t, *a, *ro, anon == null);
    return 0;
}
