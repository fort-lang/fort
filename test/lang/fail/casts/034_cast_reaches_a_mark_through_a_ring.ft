//! fail
// A ring of three structs, a -> b -> c -> a, whose mark is the second field of `a` (D3.14). The
// walk of the first cast enters `a`, `b` and `c`; `c` reaches `a`, which is still open, and `b`
// learns it from `c` when `c` ends, so `b` and `c` stay in the set of `a` and keep no answer of
// their own. Each later cast walks them again and finds the mark of `a`.
struct a {
    b* first;
    u64 mut* m;
}

struct b {
    c* next;
}

struct c {
    a* back;
}

struct ha {
    a* p;
}

struct hb {
    b* p;
}

struct hc {
    c* p;
}

fn main() i32 {
    u64 mut x = 0;
    ha* one = cast(&x, ha*); //! error: cannot cast u64 mut* to ha*: a cast adds the pointer a* at byte 0
    hb* two = cast(&x, hb*); //! error: cannot cast u64 mut* to hb*: a cast adds the pointer b* at byte 0
    hc* three = cast(&x, hc*); //! error: cannot cast u64 mut* to hc*: a cast adds the pointer c* at byte 0
    println(one == null, two == null, three == null);
    return 0;
}
