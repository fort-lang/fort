//! fail
// A ring of three structs, a -> b -> c -> a, whose mark is the second field of `a` (D3.14). Each
// place of a target sits on a place that differs from it only by a `mut`, which a place with no
// mark may drop and a place with a mark may not, so each cast walks the marks. The walk of the
// first cast enters `a`, `b` and `c`; `c` reaches `a`, which is still open, and `b` learns it from
// `c` when `c` ends, so `b` and `c` stay in the set of `a` and keep no answer of their own. Each
// later cast walks them again and finds the mark of `a`.
struct a {
    b* first;
    u64 mut* m;
}

struct b {
    c* next;
}

struct c {
    a* back;
}

struct ha {
    a* p;
}

struct hb {
    b* p;
}

struct hc {
    c* p;
}

fn main() i32 {
    a mut* mut pa = null;
    ha* one = cast(&pa, ha*); //! error: cannot cast a mut* mut* to ha*: a cast adds the pointer a* at byte 0
    b mut* mut pb = null;
    hb* two = cast(&pb, hb*); //! error: cannot cast b mut* mut* to hb*: a cast adds the pointer b* at byte 0
    c mut* mut pc = null;
    hc* three = cast(&pc, hc*); //! error: cannot cast c mut* mut* to hc*: a cast adds the pointer c* at byte 0
    println(one == null, two == null, three == null);
    return 0;
}
