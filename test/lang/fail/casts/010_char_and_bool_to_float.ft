//! fail
// `char`, `bool` and an enum reach no float type either: the conversion goes
// through an integer (D3.14).
enum color {
    red,
}

fn i32 main() {
    char c = 'a';
    bool b = true;
    color e = color.red;
    f64 x = cast(c, f64); //! error: cannot cast char to f64
    f32 y = cast(b, f32); //! error: cannot cast bool to f32
    f64 z = cast(e, f64); //! error: cannot cast color to f64
    return 0;
}
