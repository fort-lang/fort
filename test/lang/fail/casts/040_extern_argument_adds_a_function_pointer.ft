//! fail
// An argument of an `extern fn` follows the rule of a cast to a function pointer type (D3.14). C
// calls the function as the type of the parameter says. Here `qsort` would call `take` as a
// comparator, and `take` would free the address of an element of a local array. The cast of the
// data pointer beside it stays legal, because `words` holds no pointer place, and parentheses
// change nothing.

// qsort(3), which std.libc does not declare: no comparator of it reads an element (D3.14).
extern fn qsort(void mut* base, u64 n, u64 size, fn (void*, void*) i32 cmp) void;

fn take(u64* own p, void* q) i32 {
    del(p);
    return 0;
}

fn main() i32 {
    u64[2] mut words = {2, 1};
    void* code = cast(take, void*);
    qsort(cast(&words, void mut*), 2, sizeof(u64), cast(code, fn (void*, void*) i32)); //! error: cannot cast void* to fn (void*, void*) i32: a cast adds the function pointer fn (void*, void*) i32
    qsort(cast(&words, void mut*), 2, sizeof(u64), (cast(code, fn (void*, void*) i32))); //! error: cannot cast void* to fn (void*, void*) i32: a cast adds the function pointer fn (void*, void*) i32
    println(words[0]);
    return 0;
}
