//! fail
// The exemption of an argument of an `extern fn` covers a read-only cast that adds a pointer place
// with a mark too (D3.14), and nothing else: not a cast inside such an argument, not an argument
// of a fort function, and not an argument of a call through a function pointer. Parentheses keep
// the argument, and an extern call around the extern call keeps the inner argument exempt.
struct cell {
    u64* own p;
}

// C reads the cell and keeps no part of it.
extern fn peek_cell(cell* c) u64;

fn look(cell* c) u64 {
    return 0;
}

fn pass(u64 n) u64 {
    return n;
}

fn main() i32 {
    u64 mut x = 0;
    void* v = cast(&x, void*);
    u64 a = peek_cell((cast(v, cell*)));
    u64 b = pass(peek_cell(cast(v, cell*)));
    u64 c = peek_cell(cast(cast(v, cell*), cell*)); //! error: cannot cast void* to cell*: a cast adds the pointer u64* own at byte 0
    fn (cell*) u64 fp = look;
    u64 d = fp(cast(v, cell*)); //! error: cannot cast void* to cell*: a cast adds the pointer u64* own at byte 0
    u64 e = look(cast(v, cell*)); //! error: cannot cast void* to cell*: a cast adds the pointer u64* own at byte 0
    return cast(a + b + c + d + e, i32);
}
