//! fail
// Struct and array casts are forbidden (D3.14): a cast reinterprets a scalar
// or a reference, never an aggregate.
struct point {
    i32 x;
    i32 y;
}

struct pair {
    i32 a;
    i32 b;
}

fn main() i32 {
    point p = point{1, 2};
    pair q = cast(p, pair); //! error: cannot cast
    i32 n = cast(p, i32); //! error: cannot cast
    i32[2] arr = {1, 2};
    i64[2] wide = cast(arr, i64[2]); //! error: cannot cast
    return q.a + n + cast(wide[0], i32);
}
