//! fail
// No cast makes a pointer from an integer (D3.14). An integer derives from no address, so the
// pointer could reach any storage: for an `i32[2] pair`, `*cast(cast(&pair, u64) + 8, i32*)` read
// the local after `pair`. The rule takes each integer type and a constant, and each pointer-like
// target, a `void*` and a function pointer type included, with any marks. It comes before the
// `mut` and the `own` that the cast adds, and an argument of an `extern fn` gets no exemption. A
// `char`, a `bool`, an enum and a float give no pointer either. A pointer goes to a `u64`, and no
// cast takes the `u64` back.
enum color {
    red,
}

extern fn peek(void* p) u64;

fn main() i32 {
    i32[2] mut pair = {1, 2};
    i32 b = 7;
    u64 next = cast(&pair, u64) + 8;
    i32* p = cast(next, i32*); //! error: cannot cast u64 to i32*: a cast never makes a pointer from an integer
    void* v = cast(next, void*); //! error: cannot cast u64 to void*: a cast never makes a pointer from an integer
    fn () void f = cast(next, fn () void); //! error: cannot cast u64 to fn () void: a cast never makes a pointer from an integer
    i64 wide = cast(next, i64);
    i32* q = cast(wide, i32*); //! error: cannot cast i64 to i32*: a cast never makes a pointer from an integer
    u8 small = 8;
    u8* r = cast(small, u8*); //! error: cannot cast u8 to u8*: a cast never makes a pointer from an integer
    void* z = cast(0, void*); //! error: cannot cast i32 to void*: a cast never makes a pointer from an integer
    i32 mut* m = cast(next, i32 mut*); //! error: cannot cast u64 to i32 mut*: a cast never makes a pointer from an integer
    i32* own o = cast(next, i32* own); //! error: cannot cast u64 to i32* own: a cast never makes a pointer from an integer
    void mut* own w = cast(next, void mut* own); //! error: cannot cast u64 to void mut* own: a cast never makes a pointer from an integer
    u64 seen = peek(cast(next, void*)); //! error: cannot cast u64 to void*: a cast never makes a pointer from an integer
    char c = 'a';
    void* x1 = cast(c, void*); //! error: cannot cast char to void*
    bool t = true;
    void* x2 = cast(t, void*); //! error: cannot cast bool to void*
    color k = color.red;
    void* x3 = cast(k, void*); //! error: cannot cast color to void*
    f64 d = 1.0;
    void* x4 = cast(d, void*); //! error: cannot cast f64 to void*
    pair[0] = b;
    return 0;
}
