//! fail
// Where the chain of the target ends at a `mut` level -- at an integer, at a `void`, or at a fixed
// array on one side only -- the pointer of the source that leads to the next level is a pointer
// place that the target does not hold (D3.14). Without the rule,
// `*cast(&po, u64 mut*) = cast(&fake, u64); del(*po);` frees the address of a local.
fn main() i32 {
    u64 mut y = 7;
    u64* fake = &y;
    u64* own mut o = new(u64);
    u64* own mut* mut po = &o;
    u64 mut* bits = cast(&po, u64 mut*); //! error: cannot cast u64* own mut* mut* to u64 mut*: a 'mut' cast hides the pointer u64* own mut* at byte 0
    void mut* anon = cast(&po, void mut*); //! error: cannot cast u64* own mut* mut* to void mut*: a 'mut' cast hides the pointer u64* own mut* at byte 0
    u64* own mut*[1] mut arr = {&o};
    u64** mut* one_side = cast(&arr, u64** mut*); //! error: cannot cast u64* own mut*[1] mut* to u64** mut*: a 'mut' cast hides the pointer u64* own mut* at byte 0
    u64**[1] mut* other_side = cast(&po, u64**[1] mut*); //! error: cannot cast u64* own mut* mut* to u64**[1] mut*: a 'mut' cast hides the pointer u64* own mut* at byte 0
    // The target chain ends at level 2, behind a read-only level 1, and the source
    // holds a pointer place there.
    u64* own mut* mut* mut ppo = &po;
    u64 mut** deeper = cast(&ppo, u64 mut**); //! error: cannot cast u64* own mut* mut* mut* to u64 mut**: a 'mut' cast hides the pointer u64* own mut* at byte 0 of level 2
    // A result that can change no level reads the bits freely.
    u64* seen = cast(&po, u64*);
    println(*bits, anon == null, one_side == null, other_side == null, deeper == null, *seen, *fake);
    del(o);
    return 0;
}
