//! fail
// A `cast` that carries `own` from a span of owners to a span or a pointer of another element type
// is an error (D17.9): the elements could keep allocations that no drop reaches. Each such cast
// breaks a rule of D3.14 first: a span casts only to a span of the same element shape, and each
// pointer place that carries a mark keeps its exact type. A cast to a span of the same element
// type keeps the elements and their drop, so `del(s, d)` still frees them.
struct holder {
    i32 mut* own p;
}

struct twin {
    i32 mut* own q;
}

fn holder_drop(holder mut h) void {
    del(h.p);
}

fn main() i32 {
    holder mut@ own a = new(holder, 2);
    twin mut@ own b = cast(move(a), twin mut@ own); //! error: cannot cast holder mut@ own to twin mut@ own
    holder mut@ own c = new(holder, 2);
    u8 mut@ own d = cast(move(c), u8 mut@ own); //! error: cannot cast holder mut@ own to u8 mut@ own
    holder mut@ own e = new(holder, 2);
    void* own f = cast(move(e), void* own); //! error: cannot cast holder mut@ own to void* own
    i32 mut* own mut@ own g = new(i32 mut* own, 2);
    i32* own mut@ own h = cast(move(g), i32* own mut@ own); //! error: a 'mut' cast hides the pointer i32 mut* own at byte 0
    holder mut@ own k = new(holder, 2);
    holder@ own m = cast(move(k), holder@ own);
    del(m, holder_drop);
    return 0;
}
