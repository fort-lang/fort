//! fail
// A read-only view keeps each pointer place of its target, a place that carries no mark included
// (D3.14). A place with no mark needs a place of the source of the same type, or of a type that
// differs only by the `mut` and `own` marks that it drops. Through such a place a view reads
// storage whose address the program does not hold: for a `u64 bits` that holds the address of
// the local `b`, `**cast(&bits, i32**)` read `b`. Below, the source holds an integer, a pointer of
// another type, a `string` where the target holds a span, or an element of another type.
struct pair_words {
    u64 a;
    u64 b;
}

struct with_pointer {
    u64 a;
    i32* p;
}

struct named {
    string s;
}

struct bytes_view {
    u8@ s;
}

fn main() i32 {
    i32 b = 7;
    u64 bits = cast(&b, u64);
    i32** view = cast(&bits, i32**); //! error: cannot cast u64* to i32**: a cast adds the pointer i32* at byte 0
    pair_words words = pair_words{.a = 0, .b = cast(&b, u64)};
    with_pointer* w = cast(&words, with_pointer*); //! error: cannot cast pair_words* to with_pointer*: a cast adds the pointer i32* at byte 8
    i32* pb = &b;
    u64** other = cast(&pb, u64**); //! error: cannot cast i32** to u64**: a cast adds the pointer u64* at byte 0
    void** any = cast(&pb, void**); //! error: cannot cast i32** to void**: a cast adds the pointer void* at byte 0
    named n = named{.s = "ab"};
    bytes_view* bv = cast(&n, bytes_view*); //! error: cannot cast named* to bytes_view*: a cast adds the pointer u8@ at byte 0
    i32*[2] slots = {&b, &b};
    i64*[2]* changed = cast(&slots, i64*[2]*); //! error: cannot cast i32*[2]* to i64*[2]*: a cast adds the pointer i64* at byte 0
    println(**view, w == null, other == null, any == null, bv == null, changed == null);
    return 0;
}
