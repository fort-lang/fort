//! fail
// `b` reaches `a`, which is still open, through its first field, and itself through its second
// field (D3.14). Its own field must not raise what it learned from `a`. So `b` stays in the set
// of `a` and keeps no answer of its own, and the mark of `a` comes after `b`. The second cast
// walks `b` again and finds the mark of `a`. Each place of a target sits on a place that differs
// from it only by a `mut`, so each cast walks the marks.
struct a {
    b* first;
    u64 mut* m;
}

struct b {
    a* back;
    b* self;
}

struct ha {
    a* p;
}

struct hb {
    b* p;
}

fn main() i32 {
    a mut* mut pa = null;
    ha* one = cast(&pa, ha*); //! error: cannot cast a mut* mut* to ha*: a cast adds the pointer a* at byte 0
    b mut* mut pb = null;
    hb* two = cast(&pb, hb*); //! error: cannot cast b mut* mut* to hb*: a cast adds the pointer b* at byte 0
    println(one == null, two == null);
    return 0;
}
