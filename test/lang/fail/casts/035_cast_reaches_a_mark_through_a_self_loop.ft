//! fail
// `b` reaches `a`, which is still open, through its first field, and itself through its second
// field (D3.14). Its own field must not raise what it learned from `a`. So `b` stays in the set
// of `a` and keeps no answer of its own, and the mark of `a` comes after `b`. The second cast
// walks `b` again and finds the mark of `a`.
struct a {
    b* first;
    u64 mut* m;
}

struct b {
    a* back;
    b* self;
}

struct ha {
    a* p;
}

struct hb {
    b* p;
}

fn main() i32 {
    u64 mut x = 0;
    ha* one = cast(&x, ha*); //! error: cannot cast u64 mut* to ha*: a cast adds the pointer a* at byte 0
    hb* two = cast(&x, hb*); //! error: cannot cast u64 mut* to hb*: a cast adds the pointer b* at byte 0
    println(one == null, two == null);
    return 0;
}
