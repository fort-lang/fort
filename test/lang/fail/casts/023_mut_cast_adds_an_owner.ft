//! fail
// A level that the result can change must not hold an owner place that the source does not hold
// there (D3.14): the result could release bits that no owner wrote. A byte past the end of the
// source pointee holds no owner of the source. The memory of C has an owner only where its
// `extern` says `own` (D17.13).
struct wrap {
    u64* own p;
}

struct holder {
    u64 count;
    u64* own data;
}

// C keeps this storage and frees it itself. No cast gives a type to a `void*` (D3.14), so the
// result names the words that C keeps.
extern fn shared_words() u64 mut*;

fn main() i32 {
    u64 mut x = 1234;
    wrap mut* w = cast(&x, wrap mut*); //! error: cannot cast u64 mut* to wrap mut*: a 'mut' cast adds the pointer u64* own at byte 0
    // Two words give no owner at byte 8 either.
    u64[2] mut pair = {1, 2};
    holder mut* h = cast(&pair, holder mut*); //! error: cannot cast u64[2] mut* to holder mut*: a 'mut' cast adds the pointer u64* own at byte 8
    wrap mut* c = cast(shared_words(), wrap mut*); //! error: cannot cast u64 mut* to wrap mut*: a 'mut' cast adds the pointer u64* own at byte 0
    // The pointee of level 2 of the source is one byte, so byte 0 to 7 of the target are past its
    // end. At level 1 a larger pointee is the error of its size, which comes first.
    u8 mut b = 1;
    u8 mut* mut pb = &b;
    wrap mut** past = cast(&pb, wrap mut**); //! error: cannot cast u8 mut* mut* to wrap mut**: a 'mut' cast adds the pointer u64* own at byte 0 of level 2
    println(w == null, h == null, c == null, past == null);
    return 0;
}
