//! fail
// A float casts to a number and to nothing else: `bool`, `char` and an enum
// are reached through no row of D3.14.
enum color {
    red,
}

fn main() i32 {
    f64 a = 1.0;
    bool b = cast(a, bool); //! error: cannot cast f64 to bool
    char c = cast(a, char); //! error: cannot cast f64 to char
    color d = cast(a, color); //! error: cannot cast f64 to color
    return 0;
}
