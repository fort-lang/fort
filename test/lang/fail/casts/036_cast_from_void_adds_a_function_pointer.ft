//! fail
// A cast from a `void*` to a function pointer type adds a function pointer, because a `void*`
// reaches no type (D3.14). Each cast below compiled before, and each call wrote or jumped.
// `take` freed a local through a `fn (u64) void`, and a call jumped to the storage of a local.
// `poke` wrote an immutable local through its struct parameter. `make` wrote its struct result
// over an owner slot. A call is no read, so the same function type does not come back either.
struct pair {
    u64 a;
    u64 b;
}

struct wrap {
    u64* own p;
    u64 pad;
}

fn take(u64* own p) void {
    del(p);
}

fn poke(pair mut p) void {
    p.a = 99;
}

fn make() pair {
    return pair{.a = 4096, .b = 0};
}

fn main() i32 {
    u64 mut y = 7;
    fn (u64) void f = cast(cast(take, void*), fn (u64) void); //! error: cannot cast void* to fn (u64) void: a cast adds the function pointer fn (u64) void
    f(cast(&y, u64));
    void* bits = cast(&y, void*);
    fn () void jump = cast(bits, fn () void); //! error: cannot cast void* to fn () void: a cast adds the function pointer fn () void
    jump();
    pair q = pair{.a = 1, .b = 2};
    fn (u64) void g = cast(cast(poke, void*), fn (u64) void); //! error: cannot cast void* to fn (u64) void: a cast adds the function pointer fn (u64) void
    g(cast(&q, u64));
    wrap mut w = wrap{.p = new(u64), .pad = 0};
    fn (u64) void h = cast(cast(make, void*), fn (u64) void); //! error: cannot cast void* to fn (u64) void: a cast adds the function pointer fn (u64) void
    h(cast(&w, u64));
    del(w.p);
    fn (u64* own) void same = cast(cast(take, void*), fn (u64* own) void); //! error: cannot cast void* to fn (u64* own) void: a cast adds the function pointer fn (u64* own) void
    void mut* raw = cast(&y, void mut*);
    fn () void from_mut = cast(raw, fn () void); //! error: cannot cast void mut* to fn () void: a cast adds the function pointer fn () void
    return 0;
}
