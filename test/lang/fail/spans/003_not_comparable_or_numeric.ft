//! fail
// A span is a header, not a number and not a value with an order: it has no
// arithmetic and no equality (D6.2, D6.3).
fn main() i32 {
    i32 mut@ own xs = new(i32, 4);
    i32 mut@ own ys = new(i32, 4);
    bool same = xs == ys; //! error: comparable
    bool order = xs < ys; //! error: ordered
    i32@ shifted = xs + 1; //! error: numeric
    del(ys);
    del(xs);
    return cast(same, i32) + cast(order, i32) + cast(shifted.len, i32);
}
