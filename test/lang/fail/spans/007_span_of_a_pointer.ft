//! fail
// A span expression of a raw pointer is an error outside `str.from_cstr` and `rt.args_init`: a
// pointer holds no length, so the bounds of the span could reach past its object (D6.9, D10.4).
// For a `struct two { i32 x; i32 y; }`, `(&t.x)[0..2]` wrote `t.y`. Each form of a span expression
// is the error, for a `T*`, a `T mut*` and a `T mut* own`, and so is a span in a function of the
// same name as one of the two.
struct two {
    i32 x;
    i32 y;
}

fn from_cstr(char* p) string {
    return cast(p[0..1], string); //! error: cannot take a span of char*: a pointer has no length
}

fn args_init(i32 argc, char* mut* argv) void {
    char* mut@ v = argv[0..1]; //! error: cannot take a span of char* mut*: a pointer has no
}

fn main() i32 {
    two mut t = two{.x = 1, .y = 2};
    i32 mut* px = &t.x;
    i32 mut@ s = px[0..2]; //! error: cannot take a span of i32 mut*: a pointer has no length
    i32* q = &t.y;
    i32@ a = q[0..1]; //! error: cannot take a span of i32*: a pointer has no length
    i32@ b = q[0..]; //! error: cannot take a span of i32*: a pointer has no length
    i32@ c = q[..1]; //! error: cannot take a span of i32*: a pointer has no length
    i32@ d = q[..]; //! error: cannot take a span of i32*: a pointer has no length
    u8 mut* own heap = new(u8);
    u8 mut@ e = heap[0..1]; //! error: cannot take a span of u8 mut* own: a pointer has no length
    del(heap);
    // A span of a fixed array, of a span and of a string stays legal, with its check.
    i32[2] mut pair = {1, 2};
    i32 mut@ f = pair[0..2];
    i32@ g = f[1..];
    string h = "abc"[1..2];
    return 0;
}
