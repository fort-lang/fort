//! fail
// A span of arrays carries the row length in its type: two lengths are two
// types, a row of it is a value and not a reference, and a range of it is a
// view that owns nothing (D3.5, D3.6, D17.9).
fn take4(i32[4]@ rows) i32 {
    return rows[0][0];
}

fn main() i32 {
    i32 n = 2;
    i32[3] mut@ own g = new(i32[3], n);
    i32[4] mut@ mut wide = g[0..2]; //! error: expects i32[4] mut@, not i32[3] mut@
    i32 mut bad = take4(g); //! error: expects i32[4]@
    del(g[0]); //! error: 'del' takes a reference, not i32[3]
    i32[3] mut@ view = g[0..2];
    del(view); //! error: 'del' needs an owning operand, not i32[3] mut@
    for (i32[4] row : g) { //! error: the element type is i32[3], not i32[4]
        bad += row[0];
    }
    del(g);
    return bad + wide[0][0];
}
