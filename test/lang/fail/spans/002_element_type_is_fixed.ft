//! fail
// A span's element type is part of its type and no conversion reaches it: the
// implicit conversion of D5.4 changes mutability only, and `cast` refuses a
// change of element type because `len` counts elements (D3.5, D3.14).
fn main() i32 {
    i32 mut@ own xs = new(i32, 4);
    i64@ wide = xs; //! error: expects i64@
    u8@ bytes = xs; //! error: expects u8@
    del(xs);
    return cast(wide.len + bytes.len, i32);
}
