//! fail
// A span bound is an integer, and a span has exactly the pseudo-fields `len`
// and `ptr` (D3.5).
fn i32 main() {
    i32 mut@ own xs = new(i32, 4);
    i32@ bad = xs["one"..2]; //! error: span bound must be an integer
    u64 n = xs.length; //! error: no field 'length'
    u64 m = xs.size; //! error: no field 'size'
    del(xs);
    return cast(bad.len + n + m, i32);
}
