//! fail
// An array of spans holds one header per element: the element type is exact,
// an element of an array that owns nothing owns nothing either, and a span of
// spans is not a span of the element type (D3.5, D3.6, D5.4, D17.9).
fn i32 main() {
    i32[3] mut a = {1, 2, 3};
    i32 mut@[2] mut spans = {a[0..3], a[1..3]};
    del(spans[0]); //! error: 'del' needs an owning operand, not i32 mut@
    i32@[2] mut ro = {a[0..3], a[1..3]};
    i32 mut@ mut back = ro[0]; //! error: expects i32 mut@, not i32@
    i32 mut@ mut flat = spans[0..2]; //! error: expects i32 mut@, not i32 mut@ mut@
    i32 mut wrong = spans[0]; //! error: expects i32, not i32 mut@
    i32 mut deep = spans[0][0][0]; //! error: i32 cannot be indexed
    return back[0] + flat[0] + wrong + deep;
}
