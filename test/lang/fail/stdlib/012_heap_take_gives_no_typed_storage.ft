//! fail
import std.heap;

// `heap.take` gives a `void mut*`, and a cast never gives a type to a `void*` (D3.14). So a
// module with no `import extern;` can take storage from the allocator, but it cannot read or
// write it, and it cannot release it: `heap.drop` is a boundary function (D9.8). The storage
// then stays live for the whole run.
fn main() i32 {
    void mut* v = heap.take(64);
    i64 mut* q = cast(v, i64 mut*); //! error: a cast never gives a type to a void*
    u8 mut* b = cast(v, u8 mut*); //! error: a cast never gives a type to a void*
    *q = 3;
    *b = 3;
    return 0;
}
