//! fail
import extern;
import std.str;

// `str.from_cstr` takes no `.ptr` (D3.5): its strlen reads from the address up to a NUL, and the
// `.ptr` of an empty span names the byte after its object. A buffer that C wrote a C string into
// goes to `str.from_cbuf`, which reads only the bytes of the buffer. The address of an element
// goes to `from_cstr`, with the check of its index.
fn main() i32 {
    char mut@ own a = new(char, 24);
    string t = str.from_cstr(a[24..].ptr); //! error: '.ptr' can name the byte after the last
    string u = str.from_cstr(a.ptr); //! error: '.ptr' can name the byte after the last element
    string v = str.from_cbuf(cast(a[..], u8@));
    string w = str.from_cstr(&a[0]);
    del(a);
    return 0;
}
