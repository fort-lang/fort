//! fail
import std.str;
import std.strmap;

// A str_map key is a borrowed view and the map never owns one (D13.5,
// stdlib.md 2.8), so an owned copy made in the argument would be a temporary
// nothing can free: put takes string, not string own, and the conversion is
// the leak of D17.8. The caller keeps the copy in a variable of its own and
// lends it instead, which is what run/stdlib/049 does.
fn i32 main() {
    strmap.str_map mut m = strmap.create();
    strmap.put(&m, str.dup("key"), 1);   //! error: owning temporary would leak
    strmap.has(&m, str.concat("a", "b")); //! error: owning temporary would leak
    i64 mut out = 0;
    strmap.get(&m, str.dup("key"), &out); //! error: owning temporary would leak
    println(out);
    strmap.free(&m);
    return 0;
}
