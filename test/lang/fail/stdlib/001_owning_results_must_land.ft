//! fail
import std.str;

// The three allocating functions of std.str return own values (D13.5,
// stdlib.md 1.3), so their results must land: bound to an own place, passed to
// an own parameter, or deleted. Everything else is "owning temporary would
// leak" (D17.8), because nothing could ever del it.
fn length(string s) u64 {
    return s.len;
}

fn main() i32 {
    // Discarded as an expression statement.
    str.dup("abc");                                  //! error: owning temporary would leak
    str.concat("a", "b");                            //! error: owning temporary would leak
    str.to_cstr("path");                             //! error: owning temporary would leak

    // Converted to a plain string by the binding.
    string plain = str.dup("abc");                   //! error: owning temporary would leak
    println(plain.len);

    // Passed where a plain string is expected.
    println(length(str.concat("a", "b")));           //! error: owning temporary would leak

    // Cast to a non-own type, which is the same conversion spelled out.
    string view = cast(str.dup("abc"), string);      //! error: owning temporary would leak
    println(view.len);

    // A span, an index or a .ptr of an owning rvalue.
    println(str.to_cstr("path")[..2]);               //! error: owning temporary would leak
    println(str.to_cstr("path")[0]);                 //! error: owning temporary would leak
    println(str.to_cstr("path").ptr != null);        //! error: owning temporary would leak
    return 0;
}
