//! fail
import std.sort;

// The three typed entries of stdlib.md 2.10 take a T mut@, and that is the
// property they add over the core sort: a sort writes its elements, and the
// core entry takes a void mut*, which says that the bytes may be written and
// nothing about how many or how wide (D3.11). These are the diagnostics that
// make the difference real.
fn i32 main() {
    // An array declared without mut yields an immutable span (D5.2).
    i64[3] fixed = {3, 1, 2};
    sort.sort_i64(fixed[..], sort.cmp_i64);   //! error: the argument expects i64 mut@, not i64@

    // Dropping mutability on the way into a binding is implicit (D5.4), and
    // the sort cannot take it back.
    u64[3] mut us = {3, 1, 2};
    u64@ view_u = us[..];
    sort.sort_u64(view_u, sort.cmp_u64);      //! error: the argument expects u64 mut@, not u64@

    // The pointer entry is the same rule: the span's elements must be
    // writable, whatever the pointees are.
    void mut*[2] mut ps = {null, null};
    void mut*@ view_p = ps[..];
    sort.sort_ptr(view_p, sort.cmp_u64);   //! error: expects void mut* mut@, not void mut*@

    // The core entry takes the same three arrays through cast(.ptr, void mut*)
    // and compiles, which is why stdlib.md 2.10 tells a caller to prefer the
    // typed entries. There is no diagnostic to assert for it.
    return 0;
}
