//! fail
import std.sort;

// The typed entries of stdlib.md 2.10 take a T mut@: a sort writes its
// elements. These are the diagnostics that make the property real. The
// comparator is typed too, `fn (T*, T*) i32`, so a comparator of another
// element type, and one that reads a `void*`, are refused at the call: no cast
// gives a type to a `void*` (D3.14), so no comparator of `void*` can read an
// element.
fn by_bytes(void* a, void* b) i32 {
    return 0;
}

fn main() i32 {
    // An array declared without mut yields an immutable span (D5.2).
    i64[3] fixed = {3, 1, 2};
    sort.sort_i64(fixed[..], sort.cmp_i64);   //! error: the argument expects i64 mut@, not i64@

    // Dropping mutability on the way into a binding is implicit (D5.4), and
    // the sort cannot take it back.
    u64[3] mut us = {3, 1, 2};
    u64@ view_u = us[..];
    sort.sort_u64(view_u, sort.cmp_u64);      //! error: the argument expects u64 mut@, not u64@

    // The comparator names the element type of its entry.
    i64[3] mut xs = {3, 1, 2};
    sort.sort_i64(xs[..], sort.cmp_u64);      //! error: the argument expects fn (i64*, i64*) i32, not fn (u64*, u64*) i32
    sort.sort_i64(xs[..], by_bytes);          //! error: the argument expects fn (i64*, i64*) i32, not fn (void*, void*) i32
    return 0;
}
