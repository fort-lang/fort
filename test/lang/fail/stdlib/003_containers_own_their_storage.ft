//! fail
import std.strbuf;
import std.strmap;
import std.vec;

// Each container holds its storage in an own field, which makes it an owning
// aggregate (D17.7, stdlib.md 1.3): del of a whole container is an error, a
// copy from one variable into another needs move, and the accessors return
// views that del does not accept (D17.9). The allocating call of the family,
// strbuf.take, returns own and must land (D17.8).
fn i32 main() {
    strbuf.str_buf mut b = strbuf.create();
    strbuf.append(&b, "abc");
    del(b);                                       //! error: 'del' takes a reference, not str_buf
    strbuf.str_buf mut copy = b;                  //! error: requires 'move': write move(b)
    println(copy.len);

    // view and bytes are aliases of the storage, not allocations.
    del(strbuf.view(&b));                         //! error: needs an owning operand, not string
    del(strbuf.bytes(&b));                        //! error: needs an owning operand, not u8@

    // take allocates, so its result must land somewhere that can free it.
    strbuf.take(&b);                              //! error: owning temporary would leak
    string taken = strbuf.take(&b);               //! error: owning temporary would leak
    println(taken.len);
    strbuf.free(&b);

    vec.ptr_vec mut v = vec.ptr_create();
    del(v);                                       //! error: 'del' takes a reference, not ptr_vec
    vec.ptr_vec mut second = v;                   //! error: requires 'move': write move(v)
    println(second.len);
    vec.ptr_free(&v);

    strmap.str_map mut m = strmap.create();
    del(m);                                       //! error: 'del' takes a reference, not str_map
    strmap.str_map mut third = m;                 //! error: requires 'move': write move(m)
    println(third.live);
    strmap.free(&m);
    return 0;
}
