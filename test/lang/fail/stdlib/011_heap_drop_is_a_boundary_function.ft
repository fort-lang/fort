//! fail
import std.heap;
import std.rt;
import std.heap.drop; //! error: 'std.heap.drop' is a boundary function
import std.rt.free; //! error: 'std.rt.free' is a boundary function
import std.rt.release; //! error: 'std.rt.release' is a boundary function
import std.heap.is_start; //! error: 'std.heap.is_start' is a boundary function

// The 3 functions that release storage through a plain pointer, and the start test
// `heap.is_start`, are boundary functions: only a trusted module names one, in a call, as a
// function value and in a symbol import (D9.8). A
// module with no `import extern;` releases storage only with `del`, which takes an owner, so it
// cannot release an address that starts no live allocation without a forged owner (D10.9
// rule 4). `heap.take`, `heap.can_take` and `heap.live_bytes` take no pointer, so each module
// names them.
fn main() i32 {
    i64 mut* own a = new(i64);
    i64* v = a;
    string file = "x";
    heap.drop(cast(v, void*)); //! error: 'std.heap.drop' is a boundary function
    rt.free(cast(v, void*)); //! error: 'std.rt.free' is a boundary function
    rt.release(cast(v, void*), &file[0], 1, 1); //! error: 'std.rt.release' is a boundary function
    fn (void*) bool f = heap.drop; //! error: 'std.heap.drop' is a boundary function
    fn (void*) void g = rt.free; //! error: 'std.rt.free' is a boundary function
    fn (void*, char*, u32, u32) void h = rt.release; //! error: 'std.rt.release' is a boundary
    heap.is_start(cast(v, void*)); //! error: 'std.heap.is_start' is a boundary function
    fn (void*) bool s = heap.is_start; //! error: 'std.heap.is_start' is a boundary function
    u64 before = heap.live_bytes();
    bool room = heap.can_take(64);
    del(a);
    return cast(before, i32) + cast(room, i32);
}
