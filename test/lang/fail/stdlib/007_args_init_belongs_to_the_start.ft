//! fail
import std.rt;

// Only the `main` that the compiler emits calls `rt.args_init` (D6.9): it builds the span of the
// arguments from the `argc` and the `argv` that C gives to that `main`. Each name of it in source
// is an error, a call and a function value.
fn main() i32 {
    char*[1] mut raw = {};
    rt.args_init(0, &raw[0]); //! error: 'std.rt.args_init' belongs to the start of the program
    fn (i32, char* mut*) void start = rt.args_init; //! error: 'std.rt.args_init' belongs to the
    string@ args = rt.args();
    return cast(args.len, i32);
}
