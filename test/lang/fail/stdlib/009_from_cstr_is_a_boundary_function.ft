//! fail
import std.str;
import std.str.from_cstr; //! error: 'std.str.from_cstr' is a boundary function

// `str.from_cstr` takes a `char*`, so it is a boundary function: only a trusted module names it,
// in a call, as a function value and in a symbol import (D9.8). Another module reads a C string in
// a buffer with `str.from_cbuf`, which reads only the bytes of the buffer.
fn main() i32 {
    char[2] buf = {};
    string s = str.from_cstr(&buf[0]); //! error: 'std.str.from_cstr' is a boundary function
    fn (char*) string f = str.from_cstr; //! error: 'std.str.from_cstr' is a boundary function
    string t = str.from_cbuf(cast(buf[..], u8@));
    return cast(s.len + t.len, i32);
}
