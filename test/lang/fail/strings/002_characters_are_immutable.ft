//! fail
// `string` has a single storage level and its characters are never mutable
// (D5.2, D5.7), so no spelling of the type makes `s[i]` assignable.
fn main() i32 {
    string mut s = "hello";
    s[0] = 'H'; //! error: cannot assign to immutable
    char mut* p = &s[1]; //! error: mut
    s = "world";
    return cast(s.len, i32) + cast(p == null, i32);
}
