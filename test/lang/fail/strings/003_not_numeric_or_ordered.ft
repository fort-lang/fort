//! fail
// `string` supports `==` and `!=` only: there is no concatenation operator and
// no ordering (D3.7, D6.3); `str.cmp` in the standard library is the order.
fn main() i32 {
    string a = "ab";
    string b = "cd";
    string joined = a + b; //! error: numeric
    bool order = a < b; //! error: ordered
    bool ge = a >= b; //! error: ordered
    // The line under the header line of the next error quotes a string that spells
    // a diagnostic of its own. The harness reads header lines only, so the quote is
    // not a second, unannotated error.
    string quoted = "x.ft:1:1: error: y" + b; //! error: numeric
    return cast(joined.len, i32) + cast(order, i32) + cast(ge, i32);
}
