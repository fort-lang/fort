//! fail
// `void*` is an opaque pointer with no pointee type: no `*`, `->`, indexing
// or span expression (D3.11).
struct point {
    i32 x;
    i32 y;
}

fn i32 main() {
    point mut p = {1, 2};
    void* v = cast(&p, void*);
    i32 a = *v; //! error: dereference
    i32 b = v->x; //! error: '->' needs a pointer
    i32 c = v[0]; //! error: indexed
    i32@ s = v[0..1]; //! error: span of void*
    i32* q = v; //! error: not void*
    return a + b + c + cast(s.len, i32) + *q;
}
