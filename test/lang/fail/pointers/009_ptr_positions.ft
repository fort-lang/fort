//! fail
import std.str;

// The `.ptr` of a span or a string stands only in the three positions of D3.5. The `.ptr` of an
// empty span names the byte after its object, and no check reads it, so each other use is an
// error: a binding, a result, an argument of a fort function, a dereference, a print, each cast
// (to a typed pointer, to `u64`, to a `void*`, a nested one and a grouped type), `?:`, and a `.ptr`
// that `->` reaches. `str.from_cstr` takes the `.ptr` itself and not a cast of it, and a function
// of the same name in another module takes none.
fn take(i32* p) i32 {
    return *p;
}

fn give(i32@ s) i32* {
    return s.ptr; //! error: '.ptr' can name the byte after the last element: write '&s[0]'
}

fn from_cstr(char* p) string {
    return "";
}

fn main() i32 {
    i32 mut@ own s = new(i32, 2);
    i32* p = s.ptr; //! error: '.ptr' can name the byte after the last element: write '&s[0]'
    i32 a = take(s.ptr); //! error: '.ptr' can name the byte after the last element
    i32 b = *s.ptr; //! error: '.ptr' can name the byte after the last element
    print(s.ptr); //! error: '.ptr' can name the byte after the last element
    i64* w = cast(s.ptr, i64*); //! error: '.ptr' can name the byte after the last element
    u64 x = cast(s.ptr, u64); //! error: '.ptr' can name the byte after the last element
    void* v = cast(s.ptr, void*); //! error: '.ptr' can name the byte after the last element
    void* y = cast(s.ptr, (void*)); //! error: '.ptr' can name the byte after the last element
    u64 z = cast(cast(s.ptr, u8*), u64); //! error: '.ptr' can name the byte after the last element
    i32* c = a > b ? s.ptr : null; //! error: '.ptr' can name the byte after the last element
    string t = "abc";
    char* tp = t.ptr; //! error: '.ptr' can name the byte after the last element
    i32 mut@* sp = &s;
    i32* via = sp->ptr; //! error: '.ptr' can name the byte after the last element
    string u = str.from_cstr(cast(t.ptr, char*)); //! error: '.ptr' can name the byte after
    string mine = from_cstr(t.ptr); //! error: '.ptr' can name the byte after the last element
    // The legal forms: the address of an element, and the `.ptr` of a span that a cast made.
    u64 first = cast(&s[0], u64);
    void* any = cast(&s[0], void*);
    bool same = s.ptr == s[0..1].ptr;
    string back = str.from_cstr(t.ptr);
    del(s);
    return a + b + cast(x + z, i32);
}
