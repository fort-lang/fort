//! fail
// `void` names no storage of its own: the only marker it takes is the `mut`
// of `void mut*`, which marks the storage that pointer reaches (D3.11, D5.3).
// A span of `void` names no storage at all. `void own`, `void own*` and
// `void mut[4]` never reach this check, because the parser refuses a
// misplaced `own` and a `mut` before an array length first (D5.3); the type
// builder refuses them too, which bootstrap0/test/types_build_test.c asserts.
fn main() i32 {
    void mut v = 1; //! error: 'void' is only a return type or the base of 'void*'
    void mut@ s = {}; //! error: 'void' is only a return type or the base of 'void*'
    return cast(s.len, i32);
}
