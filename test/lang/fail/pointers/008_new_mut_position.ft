//! fail
// The outermost position of the type inside `new(...)` is the storage `new`
// allocates, so `new` fills it and the program may not: D5.8 gives it the
// `mut`, and every type keeps one spelling (D10.2). A fixed array shares its
// storage with its elements, so the position a `[N]` follows carries no `mut`
// either, and D5.3 is the rule that refuses that one.
// run/pointers/013 writes the positions below the outermost, which do parse.
struct node {
    i32 value;
}

fn i32 main() {
    node mut* mut* own a = new(node* mut); //! error: remove the outermost 'mut'
    i32 mut@ own b = new(i32 mut, 4); //! error: remove the outermost 'mut'
    i32[4] mut* own c = new(i32[4] mut); //! error: remove the outermost 'mut'
    i32[4] mut* own d = new(i32 mut[4]); //! error: the elements share the array's storage
    del(d);
    del(c);
    del(b);
    del(a);
    return 0;
}
