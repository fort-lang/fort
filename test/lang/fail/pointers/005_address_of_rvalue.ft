//! fail
// `&e` requires an lvalue, and `.len` is never an lvalue (D6.7). `.ptr` stands only in the positions
// of D3.5, and the left side of an assignment is none of them.
struct point {
    i32 x;
    i32 y;
}

fn mk() point {
    return point{1, 2};
}

fn main() i32 {
    i32* a = &4; //! error: lvalue
    i32* b = &mk().x; //! error: lvalue
    string mut s = "hi";
    s.len = 3; //! error: lvalue
    s.ptr = null; //! error: '.ptr' can name the byte after the last element
    return *a + *b;
}
