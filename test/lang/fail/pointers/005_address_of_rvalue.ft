//! fail
// `&e` requires an lvalue, and `.len` and `.ptr` are never lvalues (D6.7).
struct point {
    i32 x;
    i32 y;
}

fn point mk() {
    return point{1, 2};
}

fn i32 main() {
    i32* a = &4; //! error: lvalue
    i32* b = &mk().x; //! error: lvalue
    string mut s = "hi";
    s.len = 3; //! error: lvalue
    s.ptr = null; //! error: lvalue
    return *a + *b;
}
