//! fail
// `null` has no type of its own and is usable only where a pointer, `void*`
// or function-pointer type is expected; a span or string compares `.len` or
// `.ptr` instead (D10.5).
fn i32 main() {
    println(null); //! error: null
    bool b = null == null; //! error: null
    string s = "a";
    bool c = s == null; //! error: null
    i32[2] xs = {1, 2};
    bool d = xs == null; //! error: comparable
    return cast(b, i32) + cast(c, i32) + cast(d, i32);
}
