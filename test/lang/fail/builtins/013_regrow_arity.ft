//! fail
// `regrow` takes the span and the count (D12.2).
fn main() i32 {
    i32 mut@ own s = new(i32, 2);
    i32 mut@ own t = regrow(move(s)); //! error: 'regrow' takes 2 arguments, 1 given
    del(t);
    i32 mut@ own u = new(i32, 2);
    i32 mut@ own v = regrow(move(u), 3, 4); //! error: 'regrow' takes 2 arguments, 3 given
    del(v);
    return 0;
}
