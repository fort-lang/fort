//! fail
// The count of `regrow` is an integer, as the count of `new` (D12.2, D10.2).
fn main() i32 {
    i32 mut@ own s = new(i32, 2);
    i32 mut@ own t = regrow(move(s), true); //! error: a count must be an integer, not bool
    del(t);
    i32 mut@ own u = new(i32, 2);
    i32 mut@ own v = regrow(move(u), 1.5); //! error: a count must be an integer, not f64
    del(v);
    return 0;
}
