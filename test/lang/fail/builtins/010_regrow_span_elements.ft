//! fail
// The zero span gives the result of `new(T, n)`, so `T` is a type that `new` accepts (D12.2,
// D10.2).
struct box {
    i32 mut@ own mut@ own rows;
}

fn main() i32 {
    box mut b = {};
    i32 mut@ own mut@ own t = regrow(move(b.rows), 4); //! error: 'regrow' makes no span of
    del(t);
    return 0;
}
