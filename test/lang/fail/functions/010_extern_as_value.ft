//! fail
// An `extern fn` in value position is an error: every extern is called
// through the variadic LLVM function type its declaration supplies, and an
// indirect call site has no callee to take that form from, so the
// vector-register count would go unset (D3.10, D9.8).
extern fn i32 abs(i32 n);

fn i32 main() {
    fn i32(i32) taken = abs; //! error: not a value
    void* address = cast(abs, void*); //! error: not a value
    println(address);
    return abs(-1);
}
