//! fail
// A body statement that opens with `(` reports the error of its type, as a
// module declaration does (D3.6). Its expression reading fails at an earlier
// token, so the declaration reading reports.
fn main() i32 {
    (i32 mut)[2] a = {}; //! error: the elements share the array's storage
    (i32* mut)[2] b = {}; //! error: the elements share the array's storage
    (i32, i32) c = 0; //! error: expected ')', found ','
    for ((i32 mut)[2] e = {};;) { } //! error: the elements share the array's storage
    i32[2] items = {1, 2};
    for ((i32 mut)[2] f : items) { } //! error: the elements share the array's storage
    (i32 d = 0; //! error: expected ')', found identifier 'd'
    return 0;
}
