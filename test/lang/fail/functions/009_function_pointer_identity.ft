//! fail
// A function name is already a value, so `&f` and `*f` are errors, and
// function-type identity is structural over the parameter types, the pointee
// mutability included, the return type and `noreturn` (D3.10). Only a
// function, a function-pointer-typed expression and a qualified name are
// callable (D6.11).
fn noreturn stop() {
    panic("never");
}

fn i32 reads(i32* p) {
    return *p;
}

fn i32 main() {
    fn i32(i32*) taken = &reads; //! error: '&' on a function
    fn i32(i32*) starred = *reads; //! error: cannot dereference
    fn void() returning = stop; //! error: fn noreturn()
    fn i32(i32 mut*) writing = reads; //! error: fn i32(i32 mut*)
    i32 n = 5;
    i32 called = n(1); //! error: cannot call a value of type i32
    return called;
}
