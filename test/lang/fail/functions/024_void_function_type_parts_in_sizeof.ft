//! fail
// `sizeof` checks each part of the function type it writes (D3.1, D3.10,
// D3.11). A parameter or a result that is `void` with a suffix, or a group of
// `void` with a suffix after it, is an error at that part. `void*`, `void mut*`
// and a bare group of `void` as the result are accepted. A function result has
// no `mut` binding. Each line has one error.
u64 A = sizeof(fn(void) void); //! error: 'void' is only a return type
u64 B = sizeof(fn(fn(void mut) void) void); //! error: 'void' is only a return type
u64 C = sizeof(fn() fn((void)) void); //! error: 'void' is only a return type
u64 D = sizeof(fn(void*) void) + sizeof(fn(void) void); //! error: 'void' is only a return type
u64 E = sizeof(fn(void[2]) void); //! error: 'void' is only a return type
u64 F = sizeof(fn(void@) void); //! error: 'void' is only a return type
u64 G = sizeof(fn((void)*) void); //! error: 'void' is only a return type
u64 H = sizeof(fn(((void))*) void); //! error: 'void' is only a return type
u64 I = sizeof(fn() void[2]); //! error: 'void' is only a return type
u64 J = sizeof(fn() (void)*); //! error: 'void' is only a return type
u64 K = sizeof(fn() ((void mut))*); //! error: 'void' is only a return type
u64 L = sizeof(fn() (void[2])); //! error: 'void' is only a return type
u64 M = sizeof(fn(i32, fn() void[2]) void); //! error: 'void' is only a return type
u64 N = sizeof(fn() (void)) + sizeof((fn(void) void)[2]); //! error: 'void' is only a return type
u64 O = sizeof(fn() void mut); //! error: a return type has no binding
u64 P = sizeof(fn(i32[2]) void mut); //! error: a return type has no binding
fn main() i32 {
    u64 q = sizeof(fn(void mut*) void) + sizeof(fn(i32, void) void); //! error: 'void' is only
    u64 r = sizeof(fn() void mut); //! error: a return type has no binding
    return cast(q + r, i32);
}
