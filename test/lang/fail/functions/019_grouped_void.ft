//! fail
// A group of a bare `void` is a complete return type and nothing else (D3.11).
// `void` needs its `*` inside the same group: `(void*)` is the opaque pointer
// and `(void)*` is an error, in each type position.
struct holder {
    (void)* field; //! error: 'void' is only a return type or the base of 'void*'
}
fn result() (void)* { return null; } //! error: 'void' is only a return type
fn parameter((void)* p) void { } //! error: 'void' is only a return type
fn marked() (void) mut { } //! error: a return type has no binding
fn done() (void) { }
fn main() i32 {
    (void)* a = null; //! error: 'void' is only a return type
    ((void))* b = null; //! error: 'void' is only a return type
    (void mut)* c = null; //! error: 'void' is only a return type
    u64 n = sizeof((void)*); //! error: 'void' is only a return type
    u64 m = sizeof((void)@); //! error: 'void' is only a return type
    u64 k = sizeof((void@)); //! error: 'void' is only a return type
    (void*) ok = null;
    done();
    return 0;
}
