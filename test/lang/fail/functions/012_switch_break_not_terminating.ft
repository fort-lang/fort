//! fail
// A `break` in a clause leaves the switch, and control then falls off the
// end of `f`. The switch is not a terminating statement (D8.4).
fn f(bool c, i32 k) i32 {
    switch (k) {
    case 1:
        if (c) {
            break;
        }
        return 1;
    default:
        return 2;
    }
} //! error: missing return

fn main() i32 {
    return f(true, 1);
}
