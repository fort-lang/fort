//! fail
// A body statement reads as a declaration when its type reading fails at a
// later token than its expression reading. The rule holds without a group: a
// local `node[4]*[2]` reports the suffix rule of D3.6, as a module
// declaration does, and so does a loop initializer. The type reading of
// `a*[x+]` fails at the `]` of its length, later than the expression reading
// fails at the `*`, so the error of the length stands.
struct node {
    i32 value;
}

fn main() i32 {
    node[4]*[2] t = {}; //! error: no array suffix follows a reference suffix
    for (node[4]*[2] u = {};;) { } //! error: no array suffix follows a reference suffix
    a*[x+] = 1; //! error: expected an expression, found ']'
    return 0;
}
