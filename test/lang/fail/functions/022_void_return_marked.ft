//! fail
// A `mut` on a bare `void` return type gets the message of `i32 mut` and
// `noreturn mut` there. A suffix on a group of `void` keeps the message about
// `void` (D3.11). Each line has one error.
fn marked() void mut { } //! error: a return type has no binding
fn group_marked() (void) mut { } //! error: a return type has no binding
fn marked_group() (void mut) { } //! error: a return type has no binding
fn pointer_group() (void mut)* { return null; } //! error: 'void' is only a return type
fn main() i32 {
    fn () void mut p = null; //! error: a return type has no binding
    (fn () (void) mut) q = null; //! error: a return type has no binding
    return 0;
}
