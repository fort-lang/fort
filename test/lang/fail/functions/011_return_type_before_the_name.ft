//! fail
//! stderr: fail/functions/011_return_type_before_the_name.ft:10:4: error: expected '(', found 'i32'
// The return type comes after the parameter list, so the old form -- the
// result between `fn` and the name -- parses nowhere: not a definition, not an
// `extern` and not a function type. Each line is refused by the parser, which
// reports where the `(` it expected is missing.
// D3.10, D8.1, D9.8
extern fn void abort(); //! error: expected an identifier, found 'void'

fn i32 twice(i32 n) { //! error: expected '(', found 'i32'
    return n +% n;
}

fn main() i32 {
    fn i32(i32) op = main; //! error: expected '(', found 'i32'
    return 0;
}
