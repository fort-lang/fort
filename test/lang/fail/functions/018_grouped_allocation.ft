//! fail
// Inside new(...) a group keeps each restriction of the allocated type (D10.2,
// D17.3). It hides no outermost `mut`, no owned string and no span suffix. An
// own follows only a `*`, at every group depth, so an own after `)` does not
// parse there.
fn main() i32 {
    i32 mut* own a = new((i32 mut)); //! error: new allocates writable storage
    i32 mut* own b = new(((i32) mut)); //! error: new allocates writable storage
    string mut* own c = new((string own)); //! error: inside new an own follows a '*'
    string mut* own d = new((string) own); //! error: inside new an own follows a '*'
    u8@ mut* own e = new((u8@)); //! error: a span suffix does not parse inside new
    u8@* mut* own f = new(((u8@)*)); //! error: a span suffix does not parse inside new
    i32* own mut* own g = new((i32*) own); //! error: inside new an own follows a '*'
    i32* own mut* own h = new(((i32*) own)); //! error: inside new an own follows a '*'
    i32* own* mut* own i = new(((i32*) own)*); //! error: inside new an own follows a '*'
    return 0;
}
