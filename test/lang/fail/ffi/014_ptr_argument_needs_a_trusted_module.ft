fn main() i32 {
    char mut@ own a = new(char, 24);
    char* x = keep(a[24..].ptr); //! error: a call of extern 'keep' needs a trusted module
    char mut* w = strchr(&a[0], 97); //! error: a call of extern 'strchr' needs a trusted module
    char mut* mut end = null;
    keep_out(a[24..].ptr, &end); //! error: a call of extern 'keep_out' needs a trusted module
    i32 t = keep_tail(1, a[24..].ptr, &end); //! error: a call of extern 'keep_tail' needs a
