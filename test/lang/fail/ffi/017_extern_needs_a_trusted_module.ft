// with `import extern;`, so its declaration is an error, and each call of it is one more.
extern fn labs(i64 v) i64; //! error: extern 'labs' needs a trusted module: add 'import extern;'

fn main() i32 {
    i64 v = labs(-3); //! error: a call of extern 'labs' needs a trusted module
    return cast(v, i32);
}
