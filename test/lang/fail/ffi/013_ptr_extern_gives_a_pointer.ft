//! fail
import extern;
// As an argument of an `extern fn`, a `.ptr` stands as it is, and only when the declaration can
// give fort code no pointer that does not say `own` (D3.5). The declaration gives its result, a
// pointer that a level marked `mut` of a parameter holds, and each argument of a callback. A
// function pointer that C gives is a pointer, and so is a `void*`. The C types do not matter: a
// sign variant of the argument (`as_signed`) and a narrower fixed array (`narrow`) can be the
// argument that C gives back. A result that says `own` is a new allocation, so it gives only the
// pointers that its storage holds. No cast takes a `.ptr`. The address of an element, `&s[0]`,
// stands in each of these positions.
extern fn keep(char* p) char*;
extern fn keep_mut(char mut* p) char*;
extern fn keep_void(u8* p) void*;
extern fn keep_back(char* s, fn (char*) void cb) void;
extern fn keep_out(char* s, char* mut* end) void;
extern fn keep_later(char* p) fn () char*;
extern fn keep_any(void* p) void*;
extern fn as_signed(u32* p) i32*;
extern fn narrow(u8[8]* p) u8[4]*;
extern fn keep_tail(i32 n, ...) i32;
extern fn fresh(char* p) char mut* own;
extern fn fresh_slot(char* p) char* mut* own;
extern fn count(char* p, u64 mut* n) i32;
extern fn fresh_void(char* p) void mut* own;

// A struct field that is named `ptr` is no `.ptr` of D3.5.
struct named {
    char* ptr;
}

fn seen(char* p) void {
}

fn main() i32 {
    string s = "abc";
    char mut@ own m = new(char, 4);
    u8@ b = cast(s, u8@);
    u32 mut@ own w = new(u32, 2);
    u8[8] mut@ own rows = new(u8[8], 2);
    char* a = keep(s.ptr); //! error: '.ptr' can name the byte after the last element
    char* c = keep_mut(m.ptr); //! error: '.ptr' can name the byte after the last element
    void* d = keep_void(b.ptr); //! error: '.ptr' can name the byte after the last element
    keep_back(s.ptr, seen); //! error: '.ptr' can name the byte after the last element
    char* mut end = null;
    keep_out(s.ptr, &end); //! error: '.ptr' can name the byte after the last element
    fn () char* g = keep_later(s.ptr); //! error: '.ptr' can name the byte after the last element
    void* j = keep_any(cast(s.ptr, void*)); //! error: '.ptr' can name the byte after the last
    i32* k = as_signed(w[2..].ptr); //! error: '.ptr' can name the byte after the last element
    u8[4]* h = narrow(rows[2..].ptr); //! error: '.ptr' can name the byte after the last element
    char* mut* own slot = fresh_slot(s.ptr); //! error: '.ptr' can name the byte after the
    // The variable tail has no parameter, so the type of each argument is the type that C reads:
    // a level marked `mut` that holds a pointer gives one, and each `.ptr` of the call is an error.
    i32 t = keep_tail(1, s.ptr, &end); //! error: '.ptr' can name the byte after the last element
    string* sp = &s;
    i32 t2 = keep_tail(1, sp->ptr, &end); //! error: '.ptr' can name the byte after the last
    named nm = named{.ptr = &s[0]};
    i32 t3 = keep_tail(1, nm.ptr, &end);
    // The legal forms: a result that says `own` and reaches no pointer, a level marked `mut` that
    // holds no pointer, a variable tail that gives none, and the address of an element.
    char mut* own e = fresh(s.ptr);
    void mut* own v = fresh_void(s.ptr);
    u64 mut n = 0;
    i32 r = count(s.ptr, &n);
    i32 u = keep_tail(1, s.ptr, m.ptr, &n);
    char* x = keep(&s[0]);
    keep_back(&s[0], seen);
    keep_out(&s[0], &end);
    del(e);
    del(v);
    del(slot);
    del(m);
    del(w);
    del(rows);
    return 0;
}
