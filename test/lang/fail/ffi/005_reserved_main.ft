//! fail
// The compiler emits `main(argc, argv)` in the entry module (D11.6, D9.7).
// An `extern` declaring the name is therefore not a second declaration of one
// C function but a signature nothing can check against the definition the
// compiler writes, and a mismatch would be a silent call through the wrong
// type.
extern fn main(i32 argc, char* mut* argv) i32; //! error: 'main' is reserved

fn other() i32 {
    return 0;
}
