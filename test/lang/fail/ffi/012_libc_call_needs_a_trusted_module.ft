//! fail
import std.libc;

// A module that is not trusted calls no extern of `std.libc` either (D9.8). It calls a function
// of std that takes a span or a string, as `io.write_all`, which brings the length of its bytes.
fn main() i32 {
    u8[1] newline = {10};
    i64 n = libc.write(1, &newline[0], newline.len); //! error: a call of extern 'write' needs a
    return cast(n, i32);
}
