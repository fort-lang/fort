//! fail
// C keeps no pointer to fort storage after a call returns (A7 of `ownership-design.md` 5.1). So a
// `.ptr` argument of an `extern fn` that gives no pointer stays legal even when another
// declaration gives one: `save` takes the `.ptr`, and `load` gives a pointer but takes none. A C
// function that keeps the argument of `save` and gives it back from `load` breaks A7, and D10.7
// names such C code as outside its guarantee. A declaration that keeps the argument and gives it
// back in the same call gives a pointer, so its `.ptr` argument is an error (D3.5).
extern fn save(char* s) void;
extern fn load() char*;
extern fn save_and_load(char* s) char*;

fn main() i32 {
    char mut@ own a = new(char, 24);
    save(a[24..].ptr);
    char* p = load();
    char* q = save_and_load(a[24..].ptr); //! error: '.ptr' can name the byte after the last
    del(a);
    return 0;
}
