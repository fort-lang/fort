//! fail
//! error-any: C variable tail cannot use type
// C variable tails need explicit casts for C default promotions.
// D9.8
extern fn helper_tail_mix(i32 fixed, ...) i64;

enum color { red }
struct pair { i32 n; }

fn main() i32 {
    i8 narrow = 1;
    u16 unsigned_narrow = 2;
    bool flag = true;
    char letter = 'A';
    f32 short_float = cast(1.0, f32);
    pair value = pair{1};
    helper_tail_mix(1, narrow); //! error: C variable tail cannot use type 'i8'
    helper_tail_mix(1, unsigned_narrow); //! error: C variable tail cannot use type 'u16'
    helper_tail_mix(1, flag); //! error: C variable tail cannot use type 'bool'
    helper_tail_mix(1, letter); //! error: C variable tail cannot use type 'char'
    helper_tail_mix(1, color.red); //! error: C variable tail cannot use type 'color'
    helper_tail_mix(1, short_float); //! error: C variable tail cannot use type 'f32'
    helper_tail_mix(1, value); //! error: C variable tail cannot use type 'pair'
    helper_tail_mix(1, new(i32)); //! error: owning temporary would leak
    helper_tail_mix(1, null); //! error: 'null' needs a pointer-typed context
    return 0;
}
