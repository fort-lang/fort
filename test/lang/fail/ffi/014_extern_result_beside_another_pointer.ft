//! fail
// Each parameter that can carry a pointer must point to the pointee of a typed pointer result
// (D17.13), because C can give back each of them (A7). A parameter that points to the pointee
// does not help when another parameter does not: `strncpy` gives back `dst`. So a `void*` with
// any marks, the variable tail and a function pointer beside it make a typed result an error, and
// an `own` result too: `own` says that C gives a new allocation, and the declaration cannot hold
// C to it. A pointer to another type makes the pointee larger, adds a pointer place, or gives the
// storage another type. A function pointer result needs its own type in each such parameter.
struct entry {
    i64 key;
}

extern fn strncpy(void mut* dst, i64* src, u64 n) i64*; //! error: extern 'strncpy': C gives 'i64*', but a parameter can carry a pointer of another type
extern fn widen(i32 mut* dst, i64* src, u64 n) i64*; //! error: extern 'widen': C gives 'i64*', but a parameter can carry a pointer of another type
extern fn slot(u64 mut* dst, u64** src, u64 n) u64**; //! error: extern 'slot': C gives 'u64**', but a parameter can carry a pointer of another type
extern fn owned(void* s, i32 c, u64 n) i64* own; //! error: extern 'owned': C gives 'i64* own', but a parameter can carry a pointer of another type
extern fn readdir(void mut* dir) entry* own; //! error: extern 'readdir': C gives 'entry* own', but a parameter can carry a pointer of another type
extern fn new_entry(char* name) entry* own; //! error: extern 'new_entry': C gives 'entry* own', but a parameter can carry a pointer of another type
extern fn tail(i64* p, ...) i64*; //! error: extern 'tail': C gives 'i64*', but a parameter can carry a pointer of another type
extern fn tail_own(i64* p, ...) i64* own; //! error: extern 'tail_own': C gives 'i64* own', but a parameter can carry a pointer of another type
extern fn bsearch(entry* key, entry* base, u64 n, u64 size, fn (entry*, entry*) i32 cmp) entry*; //! error: extern 'bsearch': C gives 'entry*', but a parameter can carry a pointer of another type
extern fn gmtime_r(i64* t, entry mut* out) entry mut*; //! error: extern 'gmtime_r': C gives 'entry mut*', but a parameter can carry a pointer of another type
extern fn fn_tail(i32 n, ...) fn () void; //! error: extern 'fn_tail': C gives 'fn () void', but a parameter can carry a pointer of another type
extern fn fn_data(fn () void f, u64* p) fn () void; //! error: extern 'fn_data': C gives 'fn () void', but a parameter can carry a pointer of another type

// A call of a declaration in error reports nothing more.
fn main() i32 {
    i32 mut x = 1;
    i64 zero = 0;
    i64* wide = strncpy(cast(&x, void mut*), &zero, 0);
    return 0;
}
