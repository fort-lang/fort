//! fail
// A typed pointer result of an `extern fn` points to the pointee of each parameter that can carry
// a pointer, or the extern has no such parameter (D17.13). C can give back each such argument
// (A7), so a result of another type gives the argument a type that fort code did not give it, as
// a cast from a `void*` to a typed pointer would (D3.14). A `void*` with any marks, a function
// pointer and the variable tail point to no type. The pointees compare by identity with the marks
// aside, and `char` and `u8` differ. The pointee of a parameter is the type that its level 1
// holds, not a deeper level and not the result of a function pointer parameter. A function pointer
// result needs its type in each such parameter, and a function pointer type that C gives follows
// the rule for its own result. At the result, the rule of the `mut` comes first, and this rule
// comes before the rules of the parameters. fail/ffi/014 holds a second pointer parameter of the
// pointee, an `own` result and the variable tail beside a parameter of the pointee.
extern fn memchr(void* s, i32 c, u64 n) i64*; //! error: extern 'memchr': C gives 'i64*', but a parameter can carry a pointer of another type
extern fn peek(void mut* p) u64*; //! error: extern 'peek': C gives 'u64*', but a parameter can carry a pointer of another type
extern fn widen(i32* p) i64*; //! error: extern 'widen': C gives 'i64*', but a parameter can carry a pointer of another type
extern fn as_slot(u64* p) u64**; //! error: extern 'as_slot': C gives 'u64**', but a parameter can carry a pointer of another type
extern fn bytes(u8* s, u64 n) char*; //! error: extern 'bytes': C gives 'char*', but a parameter can carry a pointer of another type
extern fn deref(char** s) char*; //! error: extern 'deref': C gives 'char*', but a parameter can carry a pointer of another type
extern fn slot_of(char* s) char* own*; //! error: extern 'slot_of': C gives 'char* own*', but a parameter can carry a pointer of another type
extern fn pick(i32 n, ...) u64*; //! error: extern 'pick': C gives 'u64*', but a parameter can carry a pointer of another type
extern fn later(i32 n, void* s) u64*; //! error: extern 'later': C gives 'u64*', but a parameter can carry a pointer of another type
extern fn call(fn () u64* g) u64*; //! error: extern 'call': C gives 'u64*', but a parameter can carry a pointer of another type
extern fn as_fn(void* p) fn (u64) void; //! error: extern 'as_fn': C gives 'fn (u64) void', but a parameter can carry a pointer of another type
extern fn swap_fn(fn (u64) void f) fn (u64*) void; //! error: extern 'swap_fn': C gives 'fn (u64*) void', but a parameter can carry a pointer of another type
extern fn get_memchr() fn (void*, i32, u64) i64*; //! error: extern 'get_memchr': C gives 'i64*', but a parameter can carry a pointer of another type
extern fn enroll(void* p, fn (fn (void*) i64*) void cb) void; //! error: extern 'enroll': C gives 'i64*', but a parameter can carry a pointer of another type
extern fn hand(void* p, (fn (void*) i64*) mut* out) void; //! error: extern 'hand': C gives 'i64*', but a parameter can carry a pointer of another type
extern fn first(char* s, u64 mut* mut* out) u64*; //! error: extern 'first': C gives 'u64*', but a parameter can carry a pointer of another type
extern fn find(char* s, i32 c) u8 mut*; //! error: extern 'find': C gives 'u8 mut*' with a 'mut' that no parameter of that type has
extern fn get(void* p) fn (char*) char mut*; //! error: extern 'get': C gives 'char mut*' with a 'mut' that no parameter of that type has

// A call of a declaration in error reports nothing more.
fn main() i32 {
    i32 x = 1;
    i64* wide = memchr(cast(&x, void*), 1, 4);
    return 0;
}
