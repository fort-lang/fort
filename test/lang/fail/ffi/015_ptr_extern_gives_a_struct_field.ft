//! fail
// An `extern fn` gives each pointer that a field of a struct holds, at any depth, where it gives
// the struct: through its result, through a level marked `mut` of a parameter, and through an
// argument of a callback. A fixed array of structs gives the pointers of each element. A struct
// that holds a level marked `mut` lets C write that level too. So a `.ptr` argument of each
// declaration below is an error (D3.5). A struct that holds only integers, or a struct with no
// level marked `mut` that C reads, gives no pointer, and a struct that reaches itself ends the
// walk.
struct holder {
    char* p;
}

struct outer {
    u64 n;
    holder[2] inner;
}

struct slot {
    char* mut* at;
}

struct counts {
    u64 seen;
    i32[4] last;
}

struct node {
    node* next;
    u64 value;
}

extern fn stash(char* s, holder mut* h) void;
extern fn boxit(char* s) holder*;
extern fn walk_holder(char* s, fn (holder*) void cb) void;
extern fn stash_deep(char* s, outer mut* o) void;
extern fn through(char* s, slot* w) void;
extern fn tally(char* s, counts mut* c) i32;
extern fn walk_nodes(char* s, node* first) i32;
extern fn copy_holder(char* s, holder* from, holder mut* to) void;

fn seen(holder* h) void {
}

fn main() i32 {
    char mut@ own a = new(char, 24);
    holder mut h = holder{};
    stash(a[24..].ptr, &h); //! error: '.ptr' can name the byte after the last element
    holder* b = boxit(a[24..].ptr); //! error: '.ptr' can name the byte after the last element
    walk_holder(a[24..].ptr, seen); //! error: '.ptr' can name the byte after the last element
    outer mut o = outer{};
    stash_deep(a[24..].ptr, &o); //! error: '.ptr' can name the byte after the last element
    char* mut target = null;
    slot w = slot{.at = &target};
    through(a[24..].ptr, &w); //! error: '.ptr' can name the byte after the last element
    // C reads `from` and writes `to`: the struct that C only reads gives no pointer, and the
    // same struct in a level marked `mut` gives one.
    holder from = holder{};
    copy_holder(a[24..].ptr, &from, &h); //! error: '.ptr' can name the byte after the last
    // The legal forms: a struct of integers that C writes, and a struct that reaches itself and
    // that C only reads.
    counts mut c = counts{};
    i32 r = tally(a[24..].ptr, &c);
    node last = node{};
    node first = node{.next = &last, .value = 1};
    i32 k = walk_nodes(a[24..].ptr, &first);
    del(a);
    return 0;
}
