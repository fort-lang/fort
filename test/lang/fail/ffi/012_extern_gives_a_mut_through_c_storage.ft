//! fail
// The rule of the pointers that C gives (D17.13) reads each `mut` level of a parameter, and a
// fixed array adds no level (D5.2). It stops at a struct: it reads no field of a struct that C
// writes, so `recvmsg` keeps its exact C type. A level that the parameter does not mark `mut`
// holds nothing that C stores, and a level that holds no pointer gives no pointer.
struct msghdr {
    void mut* name;
    u32 namelen;
}

extern fn recvmsg(i32 fd, msghdr mut* msg, i32 flags) i64;
extern fn peek(char mut** p) void;
extern fn count(i64 mut* n, char* s) void;
extern fn level_two(char* s, char* mut* * out) void;
extern fn level_two_mut(char* s, char mut* mut* mut* out) void; //! error: extern 'level_two_mut': C gives 'char mut* mut*' with a 'mut' that no parameter of that type has
extern fn arrays(char* s, char mut*[2][3] mut* out) void; //! error: extern 'arrays': C gives 'char mut*' with a 'mut' that no parameter of that type has

fn main() i32 {
    return 0;
}
