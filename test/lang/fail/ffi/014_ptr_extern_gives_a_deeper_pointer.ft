//! fail
import extern;
// An `extern fn` gives each pointer that a value of its result holds, at each level, and each
// pointer that an argument of a callback holds. It gives each pointer that it can write into a
// level marked `mut` of a parameter, at each level below that one too, through a fixed array too,
// and through a level that a callback gives back to C. So a `.ptr` argument of each declaration
// below is an error (D3.5). A level with no `mut` gives no pointer: C does not write it (A7 of
// `ownership-design.md` 5.1).
extern fn wrap(char* s) char**;
extern fn walk2(char* s, fn (char**) void cb) void;
extern fn put(char* s, char** mut* out) void;
extern fn put_deep(char* s, char* mut** out) void;
extern fn fresh_box(char* s) char** own;
extern fn read_only(char* s, char** in) i32;
extern fn fresh_text(char* s) char mut* own;
extern fn ask(char* s, fn () char* mut* cb) void;
extern fn fill(char* s, char* mut*[2]* slots) void;

char* mut SLOT = null;

fn slot_of() char* mut* {
    return &SLOT;
}

fn seen(char** pp) void {
}

fn main() i32 {
    char mut@ own a = new(char, 24);
    char** slot = wrap(a[24..].ptr); //! error: '.ptr' can name the byte after the last element
    walk2(a[24..].ptr, seen); //! error: '.ptr' can name the byte after the last element
    char** mut held = null;
    put(a[24..].ptr, &held); //! error: '.ptr' can name the byte after the last element
    char* mut inner = null;
    char* mut* deep = &inner;
    put_deep(a[24..].ptr, &deep); //! error: '.ptr' can name the byte after the last element
    char** own boxed = fresh_box(a[24..].ptr); //! error: '.ptr' can name the byte after the last
    ask(a[24..].ptr, slot_of); //! error: '.ptr' can name the byte after the last element
    char* mut left = null;
    char* mut right = null;
    char* mut*[2] pair = {&left, &right};
    fill(a[24..].ptr, &pair); //! error: '.ptr' can name the byte after the last element
    // C reads `*in` and writes no level of it, and the `own` result holds only characters.
    char* first = &a[0];
    i32 r = read_only(a[24..].ptr, &first);
    char mut* own text = fresh_text(a[24..].ptr);
    del(boxed);
    del(text);
    del(a);
    return 0;
}
