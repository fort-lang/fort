//! fail
// The arity is part of the agreement: `fort_rt_flush(int32_t fd)` takes one
// parameter, and the extra argument of a call written against this
// declaration would be passed to a function that never reads it (D9.8,
// toolchain.md 5.1).
extern fn void fort_rt_flush(i32 fd, i32 extra); //! error: the number of parameters differs

fn i32 main() {
    fort_rt_flush(1, 2);
    return 0;
}
