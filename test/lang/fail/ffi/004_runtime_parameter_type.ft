//! fail
// An `extern fn` naming a runtime entry point must agree with the signature
// toolchain.md 5.1 fixes for it (D9.8): the compiler replaces the declaration
// with its own canonical one (toolchain.md 6 item 8), so a mismatch reaches
// no tool below the compiler -- `fort_rt_del` takes a pointer, the call would
// pass an `i32`, and the program dies reading it as one.
extern fn void fort_rt_del(i32 wrong); //! error: conflicting declarations of extern 'fort_rt_del'

fn i32 main() {
    fort_rt_del(5);
    return 0;
}
