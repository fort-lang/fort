//! fail
//! error-any: C variable tail cannot use type
// A callback tail needs an extern-legal signature at each nested level.
// D9.8, D9.9
extern fn helper_tail_nested_callback(i32 fixed, ...) i32;

struct pair { i32 n; }

fn bad_param(pair value) i32 {
    return value.n;
}

fn bad_result(i32 n) pair {
    return pair{n};
}

fn main() i32 {
    fn (fn (pair) i32) i32 nested = null;
    helper_tail_nested_callback(1, bad_param); //! error: C variable tail cannot use type
    helper_tail_nested_callback(1, bad_result); //! error: C variable tail cannot use type
    helper_tail_nested_callback(1, nested); //! error: C variable tail cannot use type
    return 0;
}
