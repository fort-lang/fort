//! fail
// An `extern fn` declaration names the pointer types that C gives to fort code: the result, each
// parameter type of a function pointer parameter, and each pointer type that a level of a
// parameter holds where the parameter marks that level `mut` (D17.13). Such a type marks a level
// `mut` only where it says `own`, where a fixed parameter of the same type has the mark, or where
// no parameter can carry a pointer. C can give back an argument, so each declaration below lets
// fort code write storage that it lent read-only. A pointer, a `void*`, a function pointer and the
// variable tail can each carry a pointer. A function pointer type that C gives follows the same
// rule, because a call through it runs C. The error stands at the result or at the parameter that
// names the type, and it names the first such type: the result, and then the parameters in order.
extern fn strchr(char* s, i32 c) char mut*; //! error: extern 'strchr': C gives 'char mut*' with a 'mut' that no parameter of that type has
extern fn pick(i32 n, ...) u64 mut*; //! error: extern 'pick': C gives 'u64 mut*' with a 'mut' that no parameter of that type has
extern fn call(fn () u64* g) u64 mut*; //! error: extern 'call': C gives 'u64 mut*' with a 'mut' that no parameter of that type has
extern fn apply(u64* p, fn (u64 mut*) void cb) void; //! error: extern 'apply': C gives 'u64 mut*' with a 'mut' that no parameter of that type has
extern fn get_strchr() fn (char*, i32) char mut*; //! error: extern 'get_strchr': C gives 'char mut*' with a 'mut' that no parameter of that type has
extern fn strtol(char* nptr, char mut* mut* endptr, i32 base) i64; //! error: extern 'strtol': C gives 'char mut*' with a 'mut' that no parameter of that type has
extern fn deep(char* s, char mut* mut** out) void; //! error: extern 'deep': C gives 'char mut*' with a 'mut' that no parameter of that type has
extern fn fill(char* s, char mut*[2] mut* out) void; //! error: extern 'fill': C gives 'char mut*' with a 'mut' that no parameter of that type has
extern fn hand_back(char* s, (fn (char*) char mut*) mut* out) void; //! error: extern 'hand_back': C gives 'char mut*' with a 'mut' that no parameter of that type has
extern fn enroll(char* s, fn (fn (char*) char mut*) void cb) void; //! error: extern 'enroll': C gives 'char mut*' with a 'mut' that no parameter of that type has
extern fn hold(void* p, void mut* mut* out) void; //! error: extern 'hold': C gives 'void mut*' with a 'mut' that no parameter of that type has
extern fn chain(char** s) char mut**; //! error: extern 'chain': C gives 'char mut**' with a 'mut' that no parameter of that type has
extern fn lend(char mut* own p) char mut*; //! error: extern 'lend': C gives 'char mut*' with a 'mut' that no parameter of that type has
extern fn bytes(u8 mut* s, u64 n) char mut*; //! error: extern 'bytes': C gives 'char mut*' with a 'mut' that no parameter of that type has
extern fn both(char* s, u64 mut* mut* out) char mut*; //! error: extern 'both': C gives 'char mut*' with a 'mut' that no parameter of that type has

// A call of a declaration in error reports nothing more.
fn main() i32 {
    char[2] s = {'a', cast(0, char)};
    char mut* w = strchr(&s[0], 97);
    return 0;
}
