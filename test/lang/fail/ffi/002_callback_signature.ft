//! fail
// A function-pointer parameter is extern-legal exactly when its own signature
// is (D9.8, module-system.md 8.1): C calls through it with the C convention,
// so an aggregate hidden inside it would cross the boundary after all.
struct point {
    i32 x;
    i32 y;
}

extern fn each(fn (point) void cb) void; //! error: extern signature cannot use type 'fn (point) void'
extern fn make(fn (i32) string f) i32; //! error: extern signature cannot use type 'fn (i32) string'
extern fn nest(fn (fn (i32@) i32) void h) void; //! error: extern signature cannot use type
extern fn getter() fn (point) void; //! error: extern signature cannot use type 'fn (point) void'

// The same function type is ordinary inside fort, where an aggregate is passed
// by a hidden pointer (D9.9).
fn one(point p) void {
    println(p.x, p.y);
}

fn each_fort(fn (point) void cb, point p) void {
    cb(p);
}

fn main() i32 {
    point p = {1, 2};
    each_fort(one, p);
    return 0;
}
