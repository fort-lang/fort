//! fail
// A function-pointer parameter is extern-legal exactly when its own signature
// is (D9.8, module-system.md 8.1): C calls through it with the C convention,
// so an aggregate hidden inside it would cross the boundary after all.
struct point {
    i32 x;
    i32 y;
}

extern fn void each(fn void(point) cb); //! error: extern signature cannot use type 'fn void(point)'
extern fn i32 make(fn string(i32) f); //! error: extern signature cannot use type 'fn string(i32)'
extern fn void nest(fn void(fn i32(i32@)) h); //! error: extern signature cannot use type
extern fn fn void(point) getter(); //! error: extern signature cannot use type 'fn void(point)'

// The same function type is ordinary inside fort, where an aggregate is passed
// by a hidden pointer (D9.9).
fn void one(point p) {
    println(p.x, p.y);
}

fn void each_fort(fn void(point) cb, point p) {
    cb(p);
}

fn i32 main() {
    point p = {1, 2};
    each_fort(one, p);
    return 0;
}
