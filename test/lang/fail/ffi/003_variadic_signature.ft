//! fail
// An extern signature cannot declare a variadic parameter (D9.8): fort has no
// variadics at all (D8.3), and a variadic C function is declared with a fixed
// prototype for the arguments actually passed (module-system.md 8.4). Nothing
// rejects this by name -- the grammar simply has no `...` in a parameter list
// -- so this test is what would notice a grammar change that let one in.
extern fn i32 printf(char* fmt, ...); //! error: expected a type

fn i32 main() {
    return 0;
}
