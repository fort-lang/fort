//! fail
import extern;
// A call through the function pointer that an extern call gives is a call of a function value and
// no call of that extern. The type of the pointer gives its parameters, and only the declaration
// of an extern has a variable tail (D9.8), so a call with more arguments is an error. The result
// of a call names no function: the error names the callee as a value, a call through it that
// gives no value names no function either, and `&` of such a result takes the address of no
// function. A call of the extern itself keeps its variable tail.
extern fn get_v(i32 n, ...) fn (char*) void;
extern fn get_cb() fn (char*) void;
extern fn get_run() fn () void;

fn run() void {
}

fn give_run() fn () void {
    return run;
}

fn main() i32 {
    char mut@ own a = new(char, 24);
    get_v(1)(&a[0], 5, 6); //! error: 'the callee' takes 1 argument, 3 given
    get_cb()(&a[0], 1); //! error: 'the callee' takes 1 argument, 2 given
    (fn (char*) void)* p = &get_cb(); //! error: '&' requires an lvalue
    i32 x = get_run()(); //! error: the expression has no value
    i32 y = give_run()(); //! error: the expression has no value
    i32 z = run(); //! error: 'run' has no value
    get_v(1, 2, 3)(&a[0]);
    get_v(1)(&a[0]);
    del(a);
    return 0;
}
