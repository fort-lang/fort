//! fail
// The result too: `fort_rt_flush` returns nothing, and a declaration that
// says otherwise has the caller read a register the callee never set (D9.8,
// toolchain.md 5.1). `noreturn` is a result of its own (D8.5), and claiming
// it of an entry point that returns would have the emitter treat the call as
// an exit.
extern fn i32 fort_rt_flush(i32 fd); //! error: the result type differs

fn i32 main() {
    return fort_rt_flush(1);
}
