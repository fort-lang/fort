//! fail
// Every closure holds std.rt, but membership does not bind the name: a module
// that wants to call the runtime writes `import std.rt;` like any other
// importer, and one that does not never sees it (D9.10, D9.3). Without the
// import the qualified name below resolves to nothing.
fn i32 main() {
    rt.flush(1); //! error: unknown name 'rt'
    return 0;
}
