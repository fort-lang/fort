//! fail
//! flags: -I fail/modules/014_same_file/sub
// A module's identity is the real path of its file (D9.2), so `sub/x.ft`
// reached as `sub.x` and as `x` through the `-I` root is one file under two
// module paths. The harness compiles from test/lang (toolchain.md 7), so the
// root above is written from there rather than from this directory.
import sub.x;
import x; //! error: module 'x' is the same file as module 'sub.x'

fn i32 main() {
    return 0;
}
