// Each function loses a local owner at a normal storage end.

fn scope_end() void {
    i32 mut* own p = new(i32);
} //! error: lost ownership of 'p'

fn early_return(bool stop) void {
    i32 mut* own p = new(i32);
    if (stop) { return; } //! error: lost ownership of 'p'
    del(p);
}

fn span_end() void {
    u8 mut@ own bytes = new(u8, 4);
} //! error: lost ownership of 'bytes'
