import extern;

// A trusted module (D9.8). A parameter of each function below has a type that reaches a pointer to
// `char`, `u8` or `void`, so each one is a boundary function, which only a trusted module names.

struct holder {
    u8* data;
    u64 len;
}

// A struct that reaches itself, and a `void*` beside it.
struct chain {
    void* item;
    chain* next;
}

fn by_pointee(u8** p) void {}

fn by_element(char*@ names) void {}

fn by_array(void*[2] slots) void {}

fn by_field(holder* h) void {}

fn by_chain(chain* c) void {}

fn by_callback(fn (u8*) void cb) void {}

fn by_result(fn () char* cb) void {}

fn by_two_levels(fn () fn (char*) void cb) void {}
