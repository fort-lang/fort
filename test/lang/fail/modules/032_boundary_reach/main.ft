//! fail
import edge;
import edge.{by_field as field}; //! error: 'edge.by_field' is a boundary function

// A module that is not trusted names no boundary function of a trusted module (D9.8). Reach goes
// through a pointee, an element of a span or of a fixed array, a field of a struct, a recursive
// struct, and a parameter or the result of a function pointer type, at two levels too. A call, a
// function value and a symbol import are each one error at the name.
fn main() i32 {
    edge.by_pointee(null); //! error: 'edge.by_pointee' is a boundary function
    char*[2] names = {};
    edge.by_element(names[..]); //! error: 'edge.by_element' is a boundary function
    void*[2] slots = {};
    edge.by_array(slots); //! error: 'edge.by_array' is a boundary function
    edge.by_chain(null); //! error: 'edge.by_chain' is a boundary function
    edge.by_callback(null); //! error: 'edge.by_callback' is a boundary function
    edge.by_result(null); //! error: 'edge.by_result' is a boundary function
    edge.by_two_levels(null); //! error: 'edge.by_two_levels' is a boundary function
    fn (char*@) void each = edge.by_element; //! error: 'edge.by_element' is a boundary function
    return 0;
}
