//! fail
// The drop `cell.drop` of another module stores an owner into a global of its module, so it is
// not release-only (D17.9). The error stands at the drop in this module, and its note at the
// store in cell.ft.
import cell;

fn main() i32 {
    cell.cell mut@ own cells = new(cell.cell, 2);
    del(cells, cell.drop); //! error: cannot drop the elements with 'drop': it is not release-only
    return 0;
}
