// Each function loses a local owner. No function of the program calls it.

fn loop_body(i32 count) void {
    i32 mut i = 0;
    while (i < count) {
        i32 mut* own p = new(i32);
        i += 1;
    } //! error: lost ownership of 'p'
}

fn branch_local(bool keep) void {
    if (keep) {
        i32 mut* own p = new(i32);
        *p = 1;
    } //! error: lost ownership of 'p'
}
