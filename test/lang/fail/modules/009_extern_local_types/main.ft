//! fail
import other;

// Both modules write `paint(color c)` and the two `color`s are different
// enums: a nominal type is identified by the declaration it comes from
// (D3.9), so the program has no one signature for the C symbol and the two
// declarations conflict (D9.8). Every pointer is `ptr` and every enum `i32`
// in the IR, so nothing below the compiler could notice.
enum color { red, green }

extern fn void paint(color c); //! error: conflicting declarations of extern 'paint'

fn i32 main() {
    paint(color.red);
    other.go();
    return 0;
}
