//! fail
//! stderr: fail/modules/009_extern_local_types/main.ft:18:17: error: conflicting
//! stderr: fail/modules/009_extern_local_types/other.ft:6:11: note: previous declaration
import other;

// The two directives above pin which file carries the error and which file
// carries the note, in that order. An error annotation pins the line alone,
// so nothing else in this test can see the two exchange places.
// D14.2

// Both modules write `paint(color c)` and the two `color`s are different
// enums: a nominal type is identified by the declaration it comes from
// (D3.9), so the program has no one signature for the C symbol and the two
// declarations conflict (D9.8). Every pointer is `ptr` and every enum `i32`
// in the IR, so nothing below the compiler could notice.
enum color { red, green }

extern fn paint(color c) void; //! error: conflicting declarations of extern 'paint'

fn main() i32 {
    paint(color.red);
    other.go();
    return 0;
}
