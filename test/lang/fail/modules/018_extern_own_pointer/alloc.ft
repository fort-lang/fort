// The first declaration of the C symbol, whose pointer parameter is `own`. The
// declarations of one C symbol must be identical and `own` is part of a typed
// pointer's identity, exactly as it is for `void*` (D9.8, D17.13). The symbol
// is one std.libc does not declare, since std.libc is in every closure behind
// std.rt and would be the earlier declaration of a libc name (D9.10).
extern fn void t077_take(i32 mut* own p);

fn void hand_over(i32 mut* own p) {
    t077_take(move(p));
}
