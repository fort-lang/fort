// Every module of the closure is checked, so an `extern fn` naming a runtime
// entry point is held against the prototype of toolchain.md 5.1 wherever it
// stands and not only in the entry module (D9.8): this one says
// `fort_rt_flush` takes a 64-bit descriptor, while the runtime reads an
// `int32_t`.
extern fn void fort_rt_flush(i64 fd); //! error: conflicting declarations of extern

fn void stop(i64 fd) {
    fort_rt_flush(fd);
}
