// condition reads, whether the condition names it through its module or
// through an item import.
import other;
import other.late;

$if (other.late[2]{}.len == 2) { i32 A = 1; } //! error: cannot use an unresolved
$if (late[2]{}.len == 2) { i32 B = 1; } //! error: cannot use an unresolved

fn main() i32 {
    return 0;
}
