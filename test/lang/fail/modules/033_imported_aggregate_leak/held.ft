// A module whose local of an owning aggregate type can leak: the call that
// takes the address of `b` kills the fact of `b.data`, and `fill` leaves an
// allocation there, so the `return` is an error in every build (D17.20).
struct buf {
    i32 mut* own data;
}

fn fill(buf mut* b) void {
    del(b->data);
    b->data = new(i32);
}

fn run() i32 {
    buf mut b = buf{};
    fill(&b);
    return 0; //! error: cannot prove 'b.data' is empty at this exit
}
