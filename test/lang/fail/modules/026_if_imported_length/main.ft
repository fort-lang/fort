// an array length in a parameter of a function type too, as it does for an
// array length behind a pointer.
import other;

$if (sizeof(fn(u8[other.N]) void) == 8) { i32 A = 1; } //! error: only fixed-array '.len' is available
$if (sizeof(u8[other.N]*) == 8) { i32 B = 1; } //! error: only fixed-array '.len' is available

fn main() i32 {
    return 0;
}
