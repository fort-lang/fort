//! fail
// D21.3: the condition of an import selector follows D21.2, so a `sizeof` in
// it is an error, also in an operand that `||` does not select. The selector
// reports it before it resolves an import path, so `absent` is never probed.
$if (true || sizeof(u64) == 8) { import absent; } //! error: 'sizeof' is not available

fn main() i32 {
    return 0;
}
