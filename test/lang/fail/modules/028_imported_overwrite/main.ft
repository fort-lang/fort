//! fail
// The store that the error names is in the imported module `slot`, so the
// annotation stands in slot.ft and the error names that file. `fill` stores
// through its parameter `out`, whose pointee the pass cannot prove empty
// (D17.11). A checked build of the same program trapped at run time in
// `slot.fill` on the second call before the rule became static.
// test/overwrite_oracle_test.py holds the position in every mode.

import slot;

fn main() i32 {
    slot.cell mut* own mut c = null;
    slot.fill(&c, 1);
    println(c->value);
    // A checked build trapped in this call before the rule became static.
    slot.fill(&c, 2);
    println("not reached");
    del(c);
    return 0;
}
