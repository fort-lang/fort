// A module whose store overwrites the slot that its caller passes. No `del`
// comes before the store, so the store is an error in every build (D17.11).
struct cell {
    i32 value;
}

fn fill(cell mut* own mut* out, i32 v) void {
    *out = new(cell); //! error: cannot prove '*out' is empty here
    (*out)->value = v;
}
