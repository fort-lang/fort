//! fail
import alloc;

// The declarations of one C symbol are compared as types, in the checker, so
// the conflict is reported at the piece of the later declaration that carries
// it -- here the result type, `own` being part of signature identity (D9.8,
// D17.13). The annotation is a line and not `error-any:` because the later
// declaration is the later one of the dependency order (D9.10), which does
// not depend on the walk.
extern fn void* own malloc(u64 n); //! error: conflicting declarations of extern 'malloc'

fn i32 main() {
    u8 mut* own p = cast(malloc(1), u8 mut* own);
    *p = 1;
    del(p);
    u8 mut* own q = cast(alloc.grab(1), u8 mut* own);
    del(q);
    return 0;
}
