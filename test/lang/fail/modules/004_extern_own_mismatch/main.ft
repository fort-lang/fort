//! fail
//! stderr: fail/modules/004_extern_own_mismatch/main.ft:16:11: error: conflicting
//! stderr: fail/modules/004_extern_own_mismatch/alloc.ft:4:21: note: previous declaration
import alloc;

// The two directives above pin which file carries the error and which file
// carries the note. An error annotation pins the line alone.
// D14.2

// The declarations of one C symbol are compared as types, in the checker, so
// the conflict is reported at the piece of the later declaration that carries
// it -- here the result type, `own` being part of signature identity (D9.8,
// D17.13). The annotation is a line and not `error-any:` because the later
// declaration is the later one of the dependency order (D9.10), which does
// not depend on the walk.
extern fn void* aligned_alloc(u64 alignment, u64 size); //! error: conflicting declarations of extern 'aligned_alloc'

fn i32 main() {
    u8 mut* own p = cast(aligned_alloc(16, 1), u8 mut* own);
    *p = 1;
    del(p);
    u8 mut* own q = cast(alloc.grab(1), u8 mut* own);
    del(q);
    return 0;
}
