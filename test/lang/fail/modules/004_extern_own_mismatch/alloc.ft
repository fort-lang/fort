// Declares the same C symbol as main.ft with own; the signatures must be identical, own
// included (D9.8, D17.13). The symbol is one std.libc does not declare, since std.libc is in
// every closure behind std.rt and would be the earlier declaration of a libc name (D9.10).
// Both declarations answer void mut*, so the adopting casts of main.ft add the own alone: a
// cast never adds mut (D3.14).
extern fn aligned_alloc(u64 alignment, u64 size) void mut* own;

fn grab(u64 n) void mut* own {
    return aligned_alloc(16, n);
}
