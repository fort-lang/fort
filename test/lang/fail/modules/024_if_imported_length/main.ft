//! fail
// D21.2: an imported declaration is not available to a condition. That holds for
// the array length of an array literal whose `.len` a condition reads too.
import other;

$if (other.N == 4) { i32 A = 1; } //! error: only fixed-array '.len' is available
$if (u8[other.N]{}.len == 4) { i32 B = 1; } //! error: only fixed-array '.len' is available

fn main() i32 {
    return 0;
}
