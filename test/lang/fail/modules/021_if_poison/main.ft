//! fail
// D21.3: the `$if` around an import is evaluated before any module loads, so
// a name or a call in its condition is refused there, and `poison.ft` is never
// read: its syntax error would be a second, unannotated diagnostic.
$if (PICK) { import poison; } //! error: is not available to a $if condition
$if (choose(true)) { import poison; } //! error: expression is not available in a $if condition

bool PICK = true;

fn choose(bool value) bool {
    return value;
}

fn main() i32 {
    return 0;
}
