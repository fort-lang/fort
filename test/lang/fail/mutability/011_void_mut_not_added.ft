//! fail
// Adding the mark a `void*` carries needs a cast, at every level, and the
// drop stays monotone: level 1 of the target must be immutable before level 2
// may be dropped (D3.11, D5.4). Comparison is the one place the drop does not
// reach: `==` and `?:` require identical types, mutability levels included
// (D6.2, D5.4's last sentence), so a `void mut*` does not compare with a
// `void*` and a program that holds both casts one of them.
fn store(void mut* dst) void {
    i32 mut* p = cast(dst, i32 mut*);
    *p = 1;
}

fn main() i32 {
    i32 mut x = 0;
    void* r = cast(&x, void*);
    void mut* w = r; //! error: expects void mut*, not void*
    store(r); //! error: the argument expects void mut*, not void*
    void mut* mut slot = cast(&x, void mut*);
    void* mut* bad = &slot; //! error: expects void* mut*, not void mut* mut*
    bool same = slot == r; //! error: the same type, not void mut* and void*
    return cast(w == null, i32) + cast(bad == null, i32) + cast(same, i32);
}
