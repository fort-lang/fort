//! fail
// `&e` has type `T*` whose level-1 bit is the mutability of `e` (D5.8), and a
// `T mut*` may not be taken of an immutable lvalue. Adding mutability needs a
// `cast` (D3.14), which is the escape and is not implicit.
fn i32 main() {
    i32 fixed = 4;
    i32 mut* p = &fixed; //! error: expects i32 mut*
    string s = "ab";
    char mut* q = &s[0]; //! error: mut
    return *p + cast(*q, i32);
}
