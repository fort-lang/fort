//! fail
// Assignment, compound assignment, `++` and `--` all require a mutable lvalue
// (D5.7), and the mutability of `*p`, `p->f` and `s[i]` comes from level 1 of
// the pointer or span, never from the binding that holds it.
struct point {
    i32 x;
    i32 y;
}

fn main() i32 {
    i32 mut v = 1;
    i32* p = &v;
    *p = 2; //! error: cannot assign to immutable
    point mut q = point{1, 2};
    point* qp = &q;
    qp->x = 3; //! error: cannot assign to immutable
    i32 mut@ own xs = new(i32, 2);
    i32@ ro = xs;
    ro[0] = 4; //! error: cannot assign to immutable
    ro[1] += 1; //! error: cannot assign to immutable
    i32 fixed = 9;
    fixed++; //! error: cannot modify immutable
    del(xs);
    return v + q.x;
}
