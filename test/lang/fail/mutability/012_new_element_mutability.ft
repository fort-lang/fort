//! fail
// `new` marks the storage it allocates and no position below it, so the
// element type of the result is the element type written (D5.8, D10.2).
// Neither spelling converts to the other. Adding a `mut` needs a cast
// (D3.14, D5.4), and dropping one at level 2 is refused while level 1 stays
// mutable, which is the C `T** -> const T**` hole D5.4 closes.
// run/pointers/013 is the program both of these are taken from.
struct node {
    i32 value;
}

fn i32 main() {
    node mut* mut@ own adds = new(node*, 2); //! error: expects node mut* mut@ own
    node* mut@ own drops = new(node mut*, 2); //! error: expects node* mut@ own
    node mut* mut* own slot = new(node*); //! error: expects node mut* mut* own
    del(slot);
    del(drops);
    del(adds);
    return 0;
}
