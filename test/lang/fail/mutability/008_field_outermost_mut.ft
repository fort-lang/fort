//! fail
// A field's own storage is as mutable as the struct that contains it, so the
// outermost position of a field type never carries `mut`; a return type has no
// binding, so its outermost position never carries one either (D5.5).
struct node {
    i32 mut count; //! error: a field's own storage follows its struct
    node* mut next; //! error: a field's own storage follows its struct
}

fn i32 mut bad_scalar() { //! error: mut
    return 0;
}

fn i32 main() {
    node n = {};
    return n.count + bad_scalar();
}
