//! fail
// There is no promotion between f32 and f64: every mixed operation is an
// error (D6.2).
fn main() i32 {
    f32 a = 1.5;
    f64 b = 2.5;
    f64 c = a + b; //! error: takes two operands of the same type, not f32 and f64
    bool d = a < b; //! error: takes two operands of the same type, not f32 and f64
    bool e = b == a; //! error: takes two operands of the same type, not f64 and f32
    return 0;
}
