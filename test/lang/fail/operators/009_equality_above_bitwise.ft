//! fail
// `== !=` bind tighter than `& ^ |` (D6.1), so `a & b == c` groups as
// `a & (b == c)` and the bitwise operator receives a `bool`. No run test can
// show this level of the ladder, because every expression that exercises it
// is ill-typed; this is the level.
fn i32 main() {
    i32 a = 6;
    i32 b = 3;
    i32 x = a & b == b; //! error: '&' takes two operands of the same type, not i32 and bool
    i32 y = a ^ b != b; //! error: '^' takes two operands of the same type, not i32 and bool
    i32 z = a | b == b; //! error: '|' takes two operands of the same type, not i32 and bool
    return x + y + z;
}
