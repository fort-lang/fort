//! fail
// `! && ||` take bool operands, and a float is no condition: there is no
// truthiness (D3.3, D6.2).
fn i32 main() {
    f64 a = 1.0;
    f64 b = 0.0;
    bool c = a && b; //! error: '&&' takes bool operands, not f64
    bool d = a || b; //! error: '||' takes bool operands, not f64
    bool e = !a; //! error: '!' expects bool, not f64
    if (a) { //! error: a condition must be bool
        return 1;
    }
    return 0;
}
