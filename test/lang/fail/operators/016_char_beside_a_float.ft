//! fail
// A char reaches no float type: an untyped float becomes a float type and no
// other (D4.2), and no row of D3.14 takes a char to a float. The rule holds
// for two constants as it does for a typed operand, which run/casts and
// fail/casts/010 cover.
fn i32 main() {
    f64 a = 'a' + 0.5; //! error: '+' takes numeric operands, not char
    f64 b = 0.5 * 'a'; //! error: '*' takes numeric operands, not char
    f64 c = 1.0 / 'a'; //! error: '/' takes numeric operands, not char
    f64 d = 'a' - 1.5; //! error: '-' takes numeric operands, not char
    bool e = 'a' < 0.5; //! error: a float constant does not become char
    bool f = 0.5 == 'a'; //! error: a float constant does not become char
    char g = 'a';
    f64 h = g + 0.5; //! error: '+' takes numeric operands, not char
    // The two arms of a conditional meet no operator, so the rule of the
    // default type is what brings them together, and one type must hold both
    // (D4.5, D6.2). The char clause wins over the float clause, and no float
    // constant becomes `char`, so the float arm is the one refused.
    bool k = g == 'a';
    println(k ? 'a' : 1.5); //! error: a float constant does not become char
    println(k ? 2.5 : 'b'); //! error: a float constant does not become char
    println(a, b, c, d, e, f, h);
    return 0;
}
