//! fail
// `%` is an error on floats, on a variable and on a constant alike (D6.12).
fn i32 main() {
    f64 a = 7.5;
    f64 b = 2.0;
    f64 c = a % b; //! error: '%' takes integer operands, not f64
    f64 d = 7.5 % 2.0; //! error: '%' takes integer operands, not f64
    f32 e = 1.5;
    f32 f = e % e; //! error: '%' takes integer operands, not f32
    return 0;
}
