//! fail
// `<< >>` are errors on floats, as the shifted operand and as the count
// (D6.12, D6.2).
fn i32 main() {
    f64 a = 4.0;
    i32 n = 1;
    f64 b = a << n; //! error: '<<' takes an integer left operand, not f64
    f64 c = a >> n; //! error: '>>' takes an integer left operand, not f64
    f64 d = 1.5 << 2; //! error: '<<' takes an integer left operand, not f64
    i32 e = n << a; //! error: '<<' takes an integer count, not f64
    // A shift by a variable count folds to no value, so the float context
    // reaches the shift itself rather than a constant (D4.1).
    f64 f = 1 << n; //! error: '<<' takes an integer left operand, not f64
    f32 g = 1 >> n; //! error: '>>' takes an integer left operand, not f32
    // A shift that folds is an integer constant and takes a float type like
    // any other, so this one is not an error (D4.2, D4.4).
    f64 h = 1 << 2;
    println(b, c, d, e, f, g, h);
    return 0;
}
