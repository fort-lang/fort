//! fail
// `<< >>` are errors on floats, as the shifted operand and as the count
// (D6.12, D6.2).
fn i32 main() {
    f64 a = 4.0;
    i32 n = 1;
    f64 b = a << n; //! error: '<<' takes an integer left operand, not f64
    f64 c = a >> n; //! error: '>>' takes an integer left operand, not f64
    f64 d = 1.5 << 2; //! error: '<<' takes an integer left operand, not f64
    i32 e = n << a; //! error: '<<' takes an integer count, not f64
    // A shift by a variable count folds to no value, so the float context
    // reaches the shift itself rather than a constant (D4.1).
    f64 f = 1 << n; //! error: '<<' takes an integer left operand, not f64
    f32 g = 1 >> n; //! error: '>>' takes an integer left operand, not f32
    // A shift that folds is an integer constant and takes a float type like
    // any other, so this one is not an error (D4.2, D4.4).
    f64 h = 1 << 2;
    // The same guard where the rule of the default type and not a declaration
    // chose the float. The left operand of each shift is an expression with no
    // value whose constants are all floats, so the float clause gives it f64
    // and the operand rule holds against that (D4.5, D6.2). No declaration says
    // the type here and nothing but this rule can.
    bool k = n > 0;
    println((k ? 1.5 : 2.5) << 1); //! error: '<<' takes an integer left operand, not f64
    println((k ? 1.5 : 2.5) >> 1); //! error: '>>' takes an integer left operand, not f64
    // An integer constant beside the floats leaves the expression an integer
    // one, so the float constant meets i32 and the shift is never reached
    // (D4.2, D4.5). fail/constants/010 holds that pair of programs.
    println(1.5 + (1 << n)); //! error: a float constant does not become i32
    println((1 >> n) * 2.5); //! error: a float constant does not become i32
    println(b, c, d, e, f, g, h);
    return 0;
}
