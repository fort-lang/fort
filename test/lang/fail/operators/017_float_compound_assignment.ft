//! fail
// A compound assignment has the operand rules of its operator (D7.2), so the
// operators that take no float take none here either (D6.12).
fn main() i32 {
    f64 mut a = 7.5;
    f32 mut b = 1.5;
    a %= 2.0; //! error: '%' takes integer operands, not f64
    a <<= 1; //! error: '<<' takes an integer left operand, not f64
    a >>= 1; //! error: '>>' takes an integer left operand, not f64
    a &= 1.0; //! error: '&' takes integer operands, not f64
    a |= 1.0; //! error: '|' takes integer operands, not f64
    a ^= 1.0; //! error: '^' takes integer operands, not f64
    b %= 1.0; //! error: '%' takes integer operands, not f32
    // The four that do take floats are run/operators/021.
    a += 1.0;
    println(a, b);
    return 0;
}
