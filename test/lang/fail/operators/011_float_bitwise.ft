//! fail
// `~ & | ^` are errors on floats (D6.12).
fn i32 main() {
    f64 a = 6.0;
    f64 b = 3.0;
    f64 c = a & b; //! error: '&' takes integer operands, not f64
    f64 d = a | b; //! error: '|' takes integer operands, not f64
    f64 e = a ^ b; //! error: '^' takes integer operands, not f64
    f64 f = ~a; //! error: '~' takes an integer operand, not f64
    f64 g = ~1.5; //! error: '~' takes an integer operand, not f64
    return 0;
}
