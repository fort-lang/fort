//! fail
// `++` and `--` are errors on floats (D6.12, D7.2).
fn main() i32 {
    f64 mut a = 1.5;
    f32 mut b = 1.5;
    a++; //! error: '++' takes an integer operand, not f64
    a--; //! error: '--' takes an integer operand, not f64
    b++; //! error: '++' takes an integer operand, not f32
    return 0;
}
