//! fail
// A constant division by zero yields an infinity or a NaN, and neither is a
// constant (D4.4, D6.12). The same expression on variables is legal and
// run/operators/018 runs it.
f64 INF = 1.0 / 0.0; //! error: constant division by zero

fn main() i32 {
    f64 a = 2.0 / 0.0; //! error: constant division by zero
    f64 b = 0.0 / 0.0; //! error: constant division by zero
    f64 c = 1.0 / -0.0; //! error: constant division by zero
    return 0;
}
