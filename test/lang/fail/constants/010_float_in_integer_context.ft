//! fail
// A float constant becomes a float type and no other, not even when it is
// integral (D4.2), and an index, a span bound, a `new` count and an array
// length are integers (D6.8, D6.9, D10.2, D3.4).
fn i32 main() {
    i32 a = 2.0; //! error: a float constant does not become i32
    u8 b = 1.5; //! error: a float constant does not become u8
    char c = 65.0; //! error: a float constant does not become char
    i32[3] mut values = {};
    i32 d = values[1.0]; //! error: index must be an integer, not f64
    i32 mut@ own span = new(i32, 2.0); //! error: count must be an integer, not f64
    del(span);
    // With no context the rule gives each constant a default type and one type
    // covers the whole expression (D4.5, D6.2). The float clause wins only
    // where nothing else asks for a type, so an integer constant beside a float
    // constant leaves the expression an integer one and the float constant
    // reaches no integer type. `c ? 1 : 2.5` compiled and printed 1.0 on one
    // branch of 2026-09-14 and on no other day.
    i32 n = values[0];
    println(n > 0 ? 1 : 2.5); //! error: a float constant does not become i32
    println(n > 0 ? 2.5 : 1); //! error: a float constant does not become i32
    println(1.5 + (1 << n)); //! error: a float constant does not become i32
    // The integer clause answers first here too, and its own tail refuses the
    // constant: 2^63 has no default type at all (D4.5).
    println(n > 0 ? 9223372036854775808 : 1.5); //! error: does not fit i64
    // A char literal beside a float constant is the same shape with the char
    // clause in the middle: `char` wins over the float clause and no float
    // constant becomes `char` (D4.3).
    println(n > 0 ? 'a' : 1.5); //! error: a float constant does not become char
    return 0;
}
