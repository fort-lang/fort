//! fail
// Every operator that drops a poisoned operand, which is every position that is
// no context at all. An untyped integer in [2^63, 2^64 - 1] has no default type
// (D4.5), so `untyped()` gives it the error type and reports nothing: the rule
// leaves the report to the context. A position that is no context gives the
// constant its default type instead, and the rule then reports it.
//
// All thirteen accepted the program in silence until 2026-09-14, in both
// compilers: the program compiled, linked, exited 0 and printed nothing. The
// `for` reached the emitter, which wrote `alloca void` and made clang refuse
// the module.
//
// Every line drew a second diagnostic at the same position until 2026-09-14,
// "the expression expects <error>, not a constant": 27 diagnostics on these 13
// lines, where there are now 14. The type is poisoned by the first, and D14.2
// silences every later diagnostic on a poisoned type. The harness judges a
// line and not a count, so it cannot see that removal; the count stands in
// bootstrap/test/check_poison_test.c and in test/fort/check_test.ft.
//
// fail/constants/013 holds the same thirteen with a constant an expression
// carries rather than one that folded.
struct s {
    i32 x;
}

fn main() i32 {
    println(*9223372036854775808); //! error: constant expression out of range
    println((9223372036854775808).x); //! error: constant expression out of range
    println((9223372036854775808)->x); //! error: constant expression out of range
    println((9223372036854775808).len); //! error: constant expression out of range
    println(9223372036854775808[0]); //! error: constant expression out of range
    println((9223372036854775808)[0 .. 1]); //! error: constant expression out of range
    println(9223372036854775808()); //! error: constant expression out of range
    println(&9223372036854775808); //! error: constant expression out of range
    del(9223372036854775808); //! error: constant expression out of range
    println(move(9223372036854775808)); //! error: constant expression out of range
    9223372036854775808 = 1; //! error: constant expression out of range
    9223372036854775808++; //! error: constant expression out of range
    for (i32 x : 9223372036854775808) { //! error: constant expression out of range
        println(x);
    }
    return 0;
}
