//! fail
// A constant must be finite in the type it is given, so a value with no
// binary32 is an error in an f32 context, whether it arrives by conversion,
// by a cast or by folding (D4.4).
f32 SCALE = 1e300; //! error: a float constant out of range for f32
f32 LARGE = 1e38;
// Two f32 constants fold in f32, so this product leaves the format rather
// than the value (D4.6).
f32 OVER = LARGE * 10.0; //! error: constant expression overflows f32

fn i32 main() {
    f32 a = 1e39; //! error: a float constant out of range for f32
    f32 b = cast(1e300, f32); //! error: a float constant out of range for f32
    // Two untyped constants fold in binary64 first, so this one is finite
    // there and out of range only when it meets its context (D4.4).
    f32 c = 1e38 * 10.0; //! error: a float constant out of range for f32
    println(SCALE, " ", OVER, " ", a, " ", b, " ", c);
    return 0;
}
