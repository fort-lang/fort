//! fail
// The same thirteen positions as fail/constants/012, with a constant that an
// expression still carries rather than one that folded. A shift whose count is
// a variable folds to no value, so the constant reaches the default type with
// the expression around it and meets i64, the widest the integer clause of
// D4.5 offers.
//
// One diagnostic on twelve of the thirteen lines, and not the two of 012: the
// constant is reported against i64 and no second rule reads the error type.
// The `move` line is the exception and draws two, the constant and then
// "'move' has no value", exactly as its line in 012 does: `move`'s early
// return on a poisoned operand leaves the result `void` and the caller says
// so. This test pins the line and not the count; the counts are in
// bootstrap0/test/check_operand_test.c and test/fort/check_test.ft.
struct s {
    i32 x;
}

fn z(i32 v) i32 {
    return v;
}

fn main() i32 {
    i32 n = z(0);
    println(*(9223372036854775808 << n)); //! error: constant 9223372036854775808 does not fit i64
    println((9223372036854775808 << n).x); //! error: constant 9223372036854775808 does not fit i64
    println((9223372036854775808 << n)->x); //! error: constant 9223372036854775808 does not fit i64
    println((9223372036854775808 << n).len); //! error: constant 9223372036854775808 does not fit i64
    println((9223372036854775808 << n)[0]); //! error: constant 9223372036854775808 does not fit i64
    println((9223372036854775808 << n)[0 .. 1]); //! error: constant 9223372036854775808 does not fit i64
    println((9223372036854775808 << n)()); //! error: constant 9223372036854775808 does not fit i64
    println(&(9223372036854775808 << n)); //! error: constant 9223372036854775808 does not fit i64
    del(9223372036854775808 << n); //! error: constant 9223372036854775808 does not fit i64
    println(move(9223372036854775808 << n)); //! error: constant 9223372036854775808 does not fit i64
    (9223372036854775808 << n) = 1; //! error: constant 9223372036854775808 does not fit i64
    (9223372036854775808 << n)++; //! error: constant 9223372036854775808 does not fit i64
    for (i32 x : (9223372036854775808 << n)) { //! error: constant 9223372036854775808 does not fit i64
        println(x);
    }
    return 0;
}
