//! fail
// A literal that is not finite in binary64 is a compile error and not an
// infinity (D4.4).
fn main() i32 {
    f64 a = 1e309; //! error: float literal out of range for f64
    f64 b = 1.7976931348623159e308; //! error: float literal out of range for f64
    f64 c = 1e400; //! error: float literal out of range for f64
    return 0;
}
