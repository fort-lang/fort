//! fail
// Positional and designated initializers do not mix, and a bare `{...}` is an
// initializer and never an expression (D6.5).
struct point {
    i32 x;
    i32 y;
}

fn side(point p) i32 {
    return p.x;
}

fn main() i32 {
    point a = point{.x = 1, 2}; //! error: mix
    point b = point{1, .y = 2}; //! error: mix
    i32 n = side({3, 4}); //! error: expected an expression
    return a.x + b.y + n;
}
