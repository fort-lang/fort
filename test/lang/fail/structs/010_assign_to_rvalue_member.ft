//! fail
// Field access and indexing on an rvalue struct or array yield rvalues
// (D6.7), so they are read and never assigned: the value they name is a
// temporary the expression owns.
struct point {
    i32 x;
    i32 y;
}

fn mk() point {
    return point{1, 2};
}

fn main() i32 {
    point{1, 2}.x = 5; //! error: lvalue
    mk().y = 5; //! error: lvalue
    // Parenthesized, because a statement that starts with a type is read as a
    // declaration (D6.5: `IDENT {` is never a block, but `i32[2] {` is a type
    // followed by one).
    (i32[2]{7, 8})[1] = 5; //! error: lvalue
    return 0;
}
