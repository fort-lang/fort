//! fail
// Two structs that hold each other by value: the containment closes a cycle
// with no indirection on it, so the size is infinite and the error stands at
// the `struct` keyword of the one the resolution reached first (D3.8, D14.2).
struct outer { //! error: infinite
    inner part;
}

struct inner {
    outer whole;
}

fn i32 main() {
    return 0;
}
