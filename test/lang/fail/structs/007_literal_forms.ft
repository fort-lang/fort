//! fail
// The literal forms of D6.5: a designator appears once, a typed array literal
// has exactly N elements, and `{}` initializes an aggregate and never a
// scalar. Mixing the two forms is a syntax error, so it has a file of its own:
// a file the parser rejects is never checked.
struct point {
    i32 x;
    i32 y;
}

fn main() i32 {
    point b = point{.x = 1, .x = 2}; //! error: duplicate
    i32[2] c = i32[2]{1, 2, 3}; //! error: 2 elements
    i32 d = {}; //! error: aggregate
    return b.y + c[0] + d;
}
