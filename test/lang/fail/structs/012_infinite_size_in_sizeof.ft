//! fail
// A struct that contains itself by value has an infinite size (D3.8). The
// checker reports that once, at the struct. A `sizeof` of an array of it behind
// a pointer adds no report, in either declaration order (D7.10).
u64 A = sizeof(a[2]*);
struct a { //! error: struct a has infinite size
    b x;
}
struct b {
    a y;
}
struct c { //! error: struct c has infinite size
    d x;
}
struct d {
    c y;
}
u64 D = sizeof(d[2]*);
u64 E = sizeof(e[4611686018427387904]*);
struct e { //! error: struct e has infinite size
    f x;
}
struct f {
    e y;
}

fn main() i32 {
    return 0;
}
