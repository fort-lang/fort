//! fail
// `defer` takes an assignment, a `++`/`--`, a call statement or a block (D7.8,
// grammar.md defer_stmt), so a declaration and an `if` are both refused.
fn i32 main() {
    defer i32 t = 1; //! error: expected an expression, found 'i32'
    defer if (t == 1) { } //! error: expected an expression, found 'if'
    return 0;
}
