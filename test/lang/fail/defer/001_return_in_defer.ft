//! fail
// `return` inside deferred code is an error wherever it stands: it would leave the function in
// the middle of an unwind (D7.8). A loop written inside the deferred code catches `break` and
// `continue`, and it catches no `return`.
fn main() i32 {
    defer {
        return 1; //! error: defer
    }
    while (true) {
        defer {
            while (true) {
                return 2; //! error: 'return' inside deferred code
            }
        }
        break;
    }
    return 0;
}
