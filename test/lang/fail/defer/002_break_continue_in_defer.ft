//! fail
// A `break` or a `continue` inside deferred code binds to the innermost loop or `switch` written
// inside the deferred code (D7.8). The loop or the `switch` around the `defer` is out of reach,
// so with none inside it the exit is the error it is anywhere else.
fn i32 main() {
    for (i32 mut i = 0; i < 2; i++) {
        defer {
            break; //! error: 'break' outside a loop or switch
        }
    }
    while (true) {
        defer {
            continue; //! error: 'continue' outside a loop
        }
    }
    switch (1) {
    case 1:
        defer {
            break; //! error: 'break' outside a loop or switch
        }
    default:
    }
    for (i32 mut j = 0; j < 2; j++) {
        defer {
            switch (2) {
            case 2:
                // A `switch` inside the deferred code catches `break` and not `continue`.
                continue; //! error: 'continue' outside a loop
            default:
            }
        }
    }
    return 0;
}
