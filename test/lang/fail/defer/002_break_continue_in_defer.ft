//! fail
// `break` and `continue` may not appear inside deferred code (D7.8), in a loop body or in a
// case body alike.
fn i32 main() {
    for (i32 mut i = 0; i < 2; i++) {
        defer {
            break; //! error: 'break' inside deferred code
        }
    }
    while (true) {
        defer {
            continue; //! error: 'continue' inside deferred code
        }
    }
    switch (1) {
    case 1:
        defer {
            break; //! error: 'break' inside deferred code
        }
    default:
    }
    return 0;
}
