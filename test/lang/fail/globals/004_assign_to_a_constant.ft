//! fail
// A module-level immutable declaration lives in read-only memory (D7.10), so
// it is an lvalue that is addressable and never assignable (D6.7): the
// refusal is what keeps a program from writing to .rodata.
struct point {
    i32 x;
    i32 y;
}

i32 LIMIT = 10;
point ORIGIN = {1, 2};
i32[2] TABLE = {1, 2};
i32 mut counter = 0;

fn main() i32 {
    LIMIT = 5; //! error: immutable
    ORIGIN.x = 5; //! error: immutable
    TABLE[0] = 5; //! error: immutable
    counter = 5;
    return counter;
}
