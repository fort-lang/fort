// stands on an annotated line, because bootstrap-0 reports a `$` there.
$if (sizeof(a[2]*) == 8) { i32 A = 1; } struct a { b x; } //! error: struct a has infinite size
struct b {
    a y;
}
struct c { d x; } struct d { c y; } $if (sizeof(d[2]*) == 8) { i32 C = 1; } //! error: struct c
$if (sizeof(e[4611686018427387904]*) == 8) { i32 E = 1; } struct e { f x; } //! error: struct e
struct f {
    e y;
}

fn main() i32 {
    return 0;
}
