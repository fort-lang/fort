//! fail
// `sizeof` is not available in a `$if` condition (D21.2). The rule is
// syntactic: the selector reports the first `sizeof` of each condition of a
// chain before it evaluates the chain. An operand that `&&`, `||` or `?:` does
// not select reports too, and so does the condition of an `else $if` after the
// selected branch. A declaration that a condition reaches reports the first
// `sizeof` of its initializer, and a `.len` reports the first `sizeof` of the
// array length that it reads. A statement `$if` follows the same rule. Each
// `$if` stands on an annotated line, because bootstrap-0 reports a `$` there.
$if (sizeof(i32) == 4) { i32 A = 1; } //! error: 'sizeof' is not available in a $if condition
$if (true || sizeof(i32) == 4) { i32 B = 1; } //! error: 'sizeof' is not available
$if (false && sizeof(i32) == sizeof(i64)) { i32 C = 1; } //! error: 'sizeof' is not available
$if (true ? true : sizeof(missing) == 4) { i32 D = 1; } //! error: 'sizeof' is not available
$if (true) { i32 E = 1; } else $if (sizeof(i32) == 4) { i32 E = 2; } //! error: 'sizeof' is not
$if (u8[sizeof(i32)]{}.len == 4) { i32 F = 1; } //! error: 'sizeof' is not available
u64 WORD = sizeof(u64); $if (WORD == 8) { i32 G = 1; } //! error: 'sizeof' is not available
u8[sizeof(u32)] BYTES = {}; $if (BYTES.len == 4) { i32 H = 1; } //! error: 'sizeof' is not
bool SKIP = true || sizeof(i32) == 4; $if (SKIP) { i32 I = 1; } //! error: 'sizeof' is not

fn main() i32 {
    $if (sizeof(i32) == 4) { return 1; } //! error: 'sizeof' is not available in a $if condition
    $if (true || sizeof(i32) == 4) { return 2; } //! error: 'sizeof' is not available
    return 0;
}
