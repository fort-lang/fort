//! fail
// A `$if` condition computes a size before the checker runs. It refuses a type
// that is too large behind a reference too (D3.4). A function type is one word,
// but D3.4 refuses a parameter or a result that is too large.
$if (sizeof(u64[4611686018427387904]*) == 8) { i32 A = 1; } //! error: type is too large
$if (sizeof(fn(u64[4611686018427387904]) void) == 8) { i32 B = 1; } //! error: type is too large
$if (sizeof(fn() u64[4611686018427387904]*) == 8) { i32 C = 1; } //! error: type is too large
// 2^60 values of 8 bytes need 2^63 bytes, one more than fits.
$if (sizeof(fn(u64[1152921504606846976]) void) == 8) { i32 D = 1; } //! error: type is too large

fn main() i32 {
    return 0;
}
