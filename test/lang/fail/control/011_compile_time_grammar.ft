//! fail
// `$if` is a declaration or a statement and nothing else: a field, an enum
// member, a parameter, a type and an expression reject it. The parser reads
// an inactive branch too, so its syntax error is still an error.
struct item { $if (true) { i32 value; } } //! error: expected a type, found '$if'
enum choice { $if (true) { value, } } //! error: expected an identifier, found '$if'
fn f($if (true) { i32 value }) void {} //! error: expected a type, found '$if'
fn g() $if {} //! error: expected a type, found '$if'
i32 VALUE = $if; //! error: expected an expression, found '$if'
$if (true) { i32 OK = 1; } else { i32 BAD = ; } //! error: expected an expression, found ';'
