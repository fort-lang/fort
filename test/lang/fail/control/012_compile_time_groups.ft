//! fail
// A group keeps each rule of the type it groups (D3.6). A `mut` inside or
// after the parentheses makes a binding that no condition reads. A grouped
// pointer is not a primitive constant, and a grouped array behind a pointer
// has no `.len`. A grouped cast target keeps its `mut`.
(bool) mut AFTER = true;
(bool mut) INSIDE = true;
(i32[3])* ARRAY_POINTER = null;
$if (AFTER) { i32 A = 1; } //! error: 'AFTER' is not available
$if (INSIDE) { i32 B = 1; } //! error: 'INSIDE' is not available
(i32*) POINTER = null; $if (POINTER == null) { i32 C = 1; } //! error: unqualified primitive
$if (ARRAY_POINTER.len == 3) { i32 D = 1; } //! error: only fixed-array '.len' is available
$if (cast(1, (u8) mut) == 1) { i32 F = 1; } //! error: invalid cast in a $if condition
