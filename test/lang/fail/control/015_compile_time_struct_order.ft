//! fail
// The checker sizes an array of a named type in a `$if` condition after it lays
// out each struct (D3.4). A struct declared after its use and a struct that
// reaches itself through a pointer each have their size there (D3.8, D7.10).
// `early` and `node` each take 16 bytes, so 2^59 of them need 2^63 bytes, one
// more than fits. An enum takes 4 bytes (D3.9), so 2^61 of them need 2^63
// bytes, and `late` takes 2.
$if (sizeof(early[576460752303423488]*) == 8) { i32 A = 1; } //! error: type is too large
struct early {
    u64 a;
    u64 b;
}
struct node {
    node* next;
    u64 value;
}
enum color { red, green }
$if (sizeof(node[576460752303423488]*) == 8) { i32 B = 1; } //! error: type is too large
$if (sizeof(color[4611686018427387904]*) == 8) { i32 C = 1; } //! error: type is too large
$if (sizeof(color[2305843009213693952]*) == 8) { i32 G = 1; } //! error: type is too large
$if (sizeof(fn(node[4611686018427387904]) void) == 8) { i32 D = 1; } //! error: type is too large
$if (sizeof((node)[2][4611686018427387904]@) == 16) { i32 E = 1; } //! error: type is too large
// A `sizeof` in an array length reports once, at itself.
$if (sizeof(node[sizeof(node[4611686018427387904]*)]*) == 8) { i32 F = 1; } //! error: too large

fn main() i32 {
    $if (sizeof(late[4611686018427387904]*) == 8) { return 1; } //! error: type is too large
    return 0;
}

struct late {
    u16 a;
}
