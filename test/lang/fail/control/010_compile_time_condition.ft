//! fail
// What a condition can read: a bool from the constants of this module and
// casts between numbers, and no `sizeof` (D21.2). Each line breaks one of
// those rules.
u8 BYTE = 1;
u8 COUNT = 8;
bool mut RUNTIME = true;
bool FLAG = true;
$if ("x") { i32 A = 1; } //! error: a $if condition must be bool, not string
$if ('x') { i32 B = 1; } //! error: a $if condition must be bool, not char
$if (RUNTIME) { i32 C = 1; } //! error: 'RUNTIME' is not available
$if (FLAG < FLAG) { i32 E = 1; } //! error: ordering operands in a $if condition must be ordered
$if (-BYTE == 0) { i32 F = 1; } //! error: requires a signed type
$if ((BYTE << COUNT) == 0) { i32 G = 1; } //! error: outside the left operand width
$if (cast(9223372036854775808, u64) == 0) { i32 H = 1; } //! error: constant expression out of range
$if (cast(1, bool)) { i32 I = 1; } //! error: cannot use bool
$if (sizeof(i32) == 4) { i32 J = 1; } //! error: 'sizeof' is not available in a $if condition
