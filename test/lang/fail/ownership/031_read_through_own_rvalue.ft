//! fail
// Reading through an owning rvalue leaves the allocation with no owner, exactly
// as indexing or taking a span of it does (D17.8).
struct node {
    i32 value;
}

fn i32 main() {
    println(new(node)->value); //! error: owning temporary
    println((*new(node)).value); //! error: owning temporary
    println(new(u8, 4).len); //! error: owning temporary
    return 0;
}
