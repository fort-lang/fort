//! fail
// The drop of `del(s, d)` calls no function value (D17.9): no rule knows the function that the
// value holds when the drop runs.
struct in1 {
    i32 mut* own p;
}

fn noop(i32 v) void {
}

fn (i32) void HOOK = noop;

fn hooked(in1 mut x) void {
    del(x.p);
    HOOK(1);
}

fn main() i32 {
    in1 mut@ own s = new(in1, 2);
    del(s, hooked); //! error: cannot drop the elements with 'hooked': it is not release-only
    return 0;
}
