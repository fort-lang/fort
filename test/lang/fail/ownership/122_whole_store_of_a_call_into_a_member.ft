//! fail
// The destination `o.h` is a member of the local `o`, and the call takes the address of that
// member, so the call can store an owner into `o.h.p` before the store writes `o.h`.
struct holder {
    u8 mut* own p;
    u64 n;
}

fn fill(holder mut* h) void {
    del(h->p);
    h->p = new(u8);
}

fn f(holder mut* q) holder {
    fill(q);
    return holder{null, 1};
}

struct outer {
    holder h;
    u64 k;
}

fn main() i32 {
    outer mut o = outer{holder{null, 0}, 0};
    o.h = f(&o.h); //! error: overwriting owned value: cannot prove 'o.h.p' is empty here
    del(o.h.p);
    return 0;
}
