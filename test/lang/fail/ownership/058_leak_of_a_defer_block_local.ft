//! fail
// D17.14: The deferred block allocates b and leaves it live at its storage end.
// The existing diagnostic directives remain deferred proof evidence.
fn main() i32 {
    i32 mut* own a = new(i32);
    defer {
        i32 mut* own b = new(i32);
        del(a);
    } //! error: 'b' still owns its value at the end of its scope
    return 0;
}
