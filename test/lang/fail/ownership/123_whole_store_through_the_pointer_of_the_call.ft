//! fail
// The destination `*q` lies behind the parameter `q`, and the call `f(q)` takes that pointer, so
// the call can store an owner into `q->p` before the store writes `*q`. No fact holds `q->p`
// at the entry, but the error comes from the operand: the store is no line of
// `--whole-store-report`.
struct holder {
    u8 mut* own p;
    u64 n;
}

fn fill(holder mut* h) void {
    del(h->p);
    h->p = new(u8);
}

fn f(holder mut* q) holder {
    fill(q);
    return holder{null, 1};
}

fn g(holder mut* q) void {
    *q = f(q); //! error: overwriting owned value: cannot prove '(*q).p' is empty here
}

fn main() i32 {
    holder mut h = holder{null, 0};
    g(&h);
    del(h.p);
    return 0;
}
