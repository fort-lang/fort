//! fail
// The same store with a `move` and no `regrow`: the span would hold its own owner in its first
// element, and no place would name it. The `move` of `top` ends the fact of each place that the
// span `top` owned (`spec/fir.md` 11, the kill at a vacate).
struct row {
    row mut@ own sub;
    u64 tag;
}

fn row_drop(row mut r) void {
    del(r.sub, row_drop);
}

fn main() i32 {
    row mut@ own mut top = new(row, 1);
    row mut@ own first = move(top[0].sub);
    top[0].sub = move(top); //! error: cannot prove 'top[0].sub' is empty here
    row mut@ own rest = move(top);
    del(first, row_drop);
    del(rest, row_drop);
    return 0;
}
