//! fail
// The overwrite rule of D17.11 guards every store into an lvalue of `own`
// reference type, an owning span reached through a field included. In `fill`
// the entry value of `v->data` is unknown, because `v` is a parameter, so the
// store of line 17 is an error at its `=`, column 13, in every build mode. A
// checked build of the same program trapped at run time at that position, on
// the third call, before the rule became static. run/ownership/020 deletes the
// field first, and so does the example of D17.11 for an `int_buf mut*`.
// test/overwrite_oracle_test.py holds the position in every mode.

struct vec {
    i32 mut@ own data;
    u64 len;
}

fn fill(vec mut* v, u64 n) void {
    v->data = new(i32, n); //! error: cannot prove 'v->data' is empty here
    v->len = n;
    for (u64 mut i = 0; i < n; i++) {
        v->data[i] = cast(i * 2, i32);
    }
}

// A read through a pointer: the owner is no local owner here (D17.21).
fn at(vec* v, u64 i) i32 {
    return v->data[i];
}

fn main() i32 {
    vec mut v = {};
    fill(&v, 2);
    println(v.len, " ", at(&v, 1) * 2);
    del(v.data);
    fill(&v, 3);
    println(v.len, " ", at(&v, 2) * 2);
    fill(&v, 4);
    println("never");
    return 0;
}
