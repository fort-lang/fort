//! fail
// The arms of `?:` lend, so an `own` rvalue arm has no owner left (D17.4,
// D17.8). The conditional yields `own` only when both arms are `own` rvalues
// or `null`, and that value must then land in an `own` place like any other
// owning temporary.
struct node {
    i32 v;
}

fn void use(node* n) {
    return;
}

fn i32 main() {
    bool flag = true;
    use(flag ? new(node) : new(node)); //! error: owning temporary would leak
    node mut* own a = new(node);
    node mut* b = flag ? a : new(node); //! error: the other arm does not own
    del(a);
    return 0;
}
