//! fail
// `&x` takes the address of `x`, and `*&x` is a place through that address. No gen rule of D17.11
// makes such a place empty, so a store into it is an error, though `del(x)` emptied `x`. A field
// behaves the same: `*&c.o` of a `cell{}` is no tracked place, though `c.o` is empty.
struct cell {
    i32 mut* own o;
    i32* v;
}

fn through_local() void {
    i32 mut* own mut x = new(i32);
    del(x);
    *&x = null; //! error: cannot prove '*&x' is empty here
}

fn through_field() void {
    cell mut c = cell{};
    *&c.o = null; //! error: cannot prove '*&c.o' is empty here
}

fn main() i32 {
    through_local();
    through_field();
    return 0;
}
