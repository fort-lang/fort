//! fail
// D17.14: The false c path in leaky retains a. main calls that path.
// The existing diagnostic directives remain deferred proof evidence.
fn drop(i32 mut* own p) void {
    del(p);
}

fn leaky(bool c) void {
    i32 mut* own a = new(i32);
    defer {
        if (c) {
            defer drop(move(a)); //! error: conditional release of 'a' inside a deferred statement
        }
    }
}

fn main() i32 {
    leaky(false);
    return 0;
}
