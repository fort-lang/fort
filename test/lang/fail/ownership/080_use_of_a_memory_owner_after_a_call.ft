//! fail
// A memory owner is an owner in a local whose address the function takes. The analysis reads no
// other function, so a call can vacate each memory owner, and a later read of the owner is an
// error with the note at the call (D17.21, item 2). In `late` the address of `x` is taken only
// after the use, and in `lent` the call takes it. `owner_first` makes its calls through a function
// that takes the address of the owner, where the owner is no local owner (X2), so it passes.
fn note() void {
}

fn look(i32 mut* own mut* p) void {
}

fn set(i32 mut* own mut* p) void {
    note();
    **p = 3;
}

fn late() void {
    i32 mut* own mut x = new(i32);
    note();
    *x = 1; //! error: use after move or del: 'x' can be vacated here
    look(&x);
    del(x);
}

fn lent() void {
    i32 mut* own mut x = new(i32);
    look(&x);
    *x = 2; //! error: use after move or del: 'x' can be vacated here
    del(x);
}

fn owner_first() void {
    i32 mut* own mut x = new(i32);
    set(&x);
    del(x);
}

fn main() i32 {
    late();
    lent();
    owner_first();
    return 0;
}
