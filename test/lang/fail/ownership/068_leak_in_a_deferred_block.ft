//! fail
// A deferred block expands at each exit of its scope, and each expansion ends the scope of `m` at
// the closing brace of the deferred block (D17.20). `deferred` has two exits, the `return` and the
// end of the body, so `m` leaks at two expansions of one location. The error stands once, at that
// brace.
fn deferred(bool c) void {
    defer {
        i32 mut* own m = new(i32);
        *m = 1;
    } //! error: cannot prove 'm' is empty at this exit
    if (c) {
        return;
    }
}

fn main() i32 {
    deferred(true);
    deferred(false);
    return 0;
}
