//! fail
// A `del(s, d)` in the body of a range loop gives no report at the drop `d` when the span operand
// `s` gives a report (D17.10). A `move` of the collection is one report at the collection. A call
// that makes the span is one report at the call. The golden holds the count of the reports.
fn drop_ptr(i32 mut* own p) void {
    del(p);
}

fn fresh() i32 mut* own mut@ own {
    i32 mut* own mut@ own s = new(i32 mut* own, 2);
    return s;
}

fn moved(i32 mut* own mut@ own s) void {
    for (i32 mut* e : s) {
        del(move(s), drop_ptr); //! error: cannot change collection storage
    }
    del(s, drop_ptr);
}

fn called(i32 mut* own mut@ own s) void {
    for (i32 mut* e : s) {
        del(fresh(), drop_ptr); //! error: cannot prove call preserves collection storage
    }
    del(s, drop_ptr);
}

fn main() i32 {
    moved(fresh());
    called(fresh());
    return 0;
}
