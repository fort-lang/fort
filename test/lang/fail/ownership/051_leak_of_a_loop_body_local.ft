//! fail
// D17.14: The first loop-body storage end loses p.
// The existing diagnostic directives remain deferred proof evidence.
fn main() i32 {
    i32 mut count = 0;
    while (count < 3) {
        i32 mut* own p = new(i32);
        *p = count;
        count += 1;
    } //! error: 'p' still owns its value at the end of its scope
    return count;
}
