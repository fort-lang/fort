//! fail
// The loan of a range loop refuses `del(s, d)` of a span parameter in the body (D17.10), also in
// a `while` of the body, which the loop of the range holds.
fn drop_ptr(i32 mut* own p) void {
    del(p);
}

fn once(i32 mut* own mut@ own s) void {
    for (i32 mut* e : s) { del(s, drop_ptr); } //! error: cannot change collection storage
    del(s, drop_ptr);
}

fn nested(i32 mut* own mut@ own s) void {
    for (i32 mut* e : s) {
        while (s.len != 0) {
            del(s, drop_ptr); //! error: cannot change collection storage
        }
    }
    del(s, drop_ptr);
}

fn main() i32 {
    once(new(i32 mut* own, 2));
    nested(new(i32 mut* own, 2));
    return 0;
}
