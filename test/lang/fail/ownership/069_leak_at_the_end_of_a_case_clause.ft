//! fail
// A `case` clause has no closing brace, so the scope of a local of the clause ends at the last
// token of the clause (D17.20, spec/fir.md 9.5). The clause of `1` ends at the `;` of its
// declaration, and the clause of `3` at the closing brace of its inner block, so each error stands
// there. A `break` leaves the clause of `2`, so its error stands at the `break`, and the `del`
// empties `m` at the end of that clause. The clause of `4` frees its local, so its end is no error.
fn pick(i32 k) void {
    switch (k) {
    case 1:
        i32 mut* own n = new(i32); //! error: cannot prove 'n' is empty at this exit
    case 2:
        i32 mut* own m = new(i32);
        if (k == 2) {
            break; //! error: cannot prove 'm' is empty at this exit
        }
        del(m);
    case 3:
        i32 mut* own q = new(i32);
        {
            *q = 1;
        } //! error: cannot prove 'q' is empty at this exit
    case 4:
        i32 mut* own r = new(i32);
        del(r);
    default:
    }
}

fn main() i32 {
    pick(1);
    return 0;
}
