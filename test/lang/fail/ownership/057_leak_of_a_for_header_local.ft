//! fail
// D17.14: The for-header p retains its allocation when the loop scope ends.
// The existing diagnostic directives remain deferred proof evidence.
fn main() i32 {
    for (i32 mut* own p = new(i32); *p < 2; *p += 1) {
        println(*p);
    } //! error: 'p' still owns its value at the end of its scope
    return 0;
}
