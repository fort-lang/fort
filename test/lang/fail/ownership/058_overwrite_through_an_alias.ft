//! fail
// Another pointer can hold the value of `p`, so a store through `q` kills each fact through `p`
// (D17.11, kill rule 3). After `q->g = 0`, the store into `p->f` is an error, though the `del`
// emptied the field. In `fill` no store stands between the `del` and the store, which passes.
struct node {
    i32 v;
}

struct pair {
    node mut* own f;
    i32 g;
}

fn after_alias(pair mut* p, pair mut* q) void {
    del(p->f);
    q->g = 0;
    p->f = new(node); //! error: cannot prove 'p->f' is empty here
}

fn fill(pair mut* p, pair mut* q) void {
    del(p->f);
    p->f = new(node);
    q->g = 0;
}

fn main() i32 {
    return 0;
}
