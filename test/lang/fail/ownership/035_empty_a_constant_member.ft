//! fail
// A module-level constant lives in read-only memory, so neither `move` nor
// `del` may empty it or a member of it reached without an indirection
// (D7.10, D17.6, D17.9).
struct box {
    i32 mut@ own data;
    i32* own[2] slots;
}

box C = {};

fn main() i32 {
    del(C.data); //! error: read-only
    i32 mut@ own taken = move(C.data); //! error: read-only
    del(C.slots[0]); //! error: read-only
    return 0;
}
