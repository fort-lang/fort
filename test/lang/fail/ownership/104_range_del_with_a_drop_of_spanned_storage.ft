//! fail
// The collection of a range loop can stand in an element of a span. `del(s, d)` of that span
// frees the storage that contains the collection, so the loan refuses it in the body (D17.10).
struct holder {
    i32 mut* own mut@ own items;
}

fn drop_ptr(i32 mut* own p) void {
    del(p);
}

fn drop_pair(i32 mut* own[2] mut pair) void {
    del(pair[0]);
    del(pair[1]);
}

fn drop_holder(holder mut h) void {
    del(h.items, drop_ptr);
}

fn arrays(i32 mut* own[2] mut@ own many, u64 k) void {
    for (i32 mut* e : many[k]) { del(many, drop_pair); } //! error: cannot change collection storage
    del(many, drop_pair);
}

fn fields(holder mut@ own many, u64 k) void {
    for (i32 mut* e : many[k].items) {
        del(many, drop_holder); //! error: cannot change collection storage
    }
    del(many, drop_holder);
}

fn main() i32 {
    arrays(new(i32 mut* own[2], 2), 1);
    fields(new(holder, 2), 1);
    return 0;
}
