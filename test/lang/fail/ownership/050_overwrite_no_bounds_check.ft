//! fail
//! flags: --no-bounds-check
// `--no-bounds-check` removes exactly the index and span branches (D10.6), and
// the overwrite rule of D17.11 holds in every build mode. `p` holds the result
// of make(1) at the store of line 20, and nothing deletes or moves it first, so
// the store is an error at its `=`. 051 and 052 give the same error for the
// same store in a checked and in a release build. A build with this flag
// trapped at run time at that position before the rule became static.
// run/modes/008 holds the same program with a `del` before the store.
// test/overwrite_oracle_test.py holds the position in every mode.
fn make(i32 v) i32 mut* own {
    i32 mut* own p = new(i32);
    *p = v;
    return p;
}

fn main() i32 {
    i32 mut* own mut p = make(1);
    println(*p);
    p = make(2); //! error: cannot prove 'p' is empty here
    del(p);
    return 0;
}
