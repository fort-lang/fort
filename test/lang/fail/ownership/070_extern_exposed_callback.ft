//! fail
//! flags: --ownership-check
//! error-any: ownership proof is incomplete
//! error-any: cannot prove the call and heap obligations here
// D17.13, D17.18: a cast to `void*` erases the identity of `cb`, and the extern `expose` can keep
// the address. Foreign code can then call `cb` with any pointer. No fort caller binds the
// requirement of the read through `p`, so that read is incomplete proof. Test 071 is the same
// program without the call of `expose`, and its read proves.
extern fn expose(void* p) void;

fn cb(i32* p) i32 {
    return *p; //! error: cannot prove the call and heap obligations here
}

fn main() i32 {
    expose(cast(cb, void*));
    i32 x = 4;
    return cb(&x) - 4;
}
