//! fail
// A call through a function value reads its callee operand. `p->cb(1)` reads `p` after the
// `move`, so the read is a use of a vacated owner (D17.6, D17.21).
struct obj {
    fn(i32) i32 cb;
}

fn twice(i32 x) i32 {
    return x * 2;
}

fn main() i32 {
    obj mut* own p = new(obj);
    p->cb = twice;
    obj mut* own q = move(p);
    i32 r = p->cb(1); //! error: use after move or del: 'p' can be vacated here
    del(q);
    return r;
}
