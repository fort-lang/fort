//! fail
// A store over an own reference that holds a live allocation would leak that
// allocation, so it is a compile error in a checked build (D17.11). `p` holds
// the result of make(1) at the store of line 22, and nothing deletes or moves
// it first. The error stands at the `=` token, column 7. The proof reads the
// store after its right-hand side, so the call of make(2) cannot empty `p`.
// A checked build of the same program trapped at run time at that position
// before the rule became static. 052 gives the same error in a release build.
// run/ownership/012 holds the same program with a `del` before the store.
// test/overwrite_oracle_test.py holds the position in every mode.

fn make(i32 v) i32 mut* own {
    i32 mut* own p = new(i32);
    *p = v;
    println("making ", v);
    return p;
}

fn main() i32 {
    i32 mut* own mut p = make(1);
    println("before ", *p);
    p = make(2); //! error: cannot prove 'p' is empty here
    println("after ", *p);
    del(p);
    return 0;
}
