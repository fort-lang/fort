//! fail
//! flags: --release
// A release build gives the error of 051 for the same store (D11.1, D17.11):
// both build modes give one verdict. Before the rule became static, a release
// build stored over the live value with no check and leaked it.
// run/ownership/013 holds the same store after a `move` out of `p`.
// test/overwrite_oracle_test.py holds the position in every mode.
// The error stands at the `=` token of line 20, column 7.

fn make(i32 v) i32 mut* own {
    i32 mut* own p = new(i32);
    *p = v;
    println("making ", v);
    return p;
}

fn main() i32 {
    i32 mut* own mut p = make(1);
    println("before ", *p);
    p = make(2); //! error: cannot prove 'p' is empty here
    println("after ", *p);
    del(p);
    return 0;
}
