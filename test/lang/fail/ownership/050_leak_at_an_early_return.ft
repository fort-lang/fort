//! fail
// D17.14: The early normal return loses a.
// The existing diagnostic directives remain deferred proof evidence.
fn pick(bool c) i32 {
    i32 mut* own a = new(i32);
    if (c) {
        return 1; //! error: 'a' still owns its value at the end of its scope
    }
    del(a);
    return 0;
}

fn main() i32 {
    return pick(true);
}
