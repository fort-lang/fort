//! fail
// An earlier pass of the loop takes the address of `x`, and no callee gets it. Each pass can use
// the same storage for `x`, and the `dead` of `x` ends no address. So the call before the
// declaration of the next pass kills the fact that `x` is empty (kill rule 5 of D17.11,
// `spec/fir.md` 11, Fresh). No run of `main` stores over an owner, but the rule takes the reading
// that rejects more. The swap of form 1 compiles in a loop: see `swapped`.
fn make() u8 mut* own {
    return new(u8);
}

fn swapped() void {
    u8 mut* own mut x = null;
    u8 mut* own* at = &x;
    for (u64 mut i = 0; i < 2; i++) {
        u8 mut* own nv = make();
        del(x);
        x = move(nv);
    }
    del(x);
}

fn main() i32 {
    for (u64 mut i = 0; i < 2; i++) {
        u8 mut* own mut x = make(); //! error: overwriting owned value
        u8 mut* own* at = &x;
        del(x);
    }
    swapped();
    return 0;
}
