//! fail
// A whole store of a literal with a `new` through the fresh pointer `p` goes through an address
// that the lowering holds, so it makes no member empty (D17.11 gen rule 7): the `new` of the
// literal is a writer. The store into `p->b` after it is an error. run/ownership/079 stores the
// same literal into a local and passes.
struct pair {
    u8 mut* own a;
    u8 mut* own b;
}

fn main() i32 {
    pair mut* own p = new(pair);
    *p = pair{.a = new(u8)};
    p->b = new(u8); //! error: cannot prove 'p->b' is empty here
    del(p->a);
    del(p->b);
    del(p);
    return 0;
}
