//! fail
// `return x` is an implicit `move` only when `x` names a local or a parameter
// outright (D17.5, D17.7). Any other owning lvalue is written `move`, without
// which the caller and the container would both believe they own it and both
// free it.
struct vec {
    i32 mut@ own data;
}

struct node {
    i32 value;
    node mut* own next;
}

fn steal_field(vec mut* v) i32 mut@ own {
    return v->data; //! error: move
}

fn steal_element(node mut* own mut@ slots) node mut* own {
    return slots[0]; //! error: move
}

fn steal_through_a_pointer(node mut* own mut* p) node mut* own {
    return *p; //! error: move
}

fn take_field(vec mut* v) i32 mut@ own {
    return move(v->data); // the transfer written out is fine
}

fn main() i32 {
    vec mut v = {};
    v.data = new(i32, 2);
    del(take_field(&v));
    return 0;
}
