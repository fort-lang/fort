//! fail
// A store of the address of `x` into a global exposes `x` with no call (D17.11, Borrows): the copy
// of `P` borrows `exposed`, and the store through `p` can write `x`, so the store into `x` after it
// is an error. run/ownership/072 stores through an `own` pointer and passes.
i32 mut* own mut* mut P = null;

fn main() i32 {
    i32 mut* own mut x = null;
    P = &x;
    i32 mut* own mut* p = P;
    del(*p);
    *p = new(i32);
    x = new(i32); //! error: cannot prove 'x' is empty here
    del(x);
    P = null;
    return 0;
}
