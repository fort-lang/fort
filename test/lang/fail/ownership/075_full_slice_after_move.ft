//! fail
//! flags: --ownership-check
//! error-any: ownership proof is incomplete
//! error-any: cannot prove the call and heap obligations here
// D17.14, D17.18: each body moves the owner out of `s->heap` and then takes the full slice
// `s->heap[..]`. The slice reads `s->heap` after the move. The summary does not check that the
// reference which the slice reads is still live, so it stops at the slice. The call and heap row
// reports that stop at the `[` of each slice.
struct heap_store { u64 mut@ own heap; }

fn full_after_move(heap_store mut* s) u64 {
    u64 mut@ own h = move(s->heap);
    u64 mut@ v = s->heap[..]; //! error: cannot prove the call and heap obligations here
    del(h);
    return v[0];
}

fn ptr_after_move(heap_store mut* s) u64 {
    u64 mut@ own h = move(s->heap);
    u64 mut@ v = s->heap[..]; //! error: cannot prove the call and heap obligations here
    u64 mut* p = v.ptr;
    del(h);
    return *p;
}

fn main() i32 { return 0; }
