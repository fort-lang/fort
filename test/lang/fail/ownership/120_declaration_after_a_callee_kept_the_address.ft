//! fail
// An earlier pass of the loop gives the address of `x` to `keep`. In the next pass, `fill` can
// store an owner through that address before the declaration of `x` stores over it. Each pass
// can use the same storage for `x`, so the `dead` of `x` ends no address. An address that a path
// to the call took kills the fact that `x` is empty (kill rule 5 of D17.11, `spec/fir.md` 11,
// Fresh).
u8 mut* own mut* mut KEPT = null;

fn keep(u8 mut* own mut* p) void {
    KEPT = p;
}

fn fill() u8 mut* own {
    u8 mut* own mut* k = KEPT;
    if (k != null) {
        del(*k);
        *k = new(u8);
    }
    return new(u8);
}

fn main() i32 {
    for (u64 mut i = 0; i < 2; i++) {
        u8 mut* own mut x = fill(); //! error: overwriting owned value
        u8 mut* own mut* at = &x;
        keep(at);
        del(x);
    }
    return 0;
}
