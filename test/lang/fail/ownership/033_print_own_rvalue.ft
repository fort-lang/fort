//! fail
// A printed argument has no `own` place to land in, so an owning rvalue passed
// to the print family would leak (D4.5, D17.8).
fn dup(string s) string own {
    u8 mut@ own buf = new(u8, s.len);
    for (u64 mut i = 0; i < s.len; i++) {
        buf[i] = cast(s[i], u8);
    }
    return cast(move(buf), string own);
}

fn main() i32 {
    println(dup("abc")); //! error: owning temporary
    return 0;
}
