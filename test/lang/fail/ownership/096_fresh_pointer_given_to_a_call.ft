//! fail
// A call that gets the fresh pointer `p` can fill `p->data`: the operand ends the freshness of `p`
// before the kill of the call (D17.11 kill rule 5), so the store after the call is an error. A
// run would lose the allocation that `fill_into` stores. run/ownership/078 calls with no operand
// of its fresh pointer and passes.
struct box {
    u8 mut* own data;
}

fn fill_into(box mut* q) void {
    del(q->data);
    q->data = new(u8);
}

fn main() i32 {
    box mut* own p = new(box);
    fill_into(p);
    p->data = new(u8); //! error: cannot prove 'p->data' is empty here
    del(p->data);
    del(p);
    return 0;
}
