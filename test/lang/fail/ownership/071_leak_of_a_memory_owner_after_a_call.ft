//! fail
// A memory owner is an owner local whose address the function takes. A call can change the owner
// through that address, so the analysis knows nothing of the owner after a call (D17.11, kill
// rule 5), and an exit after a call is an error (D17.20). In `late`, `del(n)` empties `n`, but the
// call of `note` after it ends that fact, so the closing brace of the body is an error. In
// `first`, the deferred `del` runs after the last call, so the brace is no error.
fn touch(i32 mut* own mut* p) void {
}

fn note() void {
}

fn late() void {
    i32 mut* own mut n = new(i32);
    touch(&n);
    del(n);
    note();
} //! error: cannot prove 'n' is empty at this exit

fn first() void {
    i32 mut* own mut n = new(i32);
    defer del(n);
    touch(&n);
    note();
}

fn main() i32 {
    late();
    first();
    return 0;
}
