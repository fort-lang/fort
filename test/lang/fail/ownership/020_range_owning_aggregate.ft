//! fail
struct Buf {
    own mut u8[] data;
}

fn i32 main() {
    mut Buf[2] bufs = {};
    bufs[0].data = new(u8[1]);
    mut u64 total = 0;
    for (Buf b : bufs) { //! error: own
        total += b.data.len;
    }
    for (mut u64 i = 0; i < bufs.len; i++) {
        del(bufs[i].data);
    }
    return cast(total, i32);
}
