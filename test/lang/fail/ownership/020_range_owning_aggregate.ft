//! fail
struct buf {
    u8 mut@ own data;
}

fn main() i32 {
    buf[2] mut bufs = {};
    bufs[0].data = new(u8, 1);
    u64 mut total = 0;
    for (buf b : bufs) { //! error: own
        total += b.data.len;
    }
    for (u64 mut i = 0; i < bufs.len; i++) {
        del(bufs[i].data);
    }
    return cast(total, i32);
}
