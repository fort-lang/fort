//! fail
// The whole store `*p = move(b)` goes through an address that the lowering holds, so it is no
// store through the fresh pointer `p`: it kills as a store through another pointer (D17.11 kill
// rule 2). The fact that `del(q->data)` makes is false after it, and the store into `q->data` is
// an error.
struct box {
    u8 mut* own data;
}

fn fill() box {
    box mut b = box{};
    b.data = new(u8);
    return b;
}

fn refill(box mut* q) void {
    box mut* own p = new(box);
    box mut b = fill();
    del(q->data);
    *p = move(b);
    q->data = new(u8); //! error: cannot prove 'q->data' is empty here
    del(p->data);
    del(p);
}

fn main() i32 {
    box mut* own q = new(box);
    refill(q);
    del(q->data);
    del(q);
    return 0;
}
