//! fail
fn own string dup(string s) {
    own mut u8[] buf = new(u8[s.len]);
    for (mut u64 i = 0; i < s.len; i++) {
        buf[i] = cast(s[i], u8);
    }
    return cast(move(buf), own string);
}

fn i32 main() {
    string lit = "abc";
    del(lit); //! error: own
    own string d = dup(lit);
    string view = d;
    del(view); //! error: own
    del(d[1..]); //! error: own
    del(d);
    return 0;
}
