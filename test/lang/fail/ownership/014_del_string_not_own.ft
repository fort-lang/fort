//! fail
fn dup(string s) string own {
    u8 mut@ own buf = new(u8, s.len);
    for (u64 mut i = 0; i < s.len; i++) {
        buf[i] = cast(s[i], u8);
    }
    return cast(move(buf), string own);
}

fn main() i32 {
    string lit = "abc";
    del(lit); //! error: own
    string own d = dup(lit);
    string view = d;
    del(view); //! error: own
    del(d[1..]); //! error: own
    del(d);
    return 0;
}
