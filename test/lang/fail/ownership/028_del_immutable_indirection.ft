//! fail
// `del` empties its operand under the rules of `move`, so the level it stores
// into must be mutable (D17.6, D17.9).
struct node {
    i32 value;
    node mut* own next;
}

fn void drop_slot(node mut* own@ view) {
    del(view[0]); //! error: immutable
}

fn void drop_field(node* n) {
    del(n->next); //! error: immutable
}

fn i32 main() {
    node mut* own head = new(node);
    del(head);
    return 0;
}
