//! fail
// D17.9: The second condition passes empty p to take. The *p read is invalid.
// The existing diagnostic directives remain deferred proof evidence.
fn take(i32 mut* own p) i32 {
    i32 v = *p;
    del(p);
    return v;
}

fn main() i32 {
    i32 mut* own p = new(i32);
    *p = 1;
    for (i32 mut i = 0; take(move(p)) == 1; i += 1) {
        println("iteration ", i);
    } //! error: 'p' is empty on one path through the loop and live on another
    println("done");
    return 0;
}
