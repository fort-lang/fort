//! fail
// The destination lies in the object of the pointer that the right side moves. The store would
// make the object own itself, and no place would name it (`spec/fir.md` 11, the kill at a vacate).
struct node {
    node mut* own next;
    u64 tag;
}

fn main() i32 {
    node mut* own mut p = new(node);
    p->next = move(p); //! error: cannot prove 'p->next' is empty here
    // No place names the object after the store. An exit into an abort has no obligation of
    // the leak rule (D17.20), so no `del` follows.
    panic("no place names the object");
}
