//! fail
// Ownership at a second aggregate level (D17): an owning element is emptied
// by `move` and by `del` alone, a row of an owning span is a value that owns
// nothing, and an element of a module-level constant is read-only storage
// (D17.6, D17.9).
i32 mut@ own[2] OWNERS = {};

fn i32 mut@ own take(i32 mut@ own[2] mut owners) {
    return owners[0]; //! error: copying an owning value requires 'move'
}

fn i32 main() {
    i32 n = 3;
    i32[3] mut@ own g = new(i32[3], n);
    del(g[1]); //! error: 'del' takes a reference, not i32[3]
    i32 mut@ own[2] mut owners = {};
    owners[0] = new(i32, n);
    i32 mut@ mut lent = owners[0];
    del(lent); //! error: 'del' needs an owning operand, not i32 mut@
    i32 mut@ own moved = move(OWNERS[0]); //! error: 'move' cannot empty a module-level constant
    del(owners[0]);
    del(g);
    del(moved);
    return 0;
}
