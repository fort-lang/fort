//! fail
//! flags: --fir
// `--fir` gives the error of rule (b), exits 1 and writes no FIR, as a build does (D17.21,
// spec/fir.md 11). The harness compiles this test with `--fir`, so the test holds the status of
// `--fir`. The program has no error of D17.11 and no leak, so only rule (b) can give that status.
// The `--check` runs of `run_tests.py --check-json` leave `--fir` out, because it does not combine
// with `--check`.
fn deleted() void {
    i32 mut* own mut p = new(i32);
    del(p);
    i32 v = *p; //! error: use after move or del: 'p' can be vacated here
}

fn main() i32 {
    deleted();
    return 0;
}
