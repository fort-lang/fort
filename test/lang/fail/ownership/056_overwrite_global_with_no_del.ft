//! fail
// A global has no fact at the entry of a function, so a store into it needs a gen rule first
// (D17.11): `del(g); g = move(x);` passes, and `g = move(x);` alone is an error. `keep` stores
// with no `del`, and `swap` deletes the global first.
struct node {
    i32 v;
}

node mut* own mut G = null;

fn keep(node mut* own x) void {
    G = move(x); //! error: cannot prove 'G' is empty here
}

fn swap(node mut* own x) void {
    del(G);
    G = move(x);
}

fn main() i32 {
    return 0;
}
