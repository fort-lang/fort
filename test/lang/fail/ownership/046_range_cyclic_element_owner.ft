//! fail
// The element owns the object that contains the collection (D17.10).
struct holder {
    holder mut* own[2] items;
}
fn main() i32 {
    holder mut* own mut h = new(holder);
    holder mut* p = h;
    h->items[0] = move(h);
    for (holder mut* x : p->items) {
        del(p->items[0]); //! error: cannot prove ownership operation preserves collection storage
    }
    return 0;
}
