//! fail
// A `return` ends the scope of each local of the function, and each `own` parameter must hold
// the zero value there too (D17.20). In `early`, the `return` leaves the local `n` and the
// parameter `p` with their allocations, so the `return` takes two errors: the local first, then
// the parameter. The end of the body of `falls_off` is a `return` at its closing brace, and `q`
// still holds its allocation there. `freed` empties its parameter on each path, with a `move` or
// with a `del`.
fn take(i32 mut* own p) void {
    del(p);
}

fn early(bool c, i32 mut* own p) void {
    i32 mut* own n = new(i32);
    if (c) {
        return; //! error: cannot prove 'n' is empty at this exit
    }
    del(n);
    del(p);
}

fn falls_off(i32 mut* own q) void {
    *q = 1;
} //! error: cannot prove 'q' is empty at this exit

fn freed(bool c, i32 mut* own p) void {
    if (c) {
        take(move(p));
        return;
    }
    del(p);
}

fn main() i32 {
    early(false, new(i32));
    falls_off(new(i32));
    freed(true, new(i32));
    return 0;
}
