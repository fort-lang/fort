//! fail
// A store of `null` into an `own` reference is a store too, and it needs the proof of D17.11:
// the allocation that the destination holds would leak. `p` holds a live allocation at the
// store of `null`, so the store is an error at its `=`. `cleared` deletes `p` first, and its
// store of `null` passes.
fn kept() void {
    i32 mut* own mut p = new(i32);
    *p = 1;
    p = null; //! error: cannot prove 'p' is empty here
}

fn cleared() void {
    i32 mut* own mut p = new(i32);
    del(p);
    p = null;
}

fn main() i32 {
    return 0;
}
