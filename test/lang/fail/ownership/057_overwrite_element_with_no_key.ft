//! fail
// An index projection is keyed when its index is a constant or a local that is not memory
// (D17.11). `v->items[v->len]` has no key, so its store is an error after the `del` of the same
// element: two indexes with no key can differ. `put_keyed` copies the index into the local `k`
// first, and the element of the `del` and the element of the store both have the key `k`.
struct node {
    i32 v;
}

struct node_vec {
    node mut* own mut@ own items;
    u64 len;
}

fn put(node_vec mut* v, node mut* own n) void {
    del(v->items[v->len]);
    v->items[v->len] = move(n); //! error: cannot prove 'v->items[v->len]' is empty here
}

fn put_keyed(node_vec mut* v, node mut* own n) void {
    u64 k = v->len;
    del(v->items[k]);
    v->items[k] = move(n);
}

fn main() i32 {
    return 0;
}
