//! fail
//! flags: --ownership-check
//! error-any: ownership proof is incomplete
//! error-any: cannot prove the call and heap obligations here
// D17.13, D17.18: the extern `register_factory` receives `factory`, so foreign code can call
// `factory` and keep the callback that it returns. The result of a foreign-called body is
// foreign-called too, so foreign code can call `cb` with any pointer. The read through `p` is
// incomplete proof. Test 071 is the twin without an extern.
extern fn register_factory(fn () fn (i32*) i32 maker) void;

fn cb(i32* p) i32 {
    return *p; //! error: cannot prove the call and heap obligations here
}

fn factory() fn (i32*) i32 {
    return cb;
}

fn main() i32 {
    register_factory(factory);
    i32 x = 4;
    return cb(&x) - 4;
}
