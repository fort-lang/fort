//! fail
//! flags: --fir
// `--fir` gives the error of the leak rule, exits 1 and writes no FIR, as a build does (D17.20,
// spec/fir.md 11). The harness compiles this test with `--fir`, so the test holds the status of
// `--fir`. The program has no error of D17.11, so only the leak rule can give that status. The
// `--check` runs of `run_tests.py --check-json` leave `--fir` out, because it does not combine
// with `--check`.
fn kept() void {
    i32 mut* own n = new(i32);
    *n = 1;
} //! error: cannot prove 'n' is empty at this exit

fn main() i32 {
    kept();
    return 0;
}
