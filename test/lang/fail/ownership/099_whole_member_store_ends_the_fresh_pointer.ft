//! fail
// The whole store `p->inner = fill()` has a call on its right side, so the lowering holds the
// address of `p->inner`. Such a store ends the freshness of `p` and kills each fact through `p`
// (D17.11 kill rule 2), so the store into `p->data` after it is an error.
struct box {
    u8 mut* own data;
}

struct holder {
    box inner;
    u8 mut* own data;
}

fn fill() box {
    box mut b = box{};
    b.data = new(u8);
    return b;
}

fn main() i32 {
    holder mut* own p = new(holder);
    p->inner = fill();
    p->data = new(u8); //! error: cannot prove 'p->data' is empty here
    del(p->inner.data);
    del(p->data);
    del(p);
    return 0;
}
