//! fail
// The loan of a range loop refuses `del(s, d)` of a global span in the body (D17.10), by its name
// and through a pointer that holds its address.
i32 mut* own mut@ own mut POOL = {};

fn drop_ptr(i32 mut* own p) void {
    del(p);
}

fn main() i32 {
    for (i32 mut* e : POOL) { del(POOL, drop_ptr); } //! error: cannot change collection storage
    i32 mut* own mut@ own mut* p = &POOL;
    for (i32 mut* e : POOL) { del(*p, drop_ptr); } //! error: cannot change collection storage
    del(POOL, drop_ptr);
    return 0;
}
