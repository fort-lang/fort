//! fail
// `del(s, d)` calls the fort function `d` for each element (D17.9). The checker does not prove
// that this call preserves the storage of the collection, so the loan of a range loop refuses the
// `del` also when `s` is an rvalue (D17.10): `drop_all` frees the global that the loop lends.
i32 mut* own mut@ own mut POOL = {};

fn drop_ptr(i32 mut* own p) void {
    del(p);
}

fn drop_all(i32 mut* own p) void {
    del(p);
    del(POOL, drop_ptr);
}

fn main() i32 {
    for (i32 mut* e : POOL) {
        del(new(i32 mut* own, 1), drop_all); //! error: cannot prove call preserves
    }
    del(POOL, drop_ptr);
    return 0;
}
