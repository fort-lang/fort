//! fail
// An exit into an abort block has no obligation, because a runtime error runs no deferred code
// (D17.20, D7.8). In `stop`, the closing brace of the inner block falls off into the block of the
// `panic`, so the brace is no error. The end of the body of the `noreturn` function `spin` is a
// trap, so `m` gives no error either. `twin` holds the block of `stop` before an `if`, so control
// can leave the function with `n` live, and its closing brace is an error. Only `twin` gives an
// error.
fn stop() void {
    {
        i32 mut* own n = new(i32);
        *n = 1;
    }
    panic("stop");
}

fn spin() noreturn {
    i32 mut* own m = new(i32);
    while (true) {
    }
}

fn twin(bool c) void {
    {
        i32 mut* own n = new(i32);
        *n = 1;
    } //! error: cannot prove 'n' is empty at this exit
    if (c) {
        panic("stop");
    }
}

fn main() i32 {
    twin(false);
    return 0;
}
