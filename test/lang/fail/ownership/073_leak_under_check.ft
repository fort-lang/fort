//! fail
//! flags: --check
// `--check` gives the error of the leak rule and exits 1, as a build does (D17.20, D20.1). The
// harness compiles this test with `--check`, so the test holds the status of `--check`. The
// program has no error of D17.11, so only the leak rule can give that status.
fn kept() void {
    i32 mut* own n = new(i32);
    *n = 1;
} //! error: cannot prove 'n' is empty at this exit

fn main() i32 {
    kept();
    return 0;
}
