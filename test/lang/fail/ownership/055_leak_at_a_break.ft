//! fail
// D17.14: The break ends s storage with its allocation live.
// The existing diagnostic directives remain deferred proof evidence.
fn main() i32 {
    while (true) {
        u8 mut@ own s = new(u8, 2);
        println(s.len);
        break; //! error: 's' still owns its value at the end of its scope
    }
    return 0;
}
