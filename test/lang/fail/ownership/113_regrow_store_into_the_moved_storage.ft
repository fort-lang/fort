//! fail
// The destination is an owner of an element of the span that the right side regrows. D6.3
// computes the address of the element first, and `regrow` can release that storage. The `move`
// of `top` ends the fact of each place that the span `top` owned (`spec/fir.md` 11, Kill; D12.2).
struct row {
    row mut@ own sub;
    u64 tag;
}

fn row_drop(row mut r) void {
    del(r.sub, row_drop);
}

fn main() i32 {
    row mut@ own mut top = new(row, 1);
    row mut@ own first = move(top[0].sub);
    top[0].sub = regrow(move(top), 2); //! error: cannot prove 'top[0].sub' is empty here
    row mut@ own rest = move(top);
    del(first, row_drop);
    del(rest, row_drop);
    return 0;
}
