//! fail
//! flags: --ownership-check
//! error-any: ownership proof is incomplete
// D17.19: a call of extern exit is the final normal-exit boundary. Each owner of the frame and
// each owning global must be empty there. `p` holds an allocation on each path to the call, and
// no call of std.rt.shutdown empties args_store first. A second store into an owning global
// loses the allocation of the first.
import std.libc;

u8 mut@ own mut pool = {};

fn refill() void {
    del(pool);
    pool = new(u8, 1);
    pool = new(u8, 2); //! error: lost ownership of 'pool'
    del(pool);
}

fn main() i32 {
    u8 mut@ own p = new(u8, 4);
    libc.exit(3); //! error: lost ownership of 'p'
}
