//! fail
// A range loop lends its collection, and `regrow` needs a `move` of it (D12.2, D17.10).
fn main() i32 {
    i32 mut@ own mut s = new(i32, 2);
    for (i32 x : s) {
        u64 n = s.len + 1;
        s = regrow(move(s), n); //! error: cannot change collection storage during a range loop
    }
    del(s);
    return 0;
}
