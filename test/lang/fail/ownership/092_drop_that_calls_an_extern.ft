//! fail
// The drop of `del(s, d)` calls no `extern fn` (D17.9), also an extern that takes no pointer,
// because no rule reads what C does. A drop that reaches such a call through a fort function
// breaks the bit too.
import extern;

extern fn abs(i32 x) i32;

struct in1 {
    i32 mut* own p;
}

fn measured(in1 mut x) void {
    i32 n = abs(-1);
    del(x.p);
}

fn checked(i32 v) i32 {
    return abs(v);
}

fn indirect(in1 mut x) void {
    i32 n = checked(2);
    del(x.p);
}

fn main() i32 {
    in1 mut@ own s = new(in1, 2);
    del(s, measured); //! error: cannot drop the elements with 'measured': it is not release-only
    in1 mut@ own t = new(in1, 2);
    del(t, indirect); //! error: cannot drop the elements with 'indirect': it is not release-only
    return 0;
}
