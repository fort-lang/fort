//! fail
// The pointer local `q` holds the address of `h`, and the call `f(q)` passes it on: the call
// exposes `h` (D17.11, Borrows), so its operand reaches the destination of the whole store.
struct holder {
    u8 mut* own p;
    u64 n;
}

fn fill(holder mut* h) void {
    del(h->p);
    h->p = new(u8);
}

fn f(holder mut* q) holder {
    fill(q);
    return holder{null, 1};
}

fn main() i32 {
    holder mut h = holder{null, 0};
    holder mut* q = &h;
    h = f(q); //! error: overwriting owned value: cannot prove 'h.p' is empty here
    del(h.p);
    return 0;
}
