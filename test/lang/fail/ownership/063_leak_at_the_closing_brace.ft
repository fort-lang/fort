//! fail
// An `own` local must hold the zero value at the end of its scope (D17.20). The scope of `n` in
// `block` ends at the closing brace of the inner block, so the error and its note stand at that
// brace. In `two`, two owners reach the closing brace of the body, so that brace takes two
// errors, in the order of the declarations. In `kept`, the deferred `del` runs before the end of
// the scope, so the brace is no error.
fn block() void {
    {
        i32 mut* own n = new(i32);
        *n = 1;
    } //! error: cannot prove 'n' is empty at this exit
}

fn two() void {
    i32 mut* own a = new(i32);
    i32 mut* own b = new(i32);
} //! error: cannot prove 'a' is empty at this exit

fn kept() void {
    i32 mut* own n = new(i32);
    defer del(n);
    *n = 1;
}

fn main() i32 {
    block();
    two();
    kept();
    return 0;
}
