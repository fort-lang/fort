//! fail
// A cast is `own` exactly when its target says so, so an owning lvalue reaches
// an owning target only through `move` (D3.14, D17.5, D17.12).
fn i32 main() {
    u8 mut@ own buf = new(u8, 2);
    string own s = cast(buf, string own); //! error: move
    i32 mut* own p = new(i32);
    void* own v = cast(p, void* own); //! error: move
    del(p);
    del(buf);
    return 0;
}
