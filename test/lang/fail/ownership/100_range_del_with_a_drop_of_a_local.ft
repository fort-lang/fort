//! fail
// `del(s, d)` vacates and frees its span as `del(s)` does (D17.9), so the loan of a range loop
// refuses it in the body (D17.10). The same `del` after the loop is legal.
fn drop_ptr(i32 mut* own p) void {
    del(p);
}

fn main() i32 {
    i32 mut* own mut@ own s = new(i32 mut* own, 2);
    for (i32 mut* e : s) { del(s, drop_ptr); } //! error: cannot change collection storage
    del(s, drop_ptr);
    return 0;
}
