//! fail
// A store into a `string own` lvalue obeys the overwrite check of D17.11 (D17.12). `s` holds the
// string that `str.dup` returned, so the second store is an error at its `=`. In `replaced` a
// `del(s)` comes first, and the second store passes.
import std.str;

fn kept() void {
    string own mut s = str.dup("a");
    s = str.dup("b"); //! error: cannot prove 's' is empty here
    del(s);
}

fn replaced() void {
    string own mut s = str.dup("a");
    del(s);
    s = str.dup("b");
    del(s);
}

fn main() i32 {
    return 0;
}
