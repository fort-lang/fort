//! fail
// A `break` ends the scope of the loop body that it leaves (D17.20). The `break` of `leave`
// leaves `n` with its allocation, so the error and its note stand at the `break`. `freed` frees
// `n` before its `break`, so its `break` is no error.
fn leave(i32 count) void {
    for (i32 mut i = 0; i < count; i++) {
        i32 mut* own n = new(i32);
        if (i == 1) {
            break; //! error: cannot prove 'n' is empty at this exit
        }
        del(n);
    }
}

fn freed(i32 count) void {
    for (i32 mut i = 0; i < count; i++) {
        i32 mut* own n = new(i32);
        if (i == 1) {
            del(n);
            break;
        }
        del(n);
    }
}

fn main() i32 {
    leave(3);
    freed(3);
    return 0;
}
