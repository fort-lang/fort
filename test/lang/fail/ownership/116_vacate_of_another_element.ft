//! fail
// Two keys can name one element of a fixed array, so the `move` of `a[j].rows` can vacate the
// owner of the storage that `a[i].rows[0].sub` names (`spec/fir.md` 11, the kill at a vacate).
struct row {
    row mut@ own sub;
    u64 tag;
}

struct holder {
    row mut@ own rows;
    u64 n;
}

fn row_drop(row mut r) void {
    del(r.sub, row_drop);
}

fn main() i32 {
    holder[2] mut a = {};
    a[0].rows = new(row, 1);
    u64 i = 0;
    u64 j = 0;
    row mut@ own first = move(a[i].rows[0].sub);
    a[i].rows[0].sub = regrow(move(a[j].rows), 2); //! error: overwriting owned value
    del(first, row_drop);
    del(a[0].rows, row_drop);
    del(a[1].rows, row_drop);
    return 0;
}
