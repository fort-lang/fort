//! fail
// Lending strips the `own` of a reference and not the `own` a struct holds by
// value (D17.4), so an owning aggregate arm of `?:` still owns: copying it
// into the value the conditional yields is the transfer of D17.7 and is
// written `move`.
struct buf {
    u8 mut@ own data;
    u64 len;
}

fn i32 main() {
    bool flag = true;
    buf mut a = buf{new(u8, 4), 4};
    buf mut b = buf{new(u8, 2), 2};
    buf c = flag ? a : b; //! error: copying an owning value requires 'move'
    del(a.data);
    del(b.data);
    return 0;
}
