//! fail
// An earlier pass of the loop gives a slice of the inner array `a[1]` to `keep`. In the next
// pass, `fill` stores an owner through the kept span before the store over `a[1][0]`. A slice of
// an inner fixed array names the storage of `a`, as a slice of all of `a` does. So the call of
// `fill` kills the fact that `a[1][0]` is empty (kill rule 5 of D17.11, `spec/fir.md` 11, Fresh).
u8 mut* own mut@ mut KEPT = {};

fn keep(u8 mut* own mut@ s) void {
    KEPT = s;
}

fn fill() void {
    if (KEPT.len > 0) {
        del(KEPT[0]);
        KEPT[0] = new(u8);
    }
}

fn main() i32 {
    for (u64 mut i = 0; i < 2; i++) {
        u8 mut* own[2][2] mut a = {};
        fill();
        a[1][0] = new(u8); //! error: overwriting owned value
        u8 mut* own mut@ s = a[1][..];
        keep(s);
        del(a[1][0]);
        del(a[1][1]);
        del(a[0][0]);
        del(a[0][1]);
    }
    return 0;
}
