//! fail
// The result `_0` of an aggregate type is storage of the caller, and a pointer can reach it before
// the function stores into it (D17.11, Borrows). `_0` is memory, so a call can vacate each of its
// owners, and a load through a pointer after a call can read one of them (D17.21). The error names
// `_0` as the call of the function, `built()`. `filled` reads before its first call, so it passes.
struct pair {
    i32 mut* own a;
    i32 mut* own b;
}

fn note() void {
}

fn built(i32* v) pair {
    note();
    i32 w = *v; //! error: use after move or del: 'built().a' can be vacated here
    return pair{new(i32), new(i32)};
}

fn filled(i32* v) pair {
    i32 w = *v;
    note();
    return pair{new(i32), new(i32)};
}

fn main() i32 {
    i32 one = 1;
    pair p = built(&one);
    pair q = filled(&one);
    del(p.a);
    del(p.b);
    del(q.a);
    del(q.b);
    return 0;
}
