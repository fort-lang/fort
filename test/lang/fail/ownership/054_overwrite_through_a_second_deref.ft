//! fail
// A store through a pointer field can name any object: `p->next` holds the
// value of `p`, so `p->next->g` and `p->g` are one place (D17.11). A place
// behind a second deref is no tracked place, so the store of line 22 is an
// error. That store fills `p->g`, so the store of line 23 is an error too: the
// store of line 22 kills the fact that the `del` made. A checked build trapped
// at run time at 23:10 before the rule became static, and the store of line 22
// ran. test/overwrite_oracle_test.py holds both positions in every mode.

struct node {
    i32 v;
}

struct outer {
    node mut* own g;
    outer mut* next;
}

fn bad(outer mut* p) void {
    p->next = p;
    del(p->g);
    p->next->g = new(node); //! error: cannot prove 'p->next->g' is empty here
    p->g = new(node); //! error: cannot prove 'p->g' is empty here
}

fn main() i32 {
    outer mut o = {};
    println("before");
    bad(&o);
    println("never");
    del(o.g);
    return 0;
}
