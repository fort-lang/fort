//! fail
// A call between a test against null and the store kills the fact that the test made (D17.11 gen
// rule 6 and kill rule 5): `l->head` is reached through memory, so a callee can store into it.
// `fill_first` stores before the call and passes. run/ownership/069 holds the store with no call.
struct node {
    i32 value;
}

struct list {
    node mut* own head;
}

fn g() void {
}

fn fill(list mut* l) void {
    if (l->head == null) {
        g();
        l->head = new(node); //! error: cannot prove 'l->head' is empty here
    }
}

fn fill_first(list mut* l) void {
    if (l->head == null) {
        l->head = new(node);
        g();
    }
}

fn main() i32 {
    list mut l = list{};
    fill(&l);
    del(l.head);
    fill_first(&l);
    del(l.head);
    return 0;
}
