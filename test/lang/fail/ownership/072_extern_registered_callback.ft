//! fail
//! flags: --ownership-check
//! error-any: ownership proof is incomplete
//! error-any: cannot prove the call and heap obligations here
// D17.13, D17.18: the extern `register` receives `cb` as a function value, so foreign code can
// call `cb` with any pointer. A fort wrapper that passes its parameter on does not change this:
// the graph follows `cb` into `relay` and marks it at the extern call. The read through `p` is
// incomplete proof. Test 071 is the twin without an extern.
extern fn register(fn (i32*) i32 hook) void;

fn cb(i32* p) i32 {
    return *p; //! error: cannot prove the call and heap obligations here
}

fn relay(fn (i32*) i32 hook) void {
    register(hook);
}

fn main() i32 {
    relay(cb);
    i32 x = 4;
    return cb(&x) - 4;
}
