//! fail
// `del(s, d)` of a span that is not the collection is an ownership operation with no proof that
// it preserves the storage of the collection, as `del(s)` is (D17.10): an element of the freed
// span can own the object that contains the collection.
fn drop_ptr(i32 mut* own p) void {
    del(p);
}

fn main() i32 {
    i32 mut* own mut@ own s = new(i32 mut* own, 2);
    i32 mut* own mut@ own t = new(i32 mut* own, 2);
    for (i32 mut* e : s) {
        del(t, drop_ptr); //! error: cannot prove ownership operation preserves
    }
    del(t, drop_ptr);
    del(s, drop_ptr);
    return 0;
}
