//! fail
// A declaration is a store like any other, so it needs the proof of D17.11.
// The entry block zeroes the slot of an owning local once, and a loop body runs
// again. The first loop deletes its local at the end of the body, so the back
// edge joins an empty slot and the declaration passes. The second loop neither
// deletes nor moves `leaked`, so the back edge joins a live slot with the entry
// zeroing, and the declaration is an error at the declared name, column 22.
// Every build mode gives this error. A checked build of the same program
// trapped at run time at that position before the rule became static.
// test/overwrite_oracle_test.py holds the position in every mode.
fn main() i32 {
    i32 mut freed = 0;
    for (i32 mut i = 0; i < 3; i++) {
        i32 mut* own kept = new(i32);
        *kept = i;
        del(kept);
        freed += 1;
    }
    for (i32 mut i = 0; i < 3; i++) {
        i32 mut* own leaked = new(i32); //! error: cannot prove 'leaked' is empty here
        *leaked = i;
        println(*leaked);
    }
    return freed;
}
