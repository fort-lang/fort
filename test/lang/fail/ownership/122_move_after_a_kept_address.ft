//! fail
// The address of `x` goes to `keep`, then `x` moves into `consume`. `fill` then stores an owner
// into `x` through the kept address, in the same run, before the store over `x`. A `move` gives
// the value of `x` and ends no address. So the call of `fill` kills the fact that `x` is empty
// (kill rule 5 of D17.11, `spec/fir.md` 11, Fresh). The run stores over a live owner.
u8 mut* own mut* mut KEPT = null;

fn keep(u8 mut* own mut* p) void {
    KEPT = p;
}

fn fill() void {
    u8 mut* own mut* k = KEPT;
    if (k != null) {
        del(*k);
        *k = new(u8);
    }
}

fn consume(u8 mut* own p) void {
    del(p);
}

fn main() i32 {
    u8 mut* own mut x = new(u8);
    u8 mut* own mut* at = &x;
    keep(at);
    consume(move(x));
    fill();
    x = new(u8); //! error: overwriting owned value
    del(x);
    KEPT = null;
    return 0;
}
