//! fail
// The call `f(&h)` takes the address of `h`, and `f` stores an owner into `h.p` through it before
// the store of its result writes `h` (D6.3). An operand of a call of the statement reaches the
// destination of the whole store, so the store is an error of D17.11 and no line of
// `--whole-store-report`. run/ownership/088 holds the swap form, which compiles.
struct holder {
    u8 mut* own p;
    u64 n;
}

fn fill(holder mut* h) void {
    del(h->p);
    h->p = new(u8);
}

fn f(holder mut* q) holder {
    fill(q);
    return holder{null, 1};
}

fn main() i32 {
    holder mut h = holder{null, 0};
    h = f(&h); //! error: overwriting owned value: cannot prove 'h.p' is empty here
    del(h.p);
    return 0;
}
