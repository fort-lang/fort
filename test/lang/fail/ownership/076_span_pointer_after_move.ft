//! fail
//! flags: --ownership-check
//! error-any: ownership proof is incomplete
//! error-any: cannot prove the call and heap obligations here
// D17.14, D17.18: each body copies the pointer field of the caller span `s->heap`, and the span
// is moved out and released. The copy is after the move in the first body and before it in the
// second, and each body then reads through the copy. The summary does not check that the
// reference which the pointer field holds is still live, so it stops at the `.ptr` of each copy.
struct heap_store { u64 mut@ own heap; }

fn ptr_field_move(heap_store mut* s) u64 {
    u64 mut@ own h = move(s->heap);
    u64 mut* p = s->heap.ptr; //! error: cannot prove the call and heap obligations here
    del(h);
    return *p;
}

fn ptr_field_release(heap_store mut* s) u64 {
    u64 mut* p = s->heap.ptr; //! error: cannot prove the call and heap obligations here
    u64 mut@ own h = move(s->heap);
    del(h);
    return *p;
}

fn main() i32 { return 0; }
