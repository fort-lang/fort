//! fail
// D17.14: The store fills b. The normal return loses its allocation.
// The existing diagnostic directives remain deferred proof evidence.
fn main() i32 {
    i32* own a = null;
    println(a == null);
    u8 mut@ own s = {};
    println(s.len);
    i32 mut* own mut b = null;
    println(b == null);
    b = new(i32);
    return 0; //! error: 'b' still owns its value at the end of its scope
}
