//! fail
// A call that takes the address of `x` exposes `x` (D17.11, Borrows): `keep` stores the address
// into `P`, the copy of `P` borrows `exposed`, and the store through `p` can write `x`, so the
// store into `x` after it is an error. run/ownership/071 stores through a parameter and passes.
i32 mut* own mut* mut P = null;

fn keep(i32 mut* own mut* p) void {
    P = p;
}

fn main() i32 {
    i32 mut* own mut x = new(i32);
    keep(&x);
    del(x);
    i32 mut* own mut* p = P;
    del(*p);
    *p = new(i32);
    x = new(i32); //! error: cannot prove 'x' is empty here
    del(x);
    return 0;
}
