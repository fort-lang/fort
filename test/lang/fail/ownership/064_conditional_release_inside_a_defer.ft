//! fail
// D17.14: The immutable c is false. Deferred code leaves p allocated.
// The existing diagnostic directives remain deferred proof evidence.
fn main() i32 {
    i32 mut* own p = new(i32);
    bool c = false;
    defer {
        if (c) {
            del(p); //! error: conditional release of 'p' inside a deferred statement
        }
    }
    return 0;
}
