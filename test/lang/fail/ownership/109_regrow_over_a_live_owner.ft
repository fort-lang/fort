//! fail
// The result of `regrow` is an owner, and a store over a live owner is an error (D12.2, D17.11).
fn main() i32 {
    i32 mut@ own s = new(i32, 2);
    i32 mut@ own mut t = new(i32, 1);
    t = regrow(move(s), 4); //! error: overwriting owned value: cannot prove 't' is empty here
    del(t);
    return 0;
}
