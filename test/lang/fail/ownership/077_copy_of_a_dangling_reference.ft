//! fail
//! flags: --ownership-check
//! error-any: ownership proof is incomplete
//! error-any: cannot prove the call and heap obligations here
// D17.14: a copy of a reference is a use of it, so a copy of a dangling reference is an invalid
// use. That holds for a callee that never reads the copy, and for a local that no later
// operation reads.
fn takep(i32* p) void {}

fn copied_argument() void {
    i32 mut* own p = new(i32);
    i32* x = p;
    del(p);
    takep(x); //! error: invalid use of 'x'
}

fn copied_local() void {
    i32 mut* own p = new(i32);
    i32* x = p;
    del(p);
    i32* y = x; //! error: invalid use of 'x'
}

fn main() i32 { return 0; }
