//! fail
// A grouped owning reference transfers as the ungrouped one does (D3.6,
// D17.2). A copy of it needs `move`, a view of it is no owner, and a `move`
// out through an immutable level is an error.
fn consume((u8 mut@) own s) void {
    del(s);
}

fn main() i32 {
    (u8 mut@) own a = new(u8, 2);
    (u8 mut@ own) b = a; //! error: move
    consume(a); //! error: move
    (u8@) view = a;
    del(view); //! error: own
    ((i32 mut*) own)[2] mut slots = {};
    slots[0] = new(i32);
    (i32* own)@ items = slots[..];
    i32* own taken = move(items[0]); //! error: mut
    del(slots[0]);
    del(a);
    return 0;
}
