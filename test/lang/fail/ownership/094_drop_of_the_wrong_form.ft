//! fail
// `del(s, d)` takes a span of owners and the name of a fort function of type `fn (E) void`, where
// `E` is the element type of the span (D17.9). A span whose elements hold no owner, a pointer
// and `null` are no span of owners. A function value, a value of another type, a builtin and a
// name in parentheses are no name of a fort function, and a function of another type is no drop
// of `E`. `del` takes one or two operands.
struct in1 {
    i32 mut* own p;
}

fn in1_drop(in1 mut x) void {
    del(x.p);
}

fn by_pointer(in1* x) void {
}

fn stops(in1 mut x) noreturn {
    del(x.p);
    panic("stops");
}

fn main() i32 {
    i32 mut@ own n = new(i32, 2);
    del(n, in1_drop); //! error: 'del' with a drop needs an own span whose elements hold owners, not i32 mut@ own
    in1 mut* own one = new(in1);
    del(one, in1_drop); //! error: 'del' with a drop needs an own span whose elements hold owners, not in1 mut* own
    del(null, in1_drop); //! error: 'del' with a drop needs an own span whose elements hold owners, not void* own
    in1 mut@ own s = new(in1, 2);
    fn (in1) void value = in1_drop;
    del(s, value); //! error: the drop of 'del' must name a fort function, not a function value
    del(s, 3); //! error: the drop of 'del' must name a fort function, not a value of type i32
    del(s, print); //! error: 'print' cannot be used as a value
    del(s, (in1_drop)); //! error: the drop of 'del' must name a fort function, not an expression in parentheses
    del(s, by_pointer); //! error: the drop 'by_pointer' has type fn (in1*) void, and 'del' needs fn (in1) void
    del(s, stops); //! error: the drop 'stops' has type fn (in1) noreturn, and 'del' needs fn (in1) void
    del(s, in1_drop, in1_drop); //! error: 'del' takes 1 or 2 arguments, 3 given
    del(); //! error: 'del' takes 1 or 2 arguments, 0 given
    del(s, in1_drop);
    return 0;
}
