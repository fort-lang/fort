//! fail
//! flags: --check
// `--check` gives the error of rule (b) and exits 1, as a build does (D17.21, D20.1). The harness
// compiles this test with `--check`, so the test holds the status of `--check`. The program has no
// error of D17.11 and no leak, so only rule (b) can give that status.
fn deleted() void {
    i32 mut* own mut p = new(i32);
    del(p);
    i32 v = *p; //! error: use after move or del: 'p' can be vacated here
}

fn main() i32 {
    deleted();
    return 0;
}
