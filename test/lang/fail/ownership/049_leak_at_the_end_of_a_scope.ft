//! fail
// D17.14: The inner block loses s. The function return loses a.
// The existing diagnostic directives remain deferred proof evidence.
fn show() void {
    i32 mut* own a = new(i32);
    {
        u8 mut@ own s = new(u8, 4);
        println(s.len);
    } //! error: 's' still owns its value at the end of its scope
    println(*a);
} //! error: 'a' still owns its value at the end of its scope

fn main() i32 {
    show();
    return 0;
}
