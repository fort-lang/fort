//! fail
// The operands of `==` lend (D17.4), so comparing an owning rvalue would leave
// the allocation with nothing able to free it (D17.8).
struct node {
    i32 value;
}

fn node mut* own make() {
    return new(node);
}

fn i32 main() {
    println(make() == null); //! error: owning temporary
    println(null != make()); //! error: owning temporary
    return 0;
}
