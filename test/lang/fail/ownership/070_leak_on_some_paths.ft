//! fail
// The analysis cannot prove the zero value of an owner that holds an allocation on some paths
// only (D17.20). In `some`, `n` holds an allocation only when `c` holds, so the closing brace of
// the body is an error, though `n` starts as `null`. A `del` after the `if` fixes it, as in
// `each`, because `del` of a null owner does nothing (D17.9). In `moved`, the parameter `p`
// moves on one path only, so the `return` at the closing brace of the body is an error too.
fn take(i32 mut* own p) void {
    del(p);
}

fn some(bool c) void {
    i32 mut* own mut n = null;
    if (c) {
        n = new(i32);
    }
} //! error: cannot prove 'n' is empty at this exit

fn each(bool c) void {
    i32 mut* own mut n = null;
    if (c) {
        n = new(i32);
    }
    del(n);
}

fn moved(bool c, i32 mut* own p) void {
    if (c) {
        take(move(p));
    }
} //! error: cannot prove 'p' is empty at this exit

fn main() i32 {
    some(false);
    each(true);
    moved(true, new(i32));
    return 0;
}
