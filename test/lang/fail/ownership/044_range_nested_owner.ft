//! fail
// A containing owner cannot leave the loop loan (D17.10).
struct holder {
    u8 mut@ own items;
}
fn main() i32 {
    holder mut* own h = new(holder);
    h->items = new(u8, 2);
    for (u8 x : h->items) { del(h); } //! error: cannot change collection storage
    del(h->items);
    del(h);
    return 0;
}
