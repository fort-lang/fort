//! fail
// D17.14: The continue ends p storage with its allocation live.
// The existing diagnostic directives remain deferred proof evidence.
fn main() i32 {
    i32 mut i = 0;
    while (i < 2) {
        i += 1;
        i32 mut* own p = new(i32);
        continue; //! error: 'p' still owns its value at the end of its scope
    }
    return i;
}
