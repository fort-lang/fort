//! fail
// A `continue` ends the scope of the loop body (D17.20). The `continue` of `again` leaves `n` with
// its allocation, so the error and its note stand at the `continue`. The back edge also carries
// the live `n` to its declaration in the next round, so the declaration is the error of D17.11
// at the declared name. Both errors of `again` come from one fault, and one `del(n)` before the
// `continue` fixes both, as in `freed`. The error of D17.11 comes first, because the errors of the
// leak rule follow the errors of D17.11 in each function.
fn again(i32 count) void {
    for (i32 mut i = 0; i < count; i++) {
        i32 mut* own n = new(i32); //! error: cannot prove 'n' is empty here
        if (i == 1) {
            continue; //! error: cannot prove 'n' is empty at this exit
        }
        del(n);
    }
}

fn freed(i32 count) void {
    for (i32 mut i = 0; i < count; i++) {
        i32 mut* own n = new(i32);
        if (i == 1) {
            del(n);
            continue;
        }
        del(n);
    }
}

fn main() i32 {
    again(3);
    freed(3);
    return 0;
}
