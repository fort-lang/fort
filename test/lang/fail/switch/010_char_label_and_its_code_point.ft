//! fail
// A char constant in an integer context becomes the integer of its code point
// (D4.3), so `'a'` and 97 are one value and the second label repeats the first
// (D7.6). Without the conversion the two labels hold values of two kinds, which
// compare unequal, and the switch compiles.
fn main() i32 {
    i32 x = 1;
    switch (x) {
    case 'a':
        println("a");
    case 97: //! error: duplicate case value 97
        println("ninety-seven");
    default:
        println("other");
    }
    return 0;
}
