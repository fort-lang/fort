//! fail
// The operand rules of D7.6: not a pointer, at most one `default`, and a
// label must convert to the operand's type.
fn main() i32 {
    i32 n = 1;
    i32* p = &n;
    switch (p) { //! error: cannot switch on
    default:
        return 1;
    }
    u8 b = 1;
    switch (b) {
    case 300: //! error: does not fit
        return 2;
    }
    switch (n) {
    default:
        return 3;
    default: //! error: at most one
        return 4;
    }
    switch (n) {
    default:
        // `continue` targets the enclosing loop, which a switch is not
        // (D7.6).
        continue; //! error: outside a loop
    }
    return 5;
}
