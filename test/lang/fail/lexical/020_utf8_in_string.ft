//! fail
// Source is UTF-8 (D2.1). The byte 0xE9 alone in a string literal is no UTF-8 text. The escape
// `\xE9` is the way to put that byte into a string (run/lexical/009_utf8_escape.ft). A
// backslash before the bad byte does not hide it.
fn main() i32 {
    println("café"); //! error: invalid UTF-8 sequence at byte 0xE9
    string s = "été"; //! error: invalid UTF-8 sequence at byte 0xE9
    println("\é"); //! error: invalid UTF-8 sequence at byte 0xE9
    return 0;
}
