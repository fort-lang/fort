//! fail
// `_` may appear between two digits and nowhere else (D2.5): not at the end,
// not after a base prefix, not doubled, not before the point of a float.
fn main() i32 {
    i32 a = 1_; //! error: '_' must stand between two digits
    i32 b = 0x_FF; //! error: '_' must stand between two digits
    i32 c = 1__0; //! error: '_' must stand between two digits
    return a + b + c;
}
