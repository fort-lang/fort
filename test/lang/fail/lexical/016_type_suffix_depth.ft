//! fail
// A type takes 256 suffixes, the nesting limit of D2.11. A group does not reset
// the count, so the 129th `*` after a group of 128 is the 257th suffix and the
// parser stops there.
fn main() i32 {
    (i32********************************************************************************************************************************)********************************************************************************************************************************* grouped = null; //! error: nesting deeper than 256
    return 0;
}
