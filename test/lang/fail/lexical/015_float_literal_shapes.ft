//! fail
// The shape of a float literal (D2.6): `1.` and `.5` are not literals, the
// leading-zero rule of D2.5 holds for the integer part, and there is no
// suffix.
fn main() i32 {
    f64 a = 09.5; //! error: decimal literal may not start with '0'
    f64 b = 1.5f; //! error: float literals have no suffix
    f64 c = 1.0e; //! error: float literals have no suffix
    return 0;
}
