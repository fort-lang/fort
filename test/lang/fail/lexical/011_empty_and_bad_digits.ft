//! fail
// A based literal needs at least one digit after its prefix, and every digit
// must belong to the base (D2.5).
fn main() i32 {
    i32 a = 0b; //! error: binary literal needs at least one digit
    i32 b = 0o; //! error: octal literal needs at least one digit
    i32 c = 0x; //! error: hex literal needs at least one digit
    i32 d = 0b12; //! error: invalid digit '2' in binary literal
    i32 e = 0o18; //! error: invalid digit '8' in octal literal
    return a + b + c + d + e;
}
