//! fail
// A char literal holds exactly one printable ASCII character or one escape
// (D2.7), so an empty one and a two-character one are both errors.
fn i32 main() {
    char a = ''; //! error: char literal holds exactly one character
    char b = 'ab'; //! error: char literal holds exactly one character
    return cast(a, i32) + cast(b, i32);
}
