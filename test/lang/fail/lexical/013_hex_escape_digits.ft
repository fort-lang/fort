//! fail
// `\xHH` takes exactly two hex digits (D2.8), in a char literal and in a
// string alike.
fn i32 main() {
    char a = '\x4'; //! error: '\x' needs exactly two hex digits
    char b = '\xZZ'; //! error: '\x' needs exactly two hex digits
    string s = "a\x1"; //! error: '\x' needs exactly two hex digits
    return cast(a, i32) + cast(b, i32) + cast(s.len, i32);
}
