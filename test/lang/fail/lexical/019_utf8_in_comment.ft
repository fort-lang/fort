//! fail
// Source is UTF-8 (D2.1). The byte 0xE9 alone is Latin-1 text and no UTF-8 text: 0xE9 starts
// a sequence of three bytes, and the next byte is no continuation byte. A comment is UTF-8
// text too. The error stands at the bad byte and costs its line, not the file (D14.2).
fn main() i32 {
    // café //! error: invalid UTF-8 sequence at byte 0xE9
    println("a"); // café au lait //! error: invalid UTF-8 sequence at byte 0xE9
    return 0;
}
