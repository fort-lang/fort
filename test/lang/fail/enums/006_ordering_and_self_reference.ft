//! fail
// Enums have no ordering operators and a member's value may not refer to the
// enum itself (D3.9).
enum color {
    red,
    green,
}

enum cycle { //! error: itself
    a = 1,
    b = cast(cycle.a, i32) + 1,
}

fn i32 main() {
    color c = color.red;
    bool less = c < color.green; //! error: ordered
    return cast(less, i32);
}
