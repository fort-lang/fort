//! fail
// The underlying type of an enum is i32 and a member's value is an integer
// constant, so a float is an error (D3.9, D4.2).
enum color {
    red = 1.5, //! error: an enum value is an integer constant, not a float
    green = 2.0, //! error: an enum value is an integer constant, not a float
}

fn i32 main() {
    println(cast(color.red, i32));
    return 0;
}
