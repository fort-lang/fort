//! run
//! args: /dev/stdin
//! stdin:
//< the quick brown fox
//< jumps over the lazy dog
//! stdout:
//| 2 9
import std.io;
import std.str;
import std.sys;

fn i32 main(string@ args) {
    if (args.len != 2) {
        eprintln("usage: ", args[0], " <file>");
        return 2;
    }
    u8 mut@ own mut data = {};
    defer del(data);
    if (!io.read_file_bytes(args[1], &data)) {
        eprintln("wc: cannot read ", args[1], " (errno ", sys.errno(), ")");
        return 1;
    }
    string text = cast(data[..], string);
    u64 mut lines = 0;
    u64 mut words = 0;
    bool mut in_word = false;
    for (char ch : text) {
        if (ch == '\n') {
            lines++;
        }
        if (str.is_space(ch)) {
            in_word = false;
        } else if (!in_word) {
            in_word = true;
            words++;
        }
    }
    if (text.len > 0 && text[text.len - 1] != '\n') {
        lines++;
    }
    println(lines, " ", words);
    return 0;
}
