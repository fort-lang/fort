//! run
//! stdout:
//| built: alpha=4 bravo=8 delta=2 kilo=5 mike=1 romeo=6 sierra=9 tango=3 zulu=7 (9)
//| height=4 min=alpha max=zulu
//| kilo=true 5
//| yankee=false
//| replaced kilo=100 count=9
//| rm zulu=true
//| no leaf: alpha=4 bravo=8 delta=2 kilo=100 mike=1 romeo=6 sierra=9 tango=3 (8)
//| rm romeo=true
//| no one-child: alpha=4 bravo=8 delta=2 kilo=100 mike=1 sierra=9 tango=3 (7)
//| rm mike=true
//| no root: alpha=4 bravo=8 delta=2 kilo=100 sierra=9 tango=3 (6)
//| rm yankee=false count=6
//| min=alpha max=tango height=4
//| emptied count=0 root=true
// An owning binary search tree keyed by string (D17): each node owns its two
// subtrees, and every traversal borrows. `del` is shallow (D17.7), so `remove`
// moves the children out of a node before it frees that node. `main` removes
// each key before its deferred tree_drop_made, which then finds the root null. Insert,
// lookup, min, max, height, an in-order walk, and deletion of a node with zero,
// one and two children.
struct tnode {
    string key;
    i64 value;
    tnode mut* own left;
    tnode mut* own right;
}

struct tree {
    tnode mut* own root;
    u64 count;
}

// Frees the subtrees of a node that the caller moves in.
fn tnode_drop(tnode mut n) void {
    tnode_drop_made(move(n.left));
    tnode_drop_made(move(n.right));
}

// Ends a subtree that the caller moves in, or nothing for null.
fn tnode_drop_made(tnode mut* own p) void {
    if (p == null) {
        return;
    }
    tnode v = move(*p);
    del(p);
    tnode_drop(move(v));
}

fn compare(string a, string b) i32 {
    u64 mut n = a.len;
    if (b.len < n) {
        n = b.len;
    }
    for (u64 mut i = 0; i < n; i++) {
        if (a[i] < b[i]) {
            return -1;
        }
        if (b[i] < a[i]) {
            return 1;
        }
    }
    if (a.len < b.len) {
        return -1;
    }
    if (b.len < a.len) {
        return 1;
    }
    return 0;
}

// Insert returns the (possibly new) owner of the subtree, so the caller stores
// it back into the slot it moved out of and no node is owned twice.
fn insert(tnode mut* own here, string key, i64 value, u64 mut* count) tnode mut* own {
    if (here == null) {
        del(here);
        tnode mut* own fresh = new(tnode);
        fresh->key = key;
        fresh->value = value;
        *count += 1;
        return move(fresh);
    }
    tnode mut* own mut node = move(here);
    i32 order = compare(key, node->key);
    if (order < 0) {
        tnode mut* own left = insert(move(node->left), key, value, count);
        tnode mut* own nv = move(left);
        tnode mut* own old = move(node->left);
        node->left = move(nv);
        tnode_drop_made(move(old));
    } else if (order > 0) {
        tnode mut* own right = insert(move(node->right), key, value, count);
        tnode mut* own nv = move(right);
        tnode mut* own old = move(node->right);
        node->right = move(nv);
        tnode_drop_made(move(old));
    } else {
        node->value = value;
    }
    return move(node);
}

fn lookup(tnode* here, string key, i64 mut* out) bool {
    tnode* mut node = here;
    while (node != null) {
        i32 order = compare(key, node->key);
        if (order == 0) {
            *out = node->value;
            return true;
        }
        if (order < 0) {
            node = node->left;
        } else {
            node = node->right;
        }
    }
    return false;
}

fn min_key(tnode* here) string {
    tnode* mut node = here;
    while (node->left != null) {
        node = node->left;
    }
    return node->key;
}

fn max_key(tnode* here) string {
    tnode* mut node = here;
    while (node->right != null) {
        node = node->right;
    }
    return node->key;
}

fn height(tnode* here) u64 {
    if (here == null) {
        return 0;
    }
    u64 l = height(here->left);
    u64 r = height(here->right);
    if (l > r) {
        return l + 1;
    }
    return r + 1;
}

fn inorder(tnode* here) void {
    if (here == null) {
        return;
    }
    inorder(here->left);
    print(" ", here->key, "=", here->value);
    inorder(here->right);
}

// A subtree split in two: the node of its smallest key, unhooked, and the rest.
struct split {
    tnode mut* own rest;
    tnode mut* own min;
}

// Splits a subtree. It returns both parts (D17.11 form 2), so that the caller holds the smallest
// node in a local that is not memory.
fn take_min(tnode mut* own here) split {
    tnode mut* own mut node = move(here);
    if (node->left == null) {
        tnode mut* own right = move(node->right);
        return split{move(right), move(node)};
    }
    split mut taken = take_min(move(node->left));
    tnode mut* own nv = move(taken.rest);
    tnode mut* own old = move(node->left);
    node->left = move(nv);
    tnode_drop_made(move(old));
    return split{move(node), move(taken.min)};
}

fn remove(tnode mut* own here, string key, bool mut* removed) tnode mut* own {
    if (here == null) {
        del(here);
        return null;
    }
    tnode mut* own mut node = move(here);
    i32 order = compare(key, node->key);
    if (order < 0) {
        tnode mut* own left = remove(move(node->left), key, removed);
        tnode mut* own nv = move(left);
        tnode mut* own old = move(node->left);
        node->left = move(nv);
        tnode_drop_made(move(old));
        return move(node);
    }
    if (order > 0) {
        tnode mut* own right = remove(move(node->right), key, removed);
        tnode mut* own nv = move(right);
        tnode mut* own old = move(node->right);
        node->right = move(nv);
        tnode_drop_made(move(old));
        return move(node);
    }
    *removed = true;
    if (node->left == null) {
        tnode mut* own right = move(node->right);
        del(node);
        return move(right);
    }
    if (node->right == null) {
        tnode mut* own left = move(node->left);
        del(node);
        return move(left);
    }
    // Two children: the in-order successor takes this node's place. Both
    // children leave the node before its `del`, which is shallow.
    tnode mut* own kept_left = move(node->left);
    tnode mut* own subtree = move(node->right);
    del(node);
    split mut taken = take_min(move(subtree));
    tnode mut* own right = move(taken.rest);
    tnode mut* own heir = move(taken.min);
    tnode mut* own nv = move(kept_left);
    tnode mut* own old = move(heir->left);
    heir->left = move(nv);
    tnode_drop_made(move(old));
    tnode mut* own nv_right = move(right);
    tnode mut* own old_right = move(heir->right);
    heir->right = move(nv_right);
    tnode_drop_made(move(old_right));
    return move(heir);
}

fn insert_into(tree mut* t, string key, i64 value) void {
    tnode mut* own root = insert(move(t->root), key, value, &t->count);
    tnode mut* own nv = move(root);
    tnode mut* own old = move(t->root);
    t->root = move(nv);
    tnode_drop_made(move(old));
}

fn remove_from(tree mut* t, string key) bool {
    bool mut removed = false;
    tnode mut* own root = remove(move(t->root), key, &removed);
    tnode mut* own nv = move(root);
    tnode mut* own old = move(t->root);
    t->root = move(nv);
    tnode_drop_made(move(old));
    if (removed) {
        t->count--;
    }
    return removed;
}

fn show(string name, tree* t) void {
    print(name, ":");
    inorder(t->root);
    println(" (", t->count, ")");
}

// Frees the nodes of a tree that the caller moves in.
fn tree_drop(tree mut t) void {
    tnode_drop_made(move(t.root));
}

// Ends a tree in an allocation that the caller moves in, or nothing for null.
fn tree_drop_made(tree mut* own p) void {
    if (p == null) {
        return;
    }
    tree v = move(*p);
    del(p);
    tree_drop(move(v));
}

// A read through a pointer: the owner is no local owner here (D17.21).
fn root_of(tree* t) tnode* {
    return t->root;
}

string[9] KEYS = {"mike", "delta", "tango", "alpha", "kilo", "romeo", "zulu", "bravo", "sierra"};

fn main() i32 {
    tree mut* own t = new(tree);
    defer tree_drop_made(move(t));
    for (u64 mut i = 0; i < KEYS.len; i++) {
        insert_into(t, KEYS[i], cast(i, i64) + 1);
    }
    show("built", t);
    println("height=", height(root_of(t)), " min=", min_key(root_of(t)),
            " max=", max_key(root_of(t)));

    i64 mut v = 0;
    println("kilo=", lookup(root_of(t), "kilo", &v), " ", v);
    println("yankee=", lookup(root_of(t), "yankee", &v));

    insert_into(t, "kilo", 100);
    lookup(root_of(t), "kilo", &v);
    println("replaced kilo=", v, " count=", t->count);

    println("rm zulu=", remove_from(t, "zulu"));
    show("no leaf", t);
    println("rm romeo=", remove_from(t, "romeo"));
    show("no one-child", t);
    println("rm mike=", remove_from(t, "mike"));
    show("no root", t);
    println("rm yankee=", remove_from(t, "yankee"), " count=", t->count);

    println("min=", min_key(root_of(t)), " max=", max_key(root_of(t)),
            " height=", height(root_of(t)));
    for (u64 mut i = 0; i < KEYS.len; i++) {
        remove_from(t, KEYS[i]);
    }
    println("emptied count=", t->count, " root=", t->root == null);
    return 0;
}
