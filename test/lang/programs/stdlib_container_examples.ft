//! run
//! stdout:
//|     mov rax, 42
//| true
//| 7
//| true true false
//| 0 1 x y
//| true false
//| 2 0 0 true
import std.io;
import std.strbuf;
import std.strmap;
import std.vec;

// The worked examples of stdlib.md 2.6, 2.7 and 2.8, run so that the
// specification's own sample code is held against the library it describes.
// Every declaration below the imports is the example as the document spells
// it, with one change that the leak rule proves: symtab_free moves the table
// into symtab_drop, which holds each release once. The main at the end is this
// test's own, and it drives them.

// stdlib.md 2.6.
// Ends a buffer in an allocation of `new` that the caller moves in (1.3).
fn buf_drop_made(strbuf.str_buf mut* own p) void {
    strbuf.str_buf kept = move(*p);
    del(p);
    strbuf.drop(move(kept));
}

// Formats "    mov <reg>, <imm>\n". Ownership: the caller dels the result.
fn mov_imm(string reg, i64 imm) string own {
    strbuf.str_buf mut* own b = new(strbuf.str_buf);
    defer buf_drop_made(move(b));
    strbuf.reserve(b, 32);
    strbuf.append(b, "    mov ");
    strbuf.append(b, reg);
    strbuf.append(b, ", ");
    strbuf.append_i64(b, imm);
    strbuf.push(b, '\n');
    return strbuf.take(b);   // an own rvalue flows into the own return type (D17.5)
}

fn emit_mov(i32 fd) bool {
    string own line = mov_imm("rax", 42);
    defer del(line);
    return io.write_all(fd, cast(line[..], u8@));   // a view of line is written (1.3)
}

// stdlib.md 2.7.
struct node { i64 value; }

// A vector of views of nodes: a typed copy of int_vec with the slot type node mut*.
struct node_vec {
    node mut* mut@ own items;
    u64 len;
}

// The typed copy of int_free, int_drop, int_reserve, int_push and int_pop, which the document
// names and does not show: `i64` is `node mut*` and the prefix `int_` is `node_`.
fn node_free(node_vec mut* v) void {
    node_drop(move(*v));
}

fn node_drop(node_vec mut v) void {
    del(v.items);
}

fn node_reserve(node_vec mut* v, u64 extra) void {
    if (extra > vec.U64_MAX - v->len) {
        panic("node_reserve: capacity overflow");
    }
    u64 need = v->len + extra;
    if (need <= v->items.len) {
        return;
    }
    u64 mut cap = 16;
    if (need > cap) {
        cap = need;
    }
    if (v->items.len <= vec.U64_MAX / 2 && v->items.len * 2 > cap) {
        cap = v->items.len * 2;
    }
    node mut* mut@ own bigger = new(node mut*, cap);
    u64 mut i = 0;
    while (i < v->len) {
        bigger[i] = v->items[i];
        i += 1;
    }
    del(v->items);
    v->items = move(bigger);
}

fn node_push(node_vec mut* v, node mut* n) void {
    node_reserve(v, 1);
    v->items[v->len] = n;
    v->len += 1;
}

fn node_pop(node_vec mut* v) node mut* {
    if (v->len == 0) {
        panic("node_pop: empty");
    }
    v->len -= 1;
    return v->items[v->len];
}

// A read through a pointer parameter: the owner is no local owner here (D17.21).
fn value_of(node* p) i64 {
    return p->value;
}

// Ends a vector in an allocation of `new` that the caller moves in (1.3): node_drop, the typed
// copy of int_drop, frees the slots.
fn node_drop_made(node_vec mut* own p) void {
    node_vec kept = move(*p);
    del(p);
    node_drop(move(kept));
}

fn demo() i64 {
    node_vec mut* own stack = new(node_vec);  // the calls take the vector by pointer (1.3)
    defer node_drop_made(move(stack));
    node mut* own n = new(node);              // new lands in an own place (D17.3, D17.8)
    defer del(n);
    n->value = 7;
    node_push(stack, n);                      // lends n; the vector never frees it
    node mut* top = node_pop(stack);          // the type that went in comes back
    return value_of(top);
}

// stdlib.md 2.8.
struct sym { string name; i64 offset; }

struct sym_tab {
    strmap.str_map index;     // name to position in syms
    sym mut* mut@ own syms;   // sym* in declaration order, owned by whoever declared them
    u64 len;
}

fn declare(sym_tab mut* t, sym mut* s) bool {
    if (strmap.has(&t->index, s->name)) {
        return false;
    }
    if (t->len == t->syms.len) {
        sym mut* mut@ own bigger = new(sym mut*, 2 * t->len + 4);
        for (u64 mut i = 0; i < t->len; i += 1) {
            bigger[i] = t->syms[i];
        }
        del(t->syms);
        t->syms = move(bigger);
    }
    strmap.put(&t->index, s->name, cast(t->len, i64));
    t->syms[t->len] = s;
    t->len += 1;
    return true;
}

fn lookup(sym_tab* t, string name) sym* {
    i64 mut i = 0;
    if (!strmap.get(&t->index, name, &i)) {
        return null;
    }
    return t->syms[cast(i, u64)];
}

fn symtab_free(sym_tab mut* t) void {
    symtab_drop(move(*t));
}

// Frees a table that the caller moves in: the map, then the slots.
fn symtab_drop(sym_tab mut t) void {
    del(t.index.entries);
    del(t.syms);   // the sym values are borrowed and stay alive
}

// Ends a table in an allocation that the caller moves in.
fn symtab_drop_made(sym_tab mut* own p) void {
    sym_tab kept = move(*p);
    del(p);
    symtab_drop(move(kept));
}

// The two symbols that lookup found. They are parameters, so a read through them uses no
// local owner here (D17.21).
fn show_pair(sym* a, sym* b) void {
    println(a->offset, " ", b->offset - 7, " ", a->name, " ", b->name);
}

fn main() i32 {
    // The buffer the example builds is written straight to the descriptor,
    // so the runtime's buffer for it is flushed first (D11.5).
    io.flush(io.STDOUT);
    println(emit_mov(io.STDOUT));

    // stdlib.md 2.7: the pointer comes back out of the vector unharmed.
    println(demo());

    // stdlib.md 2.8: two symbols declared, one of them twice.
    sym mut x = {"x", 0};
    sym mut y = {"y", 8};
    sym_tab mut* own t = new(sym_tab);
    defer symtab_drop_made(move(t));
    println(declare(t, &x), " ", declare(t, &y), " ", declare(t, &x));
    show_pair(lookup(t, "x"), lookup(t, "y"));
    println(lookup(t, "zzz") == null, " ", lookup(t, "x") == null);

    // symtab_free releases the map and the slots and leaves the symbols,
    // which belong to this function.
    symtab_free(t);
    println(x.offset + y.offset - 6, " ", t->index.live, " ", t->len, " ", t->syms.ptr == null);
    return 0;
}
