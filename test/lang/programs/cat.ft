//! run
//! args: /dev/stdin
//! stdin:
//< first line
//< second line
//! stdout:
//| first line
//| second line
import std.io;
import std.strbuf;
import std.sys;

// cat: copies one file to standard output. The worked example of
// stdlib.md 2.4, whose last statement is written as an if because the
// bootstrap compiler has no ?: (D3.10, bootstrap-unsupported.txt) and this
// program is meant to run under stage1 as well.
fn main(string@ args) i32 {
    if (args.len != 2) {
        return 2;
    }
    strbuf.str_buf mut buf = strbuf.create();
    defer strbuf.free(&buf);
    if (!io.read_file(args[1], &buf)) {
        eprintln("cat: ", args[1], ": errno ", sys.errno());
        return 1;
    }
    if (!io.write_all(io.STDOUT, strbuf.bytes(&buf))) {
        return 1;
    }
    return 0;
}
