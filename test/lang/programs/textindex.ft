//! run
//! args: /dev/stdin
//! stdin:
//< the quick brown fox
//< jumps over the lazy dog
//< the dog barks and the fox runs
//<
//< quick brown foxes are quick
//! stdout:
//| lines=5 distinct=13 map=13
//| dictionary: the quick brown fox jumps over lazy dog barks and runs foxes are
//| the: 4 occurrences on 1 2 3
//| fox: 2 occurrences on 1 3
//| quick: 3 occurrences on 1 5
//| cat: not found
//| all of the fox -> 1 3
//| all of quick dog -> none
//| all of the dog fox -> 3
//| all of cat the -> none
//| occurrences=21 words=21 agree=true
import std::io;
import std::str;
import std::strbuf;
import std::strmap;
import std::vec;

// An inverted index over the lines of a file: every distinct word maps to the
// list of line numbers it occurs on, and a query intersects those lists. It is
// built entirely out of the standard library -- a string map for the
// dictionary, an integer vector per posting list, a string buffer for the
// copies the map's keys borrow -- so the program is also a test that those
// containers compose.
struct posting {
    string word;
    vec.int_vec lines;
    u64 occurrences;
}

struct index {
    strmap.str_map words;
    posting mut@ own postings;
    u64 count;
    u64 line_count;
}

fn index create(u64 cap) {
    index mut ix = {};
    ix.words = strmap.create();
    ix.postings = new(posting, cap);
    return move(ix);
}

fn void free_index(index mut* ix) {
    for (u64 mut i = 0; i < ix->count; i++) {
        vec.int_free(&ix->postings[i].lines);
    }
    del(ix->postings);
    strmap.free(&ix->words);
    ix->count = 0;
}

// `word` must outlive the index; the caller keeps every word in one buffer.
fn void add(index mut* ix, string word, i64 line) {
    i64 mut slot = 0;
    if (!strmap.get(&ix->words, word, &slot)) {
        if (ix->count == ix->postings.len) {
            return;
        }
        slot = cast(ix->count, i64);
        ix->postings[ix->count].word = word;
        ix->postings[ix->count].lines = vec.int_create();
        ix->count++;
        strmap.put(&ix->words, word, slot);
    }
    u64 at = cast(slot, u64);
    ix->postings[at].occurrences++;
    vec.int_vec mut* list = &ix->postings[at].lines;
    if (list->len == 0 || list->items[list->len - 1] != line) {
        vec.int_push(list, line);
    }
}

fn bool find(index* ix, string word, u64 mut* out) {
    i64 mut slot = 0;
    if (!strmap.get(&ix->words, word, &slot)) {
        return false;
    }
    *out = cast(slot, u64);
    return true;
}

fn void show_postings(index* ix, string word) {
    u64 mut at = 0;
    print(word, ":");
    if (!find(ix, word, &at)) {
        println(" not found");
        return;
    }
    posting* p = &ix->postings[at];
    print(" ", p->occurrences, " occurrences on");
    for (u64 mut i = 0; i < p->lines.len; i++) {
        print(" ", p->lines.items[i]);
    }
    println();
}

// The lines that hold every word of the query, by walking the shortest list
// and testing the others.
fn void conjunction(index* ix, string@ words) {
    print("all of");
    for (string w : words) {
        print(" ", w);
    }
    print(" ->");
    u64 mut shortest = 0;
    bool mut ok = true;
    for (u64 mut i = 0; i < words.len; i++) {
        u64 mut at = 0;
        if (!find(ix, words[i], &at)) {
            ok = false;
        } else if (i == 0 || ix->postings[at].lines.len < ix->postings[shortest].lines.len) {
            shortest = at;
        }
    }
    if (!ok) {
        println(" none");
        return;
    }
    u64 mut hits = 0;
    for (u64 mut i = 0; i < ix->postings[shortest].lines.len; i++) {
        i64 line = ix->postings[shortest].lines.items[i];
        bool mut everywhere = true;
        for (u64 mut w = 0; w < words.len; w++) {
            u64 mut at = 0;
            find(ix, words[w], &at);
            bool mut here = false;
            for (u64 mut j = 0; j < ix->postings[at].lines.len; j++) {
                if (ix->postings[at].lines.items[j] == line) {
                    here = true;
                }
            }
            if (!here) {
                everywhere = false;
            }
        }
        if (everywhere) {
            print(" ", line);
            hits++;
        }
    }
    if (hits == 0) {
        print(" none");
    }
    println();
}

string[2] QUERY_A = {"the", "fox"};
string[2] QUERY_B = {"quick", "dog"};
string[3] QUERY_C = {"the", "dog", "fox"};
string[2] QUERY_D = {"cat", "the"};

fn i32 main(string@ args) {
    if (args.len != 2) {
        return 2;
    }
    strbuf.str_buf mut source = strbuf.create();
    defer strbuf.free(&source);
    if (!io.read_file(args[1], &source)) {
        return 1;
    }
    string text = strbuf.view(&source);

    index mut ix = create(64);
    defer free_index(&ix);

    i64 mut line = 1;
    u64 mut i = 0;
    while (i < text.len) {
        if (text[i] == '\n') {
            line++;
            i++;
            continue;
        }
        if (!str.is_alnum(text[i])) {
            i++;
            continue;
        }
        u64 start = i;
        while (i < text.len && str.is_alnum(text[i])) {
            i++;
        }
        add(&ix, text[start..i], line);
    }
    ix.line_count = cast(line - 1, u64);

    println("lines=", ix.line_count, " distinct=", ix.count, " map=",
            strmap.count(&ix.words));

    // The dictionary in insertion order, which is the order of first sight.
    print("dictionary:");
    for (u64 mut w = 0; w < ix.count; w++) {
        print(" ", ix.postings[w].word);
    }
    println();

    show_postings(&ix, "the");
    show_postings(&ix, "fox");
    show_postings(&ix, "quick");
    show_postings(&ix, "cat");

    conjunction(&ix, QUERY_A[0..QUERY_A.len]);
    conjunction(&ix, QUERY_B[0..QUERY_B.len]);
    conjunction(&ix, QUERY_C[0..QUERY_C.len]);
    conjunction(&ix, QUERY_D[0..QUERY_D.len]);

    // The totals must agree with a second pass that shares no state.
    u64 mut total = 0;
    for (u64 mut w = 0; w < ix.count; w++) {
        total += ix.postings[w].occurrences;
    }
    u64 mut words_seen = 0;
    u64 mut j = 0;
    while (j < text.len) {
        if (!str.is_alnum(text[j])) {
            j++;
            continue;
        }
        while (j < text.len && str.is_alnum(text[j])) {
            j++;
        }
        words_seen++;
    }
    println("occurrences=", total, " words=", words_seen, " agree=", total == words_seen);
    return 0;
}
