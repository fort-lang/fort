//! run
//! args: /dev/stdin
//! stdin:
//< 2.5
//< -1.25
//< 10
//< 0.5
//! stdout:
//| count 4
//| sum 11.75
//| mean 2.9375
//| min -1.25
//| max 10.0
//| range 11.25
//| var 18.38671875
// A program that reads numbers and reports statistics of them: the float
// arithmetic of D6.12 over a span, with the parsing done by hand since the
// standard library parses integers only.
import std.io;
import std.str;
import std.sys;

// The numbers a run holds at most, which is what sizes the buffer.
u64 MAX_VALUES = 64;

// A decimal with an optional sign and an optional fraction, as a float. The
// integer and the fraction are read as integers and the fraction is scaled,
// so the value is exact when both fit (D4.4).
fn parse_float(string text, f64 mut* out) bool {
    u64 mut at = 0;
    bool mut neg = false;
    if (text.len > 0 && (text[0] == '-' || text[0] == '+')) {
        neg = text[0] == '-';
        at = 1;
    }
    i64 mut whole = 0;
    u64 mut digits = 0;
    while (at < text.len && str.is_digit(text[at])) {
        whole = whole * 10 + str.digit_value(text[at]);
        digits += 1;
        at += 1;
    }
    if (digits == 0) {
        return false;
    }
    f64 mut value = cast(whole, f64);
    if (at < text.len && text[at] == '.') {
        at += 1;
        f64 mut scale = 1.0;
        while (at < text.len && str.is_digit(text[at])) {
            scale = scale / 10.0;
            value = value + cast(str.digit_value(text[at]), f64) * scale;
            at += 1;
        }
    }
    if (at != text.len) {
        return false;
    }
    if (neg) {
        value = -value;
    }
    *out = value;
    return true;
}

fn main(string@ args) i32 {
    if (args.len != 2) {
        eprintln("usage: ", args[0], " <file>");
        return 2;
    }
    u8 mut@ own mut data = {};
    defer del(data);
    if (!io.read_file_bytes(args[1], &data)) {
        eprintln("float_stats: cannot read ", args[1], " (errno ", sys.errno(), ")");
        return 1;
    }
    string text = cast(data[..], string);
    f64[MAX_VALUES] mut values = {};
    u64 mut count = 0;
    u64 mut from = 0;
    u64 mut at = 0;
    while (at <= text.len) {
        if (at < text.len && text[at] != '\n') {
            at += 1;
            continue;
        }
        string line = text[from..at];
        from = at + 1;
        at += 1;
        if (line.len == 0) {
            continue;
        }
        f64 mut v = 0.0;
        if (!parse_float(line, &v)) {
            eprintln("not a number: ", line);
            return 1;
        }
        if (count == MAX_VALUES) {
            eprintln("too many values");
            return 1;
        }
        values[count] = v;
        count += 1;
    }
    if (count == 0) {
        eprintln("no values");
        return 1;
    }
    f64 mut sum = 0.0;
    f64 mut low = values[0];
    f64 mut high = values[0];
    u64 mut i = 0;
    while (i < count) {
        f64 v = values[i];
        sum = sum + v;
        if (v < low) {
            low = v;
        }
        if (v > high) {
            high = v;
        }
        i += 1;
    }
    f64 mean = sum / cast(count, f64);
    f64 mut spread = 0.0;
    i = 0;
    while (i < count) {
        f64 d = values[i] - mean;
        spread = spread + d * d;
        i += 1;
    }
    println("count ", count);
    println("sum ", sum);
    println("mean ", mean);
    println("min ", low);
    println("max ", high);
    println("range ", high - low);
    println("var ", spread / cast(count, f64));
    return 0;
}
