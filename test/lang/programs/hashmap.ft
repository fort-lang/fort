//! run
//! stdout:
//| 14695981039346656037 12638187200555641996
//| count=11 cap=16
//| alpha=0 delta=30 kilo=100 found=11 missing=0
//| true true true false
//| count=8 tombstones=3
//| false false true 90
//| count=9 tombstones=2 delta=300
//| sum=685
//| freed cap=0 count=0
// An open-addressing string-to-i64 hash map with linear probing, tombstone deletes and
// doubling growth, written with core features only. Nothing hash-order dependent is printed.
// The map owns its slot storage (D17): growth builds a fresh table, frees the old slots and
// moves the new ones in, and map_free empties the map so a second free is a no-op.
struct entry {
    string key;
    i64 value;
    u8 state;
}

struct map {
    entry mut@ own slots;
    u64 count;
    u64 tombstones;
}

u8 EMPTY = 0;
u8 USED = 1;
u8 DELETED = 2;

string[11] WORDS = {"alpha", "bravo", "charlie", "delta", "echo", "foxtrot", "golf", "hotel",
                    "india", "juliet", "kilo"};

// FNV-1a; `*%` keeps the multiplication wrapping in both build modes (D11.2).
fn fnv1a(string key) u64 {
    u64 mut h = 14695981039346656037;
    for (char c : key) {
        h ^= cast(c, u64);
        h *%= 1099511628211;
    }
    return h;
}

// The caller's slots must be empty ({} or freed), or the checked build traps (D17.11).
fn map_init(map mut* m, u64 cap) void {
    m->slots = new(entry, cap);
    m->count = 0;
    m->tombstones = 0;
}

// Index of `key` when present (*found = true), otherwise the first reusable slot on its probe
// chain (*found = false). The table always has an empty slot, so the walk terminates.
fn map_find(map* m, string key, bool mut* found) u64 {
    u64 cap = m->slots.len;
    u64 mut idx = fnv1a(key) % cap;
    u64 mut free_slot = cap;
    while (true) {
        entry e = m->slots[idx];
        if (e.state == EMPTY) {
            *found = false;
            if (free_slot < cap) {
                return free_slot;
            }
            return idx;
        }
        if (e.state == DELETED) {
            if (free_slot == cap) {
                free_slot = idx;
            }
        } else if (e.key == key) {
            *found = true;
            return idx;
        }
        idx = (idx + 1) % cap;
    }
}

// Rehash into a fresh table, then del the old slots so the move into the emptied slot passes
// the overwrite check. The fresh table never grows: it holds at most 3/4 of half its capacity.
fn map_grow(map mut* m) void {
    map mut fresh = {};
    map_init(&fresh, m->slots.len * 2);
    {
        entry mut@ range_values = m->slots;
        u64 mut range_index = 0;
        while (range_index < range_values.len) {
            entry e = range_values[range_index];
            range_index += 1;
            if (e.state == USED) {
                map_put(&fresh, e.key, e.value);
            }
        }
    }
    del(m->slots);
    m->slots = move(fresh.slots);
    m->count = fresh.count;
    m->tombstones = fresh.tombstones;
}

fn map_free(map mut* m) void {
    del(m->slots);
    m->count = 0;
    m->tombstones = 0;
}

fn map_put(map mut* m, string key, i64 value) void {
    if ((m->count + m->tombstones + 1) * 4 > m->slots.len * 3) {
        map_grow(m);
    }
    bool mut found = false;
    u64 idx = map_find(m, key, &found);
    if (found) {
        m->slots[idx].value = value;
        return;
    }
    if (m->slots[idx].state == DELETED) {
        m->tombstones--;
    }
    m->slots[idx] = entry{key, value, USED};
    m->count++;
}

fn map_get(map* m, string key, i64 mut* out) bool {
    bool mut found = false;
    u64 idx = map_find(m, key, &found);
    if (found) {
        *out = m->slots[idx].value;
    }
    return found;
}

fn map_del(map mut* m, string key) bool {
    bool mut found = false;
    u64 idx = map_find(m, key, &found);
    if (!found) {
        return false;
    }
    m->slots[idx].state = DELETED;
    m->count--;
    m->tombstones++;
    return true;
}

fn sum_values(map* m) i64 {
    i64 mut total = 0;
    for (entry e : m->slots) {
        if (e.state == USED) {
            total += e.value;
        }
    }
    return total;
}

fn main() i32 {
    println(fnv1a(""), " ", fnv1a("a"));
    map mut m = {};
    map_init(&m, 4);
    defer map_free(&m);
    for (u64 mut i = 0; i < WORDS.len; i++) {
        map_put(&m, WORDS[i], cast(i, i64) * 10);
    }
    println("count=", m.count, " cap=", m.slots.len);
    i64 mut v = 0;
    i32 mut found = 0;
    i32 mut missing = 0;
    for (string w : WORDS) {
        if (map_get(&m, w, &v)) {
            found++;
        } else {
            missing++;
        }
    }
    map_get(&m, "alpha", &v);
    i64 a = v;
    map_get(&m, "delta", &v);
    i64 d = v;
    map_get(&m, "kilo", &v);
    println("alpha=", a, " delta=", d, " kilo=", v, " found=", found, " missing=", missing);
    println(map_del(&m, "delta"), " ", map_del(&m, "echo"), " ", map_del(&m, "kilo"), " ",
            map_del(&m, "zulu"));
    println("count=", m.count, " tombstones=", m.tombstones);
    bool d1 = map_get(&m, "delta", &v);
    bool d2 = map_get(&m, "zulu", &v);
    bool d3 = map_get(&m, "juliet", &v);
    println(d1, " ", d2, " ", d3, " ", v);
    map_put(&m, "delta", 300);
    map_put(&m, "alpha", 5);
    map_get(&m, "delta", &v);
    println("count=", m.count, " tombstones=", m.tombstones, " delta=", v);
    println("sum=", sum_values(&m));
    map_free(&m);
    println("freed cap=", m.slots.len, " count=", m.count);
    return 0;
}
