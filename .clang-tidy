# clang-tidy 18 configuration for the C11 sources.
# Only checks and options that clang-tidy 18 knows; check with
# `clang-tidy --verify-config`.
#
# Enable each bugprone, clang-analyzer, misc, performance, and readability check.
# Disable these checks:
# - C++ (cplusplus and optin.cplusplus), macOS (osx and optin.osx), WebKit,
#   Fuchsia handles, and MPI analyzers do not apply.
# - Other C++-only checks match nothing in C and stay listed.
# - clang-analyzer-optin.performance.Padding is a struct layout heuristic.
# - bugprone-easily-swappable-parameters conflicts with runtime ABI parameter runs.
# - clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling has no
#   glibc annex K replacements.
# - misc-include-cleaner enforces a rule this project does not use.
# - misc-no-recursion conflicts with the recursive descent parser.
# - readability-function-cognitive-complexity is not a project rule.
# - readability-identifier-length is not a project rule.
# - readability-implicit-bool-conversion is not a project rule.
Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  misc-*,
  performance-*,
  readability-*,
  -clang-analyzer-cplusplus*,
  -clang-analyzer-optin.cplusplus*,
  -clang-analyzer-osx*,
  -clang-analyzer-optin.osx*,
  -clang-analyzer-webkit*,
  -clang-analyzer-fuchsia*,
  -clang-analyzer-optin.mpi*,
  -clang-analyzer-optin.performance.Padding,
  -bugprone-easily-swappable-parameters,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -misc-include-cleaner,
  -misc-no-recursion,
  -readability-function-cognitive-complexity,
  -readability-identifier-length,
  -readability-implicit-bool-conversion

WarningsAsErrors: '*'
HeaderFilterRegex: '.*'

CheckOptions:
  # Use lower_case for functions, variables, parameters, members, and tags.
  # Add the _t suffix to typedefs. Use UPPER_CASE for enum constants and macros.
  # Also use UPPER_CASE for file-scope and function-scope static constants.
  # Macros private to a header end with an underscore (TEST_LOG_); clang-tidy
  # rejects a trailing underscore in every style, so they are matched apart.
  - { key: readability-identifier-naming.FunctionCase,          value: lower_case }
  - { key: readability-identifier-naming.VariableCase,          value: lower_case }
  - { key: readability-identifier-naming.ParameterCase,         value: lower_case }
  - { key: readability-identifier-naming.MemberCase,            value: lower_case }
  - { key: readability-identifier-naming.StructCase,            value: lower_case }
  - { key: readability-identifier-naming.UnionCase,             value: lower_case }
  - { key: readability-identifier-naming.EnumCase,              value: lower_case }
  - { key: readability-identifier-naming.TypedefCase,           value: lower_case }
  - { key: readability-identifier-naming.TypedefSuffix,         value: _t }
  - { key: readability-identifier-naming.LocalConstantCase,     value: lower_case }
  - { key: readability-identifier-naming.ConstantParameterCase, value: lower_case }
  - { key: readability-identifier-naming.ConstantMemberCase,    value: lower_case }
  - { key: readability-identifier-naming.EnumConstantCase,      value: UPPER_CASE }
  - { key: readability-identifier-naming.GlobalConstantCase,    value: UPPER_CASE }
  - { key: readability-identifier-naming.StaticConstantCase,    value: UPPER_CASE }
  - { key: readability-identifier-naming.MacroDefinitionCase,   value: UPPER_CASE }
  - { key: readability-identifier-naming.MacroDefinitionIgnoredRegexp, value: '^[A-Z][A-Z0-9_]*_$' }

  # Reject magic numbers. Permit powers of two and the default values 0 to 4.
  # clang-tidy 18 does not look inside macro
  # arguments, so the bodies of TEST(name, { ... }) are not covered.
  - { key: readability-magic-numbers.IgnorePowersOf2IntegerValues, value: true }

  # Use each non-void call result, or discard it with (void).
  # clang-tidy 18 takes CheckedFunctions and CheckedReturnTypes as name lists.
  # Regular expressions arrive in clang-tidy 19.
  # The list includes the C standard library functions of CERT ERR33-C.
  # It starts with the default cert-err33-c list from clang-tidy 18.
  # It also includes printf functions that ERR33-C omits. String, memory, POSIX
  # process, and file functions are included too.
  # Review checks the project's own functions.
  - { key: bugprone-unused-return-value.AllowCastToVoid, value: true }
  - key: bugprone-unused-return-value.CheckedFunctions
    value: >-
      ::aligned_alloc;::asctime_s;::at_quick_exit;::atexit;::bsearch;::bsearch_s;::btowc;
      ::c16rtomb;::c32rtomb;::calloc;::clock;::cnd_broadcast;::cnd_init;::cnd_signal;
      ::cnd_timedwait;::cnd_wait;::ctime_s;::fclose;::fflush;::fgetc;::fgetpos;::fgets;
      ::fgetwc;::fopen;::fopen_s;::fprintf;::fprintf_s;::fputc;::fputs;::fputwc;::fputws;
      ::fread;::freopen;::freopen_s;::fscanf;::fscanf_s;::fseek;::fsetpos;::ftell;
      ::fwprintf;::fwprintf_s;::fwrite;::fwscanf;::fwscanf_s;::getc;::getchar;::getenv;
      ::getenv_s;::gets_s;::getwc;::getwchar;::gmtime;::gmtime_s;::localtime;::localtime_s;
      ::malloc;::mbrtoc16;::mbrtoc32;::mbsrtowcs;::mbsrtowcs_s;::mbstowcs;::mbstowcs_s;
      ::memchr;::mktime;::mtx_init;::mtx_lock;::mtx_timedlock;::mtx_trylock;::mtx_unlock;
      ::printf_s;::putc;::putwc;::raise;::realloc;::remove;::rename;::scanf;::scanf_s;
      ::setlocale;::setvbuf;::signal;::snprintf;::snprintf_s;::sprintf;::sprintf_s;::sscanf;
      ::sscanf_s;::strchr;::strerror_s;::strftime;::strpbrk;::strrchr;::strstr;::strtod;
      ::strtof;::strtoimax;::strtok;::strtok_s;::strtol;::strtold;::strtoll;::strtoul;
      ::strtoull;::strtoumax;::strxfrm;::swprintf;::swprintf_s;::swscanf;::swscanf_s;
      ::thrd_create;::thrd_detach;::thrd_join;::thrd_sleep;::time;::timespec_get;::tmpfile;
      ::tmpfile_s;::tmpnam;::tmpnam_s;::tss_create;::tss_get;::tss_set;::ungetc;::ungetwc;
      ::vfprintf;::vfprintf_s;::vfscanf;::vfscanf_s;::vfwprintf;::vfwprintf_s;::vfwscanf;
      ::vfwscanf_s;::vprintf_s;::vscanf;::vscanf_s;::vsnprintf;::vsnprintf_s;::vsprintf;
      ::vsprintf_s;::vsscanf;::vsscanf_s;::vswprintf;::vswprintf_s;::vswscanf;::vswscanf_s;
      ::vwprintf_s;::vwscanf;::vwscanf_s;::wcrtomb;::wcschr;::wcsftime;::wcspbrk;::wcsrchr;
      ::wcsrtombs;::wcsrtombs_s;::wcsstr;::wcstod;::wcstof;::wcstoimax;::wcstok;::wcstok_s;
      ::wcstol;::wcstold;::wcstoll;::wcstombs;::wcstombs_s;::wcstoul;::wcstoull;::wcstoumax;
      ::wcsxfrm;::wctob;::wctrans;::wctype;::wmemchr;::wprintf_s;::wscanf;::wscanf_s;
      ::printf;::puts;::putchar;::vprintf;::wprintf;::vwprintf;::putwchar;
      ::strcmp;::strncmp;::strlen;::strnlen;::strcpy;::strncpy;::strcat;::strncat;::strspn;
      ::strcspn;::strcoll;::strerror;::strdup;::strndup;::memcmp;::memcpy;::memmove;::memset;
      ::atoi;::atol;::atoll;::atof;::abs;::labs;::llabs;
      ::open;::close;::read;::write;::pipe;::dup;::dup2;::lseek;::fsync;::ftruncate;::fcntl;
      ::fileno;::fdopen;::isatty;::dprintf;::vdprintf;::getline;::getdelim;::mmap;::munmap;
      ::access;::stat;::fstat;::lstat;::unlink;::rmdir;::mkdir;::symlink;::chmod;::mkstemp;
      ::mkdtemp;::chdir;::getcwd;::realpath;::readlink;::opendir;::readdir;::closedir;
      ::popen;::pclose;::system;::fork;::execv;::execvp;::execve;::execl;::execlp;
      ::posix_spawn;::posix_spawnp;::wait;::waitpid;::kill;::sigaction;::sigemptyset;
      ::sigaddset;::sigprocmask;::nanosleep;::clock_gettime;::setenv;::unsetenv;::putenv
