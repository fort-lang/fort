# Per-agent git worktrees, the ticket board and the VM state (see AGENTS.md)
.worktrees/
.tickets/
.vagrant/
.vagrant-*/
*.swp

# Build output
build/
cmake-build-*/
*.o
*.s
*.ll
!test/ir/*.ll
*.out
compile_commands.json

# Editor / OS noise
.DS_Store
.idea/
.vscode/

# Python bytecode caches (the harness self-test runs with PYTHONDONTWRITEBYTECODE=1)
__pycache__/

# clangd's index. It is editor output, it is binary, and it changes on every
# build, so 44 of these files were committed by mistake in 2328c2f and then
# showed as modified for ever. The noise hid a real uncommitted edit from a
# reader on 2026-09-12.
.cache/

# Scratch directories a hand-run test/fort suite writes beside its sources.
# check_env.open and modules_env.open create sandbox<n>/ relative to the working
# directory and never remove it (notes/testing.md 3, T-117).
test/fort/sandbox*/

# Copies of the user's own files, kept out of build/ so a reconfigure cannot
# take them. The durable copy is ~/fort-user-originals/ (T-097).
.user-originals/
